# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-actual-project-id
GOOGLE_CLOUD_KEY_FILE=./path/to/your-service-account-key.json
GOOGLE_CLOUD_STORAGE_BUCKET=padel-videos-your-project-id

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/padel-analyzer

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-make-this-random-and-long
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
CLIENT_URL=http://localhost:3000

# Video Analysis Configuration
MAX_VIDEO_SIZE_MB=500
SUPPORTED_FORMATS=mp4,avi,mov,mkv
ANALYSIS_WEBHOOK_URL=http://localhost:5000/api/analysis/webhook