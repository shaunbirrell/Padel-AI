        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">WorldLabelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	World label rules (CLAUDE.md "World labels"; HUD v70 spec §5).

	Two users:
	  * Modules/WorldLabelPolicy (server) enforces the caps on every BillboardGui in Workspace as it appears.
	    v67 only touched labels inside plots; v70 also caps labels outside them (territories, POIs, NPCs, vehicles,
	    the bank, supply drops). It measures from the label's Adornee, else its first ancestor with a position.
	  * Shared/Util/WorldLabel builds labels that already follow the rules (stud-scaled, 14-20 px text, no card).
	    Its look (box studs, font, default range) is HudConfig.WorldLabels.Default.
]]

local WorldLabelConfig = {
	Enabled = true,
	-- Studs. Labels inside a plot further away than this are hidden (default BillboardGui distance is infinite).
	-- v70: 40 (CLAUDE.md: MaxDistance <= 40; was 45).
	MaxDistance = 40,
	-- v70: labels outside the plots get the same treatment (AlwaysOnTop off, range capped). false = v67 behaviour.
	ApplyOutsidePlots = true,
	OutsideMaxDistance = 40,
	-- BillboardGui names allowed to draw over walls/buildings. Everything else gets AlwaysOnTop = false.
	AllowAlwaysOnTop = {} :: { [string]: boolean },
	-- WE_LabelRole values (WorldLabel.SetRole) allowed AlwaysOnTop: the one active objective marker and a contested
	-- flag. Keeping it to ONE objective at a time is the caller's job.
	AlwaysOnTopRoles = { objective = true, contested = true } :: { [string]: boolean },
	-- Studs beyond the plot pad edge still counted as "in the base" (gate, outer sandbags, parked vehicles).
	PlotMargin = 12,

	-- Shared/Util/WorldLabel ------------------------------------------------------------------------------------
	RoleAttribute = "WE_LabelRole", -- "objective" | "contested" (unset = normal label)
	OwnerAttribute = "WE_LabelOwner", -- UserId: only that player sees the label (client filter; 0/unset = everyone)
	OwnerTag = "WE_OwnerLabel", -- CollectionService tag on owner-only labels (what the client filter watches)
	-- Billboard text, real px (world GUIs are not under the HUD UIScale). Fixed TextSize, never TextScaled.
	TextSize = 16,
	SubTextSize = 14,
	MinTextSize = 14,
	MaxTextSize = 20,
	LinePad = 2, -- px added to each line's height
	StudsAbove = 1.5, -- default gap above a part's top face
	-- Painted signs (WorldLabel.Surface). SurfaceGui budget: MaxDistance <= 80.
	SurfaceMaxDistance = 80,
	SurfaceDefaultMaxDistance = 40,
	SurfacePixelsPerStud = 40,
	SurfaceMaxTextSize = 100, -- Roblox's TextSize ceiling
}

return WorldLabelConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Constants</string>
          <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — Shared constants (non-tunable identifiers).
	Tunable numbers live in Configs/*.
]]

local Constants = {}

Constants.GAME_NAME = "WAR EMPIRE"
Constants.TAGLINE = "BUILD. CONQUER. DOMINATE."

-- CollectionService tags (StudioSetup + runtime)
Constants.Tags = {
	BasePlot = "WE_BasePlot",
	UpgradeSlot = "WE_UpgradeSlot",
	Territory = "WE_Territory",
	CaptureZone = "WE_CaptureZone",
	VehicleSpawn = "WE_VehicleSpawn",
	NavalSpawn = "WE_NavalSpawn",
	Water = "WE_Water", -- v69: water surface parts (top face = water level); boats may only move over these
	NPCSpawn = "WE_NPCSpawn",
	EventSpawn = "WE_EventSpawn",
	SupplyDrop = "WE_SupplyDrop",
	BankVault = "WE_BankVault",
	NPC = "WE_NPC",
	Vehicle = "WE_Vehicle",
	TutorialMarker = "WE_TutorialMarker",
	MoneyCollector = "WE_MoneyCollector",
	GateBarrier = "WE_GateBarrier",
	PlotOilPump = "WE_PlotOilPump",
	PremiumPad = "WE_PremiumPad",
}

-- Remote folder / names (created by RemoteSetup)
Constants.RemotesFolderName = "WE_Remotes" -- v60: server-only; never Rojo empty Remotes
Constants.RemoteNames = {
	-- Server → Client (push)
	PlayerStateUpdate = "PlayerStateUpdate",
	BaseStateUpdate = "BaseStateUpdate",
	Notification = "Notification",
	EconomyUpdate = "EconomyUpdate",
	XPUpdate = "XPUpdate",
	CombatStateUpdate = "CombatStateUpdate",
	CombatHitFeedback = "CombatHitFeedback",
	VehicleStateUpdate = "VehicleStateUpdate",
	TerritoryStateUpdate = "TerritoryStateUpdate",
	MissionStateUpdate = "MissionStateUpdate",
	-- Client → Server (request/action only — NEVER GiveCash/GiveXP/GiveWeapon)
	RequestPurchaseUpgrade = "RequestPurchaseUpgrade",
	PurchaseResult = "PurchaseResult", -- v62: server always replies Ok/Err after buy
	RequestClaimDailyReward = "RequestClaimDailyReward",
	RequestSpawnVehicle = "RequestSpawnVehicle",
	RequestPurchaseVehicle = "RequestPurchaseVehicle",
	RequestDespawnVehicle = "RequestDespawnVehicle",
	RequestEquipWeapon = "RequestEquipWeapon",
	RequestPurchaseWeapon = "RequestPurchaseWeapon",
	RequestFire = "RequestFire",
	RequestReload = "RequestReload",
	RequestStartMission = "RequestStartMission",
	RequestClaimMission = "RequestClaimMission",
	RequestCaptureTerritory = "RequestCaptureTerritory",
	RequestAdminCommand = "RequestAdminCommand",
	RequestPurchaseDevProduct = "RequestPurchaseDevProduct",
	RequestPurchaseGamePass = "RequestPurchaseGamePass",
	RequestSkipTutorial = "RequestSkipTutorial",
	TutorialStateUpdate = "TutorialStateUpdate",
	-- Prestige / Clan / Battle Pass
	RequestPrestige = "RequestPrestige",
	PrestigeStateUpdate = "PrestigeStateUpdate",
	RequestCreateClan = "RequestCreateClan",
	RequestJoinClan = "RequestJoinClan",
	RequestLeaveClan = "RequestLeaveClan",
	ClanStateUpdate = "ClanStateUpdate",
	RequestClaimBattlePassReward = "RequestClaimBattlePassReward",
	BattlePassStateUpdate = "BattlePassStateUpdate",
	-- Soldiers / Season / Clan War
	RequestRecruitSoldiers = "RequestRecruitSoldiers",
	RequestDismissSoldiers = "RequestDismissSoldiers",
	SoldierStateUpdate = "SoldierStateUpdate",
	RequestSquadOrder = "RequestSquadOrder",
	SquadOrderStateUpdate = "SquadOrderStateUpdate",
	SeasonStateUpdate = "SeasonStateUpdate",
	RequestDeclareClanWar = "RequestDeclareClanWar",
	ClanWarStateUpdate = "ClanWarStateUpdate",
	RequestRedeemCode = "RequestRedeemCode",
	CodeStateUpdate = "CodeStateUpdate",
	NationColorUpdate = "NationColorUpdate",
	RequestClaimSpinner = "RequestClaimSpinner",
	SpinnerStateUpdate = "SpinnerStateUpdate",
	BankRaidStateUpdate = "BankRaidStateUpdate",
	-- Studio-only BUY smoke → client Output (Play Solo)
	StudioSmokeLog = "StudioSmokeLog",
	DeathShopOffer = "DeathShopOffer",
	StarterBundleOffer = "StarterBundleOffer",
	AutoCollectOffer = "AutoCollectOffer",
	DoubleCashOffer = "DoubleCashOffer",
	VIPOffer = "VIPOffer",
	SpeedBoostOffer = "SpeedBoostOffer",
	CashMegaOffer = "CashMegaOffer",
	AtmRaidStateUpdate = "AtmRaidStateUpdate",
	PromptPremiumPad = "PromptPremiumPad",
	-- v69: Research Lab upgrades, Command Center missile strikes, vehicle drive input
	RequestResearch = "RequestResearch",
	ResearchStateUpdate = "ResearchStateUpdate",
	RequestMissileStrike = "RequestMissileStrike",
	MissileStrikeStateUpdate = "MissileStrikeStateUpdate",
	MissileStrikeFx = "MissileStrikeFx",
	VehicleDriveInput = "VehicleDriveInput",
	-- v71 money (M2): created now, used by later workflows (nothing fires or listens to them yet).
	-- Nuke (M5; own Fx remote, J17)
	RequestNukeLaunch = "RequestNukeLaunch",
	RequestNukeState = "RequestNukeState",
	NukeStateUpdate = "NukeStateUpdate",
	NukeFx = "NukeFx",
	-- Premium / vehicle weapons (M6). VehicleWeaponFx is an UnreliableRemoteEvent (RemoteSetup UNRELIABLE list).
	RequestVehicleFire = "RequestVehicleFire",
	VehicleWeaponFx = "VehicleWeaponFx",
	RequestVehicleCamo = "RequestVehicleCamo",
	RequestPremiumTrial = "RequestPremiumTrial",
	-- Rebirth expansion (M7). Not "SupplyDrop": that name belongs to SupplyDropService.
	RebirthStateUpdate = "RebirthStateUpdate",
	RequestRebirthState = "RequestRebirthState",
	ArtilleryFx = "ArtilleryFx",
	DroneCrateFx = "DroneCrateFx",
	-- Offer Director (M3) and M8 (purchase ticker, shortfall chip)
	OfferShow = "OfferShow",
	OfferResult = "OfferResult",
	PurchaseAnnounce = "PurchaseAnnounce",
	ShortfallChip = "ShortfallChip",
	GetPlayerState = "GetPlayerState",
}

Constants.DataStoreName = "WarEmpire_PlayerData_v2" -- v55: intentional bump; fresh CreateDefault + StartingCash (kills stuck $0 v1 saves)
Constants.SessionStoreName = "WarEmpire_SessionLock_v1"
Constants.CURRENT_DATA_VERSION = 8

Constants.AutosaveIntervalSeconds = 60
-- Session lock: refresh often; steal if age >= TTL (rejoin after crash ~30–45s)
Constants.SessionLockTtlSeconds = 45
Constants.SessionLockRefreshSeconds = 15
Constants.DataStoreRetries = 3
Constants.DataStoreRetryDelay = 1.5

Constants.MaxBasePlots = 6
Constants.PassiveIncomeTickSeconds = 5

Constants.Colors = {
	Background = Color3.fromRGB(18, 20, 24),
	Panel = Color3.fromRGB(28, 32, 38),
	Accent = Color3.fromRGB(70, 130, 80),
	Cash = Color3.fromRGB(130, 255, 170), -- v36 high-contrast cash (not yellow)
	Gold = Color3.fromRGB(230, 190, 60),
	XP = Color3.fromRGB(90, 160, 220),
	Danger = Color3.fromRGB(200, 70, 70),
	Health = Color3.fromRGB(200, 70, 70),
	Ammo = Color3.fromRGB(220, 200, 120),
	Text = Color3.fromRGB(235, 238, 242),
	Muted = Color3.fromRGB(150, 158, 170),
	-- Visual kits v2 UI
	Gunmetal = Color3.fromRGB(42, 48, 55),
	GunmetalLight = Color3.fromRGB(58, 66, 74),
	CategoryGround = Color3.fromRGB(90, 130, 80),
	CategoryAir = Color3.fromRGB(90, 160, 220),
	CategoryNaval = Color3.fromRGB(70, 180, 200),
	-- High-contrast (never pale yellow on sand/green)
	TextOnDark = Color3.fromRGB(245, 248, 252),
	TextDark = Color3.fromRGB(18, 20, 24),
	PlateDark = Color3.fromRGB(12, 14, 18),
	GoldBright = Color3.fromRGB(255, 210, 90),
	NeonAccent = Color3.fromRGB(80, 255, 160),
	Olive = Color3.fromRGB(72, 88, 58),
	Sand = Color3.fromRGB(196, 170, 120),
}

return Constants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Client/server helper to fetch remotes created by RemoteSetup.
	Does not create remotes on the client.

	v60/v61: HUD/BUY must NEVER block on unbounded WaitForChild.
	Use BindEvent / TryGet* / FireServer for display + BUY paths; GetEvent still waits (non-HUD).
	Folder is WE_Remotes (server-created) — Rojo no longer ships empty Remotes.
	v61: FireServer polls ≤3s then returns false — never toast "Buying…" without a live remote.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(script.Parent.Constants)

local Remotes = {}

local function getFolderImmediate(): Folder?
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if folder and folder:IsA("Folder") then
		return folder :: Folder
	end
	return nil
end

local function getFolder(): Folder
	local folder = getFolderImmediate()
	if folder then
		return folder
	end
	folder = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName, 120) :: Folder?
	assert(folder and folder:IsA("Folder"), "WE_Remotes missing — server EarlyRemotes/RemoteSetup must run first")
	return folder :: Folder
end

local function waitForRemote(name: string, className: string): Instance
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA(className) then
		return existing
	end
	local waited = 0
	while waited < 180 do
		local remote = folder:WaitForChild(name, 5)
		if remote and remote:IsA(className) then
			return remote
		end
		waited += 5
		warn(string.format("[Remotes] Waiting for %s %s… (%ds)", className, name, waited))
	end
	local remote = folder:WaitForChild(name, 30)
	if not (remote and remote:IsA(className)) then
		error(className .. " missing after wait: " .. name .. " (server Bootstrap may have aborted — check Output)", 0)
	end
	return remote
end

function Remotes.GetEvent(name: string): RemoteEvent
	return waitForRemote(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.GetFunction(name: string): RemoteFunction
	return waitForRemote(name, "RemoteFunction") :: RemoteFunction
end

--[[ Non-blocking: nil if remote not ready yet. ]]
function Remotes.TryGetEvent(name: string): RemoteEvent?
	local folder = getFolderImmediate()
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		return remote :: RemoteEvent
	end
	return nil
end

function Remotes.TryGetFunction(name: string): RemoteFunction?
	local folder = getFolderImmediate()
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("RemoteFunction") then
		return remote :: RemoteFunction
	end
	return nil
end

--[[ v71 money (M2): UnreliableRemoteEvents (RemoteSetup UNRELIABLE list, e.g. VehicleWeaponFx). They are not
	RemoteEvents, so GetEvent / TryGetEvent never return them. Same bounded wait as GetEvent. ]]
function Remotes.GetUnreliableEvent(name: string): UnreliableRemoteEvent
	return waitForRemote(name, "UnreliableRemoteEvent") :: UnreliableRemoteEvent
end

--[[ Non-blocking: nil if the unreliable remote is not ready yet. ]]
function Remotes.TryGetUnreliableEvent(name: string): UnreliableRemoteEvent?
	local folder = getFolderImmediate()
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("UnreliableRemoteEvent") then
		return remote :: UnreliableRemoteEvent
	end
	return nil
end

--[[
	Client→server fire without unbounded WaitForChild.
	Polls up to timeoutSec (default 3) for WE_Remotes + event.
	Returns true only if FireServer actually ran on a live RemoteEvent.
]]
function Remotes.FireServer(name: string, ...: any): boolean
	local remote = Remotes.TryGetEvent(name)
	if remote then
		remote:FireServer(...)
		return true
	end
	local timeoutSec = 3
	local deadline = os.clock() + timeoutSec
	while os.clock() < deadline do
		task.wait(0.05)
		remote = Remotes.TryGetEvent(name)
		if remote then
			remote:FireServer(...)
			return true
		end
	end
	warn("[Remotes] FireServer: remote not ready after", timeoutSec, "s:", name)
	return false
end

--[[
	Connect OnClientEvent without ever yielding the caller.
	If remote appears later, connects in a background spawn.
]]
function Remotes.BindEvent(name: string, handler: (...any) -> ()): ()
	local remote = Remotes.TryGetEvent(name)
	if remote then
		remote.OnClientEvent:Connect(handler)
		return
	end
	task.spawn(function()
		local folder = getFolderImmediate()
		if not folder then
			local waited = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName, 120)
			if not (waited and waited:IsA("Folder")) then
				warn("[Remotes] BindEvent: WE_Remotes never appeared for", name)
				return
			end
			folder = waited :: Folder
		end
		local ev = folder:FindFirstChild(name)
		if not ev then
			ev = folder:WaitForChild(name, 120)
		end
		if ev and ev:IsA("RemoteEvent") then
			(ev :: RemoteEvent).OnClientEvent:Connect(handler)
		else
			warn("[Remotes] BindEvent: remote never appeared:", name)
		end
	end)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Shared type aliases for WAR EMPIRE.
]]

export type Currency = "Cash" | "Gold"

export type StructureId =
	"CommandCenter"
	| "Barracks"
	| "VehicleDepot"
	| "WeaponsFacility"
	| "Helipad"
	| "Airfield"
	| "DefensiveWalls"
	| "Watchtowers"
	| "Radar"
	| "ResearchLab"
	| "MissileDefense"
	| "PowerStation"
	| "Warehouse"
	| "SpecialForcesFacility"

export type BaseUpgrades = { [string]: number }

export type PlayerSettings = {
	MusicVolume: number,
	SFXVolume: number,
	ShowDamageNumbers: boolean,
	AutoSprint: boolean,
}

export type PlayerStats = {
	TotalCashEarned: number,
	TotalGoldEarned: number,
	UpgradesPurchased: number,
	VehiclesSpawned: number,
	MissionsCompleted: number,
	TerritoriesCaptured: number,
	Kills: number,
	Deaths: number,
	PlayTimeSeconds: number,
}

export type DailyLogin = {
	LastClaimDay: number, -- YYYYMMDD or 0
	Streak: number,
	LastClaimUnix: number,
}

export type DailyMissionProgress = {
	DayKey: number, -- YYYYMMDD UTC
	Progress: { [string]: number },
	Claimed: { [string]: boolean },
	ActiveTimed: { [string]: number }, -- missionId -> endsAt unix
}

export type BattlePassProgress = {
	SeasonId: string,
	XP: number,
	Level: number,
	Premium: boolean,
	ClaimedFree: { [string]: boolean },
	ClaimedPremium: { [string]: boolean },
}

-- v71 money (M2): optional profile blocks (ProfileSchema default-fill + sanitise; no DataVersion bump).
-- Nothing reads them yet; the nuke / premium vehicle / rebirth / offer workflows will.
export type NukeInFlight = {
	Kind: string, -- "Nuke" | "TacticalNuke"
	LaunchId: string,
	At: number, -- os.time() at launch
}

export type NukeStats = {
	Bought: number,
	Launched: number,
	PlayerKills: number,
	NpcKills: number,
	BestKills: number,
}

export type SiloProgress = {
	ProgressSeconds: number, -- online seconds toward the next Tactical Nuke
}

export type RebirthProgress = {
	ZonesSeen: { [string]: boolean }, -- zoneId -> the unlock celebration played
	LastRebirthUnix: number,
}

export type OfferStats = {
	Shown: number,
	LastShownUnix: number,
	Clicked: number,
	Dismissed: number,
}

export type MonetizationStats = {
	FirstPurchaseUnix: number,
	LastPurchaseUnix: number,
	Purchases: number,
	RobuxSpent: number, -- analytics / segmentation only; never shown to players
}

export type PlayerProfile = {
	DataVersion: number,
	Cash: number,
	PendingCash: number,
	Gold: number,
	Level: number,
	XP: number,
	Prestige: number,
	RebirthUnlocks: { [string]: boolean },
	Soldiers: number,
	NationColorId: string?,
	RedeemedCodes: { [string]: boolean },
	LastSpinnerClaimUnix: number,
	Vehicles: { [string]: boolean },
	Weapons: { [string]: boolean },
	EquippedWeapon: string?,
	Territories: { [string]: boolean },
	BaseUpgrades: BaseUpgrades,
	BasePlotId: number?,
	TutorialStep: number,
	TutorialComplete: boolean,
	DailyLogin: DailyLogin,
	DailyMissions: DailyMissionProgress,
	Settings: PlayerSettings,
	Stats: PlayerStats,
	Achievements: { [string]: boolean },
	BattlePass: BattlePassProgress,
	ClanId: string?,
	FirstJoinUnix: number,
	LastJoinUnix: number,
	ProcessedReceipts: { [string]: boolean }?,
	Entitlements: { [string]: boolean }?,
	OutpostIncomeStacks: number?,
	StarterBundleOffered: boolean?,
	AutoCollectOffered: boolean?,
	DoubleCashOffered: boolean?,
	VIPOffered: boolean?,
	SpeedBoostOffered: boolean?,
	CashMegaOffered: boolean?,
	-- v71 money (M2)
	Nukes: number?, -- paid (Robux) nukes, granted only in ProcessReceipt
	TacticalNukes: number?, -- silo / gift / reward nukes
	NukeInFlight: NukeInFlight?,
	NukeGiftGranted: boolean?,
	NukeStats: NukeStats?,
	Silo: SiloProgress?,
	PremiumVehicleCamo: { [string]: string }?, -- vehicleId -> camo id
	PremiumTrials: { [string]: number }?, -- vehicleId -> os.time() of the last free test drive
	Rebirth: RebirthProgress?,
	Offers: { [string]: OfferStats }?, -- offer key -> cadence counters (Offer Director)
	Monetization: MonetizationStats?,
	AnnouncePurchases: boolean?, -- M8 purchase ticker opt-out (true = announce)
	VipSupplyAt: number?, -- M8 daily VIP supply: os.time() of the last claim
}

export type EconomyUpdatePayload = {
	Cash: number,
	Gold: number,
	PendingCash: number?,
}

export type XPUpdatePayload = {
	Level: number,
	XP: number,
	XPToNext: number,
	HudGoal: string?,
	UnlockMessage: string?,
	LevelUp: boolean?, -- v37 celebration toast
}

export type BaseStatePayload = {
	PlotId: number?,
	Upgrades: BaseUpgrades,
	PassiveIncomePerTick: number,
}

export type PlayerStatePayload = {
	Cash: number,
	Gold: number,
	PendingCash: number?,
	Level: number,
	XP: number,
	XPToNext: number,
	Prestige: number,
	Soldiers: number,
	NationColorId: string?,
	TrainingIncomePerTick: number?,
	Base: BaseStatePayload,
	TutorialStep: number?,
	TutorialComplete: boolean,
	Vehicles: { [string]: boolean },
	Weapons: { [string]: boolean },
	EquippedWeapon: string?,
	DailyLogin: DailyLogin?,
	TerritoriesOwned: { [string]: boolean }?,
}

export type CombatStatePayload = {
	Health: number,
	MaxHealth: number,
	WeaponId: string?,
	Ammo: number,
	MagazineSize: number,
	Reloading: boolean,
	Alive: boolean,
}

export type CombatHitFeedbackPayload = {
	Kind: string, -- "Hit" | "Kill" | "Miss" | "Damaged" | "Death"
	Damage: number?,
	TargetName: string?,
	WeaponId: string?,
	IsHeadshot: boolean?,
}

export type VehicleStatePayload = {
	Owned: { [string]: boolean },
	ActiveVehicleId: string?,
	CooldownRemaining: number,
}

export type TerritoryEntryPayload = {
	Id: string,
	DisplayName: string,
	OwnerType: string,
	OwnerUserId: number,
	ClanId: string?,
	Progress: number, -- 0..1 capture progress toward CapturingUserId
	CapturingUserId: number,
	ProtectedUntil: number, -- unix
	BonusType: string,
	BonusValue: number,
	Contested: boolean,
}

export type TerritoryStatePayload = {
	Territories: { TerritoryEntryPayload },
	LocalCapture: {
		TerritoryId: string?,
		Progress: number,
		Capturing: boolean,
		Contested: boolean?,
		Protected: boolean?,
	}?,
	RadarReveal: boolean?,
	RadarRadius: number?,
}

export type MissionEntryPayload = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string,
	Progress: number,
	Target: number,
	Claimed: boolean,
	Complete: boolean,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number,
}

export type MissionStatePayload = {
	DayKey: number,
	Daily: { MissionEntryPayload },
	DailyLogin: {
		Streak: number,
		CanClaim: boolean,
		NextDay: number,
		AlreadyClaimedToday: boolean,
	},
}

export type FireRequestPayload = {
	Direction: Vector3,
	Origin: Vector3?,
	TargetUserId: number?,
	TargetNpcId: string?,
	HitPosition: Vector3?,
}

export type PurchaseUpgradeRequest = {
	StructureId: string,
}

export type PurchaseUpgradeResult = {
	Ok: boolean,
	Error: string?,
	NewLevel: number?,
	Cash: number?,
	Gold: number?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="59">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">ConsoleLocator</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v71 console-only buying: which part is a structure's console on a plot, and is a player standing at it?

	One answer for server and client:
	  server  BaseService.PurchaseUpgrade (the gate), UpgradePadService (plot-ready position stamps), StudioBuySmoke
	  client  ConsoleWaypoint (Base panel GO)

	A buy point is a BasePart in Workspace tagged Constants.Tags.UpgradeSlot with attributes PlotId (number) and
	StructureId (string). WE_Console = true marks a console / kiosk (BaseLayoutConfig on). A console always wins over
	a legacy pad or a stray part the v63 StructureId sweeps tagged. Positions are the part's own world position, so
	rotated plots (BaseLayout.PlotCFrame, FaceMapCentre) need nothing here. Never yields, never WaitForChild.

	"At" = a cylinder around the part centre: horizontal (XZ) distance <= MaxDistance(part) and
	|dy| <= ConsoleBuyConfig.MaxVerticalOffset (same shape as MissileStrikeService's atCommandCenter).
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)

local ConsoleLocator = {}

-- Reasons (logs / tests only; the player-facing error is always "NotAtConsole")
export type Reason = "Ok" | "NoCharacter" | "Dead" | "Seated" | "NoConsole" | "WrongPart" | "TooFar" | "WrongFloor" | "OtherNearer"

local function plotIdOf(part: Instance): number?
	return tonumber(part:GetAttribute("PlotId") :: any)
end

local function flat(v: Vector3): number
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

function ConsoleLocator.IsConsole(part: BasePart): boolean
	return part:GetAttribute("WE_Console") == true
end

-- True when `part` is a live buy point for (plotId, structureId).
function ConsoleLocator.IsBuyPointFor(part: Instance?, plotId: number, structureId: string): boolean
	if part == nil or not part:IsA("BasePart") or not part:IsDescendantOf(Workspace) then
		return false
	end
	if not CollectionService:HasTag(part, Constants.Tags.UpgradeSlot) then
		return false
	end
	return part:GetAttribute("StructureId") == structureId and plotIdOf(part) == plotId
end

-- The structure's console on that plot; a legacy pad only when the plot has no console for it; nil when none.
function ConsoleLocator.Find(plotId: number, structureId: string): BasePart?
	local fallback: BasePart? = nil
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("StructureId") == structureId and plotIdOf(inst) == plotId
			and inst:IsDescendantOf(Workspace) then
			local part = inst :: BasePart
			if ConsoleLocator.IsConsole(part) then
				return part
			end
			if fallback == nil then
				fallback = part
			end
		end
	end
	return fallback
end

-- Allowed HORIZONTAL HRP -> part-centre distance. slack defaults to ConsoleBuyConfig.ServerSlack (the client passes 0).
function ConsoleLocator.MaxDistance(part: BasePart, slack: number?): number
	local base = if ConsoleLocator.IsConsole(part)
		then ConsoleBuyConfig.ConsolePromptDistance
		else ConsoleBuyConfig.PadPromptDistance
	return base + (if slack ~= nil then slack else ConsoleBuyConfig.ServerSlack)
end

-- Where a character stands to use `part`: 3 studs in front of its face (consoles face into the room / the plot
-- centre), HRP height. StudioBuySmoke teleports here; tests use it.
function ConsoleLocator.StandCFrame(part: BasePart): CFrame
	return part.CFrame * CFrame.new(0, 1.3, -3)
end

--[[ Is `player` at the console of `structureId` on plot `plotId` (the caller passes the player's OWN plot)?
	atPart: the part whose prompt fired (UpgradePadService); it must itself be a buy point for (plotId, structureId).
	Returns (ok, reason, horizontalDistance?). Reads only the server's (or local client's) view of the character;
	nothing the client sends in a remote payload. ]]
function ConsoleLocator.Check(player: Player, plotId: number, structureId: string, atPart: BasePart?, slack: number?): (boolean, Reason, number?)
	local character = player.Character
	if character == nil then
		return false, "NoCharacter", nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local rootInst = (hum and hum.RootPart) or character:FindFirstChild("HumanoidRootPart")
	if rootInst == nil or not rootInst:IsA("BasePart") then
		return false, "NoCharacter", nil
	end
	local hrp = rootInst :: BasePart
	if not hum or hum.Health <= 0 then
		return false, "Dead", nil
	end
	if ConsoleBuyConfig.RejectSeated and hum.SeatPart ~= nil then
		return false, "Seated", nil
	end
	local target: BasePart? = nil
	if atPart ~= nil then
		if not ConsoleLocator.IsBuyPointFor(atPart, plotId, structureId) then
			return false, "WrongPart", nil
		end
		target = atPart
	else
		target = ConsoleLocator.Find(plotId, structureId)
	end
	if target == nil then
		return false, "NoConsole", nil
	end
	local offset = hrp.Position - target.Position
	local d = flat(offset)
	if d > ConsoleLocator.MaxDistance(target, slack) then
		return false, "TooFar", d
	end
	if math.abs(offset.Y) > ConsoleBuyConfig.MaxVerticalOffset then
		return false, "WrongFloor", d -- e.g. the upper floor of a two-storey walk-in, above a ground-floor console
	end
	-- Two consoles in range (close kiosks, e.g. the planned rebirth-zone silo / drone kiosks 21.5 apart): only the
	-- nearest one buys, the same rule as Roblox prompt exclusivity (OnePerButton shows one prompt per key).
	if ConsoleBuyConfig.RequireNearest then
		local margin = ConsoleBuyConfig.NearestMargin
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
			if inst ~= target and inst:IsA("BasePart") and plotIdOf(inst) == plotId
				and inst:GetAttribute("StructureId") ~= structureId
				and ConsoleLocator.IsConsole(inst) == ConsoleLocator.IsConsole(target)
				and inst:IsDescendantOf(Workspace) then
				if flat((inst :: BasePart).Position - hrp.Position) + margin < d then
					return false, "OtherNearer", d
				end
			end
		end
	end
	return true, "Ok", d
end

return ConsoleLocator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">UIUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shared client UI helpers — consistent UIScale + dark military panel chrome.
	MobileActionBar tiles: large rounded color-coded squares (≥64px touch).
	v70 HUD: MakeRailTile / SetTileBadge (left rail), TextOutline, Lighten, MakeModalDim (panel dim).
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local HudConfig = require(script.Parent.Parent.Configs.HudConfig)

local UIUtil = {}

local DEFAULT_BASE = 900
local DEFAULT_MIN = 0.65
local DEFAULT_MAX = 1.1

function UIUtil.Corner(parent: Instance, radius: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

function UIUtil.Stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(55, 65, 55)
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

--[[
	MobileScale tracker: ONE ViewportSize connection for every UIScale made by AttachMobileScale (v70 fix: the
	old per-call closures reconnected on every CurrentCamera change and never disconnected). Weak keys, so a
	destroyed gui's UIScale drops out by itself. HudLayout.ApplyScreen takes a scale over with ReleaseMobileScale.
]]
type ScaleParams = { Base: number, Min: number, Max: number }
local trackedScales: { [UIScale]: ScaleParams } = setmetatable({} :: any, { __mode = "k" })
local trackerStarted = false
local trackerCamConn: RBXScriptConnection? = nil

local function scaleValue(p: ScaleParams): number?
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local size = cam.ViewportSize
	return math.clamp(math.min(size.X, size.Y) / p.Base, p.Min, p.Max)
end

local function updateTrackedScales()
	for scale, p in pairs(trackedScales) do
		local v = scaleValue(p)
		if v and scale.Scale ~= v then
			scale.Scale = v
		end
	end
end

local function bindTrackerCamera()
	if trackerCamConn then
		trackerCamConn:Disconnect()
		trackerCamConn = nil
	end
	local cam = workspace.CurrentCamera
	if cam then
		trackerCamConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateTrackedScales)
	end
	updateTrackedScales()
end

local function ensureScaleTracker()
	if trackerStarted then
		return
	end
	trackerStarted = true
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindTrackerCamera)
	bindTrackerCamera()
end

--[[
	Attaches a MobileScale UIScale that tracks viewport size.
	Returns the UIScale instance.
]]
function UIUtil.AttachMobileScale(
	screen: ScreenGui,
	basePx: number?,
	minScale: number?,
	maxScale: number?
): UIScale
	local scale = Instance.new("UIScale")
	scale.Name = "MobileScale"
	scale.Parent = screen

	local p: ScaleParams = { Base = basePx or DEFAULT_BASE, Min = minScale or DEFAULT_MIN, Max = maxScale or DEFAULT_MAX }
	trackedScales[scale] = p
	local v = scaleValue(p)
	if v then
		scale.Scale = v
	end
	ensureScaleTracker()

	return scale
end

--[[ Stop AttachMobileScale's tracker from driving this UIScale (HudLayout.ApplyScreen owns it from then on). ]]
function UIUtil.ReleaseMobileScale(scale: UIScale)
	trackedScales[scale] = nil
end

--[[ Standard ScreenGui defaults for WAR EMPIRE panels. ]]
function UIUtil.PrepareScreen(screen: ScreenGui, ignoreInset: boolean?)
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = ignoreInset == true
	UIUtil.AttachMobileScale(screen)
end

--[[ Lightweight empty-state label for list panels. ]]
function UIUtil.EmptyState(parent: Instance, message: string, order: number?): TextLabel
	local lab = Instance.new("TextLabel")
	lab.Name = "EmptyState"
	lab.Size = UDim2.new(1, -8, 0, 56)
	lab.BackgroundTransparency = 1
	lab.Font = Enum.Font.Gotham
	lab.TextSize = 13
	lab.TextWrapped = true
	lab.TextXAlignment = Enum.TextXAlignment.Center
	lab.TextYAlignment = Enum.TextYAlignment.Center
	lab.TextColor3 = Color3.fromRGB(140, 150, 140)
	lab.Text = message
	lab.LayoutOrder = order or 0
	lab.Parent = parent
	return lab
end

--[[ Ensure a GuiButton meets mobile min touch (default 64px for advanced HUD). ]]
function UIUtil.EnsureMinTouch(btn: GuiButton, minPx: number?)
	local m = minPx or 64
	local sz = btn.Size
	local w = sz.X.Offset
	local h = sz.Y.Offset
	if w > 0 and w < m then
		btn.Size = UDim2.new(sz.X.Scale, m, sz.Y.Scale, math.max(h, m))
	elseif h > 0 and h < m then
		btn.Size = UDim2.new(sz.X.Scale, math.max(w, m), sz.Y.Scale, m)
	end
end

function UIUtil.GoldStroke(parent: Instance, thickness: number?): UIStroke
	return UIUtil.Stroke(parent, Color3.fromRGB(230, 190, 60), thickness or 1.5)
end

--[[
	Large rounded glossy action tile for mobile dock.
	icon: short emoji/symbol string; label: caption under icon.
]]
function UIUtil.MakeActionTile(
	parent: Instance,
	props: {
		Name: string,
		Icon: string,
		Label: string,
		Color: Color3,
		LayoutOrder: number?,
		SizePx: number?,
	}
): TextButton
	local size = props.SizePx or 72
	local btn = Instance.new("TextButton")
	btn.Name = props.Name
	btn.Size = UDim2.fromOffset(size, size)
	btn.BackgroundColor3 = props.Color
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Text = ""
	btn.LayoutOrder = props.LayoutOrder or 0
	btn.ZIndex = 20
	btn.Active = true
	btn.Selectable = true
	btn.Parent = parent
	UIUtil.Corner(btn, 16)
	local stroke = UIUtil.Stroke(btn, Color3.fromRGB(255, 255, 255), 1.5)
	stroke.Transparency = 0.45

	-- Glossy top highlight — Active=false so it never steals Activated/clicks
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.Size = UDim2.new(1, -8, 0, math.floor(size * 0.28))
	gloss.Position = UDim2.fromOffset(4, 4)
	gloss.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	gloss.BackgroundTransparency = 0.72
	gloss.BorderSizePixel = 0
	gloss.ZIndex = 21
	gloss.Active = false
	gloss.Parent = btn
	UIUtil.Corner(gloss, 10)

	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.new(1, 0, 0, math.floor(size * 0.48))
	icon.Position = UDim2.fromOffset(0, 6)
	icon.Font = Enum.Font.GothamBold
	icon.TextSize = math.floor(size * 0.36)
	icon.TextColor3 = Color3.fromRGB(255, 255, 255)
	icon.Text = props.Icon
	icon.ZIndex = 22
	icon.Active = false
	icon.Parent = btn

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -4, 0, 16)
	label.Position = UDim2.new(0, 2, 1, -20)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.5
	label.Text = props.Label
	label.ZIndex = 22
	label.Active = false
	label.Parent = btn

	UIUtil.EnsureMinTouch(btn, 64)
	return btn
end

---------------------------------------------------------------------------------------------------------------
-- v70 HUD helpers (HudConfig-driven)
---------------------------------------------------------------------------------------------------------------

--[[ Mix a colour toward white by t (0..1). ]]
function UIUtil.Lighten(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), math.clamp(t, 0, 1))
end

--[[ Glyph outline (UIStroke, Contextual) — the v70 "plain outlined text" look. Default HudConfig.Colors.Ink. ]]
function UIUtil.TextOutline(label: GuiObject, thickness: number?, color: Color3?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Color = color or HudConfig.Colors.Ink
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = label
	return s
end

export type RailTileProps = {
	Name: string, -- MobileActionBar child name (pinned: "DockShop", "DockMissions" ...)
	Label: string, -- "Shop"
	Accent: Color3,
	Fill: Color3,
	Icon: string?, -- HudIcons kind (kept as the attribute "Icon")
	-- draws the icon into IconSlot (60 % of the tile, centred in its top 78 %). HUDController passes
	-- function(slot, ink, fill) HudIcons.Make(kind, slot, {Size = UDim2.fromScale(1, 1), Color = ink, Fill = fill}) end
	IconBuilder: ((slot: Frame, ink: Color3, fill: Color3) -> ())?,
	LayoutOrder: number?,
	Touch: boolean?, -- touch sizes (HudConfig.Rail.Tile …); default UserInputService.TouchEnabled
}

local function circle(parent: Instance, name: string, size: number, color: Color3, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Active = false
	f.Parent = parent
	UIUtil.Corner(f, math.ceil(size / 2))
	return f
end

--[[
	v70 left-rail cell (HudConfig.Rail). ONE TextButton of T × (T + LabelOverhang) v, so the hit area includes
	the label (64 x 70 v touch = 44.8 x 49 real px on phones). Children:
	  Group (press UIScale "Press") › Outline (1.5 v Ink) + Tile (Accent ring = StrokePx edge)
	    Tile › Face (Fill lightened 16 % → Fill gradient), IconSlot, Badge (hidden; see SetTileBadge)
	  Label — FredokaOne, white, 2 px Ink outline, straddling the tile's bottom edge
	The caller wires btn.Activated (pinned) — this helper only adds the visual press feedback.
	-- dock≤8: rail gap 5/8 v (HudConfig.Rail.Gap / GapDesktop)
]]
function UIUtil.MakeRailTile(parent: Instance?, props: RailTileProps): TextButton
	local R = HudConfig.Rail
	local touch = if props.Touch == nil then UserInputService.TouchEnabled else props.Touch == true
	local T = if touch then R.Tile else R.TileDesktop
	local ov = if touch then R.LabelOverhang else R.LabelOverhangDesktop
	local L = if touch then R.LabelSize else R.LabelSizeDesktop
	local edge = R.StrokePx
	local ink = HudConfig.Colors.Ink

	local btn = Instance.new("TextButton")
	btn.Name = props.Name
	btn.Size = UDim2.fromOffset(T, T + ov)
	btn.BackgroundTransparency = 1
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.LayoutOrder = props.LayoutOrder or 0
	btn.Active = true
	btn.Selectable = true
	btn.ZIndex = 20
	btn:SetAttribute("RailTile", true)
	if props.Icon then
		btn:SetAttribute("Icon", props.Icon)
	end

	local group = Instance.new("Frame")
	group.Name = "Group"
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.Position = UDim2.new(0.5, 0, 0, T / 2)
	group.Size = UDim2.fromOffset(T, T)
	group.BackgroundTransparency = 1
	group.BorderSizePixel = 0
	group.ZIndex = 20
	group.Active = false
	group.Parent = btn
	local press = Instance.new("UIScale")
	press.Name = "Press"
	press.Parent = group

	local outline = Instance.new("Frame")
	outline.Name = "Outline"
	outline.AnchorPoint = Vector2.new(0.5, 0.5)
	outline.Position = UDim2.fromScale(0.5, 0.5)
	outline.Size = UDim2.new(1, 3, 1, 3)
	outline.BackgroundColor3 = ink
	outline.BackgroundTransparency = 0.45
	outline.BorderSizePixel = 0
	outline.ZIndex = 20
	outline.Active = false
	outline.Parent = group
	UIUtil.Corner(outline, R.Corner + 1.5)

	local tile = Instance.new("Frame")
	tile.Name = "Tile"
	tile.AnchorPoint = Vector2.new(0.5, 0.5)
	tile.Position = UDim2.fromScale(0.5, 0.5)
	tile.Size = UDim2.fromScale(1, 1)
	tile.BackgroundColor3 = props.Accent
	tile.BorderSizePixel = 0
	tile.ZIndex = 21
	tile.Active = false
	tile.Parent = group
	UIUtil.Corner(tile, R.Corner)

	local top = UIUtil.Lighten(props.Fill, 0.16)
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.new(1, -2 * edge, 1, -2 * edge)
	face.BackgroundColor3 = top
	face.BorderSizePixel = 0
	face.ZIndex = 22
	face.Active = false
	face.Parent = tile
	UIUtil.Corner(face, math.max(0, R.Corner - edge))
	-- UIGradient multiplies: top colour × 1 → Fill at the bottom (per-channel ratio)
	local function ratio(a: number, b: number): number
		return if b > 0 then math.clamp(a / b, 0, 1) else 1
	end
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(
		Color3.new(1, 1, 1),
		Color3.new(ratio(props.Fill.R, top.R), ratio(props.Fill.G, top.G), ratio(props.Fill.B, top.B))
	)
	grad.Parent = face

	local slot = Instance.new("Frame")
	slot.Name = "IconSlot"
	slot.AnchorPoint = Vector2.new(0.5, 0.5)
	slot.Position = UDim2.fromScale(0.5, 0.39)
	slot.Size = UDim2.fromScale(R.IconScale, R.IconScale)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.ZIndex = 23
	slot.Active = false
	slot.Parent = tile
	if props.IconBuilder then
		-- the face colour behind the icon's centre (gradient at 39 %)
		local behind = props.Fill:Lerp(top, 1 - 0.39)
		local build = props.IconBuilder
		local ok, err = pcall(function(): string?
			build(slot, UIUtil.Lighten(props.Accent, 0.12), behind)
			return nil
		end)
		if not ok then
			warn("[UIUtil] rail icon failed:", props.Name, err)
		end
	end

	local B = R.Badge
	local badge = circle(tile, "Badge", B.Size + 4, ink, 30)
	local inset: Vector2 = (B :: any).Inset or Vector2.new(4, 4)
	badge.Position = UDim2.new(1, -inset.X, 0, inset.Y)
	badge.Visible = false
	local dot = circle(badge, "Dot", B.Size, B.Bg, 31)
	local btext = Instance.new("TextLabel")
	btext.Name = "Text"
	btext.BackgroundTransparency = 1
	btext.Size = UDim2.fromScale(1, 1)
	btext.Font = HudConfig.Fonts.Display
	btext.TextSize = B.TextSize
	btext.TextColor3 = HudConfig.Colors.White
	btext.Text = ""
	btext.ZIndex = 32
	btext.Active = false
	btext.Parent = dot
	local badgeScale = Instance.new("UIScale")
	badgeScale.Name = "Pop"
	badgeScale.Parent = badge

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 1, -(ov + 0.62 * L))
	label.Size = UDim2.new(1, 32, 0, L)
	label.Font = HudConfig.Fonts.Display
	label.TextSize = L
	label.TextColor3 = HudConfig.Colors.White
	label.Text = props.Label
	label.ZIndex = 25
	label.Active = false
	label.Parent = btn
	UIUtil.TextOutline(label, R.LabelStroke)

	btn.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			press.Scale = R.PressScale
		end
	end)
	local function release()
		if press.Scale ~= 1 then
			TweenService:Create(press, TweenInfo.new(0.06), { Scale = 1 }):Play()
		end
	end
	btn.InputEnded:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			release()
		end
	end)
	btn.MouseLeave:Connect(release)

	if parent then
		btn.Parent = parent
	end
	return btn
end

--[[ Rail badge on a MakeRailTile button: "!" = gold ready style, a count = red, nil / "" / "0" hides.
	Pops once (UIScale 1 → 1.2 → 1) when it appears. ]]
function UIUtil.SetTileBadge(tileButton: Instance, text: string?)
	local badge = tileButton:FindFirstChild("Badge", true)
	if not (badge and badge:IsA("GuiObject")) then
		return
	end
	local show = text ~= nil and text ~= "" and text ~= "0"
	local was = badge.Visible
	badge.Visible = show
	if not show or text == nil then
		return
	end
	local B = HudConfig.Rail.Badge
	local ready = text == "!"
	local dot = badge:FindFirstChild("Dot")
	if dot and dot:IsA("GuiObject") then
		dot.BackgroundColor3 = if ready then B.ReadyBg else B.Bg
		local lab = dot:FindFirstChild("Text")
		if lab and lab:IsA("TextLabel") then
			lab.Text = text
			lab.TextColor3 = if ready then B.ReadyText else HudConfig.Colors.White
		end
	end
	if not was and B.PulseWhenNew then
		local pop = badge:FindFirstChild("Pop")
		if pop and pop:IsA("UIScale") then
			pop.Scale = 1
			TweenService:Create(pop, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Scale = 1.2 }):Play()
		end
	end
end

--[[
	Black dim behind an open panel (HudConfig.Context.ModalDim = its BackgroundTransparency). Put it in the
	panel's own ScreenGui; it is created as the lowest layer and oversized so it covers the whole gui area.
	Active = false (the world still gets the input); on a tap/click OUTSIDE `panel` (when given) it calls onTap.
	Returns the existing "ModalDim" when there is one. Toggle .Visible with the panel.
]]
function UIUtil.MakeModalDim(screen: Instance, onTap: (() -> ())?, panel: GuiObject?): Frame
	local existing = screen:FindFirstChild("ModalDim")
	if existing and existing:IsA("Frame") then
		return existing
	end
	local dim = Instance.new("Frame")
	dim.Name = "ModalDim"
	dim.AnchorPoint = Vector2.new(0.5, 0.5)
	dim.Position = UDim2.fromScale(0.5, 0.5)
	dim.Size = UDim2.fromScale(3, 3)
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = HudConfig.Context.ModalDim
	dim.BorderSizePixel = 0
	dim.ZIndex = 0
	dim.LayoutOrder = -1000
	dim.Active = false
	dim.Parent = screen
	if onTap then
		local cb: () -> () = onTap
		dim.InputBegan:Connect(function(input: InputObject)
			local t = input.UserInputType
			if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
				return
			end
			if panel and panel.Visible then
				local p = Vector2.new(input.Position.X, input.Position.Y)
				local a, s = panel.AbsolutePosition, panel.AbsoluteSize
				if p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y then
					return
				end
			end
			cb()
		end)
	end
	return dim
end

return UIUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">WorldLabel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WorldLabel: the one way to make a floating world label (HUD v70 spec §5; CLAUDE.md "World labels").
	Server or client. Never yields.

	API
	  WorldLabel.Create(adornee, text, opts?) -> BillboardGui
	      Plain outlined text, no card. Box is stud-scaled (Size = UDim2.fromScale(studsW, studsH)); text is a fixed
	      TextSize clamped to 14-20 real px (never TextScaled). AlwaysOnTop = false, LightInfluence = 0,
	      MaxDistance <= WorldLabelConfig.MaxDistance (40). adornee: BasePart | Attachment | Model (a Model uses its
	      PrimaryPart, else its first BasePart). The label is parented last, so it replicates fully built.
	  WorldLabel.Surface(part, face, text, opts?) -> SurfaceGui
	      Painted sign on one face (PixelsPerStud, LightInfluence 0, MaxDistance <= 80, clipped to the face).
	      Text is sized from the face height unless opts.TextSize is given (canvas px, 14-100).
	  WorldLabel.SetText(gui, text, sub?, subColor?)   update in place; sub nil/"" hides the second line
	  WorldLabel.SetOwner(gui, userId?)                only that player sees it (nil = everyone)
	  WorldLabel.SetRole(bb, role?)                    "objective" | "contested" -> AlwaysOnTop; nil -> off
	  WorldLabel.StartOwnerFilter() -> boolean         CLIENT, once (WorldPromptController.Init); false on the server

	opts (all optional)
	  Name         instance name; keep pinned names ("WE_FlagBillboard", "WE_GateSign"). Default "WE_WorldLabel" /
	               "WE_WorldSign"
	  Sub          second, smaller line ("$850", "RAID IN PROGRESS")
	  Color        title colour (default white);  SubColor (default HudConfig.Colors.Muted)
	  TextSize     title px (billboard: clamped 14-20, default 16; the sub line is 14)
	  Studs        Vector2 box size in studs (default HudConfig.WorldLabels.Default StudsW x StudsH)
	  Offset       Vector3 StudsOffsetWorldSpace from the adornee (default: StudsAbove over a part's top)
	  MaxDistance  studs; clamped to the cap (billboard 40, surface 80)
	  OwnerUserId  owner-only label (see below)
	  Role         "objective" | "contested": the only labels allowed AlwaysOnTop (billboard only)
	  PixelsPerStud  surface only (default 40)
	  Parent       default: the resolved adornee (billboard) / the part (surface)

	Owner-only (no PlayerGui copies): the label stays in Workspace with attribute WE_LabelOwner = UserId and the
	CollectionService tag "WE_OwnerLabel" (names in WorldLabelConfig). Each client's StartOwnerFilter sets
	Enabled = false LOCALLY on tagged labels owned by someone else and restores the server's value when the label
	becomes theirs; server Enabled changes keep working for the owner. Cosmetic only: the text still replicates to
	every client, so never put anything secret in a label. Limit: if the server turns a label off while the filter
	is already hiding it (no change event), handing that label to this player shows it again, so hide
	owner-only labels by Destroy or text rather than Enabled.

	WorldLabelPolicy (server) applies the same caps to every BillboardGui in Workspace, inside plots and out, and
	honours WE_LabelRole for AlwaysOnTop.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Configs = script.Parent.Parent.Configs
local HudConfig = require(Configs.HudConfig)
local WorldLabelConfig = require(Configs.WorldLabelConfig)

export type Role = "objective" | "contested"
export type Options = {
	Name: string?,
	Sub: string?,
	Color: Color3?,
	SubColor: Color3?,
	TextSize: number?,
	Studs: Vector2?,
	Offset: Vector3?,
	MaxDistance: number?,
	OwnerUserId: number?,
	Role: Role?,
	PixelsPerStud: number?,
	Parent: Instance?,
}

local WorldLabel = {}

local LOOK = HudConfig.WorldLabels.Default
local INK = HudConfig.Colors.Ink
local WHITE = HudConfig.Colors.White
local MUTED = HudConfig.Colors.Muted
local ROLE_ATTR = WorldLabelConfig.RoleAttribute
local OWNER_ATTR = WorldLabelConfig.OwnerAttribute
local OWNER_TAG = WorldLabelConfig.OwnerTag

local function clampSize(v: number, lo: number, hi: number): number
	return math.clamp(math.floor(v + 0.5), lo, hi)
end

local function capDistance(want: number?, default: number, cap: number): number
	local d = if want ~= nil and want > 0 then want else default
	return math.min(d, cap)
end

local function resolveAdornee(adornee: Instance): Instance?
	if adornee:IsA("BasePart") or adornee:IsA("Attachment") then
		return adornee
	end
	if adornee:IsA("Model") then
		return adornee.PrimaryPart or adornee:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function makeLine(parent: Instance, name: string, text: string, size: number, color: Color3, font: Enum.Font): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Size = UDim2.new(1, 0, 0, size + WorldLabelConfig.LinePad)
	t.Position = UDim2.fromScale(0.5, 0.5)
	t.Font = font
	t.Text = text
	t.TextSize = size
	t.TextScaled = false
	t.TextWrapped = false
	t.TextColor3 = color
	t.TextStrokeColor3 = INK
	t.TextStrokeTransparency = 0
	t.TextXAlignment = Enum.TextXAlignment.Center
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Parent = parent
	return t
end

-- Lines are stacked in fixed px around the box centre, so they never overlap however small the stud box gets on
-- screen (the text overflows the box symmetrically; ClipsDescendants stays off on billboards).
local function layout(title: TextLabel, sub: TextLabel)
	local pad = WorldLabelConfig.LinePad
	local want = UDim2.fromScale(0.5, 0.5)
	if sub.Visible then
		local hT = title.TextSize + pad
		local hS = sub.TextSize + pad
		want = UDim2.new(0.5, 0, 0.5, -hS / 2)
		local subPos = UDim2.new(0.5, 0, 0.5, hT / 2)
		if sub.Position ~= subPos then
			sub.Position = subPos
		end
	end
	if title.Position ~= want then
		title.Position = want
	end
end

local function addLines(gui: LayerCollector, text: string, opts: Options, titleSize: number, subSize: number)
	local font = LOOK.Font
	local title = makeLine(gui, "Title", text, titleSize, opts.Color or WHITE, font)
	local subText = opts.Sub
	local sub = makeLine(gui, "Sub", subText or "", subSize, opts.SubColor or MUTED, font)
	sub.Visible = subText ~= nil and subText ~= ""
	layout(title, sub)
end

function WorldLabel.SetOwner(gui: LayerCollector, userId: number?)
	if userId ~= nil and userId ~= 0 then
		if gui:GetAttribute(OWNER_ATTR) ~= userId then
			gui:SetAttribute(OWNER_ATTR, userId)
		end
		CollectionService:AddTag(gui, OWNER_TAG)
	else
		-- attribute first: a watching client restores the label on the attribute change
		if gui:GetAttribute(OWNER_ATTR) ~= nil then
			gui:SetAttribute(OWNER_ATTR, nil)
		end
		CollectionService:RemoveTag(gui, OWNER_TAG)
	end
end

function WorldLabel.SetRole(bb: BillboardGui, role: Role?)
	-- attribute before AlwaysOnTop: WorldLabelPolicy's AlwaysOnTop watcher reads the role
	if bb:GetAttribute(ROLE_ATTR) ~= role then
		bb:SetAttribute(ROLE_ATTR, role)
	end
	local top = role ~= nil and WorldLabelConfig.AlwaysOnTopRoles[role] == true
	if bb.AlwaysOnTop ~= top then
		bb.AlwaysOnTop = top
	end
end

function WorldLabel.SetText(gui: LayerCollector, text: string, sub: string?, subColor: Color3?)
	local title = gui:FindFirstChild("Title")
	local subLine = gui:FindFirstChild("Sub")
	if not (title and title:IsA("TextLabel") and subLine and subLine:IsA("TextLabel")) then
		return
	end
	if title.Text ~= text then
		title.Text = text
	end
	local show = sub ~= nil and sub ~= ""
	if show and sub ~= nil and subLine.Text ~= sub then
		subLine.Text = sub
	end
	if subColor ~= nil and subLine.TextColor3 ~= subColor then
		subLine.TextColor3 = subColor
	end
	if subLine.Visible ~= show then
		subLine.Visible = show
	end
	layout(title, subLine)
end

function WorldLabel.Create(adornee: Instance, text: string, opts: Options?): BillboardGui
	local o: Options = opts or {}
	local target = resolveAdornee(adornee)
	if target == nil then
		warn("[WorldLabel] no BasePart/Attachment to adorn for " .. adornee:GetFullName())
	end
	local studs = o.Studs or Vector2.new(LOOK.StudsW, LOOK.StudsH)
	local above = WorldLabelConfig.StudsAbove
	local offset: Vector3 = o.Offset
		or (if target ~= nil and target:IsA("BasePart") then Vector3.new(0, target.Size.Y * 0.5 + above, 0) else Vector3.new(0, above, 0))
	local minT, maxT = WorldLabelConfig.MinTextSize, WorldLabelConfig.MaxTextSize
	local titleSize = clampSize(o.TextSize or WorldLabelConfig.TextSize, minT, maxT)
	local subSize = math.min(clampSize(WorldLabelConfig.SubTextSize, minT, maxT), titleSize)

	local bb = Instance.new("BillboardGui")
	bb.Name = o.Name or "WE_WorldLabel"
	bb.Size = UDim2.fromScale(studs.X, studs.Y)
	bb.StudsOffsetWorldSpace = offset
	bb.MaxDistance = capDistance(o.MaxDistance, LOOK.MaxDistance, WorldLabelConfig.MaxDistance)
	bb.LightInfluence = 0
	bb.ClipsDescendants = false
	bb.Active = false
	bb.AlwaysOnTop = false
	if target ~= nil then
		bb.Adornee = target
	end
	addLines(bb, text, o, titleSize, subSize)
	if o.Role ~= nil then
		WorldLabel.SetRole(bb, o.Role)
	end
	if o.OwnerUserId ~= nil then
		WorldLabel.SetOwner(bb, o.OwnerUserId)
	end
	bb.Parent = o.Parent or target or adornee
	return bb
end

local function faceSize(part: BasePart, face: Enum.NormalId): Vector2
	local s = part.Size
	if face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		return Vector2.new(s.Z, s.Y)
	elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		return Vector2.new(s.X, s.Z)
	end
	return Vector2.new(s.X, s.Y)
end

function WorldLabel.Surface(part: BasePart, face: Enum.NormalId, text: string, opts: Options?): SurfaceGui
	local o: Options = opts or {}
	local pps = if o.PixelsPerStud ~= nil and o.PixelsPerStud > 0 then o.PixelsPerStud else WorldLabelConfig.SurfacePixelsPerStud
	local faceH = faceSize(part, face).Y * pps
	local hasSub = o.Sub ~= nil and o.Sub ~= ""
	local minT, maxT = WorldLabelConfig.MinTextSize, WorldLabelConfig.SurfaceMaxTextSize
	local titleSize = clampSize(o.TextSize or faceH * (if hasSub then 0.42 else 0.55), minT, maxT)
	local subSize = math.min(clampSize(faceH * 0.28, minT, maxT), titleSize)

	local sg = Instance.new("SurfaceGui")
	sg.Name = o.Name or "WE_WorldSign"
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = pps
	sg.MaxDistance = capDistance(o.MaxDistance, WorldLabelConfig.SurfaceDefaultMaxDistance, WorldLabelConfig.SurfaceMaxDistance)
	sg.LightInfluence = 0
	sg.ClipsDescendants = true
	sg.AlwaysOnTop = false
	sg.Adornee = part
	addLines(sg, text, o, titleSize, subSize)
	if o.OwnerUserId ~= nil then
		WorldLabel.SetOwner(sg, o.OwnerUserId)
	end
	sg.Parent = o.Parent or part
	return sg
end

-- ── client: owner-only filter ───────────────────────────────────────────────────────────────────────────────
local filterStarted = false
local watched: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })
local serverEnabled: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })
local forced: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" }) -- value this client wrote

local function ownerOf(gui: Instance): number?
	local v = gui:GetAttribute(OWNER_ATTR)
	if type(v) == "number" and v ~= 0 then
		return v
	end
	return nil
end

local function applyFilter(gui: LayerCollector, me: number)
	local owner = ownerOf(gui)
	if owner ~= nil and owner ~= me then
		if forced[gui] == nil then
			serverEnabled[gui] = gui.Enabled
		end
		forced[gui] = false
		if gui.Enabled then
			gui.Enabled = false
		end
	elseif forced[gui] ~= nil then
		forced[gui] = nil
		local want = serverEnabled[gui]
		if want ~= nil and gui.Enabled ~= want then
			gui.Enabled = want
		end
	end
end

local function watch(inst: Instance, me: number)
	if not (inst:IsA("BillboardGui") or inst:IsA("SurfaceGui")) then
		return
	end
	local gui = inst :: LayerCollector
	if watched[gui] then
		applyFilter(gui, me)
		return
	end
	watched[gui] = true
	serverEnabled[gui] = gui.Enabled
	gui:GetAttributeChangedSignal(OWNER_ATTR):Connect(function()
		applyFilter(gui, me)
	end)
	gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		local f = forced[gui]
		if f ~= nil and gui.Enabled == f then
			return -- this client's own write (signals are deferred, so no re-entrancy flag)
		end
		serverEnabled[gui] = gui.Enabled
		applyFilter(gui, me)
	end)
	applyFilter(gui, me)
end

function WorldLabel.StartOwnerFilter(): boolean
	if filterStarted then
		return true
	end
	local lp = Players.LocalPlayer
	if lp == nil then
		return false
	end
	filterStarted = true
	local me = lp.UserId
	CollectionService:GetInstanceAddedSignal(OWNER_TAG):Connect(function(inst: Instance)
		watch(inst, me)
	end)
	for _, inst in ipairs(CollectionService:GetTagged(OWNER_TAG)) do
		watch(inst, me)
	end
	return true
end

return WorldLabel
