			kitPart(plinth, "ParkedHeli", Vector3.new(0.25, 1.0, 4.5), Vector3.new(hx + 1.5, 1.55, hz), Color3.fromRGB(35, 38, 32), Enum.Material.Metal, nil) -- skid R
