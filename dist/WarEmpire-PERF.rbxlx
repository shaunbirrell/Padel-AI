        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CodesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Redeemable promo codes (Cash / Gold). Server validates once per code per player.
	Sample codes only — rotate for live seasons.
]]

export type CodeReward = {
	Cash: number?,
	Gold: number?,
	DisplayName: string?,
}

local CodesConfig = {
	-- Normalize: uppercase, strip spaces
	MaxCodeLength = 32,
	Codes = {
		WARFOUNDING = {
			Cash = 15000,
			Gold = 5,
			DisplayName = "War Founding",
		},
		BUILDCONQUER = {
			Cash = 8000,
			Gold = 2,
			DisplayName = "Build & Conquer",
		},
	} :: { [string]: CodeReward },
}

return CodesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CombatConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Combat tuning — health, kill rewards, NPC pool/AI.
	Weapon stats live in WeaponConfig; never trust client damage amounts.
]]

export type NPCTypeDef = {
	Id: string,
	DisplayName: string,
	Health: number,
	Damage: number,
	FireRate: number,
	Range: number,
	WalkSpeed: number,
	AggroRange: number,
	CashReward: number,
	XPReward: number,
	Color: Color3,
}

local CombatConfig = {
	PlayerMaxHealth = 100,
	SpawnInvulnerabilitySeconds = 3, -- mirrors GameConfig; CombatService uses this

	PlayerKill = {
		Cash = 150,
		XP = 40,
	},

	DefaultNPCKill = {
		Cash = 50,
		XP = 15,
	},

	MaxOriginDeltaStuds = 12,
	MaxAimDirectionError = 0.001,
	HitPositionSlopStuds = 4,

	FireRemoteRate = 20,
	FireRemoteBurst = 28,
	ReloadRemoteRate = 2,
	ReloadRemoteBurst = 3,
	EquipRemoteRate = 3,
	EquipRemoteBurst = 4,
	PurchaseWeaponRate = 2,
	PurchaseWeaponBurst = 3,

	MaxActiveNPCs = 18,
	NPCRespawnSeconds = 18,
	NPCThinkInterval = 0.35,
	NPCAlsoSpawnNearTerritories = true,
	MaxTerritoryNPCSpawns = 4,

	NPCTypes = {
		Infantry = {
			Id = "Infantry",
			DisplayName = "Hostile Infantry",
			Health = 80,
			Damage = 10,
			FireRate = 2.5,
			Range = 70,
			WalkSpeed = 12,
			AggroRange = 90,
			CashReward = 50,
			XPReward = 15,
			Color = Color3.fromRGB(140, 55, 55),
		},
		HeavyInfantry = {
			Id = "HeavyInfantry",
			DisplayName = "Heavy Infantry",
			Health = 140,
			Damage = 16,
			FireRate = 1.6,
			Range = 85,
			WalkSpeed = 10,
			AggroRange = 100,
			CashReward = 90,
			XPReward = 28,
			Color = Color3.fromRGB(90, 40, 40),
		},
		OilRigGuard = {
			Id = "OilRigGuard",
			DisplayName = "Oil Rig Guard",
			Health = 200,
			Damage = 20,
			FireRate = 1.4,
			Range = 95,
			WalkSpeed = 9,
			AggroRange = 120,
			CashReward = 140,
			XPReward = 40,
			Color = Color3.fromRGB(110, 70, 35),
		},
		-- v71 bank retune (task #20): HEAD's 5 guards (28 dmg × 2.2/s, aggro 130) out-shot any player + squad
		-- (~200 dps at 35 studs), so the Empire Bank was unwinnable. Now 5 × 12 dmg × 1.3/s (~49 dps at 35 studs
		-- after the P1-2 hit chance): a lone player in the open still dies, a player + squad using cover takes it
		-- (headless end-to-end sim with the real BankRaidService: 7/7 seeds). Tankier (200 HP) so the squad matters.
		BankGuard = {
			Id = "BankGuard",
			DisplayName = "Bank Guard",
			Health = 200,
			Damage = 12,
			FireRate = 1.3,
			Range = 75,
			WalkSpeed = 14,
			AggroRange = 90,
			CashReward = 150,
			XPReward = 45,
			Color = Color3.fromRGB(55, 65, 120),
		},
		FortGuard = {
			Id = "FortGuard",
			DisplayName = "Fort Guard",
			Health = 170,
			Damage = 17,
			FireRate = 1.7,
			Range = 90,
			WalkSpeed = 10,
			AggroRange = 110,
			CashReward = 120,
			XPReward = 35,
			Color = Color3.fromRGB(100, 95, 70),
		},
	} :: { [string]: NPCTypeDef },

	DefaultNPCType = "Infantry",
}

return CombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CombatFairnessConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Combat fairness (mobile plan P0-7, P0-6 server part, P1-2, P1-4). About 80 % of players are on phones, so the
	server never trusts a client-named target, keeps brand-new players out of raids, makes NPCs need line of sight
	and miss sometimes, and makes the default squad order (FOLLOW) protect the player. Server-side numbers only.
]]

local CombatFairnessConfig = {
	-- ── P0-7 · claimed target (CombatService.RequestFire) ─────────────────────────────────────────────────────
	-- When the server's own fire ray misses every player / NPC / gate, the TargetUserId / TargetNpcId the client sent
	-- may still take the hit (lag tolerance: the target moved after the phone's ray hit it), but only if the target
	-- is alive, in front of the fire ray, within weapon range, its torso lies within MissTolerance studs sideways of
	-- the ray, and a server ray from the validated origin to that torso hits the target before any wall, terrain,
	-- vehicle or other player. Fire rate and ammo are spent before this check, exactly as for any shot.
	MissTolerance = 5, -- studs sideways from the fire ray to the target torso (v70: 4 → 5 so phone players on ~250 ms cellular still land 10/12 aim points on a walking target; line of sight is still required)
	ClaimLosPastTorsoStuds = 2, -- the line-of-sight ray runs this far past the torso centre so it can touch the target
	-- The fire ray hit only scenery (usually the ground behind the target): the claim is still checked as above, if
	-- the torso is no further along the ray than that hit + ClaimBeyondHitStuds. false = only rays that hit nothing.
	ClaimAfterSceneryHit = true,
	ClaimBeyondHitStuds = 3,
	RefusalLogSeconds = 10, -- at most one refusal log line per shooter per this many seconds (the rest are counted)

	-- ── P0-6 · new-thief protection (MoneyCollectorService.CanRaid) ───────────────────────────────────────────
	-- Mirrors the victim's new-player protection: a thief who has not finished (or skipped) the tutorial, or who
	-- joined less than ThiefProtectMinutes ago, cannot start or finish an ATM raid. Texts are device-neutral.
	ThiefProtectEnabled = true,
	ThiefProtectMinutes = 10, -- since profile.FirstJoinUnix
	ThiefRequireTutorialDone = true,
	ThiefProtectInStudio = false, -- like RaidConfig.Raid.ProtectNewPlayersInStudio (Studio makes fresh profiles)
	ThiefTutorialText = "Finish or skip the tutorial to start raiding",
	ThiefNewText = "New player — raids unlock in %s", -- %s = m:ss

	-- ── P1-2 · NPC shots (CombatNPC.Think) ───────────────────────────────────────────────────────────────────
	NpcRequireLos = true, -- a ray from the NPC's eyes to the target must not hit anything else first
	NpcLosRespectCanCollide = true, -- non-collidable decor does not block (same rule as the gate guards)
	NpcIgnoreTargetVehicle = true, -- the vehicle the target SITS in never blocks (no free shield until vehicle HP, M4)
	NpcEyeHeight = 1.5, -- studs above the NPC root the shot starts from
	NpcNearStuds = 20, -- at or inside this distance the hit chance is NpcNearHitChance
	NpcNearHitChance = 0.75,
	NpcFarHitChance = 0.30, -- at the NPC type's max Range; linear in between
	NpcFastTargetSpeed = 10, -- studs/s (horizontal, sampled on the server); faster targets are harder to hit
	NpcFastTargetPenalty = 0.15, -- subtracted from the hit chance against fast targets
	NpcMinHitChance = 0.05,
	NpcReactionSeconds = 0.5, -- no shot until the NPC has seen its (new) target this long
	NpcReactionOnLosRegain = true, -- losing sight restarts the reaction delay (peeking from cover is fair)
	NpcChaseWithoutLos = true, -- an NPC in range but without a clear shot keeps closing in

	-- ── P1-4 · squad escort (SquadOrdersService, order "Follow") ─────────────────────────────────────────────
	EscortEngageRadius = 55, -- FOLLOW units shoot hostiles within this distance of their player
	EscortLeash = 20, -- ...while staying within this distance of the player
	EscortRequireLos = true, -- escort shots need line of sight (friendly units and the owner never block)
	UnitKillCashShare = 0.5, -- a kill landed by a squad unit pays the owner this share of the normal kill cash
	UnitKillXPShare = 1, -- ...and this share of the normal kill XP (kills and mission progress count in full)
	-- Attack-order hits credit the owner too? Off: Attack units roam with no leash and no line of sight, so an idle
	-- owner hidden behind a wall near the bank earned ~$9,150 in 10 min in the verifier sim (HEAD: $0). Escort only.
	UnitKillCreditOnAttack = false,
}

return CombatFairnessConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">ConsoleBuyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v71 console-only structure buying. Owner: "I don't think you should be able to just buy all the items from the
	base dashboard ... you should have to actually go and click the button".

	Base structures (BaseConfig.Structures) are built / upgraded ONLY at that structure's own console (walk-in
	building) or kiosk (outdoor installation) on YOUR plot: the BUY button in the action lane or the console's
	ProximityPrompt. The Base panel is an overview; its row button is GO (shows the way, never buys).

	Server truth (Shared/Util/ConsoleLocator + BaseService.PurchaseUpgrade): the player's HumanoidRootPart, as the
	server sees it, within a CYLINDER around that structure's console part on the player's own plot:
	horizontal (XZ) distance <= PromptDistance + ServerSlack and |dy| <= MaxVerticalOffset (the MissileStrike
	"at the Command Center" check works the same way). Positions come from the real console part, so rotated plots
	(BaseLayout.PlotCFrame / FaceMapCentre) need no math here.

	This is a presence rule for honest clients and the UI, enforced on the server. It is not anti-teleport: the
	character is network-owned by its player, so an exploiter who teleports next to the console meets the rule.
]]

local ConsoleBuyConfig = {
	-- Master switch. false = the server stops checking presence (rollback only). The Base panel stays GO-only.
	Enabled = true,

	-- ProximityPrompt WE_ServerBuyPrompt (UpgradePadService; these were the literals 10 / 16 / 0.35 / 0)
	ConsolePromptDistance = 10, -- console / kiosk MaxActivationDistance (studs, HRP -> console part centre)
	PadPromptDistance = 16, -- legacy walk-over pad (only when BaseLayoutConfig.Enabled = false)
	ConsoleHoldSeconds = 0.35, -- walking past never buys
	PadHoldSeconds = 0,

	-- Server check, horizontal: |HRP - buy point centre|xz <= (ConsolePromptDistance | PadPromptDistance) + ServerSlack.
	-- The client BUY box (WorldPromptController CONSOLE_MARGIN 5) reaches 8.5 studs horizontally, so the slack covers
	-- 9.5 studs of the server's HRP trailing the client: 0.59 s at WalkSpeed 16, 0.47 s with the Speed Boost (20).
	ServerSlack = 8,
	-- Server check, vertical: |HRP.Y - buy point centre.Y|. Covers the client BUY box (-4.7 .. +9.7) and a jump at the
	-- console (+8.5); refuses the upper floor of a two-storey walk-in (+14.1 above a ground-floor console).
	MaxVerticalOffset = 10,
	RejectSeated = true, -- seated (vehicle / chair) -> refused; the client already hides BUY while seated
	-- With two consoles in range only the nearest buys (horizontal distance). Margin in studs.
	RequireNearest = true,
	NearestMargin = 0.5,
	-- Console part missing on the player's plot (map rebuild in flight): "Deny" (refuse + warn once per plot and
	-- structure) or "Allow" (skip the check). v71 world: 15 / 15 consoles on 6 / 6 plots at L0 and L5.
	NoConsolePolicy = "Deny",

	-- Base panel GO -> waypoint to the console (client Modules/ConsoleWaypoint)
	Waypoint = {
		ArriveRadius = 10, -- cleared when the HRP is this close (the BUY button takes over)
		TimeoutSeconds = 120,
		RetrySeconds = 0.5, -- rebuild / retarget attempts (respawn, console streamed in) at most this often
		BeamWidth0 = 0.22, -- HUD rule: no beam wider than 0.25 or LightEmission above 0.3 outside the tutorial
		BeamWidth1 = 0.12,
		BeamLightEmission = 0.2,
		BeamColor = Color3.fromRGB(240, 214, 110),
		MarkerLift = 3, -- studs above the console top
		-- marker BillboardGui (real px): 14-20 px text (CLAUDE.md world labels), width follows the name length
		MarkerMinWidth = 140,
		MarkerMaxWidth = 300,
		MarkerMinTextPx = 14,
		MarkerMaxTextPx = 20,
		RefreshHz = 10, -- arrival check + distance label (CLAUDE.md: UI refresh <= 10 Hz)
	},

	Text = {
		NotAtConsole = "Go to your %s console to buy it", -- %s = BaseConfig DisplayName
		PanelSubtitle = "Buy at each building's console. GO shows the way.",
		Go = "GO",
		Max = "MAX",
		Needs = "Needs %s Lv %d", -- locked row: first unmet requirement
		Build = "Build %s", -- %s = cost
		Upgrade = "Lv %d -> %d  %s",
		WaypointSet = "Follow the line to the %s console",
		NoConsole = "Can't find that console yet. Try again in a moment.",
	},
}

return ConsoleBuyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DailyOpsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Three rotating Daily Ops (Military Tycoon–style short objectives).
	MissionService merges these into the daily mission list when enabled.
]]

export type DailyOpDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string, -- CaptureTerritory | KillNPC | RecruitSoldiers
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number,
	MinLevel: number,
}

local DailyOpsConfig = {
	Enabled = true,
	-- Always offer exactly these 3 (gold-forward rewards)
	Ops = {
		{
			Id = "DailyOpCapture",
			DisplayName = "Daily Op: Seize",
			Description = "Capture 2 territories or oil platforms.",
			ObjectiveType = "CaptureTerritory",
			Target = 2,
			RewardCash = 5000,
			RewardXP = 100,
			RewardGold = 3,
			MinLevel = 1,
		},
		{
			Id = "DailyOpKillNPC",
			DisplayName = "Daily Op: Clear Hostiles",
			Description = "Eliminate 15 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 15,
			RewardCash = 3500,
			RewardXP = 90,
			RewardGold = 2,
			MinLevel = 1,
		},
		{
			Id = "DailyOpRecruit",
			DisplayName = "Daily Op: Muster",
			Description = "Recruit 10 soldiers at the Training Yard.",
			ObjectiveType = "RecruitSoldiers",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 70,
			RewardGold = 2,
			MinLevel = 1,
		},
	} :: { DailyOpDef },
}

return DailyOpsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">DailyRewardConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ 7-day login streak; day 7 resets streak after claim. Field names match MissionService. ]]

local DailyRewardConfig = {
	Rewards = {
		{ Day = 1, Cash = 1000, Gold = 0, XP = 25 },
		{ Day = 2, Cash = 2000, Gold = 0, XP = 40 },
		{ Day = 3, Cash = 3500, Gold = 1, XP = 60 },
		{ Day = 4, Cash = 5000, Gold = 0, XP = 80 },
		{ Day = 5, Cash = 7500, Gold = 2, XP = 100 },
		{ Day = 6, Cash = 10000, Gold = 0, XP = 125 },
		{ Day = 7, Cash = 20000, Gold = 10, XP = 200 },
	},
	StreakResetsAfterDay = 7,
	MissedDayResetsStreak = true,
}

return DailyRewardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DevConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Studio-only flags. Production ignores unless RunService:IsStudio().

	Test / playtest helpers (Studio):
	- SkipTutorial = true  → profile.TutorialComplete on load (no tutorial UI)
	- StudioBoostCash      → set Cash to StudioBoostCashAmount on load
	- FastPassiveIncome    → passive tick every 1s instead of EconomyConfig tick
	- UnlockAllVehicles / UnlockAllWeapons → grant all on load
	- VerboseLogging       → extra Bootstrap prints

	Admin remotes (AdminConfig.UserIds only), via RequestAdminCommand:
	  givecash <n>, givegold <n>, givexp <n>, setlevel <n>, unlockall, resetbase,
	  resettutorial, grantpass <PassKey>, prestige/forceprestige, createclan/joinclan/leaveclan, bpxp, grantpremium
	v71 money (AdminConfig.MoneyCommands; admin allowlist, or any player in Studio; each logs ADMIN_COMMAND and replies
	"not built yet" until its service exists):
	  grantent <key>, givenuke <n> [tactical], nukecd, vhp <pct>, setprestige <n>, openzone <id>, resetrebirth
]]

local DevConfig = {
	StudioBoostCash = false,
	StudioBoostCashAmount = 100000,
	-- false so interactive tutorial can be playtested; set true to skip in Studio
	SkipTutorial = false,
	UnlockAllVehicles = false,
	UnlockAllWeapons = false,
	VerboseLogging = true,
	FastPassiveIncome = false, -- if true, tick every 1s (Studio only)
	-- Studio-only: treat listed GamePass keys as owned when product Id is still 0
	MockOwnedGamePasses = {
		-- VIP = true,
		-- DoubleCash = true,
		-- DoubleXP = true,
		-- v71 money (M2): keys the premium vehicle / rebirth workflows add to MonetizationConfig.GamePasses (M1).
		-- Uncomment only for a Studio test once those keys exist; live servers ignore this table.
		-- PV_Razorfang = true,
		-- PV_Bastion = true,
		-- PV_Warlord = true,
		-- PV_MotorPool = true, -- bundle: all three ground cars
		-- PV_Stormwing = true, -- M6b
		-- PV_Tidebreaker = true, -- M6b
		-- RebirthBoost = true,
	} :: { [string]: boolean },

	--[[ Studio / laptop PERF (phase-7)
		StudioSkipWorldDressing = true → MapSetup skips MapDressing entirely in Studio
		  (BIGGEST Play Solo win). Override: set Workspace attribute ForceDress=true
		  OR StudioForceDress=true below, then resetmap / delete WarEmpireSetup + Play.
		WorldDressQuality = "Low" when dressing does run (live or ForceDress): ~60–70% fewer clusters.
		StudioSparseFlora = true → drastic DesertFlora cut in Studio.
		MountainRingSegments = 14 (12–16 band); live can raise later.
	]]
	StudioSkipWorldDressing = true,
	StudioForceDress = false,
	WorldDressQuality = "Low", -- "Low" | "Full"
	StudioSparseFlora = true,
	MountainRingSegments = 14,
}

return DevConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Economy tuning. See BALANCE.md for design intent.
	First ~10 minutes feel fast; progression slows after.
]]

local EconomyConfig = {
	StartingCash = 10000, -- v55 restore: healthy start (v20 era used 5000; DS v2 fresh profiles get this)
	StartingGold = 0,
	MinCash = 0,
	MinGold = 0,
	MaxCash = 1_000_000_000,
	MaxGold = 10_000_000,

	-- Passive income: base + sum(structureLevel * rate)
	-- Early-game pacing (first 10 min): start $10k → CC L1 ($1500) immediately →
	-- base $25/tick (~$300/min) + CC $15 → Barracks L1 ($2500) in ~1 min →
	-- then ~$60/tick sustains VehicleDepot / WeaponsFacility without feeling stuck.
	PassiveIncome = {
		TickSeconds = 5,
		BaseCashPerTick = 25, -- alone: ~300/min → Barracks L1 (2500) in ~50s with upgrades help
		-- Per structure level contribution to Cash/tick
		PerLevelRates = {
			CommandCenter = 15,
			Barracks = 20,
			VehicleDepot = 12,
			WeaponsFacility = 10,
			Helipad = 18,
			Dock = 14,
			Airfield = 22,
			DefensiveWalls = 5,
			Watchtowers = 6,
			Radar = 8,
			ResearchLab = 14,
			MissileDefense = 7,
			PowerStation = 16,
			Warehouse = 25,
			SpecialForcesFacility = 20,
		} :: { [string]: number },
	},

	-- Soft caps / multipliers
	PrestigeCashMultiplierPerLevel = 0.10, -- +10% cash gains per prestige (stacking; see PrestigeConfig)
	DailyRewardCashBonus = true,

	-- Capture stipend tuning lives in TerritoryConfig.CaptureStipend
	-- (periodic cash for owned territories / coastal oil).

	-- Contested outpost income: stacks recount from owned territories (stealable).
	OutpostIncomeBuff = {
		MultPerStack = 0.10, -- +10% per stack
		MaxStacks = 5, -- cap +50%
		ToastSecured = "Outpost secured — +%d%% Income (yours)",
		ToastLost = "Outpost lost — Income buff dropped (stolen)",
		ToastStolenFromYou = "%s stolen by enemy — −Income buff",
		ToastStealGain = "Stole %s — +%d%% Income is now yours",
		-- Legacy alias kept for older callers
		ToastTemplate = "Outpost secured — +%d%% Income (yours)",
	},

	-- PvP ATM raid: touch another player's WE_MoneyCollector to steal PendingCash.
	AtmRaid = {
		Enabled = true,
		StealFraction = 0.10, -- 10% of victim PendingCash
		AtmRaidCooldownSeconds = 60, -- per thief→victim pair
		MaxDistanceStuds = 14, -- server distance check to collector part
		MinStealCash = 1,
		ToastThief = "ATM RAID +$%d (10%%) from %s — 1m cooldown",
		ToastVictim = "ATM RAIDED −10%% by %s (−$%d)",
		ToastCooldown = "ATM raid cooldown — %ds left",
	},
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ WAR EMPIRE — Core game settings ]]

local GameConfig = {
	DisplayName = "WAR EMPIRE",
	Tagline = "BUILD. CONQUER. DOMINATE.",
	MaxPlayersPerServer = 12,
	BasePlotCount = 6,
	RespawnTimeSeconds = 5,
	FriendlyFire = false,
	PvPEnabled = true,
	TutorialEnabled = true,
	DefaultWalkSpeed = 16,
	DefaultJumpPower = 50,
	SpawnInvulnerabilitySeconds = 3,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">GateDefenseConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Gate door defense — Design Bot GATE_DEFENSE_WIRE.
	Tied to DefensiveWalls level. Recreated on join from walls level (no exotic persist).

	Design silhouette:
	  Walls L1–L3 = Design L0 (2 Guards patrol ±6)
	  Walls L4–L5 = Design L1 (Machine Gun Nest AutoGuns + keep Guards manned nest)
	  Design L2 elevated tower IDs are NOT used on door flanks.
]]

export type LevelStats = {
	GuardHealth: number,
	GuardDamage: number,
	GuardFireRate: number,
	GuardWalkSpeed: number,
	AggroRange: number,
	ShootRange: number,
	UseTurrets: boolean,
	TurretDamage: number,
	TurretFireRate: number,
	TurretRange: number,
	WeaponLabel: string,
	DesignTier: string, -- "L0" | "L1"
}

local GateDefenseConfig = {
	Enabled = true,
	MinWallsLevel = 1,
	GuardsPerGate = 2,
	VisualKind = "GateGuard", -- Characters.GateGuard / Guard → 16134469614

	-- Design Bot placement (gate local space)
	GuardFlankX = 6,
	GuardForwardZ = 2,
	PatrolHalfSpanStuds = 6, -- ±6 along gate line
	AutoGunFlankX = 7,
	AutoGunForwardZ = 1,
	AutoGunYawDeg = 15,

	-- Catalog ScaleTo longest-axis targets (studs)
	AutoGunLongAxisStuds = 5.5, -- 4–6
	SandbagNestDiameterStuds = 8,

	-- Walls level when AutoGuns appear (Design L1)
	AutoGunMinWallsLevel = 4,

	-- Combat — cover gate → MoneyCollector ATM approach (plot ~200 pad)
	DefaultAggroRange = 95,
	ProtectCollectorRadius = 42,
	RequireLineOfSight = true,
	LosMaxDistance = 110,
	DamageCooldownGlobal = 0.08,
	GuardRespawnSeconds = 12,
	PatrolIdleSeconds = 1.4,

	Levels = {
		[1] = {
			GuardHealth = 140,
			GuardDamage = 14,
			GuardFireRate = 1.4,
			GuardWalkSpeed = 11,
			AggroRange = 95,
			ShootRange = 70,
			UseTurrets = false,
			TurretDamage = 0,
			TurretFireRate = 0,
			TurretRange = 0,
			WeaponLabel = "Rifle",
			DesignTier = "L0",
		},
		[2] = {
			GuardHealth = 190,
			GuardDamage = 18,
			GuardFireRate = 2.0,
			GuardWalkSpeed = 12,
			AggroRange = 100,
			ShootRange = 75,
			UseTurrets = false,
			TurretDamage = 0,
			TurretFireRate = 0,
			TurretRange = 0,
			WeaponLabel = "Rifle+",
			DesignTier = "L0",
		},
		[3] = {
			GuardHealth = 230,
			GuardDamage = 16,
			GuardFireRate = 4.0,
			GuardWalkSpeed = 13,
			AggroRange = 105,
			ShootRange = 68,
			UseTurrets = false,
			TurretDamage = 0,
			TurretFireRate = 0,
			TurretRange = 0,
			WeaponLabel = "SMG",
			DesignTier = "L0",
		},
		[4] = {
			GuardHealth = 260,
			GuardDamage = 18,
			GuardFireRate = 4.5,
			GuardWalkSpeed = 13,
			AggroRange = 110,
			ShootRange = 72,
			UseTurrets = true,
			TurretDamage = 22,
			TurretFireRate = 6.0,
			TurretRange = 100,
			WeaponLabel = "SMG+HMG",
			DesignTier = "L1",
		},
		[5] = {
			GuardHealth = 300,
			GuardDamage = 20,
			GuardFireRate = 5.0,
			GuardWalkSpeed = 14,
			AggroRange = 120,
			ShootRange = 78,
			UseTurrets = true,
			TurretDamage = 28,
			TurretFireRate = 8.0,
			TurretRange = 115,
			WeaponLabel = "AutoGuns",
			DesignTier = "L1",
		},
	} :: { [number]: LevelStats },

	-- Siegeable gate barrier (HP). Spawned by GateDefenseService — does not edit StructureKitBuilder ScaleTo.
	GateMaxHealthByWallsLevel = {
		[1] = 800,
		[2] = 1200,
		[3] = 1800,
		[4] = 2600,
		[5] = 3600,
	},
	GateRegenPerSecond = 1.5, -- slow regen while intact / after rebuild
	GateRebuildSeconds = 50,
	GateRepairCashCost = 750, -- owner Collect repair while breached
	GateBreachToast = "⚠ BREACHED — gate open! Repair or wait rebuild",
	GateRepairedToast = "Gate repaired",
	-- v71 (HUD v70 spec §4.2): one owner Warn when the base is fought over — the defenses hit an enemy, or an enemy
	-- hits the gate / a guard — at most once per BaseUnderAttackCooldown per plot. The client shows it in the Alert
	-- slot (HudConfig.Toast.Reroute "^BASE UNDER ATTACK"). Was a per-hit "DEF HIT · name (−HP)" toast every 1.2 s.
	BaseUnderAttackToast = "BASE UNDER ATTACK!",
	BaseUnderAttackCooldown = 60,
	-- gate HP bar (one stud-scaled bar centred over the gate; shown only while damaged, breached, down or raided)
	GateBar = { Studs = Vector2.new(6, 1.1), MaxDistance = 40, HeightAbove = 1.2 },
	GateBarrierThickness = 1.6,
	GateBarrierHeight = 9,
	GateClearStuds = 10, -- match StructureKitBuilder GATE_CLEAR
	GateDamageTag = "WE_GateBarrier",
	GateDamageToolAttribute = "WE_Weapon", -- tool/tag validation
	AllowTroopGateDamage = true,

}

function GateDefenseConfig.GetLevelStats(wallsLevel: number): LevelStats?
	local lv = math.clamp(math.floor(wallsLevel), 0, 5)
	if lv < (GateDefenseConfig.MinWallsLevel or 1) then
		return nil
	end
	return GateDefenseConfig.Levels[lv] or GateDefenseConfig.Levels[5]
end

return GateDefenseConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">HudConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HudConfig — v70 "clean screen" HUD (competitor-style left rail, bottom-left cash pill, top-centre text
	toasts, bottom-centre weapon hotbar). Config-first: every HUD element reads its placement, size, colour and
	visibility rule from this file. Nothing in a controller may hard-code a HUD offset again.
	Spec: the v70 "clean screen" design hand-off (spec + mock_*.png). Runtime API: Client/Modules/HudLayout.luau
	(scale, insets, flags, top stack, panel registry, badges, cash float, reserved rects) and HudIcons.luau.

	OWNER DECISIONS (v70): Settings = TopStrip gear (not a rail tile); no Base tile on the rail; you spawn
	HOLSTERED (Hotbar.DrawnOnSpawn = false, auto-draw on damage); Army popover key Y; Robux offer pop-ups at most
	Offer.MaxPerSession per session and Offer.MinGapSeconds apart.
	MOBILE MERGE GATE (mobile_plan §1C): text floor 14 real px (Scale.MinTextPx; 20 v on phones), Skip / offer ✕
	hits 64 v, the cash "+" lives on the TopStrip (TopStrip.CashPlus), not in the thumbstick zone, and key hints
	show only when HudLayout.PrefersKeys() (UserInputService.PreferredInput is keyboard or gamepad).

	UNITS
	  v     virtual px. Every HUD ScreenGui gets ONE UIScale named "MobileScale" from HudLayout.ApplyScreen():
	        S = clamp(min(viewport.X, viewport.Y) / Scale.BasePx, Scale.Min, Scale.Max)
	          844x390 phone → 0.70   956x440 phone → 0.70   1280x720 → 0.90   1920x1080 → 1.15
	        and ScreenInsets = CoreUISafeInsets (below the Roblox topbar, inside the landscape notch).
	        So 1 v = S real px everywhere, and offsets from different ScreenGuis finally line up.
	  real  device px. Only the TopStrip (it lives in the Roblox topbar row, whose buttons are a fixed 44 px) and
	        BillboardGui world labels (BillboardGui offsets are never UIScaled) use real px.

	ANCHORS
	  "Left/Right/Top/Bottom" = distance in v from that edge of the safe content rect. The content rect on an
	  844x390 phone is x 47..797, y 58..390 (real); on 1280x720 it is x 0..1280, y 58..720.

	NOTHING IN HERE TOUCHES A PURCHASE PATH. Buy buttons keep btn.Activated → the same remotes.
]]

local HudConfig = {}

-- Toast.Reroute entry (see HudConfig.Toast.Reroute)
export type RerouteRule = {
	Match: string,
	Float: boolean?,
	Show: string?,
	Strip: string?,
	Type: string?,
	MinGapSeconds: number?,
	AlertSeconds: number?,
}

HudConfig.Version = 70

---------------------------------------------------------------------------------------------------------------
-- Scale, fonts, palette, z-order
---------------------------------------------------------------------------------------------------------------

HudConfig.Scale = {
	BasePx = 800,
	Min = 0.70, -- 64 v tile → 44.8 real px on every phone (Apple/Roblox 44 px touch minimum)
	Max = 1.15,
	TouchMinPx = 44, -- real px; HudLayout.AssertTouchTarget() warns in Studio when a tappable is smaller
	-- real px floor for any HUD text (CLAUDE.md §1, check_hud's rule): at S 0.70 that is 20 v, so no v text size
	-- below 20 on touch (PanelShell.Text floors panel text to it). Was 11 until the mobile merge gate (§1C #2).
	MinTextPx = 14,
	-- The ONE documented exception (mobile_plan §1C #2): a hotbar weapon caption whose short name cannot fit its
	-- 64 v slot at 20 v may shrink to this (TextScaled). check_hud.py applies the same rule to Hotbar …WeaponName.
	CaptionMinTextPx = 12,
}

-- Roblox built-in fonts only.
HudConfig.Fonts = {
	Display = Enum.Font.FredokaOne, -- rail labels, cash number, toasts, level, ammo count, console labels
	Body = Enum.Font.GothamBold, -- small captions, prompt text, slot names
	BodyMedium = Enum.Font.GothamMedium,
}

HudConfig.Colors = {
	Ink = Color3.fromRGB(10, 12, 14), -- every outlined text uses this stroke
	White = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 196, 204),
	PillBg = Color3.fromRGB(22, 24, 28), -- cash pill, hotbar slots, prompt pills, top-strip chips
	PillBgTransparency = 0.2,
	PillStroke = Color3.fromRGB(0, 0, 0),
	PillStrokeTransparency = 0.45,
	Positive = Color3.fromRGB(110, 255, 90), -- success toast, cash gain float, affordable price
	Negative = Color3.fromRGB(255, 72, 72), -- error toast, spend float, unaffordable price
	Warn = Color3.fromRGB(255, 120, 104), -- "need more cash" red-pink (competitor "You need more Money!")
	Gold = Color3.fromRGB(255, 214, 72), -- reward / level-up toast, offer stroke
	Info = Color3.fromRGB(255, 255, 255),
	XP = Color3.fromRGB(90, 170, 255),
	PlusGreen = Color3.fromRGB(46, 204, 64),
	PlusGreenStroke = Color3.fromRGB(12, 70, 22),
	Badge = Color3.fromRGB(235, 40, 52),
	Locked = Color3.fromRGB(170, 176, 184),
}

-- One z-order for the whole client. Names are the existing ScreenGui names (BuyPathVerify looks them up).
HudConfig.DisplayOrder = {
	WE_Reticle = 24, -- NEW gui: crosshair at the true viewport centre (IgnoreGuiInset = true)
	WarEmpireCompass = 20, -- kept only as a shell; the compass chip moves to WE_TopStrip
	WarEmpireCombatHUD = 25, -- hotbar, health bar, ammo, touch FIRE/R
	WarEmpireTerritory = 28, -- capture bar (top-centre stack)
	WarEmpireBankRaid = 32, -- bank + ATM raid hold bars (top-centre stack)
	WarEmpireTutorial = 50, -- objective chip (top-centre stack)
	WarEmpireOrders = 52, -- Army popover (orders)
	WarEmpireHUD = 55, -- rail + cash pill (BuyPathStatic pins "DisplayOrder = 55")
	WE_TopStrip = 56, -- NEW gui: level chip, settings gear, shield chip, compass (Roblox topbar row)
	WarEmpireVehicleHUD = 56, -- VehicleDriveClient (v70): SPD pill + hint + ▲▼ column (inside Reserve.CombatTouch)
	WE_PromptLane = 57, -- NEW gui: custom ProximityPrompt pills (action lane)
	WarEmpireBaseUI = 58,
	Panels = 60, -- Shop / Army / Missions / Settings / Garage / Progression / Research / Missiles
	WE_PadBuyGui = 65, -- console BUY button (action lane); hidden while any panel is open
	WE_MissileAlert = 66, -- INCOMING MISSILE (top-centre stack, slot "Alert")
	WarEmpireNotifications = 70, -- toast lane + offer toast
}

HudConfig.Edge = 12 -- v; default gap from the safe content rect's edges

---------------------------------------------------------------------------------------------------------------
-- TOP STRIP — the Roblox topbar row (ScreenGui "WE_TopStrip", ScreenInsets = TopbarSafeInsets, NO UIScale).
-- Left group sits right after Roblox's buttons (GuiService.TopbarInset.Min.X); compass is right-aligned.
---------------------------------------------------------------------------------------------------------------

HudConfig.TopStrip = {
	Height = 44, -- real px — same as Roblox's topbar buttons
	YNudge = 0, -- real px; if a device shows our chips off-centre against Roblox's pills, nudge here
	Gap = 8, -- real px between chips
	EdgePad = 12, -- real px after Roblox's buttons / before the right edge
	-- Roblox's own 44 px topbar buttons sit at y 12..56 of the 58 px row (owner screenshot), i.e. 2 px above the
	-- row's bottom: our chips are bottom-aligned the same way (AnchorPoint Y 1, offset -BottomPad + YNudge).
	BottomPad = 2,
	-- Clients without GuiService.TopbarInset / ScreenInsets.TopbarSafeInsets (risk #1): the free part of the
	-- topbar row is assumed to start this many real px right of the safe-left edge (Roblox logo + unibar pill),
	-- i.e. x 255 on an 844x390 phone, 270 on the owner's 956x440, 208 on desktop. HudLayout.TopbarRect().
	FallbackLeft = 208,
	Corner = 22, -- pill
	TextStroke = 1.2, -- real px Colors.Ink outline on the chips' Display-font numbers
	Bg = Color3.fromRGB(18, 20, 24),
	BgTransparency = 0.25, -- visually matches Roblox's own topbar pills
	LeftItems = { "Level", "Settings", "CashPlus", "Shield" }, -- order; Shield only while shielded
	Level = {
		MinWidth = 118,
		CaptionSize = 14, -- "LV" (real px: Scale.MinTextPx)
		NumberSize = 22, -- "7"
		BarSize = Vector2.new(56, 6),
		BarBg = Color3.fromRGB(255, 255, 255),
		BarBgTransparency = 0.8,
		PulseColor = Color3.fromRGB(255, 214, 72), -- level-up: stroke flash + UIScale 1 → 1.15 → 1 (0.45 s)
		PulseSeconds = 1.2,
		TapShowsGoalSeconds = 3.5, -- tap/hover: GoalLabel tooltip under the chip (goal + rebirth summary)
		TipGap = 6, -- real px between the topbar row and the tooltip card
		TipMaxWidth = 340,
		TipGoalSize = 15, -- GothamBold, white (real px, ≥ Scale.MinTextPx)
		TipRebirthSize = 14, -- GothamMedium, gold
		PopScale = 1.15, -- level-up chip pop (UIScale 1 → 1.15 → 1 over PopSeconds)
		PopSeconds = 0.45,
	},
	Settings = { Size = 44, IconColor = Color3.fromRGB(52, 156, 255) }, -- gear; opens SettingsController
	-- Buy-cash chip (mobile merge gate #6, T17): the green "+" that used to sit on the cash pill's right end — right
	-- where a resting left thumb lands (thumbstick zone), so a stray touch opened the Shop, a Modal that hides FIRE.
	-- Now a 44 px real chip in the Roblox topbar row: cash-bills icon + green "+" disc. Opens CashPill.PlusOpens.
	CashPlus = {
		Height = 44, -- real px (the chip IS the tap target)
		IconSize = Vector2.new(30, 23), -- HudIcons "Cash" (42:32 box)
		PlusSize = 30, -- green disc
		PlusStrokePx = 2,
		PadLeft = 10,
		PadRight = 7,
		Gap = 6,
	},
	Shield = { -- raids: victim shield after being robbed (player attribute WE_ShieldUntil, os.time())
		Attribute = "WE_ShieldUntil",
		IconColor = Color3.fromRGB(80, 210, 255),
		IconSize = 24,
		TextSize = 18, -- "9:12"
	},
	Compass = {
		MinWidth = 112,
		ArrowSize = 22, -- chevron built from 2 Frames, Rotation = bearing relative to the camera
		ArrowBox = 24, -- faint round backing behind the arrow
		ArrowColor = Color3.fromRGB(255, 214, 72),
		LabelSize = 14, -- "BASE" (real px, ≥ Scale.MinTextPx)
		DistanceSize = 18, -- "95m" (Display font)
		TickSeconds = 0.25,
		HideInsideOwnPlot = true, -- inside your own walls you need no arrow home
		OwnPlotMarginStuds = 12,
		RadarDot = Color3.fromRGB(190, 110, 255), -- 8 px pulsing dot at the chip's left while RadarReveal is on
		TapOpensTerritories = true, -- tap → TerritoryController dropdown under the chip (the old list)
	},
}

---------------------------------------------------------------------------------------------------------------
-- LEFT RAIL — 5 square tiles, vertically centred between the top of the content rect and the cash pill.
-- Settings is NOT a rail tile: 5 tiles at 64 v fit an 844x390 phone (332 px of content); 6 need 353 px.
-- If a screen is too short even for 5 (e.g. 800x360), the grid wraps to a 2nd column (FillDirectionMaxCells).
---------------------------------------------------------------------------------------------------------------

HudConfig.Rail = {
	Tile = 64, -- v, touch   (44.8 real on phones)
	TileDesktop = 76, -- v   (68 real at 720p, 87 at 1080p)
	Gap = 5,
	GapDesktop = 8, -- dock≤8 (BuyPathStatic pins the phrase in HUDController)
	ColumnGap = 10, -- v added to Gap between columns when a short screen wraps the rail (e.g. 800x360 → 4 + 1)
	LabelOverhang = 6, -- v the label hangs below the tile edge (included in the hit area)
	LabelOverhangDesktop = 8,
	LabelSize = 20, -- v: 14.0 real px at S 0.70 (Scale.MinTextPx); "Missions" is ~88 v, the label box is Tile + 32
	LabelSizeDesktop = 20,
	LabelStroke = 2, -- real px, Colors.Ink
	Corner = 12,
	StrokePx = 3,
	IconScale = 0.6, -- icon box = 60 % of the tile, centred in the top 78 %
	Left = 12, -- v from the safe left edge
	CenterY = 0.55, -- centre of the rail within its band (competitor sits a little below mid-screen)
	TopReserve = 12, -- v band top
	PressScale = 0.92,
	KeyHintDelay = 0.6, -- desktop: hovering a tile shows "Shop [P]" after this many seconds (keys: HudConfig.Keys)
	KeyHintSize = 16,
	NearPrestigePulse = 1.12, -- ShowNearPrestigeBanner: the Rebirth tile pulses once per level in the near band
	Tiles = {
		-- Name = the MobileActionBar child name (kept: "DockMissions" etc. are pinned by BuyPathStatic)
		{ Id = "Shop", Name = "DockShop", Label = "Shop", Icon = "Cart", Accent = Color3.fromRGB(255, 64, 88), Fill = Color3.fromRGB(70, 16, 26), Key = Enum.KeyCode.P },
		{ Id = "Rebirth", Name = "DockRebirth", Label = "Rebirth", Icon = "Cycle", Accent = Color3.fromRGB(196, 80, 255), Fill = Color3.fromRGB(50, 18, 74), Key = Enum.KeyCode.K },
		{ Id = "Army", Name = "DockArmy", Label = "Army", Icon = "Helmet", Accent = Color3.fromRGB(72, 220, 96), Fill = Color3.fromRGB(16, 58, 28), Key = Enum.KeyCode.Y },
		{ Id = "Garage", Name = "DockGarage", Label = "Garage", Icon = "Car", Accent = Color3.fromRGB(40, 212, 200), Fill = Color3.fromRGB(8, 52, 56), Key = Enum.KeyCode.G },
		{ Id = "Missions", Name = "DockMissions", Label = "Missions", Icon = "Clipboard", Accent = Color3.fromRGB(255, 150, 32), Fill = Color3.fromRGB(80, 42, 6), Key = Enum.KeyCode.M },
	},
	Badge = {
		Size = 26, -- v circle at the tile's top-right corner (AnchorPoint 0.5,0.5 at (1,-Inset.X,0,Inset.Y))
		-- centre 9 v below the tile top, so the (bigger, 20 v) badge barely reaches the label of the tile above
		Inset = Vector2.new(4, 9),
		TextSize = 20, -- 14 real px on phones (Scale.MinTextPx)
		Bg = Color3.fromRGB(235, 40, 52),
		ReadyBg = Color3.fromRGB(255, 214, 72), -- "!" on Rebirth uses gold with dark text
		ReadyText = Color3.fromRGB(30, 22, 4),
		PulseWhenNew = true, -- UIScale 1 → 1.2 → 1 once when a badge appears
	},
	-- What drives each badge (HUDController.SetRailBadge). nil = no badge.
	BadgeSources = {
		Shop = "OfferPending", -- "!" while an offer toast was deferred/dismissed unseen (clears on Shop open)
		Rebirth = "PrestigeReady", -- "!" at level >= PrestigeConfig.MinLevelToPrestige
		Army = nil, -- the count lives in the Army popover header, not on the HUD
		Garage = "NewVehicle", -- "!" when a vehicle was bought/unlocked and not spawned yet (clears on Garage open)
		Missions = "Claimables", -- count = completed-unclaimed missions + claimable daily login + (spinner READY ? 1 : 0)
	},
	HideWhen = { "Driving", "Dead" },
}

---------------------------------------------------------------------------------------------------------------
-- CASH PILL — the only always-on number. Bottom-left, under the rail.
---------------------------------------------------------------------------------------------------------------

HudConfig.CashPill = {
	Left = 12,
	Bottom = 12,
	Height = 56, -- v touch (39 real); the + hit area is taller (PlusHit)
	HeightDesktop = 52,
	MinWidth = 150, -- the + moved to the TopStrip (TopStrip.CashPlus): the pill is icon + number only
	MaxWidth = 380,
	Corner = 14,
	StrokePx = 2,
	PadLeft = 10,
	PadRight = 6,
	Gap = 8,
	IconSize = Vector2.new(42, 32), -- HudIcons "Cash": 3 stacked green bills
	NumberSize = 34,
	NumberSizeDesktop = 32,
	NumberColor = Color3.fromRGB(255, 255, 255),
	ShowDollarSign = false, -- the icon says "cash"; prices elsewhere keep "$"
	AbbreviateAbove = 1e9, -- 1,234,567,890 → "1.23B"
	CountUpSeconds = 0.35,
	PopScale = 1.08, -- the number pops once per change
	FlashSeconds = 0.5, -- gain/spend colour (CashFloat.GainColor / SpendColor) settles back to NumberColor
	NumberPadRight = 4,
	-- The green "+" is NOT on the pill any more (mobile merge gate #6): it is the TopStrip.CashPlus chip. The pill
	-- keeps an empty PlusSlot (PlusSlotWidth v) at its right end as the cash float's anchor.
	PlusOnPill = false,
	PlusSlotWidth = 0,
	PlusStrokePx = 2.5,
	PlusVisual = 44, -- v: the float anchor's height (the old green circle's size)
	PlusHit = 64, -- v transparent hit area (≥ 44 real on phones) — only when PlusOnPill = true
	PlusOpens = "ShopCashPacks", -- ShopController.OpenCashPacks() — no toast
	HideWhen = { "Dead" },
}

-- "+$141" that rises from the pill and fades. Replaces every "Collected $N" centre toast.
HudConfig.CashFloat = {
	TextSize = 26,
	StrokePx = 1.6,
	Rise = 40, -- v
	Seconds = 0.9,
	MergeWindow = 0.6, -- gains within this window add into the same float ("+$141" → "+$810")
	GainColor = Color3.fromRGB(120, 255, 120),
	SpendColor = Color3.fromRGB(255, 96, 96),
	ShowSpend = true, -- "-$5,000" on purchases
	-- spend floats come from cash DROPS seen while a panel is open or within this many seconds of the console
	-- BUY button being on screen (other drops — e.g. a raid — get their float from the notification that explains them)
	SpendContextSeconds = 3,
	-- Floats come ONLY from Notification type "Collect" (server manual collects, kill/raid money): passive and
	-- AutoCollect income just counts the number up silently. That is the owner's "don't notify every 2 s" rule.
	Source = "CollectNotifications",
	MaxPerSecond = 2,
}

---------------------------------------------------------------------------------------------------------------
-- TOP-CENTRE STACK — one column under the topbar. Items stack in this order, each collapses when hidden:
--   Alert (INCOMING MISSILE, base under attack) → Progress (capture / bank / ATM raid hold) →
--   Objective (tutorial step) → Toasts (2 lines max) → Offer (one purchasable offer toast)
-- HudLayout.RegisterTopStack(name, guiObject, order) positions them; no gui hard-codes a Y again.
---------------------------------------------------------------------------------------------------------------

HudConfig.TopStack = {
	Top = 8, -- v below the content top (= below the topbar)
	Gap = 6,
	MaxWidthScale = 0.62, -- of content width; nothing in the stack is wider
	Order = { Alert = 10, Progress = 20, Objective = 30, Toasts = 40, Offer = 50 },
	-- text ≥ 20 v (14 real px on phones, Scale.MinTextPx): title row 4..28 v, bar 29..37 v in the 44 v pill (kept 44:
	-- VehicleDriveClient's SPD pill sits right under a 44 v Progress pill at the top of the stack)
	Progress = { Size = Vector2.new(360, 44), BarH = 8, TextSize = 20, ContestedColor = Color3.fromRGB(255, 176, 48) },
	-- Height 72: title (22 v) + two 20 v hint lines; SkipHit 64 v = 44.8 real px (merge gate #3; 44 v was 30.8 px)
	Objective = { MaxWidth = 460, Height = 72, TitleSize = 20, HintSize = 20, GoHit = 64, SkipHit = 64 },
}

HudConfig.Toast = {
	MaxVisible = 2, -- newest at the bottom; a 3rd removes the oldest
	TextSize = 26, -- v touch (18 real)
	TextSizeDesktop = 30, -- v (27 real at 720p, 34 at 1080p)
	StrokePx = 2.5,
	LineGap = 2,
	FadeIn = 0.12,
	FadeOut = 0.25,
	PopFrom = 0.7, -- UIScale pop on appear (Back ease, 0.14 s)
	CoalesceWindow = 3, -- same key again within 3 s → one line "Text ×2", timer restarts
	CoalesceKey = "StripDigits", -- "Not enough cash — need $500"/"… $700" coalesce
	SoundMinGap = 0.4,
	Types = {
		Success = { Color = Color3.fromRGB(110, 255, 90), Hold = 1.8, Sound = true },
		Error = { Color = Color3.fromRGB(255, 72, 72), Hold = 2.4, Sound = true },
		Warn = { Color = Color3.fromRGB(255, 120, 104), Hold = 2.2, Sound = true },
		Reward = { Color = Color3.fromRGB(255, 214, 72), Hold = 2.4, Sound = true },
		Info = { Color = Color3.fromRGB(255, 255, 255), Hold = 2.0, Sound = false },
		Collect = { Route = "CashFloat" }, -- never a lane line; amount = payload.Amount or first "$n" in Message
	},
	-- TODAY'S server lines, re-routed on the client (the §4.2 server fixes are deferred; they will send type
	-- "Collect" + Amount / one "BASE UNDER ATTACK" themselves later — these rules then simply stop matching).
	-- Checked in order BEFORE Drop; first match wins. Fields:
	--   Match   Lua pattern on Message
	--   Float   true → "+$N" cash float from the first "$n" in Message (commas allowed); no lane line unless Show
	--   Show    replacement lane text ("" or nil with Float = float only); "%STRIP%" = Message minus Strip
	--   Strip   pattern removed from Message when Show == "%STRIP%"
	--   Type    lane type for Show (default: the payload's own Type)
	--   MinGapSeconds  show at most once per this many seconds (per rule)
	--   AlertSeconds   also light the TopStack "Alert" slot for this long (NotificationController owns it)
	Reroute = ({
		{ Match = "^Collected %$", Float = true }, -- MoneyCollectorService manual/spatial collect (type Collect)
		{ Match = " down %(%+%$[%d,]+%)$", Float = true }, -- NPC kill "<NPC> down (+$N)" (Reward today)
		{ Match = "^Eliminated .+ %(%+%$[%d,]+%)$", Float = true, Show = "%STRIP%", Strip = " %(%+%$[%d,]+%)$", Type = "Success" }, -- PvP kill: "Eliminated X" + float
		{ Match = "^DEF HIT", Show = "BASE UNDER ATTACK!", Type = "Warn", MinGapSeconds = 60, AlertSeconds = 4 }, -- every 1.2 s today
		-- v71 server shape (GateDefenseService, once per plot per 60 s): the same Alert-slot banner, no lane line
		{ Match = "^BASE UNDER ATTACK", Show = "BASE UNDER ATTACK!", Type = "Warn", MinGapSeconds = 60, AlertSeconds = 4 },
	} :: { RerouteRule }),
	-- Client safety net for server/client noise that has no business on screen. Lua patterns on Message.
	-- (The real fix is at the source — see spec §World/Server noise — this only stops regressions.)
	Drop = {
		" opened$", -- UIController dockPress (removed)
		"^Squad: ", -- order echo; the Army popover shows the active order
		"^Capture stipend", -- recurring every 90 s; the cash counts up silently
		"^DEF HIT", -- every 1.2 s during a gate fight; Reroute turns it into one "BASE UNDER ATTACK!" per 60 s
		"^Buying .+…$", -- the BUY button already reads BUYING…
		"^Capturing .+%.%.%.$", -- TerritoryService per-trigger echo; the capture bar shows it
		"Walk to glowing pads", -- stale v67 first-join hints
		"Prices float above pads",
		"Only one weapon owned", -- the hotbar shows what you own
		-- upsell companions: the offer toast (ShowOffer) carries the offer; the extra Info line goes
		"^Tired of walking to the ATM%?",
		"^Big collect! Double your cash",
		"Starter Bundle available",
		"^Commander status unlocked",
		"Speed Boost available$",
		"BEST OFFER — Cash Mega pack ready",
		"^Boost%? .+ tap toast$",
	},
	-- One failed purchase = one line (today it is 3: WE_BuyAck + PurchaseResult + server Warn)
	DedupePurchaseFailure = true,
}

HudConfig.Offer = { -- Robux soft offers (7 ShopController cards) become ONE offer toast in the stack
	Height = 56, -- v touch
	HeightDesktop = 48,
	MaxWidth = 460,
	Stroke = Color3.fromRGB(255, 214, 72),
	Bg = Color3.fromRGB(26, 22, 8),
	BgTransparency = 0.12,
	TitleSize = 20,
	SubSize = 20, -- 14 real px on phones (Scale.MinTextPx)
	CtaSize = 20, -- "GET R$ 99"
	CloseTextSize = 22, -- the ✕ glyph
	GetHit = 64, -- green GET button
	CloseHit = 64, -- v: 44.8 real px on phones (merge gate #3; 44 v was 30.8 px)
	HoldSeconds = 9,
	-- Owner decision (money plan D8): at most 3 offer pop-ups per session, at least 4 minutes apart.
	-- The server Offer Director (money workflow) may be stricter; this client throttle is the floor.
	MaxPerSession = 3, -- shown offers (dropped/deferred-then-dropped ones do not count)
	MinGapSeconds = 240, -- at most one offer every 4 minutes
	FirstAfterJoinSeconds = 90,
	DeathOfferMinGapSeconds = 600, -- the PvP death offer: at most once per 10 minutes (still counts toward MaxPerSession)
	DeferWhen = { "Drawn", "RecentCombat", "Driving", "Modal", "Tutorial" }, -- queued, dropped after 60 s
	DropAfterQueuedSeconds = 60,
	ShopBadgeWhenDropped = true,
}

