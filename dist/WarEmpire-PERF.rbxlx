		CFrame = cf * CFrame.new(0, 7.3, 0),
		Color = COL.AdobeDark,
		Material = Enum.Material.Sandstone,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	p({
		Name = "AdobeDoor",
		Size = Vector3.new(2.2, 3.4, 0.35),
		CFrame = cf * CFrame.new(0, 1.8, -4.55),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, ox in ipairs({ -3.5, 3.5 }) do
		p({
