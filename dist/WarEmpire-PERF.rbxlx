	Rigs = {
		{
			Id = "CoastalOilAlpha",
			DisplayName = "Coastal Oil Alpha",
			Position = Vector3.new(1800, 1, -750),
			Color = Color3.fromRGB(190, 145, 45),
		},
		{
			Id = "CoastalOilBravo",
