        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">WaterConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v70 waterways: every WE_Water surface on the map. One source of truth for MapSetup (plot water, sea gates, naval
	pads, road ends, rig piers), Modules/Waterways (public water + banks, sea-gate proximity loop, dressing cull),
	MapDressing / DesertFlora (keep props out of the water), TerritoryCapture (naval outposts) and the vehicles drive
	(reads the tagged parts, not this file).

	Units: world studs. +Y up. Ground top 0.5, plot pad top 1.0.
	Public rects are axis-aligned XZ boxes { X0 < X1, Z0 < Z1 }. The water parts TILE the network: neighbours share an
	edge and never overlap (coplanar transparent top faces z-fight). Every water part's TOP face is at SurfaceY; boats read
	the top face as the water level (Constants.Tags.Water contract).

	Plot water (DockWater, SeaGateWater) is plot-local (BaseLayoutConfig frame: +Z = plot front / main gate, -Z = rear)
	and is built TURNED WITH THE PLOT: CFrame = BaseLayout.PlotLocalCFrame(pos, x, y, z) (exact quarter turn), size in
	plot-local terms. Its world AABB is still axis-aligned and tiles with the channel. Turning it gives the vehicles'
	basin spawn (yawOf(DockWater.CFrame)) a bow that points at the sea gate on every plot.
	Only DockWater carries WE_PlotId (the vehicles' plotBasin picks the first WE_Water with WE_PlotId == plotId);
	SeaGateWater carries WE_GatePlotId instead.
]]

export type Rect = { Name: string, X0: number, X1: number, Z0: number, Z1: number, Bank: number? }
export type Channel = { PlotId: number, Until: number } -- from the plot's sea gate straight out (plot rear) to world coord Until
export type NavalOutpost = { Presence: string, DeckMinY: number?, Water: { string } }
export type NavalPad = { Name: string, X: number, Z: number }
export type RoadEnd = { Min: number, Max: number }
export type GateLeaf = { Name: string, Bottom: number, Height: number, Thickness: number, Transparency: number? }

local WaterConfig = {
	Enabled = true,

	-- Water level. Every WE_Water part spans BottomY..SurfaceY (the bottom face is hidden in the ground / plot pad).
	-- 1.5 = 1.0 above the desert floor and 0.5 above plot pads, so a boat hull (draft 0.15) clears the submerged pad
	-- edge where a channel meets a dock.
	SurfaceY = 1.5,
	BottomY = 0.3,

	Look = {
		Color = Color3.fromRGB(46, 112, 140),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		Reflectance = 0.1,
	},
	-- Sand bank: one slab per public water rect, the rect grown by Bank (default BankWidth) on every side, top at
	-- BankTop + i * 0.004 (i = rect index, so overlapping banks never z-fight). Non-collide, CanQuery off.
	BankWidth = 6,
	SeaBankWidth = 24,
	BankTop = 0.58,
	BankColor = Color3.fromRGB(226, 205, 160),
	BankMaterial = Enum.Material.Sand,

	-- Public water (no plot attribute). Order matters only for the bank height offset.
	Public = {
		-- Sea band (south). Was one WaterPlane x +-3240 z 1490..2210 at top 0.7; notched around Fort Sandhold's south
		-- wall (z 1521..1527), which used to stand in the sea. Every piece <= 2000 studs per axis (BasePart size cap
		-- 2048 incl. the bank). Sea_E1 is the largest part = "the sea" for the vehicles' _IsConnectedToSea.
		{ Name = "Sea_W", X0 = -3240, X1 = -1530, Z0 = 1490, Z1 = 2210, Bank = 24 },
		{ Name = "Sea_FortNotch", X0 = -1530, X1 = -1370, Z0 = 1530, Z1 = 2210, Bank = 24 },
		{ Name = "Sea_E1", X0 = -1370, X1 = 600, Z0 = 1490, Z1 = 2210, Bank = 24 },
		{ Name = "Sea_E2", X0 = 600, X1 = 2400, Z0 = 1490, Z1 = 2210, Bank = 24 },
		{ Name = "Sea_E3", X0 = 2400, X1 = 3240, Z0 = 1490, Z1 = 2210, Bank = 24 },
		-- Ring canal: 80 wide, centre lines x = +-1800 and z = -1800, joined to the sea. Oil-rig lagoons 180 x 180
		-- (half 90 > the 67.9 effective capture radius, so everything in range of a rig is water, deck or pier).
		{ Name = "Ring_NW", X0 = -1840, X1 = 0, Z0 = -1840, Z1 = -1760 },
		{ Name = "Ring_NE", X0 = 0, X1 = 1840, Z0 = -1840, Z1 = -1760 },
		{ Name = "Ring_E1", X0 = 1760, X1 = 1840, Z0 = -1760, Z1 = -840 },
		{ Name = "Lagoon_Alpha", X0 = 1710, X1 = 1890, Z0 = -840, Z1 = -660 },
		{ Name = "Ring_E2", X0 = 1760, X1 = 1840, Z0 = -660, Z1 = 400 },
		{ Name = "Ring_E3", X0 = 1760, X1 = 1840, Z0 = 400, Z1 = 1490 },
		{ Name = "Ring_W1", X0 = -1840, X1 = -1760, Z0 = -1760, Z1 = -400 },
		{ Name = "Ring_W2", X0 = -1840, X1 = -1760, Z0 = -400, Z1 = 660 },
		{ Name = "Lagoon_Bravo", X0 = -1890, X1 = -1710, Z0 = 660, Z1 = 840 },
		{ Name = "Ring_W3", X0 = -1840, X1 = -1760, Z0 = 840, Z1 = 1490 },
		-- South Docks: harbour on the sea + two slips either side of the marker (the marker stands on the mole).
		{ Name = "Harbour_SouthDocks", X0 = -240, X1 = 240, Z0 = 1364, Z1 = 1490 },
		{ Name = "Slip_SouthDocks_W", X0 = -108, X1 = -64, Z0 = 1240, Z1 = 1364 },
		{ Name = "Slip_SouthDocks_E", X0 = 64, X1 = 108, Z0 = 1240, Z1 = 1364 },
	} :: { Rect },

	-- Dock channels: public water from each plot's sea gate (pad edge) straight out of the plot's rear to world
	-- coordinate Until (x for plots facing +-X, z for plots facing +-Z). Only built when BaseLayout.FacesMapCentre().
	-- At PlotSize 320 they resolve to (x0, x1, z0, z1):
	--   P1 (-1760, -960, -548, -508)  P2 (-1760, -960, 252, 292)   P3 (108, 148, -1760, -960)
	--   P4 (-148, -108, 960, 1364)    P5 (960, 1760, -292, -252)   P6 (960, 1760, 508, 548)
	ChannelWidth = 40, -- = SeaGate.X1 - SeaGate.X0
	Channels = {
		{ PlotId = 1, Until = -1760 }, -- west into Ring_W1
		{ PlotId = 2, Until = -1760 }, -- west into Ring_W2
		{ PlotId = 3, Until = -1760 }, -- north into Ring_NE
		{ PlotId = 4, Until = 1364 }, -- south into Harbour_SouthDocks
		{ PlotId = 5, Until = 1760 }, -- east into Ring_E2
		{ PlotId = 6, Until = 1760 }, -- east into Ring_E3
	} :: { Channel },

	-- Sea gate (plot-local, BaseLayoutConfig frame). Built by MapSetup in LayoutGround as folder "SeaGate_Dock" with
	-- GateId = "Dock" and WE_GateMode = "Proximity": StructureKitBuilder.SyncRearGates only ARMS it (Dock L1+) or
	-- closes it; Waterways' sea-gate loop opens an armed gate while a boat driven by the plot owner or an ally is near,
	-- and closes it CloseDelay s after the last one leaves. So the Dock never leaves a walk-in back door in the walls.
	SeaGate = {
		X0 = 108, -- opening = gate water = channel width (inside the corner tower at x 151.5..162.5)
		X1 = 148,
		WallZ = -158.5, -- perimeter wall centre line (StructureKitBuilder halfZ = 160 - 1.5)
		PadEdgeZ = -160,
		BasinRearZ = -147, -- DockBasin rear edge (128, -112, 50 x 70)
		PostWidth = 1.6,
		PostDepth = 3.4,
		PostHeight = 30, -- above pad top
		LintelBottom = 28.9, -- above pad top; lintel is CanCollide = false (a land probe must never see it)
		-- Closed: two collidable leaves across the opening, 12 tall in total (not jumpable from the ground, a kerb or a
		-- pontoon). The low boom's top (y 6.0 = 4.5 above the water) is what a boat land probe starting at SurfaceY + 6
		-- sees (that origin is inside GateLeaf2). Open: both slide WEST (plot-local -X) by their width + 0.3 into the
		-- rear wall line (WE_GateLeaf = -1, the rear-gate slide) and stop colliding. A slide east would hit the corner tower.
		Leaves = {
			{ Name = "GateLeaf1", Bottom = 0, Height = 5, Thickness = 1.2 }, -- yellow/black DiamondPlate boom
			{ Name = "GateLeaf2", Bottom = 5, Height = 7, Thickness = 0.6, Transparency = 0.35 }, -- chain-link screen
		} :: { GateLeaf },
		LeafSlide = -1,
		OpenRadius = 40, -- horizontal studs from the gate centre to an allied boat's chassis (v70: 60 → 40: a boat idling at the basin spawn (46.5 away) no longer holds the gate open for enemies on foot; a returning boat still gets ~40 studs of warning)
		OpenHeight = 20,
		CloseDelay = 2,
		LoopSeconds = 0.25,
		GapWidth = 43.2, -- WE_WallGap marker: opening + both posts; SyncPerimeterWalls leaves this span open
		GapDepth = 8,
		Label = "SEA GATE",
		Guards = { { X = 98, Z = -150 } }, -- one guard prop on the west quay, facing the gate water (+X)
	},

	-- Territories that boats can take. Presence rules (TerritoryCapture):
	--   "BoatOrDeck": only the DRIVER of a Naval vehicle, or a player on foot with HumanoidRootPart.Y >= DeckMinY, counts.
	--   "Any": the normal rule (anyone alive in range), boats included.
	NavalOutposts = {
		CoastalOilAlpha = { Presence = "BoatOrDeck", DeckMinY = 24, Water = { "Lagoon_Alpha" } },
		CoastalOilBravo = { Presence = "BoatOrDeck", DeckMinY = 24, Water = { "Lagoon_Bravo" } },
		SouthDocks = { Presence = "Any", Water = { "Harbour_SouthDocks", "Slip_SouthDocks_W", "Slip_SouthDocks_E" } },
	} :: { [string]: NavalOutpost },

	-- Oil-rig ramp = pier to the inner bank: MapSetup buildOilDeckRamp with the sign fixed and the direction snapped
	-- to the X axis toward the map centre (Alpha steps x 1765 -> 1684, Bravo mirrored; approach pad on land).
	RigPierAxisAligned = true,
	-- Concrete footing round each rig leg at the waterline (6 x 2 x 6, y 0.5..2.5): a boat land probe that starts inside
	-- the 28-tall leg would miss the leg; the footing's top (2.5) is seen as land by any probe origin above 2.5.
	RigLegFooting = Vector3.new(6, 2, 6),
	-- Submerged rubble footing under the pier's low end (steps 5-10 and the shelf have bottoms 8.7..14.2, lower than a
	-- capital ship's collidable bridge, up to 13.1 above the water): rig-local Near..Far studs along the pier axis,
	-- +-HalfWidth across, y 0.5..2.5, collidable Concrete. Boats brake before it instead of ramming the steps.
	RigPierFooting = { Near = 57, Far = 90, HalfWidth = 11, Height = 2 },

	-- WE_NavalSpawn pontoons (collidable 18 x 1.2 x 18, top 2.1 = 0.6 above the water; also WE_VehicleSpawn so the
	-- garage prompt shows). Built by MapSetup (today's pad code, reading this list). Boats spawn BESIDE them (vehicles
	-- spec). The last three are new ring landings at road ends.
	NavalPadSize = 18,
	NavalPads = {
		{ Name = "NavalPad_1", X = -420, Z = 1580 },
		{ Name = "NavalPad_2", X = -240, Z = 1620 },
		{ Name = "NavalPad_3", X = -80, Z = 1640 },
		{ Name = "NavalPad_4", X = 80, Z = 1640 },
		{ Name = "NavalPad_5", X = 240, Z = 1620 },
		{ Name = "NavalPad_6", X = 420, Z = 1580 },
		{ Name = "NavalPad_7", X = 0, Z = 1720 },
		{ Name = "NavalPad_8", X = -560, Z = 1680 },
		{ Name = "NavalPad_9", X = 560, Z = 1680 },
		{ Name = "NavalPad_RingN", X = 0, Z = -1769 },
		{ Name = "NavalPad_RingE", X = 1769, Z = 0 },
		{ Name = "NavalPad_RingW", X = -1769, Z = 0 },
	} :: { NavalPad },

	-- World roads stop RoadEndSetback studs before the first water (no bridges; every land outpost is inside the ring).
	-- Key = MapSetup road part name; Min/Max = extent along the road (z for RoadX<x>, x for RoadZ<z>). Each road is
	-- built as two parts split at 0 (<name>_A: Min..0, <name>_B: 0..Max) so no part exceeds 2000 studs.
	RoadEndSetback = 8,
	RoadEnds = {
		["RoadX-800"] = { Min = -1752, Max = 1482 },
		["RoadX0"] = { Min = -1752, Max = 1356 }, -- south end at the South Docks harbour
		["RoadX800"] = { Min = -1752, Max = 1482 },
		["RoadZ-800"] = { Min = -1752, Max = 1702 }, -- east end at Lagoon_Alpha
		["RoadZ0"] = { Min = -1752, Max = 1752 },
		["RoadZ800"] = { Min = -1702, Max = 1752 }, -- west end at Lagoon_Bravo
	} :: { [string]: RoadEnd },
	-- Jersey barrier across each road end (collidable, yellow/black stripe)
	RoadEndBarrier = { Width = 18, Height = 2.4, Depth = 1.6 },

	-- Road corridor rule of Waterways.CullDressing (roadmap W0 ROAD; World v2 H2). The road centre lines are the
	-- RoadEnds keys (RoadX<x> runs along Z at x, RoadZ<z> along X at z), over Min..Max (the whole map while Enabled is
	-- false and the roads run full length). A decor part is on a road when its world AABB overlaps Min..Max along the
	-- road and comes within the margin of the centre line across it.
	RoadCull = {
		Enabled = true,
		-- Nothing collidable with its top above MinTop within Corridor studs of a centre line (lane 7 + shoulder 5).
		Corridor = 12,
		MinTop = 0.75, -- desert floor 0.5 + 0.25: flatter parts are markings and stay
		-- Nothing at all (collidable or not) taller than LaneMaxHeight above the floor within Lane studs: the walk-through
		-- crates, drums and sandbag tops you would drive through. Fully transparent parts and MarkingPrefixes stay.
		Lane = 8,
		LaneMaxHeight = 0.3,
		MarkingPrefixes = { "RoadCrater", "RoadChevron", "AsphaltStrip", "ChevronWedge", "RoadDash", "WreckScorch" },
		-- Whole kit: a hit takes its nearest Model or kit Folder ancestor (below the culled folder) when that spans
		-- <= KitMaxSpan studs across (XZ) and holds no exempt part; otherwise the part alone.
		KitMaxSpan = 64,
		-- Part-alone hits also take the parts they carried (sandbag tops, sign faces, lamp arms, bunker doors): a sibling
		-- whose bottom is more than SweepMinLift above the floor (so not a separate prop standing on the sand) and whose
		-- AABB touches (SweepTouch) a culled part, repeated, within KitMaxSpan of the first hit. Nothing is left floating.
		SweepAttached = true,
		SweepMinLift = 0.1,
		SweepTouch = 0.1,
		-- Never culled by the road rule: parts under a folder with one of these names (or a plot folder "Plot<N>"), parts
		-- with one of ExemptNames, and anything with the WE_AllowOnRoad attribute on it or an ancestor.
		ExemptAncestors = { "RoadEnds", "Bases", "Territories" },
		ExemptNames = { "CheckpointArm" }, -- World v2 checkpoint arms stand raised on the shoulder
	},
}

return WaterConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">WeaponConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Weapon definitions — damage/fireRate server-authoritative later ]]

export type WeaponDef = {
	Id: string,
	DisplayName: string,
	ShortName: string?, -- v70: hotbar slot label (upper case, fits a 64 v slot); nil = DisplayName upper-cased
	Rarity: string,
	UnlockLevel: number,
	Damage: number,
	FireRate: number, -- shots per second
	MagazineSize: number,
	ReloadTime: number,
	Range: number,
	Spread: number,
	CostCash: number?, -- v69: > 0 = sold in Shop › WEAPONS at this server-side price; 0 / nil = not sold
	Pellets: number?, -- shotgun-style; server applies Damage * Pellets max
}

local WeaponConfig = {
	Weapons = {
		StarterRifle = {
			Id = "StarterRifle",
			DisplayName = "Starter Rifle",
			ShortName = "RIFLE",
			Rarity = "Common",
			UnlockLevel = 1,
			Damage = 18,
			FireRate = 8,
			MagazineSize = 30,
			ReloadTime = 2.2,
			Range = 120,
			Spread = 2.5,
			CostCash = 0,
		},
		AssaultRifle = {
			Id = "AssaultRifle",
			DisplayName = "Assault Rifle",
			ShortName = "AR",
			Rarity = "Common",
			UnlockLevel = 3,
			Damage = 22,
			FireRate = 9,
			MagazineSize = 30,
			ReloadTime = 2.0,
			Range = 140,
			Spread = 2.0,
			CostCash = 5000,
		},
		SMG = {
			Id = "SMG",
			DisplayName = "SMG",
			ShortName = "SMG",
			Rarity = "Common",
			UnlockLevel = 4,
			Damage = 14,
			FireRate = 14,
			MagazineSize = 40,
			ReloadTime = 1.8,
			Range = 80,
			Spread = 4.0,
			CostCash = 6500,
		},
		Pistol = {
			Id = "Pistol",
			DisplayName = "Sidearm Pistol",
			ShortName = "PISTOL",
			Rarity = "Common",
			UnlockLevel = 1,
			Damage = 20,
			FireRate = 4,
			MagazineSize = 12,
			ReloadTime = 1.5,
			Range = 60,
			Spread = 1.5,
			CostCash = 1500,
		},
		Shotgun = {
			Id = "Shotgun",
			DisplayName = "Combat Shotgun",
			ShortName = "SHOTGUN",
			Rarity = "Uncommon",
			UnlockLevel = 6,
			Damage = 12, -- per pellet conceptually; Combat will apply pellet count
			FireRate = 1.2,
			MagazineSize = 6,
			ReloadTime = 3.0,
			Range = 40,
			Spread = 8.0,
			CostCash = 12000,
			Pellets = 6,
		},
		Sniper = {
			Id = "Sniper",
			DisplayName = "Sniper Rifle",
			ShortName = "SNIPER",
			Rarity = "Rare",
			UnlockLevel = 10,
			Damage = 85,
			FireRate = 0.8,
			MagazineSize = 5,
			ReloadTime = 3.2,
			Range = 400,
			Spread = 0.3,
			CostCash = 25000,
		},
		RocketLauncher = {
			Id = "RocketLauncher",
			DisplayName = "Rocket Launcher",
			ShortName = "RPG",
			Rarity = "Epic",
			UnlockLevel = 14,
			Damage = 150,
			FireRate = 0.4,
			MagazineSize = 1,
			ReloadTime = 4.0,
			Range = 250,
			Spread = 0.5,
			CostCash = 50000,
		},
		Grenade = {
			Id = "Grenade",
			DisplayName = "Frag Grenade",
			ShortName = "FRAG",
			Rarity = "Uncommon",
			UnlockLevel = 5,
			Damage = 60,
			FireRate = 0.5,
			MagazineSize = 1,
			ReloadTime = 1.0,
			Range = 50,
			Spread = 0,
			CostCash = 8000,
		},
	} :: { [string]: WeaponDef },

	DefaultWeapon = "StarterRifle",
}

--[[ v69: one weapon order for Shop › WEAPONS rows and the Q/E / mobile ◀ ▶ cycle:
	UnlockLevel, then CostCash, then id. ]]
function WeaponConfig.SortedIds(): { string }
	local ids: { string } = {}
	for id in pairs(WeaponConfig.Weapons) do
		table.insert(ids, id)
	end
	table.sort(ids, function(a: string, b: string): boolean
		local da, db = WeaponConfig.Weapons[a], WeaponConfig.Weapons[b]
		if da.UnlockLevel ~= db.UnlockLevel then
			return da.UnlockLevel < db.UnlockLevel
		end
		local ca, cb = tonumber(da.CostCash) or 0, tonumber(db.CostCash) or 0
		if ca ~= cb then
			return ca < cb
		end
		return a < b
	end)
	return ids
end

--[[ v69: parse the server's owned-weapons player attribute (WE_Weapons = "Pistol,StarterRifle", written by
	CombatService) into a set of known weapon ids. The default weapon is always owned (server EnsureStarter).
	Display / input filtering only — the server re-validates every equip and purchase. ]]
function WeaponConfig.ParseOwned(raw: any): { [string]: boolean }
	local set: { [string]: boolean } = {}
	if typeof(raw) == "string" then
		for id in string.gmatch(raw, "[^,]+") do
			if WeaponConfig.Weapons[id] ~= nil then
				set[id] = true
			end
		end
	end
	set[WeaponConfig.DefaultWeapon] = true
	return set
end

return WeaponConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">WorldConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 (gap/world_v2_spec.md + roadmap §1.5 corrections): the world OUTSIDE the bases.
	One source of truth for the Phase 1 modules (all under ServerScriptService/Server/Modules):
	  * WorldTerrain    — Terrain canyon edge round the ring canal + the far shore that closes the Bay (Terrain section)
	  * WorldBounds     — Persistent skyline ridges, invisible ground / air walls, seabed tint, far-shore lighthouse and
	                      stranded freighter (Skyline, Bounds, Seabed, FarShore sections)
	  * WorldAtmosphere — Lighting / Sky / Atmosphere presets and the day cycle (Atmosphere section)
	  * WorldHygiene    — rules H1–H10 over the world dressing (Hygiene section)
	plus the Phase 2 data the hook step and W3 read (POIs, Spawns, Budgets).

	Units: world studs, +Y up, north = -Z. Desert floor (Part ground tiles) top = 0.5, plot pad top = 1.0.
	Playable dry land is inside the ring canal: x ±1760, z -1760 .. 1490 (the sea / Bay south of 1490).
	"Outward distance" (Terrain profiles) is measured from the belt's inner edge along the outward normal.

	Every number here is a start value to tune on the owner's phone (Test B).
]]

export type Band = { From: number, To: number, Min: number, Max: number } -- outward from..to; height min..max
export type Profile = {
	Skirt: Band, -- FillBlock Rock shelf, top Min..Max (the boats' +6 land probe sees it = shore brake)
	Talus: Band, -- FillBlock Ground to Min, then FillWedge rising Min -> Max (<= Terrain.MaxTalusTop)
	Face: Band, -- FillBlock Sandstone, vertical (yaw jitter only), height Min..Max by smooth noise
	FaceOverlap: number, -- the face block starts this far inside the talus, so its yaw jitter never opens a crack
	FaceYawJitter: number,
	FaceNoiseWave: number, -- studs per noise lattice cell along the edge
	StrataAt: { { number } }, -- centre height as a fraction of H: { lo, hi } per band
	StrataThick: { number }, -- { min, max }
	StrataDepth: number, -- outer skin depth (flush with the face, never a ledge)
	MesaDepth: number, -- roadmap §1.3: mesas end at most this far past the face (no back-fill wedge)
	MesaA: Band, -- From/To are measured from the face's outer end (negative From = overlaps the face: no cracks)
	MesaB: Band,
	MesaBChance: number,
	MesaBWidth: { number }, -- { min, max } along the edge
	MesaYawJitter: number,
	ButteEvery: number,
	ButteR: { number },
	ButteH: { number },
	ButteAt: number, -- centre, measured from the face's outer end (centre + R stays inside MesaDepth)
	ButteCap: number,
	AlcoveEvery: number,
	AlcoveR: { number },
	Boulders: { number }, -- { min, max } count per segment
	BoulderR: { number },
}
export type Rect = { Name: string?, X0: number, X1: number, Z0: number, Z1: number }
export type Notch = { Side: string, Out: number, Z0: number, Z1: number }
export type POI = {
	Id: string,
	Name: string,
	Kind: string,
	Rect: Rect?,
	Circle: { X: number, Z: number, R: number }?,
	Budget: number,
}
export type Pad = { Id: string, X: number?, Z: number?, PlotId: number?, LocalX: number?, LocalZ: number?, Yaw: number? }
export type Anchor = { Id: string, X: number, Z: number }

local M = Enum.Material

local WorldConfig = {
	-- Bump to rebuild the terrain edge and the bounds on the next server start (both are stamped with it).
	Gen = 1,

	-- ── Terrain canyon edge (WorldTerrain; spec §1.1–§1.2, roadmap §1.5 #1–#2) ────────────────────────────────
	Terrain = {
		Enabled = true,
		Seed = 70802,
		-- Workspace.Terrain:GetAttribute("WE_TerrainGen") == Gen → Build skips. A different stamp clears the terrain
		-- first (World v2 owns all terrain: nothing else in the game fills voxels).
		Gen = 1,
		ClearOnRegen = true,
		Decoration = false, -- no animated grass (phones)
		YieldEvery = 50, -- Build yields (task.wait) every N fills
		BuildBudgetSeconds = 5, -- logged; the owner checks it in the Output (Test B)
		MaxPrims = 2500, -- hard cap on fill calls for the edge (roadmap W1 headless check)
		MaxTalusTop = 20, -- roadmap §1.5 #1: never a ramp to the face (jump rise ~7.2)
		FootY = -4, -- every land prim starts here: under the Part ground top (0.5), above the SafetyCatch (-26)
		-- Keep-out: no voxel inside the playable ring (canal + its outer bank) …
		Ring = { X = 1846, ZMin = -1846, ZMax = 1490 },
		-- … and none inside a public water rect, except headland prims at |x| >= Edge.Inner whose top is >= this
		-- (they sit over the outer sea ends of Sea_W / Sea_E2 / Sea_E3 and hide them under rock).
		HeadlandMinTop = 2.5,
		Edge = {
			Inner = 1852, -- canal outer edge 1840 + bank 6 + beach 6
			FarShoreZ = 2234, -- sea edge 2210 + sea bank 24
			-- Rig lagoons: the skirt steps out to the lagoon edge + bank 6 + 6, so the cliffs wrap round each rig.
			Notches = {
				{ Side = "E", Out = 1902, Z0 = -846, Z1 = -654 }, -- Lagoon_Alpha z -840..-660
				{ Side = "W", Out = 1902, Z0 = 654, Z1 = 846 }, -- Lagoon_Bravo
			} :: { Notch },
			SegmentMin = 60,
			SegmentMax = 140,
			Overlap = 8, -- each segment's prims reach this far past its ends (no seams); never past a run end
			CornerSegments = 6, -- quarter circle at each of the 4 outer corners
			CornerButteR = { 45, 55 },
			CornerButteH = { 320, 340 },
		},
		-- Canal / sea-cliff profile (east, west, north). Heights are world Y of the top.
		Side = {
			Skirt = { From = 0, To = 18, Min = 2.5, Max = 5.5 },
			Talus = { From = 18, To = 48, Min = 8, Max = 20 },
			Face = { From = 48, To = 108, Min = 90, Max = 150 },
			FaceOverlap = 12,
			FaceYawJitter = 6,
			FaceNoiseWave = 420,
			StrataAt = { { 0.30, 0.40 }, { 0.62, 0.72 } },
			StrataThick = { 8, 14 },
			StrataDepth = 4,
			MesaDepth = 120,
			MesaA = { From = -24, To = 62, Min = 160, Max = 220 },
			MesaB = { From = 40, To = 120, Min = 200, Max = 300 },
			MesaBChance = 0.8,
			MesaBWidth = { 50, 180 },
			MesaYawJitter = 8,
			ButteEvery = 4,
			ButteR = { 25, 45 },
			ButteH = { 260, 340 },
			ButteAt = 72,
			ButteCap = 8,
			AlcoveEvery = 5,
			AlcoveR = { 18, 30 },
			Boulders = { 1, 3 },
			BoulderR = { 3, 9 },
		} :: Profile,
		-- The Bay's far shore (south of the sea): beach skirt, sea cliffs 80–160, mesas 140–260.
		FarShore = {
			Skirt = { From = 0, To = 26, Min = 2.5, Max = 5.5 },
			Talus = { From = 26, To = 56, Min = 8, Max = 20 },
			Face = { From = 56, To = 116, Min = 80, Max = 160 },
			FaceOverlap = 12,
			FaceYawJitter = 6,
			FaceNoiseWave = 380,
			StrataAt = { { 0.30, 0.40 }, { 0.62, 0.72 } },
			StrataThick = { 8, 14 },
			StrataDepth = 4,
			MesaDepth = 120,
			MesaA = { From = -24, To = 62, Min = 140, Max = 200 },
			MesaB = { From = 40, To = 120, Min = 180, Max = 260 },
			MesaBChance = 0.8,
			MesaBWidth = { 50, 180 },
			MesaYawJitter = 8,
			ButteEvery = 4,
			ButteR = { 25, 45 },
			ButteH = { 240, 300 },
			ButteAt = 72,
			ButteCap = 8,
			AlcoveEvery = 5,
			AlcoveR = { 18, 30 },
			Boulders = { 1, 3 },
			BoulderR = { 3, 9 },
		} :: Profile,
		-- Sand slabs over the outer sea ends (Sea_W / Sea_E2 / Sea_E3 beyond the headlands), starting inside the belt
		-- (x ±1900, under the face) so no open water shows between or behind the mesas from the air. Top above the
		-- water surface (1.5). WaterConfig is not edited.
		SeaCover = {
			Top = 2.8,
			Rects = {
				{ Name = "SeaCover_W", X0 = -3264, X1 = -1900, Z0 = 1466, Z1 = 2234 },
				{ Name = "SeaCover_E", X0 = 1900, X1 = 3264, Z0 = 1466, Z1 = 2234 },
			} :: { Rect },
		},
		-- Rock pad the far-shore lighthouse stands on (WorldBounds builds the tower on top of it).
		LighthousePad = { X = -1300, Z = 2252, Half = 18, Top = 6 },
		Materials = {
			Skirt = M.Rock,
			Talus = M.Ground,
			Face = M.Sandstone,
			Strata = { M.Limestone, M.Slate },
			Mesa = { M.Sandstone, M.Sandstone, M.Limestone },
			Butte = M.Sandstone,
			ButteCap = M.Slate,
			Boulder = M.Rock,
			Cover = M.Sand,
		},
		-- Terrain:SetMaterialColor, once. Sand = MapSetup COL_GROUND so terrain meets the Part ground with no seam.
		Colors = {
			{ Material = M.Sand, Color = Color3.fromRGB(210, 185, 130) },
			{ Material = M.Sandstone, Color = Color3.fromRGB(176, 104, 66) },
			{ Material = M.Limestone, Color = Color3.fromRGB(222, 200, 160) },
			{ Material = M.Slate, Color = Color3.fromRGB(118, 92, 78) },
			{ Material = M.Rock, Color = Color3.fromRGB(134, 94, 72) },
			{ Material = M.Ground, Color = Color3.fromRGB(168, 128, 88) },
			{ Material = M.Basalt, Color = Color3.fromRGB(80, 68, 60) },
			{ Material = M.Salt, Color = Color3.fromRGB(228, 218, 196) },
		},
	},

	-- ── Skyline back range (WorldBounds; spec §1.3) ───────────────────────────────────────────────────────────
	Skyline = {
		Name = "WE_Skyline", -- Model under WarEmpireSetup, ModelStreamingMode = Persistent
		Seed = 70311,
		RInner = 2700, -- square ring: |x| or |z| between RInner and ROuter
		ROuter = 3300,
		PerSide = 4, -- 16 ridges x 3 parts = 48
		HeightMin = 340,
		HeightMax = 420,
		BodyShare = 0.62, -- body / slope height as a share of the peak height
		SlopeDepth = 200, -- front WedgePart (rises outward) from RInner
		PeakLength = { 0.35, 0.6 }, -- share of the ridge length
		YawJitter = 5,
		Overlap = 40,
		Material = M.Sandstone,
		-- darker and bluer than the belt (aerial perspective), so the two read as two ranges
		Colors = {
			Body = Color3.fromRGB(128, 86, 66),
			Slope = Color3.fromRGB(136, 94, 74),
			Peak = Color3.fromRGB(112, 80, 68),
		},
	},

	-- ── Bounds (WorldBounds; spec §1.4) ────────────────────────────────────────────────────────────────────────
	Bounds = {
		Folder = "WE_Bounds",
		-- Invisible, collidable, CanQuery / CanTouch / CastShadow off: raycasts, probes and shots ignore them.
		GroundWall = { X = 1960, ZMin = -1960, ZMax = 2300, Height = 400, Thick = 4, MaxPiece = 2000 }, -- 10 parts
		AirWall = { X = 2050, ZMin = -2050, ZMax = 2350, Height = 700, Thick = 4, MaxPiece = 2000 }, -- 12 parts
		-- Hand-off to the vehicles workflow (JEEP-2): heli / plane laws steer back and show "Restricted airspace"
		-- outside this box or above MaxY. The air wall is the backstop.
		Air = { X = 2050, ZMin = -2050, ZMax = 2350, MaxY = 360 },
		-- Hook step (MapSetup.buildSafetyUnderfloor): the SafetyCatch tiles become opaque sand.
		SafetyCatch = { Transparency = 0, Material = M.Sand, Color = Color3.fromRGB(196, 170, 120) },
	},

	-- ── Seabed depth tint (WorldBounds; spec §1.5) ─────────────────────────────────────────────────────────────
	Seabed = {
		-- Above every Waterways bank top (0.58 + 0.004 per rect, <= 0.672 with 24 rects) and inside the water
		-- volume (0.3 .. 1.5). No physics.
		Y0 = 0.68,
		Y1 = 0.70,
		Color = Color3.fromRGB(38, 86, 110),
		Material = M.SmoothPlastic,
		Rects = {
			-- deep band in the Bay, 70 in from the north shore (1490) and 50 from the far bank (2210)
			{ Name = "SeabedTint_Bay_W", X0 = -1790, X1 = 0, Z0 = 1560, Z1 = 2160 },
			{ Name = "SeabedTint_Bay_E", X0 = 0, X1 = 1790, Z0 = 1560, Z1 = 2160 },
			-- 40-wide stripe down the centre of each ring-canal side (the side stripes own the corners)
			{ Name = "SeabedTint_N_W", X0 = -1780, X1 = 0, Z0 = -1820, Z1 = -1780 },
			{ Name = "SeabedTint_N_E", X0 = 0, X1 = 1780, Z0 = -1820, Z1 = -1780 },
			{ Name = "SeabedTint_W_N", X0 = -1820, X1 = -1780, Z0 = -1820, Z1 = -165 },
			{ Name = "SeabedTint_W_S", X0 = -1820, X1 = -1780, Z0 = -165, Z1 = 1490 },
			{ Name = "SeabedTint_E_N", X0 = 1780, X1 = 1820, Z0 = -1820, Z1 = -165 },
			{ Name = "SeabedTint_E_S", X0 = 1780, X1 = 1820, Z0 = -165, Z1 = 1490 },
		} :: { Rect },
	},

	-- ── Far-shore landmarks (WorldBounds; spec §1.1): Part kits, 22 parts ───────────────────────────────────────
	FarShore = {
		Lighthouse = {
			X = -1300,
			Z = 2252,
			BaseY = 6, -- = Terrain.LighthousePad.Top
			Yaw = 0,
			-- one SpotLight, on only at night (tag WE_NightLight; WorldAtmosphere toggles it), aimed over the Bay
			Light = { Brightness = 0.8, Range = 18, Angle = 70, Color = Color3.fromRGB(255, 236, 190) },
		},
		Freighter = {
			X = 600,
			Z = 2222, -- stern in the Bay, bow on the far beach
			Yaw = 20, -- degrees; the bow (hull +Z) points south-south-east, up the far beach
			Pitch = 8, -- bow up
			Roll = 3,
		},
	},

	-- ── Atmosphere and lighting (WorldAtmosphere; spec §2, roadmap §1.3 / §1.6) ─────────────────────────────────
	Atmosphere = {
		-- One-line revert for Test B: "Classic" = the pre-v2 look (blue Decay below the horizon, light haze).
		Preset = "V2",
		DayLengthMinutes = 20,
		StepSeconds = 6, -- one day-cycle step every 6 s (was 1.5 s); steps are 4x larger, same 20-minute day
		StartClock = 12.5,
		-- night share: 1 before NightEnd / after NightStart, ramps over DawnHours / DuskHours
		NightEnd = 5,
		DawnEnd = 7,
		DuskStart = 18,
		NightStart = 20,
		NightLightTag = "WE_NightLight", -- lights with this tag are Enabled only while night > 0.5
		Lighting = {
			GeographicLatitude = 22,
			EnvironmentSpecularScale = 0.42,
			-- HUD spec §5 (agent F's numbers): day Ambient (78,72,62) + EnvironmentDiffuseScale 0.35 fix the washed-out
			-- interiors. StructureVisualConfig.WorldLighting (the in-base knob) overrides these two when present.
			EnvironmentDiffuseScale = 0.35,
			GlobalShadows = true,
		},
		Sky = { StarCount = 2500, SunAngularSize = 18, MoonAngularSize = 9 },
		Presets = {
			V2 = {
				Day = {
					Brightness = 3.2,
					Ambient = Color3.fromRGB(78, 72, 62),
					OutdoorAmbient = Color3.fromRGB(185, 165, 130),
					Density = 0.30,
					Offset = 0.22, -- silhouettes the canyon; less sky "ghosting" through far terrain
					Color = Color3.fromRGB(199, 178, 140), -- warm dust
					Decay = Color3.fromRGB(150, 122, 92), -- warm: no blue below the horizon
					Glare = 0.25,
					Haze = 1.8,
				},
				Night = {
					Brightness = 1.6, -- floor: phones never go black
					Ambient = Color3.fromRGB(40, 45, 70),
					OutdoorAmbient = Color3.fromRGB(50, 55, 85),
					Density = 0.36,
					Offset = 0.22,
					Color = Color3.fromRGB(70, 80, 110),
					Decay = Color3.fromRGB(40, 48, 80),
					Glare = 0.1,
					Haze = 2.4,
				},
			},
			Classic = { -- MapSetup.Run before World v2 (fog writes dropped: Atmosphere hides them anyway)
				Day = {
					Brightness = 3.2,
					Ambient = Color3.fromRGB(78, 72, 62),
					OutdoorAmbient = Color3.fromRGB(185, 165, 130),
					Density = 0.13,
					Offset = 0.08,
					Color = Color3.fromRGB(200, 185, 150),
					Decay = Color3.fromRGB(95, 130, 190),
					Glare = 0.32,
					Haze = 1.1,
				},
				Night = {
					Brightness = 1.1,
					Ambient = Color3.fromRGB(40, 45, 70),
					OutdoorAmbient = Color3.fromRGB(50, 55, 85),
					Density = 0.27,
					Offset = 0.08,
					Color = Color3.fromRGB(70, 80, 120),
					Decay = Color3.fromRGB(40, 50, 90),
					Glare = 0.12,
					Haze = 2.1,
				},
			},
		},
	},

	-- ── Lights outside the bases (spec §2 lights policy; WorldHygiene H8) ──────────────────────────────────────
	Lights = {
		MaxWorld = 24,
		MaxBrightness = 0.8,
		MaxRange = 18,
		Shadows = false,
		LampHeadColor = Color3.fromRGB(255, 236, 190), -- SmoothPlastic lamp heads, never Neon
	},

	-- ── Hygiene rules H1–H10 (WorldHygiene; spec §5.1, roadmap §1.5 #3) ────────────────────────────────────────
	Hygiene = {
		-- H1 runs in Report mode in W1 (log + list only); W3 switches it to "Enforce".
		OrphanMode = "Report",
		-- Folders under WarEmpireSetup whose contents are world dressing (Enforce acts ONLY inside these).
		DressingFolders = { "WorldDressing", "DesertFlora", "WorldPOI", "WorldKits" },
		-- Never inspected as world parts (bases) / never mutated.
		BaseFolders = { "Bases" },
		-- Built by World v2 itself: exempt from H1 / H4 / H10 (designed pieces, Persistent skyline).
		WorldV2Folders = { "WE_Skyline", "WE_Bounds" },
		-- MapSetup blocks the hook step deletes (spec §1.6); Report counts their parts as "legacy".
		LegacyFolders = { "MountainRing", "NPCPlaceholders", "OilSpectacle", "WarzoneLandmarks" },
		-- H1 anchor distance (studs) to a POI footprint, road centre line, water edge or plot edge
		AnchorMax = 60,
		-- H1: natural clusters may stand alone as >= MinNatural elements within NaturalLink studs of each other
		MinNatural = 3,
		NaturalLink = 40,
		NaturalPrefixes = { "Palm", "Joshua", "Saguaro", "Barrel", "Grass", "Flora", "DesertRock", "WE_CatalogProp_DesertRock", "Rock", "Outcrop", "Mesa", "Cactus", "Bush", "Shrub", "Boulder", "Dune" },
		NaturalFolders = { "DesertFlora" },
		-- H2 road corridor (roads = WaterConfig.RoadEnds centre lines)
		RoadCorridor = 12, -- nothing collidable with its top above RoadMinTop (lane 7 + shoulder 5)
		RoadMinTop = 0.75,
		RoadLane = 8, -- nothing visible taller than 0.5 + RoadLaneMaxHeight
		RoadLaneMaxHeight = 0.3,
		RoadMarkingPrefixes = { "RoadCrater", "RoadChevron", "AsphaltStrip", "ChevronWedge", "RoadDash", "WreckScorch" },
		RoadExemptAncestors = { "RoadEnds" },
		RoadExemptNames = { "CheckpointArm" },
		-- whole kit = nearest Model / kit Folder below the dressing folder when it spans <= KitMaxSpan (XZ)
		KitMaxSpan = 64,
		-- H3 clear zones
		CaptureClearScale = 1.414, -- TerritoryCapture uses the marker half-diagonal
		CaptureClearExtra = 25,
		CaptureSkip = { "CoastalOilAlpha", "CoastalOilBravo" }, -- rigs stand in water: the water rule covers them
		GateApron = { X0 = -45, X1 = 45, Z0 = 160, Z1 = 220 }, -- plot-local (+Z = front / main gate)
		PadClear = 16, -- round every land WE_VehicleSpawn pad
		PlotPadClear = 4, -- same as Waterways.CullDressing
		WaterClear = 6,
		ClearRects = {
			{ Name = "RigPier_Alpha", X0 = 1640, X1 = 1780, Z0 = -770, Z1 = -730 },
			{ Name = "RigPier_Bravo", X0 = -1780, X1 = -1640, Z0 = 730, Z1 = 770 },
		} :: { Rect },
		-- H4 cover is solid: man-made parts matching SolidKeywords (and none of SoftKeywords), >= SolidMinHeight tall
		-- (part or its kit), visible, not a MeshPart (meshes collide through their host part)
		SolidMinHeight = 1.5,
		SolidKeywords = { "Crate", "Drum", "Sandbag", "Wall", "Wreck", "Container", "Tank", "Booth", "Stall", "Hull", "Bunker", "Hesco", "Barrier", "Jersey", "Adobe", "Ruin", "Shed", "Hut", "Hangar", "Cabin", "Barricade", "Debris", "Decoy", "Truck", "Car" },
		SoftKeywords = { "Frond", "Leaf", "Crown", "Tarp", "Canopy", "Cloth", "Flag", "Wire", "GuyLine", "Cable", "Arm", "Lamp", "Marking", "Stripe", "Dash", "Chevron", "Scorch", "Accent", "Window", "Door", "Roof", "Glow", "Light", "Host", "Label", "Anchor", "Stake", "Grass", "Net", "Wheel", "Turret", "Barrel" },
		-- H5 world-code BillboardGuis: allowed only under these (service labels owned by agent F / the tutorial)
		BillboardAllowAncestors = { "Territories", "EmpireBank", "TutorialMarkers" },
		-- H7
		MaxPartSize = 2040,
		-- H9
		ShadowMinSize = 8,
		MaxShadowCasters = 300,
		-- H10
		MaxModelSpan = 64,
	},

	-- ── Budgets (spec §7.1; CLAUDE.md hard cap 3,100 world parts outside the bases) ─────────────────────────────
	Budgets = {
		PartsOutsideBasesFull = 2900,
		PartsOutsideBasesLow = 1900,
		HardCap = 3100,
		Lights = 24,
		SurfaceGuis = 12,
		ShadowCasters = 300,
		TerrainEdgePrims = 2500,
		SkylineParts = 48,
		BoundsParts = 52, -- walls 22 + tint 8 + far shore 22
	},

	-- ── Phase 2 data (W3 builds the POIs; H1 already uses the footprints as anchors) ────────────────────────────
	POIs = {
		{ Id = "Town", Name = "Crossroads Town", Kind = "town", Rect = { X0 = -330, X1 = 330, Z0 = -330, Z1 = 330 }, Budget = 220 },
		{ Id = "Depot", Name = "West Supply Depot", Kind = "depot", Rect = { X0 = -1500, X1 = -1110, Z0 = -200, Z1 = 200 }, Budget = 120 },
		{ Id = "Armory", Name = "East Armory", Kind = "armory", Rect = { X0 = 1110, X1 = 1500, Z0 = -200, Z1 = 200 }, Budget = 120 },
		{ Id = "Signal", Name = "North Ridge Signal Station", Kind = "signal", Rect = { X0 = -280, X1 = 90, Z0 = -1480, Z1 = -1120 }, Budget = 90 },
		{ Id = "Port", Name = "South Port", Kind = "port", Rect = { X0 = -330, X1 = 330, Z0 = 1180, Z1 = 1466 }, Budget = 150 },
		{ Id = "OilField", Name = "Oil Field", Kind = "oil", Rect = { X0 = 830, X1 = 1230, Z0 = 830, Z1 = 1230 }, Budget = 110 },
		{ Id = "Radar", Name = "Radar Hill", Kind = "radar", Circle = { X = -950, Z = -950, R = 130 }, Budget = 60 },
		{ Id = "FortI", Name = "Fort Ironclad approach", Kind = "fort", Circle = { X = 1450, Z = -1450, R = 230 }, Budget = 60 },
		{ Id = "FortS", Name = "Fort Sandhold approach", Kind = "fort", Circle = { X = -1450, Z = 1450, R = 200 }, Budget = 60 },
		{ Id = "RigA", Name = "Rig Alpha shore base", Kind = "rigshore", Rect = { X0 = 1540, X1 = 1698, Z0 = -880, Z1 = -620 }, Budget = 40 },
		{ Id = "RigB", Name = "Rig Bravo shore base", Kind = "rigshore", Rect = { X0 = -1698, X1 = -1540, Z0 = 620, Z1 = 880 }, Budget = 40 },
		{ Id = "Airstrip", Name = "Desert Airstrip", Kind = "airstrip", Rect = { X0 = 240, X1 = 780, Z0 = -1380, Z1 = -1150 }, Budget = 100 },
		{ Id = "Ruins", Name = "Ruined Village", Kind = "ruins", Circle = { X = -540, Z = -1320, R = 190 }, Budget = 100 },
		{ Id = "Quarry", Name = "Quarry Camp", Kind = "camp", Circle = { X = -1380, Z = -1380, R = 220 }, Budget = 90 },
		{ Id = "RidgeCamp", Name = "Ridge Camp", Kind = "camp", Circle = { X = 1420, Z = -1060, R = 150 }, Budget = 60 },
		{ Id = "DuneCamp", Name = "Dune Camp", Kind = "camp", Circle = { X = 1450, Z = 1200, R = 160 }, Budget = 60 },
		{ Id = "Crash", Name = "Crash Site", Kind = "crash", Circle = { X = -540, Z = 1140, R = 165 }, Budget = 80 },
		{ Id = "Oasis", Name = "Oasis", Kind = "oasis", Circle = { X = -1300, Z = 560, R = 125 }, Budget = 60 },
	} :: { POI },

	-- ── Spawn pads and anchors (spec §3.3; the hook step replaces MapSetup's makeSpawnFolder rings with these) ───
	Spawns = {
		-- Garage pads (WE_VehicleSpawn): painted Concrete aprons, no beacon, no billboard. Gate pads are plot-local
		-- (BaseLayout.PlotPoint(plotPos, LocalX, LocalZ)) and face the plot forward; pools face Yaw (degrees, 0 = -Z).
		PadSize = Vector3.new(20, 1.2, 20),
		Garage = {
			{ Id = "Gate_P1", PlotId = 1, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P2", PlotId = 2, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P3", PlotId = 3, LocalX = -62, LocalZ = 222 },
