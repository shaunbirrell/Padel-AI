local vehicleFolder: Folder? = nil

local function now(): number
	return os.clock()
end

local function ensureFolder(): Folder
	local cached = vehicleFolder
	if cached and cached.Parent then
		return cached
	end
	local existing = Workspace:FindFirstChild("WarEmpireVehicles")
	if existing and existing:IsA("Folder") then
		vehicleFolder = existing
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "WarEmpireVehicles"
	folder.Parent = Workspace
	vehicleFolder = folder
	return folder
end

local function getDef(vehicleId: string): VehicleDef?
	return VehicleConfig.Vehicles[vehicleId]
end

local function notify(player: Player, message: string, kind: string, duration: number?)
	if NotificationService and NotificationService.Notify then
		pcall(NotificationService.Notify, player, message, kind, duration)
	end
end

-- ── Maths shared with the client laws (spec §2.0) ───────────────────────────────────────────────
local function approach(x: number, target: number, rate: number, dt: number): number
	local d = target - x
	local m = rate * dt
	if d > m then
		return x + m
	elseif d < -m then
		return x - m
	end
	return target
end

local function fwd(h: number): Vector3
	return Vector3.new(-math.sin(h), 0, -math.cos(h))
end

local function right(h: number): Vector3
	return Vector3.new(math.cos(h), 0, -math.sin(h))
end

local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function orient(pitchDeg: number, h: number, bankDeg: number): CFrame
	return CFrame.fromEulerAnglesYXZ(math.rad(pitchDeg), h, -math.rad(bankDeg))
end

local function unitInput(v: any): number
	local n = tonumber(v)
	if n == nil or n ~= n then
		return 0
	end
	return math.clamp(n, -1, 1)
end

local function partVelocity(part: BasePart): Vector3
	local v = (part :: any).AssemblyLinearVelocity
	if typeof(v) == "Vector3" then
		return v
	end
	return Vector3.zero
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- ── Water (spec §2.5; the same algorithm as VehicleDriveClient.Laws.WaterSurfaceAt) ─────────────
local waterParts: { BasePart } = {}
local waterRefreshAt = 0

local function refreshWaterParts()
	local list: { BasePart } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.Water)) do
		if inst:IsA("BasePart") and inst.Parent then
			table.insert(list, inst)
		end
	end
	waterParts = list
end

local function getWaterParts(): { BasePart }
	local t = now()
	if t >= waterRefreshAt then
		waterRefreshAt = t + WaterCfg.RefreshSeconds
		refreshWaterParts()
	end
	return waterParts
end

--[[ Waterways C5: plot water (DockWater carries WE_PlotId, SeaGateWater WE_GatePlotId) is water only for a boat
	whose owner's BasePlotId is that plot. An enemy boat can then neither spawn in, drive into nor idle in someone's
	basin or gate water, not even behind an ally's boat while the sea gate is open. Public water has neither
	attribute and is water for every boat. ]]
local function waterPlotOf(p: BasePart): number?
	local id = p:GetAttribute("WE_PlotId")
	if id == nil then
		id = p:GetAttribute("WE_GatePlotId")
	end
	return tonumber(id)
end

local function filterPlotWater(parts: { BasePart }, plotId: number?): { BasePart }
	local out: { BasePart } = {}
	for _, p in ipairs(parts) do
		local id = waterPlotOf(p)
		if id == nil or id == plotId then
			table.insert(out, p)
		end
	end
	return out
end

-- per-plot filtered lists, rebuilt whenever getWaterParts() hands out a new list (every RefreshSeconds)
local plotWaterFrom: { BasePart }? = nil
local plotWaterLists: { [number]: { BasePart } } = {}

local function waterPartsFor(plotId: number?): { BasePart }
	local all = getWaterParts()
	if plotWaterFrom ~= all then
		plotWaterFrom = all
		plotWaterLists = {}
	end
	local key = plotId or -1
	local list = plotWaterLists[key]
	if list == nil then
		list = filterPlotWater(all, plotId)
		plotWaterLists[key] = list
	end
	return list
end

--[[ Top of the highest flat WE_Water part under pos (nil = no water). margin shrinks each part's
	rectangle (negative = slack outside the edge). landProbe(x, z, top) → true when something solid
	stands at/above the surface there (kerb, pier, pad, sandbar). ]]
local function waterSurfaceAt(
	parts: { BasePart },
	pos: Vector3,
	margin: number?,
	landProbe: ((number, number, number) -> boolean)?
): number?
	local m = margin or 0
	local best = -math.huge
	local found = false
	for _, p in ipairs(parts) do
		local lp = p.CFrame:PointToObjectSpace(pos)
		local size = p.Size
		if math.abs(lp.X) <= size.X * 0.5 - m and math.abs(lp.Z) <= size.Z * 0.5 - m then
			local top = p.Position.Y + size.Y * 0.5
			if pos.Y >= top - WaterCfg.QueryBelow and pos.Y <= top + WaterCfg.QueryAbove and top > best then
				best = top
				found = true
			end
		end
	end
	if not found then
		return nil
	end
	if landProbe and landProbe(pos.X, pos.Z, best) then
		return nil
	end
	return best
end

-- Water rectangle in XZ (parts are flat, rotated about Y only)
type Rect2 = { CX: number, CZ: number, UX: number, UZ: number, VX: number, VZ: number, HX: number, HZ: number, Top: number, Area: number }

local function rectOf(p: BasePart): Rect2
	local cf = p.CFrame
	local r = cf.RightVector
	local z = -cf.LookVector
	local rm = math.sqrt(r.X * r.X + r.Z * r.Z)
	local zm = math.sqrt(z.X * z.X + z.Z * z.Z)
	local ux, uz = if rm > 1e-6 then r.X / rm else 1, if rm > 1e-6 then r.Z / rm else 0
	local vx, vz = if zm > 1e-6 then z.X / zm else 0, if zm > 1e-6 then z.Z / zm else 1
	return {
		CX = cf.Position.X,
		CZ = cf.Position.Z,
		UX = ux,
		UZ = uz,
		VX = vx,
		VZ = vz,
		HX = p.Size.X * 0.5,
		HZ = p.Size.Z * 0.5,
		Top = p.Position.Y + p.Size.Y * 0.5,
		Area = p.Size.X * p.Size.Z,
	}
end

-- 2D separating-axis test: true when the rectangles overlap or come within `gap` studs.
local function rectsNear(a: Rect2, b: Rect2, gap: number): boolean
	local axes = { { a.UX, a.UZ }, { a.VX, a.VZ }, { b.UX, b.UZ }, { b.VX, b.VZ } }
	local dx, dz = b.CX - a.CX, b.CZ - a.CZ
	for _, n in ipairs(axes) do
		local nx, nz = n[1], n[2]
		local ra = a.HX * math.abs(a.UX * nx + a.UZ * nz) + a.HZ * math.abs(a.VX * nx + a.VZ * nz)
		local rb = b.HX * math.abs(b.UX * nx + b.UZ * nz) + b.HZ * math.abs(b.VX * nx + b.VZ * nz)
		local d = math.abs(dx * nx + dz * nz)
		if d - ra - rb > gap then
			return false
		end
	end
	return true
end

local function isConnectedToSea(basin: BasePart, parts: { BasePart }): boolean
	local list: { BasePart } = {}
	local basinIndex = 0
	for _, p in ipairs(parts) do
		table.insert(list, p)
		if p == basin then
			basinIndex = #list
		end
	end
	if basinIndex == 0 then
		table.insert(list, basin)
		basinIndex = #list
	end
	local rects: { Rect2 } = {}
	local sea, seaArea = 0, -1
	for i, p in ipairs(list) do
		rects[i] = rectOf(p)
		if rects[i].Area > seaArea then
			seaArea = rects[i].Area
			sea = i
		end
	end
	if sea == basinIndex then
		return true
	end
	local seen: { [number]: boolean } = { [basinIndex] = true }
	local queue = { basinIndex }
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		local a = rects[cur]
		for j, b in ipairs(rects) do
			if not seen[j] and math.abs(a.Top - b.Top) <= WaterCfg.ConnectTopDelta and rectsNear(a, b, WaterCfg.ConnectGap) then
				if j == sea then
					return true
				end
				seen[j] = true
				table.insert(queue, j)
			end
		end
	end
	return false
end

-- ── Laws (server copies: idle, Car/Boat fallback; spec §2.1, §2.4, §2.6) ────────────────────────
local function newDriveState(sense: DriveSense): DriveState
	local waterY = sense.WaterY
	return {
		Speed = sense.Velocity:Dot(fwd(sense.Yaw)),
		Heading = sense.Yaw,
		Age = 0,
		SlowFor = 0,
		FlipFor = 0,
		HopLeft = 0,
		BobT = 0,
		LastWaterPos = if waterY ~= nil then sense.Position else nil,
		LastWaterY = waterY,
	}
end

local function throttleSpeed(
	speed: number,
	t: number,
	maxSpeed: number,
	rev: number,
	accel: number,
	brake: number,
	coast: number,
	revAccelFrac: number,
	dt: number
): number
	if t > 0.05 then
		if speed < 0 then
			return approach(speed, 0, brake, dt)
		end
		return approach(speed, t * maxSpeed, accel, dt)
	elseif t < -0.05 then
		if speed > 0 then
			return approach(speed, 0, brake, dt)
		end
		return approach(speed, t * rev, accel * revAccelFrac, dt)
	end
	return approach(speed, 0, coast, dt)
end

-- Pushed against a wall: commanded speed follows the real speed instead of winding up.
local function speedResync(state: DriveState, forwardActual: number, gap: number, dt: number)
	if state.Age < ResyncCfg.GraceSeconds then
		state.SlowFor = 0
		return
	end
	if forwardActual < state.Speed - gap then
		state.SlowFor += dt
		if state.SlowFor >= ResyncCfg.Seconds then
			state.Speed = forwardActual + gap
			state.SlowFor = 0
		end
	else
		state.SlowFor = 0
	end
end

local function carStep(state: DriveState, p: DriveParams, input: DriveInput, sense: DriveSense, dt: number): DriveOut
	dt = math.clamp(dt, 0, 0.1)
	state.Age += dt
	local c = if p.Tracked then CarCfg.Tracked else CarCfg.Wheeled
	local maxS = p.MaxSpeed
	local rev = maxS * CarCfg.ReverseFrac
	local t, s = unitInput(input.Throttle), unitInput(input.Steer)
	speedResync(state, sense.Velocity:Dot(fwd(state.Heading)), ResyncCfg.CarGap, dt)
	state.Speed = throttleSpeed(state.Speed, t, maxS, rev, p.Accel, c.Brake, c.Coast, CarCfg.ReverseAccelFrac, dt)
	state.Speed = math.clamp(state.Speed, -rev, maxS)
	local dir = if state.Speed < -0.5 then -1 else 1
	state.Heading -= s * p.TurnRate * math.clamp(math.abs(state.Speed) / CarCfg.TurnSpeedRef, c.MinTurnFactor, 1) * dir * dt
	if math.abs(wrapAngle(sense.Yaw - state.Heading)) > CarCfg.YawResyncRad then
		state.Heading = sense.Yaw -- a collision spun us: stop fighting it
	end
	local r = right(state.Heading)
	local lat = sense.Velocity:Dot(r) * math.exp(-c.Grip * dt)
	local vel = fwd(state.Heading) * state.Speed + r * lat
	local hold = false
	if sense.UpY < CarCfg.FlipUpY then
		state.FlipFor += dt
		if state.FlipFor >= CarCfg.FlipSeconds then
			state.FlipFor = 0
			state.HopLeft = CarCfg.HopSeconds
		end
	else
		state.FlipFor = 0
	end
	if state.HopLeft > 0 then
		state.HopLeft -= dt
		vel = Vector3.new(vel.X, CarCfg.HopSpeed, vel.Z)
		hold = true
	end
	return {
		Velocity = vel,
		HoldVertical = hold,
		Orientation = orient(0, state.Heading, 0),
		Hud = { Speed = math.abs(state.Speed) },
	}
end

-- Shore probes: the client calls this BEFORE building sense (WaterNear / WaterFar).
local function boatProbe(state: DriveState, p: DriveParams, input: DriveInput): (number, number, number)
	local t = unitInput(input.Throttle)
	local dir = if state.Speed < -0.5 or (state.Speed <= 0 and t < 0) then -1 else 1
	local near = p.HalfLength + BoatCfg.ShoreMargin
	local far = near + state.Speed * state.Speed / (2 * BoatCfg.ShoreBrake) + 2
	return dir, near, far
end

local function boatStep(state: DriveState, p: DriveParams, input: DriveInput, sense: DriveSense, dt: number): DriveOut
	dt = math.clamp(dt, 0, 0.1)
	state.Age += dt
	local maxS = p.MaxSpeed
	local rev = maxS * BoatCfg.ReverseFrac
	local t, s = unitInput(input.Throttle), unitInput(input.Steer)
	speedResync(state, sense.Velocity:Dot(fwd(state.Heading)), ResyncCfg.Gap, dt)
	local dir = boatProbe(state, p, input)
	local before = state.Speed
	state.Speed = throttleSpeed(state.Speed, t, maxS, rev, p.Accel, BoatCfg.Brake, BoatCfg.Coast, BoatCfg.ReverseAccelFrac, dt)
	state.Speed = math.clamp(state.Speed, -rev, maxS)
	if sense.WaterNear == false then
		-- hard stop: no throttle into the shore
		state.Speed = if dir > 0 then math.min(state.Speed, 0) else math.max(state.Speed, 0)
	elseif sense.WaterFar == false then
		-- brake before the shore; throttle never adds speed toward it meanwhile
		local base = if math.abs(state.Speed) > math.abs(before) then before else state.Speed
		state.Speed = approach(base, 0, BoatCfg.ShoreBrake, dt)
	end
	state.Heading -= s * p.TurnRate * math.clamp(math.abs(state.Speed) / BoatCfg.TurnSpeedRef, BoatCfg.MinTurnFactor, 1) * dir * dt
	local pos = sense.Position
	local vel: Vector3
	local hold = true
	local tag: string? = nil
	local waterY = sense.WaterY
	if waterY == nil then
		-- pushed aground: head back to the last water position
		tag = "AGROUND"
		state.Speed = 0
		local lw, lwy = state.LastWaterPos, state.LastWaterY
		if lw ~= nil and lwy ~= nil then
			local d = Vector3.new(lw.X - pos.X, 0, lw.Z - pos.Z)
			local horiz = if d.Magnitude > 1e-4 then d.Unit * BoatCfg.AgroundSpeed else Vector3.zero
			local vy = math.clamp((lwy + p.RideOffset - pos.Y) * BoatCfg.HeightGain, -BoatCfg.MaxVy, BoatCfg.MaxVy)
			vel = horiz + Vector3.new(0, vy, 0)
		else
			vel = Vector3.zero
			hold = false
		end
	else
		state.LastWaterPos = pos
		state.LastWaterY = waterY
		state.BobT += dt
		local rideY = waterY + p.RideOffset + BoatCfg.BobAmp * 0.5 * (1 + math.sin(2 * math.pi * BoatCfg.BobHz * state.BobT))
		local vy = math.clamp((rideY - pos.Y) * BoatCfg.HeightGain, -BoatCfg.MaxVy, BoatCfg.MaxVy)
		local r = right(state.Heading)
		local lat = sense.Velocity:Dot(r) * math.exp(-BoatCfg.Drift * dt)
		vel = fwd(state.Heading) * state.Speed + r * lat + Vector3.new(0, vy, 0)
	end
	local ratio = if maxS > 0 then state.Speed / maxS else 0
	local bob = state.BobT
	local orientation = CFrame.fromEulerAnglesYXZ(
		math.rad(ratio * BoatCfg.BowUpDeg + BoatCfg.BobPitchDeg * math.sin(math.pi * bob)),
		state.Heading,
		math.rad(-s * math.clamp(ratio, 0, 1) * BoatCfg.TurnLeanDeg + BoatCfg.BobRollDeg * math.sin(2 * math.pi * BoatCfg.BobRollHz * bob + 1))
	)
	return { Velocity = vel, HoldVertical = hold, Orientation = orientation, Hud = { Speed = math.abs(state.Speed), Tag = tag } }
end

-- Idle law (no driver, or a correction hold). Spec §2.6.
local function idleTarget(mode: string, p: DriveParams, idle: IdleState, sense: DriveSense, dt: number): DriveOut
	local pos = sense.Position
	local level = orient(0, sense.Yaw, 0)
	local hud = { Speed = flat(sense.Velocity).Magnitude }
	if mode == "Heli" then
		if sense.AGL > HeliCfg.IdleLandAGL then
			return { Velocity = Vector3.new(0, -HeliCfg.IdleSink, 0), HoldVertical = true, Orientation = level, Hud = hud }
		end
		return { Velocity = Vector3.zero, HoldVertical = false, Orientation = level, Hud = hud }
	elseif mode == "Plane" then
		if sense.AGL > PlaneCfg.IdleGlideAGL then
			local look = fwd(sense.Yaw)
			local current: number = idle.GlideSpeed or math.max(0, sense.Velocity:Dot(look))
			local speed = math.max(PlaneCfg.IdleGlideMinSpeed, current - PlaneCfg.IdleGlideDecel * dt)
			idle.GlideSpeed = speed
			return {
				Velocity = look * speed + Vector3.new(0, -PlaneCfg.IdleGlideSink, 0),
				HoldVertical = true,
				Orientation = orient(PlaneCfg.IdleGlidePitch, sense.Yaw, 0),
				Hud = hud,
			}
		end
		idle.GlideSpeed = nil
		return { Velocity = Vector3.zero, HoldVertical = false, Orientation = level, Hud = hud }
	elseif mode == "Boat" then
		local waterY = sense.WaterY
		if waterY ~= nil then
			idle.LastWaterPos = pos
			idle.LastWaterY = waterY
			local vy = math.clamp((waterY + p.RideOffset - pos.Y) * BoatCfg.IdleHeightGain, -BoatCfg.IdleMaxVy, BoatCfg.IdleMaxVy)
			local h = flat(sense.Velocity)
			local current: number = idle.Speed or h.Magnitude
			local dir: Vector3 = idle.Dir or (if h.Magnitude > 0.05 then h.Unit else Vector3.zero)
			local speed = approach(current, 0, BoatCfg.IdleDecel, dt)
			idle.Speed = speed
			idle.Dir = dir
			return { Velocity = dir * speed + Vector3.new(0, vy, 0), HoldVertical = true, Orientation = level, Hud = hud }
		end
		-- no water under the hull: go back to the last water / valid position
		local target = idle.LastWaterPos or idle.ReturnPos
		local horiz = Vector3.zero
		local vy = 0
		if target then
			local d = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
			if d.Magnitude > 0.05 then
				horiz = d.Unit * math.min(BoatCfg.AgroundSpeed, d.Magnitude * 2)
			end
			local ty = if idle.LastWaterY ~= nil then idle.LastWaterY + p.RideOffset else target.Y
			vy = math.clamp((ty - pos.Y) * BoatCfg.IdleHeightGain, -BoatCfg.IdleMaxVy, BoatCfg.IdleMaxVy)
		end
		return { Velocity = horiz + Vector3.new(0, vy, 0), HoldVertical = true, Orientation = level, Hud = hud }
	end
	-- Car: parking brake, level at the current heading
	return { Velocity = Vector3.zero, HoldVertical = false, Orientation = level, Hud = hud }
end

-- ── Drive attributes / footprint / movers ──────────────────────────────────────────────────────
local function driveModeFor(def: VehicleDef): string
	local cat = def.Category or "Ground"
	if cat == "Air" then
		local fam = def.KitFamily or ""
		if string.sub(fam, 1, 3) == "Jet" then
			return "Plane"
		end
		return "Heli"
	elseif cat == "Naval" then
		return "Boat"
	end
	return "Car"
end

local function footprintOf(model: Model): Footprint
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis")
	local ccf = if chassis and chassis:IsA("BasePart") then chassis.CFrame else model:GetPivot()
	local hx, hz, low, top = 0, 0, 0, 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			local cf = d.CFrame
			local s = d.Size * 0.5
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local lp = ccf:PointToObjectSpace(cf * Vector3.new(s.X * sx, s.Y * sy, s.Z * sz))
						hx = math.max(hx, math.abs(lp.X))
						hz = math.max(hz, math.abs(lp.Z))
						low = math.min(low, lp.Y)
						top = math.max(top, lp.Y)
					end
				end
			end
		end
	end
	return { HalfX = hx, HalfZ = hz, Clearance = -low, Top = top }
end

local function driveAttributes(def: VehicleDef, fp: Footprint, bonus: number?, armorMult: number?): { [string]: any }
	local mode = driveModeFor(def)
	local b = math.clamp(tonumber(bonus) or 1, 1, Drive.MaxResearchSpeedBonus)
	local a: { [string]: any } = {
		WE_DriveMode = mode,
		WE_ProtocolVersion = Drive.ProtocolVersion,
		WE_GroundClearance = fp.Clearance,
		WE_HalfLength = fp.HalfZ,
		WE_HalfWidth = fp.HalfX,
		WE_ArmorMult = math.clamp(tonumber(armorMult) or 1, 1, Drive.MaxResearchArmorBonus),
	}
	local base: number
	if mode == "Car" then
		local isTracked = string.find(def.KitFamily or "", "Tracked") ~= nil
		local c = if isTracked then CarCfg.Tracked else CarCfg.Wheeled
		base = if isTracked
			then math.clamp(def.Speed, CarCfg.TrackedMinSpeed, CarCfg.TrackedMaxSpeed)
			else math.max(def.Speed, CarCfg.WheeledMinSpeed)
		a.WE_Accel = c.Accel
		a.WE_TurnRate = c.TurnRate
		a.WE_Tracked = isTracked
	elseif mode == "Heli" then
		base = def.Speed
		a.WE_Accel = HeliCfg.Accel
		a.WE_TurnRate = HeliCfg.TurnRate
		a.WE_ClimbRate = HeliCfg.ClimbRate
		a.WE_MaxAltitude = HeliCfg.MaxAltitude
	elseif mode == "Plane" then
		base = def.Speed
		local vto = math.clamp(PlaneCfg.TakeoffFrac * def.Speed, PlaneCfg.TakeoffMin, PlaneCfg.TakeoffMax)
		a.WE_Accel = PlaneCfg.Thrust
		a.WE_TurnRate = PlaneCfg.TurnRate
		a.WE_MaxAltitude = PlaneCfg.MaxAltitude
		a.WE_TakeoffSpeed = vto
		a.WE_StallSpeed = PlaneCfg.StallFrac * vto
	else
		base = def.Speed
		a.WE_Accel = BoatCfg.Accel
		a.WE_TurnRate = BoatCfg.TurnRate
		a.WE_RideOffset = fp.Clearance - BoatCfg.Draft
	end
	a.WE_BaseMaxSpeed = base
	a.WE_MaxSpeed = base * b
	return a
end

local function moverTuning(mode: string): (number, number, number, number)
	if mode == "Heli" then
		return HeliCfg.ForcePerMass, HeliCfg.TorqueScale, HeliCfg.Responsiveness, HeliCfg.MaxAngularVelocity
	elseif mode == "Plane" then
		return PlaneCfg.ForcePerMass, PlaneCfg.TorqueScale, PlaneCfg.Responsiveness, PlaneCfg.MaxAngularVelocity
	elseif mode == "Boat" then
		return BoatCfg.ForcePerMass, BoatCfg.TorqueScale, BoatCfg.Responsiveness, BoatCfg.MaxAngularVelocity
	end
	return CarCfg.ForcePerMass, CarCfg.TorqueScale, CarCfg.Responsiveness, CarCfg.MaxAngularVelocity
end

local function estimateMass(model: Model): number
	local m = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Massless then
			local ok, pm = pcall(function(): number
				return d:GetMass()
			end)
			if ok and typeof(pm) == "number" then
				m += pm
			end
		end
	end
	return math.max(m, 1)
end

-- F = (mass + 20 x seats) x ForcePerMass; MaxTorque = mass x |Chassis.Size|² x TorqueScale.
local function setMoverLimits(lv: LinearVelocity, ao: AlignOrientation, chassis: BasePart, mode: string, seats: number, mass: number, holdVertical: boolean): number
	local forcePerMass, torqueScale, responsiveness, maxAngular = moverTuning(mode)
	local force = (mass + Drive.SeatMassAllowance * math.max(1, seats)) * forcePerMass
	lv.MaxAxesForce = Vector3.new(force, if holdVertical then force else 0, force)
	local sizeMag = chassis.Size.Magnitude
	ao.MaxTorque = mass * sizeMag * sizeMag * torqueScale
	ao.Responsiveness = responsiveness
	ao.MaxAngularVelocity = maxAngular
	return force
end

local function createMovers(model: Model, chassis: BasePart, def: VehicleDef, mode: string)
	local attach = Instance.new("Attachment")
	attach.Name = "WE_DriveAttach"
	attach.CFrame = CFrame.new()
	attach.Parent = chassis
	local lv = Instance.new("LinearVelocity")
	lv.Name = "WE_DriveLV"
	lv.Attachment0 = attach
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.ForceLimitsEnabled = true
	lv.VectorVelocity = Vector3.zero
	lv.Parent = chassis
	local ao = Instance.new("AlignOrientation")
	ao.Name = "WE_DriveAO"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.AlignType = Enum.AlignType.AllAxes
	ao.PrimaryAxisOnly = false
	ao.Attachment0 = attach
	ao.RigidityEnabled = false
	ao.CFrame = chassis.CFrame.Rotation
	ao.Parent = chassis
	-- Fy starts at F only for boats (planes that start in the air get it at spawn)
	setMoverLimits(lv, ao, chassis, mode, def.Seats or 1, estimateMass(model), mode == "Boat")
end

local function weldTo(body: BasePart, other: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = other
	w.Parent = body
end

local function addPart(
	model: Model,
	body: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?,
	collide: boolean?
): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	p.CFrame = body.CFrame * offset
	p.Anchored = false
	p.CanCollide = if collide == nil then false else collide
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	weldTo(body, p)
	return p
end

local function addWheels(model: Model, body: BasePart, scale: number, positions: { Vector3 }, radius: number?)
	-- Physics wheels on HingeConstraints (NOT welded). v70: free-rolling (ActuatorType None) — the
	-- WE_DriveLV / WE_DriveAO movers carry the vehicle, so nothing fights the drive.
	-- Catalog mesh wheels stay cosmetic-only via VisualAssetService (CanCollide false).
	-- Cylinder PartType axis is local X (= axle). Do NOT Z-rotate 90° (that stood the can on end).
	local r = radius or 1.1
	for i, offset in ipairs(positions) do
		local wheel = Instance.new("Part")
		wheel.Name = "Wheel" .. i
		wheel.Shape = Enum.PartType.Cylinder
		-- Thin in X (axle/width), diameter in Y/Z — axle already along body X with identity rot
		wheel.Size = Vector3.new(r * 0.85, r * 1.8 * scale, r * 1.8 * scale)
		wheel.Color = Color3.fromRGB(22, 22, 24)
		wheel.Material = Enum.Material.SmoothPlastic
		wheel.CFrame = body.CFrame * CFrame.new(offset * scale)
		wheel.Anchored = false
		wheel.CanCollide = true
		wheel.Massless = false
		-- v70 verifier: LOW friction. The axles are fixed, so yawing drags every wheel sideways; at friction 2.0
		-- that drag (mu x load x |wheel Z|) was 1.1-3.3x the WE_DriveAO torque and cars / tanks could not turn.
		-- Sideways grip comes from the law (Grip term through WE_DriveLV), not from the tyres.
		wheel.CustomPhysicalProperties =
			PhysicalProperties.new(0.9, CarCfg.WheelFriction, 0.1, CarCfg.WheelFrictionWeight, 1)
		wheel:SetAttribute("WE_PhysicsWheel", true)
		wheel.Parent = model

		local att0 = Instance.new("Attachment")
		att0.Name = "WE_WheelAttBody" .. i
		-- Identity → Attachment.Axis (1,0,0) = body right = axle
		att0.CFrame = CFrame.new(offset * scale)
		att0.Parent = body

		local att1 = Instance.new("Attachment")
		att1.Name = "WE_WheelAtt" .. i
		att1.CFrame = CFrame.new() -- wheel local X = axle
		att1.Parent = wheel

		local hinge = Instance.new("HingeConstraint")
		hinge.Name = "WE_DriveHinge" .. i
		hinge.Attachment0 = att0
		hinge.Attachment1 = att1
		hinge.ActuatorType = Enum.ActuatorType.None
		hinge:SetAttribute("WE_DriveHinge", true)
		hinge:SetAttribute("WE_WheelSide", if offset.X < 0 then -1 else 1)
		hinge.Parent = wheel
		-- v70 judge: hinge-joined parts are separate assemblies and DO collide; every kit's wheels sit
		-- 0.15-1.3 studs inside the Chassis, so the hinge and the contact fought forever (jitter, locked wheels, flings).
		local nc = Instance.new("NoCollisionConstraint")
		nc.Name = "WE_WheelNoCollide" .. i
		nc.Part0 = body
		nc.Part1 = wheel
		nc.Parent = wheel

		local hub = Instance.new("Part")
		hub.Name = "Hub" .. i
		hub.Shape = Enum.PartType.Cylinder
		hub.Size = Vector3.new(r * 0.35, r * 0.7 * scale, r * 0.7 * scale)
		hub.Color = Color3.fromRGB(90, 95, 100)
		hub.Material = Enum.Material.Metal
		hub.CFrame = wheel.CFrame
		hub.Anchored = false
		hub.CanCollide = false
		hub.Massless = true
		hub.Parent = model
		local hubWeld = Instance.new("WeldConstraint")
		hubWeld.Part0 = wheel
		hubWeld.Part1 = hub
		hubWeld.Parent = hub
	end
end

-- Visual kits v2 shared accents (keep part counts modest)
local function addHeadlights(model: Model, body: BasePart, s: number, zFront: number, y: number, spacing: number, col: Color3?)
	local c = col or Color3.fromRGB(255, 240, 180)
	addPart(model, body, "LightL", Vector3.new(0.45 * s, 0.35 * s, 0.35 * s), CFrame.new(-spacing * s, y * s, zFront * s), c, Enum.Material.Neon, nil, false)
	addPart(model, body, "LightR", Vector3.new(0.45 * s, 0.35 * s, 0.35 * s), CFrame.new(spacing * s, y * s, zFront * s), c, Enum.Material.Neon, nil, false)
end

local function addTaillights(model: Model, body: BasePart, s: number, zRear: number, y: number, spacing: number)
	local c = Color3.fromRGB(220, 50, 40)
	addPart(model, body, "TailL", Vector3.new(0.4 * s, 0.3 * s, 0.25 * s), CFrame.new(-spacing * s, y * s, zRear * s), c, Enum.Material.Neon, nil, false)
	addPart(model, body, "TailR", Vector3.new(0.4 * s, 0.3 * s, 0.25 * s), CFrame.new(spacing * s, y * s, zRear * s), c, Enum.Material.Neon, nil, false)
end

local function addExhaust(model: Model, body: BasePart, s: number, offset: CFrame, accent: Color3)
	addPart(model, body, "Exhaust", Vector3.new(0.35 * s, 0.35 * s, 1.4 * s), offset, Color3.fromRGB(35, 35, 38), Enum.Material.Metal, Enum.PartType.Cylinder, false)
	addPart(model, body, "ExhaustGlow", Vector3.new(0.28 * s, 0.28 * s, 0.35 * s), offset * CFrame.new(0, 0, 0.7 * s), accent, Enum.Material.Neon, Enum.PartType.Cylinder, false)
end

local function addRotorDisc(model: Model, body: BasePart, s: number, y: number, radius: number, accent: Color3)
	-- Thin neon disc under rotor (silhouette read at distance)
	local disc = addPart(
		model,
		body,
		"RotorDisc",
		Vector3.new(0.08 * s, radius * 2 * s, radius * 2 * s),
		CFrame.new(0, y * s, -0.3 * s) * CFrame.Angles(0, 0, math.rad(90)),
		accent,
		Enum.Material.Neon,
		Enum.PartType.Cylinder,
		false
	)
	disc.Transparency = 0.55
end

local function addWakeStrip(model: Model, body: BasePart, s: number, length: number, accent: Color3)
	addPart(model, body, "WakeNeon", Vector3.new(0.35 * s, 0.12 * s, length * s), CFrame.new(0, -0.7 * s, 0.5 * s), accent, Enum.Material.Neon, nil, false)
end

local function addSideRails(model: Model, body: BasePart, s: number, length: number, height: number, width: number, color: Color3)
	addPart(model, body, "RailL", Vector3.new(0.2 * s, 0.25 * s, length * s), CFrame.new(-width * s, height * s, 0), color, Enum.Material.Metal, nil, false)
	addPart(model, body, "RailR", Vector3.new(0.2 * s, 0.25 * s, length * s), CFrame.new(width * s, height * s, 0), color, Enum.Material.Metal, nil, false)
end

local function buildVehicleModel(def: VehicleDef, at: CFrame, ownerUserId: number, bonus: number?, armorMult: number?): Model
	local model = Instance.new("Model")
	model.Name = def.DisplayName
	model:SetAttribute("VehicleId", def.Id)
	model:SetAttribute("OwnerUserId", ownerUserId)

	local id = def.Id
	local family = def.KitFamily or "WheeledLight"
	local scale = if typeof(def.KitScale) == "number" then def.KitScale :: number else 1
	local olive = Color3.fromRGB(55, 70, 48)
	local oliveDark = Color3.fromRGB(40, 50, 38)
	local armor = Color3.fromRGB(62, 68, 55)
	local armorDark = Color3.fromRGB(45, 50, 42)
	local sand = Color3.fromRGB(110, 100, 70)
	local accent = Color3.fromRGB(230, 190, 60)
	local blueAcc = Color3.fromRGB(90, 160, 220)
	local redAcc = Color3.fromRGB(200, 80, 60)
	local sky = Color3.fromRGB(70, 90, 110)
	local rarity = def.Rarity or "Common"
	local accentCol = if rarity == "Legendary"
		then redAcc
		elseif rarity == "Epic" then accent
		elseif rarity == "Rare" then blueAcc
		else accent

	local body = Instance.new("Part")
	body.Name = "Chassis"
	body.Anchored = false
	body.CanCollide = true
	body.Material = Enum.Material.Metal
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.CFrame = at
	body.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0.2, 1, 1)
	body.Parent = model

	local seatOffset = CFrame.new(0, 2.0, -0.5)
	local labelY = 4.5
	local s = scale

	local function kitWheeledLight()
		local armed = id == "ArmedJeep"
		local scout = id == "ScoutCar" or id == "ReconBuggy"
		local quad = id == "UtilityQuad"
		body.Size = Vector3.new(5.2 * s, 1.6 * s, if quad then 6.5 * s else 8.5 * s)
		body.Color = if armed then Color3.fromRGB(48, 58, 42) elseif scout then Color3.fromRGB(70, 85, 55) else olive
		addPart(model, body, "Hood", Vector3.new(4.6 * s, 0.7 * s, 2.8 * s), CFrame.new(0, 0.9 * s, -2.4 * s), oliveDark, Enum.Material.Metal, nil, false)
		addPart(model, body, "Cabin", Vector3.new(4.4 * s, 1.4 * s, 2.8 * s), CFrame.new(0, 1.3 * s, 0.2 * s), oliveDark, Enum.Material.SmoothPlastic, nil, true)
		if not quad then
			addPart(model, body, "Bed", Vector3.new(4.4 * s, 0.9 * s, 2.6 * s), CFrame.new(0, 0.7 * s, 2.6 * s), olive, Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Bumper", Vector3.new(5.0 * s, 0.5 * s, 0.4 * s), CFrame.new(0, -0.3 * s, -4.0 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
		-- Olive metal trim (no neon green/gold until mesh loads)
		addPart(model, body, "AccentStrip", Vector3.new(4.8 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.1 * s, -1.2 * s), if armed then Color3.fromRGB(90, 55, 45) else oliveDark, Enum.Material.Metal, nil, false)
		if armed then
			addPart(model, body, "GunMount", Vector3.new(0.8 * s, 0.8 * s, 0.8 * s), CFrame.new(0, 2.2 * s, 0.4 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			addPart(model, body, "Barrel", Vector3.new(0.25 * s, 0.25 * s, 2.4 * s), CFrame.new(0, 2.5 * s, -1.0 * s), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, false)
		end
		addWheels(model, body, s, {
			Vector3.new(-2.4, -0.9, 2.6),
			Vector3.new(2.4, -0.9, 2.6),
			Vector3.new(-2.4, -0.9, -2.6),
			Vector3.new(2.4, -0.9, -2.6),
		}, 1.05)
		addHeadlights(model, body, s, -4.1, 0.2, 1.8)
		addTaillights(model, body, s, if quad then 3.0 else 4.0, 0.15, 1.9)
		addExhaust(model, body, s, CFrame.new(1.8 * s, -0.2 * s, 3.2 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(50, 55, 45))
		addSideRails(model, body, s, if quad then 4.5 else 5.5, 0.6, 2.5, oliveDark)
		seatOffset = CFrame.new(0, 1.9 * s, 0.1 * s)
		labelY = 4.2 * s
	end

	local function kitWheeledTruck()
		local supply = id == "SupplyTruck"
		local fuel = id == "FuelTanker"
		local missile = id == "MissileTruck" or id == "AntiAirTruck"
		local eng = id == "EngineeringTruck"
		body.Size = Vector3.new(6.2 * s, 2.4 * s, 11 * s)
		body.Color = if supply then sand elseif fuel then Color3.fromRGB(90, 95, 55) else armor
		addPart(model, body, "Cabin", Vector3.new(5.6 * s, 2.0 * s, 3.2 * s), CFrame.new(0, 1.6 * s, -3.2 * s), armorDark, Enum.Material.Metal, nil, true)
		addPart(model, body, "Cargo", Vector3.new(5.8 * s, 2.6 * s, 6.5 * s), CFrame.new(0, 1.4 * s, 2.0 * s), if supply then Color3.fromRGB(130, 115, 75) elseif fuel then Color3.fromRGB(70, 80, 45) else sand, Enum.Material.Metal, nil, true)
		addPart(model, body, "Accent", Vector3.new(5.9 * s, 0.15 * s, 0.4 * s), CFrame.new(0, 2.5 * s, -2.0 * s), accentCol, Enum.Material.Neon, nil, false)
		if supply then
			addPart(model, body, "Crate", Vector3.new(3.5 * s, 1.4 * s, 3.5 * s), CFrame.new(0, 3.0 * s, 2.0 * s), Color3.fromRGB(90, 75, 50), Enum.Material.Wood, nil, false)
		elseif fuel then
			addPart(model, body, "Tank", Vector3.new(4.5 * s, 2.2 * s, 5.5 * s), CFrame.new(0, 2.8 * s, 2.0 * s), Color3.fromRGB(80, 85, 50), Enum.Material.Metal, Enum.PartType.Cylinder, false)
		elseif missile then
			addPart(model, body, "Launcher", Vector3.new(4.0 * s, 1.2 * s, 5.0 * s), CFrame.new(0, 3.0 * s, 1.5 * s) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(50, 55, 45), Enum.Material.Metal, nil, false)
		elseif eng then
			addPart(model, body, "Crane", Vector3.new(0.5 * s, 4.0 * s, 0.5 * s), CFrame.new(1.5 * s, 4.0 * s, 1.0 * s), Color3.fromRGB(200, 160, 60), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Bumper", Vector3.new(6.0 * s, 0.55 * s, 0.45 * s), CFrame.new(0, -0.6 * s, -5.2 * s), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil, false)
		addWheels(model, body, 1.15 * s, {
			Vector3.new(-2.8, -1.2, 3.5),
			Vector3.new(2.8, -1.2, 3.5),
			Vector3.new(-2.8, -1.2, 0),
			Vector3.new(2.8, -1.2, 0),
			Vector3.new(-2.8, -1.2, -3.5),
			Vector3.new(2.8, -1.2, -3.5),
		}, 1.2)
		addHeadlights(model, body, s, -5.3, 0.4, 2.2)
		addTaillights(model, body, s, 5.2, 0.3, 2.4)
		addExhaust(model, body, s, CFrame.new(2.4 * s, -0.4 * s, 4.5 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		seatOffset = CFrame.new(0, 2.4 * s, -3.0 * s)
		labelY = 5.5 * s
	end

	local function kitWheeledAPC()
		local carrier = id == "InfantryCarrier"
		local cmd = id == "CommandVehicle"
		body.Size = Vector3.new((if carrier then 7.2 else 6.5) * s, 2.6 * s, (if carrier then 12 else 10.5) * s)
		body.Color = armorDark
		addPart(model, body, "HullTop", Vector3.new(5.8 * s, 1.4 * s, 8.5 * s), CFrame.new(0, 1.8 * s, 0), armor, Enum.Material.Metal, nil, true)
		addPart(model, body, "Turret", Vector3.new(2.4 * s, 1.2 * s, 2.4 * s), CFrame.new(0, 3.0 * s, 0.5 * s), Color3.fromRGB(50, 55, 48), Enum.Material.Metal, nil, false)
		addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 3.2 * s), CFrame.new(0, 3.1 * s, -2.0 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		addPart(model, body, "Accent", Vector3.new(6.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 2.6 * s, -3 * s), accentCol, Enum.Material.Neon, nil, false)
		if cmd then
			addPart(model, body, "Dish", Vector3.new(2.2 * s, 0.3 * s, 2.2 * s), CFrame.new(0, 4.0 * s, 1.5 * s), Color3.fromRGB(80, 90, 100), Enum.Material.Metal, Enum.PartType.Cylinder, false)
		end
		addPart(model, body, "Bumper", Vector3.new(6.2 * s, 0.6 * s, 0.5 * s), CFrame.new(0, -0.7 * s, -5.0 * s), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, false)
		addWheels(model, body, 1.2 * s, {
			Vector3.new(-3.0, -1.3, 3.2),
			Vector3.new(3.0, -1.3, 3.2),
			Vector3.new(-3.0, -1.3, 0.5),
			Vector3.new(3.0, -1.3, 0.5),
			Vector3.new(-3.0, -1.3, -2.5),
			Vector3.new(3.0, -1.3, -2.5),
		}, 1.25)
		addHeadlights(model, body, s, -5.1, 0.2, 2.4)
		addTaillights(model, body, s, 4.8, 0.2, 2.5)
		addExhaust(model, body, s, CFrame.new(2.8 * s, 0.2 * s, 4.0 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		seatOffset = CFrame.new(0, 2.2 * s, -2.5 * s)
		labelY = 5.8 * s
	end

	local function kitTracked(kind: string)
		local isSPAAG = kind == "SPAAG"
		local isArty = kind == "Artillery"
		local isIFV = kind == "IFV"
		body.Size = Vector3.new(6.5 * s, 2.2 * s, 9.5 * s)
		body.Color = if s >= 1.4 then Color3.fromRGB(45, 48, 40) else armor
		addPart(model, body, "TrackL", Vector3.new(1.2 * s, 1.6 * s, 9 * s), CFrame.new(-3.2 * s, -0.4 * s, 0), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, true)
		addPart(model, body, "TrackR", Vector3.new(1.2 * s, 1.6 * s, 9 * s), CFrame.new(3.2 * s, -0.4 * s, 0), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, true)
		if isSPAAG then
			addPart(model, body, "Turret", Vector3.new(3.2 * s, 1.4 * s, 3.2 * s), CFrame.new(0, 2.0 * s, 0), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "BarrelA", Vector3.new(0.3 * s, 0.3 * s, 4.5 * s), CFrame.new(-0.6 * s, 2.4 * s, -3.0 * s) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			addPart(model, body, "BarrelB", Vector3.new(0.3 * s, 0.3 * s, 4.5 * s), CFrame.new(0.6 * s, 2.4 * s, -3.0 * s) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		elseif isArty then
			local rocket = id == "RocketArtillery"
			addPart(model, body, "Turret", Vector3.new(3.4 * s, 1.5 * s, 3.8 * s), CFrame.new(0, 1.9 * s, 0.8 * s), armorDark, Enum.Material.Metal, nil, true)
			if rocket then
				addPart(model, body, "Pod", Vector3.new(3.0 * s, 1.8 * s, 4.5 * s), CFrame.new(0, 3.2 * s, 0.5 * s) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(55, 60, 50), Enum.Material.Metal, nil, false)
			else
				addPart(model, body, "Barrel", Vector3.new(0.5 * s, 0.5 * s, 7 * s), CFrame.new(0, 2.8 * s, -3.5 * s) * CFrame.Angles(math.rad(-15), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			end
		elseif isIFV then
			addPart(model, body, "HullTop", Vector3.new(5.5 * s, 1.2 * s, 7.5 * s), CFrame.new(0, 1.7 * s, 0), armor, Enum.Material.Metal, nil, true)
			addPart(model, body, "Turret", Vector3.new(2.8 * s, 1.3 * s, 3.0 * s), CFrame.new(0, 2.8 * s, 0.3 * s), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 4.2 * s), CFrame.new(0, 2.9 * s, -2.5 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		else
			addPart(model, body, "Turret", Vector3.new(3.6 * s, 1.6 * s, 4.2 * s), CFrame.new(0, 2.0 * s, 0.3 * s), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "Barrel", Vector3.new(0.45 * s, 0.45 * s, 5.5 * s), CFrame.new(0, 2.1 * s, -4.2 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Accent", Vector3.new(3.2 * s, 0.12 * s, 0.3 * s), CFrame.new(0, 2.9 * s, 1.2 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "Mantlet", Vector3.new(2.2 * s, 1.0 * s, 0.6 * s), CFrame.new(0, 2.1 * s, -1.6 * s), armorDark, Enum.Material.Metal, nil, false)
		addHeadlights(model, body, s, -4.6, 0.4, 2.2, Color3.fromRGB(255, 230, 160))
		addExhaust(model, body, s, CFrame.new(2.6 * s, 0.8 * s, 4.0 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		-- v36: hinged road wheels → same WE_GroundDrive LV+HingeMotor path as MilitaryJeep (tracks are dress skirts)
		local trackL = model:FindFirstChild("TrackL")
		local trackR = model:FindFirstChild("TrackR")
		if trackL and trackL:IsA("BasePart") then
			trackL.CanCollide = false
		end
		if trackR and trackR:IsA("BasePart") then
			trackR.CanCollide = false
		end
		addWheels(model, body, s, {
			Vector3.new(-3.2, -1.0, 3.2),
			Vector3.new(3.2, -1.0, 3.2),
			Vector3.new(-3.2, -1.0, 1.0),
			Vector3.new(3.2, -1.0, 1.0),
			Vector3.new(-3.2, -1.0, -1.2),
			Vector3.new(3.2, -1.0, -1.2),
			Vector3.new(-3.2, -1.0, -3.2),
			Vector3.new(3.2, -1.0, -3.2),
		}, 0.9)
		seatOffset = CFrame.new(0, 2.6 * s, 0.2 * s)
		labelY = 5.5 * s
	end

	local function kitHeli(kind: string)
		local attack = kind == "Attack"
		local light = kind == "Light"
		local transport = kind == "Transport"
		local len = if transport then 12 elseif light then 8.5 else 10
		local wid = if transport then 4.5 elseif light then 2.8 else 3.2
		body.Size = Vector3.new(wid * s, 2.0 * s, len * s)
		body.Color = if id == "StealthHeli" then Color3.fromRGB(25, 30, 38) else sky
		addPart(model, body, "Cockpit", Vector3.new((wid - 0.6) * s, 1.6 * s, 3.2 * s), CFrame.new(0, 0.6 * s, -len * 0.32 * s), Color3.fromRGB(40, 55, 70), Enum.Material.Glass, nil, true)
		if transport then
			addPart(model, body, "Cabin", Vector3.new(4.0 * s, 2.0 * s, 5.5 * s), CFrame.new(0, 0.5 * s, 1.5 * s), sky, Enum.Material.Metal, nil, true)
		end
		addPart(model, body, "Tail", Vector3.new(1.0 * s, 1.0 * s, 5.5 * s), CFrame.new(0, 0.8 * s, len * 0.55 * s), body.Color, Enum.Material.Metal, nil, false)
		addPart(model, body, "TailFin", Vector3.new(0.3 * s, 2.4 * s, 1.6 * s), CFrame.new(0, 2.0 * s, len * 0.72 * s), Color3.fromRGB(50, 65, 80), Enum.Material.Metal, nil, false)
		local rotor = if transport then 16 elseif light then 11 else 14
		addPart(model, body, "RotorHub", Vector3.new(1.2 * s, 0.5 * s, 1.2 * s), CFrame.new(0, 2.0 * s, -0.3 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
		addPart(model, body, "RotorA", Vector3.new(rotor * s, 0.15 * s, 0.6 * s), CFrame.new(0, 2.35 * s, -0.3 * s), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil, false)
		addPart(model, body, "RotorB", Vector3.new(0.6 * s, 0.15 * s, rotor * s), CFrame.new(0, 2.4 * s, -0.3 * s), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil, false)
		addPart(model, body, "SkidL", Vector3.new(0.25 * s, 0.25 * s, 7 * s), CFrame.new(-wid * 0.5 * s, -1.3 * s, 0), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidR", Vector3.new(0.25 * s, 0.25 * s, 7 * s), CFrame.new(wid * 0.5 * s, -1.3 * s, 0), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidPadL", Vector3.new(0.9 * s, 0.2 * s, 1.2 * s), CFrame.new(-wid * 0.5 * s, -1.45 * s, 2 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidPadR", Vector3.new(0.9 * s, 0.2 * s, 1.2 * s), CFrame.new(wid * 0.5 * s, -1.45 * s, 2 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, true)
		addRotorDisc(model, body, s, 2.2, rotor * 0.48, accentCol)
		addPart(model, body, "Accent", Vector3.new((wid - 0.4) * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.2 * s, -1 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "NavLight", Vector3.new(0.35 * s, 0.35 * s, 0.35 * s), CFrame.new(0, 1.6 * s, len * 0.4 * s), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, Enum.PartType.Ball, false)
		if attack then
			addPart(model, body, "StubWingL", Vector3.new(3.5 * s, 0.25 * s, 1.2 * s), CFrame.new(-2.5 * s, 0, 0.5 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, false)
			addPart(model, body, "StubWingR", Vector3.new(3.5 * s, 0.25 * s, 1.2 * s), CFrame.new(2.5 * s, 0, 0.5 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, false)
		end
		seatOffset = CFrame.new(0, 1.2 * s, -2.8 * s)
		labelY = 5.5 * s
	end

	local function kitJet(kind: string)
		local bomber = kind == "Bomber"
		local cargo = kind == "Transport"
		local strike = kind == "Strike"
		local len = if cargo then 16 elseif bomber then 14 else 12
		local wid = if cargo then 3.5 elseif bomber then 2.8 else 2.4
		body.Size = Vector3.new(wid * s, 1.5 * s, len * s)
		body.Color = if cargo then Color3.fromRGB(100, 105, 95) elseif bomber then Color3.fromRGB(70, 75, 80) else Color3.fromRGB(90, 95, 100)
		addPart(model, body, "Nose", Vector3.new((wid - 0.8) * s, 1.0 * s, 3.5 * s), CFrame.new(0, 0.1 * s, -len * 0.48 * s), Color3.fromRGB(70, 75, 80), Enum.Material.Metal, nil, false)
		addPart(model, body, "Cockpit", Vector3.new(1.6 * s, 0.9 * s, 2.2 * s), CFrame.new(0, 0.9 * s, -len * 0.28 * s), Color3.fromRGB(40, 80, 120), Enum.Material.Glass, nil, false)
		local wingSpan = if cargo then 10 elseif bomber then 9 else 7
		addPart(model, body, "WingL", Vector3.new(wingSpan * s, 0.25 * s, 2.8 * s), CFrame.new(-wingSpan * 0.55 * s, 0, 0.5 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		addPart(model, body, "WingR", Vector3.new(wingSpan * s, 0.25 * s, 2.8 * s), CFrame.new(wingSpan * 0.55 * s, 0, 0.5 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		addPart(model, body, "TailFin", Vector3.new(0.25 * s, (if bomber then 3.2 else 2.8) * s, 2.0 * s), CFrame.new(0, 1.8 * s, len * 0.38 * s), Color3.fromRGB(85, 90, 95), Enum.Material.Metal, nil, false)
		if not cargo then
			addPart(model, body, "StabL", Vector3.new(2.5 * s, 0.2 * s, 1.2 * s), CFrame.new(-1.5 * s, 0.8 * s, len * 0.38 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
			addPart(model, body, "StabR", Vector3.new(2.5 * s, 0.2 * s, 1.2 * s), CFrame.new(1.5 * s, 0.8 * s, len * 0.38 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		end
		if strike or kind == "Fighter" then
			addPart(model, body, "IntakeL", Vector3.new(0.9 * s, 0.9 * s, 2.5 * s), CFrame.new(-1.3 * s, -0.2 * s, 1.5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "IntakeR", Vector3.new(0.9 * s, 0.9 * s, 2.5 * s), CFrame.new(1.3 * s, -0.2 * s, 1.5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
		end
		if bomber then
			addPart(model, body, "Bay", Vector3.new((wid - 0.4) * s, 0.8 * s, 4 * s), CFrame.new(0, -0.6 * s, 0.5 * s), Color3.fromRGB(45, 48, 52), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Accent", Vector3.new(2.0 * s, 0.1 * s, 0.3 * s), CFrame.new(0, 0.8 * s, -1 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "EngineGlow", Vector3.new((wid - 0.6) * s, 0.7 * s, 0.5 * s), CFrame.new(0, 0, len * 0.42 * s), accentCol, Enum.Material.Neon, nil, false)
		-- Landing gear: nose wheel + two main wheels at the same height (3-point stance). v70: low
		-- friction (friction weight 100) so the plane slides along the runway under the movers.
		local gearParts = {
			addPart(model, body, "GearF", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(0, -1.0 * s, -len * 0.3 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true),
			addPart(model, body, "WheelF", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(0, -1.5 * s, -len * 0.3 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true),
			addPart(model, body, "GearL", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(-1.5 * s, -1.0 * s, 1 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true),
			addPart(model, body, "GearR", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(1.5 * s, -1.0 * s, 1 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true),
			addPart(model, body, "WheelL", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(-1.5 * s, -1.5 * s, 1 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true),
			addPart(model, body, "WheelR", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(1.5 * s, -1.5 * s, 1 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true),
		}
		for _, g in ipairs(gearParts) do
			g.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.02, 0.1, 100, 1)
		end
		addPart(model, body, "WingTipL", Vector3.new(0.3 * s, 0.3 * s, 0.3 * s), CFrame.new(-wingSpan * 0.95 * s, 0.1 * s, 0.5 * s), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, Enum.PartType.Ball, false)
		addPart(model, body, "WingTipR", Vector3.new(0.3 * s, 0.3 * s, 0.3 * s), CFrame.new(wingSpan * 0.95 * s, 0.1 * s, 0.5 * s), Color3.fromRGB(60, 255, 90), Enum.Material.Neon, Enum.PartType.Ball, false)
		seatOffset = CFrame.new(0, 1.3 * s, -len * 0.26 * s)
		labelY = 4.8 * s
	end

	local function kitNaval(kind: string)
		if kind == "Landing" then
			body.Size = Vector3.new(8 * s, 2.0 * s, 16 * s)
			body.Color = Color3.fromRGB(55, 65, 55)
			addPart(model, body, "Deck", Vector3.new(7.2 * s, 0.5 * s, 13 * s), CFrame.new(0, 1.1 * s, 0.5 * s), Color3.fromRGB(70, 80, 65), Enum.Material.Metal, nil, true)
			addPart(model, body, "Ramp", Vector3.new(6.5 * s, 0.4 * s, 4 * s), CFrame.new(0, 0.6 * s, -7.5 * s) * CFrame.Angles(math.rad(-18), 0, 0), Color3.fromRGB(60, 70, 55), Enum.Material.Metal, nil, true)
			addPart(model, body, "Cabin", Vector3.new(3.5 * s, 2.2 * s, 3.0 * s), CFrame.new(0, 2.3 * s, 5.5 * s), Color3.fromRGB(50, 60, 50), Enum.Material.Metal, nil, true)
			addPart(model, body, "WallL", Vector3.new(0.4 * s, 1.6 * s, 12 * s), CFrame.new(-3.6 * s, 1.6 * s, 0), oliveDark, Enum.Material.Metal, nil, false)
			addPart(model, body, "WallR", Vector3.new(0.4 * s, 1.6 * s, 12 * s), CFrame.new(3.6 * s, 1.6 * s, 0), oliveDark, Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(6.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.6 * s, 4 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 12, accentCol)
			addPart(model, body, "GunMount", Vector3.new(1.2 * s, 0.8 * s, 1.2 * s), CFrame.new(0, 2.6 * s, -2 * s), Color3.fromRGB(40, 45, 40), Enum.Material.Metal, nil, false)
			seatOffset = CFrame.new(0, 3.0 * s, 5.2 * s)
			labelY = 6.0 * s
		elseif kind == "Sub" then
			-- Surface stub: low dark hull (no underwater physics yet)
			body.Size = Vector3.new(5 * s, 2.2 * s, 18 * s)
			body.Color = Color3.fromRGB(30, 40, 48)
			addPart(model, body, "Sail", Vector3.new(1.8 * s, 2.8 * s, 4 * s), CFrame.new(0, 2.4 * s, -1 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new(3.5 * s, 1.6 * s, 4 * s), CFrame.new(0, 0.2 * s, -8 * s), Color3.fromRGB(28, 38, 45), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(4.0 * s, 0.12 * s, 0.3 * s), CFrame.new(0, 1.2 * s, 2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 14, accentCol)
			addPart(model, body, "Periscope", Vector3.new(0.25 * s, 2.2 * s, 0.25 * s), CFrame.new(0, 4.2 * s, -1 * s), Color3.fromRGB(50, 55, 60), Enum.Material.Metal, nil, false)
			seatOffset = CFrame.new(0, 3.5 * s, -1 * s)
			labelY = 6.5 * s
		elseif kind == "Capital" then
			body.Size = Vector3.new(8 * s, 2.4 * s, 28 * s)
			body.Color = Color3.fromRGB(40, 55, 70)
			addPart(model, body, "Deck", Vector3.new(7.2 * s, 0.5 * s, 24 * s), CFrame.new(0, 1.3 * s, 0), Color3.fromRGB(50, 65, 80), Enum.Material.Metal, nil, true)
			addPart(model, body, "Superstructure", Vector3.new(4.5 * s, 3.5 * s, 8 * s), CFrame.new(0, 3.2 * s, 2 * s), Color3.fromRGB(45, 60, 75), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bridge", Vector3.new(3.5 * s, 2.0 * s, 3.5 * s), CFrame.new(0, 5.5 * s, 1 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new(5.5 * s, 1.6 * s, 5 * s), CFrame.new(0, 0.6 * s, -12 * s), Color3.fromRGB(45, 60, 75), Enum.Material.Metal, nil, false)
			addPart(model, body, "TurretF", Vector3.new(2.4 * s, 1.2 * s, 2.8 * s), CFrame.new(0, 2.4 * s, -6 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "BarrelF", Vector3.new(0.4 * s, 0.4 * s, 5 * s), CFrame.new(0, 2.6 * s, -9 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
			addPart(model, body, "TurretA", Vector3.new(2.2 * s, 1.1 * s, 2.5 * s), CFrame.new(0, 2.3 * s, 8 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "Stack", Vector3.new(1.8 * s, 3.5 * s, 1.8 * s), CFrame.new(0, 5.5 * s, 5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(6.5 * s, 0.15 * s, 0.4 * s), CFrame.new(0, 1.8 * s, -2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 22, accentCol)
			addPart(model, body, "Mast", Vector3.new(0.35 * s, 6 * s, 0.35 * s), CFrame.new(0, 8.5 * s, 2 * s), Color3.fromRGB(55, 60, 70), Enum.Material.Metal, nil, false)
			addPart(model, body, "RadarDish", Vector3.new(2.4 * s, 0.35 * s, 2.4 * s), CFrame.new(0, 11.5 * s, 2 * s), accentCol, Enum.Material.Neon, Enum.PartType.Cylinder, false)
			seatOffset = CFrame.new(0, 6.2 * s, 1 * s)
			labelY = 9.0 * s
		else
			-- Patrol / Gun
			local gun = kind == "Gun" or id == "Gunboat" or id == "MissileBoat"
			local hull = Color3.fromRGB(45, 70, 85)
			body.Size = Vector3.new((if gun then 6.5 else 5.5) * s, 1.8 * s, (if gun then 14 else 11) * s)
			body.Color = hull
			addPart(model, body, "Deck", Vector3.new((if gun then 5.8 else 4.8) * s, 0.4 * s, (if gun then 11 else 8.5) * s), CFrame.new(0, 1.0 * s, 0), Color3.fromRGB(55, 80, 95), Enum.Material.Metal, nil, true)
			addPart(model, body, "Cabin", Vector3.new(3.2 * s, 2.0 * s, 3.5 * s), CFrame.new(0, 2.2 * s, -1.5 * s), Color3.fromRGB(40, 60, 75), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new((if gun then 4.5 else 3.8) * s, 1.2 * s, 3.0 * s), CFrame.new(0, 0.4 * s, (if gun then -6.5 else -5.2) * s), Color3.fromRGB(50, 75, 90), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(4.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.5 * s, -2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, if gun then 11 else 8, accentCol)
			addPart(model, body, "BridgeGlass", Vector3.new(2.8 * s, 0.9 * s, 0.3 * s), CFrame.new(0, 2.8 * s, -3.0 * s), Color3.fromRGB(60, 100, 130), Enum.Material.Glass, nil, false)
			if gun then
				addPart(model, body, "Turret", Vector3.new(2.0 * s, 1.0 * s, 2.0 * s), CFrame.new(0, 2.8 * s, 2.5 * s), Color3.fromRGB(35, 45, 50), Enum.Material.Metal, nil, false)
				addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 3.5 * s), CFrame.new(0, 3.0 * s, 0.5 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
				addPart(model, body, "GunShield", Vector3.new(1.6 * s, 1.0 * s, 0.25 * s), CFrame.new(0, 3.2 * s, 1.4 * s), Color3.fromRGB(40, 50, 55), Enum.Material.Metal, nil, false)
			end
			seatOffset = CFrame.new(0, 2.8 * s, -1.2 * s)
			labelY = 5.5 * s
		end
	end

	if family == "WheeledLight" then
		kitWheeledLight()
	elseif family == "WheeledTruck" then
		kitWheeledTruck()
	elseif family == "WheeledAPC" then
		kitWheeledAPC()
	elseif family == "TrackedIFV" then
		kitTracked("IFV")
	elseif family == "TrackedMBT" then
		kitTracked("MBT")
	elseif family == "TrackedSPAAG" then
		kitTracked("SPAAG")
	elseif family == "TrackedArtillery" then
		kitTracked("Artillery")
	elseif family == "HeliLight" then
		kitHeli("Light")
	elseif family == "HeliTransport" then
		kitHeli("Transport")
	elseif family == "HeliAttack" then
		kitHeli("Attack")
	elseif family == "JetFighter" then
		kitJet("Fighter")
	elseif family == "JetStrike" then
		kitJet("Strike")
	elseif family == "JetBomber" then
		kitJet("Bomber")
	elseif family == "JetTransport" then
		kitJet("Transport")
	elseif family == "NavalPatrol" then
		kitNaval("Patrol")
	elseif family == "NavalGun" then
		kitNaval("Gun")
	elseif family == "NavalLanding" then
		kitNaval("Landing")
	elseif family == "NavalCapital" then
		kitNaval("Capital")
	elseif family == "NavalSub" then
		kitNaval("Sub")
	else
		body.Size = Vector3.new(6 * s, 2 * s, 10 * s)
		body.Color = olive
		addPart(model, body, "Cabin", Vector3.new(4 * s, 1.5 * s, 4 * s), CFrame.new(0, 1.5 * s, -1 * s), oliveDark, Enum.Material.SmoothPlastic, nil, true)
		addWheels(model, body, s, {
			Vector3.new(-2.5, -1.2, 3),
			Vector3.new(2.5, -1.2, 3),
			Vector3.new(-2.5, -1.2, -3),
			Vector3.new(2.5, -1.2, -3),
		}, 1.1)
		seatOffset = CFrame.new(0, 2.0 * s, -1 * s)
	end

	local cat = def.Category or "Ground"
	local mode = driveModeFor(def)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.8, 2)
	seat.Color = Color3.fromRGB(70, 80, 60)
	seat.Material = Enum.Material.SmoothPlastic
	seat.CFrame = body.CFrame * seatOffset
	seat.Anchored = false
	seat.CanCollide = true
	seat.HeadsUpDisplay = false
	-- v70: the seat only reports ThrottleFloat / SteerFloat; the WE_DriveLV / WE_DriveAO movers drive
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Disabled = false
	seat:SetAttribute("WE_DriverSeat", true)
	seat.Parent = model
	weldTo(body, seat)
	model:SetAttribute("WE_Category", cat)
	model:SetAttribute("WE_KitFamily", family)
	if def.MeshAssetId and def.MeshAssetId ~= 0 then
		model:SetAttribute("MeshAssetId", def.MeshAssetId)
	end

	local extra = math.max(0, (def.Seats or 1) - 1)
	for i = 1, math.min(extra, 4) do
		local ps = Instance.new("Seat")
		ps.Name = "PassengerSeat" .. i
		ps.Size = Vector3.new(1.4, 0.5, 1.4)
		ps.Color = Color3.fromRGB(60, 70, 55)
		ps.CFrame = body.CFrame * CFrame.new((i % 2 == 0 and 1.4 or -1.4), seatOffset.Y, seatOffset.Z + 1.4 + math.floor((i - 1) / 2) * 1.5)
		ps.Anchored = false
		ps.CanCollide = true
		ps.Parent = model
		weldTo(body, ps)
	end

	do
		-- Mobile P1-8: no server nameplate and no key-name tips. The old nameplate billboard (always on top, 280 studs,
		-- keyboard tips) showed to everyone through the HUD. The owner-only nameplate is client-side
		-- (VehicleDriveClient); WE_LabelY is the kit's label height above the Chassis centre for it.
		model:SetAttribute("WE_LabelY", labelY)
		-- v36 ArmedJeep: static ARMED billboard on barrel (no fire logic yet). World-label rules: stud-scaled,
		-- MaxDistance <= 40, never AlwaysOnTop.
		if id == "ArmedJeep" then
			local barrel = model:FindFirstChild("Barrel")
			if barrel and barrel:IsA("BasePart") then
				local abb = Instance.new("BillboardGui")
				abb.Name = "WE_ArmedCue"
				abb.Size = UDim2.fromScale(2.4, 0.6) -- studs
				abb.StudsOffset = Vector3.new(0, 1.2, 0)
				abb.AlwaysOnTop = false
				abb.MaxDistance = 40
				abb.Parent = barrel
				local al = Instance.new("TextLabel")
				al.Size = UDim2.fromScale(1, 1)
				al.BackgroundColor3 = Color3.fromRGB(40, 20, 16)
				al.BackgroundTransparency = 0.2
				al.Text = "ARMED"
				al.TextColor3 = Color3.fromRGB(255, 180, 100)
				al.TextStrokeTransparency = 0.35
				al.Font = Enum.Font.GothamBold
				al.TextScaled = true
				al.Parent = abb
			end
		end
	end

	model.PrimaryPart = body
	-- Optional free Creator Store visual (non-colliding); Part kit stays authoritative
	pcall(function()
		VisualAssetService.TryAttachVehicleVisual(model, def.Id or "", family)
	end)
	CollectionService:AddTag(model, Constants.Tags.Vehicle)

	-- v70: movers + drive attributes (protocol for VehicleDriveClient). Built at `at`, NOT parented:
	-- RequestSpawn measures the footprint, chooses the spawn, PivotTo, then parents.
	createMovers(model, body, def, mode)
	local fp = footprintOf(model)
	for k, v in pairs(driveAttributes(def, fp, bonus, armorMult)) do
		model:SetAttribute(k, v)
	end
	model:SetAttribute("WE_DriveAuthority", "Server")
	model:SetAttribute("WE_DriverUserId", 0)
	if mode == "Car" then
		model:SetAttribute("WE_GroundDrive", "Client")
	end
	return model
end

local function meetsStructureReq(profile: any, def: VehicleDef): (boolean, string?)
	local req = def.RequiresStructure
	if not req then
		return true, nil
	end
	local level = 0
	if profile.BaseUpgrades then
		level = profile.BaseUpgrades[req.StructureId] or 0
	end
	if level < req.Level then
		return false, "MissingStructure"
	end
	return true, nil
end

local function meetsPrestigeReq(profile: any, def: VehicleDef): (boolean, string?)
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 then
		if (profile.Prestige or 0) < needP then
			return false, "PrestigeTooLow"
		end
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" then
		local unlocks = profile.RebirthUnlocks
		if typeof(unlocks) ~= "table" or unlocks[flag] ~= true then
			return false, "MissingRebirthUnlock"
		end
	end
	return true, nil
end

-- ── State push (garage) ────────────────────────────────────────────────────────────────────────
local GATE_STRUCTURES = { "VehicleDepot", "Helipad", "Airfield", "Dock" }

-- P1-9: seconds until SPAWN is allowed again after the player's character took damage
local function damageLockLeft(userId: number): number
	local at = lastDamageAt[userId]
	if at == nil then
		return 0
	end
	return math.max(0, SpawnCfg.DamageLockSeconds - (now() - at))
end

local function cooldownLeft(userId: number, player: Player?): number
	local last = lastSpawnAt[userId]
	if not last then
		return 0
	end
	local cd = VehicleConfig.SpawnCooldownSeconds or 15
	if player and TerritoryService and TerritoryService.GetVehicleCooldownMult then
		cd = cd * math.max(0.1, TerritoryService.GetVehicleCooldownMult(player))
	end
	return math.max(0, cd - (now() - last))
end

local function gatesFor(profile: any): { [string]: any }
	local structures: { [string]: number } = {}
	local upgrades = profile.BaseUpgrades
	for _, sid in ipairs(GATE_STRUCTURES) do
		structures[sid] = if typeof(upgrades) == "table" then (tonumber(upgrades[sid]) or 0) else 0
	end
	local rebirth: { [string]: boolean } = {}
	if typeof(profile.RebirthUnlocks) == "table" then
		for k, v in pairs(profile.RebirthUnlocks) do
			if typeof(k) == "string" and v == true then
				rebirth[k] = true
			end
		end
	end
	return {
		Level = tonumber(profile.Level) or 1,
		Prestige = tonumber(profile.Prestige) or 0,
		Structures = structures,
		Rebirth = rebirth,
	}
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local active = activeVehicles[player.UserId]
	local activeId: string? = nil
	if active and active.Parent then
		local vid = active:GetAttribute("VehicleId")
		if typeof(vid) == "string" then
			activeId = vid
		end
	end
	-- plain table (Types.VehicleStatePayload + v70 Gates; the client copes with a missing Gates)
	local payload = {
		Owned = profile.Vehicles,
		ActiveVehicleId = activeId,
		CooldownRemaining = cooldownLeft(player.UserId, player),
		Gates = gatesFor(profile),
	}
	local remote = RemoteSetup.Get(Constants.RemoteNames.VehicleStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

-- Readable purchase / spawn refusals (garage G4)
local function errorText(err: string, def: VehicleDef?, player: Player?): string
	if err == "LevelTooLow" and def then
		return string.format("Reach Lv %d to unlock %s", def.UnlockLevel, def.DisplayName)
	elseif err == "MissingStructure" and def and def.RequiresStructure then
		local req = def.RequiresStructure
		local sdef = (BaseConfig.Structures :: any)[req.StructureId]
		local name = if sdef and typeof(sdef.DisplayName) == "string" then sdef.DisplayName else req.StructureId
		return string.format("Upgrade %s to L%d first", name, req.Level)
	elseif err == "PrestigeTooLow" and def then
		return string.format("Needs Prestige %d", tonumber(def.RequiresPrestige) or 0)
	elseif err == "MissingRebirthUnlock" then
		return "Needs a rebirth unlock"
	elseif err == "InsufficientCash" then
		return "Not enough cash"
	elseif err == "AlreadyOwned" then
		return "Already yours — tap SPAWN"
	elseif err == "NoProfile" then
		return "Still loading your save — try again"
	elseif err == "NoWater" then
		return "No open water to launch a boat"
	elseif err == "Cooldown" then
		local left = if player then math.ceil(cooldownLeft(player.UserId, player)) else 0
		return if left > 0 then string.format("Vehicle spawn cooling down (%ds)", left) else "Vehicle spawn cooling down"
	elseif err == "InCombat" then
		local left = if player then math.ceil(damageLockLeft(player.UserId)) else 0
		return if left > 0 then string.format("In combat — wait %ds", left) else "In combat — wait a moment"
	elseif err == "NotOwned" then
		return "Buy this vehicle first"
	elseif err == "SpawnBuildFailed" or err == "SpawnKitIncomplete" or err == "SpawnOrphaned" then
		return "Spawn failed — try again"
	elseif err == "InvalidId" or err == "UnknownVehicle" then
		return "Unknown vehicle"
	end
	return "Cannot do that right now (" .. err .. ")"
end

-- ── Spawn choice (spec §4) ─────────────────────────────────────────────────────────────────────
type PadDist = { Pad: SpawnPad, D: number }
type Offset2 = { X: number, Z: number }

local function footRadius(fp: Footprint): number
	return math.max(fp.HalfX, fp.HalfZ)
end

local function rideOffsetOf(fp: Footprint): number
	return fp.Clearance - BoatCfg.Draft
end

local function spotFree(ctx: SpawnCtx, cf: CFrame): boolean
	local fp = ctx.Footprint
	local pos = cf.Position
	local r = footRadius(fp)
	for _, o in ipairs(ctx.Occupied) do
		if (pos - o.Pos).Magnitude < r + o.Radius + 2 then
			return false
		end
	end
	local boxFree = ctx.BoxFree
	if boxFree then
		-- from just above the lowest solid point to the top of the kit, over the XZ footprint
		local lowY = -fp.Clearance + 0.15
		local highY = math.max(fp.Top, lowY + 0.5)
		local half = Vector3.new(fp.HalfX, (highY - lowY) * 0.5, fp.HalfZ)
		if not boxFree(cf * CFrame.new(0, (lowY + highY) * 0.5, 0), half) then
			return false
		end
	end
	return true
end

-- Land spot: chassis Y = surface + Clearance + 0.3 (a ray when available, else refTop).
local function landSpot(ctx: SpawnCtx, x: number, z: number, refTop: number, heading: number): CFrame?
	local y = refTop
	local surfaceY = ctx.SurfaceY
	if surfaceY then
		local hit = surfaceY(x, z, refTop)
		if hit ~= nil then
			if hit > refTop + SpawnCfg.MaxStepUp then
				return nil -- something solid stands here
			end
			y = hit
		end
	end
	return CFrame.new(x, y + ctx.Footprint.Clearance + SpawnCfg.Clearance, z) * CFrame.Angles(0, heading, 0)
end

local function aroundOffsets(fp: Footprint): { Offset2 }
	local s = 2 * footRadius(fp) + SpawnCfg.OffsetStep
	return { { X = 0, Z = 0 }, { X = s, Z = 0 }, { X = -s, Z = 0 }, { X = 0, Z = s }, { X = 0, Z = -s } }
end

local function firstFreeLand(ctx: SpawnCtx, x: number, z: number, refTop: number, heading: number, offsets: { Offset2 }): CFrame?
	for _, o in ipairs(offsets) do
		local cf = landSpot(ctx, x + o.X, z + o.Z, refTop, heading)
		if cf and spotFree(ctx, cf) then
			return cf
		end
	end
	return nil
end

local function padsByDistance(pads: { SpawnPad }, origin: Vector3?, wantNaval: boolean?, maxDist: number?): { PadDist }
	local out: { PadDist } = {}
	for _, pad in ipairs(pads) do
		if wantNaval == nil or pad.Naval == wantNaval then
			local d = if origin then (pad.Pos - origin).Magnitude else pad.Pos.Magnitude
			if maxDist == nil or d <= maxDist then
				table.insert(out, { Pad = pad, D = d })
			end
		end
	end
	table.sort(out, function(a: PadDist, b: PadDist): boolean
		return a.D < b.D
	end)
	return out
end

local function padTop(pad: SpawnPad): number
	return pad.Pos.Y + pad.Size.Y * 0.5
end

local function choice(cf: CFrame, source: string, state: string, speed: number?): SpawnChoice
	return { CFrame = cf, Source = source, State = state, Speed = speed or 0 }
end

--[[ P1-9: the land spot (centre or a footprint corner) lies in any water whose surface is above the ground there.
	Every WE_Water part counts (AllWater): another plot's dock basin is not boat water for this player, but a car
	must never land in it. Depth-independent (the ground ray ignores water, so it lands on the basin floor). ]]
local function overAnyWater(ctx: SpawnCtx, cf: CFrame): boolean
	local fp = ctx.Footprint
	local ground = cf.Position.Y - fp.Clearance - SpawnCfg.Clearance
	local lists = { ctx.WaterParts, ctx.AllWater or {} }
	for _, o in ipairs({ Vector3.zero, Vector3.new(fp.HalfX, 0, fp.HalfZ), Vector3.new(-fp.HalfX, 0, fp.HalfZ), Vector3.new(fp.HalfX, 0, -fp.HalfZ), Vector3.new(-fp.HalfX, 0, -fp.HalfZ) }) do
		local pt = cf:PointToWorldSpace(o)
		for _, list in ipairs(lists) do
			for _, w in ipairs(list) do
				local lp = w.CFrame:PointToObjectSpace(pt)
				if math.abs(lp.X) <= w.Size.X * 0.5 and math.abs(lp.Z) <= w.Size.Z * 0.5 and w.Position.Y + w.Size.Y * 0.5 > ground - 0.5 then
					return true
				end
			end
		end
	end
	return false
end

-- P1-9: nothing solid between the player's root part and the spot (never a spawn across a wall: the auto-sit would
-- carry the player through it, e.g. from outside an enemy base's perimeter wall into its courtyard)
local function inSight(ctx: SpawnCtx, from: Vector3, cf: CFrame): boolean
	local clear = ctx.Clear
	return clear == nil or clear(from, cf.Position + Vector3.new(0, 1, 0))
end

-- P1-9: open sky over the spot (no roof, upper floor or hangar within 40 studs): never inside a building
local function openSky(ctx: SpawnCtx, cf: CFrame): boolean
	local clear = ctx.Clear
	local top = cf.Position + Vector3.new(0, math.max(ctx.Footprint.Top, 1) + 0.5, 0)
	return clear == nil or clear(top, top + Vector3.new(0, 40, 0))
end

local function playerFront(ctx: SpawnCtx, state: string): SpawnChoice?
	local pp = ctx.PlayerPos
	if not pp then
		return nil
	end
	local look = flat(ctx.PlayerLook or Vector3.new(0, 0, -1))
	look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
	local ahead = pp + look * (SpawnCfg.FrontDistance + footRadius(ctx.Footprint))
	local heading = math.atan2(-look.X, -look.Z)
	-- land vehicles only (Car / Heli / Plane): never a spot over water (a player on a pier facing the sea), never
	-- across a wall (the auto-sit would carry the player through it) and never under a roof (inside a building)
	for _, o in ipairs(aroundOffsets(ctx.Footprint)) do
		local cf = landSpot(ctx, ahead.X + o.X, ahead.Z + o.Z, pp.Y - 3, heading)
		if cf and not overAnyWater(ctx, cf) and inSight(ctx, pp, cf) and openSky(ctx, cf) and spotFree(ctx, cf) then
			return choice(cf, "PlayerFront", state)
		end
	end
	return nil
end

--[[ Waterways C1: every plot-local → world conversion goes through the plot frame, i.e. the plot pad's CFrame
	(PlotPad / WE_BasePlot is built with BaseLayout.PlotCFrame(pos), which carries the plot yaw once
	BaseLayoutConfig.FaceMapCentre is on). A plot-local heading h becomes h + yawOf(frame). While the flag is off the
	pad's rotation is the identity, so every spot and heading below equals the old plot + (x, 0, z) exactly. ]]
local function plotFrame(ctx: SpawnCtx): CFrame?
	local cf = ctx.PlotCFrame
	if cf then
		return cf
	end
	local p = ctx.PlotPos
	return if p then CFrame.new(p) else nil
end

-- plot-local point (x, z) plus a plot-local offset (ox, oz) → world X, Z (base first, then the turned offset)
local function plotXZ(frame: CFrame, x: number, z: number, ox: number?, oz: number?): (number, number)
	local w = frame:PointToWorldSpace(Vector3.new(x, 0, z))
	if ox == nil and oz == nil then
		return w.X, w.Z
	end
	local o = frame:VectorToWorldSpace(Vector3.new(ox or 0, 0, oz or 0))
	return w.X + o.X, w.Z + o.Z
end

-- firstFreeLand at plot-local (x, z) with a plot-local heading; the offsets turn with the plot
local function firstFreePlotLand(
	ctx: SpawnCtx,
	frame: CFrame,
	x: number,
	z: number,
	refTop: number,
	heading: number,
	offsets: { Offset2 }
): CFrame?
	local h = heading + yawOf(frame)
	for _, o in ipairs(offsets) do
		local wx, wz = plotXZ(frame, x, z, o.X, o.Z)
		local cf = landSpot(ctx, wx, wz, refTop, h)
		if cf and spotFree(ctx, cf) then
			return cf
		end
	end
	return nil
end

local function lastResort(ctx: SpawnCtx, state: string): SpawnChoice
	local base = ctx.PlotPos or ctx.PlayerPos or Vector3.new(0, 0.5, 0)
	local y = base.Y + 0.5 + ctx.Footprint.Clearance + SpawnCfg.Clearance
	local frame = if ctx.PlotPos then plotFrame(ctx) else nil
	if frame then
		-- plot-local (0, PlotFallback.Z), turned with the plot
		local wx, wz = plotXZ(frame, 0, SpawnCfg.PlotFallback.Z)
		return choice(CFrame.new(wx, y, wz) * CFrame.Angles(0, yawOf(frame), 0), "WorldOrigin", state)
	end
	return choice(CFrame.new(base.X, y, base.Z), "WorldOrigin", state)
end

local function chooseCar(ctx: SpawnCtx): SpawnChoice
	local fp = ctx.Footprint
	local offsets = aroundOffsets(fp)
	if ctx.AwayFromHome then
		-- P1-9: away from your own plot SPAWN puts it in front of you, not on a pad 650 studs away or at home
		local front = playerFront(ctx, "Grounded")
		if front then
			return front
		end
	end
	if ctx.PlayerPos then
		for _, e in ipairs(padsByDistance(ctx.VehiclePads, ctx.PlayerPos, false, SpawnCfg.CarPadRadius)) do
			local cf = firstFreeLand(ctx, e.Pad.Pos.X, e.Pad.Pos.Z, padTop(e.Pad), yawOf(e.Pad.CFrame), offsets)
			if cf then
				return choice(cf, "VehicleSpawn", "Grounded")
			end
		end
	end
	local plot = ctx.PlotPos
	local frame = plotFrame(ctx)
	if plot and frame then
		local o = SpawnCfg.PlotFallback
		local cf = firstFreePlotLand(ctx, frame, o.X, o.Z, plot.Y + 0.5, 0, offsets)
		if cf then
			return choice(cf, "BasePlot", "Grounded")
		end
	end
	return playerFront(ctx, "Grounded") or lastResort(ctx, "Grounded")
end

local function chooseHeli(ctx: SpawnCtx): SpawnChoice
	local fp = ctx.Footprint
	local plot = ctx.PlotPos
	local frame = plotFrame(ctx)
	if ctx.AwayFromHome then
		local front = playerFront(ctx, "Landed") -- P1-9
		if front then
			return front
		end
	end
	if plot and frame and (ctx.Structures.Helipad or 0) >= 1 then
		local site = BaseLayoutConfig.Structures.Helipad.Site
		local refTop = plot.Y + 0.5 + SpawnCfg.HelipadDeckHeight
		local heading = SpawnCfg.HeliHeadingRad + yawOf(frame)
		for _, o in ipairs(SpawnCfg.HelipadSpots) do
			local wx, wz = plotXZ(frame, site.X, site.Z, o.X, o.Z)
			local cf = landSpot(ctx, wx, wz, refTop, heading)
			if cf and spotFree(ctx, cf) then
				return choice(cf, "Helipad", "Landed")
			end
		end
	end
	local origin = ctx.PlayerPos or plot
	local offsets = aroundOffsets(fp)
	for _, e in ipairs(padsByDistance(ctx.VehiclePads, origin, false, nil)) do
		local cf = firstFreeLand(ctx, e.Pad.Pos.X, e.Pad.Pos.Z, padTop(e.Pad), yawOf(e.Pad.CFrame), offsets)
		if cf then
			return choice(cf, "VehicleSpawn", "Landed")
		end
	end
	return playerFront(ctx, "Landed") or lastResort(ctx, "Landed")
end

local function runwayRoad(): { X: number, Z: number, SizeX: number, SizeZ: number }?
	for _, r in ipairs(BaseLayoutConfig.Roads) do
		if r.Name == SpawnCfg.RunwayRoad then
			return r
		end
	end
	return nil
end

local function choosePlane(ctx: SpawnCtx): SpawnChoice
	local fp = ctx.Footprint
	local plot = ctx.PlotPos
	local road = runwayRoad()
	local frame = plotFrame(ctx)
	if ctx.AwayFromHome then
		local front = playerFront(ctx, "Grounded") -- P1-9: taxi and take off from where you stand
		if front then
			return front
		end
	end
	if plot and frame and road and (ctx.Structures.Airfield or 0) >= 1 then
		-- start 12 studs in from the end nearer the plot edge, facing along the runway toward the other end
		-- (runway X/Z, the ends and the heading are plot-local; plotXZ / yawOf(frame) turn them with the plot)
		local minX, maxX = road.X - road.SizeX * 0.5, road.X + road.SizeX * 0.5
		local fromMin = math.abs(minX) >= math.abs(maxX)
		local startX = if fromMin then minX + SpawnCfg.RunwayInset else maxX - SpawnCfg.RunwayInset
		local step = if fromMin then 1 else -1
		local heading = (if fromMin then -math.pi / 2 else math.pi / 2) + yawOf(frame) -- plot +X / -X
		local refTop = plot.Y + 0.5 + SpawnCfg.RunwayHeight
		local spacing = 2 * fp.HalfZ + 6
		for k = 0, 3 do
			local x = startX + step * k * spacing
			if math.abs(x - road.X) > road.SizeX * 0.5 - fp.HalfZ then
				break
			end
			if k > 0 and math.abs(x - startX) > road.SizeX * 0.5 then
				break -- keep at least half the runway ahead
			end
			local wx, wz = plotXZ(frame, x, road.Z)
			local cf = landSpot(ctx, wx, wz, refTop, heading)
			if cf and spotFree(ctx, cf) then
				return choice(cf, "Runway", "Grounded")
			end
		end
	end
	-- air start over the nearest land pad
	local vto = ctx.TakeoffSpeed or PlaneCfg.TakeoffMin
	local speed = PlaneCfg.AirStartSpeedFrac * vto
	local origin = ctx.PlayerPos or plot
	for _, e in ipairs(padsByDistance(ctx.VehiclePads, origin, false, nil)) do
		local p = e.Pad.Pos + Vector3.new(0, PlaneCfg.AirStartHeight, 0)
		local cf = CFrame.new(p) * CFrame.Angles(0, 0, 0)
		if spotFree(ctx, cf) then
			return choice(cf, "AirStart", "Airborne", speed)
		end
	end
	local base = origin or Vector3.new(0, 0.5, 0)
	return choice(CFrame.new(base + Vector3.new(0, PlaneCfg.AirStartHeight, 0)), "AirStart", "Airborne", speed)
end

-- Boat spot: the centre and the 4 hull corners over water (margin 1, land probe), free.
local function boatSpot(ctx: SpawnCtx, cx: number, cz: number, h: number, refY: number): CFrame?
	local fp = ctx.Footprint
	local parts = ctx.WaterParts
	local margin = WaterCfg.SpawnMargin
	local centre = Vector3.new(cx, refY, cz)
	local top = waterSurfaceAt(parts, centre, margin, ctx.LandProbe)
	if top == nil then
		return nil
	end
	local f, r = fwd(h), right(h)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local p = centre + r * (sx * fp.HalfX) + f * (sz * fp.HalfZ)
			if waterSurfaceAt(parts, p, margin, ctx.LandProbe) == nil then
				return nil
			end
		end
	end
	local cf = CFrame.new(cx, top + rideOffsetOf(fp), cz) * CFrame.Angles(0, h, 0)
	if not spotFree(ctx, cf) then
		return nil
	end
	return cf
end

local function plotBasin(ctx: SpawnCtx): BasePart?
	local plotId = ctx.PlotId
	if plotId == nil then
		return nil
	end
	for _, p in ipairs(ctx.WaterParts) do
		if p:GetAttribute("WE_PlotId") == plotId then
			return p
		end
	end
	return nil
end

local function chooseBoat(ctx: SpawnCtx): (SpawnChoice?, string?)
	local fp = ctx.Footprint
	-- own dock basin, only when a channel links it to the sea
	local function basinChoice(): SpawnChoice?
		local basin = plotBasin(ctx)
		if basin and ctx.PlotPos and (ctx.Structures.Dock or 0) >= 1 and isConnectedToSea(basin, ctx.WaterParts) then
			local bcf = basin.CFrame
			local top = basin.Position.Y + basin.Size.Y * 0.5
			local step = WaterCfg.GridStep
			local pts: { Vector3 } = {}
			local hx, hz = basin.Size.X * 0.5, basin.Size.Z * 0.5
			local nx, nz = math.floor(hx / step), math.floor(hz / step)
			for i = -nx, nx do
				for j = -nz, nz do
					table.insert(pts, Vector3.new(i * step, 0, j * step))
				end
			end
			table.sort(pts, function(a: Vector3, b: Vector3): boolean
				return a.Magnitude < b.Magnitude
			end)
			local byaw = yawOf(bcf)
			for _, lp in ipairs(pts) do
				local wp = bcf:PointToWorldSpace(lp)
				for _, h in ipairs({ byaw, byaw + math.pi / 2 }) do
					local cf = boatSpot(ctx, wp.X, wp.Z, h, top)
					if cf then
						return choice(cf, "DockBasin", "Floating")
					end
				end
			end
		end
		return nil
	end
	-- naval pads by distance (no limit): 8 directions, bow pointing away from the pad
	local function padChoice(): SpawnChoice?
		local origin = ctx.PlayerPos or ctx.PlotPos
		for _, e in ipairs(padsByDistance(ctx.NavalPads, origin, nil, nil)) do
			local pad = e.Pad
			local padHalf = math.max(pad.Size.X, pad.Size.Z) * 0.5
			local away = if origin then flat(pad.Pos - origin) else Vector3.new(0, 0, 1)
			away = if away.Magnitude > 0.05 then away.Unit else Vector3.new(0, 0, 1)
			local dirs: { Vector3 } = {}
			for k = 0, 7 do
				table.insert(dirs, fwd(k * math.pi / 4))
			end
			table.sort(dirs, function(a: Vector3, b: Vector3): boolean
				return a:Dot(away) > b:Dot(away)
			end)
			for _, d in ipairs(dirs) do
				local c = pad.Pos + d * (padHalf + fp.HalfZ + SpawnCfg.NavalPadGap)
				local h = math.atan2(-d.X, -d.Z)
				local cf = boatSpot(ctx, c.X, c.Z, h, pad.Pos.Y)
				if cf then
					return choice(cf, "NavalSpawn", "Floating")
				end
			end
		end
		return nil
	end
	-- centre of the largest water part (and a ring around it)
	local function openChoice(): SpawnChoice?
		local largest: BasePart? = nil
		local area = -1
		for _, p in ipairs(ctx.WaterParts) do
			local a = p.Size.X * p.Size.Z
			if a > area then
				area = a
				largest = p
			end
		end
		if largest then
			local top = largest.Position.Y + largest.Size.Y * 0.5
			local c = largest.Position
			local ring = 2 * footRadius(fp) + SpawnCfg.OffsetStep
			for k = 0, 8 do
				local off = if k == 0 then Vector3.zero else fwd((k - 1) * math.pi / 4) * ring
				local cf = boatSpot(ctx, c.X + off.X, c.Z + off.Z, yawOf(largest.CFrame), top)
				if cf then
					return choice(cf, "OpenWater", "Floating")
				end
			end
		end
		return nil
	end
	-- P1-9: away from your own plot, water right in front of you first (never your dock basin across the map first)
	local function frontChoice(): SpawnChoice?
		local pp = ctx.PlayerPos
		if not pp then
			return nil
		end
		local look = flat(ctx.PlayerLook or Vector3.new(0, 0, -1))
		look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
		local ahead = pp + look * (SpawnCfg.FrontDistance + footRadius(fp))
		local cf = boatSpot(ctx, ahead.X, ahead.Z, math.atan2(-look.X, -look.Z), pp.Y)
		return if cf and inSight(ctx, pp, cf) then choice(cf, "PlayerFront", "Floating") else nil
	end
	local order = if ctx.AwayFromHome then { frontChoice, padChoice, basinChoice, openChoice } else { basinChoice, padChoice, openChoice }
	for _, step in ipairs(order) do
		local c = step()
		if c then
			return c, nil
		end
	end
	return nil, "NoWater"
end

local function chooseSpawn(ctx: SpawnCtx): (SpawnChoice?, string?)
	local mode = ctx.Mode
	if mode == "Boat" then
		return chooseBoat(ctx)
	elseif mode == "Heli" then
		return chooseHeli(ctx), nil
	elseif mode == "Plane" then
		return choosePlane(ctx), nil
	end
	return chooseCar(ctx), nil
end

-- Real-world ctx (raycasts, pads, water, other vehicles)
local function characterList(): { Instance }
	local list: { Instance } = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character
		if ch then
			table.insert(list, ch)
		end
	end
	return list
end

local function exclusionList(withWater: boolean, withPads: boolean): { Instance }
	local list = characterList()
	table.insert(list, ensureFolder())
	if withWater then
		for _, w in ipairs(getWaterParts()) do
			table.insert(list, w)
		end
	end
	if withPads then
		for _, tag in ipairs({ Constants.Tags.VehicleSpawn, Constants.Tags.NavalSpawn }) do
			for _, inst in ipairs(CollectionService:GetTagged(tag)) do
				table.insert(list, inst)
			end
		end
	end
	return list
end

local function rayParams(exclude: { Instance }): RaycastParams
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = exclude
	rp.RespectCanCollide = true
	return rp
end

local function findPlotPart(plotId: any): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			return inst
		end
	end
	return nil
end

-- P1-9: pos on the plot pad's rectangle (plot-local XZ, grown by OwnPlotMargin)
local function insidePlot(plot: BasePart, pos: Vector3): boolean
	local lp = plot.CFrame:PointToObjectSpace(pos)
	local m = SpawnCfg.OwnPlotMargin
	return math.abs(lp.X) <= plot.Size.X * 0.5 + m and math.abs(lp.Z) <= plot.Size.Z * 0.5 + m
end

-- P1-9: the player stands inside their own plot (nil plot / no character → false)
local function playerAtHome(player: Player, profile: any): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) or not (profile and profile.BasePlotId) then
		return false
	end
	local plot = findPlotPart(profile.BasePlotId)
	return plot ~= nil and insidePlot(plot, root.Position)
end

local function buildSpawnCtx(player: Player, profile: any, mode: string, fp: Footprint, attrs: { [string]: any }, exclude: Model?): SpawnCtx
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local playerPos: Vector3? = nil
	local playerLook: Vector3? = nil
	if root and root:IsA("BasePart") then
		playerPos = root.Position
		playerLook = root.CFrame.LookVector
	end
	local plotPos: Vector3? = nil
	local plotCFrame: CFrame? = nil
	local plotId: number? = nil
	local awayFromHome = false
	if profile and profile.BasePlotId then
		local plot = findPlotPart(profile.BasePlotId)
		if plot then
			plotPos = plot.Position
			plotCFrame = plot.CFrame -- C1: the pad carries the plot yaw
			plotId = tonumber(profile.BasePlotId)
			awayFromHome = playerPos ~= nil and not insidePlot(plot, playerPos)
		end
	end
	-- C5: someone else's DockWater / SeaGateWater is not water for this player's boats
	local ownPlotId: number? = if profile then tonumber(profile.BasePlotId) else nil
	local structures: { [string]: number } = {}
	if profile and typeof(profile.BaseUpgrades) == "table" then
		for k, v in pairs(profile.BaseUpgrades) do
			if typeof(k) == "string" then
				structures[k] = tonumber(v) or 0
			end
		end
	end
	local vehiclePads: { SpawnPad } = {}
	local navalPads: { SpawnPad } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.VehicleSpawn)) do
		if inst:IsA("BasePart") and inst.Parent then
			table.insert(vehiclePads, {
				Pos = inst.Position,
				CFrame = inst.CFrame,
				Size = inst.Size,
				Naval = CollectionService:HasTag(inst, Constants.Tags.NavalSpawn),
			})
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.NavalSpawn)) do
		if inst:IsA("BasePart") and inst.Parent then
			table.insert(navalPads, { Pos = inst.Position, CFrame = inst.CFrame, Size = inst.Size, Naval = true })
		end
	end
	local occupied: { OccupiedSpot } = {}
	for m, rec in pairs(vehicles) do
		if m ~= exclude and m.Parent and rec.Chassis.Parent then
			local hx = tonumber(m:GetAttribute("WE_HalfWidth")) or 4
			local hz = tonumber(m:GetAttribute("WE_HalfLength")) or 6
			table.insert(occupied, { Pos = rec.Chassis.Position, Radius = math.max(hx, hz) })
		end
	end
	local groundEx = rayParams(exclusionList(true, false))
	local ctx: SpawnCtx = {
		Mode = mode,
		PlayerPos = playerPos,
		PlayerLook = playerLook,
		PlotPos = plotPos,
		PlotCFrame = plotCFrame,
		PlotId = plotId,
		Structures = structures,
		Footprint = fp,
		TakeoffSpeed = tonumber(attrs.WE_TakeoffSpeed),
		VehiclePads = vehiclePads,
		NavalPads = navalPads,
		WaterParts = waterPartsFor(ownPlotId),
		Occupied = occupied,
		SurfaceY = function(x: number, z: number, refY: number): number?
			local hit = Workspace:Raycast(Vector3.new(x, refY + 10, z), Vector3.new(0, -40, 0), groundEx)
			return if hit then hit.Position.Y else nil
		end,
		LandProbe = function(x: number, z: number, top: number): boolean
			local h = WaterCfg.LandProbeHeight
			local hit = Workspace:Raycast(Vector3.new(x, top + h, z), Vector3.new(0, -(h + 0.05), 0), groundEx)
			return hit ~= nil and hit.Position.Y > top - 0.05
		end,
		BoxFree = function(cf: CFrame, half: Vector3): boolean
			local op = OverlapParams.new()
			op.FilterType = Enum.RaycastFilterType.Exclude
			op.FilterDescendantsInstances = exclusionList(true, true)
			op.RespectCanCollide = true
			op.MaxParts = 1
			local hits = Workspace:GetPartBoundsInBox(cf, half * 2, op)
			return #hits == 0
		end,
		AwayFromHome = awayFromHome,
		AllWater = getWaterParts(),
		Clear = function(from: Vector3, to: Vector3): boolean
			return Workspace:Raycast(from, to - from, groundEx) == nil
		end,
	}
	return ctx
end

-- ── Vehicle records: ownership handoff, idle, fallback, checks ─────────────────────────────────
local function setAuthority(rec: VehicleRec, authority: string)
	if rec.Authority ~= authority then
		rec.Authority = authority
		rec.Model:SetAttribute("WE_DriveAuthority", authority)
	end
	-- the client may have written the movers: the next server write always goes through
	rec.OutVel = nil
	rec.OutHold = nil
	rec.OutRot = nil
end

local function applyOut(rec: VehicleRec, out: DriveOut)
	local lv, ao = rec.LV, rec.AO
	if lv.Parent == nil or ao.Parent == nil then
		return
	end
	if rec.OutVel ~= out.Velocity then
		lv.VectorVelocity = out.Velocity
		rec.OutVel = out.Velocity
	end
	if rec.OutHold ~= out.HoldVertical then
		local f = rec.Force
		lv.MaxAxesForce = Vector3.new(f, if out.HoldVertical then f else 0, f)
		rec.OutHold = out.HoldVertical
	end
	local rot = out.Orientation.Rotation
	if rec.OutRot ~= rot then
		ao.CFrame = rot
		rec.OutRot = rot
	end
end

local function refreshMoverLimits(rec: VehicleRec)
	local mass = (rec.Chassis :: any).AssemblyMass
	if typeof(mass) ~= "number" or mass <= 0 then
		mass = estimateMass(rec.Model)
	end
	local hold = rec.OutHold
	if hold == nil then
		hold = rec.LV.MaxAxesForce.Y > 0
	end
	rec.Force = setMoverLimits(rec.LV, rec.AO, rec.Chassis, rec.Mode, rec.Def.Seats or 1, mass, hold == true)
end

local function playerOfHumanoid(hum: Instance?): Player?
	if hum == nil then
		return nil
	end
	local char = hum.Parent
	if char == nil then
		return nil
	end
	return Players:GetPlayerFromCharacter(char)
end

local function seatedDriver(rec: VehicleRec): Player?
	return playerOfHumanoid(rec.Seat.Occupant)
end

local function ejectSeat(seat: BasePart)
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
end

local function zeroVelocity(part: BasePart)
	pcall(function()
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function setNetworkOwner(part: BasePart, owner: Player?): boolean
	local ok = pcall(function()
		part:SetNetworkOwner(owner)
	end)
	return ok
end

-- Every assembly the vehicle is made of: the chassis (+ welded kit, seats, catalog dress) and each hinge wheel.
local function ownPartsOf(model: Model, chassis: BasePart): { BasePart }
	local list: { BasePart } = { chassis }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("WE_PhysicsWheel") == true then
			table.insert(list, d)
		end
	end
	return list
end

-- Whoever simulates owns everything: the chassis assembly and every wheel assembly (true = no call refused).
local function setOwner(rec: VehicleRec, owner: Player?): boolean
	local ok = true
	for _, p in ipairs(rec.OwnParts) do
		if p.Parent ~= nil and not setNetworkOwner(p, owner) then
			ok = false
		end
	end
	return ok
end

--[[ ("drv" | "srv" | "split" | "oth" | "unk", per-part detail "drv,drv,srv,…"). GetNetworkOwner is server-only and
	errors on anchored parts ("err"); an unreadable part is not evidence of a wrong owner ("unk" = the probe neither
	counts nor clears; a pinned car is caught by the no-motion check instead). ]]
local function ownerState(rec: VehicleRec, driver: Player?): (string, string)
	local tags: { string } = {}
	local allDrv, allSrv, anyOth, anyErr = true, true, false, false
	for i, p in ipairs(rec.OwnParts) do
		local ok, o = pcall(function(): Player?
			return p:GetNetworkOwner()
		end)
		local tag = if not ok then "err" elseif o == nil then "srv" elseif o == driver then "drv" else "oth"
		tags[i] = tag
		if tag == "err" then
			anyErr = true
		else
			allDrv = allDrv and tag == "drv"
			allSrv = allSrv and tag == "srv"
			anyOth = anyOth or tag == "oth"
		end
	end
	local st = if anyOth then "oth" elseif anyErr and allDrv then "unk" elseif allDrv then "drv" elseif allSrv and not anyErr then "srv" else "split"
	return st, table.concat(tags, ",")
end

local function resetValid(rec: VehicleRec, t: number)
	local cf = rec.Chassis.CFrame
	rec.LastValid = { CFrame = cf, Pos = cf.Position, T = t }
	rec.Window = { Pos = cf.Position, T = t }
	rec.LastSampleT = t
	rec.LastSamplePos = cf.Position
	rec.SpeedFlags = 0
	rec.OffWaterFor = 0
end

local function anyOccupied(rec: VehicleRec): boolean
	if rec.Seat.Occupant ~= nil then
		return true
	end
	for _, s in ipairs(rec.Passengers) do
		if s.Parent and s.Occupant ~= nil then
			return true
		end
	end
	return false
end

local aglParams: RaycastParams? = nil
local aglParamsAt = -math.huge

local function groundRayParams(t: number): RaycastParams
	local cached = aglParams
	if cached and t - aglParamsAt < WaterCfg.RefreshSeconds then
		return cached
	end
	local rp = rayParams(exclusionList(false, false))
	aglParams = rp
	aglParamsAt = t
	return rp
end

-- C5: the water this boat may use (its owner's plot water + public water). Owner's BasePlotId is read live from
-- the profile (nil until the real save loaded → public water only).
local function recWaterParts(rec: VehicleRec): { BasePart }
	local owner: Player? = rec.Owner
	local profile = if owner and DataService then DataService.GetProfile(owner) else nil
	return waterPartsFor(if profile then tonumber(profile.BasePlotId) else nil)
end

local function senseFor(rec: VehicleRec, t: number): DriveSense
	local cf = rec.Chassis.CFrame
	local pos = cf.Position
	local agl = math.huge
	if rec.Mode == "Heli" or rec.Mode == "Plane" then
		local hit = Workspace:Raycast(pos, Vector3.new(0, -600, 0), groundRayParams(t))
		if hit then
			agl = (pos.Y - hit.Position.Y) - (tonumber(rec.Model:GetAttribute("WE_GroundClearance")) or 0)
		end
	end
	local waterY: number? = nil
	if rec.Mode == "Boat" then
		waterY = waterSurfaceAt(recWaterParts(rec), pos, 0, nil)
	end
	return {
		Position = pos,
		Velocity = partVelocity(rec.Chassis),
		Yaw = yawOf(cf),
		UpY = cf.UpVector.Y,
		AGL = agl,
		WaterY = waterY,
		Time = t,
	}
end

local function idleStep(rec: VehicleRec, t: number, dt: number)
	if rec.Idle.ReturnPos == nil then
		rec.Idle.ReturnPos = rec.LastValid.Pos
	end
	local out = idleTarget(rec.Mode, rec.Params, rec.Idle, senseFor(rec, t), dt)
	applyOut(rec, out)
end

local function seatInput(seat: VehicleSeat): DriveInput
	-- a dead driver's client stops updating the seat: its last ThrottleFloat (e.g. W held when killed) is stale
	local occ = seat.Occupant
	if occ == nil or (tonumber(occ.Health) or 0) <= 0 then
		return { Throttle = 0, Steer = 0, Lift = 0, Strafe = 0 }
	end
	return { Throttle = unitInput(seat.ThrottleFloat), Steer = unitInput(seat.SteerFloat), Lift = 0, Strafe = 0 }
end

-- F5b: the client's input stream while fresh, else the seat floats (an old cached client sends no stream)
local function serverInput(rec: VehicleRec, t: number): DriveInput
	local occ = rec.Seat.Occupant
	if occ == nil or (tonumber(occ.Health) or 0) <= 0 then
		return { Throttle = 0, Steer = 0, Lift = 0, Strafe = 0 }
	end
	local at = rec.InAt
	if at ~= nil and t - at <= W.StreamStaleSeconds then
		return { Throttle = rec.InT, Steer = rec.InS, Lift = rec.InL, Strafe = 0 }
	end
	return seatInput(rec.Seat)
end

--[[ "The driver is pushing" = input that must move this vehicle. Car/Boat: |throttle| (spec). Aircraft refine
	the spec's rule so nothing trips on a landed craft: a landed heli ignores the stick until it lifts off (lift up
	only), and a plane's throttle-back at rest moves nothing (throttle forward only). ]]
local function pushing(rec: VehicleRec, input: DriveInput): boolean
	local th = W.PushThrottle
	if rec.Mode == "Heli" then
		return input.Lift > th
	elseif rec.Mode == "Plane" then
		return input.Throttle > th
	end
	return math.abs(input.Throttle) > th
end

-- F5i diagnostics: what could pin this vehicle (anchored parts, foreign movers / joints, movers in its riders)
local CONSTRAINT_CLASSES: { [string]: boolean } = {
	AlignOrientation = true, AlignPosition = true, AngularVelocity = true, BallSocketConstraint = true,
	HingeConstraint = true, LineForce = true, LinearVelocity = true, PlaneConstraint = true, Plane = true,
	PrismaticConstraint = true, CylindricalConstraint = true, RigidConstraint = true, RodConstraint = true,
	RopeConstraint = true, SpringConstraint = true, Torque = true, TorsionSpringConstraint = true,
	UniversalConstraint = true, VectorForce = true, AnimationConstraint = true,
}
local BODYMOVER_CLASSES: { [string]: boolean } = {
	BodyAngularVelocity = true, BodyForce = true, BodyGyro = true, BodyPosition = true, BodyThrust = true,
	BodyVelocity = true, RocketPropulsion = true,
}
local JOINT_CLASSES: { [string]: boolean } = {
	Weld = true, Motor = true, Motor6D = true, Snap = true, ManualWeld = true, Glue = true, ManualGlue = true,
	Rotate = true, RotateP = true, RotateV = true, VelocityMotor = true,
}

local function isMover(d: Instance): boolean
	local c = d.ClassName
	return BODYMOVER_CLASSES[c] == true or CONSTRAINT_CLASSES[c] == true or d:IsA("BodyMover") or d:IsA("Constraint")
end

local function isOwnDriveObject(d: Instance): boolean
	local n = d.Name
	return n == "WE_DriveLV"
		or n == "WE_DriveAO"
		or n == "SeatWeld"
		or string.sub(n, 1, 17) == "WE_WheelNoCollide"
		or (d:IsA("HingeConstraint") and d:GetAttribute("WE_DriveHinge") == true)
end

local function riderCharacters(rec: VehicleRec): { Instance }
	local list: { Instance } = {}
	local seats: { BasePart } = { rec.Seat }
	for _, s in ipairs(rec.Passengers) do
		table.insert(seats, s)
	end
	for _, s in ipairs(seats) do
		local occ = if s.Parent then (s :: any).Occupant else nil
		local ch = if occ then occ.Parent else nil
		if ch then
			table.insert(list, ch)
		end
	end
	return list
end

local function countPins(rec: VehicleRec): (number, string)
	local n = 0
	local names: { string } = {}
	local function add(what: string)
		n += 1
		if #names < 3 then
			table.insert(names, what)
		end
	end
	for _, d in ipairs(rec.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Anchored then
				add("anchored:" .. d.Name)
			end
		elseif (isMover(d) or JOINT_CLASSES[d.ClassName] == true or d:IsA("JointInstance")) and not isOwnDriveObject(d) then
			add(d.ClassName .. ":" .. d.Name)
		end
	end
	for _, ch in ipairs(riderCharacters(rec)) do
		for _, d in ipairs(ch:GetDescendants()) do
			if d:IsA("BasePart") then
				if d.Anchored then
					add("rider-anchored:" .. d.Name)
				end
			elseif isMover(d) then
				local c = d.ClassName
				if c ~= "AnimationConstraint" and c ~= "BallSocketConstraint" and c ~= "HingeConstraint" then
					add("rider-" .. c .. ":" .. d.Name)
				end
			end
		end
	end
	return n, table.concat(names, ",")
end

-- occupied passenger seats whose occupant is not a player (F8 ejects them; the log proves it)
local function npcRiders(rec: VehicleRec): number
	local n = 0
	for _, s in ipairs(rec.Passengers) do
		local occ = if s.Parent then s.Occupant else nil
		if occ ~= nil and playerOfHumanoid(occ) == nil then
			n += 1
		end
	end
	return n
end

local function signed(x: number): string
	return string.format("%+.2f", x)
end

-- a client-sent field for a log line: short, printable
local function logField(v: any): string
	local str = string.sub(tostring(v), 1, 16)
	return (string.gsub(str, "[^%w%.%+%-_]", "?"))
end

local function movedFromSit(rec: VehicleRec): number
	local from = rec.HandOffPos
	if from == nil then
		return 0
	end
	local d = rec.Chassis.Position - from
	return if rec.Mode == "Heli" or rec.Mode == "Plane" then d.Magnitude else Vector3.new(d.X, 0, d.Z).Magnitude
end

-- one server log line (F5i)
local function diagLine(rec: VehicleRec, t: number, head: string, extra: any?): string
	local st, detail = ownerState(rec, rec.Owner)
	local seat = rec.Seat
	local ex = ""
	if typeof(extra) == "table" then
		ex = string.format(" extra=T=%s Spd=%s R=%s Src=%s", logField(extra.T), logField(extra.Spd), logField(extra.R), logField(extra.Src))
	end
	local inAge = if rec.InAt ~= nil then string.format("%.1f", t - (rec.InAt :: number)) else "-"
	return string.format(
		"[VehicleService] %s u=%d %s auth=%s own=%s(%s) hello=%d in=%s/%s@%s seatT=%s/%s lvS=%.1f moved=%.1f pins=%d(%s) npc=%d catalog=%s%s",
		head,
		rec.OwnerUserId,
		tostring(rec.Def.Id),
		rec.Authority,
		st,
		detail,
		if rec.HelloAt ~= nil then 1 else 0,
		signed(rec.InT),
		signed(rec.InS),
		inAge,
		signed(unitInput(seat.ThrottleFloat)),
		signed(unitInput(seat.SteerFloat)),
		rec.LV.VectorVelocity.Magnitude,
		movedFromSit(rec),
		rec.Pins,
		rec.PinList,
		npcRiders(rec),
		tostring(rec.Model:GetAttribute("WE_CatalogAssetId") or "-"),
		ex
	)
end

-- F5j: the compact WE_Diag attribute (debug users only); the client's NO DRIVE line parses these key=value pairs
local function diagCompact(rec: VehicleRec): string
	local st = ownerState(rec, rec.Owner)
	local seat = rec.Seat
	return string.format(
		"own=%s hello=%d in=%s/%s seat=%s/%s lv=%.0f moved=%.1f pins=%d npc=%d fail=%s",
		st,
		if rec.HelloAt ~= nil then 1 else 0,
		signed(rec.InT),
		signed(rec.InS),
		signed(unitInput(seat.ThrottleFloat)),
		signed(unitInput(seat.SteerFloat)),
		rec.LV.VectorVelocity.Magnitude,
		movedFromSit(rec),
		rec.Pins,
		npcRiders(rec),
		rec.BrokenReason or "-"
	)
end

-- Fallback / trip: the server runs the Car / Boat law from the client's input stream (or the seat floats).
local function fallbackStep(rec: VehicleRec, t: number, dt: number)
	local sense = senseFor(rec, t)
	local st: DriveState = rec.Fallback or newDriveState(sense)
	rec.Fallback = st
	local input = serverInput(rec, t)
	local out: DriveOut
	if rec.Mode == "Boat" then
		local dir, near, far = boatProbe(st, rec.Params, input)
		local f = fwd(st.Heading) * dir
		local parts = recWaterParts(rec)
		sense.WaterNear = waterSurfaceAt(parts, sense.Position + f * near, 0, nil) ~= nil
		sense.WaterFar = waterSurfaceAt(parts, sense.Position + f * far, 0, nil) ~= nil
		out = boatStep(st, rec.Params, input, sense, dt)
	else
		out = carStep(st, rec.Params, input, sense, dt)
	end
	applyOut(rec, out)
end

-- Car fallback (name kept from v27-v69; the old server LV + "LV+HingeMotor" path is gone: wheels roll
-- free and the WE_DriveLV / WE_DriveAO movers carry the car). Boats share the same loop.
-- F5c: the server both drives and simulates (owns every assembly), so its own mover values act.
local function startGroundDrive(rec: VehicleRec, t: number)
	setAuthority(rec, "Fallback")
	if not setOwner(rec, nil) then
		warn("[VehicleService] Fallback: SetNetworkOwner(nil) refused", rec.Def.Id) -- server writes still replicate to the owner
	end
	rec.Fallback = newDriveState(senseFor(rec, t))
	if rec.Mode == "Car" then
		rec.Model:SetAttribute("WE_GroundDrive", "Fallback")
	end
end

local function stopDrive(rec: VehicleRec)
	rec.Fallback = nil
	if rec.Mode == "Car" then
		rec.Model:SetAttribute("WE_GroundDrive", "Client")
	end
end

-- Driver (owner) seated: give them the physics. fresh = a new sit (vs the end of a correction). F5d.
local function handOff(rec: VehicleRec, player: Player, t: number, fresh: boolean)
	rec.CorrectUntil = nil
	rec.CorrectPos = nil
	rec.DriverUserId = player.UserId
	rec.Model:SetAttribute("WE_DriverUserId", player.UserId)
	local ground = rec.Mode == "Car" or rec.Mode == "Boat"
	if fresh then
		rec.SatAt = t
		rec.HelloAt = nil
		rec.HelloTimedOut = false
		rec.ClientProven = false
		rec.PushSince = nil
		rec.PushPos = nil
		rec.OwnerBad = 0
		rec.BlockPush = 0
		rec.BlockLogged = false
		rec.TripAt = nil
		rec.TripPos = nil
		rec.TripSign, rec.TripLook = nil, nil
		rec.InT, rec.InS, rec.InL, rec.InAt = 0, 0, 0, nil
		rec.HandOffPos = rec.Chassis.Position
		rec.HandOffAt = t
		rec.NextOwnerProbe = t + 0.5
		rec.NextDiagAt = t
		rec.NextDiagLogAt = t
		rec.ClientBroken = ground and W.Enabled and (brokenTrips[player.UserId] or 0) >= W.SessionTrips
		rec.BrokenReason = if rec.ClientBroken then "session" else nil
		rec.ServerProven = rec.ClientBroken
		rec.Model:SetAttribute("WE_DriveFail", rec.BrokenReason)
		rec.Pins, rec.PinList = countPins(rec)
	end
	resetValid(rec, t)
	rec.NextSampleAt = t + 1 / Valid.SampleHz
	stopDrive(rec)
	if ground and (rec.ClientBroken or (rec.HelloTimedOut and rec.HelloAt == nil)) then
		startGroundDrive(rec, t)
		return
	end
	if not setOwner(rec, player) then
		warn("[VehicleService] SetNetworkOwner(driver) refused", rec.Def.Id)
		if ground then
			rec.ClientBroken = true
			rec.BrokenReason = "owner-refused"
			rec.TripAt = t
			rec.TripPos = rec.Chassis.Position
			rec.TripSign = 0 -- no push involved: any server-driven motion proves the client link was the fault
			rec.ServerProven = false
			rec.Model:SetAttribute("WE_DriveFail", "owner-refused")
			startGroundDrive(rec, t)
			return
		end
	end
	setAuthority(rec, "Client")
end

--[[ F5e: a character that left a (possibly server-owned) vehicle assembly goes back to its player explicitly, on the
	next deferred tick (after the SeatWeld is gone). Harmless when the player already owns it. ]]
local function handBackCharacter(player: Player, chassis: BasePart)
	task.defer(function()
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") and not hrp.Anchored and hrp.AssemblyRootPart ~= chassis.AssemblyRootPart then
			pcall(function()
				hrp:SetNetworkOwner(player)
			end)
		end
	end)
end

-- Nobody in the driver seat: the server owns the physics and runs the idle law. F5e.
local function releaseToServer(rec: VehicleRec, t: number)
	local leaving = if rec.DriverUserId ~= 0 then Players:GetPlayerByUserId(rec.DriverUserId) else nil
	stopDrive(rec)
	rec.CorrectUntil = nil
	rec.CorrectPos = nil
	rec.DriverUserId = 0
	rec.Model:SetAttribute("WE_DriverUserId", 0)
	rec.SatAt = nil
	rec.HelloAt = nil
	rec.HelloTimedOut = false
	rec.InT, rec.InS, rec.InL, rec.InAt = 0, 0, 0, nil
	setAuthority(rec, "Server")
	setOwner(rec, nil)
	rec.Idle = {}
	rec.NextIdleAt = t
	rec.LastSeatedAt = t
	if rec.Model:GetAttribute("WE_Diag") ~= nil then
		rec.Model:SetAttribute("WE_Diag", nil)
	end
	if leaving then
		handBackCharacter(leaving, rec.Chassis)
	end
end

local function ejectDriver(rec: VehicleRec)
	ejectSeat(rec.Seat)
end

local function forgetVehicle(model: Model)
	local rec = vehicles[model]
	vehicles[model] = nil
	if rec then
		for _, c in ipairs(rec.Conns) do
			c:Disconnect()
		end
		table.clear(rec.Conns)
		rec.Fallback = nil
		-- the vehicle goes away with riders in it (recall, SPAWN of another, despawn): their characters were part of
		-- the vehicle assembly, which the server may own; give each character back to its player
		local seats: { BasePart } = { rec.Seat }
		for _, ps in ipairs(rec.Passengers) do
			table.insert(seats, ps)
		end
		for _, seat in ipairs(seats) do
			local rider = playerOfHumanoid((seat :: any).Occupant)
			if rider then
				handBackCharacter(rider, rec.Chassis)
			end
		end
	end
end

local function destroyActive(userId: number)
	local model = activeVehicles[userId]
	activeVehicles[userId] = nil
	if model then
		forgetVehicle(model)
		-- Ensure kit parts / welds / seats are fully cleaned
		pcall(function()
			model:Destroy()
		end)
	end
end

local function destroyVehicle(rec: VehicleRec, message: string?)
	local uid = rec.OwnerUserId
	if activeVehicles[uid] == rec.Model then
		destroyActive(uid)
	else
		forgetVehicle(rec.Model)
		pcall(function()
			rec.Model:Destroy()
		end)
	end
	local owner = rec.Owner
	if owner.Parent then
		if message then
			notify(owner, message, "Warn", 4)
		end
		pcall(pushState, owner)
	end
end

local function recallVehicle(rec: VehicleRec, reason: string)
	if AntiExploitService and AntiExploitService.Strike then
		pcall(AntiExploitService.Strike, rec.Owner, "vehicle_" .. reason)
	end
	warn("[VehicleService] recalled", rec.Owner.Name, rec.Def.Id, reason)
	destroyVehicle(rec, "Vehicle recalled")
end

-- Violation: take the physics back and put the vehicle at its last valid position.
local function beginCorrection(rec: VehicleRec, t: number)
	stopDrive(rec)
	setAuthority(rec, "Server")
	local released = setOwner(rec, nil)
	local back = rec.LastValid
	pcall(function()
		rec.Model:PivotTo(back.CFrame)
	end)
	zeroVelocity(rec.Chassis)
	rec.CorrectUntil = t + Valid.CorrectionHold
	rec.CorrectPos = back.Pos
	-- a plane glides at the idle minimum during the hold (bounded, so correctionStep can tell it from a client
	-- that kept the physics)
	rec.Idle = { ReturnPos = back.Pos, GlideSpeed = if rec.Mode == "Plane" then PlaneCfg.IdleGlideMinSpeed else nil }
	rec.NextIdleAt = t
	rec.NextSampleAt = t + 1 / Valid.SampleHz
	resetValid(rec, t)
	if not released then
		ejectDriver(rec) -- ownership cannot be taken back with the driver seated
	end
	if t - rec.LastStabilisedAt >= Drive.StabilisedNoticeSeconds then
		rec.LastStabilisedAt = t
		notify(rec.Owner, "Vehicle stabilised", "Warn", 3)
	end
end

local function onViolation(rec: VehicleRec, reason: string, soft: boolean, t: number)
	if not soft then
		local kept: { number } = {}
		for _, at in ipairs(rec.Violations) do
			if t - at <= Valid.RecallWindow then
				table.insert(kept, at)
			end
		end
		table.insert(kept, t)
		rec.Violations = kept
		if #kept >= Valid.RecallViolations then
			recallVehicle(rec, reason)
			return
		end
	end
	beginCorrection(rec, t)
end

--[[ One 5 Hz check. (ok, reason?, soft). Measures teleports from the last VALID sample (a lag burst
	passes); LastValid only advances when fresh data arrived (the position changed) or the vehicle is
	really at rest, so a frozen replication stream does not shrink the allowance. ]]
local function validateSample(rec: VehicleRec, s: ValidSample): (boolean, string?, boolean)
	local mode = rec.Mode
	local air = mode == "Heli" or mode == "Plane"
	local cap = rec.Params.MaxSpeed * Valid.SpeedTolerance + (if air then Valid.AirSpeedSlack else Valid.SpeedSlack)
	local pos, vel = s.Pos, s.Vel
	local speed = if air then vel.Magnitude else flat(vel).Magnitude
	local prevT = rec.LastSampleT or s.T
	local prevPos = rec.LastSamplePos or pos
	local dtS = math.max(0, s.T - prevT)
	rec.LastSampleT = s.T
	rec.LastSamplePos = pos
	if math.abs(pos.X) > Valid.WorldHalfExtent or math.abs(pos.Z) > Valid.WorldHalfExtent then
		return false, "bounds", false
	end
	local lv = rec.LastValid
	local dtV = math.clamp(s.T - lv.T, 0, Valid.MaxLagWindow)
	local allow = cap * dtV + Valid.TeleportSlack
	local dist = (pos - lv.Pos).Magnitude
	if dist > allow then
		return false, "teleport", dist <= allow + Valid.HardTeleport
	end
	-- Per-sample slack adds up: 20 studs every 0.2 s let a client that reports a sub-cap velocity move at
	-- cap + 100 studs/s (a 55 car at 180). Over a ~1 s window the slack is granted once.
	local win = rec.Window
	if win then
		local wdist = (pos - win.Pos).Magnitude
		local wallow = cap * math.max(0, s.T - win.T) + Valid.TeleportSlack
		if wdist > wallow then
			return false, "teleport", wdist <= wallow + Valid.HardTeleport
		end
	end
	if air then
		if pos.Y > rec.MaxAltitude + Valid.AirAltitudeSlack then
			return false, "altitude", false
		end
	else
		if pos.Y > Valid.GroundMaxY then
			return false, "altitude", false
		end
		if mode == "Car" and vel.Y > Valid.MaxGroundUpSpeed then
			return false, "fling", false
		end
	end
	if speed > cap then
		rec.SpeedFlags += 1
		if rec.SpeedFlags >= Valid.SpeedSamplesToFlag then
			rec.SpeedFlags = 0
			return false, "speed", false
		end
	else
		rec.SpeedFlags = 0
	end
	local overWater = true
	if mode == "Boat" then
		if waterSurfaceAt(recWaterParts(rec), pos, Valid.OffWaterMargin, nil) == nil then
			overWater = false
			rec.OffWaterFor += dtS
			if rec.OffWaterFor > Valid.OffWaterGrace then
				rec.OffWaterFor = 0
				return false, "offwater", true
			end
		else
			rec.OffWaterFor = 0
		end
		local wy = s.WaterY
		if wy ~= nil and pos.Y > wy + Valid.BoatMaxAboveWater then
			return false, "altitude", false
		end
	end
	local fresh = (pos - prevPos).Magnitude > 0.01 or vel.Magnitude < 0.5
	if overWater and fresh then
		rec.LastValid = { CFrame = s.CFrame or CFrame.new(pos), Pos = pos, T = s.T }
		if win == nil or s.T - win.T >= Valid.WindowSeconds then
			rec.Window = { Pos = pos, T = s.T }
		end
	end
	return true, nil, false
end

local function sampleAndCheck(rec: VehicleRec, t: number)
	local cf = rec.Chassis.CFrame
	local pos = cf.Position
	local sample: ValidSample = {
		Pos = pos,
		Vel = partVelocity(rec.Chassis),
		T = t,
		WaterY = if rec.Mode == "Boat" then waterSurfaceAt(recWaterParts(rec), pos, 0, nil) else nil,
		CFrame = cf,
	}
	local ok, reason, soft = validateSample(rec, sample)
	if not ok and reason then
		onViolation(rec, reason, soft, t)
	end
end

-- How fast the idle law itself may carry the vehicle during a correction hold (studs/s). Without this an
-- airborne plane (idle glide ~31 studs/s) drifted past TeleportSlack in ~0.7 s and its pilot was ejected mid-air.
local function idleDriftSpeed(mode: string): number
	if mode == "Plane" then
		return PlaneCfg.IdleGlideMinSpeed + PlaneCfg.IdleGlideSink
	elseif mode == "Heli" then
		return HeliCfg.IdleSink
	elseif mode == "Boat" then
		return BoatCfg.AgroundSpeed + BoatCfg.IdleMaxVy
	end
	return 0
end

local function correctionStep(rec: VehicleRec, t: number)
	local until_ = rec.CorrectUntil
	if until_ == nil then
		return
	end
	if t >= rec.NextSampleAt then
		rec.NextSampleAt = t + 1 / Valid.SampleHz
		local cp = rec.CorrectPos
		local held = math.max(0, t - (until_ - Valid.CorrectionHold))
		if cp and (rec.Chassis.Position - cp).Magnitude > Valid.TeleportSlack + held * idleDriftSpeed(rec.Mode) then
			-- still moving away: the client kept the physics → eject the driver and put it back
			ejectDriver(rec)
			local back = rec.LastValid
			pcall(function()
				rec.Model:PivotTo(back.CFrame)
			end)
			zeroVelocity(rec.Chassis)
		end
	end
	if t >= until_ then
		rec.CorrectUntil = nil
		rec.CorrectPos = nil
		local driver = seatedDriver(rec)
		if driver and driver == rec.Owner then
			handOff(rec, driver, t, false)
		end
	end
end

-- F5g: the client-simulation link is broken for this sit → server drive (Car/Boat) or a notice (aircraft).
local function trip(rec: VehicleRec, reason: string, t: number, extra: any?)
	if rec.ClientBroken then
		return
	end
	rec.ClientBroken = true
	rec.BrokenReason = reason
	rec.TripAt = t
	rec.TripPos = rec.Chassis.Position
	local th = serverInput(rec, t).Throttle
	rec.TripSign = if th > W.PushThrottle then 1 elseif th < -W.PushThrottle then -1 else 0
	rec.TripLook = rec.Chassis.CFrame.LookVector
	rec.ServerProven = false
	rec.BlockPush = 0
	rec.BlockLogged = false
	rec.Model:SetAttribute("WE_DriveFail", reason)
	rec.Pins, rec.PinList = countPins(rec)
	warn(diagLine(rec, t, "NO-DRIVE " .. reason, extra)) -- every player, one line per trip
	if rec.Mode == "Car" or rec.Mode == "Boat" then
		startGroundDrive(rec, t)
	else
		setOwner(rec, rec.Owner) -- aircraft: no server law (spec §5); re-assert and tell the pilot once
		if not rec.FlightNoticeSent then
			rec.FlightNoticeSent = true
			notify(rec.Owner, "Flight controls not responding — jump out and sit again", "Warn", 6)
		end
	end
end

-- 5 Hz next to sampleAndCheck: prove the client-simulated vehicle moves; after a trip, prove server drive does.
local function watchdogStep(rec: VehicleRec, t: number)
	if not W.Enabled or rec.DriverUserId == 0 then
		return
	end
	local air = rec.Mode == "Heli" or rec.Mode == "Plane"
	local pos = rec.Chassis.Position
	local function moved(from: Vector3?): number
		if from == nil then
			return 0
		end
		local d = pos - from
		return if air then d.Magnitude else Vector3.new(d.X, 0, d.Z).Magnitude
	end
	local push = pushing(rec, serverInput(rec, t))
	local last = rec.LastWatchAt
	local since = if last ~= nil then math.clamp(t - last, 0, 0.5) else 0 -- real time between 5 Hz calls
	rec.LastWatchAt = t
	if rec.Authority == "Client" and not rec.ClientProven and not rec.ClientBroken then
		if moved(rec.HandOffPos) > W.ProvenStuds then
			rec.ClientProven = true
			rec.PushSince = nil
			return
		end
		if t - (rec.HandOffAt or t) <= W.OwnerProbeSeconds and t >= rec.NextOwnerProbe then
			rec.NextOwnerProbe = t + 1 / W.OwnerProbeHz
			local st, detail = ownerState(rec, rec.Owner)
			if st == "drv" then
				rec.OwnerBad = 0
			elseif st ~= "unk" then
				rec.OwnerBad += 1
				if rec.OwnerBad == 2 then
					setOwner(rec, rec.Owner) -- one re-assert
				elseif rec.OwnerBad >= 3 then
					trip(rec, "owner:" .. st .. "(" .. detail .. ")", t)
					return
				end
			end
		end
		if push then
			local pushSince = rec.PushSince
			if pushSince == nil then
				rec.PushSince, rec.PushPos = t, pos
			elseif t - pushSince >= W.Seconds and moved(rec.PushPos) < W.MinMoveStuds then
				trip(rec, "nomove", t)
			end
		else
			rec.PushSince = nil
		end
	elseif rec.ClientBroken and rec.Authority == "Fallback" and not rec.ServerProven then
		if moved(rec.TripPos) > W.ProvenStuds then
			rec.ServerProven = true
			-- the client link was the fault only if server drive moved it the way the driver pushed at the trip: a car
			-- parked nose-to-wall trips, then reverses away under server drive; that proves nothing (spec: a blocked
			-- car must not count toward SessionTrips)
			local sign, look, from = rec.TripSign or 0, rec.TripLook, rec.TripPos
			local along = if look and from then (pos - from):Dot(look) * sign else 0
			if sign == 0 or along > W.MinMoveStuds then
				brokenTrips[rec.OwnerUserId] = (brokenTrips[rec.OwnerUserId] or 0) + 1 -- remember it for this session
				print(diagLine(rec, t, "SERVER-DRIVE ok (" .. tostring(rec.BrokenReason) .. ")", nil))
			else
				print(diagLine(rec, t, "SERVER-DRIVE moved away from the trip spot (not counted)", nil))
			end
		elseif push then
			rec.BlockPush += since
			if rec.BlockPush >= W.BlockedSeconds and not rec.BlockLogged then
				rec.BlockLogged = true
				warn(diagLine(rec, t, "BLOCKED (server drive cannot move it either: pinned or wedged)", nil))
			end
		end
	end
end

-- F5j: debug users (Drive.Debug) get WE_Diag at 2 Hz and a server line every ServerLogSeconds while pushing.
local function debugStep(rec: VehicleRec, t: number)
	if rec.DriverUserId == 0 or not isDebugUser(rec.OwnerUserId) then
		return
	end
	if t >= rec.NextDiagAt then
		rec.NextDiagAt = t + 0.5
		rec.Model:SetAttribute("WE_Diag", diagCompact(rec))
	end
	if t >= rec.NextDiagLogAt and pushing(rec, serverInput(rec, t)) then
		rec.NextDiagLogAt = t + DBG.ServerLogSeconds
		print(diagLine(rec, t, "DIAG", nil))
	end
end

local function tickRecord(rec: VehicleRec, t: number, dt: number)
	local model, chassis = rec.Model, rec.Chassis
	if model.Parent == nil or chassis.Parent == nil then
		if activeVehicles[rec.OwnerUserId] == model then
			activeVehicles[rec.OwnerUserId] = nil
		end
		forgetVehicle(model)
		return
	end
	local pos = chassis.Position
	local lim = Valid.WorldHalfExtent + Drive.LostMargin
	if pos.Y < Drive.LostBelowY or math.abs(pos.X) > lim or math.abs(pos.Z) > lim then
		destroyVehicle(rec, "Vehicle lost")
		return
	end
	if anyOccupied(rec) then
		rec.LastSeatedAt = t
	elseif t - rec.LastSeatedAt >= Drive.IdleDespawnSeconds then
		destroyVehicle(rec, nil)
		return
	end
	-- no Hello from the driver's client in time
	local satAt = rec.SatAt
	if rec.DriverUserId ~= 0 and rec.HelloAt == nil and not rec.HelloTimedOut and satAt ~= nil and t - satAt >= Drive.HelloTimeoutSeconds then
		rec.HelloTimedOut = true
		if rec.Mode == "Car" or rec.Mode == "Boat" then
			if rec.Authority == "Client" then
				startGroundDrive(rec, t)
			end
		elseif not rec.FlightNoticeSent then
			rec.FlightNoticeSent = true
			notify(rec.Owner, "Flight controls failed to load — rejoin", "Warn", 6)
		end
	end
	local auth = rec.Authority
	if auth == "Fallback" then
		fallbackStep(rec, t, dt)
	end
	if auth == "Client" or auth == "Fallback" then
		if t >= rec.NextSampleAt then
			rec.NextSampleAt = t + 1 / Valid.SampleHz
			sampleAndCheck(rec, t)
			if vehicles[model] == rec then -- sampleAndCheck can recall (destroy) it
				watchdogStep(rec, t)
			end
		end
	else
		if rec.CorrectUntil ~= nil then
			correctionStep(rec, t)
		end
		if rec.Authority == "Server" and vehicles[model] == rec and t >= rec.NextIdleAt then
			local last = rec.LastIdleAt
			local idt = if last then math.min(t - last, 0.25) else 0
			rec.LastIdleAt = t
			rec.NextIdleAt = t + 1 / Drive.IdleHz
			idleStep(rec, t, idt)
		end
	end
	if vehicles[model] == rec then
		debugStep(rec, t)
	end
end

local function tickAll(dt: number)
	local t = now()
	local list: { VehicleRec } = {}
	for _, rec in pairs(vehicles) do
		table.insert(list, rec)
	end
	for _, rec in ipairs(list) do
		if vehicles[rec.Model] == rec then
			local ok, err = pcall(tickRecord :: any, rec, t, dt)
			if not ok then
				warn("[VehicleService] tick failed", rec.Def.Id, err)
			end
		end
	end
end

-- First sit extras (once per session). Mobile P1-8: no keyboard drive-tip toast any more (key names on phones);
-- the ArmedJeep keeps its cosmetic muzzle-flash cue.
local function onFirstSit(rec: VehicleRec, player: Player)
	local model = rec.Model
	if rec.Mode == "Car" and not sitCueShown[player.UserId] then
		sitCueShown[player.UserId] = true
		if model:GetAttribute("VehicleId") == "ArmedJeep" then
			-- Brief muzzle flash cue (cosmetic; no fire logic)
			local barrel = model:FindFirstChild("Barrel")
			if barrel and barrel:IsA("BasePart") then
				local flash = Instance.new("PointLight")
				flash.Name = "WE_MuzzleFlash"
				flash.Color = Color3.fromRGB(255, 200, 120)
				flash.Brightness = 4
				flash.Range = 14
				flash.Shadows = false
				flash.Parent = barrel
				task.delay(0.18, function()
					if flash.Parent then
						flash:Destroy()
					end
				end)
			end
		end
	end
	-- v36: one-shot SpeedBoost soft offer after the first vehicle sit
	if sitOfferShown[player.UserId] then
		return
	end
	sitOfferShown[player.UserId] = true
	if MonetizationService and MonetizationService.TrySoftOfferSpeedBoost then
		task.defer(function()
			MonetizationService.TrySoftOfferSpeedBoost(player, "vehicle_sit")
		end)
	end
end

local function onDriverChanged(model: Model, occupant: Instance?)
	local rec = vehicles[model]
	if not rec then
		return
	end
	local t = now()
	if occupant == nil then
		if rec.DriverUserId ~= 0 or rec.Authority ~= "Server" then
			releaseToServer(rec, t)
		end
		return
	end
	local player = playerOfHumanoid(occupant)
	if player == nil or player ~= rec.Owner then
		ejectSeat(rec.Seat) -- only the owner can drive; passenger seats take players only (F8)
		return
	end
	rec.EverSeated = true
	rec.LastSeatedAt = t
	refreshMoverLimits(rec) -- AssemblyMass now includes the driver
	handOff(rec, player, t, true)
	onFirstSit(rec, player)
end

-- a stream axis: finite number clamped to [-1, 1], anything else 0
local function axis(v: any): number
	if typeof(v) ~= "number" or v ~= v then
		return 0
	end
	return math.clamp(v, -1, 1)
end

--[[ VehicleDriveInput (F5f). Kinds: Hello {P}, Bye, In {T, S, L} (10 Hz while any axis is non-zero), Stuck (once per
	sit), Exit (touch jump / EXIT pill). Only the seated owner-driver of their own active vehicle is heard; the
	messages carry clamped inputs only, never positions or velocities. ]]
local function handleDriveInput(player: Player, msg: any)
	if typeof(msg) ~= "table" then
		if AntiExploitService and AntiExploitService.Strike then
			pcall(AntiExploitService.Strike, player, "vehicle_input_payload")
		end
		return
	end
	local kind = msg.K
	local key: string, rate: number, burst: number
	if kind == "In" then
		key, rate, burst = "vehicle_drive_stream", W.StreamRate, W.StreamBurst
	elseif kind == "Hello" or kind == "Bye" or kind == "Stuck" then
		key, rate, burst = "vehicle_drive_input", 4, 2
	elseif kind == "Exit" then
		key, rate, burst = "vehicle_exit", 4, 2
	else
		return
	end
	if RateLimitService and not RateLimitService.Allow(player, key, rate, burst) then
		return
	end
	if not RemoteGuard.IsIdString(msg.V, 48) then
		return
	end
	local model = activeVehicles[player.UserId]
	local rec = if model then vehicles[model] else nil
	if rec == nil or rec.Model:GetAttribute("VehicleId") ~= msg.V then
		return
	end
	if seatedDriver(rec) ~= player or rec.DriverUserId ~= player.UserId then
		return
	end
	local t = now()
	if kind == "In" then
		rec.InT, rec.InS, rec.InL = axis(msg.T), axis(msg.S), axis(msg.L)
		rec.InAt = t
		return
	elseif kind == "Exit" then
		ejectSeat(rec.Seat) -- works whoever simulates the seat (a client jump may not leave a server-owned seat)
		return
	elseif kind == "Stuck" then
		if rec.Authority == "Client" and not rec.ClientProven then
			local air = rec.Mode == "Heli" or rec.Mode == "Plane"
			-- aircraft: only when the server also sees input that must move the craft (a landed heli ignores the stick)
			if not air or pushing(rec, serverInput(rec, t)) then
				trip(rec, "client-stuck", t, msg)
			end
		end
		return
	elseif kind == "Hello" then
		if msg.P ~= nil and msg.P ~= Drive.ProtocolVersion then
			return -- an old client: it refuses to drive; Car/Boat fall back after the timeout
		end
		rec.HelloAt = t
		if rec.Authority == "Fallback" and not rec.ClientBroken then
			stopDrive(rec)
			if setOwner(rec, player) then
				setAuthority(rec, "Client")
			else
				startGroundDrive(rec, t)
			end
		end
	elseif rec.Mode == "Car" or rec.Mode == "Boat" then
		-- Bye while still seated: the client stopped driving → the server takes over
		if rec.Authority == "Client" then
			rec.HelloAt = nil
			rec.HelloTimedOut = true
			startGroundDrive(rec, t)
		end
	end
end

local function researchMult(player: Player, statId: string, maxBonus: number): number
	local rs = ResearchService
	if rs == nil or typeof(rs.GetBonus) ~= "function" then
		return 1
	end
	local ok, v = pcall(rs.GetBonus, player, statId)
	local n = if ok then tonumber(v) else nil
	if n == nil or n ~= n then
		return 1
	end
	return math.clamp(n, 1, maxBonus)
end

local function registerVehicle(player: Player, model: Model, def: VehicleDef, mode: string, spawn: SpawnChoice): VehicleRec?
	local chassis = model.PrimaryPart
	local seat = model:FindFirstChild("DriverSeat")
	if not (chassis and seat and seat:IsA("VehicleSeat")) then
		return nil
	end
	local lv = chassis:FindFirstChild("WE_DriveLV")
	local ao = chassis:FindFirstChild("WE_DriveAO")
	if not (lv and lv:IsA("LinearVelocity") and ao and ao:IsA("AlignOrientation")) then
		return nil
	end
	local passengers: { Seat } = {}
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("Seat") then
			table.insert(passengers, c)
		end
	end
	local t = now()
	local baseMax = tonumber(model:GetAttribute("WE_BaseMaxSpeed")) or def.Speed
	local cf = chassis.CFrame
	local rec: VehicleRec = {
		Model = model,
		Owner = player,
		OwnerUserId = player.UserId,
		Def = def,
		Mode = mode,
		Chassis = chassis,
		Seat = seat,
		Passengers = passengers,
		LV = lv,
		AO = ao,
		Params = {
			MaxSpeed = tonumber(model:GetAttribute("WE_MaxSpeed")) or baseMax,
			Accel = tonumber(model:GetAttribute("WE_Accel")) or 20,
			TurnRate = tonumber(model:GetAttribute("WE_TurnRate")) or 1,
			Tracked = model:GetAttribute("WE_Tracked") == true,
			RideOffset = tonumber(model:GetAttribute("WE_RideOffset")) or 0,
			HalfLength = tonumber(model:GetAttribute("WE_HalfLength")) or 5,
		},
		BaseMaxSpeed = baseMax,
		MaxAltitude = tonumber(model:GetAttribute("WE_MaxAltitude")) or Valid.GroundMaxY,
		Force = lv.MaxAxesForce.X,
		Authority = "Server",
		DriverUserId = 0,
		SatAt = nil,
		HelloAt = nil,
		HelloTimedOut = false,
		FlightNoticeSent = false,
		EverSeated = false,
		LastSeatedAt = t,
		LastValid = { CFrame = cf, Pos = cf.Position, T = t },
		Window = { Pos = cf.Position, T = t },
		LastSampleT = t,
		LastSamplePos = cf.Position,
		NextSampleAt = t,
		NextIdleAt = t,
		LastIdleAt = nil,
		SpeedFlags = 0,
		OffWaterFor = 0,
		Violations = {},
		CorrectUntil = nil,
		CorrectPos = nil,
		Idle = {},
		Fallback = nil,
		LastStabilisedAt = -math.huge,
		Conns = {},
		OutVel = nil,
		OutHold = nil,
		OutRot = nil,
		OwnParts = ownPartsOf(model, chassis),
		InT = 0,
		InS = 0,
		InL = 0,
		InAt = nil,
		ClientProven = false,
		ClientBroken = false,
		ServerProven = false,
		BrokenReason = nil,
		HandOffPos = nil,
		HandOffAt = nil,
		PushSince = nil,
		PushPos = nil,
		OwnerBad = 0,
		NextOwnerProbe = t,
		TripAt = nil,
		TripPos = nil,
		BlockPush = 0,
		BlockLogged = false,
		LastWatchAt = nil,
		Pins = 0,
		PinList = "",
		NextDiagAt = t,
		NextDiagLogAt = t,
	}
	vehicles[model] = rec
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end
	setOwner(rec, nil)
	refreshMoverLimits(rec)
	if spawn.State == "Airborne" and spawn.Speed > 0 then
		-- air start: moving at 1.3 x takeoff speed, held by the idle glide until the pilot sits
		local look = flat(cf.LookVector)
		look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
		pcall(function()
			chassis.AssemblyLinearVelocity = look * spawn.Speed
		end)
		rec.Idle.GlideSpeed = spawn.Speed
		lv.MaxAxesForce = Vector3.new(rec.Force, rec.Force, rec.Force)
		lv.VectorVelocity = look * spawn.Speed + Vector3.new(0, -PlaneCfg.IdleGlideSink, 0)
	end
	idleStep(rec, t, 0)
	table.insert(
		rec.Conns,
		seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			onDriverChanged(model, seat.Occupant)
		end)
	)
	-- F8: passenger seats take players only. NPC squad units / guards never ride (their BodyGyro would steer the car).
	-- A player leaving a passenger seat gets their character handed back (the car may be server-owned).
	for _, ps in ipairs(passengers) do
		local prevRider: Player? = nil
		table.insert(
			rec.Conns,
			ps:GetPropertyChangedSignal("Occupant"):Connect(function()
				local occ = ps.Occupant
				local rider = playerOfHumanoid(occ)
				if prevRider and prevRider ~= rider then
					handBackCharacter(prevRider, chassis)
				end
				prevRider = rider
				if occ ~= nil and rider == nil then
					task.defer(function()
						if ps.Occupant == occ then
							ejectSeat(ps)
						end
					end)
				end
			end)
		)
	end
	return rec
end

function VehicleService.Owns(player: Player, vehicleId: string): boolean
	local profile = DataService.GetProfile(player)
	return profile ~= nil and profile.Vehicles[vehicleId] == true
end

function VehicleService.GrantVehicle(player: Player, vehicleId: string)
	local profile = DataService.GetProfile(player)
	if not profile or not getDef(vehicleId) then
		return
	end
	profile.Vehicles[vehicleId] = true
	DataService.MarkDirty(player)
	pushState(player)
end

function VehicleService.Purchase(player: Player, vehicleId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(vehicleId, 48) then
		return false, "InvalidId"
	end
	local def = getDef(vehicleId)
	if not def then
		return false, "UnknownVehicle"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Vehicles[vehicleId] then
		return false, "AlreadyOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local okStruct, structErr = meetsStructureReq(profile, def)
	if not okStruct then
		return false, structErr
	end
	local okPres, presErr = meetsPrestigeReq(profile, def)
	if not okPres then
		return false, presErr
	end
	local cost = def.CostCash or 0
	if cost > 0 then
		local ok, err = EconomyService.SpendCash(player, cost, "vehicle_" .. vehicleId)
		if not ok then
			return false, err or "SpendFailed"
		end
	end
	profile.Vehicles[vehicleId] = true
	DataService.MarkDirty(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.VEHICLE_PURCHASED, player.UserId, {
			vehicle = vehicleId,
			cost = cost,
		})
	end
	if NotificationService then
		NotificationService.Notify(player, "Acquired " .. def.DisplayName, "Reward")
	end
	pushState(player)
	return true, nil
end

function VehicleService.Despawn(player: Player)
	destroyActive(player.UserId)
	pushState(player)
end

function VehicleService.RequestSpawn(player: Player, vehicleId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(vehicleId, 48) then
		return false, "InvalidId"
	end
	local def = getDef(vehicleId)
	if not def then
		return false, "UnknownVehicle"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if not profile.Vehicles[vehicleId] then
		return false, "NotOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local okStruct, structErr = meetsStructureReq(profile, def)
	if not okStruct then
		return false, structErr
	end
	local okPres, presErr = meetsPrestigeReq(profile, def)
	if not okPres then
		return false, presErr
	end
	if cooldownLeft(player.UserId, player) > 0 then
		return false, "Cooldown"
	end
	if damageLockLeft(player.UserId) > 0 then
		return false, "InCombat" -- P1-9: SPAWN is not an escape from a fight
	end
	-- P1-9: inside your own plot the garage flow seats you on your own pad / helipad / runway / basin; anywhere
	-- else only a vehicle that appears next to you (in front of you) seats you. Never a cross-map teleport.
	local sitRadius = if playerAtHome(player, profile) then SpawnCfg.AutoSitHomeRadius else SpawnCfg.AutoSitRadius

	-- 1) build unparented at the origin (movers + drive attributes included)
	local bonus = researchMult(player, "VehicleSpeed", Drive.MaxResearchSpeedBonus)
	local armorMult = researchMult(player, "VehicleArmor", Drive.MaxResearchArmorBonus)
	local buildOk, modelOrErr = pcall(function()
		return buildVehicleModel(def, CFrame.identity, player.UserId, bonus, armorMult)
	end)
	if not buildOk or typeof(modelOrErr) ~= "Instance" then
		warn("[VehicleService] buildVehicleModel failed", vehicleId, modelOrErr)
		return false, "SpawnBuildFailed"
	end
	local model = modelOrErr :: Model
	local function discard()
		pcall(function()
			model:Destroy()
		end)
	end
	if not model.PrimaryPart or not model:FindFirstChild("DriverSeat") then
		warn("[VehicleService] spawn kit incomplete", vehicleId, "PrimaryPart/DriverSeat missing")
		discard()
		return false, "SpawnKitIncomplete"
	end
	local mode = driveModeFor(def)

	-- 2) footprint → 3) choose the spawn (the player's current vehicle is replaced, so it is not "occupied")
	local fp = footprintOf(model)
	local attrs = model:GetAttributes()
	local ctxOk, chosen, chooseErr = pcall(function(): (SpawnChoice?, string?)
		return chooseSpawn(buildSpawnCtx(player, profile, mode, fp, attrs, activeVehicles[player.UserId]))
	end)
	if not ctxOk then
		warn("[VehicleService] spawn choice failed", vehicleId, chosen)
		discard()
		return false, "SpawnBuildFailed"
	end
	local spawn = chosen :: SpawnChoice?
	if spawn == nil then
		discard()
		return false, chooseErr or "NoWater"
	end

	-- One active vehicle per player: the old one goes now
	destroyActive(player.UserId)

	-- 4) PivotTo → parent → hand over
	model:PivotTo(spawn.CFrame)
	model:SetAttribute("WE_SpawnState", spawn.State)
	if spawn.Speed > 0 then
		model:SetAttribute("WE_SpawnSpeed", spawn.Speed)
	end
	model.Parent = ensureFolder()
	if not model.Parent then
		warn("[VehicleService] spawn model unparented", vehicleId)
		discard()
		return false, "SpawnOrphaned"
	end
	local rec = registerVehicle(player, model, def, mode, spawn)
	if not rec then
		warn("[VehicleService] spawn kit incomplete (movers)", vehicleId)
		discard()
		return false, "SpawnKitIncomplete"
	end
	activeVehicles[player.UserId] = model
	lastSpawnAt[player.UserId] = now()

	-- Driveability: Drive prompt + auto-sit the DriverSeat so garage SPAWN is immediately usable
	local autoSeat = false
	do
		local seat = rec.Seat
		seat.Disabled = false
		seat.Anchored = false
		seat.CanTouch = true
		-- Drive prompt if auto-sit misses (mobile / late character); clients hide it on vehicles they don't own
		if not seat:FindFirstChild("WE_DrivePrompt") then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "WE_DrivePrompt"
			prompt.ActionText = "Drive"
			prompt.ObjectText = def.DisplayName or "Vehicle"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 14
			prompt.RequiresLineOfSight = false
			prompt.Parent = seat
			table.insert(
				rec.Conns,
				prompt.Triggered:Connect(function(who: Player)
					if who ~= player then
						return
					end
					local ch = who.Character
					local hum = ch and ch:FindFirstChildOfClass("Humanoid")
					if hum and seat.Occupant == nil then
						pcall(function()
							seat:Sit(hum)
						end)
					end
				end)
			)
		end
		-- "close" = the player's root part within sitRadius of the vehicle's footprint (centre distance - radius)
		local reach = footRadius(fp)
		local function seatNear(): boolean
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			return hrp ~= nil and hrp:IsA("BasePart") and (hrp.Position - rec.Chassis.Position).Magnitude - reach <= sitRadius
		end
		autoSeat = seatNear()
		local function trySit()
			if rec.EverSeated or not player.Parent or not model.Parent or not seat.Parent then
				return
			end
			local character = player.Character
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hum and hrp and seat.Occupant == nil and seatNear() then
				-- Place character on seat so Sit always has a valid near-seat humanoid
				hrp.CFrame = seat.CFrame * CFrame.new(0, 2.5, 0)
				pcall(function()
					seat:Sit(hum)
				end)
			end
		end
		task.defer(trySit)
		task.delay(0.2, trySit)
		task.delay(0.5, trySit)
		task.delay(1.0, trySit)
		task.delay(2.0, trySit)
	end

	if profile.Stats then
		profile.Stats.VehiclesSpawned = (profile.Stats.VehiclesSpawned or 0) + 1
	end
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "SpawnVehicle", 1)
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "SpawnVehicle", vehicleId)
	end
	DataService.MarkDirty(player)

	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.VEHICLE_SPAWNED, player.UserId, {
			vehicle = vehicleId,
			source = spawn.Source,
		})
	end
	local at = spawn.CFrame.Position
	print(string.format(
		"[VehicleService] SPAWN ok %s → %s (%s) @ %s (%.0f,%.0f,%.0f)",
		player.Name,
		tostring(vehicleId),
		mode,
		spawn.Source,
		at.X,
		at.Y,
		at.Z
	))
	if NotificationService then
		local msg = if autoSeat then "Deployed " .. def.DisplayName else "Deployed " .. def.DisplayName .. " — walk over to drive"
		NotificationService.Notify(player, msg, "Success")
	end
	pushState(player)
	return true, nil
end

function VehicleService.PushState(player: Player)
	pushState(player)
end

-- Research workflow: call after a vehicle upgrade so a vehicle that is already out picks it up.
function VehicleService.OnResearchChanged(player: Player)
	local model = activeVehicles[player.UserId]
	local rec = if model then vehicles[model] else nil
	if rec == nil then
		return
	end
	local bonus = researchMult(player, "VehicleSpeed", Drive.MaxResearchSpeedBonus)
	rec.Params.MaxSpeed = rec.BaseMaxSpeed * bonus
	rec.Model:SetAttribute("WE_MaxSpeed", rec.Params.MaxSpeed)
	rec.Model:SetAttribute("WE_ArmorMult", researchMult(player, "VehicleArmor", Drive.MaxResearchArmorBonus))
end

-- ── Test hooks (headless sim; spec §7) ─────────────────────────────────────────────────────────
VehicleService._DriveModeFor = driveModeFor
VehicleService._DriveAttributes = driveAttributes
VehicleService._Footprint = footprintOf
VehicleService._WaterSurfaceAt = waterSurfaceAt
VehicleService._IsConnectedToSea = isConnectedToSea
VehicleService._ChooseSpawn = chooseSpawn
VehicleService._BuildSpawnCtx = buildSpawnCtx
VehicleService._ValidateSample = validateSample
VehicleService._IdleTarget = idleTarget
VehicleService._OnDriverChanged = onDriverChanged
VehicleService._HandleDriveInput = handleDriveInput
VehicleService._Build = function(def: VehicleDef, at: CFrame?, ownerUserId: number?, bonus: number?): Model
	return buildVehicleModel(def, at or CFrame.identity, ownerUserId or 0, bonus, 1)
end
VehicleService._Laws = {
	NewState = newDriveState,
	CarStep = carStep,
	BoatStep = boatStep,
	BoatProbe = boatProbe,
	Idle = idleTarget,
}
VehicleService._Tick = tickAll
VehicleService._Record = function(model: Model): any
	return vehicles[model]
end
VehicleService._BrokenTrips = function(userId: number): number
	return brokenTrips[userId] or 0
end
VehicleService._DamageLockLeft = damageLockLeft
VehicleService._OnViolation = function(model: Model, reason: string, soft: boolean)
	local rec = vehicles[model]
	if rec then
		onViolation(rec, reason, soft, now())
	end
end

function VehicleService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	MonetizationService = deps.MonetizationService
	ResearchService = deps.ResearchService
	AntiExploitService = deps.AntiExploitService

	ensureFolder()
	refreshWaterParts()
	waterRefreshAt = now() + WaterCfg.RefreshSeconds
	CollectionService:GetInstanceAddedSignal(Constants.Tags.Water):Connect(function()
		waterRefreshAt = 0
	end)
	CollectionService:GetInstanceRemovedSignal(Constants.Tags.Water):Connect(function()
		waterRefreshAt = 0
	end)

	local spawnRemote = RemoteSetup.Get(Constants.RemoteNames.RequestSpawnVehicle) :: RemoteEvent
	spawnRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
		if not RateLimitService.Allow(player, "spawn_vehicle", 1, 2) then
			if NotificationService then
				NotificationService.Notify(player, "Spawn too fast — wait a moment", "Warn", 2)
			end
			return
		end
		print(string.format("[VehicleService] Remote SPAWN attempt %s → %s", player.Name, tostring(vehicleId)))
		local ok, err = VehicleService.RequestSpawn(player, vehicleId)
		print(string.format("[VehicleService] Remote SPAWN result %s → Ok=%s Err=%s", player.Name, tostring(ok), tostring(err)))
		if not ok and NotificationService and err then
			local def = if typeof(vehicleId) == "string" then getDef(vehicleId) else nil
			NotificationService.Notify(player, errorText(err, def, player), "Warn")
		end
	end)

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseVehicle) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
		if not RateLimitService.Allow(player, "buy_vehicle", 2, 3) then
			return
		end
		local ok, err = VehicleService.Purchase(player, vehicleId)
		if not ok and err then
			if err == "AlreadyOwned" then
				pcall(pushState, player)
			end
			if NotificationService then
				local def = if typeof(vehicleId) == "string" then getDef(vehicleId) else nil
				NotificationService.Notify(player, errorText(err, def, player), "Warn")
			end
		end
	end)

	local despawnRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDespawnVehicle) :: RemoteEvent
	despawnRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "despawn_vehicle", 2, 3) then
			return
		end
		VehicleService.Despawn(player)
	end)

	local driveRemote = RemoteSetup.Get(Constants.RemoteNames.VehicleDriveInput) :: RemoteEvent
	driveRemote.OnServerEvent:Connect(function(player: Player, msg: any)
		handleDriveInput(player, msg)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		local starter = VehicleConfig.StarterVehicle
		if not profile.Vehicles[starter] then
			profile.Vehicles[starter] = true
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)

	RunService.Heartbeat:Connect(tickAll)

	-- P1-9: remember when each player's character last took damage (a Health drop at an unchanged MaxHealth;
	-- CombatService's spawn reset of MaxHealth / regen never counts)
	local function watchCharacter(player: Player, character: Model)
		task.spawn(function()
			local found = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
			if not (found and found:IsA("Humanoid")) then
				return
			end
			local hum = found :: Humanoid
			local lastHealth, lastMax = hum.Health, hum.MaxHealth
			hum.HealthChanged:Connect(function(h: number)
				local max = hum.MaxHealth
				if h < lastHealth - 0.01 and max == lastMax then
					lastDamageAt[player.UserId] = now()
				end
				lastHealth, lastMax = h, max
			end)
		end)
	end
	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character: Model)
			watchCharacter(player, character)
		end)
		local character = player.Character
		if character then
			watchCharacter(player, character)
		end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		destroyActive(player.UserId)
		lastSpawnAt[player.UserId] = nil
		lastDamageAt[player.UserId] = nil
		brokenTrips[player.UserId] = nil
		sitCueShown[player.UserId] = nil
		sitOfferShown[player.UserId] = nil
	end)
end

return VehicleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">VisualAssetService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Loads free Creator Store Models via InsertService (fallback AssetService).
	Caches clones; strips all scripts; never blocks Part-kit spawn on failure.
	Respects DevConfig.StudioSkipWorldDressing for 8GB Studio PERF.
]]

local InsertService = game:GetService("InsertService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualAssetConfig = require(Shared.Configs.VisualAssetConfig)
local DevConfig = require(Shared.Configs.DevConfig)

local VisualAssetService = {}

local cache: { [number]: Model } = {} -- template models (parented to nil / folder)
local failed: { [number]: boolean } = {}
local templateStrips: { [number]: { [string]: number } } = {} -- what loadModel stripped from each template
local dressLogged: { [number]: boolean } = {} -- vehicle dress strip summary printed once per assetId
local loadAttempts = 0
local templatesFolder: Folder? = nil

local function ensureFolder(): Folder
	if templatesFolder and templatesFolder.Parent then
		return templatesFolder
	end
	local f = Instance.new("Folder")
	f.Name = "WE_VisualAssetTemplates"
	f.Parent = ReplicatedStorage
	templatesFolder = f
	return f
end

local function shouldSkipInserts(): boolean
	if not VisualAssetConfig.Enabled then
		return true
	end
	if RunService:IsStudio() then
		local force = DevConfig.StudioForceDress == true
		if DevConfig.StudioSkipWorldDressing ~= false and not force then
			return true
		end
	end
	return false
end

local function stripScripts(root: Instance)
	if not VisualAssetConfig.StripScripts then
		return
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	-- Also direct children scripts
	for _, c in ipairs(root:GetChildren()) do
		if c:IsA("BaseScript") or c:IsA("ModuleScript") then
			c:Destroy()
		end
	end
end

--[[ v70 judge (jeep "doesn't drive", R3): a catalog dress model is welded into the vehicle's Chassis assembly, so any
	mover, joint or gameplay object it carries acts on (or rides with) the whole vehicle. A saved BodyVelocity /
	BodyPosition / AlignPosition is a hidden parking brake; a BodyGyro blocks turning. Strip by explicit class name
	(works the same in the headless sim) PLUS the abstract bases. WeldConstraint / NoCollisionConstraint are not
	Constraint subclasses, so they are listed by name. Every part is re-welded to the primary afterwards. ]]
local STRIP_CLASSES: { [string]: boolean } = {
	Humanoid = true, Tool = true, Seat = true, VehicleSeat = true, SpawnLocation = true,
	Script = true, LocalScript = true, ModuleScript = true,
	-- Constraint family
	AlignOrientation = true, AlignPosition = true, AngularVelocity = true, BallSocketConstraint = true,
	HingeConstraint = true, LineForce = true, LinearVelocity = true, PlaneConstraint = true, Plane = true,
	PrismaticConstraint = true, CylindricalConstraint = true, RigidConstraint = true, RodConstraint = true,
	RopeConstraint = true, SpringConstraint = true, Torque = true, TorsionSpringConstraint = true,
	UniversalConstraint = true, VectorForce = true, AnimationConstraint = true,
	-- legacy movers
	BodyAngularVelocity = true, BodyForce = true, BodyGyro = true, BodyPosition = true, BodyThrust = true,
	BodyVelocity = true, RocketPropulsion = true,
	-- joints (every part is re-welded to the primary below)
	Weld = true, Motor6D = true, Motor = true, Snap = true, ManualWeld = true, Glue = true, ManualGlue = true,
	Rotate = true, RotateP = true, RotateV = true, VelocityMotor = true, WeldConstraint = true, NoCollisionConstraint = true,
	-- gameplay objects a dress model must never bring along
	ProximityPrompt = true, ClickDetector = true, DragDetector = true, Sound = true, ForceField = true,
}
local STRIP_BASES = { "Constraint", "BodyMover", "JointInstance", "LuaSourceContainer" }

local function shouldStrip(d: Instance): boolean
	if STRIP_CLASSES[d.ClassName] then
		return true
	end
	for _, b in ipairs(STRIP_BASES) do
		if d:IsA(b) then
			return true
		end
	end
	return false
end

-- Destroys every strippable descendant; returns { [ClassName] = count } (children of a stripped object not counted).
local function stripDress(root: Instance): { [string]: number }
	local counts: { [string]: number } = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d.Parent ~= nil and shouldStrip(d) then
			counts[d.ClassName] = (counts[d.ClassName] or 0) + 1
			d:Destroy()
		end
	end
	return counts
end

local function mergeCounts(into: { [string]: number }, from: { [string]: number }?)
	if from then
		for k, n in pairs(from) do
			into[k] = (into[k] or 0) + n
		end
	end
end

local function stripSummary(counts: { [string]: number }): string
	local keys: { string } = {}
	for k in pairs(counts) do
		table.insert(keys, k)
	end
	if #keys == 0 then
		return "stripped nothing"
	end
	table.sort(keys)
	local parts: { string } = {}
	for _, k in ipairs(keys) do
		table.insert(parts, k .. "×" .. tostring(counts[k]))
	end
	return "stripped " .. table.concat(parts, ", ")
end

-- Template prep shared by loadModel and the test hook: dress-strip once, then anchor for the template.
local function prepareTemplate(assetId: number, model: Model)
	stripScripts(model)
	templateStrips[assetId] = stripDress(model)
	model.Name = "WE_Asset_" .. tostring(assetId)
	-- Anchor all for template; clones will reconfigure
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CastShadow = false
			d.Massless = true
		end
	end
end

local function loadModel(assetId: number, forceInsert: boolean?): Model?
	if assetId == 0 or failed[assetId] then
		return nil
	end
	if cache[assetId] then
		return cache[assetId]
	end
	-- P0: character dress MUST run even when StudioSkipWorldDressing (workers never brown bricks)
	if shouldSkipInserts() and not forceInsert then
		return nil
	end
	if loadAttempts >= (VisualAssetConfig.MaxLoadAttempts or 36) then
		return nil
	end
	loadAttempts += 1

	local ok, result = pcall(function()
		return InsertService:LoadAsset(assetId)
	end)
	if not ok or typeof(result) ~= "Instance" then
		-- AssetService fallback (newer API)
		local AssetService = game:GetService("AssetService")
		if AssetService and (AssetService :: any).LoadAssetAsync then
			ok, result = pcall(function()
				return (AssetService :: any):LoadAssetAsync(assetId)
			end)
		end
	end
	if not ok or typeof(result) ~= "Instance" then
		failed[assetId] = true
		warn("[VisualAssetService] LoadAsset failed", assetId, result)
		return nil
	end

	local container = result :: Instance
	stripScripts(container)
	local model: Model? = nil
	if container:IsA("Model") then
		model = container
	else
		for _, c in ipairs(container:GetChildren()) do
			if c:IsA("Model") then
				model = c
				break
			end
		end
	end
	if not model then
		failed[assetId] = true
		container:Destroy()
		warn("[VisualAssetService] No Model in asset", assetId)
		return nil
	end

	prepareTemplate(assetId, model)
	model.Parent = ensureFolder()
	cache[assetId] = model
	if container ~= model and container.Parent == nil then
		-- LoadAsset returns Model in a Model container sometimes
		pcall(function()
			container:Destroy()
		end)
	elseif container ~= model then
		-- keep only our template
		for _, c in ipairs(container:GetChildren()) do
			if c ~= model then
				c:Destroy()
			end
		end
		model.Parent = ensureFolder()
		pcall(function()
			container:Destroy()
		end)
	end
	print("[VisualAssetService] Cached catalog model", assetId, model.Name)
	return model
end

-- Returns (attached, { [ClassName] = count } stripped from this clone).
local function weldCloneToPrimary(clone: Model, primary: BasePart, cloneName: string): (boolean, { [string]: number })
	stripScripts(clone)
	clone.Name = cloneName

	-- Strip seats / humanoids / scripts / movers / joints / prompts / sounds — mesh is dress-only, never drive
	local stripped = stripDress(clone)

	pcall(function()
		clone:PivotTo(primary.CFrame)
	end)

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			d.CastShadow = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return true, stripped
end

function VisualAssetService.IsInsertEnabled(): boolean
	return not shouldSkipInserts()
end

function VisualAssetService.ResolveVehicleAssetId(vehicleId: string, kitFamily: string?): number?
	local ref = VisualAssetConfig.Vehicles[vehicleId]
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	if kitFamily and VisualAssetConfig.KitFamilyFallback[kitFamily] then
		local key = VisualAssetConfig.KitFamilyFallback[kitFamily]
		local fb = VisualAssetConfig.Vehicles[key]
		if fb and typeof(fb.ModelAssetId) == "number" and (fb.ModelAssetId :: number) > 0 then
			return fb.ModelAssetId
		end
	end
	return nil
end

function VisualAssetService.ResolveCharacterAssetId(kind: string): number?
	local ref = VisualAssetConfig.Characters[kind]
	if not ref and kind == "Worker" then
		ref = VisualAssetConfig.Characters.Infantry or VisualAssetConfig.Characters.Soldier
	end
	if not ref then
		ref = VisualAssetConfig.Characters.Soldier
	end
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	local alt = (VisualAssetConfig :: any).CharacterAlt
	if alt and typeof(alt.ModelAssetId) == "number" and (alt.ModelAssetId :: number) > 0 then
		return alt.ModelAssetId
	end
	return nil
end

function VisualAssetService.ResolveBuildingAssetId(structureId: string): number?
	local ref = VisualAssetConfig.Buildings[structureId]
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	-- Fallback StructureVisualConfig.MeshAssetId (0 = composite / Part kit only)
	local ok, svc = pcall(function()
		return require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
	end)
	if ok and svc and svc.Palettes then
		local pal = svc.Palettes[structureId]
		if pal and typeof(pal.MeshAssetId) == "number" and (pal.MeshAssetId :: number) > 0 then
			return pal.MeshAssetId
		end
	end
	return nil
end

local function lookupPropRef(propKey: string): any
	local buckets = {
		(VisualAssetConfig :: any).WarzoneProps,
		VisualAssetConfig.DesertProps,
		(VisualAssetConfig :: any).MapDressing,
		(VisualAssetConfig :: any).IndustrialProps,
		(VisualAssetConfig :: any).Landmarks,
	}
	for _, bucket in ipairs(buckets) do
		if typeof(bucket) == "table" then
			local ref = bucket[propKey]
			if typeof(ref) == "table" then
				return ref
			end
		end
	end
	return nil
end

function VisualAssetService.ResolvePropAssetId(propKey: string): number?
	local ref = lookupPropRef(propKey)
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	return nil
end

function VisualAssetService.ResolvePropMeshId(propKey: string): number?
	local ref = lookupPropRef(propKey)
	if ref and typeof(ref.MeshId) == "number" and (ref.MeshId :: number) > 0 then
		return ref.MeshId
	end
	return nil
end

--[[
	Clone catalog visual under hostModel, welded to primary, non-colliding.
	Returns true if attached. Never destroys host Part kit.
]]
function VisualAssetService.TryAttachVehicleVisual(hostModel: Model, vehicleId: string, kitFamily: string?): boolean
	local assetId = VisualAssetService.ResolveVehicleAssetId(vehicleId, kitFamily)
	if not assetId then
		return false
	end
	local template = loadModel(assetId)
	-- Design P0: NO JeepFallback 59524622. Part-kit hinge chassis remains if mesh fails.
	if not template then
		return false -- Part kit remains authoritative (hinge-drive)
	end
	local primary = hostModel.PrimaryPart
	if not primary then
		return false
	end

	local clone = template:Clone()
	local attached, stripped = weldCloneToPrimary(clone, primary, "WE_CatalogVisual")
	if not attached then
		clone:Destroy()
		return false
	end
	if not dressLogged[assetId] then
		dressLogged[assetId] = true
		local counts: { [string]: number } = {}
		mergeCounts(counts, templateStrips[assetId])
		mergeCounts(counts, stripped)
		print(string.format("[VisualAssetService] dress %d on %s: %s", assetId, vehicleId, stripSummary(counts)))
	end

	clone.Parent = hostModel
	hostModel:SetAttribute("WE_CatalogAssetId", assetId)
	-- Soften host body so catalog mesh reads; keep Part-kit physics wheels (hidden)
	primary.Transparency = math.max(primary.Transparency, 0.72)
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("WE_PhysicsWheel") == true then
			d.Transparency = 1 -- physics collider/motor only; mesh provides visible tires
			d.CanCollide = true
			d.Massless = false
		elseif d:IsA("BasePart") and d:GetAttribute("WE_KitCosmetic") == true then
			d.Transparency = math.max(d.Transparency, 0.85)
		end
	end
	-- Re-assert DriverSeat still present after mesh dress
	if not hostModel:FindFirstChild("DriverSeat") then
		warn("[VisualAssetService] DriverSeat missing after mesh attach — host kit corrupted")
	end
	return true
end

--[[
	Optional character visual overlay for NPC Part kits.
	Attaches non-colliding clone; host HumanoidRootPart stays authoritative.
]]
function VisualAssetService.TryAttachCharacterVisual(hostModel: Model, kind: string): boolean
	-- P0: always attempt character catalog inserts (bypass StudioSkipWorldDressing)
	local forceChar = true
	local assetId = VisualAssetService.ResolveCharacterAssetId(kind)
	if not assetId then
		return false
	end
	local template = loadModel(assetId, forceChar)
	-- Worker/Infantry → WorkerFallback (16134469614) → never leave brown Part bricks
	if not template then
		local fb = (VisualAssetConfig.Characters :: any).WorkerFallback
		local fbId = if fb and typeof(fb.ModelAssetId) == "number" then fb.ModelAssetId else 0
		if typeof(fbId) == "number" and fbId > 0 and fbId ~= assetId then
			template = loadModel(fbId, forceChar)
			if template then
				assetId = fbId
			end
		end
	end
	if not template and (kind == "Worker" or kind == "Infantry") then
		-- Final realistic fallback: Guard mesh
		local guard = VisualAssetConfig.Characters.Guard
		local gId = if guard and typeof(guard.ModelAssetId) == "number" then guard.ModelAssetId else 0
		if typeof(gId) == "number" and gId > 0 then
			template = loadModel(gId, forceChar)
			if template then
				assetId = gId
			end
		end
	end
	if not template then
		return false
	end
	local primary = hostModel.PrimaryPart or hostModel:FindFirstChild("HumanoidRootPart")
	if not (primary and primary:IsA("BasePart")) then
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, primary :: BasePart, "WE_CatalogCharacter") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostModel
	hostModel:SetAttribute("WE_CatalogAssetId", assetId)
	-- Soften Part-kit body so realistic soldier mesh reads (dress-only)
	if primary:IsA("BasePart") then
		primary.Transparency = math.max(primary.Transparency, 0.85)
	end
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and d.Parent ~= clone and not d:IsDescendantOf(clone) then
			if d.Name ~= "HumanoidRootPart" then
				d.Transparency = math.max(d.Transparency, 0.92)
			end
		end
	end
	return true
end

--[[
	Optional building visual overlay for structure plinth Part kits.
	Welded non-colliding; plinth remains authoritative for walk-buy.
]]
function VisualAssetService.TryAttachBuildingVisual(hostPart: BasePart, structureId: string, level: number?): boolean
	-- v68: consoles are not where the building stands (WE_SiteCFrame); never hang a catalog building on one
	if hostPart:GetAttribute("WE_Console") == true then
		return false
	end
	-- STRUCTURE_SCALE_WIRE v21: ScaleTo TargetFootprint; NEVER MeshPart.Size = plinth.
	local DRESS_GEN = 29 -- v42: Hangar≠Warehouse≠Depot, Missile≠Tower; sync StructureVisualConfig.BuildingDressGen
	local REJECTED: { [number]: boolean } = {
		[12370174722] = true, -- blockout Airport Model (Design REJECT)
		[46981739] = true, -- tiny Plane Hangar (Design REJECT)
		[13195201090] = true, -- Build-a-Boat template (Design REJECT capital)
		[12630605935] = true, -- civilian Airplane Hangar text (not ceiling)
		[11399477618] = true, -- nation-branded gate
		[10339789720] = true, -- nation-branded gate
	}

	local existingGen = tonumber(hostPart:GetAttribute("WE_BuildingDressGen"))
	if hostPart:GetAttribute("WE_CatalogAssetId") and existingGen == DRESS_GEN then
		return false
	end
	if existingGen ~= DRESS_GEN then
		for _, ch in ipairs(hostPart:GetChildren()) do
			if ch:IsA("Model") and (ch.Name == "WE_CatalogBuilding" or ch.Name == "WE_AirfieldComposite" or string.sub(ch.Name, 1, 14) == "WE_CatalogBuild") then
				ch:Destroy()
			elseif ch:IsA("BasePart") and ch:GetAttribute("WE_AirfieldComposite") == true then
				ch:Destroy()
			end
		end
		hostPart:SetAttribute("WE_CatalogAssetId", nil)
	end

	-- v44 P0: Mesh welded ON TOP; kit stays fully opaque. NEVER raise Body/Roof/host Transparency.
	-- NEVER ghost Part-kit silhouettes. Catalog mesh is optional dress on top.
	-- Prior hideKitBody (Transparency≥0.92) and hostPart.Transparency=math.max(...,0.55-0.7) left ghost pads.
	local function hideKitBody()
		-- no-op on purpose
	end
	local function keepKitSolid()
		local solid = 0
		pcall(function()
			local cfg = require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
			if typeof(cfg.SolidTransparency) == "number" then
				solid = math.min(cfg.SolidTransparency, 0.05)
			end
		end)
		-- Host plinth itself may stay slightly visible; never fade it for mesh dress
		if hostPart.Transparency > 0.35 then
			hostPart.Transparency = solid
		end
		for _, ch in ipairs(hostPart:GetChildren()) do
			if ch:IsA("BasePart") then
				local role = ch:GetAttribute("WE_KitRole")
				if role == "Body" or role == "Roof" or role == "Accent" or role == "Antenna" then
					ch.Transparency = solid
				end
			end
		end
	end

	local function footprintFor(id: string): Vector3
		local ok, svc = pcall(function()
			return require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
		end)
		if ok and svc and svc.Palettes and svc.Palettes[id] and typeof(svc.Palettes[id].TargetFootprint) == "Vector3" then
			return svc.Palettes[id].TargetFootprint
		end
		local defaults: { [string]: Vector3 } = {
			CommandCenter = Vector3.new(36, 16, 28),
			Barracks = Vector3.new(28, 12, 16),
			VehicleDepot = Vector3.new(32, 14, 24),
			WeaponsFacility = Vector3.new(28, 18, 18),
			Warehouse = Vector3.new(36, 14, 22),
			Hangar = Vector3.new(40, 18, 28),
			Helipad = Vector3.new(22, 3, 22),
			Airfield = Vector3.new(70, 1, 10),
			Watchtowers = Vector3.new(10, 32, 10),
			Radar = Vector3.new(14, 18, 14),
			ResearchLab = Vector3.new(22, 12, 16),
			Dock = Vector3.new(40, 8, 16),
			PowerStation = Vector3.new(28, 16, 20),
			DefensiveWalls = Vector3.new(24, 8, 3),
			MissileDefense = Vector3.new(14, 10, 18),
			SpecialForcesFacility = Vector3.new(26, 14, 16),
			BaseGate = Vector3.new(16, 12, 4),
		}
		return defaults[id] or Vector3.new(28, 14, 20)
	end

	local function scaleModelToFootprint(model: Model, target: Vector3): number
		local ext = model:GetExtentsSize()
		local factor = math.min(target.X / math.max(ext.X, 0.05), target.Y / math.max(ext.Y, 0.05), target.Z / math.max(ext.Z, 0.05))
		factor = math.clamp(factor, 0.05, 80)
		local okScale = pcall(function()
			model:ScaleTo(factor)
		end)
		if not okScale then
			warn("[VisualAssetService] ScaleTo failed", structureId, factor)
		end
		return factor
	end

	local function weldScaledBuilding(clone: Model, target: Vector3, cloneName: string): boolean
		scaleModelToFootprint(clone, target)
		local topY = hostPart.Position.Y + hostPart.Size.Y * 0.5
		pcall(function()
			local ext = clone:GetExtentsSize()
			clone:PivotTo(CFrame.new(hostPart.Position.X, topY + ext.Y * 0.5, hostPart.Position.Z) * (hostPart.CFrame - hostPart.Position))
		end)
		if not weldCloneToPrimary(clone, hostPart, cloneName) then
			return false
		end
		clone.Parent = hostPart
		return true
	end

	-- Airfield COMPOSITE: runway 70×1×10 + asphalt decal + Hangar 6015472062
	if structureId == "Airfield" then
		local folder = Instance.new("Model")
		folder.Name = "WE_AirfieldComposite"
		folder.Parent = hostPart

		local runway = Instance.new("Part")
		runway.Name = "WE_Runway"
		runway.Size = Vector3.new(70, 1, 10)
		runway.Anchored = true
		runway.CanCollide = false
		runway.CanQuery = false
		runway.CanTouch = false
		runway.Material = Enum.Material.Asphalt
		runway.Color = Color3.fromRGB(45, 48, 52)
		runway.CastShadow = true
		local look = hostPart.CFrame.LookVector
		runway.CFrame = CFrame.new(hostPart.Position + look * 28 + Vector3.new(0, 0.55, 0)) * (hostPart.CFrame - hostPart.Position)
		runway:SetAttribute("WE_AirfieldComposite", true)
		runway.Parent = folder
		pcall(function()
			VisualAssetService.ApplyAsphaltDecal(runway)
		end)
		for i = -3, 3 do
			local dash = Instance.new("Part")
			dash.Name = "WE_RunwayDash"
			dash.Size = Vector3.new(4, 0.12, 0.55)
			dash.Anchored = true
			dash.CanCollide = false
			dash.CanQuery = false
			dash.Material = Enum.Material.SmoothPlastic
			dash.Color = Color3.fromRGB(240, 240, 220)
			dash.CFrame = runway.CFrame * CFrame.new(i * 8, 0.56, 0)
			dash:SetAttribute("WE_AirfieldComposite", true)
			dash.Parent = folder
		end

		local hangarId = 6015472062
		local hangarTemplate = loadModel(hangarId)
		if hangarTemplate then
			local hangar = hangarTemplate:Clone()
			scaleModelToFootprint(hangar, footprintFor("Hangar"))
			local ext = hangar:GetExtentsSize()
			pcall(function()
				hangar:PivotTo(runway.CFrame * CFrame.new(32, ext.Y * 0.5, 0))
			end)
			stripScripts(hangar)
			hangar.Name = "WE_CatalogHangar"
			for _, d in ipairs(hangar:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.Massless = true
					local w = Instance.new("WeldConstraint")
					w.Part0 = hostPart
					w.Part1 = d
					w.Parent = d
				end
			end
			hangar.Parent = folder
		else
			warn("[VisualAssetService] Hangar insert failed — Part shed fallback", hangarId)
			local shed = Instance.new("Part")
			shed.Name = "WE_HangarShed"
			shed.Size = Vector3.new(40, 18, 28)
			shed.Anchored = true
			shed.CanCollide = false
			shed.Material = Enum.Material.Metal
			shed.Color = Color3.fromRGB(70, 75, 68)
			shed.CFrame = runway.CFrame * CFrame.new(32, 9, 0)
			shed:SetAttribute("WE_AirfieldComposite", true)
			shed.Parent = folder
			local mouth = Instance.new("Part")
			mouth.Name = "WE_HangarMouth"
			mouth.Size = Vector3.new(0.4, 14, 22)
			mouth.Anchored = true
			mouth.CanCollide = false
			mouth.Material = Enum.Material.Metal
			mouth.Color = Color3.fromRGB(30, 32, 28)
			mouth.CFrame = shed.CFrame * CFrame.new(-20.2, -1, 0)
			mouth:SetAttribute("WE_AirfieldComposite", true)
			mouth.Parent = folder
			hangarId = -6015472062
		end

		keepKitSolid()
		hostPart:SetAttribute("WE_CatalogAssetId", hangarId)
		hostPart:SetAttribute("WE_BuildingDressGen", DRESS_GEN)
		return true
	end

	local assetId = VisualAssetService.ResolveBuildingAssetId(structureId)
	local lv = tonumber(level) or 0
	if structureId == "DefensiveWalls" and lv >= 3 then
		local l3 = VisualAssetConfig.Buildings.DefensiveWallsL3
		if l3 and typeof(l3.ModelAssetId) == "number" and (l3.ModelAssetId :: number) > 0 then
			assetId = l3.ModelAssetId
		else
			local okSvc, StructureVisualConfig = pcall(function()
				return require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
			end)
			if okSvc and StructureVisualConfig then
				local pal = StructureVisualConfig.Palettes and StructureVisualConfig.Palettes.DefensiveWalls
				if pal and typeof(pal.MeshAssetIdL3) == "number" and pal.MeshAssetIdL3 > 0 then
					assetId = pal.MeshAssetIdL3
				end
			end
		end
	end
	if not assetId or assetId <= 0 or REJECTED[assetId] == true then
		if assetId and REJECTED[assetId] then
			warn("[VisualAssetService] REJECTED building asset", structureId, assetId)
		end
		return false
	end
	local template = loadModel(assetId)
	if not template then
		warn("[VisualAssetService] Insert failed — Part kit remains", structureId, assetId)
		return false
	end

	local clone = template:Clone()
	if not weldScaledBuilding(clone, footprintFor(structureId), "WE_CatalogBuilding") then
		clone:Destroy()
		return false
	end
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	hostPart:SetAttribute("WE_BuildingDressGen", DRESS_GEN)
	if structureId == "BaseGate" then
		hostPart:SetAttribute("WE_DisplayName", "Base Gate")
		local dressed = hostPart:FindFirstChild("WE_CatalogBuilding")
		if dressed and dressed:IsA("Model") then
			dressed.Name = "WE_BaseGate"
		end
	end
	keepKitSolid()
	return true
end


--[[
	Optional desert prop overlay (cactus etc.) welded to a flora host part.
]]
--[[
	Attach MeshPart dress when catalog entry is MeshId-only (AssetType 40).
	Falls back to SpecialMesh on a Part if MeshPart.MeshId set fails.
]]
function VisualAssetService.TryAttachMeshPartVisual(hostPart: BasePart, meshId: number, label: string?): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") or hostPart:GetAttribute("WE_MeshId") then
		return false
	end
	if meshId <= 0 or shouldSkipInserts() then
		return false
	end
	local ok, err = pcall(function()
		local mp = Instance.new("MeshPart")
		mp.Name = label or "WE_CatalogMeshPart"
		mp.Size = hostPart.Size
		mp.Anchored = true
		mp.CanCollide = false
		mp.CanQuery = false
		mp.CanTouch = false
		mp.CastShadow = false
		mp.Massless = true
		-- MeshId via rbxassetid; if InsertService Model fails for type-40 assets
		mp.MeshId = "rbxassetid://" .. tostring(meshId)
		mp.TextureID = ""
		mp.CFrame = hostPart.CFrame
		mp.Parent = hostPart
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hostPart
		weld.Part1 = mp
		weld.Parent = mp
	end)
	if not ok then
		-- Fallback: Part + SpecialMesh
		local ok2 = pcall(function()
			local holder = Instance.new("Part")
			holder.Name = label or "WE_CatalogMeshHolder"
			holder.Size = hostPart.Size
			holder.Transparency = 1
			holder.Anchored = true
			holder.CanCollide = false
			holder.CanQuery = false
			holder.CanTouch = false
			holder.Massless = true
			holder.CFrame = hostPart.CFrame
			holder.Parent = hostPart
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = Enum.MeshType.FileMesh
			sm.MeshId = "rbxassetid://" .. tostring(meshId)
			sm.Scale = Vector3.new(1, 1, 1)
			sm.Parent = holder
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hostPart
			weld.Part1 = holder
			weld.Parent = holder
		end)
		if not ok2 then
			warn("[VisualAssetService] MeshPart pipeline failed", meshId, err)
			return false
		end
	end
	hostPart:SetAttribute("WE_MeshId", meshId)
	-- v44 P0: never raise Transparency on structure kit hosts (Body/Roof/plinth). Vehicles/props OK.
	local kitRole = hostPart:GetAttribute("WE_KitRole")
	local isStructureHost = kitRole == "Body" or kitRole == "Roof" or hostPart:GetAttribute("StructureId") ~= nil or hostPart:GetAttribute("WE_StructureId") ~= nil
	if not isStructureHost then
		hostPart.Transparency = math.max(hostPart.Transparency, 0.7)
	end
	return true
end

function VisualAssetService.TryAttachPropVisual(hostPart: BasePart, propKey: string): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") or hostPart:GetAttribute("WE_MeshId") then
		return false
	end
	-- MeshPart-only keys (DesertRock): prefer MeshId pipeline
	local meshId = VisualAssetService.ResolvePropMeshId(propKey)
	local assetId = VisualAssetService.ResolvePropAssetId(propKey)
	if (not assetId or assetId <= 0) and meshId then
		return VisualAssetService.TryAttachMeshPartVisual(hostPart, meshId, "WE_CatalogProp_" .. propKey)
	end
	if not assetId then
		return false
	end
	local template = loadModel(assetId)
	-- Palm/Tent/OilPumpjack/Jersey/CamoNet/StreetLamp alt fallback (Design Bot wire)
	if not template then
		local altKey: string? = nil
		if propKey == "Palm" then
			altKey = "PalmAlt"
		elseif propKey == "Tent" then
			altKey = "TentAlt"
		elseif propKey == "OilPumpjack" then
			altKey = "OilPumpjackAlt"
		elseif propKey == "JerseyBarrier" then
			altKey = "JerseyBarrierAlt"
		elseif propKey == "CamoNet" then
			altKey = "CamoNetAlt"
		elseif propKey == "StreetLamp" then
			altKey = "StreetLampAlt"
		end
		if altKey then
			local altId = VisualAssetService.ResolvePropAssetId(altKey)
			if altId then
				template = loadModel(altId)
				if template then
					assetId = altId
				end
			end
		end
	end
	if not template then
		-- Last resort MeshId if both Model inserts fail
		if meshId then
			return VisualAssetService.TryAttachMeshPartVisual(hostPart, meshId, "WE_CatalogProp_" .. propKey)
		end
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogProp") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	-- v44 P0: props on DressHost OK to soften; never fade Body/Roof structure kits
	local kitRole = hostPart:GetAttribute("WE_KitRole")
	if kitRole ~= "Body" and kitRole ~= "Roof" and hostPart:GetAttribute("StructureId") == nil then
		hostPart.Transparency = math.max(hostPart.Transparency, 0.65)
	end
	return true
end

--[[
	Paint asphalt Decal (Texture) on road Part faces. Uses MapDressing.AsphaltDecal MeshId as Decal texture id.
]]
function VisualAssetService.ApplyAsphaltDecal(roadPart: BasePart): boolean
	if roadPart:GetAttribute("WE_AsphaltDecal") then
		return false
	end
	local texId = VisualAssetService.ResolvePropMeshId("AsphaltDecal")
	if not texId or texId <= 0 then
		return false
	end
	local ok = pcall(function()
		for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Bottom }) do
			local d = Instance.new("Decal")
			d.Name = "WE_AsphaltDecal"
			d.Face = face
			d.Texture = "rbxassetid://" .. tostring(texId)
			d.Transparency = 0.15
			d.Parent = roadPart
		end
	end)
	if ok then
		roadPart:SetAttribute("WE_AsphaltDecal", texId)
	end
	return ok
end

local function collectAssetIds(primaryKey: string, fallbackKey: string?, altsKey: string?): { number }
	local ids: { number } = {}
	local seen: { [number]: boolean } = {}
	local function push(id: any)
		if typeof(id) == "number" and id > 0 and not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	local primary = (VisualAssetConfig :: any)[primaryKey]
	if primary then
		push(primary.ModelAssetId)
	end
	if fallbackKey then
		local fb = (VisualAssetConfig :: any)[fallbackKey]
		if fb then
			push(fb.ModelAssetId)
		end
	end
	if altsKey then
		local alts = (VisualAssetConfig :: any)[altsKey]
		if typeof(alts) == "table" then
			for _, ref in ipairs(alts) do
				if typeof(ref) == "table" then
					push(ref.ModelAssetId)
				end
			end
		end
	end
	return ids
end

local function loadFirst(ids: { number }): (Model?, number?)
	for _, id in ipairs(ids) do
		local template = loadModel(id)
		if template then
			return template, id
		end
	end
	return nil, nil
end

--[[
	Dress WE_MoneyCollector with ATM catalog mesh (cosmetic only).
	Prefer Design Bot hero 75368157644109 → 175462478 → alts.
]]
function VisualAssetService.TryAttachCollectorVisual(hostPart: BasePart): boolean
	-- NEVER throw — Part kit ATM remains if Design Bot hero mesh / InsertService fails.
	local ok, result = pcall(function(): boolean
		if hostPart:GetAttribute("WE_CatalogAssetId") then
			return false
		end
		local template, assetId = loadFirst(collectAssetIds("MoneyCollector", "MoneyCollectorFallback", "MoneyCollectorAlts"))
		if not template or not assetId then
			return false -- Part kit only
		end
		local clone = template:Clone()
		if not weldCloneToPrimary(clone, hostPart, "WE_CatalogATM") then
			clone:Destroy()
			return false
		end
		clone.Parent = hostPart
		hostPart:SetAttribute("WE_CatalogAssetId", assetId)
		hostPart.Transparency = math.max(hostPart.Transparency, 0.55)
		-- Lime landmark glow (typed neon)
		local glow = hostPart:FindFirstChild("ATMGlow")
		if not (glow and glow:IsA("PointLight")) then
			local light = Instance.new("PointLight")
			light.Name = "ATMGlow"
			light.Color = Color3.fromRGB(120, 255, 90)
			light.Brightness = 1.1
			light.Range = 18
			light.Parent = hostPart
		else
			local pl = glow :: PointLight
			pl.Color = Color3.fromRGB(120, 255, 90)
			pl.Brightness = math.max(pl.Brightness, 1.0)
		end
		return true
	end)
	if not ok then
		warn("[VisualAssetService] TryAttachCollectorVisual failed (Part kit kept):", result)
		return false
	end
	return result == true
end

--[[
	One-shot collect burst FX — MoneyBagFX then VfxSparkles, then neon motes.
]]
function VisualAssetService.PlayMoneyBagFX(at: Vector3, parent: Instance?): boolean
	local ids = collectAssetIds("MoneyBagFX", "VfxSparkles", nil)
	local template, assetId = loadFirst(ids)
	if not template then
		local folder = Instance.new("Folder")
		folder.Name = "WE_MoneyBagFallback"
		folder.Parent = parent or game:GetService("Workspace")
		for i = 1, 6 do
			local mote = Instance.new("Part")
			mote.Name = "CashMote" .. i
			mote.Size = Vector3.new(0.35, 0.2, 0.55)
			mote.Color = Color3.fromRGB(120, 255, 90)
			mote.Material = Enum.Material.Neon
			mote.Anchored = true
			mote.CanCollide = false
			mote.CFrame = CFrame.new(at + Vector3.new((i - 3.5) * 0.4, 0.5, (i % 3 - 1) * 0.35))
			mote.Parent = folder
		end
		task.delay(0.85, function()
			folder:Destroy()
		end)
		return true
	end
	local clone = template:Clone()
	clone.Name = "WE_MoneyBagFX"
	clone:PivotTo(CFrame.new(at + Vector3.new(0, 1.5, 0)))
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.Massless = true
		elseif d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	clone.Parent = parent or game:GetService("Workspace")
	if assetId then
		clone:SetAttribute("WE_CatalogAssetId", assetId)
	end
	task.delay(1.2, function()
		if clone.Parent then
			clone:Destroy()
		end
	end)
	return true
end

--[[
	Optional CashCrate overlay for supply / world crates.
]]
function VisualAssetService.TryAttachCashCrateVisual(hostPart: BasePart): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") then
		return false
	end
	local ref = (VisualAssetConfig :: any).CashCrate
	local assetId = if ref and typeof(ref.ModelAssetId) == "number" then ref.ModelAssetId else 0
	if not assetId or assetId <= 0 then
		return false
	end
	local template = loadModel(assetId)
	if not template then
		return false
	end
	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogCashCrate") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	hostPart.Transparency = math.max(hostPart.Transparency, 0.55)
	return true
end

--[[
	Dress VehicleDepot showroom hosts with podium / pedestal / rotator meshes.
]]
function VisualAssetService.TryAttachShowroomVisual(plinth: BasePart): boolean
	local attached = false
	local map = {
		Podium = "ShowroomPodium",
		PodiumRing = "ShowroomPedestal",
		ShowroomMesh = "ShowroomRotator",
	}
	for role, cfgKey in pairs(map) do
		local host = plinth:FindFirstChild(role)
		if host and host:IsA("BasePart") and not host:GetAttribute("WE_CatalogAssetId") then
			local ref = (VisualAssetConfig :: any)[cfgKey]
			local id = if ref and typeof(ref.ModelAssetId) == "number" then ref.ModelAssetId else 0
			if id > 0 then
				local template = loadModel(id)
				if template then
					local clone = template:Clone()
					if weldCloneToPrimary(clone, host, "WE_CatalogShowroom") then
						clone.Parent = host
						host:SetAttribute("WE_CatalogAssetId", id)
						host.Transparency = math.max(host.Transparency, 0.65)
						attached = true
					else
						clone:Destroy()
					end
				end
			end
		end
	end

	-- Tier 2 densify: extra pedestals (ghost locked stands) + entrance flag
	for pi = 2, 3 do
		local host = plinth:FindFirstChild("ShowroomPedestalHost" .. pi)
		if host and host:IsA("BasePart") and not host:GetAttribute("WE_CatalogAssetId") then
			pcall(function()
				local template, assetId = loadFirst(collectAssetIds("ShowroomPedestal", nil, nil))
				if template and assetId then
					local clone = template:Clone()
					if weldCloneToPrimary(clone, host, "WE_CatalogPedestal") then
						clone.Parent = host
						host:SetAttribute("WE_CatalogAssetId", assetId)
						host.Transparency = math.max(host.Transparency, 0.55)
						for _, d in ipairs(clone:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Transparency = math.max(d.Transparency, 0.55)
								d.CanCollide = false
							end
						end
						attached = true
					else
						clone:Destroy()
					end
				end
			end)
		end
	end
	local flagHost = plinth:FindFirstChild("ShowroomFlagHost")
	if flagHost and flagHost:IsA("BasePart") then
		pcall(function()
			if VisualAssetService.TryAttachPropVisual(flagHost, "FlagPole") then
				attached = true
			end
		end)
	end

	return attached
end

--[[
	Dress tutorial marker with arrow mesh (first beats).
]]
function VisualAssetService.TryAttachTutorialArrow(hostPart: BasePart): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") then
		return false
	end
	local template, assetId = loadFirst(collectAssetIds("TutorialArrow", "TutorialArrowAlt", nil))
	if not template or not assetId then
		return false
	end
	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogTutArrow") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	return true
end


--[[
	Tier 2: attach HQ/Barracks/Depot interior props onto WE_DressHost_* kit parts.
	Part kit hosts remain; catalog inserts optional.
]]
function VisualAssetService.TryDressStructureInterior(plinth: BasePart, structureId: string): number
	if shouldSkipInserts() then
		return 0
	end
	local dress = (VisualAssetConfig :: any).StructureDress
	if typeof(dress) ~= "table" then
		return 0
	end
	local keys = dress[structureId]
	if typeof(keys) ~= "table" then
		return 0
	end
	local attached = 0
	local keyIdx = 1
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 12) == "WE_DressHost" then
			local propKey = child:GetAttribute("WE_DressProp")
			if typeof(propKey) ~= "string" or propKey == "" then
				propKey = keys[((keyIdx - 1) % #keys) + 1]
				keyIdx += 1
			end
			local ok = pcall(function()
				return VisualAssetService.TryAttachPropVisual(child, propKey :: string)
			end)
			if ok then
				attached += 1
			end
		end
	end
	return attached
end

function VisualAssetService.Init()
	ensureFolder()
	if shouldSkipInserts() then
		print("[VisualAssetService] Catalog inserts SKIPPED (StudioSkipWorldDressing / disabled). Part kits only.")
	else
		print("[VisualAssetService] Catalog inserts enabled — free Creator Store IDs via InsertService.")
	end
end


--[[
	v37: static parked aircraft/boat mesh on Helipad/Dock DressHosts.
	Uses existing VisualAssetConfig vehicle ModelAssetIds (TransportHeli / PatrolBoat).
	Part-kit ParkedHeli/ParkedBoat silhouette remains if insert skipped/fails.
]]
function VisualAssetService.TryAttachParkedPresence(plinth: BasePart, structureId: string, level: number?): boolean
	if not plinth or not plinth.Parent then
		return false
	end
	local lv = tonumber(level) or 0
	if lv < 1 then
		return false
	end
	if structureId ~= "Helipad" and structureId ~= "Dock" then
		return false
	end
	local attached = false
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") then
			local vehicleId = child:GetAttribute("WE_DressVehicle")
			if typeof(vehicleId) == "string" and (vehicleId :: string) ~= "" then
				if child:FindFirstChild("WE_ParkedCatalog") then
					attached = true
				else
					local assetId = VisualAssetService.ResolveVehicleAssetId(vehicleId :: string, nil)
					if assetId then
						local template = loadModel(assetId)
						if template then
							local clone = template:Clone()
							if weldCloneToPrimary(clone, child, "WE_ParkedCatalog") then
								clone.Parent = child
								child:SetAttribute("WE_ParkedAssetId", assetId)
								-- v39: keep Part-kit parked silhouette visible under optional mesh
								for _, sib in ipairs(plinth:GetChildren()) do
									if sib:IsA("BasePart") then
										local role = sib:GetAttribute("WE_KitRole")
										if role == "ParkedHeli" or role == "ParkedBoat" then
											sib.Transparency = math.min(sib.Transparency, 0.35)
										end
									end
								end
								attached = true
							else
								clone:Destroy()
							end
						end
					end
				end
			end
		end
	end
	return attached
end


-- Test hook (headless sim, judge K2): install a template for assetId through the same prep loadModel runs.
function VisualAssetService._SetTemplate(assetId: number, model: Model)
	prepareTemplate(assetId, model)
	model.Parent = ensureFolder()
	cache[assetId] = model
	failed[assetId] = nil
	dressLogged[assetId] = nil
end

return VisualAssetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">XPService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Server-authoritative XP / Level ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local LevelConfig = require(Shared.Configs.LevelConfig)
local Types = require(Shared.Types)

local XPService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RemoteSetup: any = nil
local TerritoryService: any = nil
local _MissionService: any = nil
local MonetizationService: any = nil
local BattlePassService: any = nil
local SeasonService: any = nil
local NotificationService: any = nil
local PrestigeService: any = nil

local function pushXP(player: Player, profile: Types.PlayerProfile, unlockMessage: string?, leveledUp: boolean?)
	local remote = RemoteSetup.Get(Constants.RemoteNames.XPUpdate) :: RemoteEvent
	local hudGoal = LevelConfig.GetHudGoal(profile.Level)
	remote:FireClient(player, {
		Level = profile.Level,
		XP = profile.XP,
		XPToNext = LevelConfig.GetXPRequiredForLevel(profile.Level),
		HudGoal = hudGoal,
		UnlockMessage = unlockMessage,
		LevelUp = leveledUp == true,
	} :: Types.XPUpdatePayload)
end

function XPService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	_MissionService = deps.MissionService
	MonetizationService = deps.MonetizationService
	BattlePassService = deps.BattlePassService
	SeasonService = deps.SeasonService
	NotificationService = deps.NotificationService
	PrestigeService = deps.PrestigeService
end

function XPService.Push(player: Player)
	local profile = DataService.GetProfile(player)
	if profile then
		pushXP(player, profile)
	end
end

function XPService.AddXP(player: Player, amount: number, reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	if SeasonService and SeasonService.GetXPMult and reason ~= "admin" and reason ~= "battlepass" and reason ~= "daily" then
		amount = math.max(1, math.floor(amount * SeasonService.GetXPMult()))
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end

	if profile.Level >= LevelConfig.MaxLevel then
		return false
	end

	if TerritoryService and TerritoryService.GetXPMult and reason ~= "achievement" then
		amount = math.max(1, math.floor(amount * TerritoryService.GetXPMult(player)))
	end

	local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
	local reasonKey = reason or ""
	local xpExempt = MonetizationConfig.XPMultExemptReasons
	if MonetizationService and MonetizationService.GetXPMultiplier and not (xpExempt and xpExempt[reasonKey]) then
		amount = math.max(1, math.floor(amount * MonetizationService.GetXPMultiplier(player)))
	end

	profile.XP += amount
	while profile.Level < LevelConfig.MaxLevel do
		local need = LevelConfig.GetXPRequiredForLevel(profile.Level)
		if profile.XP < need then
			break
		end
		profile.XP -= need
		profile.Level += 1
		local reward = LevelConfig.GetLevelUpReward(profile.Level)
		if reward.Cash > 0 then
			EconomyService.AddCash(player, reward.Cash, "level_up")
		end
		if reward.Gold > 0 then
			EconomyService.AddGold(player, reward.Gold, "level_up")
		end
		local unlockMsg = LevelConfig.GetUnlockMessage(profile.Level)
		-- v37: high-contrast level-up celebration toast (client also plays SFX on LevelUp flag)
		if NotificationService and NotificationService.Notify then
			local celeb = string.format("★ LEVEL %d!", profile.Level)
			if unlockMsg then
				celeb = celeb .. " — " .. unlockMsg
			end
			NotificationService.Notify(player, celeb, "Success", 5)
		end
		if AnalyticsService then
			AnalyticsService.Log("LEVEL_UP", player.UserId, { level = profile.Level, reason = reason })
		end
		-- v35: mid-game VIP soft offer (level≥10)
		if MonetizationService and MonetizationService.TrySoftOfferVIP then
			pcall(function()
				MonetizationService.TrySoftOfferVIP(player, "level")
			end)
		end
		-- v38: soft rebirth CTA when near MinLevelToPrestige
		if PrestigeService and PrestigeService.MaybeNearPrestigeToast then
			pcall(function()
				PrestigeService.MaybeNearPrestigeToast(player)
			end)
		end
		-- Push per level-up so HUD goal / unlock toast refresh immediately
		pushXP(player, profile, unlockMsg, true)
	end

	DataService.MarkDirty(player)
	pushXP(player, profile, nil)
	if BattlePassService and BattlePassService.AddXP and reason ~= "battlepass" then
		-- Mirror a portion of gameplay XP into the battle pass track
		BattlePassService.AddXP(player, amount, reason)
	end
	return true
end

function XPService.SetLevel(player: Player, level: number)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.Level = math.clamp(math.floor(level), 1, LevelConfig.MaxLevel)
	profile.XP = 0
	DataService.MarkDirty(player)
	pushXP(player, profile)
end

function XPService.GetXPToNext(player: Player): number
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0
	end
	return LevelConfig.GetXPRequiredForLevel(profile.Level)
end

return XPService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="145">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="146">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="147">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="148">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!strict
--[[ WAR EMPIRE — Client Bootstrap ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Wait for Shared; WE_Remotes created by server EarlyRemotes (BindEvent handles late)
ReplicatedStorage:WaitForChild("Shared")

local Controllers = script.Parent:WaitForChild("Controllers")
local Modules = script.Parent:WaitForChild("Modules")
-- v70: every controller loads and starts inside its own pcall, so one failure (e.g. combat) can never take
-- the garage / driving / HUD down with it.
local function safeRequire(name: string, inst: Instance): any
	local ok, mod = pcall(require, inst :: ModuleScript)
	if not ok then
		warn("[WAR EMPIRE] require " .. name .. " failed:", mod)
		return nil
	end
	return mod
end

local function safeInit(name: string, mod: any)
	if type(mod) ~= "table" or type(mod.Init) ~= "function" then
		return
	end
	local ok, err = pcall(mod.Init)
	if not ok then
		warn("[WAR EMPIRE] " .. name .. ".Init failed:", err)
	end
end

local UIController = safeRequire("UIController", Controllers:WaitForChild("UIController"))
local CombatController = safeRequire("CombatController", Controllers:WaitForChild("CombatController"))
local VehicleController = safeRequire("VehicleController", Controllers:WaitForChild("VehicleController"))
local StudioSmokeClient = safeRequire("StudioSmokeClient", Modules:WaitForChild("StudioSmokeClient"))
local WorldSpinners = safeRequire("WorldSpinners", Modules:WaitForChild("WorldSpinners"))

print("[WAR EMPIRE] Client Bootstrap starting...")

safeInit("UIController", UIController)
safeInit("CombatController", CombatController)
safeInit("VehicleController", VehicleController)
safeInit("StudioSmokeClient", StudioSmokeClient)
-- v68: radar dishes on base installations (visual only; never block the rest of the client)
safeInit("WorldSpinners", WorldSpinners)
safeInit("AudioHooks", safeRequire("AudioHooks", Modules:WaitForChild("AudioHooks", 5) :: Instance)) -- W1 SND: sound cues from existing remotes / HUD signals (client only)

print("[WAR EMPIRE] Client Bootstrap ready.")
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="149">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">ArmyController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Army panel — recruit/dismiss soldiers. Server-authoritative (RequestRecruitSoldiers / RequestDismissSoldiers).
	v70 "clean screen" (spec §3.8): opened from the Army popover's "MANAGE ARMY ▸" (OrdersController), the Army
	terminals (WE_OpenPanel "Army") and the tutorial. No key of its own any more (A was strafe-left; Y opens the
	Army popover). A registered Modal panel (HudLayout id "Army") with the black dim; HudLayout.ApplyScreen gives
	it the one HUD scale and the safe area, so its title no longer sits under the Roblox topbar. ]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)

local PanelShell = require(script.Parent.Parent.Modules.PanelShell)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local NotificationController = require(script.Parent.NotificationController)

local ArmyController = {}

local PANEL_ID = "Army"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local open = false
local screenGui: ScreenGui? = nil
local shell: PanelShell.Shell? = nil
local statusLabel: TextLabel? = nil
local capFill: Frame? = nil
local capLabel: TextLabel? = nil
local armyState: any = nil
local requestingState = false
local refreshLabels: () -> ()

local function synthesizeFromPlayerState(state: any)
	if typeof(state) ~= "table" then
		return
	end
	local barracks = 0
	if typeof(state.Base) == "table" and typeof(state.Base.Upgrades) == "table" then
		barracks = tonumber(state.Base.Upgrades.Barracks) or 0
	end
	local count = tonumber(state.Soldiers) or 0
	local baseCap = SoldierConfig.MaxSoldiersBase or 50
	local per = SoldierConfig.SoldiersPerBarracksLevel or 5
	local cap = baseCap + barracks * per
	local cost = SoldierConfig.RecruitCostCash or 500
	local room = math.max(0, cap - count)
	local tickSec = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.TickSeconds) or 5
	local perSoldier = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.CashPerSoldierPerTick) or 0
	local minN = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.MinSoldiersForIncome) or 1
	local training = if count >= minN then math.floor(count * perSoldier) else 0
	armyState = {
		Soldiers = count,
		MaxSoldiers = cap,
		BarracksLevel = barracks,
		RecruitCostCash = cost,
		RecruitBatchSize = SoldierConfig.RecruitBatchSize or 1,
		DismissRefundMult = SoldierConfig.DismissRefundMult or 0.25,
		SlotsFree = room,
		FillCost = cost * room,
		TrainingIncomePerTick = training,
		TrainingTickSeconds = tickSec,
		TrainingIncomePerSec = if tickSec > 0 then training / tickSec else 0,
	}
end

-- one GetPlayerState read when no SoldierStateUpdate arrived yet; never blocks (TryGetFunction)
local function ensureArmyState()
	if typeof(armyState) == "table" or requestingState then
		return
	end
	local fn = Remotes.TryGetFunction(Constants.RemoteNames.GetPlayerState)
	if not fn then
		return
	end
	requestingState = true
	task.spawn(function()
		local okInvoke, state = pcall(function()
			return fn:InvokeServer()
		end)
		requestingState = false
		if okInvoke and typeof(state) == "table" then
			synthesizeFromPlayerState(state)
			refreshLabels()
		end
	end)
end

refreshLabels = function()
	local status = statusLabel
	if not status then
		return
	end
	if typeof(armyState) ~= "table" then
		status.Text = "No army data yet — it syncs a moment after you join."
		return
	end
	local count = tonumber(armyState.Soldiers) or 0
	local cap = tonumber(armyState.MaxSoldiers) or 0
	local free = tonumber(armyState.SlotsFree) or math.max(0, cap - count)
	local cost = tonumber(armyState.RecruitCostCash) or 500
	local refundMult = tonumber(armyState.DismissRefundMult) or 0.25
	local barracks = tonumber(armyState.BarracksLevel) or 0
	if count == 0 and barracks == 0 then
		status.Text = string.format(
			"Army empty — build the Barracks to raise the cap.\nBase cap %d · Recruit $%d each · FILL CAP recruits up to the free slots.",
			cap,
			cost
		)
	else
		local trainTick = tonumber(armyState.TrainingIncomePerTick) or 0
		local tickSec = tonumber(armyState.TrainingTickSeconds)
			or (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.TickSeconds)
			or 5
		local trainSec = tonumber(armyState.TrainingIncomePerSec) or (if tickSec > 0 then trainTick / tickSec else 0)
		status.Text = string.format(
			"Barracks Lv %d · %d free slots · Recruit $%d each · Dismiss refund %d%%\nTraining Yard: +$%d/tick (~$%.1f/sec)",
			barracks,
			free,
			cost,
			math.floor(refundMult * 100),
			trainTick,
			trainSec
		)
	end
	local fill = capFill
	if fill and cap > 0 then
		fill.Size = UDim2.fromScale(math.clamp(count / cap, 0, 1), 1)
		fill.BackgroundColor3 = if count >= cap then Constants.Colors.Danger else Constants.Colors.Accent
	end
	local capText = capLabel
	if capText then
		capText.Text = string.format("%d / %d soldiers", count, cap)
	end
end

local function setOpen(isOpen: boolean)
	open = isOpen
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = isOpen
		end
	end
	local sh = shell
	if sh then
		sh.Sync(isOpen)
	end
	if isOpen then
		ensureArmyState()
		refreshLabels()
	end
end

function ArmyController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireArmy"
	-- v70: one HUD scale + the safe area (was IgnoreGuiInset = true: the title sat under the Roblox topbar)
	PanelShell.Screen(screen)
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()
	local BTN_H = if isTouch then TAP else 52 -- desktop rows a little taller than the 44 v minimum
	local GAP = 8

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.94, 0, 1, -16) else UDim2.fromOffset(580, 364)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.ZIndex = 1
	panel.Parent = screen
	UIUtil.Corner(panel, 12)
	UIUtil.Stroke(panel)
	-- touch: as wide as fits (≤ 860 v), as tall as the content (set once the body is built)
	local sizeCap = Instance.new("UISizeConstraint")
	sizeCap.MaxSize = if isTouch then Vector2.new(860, 560) else Vector2.new(580, 364)
	sizeCap.Parent = panel

	PanelShell.Title(panel, "Army")
	PanelShell.CloseButton(panel, function()
		setOpen(false)
	end)

	local headerH = TAP + 8
	local body = Instance.new("ScrollingFrame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Position = UDim2.fromOffset(0, headerH)
	body.Size = UDim2.new(1, 0, 1, -headerH - 8)
	body.ScrollBarThickness = if isTouch then 6 else 4
	body.ScrollingDirection = Enum.ScrollingDirection.Y
	body.CanvasSize = UDim2.fromOffset(0, 0)
	body.Parent = panel

	local y = 0
	local textSize = PanelShell.Text(14)

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Position = UDim2.fromOffset(16, y)
	status.Size = UDim2.new(1, -32, 0, textSize * 2 + 12)
	status.Font = Enum.Font.GothamMedium
	status.TextSize = textSize
	status.TextWrapped = true
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextYAlignment = Enum.TextYAlignment.Top
	status.TextColor3 = Constants.Colors.Muted
	status.Text = "..."
	status.Parent = body
	statusLabel = status
	y += textSize * 2 + 16

	-- Cap bar
	local capH = PanelShell.Text(16) + 8
	local capBg = Instance.new("Frame")
	capBg.Name = "CapBar"
	capBg.Position = UDim2.fromOffset(16, y)
	capBg.Size = UDim2.new(1, -32, 0, capH)
	capBg.BackgroundColor3 = Constants.Colors.Background
	capBg.BorderSizePixel = 0
	capBg.Parent = body
	UIUtil.Corner(capBg, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Constants.Colors.Accent
	fill.BorderSizePixel = 0
	fill.Parent = capBg
	UIUtil.Corner(fill, 6)
	capFill = fill

	local capText = Instance.new("TextLabel")
	capText.BackgroundTransparency = 1
	capText.Size = UDim2.fromScale(1, 1)
	capText.Font = Enum.Font.GothamBold
	capText.TextSize = PanelShell.Text(14)
	capText.TextColor3 = Constants.Colors.Text
	capText.Text = "0 / 0 soldiers"
	capText.ZIndex = 2
	capText.Parent = capBg
	capLabel = capText
	y += capH + 12

	-- a row of equal-width buttons, TAP tall (≥ 44 real px on touch)
	local function buttonRow(defs: { { Label: string, OnClick: () -> (), Gold: boolean?, Robux: boolean? } }): { TextButton }
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Position = UDim2.fromOffset(16, y)
		row.Size = UDim2.new(1, -32, 0, BTN_H)
		row.Parent = body
		local lay = Instance.new("UIListLayout")
		lay.FillDirection = Enum.FillDirection.Horizontal
		lay.Padding = UDim.new(0, GAP)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		lay.Parent = row
		local n = #defs
		local out: { TextButton } = {}
		for i, d in ipairs(defs) do
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.Size = UDim2.new(1 / n, -GAP * (n - 1) / n, 1, 0)
			b.BackgroundColor3 = if d.Robux then Color3.fromRGB(40, 32, 12) else Constants.Colors.Gunmetal
			b.Font = Enum.Font.GothamBold
			b.TextSize = PanelShell.Text(13)
			b.TextWrapped = true
			b.TextColor3 = if d.Robux or d.Gold then Constants.Colors.Gold else Constants.Colors.Text
			b.Text = d.Label
			b.BorderSizePixel = 0
			b.Active = true
			b.AutoButtonColor = true
			UIUtil.Corner(b, 8)
			local st = Instance.new("UIStroke")
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			st.Color = if d.Robux then Color3.fromRGB(255, 200, 60) else Constants.Colors.Gold
			st.Thickness = if d.Robux then 2 else 1.25
			st.Parent = b
			b.Parent = row
			b.Activated:Connect(d.OnClick)
			table.insert(out, b)
		end
		y += BTN_H + GAP
		return out
	end

	-- v30 P2W visibility (Reaper-style): Commander Pack / Extra Slot at top — free recruits unchanged below
	local function promptArmyRobux(productKey: string)
		local def = MonetizationConfig.DevProducts[productKey]
		if not def or (tonumber(def.Id) or 0) == 0 then
			NotificationController.Show("Offer coming soon", "Info", 2)
			return
		end
		task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestPurchaseDevProduct, productKey)
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, def.Id)
		end)
	end

	local starter = MonetizationConfig.DevProducts.StarterBundle
	local extraSlot = MonetizationConfig.DevProducts.ExtraSoldierSlot
	local starterLive = starter ~= nil and (tonumber(starter.Id) or 0) ~= 0
	local slotLive = extraSlot ~= nil and (tonumber(extraSlot.Id) or 0) ~= 0
	local robuxDefs: { { Label: string, OnClick: () -> (), Gold: boolean?, Robux: boolean? } } = {}
	if starterLive and starter then
		local price = tonumber(starter.RobuxPrice) or 249
		table.insert(robuxDefs, {
			Label = string.format("★ COMMANDER PACK  %d R$", price),
			OnClick = function()
				promptArmyRobux("StarterBundle")
			end,
			Gold = true,
			Robux = true,
		})
	end
	if slotLive and extraSlot then
		local price = tonumber(extraSlot.RobuxPrice) or 79
		table.insert(robuxDefs, {
			-- a secondary ExtraSoldierSlot chip when the Commander Pack is also offered
			Label = if starterLive then string.format("+1 SLOT  %d R$", price) else string.format("★ EXTRA SOLDIER SLOT  %d R$", price),
			OnClick = function()
				promptArmyRobux("ExtraSoldierSlot")
			end,
			Gold = true,
			Robux = true,
		})
	end
	if #robuxDefs > 0 then
		buttonRow(robuxDefs)
	end

	local recruitBtns = buttonRow({
		{
			Label = "RECRUIT x1 $500",
			OnClick = function()
				task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestRecruitSoldiers, 1)
			end,
			Gold = true,
		},
		{
			Label = "RECRUIT x5",
			OnClick = function()
				task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestRecruitSoldiers, 5)
			end,
			Gold = true,
		},
		{
			Label = "FILL CAP",
			OnClick = function()
				ensureArmyState()
				local free = if typeof(armyState) == "table" then tonumber(armyState.SlotsFree) or 0 else 0
				if free > 0 then
					task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestRecruitSoldiers, math.min(free, 50))
				else
					NotificationController.Show("Army full or no slots — upgrade the Barracks", "Warn", 3)
				end
			end,
		},
	})
	local recruit1, recruit5 = recruitBtns[1], recruitBtns[2]
	buttonRow({
		{
			Label = "DISMISS x1",
			OnClick = function()
				task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestDismissSoldiers, 1)
			end,
		},
		{
			Label = "DISMISS x5",
			OnClick = function()
				task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestDismissSoldiers, 5)
			end,
		},
	})

	-- Keep recruit labels priced
	local prevRefresh = refreshLabels
	refreshLabels = function()
		prevRefresh()
		local cost = if typeof(armyState) == "table" then tonumber(armyState.RecruitCostCash) or 500 else 500
		if recruit1 then
			recruit1.Text = string.format("RECRUIT x1 $%d", cost)
		end
		if recruit5 then
			recruit5.Text = string.format("RECRUIT x5 $%d", cost * 5)
		end
	end

	local noteSize = PanelShell.Text(12)
	local note = Instance.new("TextLabel")
	note.Name = "Note"
	note.BackgroundTransparency = 1
	note.Position = UDim2.fromOffset(16, y)
	note.Size = UDim2.new(1, -32, 0, noteSize * 2 + 8)
	note.Font = Enum.Font.GothamMedium
	note.TextSize = noteSize
	note.TextWrapped = true
	note.TextXAlignment = Enum.TextXAlignment.Left
	note.TextYAlignment = Enum.TextYAlignment.Top
	note.TextColor3 = Constants.Colors.Muted
	-- copy by device (mobile plan P1-15): the Y key only for keyboard / gamepad players (HudLayout.PrefersKeys)
	local function noteText(keys: boolean): string
		return if keys
			then "Recruits cost Cash; ★ Robux packs are optional. Squad orders: the Army tile or Y."
			else "Recruits cost Cash; ★ Robux packs are optional. Squad orders: tap the Army tile, hold it to switch."
	end
	note.Text = noteText(HudLayout.PrefersKeys())
	HudLayout.InputModeChanged:Connect(function(keys: boolean)
		note.Text = noteText(keys)
	end)
	note.Parent = body
	y += noteSize * 2 + 12
	body.CanvasSize = UDim2.fromOffset(0, y)
	if isTouch then
		-- phones: as tall as the content (the desktop panel keeps its fixed 580 × 364 v)
		sizeCap.MaxSize = Vector2.new(sizeCap.MaxSize.X, math.min(sizeCap.MaxSize.Y, headerH + y + 8))
	end

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return open
		end,
		Close = function()
			setOpen(false)
		end,
	})

	Remotes.BindEvent(Constants.RemoteNames.SoldierStateUpdate, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		armyState = payload
		refreshLabels()
	end)

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: any)
		if typeof(armyState) ~= "table" then
			synthesizeFromPlayerState(state)
			refreshLabels()
		elseif typeof(state) == "table" and typeof(state.Soldiers) == "number" then
			-- Keep count fresh if SoldierStateUpdate was missed mid-session
			armyState.Soldiers = state.Soldiers
			local cap = tonumber(armyState.MaxSoldiers) or 0
			armyState.SlotsFree = math.max(0, cap - state.Soldiers)
			refreshLabels()
		end
	end)

	task.defer(ensureArmyState)
	refreshLabels()
	print("[WAR EMPIRE] ArmyController ready (Activated recruit + state hydrate)")
end

function ArmyController.Toggle()
	local sh = shell
	if not open and sh and sh.TapThrough() then
		return
	end
	setOpen(not open)
end

function ArmyController.Open()
	setOpen(true)
end

function ArmyController.Close()
	setOpen(false)
end

function ArmyController.IsOpen(): boolean
	return open
end

return ArmyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">BankRaidController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Empire Bank raid HUD — v70 "clean screen": the vault hold bar is a top-centre stack item (spec §3.4, slot
	"Progress"; was a 340×78 card at (0.5, 0, 1, -330) in the middle of the screen). One ProgressPill:
	  in the vault, nothing held yet  "STAND TO LOOT $15K–$35K"   0%
	  holding                         "RAIDING EMPIRE BANK"       62%   gold bar
	  under fire                      "UNDER FIRE · CLEAR GUARDS" 62%   red bar + red edge
	  cooldown (standing on the vault) "EMPIRE BANK COOLDOWN"      4m    grey
	Shows while InVault / HoldProgress > 0 / UnderFire (BankRaidStateUpdate), hidden while Dead.
	Display only: the server decides every payout.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local Remotes = require(Shared.Remotes)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local ProgressPill = require(script.Parent.Parent.Modules.ProgressPill)

local BankRaidController = {}

local player = Players.LocalPlayer

local _gui: ScreenGui? = nil
local pill: ProgressPill.Pill? = nil
local active = false -- the server says the local player is at / in the vault (see Apply)

local UNDER_FIRE = Color3.fromRGB(255, 96, 72)
local HOLD_FILL = HudConfig.Colors.Gold

export type BankRaidStatePayload = {
	BankId: string?,
	DisplayName: string?,
	Enabled: boolean?,
	CooldownRemaining: number?,
	RaidHoldSeconds: number?,
	HoldNeed: number?,
	HoldProgress: number?,
	InVault: boolean?,
	UnderFire: boolean?,
	CashHintMin: number?,
	CashHintMax: number?,
}

local function setVisible(visible: boolean)
	if active == visible then
		return
	end
	active = visible
	local p = pill
	if p then
		HudLayout.RefreshVisibility(p.Frame)
	end
end

-- "$15K" / "$1.2M" / "$900" — keeps the loot hint short enough for the 320 v pill
local function shortCash(n: number): string
	local a = math.abs(n)
	if a >= 1e6 then
		local s = string.format("%.1f", n / 1e6):gsub("%.0$", "")
		return "$" .. s .. "M"
	elseif a >= 1e3 then
		local s = string.format("%.1f", n / 1e3):gsub("%.0$", "")
		return "$" .. s .. "K"
	end
	return "$" .. tostring(math.floor(n))
end

function BankRaidController.Apply(payload: BankRaidStatePayload)
	if payload.Enabled == false then
		setVisible(false)
		return
	end

	local inVault = payload.InVault == true
	local underFire = payload.UnderFire == true
	local hold = tonumber(payload.HoldProgress) or 0
	local need = tonumber(payload.HoldNeed) or tonumber(payload.RaidHoldSeconds) or 8
	if need <= 0 then
		need = 8
	end
	local cd = math.max(0, math.floor(tonumber(payload.CooldownRemaining) or 0))
	local name = payload.DisplayName or "Empire Bank"

	local show = inVault or hold > 0 or underFire
	if not show then
		setVisible(false)
		return
	end

	local p = pill
	if p then
		local frac = math.clamp(hold / need, 0, 1)
		if cd > 0 then
			p.Title.Text = string.upper(name) .. " COOLDOWN"
			p.Title.TextColor3 = ProgressPill.Colors.Title
			p.Value.Text = string.format("%dm", math.max(1, math.ceil(cd / 60)))
			p.Fill.BackgroundColor3 = ProgressPill.Colors.Idle
			ProgressPill.SetFraction(p, 0)
			ProgressPill.ResetStroke(p)
		elseif underFire then
			p.Title.Text = "UNDER FIRE · CLEAR GUARDS"
			p.Title.TextColor3 = UNDER_FIRE
			p.Value.Text = ProgressPill.Percent(frac)
			p.Fill.BackgroundColor3 = UNDER_FIRE
			ProgressPill.SetFraction(p, frac)
			ProgressPill.AccentStroke(p, UNDER_FIRE)
		else
			if hold > 0 then
				p.Title.Text = "RAIDING " .. string.upper(name)
			else
				local cashMin = tonumber(payload.CashHintMin) or 15000
				local cashMax = tonumber(payload.CashHintMax) or 35000
				p.Title.Text = string.format("STAND TO LOOT %s–%s", shortCash(cashMin), shortCash(cashMax))
			end
			p.Title.TextColor3 = ProgressPill.Colors.Title
			p.Value.Text = ProgressPill.Percent(frac)
			p.Fill.BackgroundColor3 = HOLD_FILL
			ProgressPill.SetFraction(p, frac)
			ProgressPill.ResetStroke(p)
		end
	end
	setVisible(true)
end

function BankRaidController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireBankRaid"
	-- Core safe insets + the one HUD UIScale; DisplayOrder from HudConfig (32: above the capture bar's gui)
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = player:WaitForChild("PlayerGui")
	_gui = screen

	local p = ProgressPill.Build(screen, "BankRaidProgress")
	pill = p
	HudLayout.BindVisibility(p.Frame, { HideWhen = { "Dead" } }, function(): boolean
		return active
	end)
	HudLayout.RegisterTopStack("BankRaid", p.Frame, HudConfig.TopStack.Order.Progress, { Space = "Hud" })

	Remotes.BindEvent(Constants.RemoteNames.BankRaidStateUpdate, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		BankRaidController.Apply(payload :: BankRaidStatePayload)
	end)

	print("[WAR EMPIRE] BankRaidController ready")
end

return BankRaidController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">BaseController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Base overview panel. v71 console-only buying: it NEVER buys.
	Each row: level, next cost or the first unmet requirement, income; the row button is GO — a guide line to that
	structure's console on YOUR plot (Modules/ConsoleWaypoint) — and the panel closes. Buying happens at the console
	only (WorldPromptController BUY button / the console prompt); the server refuses remote buys (NotAtConsole).
	v70 "clean screen" (spec §3.7 / §3.8):
	  * No HUD button any more: the "BASE [B]" / "Base Upgrades [B]" CTA and the stale first-join hint toasts
	    are gone. The menu opens from B (HudConfig.Keys.Base, respects gameProcessed / chat), the Command Center
	    map-table terminal (WE_OpenPanel "Base") and the tutorial CTA.
	  * Passive income moved here from the cash pill: the subtitle reads "+$N/tick passive · +$N/tick training".
	  * A registered Modal panel (HudLayout id "Base") with the black dim; one HUD scale + safe area.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)

local PanelShell = require(script.Parent.Parent.Modules.PanelShell)
local NotificationController = require(script.Parent.NotificationController)
local ConsoleWaypoint = require(script.Parent.Parent.Modules.ConsoleWaypoint)

local BaseController = {}

local PANEL_ID = "Base"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local upgrades: { [string]: number } = {}
local cash = 0
local passivePerTick = 0
local trainingPerTick = 0
local myPlotId: number? = nil -- BaseStateUpdate.PlotId / PlayerStateUpdate.Base.PlotId (nil until the plot is known)
local menuOpen = false
local screenGui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local subLabel: TextLabel? = nil
local shell: PanelShell.Shell? = nil

local setOpen: (boolean) -> ()

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function commas(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

-- the passive-income hint that used to sit on the cash pill ("+N$/tick")
local function refreshSubtitle()
	local sub = subLabel
	if not sub then
		return
	end
	local tickSec = (EconomyConfig.PassiveIncome and tonumber(EconomyConfig.PassiveIncome.TickSeconds)) or 5
	local parts = { string.format("+$%s/tick passive", commas(passivePerTick)) }
	if trainingPerTick > 0 then
		table.insert(parts, string.format("+$%s/tick training", commas(trainingPerTick)))
	end
	sub.Text = table.concat(parts, " · ") .. string.format("  (every %ds)", tickSec)
end

local function refreshList()
	if not listFrame then
		return
	end
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local layout = listFrame:FindFirstChildOfClass("UIListLayout")
	if not layout then
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = listFrame
	end

	local TAP = PanelShell.TouchMinV()
	local rowH = TAP + 16
	local titleSize = PanelShell.Text(15)
	local descSize = PanelShell.Text(12)
	local btnW = if PanelShell.IsTouch() then 120 else 88 -- GO / MAX chip (was the "BUY $N +N/t" button)

	for order, structureId in ipairs(BaseConfig.StructureOrder) do
		local def = BaseConfig.Structures[structureId]
		if def then
			local level = upgrades[structureId] or 0
			local nextLevel = level + 1
			local cost = if nextLevel <= def.MaxLevel then def.Costs[nextLevel] else nil

			local row = Instance.new("Frame")
			row.Name = structureId
			row.Size = UDim2.new(1, -8, 0, rowH)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = order
			row.Parent = listFrame
			corner(row, 8)

			-- Highlight first purchasable row (Command Center) when still L0
			if structureId == "CommandCenter" and level == 0 then
				local stroke = Instance.new("UIStroke")
				stroke.Color = Constants.Colors.Gold
				stroke.Thickness = 2
				stroke.Parent = row
			end

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromOffset(12, 6)
			title.Size = UDim2.new(1, -(btnW + 28), 0, titleSize + 6)
			title.Font = Enum.Font.GothamBold
			title.TextSize = titleSize
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.TextColor3 = Constants.Colors.Text
			title.TextTruncate = Enum.TextTruncate.AtEnd
			title.Text = string.format("%s  Lv%d/%d", def.DisplayName, level, def.MaxLevel)
			title.Parent = row

			local desc = Instance.new("TextLabel")
			desc.BackgroundTransparency = 1
			desc.Position = UDim2.fromOffset(12, titleSize + 14)
			desc.Size = UDim2.new(1, -(btnW + 28), 0, descSize + 6)
			desc.Font = Enum.Font.GothamMedium
			desc.TextSize = descSize
			desc.TextXAlignment = Enum.TextXAlignment.Left
			desc.TextColor3 = Constants.Colors.Muted
			desc.Text = def.Description
			desc.TextTruncate = Enum.TextTruncate.AtEnd
			desc.Parent = row

			local btn = Instance.new("TextButton")
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -8, 0.5, 0)
			btn.Size = UDim2.fromOffset(btnW, TAP)
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = PanelShell.Text(13)
			btn.TextColor3 = Constants.Colors.Text
			btn.TextWrapped = true
			btn.AutoButtonColor = true
			btn.BorderSizePixel = 0
			corner(btn, 8)

			if not cost then
				btn.Text = ConsoleBuyConfig.Text.Max
				btn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
				btn.AutoButtonColor = false
				btn.Active = false
			else
				-- v71: overview only. GO draws a guide line to this structure's console on your plot; buying happens
				-- there (BUY button / hold the console prompt). The server refuses a remote buy (NotAtConsole).
				local rates = EconomyConfig.PassiveIncome and EconomyConfig.PassiveIncome.PerLevelRates
				local rate = if typeof(rates) == "table" then (tonumber(rates[structureId]) or 0) else 0
				local incomeSuffix = if rate > 0 then ("  +" .. tostring(rate) .. "/t") else ""
				local lockedBy: string? = nil
				for _, req in ipairs(def.Requires or {}) do
					if (upgrades[req.StructureId] or 0) < req.Level then
						local rdef = BaseConfig.Structures[req.StructureId]
						lockedBy = string.format(ConsoleBuyConfig.Text.Needs, if rdef then rdef.DisplayName else req.StructureId, req.Level)
						break
					end
				end
				local price = "$" .. commas(cost)
				if lockedBy then
					desc.Text = lockedBy
					desc.TextColor3 = Color3.fromRGB(235, 120, 110)
				elseif level == 0 then
					desc.Text = string.format(ConsoleBuyConfig.Text.Build, price) .. incomeSuffix
				else
					desc.Text = string.format(ConsoleBuyConfig.Text.Upgrade, level, nextLevel, price) .. incomeSuffix
				end
				btn.Text = ConsoleBuyConfig.Text.Go
				-- accent when unlocked and affordable; grey otherwise but still tappable (GO finds the console)
				local ready = lockedBy == nil and cash >= cost
				btn.BackgroundColor3 = if ready then Constants.Colors.Accent else Color3.fromRGB(58, 62, 68)
				btn.Active = true
				UIUtil.EnsureMinTouch(btn, TAP)
				local function onGo()
					if ConsoleWaypoint.Show(structureId, myPlotId) then
						setOpen(false)
						NotificationController.Show(string.format(ConsoleBuyConfig.Text.WaypointSet, def.DisplayName), "Info", 2)
					else
						NotificationController.Show(ConsoleBuyConfig.Text.NoConsole, "Warn", 2.5)
					end
				end
				-- v67: Activated only (fires once for mouse, touch and gamepad)
				btn.Activated:Connect(onGo)
			end
			btn.Parent = row
		end
	end

	local l = listFrame:FindFirstChildOfClass("UIListLayout")
	if l then
		listFrame.CanvasSize = UDim2.fromOffset(0, l.AbsoluteContentSize.Y + 12)
	end
end

function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("UpgradePanel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
	local sh = shell
	if sh then
		sh.Sync(open)
	end
	if open then
		refreshSubtitle()
		refreshList()
	end
end

function BaseController.Open()
	setOpen(true)
end

function BaseController.Close()
	setOpen(false)
end

function BaseController.Toggle()
	local sh = shell
	if not menuOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not menuOpen)
end

function BaseController.IsOpen(): boolean
	return menuOpen
end

function BaseController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "WarEmpireBaseUI"
	-- DisplayOrder 58 (HudConfig.DisplayOrder.WarEmpireBaseUI): above the HUD (55); one HUD scale + safe area
	PanelShell.Screen(gui, HudConfig.DisplayOrder.WarEmpireBaseUI)
	gui.Parent = player:WaitForChild("PlayerGui")
	screenGui = gui

	local TAP = PanelShell.TouchMinV()
	local panel = Instance.new("Frame")
	panel.Name = "UpgradePanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.94, 0, 1, -16) else UDim2.fromOffset(480, 520)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 12)
	do
		local ps = Instance.new("UIStroke")
		ps.Color = Constants.Colors.Gold
		ps.Thickness = 1.5
		ps.Transparency = 0.4
		ps.Parent = panel
		local cap = Instance.new("UISizeConstraint")
		cap.MaxSize = if isTouch then Vector2.new(760, 620) else Vector2.new(480, 520)
		cap.Parent = panel
	end

	local title = PanelShell.Title(panel, "YOUR BASE")

	local subSize = PanelShell.Text(13)
	local sub = Instance.new("TextLabel")
	sub.Name = "PassiveIncome"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromOffset(16, title.Position.Y.Offset + title.Size.Y.Offset)
	sub.Size = UDim2.new(1, -(TAP + 28), 0, subSize + 4)
	sub.Font = Enum.Font.GothamBold
	sub.TextSize = subSize
	sub.TextColor3 = Constants.Colors.Cash
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.TextTruncate = Enum.TextTruncate.AtEnd
	sub.Text = ""
	sub.Parent = panel
	subLabel = sub

	-- v71: how buying works now (the rows only show the way)
	local how = Instance.new("TextLabel")
	how.Name = "HowToBuy"
	how.BackgroundTransparency = 1
	how.Position = UDim2.fromOffset(16, sub.Position.Y.Offset + subSize + 4)
	how.Size = UDim2.new(1, -(TAP + 28), 0, subSize + 4)
	how.Font = Enum.Font.GothamMedium
	how.TextSize = subSize
	how.TextColor3 = PanelShell.Colors.Muted
	how.TextXAlignment = Enum.TextXAlignment.Left
	how.TextTruncate = Enum.TextTruncate.AtEnd
	how.Text = ConsoleBuyConfig.Text.PanelSubtitle
	how.Parent = panel

	PanelShell.CloseButton(panel, function()
		setOpen(false)
	end)

	local listTop = math.max(TAP + 8, how.Position.Y.Offset + subSize + 10)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(10, listTop)
	scroll.Size = UDim2.new(1, -20, 1, -(listTop + 10))
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if isTouch then 6 else 4
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = panel
	listFrame = scroll

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = gui,
		Panel = panel,
		IsOpen = function(): boolean
			return menuOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})

	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: Types.BaseStatePayload)
		if typeof(base) ~= "table" then
			return
		end
		upgrades = base.Upgrades or upgrades
		if typeof(base.PlotId) == "number" then
			myPlotId = base.PlotId
		end
		if typeof(base.PassiveIncomePerTick) == "number" then
			passivePerTick = base.PassiveIncomePerTick
		end
		refreshSubtitle()
		if menuOpen then
			refreshList()
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.SoldierStateUpdate, function(payload: any)
		if typeof(payload) == "table" then
			trainingPerTick = tonumber(payload.TrainingIncomePerTick) or trainingPerTick
			refreshSubtitle()
		end
	end)

	local function applyCash(n: any)
		local v = tonumber(n)
		if typeof(v) == "number" then
			cash = math.floor(v)
			if menuOpen then
				refreshList()
			end
		end
	end

	Remotes.BindEvent(Constants.RemoteNames.EconomyUpdate, function(payload: Types.EconomyUpdatePayload)
		applyCash(payload.Cash)
	end)

	player:GetAttributeChangedSignal("WE_Cash"):Connect(function()
		applyCash(player:GetAttribute("WE_Cash"))
	end)
	applyCash(player:GetAttribute("WE_Cash"))

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: Types.PlayerStatePayload)
		applyCash(state.Cash)
		if state.Base then
			upgrades = state.Base.Upgrades
			if typeof(state.Base.PlotId) == "number" then
				myPlotId = state.Base.PlotId
			end
			if typeof(state.Base.PassiveIncomePerTick) == "number" then
				passivePerTick = state.Base.PassiveIncomePerTick
			end
		end
		if typeof(state.TrainingIncomePerTick) == "number" then
			trainingPerTick = state.TrainingIncomePerTick
		end
		refreshSubtitle()
	end)

	local baseKey: Enum.KeyCode = HudConfig.Keys.Base or Enum.KeyCode.B
	UserInputService.InputBegan:Connect(function(input, gp)
		-- Respect chat / processed UI (gp true while typing in chat).
		if gp then
			return
		end
		if input.KeyCode == baseKey then
			setOpen(not menuOpen)
		end
	end)

	refreshSubtitle()
	print("[WAR EMPIRE] BaseController ready (B / terminal / tutorial open the overview; rows GO to the console, never buy)")
end

return BaseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v70 "clean screen" combat HUD + input (spec §3.6). The client sends fire / reload / equip REQUESTS only:
	damage, ammo, magazine size (research), reload time (research) and ownership are the server's
	(CombatService pushes CombatStateUpdate / CombatHitFeedback). Numbers live in HudConfig
	(Hotbar, Health, Ammo, TouchCombat, Reticle, HitFeedback, Keys); layout helpers in Modules/HudLayout.

	HOLSTER STATE
	  You spawn HOLSTERED (HudConfig.Hotbar.DrawnOnSpawn). Tap a hotbar slot / press 1-4 to draw that weapon
	  (RequestEquipWeapon when it is not the equipped one). Holstering:
	    mouse / keyboard   click / press the drawn slot again (Hotbar.TapSelectedHolsters)
	    touch              LONG-PRESS the drawn slot (HOLSTER_HOLD_SECONDS, 0.5 s). A quick re-tap of the drawn slot
	                       keeps it drawn (TOUCH_TAP_HOLSTERS = false), so a panicked re-tap never hides FIRE
	                       (mobile plan merge gate #5 / T16)
	  Taking damage (CombatHitFeedback "Damaged", or the humanoid's health dropping) auto-draws the last weapon
	  (Hotbar.AutoDrawOnDamage). Published HudLayout flags: Drawn, Reloading, Hurt, RecentCombat.

	HOLSTERED FIRE (touch only; merge gate #5 / G14)
	  While holstered, a 4 Hz scan (ARMED_SCAN_HZ, never faster) looks for a hostile the player can SEE: another
	  player (PvP on, no spawn ForceField) or a combat NPC (tag WE_NPC with an NPCId, not a squad unit), alive,
	  within the equipped weapon's Range, on screen, and not behind a wall (≤ ARMED_MAX_LOS_RAYS camera rays per
	  scan). Then FIRE shows DIMMED in its usual place; pressing it draws AND fires in one touch. It stays up for
	  ARMED_GRACE_SECONDS after the last sighting so it does not blink when the target ducks behind cover. The
	  scan only reads positions (the server still decides every hit); tagged NPCs are tracked by CollectionService
	  signals, never a tree scan. Nothing scans while drawn, seated, in a panel or dead.

	WHAT SHOWS WHEN (HudLayout.BindVisibility with the HudConfig rules)
	  Hotbar (bottom-centre)          always — hidden while Driving / Dead / Modal / seated
	  Health bar (above the hotbar)   Hurt (HP < max, fades 3 s after full) or RecentCombat (6 s)
	  Ammo readout, touch R           Drawn — hidden while Driving / Modal / Dead / seated
	  Touch FIRE                      Drawn, or DIMMED while holstered with a visible hostile in range (above) —
	                                  hidden while Driving / Modal / Dead / seated
	  WE_Reticle                      Drawn and not Reloading. Its own ScreenGui (IgnoreGuiInset, no safe-area
	                                  insets), so it sits on the TRUE viewport centre = the aimRay point.
	  DamageEdge (in WE_Reticle)      red screen-edge flash when you are hit (no full-screen strobe); a softer
	                                  steady edge at <= Health.LowHpVignette of max HP.

	BOTTOM-RIGHT RESERVE / VEHICLES
	  FIRE, RELOAD and the touch ammo readout live inside HudLayout.Reserve("CombatTouch"). VehicleDriveClient's
	  ▲▼ column shares that space (centred over the jump button, top edge H − 212 px on phones — it no longer sits
	  below a FIRE button at H − 250), so every combat control is HIDDEN while seated: the Driving flag
	  (Humanoid.SeatPart is a VehicleSeat), any SeatPart, or the player attribute WE_DriveMode that
	  VehicleDriveClient sets while it drives. The two sets of controls are never on screen together.

	INPUT (HudConfig.Keys) — ignored while Driving / Modal / Dead / seated / the Roblox menu is open
	  LMB, touch FIRE, gamepad R2   fire ONLY while drawn (Keys.FireNeedsDrawn: a click on a ClickDetector —
	                                the tutorial dropper — never shoots while holstered). The one exception is the
	                                DIMMED touch FIRE button itself: pressing it draws first, then fires.
	                                Hold = 20 Hz; the server clamps to the (research-boosted) FireRate, so the
	                                client never does.
	  1-4                           draw / holster that hotbar slot — squad orders instead while the Army popover
	                                is open (flag OrdersOpen; OrdersController handles those keys)
	  touch hotbar slot             tap = draw / switch; LONG-PRESS the drawn slot = holster
	  Q, gamepad L1 / R1            previous / next owned weapon (draws it)
	  mouse wheel                   cycles weapons while drawn (Roblox camera zoom while holstered)
	  R, gamepad Y, touch R         reload
	  gamepad DPadUp                draw / holster
	  E                             ProximityPrompts only — it no longer cycles weapons
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local ResearchConfig = require(Shared.Configs.ResearchConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)

local CombatController = {}

local player = Players.LocalPlayer

local HB = HudConfig.Hotbar
local HP = HudConfig.Health
local AM = HudConfig.Ammo
local TC = HudConfig.TouchCombat
local RT = HudConfig.Reticle
local HF = HudConfig.HitFeedback
local KEYS = HudConfig.Keys
local GP = HudConfig.Keys.Gamepad
local COLORS = HudConfig.Colors
local FONT_DISPLAY = HudConfig.Fonts.Display
local FONT_BODY = HudConfig.Fonts.Body
local WHITE = Color3.fromRGB(255, 255, 255)

-- Optional HudConfig.HitFeedback fields (read with defaults so HudConfig can take them over later)
local HF_ANY: any = HF
local EDGE_V: number = tonumber(HF_ANY.DamageEdgeWidth) or 40 -- v, thickness of each red screen-edge strip
local EDGE_LOW_HP_TRANSPARENCY: number = tonumber(HF_ANY.LowHpEdgeTransparency) or 0.74 -- steady <= 25 % HP edge

-- Touch holster + holstered FIRE (mobile plan merge gate #5). Optional HudConfig fields, read with defaults so
-- HudConfig.Hotbar / HudConfig.TouchCombat.HolsteredFire can take them over later.
local HB_ANY: any = HudConfig.Hotbar
local TOUCH_TAP_HOLSTERS: boolean = HB_ANY.TouchTapHolsters == true -- false: a touch re-tap keeps the weapon drawn
local HOLSTER_HOLD_SECONDS: number = tonumber(HB_ANY.HolsterHoldSeconds) or 0.5 -- touch long-press on the drawn slot
local HOLD_SLOP_PX = 24 -- real px: a finger that slides further than this during the hold is a drag, not a long-press
local ARMED_CFG: any = (HudConfig.TouchCombat :: any).HolsteredFire or {}
local ARMED_FIRE_ENABLED: boolean = ARMED_CFG.Enabled ~= false
local ARMED_SCAN_HZ: number = math.clamp(tonumber(ARMED_CFG.ScanHz) or 4, 1, 4) -- hard cap 4 Hz
local ARMED_GRACE_SECONDS: number = tonumber(ARMED_CFG.GraceSeconds) or 1.5 -- keep the dimmed FIRE after a sighting
local ARMED_MAX_LOS_RAYS: number = math.clamp(tonumber(ARMED_CFG.MaxLosRays) or 4, 1, 8) -- nearest first, per scan
local ARMED_MAX_CANDIDATES = 16 -- in-range, on-screen targets kept per scan (the nearest are ray-checked)
local FIRE_DIM_BG: Color3 = if typeof(ARMED_CFG.Color) == "Color3" then ARMED_CFG.Color else Color3.fromRGB(112, 40, 42)
local FIRE_DIM_INK: Color3 = if typeof(ARMED_CFG.IconColor) == "Color3" then ARMED_CFG.IconColor else Color3.fromRGB(226, 196, 196)
local FIRE_DIM_TRANSPARENCY: number = tonumber(ARMED_CFG.Transparency) or 0.2
local FIRE_BG_TRANSPARENCY = 0.05

-- Roblox's engine touch jump button (TouchJump): 70 px at (1, -95, 1, -90) of the safe area when
-- min(viewport) <= 500, otherwise 120 px at (1, -170, 1, -210). HudConfig.TouchCombat / Ammo.BottomTouch are the
-- small-button (phone) layout — every phone lands on S = 0.70, where 86 / 152 v = 60 / 106 px: FIRE centred
-- over the jump button, 16 px above it (CLAUDE.md: nothing within 16 px of the jump button). Large-button tablets
-- derive the same placement from the big button.
local SMALL_JUMP_MAX_AXIS = 500
local LARGE_JUMP_CENTRE_FROM_RIGHT = 110 -- px: 170 − 120 / 2
local LARGE_JUMP_TOP_FROM_BOTTOM = 210 -- px
local FIRE_ABOVE_JUMP = 16 -- px (CLAUDE.md reserved zones: nothing within 16 px of the jump button)

local EQUIP_PENDING_SECONDS = 0.8
local WHEEL_MIN_GAP = 0.12
local AUTO_RELOAD_MIN_GAP = 1
local ACTION_WHEEL = "WE_WeaponWheel"
local GAMEPAD_TYPES: { [Enum.UserInputType]: boolean } = {}
for i = 1, 8 do
	local ok, item = pcall(function(): any
		return (Enum.UserInputType :: any)["Gamepad" .. i]
	end)
	if ok and item ~= nil then
		GAMEPAD_TYPES[item] = true
	end
end

type Slot = {
	Cell: Frame,
	Button: TextButton,
	Stroke: UIStroke,
	Scale: UIScale,
	Name: TextLabel,
	-- touch press tracking (long-press holster)
	PressInput: InputObject?, -- the finger currently down on this slot
	PressToken: number,
	LastTouch: boolean, -- the last press on this slot was a finger (tap semantics), not the mouse
	LongFired: boolean, -- the long-press holstered: swallow the Activated that the release fires
}

-- gui objects
local hotbar: Frame? = nil
local healthPanel: Frame? = nil
local healthFill: Frame? = nil
local ammoPanel: Frame? = nil
local ammoName: TextLabel? = nil
local ammoCount: TextLabel? = nil
local ammoMag: TextLabel? = nil
local ammoBarFill: Frame? = nil
local fireBtn: TextButton? = nil
local fireIcon: Frame? = nil
local fireDimmed: boolean? = nil -- current FIRE style (nil = not styled yet)
local reloadBtn: TextButton? = nil
local reticle: Frame? = nil
local hitMarker: Frame? = nil
local damageEdge: Frame? = nil
local edgeStrips: { Frame } = {}
local bound: { GuiObject } = {}
local slots: { Slot } = {}

-- server state (CombatStateUpdate)
local currentWeaponId: string? = nil
local ammo = 0
local magazineSize = 0
local reloading = false
local alive = true
local health = 100
local maxHealth = 100
local healthKnown = false -- a CombatStateUpdate arrived for this life (health drops before that are no damage)

-- client state
local initialized = false
local isTouch = false
local drawn = HB.DrawnOnSpawn == true
local firing = false -- mouse / gamepad hold
local fireTouches: { [InputObject]: boolean } = {} -- touch FIRE holds, one entry per finger
local knownLevel: number? = nil
local lastEquipRequestId: string? = nil
local lastEquipRequestAt = -math.huge
local slotIds: { string } = {}
local hotbarKey = "?"
local reloadMult = 1 -- research WeaponReload (display only: the reload bar's duration)
local reloadTween: Tween? = nil
local lastAutoReloadAt = -math.huge
local lastWheelAt = -math.huge
local lastEdgeFlashAt = -math.huge
local edgeToken = 0
local markerToken = 0
local lastCombatAt = -math.huge
local combatWatching = false
local fullSince: number? = nil
local hurtWatching = false
local wheelBound = false
local humanoid: Humanoid? = nil
local lastHumHealth: number? = nil
local humConns: { RBXScriptConnection } = {}
local pressToken = 0
-- holstered FIRE (touch): a visible hostile in range while holstered
local fireArmed = false
local armedSeenAt = -math.huge
local lastScanAt = -math.huge
local lastScanResult = false
local scanCount = 0 -- scans run (tests read it through CombatController.ArmedScanCount)
local npcModels: { [Instance]: boolean } = {} -- tagged WE_NPC models (CollectionService signals; no tree scans)
local losParams = RaycastParams.new() -- line-of-sight rays of the holstered-FIRE scan
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true
losParams.RespectCanCollide = true -- decor / zones / prompt hosts do not hide a target
local candDist: { number } = {}
local candModel: { Model } = {}
local candPos: { Vector3 } = {}

-- forward declarations
local requestFire: () -> ()
local requestReload: () -> ()
local setDrawn: (on: boolean) -> ()
local refreshHotbar: () -> ()
local refreshAmmo: () -> ()
local updateWheelBinding: () -> ()
local refreshFire: () -> ()
local armedTick: () -> ()

local function clock(): number
	return os.clock()
end

local function stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.Parent = parent
	return s
end

local function round(parent: Instance)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = parent
end

---------------------------------------------------------------------------------------------------------------
-- context: seated / blocked
---------------------------------------------------------------------------------------------------------------

-- Seated in anything (driver or passenger) or driving through VehicleDriveClient (WE_DriveMode).
local function seatedNow(): boolean
	if HudLayout.GetFlag("Driving") then
		return true
	end
	local mode = player:GetAttribute("WE_DriveMode")
	if typeof(mode) == "string" and mode ~= "" then
		return true
	end
	local hum = humanoid
	return hum ~= nil and hum.Parent ~= nil and hum.SeatPart ~= nil
end

local function combatBlocked(): boolean
	if not alive or GuiService.MenuIsOpen or seatedNow() then
		return true
	end
	for _, f in ipairs(KEYS.CombatInputBlockedWhen) do
		if HudLayout.GetFlag(f) then
			return true
		end
	end
	return false
end

local function stopFiring()
	firing = false
	table.clear(fireTouches)
end

local function refreshBound()
	for _, obj in ipairs(bound) do
		HudLayout.RefreshVisibility(obj)
	end
end

local function publishDrawn()
	HudLayout.SetFlag("Drawn", drawn and alive and not HudLayout.GetFlag("Dead"))
	refreshFire() -- FIRE's rule reads Drawn through its extra() (it also shows dimmed while holstered)
end

---------------------------------------------------------------------------------------------------------------
-- flags: RecentCombat (fired / hit / hurt within Health.RecentCombatSeconds), Hurt (HP < max, + fade after full)
---------------------------------------------------------------------------------------------------------------

local function markCombat()
	lastCombatAt = clock()
	HudLayout.SetFlag("RecentCombat", true)
	if combatWatching then
		return
	end
	combatWatching = true
	task.spawn(function()
		while true do
			local left = lastCombatAt + HP.RecentCombatSeconds - clock()
			if left <= 0 then
				break
			end
			task.wait(left + 0.05)
		end
		combatWatching = false
		HudLayout.SetFlag("RecentCombat", false)
	end)
end

local function refreshHurt()
	if alive and maxHealth > 0 and health < maxHealth - 0.5 then
		fullSince = nil
		HudLayout.SetFlag("Hurt", true)
		return
	end
	if not alive then
		fullSince = nil
		HudLayout.SetFlag("Hurt", false)
		return
	end
	if not HudLayout.GetFlag("Hurt") then
		return
	end
	if fullSince == nil then
		fullSince = clock()
	end
	if hurtWatching then
		return
	end
	hurtWatching = true
	task.spawn(function()
		while true do
			local since = fullSince
			if since == nil then
				break -- hurt again (or dead): the flag is already right
			end
			local left = since + HP.HideAfterFullSeconds - clock()
			if left <= 0 then
				HudLayout.SetFlag("Hurt", false)
				break
			end
			task.wait(left + 0.05)
		end
		hurtWatching = false
	end)
end

---------------------------------------------------------------------------------------------------------------
-- damage edge (replaces the full-screen strobe) + hit marker
---------------------------------------------------------------------------------------------------------------

local function steadyEdge(): number
	if alive and maxHealth > 0 and health > 0 and health / maxHealth <= HP.LowHpVignette then
		return EDGE_LOW_HP_TRANSPARENCY
	end
	return 1
end

local function setEdge(transparency: number)
	local e = damageEdge
	if not e then
		return
	end
	for _, s in ipairs(edgeStrips) do
		s.BackgroundTransparency = transparency
	end
	e.Visible = transparency < 0.99
end

local function flashEdge()
	local t = clock()
	if t - lastEdgeFlashAt < HF.DamageEdgeMinGap then
		return
	end
	lastEdgeFlashAt = t
	edgeToken += 1
	local token = edgeToken
	setEdge(HF.DamageEdgeTransparency)
	task.delay(HF.DamageEdgeSeconds, function()
		if edgeToken == token then
			setEdge(steadyEdge())
		end
	end)
end

local function showHitMarker(kind: string)
	local m = hitMarker
	if not m then
		return
	end
	local color = if kind == "Kill" then Color3.fromRGB(255, 90, 70) else Color3.fromRGB(255, 230, 80)
	for _, child in ipairs(m:GetChildren()) do
		if child:IsA("Frame") then
			child.BackgroundColor3 = color
		end
	end
	m.Visible = true
	markerToken += 1
	local token = markerToken
	task.delay(HF.HitMarkerSeconds, function()
		if markerToken == token and hitMarker then
			hitMarker.Visible = false
		end
	end)
end

local function onDamaged()
	if not alive then
		return
	end
	markCombat()
	flashEdge()
	-- ambush: draw the last weapon (not from a seat — combat is hidden there and Q/1-4 belong to the vehicle)
	if HB.AutoDrawOnDamage and not drawn and not seatedNow() and not HudLayout.GetFlag("Dead") then
		setDrawn(true)
	end
end

---------------------------------------------------------------------------------------------------------------
-- health
---------------------------------------------------------------------------------------------------------------

local function applyHealth(h: number, mx: number)
	if h ~= h or mx ~= mx then
		return
	end
	health = math.max(0, h)
	maxHealth = math.max(0, mx)
	local fill = healthFill
	if fill and maxHealth > 0 then
		local ratio = math.clamp(health / maxHealth, 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = if ratio <= 0.25 then HP.Low elseif ratio <= 0.5 then HP.Mid else HP.Fill
	end
	if clock() - lastEdgeFlashAt >= HF.DamageEdgeSeconds then
		setEdge(steadyEdge())
	end
	refreshHurt()
end

---------------------------------------------------------------------------------------------------------------
-- weapons: owned list, hotbar slots, equip / cycle / draw
---------------------------------------------------------------------------------------------------------------

local function shortName(id: string): string
	local def = WeaponConfig.Weapons[id]
	if not def then
		return string.upper(id)
	end
	local sn = def.ShortName
	if sn ~= nil and sn ~= "" then
		return sn
	end
	return string.upper(def.DisplayName)
end

--[[ Owned weapons the server would equip (WE_Weapons attribute, at/above UnlockLevel when the level is known),
	in the Shop › WEAPONS order (WeaponConfig.SortedIds). The server's equipped weapon is always included. ]]
local function ownedCandidates(): { string }
	local owned = WeaponConfig.ParseOwned(player:GetAttribute("WE_Weapons"))
	local level = knownLevel
	local ids: { string } = {}
	for _, id in ipairs(WeaponConfig.SortedIds()) do
		local def = WeaponConfig.Weapons[id]
		if owned[id] and (level == nil or level >= def.UnlockLevel) then
			table.insert(ids, id)
		end
	end
	local cur = currentWeaponId
	if cur and WeaponConfig.Weapons[cur] and not table.find(ids, cur) then
		table.insert(ids, cur)
	end
	return ids
end

-- the weapon just requested (state push not back yet) or the server's equipped one
local function activeWeaponId(): string?
	local pending = lastEquipRequestId
	if pending and clock() - lastEquipRequestAt < EQUIP_PENDING_SECONDS then
		return pending
	end
	return currentWeaponId
end

--[[ Up to Hotbar.MaxSlots owned weapons; with more owned, the last slot shows the active weapon when it would
	not make the cut (Q / wheel / L1 / R1 still reach every owned weapon). ]]
local function hotbarIds(): { string }
	local ids = ownedCandidates()
	local max = HB.MaxSlots
	if #ids <= max then
		return ids
	end
	local out = table.move(ids, 1, max, 1, {})
	local cur = activeWeaponId()
	if cur and not table.find(out, cur) and table.find(ids, cur) then
		out[max] = cur
	end
	return out
end

local function equip(id: string)
	lastEquipRequestId = id
	local at = clock()
	lastEquipRequestAt = at
	-- bounded (≤ 3 s) remote lookup, off the input thread
	task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestEquipWeapon, id)
	-- when the pending window ends, the hotbar highlights whatever the server actually equipped (a refused
	-- equip — level / ownership — falls back to the real weapon)
	task.delay(EQUIP_PENDING_SECONDS + 0.05, function()
		if lastEquipRequestAt == at then
			refreshHotbar()
			refreshAmmo()
		end
	end)
end

-- retapHolsters: keys 1-4 and mouse clicks use Hotbar.TapSelectedHolsters; a finger tap uses TOUCH_TAP_HOLSTERS
-- (off: on touch only a long-press on the drawn slot holsters, see makeSlot)
local function selectSlot(i: number, retapHolsters: boolean)
	local id = slotIds[i]
	if not id then
		return
	end
	local active = activeWeaponId()
	if drawn and id == active then
		if retapHolsters then
			setDrawn(false)
		end
		return
	end
	if id ~= active then
		equip(id)
	end
	setDrawn(true)
end

local function cycleWeapon(delta: number)
	local ids = ownedCandidates()
	if #ids == 0 then
		return
	end
	local from = activeWeaponId()
	local idx = if from then table.find(ids, from) else nil
	local target: string
	if idx == nil then
		target = if delta >= 0 then ids[1] else ids[#ids]
	else
		local step = if delta >= 0 then 1 else -1
		target = ids[((idx - 1 + step) % #ids) + 1]
	end
	if target ~= from then
		equip(target)
	end
	if drawn then
		refreshHotbar()
	else
		setDrawn(true)
	end
end

setDrawn = function(on: boolean)
	local changed = drawn ~= on
	if changed then
		drawn = on
		if not on then
			stopFiring()
		end
	end
	if on then
		-- drawn: the full FIRE takes over; a later holster starts a fresh sighting
		fireArmed = false
		armedSeenAt = -math.huge
	end
	publishDrawn()
	refreshHotbar()
	refreshAmmo()
	updateWheelBinding()
	if changed and not on then
		armedTick() -- holstered next to a visible hostile: FIRE goes straight to dimmed (no blink)
	end
end

---------------------------------------------------------------------------------------------------------------
-- hotbar
---------------------------------------------------------------------------------------------------------------

local function slotSize(): number
	return if isTouch then HB.Slot else HB.SlotDesktop
end

-- v from the content bottom to the health bar's bottom edge: Hotbar.Bottom + slot + Health.GapAboveHotbar,
-- raised when needed so the DRAWN slot (UIScale SelectedScale about its bottom edge + its outer stroke) keeps
-- a 2 v gap below the bar (touch 85 v, desktop 70 v; the action lane still starts at ActionLaneBottomV()).
local function healthBottomV(): number
	local s = slotSize()
	local selectedTop = s * HB.SelectedScale + HB.SelectedStrokePx
	return HB.Bottom + math.max(s + HP.GapAboveHotbar, selectedTop + 2)
end

local function styleSlot(sl: Slot, selected: boolean)
	sl.Button.BackgroundTransparency = if selected then HB.SelectedBgTransparency else HB.BgTransparency
	sl.Stroke.Thickness = if selected then HB.SelectedStrokePx else 1.5
	sl.Stroke.Transparency = if selected then 0 else HB.StrokeTransparency
	sl.Scale.Scale = if selected then HB.SelectedScale else 1
end

local function makeSlot(parent: Frame, i: number): Slot
	local s = slotSize()
	local nameSize = if isTouch then HB.NameSize else HB.NameSizeDesktop

	local cell = Instance.new("Frame")
	cell.Name = "Slot" .. i
	cell.BackgroundTransparency = 1
	cell.BorderSizePixel = 0
	cell.Size = UDim2.fromOffset(s, s)
	cell.LayoutOrder = i
	cell.Active = false

	-- the button fills the cell; its UIScale (selected 1.08) grows it about the bottom-centre anchor
	local btn = Instance.new("TextButton")
	btn.Name = "SlotButton"
	btn.AnchorPoint = Vector2.new(0.5, 1)
	btn.Position = UDim2.fromScale(0.5, 1)
	btn.Size = UDim2.fromScale(1, 1)
	btn.BackgroundColor3 = HB.Bg
	btn.BackgroundTransparency = HB.BgTransparency
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.Active = true
	btn.Parent = cell
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, HB.Corner)
	c.Parent = btn
	local st = stroke(btn, HB.Stroke, 1.5, HB.StrokeTransparency)
	local sc = Instance.new("UIScale")
	sc.Name = "SlotScale"
	sc.Parent = btn

	local num = Instance.new("TextLabel")
	num.Name = "Number"
	num.BackgroundTransparency = 1
	num.Position = UDim2.fromOffset(5, 2)
	num.Size = UDim2.fromOffset(20, HB.NumberSize + 2)
	num.Font = FONT_BODY
	num.TextSize = HB.NumberSize
	num.TextColor3 = WHITE
	num.TextTransparency = 0.3
	num.TextXAlignment = Enum.TextXAlignment.Left
	num.TextYAlignment = Enum.TextYAlignment.Top
	num.Text = tostring(i)
	num.Active = false
	num.Parent = btn
	UIUtil.TextOutline(num, 1, nil, 0.3)

	-- a little wider than the slot (into the gap) so "SHOTGUN" keeps its full size on phones
	local name = Instance.new("TextLabel")
	name.Name = "WeaponName"
	name.BackgroundTransparency = 1
	name.AnchorPoint = Vector2.new(0.5, 1)
	name.Position = UDim2.new(0.5, 0, 1, -4)
	name.Size = UDim2.new(1, HB.Gap + 4, 0, nameSize + 4)
	name.Font = FONT_BODY
	name.TextScaled = true
	name.TextColor3 = WHITE
	name.Text = ""
	name.Active = false
	name.Parent = btn
	local tc = Instance.new("UITextSizeConstraint")
	tc.MaxTextSize = nameSize
	tc.Parent = name
	UIUtil.TextOutline(name, 1)

	local sl: Slot = {
		Cell = cell,
		Button = btn,
		Stroke = st,
		Scale = sc,
		Name = name,
		PressInput = nil,
		PressToken = 0,
		LastTouch = false,
		LongFired = false,
	}

	-- A finger on the slot: remember it; still down (and still on the slot) after HOLSTER_HOLD_SECONDS while this
	-- slot is the drawn weapon → holster. The release that follows fires Activated, which is swallowed.
	btn.InputBegan:Connect(function(io: InputObject)
		local ut = io.UserInputType
		if ut == Enum.UserInputType.MouseButton1 then
			sl.LastTouch = false
			sl.LongFired = false
			return
		end
		if ut ~= Enum.UserInputType.Touch then
			return
		end
		sl.LastTouch = true
		sl.LongFired = false
		pressToken += 1
		local token = pressToken
		sl.PressToken = token
		sl.PressInput = io
		local startPos = io.Position
		task.delay(HOLSTER_HOLD_SECONDS, function()
			if sl.PressToken ~= token or sl.PressInput ~= io or cell.Parent == nil then
				return -- released, another press, or the hotbar was rebuilt
			end
			local state = io.UserInputState
			if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				return
			end
			if (io.Position - startPos).Magnitude > HOLD_SLOP_PX then
				return -- the finger slid away: a drag, not a hold
			end
			if not drawn or combatBlocked() then
				return
			end
			local id = slotIds[i]
			if id == nil or id ~= activeWeaponId() then
				return -- long-press on another weapon's slot: the release draws / switches as a tap
			end
			sl.LongFired = true
			setDrawn(false)
		end)
	end)
	btn.InputEnded:Connect(function(io: InputObject)
		if sl.PressInput == io then
			sl.PressInput = nil
		end
	end)
	btn.Activated:Connect(function(io: InputObject?)
		if sl.LongFired then
			sl.LongFired = false -- this release ended the long-press that just holstered
			return
		end
		local viaTouch = sl.LastTouch
		if io ~= nil then
			local ut = io.UserInputType
			if ut == Enum.UserInputType.Touch then
				viaTouch = true
			elseif ut == Enum.UserInputType.MouseButton1 then
				viaTouch = false
			end
		end
		if not combatBlocked() then
			selectSlot(i, if viaTouch then TOUCH_TAP_HOLSTERS and HB.TapSelectedHolsters else HB.TapSelectedHolsters)
		end
	end)
	HudLayout.AssertTouchTarget(btn, "Hotbar slot " .. i)
	cell.Parent = parent
	return sl
end

refreshHotbar = function()
	local bar = hotbar
	if not bar then
		return
	end
	local ids = hotbarIds()
	local key = table.concat(ids, ",")
	if key ~= hotbarKey then
		hotbarKey = key
		slotIds = ids
		for _, sl in ipairs(slots) do
			sl.Cell:Destroy()
		end
		table.clear(slots)
		for i, id in ipairs(ids) do
			local sl = makeSlot(bar, i)
			sl.Name.Text = shortName(id)
			slots[i] = sl
		end
		local s = slotSize()
		local n = #ids
		local w = if n > 0 then n * s + (n - 1) * HB.Gap else 0
		bar.Size = UDim2.fromOffset(w, s)
		local hp = healthPanel
		if hp then
			hp.Size = UDim2.fromOffset(math.max(w, HP.MinWidth), HP.Height)
		end
		HudLayout.RefreshVisibility(bar)
	end
	local sel = if drawn then activeWeaponId() else nil
	for i, sl in ipairs(slots) do
		styleSlot(sl, sel ~= nil and slotIds[i] == sel)
	end
end

---------------------------------------------------------------------------------------------------------------
-- ammo readout
---------------------------------------------------------------------------------------------------------------

local function reloadSeconds(): number
	local id = currentWeaponId
	local def = if id then WeaponConfig.Weapons[id] else nil
	local base = if def then def.ReloadTime else 2
	return math.max(0.1, base / math.max(1, reloadMult))
end

local function stopReloadTween()
	local tw = reloadTween
	if tw then
		reloadTween = nil
		tw:Cancel()
	end
end

-- reloading: the gold bar fills over the (research-scaled) reload time; the server's push ends it
local function startReloadBar()
	local fill = ammoBarFill
	if not fill then
		return
	end
	stopReloadTween()
	fill.BackgroundColor3 = AM.ReloadColor
	fill.Size = UDim2.fromScale(0, 1)
	local tw = TweenService:Create(fill, TweenInfo.new(reloadSeconds(), Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) })
	reloadTween = tw
	tw:Play()
end

refreshAmmo = function()
	local name, count, mag, fill = ammoName, ammoCount, ammoMag, ammoBarFill
	if not (name and count and mag and fill) then
		return
	end
	local id = currentWeaponId
	local def = if id then WeaponConfig.Weapons[id] else nil
	local wname = if def then string.upper(def.DisplayName) elseif id then string.upper(id) else ""
	local n = math.max(0, math.floor(ammo))
	local m = math.max(0, math.floor(magazineSize))
	count.Text = tostring(n)
	mag.Text = "/" .. tostring(m)
	local frac = if m > 0 then math.clamp(n / m, 0, 1) else 0
	local low = m > 1 and n <= math.max(1, math.floor(m * AM.LowFraction))
	if reloading then
		name.Text = "RELOADING"
		count.TextColor3 = AM.CountColor
		fill.BackgroundColor3 = AM.ReloadColor
		if not reloadTween then
			fill.Size = UDim2.fromScale(1, 1)
		end
		return
	end
	stopReloadTween()
	if n <= 0 then
		name.Text = if isTouch then "TAP ↻" else "RELOAD [R]"
		count.TextColor3 = AM.EmptyColor
		fill.BackgroundColor3 = AM.EmptyColor
	elseif low then
		name.Text = wname
		count.TextColor3 = AM.LowColor
		fill.BackgroundColor3 = AM.LowColor
	else
		name.Text = wname
		count.TextColor3 = AM.CountColor
		fill.BackgroundColor3 = WHITE
	end
	fill.Size = UDim2.fromScale(frac, 1)
end

---------------------------------------------------------------------------------------------------------------
-- server state
---------------------------------------------------------------------------------------------------------------

local function applyState(raw: any)
	if typeof(raw) ~= "table" then
		return
	end
	local payload: Types.CombatStatePayload = raw
	local wasReloading = reloading
	local prevWeapon = currentWeaponId
	local prevHealth = health
	alive = payload.Alive ~= false
	ammo = tonumber(payload.Ammo) or 0
	magazineSize = tonumber(payload.MagazineSize) or 0
	reloading = payload.Reloading == true and alive
	local wid = payload.WeaponId
	currentWeaponId = if typeof(wid) == "string" then wid else nil
	if lastEquipRequestId ~= nil and lastEquipRequestId == currentWeaponId then
		lastEquipRequestId = nil
	end
	HudLayout.SetFlag("Reloading", reloading)
	local h = tonumber(payload.Health)
	local mx = tonumber(payload.MaxHealth)
	if h and mx then
		applyHealth(h, mx)
		if alive and healthKnown and h < prevHealth - 0.5 then
			onDamaged()
		end
		healthKnown = alive
	end
	if not alive then
		stopFiring()
	end
	if reloading and (not wasReloading or prevWeapon ~= currentWeaponId) then
		startReloadBar()
	end
	publishDrawn()
	refreshHotbar()
	refreshAmmo()
	local ap = ammoPanel
	if ap then
		HudLayout.RefreshVisibility(ap)
	end
	updateWheelBinding()
end

local function onHitFeedback(raw: any)
	if typeof(raw) ~= "table" then
		return
	end
	local kind = raw.Kind
	if kind == "Hit" or kind == "Kill" then
		markCombat()
		showHitMarker(kind)
	elseif kind == "Damaged" then
		onDamaged()
	elseif kind == "Death" then
		stopFiring()
		flashEdge()
	end
end

---------------------------------------------------------------------------------------------------------------
-- requests (never damage amounts)
---------------------------------------------------------------------------------------------------------------

local function aimRay(): (Vector3, Vector3)
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local fallbackOrigin = if root then root.Position + Vector3.new(0, 1.5, 0) else Vector3.new(0, 5, 0)

	local cam = Workspace.CurrentCamera
	if cam then
		-- the viewport centre = WE_Reticle's centre (that gui ignores the topbar + safe-area insets)
		local vp = cam.ViewportSize
		local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		return ray.Origin, ray.Direction.Unit
	end
	return fallbackOrigin, Vector3.new(0, 0, -1)
end

local function canFireNow(): boolean
	if combatBlocked() then
		return false
	end
	if KEYS.FireNeedsDrawn and not drawn then
		return false -- holstered: the click belongs to the world (droppers, consoles, ClickDetectors)
	end
	return true
end

requestFire = function()
	if not canFireNow() or reloading then
		return
	end
	if ammo <= 0 then
		-- empty trigger pull → one reload request (the readout already says RELOAD)
		local t = clock()
		if t - lastAutoReloadAt >= AUTO_RELOAD_MIN_GAP then
			lastAutoReloadAt = t
			requestReload()
		end
		return
	end

	local origin, direction = aimRay()
	local payload: Types.FireRequestPayload = {
		Direction = direction,
		Origin = origin,
		TargetUserId = nil,
		TargetNpcId = nil,
		HitPosition = nil,
	}

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = player.Character
	if character then
		params.FilterDescendantsInstances = { character }
	end
	local result = Workspace:Raycast(origin, direction * 500, params)
	if result then
		payload.HitPosition = result.Position
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local other = Players:GetPlayerFromCharacter(model)
			if other then
				payload.TargetUserId = other.UserId
			else
				local npcId = model:GetAttribute("NPCId")
				if typeof(npcId) == "string" then
					payload.TargetNpcId = npcId
				end
			end
		end
	end

	-- non-blocking lookup: a missing remote drops the shot instead of stalling the 20 Hz loop
	local remote = Remotes.TryGetEvent(Constants.RemoteNames.RequestFire)
	if remote then
		remote:FireServer(payload)
		markCombat()
	end
end

requestReload = function()
	if combatBlocked() then
		return
	end
	task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestReload)
end

---------------------------------------------------------------------------------------------------------------
-- holstered FIRE (touch): dimmed FIRE while a visible hostile is within the weapon's range (≤ 4 Hz scan)
---------------------------------------------------------------------------------------------------------------

-- FIRE's look: full red while drawn, dimmed while holstered-and-armed (colour, not transparency, so the
-- crosshair icon's "Fill" parts keep matching the button behind them)
local function styleFire(dim: boolean)
	local f = fireBtn
	if not f or fireDimmed == dim then
		return
	end
	fireDimmed = dim
	local bg = if dim then FIRE_DIM_BG else TC.FireColor
	f.BackgroundColor3 = bg
	f.BackgroundTransparency = if dim then FIRE_DIM_TRANSPARENCY else FIRE_BG_TRANSPARENCY
	local icon = fireIcon
	if icon then
		HudIcons.SetColor(icon, if dim then FIRE_DIM_INK else WHITE, bg)
	end
	f:SetAttribute("WE_FireDimmed", dim)
end

refreshFire = function()
	local f = fireBtn
	if not f then
		return
	end
	styleFire(fireArmed and not HudLayout.GetFlag("Drawn"))
	HudLayout.RefreshVisibility(f)
end

local function setFireArmed(on: boolean)
	if fireArmed == on then
		return
	end
	fireArmed = on
	refreshFire()
end

-- the cheap preconditions: touch FIRE exists, holstered, alive, a weapon equipped, nothing blocking combat
local function armedWanted(): boolean
	return ARMED_FIRE_ENABLED
		and fireBtn ~= nil
		and not drawn
		and alive
		and currentWeaponId ~= nil
		and not HudLayout.GetFlag("Dead")
		and not combatBlocked()
end

local function weaponRange(): number
	local id = activeWeaponId() or currentWeaponId
	local def = if id then WeaponConfig.Weapons[id] else nil
	return if def then math.max(0, tonumber(def.Range) or 0) else 0
end

local function aliveHumanoid(model: Model): boolean
	local h = model:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

local function aimPart(model: Model): BasePart?
	local r = model:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return model.PrimaryPart
end

-- a combat NPC the player may shoot: tagged WE_NPC with an NPCId (CombatService / MapSetup combat NPCs), not a
-- squad unit (same filter as SquadOrdersService.nearestHostile); decorative base soldiers carry no NPCId
local function hostileNpc(model: Model): boolean
	if typeof(model:GetAttribute("NPCId")) ~= "string" then
		return false
	end
	if model:GetAttribute("FriendlySquad") or model:GetAttribute("OwnerUserId") then
		return false
	end
	return true
end

-- per-scan inputs for considerTarget (module locals, so a scan builds no closures)
local scanCam: Camera? = nil
local scanFrom = Vector3.zero
local scanRange = 0
local candN = 0
local losFilterFor: Model? = nil -- the character losParams currently excludes

-- an alive target within range and on screen → the candidate list (nearest are ray-checked afterwards)
local function considerTarget(model: Model)
	local cam = scanCam
	if not cam or candN >= ARMED_MAX_CANDIDATES or not aliveHumanoid(model) then
		return
	end
	local part = aimPart(model)
	if not part then
		return -- streamed out / not built yet
	end
	local pos = part.Position
	local d = (pos - scanFrom).Magnitude
	if d > scanRange then
		return
	end
	local sp, onScreen = cam:WorldToViewportPoint(pos)
	if not onScreen or sp.Z <= 0 then
		return
	end
	candN += 1
	candDist[candN] = d
	candModel[candN] = model
	candPos[candN] = pos
end

--[[ One scan: in-range, on-screen hostiles (players + tracked NPCs), then line-of-sight rays from the camera to the
	nearest few. Reads positions only (Players:GetPlayers() is the one allocation). Never runs more than
	ARMED_SCAN_HZ times a second, whoever calls it (the loop or a holster): a call inside the window returns the
	last result. ]]
local function scanHostiles(): boolean
	local t = clock()
	if t - lastScanAt < 1 / ARMED_SCAN_HZ - 1e-3 then
		return lastScanResult
	end
	lastScanAt = t
	scanCount += 1
	lastScanResult = false
	local cam = Workspace.CurrentCamera
	local character = player.Character
	local myRoot = if character then aimPart(character) else nil
	local range = weaponRange()
	if not cam or not character or not myRoot or range <= 0 then
		return false
	end
	scanCam = cam
	scanFrom = myRoot.Position
	scanRange = range
	candN = 0
	if GameConfig.PvPEnabled then
		for _, other in ipairs(Players:GetPlayers()) do
			local ch = other.Character
			if other ~= player and ch and ch.Parent and not ch:FindFirstChildOfClass("ForceField") then
				considerTarget(ch)
			end
		end
	end
	for inst in pairs(npcModels) do
		if inst.Parent == nil then
			npcModels[inst] = nil
		elseif inst:IsA("Model") and hostileNpc(inst) then
			considerTarget(inst)
		end
	end
	scanCam = nil
	local n = candN
	if n == 0 then
		return false
	end
	-- line of sight, nearest first
	local params = losParams
	if losFilterFor ~= character then
		losFilterFor = character
		params.FilterDescendantsInstances = { character }
	end
	local origin = cam.CFrame.Position
	for _ = 1, math.min(n, ARMED_MAX_LOS_RAYS) do
		local best = 0
		for k = 1, n do
			if candDist[k] >= 0 and (best == 0 or candDist[k] < candDist[best]) then
				best = k
			end
		end
		if best == 0 then
			break
		end
		candDist[best] = -1 -- taken
		local dir = candPos[best] - origin
		if dir.Magnitude < 0.05 then
			lastScanResult = true -- the camera sits on the target: nothing can be in between
			break
		end
		local hit = Workspace:Raycast(origin, dir, params)
		if hit == nil or hit.Instance:IsDescendantOf(candModel[best]) then
			lastScanResult = true
			break
		end
	end
	table.clear(candModel) -- drop model references until the next scan
	return lastScanResult
end

armedTick = function()
	if not armedWanted() then
		armedSeenAt = -math.huge
		setFireArmed(false)
		return
	end
	if scanHostiles() then
		armedSeenAt = clock()
		setFireArmed(true)
	elseif clock() - armedSeenAt > ARMED_GRACE_SECONDS then
		setFireArmed(false)
	end
end

local function trackNpc(inst: Instance)
	if inst:IsA("Model") then
		npcModels[inst] = true
	end
end

local function startArmedScan()
	if not ARMED_FIRE_ENABLED or not fireBtn then
		return -- desktop / gamepad: no touch FIRE, nothing to arm
	end
	local tag = Constants.Tags.NPC
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		trackNpc(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(trackNpc)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst: Instance)
		npcModels[inst] = nil
	end)
	task.spawn(function()
		local period = 1 / ARMED_SCAN_HZ
		while true do
			task.wait(period)
			armedTick()
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- mouse wheel (bound only while drawn, so a holstered wheel still zooms the camera)
---------------------------------------------------------------------------------------------------------------

local function onWheel(_name: string, _state: Enum.UserInputState, io: InputObject): Enum.ContextActionResult
	local z = io.Position.Z
	if z == 0 or not drawn or combatBlocked() then
		return Enum.ContextActionResult.Pass
	end
	local t = clock()
	if t - lastWheelAt >= WHEEL_MIN_GAP then
		lastWheelAt = t
		cycleWeapon(if z < 0 then 1 else -1)
	end
	return Enum.ContextActionResult.Sink
end

updateWheelBinding = function()
	local want = KEYS.WeaponWheel == true and UserInputService.MouseEnabled and drawn and not combatBlocked()
	if want == wheelBound then
		return
	end
	wheelBound = want
	if want then
		ContextActionService:BindActionAtPriority(
			ACTION_WHEEL,
			onWheel,
			false,
			Enum.ContextActionPriority.High.Value,
			Enum.UserInputType.MouseWheel
		)
	else
		ContextActionService:UnbindAction(ACTION_WHEEL)
	end
end

---------------------------------------------------------------------------------------------------------------
-- build
---------------------------------------------------------------------------------------------------------------

type TouchGeo = { FireRight: number, FireBottom: number, ReloadRight: number, ReloadBottom: number, AmmoBottom: number }

-- v offsets from the content rect's bottom-right (see the jump-button note at the top)
local function touchGeometry(): TouchGeo
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(844, 390)
	local geo: TouchGeo = {
		FireRight = TC.Fire.Right,
		FireBottom = TC.Fire.Bottom,
		ReloadRight = TC.Reload.Right,
		ReloadBottom = TC.Reload.Bottom,
		AmmoBottom = AM.BottomTouch,
	}
	if math.min(vp.X, vp.Y) <= SMALL_JUMP_MAX_AXIS then
		return geo
	end
	local s = HudLayout.Scale()
	local half = TC.Fire.Size * TC.Fire.Anchor.X
	local reloadGap = TC.Reload.Right - TC.Fire.Right - half -- v between FIRE's left edge and RELOAD
	local ammoGap = AM.BottomTouch - TC.Fire.Bottom - TC.Fire.Size -- v between FIRE's top and the readout
	geo.FireRight = LARGE_JUMP_CENTRE_FROM_RIGHT / s
	geo.FireBottom = (LARGE_JUMP_TOP_FROM_BOTTOM + FIRE_ABOVE_JUMP) / s
	geo.ReloadRight = geo.FireRight + half + reloadGap
	geo.ReloadBottom = geo.FireBottom + (TC.Reload.Bottom - TC.Fire.Bottom)
	geo.AmmoBottom = geo.FireBottom + TC.Fire.Size + ammoGap
	return geo
end

local function placeCombatControls()
	local ap = ammoPanel
	if not isTouch then
		if ap then
			ap.Position = UDim2.new(1, -AM.Right, 1, -AM.Bottom)
		end
		return
	end
	local g = touchGeometry()
	if ap then
		ap.Position = UDim2.new(1, -AM.RightTouch, 1, -g.AmmoBottom)
	end
	local f = fireBtn
	if f then
		f.Position = UDim2.new(1, -g.FireRight, 1, -g.FireBottom)
	end
	local r = reloadBtn
	if r then
		r.Position = UDim2.new(1, -g.ReloadRight, 1, -g.ReloadBottom)
	end
end

local function textLabel(parent: Instance, name: string, font: Enum.Font, size: number, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Font = font
	l.TextSize = size
	l.TextColor3 = color
	l.Text = ""
	l.Active = false
	l.Parent = parent
	return l
end

local function buildAmmo(parent: Instance)
	local size = if isTouch then AM.SizeTouch else AM.Size
	local countSize = if isTouch then AM.CountSizeTouch else AM.CountSize
	local magSize = if isTouch then AM.MagSizeTouch else AM.MagSize
	local barW = if isTouch then math.floor(AM.SizeTouch.X * 0.75) else AM.BarSize.X
	local barH = AM.BarSize.Y

	local ap = Instance.new("Frame")
	ap.Name = "AmmoPanel"
	ap.AnchorPoint = AM.Anchor
	ap.Size = UDim2.fromOffset(size.X, size.Y)
	ap.BackgroundTransparency = 1
	ap.BorderSizePixel = 0
	ap.Active = false
	ap.Parent = parent
	ammoPanel = ap

	local name = textLabel(ap, "WeaponName", FONT_BODY, AM.NameSize, WHITE)
	name.AnchorPoint = Vector2.new(1, 0)
	name.Position = UDim2.fromScale(1, 0)
	name.Size = UDim2.new(1, 0, 0, AM.NameSize + 2)
	name.TextXAlignment = Enum.TextXAlignment.Right
	name.TextTransparency = 0.1
	UIUtil.TextOutline(name, 1)
	ammoName = name

	local row = Instance.new("Frame")
	row.Name = "CountRow"
	row.AnchorPoint = Vector2.new(1, 1)
	row.Position = UDim2.new(1, 0, 1, -(barH + (if isTouch then 4 else 6)))
	row.Size = UDim2.new(1, 0, 0, countSize)
	row.BackgroundTransparency = 1
	row.Active = false
	row.Parent = ap
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Right
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 2)
	list.Parent = row

	local count = textLabel(row, "Count", FONT_DISPLAY, countSize, AM.CountColor)
	count.AutomaticSize = Enum.AutomaticSize.X
	count.Size = UDim2.fromOffset(0, countSize)
	count.TextYAlignment = Enum.TextYAlignment.Bottom
	count.LayoutOrder = 1
	UIUtil.TextOutline(count, if isTouch then 1.6 else 2)
	ammoCount = count

	local mag = textLabel(row, "Magazine", FONT_DISPLAY, magSize, AM.MagColor)
	mag.AutomaticSize = Enum.AutomaticSize.X
	mag.Size = UDim2.fromOffset(0, magSize)
	mag.TextYAlignment = Enum.TextYAlignment.Bottom
	mag.LayoutOrder = 2
	UIUtil.TextOutline(mag, 1.3)
	ammoMag = mag

	local bar = Instance.new("Frame")
	bar.Name = "MagBar"
	bar.AnchorPoint = Vector2.new(1, 1)
	bar.Position = UDim2.fromScale(1, 1)
	bar.Size = UDim2.fromOffset(barW, barH)
	bar.BackgroundColor3 = WHITE
	bar.BackgroundTransparency = 0.78
	bar.BorderSizePixel = 0
	bar.ClipsDescendants = true
	bar.Active = false
	bar.Parent = ap
	round(bar)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.AnchorPoint = Vector2.new(1, 0)
	fill.Position = UDim2.fromScale(1, 0)
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = WHITE
	fill.BorderSizePixel = 0
	fill.Active = false
	fill.Parent = bar
	round(fill)
	ammoBarFill = fill
end

local function buildTouchButtons(parent: Instance)
	local fire = Instance.new("TextButton")
	fire.Name = "FireButton"
	fire.AnchorPoint = TC.Fire.Anchor
	fire.Size = UDim2.fromOffset(TC.Fire.Size, TC.Fire.Size)
	fire.BackgroundColor3 = TC.FireColor
	fire.BackgroundTransparency = FIRE_BG_TRANSPARENCY
	fire.BorderSizePixel = 0
	fire.Text = ""
	fire.AutoButtonColor = true
	fire.Active = true
	fire.ZIndex = 2
	fire.Parent = parent
	round(fire)
	stroke(fire, Color3.fromRGB(0, 0, 0), 3, 0.55)
	fireIcon = HudIcons.Make("Crosshair", fire, {
		Name = "Icon",
		Size = UDim2.fromScale(0.6, 0.6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
		Color = WHITE,
		Fill = TC.FireColor,
	})
	-- hold-to-fire: one entry per finger; released on the button's InputEnded or anywhere (TouchEnded).
	-- Holstered, FIRE only shows (dimmed) while a hostile is in sight: that press draws, then fires.
	fire.InputBegan:Connect(function(io: InputObject)
		local ut = io.UserInputType
		if ut == Enum.UserInputType.Touch or ut == Enum.UserInputType.MouseButton1 then
			if not drawn then
				if not fireArmed or combatBlocked() then
					return
				end
				setDrawn(true)
			end
			if canFireNow() then
				fireTouches[io] = true
				requestFire()
			end
		end
	end)
	fire.InputEnded:Connect(function(io: InputObject)
		fireTouches[io] = nil
	end)
	fireBtn = fire
	HudLayout.AssertTouchTarget(fire, "FIRE")

	local rel = Instance.new("TextButton")
	rel.Name = "ReloadButton"
	rel.AnchorPoint = TC.Reload.Anchor
	rel.Size = UDim2.fromOffset(TC.Reload.Size, TC.Reload.Size)
	rel.BackgroundColor3 = TC.ReloadColor
	rel.BackgroundTransparency = 0.12
	rel.BorderSizePixel = 0
	rel.Text = ""
	rel.AutoButtonColor = true
	rel.Active = true
	rel.ZIndex = 2
	rel.Parent = parent
	round(rel)
	stroke(rel, Color3.fromRGB(0, 0, 0), 2.5, 0.55)
	HudIcons.Make("Cycle", rel, {
		Name = "Icon",
		Size = UDim2.fromScale(0.56, 0.56),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
		Color = WHITE,
		Fill = TC.ReloadColor,
	})
	rel.Activated:Connect(function()
		requestReload()
	end)
	reloadBtn = rel
	HudLayout.AssertTouchTarget(rel, "RELOAD")
end

local function buildReticleGui(pg: Instance)
	local rg = Instance.new("ScreenGui")
	rg.Name = "WE_Reticle"
	HudLayout.ApplyScreen(rg, { Insets = "None" }) -- full screen: (0.5, 0.5) is the viewport centre = aimRay

	-- screen-edge damage flash / low-HP edge, drawn under every other HUD gui (DisplayOrder 24)
	local edge = Instance.new("Frame")
	edge.Name = "DamageEdge"
	edge.BackgroundTransparency = 1
	edge.Size = UDim2.fromScale(1, 1)
	edge.Visible = false
	edge.Active = false
	edge.Parent = rg
	damageEdge = edge
	type EdgeSpec = { Name: string, Size: UDim2, Pos: UDim2, Rot: number }
	local specs: { EdgeSpec } = {
		{ Name = "Top", Size = UDim2.new(1, 0, 0, EDGE_V), Pos = UDim2.fromScale(0, 0), Rot = 90 },
		{ Name = "Bottom", Size = UDim2.new(1, 0, 0, EDGE_V), Pos = UDim2.new(0, 0, 1, -EDGE_V), Rot = 270 },
		{ Name = "Left", Size = UDim2.new(0, EDGE_V, 1, 0), Pos = UDim2.fromScale(0, 0), Rot = 0 },
		{ Name = "Right", Size = UDim2.new(0, EDGE_V, 1, 0), Pos = UDim2.new(1, -EDGE_V, 0, 0), Rot = 180 },
	}
	for _, spec in ipairs(specs) do
		local s = Instance.new("Frame")
		s.Name = spec.Name
		s.Size = spec.Size
		s.Position = spec.Pos
		s.BackgroundColor3 = HP.Low
		s.BackgroundTransparency = 1
		s.BorderSizePixel = 0
		s.Active = false
		s.Parent = edge
		local g = Instance.new("UIGradient") -- solid at the screen edge, clear towards the middle
		g.Rotation = spec.Rot
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = s
		table.insert(edgeStrips, s)
	end

	local ret = Instance.new("Frame")
	ret.Name = "Reticle"
	ret.AnchorPoint = Vector2.new(0.5, 0.5)
	ret.Position = UDim2.fromScale(0.5, 0.5)
	ret.Size = UDim2.fromOffset(RT.Size, RT.Size)
	ret.BackgroundTransparency = 1
	ret.Active = false
	ret.ZIndex = 5
	ret.Parent = rg
	reticle = ret
	local off = RT.Gap + RT.Arm / 2
	for _, a in ipairs({
		{ 0, -off, RT.Thickness, RT.Arm },
		{ 0, off, RT.Thickness, RT.Arm },
		{ -off, 0, RT.Arm, RT.Thickness },
		{ off, 0, RT.Arm, RT.Thickness },
	}) do
		local arm = Instance.new("Frame")
		arm.Name = "Arm"
		arm.AnchorPoint = Vector2.new(0.5, 0.5)
		arm.Position = UDim2.new(0.5, a[1], 0.5, a[2])
		arm.Size = UDim2.fromOffset(a[3], a[4])
		arm.BackgroundColor3 = RT.Color
		arm.BackgroundTransparency = 0.05
		arm.BorderSizePixel = 0
		arm.Active = false
		arm.ZIndex = 6
		arm.Parent = ret
		stroke(arm, Color3.fromRGB(0, 0, 0), 1, 0.55)
	end
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(4, 4)
	dot.BackgroundColor3 = RT.DotColor
	dot.BorderSizePixel = 0
	dot.Active = false
	dot.ZIndex = 7
	dot.Parent = ret
	round(dot)

	-- hit marker (X) on the same centre, HitFeedback.HitMarkerSeconds per hit you land
	local marker = Instance.new("Frame")
	marker.Name = "HitMarker"
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Position = UDim2.fromScale(0.5, 0.5)
	marker.Size = UDim2.fromOffset(28, 28)
	marker.BackgroundTransparency = 1
	marker.Visible = false
	marker.Active = false
	marker.ZIndex = 8
	marker.Parent = rg
	hitMarker = marker
	for _, rot in ipairs({ 45, -45 }) do
		local bar = Instance.new("Frame")
		bar.Name = "Bar"
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.fromOffset(22, 3)
		bar.BackgroundColor3 = Color3.fromRGB(255, 230, 80)
		bar.BorderSizePixel = 0
		bar.Rotation = rot
		bar.Active = false
		bar.ZIndex = 9
		bar.Parent = marker
	end

	rg.Parent = pg
end

local function buildHud(pg: Instance)
	isTouch = HudLayout.IsTouch()

	local sg = Instance.new("ScreenGui")
	sg.Name = "WarEmpireCombatHUD"
	HudLayout.ApplyScreen(sg) -- DisplayOrder 25 (HudConfig.DisplayOrder), CoreUISafeInsets, MobileScale

	local bar = Instance.new("Frame")
	bar.Name = "Hotbar"
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -HB.Bottom)
	bar.Size = UDim2.fromOffset(0, slotSize())
	bar.BackgroundTransparency = 1
	bar.BorderSizePixel = 0
	bar.Active = false
	bar.Parent = sg
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, HB.Gap)
	list.Parent = bar
	hotbar = bar

	local hp = Instance.new("Frame")
	hp.Name = "HealthPanel"
	hp.AnchorPoint = Vector2.new(0.5, 1)
	hp.Position = UDim2.new(0.5, 0, 1, -healthBottomV())
	hp.Size = UDim2.fromOffset(HP.MinWidth, HP.Height)
	hp.BackgroundColor3 = HP.Bg
	hp.BackgroundTransparency = HP.BgTransparency
	hp.BorderSizePixel = 0
	hp.ClipsDescendants = true
	hp.Active = false
	hp.Parent = sg
	round(hp)
	stroke(hp, COLORS.Ink, 1, 0.2)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = HP.Fill
	fill.BorderSizePixel = 0
	fill.Active = false
	fill.Parent = hp
	round(fill)
	healthPanel = hp
	healthFill = fill

	buildAmmo(sg)
	if isTouch then
		buildTouchButtons(sg)
	end
	placeCombatControls()

	sg.Parent = pg
	buildReticleGui(pg)

	HudLayout.SetRect("Hotbar", bar)
	HudLayout.SetRect("Health", hp)
	HudLayout.SetRect("Ammo", ammoPanel :: Frame)

	-- visibility: the HudConfig rules + "not seated" (VehicleDriveClient's ▲▼ own the reserve while seated)
	local function notSeated(): boolean
		return not seatedNow()
	end
	HudLayout.BindVisibility(bar, HB, function(): boolean
		return #slotIds > 0 and not seatedNow()
	end)
	HudLayout.BindVisibility(hp, HP, notSeated)
	HudLayout.BindVisibility(ammoPanel :: Frame, AM, function(): boolean
		return currentWeaponId ~= nil and not seatedNow()
	end)
	bound = { bar, hp, ammoPanel :: Frame }
	local f, r = fireBtn, reloadBtn
	if f and r then
		-- FIRE: TC's HideWhen, shown while Drawn OR (holstered and armed — dimmed); refreshFire re-evaluates it
		-- when Drawn / the armed state changes
		HudLayout.BindVisibility(f, { HideWhen = TC.HideWhen }, function(): boolean
			return not seatedNow() and (HudLayout.GetFlag("Drawn") or fireArmed)
		end)
		HudLayout.BindVisibility(r, TC, notSeated)
		table.insert(bound, f)
		table.insert(bound, r)
	end
	local ret = reticle
	if ret then
		HudLayout.BindVisibility(ret, RT, notSeated)
		table.insert(bound, ret)
	end
end

---------------------------------------------------------------------------------------------------------------
-- character / seat / flags
---------------------------------------------------------------------------------------------------------------

local function onSeatContext()
	if seatedNow() then
		stopFiring()
	end
	refreshBound()
	updateWheelBinding()
end

local function bindHumanoid(hum: Humanoid)
	for _, c in ipairs(humConns) do
		c:Disconnect()
	end
	table.clear(humConns)
	humanoid = hum
	lastHumHealth = tonumber(hum.Health)
	table.insert(
		humConns,
		hum.HealthChanged:Connect(function(h: number)
			local prev = lastHumHealth
			lastHumHealth = h
			local mx = tonumber(hum.MaxHealth) or maxHealth
			applyHealth(h, mx)
			if prev ~= nil and h > 0 and h < prev - 0.5 then
				onDamaged()
			end
		end)
	)
	table.insert(humConns, hum:GetPropertyChangedSignal("SeatPart"):Connect(onSeatContext))
	onSeatContext()
end

local function onCharacter(char: Model)
	-- every life starts holstered (HudConfig.Hotbar.DrawnOnSpawn)
	drawn = HB.DrawnOnSpawn == true
	stopFiring()
	fullSince = nil
	healthKnown = false
	setDrawn(drawn)
	local h = char:FindFirstChildOfClass("Humanoid")
	if h then
		bindHumanoid(h)
		return
	end
	task.spawn(function()
		local found = char:WaitForChild("Humanoid", 10)
		if found and found:IsA("Humanoid") and player.Character == char then
			bindHumanoid(found)
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------------------------------------------

function CombatController.IsDrawn(): boolean
	return drawn
end

function CombatController.Holster()
	setDrawn(false)
end

function CombatController.Draw()
	setDrawn(true)
end

-- touch: FIRE is showing DIMMED (holstered, a visible hostile within the weapon's range)
function CombatController.IsFireArmed(): boolean
	return fireArmed and not drawn
end

-- how many holstered-FIRE scans have run (tests check the ≤ 4 Hz cap)
function CombatController.ArmedScanCount(): number
	return scanCount
end

function CombatController.Init()
	if initialized then
		return
	end
	-- PlayerGui exists before LocalScripts run; the bounded wait only covers a very slow client
	local pg = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if not pg then
		warn("[CombatController] no PlayerGui after 10 s — combat HUD not built")
		return
	end
	initialized = true
	HudLayout.Init()
	buildHud(pg)
	publishDrawn()
	refreshHotbar()
	refreshAmmo()

	-- level for the hotbar's UnlockLevel filter (server attribute + XPUpdate, whichever is newer)
	local function readLevelAttribute()
		local v = player:GetAttribute("WE_Level")
		if typeof(v) == "number" then
			knownLevel = v
			refreshHotbar()
		end
	end
	readLevelAttribute()
	player:GetAttributeChangedSignal("WE_Level"):Connect(readLevelAttribute)
	player:GetAttributeChangedSignal("WE_Weapons"):Connect(refreshHotbar)
	player:GetAttributeChangedSignal("WE_DriveMode"):Connect(onSeatContext)
	Remotes.BindEvent(Constants.RemoteNames.XPUpdate, function(payload: any)
		if typeof(payload) == "table" and typeof(payload.Level) == "number" then
			knownLevel = payload.Level
			refreshHotbar()
		end
	end)
	-- research WeaponReload → reload bar duration (display only; magazine size arrives in CombatStateUpdate)
	Remotes.BindEvent(Constants.RemoteNames.ResearchStateUpdate, function(payload: any)
		if typeof(payload) == "table" then
			local m = ResearchConfig.MultFor(payload.Levels, "WeaponReload")
			if typeof(m) == "number" and m == m and m >= 1 then
				reloadMult = m
			end
		end
	end)
	Remotes.BindEvent(Constants.RemoteNames.CombatStateUpdate, applyState)
	Remotes.BindEvent(Constants.RemoteNames.CombatHitFeedback, onHitFeedback)

	HudLayout.FlagChanged:Connect(function(name: string, on: boolean)
		if name == "Driving" or name == "Modal" or name == "Dead" then
			if on then
				stopFiring()
			end
			if name == "Dead" then
				publishDrawn()
			end
			if name == "Driving" then
				refreshBound()
			end
			updateWheelBinding()
		end
	end)
	HudLayout.LayoutChanged:Connect(placeCombatControls)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		local ut = input.UserInputType
		local kc = input.KeyCode
		if ut == Enum.UserInputType.MouseButton1 or kc == GP.Fire then
			if canFireNow() then
				firing = true
				requestFire()
			end
			return
		end
		if ut ~= Enum.UserInputType.Keyboard and not GAMEPAD_TYPES[ut] then
			return
		end
		if combatBlocked() then
			return -- seated: Q / R / 1-4 belong to the vehicle; panels / death / menu: nothing
		end
		local slot = table.find(KEYS.Weapons, kc)
		if slot then
			if HudLayout.GetFlag("OrdersOpen") then
				return -- Army popover open: 1-4 are squad orders (OrdersController)
			end
			selectSlot(slot, HB.TapSelectedHolsters)
		elseif kc == KEYS.Reload or kc == GP.Reload then
			if not drawn then
				setDrawn(true)
			end
			requestReload()
		elseif kc == KEYS.WeaponPrev or kc == GP.Prev then
			cycleWeapon(-1)
		elseif kc == GP.Next then
			cycleWeapon(1)
		elseif kc == GP.DrawHolster then
			setDrawn(not drawn)
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == GP.Fire then
			firing = false
		end
		fireTouches[input] = nil
	end)
	UserInputService.TouchEnded:Connect(function(input: InputObject)
		fireTouches[input] = nil
		-- a finger that slid off a hotbar slot before lifting ends that slot's long-press too
		for _, sl in ipairs(slots) do
			if sl.PressInput == input then
				sl.PressInput = nil
			end
		end
	end)

	-- hold-to-fire loop (HudConfig.TouchCombat.HoldToFireHz); the server clamps every shot to the FireRate
	task.spawn(function()
		local period = 1 / math.max(1, TC.HoldToFireHz)
		while true do
			task.wait(period)
			if firing or next(fireTouches) ~= nil then
				if canFireNow() then
					requestFire()
				else
					stopFiring()
				end
			end
		end
	end)

	-- touch: dimmed FIRE while holstered with a visible hostile in range (≤ 4 Hz; nothing on desktop)
	startArmedScan()
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">CompassController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CompassController — v70 compass chip in the TopStrip (spec §3.1; HudConfig.TopStrip.Compass).
	A gold Frame-built arrow that points at your base relative to the camera, "BASE" and the distance ("95m",
	"1.2km"), right-aligned in the Roblox topbar row. Shown only OUTSIDE your own plot — this controller publishes
	the HudLayout flag "InOwnPlot" (plot square + OwnPlotMarginStuds) — and hidden while a panel is open.
	Tap → HudLayout.Signals.CompassTapped (TerritoryController opens the territory list under the chip).
	RadarReveal (flag "Radar", TerritoryController) → a pulsing purple dot at the chip's left edge.
	Gone: the 210x52 two-line card under the weapon panel and its "◎ nearest territory" line.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local BaseConfig = require(Shared.Configs.BaseConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)
local HUDController = require(script.Parent.HUDController)

local CompassController = {}

local TS = HudConfig.TopStrip
local C = TS.Compass

local player = Players.LocalPlayer
local myPlotId: number? = nil
local chip: TextButton? = nil
local arrow: Frame? = nil
local distLabel: TextLabel? = nil
local baseKnown = false
local accum = 0

local function formatDist(studs: number): string
	if studs < 1000 then
		return string.format("%dm", math.floor(studs))
	end
	return string.format("%.1fkm", studs / 1000)
end

local function getRoot(): (Vector3?, Vector3?)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil, nil
	end
	local cam = Workspace.CurrentCamera
	local look = if cam then cam.CFrame.LookVector else hrp.CFrame.LookVector
	return hrp.Position, look
end

local function baseWorldPos(): Vector3?
	if typeof(myPlotId) ~= "number" then
		return nil
	end
	return BaseConfig.PlotPositions[myPlotId]
end

-- inside your own plot square (BaseConfig.PlotSize centred on the plot position) + the configured margin
local function insideOwnPlot(pos: Vector3, center: Vector3): boolean
	local size = BaseConfig.PlotSize
	local m = C.OwnPlotMarginStuds
	return math.abs(pos.X - center.X) <= size.X / 2 + m and math.abs(pos.Z - center.Z) <= size.Z / 2 + m
end

-- bearing of `to` relative to the camera look, degrees clockwise (0 = straight ahead = arrow up)
local function relativeBearing(from: Vector3, to: Vector3, look: Vector3): number
	local dx, dz = to.X - from.X, to.Z - from.Z
	if dx * dx + dz * dz < 1e-4 then
		return 0
	end
	local lx, lz = look.X, look.Z
	if lx * lx + lz * lz < 0.0025 then
		lx, lz = 0, -1
	end
	local worldAngle = math.deg(math.atan2(dx, -dz))
	local lookAngle = math.deg(math.atan2(lx, -lz))
	return (worldAngle - lookAngle) % 360
end

local function setKnown(known: boolean)
	if known == baseKnown then
		return
	end
	baseKnown = known
	if chip then
		HudLayout.RefreshVisibility(chip)
	end
end

local function tickCompass()
	local pos, look = getRoot()
	local center = baseWorldPos()
	if not center then
		setKnown(false)
		return
	end
	if not pos or not look then
		return -- respawning: keep the last state
	end
	local inPlot = insideOwnPlot(pos, center)
	HudLayout.SetFlag("InOwnPlot", inPlot)
	setKnown(true)
	if inPlot and C.HideInsideOwnPlot then
		return
	end
	if arrow then
		HudIcons.SetRotation(arrow, relativeBearing(pos, center, look))
	end
	if distLabel then
		distLabel.Text = formatDist(Vector3.new(center.X - pos.X, 0, center.Z - pos.Z).Magnitude)
	end
end

local function buildChip(area: Frame)
	local c = Instance.new("TextButton")
	c.Name = "Compass"
	c.AnchorPoint = Vector2.new(1, 1)
	c.Position = UDim2.new(1, -TS.EdgePad, 1, -TS.BottomPad + TS.YNudge)
	c.Size = UDim2.fromOffset(C.MinWidth, TS.Height)
	c.AutomaticSize = Enum.AutomaticSize.X
	c.BackgroundColor3 = TS.Bg
	c.BackgroundTransparency = TS.BgTransparency
	c.BorderSizePixel = 0
	c.AutoButtonColor = false
	c.Text = ""
	c.Active = true
	c.Selectable = true
	UIUtil.Corner(c, TS.Corner)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 16)
	pad.Parent = c
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Padding = UDim.new(0, 7)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = c

	local box = Instance.new("Frame")
	box.Name = "ArrowBox"
	box.LayoutOrder = 1
	box.Size = UDim2.fromOffset(C.ArrowBox, C.ArrowBox)
	box.BackgroundColor3 = Color3.new(1, 1, 1)
	box.BackgroundTransparency = 0.88
	box.BorderSizePixel = 0
	box.Active = false
	box.Parent = c
	UIUtil.Corner(box, math.ceil(C.ArrowBox / 2))
	arrow = HudIcons.Make("Arrow", box, {
		Name = "Arrow",
		Size = UDim2.fromOffset(C.ArrowSize, C.ArrowSize),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = C.ArrowColor,
		ZIndex = 2,
	})

	-- RadarReveal: 8 px pulsing purple dot at the chip's left edge (TerritoryController sets the "Radar" flag)
	local dot = Instance.new("Frame")
	dot.Name = "RadarDot"
	dot.AnchorPoint = Vector2.new(1, 0.5)
	dot.Position = UDim2.new(0, -1, 0.5, 0)
	dot.Size = UDim2.fromOffset(8, 8)
	dot.BackgroundColor3 = C.RadarDot
	dot.BorderSizePixel = 0
	dot.Active = false
	dot.ZIndex = 3
	dot.Parent = box
	UIUtil.Corner(dot, 4)
	HudLayout.BindVisibility(dot, { ShowWhen = { "Radar" } })
	local pulse: Tween? = nil
	local function syncPulse()
		local on = HudLayout.GetFlag("Radar")
		if on and not pulse then
			dot.BackgroundTransparency = 0
			pulse = TweenService:Create(dot, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.7 })
			if pulse then
				pulse:Play()
			end
		elseif not on and pulse then
			pulse:Cancel()
			pulse = nil
			dot.BackgroundTransparency = 0
		end
	end
	HudLayout.FlagChanged:Connect(function(name: string)
		if name == "Radar" then
			syncPulse()
		end
	end)
	syncPulse()

	local base = Instance.new("TextLabel")
	base.Name = "BaseLabel"
	base.LayoutOrder = 2
	base.BackgroundTransparency = 1
	base.Size = UDim2.new(0, 0, 1, 0)
	base.AutomaticSize = Enum.AutomaticSize.X
	base.Font = HudConfig.Fonts.Body
	base.TextSize = C.LabelSize
	base.TextColor3 = HudConfig.Colors.White
	base.TextTransparency = 0.15
	base.Text = "BASE"
	base.Active = false
	base.Parent = c

	local dist = Instance.new("TextLabel")
	dist.Name = "Distance"
	dist.LayoutOrder = 3
	dist.BackgroundTransparency = 1
	dist.Size = UDim2.new(0, 0, 1, 0)
	dist.AutomaticSize = Enum.AutomaticSize.X
	dist.Font = HudConfig.Fonts.Display
	dist.TextSize = C.DistanceSize
	dist.TextColor3 = HudConfig.Colors.White
	dist.Text = "…"
	dist.Active = false
	dist.Parent = c
	UIUtil.TextOutline(dist, TS.TextStroke)
	distLabel = dist

	c.Activated:Connect(function()
		if C.TapOpensTerritories then
			HudLayout.Emit("CompassTapped")
		end
	end)
	c.Parent = area
	chip = c
	local hideWhen = if C.HideInsideOwnPlot then { "InOwnPlot", "Modal" } else { "Modal" }
	HudLayout.BindVisibility(c, { HideWhen = hideWhen }, function(): boolean
		return baseKnown
	end)
	HudLayout.SetRect("Compass", c)
end

function CompassController.Init()
	local area = HUDController.GetTopStripArea()
	if area then
		buildChip(area)
	else
		warn("[CompassController] no TopStrip area — compass chip skipped")
	end

	-- plot id: BindEvent (never an infinite WaitForChild on a remote)
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(basePayload: Types.BaseStatePayload)
		if typeof(basePayload) == "table" and typeof(basePayload.PlotId) == "number" then
			myPlotId = basePayload.PlotId
		end
	end)
	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: Types.PlayerStatePayload)
		if typeof(state) == "table" and state.Base and typeof(state.Base.PlotId) == "number" then
			myPlotId = state.Base.PlotId
		end
	end)

	RunService.Heartbeat:Connect(function(dt: number)
		accum += dt
		if accum >= C.TickSeconds then
			accum = 0
			tickCompass()
		end
	end)
end

return CompassController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HUDController — the v70 "clean screen" HUD shell (spec §3.1-3.3). Numbers: Shared/Configs/HudConfig.luau;
	scale / insets / flags / badges / cash-float plumbing: Client/Modules/HudLayout.luau; icons: HudIcons.luau.

	WarEmpireHUD (DisplayOrder 55, the shared "MobileScale" UIScale, CoreUISafeInsets)
	  Rail          5 tiles down the left edge (Shop · Rebirth · Army · Garage · Missions) + badges; key hints on
	                hover only while HudLayout.PrefersKeys(); a tile may take a long-press (Army: cycle the order)
	  CurrencyPill  bottom-left: cash icon · number (count-up); "+$141" floats rise from its right end
	WE_TopStrip (DisplayOrder 56, the Roblox topbar row, real px — Roblox's own buttons are 44 px there too)
	  LevelChip (tap / hover → the GoalLabel tooltip) · SettingsGear · CashPlus (bills + green +, cash packs; it
	  left the pill: mobile merge gate #6, the thumbstick zone) · ShieldChip (while WE_ShieldUntil runs)
	  CompassController adds the compass chip at the right end.

	REMOVED from the screen (spec §3.7; where each thing lives now):
	  LevelPanel goal / rebirth text → the level-chip tooltip (GoalLabel) + the Rebirth "!" badge
	  level-up / near-prestige banners → chip pulse / Rebirth tile pulse (the server's reward toast is the text)
	  SeasonLabel → Progression panel header · SpinnerButton → Missions badge + the Missions panel claim row
	  PassiveHint → Base panel subtitle · GoldLabel "◆ 0" → Shop header (gold > 0)
	  PendingLabel "+$N pending" → the in-world ATM screen · the 7-tile MobileActionBar dock → Rail + TopStrip gear
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local UIUtil = require(Shared.Util.UIUtil)
local HudConfig = require(Shared.Configs.HudConfig)
local LevelConfig = require(Shared.Configs.LevelConfig)
local PrestigeConfig = require(Shared.Configs.PrestigeConfig)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)

local HUDController = {}

-- One rail tile binding (UIController): Id = HudConfig.Rail.Tiles[].Id; Name = the pinned child name ("DockMissions").
-- OnLongPress (optional): a finger / mouse held on the tile for LONG_PRESS_SECONDS runs it instead of OnClick
-- (the Army tile cycles the squad order — mobile plan P1-6, the touch twin of T).
export type RailAction = { Id: string, Name: string?, OnClick: () -> (), OnLongPress: (() -> ())? }

local LONG_PRESS_SECONDS = 0.5
local LONG_PRESS_SLOP_PX = 24 -- real px a held finger may move and still count as a long-press (not a drag)

type FloatRec = { Label: TextLabel, Stroke: UIStroke, Amount: number, Last: number, Token: number, Tweens: { Tween } }

local player = Players.LocalPlayer
local Colors = HudConfig.Colors
local Fonts = HudConfig.Fonts
local TS = HudConfig.TopStrip

local _gui: ScreenGui? = nil
local topArea: Frame? = nil

-- TopStrip
local levelLabel: TextLabel? = nil
local xpBarFill: Frame? = nil
local chipStroke: UIStroke? = nil
local chipPop: UIScale? = nil
local goalTip: Frame? = nil
local goalLabel: TextLabel? = nil
local rebirthLabel: TextLabel? = nil
local tipToken = 0
local shieldChip: Frame? = nil
local shieldText: TextLabel? = nil
local shieldLoop = false

-- Rail
local rail: Frame? = nil
local railGrid: UIGridLayout? = nil
local railTiles: { [string]: TextButton } = {}
local railCount = 0

-- Cash pill
local pill: Frame? = nil
local cashLabel: TextLabel? = nil
local cashPop: UIScale? = nil
local plusSlot: Frame? = nil
local cashTarget: number? = nil -- last synced cash; nil until the first sync (the label shows "$…")
local countFrom, countTo, countElapsed, counting = 0, 0, 0, false
local flashToken = 0
local floats: { FloatRec } = {}
local floatBirths: { number } = {}
local lastBuyVisibleAt = -math.huge
-- ONE spend float per purchase: WorldPromptController floats console / Base buys from PurchaseResult (the exact
-- cost) through HudLayout.CashFloat; the cash-drop float (setCash) is only for drops nothing else explained.
local SPEND_FLOAT_DELAY = 0.35 -- s after a cash drop: a stale sync that bounces back, or PurchaseResult, lands first
local lastExplicitSpendAt = -math.huge
local lastDropFloat: { Amount: number, At: number }? = nil

local shopOpener: (() -> ())? = nil
local settingsOpener: (() -> ())? = nil

-- badge inputs
local spinnerReady = false
local missionClaimables = 0
local loginClaimable = false
local nearPulseLevel = -1
local feedsStarted = false

---------------------------------------------------------------------------------------------------------------
-- small builders
---------------------------------------------------------------------------------------------------------------

local function isTouch(): boolean
	return HudLayout.IsTouch()
end

local function label(parent: Instance?, name: string, font: Enum.Font, size: number, color: Color3, text: string): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.Font = font
	t.TextSize = size
	t.TextColor3 = color
	t.Text = text
	t.Active = false
	if parent then
		t.Parent = parent
	end
	return t
end

local function hList(parent: Instance, padding: number, align: Enum.VerticalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.VerticalAlignment = align or Enum.VerticalAlignment.Center
	l.Padding = UDim.new(0, padding)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = parent
	return l
end

local function padding(parent: Instance, left: number, right: number, top: number?, bottom: number?): UIPadding
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, left)
	p.PaddingRight = UDim.new(0, right)
	p.PaddingTop = UDim.new(0, top or 0)
	p.PaddingBottom = UDim.new(0, bottom or 0)
	p.Parent = parent
	return p
end

-- the cash "+" (TopStrip chip, or the pill's + when HudConfig.CashPill.PlusOnPill) → Shop cash packs
local function openShopFromHud()
	if shopOpener then
		local ok, err = pcall(shopOpener :: any)
		if not ok then
			warn("[HUDController] cash + :", err)
		end
	end
end

local function chipBase(inst: GuiObject)
	inst.BackgroundColor3 = TS.Bg
	inst.BackgroundTransparency = TS.BgTransparency
	inst.BorderSizePixel = 0
	UIUtil.Corner(inst, TS.Corner)
end

local function withCommas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	s = s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return if n < 0 then "-" .. s else s
end

local ABBREV: { { Value: number, Suffix: string } } = {
	{ Value = 1e12, Suffix = "T" },
	{ Value = 1e9, Suffix = "B" },
	{ Value = 1e6, Suffix = "M" },
	{ Value = 1e3, Suffix = "K" },
}

-- "50,015,946"; at/above HudConfig.CashPill.AbbreviateAbove → "1.23B" (no "$": the pill's icon says cash)
local function formatCash(n: number): string
	local P = HudConfig.CashPill
	local v = math.floor((tonumber(n) or 0) + 0.5)
	local body = withCommas(v)
	if math.abs(v) >= P.AbbreviateAbove then
		for _, a in ipairs(ABBREV) do
			if math.abs(v) >= a.Value then
				body = string.format("%.2f%s", v / a.Value, a.Suffix)
				break
			end
		end
	end
	return if P.ShowDollarSign then "$" .. body else body
end

local function floatText(amount: number): string
	return (if amount >= 0 then "+$" else "-$") .. withCommas(math.abs(amount))
end

local function serverNow(): number
	local ok, t = pcall(function(): number
		return Workspace:GetServerTimeNow()
	end)
	if ok and typeof(t) == "number" and t > 0 then
		return t
	end
	return os.time()
end

---------------------------------------------------------------------------------------------------------------
-- TopStrip (WE_TopStrip): level chip + GoalLabel tooltip, settings gear, shield chip
---------------------------------------------------------------------------------------------------------------

local function ensureTopStrip(): Frame?
	local area = topArea
	if area and area.Parent then
		return area
	end
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local existing = pg:FindFirstChild("WE_TopStrip")
	local screen: ScreenGui
	if existing and existing:IsA("ScreenGui") then
		screen = existing
	else
		screen = Instance.new("ScreenGui")
		screen.Name = "WE_TopStrip"
		HudLayout.ApplyScreen(screen, { Insets = "Topbar", DisplayOrder = HudConfig.DisplayOrder.WE_TopStrip })
		screen.Parent = pg
	end
	local a = HudLayout.TopbarArea(screen)
	topArea = a
	return a
end

local function showGoalTip(seconds: number?)
	local tip = goalTip
	if not tip then
		return
	end
	tipToken += 1
	local my = tipToken
	tip.Visible = true
	if seconds then
		task.delay(seconds, function()
			if tipToken == my and goalTip then
				goalTip.Visible = false
			end
		end)
	end
end

local function hideGoalTip()
	tipToken += 1
	if goalTip then
		goalTip.Visible = false
	end
end

local function buildTopStrip()
	local area = ensureTopStrip()
	if not area then
		warn("[HUDController] TopStrip: no PlayerGui")
		return
	end
	local L = TS.Level

	local group = Instance.new("Frame")
	group.Name = "LeftGroup"
	group.AnchorPoint = Vector2.new(0, 1)
	group.Position = UDim2.new(0, TS.EdgePad, 1, -TS.BottomPad + TS.YNudge)
	group.Size = UDim2.fromOffset(0, TS.Height)
	group.AutomaticSize = Enum.AutomaticSize.X
	group.BackgroundTransparency = 1
	group.BorderSizePixel = 0
	group.Active = false
	hList(group, TS.Gap)

	-- Level chip: "LV 7" + XP bar. Tap / hover → the GoalLabel tooltip (goal + rebirth summary).
	local chip = Instance.new("TextButton")
	chip.Name = "LevelChip"
	chip.LayoutOrder = 1
	chip.Size = UDim2.fromOffset(L.MinWidth, TS.Height)
	chip.AutomaticSize = Enum.AutomaticSize.X
	chip.AutoButtonColor = false
	chip.Text = ""
	chip.Active = true
	chip.Selectable = true
	chipBase(chip)
	padding(chip, 14, 14)
	hList(chip, 8)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "PulseStroke"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Constants.Colors.GoldBright
	stroke.Thickness = 2
	stroke.Transparency = 1
	stroke.Parent = chip
	chipStroke = stroke
	local pop = Instance.new("UIScale")
	pop.Name = "Pulse"
	pop.Parent = chip
	chipPop = pop

	local cap = label(chip, "LevelCaption", Fonts.Body, L.CaptionSize, Colors.White, "LV")
	cap.TextTransparency = 0.28
	cap.Size = UDim2.new(0, 0, 1, 0)
	cap.AutomaticSize = Enum.AutomaticSize.X
	cap.LayoutOrder = 1
	local num = label(chip, "LevelLabel", Fonts.Display, L.NumberSize, Colors.White, "1")
	num.Size = UDim2.new(0, 0, 1, 0)
	num.AutomaticSize = Enum.AutomaticSize.X
	num.LayoutOrder = 2
	UIUtil.TextOutline(num, TS.TextStroke)
	levelLabel = num
	local barBg = Instance.new("Frame")
	barBg.Name = "XPBarBG"
	barBg.LayoutOrder = 3
	barBg.Size = UDim2.fromOffset(L.BarSize.X, L.BarSize.Y)
	barBg.BackgroundColor3 = L.BarBg
	barBg.BackgroundTransparency = L.BarBgTransparency
	barBg.BorderSizePixel = 0
	barBg.Active = false
	barBg.Parent = chip
	UIUtil.Corner(barBg, math.ceil(L.BarSize.Y / 2))
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Colors.XP
	fill.BorderSizePixel = 0
	fill.Active = false
	fill.Parent = barBg
	UIUtil.Corner(fill, math.ceil(L.BarSize.Y / 2))
	xpBarFill = fill

	-- GoalLabel tooltip: a small dark card under the chip (line 1 goal, line 2 rebirth summary)
	local tip = Instance.new("Frame")
	tip.Name = "GoalTip"
	tip.Position = UDim2.new(0, TS.EdgePad, 1, L.TipGap)
	tip.Size = UDim2.fromOffset(L.TipMaxWidth, 0)
	tip.AutomaticSize = Enum.AutomaticSize.Y
	tip.BackgroundColor3 = TS.Bg
	tip.BackgroundTransparency = 0.08
	tip.BorderSizePixel = 0
	tip.Active = false
	tip.Visible = false
	tip.ZIndex = 5
	UIUtil.Corner(tip, 10)
	padding(tip, 10, 10, 8, 8)
	local tipList = Instance.new("UIListLayout")
	tipList.FillDirection = Enum.FillDirection.Vertical
	tipList.Padding = UDim.new(0, 3)
	tipList.SortOrder = Enum.SortOrder.LayoutOrder
	tipList.Parent = tip
	local goal = label(tip, "GoalLabel", Fonts.Body, L.TipGoalSize, Colors.White, "")
	goal.Size = UDim2.new(1, 0, 0, 0)
	goal.AutomaticSize = Enum.AutomaticSize.Y
	goal.TextWrapped = true
	goal.TextXAlignment = Enum.TextXAlignment.Left
	goal.LayoutOrder = 1
	goal.ZIndex = 6
	goalLabel = goal
	local reb = label(tip, "RebirthLabel", Fonts.BodyMedium, L.TipRebirthSize, Colors.Gold, "")
	reb.Size = UDim2.new(1, 0, 0, 0)
	reb.AutomaticSize = Enum.AutomaticSize.Y
	reb.TextWrapped = true
	reb.TextXAlignment = Enum.TextXAlignment.Left
	reb.LayoutOrder = 2
	reb.ZIndex = 6
	rebirthLabel = reb
	goalTip = tip

	chip.Activated:Connect(function()
		if goalTip and goalTip.Visible then
			hideGoalTip()
		else
			showGoalTip(L.TapShowsGoalSeconds)
		end
	end)
	chip.MouseEnter:Connect(function()
		if not isTouch() then
			showGoalTip(nil)
		end
	end)
	chip.MouseLeave:Connect(function()
		if not isTouch() then
			hideGoalTip()
		end
	end)
	chip.Parent = group

	-- Settings gear (the only way into Settings: no rail tile, no key)
	local G = TS.Settings
	local gear = Instance.new("TextButton")
	gear.Name = "SettingsGear"
	gear.LayoutOrder = 2
	gear.Size = UDim2.fromOffset(G.Size, G.Size)
	gear.AutoButtonColor = false
	gear.Text = ""
	gear.Active = true
	gear.Selectable = true
	chipBase(gear)
	HudIcons.Make("Gear", gear, {
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = G.IconColor,
		Fill = TS.Bg,
		ZIndex = 2,
	})
	gear.Activated:Connect(function()
		if settingsOpener then
			local ok, err = pcall(settingsOpener :: any)
			if not ok then
				warn("[HUDController] settings gear:", err)
			end
		end
	end)
	gear.Parent = group

	-- Buy-cash chip (mobile merge gate #6): cash bills + green "+" → cash packs. It was the pill's "+", which sat
	-- in the thumbstick zone (bottom-left); up here it can never be hit by a thumb that is walking.
	if not HudConfig.CashPill.PlusOnPill then
		local CP = TS.CashPlus
		local cashPlus = Instance.new("TextButton")
		cashPlus.Name = "CashPlus"
		cashPlus.LayoutOrder = 3
		cashPlus.Size = UDim2.fromOffset(0, CP.Height)
		cashPlus.AutomaticSize = Enum.AutomaticSize.X
		cashPlus.AutoButtonColor = false
		cashPlus.Text = ""
		cashPlus.Active = true
		cashPlus.Selectable = true
		chipBase(cashPlus)
		padding(cashPlus, CP.PadLeft, CP.PadRight)
		hList(cashPlus, CP.Gap)
		HudIcons.Make("Cash", cashPlus, {
			Name = "Icon",
			Size = UDim2.fromOffset(CP.IconSize.X, CP.IconSize.Y),
			LayoutOrder = 1,
			ZIndex = 2,
		})
		local disc = Instance.new("Frame")
		disc.Name = "Circle"
		disc.LayoutOrder = 2
		disc.Size = UDim2.fromOffset(CP.PlusSize, CP.PlusSize)
		disc.BackgroundColor3 = Colors.PlusGreen
		disc.BorderSizePixel = 0
		disc.Active = false
		disc.ZIndex = 2
		disc.Parent = cashPlus
		UIUtil.Corner(disc, math.ceil(CP.PlusSize / 2))
		local ds = UIUtil.Stroke(disc, Colors.PlusGreenStroke, CP.PlusStrokePx)
		ds.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		HudIcons.Make("Plus", disc, {
			Size = UDim2.fromScale(0.72, 0.72),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Color = Colors.White,
			ZIndex = 3,
		})
		local press = Instance.new("UIScale")
		press.Name = "Press"
		press.Parent = disc
		cashPlus.InputBegan:Connect(function(input: InputObject)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				press.Scale = HudConfig.Rail.PressScale
			end
		end)
		cashPlus.InputEnded:Connect(function()
			press.Scale = 1
		end)
		cashPlus.Activated:Connect(openShopFromHud)
		cashPlus.Parent = group
		HudLayout.SetRect("CashPlus", cashPlus)
	end

	-- Shield chip (raid victim shield): cyan shield + "9:12" while WE_ShieldUntil is in the future
	local SH = TS.Shield
	local sh = Instance.new("Frame")
	sh.Name = "ShieldChip"
	sh.LayoutOrder = 4
	sh.Size = UDim2.fromOffset(0, TS.Height)
	sh.AutomaticSize = Enum.AutomaticSize.X
	sh.Active = false
	sh.Visible = false
	chipBase(sh)
	padding(sh, 10, 14)
	hList(sh, 6)
	HudIcons.Make("Shield", sh, { Name = "Icon", Size = UDim2.fromOffset(SH.IconSize, SH.IconSize), Color = SH.IconColor, LayoutOrder = 1 })
	local st = label(sh, "ShieldText", Fonts.Display, SH.TextSize, Colors.White, "")
	st.Size = UDim2.new(0, 0, 1, 0)
	st.AutomaticSize = Enum.AutomaticSize.X
	st.LayoutOrder = 2
	UIUtil.TextOutline(st, TS.TextStroke)
	sh.Parent = group
	shieldChip = sh
	shieldText = st

	tip.Parent = area
	group.Parent = area
	HudLayout.SetRect("LevelChip", chip)
end

local function shieldLeft(): number
	local v = tonumber(player:GetAttribute(TS.Shield.Attribute)) or 0
	return math.max(0, v - serverNow())
end

local function refreshShield()
	local chip, txt = shieldChip, shieldText
	if not chip or not txt then
		return
	end
	local left = shieldLeft()
	if left <= 0 then
		chip.Visible = false
		return
	end
	local s = math.ceil(left)
	txt.Text = string.format("%d:%02d", s // 60, s % 60)
	chip.Visible = true
	if shieldLoop then
		return
	end
	shieldLoop = true
	task.spawn(function()
		while shieldLeft() > 0 do
			task.wait(1)
			local c, t = shieldChip, shieldText
			if not c or not t then
				break
			end
			local r = math.ceil(shieldLeft())
			t.Text = string.format("%d:%02d", r // 60, r % 60)
		end
		shieldLoop = false
		if shieldChip and shieldLeft() <= 0 then
			shieldChip.Visible = false
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- Rail (WarEmpireHUD › Rail): one UIGridLayout column of MakeRailTile cells, vertically centred between the
-- content top and the cash pill; wraps to a 2nd column when a screen is too short (800x360 → 4 + 1).
---------------------------------------------------------------------------------------------------------------

local function layoutRail()
	local host, grid = rail, railGrid
	if not host or not grid then
		return
	end
	local R = HudConfig.Rail
	local touch = isTouch()
	local T = if touch then R.Tile else R.TileDesktop
	local ov = if touch then R.LabelOverhang else R.LabelOverhangDesktop
	local gap = if touch then R.Gap else R.GapDesktop -- dock≤8: rail gap 5/8 v
	local pillH = if touch then HudConfig.CashPill.Height else HudConfig.CashPill.HeightDesktop
	local n = math.max(1, railCount)
	local cv = HudLayout.ContentSizeV()
	local bandTop = R.TopReserve
	local bandBot = cv.Y - (HudConfig.CashPill.Bottom + pillH + HudConfig.Edge)
	local bandH = math.max(0, bandBot - bandTop)
	local perCol = math.clamp(math.floor((bandH + gap) / (T + ov + gap)), 1, n)
	local cols = math.ceil(n / perCol)
	local colH = perCol * (T + ov) + (perCol - 1) * gap
	local colGap = gap + R.ColumnGap
	local top = math.clamp(bandTop + R.CenterY * bandH - colH / 2, bandTop, math.max(bandTop, bandBot - colH))
	grid.CellSize = UDim2.fromOffset(T, T + ov)
	grid.CellPadding = UDim2.fromOffset(colGap, gap)
	grid.FillDirectionMaxCells = perCol
	host.Position = UDim2.fromOffset(R.Left, top)
	host.Size = UDim2.fromOffset(cols * T + (cols - 1) * colGap, colH)
end

local function tileDef(id: string): any?
	for _, t in ipairs(HudConfig.Rail.Tiles) do
		if t.Id == id then
			return t
		end
	end
	return nil
end

-- keyboard / gamepad players: hovering a tile shows "Shop [P]" after HudConfig.Rail.KeyHintDelay. Built for every
-- device, shown only while HudLayout.PrefersKeys() (a phone never sees a key name; touch can fire MouseEnter too).
local function addKeyHint(btn: TextButton, id: string, def: any?)
	local key = (HudConfig.Keys :: any)[id] or (def and def.Key)
	if typeof(key) ~= "EnumItem" then
		return
	end
	local R = HudConfig.Rail
	local text = string.format("%s [%s]", if def then tostring(def.Label) else id, key.Name)
	local hint = label(nil, "KeyHint", Fonts.Body, R.KeyHintSize, Colors.White, text)
	hint.AnchorPoint = Vector2.new(0, 0.5)
	hint.Position = UDim2.new(1, 8, 0, R.TileDesktop / 2)
	hint.AutomaticSize = Enum.AutomaticSize.XY
	hint.BackgroundColor3 = TS.Bg
	hint.BackgroundTransparency = 0.15
	hint.Visible = false
	hint.ZIndex = 40
	UIUtil.Corner(hint, 8)
	padding(hint, 8, 8, 4, 4)
	hint.Parent = btn
	local token = 0
	btn.MouseEnter:Connect(function()
		token += 1
		local my = token
		if not HudLayout.PrefersKeys() then
			return
		end
		task.delay(R.KeyHintDelay, function()
			if my == token and HudLayout.PrefersKeys() then
				hint.Visible = true
			end
		end)
	end)
	local function hide()
		token += 1
		hint.Visible = false
	end
	btn.MouseLeave:Connect(hide)
	btn.Activated:Connect(hide)
end

local function pulseTile(id: string, scale: number)
	local btn = railTiles[id]
	local press = btn and btn:FindFirstChild("Press", true)
	if press and press:IsA("UIScale") then
		press.Scale = scale
		TweenService:Create(press, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

--[[ Rail badge: "!" (gold ready style), a count ("3"), or nil to clear. Anyone else calls HudLayout.SetBadge. ]]
function HUDController.SetRailBadge(id: string, text: string?)
	HudLayout.SetBadge(id, text)
end

local function refreshMissionsBadge()
	local n = missionClaimables + (if loginClaimable then 1 else 0) + (if spinnerReady then 1 else 0)
	HUDController.SetRailBadge("Missions", if n > 0 then tostring(n) else nil)
end

---------------------------------------------------------------------------------------------------------------
-- Cash pill (WarEmpireHUD › CurrencyPill) + cash float
---------------------------------------------------------------------------------------------------------------

local function pillHeight(): number
	return if isTouch() then HudConfig.CashPill.Height else HudConfig.CashPill.HeightDesktop
end

local buildPillPlus: (slot: Frame) -> ()

local function buildPill(screen: ScreenGui)
	local P = HudConfig.CashPill
	local touch = isTouch()
	local h = pillHeight()

	local p = Instance.new("Frame")
	p.Name = "CurrencyPill"
	p.AnchorPoint = Vector2.new(0, 1)
	p.Position = UDim2.new(0, P.Left, 1, -P.Bottom)
	p.Size = UDim2.fromOffset(P.MinWidth, h)
	p.AutomaticSize = Enum.AutomaticSize.X
	p.BackgroundColor3 = Colors.PillBg
	p.BackgroundTransparency = Colors.PillBgTransparency
	p.BorderSizePixel = 0
	p.Active = false
	p.ZIndex = 12
	UIUtil.Corner(p, P.Corner)
	local ring = UIUtil.Stroke(p, Colors.PillStroke, P.StrokePx)
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Transparency = Colors.PillStrokeTransparency
	padding(p, P.PadLeft, P.PadRight)
	local lim = Instance.new("UISizeConstraint")
	lim.MinSize = Vector2.new(P.MinWidth, 0)
	lim.MaxSize = Vector2.new(P.MaxWidth, math.huge)
	lim.Parent = p
	hList(p, P.Gap)

	HudIcons.Make("Cash", p, { Name = "Icon", Size = UDim2.fromOffset(P.IconSize.X, P.IconSize.Y), LayoutOrder = 1, ZIndex = 13 })

	local cash = label(p, "CashLabel", Fonts.Display, if touch then P.NumberSize else P.NumberSizeDesktop, P.NumberColor, "")
	cash.LayoutOrder = 2
	cash.Size = UDim2.new(0, 0, 1, 0)
	cash.AutomaticSize = Enum.AutomaticSize.X
	cash.TextXAlignment = Enum.TextXAlignment.Left
	cash.ZIndex = 13
	-- v36: high-contrast cash (white FredokaOne + a 2 px Ink outline on the dark pill — not yellow/gold)
	cash.TextStrokeColor3 = Colors.Ink
	cash.TextStrokeTransparency = 0.25
	-- v60: brief $… then leaderstats/0 within 0.5s — never stuck forever
	cash.Text = "$…"
	UIUtil.TextOutline(cash, 2)
	padding(cash, 0, P.NumberPadRight)
	local cp = Instance.new("UIScale")
	cp.Name = "Pop"
	cp.Parent = cash
	cashLabel = cash
	cashPop = cp

	-- PlusSlot: the cash floats' anchor at the pill's right end. The green + itself is the TopStrip's CashPlus
	-- chip (mobile merge gate #6: out of the thumbstick zone) unless HudConfig.CashPill.PlusOnPill brings it back.
	local slot = Instance.new("Frame")
	slot.Name = "PlusSlot"
	slot.LayoutOrder = 3
	slot.Size = UDim2.fromOffset(if P.PlusOnPill then P.PlusVisual else P.PlusSlotWidth, P.PlusVisual)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.Active = false
	slot.Parent = p
	plusSlot = slot
	if P.PlusOnPill then
		buildPillPlus(slot)
	end

	p.Parent = screen
	pill = p
	HudLayout.BindVisibility(p, HudConfig.CashPill)
	HudLayout.SetRect("CashPill", p)
end

-- the legacy pill "+" (HudConfig.CashPill.PlusOnPill = true only): a transparent PlusHit v hit area around the
-- PlusVisual v circle → cash packs (no toast)
buildPillPlus = function(slot: Frame)
	local P = HudConfig.CashPill
	local cashPlus = Instance.new("TextButton")
	cashPlus.Name = "CashPlus"
	cashPlus.AnchorPoint = Vector2.new(0.5, 0.5)
	cashPlus.Position = UDim2.fromScale(0.5, 0.5)
	cashPlus.Size = UDim2.fromOffset(P.PlusHit, P.PlusHit)
	cashPlus.BackgroundTransparency = 1
	cashPlus.BorderSizePixel = 0
	cashPlus.AutoButtonColor = false
	cashPlus.Text = ""
	cashPlus.Active = true
	cashPlus.Selectable = true
	cashPlus.ZIndex = 14
	cashPlus.Parent = slot
	UIUtil.EnsureMinTouch(cashPlus, 44)
	local circle = Instance.new("Frame")
	circle.Name = "Circle"
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.Position = UDim2.fromScale(0.5, 0.5)
	circle.Size = UDim2.fromOffset(P.PlusVisual, P.PlusVisual)
	circle.BackgroundColor3 = Colors.PlusGreen
	circle.BorderSizePixel = 0
	circle.Active = false
	circle.ZIndex = 15
	circle.Parent = cashPlus
	UIUtil.Corner(circle, math.ceil(P.PlusVisual / 2))
	local cs = UIUtil.Stroke(circle, Colors.PlusGreenStroke, P.PlusStrokePx)
	cs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	HudIcons.Make("Plus", circle, {
		Size = UDim2.fromScale(0.76, 0.76),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = Colors.White,
		ZIndex = 16,
	})
	local press = Instance.new("UIScale")
	press.Name = "Press"
	press.Parent = circle
	cashPlus.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			press.Scale = HudConfig.Rail.PressScale
		end
	end)
	cashPlus.InputEnded:Connect(function()
		press.Scale = 1
	end)
	cashPlus.Activated:Connect(openShopFromHud)
end

local function renderCash(v: number)
	if cashLabel then
		cashLabel.Text = formatCash(v)
	end
end

local function flashCash(color: Color3)
	local lab, pop = cashLabel, cashPop
	if not lab then
		return
	end
	local P = HudConfig.CashPill
	flashToken += 1
	local my = flashToken
	lab.TextColor3 = color
	TweenService:Create(lab, TweenInfo.new(P.FlashSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextColor3 = P.NumberColor }):Play()
	task.delay(P.FlashSeconds + 0.05, function()
		if my == flashToken and cashLabel then
			cashLabel.TextColor3 = P.NumberColor
		end
	end)
	if pop then
		pop.Scale = P.PopScale
		TweenService:Create(pop, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function floatBaseY(): number
	return -(4 + (pillHeight() - HudConfig.CashPill.PlusVisual) / 2)
end

-- X offset (v) of the float's right edge from the + slot: normally -4, shifted right when a long "-$120,000" next
-- to a short pill would run into the rail's bottom tile (spec §3.3: the float never overlaps the rail)
local function floatX(f: FloatRec): number
	local x = -4
	local p = pill
	local r = rail
	if not (p and r and r.Visible) then
		return x
	end
	local railPos, railSize = HudLayout.GetRect("Rail")
	if railSize.X <= 0 then
		return x
	end
	local lab = f.Label
	local ok, tb = pcall(function(): Vector2
		return TextService:GetTextSize(lab.Text, lab.TextSize, lab.Font, Vector2.new(4000, 1000))
	end)
	if not ok or typeof(tb) ~= "Vector2" then
		return x
	end
	local s = HudLayout.Scale()
	-- the + slot is the pill's last list item, PadRight from its right edge. Pill width: its AbsoluteSize, or its
	-- content measured from the cash text when the AutomaticSize width has not been resolved yet
	local P = HudConfig.CashPill
	local pillW = p.AbsoluteSize.X
	local cl = cashLabel
	if cl then
		local okN, nb = pcall(function(): Vector2
			return TextService:GetTextSize(cl.Text, cl.TextSize, cl.Font, Vector2.new(4000, 1000))
		end)
		if okN and typeof(nb) == "Vector2" then
			local slotW = if P.PlusOnPill then P.PlusVisual else P.PlusSlotWidth
			local wV = P.PadLeft + P.IconSize.X + P.Gap + nb.X + P.NumberPadRight + P.Gap + slotW + P.PadRight
			pillW = math.max(pillW, math.clamp(wV, P.MinWidth, P.MaxWidth) * s)
		end
	end
	local slotLeftPx = p.AbsolutePosition.X + pillW - (P.PadRight + (if P.PlusOnPill then P.PlusVisual else P.PlusSlotWidth)) * s
	local leftPx = slotLeftPx + (x - tb.X - HudConfig.CashFloat.StrokePx) * s
	local minLeft = railPos.X + railSize.X + 4 * s
	if leftPx < minLeft then
		x += (minLeft - leftPx) / s
	end
	return x
end

local function animateFloat(f: FloatRec)
	local CF = HudConfig.CashFloat
	for _, tw in ipairs(f.Tweens) do
		tw:Cancel()
	end
	local y = floatBaseY()
	local x = floatX(f)
	f.Label.Position = UDim2.new(0, x, 0, y)
	f.Label.TextTransparency = 0
	f.Stroke.Transparency = 0
	local rise = TweenInfo.new(CF.Seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	-- hold opaque for the first half, fade over the second
	local fade = TweenInfo.new(CF.Seconds * 0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, CF.Seconds * 0.5)
	f.Tweens = {
		TweenService:Create(f.Label, rise, { Position = UDim2.new(0, x, 0, y - CF.Rise) }),
		TweenService:Create(f.Label, fade, { TextTransparency = 1 }),
		TweenService:Create(f.Stroke, fade, { Transparency = 1 }),
	}
	for _, tw in ipairs(f.Tweens) do
		tw:Play()
	end
	f.Token += 1
	local my = f.Token
	task.delay(CF.Seconds + 0.05, function()
		if f.Token ~= my then
			return
		end
		local i = table.find(floats, f)
		if i then
			table.remove(floats, i)
		end
		f.Label:Destroy()
	end)
end

--[[
	"+$141" rising from the cash pill, just left of the + (spend: "-$5,000" in red). Gains within
	HudConfig.CashFloat.MergeWindow add into the same float; at most MaxPerSecond new floats per second (extra
	amounts merge into the newest float or are left to the count-up). Fed by HudLayout.CashFloat (Collect
	notifications) and by cash drops while buying (SetEconomy).
]]
function HUDController.ShowCashFloat(amount: number)
	if typeof(amount) ~= "number" or amount ~= amount or amount == 0 or math.abs(amount) == math.huge then
		return
	end
	local CF = HudConfig.CashFloat
	if amount < 0 and not CF.ShowSpend then
		return
	end
	local slot = plusSlot
	if not slot then
		return
	end
	local now = os.clock()
	for i = #floatBirths, 1, -1 do
		if now - floatBirths[i] > 1 then
			table.remove(floatBirths, i)
		end
	end
	local newest = floats[#floats]
	if newest and newest.Label.Parent and (newest.Amount > 0) == (amount > 0) then
		if now - newest.Last <= CF.MergeWindow or #floatBirths >= CF.MaxPerSecond then
			newest.Amount += amount
			newest.Last = now
			newest.Label.Text = floatText(newest.Amount)
			animateFloat(newest)
			return
		end
	end
	if #floatBirths >= CF.MaxPerSecond then
		return -- over the rate limit with nothing to merge into: the count-up alone shows it
	end
	local lab = label(nil, "CashFloat", Fonts.Display, CF.TextSize, if amount > 0 then CF.GainColor else CF.SpendColor, floatText(amount))
	lab.AnchorPoint = Vector2.new(1, 1)
	lab.AutomaticSize = Enum.AutomaticSize.XY
	lab.Size = UDim2.fromOffset(0, 0)
	lab.ZIndex = 20
	local stroke = UIUtil.TextOutline(lab, CF.StrokePx)
	lab.Parent = slot
	local rec: FloatRec = { Label = lab, Stroke = stroke, Amount = amount, Last = now, Token = 0, Tweens = {} }
	table.insert(floats, rec)
	table.insert(floatBirths, now)
	animateFloat(rec)
end

local function buyButtonShowing(): boolean
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local g = pg and pg:FindFirstChild("WE_PadBuyGui")
	if not (g and g:IsA("ScreenGui") and g.Enabled) then
		return false
	end
	local b = g:FindFirstChild("BuyButton", true)
	return b ~= nil and b:IsA("GuiObject") and b.Visible
end

-- spend floats only for drops the player caused: a panel is open, or the console BUY button was just on screen
local function spendContext(): boolean
	if HudLayout.GetFlag("Modal") or buyButtonShowing() then
		return true
	end
	return os.clock() - lastBuyVisibleAt <= HudConfig.CashFloat.SpendContextSeconds
end

local function setCash(newCash: number)
	local prev = cashTarget
	cashTarget = newCash
	if not cashLabel then
		return
	end
	if prev == nil then
		counting = false
		countTo = newCash
		renderCash(newCash)
		return
	end
	if newCash == prev and not counting then
		renderCash(newCash)
		return
	end
	if newCash == countTo then
		return
	end
	local P = HudConfig.CashPill
	local shown = if counting then countFrom + (countTo - countFrom) * math.clamp(countElapsed / P.CountUpSeconds, 0, 1) else prev
	countFrom = shown
	countTo = newCash
	countElapsed = 0
	counting = true
	local delta = newCash - prev
	if delta > 0 then
		flashCash(HudConfig.CashFloat.GainColor)
	elseif delta < 0 then
		flashCash(HudConfig.CashFloat.SpendColor)
		if HudConfig.CashFloat.ShowSpend and spendContext() then
			-- after a beat, so a stale sync that bounces straight back never floats, and skipped when the buy
			-- already floated its exact cost (WorldPromptController → HudLayout.CashFloat): no "-$40,000" for $20,000
			task.delay(SPEND_FLOAT_DELAY, function()
				local now = os.clock()
				if cashTarget and cashTarget <= newCash and now - lastExplicitSpendAt > HudConfig.CashFloat.SpendContextSeconds then
					lastDropFloat = { Amount = delta, At = now }
					HUDController.ShowCashFloat(delta)
				end
			end)
		end
	end
end

local function stepHud(dt: number)
	if counting then
		countElapsed += dt
		local a = math.clamp(countElapsed / HudConfig.CashPill.CountUpSeconds, 0, 1)
		local e = 1 - (1 - a) * (1 - a)
		if a >= 1 then
			counting = false
			renderCash(countTo)
		else
			renderCash(countFrom + (countTo - countFrom) * e)
		end
	end
end

---------------------------------------------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------------------------------------------

local function startBadgeFeeds()
	if feedsStarted then
		return
	end
	feedsStarted = true
	-- Bound after every controller's Init (deferred), so MissionController's own listener is already connected
	-- when the join push arrives.
	Remotes.BindEvent(Constants.RemoteNames.SpinnerStateUpdate, function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		spinnerReady = payload.Ready == true
		refreshMissionsBadge()
	end)
	Remotes.BindEvent(Constants.RemoteNames.MissionStateUpdate, function(payload: Types.MissionStatePayload)
		if typeof(payload) ~= "table" then
			return
		end
		local n = 0
		local daily = (payload :: any).Daily
		if typeof(daily) == "table" then
			for _, m in ipairs(daily) do
				if typeof(m) == "table" and m.Complete == true and m.Claimed ~= true then
					n += 1
				end
			end
		end
		missionClaimables = n
		local dl = (payload :: any).DailyLogin
		loginClaimable = typeof(dl) == "table" and dl.CanClaim == true
		refreshMissionsBadge()
	end)
end

function HUDController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireHUD"
	screen.IgnoreGuiInset = false
	-- above the world HUDs (combat 25 … orders 52) so rail tiles receive clicks; below modal panels (60+)
	screen.DisplayOrder = 55
	HudLayout.ApplyScreen(screen, { DisplayOrder = HudConfig.DisplayOrder.WarEmpireHUD })
	screen.Parent = player:WaitForChild("PlayerGui")
	_gui = screen

	-- Left rail (tiles come from BindActionBar)
	local r = Instance.new("Frame")
	r.Name = "Rail"
	r.BackgroundTransparency = 1
	r.BorderSizePixel = 0
	r.Active = false
	r.ZIndex = 20
	local grid = Instance.new("UIGridLayout")
	grid.FillDirection = Enum.FillDirection.Vertical
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.VerticalAlignment = Enum.VerticalAlignment.Top
	grid.Parent = r
	r.Parent = screen
	rail = r
	railGrid = grid
	layoutRail()
	HudLayout.BindVisibility(r, HudConfig.Rail)
	HudLayout.SetRect("Rail", r)

	buildPill(screen)
	buildTopStrip()

	HudLayout.LayoutChanged:Connect(layoutRail)
	HudLayout.BadgeChanged:Connect(function(id: string, text: string?)
		local btn = railTiles[id]
		if btn then
			UIUtil.SetTileBadge(btn, text)
		end
	end)
	-- Shop "!" (offer deferred / dropped) and Garage "!" (vehicle not spawned yet) clear when that panel opens
	HudLayout.PanelChanged:Connect(function(id: string, open: boolean)
		local src = (HudConfig.Rail.BadgeSources :: any)[id]
		if open and (src == "OfferPending" or src == "NewVehicle") then
			HudLayout.SetBadge(id, nil)
		end
	end)
	HudLayout.CashFloatRequested:Connect(function(amount: number)
		if typeof(amount) == "number" and amount < 0 then
			local now = os.clock()
			lastExplicitSpendAt = now
			local d = lastDropFloat
			if d and now - d.At <= HudConfig.CashFloat.SpendContextSeconds and math.abs(d.Amount - amount) < 0.5 then
				return -- the cash-drop float already showed this exact spend (PurchaseResult came late)
			end
		end
		HUDController.ShowCashFloat(amount)
	end)

	player:GetAttributeChangedSignal(TS.Shield.Attribute):Connect(refreshShield)
	refreshShield()

	do
		local acc = 0
		RunService.Heartbeat:Connect(function(dt: number)
			stepHud(dt)
			acc += dt
			if acc >= 0.25 then
				acc = 0
				if buyButtonShowing() then
					lastBuyVisibleAt = os.clock()
				end
			end
		end)
	end

	-- v60 NUCLEAR: leaderstats FIRST — never WaitForChild remotes on HUD cash path
	local function tryLeaderstats(): boolean
		local folder = player:FindFirstChild("leaderstats")
		if not folder then
			return false
		end
		local cashV = folder:FindFirstChild("Cash")
		if not cashV or not (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			return false
		end
		local goldV = folder:FindFirstChild("Gold")
		local g = 0
		if goldV and (goldV:IsA("IntValue") or goldV:IsA("NumberValue")) then
			g = (goldV :: any).Value
		end
		HUDController.SetEconomy((cashV :: any).Value, g, tonumber(player:GetAttribute("WE_PendingCash")) or 0)
		return true
	end

	local function wireLeaderstatsFolder(folder: Instance)
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			(cashV :: any):GetPropertyChangedSignal("Value"):Connect(function()
				tryLeaderstats()
			end)
		end
		folder.ChildAdded:Connect(function(ch)
			if ch.Name == "Cash" and (ch:IsA("IntValue") or ch:IsA("NumberValue")) then
				(ch :: any):GetPropertyChangedSignal("Value"):Connect(function()
					tryLeaderstats()
				end)
				tryLeaderstats()
			end
		end)
		tryLeaderstats()
	end

	tryLeaderstats()
	do
		local existing = player:FindFirstChild("leaderstats")
		if existing then
			wireLeaderstatsFolder(existing)
		end
	end
	player.ChildAdded:Connect(function(ch)
		if ch.Name == "leaderstats" then
			wireLeaderstatsFolder(ch)
		end
	end)

	player:GetAttributeChangedSignal("WE_Cash"):Connect(function()
		local c = tonumber(player:GetAttribute("WE_Cash")) or 0
		local g = tonumber(player:GetAttribute("WE_Gold")) or 0
		local pend = tonumber(player:GetAttribute("WE_PendingCash")) or 0
		HUDController.SetEconomy(c, g, pend)
	end)
	do
		local c = player:GetAttribute("WE_Cash")
		if typeof(c) == "number" then
			HUDController.SetEconomy(
				c,
				tonumber(player:GetAttribute("WE_Gold")) or 0,
				tonumber(player:GetAttribute("WE_PendingCash")) or 0
			)
		end
	end

	-- EconomyUpdate IF present — never infinite WaitForChild
	local econToken = 0
	Remotes.BindEvent(Constants.RemoteNames.EconomyUpdate, function(payload: Types.EconomyUpdatePayload)
		econToken += 1
		local my = econToken
		local cashAmt, goldAmt = payload.Cash, payload.Gold
		local pendingAmt = tonumber(payload.PendingCash) or 0
		task.defer(function()
			if my == econToken then
				HUDController.SetEconomy(cashAmt, goldAmt, pendingAmt)
			end
		end)
	end)

	-- 0.5s hard fallback: never leave $… / $—
	task.delay(0.5, function()
		if not cashLabel then
			return
		end
		local txt = cashLabel.Text
		if txt == "$…" or txt == "$—" or txt == "$..." then
			if not tryLeaderstats() then
				local attr = tonumber(player:GetAttribute("WE_Cash"))
				if typeof(attr) == "number" then
					HUDController.SetEconomy(attr, tonumber(player:GetAttribute("WE_Gold")) or 0, tonumber(player:GetAttribute("WE_PendingCash")) or 0)
				else
					HUDController.SetEconomy(0, 0, 0)
				end
			end
		end
	end)

	-- Poll: attrs/leaderstats only; GetPlayerState via TryGet (no hang)
	task.spawn(function()
		local synced = false
		for i = 0, 20 do
			if typeof(player:GetAttribute("WE_Cash")) == "number" then
				HUDController.SetEconomy(
					player:GetAttribute("WE_Cash") :: number,
					tonumber(player:GetAttribute("WE_Gold")) or 0,
					tonumber(player:GetAttribute("WE_PendingCash")) or 0
				)
				synced = true
			end
			if tryLeaderstats() then
				synced = true
			end
			local fn = Remotes.TryGetFunction(Constants.RemoteNames.GetPlayerState)
			if fn then
				local ok, state = pcall(function()
					return fn:InvokeServer()
				end)
				if ok and state then
					HUDController.ApplyState(state :: Types.PlayerStatePayload)
					synced = true
					break
				end
			end
			if synced and i >= 2 then
				break
			end
			task.wait(0.25)
		end
		if not synced then
			warn("[HUDController] attr/leaderstats bootstrap still empty after poll")
		end
	end)

	-- XP / state via BindEvent — never block Init
	Remotes.BindEvent(Constants.RemoteNames.XPUpdate, function(payload: Types.XPUpdatePayload)
		HUDController.SetXP(payload.Level, payload.XP, payload.XPToNext, payload.HudGoal)
		if payload.LevelUp == true then
			-- the server's "★ LEVEL n!" reward toast is the text (and the sound); the chip just celebrates
			HUDController.ShowLevelUpCelebration(payload.Level, payload.UnlockMessage)
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: Types.PlayerStatePayload)
		HUDController.ApplyState(state)
	end)

	-- spinner + mission badge feeds: after every controller's Init (see startBadgeFeeds)
	task.defer(startBadgeFeeds)
end

--[[ The TopStrip's free-topbar-row Frame (HudLayout.TopbarArea of WE_TopStrip); CompassController parents the
	compass chip here. Builds the gui on demand, so it works whatever the Init order. ]]
function HUDController.GetTopStripArea(): Frame?
	return ensureTopStrip()
end

--[[ v70: no banner — the level chip pops (UIScale 1 → 1.15 → 1) and its stroke flashes GoldBright; the
	server's "★ LEVEL n! — unlock" reward toast in the lane is the only text. ]]
function HUDController.ShowLevelUpCelebration(level: number, _unlockMessage: string?)
	local L = TS.Level
	if levelLabel then
		levelLabel.Text = tostring(math.floor(level))
	end
	local pop, stroke = chipPop, chipStroke
	if pop then
		pop.Scale = 1
		TweenService:Create(pop, TweenInfo.new(L.PopSeconds / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Scale = L.PopScale }):Play()
	end
	if stroke then
		stroke.Color = Constants.Colors.GoldBright
		stroke.Transparency = 0
		TweenService:Create(stroke, TweenInfo.new(L.PulseSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
	end
end

--[[ v38 soft rebirth CTA, v70 form: no banner. The Rebirth tile pulses once (the "!" badge comes at minLevel,
	see SetXP) and the level-chip tooltip carries the copy ("Rebirth 38/40 … · Keep all Robux Items"). ]]
function HUDController.ShowNearPrestigeBanner(level: number, minLevel: number)
	if level >= minLevel then
		HUDController.SetRailBadge("Rebirth", "!")
	end
	pulseTile("Rebirth", HudConfig.Rail.NearPrestigePulse)
end

--[[
	Rail tiles (spec §3.2). actions: { {Id, Name?, OnClick} } — visuals (label, icon, colours) come from
	HudConfig.Rail.Tiles by Id, in config order. Each cell is ONE TextButton (UIUtil.MakeRailTile) whose hit area
	includes the label; btn.Activated → OnClick (UIController: opener, one click sound, no toast).
]]
function HUDController.BindActionBar(actions: { RailAction })
	local host = rail
	if not host then
		warn("[HUDController] BindActionBar: rail nil — Init order broken?")
		return
	end
	for _, child in ipairs(host:GetChildren()) do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	table.clear(railTiles)
	local byId: { [string]: RailAction } = {}
	for _, a in ipairs(actions) do
		byId[a.Id] = a
	end
	local ordered: { { Def: any?, Action: RailAction } } = {}
	for _, t in ipairs(HudConfig.Rail.Tiles) do
		local a = byId[t.Id]
		if a then
			table.insert(ordered, { Def = t, Action = a })
			byId[t.Id] = nil
		end
	end
	for _, a in ipairs(actions) do
		if byId[a.Id] then
			table.insert(ordered, { Def = tileDef(a.Id), Action = a })
			byId[a.Id] = nil
		end
	end
	local touch = isTouch()
	for i, entry in ipairs(ordered) do
		local def = entry.Def
		local id = entry.Action.Id
		local kind: string = if def then def.Icon else "Dot"
		local btn = UIUtil.MakeRailTile(nil, {
			Name = entry.Action.Name or (if def then def.Name else "Dock" .. id),
			Label = if def then def.Label else id,
			Accent = if def then def.Accent else Colors.Muted,
			Fill = if def then def.Fill else Colors.PillBg,
			Icon = kind,
			LayoutOrder = i,
			Touch = touch,
			IconBuilder = function(slot: Frame, ink: Color3, fill: Color3)
				HudIcons.Make(kind, slot, { Size = UDim2.fromScale(1, 1), Color = ink, Fill = fill, ZIndex = 24 })
			end,
		})
		btn.Active = true
		local onClick = entry.Action.OnClick
		local onLong = entry.Action.OnLongPress
		-- long-press (optional, e.g. Army → cycle the order): fires once after LONG_PRESS_SECONDS of holding the
		-- tile; the tap that ends that hold is then swallowed, so the popover does not also toggle
		local swallowNext = false
		if onLong then
			local longFn: () -> () = onLong
			local pressToken = 0
			local held: InputObject? = nil
			btn.InputBegan:Connect(function(input: InputObject)
				local t = input.UserInputType
				if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then
					return
				end
				pressToken += 1
				local my = pressToken
				held = input
				swallowNext = false
				local startPos = input.Position
				task.delay(LONG_PRESS_SECONDS, function()
					if my ~= pressToken or held ~= input then
						return
					end
					local st = input.UserInputState
					if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
						return
					end
					-- a thumb that lands on the tile and slides (walking) is a drag, not a long-press: the order stays
					if (input.Position - startPos).Magnitude > LONG_PRESS_SLOP_PX then
						return
					end
					held = nil
					swallowNext = true
					local ok, err = pcall(function(): string?
						longFn()
						return nil
					end)
					if not ok then
						warn("[HUDController] rail long-press " .. id .. ":", err)
					end
				end)
			end)
			btn.InputEnded:Connect(function(input: InputObject)
				if input == held then
					held = nil
					pressToken += 1
				end
			end)
		end
		-- Activated = mouse + touch + gamepad (MouseButton1Click alone misses some touch paths)
		btn.Activated:Connect(function()
			if swallowNext then
				swallowNext = false
				return
			end
			onClick()
		end)
		addKeyHint(btn, id, def)
		btn.Parent = host
		railTiles[id] = btn
		UIUtil.SetTileBadge(btn, HudLayout.GetBadge(id))
		HudLayout.SetRect(id .. "Tile", btn)
		HudLayout.AssertTouchTarget(btn, "rail " .. id)
	end
	railCount = #ordered
	layoutRail()
	local order = if _gui then _gui.DisplayOrder else -1
	print(string.format("[HUDController] BindActionBar: %d rail tiles DisplayOrder=%d", railCount, order))
end

function HUDController.SetEconomy(cash: number, gold: number, pending: number?)
	-- v57: coerce so nil never skips update (only called after confirmed Economy sync). Gold and pending are
	-- accepted for every caller but no longer drawn: gold > 0 lives in the Shop header, pending on the ATM screen.
	local _ = gold
	local _p = pending
	setCash(tonumber(cash) or 0)
end

function HUDController.SetXP(level: number, xp: number, xpToNext: number, hudGoal: string?)
	local lv = math.floor(tonumber(level) or 0)
	if levelLabel then
		levelLabel.Text = tostring(lv)
	end
	local maxed = xpToNext == math.huge or xpToNext <= 0
	local alpha = if maxed then 1 else math.clamp(xp / xpToNext, 0, 1)
	if xpBarFill then
		xpBarFill.Size = UDim2.fromScale(alpha, 1)
	end
	-- Rebirth progress toward PrestigeConfig.MinLevelToPrestige (default 40) → the GoalLabel tooltip + badge
	local minPrestige = (PrestigeConfig and PrestigeConfig.MinLevelToPrestige) or 40
	local nearBand = (PrestigeConfig and PrestigeConfig.NearPrestigeLevels) or 2
	local fee = tonumber(PrestigeConfig and PrestigeConfig.CashFee) or 0
	local feeBit = if fee > 0 then string.format("Fee $%s", withCommas(fee)) else "Fee: none"
	local bonusPct = math.floor((tonumber(PrestigeConfig.CashBonusPerPrestige) or 0.1) * 100 + 0.5)
	-- "press K" only for keyboard / gamepad players (CLAUDE.md §1: never name a key where a phone player reads it)
	local rebirthHow = if HudLayout.PrefersKeys() then " · press " .. HudConfig.Keys.Rebirth.Name else " · tap Rebirth"
	local goalText = if typeof(hudGoal) == "string" and hudGoal ~= "" then hudGoal else LevelConfig.GetHudGoal(lv)
	local rebirthText: string
	if lv >= minPrestige then
		rebirthText = string.format("Rebirth READY · %s · +%d%% cash forever · Keep all Robux Items%s", feeBit, bonusPct, rebirthHow)
	else
		local pct = math.clamp(math.floor((lv / minPrestige) * 100), 0, 99)
		rebirthText = string.format("Rebirth %d/%d (%d%%) · %s · +%d%%/P", lv, minPrestige, pct, feeBit, bonusPct)
		if lv >= minPrestige - nearBand then
			rebirthText ..= " · Keep all Robux Items"
		end
	end
	if goalLabel then
		goalLabel.Text = goalText
	end
	if rebirthLabel then
		rebirthLabel.Text = rebirthText
	end
	HUDController.SetRailBadge("Rebirth", if lv >= minPrestige then "!" else nil)
	-- v38 near-prestige nudge: once per level in the band
	if lv >= minPrestige - nearBand and lv < minPrestige and nearPulseLevel ~= lv then
		nearPulseLevel = lv
		HUDController.ShowNearPrestigeBanner(lv, minPrestige)
	end
end

function HUDController.ApplyState(state: Types.PlayerStatePayload)
	HUDController.SetEconomy(state.Cash, state.Gold, (state :: any).PendingCash)
	local goal = LevelConfig.GetHudGoal(state.Level)
	HUDController.SetXP(state.Level, state.XP, state.XPToNext, goal)
end

--[[ Wire the cash-pill + → ShopController (cash packs) after Shop Init. ]]
function HUDController.BindShopOpener(fn: () -> ())
	shopOpener = fn
end

--[[ Wire the TopStrip settings gear → SettingsController after Settings Init. ]]
function HUDController.BindSettingsOpener(fn: () -> ())
	settingsOpener = fn
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">MissileController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v69 MISSILE COMMAND (client): the Command Center strike panel + the missile FX every client draws.

	Panel (WE_MissilePanel): opened by the Missile Command terminal inside the Command Center (UIController
	routes the prompt attribute WE_OpenPanel = "Missiles" to MissileController.Open). One row per enemy base
	on the server with the server's verdict (CanStrike / ReasonText), a live status line and a two-tap STRIKE
	button (STRIKE → CONFIRM within 3 s → RequestMissileStrike { Action = "Launch", TargetUserId }).
	Everything shown arrives in MissileStrikeStateUpdate; this file never requires RaidConfig. Countdowns tick
	locally from the seconds in the last payload: remaining = max(0, secs − (os.clock() − receivedAt)).
	The panel opens instantly in a loading state and never waits on the server.

	FX (always on): every MissileStrikeFx launch is drawn as a missile on a quadratic bezier arc from the
	attacker's Missile Defense battery to the target's gate, with an interceptor + mid-air burst when the
	outcome is Intercepted. The victim gets a siren, a pulsing red screen edge and an INCOMING banner; the
	attacker a small banner (hidden while this panel is open — the panel shows the same thing).

	Server-authoritative: the server re-checks unlock, cooldown, cash, distance to the Command Center and the
	target's shields, and charges the cost. The only remote sent from here is RequestMissileStrike.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local BaseConfig = require(Shared.Configs.BaseConfig)
local ClientSettings = require(script.Parent.Parent.Modules.ClientSettings)
local AudioController = require(script.Parent.Parent.Modules.AudioController)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout) -- v70: the banner is the top-centre stack's "Alert"
local HudConfig = require(Shared.Configs.HudConfig)

local MissileController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled

-- ── Layout (px) ─────────────────────────────────────────────────────────────
local PANEL_MAX_W, PANEL_MAX_H = 640, 340
local HEADER_H = 44
local STATUS_LINE_H = 28
local ROW_H = 60
local ROW_REASON_H = 20
local BTN_W, BTN_H = 112, 44
local SMALL_TEXT = if isTouch then 14 else 13 -- touch fonts never go below 14
local CHIP_TEXT = if isTouch then 14 else 13

-- ── Timing ──────────────────────────────────────────────────────────────────
local CONFIRM_SECONDS = 3
local REFRESH_SECONDS = 5
local RESULT_SECONDS = 3
local RESULT_REFRESH_DELAY = 0.5
local MIN_REQUEST_GAP = 0.75 -- client-side courtesy throttle for State requests
local LAUNCH_PENDING_SECONDS = 4 -- STRIKE buttons wait this long for the server's answer

-- ── FX ──────────────────────────────────────────────────────────────────────
local FX_CULL_STUDS = 2000
local FX_MAX_ACTIVE = 3
local FX_LATE_SECONDS = 3 -- skip a launch we hear about later than impact + this
local SHAKE_STUDS = 200
local INTERCEPTOR_SECONDS = 1.2
local ALERT_HOLD_SECONDS = 3
local EXPLOSION_RADIUS = 18
local SIREN_ID = "rbxasset://sounds/electronicpingshort.wav"
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local C = {
	Panel = Color3.fromRGB(22, 26, 31),
	Header = Color3.fromRGB(64, 38, 34),
	Row = Color3.fromRGB(36, 41, 48),
	RowLocked = Color3.fromRGB(29, 32, 37),
	Chip = Color3.fromRGB(52, 59, 68),
	Text = Constants.Colors.Text,
	Muted = Constants.Colors.Muted,
	Red = Color3.fromRGB(196, 52, 44),
	RedDark = Color3.fromRGB(110, 20, 18),
	Orange = Color3.fromRGB(232, 122, 36),
	Amber = Color3.fromRGB(236, 176, 64),
	Green = Color3.fromRGB(64, 170, 96),
	Blue = Color3.fromRGB(64, 128, 196),
	Grey = Color3.fromRGB(62, 68, 76),
	Dim = Color3.fromRGB(88, 52, 50),
	Stroke = Color3.fromRGB(120, 60, 52),
}

-- Reasons that concern the attacker (not the target). The status line explains them, so rows don't repeat them.
local ATTACKER_REASONS: { [string]: boolean } = {
	Disabled = true,
	Loading = true,
	NoBase = true,
	Locked = true,
	Cooldown = true,
	InFlight = true,
	Busy = true,
}

-- ── Payload types (mirrors MissileStrikeService; spec §6.3) ─────────────────
type Requirement = { StructureId: string, DisplayName: string, Need: number, Have: number }

type Target = {
	UserId: number,
	Name: string,
	BaseName: string,
	PlotId: number,
	Distance: number,
	FlightSeconds: number,
	WallsLevel: number,
	HasAutoGuns: boolean,
	MissileDefenseLevel: number,
	InterceptChance: number,
	ShieldRemaining: number,
	DefensesDownRemaining: number,
	RebootRemaining: number,
	Incoming: boolean,
	CanStrike: boolean,
	Reason: string?,
	ReasonText: string?,
	ReasonSecs: number?, -- the m:ss inside ReasonText, so it can count down between refreshes
}

type StrikeResult = {
	Kind: string,
	TargetName: string?,
	Reason: string?,
	Text: string,
	DownSeconds: number?,
	ImpactIn: number?,
}

type InFlightInfo = { TargetUserId: number, TargetName: string, ImpactIn: number }

type State = {
	Unlocked: boolean,
	LockedText: string?,
	Requirements: { Requirement },
	Cost: number,
	Cash: number,
	CooldownRemaining: number,
	CooldownTotal: number,
	AtCommandCenter: boolean,
	InFlight: InFlightInfo?,
	Targets: { Target },
	Result: StrikeResult?,
}

type ChipSpec = { Text: string, Short: string?, Bg: Color3, Fg: Color3, Keep: boolean? }

type Row = {
	UserId: number,
	Frame: Frame,
	NameLabel: TextLabel,
	SubLabel: TextLabel,
	Chips: Frame,
	ChipPool: { TextLabel },
	ChipKey: string,
	Button: TextButton,
	ReasonLabel: TextLabel,
	Target: Target,
}

type Ui = {
	Screen: ScreenGui,
	Panel: Frame,
	Title: TextLabel,
	ResultFrame: Frame,
	ResultLabel: TextLabel,
	Status: Frame,
	StatusLabel: TextLabel,
	ReqHolder: Frame,
	ReqPool: { TextLabel },
	List: ScrollingFrame,
	Empty: TextLabel,
}

-- ── Module state ────────────────────────────────────────────────────────────
local ui: Ui? = nil
local isOpen = false
local state: State? = nil
local stateAt = 0 -- os.clock() when `state` arrived
local rows: { [number]: Row } = {}
local panelW, panelH = PANEL_MAX_W, PANEL_MAX_H
local statusH = STATUS_LINE_H
local confirmUserId: number? = nil
local confirmUntil = 0
local launchPendingUntil = 0
local pendingTargetUserId: number? = nil
local bannerToken = 0
local lastStateReqAt = -math.huge
local stateReqQueued = false
local baseUpgrades: { [string]: number } = {} -- own structure levels from BaseStateUpdate (prerequisite hints)
local initDone = false

-- ── Small helpers ───────────────────────────────────────────────────────────
local function num(v: any, default: number): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

local function str(v: any): string?
	if typeof(v) == "string" and v ~= "" then
		return v
	end
	return nil
end

local function commas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (if n < 0 then "-" else "") .. out
end

local function mmss(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- seconds left of a countdown that read `secs` when the last state arrived
local function live(secs: number): number
	return math.max(0, secs - (os.clock() - stateAt))
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function textWidth(text: string, size: number): number
	local ok, v = pcall(function()
		return TextService:GetTextSize(text, size, Enum.Font.GothamBold, Vector2.new(2000, 200))
	end)
	if ok and typeof(v) == "Vector2" then
		return math.ceil(v.X)
	end
	return math.ceil((utf8.len(text) or #text) * size * 0.62)
end

local function topInset(): number
	local y = 36
	pcall(function()
		local tl = GuiService:GetGuiInset()
		y = tl.Y
	end)
	return y
end

local function getPlayerGui(): PlayerGui?
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if pg then
		return pg
	end
	local waited = player:WaitForChild("PlayerGui", 5)
	if waited and waited:IsA("PlayerGui") then
		return waited
	end
	return nil
end

-- the ScreenGui area (IgnoreGuiInset = false → below the topbar)
local function guiArea(): (number, number)
	local u = ui
	if u then
		local abs: any = u.Screen.AbsoluteSize
		if typeof(abs) == "Vector2" and abs.X > 0 and abs.Y > 0 then
			return abs.X, abs.Y
		end
	end
	local cam = workspace.CurrentCamera
	if cam then
		local vp: any = cam.ViewportSize
		if typeof(vp) == "Vector2" and vp.X > 0 and vp.Y > 0 then
			return vp.X, math.max(0, vp.Y - topInset())
		end
	end
	return 844, 354
end

local function newLabel(parent: Instance, name: string, font: Enum.Font, size: number, color: Color3): TextLabel
	local lab = Instance.new("TextLabel")
	lab.Name = name
	lab.BackgroundTransparency = 1
	lab.BorderSizePixel = 0
	lab.Font = font
	lab.TextSize = size
	lab.TextColor3 = color
	lab.TextXAlignment = Enum.TextXAlignment.Left
	lab.TextYAlignment = Enum.TextYAlignment.Center
	lab.TextTruncate = Enum.TextTruncate.AtEnd
	lab.Text = ""
	lab.Parent = parent
	return lab
end

-- ── Payload parsing (never trust shapes) ────────────────────────────────────
local function parseTarget(t: any): Target?
	if typeof(t) ~= "table" then
		return nil
	end
	local uid = tonumber(t.UserId)
	if uid == nil then
		return nil
	end
	local name = str(t.Name) or ("Player " .. tostring(uid))
	local reasonText = str(t.ReasonText)
	local reasonSecs: number? = nil
	if reasonText then
		local m, s = string.match(reasonText, "(%d+):(%d%d)")
		if m and s then
			reasonSecs = (tonumber(m) or 0) * 60 + (tonumber(s) or 0)
		end
	end
	return {
		UserId = uid,
		Name = name,
		BaseName = str(t.BaseName) or (name .. "'s Base"),
		PlotId = math.floor(num(t.PlotId, 0)),
		Distance = math.max(0, num(t.Distance, 0)),
		FlightSeconds = math.max(0, num(t.FlightSeconds, 0)),
		WallsLevel = math.max(0, math.floor(num(t.WallsLevel, 0))),
		HasAutoGuns = t.HasAutoGuns == true,
		MissileDefenseLevel = math.max(0, math.floor(num(t.MissileDefenseLevel, 0))),
		InterceptChance = math.clamp(num(t.InterceptChance, 0), 0, 1),
		ShieldRemaining = math.max(0, num(t.ShieldRemaining, 0)),
		DefensesDownRemaining = math.max(0, num(t.DefensesDownRemaining, 0)),
		RebootRemaining = math.max(0, num(t.RebootRemaining, 0)),
		Incoming = t.Incoming == true,
		CanStrike = t.CanStrike == true,
		Reason = str(t.Reason),
		ReasonText = reasonText,
		ReasonSecs = reasonSecs,
	}
end

local function parseResult(r: any): StrikeResult?
	if typeof(r) ~= "table" then
		return nil
	end
	local kind = str(r.Kind) or "Refused"
	return {
		Kind = kind,
		TargetName = str(r.TargetName),
		Reason = str(r.Reason),
		Text = str(r.Text) or kind,
		DownSeconds = tonumber(r.DownSeconds),
		ImpactIn = tonumber(r.ImpactIn),
	}
end

local function parseState(p: any): State?
	if typeof(p) ~= "table" then
		return nil
	end
	local reqs: { Requirement } = {}
	if typeof(p.Requirements) == "table" then
		for _, r in ipairs(p.Requirements) do
			if typeof(r) == "table" then
				local sid = str(r.StructureId) or "?"
				table.insert(reqs, {
					StructureId = sid,
					DisplayName = str(r.DisplayName) or sid,
					Need = math.floor(num(r.Need, 0)),
					Have = math.floor(num(r.Have, 0)),
				})
			end
		end
	end
	local targets: { Target } = {}
	if typeof(p.Targets) == "table" then
		for _, t in ipairs(p.Targets) do
			local parsed = parseTarget(t)
			if parsed and parsed.UserId ~= player.UserId then
				table.insert(targets, parsed)
			end
		end
	end
	local inFlight: InFlightInfo? = nil
	if typeof(p.InFlight) == "table" then
		inFlight = {
			TargetUserId = math.floor(num(p.InFlight.TargetUserId, 0)),
			TargetName = str(p.InFlight.TargetName) or "target",
			ImpactIn = math.max(0, num(p.InFlight.ImpactIn, 0)),
		}
	end
	return {
		Unlocked = p.Unlocked == true,
		LockedText = str(p.LockedText),
		Requirements = reqs,
		Cost = math.max(0, num(p.Cost, 0)),
		Cash = math.max(0, num(p.Cash, 0)),
		CooldownRemaining = math.max(0, num(p.CooldownRemaining, 0)),
		CooldownTotal = math.max(0, num(p.CooldownTotal, 0)),
		AtCommandCenter = p.AtCommandCenter ~= false,
		InFlight = inFlight,
		Targets = targets,
		Result = parseResult(p.Result),
	}
end

-- ── Chips (manual flow layout so the panel never depends on engine wrapping) ─
local function poolChip(holder: Frame, pool: { TextLabel }, i: number): TextLabel
	local existing: TextLabel? = pool[i]
	if existing then
		return existing
	end
	local created = newLabel(holder, "Chip", Enum.Font.GothamBold, CHIP_TEXT, C.Text)
	created.BackgroundTransparency = 0
	created.TextXAlignment = Enum.TextXAlignment.Center
	UIUtil.Corner(created, 5)
	pool[i] = created
	return created
end

local CHIP_GAP, CHIP_LINE_GAP = 5, 4

local function chipLines(widths: { number }, maxW: number): number
	local x, lines = 0, 0
	for _, w in ipairs(widths) do
		if lines == 0 then
			lines = 1
		elseif x > 0 and x + w > maxW then
			lines += 1
			x = 0
		end
		x += w + CHIP_GAP
	end
	return lines
end

-- Places `specs` left→right, wrapping at maxW, at most maxLines lines; returns the lines used. When the full
-- texts need more lines, chips switch to their Short text; if that still overflows, Keep chips go first so
-- only the least important chips can drop.
local function flowChips(holder: Frame, pool: { TextLabel }, specs: { ChipSpec }, maxW: number, chipH: number, maxLines: number): number
	local order: { ChipSpec } = table.clone(specs)
	local texts: { string } = {}
	local widths: { number } = {}
	local function measure()
		for i = 1, #order do
			widths[i] = math.min(maxW, textWidth(texts[i], CHIP_TEXT) + 14)
		end
	end
	for i, spec in ipairs(order) do
		texts[i] = spec.Text
	end
	measure()
	if chipLines(widths, maxW) > maxLines then
		for i, spec in ipairs(order) do
			texts[i] = spec.Short or spec.Text
		end
		measure()
		if chipLines(widths, maxW) > maxLines then
			local kept: { ChipSpec } = {}
			local rest: { ChipSpec } = {}
			for _, spec in ipairs(order) do
				table.insert(if spec.Keep then kept else rest, spec)
			end
			order = kept
			for _, spec in ipairs(rest) do
				table.insert(order, spec)
			end
			for i, spec in ipairs(order) do
				texts[i] = spec.Short or spec.Text
			end
			measure()
		end
	end
	local x, line, lines = 0, 0, 0
	for i, spec in ipairs(order) do
		local lab = poolChip(holder, pool, i)
		local w = widths[i]
		if x > 0 and x + w > maxW then
			line += 1
			x = 0
		end
		if line >= maxLines then
			lab.Visible = false
		else
			lab.Visible = true
			lab.Text = texts[i]
			lab.BackgroundColor3 = spec.Bg
			lab.TextColor3 = spec.Fg
			lab.Position = UDim2.fromOffset(x, line * (chipH + CHIP_LINE_GAP))
			lab.Size = UDim2.fromOffset(w, chipH)
			x += w + CHIP_GAP
			lines = line + 1
		end
	end
	for i = #order + 1, #pool do
		pool[i].Visible = false
	end
	return lines
end

-- ── Panel geometry ──────────────────────────────────────────────────────────
local function geometry(): (number, number, number, number)
	local rowW = panelW - 26 -- list inset 8+8, scrollbar 6, row inset 4
	local nameW = math.clamp(math.floor(rowW * 0.27), 130, 170)
	local chipsX = 10 + nameW + 8
	local chipsW = math.max(60, rowW - chipsX - BTN_W - 16)
	return rowW, nameW, chipsX, chipsW
end

local function applyLayout()
	local u = ui
	if not u then
		return
	end
	local w, h = guiArea()
	panelW = math.max(300, math.min(PANEL_MAX_W, w - 32))
	panelH = math.max(220, math.min(PANEL_MAX_H, h - 16))
	u.Panel.Size = UDim2.fromOffset(panelW, panelH)
	u.Title.Size = UDim2.fromOffset(panelW - 14 - 52, HEADER_H)
	u.ResultFrame.Size = UDim2.fromOffset(panelW - 8 - 52, HEADER_H - 12)
	u.Status.Size = UDim2.fromOffset(panelW - 24, statusH)
	u.StatusLabel.Size = UDim2.fromOffset(panelW - 24, STATUS_LINE_H)
	u.ReqHolder.Size = UDim2.fromOffset(panelW - 24, statusH)
	local listY = HEADER_H + 2 + statusH + 4
	u.List.Position = UDim2.fromOffset(8, listY)
	u.List.Size = UDim2.fromOffset(panelW - 16, panelH - listY - 8)
	u.Empty.Size = UDim2.fromOffset(panelW - 40, 56)
end

-- ── Result banner (inside the panel header, 3 s) ───────────────────────────
local RESULT_COLORS: { [string]: Color3 } = {
	Launched = C.Orange,
	Hit = C.Green,
	Intercepted = C.Amber,
	Refunded = C.Blue,
	Refused = C.Red,
}

local function showBanner(text: string, kind: string)
	local u = ui
	if not u then
		return
	end
	bannerToken += 1
	local token = bannerToken
	u.ResultLabel.Text = text
	u.ResultFrame.BackgroundColor3 = RESULT_COLORS[kind] or C.Grey
	u.ResultLabel.TextColor3 = if kind == "Intercepted" then Constants.Colors.TextDark else Color3.fromRGB(255, 255, 255)
	u.ResultFrame.Visible = true
	u.Title.Visible = false
	task.delay(RESULT_SECONDS, function()
		if token == bannerToken and ui then
			u.ResultFrame.Visible = false
			u.Title.Visible = true
		end
	end)
end

-- ── Status line ─────────────────────────────────────────────────────────────
local function shortName(displayName: string): string
	return (string.gsub(displayName, " Station$", ""))
end

local function requirementText(r: Requirement): string
	if r.Have >= r.Need then
		return string.format("✓ %s L%d (you L%d)", r.DisplayName, r.Need, r.Have)
	end
	local hints: { string } = {}
	local def = (BaseConfig.Structures :: any)[r.StructureId]
	if typeof(def) == "table" and typeof(def.Requires) == "table" then
		for _, pre in ipairs(def.Requires) do
			local preId = tostring(pre.StructureId)
			local preLevel = tonumber(pre.Level) or 1
			local known = baseUpgrades[preId]
			if known == nil or known < preLevel then
				local preDef = (BaseConfig.Structures :: any)[preId]
				local preName = if typeof(preDef) == "table" and typeof(preDef.DisplayName) == "string" then preDef.DisplayName else preId
				table.insert(hints, string.format("needs %s L%d", shortName(preName), preLevel))
			end
		end
	end
	local extra = if #hints > 0 then " · " .. table.concat(hints, " · ") else ""
	return string.format("✗ %s L%d (you L%d%s)", r.DisplayName, r.Need, r.Have, extra)
end

local function setStatusHeight(h: number)
	if h ~= statusH then
		statusH = h
		applyLayout()
	end
end

local function renderStatus()
	local u = ui
	if not u then
		return
	end
	local s = state
	if s and not s.Unlocked and #s.Requirements > 0 then
		u.StatusLabel.Visible = false
		u.ReqHolder.Visible = true
		local specs: { ChipSpec } = {}
		for _, r in ipairs(s.Requirements) do
			local ok = r.Have >= r.Need
			table.insert(specs, {
				Text = requirementText(r),
				Bg = if ok then Color3.fromRGB(34, 78, 50) else Color3.fromRGB(96, 30, 28),
				Fg = if ok then Color3.fromRGB(170, 240, 190) else Color3.fromRGB(255, 196, 186),
			})
		end
		local lines = flowChips(u.ReqHolder, u.ReqPool, specs, panelW - 24, 24, 2)
		setStatusHeight(if lines >= 2 then 2 * STATUS_LINE_H else STATUS_LINE_H)
		return
	end
	u.ReqHolder.Visible = false
	u.StatusLabel.Visible = true
	setStatusHeight(STATUS_LINE_H)
	local label = u.StatusLabel
	if not s then
		label.Text = "Contacting Missile Command…"
		label.TextColor3 = C.Muted
	elseif not s.Unlocked then
		label.Text = s.LockedText or "Needs Command Center L3 + Missile Defense L1"
		label.TextColor3 = C.Amber
	elseif s.InFlight then
		local left = live(s.InFlight.ImpactIn)
		label.Text = if left > 0
			then string.format("🚀 Missile in the air → %s · %ds", s.InFlight.TargetName, math.ceil(left))
			else string.format("🚀 Missile in the air → %s · impact…", s.InFlight.TargetName)
		label.TextColor3 = C.Orange
	elseif live(s.CooldownRemaining) > 0 then
		label.Text = "Reloading " .. mmss(live(s.CooldownRemaining))
		label.TextColor3 = C.Amber
	elseif not s.AtCommandCenter then
		label.Text = "Use this at your Command Center terminal"
		label.TextColor3 = C.Amber
	elseif s.Cash < s.Cost then
		label.Text = string.format("Cost $%s · you have $%s", commas(s.Cost), commas(s.Cash))
		label.TextColor3 = Color3.fromRGB(255, 140, 120)
	else
		label.Text = string.format("Cost $%s · READY", commas(s.Cost))
		label.TextColor3 = Color3.fromRGB(120, 230, 150)
	end
end

-- ── Rows ────────────────────────────────────────────────────────────────────
type ButtonMode = "strike" | "confirm" | "sending" | "dim" | "off"

local function attackerBusy(s: State): boolean
	return s.InFlight ~= nil or live(s.CooldownRemaining) > 0
end

local function buttonMode(t: Target): ButtonMode
	local s = state
	if not s or not s.Unlocked or not t.CanStrike then
		return "off"
	end
	if os.clock() < launchPendingUntil then
		return if pendingTargetUserId == t.UserId then "sending" else "off"
	end
	if attackerBusy(s) then
		return "off"
	end
	if not s.AtCommandCenter or s.Cash < s.Cost then
		return "dim"
	end
	if confirmUserId == t.UserId and os.clock() < confirmUntil then
		return "confirm"
	end
	return "strike"
end

local function stateChip(t: Target): (string?, Color3?)
	-- one state chip, in the server's CanStrike order (shield → down → reboot → inbound)
	local sh = live(t.ShieldRemaining)
	if sh > 0 then
		return "🛡 " .. mmss(sh), C.Blue
	end
	local dd = live(t.DefensesDownRemaining)
	if dd > 0 then
		return "DEF DOWN " .. mmss(dd), C.Red
	end
	local rb = live(t.RebootRemaining)
	if rb > 0 then
		return "REBOOT " .. mmss(rb), Color3.fromRGB(150, 104, 30)
	end
	if t.Incoming then
		return "INBOUND", C.Red
	end
	return nil, nil
end

local function rowReasonText(t: Target): string?
	local s = state
	if not s or not s.Unlocked or t.CanStrike then
		return nil
	end
	if t.Reason and ATTACKER_REASONS[t.Reason] then
		return nil -- the status line already says it (and counts it down)
	end
	local text = t.ReasonText or t.Reason
	if not text then
		return nil
	end
	if t.ReasonSecs and t.ReasonText then
		text = (string.gsub(t.ReasonText, "%d+:%d%d", mmss(live(t.ReasonSecs)), 1))
	end
	return text
end

local function renderRow(row: Row)
	local t = row.Target
	local s = state
	local unlocked = s ~= nil and s.Unlocked
	local _, nameW, chipsX, chipsW = geometry()

	row.Frame.BackgroundColor3 = if unlocked then C.Row else C.RowLocked
	row.NameLabel.Size = UDim2.fromOffset(nameW, 22)
	row.NameLabel.Text = t.BaseName
	row.NameLabel.TextColor3 = if unlocked then C.Text else C.Muted
	row.SubLabel.Size = UDim2.fromOffset(nameW, 20)
	row.SubLabel.Text = string.format("%s studs · %ds flight", commas(t.Distance), math.max(1, math.floor(t.FlightSeconds + 0.5)))

	-- chips: Walls · AutoGuns · MD/intercept · state
	local specs: { ChipSpec } = {}
	table.insert(specs, {
		Text = if t.WallsLevel > 0 then "Walls L" .. tostring(t.WallsLevel) else "No walls",
		Bg = C.Chip,
		Fg = C.Text,
	})
	if t.HasAutoGuns then
		table.insert(specs, { Text = "AutoGuns", Bg = Color3.fromRGB(92, 64, 36), Fg = Color3.fromRGB(255, 214, 150), Keep = true })
	end
	table.insert(specs, {
		Text = string.format("MD L%d · %d%% intercept", t.MissileDefenseLevel, math.floor(t.InterceptChance * 100 + 0.5)),
		Short = string.format("MD L%d · %d%%", t.MissileDefenseLevel, math.floor(t.InterceptChance * 100 + 0.5)),
		Keep = true,
		Bg = C.Chip,
		Fg = C.Text,
	})
	local stText, stColor = stateChip(t)
	if stText and stColor then
		table.insert(specs, { Text = stText, Bg = stColor, Fg = Color3.fromRGB(255, 255, 255), Keep = true })
	end
	local keyParts = { tostring(chipsW) }
	for _, spec in ipairs(specs) do
		table.insert(keyParts, spec.Text)
	end
	local key = table.concat(keyParts, "|")
	if key ~= row.ChipKey then
		row.ChipKey = key
		local chipH = CHIP_TEXT + 8
		local lines = flowChips(row.Chips, row.ChipPool, specs, chipsW, chipH, 2)
		local blockH = math.max(1, lines) * chipH + math.max(0, lines - 1) * CHIP_LINE_GAP
		row.Chips.Position = UDim2.fromOffset(chipsX, math.floor((ROW_H - blockH) / 2))
		row.Chips.Size = UDim2.fromOffset(chipsW, blockH)
	end

	-- reason under the row
	local reason = rowReasonText(t)
	row.ReasonLabel.Visible = reason ~= nil
	row.ReasonLabel.Text = reason or ""
	row.Frame.Size = UDim2.new(1, -4, 0, if reason then ROW_H + ROW_REASON_H else ROW_H)

	-- STRIKE button
	local btn = row.Button
	local costText = "$" .. commas(if s then s.Cost else 0)
	local mode = buttonMode(t)
	if mode == "strike" then
		btn.Text = "STRIKE\n" .. costText
		btn.BackgroundColor3 = C.Red
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.AutoButtonColor = true
	elseif mode == "confirm" then
		btn.Text = "CONFIRM\n" .. costText
		btn.BackgroundColor3 = C.Orange
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.AutoButtonColor = true
	elseif mode == "sending" then
		btn.Text = "LAUNCHING…"
		btn.BackgroundColor3 = C.Grey
		btn.TextColor3 = C.Text
		btn.AutoButtonColor = false
	elseif mode == "dim" then
		btn.Text = "STRIKE\n" .. costText
		btn.BackgroundColor3 = C.Dim
		btn.TextColor3 = C.Muted
		btn.AutoButtonColor = false
	else
		btn.Text = "—"
		btn.BackgroundColor3 = C.Grey
		btn.TextColor3 = C.Muted
		btn.AutoButtonColor = false
	end
	btn:SetAttribute("WE_Mode", mode)
end

local function renderRows()
	for _, row in pairs(rows) do
		renderRow(row)
	end
end

local function requestState()
	if not isOpen then
		return
	end
	local now = os.clock()
	local waitFor = MIN_REQUEST_GAP - (now - lastStateReqAt)
	if waitFor > 0 then
		if not stateReqQueued then
			stateReqQueued = true
			task.delay(waitFor, function()
				stateReqQueued = false
				requestState()
			end)
		end
		return
	end
	lastStateReqAt = now
	task.spawn(function()
		Remotes.FireServer(Constants.RemoteNames.RequestMissileStrike, { Action = "State" })
	end)
end

local function onStrikeTap(row: Row)
	local s = state
	local t = row.Target
	local mode = buttonMode(t)
	if mode == "sending" then
		return
	end
	if mode == "off" then
		if s and not s.Unlocked then
			showBanner(s.LockedText or "Needs Command Center L3 + Missile Defense L1", "Refused")
		elseif s and s.InFlight then
			showBanner("Your missile is still in the air", "Refused")
		elseif s and live(s.CooldownRemaining) > 0 then
			showBanner("Reloading — " .. mmss(live(s.CooldownRemaining)), "Refused")
		elseif not t.CanStrike then
			showBanner(rowReasonText(t) or t.ReasonText or "Can't strike this base right now", "Refused")
		end
		return
	end
	if mode == "dim" and s then
		if not s.AtCommandCenter then
			showBanner("Use the Missile Command terminal in your Command Center", "Refused")
		else
			showBanner(string.format("Need $%s — you have $%s", commas(s.Cost), commas(s.Cash)), "Refused")
		end
		return
	end
	pcall(AudioController.PlayClick)
	if mode == "confirm" then
		confirmUserId = nil
		launchPendingUntil = os.clock() + LAUNCH_PENDING_SECONDS
		pendingTargetUserId = t.UserId
		local uid = t.UserId
		task.spawn(function()
			local sent = Remotes.FireServer(Constants.RemoteNames.RequestMissileStrike, { Action = "Launch", TargetUserId = uid })
			if not sent then
				launchPendingUntil = 0
				showBanner("Missile Command offline — try again", "Refused")
				renderRows()
			end
		end)
		task.delay(LAUNCH_PENDING_SECONDS + 0.05, renderRows)
	else
		confirmUserId = t.UserId
		confirmUntil = os.clock() + CONFIRM_SECONDS
		task.delay(CONFIRM_SECONDS + 0.05, renderRows)
	end
	renderRows()
end

local function makeRow(list: ScrollingFrame, t: Target): Row
	local frame = Instance.new("Frame")
	frame.Name = "Target_" .. tostring(t.UserId)
	frame.BackgroundColor3 = C.Row
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, -4, 0, ROW_H)
	frame.Parent = list
	UIUtil.Corner(frame, 8)

	local nameLabel = newLabel(frame, "BaseName", Enum.Font.GothamBold, 16, C.Text)
	nameLabel.Position = UDim2.fromOffset(10, 8)

	local subLabel = newLabel(frame, "Sub", Enum.Font.Gotham, SMALL_TEXT, C.Muted)
	subLabel.Position = UDim2.fromOffset(10, 31)

	local chips = Instance.new("Frame")
	chips.Name = "Chips"
	chips.BackgroundTransparency = 1
	chips.BorderSizePixel = 0
	chips.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Name = "Strike"
	btn.AnchorPoint = Vector2.new(1, 0)
	btn.Position = UDim2.new(1, -8, 0, 8)
	btn.Size = UDim2.fromOffset(BTN_W, BTN_H)
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.TextWrapped = true
	btn.Text = "—"
	btn.Parent = frame
	UIUtil.Corner(btn, 8)
	UIUtil.EnsureMinTouch(btn, 44)

	local reasonLabel = newLabel(frame, "Reason", Enum.Font.GothamMedium, SMALL_TEXT, C.Amber)
	reasonLabel.Position = UDim2.fromOffset(10, ROW_H - 4)
	reasonLabel.Size = UDim2.new(1, -20, 0, ROW_REASON_H)
	reasonLabel.Visible = false

	local row: Row = {
		UserId = t.UserId,
		Frame = frame,
		NameLabel = nameLabel,
		SubLabel = subLabel,
		Chips = chips,
		ChipPool = {},
		ChipKey = "",
		Button = btn,
		ReasonLabel = reasonLabel,
		Target = t,
	}
	btn.Activated:Connect(function()
		onStrikeTap(row)
	end)
	return row
end

local function reconcileRows()
	local u = ui
	if not u then
		return
	end
	local s = state
	local seen: { [number]: boolean } = {}
	if s then
		local order = table.clone(s.Targets)
		table.sort(order, function(a: Target, b: Target): boolean
			if a.CanStrike ~= b.CanStrike then
				return a.CanStrike
			end
			if a.Distance ~= b.Distance then
				return a.Distance < b.Distance
			end
			return a.UserId < b.UserId
		end)
		for i, t in ipairs(order) do
			seen[t.UserId] = true
			local row = rows[t.UserId]
			if not row then
				row = makeRow(u.List, t)
				rows[t.UserId] = row
			end
			row.Target = t
			row.Frame.LayoutOrder = i
		end
	end
	for uid, row in pairs(rows) do
		if not seen[uid] then
			row.Frame:Destroy()
			rows[uid] = nil
		end
	end
	if confirmUserId and not seen[confirmUserId] then
		confirmUserId = nil
	end
	u.Empty.Visible = s == nil or #s.Targets == 0
	u.Empty.Text = if s == nil then "Loading targets…" else "No enemy bases on this server right now"
end

local function renderAll()
	if not ui then
		return
	end
	renderStatus()
	reconcileRows()
	renderRows()
end

-- ── Panel construction (lazy; never yields beyond a bounded PlayerGui lookup) ─
local function ensureUi(): Ui?
	local existing = ui
	if existing and existing.Screen.Parent then
		return existing
	end
	local pg = getPlayerGui()
	if not pg then
		return nil
	end
	rows = {}

	local screen = Instance.new("ScreenGui")
	screen.Name = "WE_MissilePanel"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = false
	-- Spec said 30; 60 matches every other modal panel so the HUD dock (55) never covers the STRIKE buttons.
	screen.DisplayOrder = 60
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Enabled = true

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(PANEL_MAX_W, PANEL_MAX_H)
	panel.BackgroundColor3 = C.Panel
	panel.BorderSizePixel = 0
	panel.Active = true -- taps on the panel never fall through to the world
	panel.Visible = false
	panel.Parent = screen
	UIUtil.Corner(panel, 10)
	UIUtil.Stroke(panel, C.Stroke, 1.5)

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.BorderSizePixel = 0
	header.Size = UDim2.new(1, 0, 0, HEADER_H)
	header.Parent = panel
	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.BackgroundColor3 = C.Header
	divider.BorderSizePixel = 0
	divider.Position = UDim2.fromOffset(0, HEADER_H)
	divider.Size = UDim2.new(1, 0, 0, 2)
	divider.Parent = panel

	local title = newLabel(header, "Title", Enum.Font.GothamBlack, 20, C.Text)
	title.Position = UDim2.fromOffset(14, 0)
	title.Text = "MISSILE COMMAND"

	local resultFrame = Instance.new("Frame")
	resultFrame.Name = "Result"
	resultFrame.Position = UDim2.fromOffset(8, 6)
	resultFrame.BorderSizePixel = 0
	resultFrame.Visible = false
	resultFrame.Parent = header
	UIUtil.Corner(resultFrame, 7)
	local resultLabel = newLabel(resultFrame, "Text", Enum.Font.GothamBold, 15, Color3.fromRGB(255, 255, 255))
	resultLabel.Position = UDim2.fromOffset(10, 0)
	resultLabel.Size = UDim2.new(1, -20, 1, 0)

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, 0, 0, 0)
	close.Size = UDim2.fromOffset(44, 44)
	close.BackgroundTransparency = 1
	close.BorderSizePixel = 0
	close.Font = Enum.Font.GothamBold
	close.TextSize = 22
	close.TextColor3 = C.Text
	close.Text = "✕"
	close.Parent = header
	UIUtil.EnsureMinTouch(close, 44)
	close.Activated:Connect(function()
		pcall(AudioController.PlayClick)
		MissileController.Close()
	end)

	local status = Instance.new("Frame")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.BorderSizePixel = 0
	status.Position = UDim2.fromOffset(12, HEADER_H + 2)
	status.Parent = panel

	local statusLabel = newLabel(status, "Line", Enum.Font.GothamBold, 15, C.Muted)
	statusLabel.Position = UDim2.fromOffset(0, 0)

	local reqHolder = Instance.new("Frame")
	reqHolder.Name = "Requirements"
	reqHolder.BackgroundTransparency = 1
	reqHolder.BorderSizePixel = 0
	reqHolder.Position = UDim2.fromOffset(0, 2)
	reqHolder.Visible = false
	reqHolder.Parent = status

	local list = Instance.new("ScrollingFrame")
	list.Name = "Targets"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.ScrollBarImageColor3 = C.Muted
	list.VerticalScrollBarInset = Enum.ScrollBarInset.Always
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local empty = newLabel(panel, "Empty", Enum.Font.GothamMedium, 15, C.Muted)
	empty.AnchorPoint = Vector2.new(0.5, 0.5)
	empty.Position = UDim2.new(0.5, 0, 0.5, 30)
	empty.TextXAlignment = Enum.TextXAlignment.Center
	empty.TextWrapped = true
	empty.Text = "Loading targets…"

	screen.Parent = pg

	local built: Ui = {
		Screen = screen,
		Panel = panel,
		Title = title,
		ResultFrame = resultFrame,
		ResultLabel = resultLabel,
		Status = status,
		StatusLabel = statusLabel,
		ReqHolder = reqHolder,
		ReqPool = {},
		List = list,
		Empty = empty,
	}
	ui = built

	screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		applyLayout()
		if isOpen then
			renderAll()
		end
	end)
	applyLayout()
	return built
end

-- ── State updates ───────────────────────────────────────────────────────────
local function onState(payload: any)
	local parsed = parseState(payload)
	if not parsed then
		return
	end
	state = parsed
	stateAt = os.clock()
	local result = parsed.Result
	if result then
		launchPendingUntil = 0
		pendingTargetUserId = nil
		if isOpen then
			showBanner(result.Text, result.Kind)
			task.delay(RESULT_REFRESH_DELAY, requestState)
		end
	end
	if isOpen then
		renderAll()
	end
end

-- ── Missile FX ──────────────────────────────────────────────────────────────
type Strike = {
	Id: number,
	P0: Vector3,
	P1: Vector3,
	P2: Vector3,
	Launch: number,
	Flight: number,
	EndT: number, -- 1 for a hit, InterceptT when shot down
	Intercepted: boolean,
	InterceptFrom: Vector3?,
	Involved: boolean,
	Folder: Folder,
	Parts: { BasePart },
	Offsets: { CFrame },
	Effects: { Instance },
	IParts: { BasePart },
	IOffsets: { CFrame },
	IEffects: { Instance },
	Exploded: boolean,
	DestroyAt: number,
}

type Alert = {
	Role: string, -- "Victim" | "Attacker"
	StrikeId: number,
	ImpactAt: number,
	ResolveAt: number,
	EndAt: number,
	Outcome: string,
	Other: string,
	DownSeconds: number,
}

type AlertUi = { Screen: ScreenGui, Edges: { Frame }, Banner: Frame, Label: TextLabel, Stroke: UIStroke }

local strikes: { Strike } = {}
local seenStrikeIds: { [number]: boolean } = {}
local seenCount = 0
local alert: Alert? = nil
local alertUi: AlertUi? = nil
local fxWarned = false

local function bezier(s: Strike, t: number): Vector3
	local u = 1 - t
	return s.P0 * (u * u) + s.P1 * (2 * u * t) + s.P2 * (t * t)
end

local function bezierDir(s: Strike, t: number): Vector3
	return (s.P1 - s.P0) * (2 * (1 - t)) + (s.P2 - s.P1) * (2 * t)
end

local function fxFolder(): Folder
	local f = workspace:FindFirstChild("WE_MissileFx")
	if f and f:IsA("Folder") then
		return f :: Folder
	end
	local nf = Instance.new("Folder")
	nf.Name = "WE_MissileFx"
	nf.Parent = workspace
	return nf
end

local function fxPart(parent: Instance, name: string, shape: Enum.PartType, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = shape
	p.Size = size
	p.Color = color
	p.Material = material
	p.Parent = parent
	return p
end

-- Builds a missile (forward = −Z, like CFrame.lookAt). Returns parts + their offsets + trail/smoke effects.
local function buildMissile(parent: Instance, small: boolean): ({ BasePart }, { CFrame }, { Instance })
	local k = if small then 0.6 else 1
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local effects: { Instance } = {}
	local function add(p: BasePart, off: CFrame)
		table.insert(parts, p)
		table.insert(offsets, off)
	end
	local bodyColor = if small then Color3.fromRGB(205, 210, 215) else Color3.fromRGB(236, 236, 230)
	-- body cylinder 1×1×5 (a cylinder's axis is X → turn it onto Z)
	add(fxPart(parent, "Body", Enum.PartType.Cylinder, Vector3.new(5 * k, 1 * k, 1 * k), bodyColor, Enum.Material.SmoothPlastic), CFrame.Angles(0, math.rad(90), 0))
	add(fxPart(parent, "Nose", Enum.PartType.Ball, Vector3.new(1, 1, 1) * k, if small then Color3.fromRGB(60, 140, 220) else Color3.fromRGB(180, 40, 30), Enum.Material.SmoothPlastic), CFrame.new(0, 0, -2.5 * k))
	if not small then
		local finColor = Color3.fromRGB(60, 66, 72)
		add(fxPart(parent, "Fin", Enum.PartType.Block, Vector3.new(0.9, 0.1, 1.0), finColor, Enum.Material.Metal), CFrame.new(0.7, 0, 2.0))
		add(fxPart(parent, "Fin", Enum.PartType.Block, Vector3.new(0.9, 0.1, 1.0), finColor, Enum.Material.Metal), CFrame.new(-0.7, 0, 2.0))
		add(fxPart(parent, "Fin", Enum.PartType.Block, Vector3.new(0.1, 0.9, 1.0), finColor, Enum.Material.Metal), CFrame.new(0, 0.7, 2.0))
		add(fxPart(parent, "Fin", Enum.PartType.Block, Vector3.new(0.1, 0.9, 1.0), finColor, Enum.Material.Metal), CFrame.new(0, -0.7, 2.0))
	end
	local glow = fxPart(parent, "TailGlow", Enum.PartType.Ball, Vector3.new(0.8, 0.8, 0.8) * k, if small then Color3.fromRGB(140, 210, 255) else Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
	add(glow, CFrame.new(0, 0, 2.7 * k))

	local a0 = Instance.new("Attachment")
	a0.Name = "TrailA"
	a0.Position = Vector3.new(0.35 * k, 0, 0)
	a0.Parent = glow
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailB"
	a1.Position = Vector3.new(-0.35 * k, 0, 0)
	a1.Parent = glow
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(Color3.fromRGB(150, 150, 150), Color3.fromRGB(255, 255, 255))
	trail.Lifetime = 1.2
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.WidthScale = NumberSequence.new(1, 3)
	trail.FaceCamera = true
	trail.Parent = glow
	table.insert(effects, trail)

	if not small then
		local smoke = Instance.new("ParticleEmitter")
		smoke.Name = "Smoke"
		smoke.Texture = SMOKE_TEXTURE
		smoke.Rate = 30
		smoke.Lifetime = NumberRange.new(1.5)
		smoke.Speed = NumberRange.new(1, 3)
		smoke.SpreadAngle = Vector2.new(8, 8)
		smoke.EmissionDirection = Enum.NormalId.Back
		smoke.Rotation = NumberRange.new(0, 360)
		smoke.RotSpeed = NumberRange.new(-30, 30)
		smoke.Color = ColorSequence.new(Color3.fromRGB(190, 190, 190), Color3.fromRGB(120, 120, 120))
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		smoke.Parent = glow
		table.insert(effects, smoke)
	end
	return parts, offsets, effects
end

local function place(parts: { BasePart }, offsets: { CFrame }, root: CFrame)
	for i, p in ipairs(parts) do
		p.CFrame = root * offsets[i]
	end
end

local function hideMissile(parts: { BasePart }, effects: { Instance })
	for _, p in ipairs(parts) do
		p.Transparency = 1
	end
	for _, e in ipairs(effects) do
		if e:IsA("Trail") then
			e.Enabled = false
		elseif e:IsA("ParticleEmitter") then
			e.Enabled = false
		end
	end
end

local cameraShakeUntil, cameraShakeDur, cameraShakeAmp = 0, 0.4, 0
local shakeBound = false
local function shakeCamera(duration: number, amp: number)
	cameraShakeUntil = os.clock() + duration
	cameraShakeDur = duration
	cameraShakeAmp = amp
	if shakeBound then
		return
	end
	local ok = pcall(function()
		RunService:BindToRenderStep("WE_MissileShake", Enum.RenderPriority.Camera.Value + 1, function()
			local left = cameraShakeUntil - os.clock()
			local cam = workspace.CurrentCamera
			if left <= 0 or not cam then
				shakeBound = false
				pcall(function()
					RunService:UnbindFromRenderStep("WE_MissileShake")
				end)
				return
			end
			local a = cameraShakeAmp * (left / cameraShakeDur)
			cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
		end)
	end)
	shakeBound = ok
end

local function cameraPos(): Vector3?
	local cam = workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position
	end
	return nil
end

local function burst(pos: Vector3, radius: number)
	local folder = fxFolder()
	local ex = Instance.new("Explosion")
	ex.BlastPressure = 0
	ex.DestroyJointRadiusPercent = 0
	ex.BlastRadius = radius
	ex.ExplosionType = Enum.ExplosionType.NoCraters
	ex.Position = pos
	ex.Parent = folder
	Debris:AddItem(ex, 2)

	local ball = fxPart(folder, "Blast", Enum.PartType.Ball, Vector3.new(2, 2, 2), Color3.fromRGB(255, 140, 40), Enum.Material.Neon)
	ball.CFrame = CFrame.new(pos)
	ball.Transparency = 0.2
	local grow = radius * 1.6
	TweenService:Create(ball, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(grow, grow, grow),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ball, 2)

	local cam = cameraPos()
	if cam and (cam - pos).Magnitude <= SHAKE_STUDS then
		shakeCamera(0.4, 0.8)
	end
end

local function destroyStrike(s: Strike)
	if s.Folder.Parent then
		s.Folder:Destroy()
	end
end

-- one frame of one strike; false = finished (remove it)
local function stepStrike(s: Strike, now: number): boolean
	if s.Exploded then
		if now >= s.DestroyAt then
			destroyStrike(s)
			return false
		end
		return true
	end
	local t = math.clamp((now - s.Launch) / s.Flight, 0, 1)
	if t >= s.EndT then
		local at = bezier(s, s.EndT)
		burst(at, if s.Intercepted then 14 else EXPLOSION_RADIUS)
		hideMissile(s.Parts, s.Effects)
		hideMissile(s.IParts, s.IEffects)
		s.Exploded = true
		s.DestroyAt = s.Launch + s.Flight * s.EndT + 2
		Debris:AddItem(s.Folder, 3) -- safety net; the render loop destroys it at +2 s
		return true
	end
	local pos = bezier(s, t)
	local dir = bezierDir(s, t)
	if dir.Magnitude < 1e-3 then
		dir = s.P2 - s.P0
	end
	place(s.Parts, s.Offsets, CFrame.lookAt(pos, pos + dir))

	local from = s.InterceptFrom
	if s.Intercepted and from then
		local meetAt = s.Launch + s.Flight * s.EndT
		local startAt = meetAt - INTERCEPTOR_SECONDS
		if now >= startAt then
			if #s.IParts == 0 then
				local ip, io, ie = buildMissile(s.Folder, true)
				s.IParts, s.IOffsets, s.IEffects = ip, io, ie
			end
			local target = bezier(s, s.EndT)
			local k = math.clamp((now - startAt) / INTERCEPTOR_SECONDS, 0, 1)
			local ipos = from:Lerp(target, k)
			local idir = target - from
			if idir.Magnitude < 1e-3 then
				idir = Vector3.new(0, 1, 0)
			end
			place(s.IParts, s.IOffsets, CFrame.lookAt(ipos, ipos + idir))
		end
	end
	return true
end

-- ── Victim / attacker alert (screen overlay) ────────────────────────────────
local function ensureAlertUi(): AlertUi?
	local existing = alertUi
	if existing and existing.Screen.Parent then
		return existing
	end
	local pg = getPlayerGui()
	if not pg then
		return nil
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = "WE_MissileAlert"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true -- the red edge hugs the real screen edge
	screen.DisplayOrder = 66 -- above the HUD (55) and panels (60), below toasts (70)
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local edges: { Frame } = {}
	local specs = {
		{ Name = "EdgeTop", Anchor = Vector2.new(0, 0), Pos = UDim2.fromScale(0, 0), Size = UDim2.new(1, 0, 0, 18) },
		{ Name = "EdgeBottom", Anchor = Vector2.new(0, 1), Pos = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 18) },
		{ Name = "EdgeLeft", Anchor = Vector2.new(0, 0), Pos = UDim2.new(0, 0, 0, 18), Size = UDim2.new(0, 18, 1, -36) },
		{ Name = "EdgeRight", Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, 0, 0, 18), Size = UDim2.new(0, 18, 1, -36) },
	}
	for _, e in ipairs(specs) do
		local f = Instance.new("Frame")
		f.Name = e.Name
		f.AnchorPoint = e.Anchor
		f.Position = e.Pos
		f.Size = e.Size
		f.BackgroundColor3 = Color3.fromRGB(230, 30, 30)
		f.BackgroundTransparency = 0.45
		f.BorderSizePixel = 0
		f.Active = false
		f.Visible = false
		f.Parent = screen
		table.insert(edges, f)
	end

	local banner = Instance.new("Frame")
	banner.Name = "Banner"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.fromScale(0.5, 0) -- Y: the top-centre stack
	banner.BorderSizePixel = 0
	banner.Active = false
	banner.Visible = false
	banner.Parent = screen
	UIUtil.Corner(banner, 10)
	local stroke = UIUtil.Stroke(banner, Color3.fromRGB(255, 120, 100), 2)

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(12, 0)
	label.Size = UDim2.new(1, -24, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.5
	label.Text = ""
	label.Parent = banner
	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 14
	limit.MaxTextSize = 22
	limit.Parent = label

	screen.Parent = pg
	local built: AlertUi = { Screen = screen, Edges = edges, Banner = banner, Label = label, Stroke = stroke }
	alertUi = built
	-- v70: first item of the top-centre stack (HudLayout writes Banner.Position.Y; X stays centred). Real px gui
	-- (IgnoreGuiInset, no UIScale) → Space "Screen"; everything below it (capture bar, tutorial, toasts, offer) moves down.
	HudLayout.RegisterTopStack("Alert", banner, HudConfig.TopStack.Order.Alert, { Space = "Screen" })
	return built
end

local function hideAlertUi()
	local au = alertUi
	if not au then
		return
	end
	au.Banner.Visible = false
	for _, e in ipairs(au.Edges) do
		e.Visible = false
	end
end

local function alertResultText(a: Alert): string
	if a.Role == "Victim" then
		if a.Outcome == "Intercepted" then
			return string.format("✓ Your Missile Defense shot down %s's missile", a.Other)
		end
		return string.format("💥 Missile hit! Defenses down %s — protect your ATM!", mmss(a.DownSeconds))
	end
	if a.Outcome == "Intercepted" then
		return string.format("Intercepted by %s's Missile Defense", a.Other)
	end
	return string.format("Direct hit! %s's defenses down %s — go raid!", a.Other, mmss(a.DownSeconds))
end

local function playSiren()
	local sfxOn = true
	pcall(function()
		sfxOn = ClientSettings.ShouldPlaySfx()
	end)
	if not sfxOn then
		return
	end
	local volume = 0.5 * AudioController.GetSfxVolume()
	local sound = Instance.new("Sound")
	sound.Name = "WE_MissileSiren"
	sound.SoundId = SIREN_ID
	sound.Volume = volume
	sound.Parent = SoundService
	task.spawn(function()
		for i = 1, 8 do -- 8 × 0.35 s = 2.8 s
			if not sound.Parent then
				break
			end
			sound.PlaybackSpeed = if i % 2 == 1 then 0.7 else 1.0
			sound.TimePosition = 0
			sound:Play()
			task.wait(0.35)
		end
		sound:Destroy()
	end)
end

local function startAlert(role: string, strikeId: number, launch: number, flight: number, endT: number, outcome: string, other: string, downSeconds: number)
	local current = alert
	if current and current.Role == "Victim" and role == "Attacker" and serverNow() < current.EndAt then
		return -- an incoming missile outranks our own launch banner
	end
	local resolveAt = launch + flight * endT
	alert = {
		Role = role :: string,
		StrikeId = strikeId,
		ImpactAt = launch + flight,
		ResolveAt = resolveAt,
		EndAt = resolveAt + ALERT_HOLD_SECONDS,
		Outcome = outcome,
		Other = other,
		DownSeconds = downSeconds,
	}
	local au = ensureAlertUi()
	if au then
		local w = guiArea()
		local victim = role == "Victim"
		-- v70: Y belongs to the top-centre stack (HudLayout.RegisterTopStack "Alert"); only X is set here
		au.Banner.Position = UDim2.new(0.5, 0, 0, au.Banner.Position.Y.Offset)
		au.Banner.Size = UDim2.fromOffset(math.max(200, math.min(if victim then 620 else 480, w - 32)), if victim then 50 else 38)
		au.Banner.BackgroundColor3 = if victim then Color3.fromRGB(128, 18, 16) else Color3.fromRGB(34, 38, 44)
		au.Stroke.Color = if victim then Color3.fromRGB(255, 120, 100) else C.Orange
		au.Label.Font = if victim then Enum.Font.GothamBlack else Enum.Font.GothamBold
		local limit = au.Label:FindFirstChildOfClass("UITextSizeConstraint")
		if limit then
			limit.MaxTextSize = if victim then 22 else 16
		end
		for _, e in ipairs(au.Edges) do
			e.Visible = false
		end
		HudLayout.RelayoutTopStack()
	end
	if role == "Victim" then
		playSiren()
	end
end

local function stepAlert(now: number)
	local a = alert
	if not a then
		return
	end
	if now >= a.EndAt then
		alert = nil
		hideAlertUi()
		return
	end
	local au = ensureAlertUi()
	if not au then
		return
	end
	local victim = a.Role == "Victim"
	au.Banner.Visible = victim or not isOpen -- the open panel already shows our own launch
	if now >= a.ResolveAt then
		for _, e in ipairs(au.Edges) do
			e.Visible = false
		end
		au.Label.Text = alertResultText(a)
		if a.Outcome == "Intercepted" then
			au.Banner.BackgroundColor3 = if victim then Color3.fromRGB(30, 96, 54) else Color3.fromRGB(110, 78, 20)
		else
			au.Banner.BackgroundColor3 = if victim then Color3.fromRGB(150, 28, 20) else Color3.fromRGB(30, 96, 54)
		end
		return
	end
	local secs = math.max(0, math.ceil(a.ImpactAt - now))
	if victim then
		au.Label.Text = string.format("⚠ INCOMING MISSILE from %s — impact %ds", a.Other, secs)
		local tr = 0.45 + 0.25 * math.sin(os.clock() * math.pi * 4) -- 2 Hz between 0.2 and 0.7
		for _, e in ipairs(au.Edges) do
			e.Visible = true
			e.BackgroundTransparency = tr
		end
	else
		au.Label.Text = string.format("🚀 Missile away → %s · %ds", a.Other, secs)
	end
end

-- ── MissileStrikeFx ─────────────────────────────────────────────────────────
local function onFx(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local from, to = payload.From, payload.To
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return
	end
	local id = tonumber(payload.StrikeId)
	local launch = tonumber(payload.LaunchTime)
	local flight = tonumber(payload.FlightSeconds)
	if id == nil or launch == nil or flight == nil or flight <= 0 or flight > 60 then
		return
	end
	if seenStrikeIds[id] then
		return
	end
	seenCount += 1
	if seenCount > 256 then
		seenStrikeIds = {}
		seenCount = 1
	end
	seenStrikeIds[id] = true

	local now = serverNow()
	if now > launch + flight + FX_LATE_SECONDS then
		return -- late joiner: it is already over
	end
	local intercepted = payload.Outcome == "Intercepted"
	local endT = if intercepted then math.clamp(num(payload.InterceptT, 0.8), 0.05, 1) else 1
	local interceptFrom: Vector3? = if typeof(payload.InterceptFrom) == "Vector3" then payload.InterceptFrom else nil
	if intercepted and not interceptFrom then
		interceptFrom = to + Vector3.new(0, 6, 0)
	end
	local me = player.UserId
	local isVictim = tonumber(payload.VictimUserId) == me
	local isAttacker = tonumber(payload.AttackerUserId) == me
	local attackerName = str(payload.AttackerName) or "an enemy"
	local victimName = str(payload.VictimName) or "the target"
	local downSeconds = math.max(0, num(payload.DownSeconds, 120))
	local outcome = if intercepted then "Intercepted" else "Hit"

	if isVictim then
		startAlert("Victim", id, launch, flight, endT, outcome, attackerName, downSeconds)
	elseif isAttacker then
		startAlert("Attacker", id, launch, flight, endT, outcome, victimName, downSeconds)
	end

	-- 3D: only near the camera, or when we are part of it; at most FX_MAX_ACTIVE at once
	local arc = math.clamp(num(payload.ArcHeight, 200), 0, 2000)
	local p1 = (from + to) / 2 + Vector3.new(0, arc, 0)
	local involved = isVictim or isAttacker
	if not involved then
		local cam = cameraPos()
		if not cam then
			return
		end
		local mid = from * 0.25 + p1 * 0.5 + to * 0.25
		if (cam - from).Magnitude > FX_CULL_STUDS and (cam - to).Magnitude > FX_CULL_STUDS and (cam - mid).Magnitude > FX_CULL_STUDS then
			return
		end
	end
	if #strikes >= FX_MAX_ACTIVE then
		local evict: number? = nil
		for i, s in ipairs(strikes) do
			if not s.Involved then
				evict = i
				break
			end
		end
		if evict == nil and involved then
			evict = 1
		end
		if evict == nil then
			return
		end
		destroyStrike(strikes[evict])
		table.remove(strikes, evict)
	end

	local folder = Instance.new("Folder")
	folder.Name = "Strike_" .. tostring(id)
	folder.Parent = fxFolder()
	local parts, offsets, effects = buildMissile(folder, false)
	local s: Strike = {
		Id = id,
		P0 = from,
		P1 = p1,
		P2 = to,
		Launch = launch,
		Flight = flight,
		EndT = endT,
		Intercepted = intercepted,
		InterceptFrom = interceptFrom,
		Involved = involved,
		Folder = folder,
		Parts = parts,
		Offsets = offsets,
		Effects = effects,
		IParts = {},
		IOffsets = {},
		IEffects = {},
		Exploded = false,
		DestroyAt = 0,
	}
	table.insert(strikes, s)
	stepStrike(s, now)
end

local function stepFx()
	if #strikes == 0 and alert == nil then
		return
	end
	local now = serverNow()
	for i = #strikes, 1, -1 do
		local s = strikes[i]
		if not stepStrike(s, now) then
			table.remove(strikes, i)
		end
	end
	stepAlert(now)
end

-- ── Public API ──────────────────────────────────────────────────────────────
function MissileController.Open(_tab: string?)
	local u = ensureUi()
	if not u then
		warn("[WAR EMPIRE] Missile panel: PlayerGui not ready")
		return
	end
	isOpen = true
	u.Panel.Visible = true
	applyLayout()
	renderAll()
	requestState()
end

function MissileController.Close()
	isOpen = false
	confirmUserId = nil
	local u = ui
	if u then
		u.Panel.Visible = false
	end
end

function MissileController.Toggle()
	if isOpen then
		MissileController.Close()
	else
		MissileController.Open()
	end
end

function MissileController.IsOpen(): boolean
	return isOpen
end

function MissileController.Init()
	if initDone then
		return
	end
	initDone = true

	Remotes.BindEvent(Constants.RemoteNames.MissileStrikeStateUpdate, function(payload: any)
		local ok, err = pcall(function()
			onState(payload)
		end)
		if not ok then
			warn("[WAR EMPIRE] Missile state update failed:", err)
		end
	end)
	Remotes.BindEvent(Constants.RemoteNames.MissileStrikeFx, function(payload: any)
		local ok, err = pcall(function()
			onFx(payload)
		end)
		if not ok then
			warn("[WAR EMPIRE] Missile FX failed:", err)
		end
	end)
	-- own structure levels → "needs Radar L2" hints on the locked requirement chips
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(payload: any)
		if typeof(payload) == "table" and typeof(payload.Upgrades) == "table" then
			local levels: { [string]: number } = {}
			for k, v in pairs(payload.Upgrades) do
				if typeof(k) == "string" and tonumber(v) then
					levels[k] = tonumber(v) :: number
				end
			end
			baseUpgrades = levels
		end
	end)

	local function fxError(err: any)
		if not fxWarned then
			fxWarned = true
			warn("[WAR EMPIRE] Missile FX step failed:", err)
		end
	end
	RunService.RenderStepped:Connect(function()
		xpcall(stepFx, fxError)
	end)

	-- 1 s ticker: live countdowns while open; State refresh every REFRESH_SECONDS
	task.spawn(function()
		while true do
			task.wait(1)
			if isOpen then
				local ok, err = pcall(function()
					renderStatus()
					renderRows()
					if os.clock() - lastStateReqAt >= REFRESH_SECONDS - 0.05 then
						requestState()
					end
				end)
				if not ok then
					warn("[WAR EMPIRE] Missile panel tick failed:", err)
				end
			end
		end
	end)
end

return MissileController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">MissionController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Phase 6 — Missions UI + daily reward claim.
	v70 "clean screen": the cash pill's SPIN chip moved here — a "FREE SUPPLY SPIN · CLAIM" row at the top of
	the panel (fires RequestClaimSpinner; SpinnerService decides). The rail's Missions badge counts completed-
	unclaimed missions + a claimable daily login + a READY spinner (HUDController). Opened from the rail's
	Missions tile / M (HudConfig.Keys.Missions) / the terminal. A registered Modal panel (HudLayout id "Missions")
	with the black dim; one HUD scale + safe area; every tappable ≥ 44 real px on touch. ]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)
local DailyRewardConfig = require(Shared.Configs.DailyRewardConfig)
local HudConfig = require(Shared.Configs.HudConfig)

local PanelShell = require(script.Parent.Parent.Modules.PanelShell)
local AudioController = require(script.Parent.Parent.Modules.AudioController)

local MissionController = {}

local PANEL_ID = "Missions"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local menuOpen = false
local screenGui: ScreenGui? = nil
local shell: PanelShell.Shell? = nil
local listFrame: ScrollingFrame? = nil
local dailyBtn: TextButton? = nil
local dailyInfo: TextLabel? = nil
local spinBtn: TextButton? = nil
local spinInfo: TextLabel? = nil
local state: Types.MissionStatePayload? = nil

-- spinner (SpinnerStateUpdate: Ready, CooldownRemaining seconds)
local spinnerReady = false
local spinnerReadyAt = 0 -- os.clock() when the cooldown ends
local spinnerKnown = false

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

-- UIUtil.EmptyState at the panel text floor (≥ 11 real px)
local function emptyState(parent: Instance, message: string)
	local lab = UIUtil.EmptyState(parent, message, 0)
	lab.TextSize = PanelShell.Text(14)
	lab.Size = UDim2.new(1, -8, 0, PanelShell.Text(14) * 3 + 8)
	lab.Font = Enum.Font.GothamMedium
end

local function fire(remoteName: string, ...: any)
	task.spawn(Remotes.FireServer, remoteName, ...)
end

local function formatWait(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	if s >= 3600 then
		return string.format("%dh %02dm", s // 3600, (s % 3600) // 60)
	elseif s >= 60 then
		return string.format("%dm", math.ceil(s / 60))
	end
	return string.format("%ds", s)
end

local function paintSpinner()
	local btn, info = spinBtn, spinInfo
	if not (btn and info) then
		return
	end
	local ready = spinnerReady or (spinnerKnown and os.clock() >= spinnerReadyAt)
	if ready then
		info.Text = "FREE SUPPLY SPIN · ready"
		info.TextColor3 = Constants.Colors.Gold
		btn.Text = "CLAIM"
		btn.BackgroundColor3 = Constants.Colors.Gold
		btn.TextColor3 = Color3.fromRGB(30, 30, 20)
		btn.AutoButtonColor = true
		btn:SetAttribute("WE_Disabled", false)
	else
		info.Text = if spinnerKnown
			then string.format("FREE SUPPLY SPIN · next in %s", formatWait(spinnerReadyAt - os.clock()))
			else "FREE SUPPLY SPIN · checking…"
		info.TextColor3 = Constants.Colors.Muted
		btn.Text = "WAIT"
		btn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
		btn.TextColor3 = Constants.Colors.Muted
		btn.AutoButtonColor = false
		btn:SetAttribute("WE_Disabled", true)
	end
end

local function refresh()
	if not listFrame then
		return
	end
	paintSpinner()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end
	if not state then
		emptyState(listFrame, "Loading missions… stand by for server sync.")
		return
	end
	local layout = listFrame:FindFirstChildOfClass("UIListLayout")
	if not layout then
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = listFrame
	end

	if #state.Daily == 0 then
		emptyState(listFrame, "No daily missions right now — check back after UTC midnight refresh.")
	end

	local TAP = PanelShell.TouchMinV()
	local titleSize = PanelShell.Text(14)
	local descSize = PanelShell.Text(11)
	local progSize = PanelShell.Text(11)
	local btnW = if isTouch then 120 else 88
	local rowH = math.max(TAP + 12, 6 + titleSize + 4 + descSize + 6 + progSize + 10)

	for i, mission in ipairs(state.Daily) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, rowH) -- v37 progress chip
		row.BackgroundColor3 = Constants.Colors.Background
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = listFrame
		corner(row, 8)

		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Position = UDim2.fromOffset(10, 6)
		title.Size = UDim2.new(1, -(btnW + 28), 0, titleSize + 2)
		title.Font = Enum.Font.GothamBold
		title.TextSize = titleSize
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.TextColor3 = Constants.Colors.Text
		title.TextTruncate = Enum.TextTruncate.AtEnd
		title.Text = mission.DisplayName
		title.Parent = row

		local desc = Instance.new("TextLabel")
		desc.BackgroundTransparency = 1
		desc.Position = UDim2.fromOffset(10, 6 + titleSize + 4)
		desc.Size = UDim2.new(1, -(btnW + 28), 0, descSize + 2)
		desc.Font = Enum.Font.GothamMedium
		desc.TextSize = descSize
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.TextColor3 = Constants.Colors.Muted
		desc.Text = mission.Description
		desc.TextTruncate = Enum.TextTruncate.AtEnd
		desc.Parent = row

		-- v37: progress chip bar + clearer reward copy
		local chipY = 6 + titleSize + 4 + descSize + 8
		local chipBg = Instance.new("Frame")
		chipBg.Name = "ProgressChip"
		chipBg.Position = UDim2.fromOffset(10, chipY + 2)
		chipBg.Size = UDim2.new(0.34, 0, 0, progSize - 2)
		chipBg.BackgroundColor3 = Color3.fromRGB(35, 40, 48)
		chipBg.BorderSizePixel = 0
		chipBg.Parent = row
		corner(chipBg, 4)
		local pct = 0
		if mission.Target > 0 then
			pct = math.clamp(mission.Progress / mission.Target, 0, 1)
		end
		local chipFill = Instance.new("Frame")
		chipFill.Size = UDim2.new(pct, 0, 1, 0)
		chipFill.BackgroundColor3 = if mission.Claimed then Constants.Colors.Muted elseif pct >= 1 then Constants.Colors.Cash else Constants.Colors.XP
		chipFill.BorderSizePixel = 0
		chipFill.Parent = chipBg
		corner(chipFill, 4)
		local prog = Instance.new("TextLabel")
		prog.BackgroundTransparency = 1
		prog.Position = UDim2.new(0.34, 18, 0, chipY - 1)
		prog.Size = UDim2.new(0.66, -(btnW + 46), 0, progSize + 4)
		prog.Font = Enum.Font.GothamBold
		prog.TextSize = progSize
		prog.TextXAlignment = Enum.TextXAlignment.Left
		prog.TextColor3 = Constants.Colors.Gold
		local goldBit = if (mission.RewardGold or 0) > 0 then string.format(" · %dg", mission.RewardGold) else ""
		prog.Text = string.format("%d/%d  ★ $%s + %dXP%s", mission.Progress, mission.Target, tostring(mission.RewardCash), mission.RewardXP, goldBit)
		prog.TextTruncate = Enum.TextTruncate.AtEnd
		prog.Parent = row

		local btn = Instance.new("TextButton")
		btn.AnchorPoint = Vector2.new(1, 0.5)
		btn.Position = UDim2.new(1, -8, 0.5, 0)
		btn.Size = UDim2.fromOffset(btnW, TAP)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = PanelShell.Text(13)
		btn.TextColor3 = Constants.Colors.Text
		btn.BorderSizePixel = 0
		corner(btn, 8)
		btn.Parent = row

		if mission.Claimed then
			btn.Text = "DONE"
			btn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
			btn.Active = false
		elseif mission.Complete then
			btn.Text = "CLAIM"
			btn.BackgroundColor3 = Constants.Colors.Accent
			local missionId = mission.Id
			btn.Activated:Connect(function()
				pcall(AudioController.PlayClick)
				fire(Constants.RemoteNames.RequestClaimMission, missionId)
			end)
		else
			btn.Text = "…"
			btn.BackgroundColor3 = Color3.fromRGB(45, 50, 55)
			btn.Active = false
		end
	end

	if dailyInfo and state.DailyLogin then
		local d = state.DailyLogin
		local reward = DailyRewardConfig.Rewards[d.NextDay]
		local rewardText = if reward then string.format("$%d", reward.Cash) else ""
		if d.AlreadyClaimedToday then
			dailyInfo.Text = string.format("Daily streak: Day %d (claimed)", d.Streak)
			if dailyBtn then
				dailyBtn.Text = "CLAIMED"
				dailyBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
				dailyBtn.Active = false
			end
		else
			dailyInfo.Text = string.format("Claim Day %d reward %s", d.NextDay, rewardText)
			if dailyBtn then
				dailyBtn.Text = "CLAIM DAILY"
				dailyBtn.BackgroundColor3 = Constants.Colors.Gold
				dailyBtn.TextColor3 = Color3.fromRGB(30, 30, 20)
				dailyBtn.Active = true
			end
		end
	end
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
	local sh = shell
	if sh then
		sh.Sync(open)
	end
	if open then
		refresh()
	end
end

-- a claim row (spinner / daily login): info text left, a TAP-tall button right
local function claimRow(parent: Instance, name: string, y: number, btnText: string): (Frame, TextLabel, TextButton)
	local TAP = PanelShell.TouchMinV()
	local row = Instance.new("Frame")
	row.Name = name
	row.Position = UDim2.fromOffset(12, y)
	row.Size = UDim2.new(1, -24, 0, TAP + 8)
	row.BackgroundColor3 = Constants.Colors.Background
	row.BorderSizePixel = 0
	corner(row, 8)
	row.Parent = parent

	local btnW = if isTouch then 150 else 120
	local info = Instance.new("TextLabel")
	info.BackgroundTransparency = 1
	info.Position = UDim2.fromOffset(12, 0)
	info.Size = UDim2.new(1, -(btnW + 28), 1, 0)
	info.Font = Enum.Font.GothamBold
	info.TextSize = PanelShell.Text(14)
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextTruncate = Enum.TextTruncate.AtEnd
	info.TextColor3 = Constants.Colors.Text
	info.Parent = row

	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(1, 0.5)
	b.Position = UDim2.new(1, -4, 0.5, 0)
	b.Size = UDim2.fromOffset(btnW, TAP)
	b.Font = Enum.Font.GothamBold
	b.TextSize = PanelShell.Text(13)
	b.Text = btnText
	b.TextColor3 = Color3.fromRGB(30, 30, 20)
	b.BackgroundColor3 = Constants.Colors.Gold
	b.BorderSizePixel = 0
	b.Active = true
	corner(b, 8)
	b.Parent = row
	return row, info, b
end

function MissionController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireMissions"
	PanelShell.Screen(screen) -- DisplayOrder 60 (Panels), one HUD scale + safe area
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.94, 0, 1, -16) else UDim2.fromOffset(480, 520)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = screen
	corner(panel, 12)
	do
		local cap = Instance.new("UISizeConstraint")
		cap.MaxSize = if isTouch then Vector2.new(820, 620) else Vector2.new(480, 520)
		cap.Parent = panel
	end

	PanelShell.Title(panel, "Daily Missions")
	PanelShell.CloseButton(panel, function()
		setOpen(false)
	end)

	local y = TAP + 8
	-- v70: FREE SUPPLY SPIN (was the SPIN chip on the cash pill)
	local _, sInfo, sBtn = claimRow(panel, "SpinnerRow", y, "CLAIM")
	spinInfo = sInfo
	spinBtn = sBtn
	sBtn.Activated:Connect(function()
		if sBtn:GetAttribute("WE_Disabled") == true then
			return
		end
		pcall(AudioController.PlayClick)
		fire(Constants.RemoteNames.RequestClaimSpinner)
	end)
	y += TAP + 8 + 6

	local _, dInfo, dBtn = claimRow(panel, "DailyRow", y, "CLAIM DAILY")
	dInfo.Text = "Daily reward"
	dInfo.Font = Enum.Font.GothamMedium
	dailyInfo = dInfo
	dailyBtn = dBtn
	dBtn.Activated:Connect(function()
		pcall(AudioController.PlayClick)
		fire(Constants.RemoteNames.RequestClaimDailyReward)
	end)
	y += TAP + 8 + 8

	local list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.Position = UDim2.fromOffset(12, y)
	list.Size = UDim2.new(1, -24, 1, -(y + 12))
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = if isTouch then 6 else 4
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel
	listFrame = list

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return menuOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})

	Remotes.BindEvent(Constants.RemoteNames.MissionStateUpdate, function(payload: Types.MissionStatePayload)
		if typeof(payload) ~= "table" then
			return
		end
		state = payload
		if menuOpen then
			refresh()
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.SpinnerStateUpdate, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		spinnerKnown = true
		spinnerReady = payload.Ready == true
		spinnerReadyAt = os.clock() + math.max(0, tonumber(payload.CooldownRemaining) or 0)
		paintSpinner()
	end)
	paintSpinner()

	-- countdown on the spinner row while the panel is open (repaints text only)
	task.spawn(function()
		while true do
			task.wait(1)
			if menuOpen and spinnerKnown and not spinnerReady then
				paintSpinner()
			end
		end
	end)

	local missionsKey: Enum.KeyCode = HudConfig.Keys.Missions or Enum.KeyCode.M
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == missionsKey then
			setOpen(not menuOpen)
		end
	end)
end

function MissionController.Toggle()
	local sh = shell
	if not menuOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not menuOpen)
end

function MissionController.Open()
	setOpen(true)
end

function MissionController.Close()
	setOpen(false)
end

function MissionController.IsOpen(): boolean
	return menuOpen
end

return MissionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	NotificationController — v70 "clean screen" toast lane + offer toast + the base-alert slot.

	LANE (HudConfig.Toast, spec §4.1): plain outlined FredokaOne text in the top-centre stack (TopStack "Toasts"),
	no cards. Max 2 lines (newest at the bottom; a 3rd evicts the oldest of the lowest priority), the same key
	(digits stripped) within 3 s updates the line to "Text ×N" and restarts its timer. Only Success / Error /
	Warn / Reward play a sound (≤ 1 per 0.4 s). Type "Collect" never makes a line: it becomes the "+$N" cash float
	at the pill (HudLayout.CashFloat → HUDController).

	ROUTING (client side of spec §4.2; the server fixes are deferred, so TODAY's server lines are handled here):
	NotificationConfig.Rewrite → HudConfig.Toast.Reroute → HudConfig.Toast.Drop → NotificationConfig.Throttle →
	purchase-failure echo dedupe (one failed buy = one line) → lane.

	OFFER (spec §4.3): NotificationController.ShowOffer({Key, Title, Sub?, Cta, OnGet}) → one gold offer pill
	under the toasts (TopStack "Offer") for HudConfig.Offer.HoldSeconds. Throttle (owner decision, money plan D8):
	first ≥ FirstAfterJoinSeconds after join, ≥ MinGapSeconds apart, ≤ MaxPerSession per session, the death offer
	≥ DeathOfferMinGapSeconds apart. Deferred while Drawn / RecentCombat / Driving / Modal / Tutorial; a deferred
	offer that never found a calm moment is dropped after DropAfterQueuedSeconds and lights the Shop badge "!".
	OnGet is the caller's existing promptDevProduct / promptGamePass call — this file never grants anything.

	P0 marker: Purchase SUCCESSFUL lines keep the green Success type (HIGH_CONTRAST_SUCCESS below).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local NotificationConfig = require(Shared.Configs.NotificationConfig)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)

local AudioController = require(script.Parent.Parent.Modules.AudioController)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)

local NotificationController = {}

export type OfferDef = {
	Key: string,
	Title: string,
	Sub: string?,
	Cta: string,
	OnGet: () -> (),
}

local player = Players.LocalPlayer

-- Marker for BuyPathStatic / QA: the Purchase SUCCESSFUL line keeps the Success type (green, sound, 1.8 s)
local HIGH_CONTRAST_SUCCESS = true

local TOAST = HudConfig.Toast
local OFFER = HudConfig.Offer
local COLORS = HudConfig.Colors
local FONT_DISPLAY = HudConfig.Fonts.Display
local FONT_BODY = HudConfig.Fonts.Body

---------------------------------------------------------------------------------------------------------------
-- state
---------------------------------------------------------------------------------------------------------------

type Line = {
	Label: TextLabel,
	Stroke: UIStroke,
	Pop: UIScale,
	Key: string,
	Type: string,
	Text: string,
	Count: number,
	Seq: number,
	UpdatedAt: number,
	Token: number,
	Dying: boolean,
}

type OfferEntry = {
	Def: OfferDef,
	Death: boolean,
	EligibleAt: number,
	QueuedAt: number,
}

local gui: ScreenGui? = nil
local lane: Frame? = nil
local laneList: UIListLayout? = nil
local lines: { Line } = {}
local lineSeq = 0
local lastSoundAt = -math.huge

local rerouteAt: { [number]: number } = {}
local throttleAt: { [number]: number } = {}
local throttleTexts: { [string]: boolean } = {}
local lastPurchaseFailureAt = -math.huge

local alertFrame: Frame? = nil
local alertLabel: TextLabel? = nil
local alertToken = 0

local offerFrame: Frame? = nil
local offerQueue: { OfferEntry } = {}
local offerShowing: OfferEntry? = nil
local offerToken = 0
local offersShown = 0
local lastOfferAt = -math.huge
local lastDeathOfferAt = -math.huge
local joinClock = os.clock()

---------------------------------------------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------------------------------------------

local function isTouch(): boolean
	return HudLayout.IsTouch()
end

local function laneTextSize(): number
	return if isTouch() then TOAST.TextSize else TOAST.TextSizeDesktop
end

local function laneMaxWidth(): number
	local w = HudLayout.TopStackMaxWidthV()
	if w ~= w or w <= 0 then
		return 600
	end
	return math.floor(w)
end

-- text box in v at `size` (wrapped to maxW); falls back to an estimate when TextService is unavailable
local function measure(text: string, size: number, font: Enum.Font, maxW: number): Vector2
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, size, font, Vector2.new(maxW, 10000))
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return v
	end
	local w = (utf8.len(text) or #text) * size * 0.55
	return Vector2.new(math.min(w, maxW), size * math.max(1, math.ceil(w / math.max(1, maxW))))
end

local function typeDef(notifType: string): { Color: Color3?, Hold: number?, Sound: boolean? }
	local t = (TOAST.Types :: any)[notifType]
	if type(t) ~= "table" or t.Color == nil then
		t = TOAST.Types.Info
	end
	return t
end

local function normType(notifType: any): string
	local t = if type(notifType) == "string" then notifType else "Info"
	if (TOAST.Types :: any)[t] == nil then
		return "Info"
	end
	return t
end

local function playSound(notifType: string)
	local def = typeDef(notifType)
	if def.Sound ~= true then
		return
	end
	local now = os.clock()
	if now - lastSoundAt < TOAST.SoundMinGap then
		return
	end
	lastSoundAt = now
	pcall(AudioController.PlayNotification)
end

-- first "$1,234" in a message → 1234 (nil when there is none)
local function parseAmount(message: string): number?
	local digits = string.match(message, "%$([%d,]+)")
	if not digits then
		return nil
	end
	local n = tonumber((string.gsub(digits, ",", "")))
	if n == nil or n ~= n or n <= 0 then
		return nil
	end
	-- "−$5,000" / "-$5,000" spends
	local before = string.match(message, "(.)%$[%d,]+")
	if before == "-" or string.find(message, "−%$" .. digits, 1, false) then
		return -n
	end
	return n
end

local function tween(inst: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local ok, tw = pcall(function()
		return TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	end)
	if ok and tw then
		tw:Play()
	end
end

---------------------------------------------------------------------------------------------------------------
-- lane
---------------------------------------------------------------------------------------------------------------

local function relayoutLane()
	local l = lane
	if not l then
		return
	end
	local maxW = laneMaxWidth()
	local total = 0
	local n = 0
	for _, line in ipairs(lines) do
		if line.Label.Parent == l then
			if n > 0 then
				total += TOAST.LineGap
			end
			total += line.Label.Size.Y.Offset
			n += 1
		end
	end
	l.Size = UDim2.fromOffset(maxW, total)
	l.Visible = n > 0
	-- the headless sim never fires AbsoluteSize changes; Roblox would, this keeps both exact
	HudLayout.RelayoutTopStack()
end

local function sizeLine(line: Line)
	local size = laneTextSize()
	local maxW = laneMaxWidth()
	local padX, padY = NotificationConfig.LinePadX, NotificationConfig.LinePadY
	local b = measure(line.Label.Text, size, FONT_DISPLAY, maxW - padX * 2)
	line.Label.TextSize = size
	line.Label.Size = UDim2.fromOffset(math.min(maxW, math.ceil(b.X) + padX * 2), math.ceil(b.Y) + padY * 2)
end

local function removeLine(line: Line, instant: boolean)
	if line.Dying and not instant then
		return
	end
	line.Dying = true
	line.Token += 1
	local idx = table.find(lines, line)
	if instant then
		if idx then
			table.remove(lines, idx)
		end
		line.Label:Destroy()
		relayoutLane()
		return
	end
	local my = line.Token
	tween(line.Label, TOAST.FadeOut, { TextTransparency = 1 })
	tween(line.Stroke, TOAST.FadeOut, { Transparency = 1 })
	task.delay(TOAST.FadeOut, function()
		if line.Token ~= my then
			return
		end
		local i = table.find(lines, line)
		if i then
			table.remove(lines, i)
		end
		line.Label:Destroy()
		relayoutLane()
	end)
end

local function arm(line: Line, hold: number)
	line.Token += 1
	local my = line.Token
	task.delay(hold, function()
		if line.Token == my and not line.Dying then
			removeLine(line, false)
		end
	end)
end

local function holdFor(notifType: string, duration: number?): number
	local base = typeDef(notifType).Hold or 2
	local want = if type(duration) == "number" and duration == duration then duration else base
	return math.clamp(want, NotificationConfig.MinHoldSeconds, math.max(base, NotificationConfig.MaxHoldSeconds))
end

local function coalesceKey(text: string, notifType: string): string
	if TOAST.CoalesceKey == "StripDigits" then
		return notifType .. "|" .. (string.gsub(text, "%d", ""))
	end
	return notifType .. "|" .. text
end

local function priorityOf(notifType: string): number
	return tonumber((NotificationConfig.Priority :: any)[notifType]) or 1
end

local function evictOne()
	-- lowest priority first, oldest among equals; lines already fading out go first of all
	local victim: Line? = nil
	for _, line in ipairs(lines) do
		if line.Dying then
			victim = line
			break
		end
		local v = victim
		if v == nil or priorityOf(line.Type) < priorityOf(v.Type) or (priorityOf(line.Type) == priorityOf(v.Type) and line.Seq < v.Seq) then
			victim = line
		end
	end
	if victim then
		removeLine(victim, true)
	end
end

local function laneShow(text: string, notifType: string, duration: number?)
	local l = lane
	if not l then
		return
	end
	local now = os.clock()
	local key = coalesceKey(text, notifType)
	local hold = holdFor(notifType, duration)

	-- coalesce: same key still on screen within the window → "Text ×N", timer restarts
	for _, line in ipairs(lines) do
		if not line.Dying and line.Key == key and now - line.UpdatedAt <= TOAST.CoalesceWindow then
			line.Count += 1
			line.UpdatedAt = now
			line.Text = text
			line.Label.Text = text .. string.format(NotificationConfig.CoalesceSuffix, line.Count)
			sizeLine(line)
			line.Pop.Scale = 1.08
			tween(line.Pop, 0.12, { Scale = 1 })
			relayoutLane()
			arm(line, hold)
			playSound(notifType)
			return
		end
	end

	while #lines >= TOAST.MaxVisible do
		evictOne()
	end

	local def = typeDef(notifType)
	lineSeq += 1
	local label = Instance.new("TextLabel")
	label.Name = "Line"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Active = false
	label.Font = FONT_DISPLAY
	label.TextSize = laneTextSize()
	label.TextColor3 = def.Color or COLORS.Info
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Text = text
	label.LayoutOrder = lineSeq
	label.TextTransparency = 1
	local stroke = UIUtil.TextOutline(label, TOAST.StrokePx, COLORS.Ink, 1)
	local pop = Instance.new("UIScale")
	pop.Name = "Pop"
	pop.Scale = TOAST.PopFrom
	pop.Parent = label

	local line: Line = {
		Label = label,
		Stroke = stroke,
		Pop = pop,
		Key = key,
		Type = notifType,
		Text = text,
		Count = 1,
		Seq = lineSeq,
		UpdatedAt = now,
		Token = 0,
		Dying = false,
	}
	sizeLine(line)
	label.Parent = l
	table.insert(lines, line)
	relayoutLane()

	tween(label, TOAST.FadeIn, { TextTransparency = 0 })
	tween(stroke, TOAST.FadeIn, { Transparency = 0 })
	tween(pop, 0.14, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	arm(line, hold)
	playSound(notifType)
end

---------------------------------------------------------------------------------------------------------------
-- alert slot ("BASE UNDER ATTACK!" — TopStack "BaseAlert", same order as the missile alert)
---------------------------------------------------------------------------------------------------------------

-- an Alert is up (BASE UNDER ATTACK here, INCOMING MISSILE in WE_MissileAlert): no Robux offer during an attack,
-- and the stack stays short enough to keep clear of the bottom-right reserve on phones
local function alertVisible(): boolean
	local f = alertFrame
	if f and f.Visible then
		return true
	end
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local missile = pg and pg:FindFirstChild("WE_MissileAlert")
	local banner = missile and missile:FindFirstChild("Banner")
	return banner ~= nil and banner:IsA("GuiObject") and banner.Visible and (missile :: ScreenGui).Enabled
end

--[[ Light the top-centre Alert slot for `seconds` with a red banner (Warn sound). ]]
function NotificationController.ShowAlert(text: string, seconds: number?)
	local f, lab = alertFrame, alertLabel
	if not (f and lab) then
		return
	end
	local size = if isTouch() then 22 else 24
	local b = measure(text, size, FONT_DISPLAY, laneMaxWidth() - 40)
	lab.TextSize = size
	lab.Text = text
	f.Size = UDim2.fromOffset(math.min(laneMaxWidth(), math.ceil(b.X) + 40), 44)
	f.Visible = true
	if offerFrame then
		HudLayout.RefreshVisibility(offerFrame)
	end
	HudLayout.RelayoutTopStack()
	playSound("Warn")
	alertToken += 1
	local my = alertToken
	task.delay(seconds or 4, function()
		if alertToken == my and f.Parent then
			f.Visible = false
			if offerFrame then
				HudLayout.RefreshVisibility(offerFrame)
			end
			HudLayout.RelayoutTopStack()
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- routing
---------------------------------------------------------------------------------------------------------------

local function isPurchaseFailureText(text: string): boolean
	for _, pat in ipairs(NotificationConfig.PurchaseFailure.Patterns) do
		if string.find(text, pat) then
			return true
		end
	end
	return false
end

-- true = the line may show (and stamps the window); false = an echo of a failure already on screen
local function passPurchaseFailureGate(): boolean
	local now = os.clock()
	if now - lastPurchaseFailureAt < NotificationConfig.PurchaseFailure.WindowSeconds then
		return false
	end
	lastPurchaseFailureAt = now
	return true
end

local function dropped(text: string, fromServer: boolean): boolean
	for _, pat in ipairs(TOAST.Drop) do
		if string.find(text, pat) then
			if fromServer or not table.find(NotificationConfig.LocalExemptDrop, pat) then
				return true
			end
		end
	end
	return false
end

local function throttled(text: string): boolean
	local now = os.clock()
	for i, rule in ipairs(NotificationConfig.Throttle) do
		if string.find(text, rule.Match) then
			if rule.OncePerText then
				if throttleTexts[text] then
					return true
				end
				throttleTexts[text] = true
			end
			local gap = rule.MinGapSeconds
			if gap then
				if now - (throttleAt[i] or -math.huge) < gap then
					return true
				end
				throttleAt[i] = now
			end
			return false
		end
	end
	return false
end

-- returns (handled, text, type): handled = a Reroute rule took the message (floats / alert done here)
local function reroute(text: string, notifType: string, amount: number?): (boolean, string?, string)
	local now = os.clock()
	for i, rule in ipairs(TOAST.Reroute) do
		if string.find(text, rule.Match) then
			local gap = rule.MinGapSeconds
			if gap and now - (rerouteAt[i] or -math.huge) < gap then
				return true, nil, notifType
			end
			rerouteAt[i] = now
			if rule.Float then
				local amt = amount or parseAmount(text)
				if amt then
					HudLayout.CashFloat(amt)
				end
			end
			local show: string? = nil
			if rule.Show == "%STRIP%" then
				show = if rule.Strip then (string.gsub(text, rule.Strip, "")) else text
			elseif rule.Show and rule.Show ~= "" then
				show = rule.Show
			end
			local t = normType(rule.Type or notifType)
			local alertSecs = rule.AlertSeconds
			if show and alertSecs and alertSecs > 0 and alertFrame then
				NotificationController.ShowAlert(show, alertSecs)
				return true, nil, t -- the Alert slot IS the warning (no duplicate lane line)
			end
			return true, show, t
		end
	end
	return false, text, notifType
end

local function route(message: any, notifType: any, duration: any, amount: any, fromServer: boolean, isPurchaseFailure: boolean?): boolean
	local text = if type(message) == "string" then message else tostring(message or "")
	if text == "" then
		return false
	end
	local t = if type(notifType) == "string" then notifType else "Info"
	local dur: number? = if type(duration) == "number" then duration else nil
	local amt: number? = if type(amount) == "number" and amount == amount then amount else nil

	-- 1. rewrite
	for _, rule in ipairs(NotificationConfig.Rewrite) do
		if string.find(text, rule.Match) then
			if rule.Replace then
				text = (string.gsub(text, rule.Match, rule.Replace, 1))
			end
			if rule.Type then
				t = rule.Type
			end
			break
		end
	end

	-- the Alert banner already says it (strike results under the INCOMING MISSILE banner)
	if fromServer and alertVisible() then
		for _, pat in ipairs(NotificationConfig.AlertEcho) do
			if string.find(text, pat) then
				return false
			end
		end
	end

	-- Collect: never a lane line (spec §3.3 source rule) → "+$N" at the pill
	if t == "Collect" then
		local a = amt or parseAmount(text)
		if a then
			HudLayout.CashFloat(a)
		end
		return false
	end

	-- 2. reroute (today's server lines)
	local handled, show, rt = reroute(text, t, amt)
	if handled then
		if not show then
			return false
		end
		text, t = show, rt
	end

	-- 3. drop
	if dropped(text, fromServer) then
		return false
	end

	-- 4. throttle
	if throttled(text) then
		return false
	end

	-- 5. one failed purchase = one line
	if TOAST.DedupePurchaseFailure and (isPurchaseFailure or isPurchaseFailureText(text)) then
		if not passPurchaseFailureGate() then
			return false
		end
	end

	laneShow(text, normType(t), dur)
	return true
end

---------------------------------------------------------------------------------------------------------------
-- offer toast
---------------------------------------------------------------------------------------------------------------

local offerTitle: TextLabel? = nil
local offerSub: TextLabel? = nil
local offerGet: TextButton? = nil
local offerGetFace: Frame? = nil
local offerGetLabel: TextLabel? = nil
local offerClose: TextButton? = nil
local offerIcon: Frame? = nil

local function offerDeferred(): boolean
	local rule = { HideWhen = table.clone(OFFER.DeferWhen) }
	table.insert(rule.HideWhen, "Dead")
	return not HudLayout.EvalRule(rule) or alertVisible()
end

local function touchMinV(): number
	local s = HudLayout.Scale()
	if s <= 0 then
		return 64
	end
	return math.ceil(HudConfig.Scale.TouchMinPx / s)
end

local function layoutOffer(def: OfferDef)
	local f = offerFrame
	local title, sub, get, face, getLab, close, icon = offerTitle, offerSub, offerGet, offerGetFace, offerGetLabel, offerClose, offerIcon
	if not (f and title and sub and get and face and getLab and close and icon) then
		return
	end
	local touch = isTouch()
	local h = if touch then OFFER.Height else OFFER.HeightDesktop
	local padL, padR, gap = 10, 6, 10
	local iconSize = NotificationConfig.Offer.IconSize
	local maxW = math.min(OFFER.MaxWidth + (if touch then NotificationConfig.Offer.TouchExtraWidth else 0), laneMaxWidth())

	title.Text = def.Title
	sub.Text = def.Sub or ""
	sub.Visible = def.Sub ~= nil and def.Sub ~= ""
	getLab.Text = if def.Cta ~= "" then def.Cta else NotificationConfig.Offer.GetText

	local ctaB = measure(getLab.Text, OFFER.CtaSize, FONT_DISPLAY, 400)
	local faceW = math.ceil(ctaB.X) + 28
	local hitH = if touch then math.max(OFFER.GetHit, touchMinV()) else h
	local closeW = if touch then math.max(OFFER.CloseHit, touchMinV()) else OFFER.CloseHit
	local closeH = if touch then math.max(OFFER.CloseHit, touchMinV()) else h

	local fixed = padL + iconSize.X + gap + gap + faceW + 4 + closeW + padR
	local textMax = math.max(60, maxW - fixed)
	local tb = measure(def.Title, OFFER.TitleSize, FONT_DISPLAY, textMax)
	local sb = if sub.Visible then measure(sub.Text, OFFER.SubSize, FONT_BODY, textMax) else Vector2.zero
	-- 8 % slack: GetTextSize measures the glyphs, the UIStroke outline and font fallbacks draw a little wider
	local textW = math.min(textMax, math.ceil(math.max(tb.X, sb.X) * 1.08))
	local w = math.min(maxW, fixed + textW)

	f.Size = UDim2.fromOffset(w, h)
	icon.Position = UDim2.new(0, padL, 0.5, 0)
	local textX = padL + iconSize.X + gap
	local titleH = OFFER.TitleSize + 2
	local subH = OFFER.SubSize + 2
	if sub.Visible then
		local top = math.floor((h - titleH - subH) / 2)
		title.Position = UDim2.fromOffset(textX, top)
		sub.Position = UDim2.fromOffset(textX, top + titleH)
	else
		title.Position = UDim2.fromOffset(textX, math.floor((h - titleH) / 2))
	end
	title.Size = UDim2.fromOffset(textW, titleH)
	sub.Size = UDim2.fromOffset(textW, subH)

	get.Size = UDim2.fromOffset(faceW, hitH)
	get.Position = UDim2.new(0, textX + textW + gap, 0.5, 0)
	face.Size = UDim2.new(1, 0, 0, h - 12)
	close.Size = UDim2.fromOffset(closeW, closeH)
	close.Position = UDim2.new(1, 0, 0.5, 0)
end

local function hideOffer()
	offerShowing = nil
	offerToken += 1
	local f = offerFrame
	if f then
		HudLayout.RefreshVisibility(f)
		HudLayout.RelayoutTopStack()
	end
end

local function presentOffer(entry: OfferEntry)
	local now = os.clock()
	offerShowing = entry
	offersShown += 1
	lastOfferAt = now
	if entry.Death then
		lastDeathOfferAt = now
	end
	layoutOffer(entry.Def)
	local f = offerFrame
	if f then
		HudLayout.RefreshVisibility(f)
		HudLayout.RelayoutTopStack()
		local pop = f:FindFirstChild("Pop")
		if pop and pop:IsA("UIScale") then
			pop.Scale = TOAST.PopFrom
			tween(pop, 0.16, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end
	playSound("Reward")
	offerToken += 1
	local my = offerToken
	task.delay(OFFER.HoldSeconds, function()
		if offerToken == my and offerShowing == entry then
			hideOffer()
		end
	end)
end

-- the time-based throttle (session cap, gap, death gap); nil = allowed, else the reason
local function offerBlockedReason(entry: OfferEntry, now: number): string?
	if offersShown >= OFFER.MaxPerSession then
		return "SessionCap"
	end
	if now - lastOfferAt < OFFER.MinGapSeconds then
		return "MinGap"
	end
	if entry.Death and now - lastDeathOfferAt < OFFER.DeathOfferMinGapSeconds then
		return "DeathGap"
	end
	return nil
end

local function pumpOffers()
	local now = os.clock()
	-- expire: a deferred offer that never found a calm moment → dropped, Shop badge "!" (spec §4.3)
	local i = 1
	while i <= #offerQueue do
		local e = offerQueue[i]
		if now > e.EligibleAt + OFFER.DropAfterQueuedSeconds then
			table.remove(offerQueue, i)
			if OFFER.ShopBadgeWhenDropped and offerBlockedReason(e, now) == nil then
				HudLayout.SetBadge("Shop", "!")
			end
		else
			i += 1
		end
	end
	local of = offerFrame
	if of and offerShowing then
		local before = of.Visible
		HudLayout.RefreshVisibility(of)
		if of.Visible ~= before then
			HudLayout.RelayoutTopStack()
		end
	end
	if offerShowing or #offerQueue == 0 or offerDeferred() then
		return
	end
	local j = 1
	while j <= #offerQueue do
		local e = offerQueue[j]
		if e.EligibleAt <= now then
			local why = offerBlockedReason(e, now)
			table.remove(offerQueue, j)
			if why == nil then
				presentOffer(e)
				return
			end
			-- throttled while it waited (another offer won the slot): silently gone
		else
			j += 1
		end
	end
end

--[[
	Show one Robux offer toast: def = {Key, Title, Sub?, Cta, OnGet}. OnGet runs the caller's own
	promptDevProduct / promptGamePass (the purchase stays server-verified). Returns true when the offer is
	showing or queued for a calm moment, false when the throttle refused it (session cap, gap, death gap).
]]
function NotificationController.ShowOffer(def: OfferDef): boolean
	if type(def) ~= "table" or type(def.Key) ~= "string" or type(def.Title) ~= "string" or type(def.OnGet) ~= "function" then
		warn("[NotificationController] ShowOffer: bad def")
		return false
	end
	local cur = offerShowing
	if cur and cur.Def.Key == def.Key then
		return true
	end
	for _, e in ipairs(offerQueue) do
		if e.Def.Key == def.Key then
			e.Def = def -- newest copy wins (price / text refresh)
			return true
		end
	end
	local now = os.clock()
	local entry: OfferEntry = {
		Def = def,
		Death = string.find(def.Key, NotificationConfig.Offer.DeathKeyPattern) ~= nil,
		EligibleAt = math.max(now, joinClock + OFFER.FirstAfterJoinSeconds),
		QueuedAt = now,
	}
	if offerBlockedReason(entry, now) ~= nil then
		return false
	end
	if not offerFrame then
		return false
	end
	if entry.EligibleAt <= now and not offerShowing and not offerDeferred() then
		presentOffer(entry)
		return true
	end
	if cur then
		return false -- one at a time; a second offer inside the gap would be refused anyway
	end
	while #offerQueue >= NotificationConfig.Offer.QueueMax do
		table.remove(offerQueue, 1)
	end
	table.insert(offerQueue, entry)
	return true
end

function NotificationController.IsOfferShowing(): boolean
	return offerShowing ~= nil
end

---------------------------------------------------------------------------------------------------------------
-- build
---------------------------------------------------------------------------------------------------------------

local function buildOffer(screen: ScreenGui)
	local touch = isTouch()
	local h = if touch then OFFER.Height else OFFER.HeightDesktop
	local f = Instance.new("Frame")
	f.Name = "Offer"
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Position = UDim2.new(0.5, 0, 0, 0)
	f.Size = UDim2.fromOffset(300, h)
	f.BackgroundColor3 = OFFER.Bg
	f.BackgroundTransparency = OFFER.BgTransparency
	f.BorderSizePixel = 0
	f.Active = false
	f.Visible = false
	f.ZIndex = 5
	f.Parent = screen
	UIUtil.Corner(f, 14)
	local stroke = UIUtil.Stroke(f, OFFER.Stroke, 2)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local pop = Instance.new("UIScale")
	pop.Name = "Pop"
	pop.Parent = f

	local iconSize = NotificationConfig.Offer.IconSize
	local icon = HudIcons.Make("Cash", f, {
		Name = "Icon",
		Size = UDim2.fromOffset(iconSize.X, iconSize.Y),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		ZIndex = 6,
		Fill = OFFER.Bg,
	})

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Font = FONT_DISPLAY
	title.TextSize = OFFER.TitleSize
	title.TextColor3 = COLORS.Gold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.ZIndex = 6
	title.Parent = f
	UIUtil.TextOutline(title, 1.4)

	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Font = FONT_BODY
	sub.TextSize = OFFER.SubSize
	sub.TextColor3 = COLORS.White
	sub.TextTransparency = 0.25
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.TextTruncate = Enum.TextTruncate.AtEnd
	sub.ZIndex = 6
	sub.Parent = f

	-- GET: transparent ≥ 44 px hit area around a green face (spec: 64 v hit)
	local get = Instance.new("TextButton")
	get.Name = "Get"
	get.AnchorPoint = Vector2.new(0, 0.5)
	get.BackgroundTransparency = 1
	get.Text = ""
	get.AutoButtonColor = false
	get.Active = true
	get.Selectable = true
	get.ZIndex = 7
	get.Parent = f
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.BackgroundColor3 = COLORS.PlusGreen
	face.BorderSizePixel = 0
	face.Active = false
	face.ZIndex = 7
	face.Parent = get
	UIUtil.Corner(face, 10)
	local faceStroke = UIUtil.Stroke(face, COLORS.PlusGreenStroke, 2)
	faceStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local getLab = Instance.new("TextLabel")
	getLab.Name = "Cta"
	getLab.BackgroundTransparency = 1
	getLab.Size = UDim2.fromScale(1, 1)
	getLab.Font = FONT_DISPLAY
	getLab.TextSize = OFFER.CtaSize
	getLab.TextColor3 = COLORS.White
	getLab.ZIndex = 8
	getLab.Parent = face
	UIUtil.TextOutline(getLab, 1.2)

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.BackgroundTransparency = 1
	close.Font = FONT_BODY
	close.TextSize = OFFER.CloseTextSize
	close.TextColor3 = COLORS.White
	close.TextTransparency = 0.4
	close.Text = NotificationConfig.Offer.CloseText
	close.AutoButtonColor = false
	close.Active = true
	close.Selectable = true
	close.ZIndex = 7
	close.Parent = f

	get.Activated:Connect(function()
		local cur = offerShowing
		hideOffer()
		if cur then
			pcall(AudioController.PlayClick)
			local onGet = cur.Def.OnGet
			local ok, err = pcall(function(): string?
				onGet()
				return nil
			end)
			if not ok then
				warn("[NotificationController] offer OnGet failed:", cur.Def.Key, err)
			end
		end
	end)
	close.Activated:Connect(function()
		hideOffer()
	end)

	offerFrame = f
	offerTitle, offerSub, offerGet, offerGetFace, offerGetLabel, offerClose, offerIcon = title, sub, get, face, getLab, close, icon
	HudLayout.BindVisibility(f, { HideWhen = { "Modal", "Driving", "Dead" } }, function(): boolean
		return offerShowing ~= nil and not alertVisible()
	end)
	HudLayout.RegisterTopStack("Offer", f, HudConfig.TopStack.Order.Offer, { Space = "Hud" })
end

local function buildAlert(screen: ScreenGui)
	local f = Instance.new("Frame")
	f.Name = "BaseAlert"
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Position = UDim2.new(0.5, 0, 0, 0)
	f.Size = UDim2.fromOffset(320, 44)
	f.BackgroundColor3 = Color3.fromRGB(128, 18, 16)
	f.BackgroundTransparency = 0.05
	f.BorderSizePixel = 0
	f.Active = false
	f.Visible = false
	f.Parent = screen
	UIUtil.Corner(f, 10)
	local stroke = UIUtil.Stroke(f, Color3.fromRGB(255, 120, 100), 2)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local lab = Instance.new("TextLabel")
	lab.Name = "Text"
	lab.BackgroundTransparency = 1
	lab.Size = UDim2.fromScale(1, 1)
	lab.Font = FONT_DISPLAY
	lab.TextSize = 22
	lab.TextColor3 = COLORS.White
	lab.Text = ""
	lab.Parent = f
	UIUtil.TextOutline(lab, 1.4)
	alertFrame = f
	alertLabel = lab
	-- same order as the missile alert (MissileController registers "Alert"); ties keep registration order
	HudLayout.RegisterTopStack("BaseAlert", f, HudConfig.TopStack.Order.Alert, { Space = "Hud" })
end

function NotificationController.Init()
	if gui and gui.Parent then
		return
	end
	local pg = player:WaitForChild("PlayerGui")
	local old = pg:FindFirstChild("WarEmpireNotifications")
	if old then
		old:Destroy()
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireNotifications"
	screen.DisplayOrder = HudConfig.DisplayOrder.WarEmpireNotifications -- above modal panels (60)
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = pg
	gui = screen

	local l = Instance.new("Frame")
	l.Name = "Lane"
	l.AnchorPoint = Vector2.new(0.5, 0)
	l.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top)
	l.Size = UDim2.fromOffset(laneMaxWidth(), 0)
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Active = false -- never block HUD / world clicks
	l.Visible = false
	l.Parent = screen
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Top
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, TOAST.LineGap)
	list.Parent = l
	lane = l
	laneList = list
	HudLayout.RegisterTopStack("Toasts", l, HudConfig.TopStack.Order.Toasts, { Space = "Hud" })

	buildAlert(screen)
	buildOffer(screen)

	-- viewport / touch changes: re-measure the lines (text size and lane width follow the device)
	HudLayout.LayoutChanged:Connect(function()
		for _, line in ipairs(lines) do
			sizeLine(line)
		end
		relayoutLane()
		local cur = offerShowing
		if cur then
			layoutOffer(cur.Def)
		end
	end)
	HudLayout.FlagChanged:Connect(function(_name: string, _on: boolean)
		pumpOffers()
	end)
	task.spawn(function()
		while screen.Parent do
			task.wait(NotificationConfig.Offer.TickSeconds)
			pumpOffers()
		end
	end)

	-- v60: never block Init on the Notification remote
	Remotes.BindEvent(Constants.RemoteNames.Notification, function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		route(payload.Message, payload.Type, payload.Duration, payload.Amount, true)
	end)
end

--[[ Local toast (unchanged signature). Type "Collect" → cash float. Returns nothing (legacy callers pcall it). ]]
function NotificationController.Show(message: string, notifType: string, duration: number?)
	route(message, notifType, duration, nil, false)
end

--[[ A failed purchase line (WorldPromptController / BaseController): one line per failure — the other client
	path and the server's Warn echo inside NotificationConfig.PurchaseFailure.WindowSeconds are skipped.
	Returns true when it showed. ]]
function NotificationController.ShowPurchaseFailure(message: string, notifType: string?, duration: number?): boolean
	return route(message, notifType or "Warn", duration, nil, false, true)
end

--[[ Test / QA helper: the lane's current texts, top to bottom. ]]
function NotificationController.GetLaneTexts(): { string }
	local out = {}
	local sorted = table.clone(lines)
	table.sort(sorted, function(a: Line, b: Line): boolean
		return a.Seq < b.Seq
	end)
	for _, line in ipairs(sorted) do
		if not line.Dying then
			table.insert(out, line.Label.Text)
		end
	end
	return out
end

-- keep the marker referenced (strict mode: no unused-local noise)
local _ = HIGH_CONTRAST_SUCCESS
local _list = laneList

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">OrdersController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Army popover (v70 "clean screen", spec §3.8) — squad ORDERS Follow / Attack / Hold / Retreat.

	  * Never auto-shown. The rail's Army tile (UIController → OrdersController.Toggle) and Y (HudConfig.Keys.Army,
	    was A = strafe-left) toggle it. It sits right of the Army tile (AnchorPoint 0,0.5 at tile right +
	    OrdersConfig.Walkie.GapFromTile, tile centre), clamped to the safe area.
	  * Contents: "ARMY 5/20" + ✕ (touch hit ≥ 44 px), a 2×2 order grid (hotkey order 1 ATTACK · 2 HOLD ·
	    3 FOLLOW · 4 RETREAT, the active order highlighted), "MANAGE ARMY ▸" → ArmyController.Open.
	  * A NON-modal panel (HudLayout id "Orders", mobile plan P1-6): exclusive with the other panels and tapping
	    outside closes it, but it does not raise the Modal flag, so FIRE / the hotbar stay up in a fight.
	  * Long-press the Army tile (UIController → OrdersController.CycleOrder): cycles the order without the popover.
	  * While open: HudLayout flag "OrdersOpen" → 1-4 are order hotkeys (CombatController leaves them alone).
	  * T (keyboard) / the Army-tile long-press (touch) cycles the order at any time; with the popover closed a
	    local Info toast "Squad: FOLLOW" confirms it
	    (the server's own "Squad: X" echo is dropped by HudConfig.Toast.Drop).
	Server-authoritative: this only fires RequestSquadOrder(orderId).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local OrdersConfig = require(Shared.Configs.OrdersConfig)
local HudConfig = require(Shared.Configs.HudConfig)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)
local PanelShell = require(script.Parent.Parent.Modules.PanelShell)
local AudioController = require(script.Parent.Parent.Modules.AudioController)

local NotificationController = require(script.Parent.NotificationController)
local ArmyController = require(script.Parent.ArmyController)

local OrdersController = {}

local PANEL_ID = "Orders"
local WALKIE = OrdersConfig.Walkie

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local screenGui: ScreenGui? = nil
local panel: Frame? = nil
local titleLabel: TextLabel? = nil
local shell: PanelShell.Shell? = nil
local orderButtons: { [string]: TextButton } = {}
local keyCaps: { TextLabel } = {} -- the 1-4 digits on the order cells: only while HudLayout.PrefersKeys()
local currentOrder: string = OrdersConfig.DefaultOrder or "Follow"
local soldierCount = 0
local maxSoldiers = 0
local open = false

-- grid order = hotkey order (1-4)
local ORDER_DEFS = {
	{ Id = "Attack", Label = "ATTACK", Key = "1" },
	{ Id = "Hold", Label = "HOLD", Key = "2" },
	{ Id = "Follow", Label = "FOLLOW", Key = "3" },
	{ Id = "Retreat", Label = "RETREAT", Key = "4" },
}

-- 1-4 issue orders ONLY while the popover is open (HudLayout flag "OrdersOpen"); otherwise they draw weapons
local HOTKEY_ORDERS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.One] = "Attack",
	[Enum.KeyCode.Two] = "Hold",
	[Enum.KeyCode.Three] = "Follow",
	[Enum.KeyCode.Four] = "Retreat",
}

local HOTKEY_CYCLE = { "Attack", "Hold", "Follow", "Retreat" }
local CYCLE_KEY: Enum.KeyCode = HudConfig.Keys.OrdersCycle or Enum.KeyCode.T
local TOGGLE_KEY: Enum.KeyCode = HudConfig.Keys.Army or Enum.KeyCode.Y

local function labelOf(orderId: string): string
	for _, d in ipairs(ORDER_DEFS) do
		if d.Id == orderId then
			return d.Label
		end
	end
	return string.upper(orderId)
end

local function borderStroke(parent: Instance, color: Color3, thickness: number): UIStroke
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color
	s.Thickness = thickness
	s.Parent = parent
	return s
end

local function refresh()
	if titleLabel then
		titleLabel.Text = if maxSoldiers > 0
			then string.format("ARMY %d/%d", soldierCount, maxSoldiers)
			else string.format("ARMY %d", soldierCount)
	end
	for id, btn in pairs(orderButtons) do
		local active = id == currentOrder
		btn.BackgroundColor3 = if active then WALKIE.ActiveBg else WALKIE.CellBg
		local st = btn:FindFirstChildOfClass("UIStroke")
		if st then
			st.Thickness = if active then 2.5 else 1.5
			st.Transparency = if active then 0 else 0.35
		end
		local lab = btn:FindFirstChild("Label")
		if lab and lab:IsA("TextLabel") then
			lab.TextColor3 = if active then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(220, 226, 232)
		end
	end
end

local function fireOrder(orderId: string): boolean
	local flags = OrdersConfig.Orders
	if typeof(flags) == "table" and (flags :: any)[orderId] == false then
		NotificationController.Show("Order disabled", "Warn", 2)
		return false
	end
	-- RequestSquadOrder via the non-blocking helper (polls ≤ 3 s for the remote, never waits forever)
	task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestSquadOrder, orderId)
	currentOrder = orderId
	refresh()
	return true
end

local function cycleOrder()
	if soldierCount <= 0 then
		NotificationController.Show("No soldiers to take ORDERS yet — recruit in the Army panel", "Info", 2.5)
		return
	end
	local idx = table.find(HOTKEY_CYCLE, currentOrder) or 1
	local nextId = HOTKEY_CYCLE[(idx % #HOTKEY_CYCLE) + 1]
	if fireOrder(nextId) and not open then
		NotificationController.Show("Squad: " .. labelOf(nextId), "Info", WALKIE.HotkeyToastSeconds)
	end
end

-- The Army tile's rect (AbsolutePosition space). A UIGridLayout cell reports the rail's own origin until the
-- layout has run (and always in the headless HUD sim, which does not lay out grids): then derive the cell from
-- the rail's grid (vertical fill, FillDirectionMaxCells per column — HUDController.layoutRail).
local function armyTileRect(): (Vector2, Vector2)
	local pos, size = HudLayout.GetRect("ArmyTile")
	local railPos, railSize = HudLayout.GetRect("Rail")
	if size.X <= 0 or railSize.X <= 0 or (pos - railPos).Magnitude > 0.5 then
		return pos, size
	end
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("WarEmpireHUD")
	local rail = hud and hud:FindFirstChild("Rail")
	local grid = rail and rail:FindFirstChildOfClass("UIGridLayout")
	if not (rail and grid) then
		return pos, size
	end
	local cells: { GuiObject } = {}
	for _, c in ipairs(rail:GetChildren()) do
		if c:IsA("GuiObject") and c.Visible then
			table.insert(cells, c)
		end
	end
	table.sort(cells, function(a: GuiObject, b: GuiObject): boolean
		return a.LayoutOrder < b.LayoutOrder
	end)
	local tileName = "DockArmy"
	for _, t in ipairs(HudConfig.Rail.Tiles) do
		if t.Id == "Army" then
			tileName = t.Name
		end
	end
	local idx: number? = nil
	for i, c in ipairs(cells) do
		if c.Name == tileName then
			idx = i
		end
	end
	if not idx or idx <= 1 then
		return pos, size
	end
	local perCol = if grid.FillDirectionMaxCells > 0 then grid.FillDirectionMaxCells else #cells
	local col = (idx - 1) // perCol
	local row = (idx - 1) % perCol
	local s = HudLayout.Scale()
	local dx = col * (grid.CellSize.X.Offset + grid.CellPadding.X.Offset) * s
	local dy = row * (grid.CellSize.Y.Offset + grid.CellPadding.Y.Offset) * s
	return railPos + Vector2.new(dx, dy), size
end

-- right of the Army rail tile, vertically centred on the tile, clamped to the safe area (v, gui-local)
local function place()
	local gui, p = screenGui, panel
	if not (gui and p) then
		return
	end
	local s = HudLayout.Scale()
	if s <= 0 then
		s = 1
	end
	local size = p.Size
	local w, h = size.X.Offset, size.Y.Offset
	local cv = HudLayout.ContentSizeV()
	local origin = gui.AbsolutePosition
	local tilePos, tileSize = armyTileRect()
	local x: number, y: number
	if tileSize.X > 0 and tileSize.Y > 0 then
		-- clear the WHOLE rail: on short phones (800x360, 667x375) it wraps to 2 columns and the Missions tile in
		-- column 2 would sit on the popover if it only cleared the Army tile's own column
		local right = tilePos.X + tileSize.X
		local railPos, railSize = HudLayout.GetRect("Rail")
		if railSize.X > 0 and railSize.Y > 0 then
			right = math.max(right, railPos.X + railSize.X)
		end
		x = (right - origin.X) / s + WALKIE.GapFromTile
		-- the tile square is tileSize.X tall (the rest of the cell is the label overhang)
		y = (tilePos.Y + tileSize.X / 2 - origin.Y) / s
	else
		local R = HudConfig.Rail
		x = R.Left + (if isTouch then R.Tile else R.TileDesktop) + WALKIE.GapFromTile
		y = cv.Y * R.CenterY
	end
	local m = WALKIE.EdgeMargin
	local over = PanelShell.TouchMinV() / 2 - WALKIE.Pad -- the corner ✕ hangs out by this much (up and right)
	x = math.clamp(x, m, math.max(m, cv.X - w - over - m))
	local yMin = h / 2 + over + m
	y = math.clamp(y, yMin, math.max(yMin, cv.Y - h / 2 - m))
	p.Position = UDim2.fromOffset(x, y)
end

local function setOpen(value: boolean)
	if value and not OrdersConfig.Enabled then
		return
	end
	open = value
	if value then
		place()
	end
	if panel then
		panel.Visible = value
	end
	HudLayout.SetFlag("OrdersOpen", value)
	refresh()
	local sh = shell
	if sh then
		sh.Sync(value)
	end
end

local function build(screen: ScreenGui)
	-- SizeTouch (216 × 244 v) on phones / tablets, Size (216 × 180 v) with a mouse
	local size = if isTouch then WALKIE.SizeTouch else WALKIE.Size
	local pad = WALKIE.Pad
	local gap = WALKIE.CellGap
	local cellH = if isTouch then math.max(WALKIE.MinTouchPx, PanelShell.TouchMinV()) else WALKIE.CellHeightDesktop
	local manageH = if isTouch then math.max(WALKIE.MinTouchPx, PanelShell.TouchMinV()) else WALKIE.ManageHeightDesktop

	local frame = Instance.new("Frame")
	frame.Name = "Walkie"
	frame.AnchorPoint = Vector2.new(0, 0.5)
	frame.Position = UDim2.fromOffset(HudConfig.Rail.Left + HudConfig.Rail.Tile + WALKIE.GapFromTile, 200)
	frame.Size = size
	frame.BackgroundColor3 = WALKIE.Bg
	frame.BackgroundTransparency = WALKIE.BgTransparency
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Visible = false
	frame.ZIndex = 2
	frame.Parent = screen
	UIUtil.Corner(frame, 14)
	borderStroke(frame, WALKIE.Accent, 2)
	-- hard cap: the popover never grows past PanelMaxWidth × PanelMaxHeight v
	local sizeCap = Instance.new("UISizeConstraint")
	sizeCap.MaxSize = Vector2.new(WALKIE.PanelMaxWidth, WALKIE.PanelMaxHeight)
	sizeCap.MinSize = Vector2.new(140, 120)
	sizeCap.Parent = frame
	panel = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(pad + 6, pad)
	title.Size = UDim2.new(1, -(pad * 2 + 6 + PanelShell.TouchMinV() / 2), 0, WALKIE.TitleHeight)
	title.Font = HudConfig.Fonts.Display
	title.TextSize = WALKIE.TitleSize
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.Text = "ARMY"
	title.ZIndex = 3
	title.Parent = frame
	UIUtil.TextOutline(title, 1.5)
	titleLabel = title

	local grid = Instance.new("Frame")
	grid.Name = "Grid"
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.fromOffset(pad, pad + WALKIE.TitleHeight + gap)
	grid.Size = UDim2.new(1, -2 * pad, 0, 2 * cellH + gap)
	grid.ZIndex = 3
	grid.Parent = frame
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.5, -gap / 2, 0, cellH)
	layout.CellPadding = UDim2.fromOffset(gap, gap)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	for i, def in ipairs(ORDER_DEFS) do
		local btn = Instance.new("TextButton")
		btn.Name = "Order_" .. def.Id
		btn.LayoutOrder = i
		btn.BackgroundColor3 = WALKIE.CellBg
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = true
		btn.Text = ""
		btn.Active = true
		btn.ZIndex = 3
		UIUtil.Corner(btn, 10)
		borderStroke(btn, WALKIE.Accent, 1.5)
		local lab = Instance.new("TextLabel")
		lab.Name = "Label"
		lab.BackgroundTransparency = 1
		lab.Size = UDim2.fromScale(1, 1)
		lab.Font = HudConfig.Fonts.Display
		lab.TextSize = PanelShell.Text(WALKIE.CellTextSize) -- ≥ 20 v on touch = 14 real px
		lab.TextColor3 = Color3.fromRGB(220, 226, 232)
		lab.Text = def.Label
		lab.ZIndex = 4
		lab.Active = false
		lab.Parent = btn
		UIUtil.TextOutline(lab, 1.5)
		do
			-- keyboard / gamepad players: the hotkey digit, top-left (like the hotbar); hidden for touch players
			local key = Instance.new("TextLabel")
			key.Name = "Key"
			key.BackgroundTransparency = 1
			key.Position = UDim2.fromOffset(6, 2)
			key.Size = UDim2.fromOffset(16, WALKIE.CaptionSize)
			key.Font = HudConfig.Fonts.Body
			key.TextSize = WALKIE.CaptionSize
			key.TextColor3 = Color3.fromRGB(255, 255, 255)
			key.TextTransparency = 0.35
			key.TextXAlignment = Enum.TextXAlignment.Left
			key.Text = def.Key
			key.ZIndex = 4
			key.Active = false
			key.Visible = HudLayout.PrefersKeys()
			key.Parent = btn
			table.insert(keyCaps, key)
		end
		btn.Parent = grid
		UIUtil.EnsureMinTouch(btn, if isTouch then WALKIE.MinTouchPx else 44)
		local orderId = def.Id
		btn.Activated:Connect(function()
			pcall(AudioController.PlayClick)
			fireOrder(orderId)
		end)
		orderButtons[def.Id] = btn
	end

	local manage = Instance.new("TextButton")
	manage.Name = "ManageArmy"
	manage.AnchorPoint = Vector2.new(0, 1)
	manage.Position = UDim2.new(0, pad, 1, -pad)
	manage.Size = UDim2.new(1, -2 * pad, 0, manageH)
	manage.BackgroundColor3 = WALKIE.ManageBg
	manage.BorderSizePixel = 0
	manage.AutoButtonColor = true
	manage.Text = ""
	manage.Active = true
	manage.ZIndex = 3
	manage.Parent = frame
	UIUtil.Corner(manage, 10)
	borderStroke(manage, WALKIE.Accent, 2)
	local mLab = Instance.new("TextLabel")
	mLab.Name = "Label"
	mLab.BackgroundTransparency = 1
	mLab.Position = UDim2.fromOffset(12, 0)
	mLab.Size = UDim2.new(1, -44, 1, 0)
	mLab.Font = HudConfig.Fonts.Display
	mLab.TextSize = PanelShell.Text(WALKIE.CellTextSize)
	mLab.TextColor3 = Color3.fromRGB(255, 255, 255)
	mLab.TextXAlignment = Enum.TextXAlignment.Left
	mLab.Text = "MANAGE ARMY"
	mLab.ZIndex = 4
	mLab.Active = false
	mLab.Parent = manage
	UIUtil.TextOutline(mLab, 1.5)
	HudIcons.Make("Chevron", manage, {
		Size = UDim2.fromOffset(20, 20),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		ZIndex = 4,
		Color = WALKIE.Accent,
		Fill = WALKIE.ManageBg,
	})
	manage.Activated:Connect(function()
		pcall(AudioController.PlayClick)
		setOpen(false)
		ArmyController.Open()
	end)

	-- ✕ on the popover's top-right corner: the full touch hit area hangs outside the popover (up and right),
	-- so it never covers the order grid
	local close = PanelShell.CloseButton(frame, function()
		pcall(AudioController.PlayClick)
		setOpen(false)
	end, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -pad, 0, pad),
		ZIndex = 6,
		Face = Color3.fromRGB(34, 38, 44),
	})
	local face = close:FindFirstChild("Face")
	if face and face:IsA("Frame") then
		face.Size = UDim2.fromOffset(WALKIE.CloseFace, WALKIE.CloseFace)
		local c = face:FindFirstChildOfClass("UICorner")
		if c then
			c.CornerRadius = UDim.new(0.5, 0)
		end
		local st = face:FindFirstChildOfClass("UIStroke")
		if st then
			st.Color = WALKIE.Accent
			st.Transparency = 0
			st.Thickness = 2
		end
	end
end

function OrdersController.Toggle()
	-- the tap that just closed the popover through its tap-catcher lands on the Army tile too: stay closed
	local sh = shell
	if not open and sh and sh.TapThrough() then
		return
	end
	setOpen(not open)
end

function OrdersController.Open()
	setOpen(true)
end

function OrdersController.Close()
	setOpen(false)
end

function OrdersController.IsOpen(): boolean
	return open
end

--[[ Cycle Attack → Hold → Follow → Retreat (T on a keyboard; the Army tile's long-press on touch — P1-6). ]]
function OrdersController.CycleOrder()
	if not OrdersConfig.Enabled then
		return
	end
	cycleOrder()
end

--[[ v70: the Army popover no longer follows the Army panel (they are exclusive Modal panels). Kept for callers. ]]
function OrdersController.SetArmyOpen(_isOpen: boolean) end

function OrdersController.Init()
	if not OrdersConfig.Enabled then
		print("[WAR EMPIRE] OrdersController disabled")
		return
	end

	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireOrders"
	-- the one HUD scale + safe area (HudLayout.ApplyScreen); DisplayOrder 52: under the rail (55), which it sits beside
	PanelShell.Screen(screen, HudConfig.DisplayOrder.WarEmpireOrders)
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	build(screen)
	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return open
		end,
		Close = function()
			setOpen(false)
		end,
		Dim = false, -- a popover: invisible tap-catcher, no black dim
		TapCloses = true,
		NonModal = true, -- P1-6: FIRE / hotbar / prompts stay up while the popover is open
	})
	HudLayout.InputModeChanged:Connect(function(prefersKeys: boolean)
		for _, k in ipairs(keyCaps) do
			k.Visible = prefersKeys
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.SquadOrderStateUpdate, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		if typeof(payload.Order) == "string" then
			currentOrder = payload.Order
		end
		soldierCount = tonumber(payload.Soldiers) or soldierCount
		refresh()
	end)

	Remotes.BindEvent(Constants.RemoteNames.SoldierStateUpdate, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		if typeof(payload.Soldiers) == "number" then
			soldierCount = payload.Soldiers
		end
		if typeof(payload.MaxSoldiers) == "number" then
			maxSoldiers = payload.MaxSoldiers
		end
		refresh()
	end)

	HudLayout.LayoutChanged:Connect(function()
		if open then
			place()
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, gp: boolean)
		if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if key == TOGGLE_KEY then
			setOpen(not open)
			return
		end
		if open then
			local mapped = HOTKEY_ORDERS[key]
			if mapped then
				fireOrder(mapped)
				return
			end
		end
		-- T (Enum.KeyCode.T) cycles Attack → Hold → Follow → Retreat
		if key == CYCLE_KEY then
			cycleOrder()
		end
	end)

	refresh()
	print("[WAR EMPIRE] OrdersController ready (Army popover: tile / Y, orders 1-4 / T / tile long-press)")
end

return OrdersController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">ProgressionController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Progression UI — Prestige + Battle Pass + Clan + Clan War (the rail's Rebirth tile / K).
	v70 "clean screen" (spec §3.7 / §3.8): the season banner left the HUD — the season line sits under this
	panel's title (SeasonStateUpdate). The near-rebirth banner became the Rebirth tile's "!" badge. A registered
	Modal panel (HudLayout id "Rebirth") with the black dim; one HUD scale + safe area; every tappable ≥ 44 real
	px on touch. Server-authoritative: every button only fires its request remote. ]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local HudConfig = require(Shared.Configs.HudConfig)
local ProgressionUI = require(script.ProgressionUI)
local ProgressionBattlePass = require(script.ProgressionBattlePass)

local PanelShell = require(script.Parent.Parent.Modules.PanelShell)

local ProgressionController = {}

local PANEL_ID = "Rebirth"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local menuOpen = false
local screenGui: ScreenGui? = nil
local shell: PanelShell.Shell? = nil
local seasonLabel: TextLabel? = nil
local prestigeLabel: TextLabel? = nil
local unlockLabel: TextLabel? = nil
local prestigeConfirm: TextLabel? = nil
local prestigeKeepBanner: TextLabel? = nil
local bpLabel: TextLabel? = nil
local bpClaimHint: TextLabel? = nil
local bpBarFill: Frame? = nil
local clanLabel: TextLabel? = nil
local warLabel: TextLabel? = nil
local scoreboardLabel: TextLabel? = nil
local trackList: ScrollingFrame? = nil
local prestigeState: any = nil
local bpState: any = nil
local clanState: any = nil
local warState: any = nil

-- non-blocking request (Remotes.FireServer polls ≤ 3 s for the remote; never waits forever)
local function fire(remoteName: string, ...: any)
	task.spawn(Remotes.FireServer, remoteName, ...)
end

local function rebuildTrackPreview()
	ProgressionBattlePass.RebuildTrackPreview(trackList, bpState)
	-- v70: the shared track builder makes 40 v rows with 36 v CLAIM buttons and 10-11 v text; lift them to the
	-- panel's touch target / text floor (≥ 44 real px targets, ≥ 11 px text)
	local list = trackList
	if not list then
		return
	end
	local tap = PanelShell.TouchMinV()
	for _, row in ipairs(list:GetChildren()) do
		if row:IsA("Frame") then
			if isTouch then
				row.Size = UDim2.new(row.Size.X.Scale, row.Size.X.Offset, 0, tap + 8)
			end
			for _, d in ipairs(row:GetChildren()) do
				if d:IsA("TextButton") then
					d.TextSize = PanelShell.Text(d.TextSize)
					if isTouch then
						d.Size = UDim2.fromOffset(math.max(d.Size.X.Offset, 96), tap)
					end
				elseif d:IsA("TextLabel") then
					d.TextSize = PanelShell.Text(d.TextSize)
					d.TextTruncate = Enum.TextTruncate.AtEnd
					if isTouch then
						d.Size = UDim2.new(1, -112, 1, 0)
					end
				end
			end
		end
	end
end

local debouncedRefresh = ProgressionUI.Debounce(0.12)

local function refreshLabelsImmediate()
	if prestigeLabel then
		if typeof(prestigeState) == "table" then
			local p = tonumber(prestigeState.Prestige) or 0
			local cur = tonumber(prestigeState.CashMultPercent)
				or math.floor(p * (tonumber(prestigeState.CashBonusPerLevel) or 0.10) * 100)
			local nxt = tonumber(prestigeState.NextCashMultPercent)
				or math.floor((p + 1) * (tonumber(prestigeState.CashBonusPerLevel) or 0.10) * 100)
			prestigeLabel.Text = string.format(
				"Rebirth P%d  |  Cash +%d%% now  |  Next +%d%%  |  Need Lv %d  |  Can: %s",
				p,
				cur,
				nxt,
				tonumber(prestigeState.MinLevel) or 40,
				if prestigeState.CanPrestige then "YES" else "no"
			)
		else
			prestigeLabel.Text = "Rebirth data loading… reach max level to prestige (+10% cash / rebirth)."
		end
	end
	if unlockLabel then
		if typeof(prestigeState) == "table" and typeof(prestigeState.UnlockTrack) == "table" then
			local lines = { "Unlock track:" }
			for _, u in ipairs(prestigeState.UnlockTrack) do
				local mark = if u.Unlocked then "✓" else "·"
				table.insert(
					lines,
					string.format("  %s P%d — %s", mark, tonumber(u.AtPrestige) or 0, tostring(u.DisplayName or u.Flag))
				)
			end
			if #lines == 1 then
				table.insert(lines, "  (none configured)")
			end
			unlockLabel.Text = table.concat(lines, "\n")
		else
			unlockLabel.Text = "Unlock track loading…"
		end
	end
	if prestigeConfirm then
		if typeof(prestigeState) == "table" and prestigeState.CanPrestige then
			local feeLine = prestigeState.FeeSummary
			if typeof(feeLine) ~= "string" or feeLine == "" then
				local fee = tonumber(prestigeState.CashFee) or 0
				local feePart = if fee > 0 then string.format("Fee $%s", tostring(fee)) else "Fee: none"
				local pct = tonumber(prestigeState.BaseCompletionPercent)
				feeLine = string.format(
					"%s · Cash → $%s after · +%d Gold%s",
					feePart,
					tostring(prestigeState.StartingCashAfter or 10000),
					tonumber(prestigeState.GoldBonusOnPrestige) or 50,
					if pct ~= nil then string.format(" · Base %d%%", math.floor(pct)) else ""
				)
			end
			prestigeConfirm.Text = "Confirm Rebirth: " .. feeLine .. " · +10% cash forever. Keep all Robux purchases / Game Passes."
			prestigeConfirm.TextColor3 = Constants.Colors.Gold
		else
			local need = 40
			if typeof(prestigeState) == "table" then
				need = tonumber(prestigeState.MinLevel) or 40
			end
			prestigeConfirm.Text = string.format("Reach Lv %d to unlock Rebirth · Fee: none · +10%% cash forever · keep all Robux items.", need)
			prestigeConfirm.TextColor3 = Constants.Colors.Muted
		end
	end

	if prestigeKeepBanner then
		prestigeKeepBanner.Text = "★ Keep all your Robux Items!"
		prestigeKeepBanner.TextColor3 = Constants.Colors.GoldBright or Constants.Colors.Gold
		prestigeKeepBanner.Visible = true
	end
	if bpLabel and typeof(bpState) == "table" then
		local claimFree = tonumber(bpState.ClaimableFree) or 0
		local claimPrem = tonumber(bpState.ClaimablePremium) or 0
		local xp = tonumber(bpState.XP) or 0
		local need = tonumber(bpState.XPPerLevel) or 1000
		bpLabel.Text = string.format(
			"BP L%d  XP %d/%d  %s\nClaimable: %d free · %d premium",
			tonumber(bpState.Level) or 0,
			xp,
			need,
			if bpState.Premium then "PREMIUM" else "Free (shop PremiumPass / admin)",
			claimFree,
			claimPrem
		)
		if bpBarFill and need > 0 then
			bpBarFill.Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1)
		end
	end
	if bpLabel and typeof(bpState) ~= "table" then
		bpLabel.Text = "Battle Pass loading… play to earn BP XP."
	end
	if bpClaimHint then
		if typeof(bpState) == "table" then
			local cf = tonumber(bpState.ClaimableFree) or 0
			local cp = tonumber(bpState.ClaimablePremium) or 0
			if cf + cp > 0 then
				bpClaimHint.Text = string.format("Tap CLAIM ALL or CLAIM on a READY row — %d ready", cf + cp)
				bpClaimHint.TextColor3 = Constants.Colors.Cash
			else
				bpClaimHint.Text = "No unclaimed rewards at current BP level"
				bpClaimHint.TextColor3 = Constants.Colors.Muted
			end
		end
	end
	if clanLabel and typeof(clanState) == "table" then
		if clanState.ClanId then
			clanLabel.Text = string.format(
				"Clan [%s] %s (%d)\nId: %s%s",
				tostring(clanState.Tag or "?"),
				tostring(clanState.Name or "?"),
				tonumber(clanState.MemberCount) or 0,
				tostring(clanState.ClanId),
				if clanState.Persisted == false then "\n(session-only — enable API Services)" else ""
			)
		else
			clanLabel.Text = "Not in a clan — create one below"
		end
	end
	if warLabel then
		if typeof(warState) == "table" then
			local war = warState.War
			local cd = tonumber(warState.DeclareCooldownLeft) or 0
			if typeof(war) == "table" and war.Active then
				local left = math.max(0, (tonumber(war.EndUnix) or 0) - os.time())
				warLabel.Text = string.format(
					"WAR ACTIVE  %s vs %s\nScore %d – %d  ·  %dm left",
					tostring(war.AttackerName or war.AttackerClanId),
					tostring(war.DefenderName or war.DefenderClanId),
					tonumber(war.AttackerScore) or 0,
					tonumber(war.DefenderScore) or 0,
					math.floor(left / 60)
				)
				warLabel.TextColor3 = Color3.fromRGB(230, 160, 60)
			elseif typeof(war) == "table" and war.Settled then
				warLabel.Text = string.format(
					"Last war settled · Winner: %s\nCooldown: %ds before next declare",
					tostring(war.WinnerClanId or "draw"),
					cd
				)
				warLabel.TextColor3 = Constants.Colors.Muted
			else
				local rewards = warState.Rewards
				local winCash = if typeof(rewards) == "table" then tonumber(rewards.WinCash) or 0 else 0
				warLabel.Text = string.format(
					"No active war. Leader declares vs clan Id.\nWin ≈ $%d · cooldown %ds · min members %d",
					winCash,
					cd,
					tonumber(warState.MinMembers) or 2
				)
				warLabel.TextColor3 = Constants.Colors.Muted
			end
		else
			warLabel.Text = "War state loading..."
		end
	end
	if scoreboardLabel and typeof(warState) == "table" then
		local board = warState.Scoreboard
		if typeof(board) == "table" and #board > 0 then
			local lines = { "Global war scoreboard:" }
			for i, row in ipairs(board) do
				if i > 5 then
					break
				end
				table.insert(lines, string.format("  %d. %s — %d", i, tostring(row.Name or row.ClanId), tonumber(row.Score) or 0))
			end
			scoreboardLabel.Text = table.concat(lines, "\n")
		else
			scoreboardLabel.Text = "Scoreboard empty — capture territories with a clan"
		end
	end
	rebuildTrackPreview()
end

local function refreshLabels()
	debouncedRefresh(refreshLabelsImmediate)
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
	local sh = shell
	if sh then
		sh.Sync(open)
	end
end

-- SeasonStateUpdate → the line under the title (was the HUD's SeasonLabel banner)
local function applySeason(payload: any)
	local lab = seasonLabel
	if not lab or typeof(payload) ~= "table" then
		return
	end
	local name = tostring(payload.DisplayName or payload.SeasonId or "Season")
	if payload.Active == true then
		local xpB = tonumber(payload.XPBonusMult) or 1
		local cashB = tonumber(payload.CashBonusMult) or 1
		lab.TextColor3 = Constants.Colors.Cash
		lab.Text = string.format("%s  ·  XP×%.2f  Cash×%.2f", name, xpB, cashB)
	else
		lab.TextColor3 = Constants.Colors.Muted
		lab.Text = name .. "  ·  ENDED"
	end
	lab.Visible = true
end

function ProgressionController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireProgression"
	PanelShell.Screen(screen) -- DisplayOrder 60 (Panels), one HUD scale + safe area
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.94, 0, 1, -16) else UDim2.fromOffset(540, 660)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = screen
	UIUtil.Corner(panel, 12)
	UIUtil.Stroke(panel)
	do
		local sizeConstraint = Instance.new("UISizeConstraint")
		sizeConstraint.MinSize = Vector2.new(280, 300)
		sizeConstraint.MaxSize = if isTouch then Vector2.new(820, 900) else Vector2.new(540, 660)
		sizeConstraint.Parent = panel
	end

	local title = PanelShell.Title(panel, if isTouch then "Rebirth / Progression" else "Progression")

	-- v70: the season line (was the HUD's top-centre SeasonLabel banner)
	local seasonSize = PanelShell.Text(13)
	local season = Instance.new("TextLabel")
	season.Name = "SeasonLabel"
	season.BackgroundTransparency = 1
	season.Position = UDim2.fromOffset(16, title.Position.Y.Offset + title.Size.Y.Offset - 2)
	season.Size = UDim2.new(1, -(TAP + 28), 0, seasonSize + 4)
	season.Font = Enum.Font.GothamBold
	season.TextSize = seasonSize
	season.TextXAlignment = Enum.TextXAlignment.Left
	season.TextTruncate = Enum.TextTruncate.AtEnd
	season.TextColor3 = Constants.Colors.Muted
	season.Text = ""
	season.Visible = false
	season.Parent = panel
	seasonLabel = season

	PanelShell.CloseButton(panel, function()
		setOpen(false)
	end)

	local headerH = math.max(TAP + 8, season.Position.Y.Offset + seasonSize + 10)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Content"
	scroll.Position = UDim2.fromOffset(0, headerH)
	scroll.Size = UDim2.new(1, 0, 1, -(headerH + 8))
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if isTouch then 6 else 5
	scroll.CanvasSize = UDim2.fromOffset(0, 1100)
	scroll.Parent = panel

	local y = 8
	local sectionSize = PanelShell.Text(14)
	local bodySize = PanelShell.Text(12)
	local bodyK = bodySize / 12 -- body heights were designed for 12 v text
	local function section(text: string)
		local lab = Instance.new("TextLabel")
		lab.BackgroundTransparency = 1
		lab.Position = UDim2.fromOffset(16, y)
		lab.Size = UDim2.new(1, -32, 0, sectionSize + 6)
		lab.Font = Enum.Font.GothamBold
		lab.TextSize = sectionSize
		lab.TextXAlignment = Enum.TextXAlignment.Left
		lab.TextColor3 = Constants.Colors.Accent
		lab.Text = text
		lab.Parent = scroll
		y += sectionSize + 8
	end
	local function body(h: number?): TextLabel
		local hh = math.ceil((h or 40) * bodyK)
		local lab = Instance.new("TextLabel")
		lab.BackgroundTransparency = 1
		lab.Position = UDim2.fromOffset(16, y)
		lab.Size = UDim2.new(1, -32, 0, hh)
		lab.Font = Enum.Font.GothamMedium
		lab.TextSize = bodySize
		lab.TextWrapped = true
		lab.TextXAlignment = Enum.TextXAlignment.Left
		lab.TextYAlignment = Enum.TextYAlignment.Top
		lab.TextColor3 = Constants.Colors.Muted
		lab.Text = "..."
		lab.Parent = scroll
		y += hh + 4
		return lab
	end
	-- a button on the current row; on touch it is TAP (≥ 44 real px) tall
	local function btn(label: string, w: number, cb: () -> ()): TextButton
		local b = Instance.new("TextButton")
		b.Position = UDim2.fromOffset(16, y)
		b.Size = UDim2.fromOffset(math.max(w, if isTouch then 180 else w), if isTouch then TAP else 36)
		b.BackgroundColor3 = Constants.Colors.Accent
		b.Font = Enum.Font.GothamBold
		b.TextSize = PanelShell.Text(13)
		b.TextColor3 = Constants.Colors.Text
		b.Text = label
		b.BorderSizePixel = 0
		b.Active = true
		UIUtil.Corner(b, 8)
		b.Parent = scroll
		UIUtil.EnsureMinTouch(b, if isTouch then TAP else 36)
		b.Activated:Connect(cb)
		return b
	end
	local rowH = if isTouch then TAP else 36
	local function textBox(placeholder: string, x: number, w: UDim): TextBox
		local box = Instance.new("TextBox")
		box.Position = UDim2.fromOffset(x, y)
		box.Size = UDim2.new(w.Scale, w.Offset, 0, if isTouch then TAP else 32)
		box.BackgroundColor3 = Constants.Colors.Background
		box.Font = Enum.Font.GothamMedium
		box.TextSize = PanelShell.Text(13)
		box.TextColor3 = Constants.Colors.Text
		box.PlaceholderText = placeholder
		box.PlaceholderColor3 = Constants.Colors.Muted
		box.Text = ""
		box.ClearTextOnFocus = false
		box.BorderSizePixel = 0
		UIUtil.Corner(box, 8)
		box.Parent = scroll
		return box
	end

	section("REBIRTH / PRESTIGE")
	prestigeLabel = body(40)
	unlockLabel = body(110)
	prestigeConfirm = body(52)
	-- Competitor rebirth trust cue (Entitlements / GamePasses never cleared on prestige)
	do
		local keepH = if isTouch then 44 else 34
		local keep = Instance.new("TextLabel")
		keep.Name = "KeepRobuxBanner"
		keep.Position = UDim2.fromOffset(16, y)
		keep.Size = UDim2.new(1, -32, 0, keepH)
		keep.BackgroundColor3 = Color3.fromRGB(28, 72, 36)
		keep.BackgroundTransparency = 0.05
		keep.BorderSizePixel = 0
		keep.Font = HudConfig.Fonts.Display
		keep.TextSize = PanelShell.Text(if isTouch then 18 else 16)
		keep.TextColor3 = Constants.Colors.GoldBright
		keep.Text = "★ Keep all your Robux Items!"
		keep.TextXAlignment = Enum.TextXAlignment.Center
		keep.Parent = scroll
		UIUtil.Corner(keep, 8)
		UIUtil.Stroke(keep, Constants.Colors.Gold, 2).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		prestigeKeepBanner = keep
		y += keepH + 6
	end
	local rebirthBtn = btn(if isTouch then "CONFIRM REBIRTH (+10% CASH)" else "CONFIRM REBIRTH", 220, function()
		print("[Progression] CONFIRM REBIRTH tap")
		fire(Constants.RemoteNames.RequestPrestige)
	end)
	rebirthBtn.BackgroundColor3 = Constants.Colors.Gunmetal
	rebirthBtn.TextColor3 = Constants.Colors.Gold
	UIUtil.Stroke(rebirthBtn, Constants.Colors.Gold, 1.5).ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	if isTouch then
		rebirthBtn.Size = UDim2.new(1, -32, 0, TAP)
	end
	y += rowH + 10

	section("BATTLE PASS")
	bpLabel = body(44)
	-- XP bar
	local bpBg = Instance.new("Frame")
	bpBg.Position = UDim2.fromOffset(16, y)
	bpBg.Size = UDim2.new(1, -32, 0, 12)
	bpBg.BackgroundColor3 = Constants.Colors.Background
	bpBg.BorderSizePixel = 0
	bpBg.Parent = scroll
	UIUtil.Corner(bpBg, 4)
	local fillBar = Instance.new("Frame")
	fillBar.Size = UDim2.fromScale(0, 1)
	fillBar.BackgroundColor3 = Constants.Colors.XP
	fillBar.BorderSizePixel = 0
	fillBar.Parent = bpBg
	UIUtil.Corner(fillBar, 4)
	bpBarFill = fillBar
	y += 16
	bpClaimHint = body(18)
	local freeClaim = btn("CLAIM ALL FREE", 150, function()
		print("[Progression] CLAIM ALL FREE tap")
		fire(Constants.RemoteNames.RequestClaimBattlePassReward, 0, "free")
	end)
	local premBtn = btn("CLAIM ALL PREMIUM", 170, function()
		print("[Progression] CLAIM ALL PREMIUM tap")
		if typeof(bpState) == "table" and not bpState.Premium then
			return
		end
		fire(Constants.RemoteNames.RequestClaimBattlePassReward, 0, "premium")
	end)
	if isTouch then
		-- side by side, each half the row
		freeClaim.Size = UDim2.new(0.5, -20, 0, TAP)
		premBtn.Position = UDim2.new(0.5, 4, 0, y)
		premBtn.Size = UDim2.new(0.5, -20, 0, TAP)
		y += TAP + 10
	else
		premBtn.Position = UDim2.fromOffset(176, y)
		y += 36 + 6
	end

	local trackTitle = Instance.new("TextLabel")
	trackTitle.BackgroundTransparency = 1
	trackTitle.Position = UDim2.fromOffset(16, y)
	trackTitle.Size = UDim2.new(1, -32, 0, bodySize + 4)
	trackTitle.Font = Enum.Font.GothamBold
	trackTitle.TextSize = bodySize
	trackTitle.TextXAlignment = Enum.TextXAlignment.Left
	trackTitle.TextColor3 = Constants.Colors.Muted
	trackTitle.Text = "Reward track (CLAIM on READY rows)"
	trackTitle.Parent = scroll
	y += bodySize + 6

	local trackH = if isTouch then 3 * (TAP + 11) else 110
	local trackScroll = Instance.new("ScrollingFrame")
	trackScroll.Position = UDim2.fromOffset(12, y)
	trackScroll.Size = UDim2.new(1, -24, 0, trackH)
	trackScroll.BackgroundTransparency = 1
	trackScroll.BorderSizePixel = 0
	trackScroll.ScrollBarThickness = 4
	trackScroll.CanvasSize = UDim2.fromOffset(0, 0)
	trackScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	trackScroll.Parent = scroll
	trackList = trackScroll
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 3)
	layout.Parent = trackScroll
	y += trackH + 8

	section("CLAN")
	clanLabel = body(48)
	local nameBox = textBox("Clan name", 16, if isTouch then UDim.new(0.6, -20) else UDim.new(0, 200))
	local tagBox = textBox("TAG", if isTouch then 0 else 224, if isTouch then UDim.new(0.4, -20) else UDim.new(0, 80))
	if isTouch then
		tagBox.Position = UDim2.new(0.6, 4, 0, y)
	end
	y += (if isTouch then TAP else 32) + 6
	btn("CREATE CLAN", 200, function()
		fire(Constants.RemoteNames.RequestCreateClan, nameBox.Text, tagBox.Text)
	end)
	y += rowH + 8
	local joinBox = textBox("Clan Id to join", 16, if isTouch then UDim.new(1, -32) else UDim.new(0, 280))
	y += (if isTouch then TAP else 32) + 6
	btn("JOIN CLAN", 140, function()
		fire(Constants.RemoteNames.RequestJoinClan, joinBox.Text)
	end)
	local leaveBtn = btn("LEAVE CLAN", 140, function()
		fire(Constants.RemoteNames.RequestLeaveClan)
	end)
	leaveBtn.Position = if isTouch then UDim2.new(0, 16 + 180 + 8, 0, y) else UDim2.fromOffset(166, y)
	y += rowH + 10

	section("CLAN WAR")
	warLabel = body(52)
	scoreboardLabel = body(72)
	local warBox = textBox("Enemy clan Id to declare war", 16, if isTouch then UDim.new(1, -32) else UDim.new(0, 260))
	y += (if isTouch then TAP else 32) + 6
	btn("DECLARE WAR", 160, function()
		if warBox.Text ~= "" then
			fire(Constants.RemoteNames.RequestDeclareClanWar, warBox.Text)
		end
	end)
	y += rowH + 10
	scroll.CanvasSize = UDim2.fromOffset(0, y + 20)

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return menuOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})

	Remotes.BindEvent(Constants.RemoteNames.PrestigeStateUpdate, function(payload: any)
		prestigeState = payload
		refreshLabels()
	end)
	Remotes.BindEvent(Constants.RemoteNames.BattlePassStateUpdate, function(payload: any)
		bpState = payload
		refreshLabels()
	end)
	Remotes.BindEvent(Constants.RemoteNames.ClanStateUpdate, function(payload: any)
		clanState = payload
		refreshLabels()
	end)
	Remotes.BindEvent(Constants.RemoteNames.ClanWarStateUpdate, function(payload: any)
		warState = payload
		refreshLabels()
	end)
	Remotes.BindEvent(Constants.RemoteNames.SeasonStateUpdate, applySeason)

	local rebirthKey: Enum.KeyCode = HudConfig.Keys.Rebirth or Enum.KeyCode.K
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == rebirthKey then
			setOpen(not menuOpen)
		end
	end)
	refreshLabelsImmediate()
end

function ProgressionController.Toggle()
	local sh = shell
	if not menuOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not menuOpen)
end

function ProgressionController.Open()
	setOpen(true)
end

function ProgressionController.Close()
	setOpen(false)
end

function ProgressionController.IsOpen(): boolean
	return menuOpen
end

return ProgressionController
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="161">
              <Properties>
                <string name="Name">ProgressionBattlePass</string>
                <string name="Source"><![CDATA[--!strict
--[[ Battle Pass track preview rebuild (extracted from ProgressionController). ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local ProgressionUI = require(script.Parent.ProgressionUI)

local ProgressionBattlePass = {}

function ProgressionBattlePass.RebuildTrackPreview(trackList: ScrollingFrame?, bpState: any)
	if not trackList or typeof(bpState) ~= "table" then
		return
	end
	for _, child in ipairs(trackList:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end

	local level = tonumber(bpState.Level) or 0
	local freeTrack = bpState.FreeTrack or {}
	local premTrack = bpState.PremiumTrack or {}
	local claimedFree = bpState.ClaimedFree or {}
	local claimedPrem = bpState.ClaimedPremium or {}
	local premium = bpState.Premium == true

	local tiers: { number } = {}
	local seen: { [number]: boolean } = {}
	for t in pairs(freeTrack) do
		local n = tonumber(t)
		if n and not seen[n] then
			seen[n] = true
			table.insert(tiers, n)
		end
	end
	for t in pairs(premTrack) do
		local n = tonumber(t)
		if n and not seen[n] then
			seen[n] = true
			table.insert(tiers, n)
		end
	end
	table.sort(tiers)

	local rows = 0
	local maxRows = 14
	for _, tier in ipairs(tiers) do
		if rows >= maxRows then
			break
		end
		local freeR = freeTrack[tier] or freeTrack[tostring(tier)]
		local premR = premTrack[tier] or premTrack[tostring(tier)]
		local freeClaimed = claimedFree[tostring(tier)] == true
		local premClaimed = claimedPrem[tostring(tier)] == true
		local reached = tier <= level
		local freeReady = reached and freeR ~= nil and not freeClaimed
		local premReady = reached and premium and premR ~= nil and not premClaimed
		local interesting = freeReady
			or premReady
			or (reached and ((freeR ~= nil and not freeClaimed) or (premR ~= nil and not premClaimed)))
			or (not reached and tier <= level + 6)
		local skip = (not interesting) and (rows > 0 or tier > level + 3)
		if not skip then
			rows += 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -6, 0, 40)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = tier
			row.Parent = trackList
			UIUtil.Corner(row, 4)

			local status = "locked"
			if freeReady or premReady then
				status = "READY"
			elseif reached then
				status = "claimed"
				if (freeR and not freeClaimed) or (premR and not premClaimed and not premium) then
					status = if premium then "partial" else "free done / need Prem"
				end
			end

			local freeTxt = ProgressionUI.FormatReward(freeR)
			local premTxt = ProgressionUI.FormatReward(premR)
			local lab = Instance.new("TextLabel")
			lab.BackgroundTransparency = 1
			lab.Position = UDim2.fromOffset(6, 0)
			lab.Size = UDim2.new(1, -70, 1, 0)
			lab.Font = Enum.Font.Gotham
			lab.TextSize = 11
			lab.TextXAlignment = Enum.TextXAlignment.Left
			lab.TextColor3 = if (freeReady or premReady) then Constants.Colors.Cash else Constants.Colors.Muted
			lab.Text = string.format(
				"L%d  Free:%s  Prem:%s  [%s]",
				tier,
				if freeTxt ~= "" then freeTxt else "-",
				if premTxt ~= "" then premTxt else "-",
				status
			)
			lab.Parent = row

			if freeReady then
				local claimBtn = Instance.new("TextButton")
				claimBtn.AnchorPoint = Vector2.new(1, 0.5)
				claimBtn.Position = UDim2.new(1, -4, 0.5, 0)
				claimBtn.Size = UDim2.fromOffset(64, 36)
				claimBtn.BackgroundColor3 = Constants.Colors.Accent
				claimBtn.Font = Enum.Font.GothamBold
				claimBtn.TextSize = 10
				claimBtn.TextColor3 = Constants.Colors.Text
				claimBtn.Text = "CLAIM"
				claimBtn.BorderSizePixel = 0
				UIUtil.Corner(claimBtn, 4)
				claimBtn.Parent = row
				local claimTier = tier
				UIUtil.EnsureMinTouch(claimBtn, 36)
				claimBtn.Activated:Connect(function()
					Remotes.GetEvent(Constants.RemoteNames.RequestClaimBattlePassReward):FireServer(claimTier, "free")
				end)
			elseif premReady then
				local claimBtn = Instance.new("TextButton")
				claimBtn.AnchorPoint = Vector2.new(1, 0.5)
				claimBtn.Position = UDim2.new(1, -4, 0.5, 0)
				claimBtn.Size = UDim2.fromOffset(64, 36)
				claimBtn.BackgroundColor3 = Constants.Colors.Gold
				claimBtn.Font = Enum.Font.GothamBold
				claimBtn.TextSize = 10
				claimBtn.TextColor3 = Constants.Colors.Background
				claimBtn.Text = "CLAIM"
				claimBtn.BorderSizePixel = 0
				UIUtil.Corner(claimBtn, 4)
				claimBtn.Parent = row
				local claimTier = tier
				UIUtil.EnsureMinTouch(claimBtn, 36)
				claimBtn.Activated:Connect(function()
					Remotes.GetEvent(Constants.RemoteNames.RequestClaimBattlePassReward):FireServer(claimTier, "premium")
				end)
			end
		end
	end

	if rows == 0 then
		UIUtil.EmptyState(
			trackList,
			"No battle pass rows yet — earn XP from gameplay to unlock Free/Premium track rewards.",
			0
		)
	end
end


return ProgressionBattlePass
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="162">
              <Properties>
                <string name="Name">ProgressionUI</string>
                <string name="Source"><![CDATA[--!strict
--[[ Shared Progression UI helpers — reward formatting + debounced refresh. ]]

local ProgressionUI = {}

function ProgressionUI.FormatReward(reward: any): string
	if typeof(reward) ~= "table" then
		return ""
	end
	local parts = {}
	if typeof(reward.Cash) == "number" and reward.Cash > 0 then
		table.insert(parts, string.format("$%d", reward.Cash))
	end
	if typeof(reward.Gold) == "number" and reward.Gold > 0 then
		table.insert(parts, string.format("%dG", reward.Gold))
	end
	return table.concat(parts, " + ")
end

function ProgressionUI.Debounce(seconds: number): ((() -> ()) -> ())
	local token = 0
	return function(fn: () -> ())
		token += 1
		local my = token
		task.delay(seconds, function()
			if my == token then
				fn()
			end
		end)
	end
end

return ProgressionUI
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">PromptController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PromptController — v70 custom ProximityPrompt pills in the ACTION LANE (spec §3.5, §5, §6).

	Every ProximityPrompt in workspace gets Style = ProximityPromptStyle.Custom LOCALLY (a replicated property set on
	the client stays local), so Roblox stops drawing its floating cards and this controller draws the prompts as
	pills in one fixed slot above the hotbar (gui WE_PromptLane, bottom edge HudLayout.ActionLaneBottomV()):
	  * height 64 v on touch (the pill IS the tap target, 44.8 px on phones) / 50 v desktop, auto width ≥ 150 v
	  * FredokaOne ActionText (ObjectText only when ActionText is empty); desktop / gamepad show a key cap
	  * hold prompts fill left → right (PromptButtonHoldBegan / Ended); touch drives the engine's own hold timer
	    with prompt:InputHoldBegin() / InputHoldEnd() — the 0.35 s console hold and the 0.6 s gate-repair hold work
	  * a finger that slides off a pill or lifts anywhere releases the hold (UserInputService.TouchEnded /
	    InputEnded + TouchMoved past HOLD_SLOP_PX), and a stale hold never swallows the next tap (merge gate #4)
	  * at most 2 pills, side by side (E + F), centred; hidden while Modal or Dead; while Driving only the
	    vehicle's own prompts
	  * OWNER-ONLY: WE_ServerBuyPrompt / WE_PanelPrompt / WE_DrivePrompt on another player's plot or vehicle get
	    Enabled = false locally (no pill, no E)
	  * the console's own WE_ServerBuyPrompt pill hides while the BUY button shows (the desktop E-hold still works);
	    any other pill moves up one slot above the BUY button meanwhile

	The engine still owns triggering (keyboard / gamepad keys, hold timing, MaxActivationDistance, Triggered on the
	server) — nothing here grants anything. If Init fails before the pills exist, prompts keep the Default style
	(adoption runs LAST, after the lane and the PromptShown handlers are up — spec risk #2).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)

local PromptController = {}

local LANE = HudConfig.ActionLane
local COLORS = HudConfig.Colors
local FONT_DISPLAY = HudConfig.Fonts.Display
local FONT_BODY = HudConfig.Fonts.Body
local MAX_PILLS = 2
local PILL_BG_TRANSPARENCY = 0.16
local FILL_TRANSPARENCY = 0.72
-- a held finger may wander this far (real px) outside its pill before the hold is released (forgiving on touch)
local HOLD_SLOP_PX = 24

local OWNER_ONLY: { [string]: boolean } = {}
for _, n in ipairs(LANE.OwnerOnlyPromptNames) do
	OWNER_ONLY[n] = true
end

local player = Players.LocalPlayer

type Pill = {
	Prompt: ProximityPrompt,
	Button: TextButton,
	Fill: Frame,
	Label: TextLabel,
	KeyCap: Frame,
	KeyText: TextLabel,
	InputType: Enum.ProximityPromptInputType,
	Seq: number,
	Held: boolean,
	HoldInput: InputObject?, -- the touch / mouse input that started the current hold
	Conns: { RBXScriptConnection },
}

local screen: ScreenGui? = nil
local laneFrame: Frame? = nil
local pills: { [ProximityPrompt]: Pill } = {}
local pillSeq = 0
local adopted: { [ProximityPrompt]: boolean } = setmetatable({} :: any, { __mode = "k" })
local disabledByUs: { [ProximityPrompt]: boolean } = setmetatable({} :: any, { __mode = "k" })
local suppressed: { [ProximityPrompt]: boolean } = setmetatable({} :: any, { __mode = "k" })
local myPlotId: number? = nil
local buyActive = false
local started = false
local shutDown = false
local lanePending = false
local globalConns: { RBXScriptConnection } = {}

---------------------------------------------------------------------------------------------------------------
-- ownership
---------------------------------------------------------------------------------------------------------------

local function numAttr(inst: Instance, name: string): number?
	local v = inst:GetAttribute(name)
	if typeof(v) == "number" then
		return v
	end
	return nil
end

-- the plot a world object belongs to (PlotId / BasePlotId attribute on it or an ancestor, or a Bases.PlotN folder)
local function plotIdOf(inst: Instance?): number?
	local cur = inst
	while cur and cur ~= Workspace do
		local pid = numAttr(cur, "PlotId") or numAttr(cur, "BasePlotId")
		if pid then
			return pid
		end
		local parent = cur.Parent
		if parent and parent.Name == "Bases" then
			local n = tonumber(string.match(cur.Name, "^Plot(%d+)$"))
			if n then
				return n
			end
		end
		cur = parent
	end
	return nil
end

local function ownerUserIdOf(inst: Instance?): number?
	local cur = inst
	while cur and cur ~= Workspace do
		local uid = numAttr(cur, "OwnerUserId")
		if uid then
			return uid
		end
		cur = cur.Parent
	end
	return nil
end

local function currentPlotId(): number?
	if myPlotId then
		return myPlotId
	end
	local attr = player:GetAttribute("WE_PlotId")
	if typeof(attr) == "number" then
		return attr
	end
	return nil
end

-- true = an owner-only prompt that belongs to SOMEONE ELSE (ambiguous → false, like isOwnPlotPad)
local function isForeign(prompt: ProximityPrompt): boolean
	if not OWNER_ONLY[prompt.Name] then
		return false
	end
	if prompt.Name == "WE_DrivePrompt" then
		local uid = ownerUserIdOf(prompt.Parent)
		return uid ~= nil and uid ~= 0 and uid ~= player.UserId
	end
	local mine = currentPlotId()
	local pid = plotIdOf(prompt.Parent)
	if mine == nil or pid == nil then
		return false
	end
	return pid ~= mine
end

local function applyOwnerOnly(prompt: ProximityPrompt)
	if not OWNER_ONLY[prompt.Name] then
		return
	end
	if isForeign(prompt) then
		if prompt.Enabled then
			prompt.Enabled = false
		end
		disabledByUs[prompt] = true
	elseif disabledByUs[prompt] then
		disabledByUs[prompt] = nil
		prompt.Enabled = true
	end
end

---------------------------------------------------------------------------------------------------------------
-- pills
---------------------------------------------------------------------------------------------------------------

local function isTouch(): boolean
	return HudLayout.IsTouch()
end

local function measure(text: string, size: number, font: Enum.Font): Vector2
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, size, font, Vector2.new(2000, 1000))
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return v
	end
	return Vector2.new((utf8.len(text) or #text) * size * 0.55, size)
end

local function promptText(prompt: ProximityPrompt): string
	local a = prompt.ActionText
	if a ~= "" then
		return a
	end
	return prompt.ObjectText
end

local function keyLabel(pill: Pill): string?
	local p = pill.Prompt
	if pill.InputType == Enum.ProximityPromptInputType.Touch then
		return nil
	end
	if pill.InputType == Enum.ProximityPromptInputType.Gamepad then
		local n = p.GamepadKeyCode.Name
		return (string.gsub(n, "^Button", ""))
	end
	local k = p.KeyboardKeyCode
	if k.Name == "Unknown" then
		return nil
	end
	return k.Name
end

local function vehicleModelOfSeat(): Instance?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if not seat then
		return nil
	end
	local model = seat:FindFirstAncestorWhichIsA("Model")
	-- the vehicle is the outermost model under workspace (seats sit in sub-models)
	local cur: Instance? = model
	while cur and cur.Parent and cur.Parent ~= Workspace and cur.Parent:IsA("Model") do
		cur = cur.Parent
	end
	return cur or seat
end

local function pillWanted(pill: Pill, vehicle: Instance?): boolean
	local p = pill.Prompt
	if not p.Parent or not p.Enabled then
		return false
	end
	if suppressed[p] then
		return false
	end
	if buyActive and LANE.SuppressPromptWhenBuyButton and p.Name == "WE_ServerBuyPrompt" then
		return false
	end
	if HudLayout.GetFlag("Driving") then
		return vehicle ~= nil and p:IsDescendantOf(vehicle)
	end
	return true
end

local function sizePill(pill: Pill)
	local touch = isTouch()
	local h = if touch then LANE.PromptHeight else LANE.PromptHeightDesktop
	local text = promptText(pill.Prompt)
	pill.Label.Text = text
	local key = keyLabel(pill)
	local capW = 0
	if key then
		pill.KeyText.Text = key
		pill.KeyCap.Visible = true
		capW = LANE.KeyCapSize + 10
	else
		pill.KeyCap.Visible = false
	end
	local padL = if key then 8 else 20
	local padR = 20
	local tb = measure(text, LANE.PromptTextSize, FONT_DISPLAY)
	local textW = math.ceil(tb.X) + 4
	local w = math.max(LANE.PromptMinWidth, padL + capW + textW + padR)
	pill.Button.Size = UDim2.fromOffset(w, h)
	pill.KeyCap.Position = UDim2.new(0, padL, 0.5, 0)
	pill.KeyCap.Size = UDim2.fromOffset(LANE.KeyCapSize, LANE.KeyCapSize)
	-- centre the label in the space right of the key cap
	pill.Label.Position = UDim2.new(0, padL + capW, 0, 0)
	pill.Label.Size = UDim2.new(1, -(padL + capW + padR), 1, 0)
	local c = pill.Button:FindFirstChildOfClass("UICorner")
	if c then
		c.CornerRadius = UDim.new(0, math.floor(h / 2))
	end
	local fc = pill.Fill:FindFirstChildOfClass("UICorner")
	if fc then
		fc.CornerRadius = UDim.new(0, math.floor(h / 2))
	end
end

local function relayout()
	lanePending = false
	local lane = laneFrame
	if not lane then
		return
	end
	local vehicle = if HudLayout.GetFlag("Driving") then vehicleModelOfSeat() else nil
	local list: { Pill } = {}
	for _, pill in pairs(pills) do
		if pillWanted(pill, vehicle) then
			table.insert(list, pill)
		else
			pill.Button.Visible = false
		end
	end
	-- newest two win (E + F side by side); drawn oldest → newest, left → right
	table.sort(list, function(a: Pill, b: Pill): boolean
		return a.Seq > b.Seq
	end)
	local shown = 0
	local totalW = 0
	local h = if isTouch() then LANE.PromptHeight else LANE.PromptHeightDesktop
	for i, pill in ipairs(list) do
		if i <= MAX_PILLS then
			sizePill(pill)
			pill.Button.Visible = true
			pill.Button.LayoutOrder = pill.Seq
			totalW += pill.Button.Size.X.Offset
			shown += 1
		else
			pill.Button.Visible = false
		end
	end
	totalW += math.max(0, shown - 1) * LANE.PromptGap
	lane.Size = UDim2.fromOffset(math.max(1, totalW), h)
	-- the BUY button owns the lane slot while it shows: other pills (a terminal next to a console) sit just above it
	local bottom = HudLayout.ActionLaneBottomV()
	if buyActive then
		local buySize = if isTouch() then LANE.BuyButtonSizeTouch else LANE.BuyButtonSize
		bottom += buySize.Y.Offset + LANE.PromptGap
	end
	lane.Position = UDim2.new(0.5, 0, 1, -bottom)
	lane:SetAttribute("WE_PillCount", shown)
	HudLayout.RefreshVisibility(lane)
end

local function queueRelayout()
	if lanePending then
		return
	end
	lanePending = true
	task.defer(relayout)
end

local function endHold(pill: Pill)
	pill.HoldInput = nil
	if pill.Held then
		pill.Held = false
		pcall(function()
			pill.Prompt:InputHoldEnd()
		end)
	end
end

local function inputFinished(input: InputObject?): boolean
	if input == nil then
		return true
	end
	local st = input.UserInputState
	return st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel
end

-- merge gate #4: release every hold that `input` owns (it ended, or the finger left its pill). A hold whose input
-- is unknown is released by any touch / left-click end, so a missed InputEnded can never leave Held = true.
local function releaseHoldsOf(input: InputObject)
	for _, pill in pairs(pills) do
		if pill.Held and (pill.HoldInput == nil or pill.HoldInput == input or inputFinished(pill.HoldInput)) then
			endHold(pill)
		end
	end
end

local function outsidePill(pill: Pill, pos: Vector3): boolean
	local b = pill.Button
	local a, sz = b.AbsolutePosition, b.AbsoluteSize
	if sz.X <= 0 or sz.Y <= 0 then
		return false
	end
	-- InputObject.Position is in screen px with the topbar inset excluded, like AbsolutePosition of a gui that
	-- respects the inset; the slop covers the difference on guis with other insets
	local slop = HOLD_SLOP_PX
	return pos.X < a.X - slop or pos.X > a.X + sz.X + slop or pos.Y < a.Y - slop or pos.Y > a.Y + sz.Y + slop
end

local function resetFill(pill: Pill, seconds: number?)
	local t = seconds or 0.12
	pcall(function()
		TweenService:Create(pill.Fill, TweenInfo.new(t), { Size = UDim2.fromScale(0, 1) }):Play()
	end)
end

local function removePill(prompt: ProximityPrompt)
	local pill = pills[prompt]
	if not pill then
		return
	end
	pills[prompt] = nil
	endHold(pill)
	for _, c in ipairs(pill.Conns) do
		c:Disconnect()
	end
	pill.Button:Destroy()
	queueRelayout()
end

local function makePill(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): Pill?
	local lane = laneFrame
	if not lane then
		return nil
	end
	pillSeq += 1
	local btn = Instance.new("TextButton")
	btn.Name = "Pill"
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.BackgroundColor3 = COLORS.PillBg
	btn.BackgroundTransparency = PILL_BG_TRANSPARENCY
	btn.BorderSizePixel = 0
	btn.ClipsDescendants = true
	btn.Active = true
	btn.Selectable = false -- gamepad uses the prompt key, not GUI selection
	btn.Visible = false
	btn.LayoutOrder = pillSeq
	btn:SetAttribute("PromptName", prompt.Name)
	UIUtil.Corner(btn, 32)
	local stroke = UIUtil.Stroke(btn, COLORS.PillStroke, 2)
	stroke.Transparency = 0.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	local fill = Instance.new("Frame")
	fill.Name = "HoldFill"
	fill.BackgroundColor3 = LANE.HoldFill
	fill.BackgroundTransparency = FILL_TRANSPARENCY
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.Active = false
	fill.ZIndex = 1
	fill.Parent = btn
	UIUtil.Corner(fill, 32)

	local cap = Instance.new("Frame")
	cap.Name = "KeyCap"
	cap.AnchorPoint = Vector2.new(0, 0.5)
	cap.BackgroundColor3 = Color3.fromRGB(242, 244, 246)
	cap.BorderSizePixel = 0
	cap.Active = false
	cap.Visible = false
	cap.ZIndex = 2
	cap.Parent = btn
	UIUtil.Corner(cap, 8)
	local keyText = Instance.new("TextLabel")
	keyText.Name = "Key"
	keyText.BackgroundTransparency = 1
	keyText.Size = UDim2.fromScale(1, 1)
	keyText.Font = FONT_BODY
	keyText.TextSize = 17
	keyText.TextColor3 = Color3.fromRGB(21, 24, 27)
	keyText.ZIndex = 3
	keyText.Parent = cap

	local label = Instance.new("TextLabel")
	label.Name = "Action"
	label.BackgroundTransparency = 1
	label.Font = FONT_DISPLAY
	label.TextSize = LANE.PromptTextSize
	label.TextColor3 = COLORS.White
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 3
	label.Parent = btn
	UIUtil.TextOutline(label, 1.3)

	local pill: Pill = {
		Prompt = prompt,
		Button = btn,
		Fill = fill,
		Label = label,
		KeyCap = cap,
		KeyText = keyText,
		InputType = inputType,
		Seq = pillSeq,
		Held = false,
		HoldInput = nil,
		Conns = {},
	}

	-- touch / click: drive the engine's hold (HoldDuration 0 prompts trigger on InputHoldBegin)
	table.insert(pill.Conns, btn.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		local isTap = t == Enum.UserInputType.Touch or (t == Enum.UserInputType.MouseButton1 and prompt.ClickablePrompt)
		if not isTap or input.UserInputState == Enum.UserInputState.Change then
			return
		end
		if pill.Held then
			if pill.HoldInput ~= nil and pill.HoldInput ~= input and not inputFinished(pill.HoldInput) then
				return -- a second finger on a pill that is already held
			end
			endHold(pill) -- stale hold (its finger is gone): release it, then start this tap's hold
		end
		pill.Held = true
		pill.HoldInput = input
		pcall(function()
			prompt:InputHoldBegin()
		end)
	end))
	table.insert(pill.Conns, btn.InputEnded:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			endHold(pill)
		end
	end))
	table.insert(pill.Conns, prompt.PromptButtonHoldBegan:Connect(function()
		local secs = math.max(0.01, prompt.HoldDuration)
		fill.Size = UDim2.fromScale(0, 1)
		pcall(function()
			TweenService:Create(fill, TweenInfo.new(secs, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
		end)
	end))
	table.insert(pill.Conns, prompt.PromptButtonHoldEnded:Connect(function()
		resetFill(pill)
	end))
	table.insert(pill.Conns, prompt.Triggered:Connect(function()
		resetFill(pill, 0.2)
	end))
	for _, prop in ipairs({ "ActionText", "ObjectText", "KeyboardKeyCode", "GamepadKeyCode", "Enabled" }) do
		table.insert(pill.Conns, prompt:GetPropertyChangedSignal(prop):Connect(queueRelayout))
	end
	table.insert(pill.Conns, prompt.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removePill(prompt)
		end
	end))

	btn.Parent = lane
	return pill
end

---------------------------------------------------------------------------------------------------------------
-- adoption (Style = Custom) + service events
---------------------------------------------------------------------------------------------------------------

local function adopt(inst: Instance)
	if shutDown or not inst:IsA("ProximityPrompt") then
		return
	end
	local prompt: ProximityPrompt = inst
	if adopted[prompt] then
		return
	end
	adopted[prompt] = true
	pcall(function()
		prompt.Style = Enum.ProximityPromptStyle.Custom
	end)
	if OWNER_ONLY[prompt.Name] then
		applyOwnerOnly(prompt)
		prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
			-- the server re-replicating Enabled = true must not re-open someone else's console / terminal / car
			if prompt.Enabled and isForeign(prompt) then
				prompt.Enabled = false
				disabledByUs[prompt] = true
			end
		end)
	end
end

local function onShown(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	if not adopted[prompt] then
		adopt(prompt) -- a prompt the DescendantAdded sweep has not seen yet (takes effect from now on)
	end
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
		return -- the engine draws it (adoption refused)
	end
	if OWNER_ONLY[prompt.Name] and isForeign(prompt) then
		applyOwnerOnly(prompt)
		return
	end
	-- prompts the v70 HUD removed ("Open Base", "Hold to capture"): an older client-made copy never shows
	if prompt.Name == "WE_WorldPrompt" and table.find(LANE.RemovePrompts, prompt.ActionText) then
		prompt.Enabled = false
		return
	end
	local pill = pills[prompt]
	if pill then
		pill.InputType = inputType
	else
		local made = makePill(prompt, inputType)
		if not made then
			return
		end
		pills[prompt] = made
	end
	queueRelayout()
end

---------------------------------------------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------------------------------------------

--[[ WorldPromptController: the local player's plot (owner-only prompts re-evaluate). ]]
function PromptController.SetMyPlotId(plotId: number?)
	if myPlotId == plotId then
		return
	end
	myPlotId = plotId
	for prompt in pairs(adopted) do
		if prompt.Parent and OWNER_ONLY[prompt.Name] then
			applyOwnerOnly(prompt)
		end
	end
	queueRelayout()
end

--[[ WorldPromptController: the console BUY button is showing → hide WE_ServerBuyPrompt pills. ]]
function PromptController.SetBuyButtonActive(on: boolean)
	if buyActive == on then
		return
	end
	buyActive = on
	queueRelayout()
end

--[[ Hide one prompt's pill (the engine keeps its keyboard / gamepad key). E.g. a MAX or locked console. ]]
function PromptController.SetSuppressed(prompt: ProximityPrompt, on: boolean)
	if (suppressed[prompt] == true) == on then
		return
	end
	if on then
		suppressed[prompt] = true
	else
		suppressed[prompt] = nil
	end
	queueRelayout()
end

--[[ Is this owner-only prompt someone else's (WorldPromptController / tests). ]]
function PromptController.IsForeign(prompt: ProximityPrompt): boolean
	return isForeign(prompt)
end

function PromptController.Init()
	if started then
		return
	end
	started = true
	local pg = player:WaitForChild("PlayerGui")
	local old = pg:FindFirstChild("WE_PromptLane")
	if old then
		old:Destroy()
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "WE_PromptLane"
	sg.DisplayOrder = HudConfig.DisplayOrder.WE_PromptLane
	HudLayout.ApplyScreen(sg, { Insets = "Core" })

	local lane = Instance.new("Frame")
	lane.Name = "Lane"
	lane.AnchorPoint = Vector2.new(0.5, 1)
	lane.Position = UDim2.new(0.5, 0, 1, -HudLayout.ActionLaneBottomV())
	lane.Size = UDim2.fromOffset(1, LANE.PromptHeight)
	lane.BackgroundTransparency = 1
	lane.BorderSizePixel = 0
	lane.Active = false
	lane.Parent = sg
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, LANE.PromptGap)
	list.Parent = lane
	sg.Parent = pg
	screen = sg
	laneFrame = lane
	HudLayout.BindVisibility(lane, { HideWhen = LANE.HideWhen })
	HudLayout.SetRect("ActionLane", lane)

	-- handlers BEFORE adoption: a Custom prompt must never show without a pill
	local function keep(c: RBXScriptConnection)
		table.insert(globalConns, c)
	end
	keep(ProximityPromptService.PromptShown:Connect(onShown))
	keep(ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
		removePill(prompt)
	end))
	keep(HudLayout.FlagChanged:Connect(function(name: string, _on: boolean)
		if name == "Driving" or name == "Modal" or name == "Dead" then
			if name ~= "Driving" then
				for _, pill in pairs(pills) do
					endHold(pill)
				end
			end
			queueRelayout()
		end
	end))
	keep(HudLayout.LayoutChanged:Connect(queueRelayout))
	-- merge gate #4 backstop: a finger lifted anywhere (even off the pill, where the button's own InputEnded may
	-- never fire) releases its hold; a finger that slides off the pill releases it too
	keep(UserInputService.TouchEnded:Connect(function(input: InputObject)
		releaseHoldsOf(input)
	end))
	keep(UserInputService.InputEnded:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			releaseHoldsOf(input)
		end
	end))
	keep(UserInputService.TouchMoved:Connect(function(input: InputObject)
		for _, pill in pairs(pills) do
			if pill.Held and pill.HoldInput == input and outsidePill(pill, input.Position) then
				endHold(pill)
			end
		end
	end))
	keep(player:GetAttributeChangedSignal("WE_PlotId"):Connect(function()
		for prompt in pairs(adopted) do
			if prompt.Parent and OWNER_ONLY[prompt.Name] then
				applyOwnerOnly(prompt)
			end
		end
	end))

	-- adoption LAST (spec risk #2)
	keep(Workspace.DescendantAdded:Connect(function(inst: Instance)
		if inst:IsA("ProximityPrompt") then
			adopt(inst)
		end
	end))
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("ProximityPrompt") then
			pcall(adopt, inst)
		end
	end
	relayout()
end

--[[
	Back to Roblox's own prompt UI (UIController calls this when Init failed half-way — spec risk #2): every
	adopted prompt gets Style = Default again, the lane gui goes, no more adoption. Owner-only prompts on other
	players' plots stay disabled. Safe to call more than once.
]]
function PromptController.Shutdown()
	shutDown = true
	for _, c in ipairs(globalConns) do
		c:Disconnect()
	end
	table.clear(globalConns)
	for prompt in pairs(pills) do
		removePill(prompt)
	end
	for prompt in pairs(adopted) do
		pcall(function()
			prompt.Style = Enum.ProximityPromptStyle.Default
		end)
	end
	local sg = screen
	if sg then
		sg:Destroy()
	end
	screen = nil
	laneFrame = nil
end

--[[ QA: how many pills are holding their prompt right now (merge gate #4 harness check). ]]
function PromptController.GetHeldCount(): number
	local n = 0
	for _, pill in pairs(pills) do
		if pill.Held then
			n += 1
		end
	end
	return n
end

--[[ QA: texts of the pills on screen, left → right. ]]
function PromptController.GetPillTexts(): { string }
	local list: { Pill } = {}
	for _, pill in pairs(pills) do
		if pill.Button.Visible then
			table.insert(list, pill)
		end
	end
	table.sort(list, function(a: Pill, b: Pill): boolean
		return a.Seq < b.Seq
	end)
	local out = {}
	for _, pill in ipairs(list) do
		table.insert(out, pill.Label.Text)
	end
	return out
end

return PromptController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">ResearchController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v69 Research Lab panel: permanent upgrades for weapons, soldiers, vehicles and defenses.

	Opened from the Research Lab terminals. UIController routes WE_OpenPanel = "Research" to
	ResearchController.Open(tab), where tab is the prompt's WE_OpenTab ("Weapons", "Soldiers", "Vehicles", "Defenses").

	Display only. ResearchService (server) owns levels, prices and every check:
	  * ResearchStateUpdate is bound with Remotes.BindEvent (never blocks) and carries a ResearchStatePayload.
	  * Open fires RequestResearch("Sync"); a BUY tap fires RequestResearch("Buy", upgradeId).
	  * Prices come only from payload.Costs. ResearchConfig gives names, badges, effects, MaxLevel and LabLevelFor.
	  * The GUI is built lazily on the first Open, so Init cannot fail.

	Layout: an 800 x 340 logical panel, centred, scaled by its own UIScale (not UIUtil.PrepareScreen, whose 0.65
	floor would shrink the 56 px touch targets). Every tap target is at least 56 logical px in both dimensions.
	Text (mobile merge gate #2): nothing under TEXT_MIN = 17 logical px, i.e. ≥ 14 real px at the smallest fit
	scale (800x360 phone: 0.853). Effect lines wrap to two lines and each tab's page scrolls.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared") -- already loaded: the client Bootstrap waits for it
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local ResearchConfig = require(Shared.Configs.ResearchConfig)

local NotificationController = require(script.Parent.NotificationController)
local AudioController = require(script.Parent.Parent.Modules.AudioController)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout) -- v70: panel registry (one panel open → Modal)

type UpgradeDef = ResearchConfig.UpgradeDef
type ResearchLock = ResearchConfig.ResearchLock
type Payload = ResearchConfig.ResearchStatePayload

type RowStatus = {
	Kind: string, -- "Pending" | "Disabled" | "Maxed" | "NeedStructure" | "NeedLab" | "Locked" | "Unaffordable" | "CanBuy"
	Label: string, -- BUY button text
	Line: string?, -- replaces the effect line when set (plain text)
	LineColor: Color3?,
	Preview: boolean?, -- after Line, also show what the next level gives
	Reason: string, -- toast when a blocked button is tapped
}
type RowRefs = {
	Def: UpgradeDef,
	Frame: Frame,
	Stroke: UIStroke,
	Name: TextLabel,
	Effect: TextLabel,
	Pips: { Frame },
	PipStrokes: { UIStroke },
	Button: TextButton,
	BusyUntil: number,
	LastToastAt: number,
}
type TabRefs = { Button: TextButton, Bar: Frame, Title: TextLabel, Progress: TextLabel }

local ResearchController = {}

-- ── layout (logical px inside the 800 x 340 panel) ─────────────────────────────
local PANEL_W, PANEL_H = 800, 340
local HEADER_H = 60
local STRIPE_H = 4
local RAIL_X, RAIL_Y, RAIL_W, RAIL_H = 12, 66, 150, 262
local TAB_H, TAB_GAP = 58, 8
local CONTENT_X, CONTENT_Y, CONTENT_W, CONTENT_H = 174, 66, 614, 266
-- ≥ 14 real px at the smallest fit scale: FitScale(800, 302) = 0.853 on an 800x360 phone → 17 logical px
local TEXT_MIN = 17
local SCROLLBAR = 6
local ROW_W = CONTENT_W - SCROLLBAR - 4
local ROW_H, ROW_GAP, BANNER_H = 80, 6, 44
local BANNER_MAX_ROWS = 3 -- tabs with at most this many upgrades get the banner (grows to its text)
local BADGE_X, BADGE_SIZE = 9, 44
local TEXT_X = 62
local NAME_W = 292
local PIP_X, PIP_Y, PIP_W, PIP_H, PIP_GAP = 362, 12, 16, 10, 4
local BUY_W, BUY_H = 132, 56
local BUY_X = ROW_W - 8 - BUY_W
local EFFECT_W = BUY_X - 8 - TEXT_X
local EFFECT_Y, EFFECT_H = 32, 2 * TEXT_MIN + 6 -- two wrapped lines
local CLOSE_SIZE = 56
local FIT_MIN, FIT_MAX = 0.6, 1.3

local BUSY_SECONDS = 0.8
local BUSY_MAX_SECONDS = 4 -- a BUY stays busy until the server answers (it always pushes state after a Buy)
local SYNC_RETRY_SECONDS, SYNC_RETRY_MAX = 3, 5
local BLOCKED_TOAST_COOLDOWN = 0.6

local Colors = Constants.Colors
local COLOR = {
	Plate = Colors.PlateDark,
	Row = Colors.Background,
	Olive = Colors.Olive,
	Gold = Colors.GoldBright,
	Text = Colors.TextOnDark,
	TextDark = Colors.TextDark,
	Muted = Colors.Muted,
	Cash = Colors.Cash,
	Danger = Colors.Danger,
	Gunmetal = Colors.Gunmetal,
	Amber = Color3.fromRGB(230, 196, 70),
	Black = Color3.fromRGB(0, 0, 0),
}

local LOCK_FALLBACK_TEXT: { [string]: string } = {
	Disabled = "Coming soon",
	Maxed = "MAXED",
	NeedStructure = "Locked",
	NeedLab = "Needs a higher Research Lab level",
}

-- ── state ──────────────────────────────────────────────────────────────────────
local player = Players.LocalPlayer
local wired = false
local isOpen = false
local currentTab = ResearchConfig.TrackOrder[1] or "Weapons"
local state: Payload? = nil
local retryToken = 0
local statusOverride: string? = nil

local screen: ScreenGui? = nil
local panelScale: UIScale? = nil
local labChip: TextLabel? = nil
local cashLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local rows: { [string]: RowRefs } = {}
local awaitingReply: { [string]: number } = {} -- upgrade id -> earliest release (tap + BUSY_SECONDS)
local tabs: { [string]: TabRefs } = {}
local pages: { [string]: ScrollingFrame } = {}
local banners: { [string]: TextLabel } = {}

-- ── small helpers ──────────────────────────────────────────────────────────────
local function hex(c: Color3): string
	return string.format(
		"#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end

local function esc(s: string): string
	local out = string.gsub(s, "&", "&amp;")
	out = string.gsub(out, "<", "&lt;")
	out = string.gsub(out, ">", "&gt;")
	return out
end

local function paint(text: string, color: Color3): string
	return string.format('<font color="%s">%s</font>', hex(color), text)
end

local function bold(text: string): string
	return "<b>" .. text .. "</b>"
end

local function roman(n: number): string
	return ResearchConfig.Roman[n] or tostring(n)
end

local function cash(n: number): string
	return ResearchConfig.FormatCash(n)
end

local function currentCash(): number
	local v = tonumber(player:GetAttribute("WE_Cash"))
	if v == nil or v ~= v then
		return 0
	end
	return v
end

local function levelOf(id: string): number
	local st = state
	if st == nil then
		return 0
	end
	return ResearchConfig.LevelOf(st.Levels, id)
end

local function trackIdFrom(tab: any): string?
	if typeof(tab) ~= "string" then
		return nil
	end
	local want = string.lower(tab)
	for _, id in ipairs(ResearchConfig.TrackOrder) do
		if string.lower(id) == want then
			return id
		end
	end
	return nil
end

-- "%s weapon damage" -> "weapon damage" (the words after the amount), or nil for other formats
local function effectTail(def: UpgradeDef): string?
	local text = def.EffectText
	if string.sub(text, 1, 2) ~= "%s" then
		return nil
	end
	local tail = string.gsub(string.sub(text, 3), "^%s+", "")
	return tail
end

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3, thickness: number, borderMode: boolean?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	if borderMode then
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- on a TextButton, Contextual would outline the text
	end
	s.Parent = parent
	return s
end

local function frame(parent: Instance, name: string, x: number, y: number, w: number, h: number, color: Color3?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BorderSizePixel = 0
	if color then
		f.BackgroundColor3 = color
		f.BackgroundTransparency = 0
	else
		f.BackgroundTransparency = 1
	end
	f.Parent = parent
	return f
end

local function label(
	parent: Instance,
	name: string,
	x: number,
	y: number,
	w: number,
	h: number,
	font: Enum.Font,
	size: number,
	color: Color3,
	text: string
): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.Position = UDim2.fromOffset(x, y)
	l.Size = UDim2.fromOffset(w, h)
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Font = font
	l.TextSize = size
	l.TextColor3 = color
	l.Text = text
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.Parent = parent
	return l
end

local function maxTextSize(parent: Instance, maxSize: number, minSize: number)
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize
	c.MinTextSize = minSize
	c.Parent = parent
end

local function requestSync()
	task.spawn(function()
		Remotes.FireServer(Constants.RemoteNames.RequestResearch, "Sync")
	end)
end

-- ── row status (what the BUY button and the effect line show) ──────────────────
local function statusFor(def: UpgradeDef): RowStatus
	local st = state
	if st == nil then
		return { Kind = "Pending", Label = "…", Reason = "Connecting to the lab…" }
	end
	local lvl = ResearchConfig.LevelOf(st.Levels, def.Id)
	local target = lvl + 1
	local lock = st.Locks[def.Id]
	local code = if lock then lock.Code else nil
	if def.Enabled == false or code == "Disabled" then
		return {
			Kind = "Disabled",
			Label = "SOON",
			Line = if lock and lock.Text ~= "" then lock.Text else "Coming soon",
			LineColor = COLOR.Amber,
			Reason = def.DisplayName .. " — coming soon",
		}
	end
	if lvl >= def.MaxLevel or code == "Maxed" then
		return { Kind = "Maxed", Label = "MAXED", Reason = def.DisplayName .. " is fully researched" }
	end
	local trackLock = st.Tracks[def.Track]
	if code == "NeedStructure" or (trackLock ~= nil and code == nil) then
		-- the tab's banner already says what to build, so the row keeps its effect preview
		local text = if lock and lock.Text ~= "" then lock.Text elseif trackLock then trackLock.Text else "Locked"
		return { Kind = "NeedStructure", Label = "LOCKED", Reason = text }
	end
	if code == "NeedLab" then
		local need = ResearchConfig.LabLevelFor(def, target)
		return {
			Kind = "NeedLab",
			Label = string.format("LAB L%d", need),
			Line = string.format("Needs Lab L%d", need), -- short: the effect line wraps to 2 lines at TEXT_MIN
			LineColor = COLOR.Amber,
			Preview = true,
			Reason = string.format(
				"%s %s needs Research Lab L%d — upgrade the lab at its console",
				def.DisplayName,
				roman(target),
				need
			),
		}
	end
	if lock then
		-- a lock code this client does not know yet: trust the server's text
		local text = if lock.Text ~= "" then lock.Text else "Locked"
		return { Kind = "Locked", Label = "LOCKED", Line = text, LineColor = COLOR.Amber, Reason = text }
	end
	local cost = st.Costs[def.Id]
	if cost == nil then
		return { Kind = "Pending", Label = "…", Reason = "Price not loaded yet — close and reopen the panel" }
	end
	local short = math.ceil(cost - currentCash())
	if short > 0 then
		return {
			Kind = "Unaffordable",
			Label = cash(cost),
			Line = "Need " .. cash(short) .. " more",
			LineColor = COLOR.Danger,
			Preview = true,
			Reason = string.format("Not enough Cash — %s %s costs %s", def.DisplayName, roman(target), cash(cost)),
		}
	end
	return { Kind = "CanBuy", Label = "BUY " .. cash(cost), Reason = "" }
end

local function effectMarkup(def: UpgradeDef, lvl: number, status: RowStatus): string
	local tail = effectTail(def)
	if status.Line then
		local reason = paint(esc(status.Line), status.LineColor or COLOR.Amber)
		if not status.Preview or lvl >= def.MaxLevel then
			return reason
		end
		local nextLevel = lvl + 1
		local preview = if tail
			then bold(paint(ResearchConfig.FormatAmount(def, nextLevel), COLOR.Gold)) .. paint(" " .. esc(tail), COLOR.Muted)
			else paint(esc(ResearchConfig.FormatEffect(def, nextLevel)), COLOR.Muted)
		return reason .. paint(" · Next ", COLOR.Muted) .. preview
	end
	if status.Kind == "Maxed" then
		if tail then
			return paint("Max ", COLOR.Muted)
				.. bold(paint(ResearchConfig.FormatAmount(def, def.MaxLevel), COLOR.Cash))
				.. " "
				.. esc(tail)
		end
		return paint("Max: ", COLOR.Muted) .. esc(ResearchConfig.FormatEffect(def, def.MaxLevel))
	end
	local nowPart = if lvl > 0
		then paint("Now ", COLOR.Muted) .. bold(paint(ResearchConfig.FormatAmount(def, lvl), COLOR.Cash))
		else paint("No bonus yet", COLOR.Muted)
	local nextLevel = math.min(lvl + 1, def.MaxLevel)
	if tail then
		return nowPart
			.. paint(" › Next ", COLOR.Muted)
			.. bold(paint(ResearchConfig.FormatAmount(def, nextLevel), COLOR.Gold))
			.. " "
			.. esc(tail)
	end
	return nowPart .. paint(" › Next: ", COLOR.Muted) .. esc(ResearchConfig.FormatEffect(def, nextLevel))
end

local BUTTON_STYLE: { [string]: { Bg: Color3, Fg: Color3 } } = {
	CanBuy = { Bg = COLOR.Gold, Fg = COLOR.TextDark },
	Unaffordable = { Bg = COLOR.Gunmetal, Fg = COLOR.Danger },
	NeedLab = { Bg = COLOR.Gunmetal, Fg = COLOR.Muted },
	NeedStructure = { Bg = COLOR.Gunmetal, Fg = COLOR.Muted },
	Locked = { Bg = COLOR.Gunmetal, Fg = COLOR.Muted },
	Maxed = { Bg = COLOR.Olive, Fg = COLOR.Text },
	Disabled = { Bg = COLOR.Gunmetal, Fg = COLOR.Muted },
	Pending = { Bg = COLOR.Gunmetal, Fg = COLOR.Muted },
}

-- ── rendering ──────────────────────────────────────────────────────────────────
local function renderRow(row: RowRefs)
	local def = row.Def
	local lvl = levelOf(def.Id)
	local status = statusFor(def)
	local busy = os.clock() < row.BusyUntil

	local levelText = if lvl > 0 then roman(lvl) else "0"
	row.Name.Text = esc(string.upper(def.DisplayName))
		.. "  "
		.. paint(levelText .. " / " .. roman(def.MaxLevel), COLOR.Muted)
	row.Effect.Text = effectMarkup(def, lvl, status)

	for i, pip in ipairs(row.Pips) do
		local owned = i <= lvl
		pip.BackgroundColor3 = if owned then COLOR.Gold else COLOR.Gunmetal
		row.PipStrokes[i].Color = if owned then COLOR.Gold else COLOR.Olive
	end

	local style = BUTTON_STYLE[status.Kind] or BUTTON_STYLE.Pending
	local btn = row.Button
	btn.BackgroundColor3 = style.Bg
	btn.TextColor3 = style.Fg
	btn.Text = if busy then "…" else status.Label
	btn.AutoButtonColor = status.Kind == "CanBuy" and not busy
	btn:SetAttribute("WE_State", if busy then "Busy" else status.Kind)
end

local function renderTabs()
	local st = state
	for _, trackId in ipairs(ResearchConfig.TrackOrder) do
		local t = tabs[trackId]
		if t then
			local active = trackId == currentTab
			t.Button.BackgroundColor3 = if active then COLOR.Olive else COLOR.Gunmetal
			t.Bar.Visible = active
			t.Title.TextColor3 = if active then COLOR.Text else COLOR.Muted
			local trackDef = ResearchConfig.Tracks[trackId]
			if st == nil then
				t.Progress.Text = "…"
				t.Progress.TextColor3 = COLOR.Muted
			elseif st.Tracks[trackId] ~= nil then
				local req = trackDef and trackDef.Requires
				t.Progress.Text = if req then req.Short else "LOCKED"
				t.Progress.TextColor3 = COLOR.Amber
			else
				local owned, total = 0, 0
				for _, def in ipairs(ResearchConfig.UpgradesForTrack(trackId)) do
					owned += ResearchConfig.LevelOf(st.Levels, def.Id)
					total += def.MaxLevel
				end
				t.Progress.Text = string.format("%d/%d", owned, total)
				t.Progress.TextColor3 = if total > 0 and owned >= total then COLOR.Gold else COLOR.Muted
			end
		end
	end
end

local function bannerMarkup(trackId: string): string
	local trackDef = ResearchConfig.Tracks[trackId]
	local blurb = if trackDef then trackDef.Blurb else ""
	local st = state
	local trackLock = if st then st.Tracks[trackId] else nil
	if trackLock then
		local text = if trackLock.Text ~= "" then trackLock.Text else "Locked"
		return bold(paint(esc(text), COLOR.Amber)) .. "\n" .. paint(esc(blurb), COLOR.Muted)
	end
	local notes = {}
	for _, def in ipairs(ResearchConfig.UpgradesForTrack(trackId)) do
		local note = def.Note
		if note and note ~= "" then
			table.insert(notes, esc(def.DisplayName .. ": " .. string.lower(string.sub(note, 1, 1)) .. string.sub(note, 2)))
		end
	end
	local first = bold(paint(esc(blurb), COLOR.Text))
	if #notes == 0 then
		return first
	end
	return first .. "\n" .. paint(table.concat(notes, "  ·  "), COLOR.Muted)
end

-- the banner grows to its (wrapped) text: the page scrolls, so nothing is ever clipped or shrunk
local function fitBanner(caption: TextLabel)
	local plain = string.gsub(caption.Text, "<[^>]*>", "")
	plain = string.gsub(plain, "&lt;", "<")
	plain = string.gsub(plain, "&gt;", ">")
	plain = string.gsub(plain, "&amp;", "&")
	local lines = 0
	for _, part in ipairs(string.split(plain, "\n")) do
		local ok, v = pcall(function(): Vector2
			return TextService:GetTextSize(part, TEXT_MIN, Enum.Font.Gotham, Vector2.new(ROW_W - 24, 1000))
		end)
		local h = if ok and typeof(v) == "Vector2" and v.Y > 0
			then v.Y
			else math.ceil(((utf8.len(part) or #part) * TEXT_MIN * 0.5) / (ROW_W - 24)) * TEXT_MIN
		lines += math.max(1, math.floor(h / TEXT_MIN + 0.5))
	end
	local h = math.max(BANNER_H, math.ceil(lines * TEXT_MIN * caption.LineHeight) + 10)
	caption.Size = UDim2.fromOffset(ROW_W - 24, h)
	local banner = caption.Parent
	if banner and banner:IsA("Frame") then
		banner.Size = UDim2.fromOffset(ROW_W, h)
	end
end

local function renderAll()
	if not screen then
		return
	end
	local st = state
	if labChip then
		if st == nil then
			labChip.Text = "LAB —"
			labChip.TextColor3 = COLOR.Text
		elseif st.LabLevel <= 0 then
			labChip.Text = "NO LAB"
			labChip.TextColor3 = COLOR.Amber
		else
			labChip.Text = string.format("LAB L%d", st.LabLevel)
			labChip.TextColor3 = COLOR.Text
		end
	end
	if cashLabel then
		cashLabel.Text = cash(currentCash())
	end
	renderTabs()
	for trackId, page in pairs(pages) do
		page.Visible = st ~= nil and trackId == currentTab
	end
	for trackId, banner in pairs(banners) do
		banner.Text = bannerMarkup(trackId)
		fitBanner(banner)
	end
	for _, row in pairs(rows) do
		renderRow(row)
	end
	if statusLabel then
		statusLabel.Visible = st == nil
		statusLabel.Text = statusOverride or "Connecting to the lab…"
	end
end

local function flashRow(row: RowRefs, fromLevel: number, toLevel: number)
	row.Stroke.Color = COLOR.Gold
	row.Stroke.Thickness = 3
	TweenService:Create(
		row.Stroke,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Color = COLOR.Gunmetal, Thickness = 1 }
	):Play()
	for i = fromLevel + 1, math.min(toLevel, #row.Pips) do
		local pip = row.Pips[i]
		pip.Size = UDim2.fromOffset(PIP_W * 0.8, PIP_H * 0.8)
		TweenService:Create(
			pip,
			TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Size = UDim2.fromOffset(PIP_W, PIP_H) }
		):Play()
	end
end

-- ── taps ───────────────────────────────────────────────────────────────────────
local function onBuyTapped(row: RowRefs)
	local now = os.clock()
	if now < row.BusyUntil then
		return
	end
	local status = statusFor(row.Def)
	if status.Kind ~= "CanBuy" then
		if status.Kind == "Pending" then
			requestSync()
		end
		if now - row.LastToastAt >= BLOCKED_TOAST_COOLDOWN then
			row.LastToastAt = now
			pcall(NotificationController.Show, status.Reason, "Info", 2)
		end
		return
	end
	-- busy until the reply payload (never a second buy at a stale price on a laggy phone), 0.8 s minimum
	row.BusyUntil = now + BUSY_MAX_SECONDS
	renderRow(row)
	local id = row.Def.Id
	awaitingReply[id] = now + BUSY_SECONDS
	task.spawn(function()
		Remotes.FireServer(Constants.RemoteNames.RequestResearch, "Buy", id)
	end)
	pcall(AudioController.PlayClick)
	-- the server answers with a toast + ResearchStateUpdate; restore the label if nothing changed
	task.delay(BUSY_SECONDS + 0.05, function()
		if rows[id] == row then
			renderRow(row)
		end
	end)
	task.delay(BUSY_MAX_SECONDS + 0.05, function()
		if rows[id] == row then
			awaitingReply[id] = nil
			renderRow(row)
		end
	end)
end

local function selectTab(trackId: string)
	currentTab = trackId
	renderAll()
end

-- ── build (lazy, on the first Open) ────────────────────────────────────────────
local function updateScale()
	local gui = screen
	local sc = panelScale
	if not (gui and sc) then
		return
	end
	local w, h = 0, 0
	local abs: any = gui.AbsoluteSize
	if typeof(abs) == "Vector2" then
		w, h = abs.X, abs.Y
	end
	if w <= 1 or h <= 1 then
		-- not laid out yet: use the viewport minus a worst-case topbar (IgnoreGuiInset is false)
		local cam = workspace.CurrentCamera
		if cam then
			w, h = cam.ViewportSize.X, cam.ViewportSize.Y - 58
		end
	end
	if w > 1 and h > 1 then
		sc.Scale = ResearchController.FitScale(w, h)
	end
end

local function buildRow(parent: Instance, def: UpgradeDef): RowRefs
	local f = frame(parent, "Row_" .. def.Id, 0, 0, ROW_W, ROW_H, COLOR.Row)
	f.LayoutOrder = 10 + def.Order
	corner(f, 8)
	local rowStroke = stroke(f, COLOR.Gunmetal, 1)

	local badge = frame(f, "Badge", BADGE_X, math.floor((ROW_H - BADGE_SIZE) / 2), BADGE_SIZE, BADGE_SIZE, COLOR.Olive)
	corner(badge, 6)
	local badgeText = label(badge, "Caption", 0, 0, BADGE_SIZE, BADGE_SIZE, Enum.Font.GothamBlack, TEXT_MIN, COLOR.Gold, def.Badge)
	badgeText.TextXAlignment = Enum.TextXAlignment.Center

	local name = label(f, "Title", TEXT_X, 6, NAME_W, 24, Enum.Font.GothamBold, 18, COLOR.Text, "")
	name.RichText = true
	name.TextTruncate = Enum.TextTruncate.AtEnd

	local effect = label(f, "Effect", TEXT_X, EFFECT_Y, EFFECT_W, EFFECT_H, Enum.Font.Gotham, TEXT_MIN, COLOR.Text, "")
	effect.RichText = true
	-- two lines at TEXT_MIN (never shrinks under 14 real px): "Needs Research Lab L4 · Next +20% gate guard and
	-- auto-gun damage" wraps instead of scaling down
	effect.TextWrapped = true
	effect.TextYAlignment = Enum.TextYAlignment.Top

	local pipBox = frame(f, "Pips", PIP_X, PIP_Y, def.MaxLevel * (PIP_W + PIP_GAP) - PIP_GAP, PIP_H)
	local pips: { Frame } = {}
	local pipStrokes: { UIStroke } = {}
	for i = 1, def.MaxLevel do
		local pip = Instance.new("Frame")
		pip.Name = "Pip" .. i
		pip.AnchorPoint = Vector2.new(0.5, 0.5)
		pip.Position = UDim2.fromOffset((i - 1) * (PIP_W + PIP_GAP) + PIP_W / 2, PIP_H / 2)
		pip.Size = UDim2.fromOffset(PIP_W, PIP_H)
		pip.BackgroundColor3 = COLOR.Gunmetal
		pip.BorderSizePixel = 0
		pip.Parent = pipBox
		corner(pip, 2)
		pips[i] = pip
		pipStrokes[i] = stroke(pip, COLOR.Olive, 1)
	end

	local btn = Instance.new("TextButton")
	btn.Name = "Buy"
	btn.Position = UDim2.fromOffset(BUY_X, math.floor((ROW_H - BUY_H) / 2))
	btn.Size = UDim2.fromOffset(BUY_W, BUY_H)
	btn.BackgroundColor3 = COLOR.Gunmetal
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.GothamBold
	btn.TextScaled = true
	btn.TextSize = 18
	btn.TextColor3 = COLOR.Muted
	btn.Text = "…"
	btn.Parent = f
	corner(btn, 8)
	maxTextSize(btn, 18, TEXT_MIN)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = btn

	local row: RowRefs = {
		Def = def,
		Frame = f,
		Stroke = rowStroke,
		Name = name,
		Effect = effect,
		Pips = pips,
		PipStrokes = pipStrokes,
		Button = btn,
		BusyUntil = 0,
		LastToastAt = -math.huge,
	}
	btn.Activated:Connect(function()
		onBuyTapped(row)
	end)
	return row
end

local function build(): boolean
	local pg = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if pg == nil then
		error("PlayerGui missing", 0)
	end
	rows, tabs, pages, banners = {}, {}, {}, {}

	local gui = Instance.new("ScreenGui")
	gui.Name = "WE_Research"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = 60 -- modal panels; toasts are at 70
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false

	-- swallows camera drags behind the panel; tapping it does not close the panel
	local backdrop = frame(gui, "Backdrop", 0, 0, 0, 0, COLOR.Black)
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundTransparency = 0.45
	backdrop.Active = true

	local panel = frame(gui, "Panel", 0, 0, PANEL_W, PANEL_H, COLOR.Plate)
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Active = true
	panel.ZIndex = 2
	corner(panel, 10)
	stroke(panel, COLOR.Olive, 2)
	local sc = Instance.new("UIScale")
	sc.Name = "FitScale"
	sc.Parent = panel
	panelScale = sc

	-- header
	local header = frame(panel, "Header", 0, 0, PANEL_W, HEADER_H)
	label(header, "Title", 18, 7, 196, 28, Enum.Font.GothamBlack, 22, COLOR.Gold, "RESEARCH LAB")
	local chip = label(header, "LabChip", 220, 7, 92, 28, Enum.Font.GothamBold, TEXT_MIN, COLOR.Text, "LAB —")
	chip.BackgroundColor3 = COLOR.Olive
	chip.BackgroundTransparency = 0
	chip.TextXAlignment = Enum.TextXAlignment.Center
	corner(chip, 6)
	labChip = chip
	label(
		header,
		"Sub",
		18,
		37,
		440,
		TEXT_MIN + 3,
		Enum.Font.Gotham,
		TEXT_MIN,
		COLOR.Muted,
		"Permanent upgrades · kept through Rebirth"
	)

	local closeX = PANEL_W - 12 - CLOSE_SIZE
	local cashBox = frame(header, "CashChip", closeX - 10 - 170, 12, 170, 36, COLOR.Row)
	corner(cashBox, 8)
	stroke(cashBox, COLOR.Gunmetal, 1)
	local cashText = label(cashBox, "Amount", 10, 0, 150, 36, Enum.Font.GothamBold, 18, COLOR.Cash, cash(currentCash()))
	cashText.TextXAlignment = Enum.TextXAlignment.Center
	cashText.TextScaled = true
	maxTextSize(cashText, 18, TEXT_MIN)
	cashLabel = cashText

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.Position = UDim2.fromOffset(closeX, 2)
	close.Size = UDim2.fromOffset(CLOSE_SIZE, CLOSE_SIZE)
	close.BackgroundColor3 = COLOR.Gunmetal
	close.BorderSizePixel = 0
	close.Font = Enum.Font.GothamBlack
	close.TextSize = 22
	close.TextColor3 = COLOR.Text
	close.Text = "X"
	close.Parent = header
	corner(close, 8)
	close.Activated:Connect(function()
		pcall(AudioController.PlayClick)
		ResearchController.Close()
	end)

	-- hazard stripe under the header: gold tape with dark notches
	local stripe = frame(panel, "Stripe", 0, HEADER_H, PANEL_W, STRIPE_H, COLOR.Gold)
	local notchX = 14
	local n = 0
	while notchX + 10 <= PANEL_W - 14 do
		n += 1
		frame(stripe, "Notch" .. n, notchX, 0, 10, STRIPE_H, COLOR.Plate)
		notchX += 26
	end

	-- tab rail
	local rail = frame(panel, "Rail", RAIL_X, RAIL_Y, RAIL_W, RAIL_H)
	for i, trackId in ipairs(ResearchConfig.TrackOrder) do
		local trackDef = ResearchConfig.Tracks[trackId]
		local b = Instance.new("TextButton")
		b.Name = "Tab_" .. trackId
		b.Position = UDim2.fromOffset(0, (i - 1) * (TAB_H + TAB_GAP))
		b.Size = UDim2.fromOffset(RAIL_W, TAB_H)
		b.BackgroundColor3 = COLOR.Gunmetal
		b.BorderSizePixel = 0
		b.Text = ""
		b.AutoButtonColor = true
		b.Parent = rail
		corner(b, 8)
		local bar = frame(b, "Bar", 0, 0, 4, TAB_H, COLOR.Gold)
		bar.Visible = false
		local title = label(
			b,
			"Label",
			14,
			7,
			RAIL_W - 20,
			TEXT_MIN + 5,
			Enum.Font.GothamBold,
			TEXT_MIN,
			COLOR.Muted,
			string.upper(if trackDef then trackDef.DisplayName else trackId)
		)
		local progress = label(b, "Progress", 14, 31, RAIL_W - 20, TEXT_MIN + 3, Enum.Font.Gotham, TEXT_MIN, COLOR.Muted, "…")
		tabs[trackId] = { Button = b, Bar = bar, Title = title, Progress = progress }
		b.Activated:Connect(function()
			if currentTab ~= trackId then
				pcall(AudioController.PlayClick)
			end
			selectTab(trackId)
		end)
	end

	-- content: one page per track (optional banner + upgrade rows)
	local content = frame(panel, "Content", CONTENT_X, CONTENT_Y, CONTENT_W, CONTENT_H)
	for _, trackId in ipairs(ResearchConfig.TrackOrder) do
		-- a scrolling page: rows are 80 px (two-line effects at TEXT_MIN), so a 4-upgrade tab scrolls on phones
		local page = Instance.new("ScrollingFrame")
		page.Name = "Page_" .. trackId
		page.Position = UDim2.fromOffset(0, 0)
		page.Size = UDim2.fromOffset(CONTENT_W, CONTENT_H)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = SCROLLBAR
		page.ScrollingDirection = Enum.ScrollingDirection.Y
		page.CanvasSize = UDim2.fromOffset(0, 0)
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.ElasticBehavior = Enum.ElasticBehavior.Always
		page.Parent = content
		page.Visible = false
		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Vertical
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Padding = UDim.new(0, ROW_GAP)
		list.Parent = page
		local defs = ResearchConfig.UpgradesForTrack(trackId)
		if #defs <= BANNER_MAX_ROWS then
			local banner = frame(page, "Banner", 0, 0, ROW_W, BANNER_H, COLOR.Olive)
			banner.BackgroundTransparency = 0.72
			banner.LayoutOrder = 0
			corner(banner, 6)
			local text = label(banner, "Caption", 12, 0, ROW_W - 24, BANNER_H, Enum.Font.Gotham, TEXT_MIN, COLOR.Muted, "")
			text.RichText = true
			text.TextWrapped = true
			text.LineHeight = 1.05
			banners[trackId] = text
		end
		for _, def in ipairs(defs) do
			rows[def.Id] = buildRow(page, def)
		end
		pages[trackId] = page
	end
	local status = label(content, "Status", 0, 0, CONTENT_W, CONTENT_H, Enum.Font.GothamBold, 18, COLOR.Muted, "")
	status.TextXAlignment = Enum.TextXAlignment.Center
	status.TextWrapped = true
	statusLabel = status

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
	gui.Parent = pg
	screen = gui
	updateScale()
	return true
end

local function ensureBuilt(): boolean
	local gui = screen
	if gui and gui.Parent then
		return true
	end
	if gui then
		gui:Destroy()
		screen = nil
	end
	local ok, err = pcall(build)
	if not ok then
		warn("[WAR EMPIRE] Research panel build failed:", err)
		local partial = screen
		if partial then
			partial:Destroy()
			screen = nil
		end
		return false
	end
	return screen ~= nil
end

-- ── server state ───────────────────────────────────────────────────────────────
local function readLocks(raw: any): { [string]: ResearchLock }
	local out: { [string]: ResearchLock } = {}
	if typeof(raw) ~= "table" then
		return out
	end
	for id, lk in pairs(raw) do
		if typeof(id) == "string" and typeof(lk) == "table" and typeof(lk.Code) == "string" then
			local text = if typeof(lk.Text) == "string" then lk.Text else (LOCK_FALLBACK_TEXT[lk.Code] or "")
			out[id] = { Code = lk.Code, Text = text }
		end
	end
	return out
end

local function sanitize(payload: any): Payload?
	if typeof(payload) ~= "table" then
		return nil
	end
	local lab = payload.LabLevel
	if typeof(payload.Levels) ~= "table" or typeof(payload.Costs) ~= "table" then
		return nil
	end
	if typeof(lab) ~= "number" or lab ~= lab then
		return nil
	end
	local levels: { [string]: number } = {}
	for id, v in pairs(payload.Levels) do
		if typeof(id) == "string" and typeof(v) == "number" and v == v then
			levels[id] = v
		end
	end
	local costs: { [string]: number } = {}
	for id, v in pairs(payload.Costs) do
		if typeof(id) == "string" and typeof(v) == "number" and v == v and v > 0 and v < math.huge then
			costs[id] = v
		end
	end
	return {
		LabLevel = math.floor(lab),
		Levels = levels,
		Costs = costs,
		Locks = readLocks(payload.Locks),
		Tracks = readLocks(payload.Tracks),
	}
end

local function onState(payload: any)
	local st = sanitize(payload)
	if st == nil then
		return
	end
	local prev = state
	state = st
	statusOverride = nil
	local t = os.clock()
	for id, minUntil in pairs(awaitingReply) do
		local row = rows[id]
		if row and row.BusyUntil > t then
			row.BusyUntil = math.max(minUntil, t)
		end
		awaitingReply[id] = nil
	end
	if not (isOpen and screen) then
		return
	end
	renderAll()
	if prev then
		for id, row in pairs(rows) do
			local was = ResearchConfig.LevelOf(prev.Levels, id)
			local now = ResearchConfig.LevelOf(st.Levels, id)
			if now > was then
				flashRow(row, was, now)
			end
		end
	end
end

local function onCashChanged()
	if not (isOpen and screen) then
		return
	end
	if cashLabel then
		cashLabel.Text = cash(currentCash())
	end
	for _, row in pairs(rows) do
		renderRow(row)
	end
end

local function startSyncRetries()
	retryToken += 1
	local token = retryToken
	task.spawn(function()
		for _ = 1, SYNC_RETRY_MAX do
			task.wait(SYNC_RETRY_SECONDS)
			if token ~= retryToken or not isOpen or state ~= nil then
				return
			end
			requestSync()
		end
		task.wait(SYNC_RETRY_SECONDS)
		if token == retryToken and isOpen and state == nil then
			statusOverride = "The lab is not answering. Close and reopen the panel to try again."
			renderAll()
		end
	end)
end

local function wire()
	if wired then
		return
	end
	wired = true
	Remotes.BindEvent(Constants.RemoteNames.ResearchStateUpdate, onState)
	player:GetAttributeChangedSignal("WE_Cash"):Connect(onCashChanged)
end

-- ── public API ─────────────────────────────────────────────────────────────────
-- Panel scale for a ScreenGui of w x h px: the 800 x 340 panel fits with a 12 px margin each side.
function ResearchController.FitScale(w: number, h: number): number
	return math.clamp(math.min((w - 24) / PANEL_W, (h - 12) / PANEL_H), FIT_MIN, FIT_MAX)
end

function ResearchController.Init()
	wire()
	-- v70 (spec §3.8): one panel open at a time; the Modal flag hides the hotbar / prompt lane / BUY underneath.
	-- The panel keeps its own Backdrop (0.45 black) as the dim.
	HudLayout.RegisterPanel("Research", function(): boolean
		return isOpen
	end, function()
		ResearchController.Close()
	end)
end

function ResearchController.Open(tab: any?)
	wire()
	if not ensureBuilt() then
		pcall(NotificationController.Show, "Research panel failed to load — try again", "Warn", 3)
		return
	end
	local gui = screen
	if gui == nil then
		return
	end
	local trackId = trackIdFrom(tab)
	if trackId then
		currentTab = trackId
	end
	isOpen = true
	gui.Enabled = true
	HudLayout.PanelOpened("Research")
	statusOverride = nil
	updateScale()
	renderAll()
	requestSync() -- every Open: also picks up a Lab reset by Rebirth
	if state == nil then
		startSyncRetries()
	end
end

function ResearchController.Close()
	isOpen = false
	retryToken += 1
	local gui = screen
	if gui then
		gui.Enabled = false
	end
	HudLayout.PanelClosed("Research")
end

function ResearchController.Toggle()
	if isOpen then
		ResearchController.Close()
	else
		ResearchController.Open(nil)
	end
end

function ResearchController.IsOpen(): boolean
	return isOpen
end

return ResearchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Lightweight Settings panel — music/SFX local toggles, redeem codes, the supply spinner and the controls sheet.
	v70 "clean screen": opened ONLY from the TopStrip gear (UIController → SettingsController.Toggle) or a
	terminal. No key (O was Roblox camera zoom-out; HudConfig.Keys.Settings = nil). The keybind sheet is generated
	from HudConfig.Keys, so it can never drift from the real bindings; it shows ONLY while HudLayout.PrefersKeys()
	(UserInputService.PreferredInput keyboard / gamepad — mobile merge gate #7: phone players are never told to
	press keys). A registered Modal panel (HudLayout id "Settings") with the black dim; one HUD scale + safe area;
	every tappable ≥ 44 real px on touch.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local HudConfig = require(Shared.Configs.HudConfig)

local ClientSettings = require(script.Parent.Parent.Modules.ClientSettings)
local AudioController = require(script.Parent.Parent.Modules.AudioController)
local PanelShell = require(script.Parent.Parent.Modules.PanelShell)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)

local SettingsController = {}

local PANEL_ID = "Settings"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local open = false
local screenGui: ScreenGui? = nil
local shell: PanelShell.Shell? = nil
local musicBtn: TextButton? = nil
local sfxBtn: TextButton? = nil

-- key cap text for a KeyCode (anything not listed shows its Enum name, e.g. "P")
local KEY_NAMES: { [string]: string } = {
	One = "1",
	Two = "2",
	Three = "3",
	Four = "4",
	ButtonR2 = "R2",
	ButtonR1 = "R1",
	ButtonL1 = "L1",
	ButtonY = "Y pad",
	ButtonX = "X pad",
	DPadUp = "D-pad Up",
}

local function keyName(k: Enum.KeyCode?): string
	if k == nil then
		return "—"
	end
	return KEY_NAMES[k.Name] or k.Name
end

local function keyRange(list: { Enum.KeyCode }?): string
	if not list or #list == 0 then
		return "—"
	end
	if #list == 1 then
		return keyName(list[1])
	end
	return keyName(list[1]) .. "-" .. keyName(list[#list])
end

export type KeyRow = { Key: string, Action: string }
export type KeySection = { Title: string, Rows: { KeyRow } }

--[[ The controls sheet, generated from HudConfig.Keys (spec §7). Exposed for tests. ]]
function SettingsController.BuildKeySheet(): { KeySection }
	local K = HudConfig.Keys
	local panels: { KeyRow } = {
		{ Key = keyName(K.Shop), Action = "Shop" },
		{ Key = keyName(K.Rebirth), Action = "Rebirth · Battle Pass · Clan" },
		{ Key = keyName(K.Army), Action = "Army orders (popover)" },
		{ Key = keyName(K.Garage), Action = "Garage" },
		{ Key = keyName(K.Missions), Action = "Missions · daily reward" },
		{ Key = keyName(K.Base), Action = "Base upgrades menu" },
	}
	if K.Settings == nil then
		table.insert(panels, { Key = "Gear", Action = "Settings (top bar button)" })
	else
		table.insert(panels, { Key = keyName(K.Settings), Action = "Settings" })
	end
	local combat: { KeyRow } = {
		{ Key = keyRange(K.Weapons), Action = "Draw / holster a hotbar weapon" },
		{ Key = keyName(K.WeaponPrev), Action = "Previous weapon" },
		{ Key = keyName(K.Reload), Action = "Reload" },
	}
	if K.WeaponWheel then
		table.insert(combat, { Key = "Wheel", Action = "Cycle weapons while drawn" })
	end
	if K.FireNeedsDrawn then
		table.insert(combat, { Key = "LMB", Action = "Fire (weapon drawn)" })
	else
		table.insert(combat, { Key = "LMB", Action = "Fire" })
	end
	local orders: { KeyRow } = {
		{ Key = keyName(K.OrdersCycle), Action = "Cycle the squad order" },
		{ Key = keyRange(K.Weapons), Action = "Squad orders while the Army popover is open" },
		{ Key = "E / F", Action = "Interact · terminals" },
	}
	local pad: { KeyRow } = {}
	local G = K.Gamepad
	if G then
		table.insert(pad, { Key = keyName(G.Fire), Action = "Fire" })
		table.insert(pad, { Key = keyName(G.Reload), Action = "Reload" })
		table.insert(pad, { Key = keyName(G.Next) .. " / " .. keyName(G.Prev), Action = "Next / previous weapon" })
		table.insert(pad, { Key = keyName(G.DrawHolster), Action = "Draw / holster" })
	end
	local sections: { KeySection } = {
		{ Title = "PANELS", Rows = panels },
		{ Title = "COMBAT", Rows = combat },
		{ Title = "SQUAD & WORLD", Rows = orders },
	}
	if #pad > 0 then
		table.insert(sections, { Title = "GAMEPAD", Rows = pad })
	end
	return sections
end

local function setOpen(isOpen: boolean)
	open = isOpen
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = isOpen
		end
	end
	local sh = shell
	if sh then
		sh.Sync(isOpen)
	end
end

local function refreshToggleLabels()
	if musicBtn then
		musicBtn.Text = if ClientSettings.GetMusicEnabled() then "Music: ON" else "Music: OFF"
		musicBtn.BackgroundColor3 = if ClientSettings.GetMusicEnabled() then Constants.Colors.Accent else Constants.Colors.Background
	end
	if sfxBtn then
		sfxBtn.Text = if ClientSettings.GetSfxEnabled() then "SFX: ON" else "SFX: OFF"
		sfxBtn.BackgroundColor3 = if ClientSettings.GetSfxEnabled() then Constants.Colors.Accent else Constants.Colors.Background
	end
end

function SettingsController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireSettings"
	PanelShell.Screen(screen) -- DisplayOrder 60 (Panels), one HUD scale + safe area
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()
	local GAP = 8

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.94, 0, 1, -16) else UDim2.fromOffset(460, 580)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = screen
	UIUtil.Corner(panel, 12)
	UIUtil.Stroke(panel)
	do
		local cap = Instance.new("UISizeConstraint")
		cap.MaxSize = if isTouch then Vector2.new(760, 620) else Vector2.new(460, 580)
		cap.Parent = panel
	end

	PanelShell.Title(panel, "Settings")
	PanelShell.CloseButton(panel, function()
		AudioController.PlayClick()
		setOpen(false)
	end)

	local headerH = TAP + 8
	local body = Instance.new("ScrollingFrame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Position = UDim2.fromOffset(0, headerH)
	body.Size = UDim2.new(1, 0, 1, -(headerH + 8))
	body.ScrollBarThickness = if isTouch then 6 else 4
	body.ScrollingDirection = Enum.ScrollingDirection.Y
	body.CanvasSize = UDim2.fromOffset(0, 0)
	body.Parent = panel

	local y = 0
	local host: GuiObject = body -- where section() / button() / the key rows go (the KeySheet frame for the sheet)
	local sectionSize = PanelShell.Text(14)
	local function section(text: string)
		local lab = Instance.new("TextLabel")
		lab.BackgroundTransparency = 1
		lab.Position = UDim2.fromOffset(16, y)
		lab.Size = UDim2.new(1, -32, 0, sectionSize + 6)
		lab.Font = Enum.Font.GothamBold
		lab.TextSize = sectionSize
		lab.TextXAlignment = Enum.TextXAlignment.Left
		lab.TextColor3 = Constants.Colors.Gold
		lab.Text = text
		lab.Parent = host
		y += sectionSize + 10
	end
	local function button(name: string, text: string, x: UDim, w: UDim, color: Color3?): TextButton
		local b = Instance.new("TextButton")
		b.Name = name
		b.Position = UDim2.new(x.Scale, x.Offset, 0, y)
		b.Size = UDim2.new(w.Scale, w.Offset, 0, TAP)
		b.BackgroundColor3 = color or Constants.Colors.Accent
		b.Font = Enum.Font.GothamBold
		b.TextSize = PanelShell.Text(13)
		b.TextColor3 = Constants.Colors.Text
		b.TextWrapped = true
		b.Text = text
		b.BorderSizePixel = 0
		b.Active = true
		UIUtil.Corner(b, 8)
		b.Parent = host
		return b
	end

	-- Sound (local-only)
	section("SOUND (this device only)")
	local mb = button("Music", "Music: ON", UDim.new(0, 16), UDim.new(0.5, -16 - GAP / 2))
	mb.Activated:Connect(function()
		ClientSettings.ToggleMusic()
		refreshToggleLabels()
		AudioController.PlayClick()
	end)
	musicBtn = mb
	local sb = button("Sfx", "SFX: ON", UDim.new(0.5, GAP / 2), UDim.new(0.5, -16 - GAP / 2))
	sb.Activated:Connect(function()
		ClientSettings.ToggleSfx()
		refreshToggleLabels()
		AudioController.PlayClick()
	end)
	sfxBtn = sb
	y += TAP + 14

	-- Promo codes (server-validated, once each)
	section("REDEEM CODE")
	local redeemW = if isTouch then 170 else 120
	local codeBox = Instance.new("TextBox")
	codeBox.Name = "CodeBox"
	codeBox.Position = UDim2.fromOffset(16, y)
	codeBox.Size = UDim2.new(1, -(32 + redeemW + GAP), 0, TAP)
	codeBox.BackgroundColor3 = Constants.Colors.Background
	codeBox.Font = Enum.Font.GothamMedium
	codeBox.TextSize = PanelShell.Text(14)
	codeBox.TextColor3 = Constants.Colors.Text
	codeBox.PlaceholderText = "WARFOUNDING / BUILDCONQUER"
	codeBox.PlaceholderColor3 = Constants.Colors.Muted
	codeBox.Text = ""
	codeBox.ClearTextOnFocus = false
	codeBox.BorderSizePixel = 0
	UIUtil.Corner(codeBox, 8)
	codeBox.Parent = body
	local redeemBtn = button("Redeem", "REDEEM", UDim.new(1, -(16 + redeemW)), UDim.new(0, redeemW))
	redeemBtn.Activated:Connect(function()
		AudioController.PlayClick()
		local code = codeBox.Text
		if code and #code > 0 then
			task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestRedeemCode, code)
			codeBox.Text = ""
		end
	end)
	y += TAP + 14

	-- Supply spinner (the Missions panel has the same claim row; this section stays per spec §3.7)
	section("SUPPLY SPINNER")
	local spinnerBtn = button("SpinnerClaim", "SUPPLY SPINNER — Claim free Cash/Gold", UDim.new(0, 16), UDim.new(1, -32))
	spinnerBtn.Activated:Connect(function()
		AudioController.PlayClick()
		task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestClaimSpinner)
	end)
	Remotes.BindEvent(Constants.RemoteNames.SpinnerStateUpdate, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		if payload.Ready == true then
			spinnerBtn.Text = "SUPPLY SPINNER — READY (claim)"
			spinnerBtn.BackgroundColor3 = Constants.Colors.Accent
		else
			local mins = math.ceil((tonumber(payload.CooldownRemaining) or 0) / 60)
			spinnerBtn.Text = string.format("SUPPLY SPINNER — ready in %dm", mins)
			spinnerBtn.BackgroundColor3 = Constants.Colors.Background
		end
	end)
	y += TAP + 14

	-- Controls sheet, generated from HudConfig.Keys. Its own frame (KeySheet) so it can come and go with the
	-- device: shown only while HudLayout.PrefersKeys() (keyboard / gamepad), never to a touch player.
	local sheetTop = y
	local sheet = Instance.new("Frame")
	sheet.Name = "KeySheet"
	sheet.BackgroundTransparency = 1
	sheet.BorderSizePixel = 0
	sheet.Position = UDim2.fromOffset(0, sheetTop)
	sheet.Size = UDim2.new(1, 0, 0, 0)
	sheet.Parent = body
	host = sheet
	y = 0
	section("CONTROLS")
	local rowText = PanelShell.Text(13)
	local rowH = rowText + 12
	local capW = if isTouch then 110 else 92
	for _, sec in ipairs(SettingsController.BuildKeySheet()) do
		local head = Instance.new("TextLabel")
		head.BackgroundTransparency = 1
		head.Position = UDim2.fromOffset(16, y)
		head.Size = UDim2.new(1, -32, 0, rowText + 4)
		head.Font = Enum.Font.GothamBold
		head.TextSize = rowText
		head.TextXAlignment = Enum.TextXAlignment.Left
		head.TextColor3 = Constants.Colors.Muted
		head.Text = sec.Title
		head.Parent = host
		y += rowText + 8
		for _, r in ipairs(sec.Rows) do
			local row = Instance.new("Frame")
			row.Name = "Key_" .. r.Key
			row.Position = UDim2.fromOffset(16, y)
			row.Size = UDim2.new(1, -32, 0, rowH)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BackgroundTransparency = 0.35
			row.BorderSizePixel = 0
			row.Parent = host
			UIUtil.Corner(row, 6)
			local cap = Instance.new("TextLabel")
			cap.Name = "Cap"
			cap.Position = UDim2.fromOffset(4, 3)
			cap.Size = UDim2.new(0, capW, 1, -6)
			cap.BackgroundColor3 = Constants.Colors.Gunmetal
			cap.BorderSizePixel = 0
			cap.Font = HudConfig.Fonts.Display
			cap.TextSize = rowText
			cap.TextColor3 = Constants.Colors.Text
			cap.Text = r.Key
			cap.Parent = row
			UIUtil.Corner(cap, 5)
			local act = Instance.new("TextLabel")
			act.BackgroundTransparency = 1
			act.Position = UDim2.fromOffset(capW + 14, 0)
			act.Size = UDim2.new(1, -(capW + 18), 1, 0)
			act.Font = Enum.Font.GothamMedium
			act.TextSize = rowText
			act.TextXAlignment = Enum.TextXAlignment.Left
			act.TextTruncate = Enum.TextTruncate.AtEnd
			act.TextColor3 = Constants.Colors.Text
			act.Text = r.Action
			act.Parent = row
			y += rowH + 4
		end
		y += 6
	end
	local sheetH = y
	sheet.Size = UDim2.new(1, 0, 0, sheetH)
	local function applySheet(show: boolean)
		sheet.Visible = show
		body.CanvasSize = UDim2.fromOffset(0, sheetTop + (if show then sheetH else 0) + 8)
	end
	applySheet(HudLayout.PrefersKeys())
	HudLayout.InputModeChanged:Connect(applySheet)

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return open
		end,
		Close = function()
			setOpen(false)
		end,
	})

	refreshToggleLabels()
	ClientSettings.OnChanged(refreshToggleLabels)
end

function SettingsController.Toggle()
	local sh = shell
	if not open and sh and sh.TapThrough() then
		return
	end
	setOpen(not open)
end

function SettingsController.Open()
	setOpen(true)
end

function SettingsController.Close()
	setOpen(false)
end

function SettingsController.IsOpen(): boolean
	return open
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Phase 7 — Shop UI. Prompts Marketplace; grants only via server ProcessReceipt / GamePass ownership.
	v69: two tabs — SUPPLY (Robux DevProducts / GamePasses) and WEAPONS (in-game Cash, WeaponConfig). WEAPONS
	rows fire RequestPurchaseWeapon / RequestEquipWeapon with the weapon id only; CombatService prices,
	level-checks, rate-limits and grants. The Armory terminal (WE_OpenPanel "Shop", weapons prompt) opens the
	WEAPONS tab. One-time DevProducts (MonetizationConfig OneTime) show OWNED once owned and are never
	re-prompted.
	v70 "clean screen" (spec §3.3 / §3.4 / §3.8 / §4.3):
	  * A registered Modal panel (HudLayout id "Shop") with the black dim; one HUD scale + safe area; every
	    tappable ≥ 44 real px on touch. Gold (> 0) shows in the header (it left the cash pill).
	  * OpenCashPacks(): the cash pill's + opens the SUPPLY tab with the Cash Pack Mega row highlighted.
	  * The seven upsell cards (StarterBundleToast, AutoCollectToast, DoubleCashToast, VIPToast, SpeedBoostToast,
	    CashMegaToast, DeathShopToast) are thin wrappers around NotificationController.ShowOffer — ONE throttled
	    offer toast in the top-centre stack. OnGet = the same promptDevProduct / promptGamePass as before.
	  * AtmRaidHud is the TopStack "Progress" pill (was a full-width chip over the jump button). ]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local NotificationController = require(script.Parent.NotificationController)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)
local PanelShell = require(script.Parent.Parent.Modules.PanelShell)

local ShopController = {}

local PANEL_ID = "Shop"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local menuOpen = false
local pendingCashMegaHighlight = false
local shopListFrame: ScrollingFrame? = nil
local screenGui: ScreenGui? = nil
local shell: PanelShell.Shell? = nil
local goldChip: Frame? = nil
local goldText: TextLabel? = nil
-- UserOwnsGamePassAsync results (refreshed every 20 s by the premium-pad block); read without yielding
local ownedCache: { [string]: boolean } = {}

-- v69: tabs
local panelTitle: TextLabel? = nil
local tabLists: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: TextButton } = {}
local activeTab = "Supply"
local TAB_TITLES: { [string]: string } = { Supply = "Supply Depot", Weapons = "Armory" }

-- v69: what the rows show as owned / locked. Display only — the server validates every BUY, EQUIP and receipt.
local knownLevel: number? = nil -- WE_Level attribute / XPUpdate / PlayerState, whichever arrived last
local knownBarracksLevel: number? = nil -- InstantBarracks is pointless once Barracks is L1+
local knownPremium: boolean? = nil -- BattlePassStateUpdate.Premium
local fallbackWeapons: { [string]: boolean }? = nil -- PlayerState.Weapons until WE_Weapons replicates
local fallbackEquipped: string? = nil
local sessionOwnedProducts: { [string]: boolean } = {} -- one-time products bought this session
local sessionOwnedPasses: { [string]: boolean } = {}
local refreshQueued = false
local refreshShopRows: () -> () = function() end -- set in Init
local lastSnapshotAt = -math.huge

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function toast(message: string, kind: string?)
	pcall(NotificationController.Show, message, kind or "Info", 3)
end

local function formatCash(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local function queueRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		refreshShopRows()
	end)
end

--[[ v69: row button looks. Disabled buttons carry WE_Disabled and their Activated handler returns early,
	so a LOCKED / OWNED / EQUIPPED button never looks tappable and never does anything. ]]
local function setRowButton(btn: TextButton, text: string, mode: string)
	local disabled = mode == "owned" or mode == "locked" or mode == "busy"
	btn.Text = text
	btn:SetAttribute("WE_Disabled", disabled)
	btn.AutoButtonColor = not disabled
	if mode == "owned" then
		btn.BackgroundColor3 = Color3.fromRGB(34, 64, 40)
		btn.TextColor3 = Color3.fromRGB(180, 255, 160)
	elseif mode == "locked" or mode == "busy" then
		btn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
		btn.TextColor3 = Constants.Colors.Muted
	elseif mode == "equip" then
		btn.BackgroundColor3 = Color3.fromRGB(40, 110, 60)
		btn.TextColor3 = Color3.fromRGB(240, 255, 245)
	elseif mode == "dim" then
		btn.BackgroundColor3 = Constants.Colors.Gunmetal
		btn.TextColor3 = Constants.Colors.Muted
	else -- "buy"
		btn.BackgroundColor3 = Constants.Colors.Gunmetal
		btn.TextColor3 = Color3.fromRGB(255, 248, 230)
	end
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if mode == "buy"
			then Constants.Colors.Gold
			elseif mode == "equip" then Color3.fromRGB(120, 220, 140)
			else Color3.fromRGB(80, 88, 96)
		stroke.Thickness = if disabled then 1 else 1.25
	end
end

--[[ v69: a OneTime DevProduct (boolean grant) is owned when the server says so (player attribute
	WE_Ent_<entitlement>), when it was bought this session, or when its effect is already there (Battle Pass
	Premium on; Barracks already L1+ for InstantBarracks). ]]
local function isOneTimeOwned(productKey: string): boolean
	local def = (MonetizationConfig.DevProducts :: any)[productKey]
	if typeof(def) ~= "table" or def.OneTime ~= true then
		return false
	end
	if sessionOwnedProducts[productKey] == true then
		return true
	end
	local entKey = if typeof(def.GrantEntitlement) == "string" and def.GrantEntitlement ~= ""
		then def.GrantEntitlement
		else productKey
	if player:GetAttribute("WE_Ent_" .. entKey) == true then
		return true
	end
	if def.GrantsBattlePassPremium == true and knownPremium == true then
		return true
	end
	if def.GrantEntitlement == "InstantBarracks" and (knownBarracksLevel or 0) >= 1 then
		return true
	end
	return false
end

--[[ v70: a GamePass is known owned (display / offer gating only): bought this session, replicated by the server
	(WE_Ent_<passKey>, MonetizationService), or a cached UserOwnsGamePassAsync hit. Never yields. ]]
local function passOwnedKnown(passKey: string): boolean
	if sessionOwnedPasses[passKey] == true then
		return true
	end
	if player:GetAttribute("WE_Ent_" .. passKey) == true then
		return true
	end
	return ownedCache[passKey] == true
end

--[[ v70 (spec §4.3): every upsell goes through ONE offer toast (throttled / deferred by NotificationController). ]]
type OfferDef = { Key: string, Title: string, Sub: string?, Cta: string, OnGet: () -> () }
local function showOffer(def: OfferDef): boolean
	local fn = (NotificationController :: any).ShowOffer
	if typeof(fn) ~= "function" then
		return false
	end
	local ok, shown = pcall(fn, def)
	return ok and shown == true
end

local function ctaFor(robux: number?): string
	return if robux and robux > 0 then string.format("GET R$ %d", robux) else "GET"
end

local function refreshGold()
	local chip, lab = goldChip, goldText
	if not (chip and lab) then
		return
	end
	local g = math.floor(tonumber(player:GetAttribute("WE_Gold")) or 0)
	chip.Visible = g > 0
	lab.Text = formatCash(g) .. " GOLD"
end

local function ownedWeapons(): { [string]: boolean }
	local raw: any = player:GetAttribute("WE_Weapons")
	if typeof(raw) ~= "string" and fallbackWeapons then
		local ids: { string } = {}
		for id in pairs(fallbackWeapons) do
			table.insert(ids, id)
		end
		raw = table.concat(ids, ",")
	end
	return WeaponConfig.ParseOwned(raw)
end

local function equippedWeapon(): string?
	local attr = player:GetAttribute("WE_EquippedWeapon")
	if typeof(attr) == "string" then
		return attr
	end
	return fallbackEquipped
end

local function currentCash(): number?
	local attr = tonumber(player:GetAttribute("WE_Cash"))
	if attr then
		return attr
	end
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Cash")
	if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
		return (v :: any).Value
	end
	return nil
end

local function applyPlayerState(state: any)
	if typeof(state) ~= "table" then
		return
	end
	if typeof(state.Level) == "number" then
		knownLevel = state.Level
	end
	if typeof(state.Weapons) == "table" then
		local set: { [string]: boolean } = {}
		for id, owned in pairs(state.Weapons) do
			if typeof(id) == "string" and owned == true then
				set[id] = true
			end
		end
		fallbackWeapons = set
	end
	if typeof(state.EquippedWeapon) == "string" then
		fallbackEquipped = state.EquippedWeapon
	end
	local base = state.Base
	if typeof(base) == "table" and typeof(base.Upgrades) == "table" and typeof(base.Upgrades.Barracks) == "number" then
		knownBarracksLevel = base.Upgrades.Barracks
	end
	queueRefresh()
end

-- One GetPlayerState read per shop open (≥5 s apart) so owned / level / Barracks are fresh. Never blocks.
local function requestStateSnapshot()
	local now = os.clock()
	if now - lastSnapshotAt < 5 then
		return
	end
	lastSnapshotAt = now
	task.spawn(function()
		local fn = Remotes.TryGetFunction(Constants.RemoteNames.GetPlayerState)
		if not fn then
			return
		end
		local ok, state = pcall(function()
			return fn:InvokeServer()
		end)
		if ok then
			applyPlayerState(state)
		end
	end)
end

local function selectTab(name: string)
	if not tabLists[name] then
		return
	end
	activeTab = name
	for tabName, tabList in pairs(tabLists) do
		tabList.Visible = tabName == name
	end
	for tabName, btn in pairs(tabButtons) do
		local on = tabName == name
		btn.BackgroundColor3 = if on then Constants.Colors.Gold else Constants.Colors.Gunmetal
		btn.TextColor3 = if on then Constants.Colors.TextDark else Constants.Colors.Muted
	end
	if panelTitle then
		panelTitle.Text = TAB_TITLES[name] or "Supply Depot"
	end
	queueRefresh()
end

local function highlightCashMegaRow()
	local list = shopListFrame
	if not list then
		return
	end
	local row = list:FindFirstChild("ShopRow_CashMega")
	if not row or not row:IsA("GuiObject") then
		return
	end
	row.BackgroundColor3 = Color3.fromRGB(90, 70, 30)
	local found = row:FindFirstChildOfClass("UIStroke")
	local stroke: UIStroke = found or Instance.new("UIStroke")
	stroke.Parent = row
	stroke.Color = Constants.Colors.Gold
	stroke.Thickness = 2.5
	-- Scroll to top (CashMega is first)
	if list:IsA("ScrollingFrame") then
		list.CanvasPosition = Vector2.new(0, 0)
	end
	task.delay(4, function()
		if row.Parent then
			row.BackgroundColor3 = Constants.Colors.Background
			if stroke.Parent then
				stroke.Thickness = 0
			end
		end
	end)
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
	local sh = shell
	if sh then
		sh.Sync(open)
	end
	if open then
		refreshGold()
	end
	-- v35: optional CashMega highlight when shop opens from death continuity
	if open and pendingCashMegaHighlight then
		pendingCashMegaHighlight = false
		selectTab("Supply")
		task.defer(highlightCashMegaRow)
	end
	if open then
		requestStateSnapshot()
		queueRefresh()
	end
end

local function promptDevProduct(productKey: string)
	local def = MonetizationConfig.DevProducts[productKey]
	if not def then
		return
	end
	-- v69: a one-time product the player already owns is never prompted again (it would charge for nothing)
	if isOneTimeOwned(productKey) then
		toast("You already own " .. tostring(def.DisplayName or productKey), "Info")
		queueRefresh()
		return
	end
	-- Ask server to log + validate; client still prompts Marketplace (v69: intent log never delays the prompt)
	task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestPurchaseDevProduct, productKey)
	if def.Id and def.Id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, def.Id)
	else
		warn("[Shop] Product ID placeholder for", productKey, "— set MonetizationConfig DevProduct Ids")
	end
end

local function promptGamePass(passKey: string)
	local def = MonetizationConfig.GamePasses[passKey]
	if not def then
		return
	end
	-- v69: HideFromShop passes (ExtraPlotCosmetic — theme not implemented) are never offered
	if (def :: any).HideFromShop == true then
		return
	end
	-- Log intent on server; NEVER treat client confirmation as a grant
	task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestPurchaseGamePass, passKey)
	if def.Id and def.Id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, def.Id)
	else
		warn("[Shop] GamePass ID placeholder for", passKey, "— set MonetizationConfig GamePass Ids")
	end
end

function ShopController.Init()

	-- v30 → v70: PvP death → ONE offer toast (DoubleCash GP / SpeedBoost DP …), no longer a card with a button
	-- per product. DEATH_TOAST_DEBOUNCE stays the client floor; HudConfig.Offer.DeathOfferMinGapSeconds (the
	-- "^Death" offer key) is the real cap. v35 continuity kept: the next Shop open highlights ShopRow_CashMega.
	do
		local lastDeathToastAt = -math.huge
		local DEATH_TOAST_DEBOUNCE = 10

		local function resolveOfferPrompt(key: string): (string?, string?, number?, string?)
			-- Prefer live GamePass, then live DevProduct (DoubleCash is GP; SpeedBoost is DP)
			local gp = MonetizationConfig.GamePasses and MonetizationConfig.GamePasses[key]
			if gp and typeof(gp.Id) == "number" and gp.Id ~= 0 then
				if passOwnedKnown(key) then
					return nil, nil, nil, nil
				end
				return "GamePass", key, gp.Id, gp.DisplayName or key
			end
			-- v69: never offer a one-time product the player already owns (e.g. Speed Boost)
			if isOneTimeOwned(key) then
				return nil, nil, nil, nil
			end
			local dp = MonetizationConfig.DevProducts and MonetizationConfig.DevProducts[key]
			if dp and typeof(dp.Id) == "number" and dp.Id ~= 0 and dp.HideFromShop ~= true then
				return "DevProduct", key, dp.Id, dp.DisplayName or key
			end
			-- SpeedBoost / other: allow DevProduct even if HideFromShop when explicitly offered
			if dp and typeof(dp.Id) == "number" and dp.Id ~= 0 then
				return "DevProduct", key, dp.Id, dp.DisplayName or key
			end
			return nil, nil, nil, nil
		end

		-- the first live, not-owned offer of the server's list becomes the death offer toast
		local function DeathShopToast(offerKeys: { string }): boolean
			local now = os.clock()
			if now - lastDeathToastAt < DEATH_TOAST_DEBOUNCE then
				return false
			end
			for _, key in ipairs(offerKeys) do
				local kind, k, _, name = resolveOfferPrompt(key)
				if kind and k and name then
					lastDeathToastAt = now
					local def: any = if kind == "GamePass"
						then (MonetizationConfig.GamePasses :: any)[k]
						else (MonetizationConfig.DevProducts :: any)[k]
					local robux = if typeof(def) == "table" then tonumber(def.RobuxPrice) else nil
					local desc = if typeof(def) == "table" and typeof(def.Description) == "string" then def.Description else nil
					pendingCashMegaHighlight = true -- v35: CashMega highlight if the shop opens next
					local offerKind, offerKey = kind, k
					return showOffer({
						Key = "DeathShopToast",
						Title = "Back stronger: " .. name,
						Sub = desc or "Boost after death",
						Cta = ctaFor(robux),
						OnGet = function()
							if offerKind == "GamePass" then
								promptGamePass(offerKey)
							else
								promptDevProduct(offerKey)
							end
						end,
					})
				end
			end
			return false
		end

		-- DeathShopOffer never blocks Init (BindEvent connects when the remote appears)
		Remotes.BindEvent(Constants.RemoteNames.DeathShopOffer, function(payload: any)
			local offers = if typeof(payload) == "table" then (payload :: any).Offers else nil
			if typeof(offers) ~= "table" then
				offers = (MonetizationConfig :: any).DeathShopOffers or { "DoubleCash", "SpeedBoost" }
			end
			DeathShopToast(offers :: { string })
		end)
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireShop"
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	-- v70: one HUD scale + the safe area (HudLayout.ApplyScreen via PanelShell); DisplayOrder stays Panels = 60
	PanelShell.Screen(screen, HudConfig.DisplayOrder.Panels)
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.94, 0, 1, -16) else UDim2.fromOffset(480, 520)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = screen
	corner(panel, 12)
	do
		local cap = Instance.new("UISizeConstraint")
		cap.MaxSize = if isTouch then Vector2.new(900, 620) else Vector2.new(480, 520)
		cap.Parent = panel
	end

	local title = PanelShell.Title(panel, "Supply Depot")
	panelTitle = title

	-- v70: Gold left the cash pill; it shows here, only while the player has any (WE_Gold / EconomyUpdate)
	do
		local goldSize = PanelShell.Text(18)
		local chip = Instance.new("Frame")
		chip.Name = "Gold"
		chip.AnchorPoint = Vector2.new(1, 0.5)
		chip.Position = UDim2.new(1, -(TAP + 12), 0, title.Position.Y.Offset + title.Size.Y.Offset / 2)
		chip.Size = UDim2.fromOffset(170, goldSize + 12)
		chip.BackgroundTransparency = 1
		chip.Visible = false
		chip.Parent = panel
		local lay = Instance.new("UIListLayout")
		lay.FillDirection = Enum.FillDirection.Horizontal
		lay.HorizontalAlignment = Enum.HorizontalAlignment.Right
		lay.VerticalAlignment = Enum.VerticalAlignment.Center
		lay.Padding = UDim.new(0, 6)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		lay.Parent = chip
		HudIcons.Make("Dot", chip, {
			Size = UDim2.fromOffset(goldSize - 2, goldSize - 2),
			LayoutOrder = 1,
			Color = HudConfig.Colors.Gold,
			Fill = Constants.Colors.Panel,
		})
		local lab = Instance.new("TextLabel")
		lab.Name = "Amount"
		lab.LayoutOrder = 2
		lab.BackgroundTransparency = 1
		lab.Size = UDim2.fromOffset(0, goldSize + 6)
		lab.AutomaticSize = Enum.AutomaticSize.X -- the dot hugs the number
		lab.Font = HudConfig.Fonts.Display
		lab.TextSize = goldSize
		lab.TextColor3 = HudConfig.Colors.Gold
		lab.TextXAlignment = Enum.TextXAlignment.Right
		lab.Text = "0 GOLD"
		lab.Parent = chip
		UIUtil.TextOutline(lab, 1.5)
		goldChip = chip
		goldText = lab
	end

	PanelShell.CloseButton(panel, function()
		setOpen(false)
	end)

	-- v69: SUPPLY / WEAPONS tabs under the title (the close button keeps the top-right corner)
	local tabTop = TAP + 8
	local tabBar = Instance.new("Frame")
	tabBar.Name = "Tabs"
	tabBar.BackgroundTransparency = 1
	tabBar.Position = UDim2.fromOffset(12, tabTop)
	tabBar.Size = UDim2.new(1, -24, 0, TAP)
	tabBar.Parent = panel
	local function makeTab(name: string, text: string, index: number)
		local b = Instance.new("TextButton")
		b.Name = "Tab_" .. name
		b.Position = UDim2.new((index - 1) * 0.5, if index == 1 then 0 else 4, 0, 0)
		b.Size = UDim2.new(0.5, -4, 1, 0) -- TAP tall: a full touch target without EnsureMinTouch
		b.BackgroundColor3 = Constants.Colors.Gunmetal
		b.Font = Enum.Font.GothamBold
		b.TextSize = PanelShell.Text(13)
		b.TextColor3 = Constants.Colors.Muted
		b.Text = text
		b.BorderSizePixel = 0
		b.Active = true
		corner(b, 8)
		b.Parent = tabBar
		b.Activated:Connect(function()
			selectTab(name)
		end)
		tabButtons[name] = b
	end
	makeTab("Supply", "SUPPLY · R$", 1)
	makeTab("Weapons", "WEAPONS · CASH", 2)

	local listTop = tabTop + TAP + 8
	local noteSize = PanelShell.Text(11)
	local function makeList(name: string, noteText: string): ScrollingFrame
		local l = Instance.new("ScrollingFrame")
		l.Name = "List_" .. name
		l.Position = UDim2.fromOffset(12, listTop)
		l.Size = UDim2.new(1, -24, 1, -(listTop + 12))
		l.BackgroundTransparency = 1
		l.BorderSizePixel = 0
		l.ScrollBarThickness = if isTouch then 6 else 4
		l.CanvasSize = UDim2.fromOffset(0, 0)
		l.AutomaticCanvasSize = Enum.AutomaticSize.Y
		l.Visible = name == activeTab
		l.Parent = panel
		local lay = Instance.new("UIListLayout")
		lay.Padding = UDim.new(0, 6)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		lay.Parent = l
		local n = Instance.new("TextLabel")
		n.Name = "Note"
		n.BackgroundTransparency = 1
		n.Size = UDim2.new(1, -8, 0, noteSize * 2 + 6)
		n.Font = Enum.Font.GothamMedium
		n.TextSize = noteSize
		n.TextWrapped = true
		n.TextXAlignment = Enum.TextXAlignment.Left
		n.TextColor3 = Constants.Colors.Muted
		n.Text = noteText
		n.LayoutOrder = 0
		n.Parent = l
		tabLists[name] = l
		return l
	end
	local list = makeList("Supply", "Prices in Robux. Live products charge on confirm. Passes persist after Rebirth.")
	shopListFrame = list
	local weaponList = makeList(
		"Weapons",
		"Weapons cost in-game Cash. EQUIP owned weapons here; draw them from the hotbar (tap a slot" .. (if HudLayout.PrefersKeys() then " or press 1-4)." else ").")
	)
	selectTab(activeTab)

	local rowBtnH = if isTouch then TAP else 48
	local rowBtnW = if isTouch then 140 else 100
	local rowTitleSize = PanelShell.Text(14)
	local rowSubSize = PanelShell.Text(11)
	local function buildRow(parentList: ScrollingFrame, layoutOrder: number, rowName: string, label: string, sub: string, btnText: string): (Frame, TextLabel, TextButton)
		local row = Instance.new("Frame")
		row.Name = "ShopRow_" .. rowName
		row.Size = UDim2.new(1, -8, 0, math.max(rowBtnH + 10, rowTitleSize + rowSubSize + 22))
		row.BackgroundColor3 = Constants.Colors.Background
		row.BorderSizePixel = 0
		row.LayoutOrder = layoutOrder
		row.Parent = parentList
		corner(row, 8)

		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromOffset(12, 7)
		t.Size = UDim2.new(1, -(rowBtnW + 30), 0, rowTitleSize + 4)
		t.Font = Enum.Font.GothamBold
		t.TextSize = rowTitleSize
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextTruncate = Enum.TextTruncate.AtEnd
		t.TextColor3 = Constants.Colors.Text
		t.Text = label
		t.Parent = row

		local s = Instance.new("TextLabel")
		s.BackgroundTransparency = 1
		s.Position = UDim2.fromOffset(12, 7 + rowTitleSize + 6)
		s.Size = UDim2.new(1, -(rowBtnW + 30), 0, rowSubSize + 4)
		s.Font = Enum.Font.GothamMedium
		s.TextSize = rowSubSize
		s.TextXAlignment = Enum.TextXAlignment.Left
		s.TextColor3 = Constants.Colors.Muted
		s.TextTruncate = Enum.TextTruncate.AtEnd
		s.Text = sub
		s.Parent = row

		local btn = Instance.new("TextButton")
		btn.Name = "Action"
		btn.AnchorPoint = Vector2.new(1, 0.5)
		btn.Position = UDim2.new(1, -8, 0.5, 0)
		btn.Size = UDim2.fromOffset(rowBtnW, rowBtnH)
		btn.BackgroundColor3 = Constants.Colors.Gunmetal
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = PanelShell.Text(12)
		btn.TextColor3 = Color3.fromRGB(255, 248, 230)
		btn.Text = btnText
		btn.BorderSizePixel = 0
		btn.Active = true
		corner(btn, 8)
		local btnStroke = Instance.new("UIStroke")
		btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		btnStroke.Color = Constants.Colors.Gold
		btnStroke.Thickness = 1.25
		btnStroke.Parent = btn
		btn.Parent = row
		UIUtil.EnsureMinTouch(btn, rowBtnH)
		return row, s, btn
	end

	local order = 0
	-- SUPPLY row. onClick nil = display-only row: its button is disabled (never a dead gold BUY).
	local function addRow(label: string, sub: string, onClick: (() -> ())?, btnText: string?, rowKey: string?): TextButton
		order += 1
		local _, _, btn = buildRow(list, order, rowKey or tostring(order), label, sub, btnText or "BUY")
		btn.Activated:Connect(function()
			if onClick == nil or btn:GetAttribute("WE_Disabled") == true then
				return
			end
			onClick()
		end)
		if onClick == nil then
			setRowButton(btn, btnText or "LOCKED", "locked")
		end
		return btn
	end

	-- v69: rows whose button flips to OWNED (one-time DevProducts, GamePasses)
	local oneTimeRows: { [string]: { Btn: TextButton, Label: string } } = {}
	local passRows: { [string]: { Btn: TextButton, Label: string } } = {}

	local function addDevRow(key: string, def: any, heroLabel: string?)
		if def.HideFromShop == true then
			return
		end
		-- Id=0 stubs (AutoCollect/DoubleCash/VIPBoost/GoldenPumpjack) stay out of Shop — GamePasses / pads cover them
		if (tonumber(def.Id) or 0) == 0 then
			return
		end
		local robux = tonumber(def.RobuxPrice) or 0
		local stub = false -- kept for "coming soon" path if ever re-enabled
		local sub = def.Description or ""
		if def.GrantsBattlePassPremium then
			sub = "Unlocks Battle Pass Premium (ProcessReceipt only)"
		elseif def.GrantEntitlement then
			sub = (def.Description or ("Grants " .. tostring(def.GrantEntitlement)))
		elseif def.Cash and def.Cash > 0 then
			sub = "+$" .. formatCash(def.Cash) .. " Cash"
		elseif def.Gold and def.Gold > 0 then
			sub = "+" .. formatCash(def.Gold) .. " Gold"
		end
		if stub then
			sub = sub .. " · coming soon (no charge)"
		end
		local title = def.DisplayName
		if heroLabel then
			title = heroLabel .. " · " .. title
			sub = "BEST OFFER — " .. sub
		end
		local btnLabel = if robux > 0 then (tostring(robux) .. " R$") else "BUY"
		local btn = addRow(title, sub, function()
			promptDevProduct(key)
		end, btnLabel, key)
		if def.OneTime == true then
			oneTimeRows[key] = { Btn = btn, Label = btnLabel }
		end
	end

	-- Hero CashMega first, then remaining cash packs, then other DevProducts
	local cashOrder = { "CashMega", "CashLarge", "CashMedium", "CashSmall" }
	local listed: { [string]: boolean } = {}
	do
		local mega = MonetizationConfig.DevProducts.CashMega
		if mega then
			addDevRow("CashMega", mega, "★ BEST OFFER")
			listed.CashMega = true
		end
	end
	for _, key in ipairs(cashOrder) do
		if not listed[key] then
			local def = MonetizationConfig.DevProducts[key]
			if def then
				addDevRow(key, def, nil)
				listed[key] = true
			end
		end
	end
	for key, def in pairs(MonetizationConfig.DevProducts) do
		if not listed[key] then
			addDevRow(key, def, nil)
		end
	end

	for key, def in pairs(MonetizationConfig.GamePasses) do
		-- v69: HideFromShop passes are not sold (ExtraPlotCosmetic "Elite Base Theme": nothing applies it yet)
		if (def :: any).HideFromShop == true then
			continue
		end
		local stub = (tonumber(def.Id) or 0) == 0
		local robux = tonumber(def.RobuxPrice) or 0
		local sub = (def.Description or "") .. (if stub then " · coming soon (no charge)" else "")
		local btnLabel = if robux > 0 then (tostring(robux) .. " R$") else "PASS"
		local btn = addRow("Pass: " .. def.DisplayName, sub, function()
			promptGamePass(key)
		end, btnLabel, "Pass_" .. key)
		passRows[key] = { Btn = btn, Label = btnLabel }
	end

	-- Policy-pending loot crates (display only — no purchase/grant path). v69: disabled LOCKED button.
	do
		local ok, LootBoxConfig = pcall(function()
			return require(Shared.Configs.LootBoxConfig)
		end)
		if ok and LootBoxConfig and LootBoxConfig.PolicyPending then
			addRow("Supply Crate (locked)", "Random loot is policy-pending — not for sale", nil, "LOCKED", "SupplyCrate")
		end
	end

	-- v69: WEAPONS tab — one row per WeaponConfig weapon in the shared order (UnlockLevel, price, id)
	local weaponRows: { { Id: string, Row: Frame, Sub: TextLabel, Btn: TextButton, Action: string? } } = {}
	local weaponBusy: { [string]: { Until: number, Text: string } } = {}
	local WEAPON_BUSY_SECONDS = 2.5

	local function weaponStats(def: any): string
		local pellets = tonumber(def.Pellets)
		local dmg = if pellets and pellets > 1 then (tostring(def.Damage) .. "×" .. tostring(pellets)) else tostring(def.Damage)
		return string.format("%s · DMG %s · %s/s · %sm", tostring(def.Rarity), dmg, tostring(def.FireRate), tostring(def.Range))
	end

	local function refreshWeaponRows()
		local owned = ownedWeapons()
		local equipped = equippedWeapon()
		local level = knownLevel
		local cash = currentCash()
		local now = os.clock()
		for _, r in ipairs(weaponRows) do
			local def = WeaponConfig.Weapons[r.Id]
			local cost = math.floor(tonumber(def.CostCash) or 0)
			local isOwned = owned[r.Id] == true
			local levelOk = level == nil or level >= def.UnlockLevel
			local stats = weaponStats(def)
			local busy = weaponBusy[r.Id]
			-- Weapons with no Cash price are only listed once owned (starter / granted)
			r.Row.Visible = isOwned or cost > 0
			r.Action = nil
			if r.Id == equipped then
				setRowButton(r.Btn, "EQUIPPED", "owned")
				r.Sub.Text = "Equipped · " .. stats
			elseif busy and now < busy.Until then
				setRowButton(r.Btn, busy.Text, "busy")
			elseif isOwned and levelOk then
				setRowButton(r.Btn, "EQUIP", "equip")
				r.Sub.Text = "Owned · " .. stats
				r.Action = "equip"
			elseif isOwned then
				setRowButton(r.Btn, "LV " .. def.UnlockLevel, "locked")
				r.Sub.Text = string.format("Owned · equip at Lv %d", def.UnlockLevel)
			elseif cost <= 0 then
				setRowButton(r.Btn, "N/A", "locked")
				r.Sub.Text = "Not sold in the Shop"
			elseif not levelOk then
				setRowButton(r.Btn, "LV " .. def.UnlockLevel, "locked")
				r.Sub.Text = string.format("Unlocks at Lv %d · $%s Cash", def.UnlockLevel, formatCash(cost))
			else
				local short = cash ~= nil and cash < cost
				-- Still tappable when short: the server answers with a "Not enough Cash" toast
				setRowButton(r.Btn, "BUY $" .. formatCash(cost), if short then "dim" else "buy")
				r.Sub.Text = if short and cash
					then string.format("Need $%s more Cash", formatCash(cost - cash))
					else string.format("Lv %d · %s", def.UnlockLevel, stats)
				r.Action = "buy"
			end
		end
	end

	do
		local wOrder = 0
		for _, id in ipairs(WeaponConfig.SortedIds()) do
			local def = WeaponConfig.Weapons[id]
			wOrder += 1
			local row, subLabel, btn = buildRow(weaponList, wOrder, "Weapon_" .. id, def.DisplayName, weaponStats(def), "…")
			local entry = { Id = id, Row = row, Sub = subLabel, Btn = btn, Action = nil :: string? }
			table.insert(weaponRows, entry)
			btn.Activated:Connect(function()
				local action = entry.Action
				if btn:GetAttribute("WE_Disabled") == true or action == nil then
					return
				end
				-- One request per tap: the row shows BUYING… / EQUIPPING… until the server's attribute push
				-- (or WEAPON_BUSY_SECONDS) — refusals arrive as a server toast.
				weaponBusy[id] = { Until = os.clock() + WEAPON_BUSY_SECONDS, Text = if action == "buy" then "BUYING…" else "EQUIPPING…" }
				refreshWeaponRows()
				task.delay(WEAPON_BUSY_SECONDS + 0.05, queueRefresh)
				local remoteName = if action == "buy"
					then Constants.RemoteNames.RequestPurchaseWeapon
					else Constants.RemoteNames.RequestEquipWeapon
				if not Remotes.FireServer(remoteName, id) then
					weaponBusy[id] = nil
					queueRefresh()
					toast("Shop is still connecting — try again in a moment", "Warn")
				end
			end)
		end
	end

	local function refreshOwnedRows()
		for key, r in pairs(oneTimeRows) do
			if isOneTimeOwned(key) then
				setRowButton(r.Btn, "OWNED", "owned")
			else
				setRowButton(r.Btn, r.Label, "buy")
			end
		end
		for key, r in pairs(passRows) do
			if passOwnedKnown(key) then
				setRowButton(r.Btn, "OWNED", "owned")
			end
		end
	end

	refreshShopRows = function()
		refreshWeaponRows()
		refreshOwnedRows()
	end

	-- v69: live inputs for the rows (attributes replicate without any remote)
	do
		local lvl = player:GetAttribute("WE_Level")
		if typeof(lvl) == "number" then
			knownLevel = lvl
		end
		player.AttributeChanged:Connect(function(attr: string)
			if attr == "WE_Weapons" or attr == "WE_EquippedWeapon" then
				table.clear(weaponBusy) -- server answered: drop BUYING… / EQUIPPING…
				queueRefresh()
			elseif attr == "WE_Level" then
				local v = player:GetAttribute("WE_Level")
				if typeof(v) == "number" then
					knownLevel = v
				end
				queueRefresh()
			elseif attr == "WE_Cash" or string.sub(attr, 1, 7) == "WE_Ent_" then
				queueRefresh()
			end
		end)
		Remotes.BindEvent(Constants.RemoteNames.XPUpdate, function(payload: any)
			if typeof(payload) == "table" and typeof(payload.Level) == "number" then
				knownLevel = payload.Level
				queueRefresh()
			end
		end)
		Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, applyPlayerState)
		Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(payload: any)
			if typeof(payload) == "table" and typeof(payload.Upgrades) == "table" and typeof(payload.Upgrades.Barracks) == "number" then
				knownBarracksLevel = payload.Upgrades.Barracks
				queueRefresh()
			end
		end)
		Remotes.BindEvent(Constants.RemoteNames.BattlePassStateUpdate, function(payload: any)
			if typeof(payload) == "table" and typeof(payload.Premium) == "boolean" then
				knownPremium = payload.Premium
				queueRefresh()
			end
		end)
		-- Same-session purchases show OWNED at once (the grant itself is ProcessReceipt / pass ownership only)
		pcall(function()
			MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, productId: number, isPurchased: boolean)
				if userId ~= player.UserId or not isPurchased then
					return
				end
				for key, def in pairs(MonetizationConfig.DevProducts :: any) do
					if def.Id == productId and def.OneTime == true then
						sessionOwnedProducts[key] = true
					end
				end
				queueRefresh()
			end)
		end)
		pcall(function()
			MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who: Player, passId: number, wasPurchased: boolean)
				if who ~= player or not wasPurchased then
					return
				end
				for key, def in pairs(MonetizationConfig.GamePasses :: any) do
					if def.Id == passId then
						sessionOwnedPasses[key] = true
					end
				end
				queueRefresh()
			end)
		end)
		-- Armory terminal (WE_OpenPanel "Shop" with a weapons prompt, or WE_ShopTab) lands on WEAPONS.
		-- UIController opens the panel; this only picks the tab (deferred, so it wins whatever the handler order).
		ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
			if who ~= player or prompt:GetAttribute("WE_OpenPanel") ~= "Shop" then
				return
			end
			local tab = prompt:GetAttribute("WE_ShopTab")
			if typeof(tab) ~= "string" then
				local text = string.lower(prompt.ActionText .. " " .. prompt.ObjectText)
				tab = if string.find(text, "weapon", 1, true) then "Weapons" else "Supply"
			end
			task.defer(selectTab, tab :: string)
		end)
		queueRefresh()
	end



	-- v31: VIP / AutoCollect / other GamePass pads → OWNED (hide R$ prompt look)
	do
		local function queryOwnsGamePass(key: string): boolean
			if ownedCache[key] ~= nil then
				return ownedCache[key] == true
			end
			local def = MonetizationConfig.GamePasses and MonetizationConfig.GamePasses[key]
			local id = def and tonumber(def.Id) or 0
			if id == 0 then
				ownedCache[key] = false
				return false
			end
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			ownedCache[key] = ok and owns == true
			return ownedCache[key] == true
		end

		local function applyOwnedVisual(part: BasePart, owned: boolean)
			local bb = part:FindFirstChild("WE_PremiumBillboard")
			if not bb then
				bb = part:FindFirstChildWhichIsA("BillboardGui")
			end
			if bb and bb:IsA("BillboardGui") then
				local label = bb:FindFirstChildWhichIsA("TextLabel", true)
				if owned then
					if label and label:IsA("TextLabel") then
						label.Text = "OWNED"
						label.TextColor3 = Color3.fromRGB(180, 255, 160)
					end
					-- v71: the server tag is a two-line WorldLabel ("Auto Collect" / "R$"): no price line under OWNED
					local sub = bb:FindFirstChild("Sub")
					if sub and sub:IsA("TextLabel") and sub ~= label then
						sub.Visible = false
					end
					part.LocalTransparencyModifier = 0.45
					part:SetAttribute("WE_LocalOwned", true)
				else
					part.LocalTransparencyModifier = 0
					part:SetAttribute("WE_LocalOwned", false)
				end
			elseif owned then
				part.LocalTransparencyModifier = 0.45
				part:SetAttribute("WE_LocalOwned", true)
			end
		end

		local function refreshPremiumOwned()
			local tag = (Constants.Tags and Constants.Tags.PremiumPad) or "WE_PremiumPad"
			for _, inst in ipairs(CollectionService:GetTagged(tag)) do
				if inst:IsA("BasePart") then
					local kind = inst:GetAttribute("OfferKind")
					local key = inst:GetAttribute("OfferKey")
					if kind == "GamePass" and typeof(key) == "string" then
						applyOwnedVisual(inst, queryOwnsGamePass(key))
					end
				end
			end
			-- v69: Shop pass rows show OWNED too (session purchases / WE_Ent_<pass> stay OWNED even if the check lags)
			for key, r in pairs(passRows) do
				if passOwnedKnown(key) or queryOwnsGamePass(key) then
					setRowButton(r.Btn, "OWNED", "owned")
				else
					setRowButton(r.Btn, r.Label, "buy")
				end
			end
		end

		task.spawn(function()
			task.wait(1.5)
			refreshPremiumOwned()
		end)
		task.spawn(function()
			while true do
				task.wait(20)
				-- Re-query occasionally (purchase mid-session)
				table.clear(ownedCache)
				refreshPremiumOwned()
			end
		end)
		CollectionService:GetInstanceAddedSignal((Constants.Tags and Constants.Tags.PremiumPad) or "WE_PremiumPad"):Connect(function(inst)
			if inst:IsA("BasePart") then
				task.defer(refreshPremiumOwned)
			end
		end)
	end


	-- v32 → v70: one-shot StarterBundle soft offer (server fires once per profile) → ONE offer toast
	do
		local lastStarterToastAt = -math.huge
		local STARTER_TOAST_DEBOUNCE = 30

		local function StarterBundleToast(payload: any): boolean
			local now = os.clock()
			if now - lastStarterToastAt < STARTER_TOAST_DEBOUNCE then
				return false
			end
			local def = (MonetizationConfig.DevProducts :: any).StarterBundle
			if typeof(def) ~= "table" or (tonumber(def.Id) or 0) == 0 or isOneTimeOwned("StarterBundle") then
				return false
			end
			lastStarterToastAt = now
			local p: any = if typeof(payload) == "table" then payload else {}
			local displayName = tostring(p.DisplayName or def.DisplayName or "Starter Bundle")
			local robux = tonumber(p.RobuxPrice) or tonumber(def.RobuxPrice)
			return showOffer({
				Key = "StarterBundleToast",
				Title = "Jumpstart your base",
				Sub = displayName,
				Cta = ctaFor(robux),
				OnGet = function()
					-- PromptProductPurchase only — grants via ProcessReceipt
					promptDevProduct("StarterBundle")
				end,
			})
		end

		Remotes.BindEvent(Constants.RemoteNames.StarterBundleOffer, StarterBundleToast)
	end

