	-- v33 → v70: ATM raid hold / cooldown / result → the TopStack "Progress" pill (spec §3.4; it was a full-width
	-- chip over the jump button). ONE persistent pill (Frame "AtmRaidHud", its own gui "WarEmpireAtmRaid" at the
	-- bank-raid z) that HudLayout.RegisterTopStack places under the topbar and collapses while hidden. v69
	-- payloads carry Phase: Holding / Alarm show a live bar and hide shortly after the last push; Interrupted /
	-- Blocked / Defended / Success / Robbed show the server's payload.Text for a few seconds. No Phase = legacy v33.
	do
		local P = HudConfig.TopStack.Progress
		local pill: Frame? = nil
		local hideToken = 0

		type PhaseStyle = { Stroke: Color3, Text: Color3, Hold: number, Bar: boolean }
		local AMBER: PhaseStyle = { Stroke = P.ContestedColor, Text = Color3.fromRGB(255, 226, 170), Hold = 2.5, Bar = false }
		local GREEN: PhaseStyle = { Stroke = Color3.fromRGB(120, 220, 140), Text = Color3.fromRGB(200, 255, 210), Hold = 2.5, Bar = false }
		local PHASE_STYLE: { [string]: PhaseStyle } = {
			Holding = { Stroke = Color3.fromRGB(230, 200, 80), Text = Color3.fromRGB(255, 255, 255), Hold = 1.0, Bar = true }, -- thief
			Alarm = { Stroke = Color3.fromRGB(255, 96, 84), Text = Color3.fromRGB(255, 205, 200), Hold = 1.5, Bar = true }, -- victim
			Interrupted = AMBER,
			Blocked = AMBER,
			Defended = GREEN,
			Success = { Stroke = GREEN.Stroke, Text = GREEN.Text, Hold = 5, Bar = false },
			Robbed = { Stroke = Color3.fromRGB(255, 96, 84), Text = Color3.fromRGB(255, 205, 200), Hold = 6, Bar = false },
		}

		local function ensurePill(): Frame?
			local existing = pill
			if existing and existing.Parent then
				return existing
			end
			local pg = player:FindFirstChildOfClass("PlayerGui")
			if not pg then
				return nil
			end
			local gui = Instance.new("ScreenGui")
			gui.Name = "WarEmpireAtmRaid"
			HudLayout.ApplyScreen(gui, { DisplayOrder = HudConfig.DisplayOrder.WarEmpireBankRaid, Insets = "Core" })
			gui.Parent = pg

			local f = Instance.new("Frame")
			f.Name = "AtmRaidHud"
			f.AnchorPoint = Vector2.new(0.5, 0)
			f.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top)
			f.Size = UDim2.fromOffset(P.Size.X, P.Size.Y)
			f.BackgroundColor3 = HudConfig.Colors.PillBg
			f.BackgroundTransparency = 0.12
			f.BorderSizePixel = 0
			f.Visible = false
			f.Active = false
			corner(f, 12)
			local stroke = Instance.new("UIStroke")
			stroke.Name = "Stroke"
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			stroke.Thickness = 2
			stroke.Parent = f

			local lab = Instance.new("TextLabel")
			lab.Name = "Text"
			lab.BackgroundTransparency = 1
			lab.Font = HudConfig.Fonts.Body
			lab.TextSize = P.TextSize
			lab.TextXAlignment = Enum.TextXAlignment.Left
			lab.TextTruncate = Enum.TextTruncate.AtEnd
			lab.TextColor3 = HudConfig.Colors.White
			lab.Parent = f
			UIUtil.TextOutline(lab, 1.2)

			local pct = Instance.new("TextLabel")
			pct.Name = "Pct"
			pct.BackgroundTransparency = 1
			pct.AnchorPoint = Vector2.new(1, 0)
			pct.Position = UDim2.new(1, -12, 0, 3)
			pct.Size = UDim2.fromOffset(56, P.TextSize + 6)
			pct.Font = HudConfig.Fonts.Display
			pct.TextSize = P.TextSize + 2
			pct.TextXAlignment = Enum.TextXAlignment.Right
			pct.TextColor3 = HudConfig.Colors.White
			pct.Text = ""
			pct.Parent = f
			UIUtil.TextOutline(pct, 1.2)

			local barBg = Instance.new("Frame")
			barBg.Name = "Bar"
			barBg.AnchorPoint = Vector2.new(0.5, 1)
			barBg.Position = UDim2.new(0.5, 0, 1, -7)
			barBg.Size = UDim2.new(1, -24, 0, P.BarH)
			barBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			barBg.BackgroundTransparency = 0.45
			barBg.BorderSizePixel = 0
			barBg.Visible = false
			barBg.Parent = f
			corner(barBg, P.BarH // 2)
			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.fromScale(0, 1)
			fill.BorderSizePixel = 0
			fill.Parent = barBg
			corner(fill, P.BarH // 2)

			f.Parent = gui
			HudLayout.RegisterTopStack("AtmRaid", f, HudConfig.TopStack.Order.Progress, { Space = "Hud" })
			pill = f
			return f
		end

		local function hideLater(frame: Frame, seconds: number)
			hideToken += 1
			local token = hideToken
			task.delay(seconds, function()
				if token == hideToken and pill == frame then
					frame.Visible = false
				end
			end)
		end

		-- paint the pill: text, optional bar fraction, colours; auto width (Progress.Size.X … the stack's max)
		local function showPill(text: string, style: PhaseStyle, fraction: number?)
			local f = ensurePill()
			if not f then
				return
			end
			local lab = f:FindFirstChild("Text")
			local pct = f:FindFirstChild("Pct")
			local barBg = f:FindFirstChild("Bar")
			local stroke = f:FindFirstChild("Stroke")
			local withBar = style.Bar and fraction ~= nil
			local pctW = if withBar then 60 else 0
			local textW = P.Size.X
			pcall(function()
				textW = TextService:GetTextSize(text, P.TextSize, HudConfig.Fonts.Body, Vector2.new(4000, 100)).X
			end)
			local maxW = math.max(P.Size.X, HudLayout.TopStackMaxWidthV())
			local w = math.clamp(math.ceil(textW * 1.06) + 24 + pctW, P.Size.X, maxW)
			f.Size = UDim2.fromOffset(w, P.Size.Y)
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = style.Stroke
			end
			if lab and lab:IsA("TextLabel") then
				lab.Text = text
				lab.TextColor3 = style.Text
				if withBar then
					lab.Position = UDim2.fromOffset(12, 4)
					lab.Size = UDim2.new(1, -(24 + pctW), 0, P.TextSize + 6)
				else
					lab.Position = UDim2.fromOffset(12, 0)
					lab.Size = UDim2.new(1, -24, 1, 0)
				end
			end
			if pct and pct:IsA("TextLabel") then
				pct.Visible = withBar
				pct.Text = if withBar and fraction then string.format("%d%%", math.floor(fraction * 100 + 0.5)) else ""
			end
			if barBg and barBg:IsA("Frame") then
				barBg.Visible = withBar
				local fill = barBg:FindFirstChild("Fill")
				if fill and fill:IsA("Frame") then
					fill.Size = UDim2.fromScale(math.clamp(fraction or 0, 0, 1), 1)
					fill.BackgroundColor3 = style.Stroke
				end
			end
			f.Visible = true
			hideLater(f, style.Hold)
		end

		-- legacy (no Phase): the v33 texts
		local function showLegacyAtmRaidHud(payload: any)
			local success = (payload :: any).Success == true
			local raided = (payload :: any).Raided == true
			local cd = math.max(0, math.floor(tonumber((payload :: any).CooldownRemaining) or 0))
			local stolen = math.floor(tonumber((payload :: any).Stolen) or 0)
			local victim = tostring((payload :: any).VictimName or "")
			local text: string
			if success then
				text = string.format("ATM RAID +$%s%s · cooldown 1m", formatCash(stolen), if victim ~= "" then (" from " .. victim) else "")
			elseif raided then
				local thief = tostring((payload :: any).ThiefName or "")
				if thief ~= "" then
					text = string.format("ATM RAIDED −10%% by %s (−$%s)", thief, formatCash(stolen))
				else
					text = string.format("ATM RAIDED −10%% (−$%s)", formatCash(stolen))
				end
			else
				text = string.format("ATM raid cooldown — %ds", cd)
			end
			local base = if success then GREEN elseif raided then PHASE_STYLE.Robbed else AMBER
			local hold = if success or raided then 5.5 else math.clamp(cd, 2, 8)
			showPill(text, { Stroke = base.Stroke, Text = base.Text, Hold = hold, Bar = false }, nil)
		end

		local function phaseText(payload: any, phase: string): string
			local text = if typeof(payload.Text) == "string" and payload.Text ~= "" then payload.Text else nil
			local progress = tonumber(payload.HoldProgress)
			local need = tonumber(payload.HoldNeed)
			if phase == "Holding" then
				return text or string.format("ROBBING %s's ATM — don't get hit!", tostring(payload.VictimName or "their"))
			elseif phase == "Alarm" then
				local base = text or string.format("%s is robbing your ATM!", tostring(payload.ThiefName or "Someone"))
				if progress and need and not string.find(base, "%d/%d") then
					base ..= string.format(" %d/%ds", math.floor(progress), math.floor(need))
				end
				return base
			end
			return text or tostring(payload.Reason or phase)
		end

		local function showAtmRaidHud(payload: any)
			if typeof(payload) ~= "table" then
				return
			end
			local phase = (payload :: any).Phase
			local style = if typeof(phase) == "string" then PHASE_STYLE[phase] else nil
			if style then
				local need = tonumber(payload.HoldNeed) or 0
				local fraction = if need > 0 then math.clamp((tonumber(payload.HoldProgress) or 0) / need, 0, 1) else nil
				showPill(phaseText(payload, phase :: string), style, fraction)
			elseif phase == nil then
				showLegacyAtmRaidHud(payload)
			end
		end

		Remotes.BindEvent(Constants.RemoteNames.AtmRaidStateUpdate, showAtmRaidHud)
	end

	-- ATM-cluster premium pads → PromptGamePass / PromptProduct (server-validated)
	Remotes.BindEvent(Constants.RemoteNames.PromptPremiumPad, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		local kind = payload.Kind
		local key = payload.Key
		if typeof(kind) ~= "string" or typeof(key) ~= "string" then
			return
		end
		if kind == "GamePass" then
			promptGamePass(key)
		elseif kind == "DevProduct" then
			promptDevProduct(key)
		end
	end)

	if order == 0 then
		UIUtil.EmptyState(list, "Shop catalog empty — MonetizationConfig has no DevProducts / GamePasses.", 0)
	end

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return menuOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})

	-- Gold in the header (WE_Gold replicates from the server; EconomyUpdate as a backup)
	player:GetAttributeChangedSignal("WE_Gold"):Connect(refreshGold)
	Remotes.BindEvent(Constants.RemoteNames.EconomyUpdate, function(payload: any)
		if typeof(payload) == "table" and typeof(payload.Gold) == "number" and player:GetAttribute("WE_Gold") == nil then
			local chip, lab = goldChip, goldText
			if chip and lab then
				chip.Visible = payload.Gold > 0
				lab.Text = formatCash(payload.Gold) .. " GOLD"
			end
		end
	end)
	refreshGold()

	local shopKey: Enum.KeyCode = HudConfig.Keys.Shop or Enum.KeyCode.P
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == shopKey then
			setOpen(not menuOpen)
		end
	end)
end





function ShopController.Toggle()
	-- the tap that just closed the Shop through its dim lands on the Shop tile too: stay closed
	local sh = shell
	if not menuOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not menuOpen)
end

--[[ v70: the cash pill's + (HUDController.BindShopOpener → UIController): SUPPLY tab, Cash Pack Mega highlighted.
	Visual only — no toast, no purchase prompt. ]]
function ShopController.OpenCashPacks()
	pendingCashMegaHighlight = true
	setOpen(true)
end

--[[ v69: open on a tab ("Supply" | "Weapons"). The Armory terminal lands on Weapons via PromptTriggered. ]]
function ShopController.OpenTab(tab: string)
	selectTab(tab)
	setOpen(true)
end

function ShopController.OpenWeapons()
	ShopController.OpenTab("Weapons")
end

function ShopController.Open()
	setOpen(true)
end

function ShopController.Close()
	setOpen(false)
end

function ShopController.IsOpen(): boolean
	return menuOpen
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">TerritoryController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Territory HUD — v70 "clean screen" (spec §3.4 + the E row of §9; was Phase 5/7's capture card, alert label,
	always-on TERRITORIES list and RADAR badge).

	* CAPTURE BAR: a top-centre stack item ("Capture", slot Progress — HudLayout.RegisterTopStack) built from the
	  shared ProgressPill (320×44 v): "CAPTURING RADAR HILL  62%". It reads only TerritoryStateUpdate.LocalCapture,
	  so it works the same for land outposts and the v70 naval outposts (oil rigs taken by a boat's driver or from
	  the deck) and stays visible while Driving. Contested → amber edge + "CONTESTED · NAME" and the nation-colour
	  pulse (contestedPulseActive); Protected → blue "PROTECTED · NAME" (capture slowed).
	* "Outposts held: N" → one silent Info toast through NotificationController when the count changes. The old
	  mid-screen TerritoryAlert label and its 50 % / 90 % milestone lines are gone: the % is on the bar.
	* TERRITORY LIST → a dropdown under the compass chip, opened by HudLayout.Signals.CompassTapped (it was an
	  always-on panel over the rail). It is a registered panel ("Territories"): one panel at a time and Modal
	  while open, so the combat buttons hide and the list may use the right-hand column down to the jump button.
	  ✕, a tap outside, another panel, Driving or death close it.
	* RADAR HILL reveal → the HudLayout flag "Radar" (CompassController draws the purple dot on the chip) + the
	  enemy Highlights (kept) + a "RADAR ON" row in the list.
	Display only: capture, ownership and payouts are server-side (TerritoryService).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)
local ProgressPill = require(script.Parent.Parent.Modules.ProgressPill)
local NotificationController = require(script.Parent.NotificationController)

local TerritoryController = {}

local player = Players.LocalPlayer
local _gui: ScreenGui? = nil

-- capture bar
local capture: ProgressPill.Pill? = nil
local captureActive = false
-- v38: contested dual-color pulse cache (v70: amber when the server sends no nation colours)
local contestedPulseActive = false
local contestedColA: Color3? = nil
local contestedColB: Color3? = nil

-- radar
local radarActive = false
local radarRadius = 550
local radarHighlights: { [number]: Highlight } = {}

-- "Outposts held: N" (nil until the first payload: joining never toasts)
local lastOwned: number? = nil

-- dropdown list (panel "Territories")
local PANEL_ID = "Territories"
local listPanel: Frame? = nil
local listScroll: ScrollingFrame? = nil
local listCount: TextLabel? = nil
local listDim: Frame? = nil
local listOpen = false
local listDirty = true
local lastPayload: Types.TerritoryStatePayload? = nil

-- Dropdown geometry, v (the gui carries HudLayout's MobileScale). Candidates for HudConfig.TopStrip.Compass.List.
local LIST = {
	Width = 300,
	RowH = 30,
	Gap = 6, -- under the compass chip
	PadX = 12,
	PadBottom = 8,
	TitleSize = 20,
	TextSize = 16, -- 11.2 real px at the phone scale (HudConfig.Scale.MinTextPx)
	TagWidth = 104,
	DotSize = 10,
	MinHeight = 140,
	-- touch: stay above Roblox's jump button (top at H − 90 real, see HudConfig.TouchCombat) plus a 10 px gap
	JumpClearPx = 100,
	Bg = HudConfig.Colors.PillBg,
	BgTransparency = 0.12,
	Corner = 14,
}

local COL = {
	You = HudConfig.Colors.Positive,
	Enemy = HudConfig.Colors.Negative,
	Clan = Color3.fromRGB(120, 180, 255),
	Guarded = Color3.fromRGB(255, 150, 60),
	Neutral = HudConfig.Colors.Muted,
	Contested = HudConfig.TopStack.Progress.ContestedColor,
	Protected = Color3.fromRGB(140, 180, 255),
	Radar = HudConfig.TopStrip.Compass.RadarDot,
}

local function touchMinV(): number
	if HudLayout.IsTouch() then
		-- 64 v = 44.8 real px at the smallest HUD scale (0.70)
		return math.max(HudConfig.Hotbar.Slot, math.ceil(HudConfig.Scale.TouchMinPx / HudConfig.Scale.Min))
	end
	return 44
end

---------------------------------------------------------------------------------------------------------------
-- radar (Radar Hill reveal) — unchanged behaviour, the badge became the "Radar" flag
---------------------------------------------------------------------------------------------------------------

local function clearRadarHighlights()
	for userId, h in pairs(radarHighlights) do
		if h and h.Parent then
			h:Destroy()
		end
		radarHighlights[userId] = nil
	end
end

local function ensureHighlight(target: Model): Highlight
	local existing = target:FindFirstChild("WE_RadarHighlight")
	if existing and existing:IsA("Highlight") then
		return existing
	end
	local h = Instance.new("Highlight")
	h.Name = "WE_RadarHighlight"
	h.FillColor = Color3.fromRGB(200, 80, 80)
	h.OutlineColor = Color3.fromRGB(255, 180, 80)
	h.FillTransparency = 0.65
	h.OutlineTransparency = 0.15
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = target
	return h
end

local function updateRadar()
	if not radarActive then
		clearRadarHighlights()
		return
	end
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not myRoot then
		clearRadarHighlights()
		return
	end

	local seen: { [number]: boolean } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if char and root and humanoid and humanoid.Health > 0 then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= radarRadius then
					seen[other.UserId] = true
					local h = ensureHighlight(char)
					radarHighlights[other.UserId] = h
				end
			end
		end
	end
	for userId, h in pairs(radarHighlights) do
		if not seen[userId] then
			if h and h.Parent then
				h:Destroy()
			end
			radarHighlights[userId] = nil
		end
	end
end

---------------------------------------------------------------------------------------------------------------
-- territory dropdown
---------------------------------------------------------------------------------------------------------------

type RowInfo = { Name: string, Tag: string, Color: Color3, NameColor: Color3, Rank: number }

local function describe(entry: Types.TerritoryEntryPayload, capturingId: string?, capturePct: number): RowInfo
	local name = tostring(entry.DisplayName or entry.Id)
	if capturingId ~= nil and entry.Id == capturingId then
		return { Name = name, Tag = string.format("%d%%", capturePct), Color = HudConfig.Colors.Gold, NameColor = HudConfig.Colors.White, Rank = 1 }
	end
	if entry.Contested then
		return { Name = name, Tag = "CONTESTED", Color = COL.Contested, NameColor = HudConfig.Colors.White, Rank = 2 }
	end
	local owner = entry.OwnerType
	if owner == "Player" and entry.OwnerUserId == player.UserId then
		return { Name = name, Tag = "YOU", Color = COL.You, NameColor = HudConfig.Colors.White, Rank = 0 }
	elseif owner == "Player" then
		return { Name = name, Tag = "ENEMY", Color = COL.Enemy, NameColor = HudConfig.Colors.White, Rank = 3 }
	elseif owner == "Clan" then
		return { Name = name, Tag = "CLAN", Color = COL.Clan, NameColor = HudConfig.Colors.White, Rank = 3 }
	elseif owner == "NPC" then
		return { Name = name, Tag = "GUARDED", Color = COL.Guarded, NameColor = HudConfig.Colors.White, Rank = 4 }
	end
	return { Name = name, Tag = "NEUTRAL", Color = COL.Neutral, NameColor = COL.Neutral, Rank = 5 }
end

local function rowCount(payload: Types.TerritoryStatePayload?): number
	if not payload then
		return 1
	end
	local n = #(payload.Territories or {})
	if n == 0 then
		n = 1 -- the empty-state line
	end
	if payload.RadarReveal == true then
		n += 1
	end
	return n
end

local function makeText(parent: Instance, name: string, text: string, color: Color3): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Font = HudConfig.Fonts.Body
	t.TextSize = LIST.TextSize
	t.TextColor3 = color
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextTruncate = Enum.TextTruncate.AtEnd
	t.Text = text
	t.Active = false
	t.ZIndex = 7
	t.Parent = parent
	return t
end

local function rebuildList()
	local scroll = listScroll
	local payload = lastPayload
	if not scroll then
		return
	end
	listDirty = false
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local list = if payload then payload.Territories or {} else {}
	local lc = if payload then payload.LocalCapture else nil
	local capId: string? = nil
	local capPct = 0
	if lc and lc.Capturing and lc.TerritoryId then
		capId = lc.TerritoryId
		capPct = math.floor(math.clamp(tonumber(lc.Progress) or 0, 0, 1) * 100)
	end

	local order = 0
	if payload and payload.RadarReveal == true then
		local r = makeText(scroll, "RadarRow", string.format("RADAR ON · %d studs", math.floor(radarRadius)), COL.Radar)
		r.Size = UDim2.new(1, 0, 0, LIST.RowH)
		r.LayoutOrder = order
		order += 1
	end

	local rows: { RowInfo } = {}
	local owned = 0
	for _, entry in ipairs(list) do
		local info = describe(entry, capId, capPct)
		if info.Tag == "YOU" then
			owned += 1
		end
		table.insert(rows, info)
	end
	table.sort(rows, function(a: RowInfo, b: RowInfo): boolean
		if a.Rank ~= b.Rank then
			return a.Rank < b.Rank
		end
		return a.Name < b.Name
	end)

	if #rows == 0 then
		local e = makeText(scroll, "Empty", "No territories yet — explore the map.", COL.Neutral)
		e.Size = UDim2.new(1, 0, 0, LIST.RowH)
		e.LayoutOrder = order
	end
	for _, info in ipairs(rows) do
		local row = Instance.new("Frame")
		row.Name = "Row_" .. info.Name
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, LIST.RowH)
		row.LayoutOrder = order
		row.Active = false
		row.ZIndex = 6
		order += 1

		local dot = Instance.new("Frame")
		dot.Name = "Dot"
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.new(0, 0, 0.5, 0)
		dot.Size = UDim2.fromOffset(LIST.DotSize, LIST.DotSize)
		dot.BackgroundColor3 = info.Color
		dot.BorderSizePixel = 0
		dot.Active = false
		dot.ZIndex = 7
		dot.Parent = row
		UIUtil.Corner(dot, math.ceil(LIST.DotSize / 2))

		local nameLabel = makeText(row, "Name", info.Name, info.NameColor)
		nameLabel.Position = UDim2.fromOffset(LIST.DotSize + 8, 0)
		nameLabel.Size = UDim2.new(1, -(LIST.DotSize + 8 + LIST.TagWidth), 1, 0)

		local tag = makeText(row, "Tag", info.Tag, info.Color)
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.fromScale(1, 0)
		tag.Size = UDim2.new(0, LIST.TagWidth, 1, 0)
		tag.TextXAlignment = Enum.TextXAlignment.Right

		row.Parent = scroll
	end

	local cnt = listCount
	if cnt then
		cnt.Text = string.format("%d/%d", owned, #list)
	end
end

local function headerV(): number
	return touchMinV()
end

-- Position / size in the gui's v space, right-aligned under the compass chip (HudLayout.GetRect("Compass")),
-- down to the jump button on touch. Rects are AbsolutePosition space, like HudLayout's.
local function placeList()
	local f = listPanel
	local screen = _gui
	if not (f and screen) then
		return
	end
	local s = HudLayout.Scale()
	if s <= 0 then
		s = 1
	end
	local content = HudLayout.ContentRect()
	local guiPos = screen.AbsolutePosition
	local cpos, csize = HudLayout.GetRect("Compass")
	local right: number
	local top: number
	-- use the chip only when it really sits in the topbar row (its bottom at or above the content top);
	-- otherwise (no chip yet, a fallback placement) hang the list from the content's top-right corner
	local chipBottom = cpos.Y + csize.Y
	if csize.X > 1 and csize.Y > 1 and chipBottom <= content.Min.Y + HudConfig.TopStack.Top * s then
		right = cpos.X + csize.X
		top = math.max(chipBottom, content.Min.Y) + LIST.Gap * s
	else
		right = content.Max.X - HudConfig.Edge * s
		top = content.Min.Y + HudConfig.TopStack.Top * s
	end
	right = math.min(right, content.Max.X)
	local bottom = content.Max.Y - (if HudLayout.IsTouch() then LIST.JumpClearPx else HudConfig.Edge * s)
	local availV = math.max(LIST.MinHeight, (bottom - top) / s)
	local widthV = math.max(200, math.min(LIST.Width, (right - content.Min.X) / s - HudConfig.Edge))
	-- whole rows only (the rest scrolls), so no row is ever cut in half at the bottom edge
	local hv = headerV()
	local fitRows = math.max(1, math.floor((availV - hv - LIST.PadBottom) / LIST.RowH))
	local shown = math.min(rowCount(lastPayload), fitRows)
	f.Size = UDim2.fromOffset(widthV, hv + shown * LIST.RowH + LIST.PadBottom)
	f.Position = UDim2.fromOffset((right - guiPos.X) / s, (top - guiPos.Y) / s)
end

local function setListOpen(open: boolean)
	if listOpen == open then
		return
	end
	listOpen = open
	local f = listPanel
	local dim = listDim
	if open then
		if listDirty then
			rebuildList()
		end
		placeList()
	end
	if f then
		f.Visible = open
	end
	if dim then
		dim.Visible = open
	end
	if open then
		HudLayout.PanelOpened(PANEL_ID)
	else
		HudLayout.PanelClosed(PANEL_ID)
	end
end

function TerritoryController.IsOpen(): boolean
	return listOpen
end

function TerritoryController.Close()
	setListOpen(false)
end

function TerritoryController.Toggle()
	setListOpen(not listOpen)
end

local function buildList(screen: ScreenGui)
	local f = Instance.new("Frame")
	f.Name = "TerritoryList"
	f.AnchorPoint = Vector2.new(1, 0)
	f.Position = UDim2.new(1, -HudConfig.Edge, 0, HudConfig.TopStack.Top)
	f.Size = UDim2.fromOffset(LIST.Width, LIST.MinHeight)
	f.BackgroundColor3 = LIST.Bg
	f.BackgroundTransparency = LIST.BgTransparency
	f.BorderSizePixel = 0
	f.Active = true -- taps on the list never reach the world
	f.Visible = false
	f.ZIndex = 5
	f.Parent = screen
	UIUtil.Corner(f, LIST.Corner)
	local st = UIUtil.Stroke(f, HudConfig.Colors.PillStroke, 2)
	st.Transparency = HudConfig.Colors.PillStrokeTransparency
	listPanel = f

	local hv = headerV()
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(LIST.PadX, 0)
	title.Size = UDim2.new(0, 0, 0, hv)
	title.AutomaticSize = Enum.AutomaticSize.X
	title.Font = HudConfig.Fonts.Display
	title.TextSize = LIST.TitleSize
	title.TextColor3 = HudConfig.Colors.White
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "TERRITORIES"
	title.Active = false
	title.ZIndex = 7
	title.Parent = f
	UIUtil.TextOutline(title, 1.4)

	local count = makeText(f, "Count", "0/0", HudConfig.Colors.Muted)
	count.AnchorPoint = Vector2.new(1, 0)
	count.Position = UDim2.new(1, -(hv + 4), 0, 0)
	count.Size = UDim2.new(0, 64, 0, hv)
	count.TextXAlignment = Enum.TextXAlignment.Right
	listCount = count

	-- ✕: transparent touch-size hit area around a small rounded face (same look as the panels' close button)
	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.fromScale(1, 0)
	close.Size = UDim2.fromOffset(hv, hv)
	close.BackgroundTransparency = 1
	close.BorderSizePixel = 0
	close.AutoButtonColor = false
	close.Text = ""
	close.Active = true
	close.ZIndex = 7
	close.Parent = f
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromScale(0.6, 0.6)
	face.BackgroundColor3 = Color3.fromRGB(44, 48, 54)
	face.BorderSizePixel = 0
	face.Active = false
	face.ZIndex = 7
	face.Parent = close
	UIUtil.Corner(face, 10)
	HudIcons.Make("Close", face, {
		Size = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 8,
		Color = HudConfig.Colors.White,
		Fill = Color3.fromRGB(44, 48, 54),
	})
	close.Activated:Connect(function()
		setListOpen(false)
	end)
	HudLayout.AssertTouchTarget(close, "TerritoryList.Close")

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(LIST.PadX, hv)
	scroll.Size = UDim2.new(1, -LIST.PadX * 2, 1, -(hv + LIST.PadBottom))
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ZIndex = 6
	scroll.Parent = f
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 0)
	layout.Parent = scroll
	listScroll = scroll

	-- tap / click outside the list closes it (invisible catcher: the world stays visible, Active = false)
	local dim = UIUtil.MakeModalDim(screen, function()
		if listOpen then
			setListOpen(false)
		end
	end, f)
	dim.BackgroundTransparency = 1
	dim.Visible = false
	listDim = dim

	HudLayout.RegisterPanel(PANEL_ID, function(): boolean
		return listOpen
	end, function()
		setListOpen(false)
	end)
	HudLayout.Signals.CompassTapped:Connect(function()
		setListOpen(not listOpen)
	end)
	HudLayout.FlagChanged:Connect(function(name: string, on: boolean)
		if on and listOpen and (name == "Driving" or name == "Dead") then
			setListOpen(false)
		end
	end)
	HudLayout.LayoutChanged:Connect(function()
		if listOpen then
			placeList()
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- capture bar
---------------------------------------------------------------------------------------------------------------

local function setCaptureVisible(visible: boolean)
	if captureActive == visible then
		return
	end
	captureActive = visible
	local p = capture
	if p then
		HudLayout.RefreshVisibility(p.Frame)
	end
end

local function applyCapture(localCap: any)
	local p = capture
	if not (localCap and localCap.Capturing and localCap.TerritoryId) then
		setCaptureVisible(false)
		contestedPulseActive = false
		contestedColA = nil
		contestedColB = nil
		return
	end
	local id = tostring(localCap.TerritoryId)
	local def = TerritoryConfig.Territories[id]
	local name = string.upper(if def then def.DisplayName else id)
	local frac = math.clamp(tonumber(localCap.Progress) or 0, 0, 1)
	local contested = localCap.Contested == true
	local protected = localCap.Protected == true
	if p then
		p.Value.Text = ProgressPill.Percent(frac)
		ProgressPill.SetFraction(p, frac)
		if contested then
			p.Title.Text = "CONTESTED · " .. name
			p.Title.TextColor3 = COL.Contested
			ProgressPill.AccentStroke(p, COL.Contested)
		elseif protected then
			p.Title.Text = "PROTECTED · " .. name
			p.Title.TextColor3 = COL.Protected
			ProgressPill.ResetStroke(p)
		else
			p.Title.Text = "CAPTURING " .. name
			p.Title.TextColor3 = ProgressPill.Colors.Title
			ProgressPill.ResetStroke(p)
		end
	end
	if contested then
		contestedPulseActive = true
		local ca = localCap.ContesterColorA
		local cb = localCap.ContesterColorB
		if typeof(ca) == "table" and typeof(cb) == "table" and #ca >= 3 and #cb >= 3 then
			contestedColA = Color3.new(ca[1], ca[2], ca[3])
			contestedColB = Color3.new(cb[1], cb[2], cb[3])
		else
			contestedColA = COL.Contested
			contestedColB = UIUtil.Lighten(COL.Contested, 0.5)
		end
		if p then
			local pulse = (math.sin(os.clock() * 5) + 1) * 0.5
			p.Fill.BackgroundColor3 = (contestedColA :: Color3):Lerp(contestedColB :: Color3, pulse)
		end
	else
		contestedPulseActive = false
		contestedColA = nil
		contestedColB = nil
		if p then
			p.Fill.BackgroundColor3 = if protected then COL.Protected else ProgressPill.Colors.Fill
		end
	end
	setCaptureVisible(true)
end

---------------------------------------------------------------------------------------------------------------

function TerritoryController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireTerritory"
	-- Core safe insets + the one HUD UIScale; DisplayOrder from HudConfig (28)
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = player:WaitForChild("PlayerGui")
	_gui = screen

	local p = ProgressPill.Build(screen, "CaptureProgress")
	capture = p
	HudLayout.BindVisibility(p.Frame, { HideWhen = { "Dead" } }, function(): boolean
		return captureActive
	end)
	HudLayout.RegisterTopStack("Capture", p.Frame, HudConfig.TopStack.Order.Progress, { Space = "Hud" })

	buildList(screen)

	local applyToken = 0
	Remotes.BindEvent(Constants.RemoteNames.TerritoryStateUpdate, function(payload: Types.TerritoryStatePayload)
		if typeof(payload) ~= "table" then
			return
		end
		applyToken += 1
		local my = applyToken
		task.delay(0.1, function()
			if my == applyToken then
				TerritoryController.Apply(payload)
			end
		end)
	end)

	local radarAccum = 0
	RunService.Heartbeat:Connect(function(dt)
		-- v38: continuous contested dual-color pulse on the capture bar
		local cp = capture
		if contestedPulseActive and cp and contestedColA and contestedColB then
			local pulse = (math.sin(os.clock() * 5) + 1) * 0.5
			cp.Fill.BackgroundColor3 = contestedColA:Lerp(contestedColB, pulse)
		end
		if not radarActive then
			return
		end
		radarAccum += dt
		if radarAccum >= 0.2 then
			radarAccum = 0
			updateRadar()
		end
	end)

	Players.PlayerRemoving:Connect(function(leaving)
		local h = radarHighlights[leaving.UserId]
		if h then
			h:Destroy()
			radarHighlights[leaving.UserId] = nil
		end
	end)
end

function TerritoryController.Apply(payload: Types.TerritoryStatePayload)
	lastPayload = payload

	radarActive = payload.RadarReveal == true
	radarRadius = tonumber(payload.RadarRadius) or TerritoryConfig.RadarRevealRadius or 220
	HudLayout.SetFlag("Radar", radarActive)
	if not radarActive then
		clearRadarHighlights()
	end

	applyCapture(payload.LocalCapture)

	-- the list: rebuild now when it is open, otherwise on the next open
	listDirty = true
	if listOpen then
		rebuildList()
		placeList()
	end

	local owned = 0
	for _, entry in ipairs(payload.Territories or {}) do
		if entry.OwnerUserId == player.UserId and entry.OwnerType == "Player" then
			owned += 1
		end
	end
	local prev = lastOwned
	lastOwned = owned
	if prev ~= nil and owned ~= prev and owned > 0 then
		-- silent Info line in the toast lane (was the TerritoryAlert label)
		NotificationController.Show(string.format("Outposts held: %d", owned), "Info")
	end
end

return TerritoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Interactive tutorial (v31 steps): claim → collect → click-dropper → CC → recruit → barracks → jeep → outpost.

	v70 "clean screen" (spec §3.4 item 3): the step is an OBJECTIVE CHIP in the top-centre stack (HudLayout
	TopStack "Objective"; was a 94 %-wide 168 v card across mid-screen):
	  ( 2 )  Collect cash                              [ GO ]  Skip
	         Touch the Money Collector (green ATM …
	≤ 460×64 v pill (HudConfig.TopStack.Objective), 2 v gold edge. Step disc, title (Display font), hint (Body
	font, up to 2 lines, "…" when longer), GO (64 v hit: runs the step's CTA — BUY/ARMY/GARAGE opener or re-aims
	the beam), Skip (touch-size hit; tap twice — "Sure?" — so a stray tap never ends the tutorial).
	While a step is active the HudLayout flag "Tutorial" is on (offers wait). The chip hides while a panel is open
	(Modal), while Driving (the beam keeps guiding) and while dead. The world guide beam + SelectionBox are unchanged.
	v71 P0-6: every per-player target resolves to the player's OWN plot BEFORE any name lookup (the Tutorial_* marker
	parts are all built on Plot 1, so 5 of 6 players were led into someone else's base):
	  ClaimBase -> own PlayerSpawn · Income -> own WE_MoneyCollector · ClickDropper -> own WE_ManualDropper ·
	  CommandCenter / Barracks -> own console (ConsoleLocator) · Recruit / Jeep -> no beam (GO opens Army / Garage) ·
	  Outpost -> nearest uncontested, walkable territory. No plot id yet -> no beam (re-aimed when it arrives).
	  A marker part is only ever shown when it IS the target (unknown future steps, and only inside the own plot).
	v71 console-only buying: the CommandCenter / Barracks GO only re-aims the beam at the console; it never opens the
	Base panel (that panel cannot buy any more).
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local TutorialConfig = require(Shared.Configs.TutorialConfig)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local ConsoleLocator = require(Shared.Util.ConsoleLocator)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)

local TutorialController = {}

local player = Players.LocalPlayer

local _gui: ScreenGui? = nil
local guideBeam: Beam? = nil
local attach0: Attachment? = nil
local attach1: Attachment? = nil
local highlightPart: BasePart? = nil
local currentMarkerName: string? = nil
local currentPadStructureId: string? = nil
local currentCtaAction: string? = nil
local currentStepId: string? = nil
local myPlotId: number? = nil

-- objective chip
local OBJ = HudConfig.TopStack.Objective
local chip: Frame? = nil
local discLabel: TextLabel? = nil
local titleLabel: TextLabel? = nil
local hintLabel: TextLabel? = nil
local goBtn: TextButton? = nil
local skipBtn: TextButton? = nil
local skipLabel: TextLabel? = nil
local stepActive = false -- a step is showing (drives the "Tutorial" flag and the chip)
local rawTitle = ""
local rawHint = ""

-- chip internals, v (the gui carries HudLayout's MobileScale)
local PAD_L = 10
local DISC = 36
local DISC_GAP = 10
local TEXT_GAP = 6
local PAD_R = 2
local TITLE_H = 22
local GO_FACE = Vector2.new(56, 44)
local CORNER = 16
local GOLD = HudConfig.Colors.Gold
local DARK_INK = HudConfig.Rail.Badge.ReadyText
local SKIP_CONFIRM_SECONDS = 3

local function clearWaypoint()
	if guideBeam then
		guideBeam:Destroy()
		guideBeam = nil
	end
	if attach0 then
		attach0:Destroy()
		attach0 = nil
	end
	if attach1 then
		attach1:Destroy()
		attach1 = nil
	end
	if highlightPart then
		local stroke = highlightPart:FindFirstChild("WE_TutorialHighlight")
		if stroke then
			stroke:Destroy()
		end
		highlightPart = nil
	end
	currentMarkerName = nil
end

-- Show a tutorial marker part only when it IS the resolved target (P0-6: the Tutorial_* markers are built on Plot 1;
-- revealing them led every other player to Plot 1). Everything else stays hidden.
local function syncMarkerVisibility(activePart: BasePart?)
	local tag = Constants.Tags.TutorialMarker
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") then
			local isActive = activePart ~= nil and inst == activePart
			-- MapSetup starts Transparency=1; must set Transparency (not only LocalTransparencyModifier)
			inst.Transparency = if isActive then 0.25 else 1
			inst.LocalTransparencyModifier = 0
			for _, child in ipairs(inst:GetDescendants()) do
				if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
					child.Enabled = isActive == true
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------------------------
-- P0-6 target resolution: the player's OWN plot first, never a fixed world marker (CLAUDE.md "Pointers")
---------------------------------------------------------------------------------------------------------------

local MANUAL_DROPPER_TAG = "WE_ManualDropper" -- ManualDropperService TAG_DROPPER
local OUTPOST_TIER_GAP = 1e6 -- a lower tier always wins over distance

local function ownPlotPad(plotId: number): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			return inst
		end
	end
	return nil
end

-- plot-local rectangle test on the plot pad (the pad carries the plot yaw, so rotated plots need no extra math)
local function insidePad(pad: BasePart, pos: Vector3): boolean
	local lp = pad.CFrame:PointToObjectSpace(pos)
	return math.abs(lp.X) <= pad.Size.X * 0.5 and math.abs(lp.Z) <= pad.Size.Z * 0.5
end

-- nearest part with `tag` whose PlotId is exactly plotId (a part with no PlotId is never "own")
local function nearestOwnTagged(tag: string, plotId: number, origin: Vector3): BasePart?
	local best: BasePart? = nil
	local bestD = math.huge
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId and inst:IsDescendantOf(Workspace) then
			local d = (inst.Position - origin).Magnitude
			if d < bestD then
				bestD = d
				best = inst
			end
		end
	end
	return best
end

local function ownSpawn(plotId: number): BasePart?
	local root = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = root and root:FindFirstChild("Bases")
	local folder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	local sp = folder and folder:FindFirstChild("PlayerSpawn")
	if sp and sp:IsA("BasePart") then
		return sp
	end
	return ownPlotPad(plotId) -- the spawn streamed out / renamed: the plot pad is still inside the plot
end

-- Outpost: the nearest zone the player can take on foot. Tiers: neutral land zone, then any uncontested land zone
-- they do not own, then any uncontested zone (oil rigs need a boat, forts have guards), then anything.
local function nearestOutpost(origin: Vector3, userId: number): BasePart?
	local ot = TerritoryConfig.OwnerTypes
	local best: BasePart? = nil
	local bestScore = math.huge
	local seen: { [Instance]: boolean } = {}
	for _, tag in ipairs({ Constants.Tags.Territory, Constants.Tags.CaptureZone }) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			if not seen[inst] and inst:IsA("BasePart") and inst:IsDescendantOf(Workspace) then
				seen[inst] = true
				local tid = inst:GetAttribute("TerritoryId")
				local def = if typeof(tid) == "string" then (TerritoryConfig.Territories :: any)[tid] else nil
				local ownerType = inst:GetAttribute("OwnerType")
				local contested = ownerType == ot.Contested
				local mine = ownerType == ot.Player and inst:GetAttribute("OwnerUserId") == userId
				local hard = def ~= nil and (def.IsOilRig == true or def.IsFortress == true)
				local tier = if contested or mine then 3 elseif hard then 2 elseif ownerType ~= nil and ownerType ~= ot.Neutral then 1 else 0
				local score = tier * OUTPOST_TIER_GAP + (inst.Position - origin).Magnitude
				if score < bestScore then
					bestScore = score
					best = inst
				end
			end
		end
	end
	return best
end

--[[ Where the tutorial beam points for a step. Pure (reads the world, builds nothing), exported for the headless
	test (every target except Outpost lies inside the player's own plot, plots 1-6, flat and rotated).
	stepId: TutorialStateUpdate.Id; markerName / padStructureId: the step's MarkerName / PadStructureId;
	plotId: the player's own plot (nil = not known yet -> no per-player beam); origin: where "nearest" is measured. ]]
function TutorialController.ResolveTarget(stepId: string?, markerName: string?, padStructureId: string?, plotId: number?, origin: Vector3, userId: number?): BasePart?
	if stepId == "Outpost" or markerName == "Tutorial_Outpost" then
		return nearestOutpost(origin, userId or player.UserId)
	end
	if stepId == "RecruitSoldiers" or markerName == "Tutorial_Recruit" or stepId == "Jeep" or markerName == "Tutorial_Jeep" then
		return nil -- GO opens Army / the Garage; nothing to walk to
	end
	if plotId == nil then
		return nil -- per-player target: wait for the plot id (applyPlotId re-aims)
	end
	if typeof(padStructureId) == "string" and padStructureId ~= "" then
		return ConsoleLocator.Find(plotId, padStructureId)
	end
	if stepId == "ClaimBase" or markerName == "Tutorial_ClaimBase" then
		return ownSpawn(plotId)
	end
	if stepId == "Income" or markerName == "Tutorial_Income" then
		return nearestOwnTagged(Constants.Tags.MoneyCollector, plotId, origin)
	end
	if stepId == "ClickDropper" or markerName == "Tutorial_Dropper" then
		return nearestOwnTagged(MANUAL_DROPPER_TAG, plotId, origin)
	end
	-- unknown (future) step: its named marker, but only when it lies inside the player's own plot
	if typeof(markerName) == "string" and markerName ~= "" then
		local pad = ownPlotPad(plotId)
		if pad then
			for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.TutorialMarker)) do
				if inst:IsA("BasePart") and (inst.Name == markerName or inst:GetAttribute("TutorialStepId") == markerName)
					and insidePad(pad, inst.Position) then
					return inst
				end
			end
		end
	end
	return nil
end

local function originPos(): Vector3
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.Position
	end
	local pad = if myPlotId ~= nil then ownPlotPad(myPlotId) else nil
	return if pad then pad.Position else Vector3.zero
end

local function setWaypoint(markerName: string?, padStructureId: string?)
	clearWaypoint()
	currentMarkerName = markerName
	currentPadStructureId = padStructureId
	local target = TutorialController.ResolveTarget(currentStepId, markerName, padStructureId, myPlotId, originPos())
	syncMarkerVisibility(target)
	if not target then
		return
	end
	highlightPart = target
	local sel = Instance.new("SelectionBox")
	sel.Name = "WE_TutorialHighlight"
	sel.Adornee = target
	sel.Color3 = Constants.Colors.Gold
	sel.LineThickness = 0.06
	sel.Parent = target

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return
	end

	local a0 = Instance.new("Attachment")
	a0.Name = "WE_TutAtt0"
	a0.Parent = hrp
	attach0 = a0
	local a1 = Instance.new("Attachment")
	a1.Name = "WE_TutAtt1"
	a1.Parent = target
	attach1 = a1

	local beam = Instance.new("Beam")
	beam.Name = "WE_TutorialBeam"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.FaceCamera = true
	-- v68: subtle guide (was a thick glowing neon line): thin, mostly transparent, fading out toward the target
	beam.Width0 = 0.22
	beam.Width1 = 0.12
	beam.Color = ColorSequence.new(Color3.fromRGB(240, 214, 110))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0.85) })
	beam.LightEmission = 0.2
	beam.Parent = hrp
	guideBeam = beam
end

---------------------------------------------------------------------------------------------------------------
-- objective chip
---------------------------------------------------------------------------------------------------------------

local function touchMinV(): number
	if HudLayout.IsTouch() then
		-- 64 v = 44.8 real px at the smallest HUD scale (0.70)
		return math.max(HudConfig.Hotbar.Slot, math.ceil(HudConfig.Scale.TouchMinPx / HudConfig.Scale.Min))
	end
	return 0
end

local function goHitV(): number
	return math.max(OBJ.GoHit, touchMinV())
end

local function skipHitV(): number
	return math.max(OBJ.SkipHit, touchMinV())
end

local function chipWidthV(): number
	return math.floor(math.min(OBJ.MaxWidth, HudLayout.TopStackMaxWidthV()))
end

-- rendered size of `text` in v (text size and width are both v, so the gui's UIScale cancels out)
local function measure(text: string, size: number, font: Enum.Font, widthV: number): Vector2
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, size, font, Vector2.new(widthV, 10000))
	end)
	if ok and typeof(v) == "Vector2" then
		return v
	end
	return Vector2.new(#text * size * 0.55, size)
end

local function lineCount(text: string, size: number, font: Enum.Font, widthV: number): number
	if text == "" then
		return 0
	end
	local h = measure(text, size, font, widthV).Y
	return math.max(1, math.floor(h / size + 0.5))
end

-- `text` cut on a word boundary + "…" so it fits in maxLines lines of widthV (TextTruncate stays on as a backstop)
local function fitText(text: string, size: number, font: Enum.Font, widthV: number, maxLines: number): string
	if lineCount(text, size, font, widthV) <= maxLines then
		return text
	end
	local words = string.split(text, " ")
	local lo, hi = 1, #words
	local best = ""
	while lo <= hi do
		local mid = (lo + hi) // 2
		local candidate = table.concat(words, " ", 1, mid) .. "…"
		if lineCount(candidate, size, font, widthV) <= maxLines then
			best = candidate
			lo = mid + 1
		else
			hi = mid - 1
		end
	end
	if best == "" then
		best = string.sub(text, 1, math.max(1, math.floor(widthV / (size * 0.6)))) .. "…"
	end
	return best
end

-- Size the chip to the current scale and lay the title / hint out for 0, 1 or 2 hint lines.
local function layoutChip()
	local c = chip
	local title = titleLabel
	local hint = hintLabel
	local go = goBtn
	local skip = skipBtn
	if not (c and title and hint and go and skip) then
		return
	end
	local w = chipWidthV()
	local h = OBJ.Height
	c.Size = UDim2.fromOffset(w, h)
	local goW = if go.Visible then goHitV() else 0
	local skipW = skipHitV()
	go.Size = UDim2.fromOffset(goW, h)
	go.Position = UDim2.new(1, -(PAD_R + skipW), 0.5, 0)
	skip.Size = UDim2.fromOffset(skipW, h)
	local left = PAD_L + DISC + DISC_GAP
	local textW = math.max(60, w - left - TEXT_GAP - goW - skipW - PAD_R)

	title.Text = fitText(rawTitle, OBJ.TitleSize, HudConfig.Fonts.Display, textW, 1)
	local lines = math.min(2, lineCount(rawHint, OBJ.HintSize, HudConfig.Fonts.Body, textW))
	hint.Text = fitText(rawHint, OBJ.HintSize, HudConfig.Fonts.Body, textW, 2)
	hint.Visible = lines > 0
	local hintH = lines * OBJ.HintSize + 2
	local blockH = TITLE_H + (if lines > 0 then hintH else 0)
	local top = math.max(3, math.floor((h - blockH) / 2))
	title.Position = UDim2.fromOffset(left, top)
	title.Size = UDim2.fromOffset(textW, TITLE_H)
	hint.Position = UDim2.fromOffset(left, top + TITLE_H)
	hint.Size = UDim2.fromOffset(textW, math.max(hintH, 1))
end

local skipArmedAt = -math.huge
local function resetSkip()
	skipArmedAt = -math.huge
	local l = skipLabel
	if l then
		l.Text = "Skip"
		l.TextColor3 = HudConfig.Colors.White
		l.TextTransparency = 0.35
	end
end

local function setVisible(open: boolean)
	if stepActive ~= open then
		stepActive = open
		HudLayout.SetFlag("Tutorial", open)
		local c = chip
		if c then
			HudLayout.RefreshVisibility(c)
		end
	end
	if not open then
		clearWaypoint()
		syncMarkerVisibility(nil)
		resetSkip()
	end
end

local function runCta()
	local action = currentCtaAction
	-- CTA silent (avoid Output spam)
	if action == "PadBuy" then
		-- v71: buying happens at the console only — GO re-aims the beam at it (never opens the Base panel to buy)
		setWaypoint(currentMarkerName, currentPadStructureId)
	elseif action == "OpenBase" then
		-- Base overview (GO rows guide to consoles; it cannot buy)
		setWaypoint(currentMarkerName, currentPadStructureId)
		local ok, BaseController = pcall(function()
			return require(script.Parent.BaseController)
		end)
		if ok and BaseController and BaseController.Open then
			BaseController.Open()
		end
	elseif action == "OpenGarage" then
		local ok, VehicleController = pcall(function()
			return require(script.Parent.VehicleController)
		end)
		if ok and VehicleController and VehicleController.Open then
			VehicleController.Open()
		end
	elseif action == "OpenArmy" then
		local ok, ArmyController = pcall(function()
			return require(script.Parent.ArmyController)
		end)
		if ok and ArmyController and ArmyController.Open then
			ArmyController.Open()
		end
		setWaypoint(currentMarkerName, currentPadStructureId)
	else
		-- Capture / WatchHud / unknown: re-aim beam
		setWaypoint(currentMarkerName, currentPadStructureId)
	end
end

local lastApplyAt = 0.0
local APPLY_DEBOUNCE = 0.2

local pendingPayload: any = nil
local pendingScheduled = false

local function applyState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local now = os.clock()
	if (now - lastApplyAt) < APPLY_DEBOUNCE and payload.Complete ~= true then
		-- coalesce bursty pushes; always allow Complete through.
		-- v69: keep the NEWEST payload and apply it when the window ends. It used to be dropped, so a step
		-- advance pushed right after the join push (Claim → Collect) left the panel on the old step.
		pendingPayload = payload
		if not pendingScheduled then
			pendingScheduled = true
			task.delay(APPLY_DEBOUNCE + 0.05, function()
				pendingScheduled = false
				local latest = pendingPayload
				pendingPayload = nil
				if latest ~= nil then
					applyState(latest)
				end
			end)
		end
		return
	end
	pendingPayload = nil
	lastApplyAt = now
	if payload.Complete == true then
		setVisible(false)
		currentCtaAction = nil
		return
	end

	local step = tonumber(payload.Step) or 0
	local total = tonumber(payload.Total) or TutorialConfig.StepCount()
	rawTitle = tostring(payload.Title or "Tutorial")
	rawHint = tostring(payload.Hint or "")
	local disc = discLabel
	if disc then
		disc.Text = tostring(math.clamp(step, 1, math.max(1, total)))
	end

	local padSid = if typeof(payload.PadStructureId) == "string" then payload.PadStructureId else nil
	local marker = if typeof(payload.MarkerName) == "string" then payload.MarkerName else nil
	currentStepId = if typeof(payload.Id) == "string" then payload.Id else nil
	currentCtaAction = if typeof(payload.CtaAction) == "string" and payload.CtaAction ~= "" then payload.CtaAction else nil
	setWaypoint(marker, padSid)

	local go = goBtn
	if go then
		go.Visible = currentCtaAction ~= nil
	end
	resetSkip()
	layoutChip()
	setVisible(true)
end

local function buildChip(screen: ScreenGui)
	local c = Instance.new("Frame")
	c.Name = "Objective"
	c.AnchorPoint = Vector2.new(0.5, 0)
	c.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top) -- Y is rewritten by HudLayout's top stack
	c.Size = UDim2.fromOffset(chipWidthV(), OBJ.Height)
	c.BackgroundColor3 = HudConfig.Colors.PillBg
	c.BackgroundTransparency = 0.16
	c.BorderSizePixel = 0
	c.Active = true -- taps on the chip never fall through to the world
	c.Visible = false
	c.ZIndex = 2
	c.Parent = screen
	UIUtil.Corner(c, CORNER)
	local st = UIUtil.Stroke(c, GOLD, 2)
	chip = c

	local disc = Instance.new("TextLabel")
	disc.Name = "Step"
	disc.AnchorPoint = Vector2.new(0, 0.5)
	disc.Position = UDim2.new(0, PAD_L, 0.5, 0)
	disc.Size = UDim2.fromOffset(DISC, DISC)
	disc.BackgroundColor3 = GOLD
	disc.BorderSizePixel = 0
	disc.Font = HudConfig.Fonts.Display
	disc.TextSize = OBJ.TitleSize
	disc.TextColor3 = DARK_INK
	disc.Text = "1"
	disc.Active = false
	disc.ZIndex = 3
	disc.Parent = c
	UIUtil.Corner(disc, math.ceil(DISC / 2))
	discLabel = disc

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Font = HudConfig.Fonts.Display
	title.TextSize = OBJ.TitleSize
	title.TextColor3 = HudConfig.Colors.White
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = ""
	title.Active = false
	title.ZIndex = 3
	title.Parent = c
	UIUtil.TextOutline(title, 1.4)
	titleLabel = title

	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.Font = HudConfig.Fonts.Body
	hint.TextSize = OBJ.HintSize
	hint.TextColor3 = HudConfig.Colors.White
	hint.TextTransparency = 0.2
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextYAlignment = Enum.TextYAlignment.Top
	hint.TextWrapped = true
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	hint.Text = ""
	hint.Active = false
	hint.ZIndex = 3
	hint.Parent = c
	hintLabel = hint

	-- GO: transparent touch-size hit area around a gold face (runs the step's CTA)
	local go = Instance.new("TextButton")
	go.Name = "Go"
	go.AnchorPoint = Vector2.new(1, 0.5)
	go.BackgroundTransparency = 1
	go.BorderSizePixel = 0
	go.AutoButtonColor = false
	go.Text = ""
	go.Active = true
	go.Visible = false
	go.ZIndex = 3
	go.Parent = c
	local face = Instance.new("TextLabel")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromOffset(GO_FACE.X, GO_FACE.Y)
	face.BackgroundColor3 = GOLD
	face.BorderSizePixel = 0
	face.Font = HudConfig.Fonts.Display
	face.TextSize = OBJ.TitleSize
	face.TextColor3 = DARK_INK
	face.Text = "GO"
	face.Active = false
	face.ZIndex = 4
	face.Parent = go
	UIUtil.Corner(face, 12)
	local faceStroke = UIUtil.Stroke(face, Color3.fromRGB(107, 77, 0), 2)
	faceStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- the face is a TextLabel: edge, not glyph outline
	local press = Instance.new("UIScale")
	press.Parent = face
	go.MouseButton1Down:Connect(function()
		press.Scale = HudConfig.Rail.PressScale
	end)
	go.MouseButton1Up:Connect(function()
		press.Scale = 1
	end)
	go.MouseLeave:Connect(function()
		press.Scale = 1
	end)
	go.Activated:Connect(function()
		press.Scale = 1
		runCta()
	end)
	goBtn = go
	HudLayout.AssertTouchTarget(go, "Objective.GO")

	-- Skip: first tap arms ("Sure?"), a second tap within SKIP_CONFIRM_SECONDS skips
	local skip = Instance.new("TextButton")
	skip.Name = "Skip"
	skip.AnchorPoint = Vector2.new(1, 0.5)
	skip.Position = UDim2.new(1, -PAD_R, 0.5, 0)
	skip.BackgroundTransparency = 1
	skip.BorderSizePixel = 0
	skip.AutoButtonColor = false
	skip.Text = ""
	skip.Active = true
	skip.ZIndex = 3
	skip.Parent = c
	local sl = Instance.new("TextLabel")
	sl.Name = "Label"
	sl.BackgroundTransparency = 1
	sl.Size = UDim2.fromScale(1, 1)
	sl.Font = HudConfig.Fonts.Body
	sl.TextSize = OBJ.HintSize
	sl.TextColor3 = HudConfig.Colors.White
	sl.TextTransparency = 0.35
	sl.Text = "Skip"
	sl.Active = false
	sl.ZIndex = 4
	sl.Parent = skip
	skipLabel = sl
	skip.Activated:Connect(function()
		local now = os.clock()
		if now - skipArmedAt > SKIP_CONFIRM_SECONDS then
			skipArmedAt = now
			sl.Text = "Sure?"
			sl.TextColor3 = HudConfig.Colors.Warn
			sl.TextTransparency = 0
			task.delay(SKIP_CONFIRM_SECONDS, function()
				if skipArmedAt == now then
					resetSkip()
				end
			end)
			return
		end
		-- Optimistic hide so Skip always feels reliable; the server confirms with Complete
		setVisible(false)
		task.spawn(function()
			Remotes.FireServer(Constants.RemoteNames.RequestSkipTutorial)
		end)
	end)
	skipBtn = skip
	HudLayout.AssertTouchTarget(skip, "Objective.Skip")

	HudLayout.BindVisibility(c, { HideWhen = { "Modal", "Driving", "Dead" } }, function(): boolean
		return stepActive
	end)
	HudLayout.RegisterTopStack("Objective", c, HudConfig.TopStack.Order.Objective, { Space = "Hud" })

	-- soft gold edge pulse while the chip is on screen
	local pulse: Tween? = nil
	local function syncPulse()
		if c.Visible and not pulse then
			local tw = TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
				Transparency = 0.55,
			})
			tw:Play()
			pulse = tw
		elseif not c.Visible and pulse then
			pulse:Cancel()
			pulse = nil
			st.Transparency = 0
		end
	end
	c:GetPropertyChangedSignal("Visible"):Connect(syncPulse)
	syncPulse()

	HudLayout.LayoutChanged:Connect(layoutChip)
	layoutChip()
end

function TutorialController.Init()
	local pg = player:WaitForChild("PlayerGui")
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireTutorial"
	-- Core safe insets + the one HUD UIScale; DisplayOrder from HudConfig (50, under the HUD rail / TopStrip)
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = pg
	_gui = screen
	buildChip(screen)

	Remotes.BindEvent(Constants.RemoteNames.TutorialStateUpdate, applyState)

	-- v69: the plot id arrives as state.Base.PlotId / BaseStatePayload.PlotId. The payload never had a top-level
	-- BasePlotId, so myPlotId stayed nil and the beam could pick another player's pad. nil = no plot (server full).
	local function applyPlotId(plotId: any)
		if typeof(plotId) ~= "number" or plotId == myPlotId then
			return
		end
		myPlotId = plotId
		-- P0-6: every per-player target (spawn, ATM, dropper, console) needs the plot: re-aim once it is known
		if stepActive then
			task.defer(function()
				setWaypoint(currentMarkerName, currentPadStructureId)
			end)
		end
	end

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: any)
		if typeof(state) ~= "table" then
			return
		end
		if state.TutorialComplete == true then
			setVisible(false)
		end
		if typeof(state.Base) == "table" then
			applyPlotId(state.Base.PlotId)
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: any)
		if typeof(base) == "table" then
			applyPlotId(base.PlotId)
		end
	end)

	player.CharacterAdded:Connect(function()
		if currentMarkerName and stepActive then
			task.defer(function()
				setWaypoint(currentMarkerName, currentPadStructureId)
			end)
		end
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="169">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Root UI coordinator (v70 "clean screen"): inits every controller, binds the left rail (5 tiles — no Base,
	no Settings tile, no "opened" toast), the TopStrip settings gear and cash + chip, registers every panel
	with HudLayout (one open at a time → the Modal flag) and routes interior terminals (WE_OpenPanel) to panels.
]]

local UIController = {}

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local AudioController = require(script.Parent.Parent.Modules.AudioController)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local BaseController = require(script.Parent.BaseController)
local TutorialController = require(script.Parent.TutorialController)
local TerritoryController = require(script.Parent.TerritoryController)
local MissionController = require(script.Parent.MissionController)
local ShopController = require(script.Parent.ShopController)
local ProgressionController = require(script.Parent.ProgressionController)
local ArmyController = require(script.Parent.ArmyController)
local OrdersController = require(script.Parent.OrdersController)
local SettingsController = require(script.Parent.SettingsController)
local WorldPromptController = require(script.Parent.WorldPromptController)
local CompassController = require(script.Parent.CompassController)
local VehicleController = require(script.Parent.VehicleController)
local BankRaidController = require(script.Parent.BankRaidController)
local ResearchController = require(script.Parent.ResearchController) -- v69 Research Lab upgrades
local MissileController = require(script.Parent.MissileController) -- v69 Command Center strikes

-- v70 custom ProximityPrompt pills (spec §3.5). Required defensively: a missing or broken module must leave
-- Roblox's Default prompt style in place (spec risk #2), never take the rest of the UI down with it.
local PromptController: any = nil
do
	local mod = script.Parent:FindFirstChild("PromptController")
	if mod and mod:IsA("ModuleScript") then
		local req: any = require
		local ok, res = pcall(req, mod)
		if ok and typeof(res) == "table" then
			PromptController = res
		else
			warn("[WAR EMPIRE] PromptController failed to load — Default prompt style kept:", res)
		end
	end
end

-- Every panel HudLayout keeps exclusive (spec §3.8). A controller that registers itself wins; UIController files a
-- Fallback registration (IsOpen / Close) for the rest. "Orders" = the Army popover (OrdersController).
local PANELS: { { Id: string, Controller: any } } = {
	{ Id = "Shop", Controller = ShopController },
	{ Id = "Rebirth", Controller = ProgressionController },
	{ Id = "Missions", Controller = MissionController },
	{ Id = "Army", Controller = ArmyController },
	{ Id = "Orders", Controller = OrdersController },
	{ Id = "Garage", Controller = VehicleController },
	{ Id = "Settings", Controller = SettingsController },
	{ Id = "Base", Controller = BaseController },
	{ Id = "Research", Controller = ResearchController },
	{ Id = "Missiles", Controller = MissileController },
}

local function panelController(id: string): any
	for _, p in ipairs(PANELS) do
		if p.Id == id then
			return p.Controller
		end
	end
	return nil
end

local function controllerIsOpen(ctrl: any): boolean
	local f = ctrl and ctrl.IsOpen
	if typeof(f) ~= "function" then
		return false
	end
	local ok, open = pcall(f)
	return ok and open == true
end

local function registerPanels()
	for _, p in ipairs(PANELS) do
		local ctrl = p.Controller
		if not HudLayout.HasPanel(p.Id) and typeof(ctrl.IsOpen) == "function" and typeof(ctrl.Close) == "function" then
			HudLayout.RegisterPanel(p.Id, function(): boolean
				return controllerIsOpen(ctrl)
			end, function()
				ctrl.Close()
			end, { Fallback = true })
		end
	end
end

-- After an opener ran, tell HudLayout what the panel now reports — only for a panel that did not report itself
-- (see runOpener), so the fallback never races the panel's own PanelOpened / PanelClosed.
local function syncPanel(id: string)
	local ctrl = panelController(id)
	if not ctrl or typeof(ctrl.IsOpen) ~= "function" then
		return
	end
	if controllerIsOpen(ctrl) then
		HudLayout.PanelOpened(id)
	else
		HudLayout.PanelClosed(id)
	end
end

-- Run a panel opener; if the panel made no PanelOpened / PanelClosed call of its own (HudLayout.PanelSerial
-- unchanged, checked one deferred step later so a deferred self-report still counts), sync it from IsOpen.
local function runOpener(panelId: string?, fn: (...any) -> (), ...: any): (boolean, any)
	local serial = HudLayout.PanelSerial()
	local ok, err = pcall(fn :: any, ...)
	if panelId then
		local id: string = panelId
		task.defer(function()
			if HudLayout.PanelSerial() == serial then
				syncPanel(id)
			end
		end)
	end
	return ok, err
end

-- PromptController.Init failed half-way: put every prompt back on Roblox's own UI so nothing becomes unusable.
local function restoreDefaultPrompts()
	pcall(function()
		if PromptController and typeof(PromptController.Shutdown) == "function" then
			PromptController.Shutdown()
		end
	end)
	pcall(function()
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Style ~= Enum.ProximityPromptStyle.Default then
				d.Style = Enum.ProximityPromptStyle.Default
			end
		end
	end)
end

function UIController.Init()
	local function safeInit(name: string, fn: () -> ()): boolean
		local ok, err = pcall(fn :: any)
		if not ok then
			warn("[WAR EMPIRE] UI Init failed:", name, err)
		end
		return ok
	end
	safeInit("Audio", AudioController.Init)
	-- v60: HUD + WorldPrompt BEFORE Notification — cash never waits on toast remote
	safeInit("HUD", HUDController.Init)
	safeInit("WorldPrompt", WorldPromptController.Init)
	safeInit("Notification", NotificationController.Init)
	if PromptController and typeof(PromptController.Init) == "function" then
		if not safeInit("Prompt", PromptController.Init) then
			restoreDefaultPrompts()
		end
	end
	safeInit("Base", BaseController.Init)
	safeInit("Tutorial", TutorialController.Init)
	safeInit("Territory", TerritoryController.Init)
	safeInit("Mission", MissionController.Init)
	safeInit("Shop", ShopController.Init)
	safeInit("Progression", ProgressionController.Init)
	safeInit("Army", ArmyController.Init)
	safeInit("Orders", OrdersController.Init)
	safeInit("Settings", SettingsController.Init)
	safeInit("Compass", CompassController.Init)
	safeInit("BankRaid", BankRaidController.Init)
	safeInit("Research", ResearchController.Init)
	safeInit("Missiles", MissileController.Init)
	safeInit("Panels", registerPanels)

	-- Rail / gear / cash + press: the opener, ONE click sound, no toast (the panel opening is the feedback).
	local function dockPress(label: string, toggleFn: () -> (), panelId: string?)
		pcall(AudioController.PlayClick)
		local ok, err = runOpener(panelId, toggleFn :: any)
		if not ok then
			warn("[WAR EMPIRE] rail open failed:", label, err)
		end
	end

	-- Cash + (the TopStrip chip since the mobile merge gate) → Shop cash packs (ShopController.OpenCashPacks when
	-- present, else the Shop)
	HUDController.BindShopOpener(function()
		local shop: any = ShopController
		local open: () -> () = if typeof(shop.OpenCashPacks) == "function" then shop.OpenCashPacks else ShopController.Open
		dockPress("Shop", open, "Shop")
	end)
	-- TopStrip gear → Settings (no rail tile, no key)
	HUDController.BindSettingsOpener(function()
		dockPress("Settings", SettingsController.Toggle, "Settings")
	end)

	-- Left rail (spec §3.2): Shop · Rebirth · Army · Garage · Missions. Labels, icons and colours come from
	-- HudConfig.Rail.Tiles; v69's 7-tile dock ({ Name = "DockMissions", Label = "MISSIONS" } …, BASE, SETTINGS)
	-- is gone — Base opens from B / the Command Center terminal, Settings from the TopStrip gear.
	HUDController.BindActionBar({
		{
			Id = "Shop",
			Name = "DockShop",
			OnClick = function()
				dockPress("Shop", ShopController.Toggle, "Shop")
			end,
		},
		{
			Id = "Rebirth",
			Name = "DockRebirth",
			OnClick = function()
				dockPress("Rebirth", ProgressionController.Toggle, "Rebirth")
			end,
		},
		{
			Id = "Army",
			Name = "DockArmy",
			OnClick = function()
				-- the Army popover (OrdersController, spec §3.8); the full Army panel until it exists
				local orders: any = OrdersController
				if typeof(orders.Toggle) == "function" then
					dockPress("Army", orders.Toggle, "Orders")
				else
					dockPress("Army", ArmyController.Toggle, "Army")
				end
			end,
			-- mobile plan P1-6: hold the Army tile to cycle the squad order (the touch twin of T), no popover
			OnLongPress = function()
				local orders: any = OrdersController
				if typeof(orders.CycleOrder) == "function" then
					pcall(AudioController.PlayClick)
					orders.CycleOrder()
				end
			end,
		},
		{
			Id = "Garage",
			Name = "DockGarage",
			OnClick = function()
				dockPress("Garage", VehicleController.Toggle, "Garage")
			end,
		},
		{
			Id = "Missions",
			Name = "DockMissions",
			OnClick = function()
				dockPress("Missions", MissionController.Toggle, "Missions")
			end,
		},
	})
	print("[WAR EMPIRE] UIController: rail bound (Shop/Rebirth/Army/Garage/Missions) + TopStrip gear")

	-- v68: item terminals inside walk-in buildings (server HollowBuildingBuilder + Interiors/*) carry the
	-- panel to open in the prompt attribute WE_OpenPanel. Keep this list in sync with the interior checker.
	local panelOpeners: { [string]: (...any) -> () } = {
		Base = BaseController.Open,
		Shop = ShopController.Open,
		Rebirth = ProgressionController.Open,
		Missions = MissionController.Open,
		Army = ArmyController.Open,
		Garage = VehicleController.Open,
		Settings = SettingsController.Open,
		Research = ResearchController.Open,
		Missiles = MissileController.Open,
	}
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= Players.LocalPlayer then
			return
		end
		local panel = prompt:GetAttribute("WE_OpenPanel")
		if typeof(panel) ~= "string" then
			return
		end
		local open = panelOpeners[panel]
		if not open then
			warn("[WAR EMPIRE] terminal opens unknown panel:", panel)
			return
		end
		pcall(AudioController.PlayClick)
		-- optional tab hint on the prompt (e.g. the Armory counter opens Shop → Weapons)
		local tab = prompt:GetAttribute("WE_OpenTab")
		local ok, err
		if typeof(tab) == "string" and panel == "Shop" and ShopController.OpenTab then
			ok, err = runOpener(panel, ShopController.OpenTab :: any, tab)
		else
			ok, err = runOpener(panel, open, if typeof(tab) == "string" then tab else nil)
		end
		if not ok then
			warn("[WAR EMPIRE] terminal panel failed:", panel, err)
		end
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="170">
            <Properties>
              <string name="Name">VehicleController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Phase 4/7 — Garage UI (G). Spawn / buy / despawn requests only.
	Category + rarity + Owned filters for large roster (~99). ScrollingFrame AutomaticCanvasSize.
	Empty states via UIUtil.EmptyState.
	Mobile: ≥48px filter chips, ≥52px row actions, Activated (not MouseButton1 only),
	responsive panel, clear empty / filter-empty / no-owned banners.

	v70 (garage audit G4):
	  * Rows show why a vehicle is locked ("LOCKED\nLv 10", "Depot L2", "Prestige 5", "Rebirth") instead of an
	    active gold BUY; tapping a locked / unaffordable row explains it and sends nothing.
	  * No periodic rebuild: the cooldown ticker only repaints buttons in place. Rows are rebuilt only on open,
	    on a filter change, or when owned ids / the active vehicle / the unlock gates change (debounced 0.25 s).
	  * Remotes only via Remotes.BindEvent / Remotes.FireServer (never a blocking GetEvent).
	  * Sort: active, owned, buyable, can't afford, locked. Open(tab) presets the category (terminal WE_OpenTab).
	  * Touch: the panel closes once the requested vehicle is deployed.
	  * Init also starts VehicleDriveClient (the client half of drivable vehicles).

	v70 "clean screen" HUD (spec §3.7 / §3.8):
	  * No desktop GARAGE toggle: the rail's Garage tile, G (HudConfig.Keys.Garage), the vehicle-pad prompt and
	    the Vehicle Depot terminal open it. A registered Modal panel (HudLayout id "Garage") with the black dim.
	  * One HUD scale + safe area (PanelShell / HudLayout.ApplyScreen). Touch: one row of 64 v filter chips (the
	    rarity chip cycles), 64 v row buttons, ≥ 16 v text.
	  * Rail badge "!" (NewVehicle) while a vehicle bought this session has not been spawned; cleared on open.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local VehicleConfig = require(Shared.Configs.VehicleConfig)

local HudConfig = require(Shared.Configs.HudConfig)

local AudioController = require(script.Parent.Parent.Modules.AudioController)
local VehicleDriveClient = require(script.Parent.Parent.Modules.VehicleDriveClient)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local PanelShell = require(script.Parent.Parent.Modules.PanelShell)

type VehicleDef = VehicleConfig.VehicleDef

export type Gates = {
	Level: number,
	Prestige: number,
	Structures: { [string]: number },
	Rebirth: { [string]: boolean },
}

export type RowCtx = {
	Owned: any, -- { [id]: true } map (or a boolean for this row)
	ActiveId: string?,
	Cooldown: number,
	Gates: Gates?,
	Cash: number?,
}

export type RowState = {
	Kind: string, -- Despawn | Cooldown | Spawn | Locked | CantAfford | Buy | Claim
	Text: string,
	Enabled: boolean,
	Reason: string?, -- Locked: short reason
	Need: number?, -- CantAfford: cash missing
}

local VehicleController = {}

local PANEL_ID = "Garage"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local shell: PanelShell.Shell? = nil

-- v70 rail badge (HudConfig.Rail.BadgeSources.Garage = "NewVehicle"): "!" while a vehicle bought / granted this
-- session has not been spawned yet; opening the Garage clears it. The join sync (incl. a late starter Jeep merge)
-- never counts as new.
local NEW_VEHICLE_GRACE_SECONDS = 10
local newVehicleIds: { [string]: boolean } = {}
local ownedSyncedAt: number? = nil

local screenGui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local cooldownLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local panelFrame: Frame? = nil
local isOpen = false
local paintFilters: (() -> ())? = nil

local ownedMap: { [string]: boolean } = {}
local activeId: string? = nil
local cooldownLeft = 0
local gates: Gates = { Level = 1, Prestige = 0, Structures = {}, Rebirth = {} }
local filterCategory: string = "All" -- All | Ground | Air | Naval
local filterRarity: string = "All" -- All | Common | Uncommon | Rare | Epic | Legendary
local filterOwnedOnly = false
local rarityColors: { [string]: Color3 } = {
	Common = Color3.fromRGB(160, 165, 170),
	Uncommon = Color3.fromRGB(90, 180, 110),
	Rare = Color3.fromRGB(80, 140, 220),
	Epic = Color3.fromRGB(170, 90, 220),
	Legendary = Color3.fromRGB(230, 170, 60),
}

-- rows currently on screen: every row's action button, and the owned (spawn / cooldown) subset
local rowButtons: { [string]: TextButton } = {}
local spawnButtons: { [string]: TextButton } = {}
local buyingUntil: { [string]: number } = {}
local lastBuiltSig = ""
local rebuildPending = false
local repaintPending = false
local lastSpawnRequestedId: string? = nil

local STRUCTURE_SHORT: { [string]: string } =
	{ VehicleDepot = "Depot", Helipad = "Helipad", Airfield = "Airfield", Dock = "Dock" }
local STRUCTURE_LONG: { [string]: string } =
	{ VehicleDepot = "Vehicle Depot", Helipad = "Helipad", Airfield = "Airfield", Dock = "Dock" }
local KIND_RANK: { [string]: number } =
	{ Despawn = 0, Cooldown = 1, Spawn = 1, Claim = 2, Buy = 2, CantAfford = 3, Locked = 4 }

local function addCorner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

-- UIUtil.EmptyState at the panel text floor (≥ 11 real px)
local function emptyState(parent: Instance, message: string)
	local lab = UIUtil.EmptyState(parent, message, 0)
	lab.TextSize = PanelShell.Text(13)
	lab.Size = UDim2.new(1, -8, 0, PanelShell.Text(13) * 3 + 8)
	lab.Font = Enum.Font.GothamMedium
end

local function commas(n: number): string
	local s = tostring(math.floor(math.max(0, n) + 0.5))
	local out = s
	while true do
		local k
		out, k = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return out
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Pure row logic (tested headless)
-- ─────────────────────────────────────────────────────────────────────────────

--[[ Short lock reason for a not-owned vehicle, or nil when it can be bought. Order: level, structure,
	prestige, rebirth flag (same order as VehicleService.Purchase). ]]
function VehicleController._LockReason(def: VehicleDef, g: Gates?): string?
	if g == nil then
		return nil
	end
	if (g.Level or 1) < def.UnlockLevel then
		return "Lv " .. tostring(def.UnlockLevel)
	end
	local req = def.RequiresStructure
	if req then
		local have = (g.Structures and g.Structures[req.StructureId]) or 0
		if have < req.Level then
			return (STRUCTURE_SHORT[req.StructureId] or req.StructureId) .. " L" .. tostring(req.Level)
		end
	end
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 and (g.Prestige or 0) < needP then
		return "Prestige " .. tostring(needP)
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" and not (g.Rebirth and g.Rebirth[flag] == true) then
		return "Rebirth"
	end
	return nil
end

--[[ Long form for the status line: "<Name> needs <reason> (you have …)". ]]
function VehicleController._LockDetail(def: VehicleDef, g: Gates): string?
	local name = def.DisplayName or def.Id
	if (g.Level or 1) < def.UnlockLevel then
		return string.format("%s needs Level %d (you have Lv %d)", name, def.UnlockLevel, g.Level or 1)
	end
	local req = def.RequiresStructure
	if req then
		local have = (g.Structures and g.Structures[req.StructureId]) or 0
		if have < req.Level then
			return string.format(
				"%s needs %s L%d (you have L%d)",
				name,
				STRUCTURE_LONG[req.StructureId] or req.StructureId,
				req.Level,
				have
			)
		end
	end
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 and (g.Prestige or 0) < needP then
		return string.format("%s needs Prestige %d (you have %d)", name, needP, g.Prestige or 0)
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" and not (g.Rebirth and g.Rebirth[flag] == true) then
		return string.format("%s needs the %s rebirth unlock (you have not unlocked it yet)", name, flag)
	end
	return nil
end

function VehicleController._RowState(id: string, def: VehicleDef, ctx: RowCtx): RowState
	if ctx.ActiveId == id then
		return { Kind = "Despawn", Text = "DESPAWN", Enabled = true }
	end
	local owned = if typeof(ctx.Owned) == "table" then ctx.Owned[id] == true else ctx.Owned == true
	if owned then
		local cd = ctx.Cooldown or 0
		if cd > 0 then
			return { Kind = "Cooldown", Text = string.format("%ds", math.max(1, math.floor(cd + 0.5))), Enabled = false }
		end
		return { Kind = "Spawn", Text = "SPAWN", Enabled = true }
	end
	local reason = VehicleController._LockReason(def, ctx.Gates)
	if reason then
		return { Kind = "Locked", Text = "LOCKED\n" .. reason, Enabled = false, Reason = reason }
	end
	local price = def.CostCash or 0
	if price <= 0 then
		return { Kind = "Claim", Text = "CLAIM", Enabled = true }
	end
	local text = "BUY $" .. commas(price)
	local cash = ctx.Cash
	if cash ~= nil and cash < price then
		return { Kind = "CantAfford", Text = text, Enabled = false, Need = price - cash }
	end
	return { Kind = "Buy", Text = text, Enabled = true }
end

--[[ Each source overwrites only the fields it carries. Structures / Rebirth are full maps. ]]
function VehicleController._MergeGates(g: Gates, patch: any): Gates
	if typeof(patch) ~= "table" then
		return g
	end
	local lvl = tonumber(patch.Level)
	if lvl then
		g.Level = lvl
	end
	local pres = tonumber(patch.Prestige)
	if pres then
		g.Prestige = pres
	end
	if typeof(patch.Structures) == "table" then
		local s: { [string]: number } = {}
		for k, v in pairs(patch.Structures) do
			local n = tonumber(v)
			if typeof(k) == "string" and n then
				s[k] = n
			end
		end
		g.Structures = s
	end
	if typeof(patch.Rebirth) == "table" then
		local r: { [string]: boolean } = {}
		for k, v in pairs(patch.Rebirth) do
			if typeof(k) == "string" and v == true then
				r[k] = true
			end
		end
		g.Rebirth = r
	end
	return g
end

local function ownedSig(map: { [string]: boolean }): string
	local ids = {}
	for id, v in pairs(map) do
		if v == true then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return table.concat(ids, ",")
end

local function gatesSig(g: Gates): string
	local s: { [string]: number } = g.Structures or {}
	local flags = {}
	for k, v in pairs(g.Rebirth or {}) do
		if v == true then
			table.insert(flags, k)
		end
	end
	table.sort(flags)
	return string.format(
		"%d|%d|%d,%d,%d,%d|%s",
		g.Level or 0,
		g.Prestige or 0,
		s.VehicleDepot or 0,
		s.Helipad or 0,
		s.Airfield or 0,
		s.Dock or 0,
		table.concat(flags, ",")
	)
end

local function dataSig(): string
	return ownedSig(ownedMap) .. "#" .. tostring(activeId) .. "#" .. gatesSig(gates)
end

local function currentCtx(): RowCtx
	return {
		Owned = ownedMap,
		ActiveId = activeId,
		Cooldown = cooldownLeft,
		Gates = gates,
		Cash = tonumber(player:GetAttribute("WE_Cash")),
	}
end

local function sortedIds(): { string }
	local ctx = currentCtx()
	local ids = {}
	local rank: { [string]: number } = {}
	for id, def in pairs(VehicleConfig.Vehicles) do
		local cat = if def then (def.Category or "Ground") else "Ground"
		local rar = if def then (def.Rarity or "Common") else "Common"
		local catOk = filterCategory == "All" or cat == filterCategory
		local rarOk = filterRarity == "All" or rar == filterRarity
		local ownedOk = not filterOwnedOnly or ownedMap[id] == true
		if catOk and rarOk and ownedOk then
			table.insert(ids, id)
			rank[id] = KIND_RANK[VehicleController._RowState(id, def, ctx).Kind] or 5
		end
	end
	table.sort(ids, function(a, b)
		local ra, rb = rank[a], rank[b]
		if ra ~= rb then
			return ra < rb
		end
		local da = VehicleConfig.Vehicles[a]
		local db = VehicleConfig.Vehicles[b]
		local la = da and da.UnlockLevel or 0
		local lb = db and db.UnlockLevel or 0
		if la == lb then
			return a < b
		end
		return la < lb
	end)
	return ids
end

local function ownedCount(): number
	local n = 0
	for _, v in pairs(ownedMap) do
		if v == true then
			n += 1
		end
	end
	return n
end

local function catalogCount(): number
	local n = 0
	for _ in pairs(VehicleConfig.Vehicles) do
		n += 1
	end
	return n
end

local lastSpawnRequestAt = -math.huge
local SPAWN_CLIENT_DEBOUNCE = 0.85
local BUYING_SECONDS = 1.5

local function setStatus(text: string)
	if statusLabel then
		statusLabel.Text = text
	end
end

local function updateCooldownLabel()
	if cooldownLabel then
		cooldownLabel.Text = if cooldownLeft > 0
			then string.format("Spawn cooldown: %ds", math.max(1, math.floor(cooldownLeft + 0.5)))
			else "Spawn ready"
	end
end

local function bindTap(btn: GuiButton, fn: () -> ())
	btn.Activated:Connect(function()
		pcall(AudioController.PlayClick)
		fn()
	end)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Painting (in place — never creates instances)
-- ─────────────────────────────────────────────────────────────────────────────
local DARK_TEXT = Color3.fromRGB(20, 22, 18)

local function paintButton(btn: TextButton, id: string, st: RowState)
	local kind = st.Kind
	local text = st.Text
	local enabled = st.Enabled
	local bg, fg = Constants.Colors.Gold, DARK_TEXT
	local textSize = PanelShell.Text(if isTouch then 14 else 13)
	local wrapped = false
	if kind == "Despawn" then
		bg, fg = Constants.Colors.Danger, Constants.Colors.Text
	elseif kind == "Spawn" then
		bg, fg = Constants.Colors.Accent, Constants.Colors.Text
	elseif kind == "Cooldown" then
		bg, fg = Constants.Colors.Gunmetal, Constants.Colors.Muted
	elseif kind == "Locked" then
		bg, fg = Constants.Colors.Gunmetal, Constants.Colors.Muted
		textSize = PanelShell.Text(12)
		wrapped = true
	elseif kind == "CantAfford" then
		bg, fg = Constants.Colors.Gunmetal, Constants.Colors.Gold
	end
	if (kind == "Buy" or kind == "Claim" or kind == "CantAfford") and (buyingUntil[id] or 0) > os.clock() then
		text = "BUYING…"
		enabled = false
		bg, fg = Constants.Colors.GunmetalLight, Constants.Colors.Gold
	end
	if btn.Text ~= text then
		btn.Text = text
	end
	btn.BackgroundColor3 = bg
	btn.TextColor3 = fg
	btn.TextSize = textSize
	btn.TextWrapped = wrapped
	btn.AutoButtonColor = enabled
	btn:SetAttribute("WE_Kind", kind)
	btn:SetAttribute("WE_Disabled", not enabled)
end

local function paintRow(id: string)
	local btn = rowButtons[id]
	local def = VehicleConfig.Vehicles[id]
	if btn and def and btn.Parent then
		paintButton(btn, id, VehicleController._RowState(id, def, currentCtx()))
	end
end

local function repaintAll()
	for id in pairs(rowButtons) do
		paintRow(id)
	end
	updateCooldownLabel()
end

local function repaintOwned()
	for id in pairs(spawnButtons) do
		paintRow(id)
	end
	updateCooldownLabel()
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Actions
-- ─────────────────────────────────────────────────────────────────────────────
local function fireSpawn(vehicleId: string)
	local now = os.clock()
	if now - lastSpawnRequestAt < SPAWN_CLIENT_DEBOUNCE then
		setStatus("Spawn request cooling down…")
		return
	end
	if cooldownLeft > 0 then
		setStatus(string.format("Spawn ready in %ds", math.max(1, math.floor(cooldownLeft + 0.5))))
		return
	end
	lastSpawnRequestAt = now
	lastSpawnRequestedId = vehicleId
	local def = VehicleConfig.Vehicles[vehicleId]
	setStatus("Deploying " .. (if def then def.DisplayName else vehicleId) .. "…")
	task.spawn(function()
		if not Remotes.FireServer(Constants.RemoteNames.RequestSpawnVehicle, vehicleId) then
			setStatus("Garage offline — try again in a moment")
		end
	end)
end

local function firePurchase(id: string, def: VehicleDef)
	buyingUntil[id] = os.clock() + BUYING_SECONDS
	paintRow(id)
	setStatus("Buying " .. def.DisplayName .. "…")
	task.spawn(function()
		if not Remotes.FireServer(Constants.RemoteNames.RequestPurchaseVehicle, id) then
			setStatus("Garage offline — try again in a moment")
		end
	end)
	task.delay(BUYING_SECONDS + 0.05, function()
		paintRow(id)
	end)
end

local function onRowTap(id: string)
	local def = VehicleConfig.Vehicles[id]
	if not def then
		return
	end
	local st = VehicleController._RowState(id, def, currentCtx())
	local kind = st.Kind
	if kind == "Despawn" then
		setStatus("Despawning " .. def.DisplayName .. "…")
		task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestDespawnVehicle)
	elseif kind == "Cooldown" then
		setStatus(string.format("Spawn ready in %ds", math.max(1, math.floor(cooldownLeft + 0.5))))
	elseif kind == "Spawn" then
		fireSpawn(id)
	elseif kind == "Locked" then
		setStatus(VehicleController._LockDetail(def, gates) or (def.DisplayName .. " is locked"))
	elseif (buyingUntil[id] or 0) > os.clock() then
		setStatus("Buying " .. def.DisplayName .. "…")
	elseif kind == "CantAfford" then
		setStatus(string.format("Need $%s more for %s", commas(st.Need or 0), def.DisplayName))
	else
		firePurchase(id, def)
	end
end

-- Copy by device (mobile merge gate #7, CLAUDE.md §1): key names only while HudLayout.PrefersKeys() (PreferredInput
-- keyboard / gamepad); touch players read what their own controls do (stick, ▲ — VehicleDriveClient's touch hints).
local function rowTip(def: VehicleDef): string
	local cat = def.Category or "Ground"
	local keys = HudLayout.PrefersKeys()
	if cat == "Air" then
		if string.sub(def.KitFamily or "", 1, 4) == "Heli" then
			return if keys then "Deploys on your Helipad · SPACE/▲ climb" else "Deploys on your Helipad · ▲ climbs"
		end
		return if keys then "Deploys on your runway · hold W" else "Deploys on your runway · stick up to go"
	elseif cat == "Naval" then
		return if keys then "Deploys at your dock / the coast · WASD" else "Deploys at your dock / the coast"
	end
	return if keys then "Sit · WASD drive" else "Sit · drive with the stick"
end

-- garage chips carry whole words ("GROUND", "COMMON" — never "GRO" / "COMM"): width follows the text
local function chipWidthFor(text: string, size: number, minW: number): number
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, size, Enum.Font.GothamBold, Vector2.new(1000, 100))
	end)
	-- never trust a short measurement (font fallbacks draw wider): at least ~0.62 em per character, plus padding
	local est = (utf8.len(text) or #text) * size * 0.62
	local w = if ok and typeof(v) == "Vector2" and v.X > 0 then math.max(v.X, est) else est
	return math.max(minW, math.ceil(w) + 18)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Full rebuild (open, filter change, owned / active / gates change)
-- ─────────────────────────────────────────────────────────────────────────────
local function rebuild()
	local list = listFrame
	if not list then
		return
	end
	lastBuiltSig = dataSig()
	table.clear(rowButtons)
	table.clear(spawnButtons)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end
	if not list:FindFirstChildOfClass("UIListLayout") then
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, if isTouch then 8 else 6)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
	end

	local ids = sortedIds()
	local ownedN = ownedCount()
	local catalogN = catalogCount()

	setStatus(
		string.format(
			"%d shown · %d owned · %d in catalog%s",
			#ids,
			ownedN,
			catalogN,
			if filterOwnedOnly then " · OWNED filter" else ""
		)
	)
	updateCooldownLabel()

	if catalogN == 0 then
		emptyState(list, "Garage empty — no vehicles configured yet.")
		return
	end

	if #ids == 0 then
		local msg = if filterOwnedOnly
			then "No owned rides yet — buy Vehicle Depot / unlock Military Jeep, or turn off OWNED."
			else "No vehicles match these filters — tap All / clear rarity."
		emptyState(list, msg)
		return
	end

	-- Friendly empty banner when nothing owned yet (full catalog still listed below)
	if ownedN == 0 and not filterOwnedOnly then
		emptyState(
			list,
			"Garage empty — buy Vehicle Depot / unlock Military Jeep (gold BUY → SPAWN). Starter Jeep syncs after join."
		)
	elseif ownedN > 0 and filterOwnedOnly == false then
		-- soft tip only when filters hide all owned
		local ownedVisible = 0
		for _, id in ipairs(ids) do
			if ownedMap[id] then
				ownedVisible += 1
			end
		end
		if ownedVisible == 0 then
			emptyState(list, "None of your rides match these filters — tap OWNED or All to find them.")
		end
	end

	-- v70: touch rows hold a 64 v action button (44.8 real px) and ≥ 16 v text (11.2 px) at the phone scale
	local titleSize = PanelShell.Text(if isTouch then 15 else 14)
	local chipTextSize = PanelShell.Text(9)
	local chipW = if isTouch then 64 else 60
	local chipHt = chipTextSize + 6
	local metaSize = PanelShell.Text(if isTouch then 12 else 11)
	local chipTop = 4 + titleSize + 6
	local metaTop = chipTop + chipHt + 4
	local metaH = if isTouch then metaSize * 2 + 6 else 26
	local rowH = math.max(if isTouch then 92 else 78, metaTop + metaH + 6)
	local btnW = if isTouch then 132 else 100
	local btnH = if isTouch then PanelShell.TouchMinV() else 44

	for i, id in ipairs(ids) do
		local def = VehicleConfig.Vehicles[id]
		if def then
			local row = Instance.new("Frame")
			row.Name = "Row_" .. id
			row.Size = UDim2.new(1, -8, 0, rowH)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = i
			row.Parent = list
			addCorner(row, 8)

			local rarBar = Instance.new("Frame")
			rarBar.Size = UDim2.new(0, 4, 1, -8)
			rarBar.Position = UDim2.fromOffset(4, 4)
			rarBar.BorderSizePixel = 0
			rarBar.BackgroundColor3 = rarityColors[def.Rarity] or Constants.Colors.Muted
			rarBar.Parent = row
			addCorner(rarBar, 2)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromOffset(14, 4)
			title.Size = UDim2.new(1, -(btnW + 28), 0, titleSize + 4)
			title.Font = Enum.Font.GothamBold
			title.TextSize = titleSize
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.TextColor3 = Constants.Colors.Text
			title.Text = def.DisplayName
			title.TextTruncate = Enum.TextTruncate.AtEnd
			title.Parent = row

			local cat = def.Category or "Ground"
			local catCol = if cat == "Air"
				then Constants.Colors.CategoryAir
				elseif cat == "Naval" then Constants.Colors.CategoryNaval
				else Constants.Colors.CategoryGround
			local chipY = chipTop
			local function makeChip(label: string, color: Color3, x: number): number
				local w = chipWidthFor(label, chipTextSize, chipW)
				local chip = Instance.new("Frame")
				chip.Size = UDim2.fromOffset(w, chipHt)
				chip.Position = UDim2.fromOffset(x, chipY)
				chip.BackgroundColor3 = color
				chip.BorderSizePixel = 0
				chip.Parent = row
				addCorner(chip, 4)
				local lab = Instance.new("TextLabel")
				lab.BackgroundTransparency = 1
				lab.Size = UDim2.fromScale(1, 1)
				lab.Font = Enum.Font.GothamBold
				lab.TextSize = chipTextSize
				lab.TextColor3 = Color3.fromRGB(12, 14, 16)
				lab.Text = label
				lab.Parent = chip
				return x + w + 4
			end
			local nextX = makeChip(string.upper(cat), catCol, 14)
			nextX = makeChip(string.upper(def.Rarity or "Common"), rarityColors[def.Rarity] or Constants.Colors.Muted, nextX)
			-- v32: ArmedJeep lists with explicit DisplayName + ARMED chip (same WheeledLight drive as MilitaryJeep)
			if id == "ArmedJeep" then
				title.Text = def.DisplayName or "Armed Jeep"
				makeChip("ARMED", Color3.fromRGB(180, 70, 55), nextX)
			end

			local meta = Instance.new("TextLabel")
			meta.BackgroundTransparency = 1
			meta.Position = UDim2.fromOffset(14, metaTop)
			meta.Size = UDim2.new(1, -(btnW + 28), 0, metaH)
			meta.Font = Enum.Font.GothamMedium
			meta.TextSize = metaSize
			meta.TextXAlignment = Enum.TextXAlignment.Left
			meta.TextYAlignment = Enum.TextYAlignment.Top
			meta.TextColor3 = Constants.Colors.Muted
			meta.TextWrapped = true
			local req = ""
			if def.RequiresStructure then
				req = string.format(
					" | %s L%d",
					STRUCTURE_SHORT[def.RequiresStructure.StructureId] or def.RequiresStructure.StructureId,
					def.RequiresStructure.Level
				)
			end
			if typeof(def.RequiresPrestige) == "number" and (def.RequiresPrestige :: number) > 0 then
				req ..= string.format(" | P%d+", def.RequiresPrestige :: number)
			end
			if typeof(def.RequiresRebirthFlag) == "string" and (def.RequiresRebirthFlag :: string) ~= "" then
				req ..= " | Rebirth"
			end
			meta.Text = string.format(
				"%s · Lv %d · $%s · Spd %d%s",
				rowTip(def),
				def.UnlockLevel,
				commas(def.CostCash or 0),
				def.Speed,
				req
			)
			meta.Parent = row

			local btn = Instance.new("TextButton")
			btn.Name = "Action"
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -10, 0.5, 0)
			btn.Size = UDim2.fromOffset(btnW, btnH)
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = PanelShell.Text(if isTouch then 14 else 13)
			btn.TextColor3 = Constants.Colors.Text
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = true
			-- stays Active so a tap on a locked / cooling row can explain itself (WE_Disabled marks "no action")
			btn.Active = true
			btn.Parent = row
			addCorner(btn, 8)
			UIUtil.EnsureMinTouch(btn, btnH)
			rowButtons[id] = btn
			if ownedMap[id] or activeId == id then
				spawnButtons[id] = btn
			end
			paintRow(id)
			bindTap(btn, function()
				onRowTap(id)
			end)
		end
	end
end

-- data changed (payloads / attributes): rebuild once, 0.25 s later, only if something that
-- changes the rows' order or kind changed; otherwise repaint in place
local function scheduleRebuild()
	if not isOpen or rebuildPending then
		return
	end
	rebuildPending = true
	task.delay(0.25, function()
		rebuildPending = false
		if isOpen and dataSig() ~= lastBuiltSig then
			rebuild()
		end
	end)
end

local function scheduleRepaint()
	if not isOpen or repaintPending then
		return
	end
	repaintPending = true
	task.delay(0.25, function()
		repaintPending = false
		if isOpen then
			repaintAll()
		end
	end)
end

local function refreshNewVehicleBadge()
	HudLayout.SetBadge("Garage", if next(newVehicleIds) ~= nil then "!" else nil)
end

-- a fresh owned map from the server: ids that were not owned before are "new" (after the join grace window)
local function noteOwned(owned: { [string]: boolean })
	local now = os.clock()
	local syncedAt = ownedSyncedAt
	if syncedAt == nil then
		ownedSyncedAt = now
		return
	end
	if now - syncedAt < NEW_VEHICLE_GRACE_SECONDS or isOpen then
		return
	end
	local changed = false
	for id in pairs(owned) do
		if not ownedMap[id] and id ~= activeId then
			newVehicleIds[id] = true
			changed = true
		end
	end
	if changed then
		refreshNewVehicleBadge()
	end
end

local function onDataChanged()
	if not isOpen then
		return
	end
	if dataSig() ~= lastBuiltSig then
		scheduleRebuild()
	else
		scheduleRepaint()
	end
end

local function setOpen(value: boolean)
	isOpen = value
	if screenGui then
		screenGui.Enabled = true
		local panel: GuiObject? = panelFrame
		if panel then
			panel.Visible = value
		end
	end
	local sh = shell
	if sh then
		sh.Sync(value)
	end
	if value then
		-- v70: opening the Garage clears the rail's "!" (HUDController also clears it on PanelChanged)
		table.clear(newVehicleIds)
		refreshNewVehicleBadge()
		rebuild()
		print("[WAR EMPIRE] Garage opened — owned=", ownedCount(), "active=", tostring(activeId))
	end
end

local function buildGui()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireGarage"
	screen.Enabled = true
	-- v70: DisplayOrder 60 (Panels) above the HUD rail (55); one HUD scale + safe area (HudLayout.ApplyScreen)
	PanelShell.Screen(screen)
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()
	local panel = Instance.new("Frame")
	panel.Name = "GaragePanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	-- Phone-friendly: scale with a max offset so it fits every landscape phone
	if isTouch then
		panel.Size = UDim2.new(0.94, 0, 1, -16)
	else
		panel.Size = UDim2.fromOffset(560, 580)
	end
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = screen
	panelFrame = panel
	-- panelFrame is canonical garage root for open/close
	addCorner(panel, 12)
	local gst = Instance.new("UIStroke")
	gst.Color = Constants.Colors.Gold
	gst.Thickness = 1.5
	gst.Transparency = 0.35
	gst.Parent = panel
	local sizeCon = Instance.new("UISizeConstraint")
	sizeCon.MaxSize = if isTouch then Vector2.new(880, 640) else Vector2.new(560, 640)
	sizeCon.MinSize = Vector2.new(280, 300)
	sizeCon.Parent = panel

	local title = PanelShell.Title(panel, "GARAGE")

	PanelShell.CloseButton(panel, function()
		pcall(AudioController.PlayClick)
		setOpen(false)
	end)

	local lineSize = PanelShell.Text(12)
	local lineY = title.Position.Y.Offset + title.Size.Y.Offset - 2
	local cd = Instance.new("TextLabel")
	cd.Name = "CooldownLine"
	cd.BackgroundTransparency = 1
	cd.Position = UDim2.fromOffset(16, lineY)
	cd.Size = UDim2.new(0.45, -16, 0, lineSize + 4)
	cd.Font = Enum.Font.GothamBold
	cd.TextSize = lineSize
	cd.TextXAlignment = Enum.TextXAlignment.Left
	cd.TextColor3 = Constants.Colors.Muted
	cd.Text = "Spawn ready"
	cd.Parent = panel
	cooldownLabel = cd

	local status = Instance.new("TextLabel")
	status.Name = "StatusLine"
	status.BackgroundTransparency = 1
	status.Position = if isTouch then UDim2.new(0.45, 0, 0, lineY) else UDim2.fromOffset(16, lineY + lineSize + 4)
	status.Size = if isTouch
		then UDim2.new(0.55, -(TAP + 20), 0, lineSize + 4)
		else UDim2.new(1, -(TAP + 28), 0, lineSize + 4)
	status.Font = Enum.Font.GothamMedium
	status.TextSize = lineSize
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextColor3 = Constants.Colors.Muted
	status.TextTruncate = Enum.TextTruncate.AtEnd
	status.Text = ""
	status.Parent = panel
	statusLabel = status

	local filtersY = math.max(TAP + 8, status.Position.Y.Offset + lineSize + 10)
	-- touch: ONE row of 64 v chips (All / Ground / Air / Naval / Owned + a rarity chip that cycles);
	-- desktop keeps two compact rows
	local chipH = if isTouch then TAP else 28
	local filters = Instance.new("Frame")
	filters.Name = "Filters"
	filters.Position = UDim2.fromOffset(12, filtersY)
	filters.Size = UDim2.new(1, -24, 0, chipH)
	filters.BackgroundTransparency = 1
	filters.Parent = panel
	local layoutF = Instance.new("UIListLayout")
	layoutF.FillDirection = Enum.FillDirection.Horizontal
	layoutF.Padding = UDim.new(0, if isTouch then 6 else 5)
	layoutF.SortOrder = Enum.SortOrder.LayoutOrder
	layoutF.Parent = filters

	local rarList = { "All", "Common", "Uncommon", "Rare", "Epic", "Legendary" }
	if typeof(VehicleConfig.Rarities) == "table" then
		rarList = { "All" }
		for _, r in ipairs(VehicleConfig.Rarities) do
			table.insert(rarList, r)
		end
	end
	local function rarityText(): string
		if filterRarity == "All" then
			return "ALL ★"
		end
		return string.upper(filterRarity)
	end

	local function paintCatFilters()
		for _, child in ipairs(filters:GetChildren()) do
			if child:IsA("TextButton") then
				local name = string.gsub(child.Name, "Filter_", "")
				if name == "Owned" then
					child.BackgroundColor3 = if filterOwnedOnly then Constants.Colors.Gold else Constants.Colors.Background
					child.TextColor3 = if filterOwnedOnly then Color3.fromRGB(20, 22, 18) else Constants.Colors.Text
				elseif name == "Rarity" then
					child.Text = rarityText()
					child.BackgroundColor3 = if filterRarity == "All"
						then Constants.Colors.Background
						else (rarityColors[filterRarity] or Constants.Colors.Accent)
					child.TextColor3 = if filterRarity == "All" then Constants.Colors.Text else Color3.fromRGB(20, 22, 18)
				else
					child.BackgroundColor3 = if name == filterCategory
						then Constants.Colors.Accent
						else Constants.Colors.Background
					child.TextColor3 = Constants.Colors.Text
				end
			end
		end
	end
	paintFilters = paintCatFilters
	local chipText = PanelShell.Text(if isTouch then 13 else 11)
	local function chip(name: string, text: string, w: number, order: number): TextButton
		local fb = Instance.new("TextButton")
		fb.Name = name
		fb.LayoutOrder = order
		fb.Size = UDim2.fromOffset(w, chipH)
		fb.Font = Enum.Font.GothamBold
		fb.TextSize = chipText
		fb.Text = text
		fb.TextColor3 = Constants.Colors.Text
		fb.BackgroundColor3 = Constants.Colors.Background
		fb.BorderSizePixel = 0
		fb.AutoButtonColor = true
		fb.Active = true
		addCorner(fb, 8)
		fb.Parent = filters
		UIUtil.EnsureMinTouch(fb, chipH)
		return fb
	end
	for i, cat in ipairs({ "All", "Ground", "Air", "Naval" }) do
		local fb = chip("Filter_" .. cat, cat:upper(), if isTouch then 100 else 70, i)
		bindTap(fb, function()
			filterCategory = cat
			paintCatFilters()
			rebuild()
		end)
	end
	-- OWNED toggle chip
	local ownedChip = chip("Filter_Owned", "OWNED", if isTouch then 100 else 72, 5)
	bindTap(ownedChip, function()
		filterOwnedOnly = not filterOwnedOnly
		paintCatFilters()
		rebuild()
	end)

	local rowsBelow = chipH + 8
	if isTouch then
		-- one chip cycles All → Common → … → Legendary (six 64 v chips would not fit next to the categories)
		local rc = chip("Filter_Rarity", rarityText(), 150, 6)
		bindTap(rc, function()
			local idx = table.find(rarList, filterRarity) or 1
			filterRarity = rarList[(idx % #rarList) + 1]
			paintCatFilters()
			rebuild()
		end)
	else
		local rarFilters = Instance.new("Frame")
		rarFilters.Name = "RarityFilters"
		rarFilters.Position = UDim2.fromOffset(12, filtersY + chipH + 6)
		rarFilters.Size = UDim2.new(1, -24, 0, 26)
		rarFilters.BackgroundTransparency = 1
		rarFilters.Parent = panel
		local layoutR = Instance.new("UIListLayout")
		layoutR.FillDirection = Enum.FillDirection.Horizontal
		layoutR.Padding = UDim.new(0, 4)
		layoutR.SortOrder = Enum.SortOrder.LayoutOrder
		layoutR.Parent = rarFilters
		local function paintRarity()
			for _, child in ipairs(rarFilters:GetChildren()) do
				if child:IsA("TextButton") then
					local name = string.gsub(child.Name, "Rarity_", "")
					child.BackgroundColor3 = if name == filterRarity
						then (rarityColors[name] or Constants.Colors.Accent)
						else Constants.Colors.Background
				end
			end
		end
		for i, rar in ipairs(rarList) do
			local rb = Instance.new("TextButton")
			rb.Name = "Rarity_" .. rar
			rb.LayoutOrder = i
			rb.Size = UDim2.fromOffset(if rar == "Legendary" then 78 else 64, 26)
			rb.Font = Enum.Font.GothamBold
			rb.TextSize = PanelShell.Text(10)
			rb.Text = if rar == "All" then "ALL ★" else string.upper(string.sub(rar, 1, 3))
			rb.TextColor3 = Constants.Colors.Text
			rb.BorderSizePixel = 0
			rb.AutoButtonColor = true
			rb.Active = true
			addCorner(rb, 5)
			rb.Parent = rarFilters
			bindTap(rb, function()
				filterRarity = rar
				paintRarity()
				rebuild()
			end)
		end
		paintRarity()
		rowsBelow += 26 + 8
	end
	paintCatFilters()

	local hintSize = PanelShell.Text(11)
	local listTop = filtersY + rowsBelow
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(12, listTop)
	scroll.Size = UDim2.new(1, -24, 1, -(listTop + hintSize + 20))
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ElasticBehavior = Enum.ElasticBehavior.Always
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if isTouch then 6 else 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = panel
	listFrame = scroll

	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.AnchorPoint = Vector2.new(0, 1)
	hint.Position = UDim2.new(0, 16, 1, -8)
	hint.Size = UDim2.new(1, -32, 0, hintSize + 4)
	hint.Font = Enum.Font.GothamMedium
	hint.TextSize = hintSize
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextColor3 = Constants.Colors.Muted
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	-- copy by device: key names only for keyboard / gamepad players (HudLayout.PrefersKeys, not TouchEnabled)
	local function hintText(keys: boolean): string
		return if keys
			then "G · SPAWN deploys at your base · Heli SPACE/CTRL · Plane hold W · F exits aircraft"
			else "BUY → SPAWN · air + sea deploy at your base · ▲▼ fly · Jump exits"
	end
	hint.Text = hintText(HudLayout.PrefersKeys())
	hint.Parent = panel
	HudLayout.InputModeChanged:Connect(function(keys: boolean)
		hint.Text = hintText(keys)
		if isOpen then
			rebuild() -- the row tips name keys only for keyboard / gamepad players
		end
	end)

	-- v70: the desktop GARAGE toggle (bottom-left, over the thumbstick / cash pill) is gone — the Garage opens from
	-- the rail's Garage tile, G, the vehicle-pad prompt and the Vehicle Depot terminal.
	-- Bootstrap calls VehicleController.Init without a pcall: a registry / dim failure must never stop the garage
	local okShell, res = pcall(PanelShell.Attach, {
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return isOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})
	if okShell then
		shell = res
	else
		warn("[VehicleController] panel registry / dim failed:", res)
	end
end

--[[ tab: optional "Ground" | "Air" | "Naval" (terminal prompt attribute WE_OpenTab) presets the category. ]]
function VehicleController.Open(tab: string?)
	if tab == "Ground" or tab == "Air" or tab == "Naval" then
		filterCategory = tab
		local paint = paintFilters
		if paint then
			paint()
		end
	end
	setOpen(true)
end

function VehicleController.Close()
	setOpen(false)
end

function VehicleController.Toggle()
	-- the tap that just closed the Garage through its dim lands on the Garage tile too: stay closed
	local sh = shell
	if not isOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not isOpen)
end

function VehicleController.IsOpen(): boolean
	return isOpen
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Server data
-- ─────────────────────────────────────────────────────────────────────────────
local function readOwned(v: any): { [string]: boolean }?
	if typeof(v) ~= "table" then
		return nil
	end
	local out: { [string]: boolean } = {}
	for id, owned in pairs(v) do
		if typeof(id) == "string" and owned == true then
			out[id] = true
		end
	end
	return out
end

local function onVehicleState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local owned = readOwned(payload.Owned)
	if owned then
		noteOwned(owned)
		ownedMap = owned
	end
	local act = payload.ActiveVehicleId
	activeId = if typeof(act) == "string" then act else nil
	-- a spawned vehicle is no longer "new"
	if activeId and newVehicleIds[activeId] then
		newVehicleIds[activeId] = nil
		refreshNewVehicleBadge()
	end
	cooldownLeft = math.max(0, tonumber(payload.CooldownRemaining) or 0)
	if payload.Gates ~= nil then
		VehicleController._MergeGates(gates, payload.Gates)
	end
	-- touch: close once the requested vehicle is out, so the player sees it
	if isTouch and isOpen and lastSpawnRequestedId ~= nil and activeId == lastSpawnRequestedId then
		lastSpawnRequestedId = nil
		setOpen(false)
		return
	end
	if isOpen then
		if dataSig() ~= lastBuiltSig then
			scheduleRebuild()
		else
			repaintAll()
		end
	end
end

local function onPlayerState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local patch: { [string]: any } = { Level = payload.Level, Prestige = payload.Prestige }
	local base = payload.Base
	if typeof(base) == "table" and typeof(base.Upgrades) == "table" then
		patch.Structures = base.Upgrades
	end
	VehicleController._MergeGates(gates, patch)
	-- backup ownership refresh (the join merge can land after the first VehicleStateUpdate)
	local owned = readOwned(payload.Vehicles)
	if owned then
		noteOwned(owned)
		ownedMap = owned
	end
	onDataChanged()
end

local function onBaseState(payload: any)
	if typeof(payload) == "table" and typeof(payload.Upgrades) == "table" then
		VehicleController._MergeGates(gates, { Structures = payload.Upgrades })
		onDataChanged()
	end
end

local function onXP(payload: any)
	if typeof(payload) == "table" and tonumber(payload.Level) then
		VehicleController._MergeGates(gates, { Level = payload.Level })
		onDataChanged()
	end
end

local function readLevelAttribute()
	local lvl = tonumber(player:GetAttribute("WE_Level"))
	if lvl then
		VehicleController._MergeGates(gates, { Level = lvl })
		onDataChanged()
	end
end

function VehicleController.Init()
	-- the drive loop first: a garage UI failure must never stop vehicles from being drivable
	local okDrive, errDrive = pcall(function(): any
		VehicleDriveClient.Init()
		return nil
	end)
	if not okDrive then
		warn("[VehicleController] VehicleDriveClient.Init failed:", errDrive)
	end

	buildGui()

	Remotes.BindEvent(Constants.RemoteNames.VehicleStateUpdate, onVehicleState)
	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, onPlayerState)
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, onBaseState)
	Remotes.BindEvent(Constants.RemoteNames.XPUpdate, onXP)
	player:GetAttributeChangedSignal("WE_Level"):Connect(readLevelAttribute)
	player:GetAttributeChangedSignal("WE_Cash"):Connect(scheduleRepaint)
	readLevelAttribute()

	local garageKey: Enum.KeyCode = HudConfig.Keys.Garage or Enum.KeyCode.G
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == garageKey then
			setOpen(not isOpen)
		end
	end)

	-- cooldown ticker: repaints the owned rows' buttons in place (no rebuild, no new instances)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if cooldownLeft > 0 then
				cooldownLeft = math.max(0, cooldownLeft - 0.5)
				if isOpen and listFrame then
					repaintOwned()
				end
			end
		end
	end)
end

return VehicleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="171">
            <Properties>
              <string name="Name">WorldPromptController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	World interactivity for StudioSetup-tagged parts.

	Upgrade pads (WE_UpgradeSlot):
	  PRIMARY UX (mobile): large bottom ScreenGui BUY button while standing on
	  own-plot pad → RequestPurchaseUpgrade (Activated / touch).
	  BACKUP: walk-over auto-purchase — Touched + Heartbeat overlap (debounced).
	  Server UpgradePadService remains authoritative walk-over path. Never grants on client.
	Edge cases: respawn clears overlap; seated-in-vehicle skips buy; multi-part
	touch uses pad keys; plot reassignment clears state; standing retry after
	debounce for failed-purchase UX. Prompt/Touched connections disconnect on
	part destroy. BillboardGuis throttled refresh on Base/Economy updates.
	Billboard subtitle: "Stand or tap BUY". Hide BUY for leave / wrong plot / MAX / prereq.

	ProximityPrompts only for non-buy actions (the vehicle pad "Garage" prompt; tutorial markers have none).

	v70 "clean screen" (spec §3.5 action lane, §4.1 one failed buy = one line, §5 console labels):
	  * BUY lives in the ACTION LANE (bottom-centre, above the hotbar; HudLayout.ActionLaneBottomV()): green when
	    affordable / dark red "NEED $N more"; "BUILD HELIPAD  $5,000" / "UPGRADE HELIPAD  $12,000"; desktop shows an
	    "E" key cap; hidden while a panel is open (Modal), seated or dead. The buy path is unchanged: btn.Activated →
	    tryPurchase → Remotes.FireServer(RequestPurchaseUpgrade) → WE_BuyAck / PurchaseResult.
	  * Console price label: plain 2-line outlined text, owner-only, 2.2 studs above the console, no card, no income,
	    no "Stand or tap BUY"; MAX → no label (MAX is on the console screen). No pad-name wash on consoles.
	  * Prompts are pills (PromptController); the "Open Base" and "Hold to capture" client prompts are gone.
	  * No per-frame workspace scan, no WE_HUD season hack; a price label hidden for a reason stays hidden.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local HudConfig = require(Shared.Configs.HudConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)

local VehicleController = require(script.Parent.VehicleController)
local NotificationController = require(script.Parent.NotificationController)
-- v70 prompt pills: required defensively (like UIController does) — a broken PromptController must never take the
-- BUY path down with it; the stub keeps every call a no-op.
local PromptController: any = {
	SetMyPlotId = function(_: number?) end,
	SetBuyButtonActive = function(_: boolean) end,
	SetSuppressed = function(_: ProximityPrompt, _: boolean) end,
}
do
	local mod = script.Parent:FindFirstChild("PromptController")
	if mod and mod:IsA("ModuleScript") then
		local req: any = require
		local ok, res = pcall(req, mod)
		if ok and typeof(res) == "table" then
			PromptController = res
		else
			warn("[WorldPrompt] PromptController failed to load:", res)
		end
	end
end
local UIUtil = require(Shared.Util.UIUtil)
local WorldLabel = require(Shared.Util.WorldLabel)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)

local WorldPromptController = {}

local PROMPT_NAME = "WE_WorldPrompt"
local BILLBOARD_NAME = "WE_PriceBillboard"
local DEBOUNCE_SEC = 1.1 -- mobile standing-retry; still under server rate (6/8s)
local OVERLAP_MARGIN = 2.4 -- generous pad hitbox for mobile walk-over
local BILLBOARD_THROTTLE = 0.35 -- perf: avoid refreshing every economy tick frame
local PRICE_BILLBOARD_MAX_DIST = 42 -- near-only chips (was 56)
local ATM_HIDE_PRICE_STUDS = 12 -- P0: hide price boards near MoneyCollector -- near-only (was 650) — mobile screen clutter
local PRICE_CHIP_MAX_W = 120 -- v50: tighter mobile chips (was 160)
local PRICE_BILLBOARD_SIZE = UDim2.fromOffset(118, 40) -- phone-readable chip (was 160×52)
local PRICE_BILLBOARD_OWNED_SIZE = UDim2.fromOffset(96, 26) -- owned L1+: tiny roof chip
local BUY_GUI_NAME = "WE_PadBuyGui"
local BUY_BTN_MIN_H = 56
-- v70 action-lane BUY (HudConfig.ActionLane): desktop keeps the pinned 300x58; touch is 64 v (44.8 px on phones)
local BUY_BTN_SIZE_DESKTOP = UDim2.fromOffset(300, 58)
local BUY_BTN_SIZE_TOUCH = HudConfig.ActionLane.BuyButtonSizeTouch
local CONSOLE_LABEL = HudConfig.WorldLabels.Console
local BUY_FAIL_DEDUPE_SEC = 1 -- WE_BuyAck + PurchaseResult for the same structure = one line

local player = Players.LocalPlayer
local upgrades: { [string]: number } = {}
local cash = 0
-- v57: every afford/BUY/NEED check reads max of module cash, WE_Cash, leaderstats.Cash
local function liveCash(): number
	local best = math.floor(tonumber(cash) or 0)
	local attr = tonumber(player:GetAttribute("WE_Cash"))
	if typeof(attr) == "number" then
		best = math.max(best, math.floor(attr))
	end
	local folder = player:FindFirstChild("leaderstats")
	if folder then
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			best = math.max(best, math.floor((cashV :: any).Value))
		end
	end
	return best
end
local myPlotId: number? = nil
local attachedPrompt: { [Instance]: boolean } = {}
local slotParts: { [BasePart]: boolean } = {}
local slotConns: { [Instance]: { RBXScriptConnection } } = {}
local promptConns: { [Instance]: { RBXScriptConnection } } = {}
local lastPurchaseAt: { [string]: number } = {} -- keyed by structureId (server rate is global)
local lastOverlap: { [string]: boolean } = {} -- keyed by padKey (plot|structure)
local pendingPurchase: { [string]: boolean } = {} -- structureId in-flight
local billboardDirty = false
local lastBillboardRefresh = 0
local overlapConn: RBXScriptConnection? = nil
local tagsBound = false
local maxToastAt: { [string]: number } = {} -- throttle MAX toasts while camping
local failToastAt: { [string]: number } = {} -- throttle Not enough / prereq (~0.85s)
local FAIL_TOAST_CD = 0.9
local _buyGui: ScreenGui? = nil
local buyBtn: TextButton? = nil
local activeBuyStructureId: string? = nil
local activeBuyPart: BasePart? = nil

-- v68: consoles (BaseLayoutConfig) — the BUY button shows when you walk up; buying needs a tap or the prompt
local function isConsolePart(part: BasePart): boolean
	return part:GetAttribute("WE_Console") == true
end

local function padKey(part: BasePart, structureId: string): string
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" then
		return tostring(pid) .. "|" .. structureId
	end
	return structureId
end

local function trackConn(bucket: { [Instance]: { RBXScriptConnection } }, owner: Instance, conn: RBXScriptConnection)
	local list = bucket[owner]
	if not list then
		list = {}
		bucket[owner] = list
	end
	table.insert(list, conn)
end

local function disconnectAll(bucket: { [Instance]: { RBXScriptConnection } }, owner: Instance)
	local list = bucket[owner]
	if not list then
		return
	end
	for _, c in ipairs(list) do
		c:Disconnect()
	end
	bucket[owner] = nil
end

local function makePrompt(parent: BasePart, actionText: string, objectText: string, hold: number?, maxDist: number?): ProximityPrompt
	local existing = parent:FindFirstChild(PROMPT_NAME)
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = maxDist or 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = parent
	return prompt
end

-- 12000 → "12,000"
local function withCommas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if n < 0 then "-" .. out else out
end

-- BUY button: the full price ("$12,000")
local function fullCost(cost: number): string
	return "$" .. withCommas(cost)
end

-- console label: "$5,000" under 10K, then "$12K" / "$12.5K" / "$1.2M"
local function shortCost(cost: number): string
	if cost >= 1_000_000 then
		return (string.format("$%.1fM", cost / 1_000_000):gsub("%.0M", "M"))
	elseif cost >= 10_000 then
		local k = cost / 1000
		if k >= 100 or math.abs(k - math.floor(k)) < 0.05 then
			return string.format("$%dK", math.floor(k))
		end
		return string.format("$%.1fK", k)
	end
	return fullCost(cost)
end

local function escapeRich(t: string): string
	return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local structureInfo: (structureId: string) -> (string, number, number?, boolean, string?)
local tryPurchase: (structureId: string, opts: { silentMax: boolean?, showBuying: boolean? }?) -> ()
local isSeatedInVehicle: () -> boolean
local isOwnPlotPad: (part: BasePart) -> boolean


local padBuyFlashToken = 0
-- the BUY caption keeps "BUYING…" / "BOUGHT …!" until this os.clock() (the Heartbeat refresh would overwrite it)
local captionHoldUntil = 0
local buyCaption: TextLabel? = nil
local buyStroke: UIStroke? = nil
local buyGradient: UIGradient? = nil

-- affordable: green gradient (63,220,85) → (35,165,58), 3 v dark-green stroke; short of cash: dark red
local BUY_OK_TOP = Color3.fromRGB(63, 220, 85)
local BUY_OK_BOTTOM = Color3.fromRGB(35, 165, 58)
local BUY_OK_STROKE = Color3.fromRGB(12, 70, 22)
local BUY_SHORT_TOP = Color3.fromRGB(96, 44, 44)
local BUY_SHORT_BOTTOM = Color3.fromRGB(58, 26, 26)
local BUY_SHORT_STROKE = Color3.fromRGB(30, 10, 10)
local BUY_SHORT_PRICE = "#ff8080"

-- UIGradient colours multiply BackgroundColor3: bg = top colour, gradient white → bottom/top per channel
local function gradientTo(top: Color3, bottom: Color3): ColorSequence
	local function ratio(b: number, t: number): number
		return if t > 0 then math.clamp(b / t, 0, 1) else 1
	end
	return ColorSequence.new(Color3.new(1, 1, 1), Color3.new(ratio(bottom.R, top.R), ratio(bottom.G, top.G), ratio(bottom.B, top.B)))
end

local buyLookAffordable: boolean? = nil
local function setBuyLook(affordable: boolean)
	local btn = buyBtn
	if not btn or buyLookAffordable == affordable then
		return
	end
	buyLookAffordable = affordable
	btn.BackgroundColor3 = if affordable then BUY_OK_TOP else BUY_SHORT_TOP
	local g = buyGradient
	if g then
		g.Color = if affordable then gradientTo(BUY_OK_TOP, BUY_OK_BOTTOM) else gradientTo(BUY_SHORT_TOP, BUY_SHORT_BOTTOM)
	end
	local st = buyStroke
	if st then
		st.Color = if affordable then BUY_OK_STROKE else BUY_SHORT_STROKE
	end
	btn.AutoButtonColor = affordable
end

local function setBuyCaption(rich: string)
	local cap = buyCaption
	if cap and cap.Text ~= rich then
		cap.Text = rich
	end
end

local function flashPadBuyBought(displayName: string)
	local btn = buyBtn
	if not btn or not btn.Visible then
		return
	end
	padBuyFlashToken += 1
	captionHoldUntil = os.clock() + 1.0
	setBuyLook(true)
	setBuyCaption(string.format("BOUGHT %s!", escapeRich(string.upper(displayName))))
	-- the standing Heartbeat refreshPadBuyButton rewrites the caption once captionHoldUntil passes
end

local function hidePadBuyButton()
	activeBuyStructureId = nil
	activeBuyPart = nil
	if buyBtn then
		buyBtn.Visible = false
	end
	PromptController.SetBuyButtonActive(false)
end

local function ensurePadBuyGui(): TextButton
	if buyBtn and buyBtn.Parent then
		return buyBtn
	end
	local pg = player:WaitForChild("PlayerGui")
	local existing = pg:FindFirstChild(BUY_GUI_NAME)
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end

	local screen = Instance.new("ScreenGui")
	screen.Name = BUY_GUI_NAME
	-- Above the HUD (55) and panels (60); below toasts (70). One HUD scale + CoreUISafeInsets (HudLayout).
	screen.DisplayOrder = HudConfig.DisplayOrder.WE_PadBuyGui
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = pg
	_buyGui = screen

	local touch = HudLayout.IsTouch()
	local size = if touch then BUY_BTN_SIZE_TOUCH else BUY_BTN_SIZE_DESKTOP
	-- the action lane slot: bottom-centre, 100 v (touch) / 86 v (desktop) above the content bottom
	local lane = Instance.new("Frame")
	lane.Name = "Lane"
	lane.AnchorPoint = Vector2.new(0.5, 1)
	lane.Position = UDim2.new(0.5, 0, 1, -HudLayout.ActionLaneBottomV())
	lane.Size = size
	lane.BackgroundTransparency = 1
	lane.BorderSizePixel = 0
	lane.Active = false
	lane.Parent = screen
	HudLayout.BindVisibility(lane, { HideWhen = { "Modal", "Driving", "Dead" } })

	local btn = Instance.new("TextButton")
	btn.Name = "BuyButton"
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Position = UDim2.fromScale(0.5, 0.5)
	btn.Size = size
	btn.BackgroundColor3 = BUY_OK_TOP
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Text = ""
	btn.Visible = false
	btn.Active = true
	btn.Selectable = true
	btn.ZIndex = 40
	btn.Parent = lane
	UIUtil.Corner(btn, 14)
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = gradientTo(BUY_OK_TOP, BUY_OK_BOTTOM)
	grad.Parent = btn
	buyGradient = grad
	local stroke = UIUtil.Stroke(btn, BUY_OK_STROKE, 3)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Transparency = 0
	buyStroke = stroke
	buyLookAffordable = nil
	UIUtil.EnsureMinTouch(btn, BUY_BTN_MIN_H)

	-- desktop / gamepad: an "E" key cap (the console's E-hold prompt still works; its pill hides while BUY shows)
	local padL = 14
	if not touch then
		local cap = Instance.new("Frame")
		cap.Name = "KeyCap"
		cap.AnchorPoint = Vector2.new(0, 0.5)
		cap.Position = UDim2.new(0, padL, 0.5, 0)
		cap.Size = UDim2.fromOffset(28, 28)
		cap.BackgroundColor3 = Color3.fromRGB(232, 255, 232)
		cap.BorderSizePixel = 0
		cap.Active = false
		cap.ZIndex = 41
		cap.Parent = btn
		UIUtil.Corner(cap, 5)
		local key = Instance.new("TextLabel")
		key.Name = "Key"
		key.BackgroundTransparency = 1
		key.Size = UDim2.fromScale(1, 1)
		key.Font = HudConfig.Fonts.Body
		key.TextSize = 16
		key.TextColor3 = BUY_OK_STROKE
		key.Text = "E"
		key.ZIndex = 42
		key.Parent = cap
		padL += 28 + 8
	end

	local caption = Instance.new("TextLabel")
	caption.Name = "Caption"
	caption.BackgroundTransparency = 1
	caption.AnchorPoint = Vector2.new(0, 0.5)
	caption.Position = UDim2.new(0, padL, 0.5, 0)
	caption.Size = UDim2.new(1, -(padL + 12), 1, -10)
	caption.Font = HudConfig.Fonts.Display
	caption.RichText = true
	caption.TextScaled = true
	caption.TextColor3 = Color3.fromRGB(255, 255, 255)
	caption.Text = "BUY"
	caption.ZIndex = 42
	caption.Parent = btn
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 20
	limit.MinTextSize = 12
	limit.Parent = caption
	UIUtil.TextOutline(caption, 1.4)
	buyCaption = caption

	local lastTapAt = 0
	local function onBuyPressed()
		local sid = activeBuyStructureId
		if typeof(sid) ~= "string" then
			return
		end
		-- v67: one purchase per tap (a stray double event bought two levels)
		local now = os.clock()
		if now - lastTapAt < 0.35 then
			return
		end
		lastTapAt = now
		local display, _level, cost, isMax, prereqHint = structureInfo(sid)
		if isMax or prereqHint or cost == nil then
			hidePadBuyButton()
			return
		end
		-- Intentional tap: clear walk-over debounce so BUY always fires
		lastPurchaseAt[sid] = 0
		pendingPurchase[sid] = nil
		print(string.format("[WorldPrompt] BUY button tap → RequestPurchaseUpgrade %s %s cost=%s", sid, display, tostring(cost)))
		-- v61: "BUYING…" only after FireServer actually ran (see tryPurchase showBuying)
		tryPurchase(sid, { showBuying = true })
	end
	-- v67: Activated only — it already fires for mouse, touch and gamepad. Also wiring MouseButton1Click
	-- ran the handler twice per click (two RequestPurchaseUpgrade = two levels bought).
	btn.Activated:Connect(onBuyPressed)

	buyBtn = btn
	return btn
end

local function refreshPadBuyButton(part: BasePart?, structureId: string?)
	if part == nil or structureId == nil then
		hidePadBuyButton()
		return
	end
	if isSeatedInVehicle() then
		hidePadBuyButton()
		return
	end
	if not isOwnPlotPad(part) then
		hidePadBuyButton()
		return
	end

	local display, level, cost, isMax, prereqHint = structureInfo(structureId)
	if isMax or prereqHint or cost == nil then
		hidePadBuyButton()
		return
	end

	local btn = ensurePadBuyGui()
	activeBuyStructureId = structureId
	activeBuyPart = part
	if os.clock() >= captionHoldUntil then
		local have = liveCash()
		local canAfford = have >= cost
		setBuyLook(canAfford)
		if canAfford then
			-- "BUILD HELIPAD  $5,000" / "UPGRADE HELIPAD  $12,000" (income lives on the console screen / Base panel)
			local verb = if level <= 0 then "BUILD" else "UPGRADE"
			setBuyCaption(string.format("%s %s  %s", verb, escapeRich(string.upper(display)), fullCost(cost)))
		else
			setBuyCaption(string.format('NEED  <font color="%s">%s more</font>', BUY_SHORT_PRICE, fullCost(cost - have)))
		end
	end
	btn.Visible = true
	PromptController.SetBuyButtonActive(true)
end

function structureInfo(structureId: string): (string, number, number?, boolean, string?)
	local def = BaseConfig.Structures[structureId]
	local display = if def then def.DisplayName else structureId
	local level = upgrades[structureId] or 0
	if not def then
		return display, level, nil, false, nil
	end
	if level >= def.MaxLevel then
		return display, level, nil, true, nil
	end
	local prereqHint: string? = nil
	if def.Requires then
		for _, req in ipairs(def.Requires) do
			local have = upgrades[req.StructureId] or 0
			if have < req.Level then
				local reqDef = BaseConfig.Structures[req.StructureId]
				local reqName = if reqDef then reqDef.DisplayName else req.StructureId
				prereqHint = string.format("Needs %s L%d", reqName, req.Level)
				break
			end
		end
	end
	local nextLevel = level + 1
	local cost = def.Costs[nextLevel]
	return display, level, cost, false, prereqHint
end

-- v70: the console label grows with the HUD scale: k = clamp(S / 0.9, 0.9, 1.3) → 106x36 phone, 118x40 at
-- 720p, 151x51 at 1080p (BillboardGui offsets are real px; the HUD UIScale never reaches them)
local function chipScale(): number
	return math.clamp(HudLayout.Scale() / 0.9, 0.9, 1.3)
end

local function clampChipSize(size: UDim2, k: number?): UDim2
	-- v50: hard clamp width+height so legacy/Scale chips never dominate mobile (v70: then × k)
	local kk = k or 1
	local w = size.X.Offset
	local h = size.Y.Offset
	if w <= 0 and h <= 0 then
		w, h = PRICE_BILLBOARD_SIZE.X.Offset, PRICE_BILLBOARD_SIZE.Y.Offset
	end
	local cw = if w > 0 then math.min(w, PRICE_CHIP_MAX_W) else PRICE_CHIP_MAX_W
	local ch = if h > 0 then math.min(h, 44) else 40
	return UDim2.fromOffset(math.floor(cw * kk + 0.5), math.floor(ch * kk + 0.5))
end

-- the latest "standing near an ATM" answer (the throttled loop keeps it); price labels stay off near the ATM
local nearAtmNow = false
-- labels hidden on purpose (another player's plot, MAX): the ATM soft-restore must never switch these back on
local priceHidden: { [BasePart]: boolean } = setmetatable({} :: any, { __mode = "k" })

local function setBillboardNearOnly(bb: BillboardGui, ownedChip: boolean?, part: BasePart?)
	-- never AlwaysOnTop giant tabs — plain text, near-only, owner-only
	local k = chipScale()
	if part and isConsolePart(part) then
		-- v70: 2.2 studs above the console top (the old 5-stud host + 5.5 landed in the ceiling of walk-ins)
		bb.Size = clampChipSize(PRICE_BILLBOARD_SIZE, k)
		bb.StudsOffset = Vector3.zero
		bb.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y * 0.5 + CONSOLE_LABEL.StudsAboveConsoleTop, 0)
		bb.MaxDistance = if ownedChip then CONSOLE_LABEL.MaxDistanceUpgrade else CONSOLE_LABEL.MaxDistanceBuild
		bb.AlwaysOnTop = false
	elseif ownedChip then
		bb.Size = clampChipSize(PRICE_BILLBOARD_OWNED_SIZE, k)
		bb.StudsOffset = Vector3.new(0, 6, 0)
		bb.MaxDistance = 28
		bb.AlwaysOnTop = false
	else
		bb.Size = clampChipSize(PRICE_BILLBOARD_SIZE, k)
		bb.StudsOffset = Vector3.new(0, 5.5, 0)
		bb.MaxDistance = PRICE_BILLBOARD_MAX_DIST
		bb.AlwaysOnTop = false
	end
	bb.LightInfluence = 0
	-- Defensive: legacy / stale oversized chips
	if bb.Size.X.Offset > PRICE_CHIP_MAX_W * k + 1 then
		bb.Size = clampChipSize(bb.Size, 1)
	end
end

local function hidePriceBillboard(part: BasePart)
	priceHidden[part] = true
	-- every copy: the client host's and a server card still sitting on the part (MapSetup priceBillboard)
	local host = part:FindFirstChild("WE_BillboardHost")
	for _, holder in ipairs({ host, part } :: { Instance? }) do
		local existing = holder and holder:FindFirstChild(BILLBOARD_NAME)
		if existing and existing:IsA("BillboardGui") then
			existing.Enabled = false
		end
	end
	-- MapSetup non-price Label billboards on other parts are left alone
end

local function resolveBillboardAdornee(part: BasePart): BasePart
	local found = part:FindFirstChild("WE_BillboardHost")
	if found and found:IsA("BasePart") then
		return found
	end
	-- Prefer tall invisible host above kit roof so geometry never occludes BUY name
	local roofY = 0
	for _, ch in ipairs(part:GetChildren()) do
		if ch:IsA("BasePart") and ch:GetAttribute("WE_KitRole") == "Roof" then
			roofY = math.max(roofY, (ch.Position.Y - part.Position.Y) + ch.Size.Y * 0.5)
		end
	end
	local host = Instance.new("Part")
	host.Name = "WE_BillboardHost"
	host.Size = Vector3.new(0.4, 0.4, 0.4)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Massless = true
	host.CFrame = part.CFrame * CFrame.new(0, math.max(roofY + 1.2, 5), 0) -- v39: keep chip near roof
	host.Parent = part
	return host
end

local function ensurePadNameSurface(part: BasePart, displayName: string)
	local existing = part:FindFirstChild("WE_PadNameGui")
	if existing and existing:IsA("SurfaceGui") then
		local lab = existing:FindFirstChild("Name", true)
		if lab and lab:IsA("TextLabel") then
			lab.Text = string.upper(displayName)
			lab.TextColor3 = Color3.fromRGB(255, 245, 180)
			lab.TextStrokeTransparency = 0.2
			lab.BackgroundTransparency = 0.12
		end
		return
	end
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_PadNameGui"
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0
	sg.Parent = part
	local lab = Instance.new("TextLabel")
	lab.Name = "Name"
	lab.Size = UDim2.fromScale(1, 1)
	lab.BackgroundTransparency = 0.12
	lab.BackgroundColor3 = Color3.fromRGB(6, 8, 10)
	lab.Text = string.upper(displayName)
	lab.TextColor3 = Color3.fromRGB(255, 245, 180)
	lab.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	lab.TextStrokeTransparency = 0.2
	lab.Font = Enum.Font.GothamBold
	lab.TextScaled = true
	lab.Parent = sg
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(230, 190, 60)
	stroke.Thickness = 2
	stroke.Transparency = 0.25
	stroke.Parent = lab
end

local function styleChipLabel(lab: TextLabel, maxText: number)
	lab.BackgroundTransparency = 1
	lab.Font = HudConfig.Fonts.Display
	lab.TextScaled = true
	lab.TextWrapped = false
	lab.TextStrokeColor3 = HudConfig.Colors.Ink
	lab.TextStrokeTransparency = CONSOLE_LABEL.StrokeTransparency
	local limit = lab:FindFirstChildOfClass("UITextSizeConstraint")
	if not limit then
		local c = Instance.new("UITextSizeConstraint")
		c.Parent = lab
		limit = c
	end
	if limit then
		limit.MaxTextSize = maxText
		limit.MinTextSize = 8
	end
end

local function ensurePriceBillboard(part: BasePart): BillboardGui
	priceHidden[part] = nil
	local adornee: BasePart = if isConsolePart(part) then part else resolveBillboardAdornee(part)
	local host = part:FindFirstChild("WE_BillboardHost")
	local existing = adornee:FindFirstChild(BILLBOARD_NAME)
		or part:FindFirstChild(BILLBOARD_NAME)
		or (host and host:FindFirstChild(BILLBOARD_NAME))
	if existing and existing:IsA("BillboardGui") then
		existing.Adornee = adornee
		existing.Parent = adornee
		setBillboardNearOnly(existing, nil, part)
		existing.Enabled = not nearAtmNow
		return existing
	end
	local legacy = part:FindFirstChild("Label")
	if legacy and legacy:IsA("BillboardGui") then
		legacy.Name = BILLBOARD_NAME
		setBillboardNearOnly(legacy, nil, part)
		legacy.Enabled = not nearAtmNow
		return legacy
	end

	-- v70: plain 2-line outlined text, NO card (Backdrop stays as a transparent holder)
	local bb = Instance.new("BillboardGui")
	bb.Name = BILLBOARD_NAME
	setBillboardNearOnly(bb, nil, part)
	bb.Adornee = adornee
	bb.Enabled = not nearAtmNow
	bb.Parent = adornee

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundTransparency = 1
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Text = ""
	title.Parent = backdrop
	local cost = Instance.new("TextLabel")
	cost.Name = "Cost"
	cost.Text = ""
	cost.Parent = backdrop
	return bb
end

local function applyBillboardCopy(bb: BillboardGui, titleLine: string, detailLine: string, detailColor: Color3)
	local k = chipScale()
	-- plain text: no card, no stroke box (server cards arrive with a dark Backdrop + gold Stroke)
	local backdrop = bb:FindFirstChild("Backdrop")
	if backdrop and backdrop:IsA("Frame") then
		backdrop.BackgroundTransparency = 1
		local pad = backdrop:FindFirstChildOfClass("UIPadding")
		if pad then
			pad:Destroy()
		end
	end
	local stroke = bb:FindFirstChild("Stroke", true)
	if stroke and stroke:IsA("UIStroke") then
		stroke.Enabled = false
	end

	-- MapSetup price cards and v70 client labels use Title + Cost; pre-v70 client chips used one "Text"
	local titleLab = bb:FindFirstChild("Title", true)
	local costLab = bb:FindFirstChild("Cost", true)
	local textLab = bb:FindFirstChild("Text", true)

	if titleLab and titleLab:IsA("TextLabel") and costLab and costLab:IsA("TextLabel") then
		local twoLines = detailLine ~= ""
		titleLab.Position = UDim2.fromScale(0, 0)
		titleLab.Size = if twoLines then UDim2.fromScale(1, 0.5) else UDim2.fromScale(1, 1)
		titleLab.Text = titleLine
		titleLab.TextColor3 = CONSOLE_LABEL.NameColor
		styleChipLabel(titleLab, math.floor(CONSOLE_LABEL.NameSize * k + 0.5))
		costLab.Position = UDim2.fromScale(0, 0.5)
		costLab.Size = UDim2.fromScale(1, 0.5)
		costLab.Visible = twoLines
		costLab.Text = detailLine
		costLab.TextColor3 = detailColor
		styleChipLabel(costLab, math.floor(CONSOLE_LABEL.PriceSize * k + 0.5))
	elseif textLab and textLab:IsA("TextLabel") then
		textLab.Text = if detailLine ~= "" then (titleLine .. "\n" .. detailLine) else titleLine
		textLab.TextColor3 = detailColor
		styleChipLabel(textLab, math.floor(CONSOLE_LABEL.NameSize * k + 0.5))
	end
end

-- MapSetup's console screen (ConsoleScreen.WE_ConsoleScreen): the owner reads the level / price there;
-- everyone else just sees the name. Local text only (the server wrote it once at build).
local function setConsoleScreen(part: BasePart, text: string)
	local screenPart = part:FindFirstChild("ConsoleScreen")
	local sg = screenPart and screenPart:FindFirstChild("WE_ConsoleScreen")
	local lbl = sg and sg:FindFirstChildWhichIsA("TextLabel")
	if lbl and lbl.Text ~= text then
		lbl.Text = text
	end
end

function isOwnPlotPad(part: BasePart): boolean
	-- Hide / skip refresh for other players' plots once we know our PlotId.
	-- Studio / ambiguous PlotId: ALWAYS show BUY (never suppress CTA).
	if myPlotId == nil then
		return true -- loading / solo until assigned
	end
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) ~= "number" then
		-- Also accept BasePlotId attribute some kits use
		pid = part:GetAttribute("BasePlotId")
	end
	if typeof(pid) ~= "number" then
		return true -- ambiguous → show BUY
	end
	return pid == myPlotId
end

local function refreshSlotBillboard(part: BasePart)
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end
	local isConsole = isConsolePart(part)
	local display, level, cost, isMax, prereqHint = structureInfo(structureId)
	local name = string.upper(display)

	if not isOwnPlotPad(part) then
		-- owner-only (spec §5): no price label, no pad wash; the console screen shows just the name
		-- (PromptController disables this console's WE_ServerBuyPrompt locally)
		hidePriceBillboard(part)
		if isConsole then
			setConsoleScreen(part, name)
		end
		return
	end

	local owned = level >= 1
	-- pad-name wash on the pad top: legacy walk-over pads before their first level only (never on consoles)
	local padName = part:FindFirstChild("WE_PadNameGui")
	if padName and (owned or isConsole) then
		padName:Destroy()
	end
	if not owned and not isConsole then
		ensurePadNameSurface(part, display)
	end

	if isConsole then
		if isMax then
			setConsoleScreen(part, name .. "\nMAX")
		elseif prereqHint then
			setConsoleScreen(part, name .. "\nLOCKED")
		elseif cost then
			if owned then
				setConsoleScreen(part, string.format("%s\nLV %d → %d\n%s", name, level, level + 1, shortCost(cost)))
			else
				setConsoleScreen(part, string.format("%s\nBUILD\n%s", name, shortCost(cost)))
			end
		end
		-- nothing to buy (MAX / locked) → no "Build / Upgrade" pill; the BUY button covers the buyable case
		local sp = part:FindFirstChild("WE_ServerBuyPrompt")
		if sp and sp:IsA("ProximityPrompt") then
			PromptController.SetSuppressed(sp, isMax or prereqHint ~= nil)
		end
	end

	-- MAX → no label in the air (MAX is on the console screen); income is on the screen / Base panel
	if isMax and not CONSOLE_LABEL.ShowOnMax then
		hidePriceBillboard(part)
		return
	end

	local bb = ensurePriceBillboard(part)
	setBillboardNearOnly(bb, owned, part)

	if prereqHint then
		-- "Needs Command Center 2" in grey
		applyBillboardCopy(bb, name, (string.gsub(prereqHint, " L(%d+)$", " %1")), CONSOLE_LABEL.LockedColor)
	elseif cost then
		local canAfford = liveCash() >= cost
		local color = if canAfford then CONSOLE_LABEL.PriceAffordable else CONSOLE_LABEL.PriceShort
		if owned then
			applyBillboardCopy(bb, string.format("%s LV %d", name, level), "UPGRADE " .. shortCost(cost), color)
		else
			applyBillboardCopy(bb, name, "BUILD " .. shortCost(cost), color)
		end
	else
		applyBillboardCopy(bb, name, "", CONSOLE_LABEL.NameColor)
	end
end

local function refreshAllBillboardsNow()
	lastBillboardRefresh = os.clock()
	billboardDirty = false
	local stale: { BasePart } = {}
	for part in pairs(slotParts) do
		if part.Parent then
			refreshSlotBillboard(part)
		else
			table.insert(stale, part)
		end
	end
	for _, part in ipairs(stale) do
		slotParts[part] = nil
		disconnectAll(slotConns, part)
	end
	-- Keep BUY label/cost in sync while camping the pad
	if activeBuyPart and activeBuyStructureId and activeBuyPart.Parent then
		refreshPadBuyButton(activeBuyPart, activeBuyStructureId)
	end
end

local function markBillboardsDirty()
	billboardDirty = true
end

function isSeatedInVehicle(): boolean
	local char = player.Character
	if not char then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local seat = hum.SeatPart
	if seat == nil then
		return false
	end
	-- Any seat (VehicleSeat or passenger Seat) — driving over pads must not buy
	if seat:IsA("VehicleSeat") or seat:IsA("Seat") then
		return true
	end
	return false
end

function tryPurchase(structureId: string, opts: { silentMax: boolean?, showBuying: boolean? }?)
	local now = os.clock()
	local last = lastPurchaseAt[structureId] or 0
	if now - last < DEBOUNCE_SEC then
		return
	end
	if pendingPurchase[structureId] then
		print("[WorldPrompt] BUY skip in-flight", structureId)
		return
	end

	local display, _level, cost, isMax, prereqHint = structureInfo(structureId)
	if isMax then
		lastPurchaseAt[structureId] = now
		local silent = opts and opts.silentMax
		local lastMax = maxToastAt[structureId] or 0
		if not silent and (now - lastMax) >= 8 then
			maxToastAt[structureId] = now
			NotificationController.ShowPurchaseFailure("Already at MAX level", "Info", 2)
			print("[WorldPrompt] BUY FAIL MAX", structureId)
		end
		return
	end
	if prereqHint then
		lastPurchaseAt[structureId] = now
		if not (opts and opts.silentMax) then
			local fk = "prereq|" .. structureId
			local lastFail = failToastAt[fk] or 0
			if (now - lastFail) >= FAIL_TOAST_CD then
				failToastAt[fk] = now
				NotificationController.ShowPurchaseFailure(prereqHint, "Warn", 3)
			end
			print("[WorldPrompt] BUY FAIL prereq", structureId, prereqHint)
		end
		return
	end
	local have = liveCash()
	if cost and have < cost then
		-- v57: no client soft-fail toast (server InsufficientCash is authoritative); still FireServer
		print(string.format("[WorldPrompt] BUY soft-hint cash %s have=%d need=%s (FireServer anyway)", structureId, have, tostring(cost)))
	end

	lastPurchaseAt[structureId] = now
	pendingPurchase[structureId] = true
	print(string.format("[WorldPrompt] FireServer RequestPurchaseUpgrade %s cost=%s cash=%d", structureId, tostring(cost), have))
	-- v61: never unbounded GetEvent wait; never "Buying…" unless FireServer ran
	local fired = Remotes.FireServer(Constants.RemoteNames.RequestPurchaseUpgrade, {
		StructureId = structureId,
	} :: Types.PurchaseUpgradeRequest)
	if not fired then
		pendingPurchase[structureId] = nil
		local fk = "noremote|purchase"
		local lastFail = failToastAt[fk] or 0
		if (now - lastFail) >= 8 then
			failToastAt[fk] = now
			NotificationController.ShowPurchaseFailure("Buy failed — remotes not ready. Rejoin game.", "Error", 4)
		end
		warn("[WorldPrompt] BUY FAIL remote missing RequestPurchaseUpgrade")
		return
	end
	if opts and opts.showBuying then
		-- v70: the BUY button itself reads BUYING… (no "Buying X…" toast; the lane drops that line anyway)
		if buyBtn and buyBtn.Visible and activeBuyStructureId == structureId then
			captionHoldUntil = os.clock() + 1.5
			setBuyCaption("BUYING…")
		end
		print(string.format("[WorldPrompt] BUY sent %s (%s)", structureId, display))
	end
	-- v63: keep in-flight until WE_BuyAck attribute OR PurchaseResult (8s hard timeout)
	local ackBefore = player:GetAttribute("WE_BuyAck")
	task.delay(8, function()
		if pendingPurchase[structureId] then
			-- Only timeout if attribute never advanced (primary ack path missed)
			local ackNow = player:GetAttribute("WE_BuyAck")
			if ackNow ~= nil and ackNow ~= ackBefore then
				pendingPurchase[structureId] = nil
				return
			end
			pendingPurchase[structureId] = nil
			warn("[WorldPrompt] BUY timeout no WE_BuyAck/PurchaseResult", structureId)
			captionHoldUntil = 0
			NotificationController.ShowPurchaseFailure("Buy timed out — try again", "Warn", 3)
		end
	end)
end

local CONSOLE_MARGIN = 5

local function pointInPad(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	local margin = if isConsolePart(part) then CONSOLE_MARGIN else OVERLAP_MARGIN
	return math.abs(localPos.X) <= half.X + margin
		and math.abs(localPos.Z) <= half.Z + margin
		and localPos.Y >= -half.Y - 3
		and localPos.Y <= half.Y + 8
end

local function isOwnPlot(part: BasePart): boolean
	if myPlotId == nil then
		return true -- until plot assigned, allow (solo / loading)
	end
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) ~= "number" then
		pid = part:GetAttribute("BasePlotId")
	end
	if typeof(pid) ~= "number" then
		return true -- ambiguous → allow buy
	end
	return pid == myPlotId
end

local function onEnterPad(part: BasePart, structureId: string, fromStandingRetry: boolean?)
	if isSeatedInVehicle() then
		return
	end
	-- v68: never auto-buy at a console (walk-over + standing retries bought levels by accident)
	if isConsolePart(part) then
		return
	end
	local key = padKey(part, structureId)
	if not isOwnPlot(part) then
		local now = os.clock()
		local last = lastPurchaseAt[structureId] or 0
		if not fromStandingRetry and not lastOverlap[key] and now - last >= DEBOUNCE_SEC then
			lastPurchaseAt[structureId] = now
			NotificationController.Show("Not your base — walk your plot pads to buy", "Warn", 2.5)
		end
		lastOverlap[key] = true
		return
	end
	if lastOverlap[key] and not fromStandingRetry then
		return
	end
	lastOverlap[key] = true
	tryPurchase(structureId, { silentMax = fromStandingRetry == true })
end

local function onLeavePad(key: string)
	lastOverlap[key] = false
end

local function detachUpgradeSlot(part: BasePart)
	disconnectAll(slotConns, part)
	slotParts[part] = nil
end

local function attachUpgradeSlot(part: BasePart)
	if slotParts[part] then
		return
	end
	slotParts[part] = true
	part.CanTouch = true -- walk-over buy must receive Touched

	local existing = part:FindFirstChild(PROMPT_NAME)
	if existing then
		existing:Destroy()
	end

	refreshSlotBillboard(part)

	trackConn(slotConns, part, part.Touched:Connect(function(hit)
		local char = player.Character
		if not char then
			return
		end
		-- Multi-part: only accept character descendants (any body part)
		if not hit:IsDescendantOf(char) then
			return
		end
		local structureId = part:GetAttribute("StructureId")
		if typeof(structureId) == "string" then
			onEnterPad(part, structureId)
		end
	end))

	trackConn(slotConns, part, part.TouchEnded:Connect(function(hit)
		local char = player.Character
		if not char then
			return
		end
		if not hit:IsDescendantOf(char) then
			return
		end
		local structureId = part:GetAttribute("StructureId")
		if typeof(structureId) ~= "string" then
			return
		end
		local key = padKey(part, structureId)
		task.defer(function()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and pointInPad(hrp.Position, part) then
				-- Another character part still overlapping — keep overlap
				return
			end
			onLeavePad(key)
		end)
	end))

	trackConn(slotConns, part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			detachUpgradeSlot(part)
		end
	end))
end

local function attachPromptOnce(part: BasePart, build: () -> ProximityPrompt, onTriggered: () -> ())
	if attachedPrompt[part] then
		return
	end
	attachedPrompt[part] = true
	local prompt = build()
	trackConn(promptConns, part, prompt.Triggered:Connect(function(who)
		if who ~= player then
			return
		end
		onTriggered()
	end))
	trackConn(promptConns, part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			disconnectAll(promptConns, part)
			attachedPrompt[part] = nil
		end
	end))
end

-- v70: the client "Open Base" (WE_BasePlot) and "Hold to capture" (capture zones) prompts are gone (spec §5):
-- the Base menu opens from B / the Command Center map table / the tutorial; capture runs by standing in the zone
-- (the HUD capture bar shows it). A leftover prompt from an older client build is removed on sight.
local function removeClientPrompt(part: BasePart)
	local existing = part:FindFirstChild(PROMPT_NAME)
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end
end

local function attachVehicleSpawn(part: BasePart)
	attachPromptOnce(part, function()
		-- v70: a lane pill "Garage" (PromptController); the seat keeps its own "Drive" prompt
		local prompt = makePrompt(part, "Garage", "", 0, 12)
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		return prompt
	end, function()
		VehicleController.Open()
	end)
end

local function attachTutorialMarker(_part: BasePart)
	-- No proximity prompts / toasts on tutorial markers — TutorialController owns UX
end

local function bindTag(tag: string, handler: (BasePart) -> ())
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") then
			handler(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
		if inst:IsA("BasePart") then
			handler(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		if inst:IsA("BasePart") then
			if tag == Constants.Tags.UpgradeSlot then
				detachUpgradeSlot(inst)
			else
				disconnectAll(promptConns, inst)
				attachedPrompt[inst] = nil
			end
		end
	end)
end

local function clearOverlapState()
	table.clear(lastOverlap)
	table.clear(pendingPurchase)
	hidePadBuyButton()
end

local WORLD_LABEL_PASS_SEC = 0.25
local lastWorldLabelPass = 0

-- v70: the "TRAINING" worker tags and the training "+$/tick" billboard are removed from the design (spec §5);
-- until the server stops creating them the client keeps them off — event-driven (the per-frame
-- workspace:GetDescendants() scan that hid them near pads is gone).
local REMOVED_WORLD_LABELS: { [string]: boolean } = { WE_WorkerTag = true, WE_TrainingEarnBillboard = true }
local function hideRemovedLabel(inst: Instance)
	if inst:IsA("BillboardGui") and REMOVED_WORLD_LABELS[inst.Name] then
		local bb: BillboardGui = inst
		bb.Enabled = false
		bb:GetPropertyChangedSignal("Enabled"):Connect(function()
			if bb.Enabled then
				bb.Enabled = false
			end
		end)
	end
end

-- 4 Hz: SupplyDrop labels step aside near your consoles / ATM; price labels hide near the ATM. A label hidden on
-- purpose (hidePriceBillboard: another plot, MAX) or by WE_PriceForceHidden is never switched back on here.
local function worldLabelPass()
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else nil
	local nearPad = false
	if camPos then
		for part in pairs(slotParts) do
			if part.Parent and (part.Position - camPos).Magnitude <= 20 then
				nearPad = true
				break
			end
		end
		if not nearPad then
			for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.MoneyCollector)) do
				if inst:IsA("BasePart") and (inst.Position - camPos).Magnitude <= 14 then
					nearPad = true
					break
				end
			end
		end
	end
	-- v31: Supply Drop labels — hide when near upgrade pads / ATM so structure names win
	local supplyTag = (Constants.Tags and (Constants.Tags :: any).SupplyDrop) or "WE_SupplyDrop"
	local okSup, supplies = pcall(function()
		return CollectionService:GetTagged(supplyTag)
	end)
	if okSup and supplies then
		for _, crate in ipairs(supplies) do
			if crate:IsA("BasePart") then
				for _, d in ipairs(crate:GetDescendants()) do
					if d:IsA("BillboardGui") then
						d.AlwaysOnTop = false
						if nearPad then
							if d.Enabled then
								d.Enabled = false
							end
						elseif d.MaxDistance > 0 and not d.Enabled then
							d.Enabled = true
						end
					end
				end
			end
		end
	end

	-- P0: hide structure price boards when near MoneyCollector ATM
	local nearAtm = false
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.MoneyCollector)) do
			if inst:IsA("BasePart") and (inst.Position - hrp.Position).Magnitude <= ATM_HIDE_PRICE_STUDS then
				nearAtm = true
				break
			end
		end
	end
	nearAtmNow = nearAtm
	for part in pairs(slotParts) do
		if part.Parent then
			local host = part:FindFirstChild("WE_BillboardHost")
			local bb = (host and host:FindFirstChild(BILLBOARD_NAME)) or part:FindFirstChild(BILLBOARD_NAME)
			if bb and bb:IsA("BillboardGui") then
				local want = not nearAtm and not priceHidden[part] and part:GetAttribute("WE_PriceForceHidden") ~= true
				if bb.Enabled ~= want then
					bb.Enabled = want
				end
			end
		end
	end
end

local function startOverlapLoop()
	if overlapConn then
		overlapConn:Disconnect()
		overlapConn = nil
	end
	overlapConn = RunService.Heartbeat:Connect(function()
		-- v70: world-label upkeep at 4 Hz, not every frame (the per-frame workspace:GetDescendants() tag scan and
		-- the WE_HUD season-banner hack are gone: MapSetup / HUD own those labels)
		local now = os.clock()
		if now - lastWorldLabelPass >= WORLD_LABEL_PASS_SEC then
			lastWorldLabelPass = now
			worldLabelPass()
		end
		if billboardDirty and (os.clock() - lastBillboardRefresh) >= BILLBOARD_THROTTLE then
			refreshAllBillboardsNow()
		end

		local char = player.Character
		if not char then
			hidePadBuyButton()
			return
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not (hrp and hrp:IsA("BasePart")) then
			hidePadBuyButton()
			return
		end
		if isSeatedInVehicle() then
			-- Driving: clear any stuck overlap so stepping out can buy fresh
			for key in pairs(lastOverlap) do
				if lastOverlap[key] then
					lastOverlap[key] = false
				end
			end
			hidePadBuyButton()
			return
		end

		local pos = hrp.Position
		local bestPart: BasePart? = nil
		local bestSid: string? = nil
		for part in pairs(slotParts) do
			if part.Parent then
				local structureId = part:GetAttribute("StructureId")
				if typeof(structureId) == "string" then
					local key = padKey(part, structureId)
					local inside = pointInPad(pos, part)
					if inside then
						if not lastOverlap[key] then
							onEnterPad(part, structureId)
						else
							-- Standing retry: failed buy / cash refresh / sequential upgrades
							onEnterPad(part, structureId, true)
						end
						-- Prefer own-plot pad for BUY button (first match is fine; typically one pad)
						if isOwnPlot(part) and bestPart == nil then
							bestPart = part
							bestSid = structureId
						end
					elseif lastOverlap[key] then
						onLeavePad(key)
					end
				end
			end
		end
		refreshPadBuyButton(bestPart, bestSid)
	end)
end

local function bindAllTags()
	if tagsBound then
		-- Re-attach any slots that appeared since first bind (GetInstanceAdded covers
		-- new tags, but stale/untagged-then-tagged races still need a GetTagged sweep)
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
			if inst:IsA("BasePart") then
				attachUpgradeSlot(inst)
			end
		end
		return
	end
	tagsBound = true
	bindTag(Constants.Tags.BasePlot, removeClientPrompt)
	bindTag(Constants.Tags.UpgradeSlot, attachUpgradeSlot)
	bindTag(Constants.Tags.CaptureZone, removeClientPrompt)
	bindTag(Constants.Tags.VehicleSpawn, attachVehicleSpawn)
	bindTag(Constants.Tags.TutorialMarker, attachTutorialMarker)
end

-- Attribute fallback: StructureId pads under WarEmpireSetup.Bases missing the tag
local function rescanUntaggedSlots()
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		return
	end
	local bases = setup:FindFirstChild("Bases")
	if not bases then
		return
	end
	for _, desc in ipairs(bases:GetDescendants()) do
		if desc:IsA("BasePart") then
			local sid = desc:GetAttribute("StructureId")
			if typeof(sid) == "string" and not slotParts[desc] then
				-- Attach even if CollectionService tag lagged / missing on client replica
				attachUpgradeSlot(desc)
			end
		end
	end
end

function WorldPromptController.Init()
	-- v70 (spec §5): server labels made with WorldLabel{OwnerUserId} carry WE_LabelOwner; hide everyone else's here.
	local okFilter, errFilter = pcall(WorldLabel.StartOwnerFilter)
	if not okFilter then
		warn("[WorldPrompt] WorldLabel owner filter failed:", errFilter)
	end
	-- v58: liveCash listeners FIRST (before BaseState/other remotes that WaitForChild-block)
	local function applyCash(n: any)
		local v = tonumber(n)
		if typeof(v) == "number" then
			cash = math.floor(v)
			markBillboardsDirty()
			-- NEED→BUY while standing when cash syncs
			if activeBuyPart and activeBuyStructureId then
				refreshPadBuyButton(activeBuyPart, activeBuyStructureId)
			end
		end
	end

	-- v60: leaderstats/attrs FIRST — BindEvent never blocks Init
	local function tryLeaderstatsCash(): boolean
		local folder = player:FindFirstChild("leaderstats")
		if not folder then
			return false
		end
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			applyCash((cashV :: any).Value)
			return true
		end
		return false
	end

	local function wireLs(folder: Instance)
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			(cashV :: any):GetPropertyChangedSignal("Value"):Connect(function()
				tryLeaderstatsCash()
			end)
		end
		folder.ChildAdded:Connect(function(ch)
			if ch.Name == "Cash" and (ch:IsA("IntValue") or ch:IsA("NumberValue")) then
				(ch :: any):GetPropertyChangedSignal("Value"):Connect(function()
					tryLeaderstatsCash()
				end)
				tryLeaderstatsCash()
			end
		end)
		tryLeaderstatsCash()
	end
	do
		local existing = player:FindFirstChild("leaderstats")
		if existing then
			wireLs(existing)
		end
	end
	player.ChildAdded:Connect(function(ch)
		if ch.Name == "leaderstats" then
			wireLs(ch)
		end
	end)

	do
		local attrCash = player:GetAttribute("WE_Cash")
		if typeof(attrCash) == "number" then
			applyCash(attrCash)
		end
		player:GetAttributeChangedSignal("WE_Cash"):Connect(function()
			applyCash(player:GetAttribute("WE_Cash"))
		end)
	end

	Remotes.BindEvent(Constants.RemoteNames.EconomyUpdate, function(payload: Types.EconomyUpdatePayload)
		applyCash(payload.Cash)
	end)

	-- v70: one failed purchase = one line. WE_BuyAck (attribute) and PurchaseResult (remote) both answer every
	-- buy; the first one shows, the second is skipped for the same structure inside BUY_FAIL_DEDUPE_SEC, and
	-- NotificationController.ShowPurchaseFailure also swallows the server's own Warn echo.
	local lastAckAt: { [string]: number } = {}
	local spendFloatAt: { [string]: number } = {}
	local function failureText(err: string, sid: any): (string, string)
		if err == "NotAtConsole" then
			-- v71 console-only buying: the server saw this character away from its own console for sid
			local def = if typeof(sid) == "string" then BaseConfig.Structures[sid] else nil
			return string.format(ConsoleBuyConfig.Text.NotAtConsole, if def then def.DisplayName else tostring(sid)), "Warn"
		elseif err == "InsufficientCash" then
			return "You need more Money!", "Warn" -- competitor wording; the BUY button already reads NEED $N more
		elseif err == "NoPlot" then
			return "Claim a base first — stand on your plot pad", "Error"
		elseif err == "NoProfile" then
			return "Profile still loading — try BUY again", "Error"
		elseif err == "MissingRequirement" then
			return "Missing prerequisite structure", "Error"
		elseif err == "MaxLevel" then
			return "Already at MAX level", "Info"
		elseif err == "WrongPlot" then
			return "Not your base — walk your plot pads to buy", "Error"
		elseif err == "RateLimited" then
			return "Buying too fast — wait a moment", "Error"
		end
		return "Buy failed: " .. err, "Error"
	end
	local function onBuyResult(source: string, sid: any, ok: boolean, err: string?, newCash: any, newLevel: any)
		if typeof(sid) == "string" then
			pendingPurchase[sid] = nil
		end
		captionHoldUntil = 0
		-- the ack's cash is only meaningful on success (a failed ack stamps WE_BuyCash = 0)
		if ok and typeof(newCash) == "number" then
			applyCash(newCash)
		end
		local key = tostring(sid) .. "|" .. (if ok then "ok" else tostring(err))
		local now = os.clock()
		local dup = now - (lastAckAt[key] or -math.huge) < BUY_FAIL_DEDUPE_SEC
		lastAckAt[key] = now
		if ok then
			local def = if typeof(sid) == "string" then BaseConfig.Structures[sid] else nil
			local name = if def then def.DisplayName else tostring(sid)
			print(string.format("[WorldPrompt] %s OK %s Lv=%s cash=%s", source, tostring(sid), tostring(newLevel), tostring(newCash)))
			if not dup then
				flashPadBuyBought(name)
			end
			-- "-$20,000" spend float at the cash pill (HudConfig.CashFloat.ShowSpend) — only PurchaseResult knows
			-- the level bought (WE_BuyAck has no level); the server's "Purchase SUCCESSFUL!" line is the toast
			local lvl = tonumber(newLevel)
			local spent = if def and lvl then def.Costs[lvl] else nil
			local fk = tostring(sid) .. "|" .. tostring(lvl)
			if HudConfig.CashFloat.ShowSpend and typeof(spent) == "number" and spent > 0 and now - (spendFloatAt[fk] or -math.huge) > 2 then
				spendFloatAt[fk] = now
				HudLayout.CashFloat(-spent)
			end
		else
			local errStr = tostring(err or "Failed")
			print(string.format("[WorldPrompt] %s FAIL %s → %s%s", source, tostring(sid), errStr, if dup then " (dup)" else ""))
			if not dup then
				local msg, kind = failureText(errStr, sid)
				NotificationController.ShowPurchaseFailure(msg, kind, 3)
			end
		end
		markBillboardsDirty()
	end

	-- v63 PRIMARY: attribute ack (replicates without remotes) — clear pending + apply result
	player:GetAttributeChangedSignal("WE_BuyAck"):Connect(function()
		onBuyResult(
			"WE_BuyAck",
			player:GetAttribute("WE_BuyStructure"),
			player:GetAttribute("WE_BuyOk") == true,
			tostring(player:GetAttribute("WE_BuyErr") or "Failed"),
			player:GetAttribute("WE_BuyCash"),
			nil
		)
	end)

	-- v62/v63 secondary: PurchaseResult remote — clear pending + show server reason (deduped with WE_BuyAck)
	Remotes.BindEvent(Constants.RemoteNames.PurchaseResult, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		onBuyResult("PurchaseResult", payload.StructureId, payload.Ok == true, tostring(payload.Error or "Failed"), payload.Cash, payload.NewLevel)
	end)

	task.spawn(function()
		local synced = false
		for i = 0, 20 do
			if typeof(player:GetAttribute("WE_Cash")) == "number" then
				applyCash(player:GetAttribute("WE_Cash"))
				synced = true
			end
			if tryLeaderstatsCash() then
				synced = true
			end
			local fn = Remotes.TryGetFunction(Constants.RemoteNames.GetPlayerState)
			if fn then
				local ok, state = pcall(function()
					return fn:InvokeServer()
				end)
				if ok and typeof(state) == "table" then
					applyCash((state :: any).Cash)
					local base = (state :: any).Base
					if typeof(base) == "table" then
						if typeof(base.Upgrades) == "table" then
							upgrades = base.Upgrades
						end
						if typeof(base.PlotId) == "number" then
							myPlotId = base.PlotId
							PromptController.SetMyPlotId(myPlotId)
						end
					end
					markBillboardsDirty()
					print(string.format("[WorldPrompt] cash bootstrap have=%d", cash))
					return
				end
			end
			if synced and i >= 2 then
				markBillboardsDirty()
				print(string.format("[WorldPrompt] cash bootstrap via attr/leaderstats have=%d", cash))
				return
			end
			task.wait(0.25)
		end
		if not synced then
			warn("[WorldPrompt] cash bootstrap failed — relying on EconomyUpdate/Attribute")
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: Types.BaseStatePayload)
		local prev = upgrades
		upgrades = base.Upgrades or upgrades
		if typeof(base.PlotId) == "number" then
			if myPlotId ~= nil and myPlotId ~= base.PlotId then
				clearOverlapState()
			end
			myPlotId = base.PlotId
			PromptController.SetMyPlotId(myPlotId)
		end
		if activeBuyStructureId and typeof(upgrades) == "table" then
			local sid = activeBuyStructureId
			local before = if typeof(prev) == "table" then (prev[sid] or 0) else 0
			local after = upgrades[sid] or 0
			if after > before then
				local def = BaseConfig.Structures[sid]
				local name = if def then def.DisplayName else sid
				flashPadBuyBought(name)
				print(string.format("[WorldPrompt] BUY OK flash %s %d→%d", sid, before, after))
			end
		end
		markBillboardsDirty()
	end)

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: Types.PlayerStatePayload)
		applyCash(state.Cash)
		if state.Base then
			upgrades = state.Base.Upgrades
			if typeof(state.Base.PlotId) == "number" then
				if myPlotId ~= nil and myPlotId ~= state.Base.PlotId then
					clearOverlapState()
				end
				myPlotId = state.Base.PlotId
				PromptController.SetMyPlotId(myPlotId)
			end
		end
		markBillboardsDirty()
	end)

	player.CharacterAdded:Connect(function()
		clearOverlapState()
		task.defer(function()
			task.wait(0.3)
			markBillboardsDirty()
		end)
	end)

	player.CharacterRemoving:Connect(function()
		clearOverlapState()
	end)

	task.defer(function()
		-- Wait for map (MapSetup + MapDressing can take >0.5s on cold Studio Play)
		local setup = Workspace:WaitForChild("WarEmpireSetup", 60)
		if not setup then
			warn("[WorldPromptController] WarEmpireSetup missing after 60s — binding tags anyway")
		end
		bindAllTags()
		startOverlapLoop()
		Workspace.DescendantAdded:Connect(hideRemovedLabel)
		for _, d in ipairs(setup and setup:GetDescendants() or {}) do
			hideRemovedLabel(d)
		end
		refreshAllBillboardsNow()
		rescanUntaggedSlots()
		local n = 0
		for _ in pairs(slotParts) do
			n += 1
		end
		print(string.format("[WorldPrompt] bound upgrade slots=%d tagged=%d", n, #CollectionService:GetTagged(Constants.Tags.UpgradeSlot)))

		-- Periodic rescan first ~20s for race / late-tagged pads
		for _ = 1, 10 do
			task.wait(2)
			bindAllTags()
			rescanUntaggedSlots()
			refreshAllBillboardsNow()
		end
		local n2 = 0
		for _ in pairs(slotParts) do
			n2 += 1
		end
		print(string.format("[WorldPrompt] after rescan slots=%d", n2))
	end)
end

return WorldPromptController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="172">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="173">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Client audio (W1 SND): pooled one-shots, music, ambience and engine loops. Every key, id, volume and licence source
	lives in Shared/Configs/SoundConfig.luau; AudioHooks maps existing remotes / HUD signals onto keys.

	API
	  Init()                            idempotent (UIController and AudioHooks both call it); starts the base theme
	  Play(key, at?) -> boolean         one-shot. at = Vector3 | BasePart | Attachment | Model → 3D at that point,
	                                    nil → 2D. Returns false (never errors) for: unknown key, Id 0 / "", SFX muted,
	                                    the key's cooldown, a lower-priority Stinger inside the collapse window, a 3D
	                                    point beyond MaxDistance, the voice cap with nothing lower to steal, the server
	  Loop(channel, key?, fade?) -> boolean
	                                    sets a loop channel ("Music" | "Ambience" | "Engine" | any name) to `key`
	                                    (nil stops it) with a crossfade. A muted channel remembers its key and resumes
	                                    when unmuted. true = audible now
	  SetLoopPitch(channel, pitch)      engine pitch (AudioHooks samples the chassis speed at 10 Hz)
	  GetLoop(channel) -> string?       the channel's key (QA)
	  SetNextNotificationKey(key?)      AudioHooks: the typed key for NotificationController's next PlayNotification
	  HasSound(key) -> boolean          key exists with a playable Id
	  GetStats() -> Stats               counters (tests / Studio)
	  unchanged legacy API: PlayClick() · PlayNotification() · GetMusicVolume() · GetSfxVolume()

	PHONES (CLAUDE.md §1): no RenderStepped / Heartbeat work here; at most Mix.MaxConcurrent one-shots (2D + 3D) and
	Mix.MaxConcurrent2D of them 2D; per-key cooldowns; Sounds are pooled (no Instance churn per play) and 3D voices
	are pooled Attachments under Workspace.Terrain (always present under StreamingEnabled). Client only: nothing
	here runs on the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local ClientSettings = require(script.Parent.ClientSettings)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundConfig = require(Shared.Configs.SoundConfig)

type SoundDef = SoundConfig.SoundDef

type Voice = {
	Key: string,
	Sound: Sound,
	Attachment: Attachment?,
	Positional: boolean,
	BusyUntil: number,
	StartedAt: number,
	Priority: number,
	Serial: number,
}

type Channel = {
	Name: string,
	Key: string?,
	Slots: { Sound }, -- two Sounds per channel, alternated for crossfades
	Gen: { number }, -- per slot: bumps on every (re)start so a pending fade-out stop never hits a reused slot
	Active: number, -- slot index that carries Key (0 = none)
	Target: number, -- volume the active slot fades to
	Resume: { [string]: number }, -- TimePosition per key (music picks up where it left off)
}

type StingerMark = { Voice: Voice, Serial: number, Priority: number, At: number }

export type Stats = {
	Started: number, -- one-shots that began playing
	Replaced: number, -- Stingers cut by a higher-priority Stinger inside the window
	LoopStarts: number, -- loop channels that began playing audibly
	Active: number,
	Active2D: number,
	Active3D: number,
	PeakActive: number,
	Dropped: { [string]: number }, -- Missing · Muted · Cooldown · Collapsed · Cap · Far · Server · Loop · Error
	ByKey: { [string]: number },
	LastKey: string?,
}

local AudioController = {}

local Mix = SoundConfig.Mix
local STOP_FADE = 0.4 -- s: MaxSeconds one-shots fade out instead of cutting

local initDone = false
local folder: Folder? = nil
local pools: { [string]: { Voice } } = {}
local playing: { Voice } = {}
local lastPlayedAt: { [string]: number } = {}
local lastStinger: StingerMark? = nil
local channels: { [string]: Channel } = {}
local pendingNotify: { Key: string, At: number }? = nil
local serial = 0
local warned: { [string]: boolean } = {}

local stats: Stats = {
	Started = 0,
	Replaced = 0,
	LoopStarts = 0,
	Active = 0,
	Active2D = 0,
	Active3D = 0,
	PeakActive = 0,
	Dropped = {},
	ByKey = {},
	LastKey = nil,
}

local function now(): number
	return os.clock()
end

local function drop(reason: string): boolean
	stats.Dropped[reason] = (stats.Dropped[reason] or 0) + 1
	return false
end

-- Sounds are a client concern: a require from server code must never create one.
local function isServerContext(): boolean
	local ok, server = pcall(function(): boolean
		return RunService:IsServer() and not RunService:IsClient()
	end)
	return ok and server == true
end

local function rawDef(key: string): SoundDef?
	local d = (SoundConfig.Sounds :: any)[key]
	if type(d) == "table" then
		return d :: SoundDef
	end
	return nil
end

local function defOf(key: string): SoundDef?
	local d = rawDef(key)
	if d == nil and not warned[key] then
		warned[key] = true
		warn("[AudioController] unknown sound key:", key)
	end
	return d
end

-- "rbxassetid://<n>" for a positive asset id, the string itself for an engine path; nil = disabled / missing
local function soundIdOf(def: SoundDef?): string?
	if def == nil then
		return nil
	end
	local id: any = def.Id
	if type(id) == "number" then
		if id >= 1 and id < math.huge then
			return "rbxassetid://" .. tostring(math.floor(id))
		end
		return nil
	elseif type(id) == "string" then
		if id ~= "" then
			return id
		end
	end
	return nil
end

local function masterFor(def: SoundDef): number
	if def.Bus == "Music" then
		return Mix.MusicMaster
	end
	return Mix.SfxMaster
end

local function volumeOf(def: SoundDef): number
	return math.clamp(def.Volume, 0, 1) * masterFor(def)
end

local function pitchOf(def: SoundDef): number
	local p = def.Pitch
	if type(p) == "number" and p > 0 then
		return p
	end
	return 1
end

local function maxDistOf(def: SoundDef): number
	if def.MaxDistance > 0 then
		return def.MaxDistance
	end
	return Mix.DefaultMaxDistance
end

local function rollOffOf(name: string): Enum.RollOffMode
	local ok, item = pcall(function(): any
		return (Enum.RollOffMode :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" then
		return item :: Enum.RollOffMode
	end
	return Enum.RollOffMode.InverseTapered
end

local function allowedFor(def: SoundDef): boolean
	if def.Bus == "Music" then
		return ClientSettings.ShouldPlayMusic()
	end
	return ClientSettings.ShouldPlaySfx()
end

local function ensureFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local existing = SoundService:FindFirstChild("WarEmpireAudio")
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local nf = Instance.new("Folder")
	nf.Name = "WarEmpireAudio"
	nf.Parent = SoundService
	folder = nf
	return nf
end

local function tweenVolume(s: Sound, target: number, seconds: number)
	if seconds <= 0 then
		s.Volume = target
		return
	end
	local ok = pcall(function()
		TweenService:Create(s, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Volume = target }):Play()
	end)
	if not ok then
		s.Volume = target
	end
end

local function listenerPos(): Vector3?
	local cam = Workspace.CurrentCamera
	if cam then
		local ok, p = pcall(function(): Vector3
			return cam.CFrame.Position
		end)
		if ok and typeof(p) == "Vector3" then
			return p
		end
	end
	return nil
end

local function finite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < math.huge and math.abs(v.Y) < math.huge and math.abs(v.Z) < math.huge
end

local function positionOf(at: any): Vector3?
	local ty = typeof(at)
	local pos: Vector3? = nil
	if ty == "Vector3" then
		pos = at :: Vector3
	elseif ty == "Instance" then
		local inst = at :: Instance
		pcall(function()
			if inst:IsA("BasePart") then
				pos = inst.Position
			elseif inst:IsA("Attachment") then
				pos = inst.WorldPosition
			elseif inst:IsA("Model") then
				pos = inst:GetPivot().Position
			end
		end)
	end
	if pos and finite(pos) then
		return pos
	end
	return nil
end

---------------------------------------------------------------------------------------------------------------
-- one-shot voices
---------------------------------------------------------------------------------------------------------------

local function prune(t: number)
	for i = #playing, 1, -1 do
		if playing[i].BusyUntil <= t then
			table.remove(playing, i)
		end
	end
end

local function stopVoice(v: Voice)
	v.BusyUntil = 0
	local i = table.find(playing, v)
	if i then
		table.remove(playing, i)
	end
	pcall(function()
		v.Sound:Stop()
	end)
end

local function count2D(): number
	local n = 0
	for _, v in ipairs(playing) do
		if not v.Positional then
			n += 1
		end
	end
	return n
end

-- the busy voice to steal for a new one of `priority`: lowest priority first, then the oldest; nil = keep them all
local function victimFor(priority: number, positional: boolean?): Voice?
	local best: Voice? = nil
	for _, v in ipairs(playing) do
		if positional == nil or v.Positional == positional then
			local b = best
			if b == nil or v.Priority < b.Priority or (v.Priority == b.Priority and v.StartedAt < b.StartedAt) then
				best = v
			end
		end
	end
	if best and best.Priority <= priority then
		return best
	end
	return nil
end

local function newVoice(key: string, def: SoundDef, positional: boolean): Voice
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = soundIdOf(def) or ""
	s.Looped = false
	s.Volume = volumeOf(def)
	local att: Attachment? = nil
	if positional then
		local a = Instance.new("Attachment")
		a.Name = "WE_Audio"
		a.Parent = Workspace.Terrain
		s.Parent = a
		att = a
	else
		s.Parent = ensureFolder()
	end
	local v: Voice = {
		Key = key,
		Sound = s,
		Attachment = att,
		Positional = positional,
		BusyUntil = 0,
		StartedAt = 0,
		Priority = 1,
		Serial = 0,
	}
	pcall(function()
		s.Ended:Connect(function()
			v.BusyUntil = 0
		end)
	end)
	return v
end

local function acquire(key: string, def: SoundDef, positional: boolean, t: number): Voice
	local poolKey = if positional then key .. "@3D" else key
	local pool = pools[poolKey]
	if pool == nil then
		pool = {}
		pools[poolKey] = pool
	end
	local list = pool :: { Voice }
	for _, v in ipairs(list) do
		if v.BusyUntil <= t then
			return v
		end
	end
	if #list < math.max(1, Mix.PoolPerKey) then
		local v = newVoice(key, def, positional)
		table.insert(list, v)
		return v
	end
	local oldest = list[1]
	for _, v in ipairs(list) do
		if v.StartedAt < oldest.StartedAt then
			oldest = v
		end
	end
	stopVoice(oldest)
	return oldest
end

local function lengthOf(def: SoundDef, s: Sound): number
	local maxS = def.MaxSeconds
	if maxS and maxS > 0 then
		return maxS + STOP_FADE
	end
	local tl: number? = nil
	pcall(function()
		tl = s.TimeLength
	end)
	if tl and tl > 0 then
		return tl / pitchOf(def)
	end
	return def.LengthSeconds or Mix.DefaultLengthSeconds
end

local function startVoice(v: Voice, def: SoundDef, pos: Vector3?, t: number, priority: number)
	local s = v.Sound
	local id = soundIdOf(def) or ""
	if s.SoundId ~= id then
		s.SoundId = id
	end
	s.Volume = volumeOf(def)
	s.PlaybackSpeed = pitchOf(def)
	local att = v.Attachment
	if att and pos then
		att.WorldPosition = pos
		s.RollOffMode = rollOffOf(def.RollOff)
		s.RollOffMinDistance = def.MinDistance or Mix.MinDistance
		s.RollOffMaxDistance = maxDistOf(def)
	end
	s.TimePosition = 0
	s:Play()
	serial += 1
	v.Serial = serial
	v.StartedAt = t
	v.Priority = priority
	v.BusyUntil = t + lengthOf(def, s)
	table.insert(playing, v)
	local maxS = def.MaxSeconds
	if maxS and maxS > 0 then
		local mine = v.Serial
		task.delay(maxS, function()
			if v.Serial ~= mine or v.BusyUntil <= 0 then
				return
			end
			tweenVolume(s, 0, STOP_FADE)
			task.delay(STOP_FADE, function()
				if v.Serial == mine and v.BusyUntil > 0 then
					stopVoice(v)
				end
			end)
		end)
	end
end

--[[ One-shot `key` (SoundConfig.Sounds). at = Vector3 | BasePart | Attachment | Model plays it in 3D there; nil = 2D.
	true = it started. Never errors (missing / disabled ids return false). ]]
function AudioController.Play(key: string, at: any?): boolean
	if type(key) ~= "string" then
		return drop("Missing")
	end
	if isServerContext() then
		return drop("Server")
	end
	if not initDone then
		pcall(AudioController.Init)
	end
	local def = defOf(key)
	if def == nil or soundIdOf(def) == nil then
		return drop("Missing")
	end
	local bus = def.Bus or "World"
	if bus == "Music" or bus == "Loop" then
		return drop("Loop") -- loops go through AudioController.Loop
	end
	if not ClientSettings.ShouldPlaySfx() then
		return drop("Muted")
	end
	local t = now()
	local last = lastPlayedAt[key]
	if last ~= nil and t - last < math.max(0, def.CooldownSeconds) then
		return drop("Cooldown")
	end
	local pos: Vector3? = nil
	if at ~= nil then
		pos = positionOf(at)
		if pos == nil then
			return drop("Missing")
		end
		local ear = listenerPos()
		if ear and (ear - pos).Magnitude > maxDistOf(def) then
			return drop("Far")
		end
	end
	local positional = pos ~= nil
	local priority = def.Priority or 1
	prune(t)

	-- one audible Stinger per window: the higher priority wins (PurchaseResult + cash float + toast = one sound)
	if bus == "Stinger" then
		local mark = lastStinger
		if mark and t - mark.At < Mix.StingerWindowSeconds then
			if priority <= mark.Priority then
				return drop("Collapsed")
			end
			if mark.Voice.Serial == mark.Serial and mark.Voice.BusyUntil > t then
				stopVoice(mark.Voice)
				stats.Replaced += 1
			end
		end
	end

	-- voice caps (steal the lowest priority / oldest, or drop this one)
	if not positional and count2D() >= Mix.MaxConcurrent2D then
		local victim = victimFor(priority, false)
		if victim == nil then
			return drop("Cap")
		end
		stopVoice(victim)
	end
	if #playing >= Mix.MaxConcurrent then
		local victim = victimFor(priority, nil)
		if victim == nil then
			return drop("Cap")
		end
		stopVoice(victim)
	end

	local okAcquire, voice = pcall(acquire, key, def, positional, t)
	if not okAcquire or voice == nil then
		return drop("Error")
	end
	local v = voice :: Voice
	local okStart = pcall(startVoice, v, def, pos, t, priority)
	if not okStart then
		stopVoice(v)
		return drop("Error")
	end
	lastPlayedAt[key] = t
	if bus == "Stinger" then
		lastStinger = { Voice = v, Serial = v.Serial, Priority = priority, At = t }
	end
	stats.Started += 1
	stats.ByKey[key] = (stats.ByKey[key] or 0) + 1
	stats.LastKey = key
	if #playing > stats.PeakActive then
		stats.PeakActive = #playing
	end
	return true
end

---------------------------------------------------------------------------------------------------------------
-- loop channels (music, ambience, engine)
---------------------------------------------------------------------------------------------------------------

local function channelOf(name: string): Channel
	local c = channels[name]
	if c == nil then
		local nc: Channel = { Name = name, Key = nil, Slots = {}, Gen = { 0, 0 }, Active = 0, Target = 0, Resume = {} }
		channels[name] = nc
		return nc
	end
	return c
end

local function slotSound(c: Channel, idx: number): Sound
	local s = c.Slots[idx]
	if s and s.Parent then
		return s
	end
	local ns = Instance.new("Sound")
	ns.Name = c.Name .. "_" .. tostring(idx)
	ns.Looped = true
	ns.Volume = 0
	ns.Parent = ensureFolder()
	c.Slots[idx] = ns
	return ns
end

local function fadeOutSlot(c: Channel, idx: number, seconds: number)
	local slot: Sound? = c.Slots[idx]
	if slot == nil then
		return
	end
	local s = slot :: Sound
	c.Gen[idx] += 1
	local gen = c.Gen[idx]
	tweenVolume(s, 0, seconds)
	task.delay(math.max(0, seconds), function()
		if c.Gen[idx] == gen then
			pcall(function()
				s:Stop()
			end)
		end
	end)
end

-- (re)apply the channel's state after a settings change or a same-key Loop call; true = audible
local function applyChannel(c: Channel, fade: number): boolean
	local key = c.Key
	if key == nil or c.Active == 0 then
		return false
	end
	local def = rawDef(key)
	local slot: Sound? = c.Slots[c.Active]
	if def == nil or slot == nil then
		return false
	end
	local s = slot :: Sound
	if allowedFor(def) then
		c.Gen[c.Active] += 1
		if s.IsPlaying and math.abs(s.Volume - c.Target) < 1e-3 then
			return true -- already there (the 1.5 s ambience check lands here: no tween churn)
		end
		if not s.IsPlaying then
			local okResume = pcall(function()
				if s.TimePosition > 0 then
					s:Resume()
				else
					s:Play()
				end
			end)
			if not okResume then
				pcall(function()
					s:Play()
				end)
			end
			stats.LoopStarts += 1
		end
		tweenVolume(s, c.Target, fade)
		return true
	end
	pcall(function()
		s.Volume = 0
		s:Pause()
	end)
	return false
end

--[[ Set loop channel `channel` to `key` (nil = stop) with a `fade`-second crossfade (default Mix.LoopFadeSeconds).
	A missing / disabled key stops the channel. true = the key is audible now (false while muted: it resumes later). ]]
function AudioController.Loop(channel: string, key: string?, fade: number?): boolean
	if type(channel) ~= "string" or isServerContext() then
		return false
	end
	if not initDone then
		pcall(AudioController.Init)
	end
	local c = channelOf(channel)
	local seconds = if type(fade) == "number" then math.max(0, fade) else Mix.LoopFadeSeconds
	local want: string? = key
	local def: SoundDef? = nil
	if want ~= nil then
		def = defOf(want)
		if def == nil or soundIdOf(def) == nil then
			drop("Missing")
			want = nil
			def = nil
		end
	end
	if c.Key == want then
		return applyChannel(c, seconds)
	end
	-- fade out whatever the channel carries now (music remembers where it was)
	if c.Active ~= 0 then
		local cur = c.Slots[c.Active]
		local curKey = c.Key
		if cur and curKey then
			pcall(function()
				c.Resume[curKey] = cur.TimePosition
			end)
		end
		fadeOutSlot(c, c.Active, seconds)
	end
	local prevActive = c.Active
	c.Key = want
	c.Active = 0
	if want == nil or def == nil then
		return false
	end
	local d = def :: SoundDef
	local idx = if prevActive == 1 then 2 else 1
	local s = slotSound(c, idx)
	c.Gen[idx] += 1
	s.SoundId = soundIdOf(d) or ""
	s.Looped = true
	s.PlaybackSpeed = pitchOf(d)
	s.Volume = 0
	c.Active = idx
	c.Target = volumeOf(d)
	if d.Bus == "Music" then
		local at = c.Resume[want]
		pcall(function()
			s.TimePosition = if at and at > 0 then at else 0
		end)
	else
		pcall(function()
			s.TimePosition = 0
		end)
	end
	if not allowedFor(d) then
		return false
	end
	s:Play()
	stats.LoopStarts += 1
	tweenVolume(s, c.Target, seconds)
	return true
end

--[[ Engine pitch etc.: writes PlaybackSpeed on the channel's active Sound (skips changes < Engine.PitchEpsilon). ]]
function AudioController.SetLoopPitch(channel: string, pitch: number)
	local c = channels[channel]
	if c == nil or c.Active == 0 or type(pitch) ~= "number" or pitch ~= pitch then
		return
	end
	local slot: Sound? = c.Slots[c.Active]
	if slot == nil then
		return
	end
	local s = slot :: Sound
	local p = math.clamp(pitch, 0.1, 4)
	if math.abs(s.PlaybackSpeed - p) >= SoundConfig.Engine.PitchEpsilon then
		s.PlaybackSpeed = p
	end
end

function AudioController.GetLoop(channel: string): string?
	local c = channels[channel]
	return if c then c.Key else nil
end

---------------------------------------------------------------------------------------------------------------
-- settings, init, legacy API
---------------------------------------------------------------------------------------------------------------

local function applySettings()
	if not ClientSettings.ShouldPlaySfx() then
		-- every pooled voice, not only the ones still counted busy (a file longer than its LengthSeconds hint)
		for _, pool in pairs(pools) do
			for _, v in ipairs(pool) do
				stopVoice(v)
			end
		end
	end
	for _, c in pairs(channels) do
		applyChannel(c, Mix.LoopFadeSeconds)
	end
end

function AudioController.Init()
	if initDone or isServerContext() then
		return
	end
	initDone = true
	ensureFolder()
	-- warm one 2D voice per UI / Stinger key so the first cue does not wait on a cold asset load
	for key, def in pairs(SoundConfig.Sounds) do
		if (def.Bus == "Stinger" or def.Bus == "UI") and soundIdOf(def) ~= nil and pools[key] == nil then
			pools[key] = { newVoice(key, def, false) }
		end
	end
	ClientSettings.OnChanged(applySettings)
	AudioController.Loop("Music", SoundConfig.Music.Base, SoundConfig.Music.FadeSeconds)
end

--[[ AudioHooks: NotificationController's next PlayNotification (within Hooks.NotificationTypeWindowSeconds) plays
	`key` instead of the plain UI.Notify ping. nil clears it. ]]
function AudioController.SetNextNotificationKey(key: string?)
	if key == nil then
		pendingNotify = nil
		return
	end
	pendingNotify = { Key = key, At = now() }
end

function AudioController.HasSound(key: string): boolean
	return soundIdOf(rawDef(key)) ~= nil
end

function AudioController.GetStats(): Stats
	prune(now())
	local n2, n3 = 0, 0
	for _, v in ipairs(playing) do
		if v.Positional then
			n3 += 1
		else
			n2 += 1
		end
	end
	return {
		Started = stats.Started,
		Replaced = stats.Replaced,
		LoopStarts = stats.LoopStarts,
		Active = #playing,
		Active2D = n2,
		Active3D = n3,
		PeakActive = stats.PeakActive,
		Dropped = table.clone(stats.Dropped),
		ByKey = table.clone(stats.ByKey),
		LastKey = stats.LastKey,
	}
end

--[[ UI button activate — respects SFX toggle. ]]
function AudioController.PlayClick()
	AudioController.Play("UI.Click")
end

--[[ Toast / reward ping — respects SFX toggle. The line's type (set by AudioHooks from the Notification remote in
	the same frame) picks the key; deferred one step so that hook has run whichever handler fired first. ]]
function AudioController.PlayNotification()
	if not ClientSettings.ShouldPlaySfx() then
		return
	end
	task.defer(function()
		local key = "UI.Notify"
		local p = pendingNotify
		if p and now() - p.At <= SoundConfig.Hooks.NotificationTypeWindowSeconds then
			key = p.Key
		end
		pendingNotify = nil
		AudioController.Play(key)
	end)
end

function AudioController.GetMusicVolume(): number
	return Mix.LegacyMusicVolume
end

function AudioController.GetSfxVolume(): number
	return Mix.LegacySfxVolume
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="174">
            <Properties>
              <string name="Name">AudioHooks</string>
              <string name="Source"><![CDATA[--!strict
--[[
	AudioHooks (W1 SND): turns EXISTING remotes and client signals into AudioController cues. It only listens: it never
	fires a remote, never writes another controller's state and needs no edit in Missile / Vehicle / Combat or any
	other controller. Keys and ids: Shared/Configs/SoundConfig.luau (Hooks table).

	  Notification            payload.Type (after NotificationConfig.Rewrite) → the key NotificationController's own
	                          PlayNotification plays for that line (SetNextNotificationKey), so a dropped / throttled
	                          line stays silent and a shown line makes exactly one sound. A HudConfig.Toast.Reroute rule
	                          with AlertSeconds ("BASE UNDER ATTACK!" banner) types that ping as Hooks.AlertReroute.
	  HudLayout.CashFloatRequested  +amount → Cash.Collect · −amount → Cash.Purchase
	  PurchaseResult          Ok → Cash.Purchase · not Ok → UI.Denied
	  TerritoryStateUpdate    diffs: my capture starts → Capture.Start · a zone becomes mine → Capture.Secured ·
	                          a zone stops being mine → Capture.Lost (the first payload is the baseline: silent)
	  AtmRaidStateUpdate      Phase "Alarm" (I am being robbed) → Alarm.Raid (1 s pushes; the key cooldown spaces it)
	  MissileStrikeFx         I am the victim → Alarm.Missile (the real siren), once per StrikeId; MissileController's
	                          own click siren (SoundService."WE_MissileSiren") is muted by name when that key is valid
	  XPUpdate                LevelUp → Level.Up
	  Humanoid.SeatPart       a vehicle seat → the "Engine" loop; its pitch follows the chassis speed, sampled at
	                          Engine.SampleHz (10 Hz) — the only periodic audio work while seated
	  HudLayout flags         Drawn AND Hurt (not Dead) → "Music" channel = combat layer; back to the base theme
	                          Music.CombatHoldSeconds after it clears
	  Ambience                ONE loop: desert wind, or surf within Ambience.NearWaterStuds of a WE_Water part
	                          (checked every Ambience.CheckSeconds, not per frame)

	Every handler is pcall-guarded: a bad payload can never break the remote's other listeners.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local SoundConfig = require(Shared.Configs.SoundConfig)
local NotificationConfig = require(Shared.Configs.NotificationConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local AudioController = require(script.Parent.AudioController)
local HudLayout = require(script.Parent.HudLayout)

local Hooks = SoundConfig.Hooks

local AudioHooks = {}

local initDone = false

local function guard(name: string, fn: (...any) -> ()): (...any) -> ()
	return function(...: any)
		local ok, err = pcall(fn :: any, ...)
		if not ok then
			warn("[AudioHooks] " .. name .. " failed:", err)
		end
	end
end

local function myUserId(): number
	local lp = Players.LocalPlayer
	return if lp then lp.UserId else -1
end

---------------------------------------------------------------------------------------------------------------
-- Notification remote
---------------------------------------------------------------------------------------------------------------

local function onNotification(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local text = if type(payload.Message) == "string" then payload.Message else ""
	local t = if type(payload.Type) == "string" then payload.Type else "Info"
	-- same first-match Rewrite NotificationController applies (it can change the type, e.g. LEVEL → Reward)
	for _, rule in ipairs(NotificationConfig.Rewrite) do
		if string.find(text, rule.Match) then
			if rule.Type then
				t = rule.Type
			end
			break
		end
	end
	-- same first-match Reroute: an Alert rule ("DEF HIT" → the BASE UNDER ATTACK! banner) pings through
	-- NotificationController.ShowAlert, and only when the rule's MinGapSeconds lets the banner show
	local key: string? = nil
	for _, rule in ipairs(HudConfig.Toast.Reroute) do
		if string.find(text, rule.Match) then
			if rule.AlertSeconds and rule.AlertSeconds > 0 then
				key = Hooks.AlertReroute
			elseif rule.Type then
				t = rule.Type
			end
			break
		end
	end
	key = key or Hooks.NotificationTypes[t]
	if key then
		AudioController.SetNextNotificationKey(key)
	end
end

---------------------------------------------------------------------------------------------------------------
-- cash float + purchase results + level up + raid alarm
---------------------------------------------------------------------------------------------------------------

local function onCashFloat(amount: any)
	if type(amount) ~= "number" or amount ~= amount or amount == 0 then
		return
	end
	AudioController.Play(if amount > 0 then Hooks.CashGain else Hooks.CashSpend)
end

local function onPurchaseResult(payload: any)
	if type(payload) ~= "table" then
		return
	end
	AudioController.Play(if payload.Ok == true then Hooks.PurchaseOk else Hooks.PurchaseFail)
end

local function onXP(payload: any)
	if type(payload) == "table" and payload.LevelUp == true then
		AudioController.Play(Hooks.LevelUp)
	end
end

local function onAtmRaid(payload: any)
	if type(payload) == "table" and payload.Phase == Hooks.RaidAlarmPhase then
		AudioController.Play(Hooks.RaidAlarm)
	end
end

---------------------------------------------------------------------------------------------------------------
-- territory diffs
---------------------------------------------------------------------------------------------------------------

local territoryBaseline = false
local mine: { [string]: boolean } = {}
local capturingId: string? = nil

local function onTerritory(payload: any)
	if type(payload) ~= "table" or type(payload.Territories) ~= "table" then
		return
	end
	local me = myUserId()
	local nowMine: { [string]: boolean } = {}
	local secured, lost = false, false
	for _, e in ipairs(payload.Territories) do
		if type(e) == "table" and type(e.Id) == "string" then
			local owned = tonumber(e.OwnerUserId) == me and e.OwnerType ~= "Neutral" and e.OwnerType ~= "NPC"
			if owned then
				nowMine[e.Id] = true
				if not mine[e.Id] then
					secured = true
				end
			elseif mine[e.Id] then
				lost = true
			end
		end
	end
	local lc = payload.LocalCapture
	local capId: string? = nil
	if type(lc) == "table" and lc.Capturing == true and type(lc.TerritoryId) == "string" then
		capId = lc.TerritoryId
	end
	local started = capId ~= nil and capId ~= capturingId and not nowMine[capId :: string]
	mine = nowMine
	capturingId = capId
	if not territoryBaseline then
		territoryBaseline = true -- join / first push: what I already own is not news
		return
	end
	-- one cue per push (a push that both secures and loses is rare; the bigger news wins)
	if secured then
		AudioController.Play(Hooks.CaptureSecured)
	elseif lost then
		AudioController.Play(Hooks.CaptureLost)
	elseif started then
		AudioController.Play(Hooks.CaptureStart)
	end
end

---------------------------------------------------------------------------------------------------------------
-- missile strike (victim siren)
---------------------------------------------------------------------------------------------------------------

local seenStrikes: { [number]: boolean } = {}
local seenCount = 0

local function serverNow(): number
	local ok, t = pcall(function(): number
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

local function onMissileFx(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if tonumber(payload.VictimUserId) ~= myUserId() then
		return
	end
	local id = tonumber(payload.StrikeId)
	if id == nil or seenStrikes[id] then
		return
	end
	seenCount += 1
	if seenCount > 256 then
		seenStrikes = {}
		seenCount = 1
	end
	seenStrikes[id] = true
	local launch = tonumber(payload.LaunchTime)
	local flight = tonumber(payload.FlightSeconds)
	if launch and flight and serverNow() > launch + flight + Hooks.MissileLateSeconds then
		return -- late joiner: the strike is already over
	end
	AudioController.Play(Hooks.MissileVictim)
end

-- MissileController plays its own click "siren" (a Sound named WE_MissileSiren in SoundService). The victim hears
-- the licensed siren from onMissileFx instead, so that click is silenced here — no edit to MissileController.
local function onSoundServiceChild(child: Instance)
	local name = Hooks.LegacyMissileSirenName
	if name == "" or child.Name ~= name or not child:IsA("Sound") then
		return
	end
	if AudioController.HasSound(Hooks.MissileVictim) then
		(child :: Sound).Volume = 0
	end
end

---------------------------------------------------------------------------------------------------------------
-- engine loop (Humanoid.SeatPart)
---------------------------------------------------------------------------------------------------------------

type Profile = SoundConfig.EngineProfile

local engineToken = 0

local function vehicleModelOf(seat: Instance): Model?
	local m = seat:FindFirstAncestorWhichIsA("Model")
	while m do
		if m:GetAttribute("WE_Category") ~= nil or CollectionService:HasTag(m, Constants.Tags.Vehicle) then
			return m
		end
		m = m:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end

-- profile + max speed for a seat; nil = not a vehicle (a bench or a chair)
local function engineFor(seat: Instance): (Profile?, number)
	local E = SoundConfig.Engine
	local model = vehicleModelOf(seat)
	if model == nil then
		if seat:IsA("VehicleSeat") then
			return E.Default, E.DefaultMaxSpeed
		end
		return nil, E.DefaultMaxSpeed
	end
	local maxSpeed = tonumber(model:GetAttribute("WE_MaxSpeed")) or E.DefaultMaxSpeed
	if maxSpeed <= 0 then
		maxSpeed = E.DefaultMaxSpeed
	end
	local family = model:GetAttribute("WE_KitFamily")
	if type(family) == "string" then
		for _, f in ipairs(E.Families) do
			if string.sub(family, 1, #f.Prefix) == f.Prefix then
				return { Key = f.Key, PitchMin = f.PitchMin, PitchMax = f.PitchMax }, maxSpeed
			end
		end
	end
	local cat = model:GetAttribute("WE_Category")
	if type(cat) == "string" and E.Categories[cat] then
		return E.Categories[cat], maxSpeed
	end
	return E.Default, maxSpeed
end

local function stopEngine()
	engineToken += 1
	AudioController.Loop("Engine", nil)
end

local function speedOf(seat: BasePart): number
	local v: any = nil
	pcall(function()
		v = seat.AssemblyLinearVelocity
	end)
	if typeof(v) == "Vector3" then
		local m = (v :: Vector3).Magnitude
		if m == m then
			return m
		end
	end
	return 0
end

local function startEngine(seat: BasePart)
	local profile, maxSpeed = engineFor(seat)
	if profile == nil then
		stopEngine()
		return
	end
	engineToken += 1
	local token = engineToken
	local p = profile :: Profile
	AudioController.Loop("Engine", p.Key)
	AudioController.SetLoopPitch("Engine", p.PitchMin)
	local dt = 1 / math.max(1, SoundConfig.Engine.SampleHz)
	task.spawn(function()
		while token == engineToken do
			task.wait(dt)
			if token ~= engineToken then
				break
			end
			if seat.Parent == nil then
				stopEngine()
				break
			end
			local frac = math.clamp(speedOf(seat) / maxSpeed, 0, 1)
			AudioController.SetLoopPitch("Engine", p.PitchMin + (p.PitchMax - p.PitchMin) * frac)
		end
	end)
end

local function onSeatPart(seat: Instance?)
	if seat ~= nil and seat:IsA("BasePart") then
		startEngine(seat)
	else
		stopEngine()
	end
end

local humConns: { RBXScriptConnection } = {}

local function clearHumanoid()
	for _, c in ipairs(humConns) do
		c:Disconnect()
	end
	table.clear(humConns)
end

local function bindHumanoid(hum: Humanoid)
	onSeatPart(hum.SeatPart)
	table.insert(humConns, hum:GetPropertyChangedSignal("SeatPart"):Connect(guard("SeatPart", function()
		onSeatPart(hum.SeatPart)
	end)))
	table.insert(humConns, hum.Died:Connect(guard("Died", function()
		stopEngine()
	end)))
end

local function bindCharacter(char: Model)
	clearHumanoid()
	stopEngine()
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		bindHumanoid(hum)
		return
	end
	local conn: RBXScriptConnection? = nil
	conn = char.ChildAdded:Connect(guard("CharacterChild", function(c: Instance)
		if c:IsA("Humanoid") then
			if conn then
				conn:Disconnect()
			end
			bindHumanoid(c)
		end
	end))
	if conn then
		table.insert(humConns, conn)
	end
end

---------------------------------------------------------------------------------------------------------------
-- music layer (HudLayout flags)
---------------------------------------------------------------------------------------------------------------

local combatOn = false
local combatToken = 0

local function evalCombat()
	local M = SoundConfig.Music
	local want = HudLayout.GetFlag("Drawn") and HudLayout.GetFlag("Hurt") and not HudLayout.GetFlag("Dead")
	if want then
		combatToken += 1
		if not combatOn then
			combatOn = true
			AudioController.Loop("Music", M.Combat, M.FadeSeconds)
		end
		return
	end
	if not combatOn then
		return
	end
	combatToken += 1
	local token = combatToken
	local hold = if HudLayout.GetFlag("Dead") then 0 else M.CombatHoldSeconds
	task.delay(hold, function()
		if token == combatToken and combatOn then
			combatOn = false
			AudioController.Loop("Music", M.Base, M.FadeSeconds)
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- ambience (one loop: wind, or surf near WE_Water)
---------------------------------------------------------------------------------------------------------------

local waterParts: { BasePart } = {}
local nearWaterNow = false

local function addWater(inst: Instance)
	if inst:IsA("BasePart") and not table.find(waterParts, inst) then
		table.insert(waterParts, inst)
	end
end

local function removeWater(inst: Instance)
	local i = table.find(waterParts, inst :: any)
	if i then
		table.remove(waterParts, i)
	end
end

local function waterWithin(pos: Vector3, studs: number): boolean
	local r2 = studs * studs
	for _, p in ipairs(waterParts) do
		if p.Parent then
			local lp = p.CFrame:PointToObjectSpace(pos)
			local hs = p.Size * 0.5
			local dx = math.max(math.abs(lp.X) - hs.X, 0)
			local dz = math.max(math.abs(lp.Z) - hs.Z, 0)
			if dx * dx + dz * dz <= r2 then
				return true
			end
		end
	end
	return false
end

local function ear(): Vector3?
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position
	end
	return nil
end

local function checkAmbience()
	local A = SoundConfig.Ambience
	local pos = ear()
	if pos then
		if nearWaterNow then
			nearWaterNow = waterWithin(pos, A.LeaveWaterStuds)
		else
			nearWaterNow = waterWithin(pos, A.NearWaterStuds)
		end
	end
	AudioController.Loop("Ambience", if nearWaterNow then A.NearWater else A.Default, A.FadeSeconds)
end

---------------------------------------------------------------------------------------------------------------
-- init
---------------------------------------------------------------------------------------------------------------

function AudioHooks.Init()
	if initDone then
		return
	end
	initDone = true
	AudioController.Init()

	local R = Constants.RemoteNames
	Remotes.BindEvent(R.Notification, guard("Notification", onNotification))
	Remotes.BindEvent(R.PurchaseResult, guard("PurchaseResult", onPurchaseResult))
	Remotes.BindEvent(R.TerritoryStateUpdate, guard("TerritoryStateUpdate", onTerritory))
	Remotes.BindEvent(R.AtmRaidStateUpdate, guard("AtmRaidStateUpdate", onAtmRaid))
	Remotes.BindEvent(R.MissileStrikeFx, guard("MissileStrikeFx", onMissileFx))
	Remotes.BindEvent(R.XPUpdate, guard("XPUpdate", onXP))
	HudLayout.CashFloatRequested:Connect(guard("CashFloat", onCashFloat))
	HudLayout.FlagChanged:Connect(guard("FlagChanged", function(name: string, _on: boolean)
		if name == "Drawn" or name == "Hurt" or name == "Dead" then
			evalCombat()
		end
	end))
	SoundService.ChildAdded:Connect(guard("SoundServiceChild", onSoundServiceChild))

	local lp = Players.LocalPlayer
	if lp then
		if lp.Character then
			guard("Character", bindCharacter)(lp.Character)
		end
		lp.CharacterAdded:Connect(guard("CharacterAdded", bindCharacter))
		lp.CharacterRemoving:Connect(guard("CharacterRemoving", function()
			clearHumanoid()
			stopEngine()
		end))
	end

	local tag = Constants.Tags.Water
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		addWater(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(addWater)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(removeWater)
	guard("Ambience", checkAmbience)()
	task.spawn(function()
		while true do
			task.wait(SoundConfig.Ambience.CheckSeconds)
			guard("Ambience", checkAmbience)()
		end
	end)
end

return AudioHooks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="175">
            <Properties>
              <string name="Name">ClientSettings</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Local-only client preferences (music/SFX flags).
	Session-scoped (no DataStore). AudioController listens via OnChanged
	and mutes/restores volumes immediately. Economy stays server-authoritative.
]]

local ClientSettings = {}

local musicEnabled = true
local sfxEnabled = true

local listeners: { () -> () } = {}

local function notify()
	for _, cb in ipairs(listeners) do
		task.defer(cb)
	end
end

function ClientSettings.GetMusicEnabled(): boolean
	return musicEnabled
end

function ClientSettings.GetSfxEnabled(): boolean
	return sfxEnabled
end

function ClientSettings.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled == true
	notify()
end

function ClientSettings.SetSfxEnabled(enabled: boolean)
	sfxEnabled = enabled == true
	notify()
end

function ClientSettings.ToggleMusic(): boolean
	ClientSettings.SetMusicEnabled(not musicEnabled)
	return musicEnabled
end

function ClientSettings.ToggleSfx(): boolean
	ClientSettings.SetSfxEnabled(not sfxEnabled)
	return sfxEnabled
end

function ClientSettings.OnChanged(cb: () -> ())
	table.insert(listeners, cb)
end

--[[ Call before playing music/SFX — returns false when muted. ]]
function ClientSettings.ShouldPlayMusic(): boolean
	return musicEnabled
end

function ClientSettings.ShouldPlaySfx(): boolean
	return sfxEnabled
end

return ClientSettings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="176">
            <Properties>
              <string name="Name">ConsoleWaypoint</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v71 console-only buying: Base panel GO -> a guide line and a small marker to that structure's console on YOUR plot.
	Never buys (buying happens at the console: BUY button in the action lane or the console prompt).

	Target: the real console part (Shared/Util/ConsoleLocator.Find(plotId, sid)). When the plot id is not known yet or
	the part is not on this client (StreamingEnabled streamed it out), the server-stamped player attribute
	WE_ConsolePos_<StructureId> (world Vector3 of YOUR console, set by UpgradePadService on plot ready) anchors a
	local invisible part until the real console is found.
	Cleared on arrival (ArriveRadius), timeout, another GO or Clear(); re-attached after respawn. Rebuild / retarget
	attempts are throttled to Waypoint.RetrySeconds; the distance label refreshes at Waypoint.RefreshHz (<= 10 Hz,
	CLAUDE.md UI refresh cap) and only rewrites its text when the whole-metre value changes. No WaitForChild; no
	remote calls.
	The marker is the one AlwaysOnTop objective marker (CLAUDE.md world labels): transient, only after GO, 14-20 px
	text (UITextSizeConstraint), sized to the structure name so long names never shrink below 14 px.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseConfig = require(Shared.Configs.BaseConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local ConsoleLocator = require(Shared.Util.ConsoleLocator)

local ConsoleWaypoint = {}

local player = Players.LocalPlayer
local W = ConsoleBuyConfig.Waypoint

local current: string? = nil -- structureId being guided to
local currentPlot: number? = nil
local startedAt = 0
local lastAttemptAt = -math.huge
local target: BasePart? = nil -- console part or local anchor
local anchor: BasePart? = nil -- client-only stand-in while the console is not on this client
local att0: Attachment? = nil
local att1: Attachment? = nil
local beam: Beam? = nil
local marker: BillboardGui? = nil
local distLabel: TextLabel? = nil
local stepConn: RBXScriptConnection? = nil
local stepAcc = 0
local shownMetres = -1

local function destroyVisuals()
	for _, inst in ipairs({ beam, marker, att0, att1, anchor } :: { Instance? }) do
		if inst then
			inst:Destroy()
		end
	end
	beam, marker, att0, att1, anchor, distLabel, target = nil, nil, nil, nil, nil, nil, nil
end

function ConsoleWaypoint.Clear()
	destroyVisuals()
	if stepConn then
		stepConn:Disconnect()
		stepConn = nil
	end
	current, currentPlot = nil, nil
end

function ConsoleWaypoint.Current(): string?
	return current
end

local function rootPart(): BasePart?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

local function realConsole(structureId: string): BasePart?
	local plotId = currentPlot
	if plotId == nil then
		return nil
	end
	return ConsoleLocator.Find(plotId, structureId)
end

local function stampedPos(structureId: string): Vector3?
	local pos = player:GetAttribute("WE_ConsolePos_" .. structureId)
	return if typeof(pos) == "Vector3" then pos else nil
end

-- true when a target can be resolved (console part or stamped position), without building anything
local function resolvable(structureId: string): boolean
	return realConsole(structureId) ~= nil or stampedPos(structureId) ~= nil
end

local function build(structureId: string)
	lastAttemptAt = os.clock()
	local hrp = rootPart()
	if hrp == nil then
		return -- respawning: try again after RetrySeconds (no anchor churn while dead)
	end
	destroyVisuals()
	local t: BasePart? = realConsole(structureId)
	if t == nil then
		local pos = stampedPos(structureId)
		if pos == nil then
			return
		end
		local a = Instance.new("Part")
		a.Name = "WE_ConsoleWaypointAnchor"
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.CanTouch = false
		a.Transparency = 1
		a.Size = Vector3.new(1, 1, 1)
		a.CFrame = CFrame.new(pos)
		a.Parent = Workspace.CurrentCamera or Workspace
		anchor = a
		t = a
	end
	local tp = t :: BasePart
	target = tp
	local top = (if anchor then 1.7 else tp.Size.Y * 0.5) + W.MarkerLift
	local a1 = Instance.new("Attachment")
	a1.Name = "WE_WaypointAtt1"
	a1.Position = Vector3.new(0, top, 0)
	a1.Parent = tp
	att1 = a1
	local a0 = Instance.new("Attachment")
	a0.Name = "WE_WaypointAtt0"
	a0.Parent = hrp
	att0 = a0

	local b = Instance.new("Beam")
	b.Name = "WE_ConsoleBeam"
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.FaceCamera = true
	b.Width0 = W.BeamWidth0
	b.Width1 = W.BeamWidth1
	b.LightEmission = W.BeamLightEmission
	b.Color = ColorSequence.new(W.BeamColor)
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0.85) })
	b.Parent = hrp
	beam = b

	local def = BaseConfig.Structures[structureId]
	local title = string.upper(if def then def.DisplayName else structureId)
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_ConsoleWaypoint"
	bb.Adornee = tp
	-- real px (a BillboardGui has no UIScale): 12 px per character keeps "SPECIAL FORCES FACILITY" at >= 14 px text
	bb.Size = UDim2.fromOffset(math.clamp(#title * 12 + 16, W.MarkerMinWidth, W.MarkerMaxWidth), 36)
	bb.StudsOffsetWorldSpace = Vector3.new(0, top, 0)
	bb.AlwaysOnTop = true -- transient: only after the player tapped GO, gone on arrival / timeout (walk-ins hide it otherwise)
	bb.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0.55, 0)
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = W.BeamColor
	name.TextStrokeTransparency = 0.4
	name.Text = title
	name.Parent = bb
	local nameCap = Instance.new("UITextSizeConstraint")
	nameCap.MinTextSize = W.MarkerMinTextPx
	nameCap.MaxTextSize = W.MarkerMaxTextPx
	nameCap.Parent = name
	local dist = Instance.new("TextLabel")
	dist.BackgroundTransparency = 1
	dist.Position = UDim2.fromScale(0, 0.55)
	dist.Size = UDim2.new(1, 0, 0.45, 0)
	dist.Font = Enum.Font.GothamBold
	dist.TextScaled = true
	dist.TextColor3 = Color3.new(1, 1, 1)
	dist.TextStrokeTransparency = 0.4
	dist.Text = ""
	dist.Parent = bb
	local distCap = Instance.new("UITextSizeConstraint")
	distCap.MinTextSize = W.MarkerMinTextPx
	distCap.MaxTextSize = W.MarkerMaxTextPx
	distCap.Parent = dist
	distLabel = dist
	shownMetres = -1
	bb.Parent = tp
	marker = bb
end

local function step(dt: number)
	local sid = current
	if sid == nil then
		return
	end
	-- <= RefreshHz: the arrival check, the distance label and the retry timer need no per-frame work
	stepAcc += dt
	if stepAcc < 1 / W.RefreshHz then
		return
	end
	stepAcc = 0
	local now = os.clock()
	if now - startedAt > W.TimeoutSeconds then
		ConsoleWaypoint.Clear()
		return
	end
	local hrp = rootPart()
	local t = target
	local broken = t == nil or t.Parent == nil or hrp == nil or att0 == nil or (att0 :: Attachment).Parent ~= hrp
	-- rebuild after respawn / console rebuilt, or retarget from the stamped anchor to the real console once it
	-- streams in; throttled (a tag scan per attempt)
	if (broken or anchor ~= nil) and now - lastAttemptAt >= W.RetrySeconds then
		if broken or realConsole(sid) ~= nil then
			build(sid)
		else
			lastAttemptAt = now
		end
		return
	end
	if broken or hrp == nil or t == nil then
		return
	end
	local d = ((hrp :: BasePart).Position - (t :: BasePart).Position).Magnitude
	if d <= W.ArriveRadius then
		ConsoleWaypoint.Clear() -- the BUY button takes over at the console
		return
	end
	local metres = math.floor(d + 0.5)
	local dl = distLabel
	if dl and metres ~= shownMetres then
		shownMetres = metres
		dl.Text = string.format("%d m", metres)
	end
end

--[[ Guide the local player to structureId's console on their own plot (plotId: from BaseStateUpdate / PlayerState;
	nil falls back to the server-stamped position). Returns false when neither the console part nor a stamped position
	is known yet (the caller shows ConsoleBuyConfig.Text.NoConsole). ]]
function ConsoleWaypoint.Show(structureId: string, plotId: number?): boolean
	ConsoleWaypoint.Clear()
	current, currentPlot, startedAt = structureId, plotId, os.clock()
	if not resolvable(structureId) then
		ConsoleWaypoint.Clear()
		return false
	end
	build(structureId) -- no-op while respawning; step() retries
	stepAcc = math.huge -- first step runs at once (distance label)
	stepConn = RunService.Heartbeat:Connect(step)
	return true
end

return ConsoleWaypoint
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="177">
            <Properties>
              <string name="Name">HudIcons</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HudIcons — v70 HUD icons built ONLY from Frames + UICorner + Rotation (no emoji, no uploaded images).

	Every part is placed in Scale units of the icon box, so an icon draws at any size and follows the gui's
	UIScale. Frame.Rotation turns about the centre, so every part is centred (AnchorPoint 0.5,0.5) and bars that
	pivot about an end have their centres pre-computed.

	  local icon = HudIcons.Make("Cart", parent, { Size = UDim2.fromOffset(38, 38), Color = accent, Fill = tileFill })
	  HudIcons.SetColor(icon, newInk, newFill?)      -- recolour (e.g. locked / pressed states)
	  HudIcons.SetRotation(compassArrow, bearingDeg)  -- "Arrow" only: turns the inner "Rot" group

	Colours: Color = the icon ink (default white). Fill = the colour of what the icon sits on: holes and gap
	masks (gear hole, ring centres, clipboard rows, cart slots) are painted with it (default HudConfig PillBg).
	"Cash" has its own fixed greens and a 42:32 box (HudConfig.CashPill.IconSize).

	Kinds: Cart Cycle Helmet Car Clipboard Gear Cash Shield Crosshair Arrow Plus Up Down Close Chevron Dot
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)

local HudIcons = {}

export type IconOpts = {
	Size: UDim2?, -- default UDim2.fromOffset(24, 24) (v units under a HUD UIScale)
	Position: UDim2?,
	AnchorPoint: Vector2?,
	ZIndex: number?, -- base ZIndex; parts stack above it in draw order
	LayoutOrder: number?,
	Name: string?,
	Color: Color3?, -- ink
	Fill: Color3?, -- background the icon sits on
	Rotation: number?, -- "Arrow": bearing in degrees, clockwise (same as SetRotation)
	Transparency: number?, -- ink/fill transparency (0 = solid)
}

-- role: "Ink" (Color), "Fill" (Fill), or a fixed Color3
type Part = {
	x: number, -- centre, fraction of the box
	y: number,
	w: number,
	h: number,
	role: string?,
	color: Color3?,
	r: number?, -- UICorner scale (0.5 = round); nil = square
	rot: number?,
	clip: { x: number, y: number, w: number, h: number }?, -- draw inside an axis-aligned clip frame (box coords)
}

local INK_DEFAULT = Color3.fromRGB(255, 255, 255)
local FILL_DEFAULT: Color3 = HudConfig.Colors.PillBg

-- top-left box (x, y, w, h) → centred part
local function box(x: number, y: number, w: number, h: number, role: string?, r: number?, rot: number?): Part
	return { x = x + w / 2, y = y + h / 2, w = w, h = h, role = role or "Ink", r = r, rot = rot }
end
local function fixed(x: number, y: number, w: number, h: number, color: Color3, r: number?): Part
	return { x = x + w / 2, y = y + h / 2, w = w, h = h, role = "Fixed", color = color, r = r }
end
-- a bar of length len and thickness t whose END sits at (ex, ey), pointing away from it at rot degrees
-- (rot 0 = straight down from the end point; positive = clockwise, like Frame.Rotation)
local function barFrom(ex: number, ey: number, t: number, len: number, rot: number, role: string?): Part
	local a = math.rad(rot)
	return {
		x = ex - math.sin(a) * len / 2,
		y = ey + math.cos(a) * len / 2,
		w = t,
		h = len,
		role = role or "Ink",
		r = 0.5,
		rot = rot,
	}
end

local SHAPES: { [string]: { Part } } = {}

SHAPES.Cart = {
	box(0.03, 0.17, 0.24, 0.08, "Ink", 0.5, 18), -- handle
	box(0.24, 0.3, 0.64, 0.38, "Ink", 0.26), -- basket (rounded bottom)
	box(0.24, 0.3, 0.64, 0.19, "Ink"), -- squares the basket's top corners
	box(0.2, 0.28, 0.72, 0.08, "Ink", 0.5), -- rim
	box(0.34, 0.39, 0.07, 0.2, "Fill", 0.43),
	box(0.51, 0.39, 0.07, 0.2, "Fill", 0.43),
	box(0.68, 0.39, 0.07, 0.2, "Fill", 0.43),
	box(0.3, 0.72, 0.16, 0.16, "Ink", 0.5), -- wheels
	box(0.66, 0.72, 0.16, 0.16, "Ink", 0.5),
}

SHAPES.Cycle = {
	box(0.1, 0.1, 0.8, 0.8, "Ink", 0.5), -- ring
	box(0.23, 0.23, 0.54, 0.54, "Fill", 0.5), -- ring hole
	box(0.62, 0.02, 0.3, 0.24, "Fill", nil, 30), -- gap top-right
	box(0.08, 0.74, 0.3, 0.24, "Fill", nil, 30), -- gap bottom-left
	-- arrowheads: half of a 45° diamond, clipped (a right-angled wedge)
	{ x = 0, y = 0.5, w = 0.2121, h = 0.2121, role = "Ink", rot = 45, clip = { x = 0.52, y = 0.04, w = 0.15, h = 0.3 } },
	{ x = 1, y = 0.5, w = 0.2121, h = 0.2121, role = "Ink", rot = 45, clip = { x = 0.33, y = 0.66, w = 0.15, h = 0.3 } },
}

SHAPES.Helmet = {
	box(0.14, 0.18, 0.72, 0.52, "Ink", 0.5), -- dome
	box(0.14, 0.44, 0.72, 0.26, "Ink"), -- squares the dome's lower corners
	box(0.05, 0.64, 0.9, 0.12, "Ink", 0.5), -- brim
	box(0.14, 0.52, 0.72, 0.07, "Fill"), -- band
	box(0.43, 0.28, 0.14, 0.14, "Fill", 0.5), -- badge
}

SHAPES.Car = {
	box(0.26, 0.24, 0.48, 0.26, "Ink", 0.46), -- cabin
	box(0.26, 0.37, 0.48, 0.13, "Ink"),
	box(0.33, 0.3, 0.34, 0.14, "Fill", 0.29), -- window
	box(0.06, 0.46, 0.88, 0.26, "Ink", 0.35), -- body
	box(0.17, 0.6, 0.22, 0.22, "Ink", 0.5), -- wheel rims
	box(0.61, 0.6, 0.22, 0.22, "Ink", 0.5),
	fixed(0.22, 0.65, 0.12, 0.12, Color3.fromRGB(21, 24, 27), 0.5), -- tyres
	fixed(0.66, 0.65, 0.12, 0.12, Color3.fromRGB(21, 24, 27), 0.5),
}

SHAPES.Clipboard = {
	box(0.18, 0.12, 0.64, 0.82, "Ink", 0.125), -- board
	box(0.34, 0.05, 0.32, 0.15, "Ink", 0.33), -- clip
	box(0.38, 0.09, 0.24, 0.07, "Fill", 0.5),
	box(0.27, 0.36, 0.11, 0.11, "Fill", 0.18), -- rows
	box(0.43, 0.385, 0.3, 0.06, "Fill", 0.5),
	box(0.27, 0.53, 0.11, 0.11, "Fill", 0.18),
	box(0.43, 0.555, 0.3, 0.06, "Fill", 0.5),
	box(0.27, 0.7, 0.11, 0.11, "Fill", 0.18),
	box(0.43, 0.725, 0.3, 0.06, "Fill", 0.5),
}

SHAPES.Gear = {
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 0), -- 8 teeth = 4 bars
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 45),
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 90),
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 135),
	box(0.16, 0.16, 0.68, 0.68, "Ink", 0.5), -- disc
	box(0.35, 0.35, 0.3, 0.3, "Fill", 0.5), -- hole
}

do -- Cash: 3 stacked bills in a 42:32 box (converted from the mock's 42x42 box shifted up 5)
	local edge = Color3.fromRGB(11, 61, 22)
	local cols = { Color3.fromRGB(28, 140, 52), Color3.fromRGB(44, 176, 70), Color3.fromRGB(74, 214, 96) }
	local ys = { 0.5, 0.303, 0.106 }
	local h = 0.4725
	local bw = 0.03 -- border, fraction of the box width
	local parts: { Part } = {}
	for i = 1, 3 do
		local x = 0.02 + (i - 1) * 0.04
		table.insert(parts, fixed(x, ys[i], 0.9, h, edge, 0.17))
		table.insert(parts, fixed(x + bw, ys[i] + bw * 42 / 32, 0.9 - 2 * bw, h - 2 * bw * 42 / 32, cols[i], 0.15))
	end
	table.insert(parts, fixed(0.4, 0.225, 0.22, 0.236, Color3.fromRGB(29, 107, 48), 0.5)) -- coin on the top bill
	SHAPES.Cash = parts
end

SHAPES.Shield = {
	box(0.2, 0.08, 0.6, 0.46, "Ink", 0.22), -- top (rounded)
	box(0.2, 0.3, 0.6, 0.24, "Ink"), -- squares the lower corners
	box(0.29, 0.31, 0.42, 0.42, "Ink", nil, 45), -- point
}

SHAPES.Crosshair = {
	box(0.2, 0.2, 0.6, 0.6, "Ink", 0.5), -- ring
	box(0.28, 0.28, 0.44, 0.44, "Fill", 0.5),
	box(0.46, 0.04, 0.08, 0.26, "Ink"), -- ticks
	box(0.46, 0.7, 0.08, 0.26, "Ink"),
	box(0.04, 0.46, 0.26, 0.08, "Ink"),
	box(0.7, 0.46, 0.26, 0.08, "Ink"),
	box(0.44, 0.44, 0.12, 0.12, "Ink", 0.5), -- dot
}

-- compass arrow (points UP at rotation 0): stem + chevron whose bars pivot about the tip
SHAPES.Arrow = {
	box(0.5 - 0.065, 0.16, 0.13, 0.66, "Ink", 0.46),
	barFrom(0.5, 0.16, 0.13, 0.4, 38),
	barFrom(0.5, 0.16, 0.13, 0.4, -38),
}

SHAPES.Plus = {
	box(0.2, 0.42, 0.6, 0.16, "Ink", 0.31),
	box(0.42, 0.2, 0.16, 0.6, "Ink", 0.31),
}

-- solid-looking chevrons (FredokaOne has no ▲▼ glyphs — risk #5)
SHAPES.Up = { barFrom(0.5, 0.28, 0.17, 0.5, 45), barFrom(0.5, 0.28, 0.17, 0.5, -45) }
SHAPES.Down = { barFrom(0.5, 0.72, 0.17, 0.5, 135), barFrom(0.5, 0.72, 0.17, 0.5, -135) }
SHAPES.Chevron = { barFrom(0.68, 0.5, 0.16, 0.5, 45 + 90), barFrom(0.68, 0.5, 0.16, 0.5, 45) } -- ▸
SHAPES.Close = { -- ✕
	{ x = 0.5, y = 0.5, w = 0.16, h = 0.84, role = "Ink", r = 0.5, rot = 45 },
	{ x = 0.5, y = 0.5, w = 0.16, h = 0.84, role = "Ink", r = 0.5, rot = -45 },
}
SHAPES.Dot = { box(0.2, 0.2, 0.6, 0.6, "Ink", 0.5) }

local KINDS: { string } = {}
for k in pairs(SHAPES) do
	table.insert(KINDS, k)
end
table.sort(KINDS)
HudIcons.Kinds = KINDS

function HudIcons.Has(kind: string): boolean
	return SHAPES[kind] ~= nil
end

local function colorFor(p: Part, ink: Color3, fill: Color3): Color3
	if p.role == "Fill" then
		return fill
	elseif p.role == "Fixed" and p.color then
		return p.color
	end
	return ink
end

local function corner(parent: Instance, r: number?)
	if r and r > 0 then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(math.min(r, 0.5), 0)
		c.Parent = parent
	end
end

--[[ Build an icon. parent may be nil (parent it yourself). Unknown kinds draw a Dot and warn once. ]]
local warnedKinds: { [string]: boolean } = {}
function HudIcons.Make(kind: string, parent: Instance?, opts: IconOpts?): Frame
	local o: IconOpts = opts or {}
	local shape = SHAPES[kind]
	if not shape then
		if not warnedKinds[kind] then
			warnedKinds[kind] = true
			warn("[HudIcons] unknown icon kind:", kind)
		end
		shape = SHAPES.Dot
	end
	local ink = o.Color or INK_DEFAULT
	local fill = o.Fill or FILL_DEFAULT
	local alpha = o.Transparency or 0
	local base = o.ZIndex or 1

	local root = Instance.new("Frame")
	root.Name = o.Name or ("Icon" .. kind)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = o.Size or UDim2.fromOffset(24, 24)
	root.Position = o.Position or UDim2.fromScale(0, 0)
	root.AnchorPoint = o.AnchorPoint or Vector2.zero
	root.ZIndex = base
	root.LayoutOrder = o.LayoutOrder or 0
	root.Active = false
	root:SetAttribute("HudIcon", kind)

	-- "Arrow" draws into an inner full-size group so SetRotation turns the whole glyph
	local host: Frame = root
	if kind == "Arrow" then
		local rot = Instance.new("Frame")
		rot.Name = "Rot"
		rot.BackgroundTransparency = 1
		rot.BorderSizePixel = 0
		rot.AnchorPoint = Vector2.new(0.5, 0.5)
		rot.Position = UDim2.fromScale(0.5, 0.5)
		rot.Size = UDim2.fromScale(1, 1)
		rot.Rotation = o.Rotation or 0
		rot.ZIndex = base
		rot.Active = false
		rot.Parent = root
		host = rot
	end

	for i, p in ipairs(shape) do
		local f = Instance.new("Frame")
		f.Name = "P" .. i
		f.BorderSizePixel = 0
		f.BackgroundColor3 = colorFor(p, ink, fill)
		f.BackgroundTransparency = alpha
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Rotation = p.rot or 0
		f.ZIndex = base + i
		f.Active = false
		f:SetAttribute("Role", p.role or "Ink")
		corner(f, p.r)
		local clip = p.clip
		if clip then
			-- an axis-aligned clipping frame in box coords; the part is placed in the clip frame's coords
			local c = Instance.new("Frame")
			c.Name = "Clip" .. i
			c.BackgroundTransparency = 1
			c.BorderSizePixel = 0
			c.ClipsDescendants = true
			c.Position = UDim2.fromScale(clip.x, clip.y)
			c.Size = UDim2.fromScale(clip.w, clip.h)
			c.ZIndex = base + i
			c.Active = false
			c.Parent = host
			-- part size is given in box fractions: convert to clip-frame fractions
			f.Size = UDim2.fromScale(p.w / clip.w, p.h / clip.h)
			f.Position = UDim2.fromScale(p.x, p.y)
			f.Parent = c
		else
			f.Size = UDim2.fromScale(p.w, p.h)
			f.Position = UDim2.fromScale(p.x, p.y)
			f.Parent = host
		end
	end

	if parent then
		root.Parent = parent
	end
	return root
end

--[[ Recolour an icon made by Make (ink parts → color; fill parts → fill when given). ]]
function HudIcons.SetColor(icon: Instance, color: Color3, fill: Color3?)
	for _, d in ipairs(icon:GetDescendants()) do
		if d:IsA("Frame") then
			local role = d:GetAttribute("Role")
			if role == "Ink" then
				d.BackgroundColor3 = color
			elseif role == "Fill" and fill then
				d.BackgroundColor3 = fill
			end
		end
	end
end

--[[ "Arrow": point the glyph at a bearing (degrees, clockwise; 0 = up). No-op for other kinds. ]]
function HudIcons.SetRotation(icon: Instance, degrees: number)
	local rot = icon:FindFirstChild("Rot")
	if rot and rot:IsA("GuiObject") then
		rot.Rotation = degrees
	end
end

return HudIcons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="178">
            <Properties>
              <string name="Name">HudLayout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HudLayout — the v70 HUD's shared layout brain (client only). Every HUD controller codes against this API;
	the numbers live in Shared/Configs/HudConfig.luau.

	GUARANTEES
	  * Works before anything registers: every getter answers from the camera / GuiService / a tiny probe gui.
	  * Never yields (the only yielding member is Signal:Wait(), on purpose).
	  * Degrades when ScreenInsets.TopbarSafeInsets / GuiService.TopbarInset / ScreenGui.ScreenInsets are
	    missing on an older client (spec risk #1): IgnoreGuiInset fallbacks + HudConfig.TopStrip.FallbackLeft.

	COORDINATES
	  "real" = device px. "v" = offsets under the HUD UIScale "MobileScale" (real = v × Scale()).
	  Rects returned here (ContentRect, Reserve, GetRect, TopStack placement) are in the SAME space as
	  GuiObject.AbsolutePosition, so compare them with AbsolutePosition/AbsoluteSize directly. TopbarRect() is
	  in screen px (GuiService.TopbarInset space).

	API (fixed contracts, spec §9)
	  ApplyScreen(screen, {DisplayOrder?, Insets? = "Core"|"Topbar"|"None"|"Device", Scale?}) -> UIScale?
	  Scale() -> number · IsTouch() -> boolean · ContentSizeV() -> Vector2
	  PrefersKeys() -> boolean · InputModeChanged (prefersKeys)   -- key hints / keyboard copy (CLAUDE.md §1)
	  SetFlag(name, on) · GetFlag(name) -> boolean · FlagChanged (name, on)
	  BindVisibility(obj, {ShowWhen?, HideWhen?}, extra?)
	  RegisterTopStack(name, obj, order, {Space? = "Hud"|"Screen"})
	  RegisterPanel(id, isOpen, close, {Fallback?, NonModal?}) · PanelOpened(id) · PanelClosed(id)
	  SetBadge(tileId, text?) · BadgeChanged (tileId, text?)
	  CashFloat(amount) · CashFloatRequested (amount)
	  SetRect(name, obj) · GetRect(name) -> (pos, size)
	  Reserve("CombatTouch"|"CombatDesktop"|"Combat") -> Rect
	  ActionLaneBottomV() -> number
	  Signals.CompassTapped
	EXTRAS
	  Init() · LayoutChanged · ContentRect() · ToPx(v) · ToV(px) · TopbarRect() · TopbarArea(screen)
	  UnbindVisibility(obj) · RefreshVisibility(obj?) · EvalRule(rule, extra?) · Flags()
	  UnregisterTopStack(name) · RelayoutTopStack() · TopStackMaxWidthV()
	  IsPanelOpen(id) · OpenPanelId() · CloseAllPanels() · HasPanel(id) · PanelSerial() · PanelChanged (id, open)
	  GetBadge(tileId) · Emit(signalName, ...) · AssertTouchTarget(obj, label?)
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = {}

export type Rule = { ShowWhen: { string }?, HideWhen: { string }? }
-- what BindVisibility / EvalRule accept: any table with HideWhen and/or ShowWhen (HudConfig.Rail, .Hotbar, ...)
export type RuleArg = Rule | { HideWhen: { string } } | { ShowWhen: { string } }
export type ScreenOpts = { DisplayOrder: number?, Insets: string?, Scale: boolean? }
export type StackOpts = { Space: string? }

local PROBE_NAME = "WE_HudProbe"
local FALLBACK_VIEWPORT = Vector2.new(1280, 720)
local FALLBACK_TOPBAR_H = 58

---------------------------------------------------------------------------------------------------------------
-- tiny signal (RBXScriptSignal-shaped: Connect / Once / Wait / ConnectParallel; conn:Disconnect())
-- Handlers run through task.spawn, so one failing handler never stops the others.
---------------------------------------------------------------------------------------------------------------

local function newSignal(): (any, (...any) -> ())
	local conns: { any } = {}
	local waiting: { thread } = {}
	local sig: any = {}
	local function connect(_self: any, fn: (...any) -> ()): any
		local c: any = { Connected = true, Fn = fn }
		c.Disconnect = function(_: any)
			if not c.Connected then
				return
			end
			c.Connected = false
			local i = table.find(conns, c)
			if i then
				table.remove(conns, i)
			end
		end
		table.insert(conns, c)
		return c
	end
	sig.Connect = connect
	sig.ConnectParallel = connect
	sig.Once = function(self: any, fn: (...any) -> ()): any
		local c: any = nil
		c = connect(self, function(...)
			if c then
				c:Disconnect()
			end
			fn(...)
		end)
		return c
	end
	sig.Wait = function(_self: any): ...any
		table.insert(waiting, coroutine.running())
		return coroutine.yield()
	end
	local function fire(...: any)
		for _, c in ipairs(table.clone(conns)) do
			if c.Connected then
				task.spawn(c.Fn, ...)
			end
		end
		if #waiting > 0 then
			local w = waiting
			waiting = {}
			for _, co in ipairs(w) do
				task.spawn(co, ...)
			end
		end
	end
	return sig, fire
end

local flagSig, fireFlag = newSignal()
local badgeSig, fireBadge = newSignal()
local cashSig, fireCash = newSignal()
local layoutSig, fireLayout = newSignal()
local panelSig, firePanel = newSignal()
local compassSig, fireCompass = newSignal()
local inputSig, fireInput = newSignal()

HudLayout.FlagChanged = flagSig :: RBXScriptSignal<string, boolean>
HudLayout.BadgeChanged = badgeSig :: RBXScriptSignal<string, string?>
HudLayout.CashFloatRequested = cashSig :: RBXScriptSignal<number>
HudLayout.LayoutChanged = layoutSig :: RBXScriptSignal<>
HudLayout.PanelChanged = panelSig :: RBXScriptSignal<string, boolean>
HudLayout.InputModeChanged = inputSig :: RBXScriptSignal<boolean>
HudLayout.Signals = {
	CompassTapped = compassSig :: RBXScriptSignal<>, -- CompassController fires (Emit), TerritoryController listens
}
local emitters: { [string]: (...any) -> () } = { CompassTapped = fireCompass }

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, ...: any)
	if warned[key] then
		return
	end
	warned[key] = true
	warn("[HudLayout]", ...)
end

---------------------------------------------------------------------------------------------------------------
-- device, viewport, scale, content rect
---------------------------------------------------------------------------------------------------------------

local touchOverride: boolean? = nil

-- Same test as VehicleDriveClient / every controller (UserInputService.TouchEnabled) so the touch reserve,
-- the ▲▼ column and the touch combat buttons always agree.
function HudLayout.IsTouch(): boolean
	if touchOverride ~= nil then
		return touchOverride
	end
	return UserInputService.TouchEnabled == true
end

--[[
	Key hints and keyboard copy ("press K", "WASD", key caps, the Settings controls sheet) show ONLY when this is
	true: UserInputService.PreferredInput is KeyboardAndMouse or Gamepad (CLAUDE.md §1 "Copy by device": detect
	with PreferredInput, not TouchEnabled). IsTouch() stays the LAYOUT switch (tap-target sizes).
	Fallback when the property is missing (older clients, the headless harness): the last input type, then
	"has a keyboard and no touch screen". A phone therefore never gets key copy.
]]
local keyPrefOverride: boolean? = nil

local function readPreferredInput(): string?
	local ok, v = pcall(function(): any
		return (UserInputService :: any).PreferredInput
	end)
	if ok and typeof(v) == "EnumItem" then
		local name = (v :: EnumItem).Name
		if name == "KeyboardAndMouse" or name == "Gamepad" or name == "Touch" then
			return name
		end
	end
	return nil
end

local function lastInputPrefersKeys(): boolean?
	local ok, t = pcall(function(): any
		return UserInputService:GetLastInputType()
	end)
	if not ok or typeof(t) ~= "EnumItem" then
		return nil
	end
	local name = (t :: EnumItem).Name
	if name == "Touch" then
		return false
	end
	if name == "Keyboard" or string.sub(name, 1, 5) == "Mouse" or string.sub(name, 1, 7) == "Gamepad" then
		return true
	end
	return nil
end

function HudLayout.PrefersKeys(): boolean
	if keyPrefOverride ~= nil then
		return keyPrefOverride
	end
	local pref = readPreferredInput()
	if pref then
		return pref ~= "Touch"
	end
	local last = lastInputPrefersKeys()
	if last ~= nil then
		return last
	end
	local okT, touch = pcall(function(): boolean
		return UserInputService.TouchEnabled == true
	end)
	local okK, keys = pcall(function(): boolean
		return UserInputService.KeyboardEnabled == true or UserInputService.GamepadEnabled == true
	end)
	return (okK and keys == true) and not (okT and touch == true)
end

local lastKeyPref: boolean? = nil
local function checkInputMode()
	local now = HudLayout.PrefersKeys()
	if now ~= lastKeyPref then
		local first = lastKeyPref == nil
		lastKeyPref = now
		if not first then
			fireInput(now)
		end
	end
end

local function viewportSize(): Vector2
	local cam = Workspace.CurrentCamera
	if cam then
		local v = cam.ViewportSize
		if v.X > 1 and v.Y > 1 then
			return v
		end
	end
	return FALLBACK_VIEWPORT
end

local function scaleFor(vp: Vector2): number
	local sc = HudConfig.Scale
	return math.clamp(math.min(vp.X, vp.Y) / sc.BasePx, sc.Min, sc.Max)
end

--[[ S = clamp(min(vw, vh) / 800, 0.70, 1.15): 844x390 → 0.70, 956x440 → 0.70, 1280x720 → 0.90, 1920x1080 → 1.15 ]]
function HudLayout.Scale(): number
	return scaleFor(viewportSize())
end

function HudLayout.ToPx(v: number): number
	return v * HudLayout.Scale()
end

function HudLayout.ToV(px: number): number
	return px / HudLayout.Scale()
end

local function guiInset(): (Vector2, Vector2)
	local ok, tl, br = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(tl) == "Vector2" and typeof(br) == "Vector2" then
		return tl, br
	end
	return Vector2.new(0, FALLBACK_TOPBAR_H), Vector2.zero
end

local probe: ScreenGui? = nil
local probeConns: { RBXScriptConnection } = {}
local onLayoutChanged: () -> () -- forward

local function ensureProbe(): ScreenGui?
	local g = probe
	if g and g.Parent then
		return g
	end
	local lp = Players.LocalPlayer
	local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local existing = pg:FindFirstChild(PROBE_NAME)
	local sg: ScreenGui
	if existing and existing:IsA("ScreenGui") then
		sg = existing
	else
		sg = Instance.new("ScreenGui")
		sg.Name = PROBE_NAME
		sg.ResetOnSpawn = false
		sg.DisplayOrder = -1
		sg.IgnoreGuiInset = false
		pcall(function()
			sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
		end)
		sg.Parent = pg
	end
	for _, c in ipairs(probeConns) do
		c:Disconnect()
	end
	table.clear(probeConns)
	table.insert(probeConns, sg:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		onLayoutChanged()
	end))
	table.insert(probeConns, sg:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		onLayoutChanged()
	end))
	probe = sg
	return sg
end

-- the safe content rect (CoreUISafeInsets area) in AbsolutePosition space: x, y, w, h (real px)
local function contentRect(): (number, number, number, number)
	local g = ensureProbe()
	if g then
		local ok, pos, size = pcall(function()
			return g.AbsolutePosition, g.AbsoluteSize
		end)
		if ok and typeof(pos) == "Vector2" and typeof(size) == "Vector2" and size.X > 1 and size.Y > 1 then
			return pos.X, pos.Y, size.X, size.Y
		end
	end
	-- no PlayerGui yet: viewport minus the gui inset (no notch information)
	local vp = viewportSize()
	local tl, br = guiInset()
	return tl.X, tl.Y, math.max(1, vp.X - tl.X - br.X), math.max(1, vp.Y - tl.Y - br.Y)
end

function HudLayout.ContentRect(): Rect
	local x, y, w, h = contentRect()
	return Rect.new(x, y, x + w, y + h)
end

--[[ The content rect in v (844x390 → 1071x474). ]]
function HudLayout.ContentSizeV(): Vector2
	local _, _, w, h = contentRect()
	local s = HudLayout.Scale()
	return Vector2.new(w / s, h / s)
end

---------------------------------------------------------------------------------------------------------------
-- topbar row (TopStrip)
---------------------------------------------------------------------------------------------------------------

local function topbarInsetRect(): Rect?
	local ok, r = pcall(function()
		return (GuiService :: any).TopbarInset
	end)
	if ok and typeof(r) == "Rect" and r.Width > 0 and r.Height > 0 then
		return r
	end
	return nil
end

--[[ The free part of the Roblox topbar row in screen px: GuiService.TopbarInset, or (older clients) from
	safe-left + HudConfig.TopStrip.FallbackLeft to the content's right edge, GetGuiInset().Y tall. ]]
function HudLayout.TopbarRect(): Rect
	local r = topbarInsetRect()
	if r then
		return r
	end
	local cx, _, cw, _ = contentRect()
	local tl = guiInset()
	local h = if tl.Y >= 1 then tl.Y else FALLBACK_TOPBAR_H
	local left = cx + HudConfig.TopStrip.FallbackLeft
	return Rect.new(left, 0, math.max(left, cx + cw), h)
end

local topbarAreas: { [ScreenGui]: Frame } = setmetatable({} :: any, { __mode = "k" })

local function placeTopbarArea(screen: ScreenGui, f: Frame)
	if screen:GetAttribute("WE_HudInsets") == "Topbar" then
		-- native TopbarSafeInsets: the gui itself is the free topbar row and reflows with the unibar
		f.Position = UDim2.fromScale(0, 0)
		f.Size = UDim2.fromScale(1, 1)
		return
	end
	-- fallback (IgnoreGuiInset = true): place the row in this gui's local px. Abs X == screen X; the gui's
	-- top is the screen top, i.e. content top − the gui inset, whatever the AbsolutePosition convention.
	local r = HudLayout.TopbarRect()
	local _, cy = contentRect()
	local tl = guiInset()
	local origin = screen.AbsolutePosition
	local originX = origin.X
	local originY = origin.Y - (cy - tl.Y)
	f.Position = UDim2.fromOffset(r.Min.X - originX, r.Min.Y - originY)
	f.Size = UDim2.fromOffset(r.Width, r.Height)
end

--[[ A transparent Frame "TopbarArea" inside a TopStrip gui (ApplyScreen Insets = "Topbar") that always covers
	the free topbar row, native or fallback. Put the left group at (0, EdgePad, 0.5, YNudge) and the compass at
	(1, -EdgePad, 0.5, 0) inside it. Kept in place on LayoutChanged. ]]
function HudLayout.TopbarArea(screen: ScreenGui): Frame
	local found = screen:FindFirstChild("TopbarArea")
	local f: Frame
	if found and found:IsA("Frame") then
		f = found
	else
		f = Instance.new("Frame")
		f.Name = "TopbarArea"
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.Active = false
		f.Parent = screen
	end
	topbarAreas[screen] = f
	placeTopbarArea(screen, f)
	return f
end

---------------------------------------------------------------------------------------------------------------
-- ScreenGui setup + the one shared UIScale
---------------------------------------------------------------------------------------------------------------

local trackedScales: { [UIScale]: boolean } = setmetatable({} :: any, { __mode = "k" })

local function setInsets(screen: ScreenGui, want: Enum.ScreenInsets): boolean
	local ok = pcall(function()
		screen.ScreenInsets = want
	end)
	return ok
end

local function enumInset(name: string): Enum.ScreenInsets?
	local ok, item = pcall(function()
		return (Enum.ScreenInsets :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" then
		return item :: Enum.ScreenInsets
	end
	return nil
end

-- returns the mode actually applied: "Core" | "Topbar" | "TopbarFallback" | "None" | "Device" | "Legacy"
local function applyInsets(screen: ScreenGui, insets: string): string
	if insets == "Topbar" then
		screen.IgnoreGuiInset = true
		local item = enumInset("TopbarSafeInsets")
		if item and setInsets(screen, item) then
			return "Topbar"
		end
		return "TopbarFallback"
	elseif insets == "None" or insets == "Device" then
		screen.IgnoreGuiInset = true
		local item = enumInset(if insets == "None" then "None" else "DeviceSafeInsets")
		if item and setInsets(screen, item) then
			return insets
		end
		return "Legacy"
	end
	if insets ~= "Core" then
		warnOnce("insets:" .. insets, "unknown Insets", insets, "- using Core")
	end
	screen.IgnoreGuiInset = false
	local item = enumInset("CoreUISafeInsets")
	if item and setInsets(screen, item) then
		return "Core"
	end
	return "Legacy" -- IgnoreGuiInset = false is the old-client equivalent
end

--[[
	The only way a HUD ScreenGui is set up. ResetOnSpawn = false, Sibling z, DisplayOrder (opts or
	HudConfig.DisplayOrder[screen.Name]), insets, and ONE UIScale "MobileScale" (reused if the gui has one)
	that HudLayout keeps at Scale(). Scale defaults to true except for Insets = "Topbar" (real px).
	The applied mode is stored in the attribute WE_HudInsets ("Core", "Topbar", "TopbarFallback", "None",
	"Device", "Legacy"). Returns the UIScale, or nil when Scale = false.
]]
function HudLayout.ApplyScreen(screen: ScreenGui, opts: ScreenOpts?): UIScale?
	local o: ScreenOpts = opts or {}
	local insets = o.Insets or "Core"
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local order = o.DisplayOrder or (HudConfig.DisplayOrder :: any)[screen.Name]
	if typeof(order) == "number" then
		screen.DisplayOrder = order
	end
	local mode = applyInsets(screen, insets)
	screen:SetAttribute("WE_HudInsets", mode)

	local wantScale = if o.Scale == nil then insets ~= "Topbar" else o.Scale == true
	local existing: UIScale? = nil
	for _, c in ipairs(screen:GetChildren()) do
		if c:IsA("UIScale") then
			if c.Name == "MobileScale" then
				existing = c
				break
			end
			if not existing then
				existing = c
			end
		end
	end
	if existing then
		UIUtil.ReleaseMobileScale(existing) -- stop UIUtil.AttachMobileScale's own tracker fighting ours
	end
	if not wantScale then
		if existing then
			trackedScales[existing] = nil
			existing:Destroy()
		end
		if topbarAreas[screen] then
			placeTopbarArea(screen, topbarAreas[screen])
		end
		return nil
	end
	local sc: UIScale = existing or Instance.new("UIScale")
	sc.Name = "MobileScale"
	sc.Scale = HudLayout.Scale()
	sc.Parent = screen
	trackedScales[sc] = true
	return sc
end

---------------------------------------------------------------------------------------------------------------
-- context flags + visibility
---------------------------------------------------------------------------------------------------------------

local flags: { [string]: boolean } = {}

type Binding = { Rule: Rule, Extra: (() -> boolean)? }
local bindings: { [GuiObject]: Binding } = setmetatable({} :: any, { __mode = "k" })

-- true / false, or nil when `extra` threw (keep the current visibility)
local function evalRule(rule: Rule, extra: (() -> boolean)?): boolean?
	local hide = rule.HideWhen
	if hide then
		for _, f in ipairs(hide) do
			if flags[f] then
				return false
			end
		end
	end
	local show = rule.ShowWhen
	if show and #show > 0 then
		local any = false
		for _, f in ipairs(show) do
			if flags[f] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	if extra then
		local ok, res = pcall(extra)
		if not ok then
			warnOnce("extra:" .. tostring(extra), "BindVisibility extra() failed:", res)
			return nil
		end
		return res == true
	end
	return true
end

local function applyBinding(obj: GuiObject, b: Binding)
	local v = evalRule(b.Rule, b.Extra)
	if v == nil then
		return
	end
	local inst: Instance = obj
	if inst:IsA("GuiObject") then
		if inst.Visible ~= v then
			inst.Visible = v
		end
	elseif inst:IsA("LayerCollector") then
		if inst.Enabled ~= v then
			inst.Enabled = v
		end
	end
end

local function ruleMentions(rule: Rule, name: string): boolean
	if rule.HideWhen and table.find(rule.HideWhen, name) then
		return true
	end
	if rule.ShowWhen and table.find(rule.ShowWhen, name) then
		return true
	end
	return false
end

function HudLayout.GetFlag(name: string): boolean
	return flags[name] == true
end

--[[ Context flags (HudConfig.Context.Flags + OrdersOpen, Radar, or any name). Fires FlagChanged on change. ]]
function HudLayout.SetFlag(name: string, on: boolean)
	local v = on == true
	if (flags[name] == true) == v then
		return
	end
	flags[name] = v
	for obj, b in pairs(bindings) do
		if ruleMentions(b.Rule, name) then
			applyBinding(obj, b)
		end
	end
	fireFlag(name, v)
end

function HudLayout.Flags(): { [string]: boolean }
	return table.clone(flags)
end

--[[ true when the rule passes right now (all HideWhen flags off, any ShowWhen flag on, extra() true). ]]
function HudLayout.EvalRule(rule: RuleArg, extra: (() -> boolean)?): boolean
	return evalRule(rule :: any, extra) == true
end

--[[
	HudLayout owns obj.Visible from now on (a ScreenGui: .Enabled): visible = no HideWhen flag on AND (no
	ShowWhen, or any ShowWhen flag on) AND (extra == nil or extra()). Re-evaluated on every relevant SetFlag;
	call RefreshVisibility(obj) when whatever extra() reads changes. Rebinding replaces the old rule.
	HudConfig tables work as rules directly: BindVisibility(rail, HudConfig.Rail).
]]
function HudLayout.BindVisibility(obj: GuiObject, rule: RuleArg, extra: (() -> boolean)?)
	local r: Rule = rule :: any
	local b: Binding = { Rule = { ShowWhen = r.ShowWhen, HideWhen = r.HideWhen }, Extra = extra }
	bindings[obj] = b
	applyBinding(obj, b)
end

function HudLayout.UnbindVisibility(obj: GuiObject)
	bindings[obj] = nil
end

function HudLayout.RefreshVisibility(obj: GuiObject?)
	if obj then
		local b = bindings[obj]
		if b then
			applyBinding(obj, b)
		end
		return
	end
	for o, b in pairs(bindings) do
		applyBinding(o, b)
	end
end

---------------------------------------------------------------------------------------------------------------
-- top-centre stack
---------------------------------------------------------------------------------------------------------------

type StackItem = {
	Name: string,
	Obj: GuiObject,
	Order: number,
	Seq: number,
	Space: string,
	Conns: { RBXScriptConnection },
}
local stack: { [string]: StackItem } = {}
local stackSeq = 0
local stackQueued = false

local function firstUIScale(inst: Instance): number
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("UIScale") then
			return c.Scale
		end
	end
	return 1
end

-- product of the UIScales that act on `from`'s children: from itself up to (and including) its LayerCollector
local function chainScale(from: Instance?): number
	local k = 1
	local p = from
	while p do
		k *= firstUIScale(p)
		if p:IsA("LayerCollector") then
			break
		end
		p = p.Parent
	end
	return k
end

local function shownOnScreen(obj: GuiObject): boolean
	if not obj.Visible then
		return false
	end
	local p = obj.Parent
	while p do
		if p:IsA("GuiObject") then
			if not p.Visible then
				return false
			end
		elseif p:IsA("LayerCollector") then
			return p.Enabled
		else
			return false
		end
		p = p.Parent
	end
	return false
end

--[[ Place every registered, visible item top-down in Order (ties: registration order). Synchronous. ]]
function HudLayout.RelayoutTopStack()
	stackQueued = false
	if next(stack) == nil then
		return
	end
	local items: { StackItem } = {}
	for _, it in pairs(stack) do
		if it.Obj.Parent then
			table.insert(items, it)
		end
	end
	table.sort(items, function(a: StackItem, b: StackItem): boolean
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		return a.Seq < b.Seq
	end)
	local _, cy = contentRect()
	local s = HudLayout.Scale()
	local y = cy + HudConfig.TopStack.Top * s
	local gap = HudConfig.TopStack.Gap * s
	for _, it in ipairs(items) do
		local obj = it.Obj
		if shownOnScreen(obj) then
			local own = firstUIScale(obj)
			if own <= 0 then
				own = 1
			end
			local h = obj.AbsoluteSize.Y / own -- real px, ignoring the item's own pop-in UIScale
			local parent = obj.Parent
			local parentY = cy
			if parent and parent:IsA("GuiBase2d") then
				parentY = parent.AbsolutePosition.Y
			end
			local k = chainScale(parent)
			if k <= 0 then
				k = 1
			end
			local offset = (y + obj.AnchorPoint.Y * h - parentY) / k
			local pos = obj.Position
			if pos.Y.Scale ~= 0 or math.abs(pos.Y.Offset - offset) > 0.01 then
				obj.Position = UDim2.new(pos.X.Scale, pos.X.Offset, 0, offset)
			end
			y += h + gap
		end
	end
end

local function queueStack()
	if stackQueued then
		return
	end
	stackQueued = true
	task.defer(function()
		if stackQueued then
			HudLayout.RelayoutTopStack()
		end
	end)
end

function HudLayout.UnregisterTopStack(name: string)
	local it = stack[name]
	if not it then
		return
	end
	for _, c in ipairs(it.Conns) do
		c:Disconnect()
	end
	stack[name] = nil
	queueStack()
end

--[[
	Stack obj in the top-centre column under the topbar (HudConfig.TopStack: Top 8 v, Gap 6 v; Order from
	HudConfig.TopStack.Order — Alert 10, Progress 20, Objective 30, Toasts 40, Offer 50). HudLayout writes only
	obj.Position.Y (X stays yours: use (0.5, 0) + AnchorPoint X 0.5). Hidden items collapse. Re-runs when an
	item's Visible / AbsoluteSize / parent / its gui's Enabled change, and on LayoutChanged.
	opts.Space ("Hud" = inside a MobileScale gui, "Screen" = real px gui like WE_MissileAlert) is accepted for
	clarity; the math reads the parent chain's actual UIScales and AbsolutePosition, so either works.
	obj must not be inside a UIListLayout / UIGridLayout (the layout would own its Position).
]]
function HudLayout.RegisterTopStack(name: string, obj: GuiObject, order: number, opts: StackOpts?)
	HudLayout.UnregisterTopStack(name)
	stackSeq += 1
	local it: StackItem = {
		Name = name,
		Obj = obj,
		Order = order,
		Seq = stackSeq,
		Space = (opts and opts.Space) or "Hud",
		Conns = {},
	}
	stack[name] = it
	local gui: LayerCollector? = nil
	local guiConn: RBXScriptConnection? = nil
	local function watchGui()
		local g = obj:FindFirstAncestorWhichIsA("LayerCollector")
		if g == gui then
			return
		end
		if guiConn then
			guiConn:Disconnect()
			guiConn = nil
		end
		gui = g
		if g then
			guiConn = g:GetPropertyChangedSignal("Enabled"):Connect(queueStack)
		end
	end
	table.insert(it.Conns, obj:GetPropertyChangedSignal("Visible"):Connect(queueStack))
	table.insert(it.Conns, obj:GetPropertyChangedSignal("AbsoluteSize"):Connect(queueStack))
	table.insert(it.Conns, obj.AncestryChanged:Connect(function()
		watchGui()
		queueStack()
	end))
	watchGui()
	-- disconnect the gui watcher together with the item
	table.insert(it.Conns, {
		Disconnect = function()
			if guiConn then
				guiConn:Disconnect()
				guiConn = nil
			end
		end,
	} :: any)
	HudLayout.RelayoutTopStack()
end

--[[ Widest an item in the stack may be, in v (HudConfig.TopStack.MaxWidthScale × content width). ]]
function HudLayout.TopStackMaxWidthV(): number
	local _, _, w = contentRect()
	return HudConfig.TopStack.MaxWidthScale * w / HudLayout.Scale()
end

---------------------------------------------------------------------------------------------------------------
-- panels (one open at a time → Modal flag)
---------------------------------------------------------------------------------------------------------------

type Panel = { IsOpen: () -> boolean, Close: () -> (), Fallback: boolean, NonModal: boolean }
-- NonModal (the Army popover, mobile plan P1-6): still one-open-at-a-time with the other panels, but it does NOT
-- raise the Modal flag, so FIRE / the hotbar / the prompt lane stay up while it is open
export type PanelOpts = { Fallback: boolean?, NonModal: boolean? }
local panels: { [string]: Panel } = {}
local openPanels: { [string]: boolean } = {}
local lastOpened: string? = nil
local closingOthers = false
local panelSerial = 0

-- should PanelOpened(other) / CloseAllPanels close `id`? A Fallback registration (UIController's stand-in for a
-- panel that did not register itself) counts only while the registry lists it open, so a stand-in filed under a
-- different id than the panel's own registration can never close the panel that just opened.
local function panelReportsOpen(id: string): boolean
	local p = panels[id]
	if p and p.Fallback and not openPanels[id] then
		return false
	end
	if p then
		local ok, r = pcall(p.IsOpen)
		if ok then
			return r == true
		end
	end
	return false
end

local function refreshModal()
	local modal = false
	for id in pairs(openPanels) do
		local p = panels[id]
		if not (p and p.NonModal) then
			modal = true
			break
		end
	end
	HudLayout.SetFlag("Modal", modal)
end

--[[ Register once in Init. isOpen: is the panel showing now; close: hide it (it should call PanelClosed).
	opts.Fallback (UIController only): a stand-in registration; a real RegisterPanel for the same id replaces it
	and it is never closed on isOpen() alone (see panelReportsOpen). ]]
function HudLayout.RegisterPanel(id: string, isOpen: () -> boolean, close: () -> (), opts: PanelOpts?)
	local fallback = opts ~= nil and opts.Fallback == true
	local cur = panels[id]
	if fallback and cur and not cur.Fallback then
		return -- the panel registered itself: keep that
	end
	local nonModal = if opts ~= nil and opts.NonModal ~= nil then opts.NonModal == true else (cur ~= nil and cur.NonModal)
	panels[id] = { IsOpen = isOpen, Close = close, Fallback = fallback, NonModal = nonModal }
	refreshModal()
end

--[[ Increments on every PanelOpened / PanelClosed call. UIController compares it around an opener to tell
	whether the panel reported itself (then it does nothing) or needs the fallback sync. ]]
function HudLayout.PanelSerial(): number
	return panelSerial
end

--[[ true once RegisterPanel(id, ...) ran (UIController registers the panels a controller did not register itself). ]]
function HudLayout.HasPanel(id: string): boolean
	return panels[id] ~= nil
end

--[[ Call from the panel's setOpen(true). Closes every other open panel (HudConfig.Context.ModalExclusive). ]]
function HudLayout.PanelOpened(id: string)
	panelSerial += 1
	local was = openPanels[id] == true
	openPanels[id] = true
	lastOpened = id
	if HudConfig.Context.ModalExclusive ~= false and not closingOthers then
		closingOthers = true
		for otherId, p in pairs(panels) do
			if otherId ~= id and (openPanels[otherId] or panelReportsOpen(otherId)) then
				local ok, err = pcall(function(): string?
					p.Close()
					return nil
				end)
				if not ok then
					warn("[HudLayout] closing panel", otherId, "failed:", err)
				end
				if openPanels[otherId] then
					openPanels[otherId] = nil
					firePanel(otherId, false)
				end
			end
		end
		closingOthers = false
	end
	refreshModal()
	if not was then
		firePanel(id, true)
	end
end

--[[ Call from the panel's setOpen(false) / close path. ]]
function HudLayout.PanelClosed(id: string)
	panelSerial += 1
	local was = openPanels[id] == true
	openPanels[id] = nil
	if lastOpened == id then
		lastOpened = next(openPanels)
	end
	refreshModal()
	if was then
		firePanel(id, false)
	end
end

function HudLayout.IsPanelOpen(id: string): boolean
	return openPanels[id] == true
end

function HudLayout.OpenPanelId(): string?
	if lastOpened and openPanels[lastOpened] then
		return lastOpened
	end
	return next(openPanels)
end

--[[ Close every open registered panel (Escape, tapping the dim, death...). ]]
function HudLayout.CloseAllPanels()
	for id, p in pairs(panels) do
		if openPanels[id] or panelReportsOpen(id) then
			local ok, err = pcall(function(): string?
				p.Close()
				return nil
			end)
			if not ok then
				warn("[HudLayout] closing panel", id, "failed:", err)
			end
			HudLayout.PanelClosed(id)
		end
	end
end

-- Safety net: a REGISTERED panel whose isOpen() says closed while the registry still lists it open (a close path
-- that forgot PanelClosed — e.g. the panel's own X button) would leave Modal on, and Modal hides the hotbar, the
-- prompt lane and BUY. Two sweeps in a row (~1 s) clear it.
local STALE_SWEEP_SECONDS = 0.5
local staleSweeps: { [string]: number } = {}
local function sweepStalePanels()
	local stale: { string } = {}
	for id in pairs(openPanels) do
		if panels[id] and not panelReportsOpen(id) then
			local n = (staleSweeps[id] or 0) + 1
			staleSweeps[id] = n
			if n >= 2 then
				table.insert(stale, id)
			end
		else
			staleSweeps[id] = nil
		end
	end
	for id in pairs(staleSweeps) do
		if not openPanels[id] then
			staleSweeps[id] = nil
		end
	end
	for _, id in ipairs(stale) do
		staleSweeps[id] = nil
		HudLayout.PanelClosed(id)
	end
end

---------------------------------------------------------------------------------------------------------------
-- rail badges, cash float, named rects, reserved regions, action lane
---------------------------------------------------------------------------------------------------------------

local badges: { [string]: string? } = {}

--[[ Rail tile badge: "!" (gold ready style), a count ("3"), or nil / "" / "0" to clear. HUDController draws
	it (BadgeChanged); anyone may set it, before or after the HUD exists (GetBadge replays the state). ]]
function HudLayout.SetBadge(tileId: string, text: string?)
	local t: string? = text
	if t == "" or t == "0" then
		t = nil
	end
	if badges[tileId] == t then
		return
	end
	badges[tileId] = t
	fireBadge(tileId, t)
end

function HudLayout.GetBadge(tileId: string): string?
	return badges[tileId]
end

--[[ "+$141" at the cash pill (negative = spend float). Merging / rate limits are HUDController's (HudConfig.CashFloat). ]]
function HudLayout.CashFloat(amount: number)
	if typeof(amount) ~= "number" or amount ~= amount or amount == 0 or math.abs(amount) == math.huge then
		return
	end
	fireCash(amount)
end

local rects: { [string]: GuiObject } = {}

--[[ Publish a HUD piece's rect under a name ("Rail", "CashPill", "Hotbar", "ActionLane", "Compass", "ArmyTile"...). ]]
function HudLayout.SetRect(name: string, obj: GuiObject)
	rects[name] = obj
end

--[[ (AbsolutePosition, AbsoluteSize) of the named piece; zeros when unknown or not parented. ]]
function HudLayout.GetRect(name: string): (Vector2, Vector2)
	local obj = rects[name]
	if obj and obj.Parent then
		return obj.AbsolutePosition, obj.AbsoluteSize
	end
	return Vector2.zero, Vector2.zero
end

--[[
	Reserved bottom-right rect in real px (AbsolutePosition space): "CombatTouch", "CombatDesktop", or "Combat"
	(= the one for this device). Width/Height v × Scale(), floored by MinWidthPx/MinHeightPx so it always holds
	VehicleDriveClient's ▲▼ column. 844x390: x ≥ 594, y ≥ 168. 1280x720: x ≥ 974, y ≥ 585.
]]
function HudLayout.Reserve(name: string): Rect
	local key = name
	if key == "Combat" then
		key = if HudLayout.IsTouch() then "CombatTouch" else "CombatDesktop"
	end
	local r = (HudConfig.Reserve :: any)[key]
	if type(r) ~= "table" or type(r.Width) ~= "number" or type(r.Height) ~= "number" then
		warnOnce("reserve:" .. name, "unknown reserve", name)
		return Rect.new(0, 0, 0, 0)
	end
	local cx, cy, cw, ch = contentRect()
	local s = HudLayout.Scale()
	local w = math.min(cw, math.max(r.Width * s, tonumber(r.MinWidthPx) or 0))
	local h = math.min(ch, math.max(r.Height * s, tonumber(r.MinHeightPx) or 0))
	return Rect.new(cx + cw - w, cy + ch - h, cx + cw, cy + ch)
end

--[[ Bottom edge of the action lane (prompt pills, BUY), in v above the content bottom: 100 touch / 86 desktop. ]]
function HudLayout.ActionLaneBottomV(): number
	local slot = if HudLayout.IsTouch() then HudConfig.Hotbar.Slot else HudConfig.Hotbar.SlotDesktop
	return HudConfig.Hotbar.Bottom + slot + HudConfig.Health.GapAboveHotbar + HudConfig.Health.Height + HudConfig.ActionLane.Gap
end

--[[ Fire one of HudLayout.Signals (e.g. Emit("CompassTapped") from CompassController). ]]
function HudLayout.Emit(signalName: string, ...: any)
	local f = emitters[signalName]
	if f then
		f(...)
	else
		warnOnce("emit:" .. signalName, "unknown signal", signalName)
	end
end

--[[ Studio + touch only: warn when a tappable renders under HudConfig.Scale.TouchMinPx real px. ]]
function HudLayout.AssertTouchTarget(obj: GuiObject, label: string?)
	if not (RunService:IsStudio() and HudLayout.IsTouch()) then
		return
	end
	task.defer(function()
		local sz = obj.AbsoluteSize
		local minPx = HudConfig.Scale.TouchMinPx
		if obj.Parent and (sz.X < minPx - 0.5 or sz.Y < minPx - 0.5) then
			warn(string.format("[HudLayout] touch target %s is %.0fx%.0f px (< %d)", label or obj:GetFullName(), sz.X, sz.Y, minPx))
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- viewport / camera / topbar / character watchers
---------------------------------------------------------------------------------------------------------------

local layoutQueued = false

onLayoutChanged = function()
	local s = HudLayout.Scale()
	for sc in pairs(trackedScales) do
		if sc.Parent then
			if sc.Scale ~= s then
				sc.Scale = s
			end
		else
			trackedScales[sc] = nil
		end
	end
	for screen, f in pairs(topbarAreas) do
		if f.Parent == screen then
			placeTopbarArea(screen, f)
		else
			topbarAreas[screen] = nil
		end
	end
	queueStack()
	if not layoutQueued then
		layoutQueued = true
		task.defer(function()
			layoutQueued = false
			fireLayout()
		end)
	end
end

local camConn: RBXScriptConnection? = nil
local function bindCamera()
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
	local cam = Workspace.CurrentCamera
	if cam then
		camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(onLayoutChanged)
	end
	onLayoutChanged()
end

local humConns: { RBXScriptConnection } = {}
local function clearHumanoid()
	for _, c in ipairs(humConns) do
		c:Disconnect()
	end
	table.clear(humConns)
end

local function drivingSeat(seat: Instance?): boolean
	return seat ~= nil and seat:IsA("VehicleSeat")
end

local function bindHumanoid(hum: Humanoid)
	HudLayout.SetFlag("Dead", hum.Health <= 0)
	HudLayout.SetFlag("Driving", drivingSeat(hum.SeatPart))
	table.insert(humConns, hum.Died:Connect(function()
		HudLayout.SetFlag("Dead", true)
		HudLayout.SetFlag("Driving", false)
	end))
	table.insert(humConns, hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
		HudLayout.SetFlag("Driving", drivingSeat(hum.SeatPart))
	end))
end

local function bindCharacter(char: Model)
	clearHumanoid()
	HudLayout.SetFlag("Dead", false)
	HudLayout.SetFlag("Driving", false)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		bindHumanoid(hum)
		return
	end
	local conn: RBXScriptConnection? = nil
	conn = char.ChildAdded:Connect(function(c: Instance)
		if c:IsA("Humanoid") then
			if conn then
				conn:Disconnect()
			end
			bindHumanoid(c)
		end
	end)
	if conn then
		table.insert(humConns, conn)
	end
end

local started = false
local playerBound = false

local function bindPlayer()
	if playerBound then
		return
	end
	local lp = Players.LocalPlayer
	if not lp then
		return
	end
	playerBound = true
	lp.CharacterAdded:Connect(bindCharacter)
	lp.CharacterRemoving:Connect(function()
		clearHumanoid()
		HudLayout.SetFlag("Driving", false)
	end)
	if lp.Character then
		bindCharacter(lp.Character)
	end
end

--[[ Idempotent; also runs on require. Safe to call from any controller's Init. Never yields. ]]
function HudLayout.Init()
	bindPlayer()
	if started then
		return
	end
	started = true
	local ok, err = pcall(function()
		Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
		bindCamera()
	end)
	if not ok then
		warnOnce("camera", "camera watch failed:", err)
	end
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(onLayoutChanged)
	end)
	-- key hints follow the device the player is using now (PreferredInput; LastInputType as the fallback)
	checkInputMode()
	pcall(function()
		UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(checkInputMode)
	end)
	pcall(function()
		UserInputService.LastInputTypeChanged:Connect(function()
			if readPreferredInput() == nil then
				checkInputMode()
			end
		end)
	end)
	pcall(function()
		local acc = 0
		RunService.Heartbeat:Connect(function(dt: number)
			acc += dt
			if acc >= STALE_SWEEP_SECONDS then
				acc = 0
				sweepStalePanels()
			end
		end)
	end)
end

-- test hook (headless harness): force the touch / desktop layout; nil = use the device
function HudLayout._SetTouchOverride(value: boolean?)
	touchOverride = value
	onLayoutChanged()
end

-- test hook (headless harness): force key hints on / off; nil = use the device
function HudLayout._SetKeyPrefOverride(value: boolean?)
	keyPrefOverride = value
	checkInputMode()
end

HudLayout.Init()

return HudLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="179">
            <Properties>
              <string name="Name">PanelShell</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PanelShell — v70 "clean screen" chrome for the full-screen panels and the Army popover (spec §3.8).
	Used by Shop, Rebirth (Progression), Missions, Army, Garage, Settings, Base and the Army popover (Orders).

	  PanelShell.Screen(screen, displayOrder?)   HudLayout.ApplyScreen: Core safe insets + the ONE HUD UIScale
	                                             ("MobileScale", S = 0.70 on phones … 1.15 at 1080p)
	  PanelShell.Attach({Id, Screen, Panel, IsOpen, Close, Dim?, TapCloses?, NonModal?}) -> Shell
	      * HudLayout.RegisterPanel(Id, IsOpen, Close): one panel open at a time → the Modal flag
	      * the black dim behind the panel (UIUtil.MakeModalDim, HudConfig.Context.ModalDim; Active = false).
	        It covers the whole screen width of the gui plus the Roblox topbar row, so the HUD (rail, pill,
	        TopStrip) stays visible but dimmed under the panel. On touch a tap outside the panel closes it.
	      * Dim = false → an invisible tap-catcher instead (the Army popover).
	      * NonModal = true → exclusive with the other panels but no Modal flag (FIRE / hotbar stay up: the popover)
	  shell.Sync(open)        call from the panel's setOpen: dim visibility + HudLayout.PanelOpened / PanelClosed
	  shell.TapThrough()      true for a moment after the dim closed the panel: the same tap then lands on the rail
	                          tile that toggles it, and Toggle must not re-open it
	  PanelShell.Tap(v)       a touch target in v: ≥ TouchMinV() (64 v = 44.8 real px at the phone scale 0.70)
	  PanelShell.Text(v)      a text size in v: ≥ 20 v on touch (14 real px, HudConfig.Scale.MinTextPx) / 16 v on desktop
	  PanelShell.CloseButton(parent, onClose)    ✕ from HudIcons "Close"; 64 v hit on touch, 44 v on desktop

	Nothing here touches a purchase path.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = require(script.Parent.HudLayout)
local HudIcons = require(script.Parent.HudIcons)

local PanelShell = {}

-- 64 v: the rail tile / hotbar slot size, = HudConfig.Scale.TouchMinPx (44) / Scale.Min (0.70) rounded up
local TOUCH_MIN_V = math.max(HudConfig.Hotbar.Slot, math.ceil(HudConfig.Scale.TouchMinPx / HudConfig.Scale.Min))
local DESKTOP_MIN_V = 44
local TEXT_MIN_TOUCH = math.ceil(HudConfig.Scale.MinTextPx / HudConfig.Scale.Min - 1e-6) -- 20 v = 14 px on phones
local TEXT_MIN_DESKTOP = 16 -- 14.4 px at 720p (S 0.90)
local TAP_THROUGH_SECONDS = 0.45

PanelShell.Colors = {
	Panel = Color3.fromRGB(24, 27, 31),
	PanelStroke = Color3.fromRGB(70, 78, 70),
	Row = Color3.fromRGB(34, 38, 44),
	CloseFace = Color3.fromRGB(44, 48, 54),
	Title = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 196, 204),
}

export type Shell = {
	Id: string,
	Dim: Frame,
	Sync: (open: boolean) -> (),
	TapThrough: () -> boolean,
	Refit: () -> (),
}

export type AttachOpts = {
	Id: string, -- HudLayout panel id ("Shop", "Rebirth", "Missions", "Army", "Orders", "Garage", "Settings", "Base")
	Screen: ScreenGui,
	Panel: GuiObject?, -- taps inside it never close the panel
	IsOpen: () -> boolean,
	Close: () -> (),
	Dim: boolean?, -- default true; false = invisible tap-catcher (popover)
	TapCloses: boolean?, -- default: touch only (spec §3.8)
	NonModal: boolean?, -- default false; true = no Modal flag while open (HudLayout.RegisterPanel NonModal)
}

function PanelShell.IsTouch(): boolean
	return HudLayout.IsTouch()
end

function PanelShell.TouchMinV(): number
	return if HudLayout.IsTouch() then TOUCH_MIN_V else DESKTOP_MIN_V
end

--[[ A tappable's size in v: at least TouchMinV(). ]]
function PanelShell.Tap(v: number): number
	return math.max(v, PanelShell.TouchMinV())
end

--[[ A text size in v that renders ≥ HudConfig.Scale.MinTextPx (14) real px at the smallest HUD scale on touch
	(20 v at 0.70) and on a 720p desktop (16 v at 0.90). ]]
function PanelShell.Text(v: number): number
	return math.max(v, if HudLayout.IsTouch() then TEXT_MIN_TOUCH else TEXT_MIN_DESKTOP)
end

--[[ The only way a panel ScreenGui is set up (HudLayout.ApplyScreen, Core insets, DisplayOrder Panels = 60). ]]
function PanelShell.Screen(screen: ScreenGui, displayOrder: number?): UIScale?
	return HudLayout.ApplyScreen(screen, {
		DisplayOrder = displayOrder or HudConfig.DisplayOrder.Panels,
		Insets = "Core",
	})
end

-- the dim covers the gui's safe area plus the Roblox topbar row above it (the notch bands are clipped by
-- ClipToDeviceSafeArea anyway). Offsets are in v (the gui's UIScale), Scale parts track the real screen.
local function fitDim(screen: ScreenGui, dim: Frame)
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.zero
	local abs = screen.AbsoluteSize
	if vp.Y < 2 or abs.Y < 2 then
		return -- not laid out yet: keep MakeModalDim's oversize
	end
	local s = HudLayout.Scale()
	if s <= 0 then
		s = 1
	end
	local top = math.max(0, vp.Y - abs.Y) / s
	dim.AnchorPoint = Vector2.zero
	dim.Position = UDim2.fromOffset(0, -top)
	dim.Size = UDim2.new(1, 0, 1, top)
end

--[[ Register the panel with HudLayout and add its dim. Call once in Init, after the ScreenGui is parented. ]]
function PanelShell.Attach(o: AttachOpts): Shell
	local closedByTapAt = -math.huge
	local dim = UIUtil.MakeModalDim(o.Screen, function()
		local closes = if o.TapCloses == nil then HudLayout.IsTouch() else o.TapCloses == true
		if not closes then
			return
		end
		local ok, open = pcall(o.IsOpen)
		if not (ok and open == true) then
			return
		end
		closedByTapAt = os.clock()
		o.Close()
	end, o.Panel)
	dim.Visible = false
	if o.Dim == false then
		dim.BackgroundTransparency = 1
	end
	local function refit()
		fitDim(o.Screen, dim)
	end
	refit()
	HudLayout.LayoutChanged:Connect(refit)
	o.Screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)

	HudLayout.RegisterPanel(o.Id, o.IsOpen, o.Close, { NonModal = o.NonModal == true })

	local shell: Shell = {
		Id = o.Id,
		Dim = dim,
		Sync = function(open: boolean)
			dim.Visible = open
			if open then
				refit()
				HudLayout.PanelOpened(o.Id)
			else
				HudLayout.PanelClosed(o.Id)
			end
		end,
		TapThrough = function(): boolean
			return os.clock() - closedByTapAt < TAP_THROUGH_SECONDS
		end,
		Refit = refit,
	}
	return shell
end

export type CloseOpts = {
	Position: UDim2?,
	AnchorPoint: Vector2?,
	ZIndex: number?,
	Face: Color3?,
}

--[[ ✕ close button: a transparent TouchMinV() square hit area around a rounded face with the HudIcons "Close".
	Default placement: the parent's top-right corner (AnchorPoint (1, 0), Position (1, -4, 0, 4)). ]]
function PanelShell.CloseButton(parent: Instance, onClose: () -> (), opts: CloseOpts?): TextButton
	local o: CloseOpts = opts or {}
	local hit = PanelShell.TouchMinV()
	local z = o.ZIndex or 5
	local btn = Instance.new("TextButton")
	btn.Name = "Close"
	btn.AnchorPoint = o.AnchorPoint or Vector2.new(1, 0)
	btn.Position = o.Position or UDim2.new(1, -4, 0, 4)
	btn.Size = UDim2.fromOffset(hit, hit)
	btn.BackgroundTransparency = 1
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.Active = true
	btn.ZIndex = z
	local faceColor = o.Face or PanelShell.Colors.CloseFace
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromScale(0.66, 0.66)
	face.BackgroundColor3 = faceColor
	face.BorderSizePixel = 0
	face.Active = false
	face.ZIndex = z
	face.Parent = btn
	UIUtil.Corner(face, 10)
	local st = UIUtil.Stroke(face, Color3.fromRGB(255, 255, 255), 1.5)
	st.Transparency = 0.7
	HudIcons.Make("Close", face, {
		Size = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = z + 1,
		Color = Color3.fromRGB(255, 255, 255),
		Fill = faceColor,
	})
	btn.Activated:Connect(onClose)
	btn.Parent = parent
	return btn
end

--[[ Title label in the HUD's display font (FredokaOne) with the Ink outline. ]]
function PanelShell.Title(parent: Instance, text: string, size: number?): TextLabel
	local ts = PanelShell.Text(size or 24)
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.BackgroundTransparency = 1
	t.Font = HudConfig.Fonts.Display
	t.TextSize = ts
	t.TextColor3 = PanelShell.Colors.Title
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Text = text
	t.Size = UDim2.new(1, -(PanelShell.TouchMinV() + 24), 0, ts + 8)
	t.Position = UDim2.fromOffset(16, 10)
	t.Parent = parent
	UIUtil.TextOutline(t, 1.5)
	return t
end

return PanelShell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="180">
            <Properties>
              <string name="Name">ProgressPill</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ProgressPill — the v70 top-centre stack "Progress" component (spec §3.4 item 2), shared by every hold / capture
	bar so they all look the same: one dark pill (HudConfig.TopStack.Progress: 320×44 v), GothamBold title on the
	left, FredokaOne value on the right ("62%", "4m"), an 8 v bar along the bottom.

	Users: TerritoryController (capture — land outposts and the v70 naval outposts alike), BankRaidController (vault
	hold). ShopController's ATM raid hold can use it as well.

	  local pill = ProgressPill.Build(screen, "CaptureProgress")          -- Visible = false, centred on X
	  HudLayout.RegisterTopStack("Capture", pill.Frame, HudConfig.TopStack.Order.Progress, { Space = "Hud" })
	  pill.Title.Text = "CAPTURING RADAR HILL"; pill.Value.Text = "62%"; ProgressPill.SetFraction(pill, 0.62)

	The caller owns Visible (or hands it to HudLayout.BindVisibility) and every colour change; HudLayout owns the
	Frame's Position.Y. Sizes are v (the parent gui carries HudLayout's "MobileScale" UIScale).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local ProgressPill = {}

export type Pill = {
	Frame: Frame,
	Title: TextLabel,
	Value: TextLabel,
	Track: Frame,
	Fill: Frame,
	Stroke: UIStroke,
}

local CFG = HudConfig.TopStack.Progress
local PAD_X = 12 -- v, title / value / bar inset from the pill's sides
local PAD_TOP = 4 -- v above the title row
local PAD_BOTTOM = 7 -- v under the bar
local VALUE_W = 56 -- v, "100%" / "10m" in the value font
local CORNER = 12

ProgressPill.Colors = {
	Fill = HudConfig.Colors.Positive, -- normal progress (green)
	Contested = CFG.ContestedColor, -- amber: someone else is in the zone
	Warn = HudConfig.Colors.Negative, -- under fire
	Idle = Color3.fromRGB(120, 128, 138), -- cooldown / paused
	Title = HudConfig.Colors.White,
	Value = HudConfig.Colors.Gold,
	Stroke = HudConfig.Colors.PillStroke,
	StrokeTransparency = 0.5,
	Track = Color3.fromRGB(255, 255, 255),
	TrackTransparency = 0.82,
}

--[[ One pill, parented to `parent` (a HUD ScreenGui set up with HudLayout.ApplyScreen). Starts hidden. ]]
function ProgressPill.Build(parent: Instance, name: string): Pill
	local size = CFG.Size
	local textSize = CFG.TextSize

	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top) -- Y is rewritten by HudLayout's top stack
	f.Size = UDim2.fromOffset(size.X, size.Y)
	f.BackgroundColor3 = HudConfig.Colors.PillBg
	f.BackgroundTransparency = HudConfig.Colors.PillBgTransparency
	f.BorderSizePixel = 0
	f.Active = false
	f.Visible = false
	f.ZIndex = 2
	UIUtil.Corner(f, CORNER)
	local stroke = UIUtil.Stroke(f, ProgressPill.Colors.Stroke, 2)
	stroke.Transparency = ProgressPill.Colors.StrokeTransparency

	local rowH = textSize + 4
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(PAD_X, PAD_TOP)
	title.Size = UDim2.new(1, -(PAD_X * 2 + VALUE_W), 0, rowH)
	title.Font = HudConfig.Fonts.Body
	title.TextSize = textSize
	title.TextColor3 = ProgressPill.Colors.Title
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = ""
	title.ZIndex = 3
	title.Parent = f

	local value = Instance.new("TextLabel")
	value.Name = "Value"
	value.BackgroundTransparency = 1
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, -PAD_X, 0, PAD_TOP)
	value.Size = UDim2.fromOffset(VALUE_W, rowH)
	value.Font = HudConfig.Fonts.Display
	value.TextSize = textSize + 2
	value.TextColor3 = ProgressPill.Colors.Value
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextYAlignment = Enum.TextYAlignment.Center
	value.Text = "0%"
	value.ZIndex = 3
	value.Parent = f

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0, 1)
	track.Position = UDim2.new(0, PAD_X, 1, -PAD_BOTTOM)
	track.Size = UDim2.new(1, -PAD_X * 2, 0, CFG.BarH)
	track.BackgroundColor3 = ProgressPill.Colors.Track
	track.BackgroundTransparency = ProgressPill.Colors.TrackTransparency
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = 3
	track.Parent = f
	UIUtil.Corner(track, math.ceil(CFG.BarH / 2))

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = ProgressPill.Colors.Fill
	fill.BorderSizePixel = 0
	fill.ZIndex = 4
	fill.Parent = track
	UIUtil.Corner(fill, math.ceil(CFG.BarH / 2))

	f.Parent = parent
	return {
		Frame = f,
		Title = title,
		Value = value,
		Track = track,
		Fill = fill,
		Stroke = stroke,
	}
end

--[[ Bar fill 0..1 (NaN / nil → 0). ]]
function ProgressPill.SetFraction(pill: Pill, fraction: number?)
	local f = tonumber(fraction) or 0
	if f ~= f then
		f = 0
	end
	pill.Fill.Size = UDim2.fromScale(math.clamp(f, 0, 1), 1)
end

--[[ "62%" from a 0..1 fraction (floored, like the server's capture %). ]]
function ProgressPill.Percent(fraction: number?): string
	local f = tonumber(fraction) or 0
	if f ~= f then
		f = 0
	end
	return string.format("%d%%", math.floor(math.clamp(f, 0, 1) * 100))
end

--[[ Normal look (stroke back to the dark default). ]]
function ProgressPill.ResetStroke(pill: Pill)
	pill.Stroke.Color = ProgressPill.Colors.Stroke
	pill.Stroke.Transparency = ProgressPill.Colors.StrokeTransparency
end

--[[ Coloured edge (contested amber, under-fire red …). ]]
function ProgressPill.AccentStroke(pill: Pill, color: Color3)
	pill.Stroke.Color = color
	pill.Stroke.Transparency = 0
end

return ProgressPill
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="181">
            <Properties>
              <string name="Name">StudioSmokeClient</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Studio-only: listen for StudioSmokeLog RemoteEvent and print loud [SMOKE] lines
	in the *client* Output window (Play Solo). Server prints alone can be easy to miss
	when the Output filter is set to Client.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StudioSmokeClient = {}

function StudioSmokeClient.Init()
	if not RunService:IsStudio() then
		return
	end

	task.spawn(function()
		local Shared = ReplicatedStorage:WaitForChild("Shared", 30)
		if not Shared then
			return
		end
		local okC, Constants = pcall(function()
			return require(Shared.Constants)
		end)
		local okR, Remotes = pcall(function()
			return require(Shared.Remotes)
		end)
		if not (okC and okR and Constants and Remotes) then
			warn("[SMOKE] client listener: Constants/Remotes require failed")
			return
		end
		local name = Constants.RemoteNames and Constants.RemoteNames.StudioSmokeLog
		if typeof(name) ~= "string" then
			return
		end
		local okEv, ev = pcall(function()
			return Remotes.GetEvent(name)
		end)
		if not okEv or not ev then
			warn("[SMOKE] client listener: StudioSmokeLog remote missing")
			return
		end

		print("[SMOKE] client listener armed — will echo StudioSmokeLog here")
		ev.OnClientEvent:Connect(function(kind: any, line: any, _t: any)
			local text = if typeof(line) == "string" then line else string.format("[SMOKE] BUY %s", tostring(kind))
			print("========== CLIENT " .. text .. " ==========")
			print(text)
			if tostring(kind) == "FAIL" then
				warn(text)
			elseif tostring(kind) == "OK" then
				print("[SMOKE] ★★★ CLIENT SAW BUY OK ★★★")
			end
		end)
	end)
end

return StudioSmokeClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="182">
            <Properties>
              <string name="Name">VehicleDriveClient</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v70: client half of drivable vehicles (cars, helicopters, planes, boats).

	The driver's client owns the vehicle's physics. Every frame this module turns the seat input
	(DriverSeat.ThrottleFloat/SteerFloat + the extra lift/strafe keys) into a target velocity and
	orientation, and writes them to the two movers the server built on the Chassis:
	  WE_DriveLV (LinearVelocity, PerAxis)  -> VectorVelocity + the Y part of MaxAxesForce
	  WE_DriveAO (AlignOrientation)         -> CFrame (rotation only)
	It writes only while the model's WE_DriveAuthority == "Client". The server checks the result
	(speed, altitude, teleports, map bounds, boats over WE_Water) and takes ownership back on a violation.
	No positions or velocities are ever sent to the server. The only remote is VehicleDriveInput:
	  {K="Hello", V, P}            once per sit (+ retries) → the server hands the physics to this client
	  {K="Bye", V}                 leaving the seat
	  {K="In", V, T, S, L}         jeep fix F4b: the composed input, 2 decimals, Drive.Watchdog.StreamHz while any
	                               axis is non-zero + one zero message on release (feeds the server-driven fallback)
	  {K="Stuck", V, T, Spd, R, Src}  F4c: once per sit, throttle held 1.5 s under Client authority, speed < 1
	  {K="Exit", V}                F4d: jump button / Space (JumpRequest), the EXIT hold pill, F — the server ejects
	Every value is clamped to [-1, 1] on the server again; a client can only downgrade its own car to server driving.

	Laws (NewState / Step / ComposeInput / ControlsLayout / WaterSurfaceAt / ProbeDistances / BuildParams)
	are pure and are tested headless. The server's fallback + idle laws are a copy of the Car/Boat maths.

	Requiring this module does nothing heavy (GetService only). Init() is called by VehicleController.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local VehicleDriveClient = {}

export type Input = { Throttle: number, Steer: number, Lift: number, Strafe: number }

export type RawInput = {
	Throttle: number,
	Steer: number,
	Up: boolean?, -- Space
	Down: boolean?, -- LeftCtrl / C
	TouchUp: boolean?, -- mobile ▲
	TouchDown: boolean?, -- mobile ▼
	R2: number?, -- gamepad analog 0..1
	L2: number?,
	Left: boolean?, -- Z / L1 (strafe left)
	Right: boolean?, -- X / R1 (strafe right)
}

export type Sense = {
	Position: Vector3,
	Velocity: Vector3,
	Yaw: number,
	UpY: number,
	AGL: number, -- lowest solid point to the ground below; math.huge when nothing is below
	Time: number,
	Look: Vector3?, -- chassis LookVector (defaults to the flat heading)
	WaterY: number?,
	WaterNear: boolean?,
	WaterFar: boolean?,
}

export type Hud = { Speed: number, Alt: number?, Throttle: number?, Tag: string? }

export type Out = { Velocity: Vector3, HoldVertical: boolean, Orientation: CFrame, Hud: Hud }

export type Params = {
	Mode: string,
	MaxSpeed: number,
	Accel: number,
	TurnRate: number,
	Tracked: boolean,
	ClimbRate: number,
	MaxAltitude: number,
	Vto: number,
	Vstall: number,
	RideOffset: number,
	Clearance: number,
	HalfLength: number,
	HalfWidth: number,
	SpawnState: string?,
	SpawnSpeed: number,
	SoftBound: number,
	AutoTakeoff: boolean,
	C: { [string]: number },
}

export type State = {
	Mode: string,
	Age: number,
	Heading: number,
	LagFor: number,
	-- car / boat
	Speed: number,
	FlipFor: number,
	HopLeft: number,
	-- heli
	Fwd: number,
	Side: number,
	Vy: number,
	YawRate: number,
	HoldY: number?,
	Landed: boolean,
	Roll: number,
	-- plane (Pitch is shared with heli)
	Pitch: number,
	Lever: number,
	Airspeed: number,
	Airborne: boolean,
	ClimbOut: boolean,
	Stalled: boolean,
	Bank: number,
	-- boat
	BobT: number,
	LastWaterPos: Vector3?,
	LastWaterY: number?,
}

export type Rect = { Pos: Vector2, Size: Vector2 }
export type Layout = { Up: Rect, Down: Rect, Exit: Rect, Where: string }

-- ─────────────────────────────────────────────────────────────────────────────
-- Defaults (spec section 2). VehicleConfig.Drive overrides any of these when present.
-- ─────────────────────────────────────────────────────────────────────────────
local PROTOCOL_VERSION = 1

local DEFAULTS: any = {
	ProtocolVersion = PROTOCOL_VERSION,
	HelloTimeoutSeconds = 2.5,
	World = { SoftBound = 3300 },
	Resync = { Gap = 10, CarGap = 6, Seconds = 0.3, GraceSeconds = 1 },
	Water = { RefreshSeconds = 2, QueryBelow = 8, QueryAbove = 20, LandProbeHeight = 30 },
	-- jeep fix (fix_spec §1.2). VehicleConfig.Drive.Watchdog / .Debug override these key by key.
	Watchdog = { StreamHz = 10 },
	-- Debug: nobody unless VehicleConfig.Drive.Debug names them (the on-device NO DRIVE line is config-gated)
	Debug = { UserIds = {}, All = false, NoDriveSeconds = 1.0, NoDriveSpeed = 1.0, ShowSeconds = 6 },
	-- mobile P1-7: EXIT pill + airborne jump lock (VehicleConfig.Drive.Exit overrides)
	Exit = {
		HoldSeconds = 0.5, -- the EXIT pill fires after this long held
		LockAGL = 8, -- Heli/Plane higher than this above the ground: local JumpHeight 0 (the touch jump button hides)
		UnlockAGL = 7, -- ... and back below this (hysteresis: the jump button does not flicker at 8)
		RequestGapSeconds = 0.3, -- at most one {K="Exit"} per this long
		StuckSeconds = 1.5, -- F4c: throttle held this long under Client authority at speed < StuckSpeed → one Stuck report
		StuckSpeed = 1.0,
	},
	-- mobile P1-8: client-side owner nameplate (VehicleConfig.Drive.Nameplate overrides)
	Nameplate = { MaxDistance = 36, WidthStuds = 2, HeightStuds = 0.4, HeightPx = 20, MinText = 14, MaxText = 20 },
	Modes = {
		Car = {
			ReverseFrac = 0.45,
			ReverseAccelFrac = 0.7,
			TurnSpeedRef = 12,
			YawResyncRad = 0.6,
			FlipUpY = 0.3,
			FlipSeconds = 2,
			HopSeconds = 0.5,
			HopSpeed = 15,
			Wheeled = { Accel = 28, Brake = 60, Coast = 10, TurnRate = 2.4, MinTurnFactor = 0.35, Grip = 8 },
			Tracked = { Accel = 16, Brake = 40, Coast = 10, TurnRate = 1.5, MinTurnFactor = 0.7, Grip = 12 },
		},
		Heli = {
			Accel = 22,
			Drag = 20,
			BackFrac = 0.4,
			StrafeFrac = 0.5,
			ClimbRate = 24,
			SinkRate = 20,
			AccelV = 30,
			TurnRate = 1.6,
			YawAccel = 5,
			MaxPitchTilt = 14,
			MaxRollTilt = 12,
			BankPerYawRate = 6,
			TiltRate = 25,
			AltHoldGain = 1.5,
			AltHoldMax = 6,
			LandAGL = 0.8,
			MaxAltitude = 450,
		},
		Plane = {
			Thrust = 20,
			Drag = 6,
			GroundDrag = 10,
			Brake = 30,
			GravityAlong = 25,
			OverspeedFrac = 1.15,
			ThrottleRateUp = 0.6,
			ThrottleRateDown = 0.8,
			MaxPitchUp = 30,
			MaxPitchDown = 35,
			PitchRate = 40,
			MaxBank = 55,
			BankRate = 90,
			TurnRate = 0.9,
			TaxiTurnRate = 0.8,
			StallNoseDown = -20,
			StallSinkMax = 35,
			StallClearMargin = 3,
			ClimbOutPitch = 15,
			ClimbOutAGL = 45,
			AutoTakeoff = true,
			AutoTakeoffLever = 0.9,
			AutoTakeoffSpeedFrac = 1.1,
			LiftoffPitch = 6,
			RolledOffAGL = 3,
			LandAGL = 1.5,
			MaxAltitude = 600,
			AirStartHeight = 120,
			AirStartSpeedFrac = 1.3,
			TakeoffFrac = 0.45,
			TakeoffMin = 40,
			TakeoffMax = 60,
			StallFrac = 0.8,
		},
		Boat = {
			Accel = 14,
			Brake = 18,
			Coast = 6,
			ReverseFrac = 0.35,
			ReverseAccelFrac = 0.7,
			TurnRate = 1.1,
			MinTurnFactor = 0.25,
			TurnSpeedRef = 8,
			Drift = 3,
			Draft = 0.15,
			BobAmp = 0.15,
			BobHz = 0.35,
			HeightGain = 4,
			MaxVy = 10,
			BowUpDeg = 4,
			TurnLeanDeg = 6,
			BobPitchDeg = 1.2,
			BobRollDeg = 1.5,
			BobRollHz = 0.4,
			ShoreBrake = 50,
			ShoreMargin = 3,
			AgroundSpeed = 8,
		},
	},
}

local DEFAULT_MAX_SPEED: { [string]: number } = { Car = 40, Heli = 60, Plane = 100, Boat = 40 }
local VALID_MODES: { [string]: boolean } = { Car = true, Heli = true, Plane = true, Boat = true }
-- per-variant car keys: a tracked vehicle never falls back to the wheeled value of these
local CAR_VARIANT_KEYS: { [string]: boolean } =
	{ Accel = true, Brake = true, Coast = true, TurnRate = true, MinTurnFactor = true, Grip = true }

-- ─────────────────────────────────────────────────────────────────────────────
-- Math helpers (spec 2.0 conventions)
-- ─────────────────────────────────────────────────────────────────────────────
local TAU = math.pi * 2

local function approach(x: number, target: number, rate: number, dt: number): number
	local d = target - x
	local m = rate * dt
	if d > m then
		return x + m
	elseif d < -m then
		return x - m
	end
	return target
end

-- = CFrame.Angles(0, h, 0).LookVector
local function fwd(h: number): Vector3
	return Vector3.new(-math.sin(h), 0, -math.cos(h))
end

local function right(h: number): Vector3
	return Vector3.new(math.cos(h), 0, -math.sin(h))
end

local function yawOf(cf: CFrame): number
	local lv = cf.LookVector
	return math.atan2(-lv.X, -lv.Z)
end

local function wrap(a: number): number
	return (a + math.pi) % TAU - math.pi
end

-- pitch > 0 = nose up; bank > 0 = right wing down
local function orient(pitchDeg: number, h: number, bankDeg: number): CFrame
	return CFrame.fromEulerAnglesYXZ(math.rad(pitchDeg), h, -math.rad(bankDeg))
end

-- = orient(pitchDeg, h, 0).LookVector
local function lookVector(pitchDeg: number, h: number): Vector3
	local p = math.rad(pitchDeg)
	local cp = math.cos(p)
	return Vector3.new(-math.sin(h) * cp, math.sin(p), -math.cos(h) * cp)
end

local function flatUnit(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return Vector3.zero
	end
	return f.Unit
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Laws (pure)
-- ─────────────────────────────────────────────────────────────────────────────
local Laws = {}
VehicleDriveClient.Laws = Laws
VehicleDriveClient.DEFAULTS = DEFAULTS
VehicleDriveClient.PROTOCOL_VERSION = PROTOCOL_VERSION
Laws.Helpers = {
	approach = approach,
	fwd = fwd,
	right = right,
	yawOf = yawOf,
	wrap = wrap,
	orient = orient,
	lookVector = lookVector,
}

local function cfgNumber(src: any, key: string): number?
	if typeof(src) == "table" then
		local v = src[key]
		if typeof(v) == "number" then
			return v
		end
	end
	return nil
end

local function modeConstants(mode: string, tracked: boolean, drive: any): { [string]: number }
	local out: { [string]: number } = {}
	local defaults: any = DEFAULTS.Modes[mode] or DEFAULTS.Modes.Car
	local cfgModes: any = if typeof(drive) == "table" and typeof(drive.Modes) == "table" then drive.Modes else nil
	local cfg: any = if cfgModes and typeof(cfgModes[mode]) == "table" then cfgModes[mode] else nil
	for k, v in pairs(defaults) do
		if typeof(v) == "number" then
			out[k] = v
		end
	end
	if mode == "Car" then
		local variant = if tracked then "Tracked" else "Wheeled"
		for k, v in pairs(defaults[variant]) do
			out[k] = v
		end
		if cfg then
			local sub: any = cfg[variant]
			for k in pairs(out) do
				local val = cfgNumber(sub, k)
				if val == nil and tracked then
					val = cfgNumber(cfg, "Tracked" .. k)
				end
				if val == nil and (not tracked or not CAR_VARIANT_KEYS[k]) then
					val = cfgNumber(cfg, k)
				end
				if val ~= nil then
					out[k] = val
				end
			end
		end
	elseif cfg then
		for k in pairs(out) do
			local val = cfgNumber(cfg, k)
			if val ~= nil then
				out[k] = val
			end
		end
	end
	-- speed resync (Drive.Resync, shared by every mode)
	local rs: any = if typeof(drive) == "table" then drive.Resync else nil
	local d: any = DEFAULTS.Resync
	out.ResyncGap = if mode == "Car" then (cfgNumber(rs, "CarGap") or d.CarGap) else (cfgNumber(rs, "Gap") or d.Gap)
	out.ResyncSeconds = cfgNumber(rs, "Seconds") or d.Seconds
	out.ResyncGrace = cfgNumber(rs, "GraceSeconds") or d.GraceSeconds
	return out
end

--[[ Params from the vehicle model's attributes (spec 6.2) + VehicleConfig.Drive (or DEFAULTS). ]]
function Laws.BuildParams(mode: string, attrs: { [string]: any }, drive: any?): Params
	local function a(key: string): number?
		local v = attrs[key]
		if typeof(v) == "number" and v == v then
			return v
		end
		return nil
	end
	local tracked = attrs.WE_Tracked == true
	local C = modeConstants(mode, tracked, drive)
	local maxSpeed = math.max(1, a("WE_MaxSpeed") or DEFAULT_MAX_SPEED[mode] or 40)
	local accelDefault = if mode == "Plane" then (C.Thrust or 20) else (C.Accel or 20)
	local vto = a("WE_TakeoffSpeed")
		or math.clamp((C.TakeoffFrac or 0.45) * maxSpeed, C.TakeoffMin or 40, math.max(C.TakeoffMin or 40, C.TakeoffMax or 60))
	local clearance = a("WE_GroundClearance") or 2
	local autoTakeoff = true
	if typeof(drive) == "table" and typeof(drive.Modes) == "table" and typeof(drive.Modes.Plane) == "table" then
		local v = drive.Modes.Plane.AutoTakeoff
		if typeof(v) == "boolean" then
			autoTakeoff = v
		end
	end
	local softBound = 3300
	if typeof(drive) == "table" then
		softBound = cfgNumber(drive.World, "SoftBound") or softBound
	end
	local spawnState = attrs.WE_SpawnState
	return {
		Mode = mode,
		MaxSpeed = maxSpeed,
		Accel = math.max(0.1, a("WE_Accel") or accelDefault),
		TurnRate = a("WE_TurnRate") or C.TurnRate or 1,
		Tracked = tracked,
		ClimbRate = a("WE_ClimbRate") or C.ClimbRate or 24,
		MaxAltitude = a("WE_MaxAltitude") or C.MaxAltitude or 450,
		Vto = math.max(1, vto),
		Vstall = math.max(0.5, a("WE_StallSpeed") or (C.StallFrac or 0.8) * vto),
		RideOffset = a("WE_RideOffset") or (clearance - (C.Draft or 0.15)),
		Clearance = clearance,
		HalfLength = a("WE_HalfLength") or 6,
		HalfWidth = a("WE_HalfWidth") or 3,
		SpawnState = if typeof(spawnState) == "string" then spawnState else nil,
		SpawnSpeed = a("WE_SpawnSpeed") or 0,
		SoftBound = softBound,
		AutoTakeoff = autoTakeoff,
		C = C,
	}
end

local function blankState(mode: string): State
	return {
		Mode = mode,
		Age = 0,
		Heading = 0,
		LagFor = 0,
		Speed = 0,
		FlipFor = 0,
		HopLeft = 0,
		Fwd = 0,
		Side = 0,
		Vy = 0,
		YawRate = 0,
		HoldY = nil,
		Landed = false,
		Roll = 0,
		Pitch = 0,
		Lever = 0,
		Airspeed = 0,
		Airborne = false,
		ClimbOut = false,
		Stalled = false,
		Bank = 0,
		BobT = 0,
		LastWaterPos = nil,
		LastWaterY = nil,
	}
end

--[[ Fresh law state from the vehicle's current pose. Re-run whenever WE_DriveAuthority becomes "Client". ]]
function Laws.NewState(P: Params, sense: Sense): State
	local st = blankState(P.Mode)
	st.Heading = sense.Yaw
	local look = sense.Look or fwd(sense.Yaw)
	local vel = sense.Velocity
	if P.Mode == "Heli" then
		st.Landed = sense.AGL <= P.C.LandAGL
		if not st.Landed then
			st.Fwd = vel:Dot(fwd(sense.Yaw))
			st.Side = vel:Dot(right(sense.Yaw))
			st.Vy = vel.Y
		end
		st.Pitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
		st.HoldY = nil
	elseif P.Mode == "Plane" then
		local forwardActual = vel:Dot(look)
		-- the WE_SpawnState "Airborne" flag only counts while actually off the ground (a parked
		-- air-start plane re-entered on the runway must not start rolling at its spawn speed)
		st.Airborne = sense.AGL > P.C.RolledOffAGL or (P.SpawnState == "Airborne" and sense.AGL > P.C.LandAGL)
		st.ClimbOut = false
		st.Bank = 0
		if st.Airborne then
			st.Airspeed = math.max(forwardActual, P.SpawnSpeed)
			st.Lever = math.clamp(st.Airspeed / P.MaxSpeed, 0, 1)
		else
			st.Airspeed = math.max(forwardActual, 0)
			st.Lever = 0
		end
		st.Pitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
	else
		st.Speed = vel:Dot(fwd(sense.Yaw))
		if P.Mode == "Boat" and sense.WaterY ~= nil then
			st.LastWaterPos = sense.Position
			st.LastWaterY = sense.WaterY
		end
	end
	return st
end

-- spec 2.0 "speed resync": a vehicle pushed against a wall does not build up to full speed
local function resync(st: State, C: { [string]: number }, current: number, forwardActual: number, dt: number): number
	local gap = C.ResyncGap
	if st.Age < C.ResyncGrace then
		st.LagFor = 0
		return current
	end
	if forwardActual < current - gap then
		st.LagFor += dt
		if st.LagFor >= C.ResyncSeconds then
			st.LagFor = 0
			return forwardActual + gap
		end
	else
		st.LagFor = 0
	end
	return current
end

local function speedUpdate(
	speed: number,
	t: number,
	max: number,
	rev: number,
	accel: number,
	brake: number,
	coast: number,
	reverseAccelFrac: number,
	dt: number
): number
	if t > 0.05 then
		if speed < 0 then
			speed = approach(speed, 0, brake, dt)
		else
			speed = approach(speed, t * max, accel, dt)
		end
	elseif t < -0.05 then
		if speed > 0 then
			speed = approach(speed, 0, brake, dt)
		else
			speed = approach(speed, t * rev, accel * reverseAccelFrac, dt)
		end
	else
		speed = approach(speed, 0, coast, dt)
	end
	return math.clamp(speed, -rev, max)
end

-- 2.1 CAR (wheeled + tracked)
local function stepCar(st: State, P: Params, input: Input, sense: Sense, dt: number): Out
	local C = P.C
	local t, s = input.Throttle, input.Steer
	local Max = P.MaxSpeed
	local Rev = C.ReverseFrac * Max
	st.Speed = resync(st, C, st.Speed, sense.Velocity:Dot(fwd(st.Heading)), dt)
	st.Speed = speedUpdate(st.Speed, t, Max, Rev, P.Accel, C.Brake, C.Coast, C.ReverseAccelFrac, dt)
	local dir = if st.Speed < -0.5 then -1 else 1
	st.Heading -= s * P.TurnRate * math.clamp(math.abs(st.Speed) / C.TurnSpeedRef, C.MinTurnFactor, 1) * dir * dt
	if math.abs(wrap(sense.Yaw - st.Heading)) > C.YawResyncRad then
		st.Heading = sense.Yaw -- a collision spun us: stop fighting it
	end
	local r = right(st.Heading)
	local lat = sense.Velocity:Dot(r) * math.exp(-C.Grip * dt)
	local vel = fwd(st.Heading) * st.Speed + r * lat
	local hold = false
	-- unstick: upside down for FlipSeconds -> short vertical hop while the AO rights the car
	if sense.UpY < C.FlipUpY then
		st.FlipFor += dt
	else
		st.FlipFor = 0
	end
	if st.FlipFor >= C.FlipSeconds then
		st.FlipFor = 0
		st.HopLeft = C.HopSeconds
	end
	if st.HopLeft > 0 then
		st.HopLeft -= dt
		vel = Vector3.new(vel.X, C.HopSpeed, vel.Z)
		hold = true
	end
	return {
		Velocity = vel,
		HoldVertical = hold,
		Orientation = orient(0, st.Heading, 0),
		Hud = { Speed = math.abs(st.Speed) },
	}
end

-- 2.2 HELICOPTER
local function stepHeli(st: State, P: Params, input: Input, sense: Sense, dt: number): Out
	local C = P.C
	local Max = P.MaxSpeed
	local t, s, lift = input.Throttle, input.Steer, input.Lift
	st.Fwd = resync(st, C, st.Fwd, sense.Velocity:Dot(fwd(st.Heading)), dt)
	local fT = if t >= 0 then t * Max else t * Max * C.BackFrac
	st.Fwd = approach(st.Fwd, fT, if math.abs(fT) > math.abs(st.Fwd) then P.Accel else C.Drag, dt)
	local sT = input.Strafe * Max * C.StrafeFrac
	st.Side = approach(st.Side, sT, if math.abs(sT) > math.abs(st.Side) then P.Accel else C.Drag, dt)
	st.YawRate = approach(st.YawRate, -s * P.TurnRate, C.YawAccel, dt)
	st.Heading += st.YawRate * dt

	local y = sense.Position.Y
	local vyT: number
	if math.abs(lift) > 0.05 then
		vyT = if lift > 0 then lift * P.ClimbRate else lift * C.SinkRate
		st.HoldY = nil
	else
		local holdY = st.HoldY
		if holdY == nil then
			vyT = 0 -- settle first, then capture the hover height
			if math.abs(st.Vy) < 1 then
				st.HoldY = y
			end
		else
			vyT = math.clamp((holdY - y) * C.AltHoldGain, -C.AltHoldMax, C.AltHoldMax)
		end
	end
	if y >= P.MaxAltitude then
		vyT = math.min(vyT, -(y - P.MaxAltitude))
	end
	st.Vy = approach(st.Vy, vyT, C.AccelV, dt)

	if lift > 0.05 then
		st.Landed = false -- take off
	elseif not st.Landed and sense.AGL <= C.LandAGL and st.Vy <= 0 then
		st.Landed = true
	end
	if st.Landed then
		st.Fwd = 0
		st.Side = 0
		st.Vy = 0
		st.YawRate = 0
		st.HoldY = nil
	end

	local vel = fwd(st.Heading) * st.Fwd + right(st.Heading) * st.Side + Vector3.new(0, st.Vy, 0)
	local pitchT = -(st.Fwd / Max) * C.MaxPitchTilt -- nose down when flying forward
	local rollT = -(st.Side / (Max * C.StrafeFrac)) * C.MaxRollTilt + st.YawRate * C.BankPerYawRate
	st.Pitch = approach(st.Pitch, pitchT, C.TiltRate, dt)
	st.Roll = approach(st.Roll, rollT, C.TiltRate, dt)
	return {
		Velocity = vel,
		HoldVertical = not st.Landed,
		Orientation = CFrame.fromEulerAnglesYXZ(math.rad(st.Pitch), st.Heading, math.rad(st.Roll)),
		Hud = {
			Speed = math.sqrt(st.Fwd * st.Fwd + st.Side * st.Side),
			Alt = sense.AGL,
			Tag = if st.Landed then "LANDED" else nil,
		},
	}
end

-- 2.3 PLANE
local function stepPlane(st: State, P: Params, input: Input, sense: Sense, dt: number): Out
	local C = P.C
	local Max = P.MaxSpeed
	local Vto, Vstall = P.Vto, P.Vstall
	local t, s, lift = input.Throttle, input.Steer, input.Lift
	local agl = sense.AGL
	local look0 = if st.Airborne then lookVector(st.Pitch, st.Heading) else fwd(st.Heading)
	st.Airspeed = resync(st, C, st.Airspeed, sense.Velocity:Dot(look0), dt)

	st.Lever = math.clamp(st.Lever + t * (if t > 0 then C.ThrottleRateUp else C.ThrottleRateDown) * dt, 0, 1)
	local target = st.Lever * Max

	local function groundOut(): Out
		return {
			Velocity = fwd(st.Heading) * st.Airspeed,
			HoldVertical = false,
			Orientation = orient(st.Pitch, st.Heading, st.Bank),
			Hud = {
				Speed = st.Airspeed,
				Alt = agl,
				Throttle = st.Lever,
				Tag = if st.Airspeed < Vto then ("LIFT OFF AT " .. tostring(math.floor(Vto))) else nil,
			},
		}
	end

	if not st.Airborne then
		local rate = if target > st.Airspeed then P.Accel elseif t < -0.05 then C.Brake else C.GroundDrag
		st.Airspeed = approach(st.Airspeed, target, rate, dt)
		st.Heading -= s * C.TaxiTurnRate * math.clamp(st.Airspeed / 10, 0.3, 1) * dt
		st.Pitch = approach(st.Pitch, 0, C.PitchRate, dt)
		st.Bank = approach(st.Bank, 0, C.BankRate, dt)
		if
			st.Airspeed >= Vto
			and (
				lift > 0.2
				or (P.AutoTakeoff and st.Lever >= C.AutoTakeoffLever and st.Airspeed >= C.AutoTakeoffSpeedFrac * Vto)
			)
		then
			st.Airborne = true
			st.Pitch = math.max(st.Pitch, C.LiftoffPitch) -- 6°: climbing at once, no instant touchdown
			st.ClimbOut = true
		end
		if agl > C.RolledOffAGL then
			st.Airborne = true -- rolled off an edge
		end
		if not st.Airborne then
			return groundOut()
		end
	end

	-- AIRBORNE
	st.Airspeed = approach(st.Airspeed, target, if target > st.Airspeed then P.Accel else C.Drag, dt)
		- C.GravityAlong * math.sin(math.rad(st.Pitch)) * dt
	st.Airspeed = math.clamp(st.Airspeed, 0, Max * C.OverspeedFrac)
	if st.Stalled then
		if st.Airspeed >= Vstall + C.StallClearMargin then
			st.Stalled = false
		end
	elseif st.Airspeed < Vstall then
		st.Stalled = true
	end
	local pitchT = if lift >= 0 then lift * C.MaxPitchUp else lift * C.MaxPitchDown
	if st.ClimbOut and (agl >= C.ClimbOutAGL or lift < -0.05) then
		st.ClimbOut = false
	end
	if st.ClimbOut then
		pitchT = math.max(pitchT, C.ClimbOutPitch) -- climb-out assist, only right after lift-off
	end
	if st.Stalled then
		pitchT = math.min(pitchT, C.StallNoseDown)
	end
	local y = sense.Position.Y
	if y > P.MaxAltitude - 30 then
		pitchT = math.min(pitchT, 0)
	end
	if y > P.MaxAltitude then
		pitchT = math.min(pitchT, -5)
	end
	st.Pitch = approach(st.Pitch, pitchT, C.PitchRate, dt)
	st.Bank = approach(st.Bank, s * C.MaxBank, C.BankRate, dt)
	st.Heading -= (st.Bank / C.MaxBank) * P.TurnRate * math.clamp(st.Airspeed / Vto, 0.5, 1) * dt
	local sink = if st.Stalled then C.StallSinkMax * math.max(0, 1 - st.Airspeed / Vstall) else 0
	local vel = lookVector(st.Pitch, st.Heading) * st.Airspeed - Vector3.new(0, sink, 0)

	-- TOUCHDOWN
	if agl <= C.LandAGL and vel.Y <= 2 then
		st.Airborne = false
		st.ClimbOut = false
		st.Stalled = false
		st.Pitch = 0
		st.Bank = 0
		st.Airspeed = math.min(st.Airspeed, Vto)
		return groundOut()
	end

	local tag: string? = nil
	if st.Stalled then
		tag = "STALL"
	elseif agl < 15 and vel.Y < -20 then
		tag = "PULL UP"
	end
	return {
		Velocity = vel,
		HoldVertical = true,
		Orientation = orient(st.Pitch, st.Heading, st.Bank),
		Hud = { Speed = st.Airspeed, Alt = agl, Throttle = st.Lever, Tag = tag },
	}
end

--[[ 2.4 boat shore probes. The client calls this BEFORE building sense.WaterNear/WaterFar:
	near/far points are Position + fwd(Heading) * dir * near / far. ]]
function Laws.ProbeDistances(st: State, P: Params, input: Input): (number, number, number)
	local C = P.C
	local dir = if st.Speed < -0.5 or (st.Speed <= 0 and input.Throttle < 0) then -1 else 1
	local near = P.HalfLength + C.ShoreMargin
	local far = near + (st.Speed * st.Speed) / (2 * C.ShoreBrake) + 2
	return dir, near, far
end

-- 2.4 BOAT
local function stepBoat(st: State, P: Params, input: Input, sense: Sense, dt: number): Out
	local C = P.C
	local t, s = input.Throttle, input.Steer
	local Max = P.MaxSpeed
	local Rev = C.ReverseFrac * Max
	st.Speed = resync(st, C, st.Speed, sense.Velocity:Dot(fwd(st.Heading)), dt)
	local dir = Laws.ProbeDistances(st, P, input)
	local before = st.Speed
	st.Speed = speedUpdate(st.Speed, t, Max, Rev, P.Accel, C.Brake, C.Coast, C.ReverseAccelFrac, dt)
	if sense.WaterNear == false then
		-- hard stop: no throttle into the shore
		st.Speed = if dir > 0 then math.min(st.Speed, 0) else math.max(st.Speed, 0)
	elseif sense.WaterFar == false then
		-- brake before the shore; throttle never adds speed toward it meanwhile (prototype behaviour)
		local base = if math.abs(st.Speed) > math.abs(before) then before else st.Speed
		st.Speed = approach(base, 0, C.ShoreBrake, dt)
	end
	st.Heading -= s * P.TurnRate * math.clamp(math.abs(st.Speed) / C.TurnSpeedRef, C.MinTurnFactor, 1) * dir * dt

	local pos = sense.Position
	local vel: Vector3
	local hold = true
	local tag: string? = nil
	local waterY = sense.WaterY
	if waterY == nil then
		-- pushed aground: head back to the last water position
		tag = "AGROUND"
		st.Speed = 0
		local lastPos, lastY = st.LastWaterPos, st.LastWaterY
		if lastPos and lastY then
			local vy = math.clamp((lastY + P.RideOffset - pos.Y) * C.HeightGain, -C.MaxVy, C.MaxVy)
			vel = flatUnit(lastPos - pos) * C.AgroundSpeed + Vector3.new(0, vy, 0)
		else
			vel = Vector3.zero
			hold = false
		end
	else
		st.LastWaterPos = pos
		st.LastWaterY = waterY
		st.BobT += dt
		local rideY = waterY + P.RideOffset + C.BobAmp * 0.5 * (1 + math.sin(TAU * C.BobHz * st.BobT))
		local vy = math.clamp((rideY - pos.Y) * C.HeightGain, -C.MaxVy, C.MaxVy)
		local r = right(st.Heading)
		local lat = sense.Velocity:Dot(r) * math.exp(-C.Drift * dt)
		vel = fwd(st.Heading) * st.Speed + r * lat + Vector3.new(0, vy, 0)
	end
	local pitchDeg = (st.Speed / Max) * C.BowUpDeg + C.BobPitchDeg * math.sin(math.pi * st.BobT)
	local rollDeg = -s * math.clamp(st.Speed / Max, 0, 1) * C.TurnLeanDeg
		+ C.BobRollDeg * math.sin(TAU * C.BobRollHz * st.BobT + 1)
	return {
		Velocity = vel,
		HoldVertical = hold,
		Orientation = CFrame.fromEulerAnglesYXZ(math.rad(pitchDeg), st.Heading, math.rad(rollDeg)),
		Hud = { Speed = math.abs(st.Speed), Tag = tag },
	}
end

-- soft map edge: past SoftBound drop the outward horizontal velocity; aircraft turn back to the centre
local function applySoftBound(st: State, P: Params, sense: Sense, out: Out, dt: number)
	local sb = P.SoftBound
	local p = sense.Position
	if math.abs(p.X) <= sb and math.abs(p.Z) <= sb then
		return
	end
	local v = out.Velocity
	local vx, vz = v.X, v.Z
	if (p.X > sb and vx > 0) or (p.X < -sb and vx < 0) then
		vx = 0
	end
	if (p.Z > sb and vz > 0) or (p.Z < -sb and vz < 0) then
		vz = 0
	end
	out.Velocity = Vector3.new(vx, v.Y, vz)
	if P.Mode == "Heli" or P.Mode == "Plane" then
		local toCentre = math.atan2(p.X, p.Z) -- fwd(h) points at the origin
		st.Heading += math.clamp(wrap(toCentre - st.Heading), -0.5 * dt, 0.5 * dt)
	end
	if out.Hud.Tag == nil then
		out.Hud.Tag = "TURN BACK"
	end
end

--[[ One control step. Changes `st` in place; returns the mover targets (spec 2.0). ]]
function Laws.Step(st: State, P: Params, input: Input, sense: Sense, dt: number): Out
	dt = math.clamp(dt, 0, 0.1)
	st.Age += dt
	local out: Out
	if P.Mode == "Heli" then
		out = stepHeli(st, P, input, sense, dt)
	elseif P.Mode == "Plane" then
		out = stepPlane(st, P, input, sense, dt)
	elseif P.Mode == "Boat" then
		out = stepBoat(st, P, input, sense, dt)
	else
		out = stepCar(st, P, input, sense, dt)
	end
	applySoftBound(st, P, sense, out, dt)
	return out
end

--[[ Seat throttle/steer + extra axes -> law input (spec 3). ]]
function Laws.ComposeInput(mode: string, raw: RawInput): Input
	local lift = 0
	if mode == "Heli" or mode == "Plane" then
		local up = if raw.Up or raw.TouchUp then 1 else math.clamp(raw.R2 or 0, 0, 1)
		local down = if raw.Down or raw.TouchDown then 1 else math.clamp(raw.L2 or 0, 0, 1)
		lift = math.clamp(up - down, -1, 1)
	end
	local strafe = 0
	if mode == "Heli" then
		strafe = (if raw.Right then 1 else 0) - (if raw.Left then 1 else 0)
	end
	return {
		Throttle = math.clamp(raw.Throttle, -1, 1),
		Steer = math.clamp(raw.Steer, -1, 1),
		Lift = lift,
		Strafe = strafe,
	}
end

--[[ Mobile ▲/▼ column + EXIT pill in pixels (spec 3.1, mobile plan P1-7). Positions are top-left corners in the
	same space as jumpPos. Every control is ≥ 44 px (50 on phones, 60 on tablets) and CONTROL_GAP (16) px from
	the others and from the Roblox jump button. The phone column tops out at H − 222 (HudConfig.Reserve.CombatTouch
	MinHeightPx), the EXIT pill sits left of the jump button (cars/boats and the "Above" column) or left of the
	column ("Left"/"Fallback"), bottom-aligned with the lowest control: never in the thumbstick zone.
	lift = false (cars/boats): no column, only the EXIT pill. ]]
local CONTROL_GAP = 16
function Laws.ControlsLayout(
	jumpPos: Vector2?,
	jumpSize: Vector2?,
	viewport: Vector2,
	reservedTopFromBottom: number?,
	lift: boolean?
): Layout
	local reserved = reservedTopFromBottom or 250
	local size = if viewport.Y < 500 then 50 else 60
	local gap = CONTROL_GAP
	local S = Vector2.new(size, size)
	local exitW = math.floor(size * 1.8 + 0.5)
	local E = Vector2.new(exitW, size)
	local column = lift ~= false
	if jumpPos and jumpSize then
		local jumpBottom = jumpPos.Y + jumpSize.Y
		-- 1) column centred above the jump button; EXIT left of the jump button
		local x = jumpPos.X + jumpSize.X / 2 - size / 2
		local downY = jumpPos.Y - gap - size
		local upY = downY - gap - size
		if upY >= viewport.Y - reserved then
			return {
				Up = { Pos = Vector2.new(x, upY), Size = S },
				Down = { Pos = Vector2.new(x, downY), Size = S },
				Exit = { Pos = Vector2.new(jumpPos.X - gap - exitW, jumpBottom - size), Size = E },
				Where = "Above",
			}
		end
		-- 2) column left of the jump button, bottom-aligned with it; EXIT left of the column
		local lx = jumpPos.X - gap - size
		local ldown = jumpBottom - size
		local ex = if column then lx - gap - exitW else jumpPos.X - gap - exitW
		return {
			Up = { Pos = Vector2.new(lx, ldown - gap - size), Size = S },
			Down = { Pos = Vector2.new(lx, ldown), Size = S },
			Exit = { Pos = Vector2.new(ex, ldown), Size = E },
			Where = "Left",
		}
	end
	-- 3) no jump button (hidden TouchGui): column right 24 / bottom 106, EXIT left of it (or in its place)
	local fx = viewport.X - 24 - size
	local fdown = viewport.Y - 106 - size
	local fex = if column then fx - gap - exitW else viewport.X - 24 - exitW
	return {
		Up = { Pos = Vector2.new(fx, fdown - gap - size), Size = S },
		Down = { Pos = Vector2.new(fx, fdown), Size = S },
		Exit = { Pos = Vector2.new(fex, fdown), Size = E },
		Where = "Fallback",
	}
end

-- Drive.Water.QueryBelow / QueryAbove (set from VehicleConfig in Init; same defaults as the server)
local waterBelow, waterAbove = 8, 20

--[[ Water surface Y under pos (spec 2.5; same algorithm as VehicleService._WaterSurfaceAt). ]]
function Laws.WaterSurfaceAt(
	parts: { BasePart },
	pos: Vector3,
	margin: number?,
	landProbe: ((number, number, number) -> boolean)?
): number?
	local m = margin or 0
	local best: number? = nil
	for _, p in ipairs(parts) do
		local lp = p.CFrame:PointToObjectSpace(pos)
		local size = p.Size
		if math.abs(lp.X) <= size.X / 2 - m and math.abs(lp.Z) <= size.Z / 2 - m then
			local top = p.Position.Y + size.Y / 2
			if pos.Y >= top - waterBelow and pos.Y <= top + waterAbove and (best == nil or top > best) then
				best = top
			end
		end
	end
	if best ~= nil and landProbe ~= nil and landProbe(pos.X, pos.Z, best) then
		return nil
	end
	return best
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Runtime (client only; everything below runs from Init)
-- ─────────────────────────────────────────────────────────────────────────────
type Drive = {
	Model: Model,
	Seat: VehicleSeat,
	Chassis: BasePart,
	Humanoid: Humanoid,
	Mode: string,
	VehicleId: string,
	Params: Params,
	State: State?,
	LV: LinearVelocity?,
	AO: AlignOrientation?,
	WasClient: boolean,
	HelloSent: number,
	LastHelloAt: number,
	LastMoverLookAt: number,
	HudAcc: number,
	Blocked: string?,
	Conns: { RBXScriptConnection },
	-- jeep fix F4 / F7
	InputSrc: string, -- "seat" | "stick" | "none" (where readRaw found the throttle/steer)
	LastStreamAt: number,
	StreamZeroSent: boolean,
	NoDriveFor: number, -- pushing with speed < Debug.NoDriveSpeed for this long (diagnostic line)
	StuckFor: number, -- pushing with speed < Exit.StuckSpeed for this long (Stuck report)
	MovedFor: number, -- speed ≥ 3 for this long
	StuckSent: boolean,
	DiagUntil: number,
	DiagAcc: number,
	LastExitAt: number,
	StartedAt: number,
	-- mobile P1-7
	AirLocked: boolean, -- Heli/Plane above Exit.LockAGL: the local JumpHeight is 0
	NextAirCheck: number,
}

local WATER_TAG_DEFAULT = "WE_Water"
local DRIVE_INPUT_DEFAULT = "VehicleDriveInput"
local VEHICLE_FOLDER = "WarEmpireVehicles"
local AGL_RAY = 1200
local HELLO_RETRY_SECONDS = 1.0
local HELLO_MAX = 4
local RESERVED_FROM_BOTTOM = 250

local ACTION_UP = "WE_VehLiftUp"
local ACTION_DOWN = "WE_VehLiftDown"
local ACTION_STRAFE = "WE_VehStrafe"
local ACTION_EXIT = "WE_VehExit"

-- Copy by device (CLAUDE.md §1): key names only for PreferredInput KeyboardAndMouse (PC) or Gamepad (Pad).
local HINTS: { [string]: { PC: string, Pad: string, Touch: string } } = {
	Heli = {
		PC = "W/S fly · A/D turn · SPACE up · CTRL down · Z/X strafe · F exit",
		Pad = "Stick: fly/turn · RT up · LT down · LB/RB strafe",
		Touch = "Stick: fly/turn · ▲▼ climb/descend · hold EXIT to leave",
	},
	Plane = {
		PC = "Hold W: throttle · A/D bank · SPACE nose up (lift off at %d) · F exit",
		Pad = "Stick up: throttle · RT nose up (lift off at %d)",
		Touch = "Push stick up for throttle · ▲ to lift off · hold EXIT to leave",
	},
}
local RED_TAGS: { [string]: boolean } = { STALL = true, ["PULL UP"] = true, AGROUND = true, ["TURN BACK"] = true }

local initialized = false
local RemotesMod: any = nil
local waterTag = WATER_TAG_DEFAULT
local driveInputName = DRIVE_INPUT_DEFAULT
local driveCfg: any = nil
local isTouch = false
local landProbeHeight = 30
local waterRefreshSeconds = 2

local active: Drive? = nil
local waterParts: { BasePart } = {}
local rayParams: RaycastParams? = nil
local promptFolderConn: RBXScriptConnection? = nil
local hintShown: { [string]: boolean } = {}
local hintToken = 0

-- input state (reset whenever the actions unbind)
local keyDown: { [Enum.KeyCode]: boolean } = {}
local analog = { R2 = 0, L2 = 0 }
local touchOwners: { [InputObject]: string } = {}
local touchUp, touchDown = false, false

-- HUD
local hudGui: ScreenGui? = nil
local pill: TextLabel? = nil
local hintLabel: TextLabel? = nil
local diagLabel: TextLabel? = nil
local controlsFrame: Frame? = nil
local upBtn: TextButton? = nil
local downBtn: TextButton? = nil
local exitBtn: TextButton? = nil
local exitFill: Frame? = nil
local exitLabel: TextLabel? = nil
local layoutConns: { RBXScriptConnection } = {}
local controlsLift = true -- the ▲▼ column is shown (aircraft); false = EXIT pill only (cars/boats)

-- EXIT hold (P1-7): the touch that is holding the pill and since when
local exitIo: InputObject? = nil
local exitHoldStart = 0
local exitTapHintUntil = 0

-- airborne jump lock (P1-7): the Humanoid whose JumpHeight/JumpPower we zeroed and the values to put back
local jumpLock: { Hum: Humanoid, Height: number, Power: number }? = nil

-- F4a: the PlayerModule ControlModule (stick / WASD move vector); looked up lazily, retried every 2 s while missing
local controls: any = nil
local nextControlsTry = 0

-- device (CLAUDE.md §1: PreferredInput, not TouchEnabled, decides the copy); nil = not overridden
local deviceOverride: string? = nil

-- config sections resolved at each sit (VehicleConfig.Drive.<name> over DEFAULTS.<name>)
local W: any = DEFAULTS.Watchdog
local DBG: any = DEFAULTS.Debug
local EXIT: any = DEFAULTS.Exit
local PLATE: any = DEFAULTS.Nameplate
local debugUser = false

-- P1-8 owner nameplates (client-only BillboardGuis in PlayerGui, adorned to each of my vehicles' Chassis)
local plates: { [Model]: BillboardGui } = {}

local function localPlayer(): Player
	return Players.LocalPlayer
end

-- Drive.<name> with DEFAULTS.<name> filled in, key by key, only when the types match
local function cfgSection(name: string): any
	local d: any = DEFAULTS[name]
	local c: any = if typeof(driveCfg) == "table" and typeof(driveCfg[name]) == "table" then driveCfg[name] else nil
	local out: any = {}
	for k, v in pairs(d) do
		local o = if c then c[k] else nil
		out[k] = if o ~= nil and typeof(o) == typeof(v) then o else v
	end
	return out
end

local function refreshConfig()
	W = cfgSection("Watchdog")
	DBG = cfgSection("Debug")
	EXIT = cfgSection("Exit")
	PLATE = cfgSection("Nameplate")
	local uid = localPlayer().UserId
	local ids: any = DBG.UserIds
	debugUser = DBG.All == true or (typeof(ids) == "table" and table.find(ids, uid) ~= nil)
end

--[[ "Touch" | "Gamepad" | "KeyboardAndMouse" from UserInputService.PreferredInput (TouchEnabled only when the
	property is unavailable). Decides the copy: key names are shown only for KeyboardAndMouse / Gamepad. ]]
local function preferredInput(): string
	if deviceOverride then
		return deviceOverride
	end
	local ok, name = pcall(function(): string?
		local pi: any = (UserInputService :: any).PreferredInput
		return if typeof(pi) == "EnumItem" then pi.Name else nil
	end)
	if ok and typeof(name) == "string" then
		if name == "Touch" then
			return "Touch"
		elseif string.find(name, "Gamepad", 1, true) ~= nil then
			return "Gamepad"
		end
		return "KeyboardAndMouse"
	end
	return if UserInputService.TouchEnabled then "Touch" else "KeyboardAndMouse"
end

local function loadShared()
	-- Shared is already loaded by VehicleController (the only caller of Init), so these never wait long
	local okC, C = pcall(function(): any
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))
	end)
	if okC and typeof(C) == "table" then
		if typeof(C.Tags) == "table" and typeof(C.Tags.Water) == "string" then
			waterTag = C.Tags.Water
		end
		if typeof(C.RemoteNames) == "table" and typeof(C.RemoteNames.VehicleDriveInput) == "string" then
			driveInputName = C.RemoteNames.VehicleDriveInput
		end
	end
	local okR, R = pcall(function(): any
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
	end)
	if okR and typeof(R) == "table" then
		RemotesMod = R
	else
		warn("[VehicleDriveClient] Remotes module:", R)
	end
	local okV, V = pcall(function(): any
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs"):WaitForChild("VehicleConfig"))
	end)
	if okV and typeof(V) == "table" and typeof(V.Drive) == "table" then
		driveCfg = V.Drive
	end
end

local function sendDriveInput(msg: { [string]: any })
	local mod = RemotesMod
	if not mod then
		return
	end
	task.spawn(function()
		local ok, err = pcall(mod.FireServer, driveInputName, msg)
		if not ok then
			warn("[VehicleDriveClient] VehicleDriveInput:", err)
		end
	end)
end

-- ── world queries ───────────────────────────────────────────────────────────
local function refreshWater()
	local list: { BasePart } = {}
	for _, inst in ipairs(CollectionService:GetTagged(waterTag)) do
		if inst:IsA("BasePart") then
			table.insert(list, inst)
		end
	end
	waterParts = list
end

local function refreshRayFilter()
	local params = rayParams
	if not params then
		return
	end
	local list: { Instance } = {}
	local folder = Workspace:FindFirstChild(VEHICLE_FOLDER)
	if folder then
		table.insert(list, folder)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local ch = plr.Character
		if ch then
			table.insert(list, ch)
		end
	end
	for _, p in ipairs(waterParts) do
		table.insert(list, p)
	end
	params.FilterDescendantsInstances = list
end

-- kerbs, piers, pads, HarborShelf = land (spec 2.5)
local function landProbe(x: number, z: number, top: number): boolean
	local params = rayParams
	if not params then
		return false
	end
	local hit = Workspace:Raycast(Vector3.new(x, top + landProbeHeight, z), Vector3.new(0, -(landProbeHeight + 0.05), 0), params)
	return hit ~= nil and hit.Position.Y > top - 0.05
end

local function groundAGL(pos: Vector3, clearance: number): number
	local params = rayParams
	if not params then
		return math.huge
	end
	local hit = Workspace:Raycast(pos, Vector3.new(0, -AGL_RAY, 0), params)
	if not hit then
		return math.huge
	end
	return (pos.Y - hit.Position.Y) - clearance
end

-- ── prompts: only the owner sees "Drive", and not while already driving ─────
local function vehicleModelOf(inst: Instance): Model?
	local p = inst.Parent
	while p and p ~= Workspace do
		if p:IsA("Model") and p:GetAttribute("VehicleId") ~= nil then
			return p
		end
		p = p.Parent
	end
	return nil
end

local function refreshPrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") or prompt.Name ~= "WE_DrivePrompt" then
		return
	end
	local model = vehicleModelOf(prompt)
	if not model then
		return
	end
	local mine = model:GetAttribute("OwnerUserId") == localPlayer().UserId
	local driving = active ~= nil and (active :: Drive).Model == model
	local want = mine and not driving
	if prompt.Enabled ~= want then
		prompt.Enabled = want
	end
end

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

-- P1-8: the server's old always-on-top "VehicleLabel" (280 studs, key names) is replaced by the owner-only client
-- nameplate below; any copy an older server still builds is switched off on this client.
local function suppressServerLabel(d: Instance)
	if d.Name == "VehicleLabel" and d:IsA("BillboardGui") and d.Enabled then
		d.Enabled = false
	end
end

local function refreshAllPrompts()
	local folder = Workspace:FindFirstChild(VEHICLE_FOLDER)
	if not folder then
		return
	end
	for _, d in ipairs(folder:GetDescendants()) do
		if d.Name == "WE_DrivePrompt" then
			refreshPrompt(d)
		elseif d.Name == "VehicleLabel" then
			suppressServerLabel(d)
		end
	end
end

-- ── P1-8 owner nameplate: small, owner-only, stud-scaled, 14–20 px text, MaxDistance ≤ 40, never AlwaysOnTop,
-- hidden while seated. Client-only BillboardGui in PlayerGui (Adornee = Chassis), so streaming a vehicle out
-- only blanks it and no server instance or remote is involved. No key names: it shows the vehicle's name only.
local function removePlate(model: Model)
	local g = plates[model]
	if g then
		plates[model] = nil
		g:Destroy()
	end
end

local function seatedNow(): boolean
	if active ~= nil then
		return true
	end
	local ch = localPlayer().Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.SeatPart ~= nil
end

local function plateHeight(model: Model, chassis: BasePart): number
	-- the kit's own label height above the Chassis centre (VehicleService sets WE_LabelY); else the model's top
	local ly = model:GetAttribute("WE_LabelY")
	if typeof(ly) == "number" and ly == ly and ly > 0 then
		return math.min(ly, 30)
	end
	local ok, top = pcall(function(): number
		local cf, size = model:GetBoundingBox()
		return cf.Position.Y + size.Y / 2
	end)
	if ok and typeof(top) == "number" and top == top then
		return math.clamp(top - chassis.Position.Y + 1.2, 1.5, 30)
	end
	return chassis.Size.Y / 2 + 3
end

local function makePlate(model: Model, chassis: BasePart, parent: Instance): BillboardGui
	local text = model.Name
	local g = Instance.new("BillboardGui")
	g.Name = "WE_VehicleNameplate"
	g.Adornee = chassis
	g.AlwaysOnTop = false
	g.LightInfluence = 0
	g.ResetOnSpawn = false
	g.MaxDistance = math.min(40, PLATE.MaxDistance)
	-- width: a fixed px part sized to the name + a small stud part; height: 20 px + 0.4 studs (≈ 23–32 px box)
	local widthPx = math.clamp(#text * 9 + 20, 80, 240)
	g.Size = UDim2.new(PLATE.WidthStuds, widthPx, PLATE.HeightStuds, PLATE.HeightPx)
	g.StudsOffsetWorldSpace = Vector3.new(0, plateHeight(model, chassis), 0)
	local lab = Instance.new("TextLabel")
	lab.Name = "Label"
	lab.Size = UDim2.fromScale(1, 1)
	lab.BackgroundColor3 = Color3.fromRGB(12, 14, 18)
	lab.BackgroundTransparency = 0.35
	lab.BorderSizePixel = 0
	lab.Font = Enum.Font.GothamBold
	lab.TextColor3 = Color3.fromRGB(240, 242, 246)
	lab.TextScaled = true
	lab.Text = text
	lab.Parent = g
	local tc = Instance.new("UITextSizeConstraint")
	tc.MinTextSize = PLATE.MinText
	tc.MaxTextSize = PLATE.MaxText
	tc.Parent = lab
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = lab
	corner(lab, 6)
	g.Parent = parent
	return g
end

local function refreshPlate(inst: Instance)
	if not inst:IsA("Model") then
		return
	end
	local model: Model = inst
	local folder = model.Parent
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis")
	local mine = model:GetAttribute("OwnerUserId") == localPlayer().UserId and model:GetAttribute("VehicleId") ~= nil
	if not mine or folder == nil or folder.Name ~= VEHICLE_FOLDER or not (chassis and chassis:IsA("BasePart")) then
		removePlate(model)
		return
	end
	local gui = plates[model]
	if not gui or gui.Parent == nil or gui.Adornee ~= chassis then
		removePlate(model)
		local pg = localPlayer():FindFirstChildOfClass("PlayerGui")
		if not pg then
			return
		end
		local made = makePlate(model, chassis, pg)
		plates[model] = made
		gui = made
	end
	if not gui then
		return
	end
	local want = not seatedNow()
	if gui.Enabled ~= want then
		gui.Enabled = want
	end
end

local function refreshPlates()
	for model in pairs(plates) do
		if model.Parent == nil then
			removePlate(model)
		end
	end
	local folder = Workspace:FindFirstChild(VEHICLE_FOLDER)
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			refreshPlate(m)
		end
	end
end

local function hookVehicleFolder()
	if promptFolderConn then
		return
	end
	local folder = Workspace:FindFirstChild(VEHICLE_FOLDER)
	if not folder then
		return
	end
	promptFolderConn = folder.DescendantAdded:Connect(function(d: Instance)
		if d.Name == "WE_DrivePrompt" then
			refreshPrompt(d)
		elseif d.Name == "VehicleLabel" then
			suppressServerLabel(d)
		elseif d.Parent == folder then
			task.defer(refreshPlate, d) -- attributes + chassis arrive with the model; defer past its children
		elseif d.Name == "Chassis" and d.Parent and d.Parent.Parent == folder then
			task.defer(refreshPlate, d.Parent) -- streamed in after its model
		end
	end)
	folder.ChildRemoved:Connect(function(child: Instance)
		if child:IsA("Model") then
			removePlate(child)
		end
	end)
	refreshAllPrompts()
	refreshPlates()
end

-- ── HUD ─────────────────────────────────────────────────────────────────────
local function setExitProgress(p: number)
	local f = exitFill
	if f then
		f.Size = UDim2.fromScale(math.clamp(p, 0, 1), 1)
		f.Visible = p > 0
	end
end

local function cancelExitHold()
	exitIo = nil
	setExitProgress(0)
end

local function releaseTouches()
	table.clear(touchOwners)
	touchUp, touchDown = false, false
	for _, b in ipairs({ upBtn, downBtn }) do
		if b then
			b.BackgroundTransparency = 0.3
		end
	end
	cancelExitHold()
end

local function recomputeTouches()
	local up, down = false, false
	for _, which in pairs(touchOwners) do
		if which == "Up" then
			up = true
		elseif which == "Down" then
			down = true
		end
	end
	touchUp, touchDown = up, down
	if upBtn then
		upBtn.BackgroundTransparency = if up then 0.05 else 0.3
	end
	if downBtn then
		downBtn.BackgroundTransparency = if down then 0.05 else 0.3
	end
end

local function makeLiftButton(parent: Instance, name: string, text: string, which: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 24
	b.TextColor3 = Color3.fromRGB(245, 248, 252)
	b.BackgroundColor3 = Color3.fromRGB(42, 48, 55)
	b.BackgroundTransparency = 0.3
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Active = true
	b.Size = UDim2.fromOffset(52, 52)
	b.Parent = parent
	corner(b, 12)
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(230, 190, 60)
	st.Thickness = 1.5
	st.Transparency = 0.3
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	-- hold buttons: track each touch separately so a thumb on the stick does not interfere
	b.InputBegan:Connect(function(io: InputObject)
		local ut = io.UserInputType
		if ut == Enum.UserInputType.Touch or ut == Enum.UserInputType.MouseButton1 then
			touchOwners[io] = which
			recomputeTouches()
		end
	end)
	b.InputEnded:Connect(function(io: InputObject)
		if touchOwners[io] then
			touchOwners[io] = nil
			recomputeTouches()
		end
	end)
	return b
end

-- a finger lifted before Exit.HoldSeconds: the pill says HOLD for a moment instead of exiting
local function exitReleasedEarly(io: InputObject)
	if exitIo == io then
		cancelExitHold()
		exitTapHintUntil = os.clock() + 1.2
	end
end

--[[ P1-7 EXIT pill: hold Exit.HoldSeconds (0.5 s) to leave the vehicle. The same pill in every vehicle, so an
	airborne exit is never one stray tap, and phone players always have a labelled way out. ]]
local function makeExitButton(parent: Instance): TextButton
	local b = Instance.new("TextButton")
	b.Name = "Exit"
	b.Text = ""
	b.BackgroundColor3 = Color3.fromRGB(120, 28, 24)
	b.BackgroundTransparency = 0.2
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Active = true
	b.ClipsDescendants = true
	b.Size = UDim2.fromOffset(90, 50)
	b.Parent = parent
	corner(b, 12)
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(255, 200, 190)
	st.Thickness = 1.5
	st.Transparency = 0.25
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = Color3.fromRGB(255, 120, 100)
	fill.BackgroundTransparency = 0.35
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.Visible = false
	fill.ZIndex = 2
	fill.Parent = b
	exitFill = fill
	local lab = Instance.new("TextLabel")
	lab.Name = "Label"
	lab.BackgroundTransparency = 1
	lab.Size = UDim2.fromScale(1, 1)
	lab.Font = Enum.Font.GothamBold
	lab.TextSize = 18
	lab.TextColor3 = Color3.fromRGB(255, 244, 240)
	lab.Text = "EXIT"
	lab.ZIndex = 3
	lab.Parent = b
	exitLabel = lab
	b.InputBegan:Connect(function(io: InputObject)
		local ut = io.UserInputType
		if (ut == Enum.UserInputType.Touch or ut == Enum.UserInputType.MouseButton1) and exitIo == nil then
			exitIo = io
			exitHoldStart = os.clock()
			exitTapHintUntil = 0
		end
	end)
	b.InputEnded:Connect(function(io: InputObject)
		exitReleasedEarly(io)
	end)
	return b
end

local function ensureHud(): ScreenGui?
	local gui = hudGui
	if gui and gui.Parent then
		return gui
	end
	local pg = localPlayer():FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireVehicleHUD"
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = false
	screen.DisplayOrder = 56 -- above the dock (55), below panels (60)
	screen.Enabled = true

	local p = Instance.new("TextLabel")
	p.Name = "WE_VehiclePill"
	p.AnchorPoint = Vector2.new(0.5, 1)
	p.Position = UDim2.new(0.5, 0, 1, if isTouch then -236 else -64)
	p.Size = UDim2.fromOffset(230, 30)
	p.BackgroundColor3 = Color3.fromRGB(12, 14, 18)
	p.BackgroundTransparency = 0.25
	p.BorderSizePixel = 0
	p.Font = Enum.Font.GothamBold
	p.TextSize = 14
	p.TextColor3 = Color3.fromRGB(245, 248, 252)
	p.RichText = true
	p.Text = ""
	p.Visible = false
	p.Parent = screen
	corner(p, 8)
	pill = p

	local h = Instance.new("TextLabel")
	h.Name = "WE_VehicleHint"
	h.AnchorPoint = Vector2.new(0.5, 1)
	h.Position = UDim2.new(0.5, 0, 1, (if isTouch then -236 else -64) - 36)
	h.Size = UDim2.new(0.92, 0, 0, 26)
	h.BackgroundColor3 = Color3.fromRGB(12, 14, 18)
	h.BackgroundTransparency = 0.35
	h.BorderSizePixel = 0
	h.Font = Enum.Font.Gotham
	h.TextSize = 14 -- ≥ 14 px real (this ScreenGui has no UIScale)
	h.TextColor3 = Color3.fromRGB(255, 210, 90)
	h.TextWrapped = true
	h.Text = ""
	h.Visible = false
	h.Parent = screen
	corner(h, 6)
	local hc = Instance.new("UISizeConstraint")
	hc.MaxSize = Vector2.new(560, 40)
	hc.Parent = h
	hintLabel = h

	-- F7 / fix_spec §2.1: on-device "NO DRIVE" line, debug users only (Drive.Debug), never interactive
	local dg = Instance.new("TextLabel")
	dg.Name = "WE_VehicleDiag"
	dg.AnchorPoint = Vector2.new(0.5, 1)
	dg.Position = UDim2.new(0.5, 0, 1, (if isTouch then -236 else -64) - 72)
	dg.Size = UDim2.new(0.94, 0, 0, 40)
	dg.BackgroundColor3 = Color3.fromRGB(0x3A, 0x0E, 0x0E)
	dg.BackgroundTransparency = 0.2
	dg.BorderSizePixel = 0
	dg.Active = false
	dg.Font = Enum.Font.Code
	dg.TextSize = if isTouch then 11 else 12
	dg.TextColor3 = Color3.fromRGB(0xFF, 0xD7, 0xD0)
	dg.TextWrapped = true
	dg.RichText = false
	dg.Text = ""
	dg.Visible = false
	dg.Parent = screen
	corner(dg, 6)
	local dc = Instance.new("UISizeConstraint")
	dc.MaxSize = Vector2.new(620, 44)
	dc.Parent = dg
	diagLabel = dg

	local cf = Instance.new("Frame")
	cf.Name = "WE_VehicleControls"
	cf.BackgroundTransparency = 1
	cf.Size = UDim2.fromScale(1, 1)
	cf.Active = false
	cf.Visible = false
	cf.Parent = screen
	controlsFrame = cf
	upBtn = makeLiftButton(cf, "LiftUp", "▲", "Up")
	downBtn = makeLiftButton(cf, "LiftDown", "▼", "Down")
	exitBtn = makeExitButton(cf)

	screen.Parent = pg
	hudGui = screen
	return screen
end

local function findJumpButton(): GuiObject?
	local pg = localPlayer():FindFirstChildOfClass("PlayerGui")
	local tg = pg and pg:FindFirstChild("TouchGui")
	if not (tg and tg:IsA("ScreenGui") and tg.Enabled) then
		return nil
	end
	local frame = tg:FindFirstChild("TouchControlFrame")
	local jb = frame and frame:FindFirstChild("JumpButton")
	-- while our airborne lock hides it (JumpHeight 0), keep laying out around its rect so nothing moves
	if
		jb
		and jb:IsA("GuiObject")
		and (jb.Visible or jumpLock ~= nil)
		and typeof(jb.AbsoluteSize) == "Vector2"
		and jb.AbsoluteSize.X > 0
	then
		return jb
	end
	return nil
end

local function layoutControls()
	local gui, ub, db, eb = hudGui, upBtn, downBtn, exitBtn
	if not (gui and ub and db and eb) then
		return
	end
	local vp: Vector2 = gui.AbsoluteSize
	if typeof(vp) ~= "Vector2" or vp.X < 1 or vp.Y < 1 then
		local cam = Workspace.CurrentCamera
		vp = if cam then cam.ViewportSize else Vector2.new(844, 390)
	end
	-- the jump button lives in TouchGui; convert its absolute pixels into this ScreenGui's space
	local origin: Vector2 = gui.AbsolutePosition
	if typeof(origin) ~= "Vector2" then
		origin = Vector2.zero
	end
	local jb = findJumpButton()
	local jpos: Vector2? = nil
	local jsize: Vector2? = nil
	if jb then
		jpos = jb.AbsolutePosition - origin
		jsize = jb.AbsoluteSize
	end
	local L = Laws.ControlsLayout(jpos, jsize, vp, RESERVED_FROM_BOTTOM, controlsLift)
	ub.Position = UDim2.fromOffset(L.Up.Pos.X, L.Up.Pos.Y)
	ub.Size = UDim2.fromOffset(L.Up.Size.X, L.Up.Size.Y)
	db.Position = UDim2.fromOffset(L.Down.Pos.X, L.Down.Pos.Y)
	db.Size = UDim2.fromOffset(L.Down.Size.X, L.Down.Size.Y)
	eb.Position = UDim2.fromOffset(L.Exit.Pos.X, L.Exit.Pos.Y)
	eb.Size = UDim2.fromOffset(L.Exit.Size.X, L.Exit.Size.Y)
	ub.Visible = controlsLift
	db.Visible = controlsLift
end

local function hideControls()
	for _, c in ipairs(layoutConns) do
		c:Disconnect()
	end
	table.clear(layoutConns)
	releaseTouches()
	if controlsFrame then
		controlsFrame.Visible = false
	end
end

local function showControls(lift: boolean)
	if not ensureHud() or not controlsFrame then
		return
	end
	hideControls()
	controlsLift = lift
	layoutControls()
	local cam = Workspace.CurrentCamera
	if cam then
		table.insert(layoutConns, cam:GetPropertyChangedSignal("ViewportSize"):Connect(layoutControls))
	end
	local jb = findJumpButton()
	if jb then
		table.insert(layoutConns, jb:GetPropertyChangedSignal("AbsolutePosition"):Connect(layoutControls))
		table.insert(layoutConns, jb:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutControls))
	end
	;(controlsFrame :: Frame).Visible = true
end

local function hudText(mode: string, hud: Hud?, fallbackSpeed: number, blocked: string?): string
	if blocked then
		return string.format('<font color="#FF5A50">%s</font>', blocked)
	end
	local speed = if hud then hud.Speed else fallbackSpeed
	local text = string.format("SPD %d", math.floor(speed + 0.5))
	if hud and (mode == "Heli" or mode == "Plane") then
		local alt = hud.Alt
		if alt ~= nil and alt < 1e6 then
			text ..= string.format(" · ALT %d", math.max(0, math.floor(alt + 0.5)))
		else
			text ..= " · ALT --"
		end
		if mode == "Plane" and hud.Throttle ~= nil then
			text ..= string.format(" · THR %d%%", math.floor(hud.Throttle * 100 + 0.5))
		end
	end
	local tag = hud and hud.Tag
	if tag then
		local color = if RED_TAGS[tag] then "#FF5A50" else "#FFC850"
		text ..= string.format('  <font color="%s">%s</font>', color, tag)
	end
	return text
end

--[[ Device-aware control hint (spec 3.1), or nil for modes without one. device: true / "Touch" = touch copy (no
	key names), "Gamepad" = pad buttons, false / "KeyboardAndMouse" = keys. ]]
function Laws.HintText(mode: string, device: boolean | string, vto: number): string?
	local spec = HINTS[mode]
	if not spec then
		return nil
	end
	if device == true or device == "Touch" then
		return spec.Touch
	end
	local text = if device == "Gamepad" then spec.Pad else spec.PC
	if mode == "Plane" then
		return string.format(text, math.floor(vto))
	end
	return text
end

local function showHint(mode: string, params: Params)
	if hintShown[mode] or not HINTS[mode] or not ensureHud() then
		return
	end
	local lab = hintLabel
	local text = Laws.HintText(mode, preferredInput(), params.Vto)
	if not lab or not text then
		return
	end
	hintShown[mode] = true
	lab.Text = text
	lab.Visible = true
	hintToken += 1
	local token = hintToken
	task.delay(8, function()
		if hintToken == token and hintLabel then
			hintLabel.Visible = false
		end
	end)
end

-- ── input actions (aircraft only) ───────────────────────────────────────────
local function onLiftAction(_name: string, state: Enum.UserInputState, io: InputObject): Enum.ContextActionResult?
	local down = state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change
	local kc = io.KeyCode
	if kc == Enum.KeyCode.ButtonR2 then
		analog.R2 = if down then math.clamp(io.Position.Z, 0, 1) else 0
	elseif kc == Enum.KeyCode.ButtonL2 then
		analog.L2 = if down then math.clamp(io.Position.Z, 0, 1) else 0
	else
		keyDown[kc] = down
	end
	return Enum.ContextActionResult.Sink
end

--[[ F = leave the aircraft. Setting Humanoid.Jump from an input callback is NOT enough: the PlayerModule
	ControlModule rewrites Humanoid.Jump every render step (RenderPriority.Input) from its own jump keys, and
	Space is sunk by the lift action, so it writes false before the physics step. ChangeState(Jumping) leaves
	the seat directly, and a render-step binding just after the ControlModule re-asserts Jump for a few frames. ]]
local EXIT_STEP = "WE_VehExitJump"
local exitFramesLeft = 0

local function requestExit(hum: Humanoid)
	hum.Jump = true
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
	exitFramesLeft = 4
	pcall(function()
		RunService:UnbindFromRenderStep(EXIT_STEP)
	end)
	pcall(function()
		RunService:BindToRenderStep(EXIT_STEP, Enum.RenderPriority.Input.Value + 1, function()
			exitFramesLeft -= 1
			if exitFramesLeft >= 0 and hum.Parent ~= nil and hum.SeatPart ~= nil then
				hum.Jump = true
			else
				pcall(function()
					RunService:UnbindFromRenderStep(EXIT_STEP)
				end)
			end
		end)
	end)
end

--[[ P1-7 airborne jump lock. JumpHeight (and JumpPower) 0 hides the Roblox touch jump button and stops a stray jump
	from leaving the seat mid-air; the exit paths below put the saved values back before they jump. Only values we
	zeroed are restored (a value someone else changed meanwhile is left alone). ]]
local function lockJump(hum: Humanoid)
	if jumpLock ~= nil then
		return
	end
	local okH, h = pcall(function(): any
		return hum.JumpHeight
	end)
	local okP, p = pcall(function(): any
		return hum.JumpPower
	end)
	local height: number = if okH and typeof(h) == "number" then h else 7.2
	local power: number = if okP and typeof(p) == "number" then p else 50
	jumpLock = { Hum = hum, Height = height, Power = power }
	pcall(function()
		hum.JumpHeight = 0
		hum.JumpPower = 0
	end)
end

local function unlockJump()
	local j = jumpLock
	if j == nil then
		return
	end
	jumpLock = nil
	pcall(function()
		if j.Hum.JumpHeight == 0 then
			j.Hum.JumpHeight = j.Height
		end
		if j.Hum.JumpPower == 0 then
			j.Hum.JumpPower = j.Power
		end
	end)
end

--[[ Leave the vehicle: jump back on, ask the server to eject (F4d: works even while the server owns the car's
	assembly) and jump locally (requestExit). Used by the EXIT pill and by F. ]]
local function exitVehicle(d: Drive)
	unlockJump()
	local now = os.clock()
	if not d.Blocked and now - d.LastExitAt >= EXIT.RequestGapSeconds then
		d.LastExitAt = now
		sendDriveInput({ K = "Exit", V = d.VehicleId })
	end
	requestExit(d.Humanoid)
end

local function onExitAction(_name: string, state: Enum.UserInputState, _io: InputObject): Enum.ContextActionResult?
	if state == Enum.UserInputState.Begin then
		local d = active
		if d then
			exitVehicle(d)
		end
	end
	return Enum.ContextActionResult.Sink
end

--[[ F4d: the Roblox jump button / Space / gamepad A (UserInputService.JumpRequest) also asks the server to eject,
	so jump exits even when the seated character's assembly is server-owned (Fallback / correction). Aircraft:
	never while airborne (the EXIT pill hold or F is the way out up there), and never on Space (Space = climb). ]]
local function onJumpRequest(d: Drive)
	if active ~= d or d.Blocked then
		return
	end
	local now = os.clock()
	if now - d.StartedAt < 0.3 or now - d.LastExitAt < EXIT.RequestGapSeconds then
		return
	end
	if d.Mode == "Heli" or d.Mode == "Plane" then
		if d.AirLocked then
			return
		end
		local okK, spaceDown = pcall(function(): boolean
			return UserInputService:IsKeyDown(Enum.KeyCode.Space)
		end)
		if (okK and spaceDown) or keyDown[Enum.KeyCode.Space] == true then
			return
		end
	end
	d.LastExitAt = now
	sendDriveInput({ K = "Exit", V = d.VehicleId })
end

-- per frame while driving: the EXIT pill's hold progress; fires exitVehicle at Exit.HoldSeconds
local function updateExitHold(d: Drive, now: number)
	local lab = exitLabel
	if lab then
		local want = if exitIo == nil and now < exitTapHintUntil then "HOLD" else "EXIT"
		if lab.Text ~= want then
			lab.Text = want
		end
	end
	if exitIo == nil then
		return
	end
	local hold = math.max(0.05, EXIT.HoldSeconds)
	local p = (now - exitHoldStart) / hold
	if p >= 1 then
		cancelExitHold()
		exitVehicle(d)
	else
		setExitProgress(p)
	end
end

-- P1-7: Heli/Plane more than Exit.LockAGL above the ground → JumpHeight 0 (5 Hz ray; hysteresis to UnlockAGL)
local function updateAirLock(d: Drive, now: number)
	if d.Mode ~= "Heli" and d.Mode ~= "Plane" then
		return
	end
	if now < d.NextAirCheck then
		return
	end
	d.NextAirCheck = now + 0.2
	local agl = groundAGL(d.Chassis.Position, d.Params.Clearance)
	if d.AirLocked then
		if agl <= EXIT.UnlockAGL then
			d.AirLocked = false
			unlockJump()
		end
	elseif agl > EXIT.LockAGL then
		d.AirLocked = true
		lockJump(d.Humanoid)
	end
end

local function unbindActions()
	for _, name in ipairs({ ACTION_UP, ACTION_DOWN, ACTION_STRAFE, ACTION_EXIT }) do
		pcall(function()
			ContextActionService:UnbindAction(name)
		end)
	end
	table.clear(keyDown)
	analog.R2 = 0
	analog.L2 = 0
end

local function bindAircraftActions(mode: string)
	unbindActions()
	local hi = Enum.ContextActionPriority.High.Value
	ContextActionService:BindActionAtPriority(ACTION_UP, onLiftAction, false, hi, Enum.KeyCode.Space, Enum.KeyCode.ButtonR2)
	ContextActionService:BindActionAtPriority(
		ACTION_DOWN,
		onLiftAction,
		false,
		hi,
		Enum.KeyCode.LeftControl,
		Enum.KeyCode.C,
		Enum.KeyCode.ButtonL2
	)
	if mode == "Heli" then
		ContextActionService:BindActionAtPriority(
			ACTION_STRAFE,
			onLiftAction,
			false,
			hi,
			Enum.KeyCode.Z,
			Enum.KeyCode.X,
			Enum.KeyCode.ButtonL1,
			Enum.KeyCode.ButtonR1
		)
	end
	-- v70: gamepad B also exits (jump is locked while airborne, so pads need their own bail-out)
	ContextActionService:BindActionAtPriority(ACTION_EXIT, onExitAction, false, hi, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
end

--[[ F4a: the PlayerModule's ControlModule (GetControls). Looked up lazily (never at require time) and retried every
	2 s while missing, so a late PlayerModule still gets picked up. ]]
local function playerControls(): any
	if controls ~= nil then
		return controls
	end
	local now = os.clock()
	if now < nextControlsTry then
		return nil
	end
	nextControlsTry = now + 2
	local ok, c = pcall(function(): any
		local ps = localPlayer():FindFirstChildOfClass("PlayerScripts")
		local pm = ps and ps:FindFirstChild("PlayerModule")
		if pm and pm:IsA("ModuleScript") then
			local req: any = require
			return req(pm):GetControls()
		end
		return nil
	end)
	controls = if ok then c else nil
	return controls
end

--[[ Seat floats first (the PlayerModule VehicleController writes them from the same stick/WASD vector); when both
	are ~0, the ControlModule's move vector directly (ThrottleFloat = -Z, SteerFloat = X), so a missed client
	Humanoid.Seated (the VehicleController never switched on) no longer means zero throttle. ]]
local function readRaw(d: Drive): RawInput
	local t, s, src = tonumber(d.Seat.ThrottleFloat) or 0, tonumber(d.Seat.SteerFloat) or 0, "seat"
	if math.abs(t) < 0.05 and math.abs(s) < 0.05 then
		local c = playerControls()
		if c then
			local ok, mv = pcall(c.GetMoveVector, c)
			if ok and typeof(mv) == "Vector3" and mv.Magnitude > 0.05 then
				t, s, src = -mv.Z, mv.X, "stick"
			end
		end
	end
	d.InputSrc = if math.abs(t) < 0.05 and math.abs(s) < 0.05 then "none" else src
	return {
		Throttle = t,
		Steer = s,
		Up = keyDown[Enum.KeyCode.Space] == true,
		Down = keyDown[Enum.KeyCode.LeftControl] == true or keyDown[Enum.KeyCode.C] == true,
		TouchUp = touchUp,
		TouchDown = touchDown,
		R2 = analog.R2,
		L2 = analog.L2,
		Left = keyDown[Enum.KeyCode.Z] == true or keyDown[Enum.KeyCode.ButtonL1] == true,
		Right = keyDown[Enum.KeyCode.X] == true or keyDown[Enum.KeyCode.ButtonR1] == true,
	}
end

-- ── the drive loop ──────────────────────────────────────────────────────────
local function locateMovers(d: Drive)
	local lv = d.Chassis:FindFirstChild("WE_DriveLV")
	local ao = d.Chassis:FindFirstChild("WE_DriveAO")
	d.LV = if lv and lv:IsA("LinearVelocity") then lv else nil
	d.AO = if ao and ao:IsA("AlignOrientation") then ao else nil
end

local function buildSense(d: Drive): Sense
	local cf = d.Chassis.CFrame
	local pos = cf.Position
	local look = cf.LookVector
	local sense: Sense = {
		Position = pos,
		Velocity = d.Chassis.AssemblyLinearVelocity,
		Yaw = math.atan2(-look.X, -look.Z),
		UpY = cf.UpVector.Y,
		-- only aircraft use AGL (cars and boats skip the long ray)
		AGL = if d.Mode == "Heli" or d.Mode == "Plane" then groundAGL(pos, d.Params.Clearance) else math.huge,
		Time = os.clock(),
		Look = look,
	}
	if d.Mode == "Boat" then
		sense.WaterY = Laws.WaterSurfaceAt(waterParts, pos, 0, landProbe)
	end
	return sense
end

local function applyOut(d: Drive, out: Out)
	local lv, ao = d.LV, d.AO
	if not (lv and ao) then
		return
	end
	lv.VectorVelocity = out.Velocity
	local cur = lv.MaxAxesForce
	local F = cur.X
	local wantY = if out.HoldVertical then F else 0
	if cur.Y ~= wantY or cur.Z ~= F then
		lv.MaxAxesForce = Vector3.new(F, wantY, F)
	end
	ao.CFrame = out.Orientation
end

local stopDrive: () -> ()

local function sendHello(d: Drive)
	d.HelloSent += 1
	d.LastHelloAt = os.clock()
	sendDriveInput({ K = "Hello", V = d.VehicleId, P = PROTOCOL_VERSION })
end

local function round2(x: number): number
	return math.floor(x * 100 + 0.5) / 100
end

--[[ F4b: the composed input to the server ({K="In", V, T, S, L}, 2 decimals) at Drive.Watchdog.StreamHz while any
	axis is non-zero, one zero message on release, nothing while idle, under every authority (it feeds the
	server-driven fallback). ~10 × 40 bytes/s per driver; the server rate-limits it on its own key. ]]
local function streamInput(d: Drive, input: Input, now: number)
	local hz = tonumber(W.StreamHz) or 0
	if hz <= 0 then
		return
	end
	local t, s, l = input.Throttle, input.Steer, input.Lift
	if math.abs(t) > 0.05 or math.abs(s) > 0.05 or math.abs(l) > 0.05 then
		-- 0.98: a 60 Hz Heartbeat sends on every 6th frame (10 Hz), never faster than ~10.2 Hz
		if now - d.LastStreamAt >= 0.98 / hz then
			d.LastStreamAt = now
			d.StreamZeroSent = false
			sendDriveInput({ K = "In", V = d.VehicleId, T = round2(t), S = round2(s), L = round2(l) })
		end
	elseif not d.StreamZeroSent then
		d.StreamZeroSent = true
		d.LastStreamAt = now
		sendDriveInput({ K = "In", V = d.VehicleId, T = 0, S = 0, L = 0 })
	end
end

local function receiveAge(p: BasePart): number?
	local ok, v = pcall(function(): any
		return (p :: any).ReceiveAge
	end)
	return if ok and typeof(v) == "number" then v else nil
end

local function signed(x: number): string
	return string.format("%+.2f", x)
end

-- the server's WE_Diag "k=v k=v" string → map (debug users only; F5j)
local function parseDiag(model: Model): { [string]: string }
	local out: { [string]: string } = {}
	local raw = model:GetAttribute("WE_Diag")
	if typeof(raw) == "string" then
		for k, v in string.gmatch(raw, "(%w+)=(%S+)") do
			if k and v then
				out[k] = v
			end
		end
	end
	return out
end

-- fix_spec §2.1: the two NO DRIVE lines, each value from its named source
local function diagText(d: Drive, input: Input, auth: any, spd: number): string
	local sv = parseDiag(d.Model)
	local srvIn = sv["in"]
	if srvIn then
		srvIn = string.match(srvIn, "^([^/]+)") or srvIn
	end
	local fail = d.Model:GetAttribute("WE_DriveFail")
	local lvMag = 0
	local lv = d.LV
	if lv then
		lvMag = lv.VectorVelocity.Magnitude
	end
	local age = receiveAge(d.Chassis)
	local rcv = if age == nil then "rep?" elseif age < 0.05 then "sim" else string.format("rep%.2f", age)
	return string.format(
		"NO DRIVE · auth=%s · own=%s · hello=%s · fail=%s\nin %s/%s (%s) · srvIn %s · lv %d · spd %.1f · rcv %s · pins %s · npc %s · %s",
		tostring(auth),
		sv.own or "?",
		sv.hello or "?",
		if typeof(fail) == "string" and fail ~= "" then fail else "-",
		signed(input.Throttle),
		signed(input.Steer),
		d.InputSrc,
		srvIn or "?",
		math.floor(lvMag + 0.5),
		spd,
		rcv,
		sv.pins or "?",
		sv.npc or "?",
		d.Seat.Name
	)
end

--[[ F4c + F7, every frame: is the driver pushing while the vehicle does not move?
	Every player: one {K="Stuck"} per sit after Exit.StuckSeconds under Client authority (feeds the server watchdog).
	Debug users (Drive.Debug): the WE_VehicleDiag line, up while stuck and Debug.ShowSeconds after, 4 Hz text. ]]
--[[ "The driver is asking this vehicle to move" (same idea as VehicleService's watchdog `pushing`): |throttle| > 0.5
	for cars and boats; a plane only on forward throttle (brake / ▲ at rest never move it, by design); a helicopter on
	▲, or on the stick while it is not sitting landed (a landed heli never taxis on the stick alone, by design). ]]
local function pushing(d: Drive, input: Input): boolean
	if d.Mode == "Heli" then
		local st = d.State
		return input.Lift > 0.5 or (math.abs(input.Throttle) > 0.5 and not (st ~= nil and st.Landed))
	elseif d.Mode == "Plane" then
		return input.Throttle > 0.5
	end
	return math.abs(input.Throttle) > 0.5
end

local function watchClient(d: Drive, input: Input, auth: any, dt: number, now: number)
	local v = d.Chassis.AssemblyLinearVelocity
	local air = d.Mode == "Heli" or d.Mode == "Plane"
	local spd = if air then v.Magnitude else Vector3.new(v.X, 0, v.Z).Magnitude
	local push = pushing(d, input)
	d.NoDriveFor = if push and spd < DBG.NoDriveSpeed then d.NoDriveFor + dt else 0
	d.MovedFor = if spd >= 3 then d.MovedFor + dt else 0
	-- the Stuck clock only runs under Client authority (a car stuck in server drive is the server's to report)
	d.StuckFor = if push and spd < EXIT.StuckSpeed and auth == "Client" then d.StuckFor + dt else 0
	if not d.StuckSent and d.StuckFor >= EXIT.StuckSeconds then
		d.StuckSent = true
		local age = receiveAge(d.Chassis)
		sendDriveInput({
			K = "Stuck",
			V = d.VehicleId,
			T = round2(input.Throttle),
			Spd = math.floor(spd * 10 + 0.5) / 10,
			R = if age ~= nil and age < 0.05 then "sim" else "rep",
			Src = d.InputSrc,
		})
	end
	local lab = diagLabel
	if not debugUser or not lab then
		return
	end
	if d.NoDriveFor >= DBG.NoDriveSeconds then
		d.DiagUntil = now + DBG.ShowSeconds
	end
	if d.MovedFor >= 1 then
		d.DiagUntil = 0
	end
	local show = now < d.DiagUntil
	d.DiagAcc += dt
	if show and (d.DiagAcc >= 0.25 or not lab.Visible) then
		d.DiagAcc = 0
		lab.Text = diagText(d, input, auth, spd)
	end
	if lab.Visible ~= show then
		lab.Visible = show
	end
end

local function updateHud(d: Drive, dt: number, hud: Hud?)
	d.HudAcc += dt
	if d.HudAcc < 0.1 then
		return
	end
	d.HudAcc = 0
	local p = pill
	if not p then
		return
	end
	local v = d.Chassis.AssemblyLinearVelocity
	local fallback = if d.Mode == "Heli" or d.Mode == "Plane" then v.Magnitude else Vector3.new(v.X, 0, v.Z).Magnitude
	-- F6: cars and boats show the ACTUAL flat speed (a frozen car honestly reads SPD 0; the law's commanded speed
	-- saws 6-14 against a blocked chassis). Aircraft keep the law's HUD (ALT / THR / STALL).
	local shown = hud
	if d.Mode == "Car" or d.Mode == "Boat" then
		shown = { Speed = fallback, Tag = if hud then hud.Tag else nil }
	end
	p.Text = hudText(d.Mode, shown, fallback, d.Blocked)
	p.Visible = true
end

local function stepDrive(d: Drive, dt: number)
	if active ~= d then
		return
	end
	local hum = d.Humanoid
	if not d.Model.Parent or hum.SeatPart ~= d.Seat or hum.Health <= 0 then
		stopDrive()
		return
	end
	dt = math.clamp(dt, 0, 0.1)
	local now = os.clock()
	updateAirLock(d, now)
	updateExitHold(d, now)
	if active ~= d then
		return -- the EXIT hold just fired and the seat is already gone
	end
	if d.Blocked then
		updateHud(d, dt, nil)
		return
	end
	if (not d.LV or not d.AO or not (d.LV :: LinearVelocity).Parent) and now - d.LastMoverLookAt > 0.5 then
		d.LastMoverLookAt = now
		locateMovers(d)
	end
	-- F4e: the input is read every frame under every authority (stream + stuck report + diagnostic)
	local input = Laws.ComposeInput(d.Mode, readRaw(d))
	streamInput(d, input, now)
	local auth = d.Model:GetAttribute("WE_DriveAuthority")
	watchClient(d, input, auth, dt, now)
	if auth ~= "Client" or not d.LV or not d.AO then
		d.WasClient = false
		if d.HelloSent < HELLO_MAX and now - d.LastHelloAt >= HELLO_RETRY_SECONDS then
			sendHello(d)
		end
		updateHud(d, dt, nil)
		return
	end
	local sense = buildSense(d)
	local st = d.State
	if not d.WasClient or st == nil then
		st = Laws.NewState(d.Params, sense)
		d.State = st
		d.WasClient = true
	end
	local state = st :: State
	if d.Mode == "Boat" then
		local dir, near, far = Laws.ProbeDistances(state, d.Params, input)
		local f = fwd(state.Heading) * dir
		sense.WaterNear = Laws.WaterSurfaceAt(waterParts, sense.Position + f * near, 0, landProbe) ~= nil
		sense.WaterFar = Laws.WaterSurfaceAt(waterParts, sense.Position + f * far, 0, landProbe) ~= nil
	end
	local out = Laws.Step(state, d.Params, input, sense, dt)
	applyOut(d, out)
	updateHud(d, dt, out.Hud)
end

stopDrive = function()
	local d = active
	if not d then
		return
	end
	active = nil
	for _, c in ipairs(d.Conns) do
		c:Disconnect()
	end
	unbindActions()
	hideControls()
	unlockJump()
	if pill then
		pill.Visible = false
	end
	if hintLabel then
		hintLabel.Visible = false
	end
	if diagLabel then
		diagLabel.Visible = false
	end
	pcall(function()
		localPlayer():SetAttribute("WE_DriveMode", nil)
	end)
	if not d.Blocked then
		sendDriveInput({ K = "Bye", V = d.VehicleId })
	end
	refreshAllPrompts()
	refreshPlates()
end

-- server attributes that never change the drive law (the diagnostic ones change at 2 Hz for debug users)
local NON_PARAM_ATTRS: { [string]: boolean } = {
	WE_DriveAuthority = true,
	WE_DriverUserId = true,
	WE_Diag = true,
	WE_DriveFail = true,
	WE_GroundDrive = true,
}

local function startDrive(hum: Humanoid, seat: VehicleSeat)
	local cur = active
	if cur and cur.Seat == seat and cur.Humanoid == hum then
		return
	end
	if cur then
		stopDrive()
	end
	local model = vehicleModelOf(seat)
	if not model then
		return
	end
	if model:GetAttribute("OwnerUserId") ~= localPlayer().UserId then
		return -- the server ejects non-owners from the driver seat
	end
	local modeAttr = model:GetAttribute("WE_DriveMode")
	if typeof(modeAttr) ~= "string" or not VALID_MODES[modeAttr] then
		return -- pre-v70 server: its own drive loop handles the seat
	end
	local mode: string = modeAttr
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis")
	if not (chassis and chassis:IsA("BasePart")) then
		return
	end
	local vid = model:GetAttribute("VehicleId")
	local d: Drive = {
		Model = model,
		Seat = seat,
		Chassis = chassis,
		Humanoid = hum,
		Mode = mode,
		VehicleId = if typeof(vid) == "string" then vid else "",
		Params = Laws.BuildParams(mode, model:GetAttributes(), driveCfg),
		State = nil,
		LV = nil,
		AO = nil,
		WasClient = false,
		HelloSent = 0,
		LastHelloAt = 0,
		LastMoverLookAt = 0,
		HudAcc = 1,
		Blocked = nil,
		Conns = {},
		InputSrc = "none",
		LastStreamAt = 0,
		StreamZeroSent = true,
		NoDriveFor = 0,
		StuckFor = 0,
		MovedFor = 0,
		StuckSent = false,
		DiagUntil = 0,
		DiagAcc = 0,
		LastExitAt = 0,
		StartedAt = os.clock(),
		AirLocked = false,
		NextAirCheck = 0,
	}
	local proto = model:GetAttribute("WE_ProtocolVersion")
	if typeof(proto) == "number" and proto ~= PROTOCOL_VERSION then
		d.Blocked = "Rejoin to update"
	end
	refreshConfig()
	if controls == nil then
		nextControlsTry = 0
	end
	playerControls() -- F4a warm-up (never at require time)
	locateMovers(d)
	active = d
	pcall(function()
		localPlayer():SetAttribute("WE_DriveMode", mode)
	end)
	ensureHud()
	refreshRayFilter()
	local air = mode == "Heli" or mode == "Plane"
	if isTouch then
		showControls(air and not d.Blocked) -- the EXIT pill in every vehicle; ▲▼ for aircraft
	end
	if not d.Blocked then
		if air then
			bindAircraftActions(mode)
			showHint(mode, d.Params)
		end
		sendHello(d)
		table.insert(
			d.Conns,
			model.AttributeChanged:Connect(function(attr: string)
				if not NON_PARAM_ATTRS[attr] and string.sub(attr, 1, 3) == "WE_" then
					d.Params = Laws.BuildParams(d.Mode, model:GetAttributes(), driveCfg)
				end
			end)
		)
	end
	-- F4d: jump (touch button / Space / pad A) also asks the server to eject
	pcall(function()
		local jr: any = (UserInputService :: any).JumpRequest
		if jr then
			table.insert(
				d.Conns,
				jr:Connect(function()
					onJumpRequest(d)
				end)
			)
		end
	end)
	table.insert(
		d.Conns,
		RunService.Heartbeat:Connect(function(dt: number)
			stepDrive(d, dt)
		end)
	)
	refreshAllPrompts()
	refreshPlates()
end

local function checkSeat(hum: Humanoid)
	local sp = hum.SeatPart
	if sp and sp:IsA("VehicleSeat") and sp.Name == "DriverSeat" then
		startDrive(hum, sp)
	end
end

local function bindCharacter(char: Model)
	local h = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
	if not (h and h:IsA("Humanoid")) then
		return
	end
	local hum: Humanoid = h
	hum.Seated:Connect(function(isSeated: boolean, seatPart: BasePart?)
		if isSeated and seatPart and seatPart:IsA("VehicleSeat") and seatPart.Name == "DriverSeat" then
			startDrive(hum, seatPart)
		else
			local d = active
			if d and d.Humanoid == hum then
				stopDrive()
			end
		end
		refreshPlates() -- P1-8: nameplates hide while seated anywhere
	end)
	checkSeat(hum)
	refreshPlates()
end

-- test hook: device class is read once in Init; the headless tests flip it to cover the touch layout
function VehicleDriveClient._SetTouch(value: boolean)
	isTouch = value
	deviceOverride = if value then "Touch" else nil
	local y = if isTouch then -236 else -64
	if pill then
		pill.Position = UDim2.new(0.5, 0, 1, y)
	end
	if hintLabel then
		hintLabel.Position = UDim2.new(0.5, 0, 1, y - 36)
	end
	if diagLabel then
		diagLabel.Position = UDim2.new(0.5, 0, 1, y - 72)
		diagLabel.TextSize = if isTouch then 11 else 12
	end
end

-- test hooks (headless): the ControlModule stand-in for F4a, and the current jump lock
function VehicleDriveClient._SetControls(c: any)
	controls = c
	nextControlsTry = 0
end

function VehicleDriveClient._JumpLocked(): boolean
	return jumpLock ~= nil
end

function VehicleDriveClient.IsDriving(): boolean
	return active ~= nil
end

function VehicleDriveClient.ActiveMode(): string?
	local d = active
	return if d then d.Mode else nil
end

function VehicleDriveClient.Init()
	if initialized then
		return
	end
	initialized = true
	-- on-screen touch controls whenever the device can touch (they agree with HudLayout's touch reserve);
	-- the COPY follows PreferredInput (preferredInput()), so a phone never sees a key name
	isTouch = UserInputService.TouchEnabled or preferredInput() == "Touch"
	loadShared()
	refreshConfig()
	local wcfg: any = if typeof(driveCfg) == "table" then driveCfg.Water else nil
	waterBelow = cfgNumber(wcfg, "QueryBelow") or waterBelow
	waterAbove = cfgNumber(wcfg, "QueryAbove") or waterAbove
	landProbeHeight = cfgNumber(wcfg, "LandProbeHeight") or landProbeHeight
	waterRefreshSeconds = math.max(0.5, cfgNumber(wcfg, "RefreshSeconds") or waterRefreshSeconds)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	rayParams = params

	refreshWater()
	CollectionService:GetInstanceAddedSignal(waterTag):Connect(refreshWater)
	CollectionService:GetInstanceRemovedSignal(waterTag):Connect(refreshWater)
	refreshRayFilter()

	UserInputService.TouchEnded:Connect(function(io: InputObject)
		if touchOwners[io] then
			touchOwners[io] = nil
			recomputeTouches()
		end
		exitReleasedEarly(io)
	end)
	UserInputService.InputEnded:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.MouseButton1 then
			if touchOwners[io] then
				touchOwners[io] = nil
				recomputeTouches()
			end
			exitReleasedEarly(io)
		end
	end)

	local plr = localPlayer()
	plr.CharacterAdded:Connect(function(char: Model)
		task.spawn(bindCharacter, char)
	end)
	plr.CharacterRemoving:Connect(function()
		stopDrive()
	end)
	if plr.Character then
		task.spawn(bindCharacter, plr.Character)
	end
	Workspace.ChildAdded:Connect(function(child: Instance)
		if child.Name == VEHICLE_FOLDER then
			hookVehicleFolder()
		end
	end)
	hookVehicleFolder()

	-- light reconcile: late Seated events, water/filter lists, the vehicles folder
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.5)
			acc += 0.5
			if not active then
				local ch = plr.Character
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				if h then
					checkSeat(h)
				end
			end
			if acc >= waterRefreshSeconds then
				acc = 0
				refreshWater()
				refreshRayFilter()
				hookVehicleFolder()
				refreshPlates() -- children of the vehicles folder only (no descendant scan)
			end
		end
	end)
end

return VehicleDriveClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="183">
            <Properties>
              <string name="Name">WorldSpinners</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v68: rotates radar dishes and other "WE_Spinner" Models (built by the server's HollowBuildingBuilder
	api.spin) around a vertical axis. Purely visual and local: the server copies stay still, so nothing
	replicates per frame. Only spinners within SPIN_RANGE of the camera are updated.

	Model attributes: WE_SpinPivot (CFrame, world) and WE_SpinRPM (number).
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local WorldSpinners = {}

local TAG = "WE_Spinner"
local SPIN_RANGE = 320

type Spinner = {
	pivot: CFrame,
	rate: number, -- radians per second
	angle: number,
	parts: { [BasePart]: CFrame }, -- part → offset from the pivot at angle 0
}

local spinners: { [Model]: Spinner } = {}

local function addPart(s: Spinner, p: Instance)
	if p:IsA("BasePart") and not s.parts[p] then
		-- the server built it at angle 0, so its current CFrame is the rest pose
		s.parts[p] = s.pivot:ToObjectSpace(p.CFrame)
	end
end

local function track(m: Instance)
	if not m:IsA("Model") or spinners[m] then
		return
	end
	local pivot = m:GetAttribute("WE_SpinPivot")
	local rpm = m:GetAttribute("WE_SpinRPM")
	if typeof(pivot) ~= "CFrame" or typeof(rpm) ~= "number" then
		return
	end
	local s: Spinner = { pivot = pivot, rate = rpm * math.pi * 2 / 60, angle = 0, parts = {} }
	spinners[m] = s
	for _, d in ipairs(m:GetDescendants()) do
		addPart(s, d)
	end
	-- StreamingEnabled can deliver parts after the Model
	m.DescendantAdded:Connect(function(d: Instance)
		local cur = spinners[m]
		if cur then
			-- a late part arrives in its rest pose; store its offset as if at angle 0
			if d:IsA("BasePart") and not cur.parts[d] then
				cur.parts[d] = cur.pivot:ToObjectSpace(d.CFrame)
			end
		end
	end)
end

function WorldSpinners.Init()
	for _, m in ipairs(CollectionService:GetTagged(TAG)) do
		track(m)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(m: Instance)
		-- attributes are set before the tag, but wait a frame for children on slow joins
		task.defer(track, m)
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(m: Instance)
		if m:IsA("Model") then
			spinners[m] = nil
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		local cam = Workspace.CurrentCamera
		local camPos = if cam then cam.CFrame.Position else Vector3.zero
		for m, s in pairs(spinners) do
			if m.Parent == nil then
				spinners[m] = nil
			elseif (s.pivot.Position - camPos).Magnitude <= SPIN_RANGE then
				s.angle = (s.angle + s.rate * dt) % (math.pi * 2)
				local frame = s.pivot * CFrame.Angles(0, s.angle, 0)
				for p, offset in pairs(s.parts) do
					if p.Parent then
						p.CFrame = frame * offset
					else
						s.parts[p] = nil
					end
				end
			end
		end
	end)
end

return WorldSpinners
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="184">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>