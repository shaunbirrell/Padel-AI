        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">SupplyDropConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic Supply Drops (loot-crate theme) — stand near crate to claim Cash.
	World spawns only; not a paid RNG loot box (see LootBoxConfig.PolicyPending).
]]

local SupplyDropConfig = {
	Enabled = true,
	SpawnIntervalSeconds = 90,
	MaxActive = 3,
	LifetimeSeconds = 75,
	ClaimHoldSeconds = 2.5,
	ClaimRadius = 10,
	CashMin = 2500,
	CashMax = 12000,
	-- Prefer WE_EventSpawn pads; else scatter on open ground
	ScatterRadius = 900,
	ScatterMinDistanceFromOrigin = 120,
	CrateSize = Vector3.new(5, 4, 5),
	CrateColor = Color3.fromRGB(210, 160, 55),
	BeaconColor = Color3.fromRGB(255, 200, 80),
}

return SupplyDropConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">TerritoryConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Territories + coastal oil platforms with capture stipends. ]]

export type TerritoryDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	CaptureTimeSeconds: number,
	BonusType: string,
	BonusValue: number,
	Position: Vector3,
	Radius: number,
	Color: Color3,
	StipendCash: number?,
	IsOilRig: boolean?,
	IsFortress: boolean?,
	GuardNPCType: string?,
	GuardCount: number?,
}

local TerritoryConfig = {
	-- Balance knobs
	MaxPersonalTerritories = 6, -- oil + fortresses + land POIs
	ProtectionPeriodSeconds = 45,
	CaptureTickSeconds = 0.5,
	ProgressDecayPerSecond = 0.35,
	ContestedProgressMult = 0,
	ContestedDecayMult = 0.5,
	ProtectedCaptureMult = 0.25,
	RadarRevealRadius = 550,
	NPCOwnerId = -1,
	NeutralOwnerId = 0,
	-- v70 waterways: vehicle passengers neither capture nor contest (only the driver of a vehicle counts), so a crewed
	-- boat or jeep no longer contests its own capture. Naval outposts (oil rigs): WaterConfig.NavalOutposts.
	VehiclePassengersCount = false,

	-- Periodic stipend for owned territories (MT-style ~every 90s)
	CaptureStipend = {
		TickSeconds = 90,
		DefaultCash = 4000,
		OilRigCash = 14000,
		FortressCash = 10000,
		NotifyOnPayout = false, -- v71 (HUD v70 spec §4.2): silent — the cash pill counts up; no toast every 90 s
	},

	OwnerTypes = {
		Neutral = "Neutral",
		Player = "Player",
		NPC = "NPC",
		Clan = "Clan",
		Contested = "Contested",
	},

	Territories = {
		CentralPlaza = {
			Id = "CentralPlaza",
			DisplayName = "Central Plaza",
			Description = "+10% Cash from passive income while controlled.",
			CaptureTimeSeconds = 20,
			BonusType = "PassiveCashMult",
			BonusValue = 0.10,
			Position = Vector3.new(0, 1, 0),
			Radius = 70,
			Color = Color3.fromRGB(200, 200, 80),
			StipendCash = 5000,
		},
		NorthRidge = {
			Id = "NorthRidge",
			DisplayName = "North Ridge",
			Description = "+5% XP from all sources.",
			CaptureTimeSeconds = 25,
			BonusType = "XPMult",
			BonusValue = 0.05,
			Position = Vector3.new(0, 1, -1300),
			Radius = 60,
			Color = Color3.fromRGB(80, 160, 220),
			StipendCash = 4000,
		},
		SouthDocks = {
			Id = "SouthDocks",
			DisplayName = "South Docks",
			Description = "+15% mission cash rewards.",
			CaptureTimeSeconds = 25,
			BonusType = "MissionCashMult",
			BonusValue = 0.15,
			Position = Vector3.new(0, 1, 1300),
			Radius = 60,
			Color = Color3.fromRGB(70, 140, 180),
			StipendCash = 4000,
		},
		EastArmory = {
			Id = "EastArmory",
			DisplayName = "East Armory",
			Description = "+10% weapon damage.",
			CaptureTimeSeconds = 30,
			BonusType = "DamageMult",
			BonusValue = 0.10,
			Position = Vector3.new(1300, 1, 0),
			Radius = 55,
			Color = Color3.fromRGB(200, 80, 80),
			StipendCash = 4500,
		},
		WestDepot = {
			Id = "WestDepot",
			DisplayName = "West Depot",
			Description = "Vehicle spawn cooldown -20%.",
			CaptureTimeSeconds = 30,
			BonusType = "VehicleCooldownMult",
			BonusValue = -0.20,
			Position = Vector3.new(-1300, 1, 0),
			Radius = 55,
			Color = Color3.fromRGB(100, 180, 100),
			StipendCash = 4500,
		},
		OilFields = {
			Id = "OilFields",
			DisplayName = "Oil Fields",
			Description = "+50 Cash per passive tick.",
			CaptureTimeSeconds = 35,
			BonusType = "FlatPassiveCash",
			BonusValue = 50,
			Position = Vector3.new(950, 1, 950),
			Radius = 65,
			Color = Color3.fromRGB(180, 140, 60),
			StipendCash = 6000,
		},
		RadarHill = {
			Id = "RadarHill",
			DisplayName = "Radar Hill",
			Description = "Enemy radar: highlight nearby hostile players within range.",
			CaptureTimeSeconds = 40,
			BonusType = "MinimapReveal",
			BonusValue = 1,
			Position = Vector3.new(-950, 1, -950),
			Radius = 60,
			Color = Color3.fromRGB(160, 100, 200),
			StipendCash = 5500,
		},
		-- Coastal oil platforms (MT-inspired ×2 oil; WAR EMPIRE naming)
		CoastalOilAlpha = {
			Id = "CoastalOilAlpha",
			DisplayName = "Coastal Oil Alpha",
			Description = "Offshore oil platform — take it by boat (drive into the lagoon) or from the deck. Harder guards.",
			CaptureTimeSeconds = 50,
			BonusType = "FlatPassiveCash",
			BonusValue = 100,
			Position = Vector3.new(1800, 28, -750), -- deck height matches MapSetup platform
			Radius = 48,
			Color = Color3.fromRGB(190, 145, 45),
			StipendCash = 14000,
			IsOilRig = true,
			GuardNPCType = "OilRigGuard",
			GuardCount = 4,
		},
		CoastalOilBravo = {
			Id = "CoastalOilBravo",
			DisplayName = "Coastal Oil Bravo",
			Description = "Offshore oil platform — take it by boat (drive into the lagoon) or from the deck. Harder guards.",
			CaptureTimeSeconds = 50,
			BonusType = "FlatPassiveCash",
			BonusValue = 100,
			Position = Vector3.new(-1800, 28, 750),
			Radius = 48,
			Color = Color3.fromRGB(170, 125, 40),
			StipendCash = 14000,
			IsOilRig = true,
			GuardNPCType = "OilRigGuard",
			GuardCount = 4,
		},
		-- Named fortresses (MT-inspired desert forts; higher stipend)
		FortIronclad = {
			Id = "FortIronclad",
			DisplayName = "Fort Ironclad",
			Description = "Fortress stronghold — high capture stipend. Fort guards.",
			CaptureTimeSeconds = 40,
			BonusType = "PassiveCashMult",
			BonusValue = 0.08,
			Position = Vector3.new(1450, 1, -1450),
			Radius = 55,
			Color = Color3.fromRGB(140, 145, 155),
			StipendCash = 10000,
			IsFortress = true,
			GuardNPCType = "FortGuard",
			GuardCount = 4,
		},
		FortSandhold = {
			Id = "FortSandhold",
			DisplayName = "Fort Sandhold",
			Description = "Desert fortress — high capture stipend. Fort guards.",
			CaptureTimeSeconds = 40,
			BonusType = "PassiveCashMult",
			BonusValue = 0.08,
			Position = Vector3.new(-1450, 1, 1450),
			Radius = 55,
			Color = Color3.fromRGB(190, 155, 90),
			StipendCash = 10000,
			IsFortress = true,
			GuardNPCType = "FortGuard",
			GuardCount = 4,
		},
	} :: { [string]: TerritoryDef },
}

return TerritoryConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">TutorialConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Interactive tutorial steps — short plain copy, one step at a time.
	v31 first-2-min: Claim → MoneyCollector → ClickDropper → CommandCenter buy,
	then Recruit → Barracks → Jeep → Outpost.
	v71 P1-15: device-neutral copy (about 80% of players are on phones): no key names, no "click"; the chip's GO
	button runs CtaAction. Buy steps point at the structure's own console (console-only buying): at L0 the BUY
	button there reads BUILD. The beam target of every step is the player's OWN plot (TutorialController.ResolveTarget).
	Hints stay <= 42 characters: the objective chip shows 2 hint lines, about 44 characters on an 800x360 phone.
]]

export type TutorialStepDef = {
	Id: string,
	Title: string,
	Hint: string,
	MarkerName: string,
	HighlightHint: string?,
	PadStructureId: string?,
	CtaAction: string?,
	CtaLabel: string?,
}

local TutorialConfig = {
	Enabled = true,
	Steps = {
		{
			Id = "ClaimBase",
			Title = "Your base",
			Hint = "Walk to the glowing pad on your plot.",
			MarkerName = "Tutorial_ClaimBase",
			HighlightHint = "BasePad",
			CtaAction = "WatchHud",
			CtaLabel = "GO TO BASE",
		},
		{
			Id = "Income",
			Title = "Collect cash",
			Hint = "Walk up to your ATM to collect cash.",
			MarkerName = "Tutorial_Income",
			HighlightHint = "CashHUD",
			CtaAction = "WatchHud",
			CtaLabel = "COLLECT",
		},
		{
			Id = "ClickDropper",
			Title = "Grab cash drops",
			Hint = "Grab the green cash drop by your ATM.",
			MarkerName = "Tutorial_Dropper",
			HighlightHint = "CashHUD",
			CtaAction = "WatchHud",
			CtaLabel = "CASH DROP",
		},
		{
			Id = "CommandCenter",
			Title = "Command Center",
			Hint = "Follow the gold line, then press BUILD.",
			MarkerName = "Tutorial_CommandCenter",
			HighlightHint = "Console",
			PadStructureId = "CommandCenter",
			CtaAction = "PadBuy",
			CtaLabel = "GO",
		},
		{
			Id = "RecruitSoldiers",
			Title = "Recruit workers",
			Hint = "Open Army and recruit a soldier.",
			MarkerName = "Tutorial_Recruit",
			HighlightHint = "Army",
			CtaAction = "OpenArmy",
			CtaLabel = "ARMY",
		},
		{
			Id = "Barracks",
			Title = "Barracks",
			Hint = "Follow the gold line, then press BUILD.",
			MarkerName = "Tutorial_Barracks",
			HighlightHint = "Console",
			PadStructureId = "Barracks",
			CtaAction = "PadBuy",
			CtaLabel = "GO",
		},
		{
			Id = "Jeep",
			Title = "Spawn Jeep",
			Hint = "Open the Garage and spawn your Jeep.",
			MarkerName = "Tutorial_Jeep",
			HighlightHint = "Garage",
			CtaAction = "OpenGarage",
			CtaLabel = "GARAGE",
		},
		{
			Id = "Outpost",
			Title = "Capture outpost",
			Hint = "Stand in a zone until it's yours.",
			MarkerName = "Tutorial_Outpost",
			HighlightHint = "Territory",
			CtaAction = "Capture",
			CtaLabel = "FIND ZONE",
		},
	} :: { TutorialStepDef },
}

function TutorialConfig.GetStep(index: number): TutorialStepDef?
	return TutorialConfig.Steps[index]
end

function TutorialConfig.StepCount(): number
	return #TutorialConfig.Steps
end

return TutorialConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">VehicleCombatConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): vehicle HP, damage classes, destruction, regen, seat rules (premium_vehicles.md §3–§5).
	Server: VehicleHealth (M4) and CombatService.ApplyHit; VehicleWeaponService (M6). Client reads it for display.
	Config only: nothing reads this file yet.

	dealt = raw × Class.Mult × WeaponMult × (1 − min(Armor / (Armor + ArmorK), MaxArmorReduction) × Class.ArmorFactor)
	MaxHP = def.Health × clamp(WE_ArmorMult, ArmorMultClamp) × GlobalHPMult (× Tank Factory bonus for ground
	vehicles, premium included — J9).

	Judge rulings applied (money/plan.md §1):
	- J8: Nuke class — any non-immune vehicle inside the nuke CoreRadius is destroyed (NukeConfig.Vehicles).
	- J9: the Tank Factory HP bonus applies to every ground vehicle the owner deploys, premium included.
	- J10: free drivers keep firing their rifle (SeatFire.DriverCanUseInfantryWeapons = true); fix the self-hit ray
	  instead. The owner may flip this (§2.7 D5).
	- J23: M7c adds HeavyRocketLauncher (AntiVehicle ×2) and AntiMaterielRifle (SmallArms ×1.5) to InfantryWeapons. ]]

export type DamageClass = {
	Mult: number,
	ArmorFactor: number,
	CoreDestroys: boolean?,
}

export type InfantryWeaponClass = {
	Class: string,
	Mult: number,
}

local VehicleCombatConfig = {
	Health = {
		GlobalHPMult = 1, -- one tuning knob for every vehicle's MaxHP
		ArmorK = 200,
		MaxArmorReduction = 0.6,
		ArmorMultClamp = { 1, 1.5 }, -- research VehicleArmor (WE_ArmorMult) range
		SpawnProtectSeconds = 5,
		AttrHz = 10, -- WE_HP / WE_MaxHP / WE_Destroyed writes (display only, never read back)
	},

	DamageClasses = {
		SmallArms = { Mult = 0.5, ArmorFactor = 1 }, -- rifles, SMG, pistol, shotgun pellets, vehicle MGs
		Explosive = { Mult = 1.5, ArmorFactor = 0.5 }, -- Grenade, rocket pods
		AntiVehicle = { Mult = 1, ArmorFactor = 0 }, -- RocketLauncher, siege cannon
		Missile = { Mult = 1, ArmorFactor = 0 }, -- Command Center strikes
		Nuke = { Mult = 1, ArmorFactor = 0, CoreDestroys = true }, -- J8
		NPC = { Mult = 0.5, ArmorFactor = 1 }, -- hostile NPC rifles at an enclosed seat
	} :: { [string]: DamageClass },

	-- Infantry WeaponConfig ids → class and WeaponMult (every other weapon: SmallArms × 1)
	InfantryWeapons = {
		RocketLauncher = { Class = "AntiVehicle", Mult = 2.0 },
		Grenade = { Class = "Explosive", Mult = 1 },
		Sniper = { Class = "SmallArms", Mult = 0.6 },
		-- M7c (J23): HeavyRocketLauncher = { Class = "AntiVehicle", Mult = 2.0 },
		--            AntiMaterielRifle = { Class = "SmallArms", Mult = 1.5 },
	} :: { [string]: InfantryWeaponClass },
	DefaultInfantryClass = "SmallArms",

	Destroy = {
		OccupantDamage = 35, -- every ejected occupant (not lethal from full health)
		DebrisSeconds = 3,
		RepairSeconds = { Default = 45, Premium = 20 }, -- redeploy lock for that vehicle id
		Reward = {
			CashPerHP = 0.08,
			CashMax = 500,
			XPPerHP = 0.02,
			XPMax = 120,
			PairCooldownSeconds = 300, -- same killer/victim pair: no bounty (alt farming)
			KillerWindowSeconds = 10, -- last attacker within this window gets the bounty
			CashReason = "vehicle_kill",
			XPReason = "vehicle_kill",
		},
	},

	Regen = {
		DelayAfterDamageSeconds = 12,
		PremiumPctPerSec = 0.015, -- premium "Field repair": anywhere
		OwnPlotPctPerSec = 0.02, -- Cash vehicles: only inside the owner's plot
		TickSeconds = 1,
	},

	RookieProtection = { BelowLevel = 5, VehicleWeaponMult = 0.5 },

	SeatFire = {
		DriverCanUseInfantryWeapons = true, -- J10 (owner decision D5)
		-- Passengers may fire their own guns from these open families; enclosed families (APC, tracked, heli, jet,
		-- sub, capital ship) may not.
		OpenFamilies = {
			WheeledLight = true,
			WheeledTruck = true,
			NavalPatrol = true,
			NavalGun = true,
			NavalLanding = true,
		} :: { [string]: boolean },
	},

	-- Who may sit where (enforced on Occupant change). Squad units count as the owner's. (D6)
	SeatPolicy = { Driver = "Owner", Gunner = "OwnerOrClan", Passenger = "Anyone" },

	-- Free 90 s test drives (PremiumVehicleConfig.Trial): no damage to or from players / vehicles, no bounty, and
	-- NPC kills carry no creator tag (no rewards).
	Trial = { DealsPlayerDamage = false, DealsVehicleDamage = false, TakesDamage = false, Bounty = false, KillRewards = false },
}

-- armorReduction × ArmorFactor for one hit (pure; used by VehicleHealth and the Garage stat bars)
function VehicleCombatConfig.ArmorReduction(armor: number): number
	local h = VehicleCombatConfig.Health
	local a = math.max(0, tonumber(armor) or 0)
	return math.min(a / (a + h.ArmorK), h.MaxArmorReduction)
end

function VehicleCombatConfig.DamageMult(className: string, armor: number, weaponMult: number?): number
	local c = VehicleCombatConfig.DamageClasses[className] or VehicleCombatConfig.DamageClasses.SmallArms
	return c.Mult * (weaponMult or 1) * (1 - VehicleCombatConfig.ArmorReduction(armor) * c.ArmorFactor)
end

return VehicleCombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">VehicleConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Deep vehicle roster (~95): Ground / Air / Naval unlock ladder.
	KitFamily drives VehicleService Part kits (grows to 100 without rewrite).
	Generic military names only — no real brands, no MT names.
]]

export type VehicleCategory = "Ground" | "Air" | "Naval"

export type KitFamily =
	"WheeledLight"
	| "WheeledTruck"
	| "WheeledAPC"
	| "TrackedIFV"
	| "TrackedMBT"
	| "TrackedSPAAG"
	| "TrackedArtillery"
	| "HeliLight"
	| "HeliTransport"
	| "HeliAttack"
	| "JetFighter"
	| "JetStrike"
	| "JetBomber"
	| "JetTransport"
	| "NavalPatrol"
	| "NavalGun"
	| "NavalLanding"
	| "NavalCapital"
	| "NavalSub"

export type VehicleDef = {
	Id: string,
	DisplayName: string,
	Category: VehicleCategory,
	Rarity: string,
	UnlockLevel: number,
	Health: number,
	Speed: number,
	Seats: number,
	Armor: number,
	CostCash: number,
	KitFamily: KitFamily,
	KitScale: number?, -- visual scale mult (default 1)
	RequiresStructure: { StructureId: string, Level: number }?,
	RequiresPrestige: number?,
	RequiresRebirthFlag: string?,
	MeshAssetId: number?,
	TextureAssetId: number?,
}

local function V(
	id: string,
	name: string,
	cat: VehicleCategory,
	rarity: string,
	level: number,
	health: number,
	speed: number,
	seats: number,
	armor: number,
	cost: number,
	kit: KitFamily,
	opts: {
		Scale: number?,
		Struct: { StructureId: string, Level: number }?,
		Prestige: number?,
		RebirthFlag: string?,
	}?
): VehicleDef
	local scale: number? = nil
	local struct: { StructureId: string, Level: number }? = nil
	local prestige: number? = nil
	local rebirthFlag: string? = nil
	if opts then
		scale = opts.Scale
		struct = opts.Struct
		prestige = opts.Prestige
		rebirthFlag = opts.RebirthFlag
	end
	return {
		Id = id,
		DisplayName = name,
		Category = cat,
		Rarity = rarity,
		UnlockLevel = level,
		Health = health,
		Speed = speed,
		Seats = seats,
		Armor = armor,
		CostCash = cost,
		KitFamily = kit,
		KitScale = scale,
		RequiresStructure = struct,
		RequiresPrestige = prestige,
		RequiresRebirthFlag = rebirthFlag,
	}
end

local D = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "VehicleDepot", Level = l }
end
local H = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "Helipad", Level = l }
end
local A = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "Airfield", Level = l }
end
local N = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "Dock", Level = l }
end

