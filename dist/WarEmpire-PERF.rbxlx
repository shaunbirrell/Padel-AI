        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ManualDropperConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Early-game manual cash droppers near Money Collector + Training Yard (prompt on touch, ClickDetector on PC).
	Server-authoritative; client only fires ClickDetector / ProximityPrompt.
	v71 (HUD v70 spec §5): the price tag reads "$15" (no mouse wording — wrong on phones), owner-only, stud-scaled; the
	"+$15" pop is owner-only too; the plate keeps its glow but no PointLight.
]]

local ManualDropperConfig = {
	Enabled = true,

	-- Award (PendingCash). Prefer AwardAmount; else random [MinAward, MaxAward].
	MinAward = 10,
	MaxAward = 25,
	AwardAmount = 15,

	CooldownSeconds = 0.35,
	RateLimitRate = 4,
	RateLimitBurst = 3,

	-- v69 income budget per player (both droppers share it) so an auto-clicker can't farm all night.
	-- Refilling buckets: a full minute bucket gives a quick burst, then it refills at N/60 per second;
	-- the hour bucket caps long sessions at ~MaxAwardsPerHour (600 x $15 = $9k/h, below base passive).
	MaxAwardsPerMinute = 30,
	MaxAwardsPerHour = 600,
	BudgetEmptyToast = "Cash drop is recharging — the ATM keeps earning meanwhile",
	BudgetEmptyToastCooldown = 20,

	CollectorOffset = Vector3.new(-5.5, 0, 4),
	YardOffset = Vector3.new(6, 0, -4),

	PromptActionText = "Grab Cash",
	PromptObjectText = "Cash Drop",
	PromptMaxDistance = 12,
	PromptHoldDuration = 0,

	PartSize = Vector3.new(2.4, 1.2, 2.4),
	PartColor = Color3.fromRGB(40, 140, 70),
	NeonAccentColor = Color3.fromRGB(90, 255, 120),
	BillboardLabel = "$", -- v71: device-neutral (the old tag told phone players to use a mouse); the owner sees "$15"
	LabelMaxDistance = 30, -- studs (WorldLabel caps at 40)
	LabelStuds = Vector2.new(3, 1.2), -- the tag's box, studs

	PopupDuration = 0.55,
	PopupRiseStuds = 3.2,
}

return ManualDropperConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">MissionConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily objective missions (progress tracked server-side) + legacy timed missions.
]]

export type DailyMissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string, -- KillNPC | KillPlayer | CaptureTerritory | PurchaseUpgrade | EarnCash | SpawnVehicle | RecruitSoldiers
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number?,
	MinLevel: number,
}

export type MissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MinLevel: number,
	DurationSeconds: number,
	RewardCash: number,
	RewardXP: number,
	Difficulty: string,
}

local MissionConfig = {
	-- How many daily missions are offered (first N unlocked by level from DailyMissions order)
	MaxActiveDaily = 6, -- includes Daily Ops when merged
	RefreshOnUtcDayChange = true,

	DailyMissions = {
		DailyKillNPC = {
			Id = "DailyKillNPC",
			DisplayName = "Clear Hostiles",
			Description = "Eliminate 10 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 80,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyCapture = {
			Id = "DailyCapture",
			DisplayName = "Seize Ground",
			Description = "Capture 1 territory.",
			ObjectiveType = "CaptureTerritory",
			Target = 1,
			RewardCash = 4000,
			RewardXP = 120,
			RewardGold = 1,
			MinLevel = 1,
		},
		DailyUpgrade = {
			Id = "DailyUpgrade",
			DisplayName = "Fortify Base",
			Description = "Buy 1 base upgrade — reward $3,000 + 100 XP.",
			ObjectiveType = "PurchaseUpgrade",
			Target = 1, -- v37: completable in first ~5 min
			RewardCash = 3000,
			RewardXP = 100,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyEarnCash = {
			Id = "DailyEarnCash",
			DisplayName = "War Chest",
			Description = "Earn $8,000 Cash from any source.",
			ObjectiveType = "EarnCash",
			Target = 8000,
			RewardCash = 2000,
			RewardXP = 60,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailySpawnVehicle = {
			Id = "DailySpawnVehicle",
			DisplayName = "Mobilize",
			Description = "Spawn 1 vehicle from the garage — reward $1,500 + 40 XP.",
			ObjectiveType = "SpawnVehicle",
			Target = 1,
			RewardCash = 1500,
			RewardXP = 40,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyKillPlayer = {
			Id = "DailyKillPlayer",
			DisplayName = "Combat Ready",
			Description = "Eliminate 3 enemy players.",
			ObjectiveType = "KillPlayer",
			Target = 3,
			RewardCash = 5000,
			RewardXP = 150,
			RewardGold = 2,
			MinLevel = 5,
		},
		DailyRecruit = {
			Id = "DailyRecruit",
			DisplayName = "Muster Troops",
			Description = "Recruit 1 soldier — reward $2,000 + 50 XP + 1 Gold.",
			ObjectiveType = "RecruitSoldiers",
			Target = 1, -- v37: first-5-min friendly
			RewardCash = 2000,
			RewardXP = 50,
			RewardGold = 1,
			MinLevel = 1,
		},
	} :: { [string]: DailyMissionDef },

	DailyMissionOrder = {
		"DailyUpgrade", -- v37: first 5-min completable
		"DailyRecruit",
		"DailySpawnVehicle",
		"DailyKillNPC",
		"DailyCapture",
		"DailyEarnCash",
		"DailyKillPlayer",
	},

	-- Legacy timed missions (optional start → wait Duration → claim). v69: no client UI starts them,
	-- so the RequestStartMission remote is ignored unless this is true; each one pays once per UTC day.
	TimedMissionsRemoteEnabled = false,
	Missions = {
		PatrolOutskirts = {
			Id = "PatrolOutskirts",
			DisplayName = "Patrol the Outskirts",
			Description = "Secure the perimeter around your base.",
			MinLevel = 1,
			DurationSeconds = 60,
			RewardCash = 800,
			RewardXP = 50,
			Difficulty = "Easy",
		},
		SupplyRun = {
			Id = "SupplyRun",
			DisplayName = "Supply Run",
			Description = "Escort a convoy to the depot.",
			MinLevel = 3,
			DurationSeconds = 120,
			RewardCash = 2000,
			RewardXP = 120,
			Difficulty = "Normal",
		},
		RaidOutpost = {
			Id = "RaidOutpost",
			DisplayName = "Raid Enemy Outpost",
			Description = "Strike a hostile forward base.",
			MinLevel = 8,
			DurationSeconds = 180,
			RewardCash = 6000,
			RewardXP = 300,
			Difficulty = "Hard",
		},
	} :: { [string]: MissionDef },
}

return MissionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Live Robux product IDs (Creator Dashboard / Open Cloud). Id=0 = stub / hidden duplicate.
	Grants ONLY via server ProcessReceipt / GamePass ownership checks — never client confirmation.
	DevProducts AutoCollect/DoubleCash/VIPBoost are HideFromShop (GamePasses cover them).
	v69: OneTime = true marks a DevProduct whose grant is a boolean (buying it twice adds nothing). The Shop
	shows OWNED instead of prompting once the server reports it owned (player attribute WE_Ent_<key>, see
	ShopController). ProcessReceipt still grants any receipt Roblox delivers. HideFromShop on a GamePass keeps
	it out of the Shop list.
	v71 money (M0): HideFromShop also stops selling dead items (Gold packs: Gold has no use yet; Instant Barracks).
	Their Ids stay unchanged (never set a live Id to 0). A receipt for a product Id that is not listed here is NOT
	acknowledged (MonetizationService J2): paste new Ids with tools/wire-monetization-ids.py, publish, then run
	Migrate to Latest Update. ]]

local MonetizationConfig = {
	GamePasses = {
		VIP = {
			Id = 1985475542,
			DisplayName = "VIP",
			RobuxPrice = 199,
			CashBonusMult = 0.25, -- additive +25% cash earnings
			Description = "+25% Cash earnings",
		},
		DoubleCash = {
			Id = 1982865711,
			DisplayName = "2x Cash",
			RobuxPrice = 149,
			CashMult = 2, -- multiplicative 2x cash earnings
			Description = "2x Cash earnings",
		},
		DoubleXP = {
			Id = 1982487698,
			DisplayName = "Double XP",
			RobuxPrice = 99,
			XPMult = 2,
			Description = "2x XP",
		},
		-- v69: HideFromShop — no code applies this theme yet, so it is not sold in the in-game Shop.
		-- Id kept unchanged (existing owners keep the pass); remove HideFromShop once the theme ships.
		ExtraPlotCosmetic = {
			Id = 1983357731,
			DisplayName = "Elite Base Theme",
			RobuxPrice = 79,
			Description = "Cosmetic base theme",
			HideFromShop = true,
		},
		AutoCollect = {
			Id = 1985115501,
			DisplayName = "Auto Collect",
			RobuxPrice = 99,
			Description = "Auto-claims Money Collector without touch",
		},
	},
	DevProducts = {
		CashSmall = { Id = 3713838744, DisplayName = "Cash Pack S", RobuxPrice = 49, Cash = 10000, Gold = 0 },
		CashMedium = { Id = 3713838815, DisplayName = "Cash Pack M", RobuxPrice = 149, Cash = 50000, Gold = 0 },
		CashLarge = { Id = 3713838888, DisplayName = "Cash Pack L", RobuxPrice = 399, Cash = 200000, Gold = 0 },
		CashMega = { Id = 3713838952, DisplayName = "Cash Pack Mega", RobuxPrice = 799, Cash = 2000000, Gold = 0 },
		-- v71 money (M0): Gold has no sink yet (revenue audit F9), so the Gold packs are not sold. Ids kept.
		GoldSmall = { Id = 3713839003, DisplayName = "Gold Pack S", RobuxPrice = 49, Cash = 0, Gold = 50, HideFromShop = true },
		GoldMedium = { Id = 3713839048, DisplayName = "Gold Pack M", RobuxPrice = 149, Cash = 0, Gold = 200, HideFromShop = true },
		GoldLarge = { Id = 3713839090, DisplayName = "Gold Pack L", RobuxPrice = 349, Cash = 0, Gold = 500, HideFromShop = true },
		-- Placeholder Id=0: ProcessReceipt sets Battle Pass Premium when Id is live; Studio uses admin grantpremium
		PremiumPass = {
			Id = 3713839151,
			DisplayName = "Battle Pass Premium",
			RobuxPrice = 499,
			Cash = 0,
			Gold = 0,
			GrantsBattlePassPremium = true,
			OneTime = true, -- v69: Premium is a boolean kept across seasons; the Shop shows OWNED once granted
		},
		-- Monetization add-ons (Ids = 0 until Creator Dashboard)
		-- Covered by GamePass AutoCollect — keep stub for ProcessReceipt compat; hidden in shop
		AutoCollect = {
			Id = 0,
			DisplayName = "Auto Collect",
			RobuxPrice = 99,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "AutoCollect",
			HideFromShop = true,
			Description = "Auto-claims Money Collector without touch",
		},
		-- Covered by GamePass DoubleCash — hidden in shop
		DoubleCash = {
			Id = 0,
			DisplayName = "2x Money",
			RobuxPrice = 149,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "DoubleCash",
			HideFromShop = true,
			Description = "2x Cash earnings (permanent flag)",
		},
		ExtraSoldierSlot = {
			Id = 3713839210,
			DisplayName = "Extra Soldier Slot",
			RobuxPrice = 79,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "ExtraSoldierSlot",
			OneTime = true, -- v69: boolean entitlement (+1 cap once); a second purchase would add nothing
			Description = "+1 soldier capacity",
		},
		-- v71 money (M0): not sold any more (Barracks L1 costs $2,500 of early cash; audit F13). Id kept for receipt compat.
		InstantBarracks = {
			Id = 3713839278,
			DisplayName = "Instant Barracks",
			RobuxPrice = 129,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "InstantBarracks",
			OneTime = true, -- v69: only raises Barracks to L1; OWNED once granted or Barracks is already L1+
			HideFromShop = true,
			Description = "Unlocks Barracks L1 instantly",
		},
		-- Covered by GamePass VIP — hidden in shop
		VIPBoost = {
			Id = 0,
			DisplayName = "VIP Boost",
			RobuxPrice = 199,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "VIP",
			HideFromShop = true,
			Description = "+25% Cash earnings (permanent flag)",
		},
		SpeedBoost = {
			Id = 3713839342,
			DisplayName = "Speed Boost",
			RobuxPrice = 99,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "SpeedBoost",
			OneTime = true, -- v69: permanent boolean flag
			Description = "Permanent move-speed boost",
		},
		-- Cosmetic oil pump gold dress — Id=0: MapSetup hides GoldenPump pad until Id set;
		-- ProcessReceipt + GrantEntitlement ready when Creator Dashboard Id is pasted.
		-- v71 money (M0): one-time Developer Product (J29), 49 R$. M0b: paste the Id AND remove HideFromShop in the
		-- same commit (the Shop row stays hidden until then).
		GoldenPumpjack = {
			Id = 0,
			DisplayName = "Golden Pumpjacks",
			RobuxPrice = 49,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "GoldenPumpjack",
			OneTime = true, -- boolean entitlement: a second purchase adds nothing; the Shop shows OWNED
			HideFromShop = true,
			Description = "Gold-dress every oil pump on your base",
		},
		StarterBundle = {
			Id = 3713839505,
			DisplayName = "Commander Starter Bundle",
			RobuxPrice = 249,
			Cash = 25000,
			Gold = 25,
			GrantEntitlement = "StarterBundle",
			Description = "Cash + Gold jumpstart pack",
		},
	},
	-- Loot-box style RNG marked policy-pending — do not enable without compliance review
	-- v30: PvP death toast — was { "DoubleCash", "SpeedBoost" } (live Ids).
	-- v71 money (M0): empty, so a PvP death no longer offers 2x Cash to players who already own it; the M3 Offer
	-- Director's death card replaces this toast. Keep the DeathShopOffers key (CombatService / ShopController read it).
	DeathShopOffers = {} :: { string },
	-- v32: one-shot soft offer on first join / low cash (server marks StarterBundleOffered)
	StarterBundleOffer = {
		DelaySeconds = 8,
		CashBelow = 12000, -- StartingCash*2 + buffer
		NewProfileMaxAgeSeconds = 600, -- FirstJoin→LastJoin span treats as new
	},
	-- v33: one-shot soft offer after first manual ATM collect (server marks AutoCollectOffered)
	AutoCollectOffer = {
		DelaySeconds = 1.2,
	},
	-- v34: one-shot DoubleCash soft offer after meaningful ATM collect (not spammy)
	DoubleCashOffer = {
		DelaySeconds = 1.8,
		MinCollectCash = 2500, -- only after a solid collect
	},
	-- v35: one-shot VIP soft offer at mid-game (level≥10 OR first structure L3); not spammy
	VIPOffer = {
		DelaySeconds = 2.0,
		MinLevel = 10,
		MinStructureLevel = 3,
	},
	-- v36: one-shot SpeedBoost soft offer after first jeep sit / walk-speed moment (existing Id only)
	SpeedBoostOffer = {
		DelaySeconds = 1.5,
	},
	-- v37: one-shot CashMega soft toast after big pending collect OR death path (existing Id 3713838952 only)
	CashMegaOffer = {
		DelaySeconds = 1.8,
		MinPendingCollect = 15000, -- pending/granted threshold
	},
	-- v38: one soft-offer toast max per session minute (shared across Starter/VIP/Speed/CashMega/AC/2x)
	SoftOfferSessionCooldownSeconds = 60,
	LootBoxPolicyPending = true,
	-- Reasons that skip VIP / 2x Cash multipliers (already granted amounts or admin)
	CashMultExemptReasons = {
		devproduct = true,
		admin = true,
		purchase_refund = true,
		prestige = true,
		battlepass = true,
		dismiss_soldiers = true,
		code = true,
		spinner = true,
		supply_drop = true,
		bank_raid = true,
		clan_war_win = true,
		clan_war_participate = true,
		collector = true, -- pending already multiplied at accrue time
		manual_dropper = true, -- fixed click awards stay $10–25
		atm_raid = true,
		plot_oil = true, -- plot pump PendingCash via AccruePendingCash
	},
	XPMultExemptReasons = {
		admin = true,
		battlepass = true,
		achievement = true,
	},
}

return MonetizationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">NationColorConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nation color roster — assigned on join / first spawn.
	Used to tint captured territory flags for that player.
]]

export type NationColorDef = {
	Id: string,
	DisplayName: string,
	Color: Color3,
}

local NationColorConfig = {
	Colors = {
		{ Id = "Crimson", DisplayName = "Crimson Legion", Color = Color3.fromRGB(200, 45, 55) },
		{ Id = "Azure", DisplayName = "Azure Fleet", Color = Color3.fromRGB(45, 110, 220) },
		{ Id = "Emerald", DisplayName = "Emerald Guard", Color = Color3.fromRGB(40, 170, 90) },
		{ Id = "Amber", DisplayName = "Amber Corps", Color = Color3.fromRGB(220, 160, 40) },
		{ Id = "Violet", DisplayName = "Violet Spear", Color = Color3.fromRGB(140, 70, 200) },
		{ Id = "Ivory", DisplayName = "Ivory Shield", Color = Color3.fromRGB(230, 225, 210) },
		{ Id = "Obsidian", DisplayName = "Obsidian Wing", Color = Color3.fromRGB(55, 55, 65) },
		{ Id = "Cyan", DisplayName = "Cyan Patrol", Color = Color3.fromRGB(40, 190, 200) },
	} :: { NationColorDef },
}

return NationColorConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">NotificationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NotificationConfig — toast lane + offer toast tunables that are NOT layout (layout, colours, holds, the
	Reroute / Drop tables and the offer throttle numbers live in HudConfig.Toast / HudConfig.Offer).

	v70 "clean screen": NotificationController draws plain outlined text lines in the top-centre stack (max 2,
	coalesced, prioritised) — no cards. Money moves at the cash pill (HudLayout.CashFloat), not mid-screen.
	The Purchase SUCCESSFUL line stays the green Success type (HIGH_CONTRAST_SUCCESS marker in the controller).

	Order a message goes through (NotificationController.route):
	  1. Rewrite      text / type fixes for today's server lines (glyphs FredokaOne lacks, type upgrades)
	     AlertEcho    strike-result lines are dropped while the Alert banner already shows them
	  2. Reroute      HudConfig.Toast.Reroute (Collected → float, kills → float, DEF HIT → one BASE UNDER ATTACK)
	  3. Drop         HudConfig.Toast.Drop (+ LocalExemptDrop for server-sent lines only)
	  4. Throttle     per-pattern minimum gaps / once-per-text for recurring server lines
	  5. PurchaseFailure echo dedupe (one failed buy = one line)
	  6. the lane (coalesce "×N", max 2, priority)
]]

export type RewriteRule = { Match: string, Replace: string?, Type: string? }
export type ThrottleRule = { Match: string, MinGapSeconds: number?, OncePerText: boolean? }

local NotificationConfig = {
	-- legacy fields (kept for any caller that still reads them)
	DefaultDuration = 4,
	MaxStacked = 4,
	Types = {
		Info = { Color = Color3.fromRGB(90, 160, 220), Fill = Color3.fromRGB(18, 28, 40) },
		-- High-contrast success (competitor "Purchase SUCCESSFUL!" readability)
		Success = { Color = Color3.fromRGB(40, 255, 120), Fill = Color3.fromRGB(8, 48, 22) },
		Collect = { Color = Color3.fromRGB(60, 255, 140), Fill = Color3.fromRGB(6, 42, 20) },
		Warn = { Color = Color3.fromRGB(255, 200, 60), Fill = Color3.fromRGB(40, 32, 10) },
		Error = { Color = Color3.fromRGB(255, 80, 80), Fill = Color3.fromRGB(48, 12, 12) },
		Reward = { Color = Color3.fromRGB(255, 210, 90), Fill = Color3.fromRGB(40, 32, 12) },
	},

	-- lane --------------------------------------------------------------------------------------------------
	-- A caller's Duration may lengthen a line up to this (server lines ask 3.5-7 s; the lane is meant to be brief)
	MaxHoldSeconds = 4,
	MinHoldSeconds = 1.2,
	-- When 2 lines are up and a new one arrives, the oldest line of the LOWEST priority goes first
	-- (a gold level-up line outlives an "Outposts held" Info line). Equal priority → oldest goes.
	Priority = { Error = 4, Reward = 4, Warn = 4, Success = 3, Info = 1 },
	-- Coalesce "×N" suffix (HudConfig.Toast.CoalesceWindow / CoalesceKey = digits stripped)
	CoalesceSuffix = " ×%d",
	-- measured text box padding in v (UIStroke is drawn outside the glyphs)
	LinePadX = 8,
	LinePadY = 2,

	-- 1. Rewrite: first match wins; Replace is a string.gsub replacement for Match (nil = keep text).
	Rewrite = ({
		-- XPService "★ LEVEL 9! — Sniper Rifle unlocked" (Success today) → the gold Reward line of the spec
		{ Match = "^(★ LEVEL %d+!) — ", Replace = "%1 ", Type = "Reward" },
		{ Match = "^★ LEVEL %d+!", Type = "Reward" },
		-- "Purchase SUCCESSFUL! Helipad → Lv 2": FredokaOne has no "→" (spec risk #5)
		{ Match = " → Lv (%d+)", Replace = " Lv %1" },
		-- server purchase-failure echo uses the competitor wording the client uses
		{ Match = "^Not enough cash$", Replace = "You need more Money!", Type = "Warn" },
		-- raids (RaidConfig.Text): short lines, no "→" / emoji (FredokaOne lacks them); the shield chip shows the timer
		{ Match = "^ATM RAIDED by (.-) (−%$[%d,%.KMB]+).*$", Replace = "ATM raided by %1! %2", Type = "Error" },
		{ Match = "^ATM RAID %+(%$[%d,%.KMB]+) from (.-) → your ATM$", Replace = "Raided %2's ATM! +%1", Type = "Success" },
	} :: { RewriteRule }),

	-- Server lines that repeat what the Alert slot banner already says (MissileController's INCOMING MISSILE
	-- banner shows the strike result for a few seconds) — dropped only while an alert banner is visible.
	AlertEcho = {
		"Missile hit! Defenses down",
		"Your Missile Defense shot down",
		"^Direct hit! ",
		"^Intercepted by ",
		"INCOMING MISSILE",
	},

	-- 3. Drop patterns that apply ONLY to server-sent lines (a local NotificationController.Show of the same
	-- words is intended: OrdersController's T-key "Squad: FOLLOW" Info line while the Army popover is closed).
	LocalExemptDrop = { "^Squad: " },

	-- 4. Throttle recurring server lines on the client (the §4.2 server fixes are deferred)
	Throttle = ({
		{ Match = "^Rebirth almost ready", OncePerText = true }, -- every 90 s today; once per level per session
		{ Match = "^REBIRTH READY", MinGapSeconds = 600 },
		{ Match = "^Raid cooldown", MinGapSeconds = 10 }, -- ATM raid cooldown Warn while standing at the ATM
		{ Match = "is robbing your ATM", MinGapSeconds = 15 },
		{ Match = "^Nothing to collect yet", MinGapSeconds = 20 },
		{ Match = "^Cash drop is recharging", MinGapSeconds = 30 },
	} :: { ThrottleRule }),

	-- 5. One failed purchase = one line. WorldPromptController shows the failure first (WE_BuyAck / PurchaseResult,
	-- via NotificationController.ShowPurchaseFailure); any other purchase-failure line within WindowSeconds —
	-- the second client path or the server's own Warn echo (BaseService / UpgradePadService) — is skipped.
	PurchaseFailure = {
		WindowSeconds = 1.5,
		Patterns = {
			"^You need more Money!$",
			"^Not enough gold$",
			"^Already at MAX level$",
			"^Missing prerequisite structure$",
			"^Unknown structure$",
			"^Buying too fast",
			"^Profile still loading",
			"^Buy failed",
			"^Purchase failed: ",
			"^Not your base — walk your plot pads to buy$",
			"^Claim a base first",
			"^Go to your .+ console to buy it$", -- v71 NotAtConsole (ConsoleBuyConfig.Text.NotAtConsole)
		},
	},

	-- offer toast (the numbers — MaxPerSession 3, MinGapSeconds 240, FirstAfterJoinSeconds 90, death 600 s,
	-- queue 60 s — are in HudConfig.Offer so the money plan tunes them in one place)
	Offer = {
		DeathKeyPattern = "^Death", -- ShopController.DeathShopToast's Key → HudConfig.Offer.DeathOfferMinGapSeconds
		QueueMax = 3, -- deferred offers waiting for a calm moment (one per Key)
		TickSeconds = 0.5, -- queue / expiry check
		IconSize = Vector2.new(36, 28), -- v, HudIcons "Cash"
		-- touch: GET / ✕ hit areas are 64 v (44.8 px) instead of the desktop 44 v, so the pill may grow this much
		-- past HudConfig.Offer.MaxWidth (still capped at the stack's 0.62 × content) to keep the Sub line readable
		TouchExtraWidth = 120,
		GetText = "GET", -- fallback CTA
		CloseText = "✕",
	},
}

return NotificationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">NukeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): Nuke — consumable 19 R$ DevProduct (profile.Nukes) + post-rebirth Tactical Nuke (profile.TacticalNukes).
	ONE balance file. Server: NukeService (M5). Client: NukeController / NukeFx (radii, timings, copy).
	Paid grants ONLY via MonetizationService.ProcessReceipt (DevProducts.Nuke / NukeBundle3 → GrantNukes, added by M1
	with Id = 0). Config only: nothing reads this file yet and nothing is sold from it.

	Judge rulings applied (money/plan.md §1):
	- J1: a nuke can never open a base for raiding. Base mode gives kills, XP and scorch only, then puts a fallout
	  shield on the target (Base.FalloutShieldSeconds → Raid.ShieldUntil / WE_ShieldUntil). No defenses-down,
	  no ATM, cash or structure loss.
	- J5 / J6: the Nuclear Silo has 5 levels and one site only (Strategic Yard, Rebirth 2). No fallback site.
	- J8: any non-immune vehicle inside CoreRadius is destroyed; the edge ring deals DamageAt × EdgeDamageMult.
	- J17: own Fx remote (FxRemote = "NukeFx"), not MissileStrikeFx.
	- J24: world billboards and pads use the text "NUKE"; icons use IconImage once it is set.
	- J26: keep ServerCooldownSeconds = 180; raise to 300 here if the victim-leave KPI rises > 5 points. ]]

export type KindDef = {
	DisplayName: string,
	InventoryField: string,
	Radius: number,
	CoreRadius: number,
	CoreDamage: number,
	EdgeDamageMax: number,
	EdgeDamageMin: number,
	FlashRadius: number,
	LaunchXPFactor: number,
	LaunchXPMin: number,
	LaunchXPMax: number,
	KillBonusScale: number,
	CloudHeight: number,
	CloudScale: number,
}

local NukeConfig = {
	Enabled = true,
	CountdownSeconds = 10,
	TerminalDiveSeconds = 3,
	IconImage = "", -- owner: rbxassetid of a trefoil decal ("" → the text "NUKE"; J24)
	WorldLabel = "NUKE", -- billboards / pads (J24: no glyph that can fall back in FredokaOne)
	FxRemote = "NukeFx", -- Constants.RemoteNames.NukeFx (J17)

	KindOrder = { "Nuke", "TacticalNuke" },
	Kinds = {
		Nuke = {
			DisplayName = "Nuke",
			InventoryField = "Nukes",
			Radius = 150,
			CoreRadius = 75,
			CoreDamage = 1000,
			EdgeDamageMax = 200,
			EdgeDamageMin = 40,
			FlashRadius = 600,
			LaunchXPFactor = 0.30,
			LaunchXPMin = 400,
			LaunchXPMax = 6000,
			KillBonusScale = 1.0,
			CloudHeight = 220,
			CloudScale = 1.0,
		},
		TacticalNuke = {
			DisplayName = "Tactical Nuke",
			InventoryField = "TacticalNukes",
			Radius = 100,
			CoreRadius = 50,
			CoreDamage = 1000,
			EdgeDamageMax = 160,
			EdgeDamageMin = 30,
			FlashRadius = 400,
			LaunchXPFactor = 0.15,
			LaunchXPMin = 200,
			LaunchXPMax = 3000,
			KillBonusScale = 0.6,
			CloudHeight = 150,
			CloudScale = 0.7,
		},
	} :: { [string]: KindDef },

	Rules = {
		ServerCooldownSeconds = 180, -- J26
		PlayerCooldownSeconds = 300,
		MaxLaunchesPerPlayerPerHour = 6,
		BaseTargetCooldownSeconds = 900, -- the same base cannot be nuked again for 15 min
		VictimGraceSeconds = 600,
		SessionJoinGraceSeconds = 120,
		NewPlayerProtectionSeconds = 600, -- mirror RaidConfig.Raid.NewPlayerProtectionSeconds
		MinVictimLevelIfNoPrestige = 5,
		ProtectNewPlayersInStudio = false,
		SpawnSafeRadius = 24,
		AlliesImmune = true,
		BaseTargetMinPowerRatio = 0.35,
		PowerPerPrestige = 40,
		RefundIfTargetLeaves = true,
		InFlightRefundAfterSeconds = 30, -- J19: a younger marker at load is re-checked at At + 30 while online
		LaunchRate = 0.5,
		LaunchBurst = 2,
		StateRate = 1,
		StateBurst = 2,
	},

	Targeting = {
		BaseAimPoint = { X = 0, Z = 8 }, -- plot-local (plaza / flagpole); converted through the pad CFrame
		PlotClearance = 25,
		MapHalfExtent = 2350,
		GroundRayTop = 600,
		IncludeBank = true, -- + every TerritoryConfig.Territories entry
	},

	Rewards = {
		PlayerKillBonusXP = 260,
		PlayerKillBonusCash = 350,
		NPCKillBonusMult = 1.0,
		SquadKillXP = 30,
		SquadKillCash = 40,
		MaxKillBonusXP = 6000,
		MaxKillBonusCash = 12000,
		XPReason = "nuke",
		CashReason = "nuke_kill",
	},

	-- J1: kills + XP + scorch, then a fallout shield on the target base. There are deliberately NO defenses-down
	-- fields: NukeService must never call GateDefenseService / MissileStrikeService for a base.
	Base = {
		FalloutShieldSeconds = 300, -- Raid.ShieldUntil = max(current, now + 300) (+ WE_ShieldUntil); blocks raids + strikes
		ScorchSeconds = 30, -- client-only ground scorch
	},

	-- J8: vehicles in the core are destroyed outright (so a 4,200 HP tank cannot survive ground zero). The edge ring
	-- deals NukeConfig.DamageAt × EdgeDamageMult through VehicleHealth.ApplyRadiusDamage(..., "Nuke"), ignoring armor.
	-- Occupant cover applies only in the edge ring.
	Vehicles = {
		CoreDestroys = true,
		EdgeDamageMult = 4,
		CoverMult = 0.6,
		PremiumCoverMult = 0.35,
	},

	-- J5: 5 levels (costs, online build time, capacity). J6: one site only, the Strategic Yard (Rebirth 2); the Silo
	-- waits for the rebirth world workflow (M7b), which owns the geometry (BaseLayoutConfig).
	Silo = {
		Enabled = true,
		UnlockPrestige = 2,
		Zone = "StrategicYard", -- RebirthConfig.Zones.StrategicYard
		Site = { X = 0, Z = -124, YawDeg = 0, Footprint = 22 }, -- plot-local (rebirth spec §2); no fallback site
		Requires = { CommandCenter = 3, MissileDefense = 1 } :: { [string]: number },
		Costs = { 250_000, 750_000, 2_000_000, 3_500_000, 6_000_000 },
		BuildSeconds = { 5400, 4200, 3000, 2400, 1800 }, -- 90 / 70 / 50 / 40 / 30 online minutes
		Capacity = { 1, 1, 2, 2, 3 },
		TickSeconds = 5,
	},

	Gift = { Enabled = true, AtLevel = 10, Kind = "TacticalNuke", Count = 1 },

	Offers = { RevengeCooldownSeconds = 600, RevengeMinVictimLevel = 5, RevengeDelaySeconds = 3 },

	Fx = {
		ArcApex = 500,
		FireballMaxSize = 110,
		ShockwaveMult = 1.6,
		CloudHoldSeconds = 12,
		CloudFadeSeconds = 6,
		CleanupSeconds = 25,
		PartBudget = 48,
		PartBudgetLow = 24,
		ShakeMaxStuds = 2.2,
		ShakeSeconds = 1.8,
		ShakeFalloffStuds = 1200,
		SoundSpeed = 1100,
		MaxBoomDelay = 2,
		MarkerTransparency = 0.8,
		InterceptorRange = 350, -- cosmetic interceptors that miss (a nuke is never intercepted)
	},

	Audio = { SirenId = "", BoomId = "", LaunchId = "", SirenVolume = 0.5, BoomVolume = 1.0 },

	Text = {
		Incoming = "☢ NUKE INCOMING · %s · %s",
		InZone = "YOU'RE IN THE BLAST ZONE: RUN ➜",
		Protected = "🛡 You're protected (%s)",
		YourBase = "☢ YOUR BASE IS BEING NUKED by %s: run or get to your spawn pad!",
		Away = "☢ NUKE AWAY → %s · impact %s",
		Aborted = "NUKE ABORTED (%s)",
		Report = "☢ NUKE REPORT · Enemies %d · Hostiles %d · Squads %d · +%s XP · +$%s",
		Broadcast = "☢ %s's NUKE hit %s: %d eliminated",
		Revenge = "Nuked by %s. Strike back? ☢ Nuke",
		Ready = "☢ NUKE READY",
		AirspaceClear = "☢ Airspace clear: launch your Nuke",
		Refunded = "Your unfinished nuke launch was refunded",
		TargetLeft = "%s left: nuke returned",
		BaseNuked = "☢ Your base was nuked by %s. Nuke-proof for %s",
		SiloReady = "☢ Tactical Nuke ready in your Silo",
		Gift = "☢ First strike's on us: 1 Tactical Nuke. Tap ☢ to launch!",
		Reasons = {
			Disabled = "Nukes are switched off",
			Loading = "Your save is still loading",
			Dead = "Respawn first",
			NoInventory = "No nukes: get one (19 R$)",
			NoTactical = "No Tactical Nukes: build a Silo (Rebirth 2)",
			InFlight = "Airspace busy: a nuke is already inbound",
			ServerCooldown = "Airspace clears in %s",
			PlayerCooldown = "Launcher reloading %s",
			HourlyCap = "Launch limit: next in %s",
			Self = "That's your base",
			Ally = "Clan ally",
			TargetOffline = "Player left",
			TargetLoading = "Their save is still loading",
			NewPlayer = "New player protection: %s",
			Shielded = "🛡 Shielded %s",
			RecentlyNuked = "Recently nuked: %s",
			TooWeak = "Too weak to target",
			TooCloseToBase = "Too close to a base",
			OffMap = "Off the map",
			NoGround = "No ground there",
		} :: { [string]: string },
	},
}

function NukeConfig.DamageAt(def: KindDef, distance: number): number
	if distance <= def.CoreRadius then
		return def.CoreDamage
	end
	if distance > def.Radius then
		return 0
	end
	local t = (distance - def.CoreRadius) / math.max(1, def.Radius - def.CoreRadius)
	return math.floor(def.EdgeDamageMax - (def.EdgeDamageMax - def.EdgeDamageMin) * t + 0.5)
end

-- J8: damage to a (non-immune) vehicle at this distance; math.huge inside the core (destroyed outright).
function NukeConfig.VehicleDamageAt(def: KindDef, distance: number): number
	if distance > def.Radius then
		return 0
	end
	if distance <= def.CoreRadius and NukeConfig.Vehicles.CoreDestroys then
		return math.huge
	end
	return NukeConfig.DamageAt(def, distance) * NukeConfig.Vehicles.EdgeDamageMult
end

function NukeConfig.LaunchXP(def: KindDef, xpToNext: number): number
	local raw = (tonumber(xpToNext) or 0) * def.LaunchXPFactor
	if raw ~= raw or raw == math.huge then
		return def.LaunchXPMax
	end
	return math.clamp(math.floor(raw + 0.5), def.LaunchXPMin, def.LaunchXPMax)
end

function NukeConfig.Power(level: number, prestige: number): number
	return math.max(1, math.floor(level)) + math.max(0, math.floor(prestige)) * NukeConfig.Rules.PowerPerPrestige
end

-- Silo level 1..5 → build seconds / capacity (nil outside the table).
function NukeConfig.SiloBuildSeconds(level: number): number?
	return NukeConfig.Silo.BuildSeconds[math.floor(level)]
end

function NukeConfig.SiloCapacity(level: number): number
	return NukeConfig.Silo.Capacity[math.floor(level)] or 0
end

function NukeConfig.FormatTime(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

return NukeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">OilRigConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Coastal oil platform POIs — harder guards, higher capture stipends.
	Wired into TerritoryConfig Ids CoastalOilAlpha / CoastalOilBravo.
]]

local OilRigConfig = {
