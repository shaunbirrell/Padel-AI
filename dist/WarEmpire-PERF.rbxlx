		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	p({
		Name = "TentFoldL",
		Size = Vector3.new(0.35, 3.5, 6.0),
		CFrame = cf * CFrame.new(-3.9, 2.0, 0),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	p({
		Name = "TentFoldR",
		Size = Vector3.new(0.35, 3.5, 6.0),
		CFrame = cf * CFrame.new(3.9, 2.0, 0),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	-- Center + corner poles
	p({
		Name = "TentPole",
		Size = Vector3.new(0.3, 5.2, 0.3),
		CFrame = cf * CFrame.new(0, 2.6, 0),
		Color = COL.TentPole,
		Material = Enum.Material.Wood,
		Parent = folder,
