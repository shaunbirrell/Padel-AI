	-- 12) Plot-ring perimeter + Design densify 8–12 warzone props / plot (no neon/flat SWAT)
	do
		local f = Instance.new("Folder")
		f.Name = "PlotRingPerimeter"
		f.Parent = dressing
		local plotCenters = {
			Vector3.new(-800, 0.5, -400),
			Vector3.new(-800, 0.5, 400),
			Vector3.new(0, 0.5, -800),
			Vector3.new(0, 0.5, 800),
			Vector3.new(800, 0.5, -400),
			Vector3.new(800, 0.5, 400),
		}
		local plotEdges = if full
			then {
				{ Vector3.new(-800, 0.5, -650), 0 },
				{ Vector3.new(-800, 0.5, 650), 0 },
				-- v70: (0, +-950) dropped (inside P3 / P4)
				{ Vector3.new(800, 0.5, -650), 180 },
				{ Vector3.new(800, 0.5, 650), 180 },
			}
			else {
				{ Vector3.new(-800, 0.5, -650), 0 },
				{ Vector3.new(800, 0.5, 650), 180 },
			}
		for _, e in ipairs(plotEdges) do
			kitSandbagLine(f, e[1], e[2], if full then 4 else 2)
		end
		-- 8–12 clusters per plot (always; Low still gets 8)
		local densify = Instance.new("Folder")
		densify.Name = "PlotWarzoneDensify"
		densify.Parent = dressing
		-- v70 (spec §9.7): the 320 layout places its own WarzoneSpots inside each base; the 55-91 ring is inside the
		-- base (plaza, roads, buildings), so the densify pass is skipped whole while BaseLayoutConfig.Enabled.
		local perPlot = if LAYOUT_ON then 0 elseif full then 12 else 8
		for pi, center in ipairs(plotCenters) do
			for i = 1, perPlot do
				local ang = (i / perPlot) * math.pi * 2 + pi * 0.35
				local rad = 55 + (i % 4) * 12
				local origin = center + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
				local yaw = (i * 41 + pi * 17) % 180
				-- v70: rad 55–91 was outside the old 200 plots but is inside the 320 base now (sandbags / bunkers on
				-- the runway and rear zone). Skip anything inside the footprint + 12 until the waterways pass re-homes them.
				local inside = math.max(math.abs(origin.X - center.X), math.abs(origin.Z - center.Z)) < PLOT_SIZE * 0.5 + 12
				if inside then
					-- skipped (base interior)
				elseif i % 3 == 0 then
					kitSandbagLine(densify, origin, yaw, if full then 4 else 3)
				elseif i % 3 == 1 then
					kitCrateStack(densify, origin)
					kitOilDrums(densify, origin + Vector3.new(4, 0, 2), 2)
				else
					kitBunker(densify, origin, yaw)
				end
			end
		end
	end


	-- 13) Mid-map warzone fill (Low + Full) — sandbags, crates, trenches, debris near roads
	do
		local f = Instance.new("Folder")
		f.Name = "WarzoneFill"
		f.Parent = dressing
		local fills = if full
			then {
				Vector3.new(200, 0.5, -200), Vector3.new(-200, 0.5, 200), Vector3.new(350, 0.5, 350),
				Vector3.new(-350, 0.5, -350), Vector3.new(0, 0.5, -550), Vector3.new(550, 0.5, 0),
				Vector3.new(-550, 0.5, 0), Vector3.new(0, 0.5, 550), -- v70: (750,-400) / (-750,400) dropped (inside P5 / P2)
				Vector3.new(400, 0.5, -900), Vector3.new(-400, 0.5, 900),
			}
			else {
				Vector3.new(200, 0.5, -200), Vector3.new(-200, 0.5, 200), Vector3.new(0, 0.5, -550),
				Vector3.new(550, 0.5, 0), Vector3.new(-550, 0.5, 0), Vector3.new(350, 0.5, 350),
			}
		for i, origin in ipairs(fills) do
			kitSandbagLine(f, origin, (i * 37) % 180, if full then 5 else 3)
			kitCrateStack(f, origin + Vector3.new(8, 0, 4))
			kitOilDrums(f, origin + Vector3.new(-6, 0, 6), if full then 3 else 2)
			-- Simple trench cut (visual depression plate + berm)
			p({
				Name = "Trench" .. i,
				Size = Vector3.new(18, 1.2, 4),
				Position = origin + Vector3.new(0, 0.2, -10),
				Color = COL.Sandbag,
				Material = Enum.Material.Sand,
				CanCollide = true,
				CanQuery = true,
				Parent = f,
			})
			p({
				Name = "Debris" .. i,
				Size = Vector3.new(3 + (i % 3), 0.7, 2),
				Position = origin + Vector3.new(12, 0.6, -4),
				Color = COL.Ruin,
				Material = Enum.Material.Slate,
				CanCollide = true,
				CanQuery = true,
				Parent = f,
			})
			if full or i % 2 == 0 then
				kitBunker(f, origin + Vector3.new(-14, 0, 12), i * 40)
			end
		end
	end

	-- 14) v36 road warzone density — crater / sandbag / chevron clusters between plots (reuse kits)
	do
		local f = Instance.new("Folder")
		f.Name = "RoadWarzone_v36"
		f.Parent = dressing
		-- Roads between the 6 plot ring (~radius 800); keep part count modest
		local roadSpots = if full
			then {
				Vector3.new(-400, 0.5, -400), Vector3.new(400, 0.5, -400),
				Vector3.new(-400, 0.5, 400), Vector3.new(400, 0.5, 400),
				Vector3.new(0, 0.5, -400), Vector3.new(0, 0.5, 400),
				Vector3.new(-400, 0.5, 0), Vector3.new(400, 0.5, 0),
				Vector3.new(-200, 0.5, -600), Vector3.new(200, 0.5, 600),
				Vector3.new(-600, 0.5, 200), Vector3.new(600, 0.5, -200),
				Vector3.new(-150, 0.5, -150), Vector3.new(150, 0.5, 150),
			}
			else {
				Vector3.new(-400, 0.5, -400), Vector3.new(400, 0.5, 400),
				Vector3.new(0, 0.5, -400), Vector3.new(-400, 0.5, 0),
				Vector3.new(200, 0.5, 200), Vector3.new(-200, 0.5, 600),
				Vector3.new(600, 0.5, -200), Vector3.new(-150, 0.5, -150),
			}
		for i, origin in ipairs(roadSpots) do
			local yaw = (i * 41) % 180
			-- Crater scorch plate
			p({
				Name = "RoadCrater" .. i,
				Size = Vector3.new(10 + (i % 4), 0.18, 8 + (i % 3)),
				CFrame = CFrame.new(origin + Vector3.new(0, 0.04, 0)),
				Color = Color3.fromRGB(40, 36, 30),
				Material = Enum.Material.Asphalt,
				CanCollide = false,
				Parent = f,
			})
			p({
				Name = "RoadCraterRim" .. i,
				Size = Vector3.new(3.5, 0.8, 3.5),
				Position = origin + Vector3.new(2, 0.3, -1),
				Color = COL.Ruin,
				Material = Enum.Material.Slate,
				CanCollide = true,
				CanQuery = true,
				Parent = f,
			})
			kitSandbagLine(f, origin + Vector3.new(6, 0, 2), yaw, if full then 4 else 2)
			-- Chevron road marking (military approach stripe)
			p({
				Name = "RoadChevron" .. i,
				Size = Vector3.new(6, 0.12, 1.4),
				CFrame = CFrame.new(origin + Vector3.new(-4, 0.08, 0)) * CFrame.Angles(0, math.rad(yaw), 0),
				Color = Color3.fromRGB(230, 200, 80),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = f,
			})
			if full or i % 2 == 0 then
				kitCrateStack(f, origin + Vector3.new(-8, 0, 5))
			end
			if full and i % 3 == 0 then
				kitOilDrums(f, origin + Vector3.new(5, 0, -6), 2)
			end
		end
	end


	-- 15) P0 — Road rhythm: asphalt strips + jersey + chevrons at junctions
	do
		local f = Instance.new("Folder")
		f.Name = "RoadRhythm_P0"
		f.Parent = dressing
		-- Junction pads (road rhythm rule: RoadSign + LightPole + 2 jersey + chevrons)
		local junctions = if full
			then {
				{ Pos = Vector3.new(0, 0.5, -400), Yaw = 0 },
				{ Pos = Vector3.new(0, 0.5, 400), Yaw = 180 },
				{ Pos = Vector3.new(-400, 0.5, 0), Yaw = -90 },
				{ Pos = Vector3.new(400, 0.5, 0), Yaw = 90 },
				{ Pos = Vector3.new(-800, 0.5, 0), Yaw = -90 },
				{ Pos = Vector3.new(800, 0.5, 0), Yaw = 90 },
				{ Pos = Vector3.new(0, 0.5, -800), Yaw = 0 },
				{ Pos = Vector3.new(0, 0.5, 800), Yaw = 180 },
				{ Pos = Vector3.new(-400, 0.5, -400), Yaw = 45 },
				{ Pos = Vector3.new(400, 0.5, 400), Yaw = -45 },
			}
			else {
				{ Pos = Vector3.new(0, 0.5, -400), Yaw = 0 },
				{ Pos = Vector3.new(400, 0.5, 0), Yaw = 90 },
				{ Pos = Vector3.new(0, 0.5, 800), Yaw = 180 },
				{ Pos = Vector3.new(-800, 0.5, 0), Yaw = -90 },
			}
		for i, j in ipairs(junctions) do
			if not tooCloseToGameplay(j.Pos, 30) then
				kitAsphaltStrip(f, j.Pos, j.Yaw, 36, 14)
				kitChevronWedges(f, j.Pos + Vector3.new(0, 0, 0), j.Yaw)
				-- Jersey pair (staggered), never wall-to-wall
				kitJersey(f, j.Pos + Vector3.new(10, 0, 6), j.Yaw)
				kitJersey(f, j.Pos + Vector3.new(-10, 0, -6), j.Yaw + 180)
				if i % 2 == 1 then
					kitRoadSign(f, j.Pos + Vector3.new(14, 0, 0), j.Yaw)
				end
				if full or i % 2 == 0 then
					kitLightPole(f, j.Pos + Vector3.new(-14, 0, 8))
				end
			end
		end
		-- Mid-segment jersey every ~20 studs along plot ring roads (sparse)
		local shoulder = if full
			then {
				Vector3.new(22, 0.5, -200), Vector3.new(-22, 0.5, 200),
				Vector3.new(200, 0.5, 22), Vector3.new(-200, 0.5, -22),
				Vector3.new(22, 0.5, -600), Vector3.new(-22, 0.5, 600),
				Vector3.new(600, 0.5, 22), Vector3.new(-600, 0.5, -22),
				Vector3.new(22, 0.5, -1000), Vector3.new(-22, 0.5, 1000),
				Vector3.new(1000, 0.5, 22), Vector3.new(-1000, 0.5, -22),
			}
			else {
				Vector3.new(22, 0.5, -200), Vector3.new(200, 0.5, 22),
				Vector3.new(22, 0.5, -600), Vector3.new(600, 0.5, 22),
				Vector3.new(-22, 0.5, 600), Vector3.new(-600, 0.5, -22),
			}
		for _, origin in ipairs(shoulder) do
			if not tooCloseToGameplay(origin, 25) then
				local yaw = if math.abs(origin.X) > math.abs(origin.Z) then 90 else 0
				kitJersey(f, origin, yaw)
			end
		end
		-- Contested HESCO shoulders (Full only)
		if full then
			local hescoSpots = {
				Vector3.new(180, 0.5, -180), Vector3.new(-180, 0.5, 180),
				Vector3.new(320, 0.5, 280), Vector3.new(-320, 0.5, -280),
			}
			for i, origin in ipairs(hescoSpots) do
				if not tooCloseToGameplay(origin, 28) then
					kitHesco(f, origin, i * 40)
				end
			end
		end
	end

	-- 16) P0 — Horizon mesa + flora densify + desert rocks
	do
		local f = Instance.new("Folder")
		f.Name = "Horizon_P0"
		f.Parent = dressing
		local mesas = if full
			then {
				{ Pos = Vector3.new(2200, 2, 2420), Yaw = 225 }, -- v70: z 1800 was in the sea
				{ Pos = Vector3.new(-2200, 2, 2420), Yaw = -45 },
				{ Pos = Vector3.new(2200, 2, -1800), Yaw = 135 },
				{ Pos = Vector3.new(-2200, 2, -1800), Yaw = 45 },
				{ Pos = Vector3.new(0, 4, 2400), Yaw = 180 },
				{ Pos = Vector3.new(0, 4, -2400), Yaw = 0 },
				{ Pos = Vector3.new(2400, 3, 0), Yaw = -90 },
				{ Pos = Vector3.new(-2400, 3, 0), Yaw = 90 },
			}
			else {
				{ Pos = Vector3.new(2200, 2, 2420), Yaw = 225 }, -- v70: z 1800 was in the sea
				{ Pos = Vector3.new(-2200, 2, -1800), Yaw = 45 },
				{ Pos = Vector3.new(0, 4, 2400), Yaw = 180 },
				{ Pos = Vector3.new(2400, 3, 0), Yaw = -90 },
			}
		for _, m in ipairs(mesas) do
			kitMesaHost(f, m.Pos, m.Yaw)
			kitDesertRockScatter(f, m.Pos + Vector3.new(35, 0, 20))
			kitDesertRockScatter(f, m.Pos + Vector3.new(-30, 0, -25))
		end
		-- Far-ring palm hosts (catalog Palm / PalmAlt) every ~150–200 studs on rim sample
		local palmRim = if full then 10 else 6
		for i = 1, palmRim do
			local ang = (i / palmRim) * math.pi * 2
			local r = 2100 + ((i * 47) % 80)
			local pos = Vector3.new(math.cos(ang) * r, 0.5, math.sin(ang) * r)
			if onWaterOrPlot(pos, 8) then
				continue -- v70: rim spots on the sea band are skipped (no catalog insert for a prop the cull would drop)
			end
			local host = p({
				Name = "PalmHorizonHost" .. i,
				Size = Vector3.new(2, 10, 2),
				Position = pos + Vector3.new(0, 5, 0),
				Transparency = 1,
				CanCollide = false,
				Parent = f,
			})
			tryPropAttach(host, "Palm")
		end
		-- Off-road flora clusters every ~100 studs (sampled)
		local floraSpots = if full
			then {
				Vector3.new(500, 0.5, 700), Vector3.new(-500, 0.5, -700),
				Vector3.new(720, 0.5, -640), Vector3.new(-720, 0.5, 640), -- v70: were (700,-500) / (-700,500), inside P5 / P2
				Vector3.new(1100, 0.5, 400), Vector3.new(-1100, 0.5, -400),
				Vector3.new(400, 0.5, 1100), Vector3.new(-400, 0.5, -1100),
				Vector3.new(1500, 0.5, -360), Vector3.new(-1500, 0.5, 360), -- v70: z +-300 touched the P5 / P2 dock channels
			}
			else {
				Vector3.new(500, 0.5, 700), Vector3.new(-500, 0.5, -700),
				Vector3.new(1100, 0.5, 400), Vector3.new(-1100, 0.5, -400),
			}
		for _, origin in ipairs(floraSpots) do
			if not tooCloseToGameplay(origin, 30) then
				kitFloraCluster(f, origin)
				kitDesertRockScatter(f, origin + Vector3.new(12, 0, -8))
			end
		end
	end

	-- 17) P1 — Warzone fill (wrecks / ruins / camo / lights) — skip if near capture
	do
		local f = Instance.new("Folder")
		f.Name = "WarzoneFill_P1"
		f.Parent = dressing
		-- Wreck sites: existing (-350,-450) + new quadrants
		local wrecks = if full
			then {
				{ Pos = Vector3.new(-350, 0.5, -450), Yaw = 25 },
				{ Pos = Vector3.new(400, 0.5, 500), Yaw = 110 },
				{ Pos = Vector3.new(-880, 0.5, 150), Yaw = -30 }, -- v70: was (-800,300), inside P2
				{ Pos = Vector3.new(900, 0.5, -700), Yaw = 70 },
			}
			else {
				{ Pos = Vector3.new(-350, 0.5, -450), Yaw = 25 },
				{ Pos = Vector3.new(400, 0.5, 500), Yaw = 110 },
			}
		for _, w in ipairs(wrecks) do
			if not tooCloseToGameplay(w.Pos, 30) then
				kitWreckSite(f, w.Pos, w.Yaw)
			end
		end
		local ruins = if full
			then {
				{ Pos = Vector3.new(250, 0.5, -700), Yaw = 20 },
				{ Pos = Vector3.new(-600, 0.5, 250), Yaw = 100 },
				{ Pos = Vector3.new(560, 0.5, 330), Yaw = -40 }, -- v70: was (700,350), inside P6
				{ Pos = Vector3.new(-300, 0.5, 750), Yaw = 160 },
			}
			else {
				{ Pos = Vector3.new(250, 0.5, -700), Yaw = 20 },
				{ Pos = Vector3.new(-600, 0.5, 250), Yaw = 100 },
			}
		for _, r in ipairs(ruins) do
			if not tooCloseToGameplay(r.Pos, 30) then
				kitRuinLandmark(f, r.Pos, r.Yaw)
			end
		end
		local camoSpots = if full
			then {
				Vector3.new(150, 0.5, -350), Vector3.new(-150, 0.5, 350),
				Vector3.new(450, 0.5, -150), Vector3.new(-450, 0.5, 150),
				Vector3.new(60, 0.5, -1010), Vector3.new(-60, 0.5, 1010), -- v70: were (50,-900) / (-50,900), inside P3 / P4
			}
			else {
				Vector3.new(150, 0.5, -350), Vector3.new(-450, 0.5, 150),
				Vector3.new(60, 0.5, -1010), -- v70: was (50,-900), inside P3
			}
		for _, origin in ipairs(camoSpots) do
			if not tooCloseToGameplay(origin, 28) then
				kitCamoOverCrates(f, origin)
			end
		end
		local lights = if full
			then {
				Vector3.new(100, 0.5, -1100), Vector3.new(-100, 0.5, 1100),
				Vector3.new(1100, 0.5, 100), Vector3.new(-1100, 0.5, -100),
				Vector3.new(850, 0.5, 850), Vector3.new(-850, 0.5, -850),
			}
			else {
				Vector3.new(100, 0.5, -1100), Vector3.new(1100, 0.5, 100),
			}
		for _, origin in ipairs(lights) do
			if not tooCloseToGameplay(origin, 28) then
				kitPortableLight(f, origin, full)
			end
		end
		-- Overlay CamoNet on vehicle DISPLAY silhouettes in RoadFurniture (Full)
		if full then
			for _, d in ipairs(dressing:GetDescendants()) do
				if d:IsA("BasePart") and (d.Name == "DecoyBody" or d.Name == "DecoyHull") then
					local parent = d.Parent
					if parent and parent:IsA("Folder") then
						local net = p({
							Name = "CamoNetOverVehicle",
							Size = Vector3.new(6, 0.8, 8),
							CFrame = d.CFrame * CFrame.new(0, 4, 0),
							Transparency = 0.5,
							CanCollide = false,
							Color = COL.OliveDark,
							Material = Enum.Material.Fabric,
							Parent = parent,
						})
						tryPropAttach(net, "CamoNet")
						break -- one sample only (perf)
					end
				end
			end
		end
	end


	-- v70 safety net (spec §9.12): nothing in the water or on a plot pad (WE_AllowInWater exempts the harbour piers)
	local culled = 0
	local ww = getWaterways()
	if ww then
		local okCull, res = pcall(ww.CullDressing, dressing)
		if okCull and type(res) == "number" then
			culled = res
		elseif not okCull then
			warn("[MapDressing] water cull failed:", res)
		end
	end

	local partCount = 0
	for _, d in ipairs(dressing:GetDescendants()) do
		if d:IsA("BasePart") then
			partCount += 1
			d.CastShadow = false
		end
	end
	print("[WAR EMPIRE] MapDressing complete: quality=" .. quality .. " parts=" .. tostring(partCount) .. " culled=" .. tostring(culled) .. " densify=P0+P1 (CastShadow=false)")
end

return MapDressing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">MapSetup</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — MapSetup (shared world build)
	Builds Workspace.WarEmpireSetup: map, plots, structure kits, territories,
	spawns, tutorial markers, NPC placeholders, desert lighting, MapDressing + DesertFlora.
	Called from Bootstrap when WarEmpireSetup is missing (Play Solo / server start).
	Admin `resetmap` destroys WarEmpireSetup and re-runs.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local MapDressing = require(script.Parent:WaitForChild("MapDressing"))
local DesertFlora = require(script.Parent:WaitForChild("DesertFlora"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedConfigs = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs")
local DevConfig = require(SharedConfigs:WaitForChild("DevConfig"))
local MonetizationConfig = require(SharedConfigs:WaitForChild("MonetizationConfig"))
local StructureVisualConfig = require(SharedConfigs:WaitForChild("StructureVisualConfig"))
local BaseLayout = require(script.Parent:WaitForChild("BaseLayout"))
-- v70 waterways: plot water, sea gates, naval pads, road ends, rig piers (public water = Modules.Waterways)
local WaterConfig = require(SharedConfigs:WaitForChild("WaterConfig"))
-- v70 (HUD spec §5): every floating label goes through the shared helper (stud-scaled, 14-20 px, MaxDistance <= 40)
local WorldLabel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("WorldLabel"))

local TAG_BASE = "WE_BasePlot"
local TAG_SLOT = "WE_UpgradeSlot"
local TAG_TERRITORY = "WE_Territory"
local TAG_CAPTURE = "WE_CaptureZone"
local TAG_VEHICLE = "WE_VehicleSpawn"
local TAG_WATER = "WE_Water" -- v69: boats sail on WE_Water surfaces (Constants.Tags.Water)
local TAG_NAVAL = "WE_NavalSpawn"
local TAG_NPC = "WE_NPCSpawn"
local TAG_EVENT = "WE_EventSpawn"
local TAG_TUTORIAL = "WE_TutorialMarker"
local TAG_NPC_ENTITY = "WE_NPC"
local TAG_COLLECTOR = "WE_MoneyCollector"
local TAG_PREMIUM = "WE_PremiumPad"

local COL_GROUND = Color3.fromRGB(210, 185, 130) -- pale sandy-yellow desert floor
-- v67 base look: light concrete plot floor + painted olive edge (was near-black navy + green Neon)
local BASE_LOOK = (StructureVisualConfig :: any).BaseLook or {}
local COL_PAD = BASE_LOOK.PlotFloor or Color3.fromRGB(168, 162, 148)
local COL_PAD_EDGE = BASE_LOOK.PlotEdge or Color3.fromRGB(86, 98, 64)
local COL_CHEVRON = BASE_LOOK.Chevron or Color3.fromRGB(230, 196, 70)
local COL_VEHICLE = Color3.fromRGB(48, 62, 78)
local COL_NPC = Color3.fromRGB(88, 42, 42)
local COL_EVENT = Color3.fromRGB(78, 64, 36)

local STRUCTURES = {
	{ Id = "CommandCenter", Kit = "hq", Plinth = Color3.fromRGB(36, 48, 40), Body = Color3.fromRGB(55, 78, 58), Accent = Color3.fromRGB(230, 190, 60), Roof = Color3.fromRGB(40, 55, 45) },
	{ Id = "Barracks", Kit = "barracks", Plinth = Color3.fromRGB(150, 120, 80), Body = Color3.fromRGB(175, 145, 100), Accent = Color3.fromRGB(210, 170, 80), Roof = Color3.fromRGB(130, 100, 70) },
	{ Id = "VehicleDepot", Kit = "depot", Plinth = Color3.fromRGB(40, 48, 55), Body = Color3.fromRGB(58, 72, 88), Accent = Color3.fromRGB(90, 160, 220), Roof = Color3.fromRGB(45, 55, 65) },
	{ Id = "WeaponsFacility", Kit = "armory", Plinth = Color3.fromRGB(48, 40, 38), Body = Color3.fromRGB(88, 58, 50), Accent = Color3.fromRGB(200, 90, 70), Roof = Color3.fromRGB(55, 42, 40) },
	{ Id = "Helipad", Kit = "helipad", Plinth = Color3.fromRGB(45, 50, 48), Body = Color3.fromRGB(60, 70, 65), Accent = Color3.fromRGB(220, 200, 80), Roof = Color3.fromRGB(50, 55, 52) },
	{ Id = "Dock", Kit = "dock", Plinth = Color3.fromRGB(35, 48, 58), Body = Color3.fromRGB(50, 75, 95), Accent = Color3.fromRGB(70, 180, 220), Roof = Color3.fromRGB(40, 58, 70) },
	{ Id = "Airfield", Kit = "airfield", Plinth = Color3.fromRGB(50, 52, 48), Body = Color3.fromRGB(70, 72, 68), Accent = Color3.fromRGB(180, 190, 100), Roof = Color3.fromRGB(55, 58, 52) },
	{ Id = "DefensiveWalls", Kit = "wall", Plinth = Color3.fromRGB(48, 48, 45), Body = Color3.fromRGB(85, 85, 78), Accent = Color3.fromRGB(120, 130, 110), Roof = Color3.fromRGB(60, 60, 55) },
	{ Id = "Watchtowers", Kit = "tower", Plinth = Color3.fromRGB(44, 46, 40), Body = Color3.fromRGB(72, 78, 60), Accent = Color3.fromRGB(200, 160, 70), Roof = Color3.fromRGB(50, 52, 44) },
	{ Id = "Radar", Kit = "radar", Plinth = Color3.fromRGB(40, 42, 55), Body = Color3.fromRGB(55, 60, 90), Accent = Color3.fromRGB(100, 200, 255), Roof = Color3.fromRGB(45, 48, 70) },
	{ Id = "ResearchLab", Kit = "lab", Plinth = Color3.fromRGB(38, 45, 55), Body = Color3.fromRGB(50, 70, 95), Accent = Color3.fromRGB(80, 180, 220), Roof = Color3.fromRGB(42, 55, 72) },
	{ Id = "MissileDefense", Kit = "tower", Plinth = Color3.fromRGB(48, 42, 40), Body = Color3.fromRGB(75, 55, 50), Accent = Color3.fromRGB(220, 100, 60), Roof = Color3.fromRGB(55, 45, 42) },
	{ Id = "PowerStation", Kit = "power", Plinth = Color3.fromRGB(50, 48, 35), Body = Color3.fromRGB(90, 85, 50), Accent = Color3.fromRGB(255, 210, 70), Roof = Color3.fromRGB(60, 55, 40) },
	{ Id = "Warehouse", Kit = "warehouse", Plinth = Color3.fromRGB(140, 115, 75), Body = Color3.fromRGB(165, 135, 90), Accent = Color3.fromRGB(200, 160, 90), Roof = Color3.fromRGB(120, 95, 65) },
	{ Id = "SpecialForcesFacility", Kit = "special", Plinth = Color3.fromRGB(35, 38, 42), Body = Color3.fromRGB(45, 55, 65), Accent = Color3.fromRGB(160, 80, 200), Roof = Color3.fromRGB(30, 35, 40) },
}

-- Map scale: ground ≥6000 continuous floor, plot ring ~800, pads ~200
-- Top of Ground sits ~Y=0.5 so plot pads (Y=0.5) sit flush.
local GROUND_SIZE = 7200
local GROUND_THICKNESS = 8
local GROUND_TOP_Y = 0.5
local SAFETY_FLOOR_SIZE = 10000
local SAFETY_FLOOR_Y = -28
-- v70 (spec_final §12.1): Roblox caps a BasePart at 2048 studs per axis, so the 7200 floor, the 10000 safety catch
-- and the 7200 berms / void walls are TILED (shared edges, no overlap → no z-fight). Ground: 4 x 4 tiles of 1800.
local GROUND_TILES_PER_SIDE = 4 -- 7200 / 4 = 1800 per ground tile
local SAFETY_TILES_PER_SIDE = 5 -- 10000 / 5 = 2000 per safety-catch tile
local EDGE_PIECES = 4 -- EdgeBerm* (7120 / 4 = 1780) / VoidWall* (7200 / 4 = 1800) pieces per side
local PLOT_PAD_SIZE = BaseLayout.PlotSize(200) -- v68: BaseLayoutConfig.PlotSize (320) when the layout is on
local PLOT_RING = 800
local PLOT_SPAWN_CLEARANCE = 40 -- v68: vehicle / NPC / event spawn pads stay this far outside plot edges
local STRUCT_COLS = 4
local STRUCT_GAP = 42 -- studs between upgrade pad centers (was 30)
local STRUCT_ORIGIN = Vector3.new(-63, 1.6, -63) -- CommandCenter grid origin on each plot

local PLOT_POSITIONS = {
	Vector3.new(-PLOT_RING, 0.5, -PLOT_RING * 0.5), -- Plot1 SW
	Vector3.new(-PLOT_RING, 0.5, PLOT_RING * 0.5), -- Plot2 NW
	Vector3.new(0, 0.5, -PLOT_RING), -- Plot3 S
	Vector3.new(0, 0.5, PLOT_RING), -- Plot4 N
	Vector3.new(PLOT_RING, 0.5, -PLOT_RING * 0.5), -- Plot5 SE
	Vector3.new(PLOT_RING, 0.5, PLOT_RING * 0.5), -- Plot6 NE
}

local TERRITORIES = {
	{ Id = "CentralPlaza", DisplayName = "Central Plaza", Pos = Vector3.new(0, 1, 0), Color = Color3.fromRGB(180, 170, 50), Radius = 70 },
	{ Id = "NorthRidge", DisplayName = "North Ridge", Pos = Vector3.new(0, 1, -1300), Color = Color3.fromRGB(55, 120, 180), Radius = 60 },
	{ Id = "SouthDocks", DisplayName = "South Docks", Pos = Vector3.new(0, 1, 1300), Color = Color3.fromRGB(45, 110, 150), Radius = 60 },
	{ Id = "EastArmory", DisplayName = "East Armory", Pos = Vector3.new(1300, 1, 0), Color = Color3.fromRGB(170, 55, 55), Radius = 55 },
	{ Id = "WestDepot", DisplayName = "West Depot", Pos = Vector3.new(-1300, 1, 0), Color = Color3.fromRGB(55, 140, 70), Radius = 55 },
	{ Id = "OilFields", DisplayName = "Oil Fields", Pos = Vector3.new(950, 1, 950), Color = Color3.fromRGB(150, 110, 40), Radius = 65 },
	{ Id = "RadarHill", DisplayName = "Radar Hill", Pos = Vector3.new(-950, 1, -950), Color = Color3.fromRGB(130, 70, 170), Radius = 60 },
	-- Coastal oil decks (Y matches TerritoryConfig / OilRigConfig platform height)
	{ Id = "CoastalOilAlpha", DisplayName = "Coastal Oil Alpha", Pos = Vector3.new(1800, 28, -750), Color = Color3.fromRGB(190, 145, 45), Radius = 48, OilRig = true },
	{ Id = "CoastalOilBravo", DisplayName = "Coastal Oil Bravo", Pos = Vector3.new(-1800, 28, 750), Color = Color3.fromRGB(170, 125, 40), Radius = 48, OilRig = true },
	{ Id = "FortIronclad", DisplayName = "Fort Ironclad", Pos = Vector3.new(1450, 1, -1450), Color = Color3.fromRGB(140, 145, 155), Radius = 55, Fortress = true },
	{ Id = "FortSandhold", DisplayName = "Fort Sandhold", Pos = Vector3.new(-1450, 1, 1450), Color = Color3.fromRGB(190, 155, 90), Radius = 55, Fortress = true },
}

local function ensureFolder(name, parent)
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function part(props: { [string]: any })
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	-- Explicit safe assignment (avoid (p :: any)[k] = v strict/runtime quirks)
	if props.Name ~= nil then
		p.Name = props.Name
	end
	if props.Size ~= nil then
		p.Size = props.Size
	end
	if props.CFrame ~= nil then
		p.CFrame = props.CFrame
	elseif props.Position ~= nil then
		p.Position = props.Position
	end
	if props.Color ~= nil then
		p.Color = props.Color
	end
	if props.Material ~= nil then
		p.Material = props.Material
	end
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.Anchored ~= nil then
		p.Anchored = props.Anchored
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	if props.Parent ~= nil then
		p.Parent = props.Parent
	end
	-- Deco/kits: shadows off by default (huge Studio GPU win). Opt-in via CastShadow=true.
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	else
		p.CastShadow = false
	end

	return p
end

local function siteFrameOf(plinth: BasePart): CFrame
	local cf = plinth:GetAttribute("WE_SiteCFrame")
	if typeof(cf) == "CFrame" then
		return cf
	end
	return plinth.CFrame
end

local function kitPart(parentPlinth, role, size, localOffset, color, material, shape)
	local p = part({
		Name = role,
		Size = size,
		CFrame = siteFrameOf(parentPlinth) * CFrame.new(localOffset),
		Color = color,
		Material = material or Enum.Material.Metal,
		CanCollide = false,
		Transparency = 1, -- hidden until BaseService.applyKitVisuals (L0 faint / L1+ solid)
		Parent = parentPlinth,
	})
	if shape then
		p.Shape = shape
	end
	p.CanTouch = false -- never steal walk-buy Touched from plinth
	p.CanQuery = false
	p.CastShadow = false
	p:SetAttribute("WE_KitRole", role)
	p:SetAttribute("WE_BaseSize", size)
	p:SetAttribute("WE_LocalOffset", localOffset)
	p:SetAttribute("WE_Decor", true)
	return p
end

local function neonEdge(parentPart, color, thickness)
	local t = thickness or 0.35
	local s = parentPart.Size
	local edges = {
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, s.Z * 0.5) },
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, -s.Z * 0.5) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(s.X * 0.5, s.Y * 0.5, 0) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(-s.X * 0.5, s.Y * 0.5, 0) },
	}
	for i, e in ipairs(edges) do
		local edge = part({
			Name = "Edge" .. i,
			Size = e[1],
			CFrame = parentPart.CFrame * CFrame.new(e[2]),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.15,
			Parent = parentPart.Parent,
		})
		edge:SetAttribute("WE_Decor", true)
	end
end

-- v67: painted kerb edge (same geometry as neonEdge, no glow)
local function paintEdge(parentPart, color, thickness)
	local t = thickness or 0.35
	local s = parentPart.Size
	local edges = {
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, s.Z * 0.5) },
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, -s.Z * 0.5) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(s.X * 0.5, s.Y * 0.5, 0) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(-s.X * 0.5, s.Y * 0.5, 0) },
	}
	for i, e in ipairs(edges) do
		local edge = part({
			Name = "Edge" .. i,
			Size = e[1],
			CFrame = parentPart.CFrame * CFrame.new(e[2]),
			Color = color,
			Material = Enum.Material.Concrete,
			CanCollide = false,
			Parent = parentPart.Parent,
		})
		edge:SetAttribute("WE_Decor", true)
	end
end

-- v70 (HUD spec §5): no server price card on the consoles (the client draws the owner's own price tag); the old
-- always-on dark card per console is gone.

local function plainBillboard(parent, text, size, offsetY, textColor)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(size.X, size.Y)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = false -- P0: only ATM may AlwaysOnTop when nearest
	bb.MaxDistance = 70 -- base/zone labels near-only (was 950)
	bb.Parent = parent

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(12, 14, 16)
	backdrop.BackgroundTransparency = 0.22
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(70, 90, 70)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = backdrop

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor or Color3.fromRGB(235, 240, 235)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.6
	label.Parent = backdrop
	return bb
end

-- v70: `turn` (optional) = the plot frame for a plot beacon, so the beacon turns with its plot
local function beacon(parent, at: Vector3, color, name, turn: CFrame?)
	local function place(dy: number): CFrame
		local cf = CFrame.new(at + Vector3.new(0, dy, 0))
		return if turn then cf * turn.Rotation else cf
	end
	part({
		Name = name or "Beacon",
		Size = Vector3.new(0.55, 12, 0.55),
		CFrame = place(6),
		Color = Color3.fromRGB(40, 45, 42),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = (name or "Beacon") .. "_Tip",
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = place(13),
		Color = color,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = (name or "Beacon") .. "_Glow",
		Size = Vector3.new(3.2, 0.4, 3.2),
		CFrame = place(0.3),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		Parent = parent,
	})
end

-- v68: terminal look for console-mode upgrade slots (screen + button); decoration only, not kit roles
local function dressConsole(plinth, title)
	local screen = part({
		Name = "ConsoleScreen",
		Size = Vector3.new(2.3, 1.3, 0.16),
		CFrame = plinth.CFrame * CFrame.new(0, BaseLayout.CONSOLE_SIZE.Y * 0.5 + 0.45, -0.25) * CFrame.Angles(math.rad(20), 0, 0),
		Color = Color3.fromRGB(14, 22, 16),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = plinth,
	})
	screen:SetAttribute("WE_Decor", true)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_ConsoleScreen"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0
	sg.MaxDistance = 40 -- v70: SurfaceGuis draw near-only (CLAUDE.md budget, <= 80)
	sg.Parent = screen
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundColor3 = Color3.fromRGB(10, 26, 16)
	lbl.BorderSizePixel = 0
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.fromRGB(120, 255, 150)
	lbl.Text = string.upper(title) .. "\nBUILD / UPGRADE"
	lbl.Parent = sg
	local button = part({
		Name = "ConsoleButton",
		Size = Vector3.new(0.5, 0.2, 0.5),
		CFrame = plinth.CFrame * CFrame.new(0.8, BaseLayout.CONSOLE_SIZE.Y * 0.5 + 0.1, -0.35),
		Color = Color3.fromRGB(90, 255, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = plinth,
	})
	button:SetAttribute("WE_Decor", true)
end

local function buildStructureKit(plotFolder, plotId, pos, offset, def)
	local plinthSize = Vector3.new(8, 1.2, 8)
	-- v68: with BaseLayoutConfig the upgrade slot is a console / kiosk and the kit or walk-in building
	-- stands at its site (WE_SiteCFrame). Buying happens at the console by prompt / tap only.
	local consoleCF = BaseLayout.ConsoleCFrame(pos, def.Id)
	local siteCF = BaseLayout.SiteCFrame(pos, def.Id)
	local isConsole = consoleCF ~= nil and siteCF ~= nil
	if isConsole then
		plinthSize = BaseLayout.CONSOLE_SIZE
	end
	local plinth = part({
		Name = def.Id,
		Size = plinthSize,
		-- legacy grid slot (layout off): plot-local offset through the plot frame (v70)
		Position = if isConsole then (consoleCF :: CFrame).Position else BaseLayout.PlotCFrame(pos):PointToWorldSpace(offset),
		Color = if isConsole then Color3.fromRGB(46, 50, 48) else def.Plinth,
		Transparency = if isConsole then 0 else 0.32,
		Material = if isConsole then Enum.Material.Metal else Enum.Material.Concrete,
		CanCollide = true,
		Parent = plotFolder,
	})
	if isConsole then
		plinth.CFrame = consoleCF :: CFrame
		plinth:SetAttribute("WE_Console", true)
		plinth:SetAttribute("WE_SiteCFrame", siteCF)
	end
	plinth.CanTouch = not isConsole -- legacy walk-over pads only
	plinth:SetAttribute("PlotId", plotId)
	plinth:SetAttribute("StructureId", def.Id)
	plinth:SetAttribute("BaseSize", plinthSize)
	CollectionService:AddTag(plinth, TAG_SLOT)

	local kit = def.Kit
	-- Visual kits v2: distinct silhouettes, painted accents (v70: no Neon), doors/windows (modest part count)
	if kit == "hq" then
		kitPart(plinth, "Body", Vector3.new(5.5, 3.4, 5.5), Vector3.new(0, 2.3, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(6.4, 0.55, 6.4), Vector3.new(0, 4.3, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.8, 0.35), Vector3.new(1.8, 6.8, 1.8), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.22, 6.6), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.1, 1.1, 1.1), Vector3.new(-2, 3.6, -2), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		kitPart(plinth, "Door", Vector3.new(1.6, 2.2, 0.25), Vector3.new(0, 1.7, -2.85), Color3.fromRGB(30, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.4, 1.0, 0.2), Vector3.new(2.0, 2.6, -2.8), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
	elseif kit == "barracks" then
		kitPart(plinth, "Body", Vector3.new(6.6, 2.6, 4.4), Vector3.new(0, 1.9, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.1, 0.5, 5.0), Vector3.new(0, 3.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(6.9, 0.18, 4.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(1.4, 2.0, 0.25), Vector3.new(0, 1.6, -2.3), Color3.fromRGB(35, 40, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.2, 0.9, 0.2), Vector3.new(-2.2, 2.3, -2.25), Color3.fromRGB(70, 120, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 1.8, 0.7), Vector3.new(-3.0, 2.3, 1.5), def.Accent, Enum.Material.SmoothPlastic, nil)
	elseif kit == "depot" then
		kitPart(plinth, "Body", Vector3.new(6.9, 2.2, 5.6), Vector3.new(0, 1.7, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.3, 0.4, 6.1), Vector3.new(0, 2.95, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(3.2, 0.28, 5.9), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(2.8, 2.0, 0.3), Vector3.new(0, 1.6, -2.9), Color3.fromRGB(40, 50, 60), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.8, 2.4, 2.0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "lab" then
		kitPart(plinth, "Body", Vector3.new(5.1, 3.2, 5.1), Vector3.new(0, 2.2, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(5.5, 0.5, 5.5), Vector3.new(0, 4.0, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 3.8, 0.4), Vector3.new(0, 6.1, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(5.7, 0.2, 5.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Window", Vector3.new(1.5, 1.2, 0.2), Vector3.new(0, 2.6, -2.6), Color3.fromRGB(80, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.9, 0.9, 0.9), Vector3.new(2.0, 3.5, 2.0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "tower" then
		kitPart(plinth, "Body", Vector3.new(2.9, 5.8, 2.9), Vector3.new(0, 3.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(3.8, 0.5, 3.8), Vector3.new(0, 6.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.3, 3.5, 0.3), Vector3.new(0, 8.5, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(3.3, 0.22, 3.3), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Window", Vector3.new(1.0, 0.8, 0.2), Vector3.new(0, 4.5, -1.5), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 0.7, 0.7), Vector3.new(0, 7.0, 0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "dock" then
		kitPart(plinth, "Body", Vector3.new(7.5, 0.55, 7.5), Vector3.new(0, 0.9, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Pier", Vector3.new(8.8, 0.4, 2.4), Vector3.new(0, 1.15, 3.3), def.Roof, Enum.Material.Wood, nil)
		kitPart(plinth, "Accent", Vector3.new(7.2, 0.14, 0.4), Vector3.new(0, 1.25, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 2.8, 0.4), Vector3.new(3.3, 2.1, 2.6), def.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(1.8, 0.3, 1.2), Vector3.new(0, 1.35, 4.2), Color3.fromRGB(40, 55, 70), Enum.Material.Metal, nil)
	elseif kit == "pad" then
		kitPart(plinth, "Body", Vector3.new(7.3, 0.45, 7.3), Vector3.new(0, 0.92, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.14, 0.5), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(0.5, 0.14, 6.6), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Roof", Vector3.new(1.6, 0.3, 1.6), Vector3.new(0, 1.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(0.5, 0.5, 0.5), Vector3.new(2.8, 1.4, 2.8), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "wall" then
		kitPart(plinth, "Body", Vector3.new(7.5, 3.0, 1.5), Vector3.new(0, 2.1, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(7.7, 0.25, 1.7), Vector3.new(0, 3.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.4, 1.9), Vector3.new(0, 3.9, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(-3.2, 3.2, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(3.2, 3.2, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
	elseif kit == "power" then
		kitPart(plinth, "Body", Vector3.new(4.6, 3.6, 4.6), Vector3.new(0, 2.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(2.3, 2.3, 2.3), Vector3.new(0, 4.7, 0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		kitPart(plinth, "Roof", Vector3.new(5.1, 0.4, 5.1), Vector3.new(0, 4.4, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.6, 2.5, 0.6), Vector3.new(2.0, 2.8, 2.0), Color3.fromRGB(60, 55, 40), Enum.Material.Metal, nil)
	elseif kit == "warehouse" then
		kitPart(plinth, "Body", Vector3.new(7.1, 2.8, 5.6), Vector3.new(0, 2.0, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.5, 6.1), Vector3.new(0, 3.55, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(7.3, 0.2, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(2.6, 2.2, 0.3), Vector3.new(0, 1.7, -2.95), Color3.fromRGB(50, 45, 38), Enum.Material.Metal, nil)
	else
		kitPart(plinth, "Body", Vector3.new(5.3, 3.5, 5.3), Vector3.new(0, 2.4, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(4.2, 1.2, 4.2), Vector3.new(0, 4.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.2, 0.35), Vector3.new(0, 7.2, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(5.9, 0.22, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.0, 3.5, -2.0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end

	-- Readable DisplayName for the console screen (the client's owner-only price tag uses BaseConfig names)
	local displayNames = {
		CommandCenter = "Command Center",
		Barracks = "Barracks",
		VehicleDepot = "Vehicle Depot",
		WeaponsFacility = "Weapons Facility",
		Helipad = "Helipad",
		Dock = "Naval Dock",
		Airfield = "Airfield",
		DefensiveWalls = "Defensive Walls",
		Watchtowers = "Watchtowers",
		Radar = "Radar Station",
		ResearchLab = "Research Lab",
		MissileDefense = "Missile Defense",
		PowerStation = "Power Station",
		Warehouse = "Warehouse",
		SpecialForcesFacility = "Special Forces",
	}
	local nice = displayNames[def.Id] or def.Id
	if isConsole then
		dressConsole(plinth, nice)
		-- v68: no catalog building mesh on a console (it would be placed at the console, not the site)
		return plinth
	end
	-- Optional catalog building visual — ALWAYS deferred (InsertService must never block pads/remotes)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachBuildingVisual then
				vas.TryAttachBuildingVisual(plinth, def.Id)
			end
		end)
	end)
	return plinth
end



-- Desert camo infantry Part kit — vest / helmet / shemagh accents, clearer rifle
local function makeSoldierKit(parentFolder, name, cf, bodyColor, labelText: string?, labelColor, health, npcType, npcId)
	-- Visual props for Training Yard / static kits. R15-ready catalog overlay via VisualAssetConfig;
	-- Part-kit military placeholder (R6-ish ~5 stud) when mesh IDs missing / StudioSkipWorldDressing.
	-- Live combat NPCs use CombatService.SpawnNPC (BankGuard etc.).
	local model = Instance.new("Model")
	model.Name = name
	if npcId then
		model:SetAttribute("NPCId", npcId)
	end
	if npcType then
		model:SetAttribute("NPCType", npcType)
	end
	local desertBase = Color3.fromRGB(145, 125, 85)
	local camo = desertBase:Lerp(bodyColor, 0.45)
	local camoDark = Color3.fromRGB(
		math.clamp(math.floor(camo.R * 255) - 28, 20, 255),
		math.clamp(math.floor(camo.G * 255) - 22, 20, 255),
		math.clamp(math.floor(camo.B * 255) - 18, 20, 255)
	)
	-- v34: role Part-dress differentiation when mesh IDs reuse / insert fails
	local helmCol = camoDark
	local vestCol = camoDark
	local accentCol = labelColor or Color3.fromRGB(200, 140, 60)
	local role = if typeof(npcType) == "string" then npcType else ""
	if role == "Worker" then
		helmCol = Color3.fromRGB(95, 85, 55) -- soft tan helmet
		vestCol = Color3.fromRGB(80, 95, 60)
		accentCol = Color3.fromRGB(160, 200, 90)
	elseif role == "Infantry" then
		helmCol = Color3.fromRGB(45, 70, 40) -- olive steel
		vestCol = Color3.fromRGB(55, 75, 45)
		accentCol = Color3.fromRGB(180, 220, 120)
	elseif role == "HeavyInfantry" or role == "Heavy" then
		helmCol = Color3.fromRGB(35, 38, 42) -- dark armor helm
		vestCol = Color3.fromRGB(40, 45, 50)
		accentCol = Color3.fromRGB(230, 160, 50)
	elseif role == "Guard" or role == "GateGuard" or role == "BankGuard" then
		helmCol = Color3.fromRGB(30, 40, 55) -- navy / NVG
		vestCol = Color3.fromRGB(40, 50, 65)
		accentCol = Color3.fromRGB(90, 140, 220)
	end
	-- R6 torso = 2×2×1; lift so feet sit on ground (cf is approx mid-body)
	local torso = part({
		Name = "HumanoidRootPart",
		Size = Vector3.new(2, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = true,
		CFrame = cf,
		Parent = model,
	})
	local head = part({
		Name = "Head",
		Size = Vector3.new(1.05, 1.05, 1.05),
		Color = Color3.fromRGB(110, 85, 62),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 1.55, 0),
		Shape = Enum.PartType.Ball,
		Parent = model,
	})
	part({
		Name = "Helmet",
		Size = Vector3.new(1.2, 0.5, 1.2),
		Color = helmCol,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, 0.38, 0),
		Parent = model,
	})
	part({
		Name = "Shemagh",
		Size = Vector3.new(1.25, 0.45, 1.15),
		Color = Color3.fromRGB(200, 185, 150),
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, -0.32, 0.05),
		Parent = model,
	})
	part({
		Name = "Vest",
		Size = Vector3.new(2.1, 1.2, 1.15),
		Color = vestCol,
		Material = Enum.Material.Leather,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.15, 0),
		Parent = model,
	})
	part({
		Name = "VestPouch",
		Size = Vector3.new(1.5, 0.45, 0.3),
		Color = Color3.fromRGB(90, 80, 55),
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.05, -0.6),
		Parent = model,
	})
	-- R6 arms 1×2×1
	part({
		Name = "ArmL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-1.5, 0, 0),
		Parent = model,
	})
	part({
		Name = "ArmR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.5, 0, 0),
		Parent = model,
	})
	-- R6 legs 1×2×1
	part({
		Name = "LegL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "LegR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "BootL",
		Size = Vector3.new(1.05, 0.35, 1.15),
		Color = Color3.fromRGB(35, 32, 28),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -3.1, 0.1),
		Parent = model,
	})
	part({
		Name = "BootR",
		Size = Vector3.new(1.05, 0.35, 1.15),
		Color = Color3.fromRGB(35, 32, 28),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -3.1, 0.1),
		Parent = model,
	})
	part({
		Name = "RifleStock",
		Size = Vector3.new(0.3, 0.4, 0.9),
		Color = Color3.fromRGB(55, 48, 38),
		Material = Enum.Material.Wood,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.15, 0.35),
		Parent = model,
	})
	part({
		Name = "Rifle",
		Size = Vector3.new(0.25, 0.25, 2.4),
		Color = Color3.fromRGB(32, 34, 36),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.2, -0.95),
		Parent = model,
	})
	part({
		Name = "RifleBarrel",
		Size = Vector3.new(0.14, 0.14, 0.9),
		Color = Color3.fromRGB(25, 25, 28),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.22, -2.25),
		Parent = model,
	})
	part({
		Name = "Accent",
		Size = Vector3.new(1.6, 0.1, 0.28),
		Color = accentCol,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.85, -0.5),
		Parent = model,
	})
	if role == "HeavyInfantry" or role == "Heavy" then
		part({
			Name = "Pack",
			Size = Vector3.new(1.4, 1.5, 0.7),
			Color = Color3.fromRGB(40, 42, 38),
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(0, 0.4, 0.85),
			Parent = model,
		})
	end
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = health or 100
	hum.Health = health or 100
	-- Single nametag only via Billboard — kill default Humanoid nameplate
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.NameOcclusion = Enum.NameOcclusion.OccludeAll
	hum.Parent = model
	model.PrimaryPart = torso
	-- Optional free Soldier catalog visual (skipped when StudioSkipWorldDressing)
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		local kind = if typeof(npcType) == "string" and npcType ~= "" then npcType else "Soldier"
		vas.TryAttachCharacterVisual(model, kind)
	end)
	model.Parent = parentFolder
	CollectionService:AddTag(model, TAG_NPC_ENTITY)
	if labelText then
		-- One clean label on head (not also on torso)
		local bb = plainBillboard(head, labelText, Vector2.new(120, 24), 2.2, labelColor or Color3.fromRGB(255, 200, 140))
		bb.Name = "NPCLabel"
		bb.AlwaysOnTop = false
		bb.MaxDistance = 18
		bb.StudsOffset = Vector3.new(0, 2.4, 0)
	end
	return model
end


-- Continuous floor + safety catch + perimeter mountain ring (mobile-friendly part count)
local function groundCenterY(): number
	return GROUND_TOP_Y - GROUND_THICKNESS * 0.5
end

-- v70 (spec_final §12.1): tiled floor layers. Every tile is <= 2000 studs per axis; neighbours share edges exactly.
type TileSpec = { Name: string, At: Vector3, Size: Vector3 }
type TileLook = { Color: Color3, Material: Enum.Material, Transparency: number }

-- centres of n equal tiles of size t that together span n * t, centred on 0
local function tileCentres(n: number, t: number): { number }
	local out: { number } = {}
	for i = 1, n do
		table.insert(out, (i - 0.5) * t - n * t * 0.5)
	end
	return out
end

-- One shared heal path (MapSetup.Run, EnsureGroundHealthy, ForceRebuildGround): build every missing tile and
-- re-assert size / position / collide on the rest (a legacy untiled part with a tile's name is resized to that tile).
-- Returns (tile count, repaired).
local function healTileSet(mapFolder: Instance, specs: { TileSpec }, look: TileLook): (number, boolean)
	local repaired = false
	for _, t in ipairs(specs) do
		local existing = mapFolder:FindFirstChild(t.Name)
		if existing and existing:IsA("BasePart") then
			if existing.Size ~= t.Size or (existing.Position - t.At).Magnitude > 0.01 or existing.CanCollide ~= true or existing.Anchored ~= true then
				repaired = true
			end
			existing.Size = t.Size
			existing.CFrame = CFrame.new(t.At)
			existing.CanCollide = true
			existing.Anchored = true
			existing.Color = look.Color
			existing.Material = look.Material
			existing.Transparency = look.Transparency
		else
			if existing then
				existing:Destroy()
			end
			part({
				Name = t.Name,
				Size = t.Size,
				Position = t.At,
				Color = look.Color,
				Material = look.Material,
				Transparency = look.Transparency,
				CanCollide = true,
				Anchored = true,
				Parent = mapFolder,
			})
			repaired = true
		end
	end
	return #specs, repaired
end

-- destroy the part named `base` and every "<base>_..." piece
local function destroyNamed(mapFolder: Instance, base: string)
	for _, ch in ipairs(mapFolder:GetChildren()) do
		if ch.Name == base or string.sub(ch.Name, 1, #base + 1) == base .. "_" then
			ch:Destroy()
		end
	end
end

-- Ground: 4 x 4 tiles of 1800 x 8 x 1800, top at GROUND_TOP_Y. The tile centred at (-900, -900) keeps the name
-- "Ground" (Bootstrap and the heal checks read Map.Ground); the others are GroundTile_<i>_<j>.
local function groundTileSpecs(): { TileSpec }
	local out: { TileSpec } = {}
	local tile = GROUND_SIZE / GROUND_TILES_PER_SIDE
	local cs = tileCentres(GROUND_TILES_PER_SIDE, tile)
	for i, x in ipairs(cs) do
		for j, z in ipairs(cs) do
			local name = if x == -tile * 0.5 and z == -tile * 0.5 then "Ground" else ("GroundTile_" .. i .. "_" .. j)
			table.insert(out, { Name = name, At = Vector3.new(x, groundCenterY(), z), Size = Vector3.new(tile, GROUND_THICKNESS, tile) })
		end
	end
	return out
end

local function buildGroundTiles(mapFolder: Instance): (number, boolean)
	return healTileSet(mapFolder, groundTileSpecs(), { Color = COL_GROUND, Material = Enum.Material.Sand, Transparency = 0 })
end

-- number of ground tiles that exist, collide and have full tile size (Bootstrap health check)
local function countHealthyGroundTiles(mapFolder: Instance): number
	local n = 0
	for _, t in ipairs(groundTileSpecs()) do
		local p = mapFolder:FindFirstChild(t.Name)
		if p and p:IsA("BasePart") and p.CanCollide and p.Size.X >= t.Size.X - 1 and p.Size.Z >= t.Size.Z - 1 then
			n += 1
		end
	end
	return n
end

-- SafetyCatch: 5 x 5 tiles of 2000 (the centre one keeps the name SafetyCatch)
local function buildSafetyUnderfloor(mapFolder: Instance): (number, boolean)
	local specs: { TileSpec } = {}
	local tile = SAFETY_FLOOR_SIZE / SAFETY_TILES_PER_SIDE
	for i, x in ipairs(tileCentres(SAFETY_TILES_PER_SIDE, tile)) do
		for j, z in ipairs(tileCentres(SAFETY_TILES_PER_SIDE, tile)) do
			local name = if x == 0 and z == 0 then "SafetyCatch" else ("SafetyCatch_" .. i .. "_" .. j)
			table.insert(specs, { Name = name, At = Vector3.new(x, SAFETY_FLOOR_Y, z), Size = Vector3.new(tile, 4, tile) })
		end
	end
	return healTileSet(mapFolder, specs, { Color = Color3.fromRGB(18, 22, 18), Material = Enum.Material.Slate, Transparency = 0.92 })
end

-- one ring side = EDGE_PIECES pieces: <prefix><N|S|E|W> (first piece keeps the legacy name), then _2 .. _4
local function edgeRingSpecs(prefix: string, inset: number, length: number, height: number, thick: number, y: number): { TileSpec }
	local out: { TileSpec } = {}
	local half = GROUND_SIZE * 0.5 - inset
	local piece = length / EDGE_PIECES
	for _, side in ipairs({ "N", "S", "E", "W" }) do
		local alongX = side == "N" or side == "S"
		local sgn = if side == "N" or side == "W" then -1 else 1
		for k, c in ipairs(tileCentres(EDGE_PIECES, piece)) do
			table.insert(out, {
				Name = prefix .. side .. (if k == 1 then "" else ("_" .. k)),
				At = if alongX then Vector3.new(c, y, sgn * half) else Vector3.new(sgn * half, y, c),
				Size = if alongX then Vector3.new(piece, height, thick) else Vector3.new(thick, height, piece),
			})
		end
	end
	return out
end

local function buildEdgeBerms(mapFolder: Instance): (number, boolean)
	-- Soft inner berm just inside Ground edge (keeps stroll-off from feeling like cliff)
	local bermH = 18
	local specs = edgeRingSpecs("EdgeBerm", 40, GROUND_SIZE - 80, bermH, 28, GROUND_TOP_Y + bermH * 0.5)
	return healTileSet(mapFolder, specs, { Color = Color3.fromRGB(185, 155, 105), Material = Enum.Material.Sand, Transparency = 0 })
end


local function buildInvisibleWalls(mapFolder: Instance): (number, boolean)
	-- Tall invisible perimeter so players cannot walk off Ground into void/water
	local wallH = 80
	local specs = edgeRingSpecs("VoidWall", 8, GROUND_SIZE, wallH, 12, GROUND_TOP_Y + wallH * 0.5)
	return healTileSet(mapFolder, specs, { Color = Color3.fromRGB(40, 50, 40), Material = Enum.Material.SmoothPlastic, Transparency = 1 })
end

local function buildMountainRing(root: Folder)
	--[[
		Desert mesa / butte rim — terracotta / sienna / reddish-brown layered Part kits.
		Flat-topped sedimentary striations; varied heights; foothills + collide berm.
		Keeps continuous floor / CanCollide perimeter from void-fall fix (4021025).
	]]
	local folder = Instance.new("Folder")
	folder.Name = "MountainRing"
	folder.Parent = root

	local mesaColors = {
		Color3.fromRGB(168, 95, 58), -- terracotta
		Color3.fromRGB(145, 78, 48), -- burnt sienna
		Color3.fromRGB(185, 110, 70), -- warm sandstone
		Color3.fromRGB(130, 72, 48), -- deep clay
		Color3.fromRGB(175, 105, 65), -- mesa orange
		Color3.fromRGB(155, 88, 55), -- red rock
	}
	local strataLight = Color3.fromRGB(200, 145, 100)
	local strataDark = Color3.fromRGB(110, 62, 40)
	local sandFoothill = Color3.fromRGB(195, 160, 110)

	local half = GROUND_SIZE * 0.5
	local ringR = half + 90
	-- PERF: 12–16 segments (was 24). Studio laptops struggle with mesa*strata*cap parts.
	local configured = tonumber(DevConfig.MountainRingSegments) or 14
	local segCount = math.clamp(math.floor(configured), 12, 24)
	local segArc = (math.pi * 2) / segCount
	local segLen = ringR * segArc * 1.12

	for i = 1, segCount do
		local angle = (i - 0.5) * segArc
		local cx = math.cos(angle) * ringR
		local cz = math.sin(angle) * ringR
		local hSeed = ((i * 17 + 31) % 80) + 40
		local height = hSeed
		if i % 7 == 0 then
			height = math.min(125, height + 32)
		elseif i % 5 == 0 then
			height = math.max(42, height - 16)
		end
		-- Flat-topped mesa: slightly shorter + wider top silhouette
		local depth = 58 + (i % 5) * 9
		local yaw = -angle + math.pi * 0.5
		local col = mesaColors[((i - 1) % #mesaColors) + 1]
		local mat = Enum.Material.Sandstone
		if i % 3 == 0 then
			mat = Enum.Material.Rock
			col = col:Lerp(strataDark, 0.25)
		elseif i % 4 == 0 then
			mat = Enum.Material.Slate
			col = col:Lerp(Color3.fromRGB(140, 95, 70), 0.3)
		end
		local ridge = part({
			Name = "Mesa_" .. i,
			Size = Vector3.new(segLen, height, depth),
			CFrame = CFrame.new(cx, GROUND_TOP_Y + height * 0.5 - 2, cz) * CFrame.Angles(0, yaw, 0),
			Color = col,
			Material = mat,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		})
		ridge:SetAttribute("WE_Mountain", true)
		-- Sedimentary striation bands (visual only) — every 3rd segment (perf)
		if i % 3 == 0 then
			local bandH = math.clamp(height * 0.12, 4, 10)
			part({
				Name = "Strata_" .. i,
				Size = Vector3.new(segLen * 1.02, bandH, depth * 0.98),
				CFrame = CFrame.new(cx, GROUND_TOP_Y + height * 0.38, cz) * CFrame.Angles(0, yaw, 0),
				Color = if i % 4 == 0 then strataLight else strataDark,
				Material = Enum.Material.Sandstone,
				CanCollide = false,
				Anchored = true,
				Transparency = 0.08,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
		-- Flat mesa cap (butte top) — every 3rd segment (perf)
		if i % 3 == 0 then
			local tipH = 6 + (i % 5) * 2
			part({
				Name = "MesaCap_" .. i,
				Size = Vector3.new(segLen * 0.72, tipH, depth * 0.7),
				CFrame = CFrame.new(cx, GROUND_TOP_Y + height + tipH * 0.25 - 2, cz) * CFrame.Angles(0, yaw, 0),
				Color = col:Lerp(strataLight, 0.35),
				Material = Enum.Material.Sandstone,
				CanCollide = false,
				Anchored = true,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
		-- Inner foothill shelf (sand) — collide continuity from berm (sparser)
		if i % 4 == 0 then
			local footH = 12 + (i % 4) * 3
			local footR = half + 35
			local fx = math.cos(angle) * footR
			local fz = math.sin(angle) * footR
			part({
				Name = "Foothill_" .. i,
				Size = Vector3.new(segLen * 0.9, footH, 38),
				CFrame = CFrame.new(fx, GROUND_TOP_Y + footH * 0.5 - 1, fz) * CFrame.Angles(0, yaw, 0),
				Color = sandFoothill,
				Material = Enum.Material.Sand,
				CanCollide = true,
				Anchored = true,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
	end

	-- Mid-ground rocky outcrops just inside the ring (sandy floor props)
	for oi = 1, 4 do
		local ang = (oi / 12) * math.pi * 2 + 0.2
		local orad = half - 220 - (oi % 4) * 40
		local ox = math.cos(ang) * orad
		local oz = math.sin(ang) * orad
		local oh = 10 + (oi % 5) * 4
		part({
			Name = "Outcrop_" .. oi,
			Size = Vector3.new(28 + (oi % 3) * 8, oh, 22 + (oi % 2) * 6),
			Position = Vector3.new(ox, GROUND_TOP_Y + oh * 0.5 - 1, oz),
			Color = mesaColors[((oi - 1) % #mesaColors) + 1],
			Material = Enum.Material.Sandstone,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		}):SetAttribute("WE_Mountain", true)
	end

	-- Corner massifs (extra bulk — flat-topped buttes)
	-- Cardinal buttes only (was 8 incl. diagonals) — Studio collide/GPU win
	local massifs = {
		{ 0, -1, "N" },
		{ 0, 1, "S" },
		{ 1, 0, "E" },
		{ -1, 0, "W" },
	}
	for mi, m in ipairs(massifs) do
		local mx = m[1] * (half + 120)
		local mz = m[2] * (half + 120)
		local mh = 75 + (mi % 4) * 14
		part({
			Name = "Butte_" .. m[3],
			Size = Vector3.new(150, mh, 150),
			Position = Vector3.new(mx, GROUND_TOP_Y + mh * 0.5 - 4, mz),
			Color = mesaColors[((mi - 1) % #mesaColors) + 1],
			Material = Enum.Material.Sandstone,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		}):SetAttribute("WE_Mountain", true)
		-- Flat caps omitted for perf (mesa segments already have caps)
	end

	print("[WAR EMPIRE] MapSetup: MountainRing mesas=" .. tostring(segCount) .. " + buttes/outcrops (desert terracotta)")
end

local function buildVisualFillPatches(mapFolder: Folder)
	-- Low-cost ground patches between plot ring and mid-map so dead space doesn't look empty
	local patches = {
		Vector3.new(400, GROUND_TOP_Y + 0.08, 200),
		Vector3.new(-350, GROUND_TOP_Y + 0.08, -250),
		Vector3.new(600, GROUND_TOP_Y + 0.08, -100),
		Vector3.new(-400, GROUND_TOP_Y + 0.08, -550),
	}
	for i, pos in ipairs(patches) do
		local w = 80 + (i % 4) * 25
		local d = 55 + (i % 3) * 20
		part({
			Name = "FillPatch_" .. i,
			Size = Vector3.new(w, 0.2, d),
			Position = pos,
			Color = if i % 2 == 0 then Color3.fromRGB(220, 195, 140) else Color3.fromRGB(195, 165, 115),
			Material = if i % 2 == 0 then Enum.Material.Sand else Enum.Material.Sandstone,
			CanCollide = false,
			Anchored = true,
			Transparency = 0.05,
			Parent = mapFolder,
		})
	end
end

local function buildOilDeckRamp(parent: Folder, territoryId: string, deckPos: Vector3, towardCenter: Vector3)
	--[[
		Stepped collide stairs from elevated oil deck (~Y=28) down to ground.
		towardCenter = horizontal direction from deck toward map center (inland).
		v70: the stairs now really run toward towardCenter (they subtracted dir, so they ran out to sea); on the
		waterways map they are the rig's pier across the lagoon to the inner bank (spec_final §7.1).
	]]
	local dir = Vector3.new(towardCenter.X, 0, towardCenter.Z)
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(if deckPos.X >= 0 then -1 else 1, 0, 0)
	end
	dir = dir.Unit
	local deckTopY = deckPos.Y
	local steps = 10
	local rise = (deckTopY - GROUND_TOP_Y) / steps
	local run = 9
	local stepW = 22
	local stepT = 7.5
	-- Start just outside the 48-stud deck toward inland
	local edge = Vector3.new(deckPos.X, 0, deckPos.Z) + dir * 26
	for s = 1, steps do
		local y = deckTopY - rise * s + 0.6
		local horiz = edge + dir * (run * s)
		local stepAt = Vector3.new(horiz.X, y, horiz.Z)
		part({
			Name = territoryId .. "_RampStep" .. s,
			Size = Vector3.new(stepW, 1.3, stepT),
			CFrame = CFrame.lookAt(stepAt, stepAt + dir),
			Color = Color3.fromRGB(75, 78, 82),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Anchored = true,
			Parent = parent,
		})
	end
	local midHoriz = edge + dir * (run * 5)
	part({
		Name = territoryId .. "_RampShelf",
		Size = Vector3.new(28, 1.4, 14),
		Position = Vector3.new(midHoriz.X, deckTopY - rise * 5, midHoriz.Z),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Metal,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
	local approach = edge + dir * (run * steps + 10)
	part({
		Name = territoryId .. "_RampApproach",
		Size = Vector3.new(30, 1, 18),
		Position = Vector3.new(approach.X, GROUND_TOP_Y + 0.45, approach.Z),
		Color = Color3.fromRGB(55, 60, 55),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
end


local MapSetup = {}

-- Exported for Bootstrap ground heal / verify
MapSetup.GROUND_SIZE = GROUND_SIZE
MapSetup.GROUND_THICKNESS = GROUND_THICKNESS
MapSetup.GROUND_TOP_Y = GROUND_TOP_Y
MapSetup.SAFETY_FLOOR_SIZE = SAFETY_FLOOR_SIZE
MapSetup.SAFETY_FLOOR_Y = SAFETY_FLOOR_Y
-- v70: the ground is tiled (§12.1); Bootstrap checks the tiles, not one 7200 part
MapSetup.GROUND_TILE_SIZE = GROUND_SIZE / GROUND_TILES_PER_SIDE
MapSetup.GROUND_TILES = GROUND_TILES_PER_SIDE * GROUND_TILES_PER_SIDE
-- v70: stamped on WarEmpireSetup (WE_MapGen). Bootstrap rebuilds a saved / baked map whose stamp differs, so a place
-- saved with an older layout (unturned plots, one WaterPlane) never keeps it. The stamp also encodes
-- BaseLayoutConfig.FaceMapCentre (70 = off, 71 = on), so flipping the flag rebuilds a map baked with the other value.
MapSetup.MAP_GEN = if BaseLayout.FacesMapCentre() then 71 else 70

-- v70: healthy ground tiles under setup.Map (Bootstrap "Ground AFTER heal" check)
function MapSetup.CountGroundTiles(setup: Instance): number
	local map = setup:FindFirstChild("Map")
	if not map then
		return 0
	end
	return countHealthyGroundTiles(map)
end

local function buildPadSupportShelves(setup: Folder)
	--[[
		Collide shelves under elevated upgrade pads / decks so players never
		treat CanCollide=false kit deco as floor. Fills air gap pad→Ground.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return
	end
	local folder = map:FindFirstChild("PadSupports")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "PadSupports"
	folder.Parent = map

	local CollectionService = game:GetService("CollectionService")
	local TAG = TAG_SLOT
	local count = 0
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		-- v68: consoles stand on the plot floor; their height is not an air gap to fill
		if inst:IsA("BasePart") and inst:IsDescendantOf(setup) and inst:GetAttribute("WE_Console") ~= true then
			local topY = inst.Position.Y + inst.Size.Y * 0.5
			local gap = topY - GROUND_TOP_Y
			if gap > 2.5 then
				local shelfH = math.clamp(gap - 0.5, 1, 40)
				local shelfY = GROUND_TOP_Y + shelfH * 0.5
				part({
					Name = "PadShelf_" .. tostring(count),
					Size = Vector3.new(math.max(inst.Size.X + 4, 12), shelfH, math.max(inst.Size.Z + 4, 12)),
					Position = Vector3.new(inst.Position.X, shelfY, inst.Position.Z),
					Color = Color3.fromRGB(90, 85, 70),
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Anchored = true,
					Parent = folder,
				})
				count += 1
			end
		end
	end
	-- Also sweep StructureId parts under Bases (tag may lag)
	local bases = setup:FindFirstChild("Bases")
	if bases then
		for _, desc in ipairs(bases:GetDescendants()) do
			if desc:IsA("BasePart") then
				local sid = desc:GetAttribute("StructureId")
				if typeof(sid) == "string" and desc:GetAttribute("WE_Console") ~= true then
					local topY = desc.Position.Y + desc.Size.Y * 0.5
					local gap = topY - GROUND_TOP_Y
					if gap > 2.5 then
						-- Skip if already covered by a nearby shelf
						local covered = false
						for _, child in ipairs(folder:GetChildren()) do
							if child:IsA("BasePart") then
								local dx = child.Position.X - desc.Position.X
								local dz = child.Position.Z - desc.Position.Z
								if dx * dx + dz * dz < 25 then
									covered = true
									break
								end
							end
						end
						if not covered then
							local shelfH = math.clamp(gap - 0.5, 1, 40)
							local shelfY = GROUND_TOP_Y + shelfH * 0.5
							part({
								Name = "PadShelf_" .. tostring(count),
								Size = Vector3.new(math.max(desc.Size.X + 4, 12), shelfH, math.max(desc.Size.Z + 4, 12)),
								Position = Vector3.new(desc.Position.X, shelfY, desc.Position.Z),
								Color = Color3.fromRGB(90, 85, 70),
								Material = Enum.Material.Concrete,
								CanCollide = true,
								Anchored = true,
								Parent = folder,
							})
							count += 1
						end
					end
				end
			end
		end
	end
	if count > 0 then
		print("[WAR EMPIRE] MapSetup: PadSupports shelves=" .. tostring(count) .. " (collide fillers under elevated pads)")
	end
end

function MapSetup.EnsureGroundHealthy(setup: Instance): boolean
	--[[
		Soft-heal existing WarEmpireSetup Ground / SafetyCatch.
		Returns true if healthy (or repaired in place), false if caller should rebuild.
		v70: re-asserts all 16 ground tiles, the 25 safety-catch tiles and every berm / void-wall piece (a legacy
		single 7200 Ground is resized to its tile and the missing tiles are built).
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	local ground = map:FindFirstChild("Ground")
	if not (ground and ground:IsA("BasePart")) then
		return false
	end
	-- Always force full-size collide Ground every Play (bulletproof void floor)
	local tiles, repaired = buildGroundTiles(map)
	local _, catchRepaired = buildSafetyUnderfloor(map)
	repaired = repaired or catchRepaired

	if not setup:FindFirstChild("MountainRing") then
		buildMountainRing(setup :: Folder)
		repaired = true
	end
	local _, bermRepaired = buildEdgeBerms(map)
	local _, wallRepaired = buildInvisibleWalls(map)
	repaired = repaired or bermRepaired or wallRepaired

	buildPadSupportShelves(setup :: Folder)

	print(string.format(
		"[WAR EMPIRE] Ground heal: ok size=%.0fx%.0fx%.0f tiles=%d/%d CanCollide=%s repaired=%s",
		ground.Size.X,
		ground.Size.Y,
		ground.Size.Z,
		countHealthyGroundTiles(map),
		tiles,
		tostring(ground.CanCollide),
		tostring(repaired)
	))
	return true
end




function MapSetup.ForceRebuildGround(setup: Instance): boolean
	--[[
		Hard rebuild: destroy Map.Ground + SafetyCatch and recreate them.
		Use every Play when soft-heal is not enough (stale holes / void gaps).
		Does NOT rebuild the whole WarEmpireSetup — only the collide floor layers.
		v70: every ground / safety-catch tile and every berm / void-wall piece.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	destroyNamed(map, "Ground")
	destroyNamed(map, "GroundTile")
	destroyNamed(map, "SafetyCatch")

	local tiles = buildGroundTiles(map)
	buildSafetyUnderfloor(map)
	-- Refresh berms + invisible void walls every force rebuild
	for _, name in ipairs({ "EdgeBermN", "EdgeBermS", "EdgeBermE", "EdgeBermW", "VoidWallN", "VoidWallS", "VoidWallE", "VoidWallW" }) do
		destroyNamed(map, name)
	end
	buildEdgeBerms(map)
	buildInvisibleWalls(map)
	if not setup:FindFirstChild("MountainRing") then
		buildMountainRing(setup :: Folder)
	end
	buildPadSupportShelves(setup :: Folder)

	local healthy = countHealthyGroundTiles(map)
	local ground = map:FindFirstChild("Ground")
	local g = if ground and ground:IsA("BasePart") then ground else nil
	print(string.format(
		"[WAR EMPIRE] Ground FORCE-REBUILT: size=%.0fx%.0fx%.0f tiles=%d/%d CanCollide=%s Anchored=%s",
		if g then g.Size.X else 0,
		if g then g.Size.Y else 0,
		if g then g.Size.Z else 0,
		healthy,
		tiles,
		tostring(g ~= nil and g.CanCollide),
		tostring(g ~= nil and g.Anchored)
	))
	return healthy == tiles and g ~= nil and g.Size.Y >= GROUND_THICKNESS - 0.5
end



-- v68: layout ground work (BaseLayoutConfig): roads + plaza + runway markings, parade flagpole, dock basin,
-- and the inner wall with one guarded gate per rear-zone structure. Gate leaves are opened/closed by
-- StructureKitBuilder.SyncRearGates when the matching structure (Airfield / Helipad / Dock) is bought.
local REAR_GATE_LABELS = { Airfield = "AIRFIELD", Helipad = "HELIPAD", Dock = "NAVAL DOCK" }

-- v70 [J3/J4]: shared look + flags for every WE_Water part MapSetup builds (DockWater, SeaGateWater). Water parts never
-- collide, touch or take raycasts (the vehicles' water query is geometric over the tagged parts; combat rays reach the
-- real floor) and cast no shadow.
local function styleWaterPart(w: BasePart, waterId: string)
	w.Reflectance = WaterConfig.Look.Reflectance
	w.CanCollide = false
	w.CanTouch = false
	w.CanQuery = false
	w.CastShadow = false
	w:SetAttribute("WE_WaterId", waterId)
	CollectionService:AddTag(w, TAG_WATER)
end

local function buildLayoutGround(plotFolder: Folder, plotId: number, pos: Vector3)
	if not BaseLayout.Enabled() then
		return
	end
	local cfg = BaseLayout.Config()
	local look = (StructureVisualConfig :: any).BaseLook or {}
	-- v70: everything below is plot-local (BaseLayoutConfig frame) and placed through the plot frame F, so the whole
	-- layout turns with the plot when BaseLayoutConfig.FaceMapCentre is on (F = CFrame.new(pos) while it is off).
	local F = BaseLayout.PlotCFrame(pos)
	local padTop = 0.5 -- plot-local: the pad is 1 stud thick, centred on pos
	local function at(x: number, y: number, z: number): CFrame
		return F * CFrame.new(x, y, z)
	end
	local H = cfg.PlotSize * 0.5
	local folder = Instance.new("Folder")
	folder.Name = "LayoutGround"
	folder.Parent = plotFolder
	local asphalt = Color3.fromRGB(64, 66, 64)
	local paint = Color3.fromRGB(236, 232, 214)
	local yellow = look.Chevron or Color3.fromRGB(230, 196, 70)
	local steel = Color3.fromRGB(70, 74, 72)
	-- v70: the sea gate (and the channel behind it) exists only when the plots face the map centre
	local seaGate = BaseLayout.FacesMapCentre() and WaterConfig.Enabled == true
	local SG = WaterConfig.SeaGate
	local waterMidY = (WaterConfig.BottomY + WaterConfig.SurfaceY) * 0.5
	local waterH = WaterConfig.SurfaceY - WaterConfig.BottomY

	-- Roads, plaza, runway, taxiway, apron
	for _, r in ipairs(cfg.Roads) do
		local road = part({
			Name = "Road_" .. r.Name,
			Size = Vector3.new(r.SizeX, 0.12, r.SizeZ),
			CFrame = at(r.X, padTop + 0.06, r.Z),
			Color = asphalt,
			Material = Enum.Material.Asphalt,
			CanCollide = true,
			Parent = folder,
		})
		road:SetAttribute("WE_Decor", true)
		local alongX = r.SizeX >= r.SizeZ
		local len = if alongX then r.SizeX else r.SizeZ
		local markY = padTop + 0.13
		if r.Name == "Runway" then
			-- dashed white centreline + threshold bars at both ends
			local n = math.floor(len / 14)
			for i = 0, n - 1 do
				local t = -len * 0.5 + 7 + i * 14
				part({
					Name = "RunwayDash",
					Size = if alongX then Vector3.new(7, 0.02, 0.9) else Vector3.new(0.9, 0.02, 7),
					CFrame = at(r.X + (if alongX then t else 0), markY, r.Z + (if alongX then 0 else t)),
					Color = paint,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Parent = folder,
				})
			end
			for _, endSign in ipairs({ -1, 1 }) do
				for b = -3, 3 do
					local along = endSign * (len * 0.5 - 4)
					local across = b * 2.6
					part({
						Name = "RunwayThreshold",
						Size = if alongX then Vector3.new(6, 0.02, 1.2) else Vector3.new(1.2, 0.02, 6),
						CFrame = at(r.X + (if alongX then along else across), markY, r.Z + (if alongX then across else along)),
						Color = paint,
						Material = Enum.Material.SmoothPlastic,
						CanCollide = false,
						Parent = folder,
					})
				end
			end
		elseif r.Name == "Taxiway" or r.Name == "HeliApron" then
			part({
				Name = "TaxiLine",
				Size = if alongX then Vector3.new(len - 2, 0.02, 0.5) else Vector3.new(0.5, 0.02, len - 2),
				CFrame = at(r.X, markY, r.Z),
				Color = yellow,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		else
			-- white edge lines on the compound roads
			for _, side in ipairs({ -1, 1 }) do
				local off = side * ((if alongX then r.SizeZ else r.SizeX) * 0.5 - 0.6)
				part({
					Name = "RoadEdge",
					Size = if alongX then Vector3.new(len - 1, 0.02, 0.35) else Vector3.new(0.35, 0.02, len - 1),
					CFrame = at(r.X + (if alongX then 0 else off), markY, r.Z + (if alongX then off else 0)),
					Color = paint,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Parent = folder,
				})
			end
		end
	end

	-- Parade-ground flagpole
	do
		local f = cfg.Courtyard.Flagpole
		part({ Name = "FlagBase", Size = Vector3.new(4, 1, 4), CFrame = at(f.X, padTop + 0.5, f.Z), Color = Color3.fromRGB(150, 146, 134), Material = Enum.Material.Concrete, CanCollide = true, Parent = folder })
		part({ Name = "FlagPole", Size = Vector3.new(0.5, 28, 0.5), CFrame = at(f.X, padTop + 15, f.Z), Color = steel, Material = Enum.Material.Metal, CanCollide = true, Parent = folder })
		part({ Name = "ParadeFlag", Size = Vector3.new(0.14, 4.4, 7.5), CFrame = at(f.X, padTop + 25.8, f.Z - 3.9), Color = Color3.fromRGB(70, 110, 60), Material = Enum.Material.Fabric, CanCollide = false, Parent = folder })
	end

	-- Dock basin: water surface + concrete kerb
	do
		local d = cfg.Courtyard.DockBasin
		-- v70 [J3/J4]: one water level for the whole map (WaterConfig.BottomY..SurfaceY = 0.3..1.5). The part is TURNED
		-- WITH THE PLOT (exact quarter turn, unchanged world AABB), so the vehicles' basin spawn heading (the part's yaw)
		-- points the bow at the sea gate. DockWater is the only plot water part with WE_PlotId.
		local water = part({
			Name = "DockWater",
			Size = Vector3.new(d.SizeX, waterH, d.SizeZ),
			CFrame = BaseLayout.PlotLocalCFrame(pos, d.X, waterMidY - pos.Y, d.Z),
			Color = WaterConfig.Look.Color,
			Material = WaterConfig.Look.Material,
			Transparency = WaterConfig.Look.Transparency,
			CanCollide = false,
			Parent = folder,
		})
		styleWaterPart(water, "DockWater")
		water:SetAttribute("WE_PlotId", plotId)
		-- kerbs: plot-local boxes { size, centre }
		local kx0, kx1 = d.X - d.SizeX * 0.5 - 1.2, d.X + d.SizeX * 0.5 + 1.2 -- 101.8 .. 154.2
		local rearZ = d.Z - d.SizeZ * 0.5 - 0.6
		local kerbs: { { Vector3 } } = {
			{ Vector3.new(d.SizeX + 2.4, 1, 1.2), Vector3.new(d.X, padTop + 0.5, d.Z + d.SizeZ * 0.5 + 0.6) },
		}
		if seaGate then
			-- v70 §4: the rear kerb opens onto the gate water (stubs either side) and two short kerbs line the gate water
			-- from the basin to the gate posts
			local sideZ0, sideZ1 = SG.WallZ + SG.PostDepth * 0.5, SG.BasinRearZ -- -156.8 .. -147
			table.insert(kerbs, { Vector3.new(SG.X0 - kx0, 1, 1.2), Vector3.new((kx0 + SG.X0) * 0.5, padTop + 0.5, rearZ) })
			table.insert(kerbs, { Vector3.new(kx1 - SG.X1, 1, 1.2), Vector3.new((SG.X1 + kx1) * 0.5, padTop + 0.5, rearZ) })
			table.insert(kerbs, { Vector3.new(1.2, 1, sideZ1 - sideZ0), Vector3.new(SG.X0 - 0.6, padTop + 0.5, (sideZ0 + sideZ1) * 0.5) })
			table.insert(kerbs, { Vector3.new(1.2, 1, sideZ1 - sideZ0), Vector3.new(SG.X1 + 0.6, padTop + 0.5, (sideZ0 + sideZ1) * 0.5) })
		else
			table.insert(kerbs, { Vector3.new(d.SizeX + 2.4, 1, 1.2), Vector3.new(d.X, padTop + 0.5, rearZ) })
		end
		table.insert(kerbs, { Vector3.new(1.2, 1, d.SizeZ), Vector3.new(d.X + d.SizeX * 0.5 + 0.6, padTop + 0.5, d.Z) })
		table.insert(kerbs, { Vector3.new(1.2, 1, d.SizeZ), Vector3.new(d.X - d.SizeX * 0.5 - 0.6, padTop + 0.5, d.Z) })
		for _, e in ipairs(kerbs) do
			part({ Name = "DockKerb", Size = e[1], CFrame = F * CFrame.new(e[2]), Color = Color3.fromRGB(150, 146, 134), Material = Enum.Material.Concrete, CanCollide = true, Parent = folder })
		end
	end

	-- Inner wall with guarded gates
	local iw = cfg.InnerWall
	local zc = iw.Z
	local wallCol = (StructureVisualConfig.Palettes.DefensiveWalls and StructureVisualConfig.Palettes.DefensiveWalls.Body) or Color3.fromRGB(178, 170, 148)
	local half = iw.GateWidth * 0.5
	local function wallSeg(a: number, b: number)
		if b - a < 0.5 then
			return
		end
		part({
			Name = "InnerWall",
			Size = Vector3.new(b - a, iw.Height, iw.Thickness),
			CFrame = at((a + b) * 0.5, padTop + iw.Height * 0.5, zc),
			Color = wallCol,
			Material = Enum.Material.Concrete,
			CanCollide = true,
			CastShadow = true,
			Parent = folder,
		})
		part({
			Name = "InnerWallCap",
			Size = Vector3.new(b - a + 0.3, 0.5, iw.Thickness + 0.3),
			CFrame = at((a + b) * 0.5, padTop + iw.Height + 0.25, zc),
			Color = look.WallCap or Color3.fromRGB(132, 126, 110),
			Material = Enum.Material.Concrete,
			CanCollide = false,
			Parent = folder,
		})
	end
	local gates = {}
	for id, g in pairs(iw.Gates) do
		table.insert(gates, { Id = id, X = g.X })
	end
	table.sort(gates, function(a, b)
		return a.X < b.X
	end)
	local cursor = -H
	for _, g in ipairs(gates) do
		wallSeg(cursor, g.X - half)
		cursor = g.X + half

		local gateFolder = Instance.new("Folder")
		gateFolder.Name = "RearGate_" .. g.Id
		gateFolder:SetAttribute("GateId", g.Id)
		gateFolder:SetAttribute("PlotId", plotId)
		gateFolder.Parent = folder
		local gx = g.X
		for _, sx in ipairs({ -1, 1 }) do
			-- v70: "RearGatePost" (was "GatePost"): GateDefenseService's no-perimeter fallback collects every descendant
			-- named GatePost under the plot and must only ever see the perimeter main-gate posts
			part({
				Name = "RearGatePost",
				Size = Vector3.new(1.6, iw.Height + 1.5, iw.Thickness + 1),
				CFrame = at(gx + sx * (half + 0.8), padTop + (iw.Height + 1.5) * 0.5, zc),
				Color = steel,
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = gateFolder,
			})
		end
		local lintel = part({
			Name = "GateLintel",
			Size = Vector3.new(iw.GateWidth + 3.2, 2.2, iw.Thickness + 0.6),
			CFrame = at(gx, padTop + iw.Height + 0.6, zc),
			Color = Color3.fromRGB(40, 44, 42),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Parent = gateFolder,
		})
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_GateSign"
		sg.Face = Enum.NormalId.Back -- plot-local +Z: faces the main compound
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.MaxDistance = 80 -- v70: painted sign, near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = lintel
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Text"
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundColor3 = Color3.fromRGB(20, 22, 20)
		lbl.BorderSizePixel = 0
		lbl.Font = Enum.Font.GothamBlack
		lbl.TextScaled = true
		lbl.TextColor3 = yellow
		lbl.Text = (REAR_GATE_LABELS[g.Id] or string.upper(g.Id)) .. " · LOCKED"
		lbl.Parent = sg
		local leafH = iw.Height - 2
		for i, sx in ipairs({ -1, 1 }) do
			local leaf = part({
				Name = "GateLeaf" .. i,
				Size = Vector3.new(half - 0.1, leafH, 0.8),
				CFrame = at(gx + sx * half * 0.5, padTop + leafH * 0.5, zc),
				Color = Color3.fromRGB(78, 84, 80),
				Material = Enum.Material.DiamondPlate,
				CanCollide = true,
				Parent = gateFolder,
			})
			leaf:SetAttribute("WE_GateLeaf", sx)
			leaf:SetAttribute("WE_ClosedCFrame", leaf.CFrame)
			part({
				Name = "GateStripe",
				Size = Vector3.new(half - 0.1, 0.8, 0.9),
				CFrame = leaf.CFrame * CFrame.new(0, -leafH * 0.5 + 2.2, 0),
				Color = yellow,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = leaf,
			})
		end
		-- Two guards with sandbags on the compound side
		for _, sx in ipairs({ -1, 1 }) do
			local gLocal = Vector3.new(gx + sx * (half + 3.6), padTop + 2.1, zc + iw.Thickness * 0.5 + 2.4)
			part({
				Name = "GuardSandbag",
				Size = Vector3.new(4.2, 1.3, 1.3),
				CFrame = at(gLocal.X, padTop + 0.65, gLocal.Z + 2.2),
				Color = Color3.fromRGB(186, 164, 118),
				Material = Enum.Material.Fabric,
				CanCollide = true,
				Parent = gateFolder,
			})
			-- v70 (HUD spec §5): no "GUARD" NPCLabel over the rear-gate guards
			makeSoldierKit(
				gateFolder,
				"GateGuard_" .. g.Id .. (if sx > 0 then "R" else "L"),
				F * CFrame.new(gLocal) * CFrame.Angles(0, math.rad(180), 0),
				Color3.fromRGB(62, 72, 52),
				nil,
				Color3.fromRGB(140, 150, 130),
				150,
				"Guard",
				nil
			)
		end
	end
	wallSeg(cursor, H)

	-- v70 [J1] sea gate (spec_final §4): on the rear perimeter line behind the dock basin, plot-local x SG.X0..SG.X1.
	-- Two collidable leaves (12 tall together) close it; StructureKitBuilder.SyncRearGates only ARMS it (Dock L1+) and
	-- Waterways' loop slides the leaves west into the wall line while a boat driven by the owner / a clan-mate is near.
	-- A WE_WallGap marker makes SyncPerimeterWalls leave the wall open across the gate.
	if seaGate then
		local gx = (SG.X0 + SG.X1) * 0.5
		local span = SG.X1 - SG.X0
		local gate = Instance.new("Folder")
		gate.Name = "SeaGate_Dock"
		gate:SetAttribute("GateId", "Dock")
		gate:SetAttribute("PlotId", plotId)
		gate:SetAttribute("WE_GateMode", "Proximity")
		gate:SetAttribute("WE_GateLabel", SG.Label)
		gate:SetAttribute("WE_GateArmed", false)
		gate:SetAttribute("WE_GateOpen", false)
		gate:SetAttribute("WE_GateCentre", F:PointToWorldSpace(Vector3.new(gx, 3, SG.WallZ)))
		gate.Parent = folder

		-- gate water: basin rear edge → pad edge, turned with the plot like DockWater. [J3] WE_GatePlotId, NOT WE_PlotId
		-- (the vehicles' plotBasin takes the first WE_Water part with WE_PlotId).
		local gateWater = part({
			Name = "SeaGateWater",
			Size = Vector3.new(span, waterH, SG.BasinRearZ - SG.PadEdgeZ),
			CFrame = BaseLayout.PlotLocalCFrame(pos, gx, waterMidY - pos.Y, (SG.PadEdgeZ + SG.BasinRearZ) * 0.5),
			Color = WaterConfig.Look.Color,
			Material = WaterConfig.Look.Material,
			Transparency = WaterConfig.Look.Transparency,
			CanCollide = false,
			Parent = gate,
		})
		styleWaterPart(gateWater, "SeaGateWater")
		gateWater:SetAttribute("WE_GatePlotId", plotId)

		for _, sx in ipairs({ -1, 1 }) do
			-- named differently from "GatePost" on purpose (GateDefenseService reads that name)
			part({
				Name = "SeaGatePost",
				Size = Vector3.new(SG.PostWidth, SG.PostHeight, SG.PostDepth),
				CFrame = at(gx + sx * (span + SG.PostWidth) * 0.5, padTop + SG.PostHeight * 0.5, SG.WallZ),
				Color = steel,
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = gate,
			})
		end
		-- lintel: never collides or takes raycasts (a boat's land probe must never see it)
		local lintel = part({
			Name = "GateLintel",
			Size = Vector3.new(span + SG.PostWidth * 2, 2.2, SG.PostDepth + 0.4),
			CFrame = at(gx, padTop + SG.LintelBottom + 1.1, SG.WallZ),
			Color = Color3.fromRGB(40, 44, 42),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = gate,
		})
		lintel.CanTouch = false
		lintel.CanQuery = false
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_GateSign"
		sg.Face = Enum.NormalId.Back -- plot-local +Z: faces the basin
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.MaxDistance = 80 -- v70: painted sign, near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = lintel
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Text"
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundColor3 = Color3.fromRGB(20, 22, 20)
		lbl.BorderSizePixel = 0
		lbl.Font = Enum.Font.GothamBlack
		lbl.TextScaled = true
		lbl.TextColor3 = yellow
		lbl.Text = SG.Label .. " · LOCKED"
		lbl.Parent = sg

		-- leaves: WE_GateLeaf = LeafSlide (-1 = slide plot-local west into the wall line), WE_ClosedCFrame after placing
		for i, lf in ipairs(SG.Leaves) do
			local leaf = part({
				Name = lf.Name,
				Size = Vector3.new(span, lf.Height, lf.Thickness),
				CFrame = at(gx, padTop + lf.Bottom + lf.Height * 0.5, SG.WallZ),
				Color = if i == 1 then yellow else steel,
				Material = if i == 1 then Enum.Material.DiamondPlate else Enum.Material.Metal,
				Transparency = lf.Transparency or 0,
				CanCollide = true,
				Parent = gate,
			})
			leaf:SetAttribute("WE_GateLeaf", SG.LeafSlide)
			leaf:SetAttribute("WE_ClosedCFrame", leaf.CFrame)
			if i == 1 then
				-- black band on the yellow boom (a child part: SetGateOpen moves it with the leaf)
				part({
					Name = "GateStripe",
					Size = Vector3.new(span, 0.8, lf.Thickness + 0.1),
					CFrame = leaf.CFrame * CFrame.new(0, 1.3, 0),
					Color = Color3.fromRGB(28, 28, 26),
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Parent = leaf,
				})
			end
		end

		-- wall gap marker: WORLD-axis-aligned box (BaseLayout.PlotRect; StructureKitBuilder's gappedWall reads world axes)
		local gapC, gapSX, gapSZ = BaseLayout.PlotRect(pos, gx, SG.WallZ, SG.GapWidth, SG.GapDepth)
		local gap = part({
			Name = "SeaGateWallGap",
			Size = Vector3.new(gapSX, 2, gapSZ),
			CFrame = CFrame.new(gapC.X, gapC.Y + padTop + 1, gapC.Z),
			Transparency = 1,
			CanCollide = false,
			Parent = gate,
		})
		gap.CanTouch = false
		gap.CanQuery = false
		gap:SetAttribute("WE_WallGap", true)

		-- one guard on the west quay facing the gate water (+X); no NPCLabel (HUD pass removes gate-guard labels)
		for gi, gd in ipairs(SG.Guards) do
			part({
				Name = "GuardSandbag",
				Size = Vector3.new(1.3, 1.3, 4.2),
				CFrame = at(gd.X + 3.5, padTop + 0.65, gd.Z),
				Color = Color3.fromRGB(186, 164, 118),
				Material = Enum.Material.Fabric,
				CanCollide = true,
				Parent = gate,
			})
			makeSoldierKit(
				gate,
				"GateGuard_Sea" .. (if gi > 1 then tostring(gi) else ""),
				F * CFrame.new(gd.X, padTop + 2.1, gd.Z) * CFrame.Angles(0, math.rad(-90), 0),
				Color3.fromRGB(62, 72, 52),
				nil,
				Color3.fromRGB(140, 150, 130),
				150,
				"Guard",
				nil
			)
		end
	end
end

-- v68: ATM cluster anchor offset (legacy (28, 8) → BaseLayoutConfig Courtyard.Collector)
local function collectorShift(): Vector3
	if BaseLayout.Enabled() then
		local c = BaseLayout.Config().Courtyard.Collector
		return Vector3.new(c.X - 28, 0, c.Z - 8)
	end
	return Vector3.zero
end

local function paintPlotFloorChevrons(plotFolder: Folder, plotOrigin: Vector3)
	--[[
		Permanent white >>>> chevrons on plot floor guiding spawn → CommandCenter → next pads.
		Visual-only (CanCollide false). Competitor pattern from QUALITY_GAP.
	]]
	local folder = Instance.new("Folder")
	folder.Name = "PlotFloorChevrons"
	folder.Parent = plotFolder

	local function chevronAt(worldPos: Vector3, yawRad: number, idx: number)
		-- Wedge-ish arrow: wide rear + tip (two parts read as >>>)
		local cf = CFrame.new(worldPos) * CFrame.Angles(0, yawRad, 0)
		part({
			Name = "ChevronBody" .. idx,
			Size = Vector3.new(3.2, 0.12, 2.2),
			CFrame = cf,
			Color = COL_CHEVRON,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
		part({
			Name = "ChevronTip" .. idx,
			Size = Vector3.new(1.6, 0.14, 1.6),
			CFrame = cf * CFrame.new(0, 0.02, -1.4) * CFrame.Angles(0, math.rad(45), 0),
			Color = COL_CHEVRON,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
	end

	local function paintPath(from: Vector3, to: Vector3, count: number, startIdx: number): number
		local delta = to - from
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude < 4 then
			return startIdx
		end
		-- Face along path (Roblox look = -Z); atan2(x,z) matches CFrame.Angles Y
		local yaw = math.atan2(flat.X, flat.Z)
		local idx = startIdx
		for i = 1, count do
			local alpha = i / (count + 1)
			local pos = from:Lerp(to, alpha) + Vector3.new(0, 0.55, 0)
			chevronAt(pos, yaw, idx)
			idx += 1
		end
		return idx
	end

	-- Path nodes: PlayerSpawn → CC → Barracks → Depot → Weapons → ATM/premium cluster
	-- v70: nodes are plot-local, mapped through the plot frame (chevron yaws follow the world node deltas)
	local F = BaseLayout.PlotCFrame(plotOrigin)
	local spawnPos = F:PointToWorldSpace(Vector3.new(0, 0.5, 55))
	local nodes = {
		spawnPos,
	}
	if BaseLayout.Enabled() then
		-- v68: spawn → down the main road → Command Center doorway
		local cfg = BaseLayout.Config()
		local sp = cfg.SpawnOffset
		local cc = cfg.Structures.CommandCenter
		local dx, dz = BaseLayout.Rotate(7, 14, cc.Yaw)
		nodes = {
			F:PointToWorldSpace(Vector3.new(sp.X, 0.5, sp.Z - 8)),
			F:PointToWorldSpace(Vector3.new(0, 0.5, 60)),
			F:PointToWorldSpace(Vector3.new(cc.Site.X + dx, 0.5, cc.Site.Z + dz)),
		}
	end
	for i, def in ipairs(STRUCTURES) do
		if i > 5 or BaseLayout.Enabled() then
			break
		end
		local col = (i - 1) % STRUCT_COLS
		local row = math.floor((i - 1) / STRUCT_COLS)
		local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
		table.insert(nodes, F:PointToWorldSpace(offset + Vector3.new(0, 0.5, 0)))
	end
	-- Guide toward MoneyCollector + premium Robux pads (unpaid ATM cluster)
	if not BaseLayout.Enabled() then
		local atmCluster = F:PointToWorldSpace(Vector3.new(28, 0.5, 8))
		table.insert(nodes, atmCluster)
	end

	local idx = 1
	for i = 1, #nodes - 1 do
		local steps = if i == 1 then 5 elseif i == #nodes - 1 then 4 else 3
		idx = paintPath(nodes[i], nodes[i + 1], steps, idx)
	end
end



local function dressPlotPadSandbags(plotFolder: Folder, plotOrigin: Vector3)
	--[[
		v33: cheap MapDressing-style sandbag berms + extra chevrons near early BUY pads.
		Visual-only; does not tag WE_UpgradeSlot.
	]]
	local folder = Instance.new("Folder")
	folder.Name = "PlotPadDressing"
	folder.Parent = plotFolder
	-- v70: positions and yaws are plot-local, placed through the plot frame
	local F = BaseLayout.PlotCFrame(plotOrigin)

	local function sandbag(at: Vector3, yaw: number, idx: number)
		local cf = F * CFrame.new(at) * CFrame.Angles(0, yaw, 0)
		part({
			Name = "PadSandbag" .. idx,
			Size = Vector3.new(4.2, 1.1, 1.4),
			CFrame = cf,
			Color = Color3.fromRGB(130, 115, 80),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
		part({
			Name = "PadSandbagTop" .. idx,
			Size = Vector3.new(3.4, 0.7, 1.1),
			CFrame = cf * CFrame.new(0, 0.85, 0),
			Color = Color3.fromRGB(145, 125, 88),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
	end

	local function miniChevron(at: Vector3, yaw: number, idx: number)
		local cf = F * CFrame.new(at) * CFrame.Angles(0, yaw, 0)
		part({
			Name = "PadChevron" .. idx,
			Size = Vector3.new(2.4, 0.1, 1.6),
			CFrame = cf,
			Color = Color3.fromRGB(245, 245, 250),
			Material = Enum.Material.SmoothPlastic, -- v70: painted (no decorative Neon)
			CanCollide = false,
			Transparency = 0.2,
			Parent = folder,
		})
	end

	local idx = 1
	-- First 6 structure pads get flanking sandbags + approach chevron (legacy grid pads only; v68 consoles)
	for i, def in ipairs(STRUCTURES) do
		if i > 6 or BaseLayout.Enabled() then
			break
		end
		local col = (i - 1) % STRUCT_COLS
		local row = math.floor((i - 1) / STRUCT_COLS)
		local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
		local padPos = offset -- plot-local
		sandbag(padPos + Vector3.new(-7, 0.7, 4), math.rad(15), idx)
		idx += 1
		sandbag(padPos + Vector3.new(7, 0.7, 4), math.rad(-15), idx)
		idx += 1
		miniChevron(padPos + Vector3.new(0, 0.55, 9), math.rad(180), idx)
		idx += 1
	end
	-- ATM approach berm
	local atm = collectorShift() + Vector3.new(28, 0.7, 8) -- plot-local
	sandbag(atm + Vector3.new(-6, 0, 6), 0, idx)
	idx += 1
	sandbag(atm + Vector3.new(6, 0, 6), 0, idx)
end



local function premiumOfferIdLive(kind: string, key: string): boolean
	-- Hide pads until Creator Dashboard Id exists (GoldenPumpjack Id=0 → no pad)
	if kind == "GamePass" then
		local def = MonetizationConfig.GamePasses[key]
		return def ~= nil and typeof(def.Id) == "number" and def.Id ~= 0
	elseif kind == "DevProduct" then
		local def = MonetizationConfig.DevProducts[key]
		return def ~= nil and typeof(def.Id) == "number" and def.Id ~= 0
	end
	return false
end

-- v70: F = plot frame, atmLocal = plot-local ATM cluster anchor (pads turn with the plot)
local PREMIUM_TAG_RANGE = 20
local function buildPremiumPads(folder: Folder, plotId: number, F: CFrame, atmLocal: Vector3)
	-- Competitor ATM-cluster: red AutoCollect / 2x Cash, yellow Speed; GoldenPump only if Id≠0
	-- v70 (HUD spec §5): plain stud-scaled tag "Auto Collect" / "R$" (was a dark card "AUTO COLLECT · R$"); the pad
	-- keeps its Neon (it is the offer), its PointLight is gone (light budget). PREMIUM_TAG_RANGE keeps the four tags
	-- off screen while you stand at the ATM (CLAUDE.md: at most 3 labels on screen at a base).
	local offers = {
		{ Key = "AutoCollect", Kind = "GamePass", Label = "Auto Collect", Color = Color3.fromRGB(220, 50, 50), Offset = Vector3.new(-10, 0.55, 14) },
		{ Key = "VIP", Kind = "GamePass", Label = "VIP", Color = Color3.fromRGB(180, 60, 220), Offset = Vector3.new(-18, 0.55, 8) },
		{ Key = "DoubleCash", Kind = "GamePass", Label = "2x Cash", Color = Color3.fromRGB(255, 70, 40), Offset = Vector3.new(0, 0.55, 16) },
		{ Key = "SpeedBoost", Kind = "DevProduct", Label = "Speed Boost", Color = Color3.fromRGB(255, 210, 40), Offset = Vector3.new(10, 0.55, 14) },
		{ Key = "GoldenPumpjack", Kind = "DevProduct", Label = "Golden Pump", Color = Color3.fromRGB(255, 180, 40), Offset = Vector3.new(0, 0.55, 22) },
	}
	for _, offer in ipairs(offers) do
		if not premiumOfferIdLive(offer.Kind, offer.Key) then
			continue
		end
		local pad = part({
			Name = "PremiumPad_" .. offer.Key,
			Size = Vector3.new(7, 0.45, 7),
			CFrame = F * CFrame.new(atmLocal + offer.Offset),
			Color = offer.Color,
			Material = Enum.Material.Neon,
			CanCollide = true,
			Parent = folder,
		})
		pad:SetAttribute("PlotId", plotId)
		pad:SetAttribute("OfferKey", offer.Key)
		pad:SetAttribute("OfferKind", offer.Kind)
		CollectionService:AddTag(pad, TAG_PREMIUM)
		WorldLabel.Create(pad, offer.Label, { Name = "WE_PremiumBillboard", Sub = "R$", Color = offer.Color, MaxDistance = PREMIUM_TAG_RANGE, Offset = Vector3.new(0, 5.5, 0) })
	end
end

local function buildMoneyCollector(plotFolder: Folder, plotId: number, pos: Vector3)
	-- v68: the ATM cluster (body, screen, collect ring, premium pads) moves as a group to Courtyard.Collector
	-- v70: plot-local ATM anchor, every part placed through the plot frame F (turns with the plot)
	local F = BaseLayout.PlotCFrame(pos)
	local base = collectorShift()
	-- ATM-like Part kit: matte grey body + green digit screen (MoneyCollectorService billboard refreshes $)
	local folder = Instance.new("Folder")
	folder.Name = "MoneyCollector"
	folder.Parent = plotFolder
	local body = part({
		Name = "CollectorBody",
		Size = Vector3.new(6, 8, 4),
		CFrame = F * CFrame.new(base + Vector3.new(28, 4.5, 8)),
		Color = Color3.fromRGB(70, 78, 72),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = true,
		Parent = folder,
	})
	body:SetAttribute("PlotId", plotId)
	body:SetAttribute("WE_LimeLandmark", true)
	CollectionService:AddTag(body, TAG_COLLECTOR)
	part({
		Name = "CollectorBase",
		Size = Vector3.new(7.5, 0.6, 5.5),
		CFrame = F * CFrame.new(base + Vector3.new(28, 0.8, 8)),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Parent = folder,
	})
	local screen = part({
		Name = "CollectorScreen",
		Size = Vector3.new(4.2, 2.8, 0.35),
		CFrame = F * CFrame.new(base + Vector3.new(28, 5.2, 8 - 2.15)),
		Color = Color3.fromRGB(40, 160, 70),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	-- Green digit SurfaceGui (live $ filled by MoneyCollectorService billboard on body too)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_ATMScreen"
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(240, 160)
	sg.LightInfluence = 0
	sg.MaxDistance = 80 -- v70: near-only (CLAUDE.md SurfaceGui budget)
	sg.Parent = screen
	local digits = Instance.new("TextLabel")
	digits.Name = "Digits"
	digits.Size = UDim2.fromScale(1, 1)
	digits.BackgroundColor3 = Color3.fromRGB(8, 40, 18)
	digits.BackgroundTransparency = 0.15
	digits.Font = Enum.Font.Code
	digits.TextScaled = true
	digits.TextColor3 = Color3.fromRGB(70, 255, 120)
	digits.Text = "$0"
	digits.Parent = sg
	local light = Instance.new("PointLight")
	light.Name = "ATMGlow"
	light.Color = Color3.fromRGB(120, 255, 90)
	light.Brightness = 1.15
	light.Range = 20
	light.Parent = body
	-- v70 (HUD spec §5): no "COLLECT · Touch ATM" billboard (it was AlwaysOnTop); the ATM screen and the flat lime
	-- collect circle are the cue.
	-- Lime Collect circle on ground (touch radius visual). A cylinder's axis is its X: X is the thickness, Y/Z the
	-- diameter, turned 90° about Z so it lies flat (it was sized along X, which stood a 14-stud pole on end).
	local collectCircle = part({
		Name = "CollectCircle",
		Size = Vector3.new(0.25, 14, 14),
		CFrame = F * CFrame.new(base + Vector3.new(28, 0.55, 8)),
		Color = Color3.fromRGB(90, 255, 110),
		Material = Enum.Material.SmoothPlastic, -- v70: painted (no decorative Neon)
		Transparency = 0.55,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	collectCircle.CFrame = F * CFrame.new(base + Vector3.new(28, 0.55, 8)) * CFrame.Angles(0, 0, math.rad(90))
	collectCircle:SetAttribute("PlotId", plotId)
	local ring = part({
		Name = "CollectRing",
		Size = Vector3.new(0.2, 15.5, 15.5),
		Color = Color3.fromRGB(60, 220, 90),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.35,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	ring.CFrame = F * CFrame.new(base + Vector3.new(28, 0.45, 8)) * CFrame.Angles(0, 0, math.rad(90))

	-- Optional ATM catalog mesh dress (Part kit remains authoritative)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachCollectorVisual then
				vas.TryAttachCollectorVisual(body)
			end
		end)
	end)
	-- ATM-cluster premium Robux pads (AutoCollect / 2x / Speed / GoldenPump)
	buildPremiumPads(folder, plotId, F, base + Vector3.new(28, 0, 8))
end

function MapSetup.Run()
	-- Normal gravity so characters fall onto terrain (not float/void)
	Workspace.Gravity = 196.2

	-- Lighting / sky / atmosphere — bright midday desert (inspiration only)
	local worldLight = (StructureVisualConfig :: any).WorldLighting or {}
	Lighting.Ambient = worldLight.DayAmbient or Color3.fromRGB(165, 145, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(185, 165, 130)
	Lighting.Brightness = 3.15
	Lighting.ClockTime = 12.5 -- intense midday sun
	Lighting.GeographicLatitude = 22
	Lighting.EnvironmentDiffuseScale = worldLight.EnvironmentDiffuseScale or 0.55
	Lighting.EnvironmentSpecularScale = 0.42
	Lighting.FogColor = Color3.fromRGB(210, 195, 160)
	Lighting.FogStart = 1200
	Lighting.FogEnd = 5200
	pcall(function()
		Lighting.GlobalShadows = true
	end)

	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	sky.Name = "WE_Sky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 2500
	sky.SunAngularSize = 18 -- larger desert sun
	sky.MoonAngularSize = 9

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.14
	atm.Offset = 0.08
	atm.Color = Color3.fromRGB(200, 185, 150) -- warm haze near horizon
	atm.Decay = Color3.fromRGB(95, 130, 190) -- deep blue sky fade
	atm.Glare = 0.32
	atm.Haze = 1.15 -- low haze, high contrast

	-- Cancel prior day/night loop on resetmap; gentle cycle biased to bright desert day
	local dayMarker = Lighting:FindFirstChild("WE_DayNightMarker")
	if dayMarker then
		dayMarker:Destroy()
	end
	dayMarker = Instance.new("Folder")
	dayMarker.Name = "WE_DayNightMarker"
	dayMarker.Parent = Lighting
	task.spawn(function()
		local STEP = 0.03
		local WAIT = 1.5
		local dayAmb = ((StructureVisualConfig :: any).WorldLighting or {}).DayAmbient or Color3.fromRGB(165, 145, 110)
		local dayOut = Color3.fromRGB(185, 165, 130)
		local dayFog = Color3.fromRGB(210, 195, 160)
		local nightAmb = Color3.fromRGB(40, 45, 70)
		local nightOut = Color3.fromRGB(50, 55, 85)
		local nightFog = Color3.fromRGB(55, 60, 90)
		while dayMarker.Parent do
			local t = (Lighting.ClockTime + STEP) % 24
			Lighting.ClockTime = t
			local night = 0
			if t < 5 or t > 20 then
				night = 1
			elseif t < 7 then
				night = 1 - (t - 5) / 2
			elseif t > 18 then
				night = (t - 18) / 2
			end
			Lighting.Brightness = 3.2 - night * 2.1
			Lighting.Ambient = dayAmb:Lerp(nightAmb, night)
			Lighting.OutdoorAmbient = dayOut:Lerp(nightOut, night)
			Lighting.FogColor = dayFog:Lerp(nightFog, night)
			Lighting.FogStart = 1200 - night * 250
			Lighting.FogEnd = 5200 - night * 800
			atm.Density = 0.13 + night * 0.14
			atm.Haze = 1.1 + night * 1.0
			atm.Color = Color3.fromRGB(200, 185, 150):Lerp(Color3.fromRGB(70, 80, 120), night)
			atm.Decay = Color3.fromRGB(95, 130, 190):Lerp(Color3.fromRGB(40, 50, 90), night)
			atm.Glare = 0.32 - night * 0.2
			task.wait(WAIT)
		end
	end)

	local root = ensureFolder("WarEmpireSetup", Workspace)
	local map = ensureFolder("Map", root)
	-- Continuous collide floor: thick, large, explicit CanCollide — never reads as sky
	-- v70 (§12.1): tiled (16 x 1800 ground, 25 x 2000 safety catch, 4 pieces per berm / void-wall side)
	buildGroundTiles(map)
	buildSafetyUnderfloor(map)
	buildEdgeBerms(map)
	buildInvisibleWalls(map)
	buildVisualFillPatches(map)
	buildMountainRing(root)
	-- Road grid scaled to plot ring (optional visual guide)
	-- v70 (§6): with the waterways every road stops WaterConfig.RoadEndSetback studs before the first water (no
	-- bridges; every land outpost is inside the ring) and is built as two parts split at 0 (<name>_A: Min..0,
	-- <name>_B: 0..Max, each <= 1752 studs). Each end gets a collidable jersey barrier in Map.RoadEnds.
	local roadEndsFolder: Folder? = nil
	local function roadEndBarrier(name: string, alongX: boolean, across: number, at: number)
		local rb = WaterConfig.RoadEndBarrier
		if roadEndsFolder == nil then
			local f = Instance.new("Folder")
			f.Name = "RoadEnds"
			f.Parent = map
			roadEndsFolder = f
		end
		local centre = if alongX
			then Vector3.new(at, GROUND_TOP_Y + rb.Height * 0.5, across)
			else Vector3.new(across, GROUND_TOP_Y + rb.Height * 0.5, at)
		local barrier = part({
			Name = name,
			Size = if alongX then Vector3.new(rb.Depth, rb.Height, rb.Width) else Vector3.new(rb.Width, rb.Height, rb.Depth),
			Position = centre,
			Color = Color3.fromRGB(196, 192, 180),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = roadEndsFolder,
		})
		part({
			Name = "Stripe",
			Size = if alongX then Vector3.new(rb.Depth + 0.1, 0.5, rb.Width) else Vector3.new(rb.Width, 0.5, rb.Depth + 0.1),
			Position = Vector3.new(centre.X, GROUND_TOP_Y + 1.6, centre.Z),
			Color = Color3.fromRGB(236, 190, 40),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = barrier,
		})
	end
	-- alongX: the road runs along X (RoadZ<z>, at z = across) or along Z (RoadX<x>, at x = across)
	local function worldRoad(name: string, alongX: boolean, across: number)
		local ends = if WaterConfig.Enabled == true then WaterConfig.RoadEnds[name] else nil
		local spans: { { Name: string, A: number, B: number } } = {}
		if ends and ends.Min < 0 and ends.Max > 0 then
			table.insert(spans, { Name = name .. "_A", A = ends.Min, B = 0 })
			table.insert(spans, { Name = name .. "_B", A = 0, B = ends.Max })
		elseif ends then
			table.insert(spans, { Name = name .. "_A", A = ends.Min, B = ends.Max })
		else
			-- no waterways: full length, still in pieces under the part-size cap
			local piece = GROUND_SIZE / EDGE_PIECES
			for k, c in ipairs(tileCentres(EDGE_PIECES, piece)) do
				table.insert(spans, { Name = name .. "_" .. k, A = c - piece * 0.5, B = c + piece * 0.5 })
			end
		end
		for _, sp in ipairs(spans) do
			local mid, len = (sp.A + sp.B) * 0.5, sp.B - sp.A
			part({
				Name = sp.Name,
				Size = if alongX then Vector3.new(len, 0.15, 14) else Vector3.new(14, 0.15, len),
				Position = if alongX
					then Vector3.new(mid, GROUND_TOP_Y + 0.05, across)
					else Vector3.new(across, GROUND_TOP_Y + 0.05, mid),
				Color = Color3.fromRGB(50, 52, 48),
				Material = Enum.Material.Asphalt,
				CanCollide = false,
				Parent = map,
			})
		end
		if ends then
			roadEndBarrier(name .. "_Min", alongX, across, ends.Min + WaterConfig.RoadEndBarrier.Depth * 0.5)
			roadEndBarrier(name .. "_Max", alongX, across, ends.Max - WaterConfig.RoadEndBarrier.Depth * 0.5)
		end
	end
	for _, z in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		worldRoad("RoadZ" .. z, true, z)
	end
	for _, x in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		worldRoad("RoadX" .. x, false, x)
	end
	-- Asphalt Decal texture on road strips (MapDressing.AsphaltDecal)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if not (vas and vas.ApplyAsphaltDecal) then
				return
			end
			for _, ch in ipairs(map:GetChildren()) do
				if ch:IsA("BasePart") and (string.sub(ch.Name, 1, 5) == "RoadZ" or string.sub(ch.Name, 1, 5) == "RoadX") then
					vas.ApplyAsphaltDecal(ch)
				end
			end
		end)
	end)

		-- Yellow centerline dashes (asphalt polish — competitor desert roads)
	for _, z in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		for i = -8, 8 do
			if i ~= 0 then
				part({
					Name = "RoadDashZ" .. z .. "_" .. i,
					Size = Vector3.new(8, 0.12, 1.2),
					Position = Vector3.new(i * 90, GROUND_TOP_Y + 0.12, z),
					Color = Color3.fromRGB(240, 210, 60),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Transparency = 0.25,
					Parent = map,
				})
			end
		end
	end
	for _, x in ipairs({ -PLOT_RING, PLOT_RING }) do
		for i = -8, 8 do
			if i ~= 0 then
				part({
					Name = "RoadDashX" .. x .. "_" .. i,
					Size = Vector3.new(1.2, 0.12, 8),
					Position = Vector3.new(x, GROUND_TOP_Y + 0.12, i * 90),
					Color = Color3.fromRGB(240, 210, 60),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Transparency = 0.25,
					Parent = map,
				})
			end
		end
	end

	local bases = ensureFolder("Bases", root)
	for plotId, pos in ipairs(PLOT_POSITIONS) do
		-- v70: the plot frame. Everything on the plot is plot-local and placed through F, so the whole base turns to
		-- face the map centre when BaseLayoutConfig.FaceMapCentre is on (F = CFrame.new(pos) while it is off).
		local F = BaseLayout.PlotCFrame(pos)
		local plotFolder = Instance.new("Folder")
		plotFolder.Name = "Plot" .. plotId
		plotFolder:SetAttribute("PlotYaw", BaseLayout.PlotYaw(pos))
		plotFolder:SetAttribute("PlotForward", BaseLayout.PlotForward(pos))
		plotFolder.Parent = bases

		local pad = part({
			Name = "PlotPad",
			Size = Vector3.new(PLOT_PAD_SIZE, 1, PLOT_PAD_SIZE),
			CFrame = F, -- v70: the pad carries the plot yaw (services read pad.CFrame for plot-local ↔ world)
			Color = COL_PAD,
			Material = Enum.Material.Concrete,
			Parent = plotFolder,
		})
		pad:SetAttribute("PlotId", plotId)
		CollectionService:AddTag(pad, TAG_BASE)
		paintEdge(pad, COL_PAD_EDGE, 0.55)

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "PlayerSpawn"
		spawn.Size = Vector3.new(10, 1, 10)
		do
			local sp = if BaseLayout.Enabled() then BaseLayout.Config().SpawnOffset else { X = 0, Z = 55 }
			spawn.CFrame = F * CFrame.new(sp.X, 2, sp.Z) -- main gate side, gate defence and spawn facing turn with it
		end
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.BrickColor = BrickColor.new("Dark green")
		spawn.Material = Enum.Material.SmoothPlastic -- v70 (HUD spec §5): painted spawn pad (was Neon)
		spawn.Parent = plotFolder

		-- v67: no giant "BASE n · Walk pads to BUY · E / B menu" label over the plot (HUD + pad cards explain buying)
		-- v70 (HUD spec §5): no plot beacon (neon tip + glow disc) at the rear of the plot either

		for i, def in ipairs(STRUCTURES) do
			local col = (i - 1) % STRUCT_COLS
			local row = math.floor((i - 1) / STRUCT_COLS)
			local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
			buildStructureKit(plotFolder, plotId, pos, offset, def)
		end

		paintPlotFloorChevrons(plotFolder, pos)
		dressPlotPadSandbags(plotFolder, pos)

		-- Training Yard targets (soldiers "train" → server cash; visual only)
		-- v68: the whole yard group (targets, workers, pad, stalls, anchors) moves to Courtyard.TrainingYard
		-- v70: yardShift and every offset below are plot-local (placed through F)
		local yardShift = Vector3.zero
		if BaseLayout.Enabled() then
			local ty = BaseLayout.Config().Courtyard.TrainingYard
			yardShift = Vector3.new(ty.X - -14, 0, ty.Z - 48)
		end
		local yardFolder = Instance.new("Folder")
		yardFolder.Name = "TrainingYard"
		yardFolder.Parent = plotFolder
		for ti = 1, 3 do
			local tLocal = yardShift + Vector3.new(-50 + ti * 18, 3.5, 48)
			local target = part({
				Name = "TrainingTarget" .. ti,
				Size = Vector3.new(4, 6, 0.6),
				CFrame = F * CFrame.new(tLocal),
				Color = Color3.fromRGB(200, 60, 60),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = yardFolder,
			})
			target:SetAttribute("PlotId", plotId)
			target:SetAttribute("WE_TrainingTarget", true)
			part({
				Name = "TargetStand" .. ti,
				Size = Vector3.new(1, 4, 1),
				CFrame = F * CFrame.new(tLocal + Vector3.new(0, -5, 0)),
				Color = Color3.fromRGB(70, 70, 70),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = yardFolder,
			})
			part({
				Name = "TargetBullseye" .. ti,
				Size = Vector3.new(1.6, 1.6, 0.35),
				CFrame = F * CFrame.new(tLocal + Vector3.new(0, 0.5, -0.2)),
				Color = Color3.fromRGB(240, 220, 60),
				Material = Enum.Material.SmoothPlastic, -- v70: painted (no decorative Neon)
				CanCollide = false,
				Parent = yardFolder,
			})
		end
		-- Training workers (visual only — income is SoldierService tick). v70 (HUD spec §5): no name tag over them
		for wi = 1, 2 do
			local wLocal = yardShift + Vector3.new(-40 + wi * 20, 2.6, 42)
			-- P0: dress as Worker→Infantry mesh (force catalog even in StudioSkipWorldDressing)
			makeSoldierKit(
				yardFolder,
				"TrainingWorker" .. wi,
				F * CFrame.new(wLocal) * CFrame.Angles(0, math.rad(180), 0),
				Color3.fromRGB(70, 85, 55),
				nil,
				Color3.fromRGB(140, 150, 130), -- muted
				50,
				"Worker",
				nil
			)
		end
		-- Target ring + base plate polish
		part({
			Name = "YardPad",
			Size = Vector3.new(55, 0.6, 18),
			CFrame = F * CFrame.new(yardShift + Vector3.new(-14, 0.4, 48)),
			Color = Color3.fromRGB(48, 52, 42),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = yardFolder,
		})
		-- v70 (HUD spec §5): no "+$/tick" earn placeholder billboard on the yard pad
		-- Design Bot quality wire: 2–3 SquadStall kits (Tent + crates + sandbags + Infantry)
		do
			local stallFolder = Instance.new("Folder")
			stallFolder.Name = "SquadStalls"
			stallFolder.Parent = yardFolder
			local stallOffsets = {
				Vector3.new(-36, 0, 36),
				Vector3.new(-18, 0, 36),
				Vector3.new(0, 0, 36),
			}
			for si, soff in ipairs(stallOffsets) do
				local sOrigin = yardShift + soff -- plot-local
				local stall = Instance.new("Folder")
				stall.Name = "SquadStall" .. si
				stall.Parent = stallFolder
				-- Floor plate
				part({
					Name = "StallFloor",
					Size = Vector3.new(12, 0.4, 10),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(0, 0.35, 0)),
					Color = Color3.fromRGB(70, 68, 52),
					Material = Enum.Material.WoodPlanks,
					CanCollide = true,
					Parent = stall,
				})
				-- Tent host (catalog Tent via TryAttachPropVisual)
				local tentHost = part({
					Name = "TentHost",
					Size = Vector3.new(8, 4, 6),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(0, 2.4, -1)),
					Color = Color3.fromRGB(90, 100, 70),
					Material = Enum.Material.Fabric,
					CanCollide = false,
					Transparency = 0.35,
					Parent = stall,
				})
				-- Crate stack hosts
				local crateA = part({
					Name = "CrateHostA",
					Size = Vector3.new(2.2, 2.0, 2.2),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(4.5, 1.2, 2)),
					Color = Color3.fromRGB(95, 80, 55),
					Material = Enum.Material.Wood,
					CanCollide = true,
					Parent = stall,
				})
				local crateB = part({
					Name = "CrateHostB",
					Size = Vector3.new(2.0, 1.8, 2.0),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(4.5, 3.0, 2)),
					Color = Color3.fromRGB(85, 70, 48),
					Material = Enum.Material.Wood,
					CanCollide = true,
					Parent = stall,
				})
				local milCrate = part({
					Name = "MilCrateHost",
					Size = Vector3.new(2.4, 1.6, 1.8),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(-4.2, 1.0, 2.2)),
					Color = Color3.fromRGB(55, 70, 50),
					Material = Enum.Material.Metal,
					CanCollide = true,
					Parent = stall,
				})
				-- Sandbags
				local sandHost = part({
					Name = "SandbagHost",
					Size = Vector3.new(6, 1.1, 1.3),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(0, 0.75, 4.2)),
					Color = Color3.fromRGB(130, 115, 80),
					Material = Enum.Material.Sand,
					CanCollide = true,
					Parent = stall,
				})
				-- Lantern host (v70 light budget: the lantern carries no PointLight)
				local lanternHost = part({
					Name = "LanternHost",
					Size = Vector3.new(0.6, 1.2, 0.6),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(-3.5, 2.2, -2.5)),
					Color = Color3.fromRGB(180, 140, 60),
					Material = Enum.Material.Metal,
					CanCollide = false,
					Parent = stall,
				})
				-- v34: stall roles use distinct VisualAssetConfig Character IDs + Part dress
				local stallRoles = {
					{ Kind = "Infantry", Label = "INFANTRY", Body = Color3.fromRGB(70, 85, 55), Accent = Color3.fromRGB(180, 220, 120) },
					{ Kind = "HeavyInfantry", Label = "HEAVY", Body = Color3.fromRGB(50, 55, 48), Accent = Color3.fromRGB(230, 160, 50) },
					{ Kind = "Guard", Label = "GUARD", Body = Color3.fromRGB(45, 55, 70), Accent = Color3.fromRGB(90, 140, 220) },
				}
				local roleDef = stallRoles[((si - 1) % #stallRoles) + 1]
				local soldierCf = F * CFrame.new(sOrigin + Vector3.new(-1.5, 2.6, 1.5)) * CFrame.Angles(0, math.rad(160 + si * 8), 0)
				makeSoldierKit(
					stall,
					"Stall" .. roleDef.Kind .. si,
					soldierCf,
					roleDef.Body,
					nil,
					roleDef.Accent,
					80,
					roleDef.Kind,
					nil
				)
				-- v70 (HUD spec §5): the stall's role is a painted board on the sandbags facing the yard front (was a
				-- floating NPCLabel over the soldier)
				local stallSign = part({
					Name = "StallSign",
					Size = Vector3.new(4.4, 1.2, 0.2),
					CFrame = F * CFrame.new(sOrigin + Vector3.new(0, 1.9, 4.2)),
					Color = Color3.fromRGB(78, 64, 44),
					Material = Enum.Material.WoodPlanks,
					CanCollide = false,
					Parent = stall,
				})
				stallSign.CanQuery = false
				stallSign.CanTouch = false
				WorldLabel.Surface(stallSign, Enum.NormalId.Back, roleDef.Label, { Name = "WE_StallSign", Color = roleDef.Accent })
				-- Optional crouch: Humanoid Sit as lightweight proxy (full crouch AnimationId TBD)
				pcall(function()
					local m = stall:FindFirstChild("Stall" .. roleDef.Kind .. si)
					if m and m:IsA("Model") then
						local hum = m:FindFirstChildOfClass("Humanoid")
						if hum then
							hum.Sit = false
							hum.WalkSpeed = 0
							-- Note: T-pose/catalog pose OK — crouch AnimationId not wired this pass
							m:SetAttribute("WE_PoseNote", "TPose_CrouchAnimPending")
						end
					end
				end)
				-- Catalog prop dress (pcall — Part kits remain if InsertService fails)
				task.defer(function()
					pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if not vas or not vas.TryAttachPropVisual then
							return
						end
						vas.TryAttachPropVisual(tentHost, "Tent")
						vas.TryAttachPropVisual(crateA, "Crate")
						vas.TryAttachPropVisual(crateB, "MilitaryCrate")
						vas.TryAttachPropVisual(milCrate, "MilitaryCrate")
						vas.TryAttachPropVisual(sandHost, "Sandbag")
						vas.TryAttachPropVisual(lanternHost, "Lantern")
					end)
				end)
			end
		end

		-- Invisible anchors (ManualDropperService / SoldierService place the yard dropper and cash pops from them).
		-- v70 (HUD spec §5): no yard title billboard and no glowing worker → target beams (the last always-on
		-- glowing lines in a base).
		part({
			Name = "YardAnchor",
			Size = Vector3.new(1, 1, 1),
			CFrame = F * CFrame.new(yardShift + Vector3.new(-14, 8, 48)),
			Transparency = 1,
			CanCollide = false,
			Parent = yardFolder,
		})
		part({
			Name = "YardEarnAnchor",
			Size = Vector3.new(1, 1, 1),
			CFrame = F * CFrame.new(yardShift + Vector3.new(-14, 6, 42)),
			Transparency = 1,
			CanCollide = false,
			Parent = yardFolder,
		})
		-- Design densify: 8–12 realistic warzone props per plot (always-on Part kits; pcall catalog)
		do
			local okDress, errDress = pcall(function()
				local wz = Instance.new("Folder")
				wz.Name = "PlotWarzone"
				wz.Parent = plotFolder
				local count = 12
				-- v68: fixed spots along the walls / rear zone (the 58-78 stud ring lands on the new plaza)
				local spots = if BaseLayout.Enabled() then BaseLayout.Config().WarzoneSpots else nil
				if spots then
					count = #spots
				end
				for i = 1, count do
					local ang = (i / count) * math.pi * 2
					local rad = 58 + (i % 3) * 10
					-- v70: plot-local spot, placed through the plot frame F (props turn with the plot)
					local o = Vector3.new(math.cos(ang) * rad, 0.6, math.sin(ang) * rad)
					if spots then
						o = Vector3.new(spots[i].X, 0.6, spots[i].Z)
					end
					if i % 3 == 0 then
						-- sandbag berm (Metal/Sand — no neon)
						part({
							Name = "WZ_Sandbag" .. i,
							Size = Vector3.new(6, 1.2, 1.4),
							CFrame = F * CFrame.new(o),
							Color = Color3.fromRGB(130, 115, 80),
							Material = Enum.Material.Sand,
							CanCollide = true,
							Parent = wz,
						})
						part({
							Name = "WZ_SandbagTop" .. i,
							Size = Vector3.new(5.2, 0.9, 1.1),
							CFrame = F * CFrame.new(o + Vector3.new(0, 1.0, 0)),
							Color = Color3.fromRGB(120, 105, 75),
							Material = Enum.Material.Sand,
							CanCollide = true,
							Parent = wz,
						})
					elseif i % 3 == 1 then
						part({
							Name = "WZ_Crate" .. i,
							Size = Vector3.new(2.2, 2.0, 2.2),
							CFrame = F * CFrame.new(o + Vector3.new(0, 1.0, 0)),
							Color = Color3.fromRGB(95, 80, 55),
							Material = Enum.Material.Wood,
							CanCollide = true,
							Parent = wz,
						})
						part({
							Name = "WZ_Drum" .. i,
							Size = Vector3.new(1.4, 2.2, 1.4),
							CFrame = F * CFrame.new(o + Vector3.new(3, 1.1, 1)),
							Color = Color3.fromRGB(55, 70, 50),
							Material = Enum.Material.Metal,
							Shape = Enum.PartType.Cylinder,
							CanCollide = true,
							Parent = wz,
						})
					else
						part({
							Name = "WZ_Barrier" .. i,
							Size = Vector3.new(5, 1.4, 0.7),
							CFrame = F * CFrame.new(o + Vector3.new(0, 0.7, 0)),
							Color = Color3.fromRGB(110, 105, 90),
							Material = Enum.Material.Concrete,
							CanCollide = true,
							Parent = wz,
						})
					end
				end
				-- Catalog densify InsertService — ALWAYS deferred (never block MapSetup.Run / remotes)
					task.defer(function()
						pcall(function()
							local vas = require(script.Parent.Parent.Services.VisualAssetService)
							if not (vas and vas.TryAttachPropVisual) then
								return
							end
							-- WZ densify catalog: sandbags / crates / desert flora hosts
							for _, ch in ipairs(wz:GetChildren()) do
								if ch:IsA("BasePart") then
									if string.find(ch.Name, "Sandbag", 1, true) then
										vas.TryAttachPropVisual(ch, "Sandbag")
									elseif string.find(ch.Name, "Crate", 1, true) then
										vas.TryAttachPropVisual(ch, "Crate")
									elseif string.find(ch.Name, "Drum", 1, true) then
										vas.TryAttachPropVisual(ch, "OilBarrel")
									elseif string.find(ch.Name, "Barrier", 1, true) then
										vas.TryAttachPropVisual(ch, "ConcreteBarrier")
									end
								end
							end
							local host = wz:FindFirstChildWhichIsA("BasePart")
							if host then
								vas.TryAttachPropVisual(host, "FloodlightTower")
							end
						end)
					end)
			end)
			if not okDress then
				warn("[MapSetup] PlotWarzone densify failed (pads intact):", errDress)
			end
		end
		buildMoneyCollector(plotFolder, plotId, pos)
		buildLayoutGround(plotFolder, plotId, pos)
	end

	local territories = ensureFolder("Territories", root)
	for _, def in ipairs(TERRITORIES) do
		local diameter = (def.Radius or 30) * 2
		local marker = part({
			Name = def.Id,
			Size = Vector3.new(diameter, 1.5, diameter),
			Position = def.Pos,
			Color = def.Color,
			Transparency = 0.45,
			Material = Enum.Material.Neon,
			Parent = territories,
		})
		marker:SetAttribute("TerritoryId", def.Id)
		marker:SetAttribute("Radius", def.Radius or 30)
		marker:SetAttribute("OwnerType", "Neutral")
		marker:SetAttribute("OwnerUserId", 0)
		marker:SetAttribute("CaptureProgress", 0)
		CollectionService:AddTag(marker, TAG_TERRITORY)
		CollectionService:AddTag(marker, TAG_CAPTURE)

		do
			local zoneName = def.DisplayName or def.Id
			local bb = plainBillboard(marker, zoneName .. "  [NEUTRAL]  ·  Stand to capture", Vector2.new(280, 48), 12, Color3.new(1, 1, 1))
			if typeof(bb) == "Instance" and bb:IsA("BillboardGui") then
				bb.MaxDistance = 220 -- named capture zones readable from farther
				bb.StudsOffset = Vector3.new(0, 14, 0)
			end
		end

		part({
			Name = def.Id .. "_Ring",
			Size = Vector3.new(diameter + 8, 0.4, diameter + 8),
			Position = def.Pos + Vector3.new(0, 0.2, 0),
			Color = def.Color,
			Transparency = 0.65,
			CanCollide = false,
			Material = Enum.Material.SmoothPlastic,
			Parent = territories,
		}):SetAttribute("TerritoryId", def.Id)

		part({
			Name = def.Id .. "_FlagPole",
			Size = Vector3.new(0.4, 14, 0.4),
			Position = def.Pos + Vector3.new(0, 7, 0),
			Color = Color3.fromRGB(55, 55, 55),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = territories,
		})
		local flag = part({
			Name = def.Id .. "_Flag",
			Size = Vector3.new(5.5, 3.2, 0.22),
			Position = def.Pos + Vector3.new(2.8, 12.2, 0),
			Color = def.Color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.08,
			Parent = territories,
		})
		flag:SetAttribute("TerritoryId", def.Id)
		flag:SetAttribute("WE_Flag", true)
		part({
			Name = def.Id .. "_FlagStripe",
			Size = Vector3.new(5.5, 0.45, 0.28),
			Position = def.Pos + Vector3.new(2.8, 12.2, 0),
			Color = Color3.fromRGB(245, 245, 245),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0.15,
			Parent = territories,
		})
		part({
			Name = def.Id .. "_Finial",
			Size = Vector3.new(0.7, 0.7, 0.7),
			Position = def.Pos + Vector3.new(0, 14.4, 0),
			Color = Color3.fromRGB(230, 190, 60),
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Ball,
			CanCollide = false,
			Parent = territories,
		})

		beacon(territories, def.Pos + Vector3.new(def.Radius * 0.6, 0, 0), def.Color, def.Id .. "_Beacon")

		-- Coastal oil platform deck + legs + harder NPC guards
		if def.OilRig then
			local deckY = def.Pos.Y
			local deck = part({
				Name = def.Id .. "_Deck",
				Size = Vector3.new(48, 2.5, 48),
				Position = Vector3.new(def.Pos.X, deckY - 1.2, def.Pos.Z),
				Color = Color3.fromRGB(90, 95, 100),
				Material = Enum.Material.Metal,
				Parent = territories,
			})
			deck:SetAttribute("TerritoryId", def.Id)
			-- Support legs
			local legOff = 18
			for _, ox in ipairs({ -legOff, legOff }) do
				for _, oz in ipairs({ -legOff, legOff }) do
					part({
						Name = def.Id .. "_Leg",
						Size = Vector3.new(3, deckY, 3),
						Position = Vector3.new(def.Pos.X + ox, deckY / 2, def.Pos.Z + oz),
						Color = Color3.fromRGB(60, 65, 70),
						Material = Enum.Material.Metal,
						Parent = territories,
					})
				end
			end
			-- Derrick + crane tip + neon rim (visual kits v2)
			part({
				Name = def.Id .. "_Derrick",
				Size = Vector3.new(4, 22, 4),
				Position = Vector3.new(def.Pos.X + 14, deckY + 11, def.Pos.Z + 14),
				Color = Color3.fromRGB(180, 140, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_CraneArm",
				Size = Vector3.new(14, 1.2, 1.2),
				Position = Vector3.new(def.Pos.X + 7, deckY + 20, def.Pos.Z + 14),
				Color = Color3.fromRGB(160, 120, 45),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_HelipadMark",
				Size = Vector3.new(10, 0.3, 10),
				Position = Vector3.new(def.Pos.X - 12, deckY + 0.2, def.Pos.Z - 12),
				Color = Color3.fromRGB(40, 45, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_NeonRim",
				Size = Vector3.new(46, 0.35, 0.5),
				Position = Vector3.new(def.Pos.X, deckY + 0.3, def.Pos.Z + 23),
				Color = Color3.fromRGB(255, 180, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = territories,
			})
			plainBillboard(deck, def.Id .. "  ·  OIL PLATFORM  ·  Hard guards", Vector2.new(300, 44), 14, Color3.fromRGB(255, 210, 120))
			-- Stairs from deck down to ground (prevent 28-stud death plunge)
			-- v70 (§7.1): on the waterways map the stairs are the rig's pier across the lagoon, snapped to the X axis
			-- toward the map centre (Alpha steps x 1765 → 1684, approach pad on the inner bank; Bravo mirrored)
			local inland = if WaterConfig.RigPierAxisAligned == true
				then Vector3.new(-math.sign(def.Pos.X), 0, 0)
				else Vector3.new(-def.Pos.X, 0, -def.Pos.Z)
			if inland.Magnitude < 0.1 then
				inland = Vector3.new(-def.Pos.X, 0, -def.Pos.Z)
			end
			buildOilDeckRamp(territories, def.Id, def.Pos, inland)
			if WaterConfig.Enabled == true then
				-- Concrete footing round each leg at the waterline: a boat's land probe that starts inside a 28-tall leg
				-- misses the leg, but sees the footing top (2.5)
				local lf = WaterConfig.RigLegFooting
				for _, ox in ipairs({ -legOff, legOff }) do
					for _, oz in ipairs({ -legOff, legOff }) do
						part({
							Name = def.Id .. "_LegFooting",
							Size = lf,
							Position = Vector3.new(def.Pos.X + ox, GROUND_TOP_Y + lf.Y * 0.5, def.Pos.Z + oz),
							Color = Color3.fromRGB(120, 118, 110),
							Material = Enum.Material.Concrete,
							CanCollide = true,
							Parent = territories,
						})
					end
				end
				-- [J5] submerged rubble footing under the pier's low end (rig-local Near..Far along the pier, ±HalfWidth
				-- across, y 0.5..2.5): capital ships' collidable bridges (up to 13.1 above the water) would ram steps
				-- 5-10 and the shelf; every land probe sees this top first, so boats brake before it. Walkable.
				local pf = WaterConfig.RigPierFooting
				local dir = inland.Unit
				local mid = Vector3.new(def.Pos.X, GROUND_TOP_Y + pf.Height * 0.5, def.Pos.Z) + dir * ((pf.Near + pf.Far) * 0.5)
				part({
					Name = def.Id .. "_PierFooting",
					Size = Vector3.new(pf.HalfWidth * 2, pf.Height, pf.Far - pf.Near),
					CFrame = CFrame.lookAt(mid, mid + dir),
					Color = Color3.fromRGB(78, 76, 70),
					Material = Enum.Material.Concrete,
					Transparency = 0,
					CanCollide = true,
					Parent = territories,
				})
			end
		end

		-- Fortress walls / keep (named forts with higher stipend)
		if def.Fortress then
			local wallH = 8
			local wallT = 2.2
			local span = (def.Radius or 48) * 1.35
			local wallDefs = {
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, span) },
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, -span) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(span, wallH / 2, 0) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(-span, wallH / 2, 0) },
			}
			for wi, wd in ipairs(wallDefs) do
				part({
					Name = def.Id .. "_Wall" .. wi,
					Size = wd[1],
					Position = def.Pos + wd[2],
					Color = Color3.fromRGB(95, 90, 75),
					Material = Enum.Material.Concrete,
					Parent = territories,
				})
			end
			local keep = part({
				Name = def.Id .. "_Keep",
				Size = Vector3.new(14, 16, 14),
				Position = def.Pos + Vector3.new(0, 8, 0),
				Color = def.Color,
				Material = Enum.Material.Brick,
				Parent = territories,
			})
			keep:SetAttribute("TerritoryId", def.Id)
			part({
				Name = def.Id .. "_KeepRoof",
				Size = Vector3.new(16, 1.5, 16),
				Position = def.Pos + Vector3.new(0, 16.5, 0),
				Color = Color3.fromRGB(70, 65, 55),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			-- Corner towers + gate neon
			for _, corner in ipairs({
				Vector3.new(span, 0, span),
				Vector3.new(span, 0, -span),
				Vector3.new(-span, 0, span),
				Vector3.new(-span, 0, -span),
			}) do
				part({
					Name = def.Id .. "_Tower",
					Size = Vector3.new(5, 12, 5),
					Position = def.Pos + corner + Vector3.new(0, 6, 0),
					Color = Color3.fromRGB(85, 80, 65),
					Material = Enum.Material.Brick,
					Parent = territories,
				})
			end
			part({
				Name = def.Id .. "_GateNeon",
				Size = Vector3.new(8, 0.4, 0.5),
				Position = def.Pos + Vector3.new(0, 1.5, span),
				Color = def.Color,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = territories,
			})
			plainBillboard(keep, def.Id .. "  ·  FORTRESS  ·  High stipend", Vector2.new(300, 44), 12, Color3.fromRGB(230, 210, 160))
		end
	end

	local function makeSpawnFolder(name, tag, count, center, color, ringRadius)
		local folder = ensureFolder(name, root)
		local ring = ringRadius or 200
		-- v68: slide a spawn along its ring until it is PLOT_SPAWN_CLEARANCE outside every player plot
		-- (NPCSpawns4 sat inside plot 4 even at the old 200 size; EventSpawns3 was 13 studs off plot 1).
		local function inAnyPlot(p: Vector3): boolean
			local half = PLOT_PAD_SIZE * 0.5 + PLOT_SPAWN_CLEARANCE
			for _, pp in ipairs(PLOT_POSITIONS) do
				if math.abs(p.X - pp.X) < half and math.abs(p.Z - pp.Z) < half then
					return true
				end
			end
			return false
		end
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local padAt = center + Vector3.new(math.cos(angle) * ring, 1, math.sin(angle) * ring)
			if inAnyPlot(padAt) then
				for k = 1, 30 do
					local found = false
					for _, sgn in ipairs({ 1, -1 }) do
						local a = angle + sgn * k * math.rad(2)
						local p = center + Vector3.new(math.cos(a) * ring, 1, math.sin(a) * ring)
						if not inAnyPlot(p) then
							padAt = p
							found = true
							break
						end
					end
					if found then
						break
					end
				end
			end
			local padSize = if tag == TAG_VEHICLE then 20 else 14
			local p = part({
				Name = name .. i,
				Size = Vector3.new(padSize, 1.2, padSize),
				Position = padAt,
				Color = color,
				Material = Enum.Material.Concrete,
				Parent = folder,
			})
			CollectionService:AddTag(p, tag)
			neonEdge(p, color:Lerp(Color3.new(1, 1, 1), 0.35), 0.35)
			if tag == TAG_VEHICLE then
				part({
					Name = "HMark",
					Size = Vector3.new(6, 0.2, 1),
					Position = padAt + Vector3.new(0, 0.7, 0),
					Color = Color3.fromRGB(200, 220, 255),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
				part({
					Name = "HMark2",
					Size = Vector3.new(1, 0.2, 6),
					Position = padAt + Vector3.new(0, 0.7, 0),
					Color = Color3.fromRGB(200, 220, 255),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
				beacon(folder, padAt, Color3.fromRGB(90, 160, 220), name .. i .. "_Beacon")
				-- v70 (HUD spec §5, mobile P1-11): device-neutral stud-scaled tag (the old card named keys)
				WorldLabel.Create(p, "Garage", { Name = "WE_PadLabel", Color = Color3.fromRGB(200, 220, 255) })
			end
			-- v70: NPC / event spawns carry no debug labels
		end
	end

	-- Rings scaled for ~4800 ground: garage pads spread; more pads for large roster testing
	makeSpawnFolder("VehicleSpawns", TAG_VEHICLE, 10, Vector3.new(0, 0, 0), COL_VEHICLE, 650)
	makeSpawnFolder("NPCSpawns", TAG_NPC, 10, Vector3.new(480, 0, 480), COL_NPC, 550)
	makeSpawnFolder("EventSpawns", TAG_EVENT, 6, Vector3.new(-480, 0, -480), COL_EVENT, 500)

	-- v70 waterways (spec_final §5): Modules.Waterways builds root.CoastalWater (the sea, the ring canal round the map,
	-- rig lagoons, the South Docks harbour, dock channels, sand banks). The old single WaterPlane and the HarborShelf
	-- (a collidable sandbar standing above the old sea surface) are gone. Guarded: without the module the map still
	-- builds (no public water).
	do
		local wwModule = script.Parent:FindFirstChild("Waterways")
		if wwModule and wwModule:IsA("ModuleScript") then
			local okWw, errWw = pcall(function()
				local Waterways = require(wwModule) :: any
				Waterways.Build(root)
			end)
			if not okWw then
				warn("[WAR EMPIRE] MapSetup: Waterways.Build failed (map continues without public water):", errWw)
			end
		else
			warn("[WAR EMPIRE] MapSetup: Modules.Waterways missing — no public water built")
		end
	end

	-- Naval spawn pontoons (WaterConfig.NavalPads: the 9 sea pads + 3 ring landings at road ends). Tagged WE_NavalSpawn
	-- only: a pad in the water must never be picked as a ground-vehicle / jeep spawn.
	do
		local navalFolder = ensureFolder("NavalSpawns", root)
		local padSize = WaterConfig.NavalPadSize
		for i, np in ipairs(WaterConfig.NavalPads) do
			local padAt = Vector3.new(np.X, 1.5, np.Z)
			local pad = part({
				Name = np.Name,
				Size = Vector3.new(padSize, 1.2, padSize),
				Position = padAt,
				Color = Color3.fromRGB(40, 70, 95),
				Material = Enum.Material.Concrete,
				CanCollide = true,
				Parent = navalFolder,
			})
			CollectionService:AddTag(pad, TAG_NAVAL)
			beacon(navalFolder, padAt, Color3.fromRGB(70, 180, 220), "NavalBeacon" .. i)
			-- v70 (HUD spec §5, mobile P1-11): device-neutral stud-scaled tag (the old card named keys)
			WorldLabel.Create(pad, "Naval", { Name = "WE_PadLabel", Color = Color3.fromRGB(160, 220, 255) })
		end
	end

	local npcFolder = ensureFolder("NPCPlaceholders", root)
	for i, spawnPart in ipairs(CollectionService:GetTagged(TAG_NPC)) do
		if i > 4 then
			break
		end
		makeSoldierKit(
			npcFolder,
			"HostileInfantry_" .. i,
			spawnPart.CFrame + Vector3.new(0, 3.2, 0),
			Color3.fromRGB(140, 55, 55),
			"HOSTILE",
			Color3.fromRGB(255, 120, 100),
			80,
			"Infantry",
			"studio_npc_" .. i
		)
	end


	-- Oil rig guards (harder NPC placeholders — visual kits v2 infantry)
	for _, def in ipairs(TERRITORIES) do
		if def.OilRig then
			for gi = 1, 4 do
				local angle = (gi / 4) * math.pi * 2
				local gpos = def.Pos + Vector3.new(math.cos(angle) * 16, 2.6, math.sin(angle) * 16)
				makeSoldierKit(
					npcFolder,
					def.Id .. "_Guard_" .. gi,
					CFrame.new(gpos),
					Color3.fromRGB(110, 70, 35),
					"OIL GUARD",
					Color3.fromRGB(255, 180, 80),
					200,
					"OilRigGuard",
					def.Id .. "_guard_" .. gi
				)
			end
		end
	end

	-- Fort guards
	for _, def in ipairs(TERRITORIES) do
		if def.Fortress then
			for gi = 1, 4 do
				local angle = (gi / 4) * math.pi * 2
				local gpos = def.Pos + Vector3.new(math.cos(angle) * 22, 2.6, math.sin(angle) * 22)
				makeSoldierKit(
					npcFolder,
					def.Id .. "_Guard_" .. gi,
					CFrame.new(gpos),
					Color3.fromRGB(100, 95, 70),
					"FORT GUARD",
					Color3.fromRGB(220, 200, 140),
					170,
					"FortGuard",
					def.Id .. "_guard_" .. gi
				)
			end
		end
	end

	-- Empire Bank (raid stub) — high-value vault + BankGuard NPCs
	local bankFolder = ensureFolder("EmpireBank", root)
	local bankPos = Vector3.new(220, 1, -220) -- matches BankRaidConfig.Position -- matches BankRaidConfig.Position
	local bankPad = part({
		Name = "BankPlaza",
		Size = Vector3.new(36, 1.2, 36),
		Position = bankPos,
		Color = Color3.fromRGB(45, 50, 70),
		Material = Enum.Material.Concrete,
		Parent = bankFolder,
	})
	neonEdge(bankPad, Color3.fromRGB(90, 120, 200), 0.4)
	part({
		Name = "BankBuilding",
		Size = Vector3.new(22, 14, 18),
		Position = bankPos + Vector3.new(0, 7.5, -4),
		Color = Color3.fromRGB(55, 62, 85),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	part({
		Name = "BankRoof",
		Size = Vector3.new(24, 1.2, 20),
		Position = bankPos + Vector3.new(0, 15, -4),
		Color = Color3.fromRGB(40, 45, 60),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	-- Columns + entrance neon (visual kits v2)
	for _, ox in ipairs({ -8, -2.5, 2.5, 8 }) do
		part({
			Name = "BankColumn",
			Size = Vector3.new(1.4, 12, 1.4),
			Position = bankPos + Vector3.new(ox, 6.5, 5.5),
			Color = Color3.fromRGB(70, 78, 100),
			Material = Enum.Material.Marble,
			Parent = bankFolder,
		})
	end
	part({
		Name = "BankDoor",
		Size = Vector3.new(4.5, 6, 0.4),
		Position = bankPos + Vector3.new(0, 3.5, 5.2),
		Color = Color3.fromRGB(30, 35, 50),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	part({
		Name = "BankSign",
		Size = Vector3.new(10, 1.2, 0.4),
		Position = bankPos + Vector3.new(0, 12.5, 5.2),
		Color = Color3.fromRGB(230, 190, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = bankFolder,
	})
	local vault = part({
		Name = "VaultPad",
		Size = Vector3.new(10, 1.4, 10),
		Position = bankPos + Vector3.new(0, 1.2, 8),
		Color = Color3.fromRGB(200, 170, 60),
		Material = Enum.Material.Neon,
		Parent = bankFolder,
	})
	part({
		Name = "VaultRing",
		Size = Vector3.new(12, 0.35, 12),
		Position = bankPos + Vector3.new(0, 1.9, 8),
		Color = Color3.fromRGB(90, 140, 220),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.35,
		Parent = bankFolder,
	})
	vault:SetAttribute("BankId", "EmpireBank")
	CollectionService:AddTag(vault, "WE_BankVault")
	plainBillboard(vault, "EMPIRE BANK · Stand to RAID cash", Vector2.new(280, 40), 8, Color3.fromRGB(255, 220, 120))
	beacon(bankFolder, bankPos + Vector3.new(14, 0, 14), Color3.fromRGB(90, 130, 220), "BankBeacon")
	-- Bank guards spawned live via CombatService.SpawnNPC("BankGuard", cf) in BankRaidService
	-- (static makeSoldierKit props removed — they were Anchored stick figures with double nametags)

	local tutorialFolder = ensureFolder("TutorialMarkers", root)
	local function tutorialMarker(name, pos, color, stepId)
		-- Hidden by default; TutorialController reveals only the active step (no billboard spam).
		-- v70 (HUD spec §5): an anchor only: no tutorial debug billboard and no Neon slab (the tutorial beam and the
		-- highlight are the cue).
		local p = part({
			Name = name,
			Size = Vector3.new(7, 1.2, 7),
			Position = pos,
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 1,
			CanCollide = false,
			Parent = tutorialFolder,
		})
		p:SetAttribute("TutorialStepId", stepId or name)
		CollectionService:AddTag(p, TAG_TUTORIAL)
		-- No beacon / ring clutter — waypoint beam is enough
		return p
	end

	local plot1 = PLOT_POSITIONS[1]
	-- Offsets track Plot1 spawn / structure grid (STRUCT_ORIGIN + gaps); v68: layout consoles when enabled
	local function structureMarkerPos(structureId: string, gridOffset: Vector3): Vector3
		local cf = BaseLayout.ConsoleCFrame(plot1, structureId)
		if cf then
			return cf.Position + Vector3.new(0, 1.4, 0)
		end
		return BaseLayout.PlotPoint(plot1, gridOffset.X, gridOffset.Z, gridOffset.Y)
	end
	local yardAt = Vector3.new(-14, 3, 42)
	local claimAt = Vector3.new(0, 2, 52)
	if BaseLayout.Enabled() then
		local cfg = BaseLayout.Config()
		yardAt = Vector3.new(cfg.Courtyard.TrainingYard.X, 3, cfg.Courtyard.TrainingYard.Z - 6)
		claimAt = Vector3.new(cfg.SpawnOffset.X, 2, cfg.SpawnOffset.Z - 4)
	end
	local atmAt = collectorShift() + Vector3.new(28, 0, 8)
	-- v70: claimAt / yardAt / atmAt are plot-local; BaseLayout.PlotPoint turns them with Plot1 (y relative to the plot)
	local mClaim = tutorialMarker("Tutorial_ClaimBase", BaseLayout.PlotPoint(plot1, claimAt.X, claimAt.Z, claimAt.Y), Color3.fromRGB(230, 200, 80), "ClaimBase")
	local mCC = tutorialMarker("Tutorial_CommandCenter", structureMarkerPos("CommandCenter", STRUCT_ORIGIN + Vector3.new(0, 1.4, 0)), Color3.fromRGB(80, 200, 120), "CommandCenter")
	local mRecruit = tutorialMarker("Tutorial_Recruit", BaseLayout.PlotPoint(plot1, yardAt.X, yardAt.Z, yardAt.Y), Color3.fromRGB(180, 220, 100), "RecruitSoldiers")
	tutorialMarker("Tutorial_Income", BaseLayout.PlotPoint(plot1, atmAt.X, atmAt.Z, atmAt.Y + 3), Color3.fromRGB(80, 200, 160), "Income")
	-- Click dropper sits near ATM (ManualDropper CollectorOffset ≈ -5.5, 0, 4 from collector body)
	tutorialMarker("Tutorial_Dropper", BaseLayout.PlotPoint(plot1, atmAt.X - 5.5, atmAt.Z + 4, atmAt.Y + 2.5), Color3.fromRGB(70, 220, 100), "ClickDropper")
	-- Pads first / beams first 3 beats: dress arrow meshes on early markers
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachTutorialArrow then
				for _, m in ipairs({ mClaim, mCC, mRecruit }) do
					if m then
						vas.TryAttachTutorialArrow(m)
					end
				end
			end
		end)
	end)
	tutorialMarker("Tutorial_Barracks", structureMarkerPos("Barracks", STRUCT_ORIGIN + Vector3.new(STRUCT_GAP, 1.4, 0)), Color3.fromRGB(100, 180, 220), "Barracks")
	local jeepPos = Vector3.new(200, 2, 0)
	-- v70: the first garage pad on LAND (a WE_NavalSpawn pontoon is in the water; the marker used to land on
	-- NavalPad_1 in the sea)
	for _, vs in ipairs(CollectionService:GetTagged(TAG_VEHICLE)) do
		if vs:IsA("BasePart") and not CollectionService:HasTag(vs, TAG_NAVAL) then
			jeepPos = vs.Position + Vector3.new(0, 2, 0)
			break
		end
	end
	tutorialMarker("Tutorial_Jeep", jeepPos, Color3.fromRGB(120, 140, 200), "Jeep")
	tutorialMarker("Tutorial_Outpost", Vector3.new(0, 3, 0), Color3.fromRGB(200, 120, 80), "Outpost")

	-- v68: the always-on neon guide beams (collector → Command Center → Vehicle Depot) are gone: at the 320-stud
	-- layout they were long glowing lines cutting across the whole base. TutorialController draws one subtle
	-- guide to the current step only, while the tutorial runs.

	-- Military world dressing (visual only). Does not tag WE_UpgradeSlot / buy pads.
	-- PERF: skip MapDressing entirely in Studio unless ForceDress (attribute or DevConfig).
	-- Stagger after first frame so Play Solo is usable in seconds on laptop CPUs.
	task.defer(function()
		task.wait() -- yield past first frame
		local forceAttr = root:GetAttribute("ForceDress") == true
			or (Workspace:GetAttribute("ForceDress") == true)
		local forceDress = forceAttr or (DevConfig.StudioForceDress == true)
		local inStudio = RunService:IsStudio()
		local skipDress = inStudio and (DevConfig.StudioSkipWorldDressing ~= false) and not forceDress
		-- Live / non-Studio: Full warzone dressing. Studio ForceDress uses DevConfig quality.
		local quality = if (not inStudio) then "Full" else tostring(DevConfig.WorldDressQuality or "Low")

		print("[WAR EMPIRE] PERF note: deco kits use CastShadow=false. Studio Rendering → disable shadows / lower quality if still slow.")
		if skipDress then
			print("[WAR EMPIRE] PERF: MapDressing SKIPPED in Studio (StudioSkipWorldDressing). Set Workspace.WarEmpireSetup.ForceDress=true or DevConfig.StudioForceDress=true then resetmap to load dressing.")
		else
			task.wait(0.05)
			local okDress, errDress = pcall(function()
				MapDressing.Dress(root, { Quality = quality })
			end)
			if not okDress then
				warn("[WAR EMPIRE] MapDressing failed:", errDress)
			end
		end

		task.wait(0.1)
		-- Live: Full flora (align MapDressing live Full). Studio: sparse unless StudioSparseFlora=false.
		local wantFullFlora = (not inStudio)
			or (inStudio and DevConfig.StudioSparseFlora == false)
		local sparseFlora = not wantFullFlora
		local okFlora, errFlora = pcall(function()
			DesertFlora.Dress(root, { Sparse = sparseFlora })
		end)
		if not okFlora then
			warn("[WAR EMPIRE] DesertFlora failed:", errFlora)
		end
	end)

	-- Guarantee at least one Neutral Duration=0 spawn near origin
	local hasNeutralSpawn = false
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("SpawnLocation") and inst.Neutral and inst.Duration == 0 then
			hasNeutralSpawn = true
			break
		end
	end
	if not hasNeutralSpawn then
		local fallbackSpawn = Instance.new("SpawnLocation")
		fallbackSpawn.Name = "NeutralSpawn"
		fallbackSpawn.Size = Vector3.new(12, 1, 12)
		fallbackSpawn.Position = Vector3.new(0, 5, 0)
		fallbackSpawn.Anchored = true
		fallbackSpawn.CanCollide = true
		fallbackSpawn.Neutral = true
		fallbackSpawn.Duration = 0
		fallbackSpawn.BrickColor = BrickColor.new("Bright green")
		fallbackSpawn.Material = Enum.Material.Neon
		fallbackSpawn.Parent = root
		print("[WAR EMPIRE] MapSetup: added fallback NeutralSpawn at (0,5,0)")
	end

		buildPadSupportShelves(root)

	-- Tier 2: near-plot oil spectacle (IndustrialPack + pipes + barrel ring). REJECT Ultrapump.
	do
		local okOil, errOil = pcall(function()
			local oilFolder = Instance.new("Folder")
			oilFolder.Name = "OilSpectacle"
			oilFolder.Parent = root
			local pads = {
				Vector3.new(-520, 0.5, -180),
				Vector3.new(520, 0.5, 180),
				Vector3.new(-200, 0.5, 620),
			}
			for oi, oilAt in ipairs(pads) do
				local pad = part({
					Name = "OilPad" .. oi,
					Size = Vector3.new(28, 0.6, 28),
					Position = oilAt,
					Color = Color3.fromRGB(42, 44, 40),
					Material = Enum.Material.Asphalt,
					CanCollide = true,
					Parent = oilFolder,
				})
				plainBillboard(pad, "OIL FIELD", Vector2.new(160, 32), 12, Color3.fromRGB(255, 180, 60))
				-- Amber landmark light
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 160, 40)
				light.Brightness = 1.2
				light.Range = 40
				light.Parent = pad
				-- Walking-beam silhouette (Part kit derrick)
				local tower = part({
					Name = "DerrickTower" .. oi,
					Size = Vector3.new(1.2, 18, 1.2),
					Position = oilAt + Vector3.new(0, 9.5, 0),
					Color = Color3.fromRGB(70, 72, 68),
					Material = Enum.Material.Metal,
					CanCollide = false,
					Parent = oilFolder,
				})
				local beam = part({
					Name = "WalkingBeam" .. oi,
					Size = Vector3.new(14, 0.7, 0.7),
					Position = oilAt + Vector3.new(0, 17, 0),
					Color = Color3.fromRGB(90, 70, 50),
					Material = Enum.Material.Metal,
					CanCollide = false,
					Parent = oilFolder,
				})
				beam:SetAttribute("WE_OilBeam", true)
				-- Barrel ring
				for bi = 1, 8 do
					local ang = (bi / 8) * math.pi * 2
					local bpos = oilAt + Vector3.new(math.cos(ang) * 9, 1.1, math.sin(ang) * 9)
					part({
						Name = "OilBarrel" .. oi .. "_" .. bi,
						Size = Vector3.new(1.6, 2.2, 1.6),
						Position = bpos,
						Color = Color3.fromRGB(45, 70, 45),
						Material = Enum.Material.Metal,
						Shape = Enum.PartType.Cylinder,
						CanCollide = true,
						Parent = oilFolder,
					})
				end
				-- Catalog dress (IndustrialPack / RustyPipes / OilBarrel)
				task.defer(function()
					pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if not vas then
							return
						end
						vas.TryAttachPropVisual(tower, "IndustrialPack")
						vas.TryAttachPropVisual(beam, "RustyPipes")
						for _, ch in ipairs(oilFolder:GetChildren()) do
							if ch:IsA("BasePart") and string.find(ch.Name, "OilBarrel" .. oi, 1, true) then
								vas.TryAttachPropVisual(ch, "OilBarrel")
							end
						end
					end)
				end)
			end
			-- Slow walking-beam sway
			task.spawn(function()
				local t0 = os.clock()
				while oilFolder.Parent do
					local t = os.clock() - t0
					for _, ch in ipairs(oilFolder:GetChildren()) do
						if ch:IsA("BasePart") and ch:GetAttribute("WE_OilBeam") then
							ch.CFrame = CFrame.new(ch.Position) * CFrame.Angles(0, 0, math.rad(math.sin(t * 0.7) * 12))
						end
					end
					task.wait(0.1)
				end
			end)
		end)
		if not okOil then
			warn("[MapSetup] OilSpectacle failed:", errOil)
		end
	end

	-- Tier 2: warzone landmarks (RadioTower / SmallFort / Bunker)
	do
		local okLm, errLm = pcall(function()
			local lm = Instance.new("Folder")
			lm.Name = "WarzoneLandmarks"
			lm.Parent = root
			local spots = {
				{ Name = "RadioTower", Key = "RadioTower", Pos = Vector3.new(0, 0.5, -1400), Size = Vector3.new(4, 28, 4) },
				{ Name = "SmallFort", Key = "SmallFort", Pos = Vector3.new(1100, 0.5, -1100), Size = Vector3.new(18, 10, 18) },
				{ Name = "BunkerApproach", Key = "Bunker", Pos = Vector3.new(-1100, 0.5, 900), Size = Vector3.new(14, 6, 14) },
			}
			for _, s in ipairs(spots) do
				local host = part({
					Name = s.Name .. "Host",
					Size = s.Size,
					Position = s.Pos + Vector3.new(0, s.Size.Y * 0.5, 0),
					Color = Color3.fromRGB(80, 78, 70),
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Transparency = 0.25,
					Parent = lm,
				})
				plainBillboard(host, string.upper(s.Name), Vector2.new(180, 32), 14, Color3.fromRGB(220, 200, 140))
				task.defer(function()
					pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if vas and vas.TryAttachPropVisual then
							vas.TryAttachPropVisual(host, s.Key)
						end
					end)
				end)
			end
		end)
		if not okLm then
			warn("[MapSetup] WarzoneLandmarks failed:", errLm)
		end
	end


	-- v70: stamp the layout generation last (a Run that threw part-way stays unstamped → Bootstrap rebuilds it)
	root:SetAttribute("WE_MapGen", MapSetup.MAP_GEN)

	print("[WAR EMPIRE] MapSetup complete: desert ground=" .. tostring(GROUND_SIZE) .. "x" .. tostring(GROUND_THICKNESS) .. " topY=" .. tostring(GROUND_TOP_Y) .. " mesas=" .. tostring(DevConfig.MountainRingSegments or 14) .. " (dressing deferred/Studio-skip)")
	print("[WAR EMPIRE] MapSetup confirmation: Gravity=" .. tostring(Workspace.Gravity) .. " WarEmpireSetup children=" .. tostring(#root:GetChildren()))
	print("[WAR EMPIRE] Walk onto upgrade pads to BUY (auto). E opens Base/Garage menus. Delete WarEmpireSetup + Play / admin resetmap to regenerate.")
end

return MapSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Default player profile + migrations.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"))
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local Types = require(Shared:WaitForChild("Types"))

type PlayerProfile = Types.PlayerProfile

local ProfileSchema = {}

local function emptyUpgrades(): { [string]: number }
	local upgrades: { [string]: number } = {}
	for id in pairs(BaseConfig.Structures) do
		upgrades[id] = 0
	end
	return upgrades
end

local function emptyDailyMissions(): Types.DailyMissionProgress
	return {
		DayKey = 0,
		Progress = {},
		Claimed = {},
		ActiveTimed = {},
	}
end

-- v71 money (M2) ─────────────────────────────────────────────────────────────────────────────────────────────
-- New profile blocks for the nuke, premium vehicles, rebirth expansion, the Offer Director and purchase accounting.
-- Default-filled and sanitised on every Migrate (idempotent), with no DataVersion bump, the same way as v69
-- Research / Raid. Nothing reads them yet. PrestigeService.DoPrestige resets only the fields it names, so rebirth
-- keeps all of these.
local NUKE_KINDS: { [string]: boolean } = { Nuke = true, TacticalNuke = true }
local NUKE_STAT_KEYS = { "Bought", "Launched", "PlayerKills", "NpcKills", "BestKills" }
local OFFER_STAT_KEYS = { "Shown", "LastShownUnix", "Clicked", "Dismissed" }
local MONETIZATION_KEYS = { "FirstPurchaseUnix", "LastPurchaseUnix", "Purchases", "RobuxSpent" }
local MAX_COUNTER = 1e15 -- keeps junk like 1e308 out of the save; far above any real count / os.time()

-- Whole number >= 0; junk (nil, strings, NaN, inf, negatives) becomes 0.
local function nonNegInt(value: any): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return math.clamp(math.floor(n), 0, MAX_COUNTER)
end

local function sanitizeCounters(t: any, keys: { string }): { [string]: number }
	local out: { [string]: number } = if typeof(t) == "table" then t else {}
	for _, k in ipairs(keys) do
		local v = out[k]
		local clean = nonNegInt(v)
		if v ~= clean then
			out[k] = clean
		end
	end
	return out
end

local function defaultNukeStats()
	return { Bought = 0, Launched = 0, PlayerKills = 0, NpcKills = 0, BestKills = 0 }
end

local function defaultMonetization()
	return { FirstPurchaseUnix = 0, LastPurchaseUnix = 0, Purchases = 0, RobuxSpent = 0 }
end

local function ensureMoneyFields(profile: any)
	-- Nuke inventory (paid Nukes are granted only in ProcessReceipt) and the launch refund marker
	profile.Nukes = nonNegInt(profile.Nukes)
	profile.TacticalNukes = nonNegInt(profile.TacticalNukes)
	local inFlight = profile.NukeInFlight
	if inFlight ~= nil then
		if
			typeof(inFlight) ~= "table"
			or typeof(inFlight.Kind) ~= "string"
			or NUKE_KINDS[inFlight.Kind] ~= true
		then
			profile.NukeInFlight = nil
		else
			if typeof(inFlight.LaunchId) ~= "string" then
				inFlight.LaunchId = tostring(inFlight.LaunchId or "")
			end
			local at = nonNegInt(inFlight.At)
			if inFlight.At ~= at then
				inFlight.At = at
			end
		end
	end
	if typeof(profile.NukeGiftGranted) ~= "boolean" then
		profile.NukeGiftGranted = false
	end
	profile.NukeStats = sanitizeCounters(profile.NukeStats, NUKE_STAT_KEYS)
	profile.Silo = sanitizeCounters(profile.Silo, { "ProgressSeconds" })

	-- Premium vehicles: chosen camo per vehicle, last free test drive per vehicle
	local camo = if typeof(profile.PremiumVehicleCamo) == "table" then profile.PremiumVehicleCamo else {}
	for k, v in pairs(camo) do
		if typeof(k) ~= "string" or typeof(v) ~= "string" then
			camo[k] = nil
		end
	end
	profile.PremiumVehicleCamo = camo
	local trials = if typeof(profile.PremiumTrials) == "table" then profile.PremiumTrials else {}
	for k, v in pairs(trials) do
		if typeof(k) ~= "string" then
			trials[k] = nil
		else
			local clean = nonNegInt(v)
			if v ~= clean then
				trials[k] = clean
			end
		end
	end
	profile.PremiumTrials = trials

	-- Rebirth expansion (the Expansion Permit / Rebirth Skip counters were cut, J12)
	local rebirth = if typeof(profile.Rebirth) == "table" then profile.Rebirth else {}
	local seen = if typeof(rebirth.ZonesSeen) == "table" then rebirth.ZonesSeen else {}
	for k, v in pairs(seen) do
		if typeof(k) ~= "string" or v ~= true then
			seen[k] = nil
		end
	end
	rebirth.ZonesSeen = seen
	local lastRebirth = nonNegInt(rebirth.LastRebirthUnix)
	if rebirth.LastRebirthUnix ~= lastRebirth then
		rebirth.LastRebirthUnix = lastRebirth
	end
	profile.Rebirth = rebirth

	-- Offer Director cadence (offer key -> counters) and purchase accounting (analytics only)
	local offers = if typeof(profile.Offers) == "table" then profile.Offers else {}
	for k, v in pairs(offers) do
		if typeof(k) ~= "string" or typeof(v) ~= "table" then
			offers[k] = nil
		else
			sanitizeCounters(v, OFFER_STAT_KEYS)
		end
	end
	profile.Offers = offers
	profile.Monetization = sanitizeCounters(profile.Monetization, MONETIZATION_KEYS)

	-- M8: purchase ticker opt-out (default on) and the daily VIP supply stamp
	if typeof(profile.AnnouncePurchases) ~= "boolean" then
		profile.AnnouncePurchases = true
	end
	profile.VipSupplyAt = nonNegInt(profile.VipSupplyAt)
end

function ProfileSchema.CreateDefault(): PlayerProfile
	local now = os.time()
	return {
		DataVersion = Constants.CURRENT_DATA_VERSION,
		Cash = EconomyConfig.StartingCash,
		PendingCash = 0,
		Gold = EconomyConfig.StartingGold,
		Level = 1,
		XP = 0,
		Prestige = 0,
		RebirthUnlocks = {},
		Soldiers = SoldierConfig.StartingSoldiers,
		NationColorId = nil,
		RedeemedCodes = {},
		LastSpinnerClaimUnix = 0,
		Vehicles = {
			[VehicleConfig.StarterVehicle] = true,
		},
		Weapons = {
			[WeaponConfig.DefaultWeapon] = true,
		},
		EquippedWeapon = WeaponConfig.DefaultWeapon,
		Territories = {},
		BaseUpgrades = emptyUpgrades(),
		BasePlotId = nil,
		TutorialStep = 0,
		TutorialComplete = false,
		DailyLogin = {
			LastClaimDay = 0,
			Streak = 0,
			LastClaimUnix = 0,
		},
		DailyMissions = emptyDailyMissions(),
		Settings = {
			MusicVolume = 0.7,
			SFXVolume = 0.8,
			ShowDamageNumbers = true,
			AutoSprint = true,
		},
		Stats = {
			TotalCashEarned = 0,
			TotalGoldEarned = 0,
			UpgradesPurchased = 0,
			VehiclesSpawned = 0,
			MissionsCompleted = 0,
			TerritoriesCaptured = 0,
			Kills = 0,
			Deaths = 0,
			PlayTimeSeconds = 0,
		},
		Achievements = {},
		BattlePass = {
			SeasonId = SeasonConfig.CurrentSeasonId,
			XP = 0,
			Level = 0,
			Premium = false,
			ClaimedFree = {},
			ClaimedPremium = {},
		},
		ClanId = nil,
		FirstJoinUnix = now,
		LastJoinUnix = now,
		ProcessedReceipts = {},
		Entitlements = {},
		OutpostIncomeStacks = 0,
		StarterBundleOffered = false,
		AutoCollectOffered = false,
		DoubleCashOffered = false,
		VIPOffered = false,
		SpeedBoostOffered = false,
		CashMegaOffered = false,
		-- v69: Research Lab upgrades (UpgradeId → level) and raid / missile-strike timers (os.time seconds)
		Research = {},
		Raid = { ShieldUntil = 0, StrikeCooldownUntil = 0, DefensesDownUntil = 0 },
		-- v71 money (M2): see ensureMoneyFields (Migrate fills the same defaults into older saves)
		Nukes = 0,
		TacticalNukes = 0,
		NukeInFlight = nil,
		NukeGiftGranted = false,
		NukeStats = defaultNukeStats(),
		Silo = { ProgressSeconds = 0 },
		PremiumVehicleCamo = {},
		PremiumTrials = {},
		Rebirth = { ZonesSeen = {}, LastRebirthUnix = 0 },
		Offers = {},
		Monetization = defaultMonetization(),
		AnnouncePurchases = true,
		VipSupplyAt = 0,
	}
end

--[[
	Migrate older profiles to CURRENT_DATA_VERSION.
	Add new migration steps as DataVersion increments.
]]
function ProfileSchema.Migrate(data: any): PlayerProfile
	if typeof(data) ~= "table" then
		return ProfileSchema.CreateDefault()
	end

	local profile = data :: PlayerProfile
	local version = tonumber(profile.DataVersion) or 0

	-- v0 / missing → fill defaults then set version
	if version < 1 then
		local defaults = ProfileSchema.CreateDefault()
		for key, value in pairs(defaults) do
			if profile[key] == nil then
				(profile :: any)[key] = value
			end
		end
		-- Ensure nested tables
		if typeof(profile.BaseUpgrades) ~= "table" then
			profile.BaseUpgrades = emptyUpgrades()
		else
			for id in pairs(BaseConfig.Structures) do
				if profile.BaseUpgrades[id] == nil then
					profile.BaseUpgrades[id] = 0
				end
			end
		end
		if typeof(profile.Vehicles) ~= "table" then
			profile.Vehicles = { [VehicleConfig.StarterVehicle] = true }
		elseif not profile.Vehicles[VehicleConfig.StarterVehicle] then
			profile.Vehicles[VehicleConfig.StarterVehicle] = true
		end
		if typeof(profile.Weapons) ~= "table" then
			profile.Weapons = { [WeaponConfig.DefaultWeapon] = true }
		elseif not profile.Weapons[WeaponConfig.DefaultWeapon] then
			profile.Weapons[WeaponConfig.DefaultWeapon] = true
		end
		profile.DataVersion = 1
		version = 1
	end

	-- v1 → v2: DailyMissions progress table
	if version < 2 then
		if typeof((profile :: any).DailyMissions) ~= "table" then
			(profile :: any).DailyMissions = emptyDailyMissions()
		else
			local dm = (profile :: any).DailyMissions
			if typeof(dm.Progress) ~= "table" then
				dm.Progress = {}
			end
			if typeof(dm.Claimed) ~= "table" then
				dm.Claimed = {}
			end
			if typeof(dm.ActiveTimed) ~= "table" then
				dm.ActiveTimed = {}
			end
			if typeof(dm.DayKey) ~= "number" then
				dm.DayKey = 0
			end
		end
		if typeof(profile.Achievements) ~= "table" then
			profile.Achievements = {}
		end
		if typeof(profile.Territories) ~= "table" then
			profile.Territories = {}
		end
		profile.DataVersion = 2
		version = 2
	end


	-- v2 → v3: ensure clan / season / battle pass / soldier / war-adjacent fields for older saves
	if version < 3 then
		if typeof(profile.Prestige) ~= "number" then
			profile.Prestige = 0
		end
		if typeof(profile.Soldiers) ~= "number" then
			profile.Soldiers = SoldierConfig.StartingSoldiers or 0
		end
		if profile.ClanId ~= nil and typeof(profile.ClanId) ~= "string" then
			profile.ClanId = nil
		end
		if typeof(profile.BattlePass) ~= "table" then
			profile.BattlePass = {
				SeasonId = SeasonConfig.CurrentSeasonId,
				XP = 0,
				Level = 0,
				Premium = false,
				ClaimedFree = {},
				ClaimedPremium = {},
			}
		else
			local bp = profile.BattlePass
			if typeof(bp.SeasonId) ~= "string" then
				bp.SeasonId = SeasonConfig.CurrentSeasonId
			end
			if typeof(bp.XP) ~= "number" then
				bp.XP = 0
			end
			if typeof(bp.Level) ~= "number" then
				bp.Level = 0
			end
			if typeof(bp.Premium) ~= "boolean" then
				bp.Premium = false
			end
			if typeof(bp.ClaimedFree) ~= "table" then
				bp.ClaimedFree = {}
			end
			if typeof(bp.ClaimedPremium) ~= "table" then
				bp.ClaimedPremium = {}
			end
		end
		if typeof(profile.Stats) == "table" then
			if typeof(profile.Stats.TerritoriesCaptured) ~= "number" then
				profile.Stats.TerritoriesCaptured = 0
			end
			if typeof(profile.Stats.Kills) ~= "number" then
				profile.Stats.Kills = 0
			end
			if typeof(profile.Stats.Deaths) ~= "number" then
				profile.Stats.Deaths = 0
			end
		end
		if typeof(profile.Territories) ~= "table" then
			profile.Territories = {}
		end
		if typeof(profile.Achievements) ~= "table" then
			profile.Achievements = {}
		end
		profile.DataVersion = 3
		version = 3
	end

	-- v3 → v4: nation color + redeemed codes (MT-inspired systems)
	if version < 4 then
		if profile.NationColorId ~= nil and typeof(profile.NationColorId) ~= "string" then
			profile.NationColorId = nil
		end
		if typeof(profile.RedeemedCodes) ~= "table" then
			profile.RedeemedCodes = {}
		end
		profile.DataVersion = 4
		version = 4
	end

	-- v4 → v5: free supply spinner cooldown stamp
	if version < 5 then
		if typeof((profile :: any).LastSpinnerClaimUnix) ~= "number" then
			(profile :: any).LastSpinnerClaimUnix = 0
		end
		profile.DataVersion = 5
		version = 5
	end


	-- v5 → v6: rebirth unlock flags (prestige track)
	if version < 6 then
		if typeof((profile :: any).RebirthUnlocks) ~= "table" then
			(profile :: any).RebirthUnlocks = {}
		end
		profile.DataVersion = 6
		version = 6
	end


	-- v6 → v7: Money Collector pending cash + entitlements flags
	if version < 7 then
		if typeof((profile :: any).PendingCash) ~= "number" then
			(profile :: any).PendingCash = 0
		end
		if typeof((profile :: any).Entitlements) ~= "table" then
			(profile :: any).Entitlements = {}
		end
		profile.DataVersion = 7
		version = 7
	end


	-- v7 → v8: permanent outpost income buff stacks
	if version < 8 then
		if typeof((profile :: any).OutpostIncomeStacks) ~= "number" then
			(profile :: any).OutpostIncomeStacks = 0
		end
		profile.DataVersion = 8
		version = 8
	end

	if typeof((profile :: any).ProcessedReceipts) ~= "table" then
		(profile :: any).ProcessedReceipts = {}
	end
	do
		local cashN = tonumber((profile :: any).Cash)
		profile.Cash = if typeof(cashN) == "number" then math.floor(cashN) else EconomyConfig.StartingCash
		local goldN = tonumber((profile :: any).Gold)
		profile.Gold = if typeof(goldN) == "number" then math.floor(goldN) else EconomyConfig.StartingGold
	end
	if typeof((profile :: any).PendingCash) ~= "number" then
		local pendN = tonumber((profile :: any).PendingCash)
		;(profile :: any).PendingCash = if typeof(pendN) == "number" then math.floor(pendN) else 0
	end
	if typeof((profile :: any).Entitlements) ~= "table" then
		(profile :: any).Entitlements = {}
	end
	if typeof((profile :: any).OutpostIncomeStacks) ~= "number" then
		(profile :: any).OutpostIncomeStacks = 0
	end
	if (profile :: any).StarterBundleOffered == nil then
		(profile :: any).StarterBundleOffered = false
	end
	if (profile :: any).AutoCollectOffered == nil then
		(profile :: any).AutoCollectOffered = false
	end
	if (profile :: any).DoubleCashOffered == nil then
		(profile :: any).DoubleCashOffered = false
	end
	if (profile :: any).VIPOffered == nil then
		(profile :: any).VIPOffered = false
	end
	if (profile :: any).SpeedBoostOffered == nil then
		(profile :: any).SpeedBoostOffered = false
	end
	if (profile :: any).CashMegaOffered == nil then
		(profile :: any).CashMegaOffered = false
	end
	-- v69: Research levels + raid / strike timers (idempotent; no DataVersion bump needed for new tables)
	if typeof((profile :: any).Research) ~= "table" then
		(profile :: any).Research = {}
	end
	do
		local raid = (profile :: any).Raid
		if typeof(raid) ~= "table" then
			raid = {}
			;(profile :: any).Raid = raid
		end
		for _, k in ipairs({ "ShieldUntil", "StrikeCooldownUntil", "DefensesDownUntil" }) do
			if typeof(raid[k]) ~= "number" then
				raid[k] = 0
			end
		end
	end
	-- v71 money (M2): nuke / premium vehicle / rebirth / offer / accounting blocks (idempotent; no version bump)
	ensureMoneyFields(profile)

	-- v64: always ensure nested tables (corrupt DS / partial migrate must not nil-index on buy)
	if typeof(profile.BaseUpgrades) ~= "table" then
		profile.BaseUpgrades = emptyUpgrades()
	else
		for id in pairs(BaseConfig.Structures) do
			if profile.BaseUpgrades[id] == nil then
				profile.BaseUpgrades[id] = 0
			end
		end
	end
	if typeof(profile.Stats) ~= "table" then
		profile.Stats = {
			TotalCashEarned = 0,
			TotalGoldEarned = 0,
			UpgradesPurchased = 0,
			VehiclesSpawned = 0,
			MissionsCompleted = 0,
			TerritoriesCaptured = 0,
			Kills = 0,
			Deaths = 0,
			PlayTimeSeconds = 0,
		}
	else
		if typeof(profile.Stats.UpgradesPurchased) ~= "number" then
			profile.Stats.UpgradesPurchased = math.floor(tonumber(profile.Stats.UpgradesPurchased) or 0)
		end
	end

	profile.DataVersion = Constants.CURRENT_DATA_VERSION
	return profile
end

function ProfileSchema.DeepCopy(profile: PlayerProfile): PlayerProfile
	-- Simple recursive copy sufficient for our schema
	local function copy(v: any): any
		if typeof(v) ~= "table" then
			return v
		end
		local t = {}
		for k, val in pairs(v) do
			t[k] = copy(val)
		end
		return t
	end
	return copy(profile) :: PlayerProfile
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">RemoteGuard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shared client→server remote argument guards.
	Use with RateLimitService + DataService.GetProfile — never trust client types/ranges.
]]

local RemoteGuard = {}

local DEFAULT_ID_MAX = 64
local DEFAULT_KEY_MAX = 48
local DEFAULT_CMD_MAX = 32

function RemoteGuard.IsFiniteNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

--[[ Non-empty string within max length (ids, keys, mission ids). ]]
function RemoteGuard.IsIdString(value: any, maxLen: number?): boolean
	if typeof(value) ~= "string" then
		return false
	end
	local s = value :: string
	if s == "" then
		return false
	end
	local max = maxLen or DEFAULT_ID_MAX
	return #s <= max
end

function RemoteGuard.IsKeyString(value: any, maxLen: number?): boolean
	return RemoteGuard.IsIdString(value, maxLen or DEFAULT_KEY_MAX)
end

function RemoteGuard.IsCommandString(value: any, maxLen: number?): boolean
	return RemoteGuard.IsIdString(value, maxLen or DEFAULT_CMD_MAX)
end

--[[ Floor + clamp to [minN, maxN]; nil if not a finite number. ]]
function RemoteGuard.ClampInt(value: any, minN: number, maxN: number): number?
	if not RemoteGuard.IsFiniteNumber(value) then
		return nil
	end
	local n = math.floor(value :: number)
	if n < minN or n > maxN then
		return nil
	end
	return n
end

function RemoteGuard.ClampPositiveInt(value: any, maxN: number): number?
	return RemoteGuard.ClampInt(value, 1, maxN)
end

--[[ Profile must be loaded before mutating economy / progression. ]]
function RemoteGuard.RequireProfile(dataService: any, player: Player): any?
	if not dataService or not dataService.GetProfile then
		return nil
	end
	return dataService.GetProfile(player)
end

return RemoteGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">RemoteSetup</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Creates remotes under ReplicatedStorage.WE_Remotes (server-only).
	v62: RequestPurchaseUpgrade OnServerEvent is hooked HERE at create-time so the
	exact same instance client FireServer hits is always listened — BaseService
	registers the handler via SetPurchaseUpgradeHandler (never a second remote).
	v71 money (M2): UNRELIABLE lists UnreliableRemoteEvents (cosmetic, high-rate Fx that may be dropped). They are
	NOT RemoteEvents (both extend BaseRemoteEvent): the server uses RemoteSetup.GetUnreliable, the client
	Remotes.GetUnreliableEvent / TryGetUnreliableEvent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local RemoteSetup = {}

local EVENTS = {
	-- Server pushes
	Constants.RemoteNames.PlayerStateUpdate,
	Constants.RemoteNames.BaseStateUpdate,
	Constants.RemoteNames.Notification,
	Constants.RemoteNames.EconomyUpdate,
	Constants.RemoteNames.XPUpdate,
	Constants.RemoteNames.CombatStateUpdate,
	Constants.RemoteNames.CombatHitFeedback,
	Constants.RemoteNames.VehicleStateUpdate,
	Constants.RemoteNames.TerritoryStateUpdate,
	Constants.RemoteNames.MissionStateUpdate,
	-- Client requests
	Constants.RemoteNames.RequestPurchaseUpgrade,
	Constants.RemoteNames.PurchaseResult,
	Constants.RemoteNames.RequestClaimDailyReward,
	Constants.RemoteNames.RequestSpawnVehicle,
	Constants.RemoteNames.RequestPurchaseVehicle,
	Constants.RemoteNames.RequestDespawnVehicle,
	Constants.RemoteNames.RequestEquipWeapon,
	Constants.RemoteNames.RequestPurchaseWeapon,
	Constants.RemoteNames.RequestFire,
	Constants.RemoteNames.RequestReload,
	Constants.RemoteNames.RequestStartMission,
	Constants.RemoteNames.RequestClaimMission,
	Constants.RemoteNames.RequestCaptureTerritory,
	Constants.RemoteNames.RequestAdminCommand,
	Constants.RemoteNames.RequestPurchaseDevProduct,
	Constants.RemoteNames.RequestPurchaseGamePass,
	Constants.RemoteNames.RequestSkipTutorial,
	Constants.RemoteNames.TutorialStateUpdate,
	Constants.RemoteNames.RequestPrestige,
	Constants.RemoteNames.PrestigeStateUpdate,
	Constants.RemoteNames.RequestCreateClan,
	Constants.RemoteNames.RequestJoinClan,
	Constants.RemoteNames.RequestLeaveClan,
	Constants.RemoteNames.ClanStateUpdate,
	Constants.RemoteNames.RequestClaimBattlePassReward,
	Constants.RemoteNames.BattlePassStateUpdate,
	Constants.RemoteNames.RequestRecruitSoldiers,
	Constants.RemoteNames.RequestDismissSoldiers,
	Constants.RemoteNames.SoldierStateUpdate,
	Constants.RemoteNames.RequestSquadOrder,
	Constants.RemoteNames.SquadOrderStateUpdate,
	Constants.RemoteNames.SeasonStateUpdate,
	Constants.RemoteNames.RequestDeclareClanWar,
	Constants.RemoteNames.ClanWarStateUpdate,
	Constants.RemoteNames.RequestRedeemCode,
	Constants.RemoteNames.CodeStateUpdate,
	Constants.RemoteNames.NationColorUpdate,
	Constants.RemoteNames.RequestClaimSpinner,
	Constants.RemoteNames.SpinnerStateUpdate,
	Constants.RemoteNames.BankRaidStateUpdate,
	Constants.RemoteNames.StudioSmokeLog,
	Constants.RemoteNames.DeathShopOffer,
	Constants.RemoteNames.StarterBundleOffer,
	Constants.RemoteNames.AutoCollectOffer,
	Constants.RemoteNames.DoubleCashOffer,
	Constants.RemoteNames.VIPOffer,
	Constants.RemoteNames.SpeedBoostOffer,
	Constants.RemoteNames.CashMegaOffer,
	Constants.RemoteNames.AtmRaidStateUpdate,
	Constants.RemoteNames.PromptPremiumPad,
	Constants.RemoteNames.RequestResearch,
	Constants.RemoteNames.ResearchStateUpdate,
	Constants.RemoteNames.RequestMissileStrike,
	Constants.RemoteNames.MissileStrikeStateUpdate,
	Constants.RemoteNames.MissileStrikeFx,
	Constants.RemoteNames.VehicleDriveInput,
	-- v71 money (M2): created now for the nuke / premium vehicle / rebirth / offer workflows (unused until they land)
	Constants.RemoteNames.RequestNukeLaunch,
	Constants.RemoteNames.RequestNukeState,
	Constants.RemoteNames.NukeStateUpdate,
	Constants.RemoteNames.NukeFx,
	Constants.RemoteNames.RequestVehicleFire,
	Constants.RemoteNames.RequestVehicleCamo,
	Constants.RemoteNames.RequestPremiumTrial,
	Constants.RemoteNames.RebirthStateUpdate,
	Constants.RemoteNames.RequestRebirthState,
	Constants.RemoteNames.ArtilleryFx,
	Constants.RemoteNames.DroneCrateFx,
	Constants.RemoteNames.OfferShow,
	Constants.RemoteNames.OfferResult,
	Constants.RemoteNames.PurchaseAnnounce,
	Constants.RemoteNames.ShortfallChip,
}

-- v71 money (M2): UnreliableRemoteEvents (server → client cosmetic Fx; ordering and delivery not guaranteed)
local UNRELIABLE = {
	Constants.RemoteNames.VehicleWeaponFx,
}
local UNRELIABLE_SET: { [string]: boolean } = {}
for _, name in ipairs(UNRELIABLE) do
	UNRELIABLE_SET[name] = true
end

local FUNCTIONS = {
	Constants.RemoteNames.GetPlayerState,
}

local _initialized = false
local _purchaseHandler: ((Player, any) -> ())? = nil
local _purchaseHooked = false
local _purchaseHookedInstance: RemoteEvent? = nil

function RemoteSetup.SetPurchaseUpgradeHandler(handler: (Player, any) -> ())
	_purchaseHandler = handler
	print("[RemoteSetup] PurchaseUpgrade handler registered")
end

local function ensurePurchaseHook(folder: Folder)
	local name = Constants.RemoteNames.RequestPurchaseUpgrade
	local ev = folder:FindFirstChild(name)
	if not ev then
		ev = Instance.new("RemoteEvent")
		ev.Name = name
		ev.Parent = folder
	end
	-- v63: re-hook if prior RemoteEvent was destroyed / replaced (never sticky forever)
	if _purchaseHooked then
		local hooked = _purchaseHookedInstance
		if hooked and hooked.Parent and hooked == ev then
			return
		end
		warn("[RemoteSetup] RequestPurchaseUpgrade instance changed — re-hooking OnServerEvent")
		_purchaseHooked = false
		_purchaseHookedInstance = nil
	end
	if not ev:IsA("RemoteEvent") then
		warn("[RemoteSetup] RequestPurchaseUpgrade is not RemoteEvent:", ev.ClassName)
		return
	end
	_purchaseHooked = true
	_purchaseHookedInstance = ev :: RemoteEvent
	local hookedEv = ev :: RemoteEvent
	hookedEv.OnServerEvent:Connect(function(player: Player, payload: any)
		-- Ignore events from a destroyed/replaced remote
		if _purchaseHookedInstance ~= hookedEv then
			return
		end
		local sid = if typeof(payload) == "table" then tostring((payload :: any).StructureId) else tostring(payload)
		print(string.format("[RemoteSetup] OnServerEvent RequestPurchaseUpgrade %s → %s handler=%s", player.Name, sid, tostring(_purchaseHandler ~= nil)))
		if _purchaseHandler then
			_purchaseHandler(player, payload)
		else
			warn("[RemoteSetup] RequestPurchaseUpgrade fired but handler not registered yet — BaseService.Init pending")
		end
	end)
	hookedEv.AncestryChanged:Connect(function(_, parent)
		if parent == nil and _purchaseHookedInstance == hookedEv then
			_purchaseHooked = false
			_purchaseHookedInstance = nil
			warn("[RemoteSetup] RequestPurchaseUpgrade destroyed — will re-hook on next Get/Init")
		end
	end)
	print("[RemoteSetup] RequestPurchaseUpgrade OnServerEvent hooked on WE_Remotes." .. name)
end

function RemoteSetup.Init(): Folder
	-- v60: scrub legacy Rojo empty Remotes so clients never latch onto it
	local legacy = ReplicatedStorage:FindFirstChild("Remotes")
	if legacy and legacy:IsA("Folder") and legacy.Name ~= Constants.RemotesFolderName then
		if #legacy:GetChildren() == 0 then
			legacy:Destroy()
		end
	end

	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Constants.RemotesFolderName
		folder.Parent = ReplicatedStorage
	end

	-- Always ensure every remote exists (idempotent; cheap if already present)
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
	end

	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
	end

	-- v71 money (M2): unreliable events; a same-named instance of another class is replaced (never left ambiguous)
	for _, name in ipairs(UNRELIABLE) do
		local existing = folder:FindFirstChild(name)
		if existing and not existing:IsA("UnreliableRemoteEvent") then
			warn("[RemoteSetup] Replacing non-unreliable remote:", name, existing.ClassName)
			existing:Destroy()
			existing = nil
		end
		if not existing then
			local ev = Instance.new("UnreliableRemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
	end

	-- Guard: never create Give* remotes
	for _, child in ipairs(folder:GetChildren()) do
		if string.sub(child.Name, 1, 4) == "Give" then
			warn("[RemoteSetup] Removing forbidden remote:", child.Name)
			child:Destroy()
		end
	end

	-- v62: hook purchase OnServerEvent on the SAME instance clients FireServer
	ensurePurchaseHook(folder :: Folder)

	if not _initialized then
		_initialized = true
		print(string.format("[RemoteSetup] Remotes ready: %d events + %d unreliable + %d functions (folder=%s)", #EVENTS, #UNRELIABLE, #FUNCTIONS, folder.Name))
	end

	return folder :: Folder
end


function RemoteSetup.Get(name: string): Instance
	-- v61: never hang Init/handlers — ensure folder+remote exist immediately
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if not (folder and folder:IsA("Folder")) then
		folder = RemoteSetup.Init()
	end
	local remote = folder:FindFirstChild(name)
	if remote then
		if name == Constants.RemoteNames.RequestPurchaseUpgrade then
			ensurePurchaseHook(folder :: Folder)
		end
		return remote
	end
	-- Create missing event/function rather than WaitForChild forever
	if UNRELIABLE_SET[name] then
		local uev = Instance.new("UnreliableRemoteEvent")
		uev.Name = name
		uev.Parent = folder
		warn("[RemoteSetup] Get created missing UnreliableRemoteEvent:", name)
		return uev
	end
	if name == Constants.RemoteNames.GetPlayerState then
		local fn = Instance.new("RemoteFunction")
		fn.Name = name
		fn.Parent = folder
		warn("[RemoteSetup] Get created missing RemoteFunction:", name)
		return fn
	end
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = folder
	warn("[RemoteSetup] Get created missing RemoteEvent:", name)
	if name == Constants.RemoteNames.RequestPurchaseUpgrade then
		ensurePurchaseHook(folder :: Folder)
	end
	return ev
end

--[[ v71 money (M2): typed getter for a name in UNRELIABLE (never yields; creates it when missing). ]]
function RemoteSetup.GetUnreliable(name: string): UnreliableRemoteEvent
	assert(UNRELIABLE_SET[name] == true, "RemoteSetup.GetUnreliable: not an UNRELIABLE remote: " .. tostring(name))
	local remote = RemoteSetup.Get(name)
	if not remote:IsA("UnreliableRemoteEvent") then
		-- a stale same-named instance of another class: Init replaces it
		RemoteSetup.Init()
		remote = RemoteSetup.Get(name)
	end
	return remote :: UnreliableRemoteEvent
end

function RemoteSetup.IsUnreliable(name: string): boolean
	return UNRELIABLE_SET[name] == true
end

return RemoteSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Simple DataStore session lock to reduce multi-server write races.
	JobId + timestamp; steal if stale / malformed so rejoin after crash
	or place update is reliable within LOCK_TTL (never soft-lock forever).

	v70: returning nil from an UpdateAsync transform CANCELS the write (it never deletes the key), so
	Release / ForceRelease write a free tombstone { JobId = "" } instead. TryAcquire waits a few seconds
	for another server's lock to be released (the server the player just left is still saving), so the
	load that follows reads that server's final save instead of an older one.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local SessionLock = {}

export type LockInfo = {
	JobId: string,
	UserId: number,
	Timestamp: number,
}

local STORE_NAME = Constants.SessionStoreName
-- Stale threshold: after force-quit / dead server, rejoin can take over.
-- Must stay ABOVE SessionLockRefreshSeconds (see DataService heartbeat).
local LOCK_TTL = Constants.SessionLockTtlSeconds
-- A player hopping servers: the old server's leave-save + Release usually lands within a few seconds.
local ACQUIRE_WAIT_SECONDS = tonumber((Constants :: any).SessionLockAcquireWaitSeconds) or 12
local ACQUIRE_POLL_SECONDS = 2
-- v70: userIds whose lock THIS server released (leave / shutdown). Refresh never re-claims those; for the
-- rest it takes over a free or stale lock, so a session whose TryAcquire timed out still ends up holding it.
local releasedHere: { [number]: boolean } = {}
local store: DataStore? = nil

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		return store
	end
	warn("[SessionLock] DataStore unavailable:", result)
	return nil
end

local function thisJobId(): string
	return if RunService:IsStudio() then "STUDIO" else game.JobId
end

local function isLockHeldByOther(info: any, jobId: string, now: number): boolean
	if typeof(info) ~= "table" then
		return false
	end
	local heldJob = tostring((info :: LockInfo).JobId or "")
	if heldJob == "" or heldJob == jobId then
		return false -- missing jobId or ours → take / refresh
	end
	local age = now - (tonumber((info :: LockInfo).Timestamp) or 0)
	if age < 0 then
		age = 0
	end
	-- Stale lock → allow takeover (crash / BindToClose miss / place update)
	if age >= LOCK_TTL then
		return false
	end
	return true
end

--- A released lock. isLockHeldByOther treats JobId "" as free, so any server may take it.
local function freeLock(userId: number): LockInfo
	return {
		JobId = "",
		UserId = userId,
		Timestamp = 0,
	}
end

function SessionLock.GetTtlSeconds(): number
	return LOCK_TTL
end

function SessionLock.TryAcquire(userId: number): (boolean, string?)
	local ds = getStore()
	if not ds then
		-- Studio without API services: allow
		return true, nil
	end

	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	local now = os.time()
	local deadline = os.clock() + ACQUIRE_WAIT_SECONDS
	releasedHere[userId] = nil

	while true do
		local aborted = false
		now = os.time()
		local ok, err = pcall(function()
			ds:UpdateAsync(key, function(old)
				if isLockHeldByOther(old, jobId, now) then
					aborted = true
					return nil -- cancel: leave the other server's lock untouched
				end
				aborted = false
				return {
					JobId = jobId,
					UserId = userId,
					Timestamp = now,
				} :: LockInfo
			end)
		end)

		if not ok then
			return false, tostring(err)
		end
		if not aborted then
			break
		end
		-- Held by a live server — usually the one the player just left, still saving. Give it time to
		-- release so the caller's read sees that final save; stale locks expire via LOCK_TTL.
		if os.clock() >= deadline then
			return false, "Session locked by another server"
		end
		task.wait(ACQUIRE_POLL_SECONDS)
	end

	-- Confirm we hold the lock (UpdateAsync nil-abort path + races)
	local readOk, current = pcall(function()
		return ds:GetAsync(key)
	end)
	if readOk and typeof(current) == "table" then
		local cur = current :: LockInfo
		local curJob = tostring(cur.JobId or "")
		if curJob ~= jobId then
			local age = now - (tonumber(cur.Timestamp) or 0)
			if age < LOCK_TTL and curJob ~= "" then
				return false, "Session locked by another server"
			end
			-- Stale or missing JobId after race: clear and claim
			local claimed = false
			local clearOk = pcall(function()
				ds:UpdateAsync(key, function(old)
					if isLockHeldByOther(old, jobId, os.time()) then
						return nil
					end
					claimed = true
					return {
						JobId = jobId,
						UserId = userId,
						Timestamp = os.time(),
					} :: LockInfo
				end)
			end)
			if not clearOk or not claimed then
				-- Re-check; another server may have won the race
				local verifyOk, verify = pcall(function()
					return ds:GetAsync(key)
				end)
				if verifyOk and typeof(verify) == "table" and tostring((verify :: LockInfo).JobId or "") ~= jobId then
					return false, "Session locked by another server"
				end
			end
		end
	end

	return true, nil
end

function SessionLock.Refresh(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	pcall(function()
		ds:UpdateAsync(key, function(old)
			local ours = typeof(old) == "table" and tostring((old :: LockInfo).JobId or "") == jobId
			-- v70: a free / stale lock is taken over (this server still has the player loaded: e.g. TryAcquire
			-- timed out while the previous server was still saving) — unless this server already released it.
			if ours or (not releasedHere[userId] and not isLockHeldByOther(old, jobId, os.time())) then
				return {
					JobId = jobId,
					UserId = userId,
					Timestamp = os.time(),
				}
			end
			return nil -- another server's live lock, or released here: cancel (no write)
		end)
	end)
end

function SessionLock.Release(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	releasedHere[userId] = true -- before the yield: a Refresh queued after this must not re-claim
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) ~= "table" then
				return nil -- no lock record: nothing to release (nil cancels the write)
			end
			local held = tostring((old :: LockInfo).JobId or "")
			if held == jobId then
				-- v70: write a free lock. Returning nil here would cancel the write and keep our lock.
				return freeLock(userId)
			end
			return nil -- already free, or another server's lock: leave it untouched
		end)
	end)
end

--- BindToClose / emergency: clear lock for this user if we own it or it is stale.
function SessionLock.ForceReleaseIfStaleOrOurs(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	local now = os.time()
	releasedHere[userId] = true
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) ~= "table" then
				return nil -- nothing to clear (nil cancels the write)
			end
			local info = old :: LockInfo
			local held = tostring(info.JobId or "")
			if held == "" then
				return nil -- already free
			end
			local age = now - (tonumber(info.Timestamp) or 0)
			if held == jobId or age >= LOCK_TTL then
				return freeLock(userId) -- v70: an actual write; nil would keep the lock
			end
			return nil -- another live server's lock: leave it untouched
		end)
	end)
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">StructureKitBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Part-kit builders for base structures (no MeshIds required).
	Used by BaseService to ENSURE visible kits exist on purchase / join rehydrate,
	even if MapSetup plinths are bare or kits were stripped.
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local Constants = require(Shared.Constants)
local HollowBuildingBuilder = require(script.Parent.HollowBuildingBuilder)
local WorldLabel = require(Shared.Util.WorldLabel)

local StructureKitBuilder = {}

local KIT_GEN = 35 -- v70: perimeter walls leave WE_WallGap openings (sea gate) + wall-mesh placement rule (was 34: installation slab Body)

local PERIMETER_FOLDER = "WE_PerimeterWalls"
local CORNER_FOLDER = "WE_CornerTowers"
local CEILING_FOLDER = "WE_BaseCeiling"
local CEILING_UNLOCK_WALLS = 3 -- DefensiveWalls ≥ L3 unlocks anti-heli roof
local GATE_SIGN_COLOR = Color3.fromRGB(230, 210, 120)

--[[ v68: kit parts are placed in the structure's site frame. With BaseLayoutConfig the upgrade slot (plinth)
	is a console and WE_SiteCFrame says where the building stands; legacy pads have no attribute (site = pad). ]]
local function siteFrame(plinth: BasePart): CFrame
	local cf = plinth:GetAttribute("WE_SiteCFrame")
	if typeof(cf) == "CFrame" then
		return cf
	end
	return plinth.CFrame
end
StructureKitBuilder.SiteFrame = siteFrame

local function makePart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = props.Name or "Part"
	if props.Size then
		p.Size = props.Size
	end
	if props.CFrame then
		p.CFrame = props.CFrame
	elseif props.Position then
		p.Position = props.Position
	end
	if props.Color then
		p.Color = props.Color
	end
	if props.Material then
		p.Material = props.Material
	end
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	else
		p.CanCollide = false
	end
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function kitPart(plinth: BasePart, role: string, size: Vector3, localOffset: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?)
	-- v44 P0: Body/Roof (and most silhouette parts) spawn SOLID. Do NOT rely on later applyKitVisuals.
	-- DressHost stays near-invisible so catalog props can overlay. L0 ghosting is applied by applyKitVisuals.
	local solid = StructureVisualConfig.SolidTransparency
	if typeof(solid) ~= "number" then
		solid = 0
	end
	solid = math.min(solid, 0.05)
	local spawnT = if role == "DressHost" then 1 else solid
	local p = makePart({
		Name = role,
		Size = size,
		CFrame = siteFrame(plinth) * CFrame.new(localOffset),
		Color = color,
		Material = material or Enum.Material.Metal,
		Transparency = spawnT,
		CanCollide = false,
		Parent = plinth,
		Shape = shape,
	})
	p:SetAttribute("WE_KitRole", role)
	p:SetAttribute("WE_BaseSize", size)
	p:SetAttribute("WE_LocalOffset", localOffset)
	p:SetAttribute("WE_Decor", true)
	return p
end

export type KitPalette = {
	Plinth: Color3,
	Body: Color3,
	Accent: Color3,
	Roof: Color3,
	Kit: string,
}

local function paletteFor(structureId: string): KitPalette
	local p = StructureVisualConfig.Palettes[structureId]
	if p then
		return p
	end
	return {
		Plinth = Color3.fromRGB(50, 55, 48),
		Body = Color3.fromRGB(70, 80, 65),
		Accent = Color3.fromRGB(200, 180, 80),
		Roof = Color3.fromRGB(45, 50, 42),
		Kit = "special",
	}
end

local function clearKitChildren(plinth: BasePart)
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") ~= nil then
			child:Destroy()
		end
	end
end

local function countKitRoles(plinth: BasePart): number
	local n = 0
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") ~= nil then
			n += 1
		end
	end
	return n
end

--[[ Build Part kit silhouette on plinth. Replaces any existing WE_KitRole children. ]]
function StructureKitBuilder.BuildKitOnPlinth(plinth: BasePart, structureId: string)
	local pal = paletteFor(structureId)
	local kit = pal.Kit
	clearKitChildren(plinth)

	-- v66: walk-in building — the kit is only the foundation slab (Body); BaseService.applyKitVisuals
	-- syncs the HollowBuildingBuilder model for the owned level.
	if HollowBuildingBuilder.IsHollow(structureId) then
		local size, offset = HollowBuildingBuilder.FoundationSpec(plinth, structureId)
		if size and offset then
			local body = kitPart(plinth, "Body", size, offset, HollowBuildingBuilder.FoundationColor(structureId) or pal.Plinth, Enum.Material.Concrete, nil)
			body.CanCollide = true
			plinth:SetAttribute("WE_HollowKit", true)
			plinth:SetAttribute("WE_KitGen", KIT_GEN)
			return
		end
	end

	-- v44: MissileDefense gets launcher bay (not watchtower) — always Body+Roof
	if structureId == "MissileDefense" then
		-- v45: forced large Body+Roof (never empty pad / tiny slab)
		kitPart(plinth, "Body", Vector3.new(18, 12, 18), Vector3.new(0, 6.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(20, 1.4, 14), Vector3.new(0, 13.2, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(18.4, 0.3, 18.4), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		-- Twin launcher tubes
		kitPart(plinth, "Detail", Vector3.new(2.2, 2.2, 12), Vector3.new(-4, 8.5, 2), Color3.fromRGB(60, 55, 50), Enum.Material.Metal, Enum.PartType.Cylinder)
		kitPart(plinth, "Detail", Vector3.new(2.2, 2.2, 12), Vector3.new(4, 8.5, 2), Color3.fromRGB(60, 55, 50), Enum.Material.Metal, Enum.PartType.Cylinder)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 6, 0.4), Vector3.new(0, 16, -5), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 9.5, -7), pal.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		plinth:SetAttribute("WE_KitGen", KIT_GEN)
		return
	end

	if kit == "hq" then
		-- v34: compound-scale HQ (~TargetFootprint 36×16×28), not a player-sized cube
		kitPart(plinth, "Body", Vector3.new(28, 14, 22), Vector3.new(0, 7.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(12, 10, 10), Vector3.new(-18, 5.5, 4), pal.Body, Enum.Material.Metal, nil) -- west wing
		kitPart(plinth, "Detail", Vector3.new(10, 8, 10), Vector3.new(16, 4.5, -2), pal.Roof, Enum.Material.Metal, nil) -- east annex
		kitPart(plinth, "Roof", Vector3.new(30, 1.4, 24), Vector3.new(0, 15, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.45, 8, 0.45), Vector3.new(2.2, 19.5, 2.2), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 6, 0.35), Vector3.new(-18, 12, 4), pal.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(28, 0.28, 22), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.4, 1.4, 1.4), Vector3.new(-4, 10, -8), pal.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		kitPart(plinth, "Door", Vector3.new(3.2, 4.5, 0.4), Vector3.new(0, 3.0, -11.2), Color3.fromRGB(30, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(6, 8, -11.1), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(-6, 8, -11.1), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(4, 1.2, 2), Vector3.new(0, 1.2, -14), Color3.fromRGB(55, 58, 50), Enum.Material.Concrete, nil) -- entry steps
		-- Tier 2 HQ interior / roof dress hosts (catalog via TryDressStructureInterior)
		do
			local hosts = {
				{ "WE_DressHost_Radio", Vector3.new(0.6, 2.2, 0.6), Vector3.new(-1.8, 5.2, 1.6), "RadioAntenna" },
				{ "WE_DressHost_RadioRoof", Vector3.new(0.5, 1.8, 0.5), Vector3.new(1.6, 5.4, -1.4), "RadioAntennaAlt" },
				{ "WE_DressHost_Ammo", Vector3.new(1.4, 1.0, 1.0), Vector3.new(-1.6, 1.4, 1.8), "AmmoBox" },
				{ "WE_DressHost_Crate", Vector3.new(1.6, 1.2, 1.6), Vector3.new(1.8, 1.5, 1.6), "Crate" },
				{ "WE_DressHost_MilCrate", Vector3.new(1.5, 1.1, 1.3), Vector3.new(1.8, 1.45, -1.5), "MilitaryCrate" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(-2.0, 2.8, -1.8), "Lantern" },
				{ "WE_DressHost_Flood", Vector3.new(0.7, 1.4, 0.7), Vector3.new(-2.6, 4.2, -2.6), "Floodlight" },
				{ "WE_DressHost_Fuel", Vector3.new(1.2, 1.0, 1.2), Vector3.new(-2.2, 1.4, -0.2), "FuelCans" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
			-- Gunmetal command desk fallback (no free desk Model — Part kit + SurfaceGui map)
			local desk = kitPart(plinth, "DressHost", Vector3.new(3.2, 1.1, 1.6), Vector3.new(0, 1.35, 0.4), Color3.fromRGB(55, 60, 58), Enum.Material.Metal, nil)
			if desk then
				desk.Name = "WE_CommandDesk"
				desk:SetAttribute("WE_GunmetalDesk", true)
				desk.CanCollide = false
				local top = kitPart(plinth, "DressHost", Vector3.new(3.4, 0.12, 1.8), Vector3.new(0, 1.95, 0.4), Color3.fromRGB(45, 50, 48), Enum.Material.Metal, nil)
				if top then
					top.Name = "WE_CommandDeskTop"
					top.CanCollide = false
					local sg = Instance.new("SurfaceGui")
					sg.Name = "WE_MapSurface"
					sg.Face = Enum.NormalId.Top
					sg.CanvasSize = Vector2.new(256, 128)
					sg.MaxDistance = 40 -- v70: SurfaceGuis draw near-only (CLAUDE.md budget, <= 80)
					sg.Parent = top
					local mapFrame = Instance.new("Frame")
					mapFrame.Name = "MapPanel"
					mapFrame.Size = UDim2.fromScale(1, 1)
					mapFrame.BackgroundColor3 = Color3.fromRGB(40, 55, 42)
					mapFrame.BorderSizePixel = 0
					mapFrame.Parent = sg
					local grid = Instance.new("TextLabel")
					grid.Size = UDim2.fromScale(1, 1)
					grid.BackgroundTransparency = 1
					grid.Text = "▌ TERRITORY MAP ▌\nN ◆ ◆ ◆\n◆ HQ ◆ ◆\n◆ ◆ ◆ S"
					grid.TextColor3 = Color3.fromRGB(120, 200, 90)
					grid.TextScaled = true
					grid.Font = Enum.Font.Code
					grid.Parent = mapFrame
				end
			end
		end
	elseif kit == "barracks" then
		-- v34: long troop housing silhouette (~28×12×16) + bunk windows + yard
		kitPart(plinth, "Body", Vector3.new(30, 12, 16), Vector3.new(0, 6.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(32, 1.2, 18), Vector3.new(0, 13, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(30, 0.25, 16), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(2.4, 3.6, 0.35), Vector3.new(0, 2.4, -8.2), Color3.fromRGB(35, 40, 32), Enum.Material.Metal, nil)
		for wi, wx in ipairs({ -10, -5, 5, 10 }) do
			kitPart(plinth, "Window", Vector3.new(2.0, 1.2, 0.22), Vector3.new(wx, 7.5, -8.1), Color3.fromRGB(70, 120, 140), Enum.Material.Glass, nil)
		end
		kitPart(plinth, "Detail", Vector3.new(0.9, 4.5, 0.9), Vector3.new(-14, 4, 4), pal.Accent, Enum.Material.SmoothPlastic, nil) -- flag pole
		kitPart(plinth, "Detail", Vector3.new(2.4, 1.4, 0.2), Vector3.new(-14, 7.2, 4), Color3.fromRGB(40, 90, 50), Enum.Material.Fabric, nil) -- flag
		kitPart(plinth, "Detail", Vector3.new(14, 1.0, 3.5), Vector3.new(0, 1.1, 10), Color3.fromRGB(90, 85, 60), Enum.Material.Sand, nil) -- sandbag berm
		-- Tier 2 Barracks interior dress hosts
		do
			local hosts = {
				{ "WE_DressHost_Crate", Vector3.new(1.5, 1.1, 1.5), Vector3.new(2.4, 1.4, 1.4), "Crate" },
				{ "WE_DressHost_MilCrate", Vector3.new(1.4, 1.0, 1.2), Vector3.new(-2.4, 1.35, 1.4), "MilitaryCrate" },
				{ "WE_DressHost_Ammo", Vector3.new(1.2, 0.9, 0.9), Vector3.new(2.2, 1.3, -1.5), "AmmoBox" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(-2.6, 2.4, -1.2), "Lantern" },
				{ "WE_DressHost_Sandbag", Vector3.new(2.4, 1.0, 1.2), Vector3.new(0, 1.2, 1.8), "Sandbag" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	elseif kit == "depot" then
		kitPart(plinth, "Body", Vector3.new(32, 12, 22), Vector3.new(0, 6.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(34, 1.2, 24), Vector3.new(0, 13.2, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(32, 0.28, 22), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(10, 8, 0.4), Vector3.new(0, 4.5, -11.2), Color3.fromRGB(40, 50, 60), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 1.2, 1.2), Vector3.new(12, 8, 8), pal.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		-- Showroom podium: PlateDark cylinder + spinning display (v70: the Neon podium ring and the AlwaysOnTop
		-- rarity billboard were removed, HUD spec §5)
		local podium = kitPart(plinth, "Podium", Vector3.new(3.6, 0.55, 3.6), Vector3.new(0, 0.95, 4.2), Constants.Colors.PlateDark, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		-- Cylinder default axis X — stand upright
		if podium then
			local off = podium:GetAttribute("WE_LocalOffset")
			if typeof(off) == "Vector3" then
				podium.CFrame = siteFrame(plinth) * CFrame.new(off :: Vector3) * CFrame.Angles(0, 0, math.rad(90))
			end
		end
		local display = kitPart(plinth, "ShowroomMesh", Vector3.new(2.4, 1.1, 4.0), Vector3.new(0, 1.85, 4.2), Color3.fromRGB(70, 88, 62), Enum.Material.Metal, nil)
		if display then
			display:SetAttribute("WE_ShowroomSpin", true)
		end
	
		-- Tier 2: extra pedestal hosts + flag (densify showroom)
		for pi, ox in ipairs({ -4.2, 4.2 }) do
			local ped = kitPart(plinth, "Podium", Vector3.new(2.4, 0.4, 2.4), Vector3.new(ox, 0.9, 4.0), Color3.fromRGB(40, 48, 55), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
			if ped then
				ped.Name = "ShowroomPedestalHost" .. (pi + 1)
				local off = ped:GetAttribute("WE_LocalOffset")
				if typeof(off) == "Vector3" then
					ped.CFrame = siteFrame(plinth) * CFrame.new(off :: Vector3) * CFrame.Angles(0, 0, math.rad(90))
				end
				ped.Transparency = 0.55
			end
		end
		local flagHost = kitPart(plinth, "DressHost", Vector3.new(0.4, 4.5, 0.4), Vector3.new(-3.6, 3.2, -2.8), Color3.fromRGB(180, 180, 180), Enum.Material.Metal, nil)
		if flagHost then
			flagHost.Name = "ShowroomFlagHost"
			flagHost:SetAttribute("WE_DressProp", "FlagPole")
			flagHost.Transparency = 0.7
			flagHost.CanCollide = false
		end
		local floodHost = kitPart(plinth, "DressHost", Vector3.new(0.6, 1.2, 0.6), Vector3.new(3.4, 3.4, -2.6), Color3.fromRGB(200, 200, 180), Enum.Material.Metal, nil)
		if floodHost then
			floodHost.Name = "WE_DressHost_DepotFlood"
			floodHost:SetAttribute("WE_DressProp", "FloodlightAlt")
			floodHost.Transparency = 0.7
		end
		-- Second bay floodlight
		local floodHost2 = kitPart(plinth, "DressHost", Vector3.new(0.6, 1.2, 0.6), Vector3.new(-3.4, 3.4, -2.6), Color3.fromRGB(200, 200, 180), Enum.Material.Metal, nil)
		if floodHost2 then
			floodHost2.Name = "WE_DressHost_DepotFlood2"
			floodHost2:SetAttribute("WE_DressProp", "Floodlight")
			floodHost2.Transparency = 0.7
		end
		local fuelHost = kitPart(plinth, "DressHost", Vector3.new(1.3, 1.0, 1.3), Vector3.new(3.2, 1.3, 2.4), Color3.fromRGB(70, 65, 45), Enum.Material.Metal, nil)
		if fuelHost then
			fuelHost.Name = "WE_DressHost_DepotFuel"
			fuelHost:SetAttribute("WE_DressProp", "FuelCans")
			fuelHost.Transparency = 0.75
			fuelHost.CanCollide = false
		end
	elseif kit == "lab" then
		kitPart(plinth, "Body", Vector3.new(20, 10, 14), Vector3.new(0, 5.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(5.5, 0.5, 5.5), Vector3.new(0, 4.0, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 3.8, 0.4), Vector3.new(0, 6.1, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(5.7, 0.2, 5.7), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Window", Vector3.new(1.5, 1.2, 0.2), Vector3.new(0, 2.6, -2.6), Color3.fromRGB(80, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.9, 0.9, 0.9), Vector3.new(2.0, 3.5, 2.0), pal.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "tower" then
		-- v33: ≥28–32 stud sniper tower (walkable ladder + platform), not a stub
		kitPart(plinth, "Body", Vector3.new(10, 28, 10), Vector3.new(0, 14.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(14, 0.6, 14), Vector3.new(0, 29.2, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(16, 0.45, 16), Vector3.new(0, 27.8, 0), pal.Roof, Enum.Material.Metal, nil) -- lookout deck
		kitPart(plinth, "Antenna", Vector3.new(0.4, 5.5, 0.4), Vector3.new(0, 32.5, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(10.4, 0.25, 10.4), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Window", Vector3.new(2.2, 1.4, 0.25), Vector3.new(0, 24, -5.1), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.2, 1.4, 0.25), Vector3.new(0, 18, -5.1), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Door", Vector3.new(2.4, 3.6, 0.35), Vector3.new(0, 2.4, -5.15), Color3.fromRGB(40, 42, 36), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.55, 26, 0.55), Vector3.new(5.2, 13.5, 5.2), Color3.fromRGB(55, 58, 48), Enum.Material.Metal, nil) -- ladder rail
	elseif kit == "dock" then
		-- v35: naval pier + bollards + crane silhouette + warehouse shed (readable Naval Dock)
		kitPart(plinth, "Body", Vector3.new(24, 1.4, 16), Vector3.new(0, 1.2, 0), pal.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Pier", Vector3.new(44, 0.9, 10), Vector3.new(0, 1.5, 20), pal.Roof, Enum.Material.Wood, nil)
		kitPart(plinth, "Accent", Vector3.new(20, 0.16, 0.5), Vector3.new(0, 1.35, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		-- Bollards along pier
		for bi, bx in ipairs({ -16, -8, 0, 8, 16 }) do
			kitPart(plinth, "Detail", Vector3.new(1.1, 1.6, 1.1), Vector3.new(bx, 2.4, 24), Color3.fromRGB(50, 55, 60), Enum.Material.Metal, nil)
		end
		-- Crane mast + boom
		kitPart(plinth, "Antenna", Vector3.new(1.2, 16, 1.2), Vector3.new(-10, 9, 8), Color3.fromRGB(200, 140, 50), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(18, 0.6, 0.6), Vector3.new(-1, 16.5, 8), Color3.fromRGB(210, 150, 55), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.4, 4, 0.4), Vector3.new(7, 14, 8), Color3.fromRGB(80, 80, 75), Enum.Material.Metal, nil) -- cable
		-- Shore warehouse shed
		kitPart(plinth, "Roof", Vector3.new(14, 8, 10), Vector3.new(10, 5, -2), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(6, 6, 0.4), Vector3.new(10, 3.5, 3.2), Color3.fromRGB(40, 55, 70), Enum.Material.Metal, nil)
		-- Tire fenders
		for _, fx in ipairs({ -12, 0, 12 }) do
			kitPart(plinth, "Detail", Vector3.new(1.8, 1.8, 0.6), Vector3.new(fx, 1.8, 25.2), Color3.fromRGB(35, 35, 35), Enum.Material.Rubber, Enum.PartType.Cylinder)
		end
		-- Shipping crate dress hosts
		do
			local hosts = {
				{ "WE_DressHost_Crate", Vector3.new(1.8, 1.4, 1.8), Vector3.new(6, 1.8, 12), "MilitaryCrate" },
				{ "WE_DressHost_Fuel", Vector3.new(1.2, 1.0, 1.2), Vector3.new(-6, 1.6, 10), "FuelCans" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
		-- v37: static naval boat Part-kit at pier end + DressHost for PatrolBoat mesh
		do
			local bx, bz = 0, 28
			kitPart(plinth, "ParkedBoat", Vector3.new(12, 2.2, 4.2), Vector3.new(bx, 2.4, bz), Color3.fromRGB(45, 55, 70), Enum.Material.Metal, nil) -- hull
			kitPart(plinth, "ParkedBoat", Vector3.new(3.5, 1.4, 3.2), Vector3.new(bx + 6.5, 2.6, bz), Color3.fromRGB(50, 60, 75), Enum.Material.Metal, nil) -- bow
