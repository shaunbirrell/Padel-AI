          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — Server Bootstrap
	Wires remotes + services. Request/action remotes only.

	v65 CRITICAL: DataService.Init FIRST; then Economy/Base; remotes before MapSetup.
	Map densify InsertService must never block EconomyUpdate (HUD $… forever).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local DevConfig = require(Shared.Configs.DevConfig)

local ServerFolder = script.Parent
local Modules = ServerFolder:WaitForChild("Modules")
local Services = ServerFolder:WaitForChild("Services")

print("[WAR EMPIRE] Server Bootstrap starting...")

-- ── 1. REMOTES FIRST (before any MapSetup / InsertService) ─────────────────
local RemoteSetup = require(Modules.RemoteSetup)
RemoteSetup.Init() -- client Remotes.GetEvent / EconomyUpdate must never hang on empty folder
print("[WAR EMPIRE] Remotes ready BEFORE map (v60 WE_Remotes + cash-first)")

local function safeRequire(label: string, moduleScript: ModuleScript): any
	local ok, mod = pcall(require, moduleScript)
	if not ok then
		warn("[WAR EMPIRE] require FAILED:", label, mod)
		return nil
	end
	return mod
end

local DataService = safeRequire("DataService", Services.DataService)
local EconomyService = safeRequire("EconomyService", Services.EconomyService)
local BaseService = safeRequire("BaseService", Services.BaseService)
local XPService = safeRequire("XPService", Services.XPService)
local RateLimitService = safeRequire("RateLimitService", Services.RateLimitService)
local AnalyticsService = safeRequire("AnalyticsService", Services.AnalyticsService)
local AdminService = safeRequire("AdminService", Services.AdminService)
local NotificationService = safeRequire("NotificationService", Services.NotificationService)
local AntiExploitService = safeRequire("AntiExploitService", Services.AntiExploitService)
local CombatService = safeRequire("CombatService", Services.CombatService)
local VehicleService = safeRequire("VehicleService", Services.VehicleService)
local TerritoryService = safeRequire("TerritoryService", Services.TerritoryService)
local MissionService = safeRequire("MissionService", Services.MissionService)
local PrestigeService = safeRequire("PrestigeService", Services.PrestigeService)
local ClanService = safeRequire("ClanService", Services.ClanService)
local MonetizationService = safeRequire("MonetizationService", Services.MonetizationService)
local TutorialService = safeRequire("TutorialService", Services.TutorialService)
local BattlePassService = safeRequire("BattlePassService", Services.BattlePassService)
local SoldierService = safeRequire("SoldierService", Services.SoldierService)
local SquadOrdersService = safeRequire("SquadOrdersService", Services.SquadOrdersService)
local SeasonService = safeRequire("SeasonService", Services.SeasonService)
local ClanWarService = safeRequire("ClanWarService", Services.ClanWarService)
local CodesService = safeRequire("CodesService", Services.CodesService)
local NationColorService = safeRequire("NationColorService", Services.NationColorService)
local CaptureStipendService = safeRequire("CaptureStipendService", Services.CaptureStipendService)
local SupplyDropService = safeRequire("SupplyDropService", Services.SupplyDropService)
local BankRaidService = safeRequire("BankRaidService", Services.BankRaidService)
local SpinnerService = safeRequire("SpinnerService", Services.SpinnerService)
local UpgradePadService = safeRequire("UpgradePadService", Services.UpgradePadService)
local PremiumPadService = safeRequire("PremiumPadService", Services.PremiumPadService)
local FallSafetyService = safeRequire("FallSafetyService", Services.FallSafetyService)
local MoneyCollectorService = safeRequire("MoneyCollectorService", Services.MoneyCollectorService)
local ManualDropperService = safeRequire("ManualDropperService", Services.ManualDropperService)
local VisualAssetService = safeRequire("VisualAssetService", Services.VisualAssetService)
local GateDefenseService = safeRequire("GateDefenseService", Services.GateDefenseService)
local ResearchService = safeRequire("ResearchService", Services.ResearchService) -- v69 Research Lab upgrades
local MissileStrikeService = safeRequire("MissileStrikeService", Services.MissileStrikeService) -- v69 CC strikes
local PlotOilPumpService = safeRequire("PlotOilPumpService", Services.PlotOilPumpService)
local StudioBuySmoke = safeRequire("StudioBuySmoke", Modules.StudioBuySmoke)

RemoteSetup.Init() -- idempotent; ensure remotes still present after requires

local deps: { [string]: any } = {
	RemoteSetup = RemoteSetup,
	DataService = DataService,
	EconomyService = EconomyService,
	BaseService = BaseService,
	XPService = XPService,
	RateLimitService = RateLimitService,
	AnalyticsService = AnalyticsService,
	AdminService = AdminService,
	NotificationService = NotificationService,
	AntiExploitService = AntiExploitService,
	CombatService = CombatService,
	VehicleService = VehicleService,
	TerritoryService = TerritoryService,
	MissionService = MissionService,
	PrestigeService = PrestigeService,
	ClanService = ClanService,
	MonetizationService = MonetizationService,
	TutorialService = TutorialService,
	BattlePassService = BattlePassService,
	SoldierService = SoldierService,
	SquadOrdersService = SquadOrdersService,
	SeasonService = SeasonService,
	ClanWarService = ClanWarService,
	CodesService = CodesService,
	NationColorService = NationColorService,
	CaptureStipendService = CaptureStipendService,
	SupplyDropService = SupplyDropService,
	BankRaidService = BankRaidService,
	SpinnerService = SpinnerService,
	UpgradePadService = UpgradePadService,
	PremiumPadService = PremiumPadService,
	FallSafetyService = FallSafetyService,
	MoneyCollectorService = MoneyCollectorService,
	VisualAssetService = VisualAssetService,
	ManualDropperService = ManualDropperService,
	GateDefenseService = GateDefenseService,
	ResearchService = ResearchService,
	MissileStrikeService = MissileStrikeService,
	PlotOilPumpService = PlotOilPumpService,
}

local function safeInit(label: string, svc: any, ...: any)
	if svc == nil then
		warn("[WAR EMPIRE] skip Init (nil):", label)
		return
	end
	local args = { ... }
	local ok, err = pcall(function()
		if #args > 0 then
			svc.Init(table.unpack(args))
		else
			svc.Init()
		end
	end)
	if not ok then
		warn("[WAR EMPIRE] Init FAILED:", label, err)
	end
end

-- v45: set after BaseService Init — refresh kits/walls after any map rebuild (race fix)
local afterMapRebuild: (() -> ())? = nil

local function notifyMapRebuilt(label: string)
	if afterMapRebuild then
		print("[WAR EMPIRE] afterMapRebuild → RefreshAllOnlinePlayers (" .. label .. ")")
		task.defer(afterMapRebuild)
	end
end

-- ── 2. CASH PATH FIRST (instant profile + Push; map must not block) ─────────
-- v65: warn loudly if safeRequire failed (nil module → Buy GetProfile crash)
if DataService == nil then
	warn("[WAR EMPIRE] CRITICAL: DataService safeRequire FAILED — buy path will break until fixed")
end
if EconomyService == nil then
	warn("[WAR EMPIRE] CRITICAL: EconomyService safeRequire FAILED")
end
if BaseService == nil then
	warn("[WAR EMPIRE] CRITICAL: BaseService safeRequire FAILED")
end

safeInit("RateLimitService", RateLimitService)
safeInit("AnalyticsService", AnalyticsService)
if DataService and AnalyticsService and DataService.SetAnalytics then
	pcall(DataService.SetAnalytics, AnalyticsService)
end

-- v65 CRITICAL: DataService.Init FIRST before Economy/Base/UpgradePad
-- (module-local DataService in BaseService was nil when Init order raced / deps cleared)
safeInit("DataService", DataService)
print("[WAR EMPIRE] DataService Init FIRST (v65) — before Economy/Base/UpgradePad")

-- v66: warn only. The v65 assert killed this whole script when DataService failed to load
-- (ProfileSchema parse error since v50), so no purchase handler, map or later service ever ran.
if deps.DataService == nil then
	warn("[WAR EMPIRE] CRITICAL: deps.DataService is nil before BaseService.Init — buy will fail")
end

safeInit("NotificationService", NotificationService, deps)
-- v69: TutorialService right after its deps (DataService, RemoteSetup, RateLimit, Notification) and BEFORE every
-- service that calls TutorialService.Notify (Economy, MoneyCollector, ManualDropper, Base …). BaseService's
-- OnProfileLoaded fires at once for already-loaded players and used to call Notify before this Init → threw.
-- (TutorialService.Init only needs BaseService.GetUpgradeChangedEvent, which works before BaseService.Init.)
safeInit("TutorialService", TutorialService, deps)
safeInit("AntiExploitService", AntiExploitService, deps)
safeInit("MonetizationService", MonetizationService, deps)
safeInit("EconomyService", EconomyService, deps)
safeInit("XPService", XPService, deps)
safeInit("MoneyCollectorService", MoneyCollectorService, deps)
safeInit("ManualDropperService", ManualDropperService, deps)
safeInit("BaseService", BaseService, deps) -- registers OnProfileLoaded + PurchaseUpgrade remote
afterMapRebuild = function()
	if BaseService and BaseService.RefreshAllOnlinePlayers then
		pcall(BaseService.RefreshAllOnlinePlayers)
	end
end
print("[WAR EMPIRE] DataService/EconomyService ready BEFORE map (v61)")
print("[WAR EMPIRE] v65 DataService-first + getDataService fallback + attribute-ack buy")
safeInit("UpgradePadService", UpgradePadService, deps)
safeInit("PremiumPadService", PremiumPadService, deps)
safeInit("FallSafetyService", FallSafetyService, deps)

-- Belt: EconomyService.Push within first second regardless of map state
do
	local Players = game:GetService("Players")
	local function earlyCashPush(player: Player)
		task.spawn(function()
			local deadline = os.clock() + 1.0
			while os.clock() < deadline do
				local profile = nil
				if DataService and DataService.GetProfile then
					profile = DataService.GetProfile(player)
				end
				if profile then
					if EconomyService and EconomyService.Push then
						pcall(EconomyService.Push, player)
					end
					return
				end
				task.wait(0.05)
			end
			if DataService and DataService.EnsureProfile then
				pcall(DataService.EnsureProfile, player)
			end
			if EconomyService and EconomyService.Push then
				pcall(EconomyService.Push, player)
			end
		end)
	end
	Players.PlayerAdded:Connect(earlyCashPush)
	for _, plr in ipairs(Players:GetPlayers()) do
		earlyCashPush(plr)
	end
end

-- ── 3. MAP AFTER REMOTES + CASH (densify InsertService is deferred inside MapSetup) ─
-- NEVER let MapSetup parse/require failure abort remotes + HUD (live void bug).
local MapSetup: any = nil
do
	local okMap, mapOrErr = pcall(require, Modules.MapSetup)
	if okMap then
		MapSetup = mapOrErr
	else
		warn("[WAR EMPIRE] CRITICAL: require(MapSetup) FAILED — remotes already live. Err:", mapOrErr)
	end
end

local function ensureVoidFallback(reason: string)
	warn("[WAR EMPIRE] CRITICAL: MapSetup failed — installing void fallback. Reason: " .. tostring(reason))
	print("[WAR EMPIRE] ERROR: MapSetup did not build WarEmpireSetup. Creating emergency baseplate + spawn so players do not void-fall.")

	Workspace.Gravity = 196.2

	local existing = Workspace:FindFirstChild("WE_VoidFallback")
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "WE_VoidFallback"
	folder.Parent = Workspace

	-- v70 (spec_final §12.1): 3 x 3 tiles of 1700 (a single 7000 plate exceeds Roblox's 2048 part-size cap). The centre
	-- tile keeps the name Baseplate.
	local TILE = 1700
	for i = -1, 1 do
		for j = -1, 1 do
			local baseplate = Instance.new("Part")
			baseplate.Name = if i == 0 and j == 0 then "Baseplate" else ("Baseplate_" .. tostring(i + 2) .. "_" .. tostring(j + 2))
			baseplate.Size = Vector3.new(TILE, 6, TILE)
			baseplate.Position = Vector3.new(i * TILE, -3, j * TILE)
			baseplate.Anchored = true
			baseplate.CanCollide = true
			baseplate.Material = Enum.Material.Grass
			baseplate.Color = Color3.fromRGB(40, 80, 40)
			baseplate.TopSurface = Enum.SurfaceType.Smooth
			baseplate.BottomSurface = Enum.SurfaceType.Smooth
			baseplate.Parent = folder
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "EmergencySpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 5, 0)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.BrickColor = BrickColor.new("Bright green")
	spawn.Material = Enum.Material.Neon
	spawn.Parent = folder

	print("[WAR EMPIRE] Void fallback ready: WE_VoidFallback Baseplate + EmergencySpawn at (0,5,0)")
end

local function runMapSetupOrFallback(reasonIfNil: string)
	if MapSetup == nil then
		ensureVoidFallback(reasonIfNil)
		return
	end
	local ok, err = pcall(function()
		MapSetup.Run()
	end)
	if not ok then
		ensureVoidFallback(err)
	elseif not Workspace:FindFirstChild("WarEmpireSetup") then
		ensureVoidFallback("MapSetup.Run returned but WarEmpireSetup missing")
	end
end

local function healOrRebuildMap(label: string)
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		print("[WAR EMPIRE] Map heal (" .. label .. "): WarEmpireSetup missing — Run()")
		runMapSetupOrFallback("MapSetup nil during heal (" .. label .. ")")
		notifyMapRebuilt(label .. ":missing-run")
		return
	end
	if MapSetup == nil then
		local map = setup:FindFirstChild("Map")
		local g = map and map:FindFirstChild("Ground")
		if not (g and g:IsA("BasePart") and g.CanCollide) then
			ensureVoidFallback("MapSetup nil and Ground unhealthy (" .. label .. ")")
		end
		return
	end
	Workspace.Gravity = 196.2
	if MapSetup.EnsureGroundHealthy then
		pcall(function()
			MapSetup.EnsureGroundHealthy(setup)
		end)
	end
	if MapSetup.ForceRebuildGround then
		local okRebuild, rebuildResult = pcall(function()
			return MapSetup.ForceRebuildGround(setup)
		end)
		if not (okRebuild and rebuildResult == true) then
			warn("[WAR EMPIRE] ForceRebuildGround failed (" .. label .. ") — full MapSetup.Run")
			pcall(function()
				setup:Destroy()
				MapSetup.Run()
			end)
			notifyMapRebuilt(label .. ":ForceRebuildGround-Run")
			if not Workspace:FindFirstChild("WarEmpireSetup") then
				ensureVoidFallback("ForceRebuildGround failed (" .. label .. ")")
			end
		end
	end
end

-- v70: a saved / baked WarEmpireSetup from another layout generation (WE_MapGen ~= MapSetup.MAP_GEN: unturned plots,
-- one WaterPlane, untiled ground) is rebuilt from scratch instead of healed.
local function isStaleMapGen(setup: Instance?): boolean
	if setup == nil or MapSetup == nil or MapSetup.MAP_GEN == nil then
		return false
	end
	return setup:GetAttribute("WE_MapGen") ~= MapSetup.MAP_GEN
end

-- Run map build/heal AFTER remotes exist (never blocks EconomyUpdate creation)
if not Workspace:FindFirstChild("WarEmpireSetup") then
	runMapSetupOrFallback("MapSetup module failed to load")
elseif isStaleMapGen(Workspace:FindFirstChild("WarEmpireSetup")) then
	local stale = Workspace:FindFirstChild("WarEmpireSetup") :: Instance
	print(
		"[WAR EMPIRE] WarEmpireSetup is map gen "
			.. tostring(stale:GetAttribute("WE_MapGen"))
			.. " (want "
			.. tostring(MapSetup.MAP_GEN)
			.. ") — full MapSetup.Run (stale map gen)"
	)
	pcall(function()
		stale:Destroy()
	end)
	runMapSetupOrFallback("stale map gen")
	notifyMapRebuilt("bootstrap-staleMapGen")
else
	print("[WAR EMPIRE] WarEmpireSetup already present — skipping MapSetup.Run (FORCE rebuild Ground + SafetyCatch)")
	Workspace.Gravity = 196.2
	local CollectionService = game:GetService("CollectionService")
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	-- v70: the ground is 16 tiles of MapSetup.GROUND_TILE_SIZE (Map.Ground is one of them)
	local targetSize = (MapSetup and (MapSetup.GROUND_TILE_SIZE or MapSetup.GROUND_SIZE)) or 6400

	healOrRebuildMap("bootstrap-existing")

	setup = Workspace:FindFirstChild("WarEmpireSetup")
	local mapFolder = setup and setup:FindFirstChild("Map")
	local g = mapFolder and mapFolder:FindFirstChild("Ground")
	local catch = mapFolder and mapFolder:FindFirstChild("SafetyCatch")
	if g and g:IsA("BasePart") then
		g.CanCollide = true
		g.Anchored = true
		local tiles = if setup and MapSetup and MapSetup.CountGroundTiles then MapSetup.CountGroundTiles(setup) else 1
		local wantTiles = (MapSetup and MapSetup.GROUND_TILES) or 1
		print(string.format(
			"[WAR EMPIRE] Ground AFTER heal: size=%.0fx%.0fx%.0f tiles=%d/%d CanCollide=%s SafetyCatch=%s",
			g.Size.X,
			g.Size.Y,
			g.Size.Z,
			tiles,
			wantTiles,
			tostring(g.CanCollide),
			tostring(catch ~= nil)
		))
		if g.Size.X < targetSize - 1 or g.CanCollide ~= true or tiles < wantTiles then
			warn("[WAR EMPIRE] Ground still unhealthy after force rebuild — run admin resetmap (Studio)")
		end
	else
		warn("[WAR EMPIRE] Ground MISSING after force rebuild — run admin resetmap (Studio) MANDATORY")
	end

	setup = Workspace:FindFirstChild("WarEmpireSetup")
	if setup then
		local tagged = CollectionService:GetTagged(Constants.Tags.UpgradeSlot)
		local taggedCount = #tagged
		if taggedCount == 0 then
			local bases = setup:FindFirstChild("Bases")
			local retagged = 0
			if bases then
				for _, desc in ipairs(bases:GetDescendants()) do
					if desc:IsA("BasePart") then
						local sid = desc:GetAttribute("StructureId")
						local pid = desc:GetAttribute("PlotId")
						if typeof(sid) == "string" and typeof(pid) == "number" then
							CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
							desc.CanTouch = true
							retagged += 1
						end
					end
				end
			end
			if retagged == 0 then
				warn("[WAR EMPIRE] WarEmpireSetup present but no upgrade pads — rebuilding via MapSetup")
				pcall(function()
					setup:Destroy()
				end)
				runMapSetupOrFallback("Missing upgrade pads and MapSetup nil")
				notifyMapRebuilt("bootstrap-missingPads")
			else
				print("[WAR EMPIRE] Re-tagged", retagged, "upgrade pads with WE_UpgradeSlot")
			end
		else
			for _, inst in ipairs(tagged) do
				if inst:IsA("BasePart") then
					inst.CanTouch = true
				end
			end
			print("[WAR EMPIRE] Upgrade slots OK:", taggedCount)
		end
	end
end

-- v67: base labels stop drawing over everything (AlwaysOnTop off, capped range) — map exists now,
-- and DescendantAdded catches labels services create later (ATM, droppers, soldiers, gate).
do
	local WorldLabelPolicy = safeRequire("WorldLabelPolicy", Modules.WorldLabelPolicy)
	if WorldLabelPolicy and WorldLabelPolicy.Init then
		local okLabels, errLabels = pcall(WorldLabelPolicy.Init)
		if not okLabels then
			warn("[WAR EMPIRE] WorldLabelPolicy.Init failed:", errLabels)
		end
	end
end

-- PlayerAdded: heal map if somehow missing (late join / rare destroy)
do
	local Players = game:GetService("Players")
	local CollectionService = game:GetService("CollectionService")
	local function ensureMapForPlayer(player: Player)
		task.defer(function()
			local okHeal, errHeal = pcall(function()
				local setup = Workspace:FindFirstChild("WarEmpireSetup")
				if not setup and not Workspace:FindFirstChild("WE_VoidFallback") then
					warn("[WAR EMPIRE] PlayerAdded map missing for", player.Name, "— healing")
					healOrRebuildMap("PlayerAdded:" .. player.Name)
					notifyMapRebuilt("PlayerAdded:" .. player.Name)
					return
				end
				if not setup then
					return
				end
				local padCount = 0
				pcall(function()
					padCount = #CollectionService:GetTagged(Constants.Tags.UpgradeSlot)
				end)
				if padCount == 0 then
					local bases = setup:FindFirstChild("Bases")
					local hasPlotPad = false
					if bases then
						for _, d in ipairs(bases:GetDescendants()) do
							if d:IsA("BasePart") and d.Name == "PlotPad" then
								hasPlotPad = true
								break
							end
						end
					end
					if not hasPlotPad then
						warn("[WAR EMPIRE] PlayerAdded: WarEmpireSetup has no PlotPad/upgrade pads — full MapSetup rebuild for", player.Name)
						pcall(function()
							setup:Destroy()
						end)
						local voidFb = Workspace:FindFirstChild("WE_VoidFallback")
						if voidFb then
							pcall(function()
								voidFb:Destroy()
							end)
						end
						healOrRebuildMap("PlayerAdded-missingPads:" .. player.Name)
						notifyMapRebuilt("PlayerAdded-missingPads:" .. player.Name)
						return
					end
				end
				if MapSetup and MapSetup.EnsureGroundHealthy then
					MapSetup.EnsureGroundHealthy(setup)
				end
			end)
			if not okHeal then
				warn("[WAR EMPIRE] PlayerAdded map heal error (remotes continue):", errHeal)
			end
		end)
	end
	Players.PlayerAdded:Connect(ensureMapForPlayer)
	for _, plr in ipairs(Players:GetPlayers()) do
		ensureMapForPlayer(plr)
	end
end

-- ── 4. Remaining services ───────────────────────────────────────────────────
safeInit("StudioBuySmoke", StudioBuySmoke, deps)
safeInit("AdminService", AdminService, deps)
safeInit("VisualAssetService", VisualAssetService)
safeInit("CombatService", CombatService, deps)
safeInit("VehicleService", VehicleService, deps)
safeInit("NationColorService", NationColorService, deps)
safeInit("TerritoryService", TerritoryService, deps)
safeInit("MissionService", MissionService, deps)
safeInit("PrestigeService", PrestigeService, deps)
safeInit("ClanService", ClanService, deps)
safeInit("BattlePassService", BattlePassService, deps)
safeInit("SoldierService", SoldierService, deps)
safeInit("SquadOrdersService", SquadOrdersService, deps)
safeInit("SeasonService", SeasonService, deps)
safeInit("ClanWarService", ClanWarService, deps)
safeInit("CodesService", CodesService, deps)
safeInit("CaptureStipendService", CaptureStipendService, deps)
safeInit("SupplyDropService", SupplyDropService, deps)
safeInit("BankRaidService", BankRaidService, deps)
safeInit("GateDefenseService", GateDefenseService, deps)
safeInit("PlotOilPumpService", PlotOilPumpService, deps)
safeInit("SpinnerService", SpinnerService, deps)
safeInit("ResearchService", ResearchService, deps)
safeInit("MissileStrikeService", MissileStrikeService, deps)

-- v70 waterways [J1]: the sea-gate loop (opens an armed plot's sea gate while a boat driven by the owner or a
-- clan-mate is near). After the services' Init: it reads BaseService owners and GateDefenseService.IsAlly. Guarded —
-- a missing or broken Modules.Waterways only means the sea gates stay closed.
do
	local wwModule = Modules:FindFirstChild("Waterways")
	local Waterways = if wwModule and wwModule:IsA("ModuleScript") then safeRequire("Waterways", wwModule) else nil
	if Waterways and Waterways.StartSeaGates then
		local okGates, errGates = pcall(Waterways.StartSeaGates, { BaseService = BaseService, GateDefenseService = GateDefenseService })
		if not okGates then
			warn("[WAR EMPIRE] Waterways.StartSeaGates failed (sea gates stay closed):", errGates)
		end
	else
		warn("[WAR EMPIRE] Waterways sea-gate loop not started (Modules.Waterways missing)")
	end
end

if DevConfig.VerboseLogging then
	print("[WAR EMPIRE] Services initialized. Plots:", Constants.MaxBasePlots)
end

print("[WAR EMPIRE] Server Bootstrap ready.")
print("[WAR EMPIRE] CHECKLIST: 1) resetmap MANDATORY if void/dead-space persists (stale WarEmpireSetup keeps old holes)  2) Output must show Ground AFTER heal size/CanCollide  3) stand on YOUR Command Center pad — big BUY button + [UpgradePad] BUY ATTEMPT/OK  4) dock tiles toast + B menu BUY")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="66">
        <Properties>
          <string name="Name">EarlyRemotes</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	v60: Run BEFORE Bootstrap finishes requiring services.
	1) Create ALL remotes under WE_Remotes (server-only — no Rojo empty folder).
	2) Seed leaderstats + WE_Cash IMMEDIATELY on PlayerAdded (before DataStore).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Destroy legacy empty Rojo Remotes folder so clients never WaitForChild on it
do
	local legacy = ReplicatedStorage:FindFirstChild("Remotes")
	if legacy and legacy:IsA("Folder") and #legacy:GetChildren() == 0 then
		legacy:Destroy()
	end
end

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"))
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local AdminConfig = require(Shared.Configs.AdminConfig)

local Modules = script.Parent:WaitForChild("Modules")
local RemoteSetup = require(Modules:WaitForChild("RemoteSetup"))
RemoteSetup.Init()

local ADMIN_PLAYTEST_USER_ID = 470626172

local function seedCashAmount(userId: number): number
	local startCash = math.floor(tonumber(EconomyConfig.StartingCash) or 10000)
	if userId == ADMIN_PLAYTEST_USER_ID then
		local floor = math.floor(tonumber(AdminConfig.AdminPlaytestCash) or 50_000_000)
		return math.max(startCash, floor)
	end
	return startCash
end

local function ensureLeaderstats(player: Player, cash: number, gold: number)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end
	local cashVal = folder:FindFirstChild("Cash")
	if not cashVal then
		cashVal = Instance.new("IntValue")
		cashVal.Name = "Cash"
		cashVal.Parent = folder
	end
	if cashVal:IsA("IntValue") or cashVal:IsA("NumberValue") then
		(cashVal :: any).Value = cash
	end
	local goldVal = folder:FindFirstChild("Gold")
	if not goldVal then
		goldVal = Instance.new("IntValue")
		goldVal.Name = "Gold"
		goldVal.Parent = folder
	end
	if goldVal:IsA("IntValue") or goldVal:IsA("NumberValue") then
		(goldVal :: any).Value = gold
	end
end

local function seedPlayer(player: Player)
	local cash = seedCashAmount(player.UserId)
	local gold = math.floor(tonumber(EconomyConfig.StartingGold) or 0)
	pcall(function()
		player:SetAttribute("WE_Build", 72)
		player:SetAttribute("WE_Cash", cash)
		player:SetAttribute("WE_Gold", gold)
		player:SetAttribute("WE_PendingCash", 0)
	end)
	pcall(ensureLeaderstats, player, cash, gold)
	-- Fire EconomyUpdate if client already listening
	pcall(function()
		local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
		local ev = folder and folder:FindFirstChild(Constants.RemoteNames.EconomyUpdate)
		if ev and ev:IsA("RemoteEvent") then
			(ev :: RemoteEvent):FireClient(player, {
				Cash = cash,
				Gold = gold,
				PendingCash = 0,
			})
		end
	end)
end

Players.PlayerAdded:Connect(seedPlayer)
for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(seedPlayer, plr)
end

print("[WAR EMPIRE] EarlyRemotes v63: WE_Remotes + leaderstats seed ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="67">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">BaseLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v68: geometry helpers for Configs/BaseLayoutConfig (plot-local layout → world CFrames).
	v70: every plot has its own frame. BaseLayout.PlotCFrame(plotPos) = plot position turned by the plot yaw; with
	BaseLayoutConfig.FaceMapCentre the plot's FRONT (local +Z) faces the map centre (yaw snapped to 90), otherwise yaw 0.
	All helpers below take the plot position (signatures unchanged) and derive the yaw from it, so callers never pass it.

	Yaw convention (matches CFrame.Angles(0, yaw, 0)): a building's local +Z (its FRONT) maps to world
	(sin yaw, 0, cos yaw). Yaw 0 = faces +Z (plot front / main gate), 90 = +X, -90 = -X, 180 = -Z.

	Heights: the site frame sits at the plot pad CENTRE height. Part-kit offsets were authored against the
	old 1.2-tall plinth (kit bottoms at local ≈ +0.5..+0.6), so at pad-centre height they land on the pad
	top (pad is 1 stud thick) instead of floating where the plinth used to be.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)

local BaseLayout = {}

BaseLayout.CONSOLE_SIZE = Vector3.new(2.6, 3.4, 1.4)
local PAD_HALF_HEIGHT = 0.5 -- MapSetup PlotPad is 1 stud thick, centred on the plot position

function BaseLayout.Enabled(): boolean
	return BaseLayoutConfig.Enabled == true
end

function BaseLayout.Config(): any
	return BaseLayoutConfig
end

function BaseLayout.PlotSize(default: number): number
	if BaseLayout.Enabled() then
		return BaseLayoutConfig.PlotSize
	end
	return default
end

function BaseLayout.Site(structureId: string): any?
	if not BaseLayout.Enabled() then
		return nil
	end
	return (BaseLayoutConfig.Structures :: any)[structureId]
end

-- v70: true when plots are turned to face the map centre (waterways layout)
function BaseLayout.FacesMapCentre(): boolean
	return BaseLayout.Enabled() and (BaseLayoutConfig :: any).FaceMapCentre == true
end

-- v70: plot yaw in degrees (0 / 90 / -90 / 180). Front (main gate) toward the map centre.
function BaseLayout.PlotYaw(plotPos: Vector3): number
	if not BaseLayout.FacesMapCentre() then
		return 0
	end
	local x, z = plotPos.X, plotPos.Z
	if math.abs(x) < 1 and math.abs(z) < 1 then
		return 0
	end
	if math.abs(x) >= math.abs(z) then
		return if x < 0 then 90 else -90
	end
	return if z < 0 then 0 else 180
end

-- Exact quarter-turn rotation (no 6e-17 noise from cos(pi/2)), same matrix as CFrame.Angles(0, rad(yaw), 0).
local function yawRotation(yaw: number): CFrame
	local c = if yaw == 0 then 1 elseif yaw == 180 or yaw == -180 then -1 else 0
	local s = if yaw == 90 then 1 elseif yaw == -90 then -1 else 0
	if c == 0 and s == 0 then
		return CFrame.Angles(0, math.rad(yaw), 0)
	end
	return CFrame.new(0, 0, 0, c, 0, s, 0, 1, 0, -s, 0, c)
end

-- v70: plot frame at the plot position (pad centre height). World = PlotCFrame(plotPos) * plot-local.
function BaseLayout.PlotCFrame(plotPos: Vector3): CFrame
	return CFrame.new(plotPos) * yawRotation(BaseLayout.PlotYaw(plotPos))
end

-- v70: unit vector of the plot FRONT (local +Z) in world space
function BaseLayout.PlotForward(plotPos: Vector3): Vector3
	return BaseLayout.PlotCFrame(plotPos):VectorToWorldSpace(Vector3.new(0, 0, 1))
end

-- Rotate a plot-local (x, z) offset by yaw degrees (same convention as CFrame.Angles(0, yaw, 0)).
function BaseLayout.Rotate(x: number, z: number, yawDeg: number): (number, number)
	local a = math.rad(yawDeg)
	return x * math.cos(a) + z * math.sin(a), -x * math.sin(a) + z * math.cos(a)
end

-- Plot-local point → world (y relative to plotPos.Y). v70: turned by the plot yaw.
function BaseLayout.PlotPoint(plotPos: Vector3, x: number, z: number, y: number?): Vector3
	return BaseLayout.PlotCFrame(plotPos):PointToWorldSpace(Vector3.new(x, y or 0, z))
end

-- v70: plot-local CFrame → world. yawDeg turns the part inside the plot (same convention as Site.Yaw).
function BaseLayout.PlotLocalCFrame(plotPos: Vector3, x: number, y: number, z: number, yawDeg: number?): CFrame
	local cf = BaseLayout.PlotCFrame(plotPos) * CFrame.new(x, y, z)
	if yawDeg and yawDeg ~= 0 then
		cf *= CFrame.Angles(0, math.rad(yawDeg), 0)
	end
	return cf
end

local function r2(v: number): number
	return math.round(v * 100) / 100
end

-- v70: plot-local axis-aligned rect (centre cx, cz; size sx, sz) → world centre (y = plotPos.Y) and world X/Z sizes.
-- For water and other parts that must stay axis-aligned in the world: build them with CFrame.new(centre) and the
-- returned sizes (swapped for yaw +-90) instead of rotating them.
function BaseLayout.PlotRect(plotPos: Vector3, cx: number, cz: number, sx: number, sz: number): (Vector3, number, number)
	local c = BaseLayout.PlotPoint(plotPos, cx, cz)
	c = Vector3.new(r2(c.X), plotPos.Y, r2(c.Z))
	if BaseLayout.PlotYaw(plotPos) % 180 ~= 0 then
		return c, sz, sx
	end
	return c, sx, sz
end

-- Site frame for a structure at pad-centre height (kit offsets are relative to this).
function BaseLayout.SiteCFrame(plotPos: Vector3, structureId: string): CFrame?
	local s = BaseLayout.Site(structureId)
	if not s then
		return nil
	end
	return BaseLayout.PlotLocalCFrame(plotPos, s.Site.X, 0, s.Site.Z, s.Yaw or 0)
end

-- Console (upgrade slot) CFrame. Walk-in: inside the building near the door, facing the room.
-- Outdoor: kiosk on the pad, facing the plot centre.
function BaseLayout.ConsoleCFrame(plotPos: Vector3, structureId: string): CFrame?
	local s = BaseLayout.Site(structureId)
	if not s then
		return nil
	end
	local h = BaseLayout.CONSOLE_SIZE.Y
	if s.WalkIn and s.Console then
		local site = BaseLayout.PlotLocalCFrame(plotPos, s.Site.X, PAD_HALF_HEIGHT, s.Site.Z, s.Yaw or 0)
		-- building floor top is 0.4 above the pad (HollowBuildingBuilder); face local -X (into the room)
		return site * CFrame.new(s.Console.X, 0.4 + h * 0.5, s.Console.Z) * CFrame.Angles(0, math.rad(90), 0)
	end
	local k = s.Kiosk or s.Site
	local at = BaseLayout.PlotPoint(plotPos, k.X, k.Z, PAD_HALF_HEIGHT + h * 0.5)
	local centre = Vector3.new(plotPos.X, at.Y, plotPos.Z)
	if (centre - at).Magnitude < 1 then
		return CFrame.new(at)
	end
	return CFrame.lookAt(at, centre)
end

-- Plot-local point → world, on the pad top.
function BaseLayout.GroundPoint(plotPos: Vector3, x: number, z: number, lift: number?): Vector3
	return BaseLayout.PlotPoint(plotPos, x, z, PAD_HALF_HEIGHT + (lift or 0))
end

return BaseLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">DesertFlora</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — DesertFlora (procedural Part-kit vegetation)
	Saguaro / Joshua / palm / barrel cactus / dry grass tufts.
	Inspiration-only desert tycoon look — original Part kits, mobile-friendly counts.
	Called from MapSetup.Run after MapDressing (deferred).
	CanCollide false; CastShadow false on ALL flora (Studio/laptop perf).
	Sparse mode default — ~70% fewer plants than prior dense pass.
	v70 waterways (spec_final §9): no plant in the water or on a plot pad (spots there are skipped whole);
	Waterways.CullDressing is the safety net at the end.
]]

local DesertFlora = {}

local GROUND_TOP_Y = 0.5
local HALF = 3200 -- matches MapSetup GROUND_SIZE/2

local COL = {
	Cactus = Color3.fromRGB(62, 110, 58),
	CactusDark = Color3.fromRGB(48, 88, 48),
	CactusLight = Color3.fromRGB(78, 130, 72),
	JoshuaTrunk = Color3.fromRGB(95, 78, 52),
	JoshuaLeaf = Color3.fromRGB(70, 95, 45),
	PalmTrunk = Color3.fromRGB(110, 85, 55),
	PalmLeaf = Color3.fromRGB(55, 120, 55),
	Barrel = Color3.fromRGB(72, 105, 55),
	Grass = Color3.fromRGB(150, 130, 70),
	GrassDry = Color3.fromRGB(170, 145, 85),
	Rock = Color3.fromRGB(160, 110, 75),
}

-- v70: Modules/Waterways (water rects + dressing cull), loaded lazily so a Waterways error never blocks MapSetup
local waterwaysMod: any = nil
local function getWaterways(): any?
	if waterwaysMod == nil then
		local ok, m = pcall(function(): any
			return require(script.Parent.Waterways) :: any
		end)
		waterwaysMod = if ok and type(m) == "table" then m else false
	end
	return if waterwaysMod then waterwaysMod else nil
end

local function onWaterOrPlot(pos: Vector3, margin: number): boolean
	local ww = getWaterways()
	if not ww then
		return false
	end
	local ok, res = pcall(function(): boolean
		return ww.IsWaterXZ(pos.X, pos.Z, margin) or ww.IsOnPlotPadXZ(pos.X, pos.Z, margin)
	end)
	return ok and res == true
end

local function ensureFolder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function p(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = if props.CastShadow ~= nil then props.CastShadow else false -- deco: never cast shadows (Studio perf)
	if props.Name then
		part.Name = props.Name
	end
	if props.Size then
		part.Size = props.Size
	end
	if props.CFrame then
		part.CFrame = props.CFrame
	elseif props.Position then
		part.Position = props.Position
	end
	if props.Color then
		part.Color = props.Color
	end
	if props.Material then
		part.Material = props.Material
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	part:SetAttribute("WE_Decor", true)
	part:SetAttribute("WE_Flora", true)
	return part
end

local function kitSaguaro(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local h = 10 * s
	p({
		Name = "SaguaroTrunk",
		Size = Vector3.new(1.4 * s, h, 1.4 * s),
		Position = origin + Vector3.new(0, h * 0.5, 0),
		Color = COL.Cactus,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	-- Arms
	local armY = h * 0.55
	p({
		Name = "SaguaroArmL",
		Size = Vector3.new(0.9 * s, 4.2 * s, 0.9 * s),
		CFrame = CFrame.new(origin + Vector3.new(-1.6 * s, armY + 1.2 * s, 0)),
		Color = COL.CactusDark,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	p({
		Name = "SaguaroElbowL",
		Size = Vector3.new(2.2 * s, 0.85 * s, 0.85 * s),
		Position = origin + Vector3.new(-0.9 * s, armY, 0),
		Color = COL.Cactus,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	if s > 0.85 then
		p({
			Name = "SaguaroArmR",
			Size = Vector3.new(0.85 * s, 3.4 * s, 0.85 * s),
			Position = origin + Vector3.new(1.5 * s, armY + 0.6 * s, 0.2 * s),
			Color = COL.CactusLight,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		p({
			Name = "SaguaroElbowR",
			Size = Vector3.new(2.0 * s, 0.8 * s, 0.8 * s),
			Position = origin + Vector3.new(0.85 * s, armY - 0.4 * s, 0.2 * s),
			Color = COL.Cactus,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
	end
end

local function kitJoshua(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local trunkH = 7 * s
	p({
		Name = "JoshuaTrunk",
		Size = Vector3.new(1.1 * s, trunkH, 1.1 * s),
		Position = origin + Vector3.new(0, trunkH * 0.5, 0),
		Color = COL.JoshuaTrunk,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	-- Forked branches + spiky leaf clusters
	local forks = {
		{ 1.8, 0.6, 0.4, 25 },
		{ -1.6, 0.4, -0.5, -30 },
		{ 0.3, 1.0, 1.5, 10 },
	}
	for i, f in ipairs(forks) do
		local bx, by, bz, yaw = f[1] * s, trunkH * 0.55 + f[2] * s, f[3] * s, f[4]
		p({
			Name = "JoshuaFork" .. i,
			Size = Vector3.new(0.7 * s, 3.2 * s, 0.7 * s),
			CFrame = CFrame.new(origin + Vector3.new(bx, by + 1.2 * s, bz)) * CFrame.Angles(0, math.rad(yaw), math.rad(18)),
			Color = COL.JoshuaTrunk,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
		p({
			Name = "JoshuaLeaf" .. i,
			Size = Vector3.new(2.4 * s, 0.35 * s, 2.4 * s),
			Position = origin + Vector3.new(bx, by + 2.8 * s, bz),
			Color = COL.JoshuaLeaf,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
	end
end

local function kitPalm(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local trunkH = 12 * s
	p({
		Name = "PalmTrunk",
		Size = Vector3.new(1.2 * s, trunkH, 1.2 * s),
		Position = origin + Vector3.new(0, trunkH * 0.5, 0),
		Color = COL.PalmTrunk,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	-- Fronds as radial slabs
	for i = 0, 5 do
		local ang = i * 60
		p({
			Name = "PalmFrond" .. i,
			Size = Vector3.new(0.35 * s, 0.25 * s, 5.5 * s),
			CFrame = CFrame.new(origin + Vector3.new(0, trunkH + 0.2 * s, 0))
				* CFrame.Angles(0, math.rad(ang), 0)
				* CFrame.new(0, 0, -2.2 * s)
				* CFrame.Angles(math.rad(-25), 0, 0),
			Color = COL.PalmLeaf,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
	end
	p({
		Name = "PalmCrown",
		Size = Vector3.new(1.6 * s, 1.0 * s, 1.6 * s),
		Position = origin + Vector3.new(0, trunkH + 0.4 * s, 0),
		Color = COL.PalmLeaf,
		Material = Enum.Material.Grass,
		Parent = folder,
	})
end

local function kitBarrel(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	p({
		Name = "BarrelBody",
		Size = Vector3.new(2.4 * s, 2.2 * s, 2.4 * s),
		CFrame = CFrame.new(origin + Vector3.new(0, 1.1 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COL.Barrel,
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	p({
		Name = "BarrelTop",
		Size = Vector3.new(1.6 * s, 0.5 * s, 1.6 * s),
		Position = origin + Vector3.new(0, 2.3 * s, 0),
		Color = COL.CactusLight,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function kitGrassTuft(folder: Folder, origin: Vector3)
	for i = 0, 2 do
		local ox = (i - 1) * 0.55
		p({
			Name = "GrassBlade",
			Size = Vector3.new(0.25, 1.4 + (i % 2) * 0.5, 0.25),
			CFrame = CFrame.new(origin + Vector3.new(ox, 0.9, (i % 2) * 0.3))
				* CFrame.Angles(0, math.rad(i * 40), math.rad(8)),
			Color = if i % 2 == 0 then COL.Grass else COL.GrassDry,
			Material = Enum.Material.Grass,
			CastShadow = false,
			Parent = folder,
		})
	end
end

local function kitRockOutcrop(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	p({
		Name = "Outcrop",
		Size = Vector3.new(8 * s, 3.5 * s, 6 * s),
		Position = origin + Vector3.new(0, 1.6 * s, 0),
		Color = COL.Rock,
		Material = Enum.Material.Sandstone,
		CanCollide = true,
		Parent = folder,
	})
	p({
		Name = "OutcropCap",
		Size = Vector3.new(5 * s, 1.8 * s, 4 * s),
		Position = origin + Vector3.new(1.2 * s, 3.8 * s, -0.5 * s),
		Color = COL.Rock:Lerp(Color3.fromRGB(180, 130, 90), 0.3),
		Material = Enum.Material.Sandstone,
		CanCollide = false,
		Parent = folder,
	})
end

local function placeAt(folder: Folder, name: string, pos: Vector3, builder: (Folder, Vector3, number?) -> (), scale: number?)
	if onWaterOrPlot(pos, 6) then
		return -- v70: never a plant in the water or on a plot pad
	end
	local cluster = Instance.new("Folder")
	cluster.Name = name
	cluster.Parent = folder
	builder(cluster, pos, scale)
end

function DesertFlora.Dress(root: Instance, opts: { Sparse: boolean? }?)
	local flora = ensureFolder("DesertFlora", root)
	local sparse = if opts and opts.Sparse ~= nil then opts.Sparse else true

	-- PERF: sparse by default. CastShadow=false on all flora parts (see p()).
	local rimCount = if sparse then 6 else 14
	local rimR = HALF - 180
	for i = 1, rimCount do
		local ang = (i / rimCount) * math.pi * 2
		local jitter = ((i * 37) % 50) - 25
		local r = rimR + jitter
		local pos = Vector3.new(math.cos(ang) * r, GROUND_TOP_Y, math.sin(ang) * r)
		local kind = i % 4
		if kind == 0 then
			placeAt(flora, "Saguaro_Rim_" .. i, pos, kitSaguaro, 0.9)
		elseif kind == 1 then
			placeAt(flora, "Joshua_Rim_" .. i, pos, kitJoshua, 0.95)
		elseif kind == 2 then
			placeAt(flora, "Palm_Rim_" .. i, pos, kitPalm, 0.8)
		else
			placeAt(flora, "Barrel_Rim_" .. i, pos, kitBarrel, 0.95)
		end
	end

	-- Mid-map: drastically cut (was 10 dual plants → 2–4 singles)
	local midSpots = if sparse
		then {
			Vector3.new(480, GROUND_TOP_Y, 520),
			Vector3.new(900, GROUND_TOP_Y, -900),
		}
		else {
			Vector3.new(350, GROUND_TOP_Y, 180),
			Vector3.new(180, GROUND_TOP_Y, -480),
			Vector3.new(620, GROUND_TOP_Y, -80),
			Vector3.new(480, GROUND_TOP_Y, 520),
			Vector3.new(1100, GROUND_TOP_Y, 200),
			Vector3.new(900, GROUND_TOP_Y, -900),
		}
	for i, pos in ipairs(midSpots) do
		if i % 2 == 0 then
			placeAt(flora, "Saguaro_Mid_" .. i, pos, kitSaguaro, 1.0)
		else
			placeAt(flora, "Palm_Mid_" .. i, pos, kitPalm, 0.95)
		end
		if not sparse and i == 1 then
			placeAt(flora, "Rock_Mid_" .. i, pos + Vector3.new(10, 0, -8), kitRockOutcrop, 0.9)
			local tuft = Instance.new("Folder")
			tuft.Name = "Grass_Mid_" .. i
			tuft.Parent = flora
			kitGrassTuft(tuft, pos + Vector3.new(-6, 0, 5))
		end
	end

	-- v70: the plot-adjacent palms (Palm_Plot_*, plot + (110, 0, 40)) are gone: at the 320 layout they stood inside the
	-- east building row of the base.

	-- Catalog overlays: DesertPlants / Palm(+PalmAlt) / Cactus / DesertRock MeshPart
	-- Cap attempts so PERF stays Part-kit-first even on live.
	do
		local attached = 0
		local maxAttach = if sparse then 6 else 18
		local okVas, vas = pcall(function()
			return require(script.Parent.Parent.Services.VisualAssetService)
		end)
		if okVas and vas and vas.IsInsertEnabled and vas.IsInsertEnabled() then
			for _, d in ipairs(flora:GetDescendants()) do
				if attached >= maxAttach then
					break
				end
				if d:IsA("BasePart") then
					local key: string? = nil
					if d.Name == "SaguaroTrunk" then
						key = if attached % 3 == 0 then "DesertPlants" elseif attached % 3 == 1 then "Cactus" else "CactusBase"
					elseif d.Name == "PalmTrunk" then
						key = "Palm" -- PalmAlt fallback inside TryAttachPropVisual
					elseif d.Name == "Outcrop" or d.Name == "OutcropCap" then
						key = "DesertRock"
					end
					if key then
						local okAtt = pcall(function()
							return vas.TryAttachPropVisual(d, key :: string)
						end)
						if okAtt then
							attached += 1
						end
					end
				end
			end
			if attached > 0 then
				print("[WAR EMPIRE] DesertFlora catalog props attached:", attached)
			end
		end
	end

	-- v70 safety net (spec §9.12): nothing in the water or on a plot pad
	local ww = getWaterways()
	if ww then
		local okCull, res = pcall(ww.CullDressing, flora)
		if not okCull then
			warn("[DesertFlora] water cull failed:", res)
		end
	end

	local partCount = 0
	for _, d in ipairs(flora:GetDescendants()) do
		if d:IsA("BasePart") then
			partCount += 1
			d.CastShadow = false
		end
	end
	print("[WAR EMPIRE] DesertFlora complete: " .. tostring(partCount) .. " flora parts (sparse=" .. tostring(sparse) .. ", CastShadow=false)")
end

return DesertFlora
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">HollowBuildingBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Walk-in structures. Config: StructureVisualConfig.HollowBuildings (Defaults + one entry per structure).

	Builds Model "WE_Building" under the structure's upgrade slot:
	  shell     real doorway (or wide garage door), glass windows, floor, flat roof + parapet, entrance, sign
	  levels    TwoStoryLevel → second storey + interior stairs; AnnexLevel → side annex, mast, floodlights;
	            RoofAccessLevel → truss ladder through a roof hatch + dish; GoldCapLevel → gold parapet; flag
	  interior  Modules/Interiors/<Interior>.luau — function(ictx, api) that furnishes the rooms
	            (ictx = geometry + keep-out zones, api = building-local part helpers + item terminals)

	v68: with BaseLayoutConfig the building is centred on its site (WE_SiteCFrame) and bought/upgraded at the
	console inside it. Legacy (no site): it sits behind its pad with the doorway shifted clear of the pad.

	The kit's "Body" part is only the foundation slab (see StructureKitBuilder), so EnsureKit / applyKitVisuals
	invariants (Body exists, solid at L1+) still hold. Everything else lives in the Model and is rebuilt when
	the level changes.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)

local HollowBuildingBuilder = {}

local MODEL_NAME = "WE_Building"
local GEN = 2

type Opening = {
	Center: number, -- along the wall's local X
	Width: number,
	Bottom: number, -- above the wall base
	Height: number,
	Glass: boolean,
	Garage: boolean?,
}

type Ctx = {
	model: Model,
	origin: CFrame,
	c: any,
	col: any,
	level: number,
	structureId: string,
}

export type Rect = { X0: number, X1: number, Z0: number, Z1: number }

local function merged(defaults: any, specific: any): any
	local out = {}
	if typeof(defaults) == "table" then
		for k, v in pairs(defaults) do
			out[k] = v
		end
	end
	for k, v in pairs(specific) do
		out[k] = v
	end
	local colors = {}
	if typeof(defaults) == "table" and typeof(defaults.Colors) == "table" then
		for k, v in pairs(defaults.Colors) do
			colors[k] = v
		end
	end
	if typeof(specific.Colors) == "table" then
		for k, v in pairs(specific.Colors) do
			colors[k] = v
		end
	end
	out.Colors = colors
	return out
end

local function cfgFor(structureId: string): any?
	local all = (StructureVisualConfig :: any).HollowBuildings
	if typeof(all) ~= "table" or structureId == "Defaults" then
		return nil
	end
	local c = all[structureId]
	if typeof(c) ~= "table" or c.Enabled == false then
		return nil
	end
	return merged(all.Defaults, c)
end

-- v68 outdoor installations (StructureVisualConfig.Installations): not walk-in shells but a detailed model
-- from Modules/Installations/<Module>.luau on the same foundation slab. Needs BaseLayoutConfig (site frames).
local function instCfgFor(structureId: string): any?
	if not BaseLayoutConfig.Enabled then
		return nil
	end
	local all = (StructureVisualConfig :: any).Installations
	if typeof(all) ~= "table" then
		return nil
	end
	local c = all[structureId]
	if typeof(c) ~= "table" or c.Enabled == false then
		return nil
	end
	local hb = (StructureVisualConfig :: any).HollowBuildings
	return merged(if typeof(hb) == "table" then hb.Defaults else nil, c)
end

function HollowBuildingBuilder.IsHollow(structureId: string): boolean
	return cfgFor(structureId) ~= nil or instCfgFor(structureId) ~= nil
end

function HollowBuildingBuilder.IsInstallation(structureId: string): boolean
	return cfgFor(structureId) == nil and instCfgFor(structureId) ~= nil
end

local function groundY(plinth: BasePart): number
	local parent = plinth.Parent
	local pad = parent and parent:FindFirstChild("PlotPad")
	if pad and pad:IsA("BasePart") then
		return pad.Position.Y + pad.Size.Y * 0.5
	end
	local bs = plinth:GetAttribute("BaseSize")
	local h = if typeof(bs) == "Vector3" then (bs :: Vector3).Y else plinth.Size.Y
	return plinth.Position.Y - h * 0.5
end

local function siteCFrame(plinth: BasePart): CFrame?
	local cf = plinth:GetAttribute("WE_SiteCFrame")
	if typeof(cf) == "CFrame" then
		return cf
	end
	return nil
end

-- Offset of the footprint centre from the kit frame (StructureKitBuilder site frame), at ground level.
-- v68 layout: the building is centred on its site. Legacy pads: behind the pad, shifted sideways.
local function footprintOffset(plinth: BasePart, c: any): Vector3
	local gy = groundY(plinth)
	local site = siteCFrame(plinth)
	if site then
		return Vector3.new(0, gy - site.Position.Y, 0)
	end
	return Vector3.new(c.OffsetX or 0, gy - plinth.Position.Y, -((c.FrontGap or 10) + c.Depth * 0.5))
end

local function originFor(plinth: BasePart, c: any): CFrame
	local site = siteCFrame(plinth)
	if site then
		return site * CFrame.new(footprintOffset(plinth, c))
	end
	local rot = plinth.CFrame - plinth.CFrame.Position
	return CFrame.new(plinth.Position) * rot * CFrame.new(footprintOffset(plinth, c))
end

--[[ Foundation slab for StructureKitBuilder's "Body": (size, local offset in the kit frame). ]]
function HollowBuildingBuilder.FoundationSpec(plinth: BasePart, structureId: string): (Vector3?, Vector3?)
	local c = cfgFor(structureId) or instCfgFor(structureId)
	if not c then
		return nil, nil
	end
	return Vector3.new(c.Width, 0.8, c.Depth), footprintOffset(plinth, c)
end

function HollowBuildingBuilder.FoundationColor(structureId: string): Color3?
	local c = cfgFor(structureId) or instCfgFor(structureId)
	return if c and c.Colors then c.Colors.Floor else nil
end

-- ── primitives ──────────────────────────────────────────────────────────────

local function part(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = if collide == nil then true else collide
	p.CanTouch = false
	-- Walls/floors stay queryable so weapon raycasts and camera occlusion treat the building as solid.
	p.CanQuery = p.CanCollide
	p.CastShadow = true
	p.Parent = ctx.model
	return p
end

local function box(ctx: Ctx, name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material, collide: boolean?): Part
	return part(ctx, name, size, ctx.origin * CFrame.new(pos), color, material, collide)
end

local LIGHTS = (StructureVisualConfig :: any).BuildingLights or {}
local FIXTURE_MATERIAL: Enum.Material = LIGHTS.FixtureMaterial or Enum.Material.Neon

local function light(host: BasePart, range: number, brightness: number, color: Color3)
	local l = Instance.new("PointLight")
	l.Range = math.min(range, LIGHTS.MaxRange or range)
	l.Brightness = brightness * (LIGHTS.BrightnessScale or 1)
	l.Color = color
	l.Shadows = false
	l.Parent = host
end

--[[ v70 light budget (HUD spec §5, mobile P1-12; CLAUDE.md: at most 40 lights per base at L5, was 120). The fitting
	parts all stay; only these carry no PointLight:
	  - ceiling fittings other than the one nearest each floor's centre (one light per floor);
	  - entry lamps and terminal lamps (the lamp part still reads as lit);
	  - red warning beacons on masts / pylons / towers (WARNING_BEACONS);
	  - every second fitting of the same name inside one interior / installation module (a row of 3 hangar lamps
	    keeps 2, a pair of floodlamps keeps 1).
	StructureVisualConfig.BuildingLights.LightEveryOther = false turns the last rule off. ]]
local WARNING_BEACONS: { [string]: boolean } = { TowerBeacon = true, PylonBeacon = true, TowerLamp = true, MastBeacon = true }
local TERMINAL_PROMPT_RANGE = 12 -- mobile P1-19: 8 → 12 studs (the thumbstick overshoots a small range)

-- v70: every SurfaceGui draws near-only (CLAUDE.md budget: MaxDistance <= 80). Screens and signs inside a building
-- only need the room (SURFACE_NEAR); outdoor building / installation signs SURFACE_FAR.
local SURFACE_NEAR = 40
local SURFACE_FAR = 80

local function surfaceText(host: BasePart, face: Enum.NormalId, lines: { string }, textColor: Color3, bg: Color3, font: Enum.Font?, maxDistance: number?)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_Screen"
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.MaxDistance = math.min(maxDistance or SURFACE_NEAR, SURFACE_FAR)
	sg.Parent = host
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = bg
	frame.BorderSizePixel = 0
	frame.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame
	for i, text in ipairs(lines) do
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.fromScale(1, 1 / #lines)
		lbl.LayoutOrder = i
		lbl.Font = font or Enum.Font.GothamBold
		lbl.Text = text
		lbl.TextColor3 = textColor
		lbl.TextScaled = true
		lbl.Parent = frame
	end
end

--[[
	Wall along its local X (length len) with base at y=baseY in wallCF space; thickness along local Z,
	local +Z = outside. Openings are cut as piers / sills / lintels; glass openings get a pane + ledge,
	doorways get a metal frame, garage openings a striped frame + rolled shutter drum.
]]
local function wall(ctx: Ctx, name: string, wallCF: CFrame, len: number, height: number, baseY: number, openings: { Opening })
	local c = ctx.c
	local col = ctx.col
	local t = c.WallThickness
	table.sort(openings, function(a, b)
		return a.Center < b.Center
	end)
	local x0 = -len * 0.5
	local x1 = len * 0.5
	local function seg(a: number, b: number, y0: number, y1: number)
		if b - a < 0.05 or y1 - y0 < 0.05 then
			return
		end
		part(ctx, name, Vector3.new(b - a, y1 - y0, t), wallCF * CFrame.new((a + b) * 0.5, (y0 + y1) * 0.5, 0), col.Wall, Enum.Material.Concrete)
	end
	local cursor = x0
	for _, o in ipairs(openings) do
		local oa = math.max(x0, o.Center - o.Width * 0.5)
		local ob = math.min(x1, o.Center + o.Width * 0.5)
		if oa >= cursor then
			seg(cursor, oa, baseY, baseY + height)
			seg(oa, ob, baseY, baseY + o.Bottom)
			seg(oa, ob, baseY + o.Bottom + o.Height, baseY + height)
			local w = ob - oa
			local midY = baseY + o.Bottom + o.Height * 0.5
			if o.Glass then
				local pane = part(ctx, name .. "Glass", Vector3.new(w, o.Height, 0.2), wallCF * CFrame.new((oa + ob) * 0.5, midY, 0), col.Glass, Enum.Material.Glass)
				pane.Transparency = 0.45
				pane.Reflectance = 0.08
				pane.CastShadow = false
				part(ctx, name .. "Mullion", Vector3.new(0.2, o.Height, 0.3), wallCF * CFrame.new((oa + ob) * 0.5, midY, 0), col.Trim, Enum.Material.Metal, false)
				part(ctx, name .. "Ledge", Vector3.new(w + 0.6, 0.3, 0.7), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom - 0.15, t * 0.5 + 0.2), col.Trim, Enum.Material.Metal, false)
			elseif o.Garage then
				local frameT = t + 0.4
				for _, edge in ipairs({ oa + 0.3, ob - 0.3 }) do
					part(ctx, name .. "GarageFrame", Vector3.new(0.6, o.Height, frameT), wallCF * CFrame.new(edge, midY, 0), col.Accent, Enum.Material.SmoothPlastic, false)
				end
				part(ctx, name .. "GarageHeader", Vector3.new(w, 0.6, frameT), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom + o.Height - 0.3, 0), col.Metal, Enum.Material.Metal, false)
				local drum = part(ctx, name .. "ShutterDrum", Vector3.new(w - 0.6, 1.4, 1.4), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom + o.Height - 0.5, -t * 0.5 - 0.7), col.Metal, Enum.Material.DiamondPlate, false)
				drum.Shape = Enum.PartType.Cylinder
			else
				local frameT = t + 0.3
				part(ctx, name .. "DoorFrame", Vector3.new(0.35, o.Height, frameT), wallCF * CFrame.new(oa + 0.175, midY, 0), col.Metal, Enum.Material.Metal, false)
				part(ctx, name .. "DoorFrame", Vector3.new(0.35, o.Height, frameT), wallCF * CFrame.new(ob - 0.175, midY, 0), col.Metal, Enum.Material.Metal, false)
				part(ctx, name .. "DoorFrame", Vector3.new(w, 0.35, frameT), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom + o.Height - 0.175, 0), col.Metal, Enum.Material.Metal, false)
			end
			cursor = ob
		end
	end
	seg(cursor, x1, baseY, baseY + height)
end

-- Horizontal slab in building space with an optional rectangular hole (hx0, hx1, hz0, hz1).
local function slab(ctx: Ctx, name: string, x0: number, x1: number, z0: number, z1: number, yBottom: number, thick: number, color: Color3, material: Enum.Material, hole: { number }?)
	local function piece(a0: number, a1: number, b0: number, b1: number)
		if a1 - a0 < 0.05 or b1 - b0 < 0.05 then
			return
		end
		box(ctx, name, Vector3.new(a1 - a0, thick, b1 - b0), Vector3.new((a0 + a1) * 0.5, yBottom + thick * 0.5, (b0 + b1) * 0.5), color, material)
	end
	if not hole then
		piece(x0, x1, z0, z1)
		return
	end
	local hx0 = math.clamp(hole[1], x0, x1)
	local hx1 = math.clamp(hole[2], x0, x1)
	local hz0 = math.clamp(hole[3], z0, z1)
	local hz1 = math.clamp(hole[4], z0, z1)
	piece(x0, x1, z0, hz0)
	piece(x0, x1, hz1, z1)
	piece(x0, hx0, hz0, hz1)
	piece(hx1, x1, hz0, hz1)
end

local function railing(ctx: Ctx, a: Vector3, b: Vector3, height: number)
	local col = ctx.col
	local dir = b - a
	local len = dir.Magnitude
	if len < 0.1 then
		return
	end
	local mid = (a + b) * 0.5
	local look = CFrame.lookAt(mid, mid + dir) -- local -Z along the rail
	part(ctx, "Rail", Vector3.new(0.25, 0.25, len), ctx.origin * look * CFrame.new(0, height, 0), col.Metal, Enum.Material.Metal)
	part(ctx, "Rail", Vector3.new(0.18, 0.18, len), ctx.origin * look * CFrame.new(0, height * 0.5, 0), col.Metal, Enum.Material.Metal, false)
	local posts = math.max(2, math.floor(len / 3) + 1)
	for i = 0, posts - 1 do
		local p = a + dir * (i / (posts - 1))
		box(ctx, "RailPost", Vector3.new(0.25, height, 0.25), p + Vector3.new(0, height * 0.5, 0), col.Metal, Enum.Material.Metal, false)
	end
end

-- facing: unit X or Z direction the sitter looks toward (backrest goes on the opposite side)
local function chair(ctx: Ctx, pos: Vector3, facing: Vector3)
	local col = ctx.col
	local backSize = if math.abs(facing.X) > 0.5 then Vector3.new(0.3, 1.8, 1.6) else Vector3.new(1.6, 1.8, 0.3)
	box(ctx, "ChairLeg", Vector3.new(0.3, 1.5, 0.3), pos + Vector3.new(0, 0.75, 0), col.Metal, Enum.Material.Metal, false)
	box(ctx, "ChairSeat", Vector3.new(1.6, 0.3, 1.6), pos + Vector3.new(0, 1.65, 0), col.Dark, Enum.Material.Fabric)
	box(ctx, "ChairBack", backSize, pos - facing * 0.65 + Vector3.new(0, 2.7, 0), col.Dark, Enum.Material.Fabric, false)
end

local function sandbags(ctx: Ctx, x0: number, x1: number, z: number, baseY: number)
	local col = ctx.col
	local n = math.max(1, math.floor((x1 - x0) / 2.1))
	local w = (x1 - x0) / n
	for i = 0, n - 1 do
		box(ctx, "Sandbag", Vector3.new(w - 0.1, 1.0, 1.5), Vector3.new(x0 + w * (i + 0.5), baseY + 0.5, z), col.Sandbag, Enum.Material.Fabric)
	end
	for i = 0, n - 2 do
		box(ctx, "Sandbag", Vector3.new(w - 0.1, 1.0, 1.4), Vector3.new(x0 + w * (i + 1), baseY + 1.5, z), col.Sandbag, Enum.Material.Fabric)
	end
end

--[[ Item terminal: a floor-standing screen with a ProximityPrompt that opens a client panel
	(attribute WE_OpenPanel on the prompt; ClientBootstrap routes it). Not an upgrade slot. ]]
local function terminal(ctx: Ctx, name: string, pos: Vector3, facingDeg: number, panel: string, actionText: string, objectText: string, screenLines: { string }?): Part
	local col = ctx.col
	local frame = ctx.origin * CFrame.new(pos) * CFrame.Angles(0, math.rad(facingDeg), 0)
	local body = part(ctx, name, Vector3.new(2.4, 3.2, 1.2), frame * CFrame.new(0, 1.6, 0), col.Dark, Enum.Material.Metal)
	local screen = part(ctx, name .. "Screen", Vector3.new(2.1, 1.3, 0.14), frame * CFrame.new(0, 3.55, 0.3) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(10, 24, 14), Enum.Material.SmoothPlastic, false)
	surfaceText(screen, Enum.NormalId.Back, screenLines or { string.upper(objectText), "TAP TO OPEN" }, col.Screen, Color3.fromRGB(8, 20, 12), Enum.Font.GothamBold)
	-- the lamp is a small interactive cue (kept Neon, spec §5); no PointLight (v70 light budget)
	part(ctx, name .. "Lamp", Vector3.new(0.4, 0.2, 0.4), frame * CFrame.new(0.8, 3.25, 0.35), col.Screen, Enum.Material.Neon, false)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WE_PanelPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = TERMINAL_PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt:SetAttribute("WE_OpenPanel", panel)
	prompt.Parent = body
	body:SetAttribute("WE_Terminal", panel)
	return body
end

-- Part helpers handed to interior / installation modules (building-local coordinates, parts tagged `tag`).
local function makeApi(ctx: Ctx, tag: string): any
	local function tagged(p: Part): Part
		p:SetAttribute(tag, true)
		return p
	end
	-- v70 light budget (see WARNING_BEACONS): modules call api.light per fitting; the budget rules apply here
	local fittings: { [string]: number } = {}
	local everyOther = LIGHTS.LightEveryOther ~= false
	local function budgetLight(host: BasePart, range: number, brightness: number, color: Color3)
		if WARNING_BEACONS[host.Name] then
			return
		end
		local n = (fittings[host.Name] or 0) + 1
		fittings[host.Name] = n
		if everyOther and n % 2 == 0 then
			return
		end
		light(host, range, brightness, color)
	end
	local api = {
		box = function(name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material, collide: boolean?): Part
			return tagged(box(ctx, name, size, pos, color, material, collide))
		end,
		part = function(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): Part
			return tagged(part(ctx, name, size, ctx.origin * localCF, color, material, collide))
		end,
		light = budgetLight,
		surfaceText = function(host: BasePart, face: Enum.NormalId, lines: { string }, textColor: Color3, bg: Color3, font: Enum.Font?, maxDistance: number?)
			surfaceText(host, face, lines, textColor, bg, font, maxDistance or (if tag == "WE_Installation" then SURFACE_FAR else SURFACE_NEAR))
		end,
		chair = function(pos: Vector3, facing: Vector3)
			local before = #ctx.model:GetChildren()
			chair(ctx, pos, facing)
			local kids = ctx.model:GetChildren()
			for i = before + 1, #kids do
				local k = kids[i]
				if k:IsA("BasePart") then
					k:SetAttribute(tag, true)
				end
			end
		end,
		sandbags = function(x0: number, x1: number, z: number, baseY: number)
			local before = #ctx.model:GetChildren()
			sandbags(ctx, x0, x1, z, baseY)
			local kids = ctx.model:GetChildren()
			for i = before + 1, #kids do
				local k = kids[i]
				if k:IsA("BasePart") then
					k:SetAttribute(tag, true)
				end
			end
		end,
		terminal = function(name: string, pos: Vector3, facingDeg: number, panel: string, actionText: string, objectText: string, screenLines: { string }?): Part
			local before = #ctx.model:GetChildren()
			local body = terminal(ctx, name, pos, facingDeg, panel, actionText, objectText, screenLines)
			local kids = ctx.model:GetChildren()
			for i = before + 1, #kids do
				local k = kids[i]
				if k:IsA("BasePart") then
					k:SetAttribute(tag, true)
				end
			end
			return body
		end,
	}
	-- installations: shaped parts, climbable trusses, client-side spinning groups
	api.cylinder = function(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): Part
		local p = tagged(part(ctx, name, size, ctx.origin * localCF, color, material, collide))
		p.Shape = Enum.PartType.Cylinder -- axis = local X
		return p
	end
	api.ball = function(name: string, diameter: number, pos: Vector3, color: Color3, material: Enum.Material, collide: boolean?): Part
		local p = tagged(box(ctx, name, Vector3.new(diameter, diameter, diameter), pos, color, material, collide))
		p.Shape = Enum.PartType.Ball
		return p
	end
	api.wedge = function(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): WedgePart
		local w = Instance.new("WedgePart")
		w.Name = name
		w.Anchored = true
		w.Size = size
		w.CFrame = ctx.origin * localCF
		w.Color = color
		w.Material = material
		w.CanCollide = if collide == nil then true else collide
		w.CanTouch = false
		w.CanQuery = w.CanCollide
		w:SetAttribute(tag, true)
		w.Parent = ctx.model
		return w
	end
	api.truss = function(name: string, height: number, pos: Vector3, color: Color3): TrussPart
		local tp = Instance.new("TrussPart")
		tp.Name = name
		tp.Anchored = true
		tp.Size = Vector3.new(2, math.max(2, math.floor(height / 2 + 0.5) * 2), 2)
		tp.CFrame = ctx.origin * CFrame.new(pos.X, pos.Y + tp.Size.Y * 0.5, pos.Z)
		tp.Color = color
		tp.Material = Enum.Material.Metal
		tp.CanTouch = false
		tp:SetAttribute(tag, true)
		tp.Parent = ctx.model
		return tp
	end
	-- Group parts that the client spins around a vertical axis through `pivot` (building-local).
	-- Server copies stay still; Client/Modules/WorldSpinners rotates the tagged Model locally.
	api.spin = function(parts: { BasePart }, pivot: Vector3, rpm: number): Model
		local m = Instance.new("Model")
		m.Name = "WE_Spinner"
		m:SetAttribute("WE_SpinPivot", ctx.origin * CFrame.new(pivot))
		m:SetAttribute("WE_SpinRPM", rpm)
		for _, bp in ipairs(parts) do
			bp.Parent = m
		end
		m.Parent = ctx.model
		CollectionService:AddTag(m, "WE_Spinner")
		return m
	end
	return api
end

-- ── building ────────────────────────────────────────────────────────────────

local function consoleLocal(structureId: string): Vector3?
	local s = (BaseLayoutConfig.Structures :: any)[structureId]
	if BaseLayoutConfig.Enabled and s and s.WalkIn and s.Console then
		return Vector3.new(s.Console.X, 0, s.Console.Z)
	end
	return nil
end

local function build(ctx: Ctx)
	local c = ctx.c
	local col = ctx.col
	local lv = ctx.level
	local W, D, t = c.Width, c.Depth, c.WallThickness
	local H1, H2 = c.StoryHeight, c.UpperStoryHeight
	local hw, hd = W * 0.5, D * 0.5
	local twoStory = lv >= c.TwoStoryLevel
	local hasAnnex = lv >= c.AnnexLevel
	local roofAccess = lv >= c.RoofAccessLevel and twoStory
	local helipad = lv >= c.HelipadLevel
	local goldCap = helipad or lv >= (c.GoldCapLevel or 5)
	local garage = c.DoorStyle == "Garage"

	local y1 = 0.4 -- ground floor top (foundation slab = kit Body)
	local y2 = y1 + H1 + 0.8 -- upper floor top
	local roofBottom = if twoStory then y2 + H2 else y1 + H1
	local roofTop = roofBottom + 0.8

	local doorX, doorW, doorH = c.DoorX, c.DoorWidth, c.DoorHeight
	local winW, winH, winBottom = c.WindowWidth, c.WindowHeight, c.WindowBottom

	-- Stairwell (two storeys) along the back wall, climbing toward +X.
	local stairW = 4.5
	local stairRise = y2 - y1
	local stepCount = math.ceil(stairRise / 0.8)
	local stepRise = stairRise / stepCount
	local stepRun = 1.2
	local stairX0 = -hw + t + 0.5
	local stairX1 = stairX0 + stepCount * stepRun
	local stairZ0 = -hd + t
	local stairZ1 = stairZ0 + stairW

	local annexW, annexD, annexH = c.AnnexWidth or 12, c.AnnexDepth or 14, c.AnnexHeight or 9
	local annexZc = -hd + annexD * 0.5

	-- Walls: ground storey
	local frontCF = ctx.origin * CFrame.new(0, 0, hd - t * 0.5)
	local backCF = ctx.origin * CFrame.new(0, 0, -hd + t * 0.5) * CFrame.Angles(0, math.pi, 0)
	local eastCF = ctx.origin * CFrame.new(hw - t * 0.5, 0, 0) * CFrame.Angles(0, math.pi * 0.5, 0) -- local +X = world -Z
	local westCF = ctx.origin * CFrame.new(-hw + t * 0.5, 0, 0) * CFrame.Angles(0, -math.pi * 0.5, 0) -- local +X = world +Z
	local sideLen = D - 2 * t

	local frontOpen: { Opening } = {
		{ Center = doorX, Width = doorW, Bottom = 0, Height = doorH, Glass = false, Garage = garage },
	}
	for _, wx in ipairs(c.FrontWindowsX or {}) do
		table.insert(frontOpen, { Center = wx, Width = winW, Bottom = winBottom, Height = winH, Glass = true })
	end
	wall(ctx, "WallFront", frontCF, W, H1, y1, frontOpen)

	local backOpen: { Opening } = {}
	if not twoStory then
		for _, wx in ipairs(c.BackWindowsX or {}) do
			-- back wall local X is mirrored (rotated 180°)
			table.insert(backOpen, { Center = -wx, Width = winW, Bottom = winBottom, Height = winH, Glass = true })
		end
	end
	wall(ctx, "WallBack", backCF, W, H1, y1, backOpen)

	local westOpen: { Opening } = {}
	for _, wz in ipairs(c.WestWindowsZ or {}) do
		table.insert(westOpen, { Center = wz, Width = winW, Bottom = winBottom, Height = winH, Glass = true })
	end
	wall(ctx, "WallWest", westCF, sideLen, H1, y1, westOpen)

	local eastOpen: { Opening } = {}
	if hasAnnex then
		table.insert(eastOpen, { Center = -annexZc, Width = 4, Bottom = 0, Height = 7.5, Glass = false })
	else
		for _, wz in ipairs(c.EastWindowsZ or {}) do
			table.insert(eastOpen, { Center = -wz, Width = winW, Bottom = winBottom, Height = winH, Glass = true })
		end
	end
	wall(ctx, "WallEast", eastCF, sideLen, H1, y1, eastOpen)

	-- Upper storey
	if twoStory then
		local upFront: { Opening } = {}
		for _, wx in ipairs(c.UpperWindowsX or c.FrontWindowsX or {}) do
			table.insert(upFront, { Center = wx, Width = winW, Bottom = 3.2, Height = 3.0, Glass = true })
		end
		wall(ctx, "WallFront2", frontCF, W, H2, y2, upFront)
		local upBack: { Opening } = {}
		for _, wx in ipairs(c.BackWindowsX or {}) do
			table.insert(upBack, { Center = -wx, Width = winW, Bottom = 3.2, Height = 3.0, Glass = true })
		end
		wall(ctx, "WallBack2", backCF, W, H2, y2, upBack)
		wall(ctx, "WallWest2", westCF, sideLen, H2, y2, { { Center = 0, Width = winW, Bottom = 3.2, Height = 3.0, Glass = true } })
		wall(ctx, "WallEast2", eastCF, sideLen, H2, y2, { { Center = 0, Width = winW, Bottom = 3.2, Height = 3.0, Glass = true } })
		box(ctx, "StoreyBand", Vector3.new(W + 0.4, 0.8, 0.3), Vector3.new(0, y2 - 0.4, hd + 0.15), col.Trim, Enum.Material.Metal, false)
		box(ctx, "StoreyBand", Vector3.new(W + 0.4, 0.8, 0.3), Vector3.new(0, y2 - 0.4, -hd - 0.15), col.Trim, Enum.Material.Metal, false)
		box(ctx, "StoreyBand", Vector3.new(0.3, 0.8, D + 0.4), Vector3.new(hw + 0.15, y2 - 0.4, 0), col.Trim, Enum.Material.Metal, false)
		box(ctx, "StoreyBand", Vector3.new(0.3, 0.8, D + 0.4), Vector3.new(-hw - 0.15, y2 - 0.4, 0), col.Trim, Enum.Material.Metal, false)

		slab(ctx, "Floor2", -hw + t, hw - t, -hd + t, hd - t, y2 - 0.8, 0.8, col.Floor, Enum.Material.Concrete, { stairX0 - 0.2, stairX1, stairZ0 - 0.1, stairZ1 + 0.2 })
		for k = 1, stepCount do
			local top = y1 + k * stepRise
			box(ctx, "Stair", Vector3.new(stepRun, top - y1, stairW), Vector3.new(stairX0 + (k - 0.5) * stepRun, y1 + (top - y1) * 0.5, (stairZ0 + stairZ1) * 0.5), col.Stair, Enum.Material.Concrete)
		end
		railing(ctx, Vector3.new(stairX0 - 0.2, y2, stairZ1 + 0.3), Vector3.new(stairX1 - 2.4, y2, stairZ1 + 0.3), 3)
	end

	-- Roof slab + parapet
	local roofHole: { number }? = nil
	local trussX = hw - t - 1.3
	local trussZ = hd - t - 1.3
	if roofAccess then
		roofHole = { trussX - 1.6, trussX + 1.6, trussZ - 1.6, trussZ + 1.6 }
	end
	slab(ctx, "Roof", -hw, hw, -hd, hd, roofBottom, 0.8, col.Roof, Enum.Material.Concrete, roofHole)
	local parH = 1.4
	box(ctx, "Parapet", Vector3.new(W, parH, t), Vector3.new(0, roofTop + parH * 0.5, hd - t * 0.5), col.Wall, Enum.Material.Concrete)
	box(ctx, "Parapet", Vector3.new(W, parH, t), Vector3.new(0, roofTop + parH * 0.5, -hd + t * 0.5), col.Wall, Enum.Material.Concrete)
	box(ctx, "Parapet", Vector3.new(t, parH, D - 2 * t), Vector3.new(hw - t * 0.5, roofTop + parH * 0.5, 0), col.Wall, Enum.Material.Concrete)
	box(ctx, "Parapet", Vector3.new(t, parH, D - 2 * t), Vector3.new(-hw + t * 0.5, roofTop + parH * 0.5, 0), col.Wall, Enum.Material.Concrete)
	local capColor = if goldCap then col.Gold else col.Trim
	box(ctx, "ParapetCap", Vector3.new(W + 0.3, 0.3, t + 0.3), Vector3.new(0, roofTop + parH + 0.15, hd - t * 0.5), capColor, Enum.Material.Metal, false)
	box(ctx, "ParapetCap", Vector3.new(W + 0.3, 0.3, t + 0.3), Vector3.new(0, roofTop + parH + 0.15, -hd + t * 0.5), capColor, Enum.Material.Metal, false)
	box(ctx, "ParapetCap", Vector3.new(t + 0.3, 0.3, D), Vector3.new(hw - t * 0.5, roofTop + parH + 0.15, 0), capColor, Enum.Material.Metal, false)
	box(ctx, "ParapetCap", Vector3.new(t + 0.3, 0.3, D), Vector3.new(-hw + t * 0.5, roofTop + parH + 0.15, 0), capColor, Enum.Material.Metal, false)

	-- Rooftop plant
	box(ctx, "ACUnit", Vector3.new(3, 1.6, 2.4), Vector3.new(-hw + 5, roofTop + 0.8, -hd + 3), col.Metal, Enum.Material.DiamondPlate)
	box(ctx, "ACUnit", Vector3.new(3, 1.6, 2.4), Vector3.new(-hw + 9, roofTop + 0.8, -hd + 3), col.Metal, Enum.Material.DiamondPlate)
	box(ctx, "Vent", Vector3.new(1.2, 1.4, 1.2), Vector3.new(hw - 3, roofTop + 0.7, 0), col.Dark, Enum.Material.Metal)
	if c.Skylights then
		for i, sx in ipairs({ -hw * 0.45, 0, hw * 0.45 }) do
			local sky = box(ctx, "Skylight" .. i, Vector3.new(5, 0.5, 3.4), Vector3.new(sx, roofTop + 0.25, hd * 0.2), col.Glass, Enum.Material.Glass, false)
			sky.Transparency = 0.35
		end
	end

	-- Entrance: awning or garage canopy, lamp, sign, sandbags
	local awnY = y1 + doorH + 1.0
	if garage then
		box(ctx, "Canopy", Vector3.new(doorW + 4, 0.4, 4.6), Vector3.new(doorX, awnY, hd + 2.3), col.Metal, Enum.Material.DiamondPlate)
		for _, sx in ipairs({ -1, 1 }) do
			box(ctx, "BollardHazard", Vector3.new(0.9, 1.6, 0.9), Vector3.new(doorX + sx * (doorW * 0.5 + 1.2), y1 + 0.8, hd + 1.2), col.Accent, Enum.Material.SmoothPlastic)
		end
	else
		box(ctx, "Awning", Vector3.new(doorW + 3, 0.35, 3.6), Vector3.new(doorX, awnY, hd + 1.8), col.Trim, Enum.Material.Metal)
		box(ctx, "AwningPost", Vector3.new(0.35, awnY - y1, 0.35), Vector3.new(doorX - doorW * 0.5 - 1.2, y1 + (awnY - y1) * 0.5, hd + 3.3), col.Metal, Enum.Material.Metal)
		box(ctx, "AwningPost", Vector3.new(0.35, awnY - y1, 0.35), Vector3.new(doorX + doorW * 0.5 + 1.2, y1 + (awnY - y1) * 0.5, hd + 3.3), col.Metal, Enum.Material.Metal)
	end
	-- entry lamp fitting only (v70 light budget: no PointLight)
	box(ctx, "EntryLamp", Vector3.new(1.4, 0.2, 0.8), Vector3.new(doorX, awnY - 0.3, hd + 1.4), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
	local signW = math.min(W - 6, 16)
	local signY = math.min(awnY + 1.6, y1 + H1 - 1.2)
	local signX = c.SignX or 0
	-- only slide the sign sideways if it would hang down over the doorway
	if math.abs(signX - doorX) < (signW + doorW) * 0.5 and signY - 1 < y1 + doorH + 0.4 then
		signX = if doorX > 0 then doorX - doorW * 0.5 - signW * 0.5 - 1 else doorX + doorW * 0.5 + signW * 0.5 + 1
	end
	local sign = box(ctx, "Sign", Vector3.new(signW, 2.0, 0.3), Vector3.new(signX, signY, hd + 0.15), col.Dark, Enum.Material.Metal, false)
	-- NormalId.Back is the +Z face = the building front
	surfaceText(sign, Enum.NormalId.Back, { c.SignText or "COMMAND CENTER" }, col.Accent, col.Dark, Enum.Font.GothamBlack, SURFACE_FAR)
	if not garage then
		sandbags(ctx, doorX + doorW * 0.5 + 1.6, doorX + doorW * 0.5 + 6.5, hd + 1.6, 0)
	end

	-- Flag
	if lv >= (c.FlagLevel or 1) then
		local flagX = -hw - 2.5
		-- always clear the roofline (two-storey from L3), taller again at L5
		local poleH = roofTop + parH + (if helipad then 9 else 4)
		box(ctx, "FlagPole", Vector3.new(0.4, poleH, 0.4), Vector3.new(flagX, poleH * 0.5, hd + 1), col.Metal, Enum.Material.Metal)
		box(ctx, "Flag", Vector3.new(0.12, 3.6, 6), Vector3.new(flagX, poleH - 2.2, hd + 1 - 3.2), col.Flag, Enum.Material.Fabric, false)
		if goldCap then
			-- v70: painted gold ball (was Neon: spec §5, no neon that is not a light source)
			box(ctx, "FlagTip", Vector3.new(0.9, 0.9, 0.9), Vector3.new(flagX, poleH + 0.4, hd + 1), col.Gold, Enum.Material.SmoothPlastic, false).Shape = Enum.PartType.Ball
		end
	end

	-- Ceiling lights: fittings in two rows (ground) / one row (upper), spaced ~9 studs. v70 light budget: only the
	-- fitting nearest each floor's centre carries a PointLight (one light per floor; the rest are unlit fittings).
	local lampCount = math.max(2, math.floor(W / 9))
	local litIndex = math.ceil(lampCount / 2)
	for i = 1, lampCount do
		local lx = -hw + W * (i - 0.5) / lampCount
		for row, lz in ipairs({ -hd * 0.4, hd * 0.35 }) do
			local lamp = box(ctx, "CeilingLight", Vector3.new(4, 0.2, 1.2), Vector3.new(lx, y1 + H1 - 0.15, lz), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
			if i == litIndex and row == 1 then
				light(lamp, 20, 1.0, col.Light)
			end
		end
	end
	if twoStory then
		for i = 1, lampCount do
			local lx = -hw + W * (i - 0.5) / lampCount
			local lamp = box(ctx, "CeilingLight", Vector3.new(4, 0.2, 1.2), Vector3.new(lx, y2 + H2 - 0.15, hd * 0.3), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
			if i == litIndex then
				light(lamp, 18, 1.0, col.Light)
			end
		end
	end

	-- Annex (comms room) + mast + floodlights
	if hasAnnex then
		local ax0 = hw
		local ax1 = hw + annexW
		local az0 = -hd
		local az1 = -hd + annexD
		local axc = (ax0 + ax1) * 0.5
		box(ctx, "AnnexFloor", Vector3.new(annexW, 0.8, annexD), Vector3.new(axc, 0, annexZc), col.Floor, Enum.Material.Concrete)
		local aBack = ctx.origin * CFrame.new(axc, 0, az0 + t * 0.5) * CFrame.Angles(0, math.pi, 0)
		local aFront = ctx.origin * CFrame.new(axc, 0, az1 - t * 0.5)
		local aEast = ctx.origin * CFrame.new(ax1 - t * 0.5, 0, annexZc) * CFrame.Angles(0, math.pi * 0.5, 0)
		wall(ctx, "AnnexBack", aBack, annexW, annexH, y1, {})
		wall(ctx, "AnnexFront", aFront, annexW, annexH, y1, { { Center = 0, Width = 4, Bottom = 3.4, Height = 2.8, Glass = true } })
		wall(ctx, "AnnexEast", aEast, annexD - 2 * t, annexH, y1, {})
		box(ctx, "AnnexRoof", Vector3.new(annexW + 0.4, 0.8, annexD + 0.4), Vector3.new(axc, y1 + annexH + 0.4, annexZc), col.Roof, Enum.Material.Concrete)
		box(ctx, "Generator", Vector3.new(4, 3, 2.4), Vector3.new(axc + 1.5, y1 + 1.5, az0 + t + 1.5), col.Locker, Enum.Material.DiamondPlate)
		box(ctx, "GeneratorStripe", Vector3.new(4.05, 0.5, 2.45), Vector3.new(axc + 1.5, y1 + 2.4, az0 + t + 1.5), col.Accent, Enum.Material.SmoothPlastic, false)
		box(ctx, "RadioRack", Vector3.new(1.4, 5, 2), Vector3.new(ax1 - t - 0.8, y1 + 2.5, annexZc + 2), col.Dark, Enum.Material.Metal)
		local aLamp = box(ctx, "CeilingLight", Vector3.new(3, 0.2, 1), Vector3.new(axc, y1 + annexH - 0.15, annexZc), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
		light(aLamp, 16, 1.1, col.Light)
		local signA = box(ctx, "AnnexSign", Vector3.new(5, 1.2, 0.25), Vector3.new(axc, y1 + annexH - 1.2, az1 + 0.15), col.Dark, Enum.Material.Metal, false)
		surfaceText(signA, Enum.NormalId.Back, { c.AnnexSignText or "COMMS" }, col.Accent, col.Dark, Enum.Font.GothamBlack, SURFACE_FAR)

		local mx, mz = -hw + 2, -hd + 2
		box(ctx, "MastBase", Vector3.new(1.6, 1, 1.6), Vector3.new(mx, roofTop + 0.5, mz), col.Metal, Enum.Material.Metal)
		box(ctx, "Mast", Vector3.new(0.4, 14, 0.4), Vector3.new(mx, roofTop + 8, mz), col.Metal, Enum.Material.Metal, false)
		for i = 1, 3 do
			box(ctx, "MastBar", Vector3.new(2.4 - i * 0.5, 0.15, 0.15), Vector3.new(mx, roofTop + 3 + i * 3.2, mz), col.Metal, Enum.Material.Metal, false)
		end
		-- v70 (HUD spec §5): no red beacon ball / light on the mast top

		for _, fx in ipairs({ -hw + 1, hw - 1 }) do
			box(ctx, "Floodlight", Vector3.new(1.2, 0.8, 0.8), Vector3.new(fx, roofTop + parH + 0.8, hd - 0.2), col.Metal, Enum.Material.Metal, false)
			local lens = box(ctx, "FloodLens", Vector3.new(1.0, 0.6, 0.1), Vector3.new(fx, roofTop + parH + 0.8, hd + 0.25), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
			local spot = Instance.new("SpotLight")
			spot.Face = Enum.NormalId.Back
			spot.Angle = 70
			spot.Range = math.min(30, LIGHTS.SpotMaxRange or 30)
			spot.Brightness = 1.5 * (LIGHTS.BrightnessScale or 1)
			spot.Color = col.Light
			spot.Shadows = false
			spot.Parent = lens
		end
	end

	-- Roof access: climbable truss through a hatch + dish
	if roofAccess then
		local climb = (roofTop - y2) + 2
		local trussH = math.ceil(climb / 2) * 2
		local truss = Instance.new("TrussPart")
		truss.Name = "RoofLadder"
		truss.Anchored = true
		truss.Size = Vector3.new(2, trussH, 2)
		truss.CFrame = ctx.origin * CFrame.new(trussX, y2 + trussH * 0.5, trussZ)
		truss.Color = col.Metal
		truss.Material = Enum.Material.Metal
		truss.CanTouch = false
		truss.Parent = ctx.model
		railing(ctx, Vector3.new(trussX - 1.8, roofTop, trussZ - 1.8), Vector3.new(trussX + 1.8, roofTop, trussZ - 1.8), 3)
		railing(ctx, Vector3.new(trussX - 1.8, roofTop, trussZ - 1.8), Vector3.new(trussX - 1.8, roofTop, trussZ + 1.2), 3)
		local dx, dz = hw - 6, -hd + 4.5
		box(ctx, "DishMount", Vector3.new(0.6, 2.4, 0.6), Vector3.new(dx, roofTop + 1.2, dz), col.Metal, Enum.Material.Metal)
		local dish = part(ctx, "Dish", Vector3.new(0.4, 5, 5), ctx.origin * CFrame.new(dx, roofTop + 3.2, dz) * CFrame.Angles(0, math.rad(-120), math.rad(35)), Color3.fromRGB(220, 222, 218), Enum.Material.SmoothPlastic)
		dish.Shape = Enum.PartType.Cylinder
	end

	-- Rooftop helipad marking
	if helipad then
		local hx, hz = 2, 1.5
		local ring = part(ctx, "HelipadRing", Vector3.new(0.06, 12, 12), ctx.origin * CFrame.new(hx, roofTop + 0.03, hz) * CFrame.Angles(0, 0, math.pi * 0.5), col.Gold, Enum.Material.SmoothPlastic, false)
		ring.Shape = Enum.PartType.Cylinder
		local inner = part(ctx, "HelipadInner", Vector3.new(0.06, 10.6, 10.6), ctx.origin * CFrame.new(hx, roofTop + 0.05, hz) * CFrame.Angles(0, 0, math.pi * 0.5), col.Dark, Enum.Material.SmoothPlastic, false)
		inner.Shape = Enum.PartType.Cylinder
		box(ctx, "HelipadH", Vector3.new(0.8, 0.06, 5), Vector3.new(hx - 1.6, roofTop + 0.08, hz), col.Gold, Enum.Material.SmoothPlastic, false)
		box(ctx, "HelipadH", Vector3.new(0.8, 0.06, 5), Vector3.new(hx + 1.6, roofTop + 0.08, hz), col.Gold, Enum.Material.SmoothPlastic, false)
		box(ctx, "HelipadH", Vector3.new(2.4, 0.06, 0.8), Vector3.new(hx, roofTop + 0.08, hz), col.Gold, Enum.Material.SmoothPlastic, false)
	end

	-- Interior furnishing (per building type)
	local keepOut: { Rect } = {
		-- doorway approach
		{ X0 = doorX - doorW * 0.5 - 1, X1 = doorX + doorW * 0.5 + 1, Z0 = hd - t - 6, Z1 = hd - t },
	}
	local con = consoleLocal(ctx.structureId)
	if con then
		table.insert(keepOut, { X0 = con.X - 2.2, X1 = con.X + 2.2, Z0 = con.Z - 2.2, Z1 = con.Z + 2.2 })
	end
	if twoStory then
		table.insert(keepOut, { X0 = stairX0 - 0.5, X1 = stairX1 + 0.5, Z0 = stairZ0, Z1 = stairZ1 + 1 })
	end
	if hasAnnex then
		table.insert(keepOut, { X0 = hw - t - 2, X1 = hw - t, Z0 = annexZc - 3, Z1 = annexZc + 3 })
	end
	local ictx = {
		StructureId = ctx.structureId,
		Level = lv,
		W = W,
		D = D,
		T = t,
		HalfW = hw,
		HalfD = hd,
		H1 = H1,
		H2 = H2,
		Y1 = y1,
		Y2 = y2,
		TwoStory = twoStory,
		DoorX = doorX,
		DoorWidth = doorW,
		DoorHeight = doorH,
		Garage = garage,
		Console = con,
		KeepOut = keepOut,
		-- inner faces of the ground-floor walls
		InX0 = -hw + t,
		InX1 = hw - t,
		InZ0 = -hd + t,
		InZ1 = hd - t,
		Colors = col,
	}
	local api = makeApi(ctx, "WE_Interior")
	local interiors = script.Parent:FindFirstChild("Interiors")
	local modScript = interiors and interiors:FindFirstChild(c.Interior or ctx.structureId)
	if modScript and modScript:IsA("ModuleScript") then
		local ok, fn = pcall(require, modScript)
		if ok and typeof(fn) == "function" then
			local okRun, errRun = pcall(fn, ictx, api)
			if not okRun then
				warn("[HollowBuilding] interior failed", ctx.structureId, errRun)
			end
		else
			warn("[HollowBuilding] interior module did not load", ctx.structureId, fn)
		end
	end
end

-- Kiosk position in the installation's local frame (keep-out for the module), if the layout has one.
local function kioskLocal(structureId: string): Vector3?
	local s = (BaseLayoutConfig.Structures :: any)[structureId]
	if not (s and s.Kiosk and s.Site) then
		return nil
	end
	local dx, dz = s.Kiosk.X - s.Site.X, s.Kiosk.Z - s.Site.Z
	local a = math.rad(-(s.Yaw or 0))
	return Vector3.new(dx * math.cos(a) + dz * math.sin(a), 0, -dx * math.sin(a) + dz * math.cos(a))
end

local function buildInstallation(ctx: Ctx)
	local c = ctx.c
	local ictx = {
		StructureId = ctx.structureId,
		Level = ctx.level,
		W = c.Width,
		D = c.Depth,
		HalfW = c.Width * 0.5,
		HalfD = c.Depth * 0.5,
		Y0 = 0.4, -- foundation top (the kit Body slab)
		Colors = ctx.col,
		Kiosk = kioskLocal(ctx.structureId),
	}
	local api = makeApi(ctx, "WE_Installation")
	local folder = script.Parent:FindFirstChild("Installations")
	local modScript = folder and folder:FindFirstChild(c.Module or ctx.structureId)
	if not (modScript and modScript:IsA("ModuleScript")) then
		warn("[HollowBuilding] installation module missing", ctx.structureId)
		return
	end
	local ok, fn = pcall(require, modScript)
	if ok and typeof(fn) == "function" then
		local okRun, errRun = pcall(fn, ictx, api)
		if not okRun then
			warn("[HollowBuilding] installation failed", ctx.structureId, errRun)
		end
	else
		warn("[HollowBuilding] installation module did not load", ctx.structureId, fn)
	end
end

local function findModel(plinth: BasePart): Model?
	local m = plinth:FindFirstChild(MODEL_NAME)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

--[[ Build / rebuild / remove the walk-in building (or outdoor installation) for this plinth at `level`. Idempotent. ]]
function HollowBuildingBuilder.Sync(plinth: BasePart, structureId: string, level: number)
	local c = cfgFor(structureId)
	local inst = if c then nil else instCfgFor(structureId)
	local existing = findModel(plinth)
	local lv = math.clamp(math.floor(tonumber(level) or 0), 0, 5)
	if (not c and not inst) or lv < 1 then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing and existing:GetAttribute("WE_BuildingLevel") == lv and existing:GetAttribute("WE_BuildingGen") == GEN then
		return
	end
	if existing then
		existing:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = MODEL_NAME
	model:SetAttribute("WE_BuildingLevel", lv)
	model:SetAttribute("WE_BuildingGen", GEN)
	model:SetAttribute("StructureId", structureId)
	local cfg = c or inst
	local ctx: Ctx = {
		model = model,
		origin = originFor(plinth, cfg),
		c = cfg,
		col = cfg.Colors,
		level = lv,
		structureId = structureId,
	}
	local ok, err = pcall(if inst then buildInstallation else build, ctx)
	if not ok then
		warn("[HollowBuilding] build failed", structureId, lv, err)
	end
	model.Parent = plinth
end

--[[ Remove every walk-in building under a plot folder (plot released). ]]
function HollowBuildingBuilder.ClearUnder(root: Instance)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("Model") and d.Name == MODEL_NAME then
			d:Destroy()
		end
	end
end

return HollowBuildingBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="71">
          <Properties>
            <string name="Name">Installations</string>
          </Properties>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Airfield</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Airfield installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 58 x 34 behind the
	runway (BaseLayoutConfig Roads: Runway + HangarApron); +Z faces the runway. The runway itself is layout
	ground, so this is the hangar side of the airfield.
	L1 walk-in hangar (open sliding doors) with one jet + hangar terminal (Garage), windsock
	L2 control tower   L3 fuel truck, tool carts   L4 second jet   L5 floodlights, gold header trim
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local hullGrey = Color3.fromRGB(128, 134, 138)
	local wallCol = Color3.fromRGB(150, 150, 140)
	local roofCol = Color3.fromRGB(92, 96, 90)

	-- Hangar shell: 40 wide x 28 deep, 15 to the eaves, gable roof ridge front-to-back
	local hx, hW, hD, H, t = -2, 40, 28, 15, 0.8
	local hw, hd = hW * 0.5, hD * 0.5
	local doorW, doorH = 32, 13
	api.box("HangarBack", Vector3.new(hW, H, t), Vector3.new(hx, y0 + H * 0.5, -hd + t * 0.5), wallCol, Enum.Material.CorrodedMetal)
	for _, side in ipairs({ -1, 1 }) do
		api.box("HangarSide", Vector3.new(t, H, hD), Vector3.new(hx + side * (hw - t * 0.5), y0 + H * 0.5, 0), wallCol, Enum.Material.CorrodedMetal)
		local pier = (hW - doorW) * 0.5
		api.box("HangarPier", Vector3.new(pier, doorH, t), Vector3.new(hx + side * (hw - pier * 0.5), y0 + doorH * 0.5, hd - t * 0.5), wallCol, Enum.Material.CorrodedMetal)
		-- sliding door leaves parked open outside the piers
		api.box("HangarDoorLeaf", Vector3.new(doorW * 0.25, doorH - 0.2, 0.4), Vector3.new(hx + side * (hw + doorW * 0.125 - 0.2), y0 + (doorH - 0.2) * 0.5, hd + 0.3), col.Metal, Enum.Material.DiamondPlate)
		api.box("DoorLeafStripe", Vector3.new(doorW * 0.25, 0.5, 0.42), Vector3.new(hx + side * (hw + doorW * 0.125 - 0.2), y0 + 1.2, hd + 0.3), col.Accent, Enum.Material.SmoothPlastic, false)
	end
	api.box("HangarHeader", Vector3.new(hW, H - doorH, t), Vector3.new(hx, y0 + doorH + (H - doorH) * 0.5, hd - t * 0.5), wallCol, Enum.Material.CorrodedMetal)
	local sign = api.box("HangarSign", Vector3.new(12, 1.4, 0.2), Vector3.new(hx, y0 + doorH + 1, hd + 0.12), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "HANGAR 01" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	-- Gable roof: two panels meeting at a ridge over the centre line, stepped gable infill front + back
	local pitch = math.rad(12)
	local rise = hw * math.tan(pitch)
	for _, side in ipairs({ -1, 1 }) do
		api.part("HangarRoof", Vector3.new(hw / math.cos(pitch) + 0.8, 0.6, hD + 1.2), CFrame.new(hx + side * hw * 0.5, y0 + H + rise * 0.5 + 0.3, 0) * CFrame.Angles(0, 0, -side * pitch), roofCol, Enum.Material.Metal)
	end
	for _, gz in ipairs({ hd - t * 0.5, -hd + t * 0.5 }) do
		for k = 1, 3 do
			local w = hW * (1 - k / 3.4)
			api.box("GableInfill", Vector3.new(w, rise / 3, t), Vector3.new(hx, y0 + H + (k - 0.5) * rise / 3, gz), wallCol, Enum.Material.CorrodedMetal)
		end
	end
	-- Hangar lights
	for i = -1, 1 do
		local lamp = api.box("HangarLight", Vector3.new(6, 0.25, 1), Vector3.new(hx + i * 12, y0 + H - 0.4, 0), col.Light, Enum.Material.SmoothPlastic, false)
		api.light(lamp, 26, 1.1, col.Light)
	end
	api.box("TaxiLine", Vector3.new(0.5, 0.05, hD - 2), Vector3.new(hx, y0 + 0.03, 0.5), col.Accent, Enum.Material.SmoothPlastic, false)

	-- Generic jet mock-up (no real-world type or markings), nose toward the doors (+Z)
	local function jet(cx: number, cz: number)
		local f = CFrame.new(cx, y0 + 2.4, cz)
		api.part("JetFuselage", Vector3.new(15, 2.2, 2.2), f * CFrame.Angles(0, math.rad(90), 0), hullGrey, Enum.Material.Metal).Shape = Enum.PartType.Cylinder
		local nose = api.part("JetNose", Vector3.new(2.2, 2.2, 2.2), f * CFrame.new(0, 0, 7.5), hullGrey, Enum.Material.Metal)
		nose.Shape = Enum.PartType.Ball
		local canopy = api.part("JetCanopy", Vector3.new(1.6, 1.4, 3.4), f * CFrame.new(0, 1.1, 4.6), Color3.fromRGB(40, 60, 80), Enum.Material.Glass, false)
		canopy.Transparency = 0.2
		api.part("JetWing", Vector3.new(12, 0.3, 4.4), f * CFrame.new(0, -0.3, -0.5), hullGrey, Enum.Material.Metal)
		api.part("JetTailplane", Vector3.new(5.2, 0.25, 2), f * CFrame.new(0, 0, -6.3), hullGrey, Enum.Material.Metal, false)
		api.part("JetFin", Vector3.new(0.3, 3.2, 2.6), f * CFrame.new(0, 2.4, -6), hullGrey, Enum.Material.Metal, false)
		api.part("JetExhaust", Vector3.new(0.8, 1.6, 1.6), f * CFrame.new(0, 0, -7.9) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal, false).Shape = Enum.PartType.Cylinder
		for _, g in ipairs({ { 0, 5 }, { -2.2, -1 }, { 2.2, -1 } }) do
			api.part("JetGear", Vector3.new(0.3, 1.3, 0.3), f * CFrame.new(g[1], -1.65, g[2]), col.Dark, Enum.Material.Metal, false)
		end
		api.part("JetRoundel", Vector3.new(1.6, 0.05, 1.6), f * CFrame.new(-4.2, -0.12, -0.5), col.Flag, Enum.Material.SmoothPlastic, false)
		api.part("JetRoundel", Vector3.new(1.6, 0.05, 1.6), f * CFrame.new(4.2, -0.12, -0.5), col.Flag, Enum.Material.SmoothPlastic, false)
	end
	if lv >= 4 then
		jet(hx - 9.5, 0)
		jet(hx + 9.5, -1.5)
	else
		jet(hx, 0)
	end

	-- Hangar terminal on the back wall (right of centre) → Garage (aircraft need the Airfield)
	api.terminal("HangarTerminal", Vector3.new(hx + 14, y0, -hd + t + 0.6), 0, "Garage", "Open hangar", "Hangar · Aircraft", { "HANGAR", "AIRCRAFT" })

	-- Windsock
	api.box("WindsockPole", Vector3.new(0.35, 8, 0.35), Vector3.new(-27, y0 + 4, -15), col.Metal, Enum.Material.Metal, false)
	api.part("Windsock", Vector3.new(0.9, 0.9, 3), CFrame.new(-27, y0 + 7.6, -13.4) * CFrame.Angles(math.rad(8), 0, 0), Color3.fromRGB(230, 120, 40), Enum.Material.Fabric, false)

	-- Control tower (L2+) at the runway corner
	if lv >= 2 then
		local tx, tz, th = 23.5, 9, 18
		api.box("TowerShaft", Vector3.new(4, th, 4), Vector3.new(tx, y0 + th * 0.5, tz), wallCol, Enum.Material.Concrete)
		api.box("TowerDeck", Vector3.new(7, 0.5, 7), Vector3.new(tx, y0 + th + 0.25, tz), col.Metal, Enum.Material.Metal)
		local cab = api.box("TowerCab", Vector3.new(6.2, 3.4, 6.2), Vector3.new(tx, y0 + th + 2.2, tz), col.Glass, Enum.Material.Glass)
		cab.Transparency = 0.35
		api.box("TowerCabRoof", Vector3.new(7.2, 0.5, 7.2), Vector3.new(tx, y0 + th + 4.15, tz), col.Trim, Enum.Material.Metal)
		api.box("TowerMast", Vector3.new(0.3, 4, 0.3), Vector3.new(tx + 2.5, y0 + th + 6.4, tz - 2.5), col.Metal, Enum.Material.Metal, false)
		local beacon = api.ball("TowerBeacon", 0.7, Vector3.new(tx + 2.5, y0 + th + 8.6, tz - 2.5), Color3.fromRGB(255, 50, 40), Enum.Material.SmoothPlastic, false)
		api.light(beacon, 10, 1.5, Color3.fromRGB(255, 60, 40))
		api.box("TowerDoor", Vector3.new(1.8, 3, 0.15), Vector3.new(tx, y0 + 1.5, tz + 2.08), col.Metal, Enum.Material.Metal, false)
	end

	-- Fuel truck + tool carts (L3+)
	if lv >= 3 then
		local fx, fz = 23.5, -7
		api.box("FuelTruckCab", Vector3.new(2.6, 2.6, 2.8), Vector3.new(fx, y0 + 1.9, fz + 4.4), col.Locker, Enum.Material.Metal)
		api.part("FuelTruckTank", Vector3.new(6.4, 2.6, 2.6), CFrame.new(fx, y0 + 2.2, fz) * CFrame.Angles(0, math.rad(90), 0), col.Locker, Enum.Material.Metal).Shape = Enum.PartType.Cylinder
		api.box("FuelTruckChassis", Vector3.new(2.4, 0.5, 9.4), Vector3.new(fx, y0 + 0.75, fz + 1.2), col.Dark, Enum.Material.Metal, false)
		for _, wz in ipairs({ fz + 4.6, fz - 0.6, fz - 2.6 }) do
			for _, side in ipairs({ -1, 1 }) do
				api.part("FuelTruckWheel", Vector3.new(0.5, 1.3, 1.3), CFrame.new(fx + side * 1.2, y0 + 0.65, wz), col.Dark, Enum.Material.Fabric, false).Shape = Enum.PartType.Cylinder
			end
		end
		for i = 0, 1 do
			local cx = hx - hw + 3 + i * 3
			api.box("ToolCart", Vector3.new(2, 2.2, 1.2), Vector3.new(cx, y0 + 1.1, -hd + 2.2), Color3.fromRGB(150, 40, 36), Enum.Material.Metal)
		end
		for i = 0, 2 do
			api.part("FuelDrum", Vector3.new(1.5, 1.1, 1.1), CFrame.new(hx + hw - 2, y0 + 0.75, -hd + 2.2 + i * 1.3) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(110, 58, 40), Enum.Material.Metal).Shape = Enum.PartType.Cylinder
		end
	end

	-- L5: floodlights on the hangar corners + gold header trim
	if lv >= 5 then
		api.box("GoldTrim", Vector3.new(hW, 0.35, 0.35), Vector3.new(hx, y0 + H + 0.2, hd + 0.2), col.Gold, Enum.Material.Metal, false)
		for _, side in ipairs({ -1, 1 }) do
			local lens = api.box("FloodLamp", Vector3.new(1.6, 0.9, 0.5), Vector3.new(hx + side * (hw - 1.5), y0 + H - 0.6, hd + 0.5), col.Light, Enum.Material.SmoothPlastic, false)
			api.light(lens, 30, 1.4, col.Light)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Checkpoint</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Gate checkpoint installation for DefensiveWalls (HollowBuildingBuilder, StructureVisualConfig.Installations).
	20 x 10 beside the main road just inside the main gate. The perimeter walls themselves are still built by
	StructureKitBuilder.SyncPerimeterWalls — this is the visible "defences" post at the gate.
	L1 guard booth, raised boom barrier, jersey barriers, floodlight   L2 razor wire
	L3 tank traps, more barriers   L4 sandbagged gun nest   L5 second floodlight, gold booth trim
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local concrete = Color3.fromRGB(170, 166, 154)

	-- L5 gold edge band around a roof (matches the walk-in buildings' gold parapet cap)
	local function goldEdge(cx: number, y: number, cz: number, w: number, d: number)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz + d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz - d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx + w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx - w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
	end

	-- Guard booth by the road (+X side), door facing the road
	local bx, bz = 6.2, 0
	api.box("Booth", Vector3.new(4.4, 3.4, 4.4), Vector3.new(bx, y0 + 1.7, bz), col.Wall, Enum.Material.Concrete)
	for _, w in ipairs({ { 0, -2.25, 0 }, { -2.25, 0, 90 }, { 0, 2.25, 0 } }) do
		local win = api.part("BoothWindow", Vector3.new(2.6, 1.3, 0.12), CFrame.new(bx + w[1], y0 + 2.4, bz + w[2]) * CFrame.Angles(0, math.rad(w[3]), 0), col.Glass, Enum.Material.Glass, false)
		win.Transparency = 0.25
	end
	api.box("BoothDoor", Vector3.new(0.12, 2.8, 1.6), Vector3.new(bx + 2.25, y0 + 1.4, bz), col.Metal, Enum.Material.Metal, false)
	api.box("BoothRoof", Vector3.new(5.6, 0.4, 5.6), Vector3.new(bx, y0 + 3.6, bz), col.Trim, Enum.Material.Metal)
	if lv >= 5 then
		goldEdge(bx, y0 + 3.95, bz, 5.6, 5.6)
	end
	local sign = api.box("BoothSign", Vector3.new(4.6, 0.9, 0.15), Vector3.new(bx, y0 + 4.3, bz - 2.3), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Front, { "CHECKPOINT" }, col.Accent, col.Dark, Enum.Font.GothamBlack)

	-- Boom barrier post at the road edge, arm raised (decorative, never blocks the road)
	api.box("BoomPost", Vector3.new(0.8, 2.2, 0.8), Vector3.new(9.4, y0 + 1.1, 3), col.Accent, Enum.Material.SmoothPlastic)
	api.part("BoomArm", Vector3.new(0.3, 0.3, 7), CFrame.new(9.4, y0 + 2.2, 3) * CFrame.Angles(math.rad(70), 0, 0) * CFrame.new(0, 0, -3.3), Color3.fromRGB(235, 235, 225), Enum.Material.SmoothPlastic, false)

	-- Jersey barriers along the front edge
	local n = if lv >= 3 then 5 else 3
	for i = 0, n - 1 do
		local x = -9 + i * 3.6
		api.box("JerseyBase", Vector3.new(3.4, 0.9, 1.4), Vector3.new(x, y0 + 0.45, 3.6), concrete, Enum.Material.Concrete)
		api.box("JerseyTop", Vector3.new(3.4, 1.7, 0.6), Vector3.new(x, y0 + 1.75, 3.6), concrete, Enum.Material.Concrete)
		api.box("JerseyStripe", Vector3.new(0.5, 0.9, 0.62), Vector3.new(x - 1.4, y0 + 1.9, 3.6), col.Accent, Enum.Material.SmoothPlastic, false)
		if lv >= 2 then
			local coil = api.cylinder("RazorWire", Vector3.new(3.3, 0.9, 0.9), CFrame.new(x, y0 + 3.05, 3.6), col.Metal, Enum.Material.DiamondPlate, false)
			coil.Transparency = 0.35
		end
	end

	-- Floodlights
	local function flood(fx: number, fz: number)
		api.box("FloodPole", Vector3.new(0.3, 7, 0.3), Vector3.new(fx, y0 + 3.5, fz), col.Metal, Enum.Material.Metal, false)
		local lamp = api.box("FloodLamp", Vector3.new(1.4, 0.8, 0.5), Vector3.new(fx, y0 + 7, fz + 0.3), col.Light, Enum.Material.SmoothPlastic, false)
		api.light(lamp, 22, 1.3, col.Light)
	end
	flood(-9.4, -3.5)
	if lv >= 5 then
		flood(2.5, -3.5)
	end

	-- Czech hedgehog tank traps (L3+)
	if lv >= 3 then
		for i = 0, 2 do
			local tx = -8 + i * 3.4
			local c = CFrame.new(tx, y0 + 1.25, 0.2)
			api.part("TankTrap", Vector3.new(0.4, 0.4, 3), c * CFrame.Angles(math.rad(45), 0, 0), col.Dark, Enum.Material.Metal)
			api.part("TankTrap", Vector3.new(0.4, 0.4, 3), c * CFrame.Angles(0, 0, math.rad(45)) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal)
			api.part("TankTrap", Vector3.new(0.4, 0.4, 3), c * CFrame.Angles(0, math.rad(45), math.rad(-45)), col.Dark, Enum.Material.Metal)
		end
	end

	-- Sandbagged gun nest (L4+)
	if lv >= 4 then
		api.sandbags(-4.6, 0.2, -2.8, y0)
		api.box("NestTripod", Vector3.new(0.4, 1.4, 0.4), Vector3.new(-2.2, y0 + 0.7, -1.8), col.Metal, Enum.Material.Metal, false)
		api.box("NestGun", Vector3.new(0.5, 0.5, 1.6), Vector3.new(-2.2, y0 + 1.6, -1.6), col.Dark, Enum.Material.Metal, false)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">MissileDefense</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Missile Defense installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 24 x 22 battery
	inside a sandbag berm (gap at the front for the kiosk path): launcher(s) on turntables, fire-control
	truck with a spinning radar, missile crates.
	L1 one 2-tube launcher   L2 fire-control truck   L3 4-tube launcher, blast walls
	L4 second launcher       L5 6-tube launchers, floodlights, gold stripe
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local hw, hd = ictx.HalfW, ictx.HalfD
	local olive = col.Locker
	local tubeEnd = Color3.fromRGB(34, 36, 34)

	-- Sandbag berm around the battery, open at the front centre (x -3..3)
	api.sandbags(-hw + 1, -3, hd - 1, y0)
	api.sandbags(3, hw - 1, hd - 1, y0)
	api.sandbags(-hw + 1, hw - 1, -hd + 1, y0)
	for _, sx in ipairs({ -hw + 1, hw - 1 }) do
		local n = math.floor((ictx.D - 4) / 2.1)
		for i = 0, n - 1 do
			api.box("Sandbag", Vector3.new(1.5, 1.0, 2.0), Vector3.new(sx, y0 + 0.5, -hd + 2 + (i + 0.5) * ((ictx.D - 4) / n)), col.Sandbag, Enum.Material.Fabric)
		end
	end

	-- Launcher on a turntable: canister pack tilted 35° up toward the back (-Z)
	local function launcher(lx: number, lz: number, tubes: number)
		api.cylinder("Turntable", Vector3.new(1.2, 7, 7), CFrame.new(lx, y0 + 0.6, lz) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, Enum.Material.Metal)
		api.box("LauncherPedestal", Vector3.new(2.4, 2.4, 2.4), Vector3.new(lx, y0 + 2.4, lz), col.Metal, Enum.Material.Metal)
		local cols = if tubes >= 6 then 3 else if tubes >= 4 then 2 else 1
		local rows = if tubes >= 2 then 2 else 1
		local packW, packH, packL = cols * 1.7 + 0.6, rows * 1.7 + 0.6, 8
		local pack = CFrame.new(lx, y0 + 3.6 + packH * 0.5, lz) * CFrame.Angles(math.rad(35), 0, 0)
		api.part("LauncherPack", Vector3.new(packW, packH, packL), pack, olive, Enum.Material.Metal)
		api.part("LauncherStripe", Vector3.new(packW + 0.05, 0.3, packL + 0.05), pack * CFrame.new(0, packH * 0.5 - 0.4, 0), if lv >= 5 then col.Gold else col.Accent, Enum.Material.SmoothPlastic, false)
		for c = 1, cols do
			for r = 1, rows do
				local ox = (c - (cols + 1) * 0.5) * 1.7
				local oy = (r - (rows + 1) * 0.5) * 1.7
				-- tube mouths on the raised (-Z) end
				api.cylinder("TubeMouth", Vector3.new(0.3, 1.3, 1.3), pack * CFrame.new(ox, oy, -packL * 0.5 - 0.1) * CFrame.Angles(0, math.rad(90), 0), tubeEnd, Enum.Material.Metal, false)
				api.cylinder("MissileTip", Vector3.new(0.5, 0.6, 0.6), pack * CFrame.new(ox, oy, -packL * 0.5 + 0.1) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(200, 60, 50), Enum.Material.SmoothPlastic, false)
			end
		end
	end
	local tubes = if lv >= 5 then 6 elseif lv >= 3 then 4 else 2
	if lv >= 4 then
		launcher(-5.5, -3, tubes)
		launcher(5.5, -3, tubes)
	else
		launcher(0, -3, tubes)
	end

	-- Fire-control truck with spinning radar (L2+)
	if lv >= 2 then
		local tx, tz = 6.5, 5.5
		api.box("TruckCab", Vector3.new(3, 2.6, 2.6), Vector3.new(tx - 3.4, y0 + 1.9, tz), olive, Enum.Material.Metal)
		local ws = api.box("TruckWindshield", Vector3.new(0.15, 1, 2.2), Vector3.new(tx - 4.95, y0 + 2.5, tz), col.Glass, Enum.Material.Glass, false)
		ws.Transparency = 0.3
		api.box("TruckBody", Vector3.new(5.6, 3, 2.8), Vector3.new(tx + 0.9, y0 + 2.1, tz), olive, Enum.Material.Metal)
		for _, wx in ipairs({ tx - 3.4, tx - 0.4, tx + 2.6 }) do
			for _, side in ipairs({ -1, 1 }) do
				api.cylinder("TruckWheel", Vector3.new(0.6, 1.4, 1.4), CFrame.new(wx, y0 + 0.7, tz + side * 1.35) * CFrame.Angles(0, math.rad(90), 0), tubeEnd, Enum.Material.Fabric, false)
			end
		end
		api.box("RadarMount", Vector3.new(0.5, 1.2, 0.5), Vector3.new(tx + 1.5, y0 + 4.2, tz), col.Metal, Enum.Material.Metal, false)
		local panel = api.part("FireControlRadar", Vector3.new(3.4, 1.8, 0.3), CFrame.new(tx + 1.5, y0 + 5.4, tz) * CFrame.Angles(math.rad(-15), 0, 0), col.Dark, Enum.Material.Metal, false)
		api.spin({ panel }, Vector3.new(tx + 1.5, 0, tz), 14)
	end

	-- Missile crates (grow with level)
	local crates = math.min(2 + lv, 6)
	for i = 0, crates - 1 do
		local cx = -hw + 3.2 + (i % 3) * 2.4
		local cz = 3 + math.floor(i / 3) * 1.6
		api.box("MissileCrate", Vector3.new(2.2, 1.1, 1.4), Vector3.new(cx, y0 + 0.55, cz), olive, Enum.Material.Wood)
		api.box("CrateStencil", Vector3.new(0.8, 0.3, 1.42), Vector3.new(cx, y0 + 0.6, cz), col.Accent, Enum.Material.SmoothPlastic, false)
	end

	-- Blast walls behind the launchers (L3+)
	if lv >= 3 then
		for _, bx in ipairs({ -6, 0, 6 }) do
			api.box("BlastWall", Vector3.new(5.6, 3.2, 0.9), Vector3.new(bx, y0 + 1.6, -hd + 3.2), col.Wall, Enum.Material.Concrete)
		end
	end

	-- Floodlights on poles (L5)
	if lv >= 5 then
		for _, fx in ipairs({ -hw + 2, hw - 2 }) do
			api.box("FloodPole", Vector3.new(0.3, 7, 0.3), Vector3.new(fx, y0 + 3.5, hd - 2.5), col.Metal, Enum.Material.Metal, false)
			local lens = api.box("FloodLamp", Vector3.new(1.4, 0.8, 0.5), Vector3.new(fx, y0 + 7, hd - 2.8), col.Light, Enum.Material.SmoothPlastic, false)
			api.light(lens, 20, 1.2, col.Light)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">PowerStation</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Power Station installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 30 x 22 fenced
	substation yard; the kiosk stands outside the front gate (+Z).
	L1 generator hall + transformer + fence   L2 second transformer + cable trays
	L3 transmission pylon                     L4 solar array           L5 roof fans, gold trim, beacon
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local hw, hd = ictx.HalfW, ictx.HalfD
	local fenceCol = Color3.fromRGB(120, 124, 120)

	-- L5 gold edge band around a roof (matches the walk-in buildings' gold parapet cap)
	local function goldEdge(cx: number, y: number, cz: number, w: number, d: number)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz + d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz - d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx + w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx - w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
	end

	-- A beam between two building-local points (not vertical)
	local function beam(name: string, a: Vector3, b: Vector3, thick: number, color: Color3)
		local mid = (a + b) * 0.5
		api.part(name, Vector3.new(thick, thick, (b - a).Magnitude), CFrame.lookAt(mid, b), color, Enum.Material.Metal, false)
	end

	-- Perimeter fence with a front gate opening (x -3.5..3.5)
	local fx0, fx1, fz0, fz1 = -hw + 0.5, hw - 0.5, -hd + 0.5, hd - 0.5
	local fenceH = 5
	local function fenceRun(ax: number, az: number, bx: number, bz: number)
		local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
		if len < 0.5 then
			return
		end
		local mid = Vector3.new((ax + bx) * 0.5, y0 + fenceH * 0.5, (az + bz) * 0.5)
		local alongX = math.abs(bx - ax) > math.abs(bz - az)
		local size = if alongX then Vector3.new(len, fenceH, 0.12) else Vector3.new(0.12, fenceH, len)
		local mesh = api.box("FenceMesh", size, mid, fenceCol, Enum.Material.DiamondPlate)
		mesh.Transparency = 0.55
		local rail = if alongX then Vector3.new(len, 0.2, 0.2) else Vector3.new(0.2, 0.2, len)
		api.box("FenceRail", rail, Vector3.new(mid.X, y0 + fenceH, mid.Z), col.Metal, Enum.Material.Metal, false)
		local posts = math.max(1, math.floor(len / 3.5))
		for i = 0, posts do
			local t = i / posts
			api.box("FencePost", Vector3.new(0.3, fenceH + 0.4, 0.3), Vector3.new(ax + (bx - ax) * t, y0 + (fenceH + 0.4) * 0.5, az + (bz - az) * t), col.Metal, Enum.Material.Metal, false)
		end
	end
	fenceRun(fx0, fz0, fx1, fz0)
	fenceRun(fx0, fz0, fx0, fz1)
	fenceRun(fx1, fz0, fx1, fz1)
	fenceRun(fx0, fz1, -3.5, fz1)
	fenceRun(3.5, fz1, fx1, fz1)
	local warnSign = api.box("DangerSign", Vector3.new(3.2, 1.6, 0.1), Vector3.new(-7, y0 + 3, fz1 + 0.12), Color3.fromRGB(230, 196, 70), Enum.Material.SmoothPlastic, false)
	api.surfaceText(warnSign, Enum.NormalId.Back, { "⚡ DANGER", "HIGH VOLTAGE" }, Color3.fromRGB(20, 20, 20), Color3.fromRGB(230, 196, 70), Enum.Font.GothamBlack)

	-- Generator hall (back-left): solid block with a roll-up door, stacks, sign
	local hx, hz, hW, hD, hH = -8, -4, 12, 10, 8
	api.box("GenHall", Vector3.new(hW, hH, hD), Vector3.new(hx, y0 + hH * 0.5, hz), col.Wall, Enum.Material.Concrete)
	api.box("GenHallRoof", Vector3.new(hW + 0.6, 0.6, hD + 0.6), Vector3.new(hx, y0 + hH + 0.3, hz), col.Trim, Enum.Material.Metal)
	if lv >= 5 then
		goldEdge(hx, y0 + hH + 0.75, hz, hW + 0.6, hD + 0.6)
	end
	api.box("GenDoor", Vector3.new(5, 5.5, 0.2), Vector3.new(hx + 1, y0 + 2.75, hz + hD * 0.5 + 0.1), col.Metal, Enum.Material.DiamondPlate, false)
	api.box("GenDoorStripe", Vector3.new(5, 0.4, 0.22), Vector3.new(hx + 1, y0 + 5.7, hz + hD * 0.5 + 0.11), col.Accent, Enum.Material.SmoothPlastic, false)
	local sign = api.box("GenSign", Vector3.new(7, 1.3, 0.2), Vector3.new(hx, y0 + 7, hz + hD * 0.5 + 0.12), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "POWER STATION" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	for i, sx in ipairs({ hx - 3.5, hx + 3.5 }) do
		if i == 1 or lv >= 2 then
			api.cylinder("ExhaustStack", Vector3.new(5, 1.1, 1.1), CFrame.new(sx, y0 + hH + 2.5, hz - 2.5) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, Enum.Material.Metal)
		end
	end
	api.box("GenVent", Vector3.new(3, 1, 2), Vector3.new(hx, y0 + hH + 1.1, hz + 1.5), col.Metal, Enum.Material.DiamondPlate)
	if lv >= 5 then
		for _, fx in ipairs({ hx - 3, hx + 3 }) do
			api.cylinder("RoofFan", Vector3.new(0.6, 3, 3), CFrame.new(fx, y0 + hH + 0.9, hz + 2.5) * CFrame.Angles(0, 0, math.rad(90)), col.Metal, Enum.Material.Metal)
		end
	end

	-- Transformers (right of the hall)
	local function transformer(tx: number, tz: number)
		api.box("Transformer", Vector3.new(4, 3.6, 3.4), Vector3.new(tx, y0 + 1.8, tz), col.Locker, Enum.Material.Metal)
		for i = -2, 2 do
			api.box("CoolingFin", Vector3.new(0.15, 2.8, 1.2), Vector3.new(tx + i * 0.7, y0 + 1.8, tz + 2.3), col.Metal, Enum.Material.Metal, false)
		end
		for i = -1, 1 do
			api.cylinder("Bushing", Vector3.new(1.4, 0.45, 0.45), CFrame.new(tx + i * 1.2, y0 + 4.3, tz - 0.6) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(150, 110, 70), Enum.Material.SmoothPlastic, false)
		end
		api.box("TransformerPlinth", Vector3.new(5, 0.4, 4.6), Vector3.new(tx, y0 + 0.2, tz + 0.5), col.Floor, Enum.Material.Concrete, false)
	end
	transformer(5, -5)
	if lv >= 2 then
		transformer(11, -5)
		api.box("CableTray", Vector3.new(14, 0.4, 0.8), Vector3.new(4, y0 + 0.2, -1.8), col.Dark, Enum.Material.Metal, false)
	end

	-- Transmission pylon (back-right corner) with insulators; beacon at L5
	if lv >= 3 then
		local px, pz, pH = 11, -8.5, 20
		for _, o in ipairs({ { -1.3, -1.3 }, { 1.3, -1.3 }, { -1.3, 1.3 }, { 1.3, 1.3 } }) do
			api.box("PylonLeg", Vector3.new(0.35, pH, 0.35), Vector3.new(px + o[1], y0 + pH * 0.5, pz + o[2]), col.Metal, Enum.Material.Metal)
		end
		for k = 0, 3 do
			local ya, yb = y0 + k * 4.5, y0 + (k + 1) * 4.5
			beam("PylonBrace", Vector3.new(px - 1.3, ya, pz + 1.3), Vector3.new(px + 1.3, yb, pz + 1.3), 0.2, col.Metal)
			beam("PylonBrace", Vector3.new(px + 1.3, ya, pz - 1.3), Vector3.new(px - 1.3, yb, pz - 1.3), 0.2, col.Metal)
			beam("PylonBrace", Vector3.new(px - 1.3, ya, pz - 1.3), Vector3.new(px - 1.3, yb, pz + 1.3), 0.2, col.Metal)
			beam("PylonBrace", Vector3.new(px + 1.3, ya, pz + 1.3), Vector3.new(px + 1.3, yb, pz - 1.3), 0.2, col.Metal)
		end
		for _, ay in ipairs({ pH - 1, pH - 5 }) do
			api.box("PylonArm", Vector3.new(9, 0.4, 0.4), Vector3.new(px - 1.5, y0 + ay, pz), col.Metal, Enum.Material.Metal, false)
			for _, ix in ipairs({ px - 5.5, px + 2.5 }) do
				api.cylinder("Insulator", Vector3.new(1.4, 0.5, 0.5), CFrame.new(ix, y0 + ay - 0.8, pz) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(150, 110, 70), Enum.Material.SmoothPlastic, false)
			end
		end
		if lv >= 5 then
			local b = api.ball("PylonBeacon", 0.8, Vector3.new(px, y0 + pH + 0.5, pz), Color3.fromRGB(255, 50, 40), Enum.Material.SmoothPlastic, false)
			api.light(b, 10, 1.5, Color3.fromRGB(255, 60, 40))
		end
	end

	-- Solar array (front-right) from L4: tilted panels on frames
	if lv >= 4 then
		for row = 0, 1 do
			for i = 0, 2 do
				local sx, sz = 5.6 + i * 3.4, 3.2 + row * 3.8
				api.box("SolarLeg", Vector3.new(0.25, 1.4, 0.25), Vector3.new(sx, y0 + 0.7, sz + 0.8), col.Metal, Enum.Material.Metal, false)
				api.part("SolarPanel", Vector3.new(3.2, 0.15, 2.4), CFrame.new(sx, y0 + 1.5, sz) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(30, 44, 70), Enum.Material.Glass)
			end
		end
	end

	-- Yard dressing: fuel tank + drums by the hall, yard lamp by the gate
	api.cylinder("FuelTank", Vector3.new(6, 2.6, 2.6), CFrame.new(-8, y0 + 1.5, 5), col.Locker, Enum.Material.Metal)
	api.box("FuelTankSaddle", Vector3.new(4.5, 0.6, 2), Vector3.new(-8, y0 + 0.3, 5), col.Dark, Enum.Material.Metal, false)
	for i = 0, 1 do
		api.cylinder("FuelDrum", Vector3.new(1.5, 1.1, 1.1), CFrame.new(-12.5 + i * 1.3, y0 + 0.75, 8.5) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(120, 60, 40), Enum.Material.Metal)
	end
	api.box("YardLampPole", Vector3.new(0.3, 7, 0.3), Vector3.new(4.5, y0 + 3.5, hd - 1.5), col.Metal, Enum.Material.Metal, false)
	local lamp = api.box("YardLamp", Vector3.new(1.4, 0.3, 0.8), Vector3.new(4.5, y0 + 7, hd - 2), col.Light, Enum.Material.SmoothPlastic, false)
	api.light(lamp, 18, 1.2, col.Light)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Radar</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Radar installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 24 x 20: control hut,
	lattice tower with a rotating dish (client-side spin via api.spin), cable trench. Kiosk outside the front.
	L1 hut + 10-stud tower + small dish   L2 taller tower, generator   L3 big dish + platform railing
	L4 phased-array panel on the hut      L5 radome on its own tower, gold trim
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local white = Color3.fromRGB(222, 224, 218)

	-- L5 gold edge band around a roof (matches the walk-in buildings' gold parapet cap)
	local function goldEdge(cx: number, y: number, cz: number, w: number, d: number)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz + d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz - d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx + w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx - w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
	end

	local function beam(name: string, a: Vector3, b: Vector3, thick: number, color: Color3)
		local mid = (a + b) * 0.5
		api.part(name, Vector3.new(thick, thick, (b - a).Magnitude), CFrame.lookAt(mid, b), color, Enum.Material.Metal, false)
	end

	-- Lattice tower: 4 legs, X-braces every 4 studs, a platform on top. Returns the platform top Y.
	local function tower(tx: number, tz: number, h: number, half: number): number
		for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			api.box("TowerLeg", Vector3.new(0.4, h, 0.4), Vector3.new(tx + o[1] * half, y0 + h * 0.5, tz + o[2] * half), col.Metal, Enum.Material.Metal)
		end
		local steps = math.max(1, math.floor(h / 4))
		for k = 0, steps - 1 do
			local ya, yb = y0 + k * (h / steps), y0 + (k + 1) * (h / steps)
			beam("TowerBrace", Vector3.new(tx - half, ya, tz + half), Vector3.new(tx + half, yb, tz + half), 0.2, col.Metal)
			beam("TowerBrace", Vector3.new(tx + half, ya, tz - half), Vector3.new(tx - half, yb, tz - half), 0.2, col.Metal)
			beam("TowerBrace", Vector3.new(tx - half, ya, tz - half), Vector3.new(tx - half, yb, tz + half), 0.2, col.Metal)
			beam("TowerBrace", Vector3.new(tx + half, ya, tz + half), Vector3.new(tx + half, yb, tz - half), 0.2, col.Metal)
		end
		api.box("TowerPlatform", Vector3.new(half * 2 + 1.6, 0.4, half * 2 + 1.6), Vector3.new(tx, y0 + h + 0.2, tz), col.Metal, Enum.Material.DiamondPlate)
		return y0 + h + 0.4
	end

	-- Control hut (front-left)
	local hx, hz, hW, hD, hH = -6, 3, 9, 8, 6.5
	api.box("RadarHut", Vector3.new(hW, hH, hD), Vector3.new(hx, y0 + hH * 0.5, hz), col.Wall, Enum.Material.Concrete)
	api.box("RadarHutRoof", Vector3.new(hW + 0.6, 0.5, hD + 0.6), Vector3.new(hx, y0 + hH + 0.25, hz), col.Trim, Enum.Material.Metal)
	if lv >= 5 then
		goldEdge(hx, y0 + hH + 0.65, hz, hW + 0.6, hD + 0.6)
	end
	api.box("RadarHutDoor", Vector3.new(2.6, 5, 0.2), Vector3.new(hx + 2.4, y0 + 2.5, hz + hD * 0.5 + 0.1), col.Metal, Enum.Material.Metal, false)
	local win = api.box("RadarHutWindow", Vector3.new(3.2, 1.6, 0.2), Vector3.new(hx - 1.8, y0 + 3.8, hz + hD * 0.5 + 0.1), col.Glass, Enum.Material.Glass, false)
	win.Transparency = 0.3
	local sign = api.box("RadarSign", Vector3.new(6, 1.1, 0.2), Vector3.new(hx, y0 + hH - 0.9, hz + hD * 0.5 + 0.12), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "RADAR CONTROL" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	api.box("HutAC", Vector3.new(2.2, 1.4, 1.6), Vector3.new(hx - 2.5, y0 + hH + 1.2, hz - 1.5), col.Metal, Enum.Material.DiamondPlate)

	-- Main tower + dish (back-right)
	local tx, tz = 5, -3
	local h = ({ 10, 13, 15, 16, 17 })[lv] or 10
	local top = tower(tx, tz, h, 1.5)
	if lv >= 3 then
		for _, side in ipairs({ -1, 1 }) do
			api.box("PlatformRail", Vector3.new(4.6, 0.2, 0.2), Vector3.new(tx, top + 1.1, tz + side * 2.2), col.Accent, Enum.Material.Metal, false)
			api.box("PlatformRail", Vector3.new(0.2, 0.2, 4.6), Vector3.new(tx + side * 2.2, top + 1.1, tz), col.Accent, Enum.Material.Metal, false)
		end
	end
	local dishD = if lv >= 3 then 8 else 5
	api.cylinder("DishMast", Vector3.new(2, 0.7, 0.7), CFrame.new(tx, top + 1, tz) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, Enum.Material.Metal)
	local dish = api.cylinder("RadarDish", Vector3.new(0.4, dishD, dishD), CFrame.new(tx, top + 2 + dishD * 0.35, tz - 0.6) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(20)), white, Enum.Material.SmoothPlastic, false)
	local feedArm = api.part("FeedArm", Vector3.new(0.2, 0.2, 2.6), CFrame.new(tx, top + 2 + dishD * 0.35, tz + 0.7), col.Metal, Enum.Material.Metal, false)
	local feed = api.ball("FeedHorn", 0.6, Vector3.new(tx, top + 2 + dishD * 0.35, tz + 2), col.Dark, Enum.Material.Metal, false)
	api.spin({ dish, feedArm, feed }, Vector3.new(tx, 0, tz), if lv >= 3 then 8 else 12)

	-- Cable trench hut → tower
	api.box("CableTrench", Vector3.new(0.8, 0.1, 7), Vector3.new(0.5, y0 + 0.05, 0.5), col.Dark, Enum.Material.Metal, false)

	-- Generator (L2+)
	if lv >= 2 then
		api.box("Generator", Vector3.new(3.4, 2.2, 2), Vector3.new(-8.5, y0 + 1.1, -6), col.Locker, Enum.Material.DiamondPlate)
		api.box("GeneratorStripe", Vector3.new(3.45, 0.4, 2.05), Vector3.new(-8.5, y0 + 1.7, -6), col.Accent, Enum.Material.SmoothPlastic, false)
	end

	-- Phased-array panel on the hut roof (L4+)
	if lv >= 4 then
		api.part("PhasedArray", Vector3.new(5, 3.6, 0.5), CFrame.new(hx + 1, y0 + hH + 2.4, hz - 1) * CFrame.Angles(math.rad(-20), 0, 0), col.Dark, Enum.Material.Metal)
		for i = -1, 1 do
			api.box("ArrayLed", Vector3.new(0.3, 0.3, 0.1), Vector3.new(hx + 1 + i * 1.2, y0 + hH + 1.4, hz - 0.45), col.Screen, Enum.Material.Neon, false)
		end
	end

	-- Radome on a short tower (L5)
	if lv >= 5 then
		local rtop = tower(-6, -6, 6, 1.4)
		api.ball("Radome", 6.5, Vector3.new(-6, rtop + 3, -6), white, Enum.Material.SmoothPlastic)
	end

	-- Warning lamp on the main tower
	local lamp = api.ball("TowerLamp", 0.6, Vector3.new(tx + 1.5, top + 0.5, tz + 1.5), Color3.fromRGB(255, 50, 40), Enum.Material.SmoothPlastic, false)
	api.light(lamp, 8, 1.2, Color3.fromRGB(255, 60, 40))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Watchtower</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Watchtower installation (HollowBuildingBuilder, StructureVisualConfig.Installations; structure Watchtowers).
	10 x 10 by the main gate: four braced legs, a climbable ladder (TrussPart) on the compound side (-Z, where
	the kiosk is), a sandbagged platform with a roof and a searchlight facing the front wall.
	Height grows with level; L3 mounted gun; L5 gold roof trim + flag.
	v70 (HUD spec §5): the searchlight goes through StructureVisualConfig.BuildingLights like every building light
	(BrightnessScale, SpotMaxRange), with a SmoothPlastic lens and no shadows.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local LIGHTS = (StructureVisualConfig :: any).BuildingLights or {}

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local timber = Color3.fromRGB(96, 78, 56)

	-- L5 gold edge band around a roof (matches the walk-in buildings' gold parapet cap)
	local function goldEdge(cx: number, y: number, cz: number, w: number, d: number)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz + d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz - d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx + w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx - w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
	end

	local function beam(name: string, a: Vector3, b: Vector3, thick: number, color: Color3)
		local mid = (a + b) * 0.5
		api.part(name, Vector3.new(thick, thick, (b - a).Magnitude), CFrame.lookAt(mid, b), color, Enum.Material.Wood, false)
	end

	local h = 10 + lv * 1.6 -- platform height above the foundation
	local L = 3.4 -- leg offset
	for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		api.box("TowerLeg", Vector3.new(0.8, h, 0.8), Vector3.new(o[1] * L, y0 + h * 0.5, o[2] * L), timber, Enum.Material.Wood)
	end
	-- X braces on the three sides away from the ladder, a single rail on the ladder side
	for _, k in ipairs({ 0, 1 }) do
		local ya, yb = y0 + 1 + k * (h - 2) * 0.5, y0 + 1 + (k + 1) * (h - 2) * 0.5
		beam("TowerBrace", Vector3.new(-L, ya, L), Vector3.new(L, yb, L), 0.35, timber)
		beam("TowerBrace", Vector3.new(L, ya, L), Vector3.new(-L, yb, L), 0.35, timber)
		beam("TowerBrace", Vector3.new(-L, ya, -L), Vector3.new(-L, yb, L), 0.35, timber)
		beam("TowerBrace", Vector3.new(L, ya, L), Vector3.new(L, yb, -L), 0.35, timber)
	end

	-- Platform + sandbag parapet (gap over the ladder)
	local py = y0 + h
	api.box("TowerDeck", Vector3.new(8.4, 0.5, 8.4), Vector3.new(0, py + 0.25, 0), timber, Enum.Material.WoodPlanks)
	local deck = py + 0.5
	api.sandbags(-3.6, 3.6, 3.6, deck)
	for _, sx in ipairs({ -3.6, 3.6 }) do
		for i = 0, 2 do
			api.box("Sandbag", Vector3.new(1.5, 1.0, 2.0), Vector3.new(sx, deck + 0.5, -2.2 + i * 2.2), col.Sandbag, Enum.Material.Fabric)
		end
	end
	api.sandbags(-3.6, -1.4, -3.6, deck)
	api.sandbags(1.4, 3.6, -3.6, deck)

	-- Ladder on the compound side
	api.truss("TowerLadder", h + 0.5, Vector3.new(0, y0, -4.4), col.Metal)

	-- Roof on corner posts
	local roofY = deck + 3.6
	for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		api.box("RoofPost", Vector3.new(0.35, 3.6, 0.35), Vector3.new(o[1] * 3.9, deck + 1.8, o[2] * 3.9), timber, Enum.Material.Wood, false)
	end
	api.box("TowerRoof", Vector3.new(9.4, 0.4, 9.4), Vector3.new(0, roofY + 0.2, 0), col.Trim, Enum.Material.Metal)
	if lv >= 5 then
		goldEdge(0, roofY + 0.55, 0, 9.4, 9.4)
		api.box("FlagPole", Vector3.new(0.25, 5, 0.25), Vector3.new(-4.2, roofY + 2.9, -4.2), col.Metal, Enum.Material.Metal, false)
		api.box("Flag", Vector3.new(0.1, 1.8, 3), Vector3.new(-4.2, roofY + 4.4, -2.7), col.Flag, Enum.Material.Fabric, false)
	end

	-- Searchlight facing the front wall (+Z)
	api.box("SearchlightMount", Vector3.new(0.5, 1.2, 0.5), Vector3.new(2, deck + 1.6, 2.8), col.Metal, Enum.Material.Metal, false)
	api.cylinder("Searchlight", Vector3.new(1.4, 1.3, 1.3), CFrame.new(2, deck + 2.5, 2.8) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal, false)
	local lens = api.cylinder("SearchlightLens", Vector3.new(0.1, 1.1, 1.1), CFrame.new(2, deck + 2.5, 3.52) * CFrame.Angles(0, math.rad(-90), 0), col.Light, Enum.Material.SmoothPlastic, false)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Right -- lens local +X = building +Z
	spot.Angle = 40
	spot.Range = math.min(30, LIGHTS.SpotMaxRange or 30)
	spot.Brightness = 2 * (LIGHTS.BrightnessScale or 0.35) -- 0.7 at the v69 scale
	spot.Color = col.Light
	spot.Shadows = false
	spot.Parent = lens

	-- Mounted gun (L3+)
	if lv >= 3 then
		api.box("GunMount", Vector3.new(0.4, 1, 0.4), Vector3.new(-1.8, deck + 1.5, 3), col.Metal, Enum.Material.Metal, false)
		api.box("GunBody", Vector3.new(0.6, 0.6, 1.8), Vector3.new(-1.8, deck + 2.2, 3.2), col.Dark, Enum.Material.Metal, false)
		api.cylinder("GunBarrel", Vector3.new(2, 0.25, 0.25), CFrame.new(-1.8, deck + 2.25, 4.9) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal, false)
	end
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="78">
          <Properties>
            <string name="Name">Interiors</string>
          </Properties>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Armory</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Armory interior (StructureId WeaponsFacility, HollowBuildingBuilder). Weapons storage and issue.

	Ground floor
	  back-east   caged arms-issue counter: steel counter with the Shop terminal set in as the service hatch,
	              bars above, rifle racks on the cage walls behind, sidearm cabinet under the back window
	  west wall   squad loadout bay: Army terminal between kit lockers, loadout board above it
	  front pier  gunsmith workbench (vice, rifle on the bench, tool board) west of the door
	  windows     olive ammo crates (yellow stencil stripe) kept low under the window bands
	  centre      rifle-cleaning table; back-west ammo pallets while single-storey
	  L2+ second cage rack, third locker, tools, more crates / pallet · L3+ pier rifle rack, grenade + rifle crates
	Upper floor (two storeys from L4)
	  west        ammo storage: wall shelving + a freestanding row (L5 adds a third row), pallet of crates
	  east        test-fire lane: baffle wall, shooting bench, target plate and angled steel backstop at the back
	              wall, range terminal (Missions) at the firing point

	Layout (building-local, +Z = front/door): 30 x 22, doorway X 9, console (12.5, 7). The back-west strip
	(X < 6, Z < -4.7) only holds low pallets while single-storey — the stairs take it from L4 and the ammo
	store moves upstairs. Tall pieces stay out of the window bands (front X -10/-3, back X -8/8, sides Z 0).
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local doorX: number = ictx.DoorX
	local M = Enum.Material
	local N = Enum.NormalId
	local wood = Color3.fromRGB(118, 96, 68)
	local paper = col.Sandbag
	local screenBg = Color3.fromRGB(8, 20, 12)

	-- box placed by its bottom centre
	local function blk(name: string, sx: number, sy: number, sz: number, cx: number, yb: number, cz: number, color: Color3, mat: Enum.Material, collide: boolean?): Part
		return api.box(name, Vector3.new(sx, sy, sz), Vector3.new(cx, yb + sy * 0.5, cz), color, mat, collide)
	end

	-- painted stencil (yellow band + lettering) on one face — no extra parts
	local function stencil(host: BasePart, face: Enum.NormalId, text: string, stripe: boolean, top: number?, height: number?)
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_Stencil"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		if stripe then
			local band = Instance.new("Frame")
			band.Name = "Stripe"
			band.BackgroundColor3 = col.Accent
			band.BorderSizePixel = 0
			band.Position = UDim2.fromScale(0, 0.12)
			band.Size = UDim2.fromScale(1, 0.14)
			band.Parent = sg
		end
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Position = UDim2.fromScale(0.08, top or 0.4)
		lbl.Size = UDim2.fromScale(0.84, height or 0.4)
		lbl.Font = Enum.Font.GothamBlack
		lbl.Text = text
		lbl.TextColor3 = col.Accent
		lbl.TextScaled = true
		lbl.Parent = sg
	end

	-- olive ammo crate (bottom-centred), stencilled on the face toward the room; `band` adds a painted
	-- stripe round one end as a real part so it reads from every side
	local function crate(cx: number, yb: number, cz: number, sx: number, sy: number, sz: number, faces: { Enum.NormalId }, label: string, band: boolean): Part
		local c = blk("AmmoCrate", sx, sy, sz, cx, yb, cz, col.Trim, M.WoodPlanks)
		for _, f in ipairs(faces) do
			stencil(c, f, label, true)
		end
		if band then
			if sx >= sz then
				api.box("CrateStripe", Vector3.new(0.3, sy + 0.04, sz + 0.04), Vector3.new(cx + sx * 0.5 - 0.5, yb + sy * 0.5, cz), col.Accent, M.SmoothPlastic, false)
			else
				api.box("CrateStripe", Vector3.new(sx + 0.04, sy + 0.04, 0.3), Vector3.new(cx, yb + sy * 0.5, cz + sz * 0.5 - 0.5), col.Accent, M.SmoothPlastic, false)
			end
		end
		return c
	end

	-- wooden pallet with two crates (and one on top)
	local function pallet(cx: number, yb: number, cz: number, faces: { Enum.NormalId }, label: string, top: boolean)
		blk("Pallet", 4.2, 0.3, 2.6, cx, yb, cz, wood, M.WoodPlanks)
		crate(cx - 1.02, yb + 0.3, cz, 2.0, 1.3, 2.4, faces, label, false)
		crate(cx + 1.02, yb + 0.3, cz, 2.0, 1.3, 2.4, faces, label, false)
		if top then
			crate(cx, yb + 1.6, cz, 2.2, 1.2, 2.2, faces, label, true)
		end
	end

	-- wall rifle rack: steel backboard on the wall, stock tray, n rifles standing barrel-up
	-- wall: "E" | "W" | "B" | "F"; c = centre along the wall; yb = base height
	local function rack(wall: string, c: number, len: number, n: number, yb: number)
		local alongX = wall == "B" or wall == "F"
		local nx, nz, wx, wz = 0, 0, 0, 0
		if wall == "E" then
			nx, wx = -1, X1
		elseif wall == "W" then
			nx, wx = 1, X0
		elseif wall == "B" then
			nz, wz = 1, Z0
		else
			nz, wz = -1, Z1
		end
		local function at(d: number, t: number, y: number): Vector3
			if alongX then
				return Vector3.new(t, y, wz + nz * d)
			end
			return Vector3.new(wx + nx * d, y, t)
		end
		local function dims(depth: number, h: number, length: number): Vector3
			if alongX then
				return Vector3.new(length, h, depth)
			end
			return Vector3.new(depth, h, length)
		end
		api.box("RackBoard", dims(0.24, 5, len), at(0.12, c, yb + 2.5), col.Metal, M.Metal)
		api.box("RackTray", dims(0.6, 0.3, len), at(0.54, c, yb + 0.15), col.Dark, M.Metal)
		for i = 1, n do
			local t = c - len * 0.5 + len * (i - 0.5) / n
			api.box("Rifle", dims(0.5, 3.6, 0.18), at(0.55, t, yb + 0.3 + 1.8), col.Dark, M.Metal, false)
		end
	end

	-- ── Ground floor ─────────────────────────────────────────────────────────

	-- Door runner
	api.box("Runner", Vector3.new(3.4, 0.06, 5.6), Vector3.new(doorX, y1 + 0.03, Z1 - 3.0), col.Rug, M.Fabric, false)

	-- Caged arms-issue counter (back-east). Counter front z -4.4, bars at z -5.3, cage side at x 6.4.
	local cz = -5.0
	local barZ = -5.3
	local sideX = 6.4
	local hatchX = 9.5
	local yTop = y1 + 3.55
	local yHead = y1 + 9.2
	blk("IssueCounter", 2.05, 3.3, 1.2, 7.275, y1, cz, col.Dark, M.Metal)
	blk("IssueCounter", 3.5, 3.3, 1.2, 12.45, y1, cz, col.Dark, M.Metal)
	blk("CounterTop", 2.05, 0.25, 1.5, 7.275, y1 + 3.3, cz + 0.15, col.Metal, M.DiamondPlate)
	blk("CounterTop", 3.5, 0.25, 1.5, 12.45, y1 + 3.3, cz + 0.15, col.Metal, M.DiamondPlate)
	local issue = api.terminal("IssueTerminal", Vector3.new(hatchX, y1, cz), 0, "Shop", "Buy weapons", "Armory · Weapons", { "ARMS ISSUE", "WEAPONS · SHOP" })
	local issuePrompt = issue:FindFirstChild("WE_PanelPrompt")
	if issuePrompt then
		issuePrompt:SetAttribute("WE_OpenTab", "Weapons") -- opens the Shop on its WEAPONS tab
	end
	for _, px in ipairs({ sideX, 8.15, 10.85 }) do
		blk("CagePost", 0.3, yHead - yTop, 0.3, px, yTop, barZ, col.Metal, M.Metal)
	end
	for _, bx in ipairs({ 7.3, 11.65, 12.5, 13.35 }) do
		blk("CageBar", 0.12, yHead - yTop, 0.12, bx, yTop, barZ, col.Metal, M.Metal)
	end
	blk("CageHeader", X1 - 6.25, 0.3, 0.3, (6.25 + X1) * 0.5, yHead, barZ, col.Metal, M.Metal, false)
	-- cage side (floor to header), stops short of the back window band
	for _, bz in ipairs({ -6.3, -7.2, -8.1, -8.95 }) do
		blk("CageBar", 0.12, yHead - y1, 0.12, sideX, y1, bz, col.Metal, M.Metal)
	end
	blk("CageRail", 0.16, 0.2, 3.4, sideX, y1 + 3.35, -7.3, col.Metal, M.Metal)
	local issueSign = blk("IssueSign", 2.3, 1.1, 0.15, hatchX, yHead - 1.15, barZ, col.Dark, M.Metal, false)
	api.surfaceText(issueSign, N.Back, { "ARMS ISSUE" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	api.box("WaitLine", Vector3.new(X1 - 6.25, 0.04, 0.3), Vector3.new((6.25 + X1) * 0.5, y1 + 0.02, -3.6), col.Accent, M.SmoothPlastic, false)

	-- Behind the bars: rifle racks on the cage walls, sidearm cabinet under the back window
	rack("E", -7.7, 3.6, 5, y1 + 0.2)
	if lv >= 2 then
		rack("B", 12.0, 2.8, 4, y1 + 0.2)
	end
	local cabinet = blk("SidearmCabinet", 3.2, 3.0, 1.0, 8.5, y1, Z0 + 0.55, col.Locker, M.Metal)
	stencil(cabinet, N.Back, "SIDEARMS", false)
	if lv >= 3 then
		crate(9.8, y1, -7.5, 3.0, 1.1, 1.3, { N.Back }, "RIFLES", true)
	end

	-- Squad loadout bay (west wall): Army terminal between kit lockers, loadout board above it
	local bayZ = 5.6
	api.terminal("LoadoutTerminal", Vector3.new(X0 + 0.6, y1, bayZ), 90, "Army", "Equip squad", "Squad loadouts", { "SQUAD LOADOUTS", "EQUIP · ARMY" })
	local board = api.box("LoadoutBoard", Vector3.new(0.15, 2.6, 2.6), Vector3.new(X0 + 0.075, y1 + 6.9, bayZ), col.Dark, M.Metal, false)
	api.surfaceText(board, N.Right, { "SQUAD LOADOUTS", "ALPHA · RIFLES", "BRAVO · SUPPORT", "ARMORY LVL " .. tostring(lv) }, col.Screen, screenBg, Enum.Font.Code)
	local lockerZ = { 3.4, 7.7 }
	if lv >= 2 then
		table.insert(lockerZ, 9.1)
	end
	local squads = { "ALPHA", "BRAVO", "CHARLIE" }
	for i, lz in ipairs(lockerZ) do
		local locker = blk("KitLocker", 1.4, 7, 1.4, X0 + 0.7, y1, lz, col.Locker, M.Metal)
		stencil(locker, N.Right, squads[i], false, 0.1, 0.08)
	end

	-- Gunsmith workbench on the front pier west of the door
	local wbX = 2.15
	blk("WorkbenchBase", 4.6, 2.75, 1.6, wbX, y1, Z1 - 0.85, col.Dark, M.Metal)
	blk("Workbench", 4.9, 0.3, 1.9, wbX, y1 + 2.75, Z1 - 1.0, wood, M.WoodPlanks)
	local wbY = y1 + 3.05
	blk("ViceBase", 0.7, 0.3, 0.7, wbX - 1.8, wbY, Z1 - 1.5, col.Metal, M.Metal, false)
	blk("ViceJaw", 1.0, 0.5, 0.3, wbX - 1.8, wbY + 0.3, Z1 - 1.6, col.Dark, M.Metal, false)
	api.part("RifleOnBench", Vector3.new(2.8, 0.22, 0.45), CFrame.new(wbX + 0.4, wbY + 0.11, Z1 - 1.1) * CFrame.Angles(0, math.rad(12), 0), col.Dark, M.Metal, false)
	local toolBoard = blk("ToolBoard", 4.4, 3.0, 0.12, wbX, y1 + 3.5, Z1 - 0.06, col.Metal, M.Metal, false)
	api.light(toolBoard, 10, 0.5, col.Light)
	if lv >= 2 then
		blk("Tool", 0.22, 1.4, 0.08, wbX - 1.4, y1 + 4.3, Z1 - 0.16, col.Dark, M.Metal, false)
		blk("Tool", 1.3, 0.3, 0.08, wbX + 1.0, y1 + 5.6, Z1 - 0.16, col.Dark, M.Metal, false)
	end
	api.part("Stool", Vector3.new(1.9, 1.2, 1.2), CFrame.new(wbX + 0.2, y1 + 0.95, Z1 - 3.0) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, M.Metal).Shape = Enum.PartType.Cylinder

	-- Ammo crates, kept low under the windows
	crate(-4.0, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "5.56 MM", false)
	crate(-1.85, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "5.56 MM", false)
	if lv >= 2 then
		crate(-2.9, y1 + 1.3, Z1 - 0.75, 2.0, 1.2, 1.3, { N.Front }, "7.62 MM", true)
		crate(-11.0, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "7.62 MM", false)
		crate(-8.85, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "7.62 MM", false)
	end
	crate(X1 - 0.7, y1, -1.0, 1.3, 1.3, 2.0, { N.Left }, "40 MM", false)
	crate(X1 - 0.7, y1, 1.1, 1.3, 1.3, 2.0, { N.Left }, "40 MM", false)
	if lv >= 3 then
		crate(X1 - 0.7, y1 + 1.3, 0.05, 1.3, 1.2, 2.0, { N.Left }, "GRENADES", false)
	end

	-- Back-west ammo store (single storey only — the stairs take this strip from L4)
	if not ictx.TwoStory then
		pallet(-9.2, y1, -8.6, { N.Back }, "7.62 MM", lv >= 2)
		if lv >= 2 then
			pallet(-2.6, y1, -8.6, { N.Back }, "5.56 MM", lv >= 3)
		end
	end

	-- Rifle-cleaning table in the middle (second rifle from L2); L3+ rifle rack on the pier between the windows
	blk("CleaningTable", 4.4, 2.8, 1.6, -5.0, y1, 0.8, col.Dark, M.Metal)
	blk("CleaningMat", 4.8, 0.2, 2.0, -5.0, y1 + 2.8, 0.8, col.Rug, M.Fabric)
	api.part("RifleLaid", Vector3.new(3.0, 0.22, 0.5), CFrame.new(-5.5, y1 + 3.11, 0.4) * CFrame.Angles(0, math.rad(6), 0), col.Dark, M.Metal, false)
	if lv >= 2 then
		api.part("RifleLaid", Vector3.new(3.0, 0.22, 0.5), CFrame.new(-4.4, y1 + 3.11, 1.3) * CFrame.Angles(0, math.rad(-8), 0), col.Dark, M.Metal, false)
	end
	if lv >= 3 then
		rack("F", -6.5, 2.2, 3, y1 + 0.2)
	end

	-- ── Upper floor (L4+): ammo storage + test-fire lane ────────────────────
	if ictx.TwoStory then
		local y2: number = ictx.Y2

		-- steel shelving row running along Z with crates / ammo cans on the shelves
		local function shelving(cx: number, z0: number, z1: number, faces: { Enum.NormalId }, loads: { { number } })
			local len = z1 - z0
			local mid = (z0 + z1) * 0.5
			for _, ez in ipairs({ z0 + 0.1, z1 - 0.1 }) do
				api.box("ShelfFrame", Vector3.new(1.3, 6.2, 0.2), Vector3.new(cx, y2 + 3.1, ez), col.Metal, M.Metal)
			end
			-- two shelves; the bottom tier stands on the floor between the frames (pallet-rack style)
			for _, sy in ipairs({ 2.3, 4.3 }) do
				api.box("Shelf", Vector3.new(1.3, 0.15, len - 0.4), Vector3.new(cx, y2 + sy, mid), col.Metal, M.DiamondPlate)
			end
			-- load = { tier 1..3 (1 = floor), z offset from the middle, length, height }
			for _, ld in ipairs(loads) do
				local sy = if ld[1] == 1 then 0 else 0.375 + (ld[1] - 1) * 2
				crate(cx, y2 + sy, mid + ld[2], 1.1, ld[4], ld[3], faces, if ld[1] == 2 then "5.56 MM" else "7.62 MM", false)
			end
		end

		-- Test-fire lane down the east side
		local laneX = (10.3 + X1) * 0.5
		local baffle = blk("LaneBaffle", 0.3, 3.0, 13.95, 10.15, y2, -3.175, col.Stair, M.Concrete)
		stencil(baffle, N.Left, "TEST-FIRE LANE  ·  EYES & EARS", true, 0.38, 0.3)
		api.box("LaneMat", Vector3.new(3.8, 0.05, 13.4), Vector3.new(laneX, y2 + 0.025, -3.4), col.Dark, M.Fabric, false)
		api.box("FiringLine", Vector3.new(3.85, 0.06, 0.3), Vector3.new(laneX, y2 + 0.03, 3.9), col.Accent, M.SmoothPlastic, false)
		blk("ShootingBench", 3.4, 2.6, 1.4, laneX, y2, 4.8, wood, M.WoodPlanks)
		api.box("RangeRifle", Vector3.new(0.45, 0.22, 2.8), Vector3.new(laneX - 0.3, y2 + 2.71, 4.4), col.Dark, M.Metal, false)
		api.part("Backstop", Vector3.new(3.8, 5.2, 0.3), CFrame.new(laneX, y2 + 2.45, -8.9) * CFrame.Angles(math.rad(-25), 0, 0), col.Metal, M.DiamondPlate)
		blk("TargetPost", 0.25, 2.3, 0.25, laneX, y2, -6.6, col.Metal, M.Metal, false)
		local target = api.box("TargetPlate", Vector3.new(1.8, 2.4, 0.15), Vector3.new(laneX, y2 + 3.5, -6.6), paper, M.SmoothPlastic, false)
		do
			local sg = Instance.new("SurfaceGui")
			sg.Name = "WE_Target"
			sg.Face = N.Back
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 40
			sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
			sg.Parent = target
			for i, s in ipairs({ 0.86, 0.66, 0.46, 0.26, 0.1 }) do
				local ring = Instance.new("Frame")
				ring.AnchorPoint = Vector2.new(0.5, 0.5)
				ring.Position = UDim2.fromScale(0.5, 0.42)
				ring.Size = UDim2.fromScale(s, s)
				ring.SizeConstraint = Enum.SizeConstraint.RelativeXX
				ring.BackgroundColor3 = if i % 2 == 1 then col.Dark else paper
				ring.BorderSizePixel = 0
				ring.ZIndex = i
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(0.5, 0)
				corner.Parent = ring
				ring.Parent = sg
			end
		end
		api.terminal("RangeTerminal", Vector3.new(X1 - 0.6, y2, 7.8), -90, "Missions", "Open missions", "Firing range · Missions", { "RANGE CONTROL", "DRILLS · MISSIONS" })

		-- Ammo storage on the west side: wall shelving + a freestanding row (third row at L5), pallets
		shelving(X0 + 0.65, 3.0, 9.6, { N.Right }, { { 1, -1.6, 2.4, 1.3 }, { 1, 1.4, 2.4, 1.3 }, { 2, 0, 1.8, 1.1 } })
		-- v70: crates are stencilled on the face toward the open floor only (SurfaceGui budget; was both faces)
		shelving(-8.5, -3.8, 3.4, { N.Right }, { { 1, -1.6, 2.6, 1.3 }, { 2, 0.6, 2.0, 1.1 }, { 3, -1.4, 1.8, 1.0 } })
		if lv >= 5 then
			shelving(-3.5, -3.8, 3.4, { N.Right }, { { 1, 0, 3.0, 1.3 }, { 2, -1.5, 2.0, 1.1 }, { 3, 0.8, 1.8, 1.0 } })
		end
		pallet(0.2, y2, 7.2, { N.Front }, "7.62 MM", true)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Barracks</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Barracks interior (HollowBuildingBuilder). Where the player's soldiers live and are recruited.

	Ground floor: an open squad bay on the west side — two columns of steel bunks (heads to the west wall and to
	the bay's east edge, open foot posts) with numbered footlockers at their feet, wall lockers between the bunks
	and a runner down the centre aisle (4 bunks at L1, 6 from L2). East side: the recruitment desk facing the door
	(Army terminal, recruiter's chair, flag from L2), a "new recruits" bench by the doorway, the duty-roster /
	training terminal on the east wall under the roster board (Missions), and a mess table with benches in the
	back-east corner (rifle rack from L2).
	Upper floor (two storeys from L3): a second bunk room (2 bunks, 3 from L4) with a locker, the PT corner, kit
	shelves on the front wall, a washroom behind partitions in the back-east corner, and the officer's office in
	the front-east corner behind a half-height partition (desk whose top opens the Army panel, armchair, sector
	map; filing cabinet + flag from L4, rug from L5). L4/L5 also restencil the bay plate (gold at L5).

	Layout (building-local, +Z = front/door, door at X = 10): stairs run along the back wall from L3
	(X -15.2..5, Z -11.2..-5.7), so the bay stops at z = 0 and a cross aisle leads to the stair foot. At L1–L2
	that strip is the PT corner with a kit shelf and crates (it moves upstairs at L3). Tall items stay out of the
	window bands (4.4..7.6 above the floor, 1.2 studs in front of each pane); walkways are >= 2.8 studs.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1 = ictx.Y1
	local X0, X1, Z0, Z1 = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1

	local pillowCol = Color3.fromRGB(206, 200, 182)
	local boardBg = Color3.fromRGB(18, 24, 20)

	local KIT_LINES = { "KIT", "[#] [#]", "-------", "[#][#][#]", "-------", "[#] [#]", "-------" }
	local BUNK_L = 5.2 -- along X
	local BUNK_W = 2.5 -- along Z

	-- Steel bunk bed running along X from xHead (dir = +1 → foot toward +X, -1 → toward -X): solid head frame,
	-- open foot posts (you can see the made-up bunks from the aisle), footlocker at the foot.
	local bunkNo = 0
	local function bunk(xHead: number, z: number, dir: number, y: number)
		bunkNo += 1
		local xFoot = xHead + dir * BUNK_L
		api.box("BunkHead", Vector3.new(0.3, 6.2, BUNK_W), Vector3.new(xHead + dir * 0.15, y + 3.1, z), col.Metal, Enum.Material.Metal)
		for _, s in ipairs({ -1, 1 }) do
			api.box("BunkPost", Vector3.new(0.3, 6.2, 0.3), Vector3.new(xFoot - dir * 0.15, y + 3.1, z + s * (BUNK_W * 0.5 - 0.15)), col.Metal, Enum.Material.Metal, false)
		end
		local mx = xHead + dir * (0.3 + (BUNK_L - 0.3) * 0.5)
		for _, dy in ipairs({ 1.3, 4.4 }) do
			api.box("BunkMattress", Vector3.new(BUNK_L - 0.3, 0.6, BUNK_W - 0.1), Vector3.new(mx, y + dy, z), col.Rug, Enum.Material.Fabric)
		end
		api.box("BunkPillow", Vector3.new(0.9, 0.25, BUNK_W - 0.7), Vector3.new(xHead + dir * 0.85, y + 4.4 + 0.43, z), pillowCol, Enum.Material.Fabric, false)
		local fl = api.box("Footlocker", Vector3.new(1.0, 1.0, 2.1), Vector3.new(xFoot + dir * 0.6, y + 0.5, z), col.Trim, Enum.Material.Wood)
		api.surfaceText(fl, if dir > 0 then Enum.NormalId.Right else Enum.NormalId.Left, { string.format("B-%02d", bunkNo) }, col.Accent, col.Trim, Enum.Font.Code)
	end

	-- Tall wall locker; its door (vents + name tag) faces faceDir (+1 → +X, -1 → -X)
	local function locker(x: number, z: number, faceDir: number, y: number)
		local l = api.box("GearLocker", Vector3.new(1.4, 7, 1.2), Vector3.new(x, y + 3.5, z), col.Locker, Enum.Material.Metal)
		api.surfaceText(l, if faceDir > 0 then Enum.NormalId.Right else Enum.NormalId.Left, { "=====", "=====", "", "", "", "", "", "", "", "", "SQD 1" }, col.Dark, col.Locker, Enum.Font.Code)
	end

	-- ── Ground floor: squad bay ──────────────────────────────────────────────
	local westHead = X0 + 1.0 -- 1 stud off the west wall (clear of the window panes)
	local eastHead = 1.4
	local rows = { 8.9, 5.1 }
	if lv >= 2 then
		table.insert(rows, 1.3)
	end
	for _, z in ipairs(rows) do
		bunk(westHead, z, 1, y1)
		bunk(eastHead, z, -1, y1)
	end
	for i = 1, #rows - 1 do
		local lz = (rows[i] + rows[i + 1]) * 0.5
		locker(westHead + 0.7, lz, 1, y1)
		locker(eastHead - 0.7, lz, -1, y1)
	end
	-- centre-aisle runner (between the footlockers)
	local aisleX = ((westHead + BUNK_L + 1.1) + (eastHead - BUNK_L - 1.1)) * 0.5
	local lastRow = rows[#rows]
	local runZ0, runZ1 = lastRow - 2.4, 10.2
	api.box("AisleRunner", Vector3.new(2.4, 0.06, runZ1 - runZ0), Vector3.new(aisleX, y1 + 0.03, (runZ0 + runZ1) * 0.5), col.Rug, Enum.Material.Fabric, false)
	-- bay stencil on the west wall between the windows
	local bayPlate = api.box("BayPlate", Vector3.new(0.1, 1.4, 5.6), Vector3.new(X0 + 0.05, y1 + 8.6, 0), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(
		bayPlate,
		Enum.NormalId.Right,
		{ if lv >= 4 then "1ST BATTALION · SQUAD BAY" else "1ST PLATOON · SQUAD BAY" },
		if lv >= 5 then col.Gold else col.Accent,
		col.Dark,
		Enum.Font.GothamBlack
	)

	-- ── Recruitment desk (faces the door) → Army ─────────────────────────────
	local deskZ = -1.2
	api.terminal("RecruitTerminal", Vector3.new(9.4, y1, deskZ), 0, "Army", "Recruit soldiers", "Recruitment", { "RECRUITMENT", "ENLIST · TRAIN" })
	local desk = api.box("RecruitDesk", Vector3.new(3.0, 2.6, 1.4), Vector3.new(6.4, y1 + 1.3, deskZ - 0.1), col.Locker, Enum.Material.Metal)
	api.surfaceText(desk, Enum.NormalId.Back, { "", "RECRUITMENT", "" }, if lv >= 5 then col.Gold else col.Accent, col.Locker, Enum.Font.GothamBlack)
	api.box("RecruitDeskTop", Vector3.new(3.3, 0.25, 1.7), Vector3.new(6.4, y1 + 2.72, deskZ - 0.1), col.Dark, Enum.Material.Metal)
	api.chair(Vector3.new(6.4, y1, deskZ - 2.0), Vector3.new(0, 0, 1))
	if lv >= 2 then
		api.box("FlagPole", Vector3.new(0.2, 7.4, 0.2), Vector3.new(3.8, y1 + 3.7, deskZ - 1.8), col.Metal, Enum.Material.Metal, false)
		api.box("FlagCloth", Vector3.new(2.6, 1.7, 0.06), Vector3.new(3.8 + 1.4, y1 + 6.4, deskZ - 1.8), col.Flag, Enum.Material.Fabric, false)
	end

	-- ── Duty roster / training terminal on the east wall → Missions ─────────
	local rosterZ = 1.4
	api.terminal("RosterTerminal", Vector3.new(X1 - 0.6, y1, rosterZ), -90, "Missions", "Check duty roster", "Duty Roster · Training", { "DUTY ROSTER", "TRAINING" })
	local board = api.box("RosterBoard", Vector3.new(0.12, 3.2, 5.4), Vector3.new(X1 - 0.06, y1 + 6.6, rosterZ - 0.5), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(board, Enum.NormalId.Left, { "DUTY ROSTER", "0600  PT · DRILL", "0900  RANGE", "1400  PATROL", "2200  LIGHTS OUT" }, col.Screen, boardBg, Enum.Font.Code)

	-- ── Mess table + benches (back-east) ─────────────────────────────────────
	local messX, messZ = 10.5, -7.6
	api.box("MessTable", Vector3.new(6.0, 0.25, 2.2), Vector3.new(messX, y1 + 2.6, messZ), col.Trim, Enum.Material.WoodPlanks)
	api.box("MessTrestle", Vector3.new(4.8, 2.47, 0.4), Vector3.new(messX, y1 + 1.235, messZ), col.Metal, Enum.Material.Metal, false)
	for _, bz in ipairs({ -1.95, 1.95 }) do
		api.box("MessBench", Vector3.new(6.0, 0.3, 0.9), Vector3.new(messX, y1 + 1.55, messZ + bz), col.Trim, Enum.Material.WoodPlanks)
		api.box("MessBenchLeg", Vector3.new(4.6, 1.4, 0.2), Vector3.new(messX, y1 + 0.7, messZ + bz), col.Metal, Enum.Material.Metal, false)
	end

	-- Rifle rack on the east wall (back corner) from L2
	if lv >= 2 then
		api.box("RifleRack", Vector3.new(0.6, 4.2, 2.4), Vector3.new(X1 - 0.3, y1 + 2.1, Z0 + 1.6), col.Dark, Enum.Material.Metal)
		for i = 0, 1 do
			api.box("RackRifle", Vector3.new(0.25, 3.2, 0.25), Vector3.new(X1 - 0.75, y1 + 2.2, Z0 + 1.1 + i * 1.0), col.Metal, Enum.Material.Metal, false)
		end
	end

	-- Recruit intake: a storage bench along the bay edge, west of the doorway
	local bench = api.box("RecruitBench", Vector3.new(1.0, 1.6, 4.6), Vector3.new(eastHead + 0.75, y1 + 0.8, 6.9), col.Trim, Enum.Material.WoodPlanks)
	api.surfaceText(bench, Enum.NormalId.Right, { "NEW RECRUITS · WAIT HERE" }, col.Accent, col.Trim, Enum.Font.Code)

	-- PT corner + kit shelves along the back wall until the stairs go in (L1–L2)
	if not ictx.TwoStory then
		api.box("PTMat", Vector3.new(8.0, 0.1, 4.4), Vector3.new(-6.0, y1 + 0.05, -6.6), Color3.fromRGB(40, 44, 40), Enum.Material.SmoothPlastic, false)
		for _, px in ipairs({ -8.0, -4.0 }) do
			api.box("PullUpPost", Vector3.new(0.3, 7.0, 0.3), Vector3.new(px, y1 + 3.5, -8.2), col.Metal, Enum.Material.Metal)
		end
		api.box("PullUpBar", Vector3.new(3.7, 0.2, 0.2), Vector3.new(-6.0, y1 + 6.8, -8.2), col.Metal, Enum.Material.Metal, false)
		api.box("WeightBench", Vector3.new(3.4, 1.1, 1.2), Vector3.new(-6.0, y1 + 0.55, -5.4), col.Dark, Enum.Material.Fabric)
		local ks = api.box("KitShelf", Vector3.new(2.6, 7.0, 1.2), Vector3.new(X0 + 1.5, y1 + 3.5, Z0 + 0.6), col.Locker, Enum.Material.Metal)
		api.surfaceText(ks, Enum.NormalId.Back, KIT_LINES, col.Dark, col.Locker, Enum.Font.Code)
		api.box("SupplyCrate", Vector3.new(2.2, 1.6, 1.8), Vector3.new(4.0, y1 + 0.8, Z0 + 1.1), col.Trim, Enum.Material.WoodPlanks)
		api.box("SupplyCrate", Vector3.new(1.8, 1.4, 1.6), Vector3.new(4.0, y1 + 2.3, Z0 + 1.1), col.Trim, Enum.Material.WoodPlanks)
	end

	-- ── Upper floor (L3+) ───────────────────────────────────────────────────
	if ictx.TwoStory then
		local y2 = ictx.Y2
		bunk(westHead, 8.9, 1, y2)
		bunk(eastHead, 8.9, -1, y2)
		locker(westHead + 0.7, 7.0, 1, y2)
		if lv >= 4 then
			bunk(westHead, 5.1, 1, y2)
		end
		-- PT corner (moved up from the ground floor when the stairs went in)
		api.box("PTMat", Vector3.new(8.0, 0.1, 4.4), Vector3.new(-9.0, y2 + 0.05, -3.4), Color3.fromRGB(40, 44, 40), Enum.Material.SmoothPlastic, false)
		api.box("WeightBench", Vector3.new(1.2, 1.1, 3.4), Vector3.new(-9.0, y2 + 0.55, -3.4), col.Dark, Enum.Material.Fabric)

		-- Kit shelves on the front wall between the windows
		local ks = api.box("KitShelf", Vector3.new(2.4, 7.0, 1.2), Vector3.new(6.5, y2 + 3.5, Z1 - 0.6), col.Locker, Enum.Material.Metal)
		api.surfaceText(ks, Enum.NormalId.Front, KIT_LINES, col.Dark, col.Locker, Enum.Font.Code)

		-- Washroom behind a partition in the back-east corner
		api.box("WashPartition", Vector3.new(0.3, 7.0, 2.8), Vector3.new(9.0, y2 + 3.5, -8.8), col.Wall, Enum.Material.Concrete)
		local wp = api.box("WashPartition", Vector3.new(3.6, 7.0, 0.3), Vector3.new(X1 - 1.8, y2 + 3.5, -4.9), col.Wall, Enum.Material.Concrete)
		api.surfaceText(wp, Enum.NormalId.Back, { "WASHROOM" }, col.Dark, col.Wall, Enum.Font.GothamBlack)
		api.box("SinkCounter", Vector3.new(1.4, 2.8, 4.4), Vector3.new(X1 - 0.7, y2 + 1.4, -8.4), col.Metal, Enum.Material.Metal)
		local mirror = api.box("Mirror", Vector3.new(0.1, 1.8, 3.8), Vector3.new(X1 - 0.05, y2 + 4.6, -8.4), col.Glass, Enum.Material.Glass, false)
		mirror.Reflectance = 0.3

		-- Officer's desk (front-east corner); the desk top opens the Army panel
		local odX, odZ = 9.8, 6.0
		api.box("OfficerDesk", Vector3.new(1.4, 2.6, 3.6), Vector3.new(odX, y2 + 1.3, odZ), col.Trim, Enum.Material.Wood)
		local odTop = api.box("OfficerDeskTop", Vector3.new(1.8, 0.25, 4.0), Vector3.new(odX, y2 + 2.72, odZ), col.Dark, Enum.Material.Wood)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "WE_PanelPrompt"
		prompt.ActionText = "Review troops"
		prompt.ObjectText = "Officer's Desk"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12 -- mobile P1-19 (was 8)
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.F
		prompt:SetAttribute("WE_OpenPanel", "Army")
		prompt.Parent = odTop
		-- officer's armchair (upholstered base + high back), facing the room
		api.box("OfficerChair", Vector3.new(1.6, 1.8, 1.6), Vector3.new(odX + 1.9, y2 + 0.9, odZ), col.Dark, Enum.Material.Fabric)
		api.box("OfficerChairBack", Vector3.new(0.35, 2.2, 1.6), Vector3.new(odX + 2.55, y2 + 2.9, odZ), col.Dark, Enum.Material.Fabric, false)
		-- half-height wood partition closing the office off from the landing hall (open on its west end)
		local partX0 = 4.2
		local part = api.box("OfficePartition", Vector3.new(X1 - partX0, 3.0, 0.3), Vector3.new((X1 + partX0) * 0.5, y2 + 1.5, 1.4), col.Trim, Enum.Material.Wood)
		api.surfaceText(part, Enum.NormalId.Front, { "", "OFFICER COMMANDING", "" }, col.Accent, col.Trim, Enum.Font.GothamBlack)
		local map = api.box("MapBoard", Vector3.new(0.12, 3.4, 5.6), Vector3.new(X1 - 0.06, y2 + 5.0, odZ), col.Dark, Enum.Material.Metal, false)
		api.surfaceText(map, Enum.NormalId.Left, { "SECTOR MAP", "◆ HQ    ◇ OUTPOST", "ALL SQUADS READY" }, col.Accent, Color3.fromRGB(46, 58, 40), Enum.Font.GothamBold)
		if lv >= 4 then
			api.box("FilingCabinet", Vector3.new(1.4, 3.8, 1.3), Vector3.new(X1 - 0.8, y2 + 1.9, Z1 - 0.8), col.Metal, Enum.Material.Metal)
			-- flag in the office corner by the partition, cloth hanging toward the room (clear of the map)
			api.box("OfficerFlagPole", Vector3.new(0.2, 7.2, 0.2), Vector3.new(X1 - 1.6, y2 + 3.6, 2.2), col.Metal, Enum.Material.Metal, false)
			api.box("OfficerFlag", Vector3.new(2.4, 1.7, 0.06), Vector3.new(X1 - 1.6 - 1.3, y2 + 6.2, 2.2), col.Flag, Enum.Material.Fabric, false)
		end
		if lv >= 5 then
			api.box("OfficerRug", Vector3.new(5.0, 0.06, 6.0), Vector3.new(odX + 0.8, y2 + 0.03, odZ), col.Rug, Enum.Material.Fabric, false)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">CommandCenter</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Command Center interior (HollowBuildingBuilder). Ground floor: command desk with three monitors, map table
	(opens the Base Upgrades menu), intel terminal (Missions), Missile Command terminal (Missiles), lockers, radio
	rack, wall screen. Upper floor (two storeys): strategy table, war-council terminal (Rebirth), bunk, weapon
	rack. The upgrade console stands inside by the door (BaseLayoutConfig).

	Layout (building-local, +Z = front/door): stairs run along the back wall from L3, so the west desk starts
	at z -1 to leave the foot of the stairs open. The east wall carries the annex doorway from L2 (z -5..-1).
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local y1, y2 = ictx.Y1, ictx.Y2
	local X0, X1, Z0, Z1 = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local doorX = ictx.DoorX

	-- Command desk + monitors along the west wall (z -1..5, clear of the stair foot)
	local deskX = X0 + 1.3
	local deskZ = 2
	api.box("Desk", Vector3.new(2.2, 2.8, 6), Vector3.new(deskX, y1 + 1.4, deskZ), col.Dark, Enum.Material.Metal)
	api.box("DeskTop", Vector3.new(2.8, 0.3, 6.2), Vector3.new(deskX + 0.2, y1 + 2.95, deskZ), col.Metal, Enum.Material.Metal)
	local screenLines = {
		{ "SITREP", "ALL SECTORS", "GREEN" },
		{ "RADAR", "◆  ◇  ◆", "SWEEP" },
		{ "INTEL", "OUTPOSTS", "CONTESTED" },
	}
	for i, mz in ipairs({ -2, 0, 2 }) do
		local mon = api.box("Monitor", Vector3.new(0.25, 1.6, 1.9), Vector3.new(deskX - 0.5, y1 + 3.9, deskZ + mz), col.Dark, Enum.Material.Metal, false)
		api.surfaceText(mon, Enum.NormalId.Right, screenLines[i], col.Screen, Color3.fromRGB(8, 20, 12), Enum.Font.Code)
	end
	api.chair(Vector3.new(deskX + 2.4, y1, deskZ - 1), Vector3.new(-1, 0, 0))
	api.chair(Vector3.new(deskX + 2.4, y1, deskZ + 1.4), Vector3.new(-1, 0, 0))

	-- Map table (centre) — its prompt opens the Base Upgrades menu
	local mapX = -0.4
	api.box("MapTableBase", Vector3.new(6, 2.6, 3.6), Vector3.new(mapX, y1 + 1.3, 1.5), col.Dark, Enum.Material.Metal)
	local mapTop = api.box("MapTable", Vector3.new(6.6, 0.25, 4.2), Vector3.new(mapX, y1 + 2.72, 1.5), col.Trim, Enum.Material.Metal)
	do
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_MapSurface"
		sg.Face = Enum.NormalId.Top
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = mapTop
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(60, 78, 52)
		bg.BorderSizePixel = 0
		bg.Parent = sg
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromScale(0.3, 0.3)
		grid.CellPadding = UDim2.fromScale(0.033, 0.033)
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
		grid.VerticalAlignment = Enum.VerticalAlignment.Center
		grid.Parent = bg
		local cells = { "N", "", "OIL", "", "HQ", "", "FORT", "", "S" }
		for i, label in ipairs(cells) do
			local cell = Instance.new("TextLabel")
			cell.LayoutOrder = i
			cell.BackgroundColor3 = if label == "HQ" then col.Accent else Color3.fromRGB(96, 120, 78)
			cell.BorderSizePixel = 0
			cell.Font = Enum.Font.GothamBold
			cell.Text = label
			cell.TextScaled = true
			cell.TextColor3 = if label == "HQ" then col.Dark else Color3.fromRGB(230, 235, 220)
			cell.Parent = bg
		end
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WE_PanelPrompt"
	prompt.ActionText = "Plan upgrades"
	prompt.ObjectText = "Base Upgrades"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12 -- mobile P1-19 (was 8)
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt:SetAttribute("WE_OpenPanel", "Base")
	prompt.Parent = mapTop

	-- Intel terminal on the east wall (between the annex doorway and the console) → Missions
	api.terminal("IntelTerminal", Vector3.new(X1 - 0.6, y1, 1.6), -90, "Missions", "Open briefings", "Intel · Missions", { "INTEL", "MISSIONS" })

	-- Missile Command terminal on the west wall, between the command desk and the foot of the stairs → Missiles
	api.terminal("MissileTerminal", Vector3.new(X0 + 0.6, y1, -2.4), 90, "Missiles", "Missile Command", "Missile Command", { "MISSILE", "COMMAND" })

	-- Door runner (inside the front wall)
	api.box("Runner", Vector3.new(3.4, 0.06, 7), Vector3.new(doorX, y1 + 0.03, Z1 - 3.7), col.Rug, Enum.Material.Fabric, false)

	-- Lockers in the front-west corner
	for i = 0, 1 do
		local lz = Z1 - 1.0 - i * 1.7
		api.box("Locker", Vector3.new(1.4, 7, 1.6), Vector3.new(X0 + 0.7, y1 + 3.5, lz), col.Locker, Enum.Material.Metal)
		api.box("LockerSeam", Vector3.new(0.1, 6.4, 0.08), Vector3.new(X0 + 1.42, y1 + 3.5, lz), col.Dark, Enum.Material.Metal, false)
	end

	-- Radio rack in the back-east corner
	api.box("RadioRack", Vector3.new(2, 5, 1.4), Vector3.new(X1 - 1.2, y1 + 2.5, Z0 + 0.7), col.Dark, Enum.Material.Metal)
	for i = 0, 2 do
		api.box("RackLed", Vector3.new(0.3, 0.3, 0.1), Vector3.new(X1 - 1.6 + i * 0.4, y1 + 3.8, Z0 + 1.45), if i == 1 then col.Accent else col.Screen, Enum.Material.Neon, false)
	end

	-- Wall screen on the east wall, above the intel terminal and the console
	local wallScreen = api.box("WallScreen", Vector3.new(0.2, 4, 7), Vector3.new(X1 - 0.1, y1 + 6.9, 4.7), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(wallScreen, Enum.NormalId.Left, { "WAR EMPIRE · HQ", "LEVEL " .. tostring(ictx.Level), "BUILD. CONQUER. DOMINATE." }, col.Accent, Color3.fromRGB(10, 14, 12), Enum.Font.GothamBold)

	-- Upper floor
	if ictx.TwoStory then
		api.box("StrategyTable", Vector3.new(7, 2.6, 3.2), Vector3.new(2, y2 + 1.3, 3), col.Dark, Enum.Material.Metal)
		api.box("StrategyTop", Vector3.new(7.4, 0.25, 3.6), Vector3.new(2, y2 + 2.72, 3), col.Trim, Enum.Material.Metal)
		for _, cx in ipairs({ -0.5, 2, 4.5 }) do
			api.chair(Vector3.new(cx, y2, 0.3), Vector3.new(0, 0, 1))
		end
		-- War council terminal against the front wall, between two windows → Rebirth / prestige
		api.terminal("CouncilTerminal", Vector3.new(2.5, y2, Z1 - 0.6), 180, "Rebirth", "Rebirth", "War Council · Rebirth", { "WAR COUNCIL", "REBIRTH" })

		-- Bunk against the west wall (between the west and front windows) + footlocker
		local bx = X0 + 1.2
		local bz = 4
		api.box("Bunk", Vector3.new(2.4, 0.5, 3), Vector3.new(bx, y2 + 1.2, bz), col.Locker, Enum.Material.Metal)
		api.box("Bunk", Vector3.new(2.4, 0.5, 3), Vector3.new(bx, y2 + 4.0, bz), col.Locker, Enum.Material.Metal)
		api.box("BunkPost", Vector3.new(0.3, 4.5, 0.3), Vector3.new(bx + 1.05, y2 + 2.25, bz + 1.35), col.Metal, Enum.Material.Metal, false)
		api.box("BunkPost", Vector3.new(0.3, 4.5, 0.3), Vector3.new(bx + 1.05, y2 + 2.25, bz - 1.35), col.Metal, Enum.Material.Metal, false)
		api.box("Mattress", Vector3.new(2.2, 0.3, 2.8), Vector3.new(bx, y2 + 1.6, bz), col.Rug, Enum.Material.Fabric, false)
		api.box("Mattress", Vector3.new(2.2, 0.3, 2.8), Vector3.new(bx, y2 + 4.4, bz), col.Rug, Enum.Material.Fabric, false)
		api.box("Footlocker", Vector3.new(1.4, 1.1, 2.4), Vector3.new(bx + 2.2, y2 + 0.55, bz), col.Locker, Enum.Material.Metal)

		-- Weapon rack on the east wall (south of the east window)
		api.box("WeaponRack", Vector3.new(0.6, 4, 4), Vector3.new(X1 - 0.4, y2 + 2, 4.5), col.Dark, Enum.Material.Metal)
		for i = 0, 3 do
			api.box("RackRifle", Vector3.new(0.3, 3.2, 0.3), Vector3.new(X1 - 0.9, y2 + 2.1, 3 + i * 1.0), col.Metal, Enum.Material.Metal, false)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">ResearchLab</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Research Lab interior (HollowBuildingBuilder). Four research terminals open the Research panel
	(ResearchController) on their own tab via the prompt attribute WE_OpenTab.

	Ground floor (30 x 22, door X 6..12 on the front wall, console at (12.5, 7)):
	  • Lobby: door runner only; the main aisle Z -4.5..-1.0 runs the width of the room and stays empty
	    (from L3 it leads to the foot of the stairs at the west end).
	  • Weapons bay (east): Weapons terminal between the east windows under a BALLISTICS sign, a ballistics bench
	    (rifle in a test vise, two chronograph units, gel block) firing into a steel bullet trap with an angled
	    deflector plate in the back-east corner. Ammo crates from L2, a rack of prototype rifles from L4.
	  • Bio-armor clean room (front-west): glass partitions on metal kick plates with a hazard-striped door and a
	    BIO-ARMOR LAB sign; armour mannequin on a plinth, laminar-flow bench, sample fridge, Soldiers terminal.
	  • Prototype test stand (front-middle): plinth with a hazard ring and stanchions, a rail-cannon turret that
	    turns slowly (client spinner), TEST IN PROGRESS sign; a quad-rotor drone hangs above it from L4.
	  • Back strip (L1-L2 only; the stairs take it from L3): server racks between the back windows, cryo freezer,
	    data desk.
	Upper floor (L3+):
	  • Server room (back-east): an L of racks with LEDs under a cable tray; the stair landing stays clear.
	  • Engineering wall (east): Vehicles and Defenses terminals under amber signs, a drafting table.
	  • Director's office (front-west) behind glass: desk, chair, bookshelf, plant; L5 adds a gold plaque and a
	    hologram globe.
	  • Analyst pool (middle): two back-to-back desk pairs with monitors, a whiteboard on the west wall.

	Lights: no ceiling fittings added here (the shell has them). At most two dim accents per level. Neon only for
	LEDs and the L5 globe. Screens are dark with green / amber text. Everything is deterministic.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local UP = CFrame.Angles(0, 0, math.pi * 0.5) -- cylinder axis (local X) → vertical
	local screenBg = Color3.fromRGB(8, 20, 12)
	local amber: Color3 = col.Accent
	local olive: Color3 = col.Locker
	local gunmetal = Color3.fromRGB(52, 58, 62)
	local labWhite = Color3.fromRGB(212, 216, 214)
	local woodCol = Color3.fromRGB(96, 70, 48)
	local ledPalette = { col.Screen, col.Screen, Color3.fromRGB(36, 56, 44), amber, col.Screen, Color3.fromRGB(36, 56, 44) }
	local bookPalette = {
		Color3.fromRGB(120, 40, 36),
		Color3.fromRGB(46, 70, 52),
		Color3.fromRGB(40, 52, 86),
		Color3.fromRGB(176, 150, 96),
		Color3.fromRGB(70, 60, 50),
		Color3.fromRGB(150, 110, 60),
	}

	local function cyl(name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material, collide: boolean?): BasePart
		return api.cylinder(name, Vector3.new(length, dia, dia), cf, color, mat, collide)
	end

	local function glass(name: string, size: Vector3, pos: Vector3, collide: boolean): BasePart
		local g = api.box(name, size, pos, col.Glass, M.Glass, collide)
		g.Transparency = 0.55
		g.Reflectance = 0.04
		g.CastShadow = false
		return g
	end

	-- Stencilled text straight onto a surface (transparent background, lit like paint).
	local function paint(host: BasePart, face: Enum.NormalId, lines: { string }, color: Color3)
		api.surfaceText(host, face, lines, color, col.Dark, Enum.Font.GothamBlack)
		for _, g in ipairs(host:GetChildren()) do
			if g:IsA("SurfaceGui") and g.Face == face then
				g.LightInfluence = 1
				local fr = g:FindFirstChildOfClass("Frame")
				if fr then
					fr.BackgroundTransparency = 1
				end
			end
		end
	end

	-- Alternating bars across a face (hazard stripes).
	local function stripes(host: BasePart, face: Enum.NormalId, n: number, a: Color3, b: Color3)
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_Stripes"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		for i = 0, n - 1 do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.Size = UDim2.fromScale(1 / n, 1)
			f.Position = UDim2.fromScale(i / n, 0)
			f.BackgroundColor3 = if i % 2 == 0 then a else b
			f.Parent = sg
		end
	end

	-- Rows of small coloured blocks painted on a face: book spines, drive-bay LEDs (GUI only, no parts).
	local function rows(host: BasePart, face: Enum.NormalId, nRows: number, perRow: number, palette: { Color3 }, bg: Color3, fill: number, glow: boolean)
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_Rows"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = if glow then 0 else 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = bg
		frame.BorderSizePixel = 0
		frame.Parent = sg
		for r = 0, nRows - 1 do
			for i = 0, perRow - 1 do
				local k = r * perRow + i
				local h = fill * (0.76 + (k * 7 % 4) * 0.08)
				local item = Instance.new("Frame")
				item.BorderSizePixel = 0
				item.BackgroundColor3 = palette[(k * 5 + r) % #palette + 1]
				item.Size = UDim2.fromScale(0.8 / perRow, h / nRows)
				item.Position = UDim2.fromScale((i + 0.1) / perRow, (r + 0.94 - h) / nRows)
				item.Parent = frame
			end
		end
	end

	-- Two-part seat (upholstered base + back); (fx, fz) = the way the sitter faces.
	local function seat(x: number, y: number, z: number, fx: number, fz: number)
		api.box("Seat", Vector3.new(1.3, 1.5, 1.3), Vector3.new(x, y + 0.75, z), col.Dark, M.Fabric)
		local backSize = if math.abs(fx) > 0.5 then Vector3.new(0.3, 1.9, 1.3) else Vector3.new(1.3, 1.9, 0.3)
		api.box("SeatBack", backSize, Vector3.new(x - fx * 0.5, y + 2.45, z - fz * 0.5), col.Dark, M.Fabric, false)
	end

	-- Research terminals open the Research panel on their own tab (prompt attribute WE_OpenTab).
	local function setTab(body: any, tab: string)
		local pr = if body then body:FindFirstChild("WE_PanelPrompt") else nil
		if pr then
			pr:SetAttribute("WE_OpenTab", tab)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Lobby: runner from the door (the console stands just inside, east of it)
	------------------------------------------------------------------------------------------------
	api.box("Runner", Vector3.new(3.4, 0.06, 6.9), Vector3.new(ictx.DoorX, y1 + 0.03, Z1 - 3.5), col.Rug, M.Fabric, false)

	------------------------------------------------------------------------------------------------
	-- Weapons bay (east): terminal between the east windows, BALLISTICS sign above the window band
	------------------------------------------------------------------------------------------------
	setTab(api.terminal("WeaponsTerminal", Vector3.new(X1 - 0.6, y1, -0.5), -90, "Research", "Research weapons", "Weapons Research", { "WEAPONS R&D", "DAMAGE · RATE · MAGS" }), "Weapons")
	local bSign = api.box("BallisticsSign", Vector3.new(0.1, 1.2, 5.0), Vector3.new(X1 - 0.05, 8.8, -0.5), col.Dark, M.Metal, false)
	api.surfaceText(bSign, Enum.NormalId.Left, { "BALLISTICS" }, amber, col.Dark, Enum.Font.GothamBlack)

	-- Ballistics bench: rifle in a test vise → two chronograph units → gel block, aimed at the bullet trap
	local bx, bz = 9.0, -7.5
	api.box("BallisticsBench", Vector3.new(4.0, 2.9, 1.8), Vector3.new(bx, y1 + 1.45, bz), gunmetal, M.Metal)
	api.box("BenchTop", Vector3.new(4.2, 0.3, 2.0), Vector3.new(bx, y1 + 3.05, bz), col.Metal, M.DiamondPlate)
	local benchTop = y1 + 3.2
	api.box("TestVise", Vector3.new(0.7, 0.55, 0.7), Vector3.new(7.6, benchTop + 0.275, bz), col.Dark, M.Metal, false)
	api.box("TestRifle", Vector3.new(1.3, 0.4, 0.25), Vector3.new(7.75, benchTop + 0.75, bz), col.Dark, M.Metal, false)
	api.box("TestBarrel", Vector3.new(0.9, 0.14, 0.14), Vector3.new(8.85, benchTop + 0.82, bz), col.Metal, M.Metal, false)
	for i, gx in ipairs({ 9.7, 10.15 }) do
		local gate = api.box("ChronoGate", Vector3.new(0.12, 1.1, 1.0), Vector3.new(gx, benchTop + 0.55, bz), col.Dark, M.Metal, false)
		api.surfaceText(gate, Enum.NormalId.Right, { "V" .. tostring(i), if i == 1 then "912" else "907" }, col.Screen, screenBg, Enum.Font.Code)
	end
	local gel = api.box("GelBlock", Vector3.new(0.7, 0.6, 0.6), Vector3.new(10.65, benchTop + 0.3, bz), Color3.fromRGB(255, 140, 50), M.SmoothPlastic, false)
	gel.Transparency = 0.35

	-- Steel bullet trap (back-east corner) + angled deflector plate facing the bench
	local trapX0 = 12.6
	local trap = api.box("BulletTrap", Vector3.new(X1 - 0.05 - trapX0, 3.9, 3.85), Vector3.new((trapX0 + X1 - 0.05) * 0.5, y1 + 1.95, Z0 + 0.05 + 1.925), col.Dark, M.Metal)
	paint(trap, Enum.NormalId.Left, { "BULLET TRAP", "", "" }, amber)
	do
		local run, rise = 1.25, 2.5
		api.part(
			"TrapPlate",
			Vector3.new(math.sqrt(run * run + rise * rise), 0.2, 3.5),
			CFrame.new(trapX0 - run * 0.5, y1 + rise * 0.5 + 0.06, Z0 + 0.05 + 1.925) * CFrame.Angles(0, 0, math.atan2(rise, run)),
			col.Metal,
			M.DiamondPlate,
			false
		)
	end

	if lv >= 2 then
		local c1 = api.box("AmmoCrate", Vector3.new(1.25, 1.3, 1.6), Vector3.new(X1 - 0.675, y1 + 0.65, -5.3), olive, M.Wood)
		paint(c1, Enum.NormalId.Left, { "AMMO" }, amber)
		api.box("AmmoCrate", Vector3.new(1.1, 1.0, 1.3), Vector3.new(X1 - 0.65, y1 + 1.8, -5.35), olive, M.Wood)
	end
	if lv >= 4 then
		-- prototype rifles on a wall board between the terminal and the east window
		api.box("PrototypeRack", Vector3.new(0.2, 3.6, 1.7), Vector3.new(X1 - 0.1, y1 + 2.3, 1.75), col.Dark, M.Metal, false)
		for i = 0, 2 do
			api.box("PrototypeRifle", Vector3.new(0.25, 2.9, 0.22), Vector3.new(X1 - 0.35, y1 + 2.25, 1.2 + i * 0.55), if i == 1 then olive else gunmetal, M.Metal, false)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Bio-armor clean room (front-west): X -14.15..-6.4, Z 1.5..10.15, glass on kick plates, door X -11.6..-8.0
	------------------------------------------------------------------------------------------------
	local crX0, crXE, crZ = X0 + 0.05, -6.4, 1.5
	local gapA, gapB = -11.6, -8.0
	local PH = 8.0 -- partition height (kick 0.8 + glass 6.8 + header 0.4)
	local function kickGlassAlongX(xa: number, xb: number)
		local cx = (xa + xb) * 0.5
		api.box("KickPlate", Vector3.new(xb - xa, 0.8, 0.25), Vector3.new(cx, y1 + 0.4, crZ), col.Metal, M.Metal)
		glass("GlassPartition", Vector3.new(xb - xa, PH - 1.2, 0.15), Vector3.new(cx, y1 + 0.8 + (PH - 1.2) * 0.5, crZ), true)
	end
	kickGlassAlongX(crX0, gapA)
	kickGlassAlongX(gapB, crXE - 0.15)
	do
		local za, zb = crZ + 0.15, Z1 - 0.05
		local cz = (za + zb) * 0.5
		api.box("KickPlate", Vector3.new(0.25, 0.8, zb - za), Vector3.new(crXE, y1 + 0.4, cz), col.Metal, M.Metal)
		glass("GlassPartition", Vector3.new(0.15, PH - 1.2, zb - za), Vector3.new(crXE, y1 + 0.8 + (PH - 1.2) * 0.5, cz), true)
		api.box("PartitionHeader", Vector3.new(0.3, 0.4, zb - za + 0.3), Vector3.new(crXE, y1 + PH - 0.2, cz - 0.15), col.Trim, M.Metal, false)
	end
	api.box("PartitionHeader", Vector3.new(crXE + 0.15 - crX0, 0.4, 0.3), Vector3.new((crX0 + crXE + 0.15) * 0.5, y1 + PH - 0.2, crZ), col.Trim, M.Metal, false)
	local bioSign = api.box("BioArmorSign", Vector3.new(gapB - gapA, 1.0, 0.2), Vector3.new((gapA + gapB) * 0.5, y1 + PH + 0.5, crZ), col.Dark, M.Metal, false)
	api.surfaceText(bioSign, Enum.NormalId.Front, { "BIO-ARMOR LAB" }, amber, col.Dark, Enum.Font.GothamBlack)
	local sill = api.box("HazardThreshold", Vector3.new(gapB - gapA, 0.05, 0.7), Vector3.new((gapA + gapB) * 0.5, y1 + 0.025, crZ), amber, M.SmoothPlastic, false)
	stripes(sill, Enum.NormalId.Top, 12, amber, col.Dark)

	-- Armour mannequin on a plinth, facing the lab (visible through the glass from the door)
	do
		local mx, mz = -10.4, 6.3
		cyl("MannequinPlinth", 0.5, 2.2, CFrame.new(mx, y1 + 0.25, mz) * UP, col.Metal, M.Metal, true)
		local base = y1 + 0.5
		api.box("MannequinLegs", Vector3.new(0.6, 2.6, 1.0), Vector3.new(mx, base + 1.3, mz), col.Dark, M.Fabric, false)
		api.box("MannequinTorso", Vector3.new(0.8, 1.9, 1.7), Vector3.new(mx, base + 3.55, mz), col.Rug, M.Fabric, false)
		api.box("PlateCarrier", Vector3.new(1.1, 1.4, 1.5), Vector3.new(mx, base + 3.45, mz), olive, M.Fabric, false)
		api.ball("ArmorHelmet", 1.15, Vector3.new(mx, base + 5.05, mz), olive, M.SmoothPlastic, false)
		local visor = api.box("HelmetVisor", Vector3.new(0.14, 0.38, 0.85), Vector3.new(mx + 0.52, base + 4.95, mz), amber, M.SmoothPlastic, false)
		visor.Transparency = 0.2
	end

	-- Laminar-flow bench against the east partition (clear of the front-window band)
	do
		local lx, lz = -7.3, 7.0
		api.box("LaminarCabinet", Vector3.new(1.3, 2.9, 3.2), Vector3.new(lx, y1 + 1.45, lz), labWhite, M.Metal)
		glass("LaminarSash", Vector3.new(1.3, 2.3, 3.0), Vector3.new(lx, y1 + 2.9 + 1.15, lz), false)
		local hood = api.box("LaminarHood", Vector3.new(1.3, 1.1, 3.2), Vector3.new(lx, y1 + 5.2 + 0.55, lz), labWhite, M.Metal, false)
		api.surfaceText(hood, Enum.NormalId.Left, { "LAMINAR FLOW" }, col.Screen, screenBg, Enum.Font.Code)
		api.light(hood, 8, 0.5, Color3.fromRGB(210, 232, 255)) -- accent 1/2 (ground floor)
	end

	-- Sample fridge in the front-west corner
	local fridge = api.box("SampleFridge", Vector3.new(1.5, 3.5, 1.5), Vector3.new(X0 + 0.8, y1 + 1.75, Z1 - 0.8), labWhite, M.Metal)
	api.surfaceText(fridge, Enum.NormalId.Right, { "BIO SAMPLES", "+4 C" }, col.Screen, screenBg, Enum.Font.Code)

	setTab(api.terminal("SoldierTerminal", Vector3.new(-7.3, y1, 3.6), -90, "Research", "Research soldiers", "Soldier Research", { "SOLDIER R&D", "ARMOR · TRAINING" }), "Soldiers")

	------------------------------------------------------------------------------------------------
	-- Prototype test stand (front-middle): plinth, hazard ring, stanchions, turning rail-cannon turret
	------------------------------------------------------------------------------------------------
	local sx, sz = -0.5, 5.0
	cyl("HazardRing", 0.06, 6.3, CFrame.new(sx, y1 + 0.03, sz) * UP, amber, M.SmoothPlastic, false)
	cyl("TestPlinth", 1.0, 5.5, CFrame.new(sx, y1 + 0.5, sz) * UP, col.Metal, M.Concrete, true)
	for _, ox in ipairs({ -1, 1 }) do
		for _, oz in ipairs({ -1, 1 }) do
			api.box("Stanchion", Vector3.new(0.25, 2.6, 0.25), Vector3.new(sx + ox * 2.45, y1 + 1.3, sz + oz * 2.45), amber, M.SmoothPlastic, false)
		end
	end
	do
		local pivot = Vector3.new(sx, y1 + 1.0, sz)
		local aim = CFrame.lookAt(pivot, pivot + Vector3.new(9.5, 0, 5)) -- muzzle (-Z) toward the doorway
		local gun: { BasePart } = {}
		table.insert(gun, cyl("TurretRing", 0.4, 3.6, aim * CFrame.new(0, 0.2, 0) * UP, gunmetal, M.Metal, false))
		table.insert(gun, api.part("TurretHousing", Vector3.new(2.2, 1.6, 2.4), aim * CFrame.new(0, 1.2, 0.4), gunmetal, M.Metal, false))
		table.insert(gun, api.part("TurretPlates", Vector3.new(2.6, 1.0, 1.8), aim * CFrame.new(0, 1.2, 0.3), olive, M.Metal, false))
		for _, s in ipairs({ -1, 1 }) do
			table.insert(gun, api.part("RailBarrel", Vector3.new(0.28, 0.34, 4.4), aim * CFrame.new(s * 0.34, 1.45, -2.3), gunmetal, M.Metal, false))
		end
		table.insert(gun, cyl("RailCoil", 0.8, 1.2, aim * CFrame.new(0, 1.45, -1.5) * CFrame.Angles(0, math.pi * 0.5, 0), amber, M.Metal, false))
		api.spin(gun, pivot, 3)
	end
	local testSign = api.box("TestSign", Vector3.new(0.15, 1.5, 2.0), Vector3.new(3.4, y1 + 0.75, 7.6), amber, M.SmoothPlastic, false)
	api.surfaceText(testSign, Enum.NormalId.Right, { "TEST IN", "PROGRESS" }, col.Dark, amber, Enum.Font.GothamBlack)

	if lv >= 4 then
		-- quad-rotor drone on two cables above the stand (clear of the ceiling lamps)
		local dxc, dzc, dy = sx, sz + 0.6, 9.3
		api.box("DroneArm", Vector3.new(3.0, 0.15, 0.2), Vector3.new(dxc, dy, dzc), gunmetal, M.Metal, false)
		api.box("DroneArm", Vector3.new(0.5, 0.5, 3.0), Vector3.new(dxc, dy - 0.15, dzc), olive, M.Metal, false)
		for _, o in ipairs({ Vector3.new(1.4, 0, 0), Vector3.new(-1.4, 0, 0), Vector3.new(0, 0, 1.4), Vector3.new(0, 0, -1.4) }) do
			cyl("DroneRotor", 0.06, 1.1, CFrame.new(dxc + o.X, dy + 0.15, dzc + o.Z) * UP, col.Dark, M.SmoothPlastic, false)
		end
		for _, s in ipairs({ -1, 1 }) do
			local top = 12.3
			api.box("DroneCable", Vector3.new(0.06, top - dy, 0.06), Vector3.new(dxc + s * 0.9, (top + dy) * 0.5, dzc), col.Metal, M.Metal, false)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Back strip (single storey only): server racks between the back windows, cryo freezer, data desk
	------------------------------------------------------------------------------------------------
	if not ictx.TwoStory then
		for _, rx in ipairs({ -4.0, 4.0 }) do
			local rack = api.box("ServerRack", Vector3.new(2.4, 7.0, 1.4), Vector3.new(rx, y1 + 3.5, Z0 + 0.75), col.Dark, M.Metal)
			rows(rack, Enum.NormalId.Back, 12, 6, ledPalette, col.Dark, 0.25, true)
			api.box("RackLed", Vector3.new(0.2, 0.2, 0.1), Vector3.new(rx - 0.8, y1 + 6.5, Z0 + 1.5), col.Screen, M.Neon, false)
			api.box("RackLed", Vector3.new(0.2, 0.2, 0.1), Vector3.new(rx - 0.4, y1 + 6.5, Z0 + 1.5), amber, M.Neon, false)
		end
		local freezer = api.box("CryoFreezer", Vector3.new(2.8, 3.2, 1.3), Vector3.new(X0 + 1.5, y1 + 1.6, Z0 + 0.7), labWhite, M.Metal)
		api.surfaceText(freezer, Enum.NormalId.Back, { "CRYO STORE", "-80 C" }, col.Screen, screenBg, Enum.Font.Code)
		local ddx, ddz = -8.0, -7.0
		api.box("DataDesk", Vector3.new(2.8, 2.6, 1.1), Vector3.new(ddx, y1 + 1.3, ddz), gunmetal, M.Metal)
		api.box("DataDeskTop", Vector3.new(3.2, 0.2, 1.5), Vector3.new(ddx, y1 + 2.7, ddz), col.Metal, M.Metal)
		for i, off in ipairs({ -0.75, 0.75 }) do
			local mon = api.box("DataMonitor", Vector3.new(1.3, 0.9, 0.12), Vector3.new(ddx + off, y1 + 3.3, ddz - 0.35), col.Dark, M.Metal, false)
			api.surfaceText(mon, Enum.NormalId.Back, if i == 1 then { "TEST LOG", "RUN 14 OK" } else { "SAMPLES", "12 / 12" }, col.Screen, screenBg, Enum.Font.Code)
		end
		seat(ddx, y1, ddz + 1.5, 0, -1)
	end

	------------------------------------------------------------------------------------------------
	-- Upper floor (L3+)
	------------------------------------------------------------------------------------------------
	if ictx.TwoStory then
		local y2: number = ictx.Y2

		-- Server room (back-east): L of racks, LEDs, overhead cable tray. X 9..13, Z -9..-3 stays open.
		local eRack = api.box("ServerRack", Vector3.new(1.0, 7.0, 7.0), Vector3.new(X1 - 0.55, y2 + 3.5, -6.5), col.Dark, M.Metal)
		rows(eRack, Enum.NormalId.Left, 12, 12, ledPalette, col.Dark, 0.25, true)
		local bRack = api.box("ServerRack", Vector3.new(2.1, 7.0, 1.05), Vector3.new(12.05, y2 + 3.5, Z0 + 0.575), col.Dark, M.Metal)
		rows(bRack, Enum.NormalId.Back, 12, 4, ledPalette, col.Dark, 0.25, true)
		api.box("RackLed", Vector3.new(0.1, 0.2, 0.2), Vector3.new(X1 - 1.1, y2 + 6.3, -8.4), col.Screen, M.Neon, false)
		api.box("RackLed", Vector3.new(0.1, 0.2, 0.2), Vector3.new(X1 - 1.1, y2 + 6.3, -4.6), amber, M.Neon, false)
		api.box("CableTray", Vector3.new(1.0, 0.15, 7.4), Vector3.new(X1 - 0.6, y2 + 8.2, -6.4), col.Metal, M.Metal, false)

		-- Engineering & defense wall (east): two terminals under amber signs, drafting table
		setTab(api.terminal("VehicleTerminal", Vector3.new(X1 - 0.6, y2, 4.6), -90, "Research", "Research vehicles", "Vehicle Engineering", { "VEHICLE ENG.", "SPEED · ARMOR" }), "Vehicles")
		setTab(api.terminal("DefenseTerminal", Vector3.new(X1 - 0.6, y2, 8.2), -90, "Research", "Research defenses", "Defense Systems", { "DEFENSE SYSTEMS", "GUARDS · GUNS" }), "Defenses")
		local function engSign(z: number, text: string)
			local s = api.box("EngineeringSign", Vector3.new(0.1, 1.2, 3.2), Vector3.new(X1 - 0.05, 20.75, z), col.Dark, M.Metal, false)
			api.surfaceText(s, Enum.NormalId.Left, { text }, amber, col.Dark, Enum.Font.GothamBlack)
		end
		engSign(4.6, "VEHICLE ENGINEERING")
		engSign(8.2, "DEFENSE SYSTEMS")
		api.box("DraftingStand", Vector3.new(0.6, 2.3, 1.6), Vector3.new(7.5, y2 + 1.15, 2.25), gunmetal, M.Metal)
		local board = api.part("DraftingBoard", Vector3.new(3.0, 0.12, 2.3), CFrame.new(7.5, y2 + 2.55, 2.25) * CFrame.Angles(math.rad(20), 0, 0), labWhite, M.SmoothPlastic)
		api.surfaceText(
			board,
			Enum.NormalId.Top,
			{ "APC-7  SIDE ELEVATION", "[==][========][==]", "(O)    (O)    (O)", "SCALE 1:20" },
			Color3.fromRGB(215, 232, 255),
			Color3.fromRGB(30, 60, 104),
			Enum.Font.Code
		)

		-- Director's office (front-west) behind glass; door gap Z 4.4..7.8 in the east partition
		local oX0, oXE, oZS = X0 + 0.05, -6.4, 3.5
		local oGap0, oGap1 = 4.4, 7.8
		local GH = 7.6
		glass("OfficeGlass", Vector3.new(oXE - 0.15 - oX0, GH, 0.15), Vector3.new((oX0 + oXE - 0.15) * 0.5, y2 + GH * 0.5, oZS), true)
		glass("OfficeGlass", Vector3.new(0.15, GH, oGap0 - (oZS - 0.075)), Vector3.new(oXE, y2 + GH * 0.5, (oGap0 + oZS - 0.075) * 0.5), true)
		glass("OfficeGlass", Vector3.new(0.15, GH, Z1 - 0.05 - oGap1), Vector3.new(oXE, y2 + GH * 0.5, (Z1 - 0.05 + oGap1) * 0.5), true)
		api.box("OfficeHeader", Vector3.new(oXE + 0.15 - oX0, 0.4, 0.3), Vector3.new((oX0 + oXE + 0.15) * 0.5, y2 + GH + 0.2, oZS), col.Trim, M.Metal, false)
		api.box("OfficeHeader", Vector3.new(0.3, 0.4, Z1 - 0.05 - oZS), Vector3.new(oXE, y2 + GH + 0.2, (Z1 - 0.05 + oZS) * 0.5), col.Trim, M.Metal, false)
		api.box("DirectorDesk", Vector3.new(1.4, 2.5, 2.8), Vector3.new(-9.6, y2 + 1.25, 6.3), woodCol, M.Wood)
		api.box("DirectorDeskTop", Vector3.new(1.9, 0.2, 3.2), Vector3.new(-9.6, y2 + 2.6, 6.3), Color3.fromRGB(62, 44, 30), M.Wood)
		seat(-11.3, y2, 6.3, 1, 0)
		local shelf = api.box("Bookshelf", Vector3.new(0.8, 6.8, 4.0), Vector3.new(X0 + 0.45, y2 + 3.4, 6.0), woodCol, M.Wood)
		rows(shelf, Enum.NormalId.Right, 5, 11, bookPalette, Color3.fromRGB(40, 30, 22), 0.8, false)
		cyl("PlantPot", 1.0, 0.9, CFrame.new(-13.3, y2 + 0.5, 9.3) * UP, gunmetal, M.Metal, true)
		api.ball("Plant", 1.6, Vector3.new(-13.3, y2 + 1.7, 9.3), Color3.fromRGB(62, 104, 52), M.Grass, false)
		if lv >= 5 then
			local plaque = api.box("GoldPlaque", Vector3.new(0.12, 1.1, 3.4), Vector3.new(X0 + 0.06, y2 + 7.6, 6.0), col.Gold, M.Metal, false)
			api.surfaceText(plaque, Enum.NormalId.Right, { "WAR EMPIRE", "ADVANCED RESEARCH" }, col.Dark, col.Gold, Enum.Font.GothamBlack)
			cyl("HoloProjector", 0.15, 0.7, CFrame.new(-9.6, y2 + 2.775, 5.4) * UP, col.Dark, M.Metal, false)
			local globe = api.ball("HoloGlobe", 0.8, Vector3.new(-9.6, y2 + 3.35, 5.4), col.Screen, M.Neon, false)
			globe.Transparency = 0.4
			api.light(globe, 6, 0.4, col.Screen) -- accent 1/2 (upper floor)
		end

		-- Analyst pool (middle): two back-to-back desk pairs, >= 2.8 clear of the stair rail
		for i, cx in ipairs({ -3.1, 1.3 }) do
			local cz = 0.5
			api.box("AnalystDesk", Vector3.new(3.2, 0.2, 2.4), Vector3.new(cx, y2 + 2.6, cz), labWhite, M.SmoothPlastic)
			api.box("AnalystDeskPanel", Vector3.new(3.0, 2.5, 0.15), Vector3.new(cx, y2 + 1.25, cz), gunmetal, M.Metal)
			local mon = api.box("AnalystMonitors", Vector3.new(2.6, 0.95, 0.2), Vector3.new(cx, y2 + 3.175, cz), col.Dark, M.Metal, false)
			api.surfaceText(mon, Enum.NormalId.Front, if i == 1 then { "HIT DATA", "DMG +12%" } else { "SQUAD SIM", "HP 117 / 117" }, col.Screen, screenBg, Enum.Font.Code)
			api.surfaceText(mon, Enum.NormalId.Back, if i == 1 then { "RELOAD", "1.69 s" } else { "ENGINE", "RPM OK" }, amber, screenBg, Enum.Font.Code)
			seat(cx, y2, cz - 1.85, 0, 1)
			seat(cx, y2, cz + 1.85, 0, -1)
		end
		local wb = api.box("Whiteboard", Vector3.new(0.1, 2.6, 2.6), Vector3.new(X0 + 0.05, y2 + 3.6, -3.9), Color3.fromRGB(236, 238, 234), M.SmoothPlastic, false)
		api.surfaceText(wb, Enum.NormalId.Right, { "E = 0.5 m v^2", "F = m a", "ROF x 1.15", "MAG 30 > 42" }, Color3.fromRGB(34, 52, 110), Color3.fromRGB(236, 238, 234), Enum.Font.Code)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">SpecialForces</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Special Forces facility interior (HollowBuildingBuilder, config Interior = "SpecialForces"). Elite operators' HQ:
	dark, tactical, no clutter.

	Ground floor
	  West   ops-briefing area: a large wall screen on the west wall, rows of seats on a rubber mat facing it
	         (2 x 3, 2 x 4 from L2) and the ops-briefing podium terminal (Missions) in the front-west corner.
	  Centre sand table (terrain model with the objective pinned).
	  East   tactical gear wall (vests + helmets on a MOLLE board over a kit bench), the operator terminal (Army)
	         under the roster board, equipment cages in the back-east corner (second cage from L2).
	  Front  night-vision / comms bench between the east front window and the door (NVGs, radios in a charging
	         dock, shelf with a manpack from L2, comms monitor from L4); unit colours between the two windows.
	  Back   L1-L2 only: PT corner (mat, pull-up rig, climbing rope, plyo box) — the stairs take that strip at L3.
	Upper floor (two storeys from L3): a kill house of low plywood partitions — four rooms, walk-through, entry and
	  exit on its east side facing the stair landing — with pop-up targets (2 / 3 / 4 at L3 / L4 / L5), the kill-house
	  terminal (Army) beside the entry, a fast-rope / rappel frame over a crash mat (1 / 2 / 3 ropes) and operator
	  lockers with a bench in the back-east corner (a second bank from L4).

	Layout (building-local, +Z = front/door, door at X = 9): stairs run along the back wall from L3
	(X -13.7..5.5, Z -10.2..-5.7, foot at the west end), so nothing collidable sits at z < -4.7 west of x = 6 from L3
	and the strip in front of the stairs stays open. Tall items stay out of the window bands (front windows only on
	the ground floor; front + side windows upstairs) and the upper landing (x 2.9..8.5, z < -4.5) stays clear.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local N = Enum.NormalId
	local screenBg = Color3.fromRGB(8, 20, 12)

	local function B(name: string, sx: number, sy: number, sz: number, x: number, y: number, z: number, color: Color3, mat: Enum.Material, collide: boolean?): Part
		return api.box(name, Vector3.new(sx, sy, sz), Vector3.new(x, y, z), color, mat, collide)
	end

	-- ── Ops briefing (west wall) ─────────────────────────────────────────────
	local scrZ = 2.5
	B("BriefScreenFrame", 0.1, 5.6, 9.6, X0 + 0.05, y1 + 6.8, scrZ, col.Trim, M.Metal, false)
	local scr = B("BriefScreen", 0.15, 5, 9, X0 + 0.175, y1 + 6.8, scrZ, col.Dark, M.SmoothPlastic, false)
	api.light(scr, 10, 0.5, col.Screen)
	api.surfaceText(scr, N.Right, { "OPS BRIEFING · TIER " .. tostring(lv), "OBJ: RIDGE OUTPOST", "INFIL 0300 · NO COMMS" }, col.Screen, screenBg, Enum.Font.Code)

	-- Briefing podium in the front-west corner, beside the screen → Missions
	api.terminal("BriefingTerminal", Vector3.new(X0 + 0.6, y1, 8.6), 90, "Missions", "Mission briefing", "Ops Room", { "OPS ROOM", "MISSION BRIEFING" })

	-- Seats in two rows facing the screen, on a rubber mat
	B("BriefingMat", 7.4, 0.06, 8.6, -8.0, y1 + 0.03, scrZ, col.Rug, M.Fabric, false)
	local seatZ = if lv >= 2 then { -0.5, 1.5, 3.5, 5.5 } else { 0.5, 2.5, 4.5 }
	for _, rx in ipairs({ -9.4, -6.6 }) do
		for _, sz in ipairs(seatZ) do
			api.chair(Vector3.new(rx, y1, sz), Vector3.new(-1, 0, 0))
		end
	end

	-- ── Sand table (centre) ──────────────────────────────────────────────────
	local stX, stZ = 1.4, -0.4
	B("SandTableBase", 4.6, 2.6, 3.0, stX, y1 + 1.3, stZ, col.Dark, M.Metal)
	B("SandTable", 5.2, 0.3, 3.6, stX, y1 + 2.75, stZ, col.Sandbag, M.SmoothPlastic)
	B("SandRidge", 2.2, 0.5, 1.2, stX - 1.1, y1 + 3.15, stZ - 0.9, col.Rug, M.SmoothPlastic, false)
	B("SandObjective", 0.9, 0.4, 0.9, stX + 1.4, y1 + 3.1, stZ + 0.6, col.Dark, M.SmoothPlastic, false)
	B("SandPin", 0.2, 0.9, 0.2, stX + 1.4, y1 + 3.75, stZ + 0.6, col.Accent, M.SmoothPlastic, false)

	-- ── Tactical gear wall (east wall) ───────────────────────────────────────
	local gz = -3.5
	B("GearBoard", 0.15, 5.2, 6.4, X1 - 0.075, y1 + 4.2, gz, col.Dark, M.Metal, false)
	B("HelmetShelf", 0.9, 0.15, 6.2, X1 - 0.6, y1 + 5.5, gz, col.Metal, M.Metal, false)
	local kitZ = if lv >= 2 then { -5.8, -4.25, -2.7, -1.15 } else { -5.4, -3.5, -1.6 }
	for _, kz in ipairs(kitZ) do
		B("Vest", 0.45, 2.2, 1.4, X1 - 0.375, y1 + 3.6, kz, col.Locker, M.Fabric, false)
		B("Helmet", 0.85, 0.55, 0.85, X1 - 0.6, y1 + 5.85, kz, col.Sandbag, M.SmoothPlastic, false)
	end
	B("KitBench", 1.2, 1.0, 5.8, X1 - 0.6, y1 + 0.5, gz, col.Metal, M.Metal)

	-- ── Operator terminal (east wall) → Army, roster board above it ─────────
	local armyZ = 2.4
	api.terminal("OperatorTerminal", Vector3.new(X1 - 0.6, y1, armyZ), -90, "Army", "Command operators", "Special Forces", { "SF COMMAND", "OPERATORS" })
	local roster = B("RosterBoard", 0.12, 2.8, 4.2, X1 - 0.06, y1 + 6.4, armyZ, col.Dark, M.Metal, false)
	api.surfaceText(roster, N.Left, { "OPERATOR ROSTER", "TEAMS READY: " .. tostring(math.min(lv + 1, 6)), "STATUS: GREEN" }, col.Screen, screenBg, Enum.Font.Code)

	-- ── Equipment cages (back-east corner) ───────────────────────────────────
	local cz1 = Z0 + 3.2
	local cageH = 7
	local bounds: { number } = if lv >= 2 then { 6.4, 10.3, X1 } else { 10.3, X1 }
	local postX: { number } = {}
	for i, bx in ipairs(bounds) do
		local px = if i == 1 then bx + 0.15 elseif i == #bounds then bx - 0.15 else bx
		postX[i] = px
		B("CagePost", 0.3, cageH, 0.3, px, y1 + cageH * 0.5, cz1 - 0.15, col.Metal, M.Metal)
		if i < #bounds then
			local side = B("CageMesh", 0.1, cageH - 0.4, cz1 - Z0 - 0.3, px, y1 + 0.2 + (cageH - 0.4) * 0.5, (Z0 + cz1 - 0.3) * 0.5, col.Metal, M.Metal)
			side.Transparency = 0.5
		end
	end
	for i = 1, #bounds - 1 do
		local a, b = postX[i] + 0.15, postX[i + 1] - 0.15
		local front = B("CageMesh", b - a, cageH - 0.4, 0.1, (a + b) * 0.5, y1 + 0.2 + (cageH - 0.4) * 0.5, cz1 - 0.15, col.Metal, M.Metal)
		front.Transparency = 0.5
	end
	-- contents: ammo crates in the corner cage, kit bags in the second
	B("AmmoCrate", 2.4, 1.3, 1.6, 12.3, y1 + 0.65, Z0 + 1.2, col.Locker, M.Wood)
	B("AmmoCrate", 1.8, 1.0, 1.4, 12.3, y1 + 1.8, Z0 + 1.2, col.Locker, M.Wood)
	if lv >= 2 then
		B("KitBag", 2.6, 1.1, 1.3, 8.4, y1 + 0.55, Z0 + 1.1, col.Rug, M.Fabric)
	end

	-- ── Night-vision / comms bench (front wall, between the window and the door) ──
	local bx = 2.1
	local topY = y1 + 2.9
	B("CommsBench", 5.0, 2.7, 1.4, bx, y1 + 1.35, Z1 - 0.7, col.Dark, M.Metal)
	B("CommsBenchTop", 5.3, 0.2, 1.7, bx, y1 + 2.8, Z1 - 0.85, col.Metal, M.DiamondPlate)
	for i = 1, (if lv >= 2 then 2 else 1) do
		local nx = -0.1 + (i - 1) * 1.2
		B("NVGoggles", 0.9, 0.4, 0.5, nx, topY + 0.2, Z1 - 0.9, col.Dark, M.Metal, false)
		B("NVGLens", 0.7, 0.18, 0.06, nx, topY + 0.2, Z1 - 1.18, col.Screen, M.SmoothPlastic, false) -- v70: painted lens (no decorative Neon)
	end
	for _, rx in ipairs({ 2.15, 3.05 }) do
		B("Radio", 0.55, 1.1, 0.4, rx, topY + 0.55, Z1 - 0.7, col.Locker, M.SmoothPlastic, false)
	end
	local shelf = B("CommsShelf", 5.0, 0.4, 0.9, bx, y1 + 5.6, Z1 - 0.45, col.Metal, M.Metal, false)
	api.surfaceText(shelf, N.Front, { "COMMS · NVG" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	if lv >= 2 then
		B("ManpackRadio", 2.2, 0.9, 0.7, 1.2, y1 + 6.25, Z1 - 0.45, col.Locker, M.SmoothPlastic, false)
	end
	if lv >= 4 then
		local mon = B("CommsMonitor", 1.3, 1.0, 0.12, 4.0, topY + 0.5, Z1 - 0.3, col.Dark, M.Metal, false)
		api.surfaceText(mon, N.Front, { "NET 2", "SECURE" }, col.Screen, screenBg, Enum.Font.Code)
	end

	-- Unit colours between the two front windows
	local flag = B("UnitFlag", 1.8, 3.2, 0.08, -6.5, y1 + 6.0, Z1 - 0.04, col.Flag, M.Fabric, false)
	api.surfaceText(flag, N.Front, if lv >= 5 then { "TIER ONE", "SPECIAL", "FORCES" } else { "SPECIAL", "FORCES" }, col.Sandbag, col.Flag, Enum.Font.GothamBlack)

	-- ── PT corner along the back wall (single storey only; the stairs take this strip from L3) ──
	if not ictx.TwoStory then
		B("PTMat", 10.5, 0.08, 4.4, -7.85, y1 + 0.04, -7.8, col.Rug, M.Fabric, false)
		for _, px in ipairs({ -12.2, -7.8 }) do
			B("PullUpPost", 0.35, 8, 0.35, px, y1 + 4, -9.4, col.Metal, M.Metal)
		end
		B("PullUpBar", 4.75, 0.25, 0.25, -10.0, y1 + 7.6, -9.4, col.Metal, M.Metal, false)
		B("RopeBracket", 1.2, 0.3, 1.2, -3.8, y1 + 11.75, -7.6, col.Metal, M.Metal, false)
		B("ClimbRope", 0.35, 10.8, 0.35, -3.8, y1 + 6.2, -7.6, col.Sandbag, M.Fabric, false)
		B("PlyoBox", 2.0, 1.6, 1.6, 0.4, y1 + 0.8, -8.6, col.Sandbag, M.Wood)
		B("Kettlebell", 0.7, 0.7, 0.7, 2.4, y1 + 0.35, -9.3, col.Dark, M.Metal)
		B("Kettlebell", 0.7, 0.7, 0.7, 3.3, y1 + 0.35, -9.3, col.Dark, M.Metal)
	end

	-- ── Upper floor (L3+) ────────────────────────────────────────────────────
	if ictx.TwoStory then
		local y2: number = ictx.Y2
		local wallH = 4.4

		-- Kill house: low plywood partitions from the west wall to x = KX, north edge NZ to the front wall.
		-- Rooms A (NE) → B (NW) → C (SW) → D (SE); entry and exit doors on the east side, 3 studs wide.
		local KX, SX, NZ, CZ = 1.5, -6.2, -3.8, 3.0
		local function partition(x0: number, x1: number, z0: number, z1: number)
			local sx = math.max(x1 - x0, 0.3)
			local sz = math.max(z1 - z0, 0.3)
			B("KillHouseWall", sx, wallH, sz, (x0 + x1) * 0.5, y2 + wallH * 0.5, (z0 + z1) * 0.5, col.Sandbag, M.WoodPlanks)
		end
		partition(X0, KX, NZ, NZ) -- north
		partition(KX, KX, NZ, -2.4) -- east: entry door z -2.4..0.6
		partition(KX, KX, 0.6, 5.4) -- exit door z 5.4..8.4
		partition(KX, KX, 8.4, Z1)
		partition(SX, SX, NZ, -0.2) -- spine: A→B door z -0.2..2.8
		partition(SX, SX, 2.8, 4.8) -- C→D door z 4.8..7.8
		partition(SX, SX, 7.8, Z1)
		partition(X0, -12.6, CZ, CZ) -- cross: B→C door x -12.6..-9.6
		partition(-9.6, SX, CZ, CZ)
		partition(SX, KX, CZ, CZ)

		-- Pop-up targets (dark = hostile, light = no-shoot), facing each room's entry
		local function target(x: number, z: number, alongX: boolean, c: Color3)
			local bs = if alongX then Vector3.new(0.1, 3.2, 1.1) else Vector3.new(1.1, 3.2, 0.1)
			local hs = if alongX then Vector3.new(0.1, 0.8, 0.7) else Vector3.new(0.7, 0.8, 0.1)
			api.box("Target", bs, Vector3.new(x, y2 + 1.6, z), c, M.Wood)
			api.box("TargetHead", hs, Vector3.new(x, y2 + 3.6, z), c, M.Wood, false)
		end
		target(-4.4, -2.6, true, col.Dark)
		target(-12.0, -2.4, true, col.Dark)
		if lv >= 4 then
			target(-7.6, 8.6, false, col.Floor)
		end
		if lv >= 5 then
			target(-0.2, 4.2, true, col.Dark)
		end

		-- Kill-house control terminal beside the entry → Army
		api.terminal("KillHouseTerminal", Vector3.new(KX + 0.8, y2, 3.0), 90, "Army", "Train operators", "Kill House", { "KILL HOUSE", "ROOM-CLEAR DRILL" })
		-- stack-up line on the floor outside the entry (small hazard stripe)
		B("StackLine", 0.25, 0.04, 3.0, KX + 1.3, y2 + 0.02, -0.9, col.Accent, M.SmoothPlastic, false)
		local khSign = B("KillHouseSign", 0.14, 1.1, 4.4, KX, y2 + wallH + 0.55, 3.0, col.Dark, M.Metal, false)
		api.surfaceText(khSign, N.Right, { "KILL HOUSE", "LIVE DRILL" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
		api.light(khSign, 10, 0.6, Color3.fromRGB(255, 96, 64)) -- dim red "live" glow over the entry

		-- Fast-rope / rappel frame over a crash mat (front-east)
		local RX = 10.5
		B("RappelPost", 0.5, 8.3, 0.5, RX, y2 + 4.15, 4.8, col.Metal, M.Metal)
		B("RappelPost", 0.5, 8.3, 0.5, RX, y2 + 4.15, 9.6, col.Metal, M.Metal)
		B("RappelBeam", 0.5, 0.5, 5.3, RX, y2 + 8.55, 7.2, col.Metal, M.Metal)
		B("CrashMat", 4.2, 0.5, 4.2, RX, y2 + 0.25, 7.2, col.Rug, M.Fabric)
		local ropeZ = if lv >= 5 then { 6.0, 7.2, 8.4 } elseif lv >= 4 then { 6.4, 8.0 } else { 7.2 }
		for _, rz in ipairs(ropeZ) do
			B("Rope", 0.35, 7.8, 0.35, RX, y2 + 4.4, rz, col.Sandbag, M.Fabric, false)
		end
		local rSign = B("RappelSign", 0.1, 1.4, 4.0, X1 - 0.05, y2 + 6.2, 7.2, col.Dark, M.Metal, false)
		api.surfaceText(rSign, N.Left, { "FAST ROPE", "RAPPEL POINT" }, col.Accent, col.Dark, Enum.Font.GothamBlack)

		-- Operator lockers + bench (back-east corner, clear of the landing): a bank of three on the back wall,
		-- a bank of two on the east wall from L4 (one body per bank, dark seams between the doors)
		B("LockerBank", 4.8, 7, 1.6, 11.5, y2 + 3.5, Z0 + 0.8, col.Locker, M.Metal)
		for _, sx in ipairs({ 10.7, 12.3 }) do
			B("LockerSeam", 0.08, 6.6, 0.06, sx, y2 + 3.5, Z0 + 1.63, col.Dark, M.Metal, false)
		end
		if lv >= 4 then
			B("LockerBank", 1.6, 7, 3.0, X1 - 0.8, y2 + 3.5, -6.6, col.Locker, M.Metal)
			B("LockerSeam", 0.06, 6.6, 0.08, X1 - 1.63, y2 + 3.5, -6.6, col.Dark, M.Metal, false)
		end
		B("LockerBench", 2.8, 0.9, 1.0, 10.8, y2 + 0.45, -7.4, col.Trim, M.WoodPlanks)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">VehicleDepot</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Vehicle Depot interior (HollowBuildingBuilder) — the motor pool: one tall single-storey workshop hall.

	Ground floor (36 x 28, 14 tall, garage door X -6..10 on the front wall):
	  • Drive lane: two painted lane lines run from the garage door straight back into Bay 1 (x -2.5..6.5),
	    kept clear of everything solid so a vehicle could roll in.
	  • Bay 1 (L1): four-post vehicle lift carrying a generic six-wheel cargo truck (nose to the door).
	    Bay 2 (L3, west): utility jeep. Bay 3 (L5, east): fuel bowser trailer. Oil stains in the bays.
	  • Overhead bridge crane: runway rails on the side walls + bridge beam over the truck's bonnet
	    (below the ceiling lights); an engine hangs from the hook from L4.
	  • Front-west: motor-pool dispatch desk + dispatch terminal (Garage), status board, filing cabinet.
	  • East wall (between the windows): parts cabinet + requisition terminal (Shop); air compressor (L4).
	  • West wall: workbench + pegboard between the windows (L1), second bench + tool chest (L2).
	  • Back wall: tyre stack between bays 2 and 1, fuel drums in the back-east corner (on a spill pallet from L2).
	The upgrade console stands just inside the door on the east side (BaseLayoutConfig) — kept clear.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0, X1, Z0, Z1 = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local UP = CFrame.Angles(0, 0, math.pi * 0.5) -- cylinder axis (local X) → vertical
	local ALONG_Z = CFrame.Angles(0, math.pi * 0.5, 0) -- cylinder axis (local X) → Z
	local oil = Color3.fromRGB(22, 24, 22)
	local tint = Color3.fromRGB(44, 58, 62)
	local paintWhite = Color3.fromRGB(226, 224, 212)

	local function cyl(name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material, collide: boolean?): any
		local p = api.part(name, Vector3.new(length, dia, dia), cf, color, mat, collide)
		p.Shape = Enum.PartType.Cylinder
		return p
	end

	-- Stencilled text painted straight onto a surface: transparent background, lit like paint.
	local function paint(host: any, face: Enum.NormalId, lines: { string }, color: Color3)
		api.surfaceText(host, face, lines, color, col.Dark, Enum.Font.GothamBlack)
		for _, g in ipairs(host:GetChildren()) do
			if g:IsA("SurfaceGui") and g.Face == face then
				g.LightInfluence = 1
				local fr = g:FindFirstChildOfClass("Frame")
				if fr then
					fr.BackgroundTransparency = 1
				end
			end
		end
	end

	-- Floor paint (thin, walk-over)
	local function line(sx: number, sz: number, x: number, z: number, color: Color3)
		api.box("FloorPaint", Vector3.new(sx, 0.04, sz), Vector3.new(x, y1 + 0.02, z), color, M.SmoothPlastic, false)
	end
	local function floorStencil(x: number, z: number, w: number, lines: { string })
		local p = api.box("FloorStencil", Vector3.new(w, 0.04, 1.8), Vector3.new(x, y1 + 0.03, z), col.Floor, M.SmoothPlastic, false)
		p.Transparency = 1
		paint(p, Enum.NormalId.Top, lines, col.Accent)
	end
	local function stain(x: number, z: number, d: number)
		local p = cyl("OilStain", 0.03, d, CFrame.new(x, y1 + 0.016, z) * UP, oil, M.SmoothPlastic, false)
		p.Transparency = 0.25
	end

	------------------------------------------------------------------------------------------------
	-- Drive lane → Bay 1 (the lane lines continue into the bay), stop bar, stencils, oil
	------------------------------------------------------------------------------------------------
	local laneX0, laneX1 = -2.5, 6.5
	local laneLen = (Z1 - 0.1) - (Z0 + 0.4)
	for _, lx in ipairs({ laneX0, laneX1 }) do
		line(0.3, laneLen, lx, (Z1 - 0.1 + Z0 + 0.4) * 0.5, col.Accent)
	end
	line(laneX1 - laneX0 - 0.3, 0.35, (laneX0 + laneX1) * 0.5, 0.1, paintWhite)
	floorStencil(2, 1.6, 5.5, { "BAY 1" })
	stain(2.2, -3.0, 2.2)
	stain(3.8, 4.2, 1.3)

	------------------------------------------------------------------------------------------------
	-- Four-post vehicle lift (Bay 1) + six-wheel cargo truck on it
	------------------------------------------------------------------------------------------------
	local liftX = 2
	local runZ0, runZ1 = -11.8, -1.2
	local yb = y1 + 2.0 -- runway top = tyre contact
	for _, pz in ipairs({ runZ0 - 0.4, runZ1 + 0.4 }) do
		for _, sx in ipairs({ -1, 1 }) do
			api.box("LiftPost", Vector3.new(0.8, 8.4, 0.8), Vector3.new(liftX + sx * 3.2, y1 + 4.2, pz), col.Metal, M.Metal)
		end
		api.box("LiftBeam", Vector3.new(5.6, 0.6, 0.8), Vector3.new(liftX, yb - 0.3, pz), col.Dark, M.Metal)
	end
	for _, sx in ipairs({ -1, 1 }) do
		api.box("LiftRunway", Vector3.new(1.4, 0.4, runZ1 - runZ0), Vector3.new(liftX + sx * 1.75, yb - 0.2, (runZ0 + runZ1) * 0.5), col.Metal, M.DiamondPlate)
	end
	local ctrl = api.box("LiftControl", Vector3.new(0.3, 1.2, 0.8), Vector3.new(liftX + 3.75, y1 + 4.1, runZ1 + 0.4), col.Dark, M.Metal, false)
	paint(ctrl, Enum.NormalId.Right, { "▲", "▼" }, col.Accent)

	local function truck(cx: number, cz: number, base: number)
		for _, wz in ipairs({ 3.2, -1.9, -4.1 }) do
			for _, sx in ipairs({ -1, 1 }) do
				cyl("TruckTyre", 0.9, 2.2, CFrame.new(cx + sx * 1.75, base + 1.1, cz + wz), col.Dark, M.Fabric, false)
			end
		end
		api.box("TruckChassis", Vector3.new(2.6, 0.6, 9.8), Vector3.new(cx, base + 1.3, cz - 0.1), col.Dark, M.Metal)
		api.box("TruckCab", Vector3.new(4.0, 2.8, 2.4), Vector3.new(cx, base + 3.0, cz + 1.2), col.Trim, M.Metal)
		api.box("TruckCabWindows", Vector3.new(4.06, 0.9, 1.5), Vector3.new(cx, base + 3.8, cz + 1.3), tint, M.Glass, false)
		api.box("TruckWindshield", Vector3.new(3.4, 1.0, 0.1), Vector3.new(cx, base + 3.8, cz + 2.44), tint, M.Glass, false)
		api.box("TruckBonnet", Vector3.new(3.6, 1.5, 2.4), Vector3.new(cx, base + 2.35, cz + 3.6), col.Trim, M.Metal)
		api.box("TruckGrille", Vector3.new(2.2, 1.1, 0.1), Vector3.new(cx, base + 2.3, cz + 4.84), col.Dark, M.Metal, false)
		for _, sx in ipairs({ -1, 1 }) do
			api.box("TruckHeadlight", Vector3.new(0.55, 0.55, 0.1), Vector3.new(cx + sx * 1.45, base + 2.55, cz + 4.84), col.Light, M.Glass, false)
		end
		api.box("TruckBumper", Vector3.new(4.4, 0.5, 0.4), Vector3.new(cx, base + 1.35, cz + 5.0), col.Metal, M.Metal, false)
		api.box("TruckBed", Vector3.new(4.4, 0.8, 5.0), Vector3.new(cx, base + 2.0, cz - 2.6), col.Trim, M.Metal)
		local canvas = api.box("TruckCanvas", Vector3.new(4.3, 2.8, 4.8), Vector3.new(cx, base + 3.8, cz - 2.6), col.Rug, M.Fabric)
		paint(canvas, Enum.NormalId.Left, { "★" }, paintWhite)
		paint(canvas, Enum.NormalId.Right, { "★" }, paintWhite)
	end
	truck(liftX, -6.5, yb)

	------------------------------------------------------------------------------------------------
	-- Overhead bridge crane: wall runways, bridge over the truck bonnet, trolley + hook (engine from L4)
	------------------------------------------------------------------------------------------------
	local craneZ = -2.9
	local craneX = liftX
	for _, sx in ipairs({ -1, 1 }) do
		api.box("CraneRunway", Vector3.new(0.6, 0.6, Z1 - Z0), Vector3.new(sx * (X1 - 0.3), y1 + 11.7, 0), col.Metal, M.Metal, false)
	end
	local bridge = api.box("CraneBridge", Vector3.new(X1 - X0 - 0.2, 0.8, 1.0), Vector3.new(0, y1 + 12.4, craneZ), col.Metal, M.Metal, false)
	paint(bridge, Enum.NormalId.Back, { "SWL 5 T" }, col.Accent)
	api.box("CraneTrolley", Vector3.new(1.6, 0.7, 1.6), Vector3.new(craneX, y1 + 11.65, craneZ), col.Dark, M.Metal, false)
	local hookY = if lv >= 4 then y1 + 8.6 else y1 + 9.2
	api.box("CraneChain", Vector3.new(0.15, y1 + 11.3 - hookY, 0.15), Vector3.new(craneX, (y1 + 11.3 + hookY) * 0.5, craneZ), col.Metal, M.Metal, false)
	api.box("CraneHook", Vector3.new(0.7, 0.9, 0.5), Vector3.new(craneX, hookY - 0.45, craneZ), col.Accent, M.Metal, false)
	if lv >= 4 then
		-- engine swap in progress: the block hangs over the truck's open bonnet
		api.box("HoistedEngine", Vector3.new(2.0, 1.5, 1.8), Vector3.new(craneX, hookY - 1.65, craneZ), col.Dark, M.Metal, false)
	end

	------------------------------------------------------------------------------------------------
	-- Motor-pool dispatch (front-west): desk under the front window, chair, dispatch terminal → Garage
	------------------------------------------------------------------------------------------------
	local deskX = -13.3
	api.box("DispatchDesk", Vector3.new(5.0, 2.6, 1.6), Vector3.new(deskX, y1 + 1.3, Z1 - 0.8), col.Locker, M.Metal)
	api.box("DispatchDeskTop", Vector3.new(5.2, 0.2, 1.8), Vector3.new(deskX, y1 + 2.7, Z1 - 0.9), col.Metal, M.Metal)
	local mon = api.box("DispatchMonitor", Vector3.new(1.9, 1.2, 0.15), Vector3.new(deskX - 0.6, y1 + 3.4, Z1 - 1.0), col.Dark, M.Metal, false)
	api.surfaceText(mon, Enum.NormalId.Front, { "DISPATCH LOG", "TRK-01  LIFT 1", "FUEL  OK" }, col.Screen, Color3.fromRGB(8, 20, 12), Enum.Font.Code)
	api.chair(Vector3.new(deskX, y1, Z1 - 3.2), Vector3.new(0, 0, 1))
	api.terminal("DispatchTerminal", Vector3.new(-8.9, y1, Z1 - 0.6), 180, "Garage", "Open garage", "Motor Pool", { "MOTOR POOL", "DISPATCH" })
	api.box("FilingCabinet", Vector3.new(1.3, 4.0, 1.6), Vector3.new(X0 + 0.65, y1 + 2.0, 9.9), col.Locker, M.Metal)
	local board = api.box("StatusBoard", Vector3.new(0.12, 3.0, 3.8), Vector3.new(X0 + 0.06, y1 + 6.2, 10.9), col.Dark, M.Metal, false)
	api.surfaceText(board, Enum.NormalId.Right, {
		"VEHICLE STATUS",
		"TRK-01   ON LIFT",
		if lv >= 3 then "JEEP-02  READY" else "BAY 2    ----",
		if lv >= 5 then "FUEL-03  FUELING" else "BAY 3    ----",
	}, col.Light, Color3.fromRGB(16, 22, 18), Enum.Font.Code)

	------------------------------------------------------------------------------------------------
	-- Parts & fuel counter (east wall, between the windows): requisition terminal → Shop, parts cabinet
	------------------------------------------------------------------------------------------------
	api.terminal("PartsTerminal", Vector3.new(X1 - 0.6, y1, -1.4), -90, "Shop", "Requisition", "Parts & Fuel", { "PARTS & FUEL", "REQUISITION" })
	api.box("PartsCabinet", Vector3.new(1.3, 7.0, 3.2), Vector3.new(X1 - 0.65, y1 + 3.5, 2.0), col.Metal, M.Metal)
	local bank = api.box("PartsDrawers", Vector3.new(0.2, 5.2, 3.0), Vector3.new(X1 - 1.4, y1 + 3.3, 2.0), col.Locker, M.Metal, false)
	paint(bank, Enum.NormalId.Left, { "FILTERS", "BELTS · HOSES", "PLUGS", "TRACK PINS" }, paintWhite)
	local partsSign = api.box("PartsSign", Vector3.new(0.12, 1.8, 6.4), Vector3.new(X1 - 0.06, y1 + 9.2, -0.4), col.Dark, M.Metal, false)
	api.surfaceText(partsSign, Enum.NormalId.Left, { "PARTS & FUEL", "REQUISITION" }, col.Accent, col.Dark, Enum.Font.GothamBlack)

	------------------------------------------------------------------------------------------------
	-- Workbenches along the west wall (pegboards only between / clear of the windows)
	------------------------------------------------------------------------------------------------
	local function bench(z: number, len: number)
		api.box("Workbench", Vector3.new(2.4, 2.4, len), Vector3.new(X0 + 1.2, y1 + 1.2, z), col.Locker, M.Metal)
		api.box("WorkbenchTop", Vector3.new(2.7, 0.25, len + 0.2), Vector3.new(X0 + 1.35, y1 + 2.525, z), col.Metal, M.DiamondPlate)
		api.box("Pegboard", Vector3.new(0.15, 4.0, len), Vector3.new(X0 + 0.075, y1 + 5.2, z), col.Dark, M.Metal, false)
	end
	bench(0, 6.0)
	api.box("BenchVice", Vector3.new(0.9, 0.6, 0.6), Vector3.new(X0 + 2.0, y1 + 2.95, 2.2), col.Metal, M.Metal, false)
	api.box("Wrench", Vector3.new(0.1, 1.8, 0.3), Vector3.new(X0 + 0.2, y1 + 5.6, -1.4), col.Metal, M.Metal, false)
	api.box("Hammer", Vector3.new(0.1, 0.4, 1.2), Vector3.new(X0 + 0.2, y1 + 6.4, 0.6), col.Metal, M.Metal, false)
	if lv >= 2 then
		bench(-11.1, 3.8)
		api.box("ToolChest", Vector3.new(1.3, 3.0, 2.0), Vector3.new(X0 + 0.65, y1 + 1.5, -4.6), col.Locker, M.Metal)
	end

	------------------------------------------------------------------------------------------------
	-- Tyre stack (between bays 2 and 1) and fuel drums (back-east corner)
	------------------------------------------------------------------------------------------------
	for k = 0, 2 do
		cyl("Tyre", 0.8, 2.2, CFrame.new(-3.9, y1 + 0.4 + k * 0.8, Z0 + 1.4) * UP, col.Dark, M.Fabric)
	end
	local drumBase = y1
	if lv >= 2 then
		api.box("SpillPallet", Vector3.new(3.6, 0.3, 3.8), Vector3.new(X1 - 1.8, y1 + 0.15, Z0 + 1.9), col.Dark, M.Metal)
		drumBase = y1 + 0.3
	end
	local drums = { { X1 - 2.7, Z0 + 0.95 }, { X1 - 0.9, Z0 + 0.95 } }
	if lv >= 2 then
		table.insert(drums, { X1 - 2.7, Z0 + 2.85 })
		table.insert(drums, { X1 - 0.9, Z0 + 2.85 })
	end
	for i, d in ipairs(drums) do
		cyl("FuelDrum", 2.8, 1.7, CFrame.new(d[1], drumBase + 1.4, d[2]) * UP, if i % 2 == 0 then col.Trim else col.Locker, M.Metal)
	end

	------------------------------------------------------------------------------------------------
	-- Wall signage
	------------------------------------------------------------------------------------------------
	local sign = api.box("MotorPoolSign", Vector3.new(12, 2.2, 0.15), Vector3.new(liftX, y1 + 10.6, Z0 + 0.075), col.Dark, M.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "MOTOR POOL", "DEPOT LEVEL " .. tostring(lv) }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	if lv >= 2 then
		local ns = api.box("FuelStoreSign", Vector3.new(3.6, 1.4, 0.12), Vector3.new(X1 - 1.8, y1 + 5.0, Z0 + 0.06), col.Dark, M.Metal, false)
		api.surfaceText(ns, Enum.NormalId.Back, { "FUEL STORE", "NO NAKED FLAMES" }, col.Accent, col.Dark, Enum.Font.GothamBold)
		api.box("Extinguisher", Vector3.new(0.6, 1.4, 0.5), Vector3.new(12.3, y1 + 2.2, Z1 - 0.25), Color3.fromRGB(140, 30, 26), M.SmoothPlastic, false)
	end

	------------------------------------------------------------------------------------------------
	-- L3: Bay 2 (west) — utility jeep
	------------------------------------------------------------------------------------------------
	if lv >= 3 then
		local bx0, bx1 = -12.4, -5.2
		for _, lx in ipairs({ bx0, bx1 }) do
			line(0.3, 12.2, lx, Z0 + 0.4 + 6.1, col.Accent)
		end
		floorStencil((bx0 + bx1) * 0.5, 0.8, 5, { "BAY 2" })
		stain(-8.2, -2.4, 1.8)

		local cx, cz = (bx0 + bx1) * 0.5, -6.8
		for _, wz in ipairs({ 2.3, -2.3 }) do
			for _, sx in ipairs({ -1, 1 }) do
				cyl("JeepTyre", 0.8, 2.0, CFrame.new(cx + sx * 1.7, y1 + 1.0, cz + wz), col.Dark, M.Fabric, false)
			end
		end
		api.box("JeepBody", Vector3.new(3.6, 1.1, 6.6), Vector3.new(cx, y1 + 1.45, cz), col.Locker, M.Metal)
		local hood = api.box("JeepBonnet", Vector3.new(3.4, 0.45, 2.2), Vector3.new(cx, y1 + 2.225, cz + 2.1), col.Locker, M.Metal, false)
		paint(hood, Enum.NormalId.Top, { "★" }, paintWhite)
		local ws = api.box("JeepWindshield", Vector3.new(3.4, 1.3, 0.12), Vector3.new(cx, y1 + 2.65, cz + 0.95), tint, M.Glass, false)
		ws.Transparency = 0.3
		api.box("JeepSeats", Vector3.new(3.0, 1.2, 1.0), Vector3.new(cx, y1 + 2.6, cz - 0.4), col.Dark, M.Fabric, false)
		api.box("JeepGrille", Vector3.new(2.0, 0.8, 0.1), Vector3.new(cx, y1 + 1.5, cz + 3.35), col.Dark, M.Metal, false)
		for _, sx in ipairs({ -1, 1 }) do
			api.box("JeepHeadlight", Vector3.new(0.45, 0.45, 0.1), Vector3.new(cx + sx * 1.35, y1 + 1.65, cz + 3.35), col.Light, M.Glass, false)
		end
		cyl("JeepSpare", 0.7, 1.7, CFrame.new(cx, y1 + 1.9, cz - 3.65) * ALONG_Z, col.Dark, M.Fabric, false)
		api.box("JeepAntenna", Vector3.new(0.1, 4.5, 0.1), Vector3.new(cx + 1.5, y1 + 4.25, cz - 3.0), col.Metal, M.Metal, false)
	end

	------------------------------------------------------------------------------------------------
	-- L4: air compressor (east wall, under the window), mechanic's creeper under the truck
	------------------------------------------------------------------------------------------------
	if lv >= 4 then
		cyl("CompressorTank", 2.6, 1.2, CFrame.new(X1 - 0.8, y1 + 0.9, 5.7) * ALONG_Z, col.Locker, M.Metal)
		api.box("CompressorMotor", Vector3.new(1.0, 0.8, 1.2), Vector3.new(X1 - 0.8, y1 + 1.9, 5.2), col.Dark, M.Metal)
		api.box("Creeper", Vector3.new(1.3, 0.3, 2.8), Vector3.new(liftX, y1 + 0.35, -7.5), col.Locker, M.Metal, false)
	end

	------------------------------------------------------------------------------------------------
	-- L5: Bay 3 (east) — fuel bowser trailer
	------------------------------------------------------------------------------------------------
	if lv >= 5 then
		local bx0, bx1 = 7.6, 13.4
		for _, lx in ipairs({ bx0, bx1 }) do
			line(0.3, 12.2, lx, Z0 + 0.4 + 6.1, col.Accent)
		end
		floorStencil((bx0 + bx1) * 0.5, 0.8, 5, { "BAY 3" })
		stain(10.9, -1.6, 1.6)

		local tx, tz = (bx0 + bx1) * 0.5, -7.0
		cyl("BowserTank", 7.0, 3.0, CFrame.new(tx, y1 + 2.9, tz) * ALONG_Z, col.Locker, M.Metal)
		api.box("BowserChassis", Vector3.new(2.4, 0.5, 7.2), Vector3.new(tx, y1 + 1.15, tz), col.Dark, M.Metal)
		for _, wz in ipairs({ -1.4, -3.3 }) do
			for _, sx in ipairs({ -1, 1 }) do
				cyl("BowserTyre", 0.8, 1.8, CFrame.new(tx + sx * 1.6, y1 + 0.9, tz + wz), col.Dark, M.Fabric, false)
			end
		end
		api.box("BowserDrawbar", Vector3.new(0.4, 0.4, 2.6), Vector3.new(tx, y1 + 1.0, tz + 4.9), col.Metal, M.Metal, false)
		local plac = api.box("BowserPlacard", Vector3.new(0.1, 1.2, 1.8), Vector3.new(tx - 1.55, y1 + 2.9, tz + 1.5), col.Accent, M.SmoothPlastic, false)
		api.surfaceText(plac, Enum.NormalId.Left, { "FUEL" }, col.Dark, col.Accent, Enum.Font.GothamBlack)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Warehouse</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Warehouse interior (HollowBuildingBuilder): one tall single-storey storage hall (34 x 26, 14 tall), garage door
	X -3..9 on the front wall, upgrade console just inside at (14.5, 9).

	  • Loading bay (X -4..10, Z 6.2..12.2): kept completely clear, outlined in yellow floor paint + LOADING BAY.
	  • Pallet racking: olive uprights, yellow beams, wooden pallet decks at y1+4.2 and y1+8.2, a deterministic mix
	    of loads on every deck (olive ammo crates with yellow stencil bands, sand cartons, shrink-wrapped loads).
	      Rack A (L1+) along the west wall; aisle A in front of it stays clear.
	      Rack B (L2+) double-sided between aisle A and aisle B.
	      Rack D (L3+) against the back wall.
	  • Cross aisle Z -3.5..1 (X -7..10): clear at every level, edged in yellow.
	  • Floor block stacks of crates (back-middle, L1+); a supply-drop crate with its parachute bundle tops one at L5.
	  • Forklift (L1+) parked by the mouth of aisle A, forks toward the racks, empty pallet on the forks.
	  • Quartermaster cage (back-east): steel counter with a hatch where the Quartermaster terminal stands
	    (Shop → Supply), bar screen above the counter, bar wall along X = 10.3, sign; shelving with helmets and
	    stock, desk and chair inside. Hatched floor in front of the counter.
	  • Supply-run desk (front-west): Supply runs terminal (Missions) under a SUPPLY ROUTES board.
	  • Empty pallets stacked on the east wall; pallet jack (L3+); fuel drums on a spill pallet and a stretch-wrap
	    station with a turning load (L4+); gold WAR EMPIRE LOGISTICS sign over rack D (L5).

	No lights are added here (the shell's ceiling fittings and skylights light the hall). Neon only for the
	forklift beacon. Everything is deterministic; nothing rises above y 12.4 except the L5 wall sign.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local UP = CFrame.Angles(0, 0, math.pi * 0.5) -- cylinder axis (local X) → vertical
	local amber: Color3 = col.Accent
	local olive: Color3 = col.Trim
	local crateOlive: Color3 = col.Locker
	local sand: Color3 = col.Sandbag
	local wood = Color3.fromRGB(150, 112, 70)
	local woodDark = Color3.fromRGB(92, 66, 42)
	local wrapCol = Color3.fromRGB(206, 212, 208)
	local fuelCol = Color3.fromRGB(110, 52, 42)
	local tyre = Color3.fromRGB(24, 24, 24)

	local function cyl(name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material, collide: boolean?): BasePart
		return api.cylinder(name, Vector3.new(length, dia, dia), cf, color, mat, collide)
	end

	-- Stencilled text straight onto a surface (transparent background, lit like paint).
	local function paint(host: BasePart, face: Enum.NormalId, lines: { string }, color: Color3)
		api.surfaceText(host, face, lines, color, col.Dark, Enum.Font.GothamBlack)
		for _, g in ipairs(host:GetChildren()) do
			if g:IsA("SurfaceGui") and g.Face == face then
				g.LightInfluence = 1
				local fr = g:FindFirstChildOfClass("Frame")
				if fr then
					fr.BackgroundTransparency = 1
				end
			end
		end
	end

	local function newGui(host: BasePart, face: Enum.NormalId, name: string): SurfaceGui
		local sg = Instance.new("SurfaceGui")
		sg.Name = name
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		return sg
	end

	-- n alternating bars across a face (vertical, or horizontal slats); b = nil leaves the gaps see-through.
	local function stripes(host: BasePart, face: Enum.NormalId, n: number, a: Color3, b: Color3?, horizontal: boolean)
		local sg = newGui(host, face, "WE_Stripes")
		for i = 0, n - 1 do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			if horizontal then
				f.Size = UDim2.fromScale(1, 1 / n)
				f.Position = UDim2.fromScale(0, i / n)
			else
				f.Size = UDim2.fromScale(1 / n, 1)
				f.Position = UDim2.fromScale(i / n, 0)
			end
			if i % 2 == 0 then
				f.BackgroundColor3 = a
			elseif b then
				f.BackgroundColor3 = b
			else
				f.BackgroundTransparency = 1
			end
			f.Parent = sg
		end
	end

	-- Bar screen: faint steel panel with painted vertical bars on both big faces (collidable, see-through).
	local function barScreen(host: BasePart, faces: { Enum.NormalId }, n: number)
		host.Transparency = 0.8
		host.CastShadow = false
		for _, face in ipairs(faces) do
			local sg = newGui(host, face, "WE_Bars")
			for i = 0, n - 1 do
				local f = Instance.new("Frame")
				f.BorderSizePixel = 0
				f.BackgroundColor3 = col.Metal
				f.Size = UDim2.fromScale(0.3 / n, 1)
				f.Position = UDim2.fromScale((i + 0.35) / n, 0)
				f.Parent = sg
			end
			for _, yy in ipairs({ 0, 0.5, 0.97 }) do
				local rail = Instance.new("Frame")
				rail.BorderSizePixel = 0
				rail.BackgroundColor3 = col.Metal
				rail.Size = UDim2.fromScale(1, 0.03)
				rail.Position = UDim2.fromScale(0, yy)
				rail.Parent = sg
			end
		end
	end

	-- Olive ammo crate stencil: two yellow bands + text.
	local function stencil(host: BasePart, face: Enum.NormalId, text: string)
		local sg = newGui(host, face, "WE_Stencil")
		for _, yy in ipairs({ 0.12, 0.8 }) do
			local band = Instance.new("Frame")
			band.BorderSizePixel = 0
			band.BackgroundColor3 = amber
			band.Size = UDim2.fromScale(1, 0.08)
			band.Position = UDim2.fromScale(0, yy)
			band.Parent = sg
		end
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(0.8, 0.36)
		t.Position = UDim2.fromScale(0.1, 0.32)
		t.Font = Enum.Font.GothamBlack
		t.Text = text
		t.TextScaled = true
		t.TextColor3 = amber
		t.Parent = sg
	end

	-- Two-part seat (upholstered base + back); (fx, fz) = the way the sitter faces.
	local function seat(x: number, y: number, z: number, fx: number, fz: number)
		api.box("Seat", Vector3.new(1.3, 1.5, 1.3), Vector3.new(x, y + 0.75, z), col.Dark, M.Fabric)
		local backSize = if math.abs(fx) > 0.5 then Vector3.new(0.3, 1.9, 1.3) else Vector3.new(1.3, 1.9, 0.3)
		api.box("SeatBack", backSize, Vector3.new(x - fx * 0.5, y + 2.45, z - fz * 0.5), col.Dark, M.Fabric, false)
	end

	------------------------------------------------------------------------------------------------
	-- Pallet racking
	------------------------------------------------------------------------------------------------
	local KINDS = { "ammo", "carton", "wrap", "carton", "ammo", "wrap", "carton", "ammo", "wrap", "carton", "ammo", "carton", "wrap", "ammo" }
	local loadNo = 0
	-- One pallet load standing on a deck at `base`; w = along the rack run, d = rack depth.
	local function load(pos: Vector3, base: number, w: number, d: number, maxH: number, alongX: boolean, face: Enum.NormalId, solid: boolean)
		loadNo += 1
		local kind = KINDS[(loadNo - 1) % #KINDS + 1]
		local function size(a: number, h: number, b: number): Vector3
			return if alongX then Vector3.new(a, h, b) else Vector3.new(b, h, a)
		end
		if kind == "ammo" then
			local h = math.min(2.2, maxH)
			local p = api.box("AmmoLoad", size(w - 0.3, h, d - 0.2), Vector3.new(pos.X, base + h * 0.5, pos.Z), crateOlive, M.Wood, solid)
			stencil(p, face, "AMMO")
		elseif kind == "carton" then
			local h = math.min(2.6, maxH)
			api.box("CartonLoad", size(w - 0.2, h, d - 0.1), Vector3.new(pos.X, base + h * 0.5, pos.Z), sand, M.Cardboard, solid)
		else
			local h = math.min(2.8, maxH)
			local p = api.box("WrappedLoad", size(w - 0.1, h, d - 0.05), Vector3.new(pos.X, base + h * 0.5, pos.Z), wrapCol, M.SmoothPlastic, solid)
			p.Transparency = 0.25
		end
	end

	--[[ Rack running along X (alongX) or Z, from a0 to a1, depth d0..d1, `bays` equal bays. `lines` = depth
		coordinates of the upright lines (the aisle faces; a wall rack has none at the wall). Decks and loads are
		walk-through (non-collidable) so beams and pallets never snag; only the uprights collide. ]]
	local function rack(alongX: boolean, a0: number, a1: number, d0: number, d1: number, bays: number, lines: { number }, face: Enum.NormalId)
		local function P(a: number, y: number, d: number): Vector3
			return if alongX then Vector3.new(a, y, d) else Vector3.new(d, y, a)
		end
		local function S(a: number, y: number, d: number): Vector3
			return if alongX then Vector3.new(a, y, d) else Vector3.new(d, y, a)
		end
		local span = (a1 - a0 - 0.4) / bays
		local dc = (d0 + d1) * 0.5
		local depth = d1 - d0
		for k = 0, bays do
			local a = a0 + 0.2 + k * span
			for _, ld in ipairs(lines) do
				api.box("RackUpright", S(0.4, 12, 0.4), P(a, y1 + 6, ld), olive, M.Metal)
			end
		end
		for _, deckY in ipairs({ 4.2, 8.2 }) do
			for _, ld in ipairs(lines) do
				api.box("RackBeam", S(a1 - a0, 0.5, 0.3), P((a0 + a1) * 0.5, y1 + deckY - 0.25, ld), amber, M.Metal, false)
			end
			local deck = api.box("PalletDeck", S(a1 - a0 - 0.1, 0.45, depth - 0.1), P((a0 + a1) * 0.5, y1 + deckY + 0.225, dc), wood, M.WoodPlanks, false)
			stripes(deck, face, bays * 6, woodDark, wood, false)
			local maxH = if deckY < 5 then 2.9 else 3.1
			for k = 0, bays - 1 do
				load(P(a0 + 0.2 + (k + 0.5) * span, 0, dc), y1 + deckY + 0.45, span - 0.4, depth - 0.2, maxH, alongX, face, false)
			end
		end
	end

	-- Rack A (west wall), aisle A X -14.35..-10.2 in front of it
	rack(false, -11.9, 3.7, X0 + 0.05, -14.35, 4, { -14.55 }, Enum.NormalId.Right)
	-- Rack B (double-sided), aisle B X -7.0..-4 east of it
	if lv >= 2 then
		rack(false, -11.9, 0, -10.2, -7.0, 3, { -10.0, -7.2 }, Enum.NormalId.Right)
	end
	-- Rack D (back wall)
	if lv >= 3 then
		rack(true, -2, 8, Z0 + 0.05, -10.35, 3, { -10.55 }, Enum.NormalId.Back)
	end
	if lv < 2 then
		-- L1: pallets staged on the floor where rack B goes in (solid; aisles A and B stay clear)
		for _, z in ipairs({ -9.4, -5.4 }) do
			api.box("FloorPallet", Vector3.new(3.0, 0.45, 3.0), Vector3.new(-8.6, y1 + 0.225, z), wood, M.WoodPlanks)
			load(Vector3.new(-8.6, 0, z), y1 + 0.45, 3.2, 3.1, 2.6, false, Enum.NormalId.Right, true)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Floor block stacks (back-middle, between rack D and the cross aisle)
	------------------------------------------------------------------------------------------------
	local function crate(x: number, y: number, z: number, s: number, yawDeg: number, color: Color3, mat: Enum.Material, label: string?): BasePart
		local p = api.part("StackCrate", Vector3.new(s, s, s), CFrame.new(x, y + s * 0.5, z) * CFrame.Angles(0, math.rad(yawDeg), 0), color, mat)
		if label then
			stencil(p, Enum.NormalId.Back, label)
		end
		return p
	end
	crate(1.6, y1, -6.4, 2.4, 0, wood, M.WoodPlanks)
	crate(1.6, y1 + 2.4, -6.4, 2.4, 6, crateOlive, M.Wood, "SUPPLY")
	crate(4.6, y1, -6.0, 2.4, 3, crateOlive, M.Wood, "RATIONS")
	crate(4.6, y1 + 2.4, -6.0, 2.4, -7, wood, M.WoodPlanks)
	if lv >= 5 then
		crate(4.6, y1 + 4.8, -6.0, 2.2, 4, crateOlive, M.Wood, "AIRDROP")
		api.part("ParachuteBundle", Vector3.new(1.6, 0.7, 1.3), CFrame.new(4.6, y1 + 7.0 + 0.35, -6.0) * CFrame.Angles(0, math.rad(4), 0), sand, M.Fabric, false)
		local sign = api.box("LogisticsSign", Vector3.new(9.0, 1.2, 0.1), Vector3.new(3.0, y1 + 12.8, Z0 + 0.05), col.Dark, M.Metal, false)
		api.surfaceText(sign, Enum.NormalId.Back, { "WAR EMPIRE LOGISTICS" }, col.Gold, col.Dark, Enum.Font.GothamBlack)
	end

	------------------------------------------------------------------------------------------------
	-- Forklift by the mouth of aisle A (faces -Z; only the chassis and counterweight collide)
	------------------------------------------------------------------------------------------------
	do
		local fx = -10.0
		api.box("ForkliftChassis", Vector3.new(2.2, 1.2, 3.4), Vector3.new(fx, y1 + 0.95, 7.3), amber, M.Metal)
		api.box("ForkliftCounterweight", Vector3.new(2.2, 1.6, 0.9), Vector3.new(fx, y1 + 1.15, 9.35), col.Dark, M.Metal)
		cyl("ForkliftWheels", 2.8, 1.1, CFrame.new(fx, y1 + 0.55, 6.2), tyre, M.Fabric, false)
		cyl("ForkliftWheels", 2.8, 0.9, CFrame.new(fx, y1 + 0.45, 8.8), tyre, M.Fabric, false)
		api.box("ForkliftSeat", Vector3.new(1.3, 0.8, 1.1), Vector3.new(fx, y1 + 1.95, 8.2), col.Dark, M.Fabric, false)
		cyl("ForkliftSteering", 0.12, 0.9, CFrame.new(fx, y1 + 1.95, 6.9) * CFrame.Angles(math.rad(35), 0, 0) * UP, col.Dark, M.Metal, false)
		for _, px in ipairs({ -1, 1 }) do
			for _, pz in ipairs({ 6.2, 8.7 }) do
				api.box("ForkliftGuardPost", Vector3.new(0.18, 2.6, 0.18), Vector3.new(fx + px * 0.95, y1 + 2.85, pz), col.Dark, M.Metal, false)
			end
		end
		api.box("ForkliftGuardRoof", Vector3.new(2.1, 0.15, 2.8), Vector3.new(fx, y1 + 4.225, 7.45), col.Dark, M.Metal, false)
		for _, px in ipairs({ -1, 1 }) do
			api.box("ForkliftMast", Vector3.new(0.25, 5.6, 0.3), Vector3.new(fx + px * 0.75, y1 + 3.0, 5.45), col.Metal, M.Metal, false)
		end
		api.box("ForkliftCarriage", Vector3.new(1.9, 1.0, 0.2), Vector3.new(fx, y1 + 1.1, 5.2), col.Dark, M.Metal, false)
		for _, px in ipairs({ -1, 1 }) do
			api.box("ForkliftFork", Vector3.new(0.25, 0.12, 1.9), Vector3.new(fx + px * 0.5, y1 + 0.66, 4.15), col.Metal, M.Metal, false)
		end
		api.box("ForkliftPallet", Vector3.new(2.0, 0.4, 1.9), Vector3.new(fx, y1 + 0.92, 4.15), wood, M.WoodPlanks, false)
		api.ball("ForkliftBeacon", 0.3, Vector3.new(fx, y1 + 4.45, 8.4), amber, M.Neon, false)
	end

	------------------------------------------------------------------------------------------------
	-- Quartermaster cage (back-east): counter with a hatch, terminal in the hatch → Shop (Supply tab)
	------------------------------------------------------------------------------------------------
	local cageX = 10.3
	api.box("QMCounter", Vector3.new(11.9 - cageX, 3.3, 1.2), Vector3.new((cageX + 11.9) * 0.5, y1 + 1.65, -1.4), col.Metal, M.DiamondPlate)
	api.box("QMCounter", Vector3.new(X1 - 0.05 - 14.5, 3.3, 1.2), Vector3.new((14.5 + X1 - 0.05) * 0.5, y1 + 1.65, -1.4), col.Metal, M.DiamondPlate)
	local qm = api.terminal("QMTerminal", Vector3.new(13.2, y1, -1.4), 0, "Shop", "Requisition", "Quartermaster", { "QUARTERMASTER", "SUPPLY DROPS" })
	local qmPrompt = if qm then qm:FindFirstChild("WE_PanelPrompt") else nil
	if qmPrompt then
		qmPrompt:SetAttribute("WE_OpenTab", "Supply")
	end
	local screen = api.box("QMCageScreen", Vector3.new(X1 - 0.05 - cageX, 4.4, 0.1), Vector3.new((cageX + X1 - 0.05) * 0.5, 7.2, -1.4), col.Metal, M.Metal)
	barScreen(screen, { Enum.NormalId.Front, Enum.NormalId.Back }, 18)
	local side = api.box("QMCageSide", Vector3.new(0.1, 9.0, -2.0 - (Z0 + 0.05)), Vector3.new(cageX + 0.05, y1 + 4.5, (Z0 + 0.05 - 2.0) * 0.5), col.Metal, M.Metal)
	barScreen(side, { Enum.NormalId.Left, Enum.NormalId.Right }, 30)
	local qmSign = api.box("QMSign", Vector3.new(X1 - 0.05 - cageX, 1.4, 0.2), Vector3.new((cageX + X1 - 0.05) * 0.5, 10.1, -1.4), col.Dark, M.Metal, false)
	api.surfaceText(qmSign, Enum.NormalId.Back, { "QUARTERMASTER" }, amber, col.Dark, Enum.Font.GothamBlack)
	-- inside: stock shelving on the east wall (painted stock + two helmets), desk and chair
	local shelving = api.box("QMShelving", Vector3.new(1.0, 7.0, 7.6), Vector3.new(X1 - 0.55, y1 + 3.5, -7.8), col.Metal, M.Metal)
	do
		local sg = newGui(shelving, Enum.NormalId.Left, "WE_Stock")
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = col.Dark
		bg.BorderSizePixel = 0
		bg.Parent = sg
		local stock = { sand, crateOlive, sand, col.Rug, wood, crateOlive }
		for r = 0, 3 do
			for i = 0, 4 do
				local k = r * 5 + i
				local h = 0.55 + (k * 3 % 4) * 0.08
				local box = Instance.new("Frame")
				box.BorderSizePixel = 0
				box.BackgroundColor3 = stock[(k * 5 + r) % #stock + 1]
				box.Size = UDim2.fromScale(0.16, h / 4)
				box.Position = UDim2.fromScale(0.02 + i * 0.196, (r + 0.94 - h) / 4)
				box.Parent = bg
			end
			local shelfLine = Instance.new("Frame")
			shelfLine.BorderSizePixel = 0
			shelfLine.BackgroundColor3 = col.Metal
			shelfLine.Size = UDim2.fromScale(1, 0.015)
			shelfLine.Position = UDim2.fromScale(0, (r + 0.94) / 4)
			shelfLine.Parent = bg
		end
	end
	for i = 0, 1 do
		api.ball("Helmet", 0.9, Vector3.new(X1 - 1.3, y1 + 3.5 + 0.45, -10.2 + i * 1.0), crateOlive, M.SmoothPlastic, false)
	end
	api.box("QMDesk", Vector3.new(2.2, 2.5, 1.0), Vector3.new(12.4, y1 + 1.25, -5.9), wood, M.Wood)
	api.box("QMDeskTop", Vector3.new(2.5, 0.2, 1.3), Vector3.new(12.4, y1 + 2.6, -5.9), woodDark, M.Wood)
	seat(12.4, y1, -7.35, 0, 1)

	------------------------------------------------------------------------------------------------
	-- Supply-run desk (front-west): terminal against the front wall → Missions, route board above it
	------------------------------------------------------------------------------------------------
	api.terminal("SupplyTerminal", Vector3.new(-6.6, y1, Z1 - 0.8), 180, "Missions", "Plan supply run", "Supply Runs", { "SUPPLY RUNS", "CONVOY OPS" })
	local board = api.box("RouteBoard", Vector3.new(4.0, 3.0, 0.1), Vector3.new(-6.6, 9.5, Z1 - 0.05), col.Dark, M.Metal, false)
	api.surfaceText(board, Enum.NormalId.Front, { "SUPPLY ROUTES", "DEPOT > FOB 1  CLEAR", "DEPOT > FOB 2  CLEAR", "CONVOY 3  EN ROUTE" }, amber, col.Dark, Enum.Font.Code)

	------------------------------------------------------------------------------------------------
	-- East wall between the cage and the console: empty pallets stacked on edge
	------------------------------------------------------------------------------------------------
	local pallets = api.box("EmptyPallets", Vector3.new(1.1, 2.3, 4.3), Vector3.new(X1 - 0.6, y1 + 1.15, 3.25), wood, M.WoodPlanks)
	stripes(pallets, Enum.NormalId.Left, 9, woodDark, wood, true)

	if lv >= 3 then
		-- pallet jack parked at the north end of rack B (out of aisle B and the cross aisle)
		api.box("PalletJack", Vector3.new(1.3, 0.25, 2.6), Vector3.new(-7.75, y1 + 0.125, 1.7), amber, M.Metal)
		api.part("PalletJackHandle", Vector3.new(0.12, 2.2, 0.12), CFrame.new(-7.75, y1 + 1.2, 3.2) * CFrame.Angles(math.rad(25), 0, 0), col.Dark, M.Metal, false)
	end

	if lv >= 4 then
		-- fuel drums on a spill pallet + stretch-wrap station (turntable and load turn on the client)
		api.box("SpillPallet", Vector3.new(2.9, 0.3, 2.9), Vector3.new(1.6, y1 + 0.15, 3.5), amber, M.Metal)
		for _, o in ipairs({ Vector3.new(-0.65, 0, -0.65), Vector3.new(0.65, 0, -0.65), Vector3.new(-0.65, 0, 0.65) }) do
			cyl("FuelDrum", 1.9, 1.25, CFrame.new(1.6 + o.X, y1 + 0.3 + 0.95, 3.5 + o.Z) * UP, fuelCol, M.Metal)
		end
		local turntable = cyl("WrapTurntable", 0.3, 3.0, CFrame.new(6.0, y1 + 0.15, 3.6) * UP, col.Metal, M.DiamondPlate, false)
		local wrapped = api.box("WrapLoad", Vector3.new(2.2, 2.4, 2.2), Vector3.new(6.0, y1 + 0.3 + 1.2, 3.6), wrapCol, M.SmoothPlastic, false)
		wrapped.Transparency = 0.25
		api.spin({ turntable, wrapped }, Vector3.new(6.0, y1, 3.6), 6)
		api.box("WrapMast", Vector3.new(0.4, 4.0, 0.4), Vector3.new(8.0, y1 + 2.0, 3.6), amber, M.Metal)
	end

	------------------------------------------------------------------------------------------------
	-- Floor markings (walk-over): loading bay outline + stencil, cross-aisle edges, hatching at the counter
	------------------------------------------------------------------------------------------------
	local function line(sx: number, sz: number, x: number, z: number)
		api.box("FloorLine", Vector3.new(sx, 0.04, sz), Vector3.new(x, y1 + 0.02, z), amber, M.SmoothPlastic, false)
	end
	line(0.3, 5.9, -3.85, 9.2)
	line(0.3, 5.9, 9.85, 9.2)
	line(14.0, 0.3, 3.0, 6.35)
	line(17.0, 0.3, 1.5, -3.35)
	line(17.0, 0.3, 1.5, 0.85)
	local bayText = api.box("FloorStencil", Vector3.new(7.0, 0.04, 1.8), Vector3.new(3.0, y1 + 0.03, 9.4), col.Floor, M.SmoothPlastic, false)
	bayText.Transparency = 1
	paint(bayText, Enum.NormalId.Top, { "LOADING BAY" }, amber)
	local hatch = api.box("CounterHatching", Vector3.new(X1 - 0.1 - cageX, 0.04, 1.6), Vector3.new((cageX + X1 - 0.1) * 0.5, y1 + 0.02, 0.05), amber, M.SmoothPlastic, false)
	stripes(hatch, Enum.NormalId.Top, 14, amber, col.Dark, false)
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">MapDressing</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — MapDressing (world visual substance)
	Fills the expanded ~4800 map between plots / ring / territories with
	military Part-kit clusters (desert outposts, adobe, tents, hangars, depots, camps…).
	Visual / immersion only — no gameplay tags that affect buy pads or capture.
	Called from MapSetup.Run after bases/territories/spawns (deferred).
	Quality Low (~60–70% fewer clusters) vs Full. Studio usually SKIPS entirely
	(DevConfig.StudioSkipWorldDressing) — ForceDress attribute to opt in.
	Regenerate: delete WarEmpireSetup + Play, or admin resetmap.
	v70 waterways (spec_final §9): nothing stands in the water (sea, ring canal, lagoons, harbour, dock channels) or on
	a plot pad; the South Docks quay is re-laid round the harbour; Waterways.CullDressing is the safety net at the end.
]]

local MapDressing = {}

-- v70: plots are 320 wide now (BaseLayoutConfig.PlotSize); plot-ring props must stay outside the base footprint
local PLOT_SIZE: number = (function(): number
	local ok, cfg = pcall(function()
		return require(game:GetService("ReplicatedStorage").Shared.Configs.BaseLayoutConfig) :: any
	end)
	return if ok and type(cfg) == "table" and type(cfg.PlotSize) == "number" then cfg.PlotSize else 320
end)()

-- v70: BaseLayoutConfig.Enabled (the 320 layout has its own in-base WarzoneSpots)
local LAYOUT_ON: boolean = (function(): boolean
	local ok, cfg = pcall(function()
		return require(game:GetService("ReplicatedStorage").Shared.Configs.BaseLayoutConfig) :: any
	end)
	return ok and type(cfg) == "table" and cfg.Enabled == true
end)()

-- v70: Modules/Waterways (water rects + dressing cull), loaded lazily so a Waterways error never blocks MapSetup
local waterwaysMod: any = nil
local function getWaterways(): any?
	if waterwaysMod == nil then
		local ok, m = pcall(function(): any
			return require(script.Parent.Waterways) :: any
		end)
		waterwaysMod = if ok and type(m) == "table" then m else false
		if not ok then
			warn("[MapDressing] Waterways unavailable:", m)
		end
	end
	return if waterwaysMod then waterwaysMod else nil
end

-- v70: true when (x, z) is within `margin` of any water or of a plot pad (spots there are skipped whole)
local function onWaterOrPlot(pos: Vector3, margin: number): boolean
	local ww = getWaterways()
	if not ww then
		return false
	end
	local ok, res = pcall(function(): boolean
		return ww.IsWaterXZ(pos.X, pos.Z, margin) or ww.IsOnPlotPadXZ(pos.X, pos.Z, margin)
	end)
	return ok and res == true
end

-- Palette aligned with StructureVisualConfig / MapSetup (Concrete / Metal / Neon)
local COL = {
	Concrete = Color3.fromRGB(85, 85, 78),
	ConcreteDark = Color3.fromRGB(60, 60, 55),
	Metal = Color3.fromRGB(58, 72, 88),
	MetalDark = Color3.fromRGB(45, 50, 55),
	Olive = Color3.fromRGB(70, 78, 55),
	OliveDark = Color3.fromRGB(50, 55, 42),
	Sand = Color3.fromRGB(150, 130, 90),
	Sandbag = Color3.fromRGB(130, 115, 80),
	Rust = Color3.fromRGB(120, 70, 45),
	Fuel = Color3.fromRGB(180, 140, 50),
	Ammo = Color3.fromRGB(88, 58, 50),
	NeonGold = Color3.fromRGB(230, 190, 60),
	NeonBlue = Color3.fromRGB(90, 160, 220),
	NeonCyan = Color3.fromRGB(70, 180, 220),
	NeonGreen = Color3.fromRGB(90, 160, 80),
	NeonOrange = Color3.fromRGB(220, 140, 60),
	NeonRed = Color3.fromRGB(200, 90, 70),
	Asphalt = Color3.fromRGB(48, 50, 46),
	Wood = Color3.fromRGB(95, 75, 50),
	Wire = Color3.fromRGB(100, 105, 95),
	Crate = Color3.fromRGB(95, 80, 55),
	Drum = Color3.fromRGB(70, 85, 55),
	DrumAccent = Color3.fromRGB(200, 90, 50),
	Vehicle = Color3.fromRGB(55, 65, 48),
	VehicleAccent = Color3.fromRGB(90, 140, 70),
	Ruin = Color3.fromRGB(95, 90, 75),
	Light = Color3.fromRGB(255, 230, 160),
	Sign = Color3.fromRGB(50, 55, 45),
	SignFace = Color3.fromRGB(200, 180, 80),
	Tent = Color3.fromRGB(195, 175, 130),
	TentDark = Color3.fromRGB(160, 140, 100),
	TentPole = Color3.fromRGB(90, 70, 45),
	Adobe = Color3.fromRGB(185, 150, 105),
	AdobeDark = Color3.fromRGB(155, 120, 80),
	AdobeWindow = Color3.fromRGB(70, 110, 130),
	WoodTower = Color3.fromRGB(110, 85, 55),
	WoodDark = Color3.fromRGB(85, 65, 42),
	FlagCloth = Color3.fromRGB(200, 70, 55),
	CampfireStone = Color3.fromRGB(110, 105, 95),
	CampfireGlow = Color3.fromRGB(255, 140, 50),
	Dock = Color3.fromRGB(50, 75, 95),
}

local function ensureFolder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function p(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else false
	part.CanQuery = if props.CanQuery ~= nil then props.CanQuery else false
	part.CanTouch = false
	part.CastShadow = if props.CastShadow ~= nil then props.CastShadow else false
	if props.Name then
		part.Name = props.Name
	end
	if props.Size then
		part.Size = props.Size
	end
	if props.CFrame then
		part.CFrame = props.CFrame
	elseif props.Position then
		part.Position = props.Position
	end
	if props.Color then
		part.Color = props.Color
	end
	if props.Material then
		part.Material = props.Material
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	part:SetAttribute("WE_Decor", true)
	part:SetAttribute("WE_MapDress", true)
	return part
end

local function at(origin: Vector3, ox: number, oy: number, oz: number): Vector3
	return origin + Vector3.new(ox, oy, oz)
end


-- ── Kit builders (modest part counts) ─────────────────────────────────────

local function kitWatchtower(folder: Folder, origin: Vector3, yawDeg: number)
	-- Wooden desert watchtower + simple flag (original Part kit)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	-- Four legs
	for _, ox in ipairs({ -2.2, 2.2 }) do
		for _, oz in ipairs({ -2.2, 2.2 }) do
			p({
				Name = "TowerLeg",
				Size = Vector3.new(0.7, 16, 0.7),
				CFrame = cf * CFrame.new(ox, 8, oz),
				Color = COL.WoodTower,
				Material = Enum.Material.Wood,
				CanCollide = true,
				CanQuery = true,
				Parent = folder,
			})
		end
	end
	-- Cross braces
	p({
		Name = "TowerBrace",
		Size = Vector3.new(5.2, 0.35, 0.35),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	p({
		Name = "TowerBrace2",
		Size = Vector3.new(0.35, 0.35, 5.2),
		CFrame = cf * CFrame.new(0, 10, 0),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	p({
		Name = "TowerCabin",
		Size = Vector3.new(6.5, 3.4, 6.5),
		CFrame = cf * CFrame.new(0, 16.5, 0),
		Color = COL.Adobe,
		Material = Enum.Material.Wood,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	p({
		Name = "TowerRoof",
		Size = Vector3.new(7.5, 0.55, 7.5),
		CFrame = cf * CFrame.new(0, 18.4, 0),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	p({
		Name = "TowerWindow",
		Size = Vector3.new(1.4, 1.1, 0.25),
		CFrame = cf * CFrame.new(0, 16.6, -3.3),
		Color = COL.AdobeWindow,
		Material = Enum.Material.Glass,
		Parent = folder,
	})
	-- Flag pole + cloth
	p({
		Name = "FlagPole",
		Size = Vector3.new(0.25, 7, 0.25),
		CFrame = cf * CFrame.new(2.8, 22, 2.8),
		Color = COL.MetalDark,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	p({
		Name = "FlagCloth",
		Size = Vector3.new(2.8, 1.6, 0.12),
		CFrame = cf * CFrame.new(4.2, 24.2, 2.8),
		Color = COL.FlagCloth,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	p({
		Name = "TowerAccent",
		Size = Vector3.new(6.7, 0.22, 6.7),
		CFrame = cf * CFrame.new(0, 14.9, 0),
		Color = COL.NeonGold,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
end

local function kitBunker(folder: Folder, origin: Vector3, yawDeg: number)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	p({
		Name = "BunkerBody",
