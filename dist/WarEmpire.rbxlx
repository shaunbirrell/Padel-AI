          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">ConsoleLocator</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v71 console-only buying: which part is a structure's console on a plot, and is a player standing at it?

	One answer for server and client:
	  server  BaseService.PurchaseUpgrade (the gate), UpgradePadService (plot-ready position stamps), StudioBuySmoke
	  client  ConsoleWaypoint (Base panel GO)

	A buy point is a BasePart in Workspace tagged Constants.Tags.UpgradeSlot with attributes PlotId (number) and
	StructureId (string). WE_Console = true marks a console / kiosk (BaseLayoutConfig on). A console always wins over
	a legacy pad or a stray part the v63 StructureId sweeps tagged. Positions are the part's own world position, so
	rotated plots (BaseLayout.PlotCFrame, FaceMapCentre) need nothing here. Never yields, never WaitForChild.

	"At" = a cylinder around the part centre: horizontal (XZ) distance <= MaxDistance(part) and
	|dy| <= ConsoleBuyConfig.MaxVerticalOffset (same shape as MissileStrikeService's atCommandCenter).
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)

local ConsoleLocator = {}

-- Reasons (logs / tests only; the player-facing error is always "NotAtConsole")
export type Reason = "Ok" | "NoCharacter" | "Dead" | "Seated" | "NoConsole" | "WrongPart" | "TooFar" | "WrongFloor" | "OtherNearer"

local function plotIdOf(part: Instance): number?
	return tonumber(part:GetAttribute("PlotId") :: any)
end

local function flat(v: Vector3): number
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

function ConsoleLocator.IsConsole(part: BasePart): boolean
	return part:GetAttribute("WE_Console") == true
end

-- True when `part` is a live buy point for (plotId, structureId).
function ConsoleLocator.IsBuyPointFor(part: Instance?, plotId: number, structureId: string): boolean
	if part == nil or not part:IsA("BasePart") or not part:IsDescendantOf(Workspace) then
		return false
	end
	if not CollectionService:HasTag(part, Constants.Tags.UpgradeSlot) then
		return false
	end
	return part:GetAttribute("StructureId") == structureId and plotIdOf(part) == plotId
end

-- The structure's console on that plot; a legacy pad only when the plot has no console for it; nil when none.
function ConsoleLocator.Find(plotId: number, structureId: string): BasePart?
	local fallback: BasePart? = nil
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("StructureId") == structureId and plotIdOf(inst) == plotId
			and inst:IsDescendantOf(Workspace) then
			local part = inst :: BasePart
			if ConsoleLocator.IsConsole(part) then
				return part
			end
			if fallback == nil then
				fallback = part
			end
		end
	end
	return fallback
end

-- Allowed HORIZONTAL HRP -> part-centre distance. slack defaults to ConsoleBuyConfig.ServerSlack (the client passes 0).
function ConsoleLocator.MaxDistance(part: BasePart, slack: number?): number
	local base = if ConsoleLocator.IsConsole(part)
		then ConsoleBuyConfig.ConsolePromptDistance
		else ConsoleBuyConfig.PadPromptDistance
	return base + (if slack ~= nil then slack else ConsoleBuyConfig.ServerSlack)
end

-- Where a character stands to use `part`: 3 studs in front of its face (consoles face into the room / the plot
-- centre), HRP height. StudioBuySmoke teleports here; tests use it.
function ConsoleLocator.StandCFrame(part: BasePart): CFrame
	return part.CFrame * CFrame.new(0, 1.3, -3)
end

--[[ Is `player` at the console of `structureId` on plot `plotId` (the caller passes the player's OWN plot)?
	atPart: the part whose prompt fired (UpgradePadService); it must itself be a buy point for (plotId, structureId).
	Returns (ok, reason, horizontalDistance?). Reads only the server's (or local client's) view of the character;
	nothing the client sends in a remote payload. ]]
function ConsoleLocator.Check(player: Player, plotId: number, structureId: string, atPart: BasePart?, slack: number?): (boolean, Reason, number?)
	local character = player.Character
	if character == nil then
		return false, "NoCharacter", nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local rootInst = (hum and hum.RootPart) or character:FindFirstChild("HumanoidRootPart")
	if rootInst == nil or not rootInst:IsA("BasePart") then
		return false, "NoCharacter", nil
	end
	local hrp = rootInst :: BasePart
	if not hum or hum.Health <= 0 then
		return false, "Dead", nil
	end
	if ConsoleBuyConfig.RejectSeated and hum.SeatPart ~= nil then
		return false, "Seated", nil
	end
	local target: BasePart? = nil
	if atPart ~= nil then
		if not ConsoleLocator.IsBuyPointFor(atPart, plotId, structureId) then
			return false, "WrongPart", nil
		end
		target = atPart
	else
		target = ConsoleLocator.Find(plotId, structureId)
	end
	if target == nil then
		return false, "NoConsole", nil
	end
	local offset = hrp.Position - target.Position
	local d = flat(offset)
	if d > ConsoleLocator.MaxDistance(target, slack) then
		return false, "TooFar", d
	end
	if math.abs(offset.Y) > ConsoleBuyConfig.MaxVerticalOffset then
		return false, "WrongFloor", d -- e.g. the upper floor of a two-storey walk-in, above a ground-floor console
	end
	-- Two consoles in range (close kiosks, e.g. the planned rebirth-zone silo / drone kiosks 21.5 apart): only the
	-- nearest one buys, the same rule as Roblox prompt exclusivity (OnePerButton shows one prompt per key).
	if ConsoleBuyConfig.RequireNearest then
		local margin = ConsoleBuyConfig.NearestMargin
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
			if inst ~= target and inst:IsA("BasePart") and plotIdOf(inst) == plotId
				and inst:GetAttribute("StructureId") ~= structureId
				and ConsoleLocator.IsConsole(inst) == ConsoleLocator.IsConsole(target)
				and inst:IsDescendantOf(Workspace) then
				if flat((inst :: BasePart).Position - hrp.Position) + margin < d then
					return false, "OtherNearer", d
				end
			end
		end
	end
	return true, "Ok", d
end

return ConsoleLocator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">NationTexture</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NationTexture: pure maths for showing a nation's flag (nations spec, lane A0). Configs only: no services, no
	Instances, never yields, no allocation beyond the returned tables. Headless-tested.

	One source for
	  picker (client)  ImageLabel.Image = Source(id).Image, ImageRectOffset = (Rect.X, Rect.Y), ImageRectSize = (Rect.W, Rect.H)
	  world (server)   one Texture per flag face: Texture = Source(id).Image, then TextureProps(faceW, faceH, Rect)

	Atlas layout (NationConfig.Atlas, drawn by tools/gen_nation_flags.py): 1024 x 512, 9 x 6 cells of 112 x 84, each
	flag 104 x 78 centred in its cell (edge-extended gutter 4 px left/right, 3 px top/bottom).

	Texture crop: a Texture tiles its whole image every StudsPerTileU x StudsPerTileV studs. Scaling the image so the
	flag's W x H pixels span the face exactly, then offsetting by the flag's pixel position, shows only that flag:
	  su = faceW / W, sv = faceH / H (studs per pixel)
	  StudsPerTileU = SheetW * su, StudsPerTileV = SheetH * sv
	  OffsetStudsU  = OffsetSignU * X * su, OffsetStudsV = OffsetSignV * Y' * sv (wrapped into [0, tile))
	  Y' = Y, or SheetH - Y - H when NationConfig.Atlas.VFromBottom
	The default signs assume "a larger offset shows image content further right / lower" (the face's top-left shows
	image pixel (X, Y)). The Studio atlas-crop test confirms or flips them in NationConfig.Atlas; nothing here changes.
	The back face is not mirrored: from behind, the hoist appears at the fly end (accepted, spec section 6).
]]

local Configs = script.Parent.Parent.Configs -- ReplicatedStorage.Shared is replicated before any script runs
local NationConfig = require(Configs.NationConfig)
local NationFlagIds = require(Configs.NationFlagIds)

local A = NationConfig.Atlas

export type Rect = {
	Atlas: string, -- AtlasGroup, or "" for a per-flag image
	X: number, -- flag's top-left pixel in the image
	Y: number,
	W: number, -- flag size in pixels
	H: number,
	SheetW: number, -- whole image size in pixels
	SheetH: number,
}

export type TextureProps = {
	StudsPerTileU: number,
	StudsPerTileV: number,
	OffsetStudsU: number,
	OffsetStudsV: number,
}

export type Source = {
	Image: string, -- "rbxassetid://<id>"
	Rect: Rect,
	PerFlag: boolean, -- true: NationFlagIds.Flags[id] (whole image), false: an atlas cell
}

local NationTexture = {}

local function validId(v: any): boolean
	return typeof(v) == "number" and v > 0 and v % 1 == 0 and v < 2 ^ 53
end

local function finitePositive(v: any): boolean
	return typeof(v) == "number" and v == v and v > 0 and v < math.huge
end

-- Atlas cell of a nation: (atlasKey, px, py, w, h) of the flag's pixels (gutter excluded), or nil, 0, 0, 0, 0 for
-- NEUTRAL, unknown, denied or OwnerReview-off ids.
function NationTexture.CellRect(id: any): (string?, number, number, number, number)
	local n = NationConfig.Get(id)
	if not n then
		return nil, 0, 0, 0, 0
	end
	local cell = n.AtlasCell
	if typeof(cell) ~= "number" or cell % 1 ~= 0 or cell < 0 or cell >= A.Columns * A.Rows then
		return nil, 0, 0, 0, 0
	end
	local col = cell % A.Columns
	local row = math.floor(cell / A.Columns)
	local gutterX = math.floor((A.CellW - A.FlagW) / 2)
	local gutterY = math.floor((A.CellH - A.FlagH) / 2)
	return n.AtlasGroup, col * A.CellW + gutterX, row * A.CellH + gutterY, A.FlagW, A.FlagH
end

-- CellRect as a Rect (with the atlas size), or nil.
function NationTexture.Rect(id: any): Rect?
	local key, x, y, w, h = NationTexture.CellRect(id)
	if key == nil then
		return nil
	end
	return { Atlas = key, X = x, Y = y, W = w, H = h, SheetW = A.Width, SheetH = A.Height }
end

-- The whole-image rect of a per-flag PNG (gen_nation_flags.py --per-flag).
function NationTexture.PerFlagRect(): Rect
	return { Atlas = "", X = 0, Y = 0, W = A.PerFlagW, H = A.PerFlagH, SheetW = A.PerFlagW, SheetH = A.PerFlagH }
end

-- Image + rect to show for a nation, or nil when no art is wired for it (caller shows the banner colour).
-- A per-flag id (NationFlagIds.Flags) wins over the atlas.
function NationTexture.Source(id: any): Source?
	local n = NationConfig.Get(id)
	if not n then
		return nil
	end
	local own = NationFlagIds.Flags[n.Id]
	if validId(own) then
		return { Image = string.format("rbxassetid://%d", own), Rect = NationTexture.PerFlagRect(), PerFlag = true }
	end
	local rect = NationTexture.Rect(n.Id)
	if rect == nil then
		return nil
	end
	local atlasId = NationFlagIds.Atlas[rect.Atlas]
	if not validId(atlasId) then
		return nil
	end
	return { Image = string.format("rbxassetid://%d", atlasId), Rect = rect, PerFlag = false }
end

-- True when every nation the picker may show has art (NationConfig.LiveRequiresArt).
function NationTexture.ArtReady(): boolean
	for _, n in ipairs(NationConfig.Nations) do
		if NationConfig.Get(n.Id) and NationTexture.Source(n.Id) == nil then
			return false
		end
	end
	return true
end

-- Texture properties that show exactly `rect` on a faceW x faceH face (studs), or nil for bad input.
function NationTexture.TextureProps(faceW: number, faceH: number, rect: Rect): TextureProps?
	if not (finitePositive(faceW) and finitePositive(faceH)) then
		return nil
	end
	if not (finitePositive(rect.W) and finitePositive(rect.H) and finitePositive(rect.SheetW) and finitePositive(rect.SheetH)) then
		return nil
	end
	if rect.X < 0 or rect.Y < 0 or rect.X + rect.W > rect.SheetW or rect.Y + rect.H > rect.SheetH then
		return nil
	end
	local su = faceW / rect.W
	local sv = faceH / rect.H
	local tileU = rect.SheetW * su
	local tileV = rect.SheetH * sv
	local y = if A.VFromBottom then rect.SheetH - rect.Y - rect.H else rect.Y
	local offU = (A.OffsetSignU * rect.X * su) % tileU
	local offV = (A.OffsetSignV * y * sv) % tileV
	return { StudsPerTileU = tileU, StudsPerTileV = tileV, OffsetStudsU = offU, OffsetStudsV = offV }
end

-- The two faces of a part's thinnest axis and their (width, height) in studs, as Enum.NormalId names:
-- Z thinnest -> Front/Back (W = X, H = Y); X thinnest -> Left/Right (W = Z, H = Y); Y thinnest -> Top/Bottom (W = X, H = Z).
function NationTexture.ThinFaces(sx: number, sy: number, sz: number): (string, string, number, number)
	if sz <= sx and sz <= sy then
		return "Front", "Back", sx, sy
	elseif sx <= sy then
		return "Left", "Right", sz, sy
	end
	return "Top", "Bottom", sx, sz
end

return NationTexture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">PlotFrame</string>
            <string name="Source"><![CDATA[--!strict
--[[
	F10 (owner's 11 features, lane K1): plot frame helpers shared by the server and the client.
	PlotYaw / PlotCFrame are moved verbatim from the server Modules/BaseLayout (v70 lines 52-80); BaseLayout delegates
	to this module (lane W). Configs may require this (TerritoryConfig does, for the Home Outposts), so it requires only
	configs that never require TerritoryConfig back: BaseLayoutConfig and BaseConfig.

	Yaw convention (matches CFrame.Angles(0, yaw, 0)): a building's local +Z (its FRONT) maps to world
	(sin yaw, 0, cos yaw). Yaw 0 = faces +Z (plot front / main gate), 90 = +X, -90 = -X, 180 = -Z.
	With BaseLayoutConfig.FaceMapCentre the plot FRONT faces the map centre (yaw snapped to 90), otherwise yaw 0.

	Pure math: no instances, no yields, safe under StreamingEnabled (never looks at the workspace).
]]

local Configs = script.Parent.Parent.Configs -- ReplicatedStorage.Shared is replicated before any script runs
local BaseLayoutConfig = require(Configs.BaseLayoutConfig)
local BaseConfig = require(Configs.BaseConfig)

local PlotFrame = {}

-- v70: true when plots are turned to face the map centre (waterways layout)
function PlotFrame.FacesMapCentre(): boolean
	return BaseLayoutConfig.Enabled == true and (BaseLayoutConfig :: any).FaceMapCentre == true
end

-- v70: plot yaw in degrees (0 / 90 / -90 / 180). Front (main gate) toward the map centre.
function PlotFrame.PlotYaw(plotPos: Vector3): number
	if not PlotFrame.FacesMapCentre() then
		return 0
	end
	local x, z = plotPos.X, plotPos.Z
	if math.abs(x) < 1 and math.abs(z) < 1 then
		return 0
	end
	if math.abs(x) >= math.abs(z) then
		return if x < 0 then 90 else -90
	end
	return if z < 0 then 0 else 180
end

-- Exact quarter-turn rotation (no 6e-17 noise from cos(pi/2)), same matrix as CFrame.Angles(0, rad(yaw), 0).
local function yawRotation(yaw: number): CFrame
	local c = if yaw == 0 then 1 elseif yaw == 180 or yaw == -180 then -1 else 0
	local s = if yaw == 90 then 1 elseif yaw == -90 then -1 else 0
	if c == 0 and s == 0 then
		return CFrame.Angles(0, math.rad(yaw), 0)
	end
	return CFrame.new(0, 0, 0, c, 0, s, 0, 1, 0, -s, 0, c)
end

-- v70: plot frame at the plot position (pad centre height). World = PlotCFrame(plotPos) * plot-local.
function PlotFrame.PlotCFrame(plotPos: Vector3): CFrame
	return CFrame.new(plotPos) * yawRotation(PlotFrame.PlotYaw(plotPos))
end

-- Plot position for a plot id (1..BaseConfig.MaxPlots); nil for an unknown id.
function PlotFrame.PlotPosition(plotId: number): Vector3?
	local list: { any } = BaseConfig.PlotPositions
	local pos = list[plotId]
	if typeof(pos) ~= "Vector3" then
		return nil
	end
	return pos
end

-- F10: plot-local (lx, lz) of plot plotId -> world point at the plot pad centre height (plotPos.Y), turned by the plot
-- yaw. An unknown plot id returns the un-turned offset from the origin (never errors at require time).
function PlotFrame.LocalToWorld(plotId: number, lx: number, lz: number): Vector3
	local pos = PlotFrame.PlotPosition(plotId)
	if pos == nil then
		return Vector3.new(lx, 0, lz)
	end
	return PlotFrame.PlotCFrame(pos):PointToWorldSpace(Vector3.new(lx, 0, lz))
end

return PlotFrame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">TycoonMath</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v72 pure tycoon math (configs only: no services, no Instances, never yields). ONE source for
	  server  BaseService.ComputePassiveIncomePerTick (what is PAID), the WE_NextBuy pick (BusinessService)
	  client  BUY button / console tag / Base panel / guide chip / cash pill (what is SHOWN)
	so the "+$3.3/s" a player reads is the number the server pays (x the server-stamped WE_IncomeMult), floored.

	Income is the TOTAL base $ per passive tick at a level (EconomyConfig.PassiveIncome.TickSeconds = 5):
	  building  PerLevelRates[id] * level (unchanged from before v72)
	  business  BusinessConfig IncomePerTick[level] (only while BusinessConfig.Enabled)
	Plot oil pumps: DefensiveWalls reaching PlotOilPumpConfig.MinWallsLevel adds the plot pumps (paid by
	PlotOilPumpService, exempt from multipliers); StepGainPerTick adds them unscaled so Walls L2 shows its real gain.

	Display rules (spec v72 section 3): RateText floors (one decimal below 10, whole numbers from 10 up, ".0" dropped),
	ShortCash gives "$600", "$1,240", "$25K", "$1.9M", and every string comes from TycoonGuideConfig.Text.

	F5 (owner's 11 features, lane K2): PickCheapest (the one pointer while TycoonGuideConfig.PickMode = "Cheapest"),
	ApproachPoint / Footprints (plot-local geometry for the client floor chevrons, from the layout configs only: no
	workspace, safe under StreamingEnabled) and GuideTarget (tutorial step first, then the pick).
]]

local Configs = script.Parent.Parent.Configs -- ReplicatedStorage.Shared is replicated before any script runs
local BaseConfig = require(Configs.BaseConfig)
local EconomyConfig = require(Configs.EconomyConfig)
local BusinessConfig = require(Configs.BusinessConfig)
local PlotOilPumpConfig = require(Configs.PlotOilPumpConfig)
local SoldierConfig = require(Configs.SoldierConfig)
local TycoonGuideConfig = require(Configs.TycoonGuideConfig)
local RebirthConfig = require(Configs.RebirthConfig)
local BaseLayoutConfig = require(Configs.BaseLayoutConfig)
local StructureVisualConfig = require(Configs.StructureVisualConfig)

local TycoonMath = {}

export type Requirement = { StructureId: string, Level: number }

export type Candidate = {
	Id: string, -- structure / business id, or TycoonGuideConfig.SoldierCandidateId
	Level: number, -- target level (0 for soldiers)
	Cost: number,
	GainPerTick: number, -- base $ per tick this buy adds (pre-multiplier; Walls L2 includes the unscaled oil)
	Unlock: string?, -- UnlockText for that level
}

export type PickContext = {
	Upgrades: { [string]: any }?, -- profile.BaseUpgrades
	Cash: number, -- wallet
	Pending: number, -- ATM (PendingCash)
	IncomePerSec: number, -- what the ATM receives now (WE_IncomePerSec)
	Soldiers: number?, -- nil = soldiers are not offered
	SoldierCap: number?,
	Current: string?, -- current WE_NextBuy (sticky)
	Prestige: number?, -- F5: rebirth zones (RebirthConfig.IsStructureOpen); nil = 0
}

-- F5: a plot-local axis-aligned rectangle (studs) around one structure / business site
export type Footprint = { Id: string, MinX: number, MaxX: number, MinZ: number, MaxZ: number }

-- F5: the active tutorial step as GuideTarget needs it (a TutorialConfig step def fits)
export type GuideStep = { PadStructureId: string?, Pointer: string? }

export type MoneyState = "Buy" | "Collect" | "Earn"

-- NaN / inf / non-numbers -> 0
local function num(v: any): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return n
end

-- float guard for the floor rules (8.4 stored as 8.3999999 must still read 8.4)
local EPS = 1e-6

function TycoonMath.TickSeconds(): number
	return EconomyConfig.PassiveIncome.TickSeconds
end

-- true only while BusinessConfig.Enabled and `id` is a business
function TycoonMath.IsBusiness(id: string): boolean
	return BusinessConfig.IsBusiness(id)
end

function TycoonMath.MaxLevel(id: string): number
	local def = BaseConfig.Structures[id]
	return if def then def.MaxLevel else 0
end

-- Saved level, whole and clamped to 0..MaxLevel (DataStore junk never throws or overpays; unknown id -> 0).
function TycoonMath.Level(upgrades: { [string]: any }?, id: string): number
	if upgrades == nil then
		return 0
	end
	return math.clamp(math.floor(num(upgrades[id])), 0, TycoonMath.MaxLevel(id))
end

-- TOTAL base $ per tick that `id` pays at `level` (pre-multiplier). Buildings: rate x level. Businesses: table.
function TycoonMath.LevelIncomePerTick(id: string, level: number): number
	local lvl = math.floor(num(level))
	if lvl <= 0 then
		return 0
	end
	local biz = BusinessConfig.Get(id)
	if biz then
		if not BusinessConfig.Enabled then
			return 0
		end
		return biz.IncomePerTick[math.clamp(lvl, 1, #biz.IncomePerTick)]
	end
	local rate = EconomyConfig.PassiveIncome.PerLevelRates[id]
	return if rate then rate * lvl else 0
end

-- The passive tick before multipliers: BaseCashPerTick + every owned level of every known structure.
-- For buildings this equals the pre-v72 BaseService formula (rate x level for each saved level > 0).
function TycoonMath.BasePassivePerTick(upgrades: { [string]: any }?): number
	local total = EconomyConfig.PassiveIncome.BaseCashPerTick
	if upgrades == nil then
		return total
	end
	for id in pairs(upgrades) do
		if typeof(id) == "string" and BaseConfig.Structures[id] ~= nil then
			total += TycoonMath.LevelIncomePerTick(id, TycoonMath.Level(upgrades, id))
		end
	end
	return total
end

-- Plot oil pumps' $ per tick once DefensiveWalls reaches MinWallsLevel (unscaled: PlotOilPumpService pays it exempt)
function TycoonMath.OilPerTick(): number
	if not PlotOilPumpConfig.Enabled then
		return 0
	end
	return (PlotOilPumpConfig.PumpsPerPlot or 2) * (PlotOilPumpConfig.CashPerTick or 18)
end

local function oilOwnedPerTick(upgrades: { [string]: any }?): number
	if TycoonMath.Level(upgrades, "DefensiveWalls") >= (PlotOilPumpConfig.MinWallsLevel or 2) then
		return TycoonMath.OilPerTick()
	end
	return 0
end

-- $ per tick gained by buying `fromLevel + 1`. `mult` scales structure / business income only (oil is exempt), so
-- pass WE_IncomeMult here and NOT again to PerSecText (StepPerSecText does both).
function TycoonMath.StepGainPerTick(id: string, fromLevel: number, mult: number?): number
	local from = math.floor(num(fromLevel))
	local m = if mult == nil then 1 else num(mult)
	local gain = (TycoonMath.LevelIncomePerTick(id, from + 1) - TycoonMath.LevelIncomePerTick(id, from)) * m
	if id == "DefensiveWalls" and from + 1 == (PlotOilPumpConfig.MinWallsLevel or 2) then
		gain += TycoonMath.OilPerTick()
	end
	return gain
end

-- Price of level `level + 1`, or nil at max level / unknown id
function TycoonMath.NextCost(id: string, level: number): number?
	local def = BaseConfig.Structures[id]
	local lvl = math.floor(num(level))
	if not def or lvl >= def.MaxLevel then
		return nil
	end
	return def.Costs[math.max(lvl, 0) + 1]
end

-- (ok, first unmet requirement). Unknown id -> (false, nil).
function TycoonMath.MeetsRequirements(id: string, upgrades: { [string]: any }?): (boolean, Requirement?)
	local def = BaseConfig.Structures[id]
	if not def then
		return false, nil
	end
	for _, req in ipairs(def.Requires or {}) do
		if TycoonMath.Level(upgrades, req.StructureId) < req.Level then
			return false, req
		end
	end
	return true, nil
end

-- "6 new buildings" for CommandCenter L1, etc. (business-only lines while BusinessConfig.Enabled)
function TycoonMath.UnlockText(id: string, level: number): string?
	local t = TycoonGuideConfig.Unlocks[id]
	local s = if t then t[level] else nil
	if s == nil and BusinessConfig.Enabled then
		local b = TycoonGuideConfig.BusinessUnlocks[id]
		s = if b then b[level] else nil
	end
	return s
end

function TycoonMath.DisplayName(id: string): string
	local def = BaseConfig.Structures[id]
	if def then
		return def.DisplayName
	end
	local biz = BusinessConfig.Get(id)
	return if biz then biz.DisplayName else id
end

-- <= 10 upper-case characters: business ShortName, TycoonGuideConfig.ShortNames, else the upper-case DisplayName
function TycoonMath.ShortName(id: string): string
	local biz = BusinessConfig.Get(id)
	if biz then
		return biz.ShortName
	end
	return TycoonGuideConfig.ShortNames[id] or string.upper(TycoonMath.DisplayName(id))
end

function TycoonMath.SoldierGainPerTick(): number
	return num(SoldierConfig.TrainingIncome.CashPerSoldierPerTick)
end

-- Training income's share of the total base income per tick (passive + training + oil), 0..1, pre-multiplier.
function TycoonMath.TrainingShare(upgrades: { [string]: any }?, soldiers: number): number
	local n = math.max(0, math.floor(num(soldiers)))
	local training = if n >= (SoldierConfig.TrainingIncome.MinSoldiersForIncome or 1) then n * TycoonMath.SoldierGainPerTick() else 0
	local total = TycoonMath.BasePassivePerTick(upgrades) + oilOwnedPerTick(upgrades) + training
	return if total > 0 then training / total else 0
end

-- Every console buy that is open now (requirements met, below max), plus soldiers when configured and while the
-- training share is below SoldierMaxShare.
function TycoonMath.Candidates(ctx: PickContext): { Candidate }
	local out: { Candidate } = {}
	for _, id in ipairs(BaseConfig.StructureOrder) do
		local lv = TycoonMath.Level(ctx.Upgrades, id)
		local cost = TycoonMath.NextCost(id, lv)
		if cost ~= nil and (TycoonMath.MeetsRequirements(id, ctx.Upgrades)) then
			table.insert(out, {
				Id = id,
				Level = lv + 1,
				Cost = cost,
				GainPerTick = TycoonMath.StepGainPerTick(id, lv),
				Unlock = TycoonMath.UnlockText(id, lv + 1),
			})
		end
	end
	local soldiers, cap = ctx.Soldiers, ctx.SoldierCap
	if TycoonGuideConfig.IncludeSoldiers and soldiers ~= nil and cap ~= nil and num(soldiers) < num(cap) then
		local gain = TycoonMath.SoldierGainPerTick()
		if gain > 0 and TycoonMath.TrainingShare(ctx.Upgrades, soldiers) < TycoonGuideConfig.SoldierMaxShare then
			table.insert(out, {
				Id = TycoonGuideConfig.SoldierCandidateId,
				Level = 0,
				Cost = num(SoldierConfig.RecruitCostCash),
				GainPerTick = gain,
				Unlock = nil,
			})
		end
	end
	return out
end

-- Lower is better: WaitWeight x seconds until affordable (wallet + ATM) + payback seconds (unlock value counted).
function TycoonMath.Score(c: Candidate, ctx: PickContext): number
	local unlock = TycoonGuideConfig.UnlockValuePerTick[c.Id]
	local value = c.GainPerTick + (if unlock then (unlock[c.Level] or 0) else 0)
	local perSec = value / TycoonMath.TickSeconds()
	local payback = c.Cost / math.max(perSec, 0.01)
	local have = math.max(0, num(ctx.Cash)) + math.max(0, num(ctx.Pending))
	local wait = math.max(0, c.Cost - have) / math.max(num(ctx.IncomePerSec), 0.1)
	return TycoonGuideConfig.WaitWeight * wait + payback
end

-- "Id:Level" | "Soldier:0" | "" (nil)
function TycoonMath.Encode(c: Candidate?): string
	if c == nil then
		return ""
	end
	return c.Id .. ":" .. tostring(c.Level)
end

-- (id, level) from a WE_NextBuy value; (nil, 0) for "" or junk
function TycoonMath.Decode(s: any): (string?, number)
	if typeof(s) ~= "string" or s == "" then
		return nil, 0
	end
	local id, lv = string.match(s, "^([%w_]+):(%d+)$")
	if id == nil then
		return nil, 0
	end
	return id, tonumber(lv) or 0
end

--[[ F5: the cheapest unpaid console pad. Candidates are BaseConfig.StructureOrder (the businesses are appended there
	while BusinessConfig.Enabled): Cash structures below MaxLevel whose requirements are met and whose rebirth zone is
	open (RebirthConfig.IsStructureOpen at `prestige`, nil = 0). The lowest next price wins; ties go to the lower
	target level, then the earlier StructureOrder entry. Never soldiers or Robux items; affordability is not a filter.
	nil when nothing is left. ]]
function TycoonMath.PickCheapest(upgrades: { [string]: any }?, prestige: number?): Candidate?
	local p = math.max(0, math.floor(num(prestige)))
	local best: Candidate? = nil
	for _, id in ipairs(BaseConfig.StructureOrder) do
		local def = BaseConfig.Structures[id]
		local lv = TycoonMath.Level(upgrades, id)
		local cost = TycoonMath.NextCost(id, lv)
		if def ~= nil and def.Currency == "Cash" and cost ~= nil and (TycoonMath.MeetsRequirements(id, upgrades))
			and RebirthConfig.IsStructureOpen(p, nil, id) then
			local cur = best
			if cur == nil or cost < cur.Cost or (cost == cur.Cost and lv + 1 < cur.Level) then
				best = {
					Id = id,
					Level = lv + 1,
					Cost = cost,
					GainPerTick = TycoonMath.StepGainPerTick(id, lv),
					Unlock = TycoonMath.UnlockText(id, lv + 1),
				}
			end
		end
	end
	return best
end

--[[ The one next buy. PickMode "Cheapest" (F5): PickCheapest (no soldiers, no stickiness). PickMode "Score" (v72):
	the first Opening entry that is a candidate now, else the best Score. Sticky: while ctx.Current is still a
	candidate, a challenger must score below Hysteresis x the current score. Deterministic (ties -> cheaper, then
	StructureOrder). nil when nothing is left. Callers check TycoonGuideConfig.Enabled. ]]
function TycoonMath.PickNext(ctx: PickContext): Candidate?
	if TycoonGuideConfig.PickMode == "Cheapest" then
		return TycoonMath.PickCheapest(ctx.Upgrades, ctx.Prestige)
	end
	local cands = TycoonMath.Candidates(ctx)
	if #cands == 0 then
		return nil
	end
	local byKey: { [string]: Candidate } = {}
	for _, c in ipairs(cands) do
		byKey[TycoonMath.Encode(c)] = c
	end
	for _, key in ipairs(TycoonGuideConfig.Opening) do
		local c = byKey[key]
		if c then
			return c
		end
	end
	local best: Candidate? = nil
	local bestScore = math.huge
	for _, c in ipairs(cands) do
		local s = TycoonMath.Score(c, ctx)
		if s < bestScore or (s == bestScore and best ~= nil and c.Cost < best.Cost) then
			best, bestScore = c, s
		end
	end
	local cur = if ctx.Current then byKey[ctx.Current] else nil
	if cur and best and cur ~= best then
		if bestScore >= TycoonGuideConfig.Hysteresis * TycoonMath.Score(cur, ctx) then
			return cur
		end
	end
	return best
end

---------------------------------------------------------------------------------------------------------------
-- F5 guide geometry (plot-local studs: +Z = the plot front, same frame as BaseLayoutConfig; to world with
-- Shared/Util/PlotFrame.LocalToWorld). Configs only: never reads the workspace.
---------------------------------------------------------------------------------------------------------------

TycoonMath.ATM_TARGET = "ATM" -- GuideTarget / ApproachPoint id of the player's own ATM (TutorialConfig Pointer)

-- building-local (x, z) turned by a site Yaw (degrees; BaseLayout.Rotate / CFrame.Angles(0, yaw, 0) convention)
local function turn(x: number, z: number, yawDeg: number): (number, number)
	local a = math.rad(yawDeg)
	return x * math.cos(a) + z * math.sin(a), -x * math.sin(a) + z * math.cos(a)
end

-- building-local width (X) x depth (Z) of a site's footprint, or nil (walk-in shell, outdoor installation, business
-- line slab, else the palette's target footprint)
local function footprintSize(id: string): (number?, number?)
	local hb: any = (StructureVisualConfig :: any).HollowBuildings
	local c: any = if typeof(hb) == "table" then hb[id] else nil
	if typeof(c) == "table" and tonumber(c.Width) and tonumber(c.Depth) then
		return tonumber(c.Width), tonumber(c.Depth)
	end
	local inst: any = (StructureVisualConfig :: any).Installations
	c = if typeof(inst) == "table" then inst[id] else nil
	if typeof(c) == "table" and tonumber(c.Width) and tonumber(c.Depth) then
		return tonumber(c.Width), tonumber(c.Depth)
	end
	if BusinessConfig.Businesses[id] ~= nil then
		for _, kp in ipairs(BusinessConfig.Kit) do
			if kp.Role == "Slab" then
				return kp.Size.X, kp.Size.Z
			end
		end
	end
	local pal = StructureVisualConfig.Palettes[id]
	if pal and pal.TargetFootprint then
		return pal.TargetFootprint.X, pal.TargetFootprint.Z
	end
	return nil, nil
end

local footprintCache: { Footprint }? = nil

--[[ One plot-local rectangle per structure site (BaseLayoutConfig.Structures; business sites only while
	BusinessConfig.Enabled), the axis-aligned box around the turned footprint. Built once (configs are static); the
	returned list is shared: read it, never change it. Empty while BaseLayoutConfig is off. ]]
function TycoonMath.Footprints(): { Footprint }
	local cached = footprintCache
	if cached ~= nil then
		return cached
	end
	local out: { Footprint } = {}
	if BaseLayoutConfig.Enabled then
		local ids: { string } = {}
		for id in pairs(BaseLayoutConfig.Structures) do
			if BusinessConfig.Businesses[id] == nil or BusinessConfig.Enabled then
				table.insert(ids, id)
			end
		end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local s = BaseLayoutConfig.Structures[id]
			local w, d = footprintSize(id)
			if w ~= nil and d ~= nil then
				local a = math.rad(s.Yaw or 0)
				local hx = 0.5 * (math.abs(w * math.cos(a)) + math.abs(d * math.sin(a)))
				local hz = 0.5 * (math.abs(w * math.sin(a)) + math.abs(d * math.cos(a)))
				table.insert(out, {
					Id = id,
					MinX = s.Site.X - hx,
					MaxX = s.Site.X + hx,
					MinZ = s.Site.Z - hz,
					MaxZ = s.Site.Z + hz,
				})
			end
		end
	end
	footprintCache = out
	return out
end

-- The Id of the first footprint containing plot-local (x, z), grown by `margin` studs (default 0), else nil
function TycoonMath.InFootprint(x: number, z: number, margin: number?): string?
	local m = num(margin)
	for _, f in ipairs(TycoonMath.Footprints()) do
		if x >= f.MinX - m and x <= f.MaxX + m and z >= f.MinZ - m and z <= f.MaxZ + m then
			return f.Id
		end
	end
	return nil
end

--[[ Where a player walks to buy `id` (plot-local, Y = 0 = the plot pad centre height):
	  walk-in building  DoorLeadStuds out of its front door (StructureVisualConfig.HollowBuildings DoorX / Depth)
	  kiosk / business  the kiosk (BaseLayoutConfig Kiosk)
	  "ATM"             the ATM (BaseLayoutConfig.Courtyard.Collector)
	nil for an unknown id or while BaseLayoutConfig is off. ]]
function TycoonMath.ApproachPoint(id: string): Vector3?
	if not BaseLayoutConfig.Enabled then
		return nil
	end
	if id == TycoonMath.ATM_TARGET then
		local c = BaseLayoutConfig.Courtyard.Collector
		return Vector3.new(c.X, 0, c.Z)
	end
	local s = BaseLayoutConfig.Structures[id]
	if s == nil then
		return nil
	end
	if s.WalkIn then
		local hb: any = (StructureVisualConfig :: any).HollowBuildings
		local c: any = if typeof(hb) == "table" then hb[id] else nil
		local doorX = if typeof(c) == "table" then tonumber(c.DoorX) else nil
		local depth = if typeof(c) == "table" then tonumber(c.Depth) else nil
		if doorX ~= nil and depth ~= nil then
			local lx, lz = turn(doorX, depth * 0.5 + num(TycoonGuideConfig.Chevrons.DoorLeadStuds), s.Yaw or 0)
			return Vector3.new(s.Site.X + lx, 0, s.Site.Z + lz)
		end
		if s.Console then
			local lx, lz = turn(s.Console.X, s.Console.Z, s.Yaw or 0)
			return Vector3.new(s.Site.X + lx, 0, s.Site.Z + lz)
		end
	end
	local k = s.Kiosk or s.Site
	return Vector3.new(k.X, 0, k.Z)
end

-- F5 chevron count for a player `distance` studs from the approach point:
-- clamp(floor((d - LeadStuds - StopShortStuds) / SpacingStuds) + 1, 0, Count); 0 within HideWithinStuds.
function TycoonMath.ChevronCount(distance: number): number
	local c = TycoonGuideConfig.Chevrons
	local d = num(distance)
	if d <= c.HideWithinStuds then
		return 0
	end
	return math.clamp(math.floor((d - c.LeadStuds - c.StopShortStuds) / c.SpacingStuds) + 1, 0, c.Count)
end

--[[ F5 one pointer: what the floor chevrons point at (and what every NEXT surface should mark during the tutorial).
	step: the ACTIVE tutorial step def (nil once the tutorial is complete or skipped). While Chevrons.FollowTutorial:
	a step with PadStructureId -> (that id, 1); Pointer "ATM" -> ("ATM", 0); any other step -> (nil, 0).
	Otherwise the pick: WE_NextBuy ("Id:Level"); when that is missing or empty and `upgrades` is given, the local
	PickCheapest(upgrades, prestige). Soldiers -> (nil, 0). Display only: the server re-checks every buy. ]]
function TycoonMath.GuideTarget(step: GuideStep?, nextBuy: any, upgrades: { [string]: any }?, prestige: number?): (string?, number)
	if step ~= nil and TycoonGuideConfig.Chevrons.FollowTutorial then
		if step.PadStructureId ~= nil then
			return step.PadStructureId, 1
		end
		if step.Pointer == TycoonMath.ATM_TARGET then
			return TycoonMath.ATM_TARGET, 0
		end
		return nil, 0
	end
	local id, lv = TycoonMath.Decode(nextBuy)
	if id == nil and upgrades ~= nil then
		local c = TycoonMath.PickCheapest(upgrades, prestige)
		if c then
			id, lv = c.Id, c.Level
		end
	end
	if id == nil or id == TycoonGuideConfig.SoldierCandidateId then
		return nil, 0
	end
	return id, lv
end

---------------------------------------------------------------------------------------------------------------
-- display
---------------------------------------------------------------------------------------------------------------

-- "3.3" / "24" from dollars per second: floored (never over-promises), one decimal below 10, whole from 10 up,
-- a trailing ".0" dropped ("3"). Negative / junk -> "0".
function TycoonMath.RateText(perSec: number): string
	local v = math.max(0, num(perSec))
	if v >= 10 then
		return tostring(math.floor(v + EPS))
	end
	local tenths = math.floor(v * 10 + EPS)
	if tenths >= 100 then
		return "10"
	end
	if tenths % 10 == 0 then
		return tostring(tenths // 10)
	end
	return string.format("%d.%d", tenths // 10, tenths % 10)
end

-- "+$3.3/s" from a per-tick amount x mult (e.g. IncomePerTick x WE_IncomeMult)
function TycoonMath.PerSecText(perTick: number, mult: number?): string
	local m = if mult == nil then 1 else num(mult)
	return string.format(TycoonGuideConfig.Text.PerSec, TycoonMath.RateText(num(perTick) * m / TycoonMath.TickSeconds()))
end

-- "+$24/s" from a rate already in dollars per second (WE_IncomePerSec: the cash pill suffix)
function TycoonMath.RatePerSecText(perSec: number): string
	return string.format(TycoonGuideConfig.Text.PerSec, TycoonMath.RateText(perSec))
end

-- "+$3.3/s" for buying `fromLevel + 1` of `id` at WE_IncomeMult `mult` (oil counted unscaled). Soldiers: pass
-- TycoonGuideConfig.SoldierCandidateId (one recruit's training income x mult).
function TycoonMath.StepPerSecText(id: string, fromLevel: number, mult: number?): string
	if id == TycoonGuideConfig.SoldierCandidateId then
		return TycoonMath.PerSecText(TycoonMath.SoldierGainPerTick(), mult)
	end
	return TycoonMath.PerSecText(TycoonMath.StepGainPerTick(id, fromLevel, mult))
end

-- What the buy surfaces say about money (client: wallet = cash, pending = ATM, rate = WE_IncomePerSec):
--   "Buy"      wallet >= cost
--   "Collect"  wallet < cost <= wallet + ATM   (shortBy = cost - wallet: collect that much at your ATM)
--   "Earn"     not enough yet                  (shortBy = cost - wallet - ATM; eta seconds = shortBy / rate, nil at 0)
function TycoonMath.MoneyState(cost: number, wallet: number, pending: number, incomePerSec: number): (MoneyState, number, number?)
	local c = num(cost)
	local w = math.max(0, num(wallet))
	local p = math.max(0, num(pending))
	if w >= c then
		return "Buy", 0, nil
	end
	if w + p >= c then
		return "Collect", c - w, nil
	end
	local short = c - w - p
	local rate = num(incomePerSec)
	return "Earn", short, if rate > 0 then short / rate else nil
end

-- "0:42", "12:05", "1h 05m" (seconds rounded up)
function TycoonMath.FormatEta(seconds: number): string
	local s = math.max(0, math.ceil(num(seconds)))
	if s >= 3600 then
		return string.format("%dh %02dm", s // 3600, (s % 3600) // 60)
	end
	return string.format("%d:%02d", s // 60, s % 60)
end

-- "13,594" (whole dollars, floored)
function TycoonMath.Commas(n: number): string
	local v = math.floor(num(n))
	local neg = v < 0
	local str = tostring(math.abs(v))
	local out = string.reverse((string.gsub(string.reverse(str), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return if neg then "-" .. out else out
end

-- thousands: "$3.2K", "$12.5K", "$25K", "$150K" (tenths of a K rounded; whole K from $100K up)
local function kText(v: number): string
	local tenths = math.floor(v / 100 + 0.5)
	if tenths >= 10000 then
		return "$1M"
	end
	if tenths >= 1000 or tenths % 10 == 0 then
		return string.format("$%dK", tenths // 10)
	end
	return string.format("$%d.%dK", tenths // 10, tenths % 10)
end

--[[ Prices: "$600", "$1,240", "$12.5K", "$25K", "$1.9M" (close to the console price label's rules). tight = true
	(the 2.3-stud console screen) abbreviates from $1,000: "$3.2K". ]]
function TycoonMath.ShortCash(n: number, tight: boolean?): string
	local v = math.max(0, math.floor(num(n)))
	if v >= 1_000_000 then
		return "$" .. (string.gsub(string.format("%.1f", v / 1_000_000), "%.0$", "")) .. "M"
	elseif v >= 10_000 or (tight == true and v >= 1000) then
		return kText(v)
	end
	return "$" .. TycoonMath.Commas(v)
end

-- "+$16" over a business bin on a passive tick: floor(IncomePerTick[level] x mult)
function TycoonMath.PopText(id: string, level: number, mult: number?): string
	local m = if mult == nil then 1 else num(mult)
	return string.format(TycoonGuideConfig.Text.Pop, TycoonMath.Commas(math.floor(TycoonMath.LevelIncomePerTick(id, level) * m + EPS)))
end

--[[ BUY lane (spec v72 F3): how far (v) to shift a horizontally centred action button of width widthV to the right so
	its left edge clears the thumb zone (the left `frac` of the safe-area width) by clearPx REAL px.
	viewportV: the safe content size in v (HudLayout.ContentSizeV()); scale: HudLayout.Scale() (real = v x scale).
	= max(0, W x frac + clearPx / scale - (W / 2 - widthV / 2)), W = viewportV.X. Pure; 0 on junk input. ]]
function TycoonMath.ActionLaneShiftV(viewportV: Vector2, widthV: number, frac: number, clearPx: number, scale: number): number
	local w = num(viewportV.X)
	local s = num(scale)
	if w <= 0 or s <= 0 then
		return 0
	end
	return math.max(0, w * num(frac) + num(clearPx) / s - (w / 2 - num(widthV) / 2))
end

return TycoonMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">UIUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shared client UI helpers — consistent UIScale + dark military panel chrome.
	MobileActionBar tiles: large rounded color-coded squares (≥64px touch).
	v70 HUD: MakeRailTile / SetTileBadge (left rail), TextOutline, Lighten, MakeModalDim (panel dim).
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local HudConfig = require(script.Parent.Parent.Configs.HudConfig)

local UIUtil = {}

local DEFAULT_BASE = 900
local DEFAULT_MIN = 0.65
local DEFAULT_MAX = 1.1

function UIUtil.Corner(parent: Instance, radius: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

function UIUtil.Stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(55, 65, 55)
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

--[[
	MobileScale tracker: ONE ViewportSize connection for every UIScale made by AttachMobileScale (v70 fix: the
	old per-call closures reconnected on every CurrentCamera change and never disconnected). Strong keys (Roblox GC
	drops weak Instance keys); a removed UIScale is pruned on the next viewport change. HudLayout.ApplyScreen takes a
	scale over with ReleaseMobileScale.
]]
type ScaleParams = { Base: number, Min: number, Max: number }
local trackedScales: { [UIScale]: ScaleParams } = {} -- STRONG (weak Instance keys are dropped by GC); pruned below
local trackerStarted = false
local trackerCamConn: RBXScriptConnection? = nil

local function scaleValue(p: ScaleParams): number?
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local size = cam.ViewportSize
	return math.clamp(math.min(size.X, size.Y) / p.Base, p.Min, p.Max)
end

local function updateTrackedScales()
	for scale, p in pairs(trackedScales) do
		if scale.Parent == nil then
			trackedScales[scale] = nil
			continue
		end
		local v = scaleValue(p)
		if v and scale.Scale ~= v then
			scale.Scale = v
		end
	end
end

local function bindTrackerCamera()
	if trackerCamConn then
		trackerCamConn:Disconnect()
		trackerCamConn = nil
	end
	local cam = workspace.CurrentCamera
	if cam then
		trackerCamConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateTrackedScales)
	end
	updateTrackedScales()
end

local function ensureScaleTracker()
	if trackerStarted then
		return
	end
	trackerStarted = true
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindTrackerCamera)
	bindTrackerCamera()
end

--[[
	Attaches a MobileScale UIScale that tracks viewport size.
	Returns the UIScale instance.
]]
function UIUtil.AttachMobileScale(
	screen: ScreenGui,
	basePx: number?,
	minScale: number?,
	maxScale: number?
): UIScale
	local scale = Instance.new("UIScale")
	scale.Name = "MobileScale"
	scale.Parent = screen

	local p: ScaleParams = { Base = basePx or DEFAULT_BASE, Min = minScale or DEFAULT_MIN, Max = maxScale or DEFAULT_MAX }
	trackedScales[scale] = p
	local v = scaleValue(p)
	if v then
		scale.Scale = v
	end
	ensureScaleTracker()

	return scale
end

--[[ Stop AttachMobileScale's tracker from driving this UIScale (HudLayout.ApplyScreen owns it from then on). ]]
function UIUtil.ReleaseMobileScale(scale: UIScale)
	trackedScales[scale] = nil
end

--[[ Standard ScreenGui defaults for WAR EMPIRE panels. ]]
function UIUtil.PrepareScreen(screen: ScreenGui, ignoreInset: boolean?)
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = ignoreInset == true
	UIUtil.AttachMobileScale(screen)
end

--[[ Lightweight empty-state label for list panels. ]]
function UIUtil.EmptyState(parent: Instance, message: string, order: number?): TextLabel
	local lab = Instance.new("TextLabel")
	lab.Name = "EmptyState"
	lab.Size = UDim2.new(1, -8, 0, 56)
	lab.BackgroundTransparency = 1
	lab.Font = Enum.Font.Gotham
	lab.TextSize = 13
	lab.TextWrapped = true
	lab.TextXAlignment = Enum.TextXAlignment.Center
	lab.TextYAlignment = Enum.TextYAlignment.Center
	lab.TextColor3 = Color3.fromRGB(140, 150, 140)
	lab.Text = message
	lab.LayoutOrder = order or 0
	lab.Parent = parent
	return lab
end

--[[ Ensure a GuiButton meets mobile min touch (default 64px for advanced HUD). ]]
function UIUtil.EnsureMinTouch(btn: GuiButton, minPx: number?)
	local m = minPx or 64
	local sz = btn.Size
	local w = sz.X.Offset
	local h = sz.Y.Offset
	if w > 0 and w < m then
		btn.Size = UDim2.new(sz.X.Scale, m, sz.Y.Scale, math.max(h, m))
	elseif h > 0 and h < m then
		btn.Size = UDim2.new(sz.X.Scale, math.max(w, m), sz.Y.Scale, m)
	end
end

function UIUtil.GoldStroke(parent: Instance, thickness: number?): UIStroke
	return UIUtil.Stroke(parent, Color3.fromRGB(230, 190, 60), thickness or 1.5)
end

--[[
	Large rounded glossy action tile for mobile dock.
	icon: short emoji/symbol string; label: caption under icon.
]]
function UIUtil.MakeActionTile(
	parent: Instance,
	props: {
		Name: string,
		Icon: string,
		Label: string,
		Color: Color3,
		LayoutOrder: number?,
		SizePx: number?,
	}
): TextButton
	local size = props.SizePx or 72
	local btn = Instance.new("TextButton")
	btn.Name = props.Name
	btn.Size = UDim2.fromOffset(size, size)
	btn.BackgroundColor3 = props.Color
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Text = ""
	btn.LayoutOrder = props.LayoutOrder or 0
	btn.ZIndex = 20
	btn.Active = true
	btn.Selectable = true
	btn.Parent = parent
	UIUtil.Corner(btn, 16)
	local stroke = UIUtil.Stroke(btn, Color3.fromRGB(255, 255, 255), 1.5)
	stroke.Transparency = 0.45

	-- Glossy top highlight — Active=false so it never steals Activated/clicks
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.Size = UDim2.new(1, -8, 0, math.floor(size * 0.28))
	gloss.Position = UDim2.fromOffset(4, 4)
	gloss.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	gloss.BackgroundTransparency = 0.72
	gloss.BorderSizePixel = 0
	gloss.ZIndex = 21
	gloss.Active = false
	gloss.Parent = btn
	UIUtil.Corner(gloss, 10)

	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.new(1, 0, 0, math.floor(size * 0.48))
	icon.Position = UDim2.fromOffset(0, 6)
	icon.Font = Enum.Font.GothamBold
	icon.TextSize = math.floor(size * 0.36)
	icon.TextColor3 = Color3.fromRGB(255, 255, 255)
	icon.Text = props.Icon
	icon.ZIndex = 22
	icon.Active = false
	icon.Parent = btn

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -4, 0, 16)
	label.Position = UDim2.new(0, 2, 1, -20)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.5
	label.Text = props.Label
	label.ZIndex = 22
	label.Active = false
	label.Parent = btn

	UIUtil.EnsureMinTouch(btn, 64)
	return btn
end

---------------------------------------------------------------------------------------------------------------
-- v70 HUD helpers (HudConfig-driven)
---------------------------------------------------------------------------------------------------------------

--[[ Mix a colour toward white by t (0..1). ]]
function UIUtil.Lighten(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), math.clamp(t, 0, 1))
end

--[[ Glyph outline (UIStroke, Contextual) — the v70 "plain outlined text" look. Default HudConfig.Colors.Ink. ]]
function UIUtil.TextOutline(label: GuiObject, thickness: number?, color: Color3?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Color = color or HudConfig.Colors.Ink
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = label
	return s
end

export type RailTileProps = {
	Name: string, -- MobileActionBar child name (pinned: "DockShop", "DockMissions" ...)
	Label: string, -- "Shop"
	Accent: Color3,
	Fill: Color3,
	Icon: string?, -- HudIcons kind (kept as the attribute "Icon")
	-- draws the icon into IconSlot (60 % of the tile, centred in its top 78 %). HUDController passes
	-- function(slot, ink, fill) HudIcons.Make(kind, slot, {Size = UDim2.fromScale(1, 1), Color = ink, Fill = fill}) end
	IconBuilder: ((slot: Frame, ink: Color3, fill: Color3) -> ())?,
	LayoutOrder: number?,
	Touch: boolean?, -- touch sizes (HudConfig.Rail.Tile …); default UserInputService.TouchEnabled
}

local function circle(parent: Instance, name: string, size: number, color: Color3, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Active = false
	f.Parent = parent
	UIUtil.Corner(f, math.ceil(size / 2))
	return f
end

--[[
	v70 left-rail cell (HudConfig.Rail). ONE TextButton of T × (T + LabelOverhang) v, so the hit area includes
	the label (64 x 70 v touch = 44.8 x 49 real px on phones). Children:
	  Group (press UIScale "Press") › Outline (1.5 v Ink) + Tile (Accent ring = StrokePx edge)
	    Tile › Face (Fill lightened 16 % → Fill gradient), IconSlot, Badge (hidden; see SetTileBadge)
	  Label — FredokaOne, white, 2 px Ink outline, straddling the tile's bottom edge
	The caller wires btn.Activated (pinned) — this helper only adds the visual press feedback.
	-- dock≤8: rail gap 5/8 v (HudConfig.Rail.Gap / GapDesktop)
]]
function UIUtil.MakeRailTile(parent: Instance?, props: RailTileProps): TextButton
	local R = HudConfig.Rail
	local touch = if props.Touch == nil then UserInputService.TouchEnabled else props.Touch == true
	local T = if touch then R.Tile else R.TileDesktop
	local ov = if touch then R.LabelOverhang else R.LabelOverhangDesktop
	local L = if touch then R.LabelSize else R.LabelSizeDesktop
	local edge = R.StrokePx
	local ink = HudConfig.Colors.Ink

	local btn = Instance.new("TextButton")
	btn.Name = props.Name
	btn.Size = UDim2.fromOffset(T, T + ov)
	btn.BackgroundTransparency = 1
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.LayoutOrder = props.LayoutOrder or 0
	btn.Active = true
	btn.Selectable = true
	btn.ZIndex = 20
	btn:SetAttribute("RailTile", true)
	if props.Icon then
		btn:SetAttribute("Icon", props.Icon)
	end

	local group = Instance.new("Frame")
	group.Name = "Group"
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.Position = UDim2.new(0.5, 0, 0, T / 2)
	group.Size = UDim2.fromOffset(T, T)
	group.BackgroundTransparency = 1
	group.BorderSizePixel = 0
	group.ZIndex = 20
	group.Active = false
	group.Parent = btn
	local press = Instance.new("UIScale")
	press.Name = "Press"
	press.Parent = group

	local outline = Instance.new("Frame")
	outline.Name = "Outline"
	outline.AnchorPoint = Vector2.new(0.5, 0.5)
	outline.Position = UDim2.fromScale(0.5, 0.5)
	outline.Size = UDim2.new(1, 3, 1, 3)
	outline.BackgroundColor3 = ink
	outline.BackgroundTransparency = 0.45
	outline.BorderSizePixel = 0
	outline.ZIndex = 20
	outline.Active = false
	outline.Parent = group
	UIUtil.Corner(outline, R.Corner + 1.5)

	local tile = Instance.new("Frame")
	tile.Name = "Tile"
	tile.AnchorPoint = Vector2.new(0.5, 0.5)
	tile.Position = UDim2.fromScale(0.5, 0.5)
	tile.Size = UDim2.fromScale(1, 1)
	tile.BackgroundColor3 = props.Accent
	tile.BorderSizePixel = 0
	tile.ZIndex = 21
	tile.Active = false
	tile.Parent = group
	UIUtil.Corner(tile, R.Corner)

	local top = UIUtil.Lighten(props.Fill, 0.16)
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.new(1, -2 * edge, 1, -2 * edge)
	face.BackgroundColor3 = top
	face.BorderSizePixel = 0
	face.ZIndex = 22
	face.Active = false
	face.Parent = tile
	UIUtil.Corner(face, math.max(0, R.Corner - edge))
	-- UIGradient multiplies: top colour × 1 → Fill at the bottom (per-channel ratio)
	local function ratio(a: number, b: number): number
		return if b > 0 then math.clamp(a / b, 0, 1) else 1
	end
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(
		Color3.new(1, 1, 1),
		Color3.new(ratio(props.Fill.R, top.R), ratio(props.Fill.G, top.G), ratio(props.Fill.B, top.B))
	)
	grad.Parent = face

	local slot = Instance.new("Frame")
	slot.Name = "IconSlot"
	slot.AnchorPoint = Vector2.new(0.5, 0.5)
	slot.Position = UDim2.fromScale(0.5, 0.39)
	slot.Size = UDim2.fromScale(R.IconScale, R.IconScale)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.ZIndex = 23
	slot.Active = false
	slot.Parent = tile
	if props.IconBuilder then
		-- the face colour behind the icon's centre (gradient at 39 %)
		local behind = props.Fill:Lerp(top, 1 - 0.39)
		local build = props.IconBuilder
		local ok, err = pcall(function(): string?
			build(slot, UIUtil.Lighten(props.Accent, 0.12), behind)
			return nil
		end)
		if not ok then
			warn("[UIUtil] rail icon failed:", props.Name, err)
		end
	end

	local B = R.Badge
	local badge = circle(tile, "Badge", B.Size + 4, ink, 30)
	local inset: Vector2 = (B :: any).Inset or Vector2.new(4, 4)
	badge.Position = UDim2.new(1, -inset.X, 0, inset.Y)
	badge.Visible = false
	local dot = circle(badge, "Dot", B.Size, B.Bg, 31)
	local btext = Instance.new("TextLabel")
	btext.Name = "Text"
	btext.BackgroundTransparency = 1
	btext.Size = UDim2.fromScale(1, 1)
	btext.Font = HudConfig.Fonts.Display
	btext.TextSize = B.TextSize
	btext.TextColor3 = HudConfig.Colors.White
	btext.Text = ""
	btext.ZIndex = 32
	btext.Active = false
	btext.Parent = dot
	local badgeScale = Instance.new("UIScale")
	badgeScale.Name = "Pop"
	badgeScale.Parent = badge

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 1, -(ov + 0.62 * L))
	label.Size = UDim2.new(1, 32, 0, L)
	label.Font = HudConfig.Fonts.Display
	label.TextSize = L
	label.TextColor3 = HudConfig.Colors.White
	label.Text = props.Label
	label.ZIndex = 25
	label.Active = false
	label.Parent = btn
	UIUtil.TextOutline(label, R.LabelStroke)

	btn.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			press.Scale = R.PressScale
		end
	end)
	local function release()
		if press.Scale ~= 1 then
			TweenService:Create(press, TweenInfo.new(0.06), { Scale = 1 }):Play()
		end
	end
	btn.InputEnded:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			release()
		end
	end)
	btn.MouseLeave:Connect(release)

	if parent then
		btn.Parent = parent
	end
	return btn
end

--[[ Rail badge on a MakeRailTile button: "!" = gold ready style, a count = red, nil / "" / "0" hides.
	Pops once (UIScale 1 → 1.2 → 1) when it appears. ]]
function UIUtil.SetTileBadge(tileButton: Instance, text: string?)
	local badge = tileButton:FindFirstChild("Badge", true)
	if not (badge and badge:IsA("GuiObject")) then
		return
	end
	local show = text ~= nil and text ~= "" and text ~= "0"
	local was = badge.Visible
	badge.Visible = show
	if not show or text == nil then
		return
	end
	local B = HudConfig.Rail.Badge
	local ready = text == "!"
	local dot = badge:FindFirstChild("Dot")
	if dot and dot:IsA("GuiObject") then
		dot.BackgroundColor3 = if ready then B.ReadyBg else B.Bg
		local lab = dot:FindFirstChild("Text")
		if lab and lab:IsA("TextLabel") then
			lab.Text = text
			lab.TextColor3 = if ready then B.ReadyText else HudConfig.Colors.White
		end
	end
	if not was and B.PulseWhenNew then
		local pop = badge:FindFirstChild("Pop")
		if pop and pop:IsA("UIScale") then
			pop.Scale = 1
			TweenService:Create(pop, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Scale = 1.2 }):Play()
		end
	end
end

--[[
	Black dim behind an open panel (HudConfig.Context.ModalDim = its BackgroundTransparency). Put it in the
	panel's own ScreenGui; it is created as the lowest layer and oversized so it covers the whole gui area.
	Active = false (the world still gets the input); on a tap/click OUTSIDE `panel` (when given) it calls onTap.
	Returns the existing "ModalDim" when there is one. Toggle .Visible with the panel.
]]
function UIUtil.MakeModalDim(screen: Instance, onTap: (() -> ())?, panel: GuiObject?): Frame
	local existing = screen:FindFirstChild("ModalDim")
	if existing and existing:IsA("Frame") then
		return existing
	end
	local dim = Instance.new("Frame")
	dim.Name = "ModalDim"
	dim.AnchorPoint = Vector2.new(0.5, 0.5)
	dim.Position = UDim2.fromScale(0.5, 0.5)
	dim.Size = UDim2.fromScale(3, 3)
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = HudConfig.Context.ModalDim
	dim.BorderSizePixel = 0
	dim.ZIndex = 0
	dim.LayoutOrder = -1000
	dim.Active = false
	dim.Parent = screen
	if onTap then
		local cb: () -> () = onTap
		dim.InputBegan:Connect(function(input: InputObject)
			local t = input.UserInputType
			if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
				return
			end
			if panel and panel.Visible then
				local p = Vector2.new(input.Position.X, input.Position.Y)
				local a, s = panel.AbsolutePosition, panel.AbsoluteSize
				if p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y then
					return
				end
			end
			cb()
		end)
	end
	return dim
end

return UIUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">WorldLabel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WorldLabel: the one way to make a floating world label (HUD v70 spec §5; CLAUDE.md "World labels").
	Server or client. Never yields.

	API
	  WorldLabel.Create(adornee, text, opts?) -> BillboardGui
	      Plain outlined text, no card. Box is stud-scaled (Size = UDim2.fromScale(studsW, studsH)); text is a fixed
	      TextSize clamped to 14-20 real px (never TextScaled). AlwaysOnTop = false, LightInfluence = 0,
	      MaxDistance <= WorldLabelConfig.MaxDistance (40). adornee: BasePart | Attachment | Model (a Model uses its
	      PrimaryPart, else its first BasePart). The label is parented last, so it replicates fully built.
	  WorldLabel.Surface(part, face, text, opts?) -> SurfaceGui
	      Painted sign on one face (PixelsPerStud, LightInfluence 0, MaxDistance <= 80, clipped to the face).
	      Text is sized from the face height unless opts.TextSize is given (canvas px, 14-100).
	  WorldLabel.SetText(gui, text, sub?, subColor?)   update in place; sub nil/"" hides the second line
	  WorldLabel.SetOwner(gui, userId?)                only that player sees it (nil = everyone)
	  WorldLabel.SetRole(bb, role?)                    "objective" | "contested" -> AlwaysOnTop; nil -> off
	  WorldLabel.StartOwnerFilter() -> boolean         CLIENT, once (WorldPromptController.Init); false on the server
	  WorldLabel.TagBaseLabel(gui)                     F4: tag a label built by hand as a base label (see BaseLabel)
	  WorldLabel.SetShown(gui, on)                     CLIENT code that owns a label shows / hides it through this
	  WorldLabel.Hold(gui, held)                       CLIENT, LabelGovernor only: keep the label off while held
	  WorldLabel.Wanted(gui) -> boolean                CLIENT: its owner wants it on, and it is not someone else's
	  WorldLabel.IsHeld(gui) -> boolean                CLIENT: the LabelGovernor holds it off

	opts (all optional)
	  Name         instance name; keep pinned names ("WE_FlagBillboard", "WE_GateSign"). Default "WE_WorldLabel" /
	               "WE_WorldSign"
	  Sub          second, smaller line ("$850", "RAID IN PROGRESS")
	  Color        title colour (default white);  SubColor (default HudConfig.Colors.Muted)
	  TextSize     title px (billboard: clamped 14-20, default 16; the sub line is 14)
	  Studs        Vector2 box size in studs (default HudConfig.WorldLabels.Default StudsW x StudsH)
	  Offset       Vector3 StudsOffsetWorldSpace from the adornee (default: StudsAbove over a part's top)
	  MaxDistance  studs; clamped to the cap (billboard 40, surface 80)
	  OwnerUserId  owner-only label (see below)
	  Role         "objective" | "contested": the only labels allowed AlwaysOnTop (billboard only)
	  PixelsPerStud  surface only (default 40)
	  Parent       default: the resolved adornee (billboard) / the part (surface)
	  BaseLabel    F4 (billboard): tag it WorldLabelConfig.BaseLabelTag, so the client LabelGovernor counts it toward
	               "at most 3 labels on screen at a base" (pads, gold pump pad, producer label, NEXT tag, pops)

	Client Enabled arbitration (F4). Three things can switch a label off on this client: its owner (the server's
	replicated Enabled, or the client code that made it), the owner filter below (someone else's owner-only label)
	and the LabelGovernor (over the on-screen cap). The label shows only when its owner wants it AND nothing else
	hides it. The owner's wish is what SetShown was last told, or any Enabled change this module did not write. A
	write that does not change the value fires no event, so client code that hides a tagged label calls SetShown and
	never writes Enabled itself (a held label is already off: "Enabled = false" would be lost and the governor would
	switch it back on). While nothing is held (LabelGovernor off) SetShown is exactly "Enabled = on".

	Owner-only (no PlayerGui copies): the label stays in Workspace with attribute WE_LabelOwner = UserId and the
	CollectionService tag "WE_OwnerLabel" (names in WorldLabelConfig). Each client's StartOwnerFilter sets
	Enabled = false LOCALLY on tagged labels owned by someone else and restores the server's value when the label
	becomes theirs; server Enabled changes keep working for the owner. Cosmetic only: the text still replicates to
	every client, so never put anything secret in a label. Limit: if the server turns a label off while the filter
	is already hiding it (no change event), handing that label to this player shows it again, so hide
	owner-only labels by Destroy or text rather than Enabled.

	WorldLabelPolicy (server) applies the same caps to every BillboardGui in Workspace, inside plots and out, and
	honours WE_LabelRole for AlwaysOnTop.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Configs = script.Parent.Parent.Configs
local HudConfig = require(Configs.HudConfig)
local WorldLabelConfig = require(Configs.WorldLabelConfig)

export type Role = "objective" | "contested"
export type Options = {
	Name: string?,
	Sub: string?,
	Color: Color3?,
	SubColor: Color3?,
	TextSize: number?,
	Studs: Vector2?,
	Offset: Vector3?,
	MaxDistance: number?,
	OwnerUserId: number?,
	Role: Role?,
	PixelsPerStud: number?,
	Parent: Instance?,
	BaseLabel: boolean?,
}

local WorldLabel = {}

local LOOK = HudConfig.WorldLabels.Default
local INK = HudConfig.Colors.Ink
local WHITE = HudConfig.Colors.White
local MUTED = HudConfig.Colors.Muted
local ROLE_ATTR = WorldLabelConfig.RoleAttribute
local OWNER_ATTR = WorldLabelConfig.OwnerAttribute
local OWNER_TAG = WorldLabelConfig.OwnerTag
local BASE_TAG = WorldLabelConfig.BaseLabelTag

local function clampSize(v: number, lo: number, hi: number): number
	return math.clamp(math.floor(v + 0.5), lo, hi)
end

local function capDistance(want: number?, default: number, cap: number): number
	local d = if want ~= nil and want > 0 then want else default
	return math.min(d, cap)
end

local function resolveAdornee(adornee: Instance): Instance?
	if adornee:IsA("BasePart") or adornee:IsA("Attachment") then
		return adornee
	end
	if adornee:IsA("Model") then
		return adornee.PrimaryPart or adornee:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function makeLine(parent: Instance, name: string, text: string, size: number, color: Color3, font: Enum.Font): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Size = UDim2.new(1, 0, 0, size + WorldLabelConfig.LinePad)
	t.Position = UDim2.fromScale(0.5, 0.5)
	t.Font = font
	t.Text = text
	t.TextSize = size
	t.TextScaled = false
	t.TextWrapped = false
	t.TextColor3 = color
	t.TextStrokeColor3 = INK
	t.TextStrokeTransparency = 0
	t.TextXAlignment = Enum.TextXAlignment.Center
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Parent = parent
	return t
end

-- Lines are stacked in fixed px around the box centre, so they never overlap however small the stud box gets on
-- screen (the text overflows the box symmetrically; ClipsDescendants stays off on billboards).
local function layout(title: TextLabel, sub: TextLabel)
	local pad = WorldLabelConfig.LinePad
	local want = UDim2.fromScale(0.5, 0.5)
	if sub.Visible then
		local hT = title.TextSize + pad
		local hS = sub.TextSize + pad
		want = UDim2.new(0.5, 0, 0.5, -hS / 2)
		local subPos = UDim2.new(0.5, 0, 0.5, hT / 2)
		if sub.Position ~= subPos then
			sub.Position = subPos
		end
	end
	if title.Position ~= want then
		title.Position = want
	end
end

local function addLines(gui: LayerCollector, text: string, opts: Options, titleSize: number, subSize: number)
	local font = LOOK.Font
	local title = makeLine(gui, "Title", text, titleSize, opts.Color or WHITE, font)
	local subText = opts.Sub
	local sub = makeLine(gui, "Sub", subText or "", subSize, opts.SubColor or MUTED, font)
	sub.Visible = subText ~= nil and subText ~= ""
	layout(title, sub)
end

function WorldLabel.SetOwner(gui: LayerCollector, userId: number?)
	if userId ~= nil and userId ~= 0 then
		if gui:GetAttribute(OWNER_ATTR) ~= userId then
			gui:SetAttribute(OWNER_ATTR, userId)
		end
		CollectionService:AddTag(gui, OWNER_TAG)
	else
		-- attribute first: a watching client restores the label on the attribute change
		if gui:GetAttribute(OWNER_ATTR) ~= nil then
			gui:SetAttribute(OWNER_ATTR, nil)
		end
		CollectionService:RemoveTag(gui, OWNER_TAG)
	end
end

function WorldLabel.SetRole(bb: BillboardGui, role: Role?)
	-- attribute before AlwaysOnTop: WorldLabelPolicy's AlwaysOnTop watcher reads the role
	if bb:GetAttribute(ROLE_ATTR) ~= role then
		bb:SetAttribute(ROLE_ATTR, role)
	end
	local top = role ~= nil and WorldLabelConfig.AlwaysOnTopRoles[role] == true
	if bb.AlwaysOnTop ~= top then
		bb.AlwaysOnTop = top
	end
end

function WorldLabel.SetText(gui: LayerCollector, text: string, sub: string?, subColor: Color3?)
	local title = gui:FindFirstChild("Title")
	local subLine = gui:FindFirstChild("Sub")
	if not (title and title:IsA("TextLabel") and subLine and subLine:IsA("TextLabel")) then
		return
	end
	if title.Text ~= text then
		title.Text = text
	end
	local show = sub ~= nil and sub ~= ""
	if show and sub ~= nil and subLine.Text ~= sub then
		subLine.Text = sub
	end
	if subColor ~= nil and subLine.TextColor3 ~= subColor then
		subLine.TextColor3 = subColor
	end
	if subLine.Visible ~= show then
		subLine.Visible = show
	end
	layout(title, subLine)
end

function WorldLabel.Create(adornee: Instance, text: string, opts: Options?): BillboardGui
	local o: Options = opts or {}
	local target = resolveAdornee(adornee)
	if target == nil then
		warn("[WorldLabel] no BasePart/Attachment to adorn for " .. adornee:GetFullName())
	end
	local studs = o.Studs or Vector2.new(LOOK.StudsW, LOOK.StudsH)
	local above = WorldLabelConfig.StudsAbove
	local offset: Vector3 = o.Offset
		or (if target ~= nil and target:IsA("BasePart") then Vector3.new(0, target.Size.Y * 0.5 + above, 0) else Vector3.new(0, above, 0))
	local minT, maxT = WorldLabelConfig.MinTextSize, WorldLabelConfig.MaxTextSize
	local titleSize = clampSize(o.TextSize or WorldLabelConfig.TextSize, minT, maxT)
	local subSize = math.min(clampSize(WorldLabelConfig.SubTextSize, minT, maxT), titleSize)

	local bb = Instance.new("BillboardGui")
	bb.Name = o.Name or "WE_WorldLabel"
	bb.Size = UDim2.fromScale(studs.X, studs.Y)
	bb.StudsOffsetWorldSpace = offset
	bb.MaxDistance = capDistance(o.MaxDistance, LOOK.MaxDistance, WorldLabelConfig.MaxDistance)
	bb.LightInfluence = 0
	bb.ClipsDescendants = false
	bb.Active = false
	bb.AlwaysOnTop = false
	if target ~= nil then
		bb.Adornee = target
	end
	addLines(bb, text, o, titleSize, subSize)
	if o.Role ~= nil then
		WorldLabel.SetRole(bb, o.Role)
	end
	if o.OwnerUserId ~= nil then
		WorldLabel.SetOwner(bb, o.OwnerUserId)
	end
	if o.BaseLabel == true then
		CollectionService:AddTag(bb, BASE_TAG) -- before parenting: the governor sees it once, fully built
	end
	bb.Parent = o.Parent or target or adornee
	return bb
end

-- F4: a base label built without Create (the v72 console tags) joins the LabelGovernor's cap
function WorldLabel.TagBaseLabel(gui: LayerCollector)
	if not CollectionService:HasTag(gui, BASE_TAG) then
		CollectionService:AddTag(gui, BASE_TAG)
	end
end

local function faceSize(part: BasePart, face: Enum.NormalId): Vector2
	local s = part.Size
	if face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		return Vector2.new(s.Z, s.Y)
	elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		return Vector2.new(s.X, s.Z)
	end
	return Vector2.new(s.X, s.Y)
end

function WorldLabel.Surface(part: BasePart, face: Enum.NormalId, text: string, opts: Options?): SurfaceGui
	local o: Options = opts or {}
	local pps = if o.PixelsPerStud ~= nil and o.PixelsPerStud > 0 then o.PixelsPerStud else WorldLabelConfig.SurfacePixelsPerStud
	local faceH = faceSize(part, face).Y * pps
	local hasSub = o.Sub ~= nil and o.Sub ~= ""
	local minT, maxT = WorldLabelConfig.MinTextSize, WorldLabelConfig.SurfaceMaxTextSize
	local titleSize = clampSize(o.TextSize or faceH * (if hasSub then 0.42 else 0.55), minT, maxT)
	local subSize = math.min(clampSize(faceH * 0.28, minT, maxT), titleSize)

	local sg = Instance.new("SurfaceGui")
	sg.Name = o.Name or "WE_WorldSign"
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = pps
	sg.MaxDistance = capDistance(o.MaxDistance, WorldLabelConfig.SurfaceDefaultMaxDistance, WorldLabelConfig.SurfaceMaxDistance)
	sg.LightInfluence = 0
	sg.ClipsDescendants = true
	sg.AlwaysOnTop = false
	sg.Adornee = part
	addLines(sg, text, o, titleSize, subSize)
	if o.OwnerUserId ~= nil then
		WorldLabel.SetOwner(sg, o.OwnerUserId)
	end
	sg.Parent = o.Parent or part
	return sg
end

-- ── client: who decides Enabled (owner filter + LabelGovernor; see the header) ──────────────────────────────
-- want[gui]: what the label's owner (the server / the client code that made it) wants. foreign: someone else's
-- owner-only label (the owner filter). held: over the on-screen cap (LabelGovernor). wrote: the last value this
-- module wrote, so its own writes are not mistaken for the owner's wish (signals are deferred: no re-entrancy flag).
local filterStarted = false
local listening: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })
local want: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })
local wrote: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })
local foreign: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })
local held: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })

local function apply(gui: LayerCollector)
	local w = want[gui]
	if w == nil then
		w = gui.Enabled
		want[gui] = w
	end
	local on = w and foreign[gui] ~= true and held[gui] ~= true
	if gui.Enabled ~= on then
		wrote[gui] = on
		gui.Enabled = on
	end
end

-- start following the label's Enabled (once per label): a change this module did not write is the owner's new wish
local function listen(gui: LayerCollector)
	if listening[gui] then
		return
	end
	listening[gui] = true
	-- nothing hides a label before it is listened to, so its Enabled right now is its owner's wish
	want[gui] = gui.Enabled
	wrote[gui] = nil
	gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		local w = wrote[gui]
		if w ~= nil and gui.Enabled == w then
			return -- this module's own write
		end
		want[gui] = gui.Enabled
		wrote[gui] = nil
		apply(gui)
	end)
end

local function ownerOf(gui: Instance): number?
	local v = gui:GetAttribute(OWNER_ATTR)
	if type(v) == "number" and v ~= 0 then
		return v
	end
	return nil
end

--[[ Client code that owns a label shows / hides it through this (never "Enabled = x" on a tagged label). ]]
function WorldLabel.SetShown(gui: LayerCollector, on: boolean)
	want[gui] = on
	apply(gui)
end

--[[ LabelGovernor only: held = keep the label off (its owner's wish is kept and comes back on release). ]]
function WorldLabel.Hold(gui: LayerCollector, on: boolean)
	if (held[gui] == true) == on then
		return
	end
	listen(gui)
	held[gui] = on
	apply(gui)
end

function WorldLabel.IsHeld(gui: LayerCollector): boolean
	return held[gui] == true
end

--[[ True when the label's owner wants it on and it is not another player's owner-only label (the LabelGovernor's
	"could be on screen" test; distance is the governor's job). ]]
function WorldLabel.Wanted(gui: LayerCollector): boolean
	if foreign[gui] == true then
		return false
	end
	local owner = ownerOf(gui)
	if owner ~= nil then
		local lp = Players.LocalPlayer
		if lp == nil or owner ~= lp.UserId then
			return false
		end
	end
	local w = want[gui]
	if w == nil then
		return gui.Enabled
	end
	return w
end

-- owner-only filter: someone else's label is held off on this client; handed to this player, its owner's wish returns
local function applyFilter(gui: LayerCollector, me: number)
	local owner = ownerOf(gui)
	local other = owner ~= nil and owner ~= me
	if (foreign[gui] == true) ~= other then
		foreign[gui] = other
	end
	apply(gui)
end

local watched: { [LayerCollector]: boolean } = setmetatable({} :: any, { __mode = "k" })

local function watch(inst: Instance, me: number)
	if not (inst:IsA("BillboardGui") or inst:IsA("SurfaceGui")) then
		return
	end
	local gui = inst :: LayerCollector
	if watched[gui] then
		applyFilter(gui, me)
		return
	end
	watched[gui] = true
	listen(gui)
	gui:GetAttributeChangedSignal(OWNER_ATTR):Connect(function()
		applyFilter(gui, me)
	end)
	applyFilter(gui, me)
end

function WorldLabel.StartOwnerFilter(): boolean
	if filterStarted then
		return true
	end
	local lp = Players.LocalPlayer
	if lp == nil then
		return false
	end
	filterStarted = true
	local me = lp.UserId
	CollectionService:GetInstanceAddedSignal(OWNER_TAG):Connect(function(inst: Instance)
		watch(inst, me)
	end)
	for _, inst in ipairs(CollectionService:GetTagged(OWNER_TAG)) do
		watch(inst, me)
	end
	return true
end

return WorldLabel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="75">
        <Properties>
          <string name="Name">Vendor</string>
        </Properties>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">Shake</string>
            <string name="Source"><![CDATA[--!strict
--!native
--[[ VENDORED (W2 CC-3): RbxUtil Shake v1.1.0 by Stephen Leitnick, MIT licence (see LICENSE beside this file and
	THIRD_PARTY_NOTICES.md at the repo root).
	Upstream: https://github.com/Sleitnick/RbxUtil  modules/shake/init.luau
	Source:   raw.githubusercontent.com, branch main @ 31f9120fca021e3dec275b42bc7047d626962082, fetched 2026-09-24
	          (byte-identical to the copy reviewed in scratchpad/gap/vend/shake.luau).
	Local changes (type annotations only, so the file is --!strict clean; behaviour unchanged), each marked
	"[W2 strict #n]" in the code:
	  0. first line "--!strict" added (upstream starts with "--!native", kept on line 2)
	  1. Shake.new:        return (self :: any) :: Shake
	  2. Shake:StopSustain: local now: number = self.TimeFunction()
	  3. Shake:Update:      local now: number = self.TimeFunction()
	  4. Shake:Update:      (self.PositionInfluence :: Vector3) * offset
	  5. Shake:Update:      (self.RotationInfluence :: Vector3) * offset
]]

local RunService = game:GetService("RunService")

--[=[
	@within Shake
	@type UpdateCallbackFn () -> (position: Vector3, rotation: Vector3, completed: boolean)
]=]
type UpdateCallbackFn = () -> (Vector3, Vector3, boolean)

export type Shake = {
	Amplitude: number,
	Frequency: number,
	FadeInTime: number,
	FadeOutTime: number,
	SustainTime: number,
	Sustain: boolean,
	PositionInfluence: Vector3,
	RotationInfluence: Vector3,
	TimeFunction: () -> number,

	Start: (self: Shake) -> (),
	Stop: (self: Shake) -> (),
	IsShaking: (self: Shake) -> boolean,
	StopSustain: (self: Shake) -> (),
	Update: (self: Shake) -> (Vector3, Vector3, boolean),
	OnSignal: (
		self: Shake,
		signal: RBXScriptSignal,
		callback: (Vector3, Vector3, boolean) -> ()
	) -> RBXScriptConnection,
	BindToRenderStep: (self: Shake, name: string, priority: number, callback: (Vector3, Vector3, boolean) -> ()) -> (),
	Clone: (self: Shake) -> Shake,
	Destroy: (self: Shake) -> (),
}

local rng = Random.new()
local renderId = 0

--[=[
	@class Shake
	Create realistic shake effects, such as camera or object shakes.

	Creating a shake is very simple with this module. For every shake,
	simply create a shake instance by calling `Shake.new()`. From
	there, configure the shake however desired. Once configured,
	call `shake:Start()` and then bind a function to it with either
	`shake:OnSignal(...)` or `shake:BindToRenderStep(...)`.
	
	The shake will output its values to the connected function, and then
	automatically stop and clean up its connections once completed.

	Shake instances can be reused indefinitely. However, only one shake
	operation per instance can be running. If more than one is needed
	of the same configuration, simply call `shake:Clone()` to duplicate
	it.

	Example of a simple camera shake:
	```lua
	local priority = Enum.RenderPriority.Last.Value

	local shake = Shake.new()
	shake.FadeInTime = 0
	shake.Frequency = 0.1
	shake.Amplitude = 5
	shake.RotationInfluence = Vector3.new(0.1, 0.1, 0.1)

	shake:Start()
	shake:BindToRenderStep(Shake.NextRenderName(), priority, function(pos, rot, isDone)
		camera.CFrame *= CFrame.new(pos) * CFrame.Angles(rot.X, rot.Y, rot.Z)
	end)
	```

	Shakes will automatically stop once the shake has been completed. Shakes can
	also be used continuously if the `Sustain` property is set to `true`.

	## Fixing drift

	If you are not controlling the initial CFrame of the camera (i.e. using Roblox's camera scripts),
	then you might run into odd behavior with the above example. This is because Roblox's camera
	scripts are influenced by the current CFrame value of the camera. Thus, the shake effect causes
	odd side-effects, especially noticeable at higher FPS.

	The solution is to simply store the camera's CFrame before applying the shake CFrame, and then
	reapplying this stored CFrame value after rendering is complete (e.g. on Heartbeat).

	```lua
	local camCf: CFrame

	shake:BindToRenderStep(Shake.NextRenderName(), priority, function(pos, rot, isDone)
		-- Store the CFrame value that was set from Roblox's camera scripts:
		camCf = camera.CFrame

		camera.CFrame *= CFrame.new(pos) * CFrame.Angles(rot.X, rot.Y, rot.Z)
	end)

	RunService.Heartbeat:Connect(function()
		-- Reapply the camera script CFrame before they run again.
		-- Heartbeat runs AFTER Roblox has rendered, so it will not affect the camera this frame.
		camera.CFrame = camCf
	end)
	```

	## Configuration

	Here are some more helpful configuration examples:

	```lua
	local shake = Shake.new()

	-- The magnitude of the shake. Larger numbers means larger shakes.
	shake.Amplitude = 5

	-- The speed of the shake. Smaller frequencies mean faster shakes.
	shake.Frequency = 0.1

	 -- Fade-in time before max amplitude shake. Set to 0 for immediate shake.
	shake.FadeInTime = 0

	-- Fade-out time. Set to 0 for immediate cutoff.
	shake.FadeOutTime = 0

	-- How long the shake sustains full amplitude before fading out
	shake.SustainTime = 1

	-- Set to true to never end the shake. Call shake:StopSustain() to start the fade-out.
	shake.Sustain = true

	-- Multiplies against the shake vector to control the final amplitude of the position.
	-- Can be seen internally as: position = shakeVector * fadeInOut * positionInfluence
	shake.PositionInfluence = Vector3.one

	-- Multiplies against the shake vector to control the final amplitude of the rotation.
	-- Can be seen internally as: position = shakeVector * fadeInOut * rotationInfluence
	shake.RotationInfluence = Vector3.new(0.1, 0.1, 0.1)

	```
]=]
local Shake = {}
Shake.__index = Shake

--[=[
	@within Shake
	@prop Amplitude number
	Amplitude of the overall shake. For instance, an amplitude of `3` would mean the
	peak magnitude for the outputted shake vectors would be about `3`.

	Defaults to `1`.
]=]

--[=[
	@within Shake
	@prop Frequency number
	Frequency of the overall shake. This changes how slow or fast the
	shake occurs.

	Defaults to `1`.
]=]

--[=[
	@within Shake
	@prop FadeInTime number
	How long it takes for the shake to fade in, measured in seconds.

	Defaults to `1`.
]=]

--[=[
	@within Shake
	@prop FadeOutTime number
	How long it takes for the shake to fade out, measured in seconds.

	Defaults to `1`.
]=]

--[=[
	@within Shake
	@prop SustainTime number
	How long it takes for the shake sustains itself after fading in and
	before fading out.
	
	To sustain a shake indefinitely, set `Sustain`
	to `true`, and call the `StopSustain()` method to stop the sustain
	and fade out the shake effect.

	Defaults to `0`.
]=]

--[=[
	@within Shake
	@prop Sustain boolean
	If `true`, the shake will sustain itself indefinitely once it fades
	in. If `StopSustain()` is called, the sustain will end and the shake
	will fade out based on the `FadeOutTime`.

	Defaults to `false`.
]=]

--[=[
	@within Shake
	@prop PositionInfluence Vector3
	This is similar to `Amplitude` but multiplies against each axis
	of the resultant shake vector, and only affects the position vector.

	Defaults to `Vector3.one`.
]=]

--[=[
	@within Shake
	@prop RotationInfluence Vector3
	This is similar to `Amplitude` but multiplies against each axis
	of the resultant shake vector, and only affects the rotation vector.

	Defaults to `Vector3.one`.
]=]

--[=[
	@within Shake
	@prop TimeFunction () -> number
	The function used to get the current time. This defaults to
	`time` during runtime, and `os.clock` otherwise. Usually this
	will not need to be set, but it can be optionally configured
	if desired.
]=]

--[=[
	@return Shake
	Construct a new Shake instance.
]=]
function Shake.new(): Shake
	local self = setmetatable({}, Shake)

	self.Amplitude = 1
	self.Frequency = 1
	self.FadeInTime = 1
	self.FadeOutTime = 1
	self.SustainTime = 0
	self.Sustain = false
	self.PositionInfluence = Vector3.one
	self.RotationInfluence = Vector3.one
	self.TimeFunction = if RunService:IsRunning() then time else os.clock

	self._timeOffset = rng:NextNumber(-1e6, 1e6)
	self._startTime = 0
	self._running = false
	self._signalConnections = {}
	self._renderBindings = {}

	return (self :: any) :: Shake -- [W2 strict #1]
end

--[=[
	Apply an inverse square intensity multiplier to the given vector based on the
	distance away from some source. This can be used to simulate shake intensity
	based on the distance the shake is occurring from some source.

	For instance, if the shake is caused by an explosion in the game, the shake
	can be calculated as such:

	```lua
	local function Explosion(positionOfExplosion: Vector3)

		local cam = workspace.CurrentCamera
		local renderPriority = Enum.RenderPriority.Last.Value

		local shake = Shake.new()
		-- Set shake properties here

		local function ExplosionShake(pos: Vector3, rot: Vector3)
			local distance = (cam.CFrame.Position - positionOfExplosion).Magnitude
			pos = Shake.InverseSquare(pos, distance)
			rot = Shake.InverseSquare(rot, distance)
			cam.CFrame *= CFrame.new(pos) * CFrame.Angles(rot.X, rot.Y, rot.Z)
		end

		shake:BindToRenderStep("ExplosionShake", renderPriority, ExplosionShake)

	end
	```
]=]
function Shake.InverseSquare(shake: Vector3, distance: number): Vector3
	if distance < 1 then
		distance = 1
	end
	local intensity = 1 / (distance * distance)
	return shake * intensity
end

--[=[
	Returns a unique render name for every call, which can
	be used with the `BindToRenderStep` method optionally.

	```lua
	shake:BindToRenderStep(Shake.NextRenderName(), ...)
	```
]=]
function Shake.NextRenderName(): string
	renderId += 1
	return ("__shake_%.4i__"):format(renderId)
end

--[=[
	Start the shake effect.

	:::note
	This **must** be called before calling `Update`. As such, it should also be
	called once before or after calling `OnSignal` or `BindToRenderStep` methods.
	:::
]=]
function Shake:Start()
	self._startTime = self.TimeFunction()
	self._running = true
end

--[=[
	Stops the shake effect. If using `OnSignal` or `BindToRenderStep`, those bound
	functions will be disconnected/unbound.

	`Stop` is automatically called when the shake effect is completed _or_ when the
	`Destroy` method is called.
]=]
function Shake:Stop()
	self._running = false

	for _, name in self._renderBindings do
		RunService:UnbindFromRenderStep(name)
	end
	table.clear(self._renderBindings)

	for _, conn in self._signalConnections do
		conn:Disconnect()
	end
	table.clear(self._signalConnections)
end

--[=[
	Returns `true` if the shake instance is currently running,
	otherwise returns `false`.
]=]
function Shake:IsShaking(): boolean
	return self._running
end

--[=[
	Schedules a sustained shake to stop. This works by setting the
	`Sustain` field to `false` and letting the shake effect fade out
	based on the `FadeOutTime` field.
]=]
function Shake:StopSustain()
	local now: number = self.TimeFunction() -- [W2 strict #2]
	self.Sustain = false
	self.SustainTime = (now - self._startTime) - self.FadeInTime
end

--[=[
	Calculates the current shake vector. This should be continuously
	called inside a loop, such as `RunService.Heartbeat`. Alternatively,
	`OnSignal` or `BindToRenderStep` can be used to automatically call
	this function.

	Returns a tuple of three values:
	1. `position: Vector3` - Position shake offset
	2. `rotation: Vector3` - Rotation shake offset
	3. `completed: boolean` - Flag indicating if the shake is finished

	```lua
	local hb
	hb = RunService.Heartbeat:Connect(function()
		local offsetPosition, offsetRotation, isDone = shake:Update()
		if isDone then
			hb:Disconnect()
		end
		-- Use `offsetPosition` and `offsetRotation` here
	end)
	```
]=]
function Shake:Update(): (Vector3, Vector3, boolean)
	local done = false

	local now: number = self.TimeFunction() -- [W2 strict #3]
	local dur = now - self._startTime

	local noiseInput = ((now + self._timeOffset) / self.Frequency) % 10000

	local multiplierFadeIn = 1
	local multiplierFadeOut = 1
	if dur < self.FadeInTime then
		-- Fade in
		multiplierFadeIn = dur / self.FadeInTime
	end
	if not self.Sustain and dur > self.FadeInTime + self.SustainTime then
		if self.FadeOutTime == 0 then
			done = true
		else
			-- Fade out
			multiplierFadeOut = 1 - (dur - self.FadeInTime - self.SustainTime) / self.FadeOutTime
			if not self.Sustain and dur >= self.FadeInTime + self.SustainTime + self.FadeOutTime then
				done = true
			end
		end
	end

	local offset = Vector3.new(
		math.noise(noiseInput, 0) / 2,
		math.noise(0, noiseInput) / 2,
		math.noise(noiseInput, noiseInput) / 2
	) * self.Amplitude * math.min(multiplierFadeIn, multiplierFadeOut)

	if done then
		self:Stop()
	end

	return (self.PositionInfluence :: Vector3) * offset, (self.RotationInfluence :: Vector3) * offset, done -- [W2 strict #4, #5]
end

--[=[
	@param signal Signal | RBXScriptSignal
	@param callbackFn UpdateCallbackFn
	@return Connection | RBXScriptConnection

	Bind the `Update` method to a signal. For instance, this can be used
	to connect to `RunService.Heartbeat`.

	All connections are cleaned up when the shake instance is stopped
	or destroyed.

	```lua
	local function SomeShake(pos: Vector3, rot: Vector3, completed: boolean)
		-- Shake
	end

	shake:OnSignal(RunService.Heartbeat, SomeShake)
	```
]=]
function Shake:OnSignal(signal, callbackFn: UpdateCallbackFn)
	local conn = signal:Connect(function()
		callbackFn(self:Update())
	end)

	table.insert(self._signalConnections, conn)

	return conn
end

--[=[
	@param name string -- Name passed to `RunService:BindToRenderStep`
	@param priority number -- Priority passed to `RunService:BindToRenderStep`
	@param callbackFn UpdateCallbackFn

	Bind the `Update` method to RenderStep.

	All bound functions are cleaned up when the shake instance is stopped
	or destroyed.

	```lua
	local renderPriority = Enum.RenderPriority.Camera.Value

	local function SomeShake(pos: Vector3, rot: Vector3, completed: boolean)
		-- Shake
	end

	shake:BindToRenderStep("SomeShake", renderPriority, SomeShake)
	```
]=]
function Shake:BindToRenderStep(name: string, priority: number, callbackFn: UpdateCallbackFn)
	RunService:BindToRenderStep(name, priority, function()
		callbackFn(self:Update())
	end)

	table.insert(self._renderBindings, name)
end

--[=[
	@return Shake
	Creates a new shake with identical properties as
	this one. This does _not_ clone over playing state,
	and thus the cloned instance will be in a stopped
	state.

	A use-case for using `Clone` would be to create a module
	with a list of shake presets. These presets can be cloned
	when desired for use. For instance, there might be presets
	for explosions, recoil, or earthquakes.

	```lua
	--------------------------------------
	-- Example preset module
	local ShakePresets = {}

	local explosion = Shake.new()
	-- Configure `explosion` shake here
	ShakePresets.Explosion = explosion

	return ShakePresets
	--------------------------------------

	-- Use the module:
	local ShakePresets = require(somewhere.ShakePresets)
	local explosionShake = ShakePresets.Explosion:Clone()
	```
]=]
function Shake:Clone()
	local shake = Shake.new()
	local cloneFields = {
		"Amplitude",
		"Frequency",
		"FadeInTime",
		"FadeOutTime",
		"SustainTime",
		"Sustain",
		"PositionInfluence",
		"RotationInfluence",
		"TimeFunction",
	}
	for _, field in cloneFields do
		shake[field] = self[field]
	end
	return shake
end

--[=[
	Alias for `Stop()`.
]=]
function Shake:Destroy()
	self:Stop()
end

return {
	new = Shake.new,
	InverseSquare = Shake.InverseSquare,
	NextRenderName = Shake.NextRenderName,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">Spring</string>
            <string name="Source"><![CDATA[--!strict
--[[ VENDORED (W2 CC-3): RbxUtil Spring v1.0.0 by Stephen Leitnick, MIT licence (see LICENSE beside this file and
	THIRD_PARTY_NOTICES.md at the repo root).
	Upstream: https://github.com/Sleitnick/RbxUtil  modules/spring/init.luau
	Source:   raw.githubusercontent.com, branch main @ 31f9120fca021e3dec275b42bc7047d626962082, fetched 2026-09-24
	          (byte-identical to the copy reviewed in scratchpad/gap/vend/spring.luau).
	Local changes: none (the upstream file is already --!strict; only this header was added).
]]

--[=[
	@class Spring

	Simulates a critically damped spring. This is mostly just a wrapper around
	[`TweenService:SmoothDamp()`](https://create.roblox.com/docs/reference/engine/classes/TweenService#SmoothDamp).
]=]

local TweenService = game:GetService("TweenService")

local Spring = {}
Spring.__index = Spring

export type Spring<T> = typeof(setmetatable(
	{} :: {
		Current: T,
		Target: T,
		Velocity: T,
		SmoothTime: number,
		MaxSpeed: number,
	},
	Spring
))

--[=[
	Creates a new spring.

	The type `T` can be a `number`, `Vector2`, `Vector3`, or `CFrame`.

	@param initial T -- Initial value
	@param smoothTime number -- Approximate time it takes to reach target
	@param maxSpeed number -- Maximum speed (defaults to infinity)
]=]
function Spring.new<T>(initial: T, smoothTime: number, maxSpeed: number?): Spring<T>
	local self = setmetatable({
		Current = initial,
		Target = initial,
		Velocity = if typeof(initial) == "CFrame" then CFrame.identity else (initial :: any) * 0,
		SmoothTime = smoothTime,
		MaxSpeed = if maxSpeed ~= nil then maxSpeed else math.huge,
	}, Spring)

	return self
end

--[=[
	@within Spring
	@method Update

	Updates the spring. This method should be called continuously, even if the target value hasn't changed.

	```lua
	local newValue = spring:Update(dt)
	```

	@param deltaTime number
	@return T
]=]
function Spring.Update<T>(self: Spring<T>, dt: number): T
	self.Current, self.Velocity =
		TweenService:SmoothDamp(self.Current, self.Target, self.Velocity, self.SmoothTime, self.MaxSpeed, dt)

	return self.Current
end

--[=[
	@within Spring
	@method Impulse

	Impulses the spring.

	```lua
	spring:Impulse(rng:NextUnitVector() * 10)
	```

	@param velocity T
]=]
function Spring.Impulse<T>(self: Spring<T>, velocity: T)
	self.Velocity += velocity :: any
end

--[=[
	@within Spring
	@method Reset

	Resets the spring to the given value.

	@param value T
]=]
function Spring.Reset<T>(self: Spring<T>, value: T)
	self.Current = value
	self.Target = value
	self.Velocity = if typeof(self.Current) == "CFrame" then CFrame.identity else (self.Current :: any) * 0
end

return Spring
]]></string>
          </Properties>
