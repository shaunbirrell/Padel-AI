			DoorWidth = 16,
			DoorHeight = 11,
			WallMaterial = Enum.Material.Metal,
			FrontWindowsX = {}, -- the open door leaves cover the facade
			WestWindowsZ = { -6, 6 },
			EastWindowsZ = { -6, 6 },
			RoofStyle = "Vault",
			RoofRise = 9,
			RoofPlant = false,
			Entrance = "HangarDoors",
			SignText = "VEHICLE DEPOT",
			Colors = {
