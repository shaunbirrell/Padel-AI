        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">SoldierConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Army + Training Yard worker income (MT-inspired: soldiers generate cash while "training").
	Visual: R15-ready config keys; catalog IDs live in VisualAssetConfig.Characters.
	If ModelAssetId missing/0 → military Part-kit placeholder (MapSetup.makeSoldierKit / CombatService).
]]

local SoldierConfig = {
	StartingSoldiers = 5,
	MaxSoldiersBase = 50,
	SoldiersPerBarracksLevel = 5,
	RecruitCostCash = 500,
	RecruitBatchSize = 1,
	DismissRefundMult = 0.25,
	SoldierHealth = 100,
	SoldierDamage = 12,
	SoldierSpeed = 14,

	-- Training Yard passive (owned soldiers → cash each tick)
	TrainingIncome = {
		TickSeconds = 5,
		CashPerSoldierPerTick = 8, -- 5 soldiers ≈ $8/s effective over tick (40/5s)
		MinSoldiersForIncome = 1,
	},

	--[[
		R15-ready visual path (Design Bot / Code P0).
		VisualKind maps → VisualAssetConfig.Characters[kind].
		VisualPlaceholder = Part-kit camo soldier when catalog ID is 0 / insert fails.
		Do NOT invent Creator Store IDs here — leave slots; wire in VisualAssetConfig only.
	]]
	Visual = {
		Rig = "R15", -- preferred attach target; Part kit remains R6-ish fallback proportions
		VisualKindDefault = "Soldier",
		VisualKindByRole = {
			Worker = "Soldier", -- v34: distinct ModelAssetId from Infantry
			Infantry = "Infantry",
			Heavy = "HeavyInfantry",
			Guard = "Guard",
			BankGuard = "BankGuard",
			OilRigGuard = "OilRigGuard",
			FortGuard = "FortGuard",
		},
		-- Placeholder palette when mesh missing (olive drab / desert camo)
		VisualPlaceholder = {
			Enabled = true,
			BodyColor = Color3.fromRGB(70, 85, 55),
			AccentColor = Color3.fromRGB(180, 220, 120),
			Helmet = true,
			Rifle = true,
			Note = "MapSetup.makeSoldierKit + CombatService Part kit until Design Bot mesh loads",
		},
		-- Optional future slots (TODO — no invented IDs)
		ModelAssetIdOverride = 0, -- 0 = use VisualAssetConfig.Characters
		AccessoryIds = {} :: { number }, -- TODO Design Bot
	},
}

return SoldierConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">SpinnerConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Free Supply Spinner — claim Cash/Gold every N hours (Settings / HUD).
	Fixed reward table (server picks index); not a paid loot box.
]]

local SpinnerConfig = {
	Enabled = true,
	CooldownSeconds = 4 * 3600, -- 4 hours
	DisplayName = "Supply Spinner",
	-- Weighted outcomes: Weight relative; server rolls once
	Rewards = {
		{ Id = "cash_small", DisplayName = "Cash Cache", Weight = 40, Cash = 5000, Gold = 0 },
		{ Id = "cash_med", DisplayName = "Cash Haul", Weight = 25, Cash = 12000, Gold = 0 },
		{ Id = "cash_big", DisplayName = "Cash Jackpot", Weight = 10, Cash = 25000, Gold = 0 },
		{ Id = "gold_small", DisplayName = "Gold Dust", Weight = 15, Cash = 2000, Gold = 2 },
		{ Id = "gold_med", DisplayName = "Gold Bar", Weight = 8, Cash = 5000, Gold = 5 },
		{ Id = "mixed", DisplayName = "Mixed Supply", Weight = 2, Cash = 15000, Gold = 8 },
	},
}

return SpinnerConfig
]]></string>
          </Properties>
        </Item>
