		VEHICLE_PURCHASED = "VEHICLE_PURCHASED",
		VEHICLE_SPAWNED = "VEHICLE_SPAWNED",
		FIRST_OUTPOST = "FIRST_OUTPOST",
		TERRITORY_CAPTURED = "TERRITORY_CAPTURED",
