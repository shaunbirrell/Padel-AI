			Description = "Eliminate 15 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 15,
			RewardCash = 3500,
			RewardXP = 90,
			RewardGold = 2,
			MinLevel = 1,
		},
		{
			Id = "DailyOpRecruit",
			DisplayName = "Daily Op: Muster",
			Description = "Recruit 10 soldiers at the Training Yard.",
			ObjectiveType = "RecruitSoldiers",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 70,
			RewardGold = 2,
			MinLevel = 1,
		},
	} :: { DailyOpDef },
}

return DailyOpsConfig
]]></string>
          </Properties>
