          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">ArmyController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Army panel — recruit/dismiss soldiers (key A / ARMY button). Server-authoritative. ]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)

local ArmyController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local open = false
local screenGui: ScreenGui? = nil
local statusLabel: TextLabel? = nil
local capFill: Frame? = nil
local capLabel: TextLabel? = nil
local armyState: any = nil

local function refreshLabels()
	if not statusLabel then
		return
	end
	if typeof(armyState) ~= "table" then
		statusLabel.Text = "No army data yet — wait for SoldierStateUpdate, or press A after join."
		return
	end
	local count = tonumber(armyState.Soldiers) or 0
	local cap = tonumber(armyState.MaxSoldiers) or 0
	local free = tonumber(armyState.SlotsFree) or math.max(0, cap - count)
	local cost = tonumber(armyState.RecruitCostCash) or 500
	local refundMult = tonumber(armyState.DismissRefundMult) or 0.25
	local barracks = tonumber(armyState.BarracksLevel) or 0
	if count == 0 and barracks == 0 then
		statusLabel.Text = string.format(
			"Army empty — buy Barracks (B) to raise cap.\nBase cap %d · Recruit $%d each\nTip: FILL CAP spends cash up to free slots.",
			cap,
			cost
		)
	else
		local trainTick = tonumber(armyState.TrainingIncomePerTick) or 0
		local trainSec = tonumber(armyState.TrainingIncomePerSec) or 0
		statusLabel.Text = string.format(
			"Soldiers: %d / %d  (%d free)\nBarracks Lv %d\nRecruit $%d each · Dismiss refund %d%%\nTraining Yard: +$%d/tick (~$%.1f/sec)",
			count,
			cap,
			free,
			barracks,
			cost,
			math.floor(refundMult * 100),
			trainTick,
			trainSec
		)
	end
	if capFill and cap > 0 then
		capFill.Size = UDim2.fromScale(math.clamp(count / cap, 0, 1), 1)
		capFill.BackgroundColor3 = if count >= cap then Constants.Colors.Danger else Constants.Colors.Accent
	end
	if capLabel then
		capLabel.Text = string.format("%d / %d", count, cap)
	end
end

local function setOpen(isOpen: boolean)
	open = isOpen
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = isOpen
		end
	end
end

function ArmyController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireArmy"
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, true)
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	screenGui = screen

	local inset = GuiService:GetGuiInset()
	local toggle = Instance.new("TextButton")
	toggle.Name = "ArmyToggle"
	toggle.AnchorPoint = Vector2.new(0, 1)
	toggle.Position = UDim2.new(0, 16, 1, -16 - inset.Y)
	toggle.Size = UDim2.fromOffset(88, 44)
	toggle.BackgroundColor3 = Constants.Colors.Gunmetal
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = 13
	toggle.TextColor3 = Constants.Colors.Gold
	toggle.Text = "ARMY"
	toggle.BorderSizePixel = 0
	toggle.Visible = false -- docked in HUD MobileActionBar
	UIUtil.Corner(toggle, 8)
	UIUtil.Stroke(toggle, Constants.Colors.Gold, 1.5)
	toggle.Parent = screen
	UIUtil.EnsureMinTouch(toggle, 44)
	toggle.Activated:Connect(function()
		setOpen(not open)
	end)

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.92, 0, 0.7, 0) else UDim2.fromOffset(380, 380)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screen
	UIUtil.Corner(panel, 10)
	UIUtil.Stroke(panel)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 10)
	title.Size = UDim2.new(1, -80, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Constants.Colors.Text
	title.Text = "Army"
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -12, 0, 10)
	close.Size = UDim2.fromOffset(32, 28)
	close.BackgroundColor3 = Constants.Colors.Background
	close.Font = Enum.Font.GothamBold
	close.Text = "X"
	close.TextColor3 = Constants.Colors.Text
	close.BorderSizePixel = 0
	UIUtil.Corner(close, 6)
	close.Parent = panel
	close.Activated:Connect(function()
		setOpen(false)
	end)

	statusLabel = Instance.new("TextLabel")
	statusLabel.BackgroundTransparency = 1
	statusLabel.Position = UDim2.fromOffset(16, 48)
	statusLabel.Size = UDim2.new(1, -32, 0, 88)
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.TextSize = 14
	statusLabel.TextWrapped = true
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.TextYAlignment = Enum.TextYAlignment.Top
	statusLabel.TextColor3 = Constants.Colors.Muted
	statusLabel.Text = "..."
	statusLabel.Parent = panel

	-- Cap bar
	local capBg = Instance.new("Frame")
	capBg.Position = UDim2.fromOffset(16, 142)
	capBg.Size = UDim2.new(1, -32, 0, 16)
	capBg.BackgroundColor3 = Constants.Colors.Background
	capBg.BorderSizePixel = 0
	capBg.Parent = panel
	UIUtil.Corner(capBg, 4)

	capFill = Instance.new("Frame")
	capFill.Size = UDim2.fromScale(0, 1)
	capFill.BackgroundColor3 = Constants.Colors.Accent
	capFill.BorderSizePixel = 0
	capFill.Parent = capBg
	UIUtil.Corner(capFill, 4)

	capLabel = Instance.new("TextLabel")
	capLabel.BackgroundTransparency = 1
	capLabel.Size = UDim2.fromScale(1, 1)
	capLabel.Font = Enum.Font.GothamBold
	capLabel.TextSize = 11
	capLabel.TextColor3 = Constants.Colors.Text
	capLabel.Text = "0 / 0"
	capLabel.Parent = capBg

	local function makeBtn(label: string, x: number, y: number, w: number, cb: () -> (), goldAccent: boolean?)
		local b = Instance.new("TextButton")
		b.Position = UDim2.fromOffset(x, y)
		b.Size = UDim2.fromOffset(w, 44)
		b.BackgroundColor3 = Constants.Colors.Gunmetal
		b.Font = Enum.Font.GothamBold
		b.TextSize = 12
		b.TextColor3 = if goldAccent then Constants.Colors.Gold else Constants.Colors.Text
		b.Text = label
		b.BorderSizePixel = 0
		UIUtil.Corner(b, 6)
		UIUtil.Stroke(b, Constants.Colors.Gold, 1.25)
		b.Parent = panel
		b.Activated:Connect(cb)
		return b
	end

	local recruit1 = makeBtn("RECRUIT x1 $500", 16, 174, 168, function()
		Remotes.GetEvent(Constants.RemoteNames.RequestRecruitSoldiers):FireServer(1)
	end, true)
	local recruit5 = makeBtn("RECRUIT x5", 192, 174, 168, function()
		Remotes.GetEvent(Constants.RemoteNames.RequestRecruitSoldiers):FireServer(5)
	end, true)
	makeBtn("FILL CAP", 16, 228, 168, function()
		local free = if typeof(armyState) == "table" then tonumber(armyState.SlotsFree) or 0 else 0
		if free > 0 then
			Remotes.GetEvent(Constants.RemoteNames.RequestRecruitSoldiers):FireServer(math.min(free, 50))
		end
	end)
	makeBtn("DISMISS x1", 192, 228, 168, function()
		Remotes.GetEvent(Constants.RemoteNames.RequestDismissSoldiers):FireServer(1)
	end)
	makeBtn("DISMISS x5", 16, 282, 168, function()
		Remotes.GetEvent(Constants.RemoteNames.RequestDismissSoldiers):FireServer(5)
	end)

	-- Keep recruit labels priced
	local prevRefresh = refreshLabels
	refreshLabels = function()
		prevRefresh()
		local cost = if typeof(armyState) == "table" then tonumber(armyState.RecruitCostCash) or 500 else 500
		if recruit1 then
			recruit1.Text = string.format("RECRUIT x1 $%d", cost)
		end
		if recruit5 then
			recruit5.Text = string.format("RECRUIT x5 $%d", cost * 5)
		end
	end

	local note = Instance.new("TextLabel")
	note.BackgroundTransparency = 1
	note.Position = UDim2.fromOffset(16, 336)
	note.Size = UDim2.new(1, -32, 0, 28)
	note.Font = Enum.Font.Gotham
	note.TextSize = 11
	note.TextWrapped = true
	note.TextXAlignment = Enum.TextXAlignment.Left
	note.TextColor3 = Constants.Colors.Muted
	note.Text = "Training Yard pays cash/sec from owned soldiers. Barracks raises cap. Key A."
	note.Parent = panel

	Remotes.GetEvent(Constants.RemoteNames.SoldierStateUpdate).OnClientEvent:Connect(function(payload)
		armyState = payload
		refreshLabels()
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.A then
			setOpen(not open)
		end
	end)
end


function ArmyController.Toggle()
	setOpen(not open)
end

function ArmyController.Open()
	setOpen(true)
end

function ArmyController.Close()
	setOpen(false)
end

function ArmyController.IsOpen(): boolean
	return open
end

return ArmyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">BaseController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Upgrade menu UI → RequestPurchaseUpgrade remote.
	B toggles the panel (respects gameProcessed / chat).
	Primary buy path: WALK onto upgrade pads (WorldPromptController).
	Menu BUY buttons remain as an alternate purchase path.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)

local NotificationController = require(script.Parent.NotificationController)

local BaseController = {}

local player = Players.LocalPlayer
local upgrades: { [string]: number } = {}
local cash = 0
local menuOpen = false
local screenGui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local toggleBtn: TextButton? = nil
local hintShown = false

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function refreshList()
	if not listFrame then
		return
	end
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local layout = listFrame:FindFirstChildOfClass("UIListLayout")
	if not layout then
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = listFrame
	end

	for order, structureId in ipairs(BaseConfig.StructureOrder) do
		local def = BaseConfig.Structures[structureId]
		if def then
			local level = upgrades[structureId] or 0
			local nextLevel = level + 1
			local cost = if nextLevel <= def.MaxLevel then def.Costs[nextLevel] else nil

			local row = Instance.new("Frame")
			row.Name = structureId
			row.Size = UDim2.new(1, -8, 0, 60)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = order
			row.Parent = listFrame
			corner(row, 6)

			-- Highlight first purchasable row (Command Center) when still L0
			if structureId == "CommandCenter" and level == 0 then
				local stroke = Instance.new("UIStroke")
				stroke.Color = Constants.Colors.Gold
				stroke.Thickness = 2
				stroke.Parent = row
			end

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromOffset(8, 4)
			title.Size = UDim2.new(1, -110, 0, 22)
			title.Font = Enum.Font.GothamBold
			title.TextSize = 14
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.TextColor3 = Constants.Colors.Text
			title.Text = string.format("%s  Lv%d/%d", def.DisplayName, level, def.MaxLevel)
			title.Parent = row

			local desc = Instance.new("TextLabel")
			desc.BackgroundTransparency = 1
			desc.Position = UDim2.fromOffset(8, 28)
			desc.Size = UDim2.new(1, -110, 0, 20)
			desc.Font = Enum.Font.Gotham
			desc.TextSize = 11
			desc.TextXAlignment = Enum.TextXAlignment.Left
			desc.TextColor3 = Constants.Colors.Muted
			desc.Text = def.Description
			desc.TextTruncate = Enum.TextTruncate.AtEnd
			desc.Parent = row

			local btn = Instance.new("TextButton")
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -8, 0.5, 0)
			btn.Size = UDim2.fromOffset(108, 44)
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = 12
			btn.TextColor3 = Constants.Colors.Text
			btn.AutoButtonColor = true
			btn.BorderSizePixel = 0
			corner(btn, 6)

			if not cost then
				btn.Text = "MAX"
				btn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
				btn.Active = false
			else
				-- Clear BUY path — not instant on B; tap this button to purchase.
				local rates = EconomyConfig.PassiveIncome and EconomyConfig.PassiveIncome.PerLevelRates
				local rate = if typeof(rates) == "table" then (tonumber(rates[structureId]) or 0) else 0
				local incomeSuffix = if rate > 0 then (" +" .. tostring(rate) .. "/t") else ""
				-- Wider button when income shown
				if rate > 0 then
					btn.Size = UDim2.fromOffset(128, 44)
				end
				if level == 0 then
					btn.Text = "BUY $" .. tostring(cost) .. incomeSuffix
				else
					btn.Text = "UP $" .. tostring(cost) .. incomeSuffix
				end
				local canAfford = cash >= cost
				btn.BackgroundColor3 = if canAfford then Constants.Colors.Accent else Color3.fromRGB(70, 50, 50)
				btn.Active = true
				btn.Activated:Connect(function()
					print(string.format("[WAR EMPIRE] Base menu BUY: %s cost=%s cash=%d rate=+%d/tick", structureId, tostring(cost), cash, rate))
					if cash < cost then
						NotificationController.Show("Not enough cash — need $" .. tostring(cost), "Warn", 2.5)
						print("[WAR EMPIRE] Base menu BUY soft-fail cash", structureId)
					else
						NotificationController.Show("Buying " .. def.DisplayName .. "…", "Info", 1.5)
					end
					Remotes.GetEvent(Constants.RemoteNames.RequestPurchaseUpgrade):FireServer({
						StructureId = structureId,
					} :: Types.PurchaseUpgradeRequest)
				end)
			end
			btn.Parent = row
		end
	end

	local l = listFrame:FindFirstChildOfClass("UIListLayout")
	if l then
		listFrame.CanvasSize = UDim2.fromOffset(0, l.AbsoluteContentSize.Y + 12)
	end
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("UpgradePanel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
	if toggleBtn then
		local touch = UserInputService.TouchEnabled
		if open then
			toggleBtn.Text = "Close Base"
		else
			toggleBtn.Text = if touch then "BASE UPGRADES" else "Base Upgrades  [B]"
		end
		toggleBtn.Visible = true
	end
	if open then
		refreshList()
	end
end

local function flashToggle()
	if not toggleBtn then
		return
	end
	local btn = toggleBtn
	local baseColor = Constants.Colors.Accent
	btn.BackgroundColor3 = Constants.Colors.Gold
	local tw = TweenService:Create(
		btn,
		TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 5, true),
		{ BackgroundColor3 = baseColor }
	)
	tw:Play()
	task.delay(6, function()
		if toggleBtn == btn then
			tw:Cancel()
			btn.BackgroundColor3 = Constants.Colors.Accent
		end
	end)
end

local function showFirstJoinHints()
	if hintShown then
		return
	end
	hintShown = true
	-- Session-once onboarding after MapSetup world is up
	task.delay(1.4, function()
		NotificationController.Show(
			"Walk to glowing pads to buy · B/G menus",
			"Info",
			6
		)
	end)
	task.delay(7.5, function()
		NotificationController.Show(
			"Prices float above pads · Base [B] · Garage [G] / E on pads",
			"Info",
			5
		)
	end)
	flashToggle()
end

function BaseController.Open()
	setOpen(true)
end

function BaseController.Close()
	setOpen(false)
end

function BaseController.Toggle()
	setOpen(not menuOpen)
end

function BaseController.IsOpen(): boolean
	return menuOpen
end

function BaseController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "WarEmpireBaseUI"
	-- Above default chat / touch controls so mobile Base CTA stays tappable
	gui.DisplayOrder = 58 -- above HUD dock (55); CTA parked left of dock so no click steal
	gui.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(gui, false)
	screenGui = gui

	local touch = UserInputService.TouchEnabled
	-- CRITICAL: do NOT park Base CTA over the right action dock (Shop/Rebirth/…).
	-- Mobile → bottom-LEFT above currency pill; desktop → bottom-center (dock is right-only).
	local btnW = if touch then 168 else 260
	local btnH = if touch then 52 else 56

	local btn = Instance.new("TextButton")
	btn.Name = "ToggleUpgrades"
	if touch then
		btn.AnchorPoint = Vector2.new(0, 1)
		btn.Position = UDim2.new(0, 16, 1, -176)
	else
		btn.AnchorPoint = Vector2.new(0.5, 1)
		btn.Position = UDim2.new(0.5, 0, 1, -28)
	end
	btn.Size = UDim2.fromOffset(btnW, btnH)
	btn.BackgroundColor3 = Constants.Colors.Accent
	btn.TextColor3 = Constants.Colors.Text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = if touch then 15 else 18
	btn.Text = if touch then "BASE [B]" else "Base Upgrades  [B]"
	btn.BorderSizePixel = 0
	btn.ZIndex = 20
	btn.Visible = true
	btn.Active = true
	btn.AutoButtonColor = true
	corner(btn, 10)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Constants.Colors.Gold
	stroke.Thickness = 2
	stroke.Parent = btn
	btn.Parent = gui
	toggleBtn = btn
	UIUtil.EnsureMinTouch(btn, 48)
	btn.Activated:Connect(function()
		print("[WAR EMPIRE] Base CTA toggled →", not menuOpen)
		setOpen(not menuOpen)
	end)

	if touch then
		task.defer(function()
			local inset = GuiService:GetGuiInset()
			local extra = math.clamp(inset.Y * 0.15, 0, 24)
			btn.Position = UDim2.new(0, 16, 1, -(176 + extra))
			btn.Visible = true
			btn.Active = true
		end)
	end

	local panel = Instance.new("Frame")
	panel.Name = "UpgradePanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.48)
	panel.Size = UDim2.fromOffset(440, 440)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 10)
	do
		local ps = Instance.new("UIStroke")
		ps.Color = Constants.Colors.Gold
		ps.Thickness = 1.5
		ps.Transparency = 0.4
		ps.Parent = panel
	end

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 10)
	title.Size = UDim2.new(1, -28, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextColor3 = Constants.Colors.Text
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "BASE UPGRADES"
	title.Parent = panel

	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromOffset(14, 36)
	sub.Size = UDim2.new(1, -28, 0, 18)
	sub.Font = Enum.Font.Gotham
	sub.TextSize = 12
	sub.TextColor3 = Constants.Colors.Muted
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.Text = "Walk/tap BUY on pads · B menu · +$/tick shown"
	sub.Parent = panel

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(10, 58)
	scroll.Size = UDim2.new(1, -20, 1, -68)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = panel
	listFrame = scroll

	Remotes.GetEvent(Constants.RemoteNames.BaseStateUpdate).OnClientEvent:Connect(function(base: Types.BaseStatePayload)
		upgrades = base.Upgrades or upgrades
		if menuOpen then
			refreshList()
		end
	end)

	Remotes.GetEvent(Constants.RemoteNames.EconomyUpdate).OnClientEvent:Connect(function(payload: Types.EconomyUpdatePayload)
		cash = payload.Cash
		if menuOpen then
			refreshList()
		end
	end)

	Remotes.GetEvent(Constants.RemoteNames.PlayerStateUpdate).OnClientEvent:Connect(function(state: Types.PlayerStatePayload)
		cash = state.Cash
		if state.Base then
			upgrades = state.Base.Upgrades
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		-- Respect chat / processed UI (gp true while typing in chat).
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			setOpen(not menuOpen)
		end
	end)

	showFirstJoinHints()
	print("[WAR EMPIRE] BaseController ready (CTA clear of dock, BUY via Activated)")
end

return BaseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Phase 3/7 — client combat input + HUD (health, ammo, weapon, mobile fire/reload/swap).
	Sends fire/reload/equip requests only — never damage amounts.
	Mobile: large FIRE + RELOAD + weapon swap, center reticle, low-ammo tint,
	hit marker, panels lifted clear of dock / pad BUY.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)
local WeaponConfig = require(Shared.Configs.WeaponConfig)

local CombatController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled

local healthFill: Frame? = nil
local healthText: TextLabel? = nil
local ammoLabel: TextLabel? = nil
local weaponLabel: TextLabel? = nil
local hitFlash: Frame? = nil
local hitMarker: Frame? = nil
local reticle: Frame? = nil
local lowAmmoHint: TextLabel? = nil

local currentWeaponId: string? = nil
local ammo = 0
local magazineSize = 0
local reloading = false
local alive = true
local firing = false

local requestFire: () -> ()
local requestReload: () -> ()
local cycleWeapon: (delta: number) -> ()

local function addCorner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function addStroke(parent: Instance, color: Color3?, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(55, 65, 55)
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

local function buildHud()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireCombatHUD"
	screen.Parent = player:WaitForChild("PlayerGui")
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = false
	screen.DisplayOrder = 30 -- below HUD dock (55) so dock clicks win
	UIUtil.AttachMobileScale(screen, 800, 0.7, 1.15)

	-- Center reticle (aim assist visual — camera center)
	local ret = Instance.new("Frame")
	ret.Name = "Reticle"
	ret.AnchorPoint = Vector2.new(0.5, 0.5)
	ret.Position = UDim2.fromScale(0.5, 0.48)
	ret.Size = UDim2.fromOffset(if isTouch then 22 else 16, if isTouch then 22 else 16)
	ret.BackgroundTransparency = 1
	ret.ZIndex = 15
	ret.Active = false
	ret.Parent = screen
	reticle = ret
	local function arm(dx: number, dy: number, w: number, h: number)
		local a = Instance.new("Frame")
		a.AnchorPoint = Vector2.new(0.5, 0.5)
		a.Position = UDim2.new(0.5, dx, 0.5, dy)
		a.Size = UDim2.fromOffset(w, h)
		a.BackgroundColor3 = Color3.fromRGB(235, 240, 220)
		a.BackgroundTransparency = 0.15
		a.BorderSizePixel = 0
		a.Active = false
		a.ZIndex = 16
		a.Parent = ret
	end
	local gap = if isTouch then 6 else 4
	local thick = if isTouch then 3 else 2
	local len = if isTouch then 8 else 6
	arm(0, -(gap + len / 2), thick, len)
	arm(0, gap + len / 2, thick, len)
	arm(-(gap + len / 2), 0, len, thick)
	arm(gap + len / 2, 0, len, thick)
	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(3, 3)
	dot.BackgroundColor3 = Constants.Colors.Gold
	dot.BorderSizePixel = 0
	dot.Active = false
	dot.ZIndex = 17
	dot.Parent = ret
	addCorner(dot, 2)

	-- Hit marker (X) at reticle — brief on Hit/Kill
	local marker = Instance.new("Frame")
	marker.Name = "HitMarker"
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Position = UDim2.fromScale(0.5, 0.48)
	marker.Size = UDim2.fromOffset(28, 28)
	marker.BackgroundTransparency = 1
	marker.Visible = false
	marker.ZIndex = 18
	marker.Active = false
	marker.Parent = screen
	hitMarker = marker
	for _, rot in ipairs({ 45, -45 }) do
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.fromOffset(22, 3)
		bar.BackgroundColor3 = Color3.fromRGB(255, 230, 80)
		bar.BorderSizePixel = 0
		bar.Rotation = rot
		bar.Active = false
		bar.ZIndex = 19
		bar.Parent = marker
	end

	-- Health — lifted on mobile so it clears pad BUY (~-108) and capture bar
	local healthPanel = Instance.new("Frame")
	healthPanel.Name = "HealthPanel"
	healthPanel.AnchorPoint = Vector2.new(0.5, 1)
	healthPanel.Position = UDim2.new(0.5, 0, 1, if isTouch then -188 else -20)
	healthPanel.Size = UDim2.fromOffset(if isTouch then 300 else 280, if isTouch then 40 else 36)
	healthPanel.BackgroundColor3 = Constants.Colors.Panel
	healthPanel.BackgroundTransparency = 0.15
	healthPanel.BorderSizePixel = 0
	healthPanel.Parent = screen
	addCorner(healthPanel, 8)
	addStroke(healthPanel)

	local hpBg = Instance.new("Frame")
	hpBg.Position = UDim2.fromOffset(8, 8)
	hpBg.Size = UDim2.new(1, -16, 0, if isTouch then 24 else 20)
	hpBg.BackgroundColor3 = Constants.Colors.Background
	hpBg.BorderSizePixel = 0
	hpBg.Parent = healthPanel
	addCorner(hpBg, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Constants.Colors.Health
	fill.BorderSizePixel = 0
	fill.Parent = hpBg
	addCorner(fill, 4)
	healthFill = fill

	local hpText = Instance.new("TextLabel")
	hpText.BackgroundTransparency = 1
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.Font = Enum.Font.GothamBold
	hpText.TextSize = if isTouch then 13 else 12
	hpText.TextColor3 = Constants.Colors.Text
	hpText.Text = "100 / 100"
	hpText.Parent = hpBg
	healthText = hpText

	-- Weapon / ammo (bottom right) — clear of dock (~80) + fire cluster
	local weaponPanel = Instance.new("Frame")
	weaponPanel.Name = "WeaponPanel"
	weaponPanel.AnchorPoint = Vector2.new(1, 1)
	weaponPanel.Position = UDim2.new(1, -16, 1, if isTouch then -280 else -20)
	weaponPanel.Size = UDim2.fromOffset(if isTouch then 210 else 200, if isTouch then 64 else 56)
	weaponPanel.BackgroundColor3 = Constants.Colors.Panel
	weaponPanel.BackgroundTransparency = 0.15
	weaponPanel.BorderSizePixel = 0
	weaponPanel.Parent = screen
	addCorner(weaponPanel, 8)
	addStroke(weaponPanel)

	local wName = Instance.new("TextLabel")
	wName.BackgroundTransparency = 1
	wName.Position = UDim2.fromOffset(10, 6)
	wName.Size = UDim2.new(1, -20, 0, 20)
	wName.Font = Enum.Font.GothamBold
	wName.TextSize = if isTouch then 15 else 14
	wName.TextXAlignment = Enum.TextXAlignment.Right
	wName.TextColor3 = Constants.Colors.Text
	wName.Text = "—"
	wName.Parent = weaponPanel
	weaponLabel = wName

	local ammoLbl = Instance.new("TextLabel")
	ammoLbl.BackgroundTransparency = 1
	ammoLbl.Position = UDim2.fromOffset(10, if isTouch then 30 else 28)
	ammoLbl.Size = UDim2.new(1, -20, 0, 24)
	ammoLbl.Font = Enum.Font.GothamMedium
	ammoLbl.TextSize = if isTouch then 18 else 16
	ammoLbl.TextXAlignment = Enum.TextXAlignment.Right
	ammoLbl.TextColor3 = Constants.Colors.Ammo
	ammoLbl.Text = "0 / 0"
	ammoLbl.Parent = weaponPanel
	ammoLabel = ammoLbl

	local lowHint = Instance.new("TextLabel")
	lowHint.Name = "LowAmmo"
	lowHint.BackgroundTransparency = 1
	lowHint.AnchorPoint = Vector2.new(1, 1)
	lowHint.Position = UDim2.new(1, -16, 1, if isTouch then -348 else -80)
	lowHint.Size = UDim2.fromOffset(160, 18)
	lowHint.Font = Enum.Font.GothamBold
	lowHint.TextSize = 12
	lowHint.TextXAlignment = Enum.TextXAlignment.Right
	lowHint.TextColor3 = Color3.fromRGB(255, 140, 80)
	lowHint.Text = ""
	lowHint.Visible = false
	lowHint.Parent = screen
	lowAmmoHint = lowHint

	-- Hit flash — MUST NOT sink clicks (full-screen overlay)
	local flash = Instance.new("Frame")
	flash.Name = "HitFlash"
	flash.BackgroundColor3 = Constants.Colors.Danger
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 20
	flash.Active = false
	flash.Parent = screen
	hitFlash = flash

	-- Mobile combat cluster (right side, above dock)
	if isTouch then
		local fireBtn = Instance.new("TextButton")
		fireBtn.Name = "FireButton"
		fireBtn.AnchorPoint = Vector2.new(1, 1)
		fireBtn.Position = UDim2.new(1, -16, 1, -100)
		fireBtn.Size = UDim2.fromOffset(84, 84)
		fireBtn.BackgroundColor3 = Constants.Colors.Danger
		fireBtn.BackgroundTransparency = 0.15
		fireBtn.Text = "FIRE"
		fireBtn.Font = Enum.Font.GothamBold
		fireBtn.TextSize = 18
		fireBtn.TextColor3 = Constants.Colors.Text
		fireBtn.AutoButtonColor = true
		fireBtn.Active = true
		fireBtn.ZIndex = 25
		fireBtn.Parent = screen
		addCorner(fireBtn, 42)
		addStroke(fireBtn, Color3.fromRGB(255, 200, 200), 2)
		UIUtil.EnsureMinTouch(fireBtn, 72)

		fireBtn.MouseButton1Down:Connect(function()
			firing = true
		end)
		fireBtn.MouseButton1Up:Connect(function()
			firing = false
		end)
		fireBtn.InputEnded:Connect(function()
			firing = false
		end)
		-- Touch leave / cancel
		local reloadBtn = Instance.new("TextButton")
		reloadBtn.Name = "ReloadButton"
		reloadBtn.AnchorPoint = Vector2.new(1, 1)
		reloadBtn.Position = UDim2.new(1, -110, 1, -108)
		reloadBtn.Size = UDim2.fromOffset(64, 64)
		reloadBtn.BackgroundColor3 = Constants.Colors.Gunmetal
		reloadBtn.Text = "R"
		reloadBtn.Font = Enum.Font.GothamBold
		reloadBtn.TextSize = 22
		reloadBtn.TextColor3 = Constants.Colors.Ammo
		reloadBtn.AutoButtonColor = true
		reloadBtn.Active = true
		reloadBtn.ZIndex = 25
		reloadBtn.Parent = screen
		addCorner(reloadBtn, 16)
		addStroke(reloadBtn, Constants.Colors.Gold, 1.5)
		UIUtil.EnsureMinTouch(reloadBtn, 56)
		reloadBtn.Activated:Connect(function()
			requestReload()
		end)

		local prevBtn = Instance.new("TextButton")
		prevBtn.Name = "WeaponPrev"
		prevBtn.AnchorPoint = Vector2.new(1, 1)
		prevBtn.Position = UDim2.new(1, -184, 1, -108)
		prevBtn.Size = UDim2.fromOffset(52, 52)
		prevBtn.BackgroundColor3 = Constants.Colors.GunmetalLight
		prevBtn.Text = "◀"
		prevBtn.Font = Enum.Font.GothamBold
		prevBtn.TextSize = 18
		prevBtn.TextColor3 = Constants.Colors.Text
		prevBtn.AutoButtonColor = true
		prevBtn.ZIndex = 25
		prevBtn.Parent = screen
		addCorner(prevBtn, 12)
		UIUtil.EnsureMinTouch(prevBtn, 48)
		prevBtn.Activated:Connect(function()
			cycleWeapon(-1)
		end)

		local nextBtn = Instance.new("TextButton")
		nextBtn.Name = "WeaponNext"
		nextBtn.AnchorPoint = Vector2.new(1, 1)
		nextBtn.Position = UDim2.new(1, -184, 1, -168)
		nextBtn.Size = UDim2.fromOffset(52, 52)
		nextBtn.BackgroundColor3 = Constants.Colors.GunmetalLight
		nextBtn.Text = "▶"
		nextBtn.Font = Enum.Font.GothamBold
		nextBtn.TextSize = 18
		nextBtn.TextColor3 = Constants.Colors.Text
		nextBtn.AutoButtonColor = true
		nextBtn.ZIndex = 25
		nextBtn.Parent = screen
		addCorner(nextBtn, 12)
		UIUtil.EnsureMinTouch(nextBtn, 48)
		nextBtn.Activated:Connect(function()
			cycleWeapon(1)
		end)
	else
		-- Desktop still gets a small optional fire hint (hidden)
		local fireBtn = Instance.new("TextButton")
		fireBtn.Name = "FireButton"
		fireBtn.Visible = false
		fireBtn.Parent = screen
	end
end

local function refreshAmmoLabel()
	if not ammoLabel then
		return
	end
	if reloading then
		ammoLabel.Text = "RELOADING..."
		ammoLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		if lowAmmoHint then
			lowAmmoHint.Visible = false
		end
		return
	end
	ammoLabel.Text = string.format("%d / %d", ammo, magazineSize)
	local low = magazineSize > 0 and ammo <= math.max(1, math.floor(magazineSize * 0.25))
	local empty = ammo <= 0
	if empty then
		ammoLabel.TextColor3 = Constants.Colors.Danger
		if lowAmmoHint then
			lowAmmoHint.Text = "EMPTY — tap R / RELOAD"
			lowAmmoHint.Visible = true
		end
	elseif low then
		ammoLabel.TextColor3 = Color3.fromRGB(255, 160, 70)
		if lowAmmoHint then
			lowAmmoHint.Text = "LOW AMMO"
			lowAmmoHint.Visible = true
		end
	else
		ammoLabel.TextColor3 = Constants.Colors.Ammo
		if lowAmmoHint then
			lowAmmoHint.Visible = false
		end
	end
end

local function applyState(payload: Types.CombatStatePayload)
	alive = payload.Alive
	ammo = payload.Ammo
	magazineSize = payload.MagazineSize
	reloading = payload.Reloading
	currentWeaponId = payload.WeaponId

	if healthFill and payload.MaxHealth > 0 then
		local ratio = math.clamp(payload.Health / payload.MaxHealth, 0, 1)
		healthFill.Size = UDim2.fromScale(ratio, 1)
		-- Tint redder when critical
		if ratio <= 0.25 then
			healthFill.BackgroundColor3 = Color3.fromRGB(220, 40, 40)
		elseif ratio <= 0.5 then
			healthFill.BackgroundColor3 = Color3.fromRGB(210, 120, 50)
		else
			healthFill.BackgroundColor3 = Constants.Colors.Health
		end
	end
	if healthText then
		healthText.Text = string.format("%d / %d", math.floor(payload.Health), math.floor(payload.MaxHealth))
	end
	if weaponLabel then
		if payload.WeaponId and WeaponConfig.Weapons[payload.WeaponId] then
			weaponLabel.Text = WeaponConfig.Weapons[payload.WeaponId].DisplayName
		else
			weaponLabel.Text = payload.WeaponId or "—"
		end
	end
	if reticle then
		reticle.Visible = alive and not reloading
	end
	refreshAmmoLabel()
end

local function flashFeedback(kind: string)
	if hitFlash then
		local isOutgoing = kind == "Hit" or kind == "Kill"
		hitFlash.BackgroundColor3 = if isOutgoing then Color3.fromRGB(220, 210, 100) else Constants.Colors.Danger
		hitFlash.BackgroundTransparency = if isOutgoing then 0.85 else 0.55
		task.delay(0.08, function()
			if hitFlash then
				hitFlash.BackgroundTransparency = 1
			end
		end)
	end
	if hitMarker and (kind == "Hit" or kind == "Kill") then
		hitMarker.Visible = true
		for _, child in ipairs(hitMarker:GetChildren()) do
			if child:IsA("Frame") then
				child.BackgroundColor3 = if kind == "Kill"
					then Color3.fromRGB(255, 90, 70)
					else Color3.fromRGB(255, 230, 80)
			end
		end
		task.delay(0.12, function()
			if hitMarker then
				hitMarker.Visible = false
			end
		end)
	end
end

local function aimRay(): (Vector3, Vector3)
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local fallbackOrigin = if root then root.Position + Vector3.new(0, 1.5, 0) else Vector3.new(0, 5, 0)

	local cam = Workspace.CurrentCamera
	if cam then
		local vp = cam.ViewportSize
		local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		return ray.Origin, ray.Direction.Unit
	end
	return fallbackOrigin, Vector3.new(0, 0, -1)
end

requestFire = function()
	if not alive or reloading or ammo <= 0 then
		return
	end

	local origin, direction = aimRay()
	local payload: Types.FireRequestPayload = {
		Direction = direction,
		Origin = origin,
		TargetUserId = nil,
		TargetNpcId = nil,
		HitPosition = nil,
	}

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = player.Character
	if character then
		params.FilterDescendantsInstances = { character }
	end
	local result = Workspace:Raycast(origin, direction * 500, params)
	if result then
		payload.HitPosition = result.Position
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local other = Players:GetPlayerFromCharacter(model)
			if other then
				payload.TargetUserId = other.UserId
			else
				local npcId = model:GetAttribute("NPCId")
				if typeof(npcId) == "string" then
					payload.TargetNpcId = npcId
				end
			end
		end
	end

	Remotes.GetEvent(Constants.RemoteNames.RequestFire):FireServer(payload)
end

requestReload = function()
	Remotes.GetEvent(Constants.RemoteNames.RequestReload):FireServer()
end

local function requestEquip(weaponId: string)
	Remotes.GetEvent(Constants.RemoteNames.RequestEquipWeapon):FireServer(weaponId)
end

cycleWeapon = function(delta: number)
	local ids: { string } = {}
	for id in pairs(WeaponConfig.Weapons) do
		table.insert(ids, id)
	end
	table.sort(ids)
	if #ids == 0 then
		return
	end
	local idx = 1
	for i, id in ipairs(ids) do
		if id == currentWeaponId then
			idx = i
			break
		end
	end
	idx = ((idx - 1 + delta) % #ids) + 1
	requestEquip(ids[idx])
end

function CombatController.Init()
	buildHud()

	Remotes.GetEvent(Constants.RemoteNames.CombatStateUpdate).OnClientEvent:Connect(function(payload: Types.CombatStatePayload)
		applyState(payload)
	end)

	Remotes.GetEvent(Constants.RemoteNames.CombatHitFeedback).OnClientEvent:Connect(function(payload: Types.CombatHitFeedbackPayload)
		flashFeedback(payload.Kind)
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or GuiService.MenuIsOpen then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			firing = true
			requestFire()
		elseif input.KeyCode == Enum.KeyCode.R then
			requestReload()
		elseif input.KeyCode == Enum.KeyCode.Q then
			cycleWeapon(-1)
		elseif input.KeyCode == Enum.KeyCode.E then
			-- E is also used by WorldPrompt for proximity — only cycle when not over Gui
			cycleWeapon(1)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			firing = false
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.05)
			if firing then
				requestFire()
			end
		end
	end)
end

return CombatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">CompassController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Lightweight compass: direction + distance to own base and nearest unowned territory. ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local UIUtil = require(Shared.Util.UIUtil)

local CompassController = {}

local player = Players.LocalPlayer
local myPlotId: number? = nil
local territoryOwners: { [string]: { OwnerType: string, OwnerUserId: number } } = {}

local baseLabel: TextLabel? = nil
local outpostLabel: TextLabel? = nil
local accum = 0

local CARDINAL_LABELS = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }

local function bearingLabel(from: Vector3, to: Vector3, look: Vector3): string
	local dir = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if dir.Magnitude < 1 then
		return "•"
	end
	dir = dir.Unit
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	if lookFlat.Magnitude < 0.05 then
		lookFlat = Vector3.new(0, 0, -1)
	else
		lookFlat = lookFlat.Unit
	end
	-- Relative bearing vs camera look (0 = ahead)
	local worldAngle = math.deg(math.atan2(dir.X, -dir.Z)) % 360
	local lookAngle = math.deg(math.atan2(lookFlat.X, -lookFlat.Z)) % 360
	local relative = (worldAngle - lookAngle + 360) % 360
	local idx = (math.floor((relative + 22.5) / 45) % 8) + 1
	return CARDINAL_LABELS[idx] or "N"
end

local function formatDist(studs: number): string
	if studs < 1000 then
		return string.format("%dm", math.floor(studs))
	end
	return string.format("%.1fkm", studs / 1000)
end

local function getRoot(): (Vector3?, Vector3?)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil, nil
	end
	local cam = Workspace.CurrentCamera
	local look = if cam then cam.CFrame.LookVector else hrp.CFrame.LookVector
	return hrp.Position, look
end

local function baseWorldPos(): Vector3?
	if typeof(myPlotId) ~= "number" then
		return nil
	end
	local pos = BaseConfig.PlotPositions[myPlotId]
	if pos then
		return pos
	end
	return nil
end

local function nearestUnowned(from: Vector3): (string?, Vector3?, number?)
	local bestId: string? = nil
	local bestPos: Vector3? = nil
	local bestDist = math.huge
	for id, def in pairs(TerritoryConfig.Territories) do
		local own = territoryOwners[id]
		local ownedByMe = own and own.OwnerType == "Player" and own.OwnerUserId == player.UserId
		local isNeutral = (not own) or own.OwnerType == "Neutral" or own.OwnerType == ""
		-- Prefer unowned/neutral; skip own holdings
		if not ownedByMe and (isNeutral or (own and own.OwnerType ~= "Player")) then
			-- Prefer truly neutral over NPC/clan when choosing "unowned" target
			local weight = if isNeutral then 0 else 80
			local d = (def.Position - from).Magnitude + weight
			if d < bestDist then
				bestDist = d
				bestId = def.DisplayName
				bestPos = def.Position
			end
		end
	end
	if bestId and bestPos then
		return bestId, bestPos, (bestPos - from).Magnitude
	end
	return nil, nil, nil
end

local function tickCompass()
	if not baseLabel or not outpostLabel then
		return
	end
	local pos, look = getRoot()
	if not pos or not look then
		baseLabel.Text = "⌂ BASE  —"
		outpostLabel.Text = "◎ OUTPOST  —"
		return
	end

	local bPos = baseWorldPos()
	if bPos then
		local dist = (bPos - pos).Magnitude
		if dist < 45 then
			baseLabel.Text = "⌂ BASE  HERE"
		else
			local dir = bearingLabel(pos, bPos, look)
			baseLabel.Text = string.format("⌂ BASE  %s  %s", dir, formatDist(dist))
		end
	else
		baseLabel.Text = "⌂ BASE  …"
	end

	local name, tPos, dist = nearestUnowned(pos)
	if name and tPos and dist then
		if dist < 55 then
			outpostLabel.Text = string.format("◎ %s  HERE", name)
		else
			local dir = bearingLabel(pos, tPos, look)
			outpostLabel.Text = string.format("◎ %s  %s  %s", name, dir, formatDist(dist))
		end
	else
		outpostLabel.Text = "◎ OUTPOST  all held"
	end
end

function CompassController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "WarEmpireCompass"
	gui.DisplayOrder = 20
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(gui, false)

	local frame = Instance.new("Frame")
	frame.Name = "Compass"
	frame.AnchorPoint = Vector2.new(1, 0)
	frame.Position = UDim2.new(1, -16, 0, 100)
	frame.Size = UDim2.fromOffset(210, 52)
	frame.BackgroundColor3 = Constants.Colors.Panel
	frame.BackgroundTransparency = 0.22
	frame.BorderSizePixel = 0
	frame.Parent = gui
	UIUtil.Corner(frame, 8)
	UIUtil.Stroke(frame, Color3.fromRGB(70, 100, 80), 1)

	local base = Instance.new("TextLabel")
	base.Name = "BaseHint"
	base.BackgroundTransparency = 1
	base.Position = UDim2.fromOffset(8, 4)
	base.Size = UDim2.new(1, -12, 0, 20)
	base.Font = Enum.Font.GothamBold
	base.TextSize = 12
	base.TextXAlignment = Enum.TextXAlignment.Left
	base.TextColor3 = Color3.fromRGB(160, 220, 170)
	base.Text = "⌂ BASE  —"
	base.Parent = frame
	baseLabel = base

	local out = Instance.new("TextLabel")
	out.Name = "OutpostHint"
	out.BackgroundTransparency = 1
	out.Position = UDim2.fromOffset(8, 26)
	out.Size = UDim2.new(1, -12, 0, 20)
	out.Font = Enum.Font.GothamMedium
	out.TextSize = 12
	out.TextXAlignment = Enum.TextXAlignment.Left
	out.TextColor3 = Color3.fromRGB(220, 200, 120)
	out.Text = "◎ OUTPOST  —"
	out.Parent = frame
	outpostLabel = out

	Remotes.GetEvent(Constants.RemoteNames.BaseStateUpdate).OnClientEvent:Connect(function(basePayload: Types.BaseStatePayload)
		if typeof(basePayload.PlotId) == "number" then
			myPlotId = basePayload.PlotId
		end
	end)

	Remotes.GetEvent(Constants.RemoteNames.PlayerStateUpdate).OnClientEvent:Connect(function(state: Types.PlayerStatePayload)
		if state.Base and typeof(state.Base.PlotId) == "number" then
			myPlotId = state.Base.PlotId
		end
	end)

	Remotes.GetEvent(Constants.RemoteNames.TerritoryStateUpdate).OnClientEvent:Connect(function(payload: Types.TerritoryStatePayload)
		for _, entry in ipairs(payload.Territories) do
			territoryOwners[entry.Id] = {
				OwnerType = entry.OwnerType,
				OwnerUserId = entry.OwnerUserId or 0,
			}
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum >= 0.25 then
			accum = 0
			tickCompass()
		end
	end)
end

return CompassController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Programmatic HUD: Level+XP top-left, currency pill bottom-left,
	mobile action dock (large color-coded squares) bottom-right.
	Inspiration-only layout quality — WAR EMPIRE features/hotkeys kept.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local UIUtil = require(Shared.Util.UIUtil)

local HUDController = {}

local player = Players.LocalPlayer
local _gui: ScreenGui? = nil
local levelLabel: TextLabel? = nil
local xpBarFill: Frame? = nil
local xpText: TextLabel? = nil
local cashLabel: TextLabel? = nil
local goldLabel: TextLabel? = nil
local passiveLabel: TextLabel? = nil
local seasonLabel: TextLabel? = nil
local spinnerBtn: TextButton? = nil
local actionDock: Frame? = nil
local spinnerReady = false
local spinnerCooldown = 0
local lastPassive = 0
local lastTraining = 0

local function refreshPassiveHint()
	if not passiveLabel then
		return
	end
	if lastTraining > 0 then
		passiveLabel.Text = string.format("+%d$/tick · Train +%d$/tick", lastPassive, lastTraining)
	else
		passiveLabel.Text = string.format("+%d$/tick", lastPassive)
	end
end

local function makeCorner(parent: Instance, radius: number)
	UIUtil.Corner(parent, radius)
end

local function makeStroke(parent: Instance, gold: boolean?)
	if gold then
		UIUtil.GoldStroke(parent, 1.5)
	else
		UIUtil.Stroke(parent)
	end
end

function HUDController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireHUD"
	screen.Parent = player:WaitForChild("PlayerGui")
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = false
	-- Above Base CTA (45) so dock tiles receive clicks; below modal panels (60+)
	screen.DisplayOrder = 55
	UIUtil.AttachMobileScale(screen, 800, 0.7, 1.15)
	_gui = screen

	local touch = UserInputService.TouchEnabled

	-- Top-left: Level + XP (compact)
	local left = Instance.new("Frame")
	left.Name = "LevelPanel"
	left.AnchorPoint = Vector2.new(0, 0)
	left.Position = UDim2.fromOffset(16, 16)
	left.Size = UDim2.fromOffset(220, 64)
	left.BackgroundColor3 = Constants.Colors.Panel
	left.BackgroundTransparency = 0.12
	left.BorderSizePixel = 0
	left.Parent = screen
	makeCorner(left, 10)
	makeStroke(left, true)

	local lvl = Instance.new("TextLabel")
	lvl.Name = "LevelLabel"
	lvl.BackgroundTransparency = 1
	lvl.Position = UDim2.fromOffset(10, 6)
	lvl.Size = UDim2.new(1, -20, 0, 22)
	lvl.Font = Enum.Font.GothamBold
	lvl.TextSize = 18
	lvl.TextXAlignment = Enum.TextXAlignment.Left
	lvl.TextColor3 = Constants.Colors.Text
	lvl.Text = "LVL 1"
	lvl.Parent = left
	levelLabel = lvl

	local xpBg = Instance.new("Frame")
	xpBg.Name = "XPBarBG"
	xpBg.Position = UDim2.fromOffset(10, 36)
	xpBg.Size = UDim2.new(1, -20, 0, 14)
	xpBg.BackgroundColor3 = Constants.Colors.Background
	xpBg.BorderSizePixel = 0
	xpBg.Parent = left
	makeCorner(xpBg, 4)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Constants.Colors.XP
	fill.BorderSizePixel = 0
	fill.Parent = xpBg
	makeCorner(fill, 4)
	xpBarFill = fill

	local xpLbl = Instance.new("TextLabel")
	xpLbl.Name = "XPText"
	xpLbl.BackgroundTransparency = 1
	xpLbl.Size = UDim2.fromScale(1, 1)
	xpLbl.Font = Enum.Font.Gotham
	xpLbl.TextSize = 11
	xpLbl.TextColor3 = Constants.Colors.Text
	xpLbl.Text = "0 / 100"
	xpLbl.Parent = xpBg
	xpText = xpLbl

	-- Bottom-left: currency pill (cash + gold) — thumb-friendly
	local pill = Instance.new("Frame")
	pill.Name = "CurrencyPill"
	pill.AnchorPoint = Vector2.new(0, 1)
	pill.Position = UDim2.new(0, 16, 1, if touch then -100 else -20)
	pill.Size = UDim2.fromOffset(200, 56)
	pill.BackgroundColor3 = Color3.fromRGB(22, 26, 32)
	pill.BackgroundTransparency = 0.08
	pill.BorderSizePixel = 0
	pill.ZIndex = 12
	pill.Parent = screen
	makeCorner(pill, 28)
	local pillStroke = UIUtil.Stroke(pill, Color3.fromRGB(255, 210, 90), 2)
	pillStroke.Transparency = 0.25

	local cash = Instance.new("TextLabel")
	cash.Name = "CashLabel"
	cash.BackgroundTransparency = 1
	cash.Position = UDim2.fromOffset(18, 4)
	cash.Size = UDim2.new(1, -28, 0, 26)
	cash.Font = Enum.Font.GothamBold
	cash.TextSize = 20
	cash.TextXAlignment = Enum.TextXAlignment.Left
	cash.TextColor3 = Constants.Colors.Cash
	cash.Text = "$5,000"
	cash.ZIndex = 13
	cash.Parent = pill
	cashLabel = cash

	local gold = Instance.new("TextLabel")
	gold.Name = "GoldLabel"
	gold.BackgroundTransparency = 1
	gold.Position = UDim2.fromOffset(18, 28)
	gold.Size = UDim2.new(1, -28, 0, 20)
	gold.Font = Enum.Font.GothamMedium
	gold.TextSize = 15
	gold.TextXAlignment = Enum.TextXAlignment.Left
	gold.TextColor3 = Constants.Colors.Gold
	gold.Text = "◆ 0"
	gold.ZIndex = 13
	gold.Parent = pill
	goldLabel = gold

	local passive = Instance.new("TextLabel")
	passive.Name = "PassiveHint"
	passive.AnchorPoint = Vector2.new(0, 1)
	passive.Position = UDim2.new(0, 16, 1, if touch then -160 else -80)
	passive.Size = UDim2.fromOffset(240, 18)
	passive.BackgroundTransparency = 1
	passive.Font = Enum.Font.Gotham
	passive.TextSize = 12
	passive.TextXAlignment = Enum.TextXAlignment.Left
	passive.TextColor3 = Constants.Colors.Muted
	passive.Text = ""
	passive.Parent = screen
	passiveLabel = passive

	local season = Instance.new("TextLabel")
	season.Name = "SeasonLabel"
	season.AnchorPoint = Vector2.new(0.5, 0)
	season.Position = UDim2.new(0.5, 0, 0, 12)
	season.Size = UDim2.fromOffset(280, 22)
	season.BackgroundColor3 = Constants.Colors.Panel
	season.BackgroundTransparency = 0.25
	season.BorderSizePixel = 0
	season.Font = Enum.Font.GothamBold
	season.TextSize = 12
	season.TextColor3 = Constants.Colors.Muted
	season.Text = ""
	season.Visible = false
	season.Parent = screen
	UIUtil.Corner(season, 6)
	seasonLabel = season

	-- Spinner chip beside currency pill
	local spin = Instance.new("TextButton")
	spin.Name = "SpinnerButton"
	spin.AnchorPoint = Vector2.new(0, 1)
	spin.Position = UDim2.new(0, 228, 1, if touch then -100 else -20)
	spin.Size = UDim2.fromOffset(72, 56)
	spin.BackgroundColor3 = Constants.Colors.Panel
	spin.Font = Enum.Font.GothamBold
	spin.TextSize = 11
	spin.TextColor3 = Constants.Colors.Text
	spin.Text = "SPIN"
	spin.BorderSizePixel = 0
	spin.ZIndex = 12
	spin.Parent = screen
	makeCorner(spin, 14)
	makeStroke(spin, true)
	UIUtil.EnsureMinTouch(spin, 56)
	spinnerBtn = spin
	spin.Activated:Connect(function()
		if spinnerReady then
			Remotes.GetEvent(Constants.RemoteNames.RequestClaimSpinner):FireServer()
		end
	end)

	-- Bottom-right action dock (tiles bound by BindActionBar)
	local dock = Instance.new("Frame")
	dock.Name = "MobileActionBar"
	dock.AnchorPoint = Vector2.new(1, 1)
	dock.Position = UDim2.new(1, -16, 1, if touch then -24 else -20)
	dock.Size = UDim2.fromOffset(400, 80)
	dock.BackgroundTransparency = 1
	dock.ZIndex = 12
	dock.Parent = screen
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = dock
	actionDock = dock

	local function refreshSpinnerBtn()
		if not spinnerBtn then
			return
		end
		if spinnerReady then
			spinnerBtn.Text = "READY"
			spinnerBtn.BackgroundColor3 = Constants.Colors.Accent
			spinnerBtn.TextColor3 = Constants.Colors.Text
		else
			local mins = math.ceil(math.max(0, spinnerCooldown) / 60)
			spinnerBtn.Text = string.format("%dm", mins)
			spinnerBtn.BackgroundColor3 = Constants.Colors.Panel
			spinnerBtn.TextColor3 = Constants.Colors.Muted
		end
	end
	refreshSpinnerBtn()

	Remotes.GetEvent(Constants.RemoteNames.SpinnerStateUpdate).OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		spinnerReady = payload.Ready == true
		spinnerCooldown = tonumber(payload.CooldownRemaining) or 0
		refreshSpinnerBtn()
	end)

	local econToken = 0
	Remotes.GetEvent(Constants.RemoteNames.EconomyUpdate).OnClientEvent:Connect(function(payload: Types.EconomyUpdatePayload)
		econToken += 1
		local my = econToken
		local cashAmt, goldAmt = payload.Cash, payload.Gold
		task.defer(function()
			if my == econToken then
				HUDController.SetEconomy(cashAmt, goldAmt)
			end
		end)
	end)

	Remotes.GetEvent(Constants.RemoteNames.XPUpdate).OnClientEvent:Connect(function(payload: Types.XPUpdatePayload)
		HUDController.SetXP(payload.Level, payload.XP, payload.XPToNext)
	end)

	Remotes.GetEvent(Constants.RemoteNames.PlayerStateUpdate).OnClientEvent:Connect(function(state: Types.PlayerStatePayload)
		HUDController.ApplyState(state)
	end)

	Remotes.GetEvent(Constants.RemoteNames.BaseStateUpdate).OnClientEvent:Connect(function(base: Types.BaseStatePayload)
		if base.PassiveIncomePerTick then
			lastPassive = base.PassiveIncomePerTick
			refreshPassiveHint()
		end
	end)
	Remotes.GetEvent(Constants.RemoteNames.SoldierStateUpdate).OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			lastTraining = tonumber(payload.TrainingIncomePerTick) or 0
			refreshPassiveHint()
		end
	end)

	Remotes.GetEvent(Constants.RemoteNames.SeasonStateUpdate).OnClientEvent:Connect(function(payload)
		if not seasonLabel or typeof(payload) ~= "table" then
			return
		end
		local active = payload.Active == true
		local name = tostring(payload.DisplayName or payload.SeasonId or "Season")
		if active then
			local xpB = tonumber(payload.XPBonusMult) or 1
			local cashB = tonumber(payload.CashBonusMult) or 1
			seasonLabel.Visible = true
			seasonLabel.TextColor3 = Constants.Colors.Cash
			seasonLabel.Text = string.format("%s  ·  XP×%.2f Cash×%.2f", name, xpB, cashB)
		else
			seasonLabel.Visible = true
			seasonLabel.TextColor3 = Constants.Colors.Muted
			seasonLabel.Text = name .. "  ·  ENDED"
		end
	end)

	task.spawn(function()
		local ok, state = pcall(function()
			return Remotes.GetFunction(Constants.RemoteNames.GetPlayerState):InvokeServer()
		end)
		if ok and state then
			HUDController.ApplyState(state :: Types.PlayerStatePayload)
		end
	end)
end

--[[
	Wire large color-coded action tiles after other controllers Init.
	actions: { { Name, Icon, Label, Color, OnClick }, ... }
]]
function HUDController.BindActionBar(actions: { { Name: string, Icon: string, Label: string, Color: Color3, OnClick: () -> () } })
	if not actionDock then
		warn("[HUDController] BindActionBar: actionDock nil — Init order broken?")
		return
	end
	actionDock.Active = false -- children buttons receive input; frame must not sink
	for _, child in ipairs(actionDock:GetChildren()) do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	-- Always ≥64px; touch gets larger hit targets
	local tileSize = if UserInputService.TouchEnabled then 76 else 68
	tileSize = math.max(tileSize, 64)
	actionDock.Size = UDim2.fromOffset(#actions * (tileSize + 10) + 8, tileSize + 8)
	actionDock.ZIndex = 30
	for i, def in ipairs(actions) do
		local btn = UIUtil.MakeActionTile(actionDock, {
			Name = def.Name,
			Icon = def.Icon,
			Label = def.Label,
			Color = def.Color,
			LayoutOrder = i,
			SizePx = tileSize,
		})
		btn.Active = true
		btn.ZIndex = 31
		-- Activated = mouse + touch + gamepad (MouseButton1Click alone misses some touch paths)
		btn.Activated:Connect(function()
			def.OnClick()
		end)
	end
	local order = if _gui then _gui.DisplayOrder else -1
	print(string.format("[HUDController] BindActionBar: %d tiles Active size=%d DisplayOrder=%d", #actions, tileSize, order))
end

local function formatCash(n: number): string
	local formatted = tostring(math.floor(n))
	formatted = formatted:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return "$" .. formatted
end

function HUDController.SetEconomy(cash: number, gold: number)
	if cashLabel then
		cashLabel.Text = formatCash(cash)
	end
	if goldLabel then
		goldLabel.Text = "◆ " .. tostring(math.floor(gold))
	end
end

function HUDController.SetXP(level: number, xp: number, xpToNext: number)
	if levelLabel then
		levelLabel.Text = "LVL " .. tostring(level)
	end
	local denom = if xpToNext > 0 and xpToNext < math.huge then xpToNext else 1
	local alpha = math.clamp(xp / denom, 0, 1)
	if xpBarFill then
		xpBarFill.Size = UDim2.fromScale(alpha, 1)
	end
	if xpText then
		if xpToNext == math.huge or xpToNext <= 0 then
			xpText.Text = "MAX"
		else
			xpText.Text = string.format("%d / %d", xp, xpToNext)
		end
	end
end

function HUDController.ApplyState(state: Types.PlayerStatePayload)
	HUDController.SetEconomy(state.Cash, state.Gold)
	HUDController.SetXP(state.Level, state.XP, state.XPToNext)
	if state.Base then
		lastPassive = state.Base.PassiveIncomePerTick or 0
	end
	if typeof(state.TrainingIncomePerTick) == "number" then
		lastTraining = state.TrainingIncomePerTick
	end
	refreshPassiveHint()
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">MissionController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Phase 6 — Missions UI + daily reward claim ]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)
local DailyRewardConfig = require(Shared.Configs.DailyRewardConfig)

local MissionController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local menuOpen = false
local screenGui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local dailyBtn: TextButton? = nil
local dailyInfo: TextLabel? = nil
local state: Types.MissionStatePayload? = nil

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function refresh()
	if not listFrame then
		return
	end
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end
	if not state then
		UIUtil.EmptyState(listFrame, "Loading missions… stand by for server sync.", 0)
		return
	end
	local layout = listFrame:FindFirstChildOfClass("UIListLayout")
	if not layout then
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = listFrame
	end

	if #state.Daily == 0 then
		UIUtil.EmptyState(listFrame, "No daily missions right now — check back after UTC midnight refresh.", 0)
	end

	for i, mission in ipairs(state.Daily) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 72)
		row.BackgroundColor3 = Constants.Colors.Background
		row.BorderSizePixel = 0
		row.LayoutOrder = i
		row.Parent = listFrame
		corner(row, 6)

		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Position = UDim2.fromOffset(8, 4)
		title.Size = UDim2.new(1, -100, 0, 20)
		title.Font = Enum.Font.GothamBold
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.TextColor3 = Constants.Colors.Text
		title.Text = mission.DisplayName
		title.Parent = row

		local desc = Instance.new("TextLabel")
		desc.BackgroundTransparency = 1
		desc.Position = UDim2.fromOffset(8, 24)
		desc.Size = UDim2.new(1, -100, 0, 18)
		desc.Font = Enum.Font.Gotham
		desc.TextSize = 11
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.TextColor3 = Constants.Colors.Muted
		desc.Text = mission.Description
		desc.TextTruncate = Enum.TextTruncate.AtEnd
		desc.Parent = row

		local prog = Instance.new("TextLabel")
		prog.BackgroundTransparency = 1
		prog.Position = UDim2.fromOffset(8, 46)
		prog.Size = UDim2.new(1, -100, 0, 18)
		prog.Font = Enum.Font.GothamMedium
		prog.TextSize = 12
		prog.TextXAlignment = Enum.TextXAlignment.Left
		prog.TextColor3 = Constants.Colors.XP
		prog.Text = string.format("%d / %d  ·  $%d + %dXP", mission.Progress, mission.Target, mission.RewardCash, mission.RewardXP)
		prog.Parent = row

		local btn = Instance.new("TextButton")
		btn.AnchorPoint = Vector2.new(1, 0.5)
		btn.Position = UDim2.new(1, -8, 0.5, 0)
		btn.Size = UDim2.fromOffset(88, 44)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 12
		btn.TextColor3 = Constants.Colors.Text
		btn.BorderSizePixel = 0
		corner(btn, 6)
		btn.Parent = row

		if mission.Claimed then
			btn.Text = "DONE"
			btn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
			btn.Active = false
		elseif mission.Complete then
			btn.Text = "CLAIM"
			btn.BackgroundColor3 = Constants.Colors.Accent
			UIUtil.EnsureMinTouch(btn, 44)
			btn.Activated:Connect(function()
				Remotes.GetEvent(Constants.RemoteNames.RequestClaimMission):FireServer(mission.Id)
			end)
		else
			btn.Text = "…"
			btn.BackgroundColor3 = Color3.fromRGB(45, 50, 55)
			btn.Active = false
		end
	end

	if dailyInfo and state.DailyLogin then
		local d = state.DailyLogin
		local reward = DailyRewardConfig.Rewards[d.NextDay]
		local rewardText = if reward then string.format("$%d", reward.Cash) else ""
		if d.AlreadyClaimedToday then
			dailyInfo.Text = string.format("Daily streak: Day %d (claimed)", d.Streak)
			if dailyBtn then
				dailyBtn.Text = "CLAIMED"
				dailyBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 60)
				dailyBtn.Active = false
			end
		else
			dailyInfo.Text = string.format("Claim Day %d reward %s", d.NextDay, rewardText)
			if dailyBtn then
				dailyBtn.Text = "CLAIM DAILY"
				dailyBtn.BackgroundColor3 = Constants.Colors.Gold
				dailyBtn.TextColor3 = Color3.fromRGB(30, 30, 20)
				dailyBtn.Active = true
			end
		end
	end
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
	if open then
		refresh()
	end
end

function MissionController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireMissions"
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, false)
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	screenGui = screen

	local toggle = Instance.new("TextButton")
	toggle.Name = "MissionsToggle"
	toggle.AnchorPoint = Vector2.new(0, 1)
	toggle.Position = UDim2.new(0, 16, 1, -16)
	toggle.Size = UDim2.fromOffset(110, 44)
	toggle.BackgroundColor3 = Constants.Colors.Panel
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = 14
	toggle.TextColor3 = Constants.Colors.Text
	toggle.Text = "MISSIONS"
	toggle.BorderSizePixel = 0
	toggle.Visible = false -- docked in HUD MobileActionBar
	corner(toggle, 8)
	toggle.Parent = screen
	UIUtil.EnsureMinTouch(toggle, 44)
	toggle.Activated:Connect(function()
		setOpen(not menuOpen)
	end)

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.92, 0, 0.72, 0) else UDim2.fromOffset(420, 380)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screen
	corner(panel, 10)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 10)
	title.Size = UDim2.new(1, -80, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Constants.Colors.Text
	title.Text = "Daily Missions"
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -12, 0, 10)
	close.Size = UDim2.fromOffset(48, 48)
	close.BackgroundColor3 = Constants.Colors.Background
	close.Font = Enum.Font.GothamBold
	close.Text = "X"
	close.TextColor3 = Constants.Colors.Text
	close.BorderSizePixel = 0
	corner(close, 6)
	close.Parent = panel
	UIUtil.EnsureMinTouch(close, 48)
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local dailyRow = Instance.new("Frame")
	dailyRow.Position = UDim2.fromOffset(12, 48)
	dailyRow.Size = UDim2.new(1, -24, 0, 44)
	dailyRow.BackgroundColor3 = Constants.Colors.Background
	dailyRow.BorderSizePixel = 0
	corner(dailyRow, 6)
	dailyRow.Parent = panel

	local info = Instance.new("TextLabel")
	info.BackgroundTransparency = 1
	info.Position = UDim2.fromOffset(10, 4)
	info.Size = UDim2.new(1, -120, 1, -8)
	info.Font = Enum.Font.Gotham
	info.TextSize = 13
	info.TextXAlignment = Enum.TextXAlignment.Left
	info.TextColor3 = Constants.Colors.Text
	info.Text = "Daily reward"
	info.Parent = dailyRow
	dailyInfo = info

	local dBtn = Instance.new("TextButton")
	dBtn.AnchorPoint = Vector2.new(1, 0.5)
	dBtn.Position = UDim2.new(1, -8, 0.5, 0)
	dBtn.Size = UDim2.fromOffset(110, 44)
	dBtn.Font = Enum.Font.GothamBold
	dBtn.TextSize = 11
	dBtn.Text = "CLAIM DAILY"
	dBtn.TextColor3 = Color3.fromRGB(30, 30, 20)
	dBtn.BackgroundColor3 = Constants.Colors.Gold
	dBtn.BorderSizePixel = 0
	corner(dBtn, 6)
	dBtn.Parent = dailyRow
	dailyBtn = dBtn
	UIUtil.EnsureMinTouch(dBtn, 44)
	dBtn.Activated:Connect(function()
		Remotes.GetEvent(Constants.RemoteNames.RequestClaimDailyReward):FireServer()
	end)

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 100)
	list.Size = UDim2.new(1, -24, 1, -112)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel
	listFrame = list

	Remotes.GetEvent(Constants.RemoteNames.MissionStateUpdate).OnClientEvent:Connect(function(payload: Types.MissionStatePayload)
		state = payload
		if menuOpen then
			refresh()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.M then
			setOpen(not menuOpen)
		end
	end)
end


function MissionController.Toggle()
	setOpen(not menuOpen)
end

function MissionController.Open()
	setOpen(true)
end

function MissionController.Close()
	setOpen(false)
end

function MissionController.IsOpen(): boolean
	return menuOpen
end

return MissionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Toast stack with fade-in, type colors, and capped stacking. ]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local NotificationConfig = require(Shared.Configs.NotificationConfig)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)

local AudioController = require(script.Parent.Parent.Modules.AudioController)

local NotificationController = {}

local player = Players.LocalPlayer
local stack: Frame? = nil

local TYPE_PREFIX = {
	Info = "ℹ ",
	Success = "✓ ",
	Warn = "! ",
	Error = "✕ ",
	Reward = "★ ",
}

function NotificationController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "WarEmpireNotifications"
	gui.DisplayOrder = 70 -- above modal panels (60)
	gui.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(gui, false)

	local frame = Instance.new("Frame")
	frame.Name = "Stack"
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.new(0.5, 0, 0, 72)
	frame.Size = UDim2.fromOffset(360, 240)
	frame.BackgroundTransparency = 1
	frame.Active = false -- never block HUD / dock clicks
	frame.Parent = gui
	stack = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = frame

	Remotes.GetEvent(Constants.RemoteNames.Notification).OnClientEvent:Connect(function(payload: any)
		NotificationController.Show(payload.Message or "", payload.Type or "Info", payload.Duration)
	end)
end

function NotificationController.Show(message: string, notifType: string, duration: number?)
	if not stack then
		return
	end
	AudioController.PlayNotification()
	local typeDef = NotificationConfig.Types[notifType] or NotificationConfig.Types.Info
	local prefix = TYPE_PREFIX[notifType] or ""

	local toast = Instance.new("Frame")
	toast.Name = "Toast"
	toast.Size = UDim2.fromOffset(340, 44)
	toast.BackgroundColor3 = Constants.Colors.Panel
	toast.BackgroundTransparency = 0.05
	toast.BorderSizePixel = 0
	toast.LayoutOrder = os.clock() * 1000
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = toast

	local stroke = Instance.new("UIStroke")
	stroke.Color = typeDef.Color
	stroke.Thickness = 2
	stroke.Parent = toast

	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0, 4, 1, 0)
	accent.BackgroundColor3 = typeDef.Color
	accent.BorderSizePixel = 0
	accent.Parent = toast
	local ac = Instance.new("UICorner")
	ac.CornerRadius = UDim.new(0, 8)
	ac.Parent = accent

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(14, 0)
	label.Size = UDim2.new(1, -20, 1, 0)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Constants.Colors.Text
	label.Text = prefix .. message
	label.TextTransparency = 1
	label.Parent = toast

	toast.BackgroundTransparency = 1
	stroke.Transparency = 1
	toast.Parent = stack

	-- Cap stack
	local kids = stack:GetChildren()
	local count = 0
	local oldest: Frame? = nil
	for _, k in ipairs(kids) do
		if k:IsA("Frame") and k.Name == "Toast" then
			count += 1
			if not oldest or k.LayoutOrder < oldest.LayoutOrder then
				oldest = k
			end
		end
	end
	if count > NotificationConfig.MaxStacked and oldest then
		oldest:Destroy()
	end

	local fadeIn = TweenService:Create(toast, TweenInfo.new(0.2), { BackgroundTransparency = 0.05 })
	local strokeIn = TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0 })
	local textIn = TweenService:Create(label, TweenInfo.new(0.2), { TextTransparency = 0 })
	fadeIn:Play()
	strokeIn:Play()
	textIn:Play()

	task.delay(duration or NotificationConfig.DefaultDuration, function()
		if not toast.Parent then
			return
		end
		local tw = TweenService:Create(toast, TweenInfo.new(0.28), { BackgroundTransparency = 1 })
		local tw2 = TweenService:Create(label, TweenInfo.new(0.28), { TextTransparency = 1 })
		local tw3 = TweenService:Create(stroke, TweenInfo.new(0.28), { Transparency = 1 })
		tw:Play()
		tw2:Play()
		tw3:Play()
		tw.Completed:Wait()
		toast:Destroy()
	end)
end

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">ProgressionController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Progression UI — Prestige + Battle Pass + Clan + Clan War (key K / PROGRESS) ]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local ProgressionUI = require(script.ProgressionUI)
local ProgressionBattlePass = require(script.ProgressionBattlePass)

local ProgressionController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local menuOpen = false
local screenGui: ScreenGui? = nil
local prestigeLabel: TextLabel? = nil
local unlockLabel: TextLabel? = nil
local prestigeConfirm: TextLabel? = nil
local bpLabel: TextLabel? = nil
local bpClaimHint: TextLabel? = nil
local bpBarFill: Frame? = nil
local clanLabel: TextLabel? = nil
local warLabel: TextLabel? = nil
local scoreboardLabel: TextLabel? = nil
local trackList: ScrollingFrame? = nil
local warIdBox: TextBox? = nil
local prestigeState: any = nil
local bpState: any = nil
local clanState: any = nil
local warState: any = nil

local function rebuildTrackPreview()
	ProgressionBattlePass.RebuildTrackPreview(trackList, bpState)
end

local debouncedRefresh = ProgressionUI.Debounce(0.12)

local function refreshLabelsImmediate()
	if prestigeLabel then
		if typeof(prestigeState) == "table" then
			local p = tonumber(prestigeState.Prestige) or 0
			local cur = tonumber(prestigeState.CashMultPercent)
				or math.floor(p * (tonumber(prestigeState.CashBonusPerLevel) or 0.10) * 100)
			local nxt = tonumber(prestigeState.NextCashMultPercent)
				or math.floor((p + 1) * (tonumber(prestigeState.CashBonusPerLevel) or 0.10) * 100)
			prestigeLabel.Text = string.format(
				"Rebirth P%d  |  Cash +%d%% now  |  Next +%d%%  |  Need Lv %d  |  Can: %s",
				p,
				cur,
				nxt,
				tonumber(prestigeState.MinLevel) or 100,
				if prestigeState.CanPrestige then "YES" else "no"
			)
		else
			prestigeLabel.Text = "Rebirth data loading… reach max level to prestige (+10% cash / rebirth)."
		end
	end
	if unlockLabel then
		if typeof(prestigeState) == "table" and typeof(prestigeState.UnlockTrack) == "table" then
			local lines = { "Unlock track:" }
			for _, u in ipairs(prestigeState.UnlockTrack) do
				local mark = if u.Unlocked then "✓" else "·"
				table.insert(
					lines,
					string.format("  %s P%d — %s", mark, tonumber(u.AtPrestige) or 0, tostring(u.DisplayName or u.Flag))
				)
			end
			if #lines == 1 then
				table.insert(lines, "  (none configured)")
			end
			unlockLabel.Text = table.concat(lines, "\n")
		else
			unlockLabel.Text = "Unlock track loading…"
		end
	end
	if prestigeConfirm then
		if typeof(prestigeState) == "table" and prestigeState.CanPrestige then
			prestigeConfirm.Text = "Confirm: resets Cash/Level/XP/Base. Keeps vehicles, weapons, gold, unlocks. +10% cash forever."
			prestigeConfirm.TextColor3 = Constants.Colors.Gold
		else
			prestigeConfirm.Text = "Reach required level to unlock DoPrestige / Rebirth."
			prestigeConfirm.TextColor3 = Constants.Colors.Muted
		end
	end
	if bpLabel and typeof(bpState) == "table" then
		local claimFree = tonumber(bpState.ClaimableFree) or 0
		local claimPrem = tonumber(bpState.ClaimablePremium) or 0
		local xp = tonumber(bpState.XP) or 0
		local need = tonumber(bpState.XPPerLevel) or 1000
		bpLabel.Text = string.format(
			"BP L%d  XP %d/%d  %s\nClaimable: %d free · %d premium",
			tonumber(bpState.Level) or 0,
			xp,
			need,
			if bpState.Premium then "PREMIUM" else "Free (shop PremiumPass / admin)",
			claimFree,
			claimPrem
		)
		if bpBarFill and need > 0 then
			bpBarFill.Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1)
		end
	end
	if bpLabel and typeof(bpState) ~= "table" then
		bpLabel.Text = "Battle Pass loading… play to earn BP XP."
	end
	if bpClaimHint then
		if typeof(bpState) == "table" then
			local cf = tonumber(bpState.ClaimableFree) or 0
			local cp = tonumber(bpState.ClaimablePremium) or 0
			if cf + cp > 0 then
				bpClaimHint.Text = string.format("Tap CLAIM ALL or CLAIM on a READY row — %d ready", cf + cp)
				bpClaimHint.TextColor3 = Constants.Colors.Cash
			else
				bpClaimHint.Text = "No unclaimed rewards at current BP level"
				bpClaimHint.TextColor3 = Constants.Colors.Muted
			end
		end
	end
	if clanLabel and typeof(clanState) == "table" then
		if clanState.ClanId then
			clanLabel.Text = string.format(
				"Clan [%s] %s (%d)\nId: %s%s",
				tostring(clanState.Tag or "?"),
				tostring(clanState.Name or "?"),
				tonumber(clanState.MemberCount) or 0,
				tostring(clanState.ClanId),
				if clanState.Persisted == false then "\n(session-only — enable API Services)" else ""
			)
		else
			clanLabel.Text = "Not in a clan — create one below"
		end
	end
	if warLabel then
		if typeof(warState) == "table" then
			local war = warState.War
			local cd = tonumber(warState.DeclareCooldownLeft) or 0
			if typeof(war) == "table" and war.Active then
				local left = math.max(0, (tonumber(war.EndUnix) or 0) - os.time())
				warLabel.Text = string.format(
					"WAR ACTIVE  %s vs %s\nScore %d – %d  ·  %dm left",
					tostring(war.AttackerName or war.AttackerClanId),
					tostring(war.DefenderName or war.DefenderClanId),
					tonumber(war.AttackerScore) or 0,
					tonumber(war.DefenderScore) or 0,
					math.floor(left / 60)
				)
				warLabel.TextColor3 = Color3.fromRGB(230, 160, 60)
			elseif typeof(war) == "table" and war.Settled then
				warLabel.Text = string.format(
					"Last war settled · Winner: %s\nCooldown: %ds before next declare",
					tostring(war.WinnerClanId or "draw"),
					cd
				)
				warLabel.TextColor3 = Constants.Colors.Muted
			else
				local rewards = warState.Rewards
				local winCash = if typeof(rewards) == "table" then tonumber(rewards.WinCash) or 0 else 0
				warLabel.Text = string.format(
					"No active war. Leader declares vs clan Id.\nWin ≈ $%d · cooldown %ds · min members %d",
					winCash,
					cd,
					tonumber(warState.MinMembers) or 2
				)
				warLabel.TextColor3 = Constants.Colors.Muted
			end
		else
			warLabel.Text = "War state loading..."
		end
	end
	if scoreboardLabel and typeof(warState) == "table" then
		local board = warState.Scoreboard
		if typeof(board) == "table" and #board > 0 then
			local lines = { "Global war scoreboard:" }
			for i, row in ipairs(board) do
				if i > 5 then
					break
				end
				table.insert(lines, string.format("  %d. %s — %d", i, tostring(row.Name or row.ClanId), tonumber(row.Score) or 0))
			end
			scoreboardLabel.Text = table.concat(lines, "\n")
		else
			scoreboardLabel.Text = "Scoreboard empty — capture territories with a clan"
		end
	end
	rebuildTrackPreview()
end

local function refreshLabels()
	debouncedRefresh(refreshLabelsImmediate)
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
end

function ProgressionController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireProgression"
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, false)
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	screenGui = screen

	local toggle = Instance.new("TextButton")
	toggle.Name = "ProgressToggle"
	toggle.AnchorPoint = Vector2.new(0, 1)
	toggle.Position = UDim2.new(0, 224, 1, -16)
	toggle.Size = UDim2.fromOffset(100, 36)
	toggle.BackgroundColor3 = Constants.Colors.Panel
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = 13
	toggle.TextColor3 = Constants.Colors.Text
	toggle.Text = "PROGRESS"
	toggle.BorderSizePixel = 0
	toggle.Visible = false -- docked in HUD MobileActionBar
	UIUtil.Corner(toggle, 8)
	UIUtil.Stroke(toggle)
	toggle.Parent = screen
	UIUtil.EnsureMinTouch(toggle, 44)
