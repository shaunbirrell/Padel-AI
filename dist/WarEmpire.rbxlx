		SHORTFALL_CHIP = "SHORTFALL_CHIP",
		ANNOUNCE_SHOWN = "ANNOUNCE_SHOWN",
		-- Nations (cosmetic country; nations spec section 2). The IP-based suggestion is never logged, in any field.
		NATION_PICKER_SHOWN = "NATION_PICKER_SHOWN", -- source ("join" / "flagpole" / "settings")
		NATION_PICK = "NATION_PICK", -- exactly { id, source, first }
		NATION_LATER = "NATION_LATER", -- count (NationPrompts after this LATER)
		-- W3 step 2 Phase B: Jobs (OpsService; props: site, value, bags, drops, picked, lost)
		OPS_OPEN = "OPS_OPEN", -- a big site opened (OpsDirector)
		OPS_START = "OPS_START", -- a run went Active (breach / start / hack / plant / provoked)
		OPS_DONE = "OPS_DONE", -- a run finished (paid at completion or bags out)
		OPS_FAIL = "OPS_FAIL", -- lockdown / window / empty ring / abandoned
		BAG_GRAB = "BAG_GRAB",
		BAG_DROP = "BAG_DROP", -- the carrier died (or the deadline ran out: lost = true)
		BAG_PICKUP = "BAG_PICKUP",
		BAG_DELIVER = "BAG_DELIVER",
		-- claude-bud JOB 24 §10: funnel / custom events
		CASH_COLLECT = "CASH_COLLECT",
		BASE_CLAIMED = "BASE_CLAIMED",
		REACHED_5_MINUTES = "REACHED_5_MINUTES",
		DAILY_MISSION_COMPLETED = "DAILY_MISSION_COMPLETED",
		RETURN_SEQUENCE_CLAIMED = "RETURN_SEQUENCE_CLAIMED",
		ARMY_OPEN = "ARMY_OPEN",
		ARMY_ATTACK = "ARMY_ATTACK",
		TUTORIAL_SHOWN = "TUTORIAL_SHOWN",
		TUTORIAL_CLOSED = "TUTORIAL_CLOSED",
		MISSILE_STRIKE = "MISSILE_STRIKE",
		SESSION_END = "SESSION_END",
		-- claude-bud JOB 29
		ONBOARD_STEP = "ONBOARD_STEP",
		OFFLINE_EARNED = "OFFLINE_EARNED",
		NOTIF_OPTIN = "NOTIF_OPTIN",
		RATE_PROMPT_SHOWN = "RATE_PROMPT_SHOWN", -- claude-bud JOB 40 D
		RATE_PROMPT_ANSWER = "RATE_PROMPT_ANSWER",
		GUIDED_STEP = "GUIDED_STEP", -- claude-bud JOB 41
		GUIDED_SKIPPED = "GUIDED_SKIPPED",
		GUIDED_STUCK = "GUIDED_STUCK",
		RECRUIT_PACK_OFFERED = "RECRUIT_PACK_OFFERED", -- claude-bud JOB 41 B
		RIVAL_LIST_OPENED = "RIVAL_LIST_OPENED", -- claude-bud JOB 41 C
		RIVAL_SEND_TAPPED = "RIVAL_SEND_TAPPED",
		RIVAL_RAID_WON = "RIVAL_RAID_WON",
		STREAK_DAY = "STREAK_DAY",
		ACTIVITY_START = "ACTIVITY_START",
		ACTIVITY_DONE = "ACTIVITY_DONE",
	},
}

return AnalyticsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">ArmourConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 26: personal armour the player buys at his base (Server/Services/ArmourService, Client/Controllers/
	ArmourController: Army menu -> MY ARMOUR).
	  * Effect: damage reduction, delivered as BONUS MAX HEALTH (MaxHealth = PlayerMaxHealth / (1 - Reduction)), so it
	    works against EVERY damage source (guns, soldiers, guards, defenders, vehicles, missiles, blasts) whatever code
	    path hurts the Humanoid: 20 % less damage = 125 HP. The HUD shows the bonus as a blue bar above the health bar
	    (spent first). Capped at MaxReduction.
	  * Tiers bought in order, Cash only, each needs a Command Center level (base progress); bought only inside his own
	    plot (InBaseOnly). Saved in profile.Armour.Tier, kept after death and through rebirth (KeepThroughRebirth).
	  * Look: a vest (every tier) and a helmet (from HelmetFromTier) welded to the character (simple parts, no store
	    assets); Settings "Armour look" hides the look, the stats stay.
	  * Robux: CommanderArmourRobux stays OFF (a suggestion only: the owner must approve any Robux item).
	Enabled = false: no armour (100 HP for everyone, as v118).
]]

export type Tier = { Id: string, Name: string, Cost: number, Reduction: number, NeedCommandCenter: number, Color: Color3 }

local ArmourConfig = {
	Enabled = true,
	MaxReduction = 0.5,
	InBaseOnly = true,
	KeepThroughRebirth = true,
	HelmetFromTier = 3,
	Tiers = {
		{ Id = "LightVest", Name = "Light Vest", Cost = 12000, Reduction = 0.10, NeedCommandCenter = 1, Color = Color3.fromRGB(96, 104, 78) },
		{ Id = "CombatArmour", Name = "Combat Armour", Cost = 45000, Reduction = 0.20, NeedCommandCenter = 2, Color = Color3.fromRGB(78, 86, 62) },
		{ Id = "HeavyArmour", Name = "Heavy Armour", Cost = 150000, Reduction = 0.30, NeedCommandCenter = 3, Color = Color3.fromRGB(62, 68, 52) },
		{ Id = "EliteArmour", Name = "Elite Armour", Cost = 450000, Reduction = 0.40, NeedCommandCenter = 4, Color = Color3.fromRGB(48, 52, 44) },
		{ Id = "TitanArmour", Name = "Titan Armour", Cost = 1200000, Reduction = 0.50, NeedCommandCenter = 5, Color = Color3.fromRGB(36, 38, 34) },
	} :: { Tier },
	-- suggestion only (docs / handoff): a "Commander Armour" look + the Titan tier early for Robux; OFF
	CommanderArmourRobux = false,
}

return ArmourConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ArmyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ArmyConfig — the field army (SquadOrdersService units). SPEC-ARMY-FINAL §10.1. Config-first; server and client read it.

	████ army lane A0 blocks: Rollout · Escort · ShotFx · Text (+ the LiveFor / IsLive helper) ████
	████ army fix blocks (the despawn fix): Follow · Recover · Gate · Loop (+ the ThreatStandingFor helper) ████
	Other army lanes add their own self-contained blocks to this same table (lane A: Home / Guard / Hold / Path / Ui;
	claude-bud J9: lane C "March" was never built and is retired; ATTACK formations are Follow2.Tidy). Keep each block
	self-contained; this file requires only AdminConfig.

	ROLLOUT (owner 2026-09-28, integrator decision): each part is "off" | "owner" | "all".
	  "off"   = today's game (e506c9c) for everyone;
	  "owner" = only the owner's playtest account (AdminConfig.IsPlaytestOwner, UserId 470626172, the same gate as
	            AircraftWeaponConfig.LiveFor); everyone else keeps today's game;
	  "all"   = everyone.
	  Any other value counts as "off" (fail closed). The SERVER decides (ArmyConfig.LiveFor); nothing is read from a client.
	  Parts: Escort (lane A0: the bank fix, defend-when-targeted, focus fire, side-step, visible unit shots), Army (lane A:
	  guard line, follow outside, paths), Fix (v90 despawn fix).

	ESCORT (FOLLOW, lane A0, "I went to the bank and they didn't shoot"): for a live owner the escort's first targets are
	  the NPCs aiming at him within DefendRadius of him (CombatService.NPCsAimingAt / NPCThreat) and the NPCs he hit
	  himself in the last FocusFireSeconds within DefendRadius (focus fire; CombatService stamps the player's own hits);
	  then today's escort targets (CombatFairnessConfig.EscortEngageRadius 55 of him). While such a target exists the
	  escort leash is DefendLeash (today CombatFairnessConfig.EscortLeash 20), so units step out for a sight line. Every
	  shot keeps squadfair's rules: line of sight, the unit hit curve, unitMayHit, no kill pay on ATTACK.
	  Side-step: after SideStepAfterBlocked shot checks in a row with the target in range but out of sight, a unit
	  probes SideStepStuds to each side (at most 4 rays per probe, at most one probe per SideStepMinGap s, only while
	  blocked) and walks to the first spot that sees the target and stays inside its leash, for at most SideStepHoldSeconds.
	  NpcSnapshot is NOT a Rollout part: every army's hostile scan reads one CombatService NPC list per think pass
	  (CombatService.LiveNPCSnapshot) instead of a CollectionService:GetTagged("WE_NPC") per unit; the picks are the same
	  (a2 differential runs). false = the per-unit GetTagged scan of e506c9c.

	SHOTFX (lane A0): a unit shot (hit or miss, every order) of a live owner's army may send one WeaponFx bullet
	  (UnreliableRemoteEvent, CombatFx) with the NPC rifle look (S = 0, W = "NPC": the rig's aim pose plays too).
	  Sampled to one event per army per PerArmyMinGap s, then a per-army shooter bucket, then an army bucket of
	  PerRecipientHz (burst PerRecipientBurst) per recipient, on top of CombatFx's own recipient bucket. A missed shot's
	  tracer lands MissOffsetStuds beside the target (no random numbers: the hit roll sequence is untouched).

	TEXT: device-neutral army strings (no key names, no "click" / "tap"); lanes A and C show them.

	DESPAWN FIX (army fix; v90: Rollout.Fix, owner first):
	  • Follow  — keeping up in FOLLOW: aim at where the owner will be (Lead), walk at his pace (smoothed and stepped:
	    PaceSmooth / PaceStep / PaceJumpStuds) and run only when well behind (CatchUp), follow as at e506c9c near a
	    hostile (ThreatStuds / ThreatStandingFor); while he walks, escort units keep the formation and shoot from it
	    (EscortWalkInFormation / EscortWalkLeash).
	  • Recover — RECOVER (SPEC-ARMY-FINAL §6.5): a unit is NEVER deleted for distance, a failed walk or a wall. One that
	    is far behind, stuck, fallen or deep in another player's plot is moved (Model:PivotTo, the same unit and id) to
	    a clear spot behind its owner. The only ways a unit is removed stay the lifecycle ones: its Humanoid died, the
	    army shrank (dismiss / research), the owner left, OrdersConfig.Enabled = false.
	  • Loop    — one army's error never stops the think loop of every army (pcall + a rate-limited log line).
	  • Gate    — the owner's friendly gate barrier also opens for his own units while they FOLLOW him through it
	    (GateDefenseService.updateFriendlyGate), only while they are still on the far side of it (CrossingRule,
	    CrossClearStuds 0); never for units on his side, never for Hold / Attack / Retreat, never with him dead or away.

	v90 (Code Bot): THE DESPAWN FIX ships behind Rollout.Fix ("owner" first; everyone else keeps v85 FollowPace /
	4d26673 until it is "all"; for a Fix-live owner it replaces v85 FollowPace). Within it each block has its own kill switch (Enabled / OwnUnitsOpen /
	KeepTrailPoint / EscortWalkInFormation / CrossingRule; ThreatStuds = 0 turns the near-hostile pacing off); with all
	of them off SquadOrdersService / GateDefenseService behave as at 4d26673 (units walk at OrdersConfig.UnitWalkSpeed,
	straight to the unled slot, never moved). Numbers are measured on the headless stand-in (army/build/fix and army/build/fix_ship
	reports); Humanoid physics needs a real device.
]]

local AdminConfig = require(script.Parent.AdminConfig)

local ArmyConfig = {
	-- ── Rollout (lane A0 builds the gate; lanes A / C read it) ─────────────────────────────────────────────────────
	Rollout = {
		Escort = "all", -- v101 (was "owner") -- lane A0: bank fix / defend / focus fire / side-step / visible unit shots
		Army = "all", -- v101 (was "owner") -- lane A: guard line, follow outside, movement
		Fix = "all", -- v101 (was "owner") -- v90 (Code Bot): the army despawn fix (Follow / Recover / Gate blocks); "all" once the owner has phone-tested it
	},

	-- ── Escort (FOLLOW; SPEC-ARMY-FINAL §7.1 / §7.2) ──────────────────────────────────────────────────────────────
	Escort = {
		DefendRadius = 90, -- studs from the owner: NPCs aiming at him / hit by him this close are escort targets first
		DefendLeash = 28, -- escort leash (studs from the owner) while such a target exists (else EscortLeash 20)
		FocusFireSeconds = 6, -- an NPC the owner hit himself within this many seconds is a focus-fire target
		SideStep = true,
		SideStepAfterBlocked = 2, -- shot checks in a row with the target in range but out of sight
		SideStepStuds = { 4, 8 }, -- lateral probe distances (one ring per probe, alternating)
		SideStepMinGap = 1.5, -- seconds between two probes of one unit (<= 4 rays per probe)
		SideStepHoldSeconds = 3, -- a side-step walk ends after this (reached, a shot, or given up)
		NpcSnapshot = true, -- every army (not a Rollout part): one NPC list per think pass, no GetTagged per unit
	},

	-- ── ShotFx (every order; SPEC-ARMY-FINAL §7.1 "Visible shots") ────────────────────────────────────────────────
	ShotFx = {
		Enabled = true,
		PerArmyMinGap = 0.25, -- at most one WeaponFx event per army per this many seconds
		PerRecipientHz = 6, -- army bucket per recipient (events / s), on top of CombatFeelConfig.Fx.PerRecipientHz
		PerRecipientBurst = 2, -- 2 per think pass (armies fire together at 2.5 Hz): <= 6 in any 1 s, 5 / s steady
		MissOffsetStuds = 3, -- a miss tracer lands this far beside the target (alternating sides)
	},

	-- ── FollowPace (v85 hotfix, owner phone v84: "The army still cut off when walking"; Rollout.Army) ────────────────
	-- Root cause: FOLLOW units walked at OrdersConfig.UnitWalkSpeed 14 while the owner walks at 16 (18.4 Speed Pass,
	-- 20 Speed Boost), so every second of walking left them 2-6 studs further behind; their MoveTo goal was the slot
	-- where the player stood up to one think (0.4 s) ago; a unit that reached that stale slot stopped (MoveTo to
	-- itself) until the next think; and an escort with any hostile in range stood still to shoot while he walked on
	-- until it was EscortLeash (20) behind. The client escort figures stand 7-12 studs AHEAD of their unit, so a unit
	-- that fell behind put its figures inside the camera guard's corridor and they vanished.
	-- For a live owner (Rollout.Army) while he is on foot:
	--   * speed: WalkSpeed = max(UnitWalkSpeed, owner WalkSpeed x MatchMult); x CatchUpMult once the unit is more than
	--     CatchUpStartStuds from its (led) slot, x SprintMult beyond SprintStartStuds; never above MaxSpeed;
	--   * lead: the slot is taken from where the owner will be LeadSeconds ahead (his flat velocity), so the goal is
	--     never behind him, and a unit in its slot keeps walking while he walks (no stop-start);
	--   * moving escort: while he moves faster than MovingStuds/s the escort shoots on the move from its slot instead of
	--     standing (it still stops to fight when he stops);
	--   * last resort: a unit more than TeleportStuds from him and out of his sight line (or more than
	--     TeleportHardStuds, seen or not) is put back in its slot beside him (the recruit spawn rules: never inside a
	--     wall), at most once per TeleportCooldown s per unit. Never while he is seated (vehicles keep today's rules).
	FollowPace = {
		Enabled = true,
		MatchMult = 1.1, -- in-slot speed = owner WalkSpeed x this (a little faster so the wings keep their place)
		CatchUpStartStuds = 6,
		CatchUpMult = 1.4,
		SprintStartStuds = 20,
		SprintMult = 1.8,
		MaxSpeed = 40,
		LeadSeconds = 0.5,
		MaxLeadStuds = 12,
		MovingStuds = 3, -- owner flat speed (studs/s) that counts as walking
		TeleportStuds = 70,
		TeleportHardStuds = 140,
		TeleportCooldown = 4,
	},

	-- ── Text (device-neutral; no key names, no "click" / "tap") ──────────────────────────────────────────────────
	Text = {
		Status = {
			Guard = "GUARDING BASE",
			Follow = "FOLLOWING",
			Hold = "HOLDING",
			Fight = "FIGHTING",
			Wait = "WAITING FOR YOU",
			Return = "RETURNING",
			Clear = "FIGHTING",
		},
		Tile = { Guard = "GUARD", Follow = "FOLLOW", Attack = "ATTACK", Hold = "HOLD", Return = "RETURN" },
		MovingOut = "Army moving out",
		Waiting = "Army waiting for you",
		NoBase = "No base to guard",
	},

	-- ════ army fix (the despawn fix) blocks: Follow · Recover · Gate · Loop ════
	Follow = {
		-- MoveTo goals are refreshed once per think (OrdersConfig.ThinkInterval 0.4 s) and a Humanoid stops at its goal,
		-- so a follow unit aims at its slot around where the owner WILL be: his flat velocity over the last think x
		-- Seconds, at most MaxStuds. A faster jump (teleport, respawn, fast vehicle) gives no lead, and neither does a
		-- think at under DropOnSlowdown x the one before (he is stopping). When he has stopped, a unit whose goal lies
		-- just behind it (within MaxStuds + StopHoldStuds, along his facing) stands facing his way instead of turning
		-- back toward the camera. MaxStuds 4: a unit in its slot walks smoothly at his pace (measured: stopped in about
		-- 1 % of walking ticks; 12 made them stop and start 5 times a second).
		Lead = {
			Enabled = true,
			Seconds = 0.4, -- = OrdersConfig.ThinkInterval
			MaxStuds = 4,
			MaxOwnerSpeed = 48, -- studs/s; faster owner moves are jumps (no lead). claude-bud JOB 40: was 40 (= the new top run speed)
			DropOnSlowdown = 0.5,
			StopHoldStuds = 2,
			StopHoldSeconds = 1.5, -- ...only right after he stopped (a unit walking back later still does)
		},
		-- A follow unit walks at its owner's pace (never below OrdersConfig.UnitWalkSpeed, so it falls back to
		-- UnitWalkSpeed once he stands still). More than StartStuds behind (its goal further than StartStuds + the lead
		-- distance) with a walkable line to it, it runs SpeedMult x that pace, at most MaxSpeed: owner 16 / 18.4 / 20
		-- (research) -> 24 / 27.6 / 28. A unit whose line to its goal is blocked never runs (no sprinting into a wall).
		-- The spec's 18 studs/s cannot keep up with an owner at 18.4 or 20.
		CatchUp = {
			Enabled = true,
			StartStuds = 6,
			SpeedMult = 1.5,
			MaxSpeed = 60, -- claude-bud JOB 40: 40 x 1.5 (was 40). v126: was 28; the Speed Boost owner walks 25.6 (x1.6), 25.6 x 1.5 = 38.4
			-- ship: the pace comes from his speed smoothed over passes (weight PaceSmooth per 0.4 s pass) and moves only in
			-- PaceStep studs/s steps: every Humanoid.WalkSpeed write replicates to every client, and a client-owned
			-- character's replicated position jitters (stand-in, +-0.4 studs per step: 20 writes/s per army at step 0).
			PaceSmooth = 0.4,
			PaceStep = 1,
			PaceJumpStuds = 3, -- ...a change bigger than this passes at once (a start / stop / sprint: no lag, no catch-up run)
		},
		-- While a hostile the escort would pick (not a calm one, one this army may hit) is within ThreatStuds of the
		-- owner, FOLLOW units follow as at e506c9c (no lead, UnitWalkSpeed) so a fight starts from the e506c9c formation.
		-- ThreatStuds 55 = CombatFairnessConfig.EscortEngageRadius: only where the escort itself would fight (ship merge;
		-- 130 slowed the army on every approach to a camp, a checkpoint or the bank and dropped it behind the phone camera).
		--   • ThreatStandingFor live for him: only while he STANDS (below 1 stud/s); walking toward it, units keep the lead
		--     and the catch-up. Lane A0's defend-when-targeted escort (Rollout.Escort) fights the bank guards for him, so
		--     keep ThreatStandingFor equal to Rollout.Escort (both "owner" today).
		--   • Otherwise: while he stands or walks toward it (ThreatApproachOnly; walking away = the normal follow).
		-- Measured on the stand-in, merged tree (army/build/fix_ship; 4d26673 = HEAD):
		--   owner mode: bank stand 40-55 studs, all 5 guards down in 91 of 99 approaches (HEAD 91); Town walk at
		--     16 / 18.4 / 20: no soldier on the phone camera in 1/126, 2/110, 4/101 walking seconds (HEAD 121/126).
		--   everyone else: 79 of 99 (HEAD 87). The band: standing or seated about 50-55 studs from the nearest guard,
		--     one guard can stay at its post ~61 studs away, out of the 55-stud escort range, and keep firing (dense
		--     sweep 48-56 studs x 9 lines: 28 of 72 vs HEAD 41, all lost at 51-53; guard shots +19 %); a mortal player
		--     on 40-55 studs takes the same total damage (8436 vs 8448) and moving fights are equal. The fix is
		--     Rollout.Escort = "all" with ThreatStandingFor = "all". Town walk 2/126, 4/110, 5/101; a walk up to the
		--     Ridge camp 0/16, 0/14, 0/13 (HEAD 15/16, 13/14, 13/13).
		--   ThreatStuds 130 (fix round 2): everyone else 47 of 99 at the bank and 3/16 at the camp.
		-- ThreatKeepCatchUp = true drops only the lead near a hostile (not shipped). ThreatStuds = 0 = off.
		ThreatStuds = 55,
		ThreatApproachOnly = true,
		ThreatStandingFor = "all", -- v101 (equal to Rollout.Escort) -- "off" | "owner" | "all": keep it equal to lane A0's Rollout.Escort
		ThreatKeepCatchUp = false,
		-- A unit on the player's trail (OrdersConfig.FollowPath) that finds no walkable trail point keeps walking to the
		-- last one it had instead of straight at its slot behind a wall (the doorway stranding). false = e506c9c.
		KeepTrailPoint = true,
		-- While the owner walks on foot (1+ studs/s, not seated), FOLLOW escort units keep the formation: they walk to
		-- their led slot (or his trail) with the catch-up run allowed, and shoot from there (the escort shot is taken
		-- first every think). They close in, stand to fight, walk back at the leash or side-step (lane A0) only while he
		-- stands. On e506c9c they stood to shoot while he walked on and trailed him at the 20-stud escort leash, behind
		-- the ~12.5-stud phone camera (the bank hall walk). false = e506c9c escort walk.
		EscortWalkInFormation = true,
		-- ...except inside EscortWalkLeash studs of him (less than the ~12.5-stud phone camera distance): there a unit
		-- keeps his pace toward its target on his line to it, at most 90 % of this out (between him and the target, as
		-- the e506c9c close-in does). 0 = formation only.
		EscortWalkLeash = 10,
	},

	Recover = {
		Enabled = true,
		-- Triggers (per unit, in FOLLOW only; Hold / Retreat / Attack keep the e506c9c behaviour):
		FollowFarStuds = 80, -- far: more than this from the owner (flat) ...
		FollowFarSeconds = 4, -- ... for this long (not while he drives faster than VehicleDeferSpeed)
		StuckSeconds = 4, -- stuck: less than ProgressStuds of progress toward its goal in this window ...
		ProgressStuds = 2,
		StuckGoalStuds = 4, -- ... while its goal is further than this (a unit at its goal is never stuck) ...
		StuckMinOwnerStuds = 25, -- ... and it is further than this from the owner
		-- fallen: its root is below this height. -8 = under the 8-stud Part ground (bottom -7.5, top 0.5) and above
		-- MapSetup's SafetyCatch floor under the map (top -26: a unit that drops through the ground stands on it at about
		-- -23, so -50 never fired). No walkable surface is below 0 (water spans 0.3..1.5; players are rescued at 0.15).
		FallY = -8,
		PlotMinOwnerStuds = 30, -- plot: more than this from the owner inside a plot square another player owns ...
		PlotSeconds = 4, -- ... for this long, while the owner has been out of that plot this long
		-- plus regroup: a vehicle stop (below VehicleStopSpeed for VehicleStopSeconds, or getting out) after a fast drive,
		-- or a jump on foot (a teleport, a respawn at his plot, a fall rescue: he appears more than FollowPath.ResetJump
		-- away), with it more than VehicleRegroupStuds away (for RegroupWindowSeconds after it; no FollowFarSeconds wait)
		VehicleDeferSpeed = 20, -- studs/s: no recover at all while the seated owner moves faster than this
		VehicleStopSpeed = 6,
		VehicleStopSeconds = 1.5,
		VehicleRegroupStuds = 150,
		RegroupWindowSeconds = 10,
		-- Where to (the first CLEAR spot, at most MaxTries tried): its slot when that is BehindStuds behind the owner's
		-- facing or out of his sight; up to MaxTrailTries of the owner's trail points at least BehindStuds from him and
		-- not ahead of him (newest first, at most TrailMaxStuds away); BehindStuds behind him along his facing, then
		-- back-right, back-left, the same three NearBehindStuds from him; then left and right (SideNeedsCover: only where his head cannot see the spot, else the
		-- unit waits up to MaxDeferSeconds for a better one). Every spot but the slot is moved by the unit's own slot
		-- offset (SpreadScale x its side offset sideways, its slot depth further back), and a spot within LandApartStuds
		-- of another landing of his army in the last LandApartSeconds (or of one of his units) is skipped: units land
		-- apart, never on one another. BehindStuds away and not ahead of him is outside a phone's landscape view (the
		-- camera is ~12 behind him), so units run in and never pop up in front of him. Clear = a ProbeDown-stud ray down
		-- hits a solid part or terrain that is not water, the spot is outside every plot but his own and not under a
		-- WE_Water surface, and the FollowPath body probe plus one ray at root height (a closed gate barrier) reach it
		-- from the owner's root. The unit stands StandHeight above the hit.
		BehindStuds = 24,
		TrailMaxStuds = 60,
		MaxTrailTries = 4,
		SpreadScale = 0.7, -- slot side offsets 5.5 / 10 / 14.5 -> 3.85 / 7 / 10.15: neighbours land >= 3 apart
		LandApartStuds = 3,
		LandApartSeconds = 2.5, -- ship: 2 s plus a margin (a landing exactly 5 thinks = 2.0 s later could slip past a float compare)
		SideNeedsCover = true,
		NearBehindStuds = 14, -- ...the three behind spots again this near (a walled yard, a street)
		MaxTries = 14, -- 4 rays each
		ProbeDown = 12,
		StandHeight = 3.2,
		-- Limits
		CooldownSeconds = 8, -- at most one recover per unit per this ...
		MinMoveStuds = 4, -- ...and a found spot within this of where the unit stands is no move (no PivotTo onto itself)
		MissRetrySeconds = 2, -- ... a search that found no clear spot looks again after this
		PerOwnerPerSecond = 4, -- at most this many recover SEARCHES per owner per second (the rest wait for the next think)
		NoPlayerWithin = 25, -- never land this close to another player ...
		MaxDeferSeconds = 10, -- ... wait up to this long for the first clear spot, then take the next one
		-- Counters: WE_ArmyRecover (number attribute on the owner's Player) + at most one server log line per owner per
		-- LogSeconds. No debug label.
		LogSeconds = 30,
		-- A unit whose root left its model without its Humanoid dying (fell out of the world) is no longer a living
		-- unit: SyncArmy re-forms it (the existing not-living path), queued at most once per owner per second and
		-- ReformPerMinute per owner per minute, and only while the owner is alive with ground under him.
		-- Recover.Enabled = false turns this off too.
		ReformRootless = true,
		ReformPerMinute = 8,
		ReformWindowSeconds = 60, -- the ReformPerMinute window
		ReformDelaySeconds = 1, -- a queued re-form runs this long after it is queued (one per owner per this)
		LandRing = 8, -- recover landings remembered per army (1-32; read once at server start)
		WaterRereadSeconds = 10, -- the WE_Water surface list is re-read at most this often, only while a recover searches
	},

	-- v91 (Code Bot, owner 2026-09-28: the army still despawned while he ran, glitched and walked into each other, and
	-- must not follow him into his base): FOLLOW movement overhaul (Server/Modules/ArmyFollow.luau). Rollout "all" |
	-- "owner" | "off" ("off" = the old v85 / v90 follow code). Wedge slots behind the owner, separation + no
	-- soldier-vs-soldier collision, straight MoveTo with throttled pathfinding only when blocked, catch-up faster than
	-- his sprint, regroup teleport (never a delete), and a wait line outside his main gate while he is in his base.
	Follow2 = {
		Enabled = true,
		Rollout = "all",
		-- claude-bud JOB 22 (docs/ARMY-FOLLOW-ROOTCAUSE.md): the stable formation controller (Shared/Util/FormationMath).
		-- false = the v99 controller exactly. Every threshold below is tunable without code.
		Stable = true,
		AnchorPosLagSeconds = 0.25, -- the formation anchor follows him with this lag (no raw-pose jumps)
		AnchorVelSmoothSeconds = 0.5, -- his velocity is smoothed over this
		AnchorLeadSeconds = 0.4, -- the slots lead his SMOOTHED velocity by this ...
		AnchorLeadMaxStuds = 4, -- ... capped
		HeadingMoveSpeed = 3, -- smoothed speed above which the heading follows his movement
		HeadingTurnDegPerSec = 90, -- the formation turns at most this fast
		HeadingDeadzoneDeg = 20, -- turns smaller than this are ignored while moving
		ReverseDeg = 120, -- a direction change past this (walking back / a hard strafe) ...
		ReverseHoldSeconds = 1.5, -- ... turns the formation only after holding this long (never a 180 flip)
		StandAlignDeg = 60, -- standing: re-aim to his facing only past this ...
		StandAlignSeconds = 1.2, -- ... held this long
		ArriveDeadzoneStuds = 1.5, -- InPosition within this of its slot ...
		LeaveDeadzoneStuds = 3, -- ... and stays InPosition until this far (hysteresis: no jitter at rest)
		MoveReissueStuds = 2.5, -- a new MoveTo only when the target moved this far ...
		MoveRefreshSeconds = 0.5, -- ... or this long passed
		MovingOnSpeed = 2.5, -- he counts as moving (escort vs follow) above this ...
		MovingOffSpeed = 1.2, -- ... until he drops under this (hysteresis)
		OwnerClearStuds = 3.5, -- soldiers keep this far from him (separation includes the owner)
		CollideWithPlayers = false, -- soldiers never push or block players (they still collide with the world)
		WedgeBack = 3, -- rank k: row = ceil(k / 2), back = WedgeBack + row x RowBack, side = +-(WedgeSide + row x RowSide)
		RowBack = 3,
		WedgeSide = 2.5,
		RowSide = 2.5,
		LeadSeconds = 0.3, -- the slot leads his move by this (capped at LeadMaxStuds)
		LeadMaxStuds = 5,
		FacingTurnDeg = 35, -- standing: the wedge turns with him only past this
		TurnRateDeg = 300, -- v99: the wedge (his root CFrame facing) turns at most this many degrees per second
		SeparationStuds = 3.5,
		SeparationGain = 3,
		SeparationMaxStuds = 3, -- v99: the separation push never moves a goal further than this
		MatchMult = 1.08, -- in the slot: his pace x this (his WalkSpeed incl. Speed Pass / Boost, or his measured speed)
		CatchUpStartStuds = 5,
		CatchUpRampStuds = 10, -- v99: x MatchMult ramps smoothly to x CatchUpMult over this many studs behind
		CatchUpMult = 1.35,
		CatchUpPerStud = 0.6,
		CatchUpMaxMult = 1.8,
		CatchUpMin = 34, -- the catch-up cap is never under this (v126: Speed Pass 22.4, Speed Boost 25.6; x1.8 = 46 -> MaxSpeed 50)
		MaxSpeed = 58, -- claude-bud JOB 40: was 50 (the fallback path also stays above a 40 runner)
		SpeedUpPerThink = 8, -- v99: WalkSpeed rises at most this much per think (0.4 s) ...
		SpeedDownPerThink = 6, -- ... and falls at most this much (smooth catch-up, no lurch)
		ArriveStuds = 2,
		ReissueStuds = 2, -- a MoveTo is re-sent only when the goal moved this far ...
		ReissueSeconds = 5, -- ... or this long passed (Humanoid.MoveTo times out after 8 s)
		PathCooldown = 1.5, -- one path per unit per this, only while the straight line to its slot is blocked
		PathBudgetPerSecond = 8, -- paths per server per second
		PathKeepStuds = 12, -- a path is kept while its end stays this near the slot ...
		PathKeepSeconds = 2, -- v99: ... or while it is younger than this (at a run the slot outruns PathKeepStuds)
		FarStuds = 100, -- v99 (was 70 / 1 s): emergency reposition only this far from its slot ...
		FarSeconds = 3, -- ... for this long
		BaseFarStuds = 140, -- while he is in his base (the wait line)
		-- v99 staged stuck: moved less than StuckStuds while its slot is more than StuckMinStuds away:
		StuckSeconds = 3, -- ... this long: a fresh path at once
		StuckAltSeconds = 6, -- ... this long: an alternate point StuckAltStuds beside it (+ a jump) for StuckAltHoldSeconds
		StuckAltStuds = 6,
		StuckAltHoldSeconds = 2.5,
		StuckTeleportSeconds = 10, -- ... this long: the reposition (the final fallback)
		StuckStuds = 3,
		StuckGoalStuds = 6,
		StuckMinStuds = 10,
		VoidBelowOwner = 60, -- regroup: this far under the owner, or within VoidMargin of FallenPartsDestroyHeight
		VoidMargin = 80,
		OwnerJumpSpeed = 60, -- an owner move faster than this on one think is a teleport / respawn: far units regroup at once
		JumpRegroupStuds = 40,
		VehicleDeferSpeed = 20, -- no regroup while he drives faster than this
		TeleportCooldown = 2.5,
		RegroupBehindStuds = 16, -- v99: a reposition lands on its own slot pushed this much further back (behind the camera)
		RegroupMinOwnerStuds = 6, -- v99: ... and never nearer him than this
		ThinkGapReset = 1.2, -- v99: no ArmyFollow think for this long (fight / other order / owner dead): fresh state
		FaceMoveStuds = 8, -- v99: further than this from its slot it faces where it runs, else his facing
		FaceAfterShotSeconds = 1.2, -- v99: after an escort shot the unit keeps facing its target this long
		SeatCompactSeconds = 4, -- v99: seats are renumbered only after the army size changed and held this long
		StandHeight = 3.2,
		BaseInStuds = 4, -- in his base: this far inside his plot square's edge (out again BaseOutStuds past it)
		BaseOutStuds = 2,
		BaseWaitOut = 12, -- the wait line: this far outside the plot's front edge (main gate) ...
		BaseWaitGap = 5, -- ... beside the gate lane (MainGateWidth / 2 + this), never in it ...
		BaseWaitSpacing = 4, -- ... then this apart, two staggered rows
		--[[ claude-bud (2026-09-29, owner: "the army still walks into the base, soldiers bunch up and walk over each
			other"): tidy follow, owner-only first. Off (Rollout not "owner"/"all" for him) = the v91 behaviour above.
			* Hold: his army stops once he is within HoldApproachStuds OUTSIDE his plot edge (not 4 studs inside), and
			  is released when he is HoldReleaseStuds out again. No follow goal of a unit outside his plot is ever inside
			  it (+ PlotPadStuds): it is swapped for that unit's wait spot, so nobody crosses his gate or plot edge.
			* Wait rows: both sides of the gate lane (MainGateWidth / 2 + WaitGap), PerRow per side per row, ColSpacing
			  apart, RowSpacing deep from WaitOut outside the front edge; each soldier turns to face out on arrival.
			* Fixed seats: each unit keeps its own seat number for life (the lowest free one when it joins), so a death
			  never reshuffles the rest; wedge rows are RowBack / RowSide apart (> SeparationStuds, never inside each
			  other); when he turns round, a row pair keeps its world sides (FlipHysteresisStuds) instead of crossing.
			* Leaving: no far / stuck teleport for LeaveGraceSeconds after he leaves his base (they walk back into the
			  wedge; the void rescue still runs). ]]
		Tidy = {
			Rollout = "all", -- v101
			-- claude-bud (owner: "still glitchy and despawns when walking"): "Flank" = a file on each side of him, all in
			-- front of the phone camera (row k: FlankFront + (k-1) x FlankRowBack studs back, negative = ahead; FlankSide +
			-- (k-1) x FlankRowSide out). "Wedge" = the old formation behind him (RowBack / RowSide below).
			Formation = "Flank",
			FlankFront = -1,
			FlankRowBack = 3,
			FlankSide = 3.5,
			FlankRowSide = 2.6,
			HoldApproachStuds = 6,
			HoldReleaseStuds = 10,
			PlotPadStuds = 2,
			WaitOut = 14,
			WaitGap = 5,
			PerRow = 4,
			ColSpacing = 4,
			RowSpacing = 4,
			RowBack = 4,
			RowSide = 3,
			FlipHysteresisStuds = 1.5,
			LeaveGraceSeconds = 8,
			-- claude-bud (owner v95 phone test fix): hold cells are raycast / overlap-checked (bad ones skipped outward),
			-- reached straight with no path and no teleport; arrival within HoldArriveStuds. ATTACK: every unit its own
			-- spot by its seat (march rows MarchPerRow x MarchSpacing, MarchAhead in front; a ring of AttackRingSpacing
			-- round the target, at least AttackRingMin), never one shared point.
			HoldArriveStuds = 1.5,
			MarchPerRow = 5,
			MarchSpacing = 3.5,
			MarchAhead = 10,
			AttackRingSpacing = 3.5,
			AttackRingMin = 8,
		},
		LogSeconds = 5,
	},

	--[[ v114 (Code Bot Roblox, owner phone test of v113; docs/ARMY-FOLLOW-ROOTCAUSE-2.md): ONE authoritative FOLLOW
		controller per army (Server/Modules/ArmyController + SoldierController + Shared/Util/FormationController).
		Enabled = false (or Rollout not "all" / "owner" for him) = the v113 behaviour exactly (Follow2 above).
		Permanent slots, a clean Flank grid (one row per unit, its escorts further out in the row), a smoothed anchor, a
		rate-limited heading with deadband + hysteresis, MoveTo only every UpdateSeconds and only when the goal moved,
		arrival deadzone with hysteresis, catch-up by WalkSpeed, staged stuck recovery, reposition (PivotTo) only as the
		emergency fallback. In FOLLOW the escort code only shoots / aims (no MoveTo). ]]
	Follow3 = {
		Enabled = true,
		Rollout = "all", -- "all" | "owner" | anything else = off (v113)
		UpdateSeconds = 0.2, -- the controller tick (MoveTo is never sent more often than this)
		-- v115 (docs/ARMY-FOLLOW-ROOTCAUSE-3.md): a BLOCK BEHIND him on his breadcrumb trail (FormationController)
		Formation = "TrailBlock",
		VelSmoothSeconds = 0.3, -- his velocity is smoothed over this (moving / standing only)
		MovingOnSpeed = 3, -- he counts as moving above this smoothed speed ...
		MovingOffSpeed = 1.5, -- ... until he drops under this (rows only turn while he moves)
		TrailSmoothSeconds = 0.4, -- crumbs are dropped from his position smoothed this much (joystick zig-zags soften)
		CrumbStuds = 1, -- a crumb every this many studs he travels (none while he stands)
		TrailKeepStuds = 90, -- path kept (the oldest crumb's direction runs on straight back past it)
		TangentStuds = 3, -- a row faces his path's direction measured over +- this many studs at its arc
		FirstRowStuds = 7, -- the front row sits this far behind him ALONG HIS PATH ...
		RowSpacing = 4.5, -- ... each next row this much further back along it
		ColSpacing = 5, -- columns this far apart (an even count) ...
		AisleStuds = 7, -- ... except the two inner ones: this far apart, a lane down his own trail (an about-turn)
		ColumnsMax = 4, -- columns = ceil(sqrt(units + escorts)) rounded up to even, 2..this
		RowTurnDegPerSec = 100, -- a row turns at most this fast ...
		RowDeadbandDeg = 8, -- ... only once its path direction is this far off (stops within 1.5 deg), only while he moves
		FoldDeg = 120, -- past this (his path doubled back: an about-turn) a row reverses in place, sides mirrored
		SlotVelBlend = 0.5, -- a slot's velocity (its MoveTo lead and pace) is smoothed by this per tick
		OwnerClearStuds = 5, -- a goal is never nearer him than this ...
		OwnerAheadSeconds = 1, -- ... nor in his walking lane (this much of his travel ahead, LaneHalfStuds each side;
		OwnerAheadMaxStuds = 16, -- ... at most this long): on an about-turn the units on his old path step aside ...
		YieldSpeed = 24, -- ... at least this fast
		LaneHalfStuds = 3.5, -- (= AisleStuds / 2: a unit in his lane steps out to the aisle's edge, not into the next column)
		PartMaxStuds = 5, -- a row he walks back into parts: each half steps out (column order kept) by at most this ...
		PartRampStuds = 12, -- ... ramped in over this much of his approach beyond his lane
		EscortTrail = true, -- clients draw each unit's escorts on the unit's OWN path behind it (RigAnimator), RowSpacing apart
		-- JOB 23 (claude-bud, docs/ARMY-FOLLOW-ROOTCAUSE-4.md): the block is ONE steered body (FormationController.SteerFrames)
		-- instead of rows riding his trail (their slots turned his corners / hairpins at full speed). Steer = false: v115 rows.
		Steer = true,
		FormGain = 3.2, -- its centre closes the gap to its steering point (on his path, behind him) at this per second ...
		FormAccel = 24, -- ... its velocity speeding up / changing course at most this much per second (it keeps going briefly) ...
		FormBrake = 60, -- ... slowing down at most this much (he stops: it stops with him; no coasting into his new path) ...
		FormMaxSpeed = 24, -- ... never faster than this (or FormSpeedMult x his speed in a vehicle), less |turn rate| x radius
		FormSpeedMult = 1.25,
		TurnSlowFactor = 1, -- (while turning it travels that much slower: no slot ever moves faster than FormMaxSpeed)
		BubbleStuds = 3, -- its centre steers no nearer him than its radius + this (no slot swings into him on a corner)
		WaitAheadStuds = 0, -- he walks back into it (its centre this far ahead of him along his walk): it waits, holding its heading
		SteerHeadingPath = false, -- its heading steers to his movement direction NOW (true: his path's direction at the block)
		SlotLateralSpeed = 10, -- turning moves any slot sideways at most this fast: turn rate cap = this / the block's radius
		TurnGain = 2.5, -- turn rate asked per radian of heading error (its heading = his MOVEMENT direction only) ...
		TurnAccelSeconds = 0.4, -- ... reached over this (angular inertia); starts past RowDeadbandDeg, ends within 1.5 deg
		SettleTurnPerSec = 0.8, -- inside RowDeadbandDeg it drifts onto his heading this fast (no standing tilt, no jitter)
		SteerLeadSeconds = 0.35, -- a soldier walks toward its slot + its slot's velocity x this (capped) ...
		SteerLeadMaxStuds = 6, -- ... and is re-aimed when it nears that point off its slot (no stop-start inside a turn)
		SpeedDeadzoneStuds = 1, -- soldier WalkSpeed = its slot's speed + SpeedGain per stud of error past this ...
		SpeedGain = 0.9,
		SpeedLatGain = 0.6, -- ... + this per stud beside it (behind: faster, ahead: slower), one continuous law ...
		SpeedMaxBonus = 14, -- ... at most this over its slot's speed ...
		SpeedMaxSlow = 8, -- ... at most this under it ...
		SpeedSmoothSeconds = 0.1, -- ... eased toward it over this (no step at a state change: the states are labels only)
		-- JOB 24 (claude-bud, docs/ARMY-ATTACK-ROOTCAUSE.md): ATTACK = the same steered block (ArmyController), ONE sticky
		-- squad target (SquadOrdersService pickSquadTarget; units only shoot / aim). AttackSteer = false: the v116 attack.
		AttackSteer = true,
		AttackStandoff = 36, -- the block's centre stops this far from the target on its own side, facing it (fire band 46.75)
		AttackMaxSpeed = 16, -- it advances (and slides into / out of the line) no faster than this
		AttackFeedMax = 12, -- a moving target's velocity is fed forward up to this
		AttackDeployStuds = 8, -- within this of its spot it deploys into the line (folds back past twice this) ...
		AttackDeploySeconds = 1.2, -- ... over at least this, longer when a slot must slide further than AttackSlideSpeed allows
		AttackSlideSpeed = 8,
		AttackLinePerRank = 6, -- the line: this many abreast per rank (centre-out by permanent slot: nobody changes sides) ...
		AttackLineSpacing = 6, -- ... this far apart; the next rank behind with room for its escorts
		AttackAggroStuds = 120, -- the squad target: a hostile within this of the army's centre (OrdersConfig.AttackAggroRange) ...
		AttackKeepExtraStuds = 20, -- ... the current one kept out to this much further ...
		AttackRetargetStuds = 15, -- ... unless another one is this much nearer ...
		AttackLeashStuds = 140, -- ... and never one further than this from him (past it the army follows him again)
		SpikeErrStuds = 6, -- debug: a soldier this far from its slot, or a slot faster than a soldier can run, is logged
		DebugPanelSeconds = 0.5, -- debug: the owner's formation panel refresh
		-- v115 debug (owner-visible, toggleable): slot markers + labels on his client, per-soldier logs on the server.
		-- Debug = false: nothing at all. Default on for DebugUserIds; anyone listed toggles it with /armydebug.
		Debug = false, -- JOB 24: no debug visuals for anyone by default (true = on by default for DebugUserIds)
		DebugUserIds = { 470626172 }, -- only these can turn it on (/armydebug, admin allowlist)
		DebugLogSeconds = 2, -- the per-soldier state line, per army, this often
		DebugPublishStuds = 0.5, -- WE_SlotPos (the marker) is rewritten only when the slot moved this far
		-- soldier (SoldierController)
		ArriveStuds = 2.5, -- in its slot within this (he stands) ...
		LeaveStuds = 4, -- ... and stays there until this far (hysteresis)
		ReissueStuds = 2.5, -- a new MoveTo only when the goal moved this far ...
		RefreshSeconds = 6, -- ... or this long passed (Humanoid.MoveTo gives up after 8 s)
		MoveLeadSeconds = 0.25, -- while he moves a unit walks toward its slot + ITS SLOT's smoothed velocity x this ...
		MoveLeadMaxStuds = 4, -- ... capped (it never reaches the goal and stops mid-walk)
		CatchUpStartStuds = 6, -- catching up past this far from its OWN slot ...
		CatchUpEndStuds = 3, -- ... until back within this (hysteresis)
		TrimPerStud = 0.6, -- in step: WalkSpeed = its slot's pace + this per stud behind its slot (- ahead of it) ...
		LateralPerStud = 0.5, -- ... + this per stud beside it
		CatchUpPerStud = 0.9, -- catching up: WalkSpeed = its slot's pace + this per stud from its slot ...
		CatchUpMaxMult = 1.8, -- ... capped at max(his pace x this, CatchUpMin), never over MaxSpeed
		CatchUpMin = 30,
		MaxSpeed = 58, -- claude-bud JOB 40: x1.45 of the 40-stud/s Speed Boost owner (v133: 46 for 32). v133 (Code Bot): was 40; the x2 Speed Boost owner runs 32 (the block: max(FormMaxSpeed, his
		-- speed x FormSpeedMult) = 40): 46 keeps a soldier's catch-up headroom over his pace (x1.45, as at 25.6)
		MinSpeed = 8,
		SpeedUpPerTick = 6, -- WalkSpeed changes at most this much per tick up ...
		SpeedDownPerTick = 5, -- ... and down
		FaceTurnDegPerSec = 240, -- in its slot the unit turns to the heading at most this fast (no gyro snap)
		FaceAfterShotSeconds = 1.2, -- after a shot it keeps its aim this long
		-- stuck (progress < StuckProgressStuds while its goal is beyond the deadzone)
		StuckProgressStuds = 1,
		StuckReissueSeconds = 2.5, -- 1) re-issue MoveTo (+ a jump)
		StuckPathSeconds = 5, -- 2) a path (waypoints)
		StuckAltSeconds = 7.5, -- 3) a reachable point beside it for StuckAltHoldSeconds
		StuckAltStuds = 6,
		StuckAltHoldSeconds = 2,
		StuckRepositionSeconds = 10, -- 4) reposition, only this far from its slot and out of his view
		StuckRepositionMinStuds = 20,
		BlockedPathTicks = 2, -- the straight line to its goal blocked this many ticks in a row: a path
		PathMinStuds = 8,
		PathKeepSeconds = 2.5,
		PathKeepStuds = 10,
		PathCooldown = 1.5,
		PathBudgetPerSecond = 8,
		-- emergency reposition (SoldierController.Reposition, the only PivotTo)
		FarStuds = 120, -- this far from its slot ...
		FarSeconds = 4, -- ... this long
		VoidBelowOwner = 60,
		VoidMargin = 80,
		OwnerJumpSpeed = 80, -- he moved faster than this on foot in one tick: a teleport / respawn (anchor snaps)
		VehicleDeferSpeed = 20, -- no reposition while he drives faster than this
		RepositionBehindStuds = 16, -- the spot: its slot pushed this far back (behind the phone camera) ...
		RepositionMinOwnerStuds = 8, -- ... never nearer him than this
		RepositionCooldown = 5,
		AuditSeconds = 5, -- collision groups re-checked on every unit part this often
		YawPublishDeg = 3, -- WE_FormYaw (its row's heading) is written only when it moved this much
		LogSeconds = 5,
	},
	-- claude-bud JOB 24 §2 (docs/ARMY-ATTACK-ROOTCAUSE.md): an ATTACKING army (Follow3.AttackSteer) also fights enemy
	-- PLAYERS and base defenders, server-side: the squad target may be an enemy player (CombatService.UnitMayHitPlayer:
	-- PvP, clan ally, spawn / novice shields -> "Protected"), a gate / tower guard of a base that is not his or an ally's,
	-- or a CombatService NPC; a soldier with no line of sight to a player standing behind a gate shoots the gate. Kills
	-- are credited to the army owner (players: cash, XP, MOST KILLS; NPCs: as his own kills; guards: the JOB 20 guard
	-- reward). Enabled = false: the army hits NPCs only, as v116.
	-- claude-bud JOB 26 (owner: "the attack works but they should be stronger"): the soldier's base numbers (Enabled =
	-- false: OrdersConfig AttackDamage 8 / AttackFireRate 1.8 / UnitHealth 90 and ArmyCombat.PlayerMaxDps, as v118).
	-- Research scales them: Marksman Training (SoldierDamage) = Firepower, Combat Drills (SoldierFireRate) = Training,
	-- Body Armor (SoldierHealth) = Toughness.
	StrongerArmy = {
		Enabled = true,
		Damage = 12, -- per hit (x research), x ArmyCombat.PlayerDamageMult on players
		FireRate = 2.2, -- shots per second per soldier (x research)
		Health = 150, -- soldier max HP (x research)
		PlayerMaxDps = 50, -- per victim per army (a full army kills an unarmoured player in ~2 s, a Titan one in ~4 s)
		NpcHitMarkersPerSecond = 4, -- the owner sees a hit marker / damage number for his army's NPC hits, this often at most
		TracerMinGap = 0.15, -- ArmyConfig.ShotFx.PerArmyMinGap while on (more visible tracers; the per-recipient cap stays)
	},
	-- claude-bud JOB 43: ARMY VS ARMY BRAWL (Modules/ArmyBrawl). Enemy soldiers are targets too (players first), under
	-- CombatService.ArmyHostility, re-checked per shot (CombatService.ApplyUnitUnitHit). Owner-first by the SHOOTING
	-- army's owner; OFF = today (soldiers ignore enemy soldiers).
	ArmyBrawl = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone
		UnitDamageMult = 1, -- x OrdersConfig.AttackDamage (research-scaled) per soldier hit on an enemy soldier
		MaxCandidates = 8, -- the nearest enemy soldiers considered per think pass
		KillXP = 10, -- XP to the owner per enemy soldier killed by his army
		PairCreditPer10Min = 30, -- at most this many credited soldier kills (XP + ARMY KILLS) per owner pair per 10 min
	},
	ArmyCombat = {
		Enabled = true,
		TargetPlayers = true,
		TargetGuards = true,
		ShootGates = true,
		PlayerDamageMult = 0.6, -- x OrdersConfig.AttackDamage (research-scaled) per soldier hit on a player
		PlayerMaxDps = 40, -- per victim per army: a full army never deletes a player instantly (time to kill >= 2.5 s)
		GuardDamageMult = 1,
		GateDamageMult = 1,
		CreditSteeredAttackKills = true, -- NPC kills by a steered ATTACK pay the owner (the 140-stud leash keeps him near)
		ProtectedNoteSeconds = 8, -- "X is protected" to the attacker at most this often per victim
		HitLogSeconds = 5, -- debug (/armydebug): the per-kind hit / miss / blocked counts, this often
		-- v124 (Code Bot, phone bug "my ATTACK army shot the bank guards but never the player killing me beside it"):
		-- the squad target's priority tiers (FormationController.PickTargetTiered). PreferPlayers: an enemy player
		-- (CombatService.UnitMayHitPlayer: THE shared PvP rule + never a clan ally) in reach outranks every guard / NPC,
		-- so a sticky NPC target no longer hides him; false = the v123 nearest-first pick. AggressorSeconds: one who hurt
		-- the owner within this outranks every other player (0 = off).
		PreferPlayers = true,
		AggressorSeconds = 10,
		TargetLogSeconds = 2, -- debug (/armydebug): the [ArmyTarget] per-candidate verdict line, this often per army
		-- v133 (Code Bot, phone bug "I stood right in front of another player's army and it never fired; my shots did
		-- nothing to it"). Proven causes: (1) only ATTACK ever looked at players (pickSquadTarget ran for st.Order ==
		-- "Attack" only; the FOLLOW / HOLD escort scans WE_NPC models only), and every army is on FOLLOW by default;
		-- (2) every player shot excluded the whole WarEmpireSquads folder (CombatService shotFilterFor), so bullets
		-- flew through enemy soldiers and no player could hurt one.
		-- DefendOnFollow: a FOLLOW / HOLD army engages an enemy player in reach under THE shared rule
		-- (CombatService.UnitMayHitPlayer; protected / ally / PvP off never), from its slot (no movement change).
		-- DefendPlayerStuds: an enemy player this close to the army's centre (or its owner); one who hurt the owner or
		-- his soldiers within AggressorSeconds is answered out to DefendAggressorStuds. PlayersHitUnits: player guns /
		-- rockets hurt enemy soldiers (CombatService.ArmyHostility); false = the v132 pass-through.
		DefendOnFollow = true,
		DefendPlayerStuds = 47, -- (= the fire band OrdersConfig.AttackRange 55 x 0.85: the FOLLOW army does not walk out to him)
		DefendAggressorStuds = 55, -- (the full AttackRange: he shot first)
		PlayersHitUnits = true,
	},

	Gate = {
		-- The owner's FOLLOW units within RaidConfig.Defense.GateOpenRadius open his friendly gate, only while he is
		-- alive within OwnerNearStuds (flat) of it, and units alone (no owner / ally player at the gate) for at most
		-- UnitHoldSeconds in a row: they pass through with him (or come home to him) and it shuts behind them; units
		-- that stand there after that keep it shut. Units on Hold / Attack / Retreat never open it.
		OwnUnitsOpen = true,
		OwnerNearStuds = 40,
		UnitHoldSeconds = 8,
		-- ...and that 8 s count starts over only once no FOLLOW unit of his has been at the gate for UnitRearmSeconds
		-- (units shuffling in and out of the circle while he idles near it never re-open it again and again)
		UnitRearmSeconds = 3,
		-- ship (crossing rule, the FIX round-3 reviewers' GATETAIL): a unit holds the gate open only while it is still on
		-- the far side of the barrier from him (its centre not more than CrossClearStuds past the barrier plane on his
		-- side). Units that are through never hold it behind him: stand-in, the owner stopping 16 studs inside with a
		-- raider tailing him 35 / 50 / 70 studs behind: the barrier stayed open 9.6 s after he passed and the raider
		-- walked in (4d26673: 1.4 s, kept out; with this rule: 1.6 s, kept out). false = the round-2 rule.
		-- CrossClearStuds 0 (ship fix round 1, GATECAMP): with 3, his rear-rank units standing in their slots against the
		-- shut barrier on HIS side counted as crossing: him standing 13-16 studs from the gate (beyond his own 12-stud
		-- GateOpenRadius) opened it for ~9 s after each turn and a raider camping at it walked in (4d26673: shut). A unit
		-- mid-crossing is covered by RaidConfig.Defense.GateCloseDelay (1 s).
		CrossingRule = true,
		CrossClearStuds = 0,
	},

	-- The FOLLOW think loop runs every army on the server in one task: an error in one owner's motion or one unit's
	-- think is caught (pcall), logged at most once per owner per ErrorLogSeconds, and the loop goes on.
	Loop = {
		ErrorLogSeconds = 30,
	},
}

-- army lane A0: the rollout value of one part, normalised ("off" for a missing part or any other value: fail closed)
function ArmyConfig.RolloutOf(part: string): string
	local r = (ArmyConfig :: any).Rollout
	local v = if typeof(r) == "table" then r[part] else nil
	if v == "owner" or v == "all" then
		return v
	end
	return "off"
end

-- army lane A0: is this rollout part live for this UserId? "all" = everyone; "owner" = the owner's playtest account only
-- (AdminConfig.IsPlaytestOwner, as AircraftWeaponConfig.LiveFor); "off" = nobody. Pure; the server evaluates it.
function ArmyConfig.LiveFor(part: string, userId: any): boolean
	local v = ArmyConfig.RolloutOf(part)
	if v == "all" then
		return true
	end
	if v == "owner" then
		return AdminConfig.IsPlaytestOwner(userId) == true
	end
	return false
end

-- army lane A0: LiveFor for a Player (false for anything that is not a Player)
function ArmyConfig.IsLive(part: string, player: any): boolean
	if typeof(player) ~= "Instance" or not (player :: Instance):IsA("Player") then
		return false
	end
	return ArmyConfig.LiveFor(part, (player :: Player).UserId)
end

-- Follow.ThreatStandingFor: is the standing-only near-hostile pacing live for this player? ("owner": the playtest
-- owner's account only, AdminConfig.IsPlaytestOwner; "all": everyone; anything else: nobody, the round-1 rule)
function ArmyConfig.ThreatStandingFor(userId: any): boolean
	local f = ArmyConfig.Follow
	local v = if typeof(f) == "table" then (f :: any).ThreatStandingFor else nil
	if v == "all" then
		return true
	end
	return v == "owner" and AdminConfig.IsPlaytestOwner(userId) == true
end

--[[ claude-bud JOB 32: while the owner is inside (or on the roof of) an enterable building (Modules/Enterables: the
	PlazaBuildingsConfig houses), FOLLOW forms the block up outside its door, facing it, instead of behind him. The
	units never walk in, never climb the stair, and are never teleported: the owner's measured speed is zero while he is
	held, so no jump / far / pace recovery fires. Enabled = false: the army follows him exactly as before. ]]
ArmyConfig.Indoors = {
	Enabled = true,
}

return ArmyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ArmyOrdersConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 38 (2026-09-30): ARMY ATTACK ORDERS (docs/claude-queue/JOB38-army-attack-orders.md). Every number here;
	the fairness rules (Fairness) are DECIDED by the owner (2026-09-30), defaults unchanged.
	  1. ATTACK = auto-clear: seek the nearest hostile group within SeekRadius of the owner, march there as the SAME steered
	     block (the formation follows the plan's lead point instead of the owner), fight until the group is gone, chain to
	     the next within ChainRadius (MaxChain per order), then return and fold into FOLLOW.
	  2. SEND: the army walks to another online player's base (no teleport, no fast travel), sieges it in Siege.Priority
	     order, breaches the gate through the existing gate path, holds the ATM (Raid.HoldSeconds, not hit) and loots
	     StealFraction x ArmyLootMult into the sender's ATM, then walks home.
	  3. Fairness (server-side, at the request and during the plan): shield, new player / novice shield, online only, the
	     sender cooldown, the victim's army protection, allies never, no PvP-off server, the power verdict.
	  4. Turret HP (AutoGuns can be shot down, then rebuild) behind TurretHP.Enabled; players and armies alike.
	  5. The ARMY KILLS board replaces TOP ARMY once this is live for everyone.
	Kill switch: Live (RetentionConfig.Live rule: OwnerFirst = UserId 470626172 + Studio). Off / not live for the owner =
	today's Follow / Attack / Hold / Retreat exactly (the JOB 24 attack, leash 140), no SEND, no new UI, turrets without HP.
]]

local ArmyOrdersConfig = {
	Live = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone
	},

	-- 1. ATTACK auto-clear
	SeekRadius = 250, -- studs from the owner for the first target group
	ChainRadius = 150, -- studs from the army for the next group
	MaxChain = 4, -- target groups per ATTACK order
	SeekLeash = 300, -- the owner leash while auto-clearing (was AttackLeashStuds 140); beyond it: finish, then return
	ArriveStuds = 40, -- the block centre this close to the target group: FIGHT (the AttackStandoff deploy takes over)
	ReturnDoneStuds = 25, -- back within this of the owner: the plan ends, FOLLOW
	FightGiveUpSeconds = 60, -- a fight with no damage dealt / no progress for this long: the group counts as out of reach

	-- the march (the lead point the block follows; the formation standard is Follow3's)
	MarchSpeed = 14, -- studs/s: the lead point's speed (the block slows for its slowest soldier)
	LeadMaxGap = 18, -- the lead point waits while the block centre is this far behind it
	RepathSeconds = 2, -- at most one re-plan per army per this many seconds
	LegStuds = 400, -- the route is planned in legs of at most this length
	RouteRetries = 3, -- failed plans before "No route" (the army holds; no teleport fallback)
	PathBudgetPerSecond = 2, -- route computes per second, server-wide (PathfindingService)
	StuckSeconds = 6, -- the lead point without block progress this long: re-plan the leg
	RoutingTimeoutSeconds = 20, -- v165: a path request still outstanding this long is asked again (the march never hangs)
	MarchAnswerStuds = 60, -- v165: on the march only a player who hurt him / his soldiers, within this of the block, is answered
	MarchAnswerSeconds = 10, -- ... in the last this many seconds (CombatService.RecentlyHurtBy)
	LostStuds = 90, -- a unit this far from the block for LostSeconds is marked LOST (reported, never moved)
	LostSeconds = 15,

	-- Code Bot (army command bug, 2026-10-01): the ONE command path (Server/Modules/ArmyCommand + ArmyState)
	-- SEND to a map area / site (ArmyTargets "A:<id>" / "S:<id>"): the block walks to the target's APPROACH POINT
	-- (Approach[id] when set, else ApproachExtraStuds outside the objective where a road enters it), clears the hostiles
	-- within EngageExtraStuds of the objective (EngagingTarget), then HOLDS there. Capture stays the player's
	-- (TerritoryCapture counts players only): the army clears the defenders and guards the spot.
	Travel = {
		ApproachExtraStuds = 30, -- the approach ring: this far outside the objective's radius (Central Plaza: 70 + 30)
		AreaRadiusCap = 80, -- an area without an outpost: its objective radius is at most this
		EngageExtraStuds = 60, -- arrived: hostiles within objective radius + this are fought
		ClearHoldSeconds = 2, -- no hostile left for this long: the area is clear, the army holds
		EngageMaxSeconds = 120, -- a fight at the target with no end for this long: the army holds anyway
	},
	Approach = {} :: { [string]: { Vector3 } }, -- per-target approach points ("A:Town" = { Vector3.new(0, 1, 100) }); empty = computed
	RecallFarStuds = 60, -- FOLLOW / RECALL with the army this far from him: it marches back as a block first (Recalling)
	RetreatPlanStuds = 120, -- RETREAT with the army this far from home: it marches home as a block first
	-- ATTACK (DECIDED by Code Bot, owner bug 2026-10-01): seek the nearest valid hostile within SeekRadius of the ARMY
	-- (of him while it is beside him); none = "No enemies near" and the army stays in its previous state (no broken
	-- ATTACK). The radius is NOT raised (the owner's list: "bigger detection radius" is a fake fix).

	--[[ claude-bud JOB 52 (2026-10-01, Shaun: "ATTACK says No enemies near while enemies are clearly visible"): ATTACK AT
		RANGE. ROOT CAUSE (tools/sim/run_attack_range_test.py): the probe reach was SeekRadius 250 from him, but awake enemies
		stand where the wake / sleep bands keep them (OutpostDefender WakeStuds 260 / SleepStuds 380, SiteActivity 380), so
		the ones he could see were 260-380 studs out; and even a bigger reach alone would not hold: SeekLeash 300 cut
		them again, and the running plan re-sought / fought with SeekLeash 300 from him (it dropped the target it marched to).
		Live: ONE set of radii for the whole order (the probe, the plan's seek, its march answer, its fight pick, the leash
		check): SeekStuds 400 (one route leg, LegStuds 400, under 30 s at MarchSpeed 14), LeashStuds 450, ChainStuds 200;
		flat distances. Nothing within SeekStuds: the toast says the distance + direction to the nearest valid enemy and
		offers PIN / SEND ("N:<npcId>" through ArmyTargets; the client never sends a position). Kills of the ordered target
		group count on ARMY KILLS, at most KillCreditPerHour per owner (no AFK farm). OFF == OLD (250 / 300 / 150). ]]
	AttackRange = {
		Enabled = true,
		OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 52): Code Bot flips it after Shaun's 2-player phone test
		SeekStuds = 400,
		LeashStuds = 450,
		ChainStuds = 200,
		NearestScanStuds = 2500, -- "Nearest: 620 m NE": how far the nothing-in-range scan looks
		KillCreditPerHour = 60, -- ordered-ATTACK army kills of hostile combat NPCs credited per owner per rolling hour
		Text = {
			NoneInRange = "No enemies within %d m. Nearest: %d m %s",
			NoneAtAll = "No enemies on the map",
		},
	},

	-- 2. SEND
	Send = {
		RequireOwnerAlive = false, -- DECIDED: the army keeps attacking while the sender is dead but in the server
		StandoffStuds = 34, -- the siege position outside the gate
		SiegeMaxSeconds = 240,
		AtmHoldStuds = 10, -- the lead unit within this of the victim's ATM holds it (RaidConfig.Raid.RadiusStuds)
	},
	Siege = {
		Priority = { "Turret", "Guard", "Gate", "InsideGuard", "Atm" } :: { string },
		ReachStuds = 120, -- structures / guards within this of the army centre are siege targets
	},
	ArmyLootMult = 0.5, -- DECIDED: an army raid takes StealFraction x 0.5 (5 % of the ATM)

	-- 3. Fairness (DECIDED 2026-09-30)
	Fairness = {
		SendCooldownSeconds = 300, -- per sender, after any SEND that reached a siege
		VictimLeftCooldownSeconds = 150, -- the victim left mid-march / mid-siege: half
		ProtectAfterSiegeSeconds = 600, -- per victim base, after any army raid (looted or not)
		MinPowerRatio = 0.25, -- ArmyPower < this x DefencePower: "Too weak" (blocked)
		BullyRatio = 4, -- ArmyPower > this x DefencePower: loot x BullyLootMult
		BullyLootMult = 0.5,
		RiskyRatio = 1, -- below this (and above MinPowerRatio): "risky"
	},

	-- 4. Turret HP
	TurretHP = {
		Enabled = true,
		HealthByLevel = { 400, 550, 700 }, -- walls level 4, 5, 6+ (AutoGuns exist from walls level 4)
		RebuildSeconds = 90,
	},

	-- 5. ARMY KILLS board: the NPC types whose army kills count (plus base / tower guards and players, credited elsewhere)
	ArmyKillNpcTypes = { CheckpointGuard = true, BankGuard = true } :: { [string]: boolean },

	-- the status line / HUD strip / debug
	StatusSeconds = 1, -- the SquadOrderStateUpdate plan status, at most this often
	DefenderMarkerSeconds = 2, -- the defender's red map marker updates
	DebugLogSeconds = 2, -- [ArmyPlan] / [ArmyRoute] / [ArmyMarch] / [ArmySiege] lines, per owner (ArmyController.DebugFor)
	Text = {
		Seeking = "SEEKING",
		Marching = "MARCHING -> %s %d m",
		Fighting = "FIGHTING %d left",
		Cleared = "CLEARED %d",
		Returning = "RETURNING",
		Sieging = "SIEGE %s",
		Looting = "LOOTING %d s",
		NoRoute = "No route to %s",
		Left = "Army left for %s",
		Arrived = "Arrived at %s",
		Breached = "Gate breached!",
		Looted = "Looted $%s",
		NoLoot = "Gate breached, no loot (%s)",
		Wiped = "Army wiped out",
		Home = "Army home",
		Incoming = "⚠ %s's ARMY is marching on your base, ETA %s",
		NothingNear = "No enemies near",
		Travelling = "TRAVELLING -> %s %d m", -- Code Bot (army command bug): a SEND to an area / site
		Engaging = "ENGAGING at %s",
		HoldingAt = "HOLDING %s",
		Sent = "Army sent to %s",
		AreaClear = "%s clear: your army holds it",
		CaptureHint = "%s clear: your army holds it. Stand in the zone to capture",
		Retreating = "RETREATING home",
	},
}

local RetentionConfig = require(script.Parent.RetentionConfig)

function ArmyOrdersConfig.LiveFor(userId: any): boolean
	return RetentionConfig.Live(ArmyOrdersConfig.Live, userId)
end

-- live for every player (the ARMY KILLS board swap waits for this)
function ArmyOrdersConfig.LiveForAll(): boolean
	local L = ArmyOrdersConfig.Live
	return L.Enabled == true and L.OwnerFirst ~= true
end

-- the loot fraction of the ATM for an army raid (bully = far stronger army)
function ArmyOrdersConfig.LootFraction(stealFraction: number, bully: boolean): number
	local f = stealFraction * ArmyOrdersConfig.ArmyLootMult
	if bully then
		f *= ArmyOrdersConfig.Fairness.BullyLootMult
	end
	return f
end

-- the AutoGun HP for a walls level (0 = no HP: AutoGuns only from walls level 4)
function ArmyOrdersConfig.TurretHealth(wallsLevel: number): number
	local list = ArmyOrdersConfig.TurretHP.HealthByLevel
	local i = math.floor(wallsLevel) - 3
	if i < 1 then
		return 0
	end
	return list[math.min(i, #list)]
end

-- claude-bud JOB 52: the ATTACK radii for this owner: (seek, leash, chain) studs. AttackRange live: its numbers (seek
-- clamped 300-500, leash >= seek); else the old SeekRadius / SeekLeash / ChainRadius exactly.
function ArmyOrdersConfig.AttackRadii(userId: any): (number, number, number)
	local A: any = (ArmyOrdersConfig :: any).AttackRange
	local live = typeof(A) == "table" and (require(script.Parent.RetentionConfig) :: any).Live(A, userId)
	if not live then
		return ArmyOrdersConfig.SeekRadius, ArmyOrdersConfig.SeekLeash, ArmyOrdersConfig.ChainRadius
	end
	local seek = math.clamp(tonumber(A.SeekStuds) or 400, 300, 500)
	return seek, math.max(seek, tonumber(A.LeashStuds) or seek + 50), math.max(50, tonumber(A.ChainStuds) or 200)
end

function ArmyOrdersConfig.AttackRangeLive(userId: any): boolean
	local A: any = (ArmyOrdersConfig :: any).AttackRange
	return typeof(A) == "table" and (require(script.Parent.RetentionConfig) :: any).Live(A, userId)
end

-- the compass word for a flat direction (dx, dz) in world space (-Z = north, as the map / compass draw it)
function ArmyOrdersConfig.Compass8(dx: number, dz: number): string
	local a = math.deg(math.atan2(dx, -dz)) % 360
	local names = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
	return names[(math.floor((a + 22.5) / 45) % 8) + 1]
end

return ArmyOrdersConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">ArmyUpgradeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 4.4 (2026-09-29): army upgrades at the Barracks. Soldier HP / damage upgrades already exist as the
	Research "Soldiers" track (Body Armor = SoldierHealth, Marksman Training = SoldierDamage: cash, saved per player in
	the profile's research levels, applied by SquadOrdersService). A second, parallel upgrade would stack power, so this
	adds the missing SHOP: a prompt at the player's own Barracks ("Army Upgrades") that opens that track. Buying stays
	ResearchService.Purchase (server: price, cash, max level, save). The server tells only players it is live for
	where their Barracks prompt goes (FeaturePush "ArmyUpgrades"); the prompt is local to them.
	Rollout "owner" = AdminConfig.IsPlaytestOwner only, "all", anything else = off (Research Lab only, as before).
]]

local AdminConfig = require(script.Parent.AdminConfig)

local ArmyUpgradeConfig = {
	Rollout = "all", -- v101
	Track = "Soldiers",
	-- plot-local spot (BaseLayoutConfig frame): in front of the Barracks (Site -110, 110, Yaw 90), toward the plot centre
	PromptX = -88,
	PromptZ = 110,
	PromptY = 3,
	MaxActivationDistance = 14,
}

function ArmyUpgradeConfig.LiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("ArmyUpgrades") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = ArmyUpgradeConfig.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return AdminConfig.IsPlaytestOwner(userId)
	end
	return false
end

return ArmyUpgradeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">BalanceConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 10 (2026-09-29): the balance / progression table (one place for the numbers). Owner-only first.

	Why (tools/progression_sim.py, a base-income-only floor; the live game also has soldiers, oil, missions, drops):
	  * today the whole base costs $11.2M and earns ~$13k/min when complete: late pads take 55-140 HOURS to pay back
	    (MissileDefense L5 139 h, DefensiveWalls L5 78 h): dead purchases;
	  * the first rebirth needs level 40 (292,371 XP) but every purchase together pays ~18k XP and nothing else scales with
	    the base, so the first rebirth takes many hours of kills / missions.
	What this does for a player it is live for:
	  * PaybackMinutes: each base pad level pays its own price back in PaybackMinutes[level] minutes of passive income
	    (level 1 fastest). Every pad is worth buying, and the next pad is always minutes away;
	  * IncomeXP: Per1000 XP for every $1,000 of passive income (reason "income"; the battle pass is not fed by it), so
	    building the base IS levelling up;
	  * sim (tools/progression_sim.py, base income only): base complete ~34 min, level 40 (first rebirth) ~34 min, every
	    pad pays back within 25 min (was up to 139 h); a finished base earns ~780k/min. Target FirstRebirthMinutes.
	  * Robux-only vehicles: their numbers live in VehicleConfig.Premium (owner 2026-09-29: clearly overpowered).
	Businesses keep their own IncomePerTick table (unchanged). Rollout "owner" / "all" / off (off = today's curve).
]]

local AdminConfig = require(script.Parent.AdminConfig)
local BaseConfig = require(script.Parent.BaseConfig)
local EconomyConfig = require(script.Parent.EconomyConfig)

local BalanceConfig = {
	Rollout = "all", -- v101
	FirstRebirthMinutes = { Min = 25, Max = 40 },
	PaybackMinutes = { 2, 3, 6, 12, 25 } :: { number },
	IncomeXP = {
		Enabled = true,
		Per1000 = 25,
		GrantAtLeast = 25, -- XP is banked and paid in lumps of at least this (fewer level-bar updates)
	},
	StartingCash = 10000, -- (EconomyConfig.StartingCash; listed here for the whole picture)
	-- set to true ONLY by the client that the server marked (player attribute WE_Balance2): TycoonMath's labels then use
	-- this curve. The server never sets it (it pays through BaseService per player).
	ClientCurve = false,
}

function BalanceConfig.LiveFor(userId: any): boolean
	local mode = BalanceConfig.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return AdminConfig.IsPlaytestOwner(userId)
	end
	return false
end

-- total $ per tick of a base structure at `level` under this curve (nil: not a base structure -> keep the old formula)
function BalanceConfig.StructureIncomePerTick(id: string, level: number): number?
	local def = (BaseConfig.Structures :: any)[id]
	if def == nil or typeof(def.Costs) ~= "table" then
		return nil
	end
	local tick = EconomyConfig.PassiveIncome.TickSeconds
	local total = 0
	local lvl = math.clamp(math.floor(tonumber(level) or 0), 0, def.MaxLevel or #def.Costs)
	for i = 1, lvl do
		local cost = tonumber(def.Costs[i]) or 0
		local pay = BalanceConfig.PaybackMinutes[math.min(i, #BalanceConfig.PaybackMinutes)]
		total += cost / (pay * 60 / tick)
	end
	return math.floor(total)
end

return BalanceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">BankRaidConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Empire Bank raid — high-value contested vault with NPC guards + per-player cooldown (saved on the profile).

	W3 step 2, lane F ("bank findable", spec w3s2 §6 Phase A):
	- Guards stand on FIXED posts, never a ring round the vault (the ring put 2 of 5 inside the building).
	  BankRaidService reads the geometry's "Town.Bank" npc anchors (roles G1..Gn, WE_ActivityAnchor; MapSetup stamps
	  them on BankPlaza with the walk-in hall, lane BK) and falls back to GuardPosts below if they are missing.
	- Only a raider ON FOOT holds the vault (seated → "LEAVE VEHICLE" on the HUD, no progress, no pay).
	- The cooldown is saved as profile.Raid.BankCooldownUntil (os.time seconds; sanitised by BankRaidService).
	- The vault label reads "Empire Bank" + one state line: OPEN · rob the vault / RAID ON (everyone) and
	  CLOSED 4m (only the player who is on cooldown; drawn by BankRaidController on that client).
]]

export type GuardPost = {
	X: number,
	Y: number, -- world Y of the standing surface (the plaza top is 1.6, the ground 0.5)
	Z: number,
	Yaw: number?, -- degrees, 0 faces north (-Z), 180 faces south (+Z, down Bank Street)
}

local BankRaidConfig = {
	Enabled = true,
	BankId = "EmpireBank",
	DisplayName = "Empire Bank",
	Position = Vector3.new(220, 1, -220),
	VaultRadius = 12,
	RaidHoldSeconds = 6, -- v71: 8 → 6 (task #20 bank retune; guard stats in CombatConfig.NPCTypes.BankGuard)
	CooldownSeconds = 300, -- 5 min per player after a successful raid (saved: profile.Raid.BankCooldownUntil)
	CashMin = 15000,
	CashMax = 35000,
	GuardNPCType = "BankGuard",
	GuardCount = 5, -- at most this many fallback posts are used (the anchor posts are all used)
	-- The bank zone radius round Position: the WorldDress keep-out (WorldDress: this + BankExtra) and the novice
	-- shield's "engaging the bank" test (CombatService). Guards no longer spawn on a ring.
	GuardRingRadius = 18,
	-- Anchor site / role pattern read by BankRaidService (spec w3s2 §5: Town.Bank.G1..G5 on BankPlaza)
	AnchorSite = "Town.Bank",
	GuardRolePattern = "^G%d+$",
	-- HumanoidRootPart height above the standing surface (R6: 2-stud legs + half the 2-stud torso)
	GuardRootLift = 3,
	-- Fallback posts (lane BK): the same five posts as the Town.Bank G1..G5 anchors MapSetup stamps on BankPlaza (G1 / G2
	-- behind the planters, G3 / G4 beside the columns, G5 inside the hall by the vault door). Used only while no
	-- "Town.Bank" G anchors exist.
	GuardPosts = {
		{ X = 206, Y = 1.6, Z = -209.5, Yaw = 180 },
		{ X = 234, Y = 1.6, Z = -209.5, Yaw = 180 },
		{ X = 210.5, Y = 1.6, Z = -210.5, Yaw = 180 },
		{ X = 229.5, Y = 1.6, Z = -210.5, Yaw = 180 },
		{ X = 227, Y = 1.6, Z = -231, Yaw = 180 },
	} :: { GuardPost },
	-- Owner phone test 2026-09-27: "when you kill the bank guards they respawn super fast, it never gives you a chance to
	-- rob the bank". Was: each guard came back CombatConfig.NPCRespawnSeconds (18 s) after its OWN death, on its post,
	-- wherever the raider stood, so a phone player's five-guard fight (20-40 s) never emptied the bank. Now
	-- BankRaidService owns the respawn (SpawnNPC opts NoRespawn) and brings the dead guards back as ONE group:
	--   due      = the last bank-guard death + DelaySeconds (every kill restarts it), or a payout + AfterRaidSeconds if
	--              that is sooner; for each guard at most MaxDownSeconds after its own death (a fight cannot keep it
	--              away for ever), never sooner than CombatConfig.NPCRespawnSeconds after it (no faster kill farm)
	--   robbing  = someone's vault hold is running: nobody comes back, at most RaidDeferMaxSeconds past due
	--   free     = no living player within ClearRadius of the post and none within SightRadius who can see it
	--   forced   = still blocked ForceAfterSeconds past due (a camper, an AFK farmer on the vault): the guard comes back
	--              anyway, never within MinSpawnStuds of a player (an occupied post moves it to the nearest clear spot)
	-- Kill cash / XP (CombatConfig.NPCTypes.BankGuard, CombatFairnessConfig unit shares) are unchanged.
	-- Enabled = false restores the old per-guard respawn exactly. Jobs ON (OpsService, Town.Bank) does not read this.
	GuardRespawn = {
		Enabled = true,
		DelaySeconds = 90, -- walk-in + the 6 s hold is ~15-25 s on a phone; 90 also covers a death, the respawn and the drive back
		MaxDownSeconds = 180, -- killing the one returning guard every DelaySeconds cannot keep the other four away
		AfterRaidSeconds = 30, -- after a payout the robbers get this long to walk away before the bank refills
		RaidDeferMaxSeconds = 60,
		ClearRadius = 25, -- studs (3D, root to post)
		SightRadius = 150, -- studs; a player's eye (root + 1.5) sees the post's torso or head (collidable parts block)
		ForceAfterSeconds = 45,
		MinSpawnStuds = 8,
		CheckSeconds = 1, -- the post / sight test runs at most this often, and only while guards are due
	},
	NotifyOnRaid = true,
	-- v71: the hold freezes only while the raider was hit within this many seconds (was: any health below 95 %)
	UnderFireSeconds = 2,
	-- One-time tip the first time a player comes this close to Position (saved: profile.Raid.BankSeen)
	FirstVisitRadius = 150,
	FirstVisitSkipIfHitSeconds = 5, -- not while the player is being shot at; retried on a later tick
	-- The painted EMPIRE BANK sign on the bank's "BankSign" part (WorldKits.Sign, inside the world sign budget);
	-- painted only when that part has no SurfaceGui yet, on the face turned most toward SignFacing (the street side)
	Sign = {
		PartName = "BankSign",
		Text = "EMPIRE BANK",
		Facing = Vector3.new(0, 0, 1),
	},
	-- Copy seen by every device (no key names, no "tap" / "click")
	Text = {
		FirstVisit = "Empire Bank: stand on the vault to loot",
		Reward = "Bank job +$%s", -- %s = cash with commas
	},
	-- vault label (Shared/Util/WorldLabel): stud-scaled, never AlwaysOnTop, MaxDistance <= 40 (spec §5)
	Label = {
		Name = "WE_BankRaidStatus",
		StateAttribute = "WE_BankState", -- "open" | "raid" (the public state; the client reads it back)
		Title = "Empire Bank",
		OpenSub = "OPEN · rob the vault",
		OpenColor = Color3.fromRGB(120, 230, 130),
		RaidingSub = "RAID ON",
		RaidingColor = Color3.fromRGB(255, 176, 48),
		ClosedSub = "CLOSED %dm", -- %d = whole minutes left, rounded up (this player's own cooldown)
		ClosedColor = Color3.fromRGB(190, 190, 190),
		Color = Color3.fromRGB(255, 220, 120),
		HeightStuds = 8, -- above the vault pad centre (clear of a standing raider's head)
		MaxDistance = 40,
	},
}

return BankRaidConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">BaseConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	15 structure types, 5 levels each.
	Barracks costs match spec: 2500, 10000, 35000, 100000, 300000.
	Other structures use similar escalating curves.
]]

export type StructureDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MaxLevel: number,
	Costs: { number }, -- Cash cost to purchase level 1..MaxLevel (index = target level)
	Currency: "Cash" | "Gold",
	Requires: { { StructureId: string, Level: number } }?,
	PassiveIncomeBonus: number?, -- extra flat cash/tick at each level (also in EconomyConfig)
	Kind: string?, -- nil = building / installation; "Business" = a v72 war business merged from BusinessConfig
}

local BaseLayoutConfig = require(script.Parent.BaseLayoutConfig)
local BusinessConfig = require(script.Parent.BusinessConfig)

local function costs(a: number, b: number, c: number, d: number, e: number): { number }
	return { a, b, c, d, e }
end

local BaseConfig = {
	-- claude-bud JOB 21: 10 plots (was 6). Everything else reads MaxPlots / PlotPositions / #PlotPositions.
	MaxPlots = 10,
	-- claude-bud JOB 21: a player who still has no free plot 8 s after joining is moved to another public server
	FullServerTeleport = true,
	-- v68: follows BaseLayoutConfig.PlotSize (320) while the layout is on — MapSetup builds pads that size
	PlotSize = if BaseLayoutConfig.Enabled
		then Vector3.new(BaseLayoutConfig.PlotSize, 1, BaseLayoutConfig.PlotSize)
		else Vector3.new(200, 1, 200),
	-- World positions — keep in sync with MapSetup PLOT_POSITIONS (ring ~800, ground ~4800)
	PlotPositions = {
		Vector3.new(-800, 0.5, -400),
		Vector3.new(-800, 0.5, 400),
		Vector3.new(0, 0.5, -800),
		Vector3.new(0, 0.5, 800),
		Vector3.new(800, 0.5, -400),
		Vector3.new(800, 0.5, 400),
		-- claude-bud JOB 21 (owner: every plot needs a dock): 4 more plots near the map edge, backs to the water, so each
		-- Dock channel (WaterConfig.Channels) runs straight out of the rear into the ring canal (north) or the sea
		-- (south) crossing no road, POI or capture; each gate apron joins its nearest +-800 road by a WorldFill spur.
		-- Clear of every other plot, the Town, POIs, captures and water (tools/checks/claude_bud_plots.py).
		Vector3.new(-980, 0.5, -1300), -- P7: rear north -> Ring_NW
		Vector3.new(980, 0.5, -1300), -- P8: rear north -> Ring_NE
		Vector3.new(-1000, 0.5, 1280), -- P9: rear south -> the sea
		Vector3.new(560, 0.5, 1280), -- P10: rear south -> the sea
	} :: { Vector3 },

	Structures = {
		CommandCenter = {
			Id = "CommandCenter",
			DisplayName = "Command Center",
			Description = "HQ for your base. Unlocks further construction.",
			MaxLevel = 5,
			Costs = costs(1500, 8000, 30000, 90000, 250000),
			Currency = "Cash",
			Requires = nil,
		},
		Barracks = {
			Id = "Barracks",
			DisplayName = "Barracks",
			Description = "Train and house soldiers. Strong passive income.",
			MaxLevel = 5,
			Costs = costs(2500, 10000, 35000, 100000, 300000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		VehicleDepot = {
			Id = "VehicleDepot",
			DisplayName = "Vehicle Depot",
			Description = "Maintain and unlock ground vehicles.",
			MaxLevel = 5,
			Costs = costs(3000, 12000, 40000, 120000, 350000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		WeaponsFacility = {
			Id = "WeaponsFacility",
			DisplayName = "Weapons Facility",
			-- v72: with the war businesses on, the Weapons Facility gates the Arms Crate Line
			Description = if BusinessConfig.Enabled then "Arms storage. Unlocks the Arms Crate Line." else "Research and unlock advanced weapons.",
			MaxLevel = 5,
			Costs = costs(2800, 11000, 38000, 110000, 320000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		Helipad = {
			Id = "Helipad",
			DisplayName = "Helipad",
			Description = "Landing pad for rotary-wing aircraft.",
			MaxLevel = 5,
			Costs = costs(5000, 20000, 70000, 200000, 500000),
			Currency = "Cash",
			Requires = { { StructureId = "VehicleDepot", Level = 2 } },
		},
		Dock = {
			Id = "Dock",
			DisplayName = "Naval Dock",
			Description = "Harbor berth for patrol boats and warships.",
			MaxLevel = 5,
			Costs = costs(4500, 18000, 65000, 190000, 520000),
			Currency = "Cash",
			Requires = { { StructureId = "VehicleDepot", Level = 2 } },
		},
		Airfield = {
			Id = "Airfield",
			DisplayName = "Airfield",
			Description = "Runway for fixed-wing fighters.",
			MaxLevel = 5,
			Costs = costs(8000, 35000, 120000, 350000, 900000),
			Currency = "Cash",
			Requires = { { StructureId = "Helipad", Level = 2 } },
		},
		DefensiveWalls = {
			Id = "DefensiveWalls",
			DisplayName = "Defensive Walls",
			Description = "Perimeter fortifications.",
			MaxLevel = 5,
			Costs = costs(2000, 9000, 32000, 95000, 280000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		Watchtowers = {
			Id = "Watchtowers",
			DisplayName = "Watchtowers",
			Description = "Elevated lookouts and light defense.",
			MaxLevel = 5,
			Costs = costs(2200, 9500, 34000, 98000, 290000),
			Currency = "Cash",
			Requires = { { StructureId = "DefensiveWalls", Level = 1 } },
		},
		Radar = {
			Id = "Radar",
			DisplayName = "Radar Station",
			Description = "Early warning and map intel.",
			MaxLevel = 5,
			Costs = costs(4000, 16000, 55000, 160000, 450000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 2 } },
		},
		ResearchLab = {
			Id = "ResearchLab",
			DisplayName = "Research Lab",
			Description = "Tech bonuses and prestige prep.",
			MaxLevel = 5,
			Costs = costs(4500, 18000, 60000, 180000, 480000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 2 } },
		},
		MissileDefense = {
			Id = "MissileDefense",
			DisplayName = "Missile Defense",
			Description = "Anti-air / anti-missile batteries.",
			MaxLevel = 5,
			Costs = costs(6000, 25000, 85000, 250000, 700000),
			Currency = "Cash",
			Requires = { { StructureId = "Radar", Level = 2 } },
		},
		PowerStation = {
			Id = "PowerStation",
			DisplayName = "Power Station",
			Description = "Powers advanced systems; income boost.",
			MaxLevel = 5,
			Costs = costs(3500, 14000, 48000, 140000, 400000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		Warehouse = {
			Id = "Warehouse",
			DisplayName = "Warehouse",
			Description = "Storage logistics — strongest passive income.",
			MaxLevel = 5,
			Costs = costs(3200, 13000, 45000, 130000, 380000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		SpecialForcesFacility = {
			Id = "SpecialForcesFacility",
			DisplayName = "Special Forces Facility",
			Description = "Elite units and late-game power.",
			MaxLevel = 5,
			Costs = costs(10000, 40000, 150000, 400000, 1_200_000),
			Currency = "Cash",
			Requires = { { StructureId = "Barracks", Level = 3 }, { StructureId = "ResearchLab", Level = 2 } },
		},
	} :: { [string]: StructureDef },

	-- Order for upgrade UI
	StructureOrder = {
		"CommandCenter",
		"Barracks",
		"VehicleDepot",
		"WeaponsFacility",
		"PowerStation",
		"Warehouse",
		"DefensiveWalls",
		"Watchtowers",
		"Radar",
		"ResearchLab",
		"Helipad",
		"Dock",
		"Airfield",
		"MissileDefense",
		"SpecialForcesFacility",
	},
}

--[[ v72 war businesses (BusinessConfig) are bought at their own consoles like any structure: while Enabled they are
	merged here (Kind = "Business") so the one purchase path (BaseService.PurchaseUpgrade), saving
	(profile.BaseUpgrades), requirements, rebirth reset and the Base panel cover them. Appended after the 15 literal
	ids above (BuyPathStatic's MapSetup-row rule reads only that literal list; businesses are built by
	BusinessService and have their own rule). Disabled: nothing is merged and BaseConfig is exactly as before v72. ]]
if BusinessConfig.Enabled then
	for _, id in ipairs(BusinessConfig.Order) do
		local b = BusinessConfig.Businesses[id]
		if b and BaseConfig.Structures[id] == nil then
			BaseConfig.Structures[id] = {
				Id = b.Id,
				DisplayName = b.DisplayName,
				Description = b.Description,
				MaxLevel = #b.Costs,
				Costs = b.Costs,
				Currency = "Cash",
				Requires = b.Requires,
				Kind = BusinessConfig.Kind,
			}
			table.insert(BaseConfig.StructureOrder, id)
		end
	end
end

return BaseConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BaseLayoutConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v68: player base layout (plot-local studs). One source of truth for MapSetup (plot build), the
	structure kits / walk-in buildings, consoles and the rear-zone gates.

	Axes (plot-local): +Z = FRONT (main gate, spawn road), -Z = rear. X = across the plot.
	v70: each plot has its own frame (BaseLayout.PlotCFrame). With FaceMapCentre the plot is turned (yaw snapped to 90)
	so its FRONT faces the map centre and the rear zone (runway, helipad, dock + sea gate) faces outward:
	P1/P2 yaw 90 (front +X), P3 yaw 0, P4 yaw 180, P5/P6 yaw -90. Everything below stays plot-local.
	Yaw (degrees) is the direction a building's FRONT faces: 0 = +Z, 90 = +X, -90 = -X, 180 = -Z.

	Zones
	  Main compound  Z -60 .. front wall. Walk-in buildings face a central parade ground and road.
	  Rear zone      behind the inner wall (Z = -60): runway + hangar, helipads, dock basin.
	                 Each rear area sits behind its own inner gate, which opens when that structure is
	                 bought (Airfield / Helipad / Dock) and is guarded.

	Consoles: every structure is bought/upgraded at a console (the WE_UpgradeSlot part). Walk-in buildings
	have theirs inside, near the door (Console = building-local position). Outdoor installations have a
	kiosk (KioskOffset = plot-local position). Consoles are prompt/tap only — no walk-over buying.
]]

export type Vec2 = { X: number, Z: number }

export type StructureSite = {
	Site: Vec2, -- footprint centre (plot-local)
	Yaw: number, -- degrees, direction the front faces
	WalkIn: boolean, -- HollowBuildingBuilder building (Console is building-local) vs outdoor kit (kiosk)
	Console: Vec2?, -- walk-in: building-local position of the console (X across, Z toward the front)
	Kiosk: Vec2?, -- outdoor: plot-local kiosk position
	Gate: string?, -- rear-zone structures: inner gate id opened by buying this structure
}

local BaseLayoutConfig = {
	Enabled = true,
	FaceMapCentre = true, -- v70 waterways go-live: bases face the map centre so every Dock channel reaches the ring. Rollback = false (MapSetup MAP_GEN 71↔70 forces a map rebuild either way)
	PlotSize = 320, -- was 200; 6 plots on the 800-stud ring still clear roads/event spawns (see ASSUMPTIONS)
	SpawnOffset = { X = 0, Z = 136 },
	MainGateWidth = 14,

	InnerWall = {
		Z = -60,
		Height = 14,
		Thickness = 2.4,
		GateWidth = 16,
		Gates = {
			Airfield = { X = -100 },
			Helipad = { X = 40 },
			Dock = { X = 92 }, -- west of the basin, so the path runs along the kerb, not into the water
		} :: { [string]: { X: number } },
		-- v72 (read by MapSetup's gate signs once the v72 world lane lands; unused before): sign text inset from the
		-- sign board's edges, so "HELIPAD" / "AIRFIELD" read in full on a phone
		SignInsetStuds = 2.0,
	},

	-- Roads (plot-local rectangles: centre + size) — asphalt with painted edges
	Roads = {
		{ Name = "MainRoad", X = 0, Z = 64, SizeX = 14, SizeZ = 184 }, -- gate → Command Center
		{ Name = "Avenue", X = 0, Z = 80, SizeX = 200, SizeZ = 12 }, -- west row ↔ east row
		{ Name = "Plaza", X = 0, Z = 8, SizeX = 60, SizeZ = 50 }, -- parade ground in front of CC
		{ Name = "Taxiway", X = -100, Z = -66, SizeX = 12, SizeZ = 12 }, -- airfield gate → runway
		-- v90 (owner 2026-09-28: "make the runway and hangar slightly bigger"): 170 x 24 -> 190 x 29 (+12 % long, the most
		-- the plot edge (X -160) and the HeliApron (X 34) allow; +21 % wide). Was X -65, SizeX 170, SizeZ 24.
		{ Name = "Runway", X = -63, Z = -80, SizeX = 190, SizeZ = 29 }, -- under / beside the hangar kit's strip
		{ Name = "HeliApron", X = 40, Z = -86, SizeX = 12, SizeZ = 50 }, -- helipad gate → pad
		{ Name = "HangarApron", X = -100, Z = -100, SizeX = 40, SizeZ = 11 }, -- runway → hangar doors (v90: the wider hangar; was Z -98.5, 34 x 13)
	},

	Courtyard = {
		Collector = { X = -42, Z = 118 }, -- ATM / money collector (premium pads arranged around it)
		TrainingYard = { X = 46, Z = 30 },
		Flagpole = { X = 0, Z = 8 },
		DockBasin = { X = 128, Z = -112, SizeX = 50, SizeZ = 70 },
	},

	-- Sandbag berms / crates / barriers dressing the base edges (MapSetup PlotWarzone)
	WarzoneSpots = {
		{ X = -146, Z = 146 }, { X = 146, Z = 146 }, { X = -146, Z = 80 }, { X = 146, Z = 80 },
		{ X = -146, Z = 28 }, { X = 146, Z = 28 }, { X = -30, Z = -52 }, { X = 25, Z = -8 },
		{ X = -20, Z = -100 }, { X = 10, Z = -150 }, { X = -150, Z = -150 }, { X = 80, Z = -150 },
	} :: { Vec2 },

	Structures = {
		CommandCenter = { Site = { X = 0, Z = -38 }, Yaw = 0, WalkIn = true, Console = { X = 10.5, Z = 6 } },
		Barracks = { Site = { X = -110, Z = 110 }, Yaw = 90, WalkIn = true, Console = { X = 13.5, Z = 8 } },
		WeaponsFacility = { Site = { X = -110, Z = 55 }, Yaw = 90, WalkIn = true, Console = { X = 12.5, Z = 7 } },
		SpecialForcesFacility = { Site = { X = -110, Z = 0 }, Yaw = 90, WalkIn = true, Console = { X = 12.5, Z = 7 } },
		VehicleDepot = { Site = { X = 110, Z = 110 }, Yaw = -90, WalkIn = true, Console = { X = 15.5, Z = 10 } },
		Warehouse = { Site = { X = 110, Z = 55 }, Yaw = -90, WalkIn = true, Console = { X = 14.5, Z = 9 } },
		ResearchLab = { Site = { X = 110, Z = 0 }, Yaw = -90, WalkIn = true, Console = { X = 12.5, Z = 7 } },
		PowerStation = { Site = { X = -60, Z = -40 }, Yaw = 0, WalkIn = false, Kiosk = { X = -60, Z = -24 } },
		Radar = { Site = { X = 70, Z = -40 }, Yaw = 0, WalkIn = false, Kiosk = { X = 70, Z = -24 } },
		MissileDefense = { Site = { X = 132, Z = -40 }, Yaw = 0, WalkIn = false, Kiosk = { X = 132, Z = -24 } },
		-- Kiosks stand in front of their kits (a kiosk inside the wall sample / tower body could not be reached)
		DefensiveWalls = { Site = { X = -18, Z = 146 }, Yaw = 0, WalkIn = false, Kiosk = { X = -18, Z = 134 } },
		Watchtowers = { Site = { X = 18, Z = 146 }, Yaw = 0, WalkIn = false, Kiosk = { X = 18, Z = 134 } },
		-- Airfield: hangar installation (Installations/Airfield) behind the runway, doors facing it (+Z)
		-- v90: Site Z -122 -> -125 so the 17 % bigger hangar (68 x 40) keeps its doors on the apron (Z -145 .. -105)
		Airfield = { Site = { X = -100, Z = -125 }, Yaw = 0, WalkIn = false, Kiosk = { X = -86, Z = -52 }, Gate = "Airfield" },
		Helipad = { Site = { X = 40, Z = -125 }, Yaw = 0, WalkIn = false, Kiosk = { X = 54, Z = -52 }, Gate = "Helipad" },
		-- v70: the dock kit stands on the basin's west shore (was centred IN the basin, where its collidable Body was an
		-- island in the boats' spawn water); pier along the kerb, parked boat moored in the basin's west edge
		Dock = { Site = { X = 78, Z = -112 }, Yaw = 90, WalkIn = false, Kiosk = { X = 106, Z = -52 }, Gate = "Dock" },
		-- v72 war businesses (BusinessConfig; built by BusinessService only while BusinessConfig.Enabled, looked up by
		-- id, so these lines are inert until then). 22 x 12 lines facing the plot centre (Yaw 180), kiosk 10 studs
		-- toward the gate. Prototype census: 0 overlaps at L5, kiosks >= 36.6 studs apart, farthest 8.2 s from the ATM.
		AmmoWorks = { Site = { X = -30, Z = 100 }, Yaw = 180, WalkIn = false, Kiosk = { X = -30, Z = 90 } },
		ArmsCrateLine = { Site = { X = -66, Z = 100 }, Yaw = 180, WalkIn = false, Kiosk = { X = -66, Z = 90 } },
		ArmorPlatePress = { Site = { X = 34, Z = 60 }, Yaw = 180, WalkIn = false, Kiosk = { X = 34, Z = 50 } },
		RocketAssembly = { Site = { X = 70, Z = 60 }, Yaw = 180, WalkIn = false, Kiosk = { X = 70, Z = 50 } },
	} :: { [string]: StructureSite },

	-- v72: the 9 static painted floor arrows (MapSetup.paintPlotFloorChevrons, 18 parts per plot) pointed back at the
	-- gate and never moved on after the Command Center; the per-player NEXT pointer replaces them. Read by MapSetup
	-- once the v72 world lane lands (unused before). true = keep the old arrows.
	FloorChevrons = false,
}

return BaseLayoutConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BaseLifeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ claude-bud JOB 57: base life. A lived-in base on the OWNER's plot (owner-first by the plot owner; OFF = today):
	  * Props: part-built WorldKits rows (tents, crate / ammo stacks, drum groups, sandbag nests and lines, a container
	    stack) on clear ground (plot-local X / Z, BaseLayoutConfig frame), counted against the ONE per-plot allowance
	    StorePropsConfig.Budget.MaxBasePartsPerPlot (600, JOB 40 C) and never inside StorePropsConfig.BaseKeepOut. The
	    store-model BaseRows (StorePropsConfig) stay empty until a model passes the owner's WE_CHECK2 probe.
	  * Soldiers: a few unarmed ambient soldiers that idle and patrol fixed loops (Routes). Not CombatService NPCs: never
	    hostile, no weapon, CanQuery off (shots pass through), not tagged WE_NPC. PerBase each, at most ServerMax in a
	    server (= CombatConfig.MaxActiveNPCs, 18). One server loop at ThinkHz for all of them. ]]

export type Row = { Kit: string, X: number, Z: number, Yaw: number, Opts: { [string]: any }? }
export type Point = { X: number, Z: number }

local BaseLifeConfig = {
	Enabled = true,
	OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 57): Code Bot flips it after Shaun's phone test
	Props = {
		-- the west camp, by the facilities row
		{ Kit = "Tent", X = -80, Z = 22, Yaw = 90 },
		{ Kit = "CrateStack", X = -57, Z = 26, Yaw = 0, Opts = { Variant = "ammo", Count = 3 } },
		{ Kit = "DrumGroup", X = -57, Z = 40, Yaw = 30, Opts = { Count = 3 } },
		-- the depot yard
		{ Kit = "Tent", X = 60, Z = 112, Yaw = -90 },
		{ Kit = "CrateStack", X = 68, Z = 124, Yaw = 15, Opts = { Count = 2 } },
		{ Kit = "DrumGroup", X = 54, Z = 124, Yaw = 0, Opts = { Count = 2 } },
		-- the command centre's east side
		{ Kit = "SandbagNest", X = 50, Z = -10, Yaw = 0 },
		{ Kit = "CrateStack", X = 80, Z = 20, Yaw = -20, Opts = { Variant = "ammo", Count = 2 } },
		-- the rear yard
		{ Kit = "ContainerStack", X = -20, Z = -130, Yaw = 90, Opts = { Count = 2 } },
		-- the side edges
		{ Kit = "SandbagLine", X = -140, Z = 0, Yaw = 90, Opts = { Length = 20 } },
		{ Kit = "SandbagLine", X = 140, Z = 0, Yaw = 90, Opts = { Length = 20 } },
	} :: { Row },
	Soldiers = {
		PerBase = 3,
		ServerMaxFromCombat = true, -- ServerMax = CombatConfig.MaxActiveNPCs (18): one number, never more figures than that
		WalkSpeed = 7,
		IdleSeconds = { 4, 9 },
		ThinkHz = 2,
		ArriveStuds = 2.5,
		LegTimeout = 14, -- a leg that takes longer (blocked) ends in IDLE at once, then the next point
		VisualKind = "Guard", -- VisualAssetService.TryAttachCharacterVisual (the house R6 soldier; RigAnimator walks it)
		Routes = {
			{ { X = -66, Z = 8 }, { X = -48, Z = 8 }, { X = -48, Z = 56 }, { X = -66, Z = 56 } },
			{ { X = 46, Z = 98 }, { X = 78, Z = 98 }, { X = 78, Z = 134 }, { X = 46, Z = 134 } },
			{ { X = 2, Z = -118 }, { X = -42, Z = -118 }, { X = -42, Z = -142 }, { X = 2, Z = -142 } },
		} :: { { Point } },
	},
}

-- the soldier brain (pure; the tests): IDLE -> PATROL when the idle time is up; PATROL -> IDLE on arrival or timeout
function BaseLifeConfig.Next(state: string, ctx: { Now: number, IdleUntil: number, LegStarted: number, Dist: number }): string
	local S = BaseLifeConfig.Soldiers
	if state == "IDLE" then
		return if ctx.Now >= ctx.IdleUntil then "PATROL" else "IDLE"
	end
	if ctx.Dist <= S.ArriveStuds or ctx.Now - ctx.LegStarted >= S.LegTimeout then
		return "IDLE"
	end
	return "PATROL"
end

return BaseLifeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">BaseMarkerConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 40 part E (2026-09-30, owner-approved PRIORITY): the BASE OWNER MARKER, visible from anywhere on the
	map (docs/claude-queue/JOB40-guards-speed-props-like-reminder.md part E). Above each occupied base: the owner's
	nation flag, DisplayName, @username and rebirth rank. It is the ONE documented exception to the "world labels within
	40 studs / AlwaysOnTop only for the objective marker" rule (CLAUDE.md world-label bullet, ASSUMPTIONS).
	  * the SERVER only publishes data (Services/BaseMarkerService: ReplicatedStorage.WE_BaseMarkers, one Configuration
	    per plot, attributes written only on change, event-driven + a 5 s refresh; nothing per frame);
	  * the CLIENT builds one BillboardGui per plot (Controllers/BaseMarkerController) and fades / scales / compacts
	    them together at most 10 Hz.
	Owner-first by VIEWER (Live: Enabled + OwnerFirst): off = no marker, the v123 base sign and the map unchanged.

	claude-bud JOB 40E FIX (2026-09-30, the owner's phone screenshots): the tags were too big (150-230 px boxes, a fifth
	of a phone screen each), too low (70 studs: from 1,000+ studs that is ~4 degrees above eye level, across the skyline),
	showed grey empty "OPEN BASE" / "?" tags, and a "VETERAN" title in the view. Now:
	  * HIGH in the sky: HeightAt(dist) = 150 studs + 6 % of the distance (max 260), so a far tag still sits well above
	    the horizon (1,000 studs away: 210 up = ~12 degrees);
	  * a SLIM pill sized to its text: a small flag + the short name (14-17 px real); the @handle and a short "R3" only
	    inside DetailStuds; never the rebirth title;
	  * small far, a little bigger near (ScaleAt: 1.0 far .. 1.2 near, clamped; a far tag is never bigger than a near
	    one); fades out past FarFadeStart .. FarFadeEnd;
	  * at most MaxShown rival tags (the nearest), and never two overlapping on screen (the farther one hides);
	  * no tag for a base without a live owner or a name (never grey / empty); "YOU" on the own base, which still fades
	    out inside HideInsideStuds.
]]

local RetentionConfig = require(script.Parent.RetentionConfig)

local BaseMarkerConfig = {
	Live = {
		Enabled = true,
		OwnerFirst = false, -- live for everyone
	},
	FolderName = "WE_BaseMarkers", -- ReplicatedStorage (streaming-safe: never a workspace lookup on the client)
	RefreshSeconds = 5, -- the server's fallback refresh (claims / leaves / nation / rebirth also push at once)
	HeightStuds = 150, -- JOB 40E FIX: the minimum height above the plot centre (was 70; the tallest base kit is < 100)
	HeightPerStud = 0.06, -- + this x the viewer's distance, so a far tag stays in the sky
	MaxHeightStuds = 260,
	MaxDistance = 5000, -- the BillboardGui limit; the tags fade out much sooner (FarFade*)
	AlwaysOnTop = true,
	HideInsideStuds = 60, -- hidden this close (the v123 sign takes over) ...
	FadeInsideStuds = 90, -- ... fading in to full at this distance
	FarFadeStart = 1800, -- JOB 40E FIX: full up to here ...
	FarFadeEnd = 2400, -- ... gone past here
	ShowOpenBases = false, -- JOB 40E FIX: never a grey / empty tag for a base without a live owner
	-- size (real px on the screen; BillboardGui offsets are not under the HUD UIScale)
	PillHeight = 24, -- the slim pill at scale 1 (far)
	DetailHeight = 40, -- inside DetailStuds: a second line with the @handle and "R<n>"
	DetailStuds = 300,
	NameTextSize = 14, -- 14 px real at scale 1 (the CLAUDE.md minimum), up to 16.8 near
	UserTextSize = 12, -- the secondary @handle line (near only)
	MaxNameWidth = 96, -- longer names are cut with "..."
	PadPx = 6,
	MinScale = 1.0, -- far
	MaxScale = 1.2, -- near
	NearStuds = 150, -- MaxScale at or under this ...
	FarStuds = 1500, -- ... MinScale at or past this
	MaxShown = 5, -- rival tags at once (the nearest); the own base is always allowed
	OverlapPadPx = 4, -- two tags whose screen boxes come closer than this: the farther one hides
	-- claude-bud JOB 47 (ghost label behind the INTEL OFFICE pill): a tag whose box reaches into the top-bar row (the
	-- Roblox inset where the LV / cash / compass pills sit) hides, so no tag ever shows through a HUD pill
	TopBarPadPx = 6,
	UpdateHz = 10,
	Colors = {
		Plate = Color3.fromRGB(24, 26, 21),
		Stroke = Color3.fromRGB(90, 100, 80),
		Name = Color3.fromRGB(245, 245, 240),
		Muted = Color3.fromRGB(176, 184, 170),
		Rank = Color3.fromRGB(214, 178, 64),
		You = Color3.fromRGB(90, 200, 120),
		Ally = Color3.fromRGB(90, 160, 230),
		Open = Color3.fromRGB(150, 150, 150),
		NoFlag = Color3.fromRGB(70, 85, 55),
	},
	Text = { Open = "OPEN BASE", You = "YOU" },
}

function BaseMarkerConfig.LiveFor(userId: any): boolean
	return RetentionConfig.Live(BaseMarkerConfig.Live, userId)
end

-- 0 (hidden) .. 1 (full) by the viewer's distance to the plot centre: fades in past 60..90 (the v123 sign takes over
-- near the base) and out past FarFadeStart..FarFadeEnd
function BaseMarkerConfig.Fade(dist: number): number
	local B = BaseMarkerConfig
	local near = math.clamp((dist - B.HideInsideStuds) / (B.FadeInsideStuds - B.HideInsideStuds), 0, 1)
	local far = 1 - math.clamp((dist - B.FarFadeStart) / (B.FarFadeEnd - B.FarFadeStart), 0, 1)
	return math.min(near, far)
end

-- how high above the plot centre the tag floats for a viewer at `dist` (in the sky, never across the ground view)
function BaseMarkerConfig.HeightAt(dist: number): number
	local B = BaseMarkerConfig
	return math.clamp(B.HeightStuds + B.HeightPerStud * math.max(0, dist), B.HeightStuds, B.MaxHeightStuds)
end

-- the tag's scale at a distance: MaxScale near .. MinScale far (clamped; never bigger far than near)
function BaseMarkerConfig.ScaleAt(dist: number): number
	local B = BaseMarkerConfig
	local a = math.clamp((dist - B.NearStuds) / (B.FarStuds - B.NearStuds), 0, 1)
	return B.MaxScale + (B.MinScale - B.MaxScale) * a
end

-- the short rank for the near line: "R3"; nil at R0 (no rebirth title on the tag any more: JOB 40E FIX)
function BaseMarkerConfig.RankText(prestige: number, _titleFor: any?): string?
	local p = math.max(0, math.floor(tonumber(prestige) or 0))
	return if p > 0 then string.format("R%d", p) else nil
end

-- a tag is drawn only for a base with a live owner AND a name (never grey, never empty)
function BaseMarkerConfig.HasTag(owner: any, name: any): boolean
	return typeof(owner) == "number" and typeof(name) == "string" and string.match(name, "%S") ~= nil
end

--[[ which tags show this step. tags = { { Key, Dist, X, Y, W, H, Mine } } (screen px, centre + size; only tags on
	screen with a fade > 0). The own base first, then the nearest rivals up to MaxShown; a tag whose screen box comes
	within OverlapPadPx of one already shown hides (so the farther of two overlapping tags hides). ]]
function BaseMarkerConfig.VisibleSet(tags: { any }): { [any]: boolean }
	local B = BaseMarkerConfig
	local list = table.clone(tags)
	table.sort(list, function(a, b)
		if (a.Mine == true) ~= (b.Mine == true) then
			return a.Mine == true
		end
		return a.Dist < b.Dist
	end)
	local out: { [any]: boolean } = {}
	local shown: { any } = {}
	local rivals = 0
	for _, t in ipairs(list) do
		if t.Mine == true or rivals < B.MaxShown then
			local clear = true
			for _, s in ipairs(shown) do
				if math.abs(t.X - s.X) * 2 < t.W + s.W + 2 * B.OverlapPadPx and math.abs(t.Y - s.Y) * 2 < t.H + s.H + 2 * B.OverlapPadPx then
					clear = false
					break
				end
			end
			if clear then
				out[t.Key] = true
				table.insert(shown, t)
				if t.Mine ~= true then
					rivals += 1
				end
			end
		end
	end
	return out
end

--[[ claude-bud JOB 47: true when a tag (screen centre y, height h, viewport px) reaches into the top-bar row
	(0 .. topPx + TopBarPadPx). ROOT CAUSE of the ghost: the tags float high in the sky (HeightAt), so a far base
	projects into the top row; VisibleSet only kept tags apart from each other, never from the HUD, and a
	BillboardGui draws under every ScreenGui, so the name showed through the translucent compass pill. ]]
function BaseMarkerConfig.InTopBar(y: number, h: number, topPx: number): boolean
	return y - h / 2 < math.max(0, topPx) + BaseMarkerConfig.TopBarPadPx
end

return BaseMarkerConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">BaseSignConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 25: the "<Name>'s Empire" sign above every base plot (Server/Services/BaseSignService). Server-built
	(everyone sees the same thing), one per plot, updated only when what it shows changes (checked every UpdateSeconds;
	nothing per frame).
	  * Owned plot: the owner's avatar headshot, "<DisplayName>'s Empire" (Roblox display names are already filtered),
	    a line "LV 12 · REBIRTH 2 · ARMY 8", and a small flag PLATE beside the sign: a part dressed with the owner's
	    chosen national flag as Textures (NationFlag / NationTexture, the CLAUDE.md nation rule: flags in the world are
	    Textures, never GUIs; plain army green while no flag art is uploaded or no flag is chosen).
	  * Empty plot: "UNCLAIMED BASE" + "walk in to claim".
	  * Placement: HeightStuds above the plot's main gate (clear of every building), BillboardGui with a fixed pixel size
	    (the same size near and far: readable from the road, not huge up close), MaxDistanceStuds.
	CustomEmpireNames = false: no player-typed names (if ever turned on, they must go through TextService filtering).
	Enabled = false: no signs.
]]

local BaseSignConfig = {
	Enabled = true,
	CustomEmpireNames = false,
	HeightStuds = 26,
	MaxDistanceStuds = 220, -- (a base sign is meant to be read from the road; see ASSUMPTIONS for the world-label rule)
	SizePx = Vector2.new(250, 78),
	UpdateSeconds = 5,
	FlagPlateSize = Vector3.new(5.2, 3.9, 0.14), -- 4:3, the NationFlag face size family
	UnclaimedTitle = "UNCLAIMED BASE",
	UnclaimedLine = "walk in to claim",
	Gold = Color3.fromRGB(235, 200, 110),
	Khaki = Color3.fromRGB(205, 195, 160),
	Plate = Color3.fromRGB(24, 26, 21),
}

return BaseSignConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
