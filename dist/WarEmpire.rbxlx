        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">NotificationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NotificationConfig — toast lane + offer toast tunables that are NOT layout (layout, colours, holds, the
	Reroute / Drop tables and the offer throttle numbers live in HudConfig.Toast / HudConfig.Offer).

	v70 "clean screen": NotificationController draws plain outlined text lines in the top-centre stack (max 2,
	coalesced, prioritised) — no cards. Money moves at the cash pill (HudLayout.CashFloat), not mid-screen.
	The Purchase SUCCESSFUL line stays the green Success type (HIGH_CONTRAST_SUCCESS marker in the controller).

	Order a message goes through (NotificationController.route):
	  1. Rewrite      text / type fixes for today's server lines (glyphs FredokaOne lacks, type upgrades)
	     AlertEcho    strike-result lines are dropped while the Alert banner already shows them
	  2. Reroute      HudConfig.Toast.Reroute (Collected → float, kills → float, DEF HIT → one BASE UNDER ATTACK)
	  3. Drop         HudConfig.Toast.Drop (+ LocalExemptDrop for server-sent lines only)
	  4. Throttle     per-pattern minimum gaps / once-per-text for recurring server lines
	  5. PurchaseFailure echo dedupe (one failed buy = one line)
	  6. the lane (coalesce "×N", max 2, priority)
]]

export type RewriteRule = { Match: string, Replace: string?, Type: string? }
export type ThrottleRule = { Match: string, MinGapSeconds: number?, OncePerText: boolean? }

-- W3 step 2 Phase B Jobs: OpsService throttles its lines on the server; the client floor below reuses its numbers
local OpsConfig = require(script.Parent.OpsConfig)
local OPS_DIRECTOR = OpsConfig.Director

local NotificationConfig = {
	-- legacy fields (kept for any caller that still reads them)
	DefaultDuration = 4,
	MaxStacked = 4,
	Types = {
		Info = { Color = Color3.fromRGB(90, 160, 220), Fill = Color3.fromRGB(18, 28, 40) },
		-- High-contrast success (competitor "Purchase SUCCESSFUL!" readability)
		Success = { Color = Color3.fromRGB(40, 255, 120), Fill = Color3.fromRGB(8, 48, 22) },
		Collect = { Color = Color3.fromRGB(60, 255, 140), Fill = Color3.fromRGB(6, 42, 20) },
		Warn = { Color = Color3.fromRGB(255, 200, 60), Fill = Color3.fromRGB(40, 32, 10) },
		Error = { Color = Color3.fromRGB(255, 80, 80), Fill = Color3.fromRGB(48, 12, 12) },
		Reward = { Color = Color3.fromRGB(255, 210, 90), Fill = Color3.fromRGB(40, 32, 12) },
	},

	-- lane --------------------------------------------------------------------------------------------------
	-- A caller's Duration may lengthen a line up to this (server lines ask 3.5-7 s; the lane is meant to be brief)
	MaxHoldSeconds = 4,
	MinHoldSeconds = 1.2,
	-- When 2 lines are up and a new one arrives, the oldest line of the LOWEST priority goes first
	-- (a gold level-up line outlives an "Outposts held" Info line). Equal priority → oldest goes.
	Priority = { Error = 4, Reward = 4, Warn = 4, Success = 3, Info = 1 },
	-- Coalesce "×N" suffix (HudConfig.Toast.CoalesceWindow / CoalesceKey = digits stripped)
	CoalesceSuffix = " ×%d",
	-- measured text box padding in v (UIStroke is drawn outside the glyphs)
	LinePadX = 8,
	LinePadY = 2,

	-- 1. Rewrite: first match wins; Replace is a string.gsub replacement for Match (nil = keep text).
	Rewrite = ({
		-- XPService "★ LEVEL 9! — Sniper Rifle unlocked" (Success today) → the gold Reward line of the spec
		{ Match = "^(★ LEVEL %d+!) — ", Replace = "%1 ", Type = "Reward" },
		{ Match = "^★ LEVEL %d+!", Type = "Reward" },
		-- "Purchase SUCCESSFUL! Helipad → Lv 2": FredokaOne has no "→" (spec risk #5)
		{ Match = " → Lv (%d+)", Replace = " Lv %1" },
		-- server purchase-failure echo uses the competitor wording the client uses
		{ Match = "^Not enough cash$", Replace = "You need more Money!", Type = "Warn" },
		-- raids (RaidConfig.Text): short lines, no "→" / emoji (FredokaOne lacks them); the shield chip shows the timer
		{ Match = "^ATM RAIDED by (.-) (−%$[%d,%.KMB]+).*$", Replace = "ATM raided by %1! %2", Type = "Error" },
		{ Match = "^ATM RAID %+(%$[%d,%.KMB]+) from (.-) → your ATM$", Replace = "Raided %2's ATM! +%1", Type = "Success" },
	} :: { RewriteRule }),

	-- Server lines that repeat what the Alert slot banner already says (MissileController's INCOMING MISSILE
	-- banner shows the strike result for a few seconds) — dropped only while an alert banner is visible.
	AlertEcho = {
		"Missile hit! Defenses down",
		"Your Missile Defense shot down",
		"^Direct hit! ",
		"^Intercepted by ",
		"INCOMING MISSILE",
	},

	-- 3. Drop patterns that apply ONLY to server-sent lines (a local NotificationController.Show of the same
	-- words is intended: OrdersController's T-key "Squad: FOLLOW" Info line while the Army popover is closed).
	LocalExemptDrop = { "^Squad: " },

	-- 4. Throttle recurring server lines on the client (the §4.2 server fixes are deferred)
	Throttle = ({
		{ Match = "^Rebirth almost ready", OncePerText = true }, -- every 90 s today; once per level per session
		{ Match = "^REBIRTH READY", MinGapSeconds = 600 },
		{ Match = "^Raid cooldown", MinGapSeconds = 10 }, -- ATM raid cooldown Warn while standing at the ATM
		{ Match = "is robbing your ATM", MinGapSeconds = 15 },
		{ Match = "^Nothing to collect yet", MinGapSeconds = 20 },
		{ Match = "^Cash drop is recharging", MinGapSeconds = 30 },
		-- Jobs (OpsConfig.Text.Toast; a job or player name is never a nation): one "open" / "raid" line per 10 min,
		-- the server-wide "robbed" line and the bag alert at most once a minute
		{ Match = " is open$", MinGapSeconds = OPS_DIRECTOR.OpenToastGapSeconds }, -- "<Job title> is open"
		{ Match = "^Empire Bank raid started$", MinGapSeconds = OPS_DIRECTOR.OpenToastGapSeconds },
		{ Match = " robbed the Empire Bank$", MinGapSeconds = OPS_DIRECTOR.RobbedLineGapSeconds },
		{ Match = "^Bank bag on the move$", MinGapSeconds = OPS_DIRECTOR.RobbedLineGapSeconds },
	} :: { ThrottleRule }),

	-- 5. One failed purchase = one line. WorldPromptController shows the failure first (WE_BuyAck / PurchaseResult,
	-- via NotificationController.ShowPurchaseFailure); any other purchase-failure line within WindowSeconds —
	-- the second client path or the server's own Warn echo (BaseService / UpgradePadService) — is skipped.
	PurchaseFailure = {
		WindowSeconds = 1.5,
		Patterns = {
			"^You need more Money!$",
			"^Not enough gold$",
			"^Already at MAX level$",
			"^Missing prerequisite structure$",
			"^Unknown structure$",
			"^Buying too fast",
			"^Profile still loading",
			"^Buy failed",
			"^Purchase failed: ",
			"^Not your base — walk your plot pads to buy$",
			"^Claim a base first",
			"^Go to your .+ console to buy it$", -- v71 NotAtConsole (ConsoleBuyConfig.Text.NotAtConsole)
		},
	},

	-- offer toast (the numbers — MaxPerSession 3, MinGapSeconds 240, FirstAfterJoinSeconds 90, death 600 s,
	-- queue 60 s — are in HudConfig.Offer so the money plan tunes them in one place)
	Offer = {
		DeathKeyPattern = "^Death", -- ShopController.DeathShopToast's Key → HudConfig.Offer.DeathOfferMinGapSeconds
		QueueMax = 3, -- deferred offers waiting for a calm moment (one per Key)
		TickSeconds = 0.5, -- queue / expiry check
		IconSize = Vector2.new(36, 28), -- v, HudIcons "Cash"
		-- touch: GET / ✕ hit areas are 64 v (44.8 px) instead of the desktop 44 v, so the pill may grow this much
		-- past HudConfig.Offer.MaxWidth (still capped at the stack's 0.62 × content) to keep the Sub line readable
		TouchExtraWidth = 120,
		GetText = "GET", -- fallback CTA
		CloseText = "✕",
	},
}

return NotificationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">NukeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): Nuke — consumable 19 R$ DevProduct (profile.Nukes) + post-rebirth Tactical Nuke (profile.TacticalNukes).
	ONE balance file. Server: NukeService (M5). Client: NukeController / NukeFx (radii, timings, copy).
	Paid grants ONLY via MonetizationService.ProcessReceipt (DevProducts.Nuke / NukeBundle3 → GrantNukes, added by M1
	with Id = 0). Config only: nothing reads this file yet and nothing is sold from it.

	Judge rulings applied (money/plan.md §1):
	- J1: a nuke can never open a base for raiding. Base mode gives kills, XP and scorch only, then puts a fallout
	  shield on the target (Base.FalloutShieldSeconds → Raid.ShieldUntil / WE_ShieldUntil). No defenses-down,
	  no ATM, cash or structure loss.
	- J5 / J6: the Nuclear Silo has 5 levels and one site only (Strategic Yard, Rebirth 2). No fallback site.
	- J8: any non-immune vehicle inside CoreRadius is destroyed; the edge ring deals DamageAt × EdgeDamageMult.
	- J17: own Fx remote (FxRemote = "NukeFx"), not MissileStrikeFx.
	- J24: world billboards and pads use the text "NUKE"; icons use IconImage once it is set.
	- J26: keep ServerCooldownSeconds = 180; raise to 300 here if the victim-leave KPI rises > 5 points. ]]

export type KindDef = {
	DisplayName: string,
	InventoryField: string,
	Radius: number,
	CoreRadius: number,
	CoreDamage: number,
	EdgeDamageMax: number,
	EdgeDamageMin: number,
	FlashRadius: number,
	LaunchXPFactor: number,
	LaunchXPMin: number,
	LaunchXPMax: number,
	KillBonusScale: number,
	CloudHeight: number,
	CloudScale: number,
}

local NukeConfig = {
	Enabled = true,
	CountdownSeconds = 10,
	TerminalDiveSeconds = 3,
	IconImage = "", -- owner: rbxassetid of a trefoil decal ("" → the text "NUKE"; J24)
	WorldLabel = "NUKE", -- billboards / pads (J24: no glyph that can fall back in FredokaOne)
	FxRemote = "NukeFx", -- Constants.RemoteNames.NukeFx (J17)

	KindOrder = { "Nuke", "TacticalNuke" },
	Kinds = {
		Nuke = {
			DisplayName = "Nuke",
			InventoryField = "Nukes",
			Radius = 150,
			CoreRadius = 75,
			CoreDamage = 1000,
			EdgeDamageMax = 200,
			EdgeDamageMin = 40,
			FlashRadius = 600,
			LaunchXPFactor = 0.30,
			LaunchXPMin = 400,
			LaunchXPMax = 6000,
			KillBonusScale = 1.0,
			CloudHeight = 220,
			CloudScale = 1.0,
		},
		TacticalNuke = {
			DisplayName = "Tactical Nuke",
			InventoryField = "TacticalNukes",
			Radius = 100,
			CoreRadius = 50,
			CoreDamage = 1000,
			EdgeDamageMax = 160,
			EdgeDamageMin = 30,
			FlashRadius = 400,
			LaunchXPFactor = 0.15,
			LaunchXPMin = 200,
			LaunchXPMax = 3000,
			KillBonusScale = 0.6,
			CloudHeight = 150,
			CloudScale = 0.7,
		},
	} :: { [string]: KindDef },

	Rules = {
		ServerCooldownSeconds = 180, -- J26
		PlayerCooldownSeconds = 300,
		MaxLaunchesPerPlayerPerHour = 6,
		BaseTargetCooldownSeconds = 900, -- the same base cannot be nuked again for 15 min
		VictimGraceSeconds = 600,
		SessionJoinGraceSeconds = 120,
		NewPlayerProtectionSeconds = 600, -- mirror RaidConfig.Raid.NewPlayerProtectionSeconds
		MinVictimLevelIfNoPrestige = 5,
		ProtectNewPlayersInStudio = false,
		SpawnSafeRadius = 24,
		AlliesImmune = true,
		BaseTargetMinPowerRatio = 0.35,
		PowerPerPrestige = 40,
		RefundIfTargetLeaves = true,
		InFlightRefundAfterSeconds = 30, -- J19: a younger marker at load is re-checked at At + 30 while online
		LaunchRate = 0.5,
		LaunchBurst = 2,
		StateRate = 1,
		StateBurst = 2,
	},

	Targeting = {
		-- plot-local, converted through the pad CFrame. Nations: on MainRoad (BaseLayoutConfig), 48 studs in front of the
		-- flagpole (Courtyard.Flagpole Z = 8), so a player's nation flag is never the aim point (BuyPathStatic: >= 30 studs)
		BaseAimPoint = { X = 0, Z = 56 },
		PlotClearance = 25,
		MapHalfExtent = 2350,
		GroundRayTop = 600,
		IncludeBank = true, -- + every TerritoryConfig.Territories entry except the Home Outposts (below)
		-- F10 (owner's 11 features): a Home Outpost (TerritoryConfig row with IsStarter = true) is never a nuke target
		-- (NukeConfig.IsTerritoryTargetable)
		SkipStarterOutposts = true,
	},

	Rewards = {
		PlayerKillBonusXP = 260,
		PlayerKillBonusCash = 350,
		NPCKillBonusMult = 1.0,
		SquadKillXP = 30,
		SquadKillCash = 40,
		MaxKillBonusXP = 6000,
		MaxKillBonusCash = 12000,
		XPReason = "nuke",
		CashReason = "nuke_kill",
	},

	-- J1: kills + XP + scorch, then a fallout shield on the target base. There are deliberately NO defenses-down
	-- fields: NukeService must never call GateDefenseService / MissileStrikeService for a base.
	Base = {
		FalloutShieldSeconds = 300, -- Raid.ShieldUntil = max(current, now + 300) (+ WE_ShieldUntil); blocks raids + strikes
		ScorchSeconds = 30, -- client-only ground scorch
	},

	-- J8: vehicles in the core are destroyed outright (so a 4,200 HP tank cannot survive ground zero). The edge ring
	-- deals NukeConfig.DamageAt × EdgeDamageMult through VehicleHealth.ApplyRadiusDamage(..., "Nuke"), ignoring armor.
	-- Occupant cover applies only in the edge ring.
	Vehicles = {
		CoreDestroys = true,
		EdgeDamageMult = 4,
		CoverMult = 0.6,
		PremiumCoverMult = 0.35,
	},

	-- J5: 5 levels (costs, online build time, capacity). J6: one site only, the Strategic Yard (Rebirth 2); the Silo
	-- waits for the rebirth world workflow (M7b), which owns the geometry (BaseLayoutConfig).
	Silo = {
		Enabled = true,
		UnlockPrestige = 2,
		Zone = "StrategicYard", -- RebirthConfig.Zones.StrategicYard
		Site = { X = 0, Z = -124, YawDeg = 0, Footprint = 22 }, -- plot-local (rebirth spec §2); no fallback site
		Requires = { CommandCenter = 3, MissileDefense = 1 } :: { [string]: number },
		Costs = { 250_000, 750_000, 2_000_000, 3_500_000, 6_000_000 },
		BuildSeconds = { 5400, 4200, 3000, 2400, 1800 }, -- 90 / 70 / 50 / 40 / 30 online minutes
		Capacity = { 1, 1, 2, 2, 3 },
		TickSeconds = 5,
	},

	Gift = { Enabled = true, AtLevel = 10, Kind = "TacticalNuke", Count = 1 },

	Offers = { RevengeCooldownSeconds = 600, RevengeMinVictimLevel = 5, RevengeDelaySeconds = 3 },

	Fx = {
		ArcApex = 500,
		FireballMaxSize = 110,
		ShockwaveMult = 1.6,
		CloudHoldSeconds = 12,
		CloudFadeSeconds = 6,
		CleanupSeconds = 25,
		PartBudget = 48,
		PartBudgetLow = 24,
		ShakeMaxStuds = 2.2,
		ShakeSeconds = 1.8,
		ShakeFalloffStuds = 1200,
		SoundSpeed = 1100,
		MaxBoomDelay = 2,
		MarkerTransparency = 0.8,
		InterceptorRange = 350, -- cosmetic interceptors that miss (a nuke is never intercepted)
	},

	Audio = { SirenId = "", BoomId = "", LaunchId = "", SirenVolume = 0.5, BoomVolume = 1.0 },

	Text = {
		Incoming = "☢ NUKE INCOMING · %s · %s",
		InZone = "YOU'RE IN THE BLAST ZONE: RUN ➜",
		Protected = "🛡 You're protected (%s)",
		YourBase = "☢ YOUR BASE IS BEING NUKED by %s: run or get to your spawn pad!",
		Away = "☢ NUKE AWAY → %s · impact %s",
		Aborted = "NUKE ABORTED (%s)",
		Report = "☢ NUKE REPORT · Enemies %d · Hostiles %d · Squads %d · +%s XP · +$%s",
		Broadcast = "☢ %s's NUKE hit %s: %d eliminated",
		Revenge = "Nuked by %s. Strike back? ☢ Nuke",
		Ready = "☢ NUKE READY",
		AirspaceClear = "☢ Airspace clear: launch your Nuke",
		Refunded = "Your unfinished nuke launch was refunded",
		TargetLeft = "%s left: nuke returned",
		BaseNuked = "☢ Your base was nuked by %s. Nuke-proof for %s",
		SiloReady = "☢ Tactical Nuke ready in your Silo",
		Gift = "☢ First strike's on us: 1 Tactical Nuke. Tap ☢ to launch!",
		Reasons = {
			Disabled = "Nukes are switched off",
			Loading = "Your save is still loading",
			Dead = "Respawn first",
			NoInventory = "No nukes: get one (19 R$)",
			NoTactical = "No Tactical Nukes: build a Silo (Rebirth 2)",
			InFlight = "Airspace busy: a nuke is already inbound",
			ServerCooldown = "Airspace clears in %s",
			PlayerCooldown = "Launcher reloading %s",
			HourlyCap = "Launch limit: next in %s",
			Self = "That's your base",
			Ally = "Clan ally",
			TargetOffline = "Player left",
			TargetLoading = "Their save is still loading",
			NewPlayer = "New player protection: %s",
			Shielded = "🛡 Shielded %s",
			RecentlyNuked = "Recently nuked: %s",
			TooWeak = "Too weak to target",
			TooCloseToBase = "Too close to a base",
			OffMap = "Off the map",
			NoGround = "No ground there",
		} :: { [string]: string },
	},
}

function NukeConfig.DamageAt(def: KindDef, distance: number): number
	if distance <= def.CoreRadius then
		return def.CoreDamage
	end
	if distance > def.Radius then
		return 0
	end
	local t = (distance - def.CoreRadius) / math.max(1, def.Radius - def.CoreRadius)
	return math.floor(def.EdgeDamageMax - (def.EdgeDamageMax - def.EdgeDamageMin) * t + 0.5)
end

-- J8: damage to a (non-immune) vehicle at this distance; math.huge inside the core (destroyed outright).
function NukeConfig.VehicleDamageAt(def: KindDef, distance: number): number
	if distance > def.Radius then
		return 0
	end
	if distance <= def.CoreRadius and NukeConfig.Vehicles.CoreDestroys then
		return math.huge
	end
	return NukeConfig.DamageAt(def, distance) * NukeConfig.Vehicles.EdgeDamageMult
end

function NukeConfig.LaunchXP(def: KindDef, xpToNext: number): number
	local raw = (tonumber(xpToNext) or 0) * def.LaunchXPFactor
	if raw ~= raw or raw == math.huge then
		return def.LaunchXPMax
	end
	return math.clamp(math.floor(raw + 0.5), def.LaunchXPMin, def.LaunchXPMax)
end

function NukeConfig.Power(level: number, prestige: number): number
	return math.max(1, math.floor(level)) + math.max(0, math.floor(prestige)) * NukeConfig.Rules.PowerPerPrestige
end

-- Silo level 1..5 → build seconds / capacity (nil outside the table).
function NukeConfig.SiloBuildSeconds(level: number): number?
	return NukeConfig.Silo.BuildSeconds[math.floor(level)]
end

function NukeConfig.SiloCapacity(level: number): number
	return NukeConfig.Silo.Capacity[math.floor(level)] or 0
end

-- F10: the nuke target filter for a TerritoryConfig.Territories row (Home Outposts are skipped).
function NukeConfig.IsTerritoryTargetable(def: { IsStarter: boolean? }?): boolean
	if def == nil then
		return false
	end
	if NukeConfig.Targeting.SkipStarterOutposts and def.IsStarter == true then
		return false
	end
	return true
end

function NukeConfig.FormatTime(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

return NukeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">OilRigConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Coastal oil platform POIs — harder guards, higher capture stipends.
	Wired into TerritoryConfig Ids CoastalOilAlpha / CoastalOilBravo.
]]

local OilRigConfig = {
	PlatformHeight = 28,
	DeckSize = Vector3.new(48, 2.5, 48),
	LegCount = 4,
	GuardNPCType = "OilRigGuard",
	GuardCount = 4,
	CaptureRadius = 48,
	-- Positions (offshore on ~4800 map)
	Rigs = {
		{
			Id = "CoastalOilAlpha",
			DisplayName = "Coastal Oil Alpha",
			Position = Vector3.new(1800, 1, -750),
			Color = Color3.fromRGB(190, 145, 45),
		},
		{
			Id = "CoastalOilBravo",
			DisplayName = "Coastal Oil Bravo",
			Position = Vector3.new(-1800, 1, 750),
			Color = Color3.fromRGB(170, 125, 40),
		},
	},
}

return OilRigConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">OpsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	W3 step 2 Phase B — Jobs at every place ("Ops" in code, "Jobs" to players). Shared: the server (OpsService,
	lane O) and the client (OpsController / OpsJobs, lane U) both read it. Data only: it requires nothing.

	Contract: scratchpad w3s2/buildB/KB/contract.md (lane KB). Spec: scratchpad w3s2/spec_w3s2.md §4, §5 and the
	activities design (what happens at each place; the merged spec wins where they differ).

	- Everything ships OFF: Enabled = false, every Kinds[k].Enabled = false and every site Enabled = false. A site
	  runs only when all three are on, its POI is enabled in WorldConfig.POIs, and every anchor it needs resolves
	  (ActivityAnchors.Get; Optional roles may be missing). OpsService logs a disabled site once and never falls
	  back to bare sand.
	- A site is one job place: Id = "<POI>.<Site>", the same site id the WE_ActivityAnchor attachments carry.
	  Anchors maps a role key to the full anchor id "<POI>.<Site>.<Role>" (WorldConfig.Activity, POILayouts/*,
	  the checkpoint template and Town.BankAnchors).
	- Pay, cooldowns, participation and site states are decided on the SERVER only. The client shows what the
	  OpsState / OpsProgress / OpsPing payloads (types below) carry and never sends a job request: every action is
	  a server ProximityPrompt.Triggered, re-checked by OpsService (rate limit, distance, on foot, stage, cooldown).
	- Copy is device-neutral: no key names, no "tap" / "click", never a nation or country name.
	- Coexistence until the cutover (OpsService's rules, contract §4): Town.Bank runs only while
	  BankRaidConfig.Enabled == false (never two bank jobs), and the camps only while CombatConfig.FieldBootstrap ==
	  false (never two garrisons on the same WE_NPCSpawn posts).
]]

-- ── Exported types: config rows ───────────────────────────────────────────────────────────────────────────────

-- One NPC post of a site's garrison. Post names a role key of the site's Anchors (an "npc" anchor); a rig deck post
-- has At instead (a config point: the rig deck has no anchors).
export type GarrisonPost = {
	Post: string?, -- role key in the site's Anchors ("G1", "R2", "Cmdr")
	At: { X: number, Y: number, Z: number, Yaw: number }?, -- world point of the standing surface (rig deck posts)
	Type: string, -- CombatConfig.NPCTypes key
	Stance: string, -- one of Stances: "Passive" | "Aggressive" | "Post"
	Leash: number?, -- studs from Home before the NPC walks back (nil: no leash)
	Static: boolean?, -- never MoveTo (tower decks, interiors): the model gets WE_Static = true; implies Stance "Post"
	When: string?, -- one of Spawns (nil = "Open": part of the standing garrison)
}

-- A wave NPC group (uplinks, holdout): spawned At seconds after the stage starts, on the site's wave ring
export type WaveDef = { At: number, Types: { string } }

-- One stage of a job. At / AtAny name role keys of the site's Anchors.
export type StageDef = {
	Id: string, -- one of StageIds
	At: string?, -- the anchor holding the prompt / the zone centre
	AtAny: { string }?, -- several anchors, any of them (sabotage pumps, rotating caches)
	Prompt: string?, -- key in Text.Prompts (the ActionText); nil = no prompt (a zone or a timer)
	Hold: number?, -- ProximityPrompt.HoldDuration, seconds (engine hold: works with a finger)
	Dist: number?, -- ProximityPrompt.MaxActivationDistance, studs
	Seconds: number?, -- zone progress target / alarm timer / fuse
	R: number?, -- zone radius, studs (nil: the anchor's WE_ActivityR)
	Need: number?, -- Plant: charges needed (capped by the pump anchors that exist)
	Window: number?, -- Plant: every charge within this many seconds of the first
	MaxBags: number?, -- Grab: bags per run
	Decay: number?, -- Hack: progress lost per second while the ring is empty (fraction of the whole)
	EmptyFail: number?, -- Hold: an empty ring for this long fails the job
	Damage: number?, -- Fuse: server damage at the blast (the explosion itself is visual, BlastPressure 0)
	DamageR: number?, -- Fuse: blast radius, studs
}

export type SiteDef = {
	Id: string, -- "<POI>.<Site>"
	Kind: string, -- a Kinds key
	POI: string, -- a WorldConfig.POIs Id; the site is off while that POI is disabled
	Enabled: boolean, -- ships false; the integrator flips it at the cutover
	Name: string, -- the world label title (2-3 words)
	Title: string, -- the JOBS row / card title (2-3 words)
	Short: string, -- objective marker / compass label, 2-7 capitals
	Hard: boolean, -- the JOBS row difficulty word (Text.Row.Hard / Easy)
	Big: boolean, -- rotates through the Director's big slots (the bank is Big and Pinned)
	Pinned: boolean?, -- always one of the open big sites unless Cooling
	Anchors: { [string]: string }, -- role key -> full anchor id
	Optional: { string }?, -- role keys that may be missing (a Requires row not built on Quality Low)
	Target: string, -- role key: the GO / marker point and the world label's anchor
	Label: boolean, -- one stud-scaled world label at Target (MaxDistance Ui.LabelMaxDistance, never AlwaysOnTop)
	Garrison: { GarrisonPost },
	Reserve: number, -- NPC ledger slots at Full quality (spec §4): posts + reinforcements, or the wave cap
	Waves: { WaveDef }?,
	WavePosts: { string }?, -- role keys: wave spawn fallback when no clear point is found on the wave ring
	Wake: string, -- a Npc.Wake key
	ProvokeRadius: number?, -- Passive guards: an on-foot player this close to a post for CombatConfig.NPCStance.ProvokeHoldSeconds
	Stages: { StageDef },
	Lockdown: number?, -- seconds the job may stay Active before it fails / ends
	HeldSeconds: number?, -- checkpoints: how long the taker holds it
	Pay: string, -- a Rewards.Rows key
	PresentR: number?, -- participation radius around Target (default Zones.PresentR)
	PresentSeconds: number?, -- participation time during Active (default Zones.PresentSeconds)
	PresentShare: number?, -- uplinks: share of the elapsed time inside the ring instead of PresentSeconds
	NoContest: boolean?, -- the bank: enemy players in the ring do not freeze the crack
	AllowSeated: boolean?, -- rigs: players in a boat within PresentR count as present
	Rotate: { string }?, -- caches: one of these role keys is live per cycle
	RegarrisonClear: number?, -- checkpoints: re-garrison only when no player is within this many studs
}

export type KindDef = {
	Enabled: boolean, -- ships false
	Track: { string }, -- MissionService.TrackProgress objective types reported on completion (1 each)
	Carry: boolean, -- the job ends with a carried item delivered home (OpsCargo)
	CarryLabel: string?, -- the carried item's world label ("BAG" / "BOX")
	Ping: boolean, -- carriers are revealed on OpsPing every Remote.PingSeconds
	Hostile: boolean, -- the label reads HOSTILE instead of OPEN (Aggressive garrisons)
}

export type PayRow = {
	Minutes: number, -- Pay = clamp(Floor, round(Minutes x 60 x R), Cap) x Private x Diminish x Event
	Floor: number,
	Cap: number,
	XP: number,
	PlayerCd: number, -- seconds, per player per site (saved: profile.Ops.Cd[siteId])
	SiteCd: number, -- seconds Cooling after a success (checkpoints: 0, the site's HeldSeconds is the Held time instead)
	FailCd: number, -- seconds Cooling after a failed / empty run
	DimN: number, -- full pay for the first DimN runs of this row per UTC day (then Rewards.Diminish)
}

-- ── Exported types: remote payloads (server -> client only; there is no Ops client -> server remote) ─────────
-- Timers are seconds remaining (never os.time values: client clocks drift). Money is whole dollars.

-- One site in OpsState. Full snapshots carry every live site with X/Y/Z; deltas carry changed sites without X/Y/Z.
export type OpsSiteSnap = {
	Id: string, -- a Sites Id (the client reads Name / Title / Short / Kind / Hard / Big from OpsConfig.Get(Id))
	State: string, -- one of States ("Off" = the site went away; drop it)
	X: number?, -- the Target anchor's world position (Full snapshots only)
	Y: number?,
	Z: number?,
	Left: number?, -- seconds left in Active (lockdown), Cooling or Held
	Pay: number?, -- what this player would be paid now (server-computed: R, Private, Diminish, Event)
	MyCd: number?, -- seconds until this player may do this site again (nil / 0 = now)
	Guards: number?, -- live garrison count (card copy "Clear 2 guards")
	HeldBy: number?, -- Held: the taker's UserId
}
export type OpsBagSnap = { U: number, X: number, Z: number, Age: number, Site: string } -- a DROPPED bag (U = last carrier)
export type OpsCarrySnap = { Site: string, Kind: string, Value: number, Left: number, Picked: boolean }
export type OpsStatePayload = {
	V: number, -- PayloadVersion
	Full: boolean, -- true: Sites is every live site (replace the cache); false: only the changed ones
	Sites: { OpsSiteSnap },
	Home: { X: number, Z: number }?, -- Full only: this player's delivery point (own plot, else Cargo.FallbackHome)
	Carrying: OpsCarrySnap?, -- sent in EVERY payload: nil = not carrying
	Bags: { OpsBagSnap }?, -- sent in EVERY payload: dropped bags this player may pick up (at most Cargo.MaxBagsInWorld)
}
-- 4 Hz, only while this player is inside a job zone or hold; Stage nil = hide the pill
export type OpsProgressPayload = {
	Site: string,
	Stage: string?, -- one of StageIds
	Frac: number?, -- 0..1
	Blocked: string?, -- one of Blocked
	Guards: number?, -- live garrison count
	Left: number?, -- seconds left (alarm, fuse, lockdown)
	Wave: number?, -- current wave (1-based)
	Waves: number?, -- wave count
}
-- UnreliableRemoteEvent, every Remote.PingSeconds per carrier, to non-allies only (never for a novice carrier)
export type OpsPingPayload = { U: number, X: number, Z: number }

-- ── Config ────────────────────────────────────────────────────────────────────────────────────────────────────

local OpsConfig = {
	Enabled = false, -- master switch: false = OpsService.Init returns at once (no prompt, NPC, label or payload)
	PayloadVersion = 1, -- OpsStatePayload.V

	-- Vocabularies (validated by OpsConfig.Validate; types above keep them as plain strings)
	States = { "Off", "Dormant", "Open", "Active", "Cooling", "Held", "Quiet", "Closed" },
	-- Dormant = open, no player near (no NPCs); Open = garrison up; Active = staged, lockdown running;
	-- Cooling = site cooldown (shown CLOSED); Held = a checkpoint's taker holds it; Quiet = the NPC budget is short
	-- (not listed as open); Closed = a big site the Director rotated out; Off = disabled (only ever sent to drop it)
	Stances = { "Passive", "Aggressive", "Post" },
	Spawns = { "Open", "Breach", "Alarm", "Crack" }, -- GarrisonPost.When
	StageIds = { "Breach", "Start", "Crack", "Grab", "Carry", "Alarm", "Clear", "Take", "Hack", "Hold", "Plant", "Fuse", "Recover", "Open" },
	Blocked = { "UnderFire", "Enemy", "Vehicle", "Cooldown" },
	-- MissionService objective types OpsService reports (MissionService.TrackProgress(player, type, 1))
	TrackTypes = { "Heist", "Checkpoint", "Camp", "Uplink", "Delivery", "Job" },

	Kinds = {
		Vault = { Enabled = false, Track = { "Heist", "Job" }, Carry = true, CarryLabel = "BAG", Ping = true, Hostile = false },
		VaultLite = { Enabled = false, Track = { "Delivery", "Job" }, Carry = true, CarryLabel = "BAG", Ping = true, Hostile = false },
		Checkpoint = { Enabled = false, Track = { "Checkpoint", "Job" }, Carry = false, Ping = false, Hostile = false },
		Camp = { Enabled = false, Track = { "Camp", "Job" }, Carry = false, Ping = false, Hostile = true },
		Uplink = { Enabled = false, Track = { "Uplink", "Job" }, Carry = false, Ping = false, Hostile = false },
		Holdout = { Enabled = false, Track = { "Job" }, Carry = false, Ping = false, Hostile = false },
		Sabotage = { Enabled = false, Track = { "Job" }, Carry = false, Ping = false, Hostile = false },
		Cargo = { Enabled = false, Track = { "Delivery", "Job" }, Carry = true, CarryLabel = "BOX", Ping = true, Hostile = false },
		Cache = { Enabled = false, Track = { "Job" }, Carry = false, Ping = false, Hostile = false },
		Siege = { Enabled = false, Track = { "Job" }, Carry = false, Ping = false, Hostile = true },
		Rig = { Enabled = false, Track = { "Job" }, Carry = false, Ping = false, Hostile = true },
	} :: { [string]: KindDef },

	-- NPC ledger and behaviour (spec §4). The hard cap stays in CombatService (CombatConfig.MaxActiveNPCs 18 regular,
	-- + CombatConfig.SpecialOverCap for special types / OverCap event NPCs). OpsGarrison reserves at wake.
	Npc = {
		Budget = 18, -- regular slots the ledger hands out
		EventReserve = 4, -- the +4 headroom: special types (CombatConfig.SpecialNPCTypes) and OverCap event NPCs, only when the ledger is full
		MinGarrison = 2, -- fewer free slots than this: the site is Quiet
		Wake = {
			Checkpoint = { OnFoot = 150, Any = 40 }, -- a player on foot within 150, or anyone within 40 (drive-through traffic sleeps)
			Bank = { OnFoot = 200, Any = 200 },
			Default = { OnFoot = 250, Any = 250 },
		} :: { [string]: { OnFoot: number, Any: number } },
		SleepRadius = 400, -- no player within this ...
		SleepGraceSeconds = 60, -- ... for this long (and not provoked): despawn, no pay
		SpawnStaggerSeconds = 0.2,
		TopUpClearRadius = 60, -- at Open, a missing guard respawns only when no player is within this of its post ...
		TopUpDelaySeconds = 18, -- ... and never sooner than this after it died (never faster than CombatConfig.NPCRespawnSeconds: no kill farm)
		DefaultProvokeRadius = 25, -- SpawnNPC opts.ProvokeRadius when a site sets none (hold time / calm-down:
		-- CombatConfig.NPCStance, lane N, so the NPC core keeps one copy)
		RootLift = 3, -- HumanoidRootPart above the standing surface (R6: 2-stud legs + half the torso)
		StaticMinY = 2, -- an npc anchor this far above WorldConfig.Activity.FloorY is a deck / tower post (Static)
		ProbeClear = 1, -- a Probe / wave point needs this clearance from collidable parts (studs, XZ)
		ProbeSearch = 8, -- ... searched in rings up to this far before falling back to the nearest post
		WaveRing = 70, -- uplink wave points this far from the ring centre (4 compass points)
		HoldoutWaveRing = 80,
		WaveMaxAlive = 4,
		CommanderType = "CampCommander", -- CombatConfig.NPCTypes (lane N); missing -> CommanderFallback
		CommanderFallback = "HeavyInfantry",
		LeashReturnTolerance = 4, -- the leash test: back within this of Home 20 s after losing the target
	},

	-- Presence rules for holds and participation (OpsZones)
	Zones = {
		TickSeconds = 0.25, -- 4 Hz
		MaxHeightDelta = 14, -- root Y within this of the zone centre (flat XZ test otherwise)
		TeleportStuds = 60, -- root moved further than this in one tick on foot: participation reset ...
		TeleportStudsSeated = 150, -- ... or this far while seated (600 studs/s: over 2x the fastest vehicle's server speed cap) ...
		TeleportLockoutSeconds = 15, -- ... and locked out this long (RaidConfig numbers)
		UnderFireSeconds = 2, -- hurt within this: progress freezes ("UNDER FIRE")
		PresentSeconds = 15, -- participation for pay (big sites)
		PresentSecondsSmall = 10, -- checkpoints, camps, sabotage, forts, rigs
		PresentR = 60, -- participation radius when a site sets none
		ContestFreeze = true, -- a non-ally present and no ally of the starter present: progress x0 (bank exempt)
		PromptSlack = 4, -- server re-check: root within MaxActivationDistance + this (server positions)
		RateLimitKey = "ops_prompt",
		RateLimitRate = 2,
		RateLimitBurst = 4,
	},

	-- Carried items (OpsCargo). A carried bag is part of the character; a dropped one is 1 anchored part.
	Cargo = {
		DeadlineSeconds = 240, -- carry it home within this ("Bag lost" after)
		DropLifetimeSeconds = 45, -- a dropped bag lies this long
		PickupHold = 2,
		PickupDist = 12,
		-- claude-bud (2026-09-29, CP-9 E4): the server also needs a clear line from the picker's head to the bag, so a bag
		-- dropped inside the bank hall cannot be taken through its 7.8-stud back wall. "owner" = AdminConfig.IsPlaytestOwner
		-- only, "all" = everyone, anything else = off (distance check only, as before).
		PickupLosRollout = "all", -- v101 (Ops itself stays off)
		PickerMult = 0.6, -- a picker who is not the grabber gets this share (fresh deadline)
		MaxHandoffs = 3, -- the 4th drop destroys it
		MaxBagsInWorld = 3, -- carried + dropped, all sites: busiest 512-stud circle 493 static + 4 crate parts + 3 bags = 500 (cap 500)
		NoviceSeconds = 600, -- carriers younger than this (FirstJoinUnix; NoviceShieldDone once it lands) are never pinged
		DeliveryPad = 12, -- delivered inside the OWN plot square: |dx|, |dz| <= PlotSize / 2 + this
		HomeTowardGate = 150, -- OpsStatePayload.Home: plot centre moved this far toward the front gate
		FallbackHome = { X = 40, Z = 170 }, -- no plot: Pool_Town (WorldConfig.Spawns.Garage)
		FallbackRadius = 30, -- no plot: delivered within this of FallbackHome
		BagSize = Vector3.new(2, 2, 1),
		AllowVehicles = true,
	},

	-- Rewards (OpsRewards, server only). R = TycoonMath.BasePassivePerTick(profile.BaseUpgrades) / TycoonMath.TickSeconds()
	-- (base passive income per second before multipliers), never read from the client.
	Rewards = {
		CashReason = "ops", -- EconomyService.AddCash reason (wallet) ...
		XPReason = "ops", -- XPService.AddXP reason
		-- ... exempt from pass multipliers once MonetizationConfig.CashMultExemptReasons has "ops" (pending edit, KB);
		-- while it does not, OpsService stays off and logs once (never pays a multiplied job)
		RequireCashExempt = true,
		PrivateMult = 0.5, -- game.PrivateServerOwnerId ~= 0: cash and XP
		Diminish = { 1, 0.5, 0.25 }, -- runs 1..DimN, DimN+1..2 DimN, then (per pay row, per UTC day)
		EventMult = 2, -- Vault Window (Phase C, bank only)
		StudioCdDivisor = 10, -- RunService:IsStudio(): every cooldown / 10
		Rows = {
			Bank = { Minutes = 10, Floor = 15000, Cap = 300000, XP = 250, PlayerCd = 900, SiteCd = 360, FailCd = 120, DimN = 3 },
			Armory = { Minutes = 7, Floor = 10000, Cap = 200000, XP = 180, PlayerCd = 600, SiteCd = 300, FailCd = 120, DimN = 6 },
			Depot = { Minutes = 6, Floor = 8000, Cap = 160000, XP = 150, PlayerCd = 600, SiteCd = 300, FailCd = 120, DimN = 6 },
			Port = { Minutes = 5, Floor = 6000, Cap = 120000, XP = 120, PlayerCd = 480, SiteCd = 240, FailCd = 120, DimN = 6 },
			Crash = { Minutes = 4, Floor = 5000, Cap = 100000, XP = 100, PlayerCd = 480, SiteCd = 240, FailCd = 120, DimN = 6 },
			Oil = { Minutes = 5, Floor = 6000, Cap = 120000, XP = 120, PlayerCd = 480, SiteCd = 300, FailCd = 120, DimN = 6 },
			Village = { Minutes = 5, Floor = 6000, Cap = 120000, XP = 140, PlayerCd = 480, SiteCd = 240, FailCd = 120, DimN = 6 },
			Uplink = { Minutes = 4, Floor = 5000, Cap = 100000, XP = 110, PlayerCd = 480, SiteCd = 240, FailCd = 120, DimN = 6 },
			Fort = { Minutes = 4, Floor = 5000, Cap = 100000, XP = 100, PlayerCd = 600, SiteCd = 480, FailCd = 120, DimN = 6 },
			Rig = { Minutes = 4, Floor = 5000, Cap = 100000, XP = 100, PlayerCd = 600, SiteCd = 480, FailCd = 120, DimN = 6 },
			Camp = { Minutes = 3, Floor = 4000, Cap = 80000, XP = 90, PlayerCd = 360, SiteCd = 300, FailCd = 120, DimN = 6 },
