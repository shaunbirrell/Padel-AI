			-- ribbon glazing, split where an interior glass partition / server rack meets the wall
			FrontWindowsX = { { X = -10.05, W = 6.3 }, { X = -1.45, W = 8.9 } },
			BackWindowsX = { { X = -9.25, W = 7.5 }, { X = 9.25, W = 7.5 } },
