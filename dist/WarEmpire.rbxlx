-- Rigs: clear the deck guards (config posts on a ring of radius DeckR round the TerritoryConfig deck position;
-- the capture itself stays TerritoryService's). The Pier anchor is the GO point on the shore.
local DECK_R = 20
local DECK_ANGLES = { 0, 120, 240 } -- degrees, 0 = north (-Z)
local DECK_TOP = 28.05 -- MapSetup deck: 2.5 thick centred at Position.Y - 1.2
local function rig(id: string, poi: string, name: string, cx: number, cz: number)
	local g: { GarrisonPost } = {}
	for _, deg in ipairs(DECK_ANGLES) do
		local r = math.rad(deg)
		table.insert(g, {
			At = { X = cx - DECK_R * math.sin(r), Y = DECK_TOP, Z = cz - DECK_R * math.cos(r), Yaw = deg + 180 },
			Type = "OilRigGuard",
			Stance = "Aggressive",
			Leash = 25, -- never walks off the 48-stud deck
		})
	end
	table.insert(Sites, {
		Id = id,
		Kind = "Rig",
		POI = poi,
		Enabled = false,
		Name = name,
		Title = "Storm the Rig",
		Short = "RIG",
		Hard = true,
		Big = false,
		Anchors = { Pier = id .. ".Pier" },
		Target = "Pier",
		Label = false, -- the capture zone's own label covers the deck
		Garrison = g,
		Reserve = 3,
		Wake = "Default",
		Stages = { { Id = "Clear" } },
		Pay = "Rig",
		PresentR = 80,
		PresentSeconds = 10,
		AllowSeated = true,
	})
end
-- deck centres = TerritoryConfig.Territories.CoastalOilAlpha / CoastalOilBravo .Position (X, Z)
rig("RigA.Deck", "RigA", "Rig Alpha Deck", 1800, -750)
rig("RigB.Deck", "RigB", "Rig Bravo Deck", -1800, 750)

-- ── Lookups (pure; built once at require) ─────────────────────────────────────────────────────────────────────
local byId: { [string]: SiteDef } = {}
for _, s in ipairs(Sites) do
	byId[s.Id] = s
end

function OpsConfig.Get(id: string): SiteDef?
	return byId[id]
end

-- True when the master switch, the kind and the site are all on (POI / anchor liveness is OpsService's check)
function OpsConfig.SiteSwitchedOn(id: string): boolean
	local s = byId[id]
	if s == nil or OpsConfig.Enabled ~= true or s.Enabled ~= true then
		return false
	end
	local k = OpsConfig.Kinds[s.Kind]
	return k ~= nil and k.Enabled == true
end

local function inList(list: { string }, v: string): boolean
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

-- Static checks of the rows above (no world access). Returns a list of problems; empty = valid.
function OpsConfig.Validate(): { string }
	local bad: { string } = {}
	local function fail(msg: string)
		table.insert(bad, msg)
	end
	local seen: { [string]: boolean } = {}
	for _, s in ipairs(Sites) do
		local id = s.Id
		if seen[id] then
			fail(id .. ": duplicate site id")
		end
		seen[id] = true
		local poi, site = string.match(id, "^([%w_]+)%.([%w_]+)$")
		if poi == nil or site == nil then
			fail(id .. ": site id is not <POI>.<Site>")
		elseif poi ~= s.POI then
			fail(id .. ": POI " .. s.POI .. " does not match the id")
		end
		if OpsConfig.Kinds[s.Kind] == nil then
			fail(id .. ": unknown kind " .. s.Kind)
		end
		if OpsConfig.Rewards.Rows[s.Pay] == nil then
			fail(id .. ": unknown pay row " .. s.Pay)
		end
		if OpsConfig.Npc.Wake[s.Wake] == nil then
			fail(id .. ": unknown wake " .. s.Wake)
		end
		if not string.match(s.Short, "^[A-Z]+$") or #s.Short < 2 or #s.Short > 7 then
			fail(id .. ": Short must be 2-7 capitals")
		end
		for role, aid in pairs(s.Anchors) do
			if aid ~= id .. "." .. role then
				fail(id .. ": anchor " .. role .. " = " .. aid .. " is not <site>.<role>")
			end
		end
		if s.Anchors[s.Target] == nil then
			fail(id .. ": Target " .. s.Target .. " is not an anchor role")
		end
		for _, r in ipairs(s.Optional or {}) do
			if s.Anchors[r] == nil then
				fail(id .. ": Optional " .. r .. " is not an anchor role")
			end
		end
		for _, g in ipairs(s.Garrison) do
			if g.Post ~= nil and s.Anchors[g.Post] == nil then
				fail(id .. ": garrison post " .. g.Post .. " is not an anchor role")
			end
			if g.Post == nil and g.At == nil then
				fail(id .. ": garrison post with neither Post nor At")
			end
			if not inList(OpsConfig.Stances, g.Stance) then
				fail(id .. ": unknown stance " .. g.Stance)
			end
			if g.When ~= nil and not inList(OpsConfig.Spawns, g.When) then
				fail(id .. ": unknown When " .. g.When)
			end
		end
		for _, p in ipairs(s.WavePosts or {}) do
			if s.Anchors[p] == nil then
				fail(id .. ": wave post " .. p .. " is not an anchor role")
			end
		end
		for _, r in ipairs(s.Rotate or {}) do
			if s.Anchors[r] == nil then
				fail(id .. ": rotate " .. r .. " is not an anchor role")
			end
		end
		if #s.Stages == 0 then
			fail(id .. ": no stages")
		end
		for _, st in ipairs(s.Stages) do
			if not inList(OpsConfig.StageIds, st.Id) then
				fail(id .. ": unknown stage " .. st.Id)
			end
			if st.At ~= nil and s.Anchors[st.At] == nil then
				fail(id .. ": stage " .. st.Id .. " At " .. st.At .. " is not an anchor role")
			end
			for _, r in ipairs(st.AtAny or {}) do
				if s.Anchors[r] == nil then
					fail(id .. ": stage " .. st.Id .. " AtAny " .. r .. " is not an anchor role")
				end
			end
			if st.Prompt ~= nil then
				local txt = OpsConfig.Text.Prompts[st.Prompt]
				if txt == nil then
					fail(id .. ": stage " .. st.Id .. " prompt " .. st.Prompt .. " has no text")
				elseif #txt > 13 then
					fail(id .. ": prompt text " .. txt .. " is over 13 characters")
				end
				if st.At == nil and st.AtAny == nil then
					fail(id .. ": stage " .. st.Id .. " has a prompt but no anchor")
				end
			end
		end
	end
	return bad
end

return OpsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">OrdersConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Squad Orders (walkie) — Follow / Attack / Hold / Retreat.
	Field units project SoldierService army counts (not a second recruit economy).
]]

local OrdersConfig = {
	Enabled = true,

	MinSoldiersToShow = 1,
	MaxFieldUnits = 5,
	UnitsPerSoldier = 1,

	OrderRatePerSec = 2,
	OrderBurst = 4,

	DefaultOrder = "Follow",

	Orders = {
		Follow = true,
		Attack = true,
		Hold = true,
		Retreat = true,
	},

	ThinkInterval = 0.4,
	FollowDistance = 10, -- old grid only (FollowSlots empty): face the player beyond this
	FollowStopDistance = 6, -- old grid only: stop within this of the player
	FormationSpacing = 3.5, -- old grid (3 wide, rows 6 / 9.5 / 13 studs straight behind the player)
	-- Base identity lane C (owner: the squad blocked the camera). Follow slots in player-local studs: +X is the
	-- player's right, +Z is BEHIND the player. Two wings beside the player, clear of the third-person camera's
	-- line to the player (the old grid put 2 of 5 units right between the camera and you). Slot 6+ (Squad
	-- Expansion research) repeats the list FollowRankStepZ further back per rank. Empty list = the old grid.
	FollowSlots = {
		{ X = -5.5, Z = 1.5 },
		{ X = 5.5, Z = 1.5 },
		{ X = -10, Z = 3.5 },
		{ X = 10, Z = 3.5 },
		{ X = -14.5, Z = 5.5 },
	},
	FollowRankStepZ = 3.5,
	FollowArriveStuds = 2, -- within this of its slot a unit stands still and faces where the player faces
	FollowMirrorHysteresis = 3, -- after a turn the wings swap sides when that saves this many studs per unit
	-- FollowPath: a unit that cannot walk straight to its slot stands against the wall beside the player when the slot
	-- is inside or behind that wall (walking along a building), squeezes in when a wall end is in its way, else walks
	-- the player's own trail (a 6-stud door, a narrow lane, a floor above) and fans back out once its slot is
	-- walkable. Server raycasts per unit per think (2.5 Hz): 0 in its slot, 2 on the way, 5 against a wall, 5-11 on
	-- the trail, a full trail scan only on losing its place (at most every RescanSeconds when nothing is walkable).
	-- Enabled = false = straight MoveTo, as before.
	FollowPath = {
		Enabled = true,
		CrumbSpacing = 3, -- studs the player moves before a new trail point
		MaxCrumbs = 12,
		ResetJump = 40, -- a jump this far (respawn, recall, vehicle) starts a new trail
		ReachStuds = 2.5, -- a unit this close to its trail point takes the next one
		StopGap = 4, -- trail points closer than this to the player are skipped (a cut-off unit stops behind you)
		RescanSeconds = 2,
		RayDrop = 1, -- rays run this far below the root centres (knee-to-waist): kerbs and pads never block
		RayHalfWidth = 0.9, -- one ray along each edge of the unit's 2-stud body
		WallGap = 1.5, -- a unit against a wall stands this far off it
		MinSide = 3, -- ...and only when that leaves this much room from the player's centre line (else the trail)
		SqueezeStuds = 2, -- a wall end in the way of an open slot: aim this much nearer the player instead
	},
	AttackAggroRange = 120,
	AttackRange = 55,
	AttackDamage = 8,
	AttackFireRate = 1.8,
	HoldLeashStuds = 14,
	UnitHealth = 90,
	UnitWalkSpeed = 14,
	UnitColor = Color3.fromRGB(70, 90, 55),

	VisualKind = "Infantry",
	DisplayName = "Squad",
	ShowUnitLabels = false, -- v68: floating "SQUAD" tag over every field unit (owner: clutter)
	-- v38: brief order state over nearest soldier
	OrderBillboardSeconds = 2.8,
	OrderLabels = {
		Follow = "FOLLOWING",
		Attack = "ATTACKING",
		Hold = "HOLDING",
		Retreat = "RETREATING",
	},

	-- v70 Army popover (spec §3.8): never auto-shown. The rail's Army tile / Y toggles it; it sits right of the
	-- tile (AnchorPoint 0,0.5 at tile right + GapFromTile, tile centre, clamped to the safe area). Sizes are in v
	-- under the one HUD UIScale (HudLayout.ApplyScreen: 0.70 on phones), so 64 v = 44.8 real px.
	Walkie = {
		Size = UDim2.fromOffset(216, 180), -- desktop: title + 2×2 cells of 100×44 v + MANAGE row 40 v
		SizeTouch = UDim2.fromOffset(216, 244),
		-- claude-bud JOB 38 (ArmyOrdersConfig live): a third row (SEND / RECALL) + the plan status line
		SizeTouchPlan = UDim2.fromOffset(216, 346),
		SizePlan = UDim2.fromOffset(216, 262),
		PanelMaxHeightPlan = 360,
		StatusHeight = 22, -- 2×2 cells of 96×64 v + title + MANAGE row
		MinTouchPx = 64, -- v; 56 v × 0.70 = 39 px was under the 44 px touch minimum
		PanelMaxWidth = 240, -- popover 216 v + padding (UISizeConstraint)
		PanelMaxHeight = 260,
		GapFromTile = 10, -- v between the Army tile's right edge and the popover
		EdgeMargin = 8, -- v kept free between the popover (incl. its corner ✕) and the safe-area edges
		Pad = 6,
		TitleHeight = 28,
		TitleSize = 22, -- "ARMY 5/20" (Display font)
		CellGap = 4,
		CellHeightDesktop = 44,
		ManageHeightDesktop = 40,
		CellTextSize = 18,
		CaptionSize = 16, -- desktop "ORDERS 1-4 · T" hint, hotkey digits
		CloseFace = 30, -- v ✕ disc centred on the popover's top-right corner (hit = MinTouchPx on touch)
		Bg = Color3.fromRGB(22, 24, 28),
		BgTransparency = 0.08,
		Accent = Color3.fromRGB(72, 220, 96), -- the Army rail tile's accent: popover + cell strokes
		CellBg = Color3.fromRGB(32, 36, 42),
		ActiveBg = Color3.fromRGB(40, 132, 60), -- the order the squad follows now
		ManageBg = Color3.fromRGB(16, 58, 28),
		HotkeyToastSeconds = 1.6, -- T with the popover closed → local Info toast "Squad: FOLLOW"
	},
}

return OrdersConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">OutpostDefenderConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 24 §6 (owner: "only the Bank has enemies"): NPC defenders at every capturable outpost
	(Server/Modules/OutpostDefenders). The v2 map removed the static statues and meant "live CombatService NPCs", but
	nothing ever spawned them (TerritoryConfig.GuardNPCType / GuardCount were never read).

	  * Every non-starter territory that is NOT held by a player / clan has defenders: live CombatService NPCs (the same
	    animated soldier rigs as the Bank and the camps), placed on a ring round the capture point, leashed to it, that
	    shoot back (CombatService's NPC brain: line of sight + hit chance).
	  * Tier by the outpost's worth (StipendCash): Easy / Medium / Hard (Hard uses the territory's own GuardNPCType x
	    GuardCount: Fort / Oil Rig guards).
	  * Capture cannot start while any of them is alive (TerritoryService: "Defeat the defenders first!").
	  * Awake only while a player is within WakeStuds; asleep (despawned, no reward) after nobody is within SleepStuds for
	    SleepAfterSeconds. Cleared: back RespawnSeconds after the last one fell (still not player-held). Captured: the
	    rest leave; they come back RespawnSeconds after it is neutral again.
	  * At most MaxTotal defenders on the server; kills pay the NPC type's cash + XP (CombatService) and count on MOST
	    KILLS (EngagementService.NoteDefenderKill).
	Enabled = false: no defenders anywhere (v116).
]]

local OutpostDefenderConfig = {
	Enabled = true,
	WakeStuds = 260,
	SleepStuds = 380,
	SleepAfterSeconds = 30,
	RespawnSeconds = 150,
	MaxTotal = 20, -- (CombatConfig.SpecialOverCap leaves room for these + the bank)
	CheckSeconds = 2,
	RingFraction = 0.5, -- ring radius = the territory radius x this (oil rigs: RigRingStuds, on the deck)
	RigRingStuds = 9,
	LeashExtraStuds = 25,
	-- StipendCash thresholds -> tier
	MediumFromStipend = 5000,
	HardFromStipend = 10000,
	Tiers = {
		Easy = { "Infantry", "Infantry", "Infantry" },
		Medium = { "Infantry", "HeavyInfantry", "HeavyInfantry", "Infantry" },
		-- Hard: the territory's GuardNPCType x GuardCount (else this)
		Hard = { "HeavyInfantry", "HeavyInfantry", "HeavyInfantry", "HeavyInfantry" },
	},
	-- claude-bud JOB 24 §7: enemy garrisons at the named areas that are NOT outposts (WorldConfig.POIs; the map
	-- already dresses them: Ruined Village, Desert Airstrip, Crash Site, Signal Station, Oasis). Same rules as an
	-- outpost's defenders (wake / sleep / respawn / MaxTotal / rewards / MOST KILLS); nothing to capture. Tier by
	-- distance out from the town: Easy near the middle, Hard out at the edge.
	Areas = {
		{ Id = "Crash", Name = "Crash Site", Position = Vector3.new(-540, 1, 1140), Radius = 60, Tier = "Easy" },
		{ Id = "Signal", Name = "North Ridge Signal Station", Position = Vector3.new(-95, 1, -1300), Radius = 60, Tier = "Easy" },
		{ Id = "Airstrip", Name = "Desert Airstrip", Position = Vector3.new(510, 1, -1265), Radius = 80, Tier = "Medium" },
		{ Id = "Ruins", Name = "Ruined Village", Position = Vector3.new(-540, 1, -1320), Radius = 70, Tier = "Medium" },
		{ Id = "Oasis", Name = "Oasis", Position = Vector3.new(-1300, 1, 560), Radius = 60, Tier = "Hard" },
	},
	BlockedText = "Defeat the defenders first!",
	BlockedNoteSeconds = 6,
}

return OutpostDefenderConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">PlazaBountyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 4.3 (2026-09-29): plaza bounty. When someone captures the Central Plaza, every OTHER player the
	feature is live for gets a timed bounty: retake the plaza within WindowSeconds for Cash (server-side, paid by
	Server/Modules/PlazaBounty from TerritoryService's capture). Anti-farm: the retaker must not be the bounty's holder,
	each player earns at most once per EarnCooldownSeconds, and a capture of the plaza starts a new bounty only after
	the previous one ended. The plaza gets the objective marker ("BOUNTY") for the window.
	Rollout "owner" = AdminConfig.IsPlaytestOwner only (the owner is offered and can earn it), "all", anything else =
	off (no bounty: the game as before).
]]

local AdminConfig = require(script.Parent.AdminConfig)

local PlazaBountyConfig = {
	Rollout = "all", -- v101
	ZoneId = "CentralPlaza",
	WindowSeconds = 180,
	Cash = 15000,
	EarnCooldownSeconds = 600,
}

function PlazaBountyConfig.LiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("PlazaBounty") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = PlazaBountyConfig.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return AdminConfig.IsPlaytestOwner(userId)
	end
	return false
end

return PlazaBountyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">PlazaBuildingsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 32 (2026-09-30): ENTERABLE buildings round the Central Plaza. The Crossroads Town buildings are solid
	boxes with Roblox-made mesh fronts (nobody can go in). For the rows listed in Rows, WorldKits builds the "PlazaHouse"
	instead: same footprint and frame as the TownHouse it replaces, facing the plaza.
	  * Ground floor: a 6 x 8 door in the front; windows are open GAPS (no glass), so shots through them work.
	  * Stair: a ramp up the right-hand wall to the upper floor, with a rail round the stair hole. The upper floor has
	    windows on every side.
	  * Roof: a ladder (TrussPart) up through a hatch in the back-left corner. v133 (Code Bot): the hatch is a real
	    5.6 x 5.3 opening with a frame, a railing on its open edges and the lid propped open; the ladder stands on the
	    hole's inner edge so you climb inside the hole and step off its top onto the roof (tools/sim/run_hatch_test.py). A 3.2-stud parapet all round (chest-high
	    cover: shoot over it, duck behind it), plus two sandbag rows at the front corners.
	  * A few crates inside for cover.
	  * v133 (Code Bot): a town-centre facade per building (Styles): coloured walls, door and window frames, glass in
	    the gaps (see-through, never collides or answers a ray: shots and sight still pass), striped awnings, a shop
	    sign board, storey band and cornice, corner quoins, a balcony, planters, a bench, a lantern; rooftop AC units, a
	    water cistern and an antenna.
	  * Parts each (was 55).
	Every shooter uses the one line-of-sight rule (CombatConfig.LineOfSight / Shared/Util/LosRule): the walls stop
	shots, the window gaps and the roof edge do not.
	The army (ArmyConfig.Indoors) forms up outside the door while its owner is inside or on the roof. It never walks
	in, never gets stuck on the stair, and is never teleported.
	The Town's budget and layout do not move: the planner and the Town cap still count the TownHouse, and the extra parts
	come out of MaxExtraParts.
	Kill switch: Enabled = false (the rows build the solid TownHouse again). The world is built once for everyone, so
	this has no per-player rollout.
]]

local PlazaBuildingsConfig = {
	Enabled = true,
	MaxExtraParts = 640, -- v133: 4 x (Parts - the plain TownHouse) with room to spare (was 240 for 55-part houses)
	-- WorldConfig.Town row Ids: the 4 buildings that face the plaza flag, one on each side
	Rows = { NE_E1 = true, SW_S1 = true, NE_N1 = true, NW_W1 = true } :: { [string]: boolean },
	DoorOutStuds = 10, -- where the army waits: this far out from the door, on the street side
	Parts = 142, -- v133 (Code Bot): the facade + the real hatch (was 55); tools/sim/run_plaza_test.py counts them
	-- v133 (Code Bot): the town-centre look, one per row (walls, trim, awning, accent: a cafe, a market, a hotel, a radio shop)
	Styles = {
		NE_E1 = { Wall = Color3.fromRGB(214, 172, 104), Trim = Color3.fromRGB(240, 230, 204), Awning = Color3.fromRGB(34, 124, 122), Accent = Color3.fromRGB(92, 64, 44) },
		SW_S1 = { Wall = Color3.fromRGB(190, 110, 78), Trim = Color3.fromRGB(236, 220, 196), Awning = Color3.fromRGB(34, 52, 96), Accent = Color3.fromRGB(58, 44, 36) },
		NE_N1 = { Wall = Color3.fromRGB(176, 172, 162), Trim = Color3.fromRGB(226, 224, 216), Awning = Color3.fromRGB(150, 38, 36), Accent = Color3.fromRGB(56, 58, 62) },
		NW_W1 = { Wall = Color3.fromRGB(168, 156, 112), Trim = Color3.fromRGB(230, 222, 196), Awning = Color3.fromRGB(214, 110, 30), Accent = Color3.fromRGB(62, 66, 48) },
	} :: { [string]: { Wall: Color3, Trim: Color3, Awning: Color3, Accent: Color3 } },
}

return PlazaBuildingsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">PlazaServicesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 39 (2026-09-30): the plaza stations (JOB 39 §3). Which building becomes which station, where its
	NPC stands (in the building's own frame: local -Z = the door side, the ground floor top at y 0.3), the prompt,
	the door sign and the interior prop count.

	The station interiors are built on the CLIENT, only for a player EndgameConfig is live for (Part = the station's
	EndgameConfig.Parts switch). So while the job is owner-first nobody else sees a change, and nothing is added to the
	shared world budgets. The server publishes each station's frame (ReplicatedStorage.WE_PlazaStations, a CFrameValue
	per station) from the Enterables registry and checks every purchase against the same frame (EndgameConfig.Station).
	Budget per house (ROBLOX-BUILD-GUIDE §3): <= MaxParts parts, one PointLight (Shadows off, Range <= 16), one sign
	SurfaceGui (MaxDistance <= 40). run_endgame_test.py builds each station with the real client builder and counts.
]]

local PlazaServicesConfig = {
	FolderName = "WE_PlazaStations",
	MaxParts = 40,
	LightRange = 14,
	LightBrightness = 0.7,
	SignMaxDistance = 40,
	PromptRange = 12,
	Stations = {
		Command = {
			Row = "NE_N1", -- the hotel facade (red awning)
			Part = "EmpireLevel",
			Title = "COMMAND OFFICE",
			Sign = "COMMAND",
			Npc = "Chief of Staff",
			Action = "Empire Level",
			-- the NPC stands behind the map table, facing the door
			NpcAt = Vector3.new(-2.5, 0.3, 1.1),
			Parts = 39,
		},
		-- the Office Building store prop (StorePropsConfig 12423243620): its ground floor is not known to be walkable, so
		-- the Engineer works at a covered drafting stand in its forecourt (the spec's fallback). Without the prop the stand
		-- goes FallbackOffset from the Command Office house (street side).
		Engineers = {
			StoreProp = 12423243620,
			FallbackRow = "NE_N1",
			FallbackOffset = Vector3.new(16, 0, -14),
			ForecourtStuds = 7,
			Part = "Defence",
			Title = "ENGINEERING BUREAU",
			Sign = "ENGINEERS",
			Npc = "Engineer",
			Action = "Defences",
			NpcAt = Vector3.new(0, 0.3, 1.6),
			Parts = 32,
		},
		-- phase 3: the cafe facade (teal awning). A counter with lockers behind it, the Drill Sergeant, a flag stand.
		Recruits = { Row = "NE_E1", Part = "Elite", Title = "RECRUITMENT OFFICE", Sign = "RECRUITS", Npc = "Drill Sergeant", Action = "Elite Training", NpcAt = Vector3.new(-2.5, 0.3, 1.1), Parts = 37 },
		-- phase 4: the market facade (navy awning), ground floor: a gun bench, a wall rack, the Gunsmith
		Armory = { Row = "SW_S1", Part = "Mastery", Title = "ARMORY WORKSHOP", Sign = "ARMORY", Npc = "Gunsmith", Action = "Gun Upgrades", NpcAt = Vector3.new(-2.5, 0.3, 1.1), Parts = 39 },
		-- phase 4: the Town Hospital store prop (5201630514): a field-hospital stand in its forecourt (reception desk, 2
		-- stretcher beds, an IV stand); a white plus on green (no red-cross emblem). No prop: beside the radio shop house.
		Hospital = {
			StoreProp = 5201630514,
			FallbackRow = "NW_W1",
			FallbackOffset = Vector3.new(16, 0, -14),
			ForecourtStuds = 7,
			Part = "Hospital",
			Title = "FIELD HOSPITAL",
			Sign = "HOSPITAL",
			Npc = "Field Medic",
			Action = "Medic",
			NpcAt = Vector3.new(0, 0.3, 1.6),
			Parts = 37,
		},
		-- phase 5: the radio-shop facade (orange awning): a radio desk, a map wall, the Signals Officer
		Intel = { Row = "NW_W1", Part = "Contracts", Title = "INTEL OFFICE", Sign = "INTEL", Npc = "Signals Officer", Action = "Intel", NpcAt = Vector3.new(-2.5, 0.3, 1.1), Parts = 37 },
		-- phase 5: the market's UPPER floor (SW_S1): the Trader behind a crate counter facing the stair; no door sign
		-- (the ARMORY sign is the building's), a small board instead
		BlackMarket = { Row = "SW_S1", Part = "BlackMarket", Title = "BLACK MARKET", Sign = "BLACK MARKET", Npc = "Trader", Action = "Black Market", NpcAt = Vector3.new(0.5, 11.4, -6), Parts = 23, Upstairs = true },
		-- phase 5: the Fixer's side desk inside the Empire Bank hall (x 208..232, z -236..-214, floor top 1.6), against
		-- the east wall, facing the hall (WorldAt + Face: the frame's -Z looks along Face)
		Heist = {
			WorldAt = Vector3.new(229.6, 1.6, -218.5),
			Face = Vector3.new(-1, 0, 0),
			Part = "Heist",
			Title = "THE FIXER",
			Sign = "HEIST",
			Npc = "Fixer",
			Action = "Heist kits",
			NpcAt = Vector3.new(0, 0, 1.4),
			Parts = 24,
		},
	} :: { [string]: any },
	-- the order the base EMPIRE panel lists them in
	Order = { "Command", "Engineers", "Recruits", "Armory", "Hospital", "Intel", "BlackMarket", "Heist" },
}

return PlazaServicesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">PlotOilPumpConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Near-plot oil pumpjacks outside DefensiveWalls (toward warzone / map origin).
	Income → PendingCash. Does NOT touch OilRig Alpha/Bravo far POIs.
]]

local PlotOilPumpConfig = {
	Enabled = true,
	MinWallsLevel = 2,
	PumpsPerPlot = 2,
	WallClearanceStuds = 18,
	LateralSpreadStuds = 22,
	CashPerTick = 18,
	TickSeconds = 5,
	VisualPropKey = "OilPumpjack", -- v41 realistic nodding donkey (alt OilPumpjackAlt)
	FolderName = "WE_PlotOilPumps",
	Reason = "plot_oil",
	-- F9 (owner's 11 features): Golden Pumpjacks (MonetizationConfig.DevProducts.GoldenPumpjack). Owners' pumps are
	-- dressed gold Metal with Reflectance (no Neon, no light). Non-owners, while the Id is live, get ONE 7x7 gold pad
	-- (WE_PremiumPad, OfferKind DevProduct, OfferKey GoldenPumpjack) PadOffsetStuds from the pumps toward the plot, with
	-- one stud-scaled label (MaxDistance LabelMaxDistance, never AlwaysOnTop, tagged WorldLabelConfig.BaseLabelTag).
	Golden = {
		Color = Color3.fromRGB(255, 195, 60),
		Material = Enum.Material.Metal,
		Reflectance = 0.2,
		PadOffsetStuds = 10,
		LabelMaxDistance = 20,
	},
}

return PlotOilPumpConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">PremiumGunsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 35 (2026-09-30): the PREMIUM GUNS ARMORY. Six Robux guns (WeaponConfig, Premium = true, CostCash 0)
	sold by game passes (MonetizationConfig PG_*, prices there only; Id 0 = SOON, never prompted), shown in glass cases
	in every base next to the Supply Depot, and as gold rows in Shop > WEAPONS.
	  * Owning PG_<gun> or PG_ArmoryPass sets profile.Weapons[id] = true (PremiumGunService: join + OnPassOwned).
	  * Cash purchase refuses Premium guns (CombatService.PurchaseWeapon "RobuxOnly"); equip refuses unowned ones.
	  * New server-side gun mechanics (Shared/Util/GunMechanics): Burst, SpinUp, ChargeSeconds, Pierce, HeadshotMult.
	  * The Longshot has a real scope (client: Modules/Scope).
	Kill switch: Live (RetentionConfig.Live rule: OwnerFirst = UserId 470626172 + Studio). Off = no armory, no grants,
	no gold rows (the guns stay in WeaponConfig, unowned and unsold, like the rebirth guns before their rebirth).
]]

export type Gun = { WeaponId: string, PassKey: string }

local PremiumGunsConfig = {
	Live = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
	},
	-- the playtest owner gets the six guns while live and the passes are Id 0 (so he can test them); off = passes only
	OwnerTestGrant = true,
	BundleKey = "PG_ArmoryPass",

	-- case order (left to right as you face the row)
	Guns = {
		{ WeaponId = "SovereignPistol", PassKey = "PG_Sovereign" },
		{ WeaponId = "QuakeLauncher", PassKey = "PG_Quake" },
		{ WeaponId = "LongshotSniper", PassKey = "PG_Longshot" },
		{ WeaponId = "HavocRotary", PassKey = "PG_Havoc" },
		{ WeaponId = "ThunderheadLauncher", PassKey = "PG_Thunderhead" },
		{ WeaponId = "TempestRailgun", PassKey = "PG_Tempest" },
	} :: { Gun },

	--[[ The armory row (plot-local studs, like MonetizationConfig.PremiumPads.Depot): 7 cases in one line west of the
		Supply Depot (X -78 .. -54 at Z 146), the 7th = the Armory Pass (all six guns on a rack). Cases face the plot
		(front = -Z). One sign behind, one light for the whole row (Shadows off). ]]
	Armory = {
		X0 = -92,
		Step = -6.5,
		Z = 146,
		SignZ = 152,
		Sign = "ARMORY",
		FolderName = "WE_Armories",
		Plinth = Vector3.new(4, 1.2, 4),
		Glass = Vector3.new(3.4, 4.2, 3.4),
		GlassTransparency = 0.6,
		OwnedGlassTransparency = 0.92, -- "once owned the glass fades"
		Trim = Color3.fromRGB(212, 175, 55),
		LightRange = 26,
		LightBrightness = 1.2,
		PromptDistance = 10,
		LabelMaxDistance = 40, -- WorldLabel cap; the LabelGovernor shows at most 3 base labels at once
		SpinDegPerSecond = 40, -- client spins the gun template in each case
		ShowDistance = 70, -- client builds the spinning guns only within this distance
		GunLength = 2.6, -- the displayed gun is scaled to this length inside the case
	},

	-- the Longshot scope (client, Modules/Scope)
	Scope = {
		BaseFov = 70,
		Levels = { 20, 12 }, -- first press, then again (wheel / second SCOPE tap); a third tap exits
		SwayDeg = 0.35, -- while moving
		SwayIdleDeg = 0.06,
		RecoilMult = 0.5, -- the phone SCOPE button reuses RELOAD's validated size, straight above it
	},
}

local RetentionConfig = require(script.Parent.RetentionConfig)

function PremiumGunsConfig.LiveFor(userId: any): boolean
	return RetentionConfig.Live(PremiumGunsConfig.Live, userId)
end

-- the premium gun for a pass key ("PG_Sovereign" -> "SovereignPistol"); nil for the bundle / anything else
function PremiumGunsConfig.GunForPass(passKey: string): string?
	for _, g in ipairs(PremiumGunsConfig.Guns) do
		if g.PassKey == passKey then
			return g.WeaponId
		end
	end
	return nil
end

-- the pass for a premium gun ("SovereignPistol" -> "PG_Sovereign")
function PremiumGunsConfig.PassFor(weaponId: string): string?
	for _, g in ipairs(PremiumGunsConfig.Guns) do
		if g.WeaponId == weaponId then
			return g.PassKey
		end
	end
	return nil
end

--[[ The weapons a set of owned pass keys unlocks (the single passes + the bundle). owned: { [passKey]: boolean }. ]]
function PremiumGunsConfig.UnlockedBy(owned: { [string]: boolean }): { string }
	local out: { string } = {}
	local all = owned[PremiumGunsConfig.BundleKey] == true
	for _, g in ipairs(PremiumGunsConfig.Guns) do
		if all or owned[g.PassKey] == true then
			table.insert(out, g.WeaponId)
		end
	end
	return out
end

-- the bundle hides once all six single passes are owned
function PremiumGunsConfig.BundleHidden(owned: { [string]: boolean }): boolean
	for _, g in ipairs(PremiumGunsConfig.Guns) do
		if owned[g.PassKey] ~= true then
			return false
		end
	end
	return true
end

return PremiumGunsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">PremiumVehicleConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): premium Robux vehicles — lineup, camo palettes, free test drive, showroom and copy
	(premium_vehicles.md §1, §2, §6, §7; plan §2.2). Vehicle stats and kits live in VehicleConfig (M6 adds the
	Premium defs); HP / damage in VehicleCombatConfig; mounts in VehicleWeaponConfig.
	Config only: nothing reads this file yet and nothing is sold from it.

	Money rules:
	- Robux only: permanent game passes. Never Cash, codes, Battle Pass, spinner or rebirth grants. Work from
	  Level 1 with no Depot, kept through Rebirth. profile.Vehicles is never read for premium vehicles (J4).
	- Every product Id is 0: the pass rows (PassKey below) are added to MonetizationConfig.GamePasses by M1 with
	  Id = 0 and HideFromShop, created by the owner with Item for Sale OFF (J3), and turned on sale only in the
	  publish that makes the feature live. Asset ids here are 0 too (0 = built-in Part look / no sound).
	- A premium row is hidden while its pass Id is 0 in a live server, or while its Phase is not live.
	- Offers go through the Offer Director (OfferShow) only; there is no PremiumVehicleOffer remote (J30). ]]

export type LineupEntry = {
	VehicleId: string,
	PassKey: string, -- MonetizationConfig.GamePasses key (Id lives there; 0 until the owner creates it)
	DisplayName: string,
	RobuxPrice: number, -- fallback only; the Garage shows the live price (PriceCache, J28)
	Phase: number, -- 1 = ground (M6), 2 = helicopter (M6b), 3 = boat (M6b)
	DefaultCamo: string,
	Seats: number,
	SquadSeats: number?, -- seats the owner's field squad may take (M6b decides the heli / boat layout)
	FiringPorts: number?, -- squad seats that fire at NPCs
	Weapons: { string }, -- VehicleWeaponConfig.Mounts ids
	Tagline: string,
}

export type CamoDef = {
	DisplayName: string,
	Base: Color3,
	Panel: Color3,
	Patch1: Color3,
	Patch2: Color3,
	Trim: Color3,
	Glow: Color3,
}

local GOLD = Color3.fromRGB(255, 200, 70) -- premium pinstripes / rims / turret band (§2.1)

local PremiumVehicleConfig = {
	Enabled = true,
	-- claude-bud JOB 5a: a pass owner's premium vehicle skips the post-destruction repair wait (VehicleService.RequestSpawn)
	FreeRespawn = true,

	Lineup = {
		{
			VehicleId = "PremiumRazorfang",
			PassKey = "PV_Razorfang",
			DisplayName = "Razorfang GT Interceptor",
			RobuxPrice = 199,
			Phase = 1,
			DefaultCamo = "Urban",
			Seats = 4,
			SquadSeats = 3,
			FiringPorts = 2,
			Weapons = { "TwinHoodMG" },
			Tagline = "Fastest armored car · twin hood MGs you fire while driving",
		},
		{
			VehicleId = "PremiumBastion",
			PassKey = "PV_Bastion",
			DisplayName = "Bastion Gun Truck",
			RobuxPrice = 399,
			Phase = 1,
			DefaultCamo = "Woodland",
			Seats = 10,
			SquadSeats = 9,
			FiringPorts = 8,
			Weapons = { "RoofHMG" },
			Tagline = "Carries up to 9 soldiers · roof machine gun", -- J22 (not "your whole squad")
		},
		{
			VehicleId = "PremiumWarlord",
			PassKey = "PV_Warlord",
			DisplayName = "Warlord Siege Tank",
			RobuxPrice = 799,
			Phase = 1,
			DefaultCamo = "Desert",
			Seats = 6,
			SquadSeats = 5,
			FiringPorts = 4,
			Weapons = { "SiegeCannon", "CommanderMG" },
			Tagline = "Heaviest armor · siege cannon",
		},
		{
			VehicleId = "PremiumStormwing",
			PassKey = "PV_Stormwing",
			DisplayName = "Stormwing Gunship",
			RobuxPrice = 999,
			Phase = 2, -- M6b, after helicopter flight is verified on a phone
			DefaultCamo = "Urban",
			Seats = 8,
			Weapons = { "RocketPods", "ChinGun", "DoorMG" },
			Tagline = "Rocket pods · door gunners · 8 seats",
		},
		{
			VehicleId = "PremiumTidebreaker",
			PassKey = "PV_Tidebreaker",
			DisplayName = "Tidebreaker Assault Boat",
			RobuxPrice = 299,
			Phase = 3, -- M6b, after waterways / boats
			DefaultCamo = "Urban",
			Seats = 6,
			Weapons = { "BowTwinMG" },
			Tagline = "Fast assault boat · bow twin MG",
		},
	} :: { LineupEntry },

	-- All three ground cars (saves 298 R$). J3: the description tells single-car owners to buy the others alone.
	Bundle = {
		PassKey = "PV_MotorPool",
		DisplayName = "Premium Motor Pool",
		RobuxPrice = 1099,
		VehicleIds = { "PremiumRazorfang", "PremiumBastion", "PremiumWarlord" },
		SavesRobux = 298,
		HideIfOwnsAny = { "PV_Razorfang", "PV_Bastion", "PV_Warlord" },
	},

	-- Camo palettes (§2.2): recolour only the Base / Panel / Patch1 / Patch2 / Trim / Glow paint roles
	CamoOrder = { "Desert", "Woodland", "Urban", "Arctic", "Obsidian" },
	Camos = {
		Desert = {
			DisplayName = "Desert",
			Base = Color3.fromRGB(176, 150, 105),
			Panel = Color3.fromRGB(140, 118, 82),
			Patch1 = Color3.fromRGB(120, 95, 62),
			Patch2 = Color3.fromRGB(196, 176, 132),
			Trim = GOLD,
			Glow = Color3.fromRGB(255, 190, 90),
		},
		Woodland = {
			DisplayName = "Woodland",
			Base = Color3.fromRGB(72, 88, 58),
			Panel = Color3.fromRGB(52, 64, 42),
			Patch1 = Color3.fromRGB(40, 48, 32),
			Patch2 = Color3.fromRGB(98, 86, 60),
			Trim = GOLD,
			Glow = Color3.fromRGB(120, 255, 140),
		},
		Urban = {
			DisplayName = "Urban",
			Base = Color3.fromRGB(120, 124, 130),
			Panel = Color3.fromRGB(84, 88, 94),
			Patch1 = Color3.fromRGB(58, 60, 66),
			Patch2 = Color3.fromRGB(160, 164, 170),
			Trim = GOLD,
			Glow = Color3.fromRGB(120, 190, 255),
		},
		Arctic = {
			DisplayName = "Arctic",
			Base = Color3.fromRGB(220, 224, 228),
			Panel = Color3.fromRGB(178, 184, 190),
			Patch1 = Color3.fromRGB(140, 146, 152),
			Patch2 = Color3.fromRGB(240, 242, 244),
			Trim = GOLD,
			Glow = Color3.fromRGB(170, 220, 255),
		},
		Obsidian = {
			DisplayName = "Obsidian Gold",
			Base = Color3.fromRGB(28, 30, 34),
			Panel = Color3.fromRGB(18, 19, 22),
			Patch1 = Color3.fromRGB(40, 42, 48),
			Patch2 = Color3.fromRGB(28, 30, 34),
			Trim = Color3.fromRGB(255, 200, 70),
			Glow = Color3.fromRGB(255, 200, 70),
		},
	} :: { [string]: CamoDef },
	-- Camo → the pass the owner also needs (VIP cross-sell); the others are free for owners
	CamoVIPOnly = { Obsidian = "VIP" } :: { [string]: string },

	-- Free test drive (§6.4): once per vehicle per 24 h, never within 10 s of taking damage; server-timed.
	Trial = {
		Seconds = 90,
		CooldownHours = 24,
		NoDamageInLastSeconds = 10,
		RequestCooldownSeconds = 3,
	},

	-- Offer Director triggers (M3/M6 register them; OfferShow → NotificationController.ShowOffer)
	Offers = {
		KilledByPriority = 85,
		KilledByWindowSeconds = 3, -- WE_LastHitVehicle within this window of the death
		SquadOverflowMinStowed = 2,
		MinSecondsIntoFirstSession = 180,
	},

	-- J7: optional showroom plinth on your own plot (M6b), plot-local, never auto-prompts on touch
	Showroom = { X = 40, Z = 146, YawDeg = -90, MaxDistance = 60 },

	Look = {
		MaxKitParts = 90, -- not counting physics wheels
		NameplateMaxDistance = 180,
		NameplateAlwaysOnTop = false,
		SpawnSparkleCount = 40,
		CharredColor = Color3.fromRGB(35, 32, 30),
		Gold = GOLD,
	},

	-- 0 = built-in look / no custom asset (owner may paste Creator Store ids later)
	Assets = { ChipIconId = 0, SpawnSoundId = 0 },

	Text = {
		Chip = "PREMIUM", -- J24: text, not a glyph that can fall back in FredokaOne
		SectionHeader = "PREMIUM GARAGE · Robux · permanent · kept through Rebirth",
		Permanent = "Permanent · kept through Rebirth",
		Fits = "Fits %d of your %d soldiers", -- J22: live count in the Garage
		TryFree = "TRY FREE 90s",
		TryIn = "TRY in %s",
		Buy = "BUY %d R$",
		Repairing = "%s is being repaired: ready in %ds",
		TrialEnd = "Keep the %s? %d R$",
		KilledBy = "Killed by a %s. Try it free or own it: %d R$",
		SquadOverflow = "%s seats up to %d soldiers",
		ObsidianNeedsVip = "Obsidian Gold needs VIP",
		NotOwned = "Get this vehicle in the Garage",
	},
}

function PremiumVehicleConfig.GetLineupEntry(vehicleId: string): LineupEntry?
	for _, e in ipairs(PremiumVehicleConfig.Lineup) do
		if e.VehicleId == vehicleId then
			return e
		end
	end
	return nil
end

return PremiumVehicleConfig
]]></string>
