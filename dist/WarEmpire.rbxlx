        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ClanConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Clan roster — DataStore WarEmpire_Clans_v1 when API services on;
	session-only fallback otherwise. profile.ClanId always mirrors membership. ]]

local ClanConfig = {
	MaxNameLength = 24,
	MinNameLength = 3,
	MaxTagLength = 5,
	MinTagLength = 2,
	MaxMembers = 20,
	CreateCooldownSeconds = 30,
	-- Territory ownership: capturing while in a clan stamps runtime.ClanId = profile.ClanId
}

return ClanConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">ClanWarConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Clan war / global war — scores + rewards. Product IDs stay 0. ]]

local ClanWarConfig = {
	WarDurationSeconds = 3600,
	MinClanMembersToDeclare = 2,
	DeclareCooldownSeconds = 300, -- anti-abuse: delay before same clan can declare again after settle
	ScorePerTerritoryCapture = 10,
	ScorePerEnemyKill = 1,
	WinningClanCashReward = 25000,
	WinningClanGoldReward = 15,
	ParticipationCashReward = 2500,
	ParticipationGoldReward = 2,
	-- Extra cash per score point for winning clan members (online)
	ScoreBonusCashPerPoint = 50,
	GlobalWarEnabled = true,
	GlobalWarSeasonKey = "GW_S1",
	ScoreboardTopN = 8,
}

return ClanWarConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CodesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Redeemable promo codes (Cash / Gold). Server validates once per code per player.
	Sample codes only — rotate for live seasons.
]]

export type CodeReward = {
	Cash: number?,
	Gold: number?,
	DisplayName: string?,
}

local CodesConfig = {
	-- Normalize: uppercase, strip spaces
	MaxCodeLength = 32,
	Codes = {
		WARFOUNDING = {
			Cash = 15000,
			Gold = 5,
			DisplayName = "War Founding",
		},
		BUILDCONQUER = {
			Cash = 8000,
			Gold = 2,
			DisplayName = "Build & Conquer",
		},
	} :: { [string]: CodeReward },
}

return CodesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CombatConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Combat tuning — health, kill rewards, NPC pool/AI.
	Weapon stats live in WeaponConfig; never trust client damage amounts.
]]

export type NPCTypeDef = {
	Id: string,
	DisplayName: string,
	Health: number,
	Damage: number,
	FireRate: number,
	Range: number,
	WalkSpeed: number,
	AggroRange: number,
	CashReward: number,
	XPReward: number,
	Color: Color3,
}

local CombatConfig = {
	PlayerMaxHealth = 100,
	SpawnInvulnerabilitySeconds = 3, -- mirrors GameConfig; CombatService uses this

	PlayerKill = {
		Cash = 150,
		XP = 40,
	},

	DefaultNPCKill = {
		Cash = 50,
		XP = 15,
	},

	MaxOriginDeltaStuds = 12,
	MaxAimDirectionError = 0.001,
	HitPositionSlopStuds = 4,

	FireRemoteRate = 20,
	FireRemoteBurst = 28,
	ReloadRemoteRate = 2,
	ReloadRemoteBurst = 3,
	EquipRemoteRate = 3,
	EquipRemoteBurst = 4,
	PurchaseWeaponRate = 2,
	PurchaseWeaponBurst = 3,

	MaxActiveNPCs = 18,
	NPCRespawnSeconds = 18,
	NPCThinkInterval = 0.35,
	NPCAlsoSpawnNearTerritories = true,
	MaxTerritoryNPCSpawns = 4,

	NPCTypes = {
		Infantry = {
			Id = "Infantry",
			DisplayName = "Hostile Infantry",
			Health = 80,
			Damage = 10,
			FireRate = 2.5,
			Range = 70,
			WalkSpeed = 12,
			AggroRange = 90,
			CashReward = 50,
			XPReward = 15,
			Color = Color3.fromRGB(140, 55, 55),
		},
		HeavyInfantry = {
			Id = "HeavyInfantry",
			DisplayName = "Heavy Infantry",
			Health = 140,
			Damage = 16,
			FireRate = 1.6,
			Range = 85,
			WalkSpeed = 10,
			AggroRange = 100,
			CashReward = 90,
			XPReward = 28,
			Color = Color3.fromRGB(90, 40, 40),
		},
		OilRigGuard = {
			Id = "OilRigGuard",
			DisplayName = "Oil Rig Guard",
			Health = 200,
			Damage = 20,
			FireRate = 1.4,
			Range = 95,
			WalkSpeed = 9,
			AggroRange = 120,
			CashReward = 140,
			XPReward = 40,
			Color = Color3.fromRGB(110, 70, 35),
		},
		BankGuard = {
			Id = "BankGuard",
			DisplayName = "Bank Guard",
			Health = 220,
			Damage = 28,
			FireRate = 2.2,
			Range = 90,
			WalkSpeed = 14,
			AggroRange = 130,
			CashReward = 150,
			XPReward = 45,
			Color = Color3.fromRGB(55, 65, 120),
		},
		FortGuard = {
			Id = "FortGuard",
			DisplayName = "Fort Guard",
			Health = 170,
			Damage = 17,
			FireRate = 1.7,
			Range = 90,
			WalkSpeed = 10,
			AggroRange = 110,
			CashReward = 120,
			XPReward = 35,
			Color = Color3.fromRGB(100, 95, 70),
		},
	} :: { [string]: NPCTypeDef },

	DefaultNPCType = "Infantry",
}

return CombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DailyOpsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Three rotating Daily Ops (Military Tycoon–style short objectives).
	MissionService merges these into the daily mission list when enabled.
]]

export type DailyOpDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string, -- CaptureTerritory | KillNPC | RecruitSoldiers
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number,
	MinLevel: number,
}

local DailyOpsConfig = {
	Enabled = true,
	-- Always offer exactly these 3 (gold-forward rewards)
	Ops = {
		{
			Id = "DailyOpCapture",
			DisplayName = "Daily Op: Seize",
			Description = "Capture 2 territories or oil platforms.",
			ObjectiveType = "CaptureTerritory",
			Target = 2,
			RewardCash = 5000,
			RewardXP = 100,
			RewardGold = 3,
			MinLevel = 1,
		},
		{
			Id = "DailyOpKillNPC",
			DisplayName = "Daily Op: Clear Hostiles",
			Description = "Eliminate 15 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 15,
			RewardCash = 3500,
			RewardXP = 90,
			RewardGold = 2,
			MinLevel = 1,
		},
		{
			Id = "DailyOpRecruit",
			DisplayName = "Daily Op: Muster",
			Description = "Recruit 10 soldiers at the Training Yard.",
			ObjectiveType = "RecruitSoldiers",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 70,
			RewardGold = 2,
			MinLevel = 1,
		},
	} :: { DailyOpDef },
}

return DailyOpsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DailyRewardConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ 7-day login streak; day 7 resets streak after claim. Field names match MissionService. ]]

local DailyRewardConfig = {
	Rewards = {
		{ Day = 1, Cash = 1000, Gold = 0, XP = 25 },
		{ Day = 2, Cash = 2000, Gold = 0, XP = 40 },
		{ Day = 3, Cash = 3500, Gold = 1, XP = 60 },
		{ Day = 4, Cash = 5000, Gold = 0, XP = 80 },
		{ Day = 5, Cash = 7500, Gold = 2, XP = 100 },
		{ Day = 6, Cash = 10000, Gold = 0, XP = 125 },
		{ Day = 7, Cash = 20000, Gold = 10, XP = 200 },
	},
	StreakResetsAfterDay = 7,
	MissedDayResetsStreak = true,
}

return DailyRewardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DevConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Studio-only flags. Production ignores unless RunService:IsStudio().

	Test / playtest helpers (Studio):
	- SkipTutorial = true  → profile.TutorialComplete on load (no tutorial UI)
	- StudioBoostCash      → set Cash to StudioBoostCashAmount on load
	- FastPassiveIncome    → passive tick every 1s instead of EconomyConfig tick
	- UnlockAllVehicles / UnlockAllWeapons → grant all on load
	- VerboseLogging       → extra Bootstrap prints

	Admin remotes (AdminConfig.UserIds only), via RequestAdminCommand:
	  givecash <n>, givegold <n>, givexp <n>, setlevel <n>, unlockall, resetbase,
	  resettutorial, grantpass <PassKey>, prestige/forceprestige, createclan/joinclan/leaveclan, bpxp, grantpremium
]]

local DevConfig = {
	StudioBoostCash = false,
	StudioBoostCashAmount = 100000,
	-- false so interactive tutorial can be playtested; set true to skip in Studio
	SkipTutorial = false,
	UnlockAllVehicles = false,
	UnlockAllWeapons = false,
	VerboseLogging = true,
	FastPassiveIncome = false, -- if true, tick every 1s (Studio only)
	-- Studio-only: treat listed GamePass keys as owned when product Id is still 0
	MockOwnedGamePasses = {
		-- VIP = true,
		-- DoubleCash = true,
		-- DoubleXP = true,
	} :: { [string]: boolean },

	--[[ Studio / laptop PERF (phase-7)
		StudioSkipWorldDressing = true → MapSetup skips MapDressing entirely in Studio
		  (BIGGEST Play Solo win). Override: set Workspace attribute ForceDress=true
		  OR StudioForceDress=true below, then resetmap / delete WarEmpireSetup + Play.
		WorldDressQuality = "Low" when dressing does run (live or ForceDress): ~60–70% fewer clusters.
		StudioSparseFlora = true → drastic DesertFlora cut in Studio.
		MountainRingSegments = 14 (12–16 band); live can raise later.
	]]
	StudioSkipWorldDressing = true,
	StudioForceDress = false,
	WorldDressQuality = "Low", -- "Low" | "Full"
	StudioSparseFlora = true,
	MountainRingSegments = 14,
}

return DevConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Economy tuning. See BALANCE.md for design intent.
	First ~10 minutes feel fast; progression slows after.
]]

local EconomyConfig = {
	StartingCash = 5000,
	StartingGold = 0,
	MinCash = 0,
	MinGold = 0,
	MaxCash = 1_000_000_000,
	MaxGold = 10_000_000,

	-- Passive income: base + sum(structureLevel * rate)
	-- Early-game pacing (first 10 min): start $5k → CC L1 ($1500) immediately →
	-- base $25/tick (~$300/min) + CC $15 → Barracks L1 ($2500) in ~1 min →
	-- then ~$60/tick sustains VehicleDepot / WeaponsFacility without feeling stuck.
	PassiveIncome = {
		TickSeconds = 5,
		BaseCashPerTick = 25, -- alone: ~300/min → Barracks L1 (2500) in ~50s with upgrades help
		-- Per structure level contribution to Cash/tick
		PerLevelRates = {
			CommandCenter = 15,
			Barracks = 20,
			VehicleDepot = 12,
			WeaponsFacility = 10,
			Helipad = 18,
			Dock = 14,
			Airfield = 22,
			DefensiveWalls = 5,
			Watchtowers = 6,
			Radar = 8,
			ResearchLab = 14,
			MissileDefense = 7,
			PowerStation = 16,
			Warehouse = 25,
			SpecialForcesFacility = 20,
		} :: { [string]: number },
	},

	-- Soft caps / multipliers
	PrestigeCashMultiplierPerLevel = 0.10, -- +10% cash gains per prestige (stacking; see PrestigeConfig)
	DailyRewardCashBonus = true,

	-- Capture stipend tuning lives in TerritoryConfig.CaptureStipend
	-- (periodic cash for owned territories / coastal oil).

	-- Contested outpost income: stacks recount from owned territories (stealable).
	OutpostIncomeBuff = {
		MultPerStack = 0.10, -- +10% per stack
		MaxStacks = 5, -- cap +50%
		ToastSecured = "Outpost secured — +%d%% Income (yours)",
		ToastLost = "Outpost lost — Income buff dropped (stolen)",
		ToastStolenFromYou = "%s stolen by enemy — −Income buff",
		ToastStealGain = "Stole %s — +%d%% Income is now yours",
		-- Legacy alias kept for older callers
		ToastTemplate = "Outpost secured — +%d%% Income (yours)",
	},

	-- PvP ATM raid: touch another player's WE_MoneyCollector to steal PendingCash.
	AtmRaid = {
		Enabled = true,
		StealFraction = 0.10, -- 10% of victim PendingCash
		AtmRaidCooldownSeconds = 60, -- per thief→victim pair
		MaxDistanceStuds = 14, -- server distance check to collector part
		MinStealCash = 1,
		ToastThief = "ATM RAID +$%d (10%%) from %s — 1m cooldown",
		ToastVictim = "ATM RAIDED −$%d (10%% stolen)",
		ToastCooldown = "ATM raid cooldown — %ds left",
	},
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ WAR EMPIRE — Core game settings ]]

local GameConfig = {
