-- live for this player? (OwnerFirst: the owner + Studio testers only)
--[[ claude-bud JOB 40 part C (2026-09-30): two more row types (owner-first, JOB40.OwnerFirst):
	  * ReplaceRows: a store copy REPLACES a WorldKits landmark (e.g. the 6-part RadarDome at Radar Hill's Frontier
	    "Dome" slot): the copy is placed on the kit's footprint first and only THEN the kit's parts are hidden
	    (Transparency 1, no collision / query); any failed check keeps the kit. { Kit part name, At (world X / Z of the
	    slot), Radius (studs to find it), Id, Scale, Yaw }.
	  * BaseRows: per-plot military dressing for a LIVE owner (the helipad / airfield / dock areas that
	    Place.BaseClearStuds keeps every WorldRow out of): plot-local X / Z / Yaw from BaseLayoutConfig's frame, MinLevel
	    of the Anchor structure, Budget.MaxBasePartsPerPlot. Never on VehicleConfig.HelipadSpots / the runway / basin,
	    never touching another part (Place.Pad).
	Both lists stay EMPTY until the Open Cloud probe (tools/probes/job40_props_probe.luau) proves each id loads (rule:
	wire only ids the probe shows loading). The candidates are listed in Candidates + docs/PROP-ASSETS.md. Empty lists =
	OFF == OLD (the RadarDome kit and the plain helipad exactly as today). ]]
local cfg40: any = StorePropsConfig
cfg40.JOB40 = { Enabled = true, OwnerFirst = false } -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone
-- Code Bot v152 re-probe (2026-09-30, after the owner's Get Model; docs/PROP-ASSETS.md): 1 of 19 passes, the market
-- stall 86311252190175 (1 MeshPart, its mesh + texture by its creator IAmASwedishMale, no scripts). It replaces the two
-- tier-1 Part stalls in the Crossroads Town market lane (dry run: bottom on the kit base, 0 overlaps, faces the lane).
-- No radar / tower / bunker passed, so the RadarDome kit and BaseRows stay as today.
cfg40.ReplaceRows = {
	-- after the probe, e.g.: { KitPart = "RadarDome", At = Vector3.new(-1053.5, 0, -1009.8), Radius = 20, Id = <radar station id>, Scale = 1, Yaw = 0 },
	{ KitPart = "StallCounter", At = Vector3.new(-81, 0, -166.4), Radius = 6, Id = 86311252190175, Scale = 5, Yaw = 0 }, -- Town NW_Stall_1 (market stall, IAmASwedishMale)
	{ KitPart = "StallCounter", At = Vector3.new(-80, 0, -182.6), Radius = 6, Id = 86311252190175, Scale = 5, Yaw = 180 }, -- Town NW_Stall_2
} :: { any }
cfg40.BaseRows = {
	-- after the probe, e.g.: { Id = <ops building id>, Anchor = "Helipad", MinLevel = 1, X = 58, Z = -110, Yaw = 180, Scale = 1 },
} :: { any }
cfg40.Budget.MaxBasePartsPerPlot = 600
cfg40.BaseKeepOut = { -- plot-local boxes no BaseRow may touch (centre X / Z, half sizes): helipad spots, runway, basin
	{ X = 40, Z = -125, HX = 18, HZ = 18 }, -- the helipad pad (HelipadSpots inside)
	{ X = -63, Z = -80, HX = 97, HZ = 16 }, -- the runway
	{ X = 128, Z = -112, HX = 27, HZ = 37 }, -- the dock basin
	{ X = 40, Z = -86, HX = 8, HZ = 26 }, -- the HeliApron lane
}
-- JOB 40 candidates (Creator Store search 2026-09-30), PENDING the probe; rejected up front: SN-75 radar (a real weapon
-- system), the Phoenix Sky Harbor / Orly control towers (real places)
cfg40.Candidates = {
	{ Id = 856258654, Name = "Radar Station", Use = "Radar Hill ReplaceRow" },
	{ Id = 91764409, Name = "Radar Station", Use = "Radar Hill ReplaceRow" },
	{ Id = 124247102466690, Name = "Radar Station Military Dish Satellite", Use = "Radar Hill ReplaceRow" },
	{ Id = 110033425601385, Name = "Military Satellite Dish Radar Station", Use = "Radar Hill / North Ridge" },
	{ Id = 37473580, Name = "Pre-War Radar/Radio Station", Use = "Radar Hill" },
	{ Id = 12972439539, Name = "ATC tower", Use = "base helipad BaseRow" },
	{ Id = 10140810871, Name = "ATC Tower", Use = "base helipad BaseRow" },
	{ Id = 10480494876, Name = "ATC Tower", Use = "base airfield BaseRow" },
	{ Id = 1660469777, Name = "Military Cargo HQ", Use = "base airfield BaseRow" },
	{ Id = 5437548774, Name = "Radio Command", Use = "capture sites" },
	{ Id = 9230948087, Name = "Sandbag Bunker", Use = "base guard post / capture sites" },
	{ Id = 12735882090, Name = "Sandbags Bunker", Use = "capture sites" },
	{ Id = 11921729320, Name = "Sandbag Bunker small", Use = "base BaseRow" },
	{ Id = 11921736228, Name = "Sandbag Bunker medium", Use = "base BaseRow" },
	{ Id = 8887518461, Name = "Firebase Sandbag Bunker", Use = "capture sites" },
	{ Id = 86311252190175, Name = "Market stall", Use = "Crossroads Town" },
	{ Id = 388036950, Name = "Market Stand", Use = "Crossroads Town" },
	{ Id = 2033520495, Name = "Stall V2", Use = "Crossroads Town" },
	{ Id = 740042082, Name = "Market", Use = "Crossroads Town" },
}

function cfg40.JOB40LiveFor(userId: any): boolean
	local b = cfg40.JOB40
	if b.Enabled ~= true then
		return false
	end
	if b.OwnerFirst ~= true then
		return true
	end
	local okR, RS = pcall(function(): any
		return game:GetService("RunService")
	end)
	if okR and RS and RS:IsStudio() then
		return true
	end
	return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
end

function StorePropsConfig.LiveFor(userId: any): boolean
	if StorePropsConfig.Enabled ~= true then
		return false
	end
	if StorePropsConfig.OwnerFirst ~= true then
		return true
	end
	local uid = tonumber(userId)
	if uid == nil then
		return false
	end
	if uid <= 0 and game:GetService("RunService"):IsStudio() then
		return true -- Studio test players
	end
	return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(uid)
end

-- every asset id some row uses (sorted; the zone ids first: the zones swap in as soon as a plot is ready)
function StorePropsConfig.NeededIds(): ({ number }, { number })
	local zs, ws, seen = {}, {}, {}
	for _, rows in pairs(StorePropsConfig.ZoneRows) do
		for _, r in ipairs(rows) do
			if not seen[r.Id] then
				seen[r.Id] = true
				table.insert(zs, r.Id)
			end
		end
	end
	for _, r in ipairs(StorePropsConfig.WorldRows) do
		if not seen[r.Id] then
			seen[r.Id] = true
			table.insert(ws, r.Id)
		end
	end
	table.sort(zs)
	return zs, ws
end

return StorePropsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">StreamingConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StreamingConfig (streaming2, lane S1): tunables for the code that has to behave under instance streaming.

	THE SWITCH IS NOT HERE. Workspace.StreamingEnabled, the two radii and the integrity mode live in
	default.project.json (Workspace $properties): the engine does not let a script set StreamingEnabled, so the project
	file is the flag. Every reader of this config is a no-op while Workspace.StreamingEnabled is false
	(StreamPrefetch.Enabled()), so it ships before the switch and a rollback of the switch restores the old behaviour.
]]

local StreamingConfig = {
	-- Player:RequestStreamAroundAsync timeout (seconds) before a cross-map move (StreamPrefetch.PivotTo). The move
	-- happens when the request returns or gives up, so a slow phone waits at most this long.
	PrefetchTimeout = 5,
	-- A move shorter than this needs no pre-fetch: the client always holds StreamingMinRadius round its character.
	-- Keep it <= Workspace.StreamingMinRadius in default.project.json (64).
	NearStuds = 64,
	-- One check this long after a pre-fetched move: when the character is back where it started (the spawn or its
	-- physics undid the pivot), it is moved once more. Replaces the stacked 0.35 s / 1.0 s blind re-applies.
	SettleCheckSeconds = 0.6,
	-- The first spawn of a session is random (the save loads after it). The own PlayerSpawn is an extra replication
	-- focus from the plot assignment until the pre-fetched move home lands, and never longer than this (seconds).
	JoinFocusMaxSeconds = 40,
	-- FallSafety: at most one "Rescued from fall" toast per player in this many seconds.
	FallToastCooldown = 8,
}

return StreamingConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">StructureVisualConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Part-kit silhouettes + palettes for base structures.
	STRUCTURE_SCALE_WIRE v21: TargetFootprint drives VisualAssetService ScaleTo.
	Part kits remain fallback; catalog mesh NEVER sized to host plinth.
]]

export type StructurePalette = {
	Plinth: Color3,
	Body: Color3,
	Accent: Color3,
	Roof: Color3,
	Kit: "hq" | "barracks" | "depot" | "lab" | "tower" | "pad" | "dock" | "wall" | "power" | "warehouse" | "special" | "airfield" | "helipad" | "hangar" | "armory" | "radar",
	TargetFootprint: Vector3?,
	MeshAssetId: number?,
	MeshAssetIdL3: number?,
}

local StructureVisualConfig = {
	GhostTransparency = 0.72,
	SolidTransparency = 0,
	PreferMeshWhenAssetIdSet = false, -- v44 P0 hotfix: Part kits only until visibility proven; re-enable design meshes later
	PreferMeshMinLevel = 1,
	BuildingDressGen = 29, -- v42 DressGen: Hangar≠Warehouse≠Depot, Missile≠Tower; kits stay visible

	--[[
		v67 base look: one military scheme. Palettes below are sand concrete / olive / dark metal with a
		muted per-type Accent used only on small details. The kit "Accent" footprint plate is a concrete
		foundation now (it was a Neon plate scaled to 1.4x the footprint: the glowing purple/green floors).
	]]
	FoundationColor = Color3.fromRGB(146, 142, 130),
	BaseLook = {
		PlotFloor = Color3.fromRGB(168, 162, 148), -- plot pad (was near-black navy)
		PlotEdge = Color3.fromRGB(86, 98, 64), -- painted olive edge (was a green Neon strip)
		Chevron = Color3.fromRGB(230, 196, 70), -- yellow floor paint (was white Neon)
		WallCap = Color3.fromRGB(132, 126, 110),
		Wire = Color3.fromRGB(58, 60, 56),
		GateStripe = Color3.fromRGB(214, 178, 64),
	},
	-- v68: no roof at all over bases (owner). If re-enabled, the barrier is invisible at this height.
	AntiAirCeilingEnabled = false,
	AntiAirCeilingHeight = 48,

	Palettes = {
		CommandCenter = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(200, 186, 150),
			Accent = Color3.fromRGB(214, 178, 64),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "hq",
			TargetFootprint = Vector3.new(36, 16, 28),
			MeshAssetId = 0, -- owner rule 5 (2026-09-25): heavy HQ model cleared; owner pick pending (VisualAssetConfig.Buildings)
		},
		Barracks = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(176, 168, 136),
			Accent = Color3.fromRGB(120, 136, 86),
			Roof = Color3.fromRGB(86, 98, 64),
			Kit = "barracks",
			TargetFootprint = Vector3.new(28, 12, 16),
			MeshAssetId = 0, -- owner rule 5 (2026-09-25): heavy barracks model cleared; owner pick pending (VisualAssetConfig.Buildings)
		},
		VehicleDepot = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(150, 150, 140),
			Accent = Color3.fromRGB(98, 118, 130),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "depot",
			TargetFootprint = Vector3.new(32, 14, 24),
			MeshAssetId = 12208876851, -- v42 arched depot ≠ Hangar
		},
		WeaponsFacility = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(164, 150, 128),
			Accent = Color3.fromRGB(150, 82, 58),
			Roof = Color3.fromRGB(70, 72, 68),
			Kit = "armory",
			TargetFootprint = Vector3.new(28, 18, 18),
			MeshAssetId = 4120970784,
		},
		Helipad = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(96, 98, 92),
			Accent = Color3.fromRGB(214, 178, 64),
			Roof = Color3.fromRGB(70, 72, 68),
			Kit = "helipad",
			TargetFootprint = Vector3.new(28, 4, 28),
