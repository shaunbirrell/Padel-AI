HudConfig.TouchCombat = { -- positions are from the content rect's bottom-right; Roblox's jump button is at
	-- x = W − safeRight − 95 .. +70, y = H − 90 .. +70 (real) and is never covered
	-- Bottom 152 v = 106 real px at S 0.70: FIRE ends 16 px above the jump button (CLAUDE.md: nothing within 16 px)
	Fire = { Size = 88, Anchor = Vector2.new(0.5, 1), Right = 86, Bottom = 152 }, -- centred over the jump button
	Reload = { Size = 64, Anchor = Vector2.new(1, 1), Right = 142, Bottom = 152 }, -- left of FIRE
	FireColor = Color3.fromRGB(220, 50, 50),
	ReloadColor = Color3.fromRGB(34, 38, 44),
	HoldToFireHz = 20, -- existing loop; the server still clamps to the weapon FireRate
	-- W2 (P1-1 drag-to-aim): FIRE is a non-Active Frame, so its touch is NOT sunk and the same thumb that holds FIRE
	-- also turns the camera. CombatController hit-tests UserInputService.TouchStarted against FIRE's rect instead.
	DragAim = true,
	FireSlopPx = 8, -- real px added around FIRE's rect for the TouchStarted hit test (forgiving thumbs)
	ShowWhen = { "Drawn" },
	HideWhen = { "Driving", "Modal", "Dead" },
}

HudConfig.Reticle = {
	Size = 20, -- v
	Gap = 5,
	Arm = 7,
	Thickness = 2,
	Color = Color3.fromRGB(245, 248, 240),
	DotColor = Color3.fromRGB(255, 214, 72),
	CenterOnViewport = true, -- own ScreenGui with IgnoreGuiInset = true → the aimRay centre, not 22 px below it
	ShowWhen = { "Drawn" },
	HideWhen = { "Driving", "Modal", "Reloading", "Dead" },
}

HudConfig.HitFeedback = {
	HitMarkerSeconds = 0.12, -- the X at the reticle is the only feedback for hits you land
	DamageEdgeSeconds = 0.18, -- red screen-edge flash when YOU are hit (no full-screen tint)
	DamageEdgeMinGap = 0.3,
	DamageEdgeTransparency = 0.55,
	FullScreenTint = false, -- the 0.08 s full-screen strobe goes
}

---------------------------------------------------------------------------------------------------------------
-- W2 COMBAT FEEL (client only: WeaponVisuals, CameraFx, AimTargets). The server stays authoritative: the client
-- aim help only nudges the camera; the server re-runs its own cone (AimAssistConfig) on every shot.
---------------------------------------------------------------------------------------------------------------

HudConfig.AimHelp = {
	Enabled = true,
	-- per input class (AimTargets.InputClass(), from UserInputService.PreferredInput); a level name from Levels
	Strength = { Touch = "Medium", Gamepad = "Low", KeyboardAndMouse = "Off" },
	-- FrictionKeep: share of the player's own frame-to-frame camera turn kept while a hostile is in the cone
	-- Tracking:     max share of the target's angular velocity the camera follows (never a snap to centre)
	Levels = {
		Off = { FrictionKeep = 1, Tracking = 0 },
		Low = { FrictionKeep = 0.8, Tracking = 0.1 },
		Medium = { FrictionKeep = 0.6, Tracking = 0.2 },
	},
	ScanHz = 10, -- AimTargets candidate scan (only while drawn and the level is not Off)
	MaxCandidates = 8, -- nearest in-cone candidates considered per scan
	MaxLosRays = 2, -- line-of-sight raycasts per scan
}

HudConfig.CombatCamera = {
	-- P1-3 shoulder camera while drawn, alive and on foot, per input class
	Shoulder = { Touch = true, Gamepad = false, KeyboardAndMouse = false },
	ShoulderOffset = Vector3.new(1.75, 0.6, 0), -- Humanoid.CameraOffset (studs)
	FaceCameraYaw = true, -- AutoRotate off; the root follows the camera yaw (written only when it moves > 1°)
	FovNudge = 0,
	RecoilSpring = { Speed = 20, Damper = 0.8 }, -- WeaponConfig.Recoil.Recover overrides Speed per weapon
	RecoilScaleTouch = 0.5, -- touch players get half the camera kick
	Shake = { BlastAmplitude = 0.6, BlastAmplitudeTouch = 0.3, HitAmplitude = 0.15, MaxRadiusMult = 3 },
	RespectReducedMotion = true, -- GuiService.ReducedMotionEnabled → no shake and no recoil kick
}

HudConfig.CombatFx = {
	CullStuds = 250, -- WeaponFx farther than this from the camera (both ends) is skipped
	Tracers = { Max = 16, MaxTouch = 10, Seconds = 0.08 }, -- Beams on pooled Terrain attachments (0 parts)
	Impacts = { Max = 12, MaxTouch = 8, Emit = 8, EmitTouch = 4 }, -- pooled Attachment + ParticleEmitter (0 parts)
	BulletHoles = { Max = 20, MaxTouch = 10, Seconds = 4 }, -- parts
	Projectiles = { Max = 6, MaxTouch = 4, PartsEach = 3 }, -- parts
	Casings = { Enabled = true, EnabledTouch = false, Max = 8, Seconds = 2 }, -- parts
	MaxFxParts = 48, -- hard cap across the three part pools (20 + 18 + 8 = 46)
	MaxFxPartsTouch = 24, -- touch: 10 + 12 + 0 = 22
	MuzzleFlashSeconds = 0.05,
	RemoteGuns = { Max = 6, MaxTouch = 3, Radius = 120, CoreParts = 5 }, -- other players' drawn guns (core LOD)
	DamageNumbers = { Max = 4, Seconds = 0.8, TextPx = 18 }, -- real px; local only, behind ShowDamageNumbers
	TargetBar = { Seconds = 2.5, Width = 120, Height = 6, NamePx = 14 }, -- real px, under the reticle
	Haptics = { Enabled = true, Hit = 0.2, Kill = 0.5 }, -- touch only (HapticService)
	-- Roblox-owned animation ids (docs/ASSET_SHORTLIST.md §3.4, creator Roblox); 0 disables
	Anims = { Hold = { Rifle = 3972151362, Pistol = 507768375, Launcher = 3972164452 }, Reload = 3972131105 },
	-- gun placement in the hand (device tuning knob; zero = the Roblox Tool default: barrel along the
	-- RightGripAttachment's -Z, top along its +Y). Handle = grip * Rotation(deg, X/Y/Z order) * Offset(studs).
	Grip = { RotationDeg = Vector3.zero, OffsetStuds = Vector3.zero },
}

---------------------------------------------------------------------------------------------------------------
-- RESERVED REGIONS — nothing but the owners listed may draw here (HudLayout.Reserve(name) returns the rect)
---------------------------------------------------------------------------------------------------------------

HudConfig.Reserve = {
	-- Bottom-right vehicle/combat controls. Owners: CombatController (FIRE / R / ammo), VehicleDriveClient
	-- (▲▼ lift/pitch, throttle, exit), Roblox jump. Measured from the content rect's bottom-right, in v;
	-- MinWidthPx/MinHeightPx (real px) are floors so the rect always holds VehicleDriveClient's ▲▼ column:
	-- Laws.ControlsLayout puts it right above the jump button, top edge at H − (90 + 10 + 52 + 8 + 52) = H − 212
	-- on phones (H − 222 without a jump button, H − 218 on tablets); its hard cap is RESERVED_FROM_BOTTOM = 250.
	-- FIRE / RELOAD share that space, which is why combat is hidden while Driving.
	CombatTouch = { Width = 290, Height = 300, MinWidthPx = 0, MinHeightPx = 222 }, -- 844x390: x ≥ 594, y ≥ 168 real
	CombatDesktop = { Width = 340, Height = 150, MinWidthPx = 0, MinHeightPx = 0 }, -- 1280x720: x ≥ 974, y ≥ 585 real
	-- Suggested touch slots (VehicleDriveClient v70 computes its own column above the jump button instead;
	-- these stay as the documented fallback; combat is hidden while seated):
	VehicleTouch = {
		Up = { Size = 64, Anchor = Vector2.new(1, 1), Right = 142, Bottom = 143 }, -- the RELOAD slot
		Down = { Size = 64, Anchor = Vector2.new(1, 1), Right = 142, Bottom = 36 }, -- left of jump, same row
	},
}

---------------------------------------------------------------------------------------------------------------
-- CONTEXT FLAGS + VISIBILITY — HudLayout publishes these; every element's HideWhen/ShowWhen reads them
---------------------------------------------------------------------------------------------------------------

HudConfig.Context = {
	-- Flag       Set by
	-- Modal      any registered panel open (HudLayout.PanelOpened / PanelClosed) — also enforces ONE open panel
	-- Driving    Humanoid.SeatPart is a VehicleSeat (HudLayout watches the humanoid) + VehicleDriveClient
	-- Drawn      CombatController holster state
	-- Reloading  CombatStateUpdate.Reloading
	-- Hurt       health < max
	-- RecentCombat  hit taken/landed or fired within Health.RecentCombatSeconds
	-- Tutorial   TutorialController step active
	-- InOwnPlot  CompassController plot test (inside own walls + margin)
	-- Dead       Humanoid dead (HudLayout: Died → true, CharacterAdded → false) / CombatState.Alive == false
	-- OrdersOpen OrdersController (Army popover open → 1-4 / T are order hotkeys)
	-- Radar      TerritoryController (RadarReveal active → purple dot on the compass chip)
	Flags = { "Modal", "Driving", "Drawn", "Reloading", "Hurt", "RecentCombat", "Tutorial", "InOwnPlot", "Dead", "OrdersOpen", "Radar" },
	ModalExclusive = true, -- opening a panel closes the others
	ModalDim = 0.45, -- BackgroundTransparency of the black dim behind the open panel (UIUtil.MakeModalDim; Active = false; tap outside closes)
}

---------------------------------------------------------------------------------------------------------------
-- INPUT — one table; SettingsController's keybind sheet is generated from it
---------------------------------------------------------------------------------------------------------------

HudConfig.Keys = {
	Shop = Enum.KeyCode.P,
	Rebirth = Enum.KeyCode.K,
	Army = Enum.KeyCode.Y, -- was A (strafe-left toggled the Army panel while walking)
	Garage = Enum.KeyCode.G,
	Missions = Enum.KeyCode.M,
	Settings = nil, -- was O (Roblox camera zoom-out). Gear button only.
	Base = Enum.KeyCode.B, -- Base menu leaves the HUD; B and the Command Center map table remain
	Weapons = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }, -- draw / holster
	WeaponPrev = Enum.KeyCode.Q, -- ignored while seated; E no longer cycles (it is the prompt key)
	WeaponWheel = true, -- mouse wheel cycles only while drawn (camera zoom otherwise)
	Reload = Enum.KeyCode.R,
	OrdersCycle = Enum.KeyCode.T,
	-- 1-4 issue squad orders ONLY while the Army popover is open (HudLayout.GetFlag("OrdersOpen"))
	Gamepad = {
		Fire = Enum.KeyCode.ButtonR2,
		Reload = Enum.KeyCode.ButtonY, -- ButtonX stays the ProximityPrompt button
		Next = Enum.KeyCode.ButtonR1,
		Prev = Enum.KeyCode.ButtonL1,
		DrawHolster = Enum.KeyCode.DPadUp,
	},
	CombatInputBlockedWhen = { "Driving", "Modal", "Dead" }, -- no firing from a seat, through a panel, or dead
	FireNeedsDrawn = true, -- LMB on a ClickDetector (tutorial dropper) never fires the gun while holstered
}

---------------------------------------------------------------------------------------------------------------
-- WORLD LABELS — client console tags (WorldPromptController) + the shared stud-scaled helper (WorldLabel)
---------------------------------------------------------------------------------------------------------------

HudConfig.WorldLabels = {
	Console = {
		Size = UDim2.fromOffset(118, 40), -- real px (pinned PRICE_BILLBOARD_SIZE); plain text, NO card
		StudsAboveConsoleTop = 2.2, -- stays under the 12-stud ceiling inside walk-in buildings
		MaxDistanceBuild = 30, -- L0 "HELIPAD / BUILD $5,000"
		MaxDistanceUpgrade = 18, -- L1-4 "HELIPAD / LV 2 → 3 · $12K"
		NameSize = 16,
		PriceSize = 15,
		NameColor = Color3.fromRGB(255, 255, 255),
		PriceAffordable = Color3.fromRGB(110, 255, 90),
		PriceShort = Color3.fromRGB(255, 96, 96),
		LockedColor = Color3.fromRGB(170, 176, 184), -- "Needs Command Center 2"
		StrokeTransparency = 0, -- Colors.Ink
		ShowOnMax = false, -- MAX lives on the console screen SurfaceGui, not in the air
		ShowIncome = false, -- income is on the console screen and in the Base panel
		OwnerOnly = true,
		AlwaysOnTop = false,
	},
	-- Shared helper Shared/Util/WorldLabel.luau: stud-scaled plain text (Size = UDim2.fromScale(w, h)),
	-- AlwaysOnTop = false, optional OwnerUserId (client hides it for everyone else).
	Default = { StudsW = 6, StudsH = 1.6, MaxDistance = 40, Font = Enum.Font.FredokaOne },
	Transient = { MaxDistance = 28 }, -- "+$10" pops: owner client only
}

return HudConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">LevelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Levels 1–100 via formula.
	XP to go from level L to L+1: floor(100 * L ^ 1.45)
	Rewards granted on level-up (cash + optional gold every 5).

	Milestones: clear unlock messages + HUD next-goal text (Design/Code P0).
	ASSUMPTION: milestone UnlockText is cosmetic guidance; actual gates live in
	VehicleConfig / WeaponConfig / BaseConfig / PrestigeConfig / TerritoryConfig.
]]

export type MilestoneDef = {
	Level: number,
	Title: string,
	UnlockText: string, -- toast on level-up
	HudGoal: string, -- shown until this level is reached (as "next")
	Kind: "Weapon" | "Vehicle" | "Base" | "Territory" | "Prestige" | "Army" | "General",
}

local LevelConfig = {}

LevelConfig.MaxLevel = 100
LevelConfig.MaxLevelBeforePrestige = 100

function LevelConfig.GetXPRequiredForLevel(level: number): number
	if level < 1 then
		return 0
	end
	if level >= LevelConfig.MaxLevel then
		return math.huge
	end
	return math.floor(100 * (level ^ 1.45))
end

function LevelConfig.GetTotalXPForLevel(level: number): number
	local total = 0
	for l = 1, level - 1 do
		total += LevelConfig.GetXPRequiredForLevel(l)
	end
	return total
end

function LevelConfig.GetLevelUpReward(newLevel: number): { Cash: number, Gold: number }
	local cash = 500 + (newLevel * 150)
	local gold = if newLevel % 5 == 0 then math.floor(newLevel / 5) else 0
	return { Cash = cash, Gold = gold }
end

-- Explicit first 20 for designers / BALANCE.md
LevelConfig.Preview = {}
for i = 1, 20 do
	LevelConfig.Preview[i] = {
		Level = i,
		XPToNext = LevelConfig.GetXPRequiredForLevel(i),
		Reward = LevelConfig.GetLevelUpReward(i + 1),
	}
end

--[[
	Ordered milestones. GetNextMilestone(level) returns the first with Level > current.
	Prestige objective: reach PrestigeConfig.MinLevelToPrestige (40) then rebirth.
	Territory objective: capture Central Plaza / any POI (soft goal, not hard gate).
]]
LevelConfig.Milestones = {
	{
		Level = 1,
		Title = "Recruit",
		UnlockText = "Welcome, Commander — claim your base, buy Command Center, recruit soldiers.",
		HudGoal = "GOAL: Claim base → BUY Command Center → Recruit soldiers",
		Kind = "Army",
	},
	{
		Level = 2,
		Title = "Motor Pool",
		UnlockText = "LVL 2 — Utility Quad / Dispatch Car unlock in Garage.",
		HudGoal = "GOAL: Reach L2 · unlock Utility Quad",
		Kind = "Vehicle",
	},
	{
		Level = 3,
		Title = "Assault Rifle",
		UnlockText = "LVL 3 — Assault Rifle unlocked. Buy or equip from combat loadout.",
		HudGoal = "GOAL: Reach L3 · unlock Assault Rifle",
		Kind = "Weapon",
	},
	{
		Level = 4,
		Title = "Scout",
		UnlockText = "LVL 4 — Scout Car + SMG unlock.",
		HudGoal = "GOAL: Reach L4 · Scout Car / SMG",
		Kind = "Vehicle",
	},
	{
		Level = 5,
		Title = "Patrol",
		UnlockText = "LVL 5 — Patrol Truck unlock. Capture Central Plaza for +10% passive cash.",
		HudGoal = "GOAL: Reach L5 · Patrol Truck · capture Central Plaza",
		Kind = "Territory",
	},
	{
		Level = 6,
		Title = "Shotgun + Supply",
		UnlockText = "LVL 6 — Combat Shotgun + Supply Truck unlock.",
		HudGoal = "GOAL: Reach L6 · Shotgun / Supply Truck",
		Kind = "Weapon",
	},
	{
		Level = 8,
		Title = "APC Gate",
		UnlockText = "LVL 8 — APC unlock. Fortify with Defensive Walls when cash allows.",
		HudGoal = "GOAL: Reach L8 · unlock APC",
		Kind = "Vehicle",
	},
	{
		Level = 10,
		Title = "IFV + Sniper",
		UnlockText = "LVL 10 — Combat IFV + Sniper path open. Hold 2 territories for stipends.",
		HudGoal = "GOAL: Reach L10 · IFV · hold 2 territories",
		Kind = "Territory",
	},
	{
		Level = 12,
		Title = "Light Armor",
		UnlockText = "LVL 12 — Light Tank unlock. Push oil rigs for big stipends.",
		HudGoal = "GOAL: Reach L12 · Light Tank · contest an oil rig",
		Kind = "Vehicle",
	},
	{
		Level = 15,
		Title = "Heavy Push",
		UnlockText = "LVL 15 — Heavy Tank / Assault IFV band. Build Helipad for air ops.",
		HudGoal = "GOAL: Reach L15 · Heavy armor · Helipad L1",
		Kind = "Base",
	},
	{
		Level = 20,
		Title = "Air Superiority",
		UnlockText = "LVL 20 — Fighter / CAS jet band. Dominate air + naval docks.",
		HudGoal = "GOAL: Reach L20 · jets · Dock L1",
		Kind = "Vehicle",
	},
	{
		Level = 25,
		Title = "Empire Mid",
		UnlockText = "LVL 25 — Mid-game empire. Max Barracks, stack territory stipends.",
		HudGoal = "GOAL: Reach L25 · Barracks L3+ · 3 territories",
		Kind = "Army",
	},
	{
		Level = 30,
		Title = "War Machine",
		UnlockText = "LVL 30 — Capital vehicles band. Prep Research Lab / Special Forces.",
		HudGoal = "GOAL: Reach L30 · Research Lab · 4 territories",
		Kind = "Base",
	},
	{
		Level = 40,
		Title = "Prestige Ready",
		UnlockText = "LVL 40 — PRESTIGE UNLOCKED. Open Rebirth for +10% cash forever.",
		HudGoal = "GOAL: L40 reached — open Rebirth · Do Prestige (+10% cash)",
		Kind = "Prestige",
	},
	{
		Level = 50,
		Title = "Veteran",
		UnlockText = "LVL 50 — Veteran commander. Push prestige track unlocks.",
		HudGoal = "GOAL: Prestige again · climb rebirth unlock track",
		Kind = "Prestige",
	},
	{
		Level = 75,
		Title = "High Command",
		UnlockText = "LVL 75 — High Command. Max structures, hold forts + oil.",
		HudGoal = "GOAL: Max key structures · hold fortress + oil",
		Kind = "Territory",
	},
	{
		Level = 100,
		Title = "Max Level",
		UnlockText = "LVL 100 — MAX. Prestige to reset level and stack cash mult.",
		HudGoal = "GOAL: Prestige at max · stack +10% cash / rebirth",
		Kind = "Prestige",
	},
} :: { MilestoneDef }

function LevelConfig.GetMilestoneAt(level: number): MilestoneDef?
	local best: MilestoneDef? = nil
	for _, m in ipairs(LevelConfig.Milestones) do
		if m.Level == level then
			return m
		end
		if m.Level < level then
			best = m
		end
	end
	return best
end

function LevelConfig.GetNextMilestone(level: number): MilestoneDef?
	for _, m in ipairs(LevelConfig.Milestones) do
		if m.Level > level then
			return m
		end
	end
	-- At/above last milestone — prestige objective
	return LevelConfig.Milestones[#LevelConfig.Milestones]
end

function LevelConfig.GetHudGoal(level: number): string
	local nxt = LevelConfig.GetNextMilestone(level)
	if not nxt then
		return "GOAL: Prestige for +10% cash · dominate territories"
	end
	if nxt.Level <= level then
		return nxt.HudGoal
	end
	return nxt.HudGoal
end

function LevelConfig.GetUnlockMessage(newLevel: number): string?
	for _, m in ipairs(LevelConfig.Milestones) do
		if m.Level == newLevel then
			return m.UnlockText
		end
	end
	-- Generic every 5 levels
	if newLevel % 5 == 0 then
		return string.format("LVL %d — rank up! Check Garage / Weapons for new unlocks.", newLevel)
	end
	return nil
end

return LevelConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">LootBoxConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ POLICY-PENDING: random loot boxes are NOT enabled.
	This stub exists so shop/UI can show "coming soon" without grant paths. ]]

local LootBoxConfig = {
	PolicyPending = true,
	Enabled = false,
	Boxes = {
		-- Placeholder only — never grant from client; never ProcessReceipt until policy cleared
		StarterCrate = {
			Id = 0,
			DisplayName = "Supply Crate (policy-pending)",
			Description = "Random rewards disabled until compliance review.",
		},
	},
}

return LootBoxConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ManualDropperConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Early-game manual cash droppers near Money Collector + Training Yard (prompt on touch, ClickDetector on PC).
	Server-authoritative; client only fires ClickDetector / ProximityPrompt.
	v71 (HUD v70 spec §5): the price tag reads "$15" (no mouse wording — wrong on phones), owner-only, stud-scaled; the
	"+$15" pop is owner-only too; the plate keeps its glow but no PointLight.
]]

local ManualDropperConfig = {
	Enabled = true,

	-- Award (PendingCash). Prefer AwardAmount; else random [MinAward, MaxAward].
	MinAward = 10,
	MaxAward = 25,
	AwardAmount = 15,

	CooldownSeconds = 0.35,
	RateLimitRate = 4,
	RateLimitBurst = 3,

	-- v69 income budget per player (both droppers share it) so an auto-clicker can't farm all night.
	-- Refilling buckets: a full minute bucket gives a quick burst, then it refills at N/60 per second;
	-- the hour bucket caps long sessions at ~MaxAwardsPerHour (600 x $15 = $9k/h, below base passive).
	MaxAwardsPerMinute = 30,
	MaxAwardsPerHour = 600,
	BudgetEmptyToast = "Cash drop is recharging — the ATM keeps earning meanwhile",
	BudgetEmptyToastCooldown = 20,

	CollectorOffset = Vector3.new(-5.5, 0, 4),
	YardOffset = Vector3.new(6, 0, -4),

	PromptActionText = "Grab Cash",
	PromptObjectText = "Cash Drop",
	PromptMaxDistance = 12,
	PromptHoldDuration = 0,

	PartSize = Vector3.new(2.4, 1.2, 2.4),
	PartColor = Color3.fromRGB(40, 140, 70),
	NeonAccentColor = Color3.fromRGB(90, 255, 120),
	BillboardLabel = "$", -- v71: device-neutral (the old tag told phone players to use a mouse); the owner sees "$15"
	LabelMaxDistance = 30, -- studs (WorldLabel caps at 40)
	LabelStuds = Vector2.new(3, 1.2), -- the tag's box, studs

	PopupDuration = 0.55,
	PopupRiseStuds = 3.2,
}

return ManualDropperConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">MissionConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily objective missions (progress tracked server-side) + legacy timed missions.

	W3 step 2, lane M0 (spec w3s2 §6 Phase A):
	- The daily offer ROTATES (MissionService): 3 Daily Ops (DailyOpsConfig) + 3 daily missions = MaxActiveDaily 6.
	  Levels 1..Rotation.NewPlayerMaxLevel get the Rotation.Fixed missions plus NewPlayerPicks rotating ones; higher
	  levels get Rotation.Picks rotating out of every unlocked mission. Picks are seeded by (UserId, UTC day), so they
	  are stable for the day, need no save, and every unlocked mission comes round within a few days.
	- ObjectiveType "Heist" (a bank job done; BankRaidService tracks it today, OpsService in Phase B).
	- Go: a mission row with a Go key shows GO while it is incomplete. GO points the one objective marker
	  (Client/Modules/ObjectiveMarker) at the nearest target the SERVER sent for that key; never a fixed marker.

	W3 step 2 Phase B, lane M1 (jobs):
	- OpsObjectives (Checkpoint, Camp, Uplink, Delivery, Job) are reported by OpsService (TrackProgress, 1 per finished
	  job for each type in OpsConfig.Kinds[kind].Track). They are live ONLY while OpsService's hook says so
	  (MissionService.SetOpsHooks: ObjectiveLive), so with no hook (OpsConfig.Enabled = false) the offer is exactly
	  Phase A's. Heist stays in LiveObjectives: BankRaidService reports it until the cutover, OpsService after.
	- Go keys Checkpoint / Camp / Uplink / Job / Cargo / Hostiles are answered by the same hook (GoTargets: every Open
	  site of that key; the server sends the GoMaxTargets nearest to the player, the client picks the nearest).
	  With no hook they have no target: a Required one keeps its mission off the offer, Hostiles just hides GO.
	- Capture has no Go key yet (TerritoryService is batch B's; a neutral-zone pointer must skip every Home Outpost).
]]

export type DailyMissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	-- KillNPC | KillPlayer | CaptureTerritory | PurchaseUpgrade | EarnCash | SpawnVehicle | RecruitSoldiers | Heist
	-- | Checkpoint | Camp | Uplink | Delivery | Job (the last five: MissionConfig.OpsObjectives, live through OpsService)
	ObjectiveType: string,
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number?,
	MinLevel: number,
	Go: string?, -- a MissionConfig.Go key (GO button while incomplete)
}

export type GoDef = {
	Short: string, -- objective marker / compass label: 2-7 capitals, device-neutral ("BANK")
	-- server only: the WE_ActivityAnchor id to point at once it exists (lane BK stamps the bank's)
	Anchor: string?,
	-- a mission that uses this Go is offered only while the key is served (the job is on): the old resolver has a
	-- target, or OpsService's hook answers the key (a table, even an empty one while every site is busy: the offer
	-- never reshuffles when a site cools or the director rotates; GO shows once a site is Open again)
	Required: boolean?,
}

-- One GO target as sent to the client (world studs). MissionService adds Go / GoTargets to a mission entry.
export type GoTarget = { X: number, Y: number, Z: number }

export type MissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MinLevel: number,
	DurationSeconds: number,
	RewardCash: number,
	RewardXP: number,
	Difficulty: string,
}

local MissionConfig = {
	-- How many entries the daily list offers in total: the Daily Ops first, then the daily missions
	MaxActiveDaily = 6, -- includes Daily Ops when merged
	RefreshOnUtcDayChange = true,

	-- Which daily missions are offered each UTC day (MissionService; seeded by UserId + day, nothing saved)
	Rotation = {
		NewPlayerMaxLevel = 4, -- levels 1..4: Fixed + NewPlayerPicks rotating missions
		Fixed = { "DailyUpgrade", "DailyRecruit" }, -- first-5-minute missions for new players
		NewPlayerPicks = 1,
		Picks = 3, -- from NewPlayerMaxLevel + 1: this many rotate out of every unlocked daily mission
	},

	-- Objective types some server system reports through MissionService.TrackProgress today. A mission or daily op
	-- whose type is not listed here (or live through OpsObjectives) is never offered (it could not be finished).
	LiveObjectives = {
		KillNPC = true,
		KillPlayer = true,
		CaptureTerritory = true,
		PurchaseUpgrade = true,
		EarnCash = true,
		SpawnVehicle = true,
		RecruitSoldiers = true,
		Heist = true, -- BankRaidService: a bank job done (lane F)
	} :: { [string]: boolean },

	-- Objective types only OpsService reports (W3 step 2 Phase B). Live ONLY while its hook's ObjectiveLive(type) is
	-- true (a live job site reports it); never through LiveObjectives, so they stay off until the Ops cutover.
	OpsObjectives = {
		Checkpoint = true, -- a road checkpoint taken
		Camp = true, -- a raid camp cleared (its chest opened)
		Uplink = true, -- an uplink hacked and held
		Delivery = true, -- a cargo haul brought home (the heist yards and the black box; the bank counts as Heist)
		Job = true, -- any job finished
	} :: { [string]: boolean },

	-- GO targets. Where a Go key points is decided on the SERVER per player (MissionService) and sent with the
	-- mission; the client picks the one nearest to the player. OpsService's hook answers first (Phase B); a key it
	-- does not know falls back to the Anchor / BankRaidConfig resolver.
	Go = {
		Bank = {
			Short = "BANK",
			Anchor = "Town.Bank.Vault", -- until it exists: BankRaidConfig.Position
			Required = true, -- only while BankRaidConfig.Enabled (or, after the cutover, while the bank is an Ops site)
		},
		-- Phase B (lane M1): answered only by OpsService's hook (every Open site of these kinds)
		Checkpoint = { Short = "POST", Required = true },
		Camp = { Short = "CAMP", Required = true },
		Uplink = { Short = "UPLINK", Required = true },
		Job = { Short = "JOB", Required = true }, -- any Open job
		Cargo = { Short = "CARGO", Required = true }, -- the heist yards and the black box (Delivery)
		Hostiles = { Short = "HOSTILE" }, -- the nearest Open checkpoint or camp (KillNPC); no hook = no GO button
	} :: { [string]: GoDef },
	GoMaxTargets = 16, -- GO targets sent per entry: the nearest to the player (MissionController reads at most 16)
	GoRefreshSeconds = 30, -- while OpsService's hook is set: re-send a player's list when its targets change (0 = off)

	-- Missions panel row button (GO / CLAIM), in v (the panel's UI scale): 112 x 72 v is about 73 x 47 real px on a
	-- phone (spec w3s2 activities §9); the desktop button is DesktopButtonW wide and the desktop tap height tall.
	Ui = {
		ButtonW = 112,
		ButtonH = 72,
		DesktopButtonW = 96,
	},

	DailyMissions = {
		DailyKillNPC = {
			Id = "DailyKillNPC",
			DisplayName = "Clear Hostiles",
			Description = "Eliminate 10 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 80,
			RewardGold = 0,
			MinLevel = 1,
			Go = "Hostiles", -- GO once OpsService has an Open checkpoint or camp
		},
		DailyCapture = {
			Id = "DailyCapture",
			DisplayName = "Seize Ground",
			Description = "Capture 1 territory.",
			ObjectiveType = "CaptureTerritory",
			Target = 1,
			RewardCash = 4000,
			RewardXP = 120,
			RewardGold = 1,
			MinLevel = 1,
		},
		DailyUpgrade = {
			Id = "DailyUpgrade",
			DisplayName = "Fortify Base",
			Description = "Buy 1 base upgrade — reward $3,000 + 100 XP.",
			ObjectiveType = "PurchaseUpgrade",
			Target = 1, -- v37: completable in first ~5 min
			RewardCash = 3000,
			RewardXP = 100,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyEarnCash = {
			Id = "DailyEarnCash",
			DisplayName = "War Chest",
			Description = "Earn $8,000 Cash from any source.",
			ObjectiveType = "EarnCash",
			Target = 8000,
			RewardCash = 2000,
			RewardXP = 60,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailySpawnVehicle = {
			Id = "DailySpawnVehicle",
			DisplayName = "Mobilize",
			Description = "Spawn 1 vehicle from the garage — reward $1,500 + 40 XP.",
			ObjectiveType = "SpawnVehicle",
			Target = 1,
			RewardCash = 1500,
			RewardXP = 40,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyKillPlayer = {
			Id = "DailyKillPlayer",
			DisplayName = "Combat Ready",
			Description = "Eliminate 3 enemy players.",
			ObjectiveType = "KillPlayer",
			Target = 3,
			RewardCash = 5000,
			RewardXP = 150,
			RewardGold = 2,
			MinLevel = 5,
		},
		DailyRecruit = {
			Id = "DailyRecruit",
			DisplayName = "Muster Troops",
			Description = "Recruit 1 soldier — reward $2,000 + 50 XP + 1 Gold.",
			ObjectiveType = "RecruitSoldiers",
			Target = 1, -- v37: first-5-min friendly
			RewardCash = 2000,
			RewardXP = 50,
			RewardGold = 1,
			MinLevel = 1,
		},
	} :: { [string]: DailyMissionDef },

	-- Display order, and the order of the rotation pool (MissionService)
	DailyMissionOrder = {
		"DailyUpgrade", -- v37: first 5-min completable
		"DailyRecruit",
		"DailySpawnVehicle",
		"DailyKillNPC",
		"DailyCapture",
		"DailyEarnCash",
		"DailyKillPlayer",
	},

	-- Legacy timed missions (optional start → wait Duration → claim). v69: no client UI starts them,
	-- so the RequestStartMission remote is ignored unless this is true; each one pays once per UTC day.
	TimedMissionsRemoteEnabled = false,
	Missions = {
		PatrolOutskirts = {
			Id = "PatrolOutskirts",
			DisplayName = "Patrol the Outskirts",
			Description = "Secure the perimeter around your base.",
			MinLevel = 1,
			DurationSeconds = 60,
			RewardCash = 800,
			RewardXP = 50,
			Difficulty = "Easy",
		},
		SupplyRun = {
			Id = "SupplyRun",
			DisplayName = "Supply Run",
			Description = "Escort a convoy to the depot.",
			MinLevel = 3,
			DurationSeconds = 120,
			RewardCash = 2000,
			RewardXP = 120,
			Difficulty = "Normal",
		},
		RaidOutpost = {
			Id = "RaidOutpost",
			DisplayName = "Raid Enemy Outpost",
			Description = "Strike a hostile forward base.",
			MinLevel = 8,
			DurationSeconds = 180,
			RewardCash = 6000,
			RewardXP = 300,
			Difficulty = "Hard",
		},
	} :: { [string]: MissionDef },
}

return MissionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Live Robux product IDs (Creator Dashboard / Open Cloud). Id=0 = stub / hidden duplicate.
	Grants ONLY via server ProcessReceipt / GamePass ownership checks — never client confirmation.
	DevProducts AutoCollect/DoubleCash/VIPBoost are HideFromShop (GamePasses cover them).
	v69: OneTime = true marks a DevProduct whose grant is a boolean (buying it twice adds nothing). The Shop
	shows OWNED instead of prompting once the server reports it owned (player attribute WE_Ent_<key>, see
	ShopController). ProcessReceipt still grants any receipt Roblox delivers. HideFromShop on a GamePass keeps
	it out of the Shop list.
	v71 money (M0): HideFromShop also stops selling dead items (Gold packs: Gold has no use yet; Instant Barracks).
	Their Ids stay unchanged (never set a live Id to 0). A receipt for a product Id that is not listed here is NOT
	acknowledged (MonetizationService J2): paste new Ids with tools/wire-monetization-ids.py, publish, then run
	Migrate to Latest Update.
	v71 money (M1): receipt fields for the grant path (MonetizationService.ProcessReceipt, all applied before the
	receipt is marked and saved; see the field notes below):
	  GrantEntitlement = "Key"          one boolean entitlement (profile.Entitlements[Key])
	  GrantEntitlements = { "A", "B" }  a list of them (merged with GrantEntitlement, each granted once)
	  StarterFallbackCash = N           + N Cash when the buyer already owns Auto Collect (decided before any grant)
	  GrantNukes = N (etc.)             counter grants: only the fields whitelisted in CounterGrants below
	  Feature = "Name"                  the SKU belongs to a feature that is not live yet (M3: shown only when the
	                                    ReplicatedStorage attribute WE_Feature_<Name> is true and Id ~= 0). Until
	                                    M3 ships, every Feature SKU also carries HideFromShop = true.
	  SoldFrom = "Panel"                the SKU is sold from that panel only (HideFromShop keeps it out of the Shop
	                                    list; the Id wiring tool does not ask to remove HideFromShop for it).
	New SKUs stay Id = 0 until the owner creates them; game passes are created with Item for Sale OFF (J3).
	Owner's 11 features (lane K1, spec_f11 §2): GamePasses.ImpulseSpeed (5 R$ Speed Pass), DevProducts.RebirthKeepBase
	(50 R$ keep-base rebirth token, counter grant GrantKeepBaseRebirths), the GoldenPumpjack Shop row (lights up when
	the Id is pasted), DeathSpeedOffer (one death offer per session) and PremiumPads (the ATM pad slots). Every new Id
	stays 0 until the owner creates the product: nothing prompts, no pad is built and no Shop row shows while it is 0. ]]

-- F1: one PremiumPads slot (see MonetizationConfig.PremiumPads)
export type PremiumPadOffer = { Kind: "GamePass" | "DevProduct", Key: string }
export type PremiumPadSlot = {
	Id: string,
	Label: string,
	Color: Color3,
	Offset: Vector3,
	Offers: { PremiumPadOffer },
	OwnedIfAny: { string }?,
}

local MonetizationConfig = {
	GamePasses = {
		VIP = {
			Id = 1985475542,
			DisplayName = "VIP",
			RobuxPrice = 199,
			CashBonusMult = 0.25, -- additive +25% cash earnings
			Description = "+25% Cash earnings",
		},
		DoubleCash = {
			Id = 1982865711,
			DisplayName = "2x Cash",
			RobuxPrice = 149,
			CashMult = 2, -- multiplicative 2x cash earnings
			Description = "2x Cash earnings",
		},
		DoubleXP = {
			Id = 1982487698,
			DisplayName = "Double XP",
			RobuxPrice = 99,
			XPMult = 2,
			Description = "2x XP",
		},
		-- v69: HideFromShop — no code applies this theme yet, so it is not sold in the in-game Shop.
		-- Id kept unchanged (existing owners keep the pass); remove HideFromShop once the theme ships.
		ExtraPlotCosmetic = {
			Id = 1983357731,
			DisplayName = "Elite Base Theme",
			RobuxPrice = 79,
			Description = "Cosmetic base theme",
			HideFromShop = true,
		},
		AutoCollect = {
			Id = 1985115501,
			DisplayName = "Auto Collect",
			RobuxPrice = 99,
			Description = "Auto-claims Money Collector without touch",
		},
		-- F8 (owner's 11 features): 5 R$ Speed Pass, walk speed x WalkSpeedMult forever. Id = 0 until the owner creates
		-- the pass. The 99 R$ Speed Boost Developer Product (DevProducts.SpeedBoost) stays; owning both gives the higher
		-- multiplier (MonetizationService.SpeedMultFor). Keep this key name: BuyPathStatic matches the first Speed Boost
		-- product block by its key.
		ImpulseSpeed = {
			Id = 0,
			DisplayName = "Speed Pass",
			RobuxPrice = 5,
			WalkSpeedMult = 1.15,
			Description = "Run 15% faster, forever",
		},
		-- v71 money (M1): premium Robux vehicles (plan §2.2, PremiumVehicleConfig.Lineup PassKey). Id = 0 until the
		-- owner creates each pass (Item for Sale OFF until the M6 publish, J3). HideFromShop until M3's feature gate
		-- (WE_Feature_PremiumVehicles); the generic Shop pass loop must skip VehicleIds passes (M3/M6 Garage sells
		-- them). BundlePassKeys = other passes that also unlock the car; HideIfOwnsAny hides the bundle row.
		PV_Razorfang = {
			Id = 0,
			DisplayName = "Razorfang GT Interceptor",
			RobuxPrice = 199,
			VehicleIds = { "PremiumRazorfang" },
			BundlePassKeys = { "PV_MotorPool" },
			Feature = "PremiumVehicles",
			HideFromShop = true,
			Description = "Premium armored car with twin hood machine guns",
		},
		PV_Bastion = {
			Id = 0,
			DisplayName = "Bastion Gun Truck",
			RobuxPrice = 399,
			VehicleIds = { "PremiumBastion" },
			BundlePassKeys = { "PV_MotorPool" },
			Feature = "PremiumVehicles",
			HideFromShop = true,
			Description = "Premium gun truck that carries up to 9 soldiers", -- J22
		},
		PV_Warlord = {
			Id = 0,
			DisplayName = "Warlord Siege Tank",
			RobuxPrice = 799,
			VehicleIds = { "PremiumWarlord" },
			BundlePassKeys = { "PV_MotorPool" },
			Feature = "PremiumVehicles",
			HideFromShop = true,
			Description = "Premium heavy tank with a siege cannon",
		},
		PV_MotorPool = {
			Id = 0,
			DisplayName = "Premium Motor Pool",
			RobuxPrice = 1099,
			VehicleIds = { "PremiumRazorfang", "PremiumBastion", "PremiumWarlord" },
			HideIfOwnsAny = { "PV_Razorfang", "PV_Bastion", "PV_Warlord" }, -- J3: single-car owners buy the others alone
			Feature = "PremiumVehicles",
			HideFromShop = true,
			Description = "All 3 premium ground vehicles",
		},
		PV_Stormwing = { -- M6b (after helicopter flight is verified on a phone)
			Id = 0,
			DisplayName = "Stormwing Gunship",
			RobuxPrice = 999,
			VehicleIds = { "PremiumStormwing" },
			Feature = "PremiumVehicles",
			HideFromShop = true,
			Description = "Premium attack helicopter",
		},
		PV_Tidebreaker = { -- M6b (after waterways / boats)
			Id = 0,
			DisplayName = "Tidebreaker Assault Boat",
			RobuxPrice = 299,
			VehicleIds = { "PremiumTidebreaker" },
			Feature = "PremiumVehicles",
			HideFromShop = true,
			Description = "Premium assault boat",
		},
		-- v71 money (M1): Rebirth Boost (J13: +15% Cash per Rebirth instead of +10%, 1.5x starting Cash; no Gold x2).
		-- RebirthConfig.Boost.GamePassKey. Id = 0 until created (OFF sale until the M7b/M7d publish).
		RebirthBoost = {
			Id = 0,
			DisplayName = "Rebirth Boost",
			RobuxPrice = 199,
			Feature = "Rebirth",
			HideFromShop = true,
			Description = "+15% Cash per Rebirth and 1.5x starting Cash",
		},
	},
	DevProducts = {
		CashSmall = { Id = 3713838744, DisplayName = "Cash Pack S", RobuxPrice = 49, Cash = 10000, Gold = 0 },
		CashMedium = { Id = 3713838815, DisplayName = "Cash Pack M", RobuxPrice = 149, Cash = 50000, Gold = 0 },
		CashLarge = { Id = 3713838888, DisplayName = "Cash Pack L", RobuxPrice = 399, Cash = 200000, Gold = 0 },
		CashMega = { Id = 3713838952, DisplayName = "Cash Pack Mega", RobuxPrice = 799, Cash = 2000000, Gold = 0 },
		-- v71 money (M0): Gold has no sink yet (revenue audit F9), so the Gold packs are not sold. Ids kept.
		GoldSmall = { Id = 3713839003, DisplayName = "Gold Pack S", RobuxPrice = 49, Cash = 0, Gold = 50, HideFromShop = true },
		GoldMedium = { Id = 3713839048, DisplayName = "Gold Pack M", RobuxPrice = 149, Cash = 0, Gold = 200, HideFromShop = true },
		GoldLarge = { Id = 3713839090, DisplayName = "Gold Pack L", RobuxPrice = 349, Cash = 0, Gold = 500, HideFromShop = true },
		-- Placeholder Id=0: ProcessReceipt sets Battle Pass Premium when Id is live; Studio uses admin grantpremium
		PremiumPass = {
			Id = 3713839151,
			DisplayName = "Battle Pass Premium",
			RobuxPrice = 499,
			Cash = 0,
			Gold = 0,
			GrantsBattlePassPremium = true,
			OneTime = true, -- v69: Premium is a boolean kept across seasons; the Shop shows OWNED once granted
		},
		-- Monetization add-ons (Ids = 0 until Creator Dashboard)
		-- Covered by GamePass AutoCollect — keep stub for ProcessReceipt compat; hidden in shop
		AutoCollect = {
			Id = 0,
			DisplayName = "Auto Collect",
			RobuxPrice = 99,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "AutoCollect",
			HideFromShop = true,
			Description = "Auto-claims Money Collector without touch",
		},
		-- Covered by GamePass DoubleCash — hidden in shop
		DoubleCash = {
			Id = 0,
			DisplayName = "2x Money",
			RobuxPrice = 149,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "DoubleCash",
			HideFromShop = true,
			Description = "2x Cash earnings (permanent flag)",
		},
		-- v71 money (M1, owner decision D3): "Army Expansion (+10)", 99 R$, same Id. SoldierService adds ArmyCapBonus
		-- for Entitlements.ExtraSoldierSlot, so earlier +1 buyers get +10 too (retroactive). The key and the
		-- ExtraSoldierSlot entitlement name stay (receipts, saves and the Army panel use them).
		ExtraSoldierSlot = {
			Id = 3713839210,
			DisplayName = "Army Expansion (+10)",
			RobuxPrice = 99,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "ExtraSoldierSlot",
			ArmyCapBonus = 10,
			OneTime = true, -- v69: boolean entitlement; a second purchase would add nothing
			Description = "+10 army capacity, permanent",
		},
		-- v71 money (M0): not sold any more (Barracks L1 costs $2,500 of early cash; audit F13). Id kept for receipt compat.
		InstantBarracks = {
			Id = 3713839278,
			DisplayName = "Instant Barracks",
			RobuxPrice = 129,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "InstantBarracks",
			OneTime = true, -- v69: only raises Barracks to L1; OWNED once granted or Barracks is already L1+
			HideFromShop = true,
			Description = "Unlocks Barracks L1 instantly",
		},
		-- Covered by GamePass VIP — hidden in shop
		VIPBoost = {
			Id = 0,
			DisplayName = "VIP Boost",
			RobuxPrice = 199,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "VIP",
			HideFromShop = true,
			Description = "+25% Cash earnings (permanent flag)",
		},
		SpeedBoost = {
			Id = 3713839342,
			DisplayName = "Speed Boost",
			RobuxPrice = 99,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "SpeedBoost",
			OneTime = true, -- v69: permanent boolean flag
			WalkSpeedMult = 1.25, -- F8: was MonetizationService SPEED_BOOST_MULT; the Speed Pass is 1.15
			Description = "Permanent move-speed boost",
		},
		-- Cosmetic oil pump gold dress. v71 money (M0): one-time Developer Product (J29), 49 R$.
		-- F9 (owner's 11 features): lights up when the Id is pasted. While Id = 0 the Shop skips the row (it skips
		-- every Id 0 Developer Product) and no gold pad is built at the pumps; once the Id is live the Shop row and the
		-- pump pad appear with no other edit. ProcessReceipt + GrantEntitlement are ready.
		GoldenPumpjack = {
			Id = 0,
			DisplayName = "Golden Pumpjacks",
			RobuxPrice = 49,
			Cash = 0,
			Gold = 0,
			GrantEntitlement = "GoldenPumpjack",
			OneTime = true, -- boolean entitlement: a second purchase adds nothing; the Shop shows OWNED
			Description = "Gold-dress every oil pump on your base  pumps at Walls Lv 2",
		},
		-- v71 money (M1, owner decision D2): Commander Starter Pack v2, same Id, 149 R$, one time (J14: no timer until
		-- M3's real 72 h window). $50,000 + Auto Collect (permanent); a buyer who already owns Auto Collect gets
		-- StarterFallbackCash more instead. Old 249 R$ buyers get Auto Collect once (StarterGoodwill below).
		StarterBundle = {
			Id = 3713839505,
			DisplayName = "Commander Starter Pack",
			RobuxPrice = 149,
			Cash = 50000,
			Gold = 0,
			GrantEntitlement = "StarterBundle", -- OWNED key (WE_Ent_StarterBundle); also in GrantEntitlements
			GrantEntitlements = { "StarterBundle", "AutoCollect" },
			StarterFallbackCash = 25000,
			OneTime = true,
			Description = "$50,000 Cash + Auto Collect (permanent)",
		},
		-- v71 money (M1): the Nuke (nuke §2.2, plan §2.3). Consumables: no OneTime, no entitlement; GrantNukes adds to
		-- profile.Nukes (CounterGrants). Id = 0 until created; hidden until M3's feature gate (WE_Feature_Nuke, M5).
		Nuke = {
			Id = 0,
			DisplayName = "Nuke",
			RobuxPrice = 19,
			Cash = 0,
			Gold = 0,
			GrantNukes = 1,
			Feature = "Nuke",
			HideFromShop = true,
			Description = "1 Nuke: the biggest blast in the game, bonus XP",
		},
		NukeBundle3 = {
			Id = 0,
			DisplayName = "Nuke x3",
			RobuxPrice = 49,
			Cash = 0,
			Gold = 0,
			GrantNukes = 3,
			Feature = "Nuke",
			HideFromShop = true,
			Description = "3 Nukes (save 14%)",
		},
		-- F7 (owner's 11 features): 50 R$ keep-base rebirth. Consumable: each receipt adds one token to
		-- profile.KeepBaseRebirths (CounterGrants.GrantKeepBaseRebirths), granted only in ProcessReceipt and saved
		-- before PurchaseGranted. The rebirth itself runs after the save (PrestigeService OnGranted listener,
		-- PrestigeConfig.KeepBase); a token that cannot be used yet is banked and never expires. Sold only from the
		-- Rebirth panel (SoldFrom), never from the Shop list. Id = 0 until the owner creates it: the Rebirth panel
		-- shows SOON and never prompts. Paste the Id only after the double prestige multiplier (B1) is fixed.
		RebirthKeepBase = {
			Id = 0,
			DisplayName = "Keep-Base Rebirth",
			RobuxPrice = 50,
			Cash = 0,
			Gold = 0,
			GrantKeepBaseRebirths = 1,
			HideFromShop = true,
			SoldFrom = "RebirthPanel",
			Description = "Rebirth and keep every base upgrade",
		},
	},
	--[[ v71 money (M1): counter grants — the ONLY product fields ProcessReceipt adds to a profile number. Field is the
		profile key (a whole number >= 0), Stats (optional) a counter table + key bumped by the same amount,
		Attribute (optional) a display-only player attribute (never read back), Currency (optional) the Roblox
		AnalyticsService economy currency name, MaxPerReceipt a sanity cap on the config value. ]]
	CounterGrants = {
		GrantNukes = {
			Field = "Nukes",
			Stats = { Table = "NukeStats", Key = "Bought" },
			Attribute = "WE_Nukes",
			Currency = "Nukes",
			MaxPerReceipt = 100,
		},
		-- F7: keep-base rebirth tokens (DevProducts.RebirthKeepBase); WE_KeepBaseRebirths is display only
		GrantKeepBaseRebirths = {
			Field = "KeepBaseRebirths",
			Attribute = "WE_KeepBaseRebirths",
			MaxPerReceipt = 1,
		},
	},
	-- v71 money (M1, D2): one-time thank-you for players who bought the old 249 R$ Starter Bundle: Auto Collect on
	-- their next join. Entitlements[Flag] marks it done (set even when they already owned Auto Collect).
	StarterGoodwill = {
		Enabled = true,
		IfEntitlement = "StarterBundle",
		GrantEntitlement = "AutoCollect",
		Flag = "StarterGoodwillV2",
	},
	--[[ F1 (owner's 11 features): walk-over pads beside the ATM, in this order (MapSetup.buildPremiumPads reads it).
		At most 3 slots: CLAUDE.md allows at most 3 world labels on screen at a base (VIP is sold in the Shop only; the
		Golden Pump pad sits at the pumps, PlotOilPumpConfig.Golden). Per slot:
		  Offset      plot-local offset from the ATM cluster anchor (the pad turns with the plot)
		  Offers      the first offer whose Id is not 0 is the one the pad sells; a slot with no live offer is not built
		  OwnedIfAny  owning any of these keys (game pass, or the entitlement a Developer Product grants) shows OWNED
		              and never prompts; default = the offer's own key
		Pads are 7x7-stud floor triggers (no tap target); each label is stud-scaled, MaxDistance = LabelMaxDistance,
		never AlwaysOnTop, tagged WorldLabelConfig.BaseLabelTag. The server decides ownership and "coming soon". ]]
	PremiumPads = {
		LabelMaxDistance = 20,
		Slots = {
			{
				Id = "AutoCollect",
				Label = "Auto Collect",
				Color = Color3.fromRGB(220, 50, 50), -- red
				Offset = Vector3.new(-10, 0.55, 14),
				Offers = { { Kind = "GamePass", Key = "AutoCollect" } },
			},
			{
				Id = "DoubleCash",
				Label = "2x Cash",
				Color = Color3.fromRGB(255, 210, 40), -- yellow
				Offset = Vector3.new(0, 0.55, 16),
				Offers = { { Kind = "GamePass", Key = "DoubleCash" } },
			},
			{
				Id = "Speed",
				Label = "Speed",
				Color = Color3.fromRGB(60, 190, 255), -- cyan
				Offset = Vector3.new(10, 0.55, 14),
				-- the 5 R$ pass once its Id is live, else the 99 R$ Speed Boost product; owning either = OWNED
				Offers = { { Kind = "GamePass", Key = "ImpulseSpeed" }, { Kind = "DevProduct", Key = "SpeedBoost" } },
				OwnedIfAny = { "ImpulseSpeed", "SpeedBoost" },
			},
		} :: { PremiumPadSlot },
	},
	--[[ v71 money (M1): optional second argument of RequestPurchaseDevProduct / RequestPurchaseGamePass (where the
		prompt came from). Analytics only; anything not listed is logged as "other". A receipt within
		IntentAttributionSeconds of the intent for the same key inherits its source. ]]
	PurchaseSources = {
		shop = true,
		featured = true,
		hud_plus = true,
		rail_shop = true,
		armory = true,
		offer = true,
		starter_offer = true,
		death_card = true,
		pad = true,
		bp_panel = true,
		army_panel = true,
		army_full = true,
		garage = true,
		showroom = true,
		trial_end = true,
		nuke_tile = true,
		nuke_card = true,
		silo = true,
		rebirth_panel = true, -- F7: the Keep-Base Rebirth button in the Rebirth confirm modal
	} :: { [string]: boolean },
	IntentAttributionSeconds = 180,
	-- Loot-box style RNG marked policy-pending — do not enable without compliance review
	-- v30: PvP death toast — was { "DoubleCash", "SpeedBoost" } (live Ids).
	-- v71 money (M0): empty, so a PvP death no longer offers 2x Cash to players who already own it; the M3 Offer
	-- Director's death card replaces this toast. Keep the DeathShopOffers key (CombatService / ShopController read it).
	DeathShopOffers = {} :: { string },
	-- F8 (owner's 11 features): the ONE death offer that is allowed, kept apart from DeathShopOffers (which stays
	-- empty: no 2x Cash / Cash Mega offer after a death). MonetizationService.TryDeathSpeedOffer sends
	-- DeathShopOffer { Offers = { PassKey } } after a PvP non-blast death only when the pass Id is live, the player
	-- owns none of SkipIfOwnsAny, the tutorial is complete (RequireTutorialComplete), it is the first send this
	-- session (OncePerSession) and a soft-offer slot is free (SoftOfferSession* budget below).
	DeathSpeedOffer = {
		PassKey = "ImpulseSpeed",
		OncePerSession = true,
		SkipIfOwnsAny = { "ImpulseSpeed", "SpeedBoost" } :: { string },
		RequireTutorialComplete = true,
	},
	-- v32: one-shot soft offer (server marks StarterBundleOffered).
	-- v71 money (M1): never during the tutorial. TutorialService schedules it AfterTutorialSeconds after the tutorial
	-- completes (finished or skipped), or DelaySeconds after load when it is already done, and sends it through
	-- MonetizationService.TrySoftOfferStarterBundle (only while the pack is live, unoffered and unowned).
	StarterBundleOffer = {
		DelaySeconds = 8,
		AfterTutorialSeconds = 3,
	},
	-- v33: one-shot soft offer after first manual ATM collect (server marks AutoCollectOffered)
	AutoCollectOffer = {
		DelaySeconds = 1.2,
	},
	-- v34: one-shot DoubleCash soft offer after meaningful ATM collect (not spammy)
	DoubleCashOffer = {
		DelaySeconds = 1.8,
		MinCollectCash = 2500, -- only after a solid collect
	},
	-- v35: one-shot VIP soft offer at mid-game (level≥10 OR first structure L3); not spammy
	VIPOffer = {
		DelaySeconds = 2.0,
		MinLevel = 10,
		MinStructureLevel = 3,
	},
	-- v36: one-shot SpeedBoost soft offer after first jeep sit / walk-speed moment (existing Id only)
	SpeedBoostOffer = {
		DelaySeconds = 1.5,
		-- v71 money (M1): the spawn / first-vehicle-sit pop-ups raced the Starter offer; both triggers are ignored
		IgnoreReasons = { walk_speed = true, vehicle_sit = true } :: { [string]: boolean },
	},
	-- v37: one-shot CashMega soft toast after big pending collect OR death path (existing Id 3713838952 only)
	CashMegaOffer = {
		DelaySeconds = 1.8,
		MinPendingCollect = 15000, -- pending/granted threshold
		-- v71 money (M1): no 799 R$ pop-up on a PvP death (the M3 Director's death card replaces it)
		IgnoreReasons = { death = true } :: { [string]: boolean },
	},
	-- v38: one soft-offer toast max per session minute (shared across Starter/VIP/Speed/CashMega/AC/2x)
	-- v71 money (M1, owner decision D8): at most SoftOfferSessionMax per session, SoftOfferSessionCooldownSeconds
	-- apart, and none before the tutorial is complete (SoftOfferQuietMaxSeconds of play lifts that for players who
	-- never finish it). Same numbers as HudConfig.Offer, so the server no longer spends a one-shot offer the client
	-- would refuse.
	SoftOfferSessionCooldownSeconds = 240,
	SoftOfferSessionMax = 3,
	SoftOfferQuietUntilTutorialComplete = true,
	SoftOfferQuietMaxSeconds = 900,
	LootBoxPolicyPending = true,
	-- Reasons that skip VIP / 2x Cash multipliers (already granted amounts or admin)
	CashMultExemptReasons = {
		devproduct = true,
		admin = true,
		purchase_refund = true,
		prestige = true,
		battlepass = true,
		dismiss_soldiers = true,
		code = true,
		spinner = true,
		supply_drop = true,
		bank_raid = true,
		clan_war_win = true,
		clan_war_participate = true,
		collector = true, -- pending already multiplied at accrue time
		manual_dropper = true, -- fixed click awards stay $10–25
		atm_raid = true,
		plot_oil = true, -- plot pump PendingCash via AccruePendingCash
		ops = true, -- W3s2 Jobs: fixed job pay (OpsConfig.Rewards), never pass-multiplied
	},
	XPMultExemptReasons = {
		admin = true,
		battlepass = true,
		achievement = true,
	},
}

--[[ F1: the offer a PremiumPads slot sells right now: the first offer whose GamePasses / DevProducts entry exists with
	a non-zero Id, or nil when none is live (the pad is not built). Pure; the server and the client call it alike. ]]
function MonetizationConfig.LivePadOffer(slot: PremiumPadSlot): PremiumPadOffer?
	for _, offer in ipairs(slot.Offers) do
		local section: any = if offer.Kind == "GamePass"
			then MonetizationConfig.GamePasses
			elseif offer.Kind == "DevProduct" then MonetizationConfig.DevProducts
			else nil
		local def = section and section[offer.Key]
		if typeof(def) == "table" and typeof(def.Id) == "number" and def.Id ~= 0 then
			return offer
		end
	end
	return nil
end

-- F1: the keys whose ownership makes a slot's pad read OWNED (OwnedIfAny, else the live offer's own key).
function MonetizationConfig.PadOwnedKeys(slot: PremiumPadSlot): { string }
	if slot.OwnedIfAny ~= nil and #slot.OwnedIfAny > 0 then
		return slot.OwnedIfAny
	end
	local offer = MonetizationConfig.LivePadOffer(slot)
	return if offer then { offer.Key } else {}
end

return MonetizationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">NationColorConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Nation color roster — assigned on join / first spawn.
	Used to tint captured territory flags for that player.
]]

export type NationColorDef = {
	Id: string,
	DisplayName: string,
	Color: Color3,
}

local NationColorConfig = {
	Colors = {
		{ Id = "Crimson", DisplayName = "Crimson Legion", Color = Color3.fromRGB(200, 45, 55) },
		{ Id = "Azure", DisplayName = "Azure Fleet", Color = Color3.fromRGB(45, 110, 220) },
		{ Id = "Emerald", DisplayName = "Emerald Guard", Color = Color3.fromRGB(40, 170, 90) },
		{ Id = "Amber", DisplayName = "Amber Corps", Color = Color3.fromRGB(220, 160, 40) },
		{ Id = "Violet", DisplayName = "Violet Spear", Color = Color3.fromRGB(140, 70, 200) },
		{ Id = "Ivory", DisplayName = "Ivory Shield", Color = Color3.fromRGB(230, 225, 210) },
		{ Id = "Obsidian", DisplayName = "Obsidian Wing", Color = Color3.fromRGB(55, 55, 65) },
		{ Id = "Cyan", DisplayName = "Cyan Patrol", Color = Color3.fromRGB(40, 190, 200) },
	} :: { NationColorDef },
}

return NationColorConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">NationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NationConfig: the country a player chooses (cosmetic only: a flag on their own base, a code in the player list).
	Nations spec (fb2/spec_nations.md, lane A0). Pure data + pure helpers: no services, no Instances, never yields.

	Roster (200): the 193 UN members + Holy See (VA) + Palestine (PS) + Taiwan (TW) + Kosovo (XK) + England,
	Scotland and Wales (GB-ENG / GB-SCT / GB-WLS). Ids are ISO 3166-1 alpha-2 (the GB-* ids are ISO 3166-2).
	"No flag" is stored as the value NeutralId ("NEUTRAL"), never as nil (nil = never picked).
	Rules (CLAUDE.md): current national flags only. Never historical, regime, separatist, extremist or party flags,
	military insignia or dependent territories. tools/BuyPathStatic.py checks every Id against the allowlist
	(UN members + the 7 above + NEUTRAL) and the Denied list below.

	Flag art: lipis/flag-icons (MIT, pinned in tools/gen_nation_flags.py), rendered 4:3 into 7 atlases of 1024x512
	(assets/flags/atlas_<AtlasGroup>.png). Each nation has one cell (AtlasGroup, AtlasCell); Shared/Util/NationTexture
	turns a cell into the picker's ImageRect and the world Texture's StudsPerTile / OffsetStuds. Uploaded image ids live
	in NationFlagIds.luau (written by tools/wire-nation-flag-ids.py). Changing a nation's AtlasGroup / AtlasCell means
	re-running the generator and re-uploading that atlas.
	"Review" holds the flags with script or weapons in the official design (moderation false-positive risk), so a
	rejected Review upload never blanks a whole region.

	Color = banner colour (main flag colour): territory rings, contested pulse, capture HUD, and the flag part's colour
	while no art is uploaded.
]]

export type Region = "Europe" | "Americas" | "Asia" | "Africa" | "MiddleEast" | "Oceania"
export type AtlasGroup = Region | "Review"
export type NationDef = {
	Id: string,
	Name: string,
	Short: string, -- utf8.len <= 14 (picker tile, Settings row, "Flag raised: <Short>")
	Region: Region, -- picker tab
	Color: Color3,
	AtlasGroup: AtlasGroup, -- which atlas image holds the flag
	AtlasCell: number, -- 0-based cell in that atlas (row-major, Atlas.Columns per row)
	Aliases: { string }?, -- extra search words (Turkey, Ivory Coast ...)
	Cutout: boolean?, -- the flag is not a rectangle (Nepal): transparent pixels outside its shape
}

local NationConfig = {
	Enabled = true,
	NeutralId = "NEUTRAL",
	NeutralLabel = "No flag",

	-- Owner decisions: on by default. false hides the nation from the picker and makes Get return nil, so the
	-- ProfileSchema sanitiser clears it and those players get a free re-pick at their next join.
	OwnerReview = {
		TW = true,
		XK = true,
		PS = true,
		["GB-ENG"] = true,
		["GB-SCT"] = true,
		["GB-WLS"] = true,
	} :: { [string]: boolean },

	-- Changing nation (server-enforced, no cost)
	FreeRepickSeconds = 600, -- free window after the first real pick (starts only while NationFreeUntil == 0)
	FreeRepickMax = 5, -- at most this many changes inside the free window
	ChangeCooldownSeconds = 86400, -- then one change per 24 h
	MaxJoinPrompts = 3, -- LATER re-offers the picker at the next join, at most this many times
	RequestRate = 0.5, -- RateLimitService tokens / s for RequestSetNation
	RequestBurst = 3,

	-- Toggles
	SuggestPreselect = false, -- the IP-based suggestion is a badged tile only, never selected (privacy, spec R3)
	LiveRequiresArt = true, -- the picker opens by itself for non-admins only once every atlas id is wired
	OutpostFlags = false, -- outposts keep banner colour only at launch (policy caution around territory, spec R6)
	PlayerListColumn = true, -- leaderstats "Nation" column (added after Cash and Gold)
	PlayerListColumnName = "Nation",
	PlayerListEmoji = false, -- flip only after the emoji device test; the column shows Code(id) until then
	NeutralCode = "-", -- player-list text for "No flag"
	ContestMinColorDistance = 0.25, -- RGB distance (0..1.73) below which the contested pulse uses amber

	-- Picker
	Featured = { "US", "GB", "BR", "PH", "ID", "MX", "CA", "AU", "DE", "FR", "IE" }, -- "For you" tab after the suggestion
	RegionOrder = { "Europe", "Americas", "Asia", "Africa", "MiddleEast", "Oceania" } :: { Region },
	RegionLabel = {
		Europe = "Europe",
		Americas = "Americas",
		Asia = "Asia",
		Africa = "Africa",
		MiddleEast = "Mid East",
		Oceania = "Oceania",
	} :: { [string]: string },

	-- Atlas layout (tools/gen_nation_flags.py draws exactly this; NationTexture reads it). 9 x 6 cells of 112 x 84 px
	-- in a 1024 x 512 image. Each flag is 104 x 78 (4:3), centred in its cell with an edge-extended gutter of 4 px
	-- left/right and 3 px top/bottom (84 - 78 = 6), so filtering at the flag's edge never samples a neighbour.
	Atlas = {
		Groups = { "Europe", "Americas", "Asia", "Africa", "MiddleEast", "Oceania", "Review" } :: { AtlasGroup },
		Width = 1024,
		Height = 512,
		Columns = 9,
		Rows = 6,
		CellW = 112,
		CellH = 84,
		FlagW = 104,
		FlagH = 78,
		PerFlagW = 256, -- per-flag fallback PNGs (gen_nation_flags.py --per-flag): the whole image is the flag
		PerFlagH = 192,
		-- World Texture crop convention. Set by the 5-minute Studio atlas-crop test (spec section 3): if the flag shows
		-- the wrong cell, flip OffsetSignU / OffsetSignV to -1 and/or VFromBottom to true (see NationTexture.TextureProps).
		OffsetSignU = 1,
		OffsetSignV = 1,
		VFromBottom = false,
	},

	-- Never add these (historical / regime / war flags, military insignia, extremist or party flags, separatist or
	-- unrecognised entities, dependent territories). Get never returns them; BuyPathStatic fails the build if any appears.
	Denied = { "GB-NIR", "EH", "ES-CT", "ES-PV", "ARAB", "EU", "UN", "XX", "HK", "MO", "CEFTA" },

	Nations = {
		{ Id = "AD", Name = "Andorra", Short = "Andorra", Region = "Europe", Color = Color3.fromRGB(16, 16, 176), AtlasGroup = "Europe", AtlasCell = 0 },
		{ Id = "AE", Name = "United Arab Emirates", Short = "UAE", Region = "MiddleEast", Color = Color3.fromRGB(240, 16, 16), AtlasGroup = "MiddleEast", AtlasCell = 0, Aliases = { "Emirates" } },
		{ Id = "AF", Name = "Afghanistan", Short = "Afghanistan", Region = "Asia", Color = Color3.fromRGB(16, 144, 16), AtlasGroup = "Review", AtlasCell = 0 },
		{ Id = "AG", Name = "Antigua and Barbuda", Short = "Antigua", Region = "Americas", Color = Color3.fromRGB(208, 16, 48), AtlasGroup = "Americas", AtlasCell = 0 },
		{ Id = "AL", Name = "Albania", Short = "Albania", Region = "Europe", Color = Color3.fromRGB(240, 16, 16), AtlasGroup = "Europe", AtlasCell = 1 },
		{ Id = "AM", Name = "Armenia", Short = "Armenia", Region = "Asia", Color = Color3.fromRGB(16, 48, 176), AtlasGroup = "Asia", AtlasCell = 0 },
		{ Id = "AO", Name = "Angola", Short = "Angola", Region = "Africa", Color = Color3.fromRGB(240, 16, 16), AtlasGroup = "Review", AtlasCell = 1 },
		{ Id = "AR", Name = "Argentina", Short = "Argentina", Region = "Americas", Color = Color3.fromRGB(112, 176, 208), AtlasGroup = "Americas", AtlasCell = 1 },
		{ Id = "AT", Name = "Austria", Short = "Austria", Region = "Europe", Color = Color3.fromRGB(208, 16, 48), AtlasGroup = "Europe", AtlasCell = 2 },
		{ Id = "AU", Name = "Australia", Short = "Australia", Region = "Oceania", Color = Color3.fromRGB(16, 16, 144), AtlasGroup = "Oceania", AtlasCell = 0 },
		{ Id = "AZ", Name = "Azerbaijan", Short = "Azerbaijan", Region = "Asia", Color = Color3.fromRGB(16, 176, 240), AtlasGroup = "Asia", AtlasCell = 1 },
		{ Id = "BA", Name = "Bosnia and Herzegovina", Short = "Bosnia", Region = "Europe", Color = Color3.fromRGB(16, 16, 144), AtlasGroup = "Europe", AtlasCell = 3 },
		{ Id = "BB", Name = "Barbados", Short = "Barbados", Region = "Americas", Color = Color3.fromRGB(16, 48, 112), AtlasGroup = "Review", AtlasCell = 2 },
		{ Id = "BD", Name = "Bangladesh", Short = "Bangladesh", Region = "Asia", Color = Color3.fromRGB(16, 112, 80), AtlasGroup = "Asia", AtlasCell = 2 },
		{ Id = "BE", Name = "Belgium", Short = "Belgium", Region = "Europe", Color = Color3.fromRGB(240, 16, 48), AtlasGroup = "Europe", AtlasCell = 4 },
		{ Id = "BF", Name = "Burkina Faso", Short = "Burkina Faso", Region = "Africa", Color = Color3.fromRGB(208, 16, 16), AtlasGroup = "Africa", AtlasCell = 0 },
		{ Id = "BG", Name = "Bulgaria", Short = "Bulgaria", Region = "Europe", Color = Color3.fromRGB(16, 144, 112), AtlasGroup = "Europe", AtlasCell = 5 },
		{ Id = "BH", Name = "Bahrain", Short = "Bahrain", Region = "MiddleEast", Color = Color3.fromRGB(208, 16, 48), AtlasGroup = "MiddleEast", AtlasCell = 1 },
		{ Id = "BI", Name = "Burundi", Short = "Burundi", Region = "Africa", Color = Color3.fromRGB(208, 16, 48), AtlasGroup = "Africa", AtlasCell = 1 },
		{ Id = "BJ", Name = "Benin", Short = "Benin", Region = "Africa", Color = Color3.fromRGB(48, 144, 16), AtlasGroup = "Africa", AtlasCell = 2 },
		{ Id = "BN", Name = "Brunei", Short = "Brunei", Region = "Asia", Color = Color3.fromRGB(240, 240, 16), AtlasGroup = "Review", AtlasCell = 3 },
		{ Id = "BO", Name = "Bolivia", Short = "Bolivia", Region = "Americas", Color = Color3.fromRGB(208, 48, 16), AtlasGroup = "Americas", AtlasCell = 2 },
		{ Id = "BR", Name = "Brazil", Short = "Brazil", Region = "Americas", Color = Color3.fromRGB(48, 144, 80), AtlasGroup = "Americas", AtlasCell = 3 },
		{ Id = "BS", Name = "Bahamas", Short = "Bahamas", Region = "Americas", Color = Color3.fromRGB(16, 208, 208), AtlasGroup = "Americas", AtlasCell = 4 },
		{ Id = "BT", Name = "Bhutan", Short = "Bhutan", Region = "Asia", Color = Color3.fromRGB(240, 208, 48), AtlasGroup = "Asia", AtlasCell = 3 },
		{ Id = "BW", Name = "Botswana", Short = "Botswana", Region = "Africa", Color = Color3.fromRGB(16, 208, 240), AtlasGroup = "Africa", AtlasCell = 3 },
		{ Id = "BY", Name = "Belarus", Short = "Belarus", Region = "Europe", Color = Color3.fromRGB(208, 16, 48), AtlasGroup = "Europe", AtlasCell = 6 },
		{ Id = "BZ", Name = "Belize", Short = "Belize", Region = "Americas", Color = Color3.fromRGB(16, 48, 144), AtlasGroup = "Americas", AtlasCell = 5 },
		{ Id = "CA", Name = "Canada", Short = "Canada", Region = "Americas", Color = Color3.fromRGB(208, 48, 16), AtlasGroup = "Americas", AtlasCell = 6 },
		{ Id = "CD", Name = "DR Congo", Short = "DR Congo", Region = "Africa", Color = Color3.fromRGB(16, 112, 240), AtlasGroup = "Africa", AtlasCell = 4, Aliases = { "Congo", "DRC" } },
		{ Id = "CF", Name = "Central African Republic", Short = "C. African Rep", Region = "Africa", Color = Color3.fromRGB(240, 240, 16), AtlasGroup = "Africa", AtlasCell = 5 },
		{ Id = "CG", Name = "Congo", Short = "Congo", Region = "Africa", Color = Color3.fromRGB(240, 240, 16), AtlasGroup = "Africa", AtlasCell = 6 },
		{ Id = "CH", Name = "Switzerland", Short = "Switzerland", Region = "Europe", Color = Color3.fromRGB(240, 16, 16), AtlasGroup = "Europe", AtlasCell = 7 },
		{ Id = "CI", Name = "Côte d'Ivoire", Short = "Côte d'Ivoire", Region = "Africa", Color = Color3.fromRGB(16, 208, 16), AtlasGroup = "Africa", AtlasCell = 7, Aliases = { "Ivory Coast" } },
		{ Id = "CL", Name = "Chile", Short = "Chile", Region = "Americas", Color = Color3.fromRGB(208, 48, 16), AtlasGroup = "Americas", AtlasCell = 7 },
		{ Id = "CM", Name = "Cameroon", Short = "Cameroon", Region = "Africa", Color = Color3.fromRGB(240, 208, 16), AtlasGroup = "Africa", AtlasCell = 8 },
		{ Id = "CN", Name = "China", Short = "China", Region = "Asia", Color = Color3.fromRGB(240, 16, 48), AtlasGroup = "Asia", AtlasCell = 4 },
		{ Id = "CO", Name = "Colombia", Short = "Colombia", Region = "Americas", Color = Color3.fromRGB(240, 240, 16), AtlasGroup = "Americas", AtlasCell = 8 },
		{ Id = "CR", Name = "Costa Rica", Short = "Costa Rica", Region = "Americas", Color = Color3.fromRGB(16, 16, 176), AtlasGroup = "Americas", AtlasCell = 9 },
		{ Id = "CU", Name = "Cuba", Short = "Cuba", Region = "Americas", Color = Color3.fromRGB(16, 48, 144), AtlasGroup = "Americas", AtlasCell = 10 },
		{ Id = "CV", Name = "Cape Verde", Short = "Cape Verde", Region = "Africa", Color = Color3.fromRGB(16, 16, 112), AtlasGroup = "Africa", AtlasCell = 9, Aliases = { "Cabo Verde" } },
		{ Id = "CY", Name = "Cyprus", Short = "Cyprus", Region = "Europe", Color = Color3.fromRGB(208, 112, 16), AtlasGroup = "Europe", AtlasCell = 8 },
		{ Id = "CZ", Name = "Czechia", Short = "Czechia", Region = "Europe", Color = Color3.fromRGB(208, 16, 16), AtlasGroup = "Europe", AtlasCell = 9, Aliases = { "Czech Republic" } },
		{ Id = "DE", Name = "Germany", Short = "Germany", Region = "Europe", Color = Color3.fromRGB(240, 16, 16), AtlasGroup = "Europe", AtlasCell = 10 },
		{ Id = "DJ", Name = "Djibouti", Short = "Djibouti", Region = "Africa", Color = Color3.fromRGB(16, 208, 16), AtlasGroup = "Africa", AtlasCell = 10 },
		{ Id = "DK", Name = "Denmark", Short = "Denmark", Region = "Europe", Color = Color3.fromRGB(208, 16, 48), AtlasGroup = "Europe", AtlasCell = 11 },
		{ Id = "DM", Name = "Dominica", Short = "Dominica", Region = "Americas", Color = Color3.fromRGB(16, 144, 16), AtlasGroup = "Americas", AtlasCell = 11 },
		{ Id = "DO", Name = "Dominican Republic", Short = "Dominican Rep", Region = "Americas", Color = Color3.fromRGB(16, 48, 112), AtlasGroup = "Americas", AtlasCell = 12 },
		{ Id = "DZ", Name = "Algeria", Short = "Algeria", Region = "Africa", Color = Color3.fromRGB(16, 112, 48), AtlasGroup = "Africa", AtlasCell = 11 },
		{ Id = "EC", Name = "Ecuador", Short = "Ecuador", Region = "Americas", Color = Color3.fromRGB(240, 240, 16), AtlasGroup = "Americas", AtlasCell = 13 },
