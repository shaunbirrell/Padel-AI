        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">SpinnerConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Free Supply Spinner — claim Cash/Gold every N hours (Settings / HUD).
	Fixed reward table (server picks index); not a paid loot box.
]]

local SpinnerConfig = {
	Enabled = true,
	CooldownSeconds = 4 * 3600, -- 4 hours
	DisplayName = "Supply Spinner",
	-- Weighted outcomes: Weight relative; server rolls once
	Rewards = {
		{ Id = "cash_small", DisplayName = "Cash Cache", Weight = 40, Cash = 5000, Gold = 0 },
		{ Id = "cash_med", DisplayName = "Cash Haul", Weight = 25, Cash = 12000, Gold = 0 },
		{ Id = "cash_big", DisplayName = "Cash Jackpot", Weight = 10, Cash = 25000, Gold = 0 },
		{ Id = "gold_small", DisplayName = "Gold Dust", Weight = 15, Cash = 2000, Gold = 2 },
		{ Id = "gold_med", DisplayName = "Gold Bar", Weight = 8, Cash = 5000, Gold = 5 },
		{ Id = "mixed", DisplayName = "Mixed Supply", Weight = 2, Cash = 15000, Gold = 8 },
	},
}

return SpinnerConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">StructureVisualConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Part-kit silhouettes + palettes for base structures (placeholders, no MeshIds).
	Visual kits v2: richer MapSetup kits + clearer plinths / less ghost washout.
	StudioSetup mirrors these colors; BaseService.UpdateVisuals scales detail by level.
]]

export type StructurePalette = {
	Plinth: Color3,
	Body: Color3,
	Accent: Color3,
	Roof: Color3,
	Kit: "hq" | "barracks" | "depot" | "lab" | "tower" | "pad" | "dock" | "wall" | "power" | "warehouse" | "special",
	-- Future Creator Store MeshPart (0 / nil = Part kit)
	MeshAssetId: number?,
}

local StructureVisualConfig = {
	-- Level 0 = ghost/placeholder; ≥1 solid + taller body
	GhostTransparency = 0.32,
	SolidTransparency = 0,
	-- When true and palette.MeshAssetId ~= 0, BaseService may swap kit for MeshPart (art pass).
	PreferMeshWhenAssetIdSet = true,

	Palettes = {
		CommandCenter = {
			Plinth = Color3.fromRGB(36, 48, 40),
			Body = Color3.fromRGB(55, 78, 58),
			Accent = Color3.fromRGB(230, 190, 60),
