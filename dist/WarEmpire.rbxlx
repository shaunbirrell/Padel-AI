        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">SeasonConfig</string>
            <string name="Source"><![CDATA[--!strict

local SeasonConfig = {
	CurrentSeasonId = "S1_Foundation",
	DisplayName = "Season 1: Foundation",
	StartUnix = 0,
	EndUnix = 0,
	BattlePassLevels = 50,
	XPPerBattlePassLevel = 1000,
	XPBonusMult = 1.1,
	CashBonusMult = 1.05,
	Ended = false,
}

return SeasonConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
