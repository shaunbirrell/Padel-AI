        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">CodesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot v102: redeem codes (server only — ServerScriptService, so a client can never read the list).

	HOW TO ADD A CODE (owner):
	  1. Copy the BUDSTUDIOS block below, give it a new key (the code players type). Keys are case-insensitive and
	     spaces are ignored: "budstudios", "BudStudios" and " BUD STUDIOS " all match BUDSTUDIOS. Letters, digits
	     and _ only, at most MaxCodeLength characters.
	  2. Rewards (any mix; leave out what you don't want):
	       Cash = 50000               Cash, paid exactly (never multiplied by VIP / 2x Cash / rebirth)
	       Gold = 5                   Gold
	       XP = 500                   XP (claude-bud JOB 24 §9)
	       CashBoostMinutes = 30      a timed 2x Cash boost (real minutes from the redeem; redeeming another boost
	                                  code while one runs adds the minutes on top)
	  3. Active = true to switch it on, false to switch it off (players then see "This code has expired").
	  4. Expires = "2026-12-31" (the code stops at the END of that day, UTC) or "2026-12-31T18:00:00Z"
	     (an exact UTC time), or nil for no expiry.
	  5. Build + publish. Each player can redeem each code once; it is saved in their profile (RedeemedCodes).
]]

export type CodeRewards = {
	Cash: number?,
	Gold: number?,
	XP: number?, -- claude-bud JOB 24 §9
	CashBoostMinutes: number?,
}

export type CodeDef = {
	Active: boolean,
	Expires: string?,
	DisplayName: string?,
	Rewards: CodeRewards,
}

local CodesConfig = {
	MaxCodeLength = 32,
	-- the timed boost from CashBoostMinutes multiplies Cash earnings by this (stacks with the passes like any
	-- other multiplier; EconomyService applies it through CodesService.GetCashBoostMult)
	CashBoostMult = 2,
	-- the longest a stacked boost can run from now (minutes), so repeated codes cannot bank days of 2x
	CashBoostMaxMinutes = 24 * 60,
	-- RedeemCode RemoteFunction rate limit: at most this many tries per player per minute
	TriesPerMinute = 5,

	Codes = {
		-- launch code (Code Bot v102)
		BUDSTUDIOS = {
			Active = true,
			Expires = nil,
			DisplayName = "Bud Studios",
			Rewards = { Cash = 50000, CashBoostMinutes = 30 },
		},
		BUDSQUAD = {
			Active = true,
			Expires = nil,
			DisplayName = "Bud Studios Discord",
			Rewards = { Cash = 25000 },
		},
		-- claude-bud JOB 24 §9: launch codes for the Discord (one per player, server-validated like the rest)
		WAREMPIRE = {
			Active = true,
			Expires = nil, -- e.g. "2026-12-31" to end it
			DisplayName = "War Empire launch",
			Rewards = { Cash = 30000, CashBoostMinutes = 15 },
		},
		ATTACK = {
			Active = true,
			Expires = nil,
			DisplayName = "Attack!",
			Rewards = { Cash = 10000, XP = 500 },
		},
		-- pre-launch sample codes, retired for launch (flip Active = true to bring one back)
		WARFOUNDING = {
			Active = false,
			Expires = nil,
			DisplayName = "War Founding",
			Rewards = { Cash = 15000, Gold = 5 },
		},
		BUILDCONQUER = {
			Active = false,
			Expires = nil,
			DisplayName = "Build & Conquer",
			Rewards = { Cash = 8000, Gold = 2 },
		},
	} :: { [string]: CodeDef },
}

return CodesConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="138">
        <Properties>
          <string name="Name">EarlyRemotes</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	v60: Run BEFORE Bootstrap finishes requiring services.
	1) Create ALL remotes under WE_Remotes (server-only — no Rojo empty folder).
	2) Seed leaderstats + WE_Cash IMMEDIATELY on PlayerAdded (before DataStore).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Destroy legacy empty Rojo Remotes folder so clients never WaitForChild on it
do
	local legacy = ReplicatedStorage:FindFirstChild("Remotes")
	if legacy and legacy:IsA("Folder") and #legacy:GetChildren() == 0 then
		legacy:Destroy()
	end
end

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"))
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local AdminConfig = require(Shared.Configs.AdminConfig)

local Modules = script.Parent:WaitForChild("Modules")
local RemoteSetup = require(Modules:WaitForChild("RemoteSetup"))
RemoteSetup.Init()

local ADMIN_PLAYTEST_USER_ID = 470626172

local function seedCashAmount(userId: number): number
	local startCash = math.floor(tonumber(EconomyConfig.StartingCash) or 10000)
	if userId == ADMIN_PLAYTEST_USER_ID then
		local floor = math.floor(tonumber(AdminConfig.AdminPlaytestCash) or 50_000_000)
		return math.max(startCash, floor)
	end
	return startCash
end

local function ensureLeaderstats(player: Player, cash: number, gold: number)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end
	local cashVal = folder:FindFirstChild("Cash")
	if not cashVal then
		cashVal = Instance.new("IntValue")
		cashVal.Name = "Cash"
		cashVal.Parent = folder
	end
	if cashVal:IsA("IntValue") or cashVal:IsA("NumberValue") then
		(cashVal :: any).Value = cash
	end
	local goldVal = folder:FindFirstChild("Gold")
	if not goldVal then
		goldVal = Instance.new("IntValue")
		goldVal.Name = "Gold"
		goldVal.Parent = folder
	end
	if goldVal:IsA("IntValue") or goldVal:IsA("NumberValue") then
		(goldVal :: any).Value = gold
	end
end

local function seedPlayer(player: Player)
	local cash = seedCashAmount(player.UserId)
	local gold = math.floor(tonumber(EconomyConfig.StartingGold) or 0)
	pcall(function()
		player:SetAttribute("WE_Build", 199)
		player:SetAttribute("WE_Cash", cash)
		player:SetAttribute("WE_Gold", gold)
		player:SetAttribute("WE_PendingCash", 0)
	end)
	pcall(ensureLeaderstats, player, cash, gold)
	-- Fire EconomyUpdate if client already listening
	pcall(function()
		local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
		local ev = folder and folder:FindFirstChild(Constants.RemoteNames.EconomyUpdate)
		if ev and ev:IsA("RemoteEvent") then
			(ev :: RemoteEvent):FireClient(player, {
				Cash = cash,
				Gold = gold,
				PendingCash = 0,
			})
		end
	end)
end

Players.PlayerAdded:Connect(seedPlayer)
for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(seedPlayer, plr)
end

print("[WAR EMPIRE] EarlyRemotes v63: WE_Remotes + leaderstats seed ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="139">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">ActivityAnchors</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE W3 step 2 — ActivityAnchors: the one reader (and the one writer) of the activity anchors
	(spec scratchpad w3s2 §1.5–§1.6 / §5; contract scratchpad w3s2/build/L0/contract.md; config WorldConfig.Activity).

	An activity anchor is an invisible Attachment (0 parts) on a static anchored host part, tagged "WE_ActivityAnchor"
	(= WorldConfig.Activity.Tag) and carrying the WorldConfig.Activity.Attr attributes. Ids are "<POI>.<Site>.<Role>"
	(each segment letters, digits or "_"; POI = a WorldConfig.POIs Id); the site id is "<POI>.<Site>". The geometry
	stamps them (WorldPOI: POI layout rows on the POI's ActivityHost part, Activity.CheckpointAnchors on every
	CheckpointBooth, Town rows on a part of the cluster they Require; MapSetup: Town.BankAnchors on BankPlaza); the jobs
	read them (OpsService, BankRaidService).

	SERVER ONLY (it lives in ServerScriptService). Never yields, never waits on the tree, no cache: each List / Get walks the
	tag list once (a few hundred anchors), so callers read at site init and keep the records — never per frame.
	Anchors outside Workspace (e.g. a template kept in ServerStorage) and anchors whose host is not a BasePart are
	ignored. Positions come from host.CFrame * attachment.CFrame (the same as Attachment.WorldCFrame on live).

	PUBLIC API (frozen by lane L0; later changes are additive only):
	  ActivityAnchors.List(site?, kind?) -> { Anchor }
	      every live anchor, sorted by Id. site = "<POI>.<Site>" (one job place) or "<POI>" (the whole place);
	      kind = one of WorldConfig.Activity.Kinds. Duplicated ids warn once; the first by instance path wins.
	  ActivityAnchors.Get(id) -> Anchor?
	      one anchor by its full id, or nil.
	  ActivityAnchors.Parse(id) -> (poi?, site?, role?)
	      splits and checks an id: poi "Port", site "Port.Customs", role "Gate"; nil, nil, nil when malformed.
	  ActivityAnchors.Stamp(host, def) -> Attachment?
	      the one writer: validates def (id, kind, prompt, finite position), replaces any anchor with the same id under
	      host, creates the Attachment at def.Position turned by def.Yaw, sets the attributes and the tag. nil + a
	      warning when def is invalid (an unknown role only warns). host must never move or be replaced by a mesh
	      overlay (ActivityHost, CheckpointBooth, a MarketStall part, BankPlaza).
	  ActivityAnchors.FromRow(row) -> StampDef
	      a WorldConfig.ActivityAnchor row (world X / Z, Y above the floor) as a StampDef.
	  ActivityAnchors.FromTemplate(t, poi, siteSegment, kitFrame) -> StampDef
	      a WorldConfig.AnchorTemplate row (kit-local) placed by the kit's world frame (yaw-only CFrame at the kit's
	      pivot): id "<poi>.<siteSegment>.<t.Role>", yaw = kit yaw + t.Yaw.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local WorldConfig = require(ReplicatedStorage.Shared.Configs.WorldConfig)

local A = WorldConfig.Activity
local ATTR = A.Attr
-- BuyPathStatic pins the literal GetTagged("WE_ActivityAnchor") call below; the config value must agree with it
local TAG = "WE_ActivityAnchor"
if A.Tag ~= TAG then
	warn(string.format("[ActivityAnchors] WorldConfig.Activity.Tag is %q but this reader uses %q", tostring(A.Tag), TAG))
end

export type Anchor = {
	Id: string,
	POI: string,
	Site: string, -- "<POI>.<Site>"
	Role: string,
	Kind: string,
	Position: Vector3, -- world, on the standing surface (add your own lift for a prompt or a label)
	Yaw: number, -- degrees, 0 = faces north (-Z)
	CFrame: CFrame, -- Position turned by Yaw
	R: number?,
	Prompt: string?,
	Part: string?,
	BoxW: number?,
	BoxL: number?,
	Probe: boolean,
	Attachment: Attachment,
}

export type StampDef = {
	Id: string,
	Kind: string,
	Position: Vector3, -- world
	Yaw: number?, -- degrees, default 0
	R: number?,
	Prompt: string?,
	Part: string?,
	Box: { number }?, -- { width, length }
	Probe: boolean?,
}

local ActivityAnchors = {}

local function toSet(list: { string }): { [string]: boolean }
	local s: { [string]: boolean } = {}
	for _, v in ipairs(list) do
		s[v] = true
	end
	return s
end

local KINDS = toSet(A.Kinds)
local PROMPTS = toSet(A.Prompts)
local ROLES = toSet(A.Roles)
local POI_IDS: { [string]: boolean } = {}
for _, p in ipairs(WorldConfig.POIs) do
	POI_IDS[p.Id] = true
end

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, msg: string)
	if not warned[key] then
		warned[key] = true
		warn("[ActivityAnchors] " .. msg)
	end
end

local function finite(n: number): boolean
	return n == n and n > -1e7 and n < 1e7
end

function ActivityAnchors.Parse(id: string): (string?, string?, string?)
	if type(id) ~= "string" then
		return nil, nil, nil
	end
	local poi, site, role = string.match(id, "^([%w_]+)%.([%w_]+)%.([%w_]+)$")
	if poi == nil or site == nil or role == nil or not POI_IDS[poi] then
		return nil, nil, nil
	end
	return poi, poi .. "." .. site, role
end

local function knownRole(role: string): boolean
	if ROLES[role] then
		return true
	end
	for _, stem in ipairs(A.NumberedRoles) do
		if string.match(role, "^" .. stem .. "%d+$") then
			return true
		end
	end
	return false
end

function ActivityAnchors.FromRow(row: WorldConfig.ActivityAnchor): StampDef
	return {
		Id = row.Id,
		Kind = row.Kind,
		Position = Vector3.new(row.X, A.FloorY + (row.Y or 0), row.Z),
		Yaw = row.Yaw or 0,
		R = row.R,
		Prompt = row.Prompt,
		Part = row.Part,
		Box = row.Box,
		Probe = row.Probe,
	}
end

function ActivityAnchors.FromTemplate(t: WorldConfig.AnchorTemplate, poi: string, siteSegment: string, kitFrame: CFrame): StampDef
	local p = (kitFrame * CFrame.new(t.X, 0, t.Z)).Position
	local look = kitFrame.LookVector
	local kitYaw = math.deg(math.atan2(-look.X, -look.Z))
	return {
		Id = poi .. "." .. siteSegment .. "." .. t.Role,
		Kind = t.Kind,
		Position = Vector3.new(p.X, A.FloorY + (t.Y or 0), p.Z),
		Yaw = kitYaw + (t.Yaw or 0),
		R = t.R,
		Prompt = t.Prompt,
		Part = t.Part,
		Box = nil,
		Probe = t.Probe,
	}
end

function ActivityAnchors.Stamp(host: BasePart, def: StampDef): Attachment?
	local poi, site, role = ActivityAnchors.Parse(def.Id)
	if poi == nil or site == nil or role == nil then
		warn(string.format("[ActivityAnchors] Stamp: bad id %q (want <POI>.<Site>.<Role>, POI from WorldConfig.POIs)", tostring(def.Id)))
		return nil
	end
	if typeof(host) ~= "Instance" or not host:IsA("BasePart") then
		warn(string.format("[ActivityAnchors] Stamp %s: the host is not a BasePart", def.Id))
		return nil
	end
	if not KINDS[def.Kind] then
		warn(string.format("[ActivityAnchors] Stamp %s: unknown kind %q", def.Id, tostring(def.Kind)))
		return nil
	end
	if def.Prompt ~= nil and not PROMPTS[def.Prompt] then
		warn(string.format("[ActivityAnchors] Stamp %s: unknown prompt %q", def.Id, tostring(def.Prompt)))
		return nil
	end
	local pos = def.Position
	if typeof(pos) ~= "Vector3" or not (finite(pos.X) and finite(pos.Y) and finite(pos.Z)) then
		warn(string.format("[ActivityAnchors] Stamp %s: bad position", def.Id))
		return nil
	end
	local yaw = def.Yaw or 0
	if not finite(yaw) then
		yaw = 0
	end
	if not knownRole(role) then
		warnOnce("role:" .. role, string.format("Stamp %s: role %q is outside WorldConfig.Activity.Roles (stamped anyway)", def.Id, role))
	end

	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("Attachment") and ch.Name == def.Id then
			ch:Destroy()
		end
	end
	local att = Instance.new("Attachment")
	att.Name = def.Id
	att.CFrame = host.CFrame:ToObjectSpace(CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw), 0))
	att:SetAttribute(ATTR.Id, def.Id)
	att:SetAttribute(ATTR.Site, site)
	att:SetAttribute(ATTR.POI, poi)
	att:SetAttribute(ATTR.Role, role)
	att:SetAttribute(ATTR.Kind, def.Kind)
	att:SetAttribute(ATTR.Yaw, yaw)
	if def.R ~= nil then
		att:SetAttribute(ATTR.R, def.R)
	end
	if def.Prompt ~= nil then
		att:SetAttribute(ATTR.Prompt, def.Prompt)
	end
	if def.Part ~= nil then
		att:SetAttribute(ATTR.Part, def.Part)
	end
	local box = def.Box
	if box ~= nil and #box >= 2 then
		att:SetAttribute(ATTR.BoxW, box[1])
		att:SetAttribute(ATTR.BoxL, box[2])
	end
	if def.Probe == true then
		att:SetAttribute(ATTR.Probe, true)
	end
	att.Parent = host
	CollectionService:AddTag(att, TAG)
	return att
end

local function num(inst: Instance, name: string): number?
	local v = inst:GetAttribute(name)
	return if type(v) == "number" then v else nil
end

local function str(inst: Instance, name: string): string?
	local v = inst:GetAttribute(name)
	return if type(v) == "string" then v else nil
end

-- one tagged instance as a record (nil when it is not a live, well-formed anchor)
local function record(inst: Instance): Anchor?
	if not inst:IsA("Attachment") or not inst:IsDescendantOf(Workspace) then
		return nil
	end
	local host = inst.Parent
	if host == nil or not host:IsA("BasePart") then
		warnOnce("host:" .. inst:GetFullName(), inst:GetFullName() .. ": an anchor must sit on a BasePart (ignored)")
		return nil
	end
	local id = str(inst, ATTR.Id)
	local kind = str(inst, ATTR.Kind)
	local poi, site, role
	if id ~= nil then
		poi, site, role = ActivityAnchors.Parse(id)
	end
	if id == nil or kind == nil or poi == nil or site == nil or role == nil then
		warnOnce("bad:" .. inst:GetFullName(), inst:GetFullName() .. ": malformed anchor (id / kind attributes; ignored)")
		return nil
	end
	local yaw = num(inst, ATTR.Yaw) or 0
	local wcf = (host :: BasePart).CFrame * (inst :: Attachment).CFrame
	local p = wcf.Position
	return {
		Id = id,
		POI = poi,
		Site = site,
		Role = role,
		Kind = kind,
		Position = p,
		Yaw = yaw,
		CFrame = CFrame.new(p) * CFrame.Angles(0, math.rad(yaw), 0),
		R = num(inst, ATTR.R),
		Prompt = str(inst, ATTR.Prompt),
		Part = str(inst, ATTR.Part),
		BoxW = num(inst, ATTR.BoxW),
		BoxL = num(inst, ATTR.BoxL),
		Probe = inst:GetAttribute(ATTR.Probe) == true,
		Attachment = inst :: Attachment,
	}
end

-- every live anchor, deduplicated by id (first by instance path), sorted by id
local function all(): { Anchor }
	local tagged = CollectionService:GetTagged("WE_ActivityAnchor")
	local recs: { Anchor } = {}
	for _, inst in ipairs(tagged) do
		local r = record(inst)
		if r ~= nil then
			table.insert(recs, r)
		end
	end
	table.sort(recs, function(a: Anchor, b: Anchor): boolean
		if a.Id ~= b.Id then
			return a.Id < b.Id
		end
		return a.Attachment:GetFullName() < b.Attachment:GetFullName()
	end)
	local out: { Anchor } = {}
	local last: string? = nil
	for _, r in ipairs(recs) do
		if r.Id == last then
			warnOnce("dup:" .. r.Id, "duplicate anchor id " .. r.Id .. " (the first by instance path is used)")
		else
			table.insert(out, r)
			last = r.Id
		end
	end
	return out
end

function ActivityAnchors.List(site: string?, kind: string?): { Anchor }
	local byPOI = site ~= nil and string.find(site, ".", 1, true) == nil
	local out: { Anchor } = {}
	for _, r in ipairs(all()) do
		local siteOk = site == nil or (if byPOI then r.POI == site else r.Site == site)
		if siteOk and (kind == nil or r.Kind == kind) then
			table.insert(out, r)
		end
	end
	return out
end

function ActivityAnchors.Get(id: string): Anchor?
	for _, r in ipairs(all()) do
		if r.Id == id then
			return r
		end
	end
	return nil
end

return ActivityAnchors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">AirBodyRig</string>
            <string name="Source"><![CDATA[--!strict
--[[ air-looks (2026-09-28): the extras a store AIRCRAFT body needs on top of the vscale fit (VisualAssetService
	fitBodyToKit / placeKitOnBody). Every one of them is read from the vehicle's VisualAssetConfig ref and does nothing
	when the ref leaves it out, so kit-only aircraft and every car / boat body are unchanged.

	  • AnchorShift (ref.BodyAnchor = a BodySeats name): a Roblox-size aircraft is far longer than its kit, and its
	    cockpit sits well ahead of the body's box centre, past the kit's collidable box, where placeKitOnBody would clamp
	    the pilot seat back into the fuselage. Instead the whole BODY moves along the kit's length (chassis Z; it stays
	    centred across) so that seat's body point lands level with the kit seat of the same name: the pilot sits in the
	    cockpit, the kit (physics, collisions, the drive movers, the HUD) stays exactly where it was. Other BodySeats move
	    with the body (placeKitOnBody still keeps every seat inside the kit's box).
	  • KitFloor (ref.BodyFloor = "Collide"): an aircraft has no physics wheels, so the fit would put the body's lowest
	    point on the chassis bottom while the kit's skids / wheels (its lowest collidable parts) stand lower on the pad:
	    the parked body would float. This gives the lowest collidable kit point (seats excepted) instead.
	  • Apply, after placeKitOnBody:
	      - BodyMounts: each named kit part (the AirWeaponService muzzle mounts: Nose, WingL, StubWingL, Cockpit ...) is
	        re-welded with its front face centre on a point of the body (unscaled body box frame, like BodySeats), so guns
	        fire from the body's nose and missiles leave its wing rails (AirWeaponService adds MuzzleForward / MuzzleDrop
	        to that face). Only non-colliding, non-seat kit parts move; the chassis never does.
	      - RotorParts: the named body (or kit) parts get a Motor6D to the chassis instead of their WeldConstraint, with
	        the joint's Y axis on the rotor axis, tagged WE_RotorJoint (attribute WE_RotorRps). Each client turns them
	        (AircraftBodyClient: Motor6D.Transform, local only, never replicated); the server never moves them, so
	        physics and replication are unchanged. air fix2: RotorParts[i].Under scopes the names to one ancestor Model
	        per rotor (store rotors often share one part name), and a part already on a rotor joint is never jointed twice.
	      - ChaseCamera: WE_CamMinZoom on the model = the body's reach from the pilot seat (its farthest end: tail, nose
	        or wing tip) + AirBody.ChaseCameraMargin, capped at ChaseCameraMax, for AircraftBodyClient's seated camera.
	      - BodyHitBoxes (air2 fix1, with AirBody.BodyHitBoxes on): invisible hit plates (Parts "WE_HitPlate": Transparency 1,
	        CanQuery, never CanCollide / CanTouch, Massless, welded) over the fitted body (unscaled boxes, like BodySeats),
	        so a shot hits the aircraft players see. The kit's hidden non-colliding parts (its old nose, wings, fins ...)
	        stop taking shots; the chassis, the seats and the visible gear keep theirs. Physics and collisions unchanged.
	      - A BodyMounts kit part (a muzzle point on the body) never takes a shot (CanQuery false): moved to a wing tip it
	        would be a hit box beside the aircraft.
	      - BodyGear (air2 fix1): drawn landing gear (Folder "WE_GearDress" in the body: a strut and a wheel per leg), the
	        wheel on the kit's floor line (its lowest collidable point), the strut up into the body box over the leg. Never
	        collides, massless, no shadow; it takes shots like the body plates. The hidden kit gear still stands the jet.
	      - TailGuard (air2 fix1, with AirBody.TailGuard.Enabled): WE_TailGuard on the model = "MinPitch,LeadSeconds;x,y,z;..."
	        the four bottom corners of every body part box in the chassis frame, Margin lower (the drawn gear excepted).
	        The driver's plane law (VehicleDriveClient Laws.TailGuard) keeps them over the ground near the ground.
	  • StripSigns: a store body's BillboardGui / SurfaceGui signs always go (whole model or pack piece), its decals with
	    ref.StripDecals.
	  • v87 (Code Bot): ClampScale (a ref's BodyMinScale lowers the 0.05 floor: the gunboat), KitRotor (the kit rotor onto
	    a helicopter body's mast, stretched to its span; spun by a Kit RotorParts entry), BodyDeck (invisible collidable
	    massless deck plates, WE_BodyDeck, skipped by VehicleService's footprint) and BodyKitNoCollide (kit parts that
	    would stand over the fitted deck stop colliding). Helicopters, bombers, transports and ships (owner-only rollout).
	  • v88 (Code Bot): BodyMaxScale (raises the 4 scale cap, max 40: the airliner mesh) and BodyAnchorX (BodyAnchor also
	    moves the body across the kit: the carrier / amphib island bridge). The wc6 bodies (owner-only rollout).
	Kit parts are moved with an unweld / set / weld (a CFrame set on a welded part would move the whole aircraft). ]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- server module: the Rojo place ships ReplicatedStorage.Shared, so index it (no WaitForChild without a timeout)
local VisualAssetConfig = require(ReplicatedStorage.Shared.Configs.VisualAssetConfig)

local AirBodyRig = {}

AirBodyRig.RotorTag = "WE_RotorJoint"
AirBodyRig.RotorJointName = "WE_RotorJoint"
AirBodyRig.HitPlateName = "WE_HitPlate"
AirBodyRig.GearName = "WE_GearDress"

local AXES: { [string]: CFrame } = {
	Y = CFrame.identity,
	X = CFrame.Angles(0, 0, -math.pi / 2), -- joint Y -> chassis X
	Z = CFrame.Angles(math.pi / 2, 0, 0), -- joint Y -> chassis Z
}

-- chassis-frame half extent of a part along Y, and its full extents
local function extents(rel: CFrame, size: Vector3): Vector3
	local h = size * 0.5
	local r, u, l = rel.RightVector, rel.UpVector, rel.LookVector
	return Vector3.new(
		math.abs(r.X) * h.X + math.abs(u.X) * h.Y + math.abs(l.X) * h.Z,
		math.abs(r.Y) * h.X + math.abs(u.Y) * h.Y + math.abs(l.Y) * h.Z,
		math.abs(r.Z) * h.X + math.abs(u.Z) * h.Y + math.abs(l.Z) * h.Z
	)
end

-- the box Roblox draws for a part (as VisualAssetService drawnSize: a round Part is drawn smaller than its Size box)
local function drawn(p: BasePart): Vector3
	local size = p.Size
	if p:IsA("Part") then
		if p.Shape == Enum.PartType.Cylinder then
			local d = math.min(size.Y, size.Z)
			return Vector3.new(size.X, d, d)
		elseif p.Shape == Enum.PartType.Ball then
			local d = math.min(size.X, size.Y, size.Z)
			return Vector3.new(d, d, d)
		end
	end
	return size
end

local function isSeat(p: Instance): boolean
	return p:IsA("Seat") or p:IsA("VehicleSeat")
end

-- The lowest point of the kit's collidable parts (seats excepted) in the chassis frame, else `fallback`.
function AirBodyRig.KitFloor(hostModel: Model, primary: BasePart, fallback: number): number
	local low: number? = nil
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide and not isSeat(d) then
			local rel = primary.CFrame:ToObjectSpace(d.CFrame)
			local b = rel.Position.Y - extents(rel, d.Size).Y
			if low == nil or b < low then
				low = b
			end
		end
	end
	return if low ~= nil then math.min(low, fallback) else fallback
end

-- v87: a fitted body's scale, clamped to [floor, 4]. The floor is 0.05 unless the ref sets BodyMinScale (only the gunboat
-- store model, authored 2048 studs long, fits at 0.027); a BodyMinScale is itself never under 0.005. Every other body
-- keeps the 0.05 floor it always had.
function AirBodyRig.ClampScale(ref: any, raw: number): number
	local floor = if typeof(ref.BodyMinScale) == "number" then math.clamp(ref.BodyMinScale, 0.005, 0.05) else 0.05
	-- v88: BodyMaxScale raises the 4 cap (only the airliner mesh, authored 2.1 studs long, fits at 30); never over 40
	local cap = if typeof(ref.BodyMaxScale) == "number" then math.clamp(ref.BodyMaxScale, 4, 40) else 4
	return math.clamp(raw, floor, cap)
end

-- The chassis-frame X / Z move that puts ref.BodySeats[ref.BodyAnchor] (scaled by s, turned by yawDeg, measured from
-- the body box centre as fitBodyToKit places it) over the kit seat named ref.BodyAnchor. Zero when not configured.
function AirBodyRig.AnchorShift(hostModel: Model, primary: BasePart, ref: any, s: number, yawDeg: number): Vector3
	local name = ref.BodyAnchor
	local seats = ref.BodySeats
	if typeof(name) ~= "string" or typeof(seats) ~= "table" then
		return Vector3.zero
	end
	local top = seats[name]
	local kitSeat = hostModel:FindFirstChild(name)
	if typeof(top) ~= "Vector3" or kitSeat == nil or not kitSeat:IsA("BasePart") then
		return Vector3.zero
	end
	local k = primary.CFrame:PointToObjectSpace(kitSeat.Position)
	local v = CFrame.Angles(0, math.rad(yawDeg), 0) * (top * s)
	-- along the kit's length only: the body stays centred across the kit (its seats' X still clamp into the kit box).
	-- v88: BodyAnchorX moves it across too (the carrier / amphib bridge sits on an island off the centre line)
	local dx = if ref.BodyAnchorX == true then k.X - v.X else 0
	return Vector3.new(dx, 0, k.Z - v.Z)
end

-- unweld `part` from the chassis (WeldConstraints either side), set its CFrame, weld it again
local function reweld(primary: BasePart, part: BasePart, cf: CFrame)
	for _, holder in ipairs({ primary :: Instance, part :: Instance }) do
		for _, w in ipairs(holder:GetChildren()) do
			if w:IsA("WeldConstraint") and ((w.Part0 == primary and w.Part1 == part) or (w.Part0 == part and w.Part1 == primary)) then
				w:Destroy()
			end
		end
	end
	part.CFrame = cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = primary
	w.Part1 = part
	w.Parent = primary
end

-- the fitted body's frame (chassis X / Z shift, lowest point, turned by the ref's Yaw, as fitBodyToKit placed it) and
-- the body's reach from the kit's DriverSeat in the chassis X / Z plane (its farthest end in any orbit direction)
local function bodyBase(hostModel: Model, primary: BasePart, clone: Model, ref: any): (CFrame?, number)
	local bottom, front, rear, side = math.huge, math.huge, -math.huge, 0
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = primary.CFrame:ToObjectSpace(d.CFrame)
			local e = extents(rel, drawn(d))
			bottom = math.min(bottom, rel.Position.Y - e.Y)
			front, rear = math.min(front, rel.Position.Z - e.Z), math.max(rear, rel.Position.Z + e.Z)
			side = math.max(side, math.abs(rel.Position.X) + e.X)
		end
	end
	if bottom == math.huge then
		return nil, 0
	end
	local seat = hostModel:FindFirstChild("DriverSeat")
	local seatZ = if seat and seat:IsA("BasePart") then primary.CFrame:PointToObjectSpace(seat.Position).Z else 0
	local reach = math.max(rear - seatZ, seatZ - front, side)
	local shift = clone:GetAttribute("WE_BodyShift")
	local sh = if typeof(shift) == "Vector3" then shift else Vector3.zero
	return primary.CFrame * CFrame.new(sh.X, bottom, sh.Z) * CFrame.Angles(0, math.rad(tonumber(ref.Yaw) or 0), 0), reach
end

-- air fix2: the parts one RotorParts spec names, grouped into rotors. Without Under: one group over the whole root. With
-- Under (an ancestor Model name): one group per ancestor of that name inside the root, so a main rotor (Rotor1) and a tail
-- rotor (Rotor2) whose pieces share one name ("MeshPart") never spin about each other's centre. Seats and parts that
-- already carry a rotor joint (an earlier spec took them) are skipped: a part is never jointed twice.
type RotorGroup = { parts: { BasePart }, scope: Instance }
local function rotorGroups(root: Instance, spec: any): { RotorGroup }
	local want: { [string]: boolean } = {}
	for _, n in ipairs(spec.Parts) do
		if typeof(n) == "string" then
			want[n] = true
		end
	end
	local under: string? = if typeof(spec.Under) == "string" and spec.Under ~= "" then spec.Under else nil
	local groups: { RotorGroup } = {}
	local byScope: { [Instance]: { BasePart } } = {}
	for _, d in ipairs(root:GetDescendants()) do
		if
			d:IsA("BasePart")
			and want[d.Name]
			and not isSeat(d)
			and d:FindFirstChild(AirBodyRig.RotorJointName) == nil
		then
			local scope: Instance? = root
			if under ~= nil then
				scope = d:FindFirstAncestor(under)
				if scope ~= nil and scope ~= root and not scope:IsDescendantOf(root) then
					scope = nil -- an ancestor above the body (the vehicle model) is not a rotor of the body
				end
			end
			if scope ~= nil then
				local list = byScope[scope]
				if list == nil then
					list = {}
					byScope[scope] = list
					table.insert(groups, { parts = list, scope = scope })
				end
				table.insert(list, d)
			end
		end
	end
	return groups
end

--[[ claude-bud JOB 56: the rotor's own disc. parts = one rotor group, jointRot = the configured joint rotation (chassis
	x axis spec), hubCentre = the configured centre. Returns { Centre, Rot, Tilt, Offset } when the blades' own disc
	differs (tilt > MinTiltDeg or the centre > MinOffset away), else nil (keep the configured joint). Pure maths on the
	parts' CFrame / Size: the thinnest box axis of the biggest blade part is the disc normal (signed like the configured
	axis), the centre is the single blade part's own centre (a symmetric rotor mesh) or the parts' average. ]]
function AirBodyRig._DiscFit(parts: { BasePart }, jointRot: CFrame, hubCentre: Vector3): any?
	local R: any = (VisualAssetConfig :: any).AirRotorDisc
	if typeof(R) ~= "table" or #parts == 0 then
		return nil
	end
	local big, vol = parts[1], -1
	for _, p in ipairs(parts) do
		local v = p.Size.X * p.Size.Y * p.Size.Z
		if v > vol then
			big, vol = p, v
		end
	end
	local s = big.Size
	local axes = {
		{ d = s.X, v = big.CFrame.RightVector },
		{ d = s.Y, v = big.CFrame.UpVector },
		{ d = s.Z, v = big.CFrame.LookVector },
	}
	table.sort(axes, function(a, b)
		return a.d < b.d
	end)
	local want = jointRot.UpVector
	local centre = Vector3.zero
	if #parts == 1 then
		centre = big.Position
	else
		for _, p in ipairs(parts) do
			centre += p.Position
		end
		centre /= #parts
	end
	local offset = (centre - hubCentre).Magnitude
	local n = want
	local tilt = 0
	if axes[1].d < (tonumber(R.ThinRatio) or 0.5) * axes[2].d then
		n = axes[1].v
		if n:Dot(want) < 0 then
			n = -n
		end
		tilt = math.deg(math.acos(math.clamp(n:Dot(want), -1, 1)))
		if tilt > (tonumber(R.MaxCorrectionDeg) or 25) then
			n, tilt = want, 0 -- the box guess is wrong (a round / chunky part): keep the configured axis
		end
	end
	local fixTilt = tilt > (tonumber(R.MinTiltDeg) or 1)
	local fixCentre = offset > (tonumber(R.MinOffset) or 0.05)
	if not fixTilt and not fixCentre then
		return { Centre = hubCentre, Rot = jointRot, Tilt = tilt, Offset = offset, Changed = false }
	end
	local rot = jointRot
	if fixTilt then
		local r0 = jointRot.RightVector
		local right = r0 - n * r0:Dot(n)
		right = if right.Magnitude > 1e-4 then right.Unit else jointRot.LookVector:Cross(n).Unit
		rot = CFrame.fromMatrix(Vector3.zero, right, n)
	end
	return { Centre = if fixCentre then centre else hubCentre, Rot = rot, Tilt = tilt, Offset = offset, Changed = true }
end

-- one rotor spec: every part gets a Motor6D to the chassis whose joint frame sits on its group's spin centre (the Hub
-- inside the group's scope, else the group's average centre) with Y on the axis
local function rigRotor(hostModel: Model, primary: BasePart, clone: Model, spec: any): number
	if typeof(spec) ~= "table" or typeof(spec.Parts) ~= "table" then
		return 0
	end
	local axis: CFrame? = AXES[tostring(spec.Axis)]
	local rps = tonumber(spec.Rps) or 0
	if axis == nil or rps <= 0 then
		return 0
	end
	local root: Instance = if spec.Kit == true then hostModel else clone
	local n = 0
	for _, g in ipairs(rotorGroups(root, spec)) do
		local parts = g.parts
		if spec.Kit == true then
			-- kit rotor parts only (never the body's own parts under the same name)
			local kit: { BasePart } = {}
			for _, p in ipairs(parts) do
				if not p:IsDescendantOf(clone) then
					table.insert(kit, p)
				end
			end
			parts = kit
		end
		if #parts > 0 then
			local centre = Vector3.zero
			local hub = if typeof(spec.Hub) == "string" then g.scope:FindFirstChild(spec.Hub, true) else nil
			if hub and hub:IsA("BasePart") then
				centre = hub.Position
			else
				for _, p in ipairs(parts) do
					centre += p.Position
				end
				centre /= #parts
			end
			local jointRot = (primary.CFrame - primary.CFrame.Position) * (axis :: CFrame)
			-- claude-bud JOB 56: spin about the blades' own disc / centre (owner-first by the vehicle owner); always log
			local R: any = (VisualAssetConfig :: any).AirRotorDisc
			local owner = hostModel:GetAttribute("OwnerUserId")
			local fit = AirBodyRig._DiscFit(parts, jointRot, centre)
			local live = typeof(R) == "table" and (require(ReplicatedStorage.Shared.Configs.RetentionConfig) :: any).Live(R, owner)
			if fit then
				print(string.format("[RotorRig] %s %s parts=%d tilt=%.1f deg hubOffset=%.2f studs fixed=%s", hostModel.Name,
					tostring(spec.Hub or "avg"), #parts, fit.Tilt, fit.Offset, tostring(live and fit.Changed)))
				if live and fit.Changed then
					centre = fit.Centre
					jointRot = fit.Rot
				end
			end
			local joint = CFrame.new(centre) * jointRot
			for _, p in ipairs(parts) do
				for _, holder in ipairs({ primary :: Instance, p :: Instance }) do
					for _, w in ipairs(holder:GetChildren()) do
						if w:IsA("WeldConstraint") and ((w.Part0 == primary and w.Part1 == p) or (w.Part0 == p and w.Part1 == primary)) then
							w:Destroy()
						end
					end
				end
				local m = Instance.new("Motor6D")
				m.Name = AirBodyRig.RotorJointName
				m.Part0 = primary
				m.Part1 = p
				m.C0 = primary.CFrame:ToObjectSpace(joint)
				m.C1 = p.CFrame:ToObjectSpace(joint)
				m:SetAttribute("WE_RotorRps", rps)
				m.Parent = p
				CollectionService:AddTag(m, AirBodyRig.RotorTag)
				p.Massless = true
				p.CanCollide = false
				p.CanTouch = false
				n += 1
			end
		end
	end
	return n
end

-- A store body on a vehicle never shows the seller's signs: every BillboardGui / SurfaceGui (a floating name label such as
-- a helicopter's "Medical Helicopter" sign, CLAUDE.md world-label rules) goes, and with ref.StripDecals its Decals /
-- Textures too. Whole models AND pack pieces (ChildName): a piece already lost its decals when the pack was split
-- (extractPiece, StripDecals), but not its GUIs, and a trimmed body (OmitParts before the part count) is always a piece.
-- Returns how many objects went. Any vehicle family; a no-op for the live bodies (the Recon Plane and the APC carry none;
-- the jeep / buggy / van / pickup packs keep their only GUIs inside LocalScripts, which the loader strips).
function AirBodyRig.StripSigns(clone: Instance, ref: any): number
	local decals = ref.StripDecals == true
	local gone = 0
	for _, d in ipairs(clone:GetDescendants()) do
		if d.Parent ~= nil and (d:IsA("BillboardGui") or d:IsA("SurfaceGui") or (decals and (d:IsA("Decal") or d:IsA("Texture")))) then
			d:Destroy()
			gone += 1
		end
	end
	return gone
end

-- air2 fix1: the fitted body's hit plates (ref.BodyHitBoxes, unscaled body boxes) and the kit's hidden parts out of the
-- shot. Returns the number of plates made.
local function hitPlates(hostModel: Model, primary: BasePart, clone: Model, ref: any, base: CFrame, s: number): number
	local keep: { [string]: boolean } = {}
	for _, n in ipairs(ref.KeepVisible or {}) do
		if typeof(n) == "string" then
			keep[n] = true
		end
	end
	-- the kit's non-colliding parts under the body (hidden by HideKit) take no shot: the plates are the aircraft now
	for _, d in ipairs(hostModel:GetDescendants()) do
		if
			d:IsA("BasePart")
			and d ~= primary
			and not d.CanCollide
			and not isSeat(d)
			and not keep[d.Name]
			and not d:IsDescendantOf(clone)
			and d:GetAttribute("WE_PhysicsWheel") ~= true
		then
			d.CanQuery = false
		end
	end
	local n = 0
	for _, hb in ipairs(ref.BodyHitBoxes) do
		if typeof(hb) == "table" and typeof(hb.At) == "Vector3" and typeof(hb.Size) == "Vector3" then
			local p = Instance.new("Part")
			p.Name = AirBodyRig.HitPlateName
			p.Size = hb.Size * s
			p.CFrame = base * CFrame.new(hb.At * s)
			p.Transparency = 1
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = true
			p.Massless = true
			p.CastShadow = false
			p.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = primary
			w.Part1 = p
			w.Parent = p
			p.Parent = hostModel
			n += 1
		end
	end
	return n
end

-- chassis-frame box of every part of the store body (the drawn gear, which Apply adds after, excepted)
local function bodyBoxes(primary: BasePart, clone: Model): { { number } }
	local out: { { number } } = {}
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") and d.Parent ~= nil and d.Parent.Name ~= AirBodyRig.GearName then
			local rel = primary.CFrame:ToObjectSpace(d.CFrame)
			local e = extents(rel, drawn(d))
			local c = rel.Position
			table.insert(out, { c.X - e.X, c.Y - e.Y, c.Z - e.Z, c.X + e.X, c.Y + e.Y, c.Z + e.Z })
		end
	end
	return out
end

-- air2 fix1: drawn landing gear under the body (ref.BodyGear). Each leg: its wheel on the kit's floor line, its strut from
-- the wheel centre up into the lowest body box over the leg (the body's lowest point when none is over it). Returns the
-- number of parts made.
local function gearDress(hostModel: Model, primary: BasePart, clone: Model, gear: any, base: CFrame, s: number): number
	if typeof(gear.Legs) ~= "table" then
		return 0
	end
	local boxes = bodyBoxes(primary, clone)
	local bodyLow = math.huge
	for _, b in ipairs(boxes) do
		bodyLow = math.min(bodyLow, b[2])
	end
	local floor = AirBodyRig.KitFloor(hostModel, primary, -primary.Size.Y * 0.5)
	local strut = math.clamp(tonumber(gear.Strut) or 0.3, 0.05, 2)
	local into = math.clamp(tonumber(gear.Into) or 0.3, 0, 3)
	-- air2 fix2: the look comes from the config (JET_GEAR); these are only the fallbacks for a table without it
	local wheelCol: Color3 = if typeof(gear.WheelColor) == "Color3" then gear.WheelColor else Color3.fromRGB(28, 28, 30)
	local strutCol: Color3 = if typeof(gear.StrutColor) == "Color3" then gear.StrutColor else Color3.fromRGB(120, 122, 126)
	local wm: any, sm: any = gear.WheelMaterial, gear.StrutMaterial
	local wheelMat: Enum.Material = if typeof(wm) == "EnumItem" then (wm :: any) else Enum.Material.SmoothPlastic
	local strutMat: Enum.Material = if typeof(sm) == "EnumItem" then (sm :: any) else Enum.Material.Metal
	local folder = Instance.new("Folder")
	folder.Name = AirBodyRig.GearName
	local rot = primary.CFrame - primary.CFrame.Position
	local n = 0
	local function part(name: string, size: Vector3, at: Vector3, round: boolean)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		if round then
			p.Shape = Enum.PartType.Cylinder -- a Part cylinder turns about its X axis: the kit's across axis, rolling along Z
			p.Material = wheelMat
			p.Color = wheelCol
		else
			p.Material = strutMat
			p.Color = strutCol
		end
		p.CFrame = CFrame.new(primary.CFrame:PointToWorldSpace(at)) * rot
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = true -- what players see takes the shot, like the body's hit plates
		p.Massless = true
		p.CastShadow = false
		local w = Instance.new("WeldConstraint")
		w.Part0 = primary
		w.Part1 = p
		w.Parent = p
		p.Parent = folder
		n += 1
	end
	for _, leg in ipairs(gear.Legs) do
		local wheel = if typeof(leg) == "table" then tonumber(leg.Wheel) else nil
		if typeof(leg) == "table" and typeof(leg.At) == "Vector3" and wheel and wheel > 0 then
			local at = primary.CFrame:PointToObjectSpace((base * CFrame.new(leg.At * s)).Position)
			local top: number? = nil
			for _, b in ipairs(boxes) do
				if at.X >= b[1] and at.X <= b[4] and at.Z >= b[3] and at.Z <= b[6] then
					top = math.min(top or math.huge, b[2])
				end
			end
			local sTop = (top or bodyLow) + into
			local wy = floor + wheel * 0.5
			if sTop > wy then
				part("GearStrut", Vector3.new(strut, sTop - wy, strut), Vector3.new(at.X, (wy + sTop) * 0.5, at.Z), false)
			end
			part("GearWheel", Vector3.new(wheel * 0.45, wheel, wheel), Vector3.new(at.X, wy, at.Z), true)
		end
	end
	folder.Parent = clone
	return n
end

-- air2 fix1: the body's lowest box corners for the driver's plane law (WE_TailGuard; VehicleDriveClient Laws.TailGuard)
local function tailGuard(hostModel: Model, primary: BasePart, clone: Model, cfg: any)
	local margin = math.clamp(tonumber(cfg.Margin) or 0.3, 0, 2)
	local minPitch = math.clamp(tonumber(cfg.MinPitch) or 3.5, 0, 15)
	local lead = math.clamp(tonumber(cfg.LeadSeconds) or 0.15, 0, 1)
	local pts: { string } = { string.format("%.2f,%.3f", minPitch, lead) }
	for _, b in ipairs(bodyBoxes(primary, clone)) do
		for _, x in ipairs({ b[1], b[4] }) do
			for _, z in ipairs({ b[3], b[6] }) do
				table.insert(pts, string.format("%.3f,%.3f,%.3f", x, b[2] - margin, z))
			end
		end
	end
	if #pts > 1 then
		hostModel:SetAttribute("WE_TailGuard", table.concat(pts, ";"))
	end
end

-- v87: the kit rotor onto a store helicopter body (ref.KitRotor). Every named kit part (never the body's) moves by one
-- offset, so the Hub part's centre lands on At (unscaled body frame, like BodySeats); with Span each blade's longest side
-- (X or Z) becomes Span x s, so the kit blades reach as far as the body's own rotor did. Returns the parts moved.
local function kitRotor(hostModel: Model, primary: BasePart, clone: Model, spec: any, base: CFrame, s: number): number
	if typeof(spec.Parts) ~= "table" or typeof(spec.At) ~= "Vector3" or typeof(spec.Hub) ~= "string" then
		return 0
	end
	local parts: { BasePart } = {}
	local hub: BasePart? = nil
	for _, p in ipairs(namedParts(hostModel, spec.Parts)) do
		if p ~= primary and not p:IsDescendantOf(clone) then
			table.insert(parts, p)
			if p.Name == spec.Hub then
				hub = p
			end
		end
	end
	if hub == nil then
		return 0
	end
	local delta = (base * CFrame.new(spec.At * s)).Position - hub.Position
	local span = tonumber(spec.Span)
	for _, p in ipairs(parts) do
		if span and span > 0 and p ~= hub then
			local z = p.Size
			if z.X >= z.Z then
				p.Size = Vector3.new(span * s, z.Y, z.Z)
			else
				p.Size = Vector3.new(z.X, z.Y, span * s)
			end
		end
		reweld(primary, p, p.CFrame + delta)
	end
	return #parts
end

-- v87: invisible collidable deck plates over a fitted ship body (ref.BodyDeck, unscaled boxes like BodyHitBoxes), welded
-- and massless, so players and aircraft stand on the deck they see. Attribute WE_BodyDeck: VehicleService's footprint
-- (WE_HalfLength / WE_HalfWidth, the spawn box, driving) skips them, so the kit's physics box is unchanged. They take no
-- shots (CanQuery false) and never fire Touched. Returns the number of plates made.
local function deckPlates(hostModel: Model, primary: BasePart, list: any, base: CFrame, s: number): number
	local n = 0
	for _, hb in ipairs(list) do
		if typeof(hb) == "table" and typeof(hb.At) == "Vector3" and typeof(hb.Size) == "Vector3" then
			local p = Instance.new("Part")
			p.Name = "WE_BodyDeck"
			p.Size = hb.Size * s
			p.CFrame = base * CFrame.new(hb.At * s)
			p.Transparency = 1
			p.CanCollide = true
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
			p.CastShadow = false
			p.Anchored = false
			p:SetAttribute("WE_BodyDeck", true)
			local w = Instance.new("WeldConstraint")
			w.Part0 = primary
			w.Part1 = p
			w.Parent = p
			p.Parent = hostModel
			n += 1
		end
	end
	return n
end

-- After placeKitOnBody (a fitted BodyScale body): BodyMounts, RotorParts, ChaseCamera, BodyHitBoxes, BodyGear and
-- TailGuard. Returns the number of rotor joints made (for tests). Never errors on a bad ref entry: it is skipped.
function AirBodyRig.Apply(hostModel: Model, primary: BasePart, clone: Model, ref: any): number
	if
		ref.BodyMounts == nil
		and ref.RotorParts == nil
		and ref.ChaseCamera ~= true
		and ref.BodyHitBoxes == nil
		and ref.BodyGear == nil
		and ref.TailGuard ~= true
		and ref.KitRotor == nil
		and ref.BodyDeck == nil
		and ref.BodyKitNoCollide == nil
	then
		return 0 -- every car / boat body and every aircraft ref without the air-looks fields
	end
	local base, reach = bodyBase(hostModel, primary, clone, ref)
	if base == nil then
		return 0
	end
	local s = AirBodyRig.ClampScale(ref, tonumber(ref.BodyScale) or 1)
	if typeof(ref.BodyMounts) == "table" then
		for name, at in pairs(ref.BodyMounts) do
			local p = if typeof(name) == "string" then hostModel:FindFirstChild(name) else nil
			if p and p:IsA("BasePart") and p ~= primary and not isSeat(p) and not p.CanCollide and typeof(at) == "Vector3" then
				-- the part's FRONT face centre lands on the point, so the muzzle (front face + the weapon's MuzzleForward /
				-- MuzzleDrop) is the same for every kit scale
				local rot = p.CFrame - p.CFrame.Position
				reweld(primary, p, CFrame.new((base * CFrame.new(at * s)).Position) * rot * CFrame.new(0, 0, p.Size.Z * 0.5))
				p.CanQuery = false -- air2 fix1: a muzzle point, never a hit box beside the aircraft
			end
		end
	end
	if typeof(ref.KitRotor) == "table" then
		kitRotor(hostModel, primary, clone, ref.KitRotor, base, s) -- v87: before the joints (they are made where it lands)
	end
	if typeof(ref.BodyDeck) == "table" then
		deckPlates(hostModel, primary, ref.BodyDeck, base, s)
	end
	if typeof(ref.BodyKitNoCollide) == "table" then
		for _, name in ipairs(ref.BodyKitNoCollide) do
			local p = if typeof(name) == "string" then hostModel:FindFirstChild(name) else nil
			if p and p:IsA("BasePart") and p ~= primary and not isSeat(p) then
				p.CanCollide = false
			end
		end
	end
	local joints = 0
	if typeof(ref.RotorParts) == "table" then
		for _, spec in ipairs(ref.RotorParts) do
			joints += rigRotor(hostModel, primary, clone, spec)
		end
	end
	local cfg = (VisualAssetConfig :: any).AirBody or {}
	if ref.ChaseCamera == true then
		local zoom = reach + (tonumber(cfg.ChaseCameraMargin) or 6)
		hostModel:SetAttribute("WE_CamMinZoom", math.min(zoom, tonumber(cfg.ChaseCameraMax) or 60))
	end
	if cfg.BodyHitBoxes == true and typeof(ref.BodyHitBoxes) == "table" and #ref.BodyHitBoxes > 0 then
		hitPlates(hostModel, primary, clone, ref, base, s)
	end
	local guard = cfg.TailGuard
	if ref.TailGuard == true and typeof(guard) == "table" and guard.Enabled == true then
		tailGuard(hostModel, primary, clone, guard) -- before the gear: the drawn wheels stand on the ground
	end
	if typeof(ref.BodyGear) == "table" then
		gearDress(hostModel, primary, clone, ref.BodyGear, base, s)
	end
	return joints
end

return AirBodyRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">AirOrdnance</string>
            <string name="Source"><![CDATA[--!strict
--[[ Aircraft ordnance (AirWeaponService): server kinematic rockets, homing missiles and falling bombs.

	No parts on the server. Each round is a record stepped at AircraftWeaponConfig.Ordnance.StepHz by one shared
	thread that only runs while something is in flight: pos += v dt + 1/2 g dt^2, v += g dt, ONE ray per step along
	the segment (Exclude filter: the firing aircraft, the pilot, squad units; IgnoreWater). A homing round turns its
	velocity toward its Target part by at most TurnRateDeg x dt per step (the target was chosen by the server; a
	target that is gone, dead or wrecked is dropped and the round flies straight) and detonates within ProximityFuse
	of it. The first hit, the fuse, or t = MaxSeconds calls OnImpact once (pcall'd).
	Caps: MaxLivePerPlayer / MaxLiveServer (AtCap is checked before any ammo is spent). ]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local AircraftWeaponConfig = require(Shared.Configs.AircraftWeaponConfig)

local AirOrdnance = {}

export type Spec = {
	OwnerUserId: number,
	Origin: Vector3,
	Velocity: Vector3,
	GravityFactor: number,
	MaxSeconds: number,
	Filter: { Instance },
	Target: BasePart?, -- homing target (server-chosen)
	IsTargetAlive: (() -> boolean)?,
	TurnRateDeg: number?,
	ProximityFuse: number?,
	OnImpact: (pos: Vector3, hit: RaycastResult?, rec: Record) -> (),
}

export type Record = {
	Id: number,
	OwnerUserId: number,
	Pos: Vector3,
	V: Vector3,
	G: Vector3,
	T: number,
	At: number,
	MaxSeconds: number,
	Params: RaycastParams,
	Target: BasePart?,
	IsTargetAlive: (() -> boolean)?,
	TurnRad: number,
	Fuse: number,
	OnImpact: (pos: Vector3, hit: RaycastResult?, rec: Record) -> (),
	Done: boolean,
	Steps: number,
}

local live: { [number]: Record } = {}
local liveTotal = 0
local liveBy: { [number]: number } = {}
local serial = 0
local running = false

local function cfg()
	return AircraftWeaponConfig.Ordnance
end

local function gravity(): number
	local ok, g = pcall(function()
		return (Workspace :: any).Gravity
	end)
	if ok and typeof(g) == "number" and g == g and g >= 0 and g < 1e4 then
		return g
	end
	return 196.2
end

function AirOrdnance.LiveFor(userId: number): number
	return liveBy[userId] or 0
end

function AirOrdnance.LiveTotal(): number
	return liveTotal
end

-- true when `n` more rounds from `userId` would pass a cap
function AirOrdnance.AtCap(userId: number, n: number?): boolean
	local c = cfg()
	local k = n or 1
	return AirOrdnance.LiveFor(userId) + k > c.MaxLivePerPlayer or liveTotal + k > c.MaxLiveServer
end

local function finish(rec: Record, pos: Vector3, hit: RaycastResult?)
	if rec.Done then
		return
	end
	rec.Done = true
	live[rec.Id] = nil
	liveTotal = math.max(0, liveTotal - 1)
	local n = (liveBy[rec.OwnerUserId] or 1) - 1
	if n > 0 then
		liveBy[rec.OwnerUserId] = n
	else
		liveBy[rec.OwnerUserId] = nil
	end
	xpcall(rec.OnImpact, function(err: any)
		warn("[AirOrdnance] impact error:", err)
	end, pos, hit, rec)
end

-- turn `v` toward `want` (unit) by at most `maxRad`, keeping its speed
local function steer(v: Vector3, want: Vector3, maxRad: number): Vector3
	local speed = v.Magnitude
	if speed < 1e-3 then
		return want * speed
	end
	local cur = v / speed
	local d = math.clamp(cur:Dot(want), -1, 1)
	local ang = math.acos(d)
	if ang <= maxRad or ang < 1e-4 then
		return want * speed
	end
	local perp = want - cur * d
	if perp.Magnitude < 1e-6 then
		return v
	end
	perp = perp.Unit
	return (cur * math.cos(maxRad) + perp * math.sin(maxRad)) * speed
end

local function targetOk(rec: Record): boolean
	local tgt = rec.Target
	if tgt == nil or tgt.Parent == nil then
		return false
	end
	local fn = rec.IsTargetAlive
	if fn then
		local ok, alive = pcall(fn)
		if not ok or alive ~= true then
			return false
		end
	end
	return true
end

local function step(rec: Record, now: number)
	if rec.Done then
		return
	end
	local dt = math.min(now - rec.At, rec.MaxSeconds - rec.T)
	if not (dt > 0) then
		if rec.T >= rec.MaxSeconds then
			finish(rec, rec.Pos, nil)
		end
		return
	end
	rec.At = now
	rec.Steps += 1
	if rec.Target ~= nil then
		if targetOk(rec) then
			local tp = (rec.Target :: BasePart).Position
			local to = tp - rec.Pos
			if to.Magnitude <= rec.Fuse then
				finish(rec, rec.Pos, nil)
				return
			end
			rec.V = steer(rec.V, to.Unit, rec.TurnRad * dt)
		else
			rec.Target = nil -- lost: straight on
		end
	end
	local p1 = rec.Pos + rec.V * dt + rec.G * (0.5 * dt * dt)
	rec.V += rec.G * dt
	local seg = p1 - rec.Pos
	if seg.Magnitude > 1e-3 then
		local res = Workspace:Raycast(rec.Pos, seg, rec.Params)
		if res then
			rec.Pos = res.Position
			finish(rec, res.Position, res)
			return
		end
	end
	rec.Pos = p1
	rec.T += dt
	if rec.Target ~= nil and targetOk(rec) and ((rec.Target :: BasePart).Position - p1).Magnitude <= rec.Fuse then
		finish(rec, p1, nil)
		return
	end
	if rec.T >= rec.MaxSeconds - 1e-6 then
		finish(rec, p1, nil)
	end
end

-- advance every live round to `now` (the runner thread; tests may call it directly)
function AirOrdnance.StepAll(now: number?)
	local t = now or os.clock()
	local list: { Record } = {}
	for _, rec in pairs(live) do
		table.insert(list, rec)
	end
	for _, rec in ipairs(list) do
		step(rec, t)
	end
end

local function runner()
	local dt = 1 / math.clamp(tonumber(cfg().StepHz) or 20, 5, 60)
	while liveTotal > 0 do
		task.wait(dt)
		xpcall(AirOrdnance.StepAll, function(err: any)
			warn("[AirOrdnance] step error:", err)
		end, os.clock())
	end
	running = false
end

-- launch one round; nil when a cap refuses it or the spec is not finite
function AirOrdnance.Launch(spec: Spec): Record?
	if AirOrdnance.AtCap(spec.OwnerUserId, 1) then
		return nil
	end
	local o, v = spec.Origin, spec.Velocity
	if not (o.Magnitude < 1e7 and v.Magnitude < 1e5) then -- NaN / inf fail here
		return nil
	end
	serial = (serial % 1000000) + 1
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = spec.Filter
	params.IgnoreWater = true
	local gf = math.clamp(tonumber(spec.GravityFactor) or 0, 0, 5)
	local rec: Record = {
		Id = serial,
		OwnerUserId = spec.OwnerUserId,
		Pos = o,
		V = v,
		G = Vector3.new(0, -gravity() * gf, 0),
		T = 0,
		At = os.clock(),
		MaxSeconds = math.clamp(tonumber(spec.MaxSeconds) or 1, 0.05, 12),
		Params = params,
		Target = spec.Target,
		IsTargetAlive = spec.IsTargetAlive,
		TurnRad = math.rad(math.clamp(tonumber(spec.TurnRateDeg) or 0, 0, 720)),
		Fuse = math.clamp(tonumber(spec.ProximityFuse) or 0, 0, 30),
		OnImpact = spec.OnImpact,
		Done = false,
		Steps = 0,
	}
	live[rec.Id] = rec
	liveTotal += 1
	liveBy[rec.OwnerUserId] = (liveBy[rec.OwnerUserId] or 0) + 1
	if not running then
		running = true
		task.spawn(runner)
	end
	return rec
end

-- drop an owner's rounds without an impact (player left)
function AirOrdnance.ForgetOwner(userId: number)
	for id, rec in pairs(live) do
		if rec.OwnerUserId == userId then
			rec.Done = true
			live[id] = nil
			liveTotal = math.max(0, liveTotal - 1)
		end
	end
	liveBy[userId] = nil
end

return AirOrdnance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">ArmyBrawl</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 43 (2026-10-01, Shaun's phone test: "my soldiers only shoot the enemy PLAYER; they ignore his soldiers
	and once he dies the fight stops"). ROOT CAUSE (static trace, pinned in tools/checks/claude_bud_job43.py):
	  * SquadOrdersService.nearestHostile scans CombatService NPCs only and SKIPS every model with an OwnerUserId
	    attribute: army soldiers carry OwnerUserId, so an enemy soldier is never a candidate;
	  * pickSquadTarget (ATTACK / SEND) adds NPCs + enemy PLAYERS + base guards; pickDefendTarget (FOLLOW / HOLD) adds
	    enemy PLAYERS only. Nothing ever adds an enemy soldier, so the candidate list empties when the player dies.
	FIX (ArmyConfig.ArmyBrawl, owner-first by the SHOOTING army's owner): enemy soldiers become candidates of their own
	("Unit"), under THE shared army rule (CombatService.ArmyHostility: PvP on, not self, not a clan ally, not novice /
	new-player protected) re-checked on every shot by CombatService.ApplyUnitUnitHit. Players still come first; the fight
	goes on against the soldiers after the player dies, until one side is wiped or out of reach. Real shots only (the
	squad's own LOS, hit chance and fire rate); nothing teleports or snaps.
	This module is pure (tests call it): the enemy-soldier candidates around a point, nearest first.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ArmyBrawl = {}

local function cfg(): any
	local okA, AC = pcall(function(): any
		return require(ReplicatedStorage:WaitForChild("Shared", 10).Configs.ArmyConfig)
	end)
	return if okA and AC then AC.ArmyBrawl else nil
end

function ArmyBrawl.Config(): any
	return cfg()
end

-- owner-first by the shooting army's owner (RetentionConfig.Live: Enabled + OwnerFirst)
function ArmyBrawl.LiveFor(userId: any): boolean
	local b = cfg()
	if typeof(b) ~= "table" then
		return false
	end
	local okR, RC = pcall(function(): any
		return require(ReplicatedStorage:WaitForChild("Shared", 10).Configs.RetentionConfig)
	end)
	return okR and RC ~= nil and RC.Live(b, userId) == true
end

export type Cand = { Hum: Humanoid, Root: BasePart, Model: Instance, Owner: Player, Dist: number }

--[[ The live enemy soldiers within `reach` (flat) of `centre`, nearest first, at most `cap`. squads = { [ownerUserId] =
	{ Units = { { Alive, Humanoid, Root, Model } } } } (SquadOrdersService's table); hostile(attacker, owner) -> (ok, why)
	is THE shared rule (CombatService.ArmyHostility). A squad whose owner is not in the server is skipped. ]]
function ArmyBrawl.Candidates(attacker: Player, squads: { [number]: any }, centre: Vector3, reach: number, hostile: (Player, Player) -> (boolean, string), cap: number?): { Cand }
	local out: { Cand } = {}
	for uid, st in pairs(squads) do
		if uid ~= attacker.UserId and typeof(st) == "table" and typeof(st.Units) == "table" then
			local owner = Players:GetPlayerByUserId(uid)
			if owner then
				local okH, may = pcall(function(): boolean
					local m = hostile(attacker, owner)
					return m == true
				end)
				if okH and may == true then
					for _, u in ipairs(st.Units) do
						local hum, root = u.Humanoid, u.Root
						if u.Alive and hum and root and root.Parent ~= nil and hum.Health > 0 then
							local p = root.Position
							local d = Vector3.new(p.X - centre.X, 0, p.Z - centre.Z).Magnitude
							if d <= reach then
								table.insert(out, { Hum = hum, Root = root, Model = u.Model, Owner = owner, Dist = d })
							end
						end
					end
				end
			end
		end
	end
	table.sort(out, function(a, b)
		return a.Dist < b.Dist
	end)
	local n = math.max(0, math.floor(tonumber(cap) or #out))
	while #out > n do
		table.remove(out)
	end
	return out
end

return ArmyBrawl
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">ArmyCommand</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot (army command bug, 2026-10-01; owner recording: "ATTACK says No enemies near; SEND -> Crossroads -> GO and the
	army stays beside me"). THE command path of a live ArmyOrders owner (ArmyOrdersConfig.LiveFor: OwnerFirst = the owner +
	Studio). Every army button lands here, on the server:
	  RequestSquadOrder Follow / Hold / Attack / Retreat / Recall  -> SquadOrdersService.SetOrder -> ArmyCommand.Order
	  RequestArmySend <target id>  (the map's ArmySend GO / SEND ARMY) -> ArmyCommand.Send
	Each command is validated (a rejection is a warn with its reason + a toast, and the state is pushed again so the
	Army UI shows the real state), then ONE transition through ArmyState.Set; ArmyPlan carries the movement of the plan
	states. The previous state always ends first (ArmyState: a non-plan state cancels the plan; a new plan replaces the
	old one). Transitions:
	  FOLLOW   near him -> Following; army away (> RecallFarStuds) or a plan running -> Recalling (march back) -> Following
	  RECALL   as FOLLOW (the explicit button)
	  HOLD     -> Holding where every unit stands now (a travel / fight stops at once; nothing marches back first)
	  RETREAT  army far from home (> RetreatPlanStuds) -> Retreating as a block (plan) -> the plain RETREAT; else plain
	  ATTACK   ProbeClear from the army (him while it is beside him), radius SeekRadius: a target -> Attacking (an
	           auto-clear plan; away from him it holds where it ends); none -> "No enemies near", the state is unchanged
	           (FOLLOW stays FOLLOW, a travelling army keeps travelling). An ATTACK already running is kept.
	  SEND     ArmyTargets.Resolve -> a base: ArmyPlan.StartSend (the fairness verdict); an area / site:
	           ArmyPlan.StartTravel -> TravellingToBase (from ANY state: Following, Holding, already Travelling)
	Not live (every other player): SquadOrdersService's own order path (unchanged), through ArmyState.Set as well.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArmyOrdersConfig = require(Shared.Configs.ArmyOrdersConfig) :: any
local ArmyLog = require(Shared.Util.ArmyLog)
local ArmyState = require(script.Parent.ArmyState)
local ArmyTargets = require(script.Parent.ArmyTargets)

local ArmyCommand = {}

local deps: { [string]: any } = {}

function ArmyCommand.Bind(d: { [string]: any })
	for k, v in pairs(d) do
		deps[k] = v
	end
end

function ArmyCommand.Live(player: Player): boolean
	return ArmyOrdersConfig.LiveFor(player.UserId) == true and deps.Plan ~= nil
end

local function flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function notify(player: Player, text: string, kind: string?)
	local ns = deps.NotificationService
	if ns and ns.Notify then
		pcall(ns.Notify, player, text, kind or "Info", 4)
	end
end

local function push(player: Player)
	if deps.Push then
		pcall(deps.Push, player)
	end
end

local function ownerPos(player: Player): Vector3?
	local r = if deps.OwnerRoot then deps.OwnerRoot(player) else nil
	return if r then r.Position else nil
end

-- a rejection: logged (warn + reason), told (toast), and the real state pushed again (the UI never shows a guess)
local function reject(player: Player, what: string, reason: string, text: string?, detail: string?): (boolean, string)
	ArmyLog.Reject(player, what, reason, (detail or "") .. " state=" .. ArmyState.Of(deps.StateOf and deps.StateOf(player)))
	if text then
		notify(player, text, "Warn")
	end
	push(player)
	return false, reason
end

-- the army is away from him (or he is dead): measured from the block centre
local function armyAway(player: Player, st: any): (boolean, Vector3?)
	local c = deps.Plan.BlockCentre(st)
	local o = ownerPos(player)
	if c == nil then
		return false, nil
	end
	if o == nil then
		return true, c
	end
	return flatDist(c, o) > (tonumber(ArmyOrdersConfig.RecallFarStuds) or 60), c
end

local function hasUnits(st: any): boolean
	return st ~= nil and deps.Plan.BlockCentre(st) ~= nil
end

--[[ RequestSquadOrder for a live owner. Returns (ok, reason). SquadOrdersService has checked the order name, the
	OrdersConfig flags, the soldier count and that a squad exists. ]]
function ArmyCommand.Order(player: Player, st: any, order: string, source: string?): (boolean, string?)
	local src = source or "order " .. order
	local Plan = deps.Plan
	local cur = Plan.Current(player.UserId)
	local from = ArmyState.Of(st)
	ArmyLog.Line(player, "SERVER ARMY", string.format("%s command=%s state=%s plan=%s source=%s", player.Name, order, from, if cur then cur.Kind .. "/" .. cur.Phase else "none", src))
	if order == "Follow" or order == "Recall" then
		local away = armyAway(player, st)
		if cur ~= nil and cur.Phase == "Return" and cur.ThenOrder == nil then
			return true, nil -- already marching back to him
		end
		if (cur ~= nil or away) and hasUnits(st) then
			-- the block marches back to him first (Recalling), then FOLLOW (ArmyPlan.finish)
			if Plan.Recall(player, nil, st) then
				return true, nil
			end
		end
		ArmyState.Set(player, st, "Following", src)
		return true, nil
	end
	if order == "Hold" then
		ArmyState.Set(player, st, "Holding", src) -- (cancels a plan: the army stops where it stands)
		return true, nil
	end
	if order == "Retreat" then
		local home = if deps.HomePos then deps.HomePos(player) else nil
		local c = Plan.BlockCentre(st)
		if home and c and flatDist(c, home) > (tonumber(ArmyOrdersConfig.RetreatPlanStuds) or 120) and source ~= "ArmyPlan.finish" then
			if Plan.StartRetreat(player, st, home) then
				return true, nil
			end
		end
		ArmyState.Set(player, st, "Retreating", src)
		return true, nil
	end
	if order == "Attack" then
		if cur ~= nil and cur.Kind == "Clear" and cur.Phase ~= "Return" then
			return true, nil -- ATTACK again keeps the running auto-clear
		end
		if not hasUnits(st) then
			return reject(player, "ATTACK", "NoSoldiers", "No soldiers in the field")
		end
		local away, centre = armyAway(player, st)
		local seekFrom = if away or cur ~= nil then centre else ownerPos(player)
		if seekFrom == nil then
			return reject(player, "ATTACK", "NoOwner", "Respawn first")
		end
		local t = Plan.ProbeClear(player, st, deps.Pick, seekFrom :: Vector3)
		if t == nil then
			local seekR = ArmyOrdersConfig.AttackRadii(player.UserId)
			if ArmyOrdersConfig.AttackRangeLive(player.UserId) and Plan.NearestBeyond then
				-- claude-bud JOB 52: say how far the nearest valid enemy is, and offer PIN / SEND to it (server ids only)
				local A: any = ArmyOrdersConfig.AttackRange
				local nt, nd, nid = Plan.NearestBeyond(player, st, deps.Pick, seekFrom :: Vector3)
				local text = A.Text.NoneAtAll
				if nt and nd and nt.Root then
					local p = nt.Root.Position
					text = string.format(A.Text.NoneInRange, math.floor(seekR * 0.28), math.floor(nd * 0.28),
						ArmyOrdersConfig.Compass8(p.X - (seekFrom :: Vector3).X, p.Z - (seekFrom :: Vector3).Z))
					if deps.PushFeature then
						pcall(deps.PushFeature, player, "ArmyNearest", { Text = text, X = p.X, Y = p.Y, Z = p.Z,
							Target = if nid then "N:" .. nid else nil })
					end
				end
				return reject(player, "ATTACK", "NoEnemiesNear", if nt then nil else text,
					string.format("from=%s radius=%d nearest=%s", ArmyLog.Vec(seekFrom), seekR, if nd then string.format("%.0f", nd) else "none"))
			end
			-- DECIDED: nothing to fight within SeekRadius: say so and keep the previous state (never a broken ATTACK)
			return reject(player, "ATTACK", "NoEnemiesNear", ArmyOrdersConfig.Text.NothingNear,
				string.format("from=%s radius=%d", ArmyLog.Vec(seekFrom), seekR))
		end
		if not Plan.StartClear(player, st, if away or cur ~= nil then seekFrom else nil, t) then
			return reject(player, "ATTACK", "StartFailed", "Order failed")
		end
		return true, nil
	end
	return reject(player, "order " .. tostring(order), "InvalidOrder", "Invalid squad order")
end

--[[ RequestArmySend (the map's ArmySend GO, a base card's SEND ARMY, the Intel Office): the target id only. ]]
function ArmyCommand.Send(player: Player, raw: any): (boolean, string?)
	if not ArmyCommand.Live(player) then
		return reject(player, "SEND " .. tostring(raw), "NotLive", nil)
	end
	local target, why = ArmyTargets.Resolve(raw)
	if target == nil then
		return reject(player, "SEND " .. tostring(raw), why or "BadTarget", "Pick a base or a zone on the map")
	end
	local st = deps.StateOf and deps.StateOf(player)
	if st == nil and deps.SyncArmy then
		pcall(deps.SyncArmy, player)
		st = deps.StateOf(player)
	end
	if not hasUnits(st) then
		return reject(player, "SEND " .. target.Key, "NoSoldiers", "No soldiers to send")
	end
	local from = ArmyState.Of(st)
	ArmyLog.Line(player, "SERVER ARMY", string.format("%s command=Send target=%s (%s) kind=%s state=%s", player.Name, target.Key, target.Name, target.Kind, from))
	if target.Kind == "Base" then
		local ok, text = deps.Plan.StartSend(player, target.PlotId :: number, st)
		if not ok then
			reject(player, "SEND " .. target.Key, "Verdict", text, "verdict=" .. tostring(text))
			if deps.PushVerdict then
				pcall(deps.PushVerdict, player, target.PlotId)
			end
			return false, text
		end
		push(player)
		pcall(function() -- claude-bud JOB 48: the Guided raid goal's RaidSent funnel step (only while that goal is open)
			(require(script.Parent.Parent.Services.GuidedService) :: any).OnRaidSent(player)
		end)
		return true, nil
	end
	local ok, text = deps.Plan.StartTravel(player, target, st)
	if not ok then
		return reject(player, "SEND " .. target.Key, tostring(text), "Order failed")
	end
	push(player)
	return true, nil
end

return ArmyCommand
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">ArmyController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v115 (Code Bot Roblox, 2026-09-29, docs/ARMY-FOLLOW-ROOTCAUSE-3.md): ArmyController — ONE authoritative movement
	controller per army (ArmyConfig.Follow3; Enabled false / Rollout off = the v113 ArmyFollow path).

	  * THE FORMATION FOLLOWS HIM, SOLDIERS FOLLOW SLOTS. FormationController.Plan: a breadcrumb trail of his path; a
	    block of rows BEHIND him on that trail (row r at FirstRowStuds + r x RowSpacing of path behind him), each row
	    square to his path there (per-row heading from the trail tangent = his movement direction, rate-limited,
	    deadband, hysteresis, only while he moves). Columns across (2..ColumnsMax), escorts in the rows directly behind
	    their unit. No side wings, nothing rotates round him, nothing orbits him. When he stops: nothing re-forms.
	  * State machine per army: FOLLOW / HOLD / ATTACK / RETREAT (= the squad order). Only FOLLOW is driven here.
	  * Slots: FormationController.Assign — PERMANENT per unit (FormationSlot attribute), only a death / removal /
	    roster change touches it (WARN logged). No distance, no nearest-slot, no pairs() ordering.
	  * Per unit: SoldierController.Drive (MoveTo on a moved target / max interval only, catch-up toward its OWN slot,
	    arrival deadzone, stuck fallback path, the logged emergency reposition).
	  * His own base (Follow2.Tidy hold): units wait at their gate cells (ArmyFollow.HoldSpot), never cross his plot.
	  * Debug (Follow3.Debug + the player's WE_ArmyDebug attribute; default on for DebugUserIds; /armydebug toggles):
	    WE_SlotPos per unit (his client draws the slot markers + labels: ArmyDebugClient, visible to him only), a
	    throttled per-soldier state log, WARN on every slot change and on every reposition (SoldierController).
	  * Collision audit every AuditSeconds: every part of every unit carries the ArmyNPCs group.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArmyConfig = require(Shared.Configs.ArmyConfig)
local AdminConfig = require(Shared.Configs.AdminConfig)
local FormationController = require(Shared.Util.FormationController)
local SoldierController = require(script.Parent.SoldierController)
local ArmyFollow = require(script.Parent.ArmyFollow)
local Enterables = require(script.Parent.Enterables) -- claude-bud JOB 32: owner indoors -> the army waits at the door

local ArmyController = {}
ArmyController.Stats = { Ticks = 0, Errors = 0, AuditFixes = 0, SlotChanges = 0 }

local deps: { [string]: any } = {}
local started = false
local errAt: { [number]: number } = {}

local function cfg(): { [string]: any }
	local c = (ArmyConfig :: any).Follow3
	return if typeof(c) == "table" then c else {}
end

-- claude-bud JOB 39: Follow3 with the spacing keys x `scale` (cached per scale; the same table while unchanged)
local scaledCache: { [number]: { [string]: any } } = {}
function ArmyController.ScaledCfg(c: { [string]: any }, scale: number): { [string]: any }
	local key = math.floor(scale * 100 + 0.5)
	local hit = scaledCache[key]
	if hit and hit.__src == c then
		return hit
	end
	local out = table.clone(c)
	for _, k in ipairs({ "FirstRowStuds", "RowSpacing", "ColSpacing", "AisleStuds", "LaneHalfStuds" }) do
		local v = c[k]
		if typeof(v) == "number" then
			out[k] = v * scale
		end
	end
	out.__src = c
	scaledCache[key] = out
	return out
end

local function num(key: string, default: number): number
	local v = cfg()[key]
	return if typeof(v) == "number" then v else default
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Follow3 live for this owner (and the Follow2 module it builds on)
function ArmyController.LiveFor(userId: any): boolean
	local c = cfg()
	if c.Enabled ~= true or not ArmyFollow.LiveFor(userId) then
		return false
	end
	if c.Rollout == "all" then
		return true
	end
	if c.Rollout == "owner" then
		return AdminConfig.IsPlaytestOwner(userId) == true
	end
	return false
end

-- JOB 24 (claude-bud, docs/ARMY-ATTACK-ROOTCAUSE.md): ATTACK is driven here too, by the same steered block
-- (Follow3.Steer + Follow3.AttackSteer; false = the v116 SquadOrdersService.attackUnit movement)
-- claude-bud JOB 38: set by ArmyPlan.Init: (player) -> { Root = a stand-in root at the plan's lead point } | nil
ArmyController.PlanLead = nil :: ((Player) -> any)?

--[[ Code Bot v165: a SEND raid's broken gate. A unit whose goal is on the other side of the plot walls (in -> out or
	out -> in) is sent to the gate mouth on its own side, then through the lane to a point past the gate, then on to its
	slot: no unit presses into the wall beside the gate (f = ArmyPlan's { Gate, Out, Lane, Centre, Half }). ]]
function ArmyController.Funnel(f: any, upos: Vector3, goal: Vector3): Vector3
	local c, h = f.Centre, f.Half
	local function inside(p: Vector3): boolean
		return math.abs(p.X - c.X) <= h and math.abs(p.Z - c.Z) <= h
	end
	local uIn, gIn = inside(upos), inside(goal)
	if uIn == gIn then
		return goal
	end
	local out: Vector3 = f.Out
	local side = Vector3.new(-out.Z, 0, out.X)
	local rel = Vector3.new(upos.X - f.Gate.X, 0, upos.Z - f.Gate.Z)
	local along, lat = rel:Dot(out), rel:Dot(side)
	local y = goal.Y
	if math.abs(lat) <= f.Lane and math.abs(along) <= 10 then
		local p = f.Gate + out * (if gIn then -12 else 12) -- in the lane: through it
		return Vector3.new(p.X, y, p.Z)
	end
	local p = f.Gate + out * (if uIn then -8 else 8) -- the mouth on his own side
	return Vector3.new(p.X, y, p.Z)
end

-- Code Bot v145: how far behind its leader (the owner, or an ArmyPlan lead point) the steered block holds its CENTRE by
-- design: FirstRowStuds + its half depth, and never nearer than its radius + BubbleStuds (FormationController.SteerFrames).
-- 0 before the block has formed. ArmyPlan measures "the block is behind" from here, not from the lead itself.
function ArmyController.Standoff(st: any): number
	local a = if typeof(st) == "table" then st._ac else nil
	local f = if typeof(a) == "table" and typeof(a.F) == "table" then a.F.Form else nil
	if typeof(f) ~= "table" then
		return 0
	end
	return math.max(num("FirstRowStuds", 7) + (tonumber(f.HalfDepth) or 0), (tonumber(f.Radius) or 0) + num("BubbleStuds", 3))
end

function ArmyController.AttackLive(userId: any): boolean
	local c = cfg()
	return ArmyController.LiveFor(userId) and c.Steer == true and c.AttackSteer == true
end

-- debug overlay / logs on for this player: his WE_ArmyDebug attribute (/armydebug toggles it; admin allowlist) --
-- JOB 24: off by default for EVERYONE (Follow3.Debug = false no longer switches it on by itself; with Debug true it
-- still defaults on for DebugUserIds). Otherwise only a DebugUserIds player who typed /armydebug sees it.
local function isDebugUserId(userId: number): boolean
	local ids = cfg().DebugUserIds
	if typeof(ids) == "table" then
		for _, id in ipairs(ids) do
			if id == userId then
				return true
			end
		end
	end
	return false
end

function ArmyController.DebugFor(player: Player): boolean
	return player:GetAttribute("WE_ArmyDebug") == true and (cfg().Debug == true or isDebugUserId(player.UserId))
end

local isDebugUser = isDebugUserId

local STATE_OF: { [string]: string } = { Follow = "FOLLOW", Hold = "HOLD", Attack = "ATTACK", Retreat = "RETREAT" }

local function army(st: any): any
	local a = st._ac
	if a == nil then
		a = {
			State = nil,
			F = FormationController.NewArmy(), -- trail + permanent assignment + per-slot velocity
			LastPos = nil,
			LastAt = nil,
			AuditAt = -math.huge,
			LayoutKey = nil,
			LogAt = -math.huge,
		}
		a.Assign = a.F.Assign
		st._ac = a
	end
	return a
end

-- the slot index of a unit (assigned permanently on first sight)
function ArmyController.SlotOf(st: any, unit: any): number
	local a = army(st)
	local idx = a.Assign.ByUnit[unit]
	if idx == nil then
		FormationController.Assign(a.Assign, st.Units)
		idx = a.Assign.ByUnit[unit]
	end
	return idx or tonumber(unit.Slot) or 1
end

-- spawn offset (owner frame: x = right, z = behind) of a new unit with SquadSlot `slot`: in the block behind him
function ArmyController.SpawnOffset(slot: number): Vector3
	return FormationController.SpawnOffset(slot, cfg())
end

-- escort figures a unit shows (the client draws them in the rows directly behind it)
local function escOf(u: any): number
	local m = u.Model
	if m == nil then
		return 0
	end
	return math.max(0, math.floor(tonumber(m:GetAttribute("WE_Escorts")) or 0))
end

local function unitName(u: any): string
	return string.format("S%02d", tonumber(u.Slot) or 0)
end

-- per unit, on change only (attributes replicate): FormationSlot / WE_FormSlot (its permanent slot), WE_FormYaw (its
-- row's heading, past YawPublishDeg), WE_FormRow / WE_FormX (its cell), and in debug WE_SlotPos (its world slot)
local function publish(player: Player, st: any, a: any, plans: { [any]: any }, debugOn: boolean)
	local yawStep = num("YawPublishDeg", 3)
	local posStep = num("DebugPublishStuds", 0.5)
	for _, u in ipairs(st.Units) do
		local m = u.Model
		if u.Alive and m and m.Parent then
			local idx = a.Assign.ByUnit[u]
			if idx and u._acIdx ~= idx then
				local old = u._acIdx
				u._acIdx = idx
				pcall(function()
					m:SetAttribute("FormationSlot", idx)
					m:SetAttribute("WE_FormSlot", idx)
				end)
				-- v147: debug output only for a player with the army debug on (ArmyController.DebugFor); the live error
				-- report counted these SLOT CHANGE warns for every normal player (a normal roster change, not a fault)
				if old == nil then
					if debugOn then
						print(string.format("[ArmyDebug] SLOT ASSIGN %s %s -> slot %d (first assignment)", player.Name, unitName(u), idx))
					end
				else
					ArmyController.Stats.SlotChanges += 1
					if debugOn then
						warn(string.format("[ArmyDebug] SLOT CHANGE %s %s %d -> %d reason=roster change (death / removal / new unit)",
							player.Name, unitName(u), old, idx))
					end
				end
			end
			local p = plans[u]
			if p then
				local yaw = math.floor(FormationController.YawDeg(p.Heading) + 0.5)
				if u._acYaw == nil or math.abs(((yaw - u._acYaw + 180) % 360) - 180) >= yawStep then
					u._acYaw = yaw
					pcall(function()
						m:SetAttribute("WE_FormYaw", yaw)
					end)
				end
				if u._acRow ~= p.Row then
					u._acRow = p.Row
					pcall(function()
						m:SetAttribute("WE_FormRow", p.Row)
					end)
				end
				if debugOn then
					if u._acMode ~= u._scState then
						u._acMode = u._scState
						pcall(function()
							m:SetAttribute("WE_MoveState", u._scState)
						end)
					end
					local sp: Vector3 = p.Goal
					if u._acSlotPos == nil or flatDist(u._acSlotPos, sp) >= posStep then
						u._acSlotPos = sp
						pcall(function()
							m:SetAttribute("WE_SlotPos", sp)
						end)
					end
				end
			end
			if not debugOn and (u._acSlotPos ~= nil or u._acMode ~= nil) then
				u._acSlotPos = nil
				u._acMode = nil
				pcall(function()
					m:SetAttribute("WE_SlotPos", nil)
					m:SetAttribute("WE_MoveState", nil)
				end)
			end
		end
	end
end

-- every part of every unit in the ArmyNPCs group (late rig parts / accessories included)
local function audit(st: any, a: any, now: number)
	if now - a.AuditAt < num("AuditSeconds", 5) then
		return
	end
	a.AuditAt = now
	local group = ArmyFollow.Group
	for _, u in ipairs(st.Units) do
		if u.Model and u.Model.Parent then
			for _, d in ipairs(u.Model:GetDescendants()) do
				if d:IsA("BasePart") and d.CollisionGroup ~= group then
					d.CollisionGroup = group
					ArmyController.Stats.AuditFixes += 1
				end
			end
		end
	end
end

-- a unit position the owner cannot see: behind him (past his shoulder line) or with the view line blocked
local function outOfView(ownerRoot: BasePart, p: Vector3): boolean
	local look = flat(ownerRoot.CFrame.LookVector)
	local off = flat(p - ownerRoot.Position)
	if off.Magnitude > 1e-3 and look.Magnitude > 1e-3 and off.Unit:Dot(look.Unit) < -0.2 then
		return true
	end
	return not ArmyFollow.ClearLine(ownerRoot.Position + Vector3.new(0, 1.5, 0), p)
end

-- the emergency reposition spot: its own slot pushed RepositionBehindStuds further back along its row's heading
-- (behind the phone camera), then half that, then the slot; on the ground, with a clear line from him, never near him
local function repositionSpot(ownerRoot: BasePart, slot: Vector3, heading: Vector3): CFrame?
	local dir: Vector3 = if heading.Magnitude > 1e-3 then heading.Unit else Vector3.new(0, 0, -1)
	local y = ownerRoot.Position.Y
	slot = Vector3.new(slot.X, y, slot.Z)
	local behind = num("RepositionBehindStuds", 16)
	ArmyFollow.RefreshRayFilter(nil)
	for _, c in ipairs({ slot - dir * behind, slot - dir * behind * 0.5, slot }) do
		local g = ArmyFollow.GroundAt(c, y)
		if g and flatDist(g, ownerRoot.Position) >= num("RepositionMinOwnerStuds", 8) and math.abs(g.Y - y) < 14
			and ArmyFollow.ClearLine(ownerRoot.Position, g + Vector3.new(0, 1.8, 0)) then
			local p = g + Vector3.new(0, 3.2, 0)
			return CFrame.lookAt(p, p + dir)
		end
	end
	return nil
end

-- the throttled per-soldier debug line (DebugLogSeconds): id, slot, position, target, distance, WalkSpeed, mode,
-- time since its last MoveTo, catch-up, recovery stage, pathfinding, stuck timer
local function debugLog(player: Player, a: any, living: { any }, plans: { [any]: any }, ownerPos: Vector3, now: number)
	if now - a.LogAt < num("DebugLogSeconds", 2) then
		return
	end
	a.LogAt = now
	for _, u in ipairs(living) do
		local p = plans[u]
		local pos: Vector3 = u.Root.Position
		local goal: Vector3? = if p then p.Goal else nil
		local lastMove = u._scLastMoveAt
		print(string.format(
			"[ArmyDebug] %s %s slot=%s row=%s pos=(%.1f,%.1f) target=%s dist=%s toPlayer=%.1f ws=%.1f mode=%s sinceMoveTo=%s catchUp=%s recovery=%s path=%s stuck=%.1f",
			player.Name, unitName(u), tostring(a.Assign.ByUnit[u]), tostring(p and p.Row), pos.X, pos.Z,
			if goal then string.format("(%.1f,%.1f)", goal.X, goal.Z) else "-",
			if goal then string.format("%.1f", flatDist(pos, goal)) else "-", flatDist(pos, ownerPos),
			u.Humanoid.WalkSpeed, tostring(u._scState), if lastMove then string.format("%.1f", now - lastMove) else "-",
			tostring(u._scState == "CatchingUp"), tostring(u._scStage or 0), tostring(u._scPath ~= nil),
			if u._scState == "InPosition" then 0 else now - (u._scProgAt or now)))
	end
end

-- claude-bud JOB 23: the owner's formation panel (the WE_ArmyPanel player attribute his ArmyDebugClient shows, every
-- DebugPanelSeconds) and the SPIKE log (a soldier past SpikeErrStuds from its slot, or a slot faster than a soldier can
-- run), both only in debug. Player / desired / actual heading: his facing (display only) / his movement direction
-- (the formation steers to it) / the formation's own heading.
local function yawOf(v: Vector3?): string
	if v == nil or v.Magnitude < 1e-3 then
		return "-"
	end
	return string.format("%.0f", FormationController.YawDeg(v))
end

local function formationDebug(player: Player, a: any, living: { any }, plans: { [any]: any }, proot: BasePart, now: number)
	local f = a.F.Form
	local trail = a.F.Trail
	local mxE, sumE, nC, mxV, worst = 0, 0, 0, 0, nil
	for _, u in ipairs(living) do
		local p = plans[u]
		if p then
			local d = flatDist(u.Root.Position, p.Goal)
			sumE += d
			if d > mxE then
				mxE = d
				worst = u
			end
			if u._scState == "CatchingUp" then
				nC += 1
			end
			mxV = math.max(mxV, tonumber(p.SlotSpeed) or 0)
		end
	end
	local n = math.max(1, #living)
	local spd = if f then f.V.Magnitude else trail.Vel.Magnitude
	local turn = if f then math.deg(math.abs(f.W)) else 0
	local herr = if f then math.deg(math.abs(f.Err)) else 0
	local cap = math.min(num("MaxSpeed", 40), math.max(trail.Vel.Magnitude, 14) + num("SpeedMaxBonus", 14))
	if now - (a.PanelAt or -math.huge) >= num("DebugPanelSeconds", 0.5) then
		a.PanelAt = now
		pcall(function()
			player:SetAttribute("WE_ArmyPanel", string.format(
				"Formation %.1f  Turn %.0f/s\nHeading err %.0f\nPlayer %s  Want %s  Is %s\nMax slot speed %.1f\nSlot err avg %.1f  max %.1f\nCatching up %d/%d",
				spd, turn, herr, yawOf(flat(proot.CFrame.LookVector)), yawOf(if f then f.Hd else trail.Vel), yawOf(if f then f.H else nil),
				mxV, sumE / n, mxE, nC, #living))
		end)
	end
	if (mxE > num("SpikeErrStuds", 6) or mxV > cap) and now - (a.SpikeAt or -math.huge) >= 0.5 then
		a.SpikeAt = now
		print(string.format("[ArmyDebug] SPIKE %s maxErr=%.1f (%s) maxSlotV=%.1f cap=%.1f catching=%d/%d formSpd=%.1f turn=%.0f/s hdgErr=%.0f player=%s desired=%s actual=%s waiting=%s",
			player.Name, mxE, if worst then unitName(worst) else "-", mxV, cap, nC, #living, spd, turn, herr, yawOf(flat(proot.CFrame.LookVector)),
			yawOf(if f then f.Hd else trail.Vel), yawOf(if f then f.H else nil), tostring(f ~= nil and f.Waiting == true)))
	end
end

local function stepArmy(player: Player, st: any, now: number)
	local a = army(st)
	local state = STATE_OF[st.Order] or "FOLLOW"
	local living: { any } = {}
	for _, u in ipairs(st.Units) do
		if u.Alive and u.Humanoid and u.Humanoid.Health > 0 and u.Root and u.Root.Parent then
			table.insert(living, u)
		end
	end
	-- permanent slots (only a roster change touches the table; survivors never move)
	FormationController.Assign(a.Assign, living)
	-- a unit that left the roster (death / dismiss / despawn) frees its slot: logged, nobody else moves
	a.Known = a.Known or {}
	for u, idx in pairs(a.Known) do
		if a.Assign.ByUnit[u] == nil then
			a.Known[u] = nil
			u._acIdx = nil
			ArmyController.Stats.SlotChanges += 1
			warn(string.format("[ArmyDebug] SLOT CHANGE %s %s %d -> none reason=%s", player.Name, unitName(u), idx,
				if u.Alive == false then "death" else "removed"))
		end
	end
	for _, u in ipairs(living) do
		a.Known[u] = a.Assign.ByUnit[u]
	end
	audit(st, a, now)
	local prevState = a.State
	a.State = state
	local debugOn = ArmyController.DebugFor(player)
	-- JOB 24: ATTACK is steered here as well (the block advances on the squad target, deploys, folds back); the
	-- squad target is SquadOrdersService's (st._acTarget, server-side NPC roots only; it only shoots and aims)
	local attackOn = state == "ATTACK" and ArmyController.AttackLive(player.UserId)
	local wasDriven = a.Driven == true
	if state ~= "FOLLOW" and not attackOn then
		-- HOLD / RETREAT (and ATTACK with AttackSteer off): SquadOrdersService issues their goals (through
		-- SoldierController); nothing here
		a.LastPos = nil
		a.Driven = false
		a.F.Attack = nil
		publish(player, st, a, {}, false)
		return
	end
	local root: BasePart? = deps.CharacterRoot and deps.CharacterRoot(player)
	-- claude-bud JOB 38: an army plan (ArmyPlan: ATTACK auto-clear / SEND / RECALL) walks a LEAD POINT; the block follows
	-- it exactly as it follows him (the same Plan / steering / caps), even while he is dead. No recover / reposition.
	local planLead: any = if ArmyController.PlanLead ~= nil then ArmyController.PlanLead(player) else nil
	if planLead ~= nil then
		root = planLead.Root :: any
	end
	if root == nil then
		-- the owner is dead: stop once, wait
		for _, u in ipairs(living) do
			if u._acIdle ~= true then
				u._acIdle = true
				SoldierController.Stop(u, "Hold")
			end
		end
		a.LastPos = nil
		return
	end
	local proot = root :: BasePart
	local pos = proot.Position
	local dt = if a.LastAt then math.clamp(now - a.LastAt, 0.01, 1) else num("UpdateSeconds", 0.2)
	local vel = Vector3.zero
	local jumped = false
	local fresh = a.LastPos == nil -- first tick after a gap (respawn, order change): the trail restarts behind him
	local hum = proot.Parent and proot.Parent:FindFirstChildOfClass("Humanoid")
	local seated = hum ~= nil and (hum.Sit or hum.SeatPart ~= nil)
	if a.LastPos then
		vel = flat(pos - a.LastPos) / dt
		if not seated and vel.Magnitude > num("OwnerJumpSpeed", 80) then
			jumped = true -- a teleport / respawn: the trail restarts (no sweep across the map)
			vel = Vector3.zero
		end
	end
	a.LastPos = pos
	a.LastAt = now
	-- his root's velocity NOW (the lane his next second of walking sweeps: rows he walks back into part)
	local ownerVelNow = flat(proot.AssemblyLinearVelocity)
	if jumped or seated then
		ownerVelNow = vel
	end
	-- claude-bud JOB 32: inside / on top of an enterable building -> plan round the street point outside its door,
	-- facing the building (the block forms behind that point, out in the street); no speed, so nothing snaps or recovers
	local lookVec = proot.CFrame.LookVector
	local indoorCfg: any = (ArmyConfig :: any).Indoors
	local held = if typeof(indoorCfg) == "table" and indoorCfg.Enabled == true then Enterables.At(pos) else nil
	if held then
		pos = Vector3.new(held.Door.X, held.Door.Y + 3, held.Door.Z) -- street level (a root is ~3 above the ground)
		lookVec = held.Face
		vel = Vector3.zero
		ownerVelNow = Vector3.zero
		if a.HeldAt ~= held.Id then
			a.HeldAt = held.Id
			if debugOn then
				warn(string.format("[ArmyDebug] %s is inside %s: the army holds at its door", player.Name, held.Id))
			end
		end
	elseif a.HeldAt ~= nil then
		a.HeldAt = nil
	end
	-- (FOLLOW <-> ATTACK keeps the block: no restart; only a spell under HOLD / RETREAT restarts it behind him)
	local snap = jumped or fresh or prevState ~= "FOLLOW" and not (wasDriven and (prevState == "ATTACK" or prevState == "FOLLOW"))
	a.Driven = true
	local c = cfg()
	-- claude-bud JOB 39: trained soldiers are bigger: rows / columns / the aisle grow with the largest scale in the block
	local es = 1
	for _, u in ipairs(living) do
		local s = u.Model:GetAttribute("WE_EliteScale")
		if typeof(s) == "number" and s > es then
			es = s
		end
	end
	if es > 1 then
		c = ArmyController.ScaledCfg(c, es)
	end
	local tgt = if attackOn then st._acTarget else nil
	local troot: BasePart? = if tgt then tgt.Root else nil
	a.F.Attack = if troot and troot.Parent then { Pos = troot.Position } else nil
	local plans: any, _frames: any, cols: any, last: any
	if held then
		-- claude-bud JOB 32: held at a door: the block faces the building from the street
		plans, _frames, cols, last = FormationController.Plan(a.F, living, pos, lookVec, vel, dt, snap, escOf, c, ownerVelNow)
	else
		plans, _frames, cols, last = FormationController.Plan(a.F, living, pos, proot.CFrame.LookVector, vel, dt, snap, escOf, c, ownerVelNow)
	end
	local key = tostring(cols) .. "x" .. tostring(last + 1)
	if a.LayoutKey ~= nil and a.LayoutKey ~= key then
		warn(string.format("[ArmyDebug] LAYOUT CHANGE %s %s -> %s (columns x rows; roster / escort count changed)", player.Name, a.LayoutKey, key))
	end
	a.LayoutKey = key
	publish(player, st, a, plans, debugOn)
	local trail = a.F.Trail
	local inBase, plotId = ArmyFollow.BaseState(st, player, pos, now)
	local tidy = st._afTidy == true
	local ownPlot: number? = if tidy then st._afOwnPlot else nil
	local walkBack = tidy and not inBase and now - (st._afLeftBaseAt or -math.huge) < 8
	local speedSmooth = trail.Vel.Magnitude
	local drivingFast = seated and speedSmooth > num("VehicleDeferSpeed", 20)
	local base = tonumber((deps.UnitWalkSpeed or function()
		return 14
	end)()) or 14
	for _, u in ipairs(living) do
		u._acIdle = false
		local idx = a.Assign.ByUnit[u] or 1
		local p = plans[u]
		local goal: Vector3 = if p then p.Goal else pos
		local heading: Vector3 = if p then p.Heading else flat(proot.CFrame.LookVector)
		local moving = FormationController.BlockMoving(a.F, c) -- (his walk, or an ATTACK block advancing / deploying)
		-- its pace = its OWN slot's speed (a row rounding a corner outside moves faster than him, inside slower)
		local pace = if p then p.Pace else 0
		if seated then
			pace = math.max(16, math.min(math.max(pace, speedSmooth), num("CatchUpMin", 30)))
		end
		local lead = if p and (moving or c.Steer == true) then p.Lead else Vector3.zero
		local allow = not drivingFast and not walkBack and planLead == nil -- claude-bud JOB 38: never during a plan
		local noPath = false
		local clear = num("OwnerClearStuds", 5)
		local upos = u.Root.Position
		local vel0 = ownerVelNow
		if inBase and plotId and a.F.Attack == nil then
			-- his base: its gate cell (straight, never through his plot), standing facing out
			local cell, out = ArmyFollow.HoldSpot(plotId, idx)
			goal = Vector3.new(cell.X, pos.Y, cell.Z)
			heading = out
			moving = false
			lead = Vector3.zero
			clear = 0
			vel0 = Vector3.zero
			if not ArmyFollow.InPlot(plotId, upos, 0) then
				goal = ArmyFollow.HoldVia(plotId, upos, goal)
				noPath = true
				allow = false
			end
		elseif ownPlot and not ArmyFollow.InPlot(ownPlot, upos, 0) and ArmyFollow.InPlot(ownPlot, goal, 2) then
			-- a unit outside his plot never gets a goal inside it
			local cell = ArmyFollow.HoldSpot(ownPlot, idx)
			goal = Vector3.new(cell.X, pos.Y, cell.Z)
		end
		if planLead ~= nil and planLead.Funnel ~= nil then
			goal = ArmyController.Funnel(planLead.Funnel, upos, goal)
		end
		local g, h = goal, heading
		local okU, errU = pcall(SoldierController.Drive, u, {
			Goal = goal,
			Heading = heading,
			Lead = lead,
			OwnerPos = pos,
			OwnerVel = vel0,
			OwnerMoving = moving,
			Pace = pace,
			BaseSpeed = base,
			Dt = dt,
			Now = now,
			AllowRecover = allow,
			Jumped = jumped,
			NoPath = noPath,
			NoReposition = planLead ~= nil, -- claude-bud JOB 38: a plan's unit that cannot follow is marked LOST, never moved
			OwnerClear = clear,
			Spot = function()
				return repositionSpot(proot, g, h)
			end,
			OutOfView = function(q: Vector3): boolean
				return outOfView(proot, q)
			end,
		})
		if not okU then
			-- one unit's error never stops the rest of the army (logged by the caller's rate limit)
			ArmyController.Stats.Errors += 1
			if now - (errAt[-player.UserId] or -math.huge) > 30 then
				errAt[-player.UserId] = now
				warn("[ArmyController] unit tick error for " .. tostring(player.UserId) .. ": " .. tostring(errU))
			end
		end
	end
	if debugOn then
		debugLog(player, a, living, plans, pos, now)
		formationDebug(player, a, living, plans, proot, now)
		a.PanelOn = true
	elseif a.PanelOn then
		a.PanelOn = nil
		pcall(function()
			player:SetAttribute("WE_ArmyPanel", nil)
		end)
	end
end
ArmyController._StepArmy = stepArmy

-- deps: Squads() -> { [userId]: st }, CharacterRoot(player) -> BasePart?, UnitWalkSpeed() -> number
function ArmyController.Start(d: { [string]: any })
	deps = d
	SoldierController.Bind({ ClearLine = ArmyFollow.ClearLine })
	if started then
		return
	end
	started = true
	task.spawn(function()
		while true do
			task.wait(math.clamp(num("UpdateSeconds", 0.2), 0.1, 0.5))
			local now = os.clock()
			local squads = deps.Squads and deps.Squads() or {}
			for _, player in ipairs(Players:GetPlayers()) do
				local st = squads[player.UserId]
				if st and #st.Units > 0 and ArmyController.LiveFor(player.UserId) then
					local ok, err = pcall(stepArmy, player, st, now)
					ArmyController.Stats.Ticks += 1
					if not ok then
						ArmyController.Stats.Errors += 1
						if now - (errAt[player.UserId] or -math.huge) > 30 then
							errAt[player.UserId] = now
							warn("[ArmyController] tick error for " .. tostring(player.UserId) .. ": " .. tostring(err))
						end
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		errAt[p.UserId] = nil
		errAt[-p.UserId] = nil
	end)
	-- debug overlay default ON for Follow3.DebugUserIds (the owner); /armydebug (AdminService) toggles WE_ArmyDebug
	local function debugDefault(p: Player)
		if cfg().Debug == true and isDebugUser(p.UserId) and p:GetAttribute("WE_ArmyDebug") == nil then
			p:SetAttribute("WE_ArmyDebug", true)
		end
	end
	Players.PlayerAdded:Connect(debugDefault)
	for _, p in ipairs(Players:GetPlayers()) do
		debugDefault(p)
	end
	print("[ArmyController] v115 Follow3 TrailBlock controller started (" .. tostring(cfg().Enabled) .. ", " .. tostring(cfg().Rollout) .. ", debug " .. tostring(cfg().Debug) .. ")")
end

return ArmyController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">ArmyFollow</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v91 (Code Bot, owner 2026-09-28: "the army still despawns while I run; they glitch, walk into each other, then
	despawn; soldiers must not follow me inside my base"). Server-authoritative FOLLOW movement for the squad units of
	SquadOrdersService (ArmyConfig.Follow2; Rollout "all" / "owner" / "off"). SquadOrdersService keeps the unit
	lifecycle and the shooting; this module only decides where each FOLLOW unit walks, how fast, and when one is moved.

	What was wrong before (read from the code, see LATEST-HANDOFF v91):
	  * Units collided with each other (each HumanoidRootPart CanCollide, all in the Default group): at a run they
	    shoved one another, tripped (FallingDown / Ragdoll states) and were flung. A unit flung under the map lost its
	    HumanoidRootPart to FallenPartsDestroyHeight; for everyone except the owner (Rollout.Fix) that unit then stayed
	    in the squad forever as an invisible ghost (SyncArmy only culls a dead or parentless model), so it looked
	    despawned and never came back.
	  * Every unit re-aimed at a slot beside the player each think with no separation, so neighbours chased the same
	    spot when the player turned; the catch-up cap (28, or the owner's WalkSpeed x 1.8) was not always faster
	    than a boosted sprint; recover teleports were owner-only and needed 4 s far + cooldowns.

	What this does (every think, per squad):
	  1. Formation: a wedge behind the player (rank k: back WedgeBack + row x RowBack, side +-(WedgeSide + row x
	     RowSide)), turned by the player's move direction (his facing while he stands, re-aimed only past
	     FacingTurnDeg: no swirl when he turns on the spot). Each unit has its own slot (rank by SquadSlot).
	  2. Separation: a unit within SeparationStuds of another steers apart (added to its goal); units never collide
	     with each other (CollisionGroup "WE_Squad" does not collide with itself); trip / ragdoll states are off.
	  3. Movement: Humanoid:MoveTo straight to the slot while a ray sees it; only when the ray is blocked a path
	     (PathfindingService), computed at most once per PathCooldown per unit and PathBudgetPerSecond per server,
	     kept while its end stays within PathKeepStuds of the slot (hysteresis); a MoveTo is re-issued only when the
	     goal moved ReissueStuds or ReissueSeconds passed (no jitter).
	  4. Catch-up: the unit's speed is the owner's WalkSpeed (Speed Pass / Boost included) or his measured speed,
	     whichever is higher, x MatchMult in its slot, and x CatchUpMult (+ CatchUpPerStud per stud behind) up to
	     max(owner x CatchUpMaxMult, CatchUpMin) when behind: always faster than his sprint. Past FarStuds (FarSeconds),
	     stuck (StuckSeconds with less than StuckStuds moved), under the map (VoidBelowOwner / FallenPartsDestroyHeight
	     margin) or after the owner jumped (teleport / respawn): ONE PivotTo of the same unit to a clear spot behind
	     him (ground ray + a clear line from him: never inside a wall). Never deleted.
	  5. Own base: while the owner is inside his own plot square (BaseService owner, plot bounds with BaseInStuds /
	     BaseOutStuds hysteresis) his units wait spread out just outside his main gate (plot-local z = PlotSize / 2 +
	     BaseWaitOut, x beside the gate lane, never in it), and fall back into the wedge when he comes out.
	Every regroup and every unit removal is logged (rate-limited) with its reason.

	v99 (Code Bot, owner 2026-09-29: "they fall far behind, vanish, reappear, the whole group suddenly catches up, they
	bunch into a blob; worst when sprinting / round buildings"). Root causes found in this module + SquadOrdersService:
	  * TWO controllers on one Humanoid: the escort fight (SquadOrdersService.escortUnit) moves a unit with its own
	    MoveTo while ArmyFollow sleeps, but ArmyFollow's throttle / stuck / far bookkeeping stayed from before the
	    fight: after it, the stale goal was never re-sent (the unit stood still up to ReissueSeconds) and the stale
	    stuck window (3 s old) fired at once = a TELEPORT back into the wedge (the snap-back). Same after HOLD /
	    ATTACK / RETREAT, the owner's death or a vehicle ride. Now: ONE owner per unit. ArmyFollow.Release(unit)
	    whenever another controller takes it; a think gap > ThinkGapReset re-acquires with fresh state.
	  * The yaw had two owners too: Humanoid.AutoRotate against the NPCFaceGyro that stayed at its spawn / last shot
	    yaw. The unit (and its client escort file, a rigid 7-12 stud arm, RigConfig.Escort.Offsets) swung about =
	    the blob / overlap on turns. Now ArmyFollow drives the gyro (AutoRotate off while it controls the unit).
	  * Blocked line (round buildings): every unit waiting for its path walked to ONE shared point (4 studs behind
	    the owner) = the blob; a path was dropped as soon as its end was 8 studs off the slot (every think at a
	    run) and a waypoint passed between thinks was walked back to. Now each unit walks to its own point, a path
	    is kept PathKeepSeconds / PathKeepStuds, passed waypoints are skipped.
	  * Formation direction snapped to the raw velocity every think (a sharp turn swung the whole wedge 180 degrees
	    at once). Now slots are the player's root CFrame (facing) turned at most TurnRateDeg per second,
	    CFrame:PointToWorldSpace of each unit's own offset.
	  * Slots: rank = index for non-Tidy owners (a death re-ranked everyone). Now every squad keeps persistent
	    unique seats; they are compacted only after the army size changed (SeatCompactSeconds).
	  * Regroup was quick (FarStuds 70 from the slot for 1 s; stuck 3 s) and landed IN the slot, 7 studs behind
	    him, in the phone camera's view. Now: far = FarStuds 100 for FarSeconds 3; stuck is staged (repath at
	    StuckSeconds, an alternate point at StuckAltSeconds, the reposition only at StuckTeleportSeconds); the spot
	    is its own slot pushed RegroupBehindStuds further back (behind the camera), never within
	    RegroupMinOwnerStuds of him. A seated owner (vehicle) is never an "owner jump".
	  * Speed stepped from x1.08 to x1.35 at CatchUpStartStuds (a lurch); now it ramps over CatchUpRampStuds and
	    changes at most SpeedUpPerThink / SpeedDownPerThink per think.
	  * Collision group "ArmyNPCs" (was WE_Squad, set on the first FOLLOW think only): registered at Init, set at
	    spawn for every order; never collides with itself, still collides with Default (world, players).
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArmyConfig = require(Shared.Configs.ArmyConfig)
local FormationMath = require(Shared.Util.FormationMath) -- claude-bud JOB 22: the stable formation maths
local SoldierController = require(script.Parent.SoldierController) -- v114: the one writer of a soldier's movement
local AdminConfig = require(Shared.Configs.AdminConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)
local PlotFrame = require(Shared.Util.PlotFrame)

local ArmyFollow = {}

ArmyFollow.Group = "ArmyNPCs" -- v99: the army NPC group (was WE_Squad); set at spawn for every unit

local deps: { [string]: any } = {}
local groupReady = false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
rayParams.RespectCanCollide = true -- the water sheets and decor are see-through for the rays
local pathBudget = { At = 0, N = 0 }
local logAt: { [string]: number } = {}
ArmyFollow.Stats = { Regroup = 0, Paths = 0, Removed = 0, Died = 0, Void = 0 }

local function cfg(): { [string]: any }
	local c = (ArmyConfig :: any).Follow2
	return if typeof(c) == "table" then c else {}
end

local function num(key: string, default: number): number
	local v = cfg()[key]
	return if typeof(v) == "number" then v else default
end

function ArmyFollow.Bind(d: { [string]: any })
	deps = d
end

-- Rollout: "all" = everyone, "owner" = the playtest owner only, anything else = nobody (the old follow code runs)
function ArmyFollow.LiveFor(userId: any): boolean
	local c = cfg()
	if c.Enabled ~= true then
		return false
	end
	local r = c.Rollout
	if r == "all" then
		return true
	end
	if r == "owner" then
		return AdminConfig.IsPlaytestOwner(userId) == true
	end
	return false
end

local function logLine(key: string, msg: string)
	local now = os.clock()
	local every = num("LogSeconds", 5)
	if now - (logAt[key] or -math.huge) >= every then
		logAt[key] = now
		print("[ArmyFollow] " .. msg)
	end
end
ArmyFollow.Log = logLine

-- claude-bud JOB 22: the stable formation controller (ArmyConfig.Follow2.Stable)
local function stableOn(): boolean
	return cfg().Stable == true
end
ArmyFollow.StableOn = stableOn

-- v114: ArmyConfig.Follow3 (ArmyController) is switched on (the players group / hooks are needed for it too)
local function follow3On(): boolean
	local f = (ArmyConfig :: any).Follow3
	return typeof(f) == "table" and f.Enabled == true and (f.Rollout == "all" or f.Rollout == "owner")
end

-- claude-bud JOB 22: player characters in their own group, so soldiers never push / block players (Follow2.CollideWithPlayers)
ArmyFollow.PlayerGroup = "WE_PlayerChars"
local playersHooked = false
local function setCharGroup(char: Model)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = ArmyFollow.PlayerGroup
		end
	end
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = ArmyFollow.PlayerGroup
		end
	end)
end
local hookNow: () -> ()
local function hookPlayers()
	if playersHooked or not (stableOn() or follow3On()) then
		return
	end
	hookNow()
end
-- v123 (design rule: soldiers never body-block a player): every player character joins WE_PlayerChars whatever the
-- Follow2 / Follow3 rollout flags say (hookPlayers above keeps its old gate; ensureGroup calls this one after it)
hookNow = function()
	if playersHooked then
		return
	end
	playersHooked = true
	local function onPlayer(p: Player)
		if p.Character then
			setCharGroup(p.Character)
		end
		p.CharacterAdded:Connect(setCharGroup)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerAdded:Connect(onPlayer)
end

local function ensureGroup()
	if groupReady then
		return
	end
	groupReady = true
	pcall(function()
		if not PhysicsService:IsCollisionGroupRegistered(ArmyFollow.Group) then
			PhysicsService:RegisterCollisionGroup(ArmyFollow.Group)
		end
		PhysicsService:CollisionGroupSetCollidable(ArmyFollow.Group, ArmyFollow.Group, false)
		PhysicsService:CollisionGroupSetCollidable(ArmyFollow.Group, "Default", true) -- the world and the players
		if stableOn() or follow3On() then
			if not PhysicsService:IsCollisionGroupRegistered(ArmyFollow.PlayerGroup) then
				PhysicsService:RegisterCollisionGroup(ArmyFollow.PlayerGroup)
			end
			-- v114: with Follow3 soldiers never collide with players (ArmyNPCs / WE_PlayerChars = false)
			PhysicsService:CollisionGroupSetCollidable(ArmyFollow.Group, ArmyFollow.PlayerGroup, cfg().CollideWithPlayers == true and not follow3On())
			PhysicsService:CollisionGroupSetCollidable(ArmyFollow.PlayerGroup, "Default", true) -- players still stand on the world
		end
	end)
	pcall(hookPlayers)
	-- v123 design rule, independent of every kill switch / rollout flag: an army soldier (ArmyNPCs, any owner's) never
	-- collides with a player character (WE_PlayerChars). The world (Default) still collides with both.
	pcall(function()
		if not PhysicsService:IsCollisionGroupRegistered(ArmyFollow.PlayerGroup) then
			PhysicsService:RegisterCollisionGroup(ArmyFollow.PlayerGroup)
		end
		PhysicsService:CollisionGroupSetCollidable(ArmyFollow.Group, ArmyFollow.PlayerGroup, false) -- v123: soldiers never block players
		PhysicsService:CollisionGroupSetCollidable(ArmyFollow.PlayerGroup, "Default", true)
	end)
	pcall(hookNow)
end
ArmyFollow.EnsureGroup = ensureGroup

-- claude-bud JOB 22: ONE mover. Every Humanoid:MoveTo on an army soldier goes through here (ArmyFollow's own follow
-- states and SquadOrdersService's HOLD / ATTACK / RETREAT / escort states); `state` names who drives it now.
local function setState(unit: any, state: string)
	if unit._afState ~= state then
		unit._afState = state
		unit.MoveState = state
		pcall(function()
			unit.Model:SetAttribute("WE_MoveState", state) -- debugging (only on change)
		end)
	end
end
-- v114: forwarded to SoldierController.Move (the only Humanoid:MoveTo on a soldier)
function ArmyFollow.Command(unit: any, goal: Vector3, state: string?)
	SoldierController.Move(unit, goal, state)
end

-- claude-bud JOB 22: one yaw owner. Moving: AutoRotate faces travel and the face gyro has no torque (nothing else can
-- turn it); standing (InPosition): AutoRotate off, the gyro holds the formation heading.
local function setYawMode(unit: any, moving: boolean)
	if unit._afYawMoving == moving then
		return
	end
	unit._afYawMoving = moving
	local gyro = unit.Root and unit.Root:FindFirstChild("NPCFaceGyro")
	if gyro and gyro:IsA("BodyGyro") then
		if unit._afGyroTorque == nil then
			unit._afGyroTorque = gyro.MaxTorque
		end
		gyro.MaxTorque = if moving then Vector3.zero else unit._afGyroTorque
	end
	pcall(function()
		unit.Humanoid.AutoRotate = moving
	end)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- once per unit: no soldier-vs-soldier collision, no trip / ragdoll, and a log line if it dies or loses its root
local function prepUnit(unit: any)
	if unit._afPrep then
		return
	end
	unit._afPrep = true
	ensureGroup()
	for _, d in ipairs(unit.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = ArmyFollow.Group
		end
	end
	unit.Model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = ArmyFollow.Group
			-- v99: a late rig part joins the assembly; the server keeps owning it (no ownership flip to a client)
			task.defer(function()
				local r = unit.Root
				if r and r.Parent and r:IsDescendantOf(Workspace) then
					pcall(function()
						if r:GetNetworkOwnershipAuto() then
							r:SetNetworkOwner(nil)
						end
					end)
				end
			end)
		end
	end)
	local hum: Humanoid = unit.Humanoid
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) -- claude-bud JOB 22: never joins a vehicle assembly
	end)
	hum.Died:Connect(function()
		ArmyFollow.Stats.Died += 1
		local r = unit.Root
		logLine("died" .. tostring(unit.OwnerUserId), string.format("unit %s died (owner %s) at y=%.1f", tostring(unit.Id), tostring(unit.OwnerUserId), if r and r.Parent then r.Position.Y else -1))
	end)
	unit.Root.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			ArmyFollow.Stats.Void += 1
			logLine("root" .. tostring(unit.OwnerUserId), string.format("unit %s lost its HumanoidRootPart (fell out of the world) owner %s", tostring(unit.Id), tostring(unit.OwnerUserId)))
		end
	end)
end
ArmyFollow.PrepUnit = prepUnit

-- v99: ONE movement controller per unit. ArmyFollow owns a FOLLOW unit's MoveTo, WalkSpeed and yaw only while it
-- thinks it; the escort fight / HOLD / ATTACK / RETREAT call Release first. Fresh state on every (re)acquire: no stale
-- goal, path, stuck window or far timer survives a spell under another controller.
local function resetMotion(unit: any)
	unit._afMoveGoal = nil
	unit._afMoveAt = nil
	unit._afPath = nil
	unit._afStand = false
	unit._afProgPos = nil
	unit._afProgAt = nil
	unit._afFarSince = nil
	unit._afStuck = 0
	unit._afAlt = nil
	unit._afSpeedCur = nil
end

function ArmyFollow.Release(unit: any, state: string?)
	SoldierController.Release(unit) -- v114: the Follow3 controller lets go too (gyro re-aimed at its current yaw: no snap)
	if unit._afCtl then
		unit._afCtl = false
		resetMotion(unit)
		pcall(function()
			unit.Humanoid.AutoRotate = true
		end)
		-- claude-bud JOB 22: the face gyro gets its torque back (the order / combat code aims with it)
		local gyro = unit.Root and unit.Root:FindFirstChild("NPCFaceGyro")
		if gyro and gyro:IsA("BodyGyro") and unit._afGyroTorque ~= nil then
			local l = unit.Root.CFrame.LookVector -- v114: aimed at its current yaw first (a stale target snapped it round)
			gyro.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(l.X, 0, l.Z))
			gyro.MaxTorque = unit._afGyroTorque
		end
		unit._afYawMoving = nil
	end
	if state then
		setState(unit, state)
	end
end

local function acquire(unit: any, now: number)
	if not unit._afCtl or now - (unit._afThinkAt or -math.huge) > num("ThinkGapReset", 1.2) then
		resetMotion(unit)
		unit._afCtl = true
		unit._afYawMoving = nil
		pcall(function()
			unit.Humanoid.AutoRotate = false -- the NPCFaceGyro turns it (faceTo): one yaw owner
		end)
	end
	unit._afThinkAt = now
end

function ArmyFollow.LogRemoval(unit: any, reason: string)
	ArmyFollow.Stats.Removed += 1
	logLine("rm" .. tostring(unit.OwnerUserId) .. reason, string.format("unit %s removed: %s (owner %s)", tostring(unit.Id), reason, tostring(unit.OwnerUserId)))
end

-- the excluded instances for every ray: the squad folder and every character
local function refreshRayFilter(extra: Instance?)
	local list: { Instance } = {}
	local folder = deps.Folder and deps.Folder()
	if folder then
		table.insert(list, folder)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	if extra then
		table.insert(list, extra)
	end
	rayParams.FilterDescendantsInstances = list
end

local function clearLine(a: Vector3, b: Vector3): boolean
	local up = Vector3.new(0, 1.2, 0)
	local from, to = a + up, b + up
	return Workspace:Raycast(from, to - from, rayParams) == nil
end

local function groundAt(p: Vector3, fromY: number): Vector3?
	local top = Vector3.new(p.X, fromY + 12, p.Z)
	local hit = Workspace:Raycast(top, Vector3.new(0, -40, 0), rayParams)
	return if hit then hit.Position else nil
end

-- ── the owner's motion and the squad plan (once per think per squad) ──────────────────────────────────────────────
local function ownerWalkSpeed(root: BasePart): number
	local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
	return if hum then hum.WalkSpeed else 16
end

-- claude-bud: Follow2.Tidy (owner-only first): hold outside the plot, neat wait rows, fixed seats, no crossing
local function tidyCfg(): { [string]: any }
	local t = cfg().Tidy
	return if typeof(t) == "table" then t else {}
end

local function tnum(key: string, default: number): number
	local v = tidyCfg()[key]
	return if typeof(v) == "number" then v else default
end

local function tidyLive(player: Player?): boolean
	if player == nil then
		return false
	end
	local r = tidyCfg().Rollout
	return r == "all" or (r == "owner" and AdminConfig.IsPlaytestOwner(player.UserId) == true)
end
ArmyFollow.TidyLive = tidyLive

-- his own plot id (nil: none) and a point's plot-local position in it
local function ownPlotId(player: Player?): number?
	if player == nil or deps.OwnPlotId == nil then
		return nil
	end
	local id = deps.OwnPlotId(player)
	return if typeof(id) == "number" then id else nil
end

local function plotLocal(id: number, pos: Vector3): Vector3?
	local c = PlotFrame.PlotPosition(id)
	if c == nil then
		return nil
	end
	return PlotFrame.PlotCFrame(c):PointToObjectSpace(pos)
end

-- true when `pos` is inside plot `id` grown by `pad` studs
local function inPlot(id: number, pos: Vector3, pad: number): boolean
	local lp = plotLocal(id, pos)
	if lp == nil then
		return false
	end
	local half = BaseConfig.PlotSize.X * 0.5 + pad
	return math.abs(lp.X) <= half and math.abs(lp.Z) <= half
end

local function ownPlotInside(st: any, player: Player?, pos: Vector3): number?
	local id = ownPlotId(player)
	if id == nil then
		return nil
	end
	local lp = plotLocal(id, pos)
	if lp == nil then
		return nil
	end
	local half = BaseConfig.PlotSize.X * 0.5
	local edge = math.max(math.abs(lp.X), math.abs(lp.Z))
	local inside: boolean
	if st._afTidy then
		-- claude-bud: hold as he reaches his edge from outside (the wedge behind him never follows him in)
		inside = if st._afInBase then edge <= half + tnum("HoldReleaseStuds", 10) else edge <= half + tnum("HoldApproachStuds", 6)
	else
		inside = if st._afInBase then edge <= half + num("BaseOutStuds", 2) else edge <= half - num("BaseInStuds", 4)
	end
	return if inside then id else nil
end

--[[ claude-bud (Tidy): fixed seats for life, UNIQUE per squad (seat -> unit map): a dead / gone unit frees its seat,
	nobody else moves up, and no two units ever share one (a duplicated or missing seat is re-issued the lowest free
	number). FOLLOW (wedge), the base hold and ATTACK (march rows / target ring) all place a unit by its seat. ]]
local function assignSeats(st: any, units: { any })
	local order = table.clone(units)
	table.sort(order, function(a, b)
		return (a.Slot or 0) < (b.Slot or 0)
	end)
	local taken: { [number]: any } = {}
	for _, u in ipairs(order) do
		local s = u._afSeat
		if typeof(s) == "number" and s >= 1 and taken[s] == nil then
			taken[s] = u
		else
			u._afSeat = nil
		end
	end
	for _, u in ipairs(order) do
		if u._afSeat == nil then
			local s = 1
			while taken[s] ~= nil do
				s += 1
			end
			u._afSeat = s
			taken[s] = u
		end
	end
	st._afSeatMap = taken
	st._afSeatCount = #order
end
ArmyFollow.AssignSeats = assignSeats

-- claude-bud: tidy wait spot of seat `rank`: rows on both sides of the gate lane, facing out (plot-local +Z)
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.RespectCanCollide = true
local gridCache: { [number]: { At: number, Cells: { [number]: { Vector3 } }, Need: number } } = {}

-- one hold cell (plot-local x, z) is usable: ground under it (not water, not a roof) and nothing collidable in a
-- soldier-sized box on it (walls, props, parked vehicles; the squads and characters are excluded)
local function cellFree(plotId: number, lx: number, lz: number): Vector3?
	local w = PlotFrame.LocalToWorld(plotId, lx, lz)
	local c = PlotFrame.PlotPosition(plotId)
	local refY = if c then c.Y + 0.5 else w.Y
	local hit = Workspace:Raycast(Vector3.new(w.X, refY + 30, w.Z), Vector3.new(0, -60, 0), rayParams)
	if hit == nil or hit.Material == Enum.Material.Water or math.abs(hit.Position.Y - refY) > 2.5 then
		return nil
	end
	overlapParams.FilterDescendantsInstances = rayParams.FilterDescendantsInstances
	local box = CFrame.new(hit.Position + Vector3.new(0, 3.2, 0))
	local parts = Workspace:GetPartBoundsInBox(box, Vector3.new(3, 4.6, 3), overlapParams)
	if #parts > 0 then
		return nil
	end
	return hit.Position
end

-- the hold grid of plot `plotId`: per side (1 = left, 2 = right), the free cells in order (row 0 first, outward),
-- PerRow per row, ColSpacing apart, RowSpacing deep, never nearer the front edge than WaitOut (always outside the gate
-- plane). Cached for 30 s (props do not move).
local function holdCells(plotId: number, need: number): { [number]: { Vector3 } }
	local now = os.clock()
	local c = gridCache[plotId]
	local perSide = math.ceil(need / 2)
	if c and now - c.At < 30 and c.Need >= need then
		return c.Cells -- (a side short of free cells is not re-scanned every think: Need, not the cell count)
	end
	refreshRayFilter(nil)
	local half = BaseConfig.PlotSize.X * 0.5
	local gateHalf = (tonumber(BaseLayoutConfig.MainGateWidth) or 14) * 0.5
	local perRow = math.max(1, math.floor(tnum("PerRow", 4)))
	local cells: { [number]: { Vector3 } } = { {}, {} }
	for sideIdx, side in ipairs({ -1, 1 }) do
		local list = cells[sideIdx]
		for row = 0, 40 do
			if #list >= perSide then
				break
			end
			for col = 0, perRow - 1 do
				if #list >= perSide then
					break
				end
				local lx = side * (gateHalf + tnum("WaitGap", 5) + col * tnum("ColSpacing", 4))
				local lz = half + tnum("WaitOut", 14) + row * tnum("RowSpacing", 4)
				local at = cellFree(plotId, lx, lz)
				if at then
					table.insert(list, at)
				end
			end
		end
	end
	gridCache[plotId] = { At = now, Cells = cells, Need = math.max(need, 16) }
	return cells
end

local function tidyWaitSpot(plotId: number, rank: number): (Vector3, Vector3)
	local half = BaseConfig.PlotSize.X * 0.5
	local gateHalf = (tonumber(BaseLayoutConfig.MainGateWidth) or 14) * 0.5
	local side = if rank % 2 == 1 then -1 else 1
	local j = math.floor((rank - 1) / 2) -- index on its side
	local perRow = math.max(1, math.floor(tnum("PerRow", 4)))
	local col = j % perRow
	local row = math.floor(j / perRow)
	local x = side * (gateHalf + tnum("WaitGap", 5) + col * tnum("ColSpacing", 4))
	local z = half + tnum("WaitOut", 14) + row * tnum("RowSpacing", 4)
	local p = PlotFrame.LocalToWorld(plotId, x, z)
	local out = PlotFrame.LocalToWorld(plotId, x, z + 1) - p
	out = Vector3.new(out.X, 0, out.Z)
	-- claude-bud (hold fix): the k-th FREE cell of this side (walls / props / water skipped, moved outward)
	local cells = holdCells(plotId, rank + 1)
	local mine = cells[if side < 0 then 1 else 2][j + 1]
	if mine then
		p = mine
	end
	return p, if out.Magnitude > 1e-3 then out.Unit else Vector3.new(0, 0, 1)
end

--[[ claude-bud (ATTACK fix): a unit's own attack spot by its seat, never a shared point.
	"march": rows abreast in front of `center` along `facing` (no target in reach): MarchPerRow per row, MarchSpacing
	apart, the first row MarchAhead studs ahead. "ring": round a target at `center`, one seat each, AttackRingSpacing
	studs apart along the ring (radius grows with the squad), the ring turned so the units approach from their side. ]]
function ArmyFollow.AttackPoint(st: any, unit: any, center: Vector3, facing: Vector3, mode: string): Vector3
	if unit._afSeat == nil or st._afSeatMap == nil or st._afSeatMap[unit._afSeat] ~= unit then
		assignSeats(st, st.Units)
	end
	local k = unit._afSeat or 1
	local n = math.max(1, st._afSeatCount or #st.Units)
	local f = Vector3.new(facing.X, 0, facing.Z)
	f = if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, -1)
	local right = Vector3.new(-f.Z, 0, f.X)
	if mode == "ring" then
		local spacing = tnum("AttackRingSpacing", 3.5)
		local r = math.max(tnum("AttackRingMin", 8), n * spacing / (2 * math.pi))
		local a = (k - 1) * 2 * math.pi / n
		local dir = -f * math.cos(a) + right * math.sin(a)
		return center + dir * r
	end
	local perRow = math.max(1, math.floor(tnum("MarchPerRow", 5)))
	local spacing = tnum("MarchSpacing", 3.5)
	local row = math.floor((k - 1) / perRow)
	local col = (k - 1) % perRow
	local inRow = math.min(perRow, n - row * perRow)
	local lateral = (col - (inRow - 1) * 0.5) * spacing
	return center + f * (tnum("MarchAhead", 10) + row * spacing) + right * lateral
end

local function waitSpot(plotId: number, rank: number): Vector3
	local half = BaseConfig.PlotSize.X * 0.5
	local gateHalf = (tonumber(BaseLayoutConfig.MainGateWidth) or 14) * 0.5
	local side = if rank % 2 == 1 then -1 else 1
	local k = math.floor((rank - 1) / 2)
	local row = k % 2
	local x = side * (gateHalf + num("BaseWaitGap", 5) + math.floor(k / 2) * num("BaseWaitSpacing", 4) + row * 2)
	local z = half + num("BaseWaitOut", 12) + row * 4
	return PlotFrame.LocalToWorld(plotId, x, z)
end

-- v99: `cur` turned toward `want` (flat unit vectors) by at most `maxRad`
local function turnToward(cur: Vector3, want: Vector3, maxRad: number): Vector3
	local a = math.atan2(cur.X, cur.Z)
	local b = math.atan2(want.X, want.Z)
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	if math.abs(d) <= maxRad then
		return want
	end
	local r = a + (if d > 0 then maxRad else -maxRad)
	return Vector3.new(math.sin(r), 0, math.cos(r))
end

--[[ v99: seats are reassigned ONLY when the army size changed: once the living count has been the same for
	SeatCompactSeconds and a seat above that count exists (a hole after a death / trim), the units are renumbered
	1..n keeping their order (each moves at most up into the next free seat, nobody swaps sides at random). ]]
local function compactSeats(st: any, order: { any }, now: number)
	local n = #order
	if st._afSeatN ~= n then
		st._afSeatN = n
		st._afSeatNAt = now
		return
	end
	if now - (st._afSeatNAt or now) < num("SeatCompactSeconds", 4) then
		return
	end
	local hole = false
	for _, u in ipairs(order) do
		if typeof(u._afSeat) == "number" and u._afSeat > n then
			hole = true
			break
		end
	end
	if not hole then
		return
	end
	local bySeat = table.clone(order)
	table.sort(bySeat, function(a, b)
		return (a._afSeat or math.huge) < (b._afSeat or math.huge)
	end)
	for i, u in ipairs(bySeat) do
		u._afSeat = i
	end
	st._afFlip = nil
	logLine("compact" .. tostring(st), string.format("army of %d: seats compacted after a size change", n))
end

local function plan(st: any, player: Player?, root: BasePart, units: { any }, now: number)
	if st._afPlanAt == now then
		return
	end
	st._afPlanAt = now
	local pos = root.Position
	local lastPos: Vector3? = st._afLastPos
	local dt = now - (st._afLastAt or now)
	local vel = Vector3.zero
	local jumped = false
	local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
	st._afSeated = hum ~= nil and (hum.Sit or hum.SeatPart ~= nil)
	if lastPos and dt > 0.05 and dt < 2 then
		vel = flat(pos - lastPos) / dt
		-- v99: only on foot is a very fast move a jump (teleport / respawn); a fast vehicle is real speed (before, it
		-- zeroed his speed, dropped the vehicle defer and teleported the army every TeleportCooldown behind him)
		if not st._afSeated and vel.Magnitude > num("OwnerJumpSpeed", 60) then
			jumped = true
			vel = Vector3.zero
		end
	end
	st._afLastPos = pos
	st._afLastAt = now
	st._afJumped = jumped
	local speed = vel.Magnitude
	st._afSpeed = (st._afSpeed or 0) * 0.4 + speed * 0.6
	st._afVel = vel
	st._afWalk = ownerWalkSpeed(root)
	-- facing (v99): his root CFrame's look (his move direction when he backs away), turned at most TurnRateDeg per
	-- second (a sharp turn swings the wedge round smoothly, never 180 degrees in one think); standing, re-aimed only
	-- once he turned past FacingTurnDeg (no swirl on the spot), then turned all the way
	-- claude-bud JOB 22: the smoothed formation anchor (position lag, smoothed lead, capped turn, deadzone, no 180 flip)
	if stableOn() then
		st._afAnchor = st._afAnchor or FormationMath.NewAnchor()
		FormationMath.Step(st._afAnchor, pos, root.CFrame.LookVector, vel, dt, now, jumped or st._afSeated == true, cfg())
		st._afDir = st._afAnchor.Dir
		st._afFlip = nil -- seat sides never swap
	end
	local look = flat(root.CFrame.LookVector)
	look = if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)
	local want: Vector3 = look
	if speed >= 2 and look:Dot(vel.Unit) < 0 then
		want = vel.Unit
	end
	local cur: Vector3? = st._afDir
	local tdt = math.clamp(now - (st._afDirAt or now), 0, 0.6)
	st._afDirAt = now
	if stableOn() then
		-- (the anchor above owns the heading)
	elseif cur == nil or jumped then
		st._afDir = want
		st._afTurning = false
	else
		if speed >= 2 or cur:Dot(want) < math.cos(math.rad(num("FacingTurnDeg", 35))) then
			st._afTurning = true
		end
		if st._afTurning then
			local nd = turnToward(cur, want, math.rad(num("TurnRateDeg", 300)) * tdt)
			st._afDir = nd
			if speed < 2 and nd:Dot(want) > math.cos(math.rad(2)) then
				st._afTurning = false
			end
		end
	end
	-- rank by SquadSlot (stable)
	local order = table.clone(units)
	table.sort(order, function(a, b)
		return (a.Slot or 0) < (b.Slot or 0)
	end)
	st._afTidy = tidyLive(player)
	do
		-- v99: EVERY squad keeps persistent unique seats (was: Tidy only; the rest ranked by index, so one death
		-- re-ranked the whole wedge and every unit crossed to a new spot). Compacted only after the size changed.
		compactSeats(st, order, now)
		assignSeats(st, order)
		for _, u in ipairs(order) do
			u._afRank = u._afSeat
		end
	end
	-- own base
	local plotId = ownPlotInside(st, player, pos)
	local wasIn = st._afInBase
	st._afInBase = plotId ~= nil
	st._afPlot = plotId
	st._afOwnPlot = ownPlotId(player)
	if wasIn and not st._afInBase then
		st._afLeftBaseAt = now -- claude-bud: the walk-back grace (no far / stuck teleport)
	end
	if st._afInBase ~= wasIn and player then
		logLine("base" .. tostring(player.UserId), string.format("owner %d %s his base: army %s", player.UserId, if plotId then "entered" else "left", if plotId then "waits at the gate" else "follows"))
	end
	-- claude-bud: wedge row pairs keep their world sides when he turns round (no crossing through each other)
	if st._afTidy and not st._afInBase and st._afSeatMap and not stableOn() then
		local dir: Vector3 = st._afDir or Vector3.new(0, 0, -1)
		local right = Vector3.new(-dir.Z, 0, dir.X)
		st._afFlip = st._afFlip or {}
		local hyst = tnum("FlipHysteresisStuds", 1.5)
		for s, u in pairs(st._afSeatMap) do
			if s % 2 == 1 then
				local mate = st._afSeatMap[s + 1]
				local row = (s + 1) / 2
				if mate and u.Root and u.Root.Parent and mate.Root and mate.Root.Parent then
					-- seat s is the left one (side -1): flip when it stands clearly right of its mate
					local diff = (u.Root.Position - mate.Root.Position):Dot(right)
					if diff > hyst then
						st._afFlip[row] = true
					elseif diff < -hyst then
						st._afFlip[row] = false
					end
				else
					st._afFlip[row] = nil
				end
			end
		end
	end
	refreshRayFilter(nil)
end

local function slotPoint(st: any, root: BasePart, rank: number): Vector3
	if st._afInBase and st._afPlot then
		local w = waitSpot(st._afPlot, rank)
		if st._afTidy then
			w = (tidyWaitSpot(st._afPlot, rank)) -- claude-bud: neat rows facing out
		end
		return Vector3.new(w.X, root.Position.Y, w.Z)
	end
	local dir: Vector3 = st._afDir or Vector3.new(0, 0, -1)
	local row = math.ceil(rank / 2)
	local side = if rank % 2 == 1 then -1 else 1
	local back = num("WedgeBack", 3) + row * num("RowBack", 3)
	local lat = side * (num("WedgeSide", 2.5) + row * num("RowSide", 2.5))
	if st._afTidy then
		-- claude-bud: wider rows (never inside each other) and the row pair's kept world sides (no crossing)
		if st._afFlip and st._afFlip[row] == true then
			side = -side
		end
		back = num("WedgeBack", 3) + row * tnum("RowBack", 4)
		lat = side * (num("WedgeSide", 2.5) + row * tnum("RowSide", 3))
		-- claude-bud (owner: "the army is still glitchy and despawns when walking"): the wedge trails 7-19 studs
		-- behind him plus the catch-up lag, i.e. AT or BEHIND the phone camera (~12-15 studs back): the back rows leave
		-- the view (and the camera guard hides one filling the screen) while he walks, and pop back when he stops.
		-- Flank: a file on each side of him from FlankFront (ahead) back FlankRowBack per row, each row FlankRowSide
		-- further out (its client escort file ahead of it never lands on another soldier). All in front of the camera.
		if tidyCfg().Formation == "Flank" then
			back = tnum("FlankFront", -1) + (row - 1) * tnum("FlankRowBack", 3)
			lat = side * (tnum("FlankSide", 3.5) + (row - 1) * tnum("FlankRowSide", 2.6))
		end
	end
	if stableOn() and st._afAnchor then
		-- claude-bud JOB 22: slot = the smoothed anchor x this seat's fixed offset (+ the smoothed, capped lead)
		return FormationMath.SlotWorld(st._afAnchor, lat, back, root.Position.Y, cfg())
	end
	local lead = (st._afVel or Vector3.zero) * num("LeadSeconds", 0.3)
	local cap = num("LeadMaxStuds", 5)
	if lead.Magnitude > cap then
		lead = lead.Unit * cap
	end
	-- v99: this unit's own offset (x = side, z = back) in his facing frame (root position, turned by st._afDir)
	local frame = CFrame.lookAt(root.Position, root.Position + dir)
	return frame:PointToWorldSpace(Vector3.new(lat, 0, back)) + lead
end
ArmyFollow.SlotPoint = slotPoint

-- ── teleport (regroup): one PivotTo of the same unit, to a clear spot behind the owner ─────────────────────────
--[[ v99: the reposition spot is the unit's OWN slot, first pushed RegroupBehindStuds further back (behind the phone
	camera, ~12.5 studs behind him: it runs in instead of popping up in view), then half that, then the slot itself,
	then points behind him on its own side line. Never within RegroupMinOwnerStuds of him (never on top of him). ]]
local function spotFor(st: any, root: BasePart, rank: number): CFrame?
	local dir: Vector3 = st._afDir or Vector3.new(0, 0, -1)
	local slot = slotPoint(st, root, rank)
	local cands: { Vector3 } = {}
	if not st._afInBase then
		local behind = num("RegroupBehindStuds", 16)
		table.insert(cands, slot - dir * behind)
		table.insert(cands, slot - dir * behind * 0.5)
	end
	table.insert(cands, slot)
	if not st._afInBase then
		local right = Vector3.new(-dir.Z, 0, dir.X)
		local lat = (slot - root.Position):Dot(right)
		for _, b in ipairs({ 8, 12, 5, 16 }) do
			table.insert(cands, root.Position - dir * b + right * lat)
		end
	end
	local minOwner = num("RegroupMinOwnerStuds", 6)
	for _, c in ipairs(cands) do
		local g = groundAt(c, root.Position.Y)
		if g and flatDist(g, root.Position) >= minOwner and math.abs(g.Y - root.Position.Y) < 14 and (st._afInBase or clearLine(root.Position, g + Vector3.new(0, 1.8, 0))) then
			local p = g + Vector3.new(0, num("StandHeight", 3.2), 0)
			return CFrame.lookAt(p, p + dir)
		end
	end
	return nil
end

local function regroup(st: any, unit: any, root: BasePart, now: number, why: string): boolean
	if now < (unit._afTpAt or -math.huge) then
		return false
	end
	unit._afTpAt = now + num("TeleportCooldown", 2.5)
	local cf = spotFor(st, root, unit._afRank or 1)
	if cf == nil then
		logLine("nospot" .. tostring(unit.OwnerUserId), string.format("no clear regroup spot for unit %s (%s): it keeps walking", tostring(unit.Id), why))
		return false
	end
	SoldierController.Reposition(unit, cf, why, true) -- v114: the one emergency PivotTo lives in SoldierController
	unit._afPath = nil
	unit._afMoveGoal = cf.Position
	unit._afMoveAt = now
	unit._afProgPos = cf.Position
	unit._afProgAt = now
	unit._afFarSince = nil
	unit._afStuck = 0
	unit._afAlt = nil
	ArmyFollow.Stats.Regroup += 1
	logLine("rg" .. tostring(unit.OwnerUserId) .. why, string.format("regroup unit %s (%s) owner %s", tostring(unit.Id), why, tostring(unit.OwnerUserId)))
	return true
end

local function setSpeed(unit: any, s: number)
	local hum: Humanoid = unit.Humanoid
	unit._afSpeedCur = s
	if math.abs(hum.WalkSpeed - s) >= 1 then
		hum.WalkSpeed = s
		unit.Speed = s -- v99: SquadOrdersService's WalkSpeed cache stays true (its setSpeed skips equal writes)
	end
end

-- v99: the one yaw writer while ArmyFollow controls the unit (AutoRotate is off): the NPCFaceGyro's target, written
-- only past 4 degrees of change (no property write per think); an escort that just shot keeps its aim for
-- FaceAfterShotSeconds
local function faceTo(unit: any, dir: Vector3, now: number)
	if now - (tonumber(unit.LastFireAt) or 0) < num("FaceAfterShotSeconds", 1.2) then
		return
	end
	local f = flat(dir)
	if f.Magnitude < 1e-3 then
		return
	end
	f = f.Unit
	local gyro = unit.Root:FindFirstChild("NPCFaceGyro")
	if gyro and gyro:IsA("BodyGyro") then
		-- compared with the gyro's own target (another writer, e.g. the escort's faceYaw, may have turned it)
		if flat(gyro.CFrame.LookVector):Dot(f) > math.cos(math.rad(4)) then
			return
		end
		gyro.CFrame = CFrame.lookAt(Vector3.zero, f)
	end
end

local function moveTo(unit: any, goal: Vector3, now: number)
	local last: Vector3? = unit._afMoveGoal
	local due = if stableOn()
		then FormationMath.ReissueDue(last, unit._afMoveAt, goal, now, cfg()) -- claude-bud JOB 22: never every frame
		else (last == nil or flatDist(last, goal) >= num("ReissueStuds", 1.5) or now - (unit._afMoveAt or 0) >= num("ReissueSeconds", 5))
	if due then
		ArmyFollow.Command(unit, goal)
		unit._afMoveGoal = goal
		unit._afMoveAt = now
	end
end

local function requestPath(unit: any, from: Vector3, to: Vector3, now: number)
	if unit._afPathBusy or now < (unit._afPathAt or -math.huge) then
		return
	end
	if now - pathBudget.At >= 1 then
		pathBudget.At = now
		pathBudget.N = 0
	end
	if pathBudget.N >= num("PathBudgetPerSecond", 8) then
		return
	end
	pathBudget.N += 1
	unit._afPathBusy = true
	unit._afPathAt = now + num("PathCooldown", 1.5)
	ArmyFollow.Stats.Paths += 1
	task.spawn(function()
		local ok, path = pcall(function()
			local p = PathfindingService:CreatePath({ AgentRadius = 1.5, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 })
			p:ComputeAsync(from, to)
			return p
		end)
		unit._afPathBusy = false
		if ok and path and path.Status == Enum.PathStatus.Success then
			local wps = path:GetWaypoints()
			unit._afPath = { Points = wps, I = math.min(2, #wps), Goal = to, At = os.clock() }
		else
			unit._afPath = nil
			unit._afPathFail = os.clock()
		end
	end)
end

-- claude-bud (hold fix), v114 extracted: the point to walk to from `pos` (outside plot `plotId`) toward `goal`: the goal,
-- or first the nearest outside corner point when the straight line would clip his plot square (never crossed)
local function holdVia(plotId: number, pos: Vector3, goal: Vector3): Vector3
	local lp = plotLocal(plotId, pos)
	local lg = plotLocal(plotId, goal)
	local via = goal
	if lp and lg then
		local half = BaseConfig.PlotSize.X * 0.5 + tnum("PlotPadStuds", 2) + 4
		local crosses = false
		for i = 1, 7 do
			local t = i / 8
			local x, z = lp.X + (lg.X - lp.X) * t, lp.Z + (lg.Z - lp.Z) * t
			if math.abs(x) < half and math.abs(z) < half then
				crosses = true
				break
			end
		end
		if crosses then
			local sx = if lp.X < 0 then -1 else 1
			local cx, cz
			if math.abs(lp.X) >= half then
				cx, cz = sx * half, half
			elseif lp.Z < 0 then
				cx, cz = sx * half, lp.Z
			else
				cx, cz = lg.X, half
			end
			via = PlotFrame.LocalToWorld(plotId, cx, cz)
			via = Vector3.new(via.X, goal.Y, via.Z)
		end
	end
	return via
end

--[[ one FOLLOW unit, one think. Returns nothing; SquadOrdersService calls it only for a live owner in FOLLOW, on foot
	or seated, after its escort shot (the escort's own walk runs only while the owner stands near a hostile). ]]
function ArmyFollow.Unit(player: Player?, st: any, unit: any, root: BasePart, now: number)
	if not unit.Alive or unit.Humanoid.Health <= 0 or unit.Root.Parent == nil then
		return
	end
	prepUnit(unit) -- (v99: already done at spawn; a no-op here)
	acquire(unit, now) -- v99: this unit's one movement controller from here until Release
	plan(st, player, root, st.Units, now)
	local pos = unit.Root.Position
	local rank = unit._afRank or 1
	local slot = slotPoint(st, root, rank)
	local d = flatDist(pos, slot)
	local ownerD = flatDist(pos, root.Position)
	local seatedFast = st._afSeated and (st._afSpeed or 0) > num("VehicleDeferSpeed", 20)

	-- regroup triggers: under the map, the owner jumped, far, stuck (never while he drives fast)
	local fph = Workspace.FallenPartsDestroyHeight
	if pos.Y < root.Position.Y - num("VoidBelowOwner", 60) or pos.Y < fph + num("VoidMargin", 80) then
		if regroup(st, unit, root, now, "void") then
			return
		end
	end
	-- claude-bud (Tidy): just out of his base, they walk back into the wedge (no far / stuck teleport for a grace spell)
	local walkBack = st._afTidy and not st._afInBase and now - (st._afLeftBaseAt or -math.huge) < tnum("LeaveGraceSeconds", 8)
	-- claude-bud (hold fix): while he is in his base, a unit OUTSIDE his plot walks straight to its hold cell: no
	-- pathfinding (a path ran through the open gate), no stuck / far teleport correction (void rescue only)
	local holdOut = st._afTidy and st._afInBase and st._afPlot ~= nil and not inPlot(st._afPlot, pos, 0)
	if not seatedFast and not walkBack and not holdOut then
		if st._afJumped and ownerD > num("JumpRegroupStuds", 40) and regroup(st, unit, root, now, "owner-jump") then
			return
		end
		-- v99: the emergency reposition only when EXTREMELY far (FarStuds 100 from its slot for FarSeconds 3);
		-- falling behind is handled by the catch-up speed, never by a teleport or a new unit
		local far = if st._afInBase then num("BaseFarStuds", 140) else num("FarStuds", 100)
		if d > far then
			unit._afFarSince = unit._afFarSince or now
			if now - unit._afFarSince >= num("FarSeconds", 3) and regroup(st, unit, root, now, "far") then
				return
			end
		else
			unit._afFarSince = nil
		end
		-- stuck (v99, staged): it wants to move (goal further than StuckGoalStuds) but has moved less than StuckStuds:
		-- StuckSeconds -> a fresh path now; StuckAltSeconds -> an alternate point beside it (+ a jump);
		-- StuckTeleportSeconds -> the reposition (the final fallback)
		local pp: Vector3? = unit._afProgPos
		if pp == nil or d <= num("StuckGoalStuds", 6) or flatDist(pos, pp) >= num("StuckStuds", 3) then
			unit._afProgPos = pos
			unit._afProgAt = now
			unit._afStuck = 0
		elseif d > num("StuckMinStuds", 10) then
			local since = now - (unit._afProgAt or now)
			if since >= num("StuckTeleportSeconds", 10) then
				if regroup(st, unit, root, now, "stuck") then
					return
				end
			elseif since >= num("StuckAltSeconds", 6) and (unit._afStuck or 0) < 2 then
				unit._afStuck = 2
				setState(unit, "StuckRecovery") -- claude-bud JOB 22
				local to = flat(slot - pos)
				to = if to.Magnitude > 1e-3 then to.Unit else Vector3.new(0, 0, -1)
				local side = Vector3.new(-to.Z, 0, to.X) * num("StuckAltStuds", 6)
				local first = if rank % 2 == 1 then -1 else 1
				local alt: Vector3? = nil
				for _, sgn in ipairs({ first, -first }) do
					local c = pos + side * sgn + to * 2
					if clearLine(pos, c) then
						alt = c
						break
					end
				end
				if alt then
					unit._afAlt = { P = alt, Until = now + num("StuckAltHoldSeconds", 2.5) }
					unit._afPath = nil
					unit.Humanoid.Jump = true
					logLine("alt" .. tostring(unit.OwnerUserId), string.format("unit %s stuck %.1f s: alternate point", tostring(unit.Id), since))
				end
			elseif since >= num("StuckSeconds", 3) and (unit._afStuck or 0) < 1 then
				unit._afStuck = 1
				setState(unit, "StuckRecovery") -- claude-bud JOB 22
				unit._afPath = nil
				unit._afPathAt = -math.huge -- one repath now (the per-unit cooldown is skipped once)
				requestPath(unit, pos, slot, now)
			end
		end
	else
		unit._afFarSince = nil
		unit._afProgPos = nil
	end

	-- separation: steer away from any squad-mate closer than SeparationStuds
	local sep = if st._afTidy and st._afInBase then 0 else num("SeparationStuds", 3.5) -- claude-bud: hold cells are exact
	local push = Vector3.zero
	for _, o in ipairs(st.Units) do
		if o ~= unit and o.Alive and o.Root and o.Root.Parent then
			local off = flat(pos - o.Root.Position)
			local m = off.Magnitude
			if m < sep then
				push += (if m > 1e-3 then off / m else Vector3.new(((rank % 2) * 2 - 1), 0, 0)) * (sep - m) / sep
			end
		end
	end
	-- claude-bud JOB 22: the owner is in the separation too (they never walk into him)
	if stableOn() and not st._afInBase then
		local oc = num("OwnerClearStuds", 3.5)
		local off = flat(pos - root.Position)
		local m = off.Magnitude
		if m < oc then
			push += (if m > 1e-3 then off / m else Vector3.new(((rank % 2) * 2 - 1), 0, 0)) * (oc - m) / oc
		end
	end
	-- v99: the push is capped (SeparationMaxStuds): neighbours step apart, the goal never jumps round the slot
	local pushOff = push * num("SeparationGain", 3)
	local maxPush = num("SeparationMaxStuds", 3)
	if pushOff.Magnitude > maxPush then
		pushOff = pushOff.Unit * maxPush
	end
	local goal = slot + pushOff
	-- claude-bud (Tidy): a unit outside his plot never gets a goal inside it (it waits at its gate spot instead)
	local ownPlot: number? = if st._afTidy then st._afOwnPlot else nil
	local unitOutside = ownPlot ~= nil and not inPlot(ownPlot, pos, 0)
	local pad = tnum("PlotPadStuds", 2)
	local function keepOut(p: Vector3): Vector3
		if unitOutside and ownPlot and inPlot(ownPlot, p, pad) then
			local w = tidyWaitSpot(ownPlot, rank)
			return Vector3.new(w.X, p.Y, w.Z)
		end
		return p
	end
	goal = keepOut(goal)

	-- speed: never slower than his sprint when behind
	local ownerPace = math.max(st._afWalk or 16, st._afSpeed or 0)
	if st._afSeated then
		ownerPace = math.max(16, math.min(st._afSpeed or 0, num("CatchUpMin", 34)))
	end
	local base = (tonumber((deps.UnitWalkSpeed or function() return 14 end)()) or 14)
	local speed: number
	if st._afInBase then
		speed = base * 1.25
	else
		-- v99: one continuous curve (was a step from x MatchMult to x CatchUpMult at CatchUpStartStuds): his pace x
		-- MatchMult in the slot, ramping to x CatchUpMult over CatchUpRampStuds, then + CatchUpPerStud per stud
		-- further behind, capped at max(his pace x CatchUpMaxMult, CatchUpMin); back to normal once in formation
		local start = num("CatchUpStartStuds", 5)
		local ramp = math.max(1, num("CatchUpRampStuds", 10))
		local t = math.clamp((d - start) / ramp, 0, 1)
		local mm = num("MatchMult", 1.08)
		local mult = mm + (num("CatchUpMult", 1.35) - mm) * t
		local cap = math.max(ownerPace * num("CatchUpMaxMult", 1.8), num("CatchUpMin", 34))
		speed = math.max(base, ownerPace * mult + math.max(0, d - start - ramp) * num("CatchUpPerStud", 0.6))
		speed = math.min(cap, speed)
	end
	speed = math.clamp(speed, 8, num("MaxSpeed", 50))
	-- v99: smooth: at most SpeedUpPerThink faster / SpeedDownPerThink slower than the last think
	local curSpeed = tonumber(unit._afSpeedCur) or unit.Humanoid.WalkSpeed
	speed = math.clamp(speed, curSpeed - num("SpeedDownPerThink", 6), curSpeed + num("SpeedUpPerThink", 8))
	setSpeed(unit, speed)

	-- claude-bud (Tidy): at its gate wait spot it stands still facing out, whatever he does inside
	if st._afTidy and st._afInBase and st._afPlot and flatDist(pos, goal) <= tnum("HoldArriveStuds", 1.5) then
		if not unit._afStand then
			unit._afStand = true
			ArmyFollow.Command(unit, pos, "BaseHold")
			unit._afMoveGoal = pos
			unit._afMoveAt = now
			local _, out = tidyWaitSpot(st._afPlot, rank)
			-- v114: no PivotTo turn (a hard yaw snap); the gyro turns it
			faceTo(unit, out, now) -- v99: the gyro holds that facing (it no longer pulls back to a stale yaw)
		end
		unit._afPath = nil
		return
	end
	if stableOn() and not st._afInBase then
		-- claude-bud JOB 22: the follow state machine. InPosition (arrival deadzone, left only past LeaveDeadzone):
		-- one stop, then NOTHING is issued; the gyro holds the formation heading. Following / CatchingUp: AutoRotate
		-- faces travel (no gyro), MoveTo only when the target moved MoveReissueStuds or MoveRefreshSeconds passed.
		local prevState = unit._afState
		local state = FormationMath.State(prevState, flatDist(pos, goal), cfg())
		if state == "InPosition" then
			if prevState ~= "InPosition" then
				ArmyFollow.Command(unit, pos, "InPosition")
				unit._afMoveGoal = pos
				unit._afMoveAt = now
				setYawMode(unit, false)
			end
			faceTo(unit, st._afDir or Vector3.new(0, 0, -1), now) -- (the gyro writes only past 4 degrees)
			unit._afPath = nil
			unit._afStand = true
			return
		end
		setState(unit, state)
		setYawMode(unit, true)
	else
		-- v99: facing: toward its goal while it runs to catch up, else his facing (so its client escort file points
		-- where the formation points and never swings through its neighbours)
		faceTo(unit, if d > num("FaceMoveStuds", 8) then goal - pos else (st._afDir or Vector3.new(0, 0, -1)), now)
		-- arrive: stand in the slot while the owner stands
		if d <= num("ArriveStuds", 2) and (st._afSpeed or 0) < 1 and push.Magnitude < 0.05 then
			if not unit._afStand then
				unit._afStand = true
				ArmyFollow.Command(unit, pos, "InPosition")
				unit._afMoveGoal = pos
				unit._afMoveAt = now
			end
			unit._afPath = nil
			return
		end
	end
	unit._afStand = false

	-- claude-bud (hold fix): outside his plot while he is in it: straight to the cell; if that line would clip his plot
	-- square, first to the nearest outside corner point (the plot is never crossed, no path through the gate)
	if holdOut and st._afPlot then
		local via = holdVia(st._afPlot, pos, goal)
		unit._afPath = nil
		moveTo(unit, via, now)
		return
	end
	-- v99 stuck stage 2: the alternate point beside it, for a short spell
	local alt = unit._afAlt
	if alt then
		if now < alt.Until and flatDist(pos, alt.P) > 1.5 then
			moveTo(unit, keepOut(alt.P), now)
			return
		end
		unit._afAlt = nil
	end
	-- movement: straight while it sees the slot, a throttled path only when blocked
	if clearLine(pos, goal) then
		unit._afPath = nil
		moveTo(unit, goal, now)
		return
	end
	local path = unit._afPath
	-- v99: a path is kept while its end is within PathKeepStuds of the slot OR it is younger than PathKeepSeconds (at
	-- a run the slot moved > 8 studs every think and the path was dropped each time)
	if path and (flatDist(path.Goal, goal) <= num("PathKeepStuds", 12) or now - (path.At or 0) < num("PathKeepSeconds", 2)) and path.I <= #path.Points then
		local wp = path.Points[path.I]
		-- v99: skip every waypoint already reached or passed between thinks (never walk back to one)
		while wp do
			local nxt = path.Points[path.I + 1]
			if flatDist(pos, wp.Position) < 3 or (nxt ~= nil and flatDist(pos, nxt.Position) < flatDist(wp.Position, nxt.Position)) then
				path.I += 1
				wp = path.Points[path.I]
			else
				break
			end
		end
		if wp then
			if wp.Action == Enum.PathWaypointAction.Jump then
				unit.Humanoid.Jump = true
			end
			moveTo(unit, keepOut(wp.Position), now)
			return
		end
	end
	requestPath(unit, pos, goal, now)
	-- while the path is computed (or none exists), v99: each unit walks to its OWN point, half-way from him to its
	-- slot when it can see that (else the slot itself). Before, every unit walked to the SAME point 4 studs behind
	-- him = the blob round buildings.
	local mid = root.Position + (slot - root.Position) * 0.5
	moveTo(unit, if st._afInBase then goal else keepOut(if clearLine(pos, mid) then mid else goal), now)
end

-- claude-bud JOB 22: is the owner moving (the escort-vs-follow switch), with hysteresis (no flicker at ~2 studs/s)
function ArmyFollow.OwnerMoving(st: any, speed: number): boolean
	if not stableOn() then
		return speed >= 2
	end
	local m = FormationMath.Moving(st._afOwnerMoving == true, speed, cfg())
	st._afOwnerMoving = m
	return m
end

-- claude-bud JOB 22: this unit's formation slot (the SAME one ArmyFollow walks it to), for the escort's standing fight
function ArmyFollow.HomePoint(player: Player?, st: any, unit: any, root: BasePart, now: number): Vector3
	plan(st, player, root, st.Units, now)
	return slotPoint(st, root, unit._afRank or 1)
end

-- ── v114: helpers ArmyController (Follow3) shares with this module (same plot / hold rules, same rays) ──────────────
ArmyFollow.Follow3On = follow3On
ArmyFollow.ClearLine = clearLine
ArmyFollow.GroundAt = groundAt
ArmyFollow.RefreshRayFilter = refreshRayFilter
ArmyFollow.InPlot = inPlot
ArmyFollow.HoldVia = holdVia
ArmyFollow.HoldSpot = function(plotId: number, rank: number): (Vector3, Vector3)
	return tidyWaitSpot(plotId, rank)
end
-- his base state for this pass (the Tidy hold: inside / near his own plot square, with hysteresis); sets the same
-- st._afTidy / _afInBase / _afPlot / _afOwnPlot / _afLeftBaseAt fields plan() does
function ArmyFollow.BaseState(st: any, player: Player?, pos: Vector3, now: number): (boolean, number?)
	st._afTidy = tidyLive(player)
	local plotId = ownPlotInside(st, player, pos)
	local wasIn = st._afInBase
	st._afInBase = plotId ~= nil
	st._afPlot = plotId
	st._afOwnPlot = ownPlotId(player)
	if wasIn and not st._afInBase then
		st._afLeftBaseAt = now
	end
	if st._afInBase ~= wasIn and player then
		logLine("base" .. tostring(player.UserId), string.format("owner %d %s his base: army %s", player.UserId, if plotId then "entered" else "left", if plotId then "waits at the gate" else "follows"))
	end
	return st._afInBase == true, plotId
end

return ArmyFollow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">ArmyPlan</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 38 (2026-09-30): ARMY ORDER PLANS (ArmyOrdersConfig). Server only; one plan per owner.
	  * CLEAR (ATTACK, live owners): SEEK the nearest hostile group within SeekRadius of the owner (the ONE target pick:
	    SquadOrdersService pickSquadTarget with plan overrides, so the same hostility rule), MARCH to it, FIGHT it until
	    the group is gone (or out of reach / non-hostile), chain to the next within ChainRadius (MaxChain), then RETURN
	    and fold into FOLLOW.
	  * SEND (the map's SEND ARMY): the fairness verdict (ArmySendRules), MARCH to the victim's gate, SIEGE in
	    Siege.Priority order (turret -> guard -> gate -> inside guard -> ATM) with real shots through the existing damage
	    paths, the ATM hold (Raid.HoldSeconds, the lead unit not hit), the loot (MoneyCollectorService.ArmyRaid), RETURN.
	  * RECALL: any plan -> RETURN (march back, fold into FOLLOW).
	MOVEMENT: the plan owns a LEAD POINT. ArmyController steers the SAME formation block after it instead of the owner
	(ArmyController.PlanLead), so the block keeps Follow3's formation standard (rate-limited heading, SlotLateralSpeed,
	speed caps). The lead walks an ArmyRoute path at MarchSpeed and waits while the block is more than LeadMaxGap
	behind (the block goes at its slowest soldier's pace). During a plan NOTHING repositions a unit: ArmyController
	passes AllowRecover = false and NoReposition = true (SoldierController marks a unit that cannot follow LOST; this
	module reports it). No teleport, no PivotTo, no fast travel.
	The owner stays where he is; an owner-dead SEND keeps going while he is in the server (Send.RequireOwnerAlive).
Code Bot (army command bug, 2026-10-01): plans no longer write st.Order; every phase change goes through ArmyState.Set
(the one writer; opts.Plan = true) and the state the owner sees is the plan's: Attacking / EngagingTarget (CLEAR),
TravellingToBase / EngagingTarget (SEND to a base, TRAVEL to an area / site), Recalling (RETURN), Retreating (RETREAT).
New kinds: TRAVEL (StartTravel: the map's SEND to an area / site -> its ArmyTargets approach point -> clear the hostiles
there -> HOLD) and RETREAT (StartRetreat: a far army marches home as a block). ArmyPlan.Cancel ends a plan cleanly
(bound as ArmyState's CancelPlan: any non-plan state drops it). ProbeClear: the ATTACK target check before the order.
Code Bot v145 (owner phone test: "sending my army ... they don't go"): every route starts at the BLOCK (its centre), not
at the owner (from inside his walled base the closed gate gave NoPath: "No route" + HOLD); the lead is placed
ArmyController.Standoff studs along the route, and "the block is behind" is measured past that standoff (a block deeper
than LeadMaxGap never moved); RETURN goes to his gate spot while he is inside his base (or when he cannot be reached).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ArmyOrdersConfig = require(Shared.Configs.ArmyOrdersConfig)
local ArmyConfig = require(Shared.Configs.ArmyConfig)
local RaidConfig = require(Shared.Configs.RaidConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local ArmyRoute = require(script.Parent.ArmyRoute)
local Rules = require(script.Parent.ArmySendRules)
local ArmyLog = require(Shared.Util.ArmyLog)
local ArmyState = require(script.Parent.ArmyState)
local ArmyTargets = require(script.Parent.ArmyTargets)
local ArmyCommand = require(script.Parent.ArmyCommand)

local ArmyPlan = {}

local C = ArmyOrdersConfig
local T = C.Text

export type Group = { Kind: string, GroupId: string?, Hum: any, Root: BasePart, Name: string, Player: Player? }
export type Plan = {
	Kind: string, -- "Clear" | "Send" | "Return" | "Travel" | "Retreat"
	Phase: string, -- "Seek" | "March" | "Fight" | "Siege" | "Loot" | "Return"
	Uid: number,
	Owner: Player,
	Gen: number,
	Lead: Vector3,
	LeadVel: Vector3,
	LeadLook: Vector3,
	LastAt: number,
	Dest: Vector3?,
	Route: { Vector3 }?,
	RouteIdx: number,
	Routing: boolean,
	RoutedAt: number,
	ProgPos: Vector3?,
	ProgAt: number,
	Group: Group?,
	GroupAlive: number,
	FightSince: number,
	Chain: number,
	Kills: number,
	SeekFrom: string, -- "owner" | "army"
	Bad: { [any]: boolean }, -- targets that had no route (skipped by the next seek)
	-- SEND
	Victim: Player?,
	VictimUid: number,
	VictimName: string,
	PlotId: number,
	Bully: boolean,
	SiegeAt: number?,
	Breached: boolean,
	Funnel: any?, -- v165: the broken gate a raid walks through (ArmyController.Funnel)
	NoLoot: string?,
	HoldUnit: any,
	HoldSince: number?,
	HoldHp: number,
	Looted: number,
	ThenOrder: string?,
	Total: number,
	Status: string,
	StatusAt: number,
	LostCount: number,
	Squad: any, -- Code Bot v145: the squad state (the block's centre / standoff for the route start and the gap)
	ReturnGate: boolean?, -- Code Bot v145: RETURN re-aimed at his gate spot (he is inside his walled base)
	Target: any, -- Code Bot (army command bug): TRAVEL's ArmyTargets target
	EngageSince: number?,
	ClearSince: number?,
	Anchor: Vector3?, -- CLEAR started away from him: the leash centre, and it HOLDS there when done (no march back)
	HoldWhenDone: boolean?,
	ThenState: string?, -- the state after finish (default Following)
	MoveLogAt: number?,
}

local deps: { [string]: any } = {}
local plans: { [number]: Plan } = {}
local probing: number? = nil -- Code Bot: ProbeClear's owner (AllowsNpcGroup lets the probe see what ATTACK would)
local logAt: { [string]: number } = {}
local clock: () -> number = os.clock
local gen = 0

local function live(uid: number): boolean
	return ArmyOrdersConfig.LiveFor(uid)
end

local function flatDist(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

local function debugOn(player: Player): boolean
	local ok, AC = pcall(function(): any
		return require(script.Parent.ArmyController)
	end)
	return ok and AC and AC.DebugFor and AC.DebugFor(player) == true
end

-- [ArmyPlan] / [ArmyRoute] / [ArmyMarch] / [ArmySiege] / [ArmyFair]: /armydebug owners only, rate-limited per tag
local function dbg(player: Player, tag: string, text: string, force: boolean?)
	if not debugOn(player) then
		return
	end
	local key = tostring(player.UserId) .. tag
	local now = clock()
	if not force and now - (logAt[key] or -math.huge) < C.DebugLogSeconds then
		return
	end
	logAt[key] = now
	print(string.format("[%s] %s %s", tag, player.Name, text))
end

local function notify(player: Player?, text: string, kind: string?)
	local ns = deps.NotificationService
	if player and player.Parent and ns and ns.Notify then
		pcall(ns.Notify, player, text, kind or "Info", 4)
	end
end

local function ownerRoot(player: Player): BasePart?
	local c = player.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if r and r:IsA("BasePart") and h and h.Health > 0 then
		return r
	end
	return nil
end

local function profileOf(p: Player): any
	return deps.DataService and deps.DataService.GetProfile(p)
end

local function raidOf(profile: any): any
	if typeof(profile.Raid) ~= "table" then
		profile.Raid = {}
	end
	return profile.Raid
end

local function livingUnits(st: any): ({ any }, Vector3?)
	local out = {}
	local sum, n = Vector3.zero, 0
	for _, u in ipairs(st.Units) do
		if u.Alive and u.Humanoid and u.Humanoid.Health > 0 and u.Root and u.Root.Parent then
			table.insert(out, u)
			sum += u.Root.Position
			n += 1
		end
	end
	return out, if n > 0 then sum / n else nil
end

-- ── the lead point and the route ─────────────────────────────────────────────────────────────────────────────────
-- Code Bot v145: how far behind the lead the steered block holds its centre by design (ArmyController.Standoff:
-- FirstRowStuds + half its depth, at least its radius + BubbleStuds; 0 before it formed / in the unit tests)
local function standoffOf(st: any): number
	if st == nil then
		return 0
	end
	local ok, v = pcall(function(): any
		local AC = require(script.Parent.ArmyController) :: any
		return AC.Standoff(st)
	end)
	return if ok and typeof(v) == "number" and v == v then math.max(0, v) else 0
end

-- the block's centre (its living units' mean), or nil
local function blockCentre(st: any): Vector3?
	if st == nil or typeof(st.Units) ~= "table" then
		return nil
	end
	local _, c = livingUnits(st)
	return c
end

--[[ Code Bot v145 (owner: "sending my army ... they don't go"): the route starts where the ARMY stands (its block
	centre, a reachable point), never at the owner: from inside his walled base (the army waits outside his gate) the
	closed gate barrier (CanCollide) gives PathfindingService NoPath and the SEND ended "No route" + HOLD before a step.
	Once routed, the lead point is placed Standoff studs along the route from the block, so the block's formation spot
	is where it already stands: nobody walks back, nobody is moved (the lead is a virtual point). ]]
local function setDest(plan: Plan, dest: Vector3)
	ArmyLog.Line(plan.Owner, "ARMY DESTINATION", string.format("%s old=%s new=%s source=ArmyPlan.%s/%s", plan.Owner.Name, ArmyLog.Vec(plan.Dest), ArmyLog.Vec(dest), plan.Kind, plan.Phase))
	plan.Dest = dest
	pcall(function()
		plan.Owner:SetAttribute("WE_ArmyDest", dest) -- the ARMY's destination (the map marks it; never his PIN)
	end)
	plan.Route = nil
	plan.RouteIdx = 1
	plan.Routing = true
	plan.RoutedAt = clock()
	local pa: any = plan
	local seq = (pa.RouteSeq or 0) + 1
	pa.RouteSeq = seq -- v165: a re-plan (the routing watchdog) supersedes a slow path request
	local g = plan.Gen
	local st = plan.Squad
	local c = blockCentre(st)
	local start = if c then c else plan.Lead
	local standoff = standoffOf(st)
	task.spawn(function()
		local route, why = ArmyRoute.Plan(start, dest)
		local cur = plans[plan.Uid]
		if cur ~= plan or plan.Gen ~= g or (plan :: any).RouteSeq ~= seq then
			return
		end
		plan.Routing = false
		ArmyLog.Line(plan.Owner, "ARMY PATH", string.format("%s start=%s dest=%s distance=%.0f status=%s waypoints=%d", plan.Owner.Name, ArmyLog.Vec(start), ArmyLog.Vec(dest),
			flatDist(start, dest), if route then "Success" else tostring(why), if route then #route else 0))
		if route then
			plan.Route = route
			if c then
				plan.Lead, plan.RouteIdx = ArmyRoute.PointAlong(start, route, standoff)
			end
			dbg(plan.Owner, "ArmyRoute", string.format("%d waypoints, %.0f studs, legs %d", #route, flatDist(start, dest), #ArmyRoute.Legs(start, dest)), true)
		else
			plan.Route = nil
			dbg(plan.Owner, "ArmyRoute", "no route: " .. tostring(why), true)
			ArmyPlan._NoRoute(plan)
		end
	end)
end

-- the lead walks its route while the block keeps up (the block goes at its slowest soldier's pace)
local function advance(plan: Plan, centre: Vector3, dt: number)
	local route = plan.Route
	if route == nil or plan.Routing then
		plan.LeadVel = Vector3.zero
		-- v165 (owner report: "MARCHING" but stopped): advance() returned here for ever while a path request never came
		-- back, so the stuck re-plan below never ran. A path still outstanding after RoutingTimeout is asked again.
		if plan.Routing and plan.Dest and clock() - plan.RoutedAt >= (C.RoutingTimeoutSeconds or 20) then
			ArmyLog.Line(plan.Owner, "ARMY MOVE", string.format("%s stalled: path request %.0fs old, re-plan", plan.Owner.Name, clock() - plan.RoutedAt))
			setDest(plan, plan.Dest :: Vector3)
		end
		return
	end
	-- Code Bot v145: "behind" = past the block's own formation spot (its centre sits Standoff behind the lead by design),
	-- not the raw distance: a block deeper than LeadMaxGap (8 units + escorts: 16+ studs) made the lead wait for ever
	local blockAt = centre
	local toLead = Vector3.new(plan.Lead.X - centre.X, 0, plan.Lead.Z - centre.Z)
	if toLead.Magnitude > 1e-3 then
		centre = centre + toLead.Unit * math.min(standoffOf(plan.Squad), toLead.Magnitude)
	end
	if flatDist(plan.Lead, centre) > C.LeadMaxGap then
		plan.LeadVel = Vector3.zero -- wait for the block
		local now0 = clock()
		local pm: any = plan
		if now0 - (pm.WaitLogAt or 0) >= 3 then
			pm.WaitLogAt = now0
			local tg = plan.Squad and plan.Squad._acTarget
			ArmyLog.Line(plan.Owner, "ARMY MOVE", string.format("%s lead waiting for the block: gap %.0f (max %d) block=%s engaging=%s",
				plan.Owner.Name, flatDist(plan.Lead, centre), C.LeadMaxGap, ArmyLog.Vec(blockAt),
				if tg then tostring(tg.Kind) .. ":" .. (if tg.Player then tg.Player.Name else "?") else "none"))
		end
	else
		local pos, idx, dir = ArmyRoute.Advance(plan.Lead, route, plan.RouteIdx, C.MarchSpeed, dt)
		plan.Lead, plan.RouteIdx = pos, idx
		plan.LeadVel = dir * C.MarchSpeed
		if dir.Magnitude > 0 then
			plan.LeadLook = dir
		end
	end
	-- no block progress for StuckSeconds while waiting: plan the leg again from the block (at most every RepathSeconds)
	local now = clock()
	centre = blockAt -- (progress: where the block itself is)
	if plan.ProgPos == nil or flatDist(plan.ProgPos :: Vector3, centre) > 4 then
		plan.ProgPos = centre
		plan.ProgAt = now
	elseif now - plan.ProgAt >= C.StuckSeconds and now - plan.RoutedAt >= C.RepathSeconds and plan.Dest then
		plan.ProgAt = now
		dbg(plan.Owner, "ArmyRoute", "blocked: re-plan from the block", true)
		setDest(plan, plan.Dest :: Vector3) -- (from the block; the lead is placed ahead of it, never back onto it)
	end
end

local function routeDone(plan: Plan): boolean
	return plan.Route ~= nil and not plan.Routing and plan.RouteIdx > #(plan.Route :: { Vector3 })
end

-- ── groups (what "clear it" means) ───────────────────────────────────────────────────────────────────────────────
local function groupOf(t: any): Group?
	if t == nil or t.Root == nil then
		return nil
	end
	if t.Kind == "NPC" then
		local model = t.Hum and t.Hum.Parent
		local npcId = model and model:GetAttribute("NPCId")
		local cs = deps.CombatService
		local gid = if typeof(npcId) == "string" and cs and cs.NPCGroupOf then cs.NPCGroupOf(npcId) else nil
		local name = if typeof(gid) == "string" then (string.match(gid, "([^%.]+)$") or gid) else (model and model.Name or "enemies")
		return { Kind = "NPC", GroupId = gid, Hum = t.Hum, Root = t.Root, Name = name }
	elseif t.Kind == "Player" then
		return { Kind = "Player", Hum = t.Hum, Root = t.Root, Name = if t.Player then t.Player.Name else "player", Player = t.Player }
	end
	return { Kind = t.Kind or "Guard", Hum = t.Hum, Root = t.Root, Name = "defenders" }
end

-- how many of the group are still up (0 = cleared); a player who became protected counts as gone
function ArmyPlan.GroupAlive(owner: Player, g: Group): number
	local cs = deps.CombatService
	if g.Kind == "NPC" and g.GroupId and cs and cs.GroupNPCs then
		local ok, list = pcall(cs.GroupNPCs, g.GroupId)
		return if ok and typeof(list) == "table" then #list else 0
	end
	if g.Kind == "Player" and g.Player and cs and cs.UnitMayHitPlayer then
		local ok, may = pcall(cs.UnitMayHitPlayer, owner, g.Player)
		if not (ok and may == true) then
			return 0
		end
	end
	local h = g.Hum
	return if h and h.Health > 0 and g.Root.Parent ~= nil then 1 else 0
end

local function groupPos(g: Group): Vector3
	local cs = deps.CombatService
	if g.Kind == "NPC" and g.GroupId and cs and cs.GroupNPCs then
		local ok, list = pcall(cs.GroupNPCs, g.GroupId)
		if ok and typeof(list) == "table" and list[1] then
			return list[1].Position
		end
	end
	return g.Root.Position
end

-- ── status (the walkie line + HUD strip) ─────────────────────────────────────────────────────────────────────────
local function setStatus(plan: Plan, text: string)
	local now = clock()
	if plan.Status ~= text or now - plan.StatusAt >= C.StatusSeconds then
		local changed = plan.Status ~= text
		plan.Status = text
		plan.StatusAt = now
		if changed and deps.SquadOrdersService and deps.SquadOrdersService.Push then
			pcall(deps.SquadOrdersService.Push, plan.Owner)
		end
	end
end

function ArmyPlan.Status(uid: number): { [string]: any }?
	local plan = plans[uid]
	if plan == nil then
		return nil
	end
	return { Kind = plan.Kind, Phase = plan.Phase, Text = plan.Status, Target = if plan.Kind == "Send" then plan.VictimName elseif plan.Kind == "Travel" and plan.Target then plan.Target.Name elseif plan.Group then plan.Group.Name else nil, Lost = plan.LostCount }
end

-- Code Bot (army command bug): the ArmyState a plan shows (one table, every kind / phase)
function ArmyPlan.StateFor(plan: Plan): string
	if plan.Phase == "Return" then
		return "Recalling"
	end
	if plan.Kind == "Retreat" then
		return "Retreating"
	end
	if plan.Kind == "Clear" then
		return if plan.Phase == "Fight" then "EngagingTarget" else "Attacking"
	end
	if plan.Kind == "Send" or plan.Kind == "Travel" then
		return if plan.Phase == "March" then "TravellingToBase" else "EngagingTarget"
	end
	return "Recalling"
end

local function targetName(plan: Plan): string?
	if plan.Kind == "Send" then
		return plan.VictimName .. "'s base"
	elseif plan.Kind == "Travel" and plan.Target then
		return plan.Target.Name
	elseif plan.Group then
		return plan.Group.Name
	end
	return nil
end

-- every phase change: the plan's state through THE one writer (a no-op while unchanged)
local function syncState(plan: Plan, st: any, source: string)
	if st == nil or plans[plan.Uid] ~= plan then
		return
	end
	ArmyState.Set(plan.Owner, st, ArmyPlan.StateFor(plan), source, { Plan = true, Target = targetName(plan) })
end

-- ── lifecycle ────────────────────────────────────────────────────────────────────────────────────────────────────
local function newPlan(player: Player, kind: string, lead: Vector3): Plan
	gen += 1
	local p: Plan = {
		Kind = kind, Phase = "Seek", Uid = player.UserId, Owner = player, Gen = gen,
		Lead = lead, LeadVel = Vector3.zero, LeadLook = Vector3.new(0, 0, -1), LastAt = clock(),
		Dest = nil, Route = nil, RouteIdx = 1, Routing = false, RoutedAt = -math.huge, ProgPos = nil, ProgAt = clock(),
		Group = nil, GroupAlive = 0, FightSince = clock(), Chain = 0, Kills = 0, SeekFrom = "owner", Bad = {},
		Victim = nil, VictimUid = 0, VictimName = "", PlotId = 0, Bully = false, SiegeAt = nil, Breached = false,
		NoLoot = nil, HoldUnit = nil, HoldSince = nil, HoldHp = 0, Looted = 0, ThenOrder = nil, Total = 0,
		Status = "", StatusAt = -math.huge, LostCount = 0, Squad = nil, ReturnGate = nil,
		Target = nil, EngageSince = nil, ClearSince = nil, Anchor = nil, HoldWhenDone = nil, ThenState = nil, MoveLogAt = nil,
	}
	local old = plans[player.UserId]
	if old then
		ArmyLog.Line(player, "ARMY MOVE", string.format("%s plan %s/%s replaced by %s", player.Name, old.Kind, old.Phase, kind))
	end
	plans[player.UserId] = p
	return p
end

local function finish(plan: Plan, st: any?)
	if plans[plan.Uid] ~= plan then
		return
	end
	plans[plan.Uid] = nil
	pcall(function()
		plan.Owner:SetAttribute("WE_ArmyDest", nil)
	end)
	local sqs = deps.SquadOrdersService
	if st then
		st._acTarget = nil
	end
	local thenOrder = plan.ThenOrder
	local done = false
	if thenOrder ~= nil and thenOrder ~= "Follow" and thenOrder ~= "Attack" and sqs and sqs.SetOrder then
		local okS, res = pcall(sqs.SetOrder, plan.Owner, thenOrder, "ArmyPlan.finish") -- Hold / Retreat now (the plan is gone: a normal order)
		done = okS and res == true
	end
	if not done and st then
		-- (one writer: Following, or the plan's ThenState - an ATTACK started away from him holds where it ended)
		ArmyState.Set(plan.Owner, st, plan.ThenState or "Following", "ArmyPlan.finish " .. plan.Kind)
	elseif not done and sqs and sqs.Push then
		pcall(sqs.Push, plan.Owner)
	end
	ArmyLog.Line(plan.Owner, "ARMY MOVE", string.format("%s plan %s ended -> %s", plan.Owner.Name, plan.Kind, tostring(thenOrder or plan.ThenState or "Following")))
	dbg(plan.Owner, "ArmyPlan", "done -> " .. tostring(plan.ThenOrder or "Follow"), true)
end

-- march back to the owner (or his base while he is dead), then FOLLOW
-- Code Bot v145: his gate spot (outside it, Send.StandoffStuds out), or nil
local function gateSpot(owner: Player): Vector3?
	local profile = profileOf(owner)
	local gd = deps.GateDefenseService
	local plotId = profile and profile.BasePlotId
	local cf = if typeof(plotId) == "number" and gd and gd.GetGateCFrame then gd.GetGateCFrame(plotId) else nil
	return if cf then ((cf :: CFrame) * CFrame.new(0, 0, C.Send.StandoffStuds)).Position else nil
end

-- he stands inside his own (walled) plot: the army comes home to his gate, as FOLLOW's base hold does
local function ownerInOwnPlot(owner: Player, pos: Vector3): boolean
	local profile = profileOf(owner)
	local plotId = profile and profile.BasePlotId
	if typeof(plotId) ~= "number" then
		return false
	end
	local ok, inside = pcall(function(): any
		local AF = require(script.Parent.ArmyFollow) :: any
		return AF.InPlot(plotId, pos, 6)
	end)
	return ok and inside == true
end

-- where RETURN walks to: him, or his gate spot while he is dead / inside his base
local function returnDest(plan: Plan): Vector3
	local r = ownerRoot(plan.Owner)
	if r and not ownerInOwnPlot(plan.Owner, r.Position) then
		plan.ReturnGate = nil
		return r.Position
	end
	local g = gateSpot(plan.Owner)
	if g then
		plan.ReturnGate = true
		return g
	end
	return if r then r.Position else plan.Lead
end

local function toReturn(plan: Plan, why: string?)
	plan.Phase = "Return"
	plan.Group = nil
	setDest(plan, returnDest(plan))
	syncState(plan, plan.Squad, "ArmyPlan.return " .. tostring(why or ""))
	dbg(plan.Owner, "ArmyPlan", "RETURN " .. tostring(why or ""), true)
end

function ArmyPlan._NoRoute(plan: Plan)
	if plan.Phase == "Return" and plan.ReturnGate ~= true then
		local g = gateSpot(plan.Owner)
		if g then
			plan.ReturnGate = true -- (he is somewhere the army cannot walk to: home to his gate instead)
			setDest(plan, g)
			return
		end
	end
	if plan.Kind == "Clear" and plan.Group then
		plan.Bad[plan.Group.Root] = true -- skip it; seek the next
		plan.Group = nil
		plan.Phase = "Seek"
		plan.SeekFrom = "army"
		return
	end
	notify(plan.Owner, string.format(T.NoRoute, targetName(plan) or "there"), "Warn")
	ArmyLog.Reject(plan.Owner, "route " .. plan.Kind, "NoRoute", "dest=" .. ArmyLog.Vec(plan.Dest))
	-- the army stops and holds where it is (no teleport fallback)
	plan.ThenOrder = "Hold"
	local sqs = deps.SquadOrdersService
	finish(plan, if sqs and sqs.StateOf then sqs.StateOf(plan.Owner) else nil)
end

function ArmyPlan.Owns(uid: number): boolean
	return plans[uid] ~= nil
end

-- a SEND army does not refill at its owner while it is out (it would spawn far behind the block)
function ArmyPlan.HoldsRefill(uid: number): boolean
	local p = plans[uid]
	return p ~= nil and (p.Kind == "Send" or p.Kind == "Travel") -- Code Bot: a TRAVEL army is out too
end

-- the lead point ArmyController steers the block after (nil = follow the owner as always)
function ArmyPlan.LeadFor(player: Player): { [string]: any }?
	local p = plans[player.UserId]
	if p == nil then
		return nil
	end
	local look = if p.LeadLook.Magnitude > 0 then p.LeadLook else Vector3.new(0, 0, -1)
	return {
		Root = {
			Position = p.Lead,
			CFrame = CFrame.lookAt(p.Lead, p.Lead + look),
			AssemblyLinearVelocity = p.LeadVel,
			Parent = nil,
		},
		Funnel = p.Funnel, -- v165: through the broken gate
	}
end

-- SEND damage keeps landing while the sender is dead but in the server (GateDefenseService.ApplyUnitDamage opts)
function ArmyPlan.DamageOpts(player: Player): { [string]: any }?
	local p = plans[player.UserId]
	if p and p.Kind == "Send" and C.Send.RequireOwnerAlive ~= true then
		return { OwnerAway = true }
	end
	return nil
end

-- an ordered auto-clear may engage grouped NPCs its owner is not standing next to (CombatService.SetUnitPlanCheck)
function ArmyPlan.AllowsNpcGroup(owner: Player, _groupId: string?): boolean
	if probing == owner.UserId then
		return true -- Code Bot: ProbeClear sees what the ATTACK order would
	end
	local p = plans[owner.UserId]
	if p ~= nil and p.Kind == "Travel" and p.Phase == "Engage" then
		return true -- Code Bot: the army sent to an area clears its defenders
	end
	return p ~= nil and p.Kind == "Clear" and p.Phase ~= "Return"
end

-- the defender's red map markers: armies marching on / sieging his base
function ArmyPlan.IncomingFor(uid: number): { any }?
	local out = nil
	for _, p in pairs(plans) do
		if p.Kind == "Send" and p.VictimUid == uid and (p.Phase == "March" or p.Phase == "Siege" or p.Phase == "Loot") then
			out = out or {}
			table.insert(out, { X = math.floor(p.Lead.X), Z = math.floor(p.Lead.Z), N = p.Owner.Name })
		end
	end
	return out
end

-- the one target pick with a plan's centre / reach / leash (SquadOrdersService pickSquadTarget)
local function pickWith(pick: any, player: Player, st: any, proot: BasePart?, opts: { [string]: any }): any
	local ok = pcall(pick, player, st, proot, opts)
	return if ok then st._acTarget else nil
end

--[[ Code Bot v165 (owner phone bug "ARMY: SIEGE gate 100% guns 0", the army stood against the wall). PROVEN
	(tools/sim/run_army_siege_test.py, docs/proof/army-siege/): the siege pick took ANY hostile within ReachStuds of the
	block - the victim standing in his yard, a guard inside - ahead of the gate (players first, then Siege.Priority).
	Behind the wall none of them can be seen: every unit's line of sight hit the wall (no shot; the gate fallback only
	fires when the ray hits a gate leaf), and the block steered AttackStandoff from that target - into the wall, away from
	the gate - for the whole SiegeMaxSeconds. Rule now: until the gate is breached, a player / guard / turret INSIDE the
	victim's walled plot is not a siege target (the gate is); after the breach they are, as before. ]]
local function behindWalls(info: any, pos: Vector3): boolean
	local c, h = info.PadCenter, tonumber(info.PadHalf)
	if typeof(c) ~= "Vector3" or h == nil then
		return false
	end
	return math.abs(pos.X - c.X) <= h and math.abs(pos.Z - c.Z) <= h
end

--[[ v165 (owner report 3: "ARMY: MARCHING ->" but the army stood still against another base's wall / around a player
	by a runway): on the march the pick took ANY hostile player within 120 studs as the target, and ArmyController
	steered the whole block at him. A player in his own yard behind his wall cannot be shot (every ray hits the wall), so
	the block pressed against that wall, the lead waited for it (gap > LeadMaxGap) and the status still said MARCHING.
	On the march only a player who has HURT him or his soldiers in the last MarchAnswerSeconds is answered, only within
	MarchAnswerStuds of the block, and never one behind the walls of a walled plot; anyone else is ignored. ]]
local function marchAnswer(pick: any, player: Player, st: any, proot: BasePart?, centre: Vector3, leash: number): any
	local t = pickWith(pick, player, st, proot, { Centre = centre, Reach = C.MarchAnswerStuds or 60, LeashFrom = centre, Leash = leash })
	-- (a "Unit" = an enemy army soldier, claude-bud JOB 43 brawl: answered under the same rule - his soldiers hurting
	-- ours count as him hurting us, CombatService.NoteArmyAggressor)
	if t == nil or (t.Kind ~= "Player" and t.Kind ~= "Unit") or t.Player == nil then
		return nil
	end
	local cs = deps.CombatService
	local okH, hurt = pcall(function()
		return cs ~= nil and cs.RecentlyHurtBy ~= nil and cs.RecentlyHurtBy(player, t.Player, C.MarchAnswerSeconds or 10)
	end)
	if not (okH and hurt) then
		return nil
	end
	local gd = deps.GateDefenseService
	local root = t.Root
	if gd and gd.WalledPlotAt and root then
		local okP, pid = pcall(gd.WalledPlotAt, root.Position)
		if okP and pid ~= nil then
			return nil
		end
	end
	return t
end

-- ── ATTACK auto-clear ────────────────────────────────────────────────────────────────────────────────────────────
function ArmyPlan.StartClear(player: Player, st: any, from: Vector3?, seed: any?): boolean
	if not live(player.UserId) or st == nil then
		return false
	end
	local r = ownerRoot(player)
	local _, centre = livingUnits(st)
	if (r == nil and from == nil) or centre == nil then
		return false
	end
	local p = newPlan(player, "Clear", if from then centre :: Vector3 else (r :: BasePart).Position)
	p.Squad = st
	p.SeekFrom = "owner"
	if from then
		-- Code Bot: an ATTACK away from him (the army holds / travels out there): the leash centre is the army, and
		-- once the fight is done it holds there (no 1,000-stud march back mid-map)
		p.Anchor = from
		p.HoldWhenDone = true
		p.SeekFrom = "army"
	end
	setStatus(p, T.Seeking)
	local g = groupOf(seed)
	if g then
		-- the target ProbeClear found: straight to MARCH (no second seek)
		p.Group = g
		p.GroupAlive = ArmyPlan.GroupAlive(player, g)
		p.Phase = "March"
		setDest(p, groupPos(g))
	end
	syncState(p, st, "ATTACK")
	ArmyLog.Line(player, "ARMY MOVE", string.format("%s ATTACK started target=%s from=%s", player.Name, if g then g.Kind .. " " .. g.Name else "seek", ArmyLog.Vec(from or (r and r.Position))))
	dbg(player, "ArmyPlan", "CLEAR start", true)
	return true
end

--[[ Code Bot (army command bug): what an ATTACK order would target, BEFORE the order is taken (the one target pick,
	the one hostility rule, the order's own radius SeekRadius from `from`). nil = "No enemies near" and the army keeps
	its state. The squad's current target is left as it was. ]]
function ArmyPlan.ProbeClear(player: Player, st: any, pick: any, from: Vector3): any
	if st == nil or pick == nil then
		return nil
	end
	local keep = st._acTarget
	local seek, leash = C.AttackRadii(player.UserId) -- claude-bud JOB 52: AttackRange live = 400 / 450 (else 250 / 300)
	probing = player.UserId
	local t = pickWith(pick, player, st, ownerRoot(player), { Centre = from, Reach = seek, LeashFrom = from, Leash = leash })
	probing = nil
	st._acTarget = keep
	ArmyLog.Line(player, "ARMY MOVE", string.format("%s ATTACK probe from=%s radius=%d -> %s", player.Name, ArmyLog.Vec(from), seek,
		if t then tostring(t.Kind) .. " at " .. ArmyLog.Vec(t.Root and t.Root.Position) else "none"))
	return t
end

--[[ claude-bud JOB 52: nothing within the ATTACK range: the nearest valid enemy beyond it (the SAME pick and hostility
	rule, reach NearestScanStuds), as (target, flat distance, the NPCId when it is a combat NPC). nil = none anywhere. ]]
function ArmyPlan.NearestBeyond(player: Player, st: any, pick: any, from: Vector3): (any, number?, string?)
	if st == nil or pick == nil then
		return nil, nil, nil
	end
	local A: any = C.AttackRange
	local far = tonumber(A and A.NearestScanStuds) or 2500
	local keep = st._acTarget
	probing = player.UserId
	local t = pickWith(pick, player, st, ownerRoot(player), { Centre = from, Reach = far, LeashFrom = from, Leash = far })
	probing = nil
	st._acTarget = keep
	if t == nil or t.Root == nil then
		return nil, nil, nil
	end
	local model = t.Hum and t.Hum.Parent
	local id = if model then model:GetAttribute("NPCId") else nil
	return t, flatDist(from, t.Root.Position), if typeof(id) == "string" then id else nil
end

-- claude-bud JOB 52: does this army NPC kill count on ARMY KILLS? Only the target group of HIS running ATTACK (Clear)
-- plan, at most AttackRange.KillCreditPerHour per owner per rolling hour (no AFK farm), only while AttackRange is live.
local creditLog: { [number]: { number } } = {}
function ArmyPlan.CreditsArmyKill(killer: Player, info: any): boolean
	if not C.AttackRangeLive(killer.UserId) or typeof(info) ~= "table" then
		return false
	end
	local plan = plans[killer.UserId]
	if plan == nil or plan.Kind ~= "Clear" or plan.Group == nil then
		return false
	end
	local g = plan.Group :: Group
	if g.Kind ~= "NPC" then
		return false
	end
	local same = (g.GroupId ~= nil and info.GroupId == g.GroupId)
	if not same and g.Hum and g.Hum.Parent then
		same = g.Hum.Parent:GetAttribute("NPCId") == info.Id
	end
	if not same then
		return false
	end
	local now = clock()
	local list = creditLog[killer.UserId] or {}
	local kept = {}
	for _, t in ipairs(list) do
		if now - t < 3600 then
			table.insert(kept, t)
		end
	end
	if #kept >= math.max(0, math.floor(tonumber(C.AttackRange.KillCreditPerHour) or 60)) then
		creditLog[killer.UserId] = kept
		return false
	end
	table.insert(kept, now)
	creditLog[killer.UserId] = kept
	return true
end

-- Code Bot: end the plan cleanly (ArmyState.CancelPlan: any non-plan state). Its pending route result is dropped (the
-- plans[uid] ~= plan check in setDest); the squad target is cleared; nobody moves.
function ArmyPlan.Cancel(player: Player, st: any?, why: string?)
	local p = plans[player.UserId]
	if p == nil then
		return
	end
	plans[player.UserId] = nil
	pcall(function()
		player:SetAttribute("WE_ArmyDest", nil)
	end)
	if st then
		st._acTarget = nil
	end
	ArmyLog.Line(player, "ARMY MOVE", string.format("%s plan %s/%s cancelled by %s", player.Name, p.Kind, p.Phase, tostring(why)))
end

-- the army's block centre (or nil): ArmyCommand measures "the army is away" with it
function ArmyPlan.BlockCentre(st: any): Vector3?
	return blockCentre(st)
end

function ArmyPlan.Current(uid: number): Plan?
	return plans[uid]
end

-- RECALL (and any order during a plan): march back first; true = handled here
function ArmyPlan.Recall(player: Player, thenOrder: string?, st: any?): boolean
	local p = plans[player.UserId]
	if p then
		p.Squad = st or p.Squad
		p.ThenOrder = thenOrder
		if p.Kind == "Send" and p.SiegeAt == nil then
			notify(player, "Army recalled", "Info")
		end
		toReturn(p, "recall")
		return true
	end
	if not live(player.UserId) or st == nil then
		return false
	end
	local r = ownerRoot(player)
	local _, centre = livingUnits(st)
	if r and centre and flatDist(centre, r.Position) > 60 then
		local np = newPlan(player, "Return", centre)
		np.Squad = st
		np.ThenOrder = thenOrder
		toReturn(np, "recall (far)")
		return true
	end
	return false
end

-- ── SEND ─────────────────────────────────────────────────────────────────────────────────────────────────────────
-- the facts for a SEND from `sender` to `plotId` (the tests build them directly)
function ArmyPlan.Facts(sender: Player, plotId: number): (Rules.Facts, Player?)
	local bs = deps.BaseService
	local owner = if bs and bs.GetOwnerUserId then bs.GetOwnerUserId(plotId) else nil
	local victim = if typeof(owner) == "number" then Players:GetPlayerByUserId(owner) else nil
	local now = os.time()
	local sProfile = profileOf(sender)
	local vProfile = if victim then profileOf(victim) else nil
	local sqs = deps.SquadOrdersService
	local units, hp, dps = 0, 0, 0
	if sqs and sqs.UnitPower then
		local ok, u, h, d = pcall(sqs.UnitPower, sender)
		if ok then
			units, hp, dps = u or 0, h or 0, d or 0
		end
	end
	local defence = 0
	local gd = deps.GateDefenseService
	if gd and gd.SiegeInfo then
		local ok, info = pcall(gd.SiegeInfo, plotId)
		if ok and info then
			defence = Rules.DefencePower(info.GateHp, info.GuardPower, info.TurretPower)
		end
	end
	local newLeft = 0
	if vProfile then
		local R = RaidConfig.Raid
		if not RunService:IsStudio() or R.ProtectNewPlayersInStudio == true then
			local first = tonumber(vProfile.FirstJoinUnix) or 0
			if first > 0 then
				newLeft = math.max(0, (first + (R.NewPlayerProtectionSeconds or 600)) - now)
			end
		end
	end
	local cs = deps.CombatService
	local novice = victim ~= nil and cs ~= nil and cs.IsNoviceShielded ~= nil and cs.IsNoviceShielded(victim) == true
	local active = plans[sender.UserId]
	local f: Rules.Facts = {
		Self = owner == sender.UserId,
		VictimOnline = victim ~= nil,
		VictimHasBase = victim ~= nil,
		Ally = victim ~= nil and gd ~= nil and gd.IsAlly ~= nil and gd.IsAlly(owner, sender) == true,
		PvpOff = GameConfig.PvPEnabled ~= true,
		ShieldLeft = if vProfile then math.max(0, (tonumber(raidOf(vProfile).ShieldUntil) or 0) - now) else 0,
		NewPlayerLeft = newLeft,
		Novice = novice,
		ProtectLeft = if vProfile then math.max(0, (tonumber(raidOf(vProfile).ArmyProtectUntil) or 0) - now) else 0,
		CooldownLeft = if sProfile then math.max(0, (tonumber(raidOf(sProfile).ArmySendCooldownUntil) or 0) - now) else 0,
		ActiveSend = active ~= nil and active.Kind == "Send",
		Units = units,
		ArmyPower = Rules.ArmyPower(units, hp, dps),
		DefencePower = defence,
	}
	return f, victim
end

function ArmyPlan.CheckSend(sender: Player, plotId: number): Rules.Verdict
	if not live(sender.UserId) then
		return { Ok = false, Reason = "Off", Text = "Not available", Bully = false, Ratio = 0 }
	end
	local f = ArmyPlan.Facts(sender, plotId)
	local v = Rules.Verdict(f)
	dbg(sender, "ArmyFair", string.format("plot %d -> %s (%s) power %.0f vs %.0f", plotId, v.Reason, v.Text, f.ArmyPower, f.DefencePower), true)
	return v
end

function ArmyPlan.StartSend(sender: Player, plotId: number, st: any): (boolean, string)
	local v = ArmyPlan.CheckSend(sender, plotId)
	if not v.Ok then
		return false, v.Text
	end
	local f, victim = ArmyPlan.Facts(sender, plotId)
	local gd = deps.GateDefenseService
	local gateCf = if gd and gd.GetGateCFrame then gd.GetGateCFrame(plotId) else nil
	local living, centre = livingUnits(st)
	if victim == nil or gateCf == nil or centre == nil then
		return false, "No base to attack"
	end
	local r = ownerRoot(sender)
	local p = newPlan(sender, "Send", if r then r.Position else centre :: Vector3)
	p.Squad = st
	p.Victim, p.VictimUid, p.VictimName, p.PlotId, p.Bully = victim, victim.UserId, victim.Name, plotId, v.Bully
	p.Total = #living
	p.Phase = "March"
	local dest = ((gateCf :: CFrame) * CFrame.new(0, 0, C.Send.StandoffStuds)).Position
	setDest(p, dest)
	syncState(p, st, "SEND base " .. tostring(plotId))
	local eta = flatDist(p.Lead, dest) * 1.3 / C.MarchSpeed
	notify(sender, string.format(T.Left, victim.Name .. "'s base"), "Info")
	notify(victim, string.format(T.Incoming, sender.Name, Rules.Clock(eta)), "Warn")
	dbg(sender, "ArmyPlan", string.format("SEND -> %s plot %d eta %.0fs units %d bully %s", victim.Name, plotId, eta, #living, tostring(v.Bully)), true)
	ArmyLog.Line(sender, "ARMY MOVE", string.format("%s travel started -> plot %d dest=%s units=%d", sender.Name, plotId, ArmyLog.Vec(dest), #living))
	local _ = f
	return true, v.Text
end

local function travelCfg(): { [string]: any }
	local t = (C :: any).Travel
	return if typeof(t) == "table" then t else {}
end

--[[ Code Bot (army command bug, 2026-10-01): TRAVEL - the map's SEND to an area / site (ArmyTargets): the block walks
	its route to the target's approach point (the one nearest the army), clears the hostiles at the objective, then
	HOLDS there. The owner stays where he is; FOLLOW cannot pull it back (the block follows the plan's lead point; the
	FOLLOW movers only run for the Following state). ]]
function ArmyPlan.StartTravel(player: Player, target: any, st: any): (boolean, string)
	if not live(player.UserId) then
		return false, "Off"
	end
	local living, centre = livingUnits(st)
	if centre == nil or #living == 0 then
		return false, "NoSoldiers"
	end
	local dest = ArmyTargets.ApproachFor(target, centre)
	local p = newPlan(player, "Travel", centre :: Vector3)
	p.Squad = st
	p.Target = target
	p.Total = #living
	p.Phase = "March"
	setDest(p, dest)
	syncState(p, st, "SEND " .. tostring(target.Key))
	setStatus(p, string.format(T.Travelling, target.Name, math.floor(flatDist(centre :: Vector3, dest) * 0.28)))
	notify(player, string.format(T.Sent, target.Name), "Info")
	ArmyLog.Line(player, "ARMY MOVE", string.format("%s travel started -> %s (%s) approach=%s objective=%s distance=%.0f units=%d", player.Name, target.Key, target.Name,
		ArmyLog.Vec(dest), ArmyLog.Vec(target.Centre), flatDist(centre :: Vector3, dest), #living))
	return true, target.Name
end

-- Code Bot: RETREAT with the army far from home: it marches home as a block (his gate spot), then the plain RETREAT
function ArmyPlan.StartRetreat(player: Player, st: any, home: Vector3): boolean
	if not live(player.UserId) then
		return false
	end
	local _, centre = livingUnits(st)
	if centre == nil then
		return false
	end
	local g = gateSpot(player)
	local p = newPlan(player, "Retreat", centre :: Vector3)
	p.Squad = st
	p.Phase = "March"
	p.ThenOrder = "Retreat"
	setDest(p, g or home)
	syncState(p, st, "RETREAT (far)")
	setStatus(p, T.Retreating)
	return true
end

-- ── the per-think step (SquadOrdersService calls it after its own target picks, before the units think) ─────────

local function markLost(plan: Plan, living: { any }, centre: Vector3, now: number)
	local n = 0
	for _, u in ipairs(living) do
		if u._scLost == true then
			n += 1
		elseif flatDist(u.Root.Position, centre) > C.LostStuds then
			u._planFar = u._planFar or now
			if now - u._planFar >= C.LostSeconds then
				u._scLost = true -- reported, never moved
				n += 1
			end
		else
			u._planFar = nil
		end
	end
	if n ~= plan.LostCount then
		plan.LostCount = n
		dbg(plan.Owner, "ArmyRoute", string.format("LOST units %d (never moved)", n), true)
	end
end

local function thinkClear(plan: Plan, player: Player, st: any, proot: BasePart?, pick: any, centre: Vector3, now: number)
	local f3 = (ArmyConfig :: any).Follow3
	local ownerPos = if plan.Anchor then plan.Anchor :: Vector3 elseif proot then proot.Position else centre
	local seekR, leashR, chainR = C.AttackRadii(player.UserId) -- claude-bud JOB 52: ONE set of radii for the whole order
	if plan.Phase == "Seek" then
		local from = if plan.SeekFrom == "owner" and proot then proot.Position else centre
		local radius = if plan.SeekFrom == "owner" then seekR else chainR
		local t = pickWith(pick, player, st, proot, { Centre = from, Reach = radius, LeashFrom = ownerPos, Leash = leashR })
		if t and plan.Bad[t.Root] then
			t = nil
		end
		local g = groupOf(t)
		st._acTarget = nil
		if g == nil then
			if plan.Chain == 0 then
				notify(player, T.NothingNear, "Info")
			end
			if plan.HoldWhenDone then
				plan.ThenState = "Holding" -- Code Bot: an ATTACK away from him holds where it ended
				finish(plan, st)
				return
			end
			toReturn(plan, "nothing left")
			return
		end
		plan.Group = g
		plan.GroupAlive = ArmyPlan.GroupAlive(player, g)
		plan.Phase = "March"
		setDest(plan, groupPos(g))
		dbg(player, "ArmyPlan", string.format("SEEK -> %s %s alive %d chain %d/%d", g.Kind, g.Name, plan.GroupAlive, plan.Chain, C.MaxChain), true)
		return
	end
	local g = plan.Group
	if g == nil then
		plan.Phase = "Seek"
		return
	end
	local alive = ArmyPlan.GroupAlive(player, g)
	if plan.Phase == "March" then
		-- an enemy player shooting the army on the way is answered (players first); NPCs wait for the fight
		local t = pickWith(pick, player, st, proot, { Centre = centre, Reach = (tonumber(f3.AttackAggroStuds) or 120), LeashFrom = ownerPos, Leash = leashR })
		st._acTarget = if t and t.Kind == "Player" then t else nil
		if alive <= 0 then
			plan.Phase = "Seek"
			plan.SeekFrom = "army"
			return
		end
		local gp = groupPos(g)
		setStatus(plan, string.format(T.Marching, g.Name, math.floor(flatDist(centre, gp) * 0.28)))
		if flatDist(centre, gp) <= C.ArriveStuds + (tonumber(f3.AttackStandoff) or 36) or routeDone(plan) then
			plan.Phase = "Fight"
			plan.FightSince = now
			plan.GroupAlive = alive
			plan.Route = nil
			plan.LeadVel = Vector3.zero
		end
		return
	end
	if plan.Phase == "Fight" then
		pickWith(pick, player, st, proot, { Centre = centre, Reach = (tonumber(f3.AttackAggroStuds) or 120) + (tonumber(f3.AttackKeepExtraStuds) or 20), LeashFrom = ownerPos, Leash = leashR })
		if alive < plan.GroupAlive then
			plan.Kills += plan.GroupAlive - alive
			plan.GroupAlive = alive
			plan.FightSince = now
		end
		setStatus(plan, string.format(T.Fighting, alive))
		local beyond = (plan.Anchor ~= nil or proot ~= nil) and flatDist(centre, ownerPos) > leashR
		if alive <= 0 or now - plan.FightSince >= C.FightGiveUpSeconds then
			plan.Chain += 1
			st._acTarget = nil
			setStatus(plan, string.format(T.Cleared, plan.Kills))
			dbg(player, "ArmyPlan", string.format("CLEARED %s (kills %d) chain %d/%d", g.Name, plan.Kills, plan.Chain, C.MaxChain), true)
			if plan.HoldWhenDone and (plan.Chain >= C.MaxChain or beyond) then
				plan.ThenState = "Holding"
				finish(plan, st)
			elseif plan.Chain >= C.MaxChain or beyond or (proot == nil and not plan.HoldWhenDone) then
				toReturn(plan, if beyond then "past the leash" else "chain done")
			else
				plan.Group = nil
				plan.Phase = "Seek"
				plan.SeekFrom = "army" -- (the next route starts at the block itself: setDest)
			end
		end
	end
end

--[[ v165 (proven in tools/sim/run_army_siege_test.py: after the breach half the block - every unit not straight in
	front of the 14-stud gate - pressed against the wall beside it, so the block centre never came in, the lead waited
	(gap > LeadMaxGap) and the ATM was never held). The funnel: a unit whose goal is on the other side of the walls walks
	to the gate mouth first, then through the lane, then on to its slot (ArmyController, plan.Funnel via LeadFor). ]]
local function gateFunnelOf(info: any): { [string]: any }?
	local c, h, gp = info.PadCenter, tonumber(info.PadHalf), info.GatePart
	if typeof(c) ~= "Vector3" or h == nil or gp == nil then
		return nil
	end
	local okG, g = pcall(function()
		return gp.Position
	end)
	if not okG or typeof(g) ~= "Vector3" then
		return nil
	end
	local d = Vector3.new(g.X - c.X, 0, g.Z - c.Z)
	local out = if math.abs(d.X) >= math.abs(d.Z) then Vector3.new(math.sign(d.X), 0, 0) else Vector3.new(0, 0, math.sign(d.Z))
	local okB, BL = pcall(function(): any
		return require(game:GetService("ReplicatedStorage").Shared.Configs.BaseLayoutConfig)
	end)
	local width = if okB and BL and tonumber(BL.MainGateWidth) then tonumber(BL.MainGateWidth) :: number else 14
	return { Gate = Vector3.new(g.X, 0, g.Z), Out = out, Lane = math.max(2, width * 0.5 - 2), Centre = c, Half = h }
end

local function structureTarget(part: BasePart, hp: number): any
	return { Kind = "Structure", Hum = { Health = hp, Parent = part }, Root = part }
end

local function thinkSend(plan: Plan, player: Player, st: any, proot: BasePart?, pick: any, living: { any }, centre: Vector3, now: number)
	local victim = plan.Victim
	local bs = deps.BaseService
	local stillOwner = victim ~= nil and victim.Parent ~= nil and bs and bs.GetOwnerUserId and bs.GetOwnerUserId(plan.PlotId) == plan.VictimUid
	if not stillOwner then
		-- the victim left: cancel, walk home, no loot, half the cooldown
		local sp = profileOf(player)
		if sp then
			raidOf(sp).ArmySendCooldownUntil = os.time() + C.Fairness.VictimLeftCooldownSeconds
			pcall(deps.DataService.MarkDirty, player)
		end
		notify(player, "Player left: your army is coming home", "Info")
		plan.Kind = "Return"
		toReturn(plan, "victim left")
		return
	end
	local vp = profileOf(victim :: Player)
	if plan.SiegeAt == nil and vp and (tonumber(raidOf(vp).ShieldUntil) or 0) > os.time() then
		notify(player, "Target shielded: your army turns back", "Info")
		plan.Kind = "Return"
		toReturn(plan, "shield came up")
		return
	end
	local gd = deps.GateDefenseService
	local okI, info = pcall(gd.SiegeInfo, plan.PlotId)
	if not okI or info == nil then
		plan.Kind = "Return"
		toReturn(plan, "no defences")
		return
	end
	if plan.Phase == "March" then
		st._acTarget = marchAnswer(pick, player, st, proot, centre, C.Siege.ReachStuds + 40)
		local dest = plan.Dest or centre
		setStatus(plan, string.format(T.Marching, plan.VictimName .. "'s base", math.floor(flatDist(centre, dest) * 0.28)))
		if routeDone(plan) and flatDist(centre, dest) <= C.ArriveStuds + standoffOf(st) then
			plan.Phase = "Siege"
			plan.SiegeAt = now
			plan.Route = nil
			plan.LeadVel = Vector3.zero
			-- the decided cooldown / protection start when the siege does (a SEND that reached a siege)
			local nowUnix = os.time()
			local sp = profileOf(player)
			if sp then
				raidOf(sp).ArmySendCooldownUntil = nowUnix + C.Fairness.SendCooldownSeconds
				pcall(deps.DataService.MarkDirty, player)
			end
			if vp then
				raidOf(vp).ArmyProtectUntil = nowUnix + C.Fairness.ProtectAfterSiegeSeconds
				pcall(deps.DataService.MarkDirty, victim)
			end
			notify(player, string.format(T.Arrived, plan.VictimName .. "'s base"), "Success")
		end
		return
	end
	if now - (plan.SiegeAt or now) >= C.Send.SiegeMaxSeconds then
		notify(player, "Siege over: your army is coming home", "Info")
		plan.Kind = "Return"
		toReturn(plan, "siege time")
		return
	end
	if info.Breached and not plan.Breached then
		plan.Breached = true
		notify(player, T.Breached, "Success")
		local ms = deps.MoneyCollectorService
		local okR, can, why = pcall(ms.CanArmyRaid, player, victim)
		if not (okR and can == true) then
			plan.NoLoot = tostring(why or "no loot")
		elseif info.CollectorPos then
			setDest(plan, info.CollectorPos)
			plan.Funnel = gateFunnelOf(info)
			-- Code Bot v165: the lead walks in through the broken gate (advance runs for Loot; in Siege it stood still,
			-- so after a breach the block never went in)
			plan.Phase = "Loot"
		end
	end
	if plan.NoLoot then
		notify(player, string.format(T.NoLoot, if plan.NoLoot == "Shielded" then "shield" else string.lower(plan.NoLoot :: string)), "Info")
		plan.Kind = "Return"
		toReturn(plan, "no loot")
		return
	end
	-- the siege target, in Siege.Priority order (a player shooting back always first: players first)
	local t = pickWith(pick, player, st, proot, { Centre = centre, Reach = C.Siege.ReachStuds, LeashFrom = centre, Leash = C.Siege.ReachStuds + 40 })
	local pickT: any = nil
	local shut = not info.Breached -- (the walls still stand: only what the block can see from outside counts)
	if t and shut and t.Root and behindWalls(info, t.Root.Position) then
		t = nil -- Code Bot v165: behind the walls: the gate first
	end
	if t and (t.Kind == "Player" or t.Kind == "Unit") then
		pickT = t -- (a defender's soldier in the open shooting back: claude-bud JOB 43 brawl, same tier as a player)
	else
		for _, kind in ipairs(C.Siege.Priority) do
			if kind == "Turret" then
				for _, tu in ipairs(info.Turrets) do
					if pickT == nil and not tu.Offline and tu.Hp > 0 and tu.Part and flatDist(tu.Part.Position, centre) <= C.Siege.ReachStuds
						and not (shut and behindWalls(info, tu.Part.Position)) then
						pickT = structureTarget(tu.Part, tu.Hp)
					end
				end
			elseif (kind == "Guard" or kind == "InsideGuard") and pickT == nil and t and t.Kind == "Guard" then
				if kind == "Guard" or plan.Breached then
					pickT = t
				end
			elseif kind == "Gate" and pickT == nil and not info.Breached and info.GatePart then
				pickT = structureTarget(info.GatePart, info.GateHp)
			end
		end
	end
	st._acTarget = pickT
	local turretsUp = 0
	for _, tu in ipairs(info.Turrets) do
		if not tu.Offline and tu.Hp > 0 then
			turretsUp += 1
		end
	end
	local gatePct = if info.GateMax > 0 then math.floor(100 * info.GateHp / info.GateMax) else 0
	-- Code Bot v165: how many of HIS soldiers fired in the last 2 s (the cooldown is spent on a shot, hit or miss)
	local firing = 0
	for _, u in ipairs(living) do
		if now - (tonumber(u.LastFireAt) or -math.huge) <= 2 then
			firing += 1
		end
	end
	dbg(player, "ArmySiege", string.format("target %s gate %d%% turrets %d units %d/%d firing %d breached %s", if pickT then pickT.Kind else "none", gatePct, turretsUp, #living, plan.Total, firing, tostring(info.Breached)))
	if ArmyLog.On(player) and now - (plan.MoveLogAt or -math.huge) >= 2 then
		plan.MoveLogAt = now
		ArmyLog.Line(player, "ARMY SIEGE", string.format("%s target=%s gate=%d%% enemy turrets=%d firing=%d/%d breached=%s", player.Name,
			if pickT then tostring(pickT.Kind) .. " at " .. ArmyLog.Vec(pickT.Root and pickT.Root.Position) else "none", gatePct, turretsUp, firing, #living, tostring(info.Breached)))
	end
	if not plan.Breached then
		setStatus(plan, string.format(T.Sieging, string.format("gate %d%% · firing %d · enemy guns %d", gatePct, firing, turretsUp)))
		return
	end
	-- breached: march to the ATM, hold it RaidConfig.Raid.HoldSeconds with the nearest unit, never hit
	if info.CollectorPos == nil then
		return
	end
	local atm: Vector3 = info.CollectorPos
	local holder, best = nil, math.huge
	for _, u in ipairs(living) do
		local d = flatDist(u.Root.Position, atm)
		if d < best then
			holder, best = u, d
		end
	end
	if holder == nil or best > C.Send.AtmHoldStuds then
		plan.HoldSince = nil
		setStatus(plan, string.format(T.Marching, "the ATM", math.floor(best * 0.28)))
		return
	end
	local R = RaidConfig.Raid
	local hp = holder.Humanoid.Health
	if plan.HoldUnit ~= holder or plan.HoldSince == nil or hp < plan.HoldHp - (R.DamageCancelHp or 0.5) then
		plan.HoldUnit = holder
		plan.HoldSince = now -- a hit on the holder restarts the hold (the DamageCancelHp rule)
	end
	plan.HoldHp = hp
	plan.Phase = "Loot"
	local left = (R.HoldSeconds or 6) - (now - (plan.HoldSince :: number))
	setStatus(plan, string.format(T.Looting, math.max(0, math.ceil(left))))
	if left <= 0 then
		local ms = deps.MoneyCollectorService
		local frac = ArmyOrdersConfig.LootFraction(R.StealFraction, plan.Bully)
		local okL, moved = pcall(ms.ArmyRaid, player, victim, frac)
		local n = if okL and typeof(moved) == "number" then moved else 0
		plan.Looted = n
		if n > 0 then
			notify(player, string.format(T.Looted, Rules.Commas(n)), "Success")
			pcall(function() -- claude-bud JOB 41: a raid win (RivalRaidWon when sent from TARGETS; the rate card's RaidWin)
				local RS = require(script.Parent.Parent.Services.RivalService) :: any
				RS.OnRaidWon(player, plan.PlotId, n)
				local RP = require(script.Parent.Parent.Services.RatePromptService) :: any
				RP.Trigger(player, "RaidWin")
			end)
			pcall(function() -- claude-bud JOB 48: the Guided "RAID A RIVAL BASE" goal is won (only while it is open)
				(require(script.Parent.Parent.Services.GuidedService) :: any).OnRaidWon(player)
			end)
			pcall(function() -- claude-bud JOB 49 C: the core "Raid a Base" daily mission
				(require(script.Parent.Parent.Services.MissionService) :: any).TrackProgress(player, "Raid", 1)
			end)
			pcall(function() -- claude-bud JOB 39: the Intel Office's "win a SEND ARMY raid" contract
				(require(script.Parent.Parent.Services.EndgameService) :: any).NoteContract(player, "WinSend", 1)
			end)
		else
			notify(player, string.format(T.NoLoot, "empty"), "Info")
		end
		dbg(player, "ArmySiege", string.format("LOOT %d (fraction %.3f bully %s)", n, frac, tostring(plan.Bully)), true)
		plan.Kind = "Return"
		toReturn(plan, "looted")
	end
end

-- Code Bot (army command bug): TRAVEL's step: MARCH (players shooting the block are answered) -> arrived ->
-- ENGAGE the hostiles at the objective (the steered ATTACK deploy; the lead point stays at the approach point) -> HOLD
local function thinkTravel(plan: Plan, player: Player, st: any, proot: BasePart?, pick: any, centre: Vector3, now: number)
	local tg = plan.Target
	local cfg = travelCfg()
	if plan.Phase == "March" then
		st._acTarget = marchAnswer(pick, player, st, proot, centre, 160)
		local dest = plan.Dest or centre
		setStatus(plan, string.format(T.Travelling, tg.Name, math.floor(flatDist(centre, dest) * 0.28)))
		if routeDone(plan) and flatDist(centre, dest) <= C.ArriveStuds + standoffOf(st) then
			plan.Phase = "Engage"
			plan.EngageSince = now
			plan.ClearSince = nil
			plan.Route = nil
			plan.LeadVel = Vector3.zero
			ArmyLog.Line(player, "ARMY MOVE", string.format("%s arrived at %s (%s) block=%s", player.Name, tg.Key, tg.Name, ArmyLog.Vec(centre)))
			notify(player, string.format(T.Arrived, tg.Name), "Success")
		end
		return
	end
	-- ENGAGE: the hostiles within the objective's radius + EngageExtraStuds (the one pick, the one hostility rule)
	local reach = (tonumber(tg.Radius) or 60) + (tonumber(cfg.EngageExtraStuds) or 60)
	local t = pickWith(pick, player, st, proot, { Centre = tg.Centre, Reach = reach, LeashFrom = tg.Centre, Leash = reach + 60 })
	st._acTarget = t
	if t then
		plan.ClearSince = nil
		setStatus(plan, string.format(T.Engaging, tg.Name))
	else
		plan.ClearSince = plan.ClearSince or now
	end
	local clear = plan.ClearSince ~= nil and now - (plan.ClearSince :: number) >= (tonumber(cfg.ClearHoldSeconds) or 2)
	local tooLong = now - (plan.EngageSince or now) >= (tonumber(cfg.EngageMaxSeconds) or 120)
	if clear or tooLong then
		notify(player, string.format(if tg.Territory then T.CaptureHint else T.AreaClear, tg.Name), "Success")
		ArmyLog.Line(player, "ARMY MOVE", string.format("%s %s at %s: HOLD", player.Name, if clear then "clear" else "fight timed out", tg.Name))
		plan.ThenState = "Holding"
		finish(plan, st)
	end
end

function ArmyPlan.Think(player: Player, st: any, proot: BasePart?, pick: any, now: number?)
	local plan = plans[player.UserId]
	if plan == nil then
		return
	end
	local t = now or clock()
	local living, centre = livingUnits(st)
	if centre == nil then
		if plan.Kind == "Send" or plan.SiegeAt ~= nil then
			notify(player, T.Wiped, "Error")
		end
		finish(plan, st)
		return
	end
	local c = centre :: Vector3
	plan.Squad = st
	-- (a plan fights through the steered ATTACK (attackAimOnly) and the lead point moves the block: its state's mode is
	-- Attack; Code Bot: ArmyState.Set is the one writer of st.Order - a squad out of step is re-synced and logged)
	if st.Order ~= "Attack" then
		ArmyLog.Line(player, "ARMY STATE", string.format("%s plan %s/%s found mode %s: resync", player.Name, plan.Kind, plan.Phase, tostring(st.Order)))
		ArmyState.Set(player, st, ArmyPlan.StateFor(plan), "ArmyPlan.Think resync", { Plan = true, Target = targetName(plan), Force = true })
	end
	local dt = math.clamp(t - plan.LastAt, 0.05, 1)
	plan.LastAt = t
	markLost(plan, living, c, t)
	if plan.Phase == "Return" then
		st._acTarget = nil
		local r = ownerRoot(player)
		if r and plan.Dest and t - plan.RoutedAt >= C.RepathSeconds and not plan.Routing then
			local home = returnDest(plan)
			if flatDist(home, plan.Dest :: Vector3) > 40 then
				setDest(plan, home) -- he moved: follow him home (his gate while he is inside his base)
			end
		end
		advance(plan, c, dt)
		setStatus(plan, T.Returning)
		local dest = plan.Dest or c
		if (routeDone(plan) or plan.Route == nil and not plan.Routing) and flatDist(c, dest) <= C.ReturnDoneStuds + 10 + standoffOf(st) then
			if plan.Kind == "Send" or plan.Looted > 0 or plan.SiegeAt ~= nil then
				notify(player, T.Home, "Info")
			end
			finish(plan, st)
		end
		dbg(player, "ArmyMarch", string.format("lead %.0f studs/s gap %.1f lost %d", plan.LeadVel.Magnitude, flatDist(plan.Lead, c), plan.LostCount))
		return
	end
	if plan.Kind == "Send" then
		thinkSend(plan, player, st, proot, pick, living, c, t)
	elseif plan.Kind == "Travel" then
		thinkTravel(plan, player, st, proot, pick, c, t)
	elseif plan.Kind == "Retreat" then
		st._acTarget = nil
		setStatus(plan, T.Retreating)
		local dest = plan.Dest or c
		if routeDone(plan) and flatDist(c, dest) <= C.ReturnDoneStuds + 10 + standoffOf(st) then
			finish(plan, st) -- ThenOrder Retreat: the plain RETREAT walks the last bit home
			return
		end
	else
		thinkClear(plan, player, st, proot, pick, c, t)
	end
	if plans[player.UserId] == plan and (plan.Phase == "March" or plan.Phase == "Loot" or plan.Phase == "Return") then
		advance(plan, c, dt)
		dbg(player, "ArmyMarch", string.format("lead %.0f studs/s gap %.1f lost %d", plan.LeadVel.Magnitude, flatDist(plan.Lead, c), plan.LostCount))
		if ArmyLog.On(player) and t - (plan.MoveLogAt or -math.huge) >= 2 then
			plan.MoveLogAt = t
			ArmyLog.Line(player, "ARMY MOVE", string.format("%s %s/%s block=%s lead=%s to dest %.0f studs, lead %.0f studs/s, lost %d", player.Name, plan.Kind, plan.Phase,
				ArmyLog.Vec(c), ArmyLog.Vec(plan.Lead), flatDist(c, plan.Dest or c), plan.LeadVel.Magnitude, plan.LostCount))
		end
	end
	syncState(plan, st, "ArmyPlan " .. plan.Kind .. "/" .. plan.Phase)
end

-- test hooks
function ArmyPlan._Plans(): { [number]: Plan }
	return plans
end
function ArmyPlan._SetClock(fn: () -> number)
	clock = fn
end
function ArmyPlan._Reset()
	table.clear(plans)
end

local function pushVerdict(player: Player, plotId: number, v: Rules.Verdict)
	local rs = deps.RemoteSetup
	local ev = rs and rs.Get(Constants.RemoteNames.FeaturePush)
	if ev and ev:IsA("RemoteEvent") then
		(ev :: RemoteEvent):FireClient(player, "ArmySendVerdict", { PlotId = plotId, Ok = v.Ok, Text = v.Text })
	end
end

local function ordersRate(): number
	local ok, OC = pcall(function(): any
		return require(Shared.Configs.OrdersConfig)
	end)
	return if ok and OC then tonumber(OC.OrderRatePerSec) or 2 else 2
end

local function ordersBurst(): number
	local ok, OC = pcall(function(): any
		return require(Shared.Configs.OrdersConfig)
	end)
	return if ok and OC then tonumber(OC.OrderBurst) or 4 else 4
end

function ArmyPlan.Init(d: { [string]: any })
	deps = d
	local sqs = d.SquadOrdersService
	if sqs then
		sqs._Plan = ArmyPlan
	end
	local okA, AC = pcall(function(): any
		return require(script.Parent.ArmyController)
	end)
	if okA and AC then
		AC.PlanLead = ArmyPlan.LeadFor
	end
	local cs = d.CombatService
	if cs and cs.SetUnitPlanCheck then
		cs.SetUnitPlanCheck(ArmyPlan.AllowsNpcGroup)
	end
	local check = d.RemoteSetup and d.RemoteSetup.Get(Constants.RemoteNames.RequestArmySendCheck)
	if check and check:IsA("RemoteEvent") then
		(check :: RemoteEvent).OnServerEvent:Connect(function(player: Player, plotId: any)
			if not require(script.Parent.RemoteGate).Check(player, "RequestArmySendCheck", plotId) then
				return
			end
			if d.RateLimitService and not d.RateLimitService.Allow(player, "army_send_check", 2, 4) then
				return
			end
			local id = math.floor(tonumber(plotId) or 0)
			if id > 0 and live(player.UserId) then
				pushVerdict(player, id, ArmyPlan.CheckSend(player, id))
			end
		end)
	end
	-- Code Bot army command bug: THE send command. The target is a base plot id (a number / "B:<plot>"), a map area
	-- ("A:<areaId>") or a world site ("S:<siteId>"); ArmyCommand validates it and starts the one transition. Every
	-- refusal is logged with its reason (ArmyLog.Reject) - nothing is dropped silently any more.
	local send = d.RemoteSetup and d.RemoteSetup.Get(Constants.RemoteNames.RequestArmySend)
	if send and send:IsA("RemoteEvent") then
		(send :: RemoteEvent).OnServerEvent:Connect(function(player: Player, plotId: any)
			ArmyLog.Line(player, "SERVER ARMY", string.format("received player=%s command=Send target=%s", player.Name, tostring(plotId)))
			if not require(script.Parent.RemoteGate).Check(player, "RequestArmySend", plotId) then
				ArmyLog.Reject(player, "SEND " .. tostring(plotId), "BadPayload")
				return
			end
			if d.RateLimitService and not d.RateLimitService.Allow(player, "army_send", ordersRate(), ordersBurst()) then
				ArmyLog.Reject(player, "SEND " .. tostring(plotId), "RateLimited")
				return
			end
			ArmyCommand.Send(player, plotId)
		end)
	end
	ArmyState.Bind({
		CancelPlan = function(p: Player, st: any, why: string?)
			ArmyPlan.Cancel(p, st, why)
		end,
	})
	ArmyCommand.Bind({
		Plan = ArmyPlan,
		PushVerdict = function(p: Player, id: number)
			pushVerdict(p, id, ArmyPlan.CheckSend(p, id))
		end,
		-- claude-bud JOB 52: the "nothing in range" card (distance + direction, PIN / SEND)
		PushFeature = function(p: Player, kind: string, data: any)
			local rs = deps.RemoteSetup
			local ev = rs and rs.Get(require(Shared.Constants).RemoteNames.FeaturePush)
			if ev and ev:IsA("RemoteEvent") then
				(ev :: RemoteEvent):FireClient(p, kind, data)
			end
		end,
	})
	if cs and cs.NPCInfoOf then
		ArmyTargets.BindNpcLookup(function(id: string): { Position: Vector3, Name: string }?
			return cs.NPCInfoOf(id) -- claude-bud JOB 52: "N:<npcId>" for the SEND the ATTACK toast offers
		end)
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		plans[p.UserId] = nil
	end)
	print("[WAR EMPIRE] ArmyPlan Init")
end

return ArmyPlan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">ArmyRoute</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 38 (2026-09-30): the long-route planner for an army march (ArmyPlan). The route is for the BLOCK's lead
	point, not for each soldier: SoldierController still walks every soldier to its formation slot.
	  * The straight line from -> to is cut into legs of at most LegStuds; each leg is a PathfindingService path (agent
	    sized for a soldier). A failed leg is retried with its end point moved sideways (+-24 studs), up to RouteRetries
	    tries in all; then the route fails ("No route": the army holds; there is NO teleport fallback).
	  * Code Bot v145: a failed middle leg (its end inside a walled plot / a building) tries the REST of the way as one
	    path before the route fails.
	  * One server-wide budget: at most PathBudgetPerSecond computes per second (the caller yields for a token).
	  * The result is a list of flat waypoints (no jump / climb actions: soldiers walk).
	Computing yields: always call it from a spawned thread.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ArmyOrdersConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.ArmyOrdersConfig)

local ArmyRoute = {}

type Computer = (from: Vector3, to: Vector3) -> { Vector3 }?

local tokens = 0
local tokenAt = os.clock()
local stats = { Computes = 0, Failed = 0, Legs = 0 }

local function defaultCompute(from: Vector3, to: Vector3): { Vector3 }?
	local PathfindingService = game:GetService("PathfindingService")
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 8 })
	local ok = pcall(function()
		path:ComputeAsync(from, to)
	end)
	if not ok or path.Status ~= Enum.PathStatus.Success then
		return nil
	end
	local out: { Vector3 } = {}
	for _, w in ipairs(path:GetWaypoints()) do
		table.insert(out, w.Position)
	end
	return out
end

local compute: Computer = defaultCompute

-- tests: replace the PathfindingService call
function ArmyRoute._SetComputer(fn: Computer?)
	compute = fn or defaultCompute
end

function ArmyRoute.Stats(): { Computes: number, Failed: number, Legs: number }
	return stats
end

-- wait for one path-compute token (the server-wide budget)
local function takeToken()
	local rate = math.max(0.1, ArmyOrdersConfig.PathBudgetPerSecond)
	while true do
		local now = os.clock()
		tokens = math.min(rate, tokens + (now - tokenAt) * rate)
		tokenAt = now
		if tokens >= 1 then
			tokens -= 1
			return
		end
		task.wait(0.25)
	end
end

-- the leg end points from -> to (each at most LegStuds apart)
function ArmyRoute.Legs(from: Vector3, to: Vector3, legStuds: number?): { Vector3 }
	local leg = math.max(20, legStuds or ArmyOrdersConfig.LegStuds)
	local d = to - from
	local n = math.max(1, math.ceil(Vector3.new(d.X, 0, d.Z).Magnitude / leg))
	local out: { Vector3 } = {}
	for i = 1, n do
		table.insert(out, from + d * (i / n))
	end
	return out
end

--[[ Plan the whole route. Returns the waypoints (ending at `to`), or nil and "no_route" after RouteRetries failures in
	one leg. Yields (the budget + PathfindingService). ]]
function ArmyRoute.Plan(from: Vector3, to: Vector3): ({ Vector3 }?, string?)
	local out: { Vector3 } = {}
	local start = from
	local legs = ArmyRoute.Legs(from, to)
	for li, legEnd in ipairs(legs) do
		local got: { Vector3 }? = nil
		local tries = 0
		local target = legEnd
		while got == nil and tries < math.max(1, ArmyOrdersConfig.RouteRetries) do
			tries += 1
			takeToken()
			stats.Computes += 1
			got = compute(start, target)
			if got == nil then
				stats.Failed += 1
				-- try the leg end a little to either side (a wall or water on the straight line)
				local dir = target - start
				local side = Vector3.new(-dir.Z, 0, dir.X)
				side = if side.Magnitude > 0 then side.Unit else Vector3.xAxis
				target = legEnd + side * (if tries % 2 == 1 then 24 else -24)
			end
		end
		if got == nil and li < #legs then
			-- Code Bot v145: a leg end on the straight line can sit inside a walled plot / a building (PathfindingService
			-- NoPath, and +-24 studs sideways cannot leave a 320-stud plot): plan the REST of the way whole, once
			takeToken()
			stats.Computes += 1
			got = compute(start, to)
			if got ~= nil then
				stats.Legs += 1
				for _, p in ipairs(got :: { Vector3 }) do
					table.insert(out, p)
				end
				return out, nil
			end
			stats.Failed += 1
		end
		if got == nil then
			return nil, "no_route"
		end
		stats.Legs += 1
		for _, p in ipairs(got :: { Vector3 }) do
			table.insert(out, p)
		end
		start = out[#out] or target
	end
	return out, nil
end

--[[ Code Bot v145: the point `dist` studs (flat) along `route` walked from `from` (its start), and the index of the next
	waypoint after it (pure). The plan's lead starts here: the block's formation spot is then where the block stands. ]]
function ArmyRoute.PointAlong(from: Vector3, route: { Vector3 }, dist: number): (Vector3, number)
	local p, i = ArmyRoute.Advance(from, route, 1, math.max(0, dist), 1)
	return p, i
end

--[[ Move a lead point along waypoints at `speed` for `dt` (pure; ArmyPlan and the tests call it). Returns the new point,
	the new waypoint index and the direction moved (zero when at the end). ]]
function ArmyRoute.Advance(at: Vector3, route: { Vector3 }, idx: number, speed: number, dt: number): (Vector3, number, Vector3)
	local left = math.max(0, speed * dt)
	local pos = at
	local dir = Vector3.zero
	local i = idx
	while left > 0 and i <= #route do
		local goal = route[i]
		local d = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
		local len = d.Magnitude
		if len <= left then
			pos = Vector3.new(goal.X, goal.Y, goal.Z)
			left -= len
			i += 1
			if len > 1e-3 then
				dir = d / len
			end
		else
			dir = d / len
			pos = pos + dir * left + Vector3.new(0, (goal.Y - pos.Y) * math.min(1, left / len), 0)
			left = 0
		end
	end
	return pos, i, dir
end

return ArmyRoute
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">ArmySendRules</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 38 (2026-09-30): the SEND fairness verdict and the power numbers (ArmyOrdersConfig.Fairness; DECIDED by the
	owner 2026-09-30). Pure functions: ArmyPlan gathers the facts on the server, this decides; the tests call it directly.
	Order of the checks (the first that fails is the reason; nothing marches):
	  self -> offline ("Player left") -> no base -> ally -> PvP off -> shield -> new player -> novice shield -> the victim's
	  army protection -> the sender's cooldown -> one active SEND -> no soldiers -> too weak (< MinPowerRatio x defences).
	An allowed SEND carries the power text ("Your army 820 vs defences 1,240: risky") and the bully flag (> BullyRatio x
	defences: half loot). The verdict is computed at the send and kept for that siege.
]]

local ArmyOrdersConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configs.ArmyOrdersConfig)

local ArmySendRules = {}

export type Facts = {
	Self: boolean,
	VictimOnline: boolean,
	VictimHasBase: boolean,
	Ally: boolean,
	PvpOff: boolean,
	ShieldLeft: number, -- seconds
	NewPlayerLeft: number,
	Novice: boolean,
	ProtectLeft: number, -- the victim's army protection
	CooldownLeft: number, -- the sender's SEND cooldown
	ActiveSend: boolean,
	Units: number,
	ArmyPower: number,
	DefencePower: number,
}
export type Verdict = { Ok: boolean, Reason: string, Text: string, Bully: boolean, Ratio: number }

function ArmySendRules.Clock(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

function ArmySendRules.Commas(n: number): string
	local s = tostring(math.floor(n + 0.5))
	return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

-- units x unit HP x unit DPS (research-scaled numbers come from the caller)
function ArmySendRules.ArmyPower(units: number, unitHp: number, unitDps: number): number
	return math.max(0, units) * math.max(0, unitHp) * math.max(0, unitDps)
end

-- gate HP + each guard's HP x DPS + each live turret's HP x DPS
function ArmySendRules.DefencePower(gateHp: number, guards: { { Hp: number, Dps: number } }, turrets: { { Hp: number, Dps: number } }): number
	local p = math.max(0, gateHp)
	for _, g in ipairs(guards) do
		p += math.max(0, g.Hp) * math.max(0, g.Dps)
	end
	for _, t in ipairs(turrets) do
		p += math.max(0, t.Hp) * math.max(0, t.Dps)
	end
	return p
end

function ArmySendRules.Verdict(f: Facts): Verdict
	local F = ArmyOrdersConfig.Fairness
	local function no(reason: string, text: string): Verdict
		return { Ok = false, Reason = reason, Text = text, Bully = false, Ratio = 0 }
	end
	if f.Self then
		return no("Self", "That is your base")
	end
	if not f.VictimOnline then
		return no("Offline", "Player left")
	end
	if not f.VictimHasBase then
		return no("NoBase", "No base to attack")
	end
	if f.Ally then
		return no("Ally", "Clan ally")
	end
	if f.PvpOff then
		return no("PvpOff", "PvP is off in this server")
	end
	if f.ShieldLeft > 0 then
		return no("Shielded", "🛡 Shielded " .. ArmySendRules.Clock(f.ShieldLeft))
	end
	if f.NewPlayerLeft > 0 then
		return no("NewPlayer", "New player protected " .. ArmySendRules.Clock(f.NewPlayerLeft))
	end
	if f.Novice then
		return no("Novice", "New player protected")
	end
	if f.ProtectLeft > 0 then
		return no("Protected", "Just raided: protected " .. ArmySendRules.Clock(f.ProtectLeft))
	end
	if f.CooldownLeft > 0 then
		return no("Cooldown", "Army resting " .. ArmySendRules.Clock(f.CooldownLeft))
	end
	if f.ActiveSend then
		return no("Active", "Your army is already out")
	end
	if f.Units <= 0 then
		return no("NoArmy", "No soldiers to send")
	end
	local def = math.max(1, f.DefencePower)
	local ratio = f.ArmyPower / def
	local vs = string.format("Your army %s vs defences %s", ArmySendRules.Commas(f.ArmyPower), ArmySendRules.Commas(f.DefencePower))
	if ratio < F.MinPowerRatio then
		local v = no("TooWeak", vs .. ": too weak")
		v.Ratio = ratio
		return v
	end
	local bully = ratio > F.BullyRatio
	local word = if bully then "much stronger: half loot" elseif ratio < F.RiskyRatio then "risky" else "good odds"
	return { Ok = true, Reason = "Ok", Text = vs .. ": " .. word, Bully = bully, Ratio = ratio }
end

return ArmySendRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">ArmyState</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot (army command bug, 2026-10-01; owner: "one server-authoritative, mutually exclusive army state"):
	THE army state of a squad (SquadOrdersService's st). ArmyState.Set is the ONLY writer of st.ArmyState AND of the
	movement mode st.Order the movers read (thinkUnit, ArmyController, ArmyPlan) - nothing else assigns st.Order.

	  Idle             no living units
	  Following        FOLLOW: the block walks behind its owner (ArmyController / ArmyFollow)
	  Holding          HOLD: every unit keeps its spot (HoldPos)
	  TravellingToBase SEND: the block walks an ArmyPlan route to the target's approach point (the plan's lead point)
	  Attacking        ATTACK: an ArmyPlan auto-clear marching on its target group (or the JOB 24 ATTACK, not live)
	  EngagingTarget   a plan fighting at its target (auto-clear FIGHT, a SEND siege / loot, an outpost's defenders)
	  Capturing        reserved: TerritoryCapture counts PLAYERS only (the army clears and holds; he captures)
	  Retreating       RETREAT: home (a far army marches back as a block first)
	  Recalling        RECALL (or FOLLOW while the army is away): the block marches back to him, then Following
	  Regrouping       reserved (Follow3 regroups inside Following)

	Set(player, st, new, source, opts):
	  * the movement mode: Following -> Follow, Holding -> Hold, Retreating -> Retreat (opts.Plan: the plan steers it,
	    Attack), Idle -> Follow, every other state -> Attack (the steered block follows the plan's lead point);
	  * a Set WITHOUT opts.Plan ends any running ArmyPlan first (hooks.CancelPlan: the plan is dropped, its pending
	    route result is ignored by its generation number): the previous state always terminates cleanly;
	  * leaving a state clears the squad targets (_acTarget / _defTarget); entering Holding stores each unit's spot;
	    hooks.OnChange (SquadOrdersService) resets the per-unit chase / aim / recover windows;
	  * replicates WE_ArmyState / WE_ArmyTarget on the Player (the Army UI highlight is the server's state) and pushes
	    SquadOrderStateUpdate (hooks.Push);
	  * logs "[ARMY STATE] <name> old -> new SOURCE=<source>" (ArmyLog: /armydebug or Studio only).
	Same state again = no-op (no reset), unless opts.Force (a legacy repeat order after its grace window).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ArmyLog = require(ReplicatedStorage:WaitForChild("Shared").Util.ArmyLog)

local ArmyState = {}

ArmyState.States = {
	Idle = true,
	Following = true,
	Holding = true,
	TravellingToBase = true,
	Attacking = true,
	EngagingTarget = true,
	Capturing = true,
	Retreating = true,
	Recalling = true,
	Regrouping = true,
} :: { [string]: boolean }

-- the plain order -> its state (RequestSquadOrder, the legacy path)
ArmyState.OfOrder = { Follow = "Following", Hold = "Holding", Attack = "Attacking", Retreat = "Retreating" } :: { [string]: string }

local MODE: { [string]: string } = {
	Idle = "Follow",
	Following = "Follow",
	Holding = "Hold",
	Retreating = "Retreat",
	Regrouping = "Follow",
}

-- the short UI words (status line / map card)
ArmyState.Label = {
	Idle = "IDLE",
	Following = "FOLLOWING",
	Holding = "HOLDING",
	TravellingToBase = "TRAVELLING",
	Attacking = "ATTACKING",
	EngagingTarget = "ENGAGING",
	Capturing = "CAPTURING",
	Retreating = "RETREATING",
	Recalling = "RECALLING",
	Regrouping = "REGROUPING",
} :: { [string]: string }

export type Hooks = {
	CancelPlan: ((player: Player, st: any, why: string) -> ())?,
	OnChange: ((player: Player, st: any, old: string, new: string, source: string) -> ())?,
	Push: ((player: Player) -> ())?,
}
local hooks: Hooks = {}
local clock: () -> number = os.clock

function ArmyState.Bind(h: Hooks)
	for k, v in pairs(h :: any) do
		(hooks :: any)[k] = v
	end
end

function ArmyState._SetClock(fn: () -> number)
	clock = fn
end

-- the state of a squad (a squad made before ArmyState: derived once from its order)
function ArmyState.Of(st: any): string
	if st == nil then
		return "Idle"
	end
	local s = st.ArmyState
	if typeof(s) == "string" and ArmyState.States[s] then
		return s
	end
	return ArmyState.OfOrder[tostring(st.Order)] or "Following"
end

-- the movement mode a state runs (the steered block for every plan state)
function ArmyState.ModeOf(state: string, plan: boolean?): string
	if state == "Retreating" and plan == true then
		return "Attack"
	end
	return MODE[state] or "Attack"
end

function ArmyState.Set(player: Player, st: any, new: string, source: string, opts: { [string]: any }?): boolean
	if st == nil then
		return false
	end
	if not ArmyState.States[new] then
		ArmyLog.Reject(player, "state " .. tostring(new), "UnknownState", "source=" .. tostring(source))
		return false
	end
	local o = opts or {}
	local plan = o.Plan == true
	local old = ArmyState.Of(st)
	-- a non-plan state ends the running plan first (FOLLOW / HOLD / ATTACK-not-live ... never leave a plan behind)
	if not plan and hooks.CancelPlan then
		hooks.CancelPlan(player, st, source)
	end
	local mode = ArmyState.ModeOf(new, plan)
	local same = old == new and st.Order == mode
	if same and o.Force ~= true then
		if o.Target ~= nil then
			st.ArmyTarget = o.Target
			pcall(function()
				player:SetAttribute("WE_ArmyTarget", tostring(o.Target))
			end)
		end
		return false
	end
	st.ArmyState = new
	st.ArmyStateAt = clock()
	st.ArmyStateSource = source
	st.ArmyTarget = o.Target
	st.Order = mode
	if not same then
		st._acTarget = nil
		st._defTarget = nil
	end
	for _, u in ipairs(st.Units or {}) do
		if new == "Holding" then
			if u.Alive and u.Root then
				u.HoldPos = u.Root.Position
			end
		else
			u.HoldPos = nil
		end
	end
	ArmyLog.Line(player, "ARMY STATE", string.format("%s %s -> %s SOURCE=%s mode=%s%s", tostring(player.Name), old, new, source, mode,
		if o.Target ~= nil then " target=" .. tostring(o.Target) else ""))
	if hooks.OnChange then
		local ok, err = pcall(hooks.OnChange :: any, player, st, old, new, source)
		if not ok then
			warn("[ARMY STATE] OnChange error: " .. tostring(err))
		end
	end
	pcall(function()
		player:SetAttribute("WE_ArmyState", new)
		player:SetAttribute("WE_ArmyTarget", if o.Target ~= nil then tostring(o.Target) else nil)
	end)
	if hooks.Push and o.NoPush ~= true then
		pcall(hooks.Push :: any, player)
	end
	return true
end

return ArmyState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">ArmyTargets</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot (army command bug, 2026-10-01): what a SEND may target, resolved ON THE SERVER from the id the map sends
	(the client never sends a position: it cannot point the army anywhere it likes).
	  "A:<areaId>"  a world-map area (Shared/Util/MapAreas: WorldConfig POIs + the TerritoryConfig outpost inside it),
	                e.g. "A:Town" = Crossroads Town (its objective: the Central Plaza outpost, radius 70)
	  "S:<siteId>"  a named site (WorldSitesConfig)
	  "B:<plotId>"  / a plain number: another player's base (ArmyPlan.StartSend: the fairness verdict, the gate siege)
	THE APPROACH POINT (the army's destination, never the objective's centre): ArmyOrdersConfig.Approach[id] when set
	(a list: Vector3s), else the points ApproachExtraStuds outside the objective's radius where a road (WaterConfig
	RoadEnds centre lines) enters it, else the four compass points on that ring. The one nearest the army is used, so a
	block never walks through the base it was sent to. Grounded by one raycast (Workspace) when it hits something.
	Pure apart from that raycast; the tests call Resolve directly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArmyOrdersConfig = require(Shared.Configs.ArmyOrdersConfig) :: any
local MapAreas = require(Shared.Util.MapAreas)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig) :: any
local WorldSitesConfig = require(Shared.Configs.WorldSitesConfig) :: any
local WaterConfig = require(Shared.Configs.WaterConfig) :: any

local ArmyTargets = {}

export type Target = {
	Key: string, -- "A:Town"
	Kind: string, -- "Area" | "Site" | "Base"
	Id: string,
	Name: string,
	Centre: Vector3, -- the objective (outpost / site centre)
	Radius: number, -- the objective's radius (the fight area is Radius + Travel.EngageExtraStuds)
	Approaches: { Vector3 },
	PlotId: number?,
	Territory: string?,
}

local function travelCfg(): { [string]: any }
	local t = ArmyOrdersConfig.Travel
	return if typeof(t) == "table" then t else {}
end

-- the road centre lines (RoadX<x>: along Z at x; RoadZ<z>: along X at z)
local function roads(): { { Axis: string, At: number, Min: number, Max: number } }
	local out = {}
	for key, e in pairs(WaterConfig.RoadEnds or {}) do
		local axis, at = string.match(key, "^Road([XZ])(%-?%d+)$")
		if axis and at and typeof(e) == "table" then
			table.insert(out, { Axis = axis, At = tonumber(at) :: number, Min = tonumber(e.Min) or -math.huge, Max = tonumber(e.Max) or math.huge })
		end
	end
	table.sort(out, function(a, b)
		return a.Axis .. tostring(a.At) < b.Axis .. tostring(b.At)
	end)
	return out
end

-- the default approach points round an objective: road entries first, else the compass ring
function ArmyTargets.ApproachRing(centre: Vector3, radius: number): { Vector3 }
	local ring = radius + (tonumber(travelCfg().ApproachExtraStuds) or 30)
	local out: { Vector3 } = {}
	for _, r in ipairs(roads()) do
		if r.Axis == "X" and math.abs(r.At - centre.X) < radius then
			-- a road along Z at x = At: it enters the ring at z = centre.Z +- ring
			for _, s in ipairs({ -1, 1 }) do
				local z = centre.Z + s * ring
				if z >= r.Min and z <= r.Max then
					table.insert(out, Vector3.new(r.At, centre.Y, z))
				end
			end
		elseif r.Axis == "Z" and math.abs(r.At - centre.Z) < radius then
			for _, s in ipairs({ -1, 1 }) do
				local x = centre.X + s * ring
				if x >= r.Min and x <= r.Max then
					table.insert(out, Vector3.new(x, centre.Y, r.At))
				end
			end
		end
	end
	if #out == 0 then
		for _, d in ipairs({ Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(-1, 0, 0) }) do
			table.insert(out, centre + d * ring)
		end
	end
	return out
end

local function configured(key: string): { Vector3 }?
	local A = ArmyOrdersConfig.Approach
	local list = if typeof(A) == "table" then A[key] else nil
	if typeof(list) == "Vector3" then
		return { list }
	end
	if typeof(list) == "table" and #list > 0 then
		return list
	end
	return nil
end

local function ground(p: Vector3): Vector3
	local ok, hit = pcall(function(): any
		return Workspace:Raycast(Vector3.new(p.X, p.Y + 200, p.Z), Vector3.new(0, -400, 0))
	end)
	if ok and hit and typeof(hit.Position) == "Vector3" then
		return Vector3.new(p.X, hit.Position.Y + 3, p.Z)
	end
	return p
end

-- the approach point of a target nearest to `from` (the army's block centre)
function ArmyTargets.ApproachFor(t: Target, from: Vector3?): Vector3
	local best, bestD = t.Approaches[1], math.huge
	if from then
		for _, a in ipairs(t.Approaches) do
			local d = Vector3.new(a.X - from.X, 0, a.Z - from.Z).Magnitude
			if d < bestD then
				best, bestD = a, d
			end
		end
	end
	return ground(best or t.Centre)
end

--[[ (target, nil) or (nil, reason): "BadTarget" (not a target id), "UnknownTarget" (no such area / site). A base id
	comes back as Kind "Base" with its PlotId: ArmyPlan.StartSend checks it (owner online, fairness, his own base). ]]
-- claude-bud JOB 52: CombatService's NPC lookup for "N:<npcId>" (bound by ArmyPlan.Init): id -> { Position, Name } or nil
local npcLookup: ((string) -> { Position: Vector3, Name: string }?)? = nil
function ArmyTargets.BindNpcLookup(fn: (string) -> { Position: Vector3, Name: string }?)
	npcLookup = fn
end

function ArmyTargets.Resolve(raw: any): (Target?, string?)
	if typeof(raw) == "number" then
		if raw ~= raw or raw <= 0 or raw % 1 ~= 0 then
			return nil, "BadTarget"
		end
		return { Key = "B:" .. tostring(raw), Kind = "Base", Id = tostring(raw), Name = "base " .. tostring(raw), Centre = Vector3.zero, Radius = 0, Approaches = {}, PlotId = raw }, nil
	end
	if typeof(raw) ~= "string" or #raw > 40 then
		return nil, "BadTarget"
	end
	local kind, id = string.match(raw, "^(%a):([%w_]+)$")
	if kind == nil or id == nil then
		return nil, "BadTarget"
	end
	if kind == "B" then
		local n = tonumber(id)
		if n == nil then
			return nil, "BadTarget"
		end
		return ArmyTargets.Resolve(n)
	elseif kind == "A" then
		local a = MapAreas.ById(id)
		if a == nil then
			return nil, "UnknownTarget"
		end
		local centre = Vector3.new(a.X, 1, a.Z)
		local radius = math.min(a.R, tonumber(travelCfg().AreaRadiusCap) or 80)
		local terr = if a.Territory then TerritoryConfig.Territories[a.Territory] else nil
		if typeof(terr) == "table" and typeof(terr.Position) == "Vector3" then
			centre = terr.Position
			radius = tonumber(terr.Radius) or radius
		end
		local key = "A:" .. a.Id
		return {
			Key = key, Kind = "Area", Id = a.Id, Name = a.Name, Centre = centre, Radius = radius,
			Approaches = configured(key) or ArmyTargets.ApproachRing(centre, radius), Territory = a.Territory,
		}, nil
	elseif kind == "N" then
		-- claude-bud JOB 52: the nearest enemy group the ATTACK toast offered ("N:<npcId>"): a live CombatService NPC the
		-- server resolves now (its position, its group's name); the client sends only the id
		local cs = npcLookup and npcLookup(id)
		if cs == nil then
			return nil, "UnknownTarget"
		end
		local centre = cs.Position
		local key = "N:" .. id
		return { Key = key, Kind = "Site", Id = id, Name = cs.Name, Centre = centre, Radius = 40,
			Approaches = ArmyTargets.ApproachRing(centre, 40) }, nil
	elseif kind == "S" then
		for _, s in ipairs(WorldSitesConfig.Sites or {}) do
			if s.Id == id then
				local k = (WorldSitesConfig.Kinds or {})[s.Kind]
				local radius = if typeof(k) == "table" then tonumber(k.R) or 40 else 40
				local centre = Vector3.new(s.X, 1, s.Z)
				local key = "S:" .. s.Id
				return { Key = key, Kind = "Site", Id = s.Id, Name = tostring(s.Name or s.Id), Centre = centre, Radius = radius,
					Approaches = configured(key) or ArmyTargets.ApproachRing(centre, radius) }, nil
			end
		end
		return nil, "UnknownTarget"
	end
	return nil, "BadTarget"
end

return ArmyTargets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">BaseGuards</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 20 (2026-09-29): base guards as real defenders (Shared/Configs/GuardConfig). GateDefenseService keeps
	building the guards and runs its 5 Hz loop; this module is the guards' brain, the tower guards, the rewards and the
	balance caps. GateDefenseService passes its own helpers (H) so line of sight, plot bounds, spawn grace and the
	clan check stay exactly its own.
	  * ThinkGuard: hostiles INSIDE the plot (players not owner / clan / friend, enemy army units); the nearest the
	    guard can reach inside its leash; face, walk (a throttled path when it cannot see), shoot with LOS + hit chance;
	    idle at the post, back there ReturnAfterSeconds after the last intruder.
	  * Tower guards: hired per corner tower (Cash, rebirth-scaled price, saved in profile.TowerGuards); anchored on the
	    platform, shoot hostiles OUTSIDE the plot within Tower.Range; respawn after RespawnSeconds.
	  * Damage: players get the server's creator tag for the OWNER only on the killing hit, and only when the pair is
	    under the anti-farm limit and not in a private server (so CombatService credits the owner exactly like his own
	    kill: cash, XP, MOST KILLS, the kill feed). Per-target damage per second capped; at most MaxShootersPerBase.
]]

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local GuardConfig = require(Shared.Configs.GuardConfig)

local BaseGuards = {}

local C: any = GuardConfig
local deps: { [string]: any } = {}
local pairLog: { [string]: { number } } = {}
local dmgWindow: { [any]: { At: number, Taken: number } } = {}
local shooters: { [number]: { At: number, N: number } } = {} -- plotId -> this tick's engaged shooters
local pathBudget = { At = 0, N = 0 }
local rng = Random.new()

type Target = { Kind: string, Player: Player?, Humanoid: Humanoid, Root: BasePart, OwnerUserId: number, Key: any }

function BaseGuards.Live(): boolean
	return C.Enabled == true
end

function BaseGuards.Bind(d: { [string]: any })
	deps = d
end

local function combatDamage(): any?
	local ok, m = pcall(function()
		return require(script.Parent.Parent.Services.CombatService.CombatDamage) :: any
	end)
	return if ok then m else nil
end

local function areFriends(a: number, b: number): boolean
	local es = deps.EngagementService
	if es and es.AreFriends then
		local ok, yes = pcall(es.AreFriends, a, b)
		return ok and yes == true
	end
	return false
end

-- claude-bud JOB 40 part A: THE one rule (CombatService.UnitMayHitPlayer / ArmyHostility) for a live base owner
local function combat(): any?
	return deps.CombatService
end

local function oneRuleLive(ownerUserId: number): boolean
	return GuardConfig.PostsLiveFor(ownerUserId)
end

-- may this base's defences shoot player p? (live: the one rule; the 4 s spawn grace only spares, never adds)
function BaseGuards.PlayerHostileOneRule(ownerUserId: number, p: Player, H: any): boolean
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local cs = combat()
	if owner == nil or cs == nil or cs.UnitMayHitPlayer == nil then
		return false
	end
	local ok = cs.UnitMayHitPlayer(owner, p)
	if not ok then
		return false
	end
	return not (H and H.InSpawnGrace and H.InSpawnGrace(p))
end

-- may this base's defences shoot the soldiers of unitOwner? (ArmyHostility; a shielded base owner fires at nobody)
function BaseGuards.UnitHostileOneRule(ownerUserId: number, unitOwner: number): boolean
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local uo = Players:GetPlayerByUserId(unitOwner)
	local cs = combat()
	if owner == nil or uo == nil or cs == nil or cs.ArmyHostility == nil then
		return false
	end
	local ok = cs.ArmyHostility(owner, uo)
	if not ok then
		return false
	end
	local why = if cs.PvPBlockReason then cs.PvPBlockReason(owner, uo) else nil
	return why ~= "owner_shielded"
end

-- GateDefenseService's AutoGun / gate-guard hits and attacker checks (it never holds CombatService: the join hotfix)
function BaseGuards.DefenceHit(owner: Player, victim: Player, amount: number, kind: string): (number, boolean, string)
	local cs = combat()
	if cs == nil or cs.ApplyDefenceHit == nil then
		return 0, false, "no_combat"
	end
	return cs.ApplyDefenceHit(owner, victim, amount, kind)
end

function BaseGuards.AttackerMay(attacker: Player, owner: Player): (boolean, string)
	local cs = combat()
	if cs == nil or cs.ArmyHostility == nil then
		return true, "ok"
	end
	return cs.ArmyHostility(attacker, owner)
end

-- a player the base must never shoot: the owner, his clan (H.IsAlly), his friends
local function friendlyPlayer(ownerUserId: number, p: Player, H: any): boolean
	return p.UserId == ownerUserId or H.IsAlly(ownerUserId, p) or areFriends(ownerUserId, p.UserId)
end

local function friendlyUnitOwner(ownerUserId: number, unitOwner: number, H: any): boolean
	if unitOwner == ownerUserId or areFriends(ownerUserId, unitOwner) then
		return true
	end
	local p = Players:GetPlayerByUserId(unitOwner)
	return p ~= nil and H.IsAlly(ownerUserId, p)
end

-- every hostile with inside == true (in the plot) or inside == false (outside it, within range of `from`)
local function hostiles(def: any, H: any, inside: boolean, from: Vector3, range: number): { Target }
	local out: { Target } = {}
	local live = oneRuleLive(def.OwnerUserId) -- JOB 40: the one rule (off = JOB 20's owner / clan / friends / grace)
	for _, p in ipairs(Players:GetPlayers()) do
		local hostile = if live then BaseGuards.PlayerHostileOneRule(def.OwnerUserId, p, H) else (not friendlyPlayer(def.OwnerUserId, p, H) and not H.InSpawnGrace(p))
		if hostile then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and root and root:IsA("BasePart") and hum.Health > 0 then
				local isIn = H.InsidePlot(def, root.Position)
				if isIn == inside and (inside or (root.Position - from).Magnitude <= range) then
					table.insert(out, { Kind = "Player", Player = p, Humanoid = hum, Root = root, OwnerUserId = p.UserId, Key = p.UserId })
				end
			end
		end
	end
	if C.UnitTargets then
		for _, m in ipairs(CollectionService:GetTagged(C.UnitTag)) do
			local uo = m:GetAttribute("OwnerUserId")
			local unitHostile = typeof(uo) == "number" and (if live then BaseGuards.UnitHostileOneRule(def.OwnerUserId, uo) else not friendlyUnitOwner(def.OwnerUserId, uo, H))
			if m:IsA("Model") and unitHostile then
				local hum = m:FindFirstChildOfClass("Humanoid")
				local root = m:FindFirstChild("HumanoidRootPart")
				if hum and root and root:IsA("BasePart") and hum.Health > 0 then
					local isIn = H.InsidePlot(def, root.Position)
					if isIn == inside and (inside or (root.Position - from).Magnitude <= range) then
						table.insert(out, { Kind = "Unit", Player = nil, Humanoid = hum, Root = root, OwnerUserId = uo, Key = m })
					end
				end
			end
		end
	end
	return out
end

local function lowTarget(p: Player): boolean
	local prof = deps.DataService and deps.DataService.GetProfile(p)
	if prof == nil then
		return true
	end
	local lvl = tonumber(prof.Level) or 1
	local first = tonumber(prof.FirstJoinUnix) or 0
	return lvl < C.DpsCap.LowLevel or (first > 0 and os.time() - first < C.DpsCap.NewPlayerSeconds)
end

local function isPrivateServer(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId ~= 0
end

local function reward(p: Player, cash: number, xp: number, why: string)
	if deps.EconomyService and cash > 0 then
		pcall(deps.EconomyService.AddCash, p, cash, why)
	end
	if deps.XPService and xp > 0 then
		pcall(deps.XPService.AddXP, p, xp, why)
	end
end

-- one defender hit on a target (capped); returns the damage dealt
local function hurt(def: any, t: Target, amount: number, sourceId: string, H: any): number
	local now = os.clock()
	local w = dmgWindow[t.Key]
	if w == nil or now - w.At >= 1 then
		w = { At = now, Taken = 0 }
		dmgWindow[t.Key] = w
	end
	local win = w :: { At: number, Taken: number }
	local amt = GuardConfig.CapDamage(win.Taken, amount, t.Player ~= nil and lowTarget(t.Player :: Player))
	if amt <= 0 or t.Humanoid.Health <= 0 then
		return 0
	end
	win.Taken += amt
	local owner = Players:GetPlayerByUserId(def.OwnerUserId)
	if oneRuleLive(def.OwnerUserId) then
		-- JOB 40: through CombatService (the rule re-checked at every shot; the creator tag credits the owner)
		local cs = combat()
		if owner == nil or cs == nil then
			return 0
		end
		if t.Kind == "Player" then
			local victim = t.Player :: Player
			if not BaseGuards.PlayerHostileOneRule(def.OwnerUserId, victim, H) then
				return 0
			end
			local okD, dealt = pcall(cs.ApplyDefenceHit, owner, victim, amt, sourceId)
			if okD and typeof(dealt) == "number" and dealt > 0 then
				pcall(H.Alert, def.PlotId, def.OwnerUserId, victim)
				BaseGuards._Log(def, "[BaseGuardHit] from=%s to=%s dmg=%d hp=%d", sourceId, victim.Name, dealt, t.Humanoid.Health)
				return dealt
			end
			return 0
		end
		if not BaseGuards.UnitHostileOneRule(def.OwnerUserId, t.OwnerUserId) then
			return 0
		end
		local before = t.Humanoid.Health
		pcall(cs.ApplyHit, owner, t.Root, amt, { WeaponId = sourceId, UnitShot = true, Quiet = true })
		local dealt = math.max(0, before - t.Humanoid.Health)
		if t.Humanoid.Health <= 0 and dealt > 0 and not isPrivateServer() and GuardConfig.AllowPair(pairLog, owner.UserId, t.OwnerUserId, now) then
			reward(owner, C.Rewards.UnitKillCash, C.Rewards.UnitKillXP, "guard_unit_kill")
		end
		return dealt
	end
	if t.Kind == "Player" then
		local victim = t.Player :: Player
		if H.InSpawnGrace(victim) then
			return 0
		end
		local killing = t.Humanoid.Health - amt <= 0
		if killing and owner and not (C.Rewards.NoCreditInPrivateServers and isPrivateServer()) and GuardConfig.AllowPair(pairLog, owner.UserId, victim.UserId, now) then
			local cd = combatDamage()
			if cd and cd.TagCreator then
				pcall(cd.TagCreator, t.Humanoid, owner, false) -- CombatService credits the owner (cash, XP, board, feed)
			end
		end
		t.Humanoid:SetAttribute("WE_LastWeapon", sourceId)
		t.Humanoid:TakeDamage(amt)
		pcall(H.Alert, def.PlotId, def.OwnerUserId, victim)
	else
		t.Humanoid:TakeDamage(amt)
		if t.Humanoid.Health <= 0 and owner and not isPrivateServer() and GuardConfig.AllowPair(pairLog, owner.UserId, t.OwnerUserId, now) then
			reward(owner, C.Rewards.UnitKillCash, C.Rewards.UnitKillXP, "guard_unit_kill")
		end
	end
	return amt
end

local function hitChance(dist: number, far: number): number
	if dist <= C.HitNearStuds then
		return C.HitChanceNear
	end
	local k = math.clamp((dist - C.HitNearStuds) / math.max(far - C.HitNearStuds, 1), 0, 1)
	return C.HitChanceNear + (C.HitChanceFar - C.HitChanceNear) * k
end

-- one engaged shooter for this plot this tick (turrets count too); false = the base already has enough firing
local function claimShooter(def: any, tnow: number): boolean
	local s = shooters[def.PlotId]
	if s == nil or tnow - s.At > 0.15 then
		s = { At = tnow, N = #(def.Turrets or {}) }
		shooters[def.PlotId] = s
	end
	local st = s :: { At: number, N: number }
	if st.N >= C.MaxShootersPerBase then
		return false
	end
	st.N += 1
	return true
end

local function requestPath(g: any, to: Vector3, tnow: number)
	if g._bgPathBusy or tnow < (g._bgPathAt or 0) then
		return
	end
	if tnow - pathBudget.At >= 1 then
		pathBudget.At, pathBudget.N = tnow, 0
	end
	if pathBudget.N >= C.PathBudgetPerSecond then
		return
	end
	pathBudget.N += 1
	g._bgPathBusy = true
	g._bgPathAt = tnow + C.PathEverySeconds
	task.spawn(function()
		local ok, path = pcall(function()
			local p = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 })
			p:ComputeAsync(g.Root.Position, to)
			return p
		end)
		g._bgPathBusy = false
		if ok and path and path.Status == Enum.PathStatus.Success then
			g._bgPath = { Points = path:GetWaypoints(), I = 2 }
		else
			g._bgPath = nil
		end
	end)
end

-- the leash: a goal never more than LeashStuds from the post and always inside the plot
local function leashed(def: any, g: any, goal: Vector3, H: any): Vector3
	local post = g.PostCf.Position
	local off = goal - post
	local flat = Vector3.new(off.X, 0, off.Z)
	if flat.Magnitude > C.LeashStuds then
		goal = post + flat.Unit * C.LeashStuds + Vector3.new(0, off.Y, 0)
	end
	return H.ClampInside(def, goal)
end

-- claude-bud JOB 40: /armydebug lines for a live base (only while its owner has WE_ArmyDebug on; 1 per 0.5 s per base)
local logAt: { [number]: number } = {}
function BaseGuards._Log(def: any, fmt: string, ...: any)
	local owner = Players:GetPlayerByUserId(def.OwnerUserId)
	if owner == nil or owner:GetAttribute("WE_ArmyDebug") ~= true then
		return
	end
	local t = os.clock()
	if t - (logAt[def.PlotId] or 0) < 0.5 then
		return
	end
	logAt[def.PlotId] = t
	print(string.format(fmt, ...))
end

-- the post guard's target: the raider of this plot first, then near the ATM, then the nearest; players before units
local function pickPostTarget(def: any, g: any, H: any): (Target?, number)
	local P = C.Posts
	local pos = g.Root.Position
	local cands: { Target } = hostiles(def, H, true, pos, math.huge)
	for _, t in ipairs(hostiles(def, H, false, g.PostCf.Position, P.AlertStuds)) do
		if H.HasLos(pos, t.Root.Position, { g.Model, def.Folder, t.Root.Parent :: Instance }) then
			table.insert(cands, t)
		end
	end
	local best: Target? = nil
	local bestScore = math.huge
	local bestD = math.huge
	for _, t in ipairs(cands) do
		local d = (t.Root.Position - pos).Magnitude
		local tier = 3
		if t.Player and (t.Player :: Player):GetAttribute("WE_RaidingPlot") == def.PlotId then
			tier = 1
		elseif def.CollectorPos and (t.Root.Position - def.CollectorPos).Magnitude <= P.ProtectCollectorRadius then
			tier = 2
		end
		local score = tier * 100000 + (if t.Kind == "Unit" then 50000 else 0) + d
		if score < bestScore then
			best, bestScore, bestD = t, score, d
		end
	end
	return best, bestD
end

--[[ claude-bud JOB 40 part A: one POST guard, one think (the state machine; GuardConfig.PostNext decides, this acts).
	IDLE at the post facing out; ALERT faces the hostile for ReactionSeconds; ATTACK fires with line of sight on every
	shot (FireRate / Damage / Range, the hit chance, the one rule re-checked in hurt), moving only to regain sight,
	never past LeashStuds from the post or out of the plot; RETURN walks back (a path when blocked, never a teleport);
	HP back to full only at the post after RegenAfterSeconds out of combat. DEAD / respawn = GateDefenseService's. ]]
function BaseGuards.ThinkPost(def: any, g: any, tnow: number, H: any)
	local P = C.Posts
	local ps = g._ps
	if ps == nil then
		ps = { State = "IDLE", Since = tnow, SeenAt = -math.huge, HurtAt = -math.huge, LastHp = g.Humanoid.Health }
		g._ps = ps
	end
	local st: any = ps
	local dead = not g.Alive or g.Humanoid.Health <= 0 or not g.Root.Parent
	if g.Humanoid.Health < st.LastHp then
		st.HurtAt = tnow
	end
	st.LastHp = g.Humanoid.Health
	local pos = if dead then g.PostCf.Position else g.Root.Position
	local post = g.PostCf.Position
	local fromPost = Vector3.new(pos.X - post.X, 0, pos.Z - post.Z).Magnitude
	local t: Target?, d = nil, math.huge
	if not dead then
		t, d = pickPostTarget(def, g, H)
	end
	if t then
		st.SeenAt = tnow
		st.Target = t
	end
	local nextS = GuardConfig.PostNext(st.State, {
		Dead = dead,
		Target = t ~= nil,
		Since = tnow - st.Since,
		LostFor = tnow - st.SeenAt,
		FromPost = fromPost,
		AtPost = fromPost <= 2,
	})
	if nextS ~= st.State then
		st.State = nextS
		st.Since = tnow
		g.Model:SetAttribute("WE_GuardState", nextS)
	end
	if dead then
		return
	end
	BaseGuards._Log(def, "[BaseGuard] plot=%s post=%s state=%s target=%s dist=%d", tostring(def.PlotId), tostring(g.PostName), st.State, if t then (if t.Player then (t.Player :: Player).Name else "unit") else "-", if t then math.floor(d) else -1)
	if st.State == "IDLE" then
		g.Humanoid:MoveTo(pos)
		H.FaceYaw(g.Root, post + g.PostCf.LookVector * 10)
		if g.Humanoid.Health < g.Humanoid.MaxHealth and tnow - st.HurtAt >= P.RegenAfterSeconds then
			g.Humanoid.Health = g.Humanoid.MaxHealth -- the post regen (the guard NPC, never a player)
		end
	elseif st.State == "ALERT" then
		g.Humanoid:MoveTo(pos)
		if t then
			H.FaceYaw(g.Root, t.Root.Position)
		end
	elseif st.State == "ATTACK" then
		if t == nil then
			g.Humanoid:MoveTo(pos)
			return
		end
		local tt = t :: Target
		H.FaceYaw(g.Root, tt.Root.Position)
		local sees = H.HasLos(pos, tt.Root.Position, { g.Model, def.Folder, tt.Root.Parent :: Instance })
		if sees then
			g._bgPath = nil
			g.Humanoid:MoveTo(if d > P.Range * 0.85 then leashed(def, g, tt.Root.Position, H) else pos)
		else
			local path = g._bgPath
			if path and path.I <= #path.Points then
				local wp = path.Points[path.I]
				if (pos - wp.Position).Magnitude < 3 then
					path.I += 1
				end
				g.Humanoid:MoveTo(leashed(def, g, wp.Position, H))
			else
				requestPath(g, leashed(def, g, tt.Root.Position, H), tnow)
			end
		end
		local interval = 1 / math.max(P.FireRate, 0.1)
		if sees and d <= P.Range and tnow - g.LastFireAt >= interval and claimShooter(def, tnow) then
			g.LastFireAt = tnow
			if rng:NextNumber() <= hitChance(d, P.Range) then
				hurt(def, tt, P.Damage * BaseGuards.PostDamageMult(def.OwnerUserId, H), "BaseGuard", H)
			end
			pcall(H.ShotFx, def, g, pos, tt.Root.Position)
		end
	elseif st.State == "RETURN" then
		local blocked = not H.HasLos(pos, post, { g.Model, def.Folder })
		if blocked then
			local path = g._bgPath
			if path and path.I <= #path.Points then
				local wp = path.Points[path.I]
				if (pos - wp.Position).Magnitude < 3 then
					path.I += 1
				end
				g.Humanoid:MoveTo(wp.Position)
			else
				requestPath(g, post, tnow)
			end
		else
			g._bgPath = nil
			g.Humanoid:MoveTo(post)
		end
	end
end

-- the post guard's damage multiplier: Research TurretDamage x the JOB 39 Turret Guns, capped at MaxMult (3)
function BaseGuards.PostDamageMult(ownerUserId: number, H: any): number
	local r = H.ResearchMult(ownerUserId)
	local eg = deps.EndgameService
	if eg and eg.TurretDmgMult then
		local ok, m = pcall(eg.TurretDmgMult, ownerUserId, r)
		if ok and typeof(m) == "number" then
			return m
		end
	end
	return r
end

-- claude-bud JOB 55: the gate / tower guards' damage multiplier. With the fix live for the base owner they get the
-- Turret Guns track too (= the post guards' PostDamageMult); OFF = Research only, as before.
function BaseGuards.GuardDamageMult(ownerUserId: number, H: any): number
	local EC: any = require(Shared.Configs.EndgameConfig)
	if EC.DefenceFixLive(ownerUserId) then
		return BaseGuards.PostDamageMult(ownerUserId, H)
	end
	return H.ResearchMult(ownerUserId)
end

-- the post guards' HP: Posts.Health x Research GuardHP (min 3) x the JOB 39 Gate & Walls (EndgameConfig.Defence.GatePct
-- a level, 12 %), <= x3
function BaseGuards.AfterSpawnPost(g: any, ownerUserId: number)
	local P = C.Posts
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local m = 1
	local rs = deps.ResearchService
	if owner and rs and rs.GetBonus then
		local ok, v = pcall(rs.GetBonus, owner, C.HealthStat)
		if ok and typeof(v) == "number" and v == v then
			m = math.clamp(v, 1, 3)
		end
	end
	local eg = deps.EndgameService
	if eg and eg.DefenceLevelFor then
		local ok, L = pcall(eg.DefenceLevelFor, ownerUserId, "Gate")
		if ok and typeof(L) == "number" then
			m *= 1 + ((require(Shared.Configs.EndgameConfig) :: any).Defence.GatePct / 100) * L -- claude-bud JOB 55: was 0.12 typed twice
		end
	end
	m = math.min(m, 3)
	g.Humanoid.MaxHealth = math.floor(P.Health * m + 0.5)
	g.Humanoid.Health = g.Humanoid.MaxHealth -- AfterSpawn only
	g.Model:SetAttribute("WE_GuardState", "IDLE")
end

-- the statues this live plot's posts replace: parked in ServerStorage while live, put back when the plot clears
local parked: { [number]: { { Name: string, CF: CFrame, Model: Model, Parent: Instance } } } = {}
function BaseGuards.CollectPosts(plotFolder: Instance, plotId: number): { { Name: string, CF: CFrame } }
	local list = parked[plotId]
	if list == nil then
		local found = {}
		local store = game:GetService("ServerStorage"):FindFirstChild("WE_ParkedStatues")
		if store == nil then
			local f = Instance.new("Folder")
			f.Name = "WE_ParkedStatues"
			f.Parent = game:GetService("ServerStorage")
			store = f
		end
		for _, m in ipairs(plotFolder:GetDescendants()) do -- once per plot sync (claim / walls), never per frame
			if m:IsA("Model") and m:GetAttribute("GateGuard") ~= true and m:GetAttribute("NPCType") == "Guard" then
				local match = false
				for _, pat in ipairs(C.Posts.StatuePatterns) do
					if string.match(m.Name, pat) then
						match = true
					end
				end
				if match and m.Parent then
					table.insert(found, { Name = m.Name, CF = m:GetPivot(), Model = m, Parent = m.Parent :: Instance })
				end
			end
		end
		for _, r in ipairs(found) do
			r.Model.Parent = store
		end
		parked[plotId] = found
		list = found
	end
	local out = {}
	for _, r in ipairs(list :: any) do
		table.insert(out, { Name = r.Name, CF = r.CF })
	end
	return out
end

function BaseGuards.RestoreStatues(plotId: number)
	local list = parked[plotId]
	if list == nil then
		return
	end
	for _, r in ipairs(list) do
		if r.Parent and r.Parent.Parent then
			r.Model.Parent = r.Parent
		end
	end
	parked[plotId] = nil
end

--[[ One gate / extra guard, one think. Returns true (GateDefenseService's old think is skipped). ]]
function BaseGuards.ThinkGuard(def: any, g: any, stats: any, tnow: number, H: any): boolean
	if g.IsPost == true then
		BaseGuards.ThinkPost(def, g, tnow, H) -- JOB 40: the post guards' state machine
		return true
	end
	if not g.Alive or g.Humanoid.Health <= 0 or not g.Root.Parent then
		return true
	end
	local pos = g.Root.Position
	local list = hostiles(def, H, true, pos, math.huge)
	local best: Target? = nil
	local bestD = math.huge
	for _, t in ipairs(list) do
		-- only intruders within the leash (+ the shoot range) of this guard's post
		local fromPost = (t.Root.Position - g.PostCf.Position).Magnitude
		local d = (t.Root.Position - pos).Magnitude
		if fromPost <= C.LeashStuds + (stats.ShootRange or 70) and d < bestD then
			best, bestD = t, d
		end
	end
	if best then
		local t = best :: Target
		g._bgLastIntruder = tnow
		H.FaceYaw(g.Root, t.Root.Position)
		local range = stats.ShootRange or 70
		local ignore: { Instance } = { g.Model, def.Folder, t.Root.Parent :: Instance }
		local sees = H.HasLos(pos, t.Root.Position, ignore)
		if bestD > range * 0.85 or not sees then
			if sees then
				g._bgPath = nil
				g.Humanoid:MoveTo(leashed(def, g, t.Root.Position, H))
			else
				local path = g._bgPath
				if path and path.I <= #path.Points then
					local wp = path.Points[path.I]
					if (pos - wp.Position).Magnitude < 3 then
						path.I += 1
					end
					g.Humanoid:MoveTo(leashed(def, g, wp.Position, H))
				else
					requestPath(g, leashed(def, g, t.Root.Position, H), tnow)
				end
			end
		else
			g.Humanoid:MoveTo(pos)
		end
		local interval = 1 / math.max(stats.GuardFireRate or 1.4, 0.1)
		if sees and bestD <= range and tnow - g.LastFireAt >= interval and claimShooter(def, tnow) then
			g.LastFireAt = tnow
			if rng:NextNumber() <= hitChance(bestD, range) then
				hurt(def, t, (stats.GuardDamage or 14) * BaseGuards.GuardDamageMult(def.OwnerUserId, H), "BaseGuard", H) -- claude-bud JOB 55
			end
			pcall(H.ShotFx, def, g, pos, t.Root.Position)
		end
		return true
	end
	-- no intruder: hold, then walk back to the post and stand there (idle)
	local post = g.PostCf.Position
	if tnow - (g._bgLastIntruder or -math.huge) >= C.ReturnAfterSeconds and (Vector3.new(pos.X - post.X, 0, pos.Z - post.Z)).Magnitude > 2 then
		g.Humanoid:MoveTo(post)
	elseif (Vector3.new(pos.X - post.X, 0, pos.Z - post.Z)).Magnitude <= 2 then
		g.Humanoid:MoveTo(pos)
		H.FaceYaw(g.Root, post + g.PostCf.LookVector * 10)
	end
	g._bgPath = nil
	return true
end

-- the extra guards' posts (Defenses research GuardRoster), world CFrames facing the gate
function BaseGuards.ExtraPosts(plotId: number, ownerUserId: number, gateCf: CFrame): { CFrame }
	local out: { CFrame } = {}
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local rs = deps.ResearchService
	local n = 0
	if owner and rs and rs.GetAdd then
		local ok, v = pcall(rs.GetAdd, owner, C.CountStat)
		n = if ok then math.clamp(math.floor(tonumber(v) or 0), 0, C.MaxExtraGuards) else 0
	end
	local okPF, PlotFrame = pcall(function()
		return require(Shared.Util.PlotFrame) :: any
	end)
	for i = 1, n do
		local p = C.ExtraPosts[i]
		if p and okPF then
			local at = PlotFrame.LocalToWorld(plotId, p.X, p.Z)
			local gate = gateCf.Position
			out[i] = CFrame.lookAt(Vector3.new(at.X, gate.Y, at.Z), Vector3.new(gate.X, gate.Y, gate.Z))
		end
	end
	return out
end

-- claude-bud JOB 22: base guards never collide with each other (they still collide with the world and players)
local GUARD_GROUP = "WE_Guards"
local guardGroupReady = false
local function guardGroup(model: Model)
	if not guardGroupReady then
		guardGroupReady = true
		pcall(function()
			local PS = game:GetService("PhysicsService")
			if not PS:IsCollisionGroupRegistered(GUARD_GROUP) then
				PS:RegisterCollisionGroup(GUARD_GROUP)
			end
			PS:CollisionGroupSetCollidable(GUARD_GROUP, GUARD_GROUP, false)
			-- v123: a friendly base guard never body-blocks a player (WE_PlayerChars, ArmyFollow.PlayerGroup)
			if not PS:IsCollisionGroupRegistered("WE_PlayerChars") then
				PS:RegisterCollisionGroup("WE_PlayerChars")
			end
			PS:CollisionGroupSetCollidable(GUARD_GROUP, "WE_PlayerChars", false)
		end)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = GUARD_GROUP
		end
	end
	model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = GUARD_GROUP
		end
	end)
end
BaseGuards.GuardGroup = GUARD_GROUP

-- after a guard spawns: the Defenses research HP multiplier
function BaseGuards.AfterSpawn(g: any, ownerUserId: number)
	pcall(guardGroup, g.Model)
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local rs = deps.ResearchService
	if owner and rs and rs.GetBonus then
		local ok, m = pcall(rs.GetBonus, owner, C.HealthStat)
		if ok and typeof(m) == "number" and m > 1 then
			g.Humanoid.MaxHealth = math.floor(g.Humanoid.MaxHealth * math.min(m, 3))
			g.Humanoid.Health = g.Humanoid.MaxHealth
		end
	end
end

function BaseGuards.RespawnSeconds(): number
	return C.RespawnSeconds
end

-- a player killed an enemy base guard / tower guard: the smaller reward (not on MOST KILLS), pair-limited
function BaseGuards.OnGuardKilledBy(attacker: Player, ownerUserId: number)
	if isPrivateServer() or attacker.UserId == ownerUserId then
		return
	end
	if GuardConfig.AllowPair(pairLog, attacker.UserId, ownerUserId, os.clock()) then
		reward(attacker, C.Rewards.GuardKillCash, C.Rewards.GuardKillXP, "guard_kill")
	end
end

-- ── tower guards ────────────────────────────────────────────────────────────────────────────────────────────────
type TowerSlot = { Unit: any?, DeadAt: number? }
local towerState: { [number]: { Def: any, Slots: { [number]: TowerSlot }, CheckAt: number, Prompts: { [number]: Instance } } } = {}

local function platforms(def: any): { [number]: BasePart }
	local out: { [number]: BasePart } = {}
	local plotFolder = def.Folder and def.Folder.Parent
	local tf = plotFolder and plotFolder:FindFirstChild(C.Tower.Folder, true)
	if tf then
		for i = 1, C.Tower.Slots do
			local p = tf:FindFirstChild(C.Tower.PlatformPrefix .. i, true)
			if p and p:IsA("BasePart") then
				out[i] = p
			end
		end
	end
	return out
end

-- tower slots 1..n are hired, n = the owner's Tower Guards research level (bought through ResearchService.Purchase)
local function hiredCount(ownerUserId: number): number
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local rs = deps.ResearchService
	if owner and rs and rs.GetAdd then
		local ok, v = pcall(rs.GetAdd, owner, "TowerGuards")
		return if ok then math.clamp(math.floor(tonumber(v) or 0), 0, C.Tower.Slots) else 0
	end
	return 0
end

local function badge(model: Model)
	local head = model:FindFirstChild("Head", true) or model:FindFirstChild("HumanoidRootPart")
	if head and head:IsA("BasePart") and head:FindFirstChild("WE_TowerBadge") == nil then
		local bb = Instance.new("BillboardGui")
		bb.Name = "WE_TowerBadge"
		bb.Size = UDim2.fromScale(1.6, 1.6)
		bb.StudsOffset = Vector3.new(0, 2.4, 0)
		bb.MaxDistance = 40
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.GothamBlack
		t.TextColor3 = C.Tower.BadgeColor
		t.TextStrokeTransparency = 0.3
		t.Text = "★"
		t.Parent = bb
		bb.Parent = head
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and string.find(string.lower(d.Name), "helmet") then
			d.Color = C.Tower.BadgeColor -- a gold helmet
		end
	end
end

local function spawnTower(def: any, i: number, plat: BasePart, H: any): any?
	local top = plat.Position + Vector3.new(0, plat.Size.Y / 2 + 3, 0)
	local centre: Vector3 = def.PadCenter or def.GateCf.Position
	local out = Vector3.new(top.X - centre.X, 0, top.Z - centre.Z)
	local cf = CFrame.lookAt(top, top + (if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, -1))) -- facing out of the base
	-- Code Bot v148: GuardWalkSpeed was missing, so spawnGuardModel set humanoid.WalkSpeed = nil ("value of type nil
	-- cannot be converted to a number", 134 + 53 + 48 live warnings, GateDefenseService line 541/542). A tower guard's
	-- root is anchored on the platform (below), so it never walks: 0.
	local stats = { GuardHealth = C.Tower.Health, GuardDamage = C.Tower.Damage, GuardWalkSpeed = 0 }
	local ok, g = pcall(H.SpawnGuardModel, def.OwnerUserId, 100 + i, cf, stats, def.Folder, def.PlotId)
	if not ok or g == nil then
		return nil
	end
	g.Root.Anchored = true -- stands on the platform
	pcall(guardGroup, g.Model)
	g.Model:SetAttribute("TowerGuard", true)
	g.Model:SetAttribute("OwnerUserId", def.OwnerUserId)
	g.Humanoid.MaxHealth = C.Tower.Health
	g.Humanoid.Health = C.Tower.Health
	badge(g.Model)
	return g
end

local function ensurePrompt(def: any, st: any, i: number, plat: BasePart, hired: boolean)
	local existing = st.Prompts[i]
	if hired then
		if existing then
			existing:Destroy()
			st.Prompts[i] = nil
		end
		return
	end
	if existing and existing.Parent then
		return
	end
	local owner = Players:GetPlayerByUserId(def.OwnerUserId)
	local prof = owner and deps.DataService and deps.DataService.GetProfile(owner)
	local cost = GuardConfig.TowerCost(if prof then tonumber(prof.Prestige) or 0 else 0) -- = ResearchService's scaled price
	local base = Vector3.new(plat.Position.X, def.GateCf.Position.Y + 2, plat.Position.Z)
	local host = Instance.new("Part")
	host.Name = "TowerGuardPrompt" .. i
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Size = Vector3.new(1, 1, 1)
	host.CFrame = CFrame.new(base)
	host:SetAttribute("OwnerUserId", def.OwnerUserId)
	host:SetAttribute("TowerSlot", i)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "WE_TowerGuardPrompt"
	pp.ActionText = "Hire guard - $" .. tostring(cost)
	pp.ObjectText = "Tower Guard"
	pp.HoldDuration = 0.4
	pp.MaxActivationDistance = C.Tower.PromptDistance
	pp.RequiresLineOfSight = false
	pp:SetAttribute("OwnerUserId", def.OwnerUserId)
	pp.Parent = host
	pp.Triggered:Connect(function(player: Player)
		BaseGuards.Hire(player, def.PlotId, i)
	end)
	CollectionService:AddTag(pp, "WE_TowerGuardPrompt") -- the client shows it to the owner only
	host.Parent = def.Folder
	st.Prompts[i] = host
end

-- the owner hires the next tower guard: the Defenses research "Tower Guards" (ResearchService.Purchase pays through the
-- existing research_ purchase path, rebirth-scaled price); only the next free tower's prompt is shown
function BaseGuards.Hire(player: Player, plotId: number, i: number)
	local rl = deps.RateLimitService
	if rl and not rl.Allow(player, "hire_tower_guard", 1, 2) then
		return
	end
	local st = towerState[plotId]
	local def = st and st.Def
	if def == nil or def.OwnerUserId ~= player.UserId or typeof(i) ~= "number" or i ~= hiredCount(player.UserId) + 1 then
		return
	end
	if (platforms(def) :: any)[i] == nil or deps.ResearchService == nil then
		return
	end
	local ok, err = deps.ResearchService.Purchase(player, "TowerGuards")
	if deps.NotificationService then
		if ok then
			pcall(deps.NotificationService.Notify, player, "Tower guard hired!", "Success")
		else
			pcall(deps.NotificationService.Notify, player, if err == "InsufficientCash" then "Not enough Cash" else "Can't hire yet", "Warn")
		end
	end
	st.CheckAt = 0 -- spawn / next prompt on the next think
end

--[[ The plot's tower guards, one think (inside GateDefenseService's 5 Hz loop). ]]
function BaseGuards.ThinkTowers(def: any, tnow: number, H: any)
	if not C.Tower.Enabled then
		return
	end
	local st = towerState[def.PlotId]
	if st == nil or st.Def ~= def then
		st = { Def = def, Slots = {}, CheckAt = 0, Prompts = {} }
		towerState[def.PlotId] = st
	end
	local state = st :: any
	if tnow >= state.CheckAt then
		state.CheckAt = tnow + 3
		local plats = platforms(def)
		local n = hiredCount(def.OwnerUserId)
		for i = 1, C.Tower.Slots do
			local plat = plats[i]
			if plat then
				-- a prompt only on the next free tower (hired ones and later ones show none)
				ensurePrompt(def, state, i, plat, i ~= n + 1)
				local slot = state.Slots[i] or {}
				state.Slots[i] = slot
				if i <= n then
					local u = slot.Unit
					local dead = u == nil or not u.Alive or u.Humanoid.Health <= 0 or u.Model.Parent == nil
					if dead then
						slot.DeadAt = slot.DeadAt or tnow
						if u == nil or tnow - (slot.DeadAt :: number) >= C.RespawnSeconds then
							slot.Unit = spawnTower(def, i, plat, H)
							slot.DeadAt = nil
						end
					end
				end
			end
		end
	end
	for _, slot in pairs(state.Slots) do
		local g = slot.Unit
		if g and g.Alive and g.Humanoid.Health > 0 and g.Root.Parent then
			local pos = g.Root.Position
			local best: Target? = nil
			local bestD = C.Tower.Range
			for _, t in ipairs(hostiles(def, H, false, pos, C.Tower.Range)) do
				local d = (t.Root.Position - pos).Magnitude
				if d < bestD then
					best, bestD = t, d
				end
			end
			if best then
				local t = best :: Target
				local look = Vector3.new(t.Root.Position.X, pos.Y, t.Root.Position.Z)
				if (look - pos).Magnitude > 0.5 then
					g.Root.CFrame = CFrame.lookAt(pos, look)
				end
				local interval = 1 / math.max(C.Tower.FireRate, 0.05)
				if tnow - g.LastFireAt >= interval and H.HasLos(pos, t.Root.Position, { g.Model, def.Folder, t.Root.Parent :: Instance }) and claimShooter(def, tnow) then
					g.LastFireAt = tnow
					if rng:NextNumber() <= C.Tower.HitChance then
						hurt(def, t, C.Tower.Damage * BaseGuards.GuardDamageMult(def.OwnerUserId, H), "TowerGuard", H) -- claude-bud JOB 55
					end
					pcall(H.ShotFx, def, g, pos, t.Root.Position)
				end
			end
		end
	end
end

-- claude-bud JOB 24 §2: the living tower guards of a plot (the attacking army's target scan)
function BaseGuards.TowerUnits(plotId: number): { any }
	local out = {}
	local st = towerState[plotId]
	if st then
		for _, slot in pairs(st.Slots) do
			local g = slot.Unit
			if g and g.Alive then
				table.insert(out, g)
			end
		end
	end
	return out
end

-- a player's hit on a tower guard part (GateDefenseService.ApplyDamage): true when it landed
function BaseGuards.DamageTower(def: any, hitPart: BasePart, amount: number, attacker: Player): boolean
	local st = towerState[def.PlotId]
	if st == nil then
		return false
	end
	for _, slot in pairs(st.Slots) do
		local g = slot.Unit
		if g and (hitPart == g.Root or hitPart:IsDescendantOf(g.Model)) then
			if g.Alive and g.Humanoid.Health > 0 then
				g.Humanoid:TakeDamage(amount)
				if g.Humanoid.Health <= 0 then
					BaseGuards.OnGuardKilledBy(attacker, def.OwnerUserId)
				end
				return true
			end
			return false
		end
	end
	return false
end

return BaseGuards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">BaseLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v68: geometry helpers for Configs/BaseLayoutConfig (plot-local layout → world CFrames).
	v70: every plot has its own frame. BaseLayout.PlotCFrame(plotPos) = plot position turned by the plot yaw; with
	BaseLayoutConfig.FaceMapCentre the plot's FRONT (local +Z) faces the map centre (yaw snapped to 90), otherwise yaw 0.
	All helpers below take the plot position (signatures unchanged) and derive the yaw from it, so callers never pass it.

	Yaw convention (matches CFrame.Angles(0, yaw, 0)): a building's local +Z (its FRONT) maps to world
	(sin yaw, 0, cos yaw). Yaw 0 = faces +Z (plot front / main gate), 90 = +X, -90 = -X, 180 = -Z.

	Heights: the site frame sits at the plot pad CENTRE height. Part-kit offsets were authored against the
	old 1.2-tall plinth (kit bottoms at local ≈ +0.5..+0.6), so at pad-centre height they land on the pad
	top (pad is 1 stud thick) instead of floating where the plinth used to be.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)
-- F10 (owner's 11 features, lane W): the plot yaw / frame maths lives in Shared/Util/PlotFrame (moved there verbatim
-- by lane K1 so configs and the client can use it); BaseLayout delegates, so server and client can never disagree.
local PlotFrame = require(Shared.Util.PlotFrame)

local BaseLayout = {}

BaseLayout.CONSOLE_SIZE = Vector3.new(2.6, 3.4, 1.4)
local PAD_HALF_HEIGHT = 0.5 -- MapSetup PlotPad is 1 stud thick, centred on the plot position

function BaseLayout.Enabled(): boolean
	return BaseLayoutConfig.Enabled == true
end

function BaseLayout.Config(): any
	return BaseLayoutConfig
end

function BaseLayout.PlotSize(default: number): number
	if BaseLayout.Enabled() then
		return BaseLayoutConfig.PlotSize
	end
	return default
end

function BaseLayout.Site(structureId: string): any?
	if not BaseLayout.Enabled() then
		return nil
	end
	return (BaseLayoutConfig.Structures :: any)[structureId]
end

-- v70: true when plots are turned to face the map centre (waterways layout). F10: PlotFrame.FacesMapCentre.
function BaseLayout.FacesMapCentre(): boolean
	return PlotFrame.FacesMapCentre()
end

-- v70: plot yaw in degrees (0 / 90 / -90 / 180). Front (main gate) toward the map centre. F10: PlotFrame.PlotYaw.
function BaseLayout.PlotYaw(plotPos: Vector3): number
	return PlotFrame.PlotYaw(plotPos)
end

-- v70: plot frame at the plot position (pad centre height). World = PlotCFrame(plotPos) * plot-local.
-- F10: PlotFrame.PlotCFrame (exact quarter-turn matrix, no 6e-17 noise from cos(pi/2)).
function BaseLayout.PlotCFrame(plotPos: Vector3): CFrame
	return PlotFrame.PlotCFrame(plotPos)
end

-- v70: unit vector of the plot FRONT (local +Z) in world space
function BaseLayout.PlotForward(plotPos: Vector3): Vector3
	return BaseLayout.PlotCFrame(plotPos):VectorToWorldSpace(Vector3.new(0, 0, 1))
end

-- Rotate a plot-local (x, z) offset by yaw degrees (same convention as CFrame.Angles(0, yaw, 0)).
function BaseLayout.Rotate(x: number, z: number, yawDeg: number): (number, number)
	local a = math.rad(yawDeg)
	return x * math.cos(a) + z * math.sin(a), -x * math.sin(a) + z * math.cos(a)
end

-- Plot-local point → world (y relative to plotPos.Y). v70: turned by the plot yaw.
function BaseLayout.PlotPoint(plotPos: Vector3, x: number, z: number, y: number?): Vector3
	return BaseLayout.PlotCFrame(plotPos):PointToWorldSpace(Vector3.new(x, y or 0, z))
end

-- v70: plot-local CFrame → world. yawDeg turns the part inside the plot (same convention as Site.Yaw).
function BaseLayout.PlotLocalCFrame(plotPos: Vector3, x: number, y: number, z: number, yawDeg: number?): CFrame
	local cf = BaseLayout.PlotCFrame(plotPos) * CFrame.new(x, y, z)
	if yawDeg and yawDeg ~= 0 then
		cf *= CFrame.Angles(0, math.rad(yawDeg), 0)
	end
	return cf
end

local function r2(v: number): number
	return math.round(v * 100) / 100
end

-- v70: plot-local axis-aligned rect (centre cx, cz; size sx, sz) → world centre (y = plotPos.Y) and world X/Z sizes.
-- For water and other parts that must stay axis-aligned in the world: build them with CFrame.new(centre) and the
-- returned sizes (swapped for yaw +-90) instead of rotating them.
function BaseLayout.PlotRect(plotPos: Vector3, cx: number, cz: number, sx: number, sz: number): (Vector3, number, number)
	local c = BaseLayout.PlotPoint(plotPos, cx, cz)
	c = Vector3.new(r2(c.X), plotPos.Y, r2(c.Z))
	if BaseLayout.PlotYaw(plotPos) % 180 ~= 0 then
		return c, sz, sx
	end
	return c, sx, sz
end

-- Site frame for a structure at pad-centre height (kit offsets are relative to this).
function BaseLayout.SiteCFrame(plotPos: Vector3, structureId: string): CFrame?
	local s = BaseLayout.Site(structureId)
	if not s then
		return nil
	end
	return BaseLayout.PlotLocalCFrame(plotPos, s.Site.X, 0, s.Site.Z, s.Yaw or 0)
end

-- Console (upgrade slot) CFrame. Walk-in: inside the building near the door, facing the room.
-- Outdoor: kiosk on the pad, facing the plot centre.
function BaseLayout.ConsoleCFrame(plotPos: Vector3, structureId: string): CFrame?
	local s = BaseLayout.Site(structureId)
	if not s then
		return nil
	end
	local h = BaseLayout.CONSOLE_SIZE.Y
	if s.WalkIn and s.Console then
		local site = BaseLayout.PlotLocalCFrame(plotPos, s.Site.X, PAD_HALF_HEIGHT, s.Site.Z, s.Yaw or 0)
		-- building floor top is 0.4 above the pad (HollowBuildingBuilder); face local -X (into the room)
		return site * CFrame.new(s.Console.X, 0.4 + h * 0.5, s.Console.Z) * CFrame.Angles(0, math.rad(90), 0)
	end
	local k = s.Kiosk or s.Site
	local at = BaseLayout.PlotPoint(plotPos, k.X, k.Z, PAD_HALF_HEIGHT + h * 0.5)
	local centre = Vector3.new(plotPos.X, at.Y, plotPos.Z)
	if (centre - at).Magnitude < 1 then
		return CFrame.new(at)
	end
	return CFrame.lookAt(at, centre)
end

-- Plot-local point → world, on the pad top.
function BaseLayout.GroundPoint(plotPos: Vector3, x: number, z: number, lift: number?): Vector3
	return BaseLayout.PlotPoint(plotPos, x, z, PAD_HALF_HEIGHT + (lift or 0))
end

return BaseLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">BaseTierBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 39 phase 2 (2026-09-30): BASE TIER visuals (JOB 39 §2.3 / §11.1). The base visibly grows, Fort ->
	Capital, from Parts (PreferMesh OFF, own design, docs/ROBLOX-BUILD-GUIDE.md §2: layered pieces, trims, material
	variation; no single-box towers or walls). Pure builder: Build(ctx, tier) returns a Model; EndgameService parents it
	under the plot folder as WE_BaseTier and rebuilds it when the tier, the Command Center level or the walls change.
	Cumulative: tier 3 = the T1 + T2 + T3 pieces.
	  T1 Fort        roofs on the gate posts (eave, two steps, a finial) + one HQ storey with a window band
	  T2 Citadel     a lattice comms mast with a dish and a beacon, a sandbagged roof deck, the first AutoGun nest's ammo
	  T3 Stronghold  four corner bastions on the wall ring (skirt, body, string course, parapet, merlons, deck) and a
	                 gatehouse frame (piers + lintel + crest), clear of the 10-stud opening
	  T4 Bastion     a floodlit flag tower beside the HQ (ONE SpotLight, no shadows), the second nest's ammo, flag masts
	                 on the gate roofs
	  T5 Capital     a stone kerb round the parade ground, a bronze commander statue on a plinth, a row of four banners
	                 with the gold Capital trim
	Budgets: <= EndgameConfig.BaseTier.MaxPartsPerTier (120) parts and <= MaxLightsPerTier (2) lights per tier;
	tools/sim/run_endgame_test.py builds every tier with this module and counts. Banners are plain colours: no nation,
	no insignia. Decorative pieces never collide or answer a ray; the bastions and the statue plinth do (cover).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EndgameConfig = require(Shared.Configs.EndgameConfig)

local BaseTierBuilder = {}

export type Ctx = {
	Ground: CFrame, -- the plot frame at the pad's top (plot-local +Z = the front / gate side)
	PadCentre: Vector3,
	HalfX: number, -- the wall ring's half extents (world X / Z, axis aligned like SyncPerimeterWalls)
	HalfZ: number,
	WallTop: number, -- world Y of the wall tops
	GroundY: number,
	Posts: { { CFrame: CFrame, Size: Vector3 } }, -- the gate posts (roofs sit on them)
	Gate: CFrame?, -- GateDefenseService gate frame (local -Z = inside)
	Nests: { CFrame }, -- the Base Tier AutoGun nests (T2 first, T4 second)
	HQ: { CFrame: CFrame, Size: Vector3 }?, -- the Command Center building's box
	BannerColor: Color3?, -- phase 5: the Black Market banner colour (nil = the base green)
	Crest: boolean?, -- phase 5: the R35 Bastion Crest (a gold crest over the gate)
	Trophy: boolean?, -- phase 5: the Black Market trophy cannon on the parade ground
	Walls: { { CFrame: CFrame, Size: Vector3 } }?, -- Code Bot v171: the perimeter wall bodies (read only)
	RecruitTrim: boolean?, -- Code Bot v171: the Recruit Pack's gold base trim
}

local M = Enum.Material
local C = {
	Body = Color3.fromRGB(200, 186, 150),
	Trim = Color3.fromRGB(226, 220, 204),
	Gold = Color3.fromRGB(214, 178, 64),
	RecruitGold = Color3.fromRGB(236, 190, 52), -- Code Bot v171: a bright, saturated gold for the Recruit trim
	RecruitGoldDeep = Color3.fromRGB(196, 146, 30),
	Roof = Color3.fromRGB(84, 86, 80),
	Concrete = Color3.fromRGB(150, 146, 136),
	ConcreteDark = Color3.fromRGB(112, 110, 104),
	Steel = Color3.fromRGB(64, 68, 72),
	Sand = Color3.fromRGB(186, 168, 122),
	Olive = Color3.fromRGB(86, 96, 60),
	Glass = Color3.fromRGB(120, 160, 180),
	Bronze = Color3.fromRGB(140, 98, 52),
	Banner = Color3.fromRGB(40, 70, 52),
	Red = Color3.fromRGB(170, 40, 40),
}

local function put(m: Model, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, solid: boolean?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = solid == true
	p.CanTouch = false
	p.CastShadow = solid == true and size.Magnitude > 8
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p:SetAttribute("WE_TierPiece", true)
	p.Parent = m
	return p
end

local function tierFolder(m: Model, t: number): Model
	local f = Instance.new("Model")
	f.Name = "Tier" .. t
	f.Parent = m
	return f
end

-- a gate post's roof: eave, two steps, a finial (4 parts)
local function postRoof(m: Model, post: { CFrame: CFrame, Size: Vector3 })
	local top = post.CFrame * CFrame.new(0, post.Size.Y * 0.5, 0)
	local sx, sz = post.Size.X, post.Size.Z
	put(m, "GateRoofEave", Vector3.new(sx + 1.4, 0.4, sz + 1.4), top * CFrame.new(0, 0.2, 0), C.Trim, M.Concrete)
	put(m, "GateRoofStep", Vector3.new(sx + 0.6, 0.9, sz + 0.6), top * CFrame.new(0, 0.85, 0), C.Roof, M.Slate)
	put(m, "GateRoofStep", Vector3.new(math.max(sx * 0.55, 0.8), 0.8, math.max(sz * 0.55, 0.8)), top * CFrame.new(0, 1.7, 0), C.Roof, M.Slate)
	put(m, "GateRoofFinial", Vector3.new(0.7, 0.7, 0.7), top * CFrame.new(0, 2.45, 0), C.Gold, M.Metal, false, Enum.PartType.Ball)
end

-- the extra HQ storey (18 parts): plinth band, 4 walls of lower panel + glass band + upper panel, roof slab, coping ring
local function hqStorey(m: Model, hq: { CFrame: CFrame, Size: Vector3 }): (CFrame, number, number)
	local T = hq.CFrame * CFrame.new(0, hq.Size.Y * 0.5, 0)
	local w, d = math.max(hq.Size.X - 3, 8), math.max(hq.Size.Z - 3, 8)
	put(m, "StoreyPlinth", Vector3.new(w + 0.6, 0.5, d + 0.6), T * CFrame.new(0, 0.25, 0), C.Trim, M.Concrete)
	local sides = {
		{ F = CFrame.new(0, 0, -d * 0.5), Len = w },
		{ F = CFrame.new(0, 0, d * 0.5), Len = w },
		{ F = CFrame.new(-w * 0.5, 0, 0) * CFrame.Angles(0, math.rad(90), 0), Len = d },
		{ F = CFrame.new(w * 0.5, 0, 0) * CFrame.Angles(0, math.rad(90), 0), Len = d },
	}
	for _, s in ipairs(sides) do
		local f = T * s.F
		local len = s.Len
		put(m, "StoreyWall", Vector3.new(len, 2, 0.6), f * CFrame.new(0, 1.5, 0), C.Body, M.Plaster)
		put(m, "StoreyWindowBand", Vector3.new(len - 1, 1.6, 0.3), f * CFrame.new(0, 3.3, 0), C.Glass, M.Glass).Transparency = 0.35
		put(m, "StoreyWall", Vector3.new(len, 2.2, 0.6), f * CFrame.new(0, 5.2, 0), C.Body, M.Plaster)
	end
	put(m, "StoreyRoof", Vector3.new(w + 1, 0.5, d + 1), T * CFrame.new(0, 6.55, 0), C.Roof, M.Concrete)
	for _, s in ipairs(sides) do
		local f = T * s.F
		put(m, "StoreyCoping", Vector3.new(s.Len + 1.2, 0.3, 0.5), f * CFrame.new(0, 6.95, 0), C.Gold, M.Metal)
	end
	return T * CFrame.new(0, 6.8, 0), w, d
end

-- ammo boxes + an extra sandbag layer at a nest (10 parts)
local function nestDressing(m: Model, at: CFrame)
	local g = at
	for i, x in ipairs({ -1.6, 0, 1.6 }) do
		local b = g * CFrame.new(x, 0.45, 3.4) * CFrame.Angles(0, math.rad(i * 7), 0)
		put(m, "AmmoBox", Vector3.new(1.4, 0.8, 0.9), b, C.Olive, M.Metal)
		put(m, "AmmoBoxLid", Vector3.new(1.45, 0.12, 0.95), b * CFrame.new(0, 0.45, 0), C.Steel, M.Metal)
	end
	for i = 0, 3 do
		local a = math.rad(-60 + i * 40)
		put(m, "NestSandbag", Vector3.new(2.2, 0.9, 1.1), g * CFrame.Angles(0, a, 0) * CFrame.new(0, 2.3, -3.3), C.Sand, M.Sand)
	end
end

-- a corner bastion on the wall ring (12 parts)
local function bastion(m: Model, pos: Vector3, groundY: number, top: number)
	local h = math.max(top - groundY + 1.5, 8)
	local base = CFrame.new(pos.X, groundY, pos.Z)
	put(m, "BastionSkirt", Vector3.new(12, 2.5, 12), base * CFrame.new(0, 1.25, 0), C.ConcreteDark, M.Concrete, true)
	put(m, "BastionBody", Vector3.new(10, h, 10), base * CFrame.new(0, h * 0.5, 0), C.Concrete, M.Concrete, true)
	put(m, "BastionBand", Vector3.new(10.6, 0.6, 10.6), base * CFrame.new(0, h * 0.55, 0), C.Trim, M.Concrete)
	put(m, "BastionDeck", Vector3.new(9.2, 0.4, 9.2), base * CFrame.new(0, h + 0.2, 0), C.ConcreteDark, M.Concrete, true)
	for i = 0, 3 do
		local f = base * CFrame.Angles(0, math.rad(90 * i), 0)
		put(m, "BastionParapet", Vector3.new(10.4, 2.2, 0.8), f * CFrame.new(0, h + 1.1, -4.8), C.Concrete, M.Concrete, true)
		put(m, "BastionMerlon", Vector3.new(1.4, 1.2, 1.4), f * CFrame.new(4.5, h + 2.8, -4.5), C.Trim, M.Concrete)
	end
end

-- a flag on a mast: pole, banner, gold finial (3 parts); `trim` adds the Capital strip (1 more)
local bannerColor: Color3 = C.Banner
local function flagMast(m: Model, base: CFrame, height: number, trim: boolean)
	put(m, "FlagMast", Vector3.new(height, 0.3, 0.3), base * CFrame.new(0, height * 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Steel, M.Metal, true, Enum.PartType.Cylinder)
	put(m, "FlagBanner", Vector3.new(0.1, 2.6, 4), base * CFrame.new(0, height - 1.6, 2.1), bannerColor, M.Fabric)
	put(m, "FlagFinial", Vector3.new(0.6, 0.6, 0.6), base * CFrame.new(0, height + 0.3, 0), C.Gold, M.Metal, false, Enum.PartType.Ball)
	if trim then
		put(m, "CapitalTrim", Vector3.new(0.12, 0.35, 4), base * CFrame.new(0, height - 3.0, 2.1), C.Gold, M.Metal)
	end
end

local function statue(m: Model, base: CFrame)
	put(m, "StatuePlinthBase", Vector3.new(6, 1.2, 6), base * CFrame.new(0, 0.6, 0), C.ConcreteDark, M.Granite, true)
	put(m, "StatuePlinth", Vector3.new(4.4, 4, 4.4), base * CFrame.new(0, 3.2, 0), C.Concrete, M.Granite, true)
	put(m, "StatuePlinthCap", Vector3.new(5, 0.5, 5), base * CFrame.new(0, 5.45, 0), C.Trim, M.Marble)
	put(m, "StatuePlaque", Vector3.new(2.4, 1, 0.1), base * CFrame.new(0, 3.4, -2.26), C.Gold, M.Metal)
	-- the bronze commander, x1.6 of a soldier, facing the gate (plot +Z = the frame's -Z here: see the caller)
	local f = base * CFrame.new(0, 5.7, 0)
	local k = 1.6
	for _, s in ipairs({ -1, 1 }) do
		put(m, "StatueBoot", Vector3.new(0.9 * k, 0.5 * k, 1.2 * k), f * CFrame.new(0.5 * k * s, 0.25 * k, -0.1 * k), C.Bronze, M.Metal)
		put(m, "StatueLeg", Vector3.new(0.85 * k, 2.3 * k, 0.85 * k), f * CFrame.new(0.5 * k * s, 1.65 * k, 0), C.Bronze, M.Metal)
		put(m, "StatueEpaulette", Vector3.new(0.8 * k, 0.15 * k, 0.9 * k), f * CFrame.new(1.2 * k * s, 4.95 * k, 0), C.Bronze, M.Metal)
	end
	put(m, "StatueCoat", Vector3.new(2.1 * k, 2.4 * k, 1.1 * k), f * CFrame.new(0, 3.75 * k, 0), C.Bronze, M.Metal)
	put(m, "StatueCoatSkirt", Vector3.new(2.3 * k, 1.1 * k, 1.3 * k), f * CFrame.new(0, 2.6 * k, 0.05 * k), C.Bronze, M.Metal)
	put(m, "StatueArm", Vector3.new(0.75 * k, 2.1 * k, 0.75 * k), f * CFrame.new(-1.4 * k, 3.8 * k, 0), C.Bronze, M.Metal)
	-- the right arm raised, pointing out over the parade ground
	put(m, "StatueArm", Vector3.new(0.75 * k, 2.1 * k, 0.75 * k), f * CFrame.new(1.45 * k, 4.6 * k, -0.7 * k) * CFrame.Angles(math.rad(70), 0, 0), C.Bronze, M.Metal)
	put(m, "StatueHead", Vector3.new(1.1 * k, 1.15 * k, 1.1 * k), f * CFrame.new(0, 5.5 * k, 0), C.Bronze, M.Metal)
	put(m, "StatueCap", Vector3.new(1.3 * k, 0.4 * k, 1.3 * k), f * CFrame.new(0, 6.2 * k, 0), C.Bronze, M.Metal)
	put(m, "StatueVisor", Vector3.new(1.0 * k, 0.1 * k, 0.5 * k), f * CFrame.new(0, 6.05 * k, -0.8 * k), C.Bronze, M.Metal)
end

--[[ Build the tier `tier` (1..5) look for one base. Returns the Model (unparented), its part count and light count. ]]
function BaseTierBuilder.Build(ctx: Ctx, tier: number): (Model, number, number)
	local root = Instance.new("Model")
	root.Name = "WE_BaseTier"
	root.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local t = math.clamp(math.floor(tier), 0, #EndgameConfig.BaseTier.Tiers)
	root:SetAttribute("WE_Tier", t)
	bannerColor = ctx.BannerColor or C.Banner
	local G = ctx.Ground
	local roofTop: CFrame? = nil
	local rw, rd = 0, 0
	local lights = 0

	if t >= 1 then
		local m = tierFolder(root, 1)
		for i, p in ipairs(ctx.Posts) do
			if i <= 4 then
				postRoof(m, p)
			end
		end
		if ctx.HQ then
			roofTop, rw, rd = hqStorey(m, ctx.HQ :: any)
		end
	end
	if t >= 2 then
		local m = tierFolder(root, 2)
		local rt = roofTop
		if rt then
			-- the comms mast in the back corner of the new storey's roof
			local mb = rt * CFrame.new(rw * 0.5 - 2.5, 0, rd * 0.5 - 2.5)
			for _, c in ipairs({ { -0.9, -0.9 }, { 0.9, -0.9 }, { -0.9, 0.9 }, { 0.9, 0.9 } }) do
				put(m, "MastLeg", Vector3.new(0.3, 10, 0.3), mb * CFrame.new(c[1], 5, c[2]), C.Steel, M.Metal)
			end
			put(m, "MastBrace", Vector3.new(0.18, 10.2, 0.18), mb * CFrame.new(0, 5, -0.9) * CFrame.Angles(0, 0, math.rad(10)), C.Steel, M.Metal)
			put(m, "MastBrace", Vector3.new(0.18, 10.2, 0.18), mb * CFrame.new(-0.9, 5, 0) * CFrame.Angles(math.rad(10), 0, 0), C.Steel, M.Metal)
			put(m, "MastPlatform", Vector3.new(2.6, 0.25, 2.6), mb * CFrame.new(0, 10.1, 0), C.Steel, M.DiamondPlate)
			local dish = mb * CFrame.new(0, 8, -1.4) * CFrame.Angles(0, math.rad(90), math.rad(-20))
			put(m, "MastDish", Vector3.new(0.3, 3.2, 3.2), dish, Color3.fromRGB(228, 228, 222), M.SmoothPlastic, false, Enum.PartType.Cylinder)
			put(m, "MastDishFeed", Vector3.new(0.2, 0.2, 1.4), dish * CFrame.new(0, 0, 0) * CFrame.new(-0.8, 0, 0), C.Steel, M.Metal)
			put(m, "MastDishMount", Vector3.new(0.6, 0.6, 0.6), mb * CFrame.new(0, 8, -0.6), C.Steel, M.Metal)
			put(m, "MastBeacon", Vector3.new(0.5, 0.5, 0.5), mb * CFrame.new(0, 10.5, 0), C.Red, M.SmoothPlastic, false, Enum.PartType.Ball)
			-- the sandbagged roof deck: a bag row inside each roof edge, two high on the front, two ammo crates
			for i, e in ipairs({ { 0, -(rd * 0.5 - 1), rw - 3, 0 }, { 0, rd * 0.5 - 1, rw - 3, 0 }, { -(rw * 0.5 - 1), 0, rd - 3, 90 }, { rw * 0.5 - 1, 0, rd - 3, 90 } }) do
				local f = rt * CFrame.new(e[1], 0.45, e[2]) * CFrame.Angles(0, math.rad(e[4]), 0)
				put(m, "DeckSandbags", Vector3.new(e[3], 0.9, 1.1), f, C.Sand, M.Sand)
				if i <= 2 then
					put(m, "DeckSandbags", Vector3.new(e[3] - 2, 0.8, 1.0), f * CFrame.new(0, 0.85, 0), C.Sand, M.Sand)
				end
			end
			put(m, "DeckCrate", Vector3.new(1.6, 1.2, 1.2), rt * CFrame.new(-rw * 0.25, 0.6, 0), C.Olive, M.Wood)
			put(m, "DeckCrate", Vector3.new(1.2, 1.0, 1.2), rt * CFrame.new(-rw * 0.25 + 1.6, 0.5, 0.3), C.Olive, M.Wood)
		end
		if ctx.Nests[1] then
			nestDressing(m, ctx.Nests[1])
		end
	end
	if t >= 3 then
		local m = tierFolder(root, 3)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				bastion(m, Vector3.new(ctx.PadCentre.X + sx * ctx.HalfX, 0, ctx.PadCentre.Z + sz * ctx.HalfZ), ctx.GroundY, ctx.WallTop)
			end
		end
		local gate = ctx.Gate
		if gate then
			local gh = math.max(ctx.WallTop - ctx.GroundY, 12)
			for _, s in ipairs({ -1, 1 }) do
				put(m, "GatehousePlinth", Vector3.new(3.4, 1.2, 4.6), gate * CFrame.new(6.6 * s, 0.6, 0), C.ConcreteDark, M.Concrete)
				put(m, "GatehousePier", Vector3.new(2.5, gh + 2, 4), gate * CFrame.new(6.6 * s, (gh + 2) * 0.5, 0), C.Concrete, M.Concrete)
			end
			put(m, "GatehouseLintel", Vector3.new(16, 2, 4.2), gate * CFrame.new(0, gh + 1, 0), C.Concrete, M.Concrete)
			put(m, "GatehouseCrest", Vector3.new(6, 1.6, 2), gate * CFrame.new(0, gh + 2.8, 0), C.Gold, M.Metal)
		end
	end
	if t >= 4 then
		local m = tierFolder(root, 4)
		local fb = G * CFrame.new(24, 0, -40)
		put(m, "TowerPlinth", Vector3.new(6, 1.2, 6), fb * CFrame.new(0, 0.6, 0), C.ConcreteDark, M.Concrete, true)
		put(m, "TowerShaft", Vector3.new(4.4, 10, 4.4), fb * CFrame.new(0, 6.2, 0), C.Concrete, M.Concrete, true)
		put(m, "TowerBand", Vector3.new(4.8, 0.5, 4.8), fb * CFrame.new(0, 11.4, 0), C.Trim, M.Concrete)
		put(m, "TowerShaft", Vector3.new(3.6, 8, 3.6), fb * CFrame.new(0, 15.6, 0), C.Concrete, M.Concrete, true)
		put(m, "TowerPlatform", Vector3.new(6, 0.5, 6), fb * CFrame.new(0, 19.85, 0), C.Steel, M.DiamondPlate, true)
		for i = 0, 3 do
			put(m, "TowerRail", Vector3.new(6, 1, 0.2), fb * CFrame.Angles(0, math.rad(90 * i), 0) * CFrame.new(0, 20.6, -2.9), C.Steel, M.Metal)
		end
		local lamp = put(m, "TowerFloodlight", Vector3.new(1.2, 0.8, 1.2), fb * CFrame.new(0, 20.5, 2) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(236, 230, 210), M.Metal)
		local sl = Instance.new("SpotLight")
		sl.Face = Enum.NormalId.Front
		sl.Angle = 55
		sl.Range = 18
		sl.Brightness = 0.8
		sl.Shadows = false
		sl.Color = Color3.fromRGB(255, 236, 190)
		sl.Parent = lamp
		lights += 1
		flagMast(m, fb * CFrame.new(0, 20.1, 0), 7, false)
		if ctx.Nests[2] then
			nestDressing(m, ctx.Nests[2])
		end
		for i, p in ipairs(ctx.Posts) do
			if i <= 2 then
				local top = p.CFrame * CFrame.new(0, p.Size.Y * 0.5 + 2.8, 0)
				put(m, "GateMast", Vector3.new(4.5, 0.25, 0.25), top * CFrame.new(0, 2.25, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Steel, M.Metal, false, Enum.PartType.Cylinder)
				put(m, "GateBanner", Vector3.new(0.1, 1.8, 2.6), top * CFrame.new(0, 3.3, 1.4), bannerColor, M.Fabric)
			end
		end
	end
	if t >= 5 then
		local m = tierFolder(root, 5)
		-- the stone kerb round the parade ground (BaseLayoutConfig Roads.Plaza: centre 0, 8; 60 x 50)
		put(m, "ParadeKerb", Vector3.new(61, 0.3, 0.6), G * CFrame.new(0, 0.15, 8 - 25.3), C.Trim, M.Marble)
		put(m, "ParadeKerb", Vector3.new(61, 0.3, 0.6), G * CFrame.new(0, 0.15, 8 + 25.3), C.Trim, M.Marble)
		put(m, "ParadeKerb", Vector3.new(0.6, 0.3, 50), G * CFrame.new(-30.3, 0.15, 8), C.Trim, M.Marble)
		put(m, "ParadeKerb", Vector3.new(0.6, 0.3, 50), G * CFrame.new(30.3, 0.15, 8), C.Trim, M.Marble)
		-- the statue faces the gate (plot +Z): its frame's -Z must point to +Z
		statue(m, G * CFrame.new(-18, 0, 20) * CFrame.Angles(0, math.rad(180), 0))
		for _, x in ipairs({ -30, -18, 18, 30 }) do
			flagMast(m, G * CFrame.new(x, 0, -14), 14, true)
		end
	end
	-- phase 5 extras (any tier): the R35 Bastion Crest over the gate, the Black Market trophy cannon on the parade ground
	local gate = ctx.Gate
	if ctx.Crest and gate then
		local m = tierFolder(root, 0)
		m.Name = "Crest"
		local ch = math.max(ctx.WallTop - ctx.GroundY, 12) + 4.6
		put(m, "CrestShield", Vector3.new(2.6, 3.0, 0.4), gate * CFrame.new(0, ch, -2.3), C.Gold, M.Metal)
		put(m, "CrestInlay", Vector3.new(1.6, 2.0, 0.1), gate * CFrame.new(0, ch, -2.55), bannerColor, M.SmoothPlastic)
		put(m, "CrestPoint", Vector3.new(1.4, 1.4, 0.4), gate * CFrame.new(0, ch - 1.6, -2.3) * CFrame.Angles(0, 0, math.rad(45)), C.Gold, M.Metal)
	end
	-- v157: the Black Market banners below Tier 4 (the gate banners Tier 4 adds): two masts on the gate posts, 4 parts
	if ctx.BannerColor and t < 4 then
		local m = tierFolder(root, 0)
		m.Name = "MarketBanners"
		for i, p in ipairs(ctx.Posts) do
			if i <= 2 then
				local top = p.CFrame * CFrame.new(0, p.Size.Y * 0.5 + (if t >= 1 then 2.8 else 0), 0)
				put(m, "GateMast", Vector3.new(4.5, 0.25, 0.25), top * CFrame.new(0, 2.25, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Steel, M.Metal, false, Enum.PartType.Cylinder)
				put(m, "GateBanner", Vector3.new(0.1, 1.8, 2.6), top * CFrame.new(0, 3.3, 1.4), bannerColor, M.Fabric)
			end
		end
	end
	if ctx.Trophy then
		local m = tierFolder(root, 0)
		m.Name = "Trophy"
		local tb = G * CFrame.new(18, 0, 20) * CFrame.Angles(0, math.rad(180), 0)
		put(m, "TrophyPlinth", Vector3.new(7, 1, 4.4), tb * CFrame.new(0, 0.5, 0), C.ConcreteDark, M.Granite, true)
		put(m, "TrophyPlinthCap", Vector3.new(7.4, 0.3, 4.8), tb * CFrame.new(0, 1.15, 0), C.Trim, M.Marble)
		for _, s in ipairs({ -1, 1 }) do
			put(m, "TrophyWheel", Vector3.new(0.5, 2.6, 2.6), tb * CFrame.new(1.3 * s, 2.6, 0.6) * CFrame.Angles(0, 0, math.rad(90)), C.Bronze, M.Metal, false, Enum.PartType.Cylinder)
			put(m, "TrophyHub", Vector3.new(0.7, 0.6, 0.6), tb * CFrame.new(1.3 * s, 2.6, 0.6) * CFrame.Angles(0, 0, math.rad(90)), C.Gold, M.Metal, false, Enum.PartType.Cylinder)
		end
		put(m, "TrophyCarriage", Vector3.new(1.8, 0.7, 3.4), tb * CFrame.new(0, 2.2, 0.9), C.Bronze, M.Wood)
		put(m, "TrophyTrail", Vector3.new(0.6, 0.5, 2.6), tb * CFrame.new(0, 1.6, 2.6) * CFrame.Angles(math.rad(-14), 0, 0), C.Bronze, M.Wood)
		put(m, "TrophyBarrel", Vector3.new(4.6, 0.8, 0.8), tb * CFrame.new(0, 3.1, -0.6) * CFrame.Angles(0, math.rad(90), math.rad(12)), C.Bronze, M.Metal, false, Enum.PartType.Cylinder)
		put(m, "TrophyMuzzle", Vector3.new(0.5, 1.0, 1.0), tb * CFrame.new(0, 3.55, -2.8) * CFrame.Angles(0, math.rad(90), math.rad(12)), C.Gold, M.Metal, false, Enum.PartType.Cylinder)
		put(m, "TrophyBreech", Vector3.new(0.9, 0.9, 0.9), tb * CFrame.new(0, 2.75, 1.5), C.Bronze, M.Metal, false, Enum.PartType.Ball)
		for i, x in ipairs({ -2.6, -2.0, 2.3 }) do
			put(m, "TrophyShot" .. i, Vector3.new(0.6, 0.6, 0.6), tb * CFrame.new(x, 1.6, -1.4), C.Steel, M.Metal, false, Enum.PartType.Ball)
		end
		put(m, "TrophyPlaque", Vector3.new(2.2, 0.6, 0.08), tb * CFrame.new(0, 0.6, -2.24), C.Gold, M.Metal)
	end

	-- Code Bot v171 (Shaun 2026-10-01: bought the Recruit Pack, "no gold base trim appeared"): until v170 the "gold
	-- base trim" was only a thicker outline on the base SIGN's title (already gold) and "RECRUIT ·" in its text line;
	-- nothing on the base itself changed. Now the trim is real geometry on HIS base, built with the rest of
	-- WE_BaseTier (any tier, saved entitlement -> back on every join): a polished gold crown band right under every
	-- perimeter wall's concrete cap (it overhangs the cap by 0.05 a side, so it reads from the ground and the air), a
	-- deep-gold pinstripe below it, a gold band round each gate post and a gold finial on each post. Decorative only:
	-- no collision, no ray, no stat. Never touches a building model.
	if ctx.RecruitTrim then
		local m = tierFolder(root, 0)
		m.Name = "RecruitTrim"
		for _, w in ipairs(ctx.Walls or {}) do
			local sz = w.Size
			local top = w.CFrame * CFrame.new(0, sz.Y * 0.5, 0)
			local band = put(m, "RecruitWallBand", Vector3.new(sz.X + 0.5, 0.8, sz.Z + 0.5), top * CFrame.new(0, -0.4, 0), C.RecruitGold, M.Metal)
			band.Reflectance = 0.12
			put(m, "RecruitWallStripe", Vector3.new(sz.X + 0.3, 0.35, sz.Z + 0.3), top * CFrame.new(0, -1.6, 0), C.RecruitGoldDeep, M.Metal)
		end
		for i, p in ipairs(ctx.Posts) do
			if i <= 4 then
				local pb = put(m, "RecruitPostBand", Vector3.new(p.Size.X + 0.4, 0.5, p.Size.Z + 0.4), p.CFrame * CFrame.new(0, p.Size.Y * 0.5 - 1.2, 0), C.RecruitGold, M.Metal)
				pb.Reflectance = 0.12
				if t < 1 then -- no Tier 1 post roof: a gold ball finial on the bare post top
					put(m, "RecruitPostFinial", Vector3.new(0.9, 0.9, 0.9), p.CFrame * CFrame.new(0, p.Size.Y * 0.5 + 0.45, 0), C.RecruitGold, M.Metal, false, Enum.PartType.Ball)
				end
			end
		end
		-- with a Tier 1 post roof: its own finial turns Recruit gold (no second ball; the Tier 4 masts sit above it)
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") and d.Name == "GateRoofFinial" then
				d.Color = C.RecruitGold
				d.Reflectance = 0.12
			end
		end
	end

	local parts = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			parts += 1
		end
	end
	root:SetAttribute("WE_TierParts", parts)
	return root, parts, lights
end

return BaseTierBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">DefenceVisuals</string>
            <string name="Source"><![CDATA[--!strict
--[[ claude-bud JOB 53: the Defence upgrades you can SEE.

	EndgameConfig.Defence levels (profile.Endgame.Defence.{Plating, Guns, Gate, Vault}, saved) used to change numbers
	only. This module dresses the base defences by VISUAL TIER (EndgameConfig.DefenceVisualTier: L1-3 = 1, L4-6 = 2,
	L7-9 = 3, L10 = 4):
	  * Plating -> armour plates round each turret nest (side plates -> front shield -> dark steel -> gold-edged ring)
	  * Guns    -> ammo crates + a shell rack beside each nest (more and heavier with the tier)
	  * Gate    -> steel bands / corner plates / a top beam on the gate leaves, plus the leaves' colour by tier
	  * Vault   -> plating round the plot's money collector (corner brackets -> side plates -> cage -> armour cap)
	and shows the gate's DAMAGE STATE (EndgameConfig.GateDamageStage: >60 % clean, <=60 % scorched + dents, <=30 %
	plates sag + smoke, breached = the reinforcement is gone).

	Rules: plain Parts only, Anchored, CanCollide / CanQuery / CanTouch false (they never block a shot, a raycast or a
	walk), no Neon, no lights, CastShadow false on small bits, at most DefenceVisuals.MaxParts per piece. Everything
	is parented inside the plot's WE_GateDefense folder (GateDefenseService.syncPlotNow), so every SyncPlot / rejoin /
	restart rebuilds it from the SAVED levels and nothing is left behind. OFF (EndgameConfig.DefenceVisualsLive) =
	nothing is built. ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EndgameConfig: any = require(Shared.Configs.EndgameConfig)

local DefenceVisuals = {}

local M = Enum.Material
local C = {
	Steel = Color3.fromRGB(92, 96, 100),
	SteelDark = Color3.fromRGB(46, 49, 54),
	Olive = Color3.fromRGB(78, 86, 58),
	Crate = Color3.fromRGB(104, 84, 52),
	Brass = Color3.fromRGB(176, 140, 64),
	Gold = Color3.fromRGB(200, 160, 60),
	Hazard = Color3.fromRGB(210, 170, 40),
	Scorch = Color3.fromRGB(34, 30, 28),
}
-- the gate leaf colour / material per Gate tier (0 = the old look, which setGateBarrierOpen restores)
type Look = { Color: Color3, Mat: Enum.Material }
local LEAF: { [number]: Look } = {
	[0] = { Color = Color3.fromRGB(55, 58, 62), Mat = M.Metal },
	[1] = { Color = Color3.fromRGB(70, 74, 78), Mat = M.Metal },
	[2] = { Color = Color3.fromRGB(62, 66, 70), Mat = M.DiamondPlate },
	[3] = { Color = Color3.fromRGB(44, 47, 52), Mat = M.DiamondPlate },
	[4] = { Color = Color3.fromRGB(34, 36, 40), Mat = M.DiamondPlate },
}

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = size.Magnitude > 6
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function group(parent: Instance, name: string, track: string, tier: number): Model
	local m = Instance.new("Model")
	m.Name = name
	m:SetAttribute("WE_DefenceTrack", track)
	m:SetAttribute("WE_DefenceTier", tier)
	m.Parent = parent
	return m
end

-- ── turrets ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Plating: armour round the nest at `at` (the gun's base CFrame; its -Z faces out). Static: the gun turns inside it.
function DefenceVisuals.TurretPlating(at: CFrame, tier: number, parent: Instance): Model?
	if tier < 1 then
		return nil
	end
	local m = group(parent, "DefVis_Plating", "Plating", tier)
	local col = if tier >= 3 then C.SteelDark else C.Steel
	local mat = if tier >= 2 then M.DiamondPlate else M.Metal
	local h = 1.6 + 0.3 * tier
	for _, sx in ipairs({ -1, 1 }) do -- T1: two side plates
		part(m, "SidePlate", Vector3.new(0.35, h, 2.6), at * CFrame.new(2.5 * sx, h / 2, 0) * CFrame.Angles(0, math.rad(12 * sx), 0), col, mat)
	end
	if tier >= 2 then -- T2: a front shield with a sight slit
		part(m, "FrontShieldL", Vector3.new(1.5, h, 0.35), at * CFrame.new(-1.3, h / 2, -2.4), col, mat)
		part(m, "FrontShieldR", Vector3.new(1.5, h, 0.35), at * CFrame.new(1.3, h / 2, -2.4), col, mat)
	end
	if tier >= 3 then -- T3: rear plates + a hazard band (a dark steel ring)
		part(m, "RearPlate", Vector3.new(3.6, h * 0.7, 0.35), at * CFrame.new(0, h * 0.35, 2.4), col, mat)
		part(m, "HazardBand", Vector3.new(5.2, 0.25, 0.4), at * CFrame.new(0, h - 0.15, -2.4), C.Hazard, M.SmoothPlastic)
	end
	if tier >= 4 then -- T4: gold-edged caps on every plate
		for _, sx in ipairs({ -1, 1 }) do
			part(m, "GoldCap", Vector3.new(0.45, 0.2, 2.7), at * CFrame.new(2.5 * sx, h + 0.1, 0) * CFrame.Angles(0, math.rad(12 * sx), 0), C.Gold, M.Metal)
		end
		part(m, "GoldCapFront", Vector3.new(4.2, 0.2, 0.45), at * CFrame.new(0, h + 0.1, -2.4), C.Gold, M.Metal)
	end
	return m
end

-- Guns: ammo beside the nest (crates, then a shell rack, then a heavy ammo box with brass rounds on top)
function DefenceVisuals.TurretGuns(at: CFrame, tier: number, parent: Instance): Model?
	if tier < 1 then
		return nil
	end
	local m = group(parent, "DefVis_Guns", "Guns", tier)
	part(m, "AmmoCrate1", Vector3.new(1.4, 0.9, 1), at * CFrame.new(3.6, 0.45, 1.2), C.Olive, M.Wood)
	if tier >= 2 then
		part(m, "AmmoCrate2", Vector3.new(1.4, 0.9, 1), at * CFrame.new(3.6, 1.35, 1.2), C.Olive, M.Wood)
		part(m, "ShellRack", Vector3.new(0.3, 1.4, 1.8), at * CFrame.new(-3.7, 0.7, 1), C.SteelDark, M.Metal)
	end
	if tier >= 3 then
		part(m, "HeavyAmmoBox", Vector3.new(1.8, 1, 1.2), at * CFrame.new(-3.6, 0.5, 2.6), C.Crate, M.Wood)
		part(m, "Rounds", Vector3.new(1.5, 0.3, 0.9), at * CFrame.new(-3.6, 1.15, 2.6), C.Brass, M.Metal)
	end
	if tier >= 4 then
		part(m, "BeltFeed", Vector3.new(0.5, 0.25, 2.2), at * CFrame.new(1.9, 1.1, 1.4), C.Brass, M.Metal)
		part(m, "StencilBand", Vector3.new(1.45, 0.2, 1.05), at * CFrame.new(3.6, 1.9, 1.2), C.Hazard, M.SmoothPlastic)
	end
	return m
end

-- ── the gate ────────────────────────────────────────────────────────────────────────────────────────────────────
-- the reinforcement on both leaves (+ the leaves' tier colour, saved as attributes so setGateBarrierOpen restores it)
function DefenceVisuals.Gate(leaves: { BasePart }, tier: number, parent: Instance): Model?
	local look = LEAF[math.clamp(tier, 0, 4)]
	for _, leaf in ipairs(leaves) do
		if tier >= 1 then
			leaf.Color = look.Color
			leaf.Material = look.Mat
			leaf:SetAttribute("WE_DefColor", look.Color)
			leaf:SetAttribute("WE_DefMaterial", look.Mat.Name)
		end
	end
	if tier < 1 or #leaves == 0 then
		return nil
	end
	local m = group(parent, "DefVis_Gate", "Gate", tier)
	for i, leaf in ipairs(leaves) do
		local s = leaf.Size
		local cf = leaf.CFrame
		local face = s.Z / 2 + 0.12
		for _, fz in ipairs({ -1, 1 }) do -- both faces (inside / outside)
			-- T1: two horizontal steel bands
			for _, fy in ipairs({ -0.3, 0.3 }) do
				part(m, "Band", Vector3.new(s.X * 0.96, 0.45, 0.22), cf * CFrame.new(0, s.Y * fy, face * fz), C.SteelDark, M.Metal)
			end
			if tier >= 2 and fz == 1 then -- T2: corner plates (outside face)
				for _, fx in ipairs({ -1, 1 }) do
					part(m, "CornerPlate", Vector3.new(0.9, 0.9, 0.2), cf * CFrame.new(fx * (s.X / 2 - 0.5), s.Y / 2 - 0.5, face * fz), C.Steel, M.Metal)
				end
			end
		end
		if tier >= 3 then -- T3: a diagonal brace (outside)
			local len = math.sqrt(s.X ^ 2 + s.Y ^ 2) * 0.85
			part(m, "Brace", Vector3.new(0.35, len, 0.2), cf * CFrame.new(0, 0, face) * CFrame.Angles(0, 0, math.atan2(s.X, s.Y) * (if i == 1 then 1 else -1)), C.SteelDark, M.Metal)
		end
		-- the damage-state dents (hidden until the stage asks; DefenceVisuals.GateDamage)
		part(m, "Dent1_" .. i, Vector3.new(s.X * 0.4, s.Y * 0.25, 0.15), cf * CFrame.new(s.X * 0.15, -s.Y * 0.1, -face), C.Scorch, M.Slate).Transparency = 1
		part(m, "Dent2_" .. i, Vector3.new(s.X * 0.5, s.Y * 0.3, 0.15), cf * CFrame.new(-s.X * 0.1, s.Y * 0.2, -face), C.Scorch, M.Slate).Transparency = 1
	end
	if tier >= 4 and #leaves >= 2 then -- T4: one top beam across both leaves with a gold edge
		local a, b = leaves[1], leaves[2]
		local mid = a.CFrame.Rotation + (a.Position + b.Position) / 2
		local w = (a.Position - b.Position).Magnitude + a.Size.X
		part(m, "TopBeam", Vector3.new(w, 0.8, a.Size.Z + 0.6), mid * CFrame.new(0, a.Size.Y / 2 + 0.4, 0), C.SteelDark, M.DiamondPlate)
		part(m, "TopBeamGold", Vector3.new(w, 0.18, a.Size.Z + 0.7), mid * CFrame.new(0, a.Size.Y / 2 + 0.85, 0), C.Gold, M.Metal)
	end
	return m
end

--[[ The gate's damage state (called from GateDefenseService.updateGateBillboard, the one funnel every damage / regen /
	rebuild / breach goes through). Stage = EndgameConfig.GateDamageStage(frac, breached): 0 clean, 1 dents + scorched
	(<= 60 %), 2 + sagging bands + smoke (<= 30 %), 3 breached (the reinforcement is hidden, smoke). Only a stage CHANGE
	touches anything (WE_GateDmgStage on leaf 1). Works with no tier visuals too (the smoke + the leaf scorch). ]]
function DefenceVisuals.GateDamage(leaves: { BasePart }, frac: number, breached: boolean): number?
	local first: BasePart? = leaves[1]
	if first == nil or first.Parent == nil then
		return nil
	end
	local stage = EndgameConfig.GateDamageStage(frac, breached)
	if first:GetAttribute("WE_GateDmgStage") == stage then
		return stage
	end
	first:SetAttribute("WE_GateDmgStage", stage)
	local vis = first.Parent:FindFirstChild("DefVis_Gate")
	if vis then
		for _, p in ipairs(vis:GetChildren()) do
			if p:IsA("BasePart") then
				local dent = string.sub(p.Name, 1, 4) == "Dent"
				if dent then
					local n = tonumber(string.sub(p.Name, 5, 5)) or 1
					p.Transparency = if stage >= 3 then 1 elseif stage >= n then 0 else 1
				else
					p.Transparency = if stage >= 3 then 1 else 0
					local sag = p:GetAttribute("WE_SagFrom")
					if stage == 2 and p.Name == "Band" and sag == nil then
						p:SetAttribute("WE_SagFrom", p.CFrame)
						p.CFrame = p.CFrame * CFrame.Angles(0, 0, math.rad(7))
					elseif stage ~= 2 and typeof(sag) == "CFrame" then
						p.CFrame = sag
						p:SetAttribute("WE_SagFrom", nil)
					end
				end
			end
		end
	end
	-- the smoke (one capped emitter on leaf 1)
	local smoke = first:FindFirstChild("WE_GateSmoke")
	if stage >= 2 and smoke == nil then
		local e = Instance.new("ParticleEmitter")
		e.Name = "WE_GateSmoke"
		e.Rate = tonumber(EndgameConfig.DefenceVisuals.SmokeRate) or 4
		e.Lifetime = NumberRange.new(1.6, 2.4)
		e.Speed = NumberRange.new(1.5, 3)
		e.SpreadAngle = Vector2.new(20, 20)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 3.5) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
		e.Color = ColorSequence.new(Color3.fromRGB(60, 58, 56))
		e.LightEmission = 0
		e.Parent = first
	elseif stage < 2 and smoke then
		smoke:Destroy()
	end
	-- the leaves' scorch at stage 1-2 (the breached look is setGateBarrierOpen's)
	if stage <= 2 then
		for _, leaf in ipairs(leaves) do
			local base = leaf:GetAttribute("WE_DefColor")
			local c: Color3 = if typeof(base) == "Color3" then base else LEAF[0].Color
			leaf.Color = if stage >= 1 then c:Lerp(C.Scorch, if stage == 1 then 0.35 else 0.6) else c
		end
	end
	return stage
end

-- ── the vault (the plot's money collector) ───────────────────────────────────────────────────────────────────────
function DefenceVisuals.Vault(collector: Instance?, tier: number, parent: Instance): Model?
	if tier < 1 or collector == nil then
		return nil
	end
	local cf: CFrame, size: Vector3
	if collector:IsA("BasePart") then
		cf, size = collector.CFrame, collector.Size
	elseif collector:IsA("Model") then
		cf, size = collector:GetBoundingBox()
	else
		local body = collector:FindFirstChild("CollectorBody")
		if body == nil or not body:IsA("BasePart") then
			return nil
		end
		cf, size = body.CFrame, body.Size
	end
	local m = group(parent, "DefVis_Vault", "Vault", tier)
	local hx, hz, hy = size.X / 2 + 0.25, size.Z / 2 + 0.25, size.Y / 2
	local col = if tier >= 3 then C.SteelDark else C.Steel
	for _, sx in ipairs({ -1, 1 }) do -- T1: four corner brackets
		for _, sz in ipairs({ -1, 1 }) do
			part(m, "Bracket", Vector3.new(0.4, size.Y * 0.9, 0.4), cf * CFrame.new(hx * sx, 0, hz * sz), col, M.Metal)
		end
	end
	if tier >= 2 then -- T2: side plates
		for _, sx in ipairs({ -1, 1 }) do
			part(m, "SidePlate", Vector3.new(0.2, size.Y * 0.6, size.Z * 0.8), cf * CFrame.new(hx * sx, -hy * 0.2, 0), col, M.DiamondPlate)
		end
	end
	if tier >= 3 then -- T3: a top cage frame
		part(m, "CageFront", Vector3.new(size.X + 0.6, 0.3, 0.3), cf * CFrame.new(0, hy + 0.15, -hz), C.SteelDark, M.Metal)
		part(m, "CageBack", Vector3.new(size.X + 0.6, 0.3, 0.3), cf * CFrame.new(0, hy + 0.15, hz), C.SteelDark, M.Metal)
	end
	if tier >= 4 then -- T4: an armour cap with a gold edge
		part(m, "ArmourCap", Vector3.new(size.X + 0.7, 0.35, size.Z + 0.7), cf * CFrame.new(0, hy + 0.45, 0), C.SteelDark, M.DiamondPlate)
		part(m, "CapGold", Vector3.new(size.X + 0.8, 0.12, size.Z + 0.8), cf * CFrame.new(0, hy + 0.68, 0), C.Gold, M.Metal)
	end
	return m
end

--[[ Apply every track for one plot (GateDefenseService.syncPlotNow, after the turrets + gate exist). levels = the
	owner's saved Defence levels (EndgameService.DefenceLevelFor: 0 while Defence is not live). Returns the parts
	added (the budget test). ]]
function DefenceVisuals.Apply(ownerUserId: number, levels: { [string]: number }, gunBases: { CFrame }, leaves: { BasePart }, collector: Instance?, parent: Instance): number
	if not EndgameConfig.DefenceVisualsLive(ownerUserId) then
		return 0
	end
	local before = #parent:GetDescendants()
	local tierOf = EndgameConfig.DefenceVisualTier
	local pT, gT = tierOf(levels.Plating or 0), tierOf(levels.Guns or 0)
	for _, at in ipairs(gunBases) do
		DefenceVisuals.TurretPlating(at, pT, parent)
		DefenceVisuals.TurretGuns(at, gT, parent)
	end
	DefenceVisuals.Gate(leaves, tierOf(levels.Gate or 0), parent)
	DefenceVisuals.Vault(collector, tierOf(levels.Vault or 0), parent)
	return #parent:GetDescendants() - before
end

return DefenceVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">DesertFlora</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — DesertFlora (procedural Part-kit vegetation kits)
	Saguaro / Joshua / palm / barrel cactus / dry grass tufts / rock outcrop: original Part kits, mobile-friendly counts.
	Called from MapSetup.Run after MapDressing (deferred). CanCollide false; CastShadow false on ALL flora.
	v70 waterways (spec_final §9): Waterways.CullDressing is the safety net at the end.
	World v2 W1 (spec §1.6): the rim ring (r ~3020, inside the Terrain canyon) and the lone mid-map palms are gone.
	World v2 W3 (spec §4.4, roadmap §2.4 WORLD-B builder 2; contracts §5.3): Dress builds NOTHING in step 1. The lone
	mid-map saguaros were H1 orphans; the desert flora now comes from WorldDress (road rhythm flora groups and the natural
	scatter, >= 3 elements of >= 2 sizes each). No third-party catalog overlays (Palm / Cactus / DesertRock ids). The Part
	kits stay exported as DesertFlora.Kits (WorldKits may reuse Palm for the Oasis POI). Dress keeps its folder, the cull
	and WorldHygiene.Enforce, so a later step can add flora here again.
]]

local DesertFlora = {}

local COL = {
	Cactus = Color3.fromRGB(62, 110, 58),
	CactusDark = Color3.fromRGB(48, 88, 48),
	CactusLight = Color3.fromRGB(78, 130, 72),
	JoshuaTrunk = Color3.fromRGB(95, 78, 52),
	JoshuaLeaf = Color3.fromRGB(70, 95, 45),
	PalmTrunk = Color3.fromRGB(110, 85, 55),
	PalmLeaf = Color3.fromRGB(55, 120, 55),
	Barrel = Color3.fromRGB(72, 105, 55),
	Grass = Color3.fromRGB(150, 130, 70),
	GrassDry = Color3.fromRGB(170, 145, 85),
	Rock = Color3.fromRGB(160, 110, 75),
}

-- World v2 W1: Modules/WorldHygiene (rules H1–H10), loaded lazily and guarded like Waterways
local hygieneMod: any = nil
local function getWorldHygiene(): any?
	if hygieneMod == nil then
		local ok, m = pcall(function(): any
			local mod = script.Parent:FindFirstChild("WorldHygiene")
			return if mod and mod:IsA("ModuleScript") then require(mod) :: any else nil
		end)
		hygieneMod = if ok and type(m) == "table" then m else false
		if not ok then
			warn("[DesertFlora] WorldHygiene unavailable:", m)
		end
	end
	return if hygieneMod then hygieneMod else nil
end

-- v70: Modules/Waterways (water rects + dressing cull), loaded lazily so a Waterways error never blocks MapSetup
local waterwaysMod: any = nil
local function getWaterways(): any?
	if waterwaysMod == nil then
		local ok, m = pcall(function(): any
			return require(script.Parent.Waterways) :: any
		end)
		waterwaysMod = if ok and type(m) == "table" then m else false
	end
	return if waterwaysMod then waterwaysMod else nil
end

local function ensureFolder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function p(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = if props.CastShadow ~= nil then props.CastShadow else false -- deco: never cast shadows (Studio perf)
	if props.Name then
		part.Name = props.Name
	end
	if props.Size then
		part.Size = props.Size
	end
	if props.CFrame then
		part.CFrame = props.CFrame
	elseif props.Position then
		part.Position = props.Position
	end
	if props.Color then
		part.Color = props.Color
	end
	if props.Material then
		part.Material = props.Material
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	part:SetAttribute("WE_Decor", true)
	part:SetAttribute("WE_Flora", true)
	return part
end

local function kitSaguaro(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local h = 10 * s
	p({
		Name = "SaguaroTrunk",
		Size = Vector3.new(1.4 * s, h, 1.4 * s),
		Position = origin + Vector3.new(0, h * 0.5, 0),
		Color = COL.Cactus,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	-- Arms
	local armY = h * 0.55
	p({
		Name = "SaguaroArmL",
		Size = Vector3.new(0.9 * s, 4.2 * s, 0.9 * s),
		CFrame = CFrame.new(origin + Vector3.new(-1.6 * s, armY + 1.2 * s, 0)),
		Color = COL.CactusDark,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	p({
		Name = "SaguaroElbowL",
		Size = Vector3.new(2.2 * s, 0.85 * s, 0.85 * s),
		Position = origin + Vector3.new(-0.9 * s, armY, 0),
		Color = COL.Cactus,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	if s > 0.85 then
		p({
			Name = "SaguaroArmR",
			Size = Vector3.new(0.85 * s, 3.4 * s, 0.85 * s),
			Position = origin + Vector3.new(1.5 * s, armY + 0.6 * s, 0.2 * s),
			Color = COL.CactusLight,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		p({
			Name = "SaguaroElbowR",
			Size = Vector3.new(2.0 * s, 0.8 * s, 0.8 * s),
			Position = origin + Vector3.new(0.85 * s, armY - 0.4 * s, 0.2 * s),
			Color = COL.Cactus,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
	end
end

local function kitJoshua(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local trunkH = 7 * s
	p({
		Name = "JoshuaTrunk",
		Size = Vector3.new(1.1 * s, trunkH, 1.1 * s),
		Position = origin + Vector3.new(0, trunkH * 0.5, 0),
		Color = COL.JoshuaTrunk,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	-- Forked branches + spiky leaf clusters
	local forks = {
		{ 1.8, 0.6, 0.4, 25 },
		{ -1.6, 0.4, -0.5, -30 },
		{ 0.3, 1.0, 1.5, 10 },
	}
	for i, f in ipairs(forks) do
		local bx, by, bz, yaw = f[1] * s, trunkH * 0.55 + f[2] * s, f[3] * s, f[4]
		p({
			Name = "JoshuaFork" .. i,
			Size = Vector3.new(0.7 * s, 3.2 * s, 0.7 * s),
			CFrame = CFrame.new(origin + Vector3.new(bx, by + 1.2 * s, bz)) * CFrame.Angles(0, math.rad(yaw), math.rad(18)),
			Color = COL.JoshuaTrunk,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
		p({
			Name = "JoshuaLeaf" .. i,
			Size = Vector3.new(2.4 * s, 0.35 * s, 2.4 * s),
			Position = origin + Vector3.new(bx, by + 2.8 * s, bz),
			Color = COL.JoshuaLeaf,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
	end
end

local function kitPalm(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local trunkH = 12 * s
	p({
		Name = "PalmTrunk",
		Size = Vector3.new(1.2 * s, trunkH, 1.2 * s),
		Position = origin + Vector3.new(0, trunkH * 0.5, 0),
		Color = COL.PalmTrunk,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	-- Fronds as radial slabs
	for i = 0, 5 do
		local ang = i * 60
		p({
			Name = "PalmFrond" .. i,
			Size = Vector3.new(0.35 * s, 0.25 * s, 5.5 * s),
			CFrame = CFrame.new(origin + Vector3.new(0, trunkH + 0.2 * s, 0))
				* CFrame.Angles(0, math.rad(ang), 0)
				* CFrame.new(0, 0, -2.2 * s)
				* CFrame.Angles(math.rad(-25), 0, 0),
			Color = COL.PalmLeaf,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
	end
	p({
		Name = "PalmCrown",
		Size = Vector3.new(1.6 * s, 1.0 * s, 1.6 * s),
		Position = origin + Vector3.new(0, trunkH + 0.4 * s, 0),
		Color = COL.PalmLeaf,
		Material = Enum.Material.Grass,
		Parent = folder,
	})
end

local function kitBarrel(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	p({
		Name = "BarrelBody",
		Size = Vector3.new(2.4 * s, 2.2 * s, 2.4 * s),
		CFrame = CFrame.new(origin + Vector3.new(0, 1.1 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COL.Barrel,
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	p({
		Name = "BarrelTop",
		Size = Vector3.new(1.6 * s, 0.5 * s, 1.6 * s),
		Position = origin + Vector3.new(0, 2.3 * s, 0),
		Color = COL.CactusLight,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function kitGrassTuft(folder: Folder, origin: Vector3)
	for i = 0, 2 do
		local ox = (i - 1) * 0.55
		p({
			Name = "GrassBlade",
			Size = Vector3.new(0.25, 1.4 + (i % 2) * 0.5, 0.25),
			CFrame = CFrame.new(origin + Vector3.new(ox, 0.9, (i % 2) * 0.3))
				* CFrame.Angles(0, math.rad(i * 40), math.rad(8)),
			Color = if i % 2 == 0 then COL.Grass else COL.GrassDry,
			Material = Enum.Material.Grass,
			CastShadow = false,
			Parent = folder,
		})
	end
end

local function kitRockOutcrop(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	p({
		Name = "Outcrop",
		Size = Vector3.new(8 * s, 3.5 * s, 6 * s),
		Position = origin + Vector3.new(0, 1.6 * s, 0),
		Color = COL.Rock,
		Material = Enum.Material.Sandstone,
		CanCollide = true,
		Parent = folder,
	})
	p({
		Name = "OutcropCap",
		Size = Vector3.new(5 * s, 1.8 * s, 4 * s),
		Position = origin + Vector3.new(1.2 * s, 3.8 * s, -0.5 * s),
		Color = COL.Rock:Lerp(Color3.fromRGB(180, 130, 90), 0.3),
		Material = Enum.Material.Sandstone,
		CanCollide = false,
		Parent = folder,
	})
end

-- World v2 (spec §8.2): the Part kits stay, exported for Phase 2 (WorldKits: oasis palms, natural scatter). Each builds
-- one plant into `folder` at `origin` (ground level) with an optional scale.
DesertFlora.Kits = {
	Saguaro = kitSaguaro,
	Joshua = kitJoshua,
	Palm = kitPalm,
	Barrel = kitBarrel,
	GrassTuft = kitGrassTuft,
	RockOutcrop = kitRockOutcrop,
}

-- Builds WarEmpireSetup.DesertFlora (replaces an old one; idempotent). W3 step 1: the folder stays empty (see header).
function DesertFlora.Dress(root: Instance, opts: { Sparse: boolean? }?)
	local flora = ensureFolder("DesertFlora", root)
	local sparse = if opts and opts.Sparse ~= nil then opts.Sparse else true

	-- v70 safety net (spec §9.12): nothing in the water or on a plot pad
	local ww = getWaterways()
	if ww then
		local okCull, res = pcall(ww.CullDressing, flora)
		if not okCull then
			warn("[DesertFlora] water cull failed:", res)
		end
	end

	-- World v2 W1: hygiene rules over what is left (spec §5.1; logs one summary line)
	local wh = getWorldHygiene()
	if wh then
		local okHy, errHy = pcall(wh.Enforce, flora)
		if not okHy then
			warn("[DesertFlora] WorldHygiene.Enforce failed:", errHy)
		end
	end

	local partCount = 0
	for _, d in ipairs(flora:GetDescendants()) do
		if d:IsA("BasePart") then
			partCount += 1
			d.CastShadow = false
		end
	end
	print("[WAR EMPIRE] DesertFlora complete: " .. tostring(partCount) .. " flora parts (sparse=" .. tostring(sparse) .. ", W3: flora from WorldDress)")
end

return DesertFlora
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">DoubleEvent</string>
            <string name="Source"><![CDATA[--!strict
--[[ Code Bot v185: DOUBLE WEEKEND server side (Shared/Configs/EventConfig). The one place the grants ask "how much
	extra right now". Server only: os.time() is the server's UTC clock; the owner preview switch is a ReplicatedStorage
	attribute only the server writes (a client-side attribute change never replicates to the server). ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EventConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs"):WaitForChild("EventConfig")) :: any

local DoubleEvent = {}

function DoubleEvent.PreviewOn(): boolean
	local v = ReplicatedStorage:GetAttribute(EventConfig.PreviewAttr)
	if v == nil then
		return EventConfig.OwnerFirst == true
	end
	return v == true
end

-- owner /eventpreview on|off (AdminService); also published so the owner's client banner follows it
function DoubleEvent.SetPreview(on: boolean)
	ReplicatedStorage:SetAttribute(EventConfig.PreviewAttr, on == true)
end

function DoubleEvent.Init()
	if ReplicatedStorage:GetAttribute(EventConfig.PreviewAttr) == nil then
		ReplicatedStorage:SetAttribute(EventConfig.PreviewAttr, EventConfig.OwnerFirst == true)
	end
end

-- Code Bot v192: the one-time DOUBLE WEEKEND pop-up's "seen" flag. profile.EventPopupSeen = { [EventConfig.Id] = unix }
-- (a NEW profile field; no existing key renamed), replicated as the EventConfig.PopupSeenAttr player attribute
-- (true / false, written once the profile has loaded, so the client waits for it before it decides).
local popupData: any = nil

local function seenIn(profile: any): boolean
	local t = if typeof(profile) == "table" then profile.EventPopupSeen else nil
	return typeof(t) == "table" and (tonumber(t[EventConfig.Id]) or 0) > 0
end

function DoubleEvent.MarkPopupSeen(player: Player)
	pcall(function()
		player:SetAttribute(EventConfig.PopupSeenAttr, true)
	end)
	local profile = popupData and popupData.GetProfile(player)
	if typeof(profile) ~= "table" or seenIn(profile) then
		return
	end
	local t = if typeof(profile.EventPopupSeen) == "table" then profile.EventPopupSeen else {}
	t[EventConfig.Id] = os.time()
	profile.EventPopupSeen = t
	pcall(popupData.MarkDirty, player)
end

-- owner /eventpopup reset: forget his seen flag (so a rejoin shows the real first-time flow again)
function DoubleEvent.ResetPopupSeen(player: Player)
	local profile = popupData and popupData.GetProfile(player)
	if typeof(profile) == "table" and typeof(profile.EventPopupSeen) == "table" then
		profile.EventPopupSeen[EventConfig.Id] = nil
		pcall(popupData.MarkDirty, player)
	end
	pcall(function()
		player:SetAttribute(EventConfig.PopupSeenAttr, false)
	end)
end

-- called from RetentionService.Init (deps: DataService, RemoteSetup, RateLimitService)
function DoubleEvent.InitPopup(deps: { [string]: any })
	popupData = deps.DataService
	if popupData and popupData.OnProfileLoaded then
		popupData.OnProfileLoaded(function(player: Player, profile: any)
			pcall(function()
				player:SetAttribute(EventConfig.PopupSeenAttr, seenIn(profile))
			end)
		end)
	end
	local Constants = require(ReplicatedStorage.Shared.Constants) :: any
	local ev = deps.RemoteSetup and deps.RemoteSetup.Get(Constants.RemoteNames.RequestEventPopupSeen)
	if ev == nil then
		warn("[DoubleEvent] RequestEventPopupSeen remote missing; the pop-up seen flag is session-only")
		return
	end
	ev.OnServerEvent:Connect(function(player: Player, id: any)
		if not require(script.Parent.RemoteGate).Check(player, "RequestEventPopupSeen", id) then
			return
		end
		if id ~= EventConfig.Id then
			return
		end
		if deps.RateLimitService and not deps.RateLimitService.Allow(player, "event_popup_seen", 1, 2) then
			return
		end
		DoubleEvent.MarkPopupSeen(player)
	end)
end

function DoubleEvent.ActiveFor(player: Player?): boolean
	if typeof(player) ~= "Instance" then
		return false
	end
	return EventConfig.ActiveFor((player :: Player).UserId, os.time(), DoubleEvent.PreviewOn())
end

local function clampMult(m: any): number
	local n = tonumber(m) or 1
	if n ~= n or n < 1 then
		return 1
	end
	return math.min(n, 5)
end

function DoubleEvent.IsKillReason(reason: string?): boolean
	return reason ~= nil and EventConfig.KillReasons[reason] == true
end

-- cash x for `reason` (called only inside EconomyService's non-exempt stack): kill reasons -> KillMult
function DoubleEvent.CashMult(player: Player, reason: string?): number
	if not DoubleEvent.ActiveFor(player) then
		return 1
	end
	local key = reason or ""
	if EventConfig.KillReasons[key] then
		return clampMult(EventConfig.KillMult)
	end
	if EventConfig.CashExemptReasons[key] then
		return 1
	end
	return clampMult(EventConfig.CashMult)
end

-- Code Bot v197: cash x for a 2x-pass-EXEMPT `reason` (EconomyService.cashMultFor's exempt branch): CashMult only for
-- EventConfig.ExtraCashReasons (never a kill / CashExemptReasons reason), else 1
function DoubleEvent.ExtraCashMult(player: Player, reason: string?): number
	local key = reason or ""
	local extra = EventConfig.ExtraCashReasons
	if extra == nil or extra[key] ~= true or EventConfig.CashExemptReasons[key] or EventConfig.KillReasons[key] then
		return 1
	end
	if not DoubleEvent.ActiveFor(player) then
		return 1
	end
	return clampMult(EventConfig.CashMult)
end

-- XP x for `reason` (XPService.AddXP, after the pass multiplier's own exemptions): kill reasons -> KillMult
function DoubleEvent.XPMult(player: Player, reason: string?): number
	if not DoubleEvent.ActiveFor(player) then
		return 1
	end
	local key = reason or ""
	if EventConfig.KillReasons[key] then
		return clampMult(EventConfig.KillMult)
	end
	if EventConfig.XPExemptReasons[key] then
		return 1
	end
	return clampMult(EventConfig.XPMult)
end

-- how many a kill counts for (missions KillPlayer / KillNPC, MOST KILLS / ARMY KILLS boards)
function DoubleEvent.KillCount(player: Player): number
	if not DoubleEvent.ActiveFor(player) then
		return 1
	end
	return math.floor(clampMult(EventConfig.KillMult))
end

-- offline pay factor for a counted span [fromUnix, fromUnix + seconds): only the part inside the window is doubled
function DoubleEvent.OfflineFactor(fromUnix: number, seconds: number): number
	if seconds <= 0 then
		return 1
	end
	local inside = EventConfig.OverlapSeconds(fromUnix, fromUnix + seconds)
	return 1 + (clampMult(EventConfig.CashMult) - 1) * inside / seconds
end

return DoubleEvent
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">Enterables</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 32 (2026-09-30): the registry of enterable buildings (WorldKits registers each PlazaHouse it builds).
	Server only, pure maths after registration: no workspace lookups.
	  Register(id, cf, size, doorOut)  cf = the building's ground frame (local -Z = its front / door side), size = its box
	                                   (X across, Y up from the ground, Z deep), doorOut = how far out the army waits
	  At(pos) -> Entry?                the building pos is inside or on top of (the box grown 0.6 sideways, from 1 below
	                                   the ground up to the roof + 8), or nil
	  List() / Clear()
	Entry.Door = the street-side waiting point in front of the door (ground height); Entry.Face = the direction
	looking AT the building from there (the army's formation faces it, so the block forms behind, out in the street).
]]

local Enterables = {}

export type Entry = { Id: string, CF: CFrame, Size: Vector3, Door: Vector3, Face: Vector3 }

local list: { Entry } = {}

function Enterables.Register(id: string, cf: CFrame, size: Vector3, doorOut: number)
	for i = #list, 1, -1 do
		if list[i].Id == id then
			table.remove(list, i)
		end
	end
	local door = (cf * CFrame.new(0, 0, -size.Z * 0.5 - math.max(2, doorOut))).Position
	local face = -cf.LookVector -- from the street toward the building
	table.insert(list, { Id = id, CF = cf, Size = size, Door = door, Face = Vector3.new(face.X, 0, face.Z).Unit })
end

function Enterables.At(pos: Vector3): Entry?
	for _, e in ipairs(list) do
		local lp = e.CF:PointToObjectSpace(pos)
		if math.abs(lp.X) <= e.Size.X * 0.5 + 0.6 and math.abs(lp.Z) <= e.Size.Z * 0.5 + 0.6 and lp.Y >= -1 and lp.Y <= e.Size.Y + 8 then
			return e
		end
	end
	return nil
end

function Enterables.List(): { Entry }
	return list
end

function Enterables.Clear()
	table.clear(list)
end

return Enterables
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">HollowBuildingBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Walk-in structures. Config: StructureVisualConfig.HollowBuildings (Defaults + one entry per structure).

	Builds Model "WE_Building" under the structure's upgrade slot:
	  shell     real doorway (or wide garage door), glass windows, floor, flat roof + parapet, entrance, sign
	  levels    TwoStoryLevel → second storey + interior stairs; AnnexLevel → side annex, mast, floodlights;
	            RoofAccessLevel → truss ladder through a roof hatch + dish; GoldCapLevel → gold parapet; flag
	  interior  Modules/Interiors/<Interior>.luau — function(ictx, api) that furnishes the rooms
	            (ictx = geometry + keep-out zones, api = building-local part helpers + item terminals)

	v68: with BaseLayoutConfig the building is centred on its site (WE_SiteCFrame) and bought/upgraded at the
	console inside it. Legacy (no site): it sits behind its pad with the doorway shifted clear of the pad.

	The kit's "Body" part is only the foundation slab (see StructureKitBuilder), so EnsureKit / applyKitVisuals
	invariants (Body exists, solid at L1+) still hold. Everything else lives in the Model and is rebuilt when
	the level changes.

	streaming2 S4 (F11): WE_Building is ModelStreamingMode Atomic, set before it is parented (inert while
	Workspace.StreamingEnabled is false). Its WE_Spinner sub-models stay Default inside it: the Atomic parent carries them.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)

local HollowBuildingBuilder = {}

local MODEL_NAME = "WE_Building"
local GEN = 3 -- v73 distinct shells: live models built by GEN 2 rebuild once

type Opening = {
	Center: number, -- along the wall's local X
	Width: number,
	Bottom: number, -- above the wall base
	Height: number,
	Glass: boolean,
	Garage: boolean?,
}

type Ctx = {
	model: Model,
	origin: CFrame,
	c: any,
	col: any,
	level: number,
	structureId: string,
}

export type Rect = { X0: number, X1: number, Z0: number, Z1: number }

local function merged(defaults: any, specific: any): any
	local out = {}
	if typeof(defaults) == "table" then
		for k, v in pairs(defaults) do
			out[k] = v
		end
	end
	for k, v in pairs(specific) do
		out[k] = v
	end
	local colors = {}
	if typeof(defaults) == "table" and typeof(defaults.Colors) == "table" then
		for k, v in pairs(defaults.Colors) do
			colors[k] = v
		end
	end
	if typeof(specific.Colors) == "table" then
		for k, v in pairs(specific.Colors) do
			colors[k] = v
		end
	end
	out.Colors = colors
	return out
end

local function cfgFor(structureId: string): any?
	local all = (StructureVisualConfig :: any).HollowBuildings
	if typeof(all) ~= "table" or structureId == "Defaults" then
		return nil
	end
	local c = all[structureId]
	if typeof(c) ~= "table" or c.Enabled == false then
		return nil
	end
	return merged(all.Defaults, c)
end

-- v68 outdoor installations (StructureVisualConfig.Installations): not walk-in shells but a detailed model
-- from Modules/Installations/<Module>.luau on the same foundation slab. Needs BaseLayoutConfig (site frames).
local function instCfgFor(structureId: string): any?
	if not BaseLayoutConfig.Enabled then
		return nil
	end
	local all = (StructureVisualConfig :: any).Installations
	if typeof(all) ~= "table" then
		return nil
	end
	local c = all[structureId]
	if typeof(c) ~= "table" or c.Enabled == false then
		return nil
	end
	local hb = (StructureVisualConfig :: any).HollowBuildings
	return merged(if typeof(hb) == "table" then hb.Defaults else nil, c)
end

function HollowBuildingBuilder.IsHollow(structureId: string): boolean
	return cfgFor(structureId) ~= nil or instCfgFor(structureId) ~= nil
end

function HollowBuildingBuilder.IsInstallation(structureId: string): boolean
	return cfgFor(structureId) == nil and instCfgFor(structureId) ~= nil
end

local function groundY(plinth: BasePart): number
	local parent = plinth.Parent
	local pad = parent and parent:FindFirstChild("PlotPad")
	if pad and pad:IsA("BasePart") then
		return pad.Position.Y + pad.Size.Y * 0.5
	end
	local bs = plinth:GetAttribute("BaseSize")
	local h = if typeof(bs) == "Vector3" then (bs :: Vector3).Y else plinth.Size.Y
	return plinth.Position.Y - h * 0.5
end

local function siteCFrame(plinth: BasePart): CFrame?
	local cf = plinth:GetAttribute("WE_SiteCFrame")
	if typeof(cf) == "CFrame" then
		return cf
	end
	return nil
end

-- Offset of the footprint centre from the kit frame (StructureKitBuilder site frame), at ground level.
-- v68 layout: the building is centred on its site. Legacy pads: behind the pad, shifted sideways.
local function footprintOffset(plinth: BasePart, c: any): Vector3
	local gy = groundY(plinth)
	local site = siteCFrame(plinth)
	if site then
		return Vector3.new(0, gy - site.Position.Y, 0)
	end
	return Vector3.new(c.OffsetX or 0, gy - plinth.Position.Y, -((c.FrontGap or 10) + c.Depth * 0.5))
end

local function originFor(plinth: BasePart, c: any): CFrame
	local site = siteCFrame(plinth)
	if site then
		return site * CFrame.new(footprintOffset(plinth, c))
	end
	local rot = plinth.CFrame - plinth.CFrame.Position
	return CFrame.new(plinth.Position) * rot * CFrame.new(footprintOffset(plinth, c))
end

--[[ Foundation slab for StructureKitBuilder's "Body": (size, local offset in the kit frame). ]]
function HollowBuildingBuilder.FoundationSpec(plinth: BasePart, structureId: string): (Vector3?, Vector3?)
	local c = cfgFor(structureId) or instCfgFor(structureId)
	if not c then
		return nil, nil
	end
	return Vector3.new(c.Width, 0.8, c.Depth), footprintOffset(plinth, c)
end

function HollowBuildingBuilder.FoundationColor(structureId: string): Color3?
	local c = cfgFor(structureId) or instCfgFor(structureId)
	return if c and c.Colors then c.Colors.Floor else nil
end

-- ── primitives ──────────────────────────────────────────────────────────────

local function part(ctx: Ctx, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = if collide == nil then true else collide
	p.CanTouch = false
	-- Walls/floors stay queryable so weapon raycasts and camera occlusion treat the building as solid.
	p.CanQuery = p.CanCollide
	p.CastShadow = true
	p.Parent = ctx.model
	return p
end

local function box(ctx: Ctx, name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material, collide: boolean?): Part
	return part(ctx, name, size, ctx.origin * CFrame.new(pos), color, material, collide)
end

-- v73: WedgePart in building space. Roblox wedge: the slope faces local -Z (and up), the tall face is local +Z.
local function wedgeAt(ctx: Ctx, name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): WedgePart
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Anchored = true
	w.Size = size
	w.CFrame = ctx.origin * localCF
	w.Color = color
	w.Material = material
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.CanCollide = if collide == nil then true else collide
	w.CanTouch = false
	w.CanQuery = w.CanCollide
	w.CastShadow = true
	w.Parent = ctx.model
	return w
end

-- v73: vertical cylinder (Roblox cylinders run along local X) standing on y0 in building space
local function column(ctx: Ctx, name: string, diameter: number, height: number, x: number, y0: number, z: number, color: Color3, material: Enum.Material, collide: boolean?): Part
	local p = part(ctx, name, Vector3.new(height, diameter, diameter), ctx.origin * CFrame.new(x, y0 + height * 0.5, z) * CFrame.Angles(0, 0, math.pi * 0.5), color, material, collide)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- v73: window list entry = a number (centre, default width) or { X = centre, W = width }
local function winAt(e: any, defW: number): (number, number)
	if typeof(e) == "table" then
		return tonumber(e.X) or 0, tonumber(e.W) or defW
	end
	return tonumber(e) or 0, defW
end

local LIGHTS = (StructureVisualConfig :: any).BuildingLights or {}
local FIXTURE_MATERIAL: Enum.Material = LIGHTS.FixtureMaterial or Enum.Material.Neon

local function light(host: BasePart, range: number, brightness: number, color: Color3)
	local l = Instance.new("PointLight")
	l.Range = math.min(range, LIGHTS.MaxRange or range)
	l.Brightness = brightness * (LIGHTS.BrightnessScale or 1)
	l.Color = color
	l.Shadows = false
	l.Parent = host
end

--[[ v70 light budget (HUD spec §5, mobile P1-12; CLAUDE.md: at most 40 lights per base at L5, was 120). The fitting
	parts all stay; only these carry no PointLight:
	  - ceiling fittings other than the one nearest each floor's centre (one light per floor);
	  - entry lamps and terminal lamps (the lamp part still reads as lit);
	  - red warning beacons on masts / pylons / towers (WARNING_BEACONS);
	  - every second fitting of the same name inside one interior / installation module (a row of 3 hangar lamps
	    keeps 2, a pair of floodlamps keeps 1).
	StructureVisualConfig.BuildingLights.LightEveryOther = false turns the last rule off. ]]
local WARNING_BEACONS: { [string]: boolean } = { TowerBeacon = true, PylonBeacon = true, TowerLamp = true, MastBeacon = true }
local TERMINAL_PROMPT_RANGE = 12 -- mobile P1-19: 8 → 12 studs (the thumbstick overshoots a small range)

-- v70: every SurfaceGui draws near-only (CLAUDE.md budget: MaxDistance <= 80). Screens and signs inside a building
-- only need the room (SURFACE_NEAR); outdoor building / installation signs SURFACE_FAR.
local SURFACE_NEAR = 40
local SURFACE_FAR = 80

local function surfaceText(host: BasePart, face: Enum.NormalId, lines: { string }, textColor: Color3, bg: Color3, font: Enum.Font?, maxDistance: number?)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_Screen"
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.MaxDistance = math.min(maxDistance or SURFACE_NEAR, SURFACE_FAR)
	sg.Parent = host
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = bg
	frame.BorderSizePixel = 0
	frame.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame
	for i, text in ipairs(lines) do
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.fromScale(1, 1 / #lines)
		lbl.LayoutOrder = i
		lbl.Font = font or Enum.Font.GothamBold
		lbl.Text = text
		lbl.TextColor3 = textColor
		lbl.TextScaled = true
		lbl.Parent = frame
	end
end

--[[
	Wall along its local X (length len) with base at y=baseY in wallCF space; thickness along local Z,
	local +Z = outside. Openings are cut as piers / sills / lintels; glass openings get a pane + ledge,
	doorways get a metal frame, garage openings a striped frame + rolled shutter drum.
]]
local function wall(ctx: Ctx, name: string, wallCF: CFrame, len: number, height: number, baseY: number, openings: { Opening })
	local c = ctx.c
	local col = ctx.col
	local t = c.WallThickness
	table.sort(openings, function(a, b)
		return a.Center < b.Center
	end)
	local x0 = -len * 0.5
	local x1 = len * 0.5
	-- v73 distinct shells: per-building wall material / frame colour (StructureVisualConfig.HollowBuildings)
	local wallMat: Enum.Material = c.WallMaterial or Enum.Material.Concrete
	local frameCol: Color3 = col.Frame or col.Trim
	local function seg(a: number, b: number, y0: number, y1: number)
		if b - a < 0.05 or y1 - y0 < 0.05 then
			return
		end
		part(ctx, name, Vector3.new(b - a, y1 - y0, t), wallCF * CFrame.new((a + b) * 0.5, (y0 + y1) * 0.5, 0), col.Wall, wallMat)
	end
	local cursor = x0
	for _, o in ipairs(openings) do
		local oa = math.max(x0, o.Center - o.Width * 0.5)
		local ob = math.min(x1, o.Center + o.Width * 0.5)
		if oa >= cursor then
			seg(cursor, oa, baseY, baseY + height)
			seg(oa, ob, baseY, baseY + o.Bottom)
			seg(oa, ob, baseY + o.Bottom + o.Height, baseY + height)
			local w = ob - oa
			local midY = baseY + o.Bottom + o.Height * 0.5
			if o.Glass then
				local pane = part(ctx, name .. "Glass", Vector3.new(w, o.Height, 0.2), wallCF * CFrame.new((oa + ob) * 0.5, midY, 0), col.Glass, Enum.Material.Glass)
				pane.Transparency = 0.45
				pane.Reflectance = 0.08
				pane.CastShadow = false
				if c.WindowMullion ~= false and w > 2 then
					-- one mullion per ~4.5 studs (a ribbon window reads as a row of panes, a normal window keeps one)
					local n = if w >= 9 then math.floor(w / 4.5) else 1
					for k = 1, n do
						local mx = oa + w * k / (n + 1)
						part(ctx, name .. "Mullion", Vector3.new(0.2, o.Height, 0.3), wallCF * CFrame.new(mx, midY, 0), frameCol, Enum.Material.Metal, false)
					end
				end
				if c.WindowLedge ~= false then
					part(ctx, name .. "Ledge", Vector3.new(w + 0.6, 0.3, 0.7), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom - 0.15, t * 0.5 + 0.2), frameCol, Enum.Material.Metal, false)
				end
			elseif o.Garage then
				local frameT = t + 0.4
				for _, edge in ipairs({ oa + 0.3, ob - 0.3 }) do
					part(ctx, name .. "GarageFrame", Vector3.new(0.6, o.Height, frameT), wallCF * CFrame.new(edge, midY, 0), col.Accent, Enum.Material.SmoothPlastic, false)
				end
				part(ctx, name .. "GarageHeader", Vector3.new(w, 0.6, frameT), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom + o.Height - 0.3, 0), col.Metal, Enum.Material.Metal, false)
				local drum = part(ctx, name .. "ShutterDrum", Vector3.new(w - 0.6, 1.4, 1.4), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom + o.Height - 0.5, -t * 0.5 - 0.7), col.Metal, Enum.Material.DiamondPlate, false)
				drum.Shape = Enum.PartType.Cylinder
			else
				-- v73: a heavier, coloured frame reads as a blast-door portal (Armory) at no extra parts
				local fw: number = c.DoorFrameWidth or 0.35
				local frameT = t + (c.DoorFrameDepth or 0.3)
				local dcol: Color3 = col.DoorFrame or col.Metal
				part(ctx, name .. "DoorFrame", Vector3.new(fw, o.Height, frameT), wallCF * CFrame.new(oa + fw * 0.5, midY, 0), dcol, Enum.Material.Metal, false)
				part(ctx, name .. "DoorFrame", Vector3.new(fw, o.Height, frameT), wallCF * CFrame.new(ob - fw * 0.5, midY, 0), dcol, Enum.Material.Metal, false)
				part(ctx, name .. "DoorFrame", Vector3.new(w, fw, frameT), wallCF * CFrame.new((oa + ob) * 0.5, baseY + o.Bottom + o.Height - fw * 0.5, 0), dcol, Enum.Material.Metal, false)
			end
			cursor = ob
		end
	end
	seg(cursor, x1, baseY, baseY + height)
end

-- Horizontal slab in building space with an optional rectangular hole (hx0, hx1, hz0, hz1).
local function slab(ctx: Ctx, name: string, x0: number, x1: number, z0: number, z1: number, yBottom: number, thick: number, color: Color3, material: Enum.Material, hole: { number }?)
	local function piece(a0: number, a1: number, b0: number, b1: number)
		if a1 - a0 < 0.05 or b1 - b0 < 0.05 then
			return
		end
		box(ctx, name, Vector3.new(a1 - a0, thick, b1 - b0), Vector3.new((a0 + a1) * 0.5, yBottom + thick * 0.5, (b0 + b1) * 0.5), color, material)
	end
	if not hole then
		piece(x0, x1, z0, z1)
		return
	end
	local hx0 = math.clamp(hole[1], x0, x1)
	local hx1 = math.clamp(hole[2], x0, x1)
	local hz0 = math.clamp(hole[3], z0, z1)
	local hz1 = math.clamp(hole[4], z0, z1)
	piece(x0, x1, z0, hz0)
	piece(x0, x1, hz1, z1)
	piece(x0, hx0, hz0, hz1)
	piece(hx1, x1, hz0, hz1)
end

local function railing(ctx: Ctx, a: Vector3, b: Vector3, height: number)
	local col = ctx.col
	local dir = b - a
	local len = dir.Magnitude
	if len < 0.1 then
		return
	end
	local mid = (a + b) * 0.5
	local look = CFrame.lookAt(mid, mid + dir) -- local -Z along the rail
	part(ctx, "Rail", Vector3.new(0.25, 0.25, len), ctx.origin * look * CFrame.new(0, height, 0), col.Metal, Enum.Material.Metal)
	part(ctx, "Rail", Vector3.new(0.18, 0.18, len), ctx.origin * look * CFrame.new(0, height * 0.5, 0), col.Metal, Enum.Material.Metal, false)
	local posts = math.max(2, math.floor(len / 3) + 1)
	for i = 0, posts - 1 do
		local p = a + dir * (i / (posts - 1))
		box(ctx, "RailPost", Vector3.new(0.25, height, 0.25), p + Vector3.new(0, height * 0.5, 0), col.Metal, Enum.Material.Metal, false)
	end
end

-- facing: unit X or Z direction the sitter looks toward (backrest goes on the opposite side)
local function chair(ctx: Ctx, pos: Vector3, facing: Vector3)
	local col = ctx.col
	local backSize = if math.abs(facing.X) > 0.5 then Vector3.new(0.3, 1.8, 1.6) else Vector3.new(1.6, 1.8, 0.3)
	box(ctx, "ChairLeg", Vector3.new(0.3, 1.5, 0.3), pos + Vector3.new(0, 0.75, 0), col.Metal, Enum.Material.Metal, false)
	box(ctx, "ChairSeat", Vector3.new(1.6, 0.3, 1.6), pos + Vector3.new(0, 1.65, 0), col.Dark, Enum.Material.Fabric)
	box(ctx, "ChairBack", backSize, pos - facing * 0.65 + Vector3.new(0, 2.7, 0), col.Dark, Enum.Material.Fabric, false)
end

local function sandbags(ctx: Ctx, x0: number, x1: number, z: number, baseY: number)
	local col = ctx.col
	local n = math.max(1, math.floor((x1 - x0) / 2.1))
	local w = (x1 - x0) / n
	for i = 0, n - 1 do
		box(ctx, "Sandbag", Vector3.new(w - 0.1, 1.0, 1.5), Vector3.new(x0 + w * (i + 0.5), baseY + 0.5, z), col.Sandbag, Enum.Material.Fabric)
	end
	for i = 0, n - 2 do
		box(ctx, "Sandbag", Vector3.new(w - 0.1, 1.0, 1.4), Vector3.new(x0 + w * (i + 1), baseY + 1.5, z), col.Sandbag, Enum.Material.Fabric)
	end
end

--[[ Item terminal: a floor-standing screen with a ProximityPrompt that opens a client panel
	(attribute WE_OpenPanel on the prompt; ClientBootstrap routes it). Not an upgrade slot. ]]
local function terminal(ctx: Ctx, name: string, pos: Vector3, facingDeg: number, panel: string, actionText: string, objectText: string, screenLines: { string }?): Part
	local col = ctx.col
	local frame = ctx.origin * CFrame.new(pos) * CFrame.Angles(0, math.rad(facingDeg), 0)
	local body = part(ctx, name, Vector3.new(2.4, 3.2, 1.2), frame * CFrame.new(0, 1.6, 0), col.Dark, Enum.Material.Metal)
	local screen = part(ctx, name .. "Screen", Vector3.new(2.1, 1.3, 0.14), frame * CFrame.new(0, 3.55, 0.3) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(10, 24, 14), Enum.Material.SmoothPlastic, false)
	surfaceText(screen, Enum.NormalId.Back, screenLines or { string.upper(objectText), "TAP TO OPEN" }, col.Screen, Color3.fromRGB(8, 20, 12), Enum.Font.GothamBold)
	-- the lamp is a small interactive cue (kept Neon, spec §5); no PointLight (v70 light budget)
	part(ctx, name .. "Lamp", Vector3.new(0.4, 0.2, 0.4), frame * CFrame.new(0.8, 3.25, 0.35), col.Screen, Enum.Material.Neon, false)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WE_PanelPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = TERMINAL_PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt:SetAttribute("WE_OpenPanel", panel)
	prompt.Parent = body
	body:SetAttribute("WE_Terminal", panel)
	return body
end

-- Part helpers handed to interior / installation modules (building-local coordinates, parts tagged `tag`).
local function makeApi(ctx: Ctx, tag: string): any
	local function tagged(p: Part): Part
		p:SetAttribute(tag, true)
		return p
	end
	-- v70 light budget (see WARNING_BEACONS): modules call api.light per fitting; the budget rules apply here
	local fittings: { [string]: number } = {}
	local everyOther = LIGHTS.LightEveryOther ~= false
	local function budgetLight(host: BasePart, range: number, brightness: number, color: Color3)
		if WARNING_BEACONS[host.Name] then
			return
		end
		local n = (fittings[host.Name] or 0) + 1
		fittings[host.Name] = n
		if everyOther and n % 2 == 0 then
			return
		end
		light(host, range, brightness, color)
	end
	local api = {
		box = function(name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material, collide: boolean?): Part
			return tagged(box(ctx, name, size, pos, color, material, collide))
		end,
		part = function(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): Part
			return tagged(part(ctx, name, size, ctx.origin * localCF, color, material, collide))
		end,
		light = budgetLight,
		surfaceText = function(host: BasePart, face: Enum.NormalId, lines: { string }, textColor: Color3, bg: Color3, font: Enum.Font?, maxDistance: number?)
			surfaceText(host, face, lines, textColor, bg, font, maxDistance or (if tag == "WE_Installation" then SURFACE_FAR else SURFACE_NEAR))
		end,
		chair = function(pos: Vector3, facing: Vector3)
			local before = #ctx.model:GetChildren()
			chair(ctx, pos, facing)
			local kids = ctx.model:GetChildren()
			for i = before + 1, #kids do
				local k = kids[i]
				if k:IsA("BasePart") then
					k:SetAttribute(tag, true)
				end
			end
		end,
		sandbags = function(x0: number, x1: number, z: number, baseY: number)
			local before = #ctx.model:GetChildren()
			sandbags(ctx, x0, x1, z, baseY)
			local kids = ctx.model:GetChildren()
			for i = before + 1, #kids do
				local k = kids[i]
				if k:IsA("BasePart") then
					k:SetAttribute(tag, true)
				end
			end
		end,
		terminal = function(name: string, pos: Vector3, facingDeg: number, panel: string, actionText: string, objectText: string, screenLines: { string }?): Part
			local before = #ctx.model:GetChildren()
			local body = terminal(ctx, name, pos, facingDeg, panel, actionText, objectText, screenLines)
			local kids = ctx.model:GetChildren()
			for i = before + 1, #kids do
				local k = kids[i]
				if k:IsA("BasePart") then
					k:SetAttribute(tag, true)
				end
			end
			return body
		end,
	}
	-- installations: shaped parts, climbable trusses, client-side spinning groups
	api.cylinder = function(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): Part
		local p = tagged(part(ctx, name, size, ctx.origin * localCF, color, material, collide))
		p.Shape = Enum.PartType.Cylinder -- axis = local X
		return p
	end
	api.ball = function(name: string, diameter: number, pos: Vector3, color: Color3, material: Enum.Material, collide: boolean?): Part
		local p = tagged(box(ctx, name, Vector3.new(diameter, diameter, diameter), pos, color, material, collide))
		p.Shape = Enum.PartType.Ball
		return p
	end
	api.wedge = function(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, collide: boolean?): WedgePart
		local w = Instance.new("WedgePart")
		w.Name = name
		w.Anchored = true
		w.Size = size
		w.CFrame = ctx.origin * localCF
		w.Color = color
		w.Material = material
		w.CanCollide = if collide == nil then true else collide
		w.CanTouch = false
		w.CanQuery = w.CanCollide
		w:SetAttribute(tag, true)
		w.Parent = ctx.model
		return w
	end
	api.truss = function(name: string, height: number, pos: Vector3, color: Color3): TrussPart
		local tp = Instance.new("TrussPart")
		tp.Name = name
		tp.Anchored = true
		tp.Size = Vector3.new(2, math.max(2, math.floor(height / 2 + 0.5) * 2), 2)
		tp.CFrame = ctx.origin * CFrame.new(pos.X, pos.Y + tp.Size.Y * 0.5, pos.Z)
		tp.Color = color
		tp.Material = Enum.Material.Metal
		tp.CanTouch = false
		tp:SetAttribute(tag, true)
		tp.Parent = ctx.model
		return tp
	end
	-- Group parts that the client spins around a vertical axis through `pivot` (building-local).
	-- Server copies stay still; Client/Modules/WorldSpinners rotates the tagged Model locally.
	api.spin = function(parts: { BasePart }, pivot: Vector3, rpm: number): Model
		local m = Instance.new("Model")
		m.Name = "WE_Spinner"
		m:SetAttribute("WE_SpinPivot", ctx.origin * CFrame.new(pivot))
		m:SetAttribute("WE_SpinRPM", rpm)
		for _, bp in ipairs(parts) do
			bp.Parent = m
		end
		m.Parent = ctx.model
		CollectionService:AddTag(m, "WE_Spinner")
		return m
	end
	return api
end

-- ── building ────────────────────────────────────────────────────────────────

local function consoleLocal(structureId: string): Vector3?
	local s = (BaseLayoutConfig.Structures :: any)[structureId]
	if BaseLayoutConfig.Enabled and s and s.WalkIn and s.Console then
		return Vector3.new(s.Console.X, 0, s.Console.Z)
	end
	return nil
end

local function build(ctx: Ctx)
	local c = ctx.c
	local col = ctx.col
	local lv = ctx.level
	local W, D, t = c.Width, c.Depth, c.WallThickness
	local H1, H2 = c.StoryHeight, c.UpperStoryHeight
	local hw, hd = W * 0.5, D * 0.5
	local twoStory = lv >= c.TwoStoryLevel
	local hasAnnex = lv >= c.AnnexLevel
	local roofAccess = lv >= c.RoofAccessLevel and twoStory
	local helipad = lv >= c.HelipadLevel
	local goldCap = helipad or lv >= (c.GoldCapLevel or 5)
	local garage = c.DoorStyle == "Garage"
	-- v73 distinct shells (StructureVisualConfig.HollowBuildings): roof form, wall material, entrance, signatures
	local roofStyle: string = c.RoofStyle or "Flat"
	local entrance: string = c.Entrance or (if garage then "Canopy" else "Awning")
	local sig: { [string]: boolean } = {}
	for _, s in ipairs(c.Signatures or {}) do
		sig[s] = true
	end
	local wallMat: Enum.Material = c.WallMaterial or Enum.Material.Concrete
	local frameCol: Color3 = col.Frame or col.Trim
	local roofCol: Color3 = col.RoofSkin or col.Roof
	local roofMat: Enum.Material = c.RoofMaterial or Enum.Material.Metal

	local y1 = 0.4 -- ground floor top (foundation slab = kit Body)
	local y2 = y1 + H1 + 0.8 -- upper floor top
	local roofBottom = if twoStory then y2 + H2 else y1 + H1
	local slabT = if roofStyle == "Lid" then (c.LidThickness or 1.6) else 0.8
	local roofTop = roofBottom + slabT

	local doorX, doorW, doorH = c.DoorX, c.DoorWidth, c.DoorHeight
	local winW, winH, winBottom = c.WindowWidth, c.WindowHeight, c.WindowBottom
	local upW, upH, upBottom = c.UpperWindowWidth or winW, c.UpperWindowHeight or 3.0, c.UpperWindowBottom or 3.2

	-- Stairwell (two storeys) along the back wall, climbing toward +X.
	local stairW = 4.5
	local stairRise = y2 - y1
	local stepCount = math.ceil(stairRise / 0.8)
	local stepRise = stairRise / stepCount
	local stepRun = 1.2
	local stairX0 = -hw + t + 0.5
	local stairX1 = stairX0 + stepCount * stepRun
	local stairZ0 = -hd + t
	local stairZ1 = stairZ0 + stairW

	local annexW, annexD, annexH = c.AnnexWidth or 12, c.AnnexDepth or 14, c.AnnexHeight or 9
	local annexZc = -hd + annexD * 0.5

	-- Walls: ground storey
	local frontCF = ctx.origin * CFrame.new(0, 0, hd - t * 0.5)
	local backCF = ctx.origin * CFrame.new(0, 0, -hd + t * 0.5) * CFrame.Angles(0, math.pi, 0)
	local eastCF = ctx.origin * CFrame.new(hw - t * 0.5, 0, 0) * CFrame.Angles(0, math.pi * 0.5, 0) -- local +X = world -Z
	local westCF = ctx.origin * CFrame.new(-hw + t * 0.5, 0, 0) * CFrame.Angles(0, -math.pi * 0.5, 0) -- local +X = world +Z
	local sideLen = D - 2 * t

	local frontOpen: { Opening } = {
		{ Center = doorX, Width = doorW, Bottom = 0, Height = doorH, Glass = false, Garage = garage },
	}
	for _, e in ipairs(c.FrontWindowsX or {}) do
		local wx, ww = winAt(e, winW)
		table.insert(frontOpen, { Center = wx, Width = ww, Bottom = winBottom, Height = winH, Glass = true })
	end
	wall(ctx, "WallFront", frontCF, W, H1, y1, frontOpen)

	local backOpen: { Opening } = {}
	if not twoStory then
		for _, e in ipairs(c.BackWindowsX or {}) do
			local wx, ww = winAt(e, winW)
			-- back wall local X is mirrored (rotated 180°)
			table.insert(backOpen, { Center = -wx, Width = ww, Bottom = winBottom, Height = winH, Glass = true })
		end
	end
	wall(ctx, "WallBack", backCF, W, H1, y1, backOpen)

	local westOpen: { Opening } = {}
	for _, e in ipairs(c.WestWindowsZ or {}) do
		local wz, ww = winAt(e, winW)
		table.insert(westOpen, { Center = wz, Width = ww, Bottom = winBottom, Height = winH, Glass = true })
	end
	wall(ctx, "WallWest", westCF, sideLen, H1, y1, westOpen)

	local eastOpen: { Opening } = {}
	if hasAnnex then
		table.insert(eastOpen, { Center = -annexZc, Width = 4, Bottom = 0, Height = 7.5, Glass = false })
	else
		for _, e in ipairs(c.EastWindowsZ or {}) do
			local wz, ww = winAt(e, winW)
			table.insert(eastOpen, { Center = -wz, Width = ww, Bottom = winBottom, Height = winH, Glass = true })
		end
	end
	wall(ctx, "WallEast", eastCF, sideLen, H1, y1, eastOpen)

	-- Upper storey
	if twoStory then
		local upFront: { Opening } = {}
		for _, e in ipairs(c.UpperWindowsX or c.FrontWindowsX or {}) do
			local wx, ww = winAt(e, upW)
			table.insert(upFront, { Center = wx, Width = ww, Bottom = upBottom, Height = upH, Glass = true })
		end
		wall(ctx, "WallFront2", frontCF, W, H2, y2, upFront)
		local upBack: { Opening } = {}
		for _, e in ipairs(c.UpperBackWindowsX or c.BackWindowsX or {}) do
			local wx, ww = winAt(e, upW)
			table.insert(upBack, { Center = -wx, Width = ww, Bottom = upBottom, Height = upH, Glass = true })
		end
		wall(ctx, "WallBack2", backCF, W, H2, y2, upBack)
		local upSide: { Opening } = {}
		if c.UpperSideWindows ~= false then
			upSide = { { Center = 0, Width = upW, Bottom = upBottom, Height = upH, Glass = true } }
		end
		wall(ctx, "WallWest2", westCF, sideLen, H2, y2, table.clone(upSide))
		wall(ctx, "WallEast2", eastCF, sideLen, H2, y2, table.clone(upSide))
		box(ctx, "StoreyBand", Vector3.new(W + 0.4, 0.8, 0.3), Vector3.new(0, y2 - 0.4, hd + 0.15), frameCol, Enum.Material.Metal, false)
		box(ctx, "StoreyBand", Vector3.new(W + 0.4, 0.8, 0.3), Vector3.new(0, y2 - 0.4, -hd - 0.15), frameCol, Enum.Material.Metal, false)
		box(ctx, "StoreyBand", Vector3.new(0.3, 0.8, D + 0.4), Vector3.new(hw + 0.15, y2 - 0.4, 0), frameCol, Enum.Material.Metal, false)
		box(ctx, "StoreyBand", Vector3.new(0.3, 0.8, D + 0.4), Vector3.new(-hw - 0.15, y2 - 0.4, 0), frameCol, Enum.Material.Metal, false)

		slab(ctx, "Floor2", -hw + t, hw - t, -hd + t, hd - t, y2 - 0.8, 0.8, col.Floor, Enum.Material.Concrete, { stairX0 - 0.2, stairX1, stairZ0 - 0.1, stairZ1 + 0.2 })
		for k = 1, stepCount do
			local top = y1 + k * stepRise
			box(ctx, "Stair", Vector3.new(stepRun, top - y1, stairW), Vector3.new(stairX0 + (k - 0.5) * stepRun, y1 + (top - y1) * 0.5, (stairZ0 + stairZ1) * 0.5), col.Stair, Enum.Material.Concrete)
		end
		railing(ctx, Vector3.new(stairX0 - 0.2, y2, stairZ1 + 0.3), Vector3.new(stairX1 - 2.4, y2, stairZ1 + 0.3), 3)
	end

	-- Roof: the ceiling slab (every style) + the building's own roof form
	local roofHole: { number }? = nil
	local trussX = hw - t - 1.3
	local trussZ = hd - t - 1.3
	if roofAccess then
		roofHole = { trussX - 1.6, trussX + 1.6, trussZ - 1.6, trussZ + 1.6 }
	end
	local parH = 1.4
	if roofStyle == "Lid" then
		-- bunker lid: one thick slab overhanging every wall, no parapet (Armory)
		local ov: number = c.LidOverhang or 1.2
		slab(ctx, "Roof", -hw - ov, hw + ov, -hd - ov, hd + ov, roofBottom, slabT, col.Roof, Enum.Material.Concrete, roofHole)
		parH = 0
		if goldCap then
			box(ctx, "LidTrim", Vector3.new(W + 2 * ov + 0.1, 0.35, 0.35), Vector3.new(0, roofTop - 0.175, hd + ov), col.Gold, Enum.Material.Metal, false)
		end
	else
		slab(ctx, "Roof", -hw, hw, -hd, hd, roofBottom, 0.8, col.Roof, Enum.Material.Concrete, roofHole)
	end
	if roofStyle == "Flat" then
		box(ctx, "Parapet", Vector3.new(W, parH, t), Vector3.new(0, roofTop + parH * 0.5, hd - t * 0.5), col.Wall, wallMat)
		box(ctx, "Parapet", Vector3.new(W, parH, t), Vector3.new(0, roofTop + parH * 0.5, -hd + t * 0.5), col.Wall, wallMat)
		box(ctx, "Parapet", Vector3.new(t, parH, D - 2 * t), Vector3.new(hw - t * 0.5, roofTop + parH * 0.5, 0), col.Wall, wallMat)
		box(ctx, "Parapet", Vector3.new(t, parH, D - 2 * t), Vector3.new(-hw + t * 0.5, roofTop + parH * 0.5, 0), col.Wall, wallMat)
		local capColor = if goldCap then col.Gold else frameCol
		box(ctx, "ParapetCap", Vector3.new(W + 0.3, 0.3, t + 0.3), Vector3.new(0, roofTop + parH + 0.15, hd - t * 0.5), capColor, Enum.Material.Metal, false)
		box(ctx, "ParapetCap", Vector3.new(W + 0.3, 0.3, t + 0.3), Vector3.new(0, roofTop + parH + 0.15, -hd + t * 0.5), capColor, Enum.Material.Metal, false)
		box(ctx, "ParapetCap", Vector3.new(t + 0.3, 0.3, D), Vector3.new(hw - t * 0.5, roofTop + parH + 0.15, 0), capColor, Enum.Material.Metal, false)
		box(ctx, "ParapetCap", Vector3.new(t + 0.3, 0.3, D), Vector3.new(-hw + t * 0.5, roofTop + parH + 0.15, 0), capColor, Enum.Material.Metal, false)
	elseif roofStyle == "Gable" then
		-- pitched roof, ridge along X: two wedges back to back on the ceiling slab (Barracks)
		local rise: number = c.RoofRise or 6
		local ov: number = c.RoofOverhang or 1
		local run = hd + ov
		local len = W + 2 * ov
		wedgeAt(ctx, "RoofPitch", Vector3.new(len, rise, run), CFrame.new(0, roofTop + rise * 0.5, run * 0.5) * CFrame.Angles(0, math.pi, 0), roofCol, roofMat)
		wedgeAt(ctx, "RoofPitch", Vector3.new(len, rise, run), CFrame.new(0, roofTop + rise * 0.5, -run * 0.5), roofCol, roofMat)
		box(ctx, "RoofRidge", Vector3.new(len + 0.2, 0.45, 0.9), Vector3.new(0, roofTop + rise, 0), if goldCap then col.Gold else frameCol, Enum.Material.Metal, false)
		parH = rise
	elseif roofStyle == "Vault" then
		-- segmental barrel vault across the facade (hangar), glazed arch end at the front (Vehicle Depot)
		local rise: number = c.RoofRise or 9
		local ov: number = c.RoofOverhang or 0.6
		local a = hw + ov
		local R = (a * a + rise * rise) / (2 * rise)
		local yc = roofTop + rise - R
		local th0 = math.asin(a / R)
		local n: number = c.VaultSegments or 8
		local dth = 2 * th0 / n
		local chord = 2 * R * math.sin(dth * 0.5)
		local th = 0.6
		local len = D + 2 * (c.RoofEndOverhang or 1.2)
		local rm = R * math.cos(dth * 0.5) + th * 0.5
		for i = 0, n - 1 do
			local phi = -th0 + (i + 0.5) * dth
			part(ctx, "VaultPlank", Vector3.new(chord + 0.3, th, len), ctx.origin * CFrame.new(rm * math.sin(phi), yc + rm * math.cos(phi), 0) * CFrame.Angles(0, 0, -phi), roofCol, roofMat)
		end
		local strips: number = c.VaultEndStrips or 4
		local hs = rise / strips
		for s = 0, strips - 1 do
			local yb = roofTop + s * hs
			local yq = math.min(roofTop + (s + 1) * hs, roofTop + rise - 0.35)
			local half = math.min(hw, math.sqrt(math.max(0, R * R - (yq - yc) ^ 2)))
			if half > 0.5 and yq > yb + 0.1 then
				local g = box(ctx, "VaultEndGlass", Vector3.new(2 * half, yq - yb, 0.3), Vector3.new(0, (yb + yq) * 0.5, hd - t * 0.5), col.Glass, Enum.Material.Glass, false)
				g.Transparency = 0.3
				box(ctx, "VaultEnd", Vector3.new(2 * half, yq - yb, t), Vector3.new(0, (yb + yq) * 0.5, -hd + t * 0.5), col.Wall, wallMat)
			end
		end
		if goldCap then
			box(ctx, "VaultCrown", Vector3.new(0.9, 0.3, len + 0.1), Vector3.new(0, roofTop + rise + th + 0.1, 0), col.Gold, Enum.Material.Metal, false)
		end
		parH = rise + th
	elseif roofStyle == "Sawtooth" then
		-- factory sawtooth: ridges run front to back so the zigzag reads from the road (Warehouse)
		local teeth: number = c.SawTeeth or 4
		local rise: number = c.RoofRise or 4.5
		local tw = W / teeth
		local len = D + 1
		for k = 0, teeth - 1 do
			local cx = -hw + (k + 0.5) * tw
			wedgeAt(ctx, "SawTooth", Vector3.new(len, rise, tw), CFrame.new(cx, roofTop + rise * 0.5, 0) * CFrame.Angles(0, math.pi * 0.5, 0), roofCol, roofMat)
			local g = box(ctx, "SawGlass", Vector3.new(0.2, rise - 0.7, len - 1.2), Vector3.new(cx + tw * 0.5 + 0.12, roofTop + rise * 0.5 - 0.15, 0), col.Glass, Enum.Material.Glass, false)
			g.Transparency = 0.25
		end
		if goldCap then
			box(ctx, "SawTrim", Vector3.new(W + 0.2, 0.35, 0.35), Vector3.new(0, roofTop + 0.18, hd + 0.35), col.Gold, Enum.Material.Metal, false)
		end
		parH = rise
	end

	-- Rooftop plant
	if c.RoofPlant ~= false then
		box(ctx, "ACUnit", Vector3.new(3, 1.6, 2.4), Vector3.new(-hw + 5, roofTop + 0.8, -hd + 3), col.Metal, Enum.Material.DiamondPlate)
		box(ctx, "ACUnit", Vector3.new(3, 1.6, 2.4), Vector3.new(-hw + 9, roofTop + 0.8, -hd + 3), col.Metal, Enum.Material.DiamondPlate)
		box(ctx, "Vent", Vector3.new(1.2, 1.4, 1.2), Vector3.new(hw - 3, roofTop + 0.7, 0), col.Dark, Enum.Material.Metal)
	end
	if c.Skylights and roofStyle == "Flat" then
		for i, sx in ipairs({ -hw * 0.45, 0, hw * 0.45 }) do
			local sky = box(ctx, "Skylight" .. i, Vector3.new(5, 0.5, 3.4), Vector3.new(sx, roofTop + 0.25, hd * 0.2), col.Glass, Enum.Material.Glass, false)
			sky.Transparency = 0.35
		end
	end

	-- Entrance (v73: one style per building)
	local awnY = y1 + doorH + 1.0
	if entrance == "Canopy" then
		box(ctx, "Canopy", Vector3.new(doorW + 4, 0.4, 4.6), Vector3.new(doorX, awnY, hd + 2.3), col.Metal, Enum.Material.DiamondPlate)
	elseif entrance == "HangarDoors" then
		-- two hangar door leaves rolled open to either side on a track beam across the facade (Vehicle Depot)
		local leafW: number = c.HangarLeafWidth or 8
		for _, sx in ipairs({ -1, 1 }) do
			box(ctx, "HangarLeaf", Vector3.new(leafW, doorH + 0.6, 0.5), Vector3.new(doorX + sx * (doorW * 0.5 + leafW * 0.5), y1 + (doorH + 0.6) * 0.5, hd + 0.45), col.Door or col.Metal, Enum.Material.Metal, false)
		end
		box(ctx, "HangarTrack", Vector3.new(W, 0.6, 0.7), Vector3.new(0, y1 + doorH + 0.4, hd + 0.5), col.Dark, Enum.Material.Metal, false)
	elseif entrance == "Portico" then
		-- two columns, an entablature and a pediment over the door (Command Center)
		local pw = doorW + 4.4
		for _, sx in ipairs({ -1, 1 }) do
			column(ctx, "PorticoColumn", 1.2, awnY - y1, doorX + sx * (pw * 0.5 - 0.9), y1, hd + 3.6, frameCol, Enum.Material.Concrete)
		end
		box(ctx, "PorticoBeam", Vector3.new(pw, 0.8, 4.6), Vector3.new(doorX, awnY + 0.4, hd + 2.3), col.Wall, wallMat)
		local rise, run = 2.2, pw * 0.5
		wedgeAt(ctx, "Pediment", Vector3.new(4.6, rise, run), CFrame.new(doorX - run * 0.5, awnY + 0.8 + rise * 0.5, hd + 2.3) * CFrame.Angles(0, math.pi * 0.5, 0), frameCol, Enum.Material.Metal)
		wedgeAt(ctx, "Pediment", Vector3.new(4.6, rise, run), CFrame.new(doorX + run * 0.5, awnY + 0.8 + rise * 0.5, hd + 2.3) * CFrame.Angles(0, -math.pi * 0.5, 0), frameCol, Enum.Material.Metal)
	elseif entrance == "LeanTo" then
		-- sloped hut porch roof on two posts (Barracks)
		wedgeAt(ctx, "PorchRoof", Vector3.new(doorW + 3, 1.2, 3.8), CFrame.new(doorX, awnY, hd + 1.9) * CFrame.Angles(0, math.pi, 0), roofCol, roofMat)
		for _, sx in ipairs({ -1, 1 }) do
			box(ctx, "AwningPost", Vector3.new(0.4, awnY - 0.6 - y1, 0.4), Vector3.new(doorX + sx * (doorW * 0.5 + 1.2), y1 + (awnY - 0.6 - y1) * 0.5, hd + 3.4), frameCol, Enum.Material.Wood)
		end
	elseif entrance == "CamoNet" then
		-- camouflage net on two poles, sagging away from the wall (Special Forces)
		local netW: number = c.NetWidth or (doorW + 10)
		local netX: number = c.NetX or doorX
		local net = part(ctx, "CamoNet", Vector3.new(netW, 0.15, 6.6), ctx.origin * CFrame.new(netX, awnY + 0.3, hd + 3.2) * CFrame.Angles(math.rad(9), 0, 0), col.Net or col.Trim, Enum.Material.Fabric, false)
		net.CanQuery = false
		for _, sx in ipairs({ -1, 1 }) do
			box(ctx, "AwningPost", Vector3.new(0.3, awnY - 0.3 - y1, 0.3), Vector3.new(netX + sx * (netW * 0.5 - 1), y1 + (awnY - 0.3 - y1) * 0.5, hd + 5.8), col.Metal, Enum.Material.Metal)
		end
	elseif entrance == "BlastDoor" then
		-- heavy door leaf rolled aside + hazard band; the door frame itself is the thick yellow portal (Armory)
		local leafX = doorX - doorW - 0.2
		box(ctx, "BlastLeaf", Vector3.new(doorW + 0.4, doorH + 0.4, 0.6), Vector3.new(leafX, y1 + (doorH + 0.4) * 0.5, hd + 0.4), col.Door or col.Metal, Enum.Material.DiamondPlate)
		box(ctx, "BlastLeafBand", Vector3.new(doorW + 0.45, 0.7, 0.64), Vector3.new(leafX, y1 + doorH * 0.55, hd + 0.4), col.Accent, Enum.Material.SmoothPlastic, false)
	elseif entrance == "Slab" then
		-- cantilevered flat canopy, no posts (Research Lab)
		box(ctx, "Awning", Vector3.new(doorW + 3, 0.35, 3.6), Vector3.new(doorX, awnY, hd + 1.8), frameCol, Enum.Material.Metal)
	else
		box(ctx, "Awning", Vector3.new(doorW + 3, 0.35, 3.6), Vector3.new(doorX, awnY, hd + 1.8), frameCol, Enum.Material.Metal)
		box(ctx, "AwningPost", Vector3.new(0.35, awnY - y1, 0.35), Vector3.new(doorX - doorW * 0.5 - 1.2, y1 + (awnY - y1) * 0.5, hd + 3.3), col.Metal, Enum.Material.Metal)
		box(ctx, "AwningPost", Vector3.new(0.35, awnY - y1, 0.35), Vector3.new(doorX + doorW * 0.5 + 1.2, y1 + (awnY - y1) * 0.5, hd + 3.3), col.Metal, Enum.Material.Metal)
	end
	if garage then
		for _, sx in ipairs({ -1, 1 }) do
			-- stands on the ground outside the foundation slab (was 0.4 in the air); top unchanged at y1 + 1.6
			box(ctx, "BollardHazard", Vector3.new(0.9, y1 + 1.6, 0.9), Vector3.new(doorX + sx * (doorW * 0.5 + 1.2), (y1 + 1.6) * 0.5, hd + 1.2), col.Accent, Enum.Material.SmoothPlastic)
		end
	end
	-- entry lamp fitting only (v70 light budget: no PointLight)
	-- v73: the fitting hangs under whatever covers the door (flush under the portico beam / porch roof); with no
	-- cover over it (camo net slopes up to the wall, blast door, hangar track) it is wall-mounted above the door
	local lampY, lampZ = awnY - 0.3, hd + 1.4
	if entrance == "Portico" then
		lampY = awnY - 0.1
	elseif entrance == "LeanTo" then
		lampY = awnY - 0.7
	elseif entrance == "CamoNet" or entrance == "BlastDoor" then
		lampZ = hd + 0.4
	elseif entrance == "HangarDoors" then
		lampY, lampZ = y1 + doorH + 0.4, hd + 1.25
	end
	box(ctx, "EntryLamp", Vector3.new(1.4, 0.2, 0.8), Vector3.new(doorX, lampY, lampZ), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
	local signW: number = c.SignWidth or math.min(W - 6, 16)
	local signY = math.min(awnY + 1.6, y1 + H1 - 1.2)
	local signX = c.SignX or 0
	-- only slide the sign sideways if it would hang down over the doorway
	if math.abs(signX - doorX) < (signW + doorW) * 0.5 and signY - 1 < y1 + doorH + 0.4 then
		signX = if doorX > 0 then doorX - doorW * 0.5 - signW * 0.5 - 1 else doorX + doorW * 0.5 + signW * 0.5 + 1
	end
	local sign = box(ctx, "Sign", Vector3.new(signW, 2.0, 0.3), Vector3.new(signX, signY, hd + 0.15), col.SignBoard or col.Dark, Enum.Material.Metal, false)
	-- NormalId.Back is the +Z face = the building front
	surfaceText(sign, Enum.NormalId.Back, { c.SignText or "COMMAND CENTER" }, col.Accent, col.SignBoard or col.Dark, Enum.Font.GothamBlack, SURFACE_FAR)
	if not garage and c.EntranceSandbags ~= false then
		sandbags(ctx, doorX + doorW * 0.5 + 1.6, doorX + doorW * 0.5 + 6.5, hd + 1.6, 0)
	end

	-- Flag
	if lv >= (c.FlagLevel or 1) then
		local flagX = -hw - 2.5
		-- always clear the roofline (two-storey from L3), taller again at L5
		local poleH = roofTop + parH + (if helipad then 9 else 4)
		box(ctx, "FlagPole", Vector3.new(0.4, poleH, 0.4), Vector3.new(flagX, poleH * 0.5, hd + 1), col.Metal, Enum.Material.Metal)
		-- v73: the cloth is 0.12 thick along X; its Left / Right faces are the nation-flag decal host (WE_FlagHost)
		local cloth = box(ctx, "Flag", Vector3.new(0.12, 3.6, 6), Vector3.new(flagX, poleH - 2.2, hd + 1 - 3.2), col.Flag, Enum.Material.Fabric, false)
		cloth:SetAttribute("WE_FlagHost", true)
		if goldCap then
			-- v70: painted gold ball (was Neon: spec §5, no neon that is not a light source)
			box(ctx, "FlagTip", Vector3.new(0.9, 0.9, 0.9), Vector3.new(flagX, poleH + 0.4, hd + 1), col.Gold, Enum.Material.SmoothPlastic, false).Shape = Enum.PartType.Ball
		end
	end

	-- v73 signature features (one or two per building; StructureVisualConfig.HollowBuildings.<Id>.Signatures)
	if sig.ControlCab and twoStory then
		-- rooftop control cab with a glass band: the HQ is the tallest block on the base (Command Center)
		local cx, cz, cw, cd, ch = -hw + 4.6, 2, 7, 10, 4.6
		box(ctx, "CabBody", Vector3.new(cw, ch, cd), Vector3.new(cx, roofTop + ch * 0.5, cz), col.Wall, wallMat)
		local band = box(ctx, "CabGlass", Vector3.new(cw + 0.12, 1.8, cd + 0.12), Vector3.new(cx, roofTop + ch - 1.5, cz), col.Glass, Enum.Material.Glass, false)
		band.Transparency = 0.15
		box(ctx, "CabRoof", Vector3.new(cw + 1.2, 0.5, cd + 1.2), Vector3.new(cx, roofTop + ch + 0.25, cz), frameCol, Enum.Material.Metal)
	end
	if sig.Berms then
		-- earth berms banked against both side walls (Armory)
		local bh: number = c.BermHeight or 5
		local br: number = c.BermRun or 5
		wedgeAt(ctx, "Berm", Vector3.new(D - 1, bh, br), CFrame.new(-hw - br * 0.5, y1 + bh * 0.5 - 0.4, 0) * CFrame.Angles(0, math.pi * 0.5, 0), col.Berm or col.Sandbag, Enum.Material.Ground)
		wedgeAt(ctx, "Berm", Vector3.new(D - 1, bh, br), CFrame.new(hw + br * 0.5, y1 + bh * 0.5 - 0.4, 0) * CFrame.Angles(0, -math.pi * 0.5, 0), col.Berm or col.Sandbag, Enum.Material.Ground)
	end
	if sig.Bastions then
		-- sloped concrete buttresses at the front corners (Armory)
		for _, sx in ipairs({ -1, 1 }) do
			wedgeAt(ctx, "Buttress", Vector3.new(2.6, H1 - 1.5, 3), CFrame.new(sx * (hw - 1.3), y1 + (H1 - 1.5) * 0.5, hd + 1.5) * CFrame.Angles(0, math.pi, 0), col.Wall, wallMat)
		end
	end
	if sig.Slits then
		-- dark firing slits painted on the blind facade (no wall cut: 1 part each)
		for _, sx in ipairs(c.SlitX or { -11, -5 }) do
			box(ctx, "Slit", Vector3.new(3, 0.6, 0.12), Vector3.new(sx, y1 + 5.6, hd + 0.06), col.Dark, Enum.Material.SmoothPlastic, false)
		end
	end
	if sig.VentStacks then
		for _, p in ipairs({ Vector2.new(-hw + 6, -hd + 5), Vector2.new(hw - 8, -hd + 5) }) do
			column(ctx, "VentStack", 1.4, 2.2, p.X, roofTop, p.Y, col.Metal, Enum.Material.Metal)
		end
	end
	if sig.LatticeMast then
		-- tall lattice comms mast beside the building + dish (Special Forces). Not climbable: CanCollide off.
		local mh: number = c.MastHeight or 40
		local mx, mz = hw + 2.4, -hd + 2.4
		local mast = Instance.new("TrussPart")
		mast.Name = "CommsMast"
		mast.Anchored = true
		mast.Size = Vector3.new(2, mh, 2)
		mast.CFrame = ctx.origin * CFrame.new(mx, mh * 0.5, mz)
		mast.Color = col.Metal
		mast.Material = Enum.Material.Metal
		mast.CanCollide = false
		mast.CanQuery = false
		mast.CanTouch = false
		mast.Parent = ctx.model
		box(ctx, "MastArm", Vector3.new(0.3, 0.3, 6), Vector3.new(mx, mh - 2, mz), col.Metal, Enum.Material.Metal, false)
		local dish = part(ctx, "Dish", Vector3.new(0.4, 4.2, 4.2), ctx.origin * CFrame.new(mx, mh - 6, mz + 1.4) * CFrame.Angles(0, math.rad(-70), math.rad(20)), Color3.fromRGB(210, 212, 206), Enum.Material.SmoothPlastic, false)
		dish.Shape = Enum.PartType.Cylinder
	end
	if sig.SolarDish then
		-- solar panels tilted toward the avenue + a small dish on the flat roof (Research Lab). Not a radome: the Radar
		-- installation owns the dome silhouette. Panels and dish sit on the roof slab, clear of the parapet; no collision.
		local a = math.rad(22)
		for _, e in ipairs(c.SolarPanels or { { X = -8.5, Z = -3 }, { X = -0.5, Z = -3 } }) do
			local panel = part(ctx, "SolarPanel", Vector3.new(7, 0.3, 3.4), ctx.origin * CFrame.new(e.X, roofTop + 0.15 * math.cos(a) + 1.7 * math.sin(a), e.Z) * CFrame.Angles(a, 0, 0), col.Solar or col.Glass, Enum.Material.SmoothPlastic, false)
			panel.Reflectance = 0.12
		end
		local d = c.DishAt or { X = hw - 6, Z = -hd + 5 }
		box(ctx, "DishMount", Vector3.new(0.6, 2.2, 0.6), Vector3.new(d.X, roofTop + 1.1, d.Z), col.Metal, Enum.Material.Metal, false)
		local dish = part(ctx, "Dish", Vector3.new(0.4, 4.2, 4.2), ctx.origin * CFrame.new(d.X, roofTop + 3, d.Z) * CFrame.Angles(0, math.rad(-120), math.rad(35)), Color3.fromRGB(220, 222, 218), Enum.Material.SmoothPlastic, false)
		dish.Shape = Enum.PartType.Cylinder
	end
	if sig.FacadeBand and not twoStory then
		box(ctx, "FacadeBand", Vector3.new(W + 0.2, 1.2, 0.2), Vector3.new(0, roofBottom - 0.6, hd + 0.1), frameCol, Enum.Material.SmoothPlastic, false)
	end
	if sig.LoadingDock then
		-- raised loading dock left of the roller door (Warehouse)
		local dx0, dx1 = -hw + 0.8, doorX - doorW * 0.5 - 2.2
		box(ctx, "LoadingDock", Vector3.new(dx1 - dx0, 1.6, 4), Vector3.new((dx0 + dx1) * 0.5, 0.8, hd + 2), col.Floor, Enum.Material.Concrete)
		box(ctx, "DockBumper", Vector3.new(dx1 - dx0, 0.5, 0.3), Vector3.new((dx0 + dx1) * 0.5, 1.1, hd + 4.15), col.Dark, Enum.Material.Rubber, false)
	end
	if sig.Chimney then
		local ch = roofTop + parH + 4
		column(ctx, "Chimney", 2.2, ch, -hw + 3, 0, -hd - 1.3, col.Wall, wallMat)
	end
	if sig.StoveChimney then
		-- brick stove chimney through the back roof slope, near one gable end (Barracks)
		local ch = parH + 1.6
		box(ctx, "Chimney", Vector3.new(1.4, ch, 1.4), Vector3.new(hw - 4, roofTop + ch * 0.5, -hd * 0.3), col.Chimney or col.Dark, Enum.Material.Brick)
	end

	-- Ceiling lights: fittings in two rows (ground) / one row (upper), spaced ~9 studs. v70 light budget: only the
	-- fitting nearest each floor's centre carries a PointLight (one light per floor; the rest are unlit fittings).
	local lampCount = math.max(2, math.floor(W / 9))
	local litIndex = math.ceil(lampCount / 2)
	for i = 1, lampCount do
		local lx = -hw + W * (i - 0.5) / lampCount
		for row, lz in ipairs({ -hd * 0.4, hd * 0.35 }) do
			local lamp = box(ctx, "CeilingLight", Vector3.new(4, 0.2, 1.2), Vector3.new(lx, y1 + H1 - 0.15, lz), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
			if i == litIndex and row == 1 then
				light(lamp, 20, 1.0, col.Light)
			end
		end
	end
	if twoStory then
		for i = 1, lampCount do
			local lx = -hw + W * (i - 0.5) / lampCount
			local lamp = box(ctx, "CeilingLight", Vector3.new(4, 0.2, 1.2), Vector3.new(lx, y2 + H2 - 0.15, hd * 0.3), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
			if i == litIndex then
				light(lamp, 18, 1.0, col.Light)
			end
		end
	end

	-- Annex (comms room) + mast + floodlights
	if hasAnnex then
		local ax0 = hw
		local ax1 = hw + annexW
		local az0 = -hd
		local az1 = -hd + annexD
		local axc = (ax0 + ax1) * 0.5
		box(ctx, "AnnexFloor", Vector3.new(annexW, 0.8, annexD), Vector3.new(axc, 0, annexZc), col.Floor, Enum.Material.Concrete)
		local aBack = ctx.origin * CFrame.new(axc, 0, az0 + t * 0.5) * CFrame.Angles(0, math.pi, 0)
		local aFront = ctx.origin * CFrame.new(axc, 0, az1 - t * 0.5)
		local aEast = ctx.origin * CFrame.new(ax1 - t * 0.5, 0, annexZc) * CFrame.Angles(0, math.pi * 0.5, 0)
		wall(ctx, "AnnexBack", aBack, annexW, annexH, y1, {})
		wall(ctx, "AnnexFront", aFront, annexW, annexH, y1, { { Center = 0, Width = 4, Bottom = 3.4, Height = 2.8, Glass = true } })
		wall(ctx, "AnnexEast", aEast, annexD - 2 * t, annexH, y1, {})
		box(ctx, "AnnexRoof", Vector3.new(annexW + 0.4, 0.8, annexD + 0.4), Vector3.new(axc, y1 + annexH + 0.4, annexZc), col.Roof, Enum.Material.Concrete)
		box(ctx, "Generator", Vector3.new(4, 3, 2.4), Vector3.new(axc + 1.5, y1 + 1.5, az0 + t + 1.5), col.Locker, Enum.Material.DiamondPlate)
		box(ctx, "GeneratorStripe", Vector3.new(4.05, 0.5, 2.45), Vector3.new(axc + 1.5, y1 + 2.4, az0 + t + 1.5), col.Accent, Enum.Material.SmoothPlastic, false)
		box(ctx, "RadioRack", Vector3.new(1.4, 5, 2), Vector3.new(ax1 - t - 0.8, y1 + 2.5, annexZc + 2), col.Dark, Enum.Material.Metal)
		local aLamp = box(ctx, "CeilingLight", Vector3.new(3, 0.2, 1), Vector3.new(axc, y1 + annexH - 0.15, annexZc), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
		light(aLamp, 16, 1.1, col.Light)
		local signA = box(ctx, "AnnexSign", Vector3.new(5, 1.2, 0.25), Vector3.new(axc, y1 + annexH - 1.2, az1 + 0.15), col.Dark, Enum.Material.Metal, false)
		surfaceText(signA, Enum.NormalId.Back, { c.AnnexSignText or "COMMS" }, col.Accent, col.Dark, Enum.Font.GothamBlack, SURFACE_FAR)

		local mx, mz = -hw + 2, -hd + 2
		box(ctx, "MastBase", Vector3.new(1.6, 1, 1.6), Vector3.new(mx, roofTop + 0.5, mz), col.Metal, Enum.Material.Metal)
		box(ctx, "Mast", Vector3.new(0.4, 14, 0.4), Vector3.new(mx, roofTop + 8, mz), col.Metal, Enum.Material.Metal, false)
		for i = 1, 3 do
			box(ctx, "MastBar", Vector3.new(2.4 - i * 0.5, 0.15, 0.15), Vector3.new(mx, roofTop + 3 + i * 3.2, mz), col.Metal, Enum.Material.Metal, false)
		end
		-- v70 (HUD spec §5): no red beacon ball / light on the mast top

		for _, fx in ipairs({ -hw + 1, hw - 1 }) do
			box(ctx, "Floodlight", Vector3.new(1.2, 0.8, 0.8), Vector3.new(fx, roofTop + parH + 0.8, hd - 0.2), col.Metal, Enum.Material.Metal, false)
			local lens = box(ctx, "FloodLens", Vector3.new(1.0, 0.6, 0.1), Vector3.new(fx, roofTop + parH + 0.8, hd + 0.25), LIGHTS.FixtureColor or col.Light, FIXTURE_MATERIAL, false)
			local spot = Instance.new("SpotLight")
			spot.Face = Enum.NormalId.Back
			spot.Angle = 70
			spot.Range = math.min(30, LIGHTS.SpotMaxRange or 30)
			spot.Brightness = 1.5 * (LIGHTS.BrightnessScale or 1)
			spot.Color = col.Light
			spot.Shadows = false
			spot.Parent = lens
		end
	end

	-- Roof access: climbable truss through a hatch + dish
	if roofAccess then
		local climb = (roofTop - y2) + 2
		local trussH = math.ceil(climb / 2) * 2
		local truss = Instance.new("TrussPart")
		truss.Name = "RoofLadder"
		truss.Anchored = true
		truss.Size = Vector3.new(2, trussH, 2)
		truss.CFrame = ctx.origin * CFrame.new(trussX, y2 + trussH * 0.5, trussZ)
		truss.Color = col.Metal
		truss.Material = Enum.Material.Metal
		truss.CanTouch = false
		truss.Parent = ctx.model
		railing(ctx, Vector3.new(trussX - 1.8, roofTop, trussZ - 1.8), Vector3.new(trussX + 1.8, roofTop, trussZ - 1.8), 3)
		railing(ctx, Vector3.new(trussX - 1.8, roofTop, trussZ - 1.8), Vector3.new(trussX - 1.8, roofTop, trussZ + 1.2), 3)
		local dx, dz = hw - 6, -hd + 4.5
		box(ctx, "DishMount", Vector3.new(0.6, 2.4, 0.6), Vector3.new(dx, roofTop + 1.2, dz), col.Metal, Enum.Material.Metal)
		local dish = part(ctx, "Dish", Vector3.new(0.4, 5, 5), ctx.origin * CFrame.new(dx, roofTop + 3.2, dz) * CFrame.Angles(0, math.rad(-120), math.rad(35)), Color3.fromRGB(220, 222, 218), Enum.Material.SmoothPlastic)
		dish.Shape = Enum.PartType.Cylinder
	end

	-- Rooftop helipad marking
	if helipad then
		local hx, hz = 2, 1.5
		local ring = part(ctx, "HelipadRing", Vector3.new(0.06, 12, 12), ctx.origin * CFrame.new(hx, roofTop + 0.03, hz) * CFrame.Angles(0, 0, math.pi * 0.5), col.Gold, Enum.Material.SmoothPlastic, false)
		ring.Shape = Enum.PartType.Cylinder
		local inner = part(ctx, "HelipadInner", Vector3.new(0.06, 10.6, 10.6), ctx.origin * CFrame.new(hx, roofTop + 0.05, hz) * CFrame.Angles(0, 0, math.pi * 0.5), col.Dark, Enum.Material.SmoothPlastic, false)
		inner.Shape = Enum.PartType.Cylinder
		box(ctx, "HelipadH", Vector3.new(0.8, 0.06, 5), Vector3.new(hx - 1.6, roofTop + 0.08, hz), col.Gold, Enum.Material.SmoothPlastic, false)
		box(ctx, "HelipadH", Vector3.new(0.8, 0.06, 5), Vector3.new(hx + 1.6, roofTop + 0.08, hz), col.Gold, Enum.Material.SmoothPlastic, false)
		box(ctx, "HelipadH", Vector3.new(2.4, 0.06, 0.8), Vector3.new(hx, roofTop + 0.08, hz), col.Gold, Enum.Material.SmoothPlastic, false)
	end

	-- Interior furnishing (per building type)
	local keepOut: { Rect } = {
		-- doorway approach
		{ X0 = doorX - doorW * 0.5 - 1, X1 = doorX + doorW * 0.5 + 1, Z0 = hd - t - 6, Z1 = hd - t },
	}
	local con = consoleLocal(ctx.structureId)
	if con then
		table.insert(keepOut, { X0 = con.X - 2.2, X1 = con.X + 2.2, Z0 = con.Z - 2.2, Z1 = con.Z + 2.2 })
	end
	if twoStory then
		table.insert(keepOut, { X0 = stairX0 - 0.5, X1 = stairX1 + 0.5, Z0 = stairZ0, Z1 = stairZ1 + 1 })
	end
	if hasAnnex then
		table.insert(keepOut, { X0 = hw - t - 2, X1 = hw - t, Z0 = annexZc - 3, Z1 = annexZc + 3 })
	end
	local ictx = {
		StructureId = ctx.structureId,
		Level = lv,
		W = W,
		D = D,
		T = t,
		HalfW = hw,
		HalfD = hd,
		H1 = H1,
		H2 = H2,
		Y1 = y1,
		Y2 = y2,
		TwoStory = twoStory,
		DoorX = doorX,
		DoorWidth = doorW,
		DoorHeight = doorH,
		Garage = garage,
		Console = con,
		KeepOut = keepOut,
		-- inner faces of the ground-floor walls
		InX0 = -hw + t,
		InX1 = hw - t,
		InZ0 = -hd + t,
		InZ1 = hd - t,
		Colors = col,
	}
	local api = makeApi(ctx, "WE_Interior")
	local interiors = script.Parent:FindFirstChild("Interiors")
	local modScript = interiors and interiors:FindFirstChild(c.Interior or ctx.structureId)
	if modScript and modScript:IsA("ModuleScript") then
		local ok, fn = pcall(require, modScript)
		if ok and typeof(fn) == "function" then
			local okRun, errRun = pcall(fn, ictx, api)
			if not okRun then
				warn("[HollowBuilding] interior failed", ctx.structureId, errRun)
			end
		else
			warn("[HollowBuilding] interior module did not load", ctx.structureId, fn)
		end
	end
end

-- Kiosk position in the installation's local frame (keep-out for the module), if the layout has one.
local function kioskLocal(structureId: string): Vector3?
	local s = (BaseLayoutConfig.Structures :: any)[structureId]
	if not (s and s.Kiosk and s.Site) then
		return nil
	end
	local dx, dz = s.Kiosk.X - s.Site.X, s.Kiosk.Z - s.Site.Z
	local a = math.rad(-(s.Yaw or 0))
	return Vector3.new(dx * math.cos(a) + dz * math.sin(a), 0, -dx * math.sin(a) + dz * math.cos(a))
end

local function buildInstallation(ctx: Ctx)
	local c = ctx.c
	local ictx = {
		StructureId = ctx.structureId,
		Level = ctx.level,
		W = c.Width,
		D = c.Depth,
		HalfW = c.Width * 0.5,
		HalfD = c.Depth * 0.5,
		Y0 = 0.4, -- foundation top (the kit Body slab)
		Colors = ctx.col,
		Kiosk = kioskLocal(ctx.structureId),
	}
	local api = makeApi(ctx, "WE_Installation")
	local folder = script.Parent:FindFirstChild("Installations")
	local modScript = folder and folder:FindFirstChild(c.Module or ctx.structureId)
	if not (modScript and modScript:IsA("ModuleScript")) then
		warn("[HollowBuilding] installation module missing", ctx.structureId)
		return
	end
	local ok, fn = pcall(require, modScript)
	if ok and typeof(fn) == "function" then
		local okRun, errRun = pcall(fn, ictx, api)
		if not okRun then
			warn("[HollowBuilding] installation failed", ctx.structureId, errRun)
		end
	else
		warn("[HollowBuilding] installation module did not load", ctx.structureId, fn)
	end
end

local function findModel(plinth: BasePart): Model?
	local m = plinth:FindFirstChild(MODEL_NAME)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

--[[ Build / rebuild / remove the walk-in building (or outdoor installation) for this plinth at `level`. Idempotent. ]]
function HollowBuildingBuilder.Sync(plinth: BasePart, structureId: string, level: number)
	local c = cfgFor(structureId)
	local inst = if c then nil else instCfgFor(structureId)
	local existing = findModel(plinth)
	local lv = math.clamp(math.floor(tonumber(level) or 0), 0, 5)
	if (not c and not inst) or lv < 1 then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing and existing:GetAttribute("WE_BuildingLevel") == lv and existing:GetAttribute("WE_BuildingGen") == GEN then
		return
	end
	if existing then
		existing:Destroy()
	end
	local model = Instance.new("Model")
	-- streaming2 S4 (F11): a building (21-273 parts, consoles, prompts, GUIs) reaches a client whole or not at all.
	-- Set first; the model is built unparented and parented last, so every part is an initial descendant. A level
	-- change rebuilds the whole model, so the initial-only atomicity rule always covers it. No effect with streaming off.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = MODEL_NAME
	model:SetAttribute("WE_BuildingLevel", lv)
	model:SetAttribute("WE_BuildingGen", GEN)
	model:SetAttribute("StructureId", structureId)
	local cfg = c or inst
	local ctx: Ctx = {
		model = model,
		origin = originFor(plinth, cfg),
		c = cfg,
		col = cfg.Colors,
		level = lv,
		structureId = structureId,
	}
	local ok, err = pcall(if inst then buildInstallation else build, ctx)
	if not ok then
		warn("[HollowBuilding] build failed", structureId, lv, err)
	end
	model.Parent = plinth
end

--[[ Remove every walk-in building under a plot folder (plot released). ]]
function HollowBuildingBuilder.ClearUnder(root: Instance)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("Model") and d.Name == MODEL_NAME then
			d:Destroy()
		end
	end
end

return HollowBuildingBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">Hostility</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 51 (2026-10-01, P0 "the Central Plaza guards don't shoot my girlfriend / she can't damage them"):
	THE one shared hostility / protection rule. CombatService binds the existing reasons into it (the F6 novice shield,
	the spawn shield, pvpBlock, UnitMayHitPlayer) and exposes it as CombatService.ProtectedReason / NpcMayTarget /
	MayHurt; CombatNPC calls NpcMayTarget in EVERY NPC target pick; CheckpointGuardService.Protected calls
	ProtectedReason. No second copy of any reason lives here: every answer comes from a bound function.
	Gate: CombatConfig.SharedHostility (RetentionConfig.Live, by the CANDIDATE player); OFF == the old pick exactly.
]]

local Hostility = {}

export type Deps = {
	IsNoviceShielded: (Player) -> boolean,
	IsSpawnInvulnerable: (Player) -> boolean,
	PvPBlock: (Player, Player) -> string?,
	UnitMayHitPlayer: (Player, Player) -> (boolean, string?),
	Live: (Player) -> boolean, -- SharedHostility live for this player
}

local deps: Deps? = nil

function Hostility.Bind(d: Deps)
	deps = d
end

-- why nobody may hurt this player right now ("novice" | "spawn"), or nil
function Hostility.ProtectedReason(player: Player): string?
	local d = deps
	if d == nil then
		return nil
	end
	if d.IsNoviceShielded(player) then
		return "novice"
	end
	if d.IsSpawnInvulnerable(player) then
		return "spawn"
	end
	return nil
end

-- may a CombatService NPC (any group) TARGET this player? Live: never a protected one (so the NPC picks the nearest
-- player it may actually hurt, instead of firing guaranteed misses at a shielded one). OFF: true (the old pick).
function Hostility.NpcMayTarget(player: Player): (boolean, string?)
	local d = deps
	if d == nil or not d.Live(player) then
		return true, nil
	end
	local why = Hostility.ProtectedReason(player)
	return why == nil, why
end

--[[ May `attacker` hurt the player `victim`? One answer for every shooter kind:
	"Player" (guns) / "Vehicle" (a player's vehicle weapon) -> PvPBlock; "Unit" / "Turret" / "BaseGuard" (owned by
	`attacker`) -> UnitMayHitPlayer; "NPC" (attacker = the NPC record or nil) -> NpcMayTarget. ]]
function Hostility.MayHurt(attacker: any, victim: Player, kind: string): (boolean, string?)
	local d = deps
	if d == nil then
		return true, nil
	end
	if kind == "NPC" then
		return Hostility.NpcMayTarget(victim)
	elseif kind == "Unit" or kind == "Turret" or kind == "BaseGuard" then
		return d.UnitMayHitPlayer(attacker, victim)
	end
	local why = d.PvPBlock(attacker, victim)
	return why == nil, why
end

return Hostility
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="161">
          <Properties>
            <string name="Name">Installations</string>
          </Properties>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">Airfield</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Airfield installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 58 x 34 behind the
	runway (BaseLayoutConfig Roads: Runway + HangarApron); +Z faces the runway. The runway itself is layout
	ground, so this is the hangar side of the airfield.
	L1 walk-in hangar (open sliding doors) with one jet + hangar terminal (Garage), windsock
	L2 control tower   L3 fuel truck, tool carts   L4 second jet   L5 floodlights, gold header trim
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local hullGrey = Color3.fromRGB(128, 134, 138)
	local wallCol = Color3.fromRGB(150, 150, 140)
	local roofCol = Color3.fromRGB(92, 96, 90)
	-- v90: the hangar grows with the foundation (StructureVisualConfig Width 58 = the original size, S = 1)
	local S = math.clamp((tonumber(ictx.W) or 58) / 58, 1, 1.3)
	local halfW = (tonumber(ictx.HalfW) or 29)
	local halfD = (tonumber(ictx.HalfD) or 17)

	-- Hangar shell: 40 wide x 28 deep, 15 to the eaves, gable roof ridge front-to-back
	local hx, hW, hD, H, t = -2, 40 * S, 28 * S, 15 * S, 0.8
	local hw, hd = hW * 0.5, hD * 0.5
	local doorW, doorH = 32 * S, 13 * S
	api.box("HangarBack", Vector3.new(hW, H, t), Vector3.new(hx, y0 + H * 0.5, -hd + t * 0.5), wallCol, Enum.Material.CorrodedMetal)
	for _, side in ipairs({ -1, 1 }) do
		api.box("HangarSide", Vector3.new(t, H, hD), Vector3.new(hx + side * (hw - t * 0.5), y0 + H * 0.5, 0), wallCol, Enum.Material.CorrodedMetal)
		local pier = (hW - doorW) * 0.5
		api.box("HangarPier", Vector3.new(pier, doorH, t), Vector3.new(hx + side * (hw - pier * 0.5), y0 + doorH * 0.5, hd - t * 0.5), wallCol, Enum.Material.CorrodedMetal)
		-- sliding door leaves parked open outside the piers
		api.box("HangarDoorLeaf", Vector3.new(doorW * 0.25, doorH - 0.2, 0.4), Vector3.new(hx + side * (hw + doorW * 0.125 - 0.2), y0 + (doorH - 0.2) * 0.5, hd + 0.3), col.Metal, Enum.Material.DiamondPlate)
		api.box("DoorLeafStripe", Vector3.new(doorW * 0.25, 0.5, 0.42), Vector3.new(hx + side * (hw + doorW * 0.125 - 0.2), y0 + 1.2, hd + 0.3), col.Accent, Enum.Material.SmoothPlastic, false)
	end
	api.box("HangarHeader", Vector3.new(hW, H - doorH, t), Vector3.new(hx, y0 + doorH + (H - doorH) * 0.5, hd - t * 0.5), wallCol, Enum.Material.CorrodedMetal)
	local sign = api.box("HangarSign", Vector3.new(12, 1.4, 0.2), Vector3.new(hx, y0 + doorH + 1, hd + 0.12), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "HANGAR 01" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	-- Gable roof: two panels meeting at a ridge over the centre line, stepped gable infill front + back
	local pitch = math.rad(12)
	local rise = hw * math.tan(pitch)
	for _, side in ipairs({ -1, 1 }) do
		api.part("HangarRoof", Vector3.new(hw / math.cos(pitch) + 0.8, 0.6, hD + 1.2), CFrame.new(hx + side * hw * 0.5, y0 + H + rise * 0.5 + 0.3, 0) * CFrame.Angles(0, 0, -side * pitch), roofCol, Enum.Material.Metal)
	end
	for _, gz in ipairs({ hd - t * 0.5, -hd + t * 0.5 }) do
		for k = 1, 3 do
			local w = hW * (1 - k / 3.4)
			api.box("GableInfill", Vector3.new(w, rise / 3, t), Vector3.new(hx, y0 + H + (k - 0.5) * rise / 3, gz), wallCol, Enum.Material.CorrodedMetal)
		end
	end
	-- Hangar lights
	for i = -1, 1 do
		local lamp = api.box("HangarLight", Vector3.new(6, 0.25, 1), Vector3.new(hx + i * 12, y0 + H - 0.4, 0), col.Light, Enum.Material.SmoothPlastic, false)
		api.light(lamp, 26, 1.1, col.Light)
	end
	api.box("TaxiLine", Vector3.new(0.5, 0.05, hD - 2), Vector3.new(hx, y0 + 0.03, 0.5), col.Accent, Enum.Material.SmoothPlastic, false)

	-- Generic jet mock-up (no real-world type or markings), nose toward the doors (+Z)
	local function jet(cx: number, cz: number)
		local f = CFrame.new(cx, y0 + 2.4, cz)
		api.part("JetFuselage", Vector3.new(15, 2.2, 2.2), f * CFrame.Angles(0, math.rad(90), 0), hullGrey, Enum.Material.Metal).Shape = Enum.PartType.Cylinder
		local nose = api.part("JetNose", Vector3.new(2.2, 2.2, 2.2), f * CFrame.new(0, 0, 7.5), hullGrey, Enum.Material.Metal)
		nose.Shape = Enum.PartType.Ball
		local canopy = api.part("JetCanopy", Vector3.new(1.6, 1.4, 3.4), f * CFrame.new(0, 1.1, 4.6), Color3.fromRGB(40, 60, 80), Enum.Material.Glass, false)
		canopy.Transparency = 0.2
		api.part("JetWing", Vector3.new(12, 0.3, 4.4), f * CFrame.new(0, -0.3, -0.5), hullGrey, Enum.Material.Metal)
		api.part("JetTailplane", Vector3.new(5.2, 0.25, 2), f * CFrame.new(0, 0, -6.3), hullGrey, Enum.Material.Metal, false)
		api.part("JetFin", Vector3.new(0.3, 3.2, 2.6), f * CFrame.new(0, 2.4, -6), hullGrey, Enum.Material.Metal, false)
		api.part("JetExhaust", Vector3.new(0.8, 1.6, 1.6), f * CFrame.new(0, 0, -7.9) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal, false).Shape = Enum.PartType.Cylinder
		for _, g in ipairs({ { 0, 5 }, { -2.2, -1 }, { 2.2, -1 } }) do
			api.part("JetGear", Vector3.new(0.3, 1.3, 0.3), f * CFrame.new(g[1], -1.65, g[2]), col.Dark, Enum.Material.Metal, false)
		end
		api.part("JetRoundel", Vector3.new(1.6, 0.05, 1.6), f * CFrame.new(-4.2, -0.12, -0.5), col.Flag, Enum.Material.SmoothPlastic, false)
		api.part("JetRoundel", Vector3.new(1.6, 0.05, 1.6), f * CFrame.new(4.2, -0.12, -0.5), col.Flag, Enum.Material.SmoothPlastic, false)
	end
	if lv >= 4 then
		jet(hx - 9.5, 0)
		jet(hx + 9.5, -1.5)
	else
		jet(hx, 0)
	end

	-- Hangar terminal on the back wall (right of centre) → Garage (aircraft need the Airfield)
	api.terminal("HangarTerminal", Vector3.new(hx + 14, y0, -hd + t + 0.6), 0, "Garage", "Open hangar", "Hangar · Aircraft", { "HANGAR", "AIRCRAFT" })

	-- Windsock
	api.box("WindsockPole", Vector3.new(0.35, 8, 0.35), Vector3.new(-(halfW - 2), y0 + 4, -(halfD - 2)), col.Metal, Enum.Material.Metal, false)
	api.part("Windsock", Vector3.new(0.9, 0.9, 3), CFrame.new(-(halfW - 2), y0 + 7.6, -(halfD - 3.6)) * CFrame.Angles(math.rad(8), 0, 0), Color3.fromRGB(230, 120, 40), Enum.Material.Fabric, false)

	-- Control tower (L2+) at the runway corner
	if lv >= 2 then
		local tx, tz, th = halfW - 5.5, 9, 18
		api.box("TowerShaft", Vector3.new(4, th, 4), Vector3.new(tx, y0 + th * 0.5, tz), wallCol, Enum.Material.Concrete)
		api.box("TowerDeck", Vector3.new(7, 0.5, 7), Vector3.new(tx, y0 + th + 0.25, tz), col.Metal, Enum.Material.Metal)
		local cab = api.box("TowerCab", Vector3.new(6.2, 3.4, 6.2), Vector3.new(tx, y0 + th + 2.2, tz), col.Glass, Enum.Material.Glass)
		cab.Transparency = 0.35
		api.box("TowerCabRoof", Vector3.new(7.2, 0.5, 7.2), Vector3.new(tx, y0 + th + 4.15, tz), col.Trim, Enum.Material.Metal)
		api.box("TowerMast", Vector3.new(0.3, 4, 0.3), Vector3.new(tx + 2.5, y0 + th + 6.4, tz - 2.5), col.Metal, Enum.Material.Metal, false)
		local beacon = api.ball("TowerBeacon", 0.7, Vector3.new(tx + 2.5, y0 + th + 8.6, tz - 2.5), Color3.fromRGB(255, 50, 40), Enum.Material.SmoothPlastic, false)
		api.light(beacon, 10, 1.5, Color3.fromRGB(255, 60, 40))
		api.box("TowerDoor", Vector3.new(1.8, 3, 0.15), Vector3.new(tx, y0 + 1.5, tz + 2.08), col.Metal, Enum.Material.Metal, false)
	end

	-- Fuel truck + tool carts (L3+)
	if lv >= 3 then
		local fx, fz = halfW - 5.5, -7
		api.box("FuelTruckCab", Vector3.new(2.6, 2.6, 2.8), Vector3.new(fx, y0 + 1.9, fz + 4.4), col.Locker, Enum.Material.Metal)
		api.part("FuelTruckTank", Vector3.new(6.4, 2.6, 2.6), CFrame.new(fx, y0 + 2.2, fz) * CFrame.Angles(0, math.rad(90), 0), col.Locker, Enum.Material.Metal).Shape = Enum.PartType.Cylinder
		api.box("FuelTruckChassis", Vector3.new(2.4, 0.5, 9.4), Vector3.new(fx, y0 + 0.75, fz + 1.2), col.Dark, Enum.Material.Metal, false)
		for _, wz in ipairs({ fz + 4.6, fz - 0.6, fz - 2.6 }) do
			for _, side in ipairs({ -1, 1 }) do
				api.part("FuelTruckWheel", Vector3.new(0.5, 1.3, 1.3), CFrame.new(fx + side * 1.2, y0 + 0.65, wz), col.Dark, Enum.Material.Fabric, false).Shape = Enum.PartType.Cylinder
			end
		end
		for i = 0, 1 do
			local cx = hx - hw + 3 + i * 3
			api.box("ToolCart", Vector3.new(2, 2.2, 1.2), Vector3.new(cx, y0 + 1.1, -hd + 2.2), Color3.fromRGB(150, 40, 36), Enum.Material.Metal)
		end
		for i = 0, 2 do
			api.part("FuelDrum", Vector3.new(1.5, 1.1, 1.1), CFrame.new(hx + hw - 2, y0 + 0.75, -hd + 2.2 + i * 1.3) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(110, 58, 40), Enum.Material.Metal).Shape = Enum.PartType.Cylinder
		end
	end

	-- L5: floodlights on the hangar corners + gold header trim
	if lv >= 5 then
		api.box("GoldTrim", Vector3.new(hW, 0.35, 0.35), Vector3.new(hx, y0 + H + 0.2, hd + 0.2), col.Gold, Enum.Material.Metal, false)
		for _, side in ipairs({ -1, 1 }) do
			local lens = api.box("FloodLamp", Vector3.new(1.6, 0.9, 0.5), Vector3.new(hx + side * (hw - 1.5), y0 + H - 0.6, hd + 0.5), col.Light, Enum.Material.SmoothPlastic, false)
			api.light(lens, 30, 1.4, col.Light)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">Checkpoint</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Gate checkpoint installation for DefensiveWalls (HollowBuildingBuilder, StructureVisualConfig.Installations).
	The perimeter walls themselves are still built by StructureKitBuilder.SyncPerimeterWalls — this is the visible
	"defences" post at the main gate.

	v73 (owner: "the checkpoint looks terrible at front of base"). Re-authored at player scale around the road:
	  site (-18, 146), local +X toward the main road (road edge local x = 11, centre 18), +Z toward the gate wall.
	  The foundation (kit Body, 6 x 6) is now the flag plinth: the base flag (nation flag later) is the first thing
	  a player sees at the gate. The guard booth stands at the road edge (7.4 tall, glass band at eye height), the
	  boom barrier sits on the spawn side of the booth with its arm raised over the road (never blocks a vehicle),
	  jersey barriers shield the booth from the gate, one angled floodlight lights the lane (SpotLight).
	L1 plinth + flag, booth, boom, 2 jersey barriers, floodlight   L2 2 more barriers   L3 tank traps by the wall
	L4 sandbagged gun nest at the flag   L5 second floodlight, gold booth edge + flag finial
	No razor-wire pipes, no tray: every prop off the plinth stands on the ground (y = 0).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local LIGHTS = (StructureVisualConfig :: any).BuildingLights or {}

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0 -- plinth top
	local concrete = Color3.fromRGB(176, 172, 160)
	local boothCol = Color3.fromRGB(206, 200, 182)
	local olive = Color3.fromRGB(74, 84, 60)
	local hazard = col.Accent
	local rust = Color3.fromRGB(104, 76, 56)

	-- Flag on the plinth (kit Body): the hero flag at the gate. The cloth (0.12 thick along X) is the nation-flag
	-- decal host (attribute WE_FlagHost; its Left / Right faces carry the decal).
	api.box("FlagPole", Vector3.new(0.4, 16, 0.4), Vector3.new(0, y0 + 8, 0), col.Metal, Enum.Material.Metal)
	local cloth = api.box("Flag", Vector3.new(0.12, 3.2, 5.4), Vector3.new(0, y0 + 14.2, 2.9), col.Flag, Enum.Material.Fabric, false)
	cloth:SetAttribute("WE_FlagHost", true)
	if lv >= 5 then
		api.ball("FlagTip", 0.9, Vector3.new(0, y0 + 16.4, 0), col.Gold, Enum.Material.SmoothPlastic, false)
	end

	-- Guard booth at the road edge (solid, not walk-in): concrete base, glass band at eye height, olive roof.
	-- x 7.2: the 7.4-wide roof ends at x 10.9, inside the main road's edge (local x 11 = world x -7)
	local bx, bz, bw = 7.2, -3.5, 6
	api.box("Booth", Vector3.new(bw, 3.6, bw), Vector3.new(bx, 1.8, bz), boothCol, Enum.Material.Concrete)
	local glass = api.box("BoothGlass", Vector3.new(bw - 0.2, 3.2, bw - 0.2), Vector3.new(bx, 5.2, bz), Color3.fromRGB(96, 124, 136), Enum.Material.Glass)
	glass.Transparency = 0.2
	for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		api.box("BoothPost", Vector3.new(0.35, 3.2, 0.35), Vector3.new(bx + o[1] * (bw * 0.5 - 0.05), 5.2, bz + o[2] * (bw * 0.5 - 0.05)), col.Dark, Enum.Material.Metal, false)
	end
	api.box("BoothRoof", Vector3.new(bw + 1.4, 0.6, bw + 1.4), Vector3.new(bx, 7.1, bz), olive, Enum.Material.Metal)
	if lv >= 5 then
		api.box("GoldTrim", Vector3.new(bw + 1.6, 0.18, bw + 1.6), Vector3.new(bx, 6.72, bz), col.Gold, Enum.Material.Metal, false)
	end
	api.box("BoothDoor", Vector3.new(0.12, 6.6, 2.4), Vector3.new(bx - bw * 0.5 - 0.06, 3.3, bz), col.Dark, Enum.Material.Metal, false)
	-- warm light inside the glass band: the booth reads as manned at night
	local boothLight = Instance.new("PointLight")
	boothLight.Range = math.min(10, LIGHTS.MaxRange or 10)
	boothLight.Brightness = 1.2 * (LIGHTS.BrightnessScale or 0.35)
	boothLight.Color = col.Light
	boothLight.Shadows = false
	boothLight.Parent = glass
	-- sign on the roof, facing into the compound (players heading for the gate read it)
	local sign = api.box("BoothSign", Vector3.new(5.4, 1.3, 0.25), Vector3.new(bx, 8.05, bz), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Front, { "CHECKPOINT" }, col.Accent, col.Dark, Enum.Font.GothamBlack)

	-- Boom barrier: cabinet at the road edge on the spawn side of the booth, arm across the road raised 80°
	-- (open: decorative, never blocks a vehicle; CanCollide off on the arm)
	local px, pz = 10.6, -7.6
	api.box("BoomPost", Vector3.new(0.9, 3.4, 0.9), Vector3.new(px, 1.7, pz), hazard, Enum.Material.SmoothPlastic)
	local pivot = Vector3.new(px, 3.4, pz)
	local a = math.rad(80)
	local dir = Vector3.new(math.cos(a), math.sin(a), 0)
	local armLen = 12.5
	local armCF = CFrame.lookAt(pivot, pivot + dir)
	api.part("BoomArm", Vector3.new(0.45, 0.45, armLen), armCF * CFrame.new(0, 0, -armLen * 0.5), Color3.fromRGB(236, 236, 228), Enum.Material.SmoothPlastic, false)
	for _, k in ipairs({ 0.35, 0.75 }) do
		api.part("BoomStripe", Vector3.new(0.5, 0.5, 1.6), armCF * CFrame.new(0, 0, -armLen * k), Color3.fromRGB(186, 44, 40), Enum.Material.SmoothPlastic, false)
	end

	-- Jersey barriers shielding the booth from the gate (L1: 2, L2+: 4), on the ground. 2 parts each (base + top).
	-- x <= 7.9: clear of the L4+ gate AutoGun nest (GateDefenseService, gate-local (-7, 0, -7.5) = here (11, 5) +- 2.75)
	local jx = { 6.2, 2.6, -1.0, -4.6 }
	for i = 1, (if lv >= 2 then 4 else 2) do
		local x = jx[i]
		api.box("JerseyBase", Vector3.new(3.4, 1.0, 1.5), Vector3.new(x, 0.5, 4.5), concrete, Enum.Material.Concrete)
		api.box("JerseyTop", Vector3.new(3.4, 1.8, 0.7), Vector3.new(x, 1.9, 4.5), concrete, Enum.Material.Concrete)
	end

	-- Floodlight: pole + angled housing + lens, aimed down at the lane (SpotLight, v70 light rules)
	local function flood(fx: number, fz: number)
		api.box("FloodPole", Vector3.new(0.4, 10, 0.4), Vector3.new(fx, 5, fz), col.Metal, Enum.Material.Metal, false)
		local head = CFrame.new(fx, 10.2, fz) * CFrame.Angles(0, 0, math.rad(-35))
		api.part("FloodHousing", Vector3.new(1.1, 1.0, 1.8), head, col.Dark, Enum.Material.Metal, false)
		local lens = api.part("FloodLens", Vector3.new(0.1, 0.8, 1.6), head * CFrame.new(0.6, 0, 0), LIGHTS.FixtureColor or col.Light, LIGHTS.FixtureMaterial or Enum.Material.SmoothPlastic, false)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Right
		spot.Angle = 70
		spot.Range = math.min(30, LIGHTS.SpotMaxRange or 30)
		spot.Brightness = 2 * (LIGHTS.BrightnessScale or 0.35)
		spot.Color = col.Light
		spot.Shadows = false
		spot.Parent = lens
	end
	flood(4.2, -7.4)
	if lv >= 5 then
		flood(-2.8, 6.6)
	end

	-- Czech hedgehog tank traps between the barriers and the wall (L3+): thick rusty beams
	if lv >= 3 then
		for _, tx in ipairs({ 2.4, -3.6 }) do
			local c = CFrame.new(tx, 1.75, 7.2) -- beam ends on the ground; clear of the perimeter wall (6.3 thick at L5)
			api.part("TankTrap", Vector3.new(0.7, 0.7, 4.2), c * CFrame.Angles(math.rad(45), 0, 0), rust, Enum.Material.CorrodedMetal)
			api.part("TankTrap", Vector3.new(0.7, 0.7, 4.2), c * CFrame.Angles(0, 0, math.rad(45)) * CFrame.Angles(0, math.rad(90), 0), rust, Enum.Material.CorrodedMetal)
			api.part("TankTrap", Vector3.new(0.7, 0.7, 4.2), c * CFrame.Angles(0, math.rad(45), math.rad(-45)), rust, Enum.Material.CorrodedMetal)
		end
	end

	-- Sandbagged gun nest at the flag, facing the gate (L4+)
	if lv >= 4 then
		api.sandbags(-2.6, 2.6, 2.2, y0)
		api.box("NestTripod", Vector3.new(0.4, 1.4, 0.4), Vector3.new(1.3, y0 + 0.7, 1.0), col.Metal, Enum.Material.Metal, false)
		api.box("NestGun", Vector3.new(0.5, 0.5, 1.6), Vector3.new(1.3, y0 + 1.6, 1.3), col.Dark, Enum.Material.Metal, false)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">Helipad</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Helipad installation (HollowBuildingBuilder, StructureVisualConfig.Installations.Helipad; structure Helipad).
	v73 (owner: "the default helicopter on the pad is horrific"). The kit Body is the 28 x 28 pad (foundation slab,
	asphalt colour). No parked mock-up: the player's own helicopter spawns on VehicleConfig HelipadSpots (-4, 6) /
	(8, 8) once one is unlocked, so nothing here stands on those spots.
	  L1 landing circle + H (flush paint, no collision), 4 perimeter light fittings, windsock, ops hut beside the pad
	  L2 lit floodlight      L3 fuel tank      L4 second floodlight (unlit: light budget)      L5 gold circle + hut beacon
	The markings are stacked 0.06 apart (ring top y0 + 0.10, inner disc y0 + 0.16, H y0 + 0.22) so no two top faces
	are coplanar (no flicker), and none of them collides or is queryable (vehicle spawn rays land on the slab).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local LIGHTS = (StructureVisualConfig :: any).BuildingLights or {}

-- Solid booth: body, glass band, door on the hut's local +X face, roof. 4 parts. Returns (body, roof).
local function hut(api: any, name: string, pos: Vector3, size: Vector3, yawDeg: number, style: any): (BasePart, BasePart)
	local f = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local w, h, d = size.X, size.Y, size.Z
	local body = api.part(name, Vector3.new(w, h, d), f * CFrame.new(0, h * 0.5, 0), style.Wall, style.Material or Enum.Material.Concrete)
	local band = api.part(name .. "Glass", Vector3.new(w + 0.12, 1.8, d + 0.12), f * CFrame.new(0, h - 2.4, 0), style.Glass, Enum.Material.Glass, false)
	band.Transparency = 0.15
	band.CastShadow = false
	local doorH = math.min(h - 0.6, 6.6)
	api.part(name .. "Door", Vector3.new(0.14, doorH, 2.6), f * CFrame.new(w * 0.5 + 0.08, doorH * 0.5, -d * 0.2), style.Door, Enum.Material.Metal, false)
	local roof = api.part(name .. "Roof", Vector3.new(w + 1.6, 0.5, d + 1.6), f * CFrame.new(0, h + 0.25, 0), style.Roof, Enum.Material.Metal)
	return body, roof
end

-- Floodlight: pole + a head aimed at `aim` (installation-local), with a SpotLight (no shadows) when lit. 2 parts.
local function floodlight(api: any, pos: Vector3, aim: Vector3, height: number, lit: boolean, col: any): BasePart
	api.box("FloodPole", Vector3.new(0.35, height, 0.35), pos + Vector3.new(0, height * 0.5, 0), col.Metal, Enum.Material.Metal, false)
	local head = pos + Vector3.new(0, height + 0.3, 0)
	local lamp = api.part("FloodLamp", Vector3.new(1.6, 0.9, 0.7), CFrame.lookAt(head, aim), col.Light, Enum.Material.SmoothPlastic, false)
	if lit then
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 60
		spot.Range = math.min(28, LIGHTS.SpotMaxRange or 30)
		spot.Brightness = 2 * (LIGHTS.BrightnessScale or 0.35)
		spot.Color = col.Light
		spot.Shadows = false
		spot.Parent = lamp
	end
	return lamp
end

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0 -- pad (foundation) top
	local ground = y0 - 0.4
	local hw = ictx.HalfW
	local paint = Color3.fromRGB(238, 238, 230)
	local ringCol = if lv >= 5 then col.Gold else Color3.fromRGB(226, 190, 60)

	-- Landing circle (outer disc + dark inner disc = a ring) and the H: flush paint, non-colliding
	local ring = api.cylinder("PadRing", Vector3.new(0.1, 21, 21), CFrame.new(0, y0 + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), ringCol, Enum.Material.SmoothPlastic, false)
	ring.CastShadow = false
	local inner = api.cylinder("PadInner", Vector3.new(0.1, 19.2, 19.2), CFrame.new(0, y0 + 0.11, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(64, 66, 64), Enum.Material.SmoothPlastic, false)
	inner.CastShadow = false
	api.box("PadH", Vector3.new(1.2, 0.1, 8), Vector3.new(-2.4, y0 + 0.17, 0), paint, Enum.Material.SmoothPlastic, false)
	api.box("PadH", Vector3.new(1.2, 0.1, 8), Vector3.new(2.4, y0 + 0.17, 0), paint, Enum.Material.SmoothPlastic, false)
	api.box("PadH", Vector3.new(3.6, 0.1, 1.2), Vector3.new(0, y0 + 0.17, 0), paint, Enum.Material.SmoothPlastic, false)

	-- Perimeter light fittings at the corners (painted, no PointLight: light budget)
	for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		api.box("PadEdgeLight", Vector3.new(0.9, 0.35, 0.9), Vector3.new(o[1] * (hw - 1.2), y0 + 0.175, o[2] * (hw - 1.2)), Color3.fromRGB(255, 226, 150), Enum.Material.SmoothPlastic, false)
	end

	-- Windsock beside the pad edge
	api.box("WindsockPole", Vector3.new(0.3, 7, 0.3), Vector3.new(hw + 1.5, ground + 3.5, -hw + 3), col.Metal, Enum.Material.Metal)
	local sock = api.part("Windsock", Vector3.new(2.6, 0.9, 0.9), CFrame.new(hw + 2.9, ground + 6.5, -hw + 3), Color3.fromRGB(222, 96, 44), Enum.Material.Fabric, false)
	sock.Shape = Enum.PartType.Cylinder

	-- Ops hut beside the pad (player scale: 7.4 tall), door toward the pad
	local _, hutRoof = hut(api, "OpsHut", Vector3.new(-hw - 4.5, ground, -hw + 5), Vector3.new(6, 7.4, 5), 0, {
		Wall = Color3.fromRGB(150, 156, 140),
		Material = Enum.Material.Concrete,
		Glass = Color3.fromRGB(70, 100, 118),
		Door = col.Metal,
		Roof = Color3.fromRGB(62, 66, 62),
	})

	if lv >= 2 then
		-- front corners (toward the base), clear of the HelipadSpots' rotor discs
		floodlight(api, Vector3.new(-hw - 1.2, ground, hw + 1.2), Vector3.new(0, y0, 0), 9, true, col)
	end
	if lv >= 3 then
		-- fuel tank lying on the ground beside the hut (Part cylinder, axis along Z)
		local tank = api.part("FuelTank", Vector3.new(5, 2.6, 2.6), CFrame.new(-hw - 4.5, ground + 1.3, hw - 6) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(96, 104, 80), Enum.Material.Metal)
		tank.Shape = Enum.PartType.Cylinder
	end
	if lv >= 4 then
		floodlight(api, Vector3.new(hw + 1.2, ground, hw + 1.2), Vector3.new(0, y0, 0), 9, false, col) -- light budget: one lit fitting
	end
	if lv >= 5 then
		hutRoof.Color = col.Gold
		api.ball("HutBeacon", 0.9, Vector3.new(-hw - 4.5, ground + 7.9 + 0.45, -hw + 5), col.Gold, Enum.Material.SmoothPlastic, false)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">MissileDefense</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Missile Defense installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 24 x 22 battery
	inside a sandbag berm (gap at the front for the kiosk path): launcher(s) on turntables, fire-control
	truck with a spinning radar, missile crates.
	L1 one 2-tube launcher   L2 fire-control truck   L3 4-tube launcher, blast walls
	L4 second launcher       L5 6-tube launchers, floodlights, gold stripe
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local hw, hd = ictx.HalfW, ictx.HalfD
	local olive = col.Locker
	local tubeEnd = Color3.fromRGB(34, 36, 34)

	-- Sandbag berm around the battery, open at the front centre (x -3..3)
	api.sandbags(-hw + 1, -3, hd - 1, y0)
	api.sandbags(3, hw - 1, hd - 1, y0)
	api.sandbags(-hw + 1, hw - 1, -hd + 1, y0)
	for _, sx in ipairs({ -hw + 1, hw - 1 }) do
		local n = math.floor((ictx.D - 4) / 2.1)
		for i = 0, n - 1 do
			api.box("Sandbag", Vector3.new(1.5, 1.0, 2.0), Vector3.new(sx, y0 + 0.5, -hd + 2 + (i + 0.5) * ((ictx.D - 4) / n)), col.Sandbag, Enum.Material.Fabric)
		end
	end

	-- Launcher on a turntable: canister pack tilted 35° up toward the back (-Z)
	local function launcher(lx: number, lz: number, tubes: number)
		api.cylinder("Turntable", Vector3.new(1.2, 7, 7), CFrame.new(lx, y0 + 0.6, lz) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, Enum.Material.Metal)
		api.box("LauncherPedestal", Vector3.new(2.4, 2.4, 2.4), Vector3.new(lx, y0 + 2.4, lz), col.Metal, Enum.Material.Metal)
		local cols = if tubes >= 6 then 3 else if tubes >= 4 then 2 else 1
		local rows = if tubes >= 2 then 2 else 1
		local packW, packH, packL = cols * 1.7 + 0.6, rows * 1.7 + 0.6, 8
		local pack = CFrame.new(lx, y0 + 3.6 + packH * 0.5, lz) * CFrame.Angles(math.rad(35), 0, 0)
		api.part("LauncherPack", Vector3.new(packW, packH, packL), pack, olive, Enum.Material.Metal)
		api.part("LauncherStripe", Vector3.new(packW + 0.05, 0.3, packL + 0.05), pack * CFrame.new(0, packH * 0.5 - 0.4, 0), if lv >= 5 then col.Gold else col.Accent, Enum.Material.SmoothPlastic, false)
		for c = 1, cols do
			for r = 1, rows do
				local ox = (c - (cols + 1) * 0.5) * 1.7
				local oy = (r - (rows + 1) * 0.5) * 1.7
				-- tube mouths on the raised (-Z) end
				api.cylinder("TubeMouth", Vector3.new(0.3, 1.3, 1.3), pack * CFrame.new(ox, oy, -packL * 0.5 - 0.1) * CFrame.Angles(0, math.rad(90), 0), tubeEnd, Enum.Material.Metal, false)
				api.cylinder("MissileTip", Vector3.new(0.5, 0.6, 0.6), pack * CFrame.new(ox, oy, -packL * 0.5 + 0.1) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(200, 60, 50), Enum.Material.SmoothPlastic, false)
			end
		end
	end
	local tubes = if lv >= 5 then 6 elseif lv >= 3 then 4 else 2
	if lv >= 4 then
		launcher(-5.5, -3, tubes)
		launcher(5.5, -3, tubes)
	else
		launcher(0, -3, tubes)
	end

	-- Fire-control truck with spinning radar (L2+)
	if lv >= 2 then
		local tx, tz = 6.5, 5.5
		api.box("TruckCab", Vector3.new(3, 2.6, 2.6), Vector3.new(tx - 3.4, y0 + 1.9, tz), olive, Enum.Material.Metal)
		local ws = api.box("TruckWindshield", Vector3.new(0.15, 1, 2.2), Vector3.new(tx - 4.95, y0 + 2.5, tz), col.Glass, Enum.Material.Glass, false)
		ws.Transparency = 0.3
		api.box("TruckBody", Vector3.new(5.6, 3, 2.8), Vector3.new(tx + 0.9, y0 + 2.1, tz), olive, Enum.Material.Metal)
		for _, wx in ipairs({ tx - 3.4, tx - 0.4, tx + 2.6 }) do
			for _, side in ipairs({ -1, 1 }) do
				api.cylinder("TruckWheel", Vector3.new(0.6, 1.4, 1.4), CFrame.new(wx, y0 + 0.7, tz + side * 1.35) * CFrame.Angles(0, math.rad(90), 0), tubeEnd, Enum.Material.Fabric, false)
			end
		end
		api.box("RadarMount", Vector3.new(0.5, 1.2, 0.5), Vector3.new(tx + 1.5, y0 + 4.2, tz), col.Metal, Enum.Material.Metal, false)
		local panel = api.part("FireControlRadar", Vector3.new(3.4, 1.8, 0.3), CFrame.new(tx + 1.5, y0 + 5.4, tz) * CFrame.Angles(math.rad(-15), 0, 0), col.Dark, Enum.Material.Metal, false)
		api.spin({ panel }, Vector3.new(tx + 1.5, 0, tz), 14)
	end

	-- Missile crates (grow with level)
	local crates = math.min(2 + lv, 6)
	for i = 0, crates - 1 do
		local cx = -hw + 3.2 + (i % 3) * 2.4
		local cz = 3 + math.floor(i / 3) * 1.6
		api.box("MissileCrate", Vector3.new(2.2, 1.1, 1.4), Vector3.new(cx, y0 + 0.55, cz), olive, Enum.Material.Wood)
		api.box("CrateStencil", Vector3.new(0.8, 0.3, 1.42), Vector3.new(cx, y0 + 0.6, cz), col.Accent, Enum.Material.SmoothPlastic, false)
	end

	-- Blast walls behind the launchers (L3+)
	if lv >= 3 then
		for _, bx in ipairs({ -6, 0, 6 }) do
			api.box("BlastWall", Vector3.new(5.6, 3.2, 0.9), Vector3.new(bx, y0 + 1.6, -hd + 3.2), col.Wall, Enum.Material.Concrete)
		end
	end

	-- Floodlights on poles (L5)
	if lv >= 5 then
		for _, fx in ipairs({ -hw + 2, hw - 2 }) do
			api.box("FloodPole", Vector3.new(0.3, 7, 0.3), Vector3.new(fx, y0 + 3.5, hd - 2.5), col.Metal, Enum.Material.Metal, false)
			local lens = api.box("FloodLamp", Vector3.new(1.4, 0.8, 0.5), Vector3.new(fx, y0 + 7, hd - 2.8), col.Light, Enum.Material.SmoothPlastic, false)
			api.light(lens, 20, 1.2, col.Light)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">PowerStation</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Power Station installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 30 x 22 fenced
	substation yard; the kiosk stands outside the front gate (+Z).
	L1 generator hall + transformer + fence   L2 second transformer + cable trays
	L3 transmission pylon                     L4 solar array           L5 roof fans, gold trim, beacon
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local hw, hd = ictx.HalfW, ictx.HalfD
	local fenceCol = Color3.fromRGB(120, 124, 120)

	-- L5 gold edge band around a roof (matches the walk-in buildings' gold parapet cap)
	local function goldEdge(cx: number, y: number, cz: number, w: number, d: number)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz + d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz - d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx + w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx - w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
	end

	-- A beam between two building-local points (not vertical)
	local function beam(name: string, a: Vector3, b: Vector3, thick: number, color: Color3)
		local mid = (a + b) * 0.5
		api.part(name, Vector3.new(thick, thick, (b - a).Magnitude), CFrame.lookAt(mid, b), color, Enum.Material.Metal, false)
	end

	-- Perimeter fence with a front gate opening (x -3.5..3.5)
	local fx0, fx1, fz0, fz1 = -hw + 0.5, hw - 0.5, -hd + 0.5, hd - 0.5
	local fenceH = 5
	local function fenceRun(ax: number, az: number, bx: number, bz: number)
		local len = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
		if len < 0.5 then
			return
		end
		local mid = Vector3.new((ax + bx) * 0.5, y0 + fenceH * 0.5, (az + bz) * 0.5)
		local alongX = math.abs(bx - ax) > math.abs(bz - az)
		local size = if alongX then Vector3.new(len, fenceH, 0.12) else Vector3.new(0.12, fenceH, len)
		local mesh = api.box("FenceMesh", size, mid, fenceCol, Enum.Material.DiamondPlate)
		mesh.Transparency = 0.55
		local rail = if alongX then Vector3.new(len, 0.2, 0.2) else Vector3.new(0.2, 0.2, len)
		api.box("FenceRail", rail, Vector3.new(mid.X, y0 + fenceH, mid.Z), col.Metal, Enum.Material.Metal, false)
		local posts = math.max(1, math.floor(len / 3.5))
		for i = 0, posts do
			local t = i / posts
			api.box("FencePost", Vector3.new(0.3, fenceH + 0.4, 0.3), Vector3.new(ax + (bx - ax) * t, y0 + (fenceH + 0.4) * 0.5, az + (bz - az) * t), col.Metal, Enum.Material.Metal, false)
		end
	end
	fenceRun(fx0, fz0, fx1, fz0)
	fenceRun(fx0, fz0, fx0, fz1)
	fenceRun(fx1, fz0, fx1, fz1)
	fenceRun(fx0, fz1, -3.5, fz1)
	fenceRun(3.5, fz1, fx1, fz1)
	local warnSign = api.box("DangerSign", Vector3.new(3.2, 1.6, 0.1), Vector3.new(-7, y0 + 3, fz1 + 0.12), Color3.fromRGB(230, 196, 70), Enum.Material.SmoothPlastic, false)
	api.surfaceText(warnSign, Enum.NormalId.Back, { "⚡ DANGER", "HIGH VOLTAGE" }, Color3.fromRGB(20, 20, 20), Color3.fromRGB(230, 196, 70), Enum.Font.GothamBlack)

	-- Generator hall (back-left): solid block with a roll-up door, stacks, sign
	local hx, hz, hW, hD, hH = -8, -4, 12, 10, 8
	api.box("GenHall", Vector3.new(hW, hH, hD), Vector3.new(hx, y0 + hH * 0.5, hz), col.Wall, Enum.Material.Concrete)
	api.box("GenHallRoof", Vector3.new(hW + 0.6, 0.6, hD + 0.6), Vector3.new(hx, y0 + hH + 0.3, hz), col.Trim, Enum.Material.Metal)
	if lv >= 5 then
		goldEdge(hx, y0 + hH + 0.75, hz, hW + 0.6, hD + 0.6)
	end
	api.box("GenDoor", Vector3.new(5, 5.5, 0.2), Vector3.new(hx + 1, y0 + 2.75, hz + hD * 0.5 + 0.1), col.Metal, Enum.Material.DiamondPlate, false)
	api.box("GenDoorStripe", Vector3.new(5, 0.4, 0.22), Vector3.new(hx + 1, y0 + 5.7, hz + hD * 0.5 + 0.11), col.Accent, Enum.Material.SmoothPlastic, false)
	local sign = api.box("GenSign", Vector3.new(7, 1.3, 0.2), Vector3.new(hx, y0 + 7, hz + hD * 0.5 + 0.12), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "POWER STATION" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	for i, sx in ipairs({ hx - 3.5, hx + 3.5 }) do
		if i == 1 or lv >= 2 then
			api.cylinder("ExhaustStack", Vector3.new(5, 1.1, 1.1), CFrame.new(sx, y0 + hH + 2.5, hz - 2.5) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, Enum.Material.Metal)
		end
	end
	api.box("GenVent", Vector3.new(3, 1, 2), Vector3.new(hx, y0 + hH + 1.1, hz + 1.5), col.Metal, Enum.Material.DiamondPlate)
	if lv >= 5 then
		for _, fx in ipairs({ hx - 3, hx + 3 }) do
			api.cylinder("RoofFan", Vector3.new(0.6, 3, 3), CFrame.new(fx, y0 + hH + 0.9, hz + 2.5) * CFrame.Angles(0, 0, math.rad(90)), col.Metal, Enum.Material.Metal)
		end
	end

	-- Transformers (right of the hall)
	local function transformer(tx: number, tz: number)
		api.box("Transformer", Vector3.new(4, 3.6, 3.4), Vector3.new(tx, y0 + 1.8, tz), col.Locker, Enum.Material.Metal)
		for i = -2, 2 do
			api.box("CoolingFin", Vector3.new(0.15, 2.8, 1.2), Vector3.new(tx + i * 0.7, y0 + 1.8, tz + 2.3), col.Metal, Enum.Material.Metal, false)
		end
		for i = -1, 1 do
			api.cylinder("Bushing", Vector3.new(1.4, 0.45, 0.45), CFrame.new(tx + i * 1.2, y0 + 4.3, tz - 0.6) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(150, 110, 70), Enum.Material.SmoothPlastic, false)
		end
		api.box("TransformerPlinth", Vector3.new(5, 0.4, 4.6), Vector3.new(tx, y0 + 0.2, tz + 0.5), col.Floor, Enum.Material.Concrete, false)
	end
	transformer(5, -5)
	if lv >= 2 then
		transformer(11, -5)
		api.box("CableTray", Vector3.new(14, 0.4, 0.8), Vector3.new(4, y0 + 0.2, -1.8), col.Dark, Enum.Material.Metal, false)
	end

	-- Transmission pylon (back-right corner) with insulators; beacon at L5
	if lv >= 3 then
		local px, pz, pH = 11, -8.5, 20
		for _, o in ipairs({ { -1.3, -1.3 }, { 1.3, -1.3 }, { -1.3, 1.3 }, { 1.3, 1.3 } }) do
			api.box("PylonLeg", Vector3.new(0.35, pH, 0.35), Vector3.new(px + o[1], y0 + pH * 0.5, pz + o[2]), col.Metal, Enum.Material.Metal)
		end
		for k = 0, 3 do
			local ya, yb = y0 + k * 4.5, y0 + (k + 1) * 4.5
			beam("PylonBrace", Vector3.new(px - 1.3, ya, pz + 1.3), Vector3.new(px + 1.3, yb, pz + 1.3), 0.2, col.Metal)
			beam("PylonBrace", Vector3.new(px + 1.3, ya, pz - 1.3), Vector3.new(px - 1.3, yb, pz - 1.3), 0.2, col.Metal)
			beam("PylonBrace", Vector3.new(px - 1.3, ya, pz - 1.3), Vector3.new(px - 1.3, yb, pz + 1.3), 0.2, col.Metal)
			beam("PylonBrace", Vector3.new(px + 1.3, ya, pz + 1.3), Vector3.new(px + 1.3, yb, pz - 1.3), 0.2, col.Metal)
		end
		for _, ay in ipairs({ pH - 1, pH - 5 }) do
			api.box("PylonArm", Vector3.new(9, 0.4, 0.4), Vector3.new(px - 1.5, y0 + ay, pz), col.Metal, Enum.Material.Metal, false)
			for _, ix in ipairs({ px - 5.5, px + 2.5 }) do
				api.cylinder("Insulator", Vector3.new(1.4, 0.5, 0.5), CFrame.new(ix, y0 + ay - 0.8, pz) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(150, 110, 70), Enum.Material.SmoothPlastic, false)
			end
		end
		if lv >= 5 then
			local b = api.ball("PylonBeacon", 0.8, Vector3.new(px, y0 + pH + 0.5, pz), Color3.fromRGB(255, 50, 40), Enum.Material.SmoothPlastic, false)
			api.light(b, 10, 1.5, Color3.fromRGB(255, 60, 40))
		end
	end

	-- Solar array (front-right) from L4: tilted panels on frames
	if lv >= 4 then
		for row = 0, 1 do
			for i = 0, 2 do
				local sx, sz = 5.6 + i * 3.4, 3.2 + row * 3.8
				api.box("SolarLeg", Vector3.new(0.25, 1.4, 0.25), Vector3.new(sx, y0 + 0.7, sz + 0.8), col.Metal, Enum.Material.Metal, false)
				api.part("SolarPanel", Vector3.new(3.2, 0.15, 2.4), CFrame.new(sx, y0 + 1.5, sz) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(30, 44, 70), Enum.Material.Glass)
			end
		end
	end

	-- Yard dressing: fuel tank + drums by the hall, yard lamp by the gate
	api.cylinder("FuelTank", Vector3.new(6, 2.6, 2.6), CFrame.new(-8, y0 + 1.5, 5), col.Locker, Enum.Material.Metal)
	api.box("FuelTankSaddle", Vector3.new(4.5, 0.6, 2), Vector3.new(-8, y0 + 0.3, 5), col.Dark, Enum.Material.Metal, false)
	for i = 0, 1 do
		api.cylinder("FuelDrum", Vector3.new(1.5, 1.1, 1.1), CFrame.new(-12.5 + i * 1.3, y0 + 0.75, 8.5) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(120, 60, 40), Enum.Material.Metal)
	end
	api.box("YardLampPole", Vector3.new(0.3, 7, 0.3), Vector3.new(4.5, y0 + 3.5, hd - 1.5), col.Metal, Enum.Material.Metal, false)
	local lamp = api.box("YardLamp", Vector3.new(1.4, 0.3, 0.8), Vector3.new(4.5, y0 + 7, hd - 2), col.Light, Enum.Material.SmoothPlastic, false)
	api.light(lamp, 18, 1.2, col.Light)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">Radar</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Radar installation (HollowBuildingBuilder, StructureVisualConfig.Installations). 24 x 20: control hut,
	lattice tower with a rotating dish (client-side spin via api.spin), cable trench. Kiosk outside the front.
	L1 hut + 10-stud tower + small dish   L2 taller tower, generator   L3 big dish + platform railing
	L4 phased-array panel on the hut      L5 radome on its own tower, gold trim
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local white = Color3.fromRGB(222, 224, 218)

	-- L5 gold edge band around a roof (matches the walk-in buildings' gold parapet cap)
	local function goldEdge(cx: number, y: number, cz: number, w: number, d: number)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz + d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(w, 0.3, 0.3), Vector3.new(cx, y, cz - d * 0.5), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx + w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
		api.box("GoldTrim", Vector3.new(0.3, 0.3, d), Vector3.new(cx - w * 0.5, y, cz), col.Gold, Enum.Material.Metal, false)
	end

	local function beam(name: string, a: Vector3, b: Vector3, thick: number, color: Color3)
		local mid = (a + b) * 0.5
		api.part(name, Vector3.new(thick, thick, (b - a).Magnitude), CFrame.lookAt(mid, b), color, Enum.Material.Metal, false)
	end

	-- Lattice tower: 4 legs, X-braces every 4 studs, a platform on top. Returns the platform top Y.
	local function tower(tx: number, tz: number, h: number, half: number): number
		for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
			api.box("TowerLeg", Vector3.new(0.4, h, 0.4), Vector3.new(tx + o[1] * half, y0 + h * 0.5, tz + o[2] * half), col.Metal, Enum.Material.Metal)
		end
		local steps = math.max(1, math.floor(h / 4))
		for k = 0, steps - 1 do
			local ya, yb = y0 + k * (h / steps), y0 + (k + 1) * (h / steps)
			beam("TowerBrace", Vector3.new(tx - half, ya, tz + half), Vector3.new(tx + half, yb, tz + half), 0.2, col.Metal)
			beam("TowerBrace", Vector3.new(tx + half, ya, tz - half), Vector3.new(tx - half, yb, tz - half), 0.2, col.Metal)
			beam("TowerBrace", Vector3.new(tx - half, ya, tz - half), Vector3.new(tx - half, yb, tz + half), 0.2, col.Metal)
			beam("TowerBrace", Vector3.new(tx + half, ya, tz + half), Vector3.new(tx + half, yb, tz - half), 0.2, col.Metal)
		end
		api.box("TowerPlatform", Vector3.new(half * 2 + 1.6, 0.4, half * 2 + 1.6), Vector3.new(tx, y0 + h + 0.2, tz), col.Metal, Enum.Material.DiamondPlate)
		return y0 + h + 0.4
	end

	-- Control hut (front-left)
	local hx, hz, hW, hD, hH = -6, 3, 9, 8, 6.5
	api.box("RadarHut", Vector3.new(hW, hH, hD), Vector3.new(hx, y0 + hH * 0.5, hz), col.Wall, Enum.Material.Concrete)
	api.box("RadarHutRoof", Vector3.new(hW + 0.6, 0.5, hD + 0.6), Vector3.new(hx, y0 + hH + 0.25, hz), col.Trim, Enum.Material.Metal)
	if lv >= 5 then
		goldEdge(hx, y0 + hH + 0.65, hz, hW + 0.6, hD + 0.6)
	end
	api.box("RadarHutDoor", Vector3.new(2.6, 5, 0.2), Vector3.new(hx + 2.4, y0 + 2.5, hz + hD * 0.5 + 0.1), col.Metal, Enum.Material.Metal, false)
	local win = api.box("RadarHutWindow", Vector3.new(3.2, 1.6, 0.2), Vector3.new(hx - 1.8, y0 + 3.8, hz + hD * 0.5 + 0.1), col.Glass, Enum.Material.Glass, false)
	win.Transparency = 0.3
	local sign = api.box("RadarSign", Vector3.new(6, 1.1, 0.2), Vector3.new(hx, y0 + hH - 0.9, hz + hD * 0.5 + 0.12), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "RADAR CONTROL" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	api.box("HutAC", Vector3.new(2.2, 1.4, 1.6), Vector3.new(hx - 2.5, y0 + hH + 1.2, hz - 1.5), col.Metal, Enum.Material.DiamondPlate)

	-- Main tower + dish (back-right)
	local tx, tz = 5, -3
	local h = ({ 10, 13, 15, 16, 17 })[lv] or 10
	local top = tower(tx, tz, h, 1.5)
	if lv >= 3 then
		for _, side in ipairs({ -1, 1 }) do
			api.box("PlatformRail", Vector3.new(4.6, 0.2, 0.2), Vector3.new(tx, top + 1.1, tz + side * 2.2), col.Accent, Enum.Material.Metal, false)
			api.box("PlatformRail", Vector3.new(0.2, 0.2, 4.6), Vector3.new(tx + side * 2.2, top + 1.1, tz), col.Accent, Enum.Material.Metal, false)
		end
	end
	local dishD = if lv >= 3 then 8 else 5
	api.cylinder("DishMast", Vector3.new(2, 0.7, 0.7), CFrame.new(tx, top + 1, tz) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, Enum.Material.Metal)
	local dish = api.cylinder("RadarDish", Vector3.new(0.4, dishD, dishD), CFrame.new(tx, top + 2 + dishD * 0.35, tz - 0.6) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(20)), white, Enum.Material.SmoothPlastic, false)
	local feedArm = api.part("FeedArm", Vector3.new(0.2, 0.2, 2.6), CFrame.new(tx, top + 2 + dishD * 0.35, tz + 0.7), col.Metal, Enum.Material.Metal, false)
	local feed = api.ball("FeedHorn", 0.6, Vector3.new(tx, top + 2 + dishD * 0.35, tz + 2), col.Dark, Enum.Material.Metal, false)
	api.spin({ dish, feedArm, feed }, Vector3.new(tx, 0, tz), if lv >= 3 then 8 else 12)

	-- Cable trench hut → tower
	api.box("CableTrench", Vector3.new(0.8, 0.1, 7), Vector3.new(0.5, y0 + 0.05, 0.5), col.Dark, Enum.Material.Metal, false)

	-- Generator (L2+)
	if lv >= 2 then
		api.box("Generator", Vector3.new(3.4, 2.2, 2), Vector3.new(-8.5, y0 + 1.1, -6), col.Locker, Enum.Material.DiamondPlate)
		api.box("GeneratorStripe", Vector3.new(3.45, 0.4, 2.05), Vector3.new(-8.5, y0 + 1.7, -6), col.Accent, Enum.Material.SmoothPlastic, false)
	end

	-- Phased-array panel on the hut roof (L4+)
	if lv >= 4 then
		api.part("PhasedArray", Vector3.new(5, 3.6, 0.5), CFrame.new(hx + 1, y0 + hH + 2.4, hz - 1) * CFrame.Angles(math.rad(-20), 0, 0), col.Dark, Enum.Material.Metal)
		for i = -1, 1 do
			api.box("ArrayLed", Vector3.new(0.3, 0.3, 0.1), Vector3.new(hx + 1 + i * 1.2, y0 + hH + 1.4, hz - 0.45), col.Screen, Enum.Material.Neon, false)
		end
	end

	-- Radome on a short tower (L5)
	if lv >= 5 then
		local rtop = tower(-6, -6, 6, 1.4)
		api.ball("Radome", 6.5, Vector3.new(-6, rtop + 3, -6), white, Enum.Material.SmoothPlastic)
	end

	-- Warning lamp on the main tower
	local lamp = api.ball("TowerLamp", 0.6, Vector3.new(tx + 1.5, top + 0.5, tz + 1.5), Color3.fromRGB(255, 50, 40), Enum.Material.SmoothPlastic, false)
	api.light(lamp, 8, 1.2, Color3.fromRGB(255, 60, 40))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">Watchtower</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Watchtower installation (HollowBuildingBuilder, StructureVisualConfig.Installations; structure Watchtowers).
	10 x 10 by the main gate: four braced legs, a climbable ladder (TrussPart) on the compound side (-Z, where
	the kiosk is), a timber cabin with half-walls, a pitched roof and a searchlight facing the front wall.
	Height grows with level; L3 mounted gun; L5 gold ridge + flag.
	v70 (HUD spec §5): the searchlight goes through StructureVisualConfig.BuildingLights like every building light
	(BrightnessScale, SpotMaxRange), with a SmoothPlastic lens and no shadows.
	v73 (owner: "the watchtower doesn't fit the player"): the cabin is sized for a 7.5-stud avatar with 1 stud of
	head room (CabinClearHeight, was 3.6), the deck is 10 x 10 (was 8.4), the ladder always tops out above the
	deck, and the roof is CanCollide = false so heads, jumps and the Poppercam never catch on it.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local LIGHTS = (StructureVisualConfig :: any).BuildingLights or {}
local TOWER = ((StructureVisualConfig :: any).Installations or {}).Watchtowers or {}

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv = ictx.Level
	local y0 = ictx.Y0
	local timber = Color3.fromRGB(96, 78, 56)
	local roofCol = Color3.fromRGB(74, 84, 60)

	local function beam(name: string, a: Vector3, b: Vector3, thick: number, color: Color3)
		local mid = (a + b) * 0.5
		api.part(name, Vector3.new(thick, thick, (b - a).Magnitude), CFrame.lookAt(mid, b), color, Enum.Material.Wood, false)
	end

	local h = 10 + lv * 1.6 -- deck underside above the foundation
	local L = 4.2 -- leg offset (deck 10 x 10)
	local deckW = 10
	local clear: number = TOWER.CabinClearHeight or 8.5 -- deck top to roof underside (7.5-stud avatar + 1 stud)
	local wallH: number = TOWER.HalfWallHeight or 3.4
	for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		api.box("TowerLeg", Vector3.new(0.8, h, 0.8), Vector3.new(o[1] * L, y0 + h * 0.5, o[2] * L), timber, Enum.Material.Wood)
	end
	-- X braces on the three sides away from the ladder, a single rail on the ladder side
	for _, k in ipairs({ 0, 1 }) do
		local ya, yb = y0 + 1 + k * (h - 2) * 0.5, y0 + 1 + (k + 1) * (h - 2) * 0.5
		beam("TowerBrace", Vector3.new(-L, ya, L), Vector3.new(L, yb, L), 0.35, timber)
		beam("TowerBrace", Vector3.new(L, ya, L), Vector3.new(-L, yb, L), 0.35, timber)
		beam("TowerBrace", Vector3.new(-L, ya, -L), Vector3.new(-L, yb, L), 0.35, timber)
		beam("TowerBrace", Vector3.new(L, ya, L), Vector3.new(L, yb, -L), 0.35, timber)
	end

	-- Deck + timber half-walls (3.4 high; 3.2-stud gap over the ladder)
	local py = y0 + h
	api.box("TowerDeck", Vector3.new(deckW, 0.5, deckW), Vector3.new(0, py + 0.25, 0), timber, Enum.Material.WoodPlanks)
	local deck = py + 0.5
	local e = deckW * 0.5 - 0.2
	api.box("CabinWall", Vector3.new(deckW, wallH, 0.4), Vector3.new(0, deck + wallH * 0.5, e), timber, Enum.Material.WoodPlanks)
	api.box("CabinWall", Vector3.new(0.4, wallH, deckW - 0.8), Vector3.new(-e, deck + wallH * 0.5, 0), timber, Enum.Material.WoodPlanks)
	api.box("CabinWall", Vector3.new(0.4, wallH, deckW - 0.8), Vector3.new(e, deck + wallH * 0.5, 0), timber, Enum.Material.WoodPlanks)
	local gap = 1.6 -- half the ladder opening
	api.box("CabinWall", Vector3.new(e - gap, wallH, 0.4), Vector3.new(-(gap + e) * 0.5, deck + wallH * 0.5, -e), timber, Enum.Material.WoodPlanks)
	api.box("CabinWall", Vector3.new(e - gap, wallH, 0.4), Vector3.new((gap + e) * 0.5, deck + wallH * 0.5, -e), timber, Enum.Material.WoodPlanks)

	-- Ladder on the compound side, outside the deck edge. TrussPart heights are even, so round UP: the top is
	-- 0.3 .. 1.9 studs above the deck at every level (was up to 0.9 below it at L4)
	local ladderH = 2 * math.ceil((h + 0.5) / 2)
	api.truss("TowerLadder", ladderH, Vector3.new(0, y0, -deckW * 0.5 - 1), col.Metal)

	-- Cabin: corner posts + pitched roof. Roof is non-collidable (no head bumps, no Poppercam pop-under).
	local roofY = deck + clear
	for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		api.box("RoofPost", Vector3.new(0.4, clear, 0.4), Vector3.new(o[1] * e, deck + clear * 0.5, o[2] * e), timber, Enum.Material.Wood, false)
	end
	local rise, run, len = 2.4, deckW * 0.5 + 0.6, deckW + 1.2
	local r1 = api.wedge("TowerRoof", Vector3.new(len, rise, run), CFrame.new(0, roofY + rise * 0.5, run * 0.5) * CFrame.Angles(0, math.pi, 0), roofCol, Enum.Material.Metal, false)
	local r2 = api.wedge("TowerRoof", Vector3.new(len, rise, run), CFrame.new(0, roofY + rise * 0.5, -run * 0.5), roofCol, Enum.Material.Metal, false)
	r1.CanQuery = false
	r2.CanQuery = false
	api.box("TowerRidge", Vector3.new(len + 0.2, 0.35, 0.7), Vector3.new(0, roofY + rise, 0), if lv >= 5 then col.Gold else col.Metal, Enum.Material.Metal, false)
	if lv >= 5 then
		api.box("FlagPole", Vector3.new(0.25, 7, 0.25), Vector3.new(-e - 0.3, roofY + 3.5, -e - 0.3), col.Metal, Enum.Material.Metal, false)
		-- nation-flag decal host (WE_FlagHost): 0.12 thick along X, decals on the Left / Right faces
		local cloth = api.box("Flag", Vector3.new(0.12, 1.8, 3), Vector3.new(-e - 0.3, roofY + 6, -e - 0.3 + 1.6), col.Flag, Enum.Material.Fabric, false)
		cloth:SetAttribute("WE_FlagHost", true)
	end

	-- Searchlight on the front half-wall, facing the front wall (+Z): out of the walking area
	api.box("SearchlightMount", Vector3.new(0.5, 0.8, 0.5), Vector3.new(3.2, deck + wallH + 0.4, e), col.Metal, Enum.Material.Metal, false)
	api.cylinder("Searchlight", Vector3.new(1.4, 1.3, 1.3), CFrame.new(3.2, deck + wallH + 1.3, e) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal, false)
	local lens = api.cylinder("SearchlightLens", Vector3.new(0.1, 1.1, 1.1), CFrame.new(3.2, deck + wallH + 1.3, e + 0.72) * CFrame.Angles(0, math.rad(-90), 0), col.Light, Enum.Material.SmoothPlastic, false)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Right -- lens local +X = building +Z
	spot.Angle = 40
	spot.Range = math.min(30, LIGHTS.SpotMaxRange or 30)
	spot.Brightness = 2 * (LIGHTS.BrightnessScale or 0.35) -- 0.7 at the v69 scale
	spot.Color = col.Light
	spot.Shadows = false
	spot.Parent = lens

	-- Mounted gun on the front half-wall (L3+)
	if lv >= 3 then
		api.box("GunMount", Vector3.new(0.4, 0.8, 0.4), Vector3.new(-3.2, deck + wallH + 0.4, e), col.Metal, Enum.Material.Metal, false)
		api.box("GunBody", Vector3.new(0.6, 0.6, 1.8), Vector3.new(-3.2, deck + wallH + 1.0, e + 0.2), col.Dark, Enum.Material.Metal, false)
		api.cylinder("GunBarrel", Vector3.new(2, 0.25, 0.25), CFrame.new(-3.2, deck + wallH + 1.05, e + 1.9) * CFrame.Angles(0, math.rad(90), 0), col.Dark, Enum.Material.Metal, false)
	end
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="169">
          <Properties>
            <string name="Name">Interiors</string>
          </Properties>
          <Item class="ModuleScript" referent="170">
            <Properties>
              <string name="Name">Armory</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Armory interior (StructureId WeaponsFacility, HollowBuildingBuilder). Weapons storage and issue.

	Ground floor
	  back-east   caged arms-issue counter: steel counter with the Shop terminal set in as the service hatch,
	              bars above, rifle racks on the cage walls behind, sidearm cabinet under the back window
	  west wall   squad loadout bay: Army terminal between kit lockers, loadout board above it
	  front pier  gunsmith workbench (vice, rifle on the bench, tool board) west of the door
	  windows     olive ammo crates (yellow stencil stripe) kept low under the window bands
	  centre      rifle-cleaning table; back-west ammo pallets while single-storey
	  L2+ second cage rack, third locker, tools, more crates / pallet · L3+ pier rifle rack, grenade + rifle crates
	Upper floor (two storeys from L4)
	  west        ammo storage: wall shelving + a freestanding row (L5 adds a third row), pallet of crates
	  east        test-fire lane: baffle wall, shooting bench, target plate and angled steel backstop at the back
	              wall, range terminal (Missions) at the firing point

	Layout (building-local, +Z = front/door): 30 x 22, doorway X 9, console (12.5, 7). The back-west strip
	(X < 6, Z < -4.7) only holds low pallets while single-storey — the stairs take it from L4 and the ammo
	store moves upstairs. Tall pieces stay out of the window bands (front X -10/-3, back X -8/8, sides Z 0).
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local doorX: number = ictx.DoorX
	local M = Enum.Material
	local N = Enum.NormalId
	local wood = Color3.fromRGB(118, 96, 68)
	local paper = col.Sandbag
	local screenBg = Color3.fromRGB(8, 20, 12)

	-- box placed by its bottom centre
	local function blk(name: string, sx: number, sy: number, sz: number, cx: number, yb: number, cz: number, color: Color3, mat: Enum.Material, collide: boolean?): Part
		return api.box(name, Vector3.new(sx, sy, sz), Vector3.new(cx, yb + sy * 0.5, cz), color, mat, collide)
	end

	-- painted stencil (yellow band + lettering) on one face — no extra parts
	local function stencil(host: BasePart, face: Enum.NormalId, text: string, stripe: boolean, top: number?, height: number?)
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_Stencil"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		if stripe then
			local band = Instance.new("Frame")
			band.Name = "Stripe"
			band.BackgroundColor3 = col.Accent
			band.BorderSizePixel = 0
			band.Position = UDim2.fromScale(0, 0.12)
			band.Size = UDim2.fromScale(1, 0.14)
			band.Parent = sg
		end
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Position = UDim2.fromScale(0.08, top or 0.4)
		lbl.Size = UDim2.fromScale(0.84, height or 0.4)
		lbl.Font = Enum.Font.GothamBlack
		lbl.Text = text
		lbl.TextColor3 = col.Accent
		lbl.TextScaled = true
		lbl.Parent = sg
	end

	-- olive ammo crate (bottom-centred), stencilled on the face toward the room; `band` adds a painted
	-- stripe round one end as a real part so it reads from every side
	local function crate(cx: number, yb: number, cz: number, sx: number, sy: number, sz: number, faces: { Enum.NormalId }, label: string, band: boolean): Part
		local c = blk("AmmoCrate", sx, sy, sz, cx, yb, cz, col.Trim, M.WoodPlanks)
		for _, f in ipairs(faces) do
			stencil(c, f, label, true)
		end
		if band then
			if sx >= sz then
				api.box("CrateStripe", Vector3.new(0.3, sy + 0.04, sz + 0.04), Vector3.new(cx + sx * 0.5 - 0.5, yb + sy * 0.5, cz), col.Accent, M.SmoothPlastic, false)
			else
				api.box("CrateStripe", Vector3.new(sx + 0.04, sy + 0.04, 0.3), Vector3.new(cx, yb + sy * 0.5, cz + sz * 0.5 - 0.5), col.Accent, M.SmoothPlastic, false)
			end
		end
		return c
	end

	-- wooden pallet with two crates (and one on top)
	local function pallet(cx: number, yb: number, cz: number, faces: { Enum.NormalId }, label: string, top: boolean)
		blk("Pallet", 4.2, 0.3, 2.6, cx, yb, cz, wood, M.WoodPlanks)
		crate(cx - 1.02, yb + 0.3, cz, 2.0, 1.3, 2.4, faces, label, false)
		crate(cx + 1.02, yb + 0.3, cz, 2.0, 1.3, 2.4, faces, label, false)
		if top then
			crate(cx, yb + 1.6, cz, 2.2, 1.2, 2.2, faces, label, true)
		end
	end

	-- wall rifle rack: steel backboard on the wall, stock tray, n rifles standing barrel-up
	-- wall: "E" | "W" | "B" | "F"; c = centre along the wall; yb = base height
	local function rack(wall: string, c: number, len: number, n: number, yb: number)
		local alongX = wall == "B" or wall == "F"
		local nx, nz, wx, wz = 0, 0, 0, 0
		if wall == "E" then
			nx, wx = -1, X1
		elseif wall == "W" then
			nx, wx = 1, X0
		elseif wall == "B" then
			nz, wz = 1, Z0
		else
			nz, wz = -1, Z1
		end
		local function at(d: number, t: number, y: number): Vector3
			if alongX then
				return Vector3.new(t, y, wz + nz * d)
			end
			return Vector3.new(wx + nx * d, y, t)
		end
		local function dims(depth: number, h: number, length: number): Vector3
			if alongX then
				return Vector3.new(length, h, depth)
			end
			return Vector3.new(depth, h, length)
		end
		api.box("RackBoard", dims(0.24, 5, len), at(0.12, c, yb + 2.5), col.Metal, M.Metal)
		api.box("RackTray", dims(0.6, 0.3, len), at(0.54, c, yb + 0.15), col.Dark, M.Metal)
		for i = 1, n do
			local t = c - len * 0.5 + len * (i - 0.5) / n
			api.box("Rifle", dims(0.5, 3.6, 0.18), at(0.55, t, yb + 0.3 + 1.8), col.Dark, M.Metal, false)
		end
	end

	-- ── Ground floor ─────────────────────────────────────────────────────────

	-- Door runner
	api.box("Runner", Vector3.new(3.4, 0.06, 5.6), Vector3.new(doorX, y1 + 0.03, Z1 - 3.0), col.Rug, M.Fabric, false)

	-- Caged arms-issue counter (back-east). Counter front z -4.4, bars at z -5.3, cage side at x 6.4.
	local cz = -5.0
	local barZ = -5.3
	local sideX = 6.4
	local hatchX = 9.5
	local yTop = y1 + 3.55
	local yHead = y1 + 9.2
	blk("IssueCounter", 2.05, 3.3, 1.2, 7.275, y1, cz, col.Dark, M.Metal)
	blk("IssueCounter", 3.5, 3.3, 1.2, 12.45, y1, cz, col.Dark, M.Metal)
	blk("CounterTop", 2.05, 0.25, 1.5, 7.275, y1 + 3.3, cz + 0.15, col.Metal, M.DiamondPlate)
	blk("CounterTop", 3.5, 0.25, 1.5, 12.45, y1 + 3.3, cz + 0.15, col.Metal, M.DiamondPlate)
	local issue = api.terminal("IssueTerminal", Vector3.new(hatchX, y1, cz), 0, "Shop", "Buy weapons", "Armory · Weapons", { "ARMS ISSUE", "WEAPONS · SHOP" })
	local issuePrompt = issue:FindFirstChild("WE_PanelPrompt")
	if issuePrompt then
		issuePrompt:SetAttribute("WE_OpenTab", "Weapons") -- opens the Shop on its WEAPONS tab
	end
	for _, px in ipairs({ sideX, 8.15, 10.85 }) do
		blk("CagePost", 0.3, yHead - yTop, 0.3, px, yTop, barZ, col.Metal, M.Metal)
	end
	for _, bx in ipairs({ 7.3, 11.65, 12.5, 13.35 }) do
		blk("CageBar", 0.12, yHead - yTop, 0.12, bx, yTop, barZ, col.Metal, M.Metal)
	end
	blk("CageHeader", X1 - 6.25, 0.3, 0.3, (6.25 + X1) * 0.5, yHead, barZ, col.Metal, M.Metal, false)
	-- cage side (floor to header), stops short of the back window band
	for _, bz in ipairs({ -6.3, -7.2, -8.1, -8.95 }) do
		blk("CageBar", 0.12, yHead - y1, 0.12, sideX, y1, bz, col.Metal, M.Metal)
	end
	blk("CageRail", 0.16, 0.2, 3.4, sideX, y1 + 3.35, -7.3, col.Metal, M.Metal)
	local issueSign = blk("IssueSign", 2.3, 1.1, 0.15, hatchX, yHead - 1.15, barZ, col.Dark, M.Metal, false)
	api.surfaceText(issueSign, N.Back, { "ARMS ISSUE" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	api.box("WaitLine", Vector3.new(X1 - 6.25, 0.04, 0.3), Vector3.new((6.25 + X1) * 0.5, y1 + 0.02, -3.6), col.Accent, M.SmoothPlastic, false)

	-- Behind the bars: rifle racks on the cage walls, sidearm cabinet under the back window
	rack("E", -7.7, 3.6, 5, y1 + 0.2)
	if lv >= 2 then
		rack("B", 12.0, 2.8, 4, y1 + 0.2)
	end
	local cabinet = blk("SidearmCabinet", 3.2, 3.0, 1.0, 8.5, y1, Z0 + 0.55, col.Locker, M.Metal)
	stencil(cabinet, N.Back, "SIDEARMS", false)
	if lv >= 3 then
		crate(9.8, y1, -7.5, 3.0, 1.1, 1.3, { N.Back }, "RIFLES", true)
	end

	-- Squad loadout bay (west wall): Army terminal between kit lockers, loadout board above it
	local bayZ = 5.6
	api.terminal("LoadoutTerminal", Vector3.new(X0 + 0.6, y1, bayZ), 90, "Army", "Equip squad", "Squad loadouts", { "SQUAD LOADOUTS", "EQUIP · ARMY" })
	local board = api.box("LoadoutBoard", Vector3.new(0.15, 2.6, 2.6), Vector3.new(X0 + 0.075, y1 + 6.9, bayZ), col.Dark, M.Metal, false)
	api.surfaceText(board, N.Right, { "SQUAD LOADOUTS", "ALPHA · RIFLES", "BRAVO · SUPPORT", "ARMORY LVL " .. tostring(lv) }, col.Screen, screenBg, Enum.Font.Code)
	local lockerZ = { 3.4, 7.7 }
	if lv >= 2 then
		table.insert(lockerZ, 9.1)
	end
	local squads = { "ALPHA", "BRAVO", "CHARLIE" }
	for i, lz in ipairs(lockerZ) do
		local locker = blk("KitLocker", 1.4, 7, 1.4, X0 + 0.7, y1, lz, col.Locker, M.Metal)
		stencil(locker, N.Right, squads[i], false, 0.1, 0.08)
	end

	-- Gunsmith workbench on the front pier west of the door
	local wbX = 2.15
	blk("WorkbenchBase", 4.6, 2.75, 1.6, wbX, y1, Z1 - 0.85, col.Dark, M.Metal)
	blk("Workbench", 4.9, 0.3, 1.9, wbX, y1 + 2.75, Z1 - 1.0, wood, M.WoodPlanks)
	local wbY = y1 + 3.05
	blk("ViceBase", 0.7, 0.3, 0.7, wbX - 1.8, wbY, Z1 - 1.5, col.Metal, M.Metal, false)
	blk("ViceJaw", 1.0, 0.5, 0.3, wbX - 1.8, wbY + 0.3, Z1 - 1.6, col.Dark, M.Metal, false)
	api.part("RifleOnBench", Vector3.new(2.8, 0.22, 0.45), CFrame.new(wbX + 0.4, wbY + 0.11, Z1 - 1.1) * CFrame.Angles(0, math.rad(12), 0), col.Dark, M.Metal, false)
	local toolBoard = blk("ToolBoard", 4.4, 3.0, 0.12, wbX, y1 + 3.5, Z1 - 0.06, col.Metal, M.Metal, false)
	api.light(toolBoard, 10, 0.5, col.Light)
	if lv >= 2 then
		blk("Tool", 0.22, 1.4, 0.08, wbX - 1.4, y1 + 4.3, Z1 - 0.16, col.Dark, M.Metal, false)
		blk("Tool", 1.3, 0.3, 0.08, wbX + 1.0, y1 + 5.6, Z1 - 0.16, col.Dark, M.Metal, false)
	end
	api.part("Stool", Vector3.new(1.9, 1.2, 1.2), CFrame.new(wbX + 0.2, y1 + 0.95, Z1 - 3.0) * CFrame.Angles(0, 0, math.rad(90)), col.Dark, M.Metal).Shape = Enum.PartType.Cylinder

	-- Ammo crates, kept low under the windows
	crate(-4.0, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "5.56 MM", false)
	crate(-1.85, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "5.56 MM", false)
	if lv >= 2 then
		crate(-2.9, y1 + 1.3, Z1 - 0.75, 2.0, 1.2, 1.3, { N.Front }, "7.62 MM", true)
		crate(-11.0, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "7.62 MM", false)
		crate(-8.85, y1, Z1 - 0.75, 2.0, 1.3, 1.3, { N.Front }, "7.62 MM", false)
	end
	crate(X1 - 0.7, y1, -1.0, 1.3, 1.3, 2.0, { N.Left }, "40 MM", false)
	crate(X1 - 0.7, y1, 1.1, 1.3, 1.3, 2.0, { N.Left }, "40 MM", false)
	if lv >= 3 then
		crate(X1 - 0.7, y1 + 1.3, 0.05, 1.3, 1.2, 2.0, { N.Left }, "GRENADES", false)
	end

	-- Back-west ammo store (single storey only — the stairs take this strip from L4)
	if not ictx.TwoStory then
		pallet(-9.2, y1, -8.6, { N.Back }, "7.62 MM", lv >= 2)
		if lv >= 2 then
			pallet(-2.6, y1, -8.6, { N.Back }, "5.56 MM", lv >= 3)
		end
	end

	-- Rifle-cleaning table in the middle (second rifle from L2); L3+ rifle rack on the pier between the windows
	blk("CleaningTable", 4.4, 2.8, 1.6, -5.0, y1, 0.8, col.Dark, M.Metal)
	blk("CleaningMat", 4.8, 0.2, 2.0, -5.0, y1 + 2.8, 0.8, col.Rug, M.Fabric)
	api.part("RifleLaid", Vector3.new(3.0, 0.22, 0.5), CFrame.new(-5.5, y1 + 3.11, 0.4) * CFrame.Angles(0, math.rad(6), 0), col.Dark, M.Metal, false)
	if lv >= 2 then
		api.part("RifleLaid", Vector3.new(3.0, 0.22, 0.5), CFrame.new(-4.4, y1 + 3.11, 1.3) * CFrame.Angles(0, math.rad(-8), 0), col.Dark, M.Metal, false)
	end
	if lv >= 3 then
		rack("F", -6.5, 2.2, 3, y1 + 0.2)
	end

	-- ── Upper floor (L4+): ammo storage + test-fire lane ────────────────────
	if ictx.TwoStory then
		local y2: number = ictx.Y2

		-- steel shelving row running along Z with crates / ammo cans on the shelves
		local function shelving(cx: number, z0: number, z1: number, faces: { Enum.NormalId }, loads: { { number } })
			local len = z1 - z0
			local mid = (z0 + z1) * 0.5
			for _, ez in ipairs({ z0 + 0.1, z1 - 0.1 }) do
				api.box("ShelfFrame", Vector3.new(1.3, 6.2, 0.2), Vector3.new(cx, y2 + 3.1, ez), col.Metal, M.Metal)
			end
			-- two shelves; the bottom tier stands on the floor between the frames (pallet-rack style)
			for _, sy in ipairs({ 2.3, 4.3 }) do
				api.box("Shelf", Vector3.new(1.3, 0.15, len - 0.4), Vector3.new(cx, y2 + sy, mid), col.Metal, M.DiamondPlate)
			end
			-- load = { tier 1..3 (1 = floor), z offset from the middle, length, height }
			for _, ld in ipairs(loads) do
				local sy = if ld[1] == 1 then 0 else 0.375 + (ld[1] - 1) * 2
				crate(cx, y2 + sy, mid + ld[2], 1.1, ld[4], ld[3], faces, if ld[1] == 2 then "5.56 MM" else "7.62 MM", false)
			end
		end

		-- Test-fire lane down the east side
		local laneX = (10.3 + X1) * 0.5
		local baffle = blk("LaneBaffle", 0.3, 3.0, 13.95, 10.15, y2, -3.175, col.Stair, M.Concrete)
		stencil(baffle, N.Left, "TEST-FIRE LANE  ·  EYES & EARS", true, 0.38, 0.3)
		api.box("LaneMat", Vector3.new(3.8, 0.05, 13.4), Vector3.new(laneX, y2 + 0.025, -3.4), col.Dark, M.Fabric, false)
		api.box("FiringLine", Vector3.new(3.85, 0.06, 0.3), Vector3.new(laneX, y2 + 0.03, 3.9), col.Accent, M.SmoothPlastic, false)
		blk("ShootingBench", 3.4, 2.6, 1.4, laneX, y2, 4.8, wood, M.WoodPlanks)
		api.box("RangeRifle", Vector3.new(0.45, 0.22, 2.8), Vector3.new(laneX - 0.3, y2 + 2.71, 4.4), col.Dark, M.Metal, false)
		api.part("Backstop", Vector3.new(3.8, 5.2, 0.3), CFrame.new(laneX, y2 + 2.45, -8.9) * CFrame.Angles(math.rad(-25), 0, 0), col.Metal, M.DiamondPlate)
		blk("TargetPost", 0.25, 2.3, 0.25, laneX, y2, -6.6, col.Metal, M.Metal, false)
		local target = api.box("TargetPlate", Vector3.new(1.8, 2.4, 0.15), Vector3.new(laneX, y2 + 3.5, -6.6), paper, M.SmoothPlastic, false)
		do
			local sg = Instance.new("SurfaceGui")
			sg.Name = "WE_Target"
			sg.Face = N.Back
			sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			sg.PixelsPerStud = 40
			sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
			sg.Parent = target
			for i, s in ipairs({ 0.86, 0.66, 0.46, 0.26, 0.1 }) do
				local ring = Instance.new("Frame")
				ring.AnchorPoint = Vector2.new(0.5, 0.5)
				ring.Position = UDim2.fromScale(0.5, 0.42)
				ring.Size = UDim2.fromScale(s, s)
				ring.SizeConstraint = Enum.SizeConstraint.RelativeXX
				ring.BackgroundColor3 = if i % 2 == 1 then col.Dark else paper
				ring.BorderSizePixel = 0
				ring.ZIndex = i
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(0.5, 0)
				corner.Parent = ring
				ring.Parent = sg
			end
		end
		api.terminal("RangeTerminal", Vector3.new(X1 - 0.6, y2, 7.8), -90, "Missions", "Open missions", "Firing range · Missions", { "RANGE CONTROL", "DRILLS · MISSIONS" })

		-- Ammo storage on the west side: wall shelving + a freestanding row (third row at L5), pallets
		shelving(X0 + 0.65, 3.0, 9.6, { N.Right }, { { 1, -1.6, 2.4, 1.3 }, { 1, 1.4, 2.4, 1.3 }, { 2, 0, 1.8, 1.1 } })
		-- v70: crates are stencilled on the face toward the open floor only (SurfaceGui budget; was both faces)
		shelving(-8.5, -3.8, 3.4, { N.Right }, { { 1, -1.6, 2.6, 1.3 }, { 2, 0.6, 2.0, 1.1 }, { 3, -1.4, 1.8, 1.0 } })
		if lv >= 5 then
			shelving(-3.5, -3.8, 3.4, { N.Right }, { { 1, 0, 3.0, 1.3 }, { 2, -1.5, 2.0, 1.1 }, { 3, 0.8, 1.8, 1.0 } })
		end
		pallet(0.2, y2, 7.2, { N.Front }, "7.62 MM", true)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="171">
            <Properties>
              <string name="Name">Barracks</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Barracks interior (HollowBuildingBuilder). Where the player's soldiers live and are recruited.

	Ground floor: an open squad bay on the west side — two columns of steel bunks (heads to the west wall and to
	the bay's east edge, open foot posts) with numbered footlockers at their feet, wall lockers between the bunks
	and a runner down the centre aisle (4 bunks at L1, 6 from L2). East side: the recruitment desk facing the door
	(Army terminal, recruiter's chair, flag from L2), a "new recruits" bench by the doorway, the duty-roster /
	training terminal on the east wall under the roster board (Missions), and a mess table with benches in the
	back-east corner (rifle rack from L2).
	Upper floor (two storeys from L3): a second bunk room (2 bunks, 3 from L4) with a locker, the PT corner, kit
	shelves on the front wall, a washroom behind partitions in the back-east corner, and the officer's office in
	the front-east corner behind a half-height partition (desk whose top opens the Army panel, armchair, sector
	map; filing cabinet + flag from L4, rug from L5). L4/L5 also restencil the bay plate (gold at L5).

	Layout (building-local, +Z = front/door, door at X = 10): stairs run along the back wall from L3
	(X -15.2..5, Z -11.2..-5.7), so the bay stops at z = 0 and a cross aisle leads to the stair foot. At L1–L2
	that strip is the PT corner with a kit shelf and crates (it moves upstairs at L3). Tall items stay out of the
	window bands (4.4..7.6 above the floor, 1.2 studs in front of each pane); walkways are >= 2.8 studs.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1 = ictx.Y1
	local X0, X1, Z0, Z1 = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1

	local pillowCol = Color3.fromRGB(206, 200, 182)
	local boardBg = Color3.fromRGB(18, 24, 20)

	local KIT_LINES = { "KIT", "[#] [#]", "-------", "[#][#][#]", "-------", "[#] [#]", "-------" }
	local BUNK_L = 5.2 -- along X
	local BUNK_W = 2.5 -- along Z

	-- Steel bunk bed running along X from xHead (dir = +1 → foot toward +X, -1 → toward -X): solid head frame,
	-- open foot posts (you can see the made-up bunks from the aisle), footlocker at the foot.
	local bunkNo = 0
	local function bunk(xHead: number, z: number, dir: number, y: number)
		bunkNo += 1
		local xFoot = xHead + dir * BUNK_L
		api.box("BunkHead", Vector3.new(0.3, 6.2, BUNK_W), Vector3.new(xHead + dir * 0.15, y + 3.1, z), col.Metal, Enum.Material.Metal)
		for _, s in ipairs({ -1, 1 }) do
			api.box("BunkPost", Vector3.new(0.3, 6.2, 0.3), Vector3.new(xFoot - dir * 0.15, y + 3.1, z + s * (BUNK_W * 0.5 - 0.15)), col.Metal, Enum.Material.Metal, false)
		end
		local mx = xHead + dir * (0.3 + (BUNK_L - 0.3) * 0.5)
		for _, dy in ipairs({ 1.3, 4.4 }) do
			api.box("BunkMattress", Vector3.new(BUNK_L - 0.3, 0.6, BUNK_W - 0.1), Vector3.new(mx, y + dy, z), col.Rug, Enum.Material.Fabric)
		end
		api.box("BunkPillow", Vector3.new(0.9, 0.25, BUNK_W - 0.7), Vector3.new(xHead + dir * 0.85, y + 4.4 + 0.43, z), pillowCol, Enum.Material.Fabric, false)
		local fl = api.box("Footlocker", Vector3.new(1.0, 1.0, 2.1), Vector3.new(xFoot + dir * 0.6, y + 0.5, z), col.Trim, Enum.Material.Wood)
		api.surfaceText(fl, if dir > 0 then Enum.NormalId.Right else Enum.NormalId.Left, { string.format("B-%02d", bunkNo) }, col.Accent, col.Trim, Enum.Font.Code)
	end

	-- Tall wall locker; its door (vents + name tag) faces faceDir (+1 → +X, -1 → -X)
	local function locker(x: number, z: number, faceDir: number, y: number)
		local l = api.box("GearLocker", Vector3.new(1.4, 7, 1.2), Vector3.new(x, y + 3.5, z), col.Locker, Enum.Material.Metal)
		api.surfaceText(l, if faceDir > 0 then Enum.NormalId.Right else Enum.NormalId.Left, { "=====", "=====", "", "", "", "", "", "", "", "", "SQD 1" }, col.Dark, col.Locker, Enum.Font.Code)
	end

	-- ── Ground floor: squad bay ──────────────────────────────────────────────
	local westHead = X0 + 1.0 -- 1 stud off the west wall (clear of the window panes)
	local eastHead = 1.4
	local rows = { 8.9, 5.1 }
	if lv >= 2 then
		table.insert(rows, 1.3)
	end
	for _, z in ipairs(rows) do
		bunk(westHead, z, 1, y1)
		bunk(eastHead, z, -1, y1)
	end
	for i = 1, #rows - 1 do
		local lz = (rows[i] + rows[i + 1]) * 0.5
		locker(westHead + 0.7, lz, 1, y1)
		locker(eastHead - 0.7, lz, -1, y1)
	end
	-- centre-aisle runner (between the footlockers)
	local aisleX = ((westHead + BUNK_L + 1.1) + (eastHead - BUNK_L - 1.1)) * 0.5
	local lastRow = rows[#rows]
	local runZ0, runZ1 = lastRow - 2.4, 10.2
	api.box("AisleRunner", Vector3.new(2.4, 0.06, runZ1 - runZ0), Vector3.new(aisleX, y1 + 0.03, (runZ0 + runZ1) * 0.5), col.Rug, Enum.Material.Fabric, false)
	-- bay stencil on the west wall between the windows
	local bayPlate = api.box("BayPlate", Vector3.new(0.1, 1.4, 5.6), Vector3.new(X0 + 0.05, y1 + 8.6, 0), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(
		bayPlate,
		Enum.NormalId.Right,
		{ if lv >= 4 then "1ST BATTALION · SQUAD BAY" else "1ST PLATOON · SQUAD BAY" },
		if lv >= 5 then col.Gold else col.Accent,
		col.Dark,
		Enum.Font.GothamBlack
	)

	-- ── Recruitment desk (faces the door) → Army ─────────────────────────────
	local deskZ = -1.2
	api.terminal("RecruitTerminal", Vector3.new(9.4, y1, deskZ), 0, "Army", "Recruit soldiers", "Recruitment", { "RECRUITMENT", "ENLIST · TRAIN" })
	local desk = api.box("RecruitDesk", Vector3.new(3.0, 2.6, 1.4), Vector3.new(6.4, y1 + 1.3, deskZ - 0.1), col.Locker, Enum.Material.Metal)
	api.surfaceText(desk, Enum.NormalId.Back, { "", "RECRUITMENT", "" }, if lv >= 5 then col.Gold else col.Accent, col.Locker, Enum.Font.GothamBlack)
	api.box("RecruitDeskTop", Vector3.new(3.3, 0.25, 1.7), Vector3.new(6.4, y1 + 2.72, deskZ - 0.1), col.Dark, Enum.Material.Metal)
	api.chair(Vector3.new(6.4, y1, deskZ - 2.0), Vector3.new(0, 0, 1))
	if lv >= 2 then
		api.box("FlagPole", Vector3.new(0.2, 7.4, 0.2), Vector3.new(3.8, y1 + 3.7, deskZ - 1.8), col.Metal, Enum.Material.Metal, false)
		-- fb2: flag cloths are 0.12 thick and tagged WE_FlagHost (the nation flag binds to their Front / Back faces)
		local cloth = api.box("FlagCloth", Vector3.new(2.6, 1.7, 0.12), Vector3.new(3.8 + 1.4, y1 + 6.4, deskZ - 1.8), col.Flag, Enum.Material.Fabric, false)
		cloth:SetAttribute("WE_FlagHost", true)
	end

	-- ── Duty roster / training terminal on the east wall → Missions ─────────
	local rosterZ = 1.4
	api.terminal("RosterTerminal", Vector3.new(X1 - 0.6, y1, rosterZ), -90, "Missions", "Check duty roster", "Duty Roster · Training", { "DUTY ROSTER", "TRAINING" })
	local board = api.box("RosterBoard", Vector3.new(0.12, 3.2, 5.4), Vector3.new(X1 - 0.06, y1 + 6.6, rosterZ - 0.5), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(board, Enum.NormalId.Left, { "DUTY ROSTER", "0600  PT · DRILL", "0900  RANGE", "1400  PATROL", "2200  LIGHTS OUT" }, col.Screen, boardBg, Enum.Font.Code)

	-- ── Mess table + benches (back-east) ─────────────────────────────────────
	local messX, messZ = 10.5, -7.6
	api.box("MessTable", Vector3.new(6.0, 0.25, 2.2), Vector3.new(messX, y1 + 2.6, messZ), col.Trim, Enum.Material.WoodPlanks)
	api.box("MessTrestle", Vector3.new(4.8, 2.47, 0.4), Vector3.new(messX, y1 + 1.235, messZ), col.Metal, Enum.Material.Metal, false)
	for _, bz in ipairs({ -1.95, 1.95 }) do
		api.box("MessBench", Vector3.new(6.0, 0.3, 0.9), Vector3.new(messX, y1 + 1.55, messZ + bz), col.Trim, Enum.Material.WoodPlanks)
		api.box("MessBenchLeg", Vector3.new(4.6, 1.4, 0.2), Vector3.new(messX, y1 + 0.7, messZ + bz), col.Metal, Enum.Material.Metal, false)
	end

	-- Rifle rack on the east wall (back corner) from L2
	if lv >= 2 then
		api.box("RifleRack", Vector3.new(0.6, 4.2, 2.4), Vector3.new(X1 - 0.3, y1 + 2.1, Z0 + 1.6), col.Dark, Enum.Material.Metal)
		for i = 0, 1 do
			api.box("RackRifle", Vector3.new(0.25, 3.2, 0.25), Vector3.new(X1 - 0.75, y1 + 2.2, Z0 + 1.1 + i * 1.0), col.Metal, Enum.Material.Metal, false)
		end
	end

	-- Recruit intake: a storage bench along the bay edge, west of the doorway
	local bench = api.box("RecruitBench", Vector3.new(1.0, 1.6, 4.6), Vector3.new(eastHead + 0.75, y1 + 0.8, 6.9), col.Trim, Enum.Material.WoodPlanks)
	api.surfaceText(bench, Enum.NormalId.Right, { "NEW RECRUITS · WAIT HERE" }, col.Accent, col.Trim, Enum.Font.Code)

	-- PT corner + kit shelves along the back wall until the stairs go in (L1–L2)
	if not ictx.TwoStory then
		api.box("PTMat", Vector3.new(8.0, 0.1, 4.4), Vector3.new(-6.0, y1 + 0.05, -6.6), Color3.fromRGB(40, 44, 40), Enum.Material.SmoothPlastic, false)
		for _, px in ipairs({ -8.0, -4.0 }) do
			api.box("PullUpPost", Vector3.new(0.3, 7.0, 0.3), Vector3.new(px, y1 + 3.5, -8.2), col.Metal, Enum.Material.Metal)
		end
		api.box("PullUpBar", Vector3.new(3.7, 0.2, 0.2), Vector3.new(-6.0, y1 + 6.8, -8.2), col.Metal, Enum.Material.Metal, false)
		api.box("WeightBench", Vector3.new(3.4, 1.1, 1.2), Vector3.new(-6.0, y1 + 0.55, -5.4), col.Dark, Enum.Material.Fabric)
		local ks = api.box("KitShelf", Vector3.new(2.6, 7.0, 1.2), Vector3.new(X0 + 1.5, y1 + 3.5, Z0 + 0.6), col.Locker, Enum.Material.Metal)
		api.surfaceText(ks, Enum.NormalId.Back, KIT_LINES, col.Dark, col.Locker, Enum.Font.Code)
		api.box("SupplyCrate", Vector3.new(2.2, 1.6, 1.8), Vector3.new(4.0, y1 + 0.8, Z0 + 1.1), col.Trim, Enum.Material.WoodPlanks)
		api.box("SupplyCrate", Vector3.new(1.8, 1.4, 1.6), Vector3.new(4.0, y1 + 2.3, Z0 + 1.1), col.Trim, Enum.Material.WoodPlanks)
	end

	-- ── Upper floor (L3+) ───────────────────────────────────────────────────
	if ictx.TwoStory then
		local y2 = ictx.Y2
		bunk(westHead, 8.9, 1, y2)
		bunk(eastHead, 8.9, -1, y2)
		locker(westHead + 0.7, 7.0, 1, y2)
		if lv >= 4 then
			bunk(westHead, 5.1, 1, y2)
		end
		-- PT corner (moved up from the ground floor when the stairs went in)
		api.box("PTMat", Vector3.new(8.0, 0.1, 4.4), Vector3.new(-9.0, y2 + 0.05, -3.4), Color3.fromRGB(40, 44, 40), Enum.Material.SmoothPlastic, false)
		api.box("WeightBench", Vector3.new(1.2, 1.1, 3.4), Vector3.new(-9.0, y2 + 0.55, -3.4), col.Dark, Enum.Material.Fabric)

		-- Kit shelves on the front wall between the windows
		local ks = api.box("KitShelf", Vector3.new(2.4, 7.0, 1.2), Vector3.new(6.5, y2 + 3.5, Z1 - 0.6), col.Locker, Enum.Material.Metal)
		api.surfaceText(ks, Enum.NormalId.Front, KIT_LINES, col.Dark, col.Locker, Enum.Font.Code)

		-- Washroom behind a partition in the back-east corner
		api.box("WashPartition", Vector3.new(0.3, 7.0, 2.8), Vector3.new(9.0, y2 + 3.5, -8.8), col.Wall, Enum.Material.Concrete)
		local wp = api.box("WashPartition", Vector3.new(3.6, 7.0, 0.3), Vector3.new(X1 - 1.8, y2 + 3.5, -4.9), col.Wall, Enum.Material.Concrete)
		api.surfaceText(wp, Enum.NormalId.Back, { "WASHROOM" }, col.Dark, col.Wall, Enum.Font.GothamBlack)
		api.box("SinkCounter", Vector3.new(1.4, 2.8, 4.4), Vector3.new(X1 - 0.7, y2 + 1.4, -8.4), col.Metal, Enum.Material.Metal)
		local mirror = api.box("Mirror", Vector3.new(0.1, 1.8, 3.8), Vector3.new(X1 - 0.05, y2 + 4.6, -8.4), col.Glass, Enum.Material.Glass, false)
		mirror.Reflectance = 0.3

		-- Officer's desk (front-east corner); the desk top opens the Army panel
		local odX, odZ = 9.8, 6.0
		api.box("OfficerDesk", Vector3.new(1.4, 2.6, 3.6), Vector3.new(odX, y2 + 1.3, odZ), col.Trim, Enum.Material.Wood)
		local odTop = api.box("OfficerDeskTop", Vector3.new(1.8, 0.25, 4.0), Vector3.new(odX, y2 + 2.72, odZ), col.Dark, Enum.Material.Wood)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "WE_PanelPrompt"
		prompt.ActionText = "Review troops"
		prompt.ObjectText = "Officer's Desk"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12 -- mobile P1-19 (was 8)
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.F
		prompt:SetAttribute("WE_OpenPanel", "Army")
		prompt.Parent = odTop
		-- officer's armchair (upholstered base + high back), facing the room
		api.box("OfficerChair", Vector3.new(1.6, 1.8, 1.6), Vector3.new(odX + 1.9, y2 + 0.9, odZ), col.Dark, Enum.Material.Fabric)
		api.box("OfficerChairBack", Vector3.new(0.35, 2.2, 1.6), Vector3.new(odX + 2.55, y2 + 2.9, odZ), col.Dark, Enum.Material.Fabric, false)
		-- half-height wood partition closing the office off from the landing hall (open on its west end)
		local partX0 = 4.2
		local part = api.box("OfficePartition", Vector3.new(X1 - partX0, 3.0, 0.3), Vector3.new((X1 + partX0) * 0.5, y2 + 1.5, 1.4), col.Trim, Enum.Material.Wood)
		api.surfaceText(part, Enum.NormalId.Front, { "", "OFFICER COMMANDING", "" }, col.Accent, col.Trim, Enum.Font.GothamBlack)
		local map = api.box("MapBoard", Vector3.new(0.12, 3.4, 5.6), Vector3.new(X1 - 0.06, y2 + 5.0, odZ), col.Dark, Enum.Material.Metal, false)
		api.surfaceText(map, Enum.NormalId.Left, { "SECTOR MAP", "◆ HQ    ◇ OUTPOST", "ALL SQUADS READY" }, col.Accent, Color3.fromRGB(46, 58, 40), Enum.Font.GothamBold)
		if lv >= 4 then
			api.box("FilingCabinet", Vector3.new(1.4, 3.8, 1.3), Vector3.new(X1 - 0.8, y2 + 1.9, Z1 - 0.8), col.Metal, Enum.Material.Metal)
			-- flag in the office corner by the partition, cloth hanging toward the room (clear of the map)
			api.box("OfficerFlagPole", Vector3.new(0.2, 7.2, 0.2), Vector3.new(X1 - 1.6, y2 + 3.6, 2.2), col.Metal, Enum.Material.Metal, false)
			-- fb2: 0.12 thick + WE_FlagHost (nation flag on the Front / Back faces)
			local officerFlag = api.box("OfficerFlag", Vector3.new(2.4, 1.7, 0.12), Vector3.new(X1 - 1.6 - 1.3, y2 + 6.2, 2.2), col.Flag, Enum.Material.Fabric, false)
			officerFlag:SetAttribute("WE_FlagHost", true)
		end
		if lv >= 5 then
			api.box("OfficerRug", Vector3.new(5.0, 0.06, 6.0), Vector3.new(odX + 0.8, y2 + 0.03, odZ), col.Rug, Enum.Material.Fabric, false)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="172">
            <Properties>
              <string name="Name">CommandCenter</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Command Center interior (HollowBuildingBuilder). Ground floor: command desk with three monitors, map table
	(opens the Base Upgrades menu), intel terminal (Missions), Missile Command terminal (Missiles), lockers, radio
	rack, wall screen. Upper floor (two storeys): strategy table, war-council terminal (Rebirth), bunk, weapon
	rack. The upgrade console stands inside by the door (BaseLayoutConfig).

	Layout (building-local, +Z = front/door): stairs run along the back wall from L3, so the west desk starts
	at z -1 to leave the foot of the stairs open. The east wall carries the annex doorway from L2 (z -5..-1).
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local y1, y2 = ictx.Y1, ictx.Y2
	local X0, X1, Z0, Z1 = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local doorX = ictx.DoorX

	-- Command desk + monitors along the west wall (z -1..5, clear of the stair foot)
	local deskX = X0 + 1.3
	local deskZ = 2
	api.box("Desk", Vector3.new(2.2, 2.8, 6), Vector3.new(deskX, y1 + 1.4, deskZ), col.Dark, Enum.Material.Metal)
	api.box("DeskTop", Vector3.new(2.8, 0.3, 6.2), Vector3.new(deskX + 0.2, y1 + 2.95, deskZ), col.Metal, Enum.Material.Metal)
	local screenLines = {
		{ "SITREP", "ALL SECTORS", "GREEN" },
		{ "RADAR", "◆  ◇  ◆", "SWEEP" },
		{ "INTEL", "OUTPOSTS", "CONTESTED" },
	}
	for i, mz in ipairs({ -2, 0, 2 }) do
		local mon = api.box("Monitor", Vector3.new(0.25, 1.6, 1.9), Vector3.new(deskX - 0.5, y1 + 3.9, deskZ + mz), col.Dark, Enum.Material.Metal, false)
		api.surfaceText(mon, Enum.NormalId.Right, screenLines[i], col.Screen, Color3.fromRGB(8, 20, 12), Enum.Font.Code)
	end
	api.chair(Vector3.new(deskX + 2.4, y1, deskZ - 1), Vector3.new(-1, 0, 0))
	api.chair(Vector3.new(deskX + 2.4, y1, deskZ + 1.4), Vector3.new(-1, 0, 0))

	-- Map table (centre) — its prompt opens the Base Upgrades menu
	local mapX = -0.4
	api.box("MapTableBase", Vector3.new(6, 2.6, 3.6), Vector3.new(mapX, y1 + 1.3, 1.5), col.Dark, Enum.Material.Metal)
	local mapTop = api.box("MapTable", Vector3.new(6.6, 0.25, 4.2), Vector3.new(mapX, y1 + 2.72, 1.5), col.Trim, Enum.Material.Metal)
	do
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_MapSurface"
		sg.Face = Enum.NormalId.Top
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = mapTop
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.fromRGB(60, 78, 52)
		bg.BorderSizePixel = 0
		bg.Parent = sg
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromScale(0.3, 0.3)
		grid.CellPadding = UDim2.fromScale(0.033, 0.033)
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
		grid.VerticalAlignment = Enum.VerticalAlignment.Center
		grid.Parent = bg
		local cells = { "N", "", "OIL", "", "HQ", "", "FORT", "", "S" }
		for i, label in ipairs(cells) do
			local cell = Instance.new("TextLabel")
			cell.LayoutOrder = i
			cell.BackgroundColor3 = if label == "HQ" then col.Accent else Color3.fromRGB(96, 120, 78)
			cell.BorderSizePixel = 0
			cell.Font = Enum.Font.GothamBold
			cell.Text = label
			cell.TextScaled = true
			cell.TextColor3 = if label == "HQ" then col.Dark else Color3.fromRGB(230, 235, 220)
			cell.Parent = bg
		end
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WE_PanelPrompt"
	prompt.ActionText = "Plan upgrades"
	prompt.ObjectText = "Base Upgrades"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12 -- mobile P1-19 (was 8)
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt:SetAttribute("WE_OpenPanel", "Base")
	prompt.Parent = mapTop

	-- Intel terminal on the east wall (between the annex doorway and the console) → Missions
	api.terminal("IntelTerminal", Vector3.new(X1 - 0.6, y1, 1.6), -90, "Missions", "Open briefings", "Intel · Missions", { "INTEL", "MISSIONS" })

	-- Missile Command terminal on the west wall, between the command desk and the foot of the stairs → Missiles
	api.terminal("MissileTerminal", Vector3.new(X0 + 0.6, y1, -2.4), 90, "Missiles", "Missile Command", "Missile Command", { "MISSILE", "COMMAND" })

	-- Door runner (inside the front wall)
	api.box("Runner", Vector3.new(3.4, 0.06, 7), Vector3.new(doorX, y1 + 0.03, Z1 - 3.7), col.Rug, Enum.Material.Fabric, false)

	-- Lockers in the front-west corner
	for i = 0, 1 do
		local lz = Z1 - 1.0 - i * 1.7
		api.box("Locker", Vector3.new(1.4, 7, 1.6), Vector3.new(X0 + 0.7, y1 + 3.5, lz), col.Locker, Enum.Material.Metal)
		api.box("LockerSeam", Vector3.new(0.1, 6.4, 0.08), Vector3.new(X0 + 1.42, y1 + 3.5, lz), col.Dark, Enum.Material.Metal, false)
	end

	-- Radio rack in the back-east corner
	api.box("RadioRack", Vector3.new(2, 5, 1.4), Vector3.new(X1 - 1.2, y1 + 2.5, Z0 + 0.7), col.Dark, Enum.Material.Metal)
	for i = 0, 2 do
		api.box("RackLed", Vector3.new(0.3, 0.3, 0.1), Vector3.new(X1 - 1.6 + i * 0.4, y1 + 3.8, Z0 + 1.45), if i == 1 then col.Accent else col.Screen, Enum.Material.Neon, false)
	end

	-- Wall screen on the east wall, above the intel terminal and the console
	local wallScreen = api.box("WallScreen", Vector3.new(0.2, 4, 7), Vector3.new(X1 - 0.1, y1 + 6.9, 4.7), col.Dark, Enum.Material.Metal, false)
	api.surfaceText(wallScreen, Enum.NormalId.Left, { "WAR EMPIRE · HQ", "LEVEL " .. tostring(ictx.Level), "BUILD. CONQUER. DOMINATE." }, col.Accent, Color3.fromRGB(10, 14, 12), Enum.Font.GothamBold)

	-- Upper floor
	if ictx.TwoStory then
		api.box("StrategyTable", Vector3.new(7, 2.6, 3.2), Vector3.new(2, y2 + 1.3, 3), col.Dark, Enum.Material.Metal)
		api.box("StrategyTop", Vector3.new(7.4, 0.25, 3.6), Vector3.new(2, y2 + 2.72, 3), col.Trim, Enum.Material.Metal)
		for _, cx in ipairs({ -0.5, 2, 4.5 }) do
			api.chair(Vector3.new(cx, y2, 0.3), Vector3.new(0, 0, 1))
		end
		-- War council terminal against the front wall, between two windows → Rebirth / prestige
		api.terminal("CouncilTerminal", Vector3.new(2.5, y2, Z1 - 0.6), 180, "Rebirth", "Rebirth", "War Council · Rebirth", { "WAR COUNCIL", "REBIRTH" })

		-- Bunk against the west wall (between the west and front windows) + footlocker
		local bx = X0 + 1.2
		local bz = 4
		api.box("Bunk", Vector3.new(2.4, 0.5, 3), Vector3.new(bx, y2 + 1.2, bz), col.Locker, Enum.Material.Metal)
		api.box("Bunk", Vector3.new(2.4, 0.5, 3), Vector3.new(bx, y2 + 4.0, bz), col.Locker, Enum.Material.Metal)
		api.box("BunkPost", Vector3.new(0.3, 4.5, 0.3), Vector3.new(bx + 1.05, y2 + 2.25, bz + 1.35), col.Metal, Enum.Material.Metal, false)
		api.box("BunkPost", Vector3.new(0.3, 4.5, 0.3), Vector3.new(bx + 1.05, y2 + 2.25, bz - 1.35), col.Metal, Enum.Material.Metal, false)
		api.box("Mattress", Vector3.new(2.2, 0.3, 2.8), Vector3.new(bx, y2 + 1.6, bz), col.Rug, Enum.Material.Fabric, false)
		api.box("Mattress", Vector3.new(2.2, 0.3, 2.8), Vector3.new(bx, y2 + 4.4, bz), col.Rug, Enum.Material.Fabric, false)
		api.box("Footlocker", Vector3.new(1.4, 1.1, 2.4), Vector3.new(bx + 2.2, y2 + 0.55, bz), col.Locker, Enum.Material.Metal)

		-- Weapon rack on the east wall (south of the east window)
		api.box("WeaponRack", Vector3.new(0.6, 4, 4), Vector3.new(X1 - 0.4, y2 + 2, 4.5), col.Dark, Enum.Material.Metal)
		for i = 0, 3 do
			api.box("RackRifle", Vector3.new(0.3, 3.2, 0.3), Vector3.new(X1 - 0.9, y2 + 2.1, 3 + i * 1.0), col.Metal, Enum.Material.Metal, false)
		end
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="173">
            <Properties>
              <string name="Name">ResearchLab</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Research Lab interior (HollowBuildingBuilder). Four research terminals open the Research panel
	(ResearchController) on their own tab via the prompt attribute WE_OpenTab.

	Ground floor (30 x 22, door X 6..12 on the front wall, console at (12.5, 7)):
	  • Lobby: door runner only; the main aisle Z -4.5..-1.0 runs the width of the room and stays empty
	    (from L3 it leads to the foot of the stairs at the west end).
	  • Weapons bay (east): Weapons terminal between the east windows under a BALLISTICS sign, a ballistics bench
	    (rifle in a test vise, two chronograph units, gel block) firing into a steel bullet trap with an angled
	    deflector plate in the back-east corner. Ammo crates from L2, a rack of prototype rifles from L4.
	  • Bio-armor clean room (front-west): glass partitions on metal kick plates with a hazard-striped door and a
	    BIO-ARMOR LAB sign; armour mannequin on a plinth, laminar-flow bench, sample fridge, Soldiers terminal.
	  • Prototype test stand (front-middle): plinth with a hazard ring and stanchions, a rail-cannon turret that
	    turns slowly (client spinner), TEST IN PROGRESS sign; a quad-rotor drone hangs above it from L4.
	  • Back strip (L1-L2 only; the stairs take it from L3): server racks between the back windows, cryo freezer,
	    data desk.
	Upper floor (L3+):
	  • Server room (back-east): an L of racks with LEDs under a cable tray; the stair landing stays clear.
	  • Engineering wall (east): Vehicles and Defenses terminals under amber signs, a drafting table.
	  • Director's office (front-west) behind glass: desk, chair, bookshelf, plant; L5 adds a gold plaque and a
	    hologram globe.
	  • Analyst pool (middle): two back-to-back desk pairs with monitors, a whiteboard on the west wall.

	Lights: no ceiling fittings added here (the shell has them). At most two dim accents per level. Neon only for
	LEDs and the L5 globe. Screens are dark with green / amber text. Everything is deterministic.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local UP = CFrame.Angles(0, 0, math.pi * 0.5) -- cylinder axis (local X) → vertical
	local screenBg = Color3.fromRGB(8, 20, 12)
	local amber: Color3 = col.Accent
	local olive: Color3 = col.Locker
	local gunmetal = Color3.fromRGB(52, 58, 62)
	local labWhite = Color3.fromRGB(212, 216, 214)
	local woodCol = Color3.fromRGB(96, 70, 48)
	local ledPalette = { col.Screen, col.Screen, Color3.fromRGB(36, 56, 44), amber, col.Screen, Color3.fromRGB(36, 56, 44) }
	local bookPalette = {
		Color3.fromRGB(120, 40, 36),
		Color3.fromRGB(46, 70, 52),
		Color3.fromRGB(40, 52, 86),
		Color3.fromRGB(176, 150, 96),
		Color3.fromRGB(70, 60, 50),
		Color3.fromRGB(150, 110, 60),
	}

	local function cyl(name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material, collide: boolean?): BasePart
		return api.cylinder(name, Vector3.new(length, dia, dia), cf, color, mat, collide)
	end

	local function glass(name: string, size: Vector3, pos: Vector3, collide: boolean): BasePart
		local g = api.box(name, size, pos, col.Glass, M.Glass, collide)
		g.Transparency = 0.55
		g.Reflectance = 0.04
		g.CastShadow = false
		return g
	end

	-- Stencilled text straight onto a surface (transparent background, lit like paint).
	local function paint(host: BasePart, face: Enum.NormalId, lines: { string }, color: Color3)
		api.surfaceText(host, face, lines, color, col.Dark, Enum.Font.GothamBlack)
		for _, g in ipairs(host:GetChildren()) do
			if g:IsA("SurfaceGui") and g.Face == face then
				g.LightInfluence = 1
				local fr = g:FindFirstChildOfClass("Frame")
				if fr then
					fr.BackgroundTransparency = 1
				end
			end
		end
	end

	-- Alternating bars across a face (hazard stripes).
	local function stripes(host: BasePart, face: Enum.NormalId, n: number, a: Color3, b: Color3)
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_Stripes"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		for i = 0, n - 1 do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.Size = UDim2.fromScale(1 / n, 1)
			f.Position = UDim2.fromScale(i / n, 0)
			f.BackgroundColor3 = if i % 2 == 0 then a else b
			f.Parent = sg
		end
	end

	-- Rows of small coloured blocks painted on a face: book spines, drive-bay LEDs (GUI only, no parts).
	local function rows(host: BasePart, face: Enum.NormalId, nRows: number, perRow: number, palette: { Color3 }, bg: Color3, fill: number, glow: boolean)
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_Rows"
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = if glow then 0 else 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = bg
		frame.BorderSizePixel = 0
		frame.Parent = sg
		for r = 0, nRows - 1 do
			for i = 0, perRow - 1 do
				local k = r * perRow + i
				local h = fill * (0.76 + (k * 7 % 4) * 0.08)
				local item = Instance.new("Frame")
				item.BorderSizePixel = 0
				item.BackgroundColor3 = palette[(k * 5 + r) % #palette + 1]
				item.Size = UDim2.fromScale(0.8 / perRow, h / nRows)
				item.Position = UDim2.fromScale((i + 0.1) / perRow, (r + 0.94 - h) / nRows)
				item.Parent = frame
			end
		end
	end

	-- Two-part seat (upholstered base + back); (fx, fz) = the way the sitter faces.
	local function seat(x: number, y: number, z: number, fx: number, fz: number)
		api.box("Seat", Vector3.new(1.3, 1.5, 1.3), Vector3.new(x, y + 0.75, z), col.Dark, M.Fabric)
		local backSize = if math.abs(fx) > 0.5 then Vector3.new(0.3, 1.9, 1.3) else Vector3.new(1.3, 1.9, 0.3)
		api.box("SeatBack", backSize, Vector3.new(x - fx * 0.5, y + 2.45, z - fz * 0.5), col.Dark, M.Fabric, false)
	end

	-- Research terminals open the Research panel on their own tab (prompt attribute WE_OpenTab).
	local function setTab(body: any, tab: string)
		local pr = if body then body:FindFirstChild("WE_PanelPrompt") else nil
		if pr then
			pr:SetAttribute("WE_OpenTab", tab)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Lobby: runner from the door (the console stands just inside, east of it)
	------------------------------------------------------------------------------------------------
	api.box("Runner", Vector3.new(3.4, 0.06, 6.9), Vector3.new(ictx.DoorX, y1 + 0.03, Z1 - 3.5), col.Rug, M.Fabric, false)

	------------------------------------------------------------------------------------------------
	-- Weapons bay (east): terminal between the east windows, BALLISTICS sign above the window band
	------------------------------------------------------------------------------------------------
	setTab(api.terminal("WeaponsTerminal", Vector3.new(X1 - 0.6, y1, -0.5), -90, "Research", "Research weapons", "Weapons Research", { "WEAPONS R&D", "DAMAGE · RATE · MAGS" }), "Weapons")
	local bSign = api.box("BallisticsSign", Vector3.new(0.1, 1.2, 5.0), Vector3.new(X1 - 0.05, 8.8, -0.5), col.Dark, M.Metal, false)
	api.surfaceText(bSign, Enum.NormalId.Left, { "BALLISTICS" }, amber, col.Dark, Enum.Font.GothamBlack)

	-- Ballistics bench: rifle in a test vise → two chronograph units → gel block, aimed at the bullet trap
	local bx, bz = 9.0, -7.5
	api.box("BallisticsBench", Vector3.new(4.0, 2.9, 1.8), Vector3.new(bx, y1 + 1.45, bz), gunmetal, M.Metal)
	api.box("BenchTop", Vector3.new(4.2, 0.3, 2.0), Vector3.new(bx, y1 + 3.05, bz), col.Metal, M.DiamondPlate)
	local benchTop = y1 + 3.2
	api.box("TestVise", Vector3.new(0.7, 0.55, 0.7), Vector3.new(7.6, benchTop + 0.275, bz), col.Dark, M.Metal, false)
	api.box("TestRifle", Vector3.new(1.3, 0.4, 0.25), Vector3.new(7.75, benchTop + 0.75, bz), col.Dark, M.Metal, false)
	api.box("TestBarrel", Vector3.new(0.9, 0.14, 0.14), Vector3.new(8.85, benchTop + 0.82, bz), col.Metal, M.Metal, false)
	for i, gx in ipairs({ 9.7, 10.15 }) do
		local gate = api.box("ChronoGate", Vector3.new(0.12, 1.1, 1.0), Vector3.new(gx, benchTop + 0.55, bz), col.Dark, M.Metal, false)
		api.surfaceText(gate, Enum.NormalId.Right, { "V" .. tostring(i), if i == 1 then "912" else "907" }, col.Screen, screenBg, Enum.Font.Code)
	end
	local gel = api.box("GelBlock", Vector3.new(0.7, 0.6, 0.6), Vector3.new(10.65, benchTop + 0.3, bz), Color3.fromRGB(255, 140, 50), M.SmoothPlastic, false)
	gel.Transparency = 0.35

	-- Steel bullet trap (back-east corner) + angled deflector plate facing the bench
	local trapX0 = 12.6
	local trap = api.box("BulletTrap", Vector3.new(X1 - 0.05 - trapX0, 3.9, 3.85), Vector3.new((trapX0 + X1 - 0.05) * 0.5, y1 + 1.95, Z0 + 0.05 + 1.925), col.Dark, M.Metal)
	paint(trap, Enum.NormalId.Left, { "BULLET TRAP", "", "" }, amber)
	do
		local run, rise = 1.25, 2.5
		api.part(
			"TrapPlate",
			Vector3.new(math.sqrt(run * run + rise * rise), 0.2, 3.5),
			CFrame.new(trapX0 - run * 0.5, y1 + rise * 0.5 + 0.06, Z0 + 0.05 + 1.925) * CFrame.Angles(0, 0, math.atan2(rise, run)),
			col.Metal,
			M.DiamondPlate,
			false
		)
	end

	if lv >= 2 then
		local c1 = api.box("AmmoCrate", Vector3.new(1.25, 1.3, 1.6), Vector3.new(X1 - 0.675, y1 + 0.65, -5.3), olive, M.Wood)
		paint(c1, Enum.NormalId.Left, { "AMMO" }, amber)
		api.box("AmmoCrate", Vector3.new(1.1, 1.0, 1.3), Vector3.new(X1 - 0.65, y1 + 1.8, -5.35), olive, M.Wood)
	end
	if lv >= 4 then
		-- prototype rifles on a wall board between the terminal and the east window
		api.box("PrototypeRack", Vector3.new(0.2, 3.6, 1.7), Vector3.new(X1 - 0.1, y1 + 2.3, 1.75), col.Dark, M.Metal, false)
		for i = 0, 2 do
			api.box("PrototypeRifle", Vector3.new(0.25, 2.9, 0.22), Vector3.new(X1 - 0.35, y1 + 2.25, 1.2 + i * 0.55), if i == 1 then olive else gunmetal, M.Metal, false)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Bio-armor clean room (front-west): X -14.15..-6.4, Z 1.5..10.15, glass on kick plates, door X -11.6..-8.0
	------------------------------------------------------------------------------------------------
	local crX0, crXE, crZ = X0 + 0.05, -6.4, 1.5
	local gapA, gapB = -11.6, -8.0
	local PH = 8.0 -- partition height (kick 0.8 + glass 6.8 + header 0.4)
	local function kickGlassAlongX(xa: number, xb: number)
		local cx = (xa + xb) * 0.5
		api.box("KickPlate", Vector3.new(xb - xa, 0.8, 0.25), Vector3.new(cx, y1 + 0.4, crZ), col.Metal, M.Metal)
		glass("GlassPartition", Vector3.new(xb - xa, PH - 1.2, 0.15), Vector3.new(cx, y1 + 0.8 + (PH - 1.2) * 0.5, crZ), true)
	end
	kickGlassAlongX(crX0, gapA)
	kickGlassAlongX(gapB, crXE - 0.15)
	do
		local za, zb = crZ + 0.15, Z1 - 0.05
		local cz = (za + zb) * 0.5
		api.box("KickPlate", Vector3.new(0.25, 0.8, zb - za), Vector3.new(crXE, y1 + 0.4, cz), col.Metal, M.Metal)
		glass("GlassPartition", Vector3.new(0.15, PH - 1.2, zb - za), Vector3.new(crXE, y1 + 0.8 + (PH - 1.2) * 0.5, cz), true)
		api.box("PartitionHeader", Vector3.new(0.3, 0.4, zb - za + 0.3), Vector3.new(crXE, y1 + PH - 0.2, cz - 0.15), col.Trim, M.Metal, false)
	end
	api.box("PartitionHeader", Vector3.new(crXE + 0.15 - crX0, 0.4, 0.3), Vector3.new((crX0 + crXE + 0.15) * 0.5, y1 + PH - 0.2, crZ), col.Trim, M.Metal, false)
	local bioSign = api.box("BioArmorSign", Vector3.new(gapB - gapA, 1.0, 0.2), Vector3.new((gapA + gapB) * 0.5, y1 + PH + 0.5, crZ), col.Dark, M.Metal, false)
	api.surfaceText(bioSign, Enum.NormalId.Front, { "BIO-ARMOR LAB" }, amber, col.Dark, Enum.Font.GothamBlack)
	local sill = api.box("HazardThreshold", Vector3.new(gapB - gapA, 0.05, 0.7), Vector3.new((gapA + gapB) * 0.5, y1 + 0.025, crZ), amber, M.SmoothPlastic, false)
	stripes(sill, Enum.NormalId.Top, 12, amber, col.Dark)

	-- Armour mannequin on a plinth, facing the lab (visible through the glass from the door)
	do
		local mx, mz = -10.4, 6.3
		cyl("MannequinPlinth", 0.5, 2.2, CFrame.new(mx, y1 + 0.25, mz) * UP, col.Metal, M.Metal, true)
		local base = y1 + 0.5
		api.box("MannequinLegs", Vector3.new(0.6, 2.6, 1.0), Vector3.new(mx, base + 1.3, mz), col.Dark, M.Fabric, false)
		api.box("MannequinTorso", Vector3.new(0.8, 1.9, 1.7), Vector3.new(mx, base + 3.55, mz), col.Rug, M.Fabric, false)
		api.box("PlateCarrier", Vector3.new(1.1, 1.4, 1.5), Vector3.new(mx, base + 3.45, mz), olive, M.Fabric, false)
		api.ball("ArmorHelmet", 1.15, Vector3.new(mx, base + 5.05, mz), olive, M.SmoothPlastic, false)
		local visor = api.box("HelmetVisor", Vector3.new(0.14, 0.38, 0.85), Vector3.new(mx + 0.52, base + 4.95, mz), amber, M.SmoothPlastic, false)
		visor.Transparency = 0.2
	end

	-- Laminar-flow bench against the east partition (clear of the front-window band)
	do
		local lx, lz = -7.3, 7.0
		api.box("LaminarCabinet", Vector3.new(1.3, 2.9, 3.2), Vector3.new(lx, y1 + 1.45, lz), labWhite, M.Metal)
		glass("LaminarSash", Vector3.new(1.3, 2.3, 3.0), Vector3.new(lx, y1 + 2.9 + 1.15, lz), false)
		local hood = api.box("LaminarHood", Vector3.new(1.3, 1.1, 3.2), Vector3.new(lx, y1 + 5.2 + 0.55, lz), labWhite, M.Metal, false)
		api.surfaceText(hood, Enum.NormalId.Left, { "LAMINAR FLOW" }, col.Screen, screenBg, Enum.Font.Code)
		api.light(hood, 8, 0.5, Color3.fromRGB(210, 232, 255)) -- accent 1/2 (ground floor)
	end

	-- Sample fridge in the front-west corner
	local fridge = api.box("SampleFridge", Vector3.new(1.5, 3.5, 1.5), Vector3.new(X0 + 0.8, y1 + 1.75, Z1 - 0.8), labWhite, M.Metal)
	api.surfaceText(fridge, Enum.NormalId.Right, { "BIO SAMPLES", "+4 C" }, col.Screen, screenBg, Enum.Font.Code)

	setTab(api.terminal("SoldierTerminal", Vector3.new(-7.3, y1, 3.6), -90, "Research", "Research soldiers", "Soldier Research", { "SOLDIER R&D", "ARMOR · TRAINING" }), "Soldiers")

	------------------------------------------------------------------------------------------------
	-- Prototype test stand (front-middle): plinth, hazard ring, stanchions, turning rail-cannon turret
	------------------------------------------------------------------------------------------------
	local sx, sz = -0.5, 5.0
	cyl("HazardRing", 0.06, 6.3, CFrame.new(sx, y1 + 0.03, sz) * UP, amber, M.SmoothPlastic, false)
	cyl("TestPlinth", 1.0, 5.5, CFrame.new(sx, y1 + 0.5, sz) * UP, col.Metal, M.Concrete, true)
	for _, ox in ipairs({ -1, 1 }) do
		for _, oz in ipairs({ -1, 1 }) do
			api.box("Stanchion", Vector3.new(0.25, 2.6, 0.25), Vector3.new(sx + ox * 2.45, y1 + 1.3, sz + oz * 2.45), amber, M.SmoothPlastic, false)
		end
	end
	do
		local pivot = Vector3.new(sx, y1 + 1.0, sz)
		local aim = CFrame.lookAt(pivot, pivot + Vector3.new(9.5, 0, 5)) -- muzzle (-Z) toward the doorway
		local gun: { BasePart } = {}
		table.insert(gun, cyl("TurretRing", 0.4, 3.6, aim * CFrame.new(0, 0.2, 0) * UP, gunmetal, M.Metal, false))
		table.insert(gun, api.part("TurretHousing", Vector3.new(2.2, 1.6, 2.4), aim * CFrame.new(0, 1.2, 0.4), gunmetal, M.Metal, false))
		table.insert(gun, api.part("TurretPlates", Vector3.new(2.6, 1.0, 1.8), aim * CFrame.new(0, 1.2, 0.3), olive, M.Metal, false))
		for _, s in ipairs({ -1, 1 }) do
			table.insert(gun, api.part("RailBarrel", Vector3.new(0.28, 0.34, 4.4), aim * CFrame.new(s * 0.34, 1.45, -2.3), gunmetal, M.Metal, false))
		end
		table.insert(gun, cyl("RailCoil", 0.8, 1.2, aim * CFrame.new(0, 1.45, -1.5) * CFrame.Angles(0, math.pi * 0.5, 0), amber, M.Metal, false))
		api.spin(gun, pivot, 3)
	end
	local testSign = api.box("TestSign", Vector3.new(0.15, 1.5, 2.0), Vector3.new(3.4, y1 + 0.75, 7.6), amber, M.SmoothPlastic, false)
	api.surfaceText(testSign, Enum.NormalId.Right, { "TEST IN", "PROGRESS" }, col.Dark, amber, Enum.Font.GothamBlack)

	if lv >= 4 then
		-- quad-rotor drone on two cables above the stand (clear of the ceiling lamps)
		local dxc, dzc, dy = sx, sz + 0.6, 9.3
		api.box("DroneArm", Vector3.new(3.0, 0.15, 0.2), Vector3.new(dxc, dy, dzc), gunmetal, M.Metal, false)
		api.box("DroneArm", Vector3.new(0.5, 0.5, 3.0), Vector3.new(dxc, dy - 0.15, dzc), olive, M.Metal, false)
		for _, o in ipairs({ Vector3.new(1.4, 0, 0), Vector3.new(-1.4, 0, 0), Vector3.new(0, 0, 1.4), Vector3.new(0, 0, -1.4) }) do
			cyl("DroneRotor", 0.06, 1.1, CFrame.new(dxc + o.X, dy + 0.15, dzc + o.Z) * UP, col.Dark, M.SmoothPlastic, false)
		end
		for _, s in ipairs({ -1, 1 }) do
			local top = 12.3
			api.box("DroneCable", Vector3.new(0.06, top - dy, 0.06), Vector3.new(dxc + s * 0.9, (top + dy) * 0.5, dzc), col.Metal, M.Metal, false)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Back strip (single storey only): server racks between the back windows, cryo freezer, data desk
	------------------------------------------------------------------------------------------------
	if not ictx.TwoStory then
		for _, rx in ipairs({ -4.0, 4.0 }) do
			local rack = api.box("ServerRack", Vector3.new(2.4, 7.0, 1.4), Vector3.new(rx, y1 + 3.5, Z0 + 0.75), col.Dark, M.Metal)
			rows(rack, Enum.NormalId.Back, 12, 6, ledPalette, col.Dark, 0.25, true)
			api.box("RackLed", Vector3.new(0.2, 0.2, 0.1), Vector3.new(rx - 0.8, y1 + 6.5, Z0 + 1.5), col.Screen, M.Neon, false)
			api.box("RackLed", Vector3.new(0.2, 0.2, 0.1), Vector3.new(rx - 0.4, y1 + 6.5, Z0 + 1.5), amber, M.Neon, false)
		end
		local freezer = api.box("CryoFreezer", Vector3.new(2.8, 3.2, 1.3), Vector3.new(X0 + 1.5, y1 + 1.6, Z0 + 0.7), labWhite, M.Metal)
		api.surfaceText(freezer, Enum.NormalId.Back, { "CRYO STORE", "-80 C" }, col.Screen, screenBg, Enum.Font.Code)
		local ddx, ddz = -8.0, -7.0
		api.box("DataDesk", Vector3.new(2.8, 2.6, 1.1), Vector3.new(ddx, y1 + 1.3, ddz), gunmetal, M.Metal)
		api.box("DataDeskTop", Vector3.new(3.2, 0.2, 1.5), Vector3.new(ddx, y1 + 2.7, ddz), col.Metal, M.Metal)
		for i, off in ipairs({ -0.75, 0.75 }) do
			local mon = api.box("DataMonitor", Vector3.new(1.3, 0.9, 0.12), Vector3.new(ddx + off, y1 + 3.3, ddz - 0.35), col.Dark, M.Metal, false)
			api.surfaceText(mon, Enum.NormalId.Back, if i == 1 then { "TEST LOG", "RUN 14 OK" } else { "SAMPLES", "12 / 12" }, col.Screen, screenBg, Enum.Font.Code)
		end
		seat(ddx, y1, ddz + 1.5, 0, -1)
	end

	------------------------------------------------------------------------------------------------
	-- Upper floor (L3+)
	------------------------------------------------------------------------------------------------
	if ictx.TwoStory then
		local y2: number = ictx.Y2

		-- Server room (back-east): L of racks, LEDs, overhead cable tray. X 9..13, Z -9..-3 stays open.
		local eRack = api.box("ServerRack", Vector3.new(1.0, 7.0, 7.0), Vector3.new(X1 - 0.55, y2 + 3.5, -6.5), col.Dark, M.Metal)
		rows(eRack, Enum.NormalId.Left, 12, 12, ledPalette, col.Dark, 0.25, true)
		local bRack = api.box("ServerRack", Vector3.new(2.1, 7.0, 1.05), Vector3.new(12.05, y2 + 3.5, Z0 + 0.575), col.Dark, M.Metal)
		rows(bRack, Enum.NormalId.Back, 12, 4, ledPalette, col.Dark, 0.25, true)
		api.box("RackLed", Vector3.new(0.1, 0.2, 0.2), Vector3.new(X1 - 1.1, y2 + 6.3, -8.4), col.Screen, M.Neon, false)
		api.box("RackLed", Vector3.new(0.1, 0.2, 0.2), Vector3.new(X1 - 1.1, y2 + 6.3, -4.6), amber, M.Neon, false)
		api.box("CableTray", Vector3.new(1.0, 0.15, 7.4), Vector3.new(X1 - 0.6, y2 + 8.2, -6.4), col.Metal, M.Metal, false)

		-- Engineering & defense wall (east): two terminals under amber signs, drafting table
		setTab(api.terminal("VehicleTerminal", Vector3.new(X1 - 0.6, y2, 4.6), -90, "Research", "Research vehicles", "Vehicle Engineering", { "VEHICLE ENG.", "SPEED · ARMOR" }), "Vehicles")
		setTab(api.terminal("DefenseTerminal", Vector3.new(X1 - 0.6, y2, 8.2), -90, "Research", "Research defenses", "Defense Systems", { "DEFENSE SYSTEMS", "GUARDS · GUNS" }), "Defenses")
		local function engSign(z: number, text: string)
			local s = api.box("EngineeringSign", Vector3.new(0.1, 1.2, 3.2), Vector3.new(X1 - 0.05, 20.75, z), col.Dark, M.Metal, false)
			api.surfaceText(s, Enum.NormalId.Left, { text }, amber, col.Dark, Enum.Font.GothamBlack)
		end
		engSign(4.6, "VEHICLE ENGINEERING")
		engSign(8.2, "DEFENSE SYSTEMS")
		api.box("DraftingStand", Vector3.new(0.6, 2.3, 1.6), Vector3.new(7.5, y2 + 1.15, 2.25), gunmetal, M.Metal)
		local board = api.part("DraftingBoard", Vector3.new(3.0, 0.12, 2.3), CFrame.new(7.5, y2 + 2.55, 2.25) * CFrame.Angles(math.rad(20), 0, 0), labWhite, M.SmoothPlastic)
		api.surfaceText(
			board,
			Enum.NormalId.Top,
			{ "APC-7  SIDE ELEVATION", "[==][========][==]", "(O)    (O)    (O)", "SCALE 1:20" },
			Color3.fromRGB(215, 232, 255),
			Color3.fromRGB(30, 60, 104),
			Enum.Font.Code
		)

		-- Director's office (front-west) behind glass; door gap Z 4.4..7.8 in the east partition
		local oX0, oXE, oZS = X0 + 0.05, -6.4, 3.5
		local oGap0, oGap1 = 4.4, 7.8
		local GH = 7.6
		glass("OfficeGlass", Vector3.new(oXE - 0.15 - oX0, GH, 0.15), Vector3.new((oX0 + oXE - 0.15) * 0.5, y2 + GH * 0.5, oZS), true)
		glass("OfficeGlass", Vector3.new(0.15, GH, oGap0 - (oZS - 0.075)), Vector3.new(oXE, y2 + GH * 0.5, (oGap0 + oZS - 0.075) * 0.5), true)
		glass("OfficeGlass", Vector3.new(0.15, GH, Z1 - 0.05 - oGap1), Vector3.new(oXE, y2 + GH * 0.5, (Z1 - 0.05 + oGap1) * 0.5), true)
		api.box("OfficeHeader", Vector3.new(oXE + 0.15 - oX0, 0.4, 0.3), Vector3.new((oX0 + oXE + 0.15) * 0.5, y2 + GH + 0.2, oZS), col.Trim, M.Metal, false)
		api.box("OfficeHeader", Vector3.new(0.3, 0.4, Z1 - 0.05 - oZS), Vector3.new(oXE, y2 + GH + 0.2, (Z1 - 0.05 + oZS) * 0.5), col.Trim, M.Metal, false)
		api.box("DirectorDesk", Vector3.new(1.4, 2.5, 2.8), Vector3.new(-9.6, y2 + 1.25, 6.3), woodCol, M.Wood)
		api.box("DirectorDeskTop", Vector3.new(1.9, 0.2, 3.2), Vector3.new(-9.6, y2 + 2.6, 6.3), Color3.fromRGB(62, 44, 30), M.Wood)
		seat(-11.3, y2, 6.3, 1, 0)
		local shelf = api.box("Bookshelf", Vector3.new(0.8, 6.8, 4.0), Vector3.new(X0 + 0.45, y2 + 3.4, 6.0), woodCol, M.Wood)
		rows(shelf, Enum.NormalId.Right, 5, 11, bookPalette, Color3.fromRGB(40, 30, 22), 0.8, false)
		cyl("PlantPot", 1.0, 0.9, CFrame.new(-13.3, y2 + 0.5, 9.3) * UP, gunmetal, M.Metal, true)
		api.ball("Plant", 1.6, Vector3.new(-13.3, y2 + 1.7, 9.3), Color3.fromRGB(62, 104, 52), M.Grass, false)
		if lv >= 5 then
			local plaque = api.box("GoldPlaque", Vector3.new(0.12, 1.1, 3.4), Vector3.new(X0 + 0.06, y2 + 7.6, 6.0), col.Gold, M.Metal, false)
			api.surfaceText(plaque, Enum.NormalId.Right, { "WAR EMPIRE", "ADVANCED RESEARCH" }, col.Dark, col.Gold, Enum.Font.GothamBlack)
			cyl("HoloProjector", 0.15, 0.7, CFrame.new(-9.6, y2 + 2.775, 5.4) * UP, col.Dark, M.Metal, false)
			local globe = api.ball("HoloGlobe", 0.8, Vector3.new(-9.6, y2 + 3.35, 5.4), col.Screen, M.Neon, false)
			globe.Transparency = 0.4
			api.light(globe, 6, 0.4, col.Screen) -- accent 1/2 (upper floor)
		end

		-- Analyst pool (middle): two back-to-back desk pairs, >= 2.8 clear of the stair rail
		for i, cx in ipairs({ -3.1, 1.3 }) do
			local cz = 0.5
			api.box("AnalystDesk", Vector3.new(3.2, 0.2, 2.4), Vector3.new(cx, y2 + 2.6, cz), labWhite, M.SmoothPlastic)
			api.box("AnalystDeskPanel", Vector3.new(3.0, 2.5, 0.15), Vector3.new(cx, y2 + 1.25, cz), gunmetal, M.Metal)
			local mon = api.box("AnalystMonitors", Vector3.new(2.6, 0.95, 0.2), Vector3.new(cx, y2 + 3.175, cz), col.Dark, M.Metal, false)
			api.surfaceText(mon, Enum.NormalId.Front, if i == 1 then { "HIT DATA", "DMG +12%" } else { "SQUAD SIM", "HP 117 / 117" }, col.Screen, screenBg, Enum.Font.Code)
			api.surfaceText(mon, Enum.NormalId.Back, if i == 1 then { "RELOAD", "1.69 s" } else { "ENGINE", "RPM OK" }, amber, screenBg, Enum.Font.Code)
			seat(cx, y2, cz - 1.85, 0, 1)
			seat(cx, y2, cz + 1.85, 0, -1)
		end
		local wb = api.box("Whiteboard", Vector3.new(0.1, 2.6, 2.6), Vector3.new(X0 + 0.05, y2 + 3.6, -3.9), Color3.fromRGB(236, 238, 234), M.SmoothPlastic, false)
		api.surfaceText(wb, Enum.NormalId.Right, { "E = 0.5 m v^2", "F = m a", "ROF x 1.15", "MAG 30 > 42" }, Color3.fromRGB(34, 52, 110), Color3.fromRGB(236, 238, 234), Enum.Font.Code)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="174">
            <Properties>
              <string name="Name">SpecialForces</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Special Forces facility interior (HollowBuildingBuilder, config Interior = "SpecialForces"). Elite operators' HQ:
	dark, tactical, no clutter.

	Ground floor
	  West   ops-briefing area: a large wall screen on the west wall, rows of seats on a rubber mat facing it
	         (2 x 3, 2 x 4 from L2) and the ops-briefing podium terminal (Missions) in the front-west corner.
	  Centre sand table (terrain model with the objective pinned).
	  East   tactical gear wall (vests + helmets on a MOLLE board over a kit bench), the operator terminal (Army)
	         under the roster board, equipment cages in the back-east corner (second cage from L2).
	  Front  night-vision / comms bench between the east front window and the door (NVGs, radios in a charging
	         dock, shelf with a manpack from L2, comms monitor from L4); unit colours between the two windows.
	  Back   L1-L2 only: PT corner (mat, pull-up rig, climbing rope, plyo box) — the stairs take that strip at L3.
	Upper floor (two storeys from L3): a kill house of low plywood partitions — four rooms, walk-through, entry and
	  exit on its east side facing the stair landing — with pop-up targets (2 / 3 / 4 at L3 / L4 / L5), the kill-house
	  terminal (Army) beside the entry, a fast-rope / rappel frame over a crash mat (1 / 2 / 3 ropes) and operator
	  lockers with a bench in the back-east corner (a second bank from L4).

	Layout (building-local, +Z = front/door, door at X = 9): stairs run along the back wall from L3
	(X -13.7..5.5, Z -10.2..-5.7, foot at the west end), so nothing collidable sits at z < -4.7 west of x = 6 from L3
	and the strip in front of the stairs stays open. Tall items stay out of the window bands (front windows only on
	the ground floor; front + side windows upstairs) and the upper landing (x 2.9..8.5, z < -4.5) stays clear.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local N = Enum.NormalId
	local screenBg = Color3.fromRGB(8, 20, 12)

	local function B(name: string, sx: number, sy: number, sz: number, x: number, y: number, z: number, color: Color3, mat: Enum.Material, collide: boolean?): Part
		return api.box(name, Vector3.new(sx, sy, sz), Vector3.new(x, y, z), color, mat, collide)
	end

	-- ── Ops briefing (west wall) ─────────────────────────────────────────────
	local scrZ = 2.5
	B("BriefScreenFrame", 0.1, 5.6, 9.6, X0 + 0.05, y1 + 6.8, scrZ, col.Trim, M.Metal, false)
	local scr = B("BriefScreen", 0.15, 5, 9, X0 + 0.175, y1 + 6.8, scrZ, col.Dark, M.SmoothPlastic, false)
	api.light(scr, 10, 0.5, col.Screen)
	api.surfaceText(scr, N.Right, { "OPS BRIEFING · TIER " .. tostring(lv), "OBJ: RIDGE OUTPOST", "INFIL 0300 · NO COMMS" }, col.Screen, screenBg, Enum.Font.Code)

	-- Briefing podium in the front-west corner, beside the screen → Missions
	api.terminal("BriefingTerminal", Vector3.new(X0 + 0.6, y1, 8.6), 90, "Missions", "Mission briefing", "Ops Room", { "OPS ROOM", "MISSION BRIEFING" })

	-- Seats in two rows facing the screen, on a rubber mat
	B("BriefingMat", 7.4, 0.06, 8.6, -8.0, y1 + 0.03, scrZ, col.Rug, M.Fabric, false)
	local seatZ = if lv >= 2 then { -0.5, 1.5, 3.5, 5.5 } else { 0.5, 2.5, 4.5 }
	for _, rx in ipairs({ -9.4, -6.6 }) do
		for _, sz in ipairs(seatZ) do
			api.chair(Vector3.new(rx, y1, sz), Vector3.new(-1, 0, 0))
		end
	end

	-- ── Sand table (centre) ──────────────────────────────────────────────────
	local stX, stZ = 1.4, -0.4
	B("SandTableBase", 4.6, 2.6, 3.0, stX, y1 + 1.3, stZ, col.Dark, M.Metal)
	B("SandTable", 5.2, 0.3, 3.6, stX, y1 + 2.75, stZ, col.Sandbag, M.SmoothPlastic)
	B("SandRidge", 2.2, 0.5, 1.2, stX - 1.1, y1 + 3.15, stZ - 0.9, col.Rug, M.SmoothPlastic, false)
	B("SandObjective", 0.9, 0.4, 0.9, stX + 1.4, y1 + 3.1, stZ + 0.6, col.Dark, M.SmoothPlastic, false)
	B("SandPin", 0.2, 0.9, 0.2, stX + 1.4, y1 + 3.75, stZ + 0.6, col.Accent, M.SmoothPlastic, false)

	-- ── Tactical gear wall (east wall) ───────────────────────────────────────
	local gz = -3.5
	B("GearBoard", 0.15, 5.2, 6.4, X1 - 0.075, y1 + 4.2, gz, col.Dark, M.Metal, false)
	B("HelmetShelf", 0.9, 0.15, 6.2, X1 - 0.6, y1 + 5.5, gz, col.Metal, M.Metal, false)
	local kitZ = if lv >= 2 then { -5.8, -4.25, -2.7, -1.15 } else { -5.4, -3.5, -1.6 }
	for _, kz in ipairs(kitZ) do
		B("Vest", 0.45, 2.2, 1.4, X1 - 0.375, y1 + 3.6, kz, col.Locker, M.Fabric, false)
		B("Helmet", 0.85, 0.55, 0.85, X1 - 0.6, y1 + 5.85, kz, col.Sandbag, M.SmoothPlastic, false)
	end
	B("KitBench", 1.2, 1.0, 5.8, X1 - 0.6, y1 + 0.5, gz, col.Metal, M.Metal)

	-- ── Operator terminal (east wall) → Army, roster board above it ─────────
	local armyZ = 2.4
	api.terminal("OperatorTerminal", Vector3.new(X1 - 0.6, y1, armyZ), -90, "Army", "Command operators", "Special Forces", { "SF COMMAND", "OPERATORS" })
	local roster = B("RosterBoard", 0.12, 2.8, 4.2, X1 - 0.06, y1 + 6.4, armyZ, col.Dark, M.Metal, false)
	api.surfaceText(roster, N.Left, { "OPERATOR ROSTER", "TEAMS READY: " .. tostring(math.min(lv + 1, 6)), "STATUS: GREEN" }, col.Screen, screenBg, Enum.Font.Code)

	-- ── Equipment cages (back-east corner) ───────────────────────────────────
	local cz1 = Z0 + 3.2
	local cageH = 7
	local bounds: { number } = if lv >= 2 then { 6.4, 10.3, X1 } else { 10.3, X1 }
	local postX: { number } = {}
	for i, bx in ipairs(bounds) do
		local px = if i == 1 then bx + 0.15 elseif i == #bounds then bx - 0.15 else bx
		postX[i] = px
		B("CagePost", 0.3, cageH, 0.3, px, y1 + cageH * 0.5, cz1 - 0.15, col.Metal, M.Metal)
		if i < #bounds then
			local side = B("CageMesh", 0.1, cageH - 0.4, cz1 - Z0 - 0.3, px, y1 + 0.2 + (cageH - 0.4) * 0.5, (Z0 + cz1 - 0.3) * 0.5, col.Metal, M.Metal)
			side.Transparency = 0.5
		end
	end
	for i = 1, #bounds - 1 do
		local a, b = postX[i] + 0.15, postX[i + 1] - 0.15
		local front = B("CageMesh", b - a, cageH - 0.4, 0.1, (a + b) * 0.5, y1 + 0.2 + (cageH - 0.4) * 0.5, cz1 - 0.15, col.Metal, M.Metal)
		front.Transparency = 0.5
	end
	-- contents: ammo crates in the corner cage, kit bags in the second
	B("AmmoCrate", 2.4, 1.3, 1.6, 12.3, y1 + 0.65, Z0 + 1.2, col.Locker, M.Wood)
	B("AmmoCrate", 1.8, 1.0, 1.4, 12.3, y1 + 1.8, Z0 + 1.2, col.Locker, M.Wood)
	if lv >= 2 then
		B("KitBag", 2.6, 1.1, 1.3, 8.4, y1 + 0.55, Z0 + 1.1, col.Rug, M.Fabric)
	end

	-- ── Night-vision / comms bench (front wall, between the window and the door) ──
	local bx = 2.1
	local topY = y1 + 2.9
	B("CommsBench", 5.0, 2.7, 1.4, bx, y1 + 1.35, Z1 - 0.7, col.Dark, M.Metal)
	B("CommsBenchTop", 5.3, 0.2, 1.7, bx, y1 + 2.8, Z1 - 0.85, col.Metal, M.DiamondPlate)
	for i = 1, (if lv >= 2 then 2 else 1) do
		local nx = -0.1 + (i - 1) * 1.2
		B("NVGoggles", 0.9, 0.4, 0.5, nx, topY + 0.2, Z1 - 0.9, col.Dark, M.Metal, false)
		B("NVGLens", 0.7, 0.18, 0.06, nx, topY + 0.2, Z1 - 1.18, col.Screen, M.SmoothPlastic, false) -- v70: painted lens (no decorative Neon)
	end
	for _, rx in ipairs({ 2.15, 3.05 }) do
		B("Radio", 0.55, 1.1, 0.4, rx, topY + 0.55, Z1 - 0.7, col.Locker, M.SmoothPlastic, false)
	end
	local shelf = B("CommsShelf", 5.0, 0.4, 0.9, bx, y1 + 5.6, Z1 - 0.45, col.Metal, M.Metal, false)
	api.surfaceText(shelf, N.Front, { "COMMS · NVG" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	if lv >= 2 then
		B("ManpackRadio", 2.2, 0.9, 0.7, 1.2, y1 + 6.25, Z1 - 0.45, col.Locker, M.SmoothPlastic, false)
	end
	if lv >= 4 then
		local mon = B("CommsMonitor", 1.3, 1.0, 0.12, 4.0, topY + 0.5, Z1 - 0.3, col.Dark, M.Metal, false)
		api.surfaceText(mon, N.Front, { "NET 2", "SECURE" }, col.Screen, screenBg, Enum.Font.Code)
	end

	-- Unit colours between the two front windows
	-- fb2: 0.12 thick (back face still flush on the front wall) + WE_FlagHost; the nation flag binds to the Front face,
	-- which also carries the SPECIAL FORCES text
	local flag = B("UnitFlag", 1.8, 3.2, 0.12, -6.5, y1 + 6.0, Z1 - 0.06, col.Flag, M.Fabric, false)
	flag:SetAttribute("WE_FlagHost", true)
	api.surfaceText(flag, N.Front, if lv >= 5 then { "TIER ONE", "SPECIAL", "FORCES" } else { "SPECIAL", "FORCES" }, col.Sandbag, col.Flag, Enum.Font.GothamBlack)

	-- ── PT corner along the back wall (single storey only; the stairs take this strip from L3) ──
	if not ictx.TwoStory then
		B("PTMat", 10.5, 0.08, 4.4, -7.85, y1 + 0.04, -7.8, col.Rug, M.Fabric, false)
		for _, px in ipairs({ -12.2, -7.8 }) do
			B("PullUpPost", 0.35, 8, 0.35, px, y1 + 4, -9.4, col.Metal, M.Metal)
		end
		B("PullUpBar", 4.75, 0.25, 0.25, -10.0, y1 + 7.6, -9.4, col.Metal, M.Metal, false)
		B("RopeBracket", 1.2, 0.3, 1.2, -3.8, y1 + 11.75, -7.6, col.Metal, M.Metal, false)
		B("ClimbRope", 0.35, 10.8, 0.35, -3.8, y1 + 6.2, -7.6, col.Sandbag, M.Fabric, false)
		B("PlyoBox", 2.0, 1.6, 1.6, 0.4, y1 + 0.8, -8.6, col.Sandbag, M.Wood)
		B("Kettlebell", 0.7, 0.7, 0.7, 2.4, y1 + 0.35, -9.3, col.Dark, M.Metal)
		B("Kettlebell", 0.7, 0.7, 0.7, 3.3, y1 + 0.35, -9.3, col.Dark, M.Metal)
	end

	-- ── Upper floor (L3+) ────────────────────────────────────────────────────
	if ictx.TwoStory then
		local y2: number = ictx.Y2
		local wallH = 4.4

		-- Kill house: low plywood partitions from the west wall to x = KX, north edge NZ to the front wall.
		-- Rooms A (NE) → B (NW) → C (SW) → D (SE); entry and exit doors on the east side, 3 studs wide.
		local KX, SX, NZ, CZ = 1.5, -6.2, -3.8, 3.0
		local function partition(x0: number, x1: number, z0: number, z1: number)
			local sx = math.max(x1 - x0, 0.3)
			local sz = math.max(z1 - z0, 0.3)
			B("KillHouseWall", sx, wallH, sz, (x0 + x1) * 0.5, y2 + wallH * 0.5, (z0 + z1) * 0.5, col.Sandbag, M.WoodPlanks)
		end
		partition(X0, KX, NZ, NZ) -- north
		partition(KX, KX, NZ, -2.4) -- east: entry door z -2.4..0.6
		partition(KX, KX, 0.6, 5.4) -- exit door z 5.4..8.4
		partition(KX, KX, 8.4, Z1)
		partition(SX, SX, NZ, -0.2) -- spine: A→B door z -0.2..2.8
		partition(SX, SX, 2.8, 4.8) -- C→D door z 4.8..7.8
		partition(SX, SX, 7.8, Z1)
		partition(X0, -12.6, CZ, CZ) -- cross: B→C door x -12.6..-9.6
		partition(-9.6, SX, CZ, CZ)
		partition(SX, KX, CZ, CZ)

		-- Pop-up targets (dark = hostile, light = no-shoot), facing each room's entry
		local function target(x: number, z: number, alongX: boolean, c: Color3)
			local bs = if alongX then Vector3.new(0.1, 3.2, 1.1) else Vector3.new(1.1, 3.2, 0.1)
			local hs = if alongX then Vector3.new(0.1, 0.8, 0.7) else Vector3.new(0.7, 0.8, 0.1)
			api.box("Target", bs, Vector3.new(x, y2 + 1.6, z), c, M.Wood)
			api.box("TargetHead", hs, Vector3.new(x, y2 + 3.6, z), c, M.Wood, false)
		end
		target(-4.4, -2.6, true, col.Dark)
		target(-12.0, -2.4, true, col.Dark)
		if lv >= 4 then
			target(-7.6, 8.6, false, col.Floor)
		end
		if lv >= 5 then
			target(-0.2, 4.2, true, col.Dark)
		end

		-- Kill-house control terminal beside the entry → Army
		api.terminal("KillHouseTerminal", Vector3.new(KX + 0.8, y2, 3.0), 90, "Army", "Train operators", "Kill House", { "KILL HOUSE", "ROOM-CLEAR DRILL" })
		-- stack-up line on the floor outside the entry (small hazard stripe)
		B("StackLine", 0.25, 0.04, 3.0, KX + 1.3, y2 + 0.02, -0.9, col.Accent, M.SmoothPlastic, false)
		local khSign = B("KillHouseSign", 0.14, 1.1, 4.4, KX, y2 + wallH + 0.55, 3.0, col.Dark, M.Metal, false)
		api.surfaceText(khSign, N.Right, { "KILL HOUSE", "LIVE DRILL" }, col.Accent, col.Dark, Enum.Font.GothamBlack)
		api.light(khSign, 10, 0.6, Color3.fromRGB(255, 96, 64)) -- dim red "live" glow over the entry

		-- Fast-rope / rappel frame over a crash mat (front-east)
		local RX = 10.5
		B("RappelPost", 0.5, 8.3, 0.5, RX, y2 + 4.15, 4.8, col.Metal, M.Metal)
		B("RappelPost", 0.5, 8.3, 0.5, RX, y2 + 4.15, 9.6, col.Metal, M.Metal)
		B("RappelBeam", 0.5, 0.5, 5.3, RX, y2 + 8.55, 7.2, col.Metal, M.Metal)
		B("CrashMat", 4.2, 0.5, 4.2, RX, y2 + 0.25, 7.2, col.Rug, M.Fabric)
		local ropeZ = if lv >= 5 then { 6.0, 7.2, 8.4 } elseif lv >= 4 then { 6.4, 8.0 } else { 7.2 }
		for _, rz in ipairs(ropeZ) do
			B("Rope", 0.35, 7.8, 0.35, RX, y2 + 4.4, rz, col.Sandbag, M.Fabric, false)
		end
		local rSign = B("RappelSign", 0.1, 1.4, 4.0, X1 - 0.05, y2 + 6.2, 7.2, col.Dark, M.Metal, false)
		api.surfaceText(rSign, N.Left, { "FAST ROPE", "RAPPEL POINT" }, col.Accent, col.Dark, Enum.Font.GothamBlack)

		-- Operator lockers + bench (back-east corner, clear of the landing): a bank of three on the back wall,
		-- a bank of two on the east wall from L4 (one body per bank, dark seams between the doors)
		B("LockerBank", 4.8, 7, 1.6, 11.5, y2 + 3.5, Z0 + 0.8, col.Locker, M.Metal)
		for _, sx in ipairs({ 10.7, 12.3 }) do
			B("LockerSeam", 0.08, 6.6, 0.06, sx, y2 + 3.5, Z0 + 1.63, col.Dark, M.Metal, false)
		end
		if lv >= 4 then
			B("LockerBank", 1.6, 7, 3.0, X1 - 0.8, y2 + 3.5, -6.6, col.Locker, M.Metal)
			B("LockerSeam", 0.06, 6.6, 0.08, X1 - 1.63, y2 + 3.5, -6.6, col.Dark, M.Metal, false)
		end
		B("LockerBench", 2.8, 0.9, 1.0, 10.8, y2 + 0.45, -7.4, col.Trim, M.WoodPlanks)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="175">
            <Properties>
              <string name="Name">VehicleDepot</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Vehicle Depot interior (HollowBuildingBuilder) — the motor pool: one tall single-storey workshop hall.

	Ground floor (36 x 28, 14 tall, garage door X -6..10 on the front wall):
	  • Drive lane: two painted lane lines run from the garage door straight back into Bay 1 (x -2.5..6.5),
	    kept clear of everything solid so a vehicle could roll in.
	  • Bay 1 (L1): four-post vehicle lift carrying a generic six-wheel cargo truck (nose to the door).
	    Bay 2 (L3, west): utility jeep. Bay 3 (L5, east): fuel bowser trailer. Oil stains in the bays.
	  • Overhead bridge crane: runway rails on the side walls + bridge beam over the truck's bonnet
	    (below the ceiling lights); an engine hangs from the hook from L4.
	  • Front-west: motor-pool dispatch desk + dispatch terminal (Garage), status board, filing cabinet.
	  • East wall (between the windows): parts cabinet + requisition terminal (Shop); air compressor (L4).
	  • West wall: workbench + pegboard between the windows (L1), second bench + tool chest (L2).
	  • Back wall: tyre stack between bays 2 and 1, fuel drums in the back-east corner (on a spill pallet from L2).
	The upgrade console stands just inside the door on the east side (BaseLayoutConfig) — kept clear.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0, X1, Z0, Z1 = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local UP = CFrame.Angles(0, 0, math.pi * 0.5) -- cylinder axis (local X) → vertical
	local ALONG_Z = CFrame.Angles(0, math.pi * 0.5, 0) -- cylinder axis (local X) → Z
	local oil = Color3.fromRGB(22, 24, 22)
	local tint = Color3.fromRGB(44, 58, 62)
	local paintWhite = Color3.fromRGB(226, 224, 212)

	local function cyl(name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material, collide: boolean?): any
		local p = api.part(name, Vector3.new(length, dia, dia), cf, color, mat, collide)
		p.Shape = Enum.PartType.Cylinder
		return p
	end

	-- Stencilled text painted straight onto a surface: transparent background, lit like paint.
	local function paint(host: any, face: Enum.NormalId, lines: { string }, color: Color3)
		api.surfaceText(host, face, lines, color, col.Dark, Enum.Font.GothamBlack)
		for _, g in ipairs(host:GetChildren()) do
			if g:IsA("SurfaceGui") and g.Face == face then
				g.LightInfluence = 1
				local fr = g:FindFirstChildOfClass("Frame")
				if fr then
					fr.BackgroundTransparency = 1
				end
			end
		end
	end

	-- Floor paint (thin, walk-over)
	local function line(sx: number, sz: number, x: number, z: number, color: Color3)
		api.box("FloorPaint", Vector3.new(sx, 0.04, sz), Vector3.new(x, y1 + 0.02, z), color, M.SmoothPlastic, false)
	end
	local function floorStencil(x: number, z: number, w: number, lines: { string })
		local p = api.box("FloorStencil", Vector3.new(w, 0.04, 1.8), Vector3.new(x, y1 + 0.03, z), col.Floor, M.SmoothPlastic, false)
		p.Transparency = 1
		paint(p, Enum.NormalId.Top, lines, col.Accent)
	end
	local function stain(x: number, z: number, d: number)
		local p = cyl("OilStain", 0.03, d, CFrame.new(x, y1 + 0.016, z) * UP, oil, M.SmoothPlastic, false)
		p.Transparency = 0.25
	end

	------------------------------------------------------------------------------------------------
	-- Drive lane → Bay 1 (the lane lines continue into the bay), stop bar, stencils, oil
	------------------------------------------------------------------------------------------------
	local laneX0, laneX1 = -2.5, 6.5
	local laneLen = (Z1 - 0.1) - (Z0 + 0.4)
	for _, lx in ipairs({ laneX0, laneX1 }) do
		line(0.3, laneLen, lx, (Z1 - 0.1 + Z0 + 0.4) * 0.5, col.Accent)
	end
	line(laneX1 - laneX0 - 0.3, 0.35, (laneX0 + laneX1) * 0.5, 0.1, paintWhite)
	floorStencil(2, 1.6, 5.5, { "BAY 1" })
	stain(2.2, -3.0, 2.2)
	stain(3.8, 4.2, 1.3)

	------------------------------------------------------------------------------------------------
	-- Four-post vehicle lift (Bay 1) + six-wheel cargo truck on it
	------------------------------------------------------------------------------------------------
	local liftX = 2
	local runZ0, runZ1 = -11.8, -1.2
	local yb = y1 + 2.0 -- runway top = tyre contact
	for _, pz in ipairs({ runZ0 - 0.4, runZ1 + 0.4 }) do
		for _, sx in ipairs({ -1, 1 }) do
			api.box("LiftPost", Vector3.new(0.8, 8.4, 0.8), Vector3.new(liftX + sx * 3.2, y1 + 4.2, pz), col.Metal, M.Metal)
		end
		api.box("LiftBeam", Vector3.new(5.6, 0.6, 0.8), Vector3.new(liftX, yb - 0.3, pz), col.Dark, M.Metal)
	end
	for _, sx in ipairs({ -1, 1 }) do
		api.box("LiftRunway", Vector3.new(1.4, 0.4, runZ1 - runZ0), Vector3.new(liftX + sx * 1.75, yb - 0.2, (runZ0 + runZ1) * 0.5), col.Metal, M.DiamondPlate)
	end
	local ctrl = api.box("LiftControl", Vector3.new(0.3, 1.2, 0.8), Vector3.new(liftX + 3.75, y1 + 4.1, runZ1 + 0.4), col.Dark, M.Metal, false)
	paint(ctrl, Enum.NormalId.Right, { "▲", "▼" }, col.Accent)

	local function truck(cx: number, cz: number, base: number)
		for _, wz in ipairs({ 3.2, -1.9, -4.1 }) do
			for _, sx in ipairs({ -1, 1 }) do
				cyl("TruckTyre", 0.9, 2.2, CFrame.new(cx + sx * 1.75, base + 1.1, cz + wz), col.Dark, M.Fabric, false)
			end
		end
		api.box("TruckChassis", Vector3.new(2.6, 0.6, 9.8), Vector3.new(cx, base + 1.3, cz - 0.1), col.Dark, M.Metal)
		api.box("TruckCab", Vector3.new(4.0, 2.8, 2.4), Vector3.new(cx, base + 3.0, cz + 1.2), col.Trim, M.Metal)
		api.box("TruckCabWindows", Vector3.new(4.06, 0.9, 1.5), Vector3.new(cx, base + 3.8, cz + 1.3), tint, M.Glass, false)
		api.box("TruckWindshield", Vector3.new(3.4, 1.0, 0.1), Vector3.new(cx, base + 3.8, cz + 2.44), tint, M.Glass, false)
		api.box("TruckBonnet", Vector3.new(3.6, 1.5, 2.4), Vector3.new(cx, base + 2.35, cz + 3.6), col.Trim, M.Metal)
		api.box("TruckGrille", Vector3.new(2.2, 1.1, 0.1), Vector3.new(cx, base + 2.3, cz + 4.84), col.Dark, M.Metal, false)
		for _, sx in ipairs({ -1, 1 }) do
			api.box("TruckHeadlight", Vector3.new(0.55, 0.55, 0.1), Vector3.new(cx + sx * 1.45, base + 2.55, cz + 4.84), col.Light, M.Glass, false)
		end
		api.box("TruckBumper", Vector3.new(4.4, 0.5, 0.4), Vector3.new(cx, base + 1.35, cz + 5.0), col.Metal, M.Metal, false)
		api.box("TruckBed", Vector3.new(4.4, 0.8, 5.0), Vector3.new(cx, base + 2.0, cz - 2.6), col.Trim, M.Metal)
		local canvas = api.box("TruckCanvas", Vector3.new(4.3, 2.8, 4.8), Vector3.new(cx, base + 3.8, cz - 2.6), col.Rug, M.Fabric)
		paint(canvas, Enum.NormalId.Left, { "★" }, paintWhite)
		paint(canvas, Enum.NormalId.Right, { "★" }, paintWhite)
	end
	truck(liftX, -6.5, yb)

	------------------------------------------------------------------------------------------------
	-- Overhead bridge crane: wall runways, bridge over the truck bonnet, trolley + hook (engine from L4)
	------------------------------------------------------------------------------------------------
	local craneZ = -2.9
	local craneX = liftX
	for _, sx in ipairs({ -1, 1 }) do
		api.box("CraneRunway", Vector3.new(0.6, 0.6, Z1 - Z0), Vector3.new(sx * (X1 - 0.3), y1 + 11.7, 0), col.Metal, M.Metal, false)
	end
	local bridge = api.box("CraneBridge", Vector3.new(X1 - X0 - 0.2, 0.8, 1.0), Vector3.new(0, y1 + 12.4, craneZ), col.Metal, M.Metal, false)
	paint(bridge, Enum.NormalId.Back, { "SWL 5 T" }, col.Accent)
	api.box("CraneTrolley", Vector3.new(1.6, 0.7, 1.6), Vector3.new(craneX, y1 + 11.65, craneZ), col.Dark, M.Metal, false)
	local hookY = if lv >= 4 then y1 + 8.6 else y1 + 9.2
	api.box("CraneChain", Vector3.new(0.15, y1 + 11.3 - hookY, 0.15), Vector3.new(craneX, (y1 + 11.3 + hookY) * 0.5, craneZ), col.Metal, M.Metal, false)
	api.box("CraneHook", Vector3.new(0.7, 0.9, 0.5), Vector3.new(craneX, hookY - 0.45, craneZ), col.Accent, M.Metal, false)
	if lv >= 4 then
		-- engine swap in progress: the block hangs over the truck's open bonnet
		api.box("HoistedEngine", Vector3.new(2.0, 1.5, 1.8), Vector3.new(craneX, hookY - 1.65, craneZ), col.Dark, M.Metal, false)
	end

	------------------------------------------------------------------------------------------------
	-- Motor-pool dispatch (front-west): desk under the front window, chair, dispatch terminal → Garage
	------------------------------------------------------------------------------------------------
	local deskX = -13.3
	api.box("DispatchDesk", Vector3.new(5.0, 2.6, 1.6), Vector3.new(deskX, y1 + 1.3, Z1 - 0.8), col.Locker, M.Metal)
	api.box("DispatchDeskTop", Vector3.new(5.2, 0.2, 1.8), Vector3.new(deskX, y1 + 2.7, Z1 - 0.9), col.Metal, M.Metal)
	local mon = api.box("DispatchMonitor", Vector3.new(1.9, 1.2, 0.15), Vector3.new(deskX - 0.6, y1 + 3.4, Z1 - 1.0), col.Dark, M.Metal, false)
	api.surfaceText(mon, Enum.NormalId.Front, { "DISPATCH LOG", "TRK-01  LIFT 1", "FUEL  OK" }, col.Screen, Color3.fromRGB(8, 20, 12), Enum.Font.Code)
	api.chair(Vector3.new(deskX, y1, Z1 - 3.2), Vector3.new(0, 0, 1))
	api.terminal("DispatchTerminal", Vector3.new(-8.9, y1, Z1 - 0.6), 180, "Garage", "Open garage", "Motor Pool", { "MOTOR POOL", "DISPATCH" })
	api.box("FilingCabinet", Vector3.new(1.3, 4.0, 1.6), Vector3.new(X0 + 0.65, y1 + 2.0, 9.9), col.Locker, M.Metal)
	local board = api.box("StatusBoard", Vector3.new(0.12, 3.0, 3.8), Vector3.new(X0 + 0.06, y1 + 6.2, 10.9), col.Dark, M.Metal, false)
	api.surfaceText(board, Enum.NormalId.Right, {
		"VEHICLE STATUS",
		"TRK-01   ON LIFT",
		if lv >= 3 then "4X4-02   READY" else "BAY 2    ----",
		if lv >= 5 then "FUEL-03  FUELING" else "BAY 3    ----",
	}, col.Light, Color3.fromRGB(16, 22, 18), Enum.Font.Code)

	------------------------------------------------------------------------------------------------
	-- Parts & fuel counter (east wall, between the windows): requisition terminal → Shop, parts cabinet
	------------------------------------------------------------------------------------------------
	api.terminal("PartsTerminal", Vector3.new(X1 - 0.6, y1, -1.4), -90, "Shop", "Requisition", "Parts & Fuel", { "PARTS & FUEL", "REQUISITION" })
	api.box("PartsCabinet", Vector3.new(1.3, 7.0, 3.2), Vector3.new(X1 - 0.65, y1 + 3.5, 2.0), col.Metal, M.Metal)
	local bank = api.box("PartsDrawers", Vector3.new(0.2, 5.2, 3.0), Vector3.new(X1 - 1.4, y1 + 3.3, 2.0), col.Locker, M.Metal, false)
	paint(bank, Enum.NormalId.Left, { "FILTERS", "BELTS · HOSES", "PLUGS", "TRACK PINS" }, paintWhite)
	local partsSign = api.box("PartsSign", Vector3.new(0.12, 1.8, 6.4), Vector3.new(X1 - 0.06, y1 + 9.2, -0.4), col.Dark, M.Metal, false)
	api.surfaceText(partsSign, Enum.NormalId.Left, { "PARTS & FUEL", "REQUISITION" }, col.Accent, col.Dark, Enum.Font.GothamBlack)

	------------------------------------------------------------------------------------------------
	-- Workbenches along the west wall (pegboards only between / clear of the windows)
	------------------------------------------------------------------------------------------------
	local function bench(z: number, len: number)
		api.box("Workbench", Vector3.new(2.4, 2.4, len), Vector3.new(X0 + 1.2, y1 + 1.2, z), col.Locker, M.Metal)
		api.box("WorkbenchTop", Vector3.new(2.7, 0.25, len + 0.2), Vector3.new(X0 + 1.35, y1 + 2.525, z), col.Metal, M.DiamondPlate)
		api.box("Pegboard", Vector3.new(0.15, 4.0, len), Vector3.new(X0 + 0.075, y1 + 5.2, z), col.Dark, M.Metal, false)
	end
	bench(0, 6.0)
	api.box("BenchVice", Vector3.new(0.9, 0.6, 0.6), Vector3.new(X0 + 2.0, y1 + 2.95, 2.2), col.Metal, M.Metal, false)
	api.box("Wrench", Vector3.new(0.1, 1.8, 0.3), Vector3.new(X0 + 0.2, y1 + 5.6, -1.4), col.Metal, M.Metal, false)
	api.box("Hammer", Vector3.new(0.1, 0.4, 1.2), Vector3.new(X0 + 0.2, y1 + 6.4, 0.6), col.Metal, M.Metal, false)
	if lv >= 2 then
		bench(-11.1, 3.8)
		api.box("ToolChest", Vector3.new(1.3, 3.0, 2.0), Vector3.new(X0 + 0.65, y1 + 1.5, -4.6), col.Locker, M.Metal)
	end

	------------------------------------------------------------------------------------------------
	-- Tyre stack (between bays 2 and 1) and fuel drums (back-east corner)
	------------------------------------------------------------------------------------------------
	for k = 0, 2 do
		cyl("Tyre", 0.8, 2.2, CFrame.new(-3.9, y1 + 0.4 + k * 0.8, Z0 + 1.4) * UP, col.Dark, M.Fabric)
	end
	local drumBase = y1
	if lv >= 2 then
		api.box("SpillPallet", Vector3.new(3.6, 0.3, 3.8), Vector3.new(X1 - 1.8, y1 + 0.15, Z0 + 1.9), col.Dark, M.Metal)
		drumBase = y1 + 0.3
	end
	local drums = { { X1 - 2.7, Z0 + 0.95 }, { X1 - 0.9, Z0 + 0.95 } }
	if lv >= 2 then
		table.insert(drums, { X1 - 2.7, Z0 + 2.85 })
		table.insert(drums, { X1 - 0.9, Z0 + 2.85 })
	end
	for i, d in ipairs(drums) do
		cyl("FuelDrum", 2.8, 1.7, CFrame.new(d[1], drumBase + 1.4, d[2]) * UP, if i % 2 == 0 then col.Trim else col.Locker, M.Metal)
	end

	------------------------------------------------------------------------------------------------
	-- Wall signage
	------------------------------------------------------------------------------------------------
	local sign = api.box("MotorPoolSign", Vector3.new(12, 2.2, 0.15), Vector3.new(liftX, y1 + 10.6, Z0 + 0.075), col.Dark, M.Metal, false)
	api.surfaceText(sign, Enum.NormalId.Back, { "MOTOR POOL", "DEPOT LEVEL " .. tostring(lv) }, col.Accent, col.Dark, Enum.Font.GothamBlack)
	if lv >= 2 then
		local ns = api.box("FuelStoreSign", Vector3.new(3.6, 1.4, 0.12), Vector3.new(X1 - 1.8, y1 + 5.0, Z0 + 0.06), col.Dark, M.Metal, false)
		api.surfaceText(ns, Enum.NormalId.Back, { "FUEL STORE", "NO NAKED FLAMES" }, col.Accent, col.Dark, Enum.Font.GothamBold)
		api.box("Extinguisher", Vector3.new(0.6, 1.4, 0.5), Vector3.new(12.3, y1 + 2.2, Z1 - 0.25), Color3.fromRGB(140, 30, 26), M.SmoothPlastic, false)
	end

	------------------------------------------------------------------------------------------------
	-- L3: Bay 2 (west) — utility jeep
	------------------------------------------------------------------------------------------------
	if lv >= 3 then
		local bx0, bx1 = -12.4, -5.2
		for _, lx in ipairs({ bx0, bx1 }) do
			line(0.3, 12.2, lx, Z0 + 0.4 + 6.1, col.Accent)
		end
		floorStencil((bx0 + bx1) * 0.5, 0.8, 5, { "BAY 2" })
		stain(-8.2, -2.4, 1.8)

		local cx, cz = (bx0 + bx1) * 0.5, -6.8
		for _, wz in ipairs({ 2.3, -2.3 }) do
			for _, sx in ipairs({ -1, 1 }) do
				cyl("JeepTyre", 0.8, 2.0, CFrame.new(cx + sx * 1.7, y1 + 1.0, cz + wz), col.Dark, M.Fabric, false)
			end
		end
		api.box("JeepBody", Vector3.new(3.6, 1.1, 6.6), Vector3.new(cx, y1 + 1.45, cz), col.Locker, M.Metal)
		local hood = api.box("JeepBonnet", Vector3.new(3.4, 0.45, 2.2), Vector3.new(cx, y1 + 2.225, cz + 2.1), col.Locker, M.Metal, false)
		paint(hood, Enum.NormalId.Top, { "★" }, paintWhite)
		local ws = api.box("JeepWindshield", Vector3.new(3.4, 1.3, 0.12), Vector3.new(cx, y1 + 2.65, cz + 0.95), tint, M.Glass, false)
		ws.Transparency = 0.3
		api.box("JeepSeats", Vector3.new(3.0, 1.2, 1.0), Vector3.new(cx, y1 + 2.6, cz - 0.4), col.Dark, M.Fabric, false)
		api.box("JeepGrille", Vector3.new(2.0, 0.8, 0.1), Vector3.new(cx, y1 + 1.5, cz + 3.35), col.Dark, M.Metal, false)
		for _, sx in ipairs({ -1, 1 }) do
			api.box("JeepHeadlight", Vector3.new(0.45, 0.45, 0.1), Vector3.new(cx + sx * 1.35, y1 + 1.65, cz + 3.35), col.Light, M.Glass, false)
		end
		cyl("JeepSpare", 0.7, 1.7, CFrame.new(cx, y1 + 1.9, cz - 3.65) * ALONG_Z, col.Dark, M.Fabric, false)
		api.box("JeepAntenna", Vector3.new(0.1, 4.5, 0.1), Vector3.new(cx + 1.5, y1 + 4.25, cz - 3.0), col.Metal, M.Metal, false)
	end

	------------------------------------------------------------------------------------------------
	-- L4: air compressor (east wall, under the window), mechanic's creeper under the truck
	------------------------------------------------------------------------------------------------
	if lv >= 4 then
		cyl("CompressorTank", 2.6, 1.2, CFrame.new(X1 - 0.8, y1 + 0.9, 5.7) * ALONG_Z, col.Locker, M.Metal)
		api.box("CompressorMotor", Vector3.new(1.0, 0.8, 1.2), Vector3.new(X1 - 0.8, y1 + 1.9, 5.2), col.Dark, M.Metal)
		api.box("Creeper", Vector3.new(1.3, 0.3, 2.8), Vector3.new(liftX, y1 + 0.35, -7.5), col.Locker, M.Metal, false)
	end

	------------------------------------------------------------------------------------------------
	-- L5: Bay 3 (east) — fuel bowser trailer
	------------------------------------------------------------------------------------------------
	if lv >= 5 then
		local bx0, bx1 = 7.6, 13.4
		for _, lx in ipairs({ bx0, bx1 }) do
			line(0.3, 12.2, lx, Z0 + 0.4 + 6.1, col.Accent)
		end
		floorStencil((bx0 + bx1) * 0.5, 0.8, 5, { "BAY 3" })
		stain(10.9, -1.6, 1.6)

		local tx, tz = (bx0 + bx1) * 0.5, -7.0
		cyl("BowserTank", 7.0, 3.0, CFrame.new(tx, y1 + 2.9, tz) * ALONG_Z, col.Locker, M.Metal)
		api.box("BowserChassis", Vector3.new(2.4, 0.5, 7.2), Vector3.new(tx, y1 + 1.15, tz), col.Dark, M.Metal)
		for _, wz in ipairs({ -1.4, -3.3 }) do
			for _, sx in ipairs({ -1, 1 }) do
				cyl("BowserTyre", 0.8, 1.8, CFrame.new(tx + sx * 1.6, y1 + 0.9, tz + wz), col.Dark, M.Fabric, false)
			end
		end
		api.box("BowserDrawbar", Vector3.new(0.4, 0.4, 2.6), Vector3.new(tx, y1 + 1.0, tz + 4.9), col.Metal, M.Metal, false)
		local plac = api.box("BowserPlacard", Vector3.new(0.1, 1.2, 1.8), Vector3.new(tx - 1.55, y1 + 2.9, tz + 1.5), col.Accent, M.SmoothPlastic, false)
		api.surfaceText(plac, Enum.NormalId.Left, { "FUEL" }, col.Dark, col.Accent, Enum.Font.GothamBlack)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="176">
            <Properties>
              <string name="Name">Warehouse</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Warehouse interior (HollowBuildingBuilder): one tall single-storey storage hall (34 x 26, 14 tall), garage door
	X -3..9 on the front wall, upgrade console just inside at (14.5, 9).

	  • Loading bay (X -4..10, Z 6.2..12.2): kept completely clear, outlined in yellow floor paint + LOADING BAY.
	  • Pallet racking: olive uprights, yellow beams, wooden pallet decks at y1+4.2 and y1+8.2, a deterministic mix
	    of loads on every deck (olive ammo crates with yellow stencil bands, sand cartons, shrink-wrapped loads).
	      Rack A (L1+) along the west wall; aisle A in front of it stays clear.
	      Rack B (L2+) double-sided between aisle A and aisle B.
	      Rack D (L3+) against the back wall.
	  • Cross aisle Z -3.5..1 (X -7..10): clear at every level, edged in yellow.
	  • Floor block stacks of crates (back-middle, L1+); a supply-drop crate with its parachute bundle tops one at L5.
	  • Forklift (L1+) parked by the mouth of aisle A, forks toward the racks, empty pallet on the forks.
	  • Quartermaster cage (back-east): steel counter with a hatch where the Quartermaster terminal stands
	    (Shop → Supply), bar screen above the counter, bar wall along X = 10.3, sign; shelving with helmets and
	    stock, desk and chair inside. Hatched floor in front of the counter.
	  • Supply-run desk (front-west): Supply runs terminal (Missions) under a SUPPLY ROUTES board.
	  • Empty pallets stacked on the east wall; pallet jack (L3+); fuel drums on a spill pallet and a stretch-wrap
	    station with a turning load (L4+); gold WAR EMPIRE LOGISTICS sign over rack D (L5).

	No lights are added here (the shell's ceiling fittings and skylights light the hall). Neon only for the
	forklift beacon. Everything is deterministic; nothing rises above y 12.4 except the L5 wall sign.
]]

return function(ictx: any, api: any)
	local col = ictx.Colors
	local lv: number = ictx.Level
	local y1: number = ictx.Y1
	local X0: number, X1: number, Z0: number, Z1: number = ictx.InX0, ictx.InX1, ictx.InZ0, ictx.InZ1
	local M = Enum.Material
	local UP = CFrame.Angles(0, 0, math.pi * 0.5) -- cylinder axis (local X) → vertical
	local amber: Color3 = col.Accent
	local olive: Color3 = col.Trim
	local crateOlive: Color3 = col.Locker
	local sand: Color3 = col.Sandbag
	local wood = Color3.fromRGB(150, 112, 70)
	local woodDark = Color3.fromRGB(92, 66, 42)
	local wrapCol = Color3.fromRGB(206, 212, 208)
	local fuelCol = Color3.fromRGB(110, 52, 42)
	local tyre = Color3.fromRGB(24, 24, 24)

	local function cyl(name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material, collide: boolean?): BasePart
		return api.cylinder(name, Vector3.new(length, dia, dia), cf, color, mat, collide)
	end

	-- Stencilled text straight onto a surface (transparent background, lit like paint).
	local function paint(host: BasePart, face: Enum.NormalId, lines: { string }, color: Color3)
		api.surfaceText(host, face, lines, color, col.Dark, Enum.Font.GothamBlack)
		for _, g in ipairs(host:GetChildren()) do
			if g:IsA("SurfaceGui") and g.Face == face then
				g.LightInfluence = 1
				local fr = g:FindFirstChildOfClass("Frame")
				if fr then
					fr.BackgroundTransparency = 1
				end
			end
		end
	end

	local function newGui(host: BasePart, face: Enum.NormalId, name: string): SurfaceGui
		local sg = Instance.new("SurfaceGui")
		sg.Name = name
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 20
		sg.LightInfluence = 1
		sg.MaxDistance = 40 -- v70: near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = host
		return sg
	end

	-- n alternating bars across a face (vertical, or horizontal slats); b = nil leaves the gaps see-through.
	local function stripes(host: BasePart, face: Enum.NormalId, n: number, a: Color3, b: Color3?, horizontal: boolean)
		local sg = newGui(host, face, "WE_Stripes")
		for i = 0, n - 1 do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			if horizontal then
				f.Size = UDim2.fromScale(1, 1 / n)
				f.Position = UDim2.fromScale(0, i / n)
			else
				f.Size = UDim2.fromScale(1 / n, 1)
				f.Position = UDim2.fromScale(i / n, 0)
			end
			if i % 2 == 0 then
				f.BackgroundColor3 = a
			elseif b then
				f.BackgroundColor3 = b
			else
				f.BackgroundTransparency = 1
			end
			f.Parent = sg
		end
	end

	-- Bar screen: faint steel panel with painted vertical bars on both big faces (collidable, see-through).
	local function barScreen(host: BasePart, faces: { Enum.NormalId }, n: number)
		host.Transparency = 0.8
		host.CastShadow = false
		for _, face in ipairs(faces) do
			local sg = newGui(host, face, "WE_Bars")
			for i = 0, n - 1 do
				local f = Instance.new("Frame")
				f.BorderSizePixel = 0
				f.BackgroundColor3 = col.Metal
				f.Size = UDim2.fromScale(0.3 / n, 1)
				f.Position = UDim2.fromScale((i + 0.35) / n, 0)
				f.Parent = sg
			end
			for _, yy in ipairs({ 0, 0.5, 0.97 }) do
				local rail = Instance.new("Frame")
				rail.BorderSizePixel = 0
				rail.BackgroundColor3 = col.Metal
				rail.Size = UDim2.fromScale(1, 0.03)
				rail.Position = UDim2.fromScale(0, yy)
				rail.Parent = sg
			end
		end
	end

	-- Olive ammo crate stencil: two yellow bands + text.
	local function stencil(host: BasePart, face: Enum.NormalId, text: string)
		local sg = newGui(host, face, "WE_Stencil")
		for _, yy in ipairs({ 0.12, 0.8 }) do
			local band = Instance.new("Frame")
			band.BorderSizePixel = 0
			band.BackgroundColor3 = amber
			band.Size = UDim2.fromScale(1, 0.08)
			band.Position = UDim2.fromScale(0, yy)
			band.Parent = sg
		end
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(0.8, 0.36)
		t.Position = UDim2.fromScale(0.1, 0.32)
		t.Font = Enum.Font.GothamBlack
		t.Text = text
		t.TextScaled = true
		t.TextColor3 = amber
		t.Parent = sg
	end

	-- Two-part seat (upholstered base + back); (fx, fz) = the way the sitter faces.
	local function seat(x: number, y: number, z: number, fx: number, fz: number)
		api.box("Seat", Vector3.new(1.3, 1.5, 1.3), Vector3.new(x, y + 0.75, z), col.Dark, M.Fabric)
		local backSize = if math.abs(fx) > 0.5 then Vector3.new(0.3, 1.9, 1.3) else Vector3.new(1.3, 1.9, 0.3)
		api.box("SeatBack", backSize, Vector3.new(x - fx * 0.5, y + 2.45, z - fz * 0.5), col.Dark, M.Fabric, false)
	end

	------------------------------------------------------------------------------------------------
	-- Pallet racking
	------------------------------------------------------------------------------------------------
	local KINDS = { "ammo", "carton", "wrap", "carton", "ammo", "wrap", "carton", "ammo", "wrap", "carton", "ammo", "carton", "wrap", "ammo" }
	local loadNo = 0
	-- One pallet load standing on a deck at `base`; w = along the rack run, d = rack depth.
	local function load(pos: Vector3, base: number, w: number, d: number, maxH: number, alongX: boolean, face: Enum.NormalId, solid: boolean)
		loadNo += 1
		local kind = KINDS[(loadNo - 1) % #KINDS + 1]
		local function size(a: number, h: number, b: number): Vector3
			return if alongX then Vector3.new(a, h, b) else Vector3.new(b, h, a)
		end
		if kind == "ammo" then
			local h = math.min(2.2, maxH)
			local p = api.box("AmmoLoad", size(w - 0.3, h, d - 0.2), Vector3.new(pos.X, base + h * 0.5, pos.Z), crateOlive, M.Wood, solid)
			stencil(p, face, "AMMO")
		elseif kind == "carton" then
			local h = math.min(2.6, maxH)
			api.box("CartonLoad", size(w - 0.2, h, d - 0.1), Vector3.new(pos.X, base + h * 0.5, pos.Z), sand, M.Cardboard, solid)
		else
			local h = math.min(2.8, maxH)
			local p = api.box("WrappedLoad", size(w - 0.1, h, d - 0.05), Vector3.new(pos.X, base + h * 0.5, pos.Z), wrapCol, M.SmoothPlastic, solid)
			p.Transparency = 0.25
		end
	end

	--[[ Rack running along X (alongX) or Z, from a0 to a1, depth d0..d1, `bays` equal bays. `lines` = depth
		coordinates of the upright lines (the aisle faces; a wall rack has none at the wall). Decks and loads are
		walk-through (non-collidable) so beams and pallets never snag; only the uprights collide. ]]
	local function rack(alongX: boolean, a0: number, a1: number, d0: number, d1: number, bays: number, lines: { number }, face: Enum.NormalId)
		local function P(a: number, y: number, d: number): Vector3
			return if alongX then Vector3.new(a, y, d) else Vector3.new(d, y, a)
		end
		local function S(a: number, y: number, d: number): Vector3
			return if alongX then Vector3.new(a, y, d) else Vector3.new(d, y, a)
		end
		local span = (a1 - a0 - 0.4) / bays
		local dc = (d0 + d1) * 0.5
		local depth = d1 - d0
		for k = 0, bays do
			local a = a0 + 0.2 + k * span
			for _, ld in ipairs(lines) do
				api.box("RackUpright", S(0.4, 12, 0.4), P(a, y1 + 6, ld), olive, M.Metal)
			end
		end
		for _, deckY in ipairs({ 4.2, 8.2 }) do
			for _, ld in ipairs(lines) do
				api.box("RackBeam", S(a1 - a0, 0.5, 0.3), P((a0 + a1) * 0.5, y1 + deckY - 0.25, ld), amber, M.Metal, false)
			end
			local deck = api.box("PalletDeck", S(a1 - a0 - 0.1, 0.45, depth - 0.1), P((a0 + a1) * 0.5, y1 + deckY + 0.225, dc), wood, M.WoodPlanks, false)
			stripes(deck, face, bays * 6, woodDark, wood, false)
			local maxH = if deckY < 5 then 2.9 else 3.1
			for k = 0, bays - 1 do
				load(P(a0 + 0.2 + (k + 0.5) * span, 0, dc), y1 + deckY + 0.45, span - 0.4, depth - 0.2, maxH, alongX, face, false)
			end
		end
	end

	-- Rack A (west wall), aisle A X -14.35..-10.2 in front of it
	rack(false, -11.9, 3.7, X0 + 0.05, -14.35, 4, { -14.55 }, Enum.NormalId.Right)
	-- Rack B (double-sided), aisle B X -7.0..-4 east of it
	if lv >= 2 then
		rack(false, -11.9, 0, -10.2, -7.0, 3, { -10.0, -7.2 }, Enum.NormalId.Right)
	end
	-- Rack D (back wall)
	if lv >= 3 then
		rack(true, -2, 8, Z0 + 0.05, -10.35, 3, { -10.55 }, Enum.NormalId.Back)
	end
	if lv < 2 then
		-- L1: pallets staged on the floor where rack B goes in (solid; aisles A and B stay clear)
		for _, z in ipairs({ -9.4, -5.4 }) do
			api.box("FloorPallet", Vector3.new(3.0, 0.45, 3.0), Vector3.new(-8.6, y1 + 0.225, z), wood, M.WoodPlanks)
			load(Vector3.new(-8.6, 0, z), y1 + 0.45, 3.2, 3.1, 2.6, false, Enum.NormalId.Right, true)
		end
	end

	------------------------------------------------------------------------------------------------
	-- Floor block stacks (back-middle, between rack D and the cross aisle)
	------------------------------------------------------------------------------------------------
	local function crate(x: number, y: number, z: number, s: number, yawDeg: number, color: Color3, mat: Enum.Material, label: string?): BasePart
		local p = api.part("StackCrate", Vector3.new(s, s, s), CFrame.new(x, y + s * 0.5, z) * CFrame.Angles(0, math.rad(yawDeg), 0), color, mat)
		if label then
			stencil(p, Enum.NormalId.Back, label)
		end
		return p
	end
	crate(1.6, y1, -6.4, 2.4, 0, wood, M.WoodPlanks)
	crate(1.6, y1 + 2.4, -6.4, 2.4, 6, crateOlive, M.Wood, "SUPPLY")
	crate(4.6, y1, -6.0, 2.4, 3, crateOlive, M.Wood, "RATIONS")
	crate(4.6, y1 + 2.4, -6.0, 2.4, -7, wood, M.WoodPlanks)
	if lv >= 5 then
		crate(4.6, y1 + 4.8, -6.0, 2.2, 4, crateOlive, M.Wood, "AIRDROP")
		api.part("ParachuteBundle", Vector3.new(1.6, 0.7, 1.3), CFrame.new(4.6, y1 + 7.0 + 0.35, -6.0) * CFrame.Angles(0, math.rad(4), 0), sand, M.Fabric, false)
		local sign = api.box("LogisticsSign", Vector3.new(9.0, 1.2, 0.1), Vector3.new(3.0, y1 + 12.8, Z0 + 0.05), col.Dark, M.Metal, false)
		api.surfaceText(sign, Enum.NormalId.Back, { "WAR EMPIRE LOGISTICS" }, col.Gold, col.Dark, Enum.Font.GothamBlack)
	end

	------------------------------------------------------------------------------------------------
	-- Forklift by the mouth of aisle A (faces -Z; only the chassis and counterweight collide)
	------------------------------------------------------------------------------------------------
	do
		local fx = -10.0
		api.box("ForkliftChassis", Vector3.new(2.2, 1.2, 3.4), Vector3.new(fx, y1 + 0.95, 7.3), amber, M.Metal)
		api.box("ForkliftCounterweight", Vector3.new(2.2, 1.6, 0.9), Vector3.new(fx, y1 + 1.15, 9.35), col.Dark, M.Metal)
		cyl("ForkliftWheels", 2.8, 1.1, CFrame.new(fx, y1 + 0.55, 6.2), tyre, M.Fabric, false)
		cyl("ForkliftWheels", 2.8, 0.9, CFrame.new(fx, y1 + 0.45, 8.8), tyre, M.Fabric, false)
		api.box("ForkliftSeat", Vector3.new(1.3, 0.8, 1.1), Vector3.new(fx, y1 + 1.95, 8.2), col.Dark, M.Fabric, false)
		cyl("ForkliftSteering", 0.12, 0.9, CFrame.new(fx, y1 + 1.95, 6.9) * CFrame.Angles(math.rad(35), 0, 0) * UP, col.Dark, M.Metal, false)
		for _, px in ipairs({ -1, 1 }) do
			for _, pz in ipairs({ 6.2, 8.7 }) do
				api.box("ForkliftGuardPost", Vector3.new(0.18, 2.6, 0.18), Vector3.new(fx + px * 0.95, y1 + 2.85, pz), col.Dark, M.Metal, false)
			end
		end
		api.box("ForkliftGuardRoof", Vector3.new(2.1, 0.15, 2.8), Vector3.new(fx, y1 + 4.225, 7.45), col.Dark, M.Metal, false)
		for _, px in ipairs({ -1, 1 }) do
			api.box("ForkliftMast", Vector3.new(0.25, 5.6, 0.3), Vector3.new(fx + px * 0.75, y1 + 3.0, 5.45), col.Metal, M.Metal, false)
		end
		api.box("ForkliftCarriage", Vector3.new(1.9, 1.0, 0.2), Vector3.new(fx, y1 + 1.1, 5.2), col.Dark, M.Metal, false)
		for _, px in ipairs({ -1, 1 }) do
			api.box("ForkliftFork", Vector3.new(0.25, 0.12, 1.9), Vector3.new(fx + px * 0.5, y1 + 0.66, 4.15), col.Metal, M.Metal, false)
		end
		api.box("ForkliftPallet", Vector3.new(2.0, 0.4, 1.9), Vector3.new(fx, y1 + 0.92, 4.15), wood, M.WoodPlanks, false)
		api.ball("ForkliftBeacon", 0.3, Vector3.new(fx, y1 + 4.45, 8.4), amber, M.Neon, false)
	end

	------------------------------------------------------------------------------------------------
	-- Quartermaster cage (back-east): counter with a hatch, terminal in the hatch → Shop (Supply tab)
	------------------------------------------------------------------------------------------------
	local cageX = 10.3
	api.box("QMCounter", Vector3.new(11.9 - cageX, 3.3, 1.2), Vector3.new((cageX + 11.9) * 0.5, y1 + 1.65, -1.4), col.Metal, M.DiamondPlate)
	api.box("QMCounter", Vector3.new(X1 - 0.05 - 14.5, 3.3, 1.2), Vector3.new((14.5 + X1 - 0.05) * 0.5, y1 + 1.65, -1.4), col.Metal, M.DiamondPlate)
	local qm = api.terminal("QMTerminal", Vector3.new(13.2, y1, -1.4), 0, "Shop", "Requisition", "Quartermaster", { "QUARTERMASTER", "SUPPLY DROPS" })
	local qmPrompt = if qm then qm:FindFirstChild("WE_PanelPrompt") else nil
	if qmPrompt then
		qmPrompt:SetAttribute("WE_OpenTab", "Supply")
	end
	local screen = api.box("QMCageScreen", Vector3.new(X1 - 0.05 - cageX, 4.4, 0.1), Vector3.new((cageX + X1 - 0.05) * 0.5, 7.2, -1.4), col.Metal, M.Metal)
	barScreen(screen, { Enum.NormalId.Front, Enum.NormalId.Back }, 18)
	local side = api.box("QMCageSide", Vector3.new(0.1, 9.0, -2.0 - (Z0 + 0.05)), Vector3.new(cageX + 0.05, y1 + 4.5, (Z0 + 0.05 - 2.0) * 0.5), col.Metal, M.Metal)
	barScreen(side, { Enum.NormalId.Left, Enum.NormalId.Right }, 30)
	local qmSign = api.box("QMSign", Vector3.new(X1 - 0.05 - cageX, 1.4, 0.2), Vector3.new((cageX + X1 - 0.05) * 0.5, 10.1, -1.4), col.Dark, M.Metal, false)
	api.surfaceText(qmSign, Enum.NormalId.Back, { "QUARTERMASTER" }, amber, col.Dark, Enum.Font.GothamBlack)
	-- inside: stock shelving on the east wall (painted stock + two helmets), desk and chair
	local shelving = api.box("QMShelving", Vector3.new(1.0, 7.0, 7.6), Vector3.new(X1 - 0.55, y1 + 3.5, -7.8), col.Metal, M.Metal)
	do
		local sg = newGui(shelving, Enum.NormalId.Left, "WE_Stock")
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = col.Dark
		bg.BorderSizePixel = 0
		bg.Parent = sg
		local stock = { sand, crateOlive, sand, col.Rug, wood, crateOlive }
		for r = 0, 3 do
			for i = 0, 4 do
				local k = r * 5 + i
				local h = 0.55 + (k * 3 % 4) * 0.08
				local box = Instance.new("Frame")
				box.BorderSizePixel = 0
				box.BackgroundColor3 = stock[(k * 5 + r) % #stock + 1]
				box.Size = UDim2.fromScale(0.16, h / 4)
				box.Position = UDim2.fromScale(0.02 + i * 0.196, (r + 0.94 - h) / 4)
				box.Parent = bg
			end
			local shelfLine = Instance.new("Frame")
			shelfLine.BorderSizePixel = 0
			shelfLine.BackgroundColor3 = col.Metal
			shelfLine.Size = UDim2.fromScale(1, 0.015)
			shelfLine.Position = UDim2.fromScale(0, (r + 0.94) / 4)
			shelfLine.Parent = bg
		end
	end
	for i = 0, 1 do
		api.ball("Helmet", 0.9, Vector3.new(X1 - 1.3, y1 + 3.5 + 0.45, -10.2 + i * 1.0), crateOlive, M.SmoothPlastic, false)
	end
	api.box("QMDesk", Vector3.new(2.2, 2.5, 1.0), Vector3.new(12.4, y1 + 1.25, -5.9), wood, M.Wood)
	api.box("QMDeskTop", Vector3.new(2.5, 0.2, 1.3), Vector3.new(12.4, y1 + 2.6, -5.9), woodDark, M.Wood)
	seat(12.4, y1, -7.35, 0, 1)

	------------------------------------------------------------------------------------------------
	-- Supply-run desk (front-west): terminal against the front wall → Missions, route board above it
	------------------------------------------------------------------------------------------------
	api.terminal("SupplyTerminal", Vector3.new(-6.6, y1, Z1 - 0.8), 180, "Missions", "Plan supply run", "Supply Runs", { "SUPPLY RUNS", "CONVOY OPS" })
	local board = api.box("RouteBoard", Vector3.new(4.0, 3.0, 0.1), Vector3.new(-6.6, 9.5, Z1 - 0.05), col.Dark, M.Metal, false)
	api.surfaceText(board, Enum.NormalId.Front, { "SUPPLY ROUTES", "DEPOT > FOB 1  CLEAR", "DEPOT > FOB 2  CLEAR", "CONVOY 3  EN ROUTE" }, amber, col.Dark, Enum.Font.Code)

	------------------------------------------------------------------------------------------------
	-- East wall between the cage and the console: empty pallets stacked on edge
	------------------------------------------------------------------------------------------------
	local pallets = api.box("EmptyPallets", Vector3.new(1.1, 2.3, 4.3), Vector3.new(X1 - 0.6, y1 + 1.15, 3.25), wood, M.WoodPlanks)
	stripes(pallets, Enum.NormalId.Left, 9, woodDark, wood, true)

	if lv >= 3 then
		-- pallet jack parked at the north end of rack B (out of aisle B and the cross aisle)
		api.box("PalletJack", Vector3.new(1.3, 0.25, 2.6), Vector3.new(-7.75, y1 + 0.125, 1.7), amber, M.Metal)
		api.part("PalletJackHandle", Vector3.new(0.12, 2.2, 0.12), CFrame.new(-7.75, y1 + 1.2, 3.2) * CFrame.Angles(math.rad(25), 0, 0), col.Dark, M.Metal, false)
	end

	if lv >= 4 then
		-- fuel drums on a spill pallet + stretch-wrap station (turntable and load turn on the client)
		api.box("SpillPallet", Vector3.new(2.9, 0.3, 2.9), Vector3.new(1.6, y1 + 0.15, 3.5), amber, M.Metal)
		for _, o in ipairs({ Vector3.new(-0.65, 0, -0.65), Vector3.new(0.65, 0, -0.65), Vector3.new(-0.65, 0, 0.65) }) do
			cyl("FuelDrum", 1.9, 1.25, CFrame.new(1.6 + o.X, y1 + 0.3 + 0.95, 3.5 + o.Z) * UP, fuelCol, M.Metal)
		end
		local turntable = cyl("WrapTurntable", 0.3, 3.0, CFrame.new(6.0, y1 + 0.15, 3.6) * UP, col.Metal, M.DiamondPlate, false)
		local wrapped = api.box("WrapLoad", Vector3.new(2.2, 2.4, 2.2), Vector3.new(6.0, y1 + 0.3 + 1.2, 3.6), wrapCol, M.SmoothPlastic, false)
		wrapped.Transparency = 0.25
		api.spin({ turntable, wrapped }, Vector3.new(6.0, y1, 3.6), 6)
		api.box("WrapMast", Vector3.new(0.4, 4.0, 0.4), Vector3.new(8.0, y1 + 2.0, 3.6), amber, M.Metal)
	end

	------------------------------------------------------------------------------------------------
	-- Floor markings (walk-over): loading bay outline + stencil, cross-aisle edges, hatching at the counter
	------------------------------------------------------------------------------------------------
	local function line(sx: number, sz: number, x: number, z: number)
		api.box("FloorLine", Vector3.new(sx, 0.04, sz), Vector3.new(x, y1 + 0.02, z), amber, M.SmoothPlastic, false)
	end
	line(0.3, 5.9, -3.85, 9.2)
	line(0.3, 5.9, 9.85, 9.2)
	line(14.0, 0.3, 3.0, 6.35)
	line(17.0, 0.3, 1.5, -3.35)
	line(17.0, 0.3, 1.5, 0.85)
	local bayText = api.box("FloorStencil", Vector3.new(7.0, 0.04, 1.8), Vector3.new(3.0, y1 + 0.03, 9.4), col.Floor, M.SmoothPlastic, false)
	bayText.Transparency = 1
	paint(bayText, Enum.NormalId.Top, { "LOADING BAY" }, amber)
	local hatch = api.box("CounterHatching", Vector3.new(X1 - 0.1 - cageX, 0.04, 1.6), Vector3.new((cageX + X1 - 0.1) * 0.5, y1 + 0.02, 0.05), amber, M.SmoothPlastic, false)
	stripes(hatch, Enum.NormalId.Top, 14, amber, col.Dark, false)
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="177">
          <Properties>
            <string name="Name">MapDressing</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — MapDressing (the world outside the bases)
	Called from MapSetup.Run after bases / territories / spawns (deferred). Studio usually SKIPS it
	(DevConfig.StudioSkipWorldDressing) — the ForceDress attribute opts in. Regenerate: delete WarEmpireSetup + Play, or
	admin resetmap.

	World v2 W3 (gap/world_v2_spec.md §4, roadmap §2.4 WORLD-B builder 2): every prop now belongs to a place. Dress runs,
	in this order, each step guarded so a failure warns and the rest still builds:
	  1. WorldPOI.Build     — the named places (every enabled POI in WorldConfig.POIs), WorldDressing.POI_<Id>
	  2. DocksideDressing   — the legacy South Docks quay kit, as-is while the Port POI is off (inside the Port
	                          footprint); W3 step 2: once WorldPOI has built the Port, the quay kit is not built at all
	  3. WorldDress.Build   — the travel dressing between the places: road rhythm, junction kits, canal / shore features,
	                          natural scatter (WorldDressing.Rhythm / Junctions / Shore / Scatter)
	  4. Waterways.CullDressing — the safety net (nothing in the water, on a plot pad or in a road lane)
	  5. WorldHygiene.Enforce   — rules H1–H10 (H1 orphans are destroyed in W3)
	The old coordinate-list sections (checkpoints, outposts, hangars, depots, camps, road furniture, landmarks, warzone
	fills, plot densify, horizon hosts) and every third-party catalog host are gone.
	Quality (MapSetup: live = "Full"; Studio = DevConfig.WorldDressQuality): "Low" = POIs at 60 %, every other road
	rhythm cluster, no scatter (WorldDressConfig.Quality).
	v70 waterways (spec_final §9): nothing stands in the water or on a plot pad; WE_AllowInWater exempts the harbour piers.
]]

local MapDressing = {}

-- v70: Modules/Waterways (water rects + dressing cull), loaded lazily so a Waterways error never blocks MapSetup
local waterwaysMod: any = nil
local function getWaterways(): any?
	if waterwaysMod == nil then
		local ok, m = pcall(function(): any
			return require(script.Parent.Waterways) :: any
		end)
		waterwaysMod = if ok and type(m) == "table" then m else false
		if not ok then
			warn("[MapDressing] Waterways unavailable:", m)
		end
	end
	return if waterwaysMod then waterwaysMod else nil
end

-- World v2 W1: Modules/WorldHygiene (rules H1–H10), loaded lazily and guarded like Waterways: a missing module or an
-- error never stops the dressing
local hygieneMod: any = nil
local function getWorldHygiene(): any?
	if hygieneMod == nil then
		local ok, m = pcall(function(): any
			local mod = script.Parent:FindFirstChild("WorldHygiene")
			return if mod and mod:IsA("ModuleScript") then require(mod) :: any else nil
		end)
		hygieneMod = if ok and type(m) == "table" then m else false
		if not ok then
			warn("[MapDressing] WorldHygiene unavailable:", m)
		end
	end
	return if hygieneMod then hygieneMod else nil
end

-- World v2 W3: WorldPOI / WorldDress / WorldKits, each loaded lazily inside pcall like Waterways (a missing module or a
-- require error warns once and that step is skipped; the rest of the dressing still builds)
local worldMods: { [string]: any } = {}
local function getWorldModule(name: string): any?
	local cached = worldMods[name]
	if cached == nil then
		local ok, m = pcall(function(): any
			local mod = script.Parent:FindFirstChild(name)
			return if mod and mod:IsA("ModuleScript") then require(mod) :: any else nil
		end)
		cached = if ok and type(m) == "table" then m else false
		worldMods[name] = cached
		if not ok then
			warn("[MapDressing] " .. name .. " unavailable:", m)
		end
	end
	return if cached then cached else nil
end

-- Palette of the Dockside kits (aligned with StructureVisualConfig / MapSetup)
local COL = {
	ConcreteDark = Color3.fromRGB(60, 60, 55),
	Metal = Color3.fromRGB(58, 72, 88),
	MetalDark = Color3.fromRGB(45, 50, 55),
	Olive = Color3.fromRGB(70, 78, 55),
	OliveDark = Color3.fromRGB(50, 55, 42),
	Sand = Color3.fromRGB(150, 130, 90),
	Sandbag = Color3.fromRGB(130, 115, 80),
	Fuel = Color3.fromRGB(180, 140, 50),
	Ammo = Color3.fromRGB(88, 58, 50),
	NeonGold = Color3.fromRGB(230, 190, 60),
	NeonOrange = Color3.fromRGB(220, 140, 60),
	NeonRed = Color3.fromRGB(200, 90, 70),
	Crate = Color3.fromRGB(95, 80, 55),
	Drum = Color3.fromRGB(70, 85, 55),
	DrumAccent = Color3.fromRGB(200, 90, 50),
	Vehicle = Color3.fromRGB(55, 65, 48),
	VehicleAccent = Color3.fromRGB(90, 140, 70),
	Light = Color3.fromRGB(255, 230, 160),
	Dock = Color3.fromRGB(50, 75, 95),
}

local function ensureFolder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function p(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else false
	part.CanQuery = if props.CanQuery ~= nil then props.CanQuery else false
	part.CanTouch = false
	part.CastShadow = if props.CastShadow ~= nil then props.CastShadow else false
	if props.Name then
		part.Name = props.Name
	end
	if props.Size then
		part.Size = props.Size
	end
	if props.CFrame then
		part.CFrame = props.CFrame
	elseif props.Position then
		part.Position = props.Position
	end
	if props.Color then
		part.Color = props.Color
	end
	if props.Material then
		part.Material = props.Material
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	part:SetAttribute("WE_Decor", true)
	part:SetAttribute("WE_MapDress", true)
	return part
end

local function at(origin: Vector3, ox: number, oy: number, oz: number): Vector3
	return origin + Vector3.new(ox, oy, oz)
end

-- W3 step 2 (spec w3s2 §6 lane P): the POI that replaces the Dockside quay kit once WorldPOI has built it
local DOCKSIDE_POI = "Port"


-- ── Dockside kits (legacy, as-is until the Port POI step; World v2 W3 kept only what DocksideDressing uses) ──

local function kitFuelDepot(folder: Folder, origin: Vector3, yawDeg: number)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	p({
		Name = "FuelPad",
		Size = Vector3.new(16, 0.5, 12),
		CFrame = cf * CFrame.new(0, 0.25, 0),
		Color = COL.ConcreteDark,
		Material = Enum.Material.Concrete,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	for i, ox in ipairs({ -4.5, 0, 4.5 }) do
		p({
			Name = "FuelTank" .. i,
			Size = Vector3.new(7, 3.6, 3.6),
			-- Cylinder default axis is +X; rotate so tanks stand upright
			CFrame = cf * CFrame.new(ox, 3.8, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = COL.Fuel,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Cylinder,
			CanCollide = true,
			CanQuery = true,
			Parent = folder,
		})
	end
	p({
		Name = "FuelShed",
		Size = Vector3.new(5, 4, 5),
		CFrame = cf * CFrame.new(0, 2.2, 5.5),
		Color = COL.OliveDark,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	p({
		Name = "FuelAccent",
		Size = Vector3.new(15, 0.2, 0.3),
		CFrame = cf * CFrame.new(0, 0.6, -5.5),
		Color = COL.NeonOrange,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	-- Mesh dress ON Part-kit cluster only (PreferMesh stays OFF for gameplay structures)
	local fuelHost = p({
		Name = "FuelDressHost",
		Size = Vector3.new(4, 2, 4),
		CFrame = cf * CFrame.new(0, 2, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		if vas and vas.TryAttachPropVisual then
			vas.TryAttachPropVisual(fuelHost, "FuelTanks")
		end
	end)
end

local function kitAmmoShed(folder: Folder, origin: Vector3, yawDeg: number)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	p({
		Name = "AmmoBody",
		Size = Vector3.new(10, 5, 8),
		CFrame = cf * CFrame.new(0, 2.7, 0),
		Color = COL.Ammo,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	p({
		Name = "AmmoRoof",
		Size = Vector3.new(11, 0.6, 9),
		CFrame = cf * CFrame.new(0, 5.5, 0),
		Color = COL.ConcreteDark,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	p({
		Name = "AmmoDoor",
		Size = Vector3.new(2.2, 3, 0.35),
		CFrame = cf * CFrame.new(0, 1.7, -4.1),
		Color = COL.MetalDark,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	p({
		Name = "AmmoAccent",
		Size = Vector3.new(10.4, 0.2, 0.3),
		CFrame = cf * CFrame.new(0, 5.2, -4.2),
		Color = COL.NeonRed,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	-- Crate stack beside shed
	for i = 0, 2 do
		p({
			Name = "AmmoCrate",
			Size = Vector3.new(2.2, 1.4, 1.8),
			CFrame = cf * CFrame.new(6.5, 0.9 + i * 1.45, -1 + (i % 2) * 0.4),
			Color = COL.Crate,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	local ammoHost = p({
		Name = "AmmoDressHost",
		Size = Vector3.new(3, 2, 3),
		CFrame = cf * CFrame.new(0, 3, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		if vas and vas.TryAttachPropVisual then
			vas.TryAttachPropVisual(ammoHost, "AmmoShed")
		end
	end)
end

local function kitSandbagLine(folder: Folder, origin: Vector3, yawDeg: number, length: number?)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local n = length or 5
	for i = 0, n - 1 do
		p({
			Name = "Sandbag",
			Size = Vector3.new(2.4, 1.1, 1.4),
			CFrame = cf * CFrame.new((i - (n - 1) / 2) * 2.5, 0.55, 0),
			Color = COL.Sandbag,
			Material = Enum.Material.Sand,
			CanCollide = true,
			CanQuery = true,
			Parent = folder,
		})
		p({
			Name = "SandbagTop",
			Size = Vector3.new(2.2, 1.0, 1.2),
			CFrame = cf * CFrame.new((i - (n - 1) / 2) * 2.5, 1.5, 0.1),
			Color = COL.Sand,
			Material = Enum.Material.Sand,
			Parent = folder,
		})
	end
end

local function kitVehicleSilhouette(folder: Folder, origin: Vector3, yawDeg: number, kind: string?)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local k = kind or "jeep"
	if k == "truck" then
		p({
			Name = "DecoyCab",
			Size = Vector3.new(4, 3.2, 5),
			CFrame = cf * CFrame.new(0, 2.2, -4),
			Color = COL.Vehicle,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		p({
			Name = "DecoyBed",
			Size = Vector3.new(4.2, 2.2, 8),
			CFrame = cf * CFrame.new(0, 1.6, 3),
			Color = COL.OliveDark,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	elseif k == "tank" then
		p({
			Name = "DecoyHull",
			Size = Vector3.new(6, 2.4, 10),
			CFrame = cf * CFrame.new(0, 1.6, 0),
			Color = COL.Vehicle,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		p({
			Name = "DecoyTurret",
			Size = Vector3.new(4, 1.8, 4),
			CFrame = cf * CFrame.new(0, 3.4, -0.5),
			Color = COL.Olive,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		p({
			Name = "DecoyBarrel",
			Size = Vector3.new(0.55, 0.55, 7),
			CFrame = cf * CFrame.new(0, 3.5, -5),
			Color = COL.MetalDark,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	else
		-- jeep
		p({
			Name = "DecoyBody",
			Size = Vector3.new(3.6, 1.8, 6.5),
			CFrame = cf * CFrame.new(0, 1.4, 0),
			Color = COL.Vehicle,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		p({
			Name = "DecoyCabin",
			Size = Vector3.new(3.4, 1.5, 2.8),
			CFrame = cf * CFrame.new(0, 2.8, -0.8),
			Color = COL.OliveDark,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	p({
		Name = "DecoyAccent",
		Size = Vector3.new(2.5, 0.15, 0.3),
		CFrame = cf * CFrame.new(0, 2.4, -3.2),
		Color = COL.VehicleAccent,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	-- Muted DISPLAY plate — never looks spawnable
	local plate = p({
		Name = "DISPLAY",
		Size = Vector3.new(1.6, 0.12, 0.7),
		CFrame = cf * CFrame.new(0, 0.9, 3.2),
		Color = Color3.fromRGB(40, 42, 38),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = folder,
	})
	plate:SetAttribute("WE_DisplayOnly", true)
	-- Wheels (deco)
	for _, ox in ipairs({ -1.6, 1.6 }) do
		for _, oz in ipairs({ -2.2, 2.2 }) do
			p({
				Name = "DecoyWheel",
				Size = Vector3.new(0.7, 1.4, 1.4),
				CFrame = cf * CFrame.new(ox, 0.7, oz),
				Color = COL.MetalDark,
				Material = Enum.Material.Rubber,
				Shape = Enum.PartType.Cylinder,
				Parent = folder,
			})
		end
	end
end

local function kitOilDrums(folder: Folder, origin: Vector3, count: number?)
	local n = count or 4
	for i = 0, n - 1 do
		local ox = (i % 2) * 1.8
		local oz = math.floor(i / 2) * 1.8
		p({
			Name = "OilDrum",
			Size = Vector3.new(2.2, 1.4, 1.4),
			CFrame = CFrame.new(at(origin, ox, 1.1, oz)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = if i % 2 == 0 then COL.Drum else COL.DrumAccent,
			Material = Enum.Material.Metal,
			Shape = Enum.PartType.Cylinder,
			Parent = folder,
		})
	end
end

local function kitCrateStack(folder: Folder, origin: Vector3)
	for i = 0, 3 do
		p({
			Name = "Crate",
			Size = Vector3.new(2.4, 1.6, 2.0),
			Position = at(origin, (i % 2) * 2.5, 0.8 + math.floor(i / 2) * 1.65, (i % 2) * 0.3),
			Color = COL.Crate,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	p({
		Name = "CrateAccent",
		Size = Vector3.new(2.2, 0.12, 0.2),
		Position = at(origin, 0, 2.5, 0),
		Color = COL.NeonGold,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
end

local function kitLightPole(folder: Folder, origin: Vector3)
	p({
		Name = "Pole",
		Size = Vector3.new(0.4, 12, 0.4),
		Position = at(origin, 0, 6, 0),
		Color = COL.MetalDark,
		Material = Enum.Material.Metal,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	p({
		Name = "Arm",
		Size = Vector3.new(3.5, 0.3, 0.3),
		Position = at(origin, 1.5, 11.5, 0),
		Color = COL.Metal,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	p({
		Name = "Lamp",
		Size = Vector3.new(1.2, 0.6, 1.2),
		Position = at(origin, 3, 11.2, 0),
		Color = COL.Light,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
end

-- ── Dress ─────────────────────────────────────────────────────────────────────────────────────────────────────────

-- Builds WarEmpireSetup.WorldDressing (replaces an old one; idempotent). opts.Quality: "Full" | "Low" (default Low).
function MapDressing.Dress(root: Instance, opts: { Quality: string? }?)
	local requested = tostring((opts and opts.Quality) or "Low")
	local wd = getWorldModule("WorldDress")
	local quality: string = if string.lower(requested) == "full" then "Full" else "Low"
	if wd then
		local okQ, q = pcall(wd.Quality, requested)
		if okQ and type(q) == "string" then
			quality = q
		end
	end
	local full = quality == "Full"
	local dressing = ensureFolder("WorldDressing", root)

	-- the terrain rock log restarts with every build (the sim dumps it; live fills Workspace.Terrain once per rock)
	local wk = getWorldModule("WorldKits")
	if wk then
		local okT, errT = pcall(wk.ResetTerrainLog)
		if not okT then
			warn("[MapDressing] WorldKits.ResetTerrainLog failed:", errT)
		end
	end

	-- one occupancy (keep-outs + every placed cluster) shared by the POIs and the travel dressing
	local occ: any = nil
	if wd then
		local okO, o = pcall(function(): any
			return wd.NewOccupancy(wd.Zones())
		end)
		if okO then
			occ = o
		else
			warn("[MapDressing] WorldDress keep-outs failed:", o)
		end
	end

	-- 1) POIs (every enabled place; W3 step 2 adds the 17 layouts as their enable steps flip them on)
	local wp = getWorldModule("WorldPOI")
	local portBuilt = false
	if wp then
		local okP, errP = pcall(wp.Build, dressing, quality, occ)
		if not okP then
			warn("[MapDressing] WorldPOI.Build failed:", errP)
		elseif type(errP) == "table" and type(errP.POIs) == "table" then
			for _, row in ipairs(errP.POIs) do
				if type(row) == "table" and row.Id == DOCKSIDE_POI and row.Built == true then
					portBuilt = true
				end
			end
		end
	end

	-- claude-bud JOB 3: the world fill's connector roads, reserved in the occupancy before the travel dressing is placed
	local wfill = getWorldModule("WorldFill")
	if wfill then
		local okR, errR = pcall(wfill.ReserveRoads, occ, wd)
		if not okR then
			warn("[MapDressing] WorldFill.ReserveRoads failed:", errR)
		end
	end

	-- 2) the legacy quay kit, as-is (inside the reserved Port footprint) — only while the Port POI is not built
	-- 7) Dockside — v70: re-laid round the South Docks harbour (water x -240..240, z 1364..1490). Piers stand in the
	-- harbour off the quay (WE_AllowInWater); crates / drums / lights on the quay (z 1330..1360) beside them, never in
	-- front of a pier. Piers at x -220 / -185 / 185 / 220 stay clear of the capture lens (|x| <= 56), the slips
	-- (|x| 64..108) and P4's channel mouth (x -148..-108). Low: 2 piers; Full: 4.
	if not portBuilt then
		local f = Instance.new("Folder")
		f.Name = "DocksideDressing"
		f.Parent = dressing
		local pierXs = if full then { -220, -185, 185, 220 } else { -185, 185 }
		for i, x in ipairs(pierXs) do
			local pier = p({
				Name = "Pier" .. i,
				Size = Vector3.new(10, 1.2, 36),
				Position = Vector3.new(x, 2.0, 1382), -- z 1364..1400, deck top 2.6
				Color = COL.Dock,
				Material = Enum.Material.Wood,
				CanCollide = true,
				CanQuery = true,
				Parent = f,
			})
			pier:SetAttribute("WE_AllowInWater", true)
			kitCrateStack(f, Vector3.new(x - 12, 0.5, 1350))
			if full then
				kitOilDrums(f, Vector3.new(x + 8, 0.5, 1340), 3)
				kitLightPole(f, Vector3.new(x + 7, 0.5, 1358))
			end
		end
		if full then
			kitAmmoShed(f, Vector3.new(-320, 0.5, 1380), 0)
			kitFuelDepot(f, Vector3.new(320, 0.5, 1380), 180)
			kitVehicleSilhouette(f, Vector3.new(170, 0.5, 1330), 0, "truck")
			kitSandbagLine(f, Vector3.new(0, 0.5, 1340), 0, 6)
		end
	end

	-- 3) travel dressing between the places: road rhythm, junction kits, canal / shore features, natural scatter
	if wd then
		local okD, errD = pcall(wd.Build, dressing, quality, occ)
		if not okD then
			warn("[MapDressing] WorldDress.Build failed:", errD)
		end
	end

	-- 4) v70 safety net (spec §9.12): nothing in the water or on a plot pad (WE_AllowInWater exempts the harbour piers)
	local culled = 0
	local ww = getWaterways()
	if ww then
		local okCull, res = pcall(ww.CullDressing, dressing)
		if okCull and type(res) == "number" then
			culled = res
		elseif not okCull then
			warn("[MapDressing] water cull failed:", res)
		end
	end

	-- 5) World v2 hygiene rules over what is left (spec §5.1; H1 orphans destroyed in W3; logs one summary line)
	local wh = getWorldHygiene()
	if wh then
		local okHy, errHy = pcall(wh.Enforce, dressing)
		if not okHy then
			warn("[MapDressing] WorldHygiene.Enforce failed:", errHy)
		end
	end

	-- claude-bud JOB 3: the world fill props (Workspace.WorldFill), after everything else so they avoid it all
	if wfill then
		local okF, errF = pcall(wfill.Build, quality, occ, wd, wk)
		if not okF then
			warn("[MapDressing] WorldFill.Build failed:", errF)
		end
	end
	-- claude-bud JOB 31: the named sites in the open desert (Workspace.WorldFill.Sites), after the fill so they avoid it
	local wsites = getWorldModule("WorldSites")
	if wsites and wk then
		local okS, errS = pcall(wsites.Build, quality, wk)
		if not okS then
			warn("[MapDressing] WorldSites.Build failed:", errS)
		end
	end
	-- claude-bud JOB 17: the night lights (Workspace.WE_NightLights; outside the dressing folders / light budget above)
	local nl = getWorldModule("NightLights")
	if nl then
		local okN, errN = pcall(nl.Build)
		if not okN then
			warn("[MapDressing] NightLights.Build failed:", errN)
		end
	end

	-- CastShadow is governed by H9 (WorldKits sets it only on parts >= 8 studs; Enforce clears small casters)
	local partCount = 0
	for _, d in ipairs(dressing:GetDescendants()) do
		if d:IsA("BasePart") then
			partCount += 1
		end
	end
	print("[WAR EMPIRE] MapDressing complete: quality=" .. string.lower(quality) .. " parts=" .. tostring(partCount) .. " culled=" .. tostring(culled) .. " order=POI+Dockside+WorldDress")
end

return MapDressing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="178">
          <Properties>
            <string name="Name">MapSetup</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — MapSetup (shared world build)
	Builds Workspace.WarEmpireSetup: map, plots, structure kits, territories,
	spawns, tutorial markers, MapDressing + DesertFlora.
	Called from Bootstrap when WarEmpireSetup is missing (Play Solo / server start).
	Admin `resetmap` destroys WarEmpireSetup and re-runs.
	World v2 W1 (gap/world_v2_spec.md §1.6 / §3.3–§3.5, roadmap §2.2 WORLD-A): WorldAtmosphere owns the lighting,
	WorldBounds builds the skyline / ground and air walls / seabed tint / far shore, WorldTerrain fills the canyon edge
	(each call guarded: a failure never stops the map build). The mesa Part ring, the ground fill patches, the 20 static
	soldier statues, the "OIL FIELD" pads and the grey landmark hosts are gone. Spawns come from WorldConfig.Spawns:
	10 painted garage pads (6 outside the front gates, the only ones with a "Garage" sign), invisible NPC / event
	anchors, no beacons, no Neon.
	W3 step 2 lane BK: the Empire Bank is a walk-in hall (buildEmpireBank: 17 parts, the open BankGate, the StateBanner,
	the Town.Bank.* activity anchors on BankPlaza).
	streaming2 S4 (spec streaming2 §1, F11 / F12 / F24): ModelStreamingMode Atomic, always set before the Model is
	parented, on the static soldier rigs (makeSoldierKit), the Empire Bank (one Model "EmpireBank") and one Model per
	capture zone (Territories.<Id>_Zone: the marker, _Ring, _FlagPole, _Flag and, off the Home Outposts, _FlagStripe
	and _Finial; fort walls / keep / towers and rig decks / legs / piers stay loose). Plots stay Folders. Inert while
	Workspace.StreamingEnabled is false (the default.project.json switch): the same parts, only grouped.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local MapDressing = require(script.Parent:WaitForChild("MapDressing"))
local DesertFlora = require(script.Parent:WaitForChild("DesertFlora"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedConfigs = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs")
local DevConfig = require(SharedConfigs:WaitForChild("DevConfig"))
local MonetizationConfig = require(SharedConfigs:WaitForChild("MonetizationConfig"))
local StructureVisualConfig = require(SharedConfigs:WaitForChild("StructureVisualConfig"))
local BaseLayout = require(script.Parent:WaitForChild("BaseLayout"))
-- owner feedback 2026-09-27: the base Training Yard (range, obstacle course, supply corner) from TrainingYardConfig
local TrainingYardBuilder = require(script.Parent.TrainingYardBuilder)
-- v70 waterways: plot water, sea gates, naval pads, road ends, rig piers (public water = Modules.Waterways)
local WaterConfig = require(SharedConfigs:WaitForChild("WaterConfig"))
-- v70 (HUD spec §5): every floating label goes through the shared helper (stud-scaled, 14-20 px, MaxDistance <= 40)
local WorldLabel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("WorldLabel"))
-- World v2: spawn pads / anchors (Spawns) and the SafetyCatch look (Bounds.SafetyCatch)
local WorldConfig = require(SharedConfigs:WaitForChild("WorldConfig"))
-- F10 (owner's 11 features): the capture zones (incl. the Home Outposts) are TerritoryConfig's rows
-- (ReplicatedStorage.Shared ships with the place and replicates before any server script runs: no wait needed)
local TerritoryConfig = require(ReplicatedStorage.Shared.Configs.TerritoryConfig)
local BaseConfig = require(ReplicatedStorage.Shared.Configs.BaseConfig) -- claude-bud JOB 21: the one plot list

local TAG_BASE = "WE_BasePlot"
local TAG_SLOT = "WE_UpgradeSlot"
local TAG_TERRITORY = "WE_Territory"
local TAG_CAPTURE = "WE_CaptureZone"
local TAG_VEHICLE = "WE_VehicleSpawn"
local TAG_WATER = "WE_Water" -- v69: boats sail on WE_Water surfaces (Constants.Tags.Water)
local TAG_NAVAL = "WE_NavalSpawn"
local TAG_NPC = "WE_NPCSpawn"
local TAG_EVENT = "WE_EventSpawn"
local TAG_TUTORIAL = "WE_TutorialMarker"
local TAG_NPC_ENTITY = "WE_NPC"
local TAG_COLLECTOR = "WE_MoneyCollector"
local TAG_PREMIUM = "WE_PremiumPad"

local COL_GROUND = Color3.fromRGB(210, 185, 130) -- pale sandy-yellow desert floor
-- v67 base look: light concrete plot floor + painted olive edge (was near-black navy + green Neon)
local BASE_LOOK = (StructureVisualConfig :: any).BaseLook or {}
local COL_PAD = BASE_LOOK.PlotFloor or Color3.fromRGB(168, 162, 148)
local COL_PAD_EDGE = BASE_LOOK.PlotEdge or Color3.fromRGB(86, 98, 64)
local COL_CHEVRON = BASE_LOOK.Chevron or Color3.fromRGB(230, 196, 70)
local COL_VEHICLE = Color3.fromRGB(48, 62, 78)
local COL_NPC = Color3.fromRGB(88, 42, 42)
local COL_EVENT = Color3.fromRGB(78, 64, 36)

local STRUCTURES = {
	{ Id = "CommandCenter", Kit = "hq", Plinth = Color3.fromRGB(36, 48, 40), Body = Color3.fromRGB(55, 78, 58), Accent = Color3.fromRGB(230, 190, 60), Roof = Color3.fromRGB(40, 55, 45) },
	{ Id = "Barracks", Kit = "barracks", Plinth = Color3.fromRGB(150, 120, 80), Body = Color3.fromRGB(175, 145, 100), Accent = Color3.fromRGB(210, 170, 80), Roof = Color3.fromRGB(130, 100, 70) },
	{ Id = "VehicleDepot", Kit = "depot", Plinth = Color3.fromRGB(40, 48, 55), Body = Color3.fromRGB(58, 72, 88), Accent = Color3.fromRGB(90, 160, 220), Roof = Color3.fromRGB(45, 55, 65) },
	{ Id = "WeaponsFacility", Kit = "armory", Plinth = Color3.fromRGB(48, 40, 38), Body = Color3.fromRGB(88, 58, 50), Accent = Color3.fromRGB(200, 90, 70), Roof = Color3.fromRGB(55, 42, 40) },
	{ Id = "Helipad", Kit = "helipad", Plinth = Color3.fromRGB(45, 50, 48), Body = Color3.fromRGB(60, 70, 65), Accent = Color3.fromRGB(220, 200, 80), Roof = Color3.fromRGB(50, 55, 52) },
	{ Id = "Dock", Kit = "dock", Plinth = Color3.fromRGB(35, 48, 58), Body = Color3.fromRGB(50, 75, 95), Accent = Color3.fromRGB(70, 180, 220), Roof = Color3.fromRGB(40, 58, 70) },
	{ Id = "Airfield", Kit = "airfield", Plinth = Color3.fromRGB(50, 52, 48), Body = Color3.fromRGB(70, 72, 68), Accent = Color3.fromRGB(180, 190, 100), Roof = Color3.fromRGB(55, 58, 52) },
	{ Id = "DefensiveWalls", Kit = "wall", Plinth = Color3.fromRGB(48, 48, 45), Body = Color3.fromRGB(85, 85, 78), Accent = Color3.fromRGB(120, 130, 110), Roof = Color3.fromRGB(60, 60, 55) },
	{ Id = "Watchtowers", Kit = "tower", Plinth = Color3.fromRGB(44, 46, 40), Body = Color3.fromRGB(72, 78, 60), Accent = Color3.fromRGB(200, 160, 70), Roof = Color3.fromRGB(50, 52, 44) },
	{ Id = "Radar", Kit = "radar", Plinth = Color3.fromRGB(40, 42, 55), Body = Color3.fromRGB(55, 60, 90), Accent = Color3.fromRGB(100, 200, 255), Roof = Color3.fromRGB(45, 48, 70) },
	{ Id = "ResearchLab", Kit = "lab", Plinth = Color3.fromRGB(38, 45, 55), Body = Color3.fromRGB(50, 70, 95), Accent = Color3.fromRGB(80, 180, 220), Roof = Color3.fromRGB(42, 55, 72) },
	{ Id = "MissileDefense", Kit = "tower", Plinth = Color3.fromRGB(48, 42, 40), Body = Color3.fromRGB(75, 55, 50), Accent = Color3.fromRGB(220, 100, 60), Roof = Color3.fromRGB(55, 45, 42) },
	{ Id = "PowerStation", Kit = "power", Plinth = Color3.fromRGB(50, 48, 35), Body = Color3.fromRGB(90, 85, 50), Accent = Color3.fromRGB(255, 210, 70), Roof = Color3.fromRGB(60, 55, 40) },
	{ Id = "Warehouse", Kit = "warehouse", Plinth = Color3.fromRGB(140, 115, 75), Body = Color3.fromRGB(165, 135, 90), Accent = Color3.fromRGB(200, 160, 90), Roof = Color3.fromRGB(120, 95, 65) },
	{ Id = "SpecialForcesFacility", Kit = "special", Plinth = Color3.fromRGB(35, 38, 42), Body = Color3.fromRGB(45, 55, 65), Accent = Color3.fromRGB(160, 80, 200), Roof = Color3.fromRGB(30, 35, 40) },
}

-- Map scale: ground ≥6000 continuous floor, plot ring ~800, pads ~200
-- Top of Ground sits ~Y=0.5 so plot pads (Y=0.5) sit flush.
local GROUND_SIZE = 7200
local GROUND_THICKNESS = 8
local GROUND_TOP_Y = 0.5
local SAFETY_FLOOR_SIZE = 10000
local SAFETY_FLOOR_Y = -28
-- v70 (spec_final §12.1): Roblox caps a BasePart at 2048 studs per axis, so the 7200 floor, the 10000 safety catch
-- and the 7200 berms / void walls are TILED (shared edges, no overlap → no z-fight). Ground: 4 x 4 tiles of 1800.
local GROUND_TILES_PER_SIDE = 4 -- 7200 / 4 = 1800 per ground tile
local SAFETY_TILES_PER_SIDE = 5 -- 10000 / 5 = 2000 per safety-catch tile
local EDGE_PIECES = 4 -- EdgeBerm* (7120 / 4 = 1780) / VoidWall* (7200 / 4 = 1800) pieces per side
local PLOT_PAD_SIZE = BaseLayout.PlotSize(200) -- v68: BaseLayoutConfig.PlotSize (320) when the layout is on
local PLOT_RING = 800
local PLOT_SPAWN_CLEARANCE = 40 -- v68: vehicle / NPC / event spawn pads stay this far outside plot edges
local STRUCT_COLS = 4
local STRUCT_GAP = 42 -- studs between upgrade pad centers (was 30)
local STRUCT_ORIGIN = Vector3.new(-63, 1.6, -63) -- CommandCenter grid origin on each plot

-- claude-bud JOB 21: the one plot list is BaseConfig.PlotPositions (MaxPlots of them); PLOT_RING stays for the ring roads
local PLOT_POSITIONS: { Vector3 } = table.clone(BaseConfig.PlotPositions :: { Vector3 })
local _ = PLOT_RING

-- World v2 (spec §3.4): each fort's wall toward its nearest road has a 16-wide gate (GateSide = the gated wall)
local FORT_GATE_WIDTH = 16

-- F10 (owner's 11 features, lane W): the capture zones come from TerritoryConfig.Territories (one source: position,
-- radius, colour, oil rig / fortress). MapSetup keeps only what is its own: the build order of the original eleven
-- (so their parts are made in the same order as before) and each fort's gate wall. Any other row (the Home Outposts
-- Starter_P1..P6 while TerritoryConfig.Starter.Enabled) is built after them, sorted by id.
local TERRITORY_BUILD_ORDER = {
	"CentralPlaza",
	"NorthRidge",
	"SouthDocks",
	"EastArmory",
	"WestDepot",
	"OilFields",
	"RadarHill",
	"CoastalOilAlpha", -- coastal oil decks (Y = the TerritoryConfig / OilRigConfig platform height)
	"CoastalOilBravo",
	"FortIronclad",
	"FortSandhold",
}
-- World v2 (spec §3.4): the fort wall facing the nearest road has the gate (1 = +Z wall, -1 = -Z wall)
local FORT_GATE_SIDE: { [string]: number } = {
	FortIronclad = 1, -- toward RoadZ-800
	FortSandhold = -1, -- toward RoadZ800
}

-- Ordered TerritoryConfig rows to build (every row exactly once)
local function territoryDefsInBuildOrder(): { TerritoryConfig.TerritoryDef }
	local rows = TerritoryConfig.Territories
	local out: { TerritoryConfig.TerritoryDef } = {}
	local seen: { [string]: boolean } = {}
	for _, id in ipairs(TERRITORY_BUILD_ORDER) do
		local def = rows[id]
		if def then
			table.insert(out, def)
			seen[id] = true
		end
	end
	local rest: { string } = {}
	for id in pairs(rows) do
		if not seen[id] then
			table.insert(rest, id)
		end
	end
	table.sort(rest)
	for _, id in ipairs(rest) do
		table.insert(out, rows[id])
	end
	return out
end

local function ensureFolder(name, parent)
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function part(props: { [string]: any })
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	-- Explicit safe assignment (avoid (p :: any)[k] = v strict/runtime quirks)
	if props.Name ~= nil then
		p.Name = props.Name
	end
	if props.Size ~= nil then
		p.Size = props.Size
	end
	if props.CFrame ~= nil then
		p.CFrame = props.CFrame
	elseif props.Position ~= nil then
		p.Position = props.Position
	end
	if props.Color ~= nil then
		p.Color = props.Color
	end
	if props.Material ~= nil then
		p.Material = props.Material
	end
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.Anchored ~= nil then
		p.Anchored = props.Anchored
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	if props.Parent ~= nil then
		p.Parent = props.Parent
	end
	-- Deco/kits: shadows off by default (huge Studio GPU win). Opt-in via CastShadow=true.
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	else
		p.CastShadow = false
	end

	return p
end

local function siteFrameOf(plinth: BasePart): CFrame
	local cf = plinth:GetAttribute("WE_SiteCFrame")
	if typeof(cf) == "CFrame" then
		return cf
	end
	return plinth.CFrame
end

local function kitPart(parentPlinth, role, size, localOffset, color, material, shape)
	local p = part({
		Name = role,
		Size = size,
		CFrame = siteFrameOf(parentPlinth) * CFrame.new(localOffset),
		Color = color,
		Material = material or Enum.Material.Metal,
		CanCollide = false,
		Transparency = 1, -- hidden until BaseService.applyKitVisuals (L0 faint / L1+ solid)
		Parent = parentPlinth,
	})
	if shape then
		p.Shape = shape
	end
	p.CanTouch = false -- never steal walk-buy Touched from plinth
	p.CanQuery = false
	p.CastShadow = false
	p:SetAttribute("WE_KitRole", role)
	p:SetAttribute("WE_BaseSize", size)
	p:SetAttribute("WE_LocalOffset", localOffset)
	p:SetAttribute("WE_Decor", true)
	return p
end

-- World v2 W1: the Neon kerb edge (neonEdge) is gone: nothing outside the bases glows; paintEdge below is the one edge

-- v67: painted kerb edge (no glow)
local function paintEdge(parentPart, color, thickness)
	local t = thickness or 0.35
	local s = parentPart.Size
	local edges = {
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, s.Z * 0.5) },
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, -s.Z * 0.5) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(s.X * 0.5, s.Y * 0.5, 0) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(-s.X * 0.5, s.Y * 0.5, 0) },
	}
	for i, e in ipairs(edges) do
		local edge = part({
			Name = "Edge" .. i,
			Size = e[1],
			CFrame = parentPart.CFrame * CFrame.new(e[2]),
			Color = color,
			Material = Enum.Material.Concrete,
			CanCollide = false,
			Parent = parentPart.Parent,
		})
		edge:SetAttribute("WE_Decor", true)
	end
end

-- v70 (HUD spec §5): no server price card on the consoles (the client draws the owner's own price tag); the old
-- always-on dark card per console is gone.

local function plainBillboard(parent, text, size, offsetY, textColor)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(size.X, size.Y)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = false -- P0: only ATM may AlwaysOnTop when nearest
	bb.MaxDistance = 70 -- base/zone labels near-only (was 950)
	bb.Parent = parent

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(12, 14, 16)
	backdrop.BackgroundTransparency = 0.22
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(70, 90, 70)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = backdrop

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor or Color3.fromRGB(235, 240, 235)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.6
	label.Parent = backdrop
	return bb
end

-- World v2 W1 (spec §5.2 row 2) / W3 step 2 lane BK: no beacon pole anywhere outside the bases (the bank's was the
-- last one; its roof StateBanner and the EMPIRE BANK sign mark it now), so the beacon helper is gone.

-- v68: terminal look for console-mode upgrade slots (screen + button); decoration only, not kit roles
local function dressConsole(plinth, title)
	local screen = part({
		Name = "ConsoleScreen",
		Size = Vector3.new(2.3, 1.3, 0.16),
		CFrame = plinth.CFrame * CFrame.new(0, BaseLayout.CONSOLE_SIZE.Y * 0.5 + 0.45, -0.25) * CFrame.Angles(math.rad(20), 0, 0),
		Color = Color3.fromRGB(14, 22, 16),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = plinth,
	})
	screen:SetAttribute("WE_Decor", true)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_ConsoleScreen"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0
	sg.MaxDistance = 40 -- v70: SurfaceGuis draw near-only (CLAUDE.md budget, <= 80)
	sg.Parent = screen
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundColor3 = Color3.fromRGB(10, 26, 16)
	lbl.BorderSizePixel = 0
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.fromRGB(120, 255, 150)
	lbl.Text = string.upper(title) .. "\nBUILD / UPGRADE"
	lbl.Parent = sg
	local button = part({
		Name = "ConsoleButton",
		Size = Vector3.new(0.5, 0.2, 0.5),
		CFrame = plinth.CFrame * CFrame.new(0.8, BaseLayout.CONSOLE_SIZE.Y * 0.5 + 0.1, -0.35),
		Color = Color3.fromRGB(90, 255, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = plinth,
	})
	button:SetAttribute("WE_Decor", true)
end

local function buildStructureKit(plotFolder, plotId, pos, offset, def)
	local plinthSize = Vector3.new(8, 1.2, 8)
	-- v68: with BaseLayoutConfig the upgrade slot is a console / kiosk and the kit or walk-in building
	-- stands at its site (WE_SiteCFrame). Buying happens at the console by prompt / tap only.
	local consoleCF = BaseLayout.ConsoleCFrame(pos, def.Id)
	local siteCF = BaseLayout.SiteCFrame(pos, def.Id)
	local isConsole = consoleCF ~= nil and siteCF ~= nil
	if isConsole then
		plinthSize = BaseLayout.CONSOLE_SIZE
	end
	local plinth = part({
		Name = def.Id,
		Size = plinthSize,
		-- legacy grid slot (layout off): plot-local offset through the plot frame (v70)
		Position = if isConsole then (consoleCF :: CFrame).Position else BaseLayout.PlotCFrame(pos):PointToWorldSpace(offset),
		Color = if isConsole then Color3.fromRGB(46, 50, 48) else def.Plinth,
		Transparency = if isConsole then 0 else 0.32,
		Material = if isConsole then Enum.Material.Metal else Enum.Material.Concrete,
		CanCollide = true,
		Parent = plotFolder,
	})
	if isConsole then
		plinth.CFrame = consoleCF :: CFrame
		plinth:SetAttribute("WE_Console", true)
		plinth:SetAttribute("WE_SiteCFrame", siteCF)
	end
	plinth.CanTouch = not isConsole -- legacy walk-over pads only
	plinth:SetAttribute("PlotId", plotId)
	plinth:SetAttribute("StructureId", def.Id)
	plinth:SetAttribute("BaseSize", plinthSize)
	CollectionService:AddTag(plinth, TAG_SLOT)

	local kit = def.Kit
	-- Visual kits v2: distinct silhouettes, painted accents (v70: no Neon), doors/windows (modest part count)
	if kit == "hq" then
		kitPart(plinth, "Body", Vector3.new(5.5, 3.4, 5.5), Vector3.new(0, 2.3, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(6.4, 0.55, 6.4), Vector3.new(0, 4.3, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.8, 0.35), Vector3.new(1.8, 6.8, 1.8), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.22, 6.6), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.1, 1.1, 1.1), Vector3.new(-2, 3.6, -2), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		kitPart(plinth, "Door", Vector3.new(1.6, 2.2, 0.25), Vector3.new(0, 1.7, -2.85), Color3.fromRGB(30, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.4, 1.0, 0.2), Vector3.new(2.0, 2.6, -2.8), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
	elseif kit == "barracks" then
		kitPart(plinth, "Body", Vector3.new(6.6, 2.6, 4.4), Vector3.new(0, 1.9, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.1, 0.5, 5.0), Vector3.new(0, 3.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(6.9, 0.18, 4.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(1.4, 2.0, 0.25), Vector3.new(0, 1.6, -2.3), Color3.fromRGB(35, 40, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.2, 0.9, 0.2), Vector3.new(-2.2, 2.3, -2.25), Color3.fromRGB(70, 120, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 1.8, 0.7), Vector3.new(-3.0, 2.3, 1.5), def.Accent, Enum.Material.SmoothPlastic, nil)
	elseif kit == "depot" then
		kitPart(plinth, "Body", Vector3.new(6.9, 2.2, 5.6), Vector3.new(0, 1.7, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.3, 0.4, 6.1), Vector3.new(0, 2.95, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(3.2, 0.28, 5.9), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(2.8, 2.0, 0.3), Vector3.new(0, 1.6, -2.9), Color3.fromRGB(40, 50, 60), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.8, 2.4, 2.0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "lab" then
		kitPart(plinth, "Body", Vector3.new(5.1, 3.2, 5.1), Vector3.new(0, 2.2, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(5.5, 0.5, 5.5), Vector3.new(0, 4.0, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 3.8, 0.4), Vector3.new(0, 6.1, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(5.7, 0.2, 5.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Window", Vector3.new(1.5, 1.2, 0.2), Vector3.new(0, 2.6, -2.6), Color3.fromRGB(80, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.9, 0.9, 0.9), Vector3.new(2.0, 3.5, 2.0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "tower" then
		kitPart(plinth, "Body", Vector3.new(2.9, 5.8, 2.9), Vector3.new(0, 3.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(3.8, 0.5, 3.8), Vector3.new(0, 6.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.3, 3.5, 0.3), Vector3.new(0, 8.5, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(3.3, 0.22, 3.3), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Window", Vector3.new(1.0, 0.8, 0.2), Vector3.new(0, 4.5, -1.5), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 0.7, 0.7), Vector3.new(0, 7.0, 0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "dock" then
		kitPart(plinth, "Body", Vector3.new(7.5, 0.55, 7.5), Vector3.new(0, 0.9, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Pier", Vector3.new(8.8, 0.4, 2.4), Vector3.new(0, 1.15, 3.3), def.Roof, Enum.Material.Wood, nil)
		kitPart(plinth, "Accent", Vector3.new(7.2, 0.14, 0.4), Vector3.new(0, 1.25, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 2.8, 0.4), Vector3.new(3.3, 2.1, 2.6), def.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(1.8, 0.3, 1.2), Vector3.new(0, 1.35, 4.2), Color3.fromRGB(40, 55, 70), Enum.Material.Metal, nil)
	elseif kit == "pad" then
		kitPart(plinth, "Body", Vector3.new(7.3, 0.45, 7.3), Vector3.new(0, 0.92, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.14, 0.5), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(0.5, 0.14, 6.6), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Roof", Vector3.new(1.6, 0.3, 1.6), Vector3.new(0, 1.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(0.5, 0.5, 0.5), Vector3.new(2.8, 1.4, 2.8), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	elseif kit == "wall" then
		kitPart(plinth, "Body", Vector3.new(7.5, 3.0, 1.5), Vector3.new(0, 2.1, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(7.7, 0.25, 1.7), Vector3.new(0, 3.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.4, 1.9), Vector3.new(0, 3.9, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(-3.2, 3.2, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(3.2, 3.2, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
	elseif kit == "power" then
		kitPart(plinth, "Body", Vector3.new(4.6, 3.6, 4.6), Vector3.new(0, 2.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(2.3, 2.3, 2.3), Vector3.new(0, 4.7, 0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		kitPart(plinth, "Roof", Vector3.new(5.1, 0.4, 5.1), Vector3.new(0, 4.4, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.6, 2.5, 0.6), Vector3.new(2.0, 2.8, 2.0), Color3.fromRGB(60, 55, 40), Enum.Material.Metal, nil)
	elseif kit == "warehouse" then
		kitPart(plinth, "Body", Vector3.new(7.1, 2.8, 5.6), Vector3.new(0, 2.0, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.5, 6.1), Vector3.new(0, 3.55, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(7.3, 0.2, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(2.6, 2.2, 0.3), Vector3.new(0, 1.7, -2.95), Color3.fromRGB(50, 45, 38), Enum.Material.Metal, nil)
	else
		kitPart(plinth, "Body", Vector3.new(5.3, 3.5, 5.3), Vector3.new(0, 2.4, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(4.2, 1.2, 4.2), Vector3.new(0, 4.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.2, 0.35), Vector3.new(0, 7.2, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(5.9, 0.22, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.0, 3.5, -2.0), def.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end

	-- Readable DisplayName for the console screen (the client's owner-only price tag uses BaseConfig names)
	local displayNames = {
		CommandCenter = "Command Center",
		Barracks = "Barracks",
		VehicleDepot = "Vehicle Depot",
		WeaponsFacility = "Weapons Facility",
		Helipad = "Helipad",
		Dock = "Naval Dock",
		Airfield = "Airfield",
		DefensiveWalls = "Defensive Walls",
		Watchtowers = "Watchtowers",
		Radar = "Radar Station",
		ResearchLab = "Research Lab",
		MissileDefense = "Missile Defense",
		PowerStation = "Power Station",
		Warehouse = "Warehouse",
		SpecialForcesFacility = "Special Forces",
	}
	local nice = displayNames[def.Id] or def.Id
	if isConsole then
		dressConsole(plinth, nice)
		-- v68: no catalog building mesh on a console (it would be placed at the console, not the site)
		return plinth
	end
	-- Optional catalog building visual — ALWAYS deferred (InsertService must never block pads/remotes)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachBuildingVisual then
				vas.TryAttachBuildingVisual(plinth, def.Id)
			end
		end)
	end)
	return plinth
end



-- Desert camo infantry Part kit — vest / helmet / shemagh accents, clearer rifle
local function makeSoldierKit(parentFolder, name, cf: CFrame, bodyColor, labelText: string?, labelColor, health, npcType, npcId)
	-- Visual props for Training Yard / static kits. R15-ready catalog overlay via VisualAssetConfig;
	-- Part-kit military placeholder (R6-ish ~5 stud) when mesh IDs missing / StudioSkipWorldDressing.
	-- Live combat NPCs use CombatService.SpawnNPC (BankGuard etc.).
	-- v72 budget: StructureVisualConfig.StaticSoldierDetail = false drops the 7 small detail parts (Shemagh, VestPouch,
	-- BootL/R, RifleStock, RifleBarrel, Accent): 9 parts per static soldier (Pack adds 1 for Heavy). No other code welds
	-- or looks up these names on a static kit.
	local detail = (StructureVisualConfig :: any).StaticSoldierDetail ~= false
	local model = Instance.new("Model")
	-- streaming2 S4 (F11): a static rig (parts, Humanoid, catalog visual) reaches a client whole or not at all. Set
	-- before the model is parented (it is filled first, parented below). No effect with streaming off.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = name
	if npcId then
		model:SetAttribute("NPCId", npcId)
	end
	if npcType then
		model:SetAttribute("NPCType", npcType)
	end
	local desertBase = Color3.fromRGB(145, 125, 85)
	local camo = desertBase:Lerp(bodyColor, 0.45)
	local camoDark = Color3.fromRGB(
		math.clamp(math.floor(camo.R * 255) - 28, 20, 255),
		math.clamp(math.floor(camo.G * 255) - 22, 20, 255),
		math.clamp(math.floor(camo.B * 255) - 18, 20, 255)
	)
	-- v34: role Part-dress differentiation when mesh IDs reuse / insert fails
	local helmCol = camoDark
	local vestCol = camoDark
	local accentCol = labelColor or Color3.fromRGB(200, 140, 60)
	local role = if typeof(npcType) == "string" then npcType else ""
	if role == "Worker" then
		helmCol = Color3.fromRGB(95, 85, 55) -- soft tan helmet
		vestCol = Color3.fromRGB(80, 95, 60)
		accentCol = Color3.fromRGB(160, 200, 90)
	elseif role == "Infantry" then
		helmCol = Color3.fromRGB(45, 70, 40) -- olive steel
		vestCol = Color3.fromRGB(55, 75, 45)
		accentCol = Color3.fromRGB(180, 220, 120)
	elseif role == "HeavyInfantry" or role == "Heavy" then
		helmCol = Color3.fromRGB(35, 38, 42) -- dark armor helm
		vestCol = Color3.fromRGB(40, 45, 50)
		accentCol = Color3.fromRGB(230, 160, 50)
	elseif role == "Guard" or role == "GateGuard" or role == "BankGuard" then
		helmCol = Color3.fromRGB(30, 40, 55) -- navy / NVG
		vestCol = Color3.fromRGB(40, 50, 65)
		accentCol = Color3.fromRGB(90, 140, 220)
	end
	-- R6 torso = 2×2×1. fb2: callers pass cf = floor top + 2.1 (the torso centre), but the legs hang 3 below the torso
	-- centre, so every static soldier stood 0.9-1.1 studs sunk into the floor. Lift the torso 0.9: the leg bottoms (and
	-- the boots, when StaticSoldierDetail is on) sit on the floor, and a catalog overlay pivoted to the HRP stands too.
	local torso = part({
		Name = "HumanoidRootPart",
		Size = Vector3.new(2, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = true,
		CFrame = cf * CFrame.new(0, 0.9, 0),
		Parent = model,
	})
	local head = part({
		Name = "Head",
		Size = Vector3.new(1.05, 1.05, 1.05),
		Color = Color3.fromRGB(110, 85, 62),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 1.55, 0),
		Shape = Enum.PartType.Ball,
		Parent = model,
	})
	-- fb2: domed steel helmet (was a flat 1.2 x 0.5 box cap). The SpecialMesh sphere fills the part's box, so the dome
	-- covers the top of the head with a small brim; a SpecialMesh is not a part (0 extra parts per soldier).
	local helmet = part({
		Name = "Helmet",
		Size = Vector3.new(1.3, 0.75, 1.35),
		Color = helmCol,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, 0.36, 0.02),
		Parent = model,
	})
	local dome = Instance.new("SpecialMesh")
	dome.MeshType = Enum.MeshType.Sphere
	dome.Parent = helmet
	if detail then
		part({
			Name = "Shemagh",
			Size = Vector3.new(1.25, 0.45, 1.15),
			Color = Color3.fromRGB(200, 185, 150),
			Material = Enum.Material.Fabric,
			Anchored = true,
			CanCollide = false,
			CFrame = head.CFrame * CFrame.new(0, -0.32, 0.05),
			Parent = model,
		})
	end
	part({
		Name = "Vest",
		Size = Vector3.new(2.1, 1.2, 1.15),
		Color = vestCol,
		Material = Enum.Material.Leather,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.15, 0),
		Parent = model,
	})
	if detail then
		part({
			Name = "VestPouch",
			Size = Vector3.new(1.5, 0.45, 0.3),
			Color = Color3.fromRGB(90, 80, 55),
			Material = Enum.Material.Fabric,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(0, 0.05, -0.6),
			Parent = model,
		})
	end
	-- R6 arms 1×2×1
	part({
		Name = "ArmL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-1.5, 0, 0),
		Parent = model,
	})
	part({
		Name = "ArmR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.5, 0, 0),
		Parent = model,
	})
	-- R6 legs 1×2×1
	part({
		Name = "LegL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "LegR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -2, 0),
		Parent = model,
	})
	if detail then
		part({
			Name = "BootL",
			Size = Vector3.new(1.05, 0.35, 1.15),
			Color = Color3.fromRGB(35, 32, 28),
			Material = Enum.Material.SmoothPlastic,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(-0.5, -2.825, 0.1), -- fb2: boot bottom = leg bottom (was 0.275 lower)
			Parent = model,
		})
	end
	if detail then
		part({
			Name = "BootR",
			Size = Vector3.new(1.05, 0.35, 1.15),
			Color = Color3.fromRGB(35, 32, 28),
			Material = Enum.Material.SmoothPlastic,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(0.5, -2.825, 0.1), -- fb2: boot bottom = leg bottom (was 0.275 lower)
			Parent = model,
		})
	end
	if detail then
		part({
			Name = "RifleStock",
			Size = Vector3.new(0.3, 0.4, 0.9),
			Color = Color3.fromRGB(55, 48, 38),
			Material = Enum.Material.Wood,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(1.15, 0.15, 0.35),
			Parent = model,
		})
	end
	part({
		Name = "Rifle",
		Size = Vector3.new(0.25, 0.25, 2.4),
		Color = Color3.fromRGB(32, 34, 36),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.2, -0.95),
		Parent = model,
	})
	if detail then
		part({
			Name = "RifleBarrel",
			Size = Vector3.new(0.14, 0.14, 0.9),
			Color = Color3.fromRGB(25, 25, 28),
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(1.15, 0.22, -2.25),
			Parent = model,
		})
	end
	if detail then
		part({
			Name = "Accent",
			Size = Vector3.new(1.6, 0.1, 0.28),
			Color = accentCol,
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(0, 0.85, -0.5),
			Parent = model,
		})
	end
	if role == "HeavyInfantry" or role == "Heavy" then
		part({
			Name = "Pack",
			Size = Vector3.new(1.4, 1.5, 0.7),
			Color = Color3.fromRGB(40, 42, 38),
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(0, 0.4, 0.85),
			Parent = model,
		})
	end
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = health or 100
	hum.Health = health or 100
	-- Single nametag only via Billboard — kill default Humanoid nameplate
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.NameOcclusion = Enum.NameOcclusion.OccludeAll
	hum.Parent = model
	model.PrimaryPart = torso
	-- Optional free Soldier catalog visual (skipped when StudioSkipWorldDressing)
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		local kind = if typeof(npcType) == "string" and npcType ~= "" then npcType else "Soldier"
		vas.TryAttachCharacterVisual(model, kind)
	end)
	model.Parent = parentFolder
	CollectionService:AddTag(model, TAG_NPC_ENTITY)
	if labelText then
		-- One clean label on head (not also on torso)
		local bb = plainBillboard(head, labelText, Vector2.new(120, 24), 2.2, labelColor or Color3.fromRGB(255, 200, 140))
		bb.Name = "NPCLabel"
		bb.AlwaysOnTop = false
		bb.MaxDistance = 18
		bb.StudsOffset = Vector3.new(0, 2.4, 0)
	end
	return model
end


-- Continuous floor + safety catch + perimeter mountain ring (mobile-friendly part count)
local function groundCenterY(): number
	return GROUND_TOP_Y - GROUND_THICKNESS * 0.5
end

-- v70 (spec_final §12.1): tiled floor layers. Every tile is <= 2000 studs per axis; neighbours share edges exactly.
type TileSpec = { Name: string, At: Vector3, Size: Vector3 }
type TileLook = { Color: Color3, Material: Enum.Material, Transparency: number }

-- centres of n equal tiles of size t that together span n * t, centred on 0
local function tileCentres(n: number, t: number): { number }
	local out: { number } = {}
	for i = 1, n do
		table.insert(out, (i - 0.5) * t - n * t * 0.5)
	end
	return out
end

-- One shared heal path (MapSetup.Run, EnsureGroundHealthy, ForceRebuildGround): build every missing tile and
-- re-assert size / position / collide on the rest (a legacy untiled part with a tile's name is resized to that tile).
-- Returns (tile count, repaired).
local function healTileSet(mapFolder: Instance, specs: { TileSpec }, look: TileLook): (number, boolean)
	local repaired = false
	for _, t in ipairs(specs) do
		local existing = mapFolder:FindFirstChild(t.Name)
		if existing and existing:IsA("BasePart") then
			if existing.Size ~= t.Size or (existing.Position - t.At).Magnitude > 0.01 or existing.CanCollide ~= true or existing.Anchored ~= true then
				repaired = true
			end
			existing.Size = t.Size
			existing.CFrame = CFrame.new(t.At)
			existing.CanCollide = true
			existing.Anchored = true
			existing.Color = look.Color
			existing.Material = look.Material
			existing.Transparency = look.Transparency
		else
			if existing then
				existing:Destroy()
			end
			part({
				Name = t.Name,
				Size = t.Size,
				Position = t.At,
				Color = look.Color,
				Material = look.Material,
				Transparency = look.Transparency,
				CanCollide = true,
				Anchored = true,
				Parent = mapFolder,
			})
			repaired = true
		end
	end
	return #specs, repaired
end

-- destroy the part named `base` and every "<base>_..." piece
local function destroyNamed(mapFolder: Instance, base: string)
	for _, ch in ipairs(mapFolder:GetChildren()) do
		if ch.Name == base or string.sub(ch.Name, 1, #base + 1) == base .. "_" then
			ch:Destroy()
		end
	end
end

-- Ground: 4 x 4 tiles of 1800 x 8 x 1800, top at GROUND_TOP_Y. The tile centred at (-900, -900) keeps the name
-- "Ground" (Bootstrap and the heal checks read Map.Ground); the others are GroundTile_<i>_<j>.
local function groundTileSpecs(): { TileSpec }
	local out: { TileSpec } = {}
	local tile = GROUND_SIZE / GROUND_TILES_PER_SIDE
	local cs = tileCentres(GROUND_TILES_PER_SIDE, tile)
	for i, x in ipairs(cs) do
		for j, z in ipairs(cs) do
			local name = if x == -tile * 0.5 and z == -tile * 0.5 then "Ground" else ("GroundTile_" .. i .. "_" .. j)
			table.insert(out, { Name = name, At = Vector3.new(x, groundCenterY(), z), Size = Vector3.new(tile, GROUND_THICKNESS, tile) })
		end
	end
	return out
end

local function buildGroundTiles(mapFolder: Instance): (number, boolean)
	return healTileSet(mapFolder, groundTileSpecs(), { Color = COL_GROUND, Material = Enum.Material.Sand, Transparency = 0 })
end

-- number of ground tiles that exist, collide and have full tile size (Bootstrap health check)
local function countHealthyGroundTiles(mapFolder: Instance): number
	local n = 0
	for _, t in ipairs(groundTileSpecs()) do
		local p = mapFolder:FindFirstChild(t.Name)
		if p and p:IsA("BasePart") and p.CanCollide and p.Size.X >= t.Size.X - 1 and p.Size.Z >= t.Size.Z - 1 then
			n += 1
		end
	end
	return n
end

-- SafetyCatch: 5 x 5 tiles of 2000 (the centre one keeps the name SafetyCatch)
local function buildSafetyUnderfloor(mapFolder: Instance): (number, boolean)
	local specs: { TileSpec } = {}
	local tile = SAFETY_FLOOR_SIZE / SAFETY_TILES_PER_SIDE
	for i, x in ipairs(tileCentres(SAFETY_TILES_PER_SIDE, tile)) do
		for j, z in ipairs(tileCentres(SAFETY_TILES_PER_SIDE, tile)) do
			local name = if x == 0 and z == 0 then "SafetyCatch" else ("SafetyCatch_" .. i .. "_" .. j)
			table.insert(specs, { Name = name, At = Vector3.new(x, SAFETY_FLOOR_Y, z), Size = Vector3.new(tile, 4, tile) })
		end
	end
	-- World v2 (spec §1.4): opaque sand (was Slate, Transparency 0.92), so a ray that clears the skyline meets a
	-- sand-coloured plain instead of the void; an opaque floor is also cheaper to draw on phones
	local look = WorldConfig.Bounds.SafetyCatch
	return healTileSet(mapFolder, specs, { Color = look.Color, Material = look.Material, Transparency = look.Transparency })
end

-- one ring side = EDGE_PIECES pieces: <prefix><N|S|E|W> (first piece keeps the legacy name), then _2 .. _4
local function edgeRingSpecs(prefix: string, inset: number, length: number, height: number, thick: number, y: number): { TileSpec }
	local out: { TileSpec } = {}
	local half = GROUND_SIZE * 0.5 - inset
	local piece = length / EDGE_PIECES
	for _, side in ipairs({ "N", "S", "E", "W" }) do
		local alongX = side == "N" or side == "S"
		local sgn = if side == "N" or side == "W" then -1 else 1
		for k, c in ipairs(tileCentres(EDGE_PIECES, piece)) do
			table.insert(out, {
				Name = prefix .. side .. (if k == 1 then "" else ("_" .. k)),
				At = if alongX then Vector3.new(c, y, sgn * half) else Vector3.new(sgn * half, y, c),
				Size = if alongX then Vector3.new(piece, height, thick) else Vector3.new(thick, height, piece),
			})
		end
	end
	return out
end

local function buildEdgeBerms(mapFolder: Instance): (number, boolean)
	-- Soft inner berm just inside Ground edge (keeps stroll-off from feeling like cliff)
	local bermH = 18
	local specs = edgeRingSpecs("EdgeBerm", 40, GROUND_SIZE - 80, bermH, 28, GROUND_TOP_Y + bermH * 0.5)
	return healTileSet(mapFolder, specs, { Color = Color3.fromRGB(185, 155, 105), Material = Enum.Material.Sand, Transparency = 0 })
end


local function buildInvisibleWalls(mapFolder: Instance): (number, boolean)
	-- Tall invisible perimeter so players cannot walk off Ground into void/water
	local wallH = 80
	local specs = edgeRingSpecs("VoidWall", 8, GROUND_SIZE, wallH, 12, GROUND_TOP_Y + wallH * 0.5)
	return healTileSet(mapFolder, specs, { Color = Color3.fromRGB(40, 50, 40), Material = Enum.Material.SmoothPlastic, Transparency = 1 })
end

-- World v2 W1 (spec §1.6): buildMountainRing (the 14-mesa Part ring past the berm) and buildVisualFillPatches are
-- gone. The edge is WorldTerrain (Terrain canyon) + WorldBounds (skyline, walls, far shore); Phase 2 paints ground patches
-- as Terrain.

local function buildOilDeckRamp(parent: Folder, territoryId: string, deckPos: Vector3, towardCenter: Vector3)
	--[[
		Stepped collide stairs from elevated oil deck (~Y=28) down to ground.
		towardCenter = horizontal direction from deck toward map center (inland).
		v70: the stairs now really run toward towardCenter (they subtracted dir, so they ran out to sea); on the
		waterways map they are the rig's pier across the lagoon to the inner bank (spec_final §7.1).
	]]
	local dir = Vector3.new(towardCenter.X, 0, towardCenter.Z)
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(if deckPos.X >= 0 then -1 else 1, 0, 0)
	end
	dir = dir.Unit
	local deckTopY = deckPos.Y
	local steps = 10
	local rise = (deckTopY - GROUND_TOP_Y) / steps
	local run = 9
	local stepW = 22
	local stepT = 7.5
	-- Start just outside the 48-stud deck toward inland
	local edge = Vector3.new(deckPos.X, 0, deckPos.Z) + dir * 26
	for s = 1, steps do
		local y = deckTopY - rise * s + 0.6
		local horiz = edge + dir * (run * s)
		local stepAt = Vector3.new(horiz.X, y, horiz.Z)
		part({
			Name = territoryId .. "_RampStep" .. s,
			Size = Vector3.new(stepW, 1.3, stepT),
			CFrame = CFrame.lookAt(stepAt, stepAt + dir),
			Color = Color3.fromRGB(75, 78, 82),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Anchored = true,
			Parent = parent,
		})
	end
	local midHoriz = edge + dir * (run * 5)
	part({
		Name = territoryId .. "_RampShelf",
		Size = Vector3.new(28, 1.4, 14),
		Position = Vector3.new(midHoriz.X, deckTopY - rise * 5, midHoriz.Z),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Metal,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
	local approach = edge + dir * (run * steps + 10)
	part({
		Name = territoryId .. "_RampApproach",
		Size = Vector3.new(30, 1, 18),
		Position = Vector3.new(approach.X, GROUND_TOP_Y + 0.45, approach.Z),
		Color = Color3.fromRGB(55, 60, 55),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
end


local MapSetup = {}

-- Exported for Bootstrap ground heal / verify
MapSetup.GROUND_SIZE = GROUND_SIZE
MapSetup.GROUND_THICKNESS = GROUND_THICKNESS
MapSetup.GROUND_TOP_Y = GROUND_TOP_Y
MapSetup.SAFETY_FLOOR_SIZE = SAFETY_FLOOR_SIZE
MapSetup.SAFETY_FLOOR_Y = SAFETY_FLOOR_Y
-- v70: the ground is tiled (§12.1); Bootstrap checks the tiles, not one 7200 part
MapSetup.GROUND_TILE_SIZE = GROUND_SIZE / GROUND_TILES_PER_SIDE
MapSetup.GROUND_TILES = GROUND_TILES_PER_SIDE * GROUND_TILES_PER_SIDE
-- v70: stamped on WarEmpireSetup (WE_MapGen). Bootstrap rebuilds a saved / baked map whose stamp differs, so a place
-- saved with an older layout (unturned plots, one WaterPlane) never keeps it. The stamp also encodes
-- BaseLayoutConfig.FaceMapCentre (even = off, odd = on), so flipping the flag rebuilds a map baked with the other value.
-- World v2 W1: 70/71 → 80/81, so a saved map with the mesa ring, statues, beacons and old spawn rings is rebuilt.
-- F1 / F10 (owner's 11 features): 80/81 → 82/83 (the ATM pads follow MonetizationConfig.PremiumPads: no VIP pad), and
-- +10 while TerritoryConfig.Starter.Enabled (the 6 Home Outpost kits), so flipping that flag also rebuilds a baked map.
-- +10 keeps the FaceMapCentre parity (even = off, odd = on).
MapSetup.MAP_GEN = (if BaseLayout.FacesMapCentre() then 83 else 82) + (if TerritoryConfig.Starter.Enabled then 10 else 0)

--[[ claude-bud (runway fix): v90 made the runway 190 x 29 and the hangar 68 x 40 in config but kept MAP_GEN, so a place
	saved with a pre-v90 WarEmpireSetup kept its 170 x 24 runway (Bootstrap only heals a same-gen map). This hash of the
	plot layout geometry (every road rectangle, structure site and installation footprint) is stamped as WE_LayoutSig;
	Bootstrap rebuilds a saved map whose stamp differs, so a layout edit never needs a MAP_GEN bump again. ]]
local function layoutSignature(): number
	local cfg = BaseLayout.Config()
	local rows: { string } = {}
	for _, r in ipairs(cfg.Roads or {}) do
		table.insert(rows, string.format("R%s:%g,%g,%g,%g", tostring(r.Name), r.X, r.Z, r.SizeX, r.SizeZ))
	end
	for id, s in pairs(cfg.Structures or {}) do
		local site = s.Site or {}
		table.insert(rows, string.format("S%s:%g,%g,%g", tostring(id), tonumber(site.X) or 0, tonumber(site.Z) or 0, tonumber(s.Yaw) or 0))
	end
	for id, c in pairs((StructureVisualConfig :: any).Installations or {}) do
		table.insert(rows, string.format("I%s:%g,%g", tostring(id), tonumber(c.Width) or 0, tonumber(c.Depth) or 0))
	end
	-- claude-bud JOB 21: the plot list too, so a map saved with fewer plots is rebuilt
	for i, p in ipairs(BaseConfig.PlotPositions :: { Vector3 }) do
		table.insert(rows, string.format("P%d:%g,%g", i, p.X, p.Z))
	end
	table.sort(rows)
	local text = table.concat(rows, ";")
	local h = 5381
	for i = 1, #text do
		h = (h * 33 + string.byte(text, i)) % 4294967296
	end
	return h
end
MapSetup.LAYOUT_SIG = layoutSignature()

-- v70: healthy ground tiles under setup.Map (Bootstrap "Ground AFTER heal" check)
function MapSetup.CountGroundTiles(setup: Instance): number
	local map = setup:FindFirstChild("Map")
	if not map then
		return 0
	end
	return countHealthyGroundTiles(map)
end

local function buildPadSupportShelves(setup: Folder)
	--[[
		Collide shelves under elevated upgrade pads / decks so players never
		treat CanCollide=false kit deco as floor. Fills air gap pad→Ground.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return
	end
	local folder = map:FindFirstChild("PadSupports")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "PadSupports"
	folder.Parent = map

	local CollectionService = game:GetService("CollectionService")
	local TAG = TAG_SLOT
	local count = 0
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		-- v68: consoles stand on the plot floor; their height is not an air gap to fill
		if inst:IsA("BasePart") and inst:IsDescendantOf(setup) and inst:GetAttribute("WE_Console") ~= true then
			local topY = inst.Position.Y + inst.Size.Y * 0.5
			local gap = topY - GROUND_TOP_Y
			if gap > 2.5 then
				local shelfH = math.clamp(gap - 0.5, 1, 40)
				local shelfY = GROUND_TOP_Y + shelfH * 0.5
				part({
					Name = "PadShelf_" .. tostring(count),
					Size = Vector3.new(math.max(inst.Size.X + 4, 12), shelfH, math.max(inst.Size.Z + 4, 12)),
					Position = Vector3.new(inst.Position.X, shelfY, inst.Position.Z),
					Color = Color3.fromRGB(90, 85, 70),
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Anchored = true,
					Parent = folder,
				})
				count += 1
			end
		end
	end
	-- Also sweep StructureId parts under Bases (tag may lag)
	local bases = setup:FindFirstChild("Bases")
	if bases then
		for _, desc in ipairs(bases:GetDescendants()) do
			if desc:IsA("BasePart") then
				local sid = desc:GetAttribute("StructureId")
				if typeof(sid) == "string" and desc:GetAttribute("WE_Console") ~= true then
					local topY = desc.Position.Y + desc.Size.Y * 0.5
					local gap = topY - GROUND_TOP_Y
					if gap > 2.5 then
						-- Skip if already covered by a nearby shelf
						local covered = false
						for _, child in ipairs(folder:GetChildren()) do
							if child:IsA("BasePart") then
								local dx = child.Position.X - desc.Position.X
								local dz = child.Position.Z - desc.Position.Z
								if dx * dx + dz * dz < 25 then
									covered = true
									break
								end
							end
						end
						if not covered then
							local shelfH = math.clamp(gap - 0.5, 1, 40)
							local shelfY = GROUND_TOP_Y + shelfH * 0.5
							part({
								Name = "PadShelf_" .. tostring(count),
								Size = Vector3.new(math.max(desc.Size.X + 4, 12), shelfH, math.max(desc.Size.Z + 4, 12)),
								Position = Vector3.new(desc.Position.X, shelfY, desc.Position.Z),
								Color = Color3.fromRGB(90, 85, 70),
								Material = Enum.Material.Concrete,
								CanCollide = true,
								Anchored = true,
								Parent = folder,
							})
							count += 1
						end
					end
				end
			end
		end
	end
	if count > 0 then
		print("[WAR EMPIRE] MapSetup: PadSupports shelves=" .. tostring(count) .. " (collide fillers under elevated pads)")
	end
end

function MapSetup.EnsureGroundHealthy(setup: Instance): boolean
	--[[
		Soft-heal existing WarEmpireSetup Ground / SafetyCatch.
		Returns true if healthy (or repaired in place), false if caller should rebuild.
		v70: re-asserts all 16 ground tiles, the 25 safety-catch tiles and every berm / void-wall piece (a legacy
		single 7200 Ground is resized to its tile and the missing tiles are built).
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	local ground = map:FindFirstChild("Ground")
	if not (ground and ground:IsA("BasePart")) then
		return false
	end
	-- Always force full-size collide Ground every Play (bulletproof void floor)
	local tiles, repaired = buildGroundTiles(map)
	local _, catchRepaired = buildSafetyUnderfloor(map)
	repaired = repaired or catchRepaired

	-- World v2 W1: no Part mountain ring to heal any more (the edge is Terrain + WorldBounds, rebuilt by MapSetup.Run)
	local _, bermRepaired = buildEdgeBerms(map)
	local _, wallRepaired = buildInvisibleWalls(map)
	repaired = repaired or bermRepaired or wallRepaired

	buildPadSupportShelves(setup :: Folder)

	print(string.format(
		"[WAR EMPIRE] Ground heal: ok size=%.0fx%.0fx%.0f tiles=%d/%d CanCollide=%s repaired=%s",
		ground.Size.X,
		ground.Size.Y,
		ground.Size.Z,
		countHealthyGroundTiles(map),
		tiles,
		tostring(ground.CanCollide),
		tostring(repaired)
	))
	return true
end




function MapSetup.ForceRebuildGround(setup: Instance): boolean
	--[[
		Hard rebuild: destroy Map.Ground + SafetyCatch and recreate them.
		Use every Play when soft-heal is not enough (stale holes / void gaps).
		Does NOT rebuild the whole WarEmpireSetup — only the collide floor layers.
		v70: every ground / safety-catch tile and every berm / void-wall piece.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	destroyNamed(map, "Ground")
	destroyNamed(map, "GroundTile")
	destroyNamed(map, "SafetyCatch")

	local tiles = buildGroundTiles(map)
	buildSafetyUnderfloor(map)
	-- Refresh berms + invisible void walls every force rebuild
	for _, name in ipairs({ "EdgeBermN", "EdgeBermS", "EdgeBermE", "EdgeBermW", "VoidWallN", "VoidWallS", "VoidWallE", "VoidWallW" }) do
		destroyNamed(map, name)
	end
	buildEdgeBerms(map)
	buildInvisibleWalls(map)
	buildPadSupportShelves(setup :: Folder)

	local healthy = countHealthyGroundTiles(map)
	local ground = map:FindFirstChild("Ground")
	local g = if ground and ground:IsA("BasePart") then ground else nil
	print(string.format(
		"[WAR EMPIRE] Ground FORCE-REBUILT: size=%.0fx%.0fx%.0f tiles=%d/%d CanCollide=%s Anchored=%s",
		if g then g.Size.X else 0,
		if g then g.Size.Y else 0,
		if g then g.Size.Z else 0,
		healthy,
		tiles,
		tostring(g ~= nil and g.CanCollide),
		tostring(g ~= nil and g.Anchored)
	))
	return healthy == tiles and g ~= nil and g.Size.Y >= GROUND_THICKNESS - 0.5
end



-- v68: layout ground work (BaseLayoutConfig): roads + plaza + runway markings, parade flagpole, dock basin,
-- and the inner wall with one guarded gate per rear-zone structure. Gate leaves are opened/closed by
-- StructureKitBuilder.SyncRearGates when the matching structure (Airfield / Helipad / Dock) is bought.
local REAR_GATE_LABELS = { Airfield = "AIRFIELD", Helipad = "HELIPAD", Dock = "NAVAL DOCK" }

-- v70 [J3/J4]: shared look + flags for every WE_Water part MapSetup builds (DockWater, SeaGateWater). Water parts never
-- collide, touch or take raycasts (the vehicles' water query is geometric over the tagged parts; combat rays reach the
-- real floor) and cast no shadow.
local function styleWaterPart(w: BasePart, waterId: string)
	w.Reflectance = WaterConfig.Look.Reflectance
	w.CanCollide = false
	w.CanTouch = false
	w.CanQuery = false
	w.CastShadow = false
	w:SetAttribute("WE_WaterId", waterId)
	CollectionService:AddTag(w, TAG_WATER)
end

local function buildLayoutGround(plotFolder: Folder, plotId: number, pos: Vector3)
	if not BaseLayout.Enabled() then
		return
	end
	local cfg = BaseLayout.Config()
	local look = (StructureVisualConfig :: any).BaseLook or {}
	-- v70: everything below is plot-local (BaseLayoutConfig frame) and placed through the plot frame F, so the whole
	-- layout turns with the plot when BaseLayoutConfig.FaceMapCentre is on (F = CFrame.new(pos) while it is off).
	local F = BaseLayout.PlotCFrame(pos)
	local padTop = 0.5 -- plot-local: the pad is 1 stud thick, centred on pos
	local function at(x: number, y: number, z: number): CFrame
		return F * CFrame.new(x, y, z)
	end
	local H = cfg.PlotSize * 0.5
	local folder = Instance.new("Folder")
	folder.Name = "LayoutGround"
	folder.Parent = plotFolder
	local asphalt = Color3.fromRGB(64, 66, 64)
	local paint = Color3.fromRGB(236, 232, 214)
	local yellow = look.Chevron or Color3.fromRGB(230, 196, 70)
	local steel = Color3.fromRGB(70, 74, 72)
	-- v70: the sea gate (and the channel behind it) exists only when the plots face the map centre
	local seaGate = BaseLayout.FacesMapCentre() and WaterConfig.Enabled == true
	local SG = WaterConfig.SeaGate
	local waterMidY = (WaterConfig.BottomY + WaterConfig.SurfaceY) * 0.5
	local waterH = WaterConfig.SurfaceY - WaterConfig.BottomY

	-- Roads, plaza, runway, taxiway, apron
	for _, r in ipairs(cfg.Roads) do
		local road = part({
			Name = "Road_" .. r.Name,
			Size = Vector3.new(r.SizeX, 0.12, r.SizeZ),
			CFrame = at(r.X, padTop + 0.06, r.Z),
			Color = asphalt,
			Material = Enum.Material.Asphalt,
			CanCollide = true,
			Parent = folder,
		})
		road:SetAttribute("WE_Decor", true)
		local alongX = r.SizeX >= r.SizeZ
		local len = if alongX then r.SizeX else r.SizeZ
		local markY = padTop + 0.13
		if r.Name == "Runway" then
			-- dashed white centreline + threshold bars at both ends
			local n = math.floor(len / 14)
			for i = 0, n - 1 do
				local t = -len * 0.5 + 7 + i * 14
				part({
					Name = "RunwayDash",
					Size = if alongX then Vector3.new(7, 0.02, 0.9) else Vector3.new(0.9, 0.02, 7),
					CFrame = at(r.X + (if alongX then t else 0), markY, r.Z + (if alongX then 0 else t)),
					Color = paint,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Parent = folder,
				})
			end
			for _, endSign in ipairs({ -1, 1 }) do
				for b = -3, 3 do
					local along = endSign * (len * 0.5 - 4)
					local across = b * 2.6
					part({
						Name = "RunwayThreshold",
						Size = if alongX then Vector3.new(6, 0.02, 1.2) else Vector3.new(1.2, 0.02, 6),
						CFrame = at(r.X + (if alongX then along else across), markY, r.Z + (if alongX then across else along)),
						Color = paint,
						Material = Enum.Material.SmoothPlastic,
						CanCollide = false,
						Parent = folder,
					})
				end
			end
		elseif r.Name == "Taxiway" or r.Name == "HeliApron" then
			part({
				Name = "TaxiLine",
				Size = if alongX then Vector3.new(len - 2, 0.02, 0.5) else Vector3.new(0.5, 0.02, len - 2),
				CFrame = at(r.X, markY, r.Z),
				Color = yellow,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		else
			-- white edge lines on the compound roads
			for _, side in ipairs({ -1, 1 }) do
				local off = side * ((if alongX then r.SizeZ else r.SizeX) * 0.5 - 0.6)
				part({
					Name = "RoadEdge",
					Size = if alongX then Vector3.new(len - 1, 0.02, 0.35) else Vector3.new(0.35, 0.02, len - 1),
					CFrame = at(r.X + (if alongX then 0 else off), markY, r.Z + (if alongX then off else 0)),
					Color = paint,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Parent = folder,
				})
			end
		end
	end

	-- Parade-ground flagpole
	do
		local f = cfg.Courtyard.Flagpole
		part({ Name = "FlagBase", Size = Vector3.new(4, 1, 4), CFrame = at(f.X, padTop + 0.5, f.Z), Color = Color3.fromRGB(150, 146, 134), Material = Enum.Material.Concrete, CanCollide = true, Parent = folder })
		part({ Name = "FlagPole", Size = Vector3.new(0.5, 28, 0.5), CFrame = at(f.X, padTop + 15, f.Z), Color = steel, Material = Enum.Material.Metal, CanCollide = true, Parent = folder })
		-- fb2: flag cloths are 0.12 thick and tagged WE_FlagHost (the nation flag binds to their Left / Right faces)
		local paradeFlag = part({ Name = "ParadeFlag", Size = Vector3.new(0.12, 4.4, 7.5), CFrame = at(f.X, padTop + 25.8, f.Z - 3.9), Color = Color3.fromRGB(70, 110, 60), Material = Enum.Material.Fabric, CanCollide = false, Parent = folder })
		paradeFlag:SetAttribute("WE_FlagHost", true)
	end

	-- Dock basin: water surface + concrete kerb
	do
		local d = cfg.Courtyard.DockBasin
		-- v70 [J3/J4]: one water level for the whole map (WaterConfig.BottomY..SurfaceY = 0.3..1.5). The part is TURNED
		-- WITH THE PLOT (exact quarter turn, unchanged world AABB), so the vehicles' basin spawn heading (the part's yaw)
		-- points the bow at the sea gate. DockWater is the only plot water part with WE_PlotId.
		local water = part({
			Name = "DockWater",
			Size = Vector3.new(d.SizeX, waterH, d.SizeZ),
			CFrame = BaseLayout.PlotLocalCFrame(pos, d.X, waterMidY - pos.Y, d.Z),
			Color = WaterConfig.Look.Color,
			Material = WaterConfig.Look.Material,
			Transparency = WaterConfig.Look.Transparency,
			CanCollide = false,
			Parent = folder,
		})
		styleWaterPart(water, "DockWater")
		water:SetAttribute("WE_PlotId", plotId)
		-- kerbs: plot-local boxes { size, centre }
		local kx0, kx1 = d.X - d.SizeX * 0.5 - 1.2, d.X + d.SizeX * 0.5 + 1.2 -- 101.8 .. 154.2
		local rearZ = d.Z - d.SizeZ * 0.5 - 0.6
		local kerbs: { { Vector3 } } = {
			{ Vector3.new(d.SizeX + 2.4, 1, 1.2), Vector3.new(d.X, padTop + 0.5, d.Z + d.SizeZ * 0.5 + 0.6) },
		}
		if seaGate then
			-- v70 §4: the rear kerb opens onto the gate water (stubs either side) and two short kerbs line the gate water
			-- from the basin to the gate posts
			local sideZ0, sideZ1 = SG.WallZ + SG.PostDepth * 0.5, SG.BasinRearZ -- -156.8 .. -147
			table.insert(kerbs, { Vector3.new(SG.X0 - kx0, 1, 1.2), Vector3.new((kx0 + SG.X0) * 0.5, padTop + 0.5, rearZ) })
			table.insert(kerbs, { Vector3.new(kx1 - SG.X1, 1, 1.2), Vector3.new((SG.X1 + kx1) * 0.5, padTop + 0.5, rearZ) })
			table.insert(kerbs, { Vector3.new(1.2, 1, sideZ1 - sideZ0), Vector3.new(SG.X0 - 0.6, padTop + 0.5, (sideZ0 + sideZ1) * 0.5) })
			table.insert(kerbs, { Vector3.new(1.2, 1, sideZ1 - sideZ0), Vector3.new(SG.X1 + 0.6, padTop + 0.5, (sideZ0 + sideZ1) * 0.5) })
		else
			table.insert(kerbs, { Vector3.new(d.SizeX + 2.4, 1, 1.2), Vector3.new(d.X, padTop + 0.5, rearZ) })
		end
		table.insert(kerbs, { Vector3.new(1.2, 1, d.SizeZ), Vector3.new(d.X + d.SizeX * 0.5 + 0.6, padTop + 0.5, d.Z) })
		table.insert(kerbs, { Vector3.new(1.2, 1, d.SizeZ), Vector3.new(d.X - d.SizeX * 0.5 - 0.6, padTop + 0.5, d.Z) })
		for _, e in ipairs(kerbs) do
			part({ Name = "DockKerb", Size = e[1], CFrame = F * CFrame.new(e[2]), Color = Color3.fromRGB(150, 146, 134), Material = Enum.Material.Concrete, CanCollide = true, Parent = folder })
		end
	end

	-- Inner wall with guarded gates
	local iw = cfg.InnerWall
	local zc = iw.Z
	local wallCol = (StructureVisualConfig.Palettes.DefensiveWalls and StructureVisualConfig.Palettes.DefensiveWalls.Body) or Color3.fromRGB(178, 170, 148)
	local half = iw.GateWidth * 0.5
	local function wallSeg(a: number, b: number)
		if b - a < 0.5 then
			return
		end
		part({
			Name = "InnerWall",
			Size = Vector3.new(b - a, iw.Height, iw.Thickness),
			CFrame = at((a + b) * 0.5, padTop + iw.Height * 0.5, zc),
			Color = wallCol,
			Material = Enum.Material.Concrete,
			CanCollide = true,
			CastShadow = true,
			Parent = folder,
		})
		part({
			Name = "InnerWallCap",
			Size = Vector3.new(b - a + 0.3, 0.5, iw.Thickness + 0.3),
			CFrame = at((a + b) * 0.5, padTop + iw.Height + 0.25, zc),
			Color = look.WallCap or Color3.fromRGB(132, 126, 110),
			Material = Enum.Material.Concrete,
			CanCollide = false,
			Parent = folder,
		})
	end
	local gates = {}
	for id, g in pairs(iw.Gates) do
		table.insert(gates, { Id = id, X = g.X })
	end
	table.sort(gates, function(a, b)
		return a.X < b.X
	end)
	local cursor = -H
	for _, g in ipairs(gates) do
		wallSeg(cursor, g.X - half)
		cursor = g.X + half

		local gateFolder = Instance.new("Folder")
		gateFolder.Name = "RearGate_" .. g.Id
		gateFolder:SetAttribute("GateId", g.Id)
		gateFolder:SetAttribute("PlotId", plotId)
		gateFolder.Parent = folder
		local gx = g.X
		for _, sx in ipairs({ -1, 1 }) do
			-- v70: "RearGatePost" (was "GatePost"): GateDefenseService's no-perimeter fallback collects every descendant
			-- named GatePost under the plot and must only ever see the perimeter main-gate posts
			part({
				Name = "RearGatePost",
				Size = Vector3.new(1.6, iw.Height + 1.5, iw.Thickness + 1),
				CFrame = at(gx + sx * (half + 0.8), padTop + (iw.Height + 1.5) * 0.5, zc),
				Color = steel,
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = gateFolder,
			})
		end
		local lintel = part({
			Name = "GateLintel",
			Size = Vector3.new(iw.GateWidth + 3.2, 2.2, iw.Thickness + 0.6),
			CFrame = at(gx, padTop + iw.Height + 0.6, zc),
			Color = Color3.fromRGB(40, 44, 42),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Parent = gateFolder,
		})
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_GateSign"
		sg.Face = Enum.NormalId.Back -- plot-local +Z: faces the main compound
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.MaxDistance = 80 -- v70: painted sign, near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = lintel
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Text"
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundColor3 = Color3.fromRGB(20, 22, 20)
		lbl.BorderSizePixel = 0
		lbl.Font = Enum.Font.GothamBlack
		lbl.TextScaled = true
		lbl.TextColor3 = yellow
		lbl.Text = (REAR_GATE_LABELS[g.Id] or string.upper(g.Id)) .. " · LOCKED"
		lbl.Parent = sg
		-- v72 (phone HUD audit F4): inset the sign text so the gate name reads in full (TextScaled filled the whole
		-- board and clipped at the edges); InnerWall.SignInsetStuds x PixelsPerStud left/right, capped text size
		do
			local insetPx = math.floor(((BaseLayout.Config().InnerWall or {}).SignInsetStuds or 2.0) * sg.PixelsPerStud + 0.5)
			local signPad = Instance.new("UIPadding")
			signPad.PaddingLeft = UDim.new(0, insetPx)
			signPad.PaddingRight = UDim.new(0, insetPx)
			signPad.PaddingTop = UDim.new(0, 6)
			signPad.PaddingBottom = UDim.new(0, 6)
			signPad.Parent = lbl
			local signCap = Instance.new("UITextSizeConstraint")
			signCap.MaxTextSize = 64
			signCap.Parent = lbl
		end
		local leafH = iw.Height - 2
		for i, sx in ipairs({ -1, 1 }) do
			local leaf = part({
				Name = "GateLeaf" .. i,
				Size = Vector3.new(half - 0.1, leafH, 0.8),
				CFrame = at(gx + sx * half * 0.5, padTop + leafH * 0.5, zc),
				Color = Color3.fromRGB(78, 84, 80),
				Material = Enum.Material.DiamondPlate,
				CanCollide = true,
				Parent = gateFolder,
			})
			leaf:SetAttribute("WE_GateLeaf", sx)
			leaf:SetAttribute("WE_ClosedCFrame", leaf.CFrame)
			part({
				Name = "GateStripe",
				Size = Vector3.new(half - 0.1, 0.8, 0.9),
				CFrame = leaf.CFrame * CFrame.new(0, -leafH * 0.5 + 2.2, 0),
				Color = yellow,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = leaf,
			})
		end
		-- Two guards with sandbags on the compound side
		for _, sx in ipairs({ -1, 1 }) do
			local gLocal = Vector3.new(gx + sx * (half + 3.6), padTop + 2.1, zc + iw.Thickness * 0.5 + 2.4)
			part({
				Name = "GuardSandbag",
				Size = Vector3.new(4.2, 1.3, 1.3),
				CFrame = at(gLocal.X, padTop + 0.65, gLocal.Z + 2.2),
				Color = Color3.fromRGB(186, 164, 118),
				Material = Enum.Material.Fabric,
				CanCollide = true,
				Parent = gateFolder,
			})
			-- v70 (HUD spec §5): no "GUARD" NPCLabel over the rear-gate guards
			makeSoldierKit(
				gateFolder,
				"GateGuard_" .. g.Id .. (if sx > 0 then "R" else "L"),
				F * CFrame.new(gLocal) * CFrame.Angles(0, math.rad(180), 0),
				Color3.fromRGB(62, 72, 52),
				nil,
				Color3.fromRGB(140, 150, 130),
				150,
				"Guard",
				nil
			)
		end
	end
	wallSeg(cursor, H)

	-- v70 [J1] sea gate (spec_final §4): on the rear perimeter line behind the dock basin, plot-local x SG.X0..SG.X1.
	-- Two collidable leaves (12 tall together) close it; StructureKitBuilder.SyncRearGates only ARMS it (Dock L1+) and
	-- Waterways' loop slides the leaves west into the wall line while a boat driven by the owner / a clan-mate is near.
	-- A WE_WallGap marker makes SyncPerimeterWalls leave the wall open across the gate.
	if seaGate then
		local gx = (SG.X0 + SG.X1) * 0.5
		local span = SG.X1 - SG.X0
		local gate = Instance.new("Folder")
		gate.Name = "SeaGate_Dock"
		gate:SetAttribute("GateId", "Dock")
		gate:SetAttribute("PlotId", plotId)
		gate:SetAttribute("WE_GateMode", "Proximity")
		gate:SetAttribute("WE_GateLabel", SG.Label)
		gate:SetAttribute("WE_GateArmed", false)
		gate:SetAttribute("WE_GateOpen", false)
		gate:SetAttribute("WE_GateCentre", F:PointToWorldSpace(Vector3.new(gx, 3, SG.WallZ)))
		gate.Parent = folder

		-- gate water: basin rear edge → pad edge, turned with the plot like DockWater. [J3] WE_GatePlotId, NOT WE_PlotId
		-- (the vehicles' plotBasin takes the first WE_Water part with WE_PlotId).
		local gateWater = part({
			Name = "SeaGateWater",
			Size = Vector3.new(span, waterH, SG.BasinRearZ - SG.PadEdgeZ),
			CFrame = BaseLayout.PlotLocalCFrame(pos, gx, waterMidY - pos.Y, (SG.PadEdgeZ + SG.BasinRearZ) * 0.5),
			Color = WaterConfig.Look.Color,
			Material = WaterConfig.Look.Material,
			Transparency = WaterConfig.Look.Transparency,
			CanCollide = false,
			Parent = gate,
		})
		styleWaterPart(gateWater, "SeaGateWater")
		gateWater:SetAttribute("WE_GatePlotId", plotId)

		for _, sx in ipairs({ -1, 1 }) do
			-- named differently from "GatePost" on purpose (GateDefenseService reads that name)
			part({
				Name = "SeaGatePost",
				Size = Vector3.new(SG.PostWidth, SG.PostHeight, SG.PostDepth),
				CFrame = at(gx + sx * (span + SG.PostWidth) * 0.5, padTop + SG.PostHeight * 0.5, SG.WallZ),
				Color = steel,
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = gate,
			})
		end
		-- lintel: never collides or takes raycasts (a boat's land probe must never see it)
		local lintel = part({
			Name = "GateLintel",
			Size = Vector3.new(span + SG.PostWidth * 2, 2.2, SG.PostDepth + 0.4),
			CFrame = at(gx, padTop + SG.LintelBottom + 1.1, SG.WallZ),
			Color = Color3.fromRGB(40, 44, 42),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = gate,
		})
		lintel.CanTouch = false
		lintel.CanQuery = false
		local sg = Instance.new("SurfaceGui")
		sg.Name = "WE_GateSign"
		sg.Face = Enum.NormalId.Back -- plot-local +Z: faces the basin
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 40
		sg.LightInfluence = 0
		sg.MaxDistance = 80 -- v70: painted sign, near-only (CLAUDE.md SurfaceGui budget)
		sg.Parent = lintel
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Text"
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundColor3 = Color3.fromRGB(20, 22, 20)
		lbl.BorderSizePixel = 0
		lbl.Font = Enum.Font.GothamBlack
		lbl.TextScaled = true
		lbl.TextColor3 = yellow
		lbl.Text = SG.Label .. " · LOCKED"
		lbl.Parent = sg
		-- v72 (phone HUD audit F4): inset the sign text so the gate name reads in full (TextScaled filled the whole
		-- board and clipped at the edges); InnerWall.SignInsetStuds x PixelsPerStud left/right, capped text size
		do
			local insetPx = math.floor(((BaseLayout.Config().InnerWall or {}).SignInsetStuds or 2.0) * sg.PixelsPerStud + 0.5)
			local signPad = Instance.new("UIPadding")
			signPad.PaddingLeft = UDim.new(0, insetPx)
			signPad.PaddingRight = UDim.new(0, insetPx)
			signPad.PaddingTop = UDim.new(0, 6)
			signPad.PaddingBottom = UDim.new(0, 6)
			signPad.Parent = lbl
			local signCap = Instance.new("UITextSizeConstraint")
			signCap.MaxTextSize = 64
			signCap.Parent = lbl
		end

		-- leaves: WE_GateLeaf = LeafSlide (-1 = slide plot-local west into the wall line), WE_ClosedCFrame after placing
		for i, lf in ipairs(SG.Leaves) do
			local leaf = part({
				Name = lf.Name,
				Size = Vector3.new(span, lf.Height, lf.Thickness),
				CFrame = at(gx, padTop + lf.Bottom + lf.Height * 0.5, SG.WallZ),
				Color = if i == 1 then yellow else steel,
				Material = if i == 1 then Enum.Material.DiamondPlate else Enum.Material.Metal,
				Transparency = lf.Transparency or 0,
				CanCollide = true,
				Parent = gate,
			})
			leaf:SetAttribute("WE_GateLeaf", SG.LeafSlide)
			leaf:SetAttribute("WE_ClosedCFrame", leaf.CFrame)
			if i == 1 then
				-- black band on the yellow boom (a child part: SetGateOpen moves it with the leaf)
				part({
					Name = "GateStripe",
					Size = Vector3.new(span, 0.8, lf.Thickness + 0.1),
					CFrame = leaf.CFrame * CFrame.new(0, 1.3, 0),
					Color = Color3.fromRGB(28, 28, 26),
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					Parent = leaf,
				})
			end
		end

		-- wall gap marker: WORLD-axis-aligned box (BaseLayout.PlotRect; StructureKitBuilder's gappedWall reads world axes)
		local gapC, gapSX, gapSZ = BaseLayout.PlotRect(pos, gx, SG.WallZ, SG.GapWidth, SG.GapDepth)
		local gap = part({
			Name = "SeaGateWallGap",
			Size = Vector3.new(gapSX, 2, gapSZ),
			CFrame = CFrame.new(gapC.X, gapC.Y + padTop + 1, gapC.Z),
			Transparency = 1,
			CanCollide = false,
			Parent = gate,
		})
		gap.CanTouch = false
		gap.CanQuery = false
		gap:SetAttribute("WE_WallGap", true)

		-- one guard on the west quay facing the gate water (+X); no NPCLabel (HUD pass removes gate-guard labels)
		for gi, gd in ipairs(SG.Guards) do
			part({
				Name = "GuardSandbag",
				Size = Vector3.new(1.3, 1.3, 4.2),
				CFrame = at(gd.X + 3.5, padTop + 0.65, gd.Z),
				Color = Color3.fromRGB(186, 164, 118),
				Material = Enum.Material.Fabric,
				CanCollide = true,
				Parent = gate,
			})
			makeSoldierKit(
				gate,
				"GateGuard_Sea" .. (if gi > 1 then tostring(gi) else ""),
				F * CFrame.new(gd.X, padTop + 2.1, gd.Z) * CFrame.Angles(0, math.rad(-90), 0),
				Color3.fromRGB(62, 72, 52),
				nil,
				Color3.fromRGB(140, 150, 130),
				150,
				"Guard",
				nil
			)
		end
	end
end

-- v68: ATM cluster anchor offset (legacy (28, 8) → BaseLayoutConfig Courtyard.Collector)
local function collectorShift(): Vector3
	if BaseLayout.Enabled() then
		local c = BaseLayout.Config().Courtyard.Collector
		return Vector3.new(c.X - 28, 0, c.Z - 8)
	end
	return Vector3.zero
end

local function paintPlotFloorChevrons(plotFolder: Folder, plotOrigin: Vector3)
	--[[
		Permanent white >>>> chevrons on plot floor guiding spawn → CommandCenter → next pads.
		Visual-only (CanCollide false). Competitor pattern from QUALITY_GAP.
	]]
	local folder = Instance.new("Folder")
	folder.Name = "PlotFloorChevrons"
	folder.Parent = plotFolder

	local function chevronAt(worldPos: Vector3, yawRad: number, idx: number)
		-- Wedge-ish arrow: wide rear + tip (two parts read as >>>)
		local cf = CFrame.new(worldPos) * CFrame.Angles(0, yawRad, 0)
		part({
			Name = "ChevronBody" .. idx,
			Size = Vector3.new(3.2, 0.12, 2.2),
			CFrame = cf,
			Color = COL_CHEVRON,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
		part({
			Name = "ChevronTip" .. idx,
			Size = Vector3.new(1.6, 0.14, 1.6),
			CFrame = cf * CFrame.new(0, 0.02, -1.4) * CFrame.Angles(0, math.rad(45), 0),
			Color = COL_CHEVRON,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
	end

	local function paintPath(from: Vector3, to: Vector3, count: number, startIdx: number): number
		local delta = to - from
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude < 4 then
			return startIdx
		end
		-- Face along path (Roblox look = -Z); atan2(x,z) matches CFrame.Angles Y
		local yaw = math.atan2(flat.X, flat.Z)
		local idx = startIdx
		for i = 1, count do
			local alpha = i / (count + 1)
			local pos = from:Lerp(to, alpha) + Vector3.new(0, 0.55, 0)
			chevronAt(pos, yaw, idx)
			idx += 1
		end
		return idx
	end

	-- Path nodes: PlayerSpawn → CC → Barracks → Depot → Weapons → ATM/premium cluster
	-- v70: nodes are plot-local, mapped through the plot frame (chevron yaws follow the world node deltas)
	local F = BaseLayout.PlotCFrame(plotOrigin)
	local spawnPos = F:PointToWorldSpace(Vector3.new(0, 0.5, 55))
	local nodes = {
		spawnPos,
	}
	if BaseLayout.Enabled() then
		-- v68: spawn → down the main road → Command Center doorway
		local cfg = BaseLayout.Config()
		local sp = cfg.SpawnOffset
		local cc = cfg.Structures.CommandCenter
		local dx, dz = BaseLayout.Rotate(7, 14, cc.Yaw)
		nodes = {
			F:PointToWorldSpace(Vector3.new(sp.X, 0.5, sp.Z - 8)),
			F:PointToWorldSpace(Vector3.new(0, 0.5, 60)),
			F:PointToWorldSpace(Vector3.new(cc.Site.X + dx, 0.5, cc.Site.Z + dz)),
		}
	end
	for i, def in ipairs(STRUCTURES) do
		if i > 5 or BaseLayout.Enabled() then
			break
		end
		local col = (i - 1) % STRUCT_COLS
		local row = math.floor((i - 1) / STRUCT_COLS)
		local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
		table.insert(nodes, F:PointToWorldSpace(offset + Vector3.new(0, 0.5, 0)))
	end
	-- Guide toward MoneyCollector + premium Robux pads (unpaid ATM cluster)
	if not BaseLayout.Enabled() then
		local atmCluster = F:PointToWorldSpace(Vector3.new(28, 0.5, 8))
		table.insert(nodes, atmCluster)
	end

	local idx = 1
	for i = 1, #nodes - 1 do
		local steps = if i == 1 then 5 elseif i == #nodes - 1 then 4 else 3
		idx = paintPath(nodes[i], nodes[i + 1], steps, idx)
	end
end



local function dressPlotPadSandbags(plotFolder: Folder, plotOrigin: Vector3)
	--[[
		v33: cheap MapDressing-style sandbag berms + extra chevrons near early BUY pads.
		Visual-only; does not tag WE_UpgradeSlot.
	]]
	local folder = Instance.new("Folder")
	folder.Name = "PlotPadDressing"
	folder.Parent = plotFolder
	-- v70: positions and yaws are plot-local, placed through the plot frame
	local F = BaseLayout.PlotCFrame(plotOrigin)

	local function sandbag(at: Vector3, yaw: number, idx: number)
		local cf = F * CFrame.new(at) * CFrame.Angles(0, yaw, 0)
		part({
			Name = "PadSandbag" .. idx,
			Size = Vector3.new(4.2, 1.1, 1.4),
			CFrame = cf,
			Color = Color3.fromRGB(130, 115, 80),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
		part({
			Name = "PadSandbagTop" .. idx,
			Size = Vector3.new(3.4, 0.7, 1.1),
			CFrame = cf * CFrame.new(0, 0.85, 0),
			Color = Color3.fromRGB(145, 125, 88),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
	end

	local function miniChevron(at: Vector3, yaw: number, idx: number)
		local cf = F * CFrame.new(at) * CFrame.Angles(0, yaw, 0)
		part({
			Name = "PadChevron" .. idx,
			Size = Vector3.new(2.4, 0.1, 1.6),
			CFrame = cf,
			Color = Color3.fromRGB(245, 245, 250),
			Material = Enum.Material.SmoothPlastic, -- v70: painted (no decorative Neon)
			CanCollide = false,
			Transparency = 0.2,
			Parent = folder,
		})
	end

	local idx = 1
	-- First 6 structure pads get flanking sandbags + approach chevron (legacy grid pads only; v68 consoles)
	for i, def in ipairs(STRUCTURES) do
		if i > 6 or BaseLayout.Enabled() then
			break
		end
		local col = (i - 1) % STRUCT_COLS
		local row = math.floor((i - 1) / STRUCT_COLS)
		local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
		local padPos = offset -- plot-local
		sandbag(padPos + Vector3.new(-7, 0.7, 4), math.rad(15), idx)
		idx += 1
		sandbag(padPos + Vector3.new(7, 0.7, 4), math.rad(-15), idx)
		idx += 1
		miniChevron(padPos + Vector3.new(0, 0.55, 9), math.rad(180), idx)
		idx += 1
	end
	-- ATM approach berm
	local atm = collectorShift() + Vector3.new(28, 0.7, 8) -- plot-local
	sandbag(atm + Vector3.new(-6, 0, 6), 0, idx)
	idx += 1
	sandbag(atm + Vector3.new(6, 0, 6), 0, idx)
end



-- v70: F = plot frame, atmLocal = plot-local ATM cluster anchor (pads turn with the plot)
-- F1 (owner's 11 features, lane W): the pads are MonetizationConfig.PremiumPads.Slots, in order (red Auto Collect,
-- yellow 2x Cash, cyan Speed). A slot is built only while one of its offers has a live Id (LivePadOffer: the first
-- offer with Id ~= 0, e.g. the Speed slot sells the 99 R$ Speed Boost until the 5 R$ Speed Pass Id is pasted).
-- The server decides OWNED (PremiumPadService.alreadyOwns, incl. the slot's OwnedIfAny keys); the Shop client dims an
-- owned pad. VIP is a Shop row only and the Golden Pump pad stands at the pumps (PlotOilPumpService), so at most 3
-- pads and 3 labels sit at the ATM (CLAUDE.md: at most 3 labels on screen at a base). The pad keeps its Neon top
-- (it is the offer; census cap 18) and has no light. Each label is stud-scaled, MaxDistance PremiumPads.LabelMaxDistance,
-- never AlwaysOnTop, and tagged WorldLabelConfig.BaseLabelTag for the client LabelGovernor.
local function buildPremiumPads(folder: Folder, plotId: number, F: CFrame, atmLocal: Vector3)
	local labelRange = MonetizationConfig.PremiumPads.LabelMaxDistance
	-- claude-bud JOB 19: purchase stands in the plot's Supply Depot corner (PurchaseStands; only the prompt buys)
	local PP: any = MonetizationConfig.PremiumPads
	local okS, Stands = pcall(require, script.Parent.PurchaseStands)
	local useStands = PP.Stands == true and okS and type(Stands) == "table"
	local standIndex = 0
	for _, slot in ipairs(MonetizationConfig.PremiumPads.Slots) do
		local offer = MonetizationConfig.LivePadOffer(slot)
		if offer == nil then
			continue -- no live Id for this slot: no pad, no label, nothing to prompt
		end
		if useStands then
			standIndex += 1
			local D = PP.Depot
			local at = F * CFrame.new(D.X0 + (standIndex - 1) * D.Step, 0.3, D.Z) * CFrame.Angles(0, math.pi, 0) -- front faces the plot (-Z)
			local okB, errB = pcall((Stands :: any).Build, folder, at, {
				Kind = offer.Kind,
				Key = offer.Key,
				PlotId = plotId,
				Label = slot.Label,
				Color = slot.Color,
				Icon = (slot :: any).Icon,
				OwnedIfAny = table.concat(MonetizationConfig.PadOwnedKeys(slot), ","),
				PadSlot = slot.Id,
				-- Code Bot v175: the sign reads toward the plot inside (local -Z: the ATM / courtyard side). The stand's
				-- own front (turned pi) looks at the front wall, so its old camera-facing billboard hid that.
				FaceDir = F:VectorToWorldSpace(Vector3.new(0, 0, -1)),
			})
			if not okB then
				warn("[MapSetup] purchase stand failed", offer.Key, errB)
			end
			continue
		end
		local pad = part({
			Name = "PremiumPad_" .. offer.Key,
			Size = Vector3.new(7, 0.45, 7),
			CFrame = F * CFrame.new(atmLocal + slot.Offset),
			Color = slot.Color,
			Material = Enum.Material.Neon,
			CanCollide = true,
			Parent = folder,
		})
		pad:SetAttribute("PlotId", plotId)
		pad:SetAttribute("OfferKind", offer.Kind)
		pad:SetAttribute("OfferKey", offer.Key)
		pad:SetAttribute("OwnedIfAny", table.concat(MonetizationConfig.PadOwnedKeys(slot), ","))
		pad:SetAttribute("PadSlot", slot.Id)
		CollectionService:AddTag(pad, TAG_PREMIUM)
		WorldLabel.Create(pad, slot.Label, {
			Name = "WE_PremiumBillboard",
			Sub = "R$",
			Color = slot.Color,
			MaxDistance = labelRange,
			Offset = Vector3.new(0, 5.5, 0),
			BaseLabel = true, -- CollectionService tag WorldLabelConfig.BaseLabelTag (the LabelGovernor's cap)
		})
	end
	if useStands and standIndex > 0 then
		local D = PP.Depot
		local mid = D.X0 + (standIndex - 1) * D.Step / 2
		-- Code Bot v175: the SUPPLY DEPOT board faces the plot inside too (its Front was turned to the front wall) and stands
		-- above the stand signs (centre D.SignLift, default 11) so they never cover it
		pcall((Stands :: any).Sign, folder, F * CFrame.new(mid, 0.3, D.SignZ), D.Sign, D.SignLift or 11)
	end
end

local function buildMoneyCollector(plotFolder: Folder, plotId: number, pos: Vector3)
	-- v68: the ATM cluster (body, screen, collect ring, premium pads) moves as a group to Courtyard.Collector
	-- v70: plot-local ATM anchor, every part placed through the plot frame F (turns with the plot)
	local F = BaseLayout.PlotCFrame(pos)
	local base = collectorShift()
	-- ATM-like Part kit: matte grey body + green digit screen (MoneyCollectorService billboard refreshes $)
	local folder = Instance.new("Folder")
	folder.Name = "MoneyCollector"
	folder.Parent = plotFolder
	local body = part({
		Name = "CollectorBody",
		Size = Vector3.new(6, 8, 4),
		CFrame = F * CFrame.new(base + Vector3.new(28, 4.5, 8)),
		Color = Color3.fromRGB(70, 78, 72),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = true,
		Parent = folder,
	})
	body:SetAttribute("PlotId", plotId)
	body:SetAttribute("WE_LimeLandmark", true)
	CollectionService:AddTag(body, TAG_COLLECTOR)
	part({
		Name = "CollectorBase",
		Size = Vector3.new(7.5, 0.6, 5.5),
		CFrame = F * CFrame.new(base + Vector3.new(28, 0.8, 8)),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Parent = folder,
	})
	local screen = part({
		Name = "CollectorScreen",
		Size = Vector3.new(4.2, 2.8, 0.35),
		CFrame = F * CFrame.new(base + Vector3.new(28, 5.2, 8 - 2.15)),
		Color = Color3.fromRGB(40, 160, 70),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	-- Green digit SurfaceGui (live $ filled by MoneyCollectorService billboard on body too)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_ATMScreen"
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(240, 160)
	sg.LightInfluence = 0
	sg.MaxDistance = 80 -- v70: near-only (CLAUDE.md SurfaceGui budget)
	sg.Parent = screen
	local digits = Instance.new("TextLabel")
	digits.Name = "Digits"
	digits.Size = UDim2.fromScale(1, 1)
	digits.BackgroundColor3 = Color3.fromRGB(8, 40, 18)
	digits.BackgroundTransparency = 0.15
	digits.Font = Enum.Font.Code
	digits.TextScaled = true
	digits.TextColor3 = Color3.fromRGB(70, 255, 120)
	digits.Text = "$0"
	digits.Parent = sg
	local light = Instance.new("PointLight")
	light.Name = "ATMGlow"
	light.Color = Color3.fromRGB(120, 255, 90)
	light.Brightness = 1.15
	light.Range = 20
	light.Parent = body
	-- v70 (HUD spec §5): no "COLLECT · Touch ATM" billboard (it was AlwaysOnTop); the ATM screen and the flat lime
	-- collect circle are the cue.
	-- Lime Collect circle on ground (touch radius visual). A cylinder's axis is its X: X is the thickness, Y/Z the
	-- diameter, turned 90° about Z so it lies flat (it was sized along X, which stood a 14-stud pole on end).
	local collectCircle = part({
		Name = "CollectCircle",
		Size = Vector3.new(0.25, 14, 14),
		CFrame = F * CFrame.new(base + Vector3.new(28, 0.55, 8)),
		Color = Color3.fromRGB(90, 255, 110),
		Material = Enum.Material.SmoothPlastic, -- v70: painted (no decorative Neon)
		Transparency = 0.55,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	collectCircle.CFrame = F * CFrame.new(base + Vector3.new(28, 0.55, 8)) * CFrame.Angles(0, 0, math.rad(90))
	collectCircle:SetAttribute("PlotId", plotId)
	local ring = part({
		Name = "CollectRing",
		Size = Vector3.new(0.2, 15.5, 15.5),
		Color = Color3.fromRGB(60, 220, 90),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.35,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	ring.CFrame = F * CFrame.new(base + Vector3.new(28, 0.45, 8)) * CFrame.Angles(0, 0, math.rad(90))

	-- Optional ATM catalog mesh dress (Part kit remains authoritative)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachCollectorVisual then
				vas.TryAttachCollectorVisual(body)
			end
		end)
	end)
	-- ATM-cluster premium Robux pads (AutoCollect / 2x / Speed / GoldenPump)
	buildPremiumPads(folder, plotId, F, base + Vector3.new(28, 0, 8))
end

-- Pre-World-v2 lighting (bright midday desert + the 1.5 s day loop). Kept only as the fallback when Modules.WorldAtmosphere
-- is missing or fails; the one-line look revert is WorldConfig.Atmosphere.Preset = "Classic".
local function applyClassicLighting()
	local worldLight = (StructureVisualConfig :: any).WorldLighting or {}
	Lighting.Ambient = worldLight.DayAmbient or Color3.fromRGB(165, 145, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(185, 165, 130)
	Lighting.Brightness = 3.15
	Lighting.ClockTime = 12.5 -- intense midday sun
	Lighting.GeographicLatitude = 22
	Lighting.EnvironmentDiffuseScale = worldLight.EnvironmentDiffuseScale or 0.55
	Lighting.EnvironmentSpecularScale = 0.42
	Lighting.FogColor = Color3.fromRGB(210, 195, 160)
	Lighting.FogStart = 1200
	Lighting.FogEnd = 5200
	pcall(function()
		Lighting.GlobalShadows = true
	end)

	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	sky.Name = "WE_Sky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 2500
	sky.SunAngularSize = 18 -- larger desert sun
	sky.MoonAngularSize = 9

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.14
	atm.Offset = 0.08
	atm.Color = Color3.fromRGB(200, 185, 150) -- warm haze near horizon
	atm.Decay = Color3.fromRGB(95, 130, 190) -- deep blue sky fade
	atm.Glare = 0.32
	atm.Haze = 1.15 -- low haze, high contrast

	-- Cancel prior day/night loop on resetmap; gentle cycle biased to bright desert day
	local dayMarker = Lighting:FindFirstChild("WE_DayNightMarker")
	if dayMarker then
		dayMarker:Destroy()
	end
	dayMarker = Instance.new("Folder")
	dayMarker.Name = "WE_DayNightMarker"
	dayMarker.Parent = Lighting
	task.spawn(function()
		local STEP = 0.03
		local WAIT = 1.5
		local dayAmb = ((StructureVisualConfig :: any).WorldLighting or {}).DayAmbient or Color3.fromRGB(165, 145, 110)
		local dayOut = Color3.fromRGB(185, 165, 130)
		local dayFog = Color3.fromRGB(210, 195, 160)
		local nightAmb = Color3.fromRGB(40, 45, 70)
		local nightOut = Color3.fromRGB(50, 55, 85)
		local nightFog = Color3.fromRGB(55, 60, 90)
		while dayMarker.Parent do
			local t = (Lighting.ClockTime + STEP) % 24
			Lighting.ClockTime = t
			local night = 0
			if t < 5 or t > 20 then
				night = 1
			elseif t < 7 then
				night = 1 - (t - 5) / 2
			elseif t > 18 then
				night = (t - 18) / 2
			end
			Lighting.Brightness = 3.2 - night * 2.1
			Lighting.Ambient = dayAmb:Lerp(nightAmb, night)
			Lighting.OutdoorAmbient = dayOut:Lerp(nightOut, night)
			Lighting.FogColor = dayFog:Lerp(nightFog, night)
			Lighting.FogStart = 1200 - night * 250
			Lighting.FogEnd = 5200 - night * 800
			atm.Density = 0.13 + night * 0.14
			atm.Haze = 1.1 + night * 1.0
			atm.Color = Color3.fromRGB(200, 185, 150):Lerp(Color3.fromRGB(70, 80, 120), night)
			atm.Decay = Color3.fromRGB(95, 130, 190):Lerp(Color3.fromRGB(40, 50, 90), night)
			atm.Glare = 0.32 - night * 0.2
			task.wait(WAIT)
		end
	end)
end

-- World v2 W1: run fn(module) on one of the Modules.World* modules. A missing module or an error is logged and never
-- stops the map build. Returns true when fn ran without error.
local function withWorldModule(name: string, fn: (any) -> ()): boolean
	local mod = script.Parent:FindFirstChild(name)
	if not (mod and mod:IsA("ModuleScript")) then
		warn("[WAR EMPIRE] MapSetup: Modules." .. name .. " missing — skipped (map continues)")
		return false
	end
	local ok, err = pcall(function()
		fn(require(mod) :: any)
	end)
	if not ok then
		warn("[WAR EMPIRE] MapSetup: " .. name .. " failed (map continues):", err)
	end
	return ok
end

-- ── Empire Bank (W3 step 2 lane BK; spec scratchpad w3s2 §1.1–§1.2, §5, §6; geometry w3s2/geo/bank.py) ──────────
--[[ A walk-in hall in the Town v2 style, facing south down Bank Street. 17 parts, the same count as the old block, so
	the busiest 512-stud circle does not move:
	  BankPlaza      36 x 1.2 x 36, top 1.6 (the hall floor); hosts the Town.Bank.* activity anchors (WorldConfig.Town.
	                 BankAnchors, stamped through ActivityAnchors.Stamp: 0 parts)
	  BankHall       the WorldKits TownBlock "hall" shell (7 parts): back wall, 2 side walls, 2 front piers round a 10-wide
	                 full-height opening, the roof slab, the upper window strip; 24 x 22, 2 storeys (x 208..232, z -236..-214)
	  BankColumnW/E  2 portico columns, both outside the sign's width, so neither hides the EMPIRE BANK sign
	  BankSign       the EMPIRE BANK board over the opening, painted here (WorldKits.Sign, inside the world sign budget,
	                 before MapDressing paints the POI boards); BankRaidService paints it only if it has no sign yet
	  BankGate       the bar gate in the opening, built OPEN until the jobs take it over (Phase B): an up-and-over
	                 door tipped flat under the roof slab (a raised upright slab sat between a follow camera outside and
	                 a raider on the vault, and a CanCollide-false part never pops the camera in), CanCollide false,
	                 WE_GateState "open", a runtime door (WE_RuntimeDoor: WorldHygiene Enforce leaves it alone);
	                 WE_ClosedCFrame / WE_OpenCFrame are its two positions
	  VaultDoor      the round vault door on the back wall (dressing)
	  VaultPad       the gold pad (12 x 12, no collision), tag WE_BankVault, centre (220, -224) inside the hall: 2 studs
	                 toward the door from the Town.Bank.Vault anchor (220, -226), so the legacy stand-on-vault raid
	                 (BankRaidConfig.VaultRadius 12 round this part) never reaches round the back wall, where no guard
	                 can see (the jobs' crack ring is the anchor's, r 8, inside the hall)
	  PlanterW/E     2 concrete planters on the plaza (cover for guards G1 / G2 and for raiders)
	  StateBanner    8 x 6 x 0.4 standing on the roof, no collision, no raycasts; green = open (Phase B recolours it)
	No beacon, no kerb, no light, no Neon and no billboard here (BankRaidService owns the one vault label). The hall
	parts come from the kit (PreferMesh never applies: TownBlock has no mesh overlay). BANK_POS is also
	BankRaidConfig.Position (a separate literal: BuyPathStatic pins both), and every coordinate below is absolute, like
	the anchors and the fallback guard posts. ]]
local BANK_POS = Vector3.new(220, 1, -220) -- the plaza centre = BankRaidConfig.Position
local BANK_FLOOR_Y = 1.6 -- the plaza top (the hall floor; the anchors' Y 1.1 above WorldConfig.Activity.FloorY 0.5)
local BANK_HALL_W, BANK_HALL_D, BANK_HALL_STOREYS = 24, 22, 2
local BANK_HALL_CENTRE_Z = -225 -- front (the opening) at z -214, back at z -236
local BANK_GATE_CEILING_GAP = 0.02 -- open: the gate lies flat this far under the roof slab (y 14.98..15.58, z -223.9..-214.9)
local BANK_VAULT_Z = -224 -- the vault pad centre (the Town.Bank.Vault anchor stays at -226; see the header)
local BANK_BANNER_OPEN = Color3.fromRGB(70, 170, 90) -- StateBanner "open" (OpsConfig.Ui.BannerColors.Open in Phase B)
local BANK_SIGN_TEXT = "EMPIRE BANK" -- = BankRaidConfig.Sign.Text

local function buildEmpireBank(root: Folder)
	-- streaming2 S4 (F24): the bank is ONE Atomic Model "EmpireBank" (was a Folder of 10 loose parts + the Default BankHall),
	-- so a client gets the plaza, hall, gate, vault pad, sign and banner together or none of them (17 parts, 36 studs
	-- across). Same name and the same children, so every lookup still works (BankRaidService's "EmpireBank" ancestor walk,
	-- OpsSites' door / banner search from BankPlaza's parent, the vault by its WE_BankVault tag, Hygiene's
	-- BillboardAllowAncestors). Atomic is set first; the model is built unparented and parented once whole (after the
	-- anchors, below), so every piece is an initial descendant. Inert while Workspace.StreamingEnabled is false.
	local oldBank = root:FindFirstChild("EmpireBank")
	if oldBank then
		oldBank:Destroy()
	end
	local bankModel = Instance.new("Model")
	bankModel.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	bankModel.Name = "EmpireBank"
	local plaza = part({
		Name = "BankPlaza",
		Size = Vector3.new(36, 1.2, 36),
		Position = BANK_POS,
		Color = Color3.fromRGB(168, 160, 144),
		Material = Enum.Material.Pavement,
		Parent = bankModel,
	})

	-- the hall shell (WorldKits TownBlock "hall": exactly 7 parts at 2 storeys, no Roof / Lantern); its front (local -Z)
	-- turns to face south (+Z)
	local roofTop = BANK_FLOOR_Y + BANK_HALL_STOREYS * 7 + 1.2 -- the kit's roof slab top (read back from the part below)
	local roofBottom = BANK_FLOOR_Y + BANK_HALL_STOREYS * 7 -- the roof slab's underside = the wall tops (read back too)
	withWorldModule("WorldKits", function(WorldKits: any)
		local hall = Instance.new("Model")
		hall.Name = "BankHall"
		local n = WorldKits.Add(hall, "TownBlock", CFrame.new(220, BANK_FLOOR_Y, BANK_HALL_CENTRE_Z) * CFrame.Angles(0, math.pi, 0), {
			Width = BANK_HALL_W,
			Depth = BANK_HALL_D,
			Storeys = BANK_HALL_STOREYS,
			Variant = "hall",
			Color = Color3.fromRGB(214, 206, 188), -- pale limestone walls (trim 20 % darker)
		})
		hall.Parent = bankModel
		local roof = hall:FindFirstChild("HallRoof")
		if roof and roof:IsA("BasePart") then
			roofTop = roof.Position.Y + roof.Size.Y * 0.5
			roofBottom = roof.Position.Y - roof.Size.Y * 0.5
		end
		if n ~= 7 then
			warn("[WAR EMPIRE] MapSetup: the Empire Bank hall has " .. tostring(n) .. " parts (want 7)")
		end
	end)

	-- portico columns (x 211.3..212.7 and 227.3..228.7, just in front of the piers): 1.3 outside the sign's x 214..226,
	-- so no view from Bank Street loses a corner of the sign behind one (the geometry draft's x 213 / 227 hid up to 8 %
	-- of it from the street's edges); guard posts G3 / G4 stay 1.5 clear of them
	for _, c in ipairs({ { Name = "BankColumnW", X = 212 }, { Name = "BankColumnE", X = 228 } }) do
		part({
			Name = c.Name,
			Size = Vector3.new(1.4, 14, 1.4),
			Position = Vector3.new(c.X, BANK_FLOOR_Y + 7, -212.5),
			Color = Color3.fromRGB(232, 228, 216),
			Material = Enum.Material.Marble,
			CanCollide = true,
			Parent = bankModel,
		})
	end

	-- EMPIRE BANK: a dark board (cream text reads on it) over the opening, x 214..226, y 13.6..15.4, its street face +Z
	local sign = part({
		Name = "BankSign",
		Size = Vector3.new(12, 1.8, 0.4),
		Position = Vector3.new(220, BANK_FLOOR_Y + 12.9, -213.6),
		Color = Color3.fromRGB(34, 38, 48),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = bankModel,
	})
	sign.CanQuery = false
	sign.CanTouch = false
	withWorldModule("WorldKits", function(WorldKits: any)
		if sign:FindFirstChildWhichIsA("SurfaceGui") == nil and WorldKits.Sign(sign, Enum.NormalId.Back, BANK_SIGN_TEXT) == nil then
			warn("[WAR EMPIRE] MapSetup: EMPIRE BANK sign not painted (world sign budget)")
		end
	end)

	-- the bar gate (10 x 9 x 0.6 in the opening, x 215..225): open until OpsService runs the heist (Phase B). Open is
	-- up-and-over: tipped flat (90 degrees about X) and lying just under the roof slab, its outer edge on the closed
	-- gate's street face, so nothing hangs in the opening between the camera and a raider inside
	local gateClosed = CFrame.new(220, BANK_FLOOR_Y + 4.5, -214.6)
	local gateOpen = CFrame.new(220, roofBottom - BANK_GATE_CEILING_GAP - 0.3, -214.9 - 4.5) * CFrame.Angles(math.rad(90), 0, 0)
	local gate = part({
		Name = "BankGate",
		Size = Vector3.new(10, 9, 0.6),
		CFrame = gateOpen,
		Color = Color3.fromRGB(52, 54, 52),
		Material = Enum.Material.DiamondPlate,
		CanCollide = false,
		Parent = bankModel,
	})
	gate.CanQuery = false
	gate.CanTouch = false
	local act = WorldConfig.Activity
	gate:SetAttribute(act.RuntimeDoorAttr, true) -- WE_RuntimeDoor
	gate:SetAttribute(act.GateStateAttr, "open") -- WE_GateState
	gate:SetAttribute("WE_ClosedCFrame", gateClosed)
	gate:SetAttribute("WE_OpenCFrame", gateOpen)

	-- the round vault door on the back wall (a disc 7.6 across, 1 thick, its face 1 stud into the hall)
	part({
		Name = "VaultDoor",
		Size = Vector3.new(1, 7.6, 7.6),
		CFrame = CFrame.new(220, BANK_FLOOR_Y + 4.2, -234.3) * CFrame.Angles(0, math.rad(90), 0),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(150, 150, 142),
		Material = Enum.Material.DiamondPlate,
		CanCollide = true,
		Parent = bankModel,
	})

	-- the vault: a flat gold pad inside the hall (unrotated, so the label's world offset stays straight up). BANK_VAULT_Z
	-- keeps VaultRadius 12 inside the walls at the back and sides (a raider pressed against the back wall outside
	-- stands >= 12.5 from its centre) and lets it reach just out of the opening, in view of the front guards
	local vault = part({
		Name = "VaultPad",
		Size = Vector3.new(12, 0.12, 12),
		Position = Vector3.new(220, BANK_FLOOR_Y + 0.06, BANK_VAULT_Z),
		Color = Color3.fromRGB(214, 176, 72),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = bankModel,
	})
	vault.CanQuery = false
	vault.CanTouch = false
	vault:SetAttribute("BankId", "EmpireBank")
	CollectionService:AddTag(vault, "WE_BankVault")

	-- concrete planters on the plaza front (x 203..209 / 231..237, z -207..-205, 3 tall)
	for _, pl in ipairs({ { Name = "PlanterW", X = 206 }, { Name = "PlanterE", X = 234 } }) do
		part({
			Name = pl.Name,
			Size = Vector3.new(6, 3, 2),
			Position = Vector3.new(pl.X, BANK_FLOOR_Y + 1.5, -206),
			Color = Color3.fromRGB(148, 144, 132),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = bankModel,
		})
	end

	-- the state banner standing on the roof, facing Bank Street
	local banner = part({
		Name = "StateBanner",
		Size = Vector3.new(8, 6, 0.4),
		Position = Vector3.new(226, roofTop + 3, -232),
		Color = BANK_BANNER_OPEN,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		Parent = bankModel,
	})
	banner.CanQuery = false
	banner.CanTouch = false

	-- the Town.Bank.* anchors (Door, Vault, Loot, guard posts G1..G5, reinforcements R1 / R2) on the plaza: 0 parts.
	-- BankRaidService takes its guard posts from the G anchors (else BankRaidConfig.GuardPosts); OpsService reads all.
	local stamped = 0
	withWorldModule("ActivityAnchors", function(ActivityAnchors: any)
		for _, row in ipairs(WorldConfig.Town.BankAnchors) do
			if ActivityAnchors.Stamp(plaza, ActivityAnchors.FromRow(row)) ~= nil then
				stamped += 1
			end
		end
	end)
	bankModel.Parent = root -- streaming2 S4: parented whole
	local nParts = 0
	for _, d in ipairs(bankModel:GetDescendants()) do
		if d:IsA("BasePart") then
			nParts += 1
		end
	end
	print(string.format("[WAR EMPIRE] MapSetup: Empire Bank hall built (%d parts, %d Town.Bank anchors)", nParts, stamped))
end

function MapSetup.Run()
	-- Normal gravity so characters fall onto terrain (not float/void)
	Workspace.Gravity = 196.2

	-- World v2 (spec §2): WorldAtmosphere owns Lighting / Sky / Atmosphere and the day cycle (warm haze, no blue below
	-- the horizon, agent F's ambient, one step every 6 s). Idempotent: a second Run replaces the day loop.
	if not withWorldModule("WorldAtmosphere", function(m: any)
		m.Apply()
	end) then
		applyClassicLighting()
	end

	local root = ensureFolder("WarEmpireSetup", Workspace)
	local map = ensureFolder("Map", root)
	-- Continuous collide floor: thick, large, explicit CanCollide — never reads as sky
	-- v70 (§12.1): tiled (16 x 1800 ground, 25 x 2000 safety catch, 4 pieces per berm / void-wall side)
	buildGroundTiles(map)
	buildSafetyUnderfloor(map)
	buildEdgeBerms(map)
	buildInvisibleWalls(map)
	-- Road grid scaled to plot ring (optional visual guide)
	-- v70 (§6): with the waterways every road stops WaterConfig.RoadEndSetback studs before the first water (no
	-- bridges; every land outpost is inside the ring) and is built as two parts split at 0 (<name>_A: Min..0,
	-- <name>_B: 0..Max, each <= 1752 studs). Each end gets a collidable jersey barrier in Map.RoadEnds.
	local roadEndsFolder: Folder? = nil
	local function roadEndBarrier(name: string, alongX: boolean, across: number, at: number)
		local rb = WaterConfig.RoadEndBarrier
		if roadEndsFolder == nil then
			local f = Instance.new("Folder")
			f.Name = "RoadEnds"
			f.Parent = map
			roadEndsFolder = f
		end
		local centre = if alongX
			then Vector3.new(at, GROUND_TOP_Y + rb.Height * 0.5, across)
			else Vector3.new(across, GROUND_TOP_Y + rb.Height * 0.5, at)
		local barrier = part({
			Name = name,
			Size = if alongX then Vector3.new(rb.Depth, rb.Height, rb.Width) else Vector3.new(rb.Width, rb.Height, rb.Depth),
			Position = centre,
			Color = Color3.fromRGB(196, 192, 180),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = roadEndsFolder,
		})
		part({
			Name = "Stripe",
			Size = if alongX then Vector3.new(rb.Depth + 0.1, 0.5, rb.Width) else Vector3.new(rb.Width, 0.5, rb.Depth + 0.1),
			Position = Vector3.new(centre.X, GROUND_TOP_Y + 1.6, centre.Z),
			Color = Color3.fromRGB(236, 190, 40),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = barrier,
		})
	end
	-- alongX: the road runs along X (RoadZ<z>, at z = across) or along Z (RoadX<x>, at x = across)
	local function worldRoad(name: string, alongX: boolean, across: number)
		local ends = if WaterConfig.Enabled == true then WaterConfig.RoadEnds[name] else nil
		local spans: { { Name: string, A: number, B: number } } = {}
		if ends and ends.Min < 0 and ends.Max > 0 then
			table.insert(spans, { Name = name .. "_A", A = ends.Min, B = 0 })
			table.insert(spans, { Name = name .. "_B", A = 0, B = ends.Max })
		elseif ends then
			table.insert(spans, { Name = name .. "_A", A = ends.Min, B = ends.Max })
		else
			-- no waterways: full length, still in pieces under the part-size cap
			local piece = GROUND_SIZE / EDGE_PIECES
			for k, c in ipairs(tileCentres(EDGE_PIECES, piece)) do
				table.insert(spans, { Name = name .. "_" .. k, A = c - piece * 0.5, B = c + piece * 0.5 })
			end
		end
		for _, sp in ipairs(spans) do
			local mid, len = (sp.A + sp.B) * 0.5, sp.B - sp.A
			part({
				Name = sp.Name,
				Size = if alongX then Vector3.new(len, 0.15, 14) else Vector3.new(14, 0.15, len),
				Position = if alongX
					then Vector3.new(mid, GROUND_TOP_Y + 0.05, across)
					else Vector3.new(across, GROUND_TOP_Y + 0.05, mid),
				Color = Color3.fromRGB(50, 52, 48),
				Material = Enum.Material.Asphalt,
				CanCollide = false,
				Parent = map,
			})
		end
		if ends then
			roadEndBarrier(name .. "_Min", alongX, across, ends.Min + WaterConfig.RoadEndBarrier.Depth * 0.5)
			roadEndBarrier(name .. "_Max", alongX, across, ends.Max - WaterConfig.RoadEndBarrier.Depth * 0.5)
		end
	end
	for _, z in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		worldRoad("RoadZ" .. z, true, z)
	end
	for _, x in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		worldRoad("RoadX" .. x, false, x)
	end
	-- Asphalt Decal texture on road strips (MapDressing.AsphaltDecal)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if not (vas and vas.ApplyAsphaltDecal) then
				return
			end
			for _, ch in ipairs(map:GetChildren()) do
				if ch:IsA("BasePart") and (string.sub(ch.Name, 1, 5) == "RoadZ" or string.sub(ch.Name, 1, 5) == "RoadX") then
					vas.ApplyAsphaltDecal(ch)
				end
			end
		end)
	end)

	-- Yellow centre-line dashes. World v2 W1 (spec §7.1): 40 painted SmoothPlastic dashes (was 80 Neon), only on the
	-- approaches: a dash stays when it lies within DASH_APPROACH studs (3 dashes) along its road of a visible crossing
	-- (the town at 0,0 and the six ring crossings; the crossings at 0,±800 are under plots 3 / 4) and never under a plot
	-- pad (those were hidden under the pad anyway). Road markings: RoadDash* is exempt from the road-corridor rules.
	local DASH_APPROACH = 270
	local ROAD_LINES = { -PLOT_RING, 0, PLOT_RING }
	local function underPlotPad(x: number, z: number): boolean
		local half = PLOT_PAD_SIZE * 0.5 + 4
		for _, pp in ipairs(PLOT_POSITIONS) do
			if math.abs(x - pp.X) <= half and math.abs(z - pp.Z) <= half then
				return true
			end
		end
		return false
	end
	local function nearVisibleCrossing(alongX: boolean, across: number, at: number): boolean
		for _, c in ipairs(ROAD_LINES) do
			local cx = if alongX then c else across
			local cz = if alongX then across else c
			if not underPlotPad(cx, cz) and math.abs(at - c) <= DASH_APPROACH then
				return true
			end
		end
		return false
	end
	local function roadDash(name: string, alongX: boolean, across: number, at: number)
		local x = if alongX then at else across
		local z = if alongX then across else at
		if underPlotPad(x, z) or not nearVisibleCrossing(alongX, across, at) then
			return
		end
		part({
			Name = name,
			Size = if alongX then Vector3.new(8, 0.12, 1.2) else Vector3.new(1.2, 0.12, 8),
			Position = Vector3.new(x, GROUND_TOP_Y + 0.12, z),
			Color = Color3.fromRGB(240, 210, 60),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = map,
		})
	end
	for _, z in ipairs(ROAD_LINES) do
		for i = -8, 8 do
			if i ~= 0 then
				roadDash("RoadDashZ" .. z .. "_" .. i, true, z, i * 90)
			end
		end
	end
	for _, x in ipairs({ -PLOT_RING, PLOT_RING }) do
		for i = -8, 8 do
			if i ~= 0 then
				roadDash("RoadDashX" .. x .. "_" .. i, false, x, i * 90)
			end
		end
	end

	local bases = ensureFolder("Bases", root)
	for plotId, pos in ipairs(PLOT_POSITIONS) do
		-- v70: the plot frame. Everything on the plot is plot-local and placed through F, so the whole base turns to
		-- face the map centre when BaseLayoutConfig.FaceMapCentre is on (F = CFrame.new(pos) while it is off).
		local F = BaseLayout.PlotCFrame(pos)
		local plotFolder = Instance.new("Folder")
		plotFolder.Name = "Plot" .. plotId
		plotFolder:SetAttribute("PlotYaw", BaseLayout.PlotYaw(pos))
		plotFolder:SetAttribute("PlotForward", BaseLayout.PlotForward(pos))
		plotFolder.Parent = bases

		local pad = part({
			Name = "PlotPad",
			Size = Vector3.new(PLOT_PAD_SIZE, 1, PLOT_PAD_SIZE),
			CFrame = F, -- v70: the pad carries the plot yaw (services read pad.CFrame for plot-local ↔ world)
			Color = COL_PAD,
			Material = Enum.Material.Concrete,
			Parent = plotFolder,
		})
		pad:SetAttribute("PlotId", plotId)
		CollectionService:AddTag(pad, TAG_BASE)
		paintEdge(pad, COL_PAD_EDGE, 0.55)

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "PlayerSpawn"
		spawn.Size = Vector3.new(10, 1, 10)
		do
			local sp = if BaseLayout.Enabled() then BaseLayout.Config().SpawnOffset else { X = 0, Z = 55 }
			spawn.CFrame = F * CFrame.new(sp.X, 2, sp.Z) -- main gate side, gate defence and spawn facing turn with it
		end
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.BrickColor = BrickColor.new("Dark green")
		spawn.Material = Enum.Material.SmoothPlastic -- v70 (HUD spec §5): painted spawn pad (was Neon)
		spawn.Parent = plotFolder

		-- v67: no giant "BASE n · Walk pads to BUY · E / B menu" label over the plot (HUD + pad cards explain buying)
		-- v70 (HUD spec §5): no plot beacon (neon tip + glow disc) at the rear of the plot either

		for i, def in ipairs(STRUCTURES) do
			local col = (i - 1) % STRUCT_COLS
			local row = math.floor((i - 1) / STRUCT_COLS)
			local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
			buildStructureKit(plotFolder, plotId, pos, offset, def)
		end

		-- v72: static arrows off by default (they pointed back at the gate; the per-player NEXT pointer replaces them)
		if not BaseLayout.Enabled() or BaseLayout.Config().FloorChevrons ~= false then
			paintPlotFloorChevrons(plotFolder, pos)
		end
		dressPlotPadSandbags(plotFolder, pos)

		-- Training Yard (owner feedback 2026-09-27: "the soldier training area is terrible"): a 3-lane shooting range
		-- (3 soldiers at the firing line, targets, a sand berm), a small obstacle course and a supply corner, built by
		-- TrainingYardBuilder from TrainingYardConfig (was 3 tent stalls + 2 workers + 3 flat targets, 84 parts; now 65, 76 once
		-- its Roblox-made meshes load). The TrainingYard folder, YardPad, YardAnchor / YardEarnAnchor and TrainingTarget1..3
		-- keep their names (ManualDropperService, SoldierService, ProducerLabels).
		TrainingYardBuilder.Build(
			plotFolder,
			plotId,
			F,
			if BaseLayout.Enabled() then BaseLayout.Config().Courtyard.TrainingYard else nil,
			makeSoldierKit
		)
		-- Design densify: 8–12 realistic warzone props per plot (always-on Part kits; pcall catalog)
		do
			local okDress, errDress = pcall(function()
				local wz = Instance.new("Folder")
				wz.Name = "PlotWarzone"
				wz.Parent = plotFolder
				local count = 12
				-- v68: fixed spots along the walls / rear zone (the 58-78 stud ring lands on the new plaza)
				local spots = if BaseLayout.Enabled() then BaseLayout.Config().WarzoneSpots else nil
				if spots then
					count = #spots
				end
				for i = 1, count do
					local ang = (i / count) * math.pi * 2
					local rad = 58 + (i % 3) * 10
					-- v70: plot-local spot, placed through the plot frame F (props turn with the plot)
					local o = Vector3.new(math.cos(ang) * rad, 0.6, math.sin(ang) * rad)
					if spots then
						o = Vector3.new(spots[i].X, 0.6, spots[i].Z)
					end
					if i % 3 == 0 then
						-- sandbag berm (Metal/Sand — no neon)
						part({
							Name = "WZ_Sandbag" .. i,
							Size = Vector3.new(6, 1.2, 1.4),
							CFrame = F * CFrame.new(o),
							Color = Color3.fromRGB(130, 115, 80),
							Material = Enum.Material.Sand,
							CanCollide = true,
							Parent = wz,
						})
						part({
							Name = "WZ_SandbagTop" .. i,
							Size = Vector3.new(5.2, 0.9, 1.1),
							CFrame = F * CFrame.new(o + Vector3.new(0, 1.0, 0)),
							Color = Color3.fromRGB(120, 105, 75),
							Material = Enum.Material.Sand,
							CanCollide = true,
							Parent = wz,
						})
					elseif i % 3 == 1 then
						part({
							Name = "WZ_Crate" .. i,
							Size = Vector3.new(2.2, 2.0, 2.2),
							CFrame = F * CFrame.new(o + Vector3.new(0, 1.0, 0)),
							Color = Color3.fromRGB(95, 80, 55),
							Material = Enum.Material.Wood,
							CanCollide = true,
							Parent = wz,
						})
						part({
							Name = "WZ_Drum" .. i,
							Size = Vector3.new(1.4, 2.2, 1.4),
							CFrame = F * CFrame.new(o + Vector3.new(3, 1.1, 1)),
							Color = Color3.fromRGB(55, 70, 50),
							Material = Enum.Material.Metal,
							Shape = Enum.PartType.Cylinder,
							CanCollide = true,
							Parent = wz,
						})
					else
						part({
							Name = "WZ_Barrier" .. i,
							Size = Vector3.new(5, 1.4, 0.7),
							CFrame = F * CFrame.new(o + Vector3.new(0, 0.7, 0)),
							Color = Color3.fromRGB(110, 105, 90),
							Material = Enum.Material.Concrete,
							CanCollide = true,
							Parent = wz,
						})
					end
				end
				-- Catalog densify InsertService — ALWAYS deferred (never block MapSetup.Run / remotes)
					task.defer(function()
						pcall(function()
							local vas = require(script.Parent.Parent.Services.VisualAssetService)
							if not (vas and vas.TryAttachPropVisual) then
								return
							end
							-- WZ densify catalog: sandbags / crates / desert flora hosts
							for _, ch in ipairs(wz:GetChildren()) do
								if ch:IsA("BasePart") then
									if string.find(ch.Name, "Sandbag", 1, true) then
										vas.TryAttachPropVisual(ch, "Sandbag")
									elseif string.find(ch.Name, "Crate", 1, true) then
										vas.TryAttachPropVisual(ch, "Crate")
									elseif string.find(ch.Name, "Drum", 1, true) then
										vas.TryAttachPropVisual(ch, "OilBarrel")
									elseif string.find(ch.Name, "Barrier", 1, true) then
										vas.TryAttachPropVisual(ch, "ConcreteBarrier")
									end
								end
							end
							local host = wz:FindFirstChildWhichIsA("BasePart")
							if host then
								vas.TryAttachPropVisual(host, "FloodlightTower")
							end
						end)
					end)
			end)
			if not okDress then
				warn("[MapSetup] PlotWarzone densify failed (pads intact):", errDress)
			end
		end
		buildMoneyCollector(plotFolder, plotId, pos)
		buildLayoutGround(plotFolder, plotId, pos)
	end

	local territories = ensureFolder("Territories", root)
	for _, def in ipairs(territoryDefsInBuildOrder()) do
		local pos = def.Position
		local isOilRig = def.IsOilRig == true
		local isFort = def.IsFortress == true
		local gateSide = FORT_GATE_SIDE[def.Id]
		-- F10: a Home Outpost (TerritoryConfig.Starter row) is a 4-part kit: invisible marker (capture volume, tags,
		-- PlotId), ring, pole and flag. No stripe, no finial, no light (TerritoryService never adds one either).
		local isStarter = TerritoryConfig.IsStarterDef(def)
		local diameter = (def.Radius or 30) * 2
		-- streaming2 S4 (F12): the zone's marker, ring, pole and flag (and the stripe and finial off a Home Outpost) are
		-- one Atomic Model, so a client never has the marker without its <Id>_Flag sibling (TerritoryController's
		-- diamond lookup) or the flag without the marker. Siblings stay siblings: TerritoryService finds them from
		-- marker.Parent as before, the marker by its tags. Fort walls / keep / towers and rig decks / legs stay loose in
		-- Territories. Built unparented and parented once whole (below), so every piece is an initial descendant.
		-- Inert while Workspace.StreamingEnabled is false: the same parts, one level deeper.
		local zone = Instance.new("Model")
		zone.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		zone.Name = def.Id .. "_Zone"
		-- World v2 (spec §3.5): the capture marker keeps its Size (TerritoryCapture reads its half-diagonal) but is an
		-- invisible, non-colliding volume (it was a glowing 1.5-tall slab across five roads). The visible cue is the
		-- flat <Id>_Ring disc below; TerritoryService writes only the owner colour.
		local marker = part({
			Name = def.Id,
			Size = Vector3.new(diameter, 1.5, diameter),
			Position = pos,
			Color = def.Color,
			Transparency = 1,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = zone,
		})
		marker.CanQuery = false
		marker.CanTouch = false
		marker:SetAttribute("TerritoryId", def.Id)
		marker:SetAttribute("Radius", def.Radius or 30)
		marker:SetAttribute("OwnerType", "Neutral")
		marker:SetAttribute("OwnerUserId", 0)
		marker:SetAttribute("CaptureProgress", 0)
		if isStarter then
			-- F10: owner-only (TerritoryCapture counts only BaseService.GetOwnerUserId(PlotId)); clients read these to
			-- list / point at their OWN Home Outpost only
			marker:SetAttribute("PlotId", def.PlotId)
			marker:SetAttribute("IsStarter", true)
			marker:SetAttribute("OwnerOnly", def.OwnerOnly == true)
		end
		CollectionService:AddTag(marker, TAG_TERRITORY)
		CollectionService:AddTag(marker, TAG_CAPTURE)

		-- Zone name: the same stud-scaled label TerritoryService.ensureZoneLabel makes (it reuses WE_ZoneLabel), so the
		-- world never shows the old 220-stud "[NEUTRAL] · Stand to capture" card, even before the service starts
		WorldLabel.Create(marker, def.DisplayName or def.Id, {
			Name = "WE_ZoneLabel",
			Studs = Vector2.new(8, 1.6),
			Offset = Vector3.new(0, 16, 0),
			MaxDistance = 40,
		})

		-- Flat disc (spec §3.5): a Cylinder lying on its side, top at y 0.58 on the ground (on the deck top for a rig,
		-- sized to the 48-stud deck instead of overhanging the sea)
		local ringD = if isOilRig then math.min(diameter + 8, 46) else diameter + 8
		local ringTop = if isOilRig then pos.Y + 0.13 else GROUND_TOP_Y + 0.08
		local ring = part({
			Name = def.Id .. "_Ring",
			Size = Vector3.new(0.12, ringD, ringD),
			CFrame = CFrame.new(pos.X, ringTop - 0.06, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = def.Color,
			Transparency = 0.55,
			CanCollide = false,
			Material = Enum.Material.SmoothPlastic,
			Shape = Enum.PartType.Cylinder,
			Parent = zone,
		})
		ring.CanQuery = false
		ring.CanTouch = false
		ring:SetAttribute("TerritoryId", def.Id)

		part({
			Name = def.Id .. "_FlagPole",
			Size = Vector3.new(0.4, 14, 0.4),
			Position = pos + Vector3.new(0, 7, 0),
			Color = Color3.fromRGB(55, 55, 55),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = zone,
		})
		local flag = part({
			Name = def.Id .. "_Flag",
			Size = Vector3.new(5.5, 3.2, 0.22),
			Position = pos + Vector3.new(2.8, 12.2, 0),
			Color = def.Color,
			Material = Enum.Material.SmoothPlastic, -- painted (TerritoryService keeps it SmoothPlastic)
			CanCollide = false,
			Transparency = 0.08,
			Parent = zone,
		})
		flag:SetAttribute("TerritoryId", def.Id)
		flag:SetAttribute("WE_Flag", true)
		if isStarter then
			-- owner asset list hook: the Roblox Capture Points pad on the ring (VisualAssetConfig.Landmarks.HomeOutpost: upright,
			-- centred, the ring keeps its look, the Height beam and Highlight dropped). Deferred and pcall'd (a first load may
			-- yield; it runs after the zone below is parented); a 0 id leaves the 4-part kit alone.
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			task.defer(pcall, vas.TryAttachPropVisual, ring, "HomeOutpost")
			zone.Parent = territories -- streaming2 S4: parented whole
			continue -- F10: the Home Outpost kit ends here (marker, ring, pole, flag: 4 parts, no light)
		end
		part({
			Name = def.Id .. "_FlagStripe",
			Size = Vector3.new(5.5, 0.45, 0.28),
			Position = pos + Vector3.new(2.8, 12.2, 0),
			Color = Color3.fromRGB(245, 245, 245),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0.15,
			Parent = zone,
		})
		part({
			Name = def.Id .. "_Finial",
			Size = Vector3.new(0.7, 0.7, 0.7),
			Position = pos + Vector3.new(0, 14.4, 0),
			Color = Color3.fromRGB(230, 190, 60),
			Material = Enum.Material.SmoothPlastic,
			Shape = Enum.PartType.Ball,
			CanCollide = false,
			Parent = zone,
		})
		zone.Parent = territories -- streaming2 S4: parented whole, before the loose fort / rig pieces

		-- World v2 W1: no beacon pole in the capture zone (the flag pole and the disc mark it)

		-- Coastal oil platform deck + legs + harder NPC guards
		if isOilRig then
			local deckY = pos.Y
			local deck = part({
				Name = def.Id .. "_Deck",
				Size = Vector3.new(48, 2.5, 48),
				Position = Vector3.new(pos.X, deckY - 1.2, pos.Z),
				Color = Color3.fromRGB(90, 95, 100),
				Material = Enum.Material.Metal,
				Parent = territories,
			})
			deck:SetAttribute("TerritoryId", def.Id)
			-- Support legs
			local legOff = 18
			for _, ox in ipairs({ -legOff, legOff }) do
				for _, oz in ipairs({ -legOff, legOff }) do
					part({
						Name = def.Id .. "_Leg",
						Size = Vector3.new(3, deckY, 3),
						Position = Vector3.new(pos.X + ox, deckY / 2, pos.Z + oz),
						Color = Color3.fromRGB(60, 65, 70),
						Material = Enum.Material.Metal,
						Parent = territories,
					})
				end
			end
			-- Derrick + crane tip + painted deck rim (visual kits v2; World v2: no Neon)
			part({
				Name = def.Id .. "_Derrick",
				Size = Vector3.new(4, 22, 4),
				Position = Vector3.new(pos.X + 14, deckY + 11, pos.Z + 14),
				Color = Color3.fromRGB(180, 140, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_CraneArm",
				Size = Vector3.new(14, 1.2, 1.2),
				Position = Vector3.new(pos.X + 7, deckY + 20, pos.Z + 14),
				Color = Color3.fromRGB(160, 120, 45),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_HelipadMark",
				Size = Vector3.new(10, 0.3, 10),
				Position = Vector3.new(pos.X - 12, deckY + 0.2, pos.Z - 12),
				Color = Color3.fromRGB(40, 45, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_DeckRim",
				Size = Vector3.new(46, 0.35, 0.5),
				Position = Vector3.new(pos.X, deckY + 0.3, pos.Z + 23),
				Color = Color3.fromRGB(255, 180, 60),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = territories,
			})
			-- World v2 W1: no "OIL PLATFORM · Hard guards" card (the zone label names the rig; CLAUDE.md: no debug labels)
			-- Stairs from deck down to ground (prevent 28-stud death plunge)
			-- v70 (§7.1): on the waterways map the stairs are the rig's pier across the lagoon, snapped to the X axis
			-- toward the map centre (Alpha steps x 1765 → 1684, approach pad on the inner bank; Bravo mirrored)
			local inland = if WaterConfig.RigPierAxisAligned == true
				then Vector3.new(-math.sign(pos.X), 0, 0)
				else Vector3.new(-pos.X, 0, -pos.Z)
			if inland.Magnitude < 0.1 then
				inland = Vector3.new(-pos.X, 0, -pos.Z)
			end
			buildOilDeckRamp(territories, def.Id, pos, inland)
			if WaterConfig.Enabled == true then
				-- Concrete footing round each leg at the waterline: a boat's land probe that starts inside a 28-tall leg
				-- misses the leg, but sees the footing top (2.5)
				local lf = WaterConfig.RigLegFooting
				for _, ox in ipairs({ -legOff, legOff }) do
					for _, oz in ipairs({ -legOff, legOff }) do
						part({
							Name = def.Id .. "_LegFooting",
							Size = lf,
							Position = Vector3.new(pos.X + ox, GROUND_TOP_Y + lf.Y * 0.5, pos.Z + oz),
							Color = Color3.fromRGB(120, 118, 110),
							Material = Enum.Material.Concrete,
							CanCollide = true,
							Parent = territories,
						})
					end
				end
				-- [J5] submerged rubble footing under the pier's low end (rig-local Near..Far along the pier, ±HalfWidth
				-- across, y 0.5..2.5): capital ships' collidable bridges (up to 13.1 above the water) would ram steps
				-- 5-10 and the shelf; every land probe sees this top first, so boats brake before it. Walkable.
				local pf = WaterConfig.RigPierFooting
				local dir = inland.Unit
				local mid = Vector3.new(pos.X, GROUND_TOP_Y + pf.Height * 0.5, pos.Z) + dir * ((pf.Near + pf.Far) * 0.5)
				part({
					Name = def.Id .. "_PierFooting",
					Size = Vector3.new(pf.HalfWidth * 2, pf.Height, pf.Far - pf.Near),
					CFrame = CFrame.lookAt(mid, mid + dir),
					Color = Color3.fromRGB(78, 76, 70),
					Material = Enum.Material.Concrete,
					Transparency = 0,
					CanCollide = true,
					Parent = territories,
				})
			end
		end

		-- Fortress walls / keep (named forts with higher stipend)
		if isFort then
			local wallH = 8
			local wallT = 2.2
			local span = (def.Radius or 48) * 1.35
			local wallDefs = {
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, span) },
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, -span) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(span, wallH / 2, 0) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(-span, wallH / 2, 0) },
			}
			-- World v2 (spec §3.4): the wall facing the fort's nearest road (GateSide: 1 = +Z wall, -1 = -Z wall) is two
			-- pieces with a FORT_GATE_WIDTH gap, so infantry and vehicles can drive in (the fort was a closed box)
			local gateWall = if gateSide == 1 then 1 elseif gateSide == -1 then 2 else nil
			for wi, wd in ipairs(wallDefs) do
				if wi == gateWall then
					local pieceLen = (span * 2 - FORT_GATE_WIDTH) * 0.5
					for k, sgn in ipairs({ -1, 1 }) do
						part({
							Name = def.Id .. "_Wall" .. wi .. (if k == 1 then "" else "b"),
							Size = Vector3.new(pieceLen, wallH, wallT),
							Position = pos + wd[2] + Vector3.new(sgn * (FORT_GATE_WIDTH * 0.5 + pieceLen * 0.5), 0, 0),
							Color = Color3.fromRGB(95, 90, 75),
							Material = Enum.Material.Concrete,
							Parent = territories,
						})
					end
				else
					part({
						Name = def.Id .. "_Wall" .. wi,
						Size = wd[1],
						Position = pos + wd[2],
						Color = Color3.fromRGB(95, 90, 75),
						Material = Enum.Material.Concrete,
						Parent = territories,
					})
				end
			end
			local keep = part({
				Name = def.Id .. "_Keep",
				Size = Vector3.new(14, 16, 14),
				Position = pos + Vector3.new(0, 8, 0),
				Color = def.Color,
				Material = Enum.Material.Brick,
				Parent = territories,
			})
			keep:SetAttribute("TerritoryId", def.Id)
			part({
				Name = def.Id .. "_KeepRoof",
				Size = Vector3.new(16, 1.5, 16),
				Position = pos + Vector3.new(0, 16.5, 0),
				Color = Color3.fromRGB(70, 65, 55),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			-- Corner towers + gate lintel
			for _, corner in ipairs({
				Vector3.new(span, 0, span),
				Vector3.new(span, 0, -span),
				Vector3.new(-span, 0, span),
				Vector3.new(-span, 0, -span),
			}) do
				part({
					Name = def.Id .. "_Tower",
					Size = Vector3.new(5, 12, 5),
					Position = pos + corner + Vector3.new(0, 6, 0),
					Color = Color3.fromRGB(85, 80, 65),
					Material = Enum.Material.Brick,
					Parent = territories,
				})
			end
			-- SmoothPlastic lintel over the gate (was a Neon strip on a wall with no gate); non-colliding, so it never
			-- snags a tall vehicle
			local gz = if gateSide == -1 then -span else span
			local lintel = part({
				Name = def.Id .. "_GateLintel",
				Size = Vector3.new(FORT_GATE_WIDTH + 2, 1, wallT + 0.4),
				Position = pos + Vector3.new(0, wallH - 0.5, gz),
				Color = def.Color,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = territories,
			})
			lintel.CanQuery = false
			-- World v2 W1: no "FORTRESS · High stipend" card (the zone label names the fort; no debug labels)
		end
	end

	-- World v2 (spec §3.3): spawn pads and anchors come from WorldConfig.Spawns (the three makeSpawnFolder rings at
	-- 650 / 550 / 500 are gone: their pads sat on the roads, carried Neon edges, H marks and a beacon pole through the jeep).
	--   VehicleSpawns  10 garage pads (WE_VehicleSpawn): painted Concrete aprons + a painted kerb; the 6 gate pads carry a
	--                  1-post "Garage" sign (SurfaceGui, <= 80 studs) on the back edge, the 4 pool pads none (lane BK: the
	--                  world sign budget); no beacon, no billboard, no Neon. Gate_P1..P6 sit
	--                  62 studs outside each plot's front gate (plot-local, so they turn with the plot) and face the plot
	--                  forward; the pools face Yaw. VehicleService spawns on the pad heading (yawOf(pad.CFrame)).
	--   NPCSpawns      10 invisible anchors (WE_NPCSpawn) in the Quarry / Ridge / Dune camps (CombatNPC.GatherSpawns)
	--   EventSpawns    6 invisible anchors (WE_EventSpawn) (SupplyDropService lands the crate on the ground below)
	local spawnCfg = WorldConfig.Spawns
	-- v68: nothing spawns within PLOT_SPAWN_CLEARANCE of a plot pad (a config typo would put a pad inside a base)
	local function nearAnyPlot(p: Vector3, halfSize: number): boolean
		local half = PLOT_PAD_SIZE * 0.5 + PLOT_SPAWN_CLEARANCE + halfSize
		for _, pp in ipairs(PLOT_POSITIONS) do
			if math.abs(p.X - pp.X) < half and math.abs(p.Z - pp.Z) < half then
				return true
			end
		end
		return false
	end
	-- garage pads: top 0.9 (a 0.4 lip over the desert floor, not the old 1.1 step), padSize from config
	local GARAGE_Y = GROUND_TOP_Y + 0.4 - spawnCfg.PadSize.Y * 0.5
	local garageFolder = ensureFolder("VehicleSpawns", root)
	for _, def in ipairs(spawnCfg.Garage) do
		local cf: CFrame? = nil
		if def.PlotId ~= nil then
			local plotPos = PLOT_POSITIONS[def.PlotId]
			if plotPos then
				local at = BaseLayout.PlotPoint(plotPos, def.LocalX or 0, def.LocalZ or 0)
				-- face the plot forward (the pad's LookVector = the plot front, away from the gate)
				local fwd = BaseLayout.PlotForward(plotPos)
				local c = Vector3.new(at.X, GARAGE_Y, at.Z)
				cf = CFrame.lookAt(c, c + fwd)
			end
		elseif def.X ~= nil and def.Z ~= nil then
			cf = CFrame.new(def.X, GARAGE_Y, def.Z) * CFrame.Angles(0, math.rad(def.Yaw or 0), 0)
		end
		if cf == nil then
			warn("[WAR EMPIRE] MapSetup: garage pad " .. def.Id .. " has no position — skipped")
			continue
		end
		if nearAnyPlot(cf.Position, spawnCfg.PadSize.X * 0.5) then
			warn("[WAR EMPIRE] MapSetup: garage pad " .. def.Id .. " is within PLOT_SPAWN_CLEARANCE of a plot")
		end
		local pad = part({
			Name = def.Id,
			Size = spawnCfg.PadSize,
			CFrame = cf,
			Color = COL_VEHICLE,
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = garageFolder,
		})
		CollectionService:AddTag(pad, TAG_VEHICLE)
		paintEdge(pad, COL_VEHICLE:Lerp(Color3.new(1, 1, 1), 0.55), 0.35)
		-- W3 step 2 lane BK (spec w3s2 §1.10): only the 6 gate pads (PlotId rows) carry the "Garage" sign; the 4 pool
		-- pads have no sign post, board or label, so the world sign budget (WorldConfig.Budgets.SurfaceGuis 17) holds the
		-- 6 gate pads, the Town board, EMPIRE BANK and the 9 POI boards
		if def.PlotId == nil then
			continue
		end
		-- 1-post sign on the back edge, the painted face toward the pad front (readable as you walk up to the pad)
		if (def :: any).NoSign == true then
			continue -- claude-bud JOB 21: the new plots' gate pads carry no sign (the world sign budget 17 is full)
		end
		-- vscale R2: now GarageSignBack behind the pad centre, clear of a Roblox-size body parked on it (pickup tail 13.29)
		local back = tonumber(spawnCfg.GarageSignBack) or (spawnCfg.PadSize.Z * 0.5 + 0.4)
		local topY = spawnCfg.PadSize.Y * 0.5
		local post = part({
			Name = "SignPost",
			Size = Vector3.new(0.35, 4.2, 0.35),
			CFrame = cf * CFrame.new(0, topY + 2.1, back),
			Color = Color3.fromRGB(60, 62, 58),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = garageFolder,
		})
		post.CanQuery = false
		post.CanTouch = false
		local board = part({
			Name = "GarageSign",
			Size = Vector3.new(4.4, 1.3, 0.2),
			CFrame = cf * CFrame.new(0, topY + 4.4, back),
			Color = Color3.fromRGB(40, 48, 58),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = garageFolder,
		})
		board.CanQuery = false
		board.CanTouch = false
		-- v70 (HUD spec §5, mobile P1-11): device-neutral text, no key names
		WorldLabel.Surface(board, Enum.NormalId.Front, "Garage", { Name = "WE_PadSign", Color = Color3.fromRGB(200, 220, 255), MaxDistance = 80 })
	end
	-- invisible anchors: server-only readers (CombatNPC / SupplyDropService); no physics, no raycast target
	local function anchorFolder(name: string, tag: string, list: { any }, color: Color3)
		local folder = ensureFolder(name, root)
		for _, a in ipairs(list) do
			local at = Vector3.new(a.X, 1, a.Z)
			if nearAnyPlot(at, spawnCfg.AnchorSize.X * 0.5) then
				warn("[WAR EMPIRE] MapSetup: " .. name .. "." .. a.Id .. " is within PLOT_SPAWN_CLEARANCE of a plot")
			end
			local p = part({
				Name = a.Id,
				Size = spawnCfg.AnchorSize,
				Position = at,
				Color = color,
				Material = Enum.Material.SmoothPlastic,
				Transparency = 1,
				CanCollide = false,
				Parent = folder,
			})
			p.CanQuery = false
			p.CanTouch = false
			CollectionService:AddTag(p, tag)
		end
	end
	anchorFolder("NPCSpawns", TAG_NPC, spawnCfg.NPC, COL_NPC)
	anchorFolder("EventSpawns", TAG_EVENT, spawnCfg.Event, COL_EVENT)

	-- v70 waterways (spec_final §5): Modules.Waterways builds root.CoastalWater (the sea, the ring canal round the map,
	-- rig lagoons, the South Docks harbour, dock channels, sand banks). The old single WaterPlane and the HarborShelf
	-- (a collidable sandbar standing above the old sea surface) are gone. Guarded: without the module the map still
	-- builds (no public water).
	do
		local wwModule = script.Parent:FindFirstChild("Waterways")
		if wwModule and wwModule:IsA("ModuleScript") then
			local okWw, errWw = pcall(function()
				local Waterways = require(wwModule) :: any
				Waterways.Build(root)
			end)
			if not okWw then
				warn("[WAR EMPIRE] MapSetup: Waterways.Build failed (map continues without public water):", errWw)
			end
		else
			warn("[WAR EMPIRE] MapSetup: Modules.Waterways missing — no public water built")
		end
	end

	-- World v2 (spec §1.1–§1.5): WorldBounds builds <root>.WE_Skyline (48 Persistent parts) and <root>.WE_Bounds (invisible
	-- ground / air walls, seabed tint, far-shore lighthouse + freighter). WorldTerrain fills the Terrain canyon edge round
	-- the ring canal and the Bay in the background (about 2,000 fills, yielding; skipped when Workspace.Terrain is already
	-- stamped with WorldConfig.Terrain.Gen). Each call is guarded: a failure never stops the map build.
	withWorldModule("WorldBounds", function(m: any)
		m.Build(root)
	end)
	task.spawn(function()
		withWorldModule("WorldTerrain", function(m: any)
			m.Build()
		end)
	end)

	-- Naval spawn pontoons (WaterConfig.NavalPads: the 9 sea pads + 3 ring landings at road ends). Tagged WE_NavalSpawn
	-- only: a pad in the water must never be picked as a ground-vehicle / jeep spawn.
	-- World v2 (spec §3.3): the deck + 1 painted trim part (a lighter inset, so the pontoon reads as a pad from a boat);
	-- no beacon pole in the water, no Neon edge and no floating billboard. No painted name either: the world's painted
	-- signs stay within WorldConfig.Budgets.SurfaceGuis (17: 6 gate-pad garage signs, the Town board, EMPIRE BANK and the
	-- 9 POI boards) and the SurfaceGui hard cap. Boats spawn from the Garage menu, so nobody has to find a pontoon.
	do
		local navalFolder = ensureFolder("NavalSpawns", root)
		local padSize = WaterConfig.NavalPadSize
		for _, np in ipairs(WaterConfig.NavalPads) do
			local padAt = Vector3.new(np.X, 1.5, np.Z)
			local pad = part({
				Name = np.Name,
				Size = Vector3.new(padSize, 1.2, padSize),
				Position = padAt,
				Color = Color3.fromRGB(40, 70, 95),
				Material = Enum.Material.Concrete,
				CanCollide = true,
				Parent = navalFolder,
			})
			CollectionService:AddTag(pad, TAG_NAVAL)
			local trim = part({
				Name = np.Name .. "_Trim",
				Size = Vector3.new(padSize - 3, 0.06, padSize - 3),
				Position = padAt + Vector3.new(0, 0.6 + 0.03, 0),
				Color = Color3.fromRGB(70, 112, 140),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = navalFolder,
			})
			trim.CanQuery = false
			trim.CanTouch = false
		end
	end

	-- World v2 W1 (spec §1.6, §5 H6): the NPCPlaceholders block is gone: 20 static soldier statues (4 "HOSTILE" on the
	-- NPC pads, 4 per oil rig, 4 per fort) that never moved, carried a WE_NPC tag squads shot at, and stood on roads.
	-- Guards and hostiles are live CombatService NPCs (NPC anchors above, TerritoryConfig GuardNPCType).

	-- Empire Bank (W3 step 2 lane BK): the walk-in hall, its vault pad, open gate, state banner and Town.Bank.* anchors
	-- (buildEmpireBank above). Bank guards are live CombatService NPCs spawned by BankRaidService on the G anchors.
	buildEmpireBank(root)

	local tutorialFolder = ensureFolder("TutorialMarkers", root)
	local function tutorialMarker(name, pos, color, stepId)
		-- Hidden by default; TutorialController reveals only the active step (no billboard spam).
		-- v70 (HUD spec §5): an anchor only: no tutorial debug billboard and no Neon slab (the tutorial beam and the
		-- highlight are the cue).
		local p = part({
			Name = name,
			Size = Vector3.new(7, 1.2, 7),
			Position = pos,
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 1,
			CanCollide = false,
			Parent = tutorialFolder,
		})
		p:SetAttribute("TutorialStepId", stepId or name)
		CollectionService:AddTag(p, TAG_TUTORIAL)
		-- No beacon / ring clutter — waypoint beam is enough
		return p
	end

	local plot1 = PLOT_POSITIONS[1]
	-- Offsets track Plot1 spawn / structure grid (STRUCT_ORIGIN + gaps); v68: layout consoles when enabled
	local function structureMarkerPos(structureId: string, gridOffset: Vector3): Vector3
		local cf = BaseLayout.ConsoleCFrame(plot1, structureId)
		if cf then
			return cf.Position + Vector3.new(0, 1.4, 0)
		end
		return BaseLayout.PlotPoint(plot1, gridOffset.X, gridOffset.Z, gridOffset.Y)
	end
	local yardAt = Vector3.new(-14, 3, 42)
	local claimAt = Vector3.new(0, 2, 52)
	if BaseLayout.Enabled() then
		local cfg = BaseLayout.Config()
		yardAt = Vector3.new(cfg.Courtyard.TrainingYard.X, 3, cfg.Courtyard.TrainingYard.Z - 6)
		claimAt = Vector3.new(cfg.SpawnOffset.X, 2, cfg.SpawnOffset.Z - 4)
	end
	local atmAt = collectorShift() + Vector3.new(28, 0, 8)
	-- v70: claimAt / yardAt / atmAt are plot-local; BaseLayout.PlotPoint turns them with Plot1 (y relative to the plot)
	local mClaim = tutorialMarker("Tutorial_ClaimBase", BaseLayout.PlotPoint(plot1, claimAt.X, claimAt.Z, claimAt.Y), Color3.fromRGB(230, 200, 80), "ClaimBase")
	local mCC = tutorialMarker("Tutorial_CommandCenter", structureMarkerPos("CommandCenter", STRUCT_ORIGIN + Vector3.new(0, 1.4, 0)), Color3.fromRGB(80, 200, 120), "CommandCenter")
	local mRecruit = tutorialMarker("Tutorial_Recruit", BaseLayout.PlotPoint(plot1, yardAt.X, yardAt.Z, yardAt.Y), Color3.fromRGB(180, 220, 100), "RecruitSoldiers")
	tutorialMarker("Tutorial_Income", BaseLayout.PlotPoint(plot1, atmAt.X, atmAt.Z, atmAt.Y + 3), Color3.fromRGB(80, 200, 160), "Income")
	-- Click dropper sits near ATM (ManualDropper CollectorOffset ≈ -5.5, 0, 4 from collector body)
	tutorialMarker("Tutorial_Dropper", BaseLayout.PlotPoint(plot1, atmAt.X - 5.5, atmAt.Z + 4, atmAt.Y + 2.5), Color3.fromRGB(70, 220, 100), "ClickDropper")
	-- Pads first / beams first 3 beats: dress arrow meshes on early markers
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachTutorialArrow then
				for _, m in ipairs({ mClaim, mCC, mRecruit }) do
					if m then
						vas.TryAttachTutorialArrow(m)
					end
				end
			end
		end)
	end)
	tutorialMarker("Tutorial_Barracks", structureMarkerPos("Barracks", STRUCT_ORIGIN + Vector3.new(STRUCT_GAP, 1.4, 0)), Color3.fromRGB(100, 180, 220), "Barracks")
	local jeepPos = Vector3.new(200, 2, 0)
	-- World v2 (spec §3.3): the Gate_P1 pad (WorldConfig.Spawns.TutorialJeepPad); the tutorial beam itself resolves to
	-- the player's own plot (TutorialController). Fallback: the first garage pad on LAND (never a naval pontoon).
	local jeepPad = garageFolder:FindFirstChild(spawnCfg.TutorialJeepPad)
	if jeepPad and jeepPad:IsA("BasePart") then
		jeepPos = jeepPad.Position + Vector3.new(0, 2, 0)
	else
		for _, vs in ipairs(CollectionService:GetTagged(TAG_VEHICLE)) do
			if vs:IsA("BasePart") and not CollectionService:HasTag(vs, TAG_NAVAL) then
				jeepPos = vs.Position + Vector3.new(0, 2, 0)
				break
			end
		end
	end
	tutorialMarker("Tutorial_Jeep", jeepPos, Color3.fromRGB(120, 140, 200), "Jeep")
	tutorialMarker("Tutorial_Outpost", Vector3.new(0, 3, 0), Color3.fromRGB(200, 120, 80), "Outpost")

	-- v68: the always-on neon guide beams (collector → Command Center → Vehicle Depot) are gone: at the 320-stud
	-- layout they were long glowing lines cutting across the whole base. TutorialController draws one subtle
	-- guide to the current step only, while the tutorial runs.

	-- Military world dressing (visual only). Does not tag WE_UpgradeSlot / buy pads.
	-- PERF: skip MapDressing entirely in Studio unless ForceDress (attribute or DevConfig).
	-- Stagger after first frame so Play Solo is usable in seconds on laptop CPUs.
	task.defer(function()
		task.wait() -- yield past first frame
		local forceAttr = root:GetAttribute("ForceDress") == true
			or (Workspace:GetAttribute("ForceDress") == true)
		local forceDress = forceAttr or (DevConfig.StudioForceDress == true)
		local inStudio = RunService:IsStudio()
		local skipDress = inStudio and (DevConfig.StudioSkipWorldDressing ~= false) and not forceDress
		-- Live / non-Studio: Full warzone dressing. Studio ForceDress uses DevConfig quality.
		local quality = if (not inStudio) then "Full" else tostring(DevConfig.WorldDressQuality or "Low")

		print("[WAR EMPIRE] PERF note: deco kits use CastShadow=false. Studio Rendering → disable shadows / lower quality if still slow.")
		if skipDress then
			print("[WAR EMPIRE] PERF: MapDressing SKIPPED in Studio (StudioSkipWorldDressing). Set Workspace.WarEmpireSetup.ForceDress=true or DevConfig.StudioForceDress=true then resetmap to load dressing.")
		else
			task.wait(0.05)
			local okDress, errDress = pcall(function()
				MapDressing.Dress(root, { Quality = quality })
			end)
			if not okDress then
				warn("[WAR EMPIRE] MapDressing failed:", errDress)
			end
		end

		task.wait(0.1)
		-- Live: Full flora (align MapDressing live Full). Studio: sparse unless StudioSparseFlora=false.
		local wantFullFlora = (not inStudio)
			or (inStudio and DevConfig.StudioSparseFlora == false)
		local sparseFlora = not wantFullFlora
		local okFlora, errFlora = pcall(function()
			DesertFlora.Dress(root, { Sparse = sparseFlora })
		end)
		if not okFlora then
			warn("[WAR EMPIRE] DesertFlora failed:", errFlora)
		end
	end)

	-- Guarantee at least one Neutral Duration=0 spawn near origin
	local hasNeutralSpawn = false
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("SpawnLocation") and inst.Neutral and inst.Duration == 0 then
			hasNeutralSpawn = true
			break
		end
	end
	if not hasNeutralSpawn then
		local fallbackSpawn = Instance.new("SpawnLocation")
		fallbackSpawn.Name = "NeutralSpawn"
		fallbackSpawn.Size = Vector3.new(12, 1, 12)
		fallbackSpawn.Position = Vector3.new(0, 5, 0)
		fallbackSpawn.Anchored = true
		fallbackSpawn.CanCollide = true
		fallbackSpawn.Neutral = true
		fallbackSpawn.Duration = 0
		fallbackSpawn.BrickColor = BrickColor.new("Bright green")
		fallbackSpawn.Material = Enum.Material.SmoothPlastic -- World v2 W1: no Neon outside the bases
		fallbackSpawn.Parent = root
		print("[WAR EMPIRE] MapSetup: added fallback NeutralSpawn at (0,5,0)")
	end

	buildPadSupportShelves(root)

	-- World v2 W1 (spec §1.6): the OilSpectacle block (3 "OIL FIELD" pads with an amber light, derrick, walking beam and
	-- barrel ring near the plots, no mechanic) and the WarzoneLandmarks block (grey RadioTower / SmallFort /
	-- BunkerApproach host boxes with labels, one on RoadX0) are gone. Their derricks and kits return inside the Phase 2
	-- POIs (Oil Field, Signal Station).

	-- v70: stamp the layout generation last (a Run that threw part-way stays unstamped → Bootstrap rebuilds it)
	root:SetAttribute("WE_MapGen", MapSetup.MAP_GEN)
	root:SetAttribute("WE_LayoutSig", MapSetup.LAYOUT_SIG) -- claude-bud: Bootstrap rebuilds a saved map from another layout

	print("[WAR EMPIRE] MapSetup complete: desert ground=" .. tostring(GROUND_SIZE) .. "x" .. tostring(GROUND_THICKNESS) .. " topY=" .. tostring(GROUND_TOP_Y) .. " (World v2 edge: WorldTerrain + WorldBounds; dressing deferred/Studio-skip)")
	print("[WAR EMPIRE] MapSetup confirmation: Gravity=" .. tostring(Workspace.Gravity) .. " WarEmpireSetup children=" .. tostring(#root:GetChildren()))
	print("[WAR EMPIRE] Walk onto upgrade pads to BUY (auto). E opens Base/Garage menus. Delete WarEmpireSetup + Play / admin resetmap to regenerate.")
end

return MapSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="179">
          <Properties>
            <string name="Name">MoveDebug</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v123 MoveDebug (Code Bot): the player-movement investigation for "running on a phone, he stops dead while his army is
	behind, then moves again once it catches up". Quiet unless the player's WE_MoveDebug attribute is true (/movedebug,
	admin allowlist). Design rule it guards: nothing ever stops, slows, freezes, anchors, repositions or body-blocks a
	PLAYER because his army is behind; the army adapts.

	Tagged writers: every server write to a player's Humanoid.WalkSpeed or a player character's PivotTo goes through
	MoveDebug.SetWalkSpeed / MoveDebug.PivotChar (or MoveDebug.Note next to it), so a log names WHO wrote it last.
	Watchers (every player, cheap, event driven): Humanoid WalkSpeed / JumpPower / JumpHeight / PlatformStand / Sit,
	root Anchored, and a mover / constraint / weld reaching out of the character are noted with the last tagged writer
	(or "unknown"). His parts outside WE_PlayerChars are listed by the sampler.
	Sampler (only players with WE_MoveDebug, 4 Hz, one summary line per second): network owner of his root (NOT him =
	[MOVEMENT OWNER LOST]: his phone can no longer move him), AssemblyRootPart (welded to something else), Anchored,
	WalkSpeed, Sit / PlatformStand, horizontal speed, parts outside WE_PlayerChars, and his army: order, units,
	nearest / centre distance, units within 6 studs, units CatchingUp, and any soldier part that could collide with him.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")

local MoveDebug = {}

MoveDebug.Attr = "WE_MoveDebug"
MoveDebug.PlayerGroup = "WE_PlayerChars"
MoveDebug.ArmyGroup = "ArmyNPCs"
MoveDebug.Stats = { Notes = 0, Samples = 0, OwnerLost = 0, Welded = 0, SoldierCollidable = 0 }

type Write = { T: number, What: string, Who: string }

local RING = 8
local writes: { [number]: { Write } } = {}
local deps: { [string]: any } = {}
local started = false
local lastSummaryAt: { [number]: number } = {}
local lastWarnAt: { [string]: number } = {}

local MOVER_CLASSES: { [string]: boolean } = {
	AlignPosition = true, AlignOrientation = true, LinearVelocity = true, VectorForce = true, BodyPosition = true,
	BodyVelocity = true, BodyGyro = true, BodyForce = true, BodyThrust = true, RocketPropulsion = true,
	BodyAngularVelocity = true, AngularVelocity = true, LineForce = true, Torque = true, PlaneConstraint = true,
	RopeConstraint = true, RodConstraint = true, SpringConstraint = true, BallSocketConstraint = true,
	WeldConstraint = true, Weld = true, ManualWeld = true, Motor6D = true, NoCollisionConstraint = false,
}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function playerOf(x: any): Player?
	if typeof(x) ~= "Instance" then
		return nil
	end
	if x:IsA("Player") then
		return x
	end
	local model: Instance? = if x:IsA("Model") then x else x:FindFirstAncestorOfClass("Model")
	while model do
		local p = Players:GetPlayerFromCharacter(model)
		if p then
			return p
		end
		model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function MoveDebug.On(player: Player): boolean
	return player:GetAttribute(MoveDebug.Attr) == true
end

local function warnOnce(key: string, every: number, msg: string)
	local now = os.clock()
	if now - (lastWarnAt[key] or -math.huge) >= every then
		lastWarnAt[key] = now
		warn(msg)
	end
end

-- a tagged write on a PLAYER (character / humanoid / part / player): kept in his ring, printed while he debugs
function MoveDebug.Note(target: any, what: string, who: string)
	local p = playerOf(target)
	if p == nil then
		return
	end
	MoveDebug.Stats.Notes += 1
	local r = writes[p.UserId]
	if r == nil then
		r = {}
		writes[p.UserId] = r
	end
	table.insert(r, { T = os.clock(), What = what, Who = who })
	if #r > RING then
		table.remove(r, 1)
	end
	if MoveDebug.On(p) then
		print(string.format("[MoveDebug] WRITE %s %s by %s", p.Name, what, who))
	end
end

-- the ONE server setter for a player's WalkSpeed (tagged)
function MoveDebug.SetWalkSpeed(hum: Humanoid, value: number, who: string)
	MoveDebug.Note(hum, string.format("WalkSpeed=%.1f", value), who)
	hum.WalkSpeed = value
end

-- the ONE server mover of a player character (tagged): teleports only (respawn / base / fall rescue / vehicle exit)
function MoveDebug.PivotChar(char: Model, cf: CFrame, who: string)
	MoveDebug.Note(char, "PivotTo", who)
	char:PivotTo(cf)
end

function MoveDebug.LastWrites(player: Player): string
	local r = writes[player.UserId]
	if r == nil or #r == 0 then
		return "none"
	end
	local now = os.clock()
	local parts = {}
	for i = #r, math.max(1, #r - 4), -1 do
		local w = r[i]
		table.insert(parts, string.format("%s<-%s %.1fs ago", w.What, w.Who, now - w.T))
	end
	return table.concat(parts, "; ")
end

local function lastWho(player: Player): string
	local r = writes[player.UserId]
	if r and #r > 0 and os.clock() - r[#r].T < 1 then
		return r[#r].Who
	end
	return "unknown"
end

-- can a part in `group` touch a player character (WE_PlayerChars)?
local function collidesWithPlayers(group: string): boolean
	local ok, c = pcall(function()
		return PhysicsService:CollisionGroupsAreCollidable(group, MoveDebug.PlayerGroup)
	end)
	return ok and c == true
end
MoveDebug.CollidesWithPlayers = collidesWithPlayers

local function watchCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	if not (hum and hum:IsA("Humanoid")) then
		return
	end
	local h = hum :: Humanoid
	for _, prop in ipairs({ "WalkSpeed", "JumpPower", "JumpHeight", "PlatformStand", "Sit" }) do
		h:GetPropertyChangedSignal(prop):Connect(function()
			local v = (h :: any)[prop]
			local r = writes[player.UserId]
			local tagged = r and #r > 0 and os.clock() - r[#r].T < 0.05
			if not tagged then
				MoveDebug.Note(player, string.format("%s->%s", prop, tostring(v)), "untagged:" .. lastWho(player))
			end
		end)
	end
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if root and root:IsA("BasePart") then
		root:GetPropertyChangedSignal("Anchored"):Connect(function()
			MoveDebug.Note(player, "root.Anchored->" .. tostring((root :: BasePart).Anchored), lastWho(player))
		end)
	end
	char.DescendantAdded:Connect(function(d)
		if MOVER_CLASSES[d.ClassName] == true then
			-- a joint inside his own rig is normal; one that reaches OUT of the character (or any mover) is logged
			local out = false
			if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
				local a: any = d
				local p0, p1 = a.Part0, a.Part1
				out = (p0 ~= nil and not p0:IsDescendantOf(char)) or (p1 ~= nil and not p1:IsDescendantOf(char))
			else
				out = true
			end
			if out then
				MoveDebug.Note(player, "added " .. d.ClassName .. " " .. d:GetFullName(), lastWho(player))
			end
		end
	end)
end

local function unitState(u: any): string
	return tostring(u._scState or u.MoveState or "?")
end

-- one sample of one debugging player
local function sample(player: Player, now: number)
	MoveDebug.Stats.Samples += 1
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and root and root:IsA("BasePart") and hum) then
		return
	end
	local r = root :: BasePart
	local h = hum :: Humanoid
	local okO, owner = pcall(function()
		return r:GetNetworkOwner()
	end)
	local ownerName = if okO then (if owner then owner.Name else "SERVER") else "?"
	if okO and owner ~= player and h.Health > 0 and h.SeatPart == nil then
		MoveDebug.Stats.OwnerLost += 1
		warnOnce("own" .. player.UserId, 1, string.format("[MOVEMENT OWNER LOST] %s root owner=%s assemblyRoot=%s last=%s", player.Name, ownerName, r.AssemblyRootPart and r.AssemblyRootPart:GetFullName() or "nil", MoveDebug.LastWrites(player)))
	end
	local ar = r.AssemblyRootPart
	if ar and ar ~= r and not ar:IsDescendantOf(char) and h.SeatPart == nil then
		MoveDebug.Stats.Welded += 1
		warnOnce("weld" .. player.UserId, 1, string.format("[MOVEMENT WELDED] %s is in the assembly of %s", player.Name, ar:GetFullName()))
	end
	-- his parts outside WE_PlayerChars (would collide with soldiers)
	local stray = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide and d.CollisionGroup ~= MoveDebug.PlayerGroup then
			table.insert(stray, d.Name .. "@" .. d.CollisionGroup)
			if #stray >= 3 then
				break
			end
		end
	end
	-- his army
	local armyTxt = "army=none"
	local squads = deps.Squads and deps.Squads() or nil
	local st = squads and squads[player.UserId]
	local soldierCollide = {}
	if st and st.Units then
		local n, near6, catching, sum = 0, 0, 0, Vector3.zero
		local nearest = math.huge
		for _, u in ipairs(st.Units) do
			local ur = u.Root
			if u.Alive ~= false and ur and ur.Parent then
				n += 1
				local d = flat(ur.Position - r.Position).Magnitude
				nearest = math.min(nearest, d)
				sum += ur.Position
				if d < 6 then
					near6 += 1
				end
				if unitState(u) == "CatchingUp" then
					catching += 1
				end
				if d < 12 and #soldierCollide < 3 then
					for _, p in ipairs(u.Model:GetDescendants()) do
						if p:IsA("BasePart") and p.CanCollide and collidesWithPlayers(p.CollisionGroup) then
							table.insert(soldierCollide, u.Model.Name .. "." .. p.Name .. "@" .. p.CollisionGroup)
							break
						end
					end
				end
			end
		end
		local centre = if n > 0 then flat(sum / n - r.Position).Magnitude else 0
		armyTxt = string.format("army=%s units=%d nearest=%.1f centre=%.1f within6=%d catchingUp=%d", tostring(st.Order), n, if n > 0 then nearest else -1, centre, near6, catching)
	end
	if #soldierCollide > 0 then
		MoveDebug.Stats.SoldierCollidable += 1
		warnOnce("sc" .. player.UserId, 2, "[MOVEMENT SOLDIER CAN COLLIDE] " .. player.Name .. ": " .. table.concat(soldierCollide, ", "))
	end
	if now - (lastSummaryAt[player.UserId] or -math.huge) >= 1 then
		lastSummaryAt[player.UserId] = now
		print(string.format(
			"[MoveDebug] S %s spd=%.1f ws=%.1f sit=%s ps=%s anch=%s owner=%s asm=%s group=%s stray=%s %s last=%s",
			player.Name, flat(r.AssemblyLinearVelocity).Magnitude, h.WalkSpeed, tostring(h.Sit), tostring(h.PlatformStand),
			tostring(r.Anchored), ownerName, if ar == r then "self" else (if ar then ar.Name else "nil"), r.CollisionGroup,
			if #stray > 0 then table.concat(stray, ",") else "0", armyTxt, MoveDebug.LastWrites(player)))
	end
end

-- deps: Squads() -> { [userId]: st }
function MoveDebug.Start(d: { [string]: any }?)
	if d then
		for k, v in pairs(d) do
			deps[k] = v
		end
	end
	if started then
		return
	end
	started = true
	local function onPlayer(p: Player)
		if p.Character then
			task.spawn(watchCharacter, p, p.Character)
		end
		p.CharacterAdded:Connect(function(c)
			watchCharacter(p, c)
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(p)
		writes[p.UserId] = nil
		lastSummaryAt[p.UserId] = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local now = os.clock()
		for _, p in ipairs(Players:GetPlayers()) do
			if MoveDebug.On(p) then
				local ok, err = pcall(sample, p, now)
				if not ok then
					warnOnce("err", 10, "[MoveDebug] sample error: " .. tostring(err))
				end
			end
		end
	end)
end

return MoveDebug
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="180">
          <Properties>
            <string name="Name">NationFlag</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NationFlag (nations spec section 2 Server, lane B): the owner's chosen flag on their OWN base.

	Two flag parts per plot, both built by other modules and only reshaped + dressed here (MapSetup is never edited;
	spec R7). The work is idempotent, so every OnPlotReady may call ApplyPlot again:
	  ParadeFlag   Bases.PlotN.LayoutGround.ParadeFlag (MapSetup). Turned to 6 x 4.5 x 0.14 so its faces look down
	               the plot's +Z axis (the main gate), hoist next to the FlagPole, fly towards plot +X.
	  HQ flag      Bases.PlotN.CommandCenter (plinth) > WE_Building (HollowBuildingBuilder, StructureId
	               "CommandCenter") > Flag. Trimmed to 0.12 x 3.6 x 4.8 (4:3) with the hoist kept at its pole. The
	               building is rebuilt on every level change, so the plot folder's DescendantAdded re-dresses the new
	               flag (one Name compare per added instance; no scans, no loops).
	Each flag part gets the CollectionService tag WE_NationFlag, the attribute WE_NationShaped and exactly two
	Texture children (WE_NationTexA / WE_NationTexB) on the two faces of its thinnest axis
	(NationTexture.ThinFaces). A Texture shows one atlas cell (NationTexture.Source / TextureProps).
	  * Showing a nation with art: Texture = the atlas image, cropped; the part takes the nation's banner colour
	    (seen on the thin edges).
	  * Showing a nation without art (atlas id 0): Texture blank and Transparency 1; the part takes the banner colour.
	  * Plain (no owner, NationId nil / "NEUTRAL", feature hidden for this owner): the part's original army green,
	    Textures blank and Transparency 1. Parts are never destroyed.
	WE_NationShown on the part is the idempotence key (shown id, face size, image): an unchanged view writes nothing.

	The flagpole prompt (WE_PanelPrompt on FlagBase; WE_OpenPanel "Nation", WE_OpenTab "flagpole", "Change flag",
	hold 0, range 12) exists only while the plot has an owner AND the view says Show (nations art ready, or the
	owner is an admin; lead decision 6). WE_PanelPrompt is in HudConfig.ActionLane.OwnerOnlyPromptNames, so other
	players' clients disable it locally; the server Triggered handler checks the owner again.

	Never here (CLAUDE.md nation rule): GUI text on the flag (flags are Textures only), lights or glowing materials,
	anything at the gate (strike fire spawns there; the flags stand at the parade ground and the HQ roof, 140+ studs
	from the gate), and no effect, text or rule that names a nation.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared -- replicated by Rojo before any server script runs (no unbounded wait)
local NationConfig = require(Shared.Configs.NationConfig)
local NationTexture = require(Shared.Util.NationTexture)

local NationFlag = {}

NationFlag.Tag = "WE_NationFlag"

export type View = {
	OwnerUserId: number?, -- nil: nobody owns the plot (plain flags, no prompt)
	NationId: string?, -- the owner's saved id: a NationConfig id, NationConfig.NeutralId or nil
	Show: boolean, -- the owner may see nations here (NationConfig.Enabled and (art ready or admin))
}

type PlotState = {
	Folder: Instance?,
	AddedConn: RBXScriptConnection?,
	View: View?,
	Prompt: ProximityPrompt?,
	PromptConn: RBXScriptConnection?,
}

local PARADE_SIZE = Vector3.new(6, 4.5, 0.14) -- 4:3, faces along the pole's local Z (plot +Z = main gate)
local HQ_SIZE = Vector3.new(0.12, 3.6, 4.8) -- 4:3, keeps the builder's orientation (thin along X)
local POLE_GAP = 0.05 -- studs between the pole's surface and the hoist edge
local TEXTURE_NAMES = { "WE_NationTexA", "WE_NationTexB" }
local PROMPT_NAME = "WE_PanelPrompt" -- HudConfig.ActionLane.OwnerOnlyPromptNames
local PROMPT_RANGE = 12
local PLAIN_COLOR_ATTR = "WE_NationPlainColor"
local SHOWN_ATTR = "WE_NationShown"

local plots: { [number]: PlotState } = {}
local onPromptTriggered: ((Player, number) -> ())? = nil

---------------------------------------------------------------------------------------------------------------
-- lookups (targeted FindFirstChild only; the plot folder is never scanned)
---------------------------------------------------------------------------------------------------------------

local function findPlotFolder(plotId: number): Instance?
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	local folder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	if folder and folder:IsA("Folder") then
		return folder
	end
	return nil
end

local function childPart(parent: Instance?, name: string): BasePart?
	local p = parent and parent:FindFirstChild(name)
	if p and p:IsA("BasePart") then
		return p
	end
	return nil
end

local function isHqBuilding(inst: Instance): boolean
	return inst.Name == "WE_Building" and inst:IsA("Model") and inst:GetAttribute("StructureId") == "CommandCenter"
end

local function hqFlagOf(folder: Instance): BasePart?
	local building = folder:FindFirstChild("CommandCenter")
	local model = building and building:FindFirstChild("WE_Building")
	if model and isHqBuilding(model) then
		return childPart(model, "Flag")
	end
	return nil
end

---------------------------------------------------------------------------------------------------------------
-- shape (idempotent: the new CFrame is computed from the pole, never from the flag's previous shape)
---------------------------------------------------------------------------------------------------------------

local function markShaped(flag: BasePart)
	if flag:GetAttribute(PLAIN_COLOR_ATTR) == nil then
		flag:SetAttribute(PLAIN_COLOR_ATTR, flag.Color) -- the builder's army green, restored when nothing shows
	end
	if flag:GetAttribute("WE_NationShaped") ~= true then
		flag:SetAttribute("WE_NationShaped", true)
	end
	-- never a target: shots, hit effects and touches pass through the cloth (CLAUDE.md nation rule)
	if flag.CanQuery then
		flag.CanQuery = false
	end
	if flag.CanTouch then
		flag.CanTouch = false
	end
	if not CollectionService:HasTag(flag, NationFlag.Tag) then
		CollectionService:AddTag(flag, NationFlag.Tag)
	end
end

local function sameRotation(a: CFrame, b: CFrame): boolean
	return a.XVector:Dot(b.XVector) > 1 - 1e-6 and a.YVector:Dot(b.YVector) > 1 - 1e-6
end

-- writes only what differs (a re-apply of the same shape changes nothing)
local function setShape(flag: BasePart, size: Vector3, cf: CFrame)
	if (flag.Size - size).Magnitude > 1e-4 then
		flag.Size = size
	end
	if (flag.Position - cf.Position).Magnitude > 1e-3 or not sameRotation(flag.CFrame, cf) then
		flag.CFrame = cf
	end
end

-- Parade flag: 6 x 4.5 x 0.14 on the pole's +X side at its current height, faces along the pole's local Z.
local function shapeParade(flag: BasePart, pole: BasePart)
	local rel = pole.CFrame:PointToObjectSpace(flag.Position)
	local side = pole.Size.X * 0.5 + POLE_GAP + PARADE_SIZE.X * 0.5
	setShape(flag, PARADE_SIZE, pole.CFrame * CFrame.new(side, rel.Y, 0))
	markShaped(flag)
end

-- HQ flag: 0.12 x 3.6 x 4.8, same orientation and height, hoist edge POLE_GAP from its pole.
local function shapeHq(flag: BasePart)
	local model = flag.Parent
	local pole = childPart(model, "FlagPole")
	local cf = flag.CFrame
	if pole then
		local rel = cf:PointToObjectSpace(pole.Position)
		local sign = if rel.Z >= 0 then 1 else -1
		local hoist = rel.Z - sign * (pole.Size.X * 0.5 + POLE_GAP)
		cf = cf * CFrame.new(0, 0, hoist - sign * HQ_SIZE.Z * 0.5)
	end
	setShape(flag, HQ_SIZE, cf)
	markShaped(flag)
end

---------------------------------------------------------------------------------------------------------------
-- dress (two Textures; the part colour)
---------------------------------------------------------------------------------------------------------------

local function ensureTextures(flag: BasePart): { Texture }
	local faceA, faceB = NationTexture.ThinFaces(flag.Size.X, flag.Size.Y, flag.Size.Z)
	local faces = { faceA, faceB }
	local out: { Texture } = {}
	for i, name in ipairs(TEXTURE_NAMES) do
		local t = flag:FindFirstChild(name)
		local tex: Texture
		if t and t:IsA("Texture") then
			tex = t
		else
			tex = Instance.new("Texture")
			tex.Name = name
			tex.Texture = ""
			tex.Transparency = 1
			tex.Parent = flag
		end
		local face = (Enum.NormalId :: any)[faces[i]]
		if tex.Face ~= face then
			tex.Face = face
		end
		out[i] = tex
	end
	return out
end

local function viewNation(view: View?): NationConfig.NationDef?
	if view == nil or view.OwnerUserId == nil or not view.Show then
		return nil
	end
	return NationConfig.Get(view.NationId)
end

local function dress(flag: BasePart, view: View?)
	local textures = ensureTextures(flag)
	local def = viewNation(view)
	local _, _, w, h = NationTexture.ThinFaces(flag.Size.X, flag.Size.Y, flag.Size.Z)
	local src = if def then NationTexture.Source(def.Id) else nil
	local props = if src then NationTexture.TextureProps(w, h, src.Rect) else nil
	local image = if src and props then src.Image else ""
	local key = string.format("%s|%.2fx%.2f|%s", if def then def.Id else "-", w, h, image)
	if flag:GetAttribute(SHOWN_ATTR) == key then
		return -- nothing changed: no writes
	end
	local plain = flag:GetAttribute(PLAIN_COLOR_ATTR)
	local color = if def then def.Color elseif typeof(plain) == "Color3" then plain else flag.Color
	if flag.Color ~= color then
		flag.Color = color
	end
	for _, tex in ipairs(textures) do
		if props and image ~= "" then
			tex.Texture = image
			tex.StudsPerTileU = props.StudsPerTileU
			tex.StudsPerTileV = props.StudsPerTileV
			tex.OffsetStudsU = props.OffsetStudsU
			tex.OffsetStudsV = props.OffsetStudsV
			tex.Transparency = 0
		else
			tex.Texture = ""
			tex.Transparency = 1
		end
	end
	flag:SetAttribute(SHOWN_ATTR, key)
end

---------------------------------------------------------------------------------------------------------------
-- flagpole prompt (owner-only; created only while the view says Show)
---------------------------------------------------------------------------------------------------------------

local function dropPrompt(st: PlotState)
	if st.PromptConn then
		st.PromptConn:Disconnect()
		st.PromptConn = nil
	end
	if st.Prompt then
		st.Prompt:Destroy()
		st.Prompt = nil
	end
end

local function syncPrompt(plotId: number, st: PlotState, base: BasePart?)
	local view = st.View
	local want = base ~= nil and view ~= nil and view.OwnerUserId ~= nil and view.Show
	if not want or base == nil then
		dropPrompt(st)
		return
	end
	if st.Prompt and st.Prompt.Parent == base then
		return
	end
	dropPrompt(st)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = "Change flag"
	prompt.ObjectText = "Your flag"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt:SetAttribute("WE_OpenPanel", "Nation")
	prompt:SetAttribute("WE_OpenTab", "flagpole")
	prompt.Parent = base
	st.Prompt = prompt
	st.PromptConn = prompt.Triggered:Connect(function(who: Player)
		local cur = plots[plotId]
		local owner = cur and cur.View and cur.View.OwnerUserId
		if owner == nil or who.UserId ~= owner then
			return -- owner-only (other clients disable the prompt locally; checked again here)
		end
		if onPromptTriggered then
			onPromptTriggered(who, plotId)
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- binding
---------------------------------------------------------------------------------------------------------------

local function applyHq(plotId: number, flag: BasePart)
	local st = plots[plotId]
	shapeHq(flag)
	dress(flag, st and st.View)
end

local function bind(plotId: number): (PlotState?, Instance?)
	local folder = findPlotFolder(plotId)
	local st = plots[plotId]
	if not st then
		st = {}
		plots[plotId] = st
	end
	local state = st :: PlotState
	if folder == nil then
		return state, nil
	end
	if state.Folder ~= folder then
		if state.AddedConn then
			state.AddedConn:Disconnect()
		end
		dropPrompt(state)
		state.Folder = folder
		-- the Command Center is rebuilt on every level change: dress the new flag as soon as its model arrives
		state.AddedConn = folder.DescendantAdded:Connect(function(inst: Instance)
			if inst.Name ~= "WE_Building" or not isHqBuilding(inst) then
				return
			end
			local flag = childPart(inst, "Flag")
			if flag then
				applyHq(plotId, flag)
			end
		end)
	end
	return state, folder
end

--[[ Show `view` on plot `plotId` (idempotent; call it on every OnPlotReady and after every accepted pick).
	Returns the flag parts it dressed (0-2). Never yields. ]]
function NationFlag.ApplyPlot(plotId: number, view: View): { BasePart }
	local st, folder = bind(plotId)
	local done: { BasePart } = {}
	if st == nil then
		return done
	end
	st.View = { OwnerUserId = view.OwnerUserId, NationId = view.NationId, Show = view.Show == true }
	if folder == nil then
		dropPrompt(st)
		return done
	end
	local ground = folder:FindFirstChild("LayoutGround")
	local parade = childPart(ground, "ParadeFlag")
	local pole = childPart(ground, "FlagPole")
	if parade and pole then
		shapeParade(parade, pole)
		dress(parade, st.View)
		table.insert(done, parade)
	end
	local hq = hqFlagOf(folder)
	if hq then
		applyHq(plotId, hq)
		table.insert(done, hq)
	end
	syncPrompt(plotId, st, childPart(ground, "FlagBase"))
	return done
end

--[[ The owner left / the plot was released: plain army green, no prompt. Parts and Textures stay (blank). ]]
function NationFlag.ResetPlot(plotId: number)
	NationFlag.ApplyPlot(plotId, { OwnerUserId = nil, NationId = nil, Show = false })
end

--[[ The owner id the plot's flags were last dressed for (nil = none). ]]
function NationFlag.OwnerOf(plotId: number): number?
	local st = plots[plotId]
	return if st and st.View then st.View.OwnerUserId else nil
end

-- claude-bud JOB 25: the view the plot's flags were last dressed with (the base sign's flag plate shows the same)
function NationFlag.ViewOf(plotId: number): View?
	local st = plots[plotId]
	return if st then st.View else nil
end

-- claude-bud JOB 25: dress any flag-shaped part (the base sign's plate) exactly like the plot's own flags: Textures on
-- its two thin faces, banner colour, idempotent (WE_NationShown)
function NationFlag.DressPart(flag: BasePart, view: View?)
	markShaped(flag)
	dress(flag, view)
end

--[[ cb(owner, plotId) when the plot's owner triggers the flagpole prompt (analytics only; the client opens the
	picker itself through WE_OpenPanel). ]]
function NationFlag.SetPromptHandler(cb: (Player, number) -> ())
	onPromptTriggered = cb
end

return NationFlag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="181">
          <Properties>
            <string name="Name">NightLights</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 17 (2026-09-29): the night lights (Shared/Configs/LightingConfig). Server-built once after the world
	dressing (MapDressing, after WorldFill), into Workspace.WE_NightLights (outside the dressing folders, so the world
	hygiene budget of 24 dressing lights is untouched). Live for all.
	  * Streetlights: along the Town's two main roads (RoadX0 / RoadZ0, off the lane), a ring round the Central Plaza,
	    the Town Square corners. Base gate + hangar floodlights on every plot. A light on the plaza flag.
	    PointLight / SpotLight, Shadows = false, tag WE_NightLight: WorldAtmosphere turns them on only at night.
	    Every second light carries WE_LowOff (the client's low-quality mode keeps those off).
	  * Glow (tag WE_NightGlow, Neon only at night): lamp heads, runway edge markers, lit windows on the town buildings'
	    real front walls (raycast onto the wall, never floating), the plaza flag.
	Nothing collides (never blocks a road, the plaza or a plot), nothing casts shadows, CanQuery / CanTouch off.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local LightingConfig = require(Shared.Configs.LightingConfig)
local WorldConfig = require(Shared.Configs.WorldConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)
local PlotFrame = require(Shared.Util.PlotFrame)

local NightLights = {}

local L: any = LightingConfig
local lightCount = 0
NightLights.Stats = { Lights = 0, Glow = 0, Windows = 0 }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundY(x: number, z: number): number?
	local r = Workspace:Raycast(Vector3.new(x, 300, z), Vector3.new(0, -400, 0), rayParams)
	return if r then r.Position.Y else nil
end

local function part(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Parent = parent
	return p
end

-- Neon + NightColor at night, day material / colour by day (WorldAtmosphere.SetNightLights flips the tag)
local function glow(p: BasePart, dayColor: Color3?, nightColor: Color3?)
	p:SetAttribute("WE_DayMaterial", p.Material.Name)
	if dayColor then
		p:SetAttribute("WE_DayColor", dayColor)
	end
	if nightColor then
		p:SetAttribute("WE_NightColor", nightColor)
	end
	CollectionService:AddTag(p, L.GlowTag)
	NightLights.Stats.Glow += 1
end

local function addLight(host: BasePart, kind: string, range: number, brightness: number, color: Color3, face: Enum.NormalId?, angle: number?): Light?
	if lightCount >= L.MaxLights then
		return nil
	end
	lightCount += 1
	local light: Light
	if kind == "Spot" then
		local s = Instance.new("SpotLight")
		s.Face = face or Enum.NormalId.Front
		s.Angle = angle or 70
		s.Range = range
		light = s
	else
		local pl = Instance.new("PointLight")
		pl.Range = range
		light = pl
	end
	light.Brightness = brightness
	light.Color = color
	light.Shadows = false
	light.Enabled = false
	if lightCount % 2 == 0 then
		light:SetAttribute(L.LowOffAttribute, true) -- the client's low-quality mode keeps every second light off
	end
	light.Parent = host
	CollectionService:AddTag(light, L.LightTag)
	NightLights.Stats.Lights = lightCount
	return light
end

-- one lamp post: a steel pole, an arm and a glowing head with the light
local function post(parent: Instance, name: string, x: number, z: number, height: number, range: number, brightness: number, color: Color3, toward: Vector3?)
	local y = groundY(x, z)
	if y == nil or lightCount >= L.MaxLights then
		return
	end
	local m = Instance.new("Model")
	m.Name = name
	local base = Vector3.new(x, y, z)
	part("Pole", Vector3.new(0.5, height, 0.5), CFrame.new(base + Vector3.new(0, height / 2, 0)), Color3.fromRGB(52, 54, 58), m)
	local out = if toward then Vector3.new(toward.X - x, 0, toward.Z - z) else Vector3.new(1, 0, 0)
	out = if out.Magnitude > 1e-3 then out.Unit else Vector3.new(1, 0, 0)
	local armCentre = base + Vector3.new(0, height - 0.2, 0) + out * 1.2
	part("Arm", Vector3.new(0.3, 0.3, 2.4), CFrame.lookAt(armCentre, armCentre + out), Color3.fromRGB(52, 54, 58), m)
	local headAt = base + Vector3.new(0, height - 0.6, 0) + out * 2.4
	local head = part("Head", Vector3.new(1.4, 0.5, 1.4), CFrame.new(headAt), Color3.fromRGB(120, 112, 96), m)
	glow(head, Color3.fromRGB(120, 112, 96), color)
	addLight(head, "Point", range, brightness, color)
	m.Parent = parent
end

-- ── claude-bud JOB 54: the per-plot night extras (owner-first by the plot owner) ─────────────────────────────────
local night2: { [number]: { Owner: number, Gate: CFrame?, Lights: number } } = {}
local night2Root: Instance? = nil

local function n2Live(ownerUserId: number): boolean
	local N2: any = L.Night2
	return typeof(N2) == "table" and (require(Shared.Configs.RetentionConfig) :: any).Live(N2, ownerUserId)
end

local function buildPlot2(plotId: number, gateCf: CFrame?, parent: Instance): number
	local N2: any = L.Night2
	local before = lightCount
	local f = Instance.new("Folder")
	f.Name = "Plot" .. plotId .. "_Night2"
	local function at(lx: number, lz: number): Vector3
		return PlotFrame.LocalToWorld(plotId, lx, lz)
	end
	local B = L.Base
	-- the helipad flood + its four green corner markers (glow only)
	local H = N2.Helipad
	local hp, ht = at(H.At[1], H.At[2]), at(H.Toward[1], H.Toward[2])
	post(f, "HelipadFlood", hp.X, hp.Z, 13, H.Range, H.Brightness, B.Color, ht)
	for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local p = at(H.Toward[1] + c[1] * H.PadHalf, H.Toward[2] + c[2] * H.PadHalf)
		local y = groundY(p.X, p.Z)
		if y then
			glow(part("PadCorner", Vector3.new(0.9, 0.3, 0.9), CFrame.new(p.X, y + 0.15, p.Z), Color3.fromRGB(70, 90, 70), f), Color3.fromRGB(70, 90, 70), H.PadColor)
		end
	end
	-- the dock flood + bollard lamps along the basin edge (glow only)
	local D = N2.Dock
	local dp, dt = at(D.At[1], D.At[2]), at(D.Toward[1], D.Toward[2])
	post(f, "DockFlood", dp.X, dp.Z, 13, D.Range, D.Brightness, B.Color, dt)
	for _, z in ipairs(D.BollardZ) do
		local p = at(D.BollardX, z)
		local y = groundY(p.X, p.Z)
		if y then
			part("Bollard", Vector3.new(0.7, 1.2, 0.7), CFrame.new(p.X, y + 0.6, p.Z), Color3.fromRGB(40, 42, 46), f)
			glow(part("BollardLamp", Vector3.new(0.6, 0.3, 0.6), CFrame.new(p.X, y + 1.35, p.Z), Color3.fromRGB(110, 100, 80), f), Color3.fromRGB(110, 100, 80), D.BollardColor)
		end
	end
	-- the lit gate sign: a lamp bar outside the gate arch, a spotlight back onto the sign
	local S = N2.Sign
	if gateCf and lightCount < L.MaxLights then
		local lampAt = gateCf * CFrame.new(0, S.Up, S.Out)
		local signAt = gateCf * CFrame.new(0, S.Up - 1.5, 0)
		local bar = part("SignLamp", Vector3.new(4, 0.35, 0.5), CFrame.lookAt(lampAt.Position, signAt.Position), Color3.fromRGB(70, 70, 70), f)
		glow(bar, Color3.fromRGB(70, 70, 70), S.Color)
		addLight(bar, "Spot", S.Range, S.Brightness, S.Color, Enum.NormalId.Front, S.Angle)
	end
	-- the beacon: a mast at the plot's rear corner, a red glowing head + one small light (seen from the air at night)
	local BC = N2.Beacon
	local half = BaseConfig.PlotSize.X / 2
	local bx, bz = BC.At[1], BC.At[2]
	if bx == 0 and bz == 0 then
		bx, bz = half - 8, -half + 8
	end
	local bp = at(bx, bz)
	local by = groundY(bp.X, bp.Z)
	if by then
		local m = Instance.new("Model")
		m.Name = "Beacon"
		part("Mast", Vector3.new(0.6, BC.MastHeight, 0.6), CFrame.new(bp.X, by + BC.MastHeight / 2, bp.Z), Color3.fromRGB(150, 150, 150), m)
		part("MastBand", Vector3.new(0.7, 2, 0.7), CFrame.new(bp.X, by + BC.MastHeight * 0.6, bp.Z), Color3.fromRGB(200, 60, 50), m)
		local head = part("BeaconHead", Vector3.new(1.2, 1.2, 1.2), CFrame.new(bp.X, by + BC.MastHeight + 0.6, bp.Z), Color3.fromRGB(120, 50, 45), m)
		glow(head, Color3.fromRGB(120, 50, 45), BC.Color)
		addLight(head, "Point", BC.Range, BC.Brightness, BC.Color)
		m.Parent = f
	end
	-- runway thresholds: a green row at the start, a red row at the end (glow only)
	local T = N2.Threshold
	for _, r in ipairs(BaseLayoutConfig.Roads) do
		if r.Name == "Runway" then
			local ends: { { X: number, C: Color3 } } = { { X = r.X - r.SizeX / 2 + 1.5, C = T.Start }, { X = r.X + r.SizeX / 2 - 1.5, C = T.End } }
			for _, e in ipairs(ends) do
				for k = 1, T.Count do
					local lz = r.Z + (k - (T.Count + 1) / 2) * T.Spacing
					local p = at(e.X, lz)
					local y = groundY(p.X, p.Z)
					if y then
						glow(part("Threshold", Vector3.new(0.8, 0.3, 0.8), CFrame.new(p.X, y + 0.15, p.Z), Color3.fromRGB(80, 80, 72), f), Color3.fromRGB(80, 80, 72), e.C)
					end
				end
			end
		end
	end
	f.Parent = parent
	return lightCount - before
end

--[[ claude-bud JOB 54: (re)build one OWNED plot's night extras (GateDefenseService.syncPlotNow: claim / rejoin /
	restart / walls change). Owner-first by ownerUserId; nil owner or OFF = cleared. Returns the lights it added. ]]
function NightLights.SyncPlot(plotId: number, ownerUserId: number?, gateCf: CFrame?): number
	-- the same owner + gate and the folder is there: nothing to do (a walls / Defence purchase resyncs the plot)
	local cur = night2[plotId]
	local have = if night2Root then night2Root:FindFirstChild("Plot" .. plotId .. "_Night2") else nil
	if cur and have and cur.Owner == ownerUserId and cur.Gate == gateCf then
		return 0
	end
	NightLights.ClearPlot(plotId)
	if ownerUserId == nil or not LightingConfig.Enabled or not n2Live(ownerUserId) then
		return 0
	end
	local root = night2Root
	if root == nil or root.Parent == nil then
		night2[plotId] = { Owner = ownerUserId, Gate = gateCf, Lights = 0 } -- built when NightLights.Build runs
		return 0
	end
	rayParams.FilterDescendantsInstances = { root }
	local n = buildPlot2(plotId, gateCf, root)
	night2[plotId] = { Owner = ownerUserId, Gate = gateCf, Lights = n }
	local ok, WA = pcall(require, script.Parent.WorldAtmosphere)
	if ok and type(WA) == "table" and (WA :: any).IsNight then
		pcall((WA :: any).SetNightLights, (WA :: any).IsNight())
	end
	print(string.format("[NightLights] plot=%d owner=%d +%d lights (total %d / %d)", plotId, ownerUserId, n, lightCount, L.MaxLights))
	return n
end

function NightLights.ClearPlot(plotId: number)
	local rec = night2[plotId]
	night2[plotId] = nil
	if rec then
		lightCount = math.max(0, lightCount - rec.Lights)
		NightLights.Stats.Lights = lightCount
	end
	local root = night2Root
	local old = root and root:FindFirstChild("Plot" .. plotId .. "_Night2")
	if old then
		old:Destroy()
	end
end

function NightLights.Count(): number
	return lightCount
end

local function townStreets(parent: Instance)
	local S = L.Street
	local i = 0
	for t = -S.TownHalf, S.TownHalf, S.Spacing do
		if math.abs(t) >= S.SkipNearPlaza then
			i += 1
			local side = if i % 2 == 0 then 1 else -1
			-- RoadX0 runs along Z at x = 0; RoadZ0 along X at z = 0 (WaterConfig.RoadEnds): posts off the lane, arms over it
			post(parent, "StreetX_" .. i, side * S.Offset, t, S.PoleHeight, S.Range, S.Brightness, S.Color, Vector3.new(0, 0, t))
			post(parent, "StreetZ_" .. i, t, -side * S.Offset, S.PoleHeight, S.Range, S.Brightness, S.Color, Vector3.new(t, 0, 0))
		end
	end
	local P = L.PlazaRing
	for k = 0, P.Count - 1 do
		local a = math.rad(15 + k * (360 / P.Count)) -- never on the roads through the plaza (0 / 90 / 180 / 270)
		post(parent, "PlazaLamp_" .. k, math.cos(a) * P.Radius, math.sin(a) * P.Radius, L.Street.PoleHeight, P.Range, P.Brightness, S.Color, Vector3.zero)
	end
	local T = L.TownSquare
	local sq = Vector3.new(T.X, 0, T.Z)
	for k, off in ipairs({ Vector3.new(-T.Half, 0, -T.Half), Vector3.new(T.Half, 0, -T.Half), Vector3.new(T.Half + 4, 0, 0) }) do
		post(parent, "SquareLamp_" .. k, T.X + off.X, T.Z + off.Z, L.Street.PoleHeight, T.Range, T.Brightness, S.Color, sq)
	end
end

local function bases(parent: Instance)
	local B = L.Base
	local half = BaseConfig.PlotSize.X / 2
	local gateX = BaseLayoutConfig.MainGateWidth / 2 + 4
	local runway: any = nil
	for _, r in ipairs(BaseLayoutConfig.Roads) do
		if r.Name == "Runway" then
			runway = r
		end
	end
	for plotId = 1, BaseConfig.MaxPlots do
		if PlotFrame.PlotPosition(plotId) == nil then
			continue
		end
		local f = Instance.new("Folder")
		f.Name = "Plot" .. plotId .. "_Night"
		local function at(lx: number, lz: number): Vector3
			return PlotFrame.LocalToWorld(plotId, lx, lz)
		end
		-- gate floodlights, just inside the main gate on both sides of the lane, lighting the lane
		for _, sx in ipairs({ -1, 1 }) do
			local p = at(sx * gateX, half - 6)
			post(f, "GateFlood", p.X, p.Z, 12, B.GateRange, B.GateBrightness, B.Color, at(0, half - 20))
		end
		-- hangar floodlight beside the apron (never on the runway / apron rectangles)
		local h = at(-74, -101)
		post(f, "HangarFlood", h.X, h.Z, 14, B.HangarRange, B.HangarBrightness, B.Color, at(-100, -110))
		-- runway edge markers (Neon at night, no lights)
		if runway then
			local x0 = runway.X - runway.SizeX / 2
			local x1 = runway.X + runway.SizeX / 2
			for _, sz in ipairs({ -1, 1 }) do
				local lz = runway.Z + sz * (runway.SizeZ / 2 + 1)
				local lx = x0 + 2
				while lx <= x1 - 2 do
					local p = at(lx, lz)
					local y = groundY(p.X, p.Z)
					if y then
						local mk = part("RunwayEdge", Vector3.new(0.8, 0.35, 0.8), CFrame.new(p.X, y + 0.18, p.Z), Color3.fromRGB(90, 86, 70), f)
						glow(mk, Color3.fromRGB(90, 86, 70), B.RunwayMarkerColor)
					end
					lx += B.RunwayMarkerSpacing
				end
			end
		end
		f.Parent = parent
	end
end

-- the plaza flag: glows at night, one spotlight from the pole top onto it (TerritoryService builds it; waited for)
local function plazaFlag(parent: Instance)
	local F = L.Flag
	task.spawn(function()
		for _ = 1, 30 do
			local pole = Workspace:FindFirstChild(F.Pole, true)
			if pole and pole:IsA("BasePart") then
				local top = pole.Position + Vector3.new(0, pole.Size.Y / 2 + 0.6, 0)
				local lamp = part("FlagLamp", Vector3.new(0.8, 0.8, 0.8), CFrame.lookAt(top, top - Vector3.new(0, 1, 0) + Vector3.new(0.01, 0, 0)), Color3.fromRGB(90, 90, 90), parent)
				addLight(lamp, "Spot", F.Range, F.Brightness, Color3.fromRGB(255, 244, 220), Enum.NormalId.Front, F.Angle)
				local flag = Workspace:FindFirstChild(F.Flag, true)
				if flag and flag:IsA("BasePart") then
					glow(flag, nil, nil) -- Neon at night in its owner colour (TerritoryService keeps writing the colour)
				end
				local ok, WA = pcall(require, script.Parent.WorldAtmosphere)
				if ok and type(WA) == "table" and (WA :: any).IsNight then
					pcall((WA :: any).SetNightLights, (WA :: any).IsNight())
				end
				return
			end
			task.wait(2)
		end
	end)
end

-- Id -> Yaw of every town "block" cluster (the building's front faces (-sin yaw, 0, -cos yaw))
local function blockYaws(): { [string]: number }
	local out: { [string]: number } = {}
	local seen: { [any]: boolean } = {}
	local function walk(t: any, depth: number)
		if depth > 6 or seen[t] then
			return
		end
		seen[t] = true
		if typeof(t.Id) == "string" and t.Role == "block" and typeof(t.Yaw) == "number" then
			out[t.Id] = t.Yaw
		end
		for _, v in pairs(t) do
			if type(v) == "table" then
				walk(v, depth + 1)
			end
		end
	end
	walk(WorldConfig, 0)
	return out
end

local function windows(parent: Instance)
	local W = L.Windows
	if not W.Enabled then
		return
	end
	local yaws = blockYaws()
	local wf = Instance.new("Folder")
	wf.Name = "Windows"
	local hitParams = RaycastParams.new()
	hitParams.FilterType = Enum.RaycastFilterType.Include
	for _, m in ipairs(Workspace:GetDescendants()) do
		if m:IsA("Model") and m:GetAttribute("WE_Cluster") == "poi:block" and yaws[m.Name] ~= nil then
			local yaw = math.rad(yaws[m.Name])
			local front = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
			local right = Vector3.new(-front.Z, 0, front.X)
			local mn, mx = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					mn = mn:Min(d.Position - d.Size / 2)
					mx = mx:Max(d.Position + d.Size / 2)
				end
			end
			if mn.X == math.huge then
				continue
			end
			local centre = (mn + mx) / 2
			local ext = mx - mn
			local depth = math.abs(ext.X * front.X) + math.abs(ext.Z * front.Z)
			local width = math.abs(ext.X * right.X) + math.abs(ext.Z * right.Z)
			hitParams.FilterDescendantsInstances = { m }
			local placed = 0
			local cols = math.clamp(math.floor(width / W.ColumnSpacing) - 1, 1, 3)
			for floor = 1, 2 do
				local y = mn.Y + W.FirstFloorY + (floor - 1) * W.FloorHeight
				if y > mx.Y - 2 then
					break
				end
				for c = 1, cols do
					if placed >= W.MaxPerBuilding then
						break
					end
					local lat = (c - (cols + 1) / 2) * W.ColumnSpacing
					local from = Vector3.new(centre.X, y, centre.Z) + front * (depth / 2 + 6) + right * lat
					local r = Workspace:Raycast(from, -front * (depth + 8), hitParams)
					if r and r.Normal:Dot(front) > 0.9 then
						local p = r.Position + r.Normal * 0.08
						local win = part("Window", W.Size, CFrame.lookAt(p, p + r.Normal), W.DayColor, wf)
						placed += 1
						NightLights.Stats.Windows += 1
						-- deterministic "lit" pattern (the same on every server)
						local h = (#m.Name * 7 + floor * 13 + c * 5) % 10
						if h < W.LitShare * 10 then
							glow(win, W.DayColor, W.NightColor)
						end
					end
				end
			end
		end
	end
	wf.Parent = parent
end

function NightLights.Build()
	if not LightingConfig.Enabled then
		return
	end
	local old = Workspace:FindFirstChild("WE_NightLights")
	if old then
		old:Destroy()
	end
	lightCount = 0
	NightLights.Stats = { Lights = 0, Glow = 0, Windows = 0 }
	local f = Instance.new("Folder")
	f.Name = "WE_NightLights"
	rayParams.FilterDescendantsInstances = { f }
	local ok1, e1 = pcall(townStreets :: any, f)
	local ok2, e2 = pcall(bases :: any, f)
	local ok3, e3 = pcall(windows :: any, f)
	if not (ok1 and ok2 and ok3) then
		warn("[NightLights] partial build:", e1, e2, e3)
	end
	f.Parent = Workspace
	-- claude-bud JOB 54: the owned plots' extras (registered before this build ran) go back in
	night2Root = f
	for plotId, rec in pairs(table.clone(night2)) do
		night2[plotId] = nil
		pcall(NightLights.SyncPlot, plotId, rec.Owner, rec.Gate)
	end
	plazaFlag(f)
	local ok, WA = pcall(require, script.Parent.WorldAtmosphere)
	if ok and type(WA) == "table" and (WA :: any).IsNight then
		pcall((WA :: any).SetNightLights, (WA :: any).IsNight())
	end
	print(string.format("[NightLights] %d lights, %d glow parts, %d windows", NightLights.Stats.Lights, NightLights.Stats.Glow, NightLights.Stats.Windows))
end

return NightLights
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="182">
          <Properties>
            <string name="Name">OfferLedger</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot v153 (Shaun, 2026-09-30: "ship the sales fixes"): the server's record of a soft offer it SENT but the
	client has not yet confirmed it SHOWED. Root cause it fixes: MonetizationService used to set
	profile.StarterBundleOffered = true the moment it fired the StarterBundleOffer remote. The client then often
	held the card (driving the 4x4 / tutorial card / combat), dropped it after HudConfig.Offer.DropAfterQueuedSeconds,
	and the saved flag meant the Starter Pack never came back for that player.
	Now: Sent() records a pending send; the client answers on the OfferResult remote ("shown" / "dropped" /
	"refused") with the AckId it was given. Only "shown" marks the offer done (the caller saves the flag then);
	"dropped" / "refused" / no answer within AckTimeoutSeconds = re-queue after RequeueSeconds, at most
	MaxSendsPerSession sends per offer per session (then it waits for the next session, still unmarked).
	Pure Lua state (no instances, no yields, no clock of its own): tools/sim/run_first_offer_test.py drives it.
]]

local OfferLedger = {}
OfferLedger.__index = OfferLedger

export type Config = {
	AckTimeoutSeconds: number,
	RequeueSeconds: number,
	MaxSendsPerSession: number,
}

type Entry = {
	Sends: number,
	Pending: boolean,
	Seq: number,
	SentAt: number,
	Slot: any?, -- the caller's soft-offer slot claim, handed back on a drop so the slot can be refunded
	Shown: boolean,
}

export type Action = "mark" | "requeue" | "giveup" | "ignore"

function OfferLedger.new(cfg: Config)
	local self = setmetatable({}, OfferLedger)
	self.Cfg = cfg
	self.Users = {} :: { [number]: { [string]: Entry } }
	self.Seq = 0
	return self
end

local function entryOf(self: any, uid: number, key: string): Entry
	local u = self.Users[uid]
	if u == nil then
		u = {}
		self.Users[uid] = u
	end
	local e = u[key]
	if e == nil then
		e = { Sends = 0, Pending = false, Seq = 0, SentAt = -math.huge, Slot = nil, Shown = false }
		u[key] = e
	end
	return e :: Entry
end

-- true while a send waits for the client's answer (the caller must not send the same offer again)
function OfferLedger.IsPending(self: any, uid: number, key: string): boolean
	local u = self.Users[uid]
	local e = u and u[key]
	return e ~= nil and e.Pending == true
end

-- true once this session already spent every allowed send (or the client confirmed it shown)
function OfferLedger.Exhausted(self: any, uid: number, key: string): boolean
	local u = self.Users[uid]
	local e = u and u[key]
	if e == nil then
		return false
	end
	return e.Shown or e.Sends >= math.max(1, self.Cfg.MaxSendsPerSession)
end

-- a send went out: returns the AckId the client must echo back
function OfferLedger.Sent(self: any, uid: number, key: string, now: number, slot: any?): number
	local e = entryOf(self, uid, key)
	self.Seq += 1
	e.Seq = self.Seq
	e.Sends += 1
	e.Pending = true
	e.SentAt = now
	e.Slot = slot
	return e.Seq
end

--[[ The client's answer (or "timeout" from the caller's AckTimeoutSeconds timer). Returns the action and, for a drop,
	the slot claim to refund. A stale / unknown AckId or an entry that is not pending is ignored. ]]
function OfferLedger.Result(self: any, uid: number, key: string, result: string, seq: number?, _now: number?): (Action, any?)
	local u = self.Users[uid]
	local e = u and u[key]
	if e == nil or not e.Pending then
		return "ignore", nil
	end
	if seq ~= nil and seq ~= e.Seq then
		return "ignore", nil
	end
	local slot = e.Slot
	e.Pending = false
	e.Slot = nil
	if result == "shown" then
		e.Shown = true
		return "mark", nil
	end
	if result ~= "dropped" and result ~= "refused" and result ~= "timeout" then
		e.Pending = true -- junk from the client: keep waiting (the timeout still ends it)
		e.Slot = slot
		return "ignore", nil
	end
	if e.Sends >= math.max(1, self.Cfg.MaxSendsPerSession) then
		return "giveup", slot
	end
	return "requeue", slot
end

-- the AckTimeoutSeconds timer of send `seq` ran out
function OfferLedger.Timeout(self: any, uid: number, key: string, seq: number, now: number?): (Action, any?)
	return OfferLedger.Result(self, uid, key, "timeout", seq, now)
end

function OfferLedger.Forget(self: any, uid: number)
	self.Users[uid] = nil
end

return OfferLedger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="183">
          <Properties>
            <string name="Name">OutpostDefenders</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 24 §6: NPC defenders at every capturable outpost (Shared/Configs/OutpostDefenderConfig; read its
	header for the rules). Server only. The defenders are ordinary CombatService NPCs (SpawnNPC with a GroupId
	"Outpost.<id>", NoRespawn: this module brings them back), so damage, line of sight, hit chance, kill rewards, the army
	targeting them and their shooting back are all CombatService's, unchanged.

	deps (Start): CombatService, EngagementService?, NotificationService?,
	  Territories: () -> { { Id: string, Def: any, Held: boolean } }   (Held = a player / clan holds it now)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local C: any = require(Shared.Configs.OutpostDefenderConfig)

local OutpostDefenders = {}
OutpostDefenders.Stats = { Spawned = 0, Slept = 0, Killed = 0, Refused = 0 }

type Site = {
	Id: string,
	Recs: { any },
	Awake: boolean,
	ClearedAt: number?, -- all dead (killed) at this os.clock(): back RespawnSeconds later
	EmptySince: number?, -- nobody within SleepStuds since this os.clock()
	HeldBefore: boolean,
}

local deps: { [string]: any } = {}
local sites: { [string]: Site } = {}
local started = false
local blockedNoteAt: { [number]: number } = {}

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function alive(site: Site): number
	local n = 0
	for _, rec in ipairs(site.Recs) do
		if rec.Alive and rec.Model and rec.Model.Parent then
			n += 1
		end
	end
	return n
end

local function total(): number
	local n = 0
	for _, s in pairs(sites) do
		n += alive(s)
	end
	return n
end

-- the NPC types for a territory: Easy / Medium by StipendCash, Hard = its own GuardNPCType x GuardCount
function OutpostDefenders.TypesFor(def: any): { string }
	if typeof(def.Tier) == "string" and C.Tiers[def.Tier] then
		return C.Tiers[def.Tier] -- (a JOB 24 §7 area: its own tier)
	end
	local stipend = tonumber(def.StipendCash) or 0
	if stipend >= C.HardFromStipend then
		if typeof(def.GuardNPCType) == "string" then
			local out = {}
			for _ = 1, math.max(1, math.floor(tonumber(def.GuardCount) or 4)) do
				table.insert(out, def.GuardNPCType)
			end
			return out
		end
		return C.Tiers.Hard
	elseif stipend >= C.MediumFromStipend then
		return C.Tiers.Medium
	end
	return C.Tiers.Easy
end

function OutpostDefenders.TierFor(def: any): string
	if typeof(def.Tier) == "string" then
		return def.Tier
	end
	local stipend = tonumber(def.StipendCash) or 0
	return if stipend >= C.HardFromStipend then "Hard" elseif stipend >= C.MediumFromStipend then "Medium" else "Easy"
end

-- the posts: a ring round the capture point (oil rigs: a small ring on the deck), facing out
function OutpostDefenders.Posts(def: any, n: number): { CFrame }
	local c: Vector3 = def.Position
	local r = if def.IsOilRig then C.RigRingStuds else (tonumber(def.Radius) or 50) * C.RingFraction
	local out = {}
	for i = 1, n do
		local a = (i - 1) / n * math.pi * 2 + 0.4
		local p = Vector3.new(c.X + math.cos(a) * r, c.Y + 3, c.Z + math.sin(a) * r)
		table.insert(out, CFrame.lookAt(p, p + Vector3.new(math.cos(a), 0, math.sin(a))))
	end
	return out
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

local function wake(site: Site, def: any)
	local chars = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(chars, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = chars
	local cs = deps.CombatService
	if cs == nil or cs.SpawnNPC == nil then
		return
	end
	local types = OutpostDefenders.TypesFor(def)
	local posts = OutpostDefenders.Posts(def, #types)
	table.clear(site.Recs)
	for i, typeId in ipairs(types) do
		if total() >= C.MaxTotal then
			OutpostDefenders.Stats.Refused += 1
			break
		end
		local cf = posts[i]
		if not def.IsOilRig then
			-- stand on the real ground (terrain / a dune / a slab), never inside it or in the air
			local from = cf.Position + Vector3.new(0, 60, 0)
			local hit = workspace:Raycast(from, Vector3.new(0, -160, 0), groundParams)
			if hit then
				cf = CFrame.new(hit.Position + Vector3.new(0, 3, 0)) * cf.Rotation
			end
		end
		local ok, rec = pcall(cs.SpawnNPC, typeId, cf, {
			GroupId = "Outpost." .. site.Id,
			NoRespawn = true,
			Home = cf,
			Leash = (tonumber(def.Radius) or 50) + C.LeashExtraStuds,
			OverCap = true,
		})
		if ok and rec then
			rec.Model:SetAttribute("WE_OutpostDefender", site.Id)
			table.insert(site.Recs, rec)
			OutpostDefenders.Stats.Spawned += 1
		else
			OutpostDefenders.Stats.Refused += 1
		end
	end
	site.Awake = #site.Recs > 0
end

local function sleep(site: Site)
	local cs = deps.CombatService
	for _, rec in ipairs(site.Recs) do
		if rec.Alive and cs and cs.DespawnNPC then
			pcall(cs.DespawnNPC, rec.Id)
		end
	end
	table.clear(site.Recs)
	site.Awake = false
	OutpostDefenders.Stats.Slept += 1
end

-- true while this outpost still has a living defender (TerritoryService: nobody captures it yet)
function OutpostDefenders.Blocking(territoryId: string): boolean
	if C.Enabled ~= true then
		return false
	end
	local site = sites[territoryId]
	return site ~= nil and site.Awake and alive(site) > 0
end

-- a player standing in a blocked zone is told why the bar does not move (once per BlockedNoteSeconds)
function OutpostDefenders.NoteBlocked(player: Player)
	local ns = deps.NotificationService
	local now = os.clock()
	if ns == nil or now - (blockedNoteAt[player.UserId] or -math.huge) < C.BlockedNoteSeconds then
		return
	end
	blockedNoteAt[player.UserId] = now
	pcall(ns.Notify, player, C.BlockedText, "Warn")
end

local function anyPlayerWithin(pos: Vector3, studs: number): boolean
	for _, p in ipairs(Players:GetPlayers()) do
		local ch = p.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and flatDist(root.Position, pos) <= studs then
			return true
		end
	end
	return false
end

local function step()
	local list = deps.Territories and deps.Territories() or {}
	-- JOB 24 §7: the named enemy areas (never held: nothing to capture there)
	for _, a in ipairs(C.Areas or {}) do
		table.insert(list, { Id = "Area_" .. a.Id, Def = a, Held = false })
	end
	local now = os.clock()
	for _, t in ipairs(list) do
		local def = t.Def
		local site = sites[t.Id]
		if site == nil then
			site = { Id = t.Id, Recs = {}, Awake = false, ClearedAt = nil, EmptySince = nil, HeldBefore = t.Held }
			sites[t.Id] = site
		end
		if t.Held then
			-- a player / clan holds it: the defenders leave; they come back RespawnSeconds after it is neutral again
			if site.Awake then
				sleep(site)
			end
			site.HeldBefore = true
			site.ClearedAt = now
		else
			if site.HeldBefore then
				site.HeldBefore = false
				site.ClearedAt = now
			end
			local pos: Vector3 = def.Position
			if site.Awake then
				if alive(site) == 0 then
					site.Awake = false
					site.ClearedAt = now -- cleared by the players: back after RespawnSeconds
					table.clear(site.Recs)
				elseif anyPlayerWithin(pos, C.SleepStuds) then
					site.EmptySince = nil
				else
					site.EmptySince = site.EmptySince or now
					if now - (site.EmptySince :: number) >= C.SleepAfterSeconds then
						sleep(site)
						site.EmptySince = nil
					end
				end
			elseif (site.ClearedAt == nil or now - site.ClearedAt >= C.RespawnSeconds) and anyPlayerWithin(pos, C.WakeStuds) then
				wake(site, def)
			end
		end
	end
end

function OutpostDefenders.Start(d: { [string]: any })
	deps = d
	if started or C.Enabled ~= true then
		return
	end
	started = true
	local cs = deps.CombatService
	if cs and cs.OnNPCDeath then
		cs.OnNPCDeath(function(info: any)
			local g = info and info.GroupId
			if typeof(g) ~= "string" or string.sub(g, 1, 8) ~= "Outpost." then
				return
			end
			OutpostDefenders.Stats.Killed += 1
			local es = deps.EngagementService
			if info.Killer and es and es.NoteDefenderKill then
				pcall(es.NoteDefenderKill, info.Killer)
			end
		end)
	end
	task.spawn(function()
		task.wait(5)
		while true do
			local ok, err = pcall(step :: any)
			if not ok then
				warn("[OutpostDefenders] step error: " .. tostring(err))
			end
			task.wait(C.CheckSeconds)
		end
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		blockedNoteAt[p.UserId] = nil
	end)
	print("[WAR EMPIRE] OutpostDefenders started (max " .. tostring(C.MaxTotal) .. ")")
end

return OutpostDefenders
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="184">
          <Properties>
            <string name="Name">POILayouts</string>
          </Properties>
          <Item class="ModuleScript" referent="185">
            <Properties>
              <string name="Name">Frontier</string>
              <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE W3 step 2 — POI layout rows, group "Frontier": Airstrip, Signal, Radar, FortI, FortS.

	Lane D2, from the geometry plan's drafts (scratchpad w3s2/geo, layouts.py) with the merged spec's renames (§1.5) and
	the L0 contract's edits (§4). Keyed by POI Id; WorldPOI (lane P) reads a row for every ENABLED WorldConfig.POIs row
	whose Layout = "Frontier" (enable step 2). Budgets, Reserve, lights, signs and LowShare live in that WorldConfig row,
	not here. Data only: it requires nothing but WorldConfig (for the row types) and never yields.

	Rows (WorldConfig.POILayout):
	  • Clusters — the Town row format (TownCluster / KitPlace), world studs. Yaw 0 = the cluster front faces north (-Z),
	    90 = west (-X), -90 = east (+X), 180 = south (+Z); kits are local to the cluster frame. Tier 1 = built in Quality
	    Low and Full, Tier 2 = Full only.
	  • Rocks — Terrain rubble (0 parts). Infra — the airstrip runway (flat, no collision; POI_Airstrip.Infra).
	  • Anchors — activity anchors (invisible tagged Attachments, 0 parts) in WORLD studs, ids "<POI>.<Site>.<Role>".
	    They are stamped on the POI's one ActivityHost part (the "Host" cluster; it never moves). Every anchor here is on
	    the desert floor (Y 0) and at least WorldConfig.Activity.MinClear from every collidable part (checked on the real
	    kit builds). Yaw is the way the post / spot faces.
	  • The checkpoint anchors (Booth, Alarm, G1, G2, R1, R2) are NOT rows here: WorldPOI stamps
	    WorldConfig.Activity.CheckpointAnchors on every Checkpoint kit, ids "<POI>.<cluster Id>.<Role>". The Signal's one
	    road checkpoint is therefore the cluster "CP" (Signal.CP.*).
	  • PoiBoard kits leave Text nil: WorldPOI paints Board (within the POI's Signs and Budgets.SurfaceGuis).

	Consoles: a console anchor is where the player STANDS to use it, in front of the Terminal's screen (the kit's -Z
	side), never inside the desk. Each Terminal sits 2.5 behind its cluster pivot so the console anchor keeps the
	geometry plan's spot (the cluster pivot; the Signal relay's HoldPad centre) and stays 1.5 clear of the desk.

	Jobs here (spec §1.7; Phase B OpsService reads the anchors, nothing reads them yet):
	  Airstrip — tower uplink at Tower.Console, held against waves, 2 tower posts. The Hangar vault / loot / posts are
	             reserved (built, not a job yet).
	  Signal   — relay uplink at Relay.Console + the road checkpoint (Signal.CP.* from the template).
	  Radar    — uplink at Uplink.Console, 2 posts behind the ring sandbags.
	  FortI/S  — breach the fort: plant a charge at Breach.Gate (the 16-wide gate gap; there is no gate part), 4 posts.
	Prompt = "hold" marks where a job puts a hold prompt (start, grab, plant), as in Town.BankAnchors.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WorldConfig = require(ReplicatedStorage.Shared.Configs.WorldConfig)

local Layouts: { [string]: WorldConfig.POILayout } = {
	-- ═══ DESERT AIRSTRIP (Airdrop Apron arena; tower uplink; the hangar cargo heist is reserved) ══════════════════════
	Airstrip = {
		Board = "AIRSTRIP",
		Clusters = {
			{ Id = "Board", Block = "Road", Role = "board", Tier = 1, X = 772, Z = -1214, Yaw = -90, Street = true, Kits = { { Kit = "PoiBoard", X = 0, Z = 0 } } },
			-- north apron: the cargo hangar (reserved heist), a second hangar, the control tower (landmark) and its uplink desk
			{ Id = "N_Hangar1", Block = "N", Role = "heist", Tier = 1, X = 360, Z = -1332, Yaw = 180, Kits = { { Kit = "Hangar", X = 0, Z = 0, Width = 32 } } },
			{ Id = "N_Cargo", Block = "N", Role = "heist", Tier = 1, X = 360, Z = -1336, Yaw = 180, Kits = { { Kit = "CrateStack", X = -8, Z = 0, Variant = "ammo", Count = 6 }, { Kit = "HoldPad", X = 5, Z = -3, R = 7 } } },
			{ Id = "N_Hangar2", Block = "N", Role = "block", Tier = 2, X = 438, Z = -1332, Yaw = 180, Kits = { { Kit = "Hangar", X = 0, Z = 0, Width = 32 } } },
			{ Id = "N_Tower", Block = "N", Role = "landmark", Tier = 1, X = 680, Z = -1340, Yaw = 180, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "side+rear", Width = 12, Depth = 12, Storeys = 4, Roof = "mast+dish" } } },
			{ Id = "N_TowerDesk", Block = "N", Role = "heist", Tier = 1, X = 662, Z = -1318, Yaw = 180, Kits = { { Kit = "Terminal", X = 0, Z = 2.5 }, { Kit = "SandbagArc", X = 0, Z = -4 } } },
			{ Id = "N_Bowser", Block = "N", Role = "wrecks", Tier = 2, X = 560, Z = -1330, Yaw = 0, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "truck" }, { Kit = "FuelTank", X = 22, Z = -8, Scale = 0.8 } } },
			{ Id = "N_Bags", Block = "N", Role = "cover", Tier = 1, X = 520, Z = -1300, Yaw = 0, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 15 } } },
			-- south apron: the ops block (lantern), the motor shed, cover round the Airdrop Apron arena
			{ Id = "S_Ops", Block = "S", Role = "block", Tier = 2, X = 330, Z = -1186, Yaw = 0, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "shop+side", Width = 26, Depth = 16, Storeys = 2, Roof = "tank", Lantern = true } } },
			{ Id = "S_MotorShed", Block = "S", Role = "block", Tier = 2, X = 682, Z = -1170, Yaw = 90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "roller+metal", Width = 22, Depth = 14, Storeys = 1 } } },
			{ Id = "S_Apron1", Block = "S", Role = "cover", Tier = 1, X = 488, Z = -1188, Yaw = 90, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 } } },
			{ Id = "S_Apron2", Block = "S", Role = "cover", Tier = 1, X = 552, Z = -1188, Yaw = -90, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 } } },
			{ Id = "S_Apron3", Block = "S", Role = "cover", Tier = 2, X = 520, Z = -1160, Yaw = 180, Kits = { { Kit = "CrateStack", X = 0, Z = 0, Count = 3 }, { Kit = "Jersey", X = 8, Z = 1 } } },
			{ Id = "S_Lamp", Block = "S", Role = "lamp", Tier = 2, X = 440, Z = -1172, Yaw = 0, Kits = { { Kit = "StreetLamp", X = 0, Z = 0 } } },
			{ Id = "Host", Block = "Host", Role = "anchor", Tier = 1, X = 600, Z = -1170, Yaw = 0, Kits = { { Kit = "ActivityHost", X = 0, Z = 0 } } },
		},
		Rocks = {
			{ Kind = "scorch", X = 620, Z = -1280, Radius = 8, Tier = 2 },
		},
		Infra = {
			{ Id = "Runway", Kit = "Runway", X = 510, Z = -1250, Yaw = 0, Length = 500, Taxiway = { 760, 780, -1260, -1240 } },
		},
		Anchors = {
			{ Id = "Airstrip.Tower.Console", Kind = "console", X = 662, Z = -1318, Yaw = 180, R = 6, Prompt = "hold" }, -- uplink: in front of the desk, the sandbag arc at your back
			{ Id = "Airstrip.Tower.G1", Kind = "npc", X = 671, Z = -1336, Yaw = 180 }, -- beside the tower's west wall (3 clear), watching the desk
			{ Id = "Airstrip.Tower.G2", Kind = "npc", X = 689, Z = -1336, Yaw = 180 }, -- beside the tower's east wall (3 clear); both posts stay outside the console's R 6 zone
			{ Id = "Airstrip.Hangar.Vault", Kind = "hold", X = 355, Z = -1333, Yaw = 180, R = 7, Prompt = "hold" }, -- N_Cargo's HoldPad inside the open-front hangar (reserved)
			{ Id = "Airstrip.Hangar.Loot", Kind = "loot", X = 368, Z = -1334.4, Yaw = 0, Prompt = "hold" }, -- the ammo crates' open side (1.6 clear; reserved)
			{ Id = "Airstrip.Hangar.G1", Kind = "npc", X = 380, Z = -1318, Yaw = 180 }, -- east of the hangar mouth
			{ Id = "Airstrip.Hangar.G2", Kind = "npc", X = 520, Z = -1306, Yaw = 180 }, -- 6 north of N_Bags, which screen it from the runway
			{ Id = "Airstrip.Hangar.G3", Kind = "npc", X = 340, Z = -1318, Yaw = 180 }, -- west of the hangar mouth
			{ Id = "Airstrip.Apron.Arena", Kind = "arena", X = 520, Z = -1190, Yaw = 0 }, -- the existing AirdropApron event spot
		},
	},

	-- ═══ NORTH RIDGE SIGNAL STATION (NorthRidge capture; relay uplink; pass checkpoint) ═══════════════════════════════
	Signal = {
		Board = "NORTH RIDGE",
		Clusters = {
			{ Id = "CP", Block = "Road", Role = "checkpoint", Tier = 1, X = 0, Z = -1150, Yaw = 180, Street = true, Kits = { { Kit = "Checkpoint", X = 0, Z = 0 } } },
			{ Id = "Board", Block = "Road", Role = "board", Tier = 1, X = 24, Z = -1138, Yaw = 180, Street = true, Kits = { { Kit = "PoiBoard", X = 0, Z = 0 } } },
			-- west slope: the radio mast (landmark), huts, the relay uplink inside its sandbag horseshoe, a tower
			{ Id = "W_Mast", Block = "W", Role = "landmark", Tier = 1, X = -170, Z = -1400, Yaw = 0, Kits = { { Kit = "RadioMast", X = 0, Z = 0 } } },
			{ Id = "W_Hut1", Block = "W", Role = "block", Tier = 1, X = -150, Z = -1335, Yaw = -90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "side", Width = 18, Depth = 12, Storeys = 1, Roof = "mast+dish", Lantern = true } } },
			{ Id = "W_Hut2", Block = "W", Role = "block", Tier = 2, X = -150, Z = -1262, Yaw = -90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Width = 18, Depth = 12, Storeys = 1, Roof = "dish" } } },
			{ Id = "W_Relay", Block = "W", Role = "heist", Tier = 1, X = -196, Z = -1300, Yaw = -90, Kits = { { Kit = "Terminal", X = 0, Z = 2.5 }, { Kit = "SandbagLine", X = 0, Z = -7, Length = 10 }, { Kit = "SandbagLine", X = -7, Z = 0, Yaw = 90, Length = 10 }, { Kit = "SandbagLine", X = 7, Z = 0, Yaw = -90, Length = 10 }, { Kit = "HoldPad", X = 0, Z = 0, R = 6 } } },
			{ Id = "W_Block", Block = "W", Role = "block", Tier = 2, X = -236, Z = -1360, Yaw = -90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "damaged", Width = 22, Depth = 16, Storeys = 2, Roof = "tank" } } },
			{ Id = "W_Gen", Block = "W", Role = "crates", Tier = 2, X = -118, Z = -1206, Yaw = -90, Kits = { { Kit = "DrumGroup", X = 0, Z = 0, Count = 3 }, { Kit = "CrateStack", X = 0, Z = 7, Count = 2 } } },
			{ Id = "W_BagsN", Block = "W", Role = "cover", Tier = 1, X = -128, Z = -1418, Yaw = -45, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 15 } } },
			{ Id = "W_BagsS", Block = "W", Role = "cover", Tier = 1, X = -128, Z = -1182, Yaw = -135, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 15 } } },
			{ Id = "W_Watch", Block = "W", Role = "tower", Tier = 2, X = -255, Z = -1455, Yaw = 0, Kits = { { Kit = "Watchtower", X = 0, Z = 0 } } },
			{ Id = "W_RelayArc", Block = "W", Role = "cover", Tier = 1, X = -212, Z = -1290, Yaw = -90, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 } } },
			-- east of the pass
			{ Id = "E_Block", Block = "E", Role = "block", Tier = 2, X = 62, Z = -1452, Yaw = 90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "gutted", Width = 20, Depth = 14, Storeys = 2 } } },
			{ Id = "E_Bags", Block = "E", Role = "cover", Tier = 2, X = 58, Z = -1160, Yaw = 135, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 }, { Kit = "SandbagArc", X = 8, Z = 0 } } },
			{ Id = "Host", Block = "Host", Role = "anchor", Tier = 1, X = -200, Z = -1200, Yaw = 0, Kits = { { Kit = "ActivityHost", X = 0, Z = 0 } } },
		},
		Rocks = {
			{ Kind = "outcrop", X = -250, Z = -1200, Radius = 12, Tier = 1 },
			{ Kind = "rubble", X = -236, Z = -1340, Radius = 6, Tier = 2 },
		},
		Anchors = {
			-- Signal.CP.* (Booth, Alarm, G1, G2, R1, R2) come from the checkpoint template on cluster "CP"
			{ Id = "Signal.Relay.Console", Kind = "console", X = -196, Z = -1300, Yaw = -90, R = 6, Prompt = "hold" }, -- uplink: the HoldPad centre, in front of the relay desk
			{ Id = "Signal.Relay.G1", Kind = "npc", X = -160, Z = -1333, Yaw = -90 }, -- west of W_Hut1
			{ Id = "Signal.Relay.G2", Kind = "npc", X = -128, Z = -1412, Yaw = -45 }, -- behind W_BagsN
			{ Id = "Signal.Relay.G3", Kind = "npc", X = -217.5, Z = -1290, Yaw = -90 }, -- behind W_RelayArc
		},
	},

	-- ═══ RADAR HILL (RadarHill capture; radar uplink). Everything on the 110..130 ring outside the capture clear ═════════
	Radar = {
		Clusters = {
			{ Id = "Dome", Block = "Ring", Role = "landmark", Tier = 1, X = -1053.5, Z = -1009.8, Yaw = 0, Kits = { { Kit = "RadarDome", X = 0, Z = 0 } } },
			{ Id = "Console", Block = "Ring", Role = "heist", Tier = 1, X = -1068.9, Z = -945.8, Yaw = -88, Kits = { { Kit = "Terminal", X = 0, Z = 2.5 }, { Kit = "SandbagArc", X = 0, Z = 5 } } },
			{ Id = "Hut", Block = "Ring", Role = "block", Tier = 2, X = -1050.9, Z = -886.9, Yaw = -90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Width = 12, Depth = 8, Storeys = 1, Roof = "dish" } } },
			{ Id = "Bags_N", Block = "Ring", Role = "cover", Tier = 1, X = -991.4, Z = -1063.7, Yaw = -160, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 15 } } },
			{ Id = "Bags_NE", Block = "Ring", Role = "cover", Tier = 1, X = -904.7, Z = -1062.2, Yaw = 158, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 15 } } },
			{ Id = "Bags_SW", Block = "Ring", Role = "cover", Tier = 2, X = -1014.1, Z = -847.4, Yaw = -32, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 10 } } },
			{ Id = "Crates", Block = "Ring", Role = "crates", Tier = 2, X = -1022.6, Z = -1043, Yaw = -142, Kits = { { Kit = "CrateStack", X = 0, Z = 0, Count = 3 }, { Kit = "DrumGroup", X = 8, Z = 1, Count = 2 } } },
			{ Id = "Host", Block = "Ring", Role = "anchor", Tier = 1, X = -950, Z = -1072, Yaw = 0, Kits = { { Kit = "ActivityHost", X = 0, Z = 0 } } },
		},
		Rocks = {
			{ Kind = "outcrop", X = -1063.7, Z = -908.6, Radius = 8, Tier = 1 },
		},
		Anchors = {
			{ Id = "Radar.Uplink.Console", Kind = "console", X = -1068.9, Z = -945.8, Yaw = -88, R = 6, Prompt = "hold" }, -- in front of the radar desk, facing the hill
			{ Id = "Radar.Uplink.G1", Kind = "npc", X = -990, Z = -1059.9, Yaw = 20 }, -- behind Bags_N, facing out
			{ Id = "Radar.Uplink.G2", Kind = "npc", X = -906.2, Z = -1058.5, Yaw = -22 }, -- behind Bags_NE, facing out
		},
	},

	-- ═══ FORT IRONCLAD approach (the gate side only; the fort itself is MapSetup's) ═══════════════════════════════════
	FortI = {
		Clusters = {
			{ Id = "GateNest_W", Block = "Gate", Role = "nest", Tier = 1, X = 1424, Z = -1333, Yaw = 180, Kits = { { Kit = "SandbagNest", X = 0, Z = 0 } } },
			{ Id = "GateNest_E", Block = "Gate", Role = "nest", Tier = 1, X = 1476, Z = -1333, Yaw = 180, Kits = { { Kit = "SandbagNest", X = 0, Z = 0 } } },
			{ Id = "Trench_1", Block = "Trench", Role = "trench", Tier = 1, X = 1405, Z = -1290, Yaw = 20, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 30 } } },
			{ Id = "Trench_2", Block = "Trench", Role = "trench", Tier = 1, X = 1495, Z = -1290, Yaw = -20, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 30 } } },
			{ Id = "Traps_W", Block = "Traps", Role = "traps", Tier = 1, X = 1385, Z = -1325, Yaw = 0, Kits = { { Kit = "TankTrap", X = -14, Z = 0 }, { Kit = "TankTrap", X = 0, Z = 3 }, { Kit = "TankTrap", X = 14, Z = 0 } } },
			{ Id = "Traps_E", Block = "Traps", Role = "traps", Tier = 2, X = 1515, Z = -1325, Yaw = 0, Kits = { { Kit = "TankTrap", X = -14, Z = 0 }, { Kit = "TankTrap", X = 0, Z = 3 }, { Kit = "TankTrap", X = 14, Z = 0 } } },
			{ Id = "Tank", Block = "Field", Role = "wreck", Tier = 1, X = 1375, Z = -1262, Yaw = 25, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "tank" } } },
			{ Id = "Watch", Block = "Field", Role = "tower", Tier = 2, X = 1560, Z = -1300, Yaw = 180, Kits = { { Kit = "Watchtower", X = 0, Z = 0 } } },
			{ Id = "Host", Block = "Host", Role = "anchor", Tier = 1, X = 1600, Z = -1400, Yaw = 0, Kits = { { Kit = "ActivityHost", X = 0, Z = 0 } } },
		},
		Rocks = {
			{ Kind = "outcrop", X = 1335, Z = -1300, Radius = 12, Tier = 1 },
			{ Kind = "scorch", X = 1420, Z = -1300, Radius = 8, Tier = 1 },
			{ Kind = "scorch", X = 1520, Z = -1270, Radius = 8, Tier = 2 },
		},
		Anchors = {
			{ Id = "FortI.Breach.Gate", Kind = "door", X = 1450, Z = -1376, Yaw = 180, Prompt = "hold" }, -- the 16-wide gate gap: plant the charge (no gate part)
			{ Id = "FortI.Breach.G1", Kind = "npc", X = 1438, Z = -1380, Yaw = 180 }, -- inside, behind the west gate wall piece
			{ Id = "FortI.Breach.G2", Kind = "npc", X = 1462, Z = -1380, Yaw = 180 }, -- inside, behind the east gate wall piece
			{ Id = "FortI.Breach.G3", Kind = "npc", X = 1424, Z = -1337, Yaw = 180 }, -- in the west gate nest
			{ Id = "FortI.Breach.G4", Kind = "npc", X = 1476, Z = -1337, Yaw = 180 }, -- in the east gate nest
		},
	},

	-- ═══ FORT SANDHOLD approach (Fort Ironclad's point mirror through the map centre; r 200: tower and tank pulled in) ═══
	FortS = {
		Clusters = {
			{ Id = "GateNest_W", Block = "Gate", Role = "nest", Tier = 1, X = -1424, Z = 1333, Yaw = 0, Kits = { { Kit = "SandbagNest", X = 0, Z = 0 } } },
			{ Id = "GateNest_E", Block = "Gate", Role = "nest", Tier = 1, X = -1476, Z = 1333, Yaw = 0, Kits = { { Kit = "SandbagNest", X = 0, Z = 0 } } },
			{ Id = "Trench_1", Block = "Trench", Role = "trench", Tier = 1, X = -1405, Z = 1290, Yaw = -160, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 30 } } },
			{ Id = "Trench_2", Block = "Trench", Role = "trench", Tier = 1, X = -1495, Z = 1290, Yaw = 160, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 30 } } },
			{ Id = "Traps_W", Block = "Traps", Role = "traps", Tier = 1, X = -1385, Z = 1325, Yaw = -180, Kits = { { Kit = "TankTrap", X = -14, Z = 0 }, { Kit = "TankTrap", X = 0, Z = 3 }, { Kit = "TankTrap", X = 14, Z = 0 } } },
			{ Id = "Traps_E", Block = "Traps", Role = "traps", Tier = 2, X = -1515, Z = 1325, Yaw = -180, Kits = { { Kit = "TankTrap", X = -14, Z = 0 }, { Kit = "TankTrap", X = 0, Z = 3 }, { Kit = "TankTrap", X = 14, Z = 0 } } },
			{ Id = "Tank", Block = "Field", Role = "wreck", Tier = 1, X = -1396, Z = 1282, Yaw = -155, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "tank" } } }, -- moved 3 from the draft's (-1395, 1285), whose tracks cut 0.8 into Trench_1: now 2.3 clear
			{ Id = "Watch", Block = "Field", Role = "tower", Tier = 2, X = -1545, Z = 1290, Yaw = 0, Kits = { { Kit = "Watchtower", X = 0, Z = 0 } } },
