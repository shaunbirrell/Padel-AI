            <string name="Source"><![CDATA[--!strict
--[[ Add your Roblox UserIds here for admin commands ]]

local AdminConfig = {
	UserIds = {
		-- Example: 123456789,
	} :: { number },
	Commands = {
		"givecash",
		"givegold",
		"givexp",
		"setlevel",
		"unlockall",
		"resetbase",
	},
}

return AdminConfig
]]></string>
