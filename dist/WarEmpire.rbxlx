-- claude-bud JOB 53: the visual tier (0..4) of a Defence level (pure)
function EndgameConfig.DefenceVisualTier(level: number): number
	local at: any = EndgameConfig.DefenceVisuals.TierAt
	local t = 0
	for i, l in ipairs(at) do
		if (tonumber(level) or 0) >= l then
			t = i
		end
	end
	return t
end

-- claude-bud JOB 53: the gate's damage stage (pure): 0 clean, 1 <= 60 %, 2 <= 30 %, 3 breached
function EndgameConfig.GateDamageStage(frac: number, breached: boolean): number
	if breached then
		return 3
	end
	local st: any = EndgameConfig.DefenceVisuals.DamageStages
	local f = tonumber(frac) or 1
	if f <= st[2] then
		return 2
	elseif f <= st[1] then
		return 1
	end
	return 0
end

-- claude-bud JOB 55: the honest Defence rules on for this base owner (the Defence tree live AND the fix flag)
function EndgameConfig.DefenceFixLive(userId: any): boolean
	return EndgameConfig.LiveFor(userId, "Defence") and RetentionConfig.Live(EndgameConfig.DefenceFix, userId)
end

-- claude-bud JOB 55: the HP after a max-HP change that must NOT heal (a mid-raid Defence buy): the damage already taken
-- stays (new max - damage, at least 1); a broken thing (hp <= 0: a breached gate, a dead turret) stays broken (pure)
function EndgameConfig.KeepDamage(oldMax: number, oldHp: number, newMax: number): number
	if oldHp <= 0 then
		return 0
	end
	return math.clamp(newMax - (oldMax - oldHp), 1, newMax)
end

-- claude-bud JOB 55: what a Defence track gives at level L, honestly (pure; the Engineering Bureau rows + tests)
function EndgameConfig.DefenceText(track: string, L: number): string
	local D = EndgameConfig.Defence
	if track == "Plating" then
		return string.format("+%d%% turret HP", D.PlatingPct * L)
	elseif track == "Guns" then
		return string.format("+%d%% turret + guard dmg", D.GunsPct * L)
	elseif track == "Gate" then
		return string.format("+%d%% gate + guard HP, -%d s rebuild", D.GatePct * L, D.GateRebuildPerLevel * L)
	end
	return string.format("-%d%% ATM, -%d%% army raid loot", math.floor(D.VaultAtmPerLevel * L * 100 + 0.5), math.floor(D.VaultArmyPerLevel * L * 100 + 0.5))
end

-- claude-bud JOB 53: Defence visuals on for this base owner (the Defence tree live AND the visuals flag)
function EndgameConfig.DefenceVisualsLive(userId: any): boolean
	return EndgameConfig.LiveFor(userId, "Defence") and RetentionConfig.Live(EndgameConfig.DefenceVisuals, userId)
end

function EndgameConfig.LiveFor(userId: any, part: string): boolean
	local parts: any = EndgameConfig.Parts
	if parts[part] ~= true then
		return false
	end
	-- v157: a PublicParts part skips the owner-first rule only (Live.Enabled is still the kill switch)
	local pub: any = EndgameConfig.PublicParts
	if typeof(pub) == "table" and pub[part] == true and EndgameConfig.Live.Enabled == true then
		return true
	end
	return RetentionConfig.Live(EndgameConfig.Live, userId)
end

-- true when any part is live for this player (the client's stations and panels; the EMPIRE button)
function EndgameConfig.AnyLiveFor(userId: any): boolean
	for part in pairs(EndgameConfig.Parts) do
		if EndgameConfig.LiveFor(userId, part) then
			return true
		end
	end
	return false
end

-- v157: the gun camo path (wear / put on / take off a camo you own). The Armory (Mastery) sells camos, the Black
-- Market sells Urban / Tiger / Gold: a player the Black Market is live for can wear what he bought there even while
-- the Armory is still owner-only. Buying at the Armory stays Mastery-only.
function EndgameConfig.CamoLiveFor(userId: any): boolean
	return EndgameConfig.LiveFor(userId, "Mastery") or EndgameConfig.LiveFor(userId, "BlackMarket")
end

-- v157: the camos the Black Market sells (Items of Kind "Camo" -> [camo id] = item id)
function EndgameConfig.MarketCamos(): { [string]: string }
	local out: { [string]: string } = {}
	for id, it in pairs(EndgameConfig.BlackMarket.Items :: any) do
		if typeof(it) == "table" and it.Kind == "Camo" and typeof(it.Camo) == "string" then
			out[it.Camo] = id
		end
	end
	return out
end

-- round to the nearest `step`, halves to the even step (the spec's tables: 5M x 1.17 = 5.85M -> 5.8M)
local function roundTo(x: number, step: number): number
	local q = x / step
	local f = math.floor(q)
	local d = q - f
	if d > 0.5 + 1e-9 or (math.abs(d - 0.5) <= 1e-9 and f % 2 == 1) then
		f += 1
	end
	return f * step
end

local function level(n: any): number
	local v = tonumber(n) or 0
	if v ~= v then
		return 0
	end
	return math.max(0, math.floor(v))
end

-- the price of Empire Level L (1..MaxLevel); nil outside the track
function EndgameConfig.EmpireCost(L: number): number?
	local E = EndgameConfig.Empire
	local l = level(L)
	if l < 1 or l > E.MaxLevel then
		return nil
	end
	return roundTo(E.BaseCost * E.Growth ^ (l - 1), E.RoundTo)
end

-- the Empire cash factor at level L: 1 + 2 % x L (L30 = 1.60)
function EndgameConfig.EmpireMult(L: number): number
	local E = EndgameConfig.Empire
	local l = math.min(level(L), E.MaxLevel)
	return 1 + l * E.CashPctPerLevel / 100
end

function EndgameConfig.DefenceCost(L: number): number?
	local D = EndgameConfig.Defence
	local l = level(L)
	if l < 1 or l > D.MaxLevel then
		return nil
	end
	return roundTo(D.BaseCost * D.Growth ^ (l - 1), D.RoundTo)
end

function EndgameConfig.WorkshopCost(L: number): number?
	local W = EndgameConfig.Workshop
	local l = level(L)
	if l < 1 or l > W.MaxLevel then
		return nil
	end
	return roundTo(W.BaseCost * W.Growth ^ (l - 1), W.RoundTo)
end

function EndgameConfig.MasteryCost(tierBase: number, L: number): number?
	local l = level(L)
	if l < 1 or l > EndgameConfig.Mastery.MaxLevel then
		return nil
	end
	return math.floor(tierBase * 2 ^ (l - 1))
end

-- max(floor, N minutes of YOUR passive income) (perSec = WE_IncomePerSec)
function EndgameConfig.IncomeMinutesPrice(floor: number, minutes: number, perSec: number): number
	local ps = tonumber(perSec) or 0
	if ps ~= ps or ps < 0 then
		ps = 0
	end
	return math.max(math.floor(floor), math.floor(minutes * 60 * ps))
end

-- §2.1 the price factor for a player with `rebirths` rebirths: 1 + 0.20 x min(p, 20)
function EndgameConfig.RebirthCostScale(rebirths: number): number
	local R = EndgameConfig.Rebirth
	return 1 + R.CostScalePerRebirth * math.min(level(rebirths), R.CostScaleMaxRebirths)
end

-- a structure / business price after the scale (zone and Gold rows are never scaled; scale 1 = the raw price)
function EndgameConfig.ScaleStructureCost(structureId: string, cost: number, scale: number): number
	local s = tonumber(scale) or 1
	if s == 1 or s ~= s or s < 1 then
		return cost
	end
	local def: any = (BaseConfig.Structures :: any)[structureId]
	if def == nil or def.Zone ~= nil or def.Currency == "Gold" then
		return cost
	end
	return math.floor(cost * s + 0.5)
end

-- what one life (every scaled structure and business, level 1 to max) costs at `scale`
function EndgameConfig.LifeCost(scale: number): number
	local total = 0
	for id, def in pairs(BaseConfig.Structures :: any) do
		if typeof(def) == "table" and def.Zone == nil and def.Currency ~= "Gold" and typeof(def.Costs) == "table" then
			for i = 1, math.min(def.MaxLevel or #def.Costs, #def.Costs) do
				total += EndgameConfig.ScaleStructureCost(id, tonumber(def.Costs[i]) or 0, scale)
			end
		end
	end
	return total
end

-- §2.3 the summed Base Tier effects for tier t (1..5): gate HP %, soldier cap, AutoGun nests, rebuild seconds
function EndgameConfig.TierEffects(t: number): { GateHpPct: number, SoldierCap: number, Nests: number, RebuildSeconds: number }
	local out = { GateHpPct = 0, SoldierCap = 0, Nests = 0, RebuildSeconds = 0 }
	local tiers: any = EndgameConfig.BaseTier.Tiers
	for i = 1, math.min(level(t), #tiers) do
		local r = tiers[i]
		out.GateHpPct += tonumber(r.GateHpPct) or 0
		out.SoldierCap += tonumber(r.SoldierCap) or 0
		out.Nests += tonumber(r.AutoGunNests) or 0
		out.RebuildSeconds += tonumber(r.RebuildSeconds) or 0
	end
	return out
end

-- §2.4 one soldier type's multipliers at a training tier (0 = untrained): HP, damage, rig scale
function EndgameConfig.EliteStats(kind: string, tier: number): { Hp: number, Dmg: number, Scale: number }
	local El = EndgameConfig.Elite
	local t = math.clamp(level(tier), 0, #El.Tiers)
	local m = 1 + El.PctPerTier * t / 100
	local hp = m * (if kind == "Heavy" then El.HeavyHpMult else 1)
	local dmg = m * (if kind == "SpecialForces" then El.SpecialForcesDmgMult else 1)
	local row: any = El.Tiers[t]
	return { Hp = hp, Dmg = dmg, Scale = if row then tonumber(row.Scale) or 1 else 1 }
end

-- §2.4 the field slot's soldier type
function EndgameConfig.SlotKind(slot: number, sfFacilityLevel: number): string
	local El = EndgameConfig.Elite
	local s = level(slot)
	if s > 0 and s % El.SpecialForcesEvery == 0 and level(sfFacilityLevel) >= El.SpecialForcesNeedFacility then
		return "SpecialForces"
	elseif s > 0 and s % El.HeavyEvery == 0 then
		return "Heavy"
	end
	return "Infantry"
end

-- §2.9 a gun's stats after its mastery level (0..5) and attachments: damage +3 %, fire rate +2 %, range +4 %,
-- magazine +6 %, reload -5 % a level; Red-dot range +10 %, Grip spread -15 %, Extended Mag +25 %. Every multiplier
-- is capped at MaxMult 3 (the reload never under a third). `def` is a WeaponConfig row; returns a new table.
function EndgameConfig.GunStats(def: any, mastery: number, att: { [string]: boolean }?): { [string]: number }
	local Ma = EndgameConfig.Mastery
	local L = math.clamp(level(mastery), 0, Ma.MaxLevel)
	local a: { [string]: boolean } = att or {}
	local pl = Ma.PerLevel
	local cap = 3
	local function m(pct: number): number
		return math.min(1 + pct / 100, cap)
	end
	local rangePct = pl.RangePct * L + (if a.RedDot then Ma.Attachments.RedDot.RangePct else 0)
	local magPct = pl.MagPct * L + (if a.ExtendedMag then Ma.Attachments.ExtendedMag.MagPct else 0)
	return {
		Damage = (tonumber(def.Damage) or 0) * m(pl.DamagePct * L),
		FireRate = (tonumber(def.FireRate) or 0) * m(pl.RatePct * L),
		Range = (tonumber(def.Range) or 0) * m(rangePct),
		MagazineSize = math.floor((tonumber(def.MagazineSize) or 0) * m(magPct) + 0.5),
		ReloadTime = (tonumber(def.ReloadTime) or 0) * math.max(1 + pl.ReloadPct * L / 100, 1 / cap),
		Spread = (tonumber(def.Spread) or 0) * (if a.Grip then 1 + Ma.Attachments.Grip.SpreadPct / 100 else 1),
	}
end

-- §2.9 the mastery price base for a gun: shop 1M, rebirth 2M, premium (Robux) 3M
function EndgameConfig.MasteryBase(def: any): number
	local T = EndgameConfig.Mastery.TierBase
	if typeof(def) == "table" and def.Premium == true then
		return T.Premium
	elseif typeof(def) == "table" and def.RebirthOnly == true then
		return T.Rebirth
	end
	return T.Shop
end

-- §2.6 the vehicle workshop factors at level L: HP (and armour) +6 %, speed +3 % a level
function EndgameConfig.WorkshopMults(L: number): (number, number)
	local W = EndgameConfig.Workshop
	local l = math.clamp(level(L), 0, W.MaxLevel)
	return 1 + W.HpPct * l / 100, 1 + W.SpeedPct * l / 100
end

-- §2.8 the Combat Medicine max-HP bonus at level L (+10 a level)
function EndgameConfig.MedicineHp(L: number): number
	return math.clamp(level(L), 0, #EndgameConfig.Hospital.Medicine.Costs) * EndgameConfig.Hospital.Medicine.HpPerLevel
end

-- §2.5 the Base Tier a Defence level needs (0 = none)
function EndgameConfig.DefenceNeedTier(L: number): number
	return tonumber((EndgameConfig.Defence.NeedTier :: any)[level(L)]) or 0
end

-- §2.1 the endgame's own rebirth unlocks (granted by EndgameService while the Rebirth part is live; the shared
-- PrestigeConfig track is untouched, so players the job is not live for see exactly today's rebirth screen)
EndgameConfig.RebirthUnlocks = {
	{ At = 25, Flag = "HeavyWarhead", Name = "Heavy Warhead" },
	{ At = 30, Flag = "MythicTraining", Name = "Mythic Training" },
	{ At = 35, Flag = "BastionCrest", Name = "Bastion Crest" },
	{ At = 40, Flag = "LegendParade", Name = "Legend Parade" },
}

-- §2.11 today's 3 contracts for a player: a pure function of (UserId, UTC day) over the pool, no repeats
function EndgameConfig.DailyContracts(userId: number, day: number): { any }
	local Ct = EndgameConfig.Contracts
	local pool = Ct.Pool
	local n = #pool
	local out = {}
	local seed = (math.floor(tonumber(userId) or 0) % 9973) * 31 + math.floor(tonumber(day) or 0) * 7
	local order = {}
	for k = 1, n do
		local x = (seed + k * 7919) % 1000003
		table.insert(order, { K = k, H = (x * x * 31 + x * 17 + k) % 1000003 }) -- a non-linear mix: each day reshuffles
	end
	table.sort(order, function(a, b)
		return a.H < b.H
	end)
	for j = 1, math.min(Ct.Daily, n) do
		table.insert(out, pool[order[j].K])
	end
	return out
end

-- §2.11 this week's High-Value Target (the same for everyone in a week)
function EndgameConfig.WeeklyHvt(week: number): any
	local h = EndgameConfig.Contracts.Hvt
	return h[(math.floor(tonumber(week) or 0) % #h) + 1]
end

-- §2.10 the week number since the first Monday 00:00 UTC (every server agrees)
function EndgameConfig.WeekIndex(unix: number): number
	return math.floor((unix - EndgameConfig.BlackMarket.EpochMondayUnix) / 604800)
end

-- §2.10 this week's stock: 3 Cash item ids and 1 Gold item, a pure function of the week (no randomness state)
function EndgameConfig.BlackMarketStock(week: number): { Cash: { string }, Gold: string, GoldPrice: number }
	local B = EndgameConfig.BlackMarket
	local w = math.floor(tonumber(week) or 0)
	local pool = B.Pool
	local n = #pool
	local out: { string } = {}
	local start = (w * 7) % n
	local stride = 3 -- coprime with the pool size (10), so 3 picks never repeat
	for i = 0, #B.Slots - 1 do
		table.insert(out, pool[((start + i * stride) % n) + 1])
	end
	local gi = (w % #B.GoldPool) + 1
	return { Cash = out, Gold = B.GoldPool[gi], GoldPrice = B.GoldPrices[gi] or B.GoldPrices[1] }
end

-- claude-bud JOB A: the Recruitment Office's walk-away rule (pure): close only past RecruitCloseRange from the point it
-- was opened from (the hysteresis band between the prompt's 10-12 studs and 17)
function EndgameConfig.RecruitShouldClose(distFromAnchor: number?): boolean
	if distFromAnchor == nil or distFromAnchor ~= distFromAnchor then
		return false -- no anchor known (state still loading): never a close
	end
	return distFromAnchor > (tonumber(EndgameConfig.Station.RecruitCloseRange) or 17)
end

return EndgameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">EngagementConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 13 (2026-09-29): bring players back (Server/Services/EngagementService + Client/Modules/EngagementClient).
	v103 shipped owner-only; v104 (Code Bot) sets every Rollout to "all". Every reward is decided and paid on the server.
	  * Events: a weekly rotation from the Events table. Week n (UTC, weeks since Epoch Monday) runs Events[n % #Events];
	    Window "Weekend" = Friday 00:00 to Monday 00:00 UTC, "Week" = the whole week. Effects: CashMult (passive / pay
	    reasons, on top of everything), AirdropIntervalSeconds (the airdrop comes faster), PlazaBountyMult. A HUD banner
	    shows the running event and its countdown (or the next one and when it starts).
	  * Leaderboards: OrderedDataStores (Boards). Scores are written every WriteSeconds per player and on leave, top TopN
	    read every ReadSeconds, published to ReplicatedStorage.WE_Leaderboards (JSON). A board stands at Town Square
	    (client-built, only shown to players it is live for).
	  * Invite: the Shop's "Invite friends" row opens Roblox's invite prompt (SocialService). A new player who joins through
	    an invite (JoinData.ReferredByPlayerId) gets WelcomeCash once; the inviter gets InviteCash per new friend (at most
	    InviteDailyCap a day), right away when in the same server or on his next join (DataStore queue). v104: only for a
	    brand-new account (InviteNewPlayerSeconds) that is a real Roblox friend of the inviter, on a saved profile.
	  * Friends: every FriendsTickSeconds, FriendsCashPerTick per friend in the server (at most FriendsCap friends, at most
	    FriendsDailyCap a day).
	  * Comeback: away ComebackDays or more (since the last join) -> ComebackCash once per absence on the join.
	  v104: the reward reasons (invite_welcome / invite_reward / friends_bonus / comeback) are multiplier-exempt, so the
	  amounts and caps here are exactly what is paid.
]]

local EngagementConfig = {
	-- v104 (Code Bot, owner 2026-09-29: "switch ALL of JOB 13 on for all players"): every feature live for everyone
	Rollout = {
		Events = "all",
		Leaderboards = "all",
		Invite = "all",
		Friends = "all",
		Comeback = "all",
	} :: { [string]: string },

	Events = {
		{ Id = "DoubleCashWeekend", Name = "DOUBLE CASH WEEKEND", Window = "Weekend", CashMult = 2 },
		{ Id = "PlazaWarWeek", Name = "PLAZA WAR WEEK", Window = "Week", PlazaBountyMult = 2 },
		{ Id = "AirdropFrenzy", Name = "AIRDROP FRENZY", Window = "Weekend", AirdropIntervalSeconds = 180 },
	} :: { { Id: string, Name: string, Window: string, CashMult: number?, PlazaBountyMult: number?, AirdropIntervalSeconds: number? } },

	Boards = {
		{ Id = "Richest", Title = "RICHEST", Store = "WE_LB_Cash_v1" },
		{ Id = "Plaza", Title = "PLAZA CAPTURES", Store = "WE_LB_Plaza_v1" },
		{ Id = "Rebirths", Title = "REBIRTHS", Store = "WE_LB_Rebirths_v1" },
	} :: { { Id: string, Title: string, Store: string } },
	WriteSeconds = 300,
	ReadSeconds = 300,
	TopN = 10,
	WriteMinGapSeconds = 60, -- v104: at most one board write per player per minute (leave / rejoin spam cannot flood the budget)
	WriteBudgetFloor = 20, -- v104: skip a write while this server's sorted-store write budget is below this
	BoardX = -112, -- Town Square's north-east corner (the square is 90 x 90 at (-150, 150)), facing the square
	BoardZ = 112,

	WelcomeCash = 2500,
	InviteCash = 10000,
	InviteDailyCap = 5,
	InviteQueueStore = "WE_InviteRewards_v1",
	InviteNewPlayerSeconds = 900, -- v104: the invited account must be brand new here (first join at most 15 min ago)
	-- v104: and the inviter must be a real Roblox friend of the invited account (IsFriendsWithAsync; a failed check pays nothing)

	FriendsTickSeconds = 60,
	FriendsCashPerTick = 500,
	FriendsCap = 3,
	FriendsDailyCap = 30000, -- v104: at most $30,000 a day (UTC) from the friends bonus per player (saved: rejoining never resets it)

	ComebackDays = 3,
	ComebackCash = 25000,
	-- v104: paid once per absence (profile.ComebackPaidFor = the previous join it paid for) and saved right away
}

function EngagementConfig.LiveFor(feature: string, userId: any): boolean
	local mode = EngagementConfig.Rollout[feature]
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
	end
	return false
end

local WEEK = 7 * 86400
local EPOCH_MONDAY = 4 * 86400 -- 1970-01-05 00:00 UTC was a Monday (the Unix epoch was a Thursday)

--[[ The event running at `now` (UTC seconds) and when it ends, or nil plus the next event and when it starts. Pure. ]]
function EngagementConfig.EventAt(now: number): (any?, number, any?)
	local list = EngagementConfig.Events
	if #list == 0 then
		return nil, 0, nil
	end
	local week = math.floor((now - EPOCH_MONDAY) / WEEK)
	local weekStart = EPOCH_MONDAY + week * WEEK
	local ev = list[(week % #list) + 1]
	local startAt = if ev.Window == "Weekend" then weekStart + 4 * 86400 else weekStart
	local endAt = weekStart + WEEK
	if now >= startAt and now < endAt then
		return ev, endAt, nil
	end
	if now < startAt then
		return nil, startAt, ev
	end
	local nxt = list[((week + 1) % #list) + 1]
	local nextStart = if nxt.Window == "Weekend" then endAt + 4 * 86400 else endAt
	return nil, nextStart, nxt
end

return EngagementConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">EventConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot v185: DOUBLE WEEKEND (one central config for the time-gated event). Server-authoritative: the grants read
	os.time() (UTC) on the server through Server/Modules/DoubleEvent; nothing a client sends can switch it on.

	Window: StartUnix 1790971200 = Fri 2 Oct 2026 20:00 UTC (21:00 Dublin IST) .. EndUnix 1791144000 = Sun 4 Oct 2026
	20:00 UTC (21:00 Dublin IST). Inside the window it is LIVE FOR EVERYONE, whatever OwnerFirst says.
	OwnerFirst gates ONLY the preview BEFORE StartUnix: while it is true (or the owner's /eventpreview on), the owner
	(OwnerUserId, shaunie6) has the event active early so he can test it. OwnerFirst = false -> no preview; the event
	still runs for everyone, only inside the window. After EndUnix it is off for everyone (preview included).

	What it multiplies (Server/Modules/DoubleEvent):
	  * CashMult: EconomyService.cashMultFor, the NON-exempt stack only (the same reasons the 2x Cash pass multiplies),
	    minus CashExemptReasons below. AccruePendingCash multiplies at accrue time, so passive income that accrues in the
	    window is doubled (the collector pays what accrued). Offline cash: only the share of the counted offline span that
	    lies inside the window (RetentionService).
	  * XPMult: XPService.AddXP, the reasons the 2x XP pass multiplies (MonetizationConfig.XPMultExemptReasons), minus
	    XPExemptReasons below.
	  * KillMult: the kill rewards (KillReasons: their cash AND xp take KillMult instead of CashMult / XPMult, so a kill
	    pays 2x, not 4x) and the kill COUNT toward missions (KillPlayer / KillNPC) and the MOST KILLS / ARMY KILLS boards.
	  * ExtraCashReasons (Code Bot v197): fixed payouts that are 2x-pass EXEMPT (MonetizationConfig.CashMultExemptReasons)
	    but the event still doubles: EconomyService.cashMultFor's exempt branch applies ONLY CashMult for these (no pass,
	    prestige, tax, ...). Each is doubled once, at its grant: oil pumps at AccruePendingCash (the collect is
	    "collector", never multiplied), jobs, supply drops / airdrops, a bank raid WITHOUT a heist kit (a kit's payout
	    is minutes of WE_IncomePerSec, already doubled, so it is paid as "bank_raid_kit", not listed) and clan war cash.
	    Codes, battle pass, onboarding, invite / friends / comeback, spinner, clicker dropper, Robux, admin and refunds
	    are NOT listed (never doubled).
	Stacking: multiplicative on top of everything already there (2x Cash / 2x XP pass, prestige, empire tax, season,
	code CashBoost, the EngagementConfig weekly event). Robux purchases, refunds, admin grants and sell-backs are exempt.
]]

local EventConfig = {
	Id = "DoubleWeekend1",
	Name = "DOUBLE WEEKEND",
	StartUnix = 1790971200, -- Fri 2 Oct 2026 20:00 UTC = 21:00 Dublin
	EndUnix = 1791144000, -- Sun 4 Oct 2026 20:00 UTC = 21:00 Dublin
	XPMult = 2,
	CashMult = 2,
	KillMult = 2,
	OwnerFirst = true, -- NEW-OWNER-FIRST (Code Bot v185): owner preview BEFORE StartUnix only; never gates the real window
	OwnerUserId = 470626172, -- shaunie6
	BannerLeadSeconds = 24 * 3600, -- everyone sees "starts in ..." from 24 h before the start
	-- Roblox experience event (Creator Hub) for the banner's NOTIFY ME (SocialService RSVP). "" = no button.
	EventId = "5990901055452480269", -- a string: event ids do not fit a Luau number
	BannerText = "DOUBLE WEEKEND · 2x XP · 2x CASH · 2x KILLS",
	-- Code Bot v192 (owner: "the banner stays stuck on screen, ugly and blocking"): the top-centre banner is gone.
	--   BEFORE the start: a ONE-TIME centred pop-up (once per player per Id: profile.EventPopupSeen[Id], a new profile
	--   field; replicated as the PopupSeenAttr player attribute), a few seconds after spawn, never over the tutorial /
	--   onboarding hold / another panel or first-join card; skipped when GetEventRsvpStatusAsync says Going.
	--   DURING the live window (or the owner preview): only a small chip under the TARGETS card ("2x WEEKEND · 1d 4h");
	--   tap = the details card. After EndUnix: nothing.
	PopupTitle = "DOUBLE WEEKEND",
	PopupWhen = "Fri 9pm – Sun 9pm (Irish time)",
	PopupPerks = "2x XP · 2x Cash · 2x Kills",
	PopupAsk = "Get notified when it starts?",
	PopupDelaySeconds = 6, -- after the character spawns (and the screen has been free for PopupQuietSeconds)
	PopupQuietSeconds = 2,
	PopupSeenAttr = "WE_EventPopupSeen", -- player attribute (server-written on profile load): true = already shown
	PopupTestAttr = "WE_EventPopupTest", -- player attribute: the owner's /eventpopup bumps it -> show the pop-up now
	ChipText = "2x WEEKEND",
	ToastTag = "2x", -- Code Bot v198: reward toasts the event doubled end " · 2x" (Server/Modules/RewardToast; display only)

	KillReasons = {
		pvp_kill = true,
		npc_kill = true,
		npc_kill_squad = true,
		guard_kill = true,
		guard_unit_kill = true,
		army_unit_kill = true,
		vehicle_kill = true,
		nuke_kill = true,
	} :: { [string]: boolean },
	-- on top of EconomyService NEVER_MULTIPLIED + MonetizationConfig.CashMultExemptReasons (devproduct, purchase_refund,
	-- admin, code, collector, offline, ...): perk / fixed / test payouts the 2x pass happens to multiply
	CashExemptReasons = {
		devproduct = true,
		purchase_refund = true,
		admin = true,
		dismiss_soldiers = true,
		premium_daily = true,
		group_reward = true,
		vip_lounge = true,
		vip_supply = true,
		studio_smoke_buy = true,
		studio_smoke_buy_barracks = true,
	} :: { [string]: boolean },
	-- Code Bot v197: 2x-pass-exempt cash reasons the event doubles anyway (see the header); the pass still skips them
	ExtraCashReasons = {
		plot_oil = true, -- oil pumps (PendingCash, at accrue)
		ops = true, -- jobs (OpsConfig.Rewards.CashReason)
		supply_drop = true, -- supply drops + airdrops
		bank_raid = true, -- bank raid without a heist kit (a kit pays "bank_raid_kit": income-scaled, not listed)
		clan_war_win = true,
		clan_war_participate = true,
	} :: { [string]: boolean },
	XPExemptReasons = {
		admin = true,
		build_backfill = true,
	} :: { [string]: boolean },
	KillObjectives = { KillPlayer = true, KillNPC = true } :: { [string]: boolean },
}

-- the real window (everyone)
function EventConfig.InWindow(now: number): boolean
	return now >= EventConfig.StartUnix and now < EventConfig.EndUnix
end

-- is the event active for userId at `now` (UTC seconds); previewOn = the server's owner preview switch
function EventConfig.ActiveFor(userId: any, now: number, previewOn: boolean): boolean
	if EventConfig.InWindow(now) then
		return true
	end
	if now < EventConfig.StartUnix and previewOn == true and tonumber(userId) == EventConfig.OwnerUserId then
		return true
	end
	return false
end

-- banner state: "live" (active for him: show "ends in"), "soon" (within BannerLeadSeconds of the start: "starts in"),
-- or nil (hidden; after EndUnix always nil)
function EventConfig.BannerState(userId: any, now: number, previewOn: boolean): string?
	if now >= EventConfig.EndUnix then
		return nil
	end
	if EventConfig.ActiveFor(userId, now, previewOn) then
		return "live"
	end
	if now < EventConfig.StartUnix and EventConfig.StartUnix - now <= EventConfig.BannerLeadSeconds then
		return "soon"
	end
	return nil
end

-- "1d 4h" / "3h 12m" / "4m 09s"
function EventConfig.FormatLeft(sec: number): string
	sec = math.max(0, math.floor(sec))
	local d = sec // 86400
	local h = (sec % 86400) // 3600
	local m = (sec % 3600) // 60
	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%dm %02ds", m, sec % 60)
end

-- seconds of [a, b) inside the window (offline pay)
function EventConfig.OverlapSeconds(a: number, b: number): number
	local lo = math.max(a, EventConfig.StartUnix)
	local hi = math.min(b, EventConfig.EndUnix)
	return math.max(0, hi - lo)
end

EventConfig.PreviewAttr = "WE_EventPreview" -- ReplicatedStorage attribute, written by the server only

return EventConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ WAR EMPIRE — Core game settings ]]

local GameConfig = {
	DisplayName = "WAR EMPIRE",
	Tagline = "BUILD. CONQUER. DOMINATE.",
	-- One base per player: must equal the place's Max Players setting (place settings, not code) and
	-- BaseConfig.MaxPlots. A player past the plot count joins with no base. BaseService warns in the server log at boot
	-- when the place allows more players than there are plots.
	MaxPlayersPerServer = 10,
	BasePlotCount = 10,
	RespawnTimeSeconds = 5,
	FriendlyFire = false,
	PvPEnabled = true,
	TutorialEnabled = true,
	DefaultWalkSpeed = 16,
	DefaultJumpPower = 50,
	SpawnInvulnerabilitySeconds = 3,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">GameFeelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 14 (2026-09-29): game-feel polish from the phone tests (Server/Services/GameFeelService +
	Client/Modules/GameFeelClient). Live for all players (the owner's v101 rule); a feature set to "off" = the old behaviour, exactly.
	  * KillFeed: PvP kills and vehicle kills by a player, 2 short lines in the HUD top stack under the toasts (never a
	    fixed corner: the stack cannot overlap anything), 4 s each. DisplayNames only (never a nation). Blast deaths
	    stay quiet (nuke §15.2). The server drops lines over MaxPerSecond (never queued).
	  * VehicleNumbers: every hit on a vehicle shows a number at the hit (attacker: a gun / missile hit without a hit
	    point now uses the vehicle's position; splash that damages vehicles gets a hit marker too); the driver / owner
	    of the damaged vehicle sees a red number over it and a metal hit sound (merged per AggregateSeconds).
	  * RaidReport: an attack on your base (gate / guard hits, a breach, an ATM hold) opens a raid; QuietSeconds after
	    the last event you get ONE clear banner: "YOU WERE RAIDED -$N" (the ATM was robbed) or "BASE DEFENDED".
	  * SoundPass: every sound's volume kept inside its bus band (SoundConfig.Mix.Bands), and the actions that were
	    silent now make a sound (Sounds below; existing sound ids only, no new assets).
]]

local GameFeelConfig = {
	Rollout = {
		KillFeed = "all", -- v103 rule (owner): everything live for all players
		VehicleNumbers = "all",
		RaidReport = "all",
		SoundPass = "all",
	} :: { [string]: string },

	KillFeed = {
		Lines = 2, -- at most this many lines at once (one short message area, never a list)
		Seconds = 4,
		MaxPerSecond = 4, -- server-wide; extra kill lines in the same second are dropped
		TextSize = 20, -- code px (14 real px under the phone HUD scale)
		Order = 47, -- HudConfig.TopStack.Order: after Toasts (40) and the event banner (45), before Offer (50)
		Width = 330,
	},

	VehicleNumbers = {
		AggregateSeconds = 0.25, -- the victim's numbers per vehicle are merged over this (≤ 4 pushes / s)
		Max = 4, -- live numbers on the client
		Seconds = 0.9,
		TextSize = 20,
	},

	RaidReport = {
		QuietSeconds = 20, -- no new hit / hold for this long = the raid is over
		BannerSeconds = 5,
		Order = 12, -- just under the Alert (10): the report is the one message on screen
	},

	Sounds = {
		KillFeedMine = "Hit.Kill", -- a feed line where you are the killer (the kill cue already plays: silent here)
		KillFeedVictim = "Toast.Error", -- a feed line where you died
		RaidLost = "Capture.Lost",
		RaidDefended = "Capture.Secured",
		VehicleHurt = "Impact.Metal",
		PremiumGun = "Weapon.AssaultRifle.Fire",
		PremiumMissile = "Weapon.RocketLauncher.Fire",
		Marker = "Capture.Start", -- the airdrop / bounty marker appears
		Tap = "UI.Click", -- the AIRSTRIKE button
		EventStart = "Toast.Reward", -- the weekly event banner appears
	},
}

function GameFeelConfig.LiveFor(feature: string, userId: any): boolean
	local mode = GameFeelConfig.Rollout[feature]
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
	end
	return false
end

return GameFeelConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">GateDefenseConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Gate door defense — Design Bot GATE_DEFENSE_WIRE.
	Tied to DefensiveWalls level. Recreated on join from walls level (no exotic persist).

	Design silhouette:
	  Walls L1–L3 = Design L0 (2 Guards patrol ±6)
	  Walls L4–L5 = Design L1 (Machine Gun Nest AutoGuns + keep Guards manned nest)
	  Design L2 elevated tower IDs are NOT used on door flanks.
]]

export type LevelStats = {
	GuardHealth: number,
	GuardDamage: number,
	GuardFireRate: number,
	GuardWalkSpeed: number,
	AggroRange: number,
	ShootRange: number,
	UseTurrets: boolean,
	TurretDamage: number,
	TurretFireRate: number,
	TurretRange: number,
	WeaponLabel: string,
	DesignTier: string, -- "L0" | "L1"
}

local GateDefenseConfig = {
	Enabled = true,
	MinWallsLevel = 1,
	GuardsPerGate = 2,
	VisualKind = "GateGuard", -- Characters.GateGuard / Guard → 16134469614

	-- Design Bot placement (gate local space)
	GuardFlankX = 6,
	GuardForwardZ = 2,
	PatrolHalfSpanStuds = 6, -- ±6 along gate line
	AutoGunFlankX = 7,
	AutoGunForwardZ = 1,
	AutoGunYawDeg = 15, -- idle toe-in toward the approach centre line (inside and outside posts)

	-- Owner phone feedback 2026-09-27 ("The turrets should be outside the gate"): each AutoGun nest (gun, painted
	-- marker ring, sandbags) stands OUTSIDE the main gate, one each side of the approach, its back to the wall, facing
	-- out (toed in by AutoGunYawDeg). Gate-local: nest centre AutoGunOutsideFlankX from the gate centre along the wall
	-- (the opening is 10 wide, ±5; a 30° approach of the widest car body passes between the nests) and
	-- AutoGunOutsideWallGap studs out from the wall's OUTER face (the wall is 3.5-6.3 thick by level: read from the
	-- built wall, never assumed). The guards stay INSIDE (RaidConfig.Defense.GuardPostInsideStuds): they are the only
	-- defense that chases an intruder to the ATM, and a closed gate would lock them out. false = the v69 posts
	-- AutoGunInsideStuds inside the gate (rollback).
	AutoGunOutside = true,
	AutoGunOutsideFlankX = 16,
	AutoGunOutsideWallGap = 4.5, -- the sandbags behind a gun stay clear of the wall even at their full 2.2-stud length
	-- Fix 2 (review): an OUTSIDE gun engages and hits out to min(Levels[n].TurretRange, AutoGunOutsideMaxRange) from
	-- the gun. Posts stand about 7.7 studs out and 16 to the side, so at 100 the guns reach about 106 studs out on the
	-- approach centre line. A player's gun damages the gate only from within GateHitMaxDistance of the barrier part's
	-- centre (GateDefenseService.ApplyDamage; the Starter Rifle ray itself reaches 124 = Range 120 + HitPositionSlopStuds
	-- 4, so 120 is the real limit). A raider with the default loadout therefore keeps a band about 106-120 studs out
	-- (about 13.5 studs on the centre line, wider off the axis) to siege the gate without being shot, at L4 and L5
	-- alike. Uncapped, L5 (115) left almost nothing. Keep it <= GateHitMaxDistance - 20. Inside posts (rollback) keep
	-- TurretRange. The hit chance falls to TurretHitChanceFar at this reach.
	AutoGunOutsideMaxRange = 100,
	-- A player's (non-aircraft) hit on the gate barrier counts only when their root is within this many studs of the
	-- barrier part's centre (was a literal 120 in ApplyDamage). Aircraft weapons may extend it (AircraftWeaponConfig.HitReach).
	GateHitMaxDistance = 120,
	-- Target pick: the first enemy the gun can SEE, at most this many line-of-sight rays per gun per think (5 Hz);
	-- nobody in sight = no turn, no shot. Order: enemies on the gun's side of the wall first (outside posts: outside
	-- the plot), each side in priority order (raider at the ATM, anyone near the ATM, the nearest). All rays but the
	-- last go to the top of that list; the last ray probes the rest in turn and stays on an enemy it can see, so
	-- enemies the gun cannot see never use up every ray (a clan crowding the ATM or hiding behind cover).
	TurretLosChecksPerThink = 3,
	-- Every AutoGun shot, hit or miss, sends one tracer + shot sound through the W2 WeaponFx path (CombatFx.Bullet:
	-- UnreliableRemoteEvent, per-shooter and per-recipient token buckets). A gun fires at most once per think (5 Hz),
	-- so two guns add <= 10 events/s to a player near the gate. A miss lands MissOffsetMin..Max studs beside the
	-- target so it reads on a phone. false = silent guns (v69).
	TurretShotFx = true,
	TurretShotFxMuzzleStuds = 2.5, -- tracer starts this far along the aim from the gun's aim part (about the barrel tip)
	TurretShotFxMissOffsetMin = 2,
	TurretShotFxMissOffsetMax = 4,
	-- CLAUDE.md combat fairness: an AutoGun shot needs line of sight AND rolls a hit chance (every shot used to hit):
	-- TurretHitChanceNear at or inside TurretHitNearStuds, falling linearly to TurretHitChanceFar at the gun's reach
	-- (the level's TurretRange, capped by AutoGunOutsideMaxRange for outside posts; the CombatFairnessConfig NPC curve,
	-- 0.75 → 0.30). A miss still spends the shot.
	TurretHitNearStuds = 20,
	TurretHitChanceNear = 0.75,
	TurretHitChanceFar = 0.30,

	-- Catalog ScaleTo longest-axis targets (studs)
	AutoGunLongAxisStuds = 5.5, -- 4–6
	SandbagNestDiameterStuds = 8,

	-- Walls level when AutoGuns appear (Design L1)
	AutoGunMinWallsLevel = 4,

	-- Combat — cover gate → MoneyCollector ATM approach (plot ~200 pad)
	DefaultAggroRange = 95,
	ProtectCollectorRadius = 42,
	RequireLineOfSight = true,
	-- A line-of-sight ray is this long at most; a target farther away is NOT in sight (ownerfb/gate fix 1: the ray used
	-- to be cut here and read as clear, so at L5 a target 110-115 studs out behind cover was shot through it). Keep it
	-- >= every Levels[n].TurretRange, AggroRange and ShootRange.
	LosMaxDistance = 125,
	DamageCooldownGlobal = 0.08,
	-- Guards and AutoGuns ignore a player whose save has not loaded yet, and for this many seconds after each
	-- character spawn and after the save loads. Every PlayerSpawn pad sits at somebody's gate: a new player used
	-- to be shot there before BaseService could move them to their own plot. Respawns are moved home at once.
	-- The grace ends early for a player holding an ATM raid or hitting the gate / a guard.
	SpawnGraceSeconds = 4,
	GuardRespawnSeconds = 12,
	PatrolIdleSeconds = 1.4,

	Levels = {
		[1] = {
			GuardHealth = 140,
			GuardDamage = 14,
			GuardFireRate = 1.4,
			GuardWalkSpeed = 11,
			AggroRange = 95,
			ShootRange = 70,
			UseTurrets = false,
			TurretDamage = 0,
			TurretFireRate = 0,
			TurretRange = 0,
			WeaponLabel = "Rifle",
			DesignTier = "L0",
		},
		[2] = {
			GuardHealth = 190,
			GuardDamage = 18,
			GuardFireRate = 2.0,
			GuardWalkSpeed = 12,
			AggroRange = 100,
			ShootRange = 75,
			UseTurrets = false,
			TurretDamage = 0,
			TurretFireRate = 0,
			TurretRange = 0,
			WeaponLabel = "Rifle+",
			DesignTier = "L0",
		},
		[3] = {
			GuardHealth = 230,
			GuardDamage = 16,
			GuardFireRate = 4.0,
			GuardWalkSpeed = 13,
			AggroRange = 105,
			ShootRange = 68,
			UseTurrets = false,
			TurretDamage = 0,
			TurretFireRate = 0,
			TurretRange = 0,
			WeaponLabel = "SMG",
			DesignTier = "L0",
		},
		[4] = {
			GuardHealth = 260,
			GuardDamage = 18,
			GuardFireRate = 4.5,
			GuardWalkSpeed = 13,
			AggroRange = 110,
			ShootRange = 72,
			UseTurrets = true,
			TurretDamage = 22,
			TurretFireRate = 6.0,
			TurretRange = 100,
			WeaponLabel = "SMG+HMG",
			DesignTier = "L1",
		},
		[5] = {
			GuardHealth = 300,
			GuardDamage = 20,
			GuardFireRate = 5.0,
			GuardWalkSpeed = 14,
			AggroRange = 120,
			ShootRange = 78,
			UseTurrets = true,
			TurretDamage = 28,
			TurretFireRate = 8.0,
			TurretRange = 115,
			WeaponLabel = "AutoGuns",
			DesignTier = "L1",
		},
	} :: { [number]: LevelStats },

	-- Siegeable gate barrier (HP). Spawned by GateDefenseService — does not edit StructureKitBuilder ScaleTo.
	GateMaxHealthByWallsLevel = {
		[1] = 800,
		[2] = 1200,
		[3] = 1800,
		[4] = 2600,
		[5] = 3600,
	},
	GateRegenPerSecond = 1.5, -- slow regen while intact / after rebuild
	GateRebuildSeconds = 50,
	GateRepairCashCost = 750, -- owner Collect repair while breached
	GateBreachToast = "⚠ BREACHED — gate open! Repair or wait rebuild",
	GateRepairedToast = "Gate repaired",
	-- v71 (HUD v70 spec §4.2): one owner Warn when the base is fought over — the defenses hit an enemy, or an enemy
	-- hits the gate / a guard — at most once per BaseUnderAttackCooldown per plot. The client shows it in the Alert
	-- slot (HudConfig.Toast.Reroute "^BASE UNDER ATTACK"). Was a per-hit "DEF HIT · name (−HP)" toast every 1.2 s.
	BaseUnderAttackToast = "BASE UNDER ATTACK!",
	BaseUnderAttackCooldown = 60,
	-- gate HP bar (one stud-scaled bar centred over the gate; shown only while damaged, breached, down or raided)
	GateBar = { Studs = Vector2.new(6, 1.1), MaxDistance = 40, HeightAbove = 1.2 },
	GateBarrierThickness = 1.6,
	GateBarrierHeight = 9,
	GateClearStuds = 10, -- match StructureKitBuilder GATE_CLEAR
	GateDamageTag = "WE_GateBarrier",
	GateDamageToolAttribute = "WE_Weapon", -- tool/tag validation
	AllowTroopGateDamage = true,

}

function GateDefenseConfig.GetLevelStats(wallsLevel: number): LevelStats?
	local lv = math.clamp(math.floor(wallsLevel), 0, 5)
	if lv < (GateDefenseConfig.MinWallsLevel or 1) then
		return nil
	end
	return GateDefenseConfig.Levels[lv] or GateDefenseConfig.Levels[5]
end

return GateDefenseConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">GuardConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 20 (2026-09-29, owner: "base guards are just props; make them real defenders"): every guard number
	in one place (Server/Modules/BaseGuards, hooked into GateDefenseService's 5 Hz think loop). Live for all.
	  * Base guards: stand at their posts (idle); when a hostile player or an enemy army unit is INSIDE the plot, they
	    turn, walk / path toward it (never more than LeashStuds from the post, never out of the plot) and shoot with
	    line of sight and a hit chance; back to the post ReturnAfterSeconds after the last intruder. Never the owner,
	    his clan, his friends or anyone's army that belongs to them. HP / count grow with the Defenses research
	    (GuardArmor = HP, GuardRoster = +1 / +2 guards at ExtraPosts); die, respawn at the post after RespawnSeconds.
	  * Tower guards: one buyable slot per base corner tower (in-game Cash, Tower.BaseCost x (1 + PerRebirth x
	    rebirths)); stands on the platform, shoots hostiles OUTSIDE the walls within Tower.Range, slower and harder;
	    a gold helmet badge.
	  * Rewards: a guard / tower guard kill of a player = the owner's player kill (the server's creator tag: cash, XP,
	    MOST KILLS, the kill feed "<owner>'s Tower Guard"), at most PairMax per victim per PairWindowSeconds, never in
	    a private server. Killing an enemy guard / army unit = the smaller GuardKill / UnitKill reward (not on MOST
	    KILLS), same pair limit.
	  * Balance: damage per target per second is capped (lower for low-level / new players), at most
	    MaxShootersPerBase guards / tower guards / auto-guns fire per base at once.
]]

local GuardConfig = {
	Enabled = true,


	RespawnSeconds = 45,
	LeashStuds = 60,
	ReturnAfterSeconds = 8,
	HitChanceNear = 0.8,
	HitChanceFar = 0.45,
	HitNearStuds = 20,
	PathEverySeconds = 2, -- a guard that cannot see its target asks for a path at most this often
	PathBudgetPerSecond = 6, -- server-wide
	MaxShootersPerBase = 6,
	UnitTargets = true, -- enemy army units are targets too
	UnitTag = "WE_SquadUnit",
	--[[ claude-bud JOB 40 part A (2026-09-30): REAL BASE GUARDS at every guard post inside a live plot (the rear-gate
		and sea-gate statues become armed, animated, killable guards; Modules/BaseGuards state machine IDLE / ALERT /
		ATTACK / RETURN / DEAD) and THE ONE hostility rule for every base defence (CombatService.UnitMayHitPlayer /
		ArmyHostility; hits through CombatService). Owner-first by the BASE OWNER: a plot whose owner is not live keeps
		today's statues, gate guards and turrets exactly (their old checks included). ]]
	Posts = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone (real base guards at every base)
		StatuePatterns = { "^GateGuard_%a+[LR]$", "^GateGuard_Sea%d*$" }, -- MapSetup's rear-gate / sea-gate statues
		ModelPrefix = "BaseGuard_",
		AlertStuds = 80, -- a hostile outside the plot this close to the post (with line of sight) is noticed
		ReactionSeconds = 0.5, -- ALERT -> ATTACK
		AlertForgetSeconds = 3, -- ALERT with the target lost this long -> RETURN
		TurnDegPerSec = 360,
		FireRate = 1.2,
		Damage = 10,
		Range = 90,
		LeashStuds = 45,
		Health = 150, -- the statue's value
		RegenAfterSeconds = 5, -- HP back to full once at the post and out of combat this long
		RespawnSeconds = 45,
		RespawnRetrySeconds = 2, -- a player standing on the post delays the respawn
		RespawnClearStuds = 4,
		ProtectCollectorRadius = 40, -- tier 2 of the target pick (near the ATM)
	},


	-- Defenses research (ResearchConfig): HP multiplier and extra guards
	HealthStat = "GuardHP",
	CountStat = "GuardCount",
	MaxExtraGuards = 2,
	-- plot-local posts of the extra guards (beside the courtyard, off the gate road)
	ExtraPosts = { { X = -24, Z = 112 }, { X = 24, Z = 112 } },

	Tower = {
		Enabled = true,
		Range = 150,
		FireRate = 0.5, -- shots per second (slower than a gate guard)
		Damage = 34, -- higher than a gate guard
		HitChance = 0.6,
		Health = 260,
		BaseCost = 25000,
		PerRebirth = 0.5, -- + 50 % of BaseCost per rebirth
		MaxCost = 2000000,
		Folder = "WE_CornerTowers", -- StructureKitBuilder.SyncCornerTowers
		PlatformPrefix = "TowerPlatform",
		Slots = 4,
		PromptDistance = 12,
		BadgeColor = Color3.fromRGB(240, 190, 50),
	},

	Rewards = {
		GuardKillCash = 1500, -- a player kills an enemy base guard / tower guard
		GuardKillXP = 40,
		UnitKillCash = 600, -- your guard kills an enemy army unit
		UnitKillXP = 15,
		PairMax = 3, -- per killer -> victim pair ...
		PairWindowSeconds = 600, -- ... per 10 minutes
		NoCreditInPrivateServers = true,
	},

	DpsCap = {
		PerTarget = 30, -- damage per target per second from one base's defenders
		LowTarget = 12, -- a player below LowLevel or in his first NewPlayerSeconds
		LowLevel = 5,
		NewPlayerSeconds = 600,
	},
}

-- pure: the hire price of a tower guard for a player with `rebirths` rebirths
-- claude-bud JOB 40: the post guards + the one rule are live for this BASE OWNER
function GuardConfig.PostsLiveFor(ownerUserId: any): boolean
	return (require(script.Parent.RetentionConfig) :: any).Live((GuardConfig :: any).Posts, ownerUserId)
end

--[[ claude-bud JOB 40: the post guard state machine's decision (pure; tests call it). s = the current state,
	c = { Target: boolean (a hostile picked this tick), Since: seconds in this state, LostFor: seconds since the target
	was last seen, FromPost: studs from the post, AtPost: boolean, Dead: boolean }. Returns the next state. ]]
function GuardConfig.PostNext(s: string, c: { [string]: any }): string
	local P: any = (GuardConfig :: any).Posts
	if c.Dead then
		return "DEAD"
	end
	if s == "DEAD" then
		return "IDLE" -- a respawned guard starts idle at its post
	end
	if (tonumber(c.FromPost) or 0) > P.LeashStuds then
		return "RETURN"
	end
	if s == "IDLE" then
		return if c.Target then "ALERT" else "IDLE"
	elseif s == "ALERT" then
		if not c.Target and (tonumber(c.LostFor) or 0) >= P.AlertForgetSeconds then
			return "RETURN"
		end
		return if c.Target and (tonumber(c.Since) or 0) >= P.ReactionSeconds then "ATTACK" else "ALERT"
	elseif s == "ATTACK" then
		if not c.Target and (tonumber(c.LostFor) or 0) >= (GuardConfig :: any).ReturnAfterSeconds then
			return "RETURN"
		end
		return "ATTACK"
	elseif s == "RETURN" then
		if c.Target and (tonumber(c.FromPost) or 0) < P.LeashStuds - 5 then
			return "ALERT"
		end
		return if c.AtPost then "IDLE" else "RETURN"
	end
	return "IDLE"
end

function GuardConfig.TowerCost(rebirths: number): number
	local T = GuardConfig.Tower
	local r = math.max(0, math.floor(tonumber(rebirths) or 0))
	return math.min(T.MaxCost, math.floor(T.BaseCost * (1 + T.PerRebirth * r)))
end

-- pure: one killer -> victim pair may be rewarded (at most PairMax per PairWindowSeconds; the log is pruned here)
function GuardConfig.AllowPair(log: { [string]: { number } }, a: number, b: number, now: number): boolean
	if a == b then
		return false
	end
	local R = GuardConfig.Rewards
	local key = tostring(a) .. ">" .. tostring(b)
	local kept: { number } = {}
	for _, t in ipairs(log[key] or {}) do
		if now - t < R.PairWindowSeconds then
			table.insert(kept, t)
		end
	end
	if #kept >= R.PairMax then
		log[key] = kept
		return false
	end
	table.insert(kept, now)
	log[key] = kept
	return true
end

-- pure: how much of `amount` may land on a target that already took `taken` this second
function GuardConfig.CapDamage(taken: number, amount: number, low: boolean): number
	local cap = if low then GuardConfig.DpsCap.LowTarget else GuardConfig.DpsCap.PerTarget
	return math.max(0, math.min(amount, cap - taken))
end

return GuardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">HangarDockConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ claude-bud JOB 58: the hangar + dock showpieces. The hangar's Part jet mock-ups (Installations/Airfield: 12 parts
	each) and the dock's Part patrol boat (DockKitConfig L1: 29 parts) give way to REAL approved store bodies
	(VisualAssetService.CloneDisplayBody: the same templates and BodyAllowed rule as driven vehicles; no new asset
	ids, no franchise models). A body that cannot load or is not allowed leaves the Part build exactly as it is.
	Owner-first by the plot owner. ]]

local HangarDockConfig = {
	Enabled = true,
	OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 58): Code Bot flips it after Shaun's phone test
	Hangar = {
		Anchor = "JetFuselage", -- one per parked jet slot (L1-3: 1, L4+: 2)
		Bodies = { "FighterJet", "ReconPlane" }, -- slot 1, slot 2 (live refs: every player sees them)
		FitLength = 16, -- studs, nose to tail: the Part jet is 15 + its nose
		FloorDrop = 2.4, -- the Part jet's centre is this far over the hangar floor
		Hide = { "JetFuselage", "JetNose", "JetCanopy", "JetWing", "JetTailplane", "JetFin", "JetExhaust", "JetGear", "JetRoundel" },
		HideRadius = 10, -- only Part-jet pieces this close to a placed body go
	},
	Dock = {
		Anchor = "BoatHull",
		Bodies = { "LandingCraft", "PatrolBoat" }, -- the first one with an allowed body (owner-only bodies today)
		FitLength = 20,
		Sink = 0.6, -- the keel this far under the boot-top's bottom (sits in the water)
		Hide = { "BoatBoot", "BoatHull", "BoatForecastle", "BoatBow", "BoatStem", "BoatStrake", "BoatDeck", "BoatBulwark", "BoatWheelhouse",
			"BoatBridgeGlass", "BoatWheelhouseRoof", "BoatMast", "BoatRadarBar", "BoatMastLight", "BoatBowRail", "BoatGunMount",
			"BoatGunBarrel", "BoatExhaust", "BoatLifeRing", "BoatFender" },
		HideRadius = 16,
	},
	ResyncDelay = 1.5, -- after a level change, the Part build is rebuilt first
}

return HangarDockConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">HudConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HudConfig — v70 "clean screen" HUD (competitor-style left rail, bottom-left cash pill, top-centre text
	toasts, bottom-centre weapon hotbar). Config-first: every HUD element reads its placement, size, colour and
	visibility rule from this file. Nothing in a controller may hard-code a HUD offset again.
	Spec: the v70 "clean screen" design hand-off (spec + mock_*.png). Runtime API: Client/Modules/HudLayout.luau
	(scale, insets, flags, top stack, panel registry, badges, cash float, reserved rects) and HudIcons.luau.

	OWNER DECISIONS (v70): Settings = TopStrip gear (not a rail tile); no Base tile on the rail; you spawn
	HOLSTERED (Hotbar.DrawnOnSpawn = false, auto-draw on damage); Army popover key Y; Robux offer pop-ups at most
	Offer.MaxPerSession per session and Offer.MinGapSeconds apart.
	MOBILE MERGE GATE (mobile_plan §1C): text floor 14 real px (Scale.MinTextPx; 20 v on phones), Skip / offer ✕
	hits 64 v, the cash "+" lives on the TopStrip (TopStrip.CashPlus), not in the thumbstick zone, and key hints
	show only when HudLayout.PrefersKeys() (UserInputService.PreferredInput is keyboard or gamepad).

	UNITS
	  v     virtual px. Every HUD ScreenGui gets ONE UIScale named "MobileScale" from HudLayout.ApplyScreen():
	        S = clamp(min(viewport.X, viewport.Y) / Scale.BasePx, Scale.Min, Scale.Max)
	          844x390 phone → 0.70   956x440 phone → 0.70   1280x720 → 0.90   1920x1080 → 1.15
	        and ScreenInsets = CoreUISafeInsets (below the Roblox topbar, inside the landscape notch).
	        So 1 v = S real px everywhere, and offsets from different ScreenGuis finally line up.
	  real  device px. Only the TopStrip (it lives in the Roblox topbar row, whose buttons are a fixed 44 px) and
	        BillboardGui world labels (BillboardGui offsets are never UIScaled) use real px.

	ANCHORS
	  "Left/Right/Top/Bottom" = distance in v from that edge of the safe content rect. The content rect on an
	  844x390 phone is x 47..797, y 58..390 (real); on 1280x720 it is x 0..1280, y 58..720.

	NOTHING IN HERE TOUCHES A PURCHASE PATH. Buy buttons keep btn.Activated → the same remotes.
]]

local HudConfig = {}

-- Toast.Reroute entry (see HudConfig.Toast.Reroute)
export type RerouteRule = {
	Match: string,
	Float: boolean?,
	Show: string?,
	Strip: string?,
	Type: string?,
	MinGapSeconds: number?,
	AlertSeconds: number?,
}

HudConfig.Version = 70

---------------------------------------------------------------------------------------------------------------
-- Scale, fonts, palette, z-order
---------------------------------------------------------------------------------------------------------------

HudConfig.Scale = {
	BasePx = 800,
	Min = 0.70, -- 64 v tile → 44.8 real px on every phone (Apple/Roblox 44 px touch minimum)
	Max = 1.15,
	TouchMinPx = 44, -- real px; HudLayout.AssertTouchTarget() warns in Studio when a tappable is smaller
	-- real px floor for any HUD text (CLAUDE.md §1, check_hud's rule): at S 0.70 that is 20 v, so no v text size
	-- below 20 on touch (PanelShell.Text floors panel text to it). Was 11 until the mobile merge gate (§1C #2).
	MinTextPx = 14,
	-- The ONE documented exception (mobile_plan §1C #2): a hotbar weapon caption whose short name cannot fit its
	-- 64 v slot at 20 v may shrink to this (TextScaled). check_hud.py applies the same rule to Hotbar …WeaponName.
	CaptionMinTextPx = 12,
}

-- Roblox built-in fonts only.
HudConfig.Fonts = {
	Display = Enum.Font.FredokaOne, -- rail labels, cash number, toasts, level, ammo count, console labels
	Body = Enum.Font.GothamBold, -- small captions, prompt text, slot names
	BodyMedium = Enum.Font.GothamMedium,
}

HudConfig.Colors = {
	Ink = Color3.fromRGB(10, 12, 14), -- every outlined text uses this stroke
	White = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 196, 204),
	PillBg = Color3.fromRGB(22, 24, 28), -- cash pill, hotbar slots, prompt pills, top-strip chips
	PillBgTransparency = 0.2,
	PillStroke = Color3.fromRGB(0, 0, 0),
	PillStrokeTransparency = 0.45,
	Positive = Color3.fromRGB(110, 255, 90), -- success toast, cash gain float, affordable price
	Negative = Color3.fromRGB(255, 72, 72), -- error toast, spend float, unaffordable price
	Warn = Color3.fromRGB(255, 120, 104), -- "need more cash" red-pink (competitor "You need more Money!")
	Gold = Color3.fromRGB(255, 214, 72), -- reward / level-up toast, offer stroke
	Info = Color3.fromRGB(255, 255, 255),
	XP = Color3.fromRGB(90, 170, 255),
	PlusGreen = Color3.fromRGB(46, 204, 64),
	PlusGreenStroke = Color3.fromRGB(12, 70, 22),
	Badge = Color3.fromRGB(235, 40, 52),
	Locked = Color3.fromRGB(170, 176, 184),
}

-- One z-order for the whole client. Names are the existing ScreenGui names (BuyPathVerify looks them up).
HudConfig.DisplayOrder = {
	WE_Reticle = 24, -- NEW gui: crosshair at the true viewport centre (IgnoreGuiInset = true)
	WarEmpireCompass = 20, -- kept only as a shell; the compass chip moves to WE_TopStrip
	WarEmpireCombatHUD = 25, -- hotbar, health bar, ammo, touch FIRE/R
	WarEmpireTerritory = 28, -- capture bar (top-centre stack)
	WarEmpireBankRaid = 32, -- bank + ATM raid hold bars (top-centre stack)
	WarEmpireTutorial = 50, -- objective chip (top-centre stack)
	WarEmpireOrders = 52, -- Army popover (orders)
	WarEmpireHUD = 55, -- rail + cash pill (BuyPathStatic pins "DisplayOrder = 55")
	WE_TopStrip = 56, -- NEW gui: level chip, settings gear, shield chip, compass (Roblox topbar row)
	WarEmpireVehicleHUD = 56, -- VehicleDriveClient (v70): SPD pill + hint + ▲▼ column (inside Reserve.CombatTouch)
	WE_PromptLane = 57, -- NEW gui: custom ProximityPrompt pills (action lane)
	WarEmpireBaseUI = 58,
	Panels = 60, -- Shop / Army / Missions / Settings / Garage / Progression / Research / Missiles
	WE_PadBuyGui = 65, -- console BUY button (action lane); hidden while any panel is open
	WE_MissileAlert = 66, -- INCOMING MISSILE (top-centre stack, slot "Alert")
	WarEmpireNotifications = 70, -- toast lane + offer toast
}

HudConfig.Edge = 12 -- v; default gap from the safe content rect's edges

---------------------------------------------------------------------------------------------------------------
-- TOP STRIP — the Roblox topbar row (ScreenGui "WE_TopStrip", ScreenInsets = TopbarSafeInsets, NO UIScale).
-- Left group sits right after Roblox's buttons (GuiService.TopbarInset.Min.X); compass is right-aligned.
---------------------------------------------------------------------------------------------------------------

HudConfig.TopStrip = {
	Height = 44, -- real px — same as Roblox's topbar buttons
	YNudge = 0, -- real px; if a device shows our chips off-centre against Roblox's pills, nudge here
	Gap = 8, -- real px between chips
	EdgePad = 12, -- real px after Roblox's buttons / before the right edge
	-- Roblox's own 44 px topbar buttons sit at y 12..56 of the 58 px row (owner screenshot), i.e. 2 px above the
	-- row's bottom: our chips are bottom-aligned the same way (AnchorPoint Y 1, offset -BottomPad + YNudge).
	BottomPad = 2,
	-- Clients without GuiService.TopbarInset / ScreenInsets.TopbarSafeInsets (risk #1): the free part of the
	-- topbar row is assumed to start this many real px right of the safe-left edge (Roblox logo + unibar pill),
	-- i.e. x 255 on an 844x390 phone, 270 on the owner's 956x440, 208 on desktop. HudLayout.TopbarRect().
	FallbackLeft = 208,
	Corner = 22, -- pill
	TextStroke = 1.2, -- real px Colors.Ink outline on the chips' Display-font numbers
	Bg = Color3.fromRGB(18, 20, 24),
	BgTransparency = 0.25, -- visually matches Roblox's own topbar pills
	-- order; EmpireTax only while WE_EmpireTaxPct > 0 (F3), Shield only while shielded
	LeftItems = { "Level", "Settings", "CashPlus", "EmpireTax", "Shield" },
	Level = {
		MinWidth = 118,
		CaptionSize = 14, -- "LV" (real px: Scale.MinTextPx)
		NumberSize = 22, -- "7"
		BarSize = Vector2.new(56, 6),
		BarBg = Color3.fromRGB(255, 255, 255),
		BarBgTransparency = 0.8,
		PulseColor = Color3.fromRGB(255, 214, 72), -- level-up: stroke flash + UIScale 1 → 1.15 → 1 (0.45 s)
		PulseSeconds = 1.2,
		TapShowsGoalSeconds = 3.5, -- tap/hover: GoalLabel tooltip under the chip (goal + rebirth summary)
		TipGap = 6, -- real px between the topbar row and the tooltip card
		TipMaxWidth = 340,
		TipGoalSize = 15, -- GothamBold, white (real px, ≥ Scale.MinTextPx)
		TipRebirthSize = 14, -- GothamMedium, gold
		PopScale = 1.15, -- level-up chip pop (UIScale 1 → 1.15 → 1 over PopSeconds)
		PopSeconds = 0.45,
	},
	Settings = { Size = 44, IconColor = Color3.fromRGB(52, 156, 255) }, -- gear; opens SettingsController
	-- Buy-cash chip (mobile merge gate #6, T17): the green "+" that used to sit on the cash pill's right end — right
	-- where a resting left thumb lands (thumbstick zone), so a stray touch opened the Shop, a Modal that hides FIRE.
	-- Now a 44 px real chip in the Roblox topbar row: cash-bills icon + green "+" disc. Opens CashPill.PlusOpens.
	CashPlus = {
		Height = 44, -- real px (the chip IS the tap target)
		IconSize = Vector2.new(30, 23), -- HudIcons "Cash" (42:32 box)
		PlusSize = 30, -- green disc
		PlusStrokePx = 2,
		PadLeft = 10,
		PadRight = 7,
		Gap = 6,
	},
	-- F3 (owner's 11 features): Empire Tax chip "+10%" (HudIcons Flag + text), real px like every TopStrip chip. Shown
	-- only while the player attribute EconomyConfig.OutpostIncomeBuff.Attribute (WE_EmpireTaxPct) is > 0; a tap opens
	-- the Territories dropdown (HudLayout.Signals.CompassTapped). HideWhenCrowded: hidden while the left group would
	-- reach the compass (compass left - Gap), e.g. 800x360 while the Shield chip shows.
	EmpireTax = {
		MinWidth = 76,
		Height = 44, -- real px (the chip IS the tap target)
		IconSize = 22,
		TextSize = 18, -- "+10%"
		Color = Color3.fromRGB(255, 208, 64),
		HideWhenCrowded = true,
	},
	Shield = { -- raids: victim shield after being robbed (player attribute WE_ShieldUntil, os.time())
		Attribute = "WE_ShieldUntil",
		IconColor = Color3.fromRGB(80, 210, 255),
		IconSize = 24,
		TextSize = 18, -- "9:12"
	},
	Compass = {
		MinWidth = 112,
		ArrowSize = 22, -- chevron built from 2 Frames, Rotation = bearing relative to the camera
		ArrowBox = 24, -- faint round backing behind the arrow
		ArrowColor = Color3.fromRGB(255, 214, 72),
		LabelSize = 14, -- "BASE" (real px, ≥ Scale.MinTextPx)
		DistanceSize = 18, -- "95m" (Display font)
		TickSeconds = 0.25,
		HideInsideOwnPlot = true, -- inside your own walls you need no arrow home
		OwnPlotMarginStuds = 12,
		RadarDot = Color3.fromRGB(190, 110, 255), -- 8 px pulsing dot at the chip's left while RadarReveal is on
		TapOpensTerritories = true, -- tap → TerritoryController dropdown under the chip (the old list)
		-- Owner phone screenshot 2026-09-27 (at the bank, being shot): Roblox's own topbar health bar draws in THIS chip's
		-- slot (top-right of the topbar row, same 44 px pill, same edge pad) whenever you are hurt, so a yellow bar sat
		-- over "BASE 1.2km". Our health bar above the hotbar (Health, CombatController) and the red DamageEdge already
		-- show health, so CompassController switches the Roblox copy off (StarterGui:SetCoreGuiEnabled Health, false).
		-- false = Roblox's bar comes back (and covers the compass again while hurt).
		HideRobloxHealthBar = true,
	},
}

---------------------------------------------------------------------------------------------------------------
-- LEFT RAIL — 5 square tiles, vertically centred between the top of the content rect and the cash pill.
-- Settings is NOT a rail tile: 5 tiles at 64 v fit an 844x390 phone (332 px of content); 6 need 353 px.
-- If a screen is too short even for 5 (e.g. 800x360), the grid wraps to a 2nd column (FillDirectionMaxCells).
---------------------------------------------------------------------------------------------------------------

