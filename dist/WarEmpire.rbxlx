        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">WorldLabelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	World label rules (CLAUDE.md "World labels"; HUD v70 spec §5).

	Two users:
	  * Modules/WorldLabelPolicy (server) enforces the caps on every BillboardGui in Workspace as it appears.
	    v67 only touched labels inside plots; v70 also caps labels outside them (territories, POIs, NPCs, vehicles,
	    the bank, supply drops). It measures from the label's Adornee, else its first ancestor with a position.
	  * Shared/Util/WorldLabel builds labels that already follow the rules (stud-scaled, 14-20 px text, no card).
	    Its look (box studs, font, default range) is HudConfig.WorldLabels.Default.
]]

local WorldLabelConfig = {
	Enabled = true,
	-- Studs. Labels inside a plot further away than this are hidden (default BillboardGui distance is infinite).
	-- v70: 40 (CLAUDE.md: MaxDistance <= 40; was 45).
	MaxDistance = 40,
	-- v70: labels outside the plots get the same treatment (AlwaysOnTop off, range capped). false = v67 behaviour.
	ApplyOutsidePlots = true,
	OutsideMaxDistance = 40,
	-- BillboardGui names allowed to draw over walls/buildings. Everything else gets AlwaysOnTop = false.
	AllowAlwaysOnTop = {} :: { [string]: boolean },
	-- WE_LabelRole values (WorldLabel.SetRole) allowed AlwaysOnTop: the one active objective marker and a contested
	-- flag. Keeping it to ONE objective at a time is the caller's job.
	AlwaysOnTopRoles = { objective = true, contested = true } :: { [string]: boolean },
	-- Studs beyond the plot pad edge still counted as "in the base" (gate, outer sandbags, parked vehicles).
	PlotMargin = 12,

	-- Shared/Util/WorldLabel ------------------------------------------------------------------------------------
	RoleAttribute = "WE_LabelRole", -- "objective" | "contested" (unset = normal label)
	OwnerAttribute = "WE_LabelOwner", -- UserId: only that player sees the label (client filter; 0/unset = everyone)
	OwnerTag = "WE_OwnerLabel", -- CollectionService tag on owner-only labels (what the client filter watches)
	-- F1/F4/F9 (owner's 11 features): every BillboardGui at a base (premium pads, the gold pump pad, the producer
	-- label, the NEXT tag, business pops) carries this CollectionService tag (WorldLabel.Create opts.BaseLabel).
	BaseLabelTag = "WE_BaseLabel",
	-- Code Bot v168 (Shaun 2026-10-01 screenshot: "EAST YARD / Unlocks at Rebirth 5" under "AIRDROP 1.8km"): a world sign
	-- with this CollectionService tag makes the ONE AlwaysOnTop objective marker's label (ObjectiveMarker: AIRDROP, a
	-- mission, INTEL OFFICE) step aside while the two overlap on screen; the GO line and the compass pill stay
	ObjectiveYieldTag = "WE_ObjectiveYield",
	ObjectiveYieldPadPx = 6, -- real px of clearance between the two boxes
	-- The client LabelGovernor makes "at most 3 labels on screen at a base" true: Hz times a second it keeps the
	-- MaxOnScreen tagged labels nearest the camera (within their own MaxDistance) enabled and disables the rest.
	-- It never touches a label whose RoleAttribute is "objective". On since lane Z (reversible).
	BaseLabelGovernor = {
		Enabled = true,
		MaxOnScreen = 3,
		Hz = 4,
	},
	-- droppers v1b (spec_droppers.md §3.7, DR-20, DR-24): a governed base label with this attribute set to true is kept
	-- first by the LabelGovernor (it still counts toward MaxOnScreen, so the cap of 3 holds). Only
	-- Client/Modules/ProductionFx sets it, on the plate's own "+$75" pop and on the player's own plate tag while it
	-- reads "Recharging" (cleared when the recharge ends): both answer the player's own tap, so they are never held off.
	PriorityAttribute = "WE_LabelPriority",
	-- Billboard text, real px (world GUIs are not under the HUD UIScale). Fixed TextSize, never TextScaled.
	TextSize = 16,
	SubTextSize = 14,
	MinTextSize = 14,
	MaxTextSize = 20,
	LinePad = 2, -- px added to each line's height
	StudsAbove = 1.5, -- default gap above a part's top face
	-- Painted signs (WorldLabel.Surface). SurfaceGui budget: MaxDistance <= 80.
	SurfaceMaxDistance = 80,
	SurfaceDefaultMaxDistance = 40,
	SurfacePixelsPerStud = 40,
	SurfaceMaxTextSize = 100, -- Roblox's TextSize ceiling
}

return WorldLabelConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">WorldSitesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 31 (2026-09-30): FILL THE MAP. The owner: "the map is big and empty ... players get lost (BASE 1.5km,
	AIRDROP 2.5km across empty sand)".

	Server Modules/WorldSites builds these named sites in the open desert between the Central Plaza, the bases and the
	POIs. It runs after WorldFill (MapDressing), so it can avoid everything already built.
	  * Each site is made of WorldKits clusters (each <= 64 studs across; the detailed kits of WorldDetailConfig).
	  * Placement: at the configured point, or the first clear point on rings around it (up to SearchStuds away).
	    "Clear" means:
	    - no road, building or prop inside the site's radius;
	    - >= PlotClearStuds from every base plot;
	    - outside every named area;
	    - on dry land.
	  * The sites show on the world map (MapService sends their real positions) and host the JOB 31 activities and
	    garrisons (SiteActivityService).
	Our own designs, fictional names; no real place, unit or brand.

	Budget: at most MaxParts plain parts in total; a site that would pass it is skipped. The detailed props' extra parts
	come out of WorldDetailConfig.MaxExtraParts.
	Kill switch: Enabled = false (no sites, no garrisons, no site activities). The world is built once for everyone, so
	this has no per-player rollout. The garrisons and activities are owner-first (SiteActivityConfig).
]]

export type KitRow = { Kit: string, X: number, Z: number, Yaw: number?, Variant: string?, Count: number?, Length: number?, Scale: number? }
export type ClusterRow = { Kind: string, X: number, Z: number, Yaw: number?, Kits: { KitRow } }
export type Site = { Id: string, Name: string, Kind: string, X: number, Z: number }

local WorldSitesConfig = {
	Enabled = true,
	MaxParts = 240,
	SearchStuds = 260,
	PlotClearStuds = 200,
	-- the dry land the sites may use (WorldConfig: x +-1760, z -1760 .. 1490), kept off the edges
	Land = { X0 = -1650, X1 = 1650, Z0 = -1650, Z1 = 1380 },

	Sites = {
		{ Id = "CampViper", Name = "Camp Viper", Kind = "camp", X = -450, Z = -650 },
		{ Id = "DryWell", Name = "Dry Well Village", Kind = "village", X = 450, Z = 650 },
		{ Id = "PumpSeven", Name = "Pump Station 7", Kind = "oil", X = -560, Z = 0 },
		{ Id = "Kestrel", Name = "Kestrel Supply Depot", Kind = "depot", X = 560, Z = 0 },
		{ Id = "Hawk", Name = "Hawk Checkpoint", Kind = "checkpoint", X = 0, Z = -480 },
		{ Id = "Overwatch", Name = "Overwatch Ridge", Kind = "overwatch", X = -400, Z = -1000 },
		{ Id = "Anvil", Name = "Anvil Scrapyard", Kind = "tankyard", X = 1200, Z = 420 },
		{ Id = "DustCamp", Name = "Dust Camp", Kind = "camp", X = 300, Z = 1000 },
	} :: { Site },

	-- what each kind is made of: cluster rows around the site centre (studs; local -Z = the site's front)
	Kinds = {
		camp = {
			R = 46,
			Clusters = {
				{ Kind = "camp", X = 0, Z = 0, Kits = {
					{ Kit = "Tent", X = -8, Z = 0 },
					{ Kit = "Tent", X = 8, Z = 2, Yaw = 15 },
					{ Kit = "DrumGroup", X = 0, Z = -9, Variant = "fire", Count = 1 },
					{ Kit = "CrateStack", X = -1, Z = 11, Count = 3 },
				} },
				{ Kind = "tower", X = 26, Z = -14, Kits = { { Kit = "Watchtower", X = 0, Z = 0 } } },
				{ Kind = "cover", X = -24, Z = -16, Kits = {
					{ Kit = "SandbagNest", X = 0, Z = 0 },
					{ Kit = "SandbagLine", X = 11, Z = 2, Length = 10 },
				} },
				{ Kind = "wreck", X = -22, Z = 24, Yaw = 30, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "truck" } } },
			} :: { ClusterRow },
		},
		village = {
			R = 50,
			Clusters = {
				{ Kind = "ruins", X = -16, Z = -10, Kits = { { Kit = "RuinedHouse", X = 0, Z = 0 }, { Kit = "CompoundWall", X = 14, Z = 6, Length = 16 } } },
				{ Kind = "ruins", X = 18, Z = -6, Yaw = 90, Kits = { { Kit = "RuinedHouse", X = 0, Z = 0 } } },
				{ Kind = "ruins", X = 4, Z = 22, Yaw = 200, Kits = { { Kit = "RuinedHouse", X = 0, Z = 0 }, { Kit = "DrumGroup", X = 10, Z = -2, Count = 2 } } },
				{ Kind = "well", X = 0, Z = 4, Kits = { { Kit = "Fountain", X = 0, Z = 0, Variant = "well" } } },
			} :: { ClusterRow },
		},
		oil = {
			R = 46,
			Clusters = {
				{ Kind = "pumpjack", X = -16, Z = 0, Kits = { { Kit = "Pumpjack", X = 0, Z = 0 }, { Kit = "Pumpjack", X = 12, Z = 4, Yaw = 20 } } },
				{ Kind = "tanks", X = 20, Z = -8, Kits = { { Kit = "FuelTank", X = 0, Z = 0 }, { Kit = "DrumGroup", X = 9, Z = 8, Count = 3 } } },
				{ Kind = "pipes", X = 0, Z = 20, Kits = { { Kit = "PipeRun", X = 0, Z = 0, Length = 40 } } },
			} :: { ClusterRow },
		},
		depot = {
			R = 46,
			Clusters = {
				{ Kind = "containers", X = -14, Z = 0, Kits = { { Kit = "ContainerStack", X = 0, Z = 0, Count = 3 } } },
				{ Kind = "crates", X = 14, Z = -6, Kits = {
					{ Kit = "CrateStack", X = 0, Z = 0, Count = 4 },
					{ Kit = "CrateStack", X = 7, Z = 5, Count = 3, Variant = "ammo" },
					{ Kit = "Jersey", X = -6, Z = -10 },
					{ Kit = "Jersey", X = 0, Z = -10 },
				} },
				{ Kind = "fence", X = 0, Z = -28, Kits = { { Kit = "WireFence", X = 0, Z = 0, Length = 48 } } },
				{ Kind = "wreck", X = 18, Z = 22, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "truck" } } },
			} :: { ClusterRow },
		},
		checkpoint = {
			R = 40,
			Clusters = {
				{ Kind = "checkpoint", X = 0, Z = 0, Kits = { { Kit = "Checkpoint", X = 0, Z = 0 } } },
				{ Kind = "barricade", X = -2, Z = -16, Kits = {
					{ Kit = "Jersey", X = -8, Z = 0 },
					{ Kit = "Jersey", X = 8, Z = 0 },
					{ Kit = "SandbagNest", X = 20, Z = 4 },
				} },
			} :: { ClusterRow },
		},
		overwatch = {
			R = 44,
			Clusters = {
				-- the sniper perch: the Rooftop Sniper activity stands on this tower's deck
				{ Kind = "tower", X = 0, Z = 0, Kits = { { Kit = "Watchtower", X = 0, Z = 0 }, { Kit = "SandbagArc", X = 0, Z = -10 } } },
				{ Kind = "bunker", X = -6, Z = 26, Kits = { { Kit = "Bunker", X = 0, Z = 0 } } },
				{ Kind = "cover", X = 24, Z = 8, Kits = { { Kit = "SandbagLine", X = 0, Z = 0, Length = 15 }, { Kit = "Tent", X = 0, Z = 12 } } },
			} :: { ClusterRow },
		},
		tankyard = {
			R = 46,
			Clusters = {
				{ Kind = "wrecks", X = -14, Z = -8, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "tank" }, { Kit = "Wreck", X = 4, Z = 14, Variant = "tank", Yaw = 40 } } },
				{ Kind = "wrecks", X = 18, Z = 6, Yaw = 70, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "gun" }, { Kit = "Wreck", X = -4, Z = 12, Variant = "truck" } } },
				{ Kind = "cover", X = 0, Z = -26, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 }, { Kit = "Jersey", X = 9, Z = 1 } } },
			} :: { ClusterRow },
		},
	} :: { [string]: { R: number, Clusters: { ClusterRow } } },
}

return WorldSitesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">XPBalanceConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	XP rebalance (spec_xp.md, lane X1): one-time XP for cash purchases, plus the one-time backfill for old saves.
	The cheaper level curve is NOT here: it lives in LevelConfig.CurveV2, because LevelConfig must require nothing.

	Build XP: every successful EconomyService.SpendCash whose reason starts with one of Build.ReasonPrefixes pays
	  BuildXP(price) = min(Build.Cap, floor(Build.A * price ^ Build.P)) base XP through XPService.AddXP (reason
	  Build.Reason; the season, territory and DoubleXP multipliers apply like any gameplay XP). Soldiers, missile
	  strikes, gate repair and raid losses are not in the list and pay nothing. It is one-time per item and life:
	  nothing that pays can be sold, or bought twice in one life (spec_xp.md §5.1; a rebirth resets base levels, and
	  their rebuild pays again at Build.RebirthRebuildMult). Pool over the live catalogue: 56,073 base.
	Snapshot (lead decision XP-L1): the first time a save that predates this build loads with purchase XP on,
	  ProfileSchema.Migrate stores the build XP of what it already owns in BuildXP.Owed (capped at that pool) and gives
	  the save its BuildXP block, WHETHER OR NOT the backfill switch is on. From then on its purchases pay live, like a
	  new player's, and the snapshot never grows, so a purchase is paid by the snapshot or live, not both.
	Backfill switch: pays that snapshot, once (XPService.Push: quiet grant, one toast), and only in the life it was
	  taken in: after a rebirth it is dropped unpaid (BuildXP.AtPrestige, H1). A rebirth rebuild pays again, live, at
	  Build.RebirthRebuildMult. Ships OFF; the owner turns it on. The grant is exempt from the DoubleXP and territory
	  multipliers (lead decision XP-L2; the season x1.1 still applies), so it never waits on a game-pass check inside
	  the join routine.
	Revert: Enabled = false -> no purchase XP, no snapshot and no backfill (Build.Enabled / Backfill.Enabled switch
	  each half). Levels, XP already paid and an unpaid snapshot are kept. The curve reverts separately
	  (LevelConfig.CurveV2.Enabled = false).
	Tuning: do not change A, P or Cap until the backfill has been paid. A snapshot is counted with the formula of the
	  day it is taken, and the payment is capped at the pool of the day it is paid (a stored Owed is never re-capped at
	  load). A formula that pays nothing for the whole catalogue (Cap 0, A 0) counts as broken: X1 OFF, Owed kept.
	This module requires nothing (BuyPathStatic pin). ProfileSchema loads it in a pcall and checks every field and the
	three functions (validXPBalanceConfig); XPService uses ProfileSchema's checked copy. A broken edit here turns
	purchase XP, the snapshot and the backfill off in both; it never stops a profile from loading. The check needs
	"upgrade_" to stay a paying prefix and "recruit_soldiers" to pay nothing: turn purchase XP off with Build.Enabled.
]]

local XPBalanceConfig = {
	-- master switch for purchase XP, the snapshot and the backfill (not the curve)
	Enabled = true,

	-- base XP per purchase = min(Cap, floor(A * price ^ P)); $500 -> 17, $5,000 -> 56, $480,000 -> 554, cap from $1,562,500
	Build = { Enabled = true, A = 0.8, P = 0.5, Cap = 1000,
		ReasonPrefixes = { "upgrade_", "research_", "vehicle_", "weapon_" },
		Reason = "build",
		-- base-level purchases after a rebirth pay this share (1 = the same as the first time). Owner decision.
		RebirthRebuildMult = 1 },

	-- XP-L1: the snapshot is taken with this OFF; turning it ON pays each snapshot once, on that player's next join.
	-- (tools/BuyPathStatic.py pins Enabled = false: change that pin in the same edit that turns this on.)
	Backfill = { Enabled = false, Reason = "build_backfill", Toast = "★ LEVEL %d! Rank matches your base." },

	-- AddXP reasons that do not feed the battle-pass mirror (the pass is kill and daily paced)
	NoBattlePassMirror = { build = true, build_backfill = true } :: { [string]: boolean },
}

-- The purchase-XP formula alone, whatever the switches say (the backfill cap pool uses it: G5 must hold even when
-- purchase XP is switched off). 0 when price <= 0 or not a real number.
function XPBalanceConfig.BuildXPFormula(price: number): number
	if typeof(price) ~= "number" or price ~= price or price <= 0 or price == math.huge then
		return 0
	end
	local b = XPBalanceConfig.Build
	return math.min(b.Cap, math.floor(b.A * price ^ b.P))
end

-- Base build XP for one cash purchase of `price` (before the season / territory / DoubleXP multipliers).
-- 0 when purchase XP is off, when price <= 0, or when price is not a real number.
function XPBalanceConfig.BuildXP(price: number): number
	if not (XPBalanceConfig.Enabled and XPBalanceConfig.Build.Enabled) then
		return 0
	end
	return XPBalanceConfig.BuildXPFormula(price)
end

-- True when a SpendCash reason is a paying purchase ("upgrade_CommandCenter", "vehicle_ScoutCar", ...).
function XPBalanceConfig.IsBuildReason(reason: string?): boolean
	if typeof(reason) ~= "string" then
		return false
	end
	for _, prefix in ipairs(XPBalanceConfig.Build.ReasonPrefixes) do
		if string.sub(reason, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

return XPBalanceConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">Constants</string>
          <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — Shared constants (non-tunable identifiers).
	Tunable numbers live in Configs/*.
]]

local Constants = {}

Constants.GAME_NAME = "WAR EMPIRE"
Constants.TAGLINE = "BUILD. CONQUER. DOMINATE."

-- CollectionService tags (StudioSetup + runtime)
Constants.Tags = {
	BasePlot = "WE_BasePlot",
	UpgradeSlot = "WE_UpgradeSlot",
	Territory = "WE_Territory",
	CaptureZone = "WE_CaptureZone",
	VehicleSpawn = "WE_VehicleSpawn",
	NavalSpawn = "WE_NavalSpawn",
	Water = "WE_Water", -- v69: water surface parts (top face = water level); boats may only move over these
	NPCSpawn = "WE_NPCSpawn",
	EventSpawn = "WE_EventSpawn",
	SupplyDrop = "WE_SupplyDrop",
	BankVault = "WE_BankVault",
	NPC = "WE_NPC",
	Vehicle = "WE_Vehicle",
	TutorialMarker = "WE_TutorialMarker",
	MoneyCollector = "WE_MoneyCollector",
	GateBarrier = "WE_GateBarrier",
	PlotOilPump = "WE_PlotOilPump",
	PremiumPad = "WE_PremiumPad",
}

-- Remote folder / names (created by RemoteSetup)
Constants.RemotesFolderName = "WE_Remotes" -- v60: server-only; never Rojo empty Remotes
Constants.RemoteNames = {
	-- Server → Client (push)
	PlayerStateUpdate = "PlayerStateUpdate",
	BaseStateUpdate = "BaseStateUpdate",
	Notification = "Notification",
	EconomyUpdate = "EconomyUpdate",
	XPUpdate = "XPUpdate",
	CombatStateUpdate = "CombatStateUpdate",
	CombatHitFeedback = "CombatHitFeedback",
	VehicleStateUpdate = "VehicleStateUpdate",
	TerritoryStateUpdate = "TerritoryStateUpdate",
	MissionStateUpdate = "MissionStateUpdate",
	-- Client → Server (request/action only — NEVER GiveCash/GiveXP/GiveWeapon)
	RequestPurchaseUpgrade = "RequestPurchaseUpgrade",
	PurchaseResult = "PurchaseResult", -- v62: server always replies Ok/Err after buy
	RequestClaimDailyReward = "RequestClaimDailyReward",
	RequestSpawnVehicle = "RequestSpawnVehicle",
	RequestPurchaseVehicle = "RequestPurchaseVehicle",
	RequestDespawnVehicle = "RequestDespawnVehicle",
	RequestEquipWeapon = "RequestEquipWeapon",
	RequestPurchaseWeapon = "RequestPurchaseWeapon",
	RequestFire = "RequestFire",
	RequestReload = "RequestReload",
	RequestStartMission = "RequestStartMission",
	RequestClaimMission = "RequestClaimMission",
	RequestCaptureTerritory = "RequestCaptureTerritory",
	RequestAdminCommand = "RequestAdminCommand",
	RequestPurchaseDevProduct = "RequestPurchaseDevProduct",
	RequestPurchaseGamePass = "RequestPurchaseGamePass",
	RequestSkipTutorial = "RequestSkipTutorial",
	TutorialStateUpdate = "TutorialStateUpdate",
	-- Prestige / Clan / Battle Pass
	RequestPrestige = "RequestPrestige",
	PrestigeStateUpdate = "PrestigeStateUpdate",
	RequestCreateClan = "RequestCreateClan",
	RequestJoinClan = "RequestJoinClan",
	RequestLeaveClan = "RequestLeaveClan",
	ClanStateUpdate = "ClanStateUpdate",
	RequestClaimBattlePassReward = "RequestClaimBattlePassReward",
	BattlePassStateUpdate = "BattlePassStateUpdate",
	-- Soldiers / Season / Clan War
	RequestRecruitSoldiers = "RequestRecruitSoldiers",
	RequestDismissSoldiers = "RequestDismissSoldiers",
	SoldierStateUpdate = "SoldierStateUpdate",
	RequestSquadOrder = "RequestSquadOrder",
	SquadOrderStateUpdate = "SquadOrderStateUpdate",
	SeasonStateUpdate = "SeasonStateUpdate",
	RequestDeclareClanWar = "RequestDeclareClanWar",
	ClanWarStateUpdate = "ClanWarStateUpdate",
	RequestRedeemCode = "RequestRedeemCode",
	RequestAnalyticsEvent = "RequestAnalyticsEvent", -- claude-bud JOB 24 §10: a whitelisted UI event (AnalyticsService)
	BuildingTip = "BuildingTip", -- claude-bud JOB 24 §5: server -> client "NEW BUILDING" card { Id }
	RequestTipSetting = "RequestTipSetting", -- claude-bud JOB 24 §5: Settings -> TIPS on / off
	RequestTipsReplay = "RequestTipsReplay", -- claude-bud JOB 24 §5: Settings -> show my building tips again
	RequestBuyArmour = "RequestBuyArmour", -- claude-bud JOB 26: buy the next armour tier (ArmourService)
	RequestArmourLook = "RequestArmourLook", -- claude-bud JOB 26: hide / show the armour look
	RequestNuke = "RequestNuke", -- claude-bud JOB 33: (action "panel" | "rush" | "launch", targetId?) NukeService
	RequestAchievements = "RequestAchievements", -- claude-bud JOB 34: () -> FeaturePush "AchState" (AchievementService)
	RequestArmySend = "RequestArmySend", -- claude-bud JOB 38: (plotId) SEND the army (ArmyPlan; the server re-checks everything)
	RequestArmySendCheck = "RequestArmySendCheck", -- claude-bud JOB 38: (plotId) -> FeaturePush "ArmySendVerdict"
	RequestEndgameBuy = "RequestEndgameBuy", -- claude-bud JOB 39: (kind, id?) EndgameService.Purchase (the price is config's)
	RequestRivalAction = "RequestRivalAction", -- claude-bud JOB 41 C: "open" | "send" (+ plot id): telemetry only
	RequestMissionReroll = "RequestMissionReroll", -- claude-bud JOB 49 C: (missionId) reroll a core mission (server-checked)
	RequestRecruitPackResult = "RequestRecruitPackResult", -- claude-bud JOB 41 B: shown | dropped (the card; grants stay ProcessReceipt)
	RequestRatePromptAnswer = "RequestRatePromptAnswer", -- claude-bud JOB 40 D: later | never | favorite | timeout (no reward)
	RequestEndgameState = "RequestEndgameState", -- claude-bud JOB 39: () -> FeaturePush "EndgameState"
	RequestSiteActivity = "RequestSiteActivity", -- claude-bud JOB 31: (action "list" | "start" | "quit", id?) SiteActivityService
	RequestNotifOptInResult = "RequestNotifOptInResult", -- claude-bud JOB 29: the notification opt-in prompt result
	RequestEventPopupSeen = "RequestEventPopupSeen", -- Code Bot v192: (EventConfig.Id) the DOUBLE WEEKEND pop-up was shown
	CodeStateUpdate = "CodeStateUpdate",
	-- Code Bot v102: RemoteFunction. Client -> server (code: string) -> { Result = "Success" | "AlreadyUsed" | "Invalid"
	-- | "Expired" | "RateLimited" | "NotReady", Message: string }. Server validates + rate-limits (CodesService).
	RedeemCode = "RedeemCode",
	RequestMapLive = "RequestMapLive", -- claude-bud JOB 30: RemoteFunction, the world map's live markers (MapService)
	NationColorUpdate = "NationColorUpdate",
	-- Nations (cosmetic country flag): client -> server Types.NationRequestPayload { Action = "pick" | "later", Id?,
	-- Source }. Replies go to that player only on NationColorUpdate. The server validates everything (rate limit,
	-- NationConfig.Get) and grants nothing but the cosmetic choice.
	RequestSetNation = "RequestSetNation",
	RequestClaimSpinner = "RequestClaimSpinner",
	SpinnerStateUpdate = "SpinnerStateUpdate",
	BankRaidStateUpdate = "BankRaidStateUpdate",
	-- Studio-only BUY smoke → client Output (Play Solo)
	StudioSmokeLog = "StudioSmokeLog",
	DeathShopOffer = "DeathShopOffer",
	StarterBundleOffer = "StarterBundleOffer",
	AutoCollectOffer = "AutoCollectOffer",
	DoubleCashOffer = "DoubleCashOffer",
	VIPOffer = "VIPOffer",
	SpeedBoostOffer = "SpeedBoostOffer",
	CashMegaOffer = "CashMegaOffer",
	AtmRaidStateUpdate = "AtmRaidStateUpdate",
	PromptPremiumPad = "PromptPremiumPad",
	-- v69: Research Lab upgrades, Command Center missile strikes, vehicle drive input
	RequestResearch = "RequestResearch",
	ResearchStateUpdate = "ResearchStateUpdate",
	RequestMissileStrike = "RequestMissileStrike",
	MissileStrikeStateUpdate = "MissileStrikeStateUpdate",
	MissileStrikeFx = "MissileStrikeFx",
	VehicleDriveInput = "VehicleDriveInput",
	-- v71 money (M2): created now, used by later workflows (nothing fires or listens to them yet).
	-- Nuke (M5; own Fx remote, J17)
	RequestNukeLaunch = "RequestNukeLaunch",
	RequestNukeState = "RequestNukeState",
	NukeStateUpdate = "NukeStateUpdate",
	NukeFx = "NukeFx",
	-- Premium / vehicle weapons (M6). VehicleWeaponFx is an UnreliableRemoteEvent (RemoteSetup UNRELIABLE list).
	RequestVehicleFire = "RequestVehicleFire",
	VehicleWeaponFx = "VehicleWeaponFx",
	RequestVehicleCamo = "RequestVehicleCamo",
	RequestPremiumTrial = "RequestPremiumTrial",
	-- Rebirth expansion (M7). Not "SupplyDrop": that name belongs to SupplyDropService.
	RebirthStateUpdate = "RebirthStateUpdate",
	RequestRebirthState = "RequestRebirthState",
	ArtilleryFx = "ArtilleryFx",
	DroneCrateFx = "DroneCrateFx",
	-- Offer Director (M3) and M8 (purchase ticker, shortfall chip)
	OfferShow = "OfferShow",
	OfferResult = "OfferResult",
	PurchaseAnnounce = "PurchaseAnnounce",
	ShortfallChip = "ShortfallChip",
	-- W2 Combat Core: WeaponFx is an UnreliableRemoteEvent (RemoteSetup UNRELIABLE list); RequestSetDrawn a RemoteEvent
	WeaponFx = "WeaponFx",
	RequestSetDrawn = "RequestSetDrawn",
	GetPlayerState = "GetPlayerState",
	-- W3 step 2 Phase B, Jobs ("Ops"; OpsConfig.Enabled gates every sender). Server -> client only: there is NO Ops
	-- client -> server remote (every job action is a server ProximityPrompt). Payload types: OpsConfig exports.
	OpsState = "OpsState", -- RemoteEvent, per player: OpsStatePayload (Full on join + every 60 s, deltas <= 2 Hz)
	OpsProgress = "OpsProgress", -- RemoteEvent, per player: OpsProgressPayload (4 Hz, only inside a job zone)
	OpsPing = "OpsPing", -- UnreliableRemoteEvent (RemoteSetup UNRELIABLE list): OpsPingPayload, every 10 s per carrier
	-- droppers v1b: UnreliableRemoteEvent (RemoteSetup UNRELIABLE list), server -> the grabber only, one packet per
	-- paid plate grab: (dropPoint: Vector3, amount: number, left: number, eta: number). Cosmetic: a lost packet loses
	-- the effect, never money. Nobody listens on the server (no OnServerEvent).
	DropperFx = "DropperFx",
	-- claude-bud JOB 4/5: server -> one client, (kind: string, data: table): feature cues (airdrop marker, plaza bounty,
	-- daily streak, offers). Owner-only features fire it only to players the feature is live for. No OnServerEvent.
	FeaturePush = "FeaturePush",
	-- claude-bud JOB 5c: client -> server, no args: use one Plaza Airstrike charge (the server checks everything)
	RequestPlazaAirstrike = "RequestPlazaAirstrike",
	-- claude-bud JOB 5e: client -> server, no args: claim the one-time group-join reward (the server checks the group)
	RequestGroupReward = "RequestGroupReward",
	-- claude-bud PREMIUM: client -> server (action "Fire" | "Missile", aim: Vector3); PremiumWeaponService checks all
	RequestPremiumWeapon = "RequestPremiumWeapon",
	RequestBoardSetting = "RequestBoardSetting", -- claude-bud BOARDS: client -> server, the Supporter board opt-out (boolean)
	-- claude-bud PREMIUM: UnreliableRemoteEvent (RemoteSetup UNRELIABLE list), server -> all clients: gun / missile / boom fx
	PremiumWeaponFx = "PremiumWeaponFx",
}

Constants.DataStoreName = "WarEmpire_PlayerData_v2" -- v55: intentional bump; fresh CreateDefault + StartingCash (kills stuck $0 v1 saves)
Constants.SessionStoreName = "WarEmpire_SessionLock_v1"
Constants.CURRENT_DATA_VERSION = 8

Constants.AutosaveIntervalSeconds = 60
-- Session lock: refresh often; steal if age >= TTL (rejoin after crash ~30–45s)
Constants.SessionLockTtlSeconds = 45
Constants.SessionLockRefreshSeconds = 15
Constants.DataStoreRetries = 3
Constants.DataStoreRetryDelay = 1.5

Constants.MaxBasePlots = 10 -- claude-bud JOB 21: = BaseConfig.MaxPlots (tools/checks/claude_bud_plots.py)
Constants.PassiveIncomeTickSeconds = 5

Constants.Colors = {
	Background = Color3.fromRGB(18, 20, 24),
	Panel = Color3.fromRGB(28, 32, 38),
	Accent = Color3.fromRGB(70, 130, 80),
	Cash = Color3.fromRGB(130, 255, 170), -- v36 high-contrast cash (not yellow)
	Gold = Color3.fromRGB(230, 190, 60),
	XP = Color3.fromRGB(90, 160, 220),
	Danger = Color3.fromRGB(200, 70, 70),
	Health = Color3.fromRGB(200, 70, 70),
	Ammo = Color3.fromRGB(220, 200, 120),
	Text = Color3.fromRGB(235, 238, 242),
	Muted = Color3.fromRGB(150, 158, 170),
	-- Visual kits v2 UI
	Gunmetal = Color3.fromRGB(42, 48, 55),
	GunmetalLight = Color3.fromRGB(58, 66, 74),
	CategoryGround = Color3.fromRGB(90, 130, 80),
	CategoryAir = Color3.fromRGB(90, 160, 220),
	CategoryNaval = Color3.fromRGB(70, 180, 200),
	-- High-contrast (never pale yellow on sand/green)
	TextOnDark = Color3.fromRGB(245, 248, 252),
	TextDark = Color3.fromRGB(18, 20, 24),
	PlateDark = Color3.fromRGB(12, 14, 18),
	GoldBright = Color3.fromRGB(255, 210, 90),
	NeonAccent = Color3.fromRGB(80, 255, 160),
	Olive = Color3.fromRGB(72, 88, 58),
	Sand = Color3.fromRGB(196, 170, 120),
}

return Constants
]]></string>
        </Properties>
