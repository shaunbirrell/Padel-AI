---------------------------------------------------------------------------------------------------------------
-- W2 COMBAT FEEL (client only: WeaponVisuals, CameraFx, AimTargets). The server stays authoritative: the client
-- aim help only nudges the camera; the server re-runs its own cone (AimAssistConfig) on every shot.
---------------------------------------------------------------------------------------------------------------

HudConfig.AimHelp = {
	Enabled = true,
	-- per input class (AimTargets.InputClass(), from UserInputService.PreferredInput); a level name from Levels
	Strength = { Touch = "Medium", Gamepad = "Low", KeyboardAndMouse = "Off" },
	-- FrictionKeep: share of the player's own frame-to-frame camera turn kept while a hostile is in the cone
	-- Tracking:     max share of the target's angular velocity the camera follows (never a snap to centre)
	Levels = {
		Off = { FrictionKeep = 1, Tracking = 0 },
		Low = { FrictionKeep = 0.8, Tracking = 0.1 },
		Medium = { FrictionKeep = 0.6, Tracking = 0.2 },
	},
	ScanHz = 10, -- AimTargets candidate scan (only while drawn and the level is not Off)
	MaxCandidates = 8, -- nearest in-cone candidates considered per scan
	MaxLosRays = 2, -- line-of-sight raycasts per scan
}

HudConfig.CombatCamera = {
	-- P1-3 shoulder camera while drawn, alive and on foot, per input class
	Shoulder = { Touch = true, Gamepad = false, KeyboardAndMouse = false },
	ShoulderOffset = Vector3.new(1.75, 0.6, 0), -- Humanoid.CameraOffset (studs)
	FaceCameraYaw = true, -- AutoRotate off; the root follows the camera yaw (written only when it moves > 1°)
	FovNudge = 0,
	RecoilSpring = { Speed = 20, Damper = 0.8 }, -- WeaponConfig.Recoil.Recover overrides Speed per weapon
	RecoilScaleTouch = 0.5, -- touch players get half the camera kick
	Shake = { BlastAmplitude = 0.6, BlastAmplitudeTouch = 0.3, HitAmplitude = 0.15, MaxRadiusMult = 3 },
	RespectReducedMotion = true, -- GuiService.ReducedMotionEnabled → no shake and no recoil kick
}

HudConfig.CombatFx = {
	CullStuds = 250, -- WeaponFx farther than this from the camera (both ends) is skipped
	Tracers = { Max = 16, MaxTouch = 10, Seconds = 0.08 }, -- Beams on pooled Terrain attachments (0 parts)
	Impacts = { Max = 12, MaxTouch = 8, Emit = 8, EmitTouch = 4 }, -- pooled Attachment + ParticleEmitter (0 parts)
	BulletHoles = { Max = 20, MaxTouch = 10, Seconds = 4 }, -- parts
	Projectiles = { Max = 6, MaxTouch = 4, PartsEach = 3 }, -- parts
	Casings = { Enabled = true, EnabledTouch = false, Max = 8, Seconds = 2 }, -- parts
	MaxFxParts = 48, -- hard cap across the three part pools (20 + 18 + 8 = 46)
	MaxFxPartsTouch = 24, -- touch: 10 + 12 + 0 = 22
	MuzzleFlashSeconds = 0.05,
	RemoteGuns = { Max = 6, MaxTouch = 3, Radius = 120, CoreParts = 5 }, -- other players' drawn guns (core LOD)
	DamageNumbers = { Max = 4, Seconds = 0.8, TextPx = 18 }, -- real px; local only, behind ShowDamageNumbers
	TargetBar = { Seconds = 2.5, Width = 120, Height = 6, NamePx = 14 }, -- real px, under the reticle
	Haptics = { Enabled = true, Hit = 0.2, Kill = 0.5 }, -- touch only (HapticService)
	-- Roblox-owned animation ids (docs/ASSET_SHORTLIST.md §3.4, creator Roblox); 0 disables
	-- A Hold id is played Looped at normal speed (WeaponVisuals.playHold), so it must be a real idle loop. Never
	-- 3972164452 (the Weapons Kit "RifleAim"): that is a pitch-scrub pose sheet (t = 0 aims 80° down, t = 1 level,
	-- t = 2 aims 80° up; the kit freezes it and sets TimePosition from the camera pitch) that keys the Waist
	-- (UpperTorso ~50° twist, -73° -> +28° pitch). Looped it swept the torso and the launcher from down to near
	-- vertical every 2 s and snapped back: the RPG / launcher wobble (owner report 2026-09-30). The launchers use
	-- RifleHold (arms only; its UpperTorso pose has Weight 0, t = 0 and t = 2 are the same pose).
	Anims = { Hold = { Rifle = 3972151362, Pistol = 507768375, Launcher = 3972151362 }, Reload = 3972131105 },
	-- gun placement in the hand (device tuning knob; zero = the Roblox Tool default: barrel along the
	-- RightGripAttachment's -Z, top along its +Y). Handle = grip * Rotation(deg, X/Y/Z order) * Offset(studs).
	Grip = { RotationDeg = Vector3.zero, OffsetStuds = Vector3.zero },
}

---------------------------------------------------------------------------------------------------------------
-- RESERVED REGIONS — nothing but the owners listed may draw here (HudLayout.Reserve(name) returns the rect)
---------------------------------------------------------------------------------------------------------------

HudConfig.Reserve = {
	-- Bottom-right vehicle/combat controls. Owners: CombatController (FIRE / R / ammo), VehicleDriveClient
	-- (▲▼ lift/pitch, throttle, exit), Roblox jump. Measured from the content rect's bottom-right, in v;
	-- MinWidthPx/MinHeightPx (real px) are floors so the rect always holds VehicleDriveClient's ▲▼ column:
	-- Laws.ControlsLayout puts it right above the jump button, top edge at H − (90 + 10 + 52 + 8 + 52) = H − 212
	-- on phones (H − 222 without a jump button, H − 218 on tablets); its hard cap is RESERVED_FROM_BOTTOM = 250.
	-- FIRE / RELOAD share that space, which is why combat is hidden while Driving.
	CombatTouch = { Width = 290, Height = 300, MinWidthPx = 0, MinHeightPx = 222 }, -- 844x390: x ≥ 594, y ≥ 168 real
	CombatDesktop = { Width = 340, Height = 150, MinWidthPx = 0, MinHeightPx = 0 }, -- 1280x720: x ≥ 974, y ≥ 585 real
	-- Suggested touch slots (VehicleDriveClient v70 computes its own column above the jump button instead;
	-- these stay as the documented fallback; combat is hidden while seated):
	VehicleTouch = {
		Up = { Size = 64, Anchor = Vector2.new(1, 1), Right = 142, Bottom = 143 }, -- the RELOAD slot
		Down = { Size = 64, Anchor = Vector2.new(1, 1), Right = 142, Bottom = 36 }, -- left of jump, same row
	},
}

---------------------------------------------------------------------------------------------------------------
-- CONTEXT FLAGS + VISIBILITY — HudLayout publishes these; every element's HideWhen/ShowWhen reads them
---------------------------------------------------------------------------------------------------------------

HudConfig.Context = {
	-- Flag       Set by
	-- Modal      any registered panel open (HudLayout.PanelOpened / PanelClosed) — also enforces ONE open panel
	-- Driving    Humanoid.SeatPart is a VehicleSeat (HudLayout watches the humanoid) + VehicleDriveClient
	-- Drawn      CombatController holster state
	-- Reloading  CombatStateUpdate.Reloading
	-- Hurt       health < max
	-- RecentCombat  hit taken/landed or fired within Health.RecentCombatSeconds
	-- Tutorial   TutorialController step active
	-- InOwnPlot  CompassController plot test (inside own walls + margin)
	-- Dead       Humanoid dead (HudLayout: Died → true, CharacterAdded → false) / CombatState.Alive == false
	-- OrdersOpen OrdersController (Army popover open → 1-4 / T are order hotkeys)
	-- Radar      TerritoryController (RadarReveal active → purple dot on the compass chip)
	Flags = { "Modal", "Driving", "Drawn", "Reloading", "Hurt", "RecentCombat", "Tutorial", "InOwnPlot", "Dead", "OrdersOpen", "Radar" },
	ModalExclusive = true, -- opening a panel closes the others
	ModalDim = 0.45, -- BackgroundTransparency of the black dim behind the open panel (UIUtil.MakeModalDim; Active = false; tap outside closes)
}

---------------------------------------------------------------------------------------------------------------
-- INPUT — one table; SettingsController's keybind sheet is generated from it
---------------------------------------------------------------------------------------------------------------

HudConfig.Keys = {
	Shop = Enum.KeyCode.P,
	Rebirth = Enum.KeyCode.K,
	Army = Enum.KeyCode.Y, -- was A (strafe-left toggled the Army panel while walking)
	Garage = Enum.KeyCode.G,
	Missions = Enum.KeyCode.N, -- claude-bud JOB 30: was M (M opens the world map)
	Map = Enum.KeyCode.M, -- claude-bud JOB 30: the world map (MapController)
	Settings = nil, -- was O (Roblox camera zoom-out). Gear button only.
	Base = Enum.KeyCode.B, -- Base menu leaves the HUD; B and the Command Center map table remain
	Weapons = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }, -- draw / holster
	WeaponPrev = Enum.KeyCode.Q, -- ignored while seated; E no longer cycles (it is the prompt key)
	WeaponWheel = true, -- mouse wheel cycles only while drawn (camera zoom otherwise)
	Reload = Enum.KeyCode.R,
	OrdersCycle = Enum.KeyCode.T,
	-- 1-4 issue squad orders ONLY while the Army popover is open (HudLayout.GetFlag("OrdersOpen"))
	Gamepad = {
		Fire = Enum.KeyCode.ButtonR2,
		Reload = Enum.KeyCode.ButtonY, -- ButtonX stays the ProximityPrompt button
		Next = Enum.KeyCode.ButtonR1,
		Prev = Enum.KeyCode.ButtonL1,
		DrawHolster = Enum.KeyCode.DPadUp,
	},
	CombatInputBlockedWhen = { "Driving", "Modal", "Dead" }, -- no firing from a seat, through a panel, or dead
	FireNeedsDrawn = true, -- LMB on a ClickDetector (tutorial dropper) never fires the gun while holstered
}

---------------------------------------------------------------------------------------------------------------
-- WORLD LABELS — client console tags (WorldPromptController) + the shared stud-scaled helper (WorldLabel)
---------------------------------------------------------------------------------------------------------------

HudConfig.WorldLabels = {
	Console = {
		Size = UDim2.fromOffset(118, 40), -- real px (pinned PRICE_BILLBOARD_SIZE); plain text, NO card
		StudsAboveConsoleTop = 2.2, -- stays under the 12-stud ceiling inside walk-in buildings
		MaxDistanceBuild = 30, -- L0 "HELIPAD / BUILD $5,000"
		MaxDistanceUpgrade = 18, -- L1-4 "HELIPAD / LV 2 → 3 · $12K"
		NameSize = 16,
		PriceSize = 15,
		NameColor = Color3.fromRGB(255, 255, 255),
		PriceAffordable = Color3.fromRGB(110, 255, 90),
		PriceShort = Color3.fromRGB(255, 96, 96),
		LockedColor = Color3.fromRGB(170, 176, 184), -- "Needs Command Center 2"
		StrokeTransparency = 0, -- Colors.Ink
		ShowOnMax = false, -- MAX lives on the console screen SurfaceGui, not in the air
		ShowIncome = false, -- income is on the console screen and in the Base panel
		OwnerOnly = true,
		AlwaysOnTop = false,
	},
	-- Shared helper Shared/Util/WorldLabel.luau: stud-scaled plain text (Size = UDim2.fromScale(w, h)),
	-- AlwaysOnTop = false, optional OwnerUserId (client hides it for everyone else).
	Default = { StudsW = 6, StudsH = 1.6, MaxDistance = 40, Font = Enum.Font.FredokaOne },
	Transient = { MaxDistance = 28 }, -- "+$10" pops: owner client only
}

return HudConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">JuiceConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 11 (2026-09-29): juice (Client/Modules/Juice). Already in the game and kept: purchase / collect / level-up
	sounds (SoundConfig.Hooks), the HUD "+$N" cash floats (HudLayout.CashFloat), toasts. Added, owner-only first:
	  * Purchase / unlock burst: on a successful base purchase (PurchaseResult Ok) a gold ring expands at the player's
	    feet (he stands at the console) with a short spark burst; the ring is 1 client part, the sparks one Emit.
	    Low FX (ProductionFx.IsLowFx / the JOB 8 low tier): ring only, no particles.
	  * Rebirth celebration: the server's FeaturePush "Rebirth" (after a saved rebirth) shows a gold banner in the HUD's
	    top stack ("REBIRTH P3!" + what it gives) and a light confetti fall, BannerSeconds long; never covers the controls.
	All client-only (nothing replicates), no per-frame work outside the short tweens. Rollout "owner" / "all" / off.
]]

local JuiceConfig = {
	Rollout = "all", -- v101
	Burst = {
		Seconds = 1.1,
		RingStuds = 12,
		Particles = 18,
		Color = Color3.fromRGB(255, 205, 60),
	},
	Rebirth = {
		BannerSeconds = 3.5,
		Confetti = 26,
		Colors = { Color3.fromRGB(255, 205, 60), Color3.fromRGB(255, 255, 255), Color3.fromRGB(110, 200, 90) } :: { Color3 },
	},
	Guided = { BannerSeconds = 3, Confetti = 26 }, -- claude-bud JOB 41: the Guided "BASE SECURED!" banner (Rebirth path)
}

function JuiceConfig.LiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("Juice") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = JuiceConfig.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
	end
	return false
end

return JuiceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">LeaderboardConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud BOARDS (2026-09-29): the Town Centre notice boards. Extends the JOB 13 leaderboard (server:
	EngagementService, client: EngagementClient; data: ReplicatedStorage.WE_Leaderboards). Live for all players.
	  * One OrderedDataStore per stat: StorePrefix .. Id (all-time) and StorePrefix .. Id .. "_W" .. IsoWeek(now)
	    (weekly: a fresh store every ISO week, UTC).
	  * Writes: per player at most once per WriteMinSeconds (only values that changed; never a 0), plus once on leave.
	    Reads: ONE server-wide fetch of the top FetchN per board every ReadSeconds, published for every client. Every
	    DataStore call is pcall'd; after a failure that kind of call backs off (BackoffSeconds doubling to BackoffMax).
	  * Kills: real player-vs-player kills only (the server's creator tag via CombatService.OnPlayerDeath), never self or
	    a clan mate, and one killer -> victim pair counts at most KillPairMax times per KillPairWindowSeconds.
	  * Code Bot v175: Supporters has an ALL-TIME and a THIS WEEK tab (WE_LB2_Supporters / WE_LB2_Supporters_W<week>):
	    this week = Monetization.RobuxSpent - profile.LB.SupWBase (the total at the week's start). Every dev product
	    (ProcessReceipt CurrencySpent) and confirmed pass purchase moves both; a never-counted pass credited on join
	    counts all-time only. Written at once on every saved purchase, on join and on leave ("[SUPPORTERS]" log lines).
	  * Supporters: Robux spent in game (profile.Monetization.RobuxSpent: dev products from ProcessReceipt's
	    CurrencySpent, saved before the ack; game passes at the real price once UserOwnsGamePassAsync confirms). A player
	    who spent nothing is never written; Settings "Supporter board" (profile.Settings.SupporterBoardOptOut) removes
	    the player from it.
	  * A player standing within YouRowStuds of a board sees his own line ("You: #12 · 56 kills"; rank known inside the
	    top FetchN, else "#100+"). The weekly #1 of each weekly board wears a gold crown while in game.
]]

export type Board = {
	Id: string,
	Title: string,
	Unit: string,
	AllTime: boolean,
	Weekly: boolean,
	Money: boolean?,
	OptOut: boolean?,
}

local LeaderboardConfig = {
	Boards = {
		{ Id = "Kills", Title = "MOST KILLS", Unit = "kills", AllTime = true, Weekly = true },
		{ Id = "Richest", Title = "RICHEST", Unit = "", AllTime = true, Weekly = false, Money = true },
		{ Id = "Supporters", Title = "TOP SUPPORTERS", Unit = "Robux", AllTime = true, Weekly = true, OptOut = true }, -- Code Bot v175: + THIS WEEK
		{ Id = "Plaza", Title = "PLAZA CONQUEROR", Unit = "captures", AllTime = false, Weekly = true },
		{ Id = "Rebirths", Title = "REBIRTH KINGS", Unit = "rebirths", AllTime = true, Weekly = false },
		{ Id = "Army", Title = "TOP ARMY", Unit = "soldiers", AllTime = true, Weekly = false },
	} :: { Board },

	StorePrefix = "WE_LB2_",
	WriteMinSeconds = 90, -- per player (the owner's rule: 60-120 s), plus on leave
	ReadSeconds = 90, -- one shared fetch per board (the owner's rule: 60-90 s). Code Bot v175: 90 (was 75): 10 keys / 90 s = 6.7 / min, inside a 1-player server's 5 + 2 x 1 = 7 GetSortedAsync / min
	TopN = 10, -- rows on a board
	FetchN = 100, -- rows fetched (one page) so a player's own rank is known inside the top 100
	BackoffSeconds = 30,
	BackoffMax = 600,
	MinBudget = 5, -- skip a write / read when the DataStore request budget is below this

	KillPairMax = 3, -- the same killer -> victim pair counts at most this many kills ...
	KillPairWindowSeconds = 600, -- ... per 10 minutes

	-- the row in the Town Centre square (90 x 90 at (-150, 150)): along its south edge, facing the fountain (north)
	Row = {
		FirstX = -187.5,
		StepX = 15,
		Z = 190,
		FaceDirZ = -1, -- the boards' fronts face -Z (the square's centre)
	},
	BoardSize = Vector3.new(14, 22, 1), -- 1.5-stud rows: readable on a phone from ~30 studs
	PixelsPerStud = 25,
	MaxDistance = 80, -- SurfaceGui cap (CLAUDE.md budget)
	YouRowStuds = 40,
	TabSeconds = 8, -- a board with both tabs alternates ALL-TIME / THIS WEEK
	NightCheckSeconds = 10,
	CrownMaxDistance = 40,
}

-- "2026W40": the ISO-8601 week (Monday start; week 1 holds the year's first Thursday) of a UTC time. Pure.
function LeaderboardConfig.IsoWeek(t: number): string
	local day = math.floor(t / 86400)
	local wd = (day + 3) % 7 -- 0 = Monday (1970-01-01 was a Thursday)
	local thursday = day - wd + 3
	local d = os.date("!*t", thursday * 86400) :: any
	local week = math.floor((d.yday - 1) / 7) + 1
	return string.format("%04dW%02d", d.year, week)
end

function LeaderboardConfig.StoreName(id: string, weekly: boolean, now: number): string
	if weekly then
		return LeaderboardConfig.StorePrefix .. id .. "_W" .. LeaderboardConfig.IsoWeek(now)
	end
	return LeaderboardConfig.StorePrefix .. id
end

-- may this player write again? (the per-player throttle). Pure.
function LeaderboardConfig.WriteDue(lastAt: number?, now: number): boolean
	return lastAt == nil or now - lastAt >= LeaderboardConfig.WriteMinSeconds
end

--[[ Does this kill count for the board? log = the server's pair log ("killer:victim" -> recent times, pruned here).
	Never self, never a clan mate (allied), at most KillPairMax per KillPairWindowSeconds per pair. Pure. ]]
function LeaderboardConfig.AllowKill(log: { [string]: { number } }, killerId: number, victimId: number, allied: boolean, now: number): boolean
	if killerId == victimId or killerId <= 0 or victimId <= 0 or allied then
		return false
	end
	local key = tostring(killerId) .. ":" .. tostring(victimId)
	local list = log[key] or {}
	local kept: { number } = {}
	for _, at in ipairs(list) do
		if now - at < LeaderboardConfig.KillPairWindowSeconds then
			table.insert(kept, at)
		end
	end
	if #kept >= LeaderboardConfig.KillPairMax then
		log[key] = kept
		return false
	end
	table.insert(kept, now)
	log[key] = kept
	return true
end

-- claude-bud JOB 38 ADDENDUM (owner 2026-09-30): ARMY KILLS replaces TOP ARMY in the same slot (army size is capped, so
-- TOP ARMY is a tie). Its own store keys ("WE_LB2_ArmyKills", weekly "_W<week>").
-- Code Bot v156 (Shaun 2026-10-01: the live plaza still showed TOP ARMY, everyone tied at 75). Root cause: the swap
-- below waited for ArmyOrdersConfig.LiveForAll(), which was false while army orders stayed owner-first (v166 flipped them live for all), AND
-- EngagementService.NoteArmyKill only counted kills for players army orders were live for (the owner, who is excluded
-- from every board), so nobody could ever score. The board is only a leaderboard: it now has its own switch,
-- ArmyKillsBoardLive (true = ARMY KILLS for everyone, whatever the army orders rollout; false = TOP ARMY exactly as
-- before). Kills count from the army's normal fire too (FOLLOW / HOLD / DEFEND escort shots, not only ATTACK / SEND).
-- Admin / owner accounts stay off every board (EngagementService.isBoardExcluded, at write and at read).
LeaderboardConfig.ArmyKillsBoard = { Id = "ArmyKills", Title = "ARMY KILLS", Unit = "kills", AllTime = true, Weekly = true } :: Board
LeaderboardConfig.ArmyKillsBoardLive = true
if LeaderboardConfig.ArmyKillsBoardLive == true then
	for i, b in ipairs(LeaderboardConfig.Boards) do
		if b.Id == "Army" then
			LeaderboardConfig.Boards[i] = LeaderboardConfig.ArmyKillsBoard
		end
	end
end
return LeaderboardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">LevelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Levels 1–100 via formula.
	XP to go from level L to L+1: floor(100 * L ^ 1.45 * CurveMult(L)) (XP rebalance, spec_xp.md; CurveV2 below).
	With CurveV2.Enabled = false it is exactly floor(100 * L ^ 1.45), the pre-rebalance curve.
	Rewards granted on level-up (cash + optional gold every 5).

	Milestones: clear unlock messages + HUD next-goal text (Design/Code P0).
	ASSUMPTION: milestone UnlockText is cosmetic guidance; actual gates live in
	VehicleConfig / WeaponConfig / BaseConfig / PrestigeConfig / TerritoryConfig.
]]

export type MilestoneDef = {
	Level: number,
	Title: string,
	UnlockText: string, -- toast on level-up
	HudGoal: string, -- shown until this level is reached (as "next")
	Kind: "Weapon" | "Vehicle" | "Base" | "Territory" | "Prestige" | "Army" | "General",
}

local LevelConfig = {}

LevelConfig.MaxLevel = 100
LevelConfig.MaxLevelBeforePrestige = 100

-- XP rebalance (spec_xp.md): x Scale on XP-to-next up to Knee, straight ramp back to x1.0 at RampEnd.
-- Enabled = false -> exactly floor(100 * L^1.45) (HEAD). Kept in LevelConfig: it must require nothing (BuyPathStatic K1).
-- Totals: L22 75,008 -> 48,750; L30 162,850 -> 122,233; L40 (first rebirth) 332,988 -> 292,371. No level costs more.
LevelConfig.CurveV2 = { Enabled = true, Scale = 0.65, Knee = 21, RampEnd = 30 }

function LevelConfig.CurveMult(level: number): number
	local c = LevelConfig.CurveV2
	if not c.Enabled or level >= c.RampEnd then
		return 1
	end
	if level <= c.Knee then
		return c.Scale
	end
	return c.Scale + (1 - c.Scale) * (level - c.Knee) / (c.RampEnd - c.Knee)
end

function LevelConfig.GetXPRequiredForLevel(level: number): number
	if level < 1 then
		return 0
	end
	if level >= LevelConfig.MaxLevel then
		return math.huge
	end
	local k = LevelConfig.CurveMult(level)
	if k == 1 then
		return math.floor(100 * (level ^ 1.45))
	end
	return math.floor(100 * (level ^ 1.45) * k)
end

function LevelConfig.GetTotalXPForLevel(level: number): number
	local total = 0
	for l = 1, level - 1 do
		total += LevelConfig.GetXPRequiredForLevel(l)
	end
	return total
end

function LevelConfig.GetLevelUpReward(newLevel: number): { Cash: number, Gold: number }
	local cash = 500 + (newLevel * 150)
	local gold = if newLevel % 5 == 0 then math.floor(newLevel / 5) else 0
	return { Cash = cash, Gold = gold }
end

-- Explicit first 20 for designers / BALANCE.md
LevelConfig.Preview = {}
for i = 1, 20 do
	LevelConfig.Preview[i] = {
		Level = i,
		XPToNext = LevelConfig.GetXPRequiredForLevel(i),
		Reward = LevelConfig.GetLevelUpReward(i + 1),
	}
end

--[[
	Ordered milestones. GetNextMilestone(level) returns the first with Level > current.
	Prestige objective: reach PrestigeConfig.MinLevelToPrestige (40) then rebirth.
	Territory objective: capture Central Plaza / any POI (soft goal, not hard gate).
]]
LevelConfig.Milestones = {
	{
		Level = 1,
		Title = "Recruit",
		UnlockText = "Welcome, Commander — claim your base, buy Command Center, recruit soldiers.",
		HudGoal = "GOAL: Claim base → BUY Command Center → Recruit soldiers",
		Kind = "Army",
	},
	{
		Level = 2,
		Title = "Motor Pool",
		UnlockText = "LVL 2 — Utility Quad / Dispatch Car unlock in Garage.",
		HudGoal = "GOAL: Reach L2 · unlock Utility Quad",
		Kind = "Vehicle",
	},
	{
		Level = 3,
		Title = "Assault Rifle",
		UnlockText = "LVL 3 — Assault Rifle unlocked. Buy or equip from combat loadout.",
		HudGoal = "GOAL: Reach L3 · unlock Assault Rifle",
		Kind = "Weapon",
	},
	{
		Level = 4,
		Title = "Scout",
		UnlockText = "LVL 4 — Scout Car + SMG unlock.",
		HudGoal = "GOAL: Reach L4 · Scout Car / SMG",
		Kind = "Vehicle",
	},
	{
		Level = 5,
		Title = "Patrol",
		UnlockText = "LVL 5 — Patrol Truck unlock. Capture Central Plaza for +10% passive cash.",
		HudGoal = "GOAL: Reach L5 · Patrol Truck · capture Central Plaza",
		Kind = "Territory",
	},
	{
		Level = 6,
		Title = "Shotgun + Supply",
		UnlockText = "LVL 6 — Combat Shotgun + Supply Truck unlock.",
		HudGoal = "GOAL: Reach L6 · Shotgun / Supply Truck",
		Kind = "Weapon",
	},
	{
		Level = 8,
		Title = "APC Gate",
		UnlockText = "LVL 8 — APC unlock. Fortify with Defensive Walls when cash allows.",
		HudGoal = "GOAL: Reach L8 · unlock APC",
		Kind = "Vehicle",
	},
	{
		Level = 10,
		Title = "IFV + Sniper",
		UnlockText = "LVL 10 — Combat IFV + Sniper path open. Hold 2 territories for stipends.",
		HudGoal = "GOAL: Reach L10 · IFV · hold 2 territories",
		Kind = "Territory",
	},
	{
		Level = 12,
		Title = "Light Armor",
		UnlockText = "LVL 12 — Light Tank unlock. Push oil rigs for big stipends.",
		HudGoal = "GOAL: Reach L12 · Light Tank · contest an oil rig",
		Kind = "Vehicle",
	},
	{
		Level = 15,
		Title = "Heavy Push",
		UnlockText = "LVL 15 — Heavy Tank / Assault IFV band. Build Helipad for air ops.",
		HudGoal = "GOAL: Reach L15 · Heavy armor · Helipad L1",
		Kind = "Base",
	},
	{
		Level = 20,
		Title = "Air Superiority",
		UnlockText = "LVL 20 — Fighter / CAS jet band. Dominate air + naval docks.",
		HudGoal = "GOAL: Reach L20 · jets · Dock L1",
		Kind = "Vehicle",
	},
	{
		Level = 25,
		Title = "Empire Mid",
		UnlockText = "LVL 25 — Mid-game empire. Max Barracks, stack territory stipends.",
		HudGoal = "GOAL: Reach L25 · Barracks L3+ · 3 territories",
		Kind = "Army",
	},
	{
		Level = 30,
		Title = "War Machine",
		UnlockText = "LVL 30 — Capital vehicles band. Prep Research Lab / Special Forces.",
		HudGoal = "GOAL: Reach L30 · Research Lab · 4 territories",
		Kind = "Base",
	},
	{
		Level = 40,
		Title = "Prestige Ready",
		UnlockText = "LVL 40 — PRESTIGE UNLOCKED. Open Rebirth for +10% cash forever.",
		HudGoal = "GOAL: L40 reached — open Rebirth · Do Prestige (+10% cash)",
		Kind = "Prestige",
	},
	{
		Level = 50,
		Title = "Veteran",
		UnlockText = "LVL 50 — Veteran commander. Push prestige track unlocks.",
		HudGoal = "GOAL: Prestige again · climb rebirth unlock track",
		Kind = "Prestige",
	},
	{
		Level = 75,
		Title = "High Command",
		UnlockText = "LVL 75 — High Command. Max structures, hold forts + oil.",
		HudGoal = "GOAL: Max key structures · hold fortress + oil",
		Kind = "Territory",
	},
	{
		Level = 100,
		Title = "Max Level",
		UnlockText = "LVL 100 — MAX. Prestige to reset level and stack cash mult.",
		HudGoal = "GOAL: Prestige at max · stack +10% cash / rebirth",
		Kind = "Prestige",
	},
} :: { MilestoneDef }

function LevelConfig.GetMilestoneAt(level: number): MilestoneDef?
	local best: MilestoneDef? = nil
	for _, m in ipairs(LevelConfig.Milestones) do
		if m.Level == level then
			return m
		end
		if m.Level < level then
			best = m
		end
	end
	return best
end

function LevelConfig.GetNextMilestone(level: number): MilestoneDef?
	for _, m in ipairs(LevelConfig.Milestones) do
		if m.Level > level then
			return m
		end
	end
	-- At/above last milestone — prestige objective
	return LevelConfig.Milestones[#LevelConfig.Milestones]
end

function LevelConfig.GetHudGoal(level: number): string
	local nxt = LevelConfig.GetNextMilestone(level)
	if not nxt then
		return "GOAL: Prestige for +10% cash · dominate territories"
	end
	if nxt.Level <= level then
		return nxt.HudGoal
	end
	return nxt.HudGoal
end

function LevelConfig.GetUnlockMessage(newLevel: number): string?
	for _, m in ipairs(LevelConfig.Milestones) do
		if m.Level == newLevel then
			return m.UnlockText
		end
	end
	-- Generic every 5 levels
	if newLevel % 5 == 0 then
		return string.format("LVL %d — rank up! Check Garage / Weapons for new unlocks.", newLevel)
	end
	return nil
end

return LevelConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LightingConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 17 (2026-09-29): night readable on phones. Every night value in one place. Live for all players.
	  * Night look (WorldAtmosphere reads this while Enabled; false = WorldConfig.Atmosphere's old night, exactly):
	    raised Ambient / OutdoorAmbient (~ (90, 95, 120) at midnight), a Brightness floor, lighter bluish haze, and a
	    moonlit ColorCorrectionEffect ("WE_NightCC": Brightness +0.05, Contrast +0.1, slight blue tint) faded in by the
	    night share instead of darkening everything. Cycle: full night NightStart..NightEnd with Dusk / Dawn ramps
	    (~42 % of the day counted as night).
	  * Night lights (Server/Modules/NightLights, Workspace.WE_NightLights, outside the dressing folders so the world
	    hygiene budget of 24 dressing lights is untouched): warm streetlights along the Town's two main roads, a ring
	    round the Central Plaza and the Town Square, floodlights at every base gate and hangar, and a light on the
	    plaza flag. PointLight / SpotLight, Range 40-60, Shadows = false, tagged WE_NightLight (on only at night).
	  * Glow (Neon only while night, tag GlowTag): lamp heads, lit town windows (on the real front walls), runway edge
	    markers and the plaza flag. By day they are plain SmoothPlastic.
	  * Low quality (client, QualityGovernor): every light with WE_LowOff (every second one) stays off; the Neon glow
	    still shows.
]]

local LightingConfig = {
	Enabled = true,

	Cycle = { NightEnd = 5, DawnEnd = 6, DuskStart = 19, NightStart = 20 },

	Night = {
		Brightness = 2.0, -- floor: moonlight
		Ambient = Color3.fromRGB(80, 86, 112),
		OutdoorAmbient = Color3.fromRGB(90, 95, 120),
		Density = 0.3,
		Offset = 0.22,
		Color = Color3.fromRGB(84, 96, 128),
		Decay = Color3.fromRGB(52, 62, 96),
		Glare = 0.1,
		Haze = 1.8,
	},
	ColorCorrection = {
		Name = "WE_NightCC",
		Brightness = 0.05, -- at full night (0 by day)
		Contrast = 0.1,
		Saturation = -0.05,
		Tint = Color3.fromRGB(214, 224, 255), -- white by day
	},

	LightTag = "WE_NightLight", -- = WorldConfig.Atmosphere.NightLightTag
	GlowTag = "WE_NightGlow",
	MaxLights = 120,
	LowOffAttribute = "WE_LowOff",

	Street = {
		Color = Color3.fromRGB(255, 196, 120),
		Brightness = 1.4,
		Range = 44,
		PoleHeight = 14,
		Spacing = 48, -- along a road
		Offset = 14, -- from the road centre line (the corridor is 12: never on the lane)
		TownHalf = 320, -- the Town's two main roads (RoadX0 / RoadZ0) inside +-TownHalf
		SkipNearPlaza = 80, -- none inside the Central Plaza ring (its own lamps are the ring below)
	},
	PlazaRing = { Count = 6, Radius = 84, Range = 52, Brightness = 1.3 },
	TownSquare = { X = -150, Z = 150, Half = 40, Range = 48, Brightness = 1.2 },
	Flag = { Pole = "CentralPlaza_FlagPole", Flag = "CentralPlaza_Flag", Range = 40, Brightness = 2, Angle = 70 },
	Base = {
		GateRange = 56,
		GateBrightness = 1.6,
		HangarRange = 60,
		HangarBrightness = 1.5,
		Color = Color3.fromRGB(240, 238, 225),
		RunwayMarkerSpacing = 19, -- plot-local runway (BaseLayoutConfig.Roads "Runway"), both long edges
		RunwayMarkerColor = Color3.fromRGB(255, 200, 90),
	},
	-- claude-bud JOB 54: a base that reads at night. Built per OWNED plot (NightLights.SyncPlot from GateDefenseService's
	-- plot sync: claim / rejoin / restart), owner-first by the plot owner. 4 more night lights per base (helipad flood,
	-- dock flood, the gate-sign lamp, the beacon) -> 7 per base; with 10 plots + the town that is <= MaxLights (the
	-- shared counter refuses past it). Glow-only (no light): helipad corner markers, dock bollards, runway thresholds.
	-- Exposure: the client lifts ExposureCompensation at night (owner-first; 0 by day = today's look).
	Night2 = {
		Enabled = true,
		OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 54): Code Bot flips it after Shaun's phone test
		PerBaseLights = 4, -- the extra night lights per base (the per-base test: 3 + 4 = 7 <= 40)
		Helipad = { At = { 64, -104 }, Toward = { 40, -125 }, Range = 50, Brightness = 1.5, PadHalf = 12, PadColor = Color3.fromRGB(110, 255, 140) },
		Dock = { At = { 98, -72 }, Toward = { 128, -112 }, Range = 56, Brightness = 1.5, BollardX = 101, BollardZ = { -140, -122, -104, -86 }, BollardColor = Color3.fromRGB(255, 210, 120) },
		Sign = { Up = 11, Out = 3.2, Range = 26, Brightness = 2, Angle = 60, Color = Color3.fromRGB(255, 236, 200) },
		Beacon = { At = { 0, 0 }, MastHeight = 34, Range = 22, Brightness = 1.2, Color = Color3.fromRGB(255, 70, 60) }, -- At: plot-local, 0,0 = filled from the plot's rear corner
		Threshold = { Count = 5, Spacing = 5, Start = Color3.fromRGB(90, 255, 120), End = Color3.fromRGB(255, 80, 70) },
		Exposure = { Day = 0, Night = 0.35, RefreshSeconds = 2 },
	},
	Windows = {
		Enabled = true,
		MaxPerBuilding = 6, -- 2 floors x 3 at most
		Size = Vector3.new(2.2, 2.4, 0.15),
		FloorHeight = 5,
		FirstFloorY = 3.5, -- above the ground under the building
		ColumnSpacing = 5,
		LitShare = 0.6, -- deterministic per window
		DayColor = Color3.fromRGB(58, 66, 76),
		NightColor = Color3.fromRGB(255, 214, 140),
	},
}

return LightingConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">LootBoxConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ POLICY-PENDING: random loot boxes are NOT enabled.
	This stub exists so shop/UI can show "coming soon" without grant paths. ]]

local LootBoxConfig = {
	PolicyPending = true,
