            <Item class="ModuleScript" referent="104">
              <Properties>
                <string name="Name">ProgressionBattlePass</string>
                <string name="Source"><![CDATA[--!strict
--[[ Battle Pass track preview rebuild (extracted from ProgressionController). ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local ProgressionUI = require(script.Parent.ProgressionUI)

local ProgressionBattlePass = {}

function ProgressionBattlePass.RebuildTrackPreview(trackList: ScrollingFrame?, bpState: any)
	if not trackList or typeof(bpState) ~= "table" then
		return
	end
	for _, child in ipairs(trackList:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end

	local level = tonumber(bpState.Level) or 0
	local freeTrack = bpState.FreeTrack or {}
	local premTrack = bpState.PremiumTrack or {}
	local claimedFree = bpState.ClaimedFree or {}
	local claimedPrem = bpState.ClaimedPremium or {}
	local premium = bpState.Premium == true

	local tiers: { number } = {}
	local seen: { [number]: boolean } = {}
	for t in pairs(freeTrack) do
		local n = tonumber(t)
		if n and not seen[n] then
			seen[n] = true
			table.insert(tiers, n)
		end
	end
	for t in pairs(premTrack) do
		local n = tonumber(t)
		if n and not seen[n] then
			seen[n] = true
			table.insert(tiers, n)
		end
	end
	table.sort(tiers)

	local rows = 0
	local maxRows = 14
	for _, tier in ipairs(tiers) do
		if rows >= maxRows then
			break
		end
		local freeR = freeTrack[tier] or freeTrack[tostring(tier)]
		local premR = premTrack[tier] or premTrack[tostring(tier)]
		local freeClaimed = claimedFree[tostring(tier)] == true
		local premClaimed = claimedPrem[tostring(tier)] == true
		local reached = tier <= level
		local freeReady = reached and freeR ~= nil and not freeClaimed
		local premReady = reached and premium and premR ~= nil and not premClaimed
		local interesting = freeReady
			or premReady
			or (reached and ((freeR ~= nil and not freeClaimed) or (premR ~= nil and not premClaimed)))
			or (not reached and tier <= level + 6)
		local skip = (not interesting) and (rows > 0 or tier > level + 3)
		if not skip then
			rows += 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -6, 0, 40)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = tier
			row.Parent = trackList
			UIUtil.Corner(row, 4)

			local status = "locked"
			if freeReady or premReady then
				status = "READY"
			elseif reached then
				status = "claimed"
				if (freeR and not freeClaimed) or (premR and not premClaimed and not premium) then
					status = if premium then "partial" else "free done / need Prem"
				end
			end

			local freeTxt = ProgressionUI.FormatReward(freeR)
			local premTxt = ProgressionUI.FormatReward(premR)
			local lab = Instance.new("TextLabel")
			lab.BackgroundTransparency = 1
			lab.Position = UDim2.fromOffset(6, 0)
			lab.Size = UDim2.new(1, -70, 1, 0)
			lab.Font = Enum.Font.Gotham
			lab.TextSize = 11
			lab.TextXAlignment = Enum.TextXAlignment.Left
			lab.TextColor3 = if (freeReady or premReady) then Constants.Colors.Cash else Constants.Colors.Muted
			lab.Text = string.format(
				"L%d  Free:%s  Prem:%s  [%s]",
				tier,
				if freeTxt ~= "" then freeTxt else "-",
				if premTxt ~= "" then premTxt else "-",
				status
			)
			lab.Parent = row

			if freeReady then
				local claimBtn = Instance.new("TextButton")
				claimBtn.AnchorPoint = Vector2.new(1, 0.5)
				claimBtn.Position = UDim2.new(1, -4, 0.5, 0)
				claimBtn.Size = UDim2.fromOffset(64, 36)
				claimBtn.BackgroundColor3 = Constants.Colors.Accent
				claimBtn.Font = Enum.Font.GothamBold
				claimBtn.TextSize = 10
				claimBtn.TextColor3 = Constants.Colors.Text
				claimBtn.Text = "CLAIM"
				claimBtn.BorderSizePixel = 0
				UIUtil.Corner(claimBtn, 4)
				claimBtn.Parent = row
				local claimTier = tier
				UIUtil.EnsureMinTouch(claimBtn, 36)
				claimBtn.Activated:Connect(function()
					Remotes.GetEvent(Constants.RemoteNames.RequestClaimBattlePassReward):FireServer(claimTier, "free")
				end)
			elseif premReady then
				local claimBtn = Instance.new("TextButton")
				claimBtn.AnchorPoint = Vector2.new(1, 0.5)
				claimBtn.Position = UDim2.new(1, -4, 0.5, 0)
				claimBtn.Size = UDim2.fromOffset(64, 36)
				claimBtn.BackgroundColor3 = Constants.Colors.Gold
				claimBtn.Font = Enum.Font.GothamBold
				claimBtn.TextSize = 10
				claimBtn.TextColor3 = Constants.Colors.Background
				claimBtn.Text = "CLAIM"
				claimBtn.BorderSizePixel = 0
				UIUtil.Corner(claimBtn, 4)
				claimBtn.Parent = row
				local claimTier = tier
				UIUtil.EnsureMinTouch(claimBtn, 36)
				claimBtn.Activated:Connect(function()
					Remotes.GetEvent(Constants.RemoteNames.RequestClaimBattlePassReward):FireServer(claimTier, "premium")
				end)
			end
		end
	end

	if rows == 0 then
		UIUtil.EmptyState(
			trackList,
			"No battle pass rows yet — earn XP from gameplay to unlock Free/Premium track rewards.",
			0
		)
	end
end


return ProgressionBattlePass
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="105">
              <Properties>
                <string name="Name">ProgressionUI</string>
                <string name="Source"><![CDATA[--!strict
--[[ Shared Progression UI helpers — reward formatting + debounced refresh. ]]

local ProgressionUI = {}

function ProgressionUI.FormatReward(reward: any): string
	if typeof(reward) ~= "table" then
		return ""
	end
	local parts = {}
	if typeof(reward.Cash) == "number" and reward.Cash > 0 then
		table.insert(parts, string.format("$%d", reward.Cash))
	end
	if typeof(reward.Gold) == "number" and reward.Gold > 0 then
		table.insert(parts, string.format("%dG", reward.Gold))
	end
	return table.concat(parts, " + ")
end

function ProgressionUI.Debounce(seconds: number): ((() -> ()) -> ())
	local token = 0
	return function(fn: () -> ())
		token += 1
		local my = token
		task.delay(seconds, function()
			if my == token then
				fn()
			end
		end)
	end
end

return ProgressionUI
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Lightweight Settings panel — music/SFX local toggles + keybind cheat-sheet.
	Toggle: O key or SETTINGS button (bottom-right).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)

local ClientSettings = require(script.Parent.Parent.Modules.ClientSettings)
local AudioController = require(script.Parent.Parent.Modules.AudioController)

local SettingsController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local open = false
local screenGui: ScreenGui? = nil
local musicBtn: TextButton? = nil
local sfxBtn: TextButton? = nil

local KEYBINDS = {
	"B — Base Upgrades",
	"G — Garage (vehicles)",
	"M — Missions / daily",
	"P — Shop (monetization)",
	"K — Progression (BP / clan / war)",
	"A — Army (soldiers)",
	"O — Settings (this panel)",
	"Codes — Settings redeem row",
	"Spinner — HUD / Settings free reward",
	"LMB — Fire · R — Reload",
	"Sit VehicleSeat — Drive",
}

local function setOpen(isOpen: boolean)
	open = isOpen
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = isOpen
		end
	end
end

local function refreshToggleLabels()
	if musicBtn then
		musicBtn.Text = if ClientSettings.GetMusicEnabled() then "Music: ON" else "Music: OFF"
		musicBtn.BackgroundColor3 = if ClientSettings.GetMusicEnabled() then Constants.Colors.Accent else Constants.Colors.Background
	end
	if sfxBtn then
		sfxBtn.Text = if ClientSettings.GetSfxEnabled() then "SFX: ON" else "SFX: OFF"
		sfxBtn.BackgroundColor3 = if ClientSettings.GetSfxEnabled() then Constants.Colors.Accent else Constants.Colors.Background
	end
end

function SettingsController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireSettings"
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, false)
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	screenGui = screen

	local toggle = Instance.new("TextButton")
	toggle.Name = "SettingsToggle"
	toggle.AnchorPoint = Vector2.new(1, 1)
	toggle.Position = UDim2.new(1, -16, 1, -16)
	toggle.Size = UDim2.fromOffset(96, 44)
	toggle.BackgroundColor3 = Constants.Colors.Panel
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = 12
	toggle.TextColor3 = Constants.Colors.Text
	toggle.Text = "SETTINGS"
	toggle.BorderSizePixel = 0
	toggle.Visible = false -- docked in HUD MobileActionBar
	UIUtil.Corner(toggle, 8)
	UIUtil.Stroke(toggle)
	toggle.Parent = screen
	UIUtil.EnsureMinTouch(toggle, 44)
	toggle.Activated:Connect(function()
		AudioController.PlayClick()
		setOpen(not open)
	end)

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.92, 0, 0.78, 0) else UDim2.fromOffset(400, 560)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screen
	UIUtil.Corner(panel, 10)
	UIUtil.Stroke(panel)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 10)
	title.Size = UDim2.new(1, -80, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Constants.Colors.Text
	title.Text = "Settings"
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -12, 0, 10)
	close.Size = UDim2.fromOffset(48, 48)
	close.BackgroundColor3 = Constants.Colors.Background
	close.Font = Enum.Font.GothamBold
	close.Text = "X"
	close.TextColor3 = Constants.Colors.Text
	close.BorderSizePixel = 0
	UIUtil.Corner(close, 6)
	close.Parent = panel
	UIUtil.EnsureMinTouch(close, 48)
	close.Activated:Connect(function()
		AudioController.PlayClick()
		setOpen(false)
	end)

	local audioNote = Instance.new("TextLabel")
	audioNote.BackgroundTransparency = 1
	audioNote.Position = UDim2.fromOffset(16, 48)
	audioNote.Size = UDim2.new(1, -32, 0, 28)
	audioNote.Font = Enum.Font.Gotham
	audioNote.TextSize = 11
	audioNote.TextWrapped = true
	audioNote.TextXAlignment = Enum.TextXAlignment.Left
	audioNote.TextColor3 = Constants.Colors.Muted
	audioNote.Text = "Music / SFX are local-only (session). Toggles mute/unmute AudioController immediately. Placeholder SoundIds — swap in Studio."
	audioNote.Parent = panel

	musicBtn = Instance.new("TextButton")
	musicBtn.Position = UDim2.fromOffset(16, 88)
	musicBtn.Size = UDim2.fromOffset(160, 44)
	musicBtn.Font = Enum.Font.GothamBold
	musicBtn.TextSize = 13
	musicBtn.TextColor3 = Constants.Colors.Text
	musicBtn.BorderSizePixel = 0
	UIUtil.Corner(musicBtn, 6)
	musicBtn.Parent = panel
	UIUtil.EnsureMinTouch(musicBtn, 44)
	musicBtn.Activated:Connect(function()
		ClientSettings.ToggleMusic()
		refreshToggleLabels()
		AudioController.PlayClick()
	end)

	sfxBtn = Instance.new("TextButton")
	sfxBtn.Position = UDim2.fromOffset(192, 88)
	sfxBtn.Size = UDim2.fromOffset(160, 44)
	sfxBtn.Font = Enum.Font.GothamBold
	sfxBtn.TextSize = 13
	sfxBtn.TextColor3 = Constants.Colors.Text
	sfxBtn.BorderSizePixel = 0
	UIUtil.Corner(sfxBtn, 6)
	sfxBtn.Parent = panel
	UIUtil.EnsureMinTouch(sfxBtn, 44)
	sfxBtn.Activated:Connect(function()
		ClientSettings.ToggleSfx()
		refreshToggleLabels()
		AudioController.PlayClick()
	end)

	-- Promo codes (server-validated, once each)
	local codesTitle = Instance.new("TextLabel")
	codesTitle.BackgroundTransparency = 1
	codesTitle.Position = UDim2.fromOffset(16, 140)
	codesTitle.Size = UDim2.new(1, -32, 0, 20)
	codesTitle.Font = Enum.Font.GothamBold
	codesTitle.TextSize = 14
	codesTitle.TextXAlignment = Enum.TextXAlignment.Left
	codesTitle.TextColor3 = Constants.Colors.Text
	codesTitle.Text = "Redeem code"
	codesTitle.Parent = panel

	local codeBox = Instance.new("TextBox")
	codeBox.Position = UDim2.fromOffset(16, 164)
	codeBox.Size = UDim2.fromOffset(240, 40)
	codeBox.BackgroundColor3 = Constants.Colors.Background
	codeBox.Font = Enum.Font.Gotham
	codeBox.TextSize = 14
	codeBox.TextColor3 = Constants.Colors.Text
	codeBox.PlaceholderText = "WARFOUNDING / BUILDCONQUER"
	codeBox.PlaceholderColor3 = Constants.Colors.Muted
	codeBox.Text = ""
	codeBox.ClearTextOnFocus = false
	codeBox.BorderSizePixel = 0
	UIUtil.Corner(codeBox, 6)
	codeBox.Parent = panel

	local redeemBtn = Instance.new("TextButton")
	redeemBtn.Position = UDim2.fromOffset(268, 164)
	redeemBtn.Size = UDim2.fromOffset(116, 40)
	redeemBtn.BackgroundColor3 = Constants.Colors.Accent
	redeemBtn.Font = Enum.Font.GothamBold
	redeemBtn.TextSize = 13
	redeemBtn.TextColor3 = Constants.Colors.Text
	redeemBtn.Text = "REDEEM"
	redeemBtn.BorderSizePixel = 0
	UIUtil.Corner(redeemBtn, 6)
	redeemBtn.Parent = panel
	UIUtil.EnsureMinTouch(redeemBtn, 44)
	redeemBtn.Activated:Connect(function()
		AudioController.PlayClick()
		local code = codeBox.Text
		if code and #code > 0 then
			Remotes.GetEvent(Constants.RemoteNames.RequestRedeemCode):FireServer(code)
			codeBox.Text = ""
		end
	end)

	local spinnerBtn = Instance.new("TextButton")
	spinnerBtn.Name = "SpinnerClaim"
	spinnerBtn.Position = UDim2.fromOffset(16, 212)
	spinnerBtn.Size = UDim2.new(1, -32, 0, 40)
	spinnerBtn.BackgroundColor3 = Constants.Colors.Accent
	spinnerBtn.Font = Enum.Font.GothamBold
	spinnerBtn.TextSize = 13
	spinnerBtn.TextColor3 = Constants.Colors.Text
	spinnerBtn.Text = "SUPPLY SPINNER — Claim free Cash/Gold"
	spinnerBtn.BorderSizePixel = 0
	UIUtil.Corner(spinnerBtn, 6)
	spinnerBtn.Parent = panel
	UIUtil.EnsureMinTouch(spinnerBtn, 44)
	spinnerBtn.Activated:Connect(function()
		AudioController.PlayClick()
		Remotes.GetEvent(Constants.RemoteNames.RequestClaimSpinner):FireServer()
	end)
	Remotes.GetEvent(Constants.RemoteNames.SpinnerStateUpdate).OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		if payload.Ready == true then
			spinnerBtn.Text = "SUPPLY SPINNER — READY (claim)"
			spinnerBtn.BackgroundColor3 = Constants.Colors.Accent
		else
			local mins = math.ceil((tonumber(payload.CooldownRemaining) or 0) / 60)
			spinnerBtn.Text = string.format("SUPPLY SPINNER — ready in %dm", mins)
			spinnerBtn.BackgroundColor3 = Constants.Colors.Background
		end
	end)

	local bindsTitle = Instance.new("TextLabel")
	bindsTitle.BackgroundTransparency = 1
	bindsTitle.Position = UDim2.fromOffset(16, 260)
	bindsTitle.Size = UDim2.new(1, -32, 0, 22)
	bindsTitle.Font = Enum.Font.GothamBold
	bindsTitle.TextSize = 14
	bindsTitle.TextXAlignment = Enum.TextXAlignment.Left
	bindsTitle.TextColor3 = Constants.Colors.Text
	bindsTitle.Text = "Keybind cheat-sheet"
	bindsTitle.Parent = panel

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 288)
	list.Size = UDim2.new(1, -24, 1, -300)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.Parent = list

	for i, line in ipairs(KEYBINDS) do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, -8, 0, 22)
		row.BackgroundColor3 = Constants.Colors.Background
		row.BackgroundTransparency = 0.35
		row.BorderSizePixel = 0
		row.Font = Enum.Font.Gotham
		row.TextSize = 12
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Constants.Colors.Muted
		row.Text = "  " .. line
		row.LayoutOrder = i
		row.Parent = list
		UIUtil.Corner(row, 4)
	end

	refreshToggleLabels()
	ClientSettings.OnChanged(refreshToggleLabels)

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.O then
			setOpen(not open)
		end
	end)
end


function SettingsController.Toggle()
	setOpen(not open)
end

function SettingsController.Open()
	setOpen(true)
end

function SettingsController.Close()
	setOpen(false)
end

function SettingsController.IsOpen(): boolean
	return open
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Phase 7 — Shop UI. Prompts Marketplace; grants only via server ProcessReceipt / GamePass ownership. ]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)

local ShopController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local menuOpen = false
local screenGui: ScreenGui? = nil

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function setOpen(open: boolean)
	menuOpen = open
	if screenGui then
		local panel = screenGui:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = open
		end
	end
end

local function promptDevProduct(productKey: string)
	local def = MonetizationConfig.DevProducts[productKey]
	if not def then
		return
	end
	-- Ask server to log + validate; client still prompts Marketplace
	Remotes.GetEvent(Constants.RemoteNames.RequestPurchaseDevProduct):FireServer(productKey)
	if def.Id and def.Id ~= 0 then
		MarketplaceService:PromptProductPurchase(player, def.Id)
	else
		warn("[Shop] Product ID placeholder for", productKey, "— set MonetizationConfig DevProduct Ids")
	end
end

local function promptGamePass(passKey: string)
	local def = MonetizationConfig.GamePasses[passKey]
	if not def then
		return
	end
	-- Log intent on server; NEVER treat client confirmation as a grant
	Remotes.GetEvent(Constants.RemoteNames.RequestPurchaseGamePass):FireServer(passKey)
	if def.Id and def.Id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, def.Id)
	else
		warn("[Shop] GamePass ID placeholder for", passKey, "— set MonetizationConfig GamePass Ids")
	end
end

function ShopController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireShop"
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, false)
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	screenGui = screen

	local toggle = Instance.new("TextButton")
	toggle.Name = "ShopToggle"
	toggle.AnchorPoint = Vector2.new(0, 1)
	toggle.Position = UDim2.new(0, 136, 1, -16)
	toggle.Size = UDim2.fromOffset(88, 44)
	toggle.BackgroundColor3 = Constants.Colors.Gunmetal
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = 14
	toggle.TextColor3 = Constants.Colors.Gold
	toggle.Text = "SHOP"
	toggle.BorderSizePixel = 0
	toggle.Visible = false -- docked in HUD MobileActionBar
	corner(toggle, 8)
	local toggleStroke = Instance.new("UIStroke")
	toggleStroke.Color = Constants.Colors.Gold
	toggleStroke.Thickness = 1.5
	toggleStroke.Parent = toggle
	toggle.Parent = screen
	UIUtil.EnsureMinTouch(toggle, 44)
	toggle.Activated:Connect(function()
		setOpen(not menuOpen)
	end)

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = if isTouch then UDim2.new(0.92, 0, 0.72, 0) else UDim2.fromOffset(400, 360)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screen
	corner(panel, 10)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 10)
	title.Size = UDim2.new(1, -80, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Constants.Colors.Text
	title.Text = "Supply Depot"
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -12, 0, 10)
	close.Size = UDim2.fromOffset(48, 48)
	close.BackgroundColor3 = Constants.Colors.Background
	close.Font = Enum.Font.GothamBold
	close.Text = "X"
	close.TextColor3 = Constants.Colors.Text
	close.BorderSizePixel = 0
	corner(close, 6)
	close.Parent = panel
	UIUtil.EnsureMinTouch(close, 48)
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local note = Instance.new("TextLabel")
	note.BackgroundTransparency = 1
	note.Position = UDim2.fromOffset(16, 40)
	note.Size = UDim2.new(1, -32, 0, 32)
	note.Font = Enum.Font.Gotham
	note.TextSize = 11
	note.TextWrapped = true
	note.TextXAlignment = Enum.TextXAlignment.Left
	note.TextColor3 = Constants.Colors.Muted
	note.Text = "IDs are placeholders (0). Server ProcessReceipt / GamePass ownership grants only — never client."
	note.Parent = panel

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(12, 80)
	list.Size = UDim2.new(1, -24, 1, -92)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.Parent = list

	local order = 0
	local function addRow(label: string, sub: string, onClick: () -> (), btnText: string?)
		order += 1
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 56)
		row.BackgroundColor3 = Constants.Colors.Background
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.Parent = list
		corner(row, 6)

		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromOffset(10, 6)
		t.Size = UDim2.new(1, -110, 0, 20)
		t.Font = Enum.Font.GothamBold
		t.TextSize = 14
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextColor3 = Constants.Colors.Text
		t.Text = label
		t.Parent = row

		local s = Instance.new("TextLabel")
		s.BackgroundTransparency = 1
		s.Position = UDim2.fromOffset(10, 28)
		s.Size = UDim2.new(1, -110, 0, 16)
		s.Font = Enum.Font.Gotham
		s.TextSize = 11
		s.TextXAlignment = Enum.TextXAlignment.Left
		s.TextColor3 = Constants.Colors.Muted
		s.Text = sub
		s.Parent = row

		local btn = Instance.new("TextButton")
		btn.AnchorPoint = Vector2.new(1, 0.5)
		btn.Position = UDim2.new(1, -8, 0.5, 0)
		btn.Size = UDim2.fromOffset(if isTouch then 110 else 96, 48)
		btn.BackgroundColor3 = Constants.Colors.Gunmetal
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 11
		btn.TextColor3 = Constants.Colors.Gold
		btn.Text = btnText or "BUY"
		btn.BorderSizePixel = 0
		corner(btn, 6)
		local btnStroke = Instance.new("UIStroke")
		btnStroke.Color = Constants.Colors.Gold
		btnStroke.Thickness = 1.25
		btnStroke.Parent = btn
		btn.Parent = row
		UIUtil.EnsureMinTouch(btn, 44)
		btn.Activated:Connect(onClick)
	end

	for key, def in pairs(MonetizationConfig.DevProducts) do
		local sub = ""
		if def.GrantsBattlePassPremium then
			sub = string.format("Unlocks BP Premium track (id=%d) — grant via ProcessReceipt only", def.Id or 0)
		elseif def.Cash and def.Cash > 0 then
			sub = string.format("$%d  (id=%d)", def.Cash, def.Id or 0)
		elseif def.Gold and def.Gold > 0 then
			sub = string.format("%d Gold  (id=%d)", def.Gold, def.Id or 0)
		else
			sub = string.format("id=%d", def.Id or 0)
		end
		local btnLabel = "BUY"
		if def.Cash and def.Cash > 0 then
			btnLabel = "BUY $" .. tostring(def.Cash)
		elseif def.Gold and def.Gold > 0 then
			btnLabel = "BUY " .. tostring(def.Gold) .. "G"
		elseif def.GrantsBattlePassPremium then
			btnLabel = "BUY BP"
		end
		addRow(def.DisplayName, sub, function()
			promptDevProduct(key)
		end, btnLabel)
	end

	for key, def in pairs(MonetizationConfig.GamePasses) do
		addRow(
			"Pass: " .. def.DisplayName,
			(def.Description or "") .. string.format(" (id=%d)", def.Id or 0),
			function()
				promptGamePass(key)
			end,
			"PASS"
		)
	end

	

	-- Policy-pending loot crates (display only — no purchase/grant path)
	do
		local ok, LootBoxConfig = pcall(function()
			return require(Shared.Configs.LootBoxConfig)
		end)
		if ok and LootBoxConfig and LootBoxConfig.PolicyPending then
			addRow("Supply Crate (locked)", "Random loot policy-pending — not for sale", function()
				warn("[Shop] Loot boxes disabled (policy-pending)")
			end)
		end
	end

	if order == 0 then
		UIUtil.EmptyState(list, "Shop catalog empty — MonetizationConfig has no DevProducts / GamePasses.", 0)
	end

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.P then
			setOpen(not menuOpen)
		end
	end)
end


function ShopController.Toggle()
	setOpen(not menuOpen)
end

function ShopController.Open()
	setOpen(true)
end

function ShopController.Close()
	setOpen(false)
end

function ShopController.IsOpen(): boolean
	return menuOpen
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">TerritoryController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Phase 5/7 — Territory HUD, capture progress, Radar Hill enemy highlights.
	Mobile: larger capture bar, STAND IN ZONE / CONTESTED / PROTECTED status,
	% + ETA, list collapses on touch, clear of dock / pad BUY / combat HP.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local UIUtil = require(Shared.Util.UIUtil)

local TerritoryController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local _gui: ScreenGui? = nil
local progressFrame: Frame? = nil
local progressFill: Frame? = nil
local progressLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local pctLabel: TextLabel? = nil
local alertLabel: TextLabel? = nil
local listFrame: ScrollingFrame? = nil
local listPanel: Frame? = nil
local radarBadge: TextLabel? = nil
local lastAlert = ""
local radarActive = false
local radarRadius = 550
local radarHighlights: { [number]: Highlight } = {}
local lastCapturePct = -1
local listCollapsed = isTouch -- start collapsed on phone

local function setProgressVisible(visible: boolean)
	if progressFrame then
		progressFrame.Visible = visible
	end
end

local function clearRadarHighlights()
	for userId, h in pairs(radarHighlights) do
		if h and h.Parent then
			h:Destroy()
		end
		radarHighlights[userId] = nil
	end
end

local function ensureHighlight(target: Model): Highlight
	local existing = target:FindFirstChild("WE_RadarHighlight")
	if existing and existing:IsA("Highlight") then
		return existing
	end
	local h = Instance.new("Highlight")
	h.Name = "WE_RadarHighlight"
	h.FillColor = Color3.fromRGB(200, 80, 80)
	h.OutlineColor = Color3.fromRGB(255, 180, 80)
	h.FillTransparency = 0.65
	h.OutlineTransparency = 0.15
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = target
	return h
end

local function updateRadar()
	if not radarActive then
		clearRadarHighlights()
		return
	end
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not myRoot then
		clearRadarHighlights()
		return
	end

	local seen: { [number]: boolean } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if char and root and humanoid and humanoid.Health > 0 then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= radarRadius then
					seen[other.UserId] = true
					local h = ensureHighlight(char)
					radarHighlights[other.UserId] = h
				end
			end
		end
	end
	for userId, h in pairs(radarHighlights) do
		if not seen[userId] then
			if h and h.Parent then
				h:Destroy()
			end
			radarHighlights[userId] = nil
		end
	end
end

local function refreshList(payload: Types.TerritoryStatePayload)
	if not listFrame then
		return
	end
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("TextLabel") or child:IsA("Frame") then
			child:Destroy()
		end
	end
	local layout = listFrame:FindFirstChildOfClass("UIListLayout")
	if not layout then
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 2)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = listFrame
	end

	if #payload.Territories == 0 then
		UIUtil.EmptyState(listFrame, "No territories yet — explore the map.", 0)
		return
	end

	for i, entry in ipairs(payload.Territories) do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, -4, 0, if isTouch then 22 else 18)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.Gotham
		row.TextSize = if isTouch then 13 else 12
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Constants.Colors.Text
		row.LayoutOrder = i
		local owner = entry.OwnerType
		if entry.OwnerUserId == player.UserId and entry.OwnerType == "Player" then
			owner = "YOU"
			row.TextColor3 = Constants.Colors.Cash
		elseif entry.Contested then
			owner = "CONTESTED"
			row.TextColor3 = Color3.fromRGB(230, 160, 60)
		elseif entry.OwnerType == "NPC" then
			row.TextColor3 = Constants.Colors.Danger
		elseif entry.OwnerType == "Neutral" or entry.OwnerType == nil then
			row.TextColor3 = Constants.Colors.Muted
			owner = "NEUTRAL"
		end
		row.Text = string.format("%s — %s", entry.DisplayName, owner)
		row.Parent = listFrame
	end
end

local function applyListCollapsed()
	if not listPanel or not listFrame then
		return
	end
	if listCollapsed then
		listPanel.Size = UDim2.fromOffset(if isTouch then 160 else 200, 36)
		listFrame.Visible = false
	else
		listPanel.Size = UDim2.fromOffset(if isTouch then 200 else 200, if isTouch then 160 else 140)
		listFrame.Visible = true
	end
	local toggle = listPanel:FindFirstChild("CollapseToggle")
	if toggle and toggle:IsA("TextButton") then
		toggle.Text = if listCollapsed then "TERRITORIES ▾" else "TERRITORIES ▴"
	end
end

function TerritoryController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireTerritory"
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, false)
	screen.DisplayOrder = 28 -- below combat HUD cluster / pad BUY
	_gui = screen

	-- Capture progress — above pad BUY (-108) and combat HP (-188 on touch)
	local prog = Instance.new("Frame")
	prog.Name = "CaptureProgress"
	prog.AnchorPoint = Vector2.new(0.5, 1)
	prog.Position = UDim2.new(0.5, 0, 1, if isTouch then -250 else -120)
	prog.Size = UDim2.fromOffset(if isTouch then 340 else 300, if isTouch then 78 else 52)
	prog.BackgroundColor3 = Constants.Colors.Panel
	prog.BackgroundTransparency = 0.05
	prog.BorderSizePixel = 0
	prog.Visible = false
	prog.ZIndex = 12
	prog.Parent = screen
	UIUtil.Corner(prog, 10)
	UIUtil.Stroke(prog, Constants.Colors.Gold, 2)
	progressFrame = prog

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(12, 6)
	title.Size = UDim2.new(1, -90, 0, if isTouch then 20 else 18)
	title.Font = Enum.Font.GothamBold
	title.TextSize = if isTouch then 15 else 13
	title.TextColor3 = Constants.Colors.Text
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "Capturing..."
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Parent = prog
	progressLabel = title

	local pct = Instance.new("TextLabel")
	pct.Name = "Pct"
	pct.BackgroundTransparency = 1
	pct.AnchorPoint = Vector2.new(1, 0)
	pct.Position = UDim2.new(1, -12, 0, 6)
	pct.Size = UDim2.fromOffset(72, if isTouch then 22 else 18)
	pct.Font = Enum.Font.GothamBold
	pct.TextSize = if isTouch then 18 else 14
	pct.TextColor3 = Constants.Colors.Gold
	pct.TextXAlignment = Enum.TextXAlignment.Right
	pct.Text = "0%"
	pct.Parent = prog
	pctLabel = pct

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Position = UDim2.fromOffset(12, if isTouch then 28 else 24)
	status.Size = UDim2.new(1, -24, 0, 16)
	status.Font = Enum.Font.GothamBold
	status.TextSize = if isTouch then 12 else 11
	status.TextColor3 = Color3.fromRGB(200, 210, 140)
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Text = "STAND IN THE ZONE"
	status.Parent = prog
	statusLabel = status

	local bg = Instance.new("Frame")
	bg.Position = UDim2.fromOffset(12, if isTouch then 50 else 36)
	bg.Size = UDim2.new(1, -24, 0, if isTouch then 18 else 14)
	bg.BackgroundColor3 = Constants.Colors.Background
	bg.BorderSizePixel = 0
	bg.Parent = prog
	UIUtil.Corner(bg, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(200, 180, 60)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	UIUtil.Corner(fill, 4)
	progressFill = fill

	-- Alert toast
	local alert = Instance.new("TextLabel")
	alert.Name = "TerritoryAlert"
	alert.AnchorPoint = Vector2.new(0.5, 0)
	alert.Position = UDim2.new(0.5, 0, 0, if isTouch then 72 else 100)
	alert.Size = UDim2.fromOffset(if isTouch then 340 else 360, if isTouch then 32 else 28)
	alert.BackgroundTransparency = 1
	alert.Font = Enum.Font.GothamBold
	alert.TextSize = if isTouch then 15 else 16
	alert.TextColor3 = Color3.fromRGB(230, 200, 80)
	alert.Text = ""
	alert.TextStrokeTransparency = 0.5
	alert.Parent = screen
	alertLabel = alert

	-- Radar active badge
	local badge = Instance.new("TextLabel")
	badge.Name = "RadarBadge"
	badge.AnchorPoint = Vector2.new(0, 0)
	badge.Position = UDim2.fromOffset(16, if isTouch then 56 else 248)
	badge.Size = UDim2.fromOffset(200, 20)
	badge.BackgroundTransparency = 1
	badge.Font = Enum.Font.GothamBold
	badge.TextSize = 11
	badge.TextXAlignment = Enum.TextXAlignment.Left
	badge.TextColor3 = Color3.fromRGB(180, 120, 220)
	badge.Text = ""
	badge.Visible = false
	badge.Parent = screen
	radarBadge = badge

	-- Compact territory list (left) — collapsible on mobile
	local panel = Instance.new("Frame")
	panel.Name = "TerritoryList"
	panel.Position = UDim2.fromOffset(16, if isTouch then 80 else 100)
	panel.Size = UDim2.fromOffset(200, 140)
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BackgroundTransparency = 0.25
	panel.BorderSizePixel = 0
	panel.Parent = screen
	UIUtil.Corner(panel, 8)
	UIUtil.Stroke(panel)
	listPanel = panel

	local toggle = Instance.new("TextButton")
	toggle.Name = "CollapseToggle"
	toggle.BackgroundTransparency = 1
	toggle.Size = UDim2.new(1, -8, 0, 28)
	toggle.Position = UDim2.fromOffset(4, 4)
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = if isTouch then 13 else 12
	toggle.TextXAlignment = Enum.TextXAlignment.Left
	toggle.TextColor3 = Constants.Colors.Muted
	toggle.Text = "TERRITORIES"
	toggle.AutoButtonColor = true
	toggle.Parent = panel
	UIUtil.EnsureMinTouch(toggle, 28)
	toggle.Activated:Connect(function()
		listCollapsed = not listCollapsed
		applyListCollapsed()
	end)

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.fromOffset(4, 32)
	list.Size = UDim2.new(1, -8, 1, -36)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = if isTouch then 5 else 3
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = panel
	listFrame = list
	applyListCollapsed()

	local applyToken = 0
	Remotes.GetEvent(Constants.RemoteNames.TerritoryStateUpdate).OnClientEvent:Connect(function(payload: Types.TerritoryStatePayload)
		applyToken += 1
		local my = applyToken
		task.delay(0.1, function()
			if my == applyToken then
				TerritoryController.Apply(payload)
			end
		end)
	end)

	local radarAccum = 0
	RunService.Heartbeat:Connect(function(dt)
		if not radarActive then
			return
		end
		radarAccum += dt
		if radarAccum >= 0.2 then
			radarAccum = 0
			updateRadar()
		end
	end)

	Players.PlayerRemoving:Connect(function(leaving)
		local h = radarHighlights[leaving.UserId]
		if h then
			h:Destroy()
			radarHighlights[leaving.UserId] = nil
		end
	end)
end

function TerritoryController.Apply(payload: Types.TerritoryStatePayload)
	refreshList(payload)

	radarActive = payload.RadarReveal == true
	radarRadius = tonumber(payload.RadarRadius) or TerritoryConfig.RadarRevealRadius or 220
	if radarBadge then
		radarBadge.Visible = radarActive
		radarBadge.Text = if radarActive then string.format("RADAR ACTIVE · %dstud", math.floor(radarRadius)) else ""
	end
	if not radarActive then
		clearRadarHighlights()
	end

	local localCap = payload.LocalCapture
	if localCap and localCap.Capturing and localCap.TerritoryId then
		setProgressVisible(true)
		local def = TerritoryConfig.Territories[localCap.TerritoryId]
		local name = if def then def.DisplayName else localCap.TerritoryId
		local pct = math.floor(localCap.Progress * 100)
		local contested = localCap.Contested == true
		local protected = localCap.Protected == true
		if progressLabel then
			progressLabel.Text = string.format("Capturing %s", name)
		end
		if pctLabel then
			pctLabel.Text = string.format("%d%%", pct)
		end
		if statusLabel then
			if contested then
				statusLabel.Text = "CONTESTED — clear enemies!"
				statusLabel.TextColor3 = Color3.fromRGB(230, 140, 60)
			elseif protected then
				statusLabel.Text = "PROTECTED — capture slowed"
				statusLabel.TextColor3 = Color3.fromRGB(140, 180, 255)
			else
				statusLabel.Text = "STAND IN THE ZONE — don't leave"
				statusLabel.TextColor3 = Color3.fromRGB(200, 210, 140)
			end
		end
		if progressFill then
			progressFill.Size = UDim2.fromScale(math.clamp(localCap.Progress, 0, 1), 1)
			local t = math.clamp(localCap.Progress, 0, 1)
			if contested then
				progressFill.BackgroundColor3 = Color3.fromRGB(230, 120, 50)
			else
				progressFill.BackgroundColor3 = Color3.fromRGB(200 - 40 * t, 180 + 50 * t, 60)
			end
		end
		if progressFrame then
			local stroke = progressFrame:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = if contested then Color3.fromRGB(230, 120, 50) else Constants.Colors.Gold
			end
		end
		-- Milestone toast at 50% / 90%
		if alertLabel and pct ~= lastCapturePct then
			if pct >= 90 and lastCapturePct < 90 then
				alertLabel.Text = "Almost captured — stay in zone!"
			elseif pct >= 50 and lastCapturePct < 50 then
				alertLabel.Text = "Capture halfway..."
			end
			lastCapturePct = pct
		end
	else
		setProgressVisible(false)
		lastCapturePct = -1
	end

	local owned = 0
	for _, entry in ipairs(payload.Territories) do
		if entry.OwnerUserId == player.UserId and entry.OwnerType == "Player" then
			owned += 1
		end
	end
	local msg = if owned > 0 then string.format("Outposts held: %d", owned) else ""
	if alertLabel and msg ~= "" and msg ~= lastAlert and lastCapturePct < 0 then
		lastAlert = msg
		alertLabel.Text = msg
		task.delay(3, function()
			if alertLabel and alertLabel.Text == msg then
				alertLabel.Text = ""
			end
		end)
	end
end

return TerritoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Interactive tutorial UI: claim base → command center → income → barracks → jeep → outpost
	Skip button; waypoints/highlights are best-effort via StudioSetup WE_TutorialMarker placeholders.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local TutorialConfig = require(Shared.Configs.TutorialConfig)

local TutorialController = {}

local player = Players.LocalPlayer
local _gui: ScreenGui? = nil
local panel: Frame? = nil
local titleLabel: TextLabel? = nil
local hintLabel: TextLabel? = nil
local progressLabel: TextLabel? = nil
local beam: Beam? = nil
local attach0: Attachment? = nil
local attach1: Attachment? = nil
local highlightPart: BasePart? = nil
local currentMarkerName: string? = nil

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function clearWaypoint()
	if beam then
		beam:Destroy()
		beam = nil
	end
	if attach0 then
		attach0:Destroy()
		attach0 = nil
	end
	if attach1 then
		attach1:Destroy()
		attach1 = nil
	end
	if highlightPart then
		local stroke = highlightPart:FindFirstChild("WE_TutorialHighlight")
		if stroke then
			stroke:Destroy()
		end
		highlightPart = nil
	end
	currentMarkerName = nil
end

local function findMarker(markerName: string?): BasePart?
	if not markerName or markerName == "" then
		return nil
	end
	-- Prefer CollectionService tag
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.TutorialMarker)) do
		if inst:IsA("BasePart") and (inst.Name == markerName or inst:GetAttribute("TutorialStepId") == markerName) then
			return inst
		end
	end
	-- Fallback: search under WarEmpireSetup
	local root = Workspace:FindFirstChild("WarEmpireSetup")
	if root then
		local found = root:FindFirstChild(markerName, true)
		if found and found:IsA("BasePart") then
			return found
		end
	end
	local any = Workspace:FindFirstChild(markerName, true)
	if any and any:IsA("BasePart") then
		return any
	end
	return nil
end

local function setWaypoint(markerName: string?)
	clearWaypoint()
	if not markerName then
		return
	end
	currentMarkerName = markerName
	local target = findMarker(markerName)
	if not target then
		return
	end
	highlightPart = target
	local sel = Instance.new("SelectionBox")
	sel.Name = "WE_TutorialHighlight"
	sel.Adornee = target
	sel.Color3 = Constants.Colors.Gold
	sel.LineThickness = 0.05
	sel.Parent = target

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return
	end

	attach0 = Instance.new("Attachment")
	attach0.Name = "WE_TutAtt0"
	attach0.Parent = hrp
	attach1 = Instance.new("Attachment")
	attach1.Name = "WE_TutAtt1"
	attach1.Parent = target

	beam = Instance.new("Beam")
	beam.Name = "WE_TutorialBeam"
	beam.Attachment0 = attach0
	beam.Attachment1 = attach1
	beam.FaceCamera = true
	beam.Width0 = 0.4
	beam.Width1 = 0.4
	beam.Color = ColorSequence.new(Constants.Colors.Gold)
	beam.Transparency = NumberSequence.new(0.25)
	beam.Parent = hrp
end

local function setVisible(open: boolean)
	if panel then
		panel.Visible = open
	end
	if not open then
		clearWaypoint()
	end
end

local lastAnnouncedId: string? = nil

local function applyState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	if payload.Complete == true then
		setVisible(false)
		clearWaypoint()
		lastAnnouncedId = nil
		return
	end
	setVisible(true)
	if titleLabel then
		titleLabel.Text = tostring(payload.Title or "Tutorial")
	end
	if hintLabel then
		hintLabel.Text = tostring(payload.Hint or "")
	end
	if progressLabel then
		local step = tonumber(payload.Step) or 0
		local total = tonumber(payload.Total) or TutorialConfig.StepCount()
		progressLabel.Text = string.format("Step %d / %d", math.clamp(step, 1, total), total)
	end
	setWaypoint(payload.MarkerName)

	-- One-shot polish toast for first buy / first income steps
	local id = if typeof(payload.Id) == "string" then payload.Id else nil
	if id and id ~= lastAnnouncedId then
		lastAnnouncedId = id
		if id == "CommandCenter" then
			print("[Tutorial] Step CommandCenter — walk pad / tap BUY / B menu")
		elseif id == "Income" then
			print("[Tutorial] Step Income — watch HUD +$/tick")
		end
	end
end

function TutorialController.Init()
	local pg = player:WaitForChild("PlayerGui")
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireTutorial"
	screen.DisplayOrder = 20
	screen.Parent = pg
	UIUtil.PrepareScreen(screen, false)
	_gui = screen

	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	frame.AnchorPoint = Vector2.new(0.5, 1)
	-- Lift above pad BUY button (~108 from bottom) + mobile dock
	frame.Position = UDim2.new(0.5, 0, 1, -196)
	frame.Size = UDim2.fromOffset(440, 118)
	frame.BackgroundColor3 = Constants.Colors.Panel
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = screen
	panel = frame
	corner(frame, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Constants.Colors.Accent
	stroke.Thickness = 2
	stroke.Parent = frame

	local prog = Instance.new("TextLabel")
	prog.Name = "Progress"
	prog.BackgroundTransparency = 1
	prog.Position = UDim2.fromOffset(14, 8)
	prog.Size = UDim2.new(1, -120, 0, 16)
	prog.Font = Enum.Font.Gotham
	prog.TextSize = 12
	prog.TextXAlignment = Enum.TextXAlignment.Left
	prog.TextColor3 = Constants.Colors.Muted
	prog.Text = ""
	prog.Parent = frame
	progressLabel = prog

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(14, 28)
	title.Size = UDim2.new(1, -120, 0, 22)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 16
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Constants.Colors.Text
	title.Text = "Tutorial"
	title.Parent = frame
	titleLabel = title

	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.Position = UDim2.fromOffset(14, 52)
	hint.Size = UDim2.new(1, -120, 0, 48)
	hint.Font = Enum.Font.Gotham
	hint.TextSize = 13
	hint.TextWrapped = true
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextYAlignment = Enum.TextYAlignment.Top
	hint.TextColor3 = Constants.Colors.Muted
	hint.Text = ""
	hint.Parent = frame
	hintLabel = hint

	local skip = Instance.new("TextButton")
	skip.Name = "Skip"
	skip.AnchorPoint = Vector2.new(1, 0)
	skip.Position = UDim2.new(1, -12, 0, 10)
	skip.Size = UDim2.fromOffset(72, 28)
	skip.BackgroundColor3 = Constants.Colors.Background
	skip.Font = Enum.Font.GothamBold
	skip.TextSize = 12
	skip.TextColor3 = Constants.Colors.Text
	skip.Text = "SKIP"
	skip.BorderSizePixel = 0
	corner(skip, 6)
	skip.Parent = frame
	UIUtil.EnsureMinTouch(skip, 44)
	skip.Activated:Connect(function()
		print("[Tutorial] SKIP pressed")
		Remotes.GetEvent(Constants.RemoteNames.RequestSkipTutorial):FireServer()
	end)

	-- Soft pulse on panel when shown
	task.spawn(function()
		while screen.Parent do
			if frame.Visible then
				local tw = TweenService:Create(stroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
					Transparency = 0.55,
				})
				tw:Play()
				while frame.Visible and screen.Parent do
					task.wait(0.5)
				end
				tw:Cancel()
				stroke.Transparency = 0
			end
			task.wait(0.25)
		end
	end)

	Remotes.GetEvent(Constants.RemoteNames.TutorialStateUpdate).OnClientEvent:Connect(applyState)

	-- Also hide soft-complete from PlayerStateUpdate
	Remotes.GetEvent(Constants.RemoteNames.PlayerStateUpdate).OnClientEvent:Connect(function(state: any)
		if typeof(state) == "table" and state.TutorialComplete == true then
			setVisible(false)
			clearWaypoint()
		end
	end)

	player.CharacterAdded:Connect(function()
		-- Re-bind beam to new character if tutorial active
		if currentMarkerName and panel and panel.Visible then
			task.defer(function()
				setWaypoint(currentMarkerName)
			end)
		end
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Root UI coordinator — wires mobile action dock after panel controllers Init. ]]

local UIController = {}

local AudioController = require(script.Parent.Parent.Modules.AudioController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local BaseController = require(script.Parent.BaseController)
local TutorialController = require(script.Parent.TutorialController)
local TerritoryController = require(script.Parent.TerritoryController)
local MissionController = require(script.Parent.MissionController)
local ShopController = require(script.Parent.ShopController)
local ProgressionController = require(script.Parent.ProgressionController)
local ArmyController = require(script.Parent.ArmyController)
local SettingsController = require(script.Parent.SettingsController)
local WorldPromptController = require(script.Parent.WorldPromptController)
local CompassController = require(script.Parent.CompassController)

function UIController.Init()
	AudioController.Init()
	HUDController.Init()
	-- Notifications before Base so first-join toasts have a stack ready.
	NotificationController.Init()
	BaseController.Init()
	TutorialController.Init()
	TerritoryController.Init()
	MissionController.Init()
	ShopController.Init()
	ProgressionController.Init()
	ArmyController.Init()
	SettingsController.Init()
	WorldPromptController.Init()
	CompassController.Init()

	-- Mobile advanced dock: large color-coded tiles (Shop / Rebirth / Orders / Army / Settings)
	-- Inspiration-only layout quality — keep WAR EMPIRE hotkeys (P/K/M/A/O).
	local function dockPress(label: string, toggleFn: () -> ())
		print("[WAR EMPIRE] Dock pressed:", label)
		NotificationController.Show(label .. " opened", "Info", 1.6)
		pcall(AudioController.PlayClick)
		local ok, err = pcall(toggleFn)
		if not ok then
			warn("[WAR EMPIRE] Dock Toggle failed:", label, err)
			NotificationController.Show(label .. " failed — check Output", "Warn", 3)
		end
	end

	HUDController.BindActionBar({
		{
			Name = "DockBase",
			Icon = "🏗",
			Label = "BASE",
			Color = Color3.fromRGB(50, 160, 110),
			OnClick = function()
				dockPress("Base", BaseController.Toggle)
			end,
		},
		{
			Name = "DockShop",
			Icon = "🛒",
			Label = "SHOP",
			Color = Color3.fromRGB(230, 170, 50),
			OnClick = function()
				dockPress("Shop", ShopController.Toggle)
			end,
		},
		{
			Name = "DockRebirth",
			Icon = "♻",
			Label = "REBIRTH",
			Color = Color3.fromRGB(150, 90, 220),
			OnClick = function()
				dockPress("Rebirth", ProgressionController.Toggle)
			end,
		},
		{
			Name = "DockOrders",
			Icon = "📋",
			Label = "ORDERS",
			Color = Color3.fromRGB(70, 160, 220),
			OnClick = function()
				dockPress("Orders", MissionController.Toggle)
			end,
		},
		{
			Name = "DockArmy",
			Icon = "⚔",
			Label = "ARMY",
			Color = Color3.fromRGB(90, 140, 70),
			OnClick = function()
				dockPress("Army", ArmyController.Toggle)
			end,
		},
		{
			Name = "DockSettings",
			Icon = "⚙",
			Label = "SETTINGS",
			Color = Color3.fromRGB(70, 78, 90),
			OnClick = function()
				dockPress("Settings", SettingsController.Toggle)
			end,
		},
	})
	print("[WAR EMPIRE] UIController: action dock bound (Base/Shop/Rebirth/Orders/Army/Settings)")
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">VehicleController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Phase 4/7 — Garage UI (G). Spawn / buy / despawn requests only.
	Category + rarity + Owned filters for large roster (~99). ScrollingFrame AutomaticCanvasSize.
	Empty states via UIUtil.EmptyState. MobileScale via UIUtil.PrepareScreen.
	Mobile: ≥48px filter chips, ≥52px row actions, Activated (not MouseButton1 only),
	responsive panel, clear empty / filter-empty / no-owned banners.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local Types = require(Shared.Types)
local VehicleConfig = require(Shared.Configs.VehicleConfig)

local AudioController = require(script.Parent.Parent.Modules.AudioController)

local VehicleController = {}

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled

local screenGui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local cooldownLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local panelFrame: Frame? = nil
local isOpen = false

local ownedMap: { [string]: boolean } = {}
local activeId: string? = nil
local cooldownLeft = 0
local filterCategory: string = "All" -- All | Ground | Air | Naval
local filterRarity: string = "All" -- All | Common | Uncommon | Rare | Epic | Legendary
local filterOwnedOnly = false
local rarityColors: { [string]: Color3 } = {
	Common = Color3.fromRGB(160, 165, 170),
	Uncommon = Color3.fromRGB(90, 180, 110),
	Rare = Color3.fromRGB(80, 140, 220),
	Epic = Color3.fromRGB(170, 90, 220),
	Legendary = Color3.fromRGB(230, 170, 60),
}

local function addCorner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function addStroke(parent: Instance, color: Color3?, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(55, 65, 55)
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

local function sortedIds(): { string }
	local ids = {}
	for id, def in pairs(VehicleConfig.Vehicles) do
		local cat = if def then (def.Category or "Ground") else "Ground"
		local rar = if def then (def.Rarity or "Common") else "Common"
		local catOk = filterCategory == "All" or cat == filterCategory
		local rarOk = filterRarity == "All" or rar == filterRarity
		local ownedOk = not filterOwnedOnly or ownedMap[id] == true
		if catOk and rarOk and ownedOk then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		local da = VehicleConfig.Vehicles[a]
		local db = VehicleConfig.Vehicles[b]
		local la = da and da.UnlockLevel or 0
		local lb = db and db.UnlockLevel or 0
		if la == lb then
			return a < b
		end
		return la < lb
	end)
	return ids
end

local function ownedCount(): number
	local n = 0
	for _ in pairs(ownedMap) do
		n += 1
	end
	return n
end

local function catalogCount(): number
	local n = 0
	for _ in pairs(VehicleConfig.Vehicles) do
		n += 1
	end
	return n
end

local function bindTap(btn: GuiButton, fn: () -> ())
	btn.Activated:Connect(function()
		AudioController.PlayClick()
		fn()
	end)
end

local function refresh()
	if not listFrame then
		return
	end
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end
	if not listFrame:FindFirstChildOfClass("UIListLayout") then
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, if isTouch then 8 else 6)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = listFrame
	end

	local ids = sortedIds()
	local ownedN = ownedCount()
	local catalogN = catalogCount()

	if statusLabel then
		statusLabel.Text = string.format(
			"%d shown · %d owned · %d in catalog%s",
			#ids,
			ownedN,
			catalogN,
			if filterOwnedOnly then " · OWNED filter" else ""
		)
	end

	if catalogN == 0 then
		UIUtil.EmptyState(listFrame, "Garage empty — no vehicles configured yet.", 0)
		if cooldownLabel then
			cooldownLabel.Text = if cooldownLeft > 0
				then string.format("Spawn cooldown: %.0fs", cooldownLeft)
				else "Spawn ready"
		end
		return
	end

	if #ids == 0 then
		local msg = if filterOwnedOnly
			then "No owned vehicles match these filters — turn off OWNED or pick All."
			else "No vehicles match these filters — tap All / clear rarity."
		UIUtil.EmptyState(listFrame, msg, 0)
		if cooldownLabel then
			cooldownLabel.Text = if cooldownLeft > 0
				then string.format("Spawn cooldown: %.0fs", cooldownLeft)
				else "Spawn ready"
		end
		return
	end

	-- Friendly empty banner when nothing owned yet (full catalog still listed below)
	if ownedN == 0 and not filterOwnedOnly then
		UIUtil.EmptyState(
			listFrame,
			"No owned vehicles yet — tap gold BUY, then SPAWN. Starter Jeep syncs after join.",
			0
		)
	elseif ownedN > 0 and filterOwnedOnly == false then
		-- soft tip only when filters hide all owned
		local ownedVisible = 0
		for _, id in ipairs(ids) do
			if ownedMap[id] then
				ownedVisible += 1
			end
		end
		if ownedVisible == 0 then
			UIUtil.EmptyState(
				listFrame,
				"None of your rides match these filters — tap OWNED or All to find them.",
				0
			)
		end
	end

	local rowH = if isTouch then 92 else 78
	local btnW = if isTouch then 118 else 100
	local btnH = if isTouch then 52 else 44

	for i, id in ipairs(ids) do
		local def = VehicleConfig.Vehicles[id]
		if def then
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -8, 0, rowH)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = i
			row.Parent = listFrame
			addCorner(row, 8)

			local rarBar = Instance.new("Frame")
			rarBar.Size = UDim2.new(0, 4, 1, -8)
			rarBar.Position = UDim2.fromOffset(4, 4)
			rarBar.BorderSizePixel = 0
			rarBar.BackgroundColor3 = rarityColors[def.Rarity] or Constants.Colors.Muted
			rarBar.Parent = row
			addCorner(rarBar, 2)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromOffset(14, 4)
			title.Size = UDim2.new(1, -(btnW + 28), 0, 18)
			title.Font = Enum.Font.GothamBold
			title.TextSize = if isTouch then 15 else 14
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.TextColor3 = Constants.Colors.Text
			title.Text = def.DisplayName
			title.TextTruncate = Enum.TextTruncate.AtEnd
			title.Parent = row

			local cat = def.Category or "Ground"
			local catCol = if cat == "Air"
				then Constants.Colors.CategoryAir
				elseif cat == "Naval" then Constants.Colors.CategoryNaval
				else Constants.Colors.CategoryGround
			local chipY = 24
			local function makeChip(label: string, color: Color3, x: number): number
				local chip = Instance.new("Frame")
				chip.Size = UDim2.fromOffset(58, 16)
				chip.Position = UDim2.fromOffset(x, chipY)
				chip.BackgroundColor3 = color
				chip.BorderSizePixel = 0
				chip.Parent = row
				addCorner(chip, 4)
				local lab = Instance.new("TextLabel")
				lab.BackgroundTransparency = 1
				lab.Size = UDim2.fromScale(1, 1)
				lab.Font = Enum.Font.GothamBold
				lab.TextSize = 9
				lab.TextColor3 = Color3.fromRGB(12, 14, 16)
				lab.Text = label
				lab.Parent = chip
				return x + 62
			end
			local nextX = makeChip(string.upper(string.sub(cat, 1, 3)), catCol, 14)
			makeChip(string.upper(string.sub(def.Rarity or "Common", 1, 4)), rarityColors[def.Rarity] or Constants.Colors.Muted, nextX)

			local meta = Instance.new("TextLabel")
			meta.BackgroundTransparency = 1
			meta.Position = UDim2.fromOffset(14, if isTouch then 46 else 42)
			meta.Size = UDim2.new(1, -(btnW + 28), 0, if isTouch then 36 else 26)
			meta.Font = Enum.Font.Gotham
			meta.TextSize = if isTouch then 12 else 11
			meta.TextXAlignment = Enum.TextXAlignment.Left
			meta.TextYAlignment = Enum.TextYAlignment.Top
			meta.TextColor3 = Constants.Colors.Muted
			meta.TextWrapped = true
			local req = ""
			if def.RequiresStructure then
				req = string.format(
					" | %s L%d",
					def.RequiresStructure.StructureId,
					def.RequiresStructure.Level
				)
			end
			if typeof(def.RequiresPrestige) == "number" and (def.RequiresPrestige :: number) > 0 then
				req ..= string.format(" | P%d+", def.RequiresPrestige :: number)
			end
			if typeof(def.RequiresRebirthFlag) == "string" and (def.RequiresRebirthFlag :: string) ~= "" then
				req ..= " | Rebirth"
			end
			meta.Text = string.format(
				"Lv %d · $%s · Spd %d%s",
				def.UnlockLevel,
				tostring(def.CostCash),
				def.Speed,
				req
			)
			meta.Parent = row

			local btn = Instance.new("TextButton")
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -10, 0.5, 0)
			btn.Size = UDim2.fromOffset(btnW, btnH)
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = if isTouch then 14 else 13
			btn.TextColor3 = Constants.Colors.Text
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = true
			btn.Active = true
			btn.Parent = row
			addCorner(btn, 8)
			UIUtil.EnsureMinTouch(btn, if isTouch then 48 else 44)

			if activeId == id then
				btn.Text = "DESPAWN"
				btn.BackgroundColor3 = Constants.Colors.Danger
				bindTap(btn, function()
					Remotes.GetEvent(Constants.RemoteNames.RequestDespawnVehicle):FireServer()
				end)
			elseif ownedMap[id] then
				btn.Text = if cooldownLeft > 0 then string.format("%.0fs", cooldownLeft) else "SPAWN"
				btn.BackgroundColor3 = Constants.Colors.Accent
				bindTap(btn, function()
					Remotes.GetEvent(Constants.RemoteNames.RequestSpawnVehicle):FireServer(id)
				end)
			else
				local price = def.CostCash or 0
				btn.Text = if price <= 0 then "CLAIM" else ("BUY $" .. tostring(price))
				btn.BackgroundColor3 = Constants.Colors.Gold
				btn.TextColor3 = Color3.fromRGB(20, 22, 18)
				bindTap(btn, function()
					Remotes.GetEvent(Constants.RemoteNames.RequestPurchaseVehicle):FireServer(id)
				end)
			end
		end
	end

	if cooldownLabel then
		cooldownLabel.Text = if cooldownLeft > 0
			then string.format("Spawn cooldown: %.0fs", cooldownLeft)
			else "Spawn ready"
	end
end

local function setOpen(value: boolean)
	isOpen = value
	if screenGui then
		screenGui.Enabled = true -- keep ScreenGui alive so GARAGE CTA stays clickable
		local panel = screenGui:FindFirstChild("GaragePanel")
		if panel and panel:IsA("GuiObject") then
			panel.Visible = value
		end
	end
	if value then
		refresh()
	end
end

local function buildGui()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireGarage"
	screen.Enabled = true
	screen.Parent = player:WaitForChild("PlayerGui")
	UIUtil.PrepareScreen(screen, false)
	screen.DisplayOrder = 60 -- above HUD dock (55); panels must not open behind HUD
	screenGui = screen

	local panel = Instance.new("Frame")
	panel.Name = "GaragePanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	-- Phone-friendly: use scale with max offset so it fits portrait
	if isTouch then
		panel.Size = UDim2.new(0.94, 0, 0.82, 0)
	else
		panel.Size = UDim2.fromOffset(540, 560)
	end
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = screen
	panelFrame = panel
	addCorner(panel, 10)
	local gst = Instance.new("UIStroke")
	gst.Color = Constants.Colors.Gold
	gst.Thickness = 1.5
	gst.Transparency = 0.35
	gst.Parent = panel
	local sizeCon = Instance.new("UISizeConstraint")
	sizeCon.MaxSize = Vector2.new(560, 640)
	sizeCon.MinSize = Vector2.new(280, 360)
	sizeCon.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(16, 12)
	title.Size = UDim2.new(1, -100, 0, 28)
	title.Font = Enum.Font.GothamBold
	title.TextSize = if isTouch then 20 else 22
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Constants.Colors.Text
	title.Text = "GARAGE"
	title.Parent = panel

	local closeBtn = Instance.new("TextButton")
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -12, 0, 12)
	closeBtn.Size = UDim2.fromOffset(if isTouch then 48 else 44, if isTouch then 48 else 44)
	closeBtn.Text = "X"
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 16
	closeBtn.TextColor3 = Constants.Colors.Text
	closeBtn.BackgroundColor3 = Constants.Colors.Background
	closeBtn.BorderSizePixel = 0
	closeBtn.Parent = panel
	addCorner(closeBtn, 6)
	UIUtil.EnsureMinTouch(closeBtn, 44)
	bindTap(closeBtn, function()
		setOpen(false)
	end)

	local cd = Instance.new("TextLabel")
	cd.BackgroundTransparency = 1
	cd.Position = UDim2.fromOffset(16, 44)
	cd.Size = UDim2.new(1, -32, 0, 16)
	cd.Font = Enum.Font.Gotham
	cd.TextSize = 12
	cd.TextXAlignment = Enum.TextXAlignment.Left
	cd.TextColor3 = Constants.Colors.Muted
	cd.Text = "Spawn ready"
	cd.Parent = panel
	cooldownLabel = cd

	local status = Instance.new("TextLabel")
	status.Name = "StatusLine"
	status.BackgroundTransparency = 1
	status.Position = UDim2.fromOffset(16, 60)
	status.Size = UDim2.new(1, -32, 0, 14)
	status.Font = Enum.Font.Gotham
	status.TextSize = 11
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextColor3 = Constants.Colors.Muted
	status.Text = ""
	status.Parent = panel
	statusLabel = status

	local chipH = if isTouch then 36 else 28
	local filters = Instance.new("Frame")
	filters.Name = "Filters"
	filters.Position = UDim2.fromOffset(12, 78)
	filters.Size = UDim2.new(1, -24, 0, chipH)
	filters.BackgroundTransparency = 1
	filters.Parent = panel
	local layoutF = Instance.new("UIListLayout")
	layoutF.FillDirection = Enum.FillDirection.Horizontal
	layoutF.Padding = UDim.new(0, 5)
	layoutF.Parent = filters
	local function paintCatFilters()
		for _, child in ipairs(filters:GetChildren()) do
			if child:IsA("TextButton") then
				local name = string.gsub(child.Name, "Filter_", "")
				if name == "Owned" then
					child.BackgroundColor3 = if filterOwnedOnly then Constants.Colors.Gold else Constants.Colors.Background
					child.TextColor3 = if filterOwnedOnly then Color3.fromRGB(20, 22, 18) else Constants.Colors.Text
				else
					child.BackgroundColor3 = if name == filterCategory then Constants.Colors.Accent else Constants.Colors.Background
					child.TextColor3 = Constants.Colors.Text
				end
			end
		end
	end
	for _, cat in ipairs({ "All", "Ground", "Air", "Naval" }) do
		local fb = Instance.new("TextButton")
		fb.Name = "Filter_" .. cat
		fb.Size = UDim2.fromOffset(if isTouch then 72 else 70, chipH - 2)
		fb.Font = Enum.Font.GothamBold
		fb.TextSize = if isTouch then 12 else 11
		fb.Text = cat:upper()
		fb.TextColor3 = Constants.Colors.Text
		fb.BorderSizePixel = 0
		fb.AutoButtonColor = true
		addCorner(fb, 6)
		fb.Parent = filters
		UIUtil.EnsureMinTouch(fb, if isTouch then 36 else 28)
		bindTap(fb, function()
			filterCategory = cat
			paintCatFilters()
			refresh()
		end)
	end
	-- OWNED toggle chip
	local ownedChip = Instance.new("TextButton")
	ownedChip.Name = "Filter_Owned"
	ownedChip.Size = UDim2.fromOffset(if isTouch then 78 else 72, chipH - 2)
	ownedChip.Font = Enum.Font.GothamBold
	ownedChip.TextSize = if isTouch then 12 else 11
	ownedChip.Text = "OWNED"
	ownedChip.TextColor3 = Constants.Colors.Text
	ownedChip.BorderSizePixel = 0
	ownedChip.AutoButtonColor = true
	ownedChip.BackgroundColor3 = Constants.Colors.Background
	addCorner(ownedChip, 6)
	ownedChip.Parent = filters
	UIUtil.EnsureMinTouch(ownedChip, if isTouch then 36 else 28)
	bindTap(ownedChip, function()
		filterOwnedOnly = not filterOwnedOnly
		paintCatFilters()
		refresh()
	end)
	paintCatFilters()

	local rarFilters = Instance.new("Frame")
	rarFilters.Name = "RarityFilters"
	rarFilters.Position = UDim2.fromOffset(12, 78 + chipH + 6)
	rarFilters.Size = UDim2.new(1, -24, 0, if isTouch then 32 else 26)
	rarFilters.BackgroundTransparency = 1
	rarFilters.Parent = panel
	local layoutR = Instance.new("UIListLayout")
	layoutR.FillDirection = Enum.FillDirection.Horizontal
	layoutR.Padding = UDim.new(0, 4)
	layoutR.Parent = rarFilters
	local rarList = { "All", "Common", "Uncommon", "Rare", "Epic", "Legendary" }
	if typeof(VehicleConfig.Rarities) == "table" then
		rarList = { "All" }
		for _, r in ipairs(VehicleConfig.Rarities) do
			table.insert(rarList, r)
		end
	end
	local function paintRarity()
		for _, child in ipairs(rarFilters:GetChildren()) do
			if child:IsA("TextButton") then
				local name = string.gsub(child.Name, "Rarity_", "")
				child.BackgroundColor3 = if name == filterRarity
					then (rarityColors[name] or Constants.Colors.Accent)
					else Constants.Colors.Background
			end
		end
	end
	for _, rar in ipairs(rarList) do
		local rb = Instance.new("TextButton")
		rb.Name = "Rarity_" .. rar
		rb.Size = UDim2.fromOffset(if rar == "Legendary" then 78 else (if isTouch then 64 else 60), if isTouch then 30 else 24)
		rb.Font = Enum.Font.GothamBold
		rb.TextSize = if isTouch then 11 else 10
		rb.Text = if rar == "All" then "ALL ★" else string.upper(string.sub(rar, 1, 3))
		rb.TextColor3 = Constants.Colors.Text
		rb.BorderSizePixel = 0
		rb.AutoButtonColor = true
		addCorner(rb, 5)
		rb.Parent = rarFilters
		UIUtil.EnsureMinTouch(rb, if isTouch then 30 else 24)
		bindTap(rb, function()
			filterRarity = rar
			paintRarity()
			refresh()
		end)
	end
	paintRarity()

	local listTop = 78 + chipH + 6 + (if isTouch then 36 else 30) + 8
	local scroll = Instance.new("ScrollingFrame")
	scroll.Position = UDim2.fromOffset(12, listTop)
	scroll.Size = UDim2.new(1, -24, 1, -(listTop + 36))
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ElasticBehavior = Enum.ElasticBehavior.Always
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if isTouch then 6 else 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = panel
	listFrame = scroll

	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.AnchorPoint = Vector2.new(0, 1)
	hint.Position = UDim2.new(0, 16, 1, -10)
	hint.Size = UDim2.new(1, -32, 0, 18)
	hint.Font = Enum.Font.Gotham
	hint.TextSize = if isTouch then 11 else 12
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextColor3 = Constants.Colors.Muted
	hint.Text = if isTouch
		then "Tap BUY → SPAWN · filters · E on pad · DriverSeat"
		else "G · Cat + Rarity + OWNED · scroll · E on pad · DriverSeat"
	hint.Parent = panel

	local garageBtn = Instance.new("TextButton")
	garageBtn.Name = "GarageToggle"
	garageBtn.AnchorPoint = Vector2.new(0, 1)
	-- Bottom-left, above currency pill / clear of right dock
	garageBtn.Position = UDim2.new(0, 16, 1, -88)
	garageBtn.Size = UDim2.fromOffset(if isTouch then 120 else 110, if isTouch then 48 else 44)
	garageBtn.BackgroundColor3 = Constants.Colors.Gunmetal
	garageBtn.Text = "GARAGE"
	garageBtn.Font = Enum.Font.GothamBold
	garageBtn.TextSize = 14
	garageBtn.TextColor3 = Constants.Colors.Gold
	garageBtn.BorderSizePixel = 0
	garageBtn.Active = true
	garageBtn.ZIndex = 25
	garageBtn.Parent = screen
	addCorner(garageBtn, 8)
	addStroke(garageBtn, Constants.Colors.Gold, 1.5)
	UIUtil.EnsureMinTouch(garageBtn, 44)
	garageBtn.Activated:Connect(function()
		AudioController.PlayClick()
		print("[WAR EMPIRE] Garage CTA toggled →", not isOpen)
		setOpen(not isOpen)
	end)
end

function VehicleController.Open()
	setOpen(true)
end

function VehicleController.Close()
	setOpen(false)
end

function VehicleController.Toggle()
	setOpen(not isOpen)
end

function VehicleController.IsOpen(): boolean
	return isOpen
end

function VehicleController.Init()
	buildGui()

	Remotes.GetEvent(Constants.RemoteNames.VehicleStateUpdate).OnClientEvent:Connect(
		function(payload: Types.VehicleStatePayload)
			ownedMap = payload.Owned or {}
			activeId = payload.ActiveVehicleId
			cooldownLeft = payload.CooldownRemaining or 0
			if isOpen then
				refresh()
			end
		end
	)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			setOpen(not isOpen)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if cooldownLeft > 0 then
				local prev = cooldownLeft
				cooldownLeft = math.max(0, cooldownLeft - 0.5)
				if isOpen and listFrame then
					-- Soft update: avoid full list rebuild every tick on large roster
					if cooldownLabel then
						cooldownLabel.Text = if cooldownLeft > 0
							then string.format("Spawn cooldown: %.0fs", cooldownLeft)
							else "Spawn ready"
					end
					if cooldownLeft == 0 or math.floor(prev) ~= math.floor(cooldownLeft) then
						-- Rebuild when crossing whole seconds or hitting ready (button labels)
						refresh()
					end
				end
			end
		end
	end)
end

return VehicleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">WorldPromptController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	World interactivity for StudioSetup-tagged parts.

	Upgrade pads (WE_UpgradeSlot):
	  PRIMARY UX (mobile): large bottom ScreenGui BUY button while standing on
	  own-plot pad → RequestPurchaseUpgrade (Activated / touch).
	  BACKUP: walk-over auto-purchase — Touched + Heartbeat overlap (debounced).
	  Server UpgradePadService remains authoritative walk-over path. Never grants on client.
	Edge cases: respawn clears overlap; seated-in-vehicle skips buy; multi-part
	touch uses pad keys; plot reassignment clears state; standing retry after
	debounce for failed-purchase UX. Prompt/Touched connections disconnect on
	part destroy. BillboardGuis throttled refresh on Base/Economy updates.
	Billboard subtitle: "Stand or tap BUY". Hide BUY for leave / wrong plot / MAX / prereq.

	ProximityPrompts only for non-buy actions (Open Base, Open Garage, capture ping, tutorial).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local BaseController = require(script.Parent.BaseController)
local VehicleController = require(script.Parent.VehicleController)
local NotificationController = require(script.Parent.NotificationController)
local UIUtil = require(Shared.Util.UIUtil)

local WorldPromptController = {}

local PROMPT_NAME = "WE_WorldPrompt"
local BILLBOARD_NAME = "WE_PriceBillboard"
local DEBOUNCE_SEC = 1.1 -- mobile standing-retry; still under server rate (6/8s)
local OVERLAP_MARGIN = 2.4 -- generous pad hitbox for mobile walk-over
local BILLBOARD_THROTTLE = 0.35 -- perf: avoid refreshing every economy tick frame
local PRICE_BILLBOARD_MAX_DIST = 48 -- near-only (was 650) — mobile screen clutter
local PRICE_BILLBOARD_SIZE = UDim2.fromOffset(220, 108) -- room for cost + +$/tick + BUY hint
local BUY_GUI_NAME = "WE_PadBuyGui"
local BUY_BTN_MIN_H = 72

local player = Players.LocalPlayer
local upgrades: { [string]: number } = {}
local cash = 0
local myPlotId: number? = nil
local attachedPrompt: { [Instance]: boolean } = {}
local slotParts: { [BasePart]: boolean } = {}
local slotConns: { [BasePart]: { RBXScriptConnection } } = {}
local promptConns: { [Instance]: { RBXScriptConnection } } = {}
local lastPurchaseAt: { [string]: number } = {} -- keyed by structureId (server rate is global)
local lastOverlap: { [string]: boolean } = {} -- keyed by padKey (plot|structure)
local pendingPurchase: { [string]: boolean } = {} -- structureId in-flight
local billboardDirty = false
local lastBillboardRefresh = 0
local overlapConn: RBXScriptConnection? = nil
local tagsBound = false
local maxToastAt: { [string]: number } = {} -- throttle MAX toasts while camping
local _buyGui: ScreenGui? = nil
local buyBtn: TextButton? = nil
local activeBuyStructureId: string? = nil
local activeBuyPart: BasePart? = nil

local function padKey(part: BasePart, structureId: string): string
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" then
		return tostring(pid) .. "|" .. structureId
	end
	return structureId
end

local function trackConn(bucket: { [Instance]: { RBXScriptConnection } }, owner: Instance, conn: RBXScriptConnection)
	local list = bucket[owner]
	if not list then
		list = {}
		bucket[owner] = list
	end
	table.insert(list, conn)
end

local function disconnectAll(bucket: { [Instance]: { RBXScriptConnection } }, owner: Instance)
	local list = bucket[owner]
	if not list then
		return
	end
	for _, c in ipairs(list) do
		c:Disconnect()
	end
	bucket[owner] = nil
end

local function makePrompt(parent: BasePart, actionText: string, objectText: string, hold: number?, maxDist: number?): ProximityPrompt
	local existing = parent:FindFirstChild(PROMPT_NAME)
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = maxDist or 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = parent
	return prompt
end

local function formatCost(cost: number): string
	if cost >= 1_000_000 then
		return string.format("$%.1fM", cost / 1_000_000)
	elseif cost >= 10_000 then
		return string.format("$%dk", math.floor(cost / 1000))
	end
	return "$" .. tostring(cost)
end

local function incomePerLevel(structureId: string): number
	local rates = EconomyConfig.PassiveIncome and EconomyConfig.PassiveIncome.PerLevelRates
	if typeof(rates) ~= "table" then
		return 0
	end
	return tonumber(rates[structureId]) or 0
end

local function formatIncomeRate(structureId: string): string?
	local rate = incomePerLevel(structureId)
	if rate <= 0 then
		return nil
	end
	return string.format("+$%d/tick", rate)
end

local structureInfo: (structureId: string) -> (string, number, number?, boolean, string?)
local tryPurchase: (structureId: string, opts: { silentMax: boolean }?) -> ()
local isSeatedInVehicle: () -> boolean
local isOwnPlotPad: (part: BasePart) -> boolean


local padBuyFlashToken = 0
local lastPadLevels: { [string]: number } = {}
local function flashPadBuyBought(displayName: string)
	local btn = buyBtn
	if not btn or not btn.Visible then
		return
	end
	padBuyFlashToken += 1
	local my = padBuyFlashToken
	btn.Text = string.format("BOUGHT %s ✓", displayName)
	btn.BackgroundColor3 = Color3.fromRGB(30, 70, 40)
	btn.TextColor3 = Constants.Colors.Cash
	-- Standing Heartbeat refreshPadBuyButton rewrites label after flash window
	task.delay(1.0, function()
		if my ~= padBuyFlashToken then
			return
		end
		-- no-op; next pad refresh overwrites
	end)
end

local function hidePadBuyButton()
	activeBuyStructureId = nil
	activeBuyPart = nil
	if buyBtn then
		buyBtn.Visible = false
	end
end

local function ensurePadBuyGui(): TextButton
	if buyBtn and buyBtn.Parent then
		return buyBtn
	end
	local pg = player:WaitForChild("PlayerGui")
	local existing = pg:FindFirstChild(BUY_GUI_NAME)
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end

	local screen = Instance.new("ScreenGui")
	screen.Name = BUY_GUI_NAME
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	-- Above HUD dock (55); below modal panels (60+)
	screen.DisplayOrder = 56
	screen.Parent = pg
	UIUtil.AttachMobileScale(screen, 800, 0.75, 1.2)
	_buyGui = screen

	local btn = Instance.new("TextButton")
	btn.Name = "BuyButton"
	btn.AnchorPoint = Vector2.new(0.5, 1)
	btn.Position = UDim2.new(0.5, 0, 1, -108)
	btn.Size = UDim2.fromOffset(360, BUY_BTN_MIN_H)
	btn.BackgroundColor3 = Color3.fromRGB(40, 32, 10)
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 26
	btn.TextColor3 = Constants.Colors.Gold
	btn.TextStrokeTransparency = 0.55
	btn.Text = "BUY"
	btn.Visible = false
	btn.Active = true
	btn.Selectable = true
	btn.ZIndex = 40
	btn.Parent = screen
	UIUtil.Corner(btn, 16)
	local stroke = UIUtil.GoldStroke(btn, 3)
	stroke.Transparency = 0.05
	UIUtil.EnsureMinTouch(btn, BUY_BTN_MIN_H)

	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.Size = UDim2.new(1, -12, 0, 18)
	gloss.Position = UDim2.fromOffset(6, 6)
	gloss.BackgroundColor3 = Color3.fromRGB(255, 230, 140)
	gloss.BackgroundTransparency = 0.78
	gloss.BorderSizePixel = 0
	gloss.Active = false
	gloss.ZIndex = 41
	gloss.Parent = btn
	UIUtil.Corner(gloss, 10)

	btn.Activated:Connect(function()
		local sid = activeBuyStructureId
		if typeof(sid) ~= "string" then
			return
		end
		local display, _level, cost, isMax, prereqHint = structureInfo(sid)
		if isMax or prereqHint or cost == nil then
			hidePadBuyButton()
			return
		end
		-- Intentional tap: clear walk-over debounce so BUY always fires
		lastPurchaseAt[sid] = 0
		pendingPurchase[sid] = nil
		NotificationController.Show(string.format("Buying %s…", display), "Info", 1.5)
		print(string.format("[WorldPrompt] BUY button tap → RequestPurchaseUpgrade %s cost=%s", sid, tostring(cost)))
		tryPurchase(sid)
	end)

	buyBtn = btn
	return btn
end

local function refreshPadBuyButton(part: BasePart?, structureId: string?)
	if part == nil or structureId == nil then
		hidePadBuyButton()
		return
	end
	if isSeatedInVehicle() then
		hidePadBuyButton()
		return
	end
	if not isOwnPlotPad(part) then
		hidePadBuyButton()
		return
	end

	local display, _level, cost, isMax, prereqHint = structureInfo(structureId)
	if isMax or prereqHint or cost == nil then
		hidePadBuyButton()
		return
	end

	local btn = ensurePadBuyGui()
	activeBuyStructureId = structureId
	activeBuyPart = part
	local canAfford = cash >= cost
	local incomeStr = formatIncomeRate(structureId)
	if not canAfford then
		local need = cost - cash
		if incomeStr then
			btn.Text = string.format("NEED %s · %s · %s", formatCost(cost), display, incomeStr)
		else
			btn.Text = string.format("NEED %s more · %s", formatCost(need), display)
		end
	elseif incomeStr then
		btn.Text = string.format("BUY %s · %s · %s", display, formatCost(cost), incomeStr)
	else
		btn.Text = string.format("BUY %s · %s", display, formatCost(cost))
	end
	btn.TextColor3 = if canAfford then Constants.Colors.Gold else Color3.fromRGB(255, 170, 170)
	btn.BackgroundColor3 = if canAfford then Color3.fromRGB(48, 38, 8) else Color3.fromRGB(48, 22, 22)
	btn.AutoButtonColor = canAfford
	btn.Visible = true
end

function structureInfo(structureId: string): (string, number, number?, boolean, string?)
	local def = BaseConfig.Structures[structureId]
	local display = if def then def.DisplayName else structureId
	local level = upgrades[structureId] or 0
	if not def then
		return display, level, nil, false, nil
	end
	if level >= def.MaxLevel then
		return display, level, nil, true, nil
	end
	local prereqHint: string? = nil
	if def.Requires then
		for _, req in ipairs(def.Requires) do
			local have = upgrades[req.StructureId] or 0
			if have < req.Level then
				local reqDef = BaseConfig.Structures[req.StructureId]
				local reqName = if reqDef then reqDef.DisplayName else req.StructureId
				prereqHint = string.format("Needs %s L%d", reqName, req.Level)
				break
			end
		end
	end
	local nextLevel = level + 1
	local cost = def.Costs[nextLevel]
	return display, level, cost, false, prereqHint
end

local function setBillboardNearOnly(bb: BillboardGui)
	bb.Size = PRICE_BILLBOARD_SIZE
	bb.StudsOffset = Vector3.new(0, 5.2, 0)
	bb.MaxDistance = PRICE_BILLBOARD_MAX_DIST
	-- AlwaysOnTop only helps when already near (short MaxDistance); avoid map-wide stack
	bb.AlwaysOnTop = true
end

local function hidePriceBillboard(part: BasePart)
	local existing = part:FindFirstChild(BILLBOARD_NAME)
	if existing and existing:IsA("BillboardGui") then
		existing.Enabled = false
	end
	-- MapSetup non-price Label billboards on other parts are left alone
end

local function ensurePriceBillboard(part: BasePart): BillboardGui
	local existing = part:FindFirstChild(BILLBOARD_NAME)
	if existing and existing:IsA("BillboardGui") then
		setBillboardNearOnly(existing)
		existing.Enabled = true
		return existing
	end
	local legacy = part:FindFirstChild("Label")
	if legacy and legacy:IsA("BillboardGui") then
		legacy.Name = BILLBOARD_NAME
		setBillboardNearOnly(legacy)
		legacy.Enabled = true
		return legacy
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = BILLBOARD_NAME
	setBillboardNearOnly(bb)
	bb.Parent = part

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(10, 12, 14)
	backdrop.BackgroundTransparency = 0.12
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Color = Constants.Colors.Gold
	stroke.Thickness = 2
	stroke.Transparency = 0.15
	stroke.Parent = backdrop

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Constants.Colors.Text
	label.TextStrokeTransparency = 0.45
	label.Text = "…"
	label.Parent = backdrop
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = backdrop

	return bb
end

local function applyBillboardCopy(
	bb: BillboardGui,
	titleLine: string,
	detailLine: string,
	textColor: Color3,
	strokeColor: Color3
)
	local stroke = bb:FindFirstChild("Stroke", true)
	if stroke and stroke:IsA("UIStroke") then
		stroke.Color = strokeColor
	end

	-- MapSetup price cards use Title + Cost; client-created use Text
	local titleLab = bb:FindFirstChild("Title", true)
	local costLab = bb:FindFirstChild("Cost", true)
	local textLab = bb:FindFirstChild("Text", true)

	if titleLab and titleLab:IsA("TextLabel") and costLab and costLab:IsA("TextLabel") then
		titleLab.Text = titleLine
		titleLab.TextColor3 = Color3.fromRGB(245, 245, 248)
		costLab.Text = detailLine
		costLab.TextColor3 = textColor
	elseif textLab and textLab:IsA("TextLabel") then
		if detailLine ~= "" then
			textLab.Text = titleLine .. "\n" .. detailLine
		else
			textLab.Text = titleLine
		end
		textLab.TextColor3 = textColor
	end
end

function isOwnPlotPad(part: BasePart): boolean
	-- Hide / skip refresh for other players' plots once we know our PlotId
	if myPlotId == nil then
		return true -- loading / solo until assigned
	end
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) ~= "number" then
		return true
	end
	return pid == myPlotId
end

local function refreshSlotBillboard(part: BasePart)
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end

	if not isOwnPlotPad(part) then
		hidePriceBillboard(part)
		return
	end

	local bb = ensurePriceBillboard(part)
	local display, level, cost, isMax, prereqHint = structureInfo(structureId)

	local incomeStr = formatIncomeRate(structureId)
	local incomeLine = if incomeStr then (" · " .. incomeStr) else ""

	if isMax then
		local ownedIncome = if incomePerLevel(structureId) > 0
			then string.format("  +$%d/tick", incomePerLevel(structureId) * level)
			else ""
		applyBillboardCopy(
			bb,
			display,
			string.format("Lv %d  MAX%s", level, ownedIncome),
			Constants.Colors.Muted,
			Color3.fromRGB(70, 80, 70)
		)
	elseif prereqHint then
		local costStr = if cost then formatCost(cost) else ""
		applyBillboardCopy(
			bb,
			display,
			string.format("Lv %d → %d %s%s\n%s", level, level + 1, costStr, incomeLine, prereqHint),
			Color3.fromRGB(200, 170, 120),
			Color3.fromRGB(160, 130, 70)
		)
	elseif cost then
		local canAfford = cash >= cost
		applyBillboardCopy(
			bb,
			display,
			string.format("Lv %d → %d  %s%s\nStand or tap BUY", level, level + 1, formatCost(cost), incomeLine),
			if canAfford then Constants.Colors.Gold else Color3.fromRGB(220, 140, 140),
			if canAfford then Constants.Colors.Gold else Color3.fromRGB(160, 70, 70)
		)
	else
		applyBillboardCopy(bb, display, incomeStr or "", Constants.Colors.Text, Constants.Colors.Gold)
	end
end

local function refreshAllBillboardsNow()
	lastBillboardRefresh = os.clock()
	billboardDirty = false
	local stale: { BasePart } = {}
	for part in pairs(slotParts) do
		if part.Parent then
			refreshSlotBillboard(part)
		else
			table.insert(stale, part)
		end
	end
	for _, part in ipairs(stale) do
		slotParts[part] = nil
		disconnectAll(slotConns, part)
	end
	-- Keep BUY label/cost in sync while camping the pad
	if activeBuyPart and activeBuyStructureId and activeBuyPart.Parent then
		refreshPadBuyButton(activeBuyPart, activeBuyStructureId)
	end
end

local function markBillboardsDirty()
	billboardDirty = true
end

function isSeatedInVehicle(): boolean
	local char = player.Character
	if not char then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local seat = hum.SeatPart
	if seat == nil then
		return false
	end
	-- Any seat (VehicleSeat or passenger Seat) — driving over pads must not buy
	if seat:IsA("VehicleSeat") or seat:IsA("Seat") then
		return true
	end
	return false
end

function tryPurchase(structureId: string, opts: { silentMax: boolean }?)
	local now = os.clock()
	local last = lastPurchaseAt[structureId] or 0
	if now - last < DEBOUNCE_SEC then
		return
	end
	if pendingPurchase[structureId] then
		print("[WorldPrompt] BUY skip in-flight", structureId)
		return
	end

	local display, _level, cost, isMax, prereqHint = structureInfo(structureId)
	if isMax then
		lastPurchaseAt[structureId] = now
		local silent = opts and opts.silentMax
		local lastMax = maxToastAt[structureId] or 0
		if not silent and (now - lastMax) >= 8 then
			maxToastAt[structureId] = now
			NotificationController.Show("Already MAX", "Info", 2)
			print("[WorldPrompt] BUY FAIL MAX", structureId)
		end
		return
	end
	if prereqHint then
		lastPurchaseAt[structureId] = now
		if not (opts and opts.silentMax) then
			NotificationController.Show(prereqHint, "Warn", 3)
			print("[WorldPrompt] BUY FAIL prereq", structureId, prereqHint)
		end
		return
	end
	if cost and cash < cost and not (opts and opts.silentMax) then
		-- Soft client hint; server still authoritative
		NotificationController.Show(string.format("Need %s for %s", formatCost(cost), display), "Warn", 2.5)
		print(string.format("[WorldPrompt] BUY soft-fail cash %s have=%d need=%s", structureId, cash, tostring(cost)))
	end

	lastPurchaseAt[structureId] = now
	pendingPurchase[structureId] = true
	print(string.format("[WorldPrompt] FireServer RequestPurchaseUpgrade %s cost=%s cash=%d", structureId, tostring(cost), cash))
	Remotes.GetEvent(Constants.RemoteNames.RequestPurchaseUpgrade):FireServer({
		StructureId = structureId,
	} :: Types.PurchaseUpgradeRequest)
	-- Clear in-flight after debounce (server toast handles success/fail UX)
	task.delay(DEBOUNCE_SEC, function()
		pendingPurchase[structureId] = nil
	end)
end

local function pointInPad(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	return math.abs(localPos.X) <= half.X + OVERLAP_MARGIN
		and math.abs(localPos.Z) <= half.Z + OVERLAP_MARGIN
		and localPos.Y >= -half.Y - 3
		and localPos.Y <= half.Y + 8
end

local function isOwnPlot(part: BasePart): boolean
	if myPlotId == nil then
		return true -- until plot assigned, allow (solo / loading)
	end
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) ~= "number" then
		return true
	end
	return pid == myPlotId
end

local function onEnterPad(part: BasePart, structureId: string, fromStandingRetry: boolean?)
	if isSeatedInVehicle() then
		return
	end
	local key = padKey(part, structureId)
	if not isOwnPlot(part) then
		local now = os.clock()
		local last = lastPurchaseAt[structureId] or 0
		if now - last >= DEBOUNCE_SEC then
			lastPurchaseAt[structureId] = now
			NotificationController.Show("Not your base — walk your plot pads to buy", "Warn", 2.5)
		end
		lastOverlap[key] = true
		return
	end
	if lastOverlap[key] and not fromStandingRetry then
		return
	end
	lastOverlap[key] = true
	tryPurchase(structureId, { silentMax = fromStandingRetry == true })
end

local function onLeavePad(key: string)
	lastOverlap[key] = false
end

local function detachUpgradeSlot(part: BasePart)
	disconnectAll(slotConns, part)
	slotParts[part] = nil
end

local function attachUpgradeSlot(part: BasePart)
	if slotParts[part] then
		return
	end
	slotParts[part] = true
	part.CanTouch = true -- walk-over buy must receive Touched

	local existing = part:FindFirstChild(PROMPT_NAME)
	if existing then
		existing:Destroy()
	end

	refreshSlotBillboard(part)

	trackConn(slotConns, part, part.Touched:Connect(function(hit)
		local char = player.Character
		if not char then
			return
		end
		-- Multi-part: only accept character descendants (any body part)
		if not hit:IsDescendantOf(char) then
			return
		end
		local structureId = part:GetAttribute("StructureId")
		if typeof(structureId) == "string" then
			onEnterPad(part, structureId)
		end
	end))

	trackConn(slotConns, part, part.TouchEnded:Connect(function(hit)
		local char = player.Character
		if not char then
			return
		end
		if not hit:IsDescendantOf(char) then
			return
		end
		local structureId = part:GetAttribute("StructureId")
		if typeof(structureId) ~= "string" then
			return
		end
		local key = padKey(part, structureId)
		task.defer(function()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and pointInPad(hrp.Position, part) then
				-- Another character part still overlapping — keep overlap
				return
			end
			onLeavePad(key)
		end)
	end))

	trackConn(slotConns, part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			detachUpgradeSlot(part)
		end
	end))
end

local function attachPromptOnce(part: BasePart, build: () -> ProximityPrompt, onTriggered: () -> ())
	if attachedPrompt[part] then
		return
	end
	attachedPrompt[part] = true
	local prompt = build()
	trackConn(promptConns, part, prompt.Triggered:Connect(function(who)
		if who ~= player then
			return
		end
		onTriggered()
	end))
	trackConn(promptConns, part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			disconnectAll(promptConns, part)
			attachedPrompt[part] = nil
		end
	end))
end

local function attachBasePlot(part: BasePart)
	local plotId = part:GetAttribute("PlotId")
	local label = if typeof(plotId) == "number" then ("Base Plot " .. tostring(plotId)) else "Base"
	attachPromptOnce(part, function()
		return makePrompt(part, "Open Base", label, 0, 14)
	end, function()
		BaseController.Open()
	end)
end

local function attachCaptureZone(part: BasePart)
	local territoryId = part:GetAttribute("TerritoryId")
	local idStr = if typeof(territoryId) == "string" then territoryId else part.Name
	attachPromptOnce(part, function()
		return makePrompt(part, "Hold to capture", idStr, 0.4, 18)
	end, function()
		Remotes.GetEvent(Constants.RemoteNames.RequestCaptureTerritory):FireServer(idStr)
		NotificationController.Show("Stand in the zone to capture — progress fills while you hold ground.", "Info", 3.5)
	end)
end

local function attachVehicleSpawn(part: BasePart)
	attachPromptOnce(part, function()
		return makePrompt(part, "Open Garage", "Vehicle Pad", 0, 12)
	end, function()
		VehicleController.Open()
	end)
end

local function attachTutorialMarker(part: BasePart)
	local stepId = part:GetAttribute("TutorialStepId")
	local label = if typeof(stepId) == "string" then stepId else part.Name
	attachPromptOnce(part, function()
		return makePrompt(part, "Continue", "Tutorial: " .. tostring(label), 0, 10)
	end, function()
		NotificationController.Show("Follow the gold beam / tutorial panel — or press SKIP.", "Info", 3.5)
	end)
end

local function bindTag(tag: string, handler: (BasePart) -> ())
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") then
			handler(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
		if inst:IsA("BasePart") then
			handler(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		if inst:IsA("BasePart") then
			if tag == Constants.Tags.UpgradeSlot then
				detachUpgradeSlot(inst)
			else
				disconnectAll(promptConns, inst)
				attachedPrompt[inst] = nil
			end
		end
	end)
end

local function clearOverlapState()
	table.clear(lastOverlap)
	table.clear(pendingPurchase)
	hidePadBuyButton()
end

local function startOverlapLoop()
	if overlapConn then
		overlapConn:Disconnect()
		overlapConn = nil
	end
	overlapConn = RunService.Heartbeat:Connect(function()
		if billboardDirty and (os.clock() - lastBillboardRefresh) >= BILLBOARD_THROTTLE then
			refreshAllBillboardsNow()
		end

		local char = player.Character
		if not char then
			hidePadBuyButton()
			return
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not (hrp and hrp:IsA("BasePart")) then
			hidePadBuyButton()
			return
		end
		if isSeatedInVehicle() then
			-- Driving: clear any stuck overlap so stepping out can buy fresh
			for key in pairs(lastOverlap) do
				if lastOverlap[key] then
					lastOverlap[key] = false
				end
			end
			hidePadBuyButton()
			return
		end

		local pos = hrp.Position
		local bestPart: BasePart? = nil
		local bestSid: string? = nil
		for part in pairs(slotParts) do
			if part.Parent then
				local structureId = part:GetAttribute("StructureId")
				if typeof(structureId) == "string" then
					local key = padKey(part, structureId)
					local inside = pointInPad(pos, part)
					if inside then
						if not lastOverlap[key] then
							onEnterPad(part, structureId)
						else
							-- Standing retry: failed buy / cash refresh / sequential upgrades
							onEnterPad(part, structureId, true)
						end
						-- Prefer own-plot pad for BUY button (first match is fine; typically one pad)
						if isOwnPlot(part) and bestPart == nil then
							bestPart = part
							bestSid = structureId
						end
					elseif lastOverlap[key] then
						onLeavePad(key)
					end
				end
			end
		end
		refreshPadBuyButton(bestPart, bestSid)
	end)
end

local function bindAllTags()
	if tagsBound then
		-- Re-attach any slots that appeared since first bind (GetInstanceAdded covers
		-- new tags, but stale/untagged-then-tagged races still need a GetTagged sweep)
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
			if inst:IsA("BasePart") then
				attachUpgradeSlot(inst)
			end
		end
		return
	end
	tagsBound = true
	bindTag(Constants.Tags.BasePlot, attachBasePlot)
	bindTag(Constants.Tags.UpgradeSlot, attachUpgradeSlot)
	bindTag(Constants.Tags.CaptureZone, attachCaptureZone)
	bindTag(Constants.Tags.VehicleSpawn, attachVehicleSpawn)
	bindTag(Constants.Tags.TutorialMarker, attachTutorialMarker)
end

-- Attribute fallback: StructureId pads under WarEmpireSetup.Bases missing the tag
local function rescanUntaggedSlots()
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		return
	end
	local bases = setup:FindFirstChild("Bases")
	if not bases then
		return
	end
	for _, desc in ipairs(bases:GetDescendants()) do
		if desc:IsA("BasePart") then
			local sid = desc:GetAttribute("StructureId")
			if typeof(sid) == "string" and not slotParts[desc] then
				-- Attach even if CollectionService tag lagged / missing on client replica
				attachUpgradeSlot(desc)
			end
		end
	end
end

function WorldPromptController.Init()
	Remotes.GetEvent(Constants.RemoteNames.BaseStateUpdate).OnClientEvent:Connect(function(base: Types.BaseStatePayload)
		local prev = upgrades
		upgrades = base.Upgrades or upgrades
		if typeof(base.PlotId) == "number" then
			if myPlotId ~= nil and myPlotId ~= base.PlotId then
				-- Plot reassignment — drop overlap so new pads can fire
				clearOverlapState()
			end
			myPlotId = base.PlotId
		end
		-- BUY edge: flash BOUGHT when standing on a pad that just leveled
		if activeBuyStructureId and typeof(upgrades) == "table" then
			local sid = activeBuyStructureId
			local before = if typeof(prev) == "table" then (prev[sid] or 0) else 0
			local after = upgrades[sid] or 0
			if after > before then
				local def = BaseConfig.Structures[sid]
				local name = if def then def.DisplayName else sid
				flashPadBuyBought(name)
				print(string.format("[WorldPrompt] BUY OK flash %s %d→%d", sid, before, after))
			end
		end
		markBillboardsDirty()
	end)

	Remotes.GetEvent(Constants.RemoteNames.EconomyUpdate).OnClientEvent:Connect(function(payload: Types.EconomyUpdatePayload)
		cash = payload.Cash
		markBillboardsDirty()
	end)

	Remotes.GetEvent(Constants.RemoteNames.PlayerStateUpdate).OnClientEvent:Connect(function(state: Types.PlayerStatePayload)
		cash = state.Cash
		if state.Base then
			upgrades = state.Base.Upgrades
			if typeof(state.Base.PlotId) == "number" then
				if myPlotId ~= nil and myPlotId ~= state.Base.PlotId then
					clearOverlapState()
				end
				myPlotId = state.Base.PlotId
			end
		end
		markBillboardsDirty()
	end)

	player.CharacterAdded:Connect(function()
		clearOverlapState()
		task.defer(function()
			task.wait(0.3)
			markBillboardsDirty()
		end)
	end)

	player.CharacterRemoving:Connect(function()
		clearOverlapState()
	end)

	task.defer(function()
		-- Wait for map (MapSetup + MapDressing can take >0.5s on cold Studio Play)
		local setup = Workspace:WaitForChild("WarEmpireSetup", 60)
		if not setup then
			warn("[WorldPromptController] WarEmpireSetup missing after 60s — binding tags anyway")
		end
		bindAllTags()
		startOverlapLoop()
		refreshAllBillboardsNow()
		rescanUntaggedSlots()
		local n = 0
		for _ in pairs(slotParts) do
			n += 1
		end
		print(string.format("[WorldPrompt] bound upgrade slots=%d tagged=%d", n, #CollectionService:GetTagged(Constants.Tags.UpgradeSlot)))

		-- Periodic rescan first ~20s for race / late-tagged pads
		for _ = 1, 10 do
			task.wait(2)
			bindAllTags()
			rescanUntaggedSlots()
			refreshAllBillboardsNow()
		end
		local n2 = 0
		for _ in pairs(slotParts) do
			n2 += 1
		end
		print(string.format("[WorldPrompt] after rescan slots=%d", n2))
	end)
end

return WorldPromptController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="113">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Client audio helper — menu ambient music + UI / notification SFX.
	Respects ClientSettings music/SFX toggles with immediate mute/unmute
	(volumes 0 or restored). Placeholder SoundIds — swap in Studio.
]]

local SoundService = game:GetService("SoundService")

local ClientSettings = require(script.Parent.ClientSettings)

local AudioController = {}

--[[
	PLACEHOLDER SoundIds — replace in Studio with licensed / Roblox Creator Store audio.
	Music uses empty SoundId (muted-ready; no upload required) until Shaun sets one.
	Click / notify use built-in engine asset paths (no custom upload).
]]
local MUSIC_SOUND_ID = "" -- e.g. "rbxassetid://YOUR_AMBIENT_ID"
local CLICK_SOUND_ID = "rbxasset://sounds/electronicpingshort.wav"
local NOTIFY_SOUND_ID = "rbxasset://sounds/switch.wav"

local DEFAULT_MUSIC_VOLUME = 0.35
local DEFAULT_SFX_VOLUME = 0.55

local folder: Folder? = nil
local musicSound: Sound? = nil
local clickSound: Sound? = nil
local notifySound: Sound? = nil

local musicVolume = DEFAULT_MUSIC_VOLUME
local sfxVolume = DEFAULT_SFX_VOLUME

local function ensureFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local existing = SoundService:FindFirstChild("WarEmpireAudio")
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "WarEmpireAudio"
	f.Parent = SoundService
	folder = f
	return f
end

local function makeSound(name: string, soundId: string, looped: boolean, volume: number): Sound
	local parent = ensureFolder()
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Sound") then
		existing.SoundId = soundId
		existing.Looped = looped
		existing.Volume = volume
		return existing
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = soundId
	s.Looped = looped
	s.Volume = volume
	s.RollOffMode = Enum.RollOffMode.Linear
	s.Parent = parent
	return s
end

local function applyVolumes()
	if musicSound then
		if ClientSettings.ShouldPlayMusic() then
			musicSound.Volume = musicVolume
			if musicSound.SoundId ~= "" and not musicSound.IsPlaying then
				musicSound:Play()
			end
		else
			musicSound.Volume = 0
		end
	end
	if clickSound then
		clickSound.Volume = if ClientSettings.ShouldPlaySfx() then sfxVolume else 0
	end
	if notifySound then
		notifySound.Volume = if ClientSettings.ShouldPlaySfx() then sfxVolume else 0
	end
end

function AudioController.Init()
	musicSound = makeSound("MenuMusic", MUSIC_SOUND_ID, true, 0)
	clickSound = makeSound("UIClick", CLICK_SOUND_ID, false, 0)
	notifySound = makeSound("Notification", NOTIFY_SOUND_ID, false, 0)
	applyVolumes()
	if ClientSettings.ShouldPlayMusic() and musicSound and musicSound.SoundId ~= "" then
		musicSound:Play()
	end
	ClientSettings.OnChanged(applyVolumes)
end

--[[ UI button activate — respects SFX toggle. ]]
function AudioController.PlayClick()
	if not ClientSettings.ShouldPlaySfx() then
		return
	end
	if not clickSound then
		AudioController.Init()
	end
	if clickSound then
		clickSound.Volume = sfxVolume
		clickSound.TimePosition = 0
		clickSound:Play()
	end
end

--[[ Toast / reward ping — respects SFX toggle. ]]
function AudioController.PlayNotification()
	if not ClientSettings.ShouldPlaySfx() then
		return
	end
	if not notifySound then
		AudioController.Init()
	end
	if notifySound then
		notifySound.Volume = sfxVolume
		notifySound.TimePosition = 0
		notifySound:Play()
	end
end

function AudioController.GetMusicVolume(): number
	return musicVolume
end

function AudioController.GetSfxVolume(): number
	return sfxVolume
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">ClientSettings</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Local-only client preferences (music/SFX flags).
	Session-scoped (no DataStore). AudioController listens via OnChanged
	and mutes/restores volumes immediately. Economy stays server-authoritative.
]]

local ClientSettings = {}

local musicEnabled = true
local sfxEnabled = true

local listeners: { () -> () } = {}

local function notify()
	for _, cb in ipairs(listeners) do
		task.defer(cb)
	end
end

function ClientSettings.GetMusicEnabled(): boolean
	return musicEnabled
end

function ClientSettings.GetSfxEnabled(): boolean
	return sfxEnabled
end

function ClientSettings.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled == true
	notify()
end

function ClientSettings.SetSfxEnabled(enabled: boolean)
	sfxEnabled = enabled == true
	notify()
end

function ClientSettings.ToggleMusic(): boolean
	ClientSettings.SetMusicEnabled(not musicEnabled)
	return musicEnabled
end

function ClientSettings.ToggleSfx(): boolean
	ClientSettings.SetSfxEnabled(not sfxEnabled)
	return sfxEnabled
end

function ClientSettings.OnChanged(cb: () -> ())
	table.insert(listeners, cb)
end

--[[ Call before playing music/SFX — returns false when muted. ]]
function ClientSettings.ShouldPlayMusic(): boolean
	return musicEnabled
end

function ClientSettings.ShouldPlaySfx(): boolean
	return sfxEnabled
end

return ClientSettings
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
