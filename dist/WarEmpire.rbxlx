-- Camps: clear the garrison and the commander, then open the chest. Post types follow today's field NPC mix
-- (CombatService.BootstrapNPCs deals Infantry, Infantry, HeavyInfantry over the WE_NPCSpawn anchors in order).
local function camp(id: string, poi: string, name: string, types: { string }, towerPost: string, reserve: number)
	local a: { [string]: string } = { Chest = id .. ".Chest", Cmdr = id .. ".Cmdr" }
	local g: { GarrisonPost } = {}
	for i, t in ipairs(types) do
		local p = "G" .. tostring(i)
		a[p] = id .. "." .. p
		table.insert(g, post(p, t, "Aggressive", 80))
	end
	a[towerPost] = id .. "." .. towerPost
	table.insert(g, post(towerPost, "Infantry", "Post", nil, nil, true))
	table.insert(g, post("Cmdr", "CampCommander", "Aggressive", 80))
	table.insert(Sites, {
		Id = id,
		Kind = "Camp",
		POI = poi,
		Enabled = false,
		Name = name,
		Title = "Raid Camp",
		Short = "CAMP",
		Hard = true,
		Big = false,
		Anchors = a,
		Optional = { towerPost }, -- the watchtower post (Requires Watch: Full quality only)
		Target = "Chest",
		Label = true,
		Garrison = g,
		Reserve = reserve,
		Wake = "Default",
		Stages = {
			{ Id = "Clear" },
			{ Id = "Open", At = "Chest", Prompt = "OpenCache", Hold = 2, Dist = 8 },
		},
		Pay = "Camp",
		PresentR = 120,
		PresentSeconds = 10,
	})
end
camp("Quarry.Camp", "Quarry", "Quarry Camp", { "Infantry", "Infantry", "HeavyInfantry", "Infantry" }, "G5", 6)
camp("RidgeCamp.Camp", "RidgeCamp", "Ridge Camp", { "Infantry", "HeavyInfantry", "Infantry" }, "G4", 5)
camp("DuneCamp.Camp", "DuneCamp", "Dune Camp", { "Infantry", "HeavyInfantry", "Infantry" }, "G4", 5)

-- Forts: plant a charge at the gate anchor (no gate part: the charge is the objective), clear the fort guards
local function fort(id: string, poi: string, name: string)
	local a: { [string]: string } = { Gate = id .. ".Gate" }
	local g: { GarrisonPost } = {}
	for i = 1, 4 do
		local p = "G" .. tostring(i)
		a[p] = id .. "." .. p
		table.insert(g, post(p, "FortGuard", "Aggressive", 60))
	end
	table.insert(Sites, {
		Id = id,
		Kind = "Siege",
		POI = poi,
		Enabled = false,
		Name = name,
		Title = "Breach the Fort",
		Short = "FORT",
		Hard = true,
		Big = false,
		Anchors = a,
		Target = "Gate",
		Label = true,
		Garrison = g,
		Reserve = 4,
		Wake = "Default",
		Stages = {
			{ Id = "Plant", At = "Gate", Prompt = "PlantCharge", Hold = 3, Dist = 10, Need = 1 },
			{ Id = "Fuse", Seconds = 8, Damage = 40, DamageR = 12 },
			{ Id = "Clear" },
		},
		Lockdown = 480, -- the gate stays blown this long
		Pay = "Fort",
		PresentR = 80,
		PresentSeconds = 10,
	})
end
fort("FortI.Breach", "FortI", "Ironclad Gate")
fort("FortS.Breach", "FortS", "Sandhold Gate")

-- Rigs: clear the deck guards (config posts on a ring of radius DeckR round the TerritoryConfig deck position;
-- the capture itself stays TerritoryService's). The Pier anchor is the GO point on the shore.
local DECK_R = 20
local DECK_ANGLES = { 0, 120, 240 } -- degrees, 0 = north (-Z)
local DECK_TOP = 28.05 -- MapSetup deck: 2.5 thick centred at Position.Y - 1.2
local function rig(id: string, poi: string, name: string, cx: number, cz: number)
	local g: { GarrisonPost } = {}
	for _, deg in ipairs(DECK_ANGLES) do
		local r = math.rad(deg)
		table.insert(g, {
			At = { X = cx - DECK_R * math.sin(r), Y = DECK_TOP, Z = cz - DECK_R * math.cos(r), Yaw = deg + 180 },
			Type = "OilRigGuard",
			Stance = "Aggressive",
			Leash = 25, -- never walks off the 48-stud deck
		})
	end
	table.insert(Sites, {
		Id = id,
		Kind = "Rig",
		POI = poi,
		Enabled = false,
		Name = name,
		Title = "Storm the Rig",
		Short = "RIG",
		Hard = true,
		Big = false,
		Anchors = { Pier = id .. ".Pier" },
		Target = "Pier",
		Label = false, -- the capture zone's own label covers the deck
		Garrison = g,
		Reserve = 3,
		Wake = "Default",
		Stages = { { Id = "Clear" } },
		Pay = "Rig",
		PresentR = 80,
		PresentSeconds = 10,
		AllowSeated = true,
	})
end
-- deck centres = TerritoryConfig.Territories.CoastalOilAlpha / CoastalOilBravo .Position (X, Z)
rig("RigA.Deck", "RigA", "Rig Alpha Deck", 1800, -750)
rig("RigB.Deck", "RigB", "Rig Bravo Deck", -1800, 750)

-- ── Lookups (pure; built once at require) ─────────────────────────────────────────────────────────────────────
local byId: { [string]: SiteDef } = {}
for _, s in ipairs(Sites) do
	byId[s.Id] = s
end

function OpsConfig.Get(id: string): SiteDef?
	return byId[id]
end

-- True when the master switch, the kind and the site are all on (POI / anchor liveness is OpsService's check)
function OpsConfig.SiteSwitchedOn(id: string): boolean
	local s = byId[id]
	if s == nil or OpsConfig.Enabled ~= true or s.Enabled ~= true then
		return false
	end
	local k = OpsConfig.Kinds[s.Kind]
	return k ~= nil and k.Enabled == true
end

local function inList(list: { string }, v: string): boolean
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

-- Static checks of the rows above (no world access). Returns a list of problems; empty = valid.
function OpsConfig.Validate(): { string }
	local bad: { string } = {}
	local function fail(msg: string)
		table.insert(bad, msg)
	end
	local seen: { [string]: boolean } = {}
	for _, s in ipairs(Sites) do
		local id = s.Id
		if seen[id] then
			fail(id .. ": duplicate site id")
		end
		seen[id] = true
		local poi, site = string.match(id, "^([%w_]+)%.([%w_]+)$")
		if poi == nil or site == nil then
			fail(id .. ": site id is not <POI>.<Site>")
		elseif poi ~= s.POI then
			fail(id .. ": POI " .. s.POI .. " does not match the id")
		end
		if OpsConfig.Kinds[s.Kind] == nil then
			fail(id .. ": unknown kind " .. s.Kind)
		end
		if OpsConfig.Rewards.Rows[s.Pay] == nil then
			fail(id .. ": unknown pay row " .. s.Pay)
		end
		if OpsConfig.Npc.Wake[s.Wake] == nil then
			fail(id .. ": unknown wake " .. s.Wake)
		end
		if not string.match(s.Short, "^[A-Z]+$") or #s.Short < 2 or #s.Short > 7 then
			fail(id .. ": Short must be 2-7 capitals")
		end
		for role, aid in pairs(s.Anchors) do
			if aid ~= id .. "." .. role then
				fail(id .. ": anchor " .. role .. " = " .. aid .. " is not <site>.<role>")
			end
		end
		if s.Anchors[s.Target] == nil then
			fail(id .. ": Target " .. s.Target .. " is not an anchor role")
		end
		for _, r in ipairs(s.Optional or {}) do
			if s.Anchors[r] == nil then
				fail(id .. ": Optional " .. r .. " is not an anchor role")
			end
		end
		for _, g in ipairs(s.Garrison) do
			if g.Post ~= nil and s.Anchors[g.Post] == nil then
				fail(id .. ": garrison post " .. g.Post .. " is not an anchor role")
			end
			if g.Post == nil and g.At == nil then
				fail(id .. ": garrison post with neither Post nor At")
			end
			if not inList(OpsConfig.Stances, g.Stance) then
				fail(id .. ": unknown stance " .. g.Stance)
			end
			if g.When ~= nil and not inList(OpsConfig.Spawns, g.When) then
				fail(id .. ": unknown When " .. g.When)
			end
		end
		for _, p in ipairs(s.WavePosts or {}) do
			if s.Anchors[p] == nil then
				fail(id .. ": wave post " .. p .. " is not an anchor role")
			end
		end
		for _, r in ipairs(s.Rotate or {}) do
			if s.Anchors[r] == nil then
				fail(id .. ": rotate " .. r .. " is not an anchor role")
			end
		end
		if #s.Stages == 0 then
			fail(id .. ": no stages")
		end
		for _, st in ipairs(s.Stages) do
			if not inList(OpsConfig.StageIds, st.Id) then
				fail(id .. ": unknown stage " .. st.Id)
			end
			if st.At ~= nil and s.Anchors[st.At] == nil then
				fail(id .. ": stage " .. st.Id .. " At " .. st.At .. " is not an anchor role")
			end
			for _, r in ipairs(st.AtAny or {}) do
				if s.Anchors[r] == nil then
					fail(id .. ": stage " .. st.Id .. " AtAny " .. r .. " is not an anchor role")
				end
			end
			if st.Prompt ~= nil then
				local txt = OpsConfig.Text.Prompts[st.Prompt]
				if txt == nil then
					fail(id .. ": stage " .. st.Id .. " prompt " .. st.Prompt .. " has no text")
				elseif #txt > 13 then
					fail(id .. ": prompt text " .. txt .. " is over 13 characters")
				end
				if st.At == nil and st.AtAny == nil then
					fail(id .. ": stage " .. st.Id .. " has a prompt but no anchor")
				end
			end
		end
	end
	return bad
end

return OpsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">OrdersConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Squad Orders (walkie) — Follow / Attack / Hold / Retreat.
	Field units project SoldierService army counts (not a second recruit economy).
]]

local OrdersConfig = {
	Enabled = true,

	MinSoldiersToShow = 1,
	MaxFieldUnits = 5,
	UnitsPerSoldier = 1,

	OrderRatePerSec = 2,
	OrderBurst = 4,

	DefaultOrder = "Follow",

	Orders = {
		Follow = true,
		Attack = true,
		Hold = true,
		Retreat = true,
	},

	ThinkInterval = 0.4,
	FollowDistance = 10, -- old grid only (FollowSlots empty): face the player beyond this
	FollowStopDistance = 6, -- old grid only: stop within this of the player
	FormationSpacing = 3.5, -- old grid (3 wide, rows 6 / 9.5 / 13 studs straight behind the player)
	-- Base identity lane C (owner: the squad blocked the camera). Follow slots in player-local studs: +X is the
	-- player's right, +Z is BEHIND the player. Two wings beside the player, clear of the third-person camera's
	-- line to the player (the old grid put 2 of 5 units right between the camera and you). Slot 6+ (Squad
	-- Expansion research) repeats the list FollowRankStepZ further back per rank. Empty list = the old grid.
	FollowSlots = {
		{ X = -5.5, Z = 1.5 },
		{ X = 5.5, Z = 1.5 },
		{ X = -10, Z = 3.5 },
		{ X = 10, Z = 3.5 },
		{ X = -14.5, Z = 5.5 },
	},
	FollowRankStepZ = 3.5,
	FollowArriveStuds = 2, -- within this of its slot a unit stands still and faces where the player faces
	FollowMirrorHysteresis = 3, -- after a turn the wings swap sides when that saves this many studs per unit
	-- FollowPath: a unit that cannot walk straight to its slot stands against the wall beside the player when the slot
	-- is inside or behind that wall (walking along a building), squeezes in when a wall end is in its way, else walks
	-- the player's own trail (a 6-stud door, a narrow lane, a floor above) and fans back out once its slot is
	-- walkable. Server raycasts per unit per think (2.5 Hz): 0 in its slot, 2 on the way, 5 against a wall, 5-11 on
	-- the trail, a full trail scan only on losing its place (at most every RescanSeconds when nothing is walkable).
	-- Enabled = false = straight MoveTo, as before.
	FollowPath = {
		Enabled = true,
		CrumbSpacing = 3, -- studs the player moves before a new trail point
		MaxCrumbs = 12,
		ResetJump = 40, -- a jump this far (respawn, recall, vehicle) starts a new trail
		ReachStuds = 2.5, -- a unit this close to its trail point takes the next one
		StopGap = 4, -- trail points closer than this to the player are skipped (a cut-off unit stops behind you)
		RescanSeconds = 2,
		RayDrop = 1, -- rays run this far below the root centres (knee-to-waist): kerbs and pads never block
		RayHalfWidth = 0.9, -- one ray along each edge of the unit's 2-stud body
		WallGap = 1.5, -- a unit against a wall stands this far off it
		MinSide = 3, -- ...and only when that leaves this much room from the player's centre line (else the trail)
		SqueezeStuds = 2, -- a wall end in the way of an open slot: aim this much nearer the player instead
	},
	AttackAggroRange = 120,
	AttackRange = 55,
	AttackDamage = 8,
	AttackFireRate = 1.8,
	HoldLeashStuds = 14,
	UnitHealth = 90,
	UnitWalkSpeed = 14,
	UnitColor = Color3.fromRGB(70, 90, 55),

	VisualKind = "Infantry",
	DisplayName = "Squad",
	ShowUnitLabels = false, -- v68: floating "SQUAD" tag over every field unit (owner: clutter)
	-- v38: brief order state over nearest soldier
	OrderBillboardSeconds = 2.8,
	OrderLabels = {
		Follow = "FOLLOWING",
		Attack = "ATTACKING",
		Hold = "HOLDING",
		Retreat = "RETREATING",
	},

	-- v70 Army popover (spec §3.8): never auto-shown. The rail's Army tile / Y toggles it; it sits right of the
	-- tile (AnchorPoint 0,0.5 at tile right + GapFromTile, tile centre, clamped to the safe area). Sizes are in v
	-- under the one HUD UIScale (HudLayout.ApplyScreen: 0.70 on phones), so 64 v = 44.8 real px.
	Walkie = {
		Size = UDim2.fromOffset(216, 180), -- desktop: title + 2×2 cells of 100×44 v + MANAGE row 40 v
		SizeTouch = UDim2.fromOffset(216, 244), -- 2×2 cells of 96×64 v + title + MANAGE row
		MinTouchPx = 64, -- v; 56 v × 0.70 = 39 px was under the 44 px touch minimum
		PanelMaxWidth = 240, -- popover 216 v + padding (UISizeConstraint)
		PanelMaxHeight = 260,
		GapFromTile = 10, -- v between the Army tile's right edge and the popover
		EdgeMargin = 8, -- v kept free between the popover (incl. its corner ✕) and the safe-area edges
		Pad = 6,
		TitleHeight = 28,
		TitleSize = 22, -- "ARMY 5/20" (Display font)
		CellGap = 4,
		CellHeightDesktop = 44,
		ManageHeightDesktop = 40,
		CellTextSize = 18,
		CaptionSize = 16, -- desktop "ORDERS 1-4 · T" hint, hotkey digits
		CloseFace = 30, -- v ✕ disc centred on the popover's top-right corner (hit = MinTouchPx on touch)
		Bg = Color3.fromRGB(22, 24, 28),
		BgTransparency = 0.08,
		Accent = Color3.fromRGB(72, 220, 96), -- the Army rail tile's accent: popover + cell strokes
		CellBg = Color3.fromRGB(32, 36, 42),
		ActiveBg = Color3.fromRGB(40, 132, 60), -- the order the squad follows now
		ManageBg = Color3.fromRGB(16, 58, 28),
		HotkeyToastSeconds = 1.6, -- T with the popover closed → local Info toast "Squad: FOLLOW"
	},
}

return OrdersConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">PlotOilPumpConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Near-plot oil pumpjacks outside DefensiveWalls (toward warzone / map origin).
	Income → PendingCash. Does NOT touch OilRig Alpha/Bravo far POIs.
]]

local PlotOilPumpConfig = {
	Enabled = true,
	MinWallsLevel = 2,
	PumpsPerPlot = 2,
	WallClearanceStuds = 18,
	LateralSpreadStuds = 22,
	CashPerTick = 18,
	TickSeconds = 5,
	VisualPropKey = "OilPumpjack", -- v41 realistic nodding donkey (alt OilPumpjackAlt)
	FolderName = "WE_PlotOilPumps",
	Reason = "plot_oil",
	-- F9 (owner's 11 features): Golden Pumpjacks (MonetizationConfig.DevProducts.GoldenPumpjack). Owners' pumps are
	-- dressed gold Metal with Reflectance (no Neon, no light). Non-owners, while the Id is live, get ONE 7x7 gold pad
	-- (WE_PremiumPad, OfferKind DevProduct, OfferKey GoldenPumpjack) PadOffsetStuds from the pumps toward the plot, with
	-- one stud-scaled label (MaxDistance LabelMaxDistance, never AlwaysOnTop, tagged WorldLabelConfig.BaseLabelTag).
	Golden = {
		Color = Color3.fromRGB(255, 195, 60),
		Material = Enum.Material.Metal,
		Reflectance = 0.2,
		PadOffsetStuds = 10,
		LabelMaxDistance = 20,
	},
}

return PlotOilPumpConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PremiumVehicleConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): premium Robux vehicles — lineup, camo palettes, free test drive, showroom and copy
	(premium_vehicles.md §1, §2, §6, §7; plan §2.2). Vehicle stats and kits live in VehicleConfig (M6 adds the
	Premium defs); HP / damage in VehicleCombatConfig; mounts in VehicleWeaponConfig.
	Config only: nothing reads this file yet and nothing is sold from it.

	Money rules:
	- Robux only: permanent game passes. Never Cash, codes, Battle Pass, spinner or rebirth grants. Work from
	  Level 1 with no Depot, kept through Rebirth. profile.Vehicles is never read for premium vehicles (J4).
	- Every product Id is 0: the pass rows (PassKey below) are added to MonetizationConfig.GamePasses by M1 with
	  Id = 0 and HideFromShop, created by the owner with Item for Sale OFF (J3), and turned on sale only in the
	  publish that makes the feature live. Asset ids here are 0 too (0 = built-in Part look / no sound).
	- A premium row is hidden while its pass Id is 0 in a live server, or while its Phase is not live.
	- Offers go through the Offer Director (OfferShow) only; there is no PremiumVehicleOffer remote (J30). ]]

export type LineupEntry = {
	VehicleId: string,
	PassKey: string, -- MonetizationConfig.GamePasses key (Id lives there; 0 until the owner creates it)
	DisplayName: string,
	RobuxPrice: number, -- fallback only; the Garage shows the live price (PriceCache, J28)
	Phase: number, -- 1 = ground (M6), 2 = helicopter (M6b), 3 = boat (M6b)
	DefaultCamo: string,
	Seats: number,
	SquadSeats: number?, -- seats the owner's field squad may take (M6b decides the heli / boat layout)
	FiringPorts: number?, -- squad seats that fire at NPCs
	Weapons: { string }, -- VehicleWeaponConfig.Mounts ids
	Tagline: string,
}

export type CamoDef = {
	DisplayName: string,
	Base: Color3,
	Panel: Color3,
	Patch1: Color3,
	Patch2: Color3,
	Trim: Color3,
	Glow: Color3,
}

local GOLD = Color3.fromRGB(255, 200, 70) -- premium pinstripes / rims / turret band (§2.1)

local PremiumVehicleConfig = {
	Enabled = true,

	Lineup = {
		{
			VehicleId = "PremiumRazorfang",
			PassKey = "PV_Razorfang",
			DisplayName = "Razorfang GT Interceptor",
			RobuxPrice = 199,
			Phase = 1,
			DefaultCamo = "Urban",
			Seats = 4,
			SquadSeats = 3,
			FiringPorts = 2,
			Weapons = { "TwinHoodMG" },
			Tagline = "Fastest armored car · twin hood MGs you fire while driving",
		},
		{
			VehicleId = "PremiumBastion",
			PassKey = "PV_Bastion",
			DisplayName = "Bastion Gun Truck",
			RobuxPrice = 399,
			Phase = 1,
			DefaultCamo = "Woodland",
			Seats = 10,
			SquadSeats = 9,
			FiringPorts = 8,
			Weapons = { "RoofHMG" },
			Tagline = "Carries up to 9 soldiers · roof machine gun", -- J22 (not "your whole squad")
		},
		{
			VehicleId = "PremiumWarlord",
			PassKey = "PV_Warlord",
			DisplayName = "Warlord Siege Tank",
			RobuxPrice = 799,
			Phase = 1,
			DefaultCamo = "Desert",
			Seats = 6,
			SquadSeats = 5,
			FiringPorts = 4,
			Weapons = { "SiegeCannon", "CommanderMG" },
			Tagline = "Heaviest armor · siege cannon",
		},
		{
			VehicleId = "PremiumStormwing",
			PassKey = "PV_Stormwing",
			DisplayName = "Stormwing Gunship",
			RobuxPrice = 999,
			Phase = 2, -- M6b, after helicopter flight is verified on a phone
			DefaultCamo = "Urban",
			Seats = 8,
			Weapons = { "RocketPods", "ChinGun", "DoorMG" },
			Tagline = "Rocket pods · door gunners · 8 seats",
		},
		{
			VehicleId = "PremiumTidebreaker",
			PassKey = "PV_Tidebreaker",
			DisplayName = "Tidebreaker Assault Boat",
			RobuxPrice = 299,
			Phase = 3, -- M6b, after waterways / boats
			DefaultCamo = "Urban",
			Seats = 6,
			Weapons = { "BowTwinMG" },
			Tagline = "Fast assault boat · bow twin MG",
		},
	} :: { LineupEntry },

	-- All three ground cars (saves 298 R$). J3: the description tells single-car owners to buy the others alone.
	Bundle = {
		PassKey = "PV_MotorPool",
		DisplayName = "Premium Motor Pool",
		RobuxPrice = 1099,
		VehicleIds = { "PremiumRazorfang", "PremiumBastion", "PremiumWarlord" },
		SavesRobux = 298,
		HideIfOwnsAny = { "PV_Razorfang", "PV_Bastion", "PV_Warlord" },
	},

	-- Camo palettes (§2.2): recolour only the Base / Panel / Patch1 / Patch2 / Trim / Glow paint roles
	CamoOrder = { "Desert", "Woodland", "Urban", "Arctic", "Obsidian" },
	Camos = {
		Desert = {
			DisplayName = "Desert",
			Base = Color3.fromRGB(176, 150, 105),
			Panel = Color3.fromRGB(140, 118, 82),
			Patch1 = Color3.fromRGB(120, 95, 62),
			Patch2 = Color3.fromRGB(196, 176, 132),
			Trim = GOLD,
			Glow = Color3.fromRGB(255, 190, 90),
		},
		Woodland = {
			DisplayName = "Woodland",
			Base = Color3.fromRGB(72, 88, 58),
			Panel = Color3.fromRGB(52, 64, 42),
			Patch1 = Color3.fromRGB(40, 48, 32),
			Patch2 = Color3.fromRGB(98, 86, 60),
			Trim = GOLD,
			Glow = Color3.fromRGB(120, 255, 140),
		},
		Urban = {
			DisplayName = "Urban",
			Base = Color3.fromRGB(120, 124, 130),
			Panel = Color3.fromRGB(84, 88, 94),
			Patch1 = Color3.fromRGB(58, 60, 66),
			Patch2 = Color3.fromRGB(160, 164, 170),
			Trim = GOLD,
			Glow = Color3.fromRGB(120, 190, 255),
		},
		Arctic = {
			DisplayName = "Arctic",
			Base = Color3.fromRGB(220, 224, 228),
			Panel = Color3.fromRGB(178, 184, 190),
			Patch1 = Color3.fromRGB(140, 146, 152),
			Patch2 = Color3.fromRGB(240, 242, 244),
			Trim = GOLD,
			Glow = Color3.fromRGB(170, 220, 255),
		},
		Obsidian = {
			DisplayName = "Obsidian Gold",
			Base = Color3.fromRGB(28, 30, 34),
			Panel = Color3.fromRGB(18, 19, 22),
			Patch1 = Color3.fromRGB(40, 42, 48),
			Patch2 = Color3.fromRGB(28, 30, 34),
			Trim = Color3.fromRGB(255, 200, 70),
			Glow = Color3.fromRGB(255, 200, 70),
		},
	} :: { [string]: CamoDef },
	-- Camo → the pass the owner also needs (VIP cross-sell); the others are free for owners
	CamoVIPOnly = { Obsidian = "VIP" } :: { [string]: string },

	-- Free test drive (§6.4): once per vehicle per 24 h, never within 10 s of taking damage; server-timed.
	Trial = {
		Seconds = 90,
		CooldownHours = 24,
		NoDamageInLastSeconds = 10,
		RequestCooldownSeconds = 3,
	},

	-- Offer Director triggers (M3/M6 register them; OfferShow → NotificationController.ShowOffer)
	Offers = {
		KilledByPriority = 85,
		KilledByWindowSeconds = 3, -- WE_LastHitVehicle within this window of the death
		SquadOverflowMinStowed = 2,
		MinSecondsIntoFirstSession = 180,
	},

	-- J7: optional showroom plinth on your own plot (M6b), plot-local, never auto-prompts on touch
	Showroom = { X = 40, Z = 146, YawDeg = -90, MaxDistance = 60 },

	Look = {
		MaxKitParts = 90, -- not counting physics wheels
		NameplateMaxDistance = 180,
		NameplateAlwaysOnTop = false,
		SpawnSparkleCount = 40,
		CharredColor = Color3.fromRGB(35, 32, 30),
		Gold = GOLD,
	},

	-- 0 = built-in look / no custom asset (owner may paste Creator Store ids later)
	Assets = { ChipIconId = 0, SpawnSoundId = 0 },

	Text = {
		Chip = "PREMIUM", -- J24: text, not a glyph that can fall back in FredokaOne
		SectionHeader = "PREMIUM GARAGE · Robux · permanent · kept through Rebirth",
		Permanent = "Permanent · kept through Rebirth",
		Fits = "Fits %d of your %d soldiers", -- J22: live count in the Garage
		TryFree = "TRY FREE 90s",
		TryIn = "TRY in %s",
		Buy = "BUY %d R$",
		Repairing = "%s is being repaired: ready in %ds",
		TrialEnd = "Keep the %s? %d R$",
		KilledBy = "Killed by a %s. Try it free or own it: %d R$",
		SquadOverflow = "%s seats up to %d soldiers",
		ObsidianNeedsVip = "Obsidian Gold needs VIP",
		NotOwned = "Get this vehicle in the Garage",
	},
}

function PremiumVehicleConfig.GetLineupEntry(vehicleId: string): LineupEntry?
	for _, e in ipairs(PremiumVehicleConfig.Lineup) do
		if e.VehicleId == vehicleId then
			return e
		end
	end
	return nil
end

return PremiumVehicleConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">PrestigeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Prestige / Rebirth reset rules.
	Cash mult at runtime uses EconomyConfig.PrestigeCashMultiplierPerLevel (+10%/prestige).
	RebirthUnlocks: applied when Prestige reaches AtPrestige (stacking permanent flags + optional grants).
	Owner's 11 features (lane K1, spec_f11 §2):
	  F7  KeepBase + ResetOnPrestigeKeepBase: the 50 R$ keep-base rebirth (MonetizationConfig.DevProducts
	      .RebirthKeepBase adds a token to profile.KeepBaseRebirths; PrestigeService.DoPrestige(p, { KeepBase = true })
	      spends it). ResetFor(path) is the reset table each path applies.
	  F11 ProgressPct (rebirth progress %, XP-based) and RebirthSummary(path, ctx): the KEEP / RESET / GAIN lines of
	      the Rebirth confirm modal, built from the same reset tables the server applies (single source).
]]

local LevelConfig = require(script.Parent.LevelConfig)

export type RebirthUnlockDef = {
	AtPrestige: number,
	Flag: string,
	DisplayName: string,
	Kind: "Flag" | "Vehicle" | "Weapon" | "Structure",
	Id: string?, -- Vehicle/Weapon/Structure id when Kind is not Flag-only
	GrantOwned: boolean?, -- auto-grant Vehicles[Id] / Weapons[Id]
}

-- F7 / F11: the two rebirth paths. "Cash" = the free rebirth; "KeepBase" = the 50 R$ keep-base rebirth (token).
export type RebirthPath = "Cash" | "KeepBase"

export type ResetRules = {
	Cash: boolean,
	Level: boolean,
	XP: boolean,
	BaseUpgrades: boolean,
	KeepVehicles: boolean,
	KeepWeapons: boolean,
	KeepGold: boolean,
	KeepRebirthUnlocks: boolean,
}

-- F11: what the Rebirth confirm modal needs to fill the lines (the server sends it in PrestigeStateUpdate.Summary).
export type RebirthSummaryCtx = {
	Built: number, -- structure levels bought (the "Base buildings (N built)" line)
	Prestige: number, -- the CURRENT prestige (before this rebirth)
	NextUnlock: string?, -- DisplayName of the rebirth unlock this rebirth gives (NextUnlockName), if any
	BusinessesOn: boolean, -- BusinessConfig is live (its businesses reset with the base on the Cash path)
}

export type RebirthSummary = { Keep: { string }, Reset: { string }, Gain: { string } }

local PrestigeConfig = {
	-- P0 competitive: earlier first rebirth feel (was 100). Reversible — bump back if economy too fast.
	-- See ASSUMPTIONS #108. AdminPlaytestCash 50M unchanged.
	MinLevelToPrestige = 40,
	-- v38: soft rebirth CTA when Level >= Min - NearPrestigeLevels
	NearPrestigeLevels = 2,
	MaxPrestige = 50,
	-- +10% cash earnings per prestige (stacking). Keep in sync with EconomyConfig.PrestigeCashMultiplierPerLevel.
	CashBonusPerPrestige = 0.10,
	GoldBonusOnPrestige = 50,
	-- Upfront cash fee to prestige (0 = none). Cash still resets to StartingCashAfterPrestige when ResetOnPrestige.Cash.
	CashFee = 0,
	ResetOnPrestige = {
		Cash = true,
		Level = true,
		XP = true,
		BaseUpgrades = true,
		KeepVehicles = true,
		KeepWeapons = true,
		KeepGold = true,
		KeepRebirthUnlocks = true,
		-- KeepTerritories / KeepOutpostIncomeStacks: implicit (fields never cleared in PrestigeService)
	} :: ResetRules,
	-- F7: the keep-base path = ResetOnPrestige with BaseUpgrades kept (structures, businesses, walls and pumps).
	-- Cash must equal (not KeepBase.KeepCash): with KeepCash = false the cash still goes back to
	-- StartingCashAfterPrestige. PendingCash is kept on both paths, as today (owner decision, ASSUMPTIONS).
	ResetOnPrestigeKeepBase = {
		Cash = true,
		Level = true,
		XP = true,
		BaseUpgrades = false,
		KeepVehicles = true,
		KeepWeapons = true,
		KeepGold = true,
		KeepRebirthUnlocks = true,
	} :: ResetRules,
	StartingCashAfterPrestige = 10000,

	-- F7: 50 R$ keep-base rebirth (a consumable token, MonetizationConfig.DevProducts[ProductKey]). Same gate as the
	-- free rebirth (MinLevelToPrestige, not MaxPrestige). AutoUseOnGrant: a token bought from the Rebirth panel within
	-- IntentWindowSeconds (the purchase-intent map) is spent right after the receipt is saved, when the player can
	-- rebirth; otherwise it is banked for the next rebirth and never expires. Enabled = false hides the path.
	KeepBase = {
		Enabled = true,
		ProductKey = "RebirthKeepBase",
		AutoUseOnGrant = true,
		IntentWindowSeconds = 180,
		KeepCash = false,
	},

	-- F11: the rebirth progress % (Rebirth panel bar, HUD level tooltip). "XP" = share of the total XP from Lv 1 to
	-- MinLevelToPrestige (Lv 20 = 17 %, Lv 30 = 48 %, Lv 39 = 93 %); "Level" = Level / MinLevelToPrestige.
	ProgressMode = "XP",
	-- F11: RebirthSummary line rules (the modal columns are narrow on an 800x360 phone)
	SummaryMaxLineChars = 30,

	--[[
		Unlock track (shown in K panel). Flags land in profile.RebirthUnlocks.
		GrantOwned vehicles/weapons are given permanently (kept through further prestiges).
	]]
	RebirthUnlocks = {
		{
			AtPrestige = 1,
			Flag = "RebirthScout",
			DisplayName = "Scout Car (owned)",
			Kind = "Vehicle",
			Id = "ScoutCar",
			GrantOwned = true,
		},
		{
			AtPrestige = 2,
			Flag = "NavalAccess",
			DisplayName = "Naval Access + Patrol Boat",
			Kind = "Vehicle",
			Id = "PatrolBoat",
			GrantOwned = true,
		},
		{
			AtPrestige = 3,
			Flag = "SupplyLine",
			DisplayName = "Supply Truck (owned)",
			Kind = "Vehicle",
			Id = "SupplyTruck",
			GrantOwned = true,
		},
		{
			AtPrestige = 4,
			Flag = "MissileBoatGrant",
			DisplayName = "Missile Boat (owned)",
			Kind = "Vehicle",
			Id = "MissileBoat",
			GrantOwned = true,
		},
		{
			AtPrestige = 5,
			Flag = "AirLift",
			DisplayName = "Transport Heli (owned)",
			Kind = "Vehicle",
			Id = "TransportHeli",
			GrantOwned = true,
		},
		{
			AtPrestige = 7,
			Flag = "GunboatFleet",
			DisplayName = "Gunboat (owned)",
			Kind = "Vehicle",
			Id = "Gunboat",
			GrantOwned = true,
		},
		{
			AtPrestige = 8,
			Flag = "AssaultArmor",
			DisplayName = "Assault IFV (owned)",
			Kind = "Vehicle",
			Id = "AssaultIFV",
			GrantOwned = true,
		},
		{
			AtPrestige = 10,
			Flag = "EmpireElite",
			DisplayName = "Empire Elite (unlocks Super Heavy)",
			Kind = "Flag",
			Id = nil,
			GrantOwned = false,
		},
		{
			AtPrestige = 12,
			Flag = "EmpireFleet",
			DisplayName = "Empire Fleet (Battleship gate)",
			Kind = "Flag",
			Id = nil,
			GrantOwned = false,
		},
		{
			AtPrestige = 15,
			Flag = "DestroyerGrant",
			DisplayName = "Destroyer (owned)",
			Kind = "Vehicle",
			Id = "Destroyer",
			GrantOwned = true,
		},
		{
			AtPrestige = 18,
			Flag = "CruiserGrant",
			DisplayName = "Cruiser (owned)",
			Kind = "Vehicle",
			Id = "Cruiser",
			GrantOwned = true,
		},
		{
			AtPrestige = 16,
			Flag = "FrigateGrant",
			DisplayName = "Frigate (owned)",
			Kind = "Vehicle",
			Id = "Frigate",
			GrantOwned = true,
		},
		{
			AtPrestige = 20,
			Flag = "StrikeWing",
			DisplayName = "Strike Jet + Heavy Bomber gate",
			Kind = "Vehicle",
			Id = "StrikeJet",
			GrantOwned = true,
		},
	} :: { RebirthUnlockDef },
}

--[[ Build player-facing fee / confirm copy from config (client + server toasts). ]]
function PrestigeConfig.BuildFeeSummary(opts: { BaseCompletionPercent: number? }?): string
	local fee = tonumber(PrestigeConfig.CashFee) or 0
	local startCash = tonumber(PrestigeConfig.StartingCashAfterPrestige) or 0
	local gold = tonumber(PrestigeConfig.GoldBonusOnPrestige) or 0
	local feePart = if fee > 0 then string.format("Fee $%s", tostring(fee)) else "Fee: none"
	local parts = {
		feePart,
		string.format("Cash → $%s after", tostring(startCash)),
		string.format("+%d Gold", gold),
		"+10% cash forever",
		"resets Level/XP/Base",
		"keeps Robux items + vehicles/weapons/gold/unlocks/outposts",
	}
	local pct = opts and tonumber(opts.BaseCompletionPercent)
	if pct ~= nil then
		table.insert(parts, 1, string.format("Base %d%% complete", math.floor(pct)))
	end
	return table.concat(parts, " · ")
end

-- F7: the reset rules a rebirth path applies (anything but "KeepBase" is the free path).
function PrestigeConfig.ResetFor(path: string?): ResetRules
	if path == "KeepBase" then
		return PrestigeConfig.ResetOnPrestigeKeepBase
	end
	return PrestigeConfig.ResetOnPrestige
end

--[[ F11: rebirth progress 0..100 (whole number). "XP" mode:
	floor(100 * min(1, (GetTotalXPForLevel(level) + xp) / GetTotalXPForLevel(MinLevelToPrestige)))
	Lv 1 = 0, Lv 20 = 17, Lv 30 = 48, Lv 39 = 93, Lv 40+ = 100 (xp 0). Junk input counts as Lv 1 / 0 XP. ]]
function PrestigeConfig.ProgressPct(level: number, xp: number?): number
	local lv = math.max(1, math.floor(tonumber(level) or 1))
	local x = math.max(0, tonumber(xp) or 0)
	if x ~= x or x == math.huge then
		x = 0
	end
	local minLv = math.max(1, tonumber(PrestigeConfig.MinLevelToPrestige) or 40)
	if lv >= minLv then
		return 100
	end
	if PrestigeConfig.ProgressMode == "Level" then
		return math.clamp(math.floor(100 * lv / minLv), 0, 100)
	end
	local goal = LevelConfig.GetTotalXPForLevel(minLv)
	if goal <= 0 then
		return 100
	end
	return math.clamp(math.floor(100 * math.min(1, (LevelConfig.GetTotalXPForLevel(lv) + x) / goal)), 0, 100)
end

-- F11: DisplayName of the rebirth unlock that the NEXT rebirth gives (AtPrestige == prestige + 1), or nil.
function PrestigeConfig.NextUnlockName(prestige: number): string?
	local target = math.floor(tonumber(prestige) or 0) + 1
	for _, u in ipairs(PrestigeConfig.RebirthUnlocks) do
		if u.AtPrestige == target then
			return u.DisplayName
		end
	end
	return nil
end

local function withCommas(n: number): string
	local s = tostring(math.floor(n))
	local sign = ""
	if string.sub(s, 1, 1) == "-" then
		sign, s = "-", string.sub(s, 2)
	end
	local out = s
	while true do
		local nextOut, k = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2")
		out = nextOut
		if k == 0 then
			break
		end
	end
	return sign .. out
end

-- One modal line: at most SummaryMaxLineChars characters (hard cut with "..." if a caller string is too long).
local function fitLine(text: string): string
	local maxChars = math.max(4, math.floor(tonumber(PrestigeConfig.SummaryMaxLineChars) or 30))
	if #text <= maxChars then
		return text
	end
	return string.sub(text, 1, maxChars - 3) .. "..."
end

-- "Unlocks <name>": drops a "(...)" note, then a "+ second item", before cutting (keeps the line readable).
local function unlockLine(name: string): string
	local maxChars = math.max(4, math.floor(tonumber(PrestigeConfig.SummaryMaxLineChars) or 30))
	local line = "Unlocks " .. name
	if #line > maxChars then
		local short = string.gsub(name, "%s*%b()%s*$", "")
		line = "Unlocks " .. short
		if #line > maxChars then
			local first = string.match(short, "^(.-)%s+%+%s+")
			if first and #first > 0 then
				line = "Unlocks " .. first
			end
		end
	end
	return fitLine(line)
end

--[[ F11 (and F7): the Rebirth confirm modal columns. Built from ResetFor(path), so the lines always say what the
	server's DoPrestige does on that path. Lines are at most SummaryMaxLineChars (30) characters, use two spaces as the
	separator and never contain a middle dot or an arrow (phone fonts, short labels).
	  KEEP  (both) Robux items and passes / Gold (+50 Gold) / Vehicles and weapons / Soldiers and research /
	              Outposts and Empire Tax / Rebirth unlocks / Battle Pass progress;  KeepBase adds Base buildings and levels
	  RESET (both) Cash back to $10,000 / Level 1 and XP 0;  Cash adds Base buildings (N built) and, while
	              ctx.BusinessesOn, War businesses
	  GAIN  +10% cash forever / Total now +N% / Unlocks <next rebirth unlock> (when this rebirth gives one)
	PendingCash (the ATM) is kept on both paths and is not listed (owner decision). ]]
function PrestigeConfig.RebirthSummary(path: RebirthPath, ctx: RebirthSummaryCtx): RebirthSummary
	local reset = PrestigeConfig.ResetFor(path)
	local keep: { string } = {}
	local resetLines: { string } = {}
	local gain: { string } = {}
	local function add(list: { string }, text: string)
		table.insert(list, fitLine(text))
	end

	local goldBonus = math.max(0, math.floor(tonumber(PrestigeConfig.GoldBonusOnPrestige) or 0))
	add(keep, "Robux items and passes")
	if reset.KeepGold then
		add(keep, if goldBonus > 0 then string.format("Gold (+%d Gold)", goldBonus) else "Gold")
	end
	if reset.KeepVehicles and reset.KeepWeapons then
		add(keep, "Vehicles and weapons")
	elseif reset.KeepVehicles then
		add(keep, "Vehicles")
	elseif reset.KeepWeapons then
		add(keep, "Weapons")
	end
	add(keep, "Soldiers and research")
	add(keep, "Outposts and Empire Tax")
	if reset.KeepRebirthUnlocks then
		add(keep, "Rebirth unlocks")
	end
	add(keep, "Battle Pass progress")
	if not reset.BaseUpgrades then
		add(keep, "Base buildings and levels")
	end

	if reset.Cash then
		add(resetLines, "Cash back to $" .. withCommas(tonumber(PrestigeConfig.StartingCashAfterPrestige) or 0))
	else
		add(keep, "Your Cash")
	end
	if reset.Level and reset.XP then
		add(resetLines, "Level 1 and XP 0")
	elseif reset.Level then
		add(resetLines, "Level 1")
	elseif reset.XP then
		add(resetLines, "XP 0")
	end
	if reset.BaseUpgrades then
		add(resetLines, string.format("Base buildings (%d built)", math.max(0, math.floor(tonumber(ctx.Built) or 0))))
		if ctx.BusinessesOn == true then
			add(resetLines, "War businesses")
		end
	end

	local perPct = math.floor((tonumber(PrestigeConfig.CashBonusPerPrestige) or 0.10) * 100 + 0.5)
	local after = math.max(0, math.floor(tonumber(ctx.Prestige) or 0)) + 1
	add(gain, string.format("+%d%% cash forever", perPct))
	add(gain, string.format("Total now +%d%%", after * perPct))
	if typeof(ctx.NextUnlock) == "string" and ctx.NextUnlock ~= "" then
		table.insert(gain, unlockLine(ctx.NextUnlock))
	end

	return { Keep = keep, Reset = resetLines, Gain = gain }
end

return PrestigeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">RaidConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v69 ATM raids + Command Center missile strikes — ONE balance file for both.
	Read by MoneyCollectorService (raids), MissileStrikeService (strikes), GateDefenseService (defense fixes).
	Clients do not require this file (every number they show arrives in a remote payload).

	Timers that must survive leaving / rejoining / server hopping live on the profile as os.time() values:
	  profile.Raid.ShieldUntil          victim: no raids (and no strikes) until then
	  profile.Raid.RaidCooldownUntil    thief: next raid allowed at (new key; missing → 0)
	  profile.Raid.StrikeCooldownUntil  attacker: next missile allowed at
	  profile.Raid.DefensesDownUntil    victim: GateDefense guards/AutoGuns/gate are down until then
]]

local RaidConfig = {
	Raid = {
		Enabled = true,
		StealFraction = 0.10, -- owner rule: 10% of what is in the victim's ATM
		MinVictimBalance = 100, -- ATM must hold at least this much to be robbed
		MinSteal = 1,
		HoldSeconds = 6, -- stand at the victim's ATM this long: on foot, alive, not damaged
		RadiusStuds = 10, -- horizontal distance from the ATM body (same as the collect radius)
		MaxHeightDelta = 14,
		DamageCancelHp = 0.5, -- a health drop bigger than this between two ticks cancels the hold
		ShieldSeconds = 600, -- owner rule: the victim cannot be robbed again for 10 minutes
		ThiefCooldownSeconds = 60, -- per thief, after a successful raid (any victim)
		NewPlayerProtectionSeconds = 600, -- since profile.FirstJoinUnix
		ProtectNewPlayersInStudio = false, -- Studio test servers make fresh profiles every run
		RequireOnFoot = true, -- Humanoid.SeatPart must be nil
		AllowAllies = false, -- clan-mates cannot rob each other
		TeleportStuds = 60, -- HRP moved further than this in one 0.25 s tick (on foot, same character) → teleport
		TeleportLockoutSeconds = 15,
		AutoCollectCountsRecentIncome = true, -- AutoCollect is not raid immunity (see spec §1.5)
		AutoCollectWindowSeconds = 600,
		HoldPushInterval = 0.25, -- AtmRaidStateUpdate "Holding" cadence to the thief
		AlarmPushInterval = 1.0, -- "Alarm" cadence to the victim
		BlockedPushInterval = 3, -- same "Blocked" reason is re-sent at most this often
		VictimAlarmToastCooldown = 15,
	},

	Strike = {
		Enabled = true,
		-- "the upgrade": Command Center L3 + Missile Defense L1 (Missile Defense needs Radar L2 → CC L2)
		Unlock = { CommandCenter = 3, MissileDefense = 1 } :: { [string]: number },
		Cost = 5000,
		CooldownSeconds = 600, -- attacker, after a launch (profile.Raid.StrikeCooldownUntil)
		InterceptedCooldownSeconds = 300, -- attacker cooldown when the missile was shot down
		LaunchMaxDistanceFromCC = 45, -- server check: attacker HRP (horizontal) from own Command Center site
		MissileSpeed = 220, -- studs/s → flight = clamp(distance / speed, Min, Max)
		MinFlightSeconds = 5,
		MaxFlightSeconds = 9,
		ArcHeightMin = 150,
		ArcHeightFactor = 0.35, -- arc apex = clamp(distance * factor, Min, Max) above the chord midpoint
		ArcHeightMax = 400,
		DefensesDownSeconds = 120, -- at attacker CC L3
		DownBonusPerCCLevel = 30, -- per attacker CC level above 3 → L4 150 s, L5 180 s
		PostDownImmunitySeconds = 300, -- no new strike on a base until DefensesDownUntil + this
		-- victim Missile Defense level → chance the strike is shot down
		InterceptChanceByLevel = { [0] = 0, [1] = 0.15, [2] = 0.25, [3] = 0.35, [4] = 0.45, [5] = 0.55 } :: { [number]: number },
		PenetrationPerAttackerMDLevel = 0.05, -- per attacker MD level above 1 (L5 → −0.20)
		MaxInterceptChance = 0.75,
		InterceptAtMin = 0.72, -- interceptor meets the missile at this fraction of the flight (random in [min, max])
		InterceptAtMax = 0.84,
		RefundIfTargetLeaves = true,
		RequestRate = 2, -- RequestMissileStrike, all actions (tokens/s)
		RequestBurst = 4,
		LaunchRate = 0.5, -- "Launch" additionally
		LaunchBurst = 2,
	},

	Defense = {
		-- guards stand this far INSIDE the gate line (toward PlayerSpawn). Measured on the v68 map: guns at 7.5 keep
		-- 4.35 studs off the L5 wall face (half-thickness 3.15) and clear the checkpoint boom post; guards at 10
		-- stand clear of the gun tripods and the booth / jersey barriers (spec had 8 / 7: guns 3.85 from the L5 wall)
		GuardPostInsideStuds = 10,
		AutoGunInsideStuds = 7.5,
		GateOpenRadius = 12, -- an ally within this (horizontal) of the gate centre opens the barrier
		GateOpenHeight = 12,
		GateCloseDelay = 1.0,
		LosRespectCanCollide = true, -- guard/AutoGun line of sight ignores non-collidable decor
		EngageIntrudersInsideWalls = true, -- any non-ally inside the plot walls is in aggro
		GuardHitMaxDistance = 150, -- weapon hits on guards: attacker HRP within this of the guard
		ResearchStat = "TurretDamage", -- ResearchService.GetBonus(owner, stat) × guard + AutoGun damage
		MaxResearchMult = 5,
	},

	Text = {
		-- raids (thief)
		RaidHolding = "ROBBING %s's ATM · %.1f/%ds — don't get hit!",
		RaidSuccess = "ATM RAID +$%s from %s → your ATM",
		RaidHit = "Hit! Raid interrupted — clear the defenders first",
		RaidLeft = "Left the ATM — raid cancelled",
		RaidVictimLeft = "The owner left the server",
		RaidEmptied = "The owner emptied the ATM",
		RaidDead = "You went down — raid cancelled",
		RaidHint = "Stand on %s's ATM for %ds to rob it — don't get hit",
		-- raids (victim)
		RaidAlarm = "⚠ %s is robbing your ATM!",
		RaidRobbed = "ATM RAIDED by %s −$%s · 🛡 shield %s",
		RaidDefended = "Raid on your ATM stopped",
		-- raid blocked reasons
		Blocked = {
			Disabled = "Raids are switched off",
			Ally = "Clan ally's ATM — can't rob allies",
			NoBase = "Get a base first — loot goes to your ATM",
			ThiefLoading = "Your save is still loading",
			VictimLoading = "Their save is still loading",
			Shielded = "🛡 Robbed recently — shielded %s",
			NewPlayer = "New player protection — %s",
			LowBalance = "ATM almost empty ($%s)",
			ThiefCooldown = "Raid cooldown %s",
			Seated = "Get out of the vehicle to rob the ATM",
			Teleport = "Raid blocked — moved too fast",
		} :: { [string]: string },
		-- strikes
		StrikeLocked = "Needs Command Center L%d + Missile Defense L%d",
		StrikeLaunched = "Missile away → %s · impact %ds",
		StrikeHit = "Direct hit! %s's defenses down %s — go raid!",
		StrikeIntercepted = "Intercepted by %s's Missile Defense",
		StrikeRefunded = "%s left — missile refunded",
		StrikeIncoming = "⚠ INCOMING MISSILE from %s — impact %ds",
		StrikeVictimHit = "💥 Missile hit! Defenses down %s — protect your ATM!",
		StrikeVictimIntercepted = "✓ Your Missile Defense shot down %s's missile",
		DefensesBack = "Defenses back online",
		StrikeReasons = {
			Locked = "Needs Command Center L3 + Missile Defense L1",
			NotAtCommandCenter = "Use the Missile Command terminal in your Command Center",
			NoBase = "You need a base",
			Loading = "Your save is still loading",
			Cooldown = "Reloading — %s",
			InFlight = "Your missile is still in the air",
			InsufficientCash = "Need $%s",
			Self = "That's your base",
			Ally = "Clan ally",
			TargetOffline = "Player left",
			TargetLoading = "Their save is still loading",
			NewPlayer = "New player protection — %s",
			Shielded = "🛡 Shielded %s",
			AlreadyDown = "Defenses already down %s",
			Recovering = "Defenses rebooting — %s",
			Incoming = "Another missile is inbound",
			NoDefenses = "No defenses to hit — just raid the ATM",
			Busy = "Too fast — try again",
			Disabled = "Missile strikes are switched off",
		} :: { [string]: string },
	},
}

-- "m:ss" for countdowns (0 → "0:00")
function RaidConfig.FormatTime(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- Chance (0..MaxInterceptChance) that a strike from an attacker with Missile Defense `attackerMd` is shot down
-- by a victim with Missile Defense `victimMd`.
function RaidConfig.InterceptChance(victimMd: number, attackerMd: number): number
	local s = RaidConfig.Strike
	local lv = math.clamp(math.floor(victimMd), 0, 5)
	local base = s.InterceptChanceByLevel[lv] or 0
	local pen = math.max(0, math.floor(attackerMd) - 1) * s.PenetrationPerAttackerMDLevel
	return math.clamp(base - pen, 0, s.MaxInterceptChance)
end

-- Seconds a hit keeps the target's defenses down, from the attacker's Command Center level.
function RaidConfig.DownSeconds(attackerCc: number): number
	local s = RaidConfig.Strike
	local above = math.max(0, math.floor(attackerCc) - s.Unlock.CommandCenter)
	return s.DefensesDownSeconds + above * s.DownBonusPerCCLevel
end

function RaidConfig.FlightSeconds(distance: number): number
	local s = RaidConfig.Strike
	return math.clamp(distance / s.MissileSpeed, s.MinFlightSeconds, s.MaxFlightSeconds)
end

function RaidConfig.ArcHeight(distance: number): number
	local s = RaidConfig.Strike
	return math.clamp(distance * s.ArcHeightFactor, s.ArcHeightMin, s.ArcHeightMax)
end

return RaidConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">RebirthConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): Rebirth expansion.
	Zones that open with rebirth, per-rebirth perks, base trims, titles, and the Robux hook keys. Geometry lives in
	BaseLayoutConfig (M7b, using the waterways PlotCFrame / PlotLocalCFrame helpers, J18); each rebirth structure
	names its zone in BaseConfig.Structures[id].Zone (M7a).

	Pure helpers only. The server is the authority (RebirthExpansionService, PrestigeService, BaseService);
	the client calls the same helpers for display and never trusts them for grants.
	Config only: nothing reads this file yet. ZonesLive / WeaponsLive stay false until the M7b + M7d publish.

	Judge rulings applied (money/plan.md §1):
	- J12: the Expansion Permit and Rebirth Skip products are cut this round (no config entries, no
	  NextPermitZone, no profile counters). Revisit after 2 weeks of rebirth KPIs.
	  Superseded in part by the owner's 11 features (F7, ASSUMPTIONS): the 50 R$ Keep-Base Rebirth
	  (MonetizationConfig.DevProducts.RebirthKeepBase) is a consumable token counted in profile.KeepBaseRebirths and
	  spent by PrestigeService (PrestigeConfig.KeepBase); the rebirth runs after the receipt is saved, never inside it.
	  The Expansion Permit stays cut.
	- J13: Rebirth Boost is +15% cash per rebirth (instead of +10%) and 1.5x starting cash. Gold stays x1
	  (Boost.GoldMult = 1) until a Gold sink ships; then raise it together with the pass description. ]]

export type ZoneDef = {
	Id: string,
	Tier: number, -- opens at Prestige >= Tier
	DisplayName: string,
	Structures: { string },
	Parent: string?, -- nested zone (DroneBay sits inside StrategicYard)
}

export type TrimDef = {
	Id: string,
	DisplayName: string,
	MinPrestige: number,
	Trim: Color3, -- building trim, gate lintel, fence posts, flag finials
	Accent: Color3, -- banner field, sign text
	Gold: Color3, -- parapet caps / edge bands (HollowBuildingBuilder Colors.Gold)
	GoldCapAllLevels: boolean, -- gold parapet on every walk-in from L1 (not only L5)
	NeonEdge: boolean, -- thin neon strip along the plot pad edge
}

local RebirthConfig = {
	Enabled = true,
	-- Publish switches (M7b / M7d flip them in the release that ships the world and the guns)
	ZonesLive = false, -- locked-zone fences, rebirth structures and zone gating in BaseService
	WeaponsLive = false, -- the 7 rebirth guns (WeaponConfig RequiresPrestige rows)

	Zones = {
		WestYard = { Id = "WestYard", Tier = 1, DisplayName = "West Yard", Structures = { "TankFactory" } },
		StrategicYard = { Id = "StrategicYard", Tier = 2, DisplayName = "Strategic Yard", Structures = { "NuclearSilo" } },
		WestStrip = { Id = "WestStrip", Tier = 3, DisplayName = "West Battery", Structures = { "ArtilleryBattery" } },
		DroneBay = {
			Id = "DroneBay",
			Tier = 4,
			DisplayName = "Drone Bay",
			Structures = { "DroneHangar" },
			Parent = "StrategicYard",
		},
		EastYard = { Id = "EastYard", Tier = 5, DisplayName = "East Yard", Structures = { "EliteBarracks" } },
		EastStrip = { Id = "EastStrip", Tier = 6, DisplayName = "Refinery Row", Structures = { "OilRefinery" } },
		WestFlank = { Id = "WestFlank", Tier = 8, DisplayName = "West Flank", Structures = { "BunkerComplex" } },
	} :: { [string]: ZoneDef },
	ZoneOrder = { "WestYard", "StrategicYard", "WestStrip", "DroneBay", "EastYard", "EastStrip", "WestFlank" },

	Perks = {
		-- Army cap: +2 soldiers per rebirth (cap +40). Elite Barracks adds +5 per level on top (BaseConfig Effects).
		SoldiersPerPrestige = 2,
		MaxPrestigeSoldierBonus = 40,
		-- Cash you start each new run with: highest key <= Prestige wins (replaces the flat 10,000).
		StartingCashSteps = {
			{ AtPrestige = 1, Cash = 25_000 },
			{ AtPrestige = 2, Cash = 35_000 },
			{ AtPrestige = 3, Cash = 50_000 },
			{ AtPrestige = 4, Cash = 65_000 },
			{ AtPrestige = 5, Cash = 80_000 },
			{ AtPrestige = 6, Cash = 100_000 },
			{ AtPrestige = 10, Cash = 150_000 },
			{ AtPrestige = 20, Cash = 250_000 },
		},
		-- Gold on each rebirth: 50 + 10 per rebirth, max 250 (was a flat 50).
		GoldBase = 50,
		GoldPerPrestige = 10,
		GoldMax = 250,
		-- Rebirth grants in PrestigeConfig.RebirthUnlocks (GrantOwned vehicles) can be spawned at any Level /
		-- structure level: a reward you cannot use until you re-level is not a reward.
		GrantedVehiclesIgnoreRunGates = true,
	},

	-- Robux hooks. Keys point at MonetizationConfig entries; every one is hidden while its Id is 0.
	Boost = {
		GamePassKey = "RebirthBoost", -- NEW game pass (M1 adds the key with Id = 0; created OFF sale, J3)
		ExtraCashPerPrestige = 0.05, -- +15% per rebirth instead of +10% (retroactive: applies to past rebirths)
		GoldMult = 1, -- J13: Gold has no sink yet; x2 only with a Gold sink + a pass description update
		StartingCashMult = 1.5,
	},
	EliteThemePassKey = "ExtraPlotCosmetic", -- EXISTING live pass "Elite Base Theme" (Id 1983357731), finally implemented

	Trims = {
		{
			Id = "Standard",
			DisplayName = "Standard",
			MinPrestige = 0,
			Trim = Color3.fromRGB(78, 92, 62),
			Accent = Color3.fromRGB(230, 196, 70),
			Gold = Color3.fromRGB(240, 196, 64),
			GoldCapAllLevels = false,
			NeonEdge = false,
		},
		{
			Id = "Bronze",
			DisplayName = "Bronze",
			MinPrestige = 1,
			Trim = Color3.fromRGB(150, 98, 52),
			Accent = Color3.fromRGB(214, 150, 86),
			Gold = Color3.fromRGB(205, 127, 50),
			GoldCapAllLevels = false,
			NeonEdge = false,
		},
		{
			Id = "Silver",
			DisplayName = "Silver",
			MinPrestige = 3,
			Trim = Color3.fromRGB(150, 156, 164),
			Accent = Color3.fromRGB(222, 228, 236),
			Gold = Color3.fromRGB(196, 202, 210),
			GoldCapAllLevels = false,
			NeonEdge = false,
		},
		{
			Id = "Gold",
			DisplayName = "Gold",
			MinPrestige = 5,
			Trim = Color3.fromRGB(176, 140, 44),
			Accent = Color3.fromRGB(255, 214, 90),
			Gold = Color3.fromRGB(240, 196, 64),
			GoldCapAllLevels = true,
			NeonEdge = false,
		},
		{
			Id = "Platinum",
			DisplayName = "Platinum",
			MinPrestige = 10,
			Trim = Color3.fromRGB(200, 210, 220),
			Accent = Color3.fromRGB(120, 220, 255),
			Gold = Color3.fromRGB(226, 234, 242),
			GoldCapAllLevels = true,
			NeonEdge = true,
		},
		{
			Id = "Obsidian",
			DisplayName = "Obsidian",
			MinPrestige = 20,
			Trim = Color3.fromRGB(34, 34, 40),
			Accent = Color3.fromRGB(255, 196, 64),
			Gold = Color3.fromRGB(255, 196, 64),
			GoldCapAllLevels = true,
			NeonEdge = true,
		},
	} :: { TrimDef },
	-- Elite Base Theme pass: at least Gold at any Prestige; Platinum+ players keep their higher trim.
	EliteThemeMinTrim = "Gold",

	-- Cosmetic dressing unlocked by rebirth count (all Part-built, <= 40 parts per plot in total).
	Dressing = {
		GateBannersAt = 1, -- two vertical banners either side of the main gate: "★ n"
		CommandCenterBannerAt = 3,
		WalkInBannersAt = 5, -- one banner on every walk-in facade
		EmpireBeaconAt = 10, -- a tall light beam from the Command Center roof, visible across the map
		JoinFireworksAt = 25,
		CommanderStatueAt = 50,
	},

	Titles = {
		{ AtPrestige = 1, Title = "Veteran" },
		{ AtPrestige = 3, Title = "Commander" },
		{ AtPrestige = 5, Title = "General" },
		{ AtPrestige = 10, Title = "Marshal" },
		{ AtPrestige = 20, Title = "Legend" },
		{ AtPrestige = 30, Title = "Mythic" },
		{ AtPrestige = 50, Title = "Supreme Commander" },
	},
	LeaderstatName = "Rebirths",

	-- How a locked zone looks (StructureKitBuilder.SyncExpansionZones)
	LockedLook = {
		FenceHeight = 8,
		PostSpacing = 16,
		PostColor = Color3.fromRGB(58, 60, 58),
		MeshColor = Color3.fromRGB(40, 42, 40),
		MeshTransparency = 0.55,
		HazardColor = Color3.fromRGB(230, 196, 70),
		SignColor = Color3.fromRGB(170, 28, 28),
		HologramColor = Color3.fromRGB(88, 200, 255),
		HologramTransparency = 0.7,
		LabelMaxDistance = 60, -- WorldLabelPolicy
	},
}

local function stepValue(steps: { { AtPrestige: number, Cash: number } }, prestige: number, default: number): number
	local best = default
	for _, s in ipairs(steps) do
		if prestige >= s.AtPrestige then
			best = s.Cash
		end
	end
	return best
end

-- Zone id for a structure, or nil for the 15 base structures.
function RebirthConfig.ZoneOfStructure(structureId: string): string?
	for id, z in pairs(RebirthConfig.Zones) do
		for _, sid in ipairs(z.Structures) do
			if sid == structureId then
				return id
			end
		end
	end
	return nil
end

-- A zone is open when Prestige reached its tier. `extraOpen` is a session-only override (the admin `openzone`
-- command); the Expansion Permit that used to feed it was cut (J12). A nested zone also needs its parent open.
function RebirthConfig.IsZoneOpen(prestige: number, extraOpen: { [string]: boolean }?, zoneId: string): boolean
	if not RebirthConfig.Enabled then
		return false
	end
	local z = RebirthConfig.Zones[zoneId]
	if not z then
		return false
	end
	local open = prestige >= z.Tier or (extraOpen ~= nil and extraOpen[zoneId] == true)
	if open and z.Parent ~= nil then
		return RebirthConfig.IsZoneOpen(prestige, extraOpen, z.Parent)
	end
	return open
end

-- Structures outside every zone are always "open".
function RebirthConfig.IsStructureOpen(prestige: number, extraOpen: { [string]: boolean }?, structureId: string): boolean
	local zoneId = RebirthConfig.ZoneOfStructure(structureId)
	if zoneId == nil then
		return true
	end
	return RebirthConfig.IsZoneOpen(prestige, extraOpen, zoneId)
end

function RebirthConfig.StartingCash(prestige: number, boosted: boolean): number
	local cash = stepValue(RebirthConfig.Perks.StartingCashSteps, prestige, 10_000)
	if boosted then
		cash = math.floor(cash * RebirthConfig.Boost.StartingCashMult)
	end
	return cash
end

function RebirthConfig.GoldBonus(prestige: number, boosted: boolean): number
	local p = RebirthConfig.Perks
	local gold = math.min(p.GoldMax, p.GoldBase + p.GoldPerPrestige * math.max(0, prestige - 1))
	if boosted then
		gold *= RebirthConfig.Boost.GoldMult
	end
	return math.floor(gold)
end

-- +cash per rebirth as a fraction (0.10, or 0.15 with Rebirth Boost). Callers apply 1 + prestige * this.
function RebirthConfig.CashBonusPerPrestige(baseBonus: number, boosted: boolean): number
	if boosted then
		return baseBonus + RebirthConfig.Boost.ExtraCashPerPrestige
	end
	return baseBonus
end

function RebirthConfig.PrestigeSoldierBonus(prestige: number): number
	local p = RebirthConfig.Perks
	return math.min(p.MaxPrestigeSoldierBonus, math.max(0, prestige) * p.SoldiersPerPrestige)
end

function RebirthConfig.TrimFor(prestige: number, eliteThemePass: boolean): TrimDef
	local best = RebirthConfig.Trims[1]
	for _, t in ipairs(RebirthConfig.Trims) do
		if prestige >= t.MinPrestige then
			best = t
		end
	end
	if eliteThemePass then
		local floorIdx = 1
		local bestIdx = 1
		for i, t in ipairs(RebirthConfig.Trims) do
			if t.Id == RebirthConfig.EliteThemeMinTrim then
				floorIdx = i
			end
			if t.Id == best.Id then
				bestIdx = i
			end
		end
		if bestIdx < floorIdx then
			best = RebirthConfig.Trims[floorIdx]
		end
	end
	return best
end

function RebirthConfig.TitleFor(prestige: number): string?
	local title: string? = nil
	for _, t in ipairs(RebirthConfig.Titles) do
		if prestige >= t.AtPrestige then
			title = t.Title
		end
	end
	return title
end

return RebirthConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ResearchConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v69 Research Lab tree — shared by ResearchService (server, authoritative) and ResearchController (display only).

	Research is PERMANENT: PrestigeService never touches profile.Research, so bonuses keep applying after a
	Rebirth (the Lab resets, so buying NEW levels needs the Lab again). Cash only; prices here are read by the
	server — the client only displays payload.Costs.

	Gating: target level L needs Research Lab >= L (LabLevels overrides, e.g. Squad Expansion 2/4/5), and each
	track needs its building (Tracks[*].Requires). All effects are additive per level:
	  Kind "Mult": ResearchService.GetBonus(player, Stat) = 1 + Σ PerLevel × level   (always >= 1, bigger = stronger;
	               time-like stats divide by it, e.g. reload time = base ÷ mult)
	  Kind "Add" : ResearchService.GetAdd(player, Stat)   = Σ PerLevel × level        (>= 0)
	An upgrade whose game hook is missing ships with Enabled = false (card shows SOON, server refuses "Disabled").
	Full tree: $4,048,000.
]]

export type TrackDef = {
	Id: string,
	DisplayName: string,
	Order: number,
	Blurb: string,
	Requires: { StructureId: string, Level: number, Text: string, Short: string }?,
}

export type UpgradeDef = {
	Id: string,
	Track: string,
	Order: number,
	DisplayName: string,
	Badge: string,
	Stat: string, -- statId for ResearchService.GetBonus (Kind "Mult") / GetAdd (Kind "Add")
	Kind: string, -- "Mult" | "Add"
	PerLevel: number,
	MaxLevel: number,
	Costs: { number }, -- Cash for target level 1..MaxLevel (index = target level)
	LabLevels: { number }?, -- Research Lab level needed per target level; nil = target level
	EffectText: string, -- string.format(EffectText, FormatAmount(...)) e.g. "%s weapon damage"
	Note: string?,
	Enabled: boolean,
}

export type ResearchLock = { Code: string, Text: string } -- Code: "Disabled" | "Maxed" | "NeedStructure" | "NeedLab"

export type ResearchStatePayload = {
	LabLevel: number,
	Levels: { [string]: number }, -- EVERY upgrade id (0 = none)
	Costs: { [string]: number }, -- next-level Cash price; id absent when maxed
	Locks: { [string]: ResearchLock }, -- id present only when the next level is blocked for a non-cash reason
	Tracks: { [string]: ResearchLock }, -- track id present only when the whole track is locked
}

local ResearchConfig = {}

ResearchConfig.StructureId = "ResearchLab"

-- RequestResearch rate limits (per player): Buy taps and Sync requests. Over-limit taps are dropped with a
-- throttled toast — never an AntiExploit strike.
ResearchConfig.BuyRate = 2
ResearchConfig.BuyBurst = 4
ResearchConfig.SyncRate = 1
ResearchConfig.SyncBurst = 3

ResearchConfig.MaxMult = 3 -- sanity clamp on any Mult stat

ResearchConfig.Roman = { "I", "II", "III", "IV", "V" }

-- Also the WE_OpenTab values on Research Lab terminals.
ResearchConfig.TrackOrder = { "Weapons", "Soldiers", "Vehicles", "Defenses" }

ResearchConfig.StatIds = {
	"WeaponDamage",
	"WeaponFireRate",
	"WeaponMagazine",
	"WeaponReload",
	"SoldierHealth",
	"SoldierDamage",
	"VehicleSpeed",
	"VehicleArmor",
	"TurretDamage",
	"SquadSize",
}

ResearchConfig.Tracks = {
	Weapons = {
		Id = "Weapons",
		DisplayName = "Weapons",
		Order = 1,
		Blurb = "Upgrades every gun you carry.",
		Requires = nil,
	},
	Soldiers = {
		Id = "Soldiers",
		DisplayName = "Soldiers",
		Order = 2,
		Blurb = "Upgrades the squad that follows your orders.",
		Requires = {
			StructureId = "Barracks",
			Level = 1,
			Text = "Build the Barracks to unlock soldier research",
			Short = "NEEDS BARRACKS",
		},
	},
	Vehicles = {
		Id = "Vehicles",
		DisplayName = "Vehicles",
		Order = 3,
		Blurb = "Upgrades every vehicle you deploy.",
		Requires = {
			StructureId = "VehicleDepot",
			Level = 1,
			Text = "Build the Vehicle Depot to unlock vehicle research",
			Short = "NEEDS DEPOT",
		},
	},
	Defenses = {
		Id = "Defenses",
		DisplayName = "Defenses",
		Order = 4,
		Blurb = "Upgrades your gate guards and machine-gun nests.",
		Requires = {
			StructureId = "DefensiveWalls",
			Level = 1,
			Text = "Build Defensive Walls to unlock defense research",
			Short = "NEEDS WALLS",
		},
	},
} :: { [string]: TrackDef }

ResearchConfig.Upgrades = {
	-- ── Weapons (every gun the player carries; CombatService) ──────────────────────────────────────────
	Ballistics = {
		Id = "Ballistics",
		Track = "Weapons",
		Order = 1,
		DisplayName = "Ballistics",
		Badge = "DMG",
		Stat = "WeaponDamage",
		Kind = "Mult",
		PerLevel = 0.04,
		MaxLevel = 5,
		Costs = { 3000, 12000, 40000, 110000, 300000 },
		EffectText = "%s weapon damage",
		Enabled = true,
	},
	FireControl = {
		Id = "FireControl",
		Track = "Weapons",
		Order = 2,
		DisplayName = "Fire Control",
		Badge = "ROF",
		Stat = "WeaponFireRate",
		Kind = "Mult",
		PerLevel = 0.03,
		MaxLevel = 5,
		Costs = { 2500, 10000, 35000, 95000, 260000 },
		EffectText = "%s fire rate",
		Enabled = true,
	},
	ExtendedMags = {
		Id = "ExtendedMags",
		Track = "Weapons",
		Order = 3,
		DisplayName = "Extended Mags",
		Badge = "MAG",
		Stat = "WeaponMagazine",
		Kind = "Mult",
		PerLevel = 0.08,
		MaxLevel = 5,
		Costs = { 2000, 8000, 28000, 80000, 220000 },
		EffectText = "%s magazine size",
		Note = "Rockets and grenades stay single-shot",
		Enabled = true,
	},
	ReloadDrills = {
		Id = "ReloadDrills",
		Track = "Weapons",
		Order = 4,
		DisplayName = "Reload Drills",
		Badge = "RLD",
		Stat = "WeaponReload",
		Kind = "Mult",
		PerLevel = 0.06,
		MaxLevel = 5,
		Costs = { 2000, 8000, 28000, 80000, 220000 },
		EffectText = "%s reload speed",
		Enabled = true,
	},
	-- ── Soldiers (field squad; SquadOrdersService) ─────────────────────────────────────────────────────
	BodyArmor = {
		Id = "BodyArmor",
		Track = "Soldiers",
		Order = 1,
		DisplayName = "Body Armor",
		Badge = "HP",
		Stat = "SoldierHealth",
		Kind = "Mult",
		PerLevel = 0.10,
		MaxLevel = 5,
		Costs = { 2500, 10000, 32000, 90000, 240000 },
		EffectText = "%s squad health",
		Enabled = true,
	},
	MarksmanTraining = {
		Id = "MarksmanTraining",
		Track = "Soldiers",
		Order = 2,
		DisplayName = "Marksman Training",
		Badge = "AIM",
		Stat = "SoldierDamage",
		Kind = "Mult",
		PerLevel = 0.10,
		MaxLevel = 5,
		Costs = { 2500, 10000, 32000, 90000, 240000 },
		EffectText = "%s squad damage",
		Enabled = true,
	},
	SquadExpansion = {
		Id = "SquadExpansion",
		Track = "Soldiers",
		Order = 3,
		DisplayName = "Squad Expansion",
		Badge = "SQD",
		Stat = "SquadSize",
		Kind = "Add",
		PerLevel = 1,
		MaxLevel = 3,
		Costs = { 15000, 90000, 250000 },
		LabLevels = { 2, 4, 5 },
		EffectText = "%s soldiers in your field squad",
		Note = "Needs 1 recruited soldier per unit",
		Enabled = true,
	},
	-- ── Vehicles (VehicleService, vehicles workflow; read at deploy time) ──────────────────────────────
	EngineTuning = {
		Id = "EngineTuning",
		Track = "Vehicles",
		Order = 1,
		DisplayName = "Engine Tuning",
		Badge = "SPD",
		Stat = "VehicleSpeed",
		Kind = "Mult",
		PerLevel = 0.04,
		MaxLevel = 5,
		Costs = { 3000, 12000, 38000, 100000, 280000 },
		EffectText = "%s vehicle speed",
		Note = "Applies when you deploy a vehicle",
		Enabled = true, -- v70: VehicleService applies VehicleSpeed at spawn + OnResearchChanged for a deployed vehicle
	},
	CompositeArmor = {
		Id = "CompositeArmor",
		Track = "Vehicles",
		Order = 2,
		DisplayName = "Composite Armor",
		Badge = "AMR",
		Stat = "VehicleArmor",
		Kind = "Mult",
		PerLevel = 0.08,
		MaxLevel = 5,
		Costs = { 3500, 14000, 45000, 120000, 320000 },
		EffectText = "%s vehicle armor",
		Note = "Your vehicles take less damage",
		-- W2: ON. Vehicles take damage now (VehicleHealth): MaxHP = def.Health × WE_ArmorMult (clamped to
		-- VehicleCombatConfig.Health.ArmorMultClamp {1, 1.5}; 5 levels = ×1.40). VehicleService writes WE_ArmorMult at
		-- deploy and on OnResearchChanged; the deployed vehicle's MaxHP rescales and keeps its HP fraction.
		Enabled = true,
	},
	-- ── Defenses (GateDefenseService, raids/defenses workflow) ─────────────────────────────────────────
	TargetingSystems = {
		Id = "TargetingSystems",
		Track = "Defenses",
		Order = 1,
		DisplayName = "Targeting Systems",
		Badge = "DEF",
		Stat = "TurretDamage",
		Kind = "Mult",
		PerLevel = 0.08,
		MaxLevel = 5,
		Costs = { 3000, 12000, 40000, 110000, 300000 },
		EffectText = "%s gate guard and auto-gun damage",
		Enabled = true,
	},
} :: { [string]: UpgradeDef }

--[[ Upgrades of one track sorted by Order (disabled ones included — the card shows SOON). ]]
function ResearchConfig.UpgradesForTrack(trackId: string): { UpgradeDef }
	local out: { UpgradeDef } = {}
	if typeof(trackId) ~= "string" then
		return out
	end
	for _, def in pairs(ResearchConfig.Upgrades) do
		if def.Track == trackId then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a: UpgradeDef, b: UpgradeDef): boolean
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		return a.Id < b.Id
	end)
	return out
end

--[[ Owned level of an upgrade from a profile.Research table. Junk (non-table research, non-number / NaN
	level, unknown id) → 0; otherwise floor, clamped to 0..MaxLevel. ]]
function ResearchConfig.LevelOf(research: any, id: string): number
	if typeof(research) ~= "table" or typeof(id) ~= "string" then
		return 0
	end
	local def = ResearchConfig.Upgrades[id]
	if def == nil then
		return 0
	end
	local v = rawget(research, id)
	if typeof(v) ~= "number" or v ~= v then
		return 0
	end
	return math.clamp(math.floor(v), 0, def.MaxLevel)
end

--[[ Research Lab level needed to buy `targetLevel` of `def`. ]]
function ResearchConfig.LabLevelFor(def: UpgradeDef, targetLevel: number): number
	if typeof(def) ~= "table" then
		return targetLevel
	end
	local labLevels = def.LabLevels
	if labLevels ~= nil and typeof(labLevels) == "table" then
		local v = labLevels[targetLevel]
		if typeof(v) == "number" then
			return v
		end
	end
	return targetLevel
end

--[[ 1 + Σ PerLevel × level over Kind "Mult" upgrades of `statId`, clamped to [1, MaxMult]. ]]
function ResearchConfig.MultFor(research: any, statId: string): number
	if typeof(research) ~= "table" or typeof(statId) ~= "string" then
		return 1
	end
	local sum = 0
	for id, def in pairs(ResearchConfig.Upgrades) do
		if def.Kind == "Mult" and def.Stat == statId then
			sum += def.PerLevel * ResearchConfig.LevelOf(research, id)
		end
	end
	local m = 1 + sum
	if m ~= m then
		return 1
	end
	return math.clamp(m, 1, ResearchConfig.MaxMult)
end

--[[ Σ PerLevel × level over Kind "Add" upgrades of `statId` (>= 0). ]]
function ResearchConfig.AddFor(research: any, statId: string): number
	if typeof(research) ~= "table" or typeof(statId) ~= "string" then
		return 0
	end
	local sum = 0
	for id, def in pairs(ResearchConfig.Upgrades) do
		if def.Kind == "Add" and def.Stat == statId then
			sum += def.PerLevel * ResearchConfig.LevelOf(research, id)
		end
	end
	if sum ~= sum or sum < 0 then
		return 0
	end
	return sum
end

--[[ Upgraded magazine: single-shot weapons (base <= 1: rockets, grenades) stay as they are; otherwise
	round(base × mult), never below base. ]]
function ResearchConfig.EffectiveMagazine(base: number, mult: number): number
	if typeof(base) ~= "number" or base ~= base then
		return 0
	end
	if base <= 1 then
		return base
	end
	local m = if typeof(mult) == "number" and mult == mult then math.clamp(mult, 1, ResearchConfig.MaxMult) else 1
	return math.max(base, math.floor(base * m + 0.5))
end

--[[ "+12%" (Mult) or "+2" (Add) for `level` levels of `def`. ]]
function ResearchConfig.FormatAmount(def: UpgradeDef, level: number): string
	if typeof(def) ~= "table" or typeof(def.PerLevel) ~= "number" then
		return ""
	end
	local lv = if typeof(level) == "number" and level == level then level else 0
	if def.Kind == "Add" then
		return "+" .. tostring(def.PerLevel * lv)
	end
	return string.format("+%d%%", math.floor(def.PerLevel * lv * 100 + 0.5))
end

--[[ "+12% weapon damage" ]]
function ResearchConfig.FormatEffect(def: UpgradeDef, level: number): string
	if typeof(def) ~= "table" or typeof(def.EffectText) ~= "string" then
		return ""
	end
	local ok, s = pcall(string.format, def.EffectText, ResearchConfig.FormatAmount(def, level))
	if ok and typeof(s) == "string" then
		return s
	end
	return ResearchConfig.FormatAmount(def, level)
end

--[[ "$12,000" (comma thousands, floored). ]]
function ResearchConfig.FormatCash(n: number): string
	local v = if typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge then math.floor(n) else 0
	local neg = v < 0
	local digits = string.format("%d", math.abs(v))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if neg then "-$" else "$") .. out
end

return ResearchConfig
]]></string>
          </Properties>
        </Item>
