          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">UIUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shared client UI helpers — consistent UIScale + dark military panel chrome.
	MobileActionBar tiles: large rounded color-coded squares (≥64px touch).
]]

local UIUtil = {}

local DEFAULT_BASE = 900
local DEFAULT_MIN = 0.65
local DEFAULT_MAX = 1.1

function UIUtil.Corner(parent: Instance, radius: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

function UIUtil.Stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(55, 65, 55)
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

--[[
	Attaches a MobileScale UIScale that tracks viewport size.
	Returns the UIScale instance.
]]
function UIUtil.AttachMobileScale(
	screen: ScreenGui,
	basePx: number?,
	minScale: number?,
	maxScale: number?
): UIScale
	local scale = Instance.new("UIScale")
	scale.Name = "MobileScale"
	scale.Parent = screen

	local base = basePx or DEFAULT_BASE
	local minS = minScale or DEFAULT_MIN
	local maxS = maxScale or DEFAULT_MAX

	local function updateScale()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local size = cam.ViewportSize
		scale.Scale = math.clamp(math.min(size.X, size.Y) / base, minS, maxS)
	end

	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		updateScale()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
	end)

	return scale
end

--[[ Standard ScreenGui defaults for WAR EMPIRE panels. ]]
function UIUtil.PrepareScreen(screen: ScreenGui, ignoreInset: boolean?)
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = ignoreInset == true
	UIUtil.AttachMobileScale(screen)
end

--[[ Lightweight empty-state label for list panels. ]]
function UIUtil.EmptyState(parent: Instance, message: string, order: number?): TextLabel
	local lab = Instance.new("TextLabel")
	lab.Name = "EmptyState"
	lab.Size = UDim2.new(1, -8, 0, 56)
	lab.BackgroundTransparency = 1
	lab.Font = Enum.Font.Gotham
	lab.TextSize = 13
	lab.TextWrapped = true
	lab.TextXAlignment = Enum.TextXAlignment.Center
	lab.TextYAlignment = Enum.TextYAlignment.Center
	lab.TextColor3 = Color3.fromRGB(140, 150, 140)
	lab.Text = message
	lab.LayoutOrder = order or 0
	lab.Parent = parent
	return lab
end

--[[ Ensure a GuiButton meets mobile min touch (default 64px for advanced HUD). ]]
function UIUtil.EnsureMinTouch(btn: GuiButton, minPx: number?)
	local m = minPx or 64
	local sz = btn.Size
	local w = sz.X.Offset
	local h = sz.Y.Offset
	if w > 0 and w < m then
		btn.Size = UDim2.new(sz.X.Scale, m, sz.Y.Scale, math.max(h, m))
	elseif h > 0 and h < m then
		btn.Size = UDim2.new(sz.X.Scale, math.max(w, m), sz.Y.Scale, m)
	end
end

function UIUtil.GoldStroke(parent: Instance, thickness: number?): UIStroke
	return UIUtil.Stroke(parent, Color3.fromRGB(230, 190, 60), thickness or 1.5)
end

--[[
	Large rounded glossy action tile for mobile dock.
	icon: short emoji/symbol string; label: caption under icon.
]]
function UIUtil.MakeActionTile(
	parent: Instance,
	props: {
		Name: string,
		Icon: string,
		Label: string,
		Color: Color3,
		LayoutOrder: number?,
		SizePx: number?,
	}
): TextButton
	local size = props.SizePx or 72
	local btn = Instance.new("TextButton")
	btn.Name = props.Name
	btn.Size = UDim2.fromOffset(size, size)
	btn.BackgroundColor3 = props.Color
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Text = ""
	btn.LayoutOrder = props.LayoutOrder or 0
	btn.ZIndex = 20
	btn.Active = true
	btn.Selectable = true
	btn.Parent = parent
	UIUtil.Corner(btn, 16)
	local stroke = UIUtil.Stroke(btn, Color3.fromRGB(255, 255, 255), 1.5)
	stroke.Transparency = 0.45

	-- Glossy top highlight — Active=false so it never steals Activated/clicks
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.Size = UDim2.new(1, -8, 0, math.floor(size * 0.28))
	gloss.Position = UDim2.fromOffset(4, 4)
	gloss.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	gloss.BackgroundTransparency = 0.72
	gloss.BorderSizePixel = 0
	gloss.ZIndex = 21
	gloss.Active = false
	gloss.Parent = btn
	UIUtil.Corner(gloss, 10)

	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.new(1, 0, 0, math.floor(size * 0.48))
	icon.Position = UDim2.fromOffset(0, 6)
	icon.Font = Enum.Font.GothamBold
	icon.TextSize = math.floor(size * 0.36)
	icon.TextColor3 = Color3.fromRGB(255, 255, 255)
	icon.Text = props.Icon
	icon.ZIndex = 22
	icon.Active = false
	icon.Parent = btn

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -4, 0, 16)
	label.Position = UDim2.new(0, 2, 1, -20)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.5
	label.Text = props.Label
	label.ZIndex = 22
	label.Active = false
	label.Parent = btn

	UIUtil.EnsureMinTouch(btn, 64)
	return btn
end

return UIUtil
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="43">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="44">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="45">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — Server Bootstrap
	Wires remotes + services. Request/action remotes only.

	CRITICAL: MapSetup runs BEFORE heavy service requires so a failed
	Combat/Vehicle/etc. module never leaves the player falling in void.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local DevConfig = require(Shared.Configs.DevConfig)

local ServerFolder = script.Parent
local Modules = ServerFolder:WaitForChild("Modules")
local Services = ServerFolder:WaitForChild("Services")

print("[WAR EMPIRE] Server Bootstrap starting...")

-- ── Map FIRST (before any heavy service require) ──────────────────────────
local MapSetup = require(Modules.MapSetup)

local function ensureVoidFallback(reason: string)
	warn("[WAR EMPIRE] CRITICAL: MapSetup failed — installing void fallback. Reason: " .. tostring(reason))
	print("[WAR EMPIRE] ERROR: MapSetup did not build WarEmpireSetup. Creating emergency baseplate + spawn so players do not void-fall.")

	Workspace.Gravity = 196.2

	local existing = Workspace:FindFirstChild("WE_VoidFallback")
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "WE_VoidFallback"
	folder.Parent = Workspace

	-- Match playtest ground scale (≥6000) so large-map void-fall still lands on plate
	local baseplate = Instance.new("Part")
	baseplate.Name = "Baseplate"
	baseplate.Size = Vector3.new(7000, 6, 7000)
	baseplate.Position = Vector3.new(0, -3, 0)
	baseplate.Anchored = true
	baseplate.CanCollide = true
	baseplate.Material = Enum.Material.Grass
	baseplate.Color = Color3.fromRGB(40, 80, 40)
	baseplate.TopSurface = Enum.SurfaceType.Smooth
	baseplate.BottomSurface = Enum.SurfaceType.Smooth
	baseplate.Parent = folder

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "EmergencySpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 5, 0)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.BrickColor = BrickColor.new("Bright green")
	spawn.Material = Enum.Material.Neon
	spawn.Parent = folder

	print("[WAR EMPIRE] Void fallback ready: WE_VoidFallback Baseplate + EmergencySpawn at (0,5,0)")
end

if not Workspace:FindFirstChild("WarEmpireSetup") then
	local ok, err = pcall(function()
		MapSetup.Run()
	end)
	if not ok then
		ensureVoidFallback(err)
	elseif not Workspace:FindFirstChild("WarEmpireSetup") then
		ensureVoidFallback("MapSetup.Run returned but WarEmpireSetup missing")
	end
else
	print("[WAR EMPIRE] WarEmpireSetup already present — skipping MapSetup.Run (FORCE rebuild Ground + SafetyCatch)")
	-- Re-assert gravity; soft-heal first, then ALWAYS delete+recreate Ground/SafetyCatch
	-- so stale place files / prior soft-heals cannot leave void holes.
	Workspace.Gravity = 196.2
	local CollectionService = game:GetService("CollectionService")
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local targetSize = MapSetup.GROUND_SIZE or 6400

	if setup and MapSetup.EnsureGroundHealthy then
		pcall(function()
			MapSetup.EnsureGroundHealthy(setup)
		end)
	end

	local rebuilt = false
	if setup and MapSetup.ForceRebuildGround then
		local okRebuild, rebuildResult = pcall(function()
			return MapSetup.ForceRebuildGround(setup)
		end)
		rebuilt = okRebuild and rebuildResult == true
		if not rebuilt then
			warn("[WAR EMPIRE] ForceRebuildGround failed — full MapSetup.Run rebuild")
			pcall(function()
				if setup then
					setup:Destroy()
				end
				MapSetup.Run()
			end)
			if not Workspace:FindFirstChild("WarEmpireSetup") then
				ensureVoidFallback("ForceRebuildGround failed and full rebuild failed")
			end
		end
	elseif setup then
		warn("[WAR EMPIRE] ForceRebuildGround missing — full MapSetup.Run rebuild")
		pcall(function()
			setup:Destroy()
			MapSetup.Run()
		end)
	end

	setup = Workspace:FindFirstChild("WarEmpireSetup")
	-- Mandatory Output status after heal/rebuild
	local mapFolder = setup and setup:FindFirstChild("Map")
	local g = mapFolder and mapFolder:FindFirstChild("Ground")
	local catch = mapFolder and mapFolder:FindFirstChild("SafetyCatch")
	if g and g:IsA("BasePart") then
		g.CanCollide = true
		g.Anchored = true
		print(string.format(
			"[WAR EMPIRE] Ground AFTER heal: size=%.0fx%.0fx%.0f CanCollide=%s SafetyCatch=%s",
			g.Size.X,
			g.Size.Y,
			g.Size.Z,
			tostring(g.CanCollide),
			tostring(catch ~= nil)
		))
		if g.Size.X < targetSize - 1 or g.CanCollide ~= true then
			warn("[WAR EMPIRE] Ground still unhealthy after force rebuild — run admin resetmap (Studio)")
		end
	else
		warn("[WAR EMPIRE] Ground MISSING after force rebuild — run admin resetmap (Studio) MANDATORY")
	end

	setup = Workspace:FindFirstChild("WarEmpireSetup")
	if setup then
		-- Ensure WE_UpgradeSlot tags exist (stale place files / partial builds skip MapSetup)
		local tagged = CollectionService:GetTagged(Constants.Tags.UpgradeSlot)
		local taggedCount = #tagged
		if taggedCount == 0 then
			local bases = setup:FindFirstChild("Bases")
			local retagged = 0
			if bases then
				for _, desc in ipairs(bases:GetDescendants()) do
					if desc:IsA("BasePart") then
						local sid = desc:GetAttribute("StructureId")
						local pid = desc:GetAttribute("PlotId")
						if typeof(sid) == "string" and typeof(pid) == "number" then
							CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
							desc.CanTouch = true
							retagged += 1
						end
					end
				end
			end
			if retagged == 0 then
				warn("[WAR EMPIRE] WarEmpireSetup present but no upgrade pads — rebuilding via MapSetup")
				pcall(function()
					setup:Destroy()
					MapSetup.Run()
				end)
				if not Workspace:FindFirstChild("WarEmpireSetup") then
					ensureVoidFallback("Missing upgrade pads and rebuild failed")
				end
			else
				print("[WAR EMPIRE] Re-tagged", retagged, "upgrade pads with WE_UpgradeSlot")
			end
		else
			-- Soft-heal: CanTouch on existing tagged pads
			for _, inst in ipairs(tagged) do
				if inst:IsA("BasePart") then
					inst.CanTouch = true
				end
			end
			print("[WAR EMPIRE] Upgrade slots OK:", taggedCount)
		end
	end
end


-- ── Remotes + services (AFTER map so require failures don't block terrain) ─
local RemoteSetup = require(Modules.RemoteSetup)
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local BaseService = require(Services.BaseService)
local XPService = require(Services.XPService)
local RateLimitService = require(Services.RateLimitService)
local AnalyticsService = require(Services.AnalyticsService)
local AdminService = require(Services.AdminService)
local NotificationService = require(Services.NotificationService)
local AntiExploitService = require(Services.AntiExploitService)
local CombatService = require(Services.CombatService)
local VehicleService = require(Services.VehicleService)
local TerritoryService = require(Services.TerritoryService)
local MissionService = require(Services.MissionService)
local PrestigeService = require(Services.PrestigeService)
local ClanService = require(Services.ClanService)
local MonetizationService = require(Services.MonetizationService)
local TutorialService = require(Services.TutorialService)
local BattlePassService = require(Services.BattlePassService)
local SoldierService = require(Services.SoldierService)
local SeasonService = require(Services.SeasonService)
local ClanWarService = require(Services.ClanWarService)
local CodesService = require(Services.CodesService)
local NationColorService = require(Services.NationColorService)
local CaptureStipendService = require(Services.CaptureStipendService)
local SupplyDropService = require(Services.SupplyDropService)
local BankRaidService = require(Services.BankRaidService)
local SpinnerService = require(Services.SpinnerService)
local UpgradePadService = require(Services.UpgradePadService)
local FallSafetyService = require(Services.FallSafetyService)
local VisualAssetService = require(Services.VisualAssetService)

RemoteSetup.Init()

local deps: { [string]: any } = {
	RemoteSetup = RemoteSetup,
	DataService = DataService,
	EconomyService = EconomyService,
	BaseService = BaseService,
	XPService = XPService,
	RateLimitService = RateLimitService,
	AnalyticsService = AnalyticsService,
	AdminService = AdminService,
	NotificationService = NotificationService,
	AntiExploitService = AntiExploitService,
	CombatService = CombatService,
	VehicleService = VehicleService,
	TerritoryService = TerritoryService,
	MissionService = MissionService,
	PrestigeService = PrestigeService,
	ClanService = ClanService,
	MonetizationService = MonetizationService,
	TutorialService = TutorialService,
	BattlePassService = BattlePassService,
	SoldierService = SoldierService,
	SeasonService = SeasonService,
	ClanWarService = ClanWarService,
	CodesService = CodesService,
	NationColorService = NationColorService,
	CaptureStipendService = CaptureStipendService,
	SupplyDropService = SupplyDropService,
	BankRaidService = BankRaidService,
	SpinnerService = SpinnerService,
	UpgradePadService = UpgradePadService,
	FallSafetyService = FallSafetyService,
}

RateLimitService.Init()
AnalyticsService.Init()
DataService.SetAnalytics(AnalyticsService)

-- Init services that OnProfileLoaded depends on BEFORE DataService loads players
EconomyService.Init(deps)
XPService.Init(deps)
NotificationService.Init(deps)
AntiExploitService.Init(deps)
BaseService.Init(deps) -- registers OnProfileLoaded
UpgradePadService.Init(deps) -- server walk-over buy (Touched + spatial)
FallSafetyService.Init(deps) -- void fall → teleport to plot spawn
MonetizationService.Init(deps) -- GamePass cache on join
TutorialService.Init(deps) -- tutorial step on join + upgrade hook

-- Now load profiles (fires OnProfileLoaded for joiners)
DataService.Init()

AdminService.Init(deps)
VisualAssetService.Init()
CombatService.Init(deps)
VehicleService.Init(deps)
NationColorService.Init(deps)
TerritoryService.Init(deps)
MissionService.Init(deps)
PrestigeService.Init(deps)
ClanService.Init(deps)
BattlePassService.Init(deps)
SoldierService.Init(deps)
SeasonService.Init(deps)
ClanWarService.Init(deps)
CodesService.Init(deps)
CaptureStipendService.Init(deps)
SupplyDropService.Init(deps)
BankRaidService.Init(deps)
SpinnerService.Init(deps)

if DevConfig.VerboseLogging then
	print("[WAR EMPIRE] Services initialized. Plots:", Constants.MaxBasePlots)
end

print("[WAR EMPIRE] Server Bootstrap ready.")
print("[WAR EMPIRE] CHECKLIST: 1) resetmap MANDATORY if void/dead-space persists (stale WarEmpireSetup keeps old holes)  2) Output must show Ground AFTER heal size/CanCollide  3) stand on YOUR Command Center pad — big BUY button + [UpgradePad] BUY ATTEMPT/OK  4) dock tiles toast + B menu BUY")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="46">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">DesertFlora</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — DesertFlora (procedural Part-kit vegetation)
	Saguaro / Joshua / palm / barrel cactus / dry grass tufts.
	Inspiration-only desert tycoon look — original Part kits, mobile-friendly counts.
	Called from MapSetup.Run after MapDressing (deferred).
	CanCollide false; CastShadow false on ALL flora (Studio/laptop perf).
	Sparse mode default — ~70% fewer plants than prior dense pass.
]]

local DesertFlora = {}

local GROUND_TOP_Y = 0.5
local HALF = 3200 -- matches MapSetup GROUND_SIZE/2

local COL = {
	Cactus = Color3.fromRGB(62, 110, 58),
	CactusDark = Color3.fromRGB(48, 88, 48),
	CactusLight = Color3.fromRGB(78, 130, 72),
	JoshuaTrunk = Color3.fromRGB(95, 78, 52),
	JoshuaLeaf = Color3.fromRGB(70, 95, 45),
	PalmTrunk = Color3.fromRGB(110, 85, 55),
	PalmLeaf = Color3.fromRGB(55, 120, 55),
	Barrel = Color3.fromRGB(72, 105, 55),
	Grass = Color3.fromRGB(150, 130, 70),
	GrassDry = Color3.fromRGB(170, 145, 85),
	Rock = Color3.fromRGB(160, 110, 75),
}

local function ensureFolder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function p(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = if props.CastShadow ~= nil then props.CastShadow else false -- deco: never cast shadows (Studio perf)
	if props.Name then
		part.Name = props.Name
	end
	if props.Size then
		part.Size = props.Size
	end
	if props.CFrame then
		part.CFrame = props.CFrame
	elseif props.Position then
		part.Position = props.Position
	end
	if props.Color then
		part.Color = props.Color
	end
	if props.Material then
		part.Material = props.Material
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	part:SetAttribute("WE_Decor", true)
	part:SetAttribute("WE_Flora", true)
	return part
end

local function kitSaguaro(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local h = 10 * s
	p({
		Name = "SaguaroTrunk",
		Size = Vector3.new(1.4 * s, h, 1.4 * s),
		Position = origin + Vector3.new(0, h * 0.5, 0),
		Color = COL.Cactus,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	-- Arms
	local armY = h * 0.55
	p({
		Name = "SaguaroArmL",
		Size = Vector3.new(0.9 * s, 4.2 * s, 0.9 * s),
		CFrame = CFrame.new(origin + Vector3.new(-1.6 * s, armY + 1.2 * s, 0)),
		Color = COL.CactusDark,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	p({
		Name = "SaguaroElbowL",
		Size = Vector3.new(2.2 * s, 0.85 * s, 0.85 * s),
		Position = origin + Vector3.new(-0.9 * s, armY, 0),
		Color = COL.Cactus,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	if s > 0.85 then
		p({
			Name = "SaguaroArmR",
			Size = Vector3.new(0.85 * s, 3.4 * s, 0.85 * s),
			Position = origin + Vector3.new(1.5 * s, armY + 0.6 * s, 0.2 * s),
			Color = COL.CactusLight,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		p({
			Name = "SaguaroElbowR",
			Size = Vector3.new(2.0 * s, 0.8 * s, 0.8 * s),
			Position = origin + Vector3.new(0.85 * s, armY - 0.4 * s, 0.2 * s),
			Color = COL.Cactus,
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
	end
end

local function kitJoshua(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local trunkH = 7 * s
	p({
		Name = "JoshuaTrunk",
		Size = Vector3.new(1.1 * s, trunkH, 1.1 * s),
		Position = origin + Vector3.new(0, trunkH * 0.5, 0),
		Color = COL.JoshuaTrunk,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	-- Forked branches + spiky leaf clusters
	local forks = {
		{ 1.8, 0.6, 0.4, 25 },
		{ -1.6, 0.4, -0.5, -30 },
		{ 0.3, 1.0, 1.5, 10 },
	}
	for i, f in ipairs(forks) do
		local bx, by, bz, yaw = f[1] * s, trunkH * 0.55 + f[2] * s, f[3] * s, f[4]
		p({
			Name = "JoshuaFork" .. i,
			Size = Vector3.new(0.7 * s, 3.2 * s, 0.7 * s),
			CFrame = CFrame.new(origin + Vector3.new(bx, by + 1.2 * s, bz)) * CFrame.Angles(0, math.rad(yaw), math.rad(18)),
			Color = COL.JoshuaTrunk,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
		p({
			Name = "JoshuaLeaf" .. i,
			Size = Vector3.new(2.4 * s, 0.35 * s, 2.4 * s),
			Position = origin + Vector3.new(bx, by + 2.8 * s, bz),
			Color = COL.JoshuaLeaf,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
	end
end

local function kitPalm(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	local trunkH = 12 * s
	p({
		Name = "PalmTrunk",
		Size = Vector3.new(1.2 * s, trunkH, 1.2 * s),
		Position = origin + Vector3.new(0, trunkH * 0.5, 0),
		Color = COL.PalmTrunk,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	-- Fronds as radial slabs
	for i = 0, 5 do
		local ang = i * 60
		p({
			Name = "PalmFrond" .. i,
			Size = Vector3.new(0.35 * s, 0.25 * s, 5.5 * s),
			CFrame = CFrame.new(origin + Vector3.new(0, trunkH + 0.2 * s, 0))
				* CFrame.Angles(0, math.rad(ang), 0)
				* CFrame.new(0, 0, -2.2 * s)
				* CFrame.Angles(math.rad(-25), 0, 0),
			Color = COL.PalmLeaf,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
	end
	p({
		Name = "PalmCrown",
		Size = Vector3.new(1.6 * s, 1.0 * s, 1.6 * s),
		Position = origin + Vector3.new(0, trunkH + 0.4 * s, 0),
		Color = COL.PalmLeaf,
		Material = Enum.Material.Grass,
		Parent = folder,
	})
end

local function kitBarrel(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	p({
		Name = "BarrelBody",
		Size = Vector3.new(2.4 * s, 2.2 * s, 2.4 * s),
		CFrame = CFrame.new(origin + Vector3.new(0, 1.1 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COL.Barrel,
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	p({
		Name = "BarrelTop",
		Size = Vector3.new(1.6 * s, 0.5 * s, 1.6 * s),
		Position = origin + Vector3.new(0, 2.3 * s, 0),
		Color = COL.CactusLight,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function kitGrassTuft(folder: Folder, origin: Vector3)
	for i = 0, 2 do
		local ox = (i - 1) * 0.55
		p({
			Name = "GrassBlade",
			Size = Vector3.new(0.25, 1.4 + (i % 2) * 0.5, 0.25),
			CFrame = CFrame.new(origin + Vector3.new(ox, 0.9, (i % 2) * 0.3))
				* CFrame.Angles(0, math.rad(i * 40), math.rad(8)),
			Color = if i % 2 == 0 then COL.Grass else COL.GrassDry,
			Material = Enum.Material.Grass,
			CastShadow = false,
			Parent = folder,
		})
	end
end

local function kitRockOutcrop(folder: Folder, origin: Vector3, scale: number?)
	local s = scale or 1
	p({
		Name = "Outcrop",
		Size = Vector3.new(8 * s, 3.5 * s, 6 * s),
		Position = origin + Vector3.new(0, 1.6 * s, 0),
		Color = COL.Rock,
		Material = Enum.Material.Sandstone,
		CanCollide = true,
		Parent = folder,
	})
	p({
		Name = "OutcropCap",
		Size = Vector3.new(5 * s, 1.8 * s, 4 * s),
		Position = origin + Vector3.new(1.2 * s, 3.8 * s, -0.5 * s),
		Color = COL.Rock:Lerp(Color3.fromRGB(180, 130, 90), 0.3),
		Material = Enum.Material.Sandstone,
		CanCollide = false,
		Parent = folder,
	})
end

local function placeAt(folder: Folder, name: string, pos: Vector3, builder: (Folder, Vector3, number?) -> (), scale: number?)
	local cluster = Instance.new("Folder")
	cluster.Name = name
	cluster.Parent = folder
	builder(cluster, pos, scale)
end

function DesertFlora.Dress(root: Instance, opts: { Sparse: boolean? }?)
	local flora = ensureFolder("DesertFlora", root)
	local sparse = if opts and opts.Sparse ~= nil then opts.Sparse else true

	-- PERF: sparse by default. CastShadow=false on all flora parts (see p()).
	local rimCount = if sparse then 6 else 12
	local rimR = HALF - 180
	for i = 1, rimCount do
		local ang = (i / rimCount) * math.pi * 2
		local jitter = ((i * 37) % 50) - 25
		local r = rimR + jitter
		local pos = Vector3.new(math.cos(ang) * r, GROUND_TOP_Y, math.sin(ang) * r)
		local kind = i % 4
		if kind == 0 then
			placeAt(flora, "Saguaro_Rim_" .. i, pos, kitSaguaro, 0.9)
		elseif kind == 1 then
			placeAt(flora, "Joshua_Rim_" .. i, pos, kitJoshua, 0.95)
		elseif kind == 2 then
			placeAt(flora, "Palm_Rim_" .. i, pos, kitPalm, 0.8)
		else
			placeAt(flora, "Barrel_Rim_" .. i, pos, kitBarrel, 0.95)
		end
	end

	-- Mid-map: drastically cut (was 10 dual plants → 2–4 singles)
	local midSpots = if sparse
		then {
			Vector3.new(480, GROUND_TOP_Y, 520),
			Vector3.new(900, GROUND_TOP_Y, -900),
		}
		else {
			Vector3.new(350, GROUND_TOP_Y, 180),
			Vector3.new(180, GROUND_TOP_Y, -480),
			Vector3.new(620, GROUND_TOP_Y, -80),
			Vector3.new(480, GROUND_TOP_Y, 520),
			Vector3.new(1100, GROUND_TOP_Y, 200),
			Vector3.new(900, GROUND_TOP_Y, -900),
		}
	for i, pos in ipairs(midSpots) do
		if i % 2 == 0 then
			placeAt(flora, "Saguaro_Mid_" .. i, pos, kitSaguaro, 1.0)
		else
			placeAt(flora, "Palm_Mid_" .. i, pos, kitPalm, 0.95)
		end
		if not sparse and i == 1 then
			placeAt(flora, "Rock_Mid_" .. i, pos + Vector3.new(10, 0, -8), kitRockOutcrop, 0.9)
			local tuft = Instance.new("Folder")
			tuft.Name = "Grass_Mid_" .. i
			tuft.Parent = flora
			kitGrassTuft(tuft, pos + Vector3.new(-6, 0, 5))
		end
	end

	-- Plot-adjacent flora: sparse = 2 palms only; full = 4
	local plotOffsets = if sparse
		then {
			Vector3.new(-800, GROUND_TOP_Y, -400),
			Vector3.new(800, GROUND_TOP_Y, 400),
		}
		else {
			Vector3.new(-800, GROUND_TOP_Y, -400),
			Vector3.new(-800, GROUND_TOP_Y, 400),
			Vector3.new(800, GROUND_TOP_Y, -400),
			Vector3.new(800, GROUND_TOP_Y, 400),
		}
	for i, pos in ipairs(plotOffsets) do
		placeAt(flora, "Palm_Plot_" .. i, pos + Vector3.new(110, 0, 40), kitPalm, 0.85)
	end

	-- Optional free cactus catalog overlays (InsertService; skipped when StudioSkipWorldDressing)
	-- Cap attempts so PERF stays Part-kit-first even on live.
	do
		local attached = 0
		local maxAttach = if sparse then 2 else 4
		local okVas, vas = pcall(function()
			return require(script.Parent.Parent.Services.VisualAssetService)
		end)
		if okVas and vas and vas.IsInsertEnabled and vas.IsInsertEnabled() then
			for _, d in ipairs(flora:GetDescendants()) do
				if attached >= maxAttach then
					break
				end
				if d:IsA("BasePart") and d.Name == "SaguaroTrunk" then
					local okAtt = pcall(function()
						return vas.TryAttachPropVisual(d, if attached % 2 == 0 then "Cactus" else "CactusBase")
					end)
					if okAtt then
						attached += 1
					end
				end
			end
			if attached > 0 then
				print("[WAR EMPIRE] DesertFlora catalog props attached:", attached)
			end
		end
	end

	local partCount = 0
	for _, d in ipairs(flora:GetDescendants()) do
		if d:IsA("BasePart") then
			partCount += 1
			d.CastShadow = false
		end
	end
	print("[WAR EMPIRE] DesertFlora complete: " .. tostring(partCount) .. " flora parts (sparse=" .. tostring(sparse) .. ", CastShadow=false)")
end

return DesertFlora
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">MapDressing</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — MapDressing (world visual substance)
	Fills the expanded ~4800 map between plots / ring / territories with
	military Part-kit clusters (desert outposts, adobe, tents, hangars, depots, camps…).
	Visual / immersion only — no gameplay tags that affect buy pads or capture.
	Called from MapSetup.Run after bases/territories/spawns (deferred).
	Quality Low (~60–70% fewer clusters) vs Full. Studio usually SKIPS entirely
	(DevConfig.StudioSkipWorldDressing) — ForceDress attribute to opt in.
	Regenerate: delete WarEmpireSetup + Play, or admin resetmap.
]]

local MapDressing = {}

-- Palette aligned with StructureVisualConfig / MapSetup (Concrete / Metal / Neon)
local COL = {
	Concrete = Color3.fromRGB(85, 85, 78),
	ConcreteDark = Color3.fromRGB(60, 60, 55),
	Metal = Color3.fromRGB(58, 72, 88),
	MetalDark = Color3.fromRGB(45, 50, 55),
	Olive = Color3.fromRGB(70, 78, 55),
	OliveDark = Color3.fromRGB(50, 55, 42),
	Sand = Color3.fromRGB(150, 130, 90),
	Sandbag = Color3.fromRGB(130, 115, 80),
	Rust = Color3.fromRGB(120, 70, 45),
	Fuel = Color3.fromRGB(180, 140, 50),
	Ammo = Color3.fromRGB(88, 58, 50),
	NeonGold = Color3.fromRGB(230, 190, 60),
	NeonBlue = Color3.fromRGB(90, 160, 220),
	NeonCyan = Color3.fromRGB(70, 180, 220),
	NeonGreen = Color3.fromRGB(90, 160, 80),
	NeonOrange = Color3.fromRGB(220, 140, 60),
	NeonRed = Color3.fromRGB(200, 90, 70),
	Asphalt = Color3.fromRGB(48, 50, 46),
	Wood = Color3.fromRGB(95, 75, 50),
	Wire = Color3.fromRGB(100, 105, 95),
	Crate = Color3.fromRGB(95, 80, 55),
	Drum = Color3.fromRGB(70, 85, 55),
	DrumAccent = Color3.fromRGB(200, 90, 50),
	Vehicle = Color3.fromRGB(55, 65, 48),
	VehicleAccent = Color3.fromRGB(90, 140, 70),
	Ruin = Color3.fromRGB(95, 90, 75),
	Light = Color3.fromRGB(255, 230, 160),
	Sign = Color3.fromRGB(50, 55, 45),
	SignFace = Color3.fromRGB(200, 180, 80),
	Tent = Color3.fromRGB(195, 175, 130),
	TentDark = Color3.fromRGB(160, 140, 100),
	TentPole = Color3.fromRGB(90, 70, 45),
	Adobe = Color3.fromRGB(185, 150, 105),
	AdobeDark = Color3.fromRGB(155, 120, 80),
	AdobeWindow = Color3.fromRGB(70, 110, 130),
	WoodTower = Color3.fromRGB(110, 85, 55),
	WoodDark = Color3.fromRGB(85, 65, 42),
	FlagCloth = Color3.fromRGB(200, 70, 55),
	CampfireStone = Color3.fromRGB(110, 105, 95),
	CampfireGlow = Color3.fromRGB(255, 140, 50),
	Dock = Color3.fromRGB(50, 75, 95),
}

local function ensureFolder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function p(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else false
	part.CanQuery = if props.CanQuery ~= nil then props.CanQuery else false
	part.CanTouch = false
	part.CastShadow = if props.CastShadow ~= nil then props.CastShadow else false
	if props.Name then
		part.Name = props.Name
	end
	if props.Size then
		part.Size = props.Size
	end
	if props.CFrame then
		part.CFrame = props.CFrame
	elseif props.Position then
		part.Position = props.Position
	end
	if props.Color then
		part.Color = props.Color
	end
	if props.Material then
		part.Material = props.Material
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	part:SetAttribute("WE_Decor", true)
	return part
end

local function at(origin: Vector3, ox: number, oy: number, oz: number): Vector3
	return origin + Vector3.new(ox, oy, oz)
end


-- ── Kit builders (modest part counts) ─────────────────────────────────────

local function kitWatchtower(folder: Folder, origin: Vector3, yawDeg: number)
	-- Wooden desert watchtower + simple flag (original Part kit)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	-- Four legs
	for _, ox in ipairs({ -2.2, 2.2 }) do
		for _, oz in ipairs({ -2.2, 2.2 }) do
			p({
				Name = "TowerLeg",
				Size = Vector3.new(0.7, 16, 0.7),
				CFrame = cf * CFrame.new(ox, 8, oz),
				Color = COL.WoodTower,
				Material = Enum.Material.Wood,
				CanCollide = true,
				CanQuery = true,
				Parent = folder,
			})
		end
	end
	-- Cross braces
	p({
		Name = "TowerBrace",
		Size = Vector3.new(5.2, 0.35, 0.35),
		CFrame = cf * CFrame.new(0, 6, 0),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	p({
		Name = "TowerBrace2",
		Size = Vector3.new(0.35, 0.35, 5.2),
		CFrame = cf * CFrame.new(0, 10, 0),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	p({
		Name = "TowerCabin",
		Size = Vector3.new(6.5, 3.4, 6.5),
		CFrame = cf * CFrame.new(0, 16.5, 0),
		Color = COL.Adobe,
		Material = Enum.Material.Wood,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	p({
		Name = "TowerRoof",
		Size = Vector3.new(7.5, 0.55, 7.5),
		CFrame = cf * CFrame.new(0, 18.4, 0),
		Color = COL.WoodDark,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	p({
		Name = "TowerWindow",
		Size = Vector3.new(1.4, 1.1, 0.25),
		CFrame = cf * CFrame.new(0, 16.6, -3.3),
		Color = COL.AdobeWindow,
		Material = Enum.Material.Glass,
		Parent = folder,
	})
	-- Flag pole + cloth
	p({
		Name = "FlagPole",
		Size = Vector3.new(0.25, 7, 0.25),
		CFrame = cf * CFrame.new(2.8, 22, 2.8),
		Color = COL.MetalDark,
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	p({
		Name = "FlagCloth",
		Size = Vector3.new(2.8, 1.6, 0.12),
		CFrame = cf * CFrame.new(4.2, 24.2, 2.8),
		Color = COL.FlagCloth,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	p({
		Name = "TowerAccent",
		Size = Vector3.new(6.7, 0.22, 6.7),
		CFrame = cf * CFrame.new(0, 14.9, 0),
		Color = COL.NeonGold,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
end

