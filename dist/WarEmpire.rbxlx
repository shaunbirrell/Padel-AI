				Chimney = Color3.fromRGB(92, 60, 50),
			},
		},
		WeaponsFacility = {
			Enabled = true,
			Interior = "Armory",
			Width = 30,
			Depth = 22,
			DoorX = 9,
			StoryHeight = 10, -- low bunker (interior tallest item 8.2)
			UpperStoryHeight = 9,
			FrontWindowsX = {}, -- blind walls: a magazine has no windows
			BackWindowsX = {},
