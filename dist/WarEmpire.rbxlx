			ObjectiveType = "EarnCash",
			Target = 8000,
			RewardCash = 2000,
			RewardXP = 60,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailySpawnVehicle = {
			Id = "DailySpawnVehicle",
