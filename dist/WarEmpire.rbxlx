        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">MissionConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily objective missions (progress tracked server-side) + legacy timed missions.
]]

export type DailyMissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string, -- KillNPC | KillPlayer | CaptureTerritory | PurchaseUpgrade | EarnCash | SpawnVehicle | RecruitSoldiers
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number?,
	MinLevel: number,
}

export type MissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MinLevel: number,
	DurationSeconds: number,
	RewardCash: number,
	RewardXP: number,
	Difficulty: string,
}

local MissionConfig = {
	-- How many daily missions are offered (first N unlocked by level from DailyMissions order)
	MaxActiveDaily = 6, -- includes Daily Ops when merged
	RefreshOnUtcDayChange = true,

	DailyMissions = {
		DailyKillNPC = {
			Id = "DailyKillNPC",
			DisplayName = "Clear Hostiles",
			Description = "Eliminate 10 NPC hostiles.",
