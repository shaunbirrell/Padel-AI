		DisplayName = "Reload Drills",
		Badge = "RLD",
		Stat = "WeaponReload",
		Kind = "Mult",
		PerLevel = 0.06,
		MaxLevel = 5,
		Costs = { 2000, 8000, 28000, 80000, 220000 },
		EffectText = "%s reload speed",
		Enabled = true,
	},
	-- ── Soldiers (field squad; SquadOrdersService) ─────────────────────────────────────────────────────
	BodyArmor = {
		Id = "BodyArmor",
		Track = "Soldiers",
		Order = 1,
		DisplayName = "Body Armor",
		Badge = "HP",
		Stat = "SoldierHealth",
		Kind = "Mult",
		PerLevel = 0.10,
		MaxLevel = 5,
		Costs = { 2500, 10000, 32000, 90000, 240000 },
		EffectText = "%s squad health",
		Enabled = true,
	},
	MarksmanTraining = {
		Id = "MarksmanTraining",
		Track = "Soldiers",
		Order = 2,
		DisplayName = "Marksman Training",
		Badge = "AIM",
		Stat = "SoldierDamage",
		Kind = "Mult",
		PerLevel = 0.10,
		MaxLevel = 5,
		Costs = { 2500, 10000, 32000, 90000, 240000 },
		EffectText = "%s squad damage",
		Enabled = true,
	},
	-- claude-bud JOB 26: personal armour. Bought ONLY at the base through ArmourService (tier order, Command Center level,
	-- inside his own plot); paid and saved here so the Cash path stays the one research purchase (ServiceOnly: the
	-- research remote refuses it). Costs / reductions mirror ArmourConfig.Tiers. Kept through rebirth like all research.
	PersonalArmour = {
