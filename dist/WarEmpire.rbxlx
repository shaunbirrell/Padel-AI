			{ Id = "SW_YardE", Block = "SW", Role = "block", Tier = 2, X = -68, Z = 121, Yaw = 0, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkupB" } } }, -- closes the yard behind the south-arm row, facing the plaza
			{ Id = "SW_YardN", Block = "SW", Role = "block", Tier = 2, X = -120, Z = 70, Yaw = -90, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkup" } } }, -- closes the yard behind the west-arm row, facing the plaza
			{ Id = "SW_RadioMast", Block = "SW", Role = "mast", Tier = 1, X = -214, Z = 212, Yaw = 0, Kits = { { Kit = "RadioMast", X = 0, Z = 0 } } }, -- 90-tall lattice mast over the square: the SW skyline marker
			{ Id = "SW_Nest", Block = "SW", Role = "nest", Tier = 2, X = -95, Z = 95, Yaw = 135, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 } } }, -- sandbag arc on the plaza corner, facing the flag
			-- SE: frontage on the east arm (fronts facing north) and the south arm past the Pool_Town pad (fronts facing west); motor pool garages
			{ Id = "SE_E1", Block = "SE", Role = "block", Tier = 1, X = 131.5, Z = 44.5, Yaw = 90, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkup", Lantern = true } } }, -- plaza end-cap: faces the flag along the road
			{ Id = "SE_E2", Block = "SE", Role = "block", Tier = 2, X = 158, Z = 44.2, Yaw = 0, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "shop" } } },
			{ Id = "SE_E3", Block = "SE", Role = "block", Tier = 2, X = 184.5, Z = 44, Yaw = 0, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkupB" } } },
			{ Id = "SE_E4", Block = "SE", Role = "block", Tier = 2, X = 211, Z = 44.2, Yaw = 0, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "shop" } } },
			{ Id = "SE_E5", Block = "SE", Role = "block", Tier = 2, X = 237.5, Z = 44.7, Yaw = 0, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkup" } } },
			{ Id = "SE_S1", Block = "SE", Role = "block", Tier = 1, X = 44, Z = 212, Yaw = 90, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkupB" } } },
			{ Id = "SE_S2", Block = "SE", Role = "block", Tier = 2, X = 44.2, Z = 238.5, Yaw = 90, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "shop" } } },
			{ Id = "SE_S3", Block = "SE", Role = "block", Tier = 2, X = 44.7, Z = 265, Yaw = 90, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "walkup" } } },
			{ Id = "SE_S4", Block = "SE", Role = "block", Tier = 2, X = 44.2, Z = 291.5, Yaw = 90, Kits = { { Kit = "TownHouse", X = 0, Z = 0, Variant = "shop" } } },
			{ Id = "SE_MotorShed", Block = "SE", Role = "block", Tier = 2, X = 100, Z = 170, Yaw = 90, Kits = { { Kit = "TownHouse", X = -9.3, Z = 0, Variant = "shop" }, { Kit = "TownHouse", X = 9.3, Z = 0, Variant = "shop" } } }, -- two shutter garages facing the Pool_Town pad
			{ Id = "SE_MotorPool", Block = "SE", Role = "motorpool", Tier = 2, X = 76, Z = 170, Yaw = 90, Kits = { { Kit = "Jersey", X = -4, Z = 0 }, { Kit = "Jersey", X = 4, Z = 0 }, { Kit = "DrumGroup", X = 0, Z = 3, Count = 2 } } }, -- beside the Pool_Town garage pad (+16 clear)
			{ Id = "SE_Wreck", Block = "SE", Role = "wreck", Tier = 1, X = 232, Z = 14.5, Yaw = 0, Street = true, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "truck" } } }, -- burnt truck parked on the east-arm verge (collidable >= 13 off the line)
		} :: { TownCluster },
		Rocks = {
			{ Kind = "rubble", X = -68, Z = -262, Radius = 6, Tier = 1 }, -- back lot behind the north-arm frontage
			{ Kind = "rubble", X = -262, Z = -62, Radius = 6, Tier = 1 }, -- back lot at the end of the west-arm frontage
			{ Kind = "rubble", X = -130, Z = -222, Radius = 6, Tier = 1 }, -- behind the market lane
			{ Kind = "rubble", X = 78, Z = -130, Radius = 6, Tier = 1 }, -- between the apartment block and the north-arm frontage
			{ Kind = "rubble", X = 290, Z = -64, Radius = 5, Tier = 1 }, -- back lot at the end of the east-arm frontage
			{ Kind = "rubble", X = -66, Z = 262, Radius = 6, Tier = 1 }, -- back lot behind the south-arm frontage
			{ Kind = "rubble", X = 228, Z = 72, Radius = 6, Tier = 1 }, -- back lot behind the east-arm frontage
			{ Kind = "rubble", X = 66, Z = 290, Radius = 6, Tier = 1 }, -- back lot behind the south-arm frontage
			{ Kind = "scorch", X = 150, Z = 170, Radius = 9, Tier = 1 }, -- a burnt patch behind the east-arm frontage
		} :: { TownRock },
		-- Town pavements (owner feedback 2026-09-27; Kit Sidewalk, one flat non-colliding strip each, under
		-- POI_Town.Infra, built in Low and Full): each road arm's two frontages from the road shoulder (7.6 off the centre
		-- line) to the building fronts (33.6), Length along the arm; Bank Street (x 200..240) down to the bank plaza's
		-- guard ring; the market lane between its two walk-ups. The south arm's east side starts past the Pool_Town pad
		-- (+16). 10 parts; every strip is sampled through WorldDress.Blocked (capture clear r 124, pads, bank).
		Infra = {
			{ Id = "Walk_N_W", Kit = "Sidewalk", X = -20.6, Z = -214.5, Yaw = 90, Length = 171 },
			{ Id = "Walk_N_E", Kit = "Sidewalk", X = 20.6, Z = -214.5, Yaw = 90, Length = 171 },
			{ Id = "Walk_S_W", Kit = "Sidewalk", X = -20.6, Z = 214.5, Yaw = 90, Length = 171 },
			{ Id = "Walk_S_E", Kit = "Sidewalk", X = 20.6, Z = 250.5, Yaw = 90, Length = 99 },
			{ Id = "Walk_W_N", Kit = "Sidewalk", X = -214.5, Z = -20.6, Yaw = 0, Length = 171 },
			{ Id = "Walk_W_S", Kit = "Sidewalk", X = -214.5, Z = 20.6, Yaw = 0, Length = 171 },
			{ Id = "Walk_E_N", Kit = "Sidewalk", X = 214.5, Z = -20.6, Yaw = 0, Length = 171 },
			{ Id = "Walk_E_S", Kit = "Sidewalk", X = 214.5, Z = 20.6, Yaw = 0, Length = 171 },
			{ Id = "Walk_Bank", Kit = "Sidewalk", X = 220, Z = -103.8, Yaw = 90, Length = 140.4, Width = 40 },
			{ Id = "Walk_Market", Kit = "Sidewalk", X = -75.8, Z = -174.95, Yaw = 0, Length = 84.4, Width = 34.3 },
		} :: { InfraRow },
		-- W3 step 2 activity anchors (world studs; see the Activity section). WorldPOI stamps each Town row on the first
		-- part of the cluster it Requires (a Town row always names one) and Activity.CheckpointAnchors on CP_N / CP_E /
		-- CP_S / CP_W (ids Town.CP_N.Booth …). 0 parts: the Town stays at 368 / 370.
		Anchors = {
			{ Id = "Town.Market.Box", Kind = "search", X = -81, Z = -169.3, Yaw = 0, R = 5, Prompt = "hold", Requires = "NW_Stall_1" }, -- the market cache, at the NW_Stall_1 counter (1.8 clear of it in the HEAD dump)
		} :: { ActivityAnchor },
		-- The Empire Bank's anchors (spec w3s2 §5). MapSetup (lane BK) stamps them on BankPlaza (top 1.6 = Y 1.1) once the
		-- 17-part hall is built; until then nothing stamps them and BankRaidService keeps its fallback posts.
		BankAnchors = {
			{ Id = "Town.Bank.Door", Kind = "door", X = 220, Z = -212.5, Yaw = 180, Y = 1.1, Prompt = "hold", Part = "BankGate" }, -- breach: hold 3 s, on foot
			{ Id = "Town.Bank.Vault", Kind = "hold", X = 220, Z = -226, Yaw = 180, Y = 1.1, R = 8 }, -- the crack ring stays inside the hall's walls
			{ Id = "Town.Bank.Loot", Kind = "loot", X = 220, Z = -228, Yaw = 180, Y = 1.1, Prompt = "hold" }, -- "Grab cash"
			{ Id = "Town.Bank.G1", Kind = "npc", X = 206, Z = -209.5, Yaw = 180, Y = 1.1 }, -- behind PlanterW
			{ Id = "Town.Bank.G2", Kind = "npc", X = 234, Z = -209.5, Yaw = 180, Y = 1.1 }, -- behind PlanterE
			{ Id = "Town.Bank.G3", Kind = "npc", X = 210.5, Z = -210.5, Yaw = 180, Y = 1.1 }, -- beside the west column
			{ Id = "Town.Bank.G4", Kind = "npc", X = 229.5, Z = -210.5, Yaw = 180, Y = 1.1 }, -- beside the east column
			{ Id = "Town.Bank.G5", Kind = "npc", X = 227, Z = -231, Yaw = 180, Y = 1.1 }, -- inside, by the vault door (Post stance)
			{ Id = "Town.Bank.R1", Kind = "npc", X = 252, Z = -208, Yaw = 90 }, -- alarm reinforcements, off the plaza (facing the bank)
			{ Id = "Town.Bank.R2", Kind = "npc", X = 188, Z = -208, Yaw = -90 },
		} :: { ActivityAnchor },
	},

	-- ── Spawn pads and anchors (spec §3.3; the hook step replaces MapSetup's makeSpawnFolder rings with these) ───
	Spawns = {
		-- Garage pads (WE_VehicleSpawn): painted Concrete aprons, no beacon, no billboard. Gate pads are plot-local
		-- (BaseLayout.PlotPoint(plotPos, LocalX, LocalZ)) and face the plot forward; pools face Yaw (degrees, 0 = -Z).
		PadSize = Vector3.new(20, 1.2, 20),
		Garage = {
			{ Id = "Gate_P1", PlotId = 1, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P2", PlotId = 2, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P3", PlotId = 3, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P4", PlotId = 4, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P5", PlotId = 5, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P6", PlotId = 6, LocalX = -62, LocalZ = 222 },
			-- claude-bud JOB 21: the land plots 7-10 (no sign: the world sign budget of 17 is full)
			{ Id = "Gate_P7", PlotId = 7, LocalX = -62, LocalZ = 222, NoSign = true },
			{ Id = "Gate_P8", PlotId = 8, LocalX = -62, LocalZ = 222, NoSign = true },
			{ Id = "Gate_P9", PlotId = 9, LocalX = -62, LocalZ = 222, NoSign = true },
			{ Id = "Gate_P10", PlotId = 10, LocalX = -62, LocalZ = 222, NoSign = true },
			{ Id = "Pool_Depot", X = -1180, Z = 34, Yaw = -90 }, -- faces +X (RoadZ0)
			{ Id = "Pool_Armory", X = 1180, Z = -34, Yaw = 90 }, -- faces -X
			{ Id = "Pool_Town", X = 40, Z = 170, Yaw = 0 }, -- faces -Z
			{ Id = "Pool_Airstrip", X = 740, Z = -1180, Yaw = 180 }, -- faces +Z
		} :: { Pad },
		TutorialJeepPad = "Gate_P1", -- the tutorial's jeep step targets the player's own gate pad
		-- vscale R2: the gate pads' "Garage" sign post and board stand this far behind the pad centre (pad-local +Z, was
		-- PadSize.Z / 2 + 0.4 = 10.4): a Roblox-size Pickup / Van parked on the pad reaches 13.29 / 13.10 back
		GarageSignBack = 14.6,
		-- Invisible anchors (Transparency 1, CanCollide false, 14 x 1.2 x 14 at y 1)
		AnchorSize = Vector3.new(14, 1.2, 14),
		NPC = {
			{ Id = "Quarry_1", X = -1470, Z = -1300 },
			{ Id = "Quarry_2", X = -1320, Z = -1480 },
			{ Id = "Quarry_3", X = -1260, Z = -1330 },
			{ Id = "Quarry_4", X = -1440, Z = -1420 },
			{ Id = "Ridge_1", X = 1360, Z = -1100 },
			{ Id = "Ridge_2", X = 1480, Z = -1010 },
			{ Id = "Ridge_3", X = 1450, Z = -1120 },
			{ Id = "Dune_1", X = 1400, Z = 1150 },
			{ Id = "Dune_2", X = 1520, Z = 1240 },
			{ Id = "Dune_3", X = 1470, Z = 1300 },
		} :: { Anchor },
		Event = {
			{ Id = "TownSquare", X = -150, Z = 150 },
			{ Id = "AirdropApron", X = 520, Z = -1190 },
			{ Id = "Salvage", X = -520, Z = 1080 },
			{ Id = "VillageSquare", X = -540, Z = -1300 },
			{ Id = "OilYard", X = 1100, Z = 1100 },
			{ Id = "Quay", X = 250, Z = 1250 },
		} :: { Anchor },
	},

	-- ── W3 step 2 activity anchors (spec w3s2 §1.5–§1.6, §5; contract scratchpad w3s2/build/L0/contract.md) ─────────
	-- A job place is a set of invisible anchors: one Attachment per anchor (0 parts), tagged Tag, carrying the Attr
	-- attributes. The geometry stamps them through ActivityAnchors.Stamp (WorldPOI: layout rows on the POI's
	-- ActivityHost part, template rows on each CheckpointBooth, Town rows on a part of the cluster they Require;
	-- MapSetup: Town.BankAnchors on BankPlaza). The jobs read them through ActivityAnchors.List / Get (server only).
	-- Id = "<POI>.<Site>.<Role>": POI = a POIs Id, Site = one job place at it, Role = what the anchor is for there;
	-- the site id is "<POI>.<Site>". A site is live only when its POI is enabled and every anchor its job needs exists.
	Activity = {
		Tag = "WE_ActivityAnchor", -- CollectionService tag on every anchor Attachment
		Attr = {
			Id = "WE_ActivityId", -- string, the full id
			Site = "WE_ActivitySite", -- string, "<POI>.<Site>"
			POI = "WE_ActivityPOI", -- string
			Role = "WE_ActivityRole", -- string
			Kind = "WE_ActivityKind", -- string, one of Kinds
			Yaw = "WE_ActivityYaw", -- number, degrees (0 = faces north, -Z)
			R = "WE_ActivityR", -- number (optional): zone radius
			Prompt = "WE_ActivityPrompt", -- string (optional): one of Prompts
			Part = "WE_Part", -- string (optional): the part a door anchor opens (HeistGate, BunkerDoor, BankGate)
			BoxW = "WE_ActivityBoxW", -- number (optional): vehicle spawn box width
			BoxL = "WE_ActivityBoxL", -- number (optional): vehicle spawn box length
			Probe = "WE_ActivityProbe", -- boolean (optional): test clearance at runtime, fall back to the nearest post
		},
		-- On a part the jobs move or toggle at runtime (BankGate, HeistGate, BunkerDoor): WorldHygiene Enforce leaves it
		-- alone. GateStateAttr on the same part: "open" (raised, CanCollide false) | "closed".
		RuntimeDoorAttr = "WE_RuntimeDoor",
		GateStateAttr = "WE_GateState",
		HostKit = "ActivityHost", -- the 1-part invisible host kit each POI layout places once (its anchors attach to it)
		CheckpointKit = "Checkpoint", -- every instance gets CheckpointAnchors …
		CheckpointHost = "CheckpointBooth", -- … stamped on this part of the kit
		FloorY = 0.5, -- anchor world Y = FloorY + (row Y or 0): the standing surface, never a lifted prompt height
		MinClear = 1, -- studs: no anchor (Probe ones aside) within this of a collidable part (the geometry tests)
		Kinds = {
			"door", -- breach point in front of a door / gate part (Part names it)
			"hold", -- stand-in zone of radius R (a crack, a pump, a booth, a chest); freezes under fire
			"loot", -- where the loot is grabbed
			"console", -- hack / uplink / alarm console
			"npc", -- a guard post (Gn), an alarm reinforcement point (Rn) or a camp commander (Cmdr)
			"arena", -- an event / king-of-the-hill area of radius R
			"vehicle", -- a vehicle spawn box (Box) — reserved, not a job yet
			"deliver_boat", -- a boat delivery point — reserved
			"sabotage", -- plant a charge (radius R)
			"search", -- a cache to search (radius R)
		},
		Prompts = { "hold", "tap" },
		-- Role vocabulary (a stamped role outside it only warns): the names plus the numbered forms Gn, Rn, PumpN, CacheN
		Roles = { "Door", "Gate", "Vault", "Loot", "Console", "Chest", "Booth", "Alarm", "Pump", "Valve", "Truck", "Recorder", "Box", "Ring", "Arena", "BoatDrop", "Pad", "Pier", "Cmdr" },
		NumberedRoles = { "G", "R", "Pump", "Cache" },
		-- The checkpoint template (kit-local studs; the kit's front, local -Z, faces arriving traffic; booth on +X).
		-- Every Checkpoint kit gets these 6 anchors, "<POI>.<cluster Id>.<Role>" (a POI with one checkpoint names that
		-- cluster "CP"). Clear of the kit's collidables (WorldKits Checkpoint): booth x 15.5..19.5 z -0.2..4.2, far
		-- sandbag x -15.8..-13.4 z -4..4, near sandbag x 13.4..15.8 z -7.1..-2.1. R1 / R2 lie 90 up the road (Probe).
		CheckpointAnchors = {
			{ Role = "Booth", Kind = "hold", X = 17.5, Z = 9.5, Yaw = 0, R = 5, Prompt = "hold" }, -- "Take post", behind the booth
			{ Role = "Alarm", Kind = "console", X = 17.6, Z = -2.0, Yaw = 0, Prompt = "hold" }, -- on the booth front (1.8 clear)
			{ Role = "G1", Kind = "npc", X = -14.6, Z = 5.5, Yaw = 0 }, -- behind the far sandbag (1.5 clear)
			{ Role = "G2", Kind = "npc", X = 21.5, Z = 1.5, Yaw = 0 }, -- beside the booth (2.0 clear)
			{ Role = "R1", Kind = "npc", X = 18, Z = -90, Yaw = 180, Probe = true }, -- alarm reinforcements, running in
			{ Role = "R2", Kind = "npc", X = -18, Z = -90, Yaw = 180, Probe = true },
		} :: { AnchorTemplate },
	},
}

return WorldConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">WorldDetailConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 31 (2026-09-30): REAL DETAIL for the world props that were a few boxes (owner: "the desert tank wreck is
	a brown box and barely reads as a tank"). WorldKits.Add builds the detailed version of these kits instead of the plain
	one:
	  * tank wreck: hull, glacis, both tracks with road wheels and fenders, turret with bustle, mantlet, barrel,
	    muzzle brake and hatch, plus a jerry can and a thrown track link;
	  * truck and field-gun wrecks;
	  * two-course sandbag lines, arcs and nests (the nest with an MG on a tripod and an ammo box);
	  * jersey barriers with the real sloped profile;
	  * a braced watchtower with side rails;
	  * a bunker with a concrete roof, firing slits, roof sandbags and a vent;
	  * a tent with a ridge pole, groundsheet and a crate.
	Everything is our own design from anchored Parts: no scripts, no Neon, no lights, no real-world copies.

	Layouts and budgets do not move:
	  * WorldKits.Footprint (the planner) and every section's cap still count the plain kit;
	  * Add returns the plain count;
	  * the detail's EXTRA parts come out of ONE world allowance, MaxExtraParts. When it is spent, the rest build plain.
	So the world grows by at most MaxExtraParts parts, logged as "[WorldDetail] ... extra=N".
	These props are small decor: on the phone LOW tier QualityGovernor still hides them beyond 220-320 studs (JOB 27;
	buildings are never culled).

	Kill switch: Enabled = false builds exactly the plain kits. The world is built once on the server, for everyone, so
	this has no per-player rollout.
]]

local WorldDetailConfig = {
	Enabled = true,
	-- claude-bud JOB 37: 900 -> 1446 (+546), and the +546 is the road checkpoint's own share (KitCaps): the JOB 31 kits
	-- keep exactly their 900 (MaxExtraParts minus every KitCaps share), the checkpoints never take theirs
	MaxExtraParts = 1446,
	KitCaps = {
		Checkpoint = 546, -- 6 detailed checkpoints x 91 extra; the rest build plain (their guards need the detailed one)
	} :: { [string]: number },
	-- which kits (and Wreck variants) get the detailed build; the car wreck and crates keep their Roblox-made mesh overlay
	Kits = {
		Wreck = { tank = true, truck = true, gun = true },
		SandbagLine = true,
		SandbagArc = true,
		SandbagNest = true,
		Jersey = true,
		Watchtower = true,
		Bunker = true,
		Tent = true,
		Checkpoint = true, -- claude-bud JOB 37: the real road checkpoint (false = today's 8-part kit exactly)
	} :: { [string]: any },
}

return WorldDetailConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">WorldDressConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 2 (W3) — WorldDressConfig: every tunable of the travel dressing BETWEEN the POIs
	(gap/world_v2_spec.md §4.1–§4.4 and §7.1; roadmap §2.4 WORLD-B builder 2). Read by Server/Modules/WorldDress:
	  * Keepout   — the shared keep-out zones (WorldDress.Zones / WorldDress.Blocked; WorldPOI asserts its clusters too)
	  * Rhythm    — road rhythm: a cluster every 140–180 studs along every visible road, sides alternating (§4.1)
	  * Junctions — one corner kit at each of the 6 visible junctions (§4.2)
	  * Shore     — canal inner-bank features every 320 studs + the Bay's north shore (§4.3)
	  * Scatter   — natural Poisson scatter until the largest empty circle is <= 340 (§4.4)
	  * Quality   — Quality "Low": POIs at 60 %, rhythm every other, no scatter (roadmap §2.4)
	  * Budgets   — part caps per section (spec §7.1); the verifier fails above them
	Units: world studs, north = -Z. Desert floor top = 0.5. Every number is a start value to tune on the owner's phone.
	Placement is seeded (WorldKits.Rng(Seed + salt), a pure-Luau PRNG), so the headless sim and the live server build
	the same layout. Rules are enforced at build time (WorldDress.Blocked + WorldHygiene), never assumed from the sim.
]]

export type Point = { X: number, Z: number }
export type ShoreLine = { Side: string, AlongX: boolean, Across: number, From: number, To: number }
export type KindRow = { Kind: string, Parts: number, Natural: boolean }
export type RockRow = { Radius: number, Outer: number, MaxPrims: number, Count: number? }

local WorldDressConfig = {
	Enabled = true,
	Seed = 702, -- spec §4 (model seed); each section adds its own salt

	-- Folder names under WarEmpireSetup.WorldDressing (POIs build WorldDressing.POI_<Id>; Dockside stays as-is)
	Folders = {
		Rhythm = "Rhythm",
		Junctions = "Junctions",
		Shore = "Shore",
		Scatter = "Scatter",
		POIPrefix = "POI_",
	},

	-- ── Shared keep-outs (WorldDress.Zones / WorldDress.Blocked) ───────────────────────────────────────────────────
	-- A cluster disc (centre x, z; radius r) is free only when its EDGE clears every zone below by the margin.
	Keepout = {
		RoadClear = 13, -- disc edge to any road centre line (H2 corridor 12 + 1); callers may pass a smaller RoadR
		WaterMargin = 6, -- every water rect (public, dock channels, plot water) + the bank
		PlotPadMargin = 40, -- plot pads (square, 320)
		CaptureScale = 1.414, -- TerritoryCapture uses the marker half-diagonal (= WorldConfig.Hygiene)
		CaptureExtra = 25,
		CaptureSkip = { "CoastalOilAlpha", "CoastalOilBravo" }, -- rigs stand in water: the water rule covers them
		PadMargin = 16, -- land garage pads (WorldConfig.Spawns.Garage, 20 x 20)
		ApronMargin = 0, -- front-gate aprons (WorldConfig.Hygiene.GateApron, plot-local)
		POIMargin = 30, -- every POI footprint except the one being built (disabled POIs stay reserved)
		EventClear = 20, -- event anchors: supply crates land here (WorldConfig.Spawns.Event)
		NPCClear = 10, -- NPC anchors (WorldConfig.Spawns.NPC)
		BankExtra = 14, -- Empire Bank: BankRaidConfig.GuardRingRadius (18) + 14 = 32 round BankRaidConfig.Position
		-- dry land inside the ring canal (x ±1760, z -1760 .. 1490), inset 20 (30 at the sea)
		Ring = { X0 = -1740, X1 = 1740, Z0 = -1740, Z1 = 1460 },
	},

	-- ── Road rhythm (spec §4.1: 74 clusters, 240 parts incl. the 6 junction kits) ──────────────────────────────────
	Rhythm = {
		Enabled = true,
		Salt = 1,
		Spacing = { 140, 180 }, -- the next spot is rng(140, 180) studs further along the road
		Offset = { 16, 34 }, -- road centre line to the cluster centre; sides alternate after each accepted cluster
		EndInset = 60, -- start / stop this far from each road end (WaterConfig.RoadEnds)
		JunctionClear = 70, -- no rhythm cluster within 70 of a junction centre (the junction kit is there)
		Radius = 8, -- disc radius for the zone tests; the road test uses RoadR = Radius with RoadClear = Offset[1] - Radius
		CollidableRoadGap = 13, -- every collidable part's AABB stays > 12 from every centre line (H2)
		VisibleRoadGap = 9, -- every visible part taller than 0.3 stays > 8 from every centre line (H2 lane)
		-- kinds rotate in this order over the accepted spots (rock_outcrop = Terrain, 0 parts)
		Kinds = { "rock_outcrop", "wreck_or_nest", "flora_group", "rock_outcrop", "sign_or_marker", "flora_group" },
		KindParts = { rock_outcrop = 0, wreck_or_nest = 6, flora_group = 5, sign_or_marker = 2 },
		Target = 74, -- model count incl. the 6 junction kits (the verifier allows ±15 %)
		MaxParts = 224, -- rhythm clusters; + Junctions 36 = 260 (spec §7.1)
		LowEvery = 2, -- Quality Low keeps half the rhythm clusters of each road (LowPattern); junction kits stay
		-- Low keeps accepted cluster i of a road when LowPattern[(i - 1) % 4 + 1]: the 1st, 4th, 5th, 8th, 9th, … Half of
		-- them, and still alternating sides (sides flip on every accepted cluster, so the 1st, 3rd, 5th … would all sit on
		-- the same side of the road). Low is always a subset of Full (the same spots, the same kits).
		LowPattern = { true, false, false, true },
		-- wreck_or_nest rotates over these recipes (6 parts each; contracts §2.3); sign_or_marker over the variants
		WreckRecipes = { "car", "truck", "nest" },
		MarkerVariants = { "km", "hazard" },
	},

	-- ── Junction kits (spec §4.2: 6 visible junctions, 6 parts each) ───────────────────────────────────────────────
	Junctions = {
		Enabled = true,
		Salt = 2,
		-- (0, 0) is the Town; (0, ±800) are under plots 3 / 4
		Points = {
			{ X = -800, Z = -800 },
			{ X = 800, Z = -800 },
			{ X = -800, Z = 0 },
			{ X = 800, Z = 0 },
			{ X = -800, Z = 800 },
			{ X = 800, Z = 800 },
		} :: { Point },
		Corner = 26, -- kit centre at (+26, +26) from the junction (then (-,+), (+,-), (-,-) when blocked): the corner, never the lane
		Radius = 9,
		Kits = { "DirSign", "Jersey", "Jersey", "SandbagArc" }, -- 2 + 1 + 1 + 2 = 6 parts, + 1 Terrain rock (0 parts)
		Parts = 6,
		-- The world SurfaceGui budget (WorldConfig.Budgets.SurfaceGuis = 12) is 10 garage signs + 1 Town board: the junction
		-- posts are painted arrow boards with NO text in this step (the lead re-plans signs before the other 17 POIs)
		SignText = false,
	},

	-- ── Canal and shore features (spec §4.3: 36 features, 105 parts) ──────────────────────────────────────────────
	Shore = {
		Enabled = true,
		Salt = 3,
		Spacing = 320, -- one feature every 320 studs along each line
		Inset = 28, -- feature centre this far in from the water edge (canal x / z ±1760; the lines below)
		Radius = 8,
		Lines = {
			{ Side = "N", AlongX = true, Across = -1732, From = -1700, To = 1700 },
			{ Side = "W", AlongX = false, Across = -1732, From = -1700, To = 1420 },
			{ Side = "E", AlongX = false, Across = 1732, From = -1700, To = 1420 },
		} :: { ShoreLine },
		-- ring landings (future POI jetties): no bank feature within LandingClear of these
		Landings = { { X = 0, Z = -1769 }, { X = 1769, Z = 0 }, { X = -1769, Z = 0 } } :: { Point },
		LandingClear = 60,
		Kinds = {
			{ Kind = "revetment", Parts = 3, Natural = false },
			{ Kind = "reeds_rocks", Parts = 2, Natural = true },
			{ Kind = "jetty_stub", Parts = 3, Natural = false },
			{ Kind = "barge_wreck", Parts = 5, Natural = false },
			{ Kind = "reeds_rocks", Parts = 2, Natural = true },
		} :: { KindRow },
		-- the Bay's north shore (sea edge z 1490): driftwood, a beached hull, dune grass
		Bay = {
			Z = 1446, -- 1490 - bank 24 - 20
			From = -1700,
			To = 1700,
			Spacing = 300,
			Kinds = {
				{ Kind = "driftwood_rocks", Parts = 2, Natural = true },
				{ Kind = "beached_boat", Parts = 4, Natural = false },
				{ Kind = "dune_grass", Parts = 2, Natural = true },
			} :: { KindRow },
			EdgeZ = 1490, -- the sea's north edge (WaterConfig Sea_* Z0): a beached hull reaches InWaterMax past it
		},
		InWaterMax = 10, -- a jetty stub / barge / hull may reach this far into the water (cluster WE_AllowInWater)
		-- these land kinds step from the bank line to the water's edge (their nearest part LandEdgeGap from the water;
		-- WorldHygiene H3 needs > 6): a revetment, reeds or driftwood 28 studs inland would read as litter on the sand
		ToWater = { revetment = true, reeds_rocks = true, driftwood_rocks = true } :: { [string]: boolean },
		LandEdgeGap = 7.5,
		-- ... and only into these water rects (never a dock channel, lagoon, harbour, slip or sea gate)
		InWaterRects = { "Ring_", "Sea_" },
		MaxParts = 120,
	},

	-- ── Natural scatter (spec §4.4: 49 clusters, 104 parts) ────────────────────────────────────────────────────────
	Scatter = {
		Enabled = true,
		Salt = 4,
		EmptyRadius = 155, -- fill only circles whose centre is more than this from anything (spec: 160; tuned with the target)
		MinSpacing = 120, -- to every other cluster centre (rhythm, shore, POI clusters, other scatter)
		RoadClear = 40, -- cluster centre to any road centre line
		Radius = 10,
		Grid = 24, -- emptiness grid cell (studs)
		-- stop when the largest empty circle (diameter, this grid) is <= 310. world_v2_model.py scatter() runs with
		-- target_diam = 320 (49 clusters; its final V10 measure at cell 20 reads 340). Our keep-outs and POI discs leave
		-- slightly different gaps: 320 stops at 40 clusters, 310 gives 46 (104 parts, far100 12 %, largest 322 at cell 20)
		TargetLargestEmpty = 310,
		MaxIterations = 80,
		MaxClusters = 56, -- model 49 +15 %; FaceMapCentre = false (rollback: no dock channels, more dry land) reaches it
		MaxParts = 120,
		-- kinds rotate (rock_cluster / boulder_field = Terrain, 0 parts)
		Kinds = {
			{ Kind = "rock_cluster", Parts = 0, Natural = true },
			{ Kind = "flora_group", Parts = 5, Natural = true },
			{ Kind = "dead_tree_stumps", Parts = 3, Natural = true },
			{ Kind = "flora_group", Parts = 5, Natural = true },
			{ Kind = "boulder_field", Parts = 0, Natural = true },
			{ Kind = "rock_cluster", Parts = 0, Natural = true },
		} :: { KindRow },
		MinElements = 3, -- H1: a natural cluster stands alone only as >= 3 elements of >= 2 sizes (terrain rocks count)
		-- search (world_v2_model.py scatter()): each round takes up to CirclesPerRound of the largest empty circles
		-- (greedy, the next one at least Suppress x r from the last) whose radius exceeds max(EmptyRadius, Target / 2); try
		-- the circle centre, then Tries - 1 spots jittered by rng(-Jitter, Jitter) x (1 + try / 10). A circle with no legal
		-- spot is not tried again (cells within FailClear x r of its centre leave the candidate list).
		CirclesPerRound = 8,
		Suppress = 1.6,
		Tries = 40,
		Jitter = 40,
		FailClear = 0.5,
		FieldMax = 480, -- distances in the emptiness field are exact up to this (studs); the ring is <= 3,520 across
		-- the dry land the emptiness metric measures (contracts §3.5: inside the ring canal, x ±1760, z -1760 .. 1490)
		Land = { X0 = -1760, X1 = 1760, Z0 = -1760, Z1 = 1490 },
	},

	-- ── Quality ────────────────────────────────────────────────────────────────────────────────────────────────────
	Quality = {
		-- MapSetup: live = "Full"; Studio = DevConfig.WorldDressQuality (default "Low")
		Low = {
			POIShare = 0.6, -- each POI builds its Tier-1 clusters only: parts <= 60 % of its Full build
			RhythmEvery = 2, -- = Rhythm.LowEvery
			Scatter = false,
			ShoreEvery = 1, -- the spec gives no Low rule for the shore: all features stay (ASSUMPTIONS, reversible)
		},
	},

	-- ── Terrain rocks (0 parts; WorldKits.Rock fills them) ────────────────────────────────────────────────────────
	Terrain = {
		MaxPrims = 400, -- spec §7.1: <= 400 rock prims on top of the edge's 2,500
		-- WorldKits.Rock groups as the travel dressing uses them: Radius = opts.Radius passed to Rock (every prim stays
		-- inside it), Outer = the keep-out radius tested with WorldDress.Blocked before the fill (terrain collides: rocks
		-- stay >= 13 off every road line, out of the water + 6 and every zone), MaxPrims = the most prims one call fills
		-- (the terrain budget reserves this much per accepted rock, Full or Low alike), Count = fixed prim count
		Rocks = {
			outcrop = { Radius = 12, Outer = 12, MaxPrims = 4 }, -- road rhythm / scatter rock outcrop (2–4 prims)
			boulders = { Radius = 7, Outer = 7, MaxPrims = 6 }, -- junction corner (3–6 balls)
			boulder_field = { Radius = 14, Outer = 14, MaxPrims = 6, Count = 6 }, -- scatter
			shore = { Radius = 5, Outer = 5, MaxPrims = 3, Count = 3 }, -- reeds / driftwood + rocks on the bank
		} :: { [string]: RockRow },
	},

	-- ── Budgets (spec §7.1; parts outside the bases <= 2,900 Full / 1,900 Low overall) ───────────────────────────────
	Budgets = {
		Rhythm = 224,
		Junctions = 36,
		Shore = 120,
		Scatter = 120,
		RhythmLow = 150, -- every other rhythm cluster + the 6 junction kits
		TerrainPrims = 400,
		BuildSeconds = 1.0, -- WorldDress.Build CPU time in the headless sim (logged)
		-- task.wait() after this many clusters (0 = never). 0 because the whole build is a fraction of a second of server
		-- CPU inside MapSetup's deferred dressing thread (the old coordinate-list dressing never yielded either), and the
		-- headless sim's driver thread cannot yield. Set 25 on live if the owner ever sees a start-up hitch.
		YieldEvery = 0,
	},
}

return WorldDressConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">WorldFillConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 3 (2026-09-29, owner: "the map feels too empty"): world detail between the bases and round the Central
	Plaza, placed by Server/Modules/WorldFill (called from MapDressing.Dress) into ONE Workspace folder, "WorldFill".

	Everything is data here. World studs, north = -Z. WorldKits kits face local -Z; Yaw in degrees.
	* Roads: flat 14-wide asphalt strips (no collision, top 0.625 like the world roads) from the four side-base gates
	  (P1 / P2 / P5 / P6; P3 / P4 already sit on RoadX0) to RoadZ0, which runs into the Town and the plaza. Built before
	  WorldDress, and reserved in its occupancy, so the travel dressing never lands on them.
	* Bridges: two raised crossings over the P1 and P6 dock channels (the map's "river"), DeckBottomY above the water so
	  boats still pass under; 7 parts each.
	* Fields: small army positions between the bases (Templates), 57 parts Full / 28 Low each, every item a WorldKits kit
	  (<= 8 parts, no scripts); Tier 2 items are Full quality only. Rocks and hills are Terrain (0 parts).
	* Plaza: a light ring just outside the Town footprint (the Town's 512-stud circle has ~22 parts of headroom).
	Every item is re-checked at build time against WorldDress.Blocked (plots, aprons, garage pads, roads, water, captures,
	POIs, events, the bank, the dressing already placed) and skipped (logged) if blocked.

	Planned parts: Full 388, Low 198 (roads 8 + bridges 14 + fields 6 x 57 + plaza 4 x 6; Low: Tier 1 only). With the world
	at ~2,476 Full / ~1,679 Low that stays under WorldConfig.Budgets (2,900 Full / 1,900 Low; hard cap 3,100).
	tools/checks/claude_bud_worldfill.py recomputes this from the table.
	Enabled = false removes the folder (the game as before).
]]

export type FillItem = {
	Kit: string, -- a WorldKits kit, "Rock" (Terrain: Kind + Radius)
	X: number, -- offset from the field centre (turned by the field yaw)
	Z: number,
	Yaw: number?,
	Tier: number, -- 1 = Low + Full, 2 = Full only
	Opts: { [string]: any }?, -- WorldKits KitOpts (Variant, Count, Length, Scale)
	Kind: string?, -- Rock: "outcrop" | "boulders" | "rubble"
	Radius: number?, -- Rock radius
}

local WorldFillConfig = {
	Enabled = true,
	FolderName = "WorldFill",

	Road = {
		Width = 14,
		Color = Color3.fromRGB(50, 52, 48),
		ReserveStep = 12, -- one occupancy disc per this many studs along each strip ...
		ReserveRadius = 13, -- ... of this radius (WorldDress road clearance)
	},
	-- { X0, Z0, X1, Z1 }: axis-aligned centre lines (one of X or Z equal). Each side gate's apron ends 60 studs out
	-- (x = +-580); the spur runs to x = +-400 (outside the Town footprint + its 30 margin), then along Z to RoadZ0.
	Roads = {
		{ Name = "Fill_RoadP1a", X0 = -580, Z0 = -400, X1 = -393, Z1 = -400 },
		{ Name = "Fill_RoadP1b", X0 = -400, Z0 = -407, X1 = -400, Z1 = -7 },
		{ Name = "Fill_RoadP2a", X0 = -580, Z0 = 400, X1 = -393, Z1 = 400 },
		{ Name = "Fill_RoadP2b", X0 = -400, Z0 = 407, X1 = -400, Z1 = 7 },
		{ Name = "Fill_RoadP5a", X0 = 580, Z0 = -400, X1 = 393, Z1 = -400 },
		{ Name = "Fill_RoadP5b", X0 = 400, Z0 = -407, X1 = 400, Z1 = -7 },
		{ Name = "Fill_RoadP6a", X0 = 580, Z0 = 400, X1 = 393, Z1 = 400 },
		{ Name = "Fill_RoadP6b", X0 = 400, Z0 = 407, X1 = 400, Z1 = 7 },
		-- claude-bud JOB 21: the new plots' gates to the nearest +-800 road, between the front wall and the gate pad
		-- (north plots: front edge z -1140, pad z -1078; south plots: front edge z 1120, pad z 1058)
		{ Name = "Fill_RoadP7", X0 = -980, Z0 = -1110, X1 = -807, Z1 = -1110 },
		{ Name = "Fill_RoadP8", X0 = 980, Z0 = -1110, X1 = 807, Z1 = -1110 },
		{ Name = "Fill_RoadP9", X0 = -1000, Z0 = 1090, X1 = -807, Z1 = 1090 },
		{ Name = "Fill_RoadP10", X0 = 560, Z0 = 1090, X1 = 793, Z1 = 1090 },
	} :: { { Name: string, X0: number, Z0: number, X1: number, Z1: number } },

	-- a bridge runs along Z at X, over a channel whose water spans Z0..Z1 (+ 6-stud banks)
	Bridge = {
		Width = 16,
		DeckBottomY = 21.5, -- 20 studs over the water surface (1.5): every boat passes under
		DeckThick = 1.2,
		RampLen = 60,
		RailH = 1.4,
		Color = Color3.fromRGB(120, 116, 106),
	},
	Bridges = {
		{ Name = "Fill_BridgeP1", X = -1050, Z0 = -554, Z1 = -502 }, -- P1 dock channel (z -548..-508)
		{ Name = "Fill_BridgeP6", X = 1300, Z0 = 502, Z1 = 554 }, -- P6 dock channel (z 508..548)
	} :: { { Name: string, X: number, Z0: number, Z1: number } },

	Templates = {
		-- an army position: tower, nest, bunker, wreck, fuel, crates (Tier 1) + trench, wire, ruin, trees (Tier 2)
		Outpost = {
			{ Kit = "Watchtower", X = 0, Z = 0, Yaw = 0, Tier = 1 },
			{ Kit = "SandbagNest", X = 14, Z = -10, Yaw = 0, Tier = 1 },
			{ Kit = "Bunker", X = -16, Z = -12, Yaw = 0, Tier = 1 },
			{ Kit = "Wreck", X = 22, Z = 16, Yaw = 30, Tier = 1, Opts = { Variant = "tank" } },
			{ Kit = "FuelTank", X = -24, Z = 14, Yaw = 0, Tier = 1, Opts = { Scale = 0.8 } },
			{ Kit = "CrateStack", X = -12, Z = 24, Yaw = 15, Tier = 1, Opts = { Count = 3 } },
			{ Kit = "Rock", X = 40, Z = -36, Tier = 1, Kind = "outcrop", Radius = 16 }, -- a low hill
			{ Kit = "Rock", X = -42, Z = 38, Tier = 1, Kind = "boulders", Radius = 10 },
			{ Kit = "SandbagLine", X = 0, Z = -26, Yaw = 0, Tier = 2, Opts = { Length = 30 } },
			{ Kit = "WireFence", X = 2, Z = 38, Yaw = 0, Tier = 2, Opts = { Length = 48 } },
			{ Kit = "Wreck", X = 32, Z = -22, Yaw = -40, Tier = 2, Opts = { Variant = "truck" } },
			{ Kit = "DrumGroup", X = -32, Z = 26, Yaw = 0, Tier = 2, Opts = { Count = 3 } },
			{ Kit = "RuinedHouse", X = -36, Z = -20, Yaw = 90, Tier = 2 },
			{ Kit = "Revetment", X = 26, Z = 2, Yaw = 90, Tier = 2 }, -- trench wall
			{ Kit = "DeadTree", X = 40, Z = 10, Tier = 2 },
			{ Kit = "Joshua", X = -42, Z = 4, Tier = 2 },
			{ Kit = "DeadTree", X = 8, Z = 46, Tier = 2 },
		} :: { FillItem },
		-- the plaza ring: one sandbag arc + tank trap pair per diagonal
		PlazaPost = {
			{ Kit = "SandbagArc", X = 0, Z = 0, Yaw = 0, Tier = 1 },
			{ Kit = "TankTrap", X = 9, Z = 6, Yaw = 20, Tier = 2 },
			{ Kit = "TankTrap", X = -9, Z = 6, Yaw = -20, Tier = 2 },
			{ Kit = "Rock", X = 0, Z = 18, Tier = 1, Kind = "rubble", Radius = 8 },
		} :: { FillItem },
	},

	-- field centres (world) and their yaw; kits face the field's -Z turned by Yaw
	Fields = {
		{ Id = "Q_NW", Template = "Outpost", X = -470, Z = -620, Yaw = 45 },
		{ Id = "Q_NE", Template = "Outpost", X = 470, Z = -620, Yaw = -45 },
		{ Id = "Q_SW", Template = "Outpost", X = -470, Z = 620, Yaw = 135 },
		{ Id = "Q_SE", Template = "Outpost", X = 470, Z = 620, Yaw = -135 },
		{ Id = "West", Template = "Outpost", X = -1150, Z = 400, Yaw = 90 },
		{ Id = "East", Template = "Outpost", X = 1150, Z = -400, Yaw = -90 },
		{ Id = "Plaza_NW", Template = "PlazaPost", X = -300, Z = -420, Yaw = 0 }, -- north of the Town (outside its footprint + 30), clear of RoadX0 and the spurs
		{ Id = "Plaza_NE", Template = "PlazaPost", X = 300, Z = -420, Yaw = 0 },
		{ Id = "Plaza_SW", Template = "PlazaPost", X = -300, Z = 420, Yaw = 180 },
		{ Id = "Plaza_SE", Template = "PlazaPost", X = 300, Z = 420, Yaw = 180 },
	} :: { { Id: string, Template: string, X: number, Z: number, Yaw: number } },

	--[[ claude-bud JOB 18 (2026-09-29, owner: "the map looks empty, especially from the bomber; the towns lack character"):
		WorldFill 2, the same system (WorldFill.Build runs it after the JOB 3 fill, same occupancy, same folder). Live
		for all. Everything is a WorldKits kit (<= 8 parts, no scripts), a Terrain rock (0 parts) or a plain flat part
		(tracks, wires, dunes); every item is re-checked against the shared occupancy (plots, aprons, runways, garage and
		naval pads, captures, spawn / event / airdrop anchors, roads, water, POIs unless it is that POI's own identity
		field) and skipped when blocked. Tier 2 = small clutter: Full quality only, and the client hides it beyond
		QualityConfig.HideTier2BeyondStuds (180) in low quality.
		  * Identity fields: Crossroads Town = a desert MARKET town (stalls, awnings, planters, parked cars, signs),
		    South Port = an INDUSTRIAL port (containers, tanks, trucks), West Depot / East Armory = GARRISON towns
		    (tents, sandbags, towers); a statue or the fountain in each square; made-up shop names only.
		  * Rooftops: town buildings get a water tank / AC unit / antenna on their real roof (raycast).
		  * Countryside: every 300-stud cell of the map with nothing within EmptyRadius gets a themed patch (farm, oil,
		    comms, ruins, tank graveyard, palms, rocks, wadi, checkpoint), picked by region, so from 80+ studs up no
		    empty square is bigger than ~300 x 300.
		  * Power lines along the two highways outside the Town, dirt tracks from the Town to the outer POIs, and a low
		    dune belt at the north / east / west edge in front of the skyline (the south is sea). ]]
	Fill2 = {
		Enabled = true,
		MaxParts2Full = 7000, -- new parts (the owner's cap is ~15k; kept well under for phones)
		MaxParts2Low = 2600,
		Themes = {
			-- a farm: crop patches, 2 silos, the farmhouse, fence, palms, a pickup
			Farm = {
				{ Kit = "CropField", X = -26, Z = -20, Tier = 1, Opts = { Width = 44, Depth = 32 } },
				{ Kit = "CropField", X = 26, Z = -20, Tier = 1, Opts = { Width = 44, Depth = 32, Variant = "dry" } },
				{ Kit = "CropField", X = -26, Z = 20, Tier = 1, Opts = { Width = 44, Depth = 32, Variant = "dry" } },
				{ Kit = "CropField", X = 26, Z = 20, Tier = 1, Opts = { Width = 44, Depth = 32 } },
				{ Kit = "Silo", X = 62, Z = -8, Tier = 1 },
				{ Kit = "Silo", X = 62, Z = 8, Tier = 1 },
				{ Kit = "AdobeHouse", X = -64, Z = 0, Yaw = 90, Tier = 1 },
				{ Kit = "WireFence", X = 0, Z = 44, Tier = 2, Opts = { Length = 64 } },
				{ Kit = "Palm", X = -62, Z = 22, Tier = 2 },
				{ Kit = "Palm", X = -60, Z = -24, Tier = 2 },
