	Enabled = true,
	SpawnIntervalSeconds = 90,
	MaxActive = 3,
	LifetimeSeconds = 75,
	ClaimHoldSeconds = 2.5,
	ClaimRadius = 10,
	CashMin = 2500,
	CashMax = 12000,
