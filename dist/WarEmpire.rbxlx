		{ Id = "ZA", Name = "South Africa", Short = "South Africa", Region = "Africa", Color = Color3.fromRGB(16, 112, 80), AtlasGroup = "Africa", AtlasCell = 47 },
		{ Id = "ZM", Name = "Zambia", Short = "Zambia", Region = "Africa", Color = Color3.fromRGB(16, 144, 16), AtlasGroup = "Africa", AtlasCell = 48 },
		{ Id = "ZW", Name = "Zimbabwe", Short = "Zimbabwe", Region = "Africa", Color = Color3.fromRGB(16, 112, 16), AtlasGroup = "Africa", AtlasCell = 49 },
	} :: { NationDef },
}

local denied: { [string]: boolean } = {}
for _, id in ipairs(NationConfig.Denied) do
	denied[id] = true
end

local byId: { [string]: NationDef } = {}
for _, n in ipairs(NationConfig.Nations) do
	if not denied[n.Id] then
		byId[n.Id] = n
	end
end

-- The nation for a stored or requested id, or nil (unknown, denied, switched off in OwnerReview, not a string, or
-- longer than 8 bytes). Exact match only: the id is never trimmed or case-folded. NEUTRAL is not a nation (nil here).
function NationConfig.Get(id: any): NationDef?
	if typeof(id) ~= "string" or #id > 8 then
		return nil
	end
	local n = byId[id]
	if n == nil or NationConfig.OwnerReview[id] == false then
		return nil
	end
	return n
end

function NationConfig.IsNeutral(id: any): boolean
	return id == NationConfig.NeutralId
end

-- What a saved NationId may hold after load: NeutralId, a valid nation's Id, or nil (the player is asked again).
function NationConfig.Sanitize(id: any): string?
	if id == NationConfig.NeutralId then
		return NationConfig.NeutralId
	end
	local n = NationConfig.Get(id)
	return if n then n.Id else nil
end

-- Nations the picker may show (roster order), i.e. every Get-able nation.
function NationConfig.Visible(): { NationDef }
	local out = {}
	for _, n in ipairs(NationConfig.Nations) do
		if NationConfig.Get(n.Id) then
			table.insert(out, n)
		end
	end
	return out
end

-- Player-list text: "IE", "ENG" for GB-ENG, NeutralCode for NEUTRAL, "" for anything else.
function NationConfig.Code(id: any): string
	if id == NationConfig.NeutralId then
		return NationConfig.NeutralCode
	end
	local n = NationConfig.Get(id)
	if not n then
		return ""
	end
	return (string.match(n.Id, "^GB%-(%u+)$")) or n.Id
end

-- Flag emoji (only used while PlayerListEmoji is on): regional-indicator pair for 2-letter ids, the tag sequence for
-- England / Scotland / Wales, "" otherwise.
function NationConfig.Emoji(id: any): string
	local n = NationConfig.Get(id)
	if not n then
		return ""
	end
	local a, b = string.byte(n.Id, 1, 2)
	if #n.Id == 2 and a and b then
		return utf8.char(0x1F1E6 + a - 65, 0x1F1E6 + b - 65)
	end
	local sub = string.match(n.Id, "^GB%-(%u%u%u)$")
	if sub then
		local codes = { 0x1F3F4, 0xE0067, 0xE0062 }
		for i = 1, 3 do
			table.insert(codes, 0xE0061 + string.byte(string.lower(sub), i) - 97)
		end
		table.insert(codes, 0xE007F)
		return utf8.char(table.unpack(codes))
	end
	return ""
end

-- Search folding (on the device only; search text never leaves it): ASCII lower case, the roster's accented letters
-- to plain ones, curly apostrophe to straight, runs of spaces to one.
local FOLD = { ["ô"] = "o", ["Ô"] = "o", ["é"] = "e", ["É"] = "e", ["í"] = "i", ["Í"] = "i", ["ã"] = "a", ["Ã"] = "a", ["ü"] = "u", ["Ü"] = "u", ["’"] = "'" }
function NationConfig.Fold(s: string): string
	local out = string.lower(s)
	for from, to in pairs(FOLD) do
		out = string.gsub(out, from, to)
	end
	out = string.gsub(out, "%s+", " ")
	out = string.gsub(out, "^ ", "")
	out = string.gsub(out, " $", "")
	return out
end

-- How well a folded query matches a nation (0 = no match): 4 exact Id, 3 a name starts with it, 2 a word starts with
-- it, 1 it appears inside a name. Names = Name, Short and Aliases. The picker sorts by score, then Short.
function NationConfig.MatchScore(n: NationDef, foldedQuery: string): number
	local q = foldedQuery
	if q == "" then
		return 1
	end
	if string.lower(n.Id) == q then
		return 4
	end
	local best = 0
	local wordStart = "[%s%-%.'(]" .. (string.gsub(q, "%p", "%%%0")) -- q after a space, hyphen, dot, apostrophe or "("
	local function try(text: string)
		local t = NationConfig.Fold(text)
		local at = string.find(t, q, 1, true)
		if at == nil then
			return
		end
		local score = 1
		if at == 1 then
			score = 3
		elseif string.find(t, wordStart) then
			score = 2
		end
		if score > best then
			best = score
		end
	end
	try(n.Name)
	try(n.Short)
	for _, a in ipairs(n.Aliases or {}) do
		try(a)
	end
	return best
end

return NationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">NationFlagIds</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Uploaded nation-flag image ids (numbers of rbxassetid://<id>). 0 = not uploaded yet: the flag part shows its
	banner colour and the picker shows colour + code tiles (NationConfig.LiveRequiresArt keeps the picker from opening
	by itself for non-admins until every Atlas id is set).

	Written by tools/wire-nation-flag-ids.py (never by hand, so a typo cannot slip in):
	  Atlas  the 7 atlas images from tools/gen_nation_flags.py (assets/flags/atlas_<group>.png), one per
	         NationConfig.Atlas.Groups entry. Upload them as the account or group that owns the game and paste the
	         IMAGE ids (Studio Asset Manager ids), not Decal ids.
	  Flags  per-flag fallback (only if the Studio atlas-crop test fails): ["IE"] = <image id>. A nation listed here
	         uses its own image instead of its atlas cell (NationTexture.Source). Keys must be NationConfig ids.
]]

local NationFlagIds = {
	Atlas = {
		Europe = 0,
		Americas = 0,
		Asia = 0,
		Africa = 0,
		MiddleEast = 0,
		Oceania = 0,
		Review = 0,
	} :: { [string]: number },
	Flags = {
	} :: { [string]: number },
}

return NationFlagIds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">NotificationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NotificationConfig — toast lane + offer toast tunables that are NOT layout (layout, colours, holds, the
	Reroute / Drop tables and the offer throttle numbers live in HudConfig.Toast / HudConfig.Offer).

	v70 "clean screen": NotificationController draws plain outlined text lines in the top-centre stack (max 2,
	coalesced, prioritised) — no cards. Money moves at the cash pill (HudLayout.CashFloat), not mid-screen.
	The Purchase SUCCESSFUL line stays the green Success type (HIGH_CONTRAST_SUCCESS marker in the controller).

	Order a message goes through (NotificationController.route):
	  1. Rewrite      text / type fixes for today's server lines (glyphs FredokaOne lacks, type upgrades)
	     AlertEcho    strike-result lines are dropped while the Alert banner already shows them
	  2. Reroute      HudConfig.Toast.Reroute (Collected → float, kills → float, DEF HIT → one BASE UNDER ATTACK)
	  3. Drop         HudConfig.Toast.Drop (+ LocalExemptDrop for server-sent lines only)
	  4. Throttle     per-pattern minimum gaps / once-per-text for recurring server lines
	  5. PurchaseFailure echo dedupe (one failed buy = one line)
	  6. the lane (coalesce "×N", max 2, priority)
]]

export type RewriteRule = { Match: string, Replace: string?, Type: string? }
export type ThrottleRule = { Match: string, MinGapSeconds: number?, OncePerText: boolean? }

-- W3 step 2 Phase B Jobs: OpsService throttles its lines on the server; the client floor below reuses its numbers
local OpsConfig = require(script.Parent.OpsConfig)
local OPS_DIRECTOR = OpsConfig.Director

local NotificationConfig = {
	-- legacy fields (kept for any caller that still reads them)
	DefaultDuration = 4,
	MaxStacked = 4,
	Types = {
		Info = { Color = Color3.fromRGB(90, 160, 220), Fill = Color3.fromRGB(18, 28, 40) },
		-- High-contrast success (competitor "Purchase SUCCESSFUL!" readability)
		Success = { Color = Color3.fromRGB(40, 255, 120), Fill = Color3.fromRGB(8, 48, 22) },
		Collect = { Color = Color3.fromRGB(60, 255, 140), Fill = Color3.fromRGB(6, 42, 20) },
		Warn = { Color = Color3.fromRGB(255, 200, 60), Fill = Color3.fromRGB(40, 32, 10) },
		Error = { Color = Color3.fromRGB(255, 80, 80), Fill = Color3.fromRGB(48, 12, 12) },
		Reward = { Color = Color3.fromRGB(255, 210, 90), Fill = Color3.fromRGB(40, 32, 12) },
	},

	-- lane --------------------------------------------------------------------------------------------------
	-- A caller's Duration may lengthen a line up to this (server lines ask 3.5-7 s; the lane is meant to be brief)
	MaxHoldSeconds = 4,
	MinHoldSeconds = 1.2,
	-- When 2 lines are up and a new one arrives, the oldest line of the LOWEST priority goes first
	-- (a gold level-up line outlives an "Outposts held" Info line). Equal priority → oldest goes.
	Priority = { Error = 4, Reward = 4, Warn = 4, Success = 3, Info = 1 },
	-- Coalesce "×N" suffix (HudConfig.Toast.CoalesceWindow / CoalesceKey = digits stripped)
	CoalesceSuffix = " ×%d",
	-- measured text box padding in v (UIStroke is drawn outside the glyphs)
	LinePadX = 8,
	LinePadY = 2,

	-- 1. Rewrite: first match wins; Replace is a string.gsub replacement for Match (nil = keep text).
	Rewrite = ({
		-- XPService "★ LEVEL 9! — Sniper Rifle unlocked" (Success today) → the gold Reward line of the spec
		{ Match = "^(★ LEVEL %d+!) — ", Replace = "%1 ", Type = "Reward" },
		{ Match = "^★ LEVEL %d+!", Type = "Reward" },
		-- "Purchase SUCCESSFUL! Helipad → Lv 2": FredokaOne has no "→" (spec risk #5)
		{ Match = " → Lv (%d+)", Replace = " Lv %1" },
		-- server purchase-failure echo uses the competitor wording the client uses
		{ Match = "^Not enough cash$", Replace = "You need more Money!", Type = "Warn" },
		-- raids (RaidConfig.Text): short lines, no "→" / emoji (FredokaOne lacks them); the shield chip shows the timer
		{ Match = "^ATM RAIDED by (.-) (−%$[%d,%.KMB]+).*$", Replace = "ATM raided by %1! %2", Type = "Error" },
		{ Match = "^ATM RAID %+(%$[%d,%.KMB]+) from (.-) → your ATM$", Replace = "Raided %2's ATM! +%1", Type = "Success" },
	} :: { RewriteRule }),

	-- Server lines that repeat what the Alert slot banner already says (MissileController's INCOMING MISSILE
	-- banner shows the strike result for a few seconds) — dropped only while an alert banner is visible.
	AlertEcho = {
		"Missile hit! Defenses down",
		"Your Missile Defense shot down",
		"^Direct hit! ",
		"^Intercepted by ",
		"INCOMING MISSILE",
	},

	-- 3. Drop patterns that apply ONLY to server-sent lines (a local NotificationController.Show of the same
	-- words is intended: OrdersController's T-key "Squad: FOLLOW" Info line while the Army popover is closed).
	LocalExemptDrop = { "^Squad: " },

	-- 4. Throttle recurring server lines on the client (the §4.2 server fixes are deferred)
	Throttle = ({
		{ Match = "^Rebirth almost ready", OncePerText = true }, -- every 90 s today; once per level per session
		{ Match = "^REBIRTH READY", MinGapSeconds = 600 },
		{ Match = "^Raid cooldown", MinGapSeconds = 10 }, -- ATM raid cooldown Warn while standing at the ATM
		{ Match = "is robbing your ATM", MinGapSeconds = 15 },
		{ Match = "^Nothing to collect yet", MinGapSeconds = 20 },
		{ Match = "^Cash drop is recharging", MinGapSeconds = 30 },
		-- Jobs (OpsConfig.Text.Toast; a job or player name is never a nation): one "open" / "raid" line per 10 min,
		-- the server-wide "robbed" line and the bag alert at most once a minute
		{ Match = " is open$", MinGapSeconds = OPS_DIRECTOR.OpenToastGapSeconds }, -- "<Job title> is open"
		{ Match = "^Empire Bank raid started$", MinGapSeconds = OPS_DIRECTOR.OpenToastGapSeconds },
		{ Match = " robbed the Empire Bank$", MinGapSeconds = OPS_DIRECTOR.RobbedLineGapSeconds },
		{ Match = "^Bank bag on the move$", MinGapSeconds = OPS_DIRECTOR.RobbedLineGapSeconds },
	} :: { ThrottleRule }),

	-- 5. One failed purchase = one line. WorldPromptController shows the failure first (WE_BuyAck / PurchaseResult,
	-- via NotificationController.ShowPurchaseFailure); any other purchase-failure line within WindowSeconds —
	-- the second client path or the server's own Warn echo (BaseService / UpgradePadService) — is skipped.
	PurchaseFailure = {
		WindowSeconds = 1.5,
		Patterns = {
			"^You need more Money!$",
			"^Not enough gold$",
			"^Already at MAX level$",
			"^Missing prerequisite structure$",
			"^Unknown structure$",
			"^Buying too fast",
			"^Profile still loading",
			"^Buy failed",
			"^Purchase failed: ",
			"^Not your base — walk your plot pads to buy$",
			"^Claim a base first",
			"^Go to your .+ console to buy it$", -- v71 NotAtConsole (ConsoleBuyConfig.Text.NotAtConsole)
		},
	},

	-- offer toast (the numbers — MaxPerSession 3, MinGapSeconds 240, FirstAfterJoinSeconds 90, death 600 s,
	-- queue 60 s — are in HudConfig.Offer so the money plan tunes them in one place)
	Offer = {
		DeathKeyPattern = "^Death", -- ShopController.DeathShopToast's Key → HudConfig.Offer.DeathOfferMinGapSeconds
		QueueMax = 3, -- deferred offers waiting for a calm moment (one per Key)
		TickSeconds = 0.5, -- queue / expiry check
		IconSize = Vector2.new(36, 28), -- v, HudIcons "Cash"
		-- touch: GET / ✕ hit areas are 64 v (44.8 px) instead of the desktop 44 v, so the pill may grow this much
		-- past HudConfig.Offer.MaxWidth (still capped at the stack's 0.62 × content) to keep the Sub line readable
		TouchExtraWidth = 120,
		GetText = "GET", -- fallback CTA
		CloseText = "✕",
	},
}

return NotificationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">NukeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): Nuke — consumable 19 R$ DevProduct (profile.Nukes) + post-rebirth Tactical Nuke (profile.TacticalNukes).
	ONE balance file. Server: NukeService (M5). Client: NukeController / NukeFx (radii, timings, copy).
	Paid grants ONLY via MonetizationService.ProcessReceipt (DevProducts.Nuke / NukeBundle3 → GrantNukes, added by M1
	with Id = 0). Config only: nothing reads this file yet and nothing is sold from it.

	Judge rulings applied (money/plan.md §1):
	- J1: a nuke can never open a base for raiding. Base mode gives kills, XP and scorch only, then puts a fallout
	  shield on the target (Base.FalloutShieldSeconds → Raid.ShieldUntil / WE_ShieldUntil). No defenses-down,
	  no ATM, cash or structure loss.
	- J5 / J6: the Nuclear Silo has 5 levels and one site only (Strategic Yard, Rebirth 2). No fallback site.
	- J8: any non-immune vehicle inside CoreRadius is destroyed; the edge ring deals DamageAt × EdgeDamageMult.
	- J17: own Fx remote (FxRemote = "NukeFx"), not MissileStrikeFx.
	- J24: world billboards and pads use the text "NUKE"; icons use IconImage once it is set.
	- J26: keep ServerCooldownSeconds = 180; raise to 300 here if the victim-leave KPI rises > 5 points. ]]

export type KindDef = {
	DisplayName: string,
	InventoryField: string,
	Radius: number,
	CoreRadius: number,
	CoreDamage: number,
	EdgeDamageMax: number,
	EdgeDamageMin: number,
	FlashRadius: number,
	LaunchXPFactor: number,
	LaunchXPMin: number,
	LaunchXPMax: number,
	KillBonusScale: number,
	CloudHeight: number,
	CloudScale: number,
}

local NukeConfig = {
	Enabled = true,
	CountdownSeconds = 10,
	TerminalDiveSeconds = 3,
	IconImage = "", -- owner: rbxassetid of a trefoil decal ("" → the text "NUKE"; J24)
	WorldLabel = "NUKE", -- billboards / pads (J24: no glyph that can fall back in FredokaOne)
	FxRemote = "NukeFx", -- Constants.RemoteNames.NukeFx (J17)

	KindOrder = { "Nuke", "TacticalNuke" },
	Kinds = {
		Nuke = {
			DisplayName = "Nuke",
			InventoryField = "Nukes",
			Radius = 150,
			CoreRadius = 75,
			CoreDamage = 1000,
			EdgeDamageMax = 200,
			EdgeDamageMin = 40,
			FlashRadius = 600,
			LaunchXPFactor = 0.30,
			LaunchXPMin = 400,
			LaunchXPMax = 6000,
			KillBonusScale = 1.0,
			CloudHeight = 220,
			CloudScale = 1.0,
		},
		TacticalNuke = {
			DisplayName = "Tactical Nuke",
			InventoryField = "TacticalNukes",
			Radius = 100,
			CoreRadius = 50,
			CoreDamage = 1000,
			EdgeDamageMax = 160,
			EdgeDamageMin = 30,
			FlashRadius = 400,
			LaunchXPFactor = 0.15,
			LaunchXPMin = 200,
			LaunchXPMax = 3000,
			KillBonusScale = 0.6,
			CloudHeight = 150,
			CloudScale = 0.7,
		},
	} :: { [string]: KindDef },

	Rules = {
		ServerCooldownSeconds = 180, -- J26
		PlayerCooldownSeconds = 300,
		MaxLaunchesPerPlayerPerHour = 6,
		BaseTargetCooldownSeconds = 900, -- the same base cannot be nuked again for 15 min
		VictimGraceSeconds = 600,
		SessionJoinGraceSeconds = 120,
		NewPlayerProtectionSeconds = 600, -- mirror RaidConfig.Raid.NewPlayerProtectionSeconds
		MinVictimLevelIfNoPrestige = 5,
		ProtectNewPlayersInStudio = false,
		SpawnSafeRadius = 24,
		AlliesImmune = true,
		BaseTargetMinPowerRatio = 0.35,
		PowerPerPrestige = 40,
		RefundIfTargetLeaves = true,
		InFlightRefundAfterSeconds = 30, -- J19: a younger marker at load is re-checked at At + 30 while online
		LaunchRate = 0.5,
		LaunchBurst = 2,
		StateRate = 1,
		StateBurst = 2,
	},

	Targeting = {
		-- plot-local, converted through the pad CFrame. Nations: on MainRoad (BaseLayoutConfig), 48 studs in front of the
		-- flagpole (Courtyard.Flagpole Z = 8), so a player's nation flag is never the aim point (BuyPathStatic: >= 30 studs)
		BaseAimPoint = { X = 0, Z = 56 },
		PlotClearance = 25,
		MapHalfExtent = 2350,
		GroundRayTop = 600,
		IncludeBank = true, -- + every TerritoryConfig.Territories entry except the Home Outposts (below)
		-- F10 (owner's 11 features): a Home Outpost (TerritoryConfig row with IsStarter = true) is never a nuke target
		-- (NukeConfig.IsTerritoryTargetable)
		SkipStarterOutposts = true,
	},

	Rewards = {
		PlayerKillBonusXP = 260,
		PlayerKillBonusCash = 350,
		NPCKillBonusMult = 1.0,
		SquadKillXP = 30,
		SquadKillCash = 40,
		MaxKillBonusXP = 6000,
		MaxKillBonusCash = 12000,
		XPReason = "nuke",
		CashReason = "nuke_kill",
	},

	-- J1: kills + XP + scorch, then a fallout shield on the target base. There are deliberately NO defenses-down
	-- fields: NukeService must never call GateDefenseService / MissileStrikeService for a base.
	Base = {
		FalloutShieldSeconds = 300, -- Raid.ShieldUntil = max(current, now + 300) (+ WE_ShieldUntil); blocks raids + strikes
		ScorchSeconds = 30, -- client-only ground scorch
	},

	-- J8: vehicles in the core are destroyed outright (so a 4,200 HP tank cannot survive ground zero). The edge ring
	-- deals NukeConfig.DamageAt × EdgeDamageMult through VehicleHealth.ApplyRadiusDamage(..., "Nuke"), ignoring armor.
	-- Occupant cover applies only in the edge ring.
	Vehicles = {
		CoreDestroys = true,
		EdgeDamageMult = 4,
		CoverMult = 0.6,
		PremiumCoverMult = 0.35,
	},

	-- J5: 5 levels (costs, online build time, capacity). J6: one site only, the Strategic Yard (Rebirth 2); the Silo
	-- waits for the rebirth world workflow (M7b), which owns the geometry (BaseLayoutConfig).
	Silo = {
		Enabled = true,
		UnlockPrestige = 2,
		Zone = "StrategicYard", -- RebirthConfig.Zones.StrategicYard
		Site = { X = 0, Z = -124, YawDeg = 0, Footprint = 22 }, -- plot-local (rebirth spec §2); no fallback site
		Requires = { CommandCenter = 3, MissileDefense = 1 } :: { [string]: number },
		Costs = { 250_000, 750_000, 2_000_000, 3_500_000, 6_000_000 },
		BuildSeconds = { 5400, 4200, 3000, 2400, 1800 }, -- 90 / 70 / 50 / 40 / 30 online minutes
		Capacity = { 1, 1, 2, 2, 3 },
		TickSeconds = 5,
	},

	Gift = { Enabled = true, AtLevel = 10, Kind = "TacticalNuke", Count = 1 },

	Offers = { RevengeCooldownSeconds = 600, RevengeMinVictimLevel = 5, RevengeDelaySeconds = 3 },

	Fx = {
		ArcApex = 500,
		FireballMaxSize = 110,
		ShockwaveMult = 1.6,
		CloudHoldSeconds = 12,
		CloudFadeSeconds = 6,
		CleanupSeconds = 25,
		PartBudget = 48,
		PartBudgetLow = 24,
		ShakeMaxStuds = 2.2,
		ShakeSeconds = 1.8,
		ShakeFalloffStuds = 1200,
		SoundSpeed = 1100,
		MaxBoomDelay = 2,
		MarkerTransparency = 0.8,
		InterceptorRange = 350, -- cosmetic interceptors that miss (a nuke is never intercepted)
	},

	Audio = { SirenId = "", BoomId = "", LaunchId = "", SirenVolume = 0.5, BoomVolume = 1.0 },

	Text = {
		Incoming = "☢ NUKE INCOMING · %s · %s",
		InZone = "YOU'RE IN THE BLAST ZONE: RUN ➜",
		Protected = "🛡 You're protected (%s)",
		YourBase = "☢ YOUR BASE IS BEING NUKED by %s: run or get to your spawn pad!",
		Away = "☢ NUKE AWAY → %s · impact %s",
		Aborted = "NUKE ABORTED (%s)",
		Report = "☢ NUKE REPORT · Enemies %d · Hostiles %d · Squads %d · +%s XP · +$%s",
		Broadcast = "☢ %s's NUKE hit %s: %d eliminated",
		Revenge = "Nuked by %s. Strike back? ☢ Nuke",
		Ready = "☢ NUKE READY",
		AirspaceClear = "☢ Airspace clear: launch your Nuke",
		Refunded = "Your unfinished nuke launch was refunded",
		TargetLeft = "%s left: nuke returned",
		BaseNuked = "☢ Your base was nuked by %s. Nuke-proof for %s",
		SiloReady = "☢ Tactical Nuke ready in your Silo",
		Gift = "☢ First strike's on us: 1 Tactical Nuke. Tap ☢ to launch!",
		Reasons = {
			Disabled = "Nukes are switched off",
			Loading = "Your save is still loading",
			Dead = "Respawn first",
			NoInventory = "No nukes: get one (19 R$)",
			NoTactical = "No Tactical Nukes: build a Silo (Rebirth 2)",
			InFlight = "Airspace busy: a nuke is already inbound",
			ServerCooldown = "Airspace clears in %s",
			PlayerCooldown = "Launcher reloading %s",
			HourlyCap = "Launch limit: next in %s",
			Self = "That's your base",
			Ally = "Clan ally",
			TargetOffline = "Player left",
			TargetLoading = "Their save is still loading",
			NewPlayer = "New player protection: %s",
			Shielded = "🛡 Shielded %s",
			RecentlyNuked = "Recently nuked: %s",
			TooWeak = "Too weak to target",
			TooCloseToBase = "Too close to a base",
			OffMap = "Off the map",
			NoGround = "No ground there",
		} :: { [string]: string },
	},
}

function NukeConfig.DamageAt(def: KindDef, distance: number): number
	if distance <= def.CoreRadius then
		return def.CoreDamage
	end
	if distance > def.Radius then
		return 0
	end
	local t = (distance - def.CoreRadius) / math.max(1, def.Radius - def.CoreRadius)
	return math.floor(def.EdgeDamageMax - (def.EdgeDamageMax - def.EdgeDamageMin) * t + 0.5)
end

-- J8: damage to a (non-immune) vehicle at this distance; math.huge inside the core (destroyed outright).
function NukeConfig.VehicleDamageAt(def: KindDef, distance: number): number
	if distance > def.Radius then
		return 0
	end
	if distance <= def.CoreRadius and NukeConfig.Vehicles.CoreDestroys then
		return math.huge
	end
	return NukeConfig.DamageAt(def, distance) * NukeConfig.Vehicles.EdgeDamageMult
end

function NukeConfig.LaunchXP(def: KindDef, xpToNext: number): number
	local raw = (tonumber(xpToNext) or 0) * def.LaunchXPFactor
	if raw ~= raw or raw == math.huge then
		return def.LaunchXPMax
	end
	return math.clamp(math.floor(raw + 0.5), def.LaunchXPMin, def.LaunchXPMax)
end

function NukeConfig.Power(level: number, prestige: number): number
	return math.max(1, math.floor(level)) + math.max(0, math.floor(prestige)) * NukeConfig.Rules.PowerPerPrestige
end

-- Silo level 1..5 → build seconds / capacity (nil outside the table).
function NukeConfig.SiloBuildSeconds(level: number): number?
	return NukeConfig.Silo.BuildSeconds[math.floor(level)]
end

function NukeConfig.SiloCapacity(level: number): number
	return NukeConfig.Silo.Capacity[math.floor(level)] or 0
end

-- F10: the nuke target filter for a TerritoryConfig.Territories row (Home Outposts are skipped).
function NukeConfig.IsTerritoryTargetable(def: { IsStarter: boolean? }?): boolean
	if def == nil then
		return false
	end
	if NukeConfig.Targeting.SkipStarterOutposts and def.IsStarter == true then
		return false
	end
	return true
end

function NukeConfig.FormatTime(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

return NukeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">OilRigConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Coastal oil platform POIs — harder guards, higher capture stipends.
	Wired into TerritoryConfig Ids CoastalOilAlpha / CoastalOilBravo.
]]

local OilRigConfig = {
