        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">SoldierConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Army + Training Yard worker income (MT-inspired: soldiers generate cash while "training").
	Visual: R15-ready config keys; catalog IDs live in VisualAssetConfig.Characters.
	If ModelAssetId missing/0 → military Part-kit placeholder (MapSetup.makeSoldierKit / CombatService).
]]

local SoldierConfig = {
	StartingSoldiers = 5,
	MaxSoldiersBase = 50,
	SoldiersPerBarracksLevel = 5,
	RecruitCostCash = 500,
	RecruitBatchSize = 1,
	DismissRefundMult = 0.25,
	SoldierHealth = 100,
	SoldierDamage = 12,
	SoldierSpeed = 14,

	-- Training Yard passive (owned soldiers → cash each tick)
	TrainingIncome = {
		TickSeconds = 5,
		CashPerSoldierPerTick = 8, -- 5 soldiers ≈ $8/s effective over tick (40/5s)
		MinSoldiersForIncome = 1,
	},

	--[[
		R15-ready visual path (Design Bot / Code P0).
		VisualKind maps → VisualAssetConfig.Characters[kind].
		VisualPlaceholder = Part-kit camo soldier when catalog ID is 0 / insert fails.
		Do NOT invent Creator Store IDs here — leave slots; wire in VisualAssetConfig only.
	]]
	Visual = {
		Rig = "R15", -- preferred attach target; Part kit remains R6-ish fallback proportions
		VisualKindDefault = "Soldier",
		VisualKindByRole = {
			Worker = "Worker", -- v41: VisualAssetConfig.Characters.Worker 16134469614
			Infantry = "Infantry",
			Heavy = "HeavyInfantry",
			Guard = "Guard",
			BankGuard = "BankGuard",
			OilRigGuard = "OilRigGuard",
			FortGuard = "FortGuard",
			SpecialForces = "SpecialForces", -- v41 SF unit VisualKind
		},
		-- Placeholder palette when mesh missing (olive drab / desert camo)
		VisualPlaceholder = {
			Enabled = true,
			BodyColor = Color3.fromRGB(70, 85, 55),
			AccentColor = Color3.fromRGB(180, 220, 120),
			Helmet = true,
			Rifle = true,
			Note = "MapSetup.makeSoldierKit + CombatService Part kit until Design Bot mesh loads",
		},
		-- Optional future slots (TODO — no invented IDs)
		ModelAssetIdOverride = 0, -- 0 = use VisualAssetConfig.Characters
		AccessoryIds = {} :: { number }, -- TODO Design Bot
	},
}

return SoldierConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SoundConfig — every sound the client plays (W1 SND audio pass). Config first: AudioController plays these keys,
	AudioHooks maps EXISTING remotes / HUD signals onto them. Sounds are created on the CLIENT only (never on the
	server; AudioController refuses to run there).

	LICENCE (roadmap §1.4, owner decision D4 = accept Roblox's licensed sound library, in-game only).
	Every Id is one of:
	  [PSE]  Roblox licensed library, Pro Sound Effects partner upload (Creator Store) — free inside Roblox experiences.
	  [APM]  Roblox licensed library, APM / KPM partner upload (Creator Store) — free inside Roblox experiences.
	  [RBX]  Roblox-owned: the engine sounds of Roblox's own "Light Utility Vehicle" (asset 6418221666, creator Roblox).
	  [ENG]  Engine built-in content path (rbxasset://sounds/…, ships with every Roblox client; already used in v70).
	  ⚠ [PSE]/[APM] audio must NOT be used in YouTube / TikTok promos (copyright claims are likely).
	Ids come from gap/reusable_parts.md §2.4 + §2.1 V-a (Creator Store search, 2026-09-24). The owner should preview each
	one in Studio (Toolbox › Creator Store › Audio › paste the id) before a publish; to swap a sound change its Id here.
	Id 0 (or "") disables a key: AudioController.Play then returns false and never errors.

	KEY FIELDS
	  Id               asset id (number) or an engine built-in path (string "rbxasset://sounds/…")
	  Volume           0..1, × Mix.SfxMaster (or Mix.MusicMaster for Bus "Music")
	  RollOff          Enum.RollOffMode name: "InverseTapered" | "Inverse" | "Linear" | "LinearSquare" (3D plays only)
	  MaxDistance      studs. A 3D play farther than this from the camera is skipped (it would be inaudible anyway)
	  Pitch            PlaybackSpeed
	  CooldownSeconds  the same key never starts again within this (no 40 coin sounds at the ATM)
	  Priority         1..5 (optional, default 1): voice stealing and the Stinger collapse keep the higher one
	  Bus              "UI"      button taps (no collapse)
	                   "Stinger" event cues (purchase, collect, capture, level, alarms, toasts): at most ONE per
	                             Mix.StingerWindowSeconds — the higher Priority wins, so one server event that
	                             arrives as 2–3 client signals (PurchaseResult + cash float + toast) is one sound
	                   "World"   positional one-shots (Play(key, at)); CC-3 / EVENTS add their keys here
	                   "Music"   music channel (ClientSettings music toggle)
	                   "Loop"    ambience / engine channels (ClientSettings SFX toggle)
	  MaxSeconds       stop a one-shot after this (long library files, e.g. the 30 s siren)
	  LengthSeconds    busy-time hint for the voice cap before the file length is known (default Mix.DefaultLengthSeconds)
	  MinDistance      3D RollOffMinDistance (default Mix.MinDistance)
]]

export type SoundDef = {
	Id: number | string,
	Volume: number,
	RollOff: string,
	MaxDistance: number,
	Pitch: number,
	CooldownSeconds: number,
	Priority: number?,
	Bus: string?,
	MaxSeconds: number?,
	LengthSeconds: number?,
	MinDistance: number?,
}

export type EngineProfile = {
	Key: string,
	PitchMin: number, -- PlaybackSpeed at standstill
	PitchMax: number, -- PlaybackSpeed at the vehicle's WE_MaxSpeed
}

export type EngineFamily = {
	Prefix: string, -- WE_KitFamily prefix (VehicleService kit families: WheeledLight, TrackedMBT, HeliLight, JetFighter …)
	Key: string,
	PitchMin: number,
	PitchMax: number,
}

local ENG_PING = "rbxasset://sounds/electronicpingshort.wav" -- [ENG] the v70 UI click (unchanged)
local ENG_SWITCH = "rbxasset://sounds/switch.wav" -- [ENG] the v70 toast ping (unchanged)

local SoundConfig = {}

SoundConfig.Sounds = {
	-- ── UI (button taps; every existing AudioController.PlayClick caller) ─────────────────────────────────────
	["UI.Click"] = { Id = ENG_PING, Volume = 0.55, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "UI", LengthSeconds = 0.3 }, -- [ENG] electronicpingshort.wav

	-- ── toasts (NotificationController's PlayNotification, typed by AudioHooks from the Notification remote) ──
	["UI.Notify"] = { Id = ENG_SWITCH, Volume = 0.55, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.3, Priority = 1, Bus = "Stinger", LengthSeconds = 0.4 }, -- [ENG] switch.wav (local toasts with no typed key)
	["Toast.Success"] = { Id = 9113849492, Volume = 0.45, RollOff = "Linear", MaxDistance = 0, Pitch = 1.2, CooldownSeconds = 0.4, Priority = 2, Bus = "Stinger", LengthSeconds = 1.2 }, -- [PSE] "Coins Or Keys Jingle 6" 9113849492, pitched up
	["Toast.Reward"] = { Id = 9113849492, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.6, Priority = 2, Bus = "Stinger", LengthSeconds = 1.5 }, -- [PSE] "Coins Or Keys Jingle 6" 9113849492
	["Toast.Warn"] = { Id = ENG_PING, Volume = 0.5, RollOff = "Linear", MaxDistance = 0, Pitch = 0.7, CooldownSeconds = 1, Priority = 2, Bus = "Stinger", LengthSeconds = 0.4 }, -- [ENG] electronicpingshort.wav, low
	["Toast.Error"] = { Id = ENG_SWITCH, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 0.6, CooldownSeconds = 1, Priority = 2, Bus = "Stinger", LengthSeconds = 0.5 }, -- [ENG] switch.wav, low

	-- ── cash / purchases ──────────────────────────────────────────────────────────────────────────────────────
	["Cash.Collect"] = { Id = 9113849492, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.3, Priority = 3, Bus = "Stinger", LengthSeconds = 1.2 }, -- [PSE] "Coins Or Keys Jingle 6" 9113849492
	["Cash.Purchase"] = { Id = 9113728042, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.5, Priority = 3, Bus = "Stinger", LengthSeconds = 1.5 }, -- [PSE] "Cash Register 1" 9113728042
	["UI.Denied"] = { Id = ENG_PING, Volume = 0.5, RollOff = "Linear", MaxDistance = 0, Pitch = 0.55, CooldownSeconds = 0.6, Priority = 2, Bus = "Stinger", LengthSeconds = 0.4 }, -- [ENG] electronicpingshort.wav, lowest (failed buy)

	-- ── outposts (TerritoryStateUpdate diffs) ─────────────────────────────────────────────────────────────────
	["Capture.Start"] = { Id = ENG_PING, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 0.85, CooldownSeconds = 3, Priority = 3, Bus = "Stinger", LengthSeconds = 0.4 }, -- [ENG] electronicpingshort.wav ("radio" cue)
	["Capture.Secured"] = { Id = 9113849492, Volume = 0.8, RollOff = "Linear", MaxDistance = 0, Pitch = 0.85, CooldownSeconds = 2, Priority = 4, Bus = "Stinger", LengthSeconds = 1.6 }, -- [PSE] "Coins Or Keys Jingle 6" 9113849492 (+income), low
	["Capture.Lost"] = { Id = 9119236749, Volume = 0.5, RollOff = "Linear", MaxDistance = 0, Pitch = 0.8, CooldownSeconds = 3, Priority = 4, Bus = "Stinger", LengthSeconds = 2 }, -- [PSE] "Small Explosion 1" 9119236749

	-- ── progression ───────────────────────────────────────────────────────────────────────────────────────────
	["Level.Up"] = { Id = 9113849492, Volume = 0.9, RollOff = "Linear", MaxDistance = 0, Pitch = 1.3, CooldownSeconds = 2, Priority = 4, Bus = "Stinger", LengthSeconds = 1.2 }, -- [PSE] "Coins Or Keys Jingle 6" 9113849492, high

	-- ── alarms ────────────────────────────────────────────────────────────────────────────────────────────────
	["Alarm.Raid"] = { Id = 9113073742, Volume = 0.55, RollOff = "Linear", MaxDistance = 0, Pitch = 1.15, CooldownSeconds = 8, Priority = 5, Bus = "Stinger", MaxSeconds = 3 }, -- [PSE] "Air Raid Siren Old Fashioned 1" 9113073742 (ATM being robbed)
	["Alarm.Base"] = { Id = 9113073742, Volume = 0.5, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 60, Priority = 5, Bus = "Stinger", MaxSeconds = 3 }, -- [PSE] same siren ("BASE UNDER ATTACK!" banner; its Reroute rule shows it at most once per 60 s)
	["Alarm.Missile"] = { Id = 9113073742, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 4, Priority = 5, Bus = "Stinger", MaxSeconds = 9 }, -- [PSE] same siren; 9 s = RaidConfig.Strike MaxFlightSeconds

	-- ── music (ClientSettings music toggle) ───────────────────────────────────────────────────────────────────
	["Music.Base"] = { Id = 1844397606, Volume = 0.22, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Music" }, -- [APM] "Military March" 1844397606 (159 s), base theme
	["Music.Combat"] = { Id = 1841116989, Volume = 0.3, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Music" }, -- [APM] "Military March" 1841116989 (63 s), combat layer

	-- ── ambience: ONE loop channel (ClientSettings SFX toggle) ────────────────────────────────────────────────
	["Amb.Wind"] = { Id = 9114057104, Volume = 0.18, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [PSE] "Desert Wind Whistley Light Gusts 1" 9114057104 (37 s)
	["Amb.Surf"] = { Id = 9119677135, Volume = 0.3, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [PSE] "Surf Ocean Wave Impact 1" 9119677135

	-- ── engines: ONE loop channel, pitch follows the chassis speed at Engine.SampleHz ─────────────────────────
	["Engine.Ground"] = { Id = 6417138409, Volume = 0.45, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [RBX] LUV "Sedan_Loop_Mid" 6417138409
	["Engine.Heavy"] = { Id = 6417179625, Volume = 0.5, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [RBX] LUV "Sedan_Loop_Low" 6417179625 (tracked)
	["Engine.Jet"] = { Id = 6417165160, Volume = 0.4, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [RBX] LUV "Sedan_Loop_High" 6417165160 (placeholder jet whine)
	["Engine.Heli"] = { Id = 9113417759, Volume = 0.45, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [PSE] helicopter "Rises For Takeoff 2" 9113417759 (swap for a seamless rotor loop after preview)
	["Engine.Naval"] = { Id = 6417179625, Volume = 0.4, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0, Bus = "Loop" }, -- [RBX] LUV "Sedan_Loop_Low" 6417179625, pitched down (boat motor)

	-- ── combat (W2 CC-3; WeaponVisuals plays these). Key names = docs/ASSET_SHORTLIST.md §3.5, so the asset
	-- workflow's config commit swaps ids with no code change. Every id is a [PSE] row of that sheet (P0/P1,
	-- 2026-09-24); NOBODY HAS LISTENED YET: preview each in Studio before a publish. Gun shots: 3D at the muzzle
	-- (other players: at the server origin O); the local player's reload / empty / equip: 3D at their character.
	["Weapon.StarterRifle.Fire"] = { Id = 9113188870, Volume = 0.55, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "World", MaxSeconds = 0.9, LengthSeconds = 0.5 }, -- [PSE] "Assault Rifle 2 (SFX)" 9113188870
	["Weapon.AssaultRifle.Fire"] = { Id = 9113188876, Volume = 0.55, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "World", MaxSeconds = 0.9, LengthSeconds = 0.5 }, -- [PSE] "Assault Rifle 4 (SFX)" 9113188876
	["Weapon.SMG.Fire"] = { Id = 9113029219, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1.15, CooldownSeconds = 0.05, Priority = 1, Bus = "World", MaxSeconds = 0.18, LengthSeconds = 0.5 }, -- [PSE] "9 Mm Gun Firing 5 (SFX)" 9113029219
	["Weapon.Pistol.Fire"] = { Id = 9117400889, Volume = 0.55, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "World", MaxSeconds = 1.0, LengthSeconds = 0.5 }, -- [PSE] "Pistol Single Shots 8 (SFX)" 9117400889
	["Weapon.Shotgun.Fire"] = { Id = 9112912936, Volume = 0.6, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "World", MaxSeconds = 1.2, LengthSeconds = 0.5 }, -- [PSE] "12 Gauge Shotgun 101 (SFX)" 9112912936 (preview: may hold 2 blasts)
	["Weapon.Sniper.Fire"] = { Id = 9118173988, Volume = 0.65, RollOff = "InverseTapered", MaxDistance = 400, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "World", LengthSeconds = 0.5 }, -- [PSE] "Rifle Single Shots 3 (SFX)" 9118173988
	["Weapon.RocketLauncher.Fire"] = { Id = 9118592471, Volume = 0.6, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1, CooldownSeconds = 0.05, Priority = 2, Bus = "World", MaxSeconds = 1.5, LengthSeconds = 0.5 }, -- [PSE] "Rocket Flare Out 9 (SFX)" 9118592471
	["Weapon.Grenade.Throw"] = { Id = 9114659833, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 250, Pitch = 1, CooldownSeconds = 0.05, Priority = 1, Bus = "World", LengthSeconds = 0.5 }, -- [PSE] "Grenade Pull Pin 2 (SFX)" 9114659833
	["Weapon.Reload.Rifle"] = { Id = 9113104509, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.3, Priority = 2, Bus = "World", LengthSeconds = 1.3 }, -- [PSE] "Ammo Magazine 3 (SFX)" 9113104509
	["Weapon.Reload.Pistol"] = { Id = 9113104176, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.3, Priority = 2, Bus = "World", LengthSeconds = 1.3 }, -- [PSE] "Ammo Magazine 1 (SFX)" 9113104176
	["Weapon.Reload.Shotgun"] = { Id = 9112913564, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.3, Priority = 2, Bus = "World", LengthSeconds = 0.6 }, -- [PSE] "12 Gauge Shotgun 9 (SFX)" 9112913564 (pump)
	["Weapon.Reload.Launcher"] = { Id = 9118594324, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.3, Priority = 2, Bus = "World", LengthSeconds = 1 }, -- [PSE] "Rockets Handle 6 (SFX)" 9118594324
	["Weapon.Empty"] = { Id = 9117396530, Volume = 0.5, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.25, Priority = 1, Bus = "World", MaxSeconds = 0.25, LengthSeconds = 0.3 }, -- [PSE] "Pistol Handling 1 (SFX)" 9117396530 (dry fire)
	["Weapon.Equip"] = { Id = 9114702107, Volume = 0.45, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.3, Priority = 1, Bus = "World", LengthSeconds = 1 }, -- [PSE] "Gun Grab Hard 1 (SFX)" 9114702107
	["Hit.Confirm"] = { Id = 9119717529, Volume = 0.5, RollOff = "Linear", MaxDistance = 0, Pitch = 1.4, CooldownSeconds = 0.06, Priority = 2, Bus = "UI", LengthSeconds = 0.25 }, -- [PSE] "Switch Click On Or Off Toggle Button 1 (SFX)" 9119717529
	["Hit.Headshot"] = { Id = 9119717529, Volume = 0.6, RollOff = "Linear", MaxDistance = 0, Pitch = 1.8, CooldownSeconds = 0.06, Priority = 3, Bus = "UI", LengthSeconds = 0.25 }, -- [PSE] same file as Hit.Confirm, higher
	["Hit.Kill"] = { Id = 9126073001, Volume = 0.55, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.2, Priority = 4, Bus = "UI", MaxSeconds = 0.9, LengthSeconds = 0.9 }, -- [PSE] "Synth Sparkle Tone High Pitch Bell Tone Ding (SFX)" 9126073001
	["Player.Hurt"] = { Id = 9113524237, Volume = 0.35, RollOff = "Linear", MaxDistance = 0, Pitch = 1, CooldownSeconds = 0.25, Priority = 2, Bus = "UI", LengthSeconds = 0.55 }, -- [PSE] "Body Impact 2 (SFX)" 9113524237, low
	["Impact.Ground"] = { Id = 9118768193, Volume = 0.4, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.08, Priority = 1, Bus = "World", LengthSeconds = 0.7 }, -- [PSE] "Sand Impacts 5 (SFX)" 9118768193
	["Impact.Metal"] = { Id = 9119915230, Volume = 0.45, RollOff = "InverseTapered", MaxDistance = 60, Pitch = 1, CooldownSeconds = 0.08, Priority = 1, Bus = "World", LengthSeconds = 1 }, -- [PSE] "Tank Impact 1 (SFX)" 9119915230
	["Explosion.Small"] = { Id = 9114086583, Volume = 0.7, RollOff = "InverseTapered", MaxDistance = 400, Pitch = 1, CooldownSeconds = 0.1, Priority = 3, Bus = "World", LengthSeconds = 1.9 }, -- [PSE] "Dirt Explosion 4 (SFX)" 9114086583 (grenade, rocket)
	["Explosion.Large"] = { Id = 9114554567, Volume = 0.8, RollOff = "InverseTapered", MaxDistance = 400, Pitch = 1, CooldownSeconds = 0.3, Priority = 4, Bus = "World", LengthSeconds = 4 }, -- [PSE] "Gas Fire Explosion 3 (SFX)" 9114554567 (vehicle wreck)
} :: { [string]: SoundDef }

SoundConfig.Mix = {
	MaxConcurrent = 12, -- one-shot voices playing at once, 2D + 3D (loops are separate: music, ambience, engine)
	MaxConcurrent2D = 4, -- of those, non-positional (UI + Stinger)
	PoolPerKey = 4, -- pooled Sound instances per key; a 5th overlapping play of one key restarts its oldest voice
	StingerWindowSeconds = 0.35, -- one audible Stinger per window (higher Priority replaces a lower one)
	DefaultLengthSeconds = 2, -- voice busy time when neither the file length nor LengthSeconds is known
	MinDistance = 10, -- 3D RollOffMinDistance default
	DefaultMaxDistance = 250, -- 3D plays of a key whose MaxDistance is 0
	SfxMaster = 1,
	MusicMaster = 1,
	LoopFadeSeconds = 0.3, -- default channel fade (engine on / off)
	-- legacy getters (AudioController.GetSfxVolume / GetMusicVolume): MissileController scales its own siren by it
	LegacySfxVolume = 0.55,
	LegacyMusicVolume = 0.35,
}

SoundConfig.Music = {
	Base = "Music.Base", -- plays from AudioController.Init while the music toggle is on
	Combat = "Music.Combat", -- while HudLayout flags Drawn AND Hurt (and not Dead)
	FadeSeconds = 1.5,
	CombatHoldSeconds = 6, -- keep the combat layer this long after Drawn/Hurt clears
}

SoundConfig.Ambience = {
	Default = "Amb.Wind",
	NearWater = "Amb.Surf", -- camera within NearWaterStuds (XZ) of a WE_Water part (Constants.Tags.Water)
	NearWaterStuds = 60,
	LeaveWaterStuds = 90, -- hysteresis: back to wind past this
	CheckSeconds = 1.5, -- water proximity check period (not per frame)
	FadeSeconds = 1,
}

SoundConfig.Engine = {
	SampleHz = 10, -- chassis speed → pitch; the only periodic audio work while seated
	DefaultMaxSpeed = 60, -- studs/s when the vehicle has no WE_MaxSpeed attribute
	PitchEpsilon = 0.01, -- skip PlaybackSpeed writes smaller than this
	-- first match on the vehicle model's WE_KitFamily prefix, then WE_Category, then Default
	Families = {
		{ Prefix = "Tracked", Key = "Engine.Heavy", PitchMin = 0.7, PitchMax = 1.3 },
		{ Prefix = "Heli", Key = "Engine.Heli", PitchMin = 0.9, PitchMax = 1.25 },
		{ Prefix = "Jet", Key = "Engine.Jet", PitchMin = 1.0, PitchMax = 1.8 },
		{ Prefix = "Naval", Key = "Engine.Naval", PitchMin = 0.6, PitchMax = 1.1 },
	} :: { EngineFamily },
	Categories = {
		Air = { Key = "Engine.Heli", PitchMin = 0.9, PitchMax = 1.25 },
		Naval = { Key = "Engine.Naval", PitchMin = 0.6, PitchMax = 1.1 },
	} :: { [string]: EngineProfile },
	Default = { Key = "Engine.Ground", PitchMin = 0.8, PitchMax = 1.6 } :: EngineProfile,
}

SoundConfig.Hooks = {
	-- Notification remote payload.Type (after NotificationConfig.Rewrite) → the key NotificationController's own
	-- PlayNotification plays for that line. Types not listed (Info, Collect) keep the plain UI.Notify / no sound.
	NotificationTypes = {
		Success = "Toast.Success",
		Reward = "Toast.Reward",
		Warn = "Toast.Warn",
		Error = "Toast.Error",
	} :: { [string]: string },
	NotificationTypeWindowSeconds = 0.25, -- a typed key waits this long for NotificationController's ping
	AlertReroute = "Alarm.Base", -- HudConfig.Toast.Reroute rules with AlertSeconds ("BASE UNDER ATTACK!" banner ping)
	CashGain = "Cash.Collect", -- HudLayout.CashFloatRequested amount > 0
	CashSpend = "Cash.Purchase", -- HudLayout.CashFloatRequested amount < 0
	PurchaseOk = "Cash.Purchase", -- PurchaseResult Ok
	PurchaseFail = "UI.Denied", -- PurchaseResult not Ok
	CaptureStart = "Capture.Start", -- TerritoryStateUpdate LocalCapture.Capturing false → true
	CaptureSecured = "Capture.Secured", -- a territory's OwnerUserId becomes mine
	CaptureLost = "Capture.Lost", -- a territory's OwnerUserId stops being mine
	RaidAlarm = "Alarm.Raid", -- AtmRaidStateUpdate Phase "Alarm" (victim; pushed every 1 s → key cooldown)
	RaidAlarmPhase = "Alarm",
	MissileVictim = "Alarm.Missile", -- MissileStrikeFx with VictimUserId == me (one per StrikeId)
	MissileLateSeconds = 2, -- late joiner: skip when the strike is already over
	-- MissileController's own click-siren Sound (created in SoundService by name). It is muted when
	-- Alarm.Missile has a valid Id, so the victim hears the real siren instead of the click. "" = never mute.
	LegacyMissileSirenName = "WE_MissileSiren",
	LevelUp = "Level.Up", -- XPUpdate LevelUp == true
}

-- W2 (CC-3): weapon id → sound keys. WeaponVisuals reads this; a missing entry or an Id-0 key is silent
-- (AudioController.Play never errors). "NPC" = the NPC rifle shots relayed by WeaponFx (W = "NPC").
export type WeaponSounds = { Fire: string?, Reload: string? }
SoundConfig.Weapons = {
	StarterRifle = { Fire = "Weapon.StarterRifle.Fire", Reload = "Weapon.Reload.Rifle" },
	AssaultRifle = { Fire = "Weapon.AssaultRifle.Fire", Reload = "Weapon.Reload.Rifle" },
	SMG = { Fire = "Weapon.SMG.Fire", Reload = "Weapon.Reload.Rifle" },
	Pistol = { Fire = "Weapon.Pistol.Fire", Reload = "Weapon.Reload.Pistol" },
	Shotgun = { Fire = "Weapon.Shotgun.Fire", Reload = "Weapon.Reload.Shotgun" },
	Sniper = { Fire = "Weapon.Sniper.Fire", Reload = "Weapon.Reload.Rifle" },
	RocketLauncher = { Fire = "Weapon.RocketLauncher.Fire", Reload = "Weapon.Reload.Launcher" },
	Grenade = { Fire = "Weapon.Grenade.Throw" },
	NPC = { Fire = "Weapon.StarterRifle.Fire" },
} :: { [string]: WeaponSounds }

-- W2 (CC-3): combat cue → key (WeaponVisuals; VehicleCombatClient plays "Explosion.Large" by name)
SoundConfig.CombatCues = {
	Empty = "Weapon.Empty",
	Equip = "Weapon.Equip",
	HitConfirm = "Hit.Confirm",
	Kill = "Hit.Kill",
	Headshot = "Hit.Headshot",
	Hurt = "Player.Hurt",
	ImpactGround = "Impact.Ground",
	ImpactMetal = "Impact.Metal",
	ExplosionSmall = "Explosion.Small",
	ExplosionLarge = "Explosion.Large",
}

return SoundConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">SpinnerConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Free Supply Spinner — claim Cash/Gold every N hours (Settings / HUD).
	Fixed reward table (server picks index); not a paid loot box.
]]

local SpinnerConfig = {
	Enabled = true,
	CooldownSeconds = 4 * 3600, -- 4 hours
	DisplayName = "Supply Spinner",
	-- Weighted outcomes: Weight relative; server rolls once
	Rewards = {
		{ Id = "cash_small", DisplayName = "Cash Cache", Weight = 40, Cash = 5000, Gold = 0 },
		{ Id = "cash_med", DisplayName = "Cash Haul", Weight = 25, Cash = 12000, Gold = 0 },
		{ Id = "cash_big", DisplayName = "Cash Jackpot", Weight = 10, Cash = 25000, Gold = 0 },
		{ Id = "gold_small", DisplayName = "Gold Dust", Weight = 15, Cash = 2000, Gold = 2 },
		{ Id = "gold_med", DisplayName = "Gold Bar", Weight = 8, Cash = 5000, Gold = 5 },
		{ Id = "mixed", DisplayName = "Mixed Supply", Weight = 2, Cash = 15000, Gold = 8 },
	},
}

return SpinnerConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">StreamingConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	StreamingConfig (streaming2, lane S1): tunables for the code that has to behave under instance streaming.

	THE SWITCH IS NOT HERE. Workspace.StreamingEnabled, the two radii and the integrity mode live in
	default.project.json (Workspace $properties): the engine does not let a script set StreamingEnabled, so the project
	file is the flag. Every reader of this config is a no-op while Workspace.StreamingEnabled is false
	(StreamPrefetch.Enabled()), so it ships before the switch and a rollback of the switch restores the old behaviour.
]]

local StreamingConfig = {
	-- Player:RequestStreamAroundAsync timeout (seconds) before a cross-map move (StreamPrefetch.PivotTo). The move
	-- happens when the request returns or gives up, so a slow phone waits at most this long.
	PrefetchTimeout = 5,
	-- A move shorter than this needs no pre-fetch: the client always holds StreamingMinRadius round its character.
	-- Keep it <= Workspace.StreamingMinRadius in default.project.json (64).
	NearStuds = 64,
	-- One check this long after a pre-fetched move: when the character is back where it started (the spawn or its
	-- physics undid the pivot), it is moved once more. Replaces the stacked 0.35 s / 1.0 s blind re-applies.
	SettleCheckSeconds = 0.6,
	-- The first spawn of a session is random (the save loads after it). The own PlayerSpawn is an extra replication
	-- focus from the plot assignment until the pre-fetched move home lands, and never longer than this (seconds).
	JoinFocusMaxSeconds = 40,
	-- FallSafety: at most one "Rescued from fall" toast per player in this many seconds.
	FallToastCooldown = 8,
}

return StreamingConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">StructureVisualConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Part-kit silhouettes + palettes for base structures.
	STRUCTURE_SCALE_WIRE v21: TargetFootprint drives VisualAssetService ScaleTo.
	Part kits remain fallback; catalog mesh NEVER sized to host plinth.
]]

export type StructurePalette = {
	Plinth: Color3,
	Body: Color3,
	Accent: Color3,
	Roof: Color3,
	Kit: "hq" | "barracks" | "depot" | "lab" | "tower" | "pad" | "dock" | "wall" | "power" | "warehouse" | "special" | "airfield" | "helipad" | "hangar" | "armory" | "radar",
	TargetFootprint: Vector3?,
	MeshAssetId: number?,
	MeshAssetIdL3: number?,
}

local StructureVisualConfig = {
	GhostTransparency = 0.72,
	SolidTransparency = 0,
	PreferMeshWhenAssetIdSet = false, -- v44 P0 hotfix: Part kits only until visibility proven; re-enable design meshes later
	PreferMeshMinLevel = 1,
	BuildingDressGen = 29, -- v42 DressGen: Hangar≠Warehouse≠Depot, Missile≠Tower; kits stay visible

	--[[
		v67 base look: one military scheme. Palettes below are sand concrete / olive / dark metal with a
		muted per-type Accent used only on small details. The kit "Accent" footprint plate is a concrete
		foundation now (it was a Neon plate scaled to 1.4x the footprint: the glowing purple/green floors).
	]]
	FoundationColor = Color3.fromRGB(146, 142, 130),
	BaseLook = {
		PlotFloor = Color3.fromRGB(168, 162, 148), -- plot pad (was near-black navy)
		PlotEdge = Color3.fromRGB(86, 98, 64), -- painted olive edge (was a green Neon strip)
		Chevron = Color3.fromRGB(230, 196, 70), -- yellow floor paint (was white Neon)
		WallCap = Color3.fromRGB(132, 126, 110),
		Wire = Color3.fromRGB(58, 60, 56),
		GateStripe = Color3.fromRGB(214, 178, 64),
	},
	-- v68: no roof at all over bases (owner). If re-enabled, the barrier is invisible at this height.
	AntiAirCeilingEnabled = false,
	AntiAirCeilingHeight = 48,

	Palettes = {
		CommandCenter = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(200, 186, 150),
			Accent = Color3.fromRGB(214, 178, 64),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "hq",
			TargetFootprint = Vector3.new(36, 16, 28),
			MeshAssetId = 0, -- owner rule 5 (2026-09-25): heavy HQ model cleared; owner pick pending (VisualAssetConfig.Buildings)
		},
		Barracks = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(176, 168, 136),
			Accent = Color3.fromRGB(120, 136, 86),
			Roof = Color3.fromRGB(86, 98, 64),
			Kit = "barracks",
			TargetFootprint = Vector3.new(28, 12, 16),
			MeshAssetId = 0, -- owner rule 5 (2026-09-25): heavy barracks model cleared; owner pick pending (VisualAssetConfig.Buildings)
		},
		VehicleDepot = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(150, 150, 140),
			Accent = Color3.fromRGB(98, 118, 130),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "depot",
			TargetFootprint = Vector3.new(32, 14, 24),
			MeshAssetId = 12208876851, -- v42 arched depot ≠ Hangar
		},
		WeaponsFacility = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(164, 150, 128),
			Accent = Color3.fromRGB(150, 82, 58),
			Roof = Color3.fromRGB(70, 72, 68),
			Kit = "armory",
			TargetFootprint = Vector3.new(28, 18, 18),
			MeshAssetId = 4120970784,
		},
		Helipad = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(96, 98, 92),
			Accent = Color3.fromRGB(214, 178, 64),
			Roof = Color3.fromRGB(70, 72, 68),
			Kit = "helipad",
			TargetFootprint = Vector3.new(28, 4, 28),
			MeshAssetId = 14313845338,
		},
		Dock = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(120, 112, 96),
			Accent = Color3.fromRGB(98, 118, 130),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "dock",
			TargetFootprint = Vector3.new(44, 10, 28),
			MeshAssetId = 17701461178,
		},
		Airfield = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(90, 92, 88),
			Accent = Color3.fromRGB(150, 150, 142),
			Roof = Color3.fromRGB(70, 72, 68),
			Kit = "airfield",
			TargetFootprint = Vector3.new(72, 1, 14),
			MeshAssetId = 0, -- COMPOSITE runway + VisualAssetConfig.Buildings.Hangar (0 = Part shed); REJECT 12370174722
		},
		DefensiveWalls = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(178, 170, 148),
			Accent = Color3.fromRGB(132, 126, 110),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "wall",
			TargetFootprint = Vector3.new(24, 8, 3),
			MeshAssetId = 0, -- v41: NO Wall* segment catalog dress (Part-kit walls only)
			MeshAssetIdL3 = 0, -- v41: Part-kit heavy walls
		},
		Watchtowers = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(120, 100, 74),
			Accent = Color3.fromRGB(92, 76, 56),
			Roof = Color3.fromRGB(86, 98, 64),
			Kit = "tower",
			TargetFootprint = Vector3.new(10, 34, 10),
			MeshAssetId = 108525417345747,
		},
		Radar = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(170, 172, 168),
			Accent = Color3.fromRGB(98, 118, 130),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "radar",
			TargetFootprint = Vector3.new(14, 18, 14),
			MeshAssetId = 9559610195,
		},
		ResearchLab = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(186, 184, 176),
			Accent = Color3.fromRGB(98, 130, 120),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "lab",
			TargetFootprint = Vector3.new(22, 12, 16),
			MeshAssetId = 17725725,
		},
		MissileDefense = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(106, 112, 86),
			Accent = Color3.fromRGB(150, 82, 58),
			Roof = Color3.fromRGB(70, 72, 68),
			Kit = "tower",
			TargetFootprint = Vector3.new(14, 10, 18), -- v42 launcher mass, not tower height
			MeshAssetId = 0, -- W1 CFG: real-world launcher mesh dropped (was 11962508154); Part kit "tower" (Missile Battery ≠ Watchtower)
		},
		PowerStation = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(150, 150, 140),
			Accent = Color3.fromRGB(214, 178, 64),
			Roof = Color3.fromRGB(84, 86, 80),
			Kit = "power",
			TargetFootprint = Vector3.new(28, 16, 20),
			MeshAssetId = 14000967030,
		},
		Warehouse = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(170, 150, 118),
			Accent = Color3.fromRGB(150, 120, 80),
			Roof = Color3.fromRGB(96, 90, 80),
			Kit = "warehouse",
			TargetFootprint = Vector3.new(38, 16, 24),
			MeshAssetId = 15942568272, -- v42 hangar shed ≠ Hangar
		},
		SpecialForcesFacility = {
			Plinth = Color3.fromRGB(72, 82, 58),
			Body = Color3.fromRGB(92, 96, 90),
			Accent = Color3.fromRGB(104, 112, 96),
			Roof = Color3.fromRGB(60, 62, 58),
			Kit = "special",
			TargetFootprint = Vector3.new(32, 16, 20),
			MeshAssetId = 0, -- owner rule 5 (2026-09-25): heavy barracks model cleared; owner pick pending (VisualAssetConfig.Buildings)
		},
	} :: { [string]: StructurePalette },

	--[[
		v66: walk-in buildings (Modules/HollowBuildingBuilder). The kit Body becomes the foundation slab;
		walls/doorway/windows/interior are a Model rebuilt per level. The building sits BEHIND its pad and the
		doorway is shifted sideways so going inside never re-triggers the walk-over buy (pad hit box = ±8 studs).
		Local axes: +Z = building front (faces the plot spawn), X = across the facade.
	]]
	-- v68: lights made by walk-in shells, interiors and installations (HollowBuildingBuilder). Interiors were
	-- blinding: 6-8 Neon ceiling strips per room, each with a 20-stud full-brightness PointLight, under bloom.
	BuildingLights = {
		BrightnessScale = 0.35, -- multiplies every PointLight these builders create
		MaxRange = 16,
		FixtureMaterial = Enum.Material.SmoothPlastic, -- ceiling / entry / hangar fittings (was Neon)
		FixtureColor = Color3.fromRGB(232, 226, 208),
		SpotMaxRange = 30, -- floodlights / searchlights (outdoors)
	},

	-- v69: world lighting. Ambient lights every surface the sky can't reach — at (165,145,110) every interior wall
	-- glowed ~60 % white (the "blinding" rooms). OutdoorAmbient (outdoor shade) is unchanged.
	WorldLighting = {
		DayAmbient = Color3.fromRGB(78, 72, 62),
		EnvironmentDiffuseScale = 0.35,
	},

	-- v68: outdoor installations — a detailed model from Modules/Installations/<Module>.luau on a concrete
	-- foundation (the kit Body), rebuilt per level by HollowBuildingBuilder. Only with BaseLayoutConfig.
	-- Width/Depth = foundation footprint (building-local, +Z = the side facing the plot front).
	Installations = {
		PowerStation = { Enabled = true, Module = "PowerStation", Width = 30, Depth = 22 },
		Radar = { Enabled = true, Module = "Radar", Width = 24, Depth = 20 },
		MissileDefense = { Enabled = true, Module = "MissileDefense", Width = 24, Depth = 22 },
		Watchtowers = { Enabled = true, Module = "Watchtower", Width = 10, Depth = 10, CabinClearHeight = 8.5, HalfWallHeight = 3.4 }, -- v73: cabin fits a 7.5-stud avatar + 1 stud
		DefensiveWalls = { Enabled = true, Module = "Checkpoint", Width = 6, Depth = 6 }, -- v73: the foundation is the gate flag plinth (was a 20 x 10 grey tray)
		Airfield = { Enabled = true, Module = "Airfield", Width = 58, Depth = 34 },
		-- v73 (owner: "the default helicopter on the pad is horrific"): the helipad is an installation (flush ring + H,
		-- ops hut, floodlight). No parked mock-up: the player's own helicopter lands on VehicleConfig HelipadSpots once
		-- it is unlocked. With this row StructureKitBuilder's old "helipad" kit (incl. the 9-part ParkedHeli) is skipped.
		Helipad = { Enabled = true, Module = "Helipad", Width = 28, Depth = 28, Colors = { Floor = Color3.fromRGB(72, 74, 72) } },
	},

	-- v72 budget (phone): static soldier kits (gate guards, yard workers) without the 7 small detail parts
	-- (MapSetup.makeSoldierKit): 16 -> 9 parts each, -84 parts per base. true = the old detailed kit.
	StaticSoldierDetail = false,
	-- v72: walk-in building stairs stay step boxes. "Ramp" (one wedge per flight, -75 parts per base at L5) is a
	-- reserve cut only; nothing reads this key until that cut is needed.
	StairStyle = "Steps",

	HollowBuildings = {
		-- Shared by every walk-in building; per-building entries override (Colors merge key by key).
		Defaults = {
			WallThickness = 0.8,
			StoryHeight = 12,
			UpperStoryHeight = 10,
			DoorWidth = 6,
			DoorHeight = 8,
			WindowWidth = 4.5,
			WindowHeight = 3.2,
			WindowBottom = 4,
			FrontGap = 10, -- legacy (no BaseLayoutConfig): pad centre → front wall
			OffsetX = 6, -- legacy: footprint centre east of the pad
			AnnexLevel = 99, -- comms annex + mast + floodlights (Command Center)
			TwoStoryLevel = 99, -- second storey + interior stairs
			RoofAccessLevel = 99, -- truss ladder through a roof hatch + dish
			HelipadLevel = 99, -- rooftop helipad marking
			GoldCapLevel = 5, -- gold parapet cap + flag finial
			FlagLevel = 1,
			Colors = {
				Wall = Color3.fromRGB(214, 200, 168),
				Trim = Color3.fromRGB(78, 92, 62),
				Metal = Color3.fromRGB(70, 74, 72),
				Dark = Color3.fromRGB(28, 32, 30),
				Floor = Color3.fromRGB(150, 150, 142),
				Stair = Color3.fromRGB(128, 126, 118),
				Roof = Color3.fromRGB(112, 108, 96),
				Glass = Color3.fromRGB(140, 190, 215),
				Accent = Color3.fromRGB(230, 196, 70), -- signs, hazard paint
				Gold = Color3.fromRGB(240, 196, 64),
				Screen = Color3.fromRGB(90, 255, 140),
				Light = Color3.fromRGB(255, 236, 200),
				Locker = Color3.fromRGB(86, 100, 70),
				Rug = Color3.fromRGB(58, 74, 50),
				Sandbag = Color3.fromRGB(186, 164, 118),
				Flag = Color3.fromRGB(70, 110, 60),
			},
		},
		--[[ v73 distinct shells (owner: "all the buildings look too similar"). Footprints, doors, consoles and
			interiors are unchanged; each building gets its own roof form, wall material, colours, windows, entrance
			and one or two signature pieces, so it can be named on a phone without reading the sign:
			  RoofStyle     "Flat" (parapet) | "Gable" (two wedges) | "Vault" (plank barrel) | "Sawtooth" | "Lid" (bunker slab)
			  Entrance      "Awning" | "Portico" | "LeanTo" | "CamoNet" | "BlastDoor" | "Slab" | "Canopy" | "HangarDoors"
			  Signatures    ControlCab, Berms, Bastions, Slits, VentStacks, LatticeMast, SolarDish, FacadeBand,
			                LoadingDock, Chimney, StoveChimney
			  window lists  a number (centre, WindowWidth) or { X = centre, W = width } (ribbon windows)
			Colors.Frame = exterior trim (mullions, ledges, caps, bands, awning); Colors.Trim stays the interior
			furniture colour. Colors.RoofSkin = pitched / vaulted roof. ]]
		CommandCenter = {
			Enabled = true,
			Interior = "CommandCenter",
			Width = 26,
			Depth = 20,
			DoorX = 7,
			UpperStoryHeight = 11, -- one stud taller than the Lab: the HQ block is the tallest
			WallMaterial = Enum.Material.Plaster,
			FrontWindowsX = { { X = -4.25, W = 12.5 } }, -- ribbon window (x -10.5..2, clear of the front-corner locker)
			BackWindowsX = { -6, 4 }, -- ground floor only while single-storey (stairs take the back wall)
			WestWindowsZ = { -7 },
			UpperWindowsX = { { X = -5.5, W = 12 }, { X = 8, W = 7 } }, -- ribbon split at the council terminal (x 1.3..3.7)
			AnnexLevel = 2,
			AnnexWidth = 12,
			AnnexDepth = 14,
			AnnexHeight = 9,
			TwoStoryLevel = 3,
			RoofAccessLevel = 4,
			HelipadLevel = 5,
			Entrance = "Portico",
			EntranceSandbags = false,
			Signatures = { "ControlCab" },
			SignText = "COMMAND CENTER",
			SignX = -6,
			SignWidth = 12,
			Colors = {
				Wall = Color3.fromRGB(216, 200, 160), -- warm sandstone render (dE 25 from the white Lab)
				Frame = Color3.fromRGB(46, 58, 76), -- navy slate
				Glass = Color3.fromRGB(70, 96, 120), -- dark ribbon glass
			},
		},
		Barracks = {
			Enabled = true,
			Interior = "Barracks",
			Width = 32,
			Depth = 24,
			DoorX = 10,
			StoryHeight = 10, -- low timber hut (interior tallest item 9.3)
			UpperStoryHeight = 9,
			WallMaterial = Enum.Material.WoodPlanks,
			WindowWidth = 3.2,
			WindowHeight = 4.2,
			WindowBottom = 3.2,
			UpperWindowHeight = 3.8,
			UpperWindowBottom = 3.2, -- clear of the upper office partition (top 3.0 above the floor)
			FrontWindowsX = { -11, -4, 3 },
			BackWindowsX = { -10, 0, 10 },
			WestWindowsZ = { -6, 6 },
			EastWindowsZ = { -6, 6 },
			UpperWindowsX = { -11, -4, 3, 10 },
			TwoStoryLevel = 3,
			RoofStyle = "Gable",
			RoofRise = 6,
			RoofMaterial = Enum.Material.RoofShingles,
			RoofPlant = false,
			Entrance = "LeanTo",
			Signatures = { "StoveChimney" },
			SignText = "BARRACKS",
			Colors = {
				Wall = Color3.fromRGB(104, 116, 78), -- olive painted timber
				Frame = Color3.fromRGB(226, 220, 200), -- cream window trim
				RoofSkin = Color3.fromRGB(106, 58, 44), -- red-brown shingles
				Chimney = Color3.fromRGB(92, 60, 50),
			},
		},
		WeaponsFacility = {
			Enabled = true,
			Interior = "Armory",
			Width = 30,
			Depth = 22,
			DoorX = 9,
			StoryHeight = 10, -- low bunker (interior tallest item 8.2)
			UpperStoryHeight = 9,
			FrontWindowsX = {}, -- blind walls: a magazine has no windows
			BackWindowsX = {},
			WestWindowsZ = {},
			EastWindowsZ = {},
			UpperWindowsX = {},
			UpperSideWindows = false,
			TwoStoryLevel = 4,
			RoofStyle = "Lid",
			LidThickness = 1.6,
			LidOverhang = 1.2,
			RoofPlant = false,
			Entrance = "BlastDoor",
			EntranceSandbags = false,
			DoorFrameWidth = 0.9,
			DoorFrameDepth = 0.9,
			Signatures = { "Berms", "Bastions", "Slits", "VentStacks" },
			SignText = "ARMORY",
			SignX = -7, -- clear of the rolled-aside blast door leaf
			SignWidth = 12,
			Colors = {
				Wall = Color3.fromRGB(120, 114, 104), -- dark poured concrete
				Frame = Color3.fromRGB(64, 62, 58),
				Roof = Color3.fromRGB(98, 96, 90),
				DoorFrame = Color3.fromRGB(214, 178, 64), -- hazard-yellow portal
				Door = Color3.fromRGB(58, 62, 60),
				Berm = Color3.fromRGB(134, 114, 80),
			},
		},
		SpecialForcesFacility = {
			Enabled = true,
			Interior = "SpecialForces",
			Width = 30,
			Depth = 22,
			DoorX = 9,
			WallMaterial = Enum.Material.Slate,
			WindowWidth = 1.2, -- slit windows
			WindowHeight = 4.6,
			WindowBottom = 3.4,
			UpperWindowWidth = 1.2,
			UpperWindowHeight = 4.2,
			UpperWindowBottom = 2.8,
			WindowMullion = false,
			WindowLedge = false,
			FrontWindowsX = { -12, -9, -3 }, -- clear of the unit flag (x -7.4..-5.6) and the briefing terminal
			TwoStoryLevel = 3,
