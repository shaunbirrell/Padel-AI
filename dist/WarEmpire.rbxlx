]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ManualDropperConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Early-game manual cash droppers near Money Collector + Training Yard (prompt on touch, ClickDetector on PC).
	Server-authoritative; client only fires ClickDetector / ProximityPrompt.
	v71 (HUD v70 spec §5): the price tag reads "$15" (no mouse wording — wrong on phones), owner-only, stud-scaled; the
	"+$15" pop is owner-only too; the plate keeps its glow but no PointLight.

	droppers v1b (spec_droppers.md §3.8, owner decision OD-4 = A): one tap (the prompt or the plate's ClickDetector,
	still instant: PromptHoldDuration 0) pays a bundle of BundleAwards awards, AwardAmount x BundleAwards = $75, into
	the ATM. The bundle needs BundleAwards in BOTH budget buckets (no partial bundle); the award size, cooldown, rate
	limit and the minute / hour budgets are unchanged, so the plate's cap on money is unchanged ($450 a burst minute,
	$18,000 in the first hour from full buckets, $9,000 an hour after). BundleAwards = 1 is today's $15 tap (option E):
	one line to revert. BundleAwards must stay within 1..MaxAwardsPerMinute (BuyPathStatic rule; the service clamps).
	The server no longer builds the "+$" pop or the money-bag model: it sends the grabber one owner-only unreliable
	DropperFx packet and the client draws the bundle and the world "+$75" pop with its chirp on EVERY paid grab (the
	Bundle / Pop / Fx keys below are read by the client, Client/Modules/ProductionFx). When the ATM collects the grab at
	once, its own pill float shows it too, as today (revision 3: at least one "+$", at most two). The plate inset is
	plain green (PlateNeon = false). While the budget holds no bundle the server keeps the Player attribute
	RechargeAttribute (the server time when the next bundle is ready), so "Recharging" survives a lost packet and a
	same-server rejoin; it is a look only, never money.
]]

local ManualDropperConfig = {
	Enabled = false, -- v111 (Shaun 2026-09-29): cash pile removed, $75 added nothing; true restores it

	-- Award (PendingCash). Prefer AwardAmount; else random [MinAward, MaxAward].
	MinAward = 10,
	MaxAward = 25,
	AwardAmount = 15,

	-- droppers v1b (OD-4 = A): awards paid per grab. 5 x $15 = a $75 bundle; 1 = today's $15 tap (option E).
	-- Must satisfy 1 <= BundleAwards <= MaxAwardsPerMinute (BuyPathStatic rule; ManualDropperService clamps too).
	BundleAwards = 5,

	CooldownSeconds = 0.35,
	RateLimitRate = 4,
	RateLimitBurst = 3,

	-- v69 income budget per player (both droppers share it) so an auto-clicker can't farm all night.
	-- Refilling buckets: a full minute bucket gives a quick burst, then it refills at N/60 per second;
	-- the hour bucket caps long sessions at ~MaxAwardsPerHour (600 x $15 = $9k/h, below base passive).
	-- droppers v1b: counted in awards; a bundle takes BundleAwards from both buckets.
	MaxAwardsPerMinute = 30,
	MaxAwardsPerHour = 600,
	-- droppers v1b: short line; NotificationConfig's Throttle rule matches "^Cash drop is recharging"
	BudgetEmptyToast = "Cash drop is recharging",
	BudgetEmptyToastCooldown = 20,

	CollectorOffset = Vector3.new(-5.5, 0, 4),
	YardOffset = Vector3.new(6, 0, -4),

	PromptActionText = "Grab Cash",
	PromptObjectText = "Cash Drop",
	PromptMaxDistance = 12,
	PromptHoldDuration = 0,
	-- atmprompt (ASSUMPTIONS ATM-6): the plate's own prompt keys. They differ from the ATM "Collect" prompt 7.5 studs away
	-- (EconomyConfig.AtmCollectPrompt: E / ButtonX), so under OnePerButton each is the only prompt on its key there: both
	-- pills show and each key triggers only its own (BuyPathStatic pins them apart). F matches the terminals' second prompt
	-- key; gamepad B, not Y, because Y is Reload (HudConfig.Keys.Gamepad) and would be swallowed beside any plate.
	PromptKeyboardKey = Enum.KeyCode.F,
	PromptGamepadKey = Enum.KeyCode.ButtonB,
	PromptExclusivity = Enum.ProximityPromptExclusivity.OnePerButton,

	PartSize = Vector3.new(2.4, 1.2, 2.4),
	PartColor = Color3.fromRGB(40, 140, 70),
	NeonAccentColor = Color3.fromRGB(90, 255, 120), -- the inset colour (plain SmoothPlastic since v1b: PlateNeon)
	-- droppers v1b (OD-6): the plate inset "DropNeon" (name kept) is SmoothPlastic, not Neon (world Neon 306 -> 294)
	PlateNeon = false,
	BillboardLabel = "$", -- v71: device-neutral (the old tag told phone players to use a mouse); the owner sees "$75"
	LabelMaxDistance = 30, -- studs (WorldLabel caps at 40)
	LabelStuds = Vector2.new(3, 1.2), -- the tag's box, studs

	PopupDuration = 0.55,
	PopupRiseStuds = 3.2,

	-- droppers v1b: the client plate effect (spec §3.7 / §3.8). The server only sends the owner-only DropperFx packet
	-- (drop point, amount, left, eta); ProductionFx validates it and draws the bundle and the "+$" pop on every grab.
	FxEvent = true, -- false: no DropperFx packet (the grab still pays; the client then shows nothing over the plate)
	RechargeTag = "Recharging", -- the plate tag while the budget holds no bundle (client write; the pill hides)
	-- revision 3: Player attribute the server keeps while the budget holds no bundle = Workspace:GetServerTimeNow() when
	-- the next one is ready (nil once it holds one). Stamped on the paid grab that empties it, on a refused tap and on a
	-- same-server rejoin, so "Recharging" survives a lost DropperFx packet and a rejoin. A look only: never money.
	RechargeAttribute = "WE_DropRechargeAt",
	BundleSize = Vector3.new(1.4, 0.6, 0.9), -- the pooled green cash bundle, studs
	BundleColor = Color3.fromRGB(86, 150, 80),
	BundleDropStuds = 3.5, -- the bundle falls this far onto the drop point
	BundleSeconds = 0.35, -- in this long (one reused Tween), then hides
	DropPointClearance = 0.3, -- studs above a dressed plate's model (bounding-box top) where the bundle lands
	PopTextPx = 20, -- the world "+$N" pop (real px; world labels are 14-20)
	PopColor = Color3.fromRGB(80, 255, 120), -- the HEAD "+$15" pop colour
	PopGlowColor = Color3.fromRGB(8, 36, 14), -- its UIStroke "CashPopGlow" (HEAD look)
	PopGlowThickness = 1.4,
	-- refix 1: a pop whose rise would pass the pop's MaxDistance (LabelMaxDistance) from the camera, i.e. a zoomed-out
	-- phone camera, is drawn this many studs from the camera on the line of sight to the plate (it still covers the plate
	-- on screen and is always drawn; the chirp plays there). The client caps it at LabelMaxDistance - PopupRiseStuds - 1.
	PopNearCameraStuds = 24,
	FxMaxPayloadAmount = 10000, -- the client ignores a DropperFx amount outside 1..this
	FxMaxPayloadStuds = 60, -- or a drop point farther than this from the character
}

return ManualDropperConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MapConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 30 (2026-09-30): the full-screen WORLD MAP (Client/Controllers/MapController, Server MapService,
	Shared/Util/MapAreas).
	  * Opened from the MAP rail tile (and M on PC; Missions moved to N).
	  * Shows the Central Plaza / town, every base ("<Name>'s Empire", BaseSignService.TitleFor), the outposts, the
	    bank, airdrops and supply crates, mission / job spots, and the player's own position and facing.
	  * Areas are the real zones: WorldConfig.POIs, joined to the TerritoryConfig outpost inside each one and to the
	    OutpostDefenderConfig garrison of the same Id. Tapping one shows what is there, with GO (pins it).
	  * Tapping anywhere else drops a PIN on the ONE objective marker (ObjectiveMarker.ShowWith { Pin = true }): the
	    same GO line and compass as missions and airdrops. Tapping the pin again, the CLEAR PIN button, or arriving
	    (PinArriveStuds) removes it.
	  * Performance: the area layer is built once and cached; markers refresh RefreshSeconds (2x a second) and only
	    while the map is open; nothing runs while it is closed.
	Kill switch: Enabled = false (no tile, no key, no server feed). OwnerFirst as RetentionConfig.Live.
]]

local MapConfig = {
	Enabled = true,
	OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
	-- the world square the map shows (studs; north = -Z is up). Dry land is x +-1760, z -1760..1490 (WorldConfig).
	Extent = { X0 = -2000, X1 = 2000, Z0 = -2000, Z1 = 2000 },
	RefreshSeconds = 0.5, -- markers (and the server feed) at most 2x a second, only while open
	PinArriveStuds = 15,
	PinTimeoutSeconds = 1800,
	PinLabel = "PIN",
	PinTapPx = 26, -- real px: a tap this close to the pin removes it
	--[[ Code Bot MAP-REDESIGN (v129): the phone-first look (MapController + Shared/Util/MapLabelLayout).
		Icons are a few fixed sizes (v); labels are title-case pills placed by the collision pass (8 slots round the icon,
		clamped inside the map, lower priority skipped when they still collide; tap a place to see its hidden label, zoom
		in for more). ]]
	Icon = { Area = 22, Site = 20, Base = 16, BaseMine = 22, Bank = 20, Drop = 14, Airdrop = 20, Job = 10, Me = 26, Pin = 28, Badge = 10 },
	LabelTextV = 14, -- PanelShell.Text floors it to 20 v on touch (= 14 real px, HudConfig.Scale.MinTextPx)
	LabelPadX = 7,
	LabelPadY = 3,
	LabelGap = 3, -- icon edge to pill
	LabelPad = 3, -- pill to pill
	LabelIconPad = 2, -- pill to any icon
	LabelEdge = 4, -- pill to the map edge
	LabelMaxSlide = 40, -- a clamp may slide a pill this far along the edge, no further (it stays next to its icon)
	MyBaseLabel = "Your Base",
	IconTapPx = 24, -- real px: a tap this close to an icon picks it (a 48 px touch circle)
	CompassV = 56,
	-- 0 = your base, 1 = towns / sites / forts, 2 = outposts / camps / rigs, 3 = depots + rig shore bases (zoom 1 shows <= 2)
	LabelPriority = {
		town = 1, fort = 1, port = 1, airstrip = 1, oil = 1, radar = 1, signal = 1, armory = 1, site = 1,
		ruins = 2, camp = 2, crash = 2, oasis = 2, rig = 2, outpost = 2,
		depot = 3, site_depot = 3, rigshore = 3,
	} :: { [string]: number },
	-- inside one priority: who gets the first pick of the space (town, the forts, the port ...)
	LabelRank = { town = 1, fort = 2, port = 3, airstrip = 4, armory = 5, oil = 6, signal = 7, radar = 8, site = 9 } :: { [string]: number },
	ZoomLevels = { 1, 2 },
	ZoomMaxPriority = { 2, 3 }, -- per zoom level: the lowest-priority label kind shown
	-- short map names (the card shows the full name)
	LabelShort = {
		Town = "Crossroads", Armory = "Armory", Depot = "West Depot", Signal = "North Ridge", Port = "South Port", OilField = "Oil Field",
		Radar = "Radar Hill", FortI = "Fort Ironclad", FortS = "Fort Sandhold", RigA = "Alpha Shore", RigB = "Bravo Shore",
		Airstrip = "Airstrip", Ruins = "Ruined Village", Quarry = "Quarry Camp", CoastalOilAlpha = "Rig Alpha",
		CoastalOilBravo = "Rig Bravo", Kestrel = "Kestrel Depot", PumpSeven = "Pump Station 7", DryWell = "Dry Well",
		Overwatch = "Overwatch Ridge", CampViper = "Camp Viper", Hawk = "Hawk Checkpoint", Anvil = "Anvil Scrapyard",
	} :: { [string]: string },
	-- icon family per POI kind (colour + inner shape: MapController.Groups)
	KindGroup = {
		town = "Town", fort = "Military", armory = "Military", radar = "Military", signal = "Military", airstrip = "Military",
		outpost = "Military", port = "Industry", oil = "Industry", depot = "Industry", rigshore = "Industry", rig = "Industry",
		ruins = "Wilds", camp = "Wilds", crash = "Wilds", oasis = "Wilds",
	} :: { [string]: string },
	-- what each POI kind is, in 2-4 words (the card's first line)
	KindInfo = {
		town = "City and Central Plaza",
		depot = "Supply depot",
		armory = "Armory compound",
		signal = "Radio outpost",
		port = "Harbour and docks",
		oil = "Oil wells",
		radar = "Radar station",
		fort = "Fortress approach",
		rigshore = "Oil rig shore base",
		airstrip = "Desert airfield",
		ruins = "Ruined village",
		camp = "Bandit camp",
		crash = "Crash site",
		oasis = "Desert oasis",
		rig = "Offshore oil rig",
	} :: { [string]: string },
	EnemyText = { Easy = "Enemies: light guard", Medium = "Enemies: armed guard", Hard = "Enemies: heavy guard" } :: { [string]: string },
	Colors = {
		Background = Color3.fromRGB(14, 17, 14),
		Sea = Color3.fromRGB(18, 34, 44),
		Land = Color3.fromRGB(58, 52, 38),
		Area = Color3.fromRGB(120, 110, 80),
		Outpost = Color3.fromRGB(200, 170, 70),
		OutpostMine = Color3.fromRGB(80, 200, 110),
		OutpostEnemy = Color3.fromRGB(210, 80, 60),
		Base = Color3.fromRGB(150, 150, 150),
		BaseMine = Color3.fromRGB(80, 200, 110),
		Drop = Color3.fromRGB(80, 170, 255),
		Job = Color3.fromRGB(255, 150, 32),
		Bank = Color3.fromRGB(255, 214, 72),
		Pin = Color3.fromRGB(255, 205, 60),
		Me = Color3.fromRGB(255, 255, 255),
		Text = Color3.fromRGB(230, 225, 205),
		Muted = Color3.fromRGB(160, 155, 135),
		Accent = Color3.fromRGB(235, 195, 90),
		Site = Color3.fromRGB(196, 66, 58), -- claude-bud JOB 31: the named sites (WorldSitesConfig); MAP-REDESIGN: brick red
		-- Code Bot MAP-REDESIGN: the terrain and icon families
		SandLight = Color3.fromRGB(222, 196, 140),
		SandDark = Color3.fromRGB(170, 138, 88),
		SeaLight = Color3.fromRGB(34, 74, 92),
		SeaDark = Color3.fromRGB(12, 30, 42),
		Road = Color3.fromRGB(92, 72, 50),
		Grid = Color3.fromRGB(70, 54, 34),
		Zone = Color3.fromRGB(140, 110, 70),
		Town = Color3.fromRGB(248, 214, 96),
		Military = Color3.fromRGB(86, 132, 186),
		Industry = Color3.fromRGB(230, 126, 40),
		Wilds = Color3.fromRGB(120, 150, 70),
		Pill = Color3.fromRGB(12, 14, 12),
		Card = Color3.fromRGB(20, 24, 20),
	},
	-- claude-bud JOB 31: what each site kind is (the card's first line)
	SiteKindInfo = {
		camp = "Enemy camp",
		village = "Ruined village",
		oil = "Pump station",
		depot = "Supply depot",
		checkpoint = "Road checkpoint",
		overwatch = "Sniper ridge",
		tankyard = "Tank scrapyard",
	} :: { [string]: string },
	--[[ Code Bot v127/v128: fast travel is REMOVED at the owner's request (Shaun wants tap-to-pin only, so players see where
		to go and get there themselves). There is no remote, no server handler and no TRAVEL button; the flag stays false
		and codebot_v127/v128.py fails the build if any of that comes back. Do not re-add fast travel. ]]
	FastTravelEnabled = false,
}

return MapConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">MissionConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily objective missions (progress tracked server-side) + legacy timed missions.

	W3 step 2, lane M0 (spec w3s2 §6 Phase A):
	- The daily offer ROTATES (MissionService): 3 Daily Ops (DailyOpsConfig) + 3 daily missions = MaxActiveDaily 6.
	  Levels 1..Rotation.NewPlayerMaxLevel get the Rotation.Fixed missions plus NewPlayerPicks rotating ones; higher
	  levels get Rotation.Picks rotating out of every unlocked mission. Picks are seeded by (UserId, UTC day), so they
	  are stable for the day, need no save, and every unlocked mission comes round within a few days.
	- ObjectiveType "Heist" (a bank job done; BankRaidService tracks it today, OpsService in Phase B).
	- Go: a mission row with a Go key shows GO while it is incomplete. GO points the one objective marker
	  (Client/Modules/ObjectiveMarker) at the nearest target the SERVER sent for that key; never a fixed marker.

	W3 step 2 Phase B, lane M1 (jobs):
	- OpsObjectives (Checkpoint, Camp, Uplink, Delivery, Job) are reported by OpsService (TrackProgress, 1 per finished
	  job for each type in OpsConfig.Kinds[kind].Track). They are live ONLY while OpsService's hook says so
	  (MissionService.SetOpsHooks: ObjectiveLive), so with no hook (OpsConfig.Enabled = false) the offer is exactly
	  Phase A's. Heist stays in LiveObjectives: BankRaidService reports it until the cutover, OpsService after.
	- Go keys Checkpoint / Camp / Uplink / Job / Cargo / Hostiles are answered by the same hook (GoTargets: every Open
	  site of that key; the server sends the GoMaxTargets nearest to the player, the client picks the nearest).
	  With no hook they have no target: a Required one keeps its mission off the offer, Hostiles just hides GO.
	- Capture has no Go key yet (TerritoryService is batch B's; a neutral-zone pointer must skip every Home Outpost).
]]

export type DailyMissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	-- KillNPC | KillPlayer | CaptureTerritory | PurchaseUpgrade | EarnCash | SpawnVehicle | RecruitSoldiers | Heist
	-- | Checkpoint | Camp | Uplink | Delivery | Job (the last five: MissionConfig.OpsObjectives, live through OpsService)
	ObjectiveType: string,
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number?,
	MinLevel: number,
	Go: string?, -- a MissionConfig.Go key (GO button while incomplete)
}

export type GoDef = {
	Short: string, -- objective marker / compass label: 2-7 capitals, device-neutral ("BANK")
	Client: boolean?, -- claude-bud JOB 49 C: GO acts on the client (a panel / the console line), no world target
	-- server only: the WE_ActivityAnchor id to point at once it exists (lane BK stamps the bank's)
	Anchor: string?,
	-- a mission that uses this Go is offered only while the key is served (the job is on): the old resolver has a
	-- target, or OpsService's hook answers the key (a table, even an empty one while every site is busy: the offer
	-- never reshuffles when a site cools or the director rotates; GO shows once a site is Open again)
	Required: boolean?,
}

-- One GO target as sent to the client (world studs). MissionService adds Go / GoTargets to a mission entry.
export type GoTarget = { X: number, Y: number, Z: number }

export type MissionDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MinLevel: number,
	DurationSeconds: number,
	RewardCash: number,
	RewardXP: number,
	Difficulty: string,
}

local MissionConfig = {
	-- How many entries the daily list offers in total: the Daily Ops first, then the daily missions
	MaxActiveDaily = 6, -- includes Daily Ops when merged
	RefreshOnUtcDayChange = true,

	-- Which daily missions are offered each UTC day (MissionService; seeded by UserId + day, nothing saved)
	Rotation = {
		NewPlayerMaxLevel = 4, -- levels 1..4: Fixed + NewPlayerPicks rotating missions
		Fixed = { "DailyUpgrade", "DailyRecruit" }, -- first-5-minute missions for new players
		NewPlayerPicks = 1,
		Picks = 3, -- from NewPlayerMaxLevel + 1: this many rotate out of every unlocked daily mission
	},

	-- Objective types some server system reports through MissionService.TrackProgress today. A mission or daily op
	-- whose type is not listed here (or live through OpsObjectives) is never offered (it could not be finished).
	LiveObjectives = {
		KillNPC = true,
		KillPlayer = true,
		CaptureTerritory = true,
		PurchaseUpgrade = true,
		EarnCash = true,
		SpawnVehicle = true,
		RecruitSoldiers = true,
		Heist = true, -- BankRaidService: a bank job done (lane F)
		Raid = true, -- claude-bud JOB 49 C: a raid win (ArmyPlan SEND loot / MoneyCollectorService ATM raid); only the Core missions use it
	} :: { [string]: boolean },

	-- Objective types only OpsService reports (W3 step 2 Phase B). Live ONLY while its hook's ObjectiveLive(type) is
	-- true (a live job site reports it); never through LiveObjectives, so they stay off until the Ops cutover.
	OpsObjectives = {
		Checkpoint = true, -- a road checkpoint taken
		Camp = true, -- a raid camp cleared (its chest opened)
		Uplink = true, -- an uplink hacked and held
		Delivery = true, -- a cargo haul brought home (the heist yards and the black box; the bank counts as Heist)
		Job = true, -- any job finished
	} :: { [string]: boolean },

	-- GO targets. Where a Go key points is decided on the SERVER per player (MissionService) and sent with the
	-- mission; the client picks the one nearest to the player. OpsService's hook answers first (Phase B); a key it
	-- does not know falls back to the Anchor / BankRaidConfig resolver.
	Go = {
		Bank = {
			Short = "BANK",
			Anchor = "Town.Bank.Vault", -- until it exists: BankRaidConfig.Position
			Required = true, -- only while BankRaidConfig.Enabled (or, after the cutover, while the bank is an Ops site)
		},
		-- Phase B (lane M1): answered only by OpsService's hook (every Open site of these kinds)
		Checkpoint = { Short = "POST", Required = true },
		Camp = { Short = "CAMP", Required = true },
		Uplink = { Short = "UPLINK", Required = true },
		Job = { Short = "JOB", Required = true }, -- any Open job
		Cargo = { Short = "CARGO", Required = true }, -- the heist yards and the black box (Delivery)
		Hostiles = { Short = "HOSTILE" }, -- the nearest Open checkpoint or camp (KillNPC); no hook = no GO button
		-- claude-bud JOB 49 C: client-side GO (no world target): the TARGETS card / the Army panel / his next console
		Targets = { Short = "TARGETS", Client = true },
		Army = { Short = "ARMY", Client = true },
		Build = { Short = "BUILD", Client = true },
	} :: { [string]: GoDef },
	GoMaxTargets = 16, -- GO targets sent per entry: the nearest to the player (MissionController reads at most 16)
	GoRefreshSeconds = 30, -- while OpsService's hook is set: re-send a player's list when its targets change (0 = off)

	-- Missions panel row button (GO / CLAIM), in v (the panel's UI scale): 112 x 72 v is about 73 x 47 real px on a
	-- phone (spec w3s2 activities §9); the desktop button is DesktopButtonW wide and the desktop tap height tall.
	Ui = {
		ButtonW = 112,
		ButtonH = 72,
		DesktopButtonW = 96,
	},

	DailyMissions = {
		DailyKillNPC = {
			Id = "DailyKillNPC",
			DisplayName = "Clear Hostiles",
			Description = "Eliminate 10 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 80,
			RewardGold = 0,
			MinLevel = 1,
			Go = "Hostiles", -- GO once OpsService has an Open checkpoint or camp
		},
		DailyCapture = {
			Id = "DailyCapture",
			DisplayName = "Seize Ground",
			Description = "Capture 1 territory.",
			ObjectiveType = "CaptureTerritory",
			Target = 1,
			RewardCash = 4000,
			RewardXP = 120,
			RewardGold = 1,
			MinLevel = 1,
		},
		DailyUpgrade = {
			Id = "DailyUpgrade",
			DisplayName = "Fortify Base",
			Description = "Buy 1 base upgrade — reward $3,000 + 100 XP.",
			ObjectiveType = "PurchaseUpgrade",
			Target = 1, -- v37: completable in first ~5 min
			RewardCash = 3000,
			RewardXP = 100,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyEarnCash = {
			Id = "DailyEarnCash",
			DisplayName = "War Chest",
			Description = "Earn $8,000 Cash from any source.",
			ObjectiveType = "EarnCash",
			Target = 8000,
			RewardCash = 2000,
			RewardXP = 60,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailySpawnVehicle = {
			Id = "DailySpawnVehicle",
			DisplayName = "Mobilize",
			Description = "Spawn 1 vehicle from the garage — reward $1,500 + 40 XP.",
			ObjectiveType = "SpawnVehicle",
			Target = 1,
			RewardCash = 1500,
			RewardXP = 40,
			RewardGold = 0,
			MinLevel = 1,
		},
		DailyKillPlayer = {
			Id = "DailyKillPlayer",
			DisplayName = "Combat Ready",
			Description = "Eliminate 3 enemy players.",
			ObjectiveType = "KillPlayer",
			Target = 3,
			RewardCash = 5000,
			RewardXP = 150,
			RewardGold = 2,
			MinLevel = 5,
		},
		DailyRecruit = {
			Id = "DailyRecruit",
			DisplayName = "Muster Troops",
			Description = "Recruit 1 soldier — reward $2,000 + 50 XP + 1 Gold.",
			ObjectiveType = "RecruitSoldiers",
			Target = 1, -- v37: first-5-min friendly
			RewardCash = 2000,
			RewardXP = 50,
			RewardGold = 1,
			MinLevel = 1,
		},
	} :: { [string]: DailyMissionDef },

	--[[ claude-bud JOB 49 part C (2026-10-01): 3 CORE daily missions tied to the loop (owner-first; OFF = the rotation
		above exactly). While live, the Missions panel's top section is exactly Count missions of Count DIFFERENT loop
		types (Pool), picked once per day per player (seeded by UserId + day, saved in DailyMissions.Core so the list
		never reshuffles), the target set by his level tier so all 3 fit in one session; the Daily Ops stay below.
		Raid is offered only when a raid is possible for him (RivalService has a target), else WinFights takes its place.
		Rewards: max(the mission's RewardCash floor, RewardIncomeMinutes x his income per minute); all 3 claimed -> the
		Chest once a day. Reroll: FreePerDay free (server-checked, saved per day); the Robux reroll (19 R$, Code Bot v180) after it. ]]
	Core = {
		Enabled = true,
		OwnerFirst = false, -- Code Bot v182 (Shaun approved 2026-10-01): core daily missions live for everyone
		Count = 3,
		ResetHourUtc = 0, -- the daily reset (0 = 00:00 UTC, today's behaviour)
		Pool = { "Raid", "Recruit", "Build", "WinFights" },
		TierMaxLevel = { 10, 40 }, -- tier 1 up to level 10, tier 2 up to 40, tier 3 above
		RewardIncomeMinutes = 10,
		Chest = { Cash = 10000, Gold = 3, IncomeMinutes = 20 },
		Reroll = {
			FreePerDay = 1,
			-- Code Bot v180 (Shaun approved 2026-10-01): the paid reroll (DevProducts.MissionReroll 3715836569, 19 R$) is live.
			-- OwnerFirst false here; Core.OwnerFirst false since v182, so the reroll is open to everyone with Core.
			Robux = { Enabled = true, OwnerFirst = false, ProductKey = "MissionReroll" },
		},
		-- per loop type: the ObjectiveType, GO key, the floor reward and the target per tier (1 / 2 / 3)
		Types = {
			Raid = { Objective = "Raid", Go = "Targets", Name = "Raid a Base", Desc = "Win %d raid(s) on a rival base.", Targets = { 1, 1, 2 }, Cash = 4000, XP = 120 },
			Recruit = { Objective = "RecruitSoldiers", Go = "Army", Name = "Grow the Army", Desc = "Recruit %d soldiers.", Targets = { 3, 5, 10 }, Cash = 2000, XP = 60 },
			Build = { Objective = "PurchaseUpgrade", Go = "Build", Name = "Build Up", Desc = "Buy %d base upgrade(s).", Targets = { 1, 2, 3 }, Cash = 3000, XP = 100 },
			WinFights = { Objective = "KillNPC", Go = "Hostiles", Name = "Win Fights", Desc = "Beat %d enemies.", Targets = { 5, 10, 20 }, Cash = 2500, XP = 80 },
		},
	},

	-- Display order, and the order of the rotation pool (MissionService)
	DailyMissionOrder = {
		"DailyUpgrade", -- v37: first 5-min completable
		"DailyRecruit",
		"DailySpawnVehicle",
		"DailyKillNPC",
		"DailyCapture",
		"DailyEarnCash",
		"DailyKillPlayer",
	},

	-- Legacy timed missions (optional start → wait Duration → claim). v69: no client UI starts them,
	-- so the RequestStartMission remote is ignored unless this is true; each one pays once per UTC day.
	TimedMissionsRemoteEnabled = false,
	Missions = {
		PatrolOutskirts = {
			Id = "PatrolOutskirts",
			DisplayName = "Patrol the Outskirts",
			Description = "Secure the perimeter around your base.",
			MinLevel = 1,
			DurationSeconds = 60,
			RewardCash = 800,
			RewardXP = 50,
			Difficulty = "Easy",
		},
		SupplyRun = {
			Id = "SupplyRun",
			DisplayName = "Supply Run",
			Description = "Escort a convoy to the depot.",
			MinLevel = 3,
			DurationSeconds = 120,
			RewardCash = 2000,
			RewardXP = 120,
			Difficulty = "Normal",
		},
		RaidOutpost = {
			Id = "RaidOutpost",
			DisplayName = "Raid Enemy Outpost",
			Description = "Strike a hostile forward base.",
			MinLevel = 8,
			DurationSeconds = 180,
			RewardCash = 6000,
			RewardXP = 300,
			Difficulty = "Hard",
		},
	} :: { [string]: MissionDef },
}

-- claude-bud JOB 49 C: the Core mission defs (Core<Type><tier>), built from Core.Types into DailyMissions (never in the
-- rotation pool: DailyMissionOrder does not list them)
do
	local core: any = (MissionConfig :: any).Core
	for typeId, t in pairs(core.Types) do
		for tier, target in ipairs(t.Targets) do
			local id = "Core" .. typeId .. tostring(tier)
			MissionConfig.DailyMissions[id] = {
				Id = id,
				DisplayName = t.Name,
				Description = string.format(t.Desc, target),
				ObjectiveType = t.Objective,
				Target = target,
				RewardCash = t.Cash,
				RewardXP = t.XP,
				RewardGold = 0,
				MinLevel = 1,
				Go = t.Go,
			}
		end
	end
end

-- claude-bud JOB 49 C: the Core tier for a level (1, 2 or 3)
function MissionConfig.CoreTier(level: number): number
	local caps = (MissionConfig :: any).Core.TierMaxLevel
	for i, cap in ipairs(caps) do
		if level <= cap then
			return i
		end
	end
	return #caps + 1
end

function MissionConfig.CoreLiveFor(userId: any): boolean
	return (require(script.Parent.RetentionConfig) :: any).Live((MissionConfig :: any).Core, userId)
end

return MissionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Live Robux product IDs (Creator Dashboard / Open Cloud). Id=0 = stub / hidden duplicate.
	Grants ONLY via server ProcessReceipt / GamePass ownership checks — never client confirmation.
	DevProducts AutoCollect/DoubleCash/VIPBoost are HideFromShop (GamePasses cover them).
	v69: OneTime = true marks a DevProduct whose grant is a boolean (buying it twice adds nothing). The Shop
	shows OWNED instead of prompting once the server reports it owned (player attribute WE_Ent_<key>, see
	ShopController). ProcessReceipt still grants any receipt Roblox delivers. HideFromShop on a GamePass keeps
	it out of the Shop list.
	v71 money (M0): HideFromShop also stops selling dead items (Gold packs: Gold has no use yet; Instant Barracks).
	Their Ids stay unchanged (never set a live Id to 0). A receipt for a product Id that is not listed here is NOT
	acknowledged (MonetizationService J2): paste new Ids with tools/wire-monetization-ids.py, publish, then run
	Migrate to Latest Update.
	v71 money (M1): receipt fields for the grant path (MonetizationService.ProcessReceipt, all applied before the
	receipt is marked and saved; see the field notes below):
	  GrantEntitlement = "Key"          one boolean entitlement (profile.Entitlements[Key])
	  GrantEntitlements = { "A", "B" }  a list of them (merged with GrantEntitlement, each granted once)
	  StarterFallbackCash = N           + N Cash when the buyer already owns Auto Collect (decided before any grant)
	  GrantNukes = N (etc.)             counter grants: only the fields whitelisted in CounterGrants below
	  Feature = "Name"                  the SKU belongs to a feature that is not live yet (M3: shown only when the
	                                    ReplicatedStorage attribute WE_Feature_<Name> is true and Id ~= 0). Until
	                                    M3 ships, every Feature SKU also carries HideFromShop = true.
	  SoldFrom = "Panel"                the SKU is sold from that panel only (HideFromShop keeps it out of the Shop
	                                    list; the Id wiring tool does not ask to remove HideFromShop for it).
	New SKUs stay Id = 0 until the owner creates them; game passes are created with Item for Sale OFF (J3).
	Owner's 11 features (lane K1, spec_f11 §2): GamePasses.ImpulseSpeed (5 R$ Speed Pass), DevProducts.RebirthKeepBase
	(50 R$ keep-base rebirth token, counter grant GrantKeepBaseRebirths), the GoldenPumpjack Shop row (lights up when
	the Id is pasted), DeathSpeedOffer (one death offer per session) and PremiumPads (the ATM pad slots). Every new Id
	stays 0 until the owner creates the product: nothing prompts, no pad is built and no Shop row shows while it is 0. ]]

local AdminConfig = require(script.Parent.AdminConfig)

-- F1: one PremiumPads slot (see MonetizationConfig.PremiumPads)
export type PremiumPadOffer = { Kind: "GamePass" | "DevProduct", Key: string }
export type PremiumPadSlot = {
	Id: string,
	Label: string,
	Color: Color3,
	Offset: Vector3,
	Offers: { PremiumPadOffer },
	OwnedIfAny: { string }?,
}

local MonetizationConfig = {
	--[[ claude-bud: rollout of the three Robux SKUs in RolloutKeys. "owner" = only AdminConfig.IsPlaytestOwner can buy
		them and feel their effect; "all" = everyone; anything else = off (fail closed). ProcessReceipt still grants any
		receipt Roblox delivers for these Ids (a paid receipt is never dropped). OFF must equal the old game. ]]
	Rollout = "all", -- v101 (Code Bot, owner 2026-09-29: "enable everything for all players"): every RolloutKeys SKU on sale to everyone
	--[[ claude-bud JOB 12: the launch switch. LaunchAll = true makes every gate named in LaunchSafe live for EVERYONE at
		once (as if its Rollout were "all"), and turns off the playtest owner's shortcuts on the Robux path (premium vehicle
		spawn without the pass, the Extra Garage Slot test, premium weapons), so he buys like anyone else. Gates NOT in
		LaunchSafe (the BalanceConfig curve, the army rollouts, the aircraft / rebirth weapon lanes, the store vehicle
		bodies, Bridge Layer wading) keep their own switches: see LATEST-HANDOFF "Launch readiness". false = today. ]]
	LaunchAll = false,
	LaunchSafe = {
		Sales = true, -- MonetizationConfig.Rollout over RolloutKeys: the 13 Robux products (+ premium vehicle weapons)
		VIPPerks = true,
		Placement = true,
		Retention = true,
		Airdrop = true,
		DailyAutoClaim = true,
		PlazaBounty = true,
		ArmyUpgrades = true,
		GuardsFightBack = true,
		NpcUnstick = true,
		BagLos = true,
		FirstMinutes = true,
		QualityTier = true,
		Juice = true,
	} :: { [string]: boolean },
	RolloutKeys = { ImpulseSpeed = true, RebirthKeepBase = true, GoldenPumpjack = true, PV_Skylance = true, PV_Stormwing = true, PV_Leviathan = true, PV_Tidebreaker = true, PV_Warlord = true, PV_Razorfang = true, BiggerArmy = true, ExtraGarageSlot = true, SoldierRefill = true, PlazaAirstrike = true } :: { [string]: boolean },
	GamePasses = {
		VIP = {
			Id = 1985475542,
			DisplayName = "VIP",
			RobuxPrice = 199,
			CashBonusMult = 0.25, -- additive +25% cash earnings
			Description = "+25% cash on everything you earn", -- Code Bot v156: plain player text
			-- claude-bud JOB 36 (ShopOverhaulConfig, owner-first): the premium VIP. Shown at this price while the overhaul is
			-- live. codebot_v142 (2026-09-30): the Creator Hub price stays 199 (owner has NOT approved 349), so the Shop shows
			-- the real price. Change this only together with the Creator Hub price.
			OverhaulRobuxPrice = 199,
			OverhaulDescription = "+50% cash, a daily cash crate and VIP lounge", -- Code Bot v156: plain player text
		},
		-- claude-bud JOB 36: new passes (ShopOverhaulConfig). codebot_v140 (2026-09-30): owner created them on the Creator
		-- Hub (universe 10767159222, on sale, prices match); Ids wired. Implies = passes this one counts as owning.
		WarChest = {
			Id = 2002640637,
			OverhaulShop = true, -- sold by the JOB 36 Shop (and prompted) while ShopOverhaulConfig is live
			DisplayName = "War Chest",
			RobuxPrice = 799,
			Implies = { "DoubleCash", "AutoCollect", "VIP", "BiggerArmy" },
			HideFromShop = true, -- listed by the overhaul Shop only (hidden once all four are owned)
			Description = "2x cash, Auto Collect, VIP and Bigger Army", -- Code Bot v156: plain player text
		},
		SuperSoldiers = {
			Id = 1998231741,
			OverhaulShop = true, -- sold by the JOB 36 Shop (and prompted) while ShopOverhaulConfig is live
			DisplayName = "Super Soldiers",
			RobuxPrice = 349,
			HideFromShop = true, -- listed by the overhaul Shop only
			Description = "Your soldiers get +25% damage and health", -- Code Bot v156: plain player text
		},
		DoubleHP = {
			Id = 2002214665,
			OverhaulShop = true, -- sold by the JOB 36 Shop (and prompted) while ShopOverhaulConfig is live
			DisplayName = "Double HP",
			RobuxPrice = 199,
			HideFromShop = true, -- listed by the overhaul Shop only
			Description = "Double your max health",
		},
		DoubleCash = {
			Id = 1982865711,
			DisplayName = "2x Cash",
			RobuxPrice = 149,
			CashMult = 2, -- multiplicative 2x cash earnings
			Description = "Double your cash income", -- Code Bot v156: plain player text
		},
		DoubleXP = {
			Id = 1982487698,
			DisplayName = "Double XP",
			RobuxPrice = 99,
			XPMult = 2,
			Description = "Double the XP you earn", -- Code Bot v156: plain player text
		},
		-- v69: HideFromShop — no code applies this theme yet, so it is not sold in the in-game Shop.
		-- Id kept unchanged (existing owners keep the pass); remove HideFromShop once the theme ships.
		ExtraPlotCosmetic = {
			Id = 1983357731,
			DisplayName = "Elite Base Theme",
			RobuxPrice = 79,
			Description = "Cosmetic base theme",
			HideFromShop = true,
		},
		AutoCollect = {
			Id = 1985115501,
			DisplayName = "Auto Collect",
			RobuxPrice = 99,
			Description = "Your ATM cash is collected for you", -- Code Bot v156: plain player text
		},
		-- F8 (owner's 11 features): 5 R$ Speed Pass, walk speed x WalkSpeedMult forever. Id = 0 until the owner creates
		-- the pass. The 99 R$ Speed Boost Developer Product (DevProducts.SpeedBoost) stays; owning both gives the higher
		-- multiplier (MonetizationService.SpeedMultFor). Keep this key name: BuyPathStatic matches the first Speed Boost
		-- product block by its key.
		ImpulseSpeed = {
			Id = 1998656357,
			DisplayName = "Speed Pass",
			RobuxPrice = 99, -- 2026-09-29 owner repriced 5 -> 99 in Creator Hub
			WalkSpeedMult = 1.5, -- v133 (owner: "still not fast"): was 1.4 (v126, 16 -> 22.4); now 16 -> 24
			WalkSpeedMultV2 = 1.75, -- claude-bud JOB 40 (SpeedV2 live): 16 -> 28, "Run 75% faster"
			-- Description: set below from MonetizationConfig.SpeedText (one source for every speed string)
		},
		-- v71 money (M1): premium Robux vehicles (plan §2.2, PremiumVehicleConfig.Lineup PassKey). Id = 0 until the
		-- owner creates each pass (Item for Sale OFF until the M6 publish, J3). HideFromShop until M3's feature gate
		-- (WE_Feature_PremiumVehicles); the generic Shop pass loop must skip VehicleIds passes (M3/M6 Garage sells
		-- them). BundlePassKeys = other passes that also unlock the car; HideIfOwnsAny hides the bundle row.
		PV_Razorfang = {
			Id = 2002484380,
			DisplayName = "Razorfang GT Interceptor",
			RobuxPrice = 199,
			VehicleIds = { "PremiumRazorfang" },
