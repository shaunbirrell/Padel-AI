      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Client/server helper to fetch remotes created by RemoteSetup.
	Does not create remotes on the client.
	Waits patiently — Rojo ships an empty Remotes folder; server may still
	be running MapSetup before RemoteSetup.Init. Never hard-assert after 10s.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(script.Parent.Constants)

local Remotes = {}

local function getFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if folder and folder:IsA("Folder") then
		return folder :: Folder
	end
	folder = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName, 120)
	assert(folder and folder:IsA("Folder"), "Remotes folder missing — server Bootstrap must run first")
	return folder :: Folder
end

local function waitForRemote(name: string, className: string): Instance
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA(className) then
		return existing
	end
	-- Poll with warns — map/service load can exceed 10s on cold Studio Play
	local waited = 0
	while waited < 180 do
		local remote = folder:WaitForChild(name, 5)
		if remote and remote:IsA(className) then
			return remote
		end
		waited += 5
		warn(string.format("[Remotes] Waiting for %s %s… (%ds)", className, name, waited))
	end
	local remote = folder:WaitForChild(name, 30)
	if not (remote and remote:IsA(className)) then
		error(className .. " missing after wait: " .. name .. " (server Bootstrap may have aborted — check Output)", 0)
	end
	return remote
end

function Remotes.GetEvent(name: string): RemoteEvent
	return waitForRemote(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.GetFunction(name: string): RemoteFunction
	return waitForRemote(name, "RemoteFunction") :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Shared type aliases for WAR EMPIRE.
]]

export type Currency = "Cash" | "Gold"

export type StructureId =
	"CommandCenter"
	| "Barracks"
	| "VehicleDepot"
	| "WeaponsFacility"
	| "Helipad"
	| "Airfield"
	| "DefensiveWalls"
	| "Watchtowers"
	| "Radar"
	| "ResearchLab"
	| "MissileDefense"
	| "PowerStation"
	| "Warehouse"
	| "SpecialForcesFacility"

export type BaseUpgrades = { [string]: number }

export type PlayerSettings = {
	MusicVolume: number,
	SFXVolume: number,
	ShowDamageNumbers: boolean,
	AutoSprint: boolean,
}

export type PlayerStats = {
	TotalCashEarned: number,
	TotalGoldEarned: number,
	UpgradesPurchased: number,
	VehiclesSpawned: number,
	MissionsCompleted: number,
	TerritoriesCaptured: number,
	Kills: number,
	Deaths: number,
	PlayTimeSeconds: number,
}

export type DailyLogin = {
	LastClaimDay: number, -- YYYYMMDD or 0
	Streak: number,
	LastClaimUnix: number,
}

export type DailyMissionProgress = {
	DayKey: number, -- YYYYMMDD UTC
	Progress: { [string]: number },
	Claimed: { [string]: boolean },
	ActiveTimed: { [string]: number }, -- missionId -> endsAt unix
}

export type BattlePassProgress = {
	SeasonId: string,
	XP: number,
	Level: number,
	Premium: boolean,
	ClaimedFree: { [string]: boolean },
	ClaimedPremium: { [string]: boolean },
}

export type PlayerProfile = {
	DataVersion: number,
	Cash: number,
	PendingCash: number,
	Gold: number,
	Level: number,
	XP: number,
	Prestige: number,
	RebirthUnlocks: { [string]: boolean },
	Soldiers: number,
	NationColorId: string?,
	RedeemedCodes: { [string]: boolean },
	LastSpinnerClaimUnix: number,
	Vehicles: { [string]: boolean },
	Weapons: { [string]: boolean },
	EquippedWeapon: string?,
	Territories: { [string]: boolean },
	BaseUpgrades: BaseUpgrades,
	BasePlotId: number?,
	TutorialStep: number,
	TutorialComplete: boolean,
	DailyLogin: DailyLogin,
	DailyMissions: DailyMissionProgress,
	Settings: PlayerSettings,
	Stats: PlayerStats,
	Achievements: { [string]: boolean },
	BattlePass: BattlePassProgress,
	ClanId: string?,
	FirstJoinUnix: number,
	LastJoinUnix: number,
	ProcessedReceipts: { [string]: boolean }?,
	Entitlements: { [string]: boolean }?,
	OutpostIncomeStacks: number?,
	StarterBundleOffered: boolean?,
	AutoCollectOffered: boolean?,
	DoubleCashOffered: boolean?,
	VIPOffered: boolean?,
}

export type EconomyUpdatePayload = {
	Cash: number,
	Gold: number,
	PendingCash: number?,
}

export type XPUpdatePayload = {
	Level: number,
	XP: number,
	XPToNext: number,
	HudGoal: string?,
	UnlockMessage: string?,
}

export type BaseStatePayload = {
	PlotId: number?,
	Upgrades: BaseUpgrades,
	PassiveIncomePerTick: number,
}

export type PlayerStatePayload = {
	Cash: number,
	Gold: number,
	PendingCash: number?,
	Level: number,
	XP: number,
	XPToNext: number,
	Prestige: number,
	Soldiers: number,
	NationColorId: string?,
	TrainingIncomePerTick: number?,
	Base: BaseStatePayload,
	TutorialStep: number?,
	TutorialComplete: boolean,
	Vehicles: { [string]: boolean },
	Weapons: { [string]: boolean },
	EquippedWeapon: string?,
	DailyLogin: DailyLogin?,
	TerritoriesOwned: { [string]: boolean }?,
}

export type CombatStatePayload = {
	Health: number,
	MaxHealth: number,
	WeaponId: string?,
	Ammo: number,
	MagazineSize: number,
	Reloading: boolean,
	Alive: boolean,
}

export type CombatHitFeedbackPayload = {
	Kind: string, -- "Hit" | "Kill" | "Miss" | "Damaged" | "Death"
	Damage: number?,
	TargetName: string?,
	WeaponId: string?,
	IsHeadshot: boolean?,
}

export type VehicleStatePayload = {
	Owned: { [string]: boolean },
	ActiveVehicleId: string?,
