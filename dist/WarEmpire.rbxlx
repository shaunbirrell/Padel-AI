        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CombatConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Combat tuning — health, kill rewards, NPC pool/AI.
	Weapon stats live in WeaponConfig; never trust client damage amounts.
]]

export type NPCTypeDef = {
	Id: string,
	DisplayName: string,
	Health: number,
	Damage: number,
	FireRate: number,
	Range: number,
	WalkSpeed: number,
	AggroRange: number,
	CashReward: number,
	XPReward: number,
	Color: Color3,
	HitChanceNear: number?, -- claude-bud JOB 41: an optional per-type CAP on CombatNPC.HitChance (near / far)
	HitChanceFar: number?,
}

local AdminConfig = require(script.Parent.AdminConfig)

local CombatConfig = {
	PlayerMaxHealth = 100,
	SpawnInvulnerabilitySeconds = 3, -- mirrors GameConfig; CombatService uses this

	PlayerKill = {
		Cash = 150,
		XP = 40,
	},

	DefaultNPCKill = {
		Cash = 50,
		XP = 15,
	},

	MaxOriginDeltaStuds = 12,
	MaxAimDirectionError = 0.001,
	HitPositionSlopStuds = 4,

	FireRemoteRate = 20,
	FireRemoteBurst = 28,
	ReloadRemoteRate = 2,
	ReloadRemoteBurst = 3,
	EquipRemoteRate = 3,
	EquipRemoteBurst = 4,
	PurchaseWeaponRate = 2,
	PurchaseWeaponBurst = 3,

	MaxActiveNPCs = 18,
	NPCRespawnSeconds = 18,
	NPCThinkInterval = 0.35,
	-- W3 step 2, lane F (spec w3s2 §4): off. The random extra field NPCs near territory markers (a lone Infantry on
	-- the Town plaza, a stand-in on a rig) are gone; field hostiles come only from the WE_NPCSpawn anchors, and the
	-- NPC budget is left for the bank, the forts and the rigs.
	NPCAlsoSpawnNearTerritories = false,
	MaxTerritoryNPCSpawns = 4,

	-- W3 step 2 Phase B, lane N (NPC core; spec w3s2 §4, contract §5). The cap stays MaxActiveNPCs (18 regular);
	-- these types, and SpawnNPC's opts.OverCap event NPCs, may go SpecialOverCap past it (18 + 4 = 22 alive at most).
	SpecialNPCTypes = { "BankGuard", "OilRigGuard", "FortGuard" } :: { string },
	SpecialOverCap = 24, -- claude-bud JOB 24 §6: 4 (bank) + OutpostDefenderConfig.MaxTotal 20 (defenders only exist near players)
	-- The legacy field NPCs (BootstrapNPCs over the WE_NPCSpawn anchors). Ships true (today). The Ops cutover sets
	-- it false: the camps' garrisons then come from OpsService, never two garrisons on the same posts.
	FieldBootstrap = true,
	-- SpawnNPC opts.Stance: "Aggressive" (today) | "Passive" (holds fire until provoked) | "Post" (never walks)
	NPCStance = {
		ProvokeHoldSeconds = 2, -- Passive: an on-foot player inside ProvokeRadius of a Home this long provokes the group
		CalmSeconds = 30, -- a provoked group calms this long after its last contact (a target in AggroRange, or hurt)
		HomeSlack = 2, -- studs (flat): "at home" for the walk back
	},

	NPCTypes = {
		-- claude-bud JOB 41: the Guided training camp (TutorialConfig.Guided.Camp): weak on purpose, a first win
		Recruit = {
			Id = "Recruit",
			DisplayName = "Camp Recruit",
			Health = 40,
			Damage = 4,
			FireRate = 1.2,
			Range = 50,
			WalkSpeed = 10,
			AggroRange = 60,
			CashReward = 50,
			XPReward = 15,
			Color = Color3.fromRGB(120, 100, 70),
			HitChanceNear = 0.35,
			HitChanceFar = 0.2,
		},
		Infantry = {
			Id = "Infantry",
			DisplayName = "Hostile Infantry",
			Health = 80,
			Damage = 10,
			FireRate = 2.5,
			Range = 70,
			WalkSpeed = 12,
			AggroRange = 90,
			CashReward = 50,
			XPReward = 15,
			Color = Color3.fromRGB(140, 55, 55),
		},
		HeavyInfantry = {
			Id = "HeavyInfantry",
			DisplayName = "Heavy Infantry",
			Health = 140,
			Damage = 16,
			FireRate = 1.6,
			Range = 85,
			WalkSpeed = 10,
			AggroRange = 100,
			CashReward = 90,
			XPReward = 28,
			Color = Color3.fromRGB(90, 40, 40),
		},
		-- claude-bud JOB 37: road checkpoint guards (CheckpointGuardConfig; rewards set there). Between Infantry and the
		-- bank guard. NOT a SpecialNPCType: they use the regular 18-slot pool (never the +4 headroom the bank / fort /
		-- oil-rig guards need), sleep with no slot while no live player is near, and a full pool simply spawns fewer.
		CheckpointGuard = {
			Id = "CheckpointGuard",
			DisplayName = "Checkpoint Guard",
			Health = 140,
			Damage = 9,
			FireRate = 1.1,
			Range = 70,
			WalkSpeed = 13,
			AggroRange = 80,
			CashReward = (require(script.Parent.CheckpointGuardConfig) :: any).KillCash,
			XPReward = (require(script.Parent.CheckpointGuardConfig) :: any).KillXP,
			Color = Color3.fromRGB(95, 90, 60),
		},
		OilRigGuard = {
			Id = "OilRigGuard",
			DisplayName = "Oil Rig Guard",
			Health = 200,
			Damage = 20,
			FireRate = 1.4,
			Range = 95,
			WalkSpeed = 9,
			AggroRange = 120,
			CashReward = 140,
			XPReward = 40,
			Color = Color3.fromRGB(110, 70, 35),
		},
		-- v71 bank retune (task #20): HEAD's 5 guards (28 dmg × 2.2/s, aggro 130) out-shot any player + squad
		-- (~200 dps at 35 studs), so the Empire Bank was unwinnable. Now 5 × 12 dmg × 1.3/s (~49 dps at 35 studs
		-- after the P1-2 hit chance): a lone player in the open still dies, a player + squad using cover takes it
		-- (headless end-to-end sim with the real BankRaidService: 7/7 seeds). Tankier (200 HP) so the squad matters.
		BankGuard = {
			Id = "BankGuard",
			DisplayName = "Bank Guard",
			Health = 200,
			Damage = 12,
			FireRate = 1.3,
			Range = 75,
			WalkSpeed = 14,
			AggroRange = 90,
			CashReward = 150,
			XPReward = 45,
			Color = Color3.fromRGB(55, 65, 120),
		},
		FortGuard = {
			Id = "FortGuard",
			DisplayName = "Fort Guard",
			Health = 170,
			Damage = 17,
			FireRate = 1.7,
			Range = 90,
			WalkSpeed = 10,
			AggroRange = 110,
			CashReward = 120,
			XPReward = 35,
			Color = Color3.fromRGB(100, 95, 70),
		},
		-- W3 step 2 Phase B, lane N: the camp boss (OpsConfig.Npc.CommanderType). A regular type: it counts against the
		-- 18, not the +4 headroom.
		CampCommander = {
			Id = "CampCommander",
			DisplayName = "Camp Commander",
			Health = 260,
			Damage = 14,
			FireRate = 1.5,
			Range = 80,
			WalkSpeed = 10,
			AggroRange = 100,
			CashReward = 250,
			XPReward = 60,
			Color = Color3.fromRGB(72, 78, 44),
		},
	} :: { [string]: NPCTypeDef },

	DefaultNPCType = "Infantry",

	--[[ claude-bud (2026-09-29): NPC guards shoot back at the squad unit that shot them (the Empire Bank guards, camps).
		A plain NPC (Aggressive, no group) remembers the last unit that hit it for MemorySeconds and, while no player is in
		its AggroRange, fights that unit through the same line-of-sight + CombatNPC.HitChance gates as its shots at players
		(DamageMult x its Damage). Rollout is per unit owner: "owner" = AdminConfig.IsPlaytestOwner only, "all", anything
		else = off (today's game: NPCs never hurt squad units). ]]
	GuardsFightBack = {
		Rollout = "all", -- v101
		MemorySeconds = 8,
		DamageMult = 1,
	},

	--[[ claude-bud (2026-09-29): unstick a chasing NPC (bank guards G1 / G2 jam on the 6 x 3 x 2 planters in front of the
		hall). A plain NPC walking after its target that moved under MinProgressStuds in StuckSeconds jumps and sidesteps
		SidestepStuds to one side (alternating) for DetourSeconds, then resumes the chase. Rollout per target (the player
		or the unit owner): "owner" / "all" / off (today's straight MoveTo only). ]]
	NpcUnstick = {
		Rollout = "all", -- v101
		StuckSeconds = 1.5,
		MinProgressStuds = 1,
		SidestepStuds = 8,
		DetourSeconds = 1.2,
	},
}

-- claude-bud: is a GuardsFightBack / NpcUnstick block live for this user id (fail closed)
function CombatConfig.LiveFor(block: any, userId: any): boolean
	local gate = if block == CombatConfig.GuardsFightBack then "GuardsFightBack" elseif block == CombatConfig.NpcUnstick then "NpcUnstick" else nil
	if gate and (require(script.Parent.MonetizationConfig) :: any).Launched(gate) then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = if typeof(block) == "table" then block.Rollout else nil
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return AdminConfig.IsPlaytestOwner(userId)
	end
	return false
end

--[[ claude-bud JOB 32: the ONE line-of-sight / shot rule for every shooter (Shared/Util/LosRule): a solid (CanCollide)
	part stops a shot and blocks sight, a non-colliding one never does, water never does; a shot can also stop on a
	character part (its target). Unified = false: every shooter keeps its old ray settings. ]]
CombatConfig.LineOfSight = {
	Unified = true,
	MaxSkips = 6, -- a shot steps over at most this many see-through parts
}

--[[ claude-bud JOB 51 (2026-10-01, P0 "the Central Plaza guards don't shoot my girlfriend / she can't damage them"):
	ONE shared hostility / protection rule (CombatService.ProtectedReason / NpcMayTarget / MayHurt). With it live, EVERY
	CombatService NPC (outpost defenders, bank, checkpoint, ops garrisons) picks the nearest player it MAY hurt and skips
	a spawn- or novice-shielded one (before: the nearest player, shielded or not, then a guaranteed miss forever).
	OwnerFirst by the CANDIDATE player (RetentionConfig.Live); OFF == the old pick exactly. ]]
;(CombatConfig :: any).SharedHostility = {
	Enabled = true,
	OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 51): Code Bot flips it after Shaun's 2-player phone test
	DebugLogSeconds = 1, -- [GuardTarget] at most once per NPC per this many seconds (only while someone has WE_GuardDebug)
}

return CombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CombatFairnessConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Combat fairness (mobile plan P0-7, P0-6 server part, P1-2, P1-4). About 80 % of players are on phones, so the
	server never trusts a client-named target, keeps brand-new players out of raids, makes NPCs need line of sight
	and miss sometimes, and makes the default squad order (FOLLOW) protect the player. Server-side numbers only.
]]

local CombatFairnessConfig = {
	-- ── P0-7 · claimed target (CombatService.RequestFire) ─────────────────────────────────────────────────────
	-- When the server's own fire ray misses every player / NPC / gate, the TargetUserId / TargetNpcId the client sent
	-- may still take the hit (lag tolerance: the target moved after the phone's ray hit it), but only if the target
	-- is alive, in front of the fire ray, within weapon range, its torso lies within MissTolerance studs sideways of
	-- the ray, and a server ray from the validated origin to that torso hits the target before any wall, terrain,
	-- vehicle or other player. Fire rate and ammo are spent before this check, exactly as for any shot.
	MissTolerance = 5, -- studs sideways from the fire ray to the target torso (v70: 4 → 5 so phone players on ~250 ms cellular still land 10/12 aim points on a walking target; line of sight is still required)
	ClaimLosPastTorsoStuds = 2, -- the line-of-sight ray runs this far past the torso centre so it can touch the target
	-- The fire ray hit only scenery (usually the ground behind the target): the claim is still checked as above, if
	-- the torso is no further along the ray than that hit + ClaimBeyondHitStuds. false = only rays that hit nothing.
	ClaimAfterSceneryHit = true,
	ClaimBeyondHitStuds = 3,
	RefusalLogSeconds = 10, -- at most one refusal log line per shooter per this many seconds (the rest are counted)

	-- ── P0-6 · new-thief protection (MoneyCollectorService.CanRaid) ───────────────────────────────────────────
	-- Mirrors the victim's new-player protection: a thief who has not finished (or skipped) the tutorial, or who
	-- joined less than ThiefProtectMinutes ago, cannot start or finish an ATM raid. Texts are device-neutral.
	ThiefProtectEnabled = true,
	ThiefProtectMinutes = 10, -- since profile.FirstJoinUnix
	ThiefRequireTutorialDone = true,
	ThiefProtectInStudio = false, -- like RaidConfig.Raid.ProtectNewPlayersInStudio (Studio makes fresh profiles)
	ThiefTutorialText = "Finish or skip the tutorial to start raiding",
	ThiefNewText = "New player — raids unlock in %s", -- %s = m:ss

	-- ── P1-2 · NPC shots (CombatNPC.Think) ───────────────────────────────────────────────────────────────────
	NpcRequireLos = true, -- a ray from the NPC's eyes to the target must not hit anything else first
	NpcLosRespectCanCollide = true, -- non-collidable decor does not block (same rule as the gate guards)
	NpcIgnoreTargetVehicle = true, -- the vehicle the target SITS in never blocks (no free shield until vehicle HP, M4)
	NpcEyeHeight = 1.5, -- studs above the NPC root the shot starts from
	NpcNearStuds = 20, -- at or inside this distance the hit chance is NpcNearHitChance
	NpcNearHitChance = 0.75,
	NpcFarHitChance = 0.30, -- at the NPC type's max Range; linear in between
	NpcFastTargetSpeed = 10, -- studs/s (horizontal, sampled on the server); faster targets are harder to hit
	NpcFastTargetPenalty = 0.15, -- subtracted from the hit chance against fast targets
	NpcMinHitChance = 0.05,
	NpcReactionSeconds = 0.5, -- no shot until the NPC has seen its (new) target this long
	NpcReactionOnLosRegain = true, -- losing sight restarts the reaction delay (peeking from cover is fair)
	NpcChaseWithoutLos = true, -- an NPC in range but without a clear shot keeps closing in

	-- ── P1-4 · squad escort (SquadOrdersService, order "Follow") ─────────────────────────────────────────────
	EscortEngageRadius = 55, -- FOLLOW units shoot hostiles within this distance of their player
	EscortLeash = 20, -- ...while staying within this distance of the player
	EscortRequireLos = true, -- escort shots need line of sight (friendly units and the owner never block)
	UnitKillCashShare = 0.5, -- a kill landed by a squad unit pays the owner this share of the normal kill cash
	UnitKillXPShare = 1, -- ...and this share of the normal kill XP (kills and mission progress count in full)
	-- Attack-order hits credit the owner too? Off: Attack units roam with no leash, so an idle owner hidden behind a
	-- wall near the bank earned ~$9,150 in 10 min in the verifier sim (HEAD: $0; ATTACK shots then went through
	-- walls). squadfair: they need a line of sight now, but the missing leash still makes an idle farm, so escort only.
	UnitKillCreditOnAttack = false,

	-- ── squadfair · every squad unit shot (orders ATTACK and FOLLOW escort; SquadOrdersService.unitShoot) ─────────
	-- A unit shoots like an NPC: it needs a line of sight from its eyes (NpcEyeHeight) to the target (its squad, the
	-- owner and the target never block; the escort's ray) and rolls a hit chance that falls with distance. A miss
	-- spends the fire cooldown like a hit. A hit goes through CombatService's NPC damage path (ApplyUnitHit), so squad
	-- fire provokes a Passive / grouped NPC (bank guards, Ops garrisons) like a player's shot. Units only ever shoot
	-- CombatService NPCs: never a player (novice shield, clan allies), never a statue (a WE_NPC model with no NPCId).
	UnitAttackRequireLos = true, -- ATTACK shots need line of sight too (FOLLOW escort shots: EscortRequireLos)
	-- Another NPC's body never blocks a squad ray (walls, terrain, vehicles and other players still do): two hostiles
	-- standing close hid each other from the whole squad, which then stopped shooting and pressed into them.
	UnitLosIgnoreNPCBodies = true,
	-- The FOLLOW escort (the default order) never opens fire on a calm Passive NPC (bank guards, Ops garrisons before they
	-- are provoked), so walking past a quiet site with a squad never starts a fight. Once the group is provoked (your shot,
	-- a breach, ProvokeRadius, an ATTACK order's hit) the escort defends you. false = the escort shoots calm guards too,
	-- and its first hit provokes the whole group (ASSUMPTIONS SQF-11; reversible here).
	EscortIgnoreCalm = true,
	-- A unit whose nearest hostile is walled off shoots the nearest hostile within its fire range (ATTACK: 85 % of
	-- AttackRange; FOLLOW escort: AttackRange) it CAN see: a check casts at most this many rays (the nearest hostile
	-- first, then the next nearest), and only while the nearest is blocked.
	UnitLosRaysPerCheck = 3,
	-- With nothing in sight in range, an ATTACK unit keeps closing in (like NpcChaseWithoutLos) for at most
	-- UnitBlockedChaseSeconds; so does a unit walking at a hostile out of range that gets no UnitChaseProgressStuds
	-- nearer in that time (a wall in its way: MoveTo walks straight, there is no pathfinding). The blocked timer runs
	-- only while something is in range to check: it starts over when nothing is (the unit is walking in) and when
	-- another hostile out of range becomes its target (a swap between hostiles in range keeps it running). Then it
	-- gives up THAT FIGHT: the hostiles within UnitGiveUpScopeStuds of where the one it chased stood (the last two such
	-- spots are kept). It still attacks any hostile elsewhere in reach (another group, or the walled one once it walks
	-- out of that circle); with only a given-up fight in reach it walks its owner's trail like FOLLOW, still shooting
	-- any hostile it can see in range, so it never walks back to the same wall. A shot into a given-up fight, or the
	-- order given again (tap ATTACK again), ends the give-ups; a given-up fight with nobody left in it is forgotten.
	-- The give-up does not restart the blocked timer: after it, a hostile elsewhere beyond range gets a fresh approach,
	-- but one inside range that it cannot see is given up at once, with no approach, until the timer starts over (so
	-- three or more walled spots never take turns; only two are remembered).
	-- 0 = one give-up covers every hostile until a shot or a new order (the round-3 rule). A blocked line is
	-- re-checked at most once per shot cooldown
	-- (1 / OrdersConfig.AttackFireRate).
	UnitChaseWithoutLos = true,
	UnitBlockedChaseSeconds = 6,
	UnitChaseProgressStuds = 2,
	UnitGiveUpScopeStuds = 30,
	-- The same order again within this many seconds of the last one (a double tap, or a spammed button) changes
	-- nothing: the blocked re-check wait, the chase timers and a give-up all stay. Later, the same order again is a
	-- fresh order (a squad that gave up tries once more).
	UnitRepeatOrderGraceSeconds = 2,
	-- Hit chance: UnitNearHitChance at or inside UnitNearStuds, falling linearly to UnitFarHitChance at
	-- OrdersConfig.AttackRange, never below UnitMinHitChance and never above UnitMaxHitChance (the code clamps to it).
	-- ATTACK units fire only inside 85 % of AttackRange, as before; the FOLLOW escort fires out to AttackRange. Squad
	-- values, higher than the NPC ones (Npc* above): units used to hit every shot, and the FOLLOW escort is the default
	-- protection on live. 0.98 / 0.96 is the middle option of the owner's decision A/B (ASSUMPTIONS SQF-5 / SQF-18;
	-- 0.96 / 0.92 is the lowest that meets the SQF-17 lines, 0.99 / 0.99 the closest to today). Never 1: a squad shot
	-- can always miss (CLAUDE.md: a hit chance must exist); keep 0 < Far <= Near <= Max < 1 (a BuyPathStatic pin
	-- parses these numbers, so a retune inside those bounds is a config-only change).
	UnitNearStuds = 35,
	UnitNearHitChance = 0.98,
	UnitFarHitChance = 0.96,
	UnitMinHitChance = 0.05,
	UnitMaxHitChance = 0.98,
	-- Provoke by proxy: a squad hit on a grouped or stance NPC (bank guards, Ops garrisons: any hit on one provokes its
	-- group and keeps it fighting) is refused unless the owner's living character stands within that NPC type's
	-- AggroRange of it (or within UnitProvokeOwnerStuds when that is above 0), calm or already provoked. The squad's
	-- target pick (ATTACK and FOLLOW) skips such NPCs while the owner is out of reach. So a squad never opens a fight
	-- its owner is not part of, and stops as soon as the owner leaves (the group then calms as usual). Plain Aggressive
	-- NPCs (every live camp and bank NPC while Jobs are off) are not affected. The group's targets are not changed:
	-- they take the nearest player, as before.
	UnitProvokeNeedsOwner = true,
	UnitProvokeOwnerStuds = 0,
	UnitHitErrorLogSeconds = 30, -- a failing CombatService.ApplyUnitHit is logged at most once per this many seconds

	-- ── F6 · novice shield (CombatService; owner's 11 features) ──────────────────────────────────────────────────
	-- A brand-new player (tutorial not complete, profile.NoviceShieldDone false) spawns with a visible ForceField
	-- (WE_NoviceShield) and cannot be damaged or targeted (InvulnerableUntil = math.huge, WE_ShieldUntil set). It ends
	-- for good (NoviceShieldDone = true, one Text.Off toast) on the first of: drawing a weapon (EndOnDraw), the first
	-- accepted shot (EndOnFire), an accepted squad order or missile strike (EndOnSquadOrder), contesting a zone
	-- (EndOnContestedCapture), tutorial complete or skip (EndOnTutorialComplete), or MaxSeconds of shielded play.
	-- Never re-granted once it has ended. Text is device-neutral (no keys, no "tap" / "click"), at most 42 characters.
	-- On since lane Z (reversible).
	NoviceShield = {
		Enabled = true,
		MaxSeconds = 900,
		EndOnDraw = true,
		EndOnFire = true,
		EndOnSquadOrder = true,
		EndOnTutorialComplete = true,
		EndOnContestedCapture = true,
		Text = {
			On = "Shield on until you draw a weapon",
			Off = "Shield off. You can be attacked.",
		},
	},
}

return CombatFairnessConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CombatFeelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ W2 Combat Core (contracts §2.4): server-side combat feel numbers.

	HeadshotMult   exact server ray on a part named "Head" (players, NPCs); never claim / assist / splash.
	Fx             WeaponFx fan-out (UnreliableRemoteEvent): recipients within RadiusStuds of the shot's origin or
	               end point; per-shooter bucket for bullets (PerShooterHz / Burst), per-recipient bucket for
	               everything. Over a cap the event is dropped, never queued.
	Projectile     server kinematic stepper for WeaponConfig weapons with a Projectile def (RocketLauncher, Grenade).
	Splash         CombatService.ApplyRadiusDamage defaults (line of sight from the blast point to each torso).
	Drawn          RequestSetDrawn remote rate limit and the character attribute it writes.
	ShieldAttribute / DamageNumbersAttribute   replicated attributes (client bubble, damage numbers).
	BlastSourceSeconds  nuke §15.2: a death within this of a blast hit is a "blast death" (quiet kill).
	AimStatsLogSeconds  one aim-resolution summary log line per this many seconds (when the counts changed). ]]

local CombatFeelConfig = {
	HeadshotMult = 1.5, -- exact server ray on a part named "Head" (players, NPCs); never claim / assist / splash
	Fx = {
		Remote = "WeaponFx",
		RadiusStuds = 250,
		PerShooterHz = 20,
		PerShooterBurst = 4,
		PerRecipientHz = 60,
		PerRecipientBurst = 20,
		NpcShots = true,
		NpcMissOffset = { Min = 2, Max = 4 },
	},
	Projectile = { StepHz = 20, MaxLivePerPlayer = 3, MaxLiveServer = 24, SpawnForwardStuds = 1 },
	Splash = {
		RequireLos = true,
		LosLiftStuds = 1,
		DefaultMinMult = 0.25,
		ExcludeClanAllies = true, -- W2 CC-1 addition: an attacker's splash never hurts clan mates (assumption A-CC1-3)
	},
	Drawn = { RemoteRate = 2, RemoteBurst = 4, Attribute = "WE_GunOut" },
	ShieldAttribute = "WE_ShieldUntil", -- character attr: Workspace:GetServerTimeNow() + spawn-invulnerable seconds
	DamageNumbersAttribute = "WE_ShowDamageNumbers", -- player attr from profile.Settings.ShowDamageNumbers (nil = on)
	BlastSourceSeconds = 3, -- nuke §15.2: a death within this of a blast hit is a "blast death"
	AimStatsLogSeconds = 300,
}

return CombatFeelConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ConsoleBuyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v71 console-only structure buying. Owner: "I don't think you should be able to just buy all the items from the
	base dashboard ... you should have to actually go and click the button".

	Base structures (BaseConfig.Structures) are built / upgraded ONLY at that structure's own console (walk-in
	building) or kiosk (outdoor installation) on YOUR plot: the BUY button in the action lane or the console's
	ProximityPrompt. The Base panel is an overview; its row button is GO (shows the way, never buys).

	Server truth (Shared/Util/ConsoleLocator + BaseService.PurchaseUpgrade): the player's HumanoidRootPart, as the
	server sees it, within a CYLINDER around that structure's console part on the player's own plot:
	horizontal (XZ) distance <= PromptDistance + ServerSlack and |dy| <= MaxVerticalOffset (the MissileStrike
	"at the Command Center" check works the same way). Positions come from the real console part, so rotated plots
	(BaseLayout.PlotCFrame / FaceMapCentre) need no math here.

	This is a presence rule for honest clients and the UI, enforced on the server. It is not anti-teleport: the
	character is network-owned by its player, so an exploiter who teleports next to the console meets the rule.
]]

local ConsoleBuyConfig = {
	-- Master switch. false = the server stops checking presence (rollback only). The Base panel stays GO-only.
	Enabled = true,

	-- ProximityPrompt WE_ServerBuyPrompt (UpgradePadService; these were the literals 10 / 16 / 0.35 / 0)
	ConsolePromptDistance = 10, -- console / kiosk MaxActivationDistance (studs, HRP -> console part centre)
	PadPromptDistance = 16, -- legacy walk-over pad (only when BaseLayoutConfig.Enabled = false)
	ConsoleHoldSeconds = 0.35, -- walking past never buys
	PadHoldSeconds = 0,

	-- Server check, horizontal: |HRP - buy point centre|xz <= (ConsolePromptDistance | PadPromptDistance) + ServerSlack.
	-- The client BUY box (WorldPromptController CONSOLE_MARGIN 5) reaches 8.5 studs horizontally, so the slack covers
	-- 9.5 studs of the server's HRP trailing the client: 0.59 s at WalkSpeed 16, 0.37 s with the v126 Speed Boost (25.6), 0.30 s with the v133 x2 (32).
	ServerSlack = 8,
	-- Server check, vertical: |HRP.Y - buy point centre.Y|. Covers the client BUY box (-4.7 .. +9.7) and a jump at the
	-- console (+8.5); refuses the upper floor of a two-storey walk-in (+14.1 above a ground-floor console).
	MaxVerticalOffset = 10,
	RejectSeated = true, -- seated (vehicle / chair) -> refused; the client already hides BUY while seated
	-- With two consoles in range only the nearest buys (horizontal distance). Margin in studs.
	RequireNearest = true,
	NearestMargin = 0.5,
	-- Console part missing on the player's plot (map rebuild in flight): "Deny" (refuse + warn once per plot and
	-- structure) or "Allow" (skip the check). v71 world: 15 / 15 consoles on 6 / 6 plots at L0 and L5.
	NoConsolePolicy = "Deny",

	-- Base panel GO -> waypoint to the console (client Modules/ConsoleWaypoint)
	Waypoint = {
		ArriveRadius = 10, -- cleared when the HRP is this close (the BUY button takes over)
		TimeoutSeconds = 120,
		RetrySeconds = 0.5, -- rebuild / retarget attempts (respawn, console streamed in) at most this often
		BeamWidth0 = 0.22, -- HUD rule: no beam wider than 0.25 or LightEmission above 0.3 outside the tutorial
		BeamWidth1 = 0.12,
		BeamLightEmission = 0.2,
		BeamColor = Color3.fromRGB(240, 214, 110),
		MarkerLift = 3, -- studs above the console top
		-- marker BillboardGui (real px): 14-20 px text (CLAUDE.md world labels), width follows the name length
		MarkerMinWidth = 140,
		MarkerMaxWidth = 300,
		MarkerMinTextPx = 14,
		MarkerMaxTextPx = 20,
		RefreshHz = 10, -- arrival check + distance label (CLAUDE.md: UI refresh <= 10 Hz)
	},

	Text = {
		NotAtConsole = "Go to your %s console to buy it", -- %s = BaseConfig DisplayName
		PanelSubtitle = "Buy at each building's console. GO shows the way.",
		Go = "GO",
		Max = "MAX",
		Needs = "Needs %s Lv %d", -- locked row: first unmet requirement
		Build = "Build %s", -- %s = cost
		Upgrade = "Lv %d -> %d  %s",
		WaypointSet = "Follow the line to the %s console",
		NoConsole = "Can't find that console yet. Try again in a moment.",
	},
}

return ConsoleBuyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DailyOpsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Daily Ops: short, gold-forward objectives. MissionService offers Picks of them each UTC day, above the daily
	missions, while Enabled.

	W3 step 2, lane M0 (spec w3s2 §6 Phase A): the pool grows by three "job" ops and the offer rotates.
	- Slot 1 is a job op: FirstJob once the player's level allows it, otherwise one of OtherJobs (seeded).
	- The other slots rotate through the rest of the pool, seeded by (UserId, UTC day): stable for the day, nothing
	  saved, and every unlocked op comes round within a few days.
	- An op is offered only when MissionConfig.LiveObjectives lists its ObjectiveType and, with a Required Go, while
	  the server has a target for it. DailyOpCheckpoint and DailyOpJobs therefore wait for Phase B (OpsService).
	- Copy is device-neutral (no key names, no "tap" / "click"); the job ops' descriptions stay within 28 characters.

	W3 step 2 Phase B, lane M1: the job ops Checkpoint / Jobs / Camp / Uplink / Cargo count OpsService's jobs
	(MissionConfig.OpsObjectives). They are offered only while OpsService's hook reports the job live, so nothing
	changes before the Ops cutover. Their GO points at the nearest Open site of the kind (never a fixed marker).
]]

export type DailyOpDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string, -- CaptureTerritory | KillNPC | RecruitSoldiers | Heist | Checkpoint | Job | Camp | Uplink | Delivery
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number,
	MinLevel: number,
	Go: string?, -- a MissionConfig.Go key (GO button while incomplete)
}

local DailyOpsConfig = {
	Enabled = true,
	Picks = 3, -- ops offered per UTC day
	FirstJob = "DailyOpBank", -- slot 1 once its MinLevel is reached (and the bank job is on)
	OtherJobs = { "DailyOpCheckpoint", "DailyOpJobs" }, -- slot 1 below that level (Phase B: once they are live)
	Ops = {
		{
			Id = "DailyOpCapture",
			DisplayName = "Daily Op: Seize",
			Description = "Capture 2 territories or oil platforms.",
			ObjectiveType = "CaptureTerritory",
			Target = 2,
			RewardCash = 5000,
			RewardXP = 100,
			RewardGold = 3,
			MinLevel = 1,
		},
		{
			Id = "DailyOpKillNPC",
			DisplayName = "Daily Op: Clear Hostiles",
			Description = "Eliminate 15 NPC hostiles.",
			ObjectiveType = "KillNPC",
			Target = 15,
			RewardCash = 3500,
			RewardXP = 90,
			RewardGold = 2,
			MinLevel = 1,
			Go = "Hostiles", -- GO once OpsService has an Open checkpoint or camp
		},
		{
			Id = "DailyOpRecruit",
			DisplayName = "Daily Op: Muster",
			Description = "Recruit 10 soldiers at the Training Yard.",
			ObjectiveType = "RecruitSoldiers",
			Target = 10,
			RewardCash = 2500,
			RewardXP = 70,
			RewardGold = 2,
			MinLevel = 1,
		},
		-- W3 step 2 job ops
		{
			Id = "DailyOpBank",
			DisplayName = "Daily Op: Rob the Bank",
			Description = "Loot the Empire Bank vault",
			ObjectiveType = "Heist",
			Target = 1,
			RewardCash = 6000,
			RewardXP = 150,
			RewardGold = 4,
			MinLevel = 3,
			Go = "Bank",
		},
		{
			Id = "DailyOpCheckpoint",
			DisplayName = "Daily Op: Take 2 Checkpoints",
			Description = "Take 2 enemy checkpoints",
			ObjectiveType = "Checkpoint", -- live only through OpsService (MissionConfig.OpsObjectives)
			Target = 2,
			RewardCash = 4000,
			RewardXP = 100,
			RewardGold = 2,
			MinLevel = 2,
			Go = "Checkpoint",
		},
		{
			Id = "DailyOpJobs",
			DisplayName = "Daily Op: Finish 3 Jobs",
			Description = "Finish 3 jobs anywhere",
			ObjectiveType = "Job", -- live only through OpsService (MissionConfig.OpsObjectives)
			Target = 3,
			RewardCash = 5000,
			RewardXP = 120,
			RewardGold = 3,
			MinLevel = 2,
			Go = "Job",
		},
		-- W3 step 2 Phase B (lane M1): more job ops, live only through OpsService
		{
			Id = "DailyOpCamp",
			DisplayName = "Daily Op: Raid a Camp",
			Description = "Raid 1 enemy camp",
			ObjectiveType = "Camp",
			Target = 1,
			RewardCash = 4000,
			RewardXP = 100,
			RewardGold = 2,
			MinLevel = 2,
			Go = "Camp",
		},
		{
			Id = "DailyOpUplink",
			DisplayName = "Daily Op: Hack an Uplink",
			Description = "Hack and hold 1 uplink",
			ObjectiveType = "Uplink",
			Target = 1,
			RewardCash = 5000,
			RewardXP = 120,
			RewardGold = 3,
			MinLevel = 3,
			Go = "Uplink",
		},
		{
			Id = "DailyOpCargo",
			DisplayName = "Daily Op: Haul Cargo",
			Description = "Bring 1 haul to your base",
			ObjectiveType = "Delivery",
			Target = 1,
			RewardCash = 5000,
			RewardXP = 120,
			RewardGold = 3,
			MinLevel = 3,
			Go = "Cargo", -- offered once OpsService answers the Cargo key (the heist yards and the black box)
		},
	} :: { DailyOpDef },
}

return DailyOpsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DailyRewardConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ 7-day login streak; day 7 resets streak after claim. Field names match MissionService. ]]

local AdminConfig = require(script.Parent.AdminConfig)

local DailyRewardConfig = {
	Rewards = {
		{ Day = 1, Cash = 1000, Gold = 0, XP = 25 },
		{ Day = 2, Cash = 2000, Gold = 0, XP = 40 },
		{ Day = 3, Cash = 3500, Gold = 1, XP = 60 },
		{ Day = 4, Cash = 5000, Gold = 0, XP = 80 },
		{ Day = 5, Cash = 7500, Gold = 2, XP = 100 },
		{ Day = 6, Cash = 10000, Gold = 0, XP = 125 },
		{ Day = 7, Cash = 20000, Gold = 10, XP = 200 },
	},
	StreakResetsAfterDay = 7,
	MissedDayResetsStreak = true,
	--[[ claude-bud JOB 4.2 (2026-09-29): the streak is claimed FOR the player DelaySeconds after the save loads (no
		panel to find, no tap), through the same server claim (MissionService.ClaimDailyLogin: once per UTC day, saved
		in the profile's DailyLogin), then one toast "Day N of 7: +$X. Tomorrow: $Y". Rollout "owner" =
		AdminConfig.IsPlaytestOwner only, "all", anything else = off (claim from the Missions panel only, as before). ]]
	AutoClaim = {
		Rollout = "all", -- v101
		DelaySeconds = 8,
	},
	--[[ claude-bud JOB 29 (2026-09-30): streak visibility.
		ShowTomorrow (kill switch, everyone): wherever the streak is shown, tomorrow's reward is shown too (the Missions
		panel's daily row, the auto-claim toast, the streak card).
		StreakCard (OwnerFirst first): the auto-claim shows ONE card with the 7-day strip (today lit, BigDays gold) and
		"Come back tomorrow for $Y" instead of two text toasts; the Missions panel shows the same strip plus 1-2
		"tomorrow" goals; day 7 also gives Day7Boost (army damage x Mult for Minutes; profile.ArmyBoostUntil; no Robux).
		The card waits while WE_Onboarding is on (FastStart). Both off = the JOB 4.2 toasts exactly as before. ]]
	ShowTomorrow = true,
	StreakCard = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
	},
	BigDays = { [3] = true, [7] = true } :: { [number]: boolean },
	CardSeconds = 6,
	Day7Boost = { Enabled = true, Mult = 1.25, Minutes = 30, Label = "ARMY BOOST" },
	--[[ claude-bud JOB 49 part A (2026-10-01): reasons to come back. Each block is owner-first (RetentionConfig.Live);
		OFF == the streak exactly as above.
		Grace: ONE missed UTC day per 7-day cycle keeps the streak (the strip marks that day SAVED); a second miss in
		the cycle, or a gap longer than MissedDaysAllowed, resets to Day 1 as before. Saved: DailyLogin.Cycle /
		GraceUsedCycle / GraceDay.
		Day7Scale: Day 7 pays max(the table's cash, IncomeMinutes x his income per minute), on the server at the claim
		(MonetizationService.PassivePerMin, the time-pack formula, timed boosts excluded); the table stays the floor.
		Calendar: the strip carries the REAL time to the next UTC claim day (the server's clock with the payload) and
		the SAVED mark; a new player's first streak card comes after the Guided chain's reward or at the latest at
		FirstCardSeconds of play (and the client still waits out combat / driving / panels). ]]
	Grace = {
		Enabled = true,
		OwnerFirst = false, -- Code Bot v177 (Shaun approved 2026-10-01): everyone (was NEW-OWNER-FIRST, claude-bud JOB 49)
		MissedDaysAllowed = 1,
		PerCycle = 1,
	},
	Day7Scale = {
		Enabled = true,
		OwnerFirst = false, -- Code Bot v177 (Shaun approved 2026-10-01): everyone (was NEW-OWNER-FIRST, claude-bud JOB 49)
		IncomeMinutes = 60,
	},
	Calendar = {
		Enabled = true,
		OwnerFirst = false, -- Code Bot v177 (Shaun approved 2026-10-01): everyone (was NEW-OWNER-FIRST, claude-bud JOB 49)
		FirstCardSeconds = 150, -- the latest a new player's first streak card waits for the onboarding hold
	},
}

-- claude-bud: is auto-claim live for this player (fail closed)
function DailyRewardConfig.AutoClaimLiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("DailyAutoClaim") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = DailyRewardConfig.AutoClaim.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return AdminConfig.IsPlaytestOwner(userId)
	end
	return false
end

-- claude-bud JOB 49: is a JOB 49 streak block ("Grace" | "Day7Scale" | "Calendar") live for this player
function DailyRewardConfig.Live(block: string, userId: any): boolean
	local b = (DailyRewardConfig :: any)[block]
	return typeof(b) == "table" and (require(script.Parent.RetentionConfig) :: any).Live(b, userId)
end

-- claude-bud JOB 49: the UTC unix time of the next claim day (the next 00:00 UTC after `now`)
function DailyRewardConfig.NextClaimUnix(now: number): number
	return (math.floor(now / 86400) + 1) * 86400
end

-- claude-bud JOB 29: is the streak card / strip / day-7 boost live for this player (fail closed)
function DailyRewardConfig.ShowTomorrowLiveFor(userId: any): boolean
	if DailyRewardConfig.ShowTomorrow ~= true then
		return false
	end
	return (require(script.Parent.RetentionConfig) :: any).Live(DailyRewardConfig.StreakCard, userId)
end

return DailyRewardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DevConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Studio-only flags. Production ignores unless RunService:IsStudio().

	Test / playtest helpers (Studio):
	- SkipTutorial = true  → profile.TutorialComplete on load (no tutorial UI)
	- StudioBoostCash      → set Cash to StudioBoostCashAmount on load
	- FastPassiveIncome    → passive tick every 1s instead of EconomyConfig tick
	- UnlockAllVehicles / UnlockAllWeapons → grant all on load
	- VerboseLogging       → extra Bootstrap prints

	Admin remotes (AdminConfig.UserIds only), via RequestAdminCommand:
	  givecash <n>, givegold <n>, givexp <n>, setlevel <n>, unlockall, resetbase,
	  resettutorial, grantpass <PassKey>, prestige/forceprestige, createclan/joinclan/leaveclan, bpxp, grantpremium
	v71 money (AdminConfig.MoneyCommands; admin allowlist, or any player in Studio; each logs ADMIN_COMMAND and replies
	"not built yet" until its service exists):
	  grantent <key>, givenuke <n> [tactical], nukecd, vhp <pct>, setprestige <n>, openzone <id>, resetrebirth
]]

local DevConfig = {
	StudioBoostCash = false,
	StudioBoostCashAmount = 100000,
	-- false so interactive tutorial can be playtested; set true to skip in Studio
	SkipTutorial = false,
	UnlockAllVehicles = false,
	UnlockAllWeapons = false,
	VerboseLogging = true,
	FastPassiveIncome = false, -- if true, tick every 1s (Studio only)
	-- Studio-only: treat listed GamePass keys as owned when product Id is still 0
	MockOwnedGamePasses = {
		-- VIP = true,
		-- DoubleCash = true,
		-- DoubleXP = true,
		-- v71 money (M2): keys the premium vehicle / rebirth workflows add to MonetizationConfig.GamePasses (M1).
		-- Uncomment only for a Studio test once those keys exist; live servers ignore this table.
		-- PV_Razorfang = true,
		-- PV_Bastion = true,
		-- PV_Warlord = true,
		-- PV_MotorPool = true, -- bundle: all three ground cars
		-- PV_Stormwing = true, -- M6b
		-- PV_Tidebreaker = true, -- M6b
		-- RebirthBoost = true,
	} :: { [string]: boolean },

	--[[ Studio / laptop PERF (phase-7)
		StudioSkipWorldDressing = true → MapSetup skips MapDressing entirely in Studio
		  (BIGGEST Play Solo win). Override: set Workspace attribute ForceDress=true
		  OR StudioForceDress=true below, then resetmap / delete WarEmpireSetup + Play.
		WorldDressQuality = "Low" when dressing does run (live or ForceDress): ~60–70% fewer clusters.
		StudioSparseFlora = true → drastic DesertFlora cut in Studio.
		MountainRingSegments = 14 (12–16 band); live can raise later.
	]]
	StudioSkipWorldDressing = true,
	StudioForceDress = false,
	WorldDressQuality = "Low", -- "Low" | "Full"
	StudioSparseFlora = true,
	MountainRingSegments = 14,
}

return DevConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DockKitConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	fb4 harbour (owner 2026-09-28, phone screenshots of his base dock: "The default boat in the dock looks terrible, make
	it look like a real boat" and "The building beside the dock same thing should look like a legit dock building").

	The Naval Dock's Part kit (StructureKitBuilder kit "dock"): a paved quay along the basin with bollards and tyre
	fenders, a red-brick harbour warehouse (pitched roof with gables, roller doors), a grey patrol boat moored alongside
	(flared pointed bow, black boot-top, wheelhouse with a glass band, mast, bow gun, mooring lines), then a quay crane,
	lamp posts, cargo, a harbour control tower, stacked containers and a harbour launch as the Dock levels up.
	Enabled = false builds the old v35 / v37 kit (pier slab, grey shed, 5-block parked boat) exactly as before.

	Rules this kit keeps (CLAUDE.md):
	  - Own Part kit only: no catalog model, no mesh, 0 new load attempts (PreferMesh stays OFF for structure kits).
	  - No text, no SurfaceGui, no light, no Neon, no Humanoid, no markings on the boat (no numbers, flags or insignia).
	  - Parts: 86 pieces + the hidden Body and boat host = 88 per base (the old kit had 24: +64 per base at L5). The
	    biggest level-up (L1) shows 47 of them (57 instance changes with the Dock's gates and signs; target 60).
	    Nothing is created or destroyed on a purchase: every piece is built once with the kit and BaseService only
	    shows it (Transparency) and gives it its collision at its MinLevel (L5 also adds the usual WE_MaxSmoke).

	Kit frame (the Dock's site frame, BaseLayoutConfig.Structures.Dock: site (78, -112), Yaw 90), in studs:
	  X along the quay, + toward the sea gate (plot -Z);   Z across the quay, + toward the water (plot +X);
	  Y = the piece's CENTRE height above the plot pad top (the water surface is at +0.5, the basin kerb top at +1.0).
  What a piece stands on sets its bottom: on the quay (kit z 4 .. 23.8) the QuayDeck top at +0.4; landward of the
  quay (kit z < 4: the warehouse yard, the gable-end cargo, the containers) the bare pad top at 0. So a crate of
  height h on the pad has Y = h / 2 (a BuyPathStatic rule checks every low piece rests on one or the other).
	  Pos is the piece's centre; Rot = CFrame.Angles(X, Y, Z) in degrees; a piece with From / To is a beam (rope, jib):
	  a Size.X x Size.Y section stretched from From to To.
	  Shape: "Block" | "Wedge" (Roblox WedgePart: tall face at local +Z, slope down toward -Z) | "Cylinder" (axis along
	  local X) | "Ball".
	  Landmarks in this frame: basin water z >= 25 (kerb z 23.8 .. 25, x -35.6 .. 35.6); inner Dock gate x -52,
	  z 6 .. 22; helipad z <= -24; sea-gate guard (38, 20); sandbag berm (38, 2); sea gate lane x >= 35, z 30 .. 70.
	  Nothing in the kit reaches past kit z 33.5 (the moored strip): the open basin, where driven boats spawn (z >= 34)
	  and sail, has no kit part in it at any height. Every solid (Collide) piece stays inside kit x -48 .. 34 (the
	  QuayDeck's span: off the Dock gate lane, the sea-gate guard, the berm and the sea-gate lane land) and at kit
	  z >= -20 (off the helipad).

	MinLevel: the Dock level that shows the piece (0 = from the kit build: the quay is base infrastructure like the
	basin and its kerb). Collide = CanCollide + CanQuery (walkable quay, solid warehouse / hull / tower / containers;
	a solid hull is "land" to a driven boat's probe, like the kerb, and a spawn never overlaps it). Everything else is
	decor: CanCollide, CanQuery and CanTouch off. Shadow = CastShadow (the big volumes only).
]]

export type DockPiece = {
	Name: string,
	Shape: string?, -- default "Block"
	Size: Vector3,
	Pos: Vector3?, -- centre (Y above the pad top); nil for a From / To beam
	Rot: Vector3?, -- degrees, CFrame.Angles(X, Y, Z)
	From: Vector3?,
	To: Vector3?,
	Color: Color3,
	Material: Enum.Material,
	MinLevel: number,
	Collide: boolean?,
	Shadow: boolean?,
	Transparency: number?, -- when shown (default 0; 1 = always hidden)
}

local C = Color3.fromRGB
local M = Enum.Material
local V = Vector3.new

-- palette
local BRICK = C(150, 86, 66)
local ROOF = C(80, 96, 110)
local CONCRETE = C(156, 152, 142)
local TRIM = C(212, 204, 186)
local GLASS = C(58, 88, 112)
local DOOR = C(58, 78, 96)
local HULL = C(92, 102, 112) -- dark naval grey
local BOOT = C(34, 36, 38)
local CRANE = C(226, 176, 44)
local ROPE = C(196, 176, 130)
local DARK = C(40, 42, 44)

-- roof pitch: walls 10 high, ridge +4 at z = -5, eaves 0.8 past the walls (z 4.8 / -14.8)
local PITCH = math.deg(math.atan(4 / 9.8))
local ROOF_LEN = math.sqrt(9.8 * 9.8 + 4 * 4) + 0.3
local ROOF_DY = 0.225 * math.cos(math.rad(PITCH))
local ROOF_DZ = 0.225 * math.sin(math.rad(PITCH))

-- crane jib: from the cab, luffed up over the harbour launch's berth (L4). The tip stays over the moored strip
-- (kit z <= 33) and the hook hangs 15+ studs up, so nothing hangs in the open basin where driven boats sail. The crane
-- stands at the sea-gate end of the quay (x 22), clear of the car-sized lane along the quay in front of the warehouse.
local JIB_FROM = V(22, 11.8, 22.8)
local JIB_TIP = V(21, 20.6, 29.4)

local pieces: { DockPiece } = {
	-- ── L0 quay (base infrastructure, with the basin): paved apron from the Dock gate lane to the kerb ───────────
	{ Name = "QuayDeck", Size = V(82, 0.8, 19.8), Pos = V(-7, 0, 13.9), Color = CONCRETE, Material = M.Concrete, MinLevel = 0, Collide = true },
	{ Name = "QuayEdgeLine", Size = V(70.4, 0.06, 0.45), Pos = V(0, 0.43, 22.9), Color = C(226, 184, 52), Material = M.SmoothPlastic, MinLevel = 0 },
	{ Name = "Bollard", Shape = "Cylinder", Size = V(1.3, 1.1, 1.1), Pos = V(-26, 1.05, 22.6), Rot = V(0, 0, 90), Color = DARK, Material = M.Metal, MinLevel = 0 },
	{ Name = "Bollard", Shape = "Cylinder", Size = V(1.3, 1.1, 1.1), Pos = V(-12, 1.05, 22.6), Rot = V(0, 0, 90), Color = DARK, Material = M.Metal, MinLevel = 0 },
	{ Name = "Bollard", Shape = "Cylinder", Size = V(1.3, 1.1, 1.1), Pos = V(14, 1.05, 22.6), Rot = V(0, 0, 90), Color = DARK, Material = M.Metal, MinLevel = 0 },
	{ Name = "Bollard", Shape = "Cylinder", Size = V(1.3, 1.1, 1.1), Pos = V(28, 1.05, 22.6), Rot = V(0, 0, 90), Color = DARK, Material = M.Metal, MinLevel = 0 },

	-- ── L1 harbour warehouse: x -15 .. 13, z -14 .. 4 (front on the quay), walls 10, ridge 14 along X ──────────────
	{ Name = "WarehouseBlock", Size = V(28, 10, 18), Pos = V(-1, 5, -5), Color = BRICK, Material = M.Brick, MinLevel = 1, Collide = true, Shadow = true },
	{ Name = "WarehousePlinth", Size = V(28.3, 1.2, 18.3), Pos = V(-1, 0.6, -5), Color = C(118, 114, 106), Material = M.Concrete, MinLevel = 1 },
	{ Name = "WarehouseRoof", Size = V(29.6, 0.45, ROOF_LEN), Pos = V(-1, 12 + ROOF_DY, -0.1 + ROOF_DZ), Rot = V(PITCH, 0, 0), Color = ROOF, Material = M.Metal, MinLevel = 1, Collide = true, Shadow = true },
	{ Name = "WarehouseRoof", Size = V(29.6, 0.45, ROOF_LEN), Pos = V(-1, 12 + ROOF_DY, -9.9 - ROOF_DZ), Rot = V(-PITCH, 0, 0), Color = ROOF, Material = M.Metal, MinLevel = 1, Collide = true, Shadow = true },
	{ Name = "WarehouseRidge", Size = V(29.8, 0.5, 0.9), Pos = V(-1, 14.25, -5), Color = C(62, 70, 78), Material = M.Metal, MinLevel = 1 },
	{ Name = "WarehouseGable", Shape = "Wedge", Size = V(0.5, 4, 9), Pos = V(-14.75, 12, -0.5), Rot = V(0, 180, 0), Color = BRICK, Material = M.Brick, MinLevel = 1, Collide = true },
	{ Name = "WarehouseGable", Shape = "Wedge", Size = V(0.5, 4, 9), Pos = V(-14.75, 12, -9.5), Color = BRICK, Material = M.Brick, MinLevel = 1, Collide = true },
	{ Name = "WarehouseGable", Shape = "Wedge", Size = V(0.5, 4, 9), Pos = V(12.75, 12, -0.5), Rot = V(0, 180, 0), Color = BRICK, Material = M.Brick, MinLevel = 1, Collide = true },
	{ Name = "WarehouseGable", Shape = "Wedge", Size = V(0.5, 4, 9), Pos = V(12.75, 12, -9.5), Color = BRICK, Material = M.Brick, MinLevel = 1, Collide = true },
	-- quay front: two roller doors, a side door, a cream lintel band
	{ Name = "RollerDoor", Size = V(7, 7.6, 0.25), Pos = V(-8.5, 4.2, 4.12), Color = C(182, 186, 188), Material = M.Metal, MinLevel = 1 },
	{ Name = "RollerDoor", Size = V(7, 7.6, 0.25), Pos = V(2.5, 4.2, 4.12), Color = C(182, 186, 188), Material = M.Metal, MinLevel = 1 },
	{ Name = "WarehouseDoor", Size = V(2.4, 5.2, 0.2), Pos = V(9.5, 3, 4.1), Color = DOOR, Material = M.Metal, MinLevel = 1 },
	{ Name = "LintelBand", Size = V(28.1, 0.7, 0.3), Pos = V(-1, 8.6, 4.1), Color = TRIM, Material = M.Concrete, MinLevel = 1 },
	-- gable end toward the Dock gate (the first thing a player sees walking in): door, window, round vent
	{ Name = "WarehouseDoor", Size = V(0.2, 5.2, 2.4), Pos = V(-15.1, 2.6, -2), Color = DOOR, Material = M.Metal, MinLevel = 1 },
	{ Name = "WarehouseWindow", Size = V(0.2, 2.2, 5), Pos = V(-15.1, 6.2, -9), Color = GLASS, Material = M.Glass, MinLevel = 1 },
	{ Name = "GableVent", Shape = "Cylinder", Size = V(0.3, 2.2, 2.2), Pos = V(-15.05, 11.6, -5), Color = C(52, 58, 62), Material = M.Metal, MinLevel = 1 },
	{ Name = "WarehouseWindow", Size = V(22, 1.6, 0.2), Pos = V(-1, 7.4, -14.1), Color = GLASS, Material = M.Glass, MinLevel = 1 },
	{ Name = "WarehouseWindow", Size = V(0.2, 2.2, 5), Pos = V(13.1, 6.2, -5), Color = GLASS, Material = M.Glass, MinLevel = 1 },

	-- ── L1 moored patrol boat: bow toward the sea gate (+X), centreline z 29, beam 6, stern x -10, bow tip x 13 ─────
	-- black boot-top at the waterline, dark grey topsides, a raised forecastle with the bow gun, a flared pointed bow
	-- (two wedges lying flat, overhanging the waterline like a raked stem), a pale wheelhouse with a glass band. The
	-- wheelhouse is at player scale: 6 high over the deck (+2.4 .. +8.4), so a 5-stud avatar on deck stands below its
	-- roof, the window band (+6.3 .. +7.8) is at his eye line, and the mast rises from the roof.
	{ Name = "BoatBoot", Size = V(18.04, 0.9, 6.04), Pos = V(-1, 0.45, 29), Color = BOOT, Material = M.SmoothPlastic, MinLevel = 1, Collide = true },
	{ Name = "BoatHull", Size = V(13, 1.5, 6), Pos = V(-3.5, 1.65, 29), Color = HULL, Material = M.Metal, MinLevel = 1, Collide = true, Shadow = true },
	{ Name = "BoatForecastle", Size = V(5, 2.3, 6), Pos = V(5.5, 2.05, 29), Color = HULL, Material = M.Metal, MinLevel = 1, Collide = true, Shadow = true },
	{ Name = "BoatBow", Shape = "Wedge", Size = V(2.3, 5, 3), Pos = V(10.5, 2.05, 27.5), Rot = V(0, 0, -90), Color = HULL, Material = M.Metal, MinLevel = 1, Collide = true },
	{ Name = "BoatBow", Shape = "Wedge", Size = V(2.3, 5, 3), Pos = V(10.5, 2.05, 30.5), Rot = V(180, 0, -90), Color = HULL, Material = M.Metal, MinLevel = 1, Collide = true },
	-- raked forefoot: the black boot-top sweeps up under the bow overhang (flat top at the bow's underside, slope from
	-- the waterline at x 8 up to x 11.6), so from the side the bow rises out of the water instead of ending square
	{ Name = "BoatStem", Shape = "Wedge", Size = V(1.8, 0.9, 3.6), Pos = V(9.8, 0.45, 29), Rot = V(180, -90, 0), Color = BOOT, Material = M.SmoothPlastic, MinLevel = 1 },
	-- black rubbing strake round the hull just under the deck edge: a sheer line along the flat grey side and stern
	{ Name = "BoatStrake", Size = V(18.1, 0.2, 6.12), Pos = V(-1.03, 2.2, 29), Color = DARK, Material = M.Rubber, MinLevel = 1 },
	{ Name = "BoatDeck", Size = V(12.6, 0.12, 5.6), Pos = V(-3.7, 2.46, 29), Color = C(78, 84, 88), Material = M.DiamondPlate, MinLevel = 1 },
	-- the quay-side bulwark has a boarding gap (x -8.6 .. -6.4) where the gangway comes aboard
	{ Name = "BoatBulwark", Size = V(1.4, 0.7, 0.18), Pos = V(-9.3, 2.75, 26.09), Color = HULL, Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatBulwark", Size = V(9.4, 0.7, 0.18), Pos = V(-1.7, 2.75, 26.09), Color = HULL, Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatBulwark", Size = V(13, 0.7, 0.18), Pos = V(-3.5, 2.75, 31.91), Color = HULL, Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatWheelhouse", Size = V(6, 6, 4.4), Pos = V(-1.5, 5.4, 29), Color = C(206, 210, 210), Material = M.Metal, MinLevel = 1, Collide = true, Shadow = true },
	{ Name = "BoatBridgeGlass", Size = V(6.12, 1.5, 4.52), Pos = V(-1.5, 7.05, 29), Color = C(40, 62, 82), Material = M.Glass, MinLevel = 1 },
	{ Name = "BoatWheelhouseRoof", Size = V(6.8, 0.3, 5), Pos = V(-1.3, 8.55, 29), Color = C(150, 156, 160), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatMast", Size = V(0.3, 4.2, 0.3), Pos = V(-2.5, 10.8, 29), Color = C(220, 220, 220), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatRadarBar", Size = V(0.25, 0.2, 2.4), Pos = V(-2.5, 11.9, 29), Color = DARK, Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatMastLight", Shape = "Ball", Size = V(0.45, 0.45, 0.45), Pos = V(-2.5, 13.1, 29), Color = C(250, 248, 236), Material = M.SmoothPlastic, MinLevel = 1 },
	{ Name = "BoatBowRail", Size = V(0.12, 0.12, 1), From = V(3.2, 3.9, 26.25), To = V(12.2, 4.25, 28.8), Color = C(200, 204, 206), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatBowRail", Size = V(0.12, 0.12, 1), From = V(3.2, 3.9, 31.75), To = V(12.2, 4.25, 29.2), Color = C(200, 204, 206), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatGunMount", Shape = "Cylinder", Size = V(0.7, 1.4, 1.4), Pos = V(5.8, 3.55, 29), Rot = V(0, 0, 90), Color = C(110, 116, 122), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatGunBarrel", Shape = "Cylinder", Size = V(2.8, 0.3, 0.3), Pos = V(7.5, 3.95, 29), Color = C(58, 62, 66), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatExhaust", Size = V(1.2, 1.4, 1.6), Pos = V(-6, 3.1, 29), Color = C(60, 64, 68), Material = M.Metal, MinLevel = 1 },
	{ Name = "BoatLifeRing", Shape = "Cylinder", Size = V(0.15, 1.1, 1.1), Pos = V(-0.5, 4.3, 26.72), Rot = V(0, 90, 0), Color = C(230, 110, 40), Material = M.SmoothPlastic, MinLevel = 1 },
	-- three hanging fenders on the quay side (clear of the gangway, x -8.4 .. -6.6), a gangway from the quay onto the aft
	-- deck through the bulwark's boarding gap (walkable), two mooring lines
	{ Name = "BoatFender", Shape = "Cylinder", Size = V(1.5, 0.7, 0.7), Pos = V(-5.5, 1.6, 25.65), Rot = V(0, 0, 90), Color = C(40, 48, 60), Material = M.Rubber, MinLevel = 1 },
	{ Name = "BoatFender", Shape = "Cylinder", Size = V(1.5, 0.7, 0.7), Pos = V(-1, 1.6, 25.65), Rot = V(0, 0, 90), Color = C(40, 48, 60), Material = M.Rubber, MinLevel = 1 },
	{ Name = "BoatFender", Shape = "Cylinder", Size = V(1.5, 0.7, 0.7), Pos = V(4.5, 1.6, 25.65), Rot = V(0, 0, 90), Color = C(40, 48, 60), Material = M.Rubber, MinLevel = 1 },
	{ Name = "Gangway", Size = V(1.8, 0.2, 1), From = V(-7.5, 0.55, 21.6), To = V(-7.5, 2.55, 27.4), Color = C(120, 124, 126), Material = M.DiamondPlate, MinLevel = 1, Collide = true },
	{ Name = "MooringLine", Size = V(0.18, 0.18, 1), From = V(-9, 2.6, 26.4), To = V(-12, 1.55, 22.6), Color = ROPE, Material = M.Fabric, MinLevel = 1 },
	{ Name = "MooringLine", Size = V(0.18, 0.18, 1), From = V(7.5, 3.3, 26.4), To = V(14, 1.55, 22.6), Color = ROPE, Material = M.Fabric, MinLevel = 1 },

	-- ── L2 quay crane (sea-gate end of the quay, jib over the launch berth), lamp posts, cargo at the gable end ─────────
	-- (the crates and drums stand on the bare pad by the gable end, landward of the quay: bottom at 0)
	{ Name = "CranePedestal", Shape = "Cylinder", Size = V(9, 2.4, 2.4), Pos = V(22, 4.9, 21.5), Rot = V(0, 0, 90), Color = CRANE, Material = M.Metal, MinLevel = 2, Collide = true },
	{ Name = "CraneCab", Size = V(3.6, 3, 4.4), Pos = V(22, 10.9, 21), Color = CRANE, Material = M.Metal, MinLevel = 2, Shadow = true },
	{ Name = "CraneCounterweight", Size = V(3.2, 2.2, 2.2), Pos = V(22, 10.5, 17.9), Color = C(92, 94, 96), Material = M.Concrete, MinLevel = 2 },
	{ Name = "CraneJib", Size = V(0.9, 0.9, 1), From = JIB_FROM, To = JIB_TIP, Color = CRANE, Material = M.Metal, MinLevel = 2 },
	{ Name = "CraneCable", Size = V(0.12, 4.2, 0.12), Pos = V(JIB_TIP.X, JIB_TIP.Y - 2.1, JIB_TIP.Z), Color = DARK, Material = M.Metal, MinLevel = 2 },
	{ Name = "CraneHook", Size = V(0.9, 1, 0.9), Pos = V(JIB_TIP.X, JIB_TIP.Y - 4.7, JIB_TIP.Z), Color = C(40, 40, 40), Material = M.Metal, MinLevel = 2 },
	{ Name = "LampPost", Size = V(0.35, 9, 0.35), Pos = V(-31, 4.9, 22.2), Color = C(72, 76, 78), Material = M.Metal, MinLevel = 2 },
	{ Name = "LampHead", Size = V(0.7, 0.35, 1.8), Pos = V(-31, 9.4, 21.6), Color = C(230, 226, 206), Material = M.SmoothPlastic, MinLevel = 2 },
	{ Name = "LampPost", Size = V(0.35, 9, 0.35), Pos = V(4, 4.9, 21.8), Color = C(72, 76, 78), Material = M.Metal, MinLevel = 2 },
	{ Name = "LampHead", Size = V(0.7, 0.35, 1.8), Pos = V(4, 9.4, 21.2), Color = C(230, 226, 206), Material = M.SmoothPlastic, MinLevel = 2 },
	{ Name = "CargoCrate", Size = V(2.4, 2.4, 2.4), Pos = V(-17.5, 1.2, -8.4), Color = C(156, 120, 78), Material = M.WoodPlanks, MinLevel = 2, Collide = true },
	{ Name = "CargoCrate", Size = V(2, 2, 2), Pos = V(-17.4, 3.4, -8.2), Rot = V(0, 18, 0), Color = C(146, 112, 72), Material = M.WoodPlanks, MinLevel = 2, Collide = true },
	{ Name = "FuelDrum", Shape = "Cylinder", Size = V(2.2, 1.5, 1.5), Pos = V(-17.2, 1.1, -5), Rot = V(0, 0, 90), Color = C(52, 92, 62), Material = M.Metal, MinLevel = 2, Collide = true },
	{ Name = "FuelDrum", Shape = "Cylinder", Size = V(2.2, 1.5, 1.5), Pos = V(-17.6, 1.1, -11.6), Rot = V(0, 0, 90), Color = C(150, 58, 44), Material = M.Metal, MinLevel = 2, Collide = true },

	-- ── L3 harbour control tower by the sea gate end of the quay, stacked containers ───────────────────────────────
	-- (the tower stands on the quay: bottom at +0.4; the containers stand on the pad beside the helipad: bottom at 0)
	{ Name = "TowerShaft", Size = V(6, 13, 6), Pos = V(27, 6.9, 10), Color = TRIM, Material = M.Concrete, MinLevel = 3, Collide = true, Shadow = true },
	{ Name = "TowerCab", Size = V(7.6, 3.4, 7.6), Pos = V(27, 15.1, 10), Color = C(226, 228, 226), Material = M.Metal, MinLevel = 3, Collide = true, Shadow = true },
	{ Name = "TowerGlass", Size = V(7.72, 2, 7.72), Pos = V(27, 15.3, 10), Color = GLASS, Material = M.Glass, MinLevel = 3 },
	{ Name = "TowerRoof", Size = V(8.6, 0.45, 8.6), Pos = V(27, 17.03, 10), Color = C(66, 72, 78), Material = M.Metal, MinLevel = 3, Collide = true },
	{ Name = "TowerDoor", Size = V(2.4, 5, 0.2), Pos = V(27, 2.9, 13.1), Color = DOOR, Material = M.Metal, MinLevel = 3 },
	{ Name = "TowerWindow", Size = V(0.2, 6, 1.2), Pos = V(23.9, 7.5, 10), Color = GLASS, Material = M.Glass, MinLevel = 3 },
	{ Name = "TowerMast", Size = V(0.3, 5, 0.3), Pos = V(27, 19.75, 10), Color = C(210, 210, 210), Material = M.Metal, MinLevel = 3 },
	{ Name = "TowerRadar", Size = V(0.3, 0.25, 3.2), Pos = V(27, 21.4, 10), Color = DARK, Material = M.Metal, MinLevel = 3 },
	{ Name = "Container", Size = V(12, 5.2, 5), Pos = V(21, 2.6, 0.2), Color = C(156, 66, 46), Material = M.Metal, MinLevel = 3, Collide = true, Shadow = true },
	{ Name = "Container", Size = V(12, 5.2, 5), Pos = V(21, 2.6, -5.3), Color = C(46, 86, 136), Material = M.Metal, MinLevel = 3, Collide = true, Shadow = true },
	{ Name = "Container", Size = V(12, 5.2, 5), Pos = V(21.6, 7.8, -2.55), Color = C(72, 116, 76), Material = M.Metal, MinLevel = 3, Collide = true, Shadow = true },

	-- ── L4 harbour launch (rigid inflatable) moored under the crane, ahead of the patrol boat ─────────────────────
	{ Name = "LaunchHull", Size = V(7, 0.7, 2.6), Pos = V(21, 0.55, 27.6), Color = C(64, 68, 72), Material = M.Metal, MinLevel = 4, Collide = true },
	{ Name = "LaunchTube", Shape = "Cylinder", Size = V(7.4, 0.9, 0.9), Pos = V(21, 0.95, 26.4), Color = C(46, 50, 54), Material = M.Rubber, MinLevel = 4 },
	{ Name = "LaunchTube", Shape = "Cylinder", Size = V(7.4, 0.9, 0.9), Pos = V(21, 0.95, 28.8), Color = C(46, 50, 54), Material = M.Rubber, MinLevel = 4 },
	{ Name = "LaunchConsole", Size = V(0.9, 1, 1.1), Pos = V(21.5, 1.4, 27.6), Color = C(190, 192, 194), Material = M.Metal, MinLevel = 4 },
	{ Name = "LaunchMotor", Size = V(0.7, 1.4, 0.8), Pos = V(17.2, 1, 27.6), Color = C(30, 32, 34), Material = M.Metal, MinLevel = 4 },

	-- ── L5: gold band on the control cab + an amber beacon on its mast (painted, no light) ─────────────────────────
	{ Name = "TowerGoldBand", Size = V(7.75, 0.3, 7.75), Pos = V(27, 16.62, 10), Color = C(240, 196, 64), Material = M.Metal, MinLevel = 5 },
	{ Name = "TowerBeacon", Shape = "Ball", Size = V(0.8, 0.8, 0.8), Pos = V(27, 22.6, 10), Color = C(255, 176, 48), Material = M.SmoothPlastic, MinLevel = 5 },
	-- warehouse chimney on the landward roof slope. It MUST be named "Roof": BaseService hangs every structure's L5 smoke
	-- plume (WE_MaxSmoke) on the kit child called "Roof", as the old dock kit's shed roof had it.
	{ Name = "Roof", Size = V(1.6, 3.4, 1.6), Pos = V(8, 13.2, -10), Color = C(118, 68, 54), Material = M.Brick, MinLevel = 5 },
}

local DockKitConfig = {
	Enabled = true,
	PadTopY = 0.5, -- the site frame is at the pad centre; the pad is 1 stud thick
	-- StructureKitBuilder's required "Body" (EnsureKit): a concrete core at the warehouse footprint. From L1 it sits
	-- inside the 28 x 10 x 18 warehouse block (BaseService recolours and grows it with the level, up to 24.7 x 1.28 x
	-- 14.4 at L5), so it is hidden there. At L0, before the warehouse shows, it is the Dock's translucent footprint
	-- ghost like every unbought structure's Body (main's v35 dock shows a 24 x 1.4 x 16 ghost there too).
	Body = { Size = V(24, 0.8, 14), Pos = V(-1, 0.4, -5) },
	-- Hidden host inside the hull: StructureKitBuilder.EnsureKit counts a "WE_DressHost*" child as the Dock's dress (no
	-- rebuild loop); no WE_DressVehicle, so no catalog boat is ever hung on it.
	ParkedBoatHost = { Size = V(2.8, 1.2, 2), Pos = V(-1, 1.2, 29) },
	Pieces = pieces,
}

return DockKitConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Economy tuning. See BALANCE.md for design intent.
	First ~10 minutes feel fast; progression slows after.
]]

local EconomyConfig = {
	StartingCash = 10000, -- v55 restore: healthy start (v20 era used 5000; DS v2 fresh profiles get this)
	StartingGold = 0,
	MinCash = 0,
	MinGold = 0,
	MaxCash = 1e15, -- Code Bot v194: was 1_000_000_000 (the $1B wall); matches the 1e15 ceilings in ProfileSchema / XP / Prestige
	MaxGold = 10_000_000,

	-- Passive income: base + sum(structureLevel * rate)
	-- Early-game pacing (first 10 min): start $10k → CC L1 ($1500) immediately →
	-- base $25/tick (~$300/min) + CC $15 → Barracks L1 ($2500) in ~1 min →
	-- then ~$60/tick sustains VehicleDepot / WeaponsFacility without feeling stuck.
	PassiveIncome = {
		TickSeconds = 5,
		BaseCashPerTick = 25, -- alone: ~300/min → Barracks L1 (2500) in ~50s with upgrades help
		-- Per structure level contribution to Cash/tick
		PerLevelRates = {
			CommandCenter = 15,
			Barracks = 20,
			VehicleDepot = 12,
			WeaponsFacility = 10,
			Helipad = 18,
			Dock = 14,
			Airfield = 22,
			DefensiveWalls = 5,
			Watchtowers = 6,
			Radar = 8,
			ResearchLab = 14,
			MissileDefense = 7,
			PowerStation = 16,
			Warehouse = 25,
			SpecialForcesFacility = 20,
		} :: { [string]: number },
	},

	-- Soft caps / multipliers
	PrestigeCashMultiplierPerLevel = 0.10, -- +10% cash gains per prestige (stacking; see PrestigeConfig)
	DailyRewardCashBonus = true,

	-- Capture stipend tuning lives in TerritoryConfig.CaptureStipend
	-- (periodic cash for owned territories / coastal oil).

	-- Contested outpost income: stacks recount from owned territories (stealable).
	-- F3 (owner's 11 features): shown to players as "Empire Tax". Every captured outpost (not the Home Outpost) is one
	-- stack: +MultPerStack on every non-exempt income reason; the player's own Home Outpost (TerritoryConfig.Starter)
	-- adds StarterPct and is never a stack; the total is capped at MaxStacks * MultPerStack (+50 %).
	-- EconomyService.EmpireTaxPct(p) is the whole-number total; it is mirrored (display only, written on change) to
	-- the player attribute Attribute. PersistClaims: saved claims are re-planted on join in any server (Neutral or
	-- NPC-held zones), released when the player leaves, dropped when another online player holds the zone; false =
	-- claims live only in the current server (lane Z switched it on; fb4 capture lane switched it off again: owner
	-- 2026-09-28, a rejoin must never bring an outpost back; TerritoryConfig.ReleaseOnLeave frees a leaver's zones).
	-- Toast args: ToastSecured / ToastLost (total %),
	-- ToastStolenFromYou / ToastStealGain (zone name, total %), ToastClaimHeld (zone name, holder name).
	OutpostIncomeBuff = {
		DisplayName = "Empire Tax",
		MultPerStack = 0.10, -- +10% per stack
		MaxStacks = 5, -- cap +50%
		StarterPct = 5, -- F10: the player's own Home Outpost, whole percent (not a stack)
		Attribute = "WE_EmpireTaxPct", -- player attribute, whole percent (0 = chip hidden)
		PersistClaims = false, -- F3: off since fb4 capture lane (owner: no outpost comes back on rejoin); true = lane Z re-plant
		ToastSecured = "Outpost taken  Empire Tax +%d%%",
		ToastLost = "Outpost lost  Empire Tax +%d%%",
		ToastStolenFromYou = "%s taken  Empire Tax +%d%%",
		ToastStealGain = "Took %s  Empire Tax +%d%%",
		ToastClaimHeld = "%s is held by %s",
		-- Legacy alias kept for older callers
		ToastTemplate = "Outpost secured — +%d%% Income (yours)",
	},

	-- F4 (owner's 11 features): one client-only, owner-only floating label on the nearest own producer (Training Yard,
	-- oil pumps) within RadiusStuds, re-picked ScanHz times a second, pulsing for PulseSeconds on each income tick.
	-- Text sizes are real px (world labels are not UIScaled); MaxDistance in studs (CLAUDE.md: <= 40). Off until
	-- lane Z (the client module ships with it); on since lane Z (reversible).
	ProducerLabels = {
		Enabled = true,
		RadiusStuds = 24,
		ScanHz = 4,
		PulseSeconds = 0.6,
		TextSize = 18,
		SubSize = 14,
		MaxDistance = 24,
	},

	-- PvP ATM raid: touch another player's WE_MoneyCollector to steal PendingCash.
	AtmRaid = {
		Enabled = true,
		StealFraction = 0.10, -- 10% of victim PendingCash
		AtmRaidCooldownSeconds = 60, -- per thief→victim pair
		MaxDistanceStuds = 14, -- server distance check to collector part
		MinStealCash = 1,
		ToastThief = "ATM RAID +$%d (10%%) from %s — 1m cooldown",
		ToastVictim = "ATM RAIDED −10%% by %s (−$%d)",
		ToastCooldown = "ATM raid cooldown — %ds left",
	},

	-- atmprompt (ASSUMPTIONS ATM-6): the ATM's "Collect" ProximityPrompt (MoneyCollectorService; these were literals).
	-- Its keys must differ from the cash plate beside it (ManualDropperConfig.PromptKeyboardKey / PromptGamepadKey:
	-- F / ButtonB): with one shared key and OnePerButton only the closer prompt showed, on PC and on phones. With distinct
	-- keys each is the only prompt on its key there, so both pills show side by side and each key triggers only its own
	-- (BuyPathStatic pins the keys apart). HoldDuration 0 = one tap, as before.
	AtmCollectPrompt = {
		ActionText = "Collect",
		ObjectText = "ATM",
		HoldDuration = 0,
		MaxActivationDistance = 14,
		KeyboardKey = Enum.KeyCode.E,
		GamepadKey = Enum.KeyCode.ButtonX,
		Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton,
	},
	--[[ claude-bud JOB 29 (2026-09-30): OFFLINE EARNINGS. When the save loads, the server pays for the time away since
		the last save was written (profile.LastSeenUnix, os.time(), stamped by DataService on every write). The formula is
		the live passive tick's: BaseService.ComputePassiveIncomePerTick x EconomyService.GetCashMult(player, "passive"),
		once per PassiveIncome.TickSeconds, for the seconds away (capped at CapSeconds), x Share, x (1 + PremiumBonus)
		for Roblox Premium. It is paid straight into PendingCash (the ATM, like the tick) with reason "offline" (the
		multiplier is already in, so never applied twice), then a "Welcome back: +$X while away" card shows.
		No payout: first join (no LastSeenUnix), a negative gap, or a gap under MinSeconds.
		Kill switch: Enabled = false (no payout, no card). OwnerFirst as TutorialConfig.FastStart. No Robux option. ]]
	OfflineEarnings = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
		Share = 0.25,
		CapSeconds = 8 * 3600,
		MinSeconds = 300,
		PremiumBonus = 0.10,
		ShowDelaySeconds = 6, -- the card: after the save loads (and after the onboarding hold)
		--[[ claude-bud JOB 49 part B (2026-10-01): "Welcome back! Collect $X". Owner-first; OFF = the JOB 29 card. The
			card shows the real server amount, the time away and "(capped at N h)"; COLLECT draws the gold line to his
			own ATM (ConsoleWaypoint.ShowAtm: the money is already in the ATM; no travel, no second claim). ]]
		Card = {
			Enabled = true,
			OwnerFirst = false, -- Code Bot v177 (Shaun approved 2026-10-01): everyone (was NEW-OWNER-FIRST, claude-bud JOB 49)
		},
		--[[ claude-bud JOB 49 B: the Robux SIDEGRADE. Code Bot v180 (Shaun approved 2026-10-01): owning the
			MonetizationConfig.GamePasses.OfflineCap2x pass ("2x Offline Cash", 2002664894, 149 R$) makes the cap TIME
			CapMult x CapSeconds (8 h -> 16 h). It never raises Share and gives no combat stat. ]]
		CapBoost = {
			Enabled = true, -- Code Bot v180: live (was false)
			OwnerFirst = false, -- Code Bot v180: everyone (was NEW-OWNER-FIRST, claude-bud JOB 49)
			ProductKey = "OfflineCap2x", -- the GamePasses key (ownership: MonetizationService pass cache)
			CapMult = 2,
		},
	},
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">EndgameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 39 (2026-09-30): ENDGAME PROGRESSION ("always a next goal"), docs/claude-queue/JOB39-endgame-progression.md.
	Owner-first (Live: Enabled + OwnerFirst = true -> UserId 470626172 and Studio). Every system also has its own Parts
	switch, turned on phase by phase (§10). Live.Enabled = false (or a Part false) = today's game exactly: nothing reads
	profile.Endgame, prices are the raw BaseConfig tables and cashMultFor has no Empire factor.

	Phase 1 (this build): Rebirth (the base / business price grows with rebirths) + EmpireLevel (the long +2 %/level
	cash track, bought at the Command Office in the plaza). The later systems' numbers are here already (config
	first); their Parts stay false until their phase ships.

	Pure helpers (no Instances, no services): LiveFor, EmpireCost, EmpireMult, DefenceCost, WorkshopCost, MasteryCost,
	IncomeMinutesPrice, RebirthCostScale, ScaleStructureCost, LifeCost, BlackMarketStock, WeekIndex.
	Every price stays below EconomyConfig.MaxCash (1e15; was 1,000,000,000 before Code Bot v194): tools/sim/run_endgame_test.py checks it.
]]

local RetentionConfig = require(script.Parent.RetentionConfig)
local BaseConfig = require(script.Parent.BaseConfig)

local EndgameConfig = {
	Live = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone (every endgame part)
	},
	-- Code Bot v157 (owner-approved 2026-10-01): a part listed here is live for EVERY player while Live.OwnerFirst keeps
	-- every other part owner-only. It still needs Live.Enabled and its own Parts switch (either false = off for all).
	PublicParts = {
		BlackMarket = true, -- the weekly Black Market (cosmetics only; Cash + Gold, never Robux)
	} :: { [string]: boolean },
	-- one switch per system (§4); a phase turns its own on
	Parts = {
		Rebirth = true, -- phase 1: §2.1 the base price scale
		EmpireLevel = true, -- phase 1: §2.2 + the Command Office
		BaseTier = true, -- phase 2: §2.3 + the HQ UPGRADE console
		Defence = true, -- phase 2: §2.5 + the Engineering Bureau + instant rebuild
		Elite = true, -- phase 3: §2.4 + the Recruitment Office + re-train fees
		Hospital = true, -- phase 4: §2.8 the Field Hospital (heal, Med Kits, Combat Medicine, Field Surgeon, army medic)
		Mastery = true, -- phase 4: §2.9 the Armory Workshop (mastery, attachments, camos)
		Workshop = true, -- phase 4: §2.6 the Vehicle Workshop (the Vehicle Depot console)
		Warheads = true, -- phase 5: §2.7 Tactical / Heavy Warheads at the Nuclear Silo
		Heist = true, -- phase 5: §2.12 the bank heist kits + the Fixer's desk
		Contracts = true, -- phase 5: §2.11 the Intel Office (daily contracts, the weekly HVT, scouting, raided-by)
		BlackMarket = true, -- phase 5: §2.10 the weekly Black Market (cosmetics only; Cash + Gold, never Robux)
		RewardScaling = true, -- phase 5: the plaza bounty scales with income
	} :: { [string]: boolean },

	-- §2.1 price(structure or business, level) = Costs[level] x (1 + 0.20 x min(rebirths, 20)). Income is unchanged
	-- (BalanceConfig.StructureIncomePerTick reads the raw Costs). Rebirth-zone structures (def.Zone) and Gold-priced
	-- rows are kept through rebirth, so they are never scaled.
	Rebirth = {
		CostScalePerRebirth = 0.20,
		CostScaleMaxRebirths = 20,
	},

	-- §2.2 EMPIRE LEVEL: 1..30 in order, kept through both rebirth paths. Cost(L) = round(5M x 1.17^(L-1), to 100k).
	Empire = {
		MaxLevel = 30,
		BaseCost = 5_000_000,
		Growth = 1.17,
		RoundTo = 100_000,
		CashPctPerLevel = 2, -- +2 % cash per level on non-exempt reasons (its own factor in cashMultFor)
		-- the cosmetic milestone every 5 levels (StarLevel / MarshalLevel show on the base sign in phase 1)
		StarLevel = 5,
		MarshalLevel = 30,
		MarshalTitle = "Empire Marshal",
		Milestones = {
			[5] = "Gold star on your base sign",
			[10] = "Gate banner",
			[15] = "HQ roof flag",
			[20] = "Nameplate chevron",
			[25] = "Gold flag finial",
			[30] = "Empire Marshal title",
		} :: { [number]: string },
	},

	-- §2.3 BASE TIER (phase 2)
	BaseTier = {
		Tiers = {
			{ Name = "Fort", Cost = 10_000_000, NeedRebirths = 2, NeedCC = 5, GateHpPct = 10, SoldierCap = 5 },
			{ Name = "Citadel", Cost = 25_000_000, NeedRebirths = 3, GateHpPct = 10, AutoGunNests = 1 },
			{ Name = "Stronghold", Cost = 60_000_000, NeedRebirths = 5, RebuildSeconds = -10, SoldierCap = 5 },
			{ Name = "Bastion", Cost = 150_000_000, NeedRebirths = 8, GateHpPct = 10, AutoGunNests = 1 },
			{ Name = "Capital", Cost = 400_000_000, NeedRebirths = 12, SoldierCap = 10 },
		} :: { any },
		MaxPartsPerTier = 120,
		MaxLightsPerTier = 2,
		NestExtraX = 9, -- an extra AutoGun nest stands this far past the outer gate gun (T2 left, T4 right)
		MinRebuildSeconds = 10, -- the gate never rebuilds faster than this (T3 -10 s, Gate track -3 s / level)
	},

	-- §2.4 ELITE TRAINING (phase 3)
	Elite = {
		Types = { "Infantry", "Heavy", "SpecialForces" },
		Tiers = {
			{ Name = "Veteran", Cost = 2_000_000, RetrainFee = 5_000, Scale = 1.05 },
			{ Name = "Elite", Cost = 8_000_000, RetrainFee = 15_000, Scale = 1.10 },
			{ Name = "Legendary", Cost = 30_000_000, RetrainFee = 40_000, Scale = 1.18 },
			{ Name = "Mythic", Cost = 100_000_000, RetrainFee = 100_000, Scale = 1.28, NeedRebirths = 30 },
		},
		PctPerTier = 8, -- +8 % HP and damage per tier
		HeavyEvery = 5, -- every 5th field slot is Heavy (+20 % HP) ...
		SpecialForcesEvery = 10, -- ... every 10th Special Forces (+10 % damage) once the SF Facility is L3+
		SpecialForcesNeedFacility = 3,
		HeavyHpMult = 1.2,
		SpecialForcesDmgMult = 1.1,
		Names = { Infantry = "Infantry", Heavy = "Heavy", SpecialForces = "Special Forces" } :: { [string]: string },
		-- the tier look: helmet trim colour, chevrons (4 = the Mythic star), the Mythic aura (client, quality >= 4)
		Trim = { Color3.fromRGB(150, 154, 160), Color3.fromRGB(70, 150, 70), Color3.fromRGB(214, 178, 64), Color3.fromRGB(28, 26, 22) },
		TrimAccent = Color3.fromRGB(214, 178, 64),
		MaxFreeRetrains = 200,
	},

	-- §2.5 DEFENCE TREE (phase 2): Cost(L) = round(1M x 1.6^(L-1), to 100k)
	Defence = {
		Tracks = { "Plating", "Guns", "Gate", "Vault" },
		MaxLevel = 10,
		BaseCost = 1_000_000,
		Growth = 1.6,
		RoundTo = 100_000,
		NeedTier = { [5] = 1, [6] = 1, [7] = 2, [8] = 2, [9] = 3, [10] = 4 } :: { [number]: number },
		PlatingPct = 15,
		GunsPct = 6,
		GatePct = 12,
		GateRebuildPerLevel = 3,
		VaultArmyPerLevel = 0.05, -- army loot x (1 - 0.05 x L): L10 = 2.5 %
		VaultAtmPerLevel = 0.03, -- ATM raid x (1 - 0.03 x L): L10 = 7 %
		InstantRebuildSeconds = 30,
		InstantRebuildMin = 25_000,
	},
	-- claude-bud JOB 55: honest Defence text + the exploit fixes, keyed by the BASE OWNER (OFF = the old rules / text):
	--   * Turret Plating needs Walls L<AutoGunMinWallsLevel> (no turrets before that: it did nothing)
	--   * Turret Guns also arms the gate / tower guards (the text said "turret damage"; the post guards had it, the gate
	--     and tower guards did not)
	--   * the text names what each track really does (the gate guards' HP comes from Gate & Walls; walls have no HP)
	--   * a mid-raid Defence purchase keeps the gate's / turrets' damage (it used to rebuild them at full HP)
	DefenceFix = {
		Enabled = true,
		OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 55): Code Bot flips it after Shaun's phone test
	},
	-- claude-bud JOB 53: the Defence levels you can SEE (Server/Modules/DefenceVisuals). Visual tier by level: TierAt[t]
	-- is the first level of tier t (L1-3 = 1, L4-6 = 2, L7-9 = 3, L10 = 4). Gate damage states at DamageStages (HP
	-- fraction). OFF = no visuals, the gate's old look exactly.
	DefenceVisuals = {
		Enabled = true,
		OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 53): Code Bot flips it after Shaun's phone test
		TierAt = { 1, 4, 7, 10 },
		DamageStages = { 0.6, 0.3 }, -- <= 60 %: dents + scorch; <= 30 %: sagging bands + smoke
		SmokeRate = 4, -- one capped emitter on the gate at <= 30 % / breached
		MaxParts = { Turret = 12, Gate = 30, Vault = 12 }, -- per piece (the budget test)
	},

	-- §2.6 VEHICLE WORKSHOP (phase 4): Cost(L) = 1M x 2.2^(L-1)
	Workshop = {
		Classes = { "Ground", "Air", "Naval" },
		PlateLevel = 3, -- bolt-on armour plates from this level
		TrimLevel = 5, -- the gold nameplate trim at this level
		MaxLevel = 5,
		BaseCost = 1_000_000,
		Growth = 2.2,
		RoundTo = 100_000,
		HpPct = 6,
		SpeedPct = 3,
	},

	-- §2.7 SUPER-WEAPONS (phase 5)
	Warheads = {
		Tactical = { Cost = 5_000_000, NeedRebirths = 2 },
		Heavy = { Cost = 25_000_000, NeedRebirths = 25, RadiusMult = 1.3, DamageMult = 1.2, Hold = 1 },
	},

	-- §2.8 HOSPITAL (phase 4)
	Hospital = {
		HealCooldown = 60,
