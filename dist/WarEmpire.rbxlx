        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ClanConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Clan roster — DataStore WarEmpire_Clans_v1 when API services on;
	session-only fallback otherwise. profile.ClanId always mirrors membership. ]]

local ClanConfig = {
	MaxNameLength = 24,
	MinNameLength = 3,
	MaxTagLength = 5,
	MinTagLength = 2,
	MaxMembers = 20,
	CreateCooldownSeconds = 30,
	-- Territory ownership: capturing while in a clan stamps runtime.ClanId = profile.ClanId
}

return ClanConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">ClanWarConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Clan war / global war — scores + rewards. Product IDs stay 0. ]]

local ClanWarConfig = {
	WarDurationSeconds = 3600,
	MinClanMembersToDeclare = 2,
	DeclareCooldownSeconds = 300, -- anti-abuse: delay before same clan can declare again after settle
	ScorePerTerritoryCapture = 10,
	ScorePerEnemyKill = 1,
	WinningClanCashReward = 25000,
	WinningClanGoldReward = 15,
	ParticipationCashReward = 2500,
	ParticipationGoldReward = 2,
	-- Extra cash per score point for winning clan members (online)
	ScoreBonusCashPerPoint = 50,
	GlobalWarEnabled = true,
	GlobalWarSeasonKey = "GW_S1",
	ScoreboardTopN = 8,
}

return ClanWarConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CodesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Redeemable promo codes (Cash / Gold). Server validates once per code per player.
	Sample codes only — rotate for live seasons.
]]

export type CodeReward = {
	Cash: number?,
	Gold: number?,
	DisplayName: string?,
}

local CodesConfig = {
	-- Normalize: uppercase, strip spaces
	MaxCodeLength = 32,
	Codes = {
		WARFOUNDING = {
			Cash = 15000,
			Gold = 5,
			DisplayName = "War Founding",
		},
		BUILDCONQUER = {
			Cash = 8000,
			Gold = 2,
			DisplayName = "Build & Conquer",
		},
	} :: { [string]: CodeReward },
}

return CodesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CombatConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Combat tuning — health, kill rewards, NPC pool/AI.
	Weapon stats live in WeaponConfig; never trust client damage amounts.
]]

export type NPCTypeDef = {
	Id: string,
	DisplayName: string,
	Health: number,
	Damage: number,
	FireRate: number,
	Range: number,
	WalkSpeed: number,
	AggroRange: number,
	CashReward: number,
	XPReward: number,
	Color: Color3,
}

local CombatConfig = {
	PlayerMaxHealth = 100,
	SpawnInvulnerabilitySeconds = 3, -- mirrors GameConfig; CombatService uses this

	PlayerKill = {
		Cash = 150,
		XP = 40,
	},

	DefaultNPCKill = {
		Cash = 50,
		XP = 15,
	},

	MaxOriginDeltaStuds = 12,
	MaxAimDirectionError = 0.001,
	HitPositionSlopStuds = 4,

	FireRemoteRate = 20,
	FireRemoteBurst = 28,
	ReloadRemoteRate = 2,
	ReloadRemoteBurst = 3,
	EquipRemoteRate = 3,
	EquipRemoteBurst = 4,
	PurchaseWeaponRate = 2,
	PurchaseWeaponBurst = 3,

	MaxActiveNPCs = 18,
	NPCRespawnSeconds = 18,
	NPCThinkInterval = 0.35,
	NPCAlsoSpawnNearTerritories = true,
	MaxTerritoryNPCSpawns = 4,

	NPCTypes = {
		Infantry = {
			Id = "Infantry",
			DisplayName = "Hostile Infantry",
			Health = 80,
			Damage = 10,
			FireRate = 2.5,
			Range = 70,
			WalkSpeed = 12,
			AggroRange = 90,
			CashReward = 50,
			XPReward = 15,
			Color = Color3.fromRGB(140, 55, 55),
		},
		HeavyInfantry = {
			Id = "HeavyInfantry",
			DisplayName = "Heavy Infantry",
			Health = 140,
			Damage = 16,
			FireRate = 1.6,
			Range = 85,
			WalkSpeed = 10,
			AggroRange = 100,
			CashReward = 90,
			XPReward = 28,
			Color = Color3.fromRGB(90, 40, 40),
		},
		OilRigGuard = {
			Id = "OilRigGuard",
			DisplayName = "Oil Rig Guard",
			Health = 200,
			Damage = 20,
			FireRate = 1.4,
			Range = 95,
			WalkSpeed = 9,
			AggroRange = 120,
			CashReward = 140,
			XPReward = 40,
			Color = Color3.fromRGB(110, 70, 35),
		},
		BankGuard = {
			Id = "BankGuard",
			DisplayName = "Bank Guard",
			Health = 220,
			Damage = 28,
			FireRate = 2.2,
			Range = 90,
			WalkSpeed = 14,
			AggroRange = 130,
			CashReward = 150,
			XPReward = 45,
			Color = Color3.fromRGB(55, 65, 120),
		},
		FortGuard = {
			Id = "FortGuard",
			DisplayName = "Fort Guard",
			Health = 170,
			Damage = 17,
			FireRate = 1.7,
			Range = 90,
			WalkSpeed = 10,
			AggroRange = 110,
			CashReward = 120,
			XPReward = 35,
			Color = Color3.fromRGB(100, 95, 70),
		},
	} :: { [string]: NPCTypeDef },

	DefaultNPCType = "Infantry",
}

return CombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DailyOpsConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Three rotating Daily Ops (Military Tycoon–style short objectives).
	MissionService merges these into the daily mission list when enabled.
]]

export type DailyOpDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string, -- CaptureTerritory | KillNPC | RecruitSoldiers
	Target: number,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number,
	MinLevel: number,
}

local DailyOpsConfig = {
	Enabled = true,
	-- Always offer exactly these 3 (gold-forward rewards)
	Ops = {
