		Kind = "Add",
		PerLevel = 1,
		MaxLevel = 2,
		Costs = { 40000, 200000 },
		EffectText = "%s base guards at your posts",
		Enabled = true,
	},
	-- claude-bud JOB 20: one tower guard per level, on the base corner towers (in order); bought at the tower's prompt
	-- (or here). RebirthScale: the price is Costs x (1 + RebirthScale x rebirths) (ResearchService.Purchase)
	TowerGuards = {
		Id = "TowerGuards",
		Track = "Defenses",
		Order = 4,
		DisplayName = "Tower Guards",
		Badge = "TWR",
		Stat = "TowerGuards",
		Kind = "Add",
		PerLevel = 1,
		MaxLevel = 4,
		Costs = { 25000, 25000, 25000, 25000 }, -- = GuardConfig.Tower.BaseCost
		RebirthScale = 0.5, -- = GuardConfig.Tower.PerRebirth
		FlatCosts = true, -- (one tower guard per level, the same price each: ResearchService's sanity check allows it)
		LabLevels = { 0, 0, 0, 0 }, -- no Research Lab needed: the Watchtowers are
		EffectText = "%s tower guards on your corner towers",
		Enabled = true,
	},
} :: { [string]: UpgradeDef }

--[[ Upgrades of one track sorted by Order (disabled ones included — the card shows SOON). ]]
function ResearchConfig.UpgradesForTrack(trackId: string): { UpgradeDef }
	local out: { UpgradeDef } = {}
	if typeof(trackId) ~= "string" then
		return out
	end
	for _, def in pairs(ResearchConfig.Upgrades) do
		if def.Track == trackId then
			table.insert(out, def)
		end
	end
	table.sort(out, function(a: UpgradeDef, b: UpgradeDef): boolean
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		return a.Id < b.Id
	end)
	return out
end

--[[ Owned level of an upgrade from a profile.Research table. Junk (non-table research, non-number / NaN
	level, unknown id) → 0; otherwise floor, clamped to 0..MaxLevel. ]]
function ResearchConfig.LevelOf(research: any, id: string): number
	if typeof(research) ~= "table" or typeof(id) ~= "string" then
		return 0
	end
	local def = ResearchConfig.Upgrades[id]
	if def == nil then
		return 0
	end
	local v = rawget(research, id)
	if typeof(v) ~= "number" or v ~= v then
		return 0
	end
	return math.clamp(math.floor(v), 0, def.MaxLevel)
end

--[[ Research Lab level needed to buy `targetLevel` of `def`. ]]
function ResearchConfig.LabLevelFor(def: UpgradeDef, targetLevel: number): number
	if typeof(def) ~= "table" then
		return targetLevel
	end
	local labLevels = def.LabLevels
	if labLevels ~= nil and typeof(labLevels) == "table" then
		local v = labLevels[targetLevel]
		if typeof(v) == "number" then
			return v
		end
	end
	return targetLevel
end

--[[ 1 + Σ PerLevel × level over Kind "Mult" upgrades of `statId`, clamped to [1, MaxMult]. ]]
function ResearchConfig.MultFor(research: any, statId: string): number
	if typeof(research) ~= "table" or typeof(statId) ~= "string" then
		return 1
	end
	local sum = 0
	for id, def in pairs(ResearchConfig.Upgrades) do
		if def.Kind == "Mult" and def.Stat == statId then
			sum += def.PerLevel * ResearchConfig.LevelOf(research, id)
		end
	end
	local m = 1 + sum
	if m ~= m then
		return 1
	end
	return math.clamp(m, 1, ResearchConfig.MaxMult)
end

--[[ Σ PerLevel × level over Kind "Add" upgrades of `statId` (>= 0). ]]
function ResearchConfig.AddFor(research: any, statId: string): number
	if typeof(research) ~= "table" or typeof(statId) ~= "string" then
		return 0
	end
	local sum = 0
	for id, def in pairs(ResearchConfig.Upgrades) do
		if def.Kind == "Add" and def.Stat == statId then
			sum += def.PerLevel * ResearchConfig.LevelOf(research, id)
		end
	end
	if sum ~= sum or sum < 0 then
		return 0
	end
	return sum
end

--[[ Upgraded magazine: single-shot weapons (base <= 1: rockets, grenades) stay as they are; otherwise
	round(base × mult), never below base. ]]
function ResearchConfig.EffectiveMagazine(base: number, mult: number): number
	if typeof(base) ~= "number" or base ~= base then
		return 0
	end
	if base <= 1 then
		return base
	end
	local m = if typeof(mult) == "number" and mult == mult then math.clamp(mult, 1, ResearchConfig.MaxMult) else 1
	return math.max(base, math.floor(base * m + 0.5))
end

--[[ "+12%" (Mult) or "+2" (Add) for `level` levels of `def`. ]]
function ResearchConfig.FormatAmount(def: UpgradeDef, level: number): string
	if typeof(def) ~= "table" or typeof(def.PerLevel) ~= "number" then
		return ""
	end
	local lv = if typeof(level) == "number" and level == level then level else 0
	if def.Kind == "Add" then
		return "+" .. tostring(def.PerLevel * lv)
	end
	return string.format("+%d%%", math.floor(def.PerLevel * lv * 100 + 0.5))
end

--[[ "+12% weapon damage" ]]
function ResearchConfig.FormatEffect(def: UpgradeDef, level: number): string
	if typeof(def) ~= "table" or typeof(def.EffectText) ~= "string" then
		return ""
	end
	local ok, s = pcall(string.format, def.EffectText, ResearchConfig.FormatAmount(def, level))
	if ok and typeof(s) == "string" then
		return s
	end
	return ResearchConfig.FormatAmount(def, level)
end

--[[ "$12,000" (comma thousands, floored). ]]
function ResearchConfig.FormatCash(n: number): string
	local v = if typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge then math.floor(n) else 0
	local neg = v < 0
	local digits = string.format("%d", math.abs(v))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if neg then "-$" else "$") .. out
end

return ResearchConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">RetentionConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 29 (2026-09-30): retention. The first-minute, offline and streak switches live beside the systems they
	change (TutorialConfig.FastStart, EconomyConfig.OfflineEarnings, DailyRewardConfig.ShowTomorrow). This file holds:
	  * the shared rollout rule;
	  * the onboarding timing log;
	  * the experience-notification opt-in, plus the state an external sender reads (docs/NOTIFICATIONS.md).
]]

local RunService = game:GetService("RunService")

local RetentionConfig = {
	--[[ Onboarding timing: seconds from join to each first-session step, once per session, NEW players only (the
		profile's first join within AnalyticsConfig.Roblox.FunnelNewPlayerSeconds). The steps are Joined,
		CharacterSpawned, BaseClaimed, Step1..7, FirstCash, FirstPurchase, FirstRecruit, FirstRobux and SessionEnd.
		Sent as the Roblox custom event "OnboardingSeconds" (value = seconds, field = step). In Studio it also prints
		"[FUNNEL] <step> t=<s>" for EVERY player, so a fresh-profile Studio run shows the times. Analytics only: it never
		changes the game. ]]
	Funnel = {
		Enabled = true,
		PrintInStudio = true,
	},
	--[[ Experience notifications (Roblox ExperienceNotificationService, a client API). Asked at a calm moment only:
		  * TutorialDelaySeconds after the tutorial ends (finished or skipped), on foot, with no panel open;
		  * or when the player taps TURN ON in Settings (NOTIFICATIONS row).
		The automatic ask (never on join, never every join):
		  * never in the first NotBeforeSeconds of a session;
		  * at most once per session;
		  * not again for DeclineCooldownDays after a decline (profile.NotifOptIn, saved);
		  * never after an accept.
		The client asks CanPromptOptInAsync, prompts, and reports the result on RequestNotifOptInResult (accepted /
		declined / unavailable; analytics NotificationOptIn).
		StateStore: one DataStore write per leave, with the fields an external sender reads (docs/NOTIFICATIONS.md). ]]
	Notifications = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
		NotBeforeSeconds = 60,
		TutorialDelaySeconds = 25, -- after the Starter Pack offer's slot (3 s after the tutorial)
		DeclineCooldownDays = 7,
		Moments = { TutorialComplete = true } :: { [string]: boolean },
		StateStore = "WE_NotifyState_v1",
		MaxPerDay = 1, -- enforced by the sender (docs/NOTIFICATIONS.md); LastSentDay is its field
	},
	--[[ claude-bud JOB 49 part D (2026-10-01): ONE return sequence. On join the cards come in one queue, one at a time
		(Welcome back -> the streak card -> a one-line "3 new missions" toast that pulses the Missions button), never
		while the onboarding hold is on (the Guided chain), never in combat / driving / with a panel open. The
		EngagementConfig Comeback cash folds into the Welcome back card when both are due (one card, both amounts).
		ReturnDay { days since the first join, guidedDone } is logged once per session on join. OFF = the cards as
		before (each on its own timer). ]]
	ReturnSequence = {
		Enabled = true,
		OwnerFirst = false, -- Code Bot v182 (Shaun approved 2026-10-01): return sequence live for everyone
		GapSeconds = 1.5, -- between two cards
		MissionsText = "3 new missions today: open MISSIONS", -- device-neutral, no key names
		MissionsToastSeconds = 5,
	},
}

--[[ One owner-first rule for JOB 29's switches (a block with Enabled + OwnerFirst):
	  * Enabled ~= true: off for everyone (the kill switch; the game exactly as before);
	  * OwnerFirst == true: only AdminConfig.IsPlaytestOwner (UserId 470626172), plus every player in a Studio test
	    session (so a fresh-profile Studio run sees it);
	  * OwnerFirst == false: everyone.
	(A boolean, not an old-style owner rollout string, which codebot_v101 keeps out of Configs; this
	flag is new and Code Bot flips it when the owner is happy.) ]]
function RetentionConfig.Live(block: any, userId: any): boolean
	if typeof(block) ~= "table" or block.Enabled ~= true then
		return false
	end
	if block.OwnerFirst ~= true then
		return true
	end
	if RunService:IsStudio() then
		return true
	end
	return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
end

function RetentionConfig.NotificationsLiveFor(userId: any): boolean
	return RetentionConfig.Live(RetentionConfig.Notifications, userId)
end

function RetentionConfig.OfflineLiveFor(userId: any): boolean
	return RetentionConfig.Live((require(script.Parent.EconomyConfig) :: any).OfflineEarnings, userId)
end

return RetentionConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">RigConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RigConfig (R-RIG): animated soldier figures and the escorts that make an army look bigger as it grows.

	Server (VisualAssetService + RigBuilder): a soldier's Part-kit body is swapped ONCE, when it spawns, for the Roblox
	"Soldier" R6 body (VisualAssetConfig.Characters rows with Rig = "R6"). The host keeps its HumanoidRootPart (collider,
	Humanoid root) and Humanoid; the kit Head (headshot part), Helmet, Rifle and Pack move INTO the rig sub-model
	"WE_Rig" with the Soldier's torso and limbs. The server never plays an animation. A host that asked while the
	Soldier file was still loading or waiting for a retry gets the rig when the file arrives (VisualAssetService).
	Server (SquadOrdersService.SyncArmy): each squad unit carries WE_Escorts = how many escort figures it shows
	(RigConfig.EscortsFor: soldiers owned, units in the field, Barracks level; EscortShare: the front pair first).
	Client (RigAnimator): animates the nearest figures only, builds the escorts LOCALLY (never replicated, never hit by
	a shot, never on the server) inside the per-device budget below, hides any escort that would stand between the
	camera and the player, and shows every figure it does not animate as plain blocks with the rifle held forward.
	Animation ids: Roblox-owned R6 animations (creator Roblox): they play in any experience.
]]

local RigConfig = {
	Enabled = true, -- false: VisualAssetService never rigs (every soldier keeps its Part kit, no escorts) and clients do nothing
	Tag = "WE_Rig", -- CollectionService tag on every server-built soldier rig (clients find figures by it)

	-- Code Bot v148 (Server/AvatarMoodGuard): PLAYER avatars only (never soldiers / guards). A dynamic-head "mood"
	-- (the character's Animate.mood Animation) whose animation this place may not load is swapped for Roblox's
	-- default mood before the client plays it. Live proof 2026-09-30: Roblox's own bundles The Winning Smile (957),
	-- Shiny Teeth (265345), Silly Fun (299652) and Woman Face (948) ship moods whose animations are uploaded by user
	-- 8923762 (not Roblox, not this game's owner): "Failed to load animation with sanitized ID" x 1,878 client + 277 server.
	AvatarMood = {
		Enabled = true,
		FallbackId = "rbxassetid://14366558676", -- Mood_StevieStandard, creator Roblox (1): the Animate default mood; loads here
		-- known not loadable in this place (AnimationClipProvider, live place): swapped with no lookup
		KnownBad = { 104666063103723, 114302219876492, 122193759333439, 96806611330323, 121132383996019 },
	},

	-- The host Humanoid (server, set once at attach). RigType "Keep" leaves the kit's default untouched (HEAD
	-- behaviour); "R15" is the Studio fallback if the Humanoid ever measures hip height from the rig's legs (spec §10).
	Host = {
		RigType = "Keep", -- "Keep" | "R15"
		RequiresNeck = false, -- a rig Neck can never kill the host; the server decides death by Health, as today
	},

	-- Hit silhouette (owner decision R4, default "keep today's"): the rig Torso becomes a queryable hit box this deep
	-- (FileMesh bodies ignore the part size, so the look does not change). 1.45 puts the side-on hit area of every
	-- hostile kind back at today's (the kit rifle / stock were hittable); 0 = the rig Torso is not hittable.
	Hit = {
		TorsoDepth = 1.45,
	},

	Anim = {
		Enabled = true, -- false: rigs stay in their rest pose, no tracks on any client
		TickHz = 4, -- client LOD pass rate (task.wait loop; the camera guard also runs alone at Escort.Camera.GuardHz; never RenderStepped / Heartbeat)
		NearStuds = 120, -- beyond this a figure is not animated (rest pose)
		HysteresisStuds = 10, -- an animated figure stops only past NearStuds + this
		MaxAnimated = 24, -- figures animated per client (own army first, then nearest); escorts counted apart
		MaxActivationsPerTick = 6, -- figures that start animating per pass (spreads LoadAnimation)
		StickyStuds = 15, -- an animated figure keeps its place in the pick until another is this much closer (no churn)
		WalkMinStuds = 1.5, -- studs/s of flat root movement that counts as walking
		WalkSpeedRef = 14.5, -- Walk track speed = figure speed / WalkSpeedRef (clamped)
		WalkRateMin = 0.6,
		WalkRateMax = 2.4, -- claude-bud JOB 22: up to the army catch-up speed (34 studs/s / 14.5): no foot sliding
		AimSeconds = 1.2, -- after an NPC shot (WeaponFx S = 0) the shooter plays Aim this long, if standing
		AimMatchStuds = 3, -- a shot's origin within this many studs (flat) of a figure's root = its shot
		FadeSeconds = 0.2,
		AnimateStatic = false, -- anchored base statues (WE_RigStatic) keep their baked pose and never load a track
		StaticHoldDeg = 89, -- the Hold keyframe's right-arm angle (0 = arm down at the side)
		HoldUntracked = true, -- an armed figure with no tracks (not picked / far / not loaded yet) holds its rifle
		-- forward: the client turns its Right Shoulder C0 by StaticHoldDeg locally, and back before Hold plays
		Ids = {
			Hold = 182393478, -- "ToolLoopAnimation" (Roblox): right arm forward, the rifle points ahead (Idle priority)
			Idle = 180435571, -- "Idle1LoopAnimation" (Roblox), Core priority
			Walk = 180426354, -- "WalkLoopAnimation" (Roblox), Core priority
			Aim = 183817498, -- "Soldier Aiming" (Roblox; the Soldier file's own), Action priority
		},
	},

	-- Mesh LOD: only the figures this client animates (the pick, <= Anim.MaxAnimated), the nearest MaxMeshedStatic
	-- base statues within FarMeshStuds and the escorts wear the Roblox body (FileMesh); every other figure shows plain
	-- blocks (SpecialMesh.MeshType Brick, local only) with its beret hidden. That bounds soldier triangles per phone at
	-- (MaxAnimated + MaxMeshedStatic + Escort.MaxPerClient) x Budget.TrianglesPerMeshedFigure however big the crowd.
	Lod = {
		FarMeshStuds = 120, -- statues past this never get the Roblox body (= Anim.NearStuds)
		HysteresisStuds = 15,
		MaxMeshedStatic = 8, -- statues shown with the Roblox body at once (nearest first)
		MaxSwapsPerTick = 12, -- blocks -> Roblox body per pass (Roblox body -> blocks is never delayed)
	},

	-- Escorts (army decision D14, 2026-09-27: "the army on screen grows"): client-only copies of a squad unit's body that
	-- march with it. Server cost 0 (no part, no Humanoid, no network); each client caps them by its own budget.
	Escort = {
		Enabled = true,
		SquadSizeBase = 2, -- soldiers one unit can stand for = SquadSizeBase + SquadSizePerBarracks x Barracks (1..5)
		SquadSizePerBarracks = 2,
		BarracksMin = 1, -- a Barracks-0 base counts as level 1 here (squads of 4)
		BarracksMax = 5,
		SoldiersPerEscort = 4, -- one escort figure per this many fielded soldiers beyond one per unit
		MaxPerArmy = 12, -- escorts per army (all units together): own army up to 8 units + 12 = 20 figures (owner D14-a)
		MaxPerUnit = 3, -- = #Offsets
		MaxPerClient = 22, -- escorts built on one client (owner D14-b): (Budget.PhoneFigureParts - Budget.LeadFigureParts)
		-- / Budget.PartsPerEscort = (940 - 760) / 8; re-derive when the Front garrison ships (army lane)
		NearStuds = 90, -- escorts only for an animated unit this close to the camera
		HysteresisStuds = 10,
		MaxBuildsPerTick = 4, -- escort bodies cloned per pass
		-- In the unit's own frame (-Z = ahead of it; a unit in its Follow slot faces where the player faces): a file of up
		-- to three AHEAD of the unit, out of the corridor between the third-person camera and the player (behind him).
		-- 7 / 2.4 steps: no figure overlaps a unit, another escort or the player for 1-8 units (FollowSlots + ranks), and
		-- with the camera straight behind the player every escort is past the guard's show line (v3/camera3.py).
		Offsets = { Vector3.new(0, 0, -7), Vector3.new(0, 0, -9.4), Vector3.new(0, 0, -11.8) } :: { Vector3 },
		-- Camera guard (client, every pass + GuardHz): an escort is hidden while its root is nearer the camera than the
		-- local player's root + PlayerMarginStuds, or closer along the view than FigureStuds / (2 x MaxScreenFrac x
		-- tan(FOV / 2)) + DepthMarginStuds (it would cover more than MaxScreenFrac of the screen height). It shows
		-- again ShowHysteresisStuds past both lines. Hidden = every part AND every Decal (the kit head's face) of it.
		Camera = {
			MaxScreenFrac = 0.25,
			FigureStuds = 5.3, -- feet to beret / helmet top
			DepthMarginStuds = 0.25,
			PlayerMarginStuds = 0.5,
			ShowHysteresisStuds = 0.5,
			-- faces lane (owner screenshot, v83): the guard also runs on its own GuardHz times a second (0 = off: only in
			-- the 4 Hz pass; BuyPathStatic allows 0 or 20-60). A camera swipe or a turning unit swings an escort file (a
			-- rigid 7-11.8 stud arm) through the camera faster than a 4 Hz pass follows. Each run reads <= Anim.MaxAnimated
			-- roots and <= MaxPerClient torsos; with nothing to guard the loop sleeps a whole pass.
			GuardHz = 30,
			-- an own squad unit (a real unit) nearer the camera than the player and drawn taller than this share of the
			-- screen height is hidden on this client the same way: the nearest point of its body along the view is closer
			-- than FigureStuds / (2 x LeadScreenFrac x tan(FOV / 2)) + DepthMarginStuds. Depth, not distance: a phone in
			-- landscape sees about 113 degrees across, so a soldier 5-6 studs off to the side still fills a bottom corner
			-- (the owner's camo "blob"). Shows ShowHysteresisStuds past either line. 0 = off (BuyPathStatic allows 0 or
			-- 0.8-1.0; lower hides wing soldiers of a running army at the default zoom).
			LeadScreenFrac = 0.9,
			RootToFeetStuds = 3, -- a squad unit's root to its feet (root half-height 1 + Humanoid.HipHeight 2)
		},
	},

	-- v119 cloth bodies (VisualAssetConfig.SoldierAssetId, the Army Soldier 7703684779): block limbs dressed by a classic
	-- Shirt / Pants template. A rig has no Humanoid (catalog rule: a Humanoid in WE_Rig would turn every limb into a
	-- "character" for the hit / aim code), so RigBuilder paints the template's regions (standard 585 x 559 layout) onto
	-- the limb faces as Texture objects named WE_Cloth, tinted TintAlpha of the way to the kit colour (friend / foe cue).
	-- Clients (RigAnimator) hide WE_Cloth and the helmet on figures outside the LOD pick, and show helmets in pick order
	-- only while the pick stays inside Budget.MaxMeshedTriangles (a cloth figure costs BodyTris, + HeadwearTris with its
	-- helmet; a Roblox-body figure TrianglesPerMeshedFigure). Enabled = false: plain kit-colour blocks (still animated).
	Cloth = {
		Enabled = true,
		CanvasW = 585, -- template pixels (Roblox shirt / pants template)
		CanvasH = 559,
		TintAlpha = 0.3, -- 0 = the template's own colours, 1 = multiplied by the kit colour
		TopFaces = true, -- paint the shoulder / torso tops (seen from the raised third-person camera)
		BodyTris = 60, -- Torso + 4 block limbs (12 triangles a box)
		HeadwearTris = 2103, -- the Army Soldier FAST helmet mesh 5608666819, LOD0 (measured v119: mesh v3.01, 3536 faces all LODs)
		-- the file's headwear pick: the first Accoutrement whose lower-case name holds one of these (else the first one)
		HeadwearPrefer = { "helmet", "beret", "cap", "hat" } :: { string },
	},

	-- Figure budget (BuyPathStatic pins these; the census driver checks them)
	Budget = {
		MaxPartsPerFigure = 10, -- host root + Torso + 4 limbs + Head + headwear + Rifle (+ Pack on heavy kinds)
		PartsPerEscort = 8, -- Torso + 4 limbs + Head + headwear + Rifle (no root, no Humanoid)
		PhoneFigureParts = 940, -- today's (HEAD) moving-figure parts on a phone: 48 squads x 9 + 22 NPCs x 16 + 12 guards x 13
		LeadFigureParts = 760, -- the same figures rigged: 48 x 9 + 22 x 10 + 12 x 9
		TrianglesPerMeshedFigure = 1530, -- Roblox body: limbs 282 + 282 + 204 + 204, torso 216, beret 342
		MaxMeshedTriangles = 85000, -- (MaxAnimated + Lod.MaxMeshedStatic + Escort.MaxPerClient) x 1530 must stay under
	},
}

-- Soldiers one unit can stand for at this Barracks level (4 / 6 / 8 / 10 / 12).
function RigConfig.SquadSize(barracks: number): number
	local e = RigConfig.Escort
	local b = math.clamp(math.floor(tonumber(barracks) or 0), e.BarracksMin, e.BarracksMax)
	return e.SquadSizeBase + e.SquadSizePerBarracks * b
end

-- Escort figures for a whole army: soldiers owned, units in the field (5..8), Barracks level. Pure; never negative.
function RigConfig.EscortsFor(soldiers: number, units: number, barracks: number): number
	local e = RigConfig.Escort
	local u = math.max(0, math.floor(tonumber(units) or 0))
	local s = math.max(0, math.floor(tonumber(soldiers) or 0))
	if u == 0 or e.Enabled ~= true then
		return 0
	end
	local fielded = math.min(s, u * RigConfig.SquadSize(barracks))
	local n = math.floor(math.max(0, fielded - u) / math.max(1, e.SoldiersPerEscort))
	return math.clamp(n, 0, math.min(e.MaxPerArmy, u * e.MaxPerUnit))
end

-- The share of `total` escorts for the index-th unit (1-based, in slot order) of `units`: the front pair of slots
-- (1, 2) fills first, alternating left / right, then the pair (3, 4), and so on; a lone last slot takes the rest.
-- Front slots stand nearest the player's line, so their files (Offsets, ahead) are the ones the camera sees.
function RigConfig.EscortShare(total: number, units: number, index: number): number
	local per = RigConfig.Escort.MaxPerUnit
	local t = math.max(0, math.floor(tonumber(total) or 0))
	if units <= 0 or index < 1 or index > units then
		return 0
	end
	local first = if index % 2 == 1 then index else index - 1 -- the pair's first slot
	local pairSize = if first + 1 <= units then 2 else 1
	local left = math.max(0, t - (first - 1) * per) -- escorts not taken by the pairs in front
	local here = math.min(left, per * pairSize)
	if pairSize == 1 then
		return here
	end
	if index == first then
		return math.min(per, (here + 1) // 2)
	end
	return math.min(per, here // 2)
end

return RigConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">RivalConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 41 part C (2026-10-01): RIVAL BASES WORTH RAIDING (owner change 19:05: replaces "smaller servers";
	servers stay at 10 players). A separate config (not an ArmyOrdersConfig block) so the JOB 38 SEND config keeps its
	pins; it only SURFACES targets, every rule stays JOB 38's.
	  * the SERVER (Services/RivalService) lists, for each viewer, the other occupied bases ArmySendRules ALLOWS right now
	    (ArmyPlan.CheckSend: the same verdict, the same facts; no second rule), sorted by the loot estimate then the
	    distance, top MaxShown. Loot is a BUCKET, never the exact balance. One FeaturePush "RivalTargets" per viewer
	    every RefreshSeconds, from ONE shared tick.
	  * the CLIENT (Controllers/RivalController) shows a TARGETS pill (count badge) and a small list: name, army size,
	    the loot bucket, the verdict chip, SEND ARMY (the same JOB 38 remote; the server re-checks) and VIEW (the map on
	    that base card; tap-to-pin, no travel).
	OFF (Enabled = false or not live for the viewer): no pill, no push; the map SEND ARMY is unchanged.
]]

local RivalConfig = {
	Enabled = true,
	OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone
	RefreshSeconds = 10,
	MaxShown = 3,
	MinLootToShow = 1000,
	-- the loot estimate as a bucket (largest first): "$1M+", "$100k+", "$10k+", "$1k+"
	LootBuckets = {
		{ Min = 1000000, Text = "$1M+" },
		{ Min = 100000, Text = "$100k+" },
		{ Min = 10000, Text = "$10k+" },
		{ Min = 1000, Text = "$1k+" },
	},
	-- the verdict chip from the SEND ratio (ArmyOrdersConfig.Fairness): bully -> easy (half loot), < RiskyRatio -> risky
	VerdictText = { Easy = "easy", Even = "even", Risky = "risky" },
	-- the optional "new rich target" toast: at most once per this many seconds, never in combat / the Guided hold
	ToastEverySeconds = 300,
	ToastText = "A rich target is nearby: TARGETS",
	-- the pill (real px): top-right under the top-bar pills (the Army tile is in the left rail's thumbstick band)
	-- Code Bot v168 (Shaun 2026-10-01: "isn't very clear and in depth"; a dark pill with small dim yellow text): a
	-- 64 px CARD instead: a crosshair icon, "TARGETS" + the count, then the suggested rival (the server's top pick:
	-- most loot, then nearest) on two lines: the name, "500m · $100k+"; with no target "No target now" + the short
	-- reason. Placed in the CONTENT rect (below the 58 px topbar row where the compass / BASE pill sits), Top px under
	-- it, Right px from the safe right edge. Its width leaves the centred top stack (toasts / objective card,
	-- HudConfig.TopStack.MaxWidthScale 0.62 of the content width) a StackGap: Width = clamp(content x
	-- (1 - 0.62) / 2 - Right - StackGap, MinWidth, MaxWidth) = 180 px on a 1024 x 471 phone (146 on 844 x 390). From
	-- BigIconMinWidth the crosshair is a 30 px icon left of the three lines; narrower, an 18 px icon in the title row
	-- and the two rival lines use the full width.
	Pill = { Top = 8, Right = 8, Height = 64, MinWidth = 142, MaxWidth = 260, StackGap = 6, TopStackScale = 0.62, Icon = 30, SmallIcon = 18, BigIconMinWidth = 172, Badge = 30 },
	-- the list under the card (real px): one 64 px row per target (name + level / army + verdict chip / loot +
	-- distance, SEND ARMY + VIEW), a 36 px header; on a short screen it slides up over the card (it must end above
	-- the content bottom: asserted by the v168 test)
	List = { Width = 400, Gap = 6, Header = 36, RowHeight = 64, RowGap = 4, SendWidth = 112, ViewWidth = 60, ButtonHeight = 48, NukeWidth = 72 },
	-- the card's short empty-state reasons (<= 16 chars at 14 px in the card's 126 px text column); the list keeps the full WhyText
	ShortWhy = {
		Held = "Finish the guide",
		Alone = "No rivals here",
		NoArmy = "Recruit soldiers",
		Protected = "Rivals shielded",
		Busy = "Army busy",
		Poor = "No rich rivals",
		Strong = "Too strong",
	},
	ShortWhyDefault = "Check back soon",
	-- Code Bot v163: the pill is ALWAYS shown for a live player; with 0 targets it is dimmed and the list says this,
	-- plus the server's one-line reason (Why) under it
	EmptyText = "No targets right now — rivals appear when other players have cash to raid",
	EmptyHeight = 96, -- px of the empty-state text block (up to 5 lines at 15 px in the 330 px list)
	WhyText = {
		Held = "Finish the guided first minutes first.",
		Alone = "No other players with a base in this server yet.",
		NoArmy = "Recruit soldiers to send an army.",
		Protected = "Everyone here is shielded or new-player protected right now.",
		Busy = "Your army is out or resting.",
		Poor = "Nobody here has $10k+ in their ATM yet.",
		Strong = "Their defences are too strong for your army right now.",
	},
}

-- ── Code Bot v168: the TARGETS card / list text (pure; RivalController draws exactly these strings) ──

-- "95m" under 1 km, "1.2km" above (the compass pill's format; 1 stud = 1 m)
function RivalConfig.DistText(studs: any): string
	local n = math.max(0, tonumber(studs) or 0)
	if n ~= n then
		n = 0
	end
	if n < 1000 then
		return string.format("%dm", math.floor(n + 0.5))
	end
	return string.format("%.1fkm", n / 1000)
end

-- the short reason for the card from the server's full one-line Why (RivalConfig.WhyText value)
function RivalConfig.ShortWhyFor(why: string?): string
	if type(why) == "string" then
		for key, full in pairs(RivalConfig.WhyText) do
			if full == why then
				return RivalConfig.ShortWhy[key] or RivalConfig.ShortWhyDefault
			end
		end
	end
	return RivalConfig.ShortWhyDefault
end

--[[ The card's three lines for the pushed rows (rows[1] = the server's suggested rival) and the empty reason:
	{ Title = "TARGETS", Count = n, Name = line 2, Detail = line 3, Has = n > 0 } ]]
function RivalConfig.PillLines(rows: { any }?, why: string?): { [string]: any }
	local list = rows or {}
	local top = list[1]
	if top == nil then
		return { Title = "TARGETS", Count = 0, Name = "No target now", Detail = RivalConfig.ShortWhyFor(why), Has = false }
	end
	local loot = if type(top.Loot) == "string" then top.Loot else "$1k+"
	local far = tonumber(top.Dist) or 0
	return {
		Title = "TARGETS",
		Count = #list,
		Name = tostring(top.Name or "Rival"),
		Detail = if far > 0 then RivalConfig.DistText(far) .. " · " .. loot else loot .. " loot",
		Has = true,
	}
end

--[[ One list row's text: Name, Level ("Lv 23"), Army ("Army 12"), Loot ("$100k+ loot"), Dist ("500m away"),
	Chip (the verdict, upper case). ]]
function RivalConfig.RowLines(r: any): { [string]: string }
	local lv = math.floor(tonumber(r and r.Level) or 0)
	return {
		Name = tostring(r and r.Name or "Rival"),
		Level = if lv > 0 then "Lv " .. tostring(lv) else "Lv ?",
		Army = "Army " .. tostring(math.floor(tonumber(r and r.Army) or 0)),
		Loot = (if r and type(r.Loot) == "string" then r.Loot else "$1k+") .. " loot",
		Dist = RivalConfig.DistText(r and r.Dist),
		Chip = string.upper(tostring(r and r.Verdict or RivalConfig.VerdictText.Even)),
	}
end

--[[ The card + list rectangles in the content rect's px (x, y = top-left; w, h) for a content size and a row count.
	RivalController places by exactly these numbers; the v168 test checks them against the 1024 x 471 HUD. ]]
function RivalConfig.Layout(contentW: number, contentH: number, nRows: number): { [string]: any }
	local P, L = RivalConfig.Pill, RivalConfig.List
	local side = contentW * (1 - P.TopStackScale) / 2
	local w = math.clamp(math.floor(side - P.Right - P.StackGap), P.MinWidth, P.MaxWidth)
	local big = w >= P.BigIconMinWidth
	local pill = {
		X = contentW - P.Right - w,
		Y = P.Top,
		W = w,
		H = P.Height,
		Icon = if big then P.Icon else P.SmallIcon,
		IconX = 8,
		IconY = if big then math.floor((P.Height - P.Icon) / 2) else 5,
		TitleX = if big then 8 + P.Icon + 8 else 8 + P.SmallIcon + 4,
		TextX = if big then 8 + P.Icon + 8 else 8,
	}
	pill.TextW = w - pill.TextX - 8
	pill.TitleW = w - pill.TitleX - P.Badge
	local body = if nRows <= 0 then RivalConfig.EmptyHeight else nRows * (L.RowHeight + L.RowGap)
	local listH = L.Header + body + 4
	-- under the card; on a short screen as far up as needed (over the card, never above the content top + Top)
	local listTop = math.max(P.Top, math.min(P.Top + P.Height + L.Gap, contentH - P.Right - listH))
	listH = math.min(listH, contentH - listTop - P.Right)
	local lw = math.min(L.Width, contentW - 2 * P.Right)
	return { Pill = pill, List = { X = contentW - P.Right - lw, Y = listTop, W = lw, H = listH } }
end

function RivalConfig.LiveFor(userId: any): boolean
	return (require(script.Parent.RetentionConfig) :: any).Live(RivalConfig, userId)
end

-- the bucket text for a loot estimate; nil below MinLootToShow (never the exact number)
function RivalConfig.Bucket(loot: number): string?
	local n = tonumber(loot) or 0
	if n ~= n or n < RivalConfig.MinLootToShow then
		return nil
	end
	for _, b in ipairs(RivalConfig.LootBuckets) do
		if n >= b.Min then
			return b.Text
		end
	end
	return nil
end

-- the verdict chip from an allowed SEND verdict { Bully, Ratio } and the JOB 38 fairness ratios
function RivalConfig.VerdictWord(bully: boolean, ratio: number, riskyRatio: number): string
	if bully then
		return RivalConfig.VerdictText.Easy
	elseif ratio < riskyRatio then
		return RivalConfig.VerdictText.Risky
	end
	return RivalConfig.VerdictText.Even
end

--[[ Pure: candidate rows { PlotId, Loot, Dist, ... } -> the shown list: Loot >= MinLootToShow, sorted by Loot (desc)
	then Dist (asc), at most MaxShown; each row gets its Bucket and loses the exact Loot. ]]
function RivalConfig.Pick(rows: { any }): { any }
	local list = {}
	for _, r in ipairs(rows) do
		if (tonumber(r.Loot) or 0) >= RivalConfig.MinLootToShow then
			table.insert(list, r)
		end
	end
	table.sort(list, function(a, b)
		if a.Loot ~= b.Loot then
			return a.Loot > b.Loot
		end
		return a.Dist < b.Dist
	end)
	local out = {}
	for i = 1, math.min(RivalConfig.MaxShown, #list) do
		local r = list[i]
		table.insert(out, {
			PlotId = r.PlotId,
			Name = r.Name,
			Army = r.Army,
			Level = math.max(0, math.floor(tonumber(r.Level) or 0)), -- Code Bot v168 (display only)
			Verdict = r.Verdict,
			Loot = RivalConfig.Bucket(r.Loot),
			Dist = math.floor((tonumber(r.Dist) or 0) + 0.5),
		})
	end
	return out
end

return RivalConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">SeasonConfig</string>
            <string name="Source"><![CDATA[--!strict

local SeasonConfig = {
	CurrentSeasonId = "S1_Foundation",
	DisplayName = "Season 1: Foundation",
	StartUnix = 0,
	EndUnix = 0,
	BattlePassLevels = 50,
	XPPerBattlePassLevel = 1000,
	XPBonusMult = 1.1,
	CashBonusMult = 1.05,
	Ended = false,
}

return SeasonConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">SecurityConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 15 (2026-09-29): anti-exploit sweep (Server/Modules/RemoteGate). One gate in front of every
	client -> server remote, on top of each handler's own RateLimitService key and checks (those stay as they are).
	  * Rate ceiling per player per remote (Limits, else Default): set ABOVE every handler's own limit, so a real
	    player never meets it; it stops floods before any handler work.
	  * Argument schema (Schemas): each position's allowed types ("string", "string:N" max length, "number" finite,
	    "boolean", "table" (<= MaxTableKeys keys, <= MaxDepth deep, finite numbers, short strings), "Vector3" finite,
	    "any"; "a|b" either; a trailing "?" = may be nil). More arguments than the schema lists = rejected.
	  * A remote the client should never fire (server pushes, unused requests) gets a sink listener: every fire is a
	    bad request.
	  * Bad requests are logged (one line per player per LogSeconds, with counts) and ignored. Only an extreme flood
	    kicks: FloodKick.Rejects rejected requests inside FloodKick.WindowSeconds.
	Modes: players the gate is live for (Rollout) are ENFORCED (rejected requests dropped, flood kick). Everyone else
	gets Others: "observe" = the same checks, logged as "would reject", never dropped or kicked (OFF = the old
	behaviour for play), "off" = nothing at all. Flip Rollout to "all" after reading the observe logs from live.
]]

local SecurityConfig = {
	RemoteGate = {
		Rollout = "observe", -- "all" = enforced for everyone, "observe" = nobody enforced (flip after reading the logs)
		Others = "observe", -- "observe" | "off"
		Default = { Rate = 15, Burst = 30 },
		Limits = {
			GetPlayerState = { Rate = 30, Burst = 60 }, -- the HUD polls it hard during the first 20 s
			RequestFire = { Rate = 30, Burst = 45 }, -- CombatConfig.FireRemoteRate 20 / burst 28
			VehicleDriveInput = { Rate = 30, Burst = 40 }, -- drive stream 15 / s + Hello / Exit
			RequestVehicleFire = { Rate = 20, Burst = 30 }, -- AircraftWeaponConfig 12 / 16, VehicleWeaponConfig 14 / 20
			RequestPremiumWeapon = { Rate = 20, Burst = 30 }, -- VehicleConfig.Premium.MaxRequestHz 14
			RequestPurchaseUpgrade = { Rate = 10, Burst = 20 },
			RequestMapLive = { Rate = 4, Burst = 8 }, -- claude-bud JOB 30: the open map asks 2x a second
		} :: { [string]: { Rate: number, Burst: number } },
		MaxString = 64,
		MaxTableKeys = 16,
		MaxDepth = 2,
		LogSeconds = 10,
		FloodKick = { Rejects = 600, WindowSeconds = 60 }, -- 10 rejected requests / s for a whole minute
		KickMessage = "Connection reset: too many requests.",
	},

	-- client -> server remotes and their arguments (checked against the client's FireServer calls, 2026-09-29)
	Schemas = {
		GetPlayerState = {},
		RequestPurchaseUpgrade = { "table|string" },
		RequestClaimDailyReward = {},
		RequestSpawnVehicle = { "string" },
		RequestPurchaseVehicle = { "string" },
		RequestDespawnVehicle = {},
		RequestEquipWeapon = { "string" },
		RequestPurchaseWeapon = { "string" },
		RequestFire = { "table" },
		RequestReload = {},
		RequestStartMission = { "string" },
		RequestClaimMission = { "string" },
		RequestCaptureTerritory = { "string" },
		RequestAdminCommand = { "string", "string:200|number|boolean?", "string:200|number|boolean?" },
		RequestPurchaseDevProduct = { "string", "string?" },
		RequestPurchaseGamePass = { "string", "string?" },
		RequestSkipTutorial = {},
		RequestPrestige = { "string?" },
		RequestCreateClan = { "string:32", "string:8" },
		RequestJoinClan = { "string" },
		RequestLeaveClan = {},
		RequestClaimBattlePassReward = { "number", "string?" },
		RequestRecruitSoldiers = { "number?" },
		RequestDismissSoldiers = { "number?" },
		RequestSquadOrder = { "string" },
		RequestDeclareClanWar = { "string" },
		RedeemCode = { "string:40" }, -- Code Bot v102: a RemoteFunction (CodesService); RequestRedeemCode is unused now (sink)
		RequestSetNation = { "table" },
		RequestClaimSpinner = {},
		RequestAnalyticsEvent = { "string", "string?" },
		RequestTipSetting = { "boolean" }, -- claude-bud JOB 24 §5
		RequestTipsReplay = {}, -- claude-bud JOB 24 §5
		RequestBuyArmour = { "number" }, -- claude-bud JOB 26
		RequestMapLive = {}, -- claude-bud JOB 30
		RequestSiteActivity = { "string:8", "string:24?" }, -- claude-bud JOB 31
		RequestNuke = { "string:8", "string:40?" }, -- claude-bud JOB 33
		RequestAchievements = {}, -- claude-bud JOB 34
		RequestArmySend = { "number|string:40" }, -- claude-bud JOB 38 plot id; Code Bot army command: or "A:<area>" / "S:<site>" / "B:<plot>"
		RequestArmySendCheck = { "number|string:40" }, -- claude-bud JOB 38 (+ Code Bot: a target id)
		RequestEndgameBuy = { "string:16", "string:32?" }, -- claude-bud JOB 39: kind + id only, never a price
		RequestEndgameState = {}, -- claude-bud JOB 39
		RequestRivalAction = { "string:8", "number?" }, -- claude-bud JOB 41 C: "open" | "send", plot id (telemetry only)
		RequestMissionReroll = { "string:48" }, -- claude-bud JOB 49 C: the mission id only
		RequestRecruitPackResult = { "string:8" }, -- claude-bud JOB 41 B: "shown" | "dropped" (checked in the service)
		RequestRatePromptAnswer = { "string:8" }, -- claude-bud JOB 40 D: one answer word (the service checks the enum)
		RequestNotifOptInResult = { "string:12", "string?" }, -- claude-bud JOB 29: accepted / declined / unavailable, "settings"?
		RequestEventPopupSeen = { "string:32" }, -- Code Bot v192: the EventConfig.Id (the service checks it)
		RequestArmourLook = { "boolean" }, -- claude-bud JOB 26 -- claude-bud JOB 24 §10 (AnalyticsConfig.Roblox.ClientEvents only)
		RequestResearch = { "string", "string?" },
		RequestMissileStrike = { "table" },
		VehicleDriveInput = { "table" },
		RequestVehicleFire = { "table" },
		RequestSetDrawn = { "boolean" },
		RequestPlazaAirstrike = {},
		RequestGroupReward = {},
		RequestPremiumWeapon = { "string", "Vector3" },
		RequestBoardSetting = { "boolean" }, -- claude-bud BOARDS
		OfferResult = { "string:32", "string:12", "number?" }, -- Code Bot v153: offer key, shown / dropped / refused, AckId
	} :: { [string]: { string } },
}

function SecurityConfig.GateLiveFor(userId: any): boolean
	local mode = SecurityConfig.RemoteGate.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
	end
	return false
end

return SecurityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">ShopOverhaulConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 36 (2026-09-30): the SHOP OVERHAUL (docs/claude-queue/JOB35-36-shop-and-guns.md). Prices and Ids stay
	in MonetizationConfig; this file says what changes while the overhaul is live for a player.
	  1. Shop order (Order, below) and PERMANENT on every pass row; "BEST VALUE" on 2x Cash.
	  2. Cash packs scale: grant = max(Floor, Minutes x the buyer's passive $/min), computed in ProcessReceipt before
	     any mutation (MonetizationService). The Shop rows and offers show the same live amount (the server publishes
	     WE_PassivePerMin; ShopOverhaulService).
	  3. Duplicates: the Speed Pass and Army Expansion leave the Shop (HideWhenLive); the Speed stand and the death offer
	     sell Speed Boost; the army-wiped offer sells Bigger Army. Owners keep what they bought (SpeedMultFor / the army
	     cap read ownership, not the Shop).
	  4. VIP (199 R$ — codebot_v142: owner has NOT approved 349; MonetizationConfig VIP.OverhaulRobuxPrice = 199): +50 % Cash (was 25 %), a daily VIP supply crate (~10 min of income, profile.VipSupplyAt), the lounge,
	     the [VIP] chat tag and a gold chat name. Every current VIP owner gets it.
	  5. New passes (Id 0 until the owner creates them): War Chest (counts as 2x Cash + Auto Collect + VIP + Bigger
	     Army; hidden once all four are owned), Super Soldiers (+25 % army damage and soldier HP), Double HP (x2 MaxHealth).
	Kill switch: Live (RetentionConfig.Live rule: OwnerFirst = UserId 470626172 + Studio). Off = the old shop exactly.
]]

export type Pack = { Floor: number, Minutes: number }

local ShopOverhaulConfig = {
	Live = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v142 launch (owner 2026-09-30 16:24): everyone
	},

	--[[ SUPPLY tab order: each Shop row name ("ShopRow_<key>") takes the first matching pattern's place; rows in the
		same place keep their old order. FREE rows -> War Chest -> 2x Cash -> VIP -> Auto Collect -> Starter Pack ->
		BP Premium -> Bigger Army -> Super Soldiers -> Double HP -> Speed Boost -> (other passes) -> Armory guns ->
		premium vehicles -> cash packs -> consumables. ]]
	Order = {
		"^ShopRow_fr_",
		"^ShopRow_RecruitPack$", -- claude-bud JOB 41 B: the Recruit Pack on top (shown only once its Id is set)
		"^ShopRow_Pass_WarChest$",
		"^ShopRow_Pass_DoubleCash$",
		"^ShopRow_Pass_VIP$",
		"^ShopRow_Pass_AutoCollect$",
		"^ShopRow_StarterBundle$",
		"^ShopRow_PremiumPass$",
		"^ShopRow_Pass_BiggerArmy$",
		"^ShopRow_Pass_SuperSoldiers$",
		"^ShopRow_Pass_DoubleHP$",
		"^ShopRow_SpeedBoost$",
		"^ShopRow_Pass_DoubleXP$",
		"^ShopRow_Pass_PG_",
		"^ShopRow_Pass_PV_",
		"^ShopRow_Pass_ExtraGarageSlot$",
		"^ShopRow_Pass_",
		-- claude-bud JOB 42: the time packs take the cash place (only built while shown); the old four stay for OFF
		"^ShopRow_Cash4h$",
		"^ShopRow_Cash2h$",
		"^ShopRow_Cash1h$",
		"^ShopRow_Cash30m$",
		"^ShopRow_Cash15m$",
		"^ShopRow_CashMega$",
		"^ShopRow_CashLarge$",
		"^ShopRow_CashMedium$",
		"^ShopRow_CashSmall$",
		"^ShopRow_",
	} :: { string },
	BestValueKey = "DoubleCash",
	BestValueLabel = "BEST VALUE",
	PermanentPrefix = "PERMANENT · ",

	-- grant = max(Floor, Minutes x passive $/min) — Ids and prices unchanged (MonetizationConfig)
	CashPacks = {
		CashSmall = { Floor = 10000, Minutes = 5 },
		CashMedium = { Floor = 50000, Minutes = 20 },
		CashLarge = { Floor = 200000, Minutes = 60 },
		CashMega = { Floor = 2000000, Minutes = 180 },
	} :: { [string]: Pack },
	PerMinAttribute = "WE_PassivePerMin", -- server -> the buyer's client (display only; ProcessReceipt recomputes)
	PerMinPublishSeconds = 10,

	--[[ claude-bud JOB 42: TIME-based cash packs ("buy X minutes of your cash"), owner-first. Grant = max(Floor, Minutes x
		his income) at RECEIPT time (ProcessReceipt). Live in the Shop = TimePacksLiveFor AND TimePacksReady (all five Ids
		set); until then the old JOB 36 rows stay. The Floors are a proposed minimum for new players, chosen so both the
		minutes per R$ and the floor $ per R$ rise with the price (15m 0.60 / 400 -> 4h 0.86 / 717): a bigger pack is always
		the better deal, so BEST VALUE on 4h is honest. ExcludeTimedBoosts: the income leaves out the TIMED multipliers
		(profile.CashBoost, the Double Cash event) so the pack does not double while a boost runs. NO 1-day / 7-day pack. ]]
	TimePacks = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone (still hidden until all five Ids are set: TimePacksReady)
		Order = { "Cash4h", "Cash2h", "Cash1h", "Cash30m", "Cash15m" }, -- Shop order, biggest first
		Packs = {
			Cash4h = { Minutes = 240, Floor = 200000, Title = "4 HOURS OF CASH", Label = "4 hours of cash" },
			Cash2h = { Minutes = 120, Floor = 100000, Title = "2 HOURS OF CASH", Label = "2 hours of cash" },
			Cash1h = { Minutes = 60, Floor = 50000, Title = "1 HOUR OF CASH", Label = "1 hour of cash" },
			Cash30m = { Minutes = 30, Floor = 25000, Title = "30 MIN OF CASH", Label = "30 minutes of cash" },
			Cash15m = { Minutes = 15, Floor = 10000, Title = "15 MIN OF CASH", Label = "15 minutes of cash" },
		},
		BestValueKey = "Cash4h",
		BestValueLabel = "BEST VALUE",
		ExcludeTimedBoosts = true,
		HideOldKeys = { CashSmall = true, CashMedium = true, CashLarge = true, CashMega = true },
		PerMinAttribute = "WE_TimePackPerMin", -- display only, from the same publish tick as WE_PassivePerMin
		MinimumText = "(minimum)", -- the amount line while the floor is what he gets
		-- the income bucket on RobuxPurchase (never the exact income)
		PerMinBuckets = { { Min = 100000, Text = "100k+" }, { Min = 10000, Text = "10k+" }, { Min = 1000, Text = "1k+" }, { Min = 100, Text = "100+" }, { Min = 0, Text = "0-99" } },
	},

	-- duplicates
	HideWhenLive = { ImpulseSpeed = true, ExtraSoldierSlot = true } :: { [string]: boolean },
	SpeedStandProduct = "SpeedBoost", -- the base Speed stand sells this dev product (was the first live: the Speed Pass)
	DeathOfferProduct = "SpeedBoost",
	ArmyWipedPass = "BiggerArmy",

	Vip = {
		CashBonusMult = 0.5, -- +50 % (MonetizationConfig VIP.CashBonusMult stays 0.25 for the old path)
		SupplyMinutes = 10, -- the daily crate = this many minutes of passive income
		SupplyFloor = 5000,
		SupplyEveryHours = 20, -- once a day (20 h so a daily player never misses one)
		GoldName = true, -- WE_VIPGold: the chat name is gold too
	},
	SuperSoldiers = { PassKey = "SuperSoldiers", Mult = 1.25 }, -- army damage and soldier HP (the player DPS cap stays)
	DoubleHP = { PassKey = "DoubleHP", Mult = 2 }, -- player MaxHealth (ArmourService base)
}

local RetentionConfig = require(script.Parent.RetentionConfig)

function ShopOverhaulConfig.LiveFor(userId: any): boolean
	return RetentionConfig.Live(ShopOverhaulConfig.Live, userId)
end

-- a cash pack's grant for a passive income of perMin $/min (nil = not a scaling pack)
function ShopOverhaulConfig.CashPackAmount(key: string, perMin: number): number?
	local p = ShopOverhaulConfig.CashPacks[key]
	if p == nil then
		return nil
	end
	local rate = if typeof(perMin) == "number" and perMin == perMin and perMin > 0 and perMin < 1e12 then perMin else 0
	return math.max(p.Floor, math.floor(p.Minutes * rate))
end

-- claude-bud JOB 42: the time packs
function ShopOverhaulConfig.TimePacksLiveFor(userId: any): boolean
	return RetentionConfig.Live(ShopOverhaulConfig.TimePacks, userId)
end

-- a time pack's grant for an income of perMin $/min (nil = not a time pack); an integer, at most 2^53
function ShopOverhaulConfig.TimePackAmount(key: string, perMin: number): number?
	local p = ShopOverhaulConfig.TimePacks.Packs[key]
	if p == nil then
		return nil
	end
	local rate = if typeof(perMin) == "number" and perMin == perMin and perMin > 0 and perMin < 1e12 then perMin else 0
	return math.min(math.max(p.Floor, math.floor(p.Minutes * rate)), 2 ^ 53)
end

-- all five time-pack Ids are set in MonetizationConfig (the Shop swap waits for every one)
function ShopOverhaulConfig.TimePacksReady(): boolean
	local MC: any = require(script.Parent.MonetizationConfig)
	for _, key in ipairs(ShopOverhaulConfig.TimePacks.Order) do
		local def = MC.DevProducts[key]
		if typeof(def) ~= "table" or (tonumber(def.Id) or 0) == 0 then
			return false
		end
	end
	return true
end

-- LIVE for the Shop / the offers: the flag AND all five Ids
function ShopOverhaulConfig.TimePacksShown(userId: any): boolean
	return ShopOverhaulConfig.TimePacksLiveFor(userId) and ShopOverhaulConfig.TimePacksReady()
end

function ShopOverhaulConfig.PerMinBucket(perMin: number): string
	local n = tonumber(perMin) or 0
	for _, b in ipairs(ShopOverhaulConfig.TimePacks.PerMinBuckets) do
		if n >= b.Min then
			return b.Text
		end
	end
	return "0-99"
end

-- the VIP supply crate for a passive income of perMin $/min
function ShopOverhaulConfig.VipSupplyAmount(perMin: number): number
	local v = ShopOverhaulConfig.Vip
	local rate = if typeof(perMin) == "number" and perMin == perMin and perMin > 0 and perMin < 1e12 then perMin else 0
	return math.max(v.SupplyFloor, math.floor(v.SupplyMinutes * rate))
end

-- the place of a Shop row (1 = first); rows matching nothing go last
function ShopOverhaulConfig.Rank(rowName: string): number
	for i, pattern in ipairs(ShopOverhaulConfig.Order) do
		if string.find(rowName, pattern) ~= nil then
			return i
		end
	end
	return #ShopOverhaulConfig.Order + 1
end

return ShopOverhaulConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">SiteActivityConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 31 (2026-09-30): things to DO at the new sites (WorldSitesConfig). Server SiteActivityService; the
	Missions panel lists them under ACTIVITIES with START / GO. Everything is decided on the server: who started it,
	kills credited by CombatService (the killer), time limits, rewards.

	GARRISONS ("enemy patrols"): a few hostile soldiers posted at the camps, the ridge, the scrapyard and the depot.
	  * They wake when a player the switch is live for comes within WakeStuds and sleep beyond SleepStuds.
	  * Leashed to the site (they move around inside it, never across the map).
	  * They come back RespawnSeconds after the garrison is cleared.
	  * They use CombatService's normal NPC slots (MaxActiveNPCs), never the special over-cap headroom.

	ACTIVITIES: one at a time per player, each with a time limit, a reward and a per-player cooldown. Activity NPCs are
	that player's own group (GroupId "Act.<UserId>") and are removed when the activity ends.
	  ClearCamp   "Clear the camp": kill the soldiers at the camp.
	  Depot       "Capture the depot": clear the guards, then hold the depot zone for HoldSeconds.
	  Convoy      "Defend the convoy": hold the checkpoint while Waves come in; stay in the zone.
	  Cache       "Find the supply cache": a crate is hidden at a site; the GO line leads to the site, then search and
	              hold the prompt.
	  Sniper      "Rooftop sniper": from the Overwatch tower deck, drop Targets posted soldiers far off. Only kills
	              made while standing on the deck count.

	Kill switch: Enabled = false (no garrisons, no activities, no ACTIVITIES section). OwnerFirst as RetentionConfig.Live
	(the owner + Studio test players first; garrisons wake only for them).
]]

export type ActivityDef = {
	Id: string,
	Kind: string,
	Title: string, -- <= 24 characters (the row title)
	Desc: string, -- <= 42 characters, device-neutral
	Site: string, -- WorldSitesConfig site Id (Cache: one of Sites)
	Sites: { string }?,
	Short: string, -- the GO marker label (<= 12)
	Seconds: number, -- time limit
	Cooldown: number, -- per player, after a finish (win or lose)
	Cash: number,
	XP: number,
	Gold: number?,
	Npc: { string }?, -- NPC types spawned for it
	Waves: number?,
	WaveGap: number?,
	HoldSeconds: number?,
	Targets: number?,
}

local SiteActivityConfig = {
	Enabled = true,
	OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
	PushSeconds = 1, -- state push to the player while an activity runs (<= 1 Hz)
	ZonePadStuds = 12, -- the zone = the site radius + this

	Garrisons = {
		Enabled = true,
		WakeStuds = 250,
		SleepStuds = 380,
		RespawnSeconds = 180,
		CheckSeconds = 2,
		Sites = {
			CampViper = { "Infantry", "Infantry", "HeavyInfantry" },
			DustCamp = { "Infantry", "Infantry", "Infantry" },
			Overwatch = { "Infantry", "Infantry" },
			Anvil = { "Infantry", "HeavyInfantry" },
		} :: { [string]: { string } },
	},

	Activities = {
		{ Id = "ClearViper", Kind = "ClearCamp", Title = "Clear Camp Viper", Desc = "Defeat the soldiers at Camp Viper.", Site = "CampViper", Short = "CAMP", Seconds = 240, Cooldown = 600, Cash = 6000, XP = 150, Npc = { "Infantry", "Infantry", "Infantry", "HeavyInfantry" } },
		{ Id = "TakeKestrel", Kind = "Depot", Title = "Capture Kestrel Depot", Desc = "Clear the guards, then hold the depot.", Site = "Kestrel", Short = "DEPOT", Seconds = 300, Cooldown = 600, Cash = 8000, XP = 200, Npc = { "Infantry", "Infantry", "HeavyInfantry" }, HoldSeconds = 30 },
		{ Id = "HawkConvoy", Kind = "Convoy", Title = "Defend the Convoy", Desc = "Hold Hawk Checkpoint until it passes.", Site = "Hawk", Short = "CONVOY", Seconds = 150, Cooldown = 600, Cash = 7000, XP = 180, Npc = { "Infantry", "Infantry", "Infantry" }, Waves = 3, WaveGap = 30 },
		{ Id = "FindCache", Kind = "Cache", Title = "Find the Supply Cache", Desc = "Search the site for the hidden crate.", Site = "DryWell", Sites = { "DryWell", "PumpSeven", "Anvil" }, Short = "CACHE", Seconds = 300, Cooldown = 420, Cash = 4000, XP = 100, Gold = 5 },
		{ Id = "RidgeSniper", Kind = "Sniper", Title = "Rooftop Sniper", Desc = "From the ridge tower, drop 5 far targets.", Site = "Overwatch", Short = "PERCH", Seconds = 150, Cooldown = 600, Cash = 7500, XP = 200, Npc = { "Infantry" }, Targets = 5 },
	} :: { ActivityDef },

	Sniper = { MinStuds = 90, MaxStuds = 150, PerchStuds = 6 }, -- targets 90-150 studs from the perch; "on the deck" = within 6 studs of it
	Cache = { HideStuds = 30, HoldSeconds = 1.5, PromptStuds = 10 },
}

return SiteActivityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">SocialConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Code Bot v102: social / community text shown in-game (the Codes panel).
	v104 (Code Bot, owner 2026-09-29): the real Bud Studios Discord invite. In-game it is PLAIN TEXT only
	(DiscordInviteText in a TextLabel: never a button, never a TextBox, never clickable), and only for a player whose
	PolicyService AllowedExternalLinkReferences lists "Discord" (Roblox's rule for naming off-platform socials);
	everyone else sees just DiscordText. Also add the invite in Creator Hub -> Social Links (the clickable one).
]]

local SocialConfig = {
	-- the line under the Redeem button in the Codes panel
	DiscordText = "Join Bud Studios Discord for free codes!",
	-- v104: the Bud Studios server (config / Creator Hub Social Links); never shown in-game as a link
	DiscordInvite = "https://discord.gg/tkjA2DFBmZ",
	-- v104: what the Codes panel shows (plain text, no scheme), policy-gated
	DiscordInviteText = "Discord: discord.gg/tkjA2DFBmZ",
}

return SocialConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">SoldierConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Army + Training Yard worker income (MT-inspired: soldiers generate cash while "training").
	Visual: R15-ready config keys; catalog IDs live in VisualAssetConfig.Characters.
	If ModelAssetId missing/0 → military Part-kit placeholder (MapSetup.makeSoldierKit / CombatService).
]]

local SoldierConfig = {
	StartingSoldiers = 5,
	MaxSoldiersBase = 50,
	SoldiersPerBarracksLevel = 5,
	RecruitCostCash = 500,
	RecruitBatchSize = 1,
	DismissRefundMult = 0.25,
	SoldierHealth = 100,
	SoldierDamage = 12,
	SoldierSpeed = 14,

	-- Training Yard passive (owned soldiers → cash each tick)
	TrainingIncome = {
		TickSeconds = 5,
		CashPerSoldierPerTick = 8, -- 5 soldiers ≈ $8/s effective over tick (40/5s)
		MinSoldiersForIncome = 1,
	},

	--[[
		R15-ready visual path (Design Bot / Code P0).
		VisualKind maps → VisualAssetConfig.Characters[kind].
		VisualPlaceholder = Part-kit camo soldier when catalog ID is 0 / insert fails.
		Do NOT invent Creator Store IDs here — leave slots; wire in VisualAssetConfig only.
	]]
	Visual = {
		Rig = "R15", -- preferred attach target; Part kit remains R6-ish fallback proportions
		VisualKindDefault = "Soldier",
		VisualKindByRole = {
			Worker = "Worker", -- v41: VisualAssetConfig.Characters.Worker 16134469614
			Infantry = "Infantry",
			Heavy = "HeavyInfantry",
			Guard = "Guard",
			BankGuard = "BankGuard",
			OilRigGuard = "OilRigGuard",
			FortGuard = "FortGuard",
			SpecialForces = "SpecialForces", -- v41 SF unit VisualKind
		},
		-- Placeholder palette when mesh missing (olive drab / desert camo)
		VisualPlaceholder = {
			Enabled = true,
			BodyColor = Color3.fromRGB(70, 85, 55),
			AccentColor = Color3.fromRGB(180, 220, 120),
			Helmet = true,
			Rifle = true,
			Note = "MapSetup.makeSoldierKit + CombatService Part kit until Design Bot mesh loads",
		},
		-- Optional future slots (TODO — no invented IDs)
		ModelAssetIdOverride = 0, -- 0 = use VisualAssetConfig.Characters
		AccessoryIds = {} :: { number }, -- TODO Design Bot
	},
}

return SoldierConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SoundConfig — every sound the client plays (W1 SND audio pass). Config first: AudioController plays these keys,
	AudioHooks maps EXISTING remotes / HUD signals onto them. Sounds are created on the CLIENT only (never on the
	server; AudioController refuses to run there).

	LICENCE (roadmap §1.4, owner decision D4 = accept Roblox's licensed sound library, in-game only).
	Every Id is one of:
	  [PSE]  Roblox licensed library, Pro Sound Effects partner upload (Creator Store) — free inside Roblox experiences.
	  [APM]  Roblox licensed library, APM / KPM partner upload (Creator Store) — free inside Roblox experiences.
	  [RBX]  Roblox-owned: the engine sounds of Roblox's own "Light Utility Vehicle" (asset 6418221666, creator Roblox).
	  [ENG]  Engine built-in content path (rbxasset://sounds/…, ships with every Roblox client; already used in v70).
	  ⚠ [PSE]/[APM] audio must NOT be used in YouTube / TikTok promos (copyright claims are likely).
	Ids come from gap/reusable_parts.md §2.4 + §2.1 V-a (Creator Store search, 2026-09-24). The owner should preview each
	one in Studio (Toolbox › Creator Store › Audio › paste the id) before a publish; to swap a sound change its Id here.
	Id 0 (or "") disables a key: AudioController.Play then returns false and never errors.

	KEY FIELDS
	  Id               asset id (number) or an engine built-in path (string "rbxasset://sounds/…")
	  Volume           0..1, × Mix.SfxMaster (or Mix.MusicMaster for Bus "Music")
	  RollOff          Enum.RollOffMode name: "InverseTapered" | "Inverse" | "Linear" | "LinearSquare" (3D plays only)
	  MaxDistance      studs. A 3D play farther than this from the camera is skipped (it would be inaudible anyway)
	  Pitch            PlaybackSpeed
	  CooldownSeconds  the same key never starts again within this (no 40 coin sounds at the ATM)
	  Priority         1..5 (optional, default 1): voice stealing and the Stinger collapse keep the higher one
	  Bus              "UI"      button taps (no collapse)
	                   "Stinger" event cues (purchase, collect, capture, level, alarms, toasts): at most ONE per
	                             Mix.StingerWindowSeconds — the higher Priority wins, so one server event that
	                             arrives as 2–3 client signals (PurchaseResult + cash float + toast) is one sound
	                   "World"   positional one-shots (Play(key, at)); CC-3 / EVENTS add their keys here
	                   "Music"   music channel (ClientSettings music toggle)
	                   "Loop"    ambience / engine channels (ClientSettings SFX toggle)
	  MaxSeconds       stop a one-shot after this (long library files, e.g. the 30 s siren)
	  LengthSeconds    busy-time hint for the voice cap before the file length is known (default Mix.DefaultLengthSeconds)
	  MinDistance      3D RollOffMinDistance (default Mix.MinDistance)
]]

export type SoundDef = {
	Id: number | string,
	Volume: number,
	RollOff: string,
	MaxDistance: number,
	Pitch: number,
	CooldownSeconds: number,
	Priority: number?,
	Bus: string?,
	MaxSeconds: number?,
	LengthSeconds: number?,
	MinDistance: number?,
}

export type EngineProfile = {
	Key: string,
	PitchMin: number, -- PlaybackSpeed at standstill
	PitchMax: number, -- PlaybackSpeed at the vehicle's WE_MaxSpeed
}

export type EngineFamily = {
	Prefix: string, -- WE_KitFamily prefix (VehicleService kit families: WheeledLight, TrackedMBT, HeliLight, JetFighter …)
	Key: string,
	PitchMin: number,
	PitchMax: number,
}

local ENG_PING = "rbxasset://sounds/electronicpingshort.wav" -- [ENG] the v70 UI click (unchanged)
local ENG_SWITCH = "rbxasset://sounds/switch.wav" -- [ENG] the v70 toast ping (unchanged)

local SoundConfig = {}

SoundConfig.Sounds = {
	-- ── UI (button taps; every existing AudioController.PlayClick caller) ─────────────────────────────────────
