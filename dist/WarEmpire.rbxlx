            <string name="Name">AchievementConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Achievements. The first three (FirstUpgrade, Cash10k, Level10) are the original set: with Live off,
	MissionService.CheckAchievements / GrantAchievement still grant them exactly as before.

	claude-bud JOB 34 (2026-09-30): the full set + chat shout-outs + Roblox badges (Services/AchievementService).
	  * ONE list here; each entry fires ONCE per player (profile.Achievements[id] = true, the existing saved map), with
	    the time in profile.AchievementsAt.
	  * Progress reads EXISTING counters (Stat = a profile path); nothing new is counted except NukeStats.Launched, the
	    counter the profile already had for it. Event = granted when that server event happens (no counter).
	  * Earner: a popup + sound + the small reward below (server-side AddCash / AddGold / AddXP, reason "achievement").
	  * Whole server: one styled TextChatService system line ("[WAR EMPIRE] <name> just ..."), rate limited (Shout).
	    Big = also a short banner at the top for everyone.
	  * BadgeId: 0 = no badge yet. codebot_v134: first 5 wired (First Blood, Duelist, First Building, War Chest,
	    Hunter). codebot_v170: next 5 wired (Six Figures, Outpost Taken, Sergeant, Millionaire, High Command);
	    11 remain for the daily badge routine (5 free per 24h GMT). Code Bot creates them in Creator Hub
	    (docs/BADGES.md) and fills the ids; the server awards only a non-zero id (pcall, UserHasBadgeAsync first,
	    retried, re-synced on join).
	  * Kill switch: Live (RetentionConfig.Live rule: OwnerFirst = UserId 470626172 + Studio). Off = the old 3-entry
	    behaviour.
	Shout text follows the player's name. Tokens: {nth} = the rebirth ordinal ("3rd"), {label} = the board title.
	Never a nation name or a flag in any line (CLAUDE.md).
]]

export type Achievement = {
	Id: string,
	DisplayName: string,
	Title: string?, -- the JOB 34 page / popup name (DisplayName stays the old toast text)
	Description: string,
	RewardCash: number,
	RewardGold: number,
	RewardXP: number,
	Stat: string?, -- a profile path ("Stats.TotalCashEarned", "LB.Kills", "Prestige" ...)
	Target: number?, -- earned when Stat >= Target
	Event: string?, -- or: earned when this event is noted ("KillNPC", "Crown")
	Shout: string?, -- the chat line after the name; nil = no chat line (popup only)
	Big: boolean?, -- also a banner for everyone
	BadgeId: number, -- 0 = no Roblox badge yet
	Order: number, -- page order
}

local AchievementConfig = {
	Live = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v131 launch: everyone (JOB 34 handoff)
	},

	-- the chat line: "[WAR EMPIRE] <name> <text>" (rich text colours; the client formats it)
	Chat = {
		Prefix = "[WAR EMPIRE]",
		PrefixColor = "#FFC83C",
		NameColor = "#7FD4FF",
		TextColor = "#FFFFFF",
		BigColor = "#FF8A3C",
	},
	-- server-wide rate limit: at most one line per GapSeconds; a player's lines inside CombineSeconds merge into one
	-- ("... (+2 more)"); the queue holds MaxQueue lines, then small ones are dropped (big ones kept)
	Shout = {
		GapSeconds = 3,
		CombineSeconds = 6,
		MaxQueue = 6,
	},
	AnnounceEveryRebirth = true, -- every rebirth gets the big line ("REBIRTHED for the 3rd time!"), not only milestones
	Banner = { Seconds = 4, MaxQueued = 2, TextPx = 18 },
	Popup = { Seconds = 4, MaxQueued = 4, Sound = "Level.Up", TextPx = 17 },
	Badges = { Retries = 3, RetryDelaySeconds = 6, SyncGapSeconds = 1 },

	Achievements = {
		FirstUpgrade = {
			Id = "FirstUpgrade",
			DisplayName = "First Brick",
			Title = "First Building",
			Description = "Purchase your first base upgrade.",
			RewardCash = 500,
			RewardGold = 0,
			RewardXP = 25,
			Stat = "Stats.UpgradesPurchased",
			Target = 1,
			Shout = "just built their first building!",
			BadgeId = 583497417329015,
			Order = 3,
		},
		Cash10k = {
			Id = "Cash10k",
			DisplayName = "War Chest",
			Description = "Earn 10,000 total Cash.",
			RewardCash = 1000,
			RewardGold = 0,
			RewardXP = 50,
			Stat = "Stats.TotalCashEarned",
			Target = 10000,
			BadgeId = 1847488248714137,
			Order = 4,
		},
		Level10 = {
			Id = "Level10",
			DisplayName = "Sergeant",
			Description = "Reach Level 10.",
			RewardCash = 0,
			RewardGold = 5,
			RewardXP = 100,
			Stat = "Level",
			Target = 10,
			BadgeId = 2735659013414286,
			Order = 8,
		},

		-- claude-bud JOB 34
		FirstKillNPC = {
			Id = "FirstKillNPC", DisplayName = "First Blood", Description = "Defeat your first enemy soldier.",
			RewardCash = 500, RewardGold = 0, RewardXP = 25, Event = "KillNPC",
			Shout = "drew first blood!", BadgeId = 772051421546625, Order = 1,
		},
		FirstPlayerKill = {
			Id = "FirstPlayerKill", DisplayName = "Duelist", Description = "Defeat another player.",
			RewardCash = 1500, RewardGold = 1, RewardXP = 50, Stat = "LB.Kills", Target = 1,
			Shout = "won their first player duel!", BadgeId = 2489884143486750, Order = 2,
		},
		PlayerKills10 = {
			Id = "PlayerKills10", DisplayName = "Hunter", Description = "Defeat 10 players.",
			RewardCash = 5000, RewardGold = 3, RewardXP = 100, Stat = "LB.Kills", Target = 10,
			Shout = "has defeated 10 players!", BadgeId = 2976613716370877, Order = 5,
		},
		PlayerKills100 = {
			Id = "PlayerKills100", DisplayName = "Warlord", Description = "Defeat 100 players.",
			RewardCash = 25000, RewardGold = 10, RewardXP = 300, Stat = "LB.Kills", Target = 100,
			Shout = "has defeated 100 players!", BadgeId = 0, Order = 12,
		},
		Cash100k = {
			Id = "Cash100k", DisplayName = "Six Figures", Description = "Earn $100,000 in total.",
			RewardCash = 2500, RewardGold = 1, RewardXP = 50, Stat = "Stats.TotalCashEarned", Target = 100000,
			Shout = "has earned their first $100,000!", BadgeId = 3066564903295841, Order = 6,
		},
		Cash1M = {
			Id = "Cash1M", DisplayName = "Millionaire", Description = "Earn $1,000,000 in total.",
			RewardCash = 10000, RewardGold = 3, RewardXP = 150, Stat = "Stats.TotalCashEarned", Target = 1000000,
			Shout = "is a MILLIONAIRE!", BadgeId = 3464730701383868, Order = 9,
		},
		Cash100M = {
			Id = "Cash100M", DisplayName = "War Tycoon", Description = "Earn $100,000,000 in total.",
			RewardCash = 100000, RewardGold = 15, RewardXP = 500, Stat = "Stats.TotalCashEarned", Target = 100000000,
			Shout = "has earned $100,000,000!", Big = true, BadgeId = 0, Order = 16,
		},
		CommandCenterMax = {
			-- Target = BaseConfig.Structures.CommandCenter.MaxLevel (the test checks they match)
			Id = "CommandCenterMax", DisplayName = "High Command", Description = "Upgrade the Command Center to max level.",
			RewardCash = 5000, RewardGold = 2, RewardXP = 100, Stat = "BaseUpgrades.CommandCenter", Target = 5,
			Shout = "maxed out their Command Center!", BadgeId = 2700577206257761, Order = 10,
		},
		FirstOutpost = {
			Id = "FirstOutpost", DisplayName = "Outpost Taken", Description = "Capture an outpost.",
			RewardCash = 2000, RewardGold = 1, RewardXP = 50, Stat = "Stats.TerritoriesCaptured", Target = 1,
			Shout = "captured their first outpost!", BadgeId = 3933837527405364, Order = 7,
		},
		PlazaCaptured = {
			Id = "PlazaCaptured", DisplayName = "Plaza Conqueror", Description = "Capture the Central Plaza.",
			RewardCash = 10000, RewardGold = 5, RewardXP = 200, Stat = "Stats.PlazaCaptures", Target = 1,
			Shout = "CAPTURED THE CENTRAL PLAZA!", Big = true, BadgeId = 0, Order = 11,
		},
		Rebirth1 = {
			Id = "Rebirth1", DisplayName = "Reborn", Description = "Rebirth for the first time.",
			RewardCash = 0, RewardGold = 5, RewardXP = 0, Stat = "Prestige", Target = 1,
			Shout = "just REBIRTHED for the {nth} time!", Big = true, BadgeId = 0, Order = 13,
		},
		Rebirth5 = {
			Id = "Rebirth5", DisplayName = "Veteran Reborn", Description = "Rebirth 5 times.",
			RewardCash = 0, RewardGold = 10, RewardXP = 0, Stat = "Prestige", Target = 5,
			Shout = "just REBIRTHED for the {nth} time!", Big = true, BadgeId = 0, Order = 17,
		},
		Rebirth10 = {
			Id = "Rebirth10", DisplayName = "Legend Reborn", Description = "Rebirth 10 times.",
			RewardCash = 0, RewardGold = 20, RewardXP = 0, Stat = "Prestige", Target = 10,
			Shout = "just REBIRTHED for the {nth} time!", Big = true, BadgeId = 0, Order = 18,
		},
		Rebirth20 = {
			Id = "Rebirth20", DisplayName = "Eternal Commander", Description = "Rebirth 20 times.",
			RewardCash = 0, RewardGold = 40, RewardXP = 0, Stat = "Prestige", Target = 20,
			Shout = "just REBIRTHED for the {nth} time!", Big = true, BadgeId = 0, Order = 19,
		},
		FirstNuke = {
			Id = "FirstNuke", DisplayName = "Doomsday", Description = "Launch a nuke from your silo.",
			RewardCash = 0, RewardGold = 10, RewardXP = 200, Stat = "NukeStats.Launched", Target = 1,
			Shout = "just LAUNCHED A NUKE!", Big = true, BadgeId = 0, Order = 15,
		},
		Army50 = {
			Id = "Army50", DisplayName = "Grand Army", Description = "Command an army of 50 soldiers.",
			RewardCash = 10000, RewardGold = 3, RewardXP = 150, Stat = "Soldiers", Target = 50,
			Shout = "now commands an army of 50 soldiers!", BadgeId = 0, Order = 14,
		},
		Streak7 = {
			Id = "Streak7", DisplayName = "Loyal Soldier", Description = "Log in 7 days in a row.",
			RewardCash = 5000, RewardGold = 3, RewardXP = 100, Stat = "DailyLogin.Streak", Target = 7,
			Shout = "logged in 7 days in a row!", BadgeId = 0, Order = 20,
		},
		WeeklyCrown = {
			Id = "WeeklyCrown", DisplayName = "Number One", Description = "Be #1 on a weekly leaderboard.",
			RewardCash = 0, RewardGold = 15, RewardXP = 200, Event = "Crown",
			Shout = "is #1 on {label} this week!", Big = true, BadgeId = 0, Order = 21,
		},
	} :: { [string]: Achievement },
}

return AchievementConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">AdminConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Add your Roblox UserIds here for admin commands + AdminPlaytestCash ]]

-- v81: owner playtest account (shaunie6); see PlaytestOwnerUserId / IsPlaytestOwner below
local PLAYTEST_OWNER_USER_ID = 470626172
local PLAYTEST_LEVEL = 100

local AdminConfig = {
	-- shaunie6 — playtest owner only (do not add random players)
	UserIds = {
		470626172,
	} :: { number },
	-- LoadProfile only: if UserId==470626172 and Cash below this, raise to this (simple max).
	-- No ForceWipe / Ensure* floors. DataStore key bump (v2) forces fresh CreateDefault.
	AdminPlaytestCash = 50_000_000,
	-- v81: owner playtest (shaunie6 only, same LoadProfile hook as AdminPlaytestCash, every join, idempotent):
	--   * Level raised to AdminPlaytestLevel (clamped to LevelConfig.MaxLevel = 100; XP 0 = the full XP of that
	--     level, LevelConfig.GetTotalXPForLevel(100) = total earned). Never lowered.
	--   * AdminPlaytestAllVehicles: every VehicleConfig.Vehicles id written into profile.Vehicles (all Ground,
	--     all Air — helicopters, jets, bombers, transports — and all Naval).
	--   * VehicleService skips the Helipad / Airfield / Dock / Depot level, Prestige and rebirth-flag gates on
	--     SPAWN for this UserId only (AdminConfig.IsPlaytestOwner), so every aircraft spawns without the buildings.
	-- Nobody else's profile and no shared economy value is touched.
	PlaytestOwnerUserId = PLAYTEST_OWNER_USER_ID,
	AdminPlaytestLevel = PLAYTEST_LEVEL,
	AdminPlaytestAllVehicles = true,
	-- Code Bot v169 (Shaun 2026-10-01: "doesn't want to type /setrebirth"): a ONE-TIME rebirth grant on his next profile
	-- load, through PrestigeService.AdminSetRebirth (the /setrebirth path: cash / items kept, derived state refreshed,
	-- saved). Applied only if UserId is also in UserIds and profile.AdminGrants[Key] is unset; the Key is then stored,
	-- so it never re-applies (even after he rebirths further or lowers it). Already >= Rebirths: nothing changes (the
	-- Key is still stored). A new Key = a new one-time grant. nil = off.
	OwnerRebirthGrant = { UserId = PLAYTEST_OWNER_USER_ID, Rebirths = 10, Key = "rebirth10-2026-10-01" } :: { UserId: number, Rebirths: number, Key: string }?,
	-- v81: true only for the owner's playtest account (shaunie6). Pure: safe to require anywhere (server + Open
	-- Cloud checks). Used by DataService (level + vehicles on LoadProfile) and VehicleService (spawn gate bypass).
	IsPlaytestOwner = function(userId: any): boolean
		local uid = tonumber(userId)
		return uid ~= nil and uid == PLAYTEST_OWNER_USER_ID
	end,
	-- v81: the level the owner account is raised to (nil for everyone else), clamped to maxLevel (LevelConfig.MaxLevel)
	PlaytestLevelFor = function(userId: any, maxLevel: number): number?
		local uid = tonumber(userId)
		if uid == nil or uid ~= PLAYTEST_OWNER_USER_ID then
			return nil
		end
		return math.clamp(PLAYTEST_LEVEL, 1, math.max(1, math.floor(maxLevel)))
	end,
	Commands = {
		"cash",
		"givecash",
		"givegold",
		"givexp",
		"setlevel",
		"unlockall",
		"resetbase",
		"wipeprofile",
	},
	-- v71 money (M2): test commands for the money workflows. AdminService allows them for the UserIds above and,
	-- in Studio only, for any player (Local Server tests). Each is logged as ADMIN_COMMAND and replies
	-- "not built yet" until its service exists. None of them touches Cash (AdminPlaytestCash stays owner-only).
	--   grantent <key>            MonetizationService.GrantEntitlement on yourself (a MonetizationConfig pass key
	--                             or DevProduct GrantEntitlement value)
	--   givenuke <n> [tactical]   NukeService.Grant(player, "Nuke" | "TacticalNuke", n, "admin")
	--   nukecd                    NukeService.AdminResetCooldowns()
	--   vhp <pct>                 VehicleService.AdminSetHP(player, pct): your active vehicle's HP (0-100%)
	--   setprestige <n>           RebirthExpansionService.AdminSetPrestige(player, n)
	--   openzone <id>             RebirthExpansionService.AdminOpenZone(player, zoneId)
	--   resetrebirth              RebirthExpansionService.AdminResetRebirth(player)
	MoneyCommands = {
		"grantent",
		"givenuke",
		"nukecd",
		"vhp",
		"setprestige",
		"openzone",
		"resetrebirth",
	} :: { string },
}

return AdminConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">AimAssistConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ W2 Combat Core (mobile plan §4.1, contracts §1.4): server-validated aim assist.

	The server (CombatService/CombatAssist) picks at most ONE target per accepted hitscan shot when the exact ray
	missed and the P0-7 claim did not confirm a target: the alive player or NPC with the smallest sideways distance
	from the fire ray, inside this class's lateral / cone limits, within min(weapon Range, MaxRangeStuds), in front
	of whatever scenery the ray hit, with a clear line of sight. The client (AimTargets) reads Classes and
	MaxRangeStuds to mirror the same cone for its camera aim help; the server stays authoritative.

	The input class comes from the fire payload's Input field and is stored on the Player as ClassAttribute. A
	change is accepted at most once per ClassChangeSeconds. A PC that claims Touch gains at most 2.5 studs / 4°.

	Limits that hold in every version (never tune past these):
	  - assist never extends range and never passes walls;
	  - one target per shot, at the weapon's own fire rate;
	  - no headshot on claims or assist;
	  - no direct assist for projectiles (RocketLauncher, Grenade);
	  - TargetUserId / TargetNpcId never choose an assist target. ]]

export type AssistClass = {
	LateralStuds: number, -- max distance of the target torso from the fire ray
	MaxConeDeg: number, -- max angle between the fire ray and the target torso
}

local AimAssistConfig = {
	Enabled = true,
	Classes = {
		Touch = { LateralStuds = 2.5, MaxConeDeg = 4 },
		Gamepad = { LateralStuds = 2.0, MaxConeDeg = 3 },
		KeyboardAndMouse = { LateralStuds = 1.0, MaxConeDeg = 1.5 },
	} :: { [string]: AssistClass },
	MaxRangeStuds = 150, -- assist range = min(weapon Range, this): sniper assist stops at 150
	DefaultClass = "KeyboardAndMouse",
	ClassChangeSeconds = 5,
	ClassAttribute = "WE_InputClass",
	ExcludeClanAllies = true,
	LosPastTorsoStuds = 2,
	-- Aircraft guns (AirWeaponService, gun mounts only; rockets / bombs never, missiles lock instead): the same rules
	-- (one target per shot at the gun's own rate, never past the gun Range or MaxRangeStuds, never through walls,
	-- no clan allies, no spawn-shielded players), with a wider lateral window because the pilot aims the whole
	-- aircraft. Class = the fire payload's input class, else the player's WE_InputClass.
	Aircraft = {
		Classes = {
			Touch = { LateralStuds = 5, MaxConeDeg = 3 },
			Gamepad = { LateralStuds = 4, MaxConeDeg = 2.5 },
			KeyboardAndMouse = { LateralStuds = 2.5, MaxConeDeg = 1.5 },
		} :: { [string]: AssistClass },
		MaxRangeStuds = 220,
	},
}

return AimAssistConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">AircraftWeaponConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Aircraft weapons (owner request, part 2): only combat aircraft are armed.

	WHO IS ARMED (explicit per vehicle id; every VehicleConfig "Air" id is in exactly one of Aircraft / Unarmed):
	  attack / gunship helicopters  nose gun + rockets
	  fighters                      gun + homing missiles
	  strike jets (stealth jet too) bombs
	  bombers                       bomb drop (a stick of bombs per press)
	  transport, cargo, medevac, AWACS, tanker, scout, utility, rescue, trainer, recon: unarmed

	SWITCH: WeaponsLive = false ships the feature dark. LiveFor(userId) is true while WeaponsLive is true, or for the
	owner's playtest account (AdminConfig.IsPlaytestOwner, UserId 470626172) so the owner can test it on live.
	The SERVER evaluates it (AirWeaponService) and mirrors it on the Player as WE_AirWeaponsLive (display only).

	SERVER (AirWeaponService): RequestVehicleFire { M = mount id (a Weapons key in this aircraft's loadout),
	D = aim direction (unit Vector3), I = input class (optional, assist class only) } — nothing else is read (never a
	target id). Validated: rate limit, live for this player, seated in the DriverSeat of a live registered aircraft,
	the mount in its loadout, magazine / reload, fire interval, finite direction (clamped into ArcDeg around the
	nose). Guns are server hitscan (+ the aircraft assist class in AimAssistConfig.Aircraft, line of sight); rockets,
	missiles and bombs are server ordnance (AirOrdnance: kinematic, one ray per step, gravity for bombs; missiles
	home only on a target the server chose, in LockConeDeg / LockRange with line of sight). Damage goes through
	CombatService.ApplyHit / ApplyRadiusDamage and VehicleHealth.ApplyRadiusDamage; gates and gate guards through
	GateDefenseService.ApplyDamage (via ApplyHit). Clan allies, novice-shielded players (and their vehicles and
	bases), raid-shielded / new-player-protected bases and protected vehicles are never damaged.

	WEAPON FIELDS
	  Kind            "Gun" | "Rocket" | "Missile" | "Bomb"
	  Label           2-4 letters on the fire button (no key names, no real-world names)
	  Damage          per hit (gun) / per projectile (direct + splash centre)
	  Class           VehicleCombatConfig.DamageClasses key (vehicle damage maths live in VehicleHealth)
	  VsInfantryMult  x against players, NPCs and gate guards
	  Rate            triggers per second (the server fires when now - last >= FireIntervalSlack / Rate)
	  Range           gun: ray length; ordnance: Speed x MaxSeconds (for the gate reach check)
	  SpreadDeg       gun cone
	  ArcDeg          the aim is clamped into this cone around the aircraft's nose (ignored by bombs)
	  Magazine        { Size, ReloadSeconds } — auto reload when empty
	  ShotsPerFire    projectiles per trigger (rocket pair, bomb stick); ShotIntervalSeconds between them
	  Splash / SplashMinMult  radius and edge multiplier (linear falloff)
	  Speed / MaxSeconds / GravityFactor  ordnance kinematics (GravityFactor x Workspace.Gravity)
	  TurnRateDeg / LockRange / LockConeDeg / ProximityFuse  missiles
	  InheritVelocity / DropSpeed / MaxInheritSpeed  bombs: start velocity = aircraft velocity x InheritVelocity
	                  (magnitude capped) + DropSpeed down
	  Hook            VisualAssetConfig.VehicleWeapons key (v79 vehicle-gun hooks): its Mount kit part is the muzzle
	                  / bay, and its allow-list must hold every aircraft that carries this weapon
	  MuzzleForward / MuzzleDrop  studs from the mount part (along the nose / down); MirrorX alternates pods L / R ]]

local AdminConfig = require(script.Parent.AdminConfig)

export type Magazine = { Size: number, ReloadSeconds: number }
export type WeaponDef = {
	Kind: string,
	Label: string,
	Damage: number,
	Class: string,
	VsInfantryMult: number,
	Rate: number,
	Range: number,
	SpreadDeg: number?,
	ArcDeg: number,
	Magazine: Magazine,
	ShotsPerFire: number?,
	ShotIntervalSeconds: number?,
	Splash: number?,
	SplashMinMult: number?,
	Speed: number?,
	MaxSeconds: number?,
	GravityFactor: number?,
	TurnRateDeg: number?,
	LockRange: number?,
	LockConeDeg: number?,
	ProximityFuse: number?,
	InheritVelocity: number?,
	DropSpeed: number?,
	MaxInheritSpeed: number?,
	Hook: string,
	MuzzleForward: number?,
	MuzzleDrop: number?,
	MirrorX: boolean?,
}

local AircraftWeaponConfig = {
	WeaponsLive = true, -- v138 (Code Bot, owner 2026-09-30 14:44): aircraft weapons ON for everyone (was dark except the owner's playtest account via LiveFor)

	RemoteRate = 12, -- RateLimitService "air_fire": 12/s, burst 16 (client sends <= 10/s: gun Rate cap)
	RemoteBurst = 16,
	FireIntervalSlack = 0.9, -- lag tolerance on the fire interval
	MountIdMaxLength = 32,
	LiveAttribute = "WE_AirWeaponsLive", -- Player attribute (server-written, display only)
	AmmoAttributePrefix = "WE_AW_", -- aircraft Model: WE_AW_<mount> = rounds left, WE_AW_<mount>_Rl = reload s (0 = none)
	HitIdPrefix = "V_", -- HitOpts.WeaponId = "V_<mount>" (the M6 vehicle-gun id form)
	GateReachSlack = 60, -- gate / guard hits: attacker within the weapon's Range + this (GateDefenseService)

	Ordnance = { StepHz = 20, MaxLivePerPlayer = 10, MaxLiveServer = 48, SpawnForwardStuds = 2 },
	Splash = { LosLiftStuds = 1.5 }, -- gate / guard splash line of sight starts this far above the blast

	Weapons = {
		-- attack helicopters: chin gun (follows the aim inside 35° of the nose)
		HeliNoseGun = {
			Kind = "Gun",
			Label = "GUN",
			Damage = 15,
			Class = "SmallArms",
			VsInfantryMult = 1,
			Rate = 8,
			Range = 220,
			SpreadDeg = 1.5,
			ArcDeg = 35,
			Magazine = { Size = 120, ReloadSeconds = 5 },
			Hook = "AirNoseGun",
			MuzzleForward = 1.5,
			MuzzleDrop = 1.2,
		},
		-- attack helicopters: rocket pods, a pair per trigger
		HeliRockets = {
			Kind = "Rocket",
			Label = "RKT",
			Damage = 110,
			Class = "Explosive",
			VsInfantryMult = 0.5,
			Rate = 1,
			Range = 308,
