        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">SupplyDropConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic Supply Drops (loot-crate theme) — stand near crate to claim Cash.
	World spawns only; not a paid RNG loot box (see LootBoxConfig.PolicyPending).

	W3 step 2, lane F (spec w3s2 §3): a crate is 2 parts (crate + lid; no Neon ring, beacon ball or straps) and at
	most 2 exist, so the busiest 512-stud circle stays <= 500 with the bank's transients (489 static + 2 × 2 crate
	parts + up to 4 dropped bags in Phase B = 497). LifetimeSeconds 120 > SpawnIntervalSeconds 90, so a crate
	overlaps the next one for 30 s and MaxActive 2 is the real cap.
]]

local AdminConfig = require(script.Parent.AdminConfig)

local SupplyDropConfig = {
	Enabled = true,
	SpawnIntervalSeconds = 90,
	MaxActive = 2,
	LifetimeSeconds = 120,
	ClaimHoldSeconds = 2.5,
	ClaimRadius = 10,
	CashMin = 2500,
	CashMax = 12000,
	-- Prefer WE_EventSpawn pads; else scatter on open ground
	ScatterRadius = 900,
	ScatterMinDistanceFromOrigin = 120,
	CrateSize = Vector3.new(5, 4, 5),
	CrateColor = Color3.fromRGB(210, 160, 55),
	LidColor = Color3.fromRGB(180, 140, 50),
	LabelLiftStuds = 3, -- label centre above the lid

	--[[ claude-bud JOB 4.1 (2026-09-29): the parachute AIRDROP. Every IntervalSeconds (while a player it is live for is
		in the server) one crate falls from DropHeight under a canopy (FallSeconds) onto a random open spot (the same
		picker as the crates: event pads, else open ground), shows an objective marker to those players, and the FIRST
		of them to hold ClaimHoldSeconds within ClaimRadius gets Cash (server-side, EconomyService.AddCash). Gone after
		LifetimeSeconds. 3 parts while falling (crate, lid, canopy), 2 on the ground. Rollout "owner" =
		AdminConfig.IsPlaytestOwner only, "all" = everyone, anything else = off (the game as before). ]]
	Airdrop = {
		Rollout = "all", -- v101
		FirstDelaySeconds = 60,
		IntervalSeconds = 600,
		DropHeight = 160,
		FallSeconds = 12,
		LifetimeSeconds = 300,
		ClaimRadius = 12,
		ClaimHoldSeconds = 2,
		CashMin = 15000,
		CashMax = 40000,
		CanopyColor = Color3.fromRGB(96, 110, 70),
	},
}

-- claude-bud: is the airdrop live for this player (fail closed)
function SupplyDropConfig.AirdropLiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("Airdrop") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = SupplyDropConfig.Airdrop.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return AdminConfig.IsPlaytestOwner(userId)
	end
	return false
end

return SupplyDropConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">TerritoryConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Territories + coastal oil platforms with capture stipends.
	F10 (owner's 11 features, lane K1): Starter = one owner-only Home Outpost per plot at plot-local (LocalX, LocalZ),
	about 100 studs out of the gate. While Starter.Enabled, the loop at the bottom appends Starter_P1 .. Starter_P6 to
	Territories (IsStarter = true, PlotId = n, BonusType "EmpireTax", BonusValue 0; worth
	EconomyConfig.OutpostIncomeBuff.StarterPct, never a stack, no stipend, cannot be stolen, evicted or nuked).
	Off = no rows, nothing changes. No require cycle: this file requires only BaseConfig and Shared/Util/PlotFrame
	(EconomyConfig, LevelConfig and OilRigConfig mention TerritoryConfig in comments only). ]]

local BaseConfig = require(script.Parent.BaseConfig)
local PlotFrame = require(script.Parent.Parent.Util.PlotFrame)

export type TerritoryDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	CaptureTimeSeconds: number,
	BonusType: string,
	BonusValue: number,
	Position: Vector3,
	Radius: number,
	Color: Color3,
	StipendCash: number?,
	IsOilRig: boolean?,
	IsFortress: boolean?,
	GuardNPCType: string?,
	GuardCount: number?,
	-- F10 Home Outposts (TerritoryConfig.Starter)
	IsStarter: boolean?, -- true only on the Starter_P<n> rows
	PlotId: number?, -- the plot whose owner alone can capture it (OwnerOnly)
	OwnerOnly: boolean?, -- only BaseService.GetOwnerUserId(PlotId) captures or contests
	Light: boolean?, -- false = no WE_OwnerLight / stripe on the marker
}

local TerritoryConfig = {
	-- Balance knobs
	MaxPersonalTerritories = 6, -- oil + fortresses + land POIs
	ProtectionPeriodSeconds = 45,
	CaptureTickSeconds = 0.5,
	ProgressDecayPerSecond = 0.35,
	ContestedProgressMult = 0,
	ContestedDecayMult = 0.5,
	ProtectedCaptureMult = 0.25,
	RadarRevealRadius = 550,
	NPCOwnerId = -1,
	NeutralOwnerId = 0,
	-- v70 waterways: vehicle passengers neither capture nor contest (only the driver of a vehicle counts), so a crewed
	-- boat or jeep no longer contests its own capture. Naval outposts (oil rigs): WaterConfig.NavalOutposts.
	VehiclePassengersCount = false,

	-- fb4 capture lane (owner 2026-09-28: "left and rejoined and I had the circle again" / "standing on the circle it's
	-- not going through"). ReleaseOnLeave: a player's zones go back to Neutral the moment they leave the server, and a
	-- rejoin (this server or another) starts with none, so the circle has to be taken again. Home Outposts keep their F10
	-- rule (Neutral on leave, held again on rejoin once taken). false = the old soft release (a leaver keeps his zones on
	-- that server until someone takes them). EconomyConfig.OutpostIncomeBuff.PersistClaims (off) would re-plant saved
	-- claims on join and always releases on leave.
	ReleaseOnLeave = true,
	-- StandingBar: the capture bar (TerritoryController) also shows while you stand in a zone that is not counting for
	-- you: Held = your own zone, alone ("YOURS · CENTRAL PLAZA", full bar); Contested = two or more players inside
	-- ("CONTESTED · CENTRAL PLAZA", nobody gains; every player counted inside sees it, the one blocking too). Both were
	-- silent before. false = the old silence.
	StandingBar = {
		Held = true,
		Contested = true,
		HeldTitle = "YOURS", -- short, no key names (phone text)
		-- OnDisc: YOURS follows the visible disc (MapSetup's <Id>_Ring, Radius + DiscPad): on it, it shows; off it, it
		-- hides. CAPTURING and CONTESTED follow the counted reach (TerritoryCapture: the marker's half-diagonal, about
		-- 1.41 x Radius: fort walls, boats), because that reach is what takes or blocks a zone: they can start a few steps
		-- before the disc and last a few steps past it. Oil rigs keep the counted reach for YOURS too (their ring is capped
		-- at the deck and boats take them from the water). false = YOURS in the whole counted reach.
		OnDisc = true,
		DiscPad = 4, -- MapSetup ring diameter = 2 x Radius + 8; used only when the ring part is missing
		-- HeldSeconds: YOURS is a short cue: shown for this long after you step onto your own disc (or a contest there
		-- ends), then hidden until you step off and back on. 0 = shown the whole time you stand there. CONTESTED stays.
		HeldSeconds = 5,
		-- HeldAfterCapture: false = no YOURS cue the moment your own capture finishes (the "Outpost taken" toast already
		-- says it: one message at a time); it shows the next time you step onto the disc. true = shown with the toast.
		HeldAfterCapture = false,
	},

	-- F10: owner-only Home Outpost per plot (see the header). Switched on by lane Z (reversible: false removes the six
	-- rows and the tutorial falls back to 4x4 then outpost, tutorial order version 2).
	Starter = {
		Enabled = true,
		LocalX = 38, -- plot-local; +Z = out of the main gate (PlotFrame / BaseLayout frame)
		LocalZ = 252,
		Radius = 20,
		CaptureTimeSeconds = 10,
		StipendCash = 0,
		DisplayName = "Home Outpost",
		Description = "Your own outpost: +5% Empire Tax while you hold it.",
		Color = Color3.fromRGB(90, 200, 120),
		OwnerOnly = true,
		Light = false,
		IdPrefix = "Starter_P", -- row ids Starter_P1 .. Starter_P<MaxPlots>
		GroundY = 1, -- world Y of the marker centre (same as the land outposts)
	},

	-- Periodic stipend for owned territories (MT-style ~every 90s)
	CaptureStipend = {
		TickSeconds = 90,
		DefaultCash = 4000,
		OilRigCash = 14000,
		FortressCash = 10000,
		NotifyOnPayout = false, -- v71 (HUD v70 spec §4.2): silent — the cash pill counts up; no toast every 90 s
	},

	OwnerTypes = {
		Neutral = "Neutral",
		Player = "Player",
		NPC = "NPC",
		Clan = "Clan",
		Contested = "Contested",
	},

	Territories = {
		CentralPlaza = {
			Id = "CentralPlaza",
			DisplayName = "Central Plaza",
			Description = "+10% Cash from passive income while controlled.",
			CaptureTimeSeconds = 20,
			BonusType = "PassiveCashMult",
			BonusValue = 0.10,
			Position = Vector3.new(0, 1, 0),
			Radius = 70,
			Color = Color3.fromRGB(200, 200, 80),
			StipendCash = 5000,
		},
		NorthRidge = {
			Id = "NorthRidge",
			DisplayName = "North Ridge",
			Description = "+5% XP from all sources.",
			CaptureTimeSeconds = 25,
			BonusType = "XPMult",
			BonusValue = 0.05,
			Position = Vector3.new(0, 1, -1300),
			Radius = 60,
			Color = Color3.fromRGB(80, 160, 220),
			StipendCash = 4000,
		},
		SouthDocks = {
			Id = "SouthDocks",
			DisplayName = "South Docks",
			Description = "+15% mission cash rewards.",
			CaptureTimeSeconds = 25,
			BonusType = "MissionCashMult",
			BonusValue = 0.15,
			Position = Vector3.new(0, 1, 1300),
			Radius = 60,
			Color = Color3.fromRGB(70, 140, 180),
			StipendCash = 4000,
		},
		EastArmory = {
			Id = "EastArmory",
			DisplayName = "East Armory",
			Description = "+10% weapon damage.",
			CaptureTimeSeconds = 30,
			BonusType = "DamageMult",
			BonusValue = 0.10,
			Position = Vector3.new(1300, 1, 0),
			Radius = 55,
			Color = Color3.fromRGB(200, 80, 80),
			StipendCash = 4500,
		},
		WestDepot = {
			Id = "WestDepot",
			DisplayName = "West Depot",
			Description = "Vehicle spawn cooldown -20%.",
			CaptureTimeSeconds = 30,
			BonusType = "VehicleCooldownMult",
			BonusValue = -0.20,
			Position = Vector3.new(-1300, 1, 0),
			Radius = 55,
			Color = Color3.fromRGB(100, 180, 100),
			StipendCash = 4500,
		},
		OilFields = {
			Id = "OilFields",
			DisplayName = "Oil Fields",
			Description = "+50 Cash per passive tick.",
			CaptureTimeSeconds = 35,
			BonusType = "FlatPassiveCash",
			BonusValue = 50,
			Position = Vector3.new(950, 1, 950),
			Radius = 65,
			Color = Color3.fromRGB(180, 140, 60),
			StipendCash = 6000,
		},
		RadarHill = {
			Id = "RadarHill",
			DisplayName = "Radar Hill",
			Description = "Enemy radar: highlight nearby hostile players within range.",
			CaptureTimeSeconds = 40,
			BonusType = "MinimapReveal",
			BonusValue = 1,
			Position = Vector3.new(-950, 1, -950),
			Radius = 60,
			Color = Color3.fromRGB(160, 100, 200),
			StipendCash = 5500,
		},
		-- Coastal oil platforms (MT-inspired ×2 oil; WAR EMPIRE naming)
		CoastalOilAlpha = {
			Id = "CoastalOilAlpha",
			DisplayName = "Coastal Oil Alpha",
			Description = "Offshore oil platform — take it by boat (drive into the lagoon) or from the deck. Harder guards.",
			CaptureTimeSeconds = 50,
			BonusType = "FlatPassiveCash",
			BonusValue = 100,
			Position = Vector3.new(1800, 28, -750), -- deck height matches MapSetup platform
			Radius = 48,
			Color = Color3.fromRGB(190, 145, 45),
			StipendCash = 14000,
			IsOilRig = true,
			GuardNPCType = "OilRigGuard",
			GuardCount = 4,
		},
		CoastalOilBravo = {
			Id = "CoastalOilBravo",
			DisplayName = "Coastal Oil Bravo",
			Description = "Offshore oil platform — take it by boat (drive into the lagoon) or from the deck. Harder guards.",
			CaptureTimeSeconds = 50,
			BonusType = "FlatPassiveCash",
			BonusValue = 100,
			Position = Vector3.new(-1800, 28, 750),
			Radius = 48,
			Color = Color3.fromRGB(170, 125, 40),
			StipendCash = 14000,
			IsOilRig = true,
			GuardNPCType = "OilRigGuard",
			GuardCount = 4,
		},
		-- Named fortresses (MT-inspired desert forts; higher stipend)
		FortIronclad = {
			Id = "FortIronclad",
			DisplayName = "Fort Ironclad",
			Description = "Fortress stronghold — high capture stipend. Fort guards.",
			CaptureTimeSeconds = 40,
			BonusType = "PassiveCashMult",
			BonusValue = 0.08,
			Position = Vector3.new(1450, 1, -1450),
			Radius = 55,
			Color = Color3.fromRGB(140, 145, 155),
			StipendCash = 10000,
			IsFortress = true,
			GuardNPCType = "FortGuard",
			GuardCount = 4,
		},
		FortSandhold = {
			Id = "FortSandhold",
			DisplayName = "Fort Sandhold",
			Description = "Desert fortress — high capture stipend. Fort guards.",
			CaptureTimeSeconds = 40,
			BonusType = "PassiveCashMult",
			BonusValue = 0.08,
			Position = Vector3.new(-1450, 1, 1450),
			Radius = 55,
			Color = Color3.fromRGB(190, 155, 90),
			StipendCash = 10000,
			IsFortress = true,
			GuardNPCType = "FortGuard",
			GuardCount = 4,
		},
	} :: { [string]: TerritoryDef },
}

-- F10: the Home Outpost rows, built only while Starter.Enabled (require time; pure math, no instances).
if TerritoryConfig.Starter.Enabled then
	local st = TerritoryConfig.Starter
	for n = 1, BaseConfig.MaxPlots do
		local p = PlotFrame.LocalToWorld(n, st.LocalX, st.LocalZ)
		local id = st.IdPrefix .. tostring(n)
		TerritoryConfig.Territories[id] = {
			Id = id,
			DisplayName = st.DisplayName,
			Description = st.Description,
			CaptureTimeSeconds = st.CaptureTimeSeconds,
			BonusType = "EmpireTax",
			BonusValue = 0,
			Position = Vector3.new(p.X, st.GroundY, p.Z),
			Radius = st.Radius,
			Color = st.Color,
			StipendCash = st.StipendCash,
			IsStarter = true,
			PlotId = n,
			OwnerOnly = st.OwnerOnly,
			Light = st.Light,
		}
	end
end

-- F10: true for a Home Outpost row (TerritoryService.IsStarterId, NukeConfig target filter, radar, lists).
function TerritoryConfig.IsStarterDef(def: TerritoryDef?): boolean
	return def ~= nil and def.IsStarter == true
end

return TerritoryConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">TrainingYardConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Training Yard (owner feedback 2026-09-27: "the soldier training area is terrible, very very bad"). One per base,
	built by TrainingYardBuilder (called from MapSetup's plot build), the same at every base level.

	The look: a 3-lane shooting range seen from behind the firing line (3 soldiers at the line with an ammo box each,
	rifles toward white targets with a red ring, a sand berm behind the targets, a rifle rack along the side), and
	beyond the berm a small obstacle course (2 log hurdles and a jump wall with a ladder) and a
	supply corner (a canvas tent, a crate stack, an ammo crate). The strip behind the firing line stays open, so the
	phone camera behind a player at the line sees down the lanes. No text, no lights, no Neon, no SurfaceGuis, no
	billboards.

	Coordinates: yard-local studs. X / Z are offsets from BaseLayoutConfig.Courtyard.TrainingYard (plot-local), +X is
	downrange (the targets), +Z toward the main gate. Y is the BOTTOM of a piece above the plot pad top (Y = PadTop is on
	the range floor). Yaw is degrees about +Y (CFrame.Angles(0, rad(Yaw), 0)); a figure faces its -Z, so Yaw = -90 faces
	downrange. Cylinders lie along their X axis.

	Parts (headless census, every level): 65 per yard with the Part look (HEAD 84), 76 when every Roblox mesh below has
	loaded (a mesh on a colliding host keeps the host as an invisible collider; a mesh on a non-colliding host replaces
	it; decor meshes have no host). Figures are makeSoldierKit statues (R-RIG turns them into Roblox's Soldier body).

	Meshes: Roblox-made Synty pieces (creator Roblox, User 1) from packs that already load live (0 new load attempts);
	the textured ones all share the one Dungeon pack atlas (the log is the live, texture-cleared DesertKit.Log),
	VisualAssetConfig.DesertKit keys through VisualAssetService.CloneKitMesh, deferred. A failed or skipped load keeps
	the Part look below (it is complete on its own). UseMeshes = false: Part look only, no CloneKitMesh call.
]]

export type Piece = {
	Name: string,
	Shape: string, -- "Block" | "Cylinder" | "Wedge"
	Size: Vector3,
	X: number,
	Y: number,
	Z: number,
	Yaw: number?,
	Color: Color3,
	Material: Enum.Material,
	Collide: boolean,
	Mesh: string?, -- VisualAssetConfig.DesertKit key: the piece becomes this mesh (fitted into the piece's box)
	MeshYaw: number?, -- degrees that turn the mesh onto the piece's axes (the Synty log is long along its Z)
	Target: boolean?, -- attribute WE_TrainingTarget (+ PlotId)
}

export type Figure = { Name: string, Kind: string, X: number, Z: number, Yaw: number, Body: Color3, Accent: Color3 }

export type Decor = { Mesh: string, X: number, Y: number, Z: number, Yaw: number, Tilt: number?, Scale: number }

local C = Color3.fromRGB
local M = Enum.Material

local LANES = { -7, 0, 7 } -- yard-local Z of the three lanes
local TARGET_X = 17
local BOARD_BOTTOM = 2.5 -- above the plot pad top (the range floor is 0.2 up)
local BOARD_H = 3.4
local RING_C = BOARD_BOTTOM + BOARD_H * 0.5 -- ring / bull centre height

local pieces: { Piece } = {
	-- range floor: packed earth (read by ProducerLabels / SoldierService as "YardPad"; keep the name)
	{ Name = "YardPad", Shape = "Block", Size = Vector3.new(36, 0.6, 22), X = 8, Y = -0.4, Z = 0, Color = C(139, 118, 88), Material = M.Ground, Collide = true },
	-- painted lines: the firing line and two lane dividers
	{ Name = "FiringLine", Shape = "Block", Size = Vector3.new(0.35, 0.06, 21.4), X = -5, Y = 0.2, Z = 0, Color = C(236, 234, 224), Material = M.SmoothPlastic, Collide = false },
	{ Name = "LaneLine1", Shape = "Block", Size = Vector3.new(21.5, 0.06, 0.25), X = 5.75, Y = 0.2, Z = -3.5, Color = C(236, 234, 224), Material = M.SmoothPlastic, Collide = false },
	{ Name = "LaneLine2", Shape = "Block", Size = Vector3.new(21.5, 0.06, 0.25), X = 5.75, Y = 0.2, Z = 3.5, Color = C(236, 234, 224), Material = M.SmoothPlastic, Collide = false },
	-- backstop berm behind the targets: two wedges back to back (a ridge along Z), 6 studs high
	{ Name = "BermFront", Shape = "Wedge", Size = Vector3.new(21.4, 6, 3.5), X = 19.75, Y = 0.2, Z = 0, Yaw = 90, Color = C(176, 150, 106), Material = M.Sand, Collide = true },
	{ Name = "BermBack", Shape = "Wedge", Size = Vector3.new(21.4, 6, 3.5), X = 23.25, Y = 0.2, Z = 0, Yaw = -90, Color = C(168, 142, 100), Material = M.Sand, Collide = true },
	-- obstacle course beyond the berm (runs +Z from the Research Lab walk): log, jump wall, log
	{ Name = "CourseLog1", Shape = "Cylinder", Size = Vector3.new(10, 1.6, 1.6), X = 33, Y = 0, Z = -10, Color = C(110, 84, 58), Material = M.Wood, Collide = true, Mesh = "Log", MeshYaw = 90 },
	{ Name = "CourseWall", Shape = "Block", Size = Vector3.new(10, 5, 0.8), X = 33, Y = 0, Z = -4.5, Color = C(126, 98, 66), Material = M.WoodPlanks, Collide = true },
	{ Name = "CourseLog2", Shape = "Cylinder", Size = Vector3.new(10, 1.6, 1.6), X = 33, Y = 0, Z = 1, Color = C(104, 80, 55), Material = M.Wood, Collide = true, Mesh = "Log", MeshYaw = 90 },
	-- supply corner beyond the berm, south of the course (out of the view down the lanes): canvas tent (two wedges,
	-- ridge along X), a crate stack and an ammo crate
	{ Name = "TentNorth", Shape = "Wedge", Size = Vector3.new(7, 4.2, 2.75), X = 31, Y = 0, Z = 7.875, Yaw = 0, Color = C(96, 108, 72), Material = M.Fabric, Collide = true },
	{ Name = "TentSouth", Shape = "Wedge", Size = Vector3.new(7, 4.2, 2.75), X = 31, Y = 0, Z = 10.625, Yaw = 180, Color = C(88, 100, 66), Material = M.Fabric, Collide = true },
	{ Name = "SupplyCrate1", Shape = "Block", Size = Vector3.new(2.5, 2.5, 2.5), X = 37, Y = 0, Z = 6.5, Color = C(120, 92, 58), Material = M.Wood, Collide = true, Mesh = "YardCrate" },
	{ Name = "SupplyCrate2", Shape = "Block", Size = Vector3.new(2.5, 2.5, 2.5), X = 37, Y = 0, Z = 9.1, Color = C(112, 86, 54), Material = M.Wood, Collide = true, Mesh = "YardCrate" },
	{ Name = "SupplyCrate3", Shape = "Block", Size = Vector3.new(2.5, 2.5, 2.5), X = 37, Y = 2.5, Z = 7.8, Yaw = 15, Color = C(124, 96, 60), Material = M.Wood, Collide = true, Mesh = "YardCrate" },
	{ Name = "AmmoCrate", Shape = "Block", Size = Vector3.new(1.9, 1.9, 1.9), X = 36.8, Y = 0, Z = 12.2, Yaw = 10, Color = C(70, 78, 58), Material = M.Metal, Collide = true, Mesh = "YardAmmoCrate" },
}

-- targets: board on two legs, red ring, black bull; the board faces the firing line (-X)
for i, z in ipairs(LANES) do
	table.insert(pieces, { Name = "TrainingTarget" .. i, Shape = "Block", Size = Vector3.new(0.3, BOARD_H, 3.2), X = TARGET_X, Y = BOARD_BOTTOM, Z = z, Color = C(236, 232, 218), Material = M.SmoothPlastic, Collide = true, Target = true })
	table.insert(pieces, { Name = "TargetStand" .. i, Shape = "Block", Size = Vector3.new(0.35, 2.7, 0.35), X = TARGET_X + 0.25, Y = 0.2, Z = z - 1.15, Color = C(92, 70, 48), Material = M.Wood, Collide = true })
	table.insert(pieces, { Name = "TargetLeg" .. i, Shape = "Block", Size = Vector3.new(0.35, 2.7, 0.35), X = TARGET_X + 0.25, Y = 0.2, Z = z + 1.15, Color = C(92, 70, 48), Material = M.Wood, Collide = true })
	table.insert(pieces, { Name = "TargetRing" .. i, Shape = "Cylinder", Size = Vector3.new(0.08, 2.6, 2.6), X = TARGET_X - 0.19, Y = RING_C - 1.3, Z = z, Color = C(190, 42, 36), Material = M.SmoothPlastic, Collide = false })
	-- a small ammo box at each firing point (beside the soldier's feet, low: the view down the lane stays open)
	table.insert(pieces, { Name = "AmmoBox" .. i, Shape = "Block", Size = Vector3.new(1.2, 1.2, 1.2), X = -6.2, Y = 0.2, Z = z + 1.7, Yaw = 8, Color = C(70, 78, 58), Material = M.Metal, Collide = true, Mesh = "YardAmmoCrate" })
	table.insert(pieces, { Name = "TargetBullseye" .. i, Shape = "Cylinder", Size = Vector3.new(0.08, 0.9, 0.9), X = TARGET_X - 0.25, Y = RING_C - 0.45, Z = z, Color = C(28, 28, 30), Material = M.SmoothPlastic, Collide = false })
end

local TrainingYardConfig = {
	UseMeshes = true, -- false: the Part look only (no CloneKitMesh call, no pack load from the yard)
	GroundY = 0.5, -- plot pad top in MapSetup's plot frame F
	PadTop = 0.2, -- the range floor's top above the plot pad top
	-- origin when BaseLayoutConfig is off (the legacy yard centre); otherwise Courtyard.TrainingYard
	LegacyOrigin = { X = -14, Z = 48 },

	Pieces = pieces,

	-- the soldiers at the firing line: makeSoldierKit statues (R-RIG: Roblox's Soldier, standing still, rifle forward),
	-- root 2.1 above the range floor like the old yard workers (feet on the floor)
	FigureRootY = 2.3,
	FigureHealth = 80,
	Figures = {
		{ Name = "YardShooter1", Kind = "Infantry", X = -7, Z = LANES[1], Yaw = -90, Body = C(70, 85, 55), Accent = C(180, 220, 120) },
		{ Name = "YardShooter2", Kind = "HeavyInfantry", X = -7, Z = LANES[2], Yaw = -90, Body = C(50, 55, 48), Accent = C(230, 160, 50) },
		{ Name = "YardShooter3", Kind = "Guard", X = -7, Z = LANES[3], Yaw = -90, Body = C(45, 55, 70), Accent = C(90, 140, 220) },
	} :: { Figure },

	-- mesh-only decor (no Part look; nothing is built when the mesh does not load). Y = the mesh CENTRE above the plot
	-- pad top; Tilt = degrees about the mesh's X after Yaw; Scale = one uniform factor on the piece's own size.
	Decor = {
		{ Mesh = "YardRack", X = -4.5, Y = 1.85, Z = -11.6, Yaw = 0, Scale = 0.85 }, -- rifle rack along the range's north edge
		{ Mesh = "YardLadder", X = 30.5, Y = 3.29, Z = -5.45, Yaw = 0, Tilt = 18, Scale = 0.42 }, -- leans on the jump wall
	} :: { Decor },
	MaxMeshesPerYard = 16, -- hard cap on CloneKitMesh pieces per yard (dressed pieces + decor; 11 configured)

	-- invisible anchors other code reads (TrainingYard folder): YardAnchor (fallback) over the range centre, and
	-- YardEarnAnchor: ManualDropperService puts the yard cash plate at it + ManualDropperConfig.YardOffset (6, 0, -4),
	-- so the plate lands at yard-local (-10, -13): on open ground at the corner of the Research Lab walk, off the range
	-- floor, 22 studs from the range centre (ProducerLabels shows the yard label within 24)
	YardAnchor = { X = 8, Y = 7.5, Z = 0 },
	YardEarnAnchor = { X = -16, Y = 5.5, Z = -9 },
}

return TrainingYardConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">TutorialConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Interactive tutorial steps — short plain copy, one step at a time.
	v71 P1-15: device-neutral copy (about 80% of players are on phones): no key names, no "click"; the chip's GO
	button runs CtaAction. Buy steps point at the structure's own console (console-only buying): at L0 the BUY
	button there reads BUILD. The beam target of every step is the player's OWN plot (TutorialController.ResolveTarget).
	Hints stay <= 42 characters: the objective chip shows 2 hint lines, about 44 characters on an 800x360 phone.

	F6 (owner's 11 features, lane K2), OrderVersion 2, the owner's 7-step order:
	  1 ClaimBase  2 CommandCenter  3 Income (the old ClickDropper step is folded in: a cash drop also counts)
	  4 RecruitSoldiers  5 Barracks  6 Outpost (the own Home Outpost)  7 Jeep
	The outpost-before-4x4 order is only legal with the Home Outpost (F10, TerritoryConfig.Starter): without it the
	nearest zone is a 34-45 s walk, over the 30 s travel rule. So OutpostBeforeJeep() follows Starter.Enabled, and
	while it is false the last two steps swap to Jeep then Outpost (the 4x4 is the shortcut to the zone).
	v72's Ammo Works step 6 is gone: the first war business is introduced after the tutorial by the NEXT chip
	(TycoonGuideConfig.PickMode "Cheapest": Ammo Works L1 $600 is the cheapest pad once the tutorial is done).

	AdvanceOn lists the TutorialService.Notify event types that finish a step (PlotAssigned | Upgrade |
	RecruitSoldiers | PassiveIncome | ManualDrop | SpawnVehicle | CaptureTerritory). An "Upgrade" finishes a step only
	when its detail (the structure id) equals the step's PadStructureId. Step Ids are stable save keys: a saved
	TutorialStep index is read in the order its TutorialOrderVersion names (missing = 1 = LegacyOrderV1) and moved to
	this order by MigrateLegacyStep.

	Lane Z (the Home Outpost switch-on): an order version names ONE fixed order (SavedOrder), so OrderVersion follows
	the switch: 2 = the owner's steps with the 4x4 before the outpost (the order v2 saves were made in, Home Outpost
	off), 3 = the owner's order, outpost before the 4x4 (Home Outpost on). A save made in another known order is
	migrated when it loads, in either direction; a step it already did that the new order puts later (a v2 save that
	spawned the 4x4 and still owes the outpost) is carried as DoneAhead, so it is never asked for twice.
]]

local TerritoryConfig = require(script.Parent.TerritoryConfig)

export type TutorialStepDef = {
	Id: string,
	Title: string,
	Hint: string,
	MarkerName: string,
	HighlightHint: string?,
	PadStructureId: string?,
	CtaAction: string?,
	CtaLabel: string?,
	-- F6: the Notify event types that finish this step (see the header)
	AdvanceOn: { string },
	-- F5 pointer while this step is active (chevrons / GO line): "ATM" = the player's own ATM. nil = the step's
	-- PadStructureId console when it has one, else no floor pointer (Recruit / Outpost / Jeep: GO opens a panel or
	-- the zone beam leads).
	Pointer: string?,
}

local TutorialConfig = {
	Enabled = true,
	-- F6: the order a profile's TutorialStep index is saved in (ProfileSchema stamps new profiles with it;
	-- TutorialService migrates other known versions with MigrateLegacyStep, then stamps it). Lane Z: 3 while the
	-- Home Outpost is on (outpost, then 4x4), 2 while it is off (4x4, then outpost); see SavedOrders.
	OrderVersion = if TerritoryConfig.Starter.Enabled == true then 3 else 2,
	-- The v1 order (v31 .. v72) by step Id, index = the saved TutorialStep. "ClickDropper" and v72's "AmmoWorks"
	-- (step 6 while the businesses were on) are not steps any more: LegacyAlias names the step that replaces them.
	LegacyOrderV1 = {
		"ClaimBase",
		"Income",
		"ClickDropper",
		"CommandCenter",
		"RecruitSoldiers",
		"Barracks",
		"Jeep",
		"Outpost",
	} :: { string },
	LegacyAlias = { ClickDropper = "Income", AmmoWorks = "Barracks" } :: { [string]: string },
	-- Lane Z: the fixed order of every later OrderVersion, by step Id (index = the saved TutorialStep). 2 is the order
	-- the v2 build shipped with (Home Outpost off: 4x4 6, outpost 7); 3 is the owner's order (outpost 6, 4x4 7).
	SavedOrders = {
		[2] = { "ClaimBase", "CommandCenter", "Income", "RecruitSoldiers", "Barracks", "Jeep", "Outpost" },
		[3] = { "ClaimBase", "CommandCenter", "Income", "RecruitSoldiers", "Barracks", "Outpost", "Jeep" },
		-- claude-bud JOB 41: the Guided order (only while TutorialConfig.Guided is live for a NEW player; see GuidedSteps)
		[4] = { "ClaimBase", "CommandCenter", "Income", "RecruitSoldiers", "FirstFight", "Outpost", "Reward", "Barracks", "Jeep" },
		-- claude-bud JOB 48: the Hook order (Guided.Hook live): v4 + RAID A RIVAL BASE after the reward + Open MISSIONS last
		[5] = { "ClaimBase", "CommandCenter", "Income", "RecruitSoldiers", "FirstFight", "Outpost", "Reward", "RaidRival",
			"Barracks", "Jeep", "Missions" },
	} :: { [number]: { string } },
	-- Lane Z: the steps whose finish is carried (DoneAhead) when a new order puts them after the step a save moves to:
	-- the Outpost / 4x4 pair the Home Outpost switch reorders. Any other done step after it is asked again (K2's "first
	-- step not done" rule: a v1 save that collected before buying the Command Center is taught to collect again).
	CarryDoneIds = { Outpost = true, Jeep = true } :: { [string]: boolean },
	-- The owner's order (OutpostBeforeJeep() true). BuildSteps swaps Outpost and Jeep while it is false.
	Steps = {
		{
			Id = "ClaimBase",
			Title = "Your base",
			Hint = "Walk to the glowing pad on your plot.",
			MarkerName = "Tutorial_ClaimBase",
			HighlightHint = "BasePad",
			CtaAction = "WatchHud",
			CtaLabel = "GO TO BASE",
			AdvanceOn = { "PlotAssigned" },
		},
		{
			Id = "CommandCenter",
			Title = "Command Center",
			Hint = "Follow the gold line, then press BUILD.",
			MarkerName = "Tutorial_CommandCenter",
			HighlightHint = "Console",
			PadStructureId = "CommandCenter",
			CtaAction = "PadBuy",
			CtaLabel = "GO",
			AdvanceOn = { "Upgrade" },
		},
		{
			Id = "Income",
			Title = "Collect cash",
			Hint = "Walk up to your ATM to collect cash.",
			MarkerName = "Tutorial_Income",
			HighlightHint = "CashHUD",
			CtaAction = "WatchHud",
			CtaLabel = "COLLECT",
			AdvanceOn = { "PassiveIncome", "ManualDrop" },
			Pointer = "ATM",
		},
		{
			Id = "RecruitSoldiers",
			Title = "Recruit soldiers",
			Hint = "Recruit a soldier. They train for cash.",
			MarkerName = "Tutorial_Recruit",
			HighlightHint = "Army",
			CtaAction = "OpenArmy",
			CtaLabel = "ARMY",
			AdvanceOn = { "RecruitSoldiers" },
		},
		{
			Id = "Barracks",
			Title = "Barracks",
			Hint = "Follow the gold line, then press BUILD.",
			MarkerName = "Tutorial_Barracks",
			HighlightHint = "Console",
			PadStructureId = "Barracks",
			CtaAction = "PadBuy",
			CtaLabel = "GO",
			AdvanceOn = { "Upgrade" },
		},
		{
			Id = "Outpost",
			Title = "Capture outpost",
			Hint = "Stand in a zone until it's yours.",
			MarkerName = "Tutorial_Outpost",
			HighlightHint = "Territory",
			CtaAction = "Capture",
			CtaLabel = "FIND ZONE",
			AdvanceOn = { "CaptureTerritory" },
		},
		{
			Id = "Jeep", -- JEEP-2: the id / marker stay (TutorialService, MapSetup's Tutorial_Jeep); the copy says 4x4
			Title = "Spawn 4x4",
			Hint = "Open the Garage and spawn your 4x4.",
			MarkerName = "Tutorial_Jeep",
			HighlightHint = "Garage",
			CtaAction = "OpenGarage",
			CtaLabel = "GARAGE",
			AdvanceOn = { "SpawnVehicle" },
		},
	} :: { TutorialStepDef },
}

-- F6 / F10: the owner's outpost-then-4x4 order only while the Home Outpost exists (30 s travel rule)
function TutorialConfig.OutpostBeforeJeep(): boolean
	return TerritoryConfig.Starter.Enabled == true
end

local OWNER_STEPS = TutorialConfig.Steps -- the literal list above (never changed)

-- The 7 steps in order; outpostFirst = false swaps Outpost and Jeep (Jeep 6, Outpost 7). Pure: returns a new list.
function TutorialConfig.BuildSteps(outpostFirst: boolean): { TutorialStepDef }
	local steps: { TutorialStepDef } = {}
	local iOutpost, iJeep = 0, 0
	for i, def in ipairs(OWNER_STEPS) do
		steps[i] = def
		if def.Id == "Outpost" then
			iOutpost = i
		elseif def.Id == "Jeep" then
			iJeep = i
		end
	end
	if not outpostFirst and iOutpost > 0 and iJeep > 0 then
		steps[iOutpost], steps[iJeep] = steps[iJeep], steps[iOutpost]
	end
	return steps
end

TutorialConfig.Steps = TutorialConfig.BuildSteps(TutorialConfig.OutpostBeforeJeep())

function TutorialConfig.GetStep(index: number): TutorialStepDef?
	return TutorialConfig.Steps[index]
end

function TutorialConfig.StepCount(): number
	return #TutorialConfig.Steps
end

-- Index of a step Id in `steps` (default: the current Steps), or nil
function TutorialConfig.IndexOf(id: string, steps: { TutorialStepDef }?): number?
	for i, def in ipairs(steps or TutorialConfig.Steps) do
		if def.Id == id then
			return i
		end
	end
	return nil
end

-- true when `eventType` (with `detail`) finishes step `def` (F6 AdvanceOn rule; the dispatcher TutorialService uses)
function TutorialConfig.Advances(def: TutorialStepDef?, eventType: string, detail: any?): boolean
	if def == nil or table.find(def.AdvanceOn, eventType) == nil then
		return false
	end
	if eventType == "Upgrade" then
		return def.PadStructureId ~= nil and detail == def.PadStructureId
	end
	return true
end

-- Lane Z: the step Ids, in order, of a saved OrderVersion (1 or missing = LegacyOrderV1); nil for an order this build
-- does not know (a newer build's save: left alone).
function TutorialConfig.SavedOrder(version: any): { string }?
	local v = tonumber(version) or 1
	if v == 1 then
		return TutorialConfig.LegacyOrderV1
	end
	return TutorialConfig.SavedOrders[v]
end

-- The step Ids (aliases applied) a save at `old` in `legacy` order has finished: every step before it
local function doneBefore(legacy: { string }, old: number): { [string]: boolean }
	local done: { [string]: boolean } = {}
	for i = 1, math.min(old - 1, #legacy) do
		local id = legacy[i]
		done[TutorialConfig.LegacyAlias[id] or id] = true
	end
	return done
end

--[[ F6 migration: a TutorialStep index saved in the v1 order -> the index of the first step of the current order
	(`steps`, default Steps) the player has not done yet. Every v1 step before `oldStep` counts as done, by Id through
	LegacyAlias. So v1 step 2 or 3 (Income / ClickDropper, Command Center not bought) -> 2 (Command Center, never
	skipped), v1 6 (Barracks, or v72's Ammo Works) -> 5, v1 7 (Jeep) -> the first of Outpost / Jeep in this order.
	The caller (TutorialService) then skips buy steps for structures already owned. oldStep < 1 or junk -> 1; oldStep
	past the v1 list -> #steps + 1 (done; TutorialComplete decides on its own). Pure. ]]
-- fromVersion (lane Z): the order oldStep was saved in (default 1 = LegacyOrderV1; see SavedOrder).
function TutorialConfig.MigrateLegacyStep(oldStep: any, steps: { TutorialStepDef }?, fromVersion: number?): number
	local list = steps or TutorialConfig.Steps
	local n = tonumber(oldStep)
	if n == nil or n ~= n or n < 1 then
		return 1
	end
	local old = math.floor(n)
	local legacy = TutorialConfig.SavedOrder(fromVersion) or TutorialConfig.LegacyOrderV1
	if old > #legacy then
		return #list + 1
	end
	local done = doneBefore(legacy, old)
	for i, def in ipairs(list) do
		if not done[def.Id] then
			return i
		end
	end
	return #list + 1
end

--[[ Lane Z: the steps a save already finished that the new order (`steps`, default Steps) puts AFTER the step it
	migrates to (CarryDoneIds only), as { [Id] = true }, or nil when there are none. Only the Outpost / 4x4 swap makes
	one: a v2 (or v1) save that spawned the 4x4 and still owes the outpost moves to Outpost (6 in order 3) with
	{ Jeep = true }, so the 4x4 step is skipped instead of asked for again. TutorialService keeps it on the profile
	(TutorialDoneAhead). Pure. ]]
function TutorialConfig.DoneAhead(oldStep: any, fromVersion: number?, steps: { TutorialStepDef }?): { [string]: boolean }?
	local list = steps or TutorialConfig.Steps
	local n = tonumber(oldStep)
	if n == nil or n ~= n or n < 1 then
		return nil
	end
	local old = math.floor(n)
	local legacy = TutorialConfig.SavedOrder(fromVersion) or TutorialConfig.LegacyOrderV1
	if old > #legacy then
		return nil
	end
	local target = TutorialConfig.MigrateLegacyStep(old, list, fromVersion)
	local done = doneBefore(legacy, old)
	local ahead: { [string]: boolean }? = nil
	for i, def in ipairs(list) do
		if i > target and done[def.Id] and TutorialConfig.CarryDoneIds[def.Id] == true then
			local a: { [string]: boolean } = ahead or {}
			a[def.Id] = true
			ahead = a
		end
	end
	return ahead
end

--[[ claude-bud JOB 7 (2026-09-29): the first five minutes, on top of the tutorial above (which already walks claim base,
	Command Center pad, collect cash, recruit, Barracks, outpost, 4x4, with the gold line, a touch-size two-tap Skip and
	once per profile through TutorialComplete). Added, owner-only first:
	  * Welcome: one short line on the first join of a new profile (profile.WelcomeShown), so the first seconds say
	    what to do; no screen-covering card.
	  * The first ATTACK: once the tutorial is complete (or skipped), the Army popover opens with ATTACK outlined and a
	    hint; profile.FirstAttackDone is saved on the server when he first orders ATTACK (never shown again).
	Rollout "owner" = AdminConfig.IsPlaytestOwner only, "all", anything else = off (the tutorial exactly as before). ]]
TutorialConfig.FirstMinutes = {
	Rollout = "all", -- v101
	WelcomeText = "Welcome, Commander! Follow the gold line to your base.",
	WelcomeDelaySeconds = 3,
	AttackHintText = "Tap ATTACK to send your army at enemies",
	AttackHintDelaySeconds = 6,
	AttackHintSeconds = 20,
}

function TutorialConfig.FirstMinutesLiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("FirstMinutes") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = TutorialConfig.FirstMinutes.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
	end
	return false
end

--[[ claude-bud JOB 29 (2026-09-30): FAST START, the first 60 seconds. A new player (Command Center not bought, tutorial
	not done) is already given a base on join (BaseService.AssignPlot) and moved onto it; with FastStart he lands
	StandStuds in front of his OWN Command Center console instead of at the plot gate (~168 studs away), facing it, so
	the first BUILD ($1,500 of the $10,000 start) is one step away with the gold line and the pulsing arrow on it.
	His first BUILD pays StarterPayout (server, once per profile: profile.StarterPayoutDone, reason "onboarding") with a
	coin burst flying to the cash pill. Until the tutorial is past step HoldPopupsUntilStep - 1 (the Command Center
	step), nothing covers the screen: the daily-streak card, the nation picker and promos wait (WE_Onboarding = true on
	the player while the hold is on; the server clears it). Kill switch: Enabled = false (the join exactly as before).
	OwnerFirst = true: live only for the owner (and Studio test players) first; see RetentionConfig.Live. ]]
TutorialConfig.FastStart = {
	Enabled = true,
	OwnerFirst = false, -- codebot_v136 launch (owner 2026-09-30 14:17): everyone
	StandStuds = 7, -- in front of the console face (ConsolePromptDistance is 10)
	StarterPayout = 1500,
	HoldPopupsUntilStep = 3, -- WE_Onboarding clears once TutorialStep >= this (after the Command Center) or at 60 s
	HoldMaxSeconds = 60, -- the hold never lasts longer than this, whatever the step
	WelcomeText = "Welcome! Press BUILD on the gold console.", -- <= 42 characters, no key names
	PayoutText = "Starter bonus!",
}

function TutorialConfig.FastStartLiveFor(userId: any): boolean
	return (require(script.Parent.RetentionConfig) :: any).Live(TutorialConfig.FastStart, userId)
end

--[[ claude-bud JOB 41 part A (2026-09-30): THE GUIDED FIRST 3-4 MINUTES, owner-first. A NEW player (tutorial not done,
	Command Center not bought, no building, first join < NewPlayerSeconds ago) is stamped with OrderVersion 4 (SavedOrders
	[4] / GuidedSteps): Command Center (the FastStart BUILD + payout: the big win inside ~60 s) -> collect at the ATM ->
	recruit -> FIRST FIGHT (a 2-Recruit training camp at HIS Home Outpost, real CombatService NPCs, hostile only to him)
	-> capture it -> REWARD ("BASE SECURED!", confetti, GuidedRewardCash) -> the Barracks / 4x4 as the next goals.
	Versions 2 / 3 are untouched; a v4 save whose Guided switch went off migrates back like any other order.
	OFF (Enabled = false, or not live for him): OrderVersion 3, no camp, no banner, no new events (today's game). ]]
TutorialConfig.Guided = {
	Enabled = true,
	OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone
	OrderVersion = 4,
	NewPlayerSeconds = 900, -- a profile older than this (FirstJoinUnix) never enters Guided
	HoldMaxSeconds = 300, -- the WE_Onboarding hold covers the whole chain up to Reward, never longer than this
	StuckSeconds = 90, -- "GuidedStuck" once a step has been open this long (analytics only)
	RecruitCount = 3, -- the recruit step wants him able to afford this many soldiers
	GuidedRecruitCashMax = 5000, -- the one-time top-up that covers exactly the gap to RecruitCount soldiers (0 = never)
	GuidedRewardCash = 2500, -- the one-time REWARD (reason "onboarding"): enough for the next building right away
	RewardText = "BASE SECURED!",
	RewardSub = "Your outpost is yours. Next: the Barracks.",
	CampSkipText = "The camp pulled out. Take the outpost!", -- the never-soft-lock line after MaxCampSpawns
	Camp = {
		Npc = { "Recruit", "Recruit" }, -- CombatConfig NPC types (weak on purpose)
		-- the 2 sandbag posts, relative to the Home Outpost centre (studs; on the Starter ring, Radius 20)
		Posts = { { X = -9, Z = -12 }, { X = 9, Z = -12 } },
		MaxCampSpawns = 3, -- a death / respawn / rejoin re-spawns them at full health at most this often, then auto-complete
		Label = "ENEMY CAMP",
		SandbagColor = Color3.fromRGB(150, 130, 90),
	},
	Funnel = {
		Name = "FirstMinutes",
		Steps = { "Spawned", "FirstBuild", "Collected", "Recruited", "FightStarted", "FirstKill", "Captured", "Reward",
			"NextBuilding", "Offered", "Bought" },
	},
	--[[ claude-bud JOB 48 (2026-10-01): THE HOOK, the end of the Guided chain (owner-first; OFF == today's v4 chain).
		Live (Enabled + RetentionConfig.Live, on top of Guided being live) a Guided player plays OrderVersion 5
		(SavedOrders[5]): after the REWARD the next goal is RAID A RIVAL BASE (SEND ARMY on a TARGETS row, the JOB 38
		path; ArmySendRules decide), then the Barracks, the 4x4 and Open MISSIONS. ]]
	Hook = {
		Enabled = true,
		OwnerFirst = false, -- Code Bot v175 (Shaun approved 2026-10-01): the Hook is live for everyone (was NEW-OWNER-FIRST, claude-bud JOB 48)
		OrderVersion = 5,
		-- free soldiers at the REWARD through the normal recruit path (SoldierService.GrantFree: within the army cap,
		-- never above it; no cash, no Robux). 0 = off
		RewardSoldiers = 2,
		-- the one REAL timer: a raid won within FastRaidSeconds of the reward pays FastRaidBonus once (reason
		-- "onboarding"); FastRaidBonus = 0 -> no bonus and no countdown on screen
		FastRaidSeconds = 300,
		FastRaidBonus = 2000,
		-- no rival may be raided right now (empty server, all shielded, his army too weak): the goal falls back to
		-- clearing FallbackKills hostile NPCs (any CombatService NPC he kills, the server's own camps / Ops sites); after
		-- FallbackMaxSeconds the chain moves on to the Barracks anyway (never a soft-lock)
		FallbackKills = 2,
		FallbackMaxSeconds = 180,
		RecheckSeconds = 15, -- while the raid goal is open: re-check that a rival is still allowed
		FallbackTitle = "Clear hostiles", -- <= 18 characters
		FallbackHint = "Beat 2 enemies: send your army to ATTACK.", -- <= 42 characters, no key names
		FastRaidText = "Fast raid bonus!",
		-- funnel steps 12-16 of FirstMinutes (appended after Funnel.Steps 1-11, which never change). "GoalFallbackWon"
		-- is logged at the RaidWon index (15) when the fallback goal was won instead
		FunnelSteps = { "ArmyGrew", "GoalRaidShown", "RaidSent", "RaidWon", "NextGoal" },
		FallbackWonName = "GoalFallbackWon",
		-- custom event SessionMilestone { sec } once each per session at these play seconds (the 3-minute wall)
		Milestones = { 60, 120, 180, 300, 600 },
	},
}

function TutorialConfig.GuidedLiveFor(userId: any): boolean
	return (require(script.Parent.RetentionConfig) :: any).Live(TutorialConfig.Guided, userId)
end

-- claude-bud JOB 48: the Hook (OrderVersion 5) is live only on top of a live Guided
function TutorialConfig.HookLiveFor(userId: any): boolean
	local H: any = TutorialConfig.Guided.Hook
	return typeof(H) == "table" and TutorialConfig.GuidedLiveFor(userId)
		and (require(script.Parent.RetentionConfig) :: any).Live(H, userId)
end

-- true for both Guided orders (4 and the Hook's 5)
function TutorialConfig.IsGuidedVersion(version: any): boolean
	local v = tonumber(version)
	local H: any = TutorialConfig.Guided.Hook
	return v ~= nil and (v == TutorialConfig.Guided.OrderVersion or (typeof(H) == "table" and v == H.OrderVersion))
end

-- the two new steps of the Guided order (the other seven are the owner's steps above, unchanged)
local GUIDED_NEW: { [string]: TutorialStepDef } = {
	FirstFight = {
		Id = "FirstFight",
		Title = "Clear the camp",
		Hint = "Beat the 2 enemies at your outpost.",
		MarkerName = "Tutorial_Outpost",
		HighlightHint = "Territory",
		CtaAction = "Capture",
		CtaLabel = "GO",
		AdvanceOn = { "CampCleared" },
	},
	Reward = {
		Id = "Reward",
		Title = "Base secured!",
		Hint = "Great win! Your next goal is up.",
		MarkerName = "Tutorial_Outpost",
		CtaAction = "WatchHud",
		CtaLabel = "OK",
		AdvanceOn = { "GuidedReward" },
	},
	-- claude-bud JOB 48: the Hook's two steps (OrderVersion 5)
	RaidRival = {
		Id = "RaidRival",
		Title = "Raid a rival base",
		Hint = "Tap SEND ARMY on a TARGETS row.",
		MarkerName = "",
		HighlightHint = "Targets",
		CtaAction = "OpenTargets",
		CtaLabel = "TARGETS",
		-- RaidWon: a SEND (or an in-person ATM raid) looted; GoalFallbackWon: the fallback hostiles cleared;
		-- GoalFallbackDone: the fallback timed out (the chain moves on, never a soft-lock)
		AdvanceOn = { "RaidWon", "GoalFallbackWon", "GoalFallbackDone" },
	},
	Missions = {
		Id = "Missions",
		Title = "Open Missions",
		Hint = "Daily jobs pay cash. Open MISSIONS.",
		MarkerName = "",
		HighlightHint = "Missions",
		CtaAction = "OpenMissions",
		CtaLabel = "MISSIONS",
		AdvanceOn = { "MissionsOpened", "ClaimMission" },
	},
}

local function buildGuided(version: number?): { TutorialStepDef }
	local list: { TutorialStepDef } = {}
	for _, id in ipairs(TutorialConfig.SavedOrders[version or 4]) do
		local def = GUIDED_NEW[id]
		if def == nil then
			for _, d in ipairs(OWNER_STEPS) do
				if d.Id == id then
					def = d
				end
			end
		end
		table.insert(list, def :: TutorialStepDef)
	end
	return list
end
TutorialConfig.GuidedSteps = buildGuided()
TutorialConfig.HookSteps = buildGuided(5) -- claude-bud JOB 48

-- the step list a saved order version plays (4 = GuidedSteps, 5 = HookSteps; anything else = today's Steps)
function TutorialConfig.StepsFor(version: any): { TutorialStepDef }
	if tonumber(version) == TutorialConfig.Guided.OrderVersion then
		return TutorialConfig.GuidedSteps
	end
	local H: any = TutorialConfig.Guided.Hook
	if typeof(H) == "table" and tonumber(version) == H.OrderVersion then
		return TutorialConfig.HookSteps
	end
	return TutorialConfig.Steps
end

function TutorialConfig.GetStepFor(version: any, index: number): TutorialStepDef?
	return TutorialConfig.StepsFor(version)[index]
end

-- a step definition by Id in either list (the client's per-Id lookups)
function TutorialConfig.ById(id: string): TutorialStepDef?
	local i = TutorialConfig.IndexOf(id)
	if i then
		return TutorialConfig.Steps[i]
	end
	return GUIDED_NEW[id]
end

return TutorialConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">TycoonGuideConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v72 tycoon guide: "which button next, and what does it do to my income" (owner feedback, sister's LV1/LV2 phone
	screenshots).

	The SERVER picks one next buy per player (Shared/Util/TycoonMath.PickNext) and stamps it on the Player as
	WE_NextBuy = "<Id>:<TargetLevel>" (or "Soldier:0", or "" when nothing is left / the guide is off). Clients only
	render it: the objective chip after the tutorial, the gold NEXT tag on that console and on its Base panel row, and
	the GO line to that console on the player's OWN plot. The pick is advice only; the server re-checks every buy.
	Every income number shown is dollars per second from config (TycoonMath) x the server-stamped WE_IncomeMult,
	floored to 0.1 below $10/s and to whole dollars from $10/s up, so a displayed rate never over-promises.

	Copy (Text): device-neutral (never a key name, "click" or "tap"), <= 42 characters per string, and no middle dot
	or arrow characters (the Display font has neither): parts are separated by two spaces. The phone-surface keys (ConsoleTag, BuyLane)
	live here, not in HudConfig.

	Enabled = false until integration (the lead flips it together with BusinessConfig.Enabled).

	F5 (owner's 11 features, lane K2): PickMode "Cheapest" = the one pointer is the cheapest unpaid console pad
	(TycoonMath.PickCheapest: the lowest next price among open, non-maxed structures and businesses; never soldiers or
	Robux items; affordability ignored). It drives WE_NextBuy, so the NEXT chip, the console NEXT tag, the Base-panel
	badge and the floor chevrons (Chevrons below) all agree. PickMode "Score" = the v72 Opening + payback score.
]]

local TycoonGuideConfig = {
	Enabled = true,

	-- F5: "Cheapest" (TycoonMath.PickCheapest; ties -> lower target level, then StructureOrder) | "Score" (v72 below)
	PickMode = "Cheapest",
	-- PickMode "Score" rules (TycoonMath.PickNext). Opening: the first entry that is open now (requirements met, level
	-- not owned) wins. After the Opening the candidate with the lowest score wins:
	--   score = WaitWeight * secondsUntilAffordable(wallet + ATM) + cost / ((gainPerTick + UnlockValuePerTick) / 5)
	Opening = { "CommandCenter:1", "AmmoWorks:1", "WeaponsFacility:1", "ArmsCrateLine:1", "Barracks:1" },
	WaitWeight = 1.0,
	IncludeSoldiers = true, -- "Score" only: "Recruit soldiers" is a candidate (ARMY opens the Army panel); "Cheapest" never
	SoldierCandidateId = "Soldier", -- WE_NextBuy = "Soldier:0"
	-- Soldiers are offered only while training income (soldiers x SoldierConfig.TrainingIncome.CashPerSoldierPerTick)
	-- is below this share of the total base income per tick (passive + training + plot oil).
	SoldierMaxShare = 0.34,
	-- Extra $ per tick the pick pretends a level earns, for what it unlocks. Ranking only; never shown, never paid.
	UnlockValuePerTick = {
		CommandCenter = { [1] = 1000, [2] = 40, [3] = 40 },
		VehicleDepot = { [1] = 20, [2] = 30 },
		DefensiveWalls = { [1] = 10 },
		Helipad = { [1] = 20 },
		Dock = { [1] = 15 },
	} :: { [string]: { [number]: number } },

	-- Server re-pick: after a purchase, an army change, plot ready and profile load, and every RepickSeconds. A
	-- challenger replaces the current pick only when its score < Hysteresis x the current pick's score, so the chip
	-- never flickers. WE_NextBuy is written only when the value changes.
	RepickSeconds = 15,
	Hysteresis = 0.75,
	ShowAfterTutorial = true, -- the chip takes the tutorial's slot once TutorialComplete (one message at a time)

	-- WE_IncomePerSec (EconomyService): the last amount granted per steady reason, summed, / TickSeconds (what the
	-- ATM really receives, multipliers included). A reason that misses this many ticks drops out (oil after a rebirth).
	SteadyIncomeReasons = { passive = true, training = true, plot_oil = true } :: { [string]: boolean },
	SteadyIncomeExpireTicks = 2,

	-- What a level unlocks besides income (BUY line 2 / chip hint after the $/s). <= 18 characters each.
	Unlocks = {
		CommandCenter = { [1] = "6 new buildings", [2] = "Radar + Lab", [3] = "Missile strikes" },
		Barracks = { [1] = "+5 army cap", [2] = "+5 army cap", [3] = "Special Forces", [4] = "+5 army cap", [5] = "+5 army cap" },
		VehicleDepot = { [1] = "Ground vehicles", [2] = "Helipad + Dock", [3] = "Heavy vehicles" },
		DefensiveWalls = { [1] = "Walls + guards", [2] = "Oil pumps", [3] = "Anti-heli roof", [4] = "Gate turrets" },
		Watchtowers = { [1] = "Corner towers" },
		Radar = { [2] = "Missile Defense" },
		ResearchLab = { [1] = "Research", [2] = "Special Forces" },
		Helipad = { [1] = "Helicopters", [2] = "Airfield" },
		Dock = { [1] = "Boats" },
		Airfield = { [1] = "Planes" },
		MissileDefense = { [1] = "Missile shield" },
	} :: { [string]: { [number]: string } },
	-- Unlock lines that only exist while BusinessConfig.Enabled (TycoonMath.UnlockText merges them)
	-- Droppers v1a (spec §3.9): what each business level changes, on BUY line 2 ("+$4/s  Loading bay") and in the NEXT
	-- chip's Buy hint ("$2,000  +$4/s  Loading bay"); each falls back to the plain "+$X/s" form when it does not fit.
	-- No [1]: a level-1 unlock would switch BUY line 1 to BuyBuildShort and drop "BUILD AMMO WORKS".
	-- bizlook (2026-09-27): the names say what each level adds to the building (BusinessConfig.Kit): L2 the loading
	-- unit, L3 the head office, L4 the canopy over the belt, L5 the three-storey office with the brand band.
	BusinessUnlocks = {
		WeaponsFacility = { [1] = "Arms Crate Line" },
		AmmoWorks = { [2] = "Loading bay", [3] = "Head office", [4] = "Belt canopy", [5] = "Company HQ" },
		ArmsCrateLine = { [2] = "Loading bay", [3] = "Head office", [4] = "Belt canopy", [5] = "Company HQ" },
		ArmorPlatePress = { [2] = "Loading bay", [3] = "Head office", [4] = "Belt canopy", [5] = "Company HQ" },
		RocketAssembly = { [2] = "Loading bay", [3] = "Head office", [4] = "Belt canopy", [5] = "Company HQ" },
	} :: { [string]: { [number]: string } },

	-- Upper-case short names (<= 10 characters) for the BUY button / console tag when the full name does not fit.
	-- Businesses carry their own (BusinessConfig ShortName).
	ShortNames = {
		CommandCenter = "COMMAND",
		Barracks = "BARRACKS",
		VehicleDepot = "DEPOT",
		WeaponsFacility = "WEAPONS",
		PowerStation = "POWER",
		Warehouse = "WAREHOUSE",
		DefensiveWalls = "WALLS",
		Watchtowers = "TOWERS",
		Radar = "RADAR",
		ResearchLab = "LAB",
		Helipad = "HELIPAD",
		Dock = "DOCK",
		Airfield = "AIRFIELD",
		MissileDefense = "AA DEFENSE",
		SpecialForcesFacility = "SPEC OPS",
	} :: { [string]: string },

	Text = {
		-- rates / prices (TycoonMath.PerSecText / RateText / ShortCash)
		PerSec = "+$%s/s", -- "+$3.3/s"
		Rate = "$%s/s", -- "$46/s" (Base panel subtitle)
		Pop = "+$%s", -- "+$16" over a business bin on each passive tick
		-- objective chip (after the tutorial, inside your own plot only)
		ChipTitle = "NEXT: %s", -- "NEXT: Ammo Works"
		ChipTitleUpgrade = "NEXT: %s Lv %d", -- "NEXT: Barracks Lv 2"
		ChipHintBuy = "%s  %s", -- "$600  +$3.3/s"
		ChipHintBuyUnlock = "%s  %s  %s", -- "$1,500  +$3.1/s  6 new buildings"
		ChipHintCollect = "Collect %s at your ATM", -- "Collect $1,240 at your ATM"
		ChipHintEarning = "%s  ready in %s", -- "+$3.3/s  ready in 0:42"
		ChipGo = "GO",
		ChipGoCollect = "ATM",
		ChipHide = "Hide",
		SoldierTitle = "NEXT: Recruit soldiers",
		SoldierHint = "%s each  %s each", -- "$500 each  +$1.6/s each"
		SoldierGo = "ARMY",
		-- BUY button (two lines: Display font line 1, Body font line 2)
		BuyBuild = "BUILD %s  %s", -- "BUILD AMMO WORKS  $600"
		BuyBuildShort = "BUILD  %s", -- "BUILD  $1,500" (the buy unlocks something: line 2 names it)
		BuyUpgrade = "UPGRADE %s LV %d  %s", -- "UPGRADE AMMO LV 2  $2,000"
		BuyIncome = "%s income", -- "+$3.3/s income"
		BuyIncomeUnlock = "%s  %s", -- "+$3.1/s  6 new buildings"
		BuyCollect = "COLLECT %s AT ATM", -- amber; the button fires nothing, it draws the line to your ATM
		BuyCollectLine2 = "%s when built", -- "+$3.3/s when built"
		BuyNeed = "NEED %s MORE", -- red: "NEED $1,240 MORE"
		BuyNeedLine2 = "%s  ready in %s", -- "+$3.3/s  ready in 0:42"
		CollectToast = "Follow the line to your ATM",
		-- console tag (owner-only, stud-scaled)
		TagTitleNext = "NEXT  %s", -- gold: "NEXT  AMMO WORKS"
		TagLine = "%s  %s", -- "$600  +$3.3/s" (green if wallet + ATM covers it, red otherwise)
		Locked = "Needs %s %d", -- "Needs Weapons Facility 1"
		MaxLevel = "MAX LEVEL",
		-- console screen (the 15 buildings only): "WAREHOUSE\n$3.2K\n+$5.2/s"
		ScreenLines = "%s\n%s\n%s",
		-- purchase toast: "Purchase SUCCESSFUL! Ammo Works Lv 1" .. ToastSuffix
		ToastSuffix = "  %s", -- "  +$3.3/s"
		-- Base panel
		PanelHeader = "WAR BUSINESSES",
		PanelSubtitle = "Income %s  buy at each console", -- "Income $46/s  buy at each console"
		PanelRowBuild = "Build %s  %s", -- "Build $600  +$3.3/s"
		PanelRowUpgrade = "Lv %d -> %d  %s  %s", -- "Lv 1 -> 2  $2,000  +$4.2/s"
		NextTag = "NEXT", -- the gold badge on the pick's Base panel row
		-- cash pill suffix "13,594  +$24/s": TycoonMath.RatePerSecText(WE_IncomePerSec) (PerSec)
	},

	-- Objective chip visibility (HudLayout flags; AtConsole is set by the BUY button while it is up)
	ChipRule = {
		ShowWhen = { "InOwnPlot" },
		HideWhen = { "Tutorial", "Modal", "Driving", "Dead", "RecentCombat", "AtConsole" },
	},
	AtConsoleFlag = "AtConsole",

	-- Phone surfaces (v72; here, not in HudConfig)
	ConsoleTag = {
		StudsW = 10, -- stud-scaled BillboardGui (shrinks with distance)
		StudsH = 2.6,
		DistanceLowerLimit = 10,
		MaxDistanceBuild = 18, -- unowned structure (BUILD)
		MaxDistanceUpgrade = 14, -- owned structure (UPGRADE)
		NextMaxDistance = 40, -- the pick's console
		NextColor = Color3.fromRGB(255, 208, 64),
	},
	BuyLane = {
		ThumbZoneFrac = 0.40, -- the BUY button's left edge stays right of 40% of the safe-area width ...
		ClearPx = 8, -- ... plus this many real px (TycoonMath.ActionLaneShiftV)
		TouchSize = Vector2.new(300, 72), -- v (x 0.70 on a phone = 210 x 50 real px)
	},
	AutoGuideIdleSeconds = 12, -- Build / Collect state, this long idle, farther than AutoGuideMinStuds: GO once per pick
	AutoGuideMinStuds = 20,
	HideSeconds = 300, -- "Hide" hides the chip this long, or until the next purchase acknowledgement
	TextRefreshHz = 2, -- cash pill +$/s suffix and console tags
	EtaRefreshHz = 1, -- "ready in m:ss" on the chip / BUY button
	PillIncome = true, -- "+$N/s" suffix on the cash pill (green, 20 v, not tappable)

	--[[ F5 floor chevrons (Client/Modules/NextPadChevrons, lane G): client-only, owner-only gold floor bars that lead
		from the player to TycoonMath.ApproachPoint of the pick (WE_NextBuy, else the local PickCheapest), inside the own
		plot only. Two bars at +-BarAngleDeg make one chevron; Count chevrons SpacingStuds apart, the first LeadStuds
		ahead of the player, the last StopShortStuds before the target; none within HideWithinStuds of it; points inside
		a TycoonMath.Footprints rectangle are skipped. Re-laid at RefreshHz only when the player moved
		MoveThresholdStuds or the target changed (BulkMoveTo, a 2 x Count part pool under the camera; no Neon, light,
		Beam or GUI; CastShadow off). FollowTutorial: while the tutorial runs they follow the active step instead
		(TycoonMath.GuideTarget: a PadBuy step's own pad, the Income step's ATM, else none). Hidden while any HideWhen
		flag is set (HudLayout flags; "Drawn" = weapon out). Enabled since integration (lane Z; reversible). ]]
	Chevrons = {
		Enabled = true,
		Count = 5,
		SpacingStuds = 5,
		LeadStuds = 6,
		StopShortStuds = 4,
		HideWithinStuds = 10,
		DoorLeadStuds = 5, -- walk-in approach point: this far out of the front door (TycoonMath.ApproachPoint)
		RefreshHz = 4, -- <= 10 (UI refresh cap)
		MoveThresholdStuds = 1.5,
		RetargetRetrySeconds = 1, -- the target pad is not streamed in yet: retry this often
		BarSize = Vector3.new(0.35, 0.08, 2.4),
		BarAngleDeg = 45,
		Lift = 0.12, -- above the pad top
		Color = Color3.fromRGB(255, 208, 64),
		TransparencyNear = 0.2,
		TransparencyFar = 0.55,
		HideWhen = { "Driving", "Dead", "RecentCombat", "Drawn", "Modal", "AtConsole" } :: { string },
		FollowTutorial = true,
	},
}

return TycoonGuideConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">VehicleCombatConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): vehicle HP, damage classes, destruction, regen, seat rules (premium_vehicles.md §3–§5).
	Server: VehicleHealth (W2 / M4: Server/Modules/VehicleHealth.luau) and CombatService.ApplyHit; VehicleWeaponService
	(M6). Client: VehicleCombatClient reads Ui (HP bars) for display only.

	dealt = raw × Class.Mult × WeaponMult × (1 − min(Armor / (Armor + ArmorK), MaxArmorReduction) × Class.ArmorFactor)
	MaxHP = def.Health × clamp(WE_ArmorMult, ArmorMultClamp) × GlobalHPMult (× Tank Factory bonus for ground
	vehicles, premium included — J9).

	Judge rulings applied (money/plan.md §1):
	- J8: Nuke class — any non-immune vehicle inside the nuke CoreRadius is destroyed (NukeConfig.Vehicles).
	- J9: the Tank Factory HP bonus applies to every ground vehicle the owner deploys, premium included.
	- J10: free drivers keep firing their rifle (SeatFire.DriverCanUseInfantryWeapons = true); fix the self-hit ray
	  instead. The owner may flip this (§2.7 D5).
	- J23: M7c adds HeavyRocketLauncher (AntiVehicle ×2) and AntiMaterielRifle (SmallArms ×1.5) to InfantryWeapons. ]]

export type DamageClass = {
	Mult: number,
	ArmorFactor: number,
	CoreDestroys: boolean?,
}

export type InfantryWeaponClass = {
	Class: string,
	Mult: number,
}

local VehicleCombatConfig = {
	Health = {
		GlobalHPMult = 1, -- one tuning knob for every vehicle's MaxHP
		ArmorK = 200,
		MaxArmorReduction = 0.6,
		ArmorMultClamp = { 1, 1.5 }, -- research VehicleArmor (WE_ArmorMult) range
		SpawnProtectSeconds = 5,
		AttrHz = 10, -- WE_HP / WE_MaxHP / WE_Destroyed writes (display only, never read back)
	},

	DamageClasses = {
		SmallArms = { Mult = 0.5, ArmorFactor = 1 }, -- rifles, SMG, pistol, shotgun pellets, vehicle MGs
		Explosive = { Mult = 1.5, ArmorFactor = 0.5 }, -- Grenade, rocket pods
		AntiVehicle = { Mult = 1, ArmorFactor = 0 }, -- RocketLauncher, siege cannon
		Missile = { Mult = 1, ArmorFactor = 0 }, -- Command Center strikes
		Nuke = { Mult = 1, ArmorFactor = 0, CoreDestroys = true }, -- J8
		NPC = { Mult = 0.5, ArmorFactor = 1 }, -- hostile NPC rifles at an enclosed seat
	} :: { [string]: DamageClass },

	-- Infantry WeaponConfig ids → class and WeaponMult (every other weapon: SmallArms × 1)
	InfantryWeapons = {
		RocketLauncher = { Class = "AntiVehicle", Mult = 2.0 },
		Grenade = { Class = "Explosive", Mult = 1 },
		Sniper = { Class = "SmallArms", Mult = 0.6 },
		-- M7c (J23): HeavyRocketLauncher = { Class = "AntiVehicle", Mult = 2.0 },
		--            AntiMaterielRifle = { Class = "SmallArms", Mult = 1.5 },
	} :: { [string]: InfantryWeaponClass },
	DefaultInfantryClass = "SmallArms",

	Destroy = {
		OccupantDamage = 35, -- every ejected occupant (not lethal from full health)
		DebrisSeconds = 3,
		RepairSeconds = { Default = 45, Premium = 20 }, -- redeploy lock for that vehicle id
		Reward = {
			CashPerHP = 0.08,
			CashMax = 500,
			XPPerHP = 0.02,
			XPMax = 120,
			PairCooldownSeconds = 300, -- same killer/victim pair: no bounty (alt farming)
			KillerWindowSeconds = 10, -- last attacker within this window gets the bounty
			CashReason = "vehicle_kill",
			XPReason = "vehicle_kill",
		},
	},

	Regen = {
		DelayAfterDamageSeconds = 12,
		PremiumPctPerSec = 0.015, -- premium "Field repair": anywhere
		OwnPlotPctPerSec = 0.02, -- Cash vehicles: only inside the owner's plot
		TickSeconds = 1,
	},

	RookieProtection = { BelowLevel = 10, VehicleWeaponMult = 0.5 },

	SeatFire = {
		DriverCanUseInfantryWeapons = true, -- J10 (owner decision D5)
		-- Passengers may fire their own guns from these open families; enclosed families (APC, tracked, heli, jet,
		-- sub, capital ship) may not.
		OpenFamilies = {
			WheeledLight = true,
			WheeledTruck = true,
			NavalPatrol = true,
			NavalGun = true,
			NavalLanding = true,
		} :: { [string]: boolean },
	},

	-- Who may sit where (enforced on Occupant change). Squad units count as the owner's. (D6)
	SeatPolicy = { Driver = "Owner", Gunner = "OwnerOrClan", Passenger = "Anyone" },

	-- Free 90 s test drives (PremiumVehicleConfig.Trial): no damage to or from players / vehicles, no bounty, and
	-- NPC kills carry no creator tag (no rewards).
	Trial = { DealsPlayerDamage = false, DealsVehicleDamage = false, TakesDamage = false, Bounty = false, KillRewards = false },

	-- W2 client HP bars (VehicleCombatClient; display only). Sizes are REAL px (the bar's ScreenGui has no UIScale).
	--   HudBar   occupant bar: touch = HudLayout top stack order TouchStackOrder (right above the SPD pill, 25);
	--            desktop = AnchorPoint (1, 1) at (1, -DesktopRight, 1, -DesktopBottom), just above the SPD pill.
	--            Flashes red below LowFrac; gold frame on premium vehicles.
	--   OverBar  over-vehicle BillboardGui on the Chassis: stud-scaled, never AlwaysOnTop, MaxDistance <= 40, no text;
	--            ShowSeconds after that vehicle's WE_HP drops, and on your own parked vehicle while HP < MaxHP;
	--            never on the vehicle you sit in; at most MaxShown at once (the most recent win).
	--            LabelOffset (vscale R2.3): the bar's centre this far over the vehicle's WE_LabelY (the owner nameplate's
	--            centre), so the bar is the highest thing over a tall fitted body and a player on foot beside it sees it
	--            over the roof. 1.5 keeps it clear of the nameplate's top edge (0.4 studs + 20 px high) out to 35 studs.
	--            W2 / R2.2: -0.75 (just under the nameplate, 0.08 over a fitted roof: hidden by it).
	Ui = {
		HudBar = { Width = 230, Height = 10, TouchStackOrder = 24, DesktopRight = 14, DesktopBottom = 50, LowFrac = 0.25 },
		OverBar = { WidthStuds = 4, HeightStuds = 0.35, ShowSeconds = 5, MaxDistance = 40, MaxShown = 3, LabelOffset = 1.5 },
		RefreshHz = 10,
	},
}

-- armorReduction × ArmorFactor for one hit (pure; used by VehicleHealth and the Garage stat bars)
function VehicleCombatConfig.ArmorReduction(armor: number): number
	local h = VehicleCombatConfig.Health
	local a = math.max(0, tonumber(armor) or 0)
	return math.min(a / (a + h.ArmorK), h.MaxArmorReduction)
end

function VehicleCombatConfig.DamageMult(className: string, armor: number, weaponMult: number?): number
	local c = VehicleCombatConfig.DamageClasses[className] or VehicleCombatConfig.DamageClasses.SmallArms
	return c.Mult * (weaponMult or 1) * (1 - VehicleCombatConfig.ArmorReduction(armor) * c.ArmorFactor)
end

return VehicleCombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">VehicleConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Deep vehicle roster (~95): Ground / Air / Naval unlock ladder.
	KitFamily drives VehicleService Part kits (grows to 100 without rewrite).
	Generic military names only — no real brands, no MT names. JEEP-2 (roadmap §1.4): DisplayName is what players see
	("Field 4x4", "Armed 4x4"); the ids / keys ("MilitaryJeep", "ArmedJeep") stay, because saves and ownership key on them.
]]

-- World v2 air box (WorldConfig.Bounds.Air: { X, ZMin, ZMax, MaxY }): the ONE source for the aircraft turn-back law
-- (VehicleDriveClient) and the server validator's air bounds (VehicleService). nil when WorldConfig is missing or
-- malformed: then both sides keep the old numbers (SoftBound / WorldHalfExtent / MaxAltitude).
local AIR_BOX: { X: number, ZMin: number, ZMax: number, MaxY: number }? = nil
do
	local ok, box = pcall(function(): any
		local W: any = require(script.Parent.WorldConfig) -- a missing / broken WorldConfig errors inside the pcall
		return W.Bounds.Air
	end)
	if ok and typeof(box) == "table" then
		local x, z0, z1, y = box.X, box.ZMin, box.ZMax, box.MaxY
		if typeof(x) == "number" and typeof(z0) == "number" and typeof(z1) == "number" and typeof(y) == "number" then
			if x > 0 and z1 > z0 and y > 0 then
				AIR_BOX = { X = x, ZMin = z0, ZMax = z1, MaxY = y }
			end
		end
	end
end

export type VehicleCategory = "Ground" | "Air" | "Naval"

export type KitFamily =
	"WheeledLight"
	| "WheeledTruck"
	| "WheeledAPC"
	| "TrackedIFV"
	| "TrackedMBT"
	| "TrackedSPAAG"
	| "TrackedArtillery"
	| "HeliLight"
	| "HeliTransport"
	| "HeliAttack"
	| "JetFighter"
	| "JetStrike"
	| "JetBomber"
	| "JetTransport"
	| "NavalPatrol"
	| "NavalGun"
	| "NavalLanding"
	| "NavalCapital"
	| "NavalSub"

export type VehicleDef = {
	Id: string,
	DisplayName: string,
	Category: VehicleCategory,
	Rarity: string,
	UnlockLevel: number,
	Health: number,
	Speed: number,
	Seats: number,
	Armor: number,
	CostCash: number,
	KitFamily: KitFamily,
	KitScale: number?, -- visual scale mult (default 1)
	RequiresStructure: { StructureId: string, Level: number }?,
	RequiresPrestige: number?,
	RequiresRebirthFlag: string?,
	MeshAssetId: number?,
	TextureAssetId: number?,
}

local function V(
	id: string,
	name: string,
	cat: VehicleCategory,
	rarity: string,
	level: number,
	health: number,
	speed: number,
	seats: number,
	armor: number,
	cost: number,
	kit: KitFamily,
	opts: {
		Scale: number?,
		Struct: { StructureId: string, Level: number }?,
		Prestige: number?,
		RebirthFlag: string?,
	}?
): VehicleDef
	local scale: number? = nil
	local struct: { StructureId: string, Level: number }? = nil
	local prestige: number? = nil
	local rebirthFlag: string? = nil
	if opts then
		scale = opts.Scale
		struct = opts.Struct
		prestige = opts.Prestige
		rebirthFlag = opts.RebirthFlag
	end
	return {
		Id = id,
		DisplayName = name,
		Category = cat,
		Rarity = rarity,
		UnlockLevel = level,
		Health = health,
		Speed = speed,
		Seats = seats,
		Armor = armor,
		CostCash = cost,
		KitFamily = kit,
		KitScale = scale,
		RequiresStructure = struct,
		RequiresPrestige = prestige,
		RequiresRebirthFlag = rebirthFlag,
	}
end

local D = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "VehicleDepot", Level = l }
end
local H = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "Helipad", Level = l }
end
local A = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "Airfield", Level = l }
end
local N = function(l: number): { StructureId: string, Level: number }
	return { StructureId = "Dock", Level = l }
end

--[[ claude-bud JOB 5a (2026-09-29): ROBUX-ONLY vehicles (the Premium* rows in Vehicles). Each clones the best cash
	vehicle of its role (same kit; LookId = its store body / colours) and is only slightly stronger (about +5 % HP and
	armour, +3 % speed; tools/checks/claude_bud_money.py compares). Bought ONLY with its own game pass
	(Premium.PassKey, MonetizationConfig.GamePasses): VehicleService.Purchase refuses cash for any def with Premium,
	RequestSpawn needs the pass and the rollout (MonetizationConfig.SkuLiveFor), pass owners skip the repair wait.
	CostCash 0 is never "free": the Premium check comes first. UnlockLevel 1, no prestige; the spawn structure at L1. ]]
local function P(d: VehicleDef, passKey: string, lookId: string): VehicleDef
	local x: any = d
	x.Premium = { PassKey = passKey }
	x.LookId = lookId
	return d
end

