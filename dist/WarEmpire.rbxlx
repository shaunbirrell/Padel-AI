-- Town v2 (densify) ────────────────────────────────────────────────────────────────────────────────────────────────
local STOREY = 7 -- studs per storey (TownBlock)

local function tokens(s: string?): { [string]: boolean }
	local t: { [string]: boolean } = {}
	if s ~= nil then
		for w in string.gmatch(s, "[^+]+") do
			t[w] = true
		end
	end
	return t
end

--[[ A town block: height and street frontage for few parts. The walls are ONE solid part (cover, H4), the cornice ONE
	parapet slab, each upper storey ONE inset window strip per face, the ground floor a door or a shopfront (rolled
	shutter + cloth awning), plus cheap rooftop details. The pivot is the footprint centre on the floor; the front (door,
	shopfront, window strips) faces local -Z.
	Opts: Width (local X, 8..48, default 20), Depth (local Z, 8..48, default 16), Storeys (1..6, default 2; 5+ = a
	concrete tower block), Color (walls; trim = 20 % darker), Lantern (a soft night lamp beside the door),
	Variant ("+"-joined): "shop" (shutter + awning instead of the door), "side" / "left" / "rear" (window strips on the
	+X / -X / back face too),
	"damaged" (the top storey's +X half is blown off: remnant + the fallen floor slab on the broken roof, no parapet),
	"gutted" (a burnt-out shell: back and side walls, a ground-floor front stub, the collapsed floor leaning inside);
	W3 step 2: "roller" (one vehicle-wide roller door, min(12, W - 6) x 5.6, instead of the door: +0 parts; "shop" wins),
	"metal" (corrugated-metal colour and material for the walls and trim: +0 parts; opts.Color still wins),
	"hall" (a walk-in hall: back wall, 2 side walls and 2 front piers round a centred full-height opening
	clamp(W - 8, 4, 10) wide, all 1.2 thick and collidable, + 1 roof slab carrying the parapet (the block's one shadow
	caster) + the usual upper window strips; no door or shutter, "damaged" is ignored: exactly 7 parts at Storeys 2 with
	no Roof / Lantern / side strips);
	Roof ("+"-joined): "bare" (no parapet), "tank" / "tanks" (1 / 2 water tanks), "hut" (stair hut), "mast" (antenna,
	2 parts), "dish" (1 part). Every part stays inside the parapet footprint (W + 0.8) x (D + 0.8), except the awning
	(3.1 in front) and the lantern (0.8 in front). One shadow caster per block (its body, or a shell's back wall: H9,
	the Town keeps <= 60 casters for phones). ]]
Builders.TownBlock = function(b: B)
	local o = b.Opts
	local W = math.clamp(o.Width or 20, 8, 48)
	local D = math.clamp(o.Depth or 16, 8, 48)
	local S = math.clamp(math.floor(o.Storeys or 2), 1, 6)
	local v, roof = tokens(o.Variant), tokens(o.Roof)
	local tower = S >= 5
	local metal = v.metal == true
	local mat = if metal then M.Metal elseif tower then M.Concrete else M.Sandstone
	local wall = o.Color or (if metal then PAL.Metal elseif tower then PAL.ConcreteLight else PAL.Adobe)
	local trim = wall:Lerp(Color3.new(0, 0, 0), 0.2)
	local H = S * STOREY
	local fz = -D * 0.5 -- the front face
	local rng = b.Rng

	if v.gutted then
		put(b, "RuinWallBack", Vector3.new(W, H, 1.2), CFrame.new(0, H * 0.5, D * 0.5 - 0.6), wall, mat, true, true)
		local sh = math.max(H - 2, 4)
		put(b, "RuinWallSide", Vector3.new(1.2, sh, D - 1.2), CFrame.new(-W * 0.5 + 0.6, sh * 0.5, -0.6), trim, mat, true)
		local fw = math.floor(W * 0.45 + 0.5)
		local fh = if S == 1 then 4 else STOREY + 1
		put(b, "RuinWallFront", Vector3.new(fw, fh, 1.2), CFrame.new(W * 0.5 - fw * 0.5, fh * 0.5, fz + 0.6), wall, mat, true)
		-- the collapsed upper floor: its high end on the side wall, its low end on the floor inside the shell
		local L = W * 0.7
		local a = math.asin(math.min(0.8, math.min(STOREY, H - 1) * 0.8 / L))
		local cy = L * 0.5 * math.sin(a) + 0.4 * math.cos(a) + 0.02
		put(b, "RuinFloorSlab", Vector3.new(L, 0.8, D - 3), CFrame.new(-W * 0.5 + 1.2 + L * 0.5 * math.cos(a), cy, 0) * rotZ(-math.deg(a)), trim, mat, true)
		return
	end

	local hall = v.hall == true
	local damaged = v.damaged == true and S >= 2 and not hall
	local rx0, rx1 = -W * 0.5, W * 0.5 -- the roof the details stand on
	local roofY = H
	local topW = W - 4 -- the top storey's window strip
	if hall then
		local T = 1.2
		local gap = math.clamp(W - 8, 4, 10) -- the full-height opening (the door)
		local pw = (W - gap) * 0.5
		put(b, "HallWall", Vector3.new(W, H, T), CFrame.new(0, H * 0.5, D * 0.5 - T * 0.5), wall, mat, true)
		-- the side walls run between the front piers and the back wall (no shared faces: nothing z-fights)
		put(b, "HallWall", Vector3.new(T, H, D - 2 * T), CFrame.new(-W * 0.5 + T * 0.5, H * 0.5, 0), trim, mat, true)
		put(b, "HallWall", Vector3.new(T, H, D - 2 * T), CFrame.new(W * 0.5 - T * 0.5, H * 0.5, 0), trim, mat, true)
		put(b, "HallPier", Vector3.new(pw, H, T), CFrame.new(-gap * 0.5 - pw * 0.5, H * 0.5, fz + T * 0.5), wall, mat, true)
		put(b, "HallPier", Vector3.new(pw, H, T), CFrame.new(gap * 0.5 + pw * 0.5, H * 0.5, fz + T * 0.5), wall, mat, true)
		if roof.bare then
			put(b, "HallRoof", Vector3.new(W, 0.8, D), CFrame.new(0, H + 0.4, 0), trim, mat, true, true)
			roofY = H + 0.8
		else
			put(b, "HallRoof", Vector3.new(W + 0.8, 1.2, D + 0.8), CFrame.new(0, H + 0.6, 0), trim, mat, true, true)
			roofY = H + 1.2
		end
	elseif damaged then
		local lowH = H - STOREY
		local rw = math.floor(W * 0.55 + 0.5)
		put(b, "AdobeBlock", Vector3.new(W, lowH, D), CFrame.new(0, lowH * 0.5, 0), wall, mat, true, true)
		put(b, "AdobeBlockUpper", Vector3.new(rw, STOREY, D), CFrame.new(-W * 0.5 + rw * 0.5, lowH + STOREY * 0.5, 0), wall, mat, true)
		-- the fallen floor of the blown corner, tipped from the remnant down to the broken edge
		local sw = W - rw - 1
		local tilt = math.rad(10)
		put(b, "AdobeDebris", Vector3.new(sw, 0.8, D * 0.7), CFrame.new(W * 0.5 - sw * 0.5 - 0.3, lowH + sw * 0.5 * math.sin(tilt) + 0.4 * math.cos(tilt), 0.1 * D) * rotZ(-10), trim, mat, true)
		rx1 = -W * 0.5 + rw
		topW = rw - 3
	else
		put(b, "AdobeBlock", Vector3.new(W, H, D), CFrame.new(0, H * 0.5, 0), wall, mat, true, true)
		if not roof.bare then
			put(b, "AdobeParapet", Vector3.new(W + 0.8, 1.2, D + 0.8), CFrame.new(0, H + 0.6, 0), trim, mat, true)
			roofY = H + 1.2
		end
	end

	-- one inset window strip per upper storey (front; "side" / "left" / "rear": the +X / -X / back face too; damaged:
	-- none on the blown half)
	for k = 2, S do
		local y = (k - 1) * STOREY + 3.6
		local top = k == S
		local w = if top then topW else W - 4
		local x = if top and damaged then rx0 + 1.5 + w * 0.5 else 0
		put(b, "AdobeWindowStrip", Vector3.new(math.max(w, 2), 1.8, 0.3), CFrame.new(x, y, fz - 0.15), PAL.Window, M.SmoothPlastic, false)
		if v.side and not (top and damaged) then
			put(b, "AdobeWindowStrip", Vector3.new(0.3, 1.8, math.max(D - 4, 2)), CFrame.new(W * 0.5 + 0.15, y, 0), PAL.Window, M.SmoothPlastic, false)
		end
		if v.left then
			put(b, "AdobeWindowStrip", Vector3.new(0.3, 1.8, math.max(D - 4, 2)), CFrame.new(-W * 0.5 - 0.15, y, 0), PAL.Window, M.SmoothPlastic, false)
		end
		if v.rear and not (top and damaged) then
			put(b, "AdobeWindowStrip", Vector3.new(math.max(W - 4, 2), 1.8, 0.3), CFrame.new(0, y, D * 0.5 + 0.15), PAL.Window, M.SmoothPlastic, false)
		end
	end

	-- ground floor: a rolled steel shutter under a cloth awning, a vehicle-wide roller door, or a door (a hall's
	-- opening is its door)
	if hall then
		-- nothing: the full-height opening
	elseif v.shop then
		local shutters = { PAL.Rust, PAL.SteelDark, PAL.DrumBlue }
		local tarps = { PAL.TarpRed, PAL.TarpBlue, PAL.TarpSand }
		local sw = math.max(W - 6, 4)
		put(b, "ShopShutter", Vector3.new(sw, 4.2, 0.3), CFrame.new(0, 2.3, fz - 0.15), shutters[rng:NextInteger(1, 3)], M.CorrodedMetal, false)
		put(b, "ShopTarp", Vector3.new(sw, 0.25, 3.1), CFrame.new(0, 5.2, fz - 1.52) * rotX(-14), tarps[rng:NextInteger(1, 3)], M.Fabric, false)
	elseif v.roller then
		local rw = math.max(math.min(12, W - 6), 4)
		put(b, "RollerDoor", Vector3.new(rw, 5.6, 0.3), CFrame.new(0, 2.8, fz - 0.15), if metal then PAL.MetalDark else PAL.SteelDark, M.CorrodedMetal, false)
	else
		put(b, "AdobeDoor", Vector3.new(2.4, 4.2, 0.3), CFrame.new(-W * 0.5 + 3.2, 2.1, fz - 0.15), PAL.WoodDark, M.Wood, false)
	end
	if o.Lantern == true then
		local lamp = put(b, "LampLantern", Vector3.new(0.8, 1.1, 0.8), CFrame.new(W * 0.5 - 1.6, 6.2, fz - 0.4), PAL.LampLens, M.SmoothPlastic, false)
		if o.Light ~= false then
			nightLamp(lamp)
		end
	end

	-- rooftop details (inside the roof outline, standing on it)
	if roof.tank or roof.tanks then
		local cols = { PAL.SteelDark, PAL.TankCream, PAL.DrumBlue }
		vcyl(b, "RoofTank", rx1 - 2.6, roofY, D * 0.5 - 2.6, 3.2, 3.4, cols[rng:NextInteger(1, 3)], M.Plastic, true)
		if roof.tanks then
			vcyl(b, "RoofTank", rx1 - 6.4, roofY, D * 0.5 - 2.6, 3.2, 3.4, cols[rng:NextInteger(1, 3)], M.Plastic, true)
		end
	end
	if roof.hut then
		put(b, "RoofHut", Vector3.new(4.6, 3.2, 4.2), CFrame.new(rx0 + 3.0, roofY + 1.6, D * 0.5 - 2.8), trim, mat, true)
	end
	if roof.mast then
		put(b, "RoofMast", Vector3.new(0.45, 12, 0.45), CFrame.new(rx0 + 2.0, roofY + 6, fz + 2.2), PAL.SteelDark, M.Metal, false)
		put(b, "RoofMastBar", Vector3.new(3.2, 0.3, 0.3), CFrame.new(rx0 + 2.0, roofY + 10.5, fz + 2.2), PAL.SteelDark, M.Metal, false)
	end
	if roof.dish then
		put(b, "RoofDish", Vector3.new(0.4, 3, 3), CFrame.new((rx0 + rx1) * 0.5, roofY + 1.3, fz + 2.4) * rotY(90) * rotZ(40), PAL.ConcreteLight, M.SmoothPlastic, false, false, Enum.PartType.Cylinder)
	end
end

-- a lattice radio mast, 90 tall (the Town's skyline marker from every gate): plinth, two tapering sections, a red tip
-- and a relay dish. Solid, no light (the aviation tip is painted, never Neon).
Builders.RadioMast = function(b: B)
	put(b, "MastPlinth", Vector3.new(6, 2, 6), CFrame.new(0, 1, 0), PAL.ConcreteLight, M.Concrete, true)
	put(b, "MastSection", Vector3.new(3.2, 40, 3.2), CFrame.new(0, 22, 0), PAL.Steel, M.DiamondPlate, true, true)
	put(b, "MastSection", Vector3.new(2.2, 30, 2.2), CFrame.new(0, 57, 0), PAL.Steel, M.DiamondPlate, true, true)
	put(b, "MastTip", Vector3.new(1, 18, 1), CFrame.new(0, 81, 0), PAL.TarpRed, M.SmoothPlastic, true)
	put(b, "MastDish", Vector3.new(0.5, 4.4, 4.4), CFrame.new(0, 48, -1.35) * ZCYL, PAL.ConcreteLight, M.SmoothPlastic, false, false, Enum.PartType.Cylinder)
end

-- W3 step 2: the later POIs (spec w3s2 §6 lane K; contract w3s2/build/L0/contract.md §5) ─────────────────────────────
-- Cheap big-part builds in the Town v2 style: a few large anchored Parts per kit, no Neon, no light, no GUI; the parts
-- counts are exactly Specs[kit].Parts (Variants / per unit). Names follow the Hygiene keywords: solid-keyword parts that
-- reach 1.5 above the floor collide (H4), natural parts carry a natural prefix and never collide.

-- a horizontal cylinder along the kit's local X (length L, diameter d) centred at (x, y, z)
local function xcyl(b: B, name: string, x: number, y: number, z: number, L: number, d: number, color: Color3, mat: Enum.Material?, collide: boolean?, shadow: boolean?): Part
	return put(b, name, Vector3.new(L, d, d), CFrame.new(x, y, z), color, mat, collide, shadow, Enum.PartType.Cylinder)
end

-- a horizontal cylinder along the kit's local Z
local function zcyl(b: B, name: string, x: number, y: number, z: number, L: number, d: number, color: Color3, mat: Enum.Material?, collide: boolean?, shadow: boolean?): Part
	return put(b, name, Vector3.new(L, d, d), CFrame.new(x, y, z) * ZCYL, color, mat, collide, shadow, Enum.PartType.Cylinder)
end

-- a climbable ladder: one TrussPart (Roblox keeps a truss 2 x 2 across and an even length), set up like WorldKits.Part
-- (anchored, CanTouch off, no shadow, WE_Decor); it collides, or it could not be climbed
local function truss(b: B, name: string, height: number, lcf: CFrame, color: Color3): TrussPart
	local t = Instance.new("TrussPart")
	t.Name = name
	t.Anchored = true
	t.Size = Vector3.new(2, 2 * math.max(1, math.floor(height / 2 + 0.5)), 2)
	t.CFrame = b.CF * lcf
	t.Color = color
	t.Material = M.Metal
	t.Transparency = 0
	t.CanCollide = true
	t.CanQuery = true
	t.CanTouch = false
	t.CastShadow = false
	t:SetAttribute("WE_Decor", true)
	t.Parent = b.Cluster
	table.insert(b.Parts, t)
	return t
end

-- a runtime door part (HeistGate, BunkerDoor): the jobs open it (Phase B), WorldHygiene Enforce leaves it alone
local function runtimeDoor(p: BasePart)
	local A = WorldConfig.Activity
	p:SetAttribute(A.RuntimeDoorAttr, true)
	p:SetAttribute(A.GateStateAttr, "closed")
end

-- shipping containers, 7.2 x 7.5 x 18 each: Count 1 .. 6 (default 3 = 2 side by side + 1 on top); 4 .. 6 fill a second
-- row 1 stud behind (z 10 .. 28). Every container casts a shadow (the geometry plan counts n casters)
local CONTAINER_SLOTS = { { -3.8, 0, 0 }, { 3.8, 0, 0 }, { 0, 7.5, 0 }, { -3.8, 0, 19 }, { 3.8, 0, 19 }, { 0, 7.5, 19 } }
Builders.ContainerStack = function(b: B)
	local n = math.clamp(math.floor(b.Opts.Count or 3), 1, 6)
	local cols = { PAL.Rust, PAL.DrumBlue, PAL.CrateOlive, PAL.TarpRed, PAL.TankCream }
	local k0 = b.Rng:NextInteger(0, #cols - 1)
	for i = 1, n do
		local s = CONTAINER_SLOTS[i]
		put(b, "Container", Vector3.new(7.2, 7.5, 18), CFrame.new(s[1], s[2] + 3.75, s[3]), cols[(k0 + i - 1) % #cols + 1], M.Metal, true, true)
	end
end

-- a quay gantry crane (landmark, 55 tall): 4 legs on the quay (z -6.8 .. 6.8), the cross girder, the boom reaching 40
-- over the water (-Z) and 13 behind, the stay apex. Scale (0.5 .. 1.6; the rig shore bases use 0.6)
Builders.GantryCrane = function(b: B)
	local s = scaleOf(b)
	for _, c in ipairs({ { -11.2, -6 }, { 11.2, -6 }, { -11.2, 6 }, { 11.2, 6 } }) do
		put(b, "GantryLeg", Vector3.new(1.6, 40, 1.6) * s, CFrame.new(c[1] * s, 20 * s, c[2] * s), PAL.Hazard, M.Metal, true)
	end
	put(b, "GantryGirder", Vector3.new(24, 3, 14) * s, CFrame.new(0, 41.5 * s, 0), PAL.SteelDark, M.Metal, true, true)
	put(b, "GantryBoom", Vector3.new(2.4, 2.4, 53) * s, CFrame.new(0, 44.2 * s, -13.5 * s), PAL.Hazard, M.Metal, true, true)
	put(b, "GantryApex", Vector3.new(2, 9.6, 2) * s, CFrame.new(0, 50.2 * s, 10 * s), PAL.SteelDark, M.Metal, true)
end

-- a vertical fuel tank on a concrete ring, 12.4 across and 11 tall at Scale 1 (0.5 .. 1.6)
Builders.FuelTank = function(b: B)
	local s = scaleOf(b)
	vcyl(b, "FuelTankBase", 0, 0, 0, 0.6 * s, 12.4 * s, PAL.ConcreteLight, M.Concrete, true)
	vcyl(b, "FuelTankBody", 0, 0.6 * s, 0, 9.8 * s, 12 * s, PAL.TankCream, M.Metal, true, true)
	vcyl(b, "FuelTankRoof", 0, 10.4 * s, 0, 0.6 * s, 8 * s, PAL.Rust, M.CorrodedMetal, true)
end

-- a gas flare stack (landmark, 45 tall): plinth, pipe, and a painted flame ball on top (never Neon, no light)
Builders.FlareStack = function(b: B)
	put(b, "FlareBase", Vector3.new(6, 1.5, 6), CFrame.new(0, 0.75, 0), PAL.ConcreteLight, M.Concrete, true)
	vcyl(b, "FlareStackPipe", 0, 1.5, 0, 40, 1.8, PAL.Steel, M.Metal, true, true)
	put(b, "FlareFlame", Vector3.new(3.5, 3.5, 3.5), CFrame.new(0, 43.25, 0), PAL.Hazard:Lerp(PAL.TarpRed, 0.35), M.SmoothPlastic, false, false, Enum.PartType.Ball)
end

-- a radar dome on a concrete tower (landmark, 26 tall): tower (door on the front), deck, dome, mast
Builders.RadarDome = function(b: B)
	put(b, "RadarBase", Vector3.new(7, 12, 7), CFrame.new(0, 6, 0), PAL.ConcreteLight, M.Concrete, true, true)
	put(b, "RadarDoor", Vector3.new(2.4, 4.2, 0.3), CFrame.new(0, 2.1, -3.65), PAL.SteelDark, M.Metal, false)
	put(b, "RadarDeck", Vector3.new(13, 0.8, 13), CFrame.new(0, 12.4, 0), PAL.SteelDark, M.Metal, true)
	put(b, "RadarDome", Vector3.new(12.6, 12.6, 12.6), CFrame.new(0, 19.1, 0), PAL.RadarWhite, M.SmoothPlastic, true, true, Enum.PartType.Ball)
	put(b, "RadarMast", Vector3.new(0.4, 1.2, 0.4), CFrame.new(0, 25.4, 0), PAL.SteelDark, M.Metal, false)
end

-- the Crash Site cargo plane in 3 pieces (fuselage along local Z). Variant "mid" (default: fuselage, both wings, an
-- engine), "nose" (fuselage, rounded nose, wing stub), "tail" (tail cone + a fin, rolled over)
Builders.PlaneWreck = function(b: B)
	local v = b.Opts.Variant or "mid"
	local alu, burnt, cm = PAL.Aluminium, PAL.Burnt, M.CorrodedMetal
	if v == "nose" then
		zcyl(b, "PlaneWreckNose", 0, 5, 4, 18, 10, alu, M.Metal, true, true)
		put(b, "PlaneWreckCockpit", Vector3.new(10, 10, 10), CFrame.new(0, 5, -8), alu, M.Metal, true, false, Enum.PartType.Ball)
		put(b, "PlaneWreckWing", Vector3.new(12, 0.8, 4), CFrame.new(0, 2.6, 6) * rotZ(4), burnt, cm, true)
	elseif v == "tail" then
		zcyl(b, "PlaneWreckTail", 0, 3, 0, 18, 6, alu, M.Metal, true, true)
		-- the fin, 7 tall, on the fuselage top at the back, rolled 35 degrees toward +X
		local a = math.rad(35)
		put(b, "PlaneWreckFin", Vector3.new(0.8, 7, 5), CFrame.new(3.5 * math.sin(a), 6 + 3.5 * math.cos(a), 6.5) * rotZ(-35), burnt, cm, true)
	else
		zcyl(b, "PlaneWreckFuselage", 0, 5, 0, 22, 10, alu, M.Metal, true, true)
		-- left wing: root at x -4.2, y 3, 10 degrees of dihedral; right wing: broken, drooping 8 degrees into the sand
		local function wing(side: number, deg: number, color: Color3, shadow: boolean)
			local a = math.rad(deg)
			local cx, cy = side * (4.2 + 6.5 * math.cos(a)), 3 + 6.5 * math.sin(a)
			put(b, "PlaneWreckWing", Vector3.new(13, 0.8, 7), CFrame.new(cx, cy, 1) * rotZ(side * deg), color, cm, true, shadow)
		end
		wing(-1, 10, alu, true)
		wing(1, -8, burnt, false)
		zcyl(b, "PlaneWreckEngine", -9, 1.5, 1.5, 6, 3, burnt, cm, true)
	end
end

-- a downed helicopter: body rolled 15 degrees, tail boom (+Z), fin, a rotor blade and a skid lying in the sand
Builders.HeliWreck = function(b: B)
	local cm = M.CorrodedMetal
	put(b, "HeliWreckBody", Vector3.new(4.6, 4.6, 9), CFrame.new(0, 2.85, -7.5) * rotZ(15), PAL.DrumOlive, cm, true, true)
	zcyl(b, "HeliWreckTail", 0.4, 2.2, 3.5, 13, 1.4, PAL.DrumOlive, cm, true)
	put(b, "HeliWreckFin", Vector3.new(0.4, 3, 2), CFrame.new(0.4, 3.4, 11), PAL.Burnt, cm, true)
	put(b, "HeliWreckRotor", Vector3.new(10, 0.2, 0.8), CFrame.new(0, 0.1, -5) * rotY(20), PAL.SteelDark, M.Metal, false)
	put(b, "HeliWreckSkid", Vector3.new(0.4, 0.4, 8), CFrame.new(-3.4, 0.2, -6.5) * rotY(-6), PAL.SteelDark, M.Metal, false)
end

-- a hedgehog tank trap: two steel beams crossed at the centre along the plan diagonals, tilted 27 degrees in opposite
-- senses, so it reads as an X from the road (4 x 3 x 4, resting on the floor)
Builders.TankTrap = function(b: B)
	local L, t, deg = 5.2, 0.7, 27
	local a = math.rad(deg)
	local cy = (L * math.sin(a) + t * math.cos(a)) * 0.5
	put(b, "TankTrapBeam", Vector3.new(L, t, t), CFrame.new(0, cy, 0) * rotY(45) * rotZ(deg), PAL.SteelDark, M.CorrodedMetal, true)
	put(b, "TankTrapBeam", Vector3.new(L, t, t), CFrame.new(0, cy, 0) * rotY(-45) * rotZ(-deg), PAL.Rust, M.CorrodedMetal, true)
end

-- the Quarry rock crusher (landmark): crusher house, hopper on top, the conveyor running down to +Z (z 6 .. 30) on one
-- support leg, a gravel heap beside its foot
Builders.Crusher = function(b: B)
	put(b, "CrusherBody", Vector3.new(13, 10, 12), CFrame.new(0, 5, 0), PAL.ConcreteLight, M.Concrete, true, true)
	put(b, "CrusherHopper", Vector3.new(9, 4, 9), CFrame.new(0, 12, -0.5), PAL.Rust, M.CorrodedMetal, true)
	local L, t = 26.2, 0.6
	local a = math.atan2(10.5, 24)
	local cy, cz = (L * math.sin(a) + t * math.cos(a)) * 0.5, 17.85
	put(b, "CrusherConveyor", Vector3.new(3, t, L), CFrame.new(0, cy, cz) * CFrame.Angles(a, 0, 0), PAL.SteelDark, M.Metal, true, true)
	local lz = 14
	local legTop = cy + (cz - lz) * math.tan(a) - t * 0.5 / math.cos(a)
	put(b, "CrusherLeg", Vector3.new(1, legTop, 1), CFrame.new(0, legTop * 0.5, lz), PAL.Steel, M.Metal, true)
	put(b, "CrusherGravel", Vector3.new(4.4, 2.4, 8), CFrame.new(4.2, 1.2, 25), PAL.PavingDark, M.Pebble, true)
end

-- a timber watchtower (8 parts, 9 x 9): 4 legs running up to the roof, the deck (top = WorldConfig.Kits.WatchtowerDeckY,
-- 14: tower posts stand on it), a front half-wall, a climbable ladder at the back (TrussPart; it tops out 2 above the
-- deck so a player steps off without jumping), and a roof 8.5 above the deck that nothing collides with (owner feedback
-- #29, as at the base tower: heads, jumps and the Poppercam never catch on it)
local TOWER_HEADROOM = 8.5
Builders.Watchtower = function(b: B)
	local deckY = KC.WatchtowerDeckY
	local roofY = deckY + TOWER_HEADROOM
	for _, c in ipairs({ { -3.9, -3.9 }, { 3.9, -3.9 }, { -3.9, 3.9 }, { 3.9, 3.9 } }) do
		put(b, "TowerLeg", Vector3.new(0.8, roofY, 0.8), CFrame.new(c[1], roofY * 0.5, c[2]), PAL.WoodDark, M.Wood, true)
	end
	-- the deck stops at z 2 so the ladder (z 2 .. 4) rises clear of it
	put(b, "TowerDeck", Vector3.new(9, 0.6, 6.5), CFrame.new(0, deckY - 0.3, -1.25), PAL.Wood, M.WoodPlanks, true)
	put(b, "TowerWall", Vector3.new(9, 3.4, 0.4), CFrame.new(0, deckY + 1.7, -4.3), PAL.Wood, M.WoodPlanks, true)
	put(b, "TowerRoof", Vector3.new(9, 0.5, 9), CFrame.new(0, roofY + 0.25, 0), PAL.SteelDark, M.Metal, false, true)
	truss(b, "TowerLadder", deckY + 2, CFrame.new(0, (deckY + 2) * 0.5, 3), PAL.SteelDark)
end

-- an earth-covered bunker, pivot at the front: the mound (z 0 .. 11), the concrete facade and the yellow blast door
-- "BunkerDoor" (a runtime door, built closed)
Builders.Bunker = function(b: B)
	put(b, "BunkerBody", Vector3.new(18, 7, 11), CFrame.new(0, 3.5, 5.5), PAL.Sandbag, M.Ground, true, true)
	put(b, "BunkerFacade", Vector3.new(10, 5.6, 0.3), CFrame.new(0, 2.8, -0.15), PAL.Concrete, M.Concrete, true)
	runtimeDoor(put(b, "BunkerDoor", Vector3.new(4.4, 4.4, 0.2), CFrame.new(0, 2.2, -0.4), PAL.Hazard, M.DiamondPlate, true))
end

-- an open-front hangar (-Z open), Width (inside, default 28, 16 .. 48) x 25 deep: 2 side walls and the back wall
-- 12.9 tall, the yellow front lintel (the opening is 11.5 clear), a flat roof slab (the one shadow caster). All collide, so
-- the phone camera pulls in under the roof instead of seeing its top
Builders.Hangar = function(b: B)
	local W = math.clamp(b.Opts.Width or 28, 16, 48)
	local H, D, T = 12.9, 25, 0.6
	local wall = b.Opts.Color or PAL.Metal
	put(b, "HangarWall", Vector3.new(T, H, D), CFrame.new(-W * 0.5 - T * 0.5, H * 0.5, 0), wall, M.Metal, true)
	put(b, "HangarWall", Vector3.new(T, H, D), CFrame.new(W * 0.5 + T * 0.5, H * 0.5, 0), wall, M.Metal, true)
	put(b, "HangarWall", Vector3.new(W, H, T), CFrame.new(0, H * 0.5, D * 0.5 - T * 0.5), wall, M.Metal, true)
	put(b, "HangarLintel", Vector3.new(W, 1.4, T), CFrame.new(0, H - 0.7, -D * 0.5 + T * 0.5), PAL.Hazard, M.Metal, true)
	put(b, "HangarRoof", Vector3.new(W + 2 * T, 0.6, D), CFrame.new(0, H + 0.3, 0), PAL.MetalDark, M.Metal, true, true)
end

-- a see-through wire fence, 1 panel per 16 studs of opts.Length (16 .. 64), centred on the pivot line. It collides
-- (nobody walks through a fence); "Wire" is a soft keyword, so it is not cover (H4)
Builders.WireFence = function(b: B)
	local n = math.clamp(math.floor((b.Opts.Length or 16) / 16 + 0.5), 1, 4)
	for i = 1, n do
		local x = (i - (n + 1) * 0.5) * 16
		local p = put(b, "WireFence", Vector3.new(16, 3, 0.4), CFrame.new(x, 1.5, 0), PAL.Steel, M.DiamondPlate, true)
		p.Transparency = 0.45
	end
end

-- an A-frame canvas tent (open ends along Z) with its front pole
Builders.Tent = function(b: B)
	local half, h, t = 3.8, 4.8, 0.2
	local a = math.atan2(h, half)
	local L = math.sqrt(half * half + h * h)
	local cy = (L * math.sin(a) + t * math.cos(a)) * 0.5
	put(b, "TentCanvas", Vector3.new(L, t, 9), CFrame.new(-half * 0.5, cy, 0) * rotZ(math.deg(a)), PAL.Canvas, M.Fabric, true)
	put(b, "TentCanvas", Vector3.new(L, t, 9), CFrame.new(half * 0.5, cy, 0) * rotZ(-math.deg(a)), PAL.Canvas:Lerp(PAL.WoodDark, 0.15), M.Fabric, true)
	put(b, "TentPole", Vector3.new(0.3, h, 0.3), CFrame.new(0, h * 0.5, -4.3), PAL.WoodDark, M.Wood, false)
end

-- a date palm (natural: never collides): the trunk leaning 6 degrees toward -X from a foot 1.3 * Scale right of the
-- pivot, so the crown (two crossed fronds, 10 across) is centred over the pivot. Scale
Builders.Palm = function(b: B)
	local s = scaleOf(b)
	local h, tilt = 12.6 * s, math.rad(6)
	local lean, ty = h * math.sin(tilt), h * math.cos(tilt)
	-- lifted by the tilted foot's half-width so no edge dips below the floor
	put(b, "PalmTrunk", Vector3.new(h, 1.1 * s, 1.1 * s), CFrame.new(lean * 0.5, ty * 0.5 + 0.55 * s * math.sin(tilt), 0) * rotZ(96), PAL.PalmTrunk, M.Wood, false, false, Enum.PartType.Cylinder)
	put(b, "PalmFrond", Vector3.new(10 * s, 0.35 * s, 2.4 * s), CFrame.new(0, ty + 0.3 * s, 0), PAL.PalmFrond, M.Grass, false)
	put(b, "PalmFrond", Vector3.new(10 * s, 0.35 * s, 2.4 * s), CFrame.new(0, ty + 0.2 * s, 0) * rotY(90), PAL.PalmFrond:Lerp(PAL.JoshuaLeaf, 0.4), M.Grass, false)
end

-- an oil pumpjack (long axis along Z): skid, Samson post, walking beam, horsehead (-Z), counterweight / motor (+Z)
Builders.Pumpjack = function(b: B)
	put(b, "PumpjackBase", Vector3.new(2.6, 0.6, 14), CFrame.new(0, 0.3, 0), PAL.Concrete, M.Concrete, true)
	put(b, "PumpjackPost", Vector3.new(1.2, 7.4, 1.2), CFrame.new(0, 4.3, 0.8), PAL.SteelDark, M.Metal, true)
	put(b, "PumpjackBeam", Vector3.new(1, 1, 11), CFrame.new(0, 8.6, -1) * rotX(8), PAL.SteelDark, M.Metal, true)
	put(b, "PumpjackHead", Vector3.new(1.2, 3.4, 1.4), CFrame.new(0, 8, -6.2), PAL.Hazard, M.Metal, true)
	put(b, "PumpjackWeight", Vector3.new(4, 2.4, 3), CFrame.new(0, 1.8, 5.2), PAL.Rust, M.CorrodedMetal, true)
end

-- a console desk with its screen tilted back (never Neon): the uplink / hack consoles
Builders.Terminal = function(b: B)
	put(b, "TerminalDesk", Vector3.new(3, 2.4, 2), CFrame.new(0, 1.2, 0), PAL.SteelDark, M.Metal, true)
	put(b, "TerminalScreen", Vector3.new(2.6, 0.8, 0.25), CFrame.new(0, 2.8, 0.55) * rotX(15), PAL.Window, M.SmoothPlastic, false)
end

-- a flat painted disc marking a hold zone: radius opts.R (WorldConfig.Kits.HoldPad: default 10, 3 .. 24), top 0.13
-- above the floor, no collision. Variant "pond": the Oasis pond (Glass, 20 % see-through; not WE_Water, boats ignore it)
Builders.HoldPad = function(b: B)
	local HP = KC.HoldPad
	local r = math.clamp(b.Opts.R or HP.R, HP.MinR, HP.MaxR)
	if b.Opts.Variant == "pond" then
		local p = vcyl(b, "HoldPadPond", 0, 0, 0, HP.Top, r * 2, PAL.PondWater, M.Glass, false)
		p.Transparency = 0.2
	else
		vcyl(b, "HoldPad", 0, 0, 0, HP.Top, r * 2, PAL.PadPaint, M.SmoothPlastic, false)
	end
end

-- a pipe run along local X, 1 unit per 40 studs of opts.Length (1 .. 3 units; a cluster stays <= 64 wide, so the
-- layouts use 40): a pipe on the ground (d 1.8), or Variant "rack": the pipe (d 1.2) on 2 rack posts, top 4.5
Builders.PipeRun = function(b: B)
	local n = math.clamp(math.floor((b.Opts.Length or 40) / 40 + 0.5), 1, 3)
	local rack = b.Opts.Variant == "rack"
	for i = 1, n do
		local x = (i - (n + 1) * 0.5) * 40
		if rack then
			put(b, "PipeRackPost", Vector3.new(0.6, 3.3, 2), CFrame.new(x - 14, 1.65, 0), PAL.SteelDark, M.Metal, true)
			put(b, "PipeRackPost", Vector3.new(0.6, 3.3, 2), CFrame.new(x + 14, 1.65, 0), PAL.SteelDark, M.Metal, true)
			xcyl(b, "Pipe", x, 3.9, 0, 40, 1.2, PAL.Rust, M.CorrodedMetal, true)
		else
			xcyl(b, "Pipe", x, 0.9, 0, 40, 1.8, PAL.Rust, M.CorrodedMetal, true)
		end
	end
end

-- the invisible 1-stud host of a POI layout's activity anchors (WorldConfig.Activity.HostKit): never collides, never
-- queried or touched, no overlay; it must never move
Builders.ActivityHost = function(b: B)
	local p = put(b, "ActivityHost", Vector3.new(1, 1, 1), CFrame.new(0, 0.5, 0), PAL.SteelDark, M.SmoothPlastic, false)
	p.Transparency = 1
end

-- the airstrip runway (infra, not a cluster: 500 long, exempt from H10; WorldPOI builds it under POI_<Id>.Infra):
-- asphalt (WorldConfig.Kits.Runway.Width wide), centre line, 2 threshold bars, and the taxiway strip over opts.Taxiway
-- (a WORLD rect { X0, X1, Z0, Z1 }, built axis-aligned) or, without one, a touchdown aim marking. 5 parts, flat (top
-- Kits.Runway.Top above the floor), no collision, no shadow. Length 200 .. 2000 (default 500)
Builders.Runway = function(b: B)
	local RW = KC.Runway
	local L = math.clamp(b.Opts.Length or 500, 200, 2000)
	local W = RW.Width
	local PAINT = 0.06 -- the paint stands 0.06 proud of the asphalt (as the road dashes do): a thinner gap flickers on phones
	local slab = RW.Top - PAINT
	put(b, "RunwayAsphalt", Vector3.new(L, slab, W), CFrame.new(0, slab * 0.5, 0), PAL.Asphalt, M.Asphalt, false)
	put(b, "RunwayCentreLine", Vector3.new(L - 60, PAINT, 1), CFrame.new(0, slab + PAINT * 0.5, 0), PAL.RunwayPaint, M.SmoothPlastic, false)
	for _, sx in ipairs({ -1, 1 }) do
		put(b, "RunwayThreshold", Vector3.new(3, PAINT, W - 6), CFrame.new(sx * (L * 0.5 - 4), slab + PAINT * 0.5, 0), PAL.RunwayPaint, M.SmoothPlastic, false)
	end
	local tw = b.Opts.Taxiway
	if tw ~= nil and #tw >= 4 then
		local x0, x1 = math.min(tw[1], tw[2]), math.max(tw[1], tw[2])
		local z0, z1 = math.min(tw[3], tw[4]), math.max(tw[3], tw[4])
		local p = WorldKits.Part({
			Name = "RunwayTaxiway",
			Size = Vector3.new(math.max(x1 - x0, 1), slab, math.max(z1 - z0, 1)),
			CFrame = CFrame.new((x0 + x1) * 0.5, b.CF.Position.Y + slab * 0.5, (z0 + z1) * 0.5),
			Color = PAL.Asphalt,
			Material = M.Asphalt,
		}, b.Cluster)
		table.insert(b.Parts, p)
	else
		put(b, "RunwayAimPoint", Vector3.new(24, PAINT, 10), CFrame.new(-L * 0.5 + 70, slab + PAINT * 0.5, 0), PAL.RunwayPaint, M.SmoothPlastic, false)
	end
end

-- Shared ───────────────────────────────────────────────────────────────────────────────────────────────────────────
local CRATE_SLOTS = {
	{ -1.3, 0, 1.3, 4 },
	{ 1.3, 0, 1.3, -6 },
	{ 0, 2.4, 1.5, 10 },
	{ -1.3, 0, 4.0, -3 },
	{ 1.3, 0, 4.0, 8 },
	{ 0, 2.4, 4.0, -10 },
}
Builders.CrateStack = function(b: B)
	local n = math.clamp(math.floor(b.Opts.Count or 3), 1, 6)
	local ammo = b.Opts.Variant == "ammo"
	local list: { BasePart } = {}
	for i = 1, n do
		local s = CRATE_SLOTS[i]
		local col = if ammo or i % 2 == 0 then PAL.CrateOlive else PAL.Crate
		table.insert(list, put(b, "Crate", Vector3.new(2.4, 2.4, 2.4), CFrame.new(s[1], s[2] + 1.2, s[3]) * rotY(s[4]), col, M.Wood, true))
	end
	queueMesh(b, "CrateStack", "skin", list)
end

local DRUM_SLOTS = { { -0.85, 0.8 }, { 0.85, 0.85 }, { 0, 2.25 }, { -1.7, 2.3 }, { 1.75, 2.3 }, { 0.05, 3.7 } }
Builders.DrumGroup = function(b: B)
	local n = math.clamp(math.floor(b.Opts.Count or 3), 1, 6)
	local fire = b.Opts.Variant == "fire" -- W3 step 2 (camps): scorched burn drums, 1 part each, no light, no particles
	local cols = if fire then { PAL.Burnt, PAL.Rust, PAL.Burnt } else { PAL.DrumOlive, PAL.DrumRed, PAL.DrumBlue }
	local k0 = b.Rng:NextInteger(0, 2)
	for i = 1, n do
		local s = DRUM_SLOTS[i]
		vcyl(b, if fire then "FireDrum" else "OilDrum", s[1], 0, s[2], 2.2, 1.5, cols[(k0 + i - 1) % 3 + 1], if fire then M.CorrodedMetal else M.Metal, true)
	end
end

Builders.SandbagLine = function(b: B)
	local n = math.clamp(math.floor((b.Opts.Length or 5) / 5 + 0.5), 1, 8)
	for i = 1, n do
		local x = (i - (n + 1) * 0.5) * 5
		local h = if i % 2 == 0 then 1.8 else 2.0
		put(b, "Sandbag", Vector3.new(5, h, 1.6), CFrame.new(x, h * 0.5, 0.9) * rotY(if i % 2 == 0 then 1.5 else -1.5), if i % 2 == 0 then PAL.SandbagLight else PAL.Sandbag, M.Sand, true)
	end
end

Builders.Jersey = function(b: B)
	put(b, "JerseyBarrier", Vector3.new(4.5, 2.2, 1.1), CFrame.new(0, 1.1, 0.55), PAL.ConcreteLight, M.Concrete, true)
end

Builders.Wreck = function(b: B)
	local v = b.Opts.Variant or "truck"
	local burnt, rust = PAL.Burnt, PAL.Rust
	local cm = M.CorrodedMetal
	if v == "car" then
		local list: { BasePart } = {}
		table.insert(list, put(b, "WreckCarBody", Vector3.new(8, 1.8, 3.8), CFrame.new(0, 0.9, 2.0), burnt, cm, true))
		table.insert(list, put(b, "WreckCarCabin", Vector3.new(3.8, 1.4, 3.4), CFrame.new(0.6, 2.5, 2.0) * rotY(3), rust, cm, true))
		table.insert(list, put(b, "WreckCarHood", Vector3.new(2.4, 0.35, 3.4), CFrame.new(-2.9, 1.95, 2.0) * rotZ(12), rust, cm, true))
		table.insert(list, put(b, "WreckDoor", Vector3.new(0.2, 1.4, 2.2), CFrame.new(0.4, 0.75, 4.3) * rotY(90) * rotZ(-20), burnt, cm, false))
		queueMesh(b, "Wreck", "collider", list)
	elseif v == "gun" then
		-- W3 step 2: a wrecked field gun (shield plate, split trail, barrel cocked up toward -X); collidables at z >= 0
		put(b, "WreckGunShield", Vector3.new(0.3, 2.6, 3.4), CFrame.new(-1.2, 1.3, 3.0) * rotY(4), rust, cm, true)
		put(b, "WreckGunTrail", Vector3.new(5.5, 0.6, 1.0), CFrame.new(1.8, 0.3, 3.0) * rotY(8), burnt, cm, true)
		put(b, "WreckGunBarrel", Vector3.new(5.2, 0.5, 0.5), CFrame.new(-3.8, 2.05, 3.0) * rotZ(-10), burnt, cm, false, false, Enum.PartType.Cylinder)
	elseif v == "tank" then
		put(b, "WreckTankTrack", Vector3.new(9.6, 1.8, 1.3), CFrame.new(0, 0.9, 0.65), burnt, cm, true)
		put(b, "WreckTankTrack", Vector3.new(9.6, 1.8, 1.3), CFrame.new(0, 0.9, 5.95), burnt, cm, true)
		put(b, "WreckTankHull", Vector3.new(9, 1.6, 4.0), CFrame.new(0, 1.4, 3.3), rust, cm, true)
		put(b, "WreckTankTurret", Vector3.new(4, 1.5, 3.6), CFrame.new(0.5, 2.95, 3.3) * rotY(22), burnt, cm, true)
		put(b, "WreckTankBarrel", Vector3.new(6, 0.45, 0.45), CFrame.new(-4.14, 2.7, 5.17) * rotY(22) * rotZ(-5), burnt, cm, false)
	else
		put(b, "WreckTruckBed", Vector3.new(9, 1.8, 4.4), CFrame.new(2.95, 0.9, 2.2), burnt, cm, true)
		put(b, "WreckTruckCab", Vector3.new(3.6, 3.4, 4.2), CFrame.new(-3.45, 1.7, 2.2), rust, cm, true)
		put(b, "WreckTruckHood", Vector3.new(2.2, 2.0, 4.0), CFrame.new(-6.35, 1.0, 2.2), burnt, cm, true)
		put(b, "WreckTruckSide", Vector3.new(9, 1.2, 0.3), CFrame.new(2.95, 2.4, 0.15), rust, cm, true)
		put(b, "WreckTruckSide", Vector3.new(9, 1.2, 0.3), CFrame.new(2.95, 2.4, 4.25), rust, cm, true)
	end
end

-- Travel ───────────────────────────────────────────────────────────────────────────────────────────────────────────
Builders.SandbagNest = function(b: B)
	put(b, "SandbagFront", Vector3.new(6, 2, 1.4), CFrame.new(0, 1, 0.8), PAL.Sandbag, M.Sand, true)
	put(b, "SandbagSide", Vector3.new(1.4, 2, 4.2), CFrame.new(-3.7, 1, 2.9), PAL.SandbagLight, M.Sand, true)
	put(b, "SandbagSide", Vector3.new(1.4, 2, 4.2), CFrame.new(3.7, 1, 2.9), PAL.SandbagLight, M.Sand, true)
	put(b, "SandbagTop", Vector3.new(5.2, 0.8, 1.2), CFrame.new(0, 2.4, 0.8), PAL.SandbagLight, M.Sand, true)
	put(b, "NestTurret", Vector3.new(0.8, 0.7, 1.8), CFrame.new(0, 3.15, 1.2), PAL.SteelDark, M.Metal, false)
	put(b, "NestBarrel", Vector3.new(0.25, 0.25, 2.6), CFrame.new(0, 3.2, -1.0), PAL.SteelDark, M.Metal, false)
end

Builders.RoadMarker = function(b: B)
	if b.Opts.Variant == "hazard" then
		put(b, "HazardPost", Vector3.new(0.3, 3.6, 0.3), CFrame.new(0, 1.8, 0.4), PAL.SteelDark, M.Metal, true)
		put(b, "HazardSign", Vector3.new(2, 2, 0.15), CFrame.new(0, 3.4, 0.17) * rotZ(45), PAL.Hazard, M.SmoothPlastic, false)
	else
		put(b, "KmPost", Vector3.new(1, 3, 0.7), CFrame.new(0, 1.5, 0.35), PAL.ConcreteLight, M.Concrete, true)
		put(b, "KmPostCap", Vector3.new(1.05, 0.7, 0.75), CFrame.new(0, 2.75, 0.35), PAL.TarpRed, M.SmoothPlastic, false)
	end
end

Builders.DirSign = function(b: B)
	put(b, "DirSignPost", Vector3.new(0.4, 6, 0.4), CFrame.new(0, 3, 0.4), PAL.SteelDark, M.Metal, true)
	local board = put(b, "DirSignBoard", Vector3.new(4, 1.2, 0.25), CFrame.new(0.6, 5.2, 0.125), PAL.Hazard, M.SmoothPlastic, false)
	local text = b.Opts.Text
	if text ~= nil and text ~= "" then
		WorldKits.Sign(board, Enum.NormalId.Front, text, { MaxDistance = KC.SignMaxDistance })
	end
end

Builders.SandbagArc = function(b: B)
	put(b, "SandbagArc", Vector3.new(3.6, 2, 1.4), CFrame.new(-1.65, 1, 1.3) * rotY(20), PAL.Sandbag, M.Sand, true)
	put(b, "SandbagArc", Vector3.new(3.6, 2, 1.4), CFrame.new(1.65, 1, 1.3) * rotY(-20), PAL.SandbagLight, M.Sand, true)
end

Builders.Revetment = function(b: B)
	local yaws, leans = { -3, 2, -2 }, { -4, 4, -4 }
	for i, x in ipairs({ -5.4, 0, 5.4 }) do
		-- slabs leaning a little, each resting on its lower edge (centre raised by the lean's drop)
		put(b, "RevetmentWall", Vector3.new(5.2, 2, 3.4), CFrame.new(x, 1.13, 1.95) * rotY(yaws[i]) * rotX(leans[i]), if i == 2 then PAL.ConcreteLight else PAL.Concrete, M.Concrete, true)
	end
end

Builders.JettyStub = function(b: B)
	-- pivot at the landward end; the deck reaches 14 toward -Z (the water)
	put(b, "JettyDeck", Vector3.new(4, 0.5, 14), CFrame.new(0, 1.35, -7), PAL.Wood, M.WoodPlanks, true)
	vcyl(b, "JettyPile", -1.6, -1.4, -13, 3, 0.7, PAL.WoodDark, M.Wood, false)
	vcyl(b, "JettyPile", 1.6, -1.4, -13, 3, 0.7, PAL.WoodDark, M.Wood, false)
end

Builders.BargeWreck = function(b: B)
	-- pivot at the bow ramp on the bank; the hull lies toward -Z (the water)
	put(b, "BargeHull", Vector3.new(9, 2.6, 20), CFrame.new(0, 1.3, -10) * rotZ(6), PAL.Rust, M.CorrodedMetal, true, true)
	put(b, "BargeCabin", Vector3.new(5, 3, 4.5), CFrame.new(0.4, 4.1, -16.5) * rotZ(6), PAL.Burnt, M.CorrodedMetal, true)
	put(b, "BargeRoof", Vector3.new(5.8, 0.4, 5.2), CFrame.new(0.6, 5.8, -16.5) * rotZ(6), PAL.Rust, M.CorrodedMetal, false)
	put(b, "BargeRampHull", Vector3.new(8, 0.6, 4), CFrame.new(0, 1.0, 1.4) * rotX(25), PAL.Rust, M.CorrodedMetal, true)
	put(b, "BargeMast", Vector3.new(0.5, 6, 0.5), CFrame.new(3, 5.3, -12) * rotZ(6), PAL.SteelDark, M.Metal, false)
end

Builders.BeachedHull = function(b: B)
	-- pivot at the bow on the beach; the hull lies toward -Z (the water), rolled onto its side
	put(b, "BoatHull", Vector3.new(6, 2.4, 13), CFrame.new(0, 1.5, -6.5) * rotZ(18), PAL.Hull, M.WoodPlanks, true, true)
	put(b, "BoatHullBow", Vector3.new(4, 2, 3), CFrame.new(0, 1.2, 1.2) * rotZ(18), PAL.Hull, M.WoodPlanks, true)
	put(b, "BoatHullStern", Vector3.new(5.4, 2.2, 0.6), CFrame.new(0, 1.4, -13.2) * rotZ(18), PAL.HullLight, M.WoodPlanks, true)
	put(b, "BoatCabin", Vector3.new(3, 1.8, 3.6), CFrame.new(0.8, 2.6, -8) * rotZ(18), PAL.HullLight, M.WoodPlanks, true)
end

-- Natural (never collide; names start with a Hygiene natural prefix) ───────────────────────────────────────────────
Builders.Joshua = function(b: B)
	local s = scaleOf(b)
	put(b, "JoshuaTrunk", Vector3.new(1.1 * s, 6.5 * s, 1.1 * s), CFrame.new(0, 3.25 * s, 0) * rotZ(6), PAL.JoshuaTrunk, M.Wood, false)
	put(b, "JoshuaCrown", Vector3.new(4.4 * s, 1.6 * s, 4.4 * s), CFrame.new(0.35 * s, 7.0 * s, 0) * rotY(20), PAL.JoshuaLeaf, M.Grass, false)
end

Builders.Saguaro = function(b: B)
	local s = scaleOf(b)
	vcyl(b, "SaguaroTrunk", 0, 0, 0, 9.5 * s, 1.4 * s, PAL.Cactus, M.SmoothPlastic, false)
	put(b, "SaguaroArm", Vector3.new(4.6 * s, 0.9 * s, 0.9 * s), CFrame.new(1.62 * s, 6.08 * s, 0) * rotZ(55), PAL.CactusLight, M.SmoothPlastic, false, false, Enum.PartType.Cylinder)
end

Builders.BarrelCactus = function(b: B)
	local s = scaleOf(b)
	vcyl(b, "BarrelCactus", 0, 0, 0, 1.8 * s, 2.2 * s, PAL.CactusLight, M.SmoothPlastic, false)
end

Builders.DeadTree = function(b: B)
	local s = scaleOf(b)
	local p = put(b, "DeadTree", Vector3.new(1.1 * s, 11 * s, 1.1 * s), CFrame.new(0.25 * s, 5.5 * s, 0) * rotZ(-5), PAL.DeadWood, M.Wood, false)
	queueMesh(b, "DeadTree", "each", { p })
end

Builders.Stump = function(b: B)
	local s = scaleOf(b)
	local p = vcyl(b, "Stump", 0, 0, 0, 1.6 * s, 2.4 * s, PAL.JoshuaTrunk, M.Wood, false)
	queueMesh(b, "Stump", "each", { p })
end

Builders.Log = function(b: B)
	local s = scaleOf(b)
	local p = put(b, "FallenLog", Vector3.new(9 * s, 1.5 * s, 1.5 * s), CFrame.new(0, 0.75 * s, 0) * ZCYL, PAL.DeadWood, M.Wood, false, false, Enum.PartType.Cylinder)
	queueMesh(b, "Log", "each", { p })
end

Builders.Reeds = function(b: B)
	local s = scaleOf(b)
	local a = put(b, "ReedsClump", Vector3.new(1.5 * s, 3.2 * s, 1.5 * s), CFrame.new(-0.8 * s, 1.6 * s, 0) * rotY(20), PAL.Reed, M.Grass, false)
	local c = put(b, "ReedsClump", Vector3.new(1.2 * s, 2.4 * s, 1.2 * s), CFrame.new(1.0 * s, 1.2 * s, 0.6 * s) * rotY(-15), PAL.DuneGrass, M.Grass, false)
	queueMesh(b, "Reeds", "each", { a, c })
end

Builders.DuneGrass = function(b: B)
	local s = scaleOf(b)
	local a = put(b, "DuneGrassTuft", Vector3.new(2.6 * s, 1.1 * s, 2.6 * s), CFrame.new(-0.9 * s, 0.55 * s, 0), PAL.DuneGrass, M.Grass, false)
	local c = put(b, "DuneGrassTuft", Vector3.new(2.0 * s, 0.8 * s, 2.0 * s), CFrame.new(1.2 * s, 0.4 * s, 0.8 * s) * rotY(30), PAL.Reed, M.Grass, false)
	queueMesh(b, "DuneGrass", "each", { a, c })
end

Builders.Driftwood = function(b: B)
	local s = scaleOf(b)
	local a = put(b, "DriftwoodLog", Vector3.new(7 * s, 0.9 * s, 0.9 * s), CFrame.new(0, 0.45 * s, 0) * rotY(10), PAL.Driftwood, M.Wood, false, false, Enum.PartType.Cylinder)
	local c = put(b, "DriftwoodLog", Vector3.new(4.5 * s, 0.7 * s, 0.7 * s), CFrame.new(0.6 * s, 0.35 * s, 1.2 * s) * rotY(-35), PAL.DeadWood, M.Wood, false, false, Enum.PartType.Cylinder)
	queueMesh(b, "Driftwood", "each", { a, c })
end

-- ── Add / Finish / Place ──────────────────────────────────────────────────────────────────────────────────────────
local warnedStep2: { [string]: boolean } = {} -- reserved kits (Specs row, no builder) and unknown ids: warned once

local function seedOf(cf: CFrame, opts: KitOpts): number
	if opts.Seed ~= nil then
		return opts.Seed
	end
	local p = cf.Position
	return math.floor(p.X * 7.31 + p.Z * 13.7 + 104729) % 2147483647
end

function WorldKits.Add(cluster: Model, kitId: string, cf: CFrame, opts: KitOpts?): number
	local s = WorldKits.Specs[kitId]
	local builder = Builders[kitId]
	if s == nil or builder == nil then
		if not warnedStep2[kitId] then
			warnedStep2[kitId] = true
			warn(if s == nil then "[WorldKits] unknown kit " .. kitId else "[WorldKits] kit " .. kitId .. " is reserved (no builder yet)")
		end
		return 0
	end
	local o: KitOpts = opts or {}
	local b: B = { Cluster = cluster, CF = cf, Opts = o, Parts = {}, Rng = WorldKits.Rng(seedOf(cf, o)), Overlays = {} }
	builder(b)
	if #b.Overlays > 0 then
		local list = pendingMesh[cluster]
		if list == nil then
			list = {}
			pendingMesh[cluster] = list
		end
		for _, ov in ipairs(b.Overlays) do
			table.insert(list :: { Overlay }, ov)
		end
	end
	return #b.Parts
end

-- ── Mesh overlays (deferred; LOOK's VisualAssetService.CloneKitMesh) ──────────────────────────────────────────────
local vasCache: any = nil
local function getVAS(): any
	if vasCache ~= nil then
		return if vasCache == false then nil else vasCache
	end
	local ok, mod = pcall(function(): any
		local services = script.Parent.Parent:FindFirstChild("Services")
		local m = services and services:FindFirstChild("VisualAssetService")
		if m and m:IsA("ModuleScript") then
			return (require :: any)(m)
		end
		return nil
	end)
	vasCache = if ok and mod ~= nil and type((mod :: any).CloneKitMesh) == "function" then mod else false
	return if vasCache == false then nil else vasCache
end

-- AABB of parts in the axes of `frame` → (box CFrame with frame's rotation, size)
local function boxIn(frame: CFrame, parts: { BasePart }): (CFrame, Vector3)
	local x0, x1, y0, y1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge, math.huge, -math.huge
	for _, p in ipairs(parts) do
		local rel = frame:ToObjectSpace(p.CFrame)
		local s = p.Size
		local r, u, l = rel.RightVector * s.X * 0.5, rel.UpVector * s.Y * 0.5, rel.LookVector * s.Z * 0.5
		local hx = math.abs(r.X) + math.abs(u.X) + math.abs(l.X)
		local hy = math.abs(r.Y) + math.abs(u.Y) + math.abs(l.Y)
		local hz = math.abs(r.Z) + math.abs(u.Z) + math.abs(l.Z)
		local c = rel.Position
		x0, x1 = math.min(x0, c.X - hx), math.max(x1, c.X + hx)
		y0, y1 = math.min(y0, c.Y - hy), math.max(y1, c.Y + hy)
		z0, z1 = math.min(z0, c.Z - hz), math.max(z1, c.Z + hz)
	end
	return frame * CFrame.new((x0 + x1) * 0.5, (y0 + y1) * 0.5, (z0 + z1) * 0.5), Vector3.new(x1 - x0, y1 - y0, z1 - z0)
end

type Skin = { MeshId: string, TextureId: string, MeshSize: Vector3 }
local skinCache: { [string]: Skin } = {}
local skinMiss: { [string]: boolean } = {}

-- one CloneKitMesh call; nil unless it returned a BasePart (a failed load, the sim, an unwired key)
local function cloneMesh(vas: any, key: string): BasePart?
	local ok, res = pcall(vas.CloneKitMesh, key)
	if ok and typeof(res) == "Instance" and res:IsA("BasePart") then
		return res
	end
	return nil
end

local function gone(inst: Instance): boolean
	return inst.Parent == nil
end

-- the mesh's frame and size inside a kit box: a WE_KitYaw quarter turn (90 / 180 / 270, or -90) turns the piece,
-- and an odd one swaps the box's X and Z so the piece's long axis lies on the kit's
local function yawedBox(m: BasePart, boxCf: CFrame, size: Vector3): (CFrame, Vector3)
	local yaw = tonumber(m:GetAttribute("WE_KitYaw")) or 0
	if yaw % 90 ~= 0 then
		return boxCf, size
	end
	local q = math.floor(yaw / 90 + 0.5) % 4
	if q == 0 then
		return boxCf, size
	end
	local cf = boxCf * CFrame.Angles(0, math.rad(q * 90), 0)
	if q % 2 == 1 then
		return cf, Vector3.new(size.Z, size.Y, size.X)
	end
	return cf, size
end

local function applyOverlay(cluster: Model, ov: Overlay, vas: any)
	local alive: { BasePart } = {}
	for _, p in ipairs(ov.Parts) do
		if p.Parent ~= nil and p:IsDescendantOf(cluster) then
			table.insert(alive, p)
		end
	end
	if #alive == 0 or cluster.Parent == nil then
		return
	end
	if ov.Mode == "skin" then
		if skinMiss[ov.Key] then
			return
		end
		local sk: Skin? = skinCache[ov.Key]
		if sk == nil then
			local mp = cloneMesh(vas, ov.Key)
			if mp and mp:IsA("MeshPart") then
				local m = mp :: MeshPart
				local fresh: Skin = { MeshId = m.MeshId, TextureId = m.TextureID, MeshSize = m.MeshSize }
				skinCache[ov.Key] = fresh
				sk = fresh
			else
				skinMiss[ov.Key] = true
			end
			if mp then
				mp:Destroy()
			end
		end
		if sk == nil then
			return
		end
		local ms = sk.MeshSize
		if ms.X <= 0 or ms.Y <= 0 or ms.Z <= 0 then
			return
		end
		for _, p in ipairs(alive) do
			if p:FindFirstChildOfClass("SpecialMesh") == nil then
				local sm = Instance.new("SpecialMesh")
				sm.MeshType = Enum.MeshType.FileMesh
				sm.MeshId = sk.MeshId
				sm.TextureId = sk.TextureId
				sm.Scale = Vector3.new(p.Size.X / ms.X, p.Size.Y / ms.Y, p.Size.Z / ms.Z)
				sm.Parent = p -- the Part keeps its box collision: net 0 parts
			end
		end
		return
	end
	if ov.Mode == "each" then
		for _, p in ipairs(alive) do
			local m = cloneMesh(vas, ov.Key)
			if m == nil then
				return
			end
			if gone(p) or gone(cluster) then
				m:Destroy()
				return
			end
			local frame = ov.Frame - ov.Frame.Position + p.Position
			local boxCf, size = boxIn(frame, { p })
			local meshCf, meshSize = yawedBox(m, boxCf, size)
			m.CFrame = meshCf
			m.Size = meshSize
			m.Name = p.Name
			m.Parent = p.Parent
			p:Destroy() -- net 0 parts
		end
		return
	end
	if ov.Mode == "collider" and #alive >= 2 then
		local m = cloneMesh(vas, ov.Key)
		if m == nil then
			return
		end
		if gone(cluster) then
			m:Destroy()
			return
		end
		local boxCf, size = boxIn(ov.Frame, alive)
		local biggest = alive[1]
		for _, p in ipairs(alive) do
			if p.Size.X * p.Size.Y * p.Size.Z > biggest.Size.X * biggest.Size.Y * biggest.Size.Z then
				biggest = p
			end
		end
		for _, p in ipairs(alive) do
			if p ~= biggest then
				p:Destroy()
			end
		end
		biggest.CFrame = boxCf
		biggest.Size = size
		biggest.Transparency = 1
		biggest.CanCollide = true
		biggest.CanQuery = true
		biggest.CastShadow = false
		biggest.Name = "WreckCollider"
		local meshCf, meshSize = yawedBox(m, boxCf, size)
		m.CFrame = meshCf
		m.Size = meshSize
		m.Name = ov.Key .. "Mesh"
		m.Parent = cluster -- 1 collider + 1 mesh replace n >= 2 parts
	end
end

-- ceil(cap / the number of distinct wired mesh keys in Specs), computed once (config lookups only, never yields)
local function shareOfCap(isWired: (string) -> boolean, cap: number): number
	local share = keyShare
	if share == nil then
		local seen: { [string]: boolean } = {}
		local n = 0
		for _, sp in pairs(WorldKits.Specs) do
			local key = sp.Mesh
			if key ~= nil and not seen[key] then
				seen[key] = true
				local ok, w = pcall(isWired, key)
				if ok and w == true then
					n += 1
				end
			end
		end
		share = if n > 0 then math.ceil(cap / n) else cap
		keyShare = share
	end
	return share :: number
end

local function scheduleOverlays(cluster: Model, list: { Overlay })
	local cap = KC.MeshOverlays
	local take: { Overlay } = {}
	-- owner list: a key that can never give a mesh (config id 0) takes no slot, and no key takes more than its share
	-- of the cap (config lookups only, never yields)
	local vasNow = getVAS()
	local isWired = if vasNow and type(vasNow.IsKitMeshWired) == "function" then vasNow.IsKitMeshWired else nil
	for _, ov in ipairs(list) do
		if overlaysQueued >= cap then
			break
		end
		if isWired then
			local okW, wired = pcall(isWired, ov.Key)
			if okW and wired == false then
				continue
			end
			if (overlaysByKey[ov.Key] or 0) >= shareOfCap(isWired, cap) then
				continue
			end
		end
		overlaysQueued += 1
		overlaysByKey[ov.Key] = (overlaysByKey[ov.Key] or 0) + 1
		table.insert(take, ov)
	end
	if #take == 0 then
		return
	end
	task.defer(function()
		local vas = getVAS()
		if vas == nil then
			return
		end
		for _, ov in ipairs(take) do
			local ok, err = pcall(function(): string?
				applyOverlay(cluster, ov, vas)
				return nil
			end)
			if not ok then
				warn("[WorldKits] mesh overlay " .. ov.Key .. " failed: " .. tostring(err))
			end
		end
	end)
end

local function closeCluster(cluster: Model)
	openClusters[cluster] = nil
	pendingSigns[cluster] = nil
	pendingMesh[cluster] = nil
end

function WorldKits.Discard(cluster: Model)
	closeCluster(cluster)
	cluster:Destroy()
end

-- Test hook (headless sim): mesh overlay slots spent so far, per key, and the per-key share of the cap (nil = unset).
function WorldKits._OverlayStats(): { Queued: number, ByKey: { [string]: number }, Share: number? }
	return { Queued = overlaysQueued, ByKey = table.clone(overlaysByKey), Share = keyShare }
end

function WorldKits.Finish(cluster: Model, parent: Instance): ClusterInfo
	local parts, lights, signs = 0, 0, 0
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, d in ipairs(cluster:GetDescendants()) do
		if d:IsA("BasePart") then
			parts += 1
			local cf, s = d.CFrame, d.Size
			local r = cf.RightVector * s.X * 0.5
			local u = cf.UpVector * s.Y * 0.5
			local l = cf.LookVector * s.Z * 0.5
			local hx = math.abs(r.X) + math.abs(u.X) + math.abs(l.X)
			local hz = math.abs(r.Z) + math.abs(u.Z) + math.abs(l.Z)
			local p = cf.Position
			x0, x1 = math.min(x0, p.X - hx), math.max(x1, p.X + hx)
			z0, z1 = math.min(z0, p.Z - hz), math.max(z1, p.Z + hz)
		elseif d:IsA("Light") then
			lights += 1
		elseif d:IsA("SurfaceGui") then
			signs += 1
		end
	end
	local span = if parts > 0 then math.max(x1 - x0, z1 - z0) else 0
	local reason: string? = nil
	if parts == 0 then
		reason = "no parts"
	elseif span > MAX_SPAN then
		reason = string.format("span %.0f > %d", span, MAX_SPAN)
	end
	local overlays = pendingMesh[cluster]
	closeCluster(cluster)
	if reason then
		cluster:Destroy()
		return { Ok = false, Parts = 0, Span = span, Lights = 0, Signs = 0, Reason = reason }
	end
	cluster.Parent = parent
	if overlays and #overlays > 0 then
		scheduleOverlays(cluster, overlays)
	end
	return { Ok = true, Parts = parts, Span = span, Lights = lights, Signs = signs, Reason = nil }
end

function WorldKits.Place(kitId: string, cf: CFrame, parent: Instance, opts: PlaceOpts): Model?
	local cluster = WorldKits.NewCluster(opts.Name, opts.Cluster)
	WorldKits.Add(cluster, kitId, cf, opts.Kit)
	local info = WorldKits.Finish(cluster, parent)
	return if info.Ok then cluster else nil
end

-- ── Footprint (measured from a throw-away build; cached) ──────────────────────────────────────────────────────────
local footCache: { [string]: Footprint } = {}

function WorldKits.Footprint(kitId: string, opts: KitOpts?): Footprint?
	local o: KitOpts = opts or {}
	local tw = o.Taxiway
	-- W3 step 2: keyed on R (HoldPad) and Taxiway (Runway) too
	local key = table.concat({ kitId, tostring(o.Variant), tostring(o.Count), tostring(o.Length), tostring(o.Scale), tostring(o.Width), tostring(o.Depth), tostring(o.Storeys), tostring(o.Roof), tostring(o.Lantern), tostring(o.R), if tw ~= nil then table.concat(tw, ",") else "nil" }, "|")
	local hit = footCache[key]
	if hit then
		return hit
	end
	if Builders[kitId] == nil then
		return nil
	end
	local tmp = Instance.new("Model")
	local frame = CFrame.new(0, GROUND_Y, 0)
	local b: B = {
		Cluster = tmp,
		CF = frame,
		Opts = {
			Variant = o.Variant,
			Count = o.Count,
			Length = o.Length,
			Scale = o.Scale,
			Width = o.Width,
			Depth = o.Depth,
			Storeys = o.Storeys,
			Roof = o.Roof,
			Lantern = o.Lantern,
			R = o.R,
			Taxiway = o.Taxiway,
			Light = false,
			Mesh = false,
			Seed = 1,
		},
		Parts = {},
		Rng = WorldKits.Rng(1),
		Overlays = {},
	}
	Builders[kitId](b)
	local fp: Footprint = { X0 = math.huge, X1 = -math.huge, Z0 = math.huge, Z1 = -math.huge, Top = 0, CollideZ0 = math.huge, VisibleZ0 = math.huge, Parts = #b.Parts }
	for _, p in ipairs(b.Parts) do
		local boxCf, size = boxIn(frame, { p })
		local c = boxCf.Position - frame.Position
		local px0, px1, pz0, pz1 = c.X - size.X * 0.5, c.X + size.X * 0.5, c.Z - size.Z * 0.5, c.Z + size.Z * 0.5
		local top = c.Y + size.Y * 0.5
		fp.X0, fp.X1, fp.Z0, fp.Z1 = math.min(fp.X0, px0), math.max(fp.X1, px1), math.min(fp.Z0, pz0), math.max(fp.Z1, pz1)
		fp.Top = math.max(fp.Top, top)
		if p.CanCollide then
			fp.CollideZ0 = math.min(fp.CollideZ0, pz0)
		end
		if p.Transparency < 0.99 and top > 0.3 then
			fp.VisibleZ0 = math.min(fp.VisibleZ0, pz0)
		end
	end
	tmp:Destroy()
	footCache[key] = fp
	return fp
end

-- ── Terrain (0 parts) ─────────────────────────────────────────────────────────────────────────────────────────────
local terrainHandle: any = nil
local terrainLog: { Prim } = {}

function WorldKits.SetTerrain(handle: any?)
	terrainHandle = handle
end

function WorldKits.TerrainLog(): { Prim }
	return terrainLog
end

function WorldKits.ResetTerrainLog()
	terrainLog = {}
end

-- the handle every Rock fill goes through (tests pass a recorder)
function WorldKits.TerrainHandle(): any
	return terrainHandle or Workspace.Terrain
end

type RockDef = { Radius: number, Count: { number }, R: { number } }

function WorldKits.Rock(pos: Vector3, kind: string, rng: Rng, opts: { Radius: number?, Material: Enum.Material?, Count: number? }?): { Prim }
	local def = (KC.Rock :: any)[kind] :: RockDef?
	if def == nil then
		warn("[WorldKits] unknown rock kind " .. kind)
		return {}
	end
	local o: { Radius: number?, Material: Enum.Material?, Count: number? } = opts or {}
	local run: string = kind
	local outer = math.max(2, o.Radius or def.Radius)
	local prims: { Prim } = {}
	local function ball(x: number, z: number, r: number, mat: Enum.Material)
		local y = GROUND_Y - 0.35 * r -- partly buried
		table.insert(prims, { Op = "Ball", CFrame = CFrame.new(x, y, z), Radius = r, Material = mat, Tag = "rock", Run = run, Top = y + r })
	end
	-- a random point whose disc of radius r stays inside the group's outer radius
	local function spot(r: number, spread: number): (number, number)
		local room = math.max(0, math.min(spread, outer - r))
		local a = rng:NextNumber(0, math.pi * 2)
		local d = room * math.sqrt(rng:NextNumber())
		return pos.X + math.cos(a) * d, pos.Z + math.sin(a) * d
	end
	local n = o.Count or rng:NextInteger(def.Count[1], def.Count[2])
	if kind == "scorch" then
		local w, d = outer * 1.6, outer * 1.1
		local yaw = rng:NextNumber(0, 180)
		-- the rotated block's corners stay within the outer radius: half-diagonal of (w, d) = outer * 0.97
		table.insert(prims, {
			Op = "Block",
			CFrame = CFrame.new(pos.X, GROUND_Y, pos.Z) * rotY(yaw),
			Size = Vector3.new(w, 1, d),
			Material = o.Material or M.Basalt,
			Tag = "rock",
			Run = run,
			Top = GROUND_Y + 0.5,
		})
	elseif kind == "outcrop" then
		local r0 = math.min(rng:NextNumber(math.max(def.R[1], 6), def.R[2]), outer * 0.75)
		local x, z = spot(r0, outer * 0.15)
		ball(x, z, r0, o.Material or M.Sandstone)
		for _ = 2, n do
			local r = math.min(rng:NextNumber(def.R[1], math.max(def.R[1], r0 * 0.7)), outer * 0.6)
			local sx, sz = spot(r, outer)
			ball(sx, sz, r, M.Rock)
		end
	else
		local mats = if kind == "rubble" then { M.Ground, M.Rock } else { o.Material or M.Rock, M.Rock }
		for i = 1, n do
			local r = math.min(rng:NextNumber(def.R[1], def.R[2]), outer * 0.6)
			local x, z = spot(r, outer)
			ball(x, z, r, mats[(i - 1) % #mats + 1])
		end
	end
	local handle = WorldKits.TerrainHandle()
	for _, p in ipairs(prims) do
		local ok, err = pcall(function()
			if p.Op == "Ball" then
				handle:FillBall(p.CFrame.Position, p.Radius, p.Material)
			else
				handle:FillBlock(p.CFrame, p.Size, p.Material)
			end
		end)
		if not ok then
			warn("[WorldKits] terrain fill failed: " .. tostring(err))
		end
		table.insert(terrainLog, p)
	end
	return prims
end

return WorldKits
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">WorldLabelPolicy</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v67: keep base labels readable instead of covering the screen.

	Up to 43 BillboardGuis sat on one plot, several AlwaysOnTop with infinite or 80-110 stud range, so
	"CLICK · $15", the ATM card, premium pads and soldier tags drew over each other from across the map.
	For every BillboardGui anchored inside a plot (config: WorldLabelConfig) this turns AlwaysOnTop off
	and caps MaxDistance. Label size/layout is left alone (several use fixed pixel layouts).

	v70 (HUD spec §5, mobile P1-10): the same rule outside the plots (WorldLabelConfig.ApplyOutsidePlots,
	OutsideMaxDistance). The position is the label's Adornee, else its first ancestor with a position (a part,
	an attachment or a model), not only the direct parent. AlwaysOnTop survives only for a name in
	AllowAlwaysOnTop or a WE_LabelRole in AlwaysOnTopRoles (Shared/Util/WorldLabel.SetRole: the one objective
	marker, a contested flag). WE_LabelPolicy records the scope: "plot" or "world".
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local WorldLabelConfig = require(Shared.Configs.WorldLabelConfig)

local WorldLabelPolicy = {}

local SCOPE_ATTR = "WE_LabelPolicy"
local ROLE_ATTR = WorldLabelConfig.RoleAttribute

local function positionOf(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Attachment") then
		return inst.WorldPosition
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return nil
end

-- The label's Adornee, else the first ancestor with a position (a label under a Folder inside a model still counts).
local function anchorPosition(bb: BillboardGui): Vector3?
	local ad: Instance? = bb.Adornee
	if ad then
		local p = positionOf(ad)
		if p then
			return p
		end
	end
	local node: Instance? = bb.Parent
	while node ~= nil and node ~= Workspace and node ~= game do
		local p = positionOf(node)
		if p then
			return p
		end
		node = node.Parent
	end
	return nil
end

local function insidePlot(pos: Vector3): boolean
	local margin = WorldLabelConfig.PlotMargin
	for _, pad in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if pad:IsA("BasePart") then
			local lp = pad.CFrame:PointToObjectSpace(pos)
			if math.abs(lp.X) <= pad.Size.X * 0.5 + margin and math.abs(lp.Z) <= pad.Size.Z * 0.5 + margin then
				return true
			end
		end
	end
	return false
end

local function mayDrawOnTop(bb: BillboardGui): boolean
	if WorldLabelConfig.AllowAlwaysOnTop[bb.Name] == true then
		return true
	end
	local role = bb:GetAttribute(ROLE_ATTR)
	return type(role) == "string" and WorldLabelConfig.AlwaysOnTopRoles[role] == true
end

local function enforce(bb: BillboardGui)
	if bb.AlwaysOnTop and not mayDrawOnTop(bb) then
		bb.AlwaysOnTop = false
	end
	local cap = if bb:GetAttribute(SCOPE_ATTR) == "world" then WorldLabelConfig.OutsideMaxDistance else WorldLabelConfig.MaxDistance
	if bb.MaxDistance <= 0 or bb.MaxDistance > cap then
		bb.MaxDistance = cap
	end
end

function WorldLabelPolicy.Apply(bb: BillboardGui)
	if not WorldLabelConfig.Enabled then
		return
	end
	if bb:GetAttribute(SCOPE_ATTR) ~= nil then
		enforce(bb)
		return
	end
	local pos = anchorPosition(bb)
	local inPlot = pos ~= nil and insidePlot(pos)
	if not inPlot and not WorldLabelConfig.ApplyOutsidePlots then
		return
	end
	bb:SetAttribute(SCOPE_ATTR, if inPlot then "plot" else "world")
	enforce(bb)
	-- Some services re-style their labels later (level changes, offers, roles); keep the rule in force.
	bb:GetPropertyChangedSignal("AlwaysOnTop"):Connect(function()
		enforce(bb)
	end)
	bb:GetPropertyChangedSignal("MaxDistance"):Connect(function()
		enforce(bb)
	end)
	bb:GetAttributeChangedSignal(ROLE_ATTR):Connect(function()
		enforce(bb)
	end)
end

function WorldLabelPolicy.Init()
	if not WorldLabelConfig.Enabled then
		return
	end
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("BillboardGui") then
			WorldLabelPolicy.Apply(d)
		end
	end
	Workspace.DescendantAdded:Connect(function(d: Instance)
		if d:IsA("BillboardGui") then
			-- Defer so the creating code finishes setting Adornee/AlwaysOnTop/MaxDistance first.
			task.defer(function()
				if d.Parent then
					WorldLabelPolicy.Apply(d :: BillboardGui)
				end
			end)
		end
	end)
end

return WorldLabelPolicy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">WorldPOI</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 2 (W3) — WorldPOI: the named places between the bases (gap/world_v2_spec.md §3.1–§3.2,
	roadmap §2.4 WORLD-B builder 1). Each ENABLED POI in WorldConfig.POIs becomes WarEmpireSetup.WorldDressing.POI_<Id>,
	a folder of cluster Models (each <= 64 studs across, H10) built from WorldKits. W3 step 1 built Crossroads Town only;
	W3 step 2 (spec scratchpad w3s2 §6 lane P) builds the other 17 from their POILayouts rows once their enable step flips
	them on. A disabled footprint stays reserved (WorldDress keeps out).

	CONTRACT (scratchpad/w3/contracts.md §2 and §4; W3 step 2: scratchpad w3s2/build/L0/contract.md §3 and §7): owner = P.

	PUBLIC API (server only):
	  WorldPOI.Build(dressing, quality, occ?) -> Summary
	      dressing = WarEmpireSetup.WorldDressing (MapDressing created it). For each enabled POI: destroys an old
	      POI_<Id>, builds its rows (the Town: WorldConfig.Town; every other POI: Server/Modules/POILayouts/<Layout>[Id])
	      in config order (Quality "Low" = Tier-1 clusters only), asserts every cluster with
	      WorldDress.Blocked(occ, x, z, r, { AllowPOI = Id, … }) (a blocked cluster is skipped and warned, never placed),
	      records each built cluster with WorldDress.AddDisc(occ, …, "poi:<Id>"), stays within the POI's caps, then
	      stamps the activity anchors (below). Idempotent. Never yields (mesh overlays are deferred by WorldKits).
	  WorldPOI.Enabled() -> { WorldConfig.POI }        POIs with Enabled == true, in config order
	  WorldPOI.FolderName(id) -> string                "POI_" .. id

	CAPS (per POI). The Town: Budget; Quality Low <= WorldDressConfig.Quality.Low.POIShare of its planned Full build.
	A layout POI: Full cap = Budget - Reserve (parts kept free for the jobs' runtime transients); Low cap =
	min(Full cap, floor(planned Full x (LowShare or POIShare))). Lights / Signs are per-POI caps (a board over the sign
	cap stays unpainted; WorldKits.Sign also keeps the world budget WorldConfig.Budgets.SurfaceGuis). Planned counts come
	from WorldKits.Footprint for every kit with a builder (a later kit whose builder has not landed builds 0 and counts 0).

	THE RULES (the Town and every layout; rows are data, not code: one Model per cluster row at (X, Z) turned by Yaw):
	  * Block clusters: disc (AABB half-diagonal round the AABB centre) edge >= Town.RoadClear (30) from every road
	    centre line and outside every WorldDress keep-out (capture clear circles, the Empire Bank ring, garage pads,
	    event / NPC anchors, other POI footprints, water, …). A camp's own NPC anchors are not keep-outs for its own
	    clusters (WorldDress: the sandbags stand at the guard posts).
	  * Street clusters (Street = true: checkpoints, lamps, boards) stand beside or across a road: they skip the disc road
	    test and pass a per-part test instead (every collidable part >= 13, every visible part taller than 0.3 >= 9 from
	    every road centre line; CheckpointArm and road markings exempt, as in WorldHygiene H2).
	  * Flat markings (every part top <= 0.75 and no collision: PaveTile, HoldPad) may lie over an event anchor (the
	    supply crate lands on them) and are not added to the occupancy.
	  * InWater = true clusters (gantry, jetty) skip the water keep-out and carry WE_AllowInWater (Waterways cull, H3).
	  * The ActivityHost cluster (every kit of Class "anchor": 1 invisible part, no collision) passes the zones with the
	    default 13-stud road test, may sit over an event anchor and is not added to the occupancy.
	  * Every part stays inside the POI footprint (rect: every part's AABB; circle: the cluster disc). Terrain rubble /
	    scorch (WorldKits.Rock, 0 parts) passes Blocked too and keeps its centre (rect) / disc (circle) inside.
	  * Infra rows (the airstrip runway) are flat strips under POI_<Id>.Infra (one Model, WE_Infra: exempt from H10):
	    every part flat and non-collidable, inside the footprint, and sampled along its length through Blocked.
	  * The blocks are WorldKits.TownBlock rows; their Width / Depth / Storeys / Roof / Lantern (and HoldPad R) pass
	    through kitOpts, so the planned count (Footprint) and the build always use the same options.

	ACTIVITY ANCHORS (W3 step 2; WorldConfig.Activity): invisible Attachments tagged WE_ActivityAnchor (0 parts), each
	stamped through ActivityAnchors.Stamp, the one writer:
	  * Every built Checkpoint kit gets WorldConfig.Activity.CheckpointAnchors on its CheckpointBooth part, ids
	    "<POI>.<cluster Id>.<Role>" (ActivityAnchors.FromTemplate with the kit's world frame) — the Town's 4 included.
	  * Layout rows (POILayout.Anchors) go on the POI's ActivityHost part; Town rows (WorldConfig.Town.Anchors) on the
	    first part of the cluster they Require (a part of a kit with no mesh overlay). A row with Requires is stamped only
	    when that cluster was built (Quality Low drops Tier 2: expected; the job's site goes Quiet). A row whose id is not
	    of this POI, lies outside the footprint or repeats an id already stamped here is skipped and warned.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage.Shared.Configs
local WorldConfig = require(Configs.WorldConfig)
local WorldDressConfig = require(Configs.WorldDressConfig)
local WorldDress = require(script.Parent.WorldDress)
local WorldKits = require(script.Parent.WorldKits)
local ActivityAnchors = require(script.Parent.ActivityAnchors)

export type POISummary = {
	Id: string,
	Enabled: boolean,
	Built: boolean,
	Parts: number,
	Budget: number, -- Full cap = Budget - Reserve (Low cap = floor(planned Full x LowShare or POIShare), capped by it)
	Lights: number,
	LightsCap: number,
	Signs: number,
	SignsCap: number,
	Clusters: number,
	Skipped: number, -- clusters / rocks / infra rows dropped by WorldDress.Blocked or the caps (each one warned)
	TerrainPrims: number,
	Anchors: number, -- W3 step 2: activity anchors stamped (0 parts)
	AnchorsAbsent: number, -- anchor rows not stamped: Requires not built (Low: Tier 2), no host, or refused (warned)
}
export type Summary = {
	Quality: string,
	POIs: { POISummary },
	Parts: number,
	Lights: number,
	Signs: number,
	Clusters: number,
	TerrainPrims: number,
	Anchors: number,
	Seconds: number,
	Warnings: { string },
}

type Road = WorldDress.Road
type Occupancy = WorldDress.Occupancy
type TownCluster = WorldConfig.TownCluster
type LayoutGroup = { [string]: WorldConfig.POILayout }
-- one place's rows: the Town's (WorldConfig.Town) or a POILayouts entry
type Rows = {
	Clusters: { TownCluster },
	Rocks: { WorldConfig.TownRock },
	Infra: { WorldConfig.InfraRow },
	Anchors: { WorldConfig.ActivityAnchor },
	Board: string?,
	Seed: number,
	Layout: boolean, -- false = the Town (Budget / POIShare caps, Town rows host on their Required cluster)
}
type Booth = { Part: BasePart, Frame: CFrame }
-- what one built cluster offers the anchors
type Built = {
	First: BasePart?, -- the first part of a kit with no mesh overlay (Town rows host here)
	Host: BasePart?, -- the ActivityHost part (layout rows host here)
	Booths: { Booth }, -- one per Checkpoint kit: its CheckpointBooth part and the kit's world frame
	MissingBooths: number, -- Checkpoint kits without a CheckpointBooth part (warned)
}
type Ctx = {
	Poi: WorldConfig.POI,
	Folder: Folder,
	Quality: string,
	Occ: Occupancy,
	Row: POISummary,
	Warnings: { string },
	Built: { [string]: Built }, -- cluster Id -> what it built (clusters that were Finished only)
}

local WorldPOI = {}

local GROUND_Y = 0.5
local H = WorldConfig.Hygiene
local A = WorldConfig.Activity
local INFRA_NAME = "Infra" -- POI_<Id>.Infra: the flat infrastructure strips (InfraRow)
-- the attribute WorldHygiene exempts from H10 (read loosely: WorldConfig.Hygiene may name it later)
local INFRA_ATTR: string = (H :: any).InfraAttr or "WE_Infra"

function WorldPOI.FolderName(id: string): string
	return WorldDressConfig.Folders.POIPrefix .. id
end

function WorldPOI.Enabled(): { WorldConfig.POI }
	local out: { WorldConfig.POI } = {}
	for _, p in ipairs(WorldConfig.POIs) do
		if p.Enabled == true then
			table.insert(out, p)
		end
	end
	return out
end

local function toSet(list: { string }): { [string]: boolean }
	local s: { [string]: boolean } = {}
	for _, v in ipairs(list) do
		s[v] = true
	end
	return s
end

local ROAD_EXEMPT = toSet(H.RoadExemptNames)

local function hasPrefix(name: string, list: { string }): boolean
	for _, p in ipairs(list) do
		if string.sub(name, 1, #p) == p then
			return true
		end
	end
	return false
end

-- world AABB of one part
local function partBox(p: BasePart): (number, number, number, number, number, number)
	local cf, s = p.CFrame, p.Size
	local r = cf.RightVector * s.X * 0.5
	local u = cf.UpVector * s.Y * 0.5
	local l = cf.LookVector * s.Z * 0.5
	local hx = math.abs(r.X) + math.abs(u.X) + math.abs(l.X)
	local hy = math.abs(r.Y) + math.abs(u.Y) + math.abs(l.Y)
	local hz = math.abs(r.Z) + math.abs(u.Z) + math.abs(l.Z)
	local c = cf.Position
	return c.X - hx, c.X + hx, c.Y - hy, c.Y + hy, c.Z - hz, c.Z + hz
end

-- XZ distance from a box to the nearest road centre segment
local function roadBoxDist(roads: { Road }, x0: number, x1: number, z0: number, z1: number): number
	local best = math.huge
	for _, r in ipairs(roads) do
		local a0, a1, c0, c1 = x0, x1, z0, z1
		if not r.AlongX then
			a0, a1, c0, c1 = z0, z1, x0, x1
		end
		local dA = math.max(0, r.Min - a1, a0 - r.Max)
		local dC = math.max(0, c0 - r.Across, r.Across - c1)
		local d = math.sqrt(dA * dA + dC * dC)
		if d < best then
			best = d
		end
	end
	return best
end

type Measure = {
	Parts: number,
	Lights: number,
	Signs: number,
	X0: number,
	X1: number,
	Z0: number,
	Z1: number,
	Marking: boolean, -- every part flat (top <= RoadMinTop) and non-colliding
	RoadWhy: string?, -- the first part that breaks the per-part road rule
	Outside: string?, -- the first part outside the POI rect
}

local function measure(model: Model, roads: { Road }, rect: WorldConfig.Rect?): Measure
	local T = WorldConfig.Town
	local m: Measure = { Parts = 0, Lights = 0, Signs = 0, X0 = math.huge, X1 = -math.huge, Z0 = math.huge, Z1 = -math.huge, Marking = true, RoadWhy = nil, Outside = nil }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			m.Parts += 1
			local x0, x1, _, y1, z0, z1 = partBox(d)
			m.X0, m.X1, m.Z0, m.Z1 = math.min(m.X0, x0), math.max(m.X1, x1), math.min(m.Z0, z0), math.max(m.Z1, z1)
			if d.CanCollide or y1 > H.RoadMinTop then
				m.Marking = false
			end
			if m.RoadWhy == nil and not ROAD_EXEMPT[d.Name] then
				local gap = roadBoxDist(roads, x0, x1, z0, z1)
				if d.CanCollide and y1 > H.RoadMinTop and gap < T.CollideRoadGap then
					m.RoadWhy = string.format("road: collidable %s %.1f from a road line", d.Name, gap)
				elseif d.Transparency < 0.99 and y1 > GROUND_Y + H.RoadLaneMaxHeight and gap < T.VisibleRoadGap and not hasPrefix(d.Name, H.RoadMarkingPrefixes) then
					m.RoadWhy = string.format("road: visible %s %.1f from a road line", d.Name, gap)
				end
			end
			if m.Outside == nil and rect ~= nil and (x0 < rect.X0 or x1 > rect.X1 or z0 < rect.Z0 or z1 > rect.Z1) then
				m.Outside = "outside the footprint: " .. d.Name
			end
		elseif d:IsA("Light") then
			m.Lights += 1
		elseif d:IsA("SurfaceGui") then
			m.Signs += 1
		end
	end
	return m
end

-- a circle footprint holds the whole cluster disc (a rect footprint is tested per part in measure)
local function circleWhy(poi: WorldConfig.POI, x: number, z: number, r: number): string?
	local c = poi.Circle
	if c == nil or poi.Rect ~= nil then
		return nil
	end
	local out = math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) + r - c.R
	if out > 0.01 then
		return string.format("outside the footprint circle by %.1f", out)
	end
	return nil
end

-- a point inside the POI footprint (anchor rows; rocks test their centre in a rect, their disc in a circle)
local function insideFootprint(poi: WorldConfig.POI, x: number, z: number, r: number): boolean
	local rect = poi.Rect
	if rect then
		return x >= rect.X0 and x <= rect.X1 and z >= rect.Z0 and z <= rect.Z1
	end
	local c = poi.Circle
	if c then
		return math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) + r <= c.R + 0.01
	end
	return false
end

-- the WorldKits options of one cluster kit row (text only for a real build)
local function kitOpts(k: WorldConfig.KitPlace, text: string?): WorldKits.KitOpts
	return {
		Variant = k.Variant,
		Count = k.Count,
		Length = k.Length,
		Scale = k.Scale,
		Color = k.Color,
		Text = text,
		Width = k.Width,
		Depth = k.Depth,
		Storeys = k.Storeys,
		Roof = k.Roof,
		Lantern = k.Lantern,
		R = k.R,
	}
end

local function kitParts(kit: WorldConfig.KitPlace): (number, number, number)
	local s = WorldKits.Specs[kit.Kit]
	if s == nil then
		return 0, 0, 0
	end
	-- the exact count, measured from the kit builder (cached): CrateStack / DrumGroup Count is crates / drums (1 part
	-- each), SandbagLine / CompoundWall Length is studs, Wreck "car" is 4 parts; W3 step 2 kits count the same way
	local fp = WorldKits.Footprint(kit.Kit, kitOpts(kit, nil))
	if fp == nil and s.Step ~= 1 then
		return 0, 0, 0 -- a later-POI kit whose builder has not landed: WorldKits.Add builds nothing for it either
	end
	local lights = s.Lights + (if kit.Lantern == true then 1 else 0) -- a TownBlock wall lantern carries a night light
	return if fp then fp.Parts else s.PartsMax, lights, s.Signs
end

local function planned(c: TownCluster): (number, number, number)
	local p, l, g = 0, 0, 0
	for _, k in ipairs(c.Kits) do
		local a, b, d = kitParts(k)
		p, l, g = p + a, l + b, g + d
	end
	return p, l, g
end

local function infraOpts(inf: WorldConfig.InfraRow): WorldKits.KitOpts
	return { Length = inf.Length, Taxiway = inf.Taxiway }
end

local function infraParts(inf: WorldConfig.InfraRow): number
	if WorldKits.Specs[inf.Kit] == nil then
		return 0
	end
	local fp = WorldKits.Footprint(inf.Kit, infraOpts(inf))
	return if fp then fp.Parts else 0
end

-- every kit of the cluster is the invisible activity host (Class "anchor")
local function isHostCluster(c: TownCluster): boolean
	if #c.Kits == 0 then
		return false
	end
	for _, k in ipairs(c.Kits) do
		local s = WorldKits.Specs[k.Kit]
		if s == nil or s.Class ~= "anchor" then
			return false
		end
	end
	return true
end

local function note(ctx: Ctx, msg: string)
	table.insert(ctx.Warnings, msg)
	warn(msg)
end

local function skip(ctx: Ctx, what: string, why: string)
	ctx.Row.Skipped += 1
	note(ctx, string.format("[WorldPOI] %s: %s skipped (%s)", ctx.Poi.Id, what, why))
end

local function childSet(model: Model): { [Instance]: boolean }
	local s: { [Instance]: boolean } = {}
	for _, ch in ipairs(model:GetChildren()) do
		s[ch] = true
	end
	return s
end

-- the parts one WorldKits.Add call put into the cluster (they are direct children), in GetChildren order
local function freshParts(model: Model, before: { [Instance]: boolean }): { BasePart }
	local out: { BasePart } = {}
	for _, ch in ipairs(model:GetChildren()) do
		if not before[ch] and ch:IsA("BasePart") then
			table.insert(out, ch)
		end
	end
	return out
end

-- remember the parts the anchors may host on (the booth of each checkpoint, the activity host, a plain first part)
local function noteKit(built: Built, kitId: string, parts: { BasePart }, kcf: CFrame)
	local spec = WorldKits.Specs[kitId]
	local plain = spec ~= nil and spec.Mesh == nil -- no deferred mesh overlay can replace or skin these parts
	local booth: BasePart? = nil
	for _, p in ipairs(parts) do
		if built.First == nil and plain then
			built.First = p
		end
		if kitId == A.HostKit and built.Host == nil then
			built.Host = p
		end
		if kitId == A.CheckpointKit and booth == nil and p.Name == A.CheckpointHost then
			booth = p
		end
	end
	if kitId == A.CheckpointKit and #parts > 0 then
		if booth then
			table.insert(built.Booths, { Part = booth, Frame = kcf })
		else
			built.MissingBooths += 1
		end
	end
end

-- the part cap of this place for this quality
local function partsCapOf(ctx: Ctx, rows: Rows): number
	local poi = ctx.Poi
	local low = ctx.Quality == "Low"
	local fullPlanned = 0
	for _, c in ipairs(rows.Clusters) do
		fullPlanned += (planned(c))
	end
	for _, inf in ipairs(rows.Infra) do
		fullPlanned += infraParts(inf)
	end
	if not rows.Layout then
		-- the Town: Budget; Quality Low at POIShare of its planned Full build
		local partsCap = if low then math.min(poi.Budget, math.floor(fullPlanned * WorldDressConfig.Quality.Low.POIShare + 1e-9)) else poi.Budget
		return partsCap
	end
	local fullCap = poi.Budget - (poi.Reserve or 0)
	local share = poi.LowShare or WorldDressConfig.Quality.Low.POIShare
	return if low then math.min(fullCap, math.floor(fullPlanned * share + 1e-9)) else fullCap
end

-- ── infra strips (the airstrip runway): POI_<Id>.Infra, flat, no collision, exempt from H10 ──────────────────────────
local function infraWhy(ctx: Ctx, parts: { BasePart }): string?
	local poi, occ = ctx.Poi, ctx.Occ
	for _, p in ipairs(parts) do
		local x0, x1, _, y1, z0, z1 = partBox(p)
		if p.CanCollide or y1 > H.RoadMinTop then
			return "not a flat marking: " .. p.Name
		end
		local rect, circle = poi.Rect, poi.Circle
		if rect and (x0 < rect.X0 or x1 > rect.X1 or z0 < rect.Z0 or z1 > rect.Z1) then
			return "outside the footprint: " .. p.Name
		end
		if rect == nil and circle then
			for _, q in ipairs({ { x0, z0 }, { x0, z1 }, { x1, z0 }, { x1, z1 } }) do
				if math.sqrt((q[1] - circle.X) ^ 2 + (q[2] - circle.Z) ^ 2) > circle.R + 0.01 then
					return "outside the footprint circle: " .. p.Name
				end
			end
		end
		-- the strip as discs along its long side: every zone except the road corridor (flat) and event anchors
		local dx, dz = x1 - x0, z1 - z0
		local w = math.max(1, math.min(dx, dz))
		local n = math.max(1, math.ceil(math.max(dx, dz) / w))
		local r = w * 0.5 * math.sqrt(2)
		for i = 1, n do
			local t = (i - 0.5) / n
			local sx = if dx >= dz then x0 + dx * t else (x0 + x1) * 0.5
			local sz = if dx >= dz then (z0 + z1) * 0.5 else z0 + dz * t
			local why = WorldDress.Blocked(occ, sx, sz, r, { AllowPOI = poi.Id, RoadClear = 0, RoadR = 0, SkipEvents = true })
			if why ~= nil then
				return string.format("%s at (%.0f, %.0f): %s", p.Name, sx, sz, why)
			end
		end
	end
	return nil
end

local function buildInfra(ctx: Ctx, rows: Rows, partsCap: number)
	if #rows.Infra == 0 then
		return
	end
	local poi, row = ctx.Poi, ctx.Row
	local model = Instance.new("Model")
	model.Name = INFRA_NAME
	local placed = 0
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, inf in ipairs(rows.Infra) do
		local what = "infra " .. inf.Id
		local s = WorldKits.Specs[inf.Kit]
		if s == nil or s.Class ~= "infra" then
			skip(ctx, what, "not an infra kit: " .. inf.Kit)
			continue
		end
		local pParts = infraParts(inf)
		if row.Parts + placed + pParts > partsCap then
			skip(ctx, what, string.format("caps: parts %d + %d > %d", row.Parts + placed, pParts, partsCap))
			continue
		end
		local before = childSet(model)
		local kcf = CFrame.new(inf.X, GROUND_Y, inf.Z) * CFrame.Angles(0, math.rad(inf.Yaw), 0)
		WorldKits.Add(model, inf.Kit, kcf, infraOpts(inf))
		local parts = freshParts(model, before)
		local why = if #parts == 0 then "no parts" else infraWhy(ctx, parts)
		if why == nil then
			for _, p in ipairs(parts) do
				if p:FindFirstChildWhichIsA("Light", true) or p:FindFirstChildWhichIsA("SurfaceGui", true) then
					why = "an infra strip carries no light or sign: " .. p.Name
					break
				end
			end
		end
		if why ~= nil then
			for _, ch in ipairs(model:GetChildren()) do
				if not before[ch] then
					ch:Destroy()
				end
			end
			skip(ctx, what, why)
			continue
		end
		for _, p in ipairs(parts) do
			local a0, a1, _, _, b0, b1 = partBox(p)
			x0, x1, z0, z1 = math.min(x0, a0), math.max(x1, a1), math.min(z0, b0), math.max(z1, b1)
		end
		placed += #parts
	end
	if placed == 0 then
		model:Destroy()
		return
	end
	model:SetAttribute("WE_Cluster", "poi:infra")
	model:SetAttribute("WE_Anchor", "poi:" .. poi.Id)
	model:SetAttribute("WE_AnchorX", math.floor((x0 + x1) * 50 + 0.5) / 100)
	model:SetAttribute("WE_AnchorZ", math.floor((z0 + z1) * 50 + 0.5) / 100)
	model:SetAttribute("WE_Tier", 1)
	model:SetAttribute(INFRA_ATTR, true)
	model.Parent = ctx.Folder
	row.Parts += placed
end

-- ── clusters (the Town and every layout) ───────────────────────────────────────────────────────────────────────────
local function placeClusters(ctx: Ctx, rows: Rows, partsCap: number)
	local T = WorldConfig.Town
	local poi, occ, row = ctx.Poi, ctx.Occ, ctx.Row
	local low = ctx.Quality == "Low"
	local roads = occ.Zones.Roads
	local lightsCap, signsCap = row.LightsCap, row.SignsCap
	local anchor = "poi:" .. poi.Id

	for _, c in ipairs(rows.Clusters) do
		if low and c.Tier ~= 1 then
			continue
		end
		local pParts, pLights = planned(c)
		if row.Parts + pParts > partsCap or row.Lights + pLights > lightsCap then
			skip(ctx, c.Id, string.format("caps: parts %d + %d > %d or lights %d + %d > %d", row.Parts, pParts, partsCap, row.Lights, pLights, lightsCap))
			continue
		end
		local model = WorldKits.NewCluster(c.Id, { Source = "poi", Kind = c.Role, Anchor = anchor, AnchorX = c.X, AnchorZ = c.Z, Tier = c.Tier, InWater = c.InWater })
		local frame = CFrame.new(c.X, GROUND_Y, c.Z) * CFrame.Angles(0, math.rad(c.Yaw), 0)
		local built: Built = { First = nil, Host = nil, Booths = {}, MissingBooths = 0 }
		local signsHere = 0
		for _, k in ipairs(c.Kits) do
			local text = k.Text
			if text == nil and k.Kit == "PoiBoard" then
				text = rows.Board
			end
			if text ~= nil and row.Signs + signsHere + 1 > signsCap then
				text = nil -- the POI's sign cap: the board stays, unpainted
			end
			if text ~= nil then
				signsHere += 1
			end
			local kcf = frame * CFrame.new(k.X, 0, k.Z) * CFrame.Angles(0, math.rad(k.Yaw or 0), 0)
			local before = childSet(model)
			WorldKits.Add(model, k.Kit, kcf, kitOpts(k, text))
			noteKit(built, k.Kit, freshParts(model, before), kcf)
		end
		local m = measure(model, roads, poi.Rect)
		local cx, cz = (m.X0 + m.X1) * 0.5, (m.Z0 + m.Z1) * 0.5
		local r = 0.5 * math.sqrt((m.X1 - m.X0) ^ 2 + (m.Z1 - m.Z0) ^ 2)
		local hostOnly = isHostCluster(c)
		local why: string? = nil
		if m.Parts == 0 then
			why = "no parts"
		elseif c.Street then
			why = WorldDress.Blocked(occ, cx, cz, r, { AllowPOI = poi.Id, RoadClear = 0, RoadR = 0, AllowWater = c.InWater })
		elseif hostOnly then
			-- the invisible activity host (nothing to see or bump into): the default road test; may sit over an event anchor
			why = WorldDress.Blocked(occ, cx, cz, r, { AllowPOI = poi.Id, SkipEvents = true })
		elseif c.InWater == true then
			why = WorldDress.Blocked(occ, cx, cz, r, { AllowPOI = poi.Id, RoadClear = T.RoadClear, AllowWater = true, SkipEvents = m.Marking })
		else
			why = WorldDress.Blocked(occ, cx, cz, r, { AllowPOI = poi.Id, RoadClear = T.RoadClear })
			if m.Marking and why ~= nil and string.sub(why, 1, 13) == "anchor:Event_" then
				-- flat paving / a hold pad under an event anchor: the crate lands on it (every other zone still counts)
				why = WorldDress.Blocked(occ, cx, cz, r, { AllowPOI = poi.Id, RoadClear = T.RoadClear, SkipEvents = true })
			end
		end
		why = why or m.RoadWhy or m.Outside or circleWhy(poi, cx, cz, r)
		if why == nil and row.Parts + m.Parts > partsCap then
			why = string.format("budget %d + %d > %d", row.Parts, m.Parts, partsCap)
		end
		if why == nil and row.Lights + m.Lights > lightsCap then
			why = string.format("lights %d + %d > %d", row.Lights, m.Lights, lightsCap)
		end
		if why == nil and row.Signs + m.Signs > signsCap then
			why = string.format("signs %d + %d > %d", row.Signs, m.Signs, signsCap)
		end
		if why ~= nil then
			WorldKits.Discard(model)
			skip(ctx, c.Id, why)
			continue
		end
		model:SetAttribute("WE_AnchorX", math.floor(cx * 100 + 0.5) / 100)
		model:SetAttribute("WE_AnchorZ", math.floor(cz * 100 + 0.5) / 100)
		local info = WorldKits.Finish(model, ctx.Folder)
		if not info.Ok then
			skip(ctx, c.Id, info.Reason or "Finish refused")
			continue
		end
		if not m.Marking and not hostOnly then
			WorldDress.AddDisc(occ, cx, cz, r, anchor)
		end
		row.Parts += info.Parts
		row.Lights += info.Lights
		row.Signs += info.Signs
		row.Clusters += 1
		ctx.Built[c.Id] = built
	end
end

-- a stable per-place seed for the terrain rubble (the Town keeps Town.Seed)
local function seedOf(id: string): number
	local h = WorldConfig.Town.Seed
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 2147483647
	end
	return h
end

-- ── terrain rubble and scorch (0 parts; each group's disc passes the same block rule) ────────────────────────────
local function placeRocks(ctx: Ctx, rows: Rows)
	local T = WorldConfig.Town
	local poi, occ, row = ctx.Poi, ctx.Occ, ctx.Row
	local low = ctx.Quality == "Low"
	local anchor = "poi:" .. poi.Id
	local rng = WorldKits.Rng(rows.Seed)
	for i, rk in ipairs(rows.Rocks) do
		if low and rk.Tier ~= 1 then
			continue
		end
		local maxCount = ((WorldConfig.Kits.Rock :: any)[rk.Kind] or { Count = { 0, 4 } }).Count[2] :: number
		if row.TerrainPrims + maxCount > T.MaxTerrainPrims then
			skip(ctx, "rock " .. i, "terrain prim cap")
			continue
		end
		local why = WorldDress.Blocked(occ, rk.X, rk.Z, rk.Radius, { AllowPOI = poi.Id, RoadClear = T.RoadClear })
		if why == nil and not insideFootprint(poi, rk.X, rk.Z, if poi.Rect then 0 else rk.Radius) then
			why = "outside the footprint"
		end
		if why ~= nil then
			skip(ctx, "rock " .. i, why)
			continue
		end
		local prims = WorldKits.Rock(Vector3.new(rk.X, GROUND_Y, rk.Z), rk.Kind, rng, { Radius = rk.Radius })
		WorldDress.AddDisc(occ, rk.X, rk.Z, rk.Radius, anchor)
		row.TerrainPrims += #prims
	end
end

-- ── activity anchors (0 parts): the checkpoint template, then the place's rows ─────────────────────────────────────
local function stampAnchors(ctx: Ctx, rows: Rows)
	local poi, row = ctx.Poi, ctx.Row
	local stamped: { [string]: boolean } = {}
	local function stamp(host: BasePart, def: ActivityAnchors.StampDef)
		if stamped[def.Id] then
			row.AnchorsAbsent += 1
			note(ctx, string.format("[WorldPOI] %s: anchor %s skipped (duplicate id)", poi.Id, def.Id))
			return
		end
		if ActivityAnchors.Stamp(host, def) then
			stamped[def.Id] = true
			row.Anchors += 1
		else
			row.AnchorsAbsent += 1
			table.insert(ctx.Warnings, string.format("[WorldPOI] %s: anchor %s refused by ActivityAnchors.Stamp", poi.Id, tostring(def.Id)))
		end
	end

	-- 1) every built checkpoint: the template on its CheckpointBooth (site = the cluster Id)
	local host: BasePart? = nil
	local known: { [string]: boolean } = {}
	for _, c in ipairs(rows.Clusters) do
		known[c.Id] = true
		local b = ctx.Built[c.Id]
		if b then
			if host == nil and b.Host ~= nil then
				host = b.Host
			end
			if b.MissingBooths > 0 then
				row.AnchorsAbsent += #A.CheckpointAnchors * b.MissingBooths
				note(ctx, string.format("[WorldPOI] %s: %s has no %s part; its checkpoint anchors are not stamped", poi.Id, c.Id, A.CheckpointHost))
			end
			for i, booth in ipairs(b.Booths) do
				if i > 1 then
					row.AnchorsAbsent += #A.CheckpointAnchors
					note(ctx, string.format("[WorldPOI] %s: %s holds more than one checkpoint; only the first gets anchors", poi.Id, c.Id))
					continue
				end
				for _, t in ipairs(A.CheckpointAnchors) do
					stamp(booth.Part, ActivityAnchors.FromTemplate(t, poi.Id, c.Id, booth.Frame))
				end
			end
		end
	end

	-- 2) the rows: a layout's on its ActivityHost, the Town's on the first part of the cluster they Require
	local prefix = poi.Id .. "."
	local noHost = 0
	for _, a in ipairs(rows.Anchors) do
		local req = a.Requires
		if string.sub(a.Id, 1, #prefix) ~= prefix then
			row.AnchorsAbsent += 1
			note(ctx, string.format("[WorldPOI] %s: anchor %s skipped (not an id of this place)", poi.Id, a.Id))
			continue
		end
		if req ~= nil and not known[req] then
			row.AnchorsAbsent += 1
			note(ctx, string.format("[WorldPOI] %s: anchor %s skipped (Requires %s: no such cluster)", poi.Id, a.Id, req))
			continue
		end
		if not insideFootprint(poi, a.X, a.Z, 0) then
			row.AnchorsAbsent += 1
			note(ctx, string.format("[WorldPOI] %s: anchor %s skipped (outside the footprint)", poi.Id, a.Id))
			continue
		end
		local need = if req ~= nil then ctx.Built[req] else nil
		if req ~= nil and need == nil then
			row.AnchorsAbsent += 1 -- its cluster was not built (Quality Low drops Tier 2; a skipped cluster was warned)
			continue
		end
		local target: BasePart? = nil
		if rows.Layout then
			target = host
		elseif need ~= nil then
			target = need.First
		end
		if target == nil then
			row.AnchorsAbsent += 1
			noHost += 1
			continue
		end
		stamp(target, ActivityAnchors.FromRow(a))
	end
	if noHost > 0 then
		local why = if rows.Layout then "no " .. A.HostKit .. " cluster was built" else "a Town row needs Requires (its host cluster)"
		note(ctx, string.format("[WorldPOI] %s: %d anchor rows not stamped (%s)", poi.Id, noHost, why))
	end
end

-- ── places ─────────────────────────────────────────────────────────────────────────────────────────────────────────
local function buildPlace(ctx: Ctx, rows: Rows)
	local partsCap = partsCapOf(ctx, rows)
	buildInfra(ctx, rows, partsCap)
	placeClusters(ctx, rows, partsCap)
	placeRocks(ctx, rows)
	stampAnchors(ctx, rows)
end

-- Crossroads Town: its rows live in WorldConfig.Town
local function buildTown(ctx: Ctx)
	local T = WorldConfig.Town
	buildPlace(ctx, { Clusters = T.Clusters, Rocks = T.Rocks, Infra = {}, Anchors = T.Anchors, Board = T.BoardText, Seed = T.Seed, Layout = false })
end

-- POILayouts groups, required once (a failed or missing module warns and its places build nothing)
type GroupLoad = { Group: LayoutGroup?, Err: string? }
local groups: { [string]: GroupLoad } = {}
local function layoutGroup(name: string): GroupLoad
	local hit = groups[name]
	if hit then
		return hit
	end
	local res: GroupLoad = { Group = nil, Err = nil }
	local folder = script.Parent:FindFirstChild("POILayouts")
	local mod = if folder then folder:FindFirstChild(name) else nil
	if mod == nil or not mod:IsA("ModuleScript") then
		res.Err = "no module POILayouts." .. name
	else
		local ok, got = pcall(function(): any
			return (require :: any)(mod)
		end)
		if ok and type(got) == "table" then
			res.Group = got :: LayoutGroup
		else
			res.Err = "POILayouts." .. name .. " failed to load: " .. tostring(got)
		end
	end
	groups[name] = res
	return res
end

-- every other place: its rows live in Server/Modules/POILayouts/<POI.Layout>[Id]
local function buildLayout(ctx: Ctx)
	local poi = ctx.Poi
	local name = poi.Layout or "?"
	local load = layoutGroup(name)
	local group = load.Group
	local l = if group then group[poi.Id] else nil
	if l == nil then
		note(ctx, string.format("[WorldPOI] %s: no layout rows (%s)", poi.Id, load.Err or ("POILayouts." .. name .. " has no " .. poi.Id)))
		return
	end
	buildPlace(ctx, {
		Clusters = l.Clusters or {},
		Rocks = l.Rocks or {},
		Infra = l.Infra or {},
		Anchors = l.Anchors or {},
		Board = l.Board,
		Seed = seedOf(poi.Id),
		Layout = true,
	})
end

local BUILDERS: { [string]: (Ctx) -> () } = {
	town = buildTown,
}

function WorldPOI.Build(dressing: Instance, quality: string, occ: Occupancy?): Summary
	local t0 = os.clock()
	local q = WorldDress.Quality(quality)
	local o: Occupancy = occ or WorldDress.NewOccupancy()
	local summary: Summary = { Quality = q, POIs = {}, Parts = 0, Lights = 0, Signs = 0, Clusters = 0, TerrainPrims = 0, Anchors = 0, Seconds = 0, Warnings = {} }
	for _, p in ipairs(WorldConfig.POIs) do
		local row: POISummary = {
			Id = p.Id,
			Enabled = p.Enabled == true,
			Built = false,
			Parts = 0,
			Budget = p.Budget - (p.Reserve or 0),
			Lights = 0,
			LightsCap = p.Lights or 0,
			Signs = 0,
			SignsCap = p.Signs or 0,
			Clusters = 0,
			Skipped = 0,
			TerrainPrims = 0,
			Anchors = 0,
			AnchorsAbsent = 0,
		}
		table.insert(summary.POIs, row)
		if row.Enabled then
			local name = WorldPOI.FolderName(p.Id)
			local old = dressing:FindFirstChild(name)
			if old then
				old:Destroy()
			end
			local builder: ((Ctx) -> ())? = if p.Layout ~= nil then buildLayout else BUILDERS[p.Kind]
			if builder == nil then
				local msg = string.format("[WorldPOI] %s: no builder for kind %q yet", p.Id, p.Kind)
				table.insert(summary.Warnings, msg)
				warn(msg)
			else
				local folder = Instance.new("Folder")
				folder.Name = name
				folder.Parent = dressing
				local ctx: Ctx = { Poi = p, Folder = folder, Quality = q, Occ = o, Row = row, Warnings = summary.Warnings, Built = {} }
				local ok, err = pcall(function(): string?
					builder(ctx)
					return nil
				end)
				if not ok then
					local msg = string.format("[WorldPOI] %s build failed: %s", p.Id, tostring(err))
					table.insert(summary.Warnings, msg)
					warn(msg)
				end
				row.Built = row.Clusters > 0
			end
		end
		summary.Parts += row.Parts
		summary.Lights += row.Lights
		summary.Signs += row.Signs
		summary.Clusters += row.Clusters
		summary.TerrainPrims += row.TerrainPrims
		summary.Anchors += row.Anchors
	end
	summary.Seconds = os.clock() - t0
	for _, row in ipairs(summary.POIs) do
		if row.Enabled then
			print(string.format(
				"[WAR EMPIRE] WorldPOI: %s %s %d/%d parts, %d lights, %d signs, %d clusters, %d skipped, %d terrain (%.3f s)",
				q,
				row.Id,
				row.Parts,
				row.Budget,
				row.Lights,
				row.Signs,
				row.Clusters,
				row.Skipped,
				row.TerrainPrims,
				summary.Seconds
			))
			if row.Anchors + row.AnchorsAbsent > 0 then
				print(string.format("[WAR EMPIRE] WorldPOI: %s %s activity anchors %d stamped, %d absent", q, row.Id, row.Anchors, row.AnchorsAbsent))
			end
		end
	end
	return summary
end

return WorldPOI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">WorldTerrain</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 1 — WorldTerrain: the Terrain canyon edge that closes the map (gap/world_v2_spec.md §1.1–§1.2
	with the roadmap §1.5 corrections: talus top <= 20, mesas end <= 120 studs past the face, no back-fill wedge).

	The belt starts 12 studs outside the ring canal (x ±1852, z -1852; the rig lagoons step it out to ±1902) and runs
	down both sides to the Bay's far shore at z 2234, which closes the old open sea. Profile, outward from the water:
	toe (Rock ramp from under the sand, Terrain.Toe.Y, up to the talus foot over the skirt band 0..26: no lip for a
	car; the boats' +6 land probe sees it ~5 studs in = shore brake) → talus (Ground, 8 rising to <= 20; the same toe
	and talus on every run, so corners and run joins have no step) → vertical Sandstone face 90–150 with flush
	Limestone / Slate strata → 1–2 stepped mesas 160–300 → a butte every 4th segment; a shallow alcove every 5th; 1–3
	boulders at the cliff foot (on the talus, never on the toe). Quarter-circle corners with a bigger butte. Where a run
	stops at a rig-lagoon notch, hip carves bring its toe and talus down to the sand (no side wall). Sand slabs hide the
	outer sea ends behind the headlands; a rock pad carries the far-shore lighthouse (WorldBounds builds the tower).
	No voxel ever lands inside the playable ring or in public water (Check; the toe's support block lies under the Part
	ground, so it may). No terrain water (boats sail WE_Water parts).

	PUBLIC API (server only; nothing here is hooked yet — the post-F hook step calls it from MapSetup.Run):
	  WorldTerrain.Plan(cfg?: TerrainCfg, phase?: number) -> { Prim }
	      PURE and seeded (cfg.Seed). Phase 1 = the edge. Every primitive that fails Check is dropped (and warned).
	  WorldTerrain.Check(plan: { Prim }, cfg?) -> { string }
	      Keep-out / profile violations (empty = pass): ring, public water (headland exception), talus top, cap.
	  WorldTerrain.Stats(plan: { Prim }) -> Stats
	      Counts by tag / op, fill volume (studs³) and voxel estimate (4³ cells), max talus top, face height range.
	  WorldTerrain.Build(plan?: { Prim }, opts?: BuildOpts) -> (filled: number, seconds: number, skipped: boolean)
	      Fills the plan (default Plan(WorldConfig.Terrain, 1)). Idempotent: skips when Workspace.Terrain's
	      "WE_TerrainGen" attribute equals WorldConfig.Terrain.Gen; otherwise Terrain:Clear() (World v2 owns all
	      terrain), SetMaterialColor, fill (yielding every YieldEvery prims), then stamp. Logs
	      "[WAR EMPIRE] WorldTerrain: <n> prims in <t> s". Call it inside task.spawn after the bases are built.
	      opts.Terrain replaces Workspace.Terrain (tests pass a recorder); opts.YieldEvery = 0 never yields;
	      opts.Force rebuilds even when stamped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Configs = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs")
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local WaterConfig = require(Configs:WaitForChild("WaterConfig"))

export type Prim = {
	Op: string, -- "Block" | "Wedge" | "Ball" | "Cylinder"
	CFrame: CFrame,
	Size: Vector3?, -- Block / Wedge
	Radius: number?, -- Ball / Cylinder
	Height: number?, -- Cylinder (along the CFrame's Y axis)
	Material: Enum.Material,
	Tag: string, -- skirt | talus | face | strata | mesa | butte | alcove | boulder | corner | cover | landmark | hip
	Run: string, -- N | E | W | S (far shore) | <side>notch | corner<k> | cover | landmark
	Top: number, -- world Y of the primitive's top (checks)
}
export type TerrainCfg = typeof(WorldConfig.Terrain)
export type Profile = WorldConfig.Profile
export type Stats = {
	Total: number,
	ByTag: { [string]: number },
	ByOp: { [string]: number },
	Volume: number,
	Voxels: number,
	MaxTalusTop: number,
	FaceMin: number,
	FaceMax: number,
}
export type BuildOpts = { Terrain: any?, YieldEvery: number?, Force: boolean? }

local WorldTerrain = {}

local UP = Vector3.new(0, 1, 0)

-- ── helpers ──────────────────────────────────────────────────────────────────

-- Frame at pos whose local +Z is the outward normal n (a FillWedge rises toward local +Z, like a WedgePart) and
-- local +X runs along the edge. Right-handed: X = Y × Z.
local function frame(pos: Vector3, n: Vector3): CFrame
	return CFrame.fromMatrix(pos, UP:Cross(n), UP, n)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- XZ half-extents of a primitive (rotated box corners / ball / upright cylinder)
local function halfXZ(p: Prim): (number, number)
	if p.Op == "Ball" or p.Op == "Cylinder" then
		local r = p.Radius or 0
		return r, r
	end
	local s = p.Size or Vector3.zero
	local cf = p.CFrame
	local rx, uy, lz = cf.RightVector, cf.UpVector, cf.LookVector
	local hx = math.abs(rx.X) * s.X * 0.5 + math.abs(uy.X) * s.Y * 0.5 + math.abs(lz.X) * s.Z * 0.5
	local hz = math.abs(rx.Z) * s.X * 0.5 + math.abs(uy.Z) * s.Y * 0.5 + math.abs(lz.Z) * s.Z * 0.5
	return hx, hz
end

-- world XZ AABB (x0, x1, z0, z1)
local function boxXZ(p: Prim): (number, number, number, number)
	local hx, hz = halfXZ(p)
	local c = p.CFrame.Position
	return c.X - hx, c.X + hx, c.Z - hz, c.Z + hz
end

local function volumeOf(p: Prim): number
	if p.Op == "Ball" then
		local r = p.Radius or 0
		return 4 / 3 * math.pi * r * r * r
	elseif p.Op == "Cylinder" then
		local r = p.Radius or 0
		return math.pi * r * r * (p.Height or 0)
	end
	local s = p.Size or Vector3.zero
	local v = s.X * s.Y * s.Z
	return if p.Op == "Wedge" then v * 0.5 else v
end

-- smooth 1-D value noise in [0, 1] along the edge (lattice cell = wave studs)
local function makeNoise(rng: Random, wave: number, length: number): (number) -> number
	local n = math.ceil(length / wave) + 2
	local lattice: { number } = {}
	for i = 1, n do
		lattice[i] = rng:NextNumber()
	end
	return function(s: number): number
		local u = math.clamp(s / wave, 0, n - 2)
		local i = math.floor(u)
		local f = u - i
		f = f * f * (3 - 2 * f)
		return lerp(lattice[i + 1], lattice[i + 2], f)
	end
end

-- ── the edge polyline: straight runs, each with its outward normal and profile ───────────────────────────────

-- HipA / HipB: that end of the run stops at a rig-lagoon notch (not at a corner fan): Plan carves a hip there
type Run = { Name: string, A: Vector3, B: Vector3, N: Vector3, Profile: Profile, HipA: boolean?, HipB: boolean? }

local function sideRuns(c: TerrainCfg, side: string, sign: number): { Run }
	local e = c.Edge
	local inner, far = e.Inner, e.FarShoreZ
	local notches = {}
	for _, n in ipairs(e.Notches) do
		if n.Side == side then
			table.insert(notches, n)
		end
	end
	table.sort(notches, function(a, b)
		return a.Z0 < b.Z0
	end)
	local out: { Run } = {}
	local normal = Vector3.new(sign, 0, 0)
	local z = -inner
	for _, n in ipairs(notches) do
		if n.Z0 > z then
			table.insert(out, {
				Name = side,
				A = Vector3.new(sign * inner, 0, z),
				B = Vector3.new(sign * inner, 0, n.Z0),
				N = normal,
				Profile = c.Side,
				HipA = z > -inner,
				HipB = true,
			})
		end
		table.insert(out, { Name = side .. "notch", A = Vector3.new(sign * n.Out, 0, n.Z0), B = Vector3.new(sign * n.Out, 0, n.Z1), N = normal, Profile = c.Side })
		z = n.Z1
	end
	table.insert(out, { Name = side, A = Vector3.new(sign * inner, 0, z), B = Vector3.new(sign * inner, 0, far), N = normal, Profile = c.Side, HipA = z > -inner })
	return out
end

local function edgeRuns(c: TerrainCfg): { Run }
	local e = c.Edge
	local inner, far = e.Inner, e.FarShoreZ
	local runs: { Run } = {
		{ Name = "N", A = Vector3.new(-inner, 0, -inner), B = Vector3.new(inner, 0, -inner), N = Vector3.new(0, 0, -1), Profile = c.Side },
	}
	for _, r in ipairs(sideRuns(c, "E", 1)) do
		table.insert(runs, r)
	end
	for _, r in ipairs(sideRuns(c, "W", -1)) do
		table.insert(runs, r)
	end
	table.insert(runs, { Name = "S", A = Vector3.new(-inner, 0, far), B = Vector3.new(inner, 0, far), N = Vector3.new(0, 0, 1), Profile = c.FarShore })
	return runs
end

-- cut a run of `len` studs into segments of SegmentMin..SegmentMax (the last two share the remainder evenly)
local function cuts(rng: Random, len: number, smin: number, smax: number): { number }
	local out = { 0 }
	local s = 0
	while len - s > smax do
		local step = rng:NextNumber(smin, smax)
		if len - (s + step) < smin then
			step = (len - s) * 0.5
		end
		s += step
		table.insert(out, s)
	end
	table.insert(out, len)
	return out
end

-- ── one belt segment ─────────────────────────────────────────────────────────────────────────────────────────

type Seg = {
	Origin: Vector3, -- straight: the inner-edge point at the segment middle; corner: the corner point
	T: Vector3, -- along the edge
	N: Vector3, -- outward
	Width: (d: number) -> number, -- band width along T at outward distance d
	Profile: Profile,
	Index: number,
	S: number, -- arc position (face noise)
	Run: string,
	Corner: boolean,
	Straight: boolean, -- no yaw jitter (fan corners and run-end segments: a jittered end would leave a sliver)
}

local function emitSegment(plan: { Prim }, rng: Random, c: TerrainCfg, noise: (number) -> number, g: Seg)
	local pr = g.Profile
	local mats = c.Materials
	local foot = c.FootY
	local function at(d: number, along: number, y: number): Vector3
		return g.Origin + g.N * d + g.T * along + UP * y
	end
	local function block(tag: string, mat: Enum.Material, d0: number, d1: number, y0: number, y1: number, along: number, width: number, yaw: number)
		local cf = frame(at((d0 + d1) * 0.5, along, (y0 + y1) * 0.5), g.N)
		if yaw ~= 0 then
			cf *= CFrame.Angles(0, math.rad(yaw), 0)
		end
		table.insert(plan, { Op = "Block", CFrame = cf, Size = Vector3.new(width, y1 - y0, d1 - d0), Material = mat, Tag = tag, Run = g.Run, Top = y1 })
		return cf
	end

	-- 1) toe (the skirt band): a Rock ramp, not a shelf. A support block FootY..Toe.Y (buried under the Part ground:
	--    it keeps the voxels under the ramp full, so the smooth-terrain surface sits where the wedge says) and a
	--    FillWedge rising Toe.Y -> Talus.Min over Skirt.From..Skirt.To (= Talus.From). The belt grows out of the sand
	--    with no lip and meets the talus foot level: the old 2.5..5.5 shelf edge, the shelf -> talus step and the
	--    shelf-height jumps between segments tripped vehicles. The Skirt Min..Max roll is still drawn, so the seeded
	--    stream (faces, mesas, buttes, alcoves, boulders) is unchanged.
	rng:NextNumber(pr.Skirt.Min, pr.Skirt.Max)
	local toe = c.Toe
	local sw = g.Width(pr.Skirt.To)
	block("skirt", mats.Skirt, pr.Skirt.From, pr.Skirt.To, foot, toe.Y, 0, sw, 0)
	do
		local cf = frame(at((pr.Skirt.From + pr.Skirt.To) * 0.5, 0, (toe.Y + pr.Talus.Min) * 0.5), g.N)
		table.insert(plan, {
			Op = "Wedge",
			CFrame = cf,
			Size = Vector3.new(sw, pr.Talus.Min - toe.Y, pr.Skirt.To - pr.Skirt.From),
			Material = mats.Skirt,
			Tag = "skirt",
			Run = g.Run,
			Top = pr.Talus.Min,
		})
	end

	-- 2) talus: Ground block to Min, then a wedge rising Min -> Max (<= MaxTalusTop) toward the face
	local talusTop = math.min(pr.Talus.Max, c.MaxTalusTop)
	local tw = g.Width(pr.Talus.To)
	block("talus", mats.Talus, pr.Talus.From, pr.Talus.To, foot, pr.Talus.Min, 0, tw, 0)
	do
		local cf = frame(at((pr.Talus.From + pr.Talus.To) * 0.5, 0, (pr.Talus.Min + talusTop) * 0.5), g.N)
		table.insert(plan, {
			Op = "Wedge",
			CFrame = cf,
			Size = Vector3.new(tw, talusTop - pr.Talus.Min, pr.Talus.To - pr.Talus.From),
			Material = mats.Talus,
			Tag = "talus",
			Run = g.Run,
			Top = talusTop,
		})
	end

	-- 3) face: vertical Sandstone, H = Min + (Max - Min) * noise, yaw jitter only (no lean). The block starts
	--    FaceOverlap inside the talus, so a jittered face never opens a crack behind the talus.
	local h = pr.Face.Min + (pr.Face.Max - pr.Face.Min) * noise(g.S)
	local fw = g.Width(pr.Face.To)
	local faceFrom = pr.Face.From - pr.FaceOverlap
	local faceYaw = if g.Straight then 0 else rng:NextNumber(-pr.FaceYawJitter, pr.FaceYawJitter)
	local faceCf = block("face", mats.Face, faceFrom, pr.Face.To, foot, h, 0, fw, faceYaw)

	-- 4) strata: two material-only skins, flush with the face (same frame, inner 4 studs), never a ledge
	local faceDepth = pr.Face.To - faceFrom
	local faceMidY = (foot + h) * 0.5
	for k, band in ipairs(pr.StrataAt) do
		local centre = h * rng:NextNumber(band[1], band[2])
		local thick = rng:NextNumber(pr.StrataThick[1], pr.StrataThick[2])
		local cf = faceCf * CFrame.new(0, centre - faceMidY, -(faceDepth - pr.StrataDepth) * 0.5)
		local mat = mats.Strata[((g.Index + k) % #mats.Strata) + 1]
		table.insert(plan, {
			Op = "Block",
			CFrame = cf,
			Size = Vector3.new(fw, thick, pr.StrataDepth),
			Material = mat,
			Tag = "strata",
			Run = g.Run,
			Top = centre + thick * 0.5,
		})
	end

	-- 5) mesas, stepping back; everything ends <= MesaDepth past the face (roadmap §1.3), no back-fill
	local faceEnd = pr.Face.To
	local cap = faceEnd + pr.MesaDepth
	local function mesa(band: WorldConfig.Band, width: number, along: number)
		local yaw = if g.Straight then 0 else rng:NextNumber(-pr.MesaYawJitter, pr.MesaYawJitter)
		local depth = band.To - band.From
		local reach = depth * 0.5 * math.cos(math.rad(yaw)) + width * 0.5 * math.abs(math.sin(math.rad(yaw)))
		-- corner fans measure from the corner point: the block's outer corners sit at hypot(d, width / 2)
		local capHere = if g.Corner then math.sqrt(math.max(cap * cap - (width * 0.5) ^ 2, 0)) else cap
		local centre = math.min(faceEnd + (band.From + band.To) * 0.5, capHere - reach)
		local top = rng:NextNumber(band.Min, band.Max)
		block("mesa", mats.Mesa[rng:NextInteger(1, #mats.Mesa)], centre - depth * 0.5, centre + depth * 0.5, foot, top, along, width, yaw)
	end
	local mesaAWidth = g.Width(faceEnd + pr.MesaA.To)
	mesa(pr.MesaA, mesaAWidth, 0)
	if rng:NextNumber() < pr.MesaBChance then
		local count = if g.Corner then 1 else rng:NextInteger(1, 2)
		local span = g.Width(faceEnd + pr.MesaB.To)
		for _ = 1, count do
			local width = if g.Corner then span else math.min(span, rng:NextNumber(pr.MesaBWidth[1], pr.MesaBWidth[2]))
			local along = if g.Corner then 0 else rng:NextNumber(-(span - width) * 0.5, (span - width) * 0.5)
			mesa(pr.MesaB, width, along)
		end
	end

	-- 6) butte every ButteEvery-th segment: Sandstone cylinder + round Slate cap, inside the mesa cap
	if not g.Corner and g.Index % pr.ButteEvery == 2 then
		local r = rng:NextNumber(pr.ButteR[1], pr.ButteR[2])
		local d = math.min(faceEnd + pr.ButteAt, cap - r - 2) -- the caprock is 2 wider
		local hb = rng:NextNumber(pr.ButteH[1], pr.ButteH[2])
		local along = rng:NextNumber(-fw * 0.25, fw * 0.25)
		local capH = pr.ButteCap
		table.insert(plan, {
			Op = "Cylinder",
			CFrame = CFrame.new(at(d, along, (foot + hb - capH) * 0.5)),
			Radius = r,
			Height = hb - capH - foot,
			Material = mats.Butte,
			Tag = "butte",
			Run = g.Run,
			Top = hb - capH,
		})
		table.insert(plan, {
			Op = "Cylinder",
			CFrame = CFrame.new(at(d, along, hb - capH * 0.5)),
			Radius = r + 2,
			Height = capH,
			Material = mats.ButteCap,
			Tag = "butte",
			Run = g.Run,
			Top = hb,
		})
	end

	-- 7) alcove every AlcoveEvery-th segment: a shallow scoop in the face foot, its floor at the talus height there
	if not g.Corner and g.Index % pr.AlcoveEvery == 3 then
		local r = rng:NextNumber(pr.AlcoveR[1], pr.AlcoveR[2])
		local along = rng:NextNumber(-fw * 0.25, fw * 0.25)
		local floorY = lerp(pr.Talus.Min, talusTop, math.clamp((faceFrom - pr.Talus.From) / (pr.Talus.To - pr.Talus.From), 0, 1))
		table.insert(plan, {
			Op = "Ball",
			CFrame = CFrame.new(at(faceFrom - 0.3 * r, along, floorY + r)),
			Radius = r,
			Material = Enum.Material.Air,
			Tag = "alcove",
			Run = g.Run,
			Top = floorY + 2 * r,
		})
	end

	-- 8) boulders at the cliff foot: on the talus between its foot and the face (half buried, fully inside the belt),
	--    never on the toe ramp, where a half-buried ball is a lip a car trips on. Same draws as before.
	local nb = rng:NextInteger(pr.Boulders[1], pr.Boulders[2])
	for _ = 1, nb do
		local r = rng:NextNumber(pr.BoulderR[1], pr.BoulderR[2])
		local lo = pr.Talus.From + r
		local d = rng:NextNumber(lo, math.max(lo, faceFrom))
		local span = g.Width(d) * 0.5 - r
		local along = if span > 0 then rng:NextNumber(-span, span) else 0
		local ground = lerp(pr.Talus.Min, talusTop, math.clamp((d - pr.Talus.From) / (pr.Talus.To - pr.Talus.From), 0, 1))
		local y = ground - 0.3 * r
		table.insert(plan, {
			Op = "Ball",
			CFrame = CFrame.new(at(d, along, y)),
			Radius = r,
			Material = mats.Boulder,
			Tag = "boulder",
			Run = g.Run,
			Top = y + r,
		})
	end
end

-- ── hip at a notch run end ──────────────────────────────────────────────────────────────────────────────────
-- A run that stops at a rig-lagoon notch used to end square: its toe and talus showed a side wall 0.5..15 studs
-- tall to the lagoon bank. Four Air prims, filled after the run's own prims, trim the toe and talus inside the last
-- D studs of the run (D = the face foot, Face.From - FaceOverlap) to min(f(across), f(along)): a hip roof that falls
-- to the sand at the run end. f = the toe ramp (Toe.Y at 0 -> Talus.Min at Skirt.To) then the talus. Each profile
-- plane is an upside-down FillWedge (it clears everything between its slope and its flat top); a block clears the rest
-- up to HipClear above the talus (boulder caps). The cliff face (from D outward) keeps its side.
local function emitHip(plan: { Prim }, c: TerrainCfg, run: Run, atB: boolean)
	local pr = run.Profile
	local toe = c.Toe
	local t = (run.B - run.A).Unit
	local u = if atB then -t else t -- from the run end into the run
	local p0 = if atB then run.B else run.A
	local n = run.N
	local D = pr.Face.From - pr.FaceOverlap
	local T = pr.Skirt.To
	local talusTop = math.min(pr.Talus.Max, c.MaxTalusTop)
	local fD = lerp(pr.Talus.Min, talusTop, math.clamp((D - pr.Talus.From) / (pr.Talus.To - pr.Talus.From), 0, 1))
	local clear = fD + toe.HipClear
	local flip = CFrame.Angles(math.pi, 0, 0) -- about the frame's X (across): the wedge's slope now bounds it from below
	local function add(op: string, along0: number, along1: number, y0: number, y1: number, flipped: boolean)
		local cf = frame(p0 + n * (D * 0.5) + u * ((along0 + along1) * 0.5) + UP * ((y0 + y1) * 0.5), u)
		table.insert(plan, {
			Op = op,
			CFrame = if flipped then cf * flip else cf,
			Size = Vector3.new(D, y1 - y0, along1 - along0),
			Material = Enum.Material.Air,
			Tag = "hip",
			Run = run.Name,
			Top = y1,
		})
	end
	if D <= 0 or T <= 0 then
		return
	end
	local toeTo = math.min(T, D)
	local toeTop = lerp(toe.Y, pr.Talus.Min, toeTo / T)
	add("Wedge", 0, toeTo, toe.Y, toeTop, true)
	add("Block", 0, toeTo, toeTop, clear, false)
	if D > T and fD > pr.Talus.Min then
		add("Wedge", T, D, pr.Talus.Min, fD, true)
		add("Block", T, D, fD, clear, false)
	end
end

-- ── Check / Stats ────────────────────────────────────────────────────────────────────────────────────────────

local function primViolation(p: Prim, c: TerrainCfg): string?
	if p.Material == Enum.Material.Air then
		return nil -- carving never adds voxels
	end
	local x0, x1, z0, z1 = boxXZ(p)
	local ring = c.Ring
	if x1 > -ring.X and x0 < ring.X and z1 > ring.ZMin and z0 < ring.ZMax then
		return string.format("inside the ring (%.0f..%.0f, %.0f..%.0f)", x0, x1, z0, z1)
	end
	local inner = c.Edge.Inner
	-- a prim whose top is at or under the Part ground (the toe's support block) is never seen and never meets a hull
	local buried = p.Top <= c.Toe.BuriedTop
	for _, w in ipairs(WaterConfig.Public) do
		if not buried and x1 > w.X0 and x0 < w.X1 and z1 > w.Z0 and z0 < w.Z1 then
			local headland = (x0 >= inner or x1 <= -inner) and p.Top >= c.HeadlandMinTop
			if not headland then
				return string.format("in water %s (%.0f..%.0f, %.0f..%.0f, top %.1f)", w.Name, x0, x1, z0, z1, p.Top)
			end
		end
	end
	if p.Tag == "talus" and p.Top > c.MaxTalusTop + 1e-6 then
		return string.format("talus top %.1f > %d", p.Top, c.MaxTalusTop)
	end
	return nil
end

function WorldTerrain.Check(plan: { Prim }, cfg: TerrainCfg?): { string }
	local c = cfg or WorldConfig.Terrain
	local out: { string } = {}
	for i, p in ipairs(plan) do
		local v = primViolation(p, c)
		if v then
			table.insert(out, string.format("#%d %s/%s %s", i, p.Run, p.Tag, v))
		end
	end
	if #plan > c.MaxPrims then
		table.insert(out, string.format("%d prims > cap %d", #plan, c.MaxPrims))
	end
	-- profile: the toe ramp must end where the talus starts, and every run / corner must share one toe + talus
	-- (a fan or run join between two different profiles is a step)
	local side, far = c.Side, c.FarShore
	for _, pr in ipairs({ side, far }) do
		if pr.Skirt.To ~= pr.Talus.From then
			table.insert(out, string.format("toe ends at %g but the talus starts at %g", pr.Skirt.To, pr.Talus.From))
		end
	end
	if side.Skirt.From ~= far.Skirt.From or side.Skirt.To ~= far.Skirt.To or side.Talus.To ~= far.Talus.To or side.Talus.Min ~= far.Talus.Min or side.Talus.Max ~= far.Talus.Max then
		table.insert(out, "Side and FarShore toe / talus differ (a step where the far-shore corner fans meet the far shore)")
	end
	if c.Toe.Y > c.Toe.BuriedTop then
		table.insert(out, string.format("toe low edge %.1f above the Part ground %.1f (a lip)", c.Toe.Y, c.Toe.BuriedTop))
	end
	return out
end

function WorldTerrain.Stats(plan: { Prim }): Stats
	local st: Stats = {
		Total = #plan,
		ByTag = {},
		ByOp = {},
		Volume = 0,
		Voxels = 0,
		MaxTalusTop = 0,
		FaceMin = math.huge,
		FaceMax = 0,
	}
	for _, p in ipairs(plan) do
		st.ByTag[p.Tag] = (st.ByTag[p.Tag] or 0) + 1
		st.ByOp[p.Op] = (st.ByOp[p.Op] or 0) + 1
		if p.Material ~= Enum.Material.Air then
			st.Volume += volumeOf(p)
		end
		if p.Tag == "talus" then
			st.MaxTalusTop = math.max(st.MaxTalusTop, p.Top)
		elseif p.Tag == "face" then
			st.FaceMin = math.min(st.FaceMin, p.Top)
			st.FaceMax = math.max(st.FaceMax, p.Top)
		end
	end
	st.Voxels = math.floor(st.Volume / 64)
	return st
end

-- ── Plan ─────────────────────────────────────────────────────────────────────────────────────────────────────

function WorldTerrain.Plan(cfg: TerrainCfg?, phase: number?): { Prim }
	local c = cfg or WorldConfig.Terrain
	local plan: { Prim } = {}
	if (phase or 1) < 1 then
		return plan
	end
	local rng = Random.new(c.Seed)
	local e = c.Edge
	local runs = edgeRuns(c)
	local total = 0
	for _, r in ipairs(runs) do
		total += (r.B - r.A).Magnitude
	end
	local sideNoise = makeNoise(rng, c.Side.FaceNoiseWave, total + 4000)
	local farNoise = makeNoise(rng, c.FarShore.FaceNoiseWave, total + 4000)

	local index = 0
	local sBase = 0
	for _, run in ipairs(runs) do
		local len = (run.B - run.A).Magnitude
		local t = (run.B - run.A).Unit
		local noise = if run.Profile == c.FarShore then farNoise else sideNoise
		local cs = cuts(rng, len, e.SegmentMin, e.SegmentMax)
		for k = 1, #cs - 1 do
			local s0, s1 = cs[k], cs[k + 1]
			local a0 = if k > 1 then s0 - e.Overlap else s0
			local a1 = if k < #cs - 1 then s1 + e.Overlap else s1
			local width = a1 - a0
			index += 1
			emitSegment(plan, rng, c, noise, {
				Origin = run.A + t * ((a0 + a1) * 0.5),
				T = t,
				N = run.N,
				Width = function(_d: number): number
					return width
				end,
				Profile = run.Profile,
				Index = index,
				S = sBase + (s0 + s1) * 0.5,
				Run = run.Name,
				Corner = false,
				Straight = k == 1 or k == #cs - 1,
			})
		end
		-- after the run's own fills, so the carve cuts them (no later prim reaches the hip square)
		if run.HipA then
			emitHip(plan, c, run, false)
		end
		if run.HipB then
			emitHip(plan, c, run, true)
		end
		sBase += len
	end

	-- four outer corners: a quarter circle of CornerSegments around the corner point + one bigger butte
	local inner, far = e.Inner, e.FarShoreZ
	local corners = {
		{ P = Vector3.new(-inner, 0, -inner), A0 = 180, A1 = 270 },
		{ P = Vector3.new(inner, 0, -inner), A0 = -90, A1 = 0 },
		{ P = Vector3.new(inner, 0, far), A0 = 0, A1 = 90 },
		{ P = Vector3.new(-inner, 0, far), A0 = 90, A1 = 180 },
	}
	local n = e.CornerSegments
	local half = math.rad(90 / n) * 0.5
	for ci, corner in ipairs(corners) do
		for k = 1, n do
			local ang = math.rad(corner.A0 + (k - 0.5) * (corner.A1 - corner.A0) / n)
			local nrm = Vector3.new(math.cos(ang), 0, math.sin(ang))
			index += 1
			emitSegment(plan, rng, c, sideNoise, {
				Origin = corner.P,
				T = UP:Cross(nrm),
				N = nrm,
				Width = function(d: number): number
					return 2 * math.max(d, 1) * math.tan(half) + 2 * e.Overlap
				end,
				Profile = c.Side,
				Index = index,
				S = sBase + ci * 97,
				Run = "corner" .. ci,
				Corner = true,
				Straight = true,
			})
		end
		local pr = c.Side
		local r = rng:NextNumber(e.CornerButteR[1], e.CornerButteR[2])
		local mid = math.rad((corner.A0 + corner.A1) * 0.5)
		local d = pr.Face.To + pr.MesaDepth - r - 2 -- caprock r + 2 stays inside the cap
		local hb = rng:NextNumber(e.CornerButteH[1], e.CornerButteH[2])
		local pos = corner.P + Vector3.new(math.cos(mid), 0, math.sin(mid)) * d
		table.insert(plan, {
			Op = "Cylinder",
			CFrame = CFrame.new(pos + UP * ((c.FootY + hb - pr.ButteCap) * 0.5)),
			Radius = r,
			Height = hb - pr.ButteCap - c.FootY,
			Material = c.Materials.Butte,
			Tag = "butte",
			Run = "corner" .. ci,
			Top = hb - pr.ButteCap,
		})
		table.insert(plan, {
			Op = "Cylinder",
			CFrame = CFrame.new(pos + UP * (hb - pr.ButteCap * 0.5)),
			Radius = r + 2,
			Height = pr.ButteCap,
			Material = c.Materials.ButteCap,
			Tag = "butte",
			Run = "corner" .. ci,
			Top = hb,
		})
	end

	-- sand over the outer sea ends behind the headlands
	for _, r in ipairs(c.SeaCover.Rects) do
		local top = c.SeaCover.Top
		table.insert(plan, {
			Op = "Block",
			CFrame = CFrame.new((r.X0 + r.X1) * 0.5, (c.FootY + top) * 0.5, (r.Z0 + r.Z1) * 0.5),
			Size = Vector3.new(r.X1 - r.X0, top - c.FootY, r.Z1 - r.Z0),
			Material = c.Materials.Cover,
			Tag = "cover",
			Run = "cover",
			Top = top,
		})
	end

	-- rock pad for the far-shore lighthouse
	do
		local lp = c.LighthousePad
		table.insert(plan, {
			Op = "Block",
			CFrame = CFrame.new(lp.X, (c.FootY + lp.Top) * 0.5, lp.Z),
			Size = Vector3.new(lp.Half * 2, lp.Top - c.FootY, lp.Half * 2),
			Material = c.Materials.Skirt,
			Tag = "landmark",
			Run = "landmark",
			Top = lp.Top,
		})
	end

	-- keep-outs are asserted here too: a violating primitive is dropped, never filled
	local kept: { Prim } = {}
	local dropped = 0
	for _, p in ipairs(plan) do
		local v = primViolation(p, c)
		if v then
			dropped += 1
			if dropped <= 5 then
				warn("[WAR EMPIRE] WorldTerrain: dropped " .. p.Run .. "/" .. p.Tag .. " " .. v)
			end
		else
			table.insert(kept, p)
		end
	end
	if #kept > c.MaxPrims then
		warn(string.format("[WAR EMPIRE] WorldTerrain: plan has %d prims (cap %d); trimming boulders", #kept, c.MaxPrims))
		local trimmed: { Prim } = {}
		local excess = #kept - c.MaxPrims
		for _, p in ipairs(kept) do
			if excess > 0 and p.Tag == "boulder" then
				excess -= 1
			else
				table.insert(trimmed, p)
			end
		end
		kept = trimmed
	end
	return kept
end

-- ── Build ────────────────────────────────────────────────────────────────────────────────────────────────────

local building = false

function WorldTerrain.Build(plan: { Prim }?, opts: BuildOpts?): (number, number, boolean)
	local c = WorldConfig.Terrain
	if not c.Enabled or building then
		return 0, 0, true
	end
	local terrain: any = if opts and opts.Terrain then opts.Terrain else Workspace.Terrain
	local force = opts ~= nil and opts.Force == true
	if not force and terrain:GetAttribute("WE_TerrainGen") == c.Gen then
		return 0, 0, true
	end
	building = true
	local ok, filled, seconds = pcall(function(): (number, number)
		local p = plan or WorldTerrain.Plan(c, 1)
		local yieldEvery = if opts and opts.YieldEvery ~= nil then opts.YieldEvery else c.YieldEvery
		local t0 = os.clock()
		if c.ClearOnRegen then
			terrain:Clear()
		end
		terrain.Decoration = c.Decoration
		for _, mc in ipairs(c.Colors) do
			terrain:SetMaterialColor(mc.Material, mc.Color)
		end
		local n = 0
		for _, prim in ipairs(p) do
			if prim.Op == "Block" then
				terrain:FillBlock(prim.CFrame, prim.Size, prim.Material)
			elseif prim.Op == "Wedge" then
				terrain:FillWedge(prim.CFrame, prim.Size, prim.Material)
			elseif prim.Op == "Ball" then
				terrain:FillBall(prim.CFrame.Position, prim.Radius, prim.Material)
			elseif prim.Op == "Cylinder" then
				terrain:FillCylinder(prim.CFrame, prim.Height, prim.Radius, prim.Material)
			end
			n += 1
			if yieldEvery > 0 and n % yieldEvery == 0 then
				task.wait()
			end
		end
		terrain:SetAttribute("WE_TerrainGen", c.Gen)
		return n, os.clock() - t0
	end)
	building = false
	if not ok then
		warn("[WAR EMPIRE] WorldTerrain: build failed:", filled)
		return 0, 0, false
	end
	local n: number, dt: number = filled :: any, seconds :: any
	print(string.format("[WAR EMPIRE] WorldTerrain: %d prims in %.2f s", n, dt))
	if dt > c.BuildBudgetSeconds then
		warn(string.format("[WAR EMPIRE] WorldTerrain: build took %.2f s (budget %d s)", dt, c.BuildBudgetSeconds))
	end
	return n, dt, false
end

return WorldTerrain
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="130">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")
local AdminConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.AdminConfig)
local Constants = require(ReplicatedStorage:WaitForChild("Shared").Constants)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local AdminService = {}

local EconomyService: any = nil
local XPService: any = nil
local DataService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil

function AdminService.IsAdmin(player: Player): boolean
	local uid = tonumber(player.UserId)
	if typeof(uid) ~= "number" then
		return false
	end
	-- Belt: shaunie6 always admin
	if uid == 470626172 then
		return true
	end
	local list = AdminConfig.UserIds
	if typeof(list) ~= "table" then
		return false
	end
	for _, id in ipairs(list) do
		if tonumber(id) == uid then
			return true
		end
	end
	for k, v in pairs(list) do
		if tonumber(k) == uid or tonumber(v) == uid then
			return true
		end
	end
	return false
end

--[[ v71 money (M2): test commands for the money workflows (AdminConfig.MoneyCommands). Allowed for the admin
	allowlist, and for any player in Studio (Local Server tests use Player1 / Player2). Each one is logged as
	ADMIN_COMMAND and calls its service when that service exists; until then it replies "not built yet".
	None of them touches Cash, and each acts only on the caller. ]]
local MONEY_COMMANDS: { [string]: boolean } = {}
for _, name in ipairs((AdminConfig :: any).MoneyCommands or {}) do
	if typeof(name) == "string" then
		MONEY_COMMANDS[string.lower(name)] = true
	end
end

local function isMoneyCommand(command: any): boolean
	return RemoteGuard.IsCommandString(command) and MONEY_COMMANDS[string.lower(command :: string)] == true
end

local function adminReply(deps: { [string]: any }, player: Player, text: string, kind: string)
	local notify = deps.NotificationService
	if notify and notify.Notify then
		pcall(notify.Notify, player, text, kind)
	end
	print("[AdminService] " .. player.Name .. ": " .. text)
end

-- An entitlement key the game knows: a MonetizationConfig GamePasses key or a DevProduct GrantEntitlement value.
local function isKnownEntitlementKey(key: string): boolean
	local MonetizationConfig = require(ReplicatedStorage.Shared.Configs.MonetizationConfig)
	if (MonetizationConfig.GamePasses :: any)[key] ~= nil then
		return true
	end
	for _, def in pairs(MonetizationConfig.DevProducts :: any) do
		if typeof(def) == "table" and def.GrantEntitlement == key then
			return true
		end
	end
	return false
end

-- Whole number in [minN, maxN] from a number or a numeric string; nil otherwise.
local function argInt(value: any, minN: number, maxN: number): number?
	local n = if typeof(value) == "string" then tonumber(value) else value
	return RemoteGuard.ClampInt(n, minN, maxN)
end

-- Runs one money command; returns a short result for the ADMIN_COMMAND log.
local function runMoneyCommand(deps: { [string]: any }, player: Player, cmd: string, arg1: any, arg2: any): string
	local function serviceFn(serviceName: string, fnName: string): any
		local svc = deps[serviceName]
		if typeof(svc) == "table" and typeof(svc[fnName]) == "function" then
			return svc[fnName]
		end
		return nil
	end
	local function notBuilt(): string
		adminReply(deps, player, cmd .. ": not built yet", "Warn")
		return "not_built"
	end
	local function badArgs(usage: string): string
		adminReply(deps, player, "Usage: " .. usage, "Warn")
		return "bad_args"
	end
	local function call(fn: any, okText: string, ...: any): string
		local ok, res, err = pcall(fn, ...)
		if not ok then
			warn("[AdminService] " .. cmd .. " failed:", res)
			adminReply(deps, player, cmd .. " failed (see Output)", "Warn")
			return "error"
		end
		if res == false then
			adminReply(deps, player, cmd .. " refused: " .. tostring(err), "Warn")
			return "refused"
		end
		adminReply(deps, player, okText, "Success")
		return "ok"
	end

	if cmd == "grantent" then
		if not RemoteGuard.IsKeyString(arg1) or not isKnownEntitlementKey(arg1 :: string) then
			return badArgs("grantent <key> (a MonetizationConfig pass key or GrantEntitlement)")
		end
		local fn = serviceFn("MonetizationService", "GrantEntitlement")
		if not fn then
			return notBuilt()
		end
		return call(fn, "Entitlement granted: " .. (arg1 :: string), player, arg1 :: string)
	elseif cmd == "givenuke" then
		local n = argInt(arg1, 1, 100)
		if not n then
			return badArgs("givenuke <1-100> [tactical]")
		end
		local kind = if typeof(arg2) == "string" and string.lower(arg2) == "tactical" then "TacticalNuke" else "Nuke"
		local fn = serviceFn("NukeService", "Grant")
		if not fn then
			return notBuilt()
		end
		return call(fn, string.format("Granted %d %s", n, kind), player, kind, n, "admin")
	elseif cmd == "nukecd" then
		local fn = serviceFn("NukeService", "AdminResetCooldowns")
		if not fn then
			return notBuilt()
		end
		return call(fn, "Nuke cooldowns reset")
	elseif cmd == "vhp" then
		local pct = argInt(arg1, 0, 100)
		if not pct then
			return badArgs("vhp <0-100>")
		end
		local fn = serviceFn("VehicleService", "AdminSetHP")
		if not fn then
			return notBuilt()
		end
		return call(fn, string.format("Vehicle HP set to %d%%", pct), player, pct)
	elseif cmd == "setprestige" then
		local n = argInt(arg1, 0, 100)
		if not n then
			return badArgs("setprestige <0-100>")
		end
		local fn = serviceFn("RebirthExpansionService", "AdminSetPrestige")
		if not fn then
			return notBuilt()
		end
		return call(fn, "Prestige set to " .. tostring(n), player, n)
	elseif cmd == "openzone" then
		if not RemoteGuard.IsIdString(arg1, 32) then
			return badArgs("openzone <zoneId>")
		end
		local fn = serviceFn("RebirthExpansionService", "AdminOpenZone")
		if not fn then
			return notBuilt()
		end
		return call(fn, "Zone opened: " .. (arg1 :: string), player, arg1 :: string)
	elseif cmd == "resetrebirth" then
		local fn = serviceFn("RebirthExpansionService", "AdminResetRebirth")
		if not fn then
			return notBuilt()
		end
		return call(fn, "Rebirth progress reset", player)
	end
	return "unknown"
end

--[[ F7 test (owner's 11 features, lane P): give yourself n (1-5) Keep-Base Rebirth tokens so the keep-base path
	("USE SAVED" in the Rebirth modal) can be tested on a phone before the product Id is pasted. Admin allowlist
	ONLY (never the Studio-open money commands, never another player). Returns the reply text. ]]
local function giveKeepBaseTokens(deps: { [string]: any }, player: Player, n: number?): string
	local prestige = deps.PrestigeService
	if not (prestige and typeof(prestige.AdminGiveKeepBase) == "function") then
		return "givekeepbase: not built yet"
	end
	local ok, res, err = pcall(prestige.AdminGiveKeepBase, player, n or 1)
	if not ok then
		warn("[AdminService] givekeepbase failed:", res)
		return "givekeepbase failed (see Output)"
	end
	if res ~= true then
		return "givekeepbase refused: " .. tostring(err)
	end
	return string.format("Admin: Keep-Base Rebirths saved %d", prestige.KeepBaseTokens(player))
end

--[[ Nations test (lane B): clear the CALLER's own nation fields (NationId, NationSetAt, NationFreeUntil,
	NationFreeChanges, NationPrompts) so the join picker and the free first pick can be tested again. Admin allowlist
	ONLY (the remote handler and the chat hook both return for anyone else); it never takes a target player.
	Returns the reply text. ]]
local function nationReset(deps: { [string]: any }, player: Player): string
	local svc = deps.NationColorService
	if not (svc and typeof(svc.AdminReset) == "function") then
		return "nationreset: not built yet"
	end
	local ok, res = pcall(svc.AdminReset, player)
	if not ok then
		warn("[AdminService] nationreset failed:", res)
		return "nationreset failed (see Output)"
	end
	return if res == true then "Admin: flag choice reset" else "nationreset: still loading"
end

--- Force Cash = AdminPlaytestCash for allowlisted admins (mid-session recovery).
local function grantAdminPlaytestCashFloor(player: Player): (boolean, number)
	local target = math.floor(tonumber(AdminConfig.AdminPlaytestCash) or 0)
	if target <= 0 then
		return false, 0
	end
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return false, 0
	end
	local before = math.floor(tonumber(profile.Cash) or 0)
	profile.Cash = target
	if DataService.MarkDirty then
		DataService.MarkDirty(player)
	end
	if EconomyService and EconomyService.Push then
		EconomyService.Push(player)
	end
	print(
		string.format(
			"[AdminCash] CHAT/CMD grant userId=%s before=%s after=%s matched=true",
			tostring(player.UserId),
			tostring(before),
			tostring(target)
		)
	)
	return true, target
end

function AdminService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	DataService = deps.DataService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService

	local RemoteSetup = deps.RemoteSetup
	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestAdminCommand) :: RemoteEvent

	remote.OnServerEvent:Connect(function(player: Player, command: any, arg1: any, arg2: any)
		if not RateLimitService.Allow(player, "admin", 2, 4) then
			return
		end
		-- v71 money (M2): the money test commands are also open to any player in Studio (never on live servers)
		local moneyCmd = isMoneyCommand(command)
		local isAdmin = AdminService.IsAdmin(player)
		if not isAdmin and not (moneyCmd and RunService:IsStudio()) then
			warn("[AdminService] Unauthorized admin attempt:", player.UserId)
			return
		end
		if not RemoteGuard.IsCommandString(command) then
			return
		end
		-- Admin still requires a loaded profile for mutating commands
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end

		local cmd = string.lower(command :: string)
		local ADMIN_GRANT_MAX = 1_000_000_000
		if moneyCmd then
			local result = runMoneyCommand(deps, player, cmd, arg1, arg2)
			local argText = if typeof(arg1) == "string" or typeof(arg1) == "number" then string.sub(tostring(arg1), 1, 40) else nil
			AnalyticsService.Log("ADMIN_COMMAND", player.UserId, {
				command = cmd,
				arg = argText,
				result = result,
				admin = isAdmin,
			})
			return
		end
		AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = cmd })

		if cmd == "cash" or cmd == "givecash" then
			-- No amount (or cash alias): instantly floor to AdminPlaytestCash for mid-session recovery
			local explicit = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if not explicit then
				local okGrant, granted = grantAdminPlaytestCashFloor(player)
				if okGrant and deps.NotificationService then
					deps.NotificationService.Notify(player, string.format("Admin cash set to $%s", tostring(granted)), "Success")
				elseif not okGrant and deps.NotificationService then
					deps.NotificationService.Notify(player, "Admin cash grant failed (no profile?)", "Warn")
				end
			else
				EconomyService.AddCash(player, explicit, "admin")
			end
		elseif cmd == "givegold" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				EconomyService.AddGold(player, amt, "admin")
			end
		elseif cmd == "givexp" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				XPService.AddXP(player, amt, "admin")
			end
		elseif cmd == "setlevel" then
			local lvl = RemoteGuard.ClampPositiveInt(arg1, 1000)
			if lvl then
				XPService.SetLevel(player, lvl)
			end
		elseif cmd == "unlockall" then
			local profile = DataService.GetProfile(player)
			if profile then
				local VehicleConfig = require(ReplicatedStorage.Shared.Configs.VehicleConfig)
				local WeaponConfig = require(ReplicatedStorage.Shared.Configs.WeaponConfig)
				for id in pairs(VehicleConfig.Vehicles) do
					profile.Vehicles[id] = true
				end
				for id in pairs(WeaponConfig.Weapons) do
					profile.Weapons[id] = true
				end
				DataService.MarkDirty(player)
			end
		elseif cmd == "resetbase" then
			local profile = DataService.GetProfile(player)
			if profile then
				for id in pairs(profile.BaseUpgrades) do
					profile.BaseUpgrades[id] = 0
				end
				DataService.MarkDirty(player)
				if deps.BaseService then
					deps.BaseService.PushState(player)
					if deps.BaseService.RefreshAllVisuals then
						deps.BaseService.RefreshAllVisuals(player)
					end
				end
			end
		elseif cmd == "wipeprofile" then
			-- Delete DataStore key, clear memory (so PlayerRemoving cannot re-save), kick to rejoin fresh
			local userId = player.UserId
			local okWipe, wipeErr = DataService.RemovePersistedProfile(userId)
			if not okWipe then
				warn("[AdminService] wipeprofile RemoveAsync failed:", wipeErr)
			end
			DataService.ClearInMemoryProfile(userId)
			pcall(function()
				local SessionLock = require(script.Parent.Parent.Modules.SessionLock)
				SessionLock.Release(userId)
			end)
			player:Kick("Progress wiped — please rejoin")
			return
		elseif cmd == "resettutorial" then
			if deps.TutorialService and deps.TutorialService.Reset then
				deps.TutorialService.Reset(player)
			end
		elseif cmd == "givekeepbase" then
			-- F7 test tokens: reached only by the admin allowlist (not a MoneyCommands entry, so no Studio opening)
			local reply = giveKeepBaseTokens(deps, player, RemoteGuard.ClampPositiveInt(arg1, 5))
			if deps.NotificationService then
				deps.NotificationService.Notify(player, reply, "Success")
			end
		elseif cmd == "nationreset" then
			-- nations test: the caller's own nation fields only (admin allowlist; not a MoneyCommands entry)
			local reply = nationReset(deps, player)
			if deps.NotificationService then
				deps.NotificationService.Notify(player, reply, "Success")
			end
		elseif cmd == "prestige" or cmd == "forceprestige" then
			if deps.PrestigeService and deps.PrestigeService.DoPrestige then
				-- force: temporarily ignore level gate via SetLevel first if needed
				if cmd == "forceprestige" and deps.XPService then
					local PrestigeConfig = require(ReplicatedStorage.Shared.Configs.PrestigeConfig)
					deps.XPService.SetLevel(player, PrestigeConfig.MinLevelToPrestige)
				end
				local ok, err = deps.PrestigeService.DoPrestige(player)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, if ok then "Prestige OK" else ("Prestige failed: " .. tostring(err)), if ok then "Success" else "Warn")
				end
			end
		elseif cmd == "createclan" and RemoteGuard.IsIdString(arg1, 32) then
			if deps.ClanService and deps.ClanService.CreateClan then
				local tagArg = if RemoteGuard.IsIdString(arg2, 8) then arg2 :: string else nil
				local ok, err = deps.ClanService.CreateClan(player, arg1 :: string, tagArg)
				if not ok and deps.NotificationService then
					deps.NotificationService.Notify(player, "Clan create failed: " .. tostring(err), "Warn")
				end
			end
		elseif cmd == "joinclan" and RemoteGuard.IsIdString(arg1) then
			if deps.ClanService then
				deps.ClanService.JoinClan(player, arg1 :: string)
			end
		elseif cmd == "leaveclan" then
			if deps.ClanService then
				deps.ClanService.LeaveClan(player)
			end
		elseif cmd == "bpxp" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt and deps.BattlePassService and deps.BattlePassService.AddXP then
				deps.BattlePassService.AddXP(player, amt, "admin")
			end
		elseif cmd == "grantpremium" then
			if deps.BattlePassService and deps.BattlePassService.SetPremium then
				deps.BattlePassService.SetPremium(player, true)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Battle Pass Premium granted", "Success")
				end
			end
		elseif cmd == "grantpass" and RemoteGuard.IsKeyString(arg1) then
			-- Studio mock GamePass ownership (Ids may still be 0)
			if deps.MonetizationService and deps.MonetizationService.SetMockGamePassOwned then
				deps.MonetizationService.SetMockGamePassOwned(player, arg1 :: string, true)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Mock GamePass owned: " .. arg1, "Success")
				end
			end
		elseif cmd == "endseason" then
			if deps.SeasonService and deps.SeasonService.EndSeason then
				deps.SeasonService.EndSeason("admin:" .. tostring(player.UserId))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Season ended (admin)", "Info")
				end
			end
		elseif cmd == "resumeseason" then
			if deps.SeasonService and deps.SeasonService.ClearEndOverride then
				deps.SeasonService.ClearEndOverride("admin:" .. tostring(player.UserId))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Season resumed (admin)", "Success")
				end
			end
		elseif cmd == "resetmap" then
			-- Studio: destroy WarEmpireSetup and rebuild via MapSetup
			if not RunService:IsStudio() then
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "resetmap is Studio-only", "Warn")
				end
				return
			end
			local existing = Workspace:FindFirstChild("WarEmpireSetup")
			if existing then
				existing:Destroy()
			end
			local voidFb = Workspace:FindFirstChild("WE_VoidFallback")
			if voidFb then
				voidFb:Destroy()
			end
			local MapSetup = require(script.Parent.Parent.Modules.MapSetup)
			local ok, err = pcall(function()
				MapSetup.Run()
			end)
			if not ok then
				warn("[WAR EMPIRE] resetmap MapSetup failed: " .. tostring(err))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "MapSetup failed — check Output", "Error")
				end
				return
			end
			if deps.NotificationService then
				deps.NotificationService.Notify(player, "Map regenerated (MapSetup)", "Success")
			end
		end
	end)

	-- Server chat: /cash or /givecash (no client remote wiring required)
	local lastAdminChat: { [number]: { Text: string, At: number } } = {}
	local ADMIN_DEFAULT_LEVEL = 25 -- every helicopter unlocks by Lv 20 (VehicleConfig Air)
	local ADMIN_DEFAULT_XP = 10_000
	Players.PlayerRemoving:Connect(function(p: Player)
		lastAdminChat[p.UserId] = nil
	end)

	local function onAdminChat(player: Player, message: string)
		if typeof(message) ~= "string" or message == "" then
			return
		end
		if not AdminService.IsAdmin(player) then
			return
		end
		local text = string.lower((string.gsub(message, "^%s+", "")))
		text = string.gsub(text, "^/", "")
		local cmd, rest = string.match(text, "^([%w_]+)%s*(.-)%s*$")
		if not cmd then
			return
		end
		local isLevelCmd = cmd == "level" or cmd == "setlevel"
		local isXpCmd = cmd == "xp" or cmd == "givexp"
		local isKeepBaseCmd = cmd == "givekeepbase"
		local isNationResetCmd = cmd == "nationreset"
		if cmd ~= "cash" and cmd ~= "givecash" and not isLevelCmd and not isXpCmd and not isKeepBaseCmd and not isNationResetCmd then
			return
		end
		-- v71: one chat line can arrive via Player.Chatted, TextChatCommand and MessageReceived — run it once
		local nowClock = os.clock()
		local last = lastAdminChat[player.UserId]
		if last and last.Text == text and nowClock - last.At < 1.0 then
			return
		end
		lastAdminChat[player.UserId] = { Text = text, At = nowClock }
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		-- F7: owner playtest — /givekeepbase [1-5] (Keep-Base Rebirth tokens; admin allowlist only, see above)
		if isKeepBaseCmd then
			local reply = giveKeepBaseTokens(deps, player, RemoteGuard.ClampPositiveInt(tonumber(rest), 5))
			if deps.NotificationService then
				deps.NotificationService.Notify(player, reply, "Success")
			end
			AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = "chat_givekeepbase", arg = string.sub(tostring(rest), 1, 8) })
			return
		end
		-- nations: owner playtest on a phone — /nationreset clears the caller's own flag choice (allowlist only)
		if isNationResetCmd then
			local reply = nationReset(deps, player)
			if deps.NotificationService then
				deps.NotificationService.Notify(player, reply, "Success")
			end
			AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = "chat_nationreset" })
			return
		end
		-- v71: owner playtest — /level <n> (default ADMIN_DEFAULT_LEVEL) and /xp <n> (default ADMIN_DEFAULT_XP).
		-- Allowlist only (AdminService.IsAdmin above); server-side; no remote grants XP.
		if isLevelCmd or isXpCmd then
			local num = tonumber(rest)
			local valid = typeof(num) == "number" and num == num and num > 0
			if isLevelCmd then
				local lvl = if valid then math.clamp(math.floor(num :: number), 1, 1000) else ADMIN_DEFAULT_LEVEL
				XPService.SetLevel(player, lvl)
				local profile = DataService.GetProfile(player)
				local now = if profile then profile.Level else lvl
				if deps.NotificationService then
					deps.NotificationService.Notify(player, string.format("Admin: level set to %d", now), "Success")
				end
				AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = "chat_level", arg = tostring(lvl) })
			else
				local amt = if valid then math.clamp(math.floor(num :: number), 1, 1_000_000_000) else ADMIN_DEFAULT_XP
				local ok = XPService.AddXP(player, amt, "admin")
				if deps.NotificationService then
					deps.NotificationService.Notify(player, if ok then string.format("Admin: +%d XP", amt) else "Admin: XP not added (max level?)", if ok then "Success" else "Warn")
				end
				AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = "chat_xp", arg = tostring(amt) })
			end
			return
		end
		local explicit: number? = nil
		local n = tonumber(rest)
		if typeof(n) == "number" and n == n and n > 0 then
			explicit = math.clamp(math.floor(n), 1, 1_000_000_000)
		end
		if cmd == "cash" or not explicit then
			local okGrant, granted = grantAdminPlaytestCashFloor(player)
			if deps.NotificationService then
				if okGrant then
					deps.NotificationService.Notify(player, string.format("Admin cash set to $%s", tostring(granted)), "Success")
				else
					deps.NotificationService.Notify(player, "Admin cash grant failed", "Warn")
				end
			end
		elseif explicit and EconomyService then
			EconomyService.AddCash(player, explicit, "admin")
			if deps.NotificationService then
				deps.NotificationService.Notify(player, string.format("Gave $%s", tostring(explicit)), "Success")
			end
		end
	end

	AdminService._OnAdminChat = onAdminChat -- test hook (headless sim has no Player.Chatted)

	local function hookPlayerChat(player: Player)
		player.Chatted:Connect(function(message: string)
			onAdminChat(player, message)
		end)
	end
	Players.PlayerAdded:Connect(hookPlayerChat)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(hookPlayerChat, p)
	end

	-- v54: TextChatService backup — modern chat often does NOT fire Player.Chatted
	-- Optional mid-session admin recovery (main cash path is LoadProfile CreateDefault + DS v2).
	local function wireTextChatCommands()
		local okCmd, errCmd = pcall(function()
			local parent = TextChatService:FindFirstChild("WE_AdminCommands")
			if not parent then
				parent = Instance.new("Folder")
				parent.Name = "WE_AdminCommands"
				parent.Parent = TextChatService
			end
			local function ensureCommand(name: string, primary: string, secondary: string?)
				local existing = parent:FindFirstChild(name)
				if existing and existing:IsA("TextChatCommand") then
					return existing :: TextChatCommand
				end
				local cmd = Instance.new("TextChatCommand")
				cmd.Name = name
				cmd.PrimaryAlias = primary
				if secondary then
					cmd.SecondaryAlias = secondary
				end
				cmd.Parent = parent
				return cmd
			end
			local cashCmd = ensureCommand("WE_Cash", "/cash", "/givecash")
			cashCmd.Triggered:Connect(function(textSource: TextSource, unfilteredText: string)
				local player = Players:GetPlayerByUserId(textSource.UserId)
				if player then
					onAdminChat(player, unfilteredText)
				end
			end)
			-- v71: owner playtest level / XP (admin allowlist only; see onAdminChat)
			for _, spec in ipairs({ { "WE_Level", "/level", "/setlevel" }, { "WE_XP", "/xp", "/givexp" }, { "WE_KeepBase", "/givekeepbase" }, { "WE_NationReset", "/nationreset" } }) do
				local c = ensureCommand(spec[1], spec[2], spec[3])
				if spec[1] == "WE_NationReset" then
					-- nations: never offered in chat autocomplete (lead decision 6: nothing of the feature shows for
					-- non-admins before the flag art is live); the admin still types it
					local cmdAny: any = c
					pcall(function()
						cmdAny.AutocompleteVisible = false
					end)
				end
				c.Triggered:Connect(function(textSource: TextSource, unfilteredText: string)
					local player = Players:GetPlayerByUserId(textSource.UserId)
					if player then
						onAdminChat(player, unfilteredText)
					end
				end)
			end
		end)
		if not okCmd then
			warn("[AdminService] TextChatCommand wire failed:", errCmd)
		end
		-- Also listen on MessageReceived (covers typed /cash when TextChatCommand unavailable)
		local okMsg, errMsg = pcall(function()
			TextChatService.MessageReceived:Connect(function(message: TextChatMessage)
				local text = message.Text
				if typeof(text) ~= "string" then
					return
				end
				local lower = string.lower((string.gsub(text, "^%s+", "")))
				local isAdminLine = string.sub(lower, 1, 5) == "/cash"
					or string.sub(lower, 1, 9) == "/givecash"
					or string.sub(lower, 1, 6) == "/level"
					or string.sub(lower, 1, 9) == "/setlevel"
					or string.sub(lower, 1, 3) == "/xp"
					or string.sub(lower, 1, 7) == "/givexp"
					or string.sub(lower, 1, 13) == "/givekeepbase"
					or string.sub(lower, 1, 12) == "/nationreset"
				if not isAdminLine then
					return
				end
				local src = message.TextSource
				if not src then
					return
				end
				local player = Players:GetPlayerByUserId(src.UserId)
				if player then
					onAdminChat(player, text)
				end
			end)
		end)
		if not okMsg then
			warn("[AdminService] TextChat MessageReceived wire failed:", errMsg)
		end
	end
	task.defer(wireTextChatCommands)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Analytics abstraction. MVP logs to output; plug in real sink later.
	Does not fabricate metrics — only logs events you fire.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnalyticsConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.AnalyticsConfig)

local AnalyticsService = {}

local sink: ((eventName: string, userId: number?, props: { [string]: any }?) -> ())? = nil

function AnalyticsService.Init()
	-- default sink
end

function AnalyticsService.SetSink(fn: (eventName: string, userId: number?, props: { [string]: any }?) -> ())
	sink = fn
end

function AnalyticsService.Log(eventName: string, userId: number?, props: { [string]: any }?)
	if not AnalyticsConfig.Enabled then
		return
	end
	if sink then
		sink(eventName, userId, props)
		return
	end
	if AnalyticsConfig.LogToOutput then
		local propStr = ""
		if props then
			local parts = {}
			for k, v in pairs(props) do
				table.insert(parts, string.format("%s=%s", tostring(k), tostring(v)))
			end
			propStr = table.concat(parts, ", ")
		end
		print(string.format("[Analytics] %s user=%s %s", eventName, tostring(userId), propStr))
	end
end

return AnalyticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Basic sanity helpers used by other services

	Strikes (v69):
	  - Only real payload/validation violations count (bad fire payloads, unowned weapons, NaN, ...).
	  - Rate-limit denials ("*_rate" / "rate_*" reasons) are NOT strikes: a fast finger on a UI button
	    trips the same limiter as a macro, and the limiter already dropped the request. They are logged
	    (throttled) and ignored for the kick count.
	  - Lag/camera heuristics the server already corrects (SOFT_REASONS) are logged, not counted:
	    the client sends the camera ray origin, so any zoomed-out third-person shot is > 12 studs
	    from the root ("fire_origin_desync") and a miss at the 500-stud client ray is "out of range"
	    ("fire_hitpos_oor"). CombatService already snaps the origin to the root and ignores the hit.
	  - Strikes decay: one strike is forgiven every STRIKE_DECAY_SECONDS, so rare real strikes never
	    add up to a kick over a long session.
]]

local AntiExploitService = {}

local KICK_AT_STRIKES = 10
local STRIKE_DECAY_SECONDS = 30 -- one strike forgiven per 30 s (10 strikes fully clear in 5 min)
local SOFT_LOG_INTERVAL = 10 -- seconds between rate-limit log lines per player

-- Logged, never counted (the calling service already neutralised the request).
local SOFT_REASONS: { [string]: boolean } = {
	fire_origin_desync = true,
	fire_hitpos_oor = true,
	vfire_arc = true, -- W2 (money plan M4): a vehicle-gun shot outside the mount's arc (lag / turret slew), refused
}

type StrikeState = { count: number, updatedAt: number, kicked: boolean }

local RateLimitService: any = nil
local strikeState: { [number]: StrikeState } = {}
local softLogAt: { [number]: number } = {}

function AntiExploitService.Init(deps: { [string]: any })
	RateLimitService = deps.RateLimitService
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		strikeState[player.UserId] = nil
		softLogAt[player.UserId] = nil
	end)
end

function AntiExploitService.IsFiniteNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function AntiExploitService.ClampMagnitude(vec: Vector3, maxMag: number): Vector3
	if vec.Magnitude > maxMag then
		return vec.Unit * maxMag
	end
	return vec
end

-- Rate-limit denials (UI tap spam) — never a strike.
function AntiExploitService.IsRateLimitReason(reason: string): boolean
	if typeof(reason) ~= "string" then
		return false
	end
	return string.sub(reason, -5) == "_rate" or string.sub(reason, 1, 5) == "rate_"
end

-- True when Strike(reason) only logs (rate-limit denials + lag/camera heuristics).
function AntiExploitService.IsSoftReason(reason: string): boolean
	return AntiExploitService.IsRateLimitReason(reason) or SOFT_REASONS[reason] == true
end

-- Current strike count after decay (read-only).
local function decayedCount(state: StrikeState, now: number): number
	local elapsed = math.max(0, now - state.updatedAt)
	return math.max(0, state.count - elapsed / STRIKE_DECAY_SECONDS)
end

function AntiExploitService.GetStrikes(player: Player): number
	local state = strikeState[player.UserId]
	if not state then
		return 0
	end
	return decayedCount(state, os.clock())
end

function AntiExploitService.Strike(player: Player, reason: string)
	local id = player.UserId
	local now = os.clock()
	if AntiExploitService.IsSoftReason(reason) then
		local last = softLogAt[id]
		if last == nil or now - last >= SOFT_LOG_INTERVAL then
			softLogAt[id] = now
			print("[AntiExploit] soft (no strike)", player.Name, reason)
		end
		return
	end
	local state = strikeState[id]
	if not state then
		state = { count = 0, updatedAt = now, kicked = false }
		strikeState[id] = state
	end
	state.count = decayedCount(state, now) + 1
	state.updatedAt = now
	warn("[AntiExploit]", player.Name, reason, "strikes=", string.format("%.1f", state.count))
	if state.count >= KICK_AT_STRIKES and not state.kicked then
		state.kicked = true
		player:Kick("Unusual activity detected.")
	end
end

function AntiExploitService.CheckRemote(player: Player, key: string): boolean
	if not RateLimitService.Allow(player, "ae_" .. key, 6, 10) then
		AntiExploitService.Strike(player, "rate_" .. key)
		return false
	end
	return true
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">BankRaidService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Empire Bank raid — stand on vault to loot Cash; per-player cooldown.
	Bank guards are living CombatService NPCs (MoveTo + shoot), not static MapSetup props.
	Pushes HoldProgress / UnderFire / InVault / Blocked to clients for BankRaidController HUD.

	v71 (task #20, bank retune): "under fire" = hit within BankRaidConfig.UnderFireSeconds (was: health below 95 %,
	which froze the hold forever for anyone the guards had ever scratched — no health regen reaches 95 % inside the
	respawn window). The vault label is one stud-scaled WorldLabel, never AlwaysOnTop, MaxDistance <= 40 (HUD v70
	spec §5).

	W3 step 2, lane F "bank findable" (spec w3s2 §6 Phase A; server decides everything, the client only draws):
	- Guards spawn on FIXED posts: the "Town.Bank" npc anchors G1..Gn (ActivityAnchors, stamped on BankPlaza by
	  MapSetup once lane BK lands), else BankRaidConfig.GuardPosts (P0 posts clear of today's building).
	- On foot only: a seated raider (Humanoid.SeatPart) gets Blocked = "Vehicle", no progress and no pay.
	- The cooldown lives on the profile (profile.Raid.BankCooldownUntil, os.time seconds): sanitised here on load
	  (junk → removed, longer than one cooldown → clamped), so it survives a rejoin. No ProfileSchema edit: Migrate
	  keeps unknown Raid keys. A player whose profile has not loaded yet cannot loot (GetProfile is nil).
	- Label: "Empire Bank" + "OPEN · rob the vault" / "RAID ON" (everyone; attribute WE_BankState = open / raid).
	  "CLOSED 4m" is drawn by BankRaidController on the cooling player's own client only.
	- The EMPIRE BANK sign is painted (WorldKits.Sign, inside the world sign budget) only when BankSign has none.
	- Reward toast "Bank job +$23,456" (commas), MissionService.TrackProgress(player, "Heist", 1), and a one-time
	  first-visit tip (profile.Raid.BankSeen) within BankRaidConfig.FirstVisitRadius.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local Constants = require(Shared.Constants)
local BankRaidConfig = require(Shared.Configs.BankRaidConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

local BankRaidService = {}

local EconomyService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil
local RemoteSetup: any = nil
local CombatService: any = nil
local DataService: any = nil
local MissionService: any = nil

local vaultPart: BasePart? = nil
local holdProgress: { [number]: number } = {}
-- only when no DataService is wired (headless drivers); live servers keep the cooldown on the profile
local sessionCooldown: { [number]: number } = {}
local inVaultNow: { [number]: boolean } = {}
local underFireNow: { [number]: boolean } = {}
local blockedNow: { [number]: string } = {}
local lastPushedProgress: { [number]: number } = {}
local firstVisitDone: { [number]: boolean } = {}
local guardsSpawned = false
local vaultLabel: BillboardGui? = nil
local lastRaiding: boolean? = nil
local signTried = false
-- under fire = a health drop seen within UnderFireSeconds (sampled on the 4 Hz tick; regen never counts)
local lastHealth: { [number]: number } = {}
local hurtAt: { [number]: number } = {}

local LABEL = BankRaidConfig.Label
local TEXT = BankRaidConfig.Text
local SIGN = BankRaidConfig.Sign

-- Server modules used lazily (a missing or broken module only means the fallback path)
local function serverModule(name: string): any
	local parent = script.Parent and script.Parent.Parent
	local modules = parent and parent:FindFirstChild("Modules")
	local m = modules and modules:FindFirstChild(name)
	if not (m and m:IsA("ModuleScript")) then
		return nil
	end
	local ok, mod = pcall(require, m)
	return if ok then mod else nil
end

local function formatCash(n: number): string
	local s = string.format("%d", math.floor(math.abs(n)))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return out
end

local function findVault(): BasePart?
	if vaultPart and vaultPart.Parent then
		return vaultPart
	end
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BankVault)) do
		if inst:IsA("BasePart") then
			vaultPart = inst
			return inst
		end
	end
	return nil
end

-- ── profile: Raid.BankCooldownUntil / Raid.BankSeen (no schema edit; Migrate keeps unknown Raid keys) ──────────
local function raidTable(profile: any): { [string]: any }?
	local raid = profile.Raid
	if typeof(raid) ~= "table" then
		return nil
	end
	return raid
end

local function profileOf(player: Player): any
	if DataService == nil then
		return nil
	end
	return DataService.GetProfile(player)
end

-- os.time() until which this player cannot loot; nil = profile not loaded yet (not eligible)
local function cooldownUntil(player: Player): number?
	if DataService == nil then
		return sessionCooldown[player.UserId] or 0
	end
	local profile = profileOf(player)
	if profile == nil then
		return nil
	end
	local raid = raidTable(profile)
	local v = raid and raid.BankCooldownUntil
	if typeof(v) ~= "number" or v ~= v then
		return 0
	end
	return v
end

local function setCooldown(player: Player, untilT: number)
	if DataService == nil then
		sessionCooldown[player.UserId] = untilT
		return
	end
	local profile = profileOf(player)
	if profile == nil then
		return
	end
	local raid = raidTable(profile)
	if raid == nil then
		-- same defaults as ProfileSchema / MoneyCollectorService.raidOf (Migrate always leaves a table here)
		local fresh: { [string]: any } = { ShieldUntil = 0, StrikeCooldownUntil = 0, DefensesDownUntil = 0 }
		profile.Raid = fresh
		raid = fresh
	end
	if raid ~= nil then
		raid.BankCooldownUntil = untilT
	end
	DataService.MarkDirty(player)
end

--[[ Local sanitiser for the saved cooldown (spec w3s2 §6 lane F): not a finite number or <= 0 → removed; longer
	than one cooldown from now (junk or a clock jump) → clamped to now + CooldownSeconds; whole seconds. Returns the
	clean value (nil when absent) and whether it changed. Pure: exported for the headless tests. ]]
function BankRaidService.SanitizeCooldown(value: any, nowUnix: number): (number?, boolean)
	if value == nil then
		return nil, false
	end
	if typeof(value) ~= "number" or value ~= value or value <= 0 then
		return nil, true
	end
	local cap = nowUnix + math.max(0, BankRaidConfig.CooldownSeconds or 300)
	local clean = math.floor(math.min(value, cap))
	return clean, clean ~= value
end

local function sanitizeProfile(player: Player, profile: any)
	local raid = raidTable(profile)
	if raid == nil then
		return
	end
	local changed = false
	local cd, cdChanged = BankRaidService.SanitizeCooldown(raid.BankCooldownUntil, os.time())
	if cdChanged then
		raid.BankCooldownUntil = cd
		changed = true
	end
	local seen = raid.BankSeen
	if seen ~= nil and typeof(seen) ~= "boolean" then
		raid.BankSeen = nil
		changed = true
	end
	if changed and DataService then
		DataService.MarkDirty(player)
	end
end

-- ── world: vault label, EMPIRE BANK sign ────────────────────────────────────────────────────────────────────
local function ensureVaultBillboard(vault: BasePart)
	local existing = vault:FindFirstChild(LABEL.Name)
	if existing and existing:IsA("BillboardGui") and existing:FindFirstChild("Title") then
		vaultLabel = existing
		return
	end
	if existing then
		existing:Destroy()
	end
	-- spec §5 "Bank vault labels ×2 → keep only BankRaidService's": MapSetup's "EMPIRE BANK · Stand to RAID cash"
	-- card ("Label") sits on the same vault at the same height, so the two drew on top of each other. Its how-to
	-- line now lives in this label's state line ("OPEN · rob the vault").
	local legacy = vault:FindFirstChild("Label")
	if legacy and legacy:IsA("BillboardGui") then
		legacy:Destroy()
	end
	-- stud-scaled, plain outlined text, MaxDistance <= 40, never through walls (spec §5 "Bank vault labels")
	local bb = WorldLabel.Create(vault, LABEL.Title, {
		Name = LABEL.Name,
		Color = LABEL.Color,
		Sub = LABEL.OpenSub,
		SubColor = LABEL.OpenColor,
		Offset = Vector3.new(0, LABEL.HeightStuds, 0),
		MaxDistance = LABEL.MaxDistance,
	})
	bb:SetAttribute(LABEL.StateAttribute, "open")
	vaultLabel = bb
	lastRaiding = false
end

local FACES = {
	Enum.NormalId.Front,
	Enum.NormalId.Back,
	Enum.NormalId.Left,
	Enum.NormalId.Right,
	Enum.NormalId.Top,
	Enum.NormalId.Bottom,
}

-- the face of `part` whose world normal points most along `dir` (the street side of the sign)
local function faceToward(part: BasePart, dir: Vector3): Enum.NormalId
	local best, bestDot = Enum.NormalId.Front, -math.huge
	for _, face in ipairs(FACES) do
		local n = part.CFrame:VectorToWorldSpace(Vector3.FromNormalId(face))
		local d = n:Dot(dir)
		if d > bestDot then
			best, bestDot = face, d
		end
	end
	return best
end

-- the bank's own folder (MapSetup's "EmpireBank" = BankId), however deep the vault sits in it
local function bankFolderOf(vault: BasePart): Instance?
	local cur = vault.Parent
	while cur ~= nil and not cur:IsA("Workspace") do
		if cur.Name == BankRaidConfig.BankId then
			return cur
		end
		cur = cur.Parent
	end
	local parent = vault.Parent
	return if parent ~= nil and not parent:IsA("Workspace") then parent else nil -- never search all of Workspace
end

-- EMPIRE BANK on the bank's sign part, only when it has no SurfaceGui yet (idempotent once lane BK paints it)
local function ensureBankSign(vault: BasePart)
	if signTried then
		return
	end
	local folder = bankFolderOf(vault)
	-- a 17-part folder; searched at most a few times (Init, the 4 Hz tick until the 2 s deferred pass)
	local sign = folder and folder:FindFirstChild(SIGN.PartName, true)
	if not (sign and sign:IsA("BasePart")) then
		return -- not built yet (retried on the next tick); nothing to paint on
	end
	signTried = true
	if sign:FindFirstChildWhichIsA("SurfaceGui") then
		return
	end
	local WorldKits = serverModule("WorldKits")
	if WorldKits == nil or WorldKits.Sign == nil then
		warn("[WAR EMPIRE] BankRaidService: WorldKits.Sign missing; EMPIRE BANK sign not painted")
		return
	end
	local ok, gui = pcall(WorldKits.Sign, sign, faceToward(sign, SIGN.Facing), SIGN.Text)
	if not ok or gui == nil then
		warn("[WAR EMPIRE] BankRaidService: EMPIRE BANK sign not painted (" .. tostring(if ok then "world sign budget" else gui) .. ")")
	end
end

local function refreshBillboardHint()
	local bb = vaultLabel
	if not bb or not bb.Parent then
		return
	end
	-- One public line; the per-player hold / cooldown stays on the raider's HUD (BankRaidController), and the
	-- "CLOSED 4m" line is drawn by that player's own client over this one.
	local anyRaiding = false
	for uid, inv in pairs(inVaultNow) do
		if inv and (holdProgress[uid] or 0) > 0 then
			anyRaiding = true
			break
		end
	end
	if anyRaiding == lastRaiding then
		return
	end
	lastRaiding = anyRaiding
	-- attribute first: a client drawing its own CLOSED line reads the public state back from it
	bb:SetAttribute(LABEL.StateAttribute, if anyRaiding then "raid" else "open")
	WorldLabel.SetText(
		bb,
		LABEL.Title,
		if anyRaiding then LABEL.RaidingSub else LABEL.OpenSub,
		if anyRaiding then LABEL.RaidingColor else LABEL.OpenColor
	)
end

-- ── guards on fixed posts ───────────────────────────────────────────────────────────────────────────────────
--[[ Root CFrames for the bank guards: the "Town.Bank" npc anchors whose role is G<n> (sorted by id), else the
	BankRaidConfig.GuardPosts fallback (at most GuardCount). Pure apart from the anchor read: exported for tests. ]]
function BankRaidService.GuardPosts(): ({ CFrame }, string)
	local lift = BankRaidConfig.GuardRootLift or 3
	local out: { CFrame } = {}
	local ActivityAnchors = serverModule("ActivityAnchors")
	if ActivityAnchors and ActivityAnchors.List then
		local ok, list = pcall(ActivityAnchors.List, BankRaidConfig.AnchorSite, "npc")
		if ok and typeof(list) == "table" then
			for _, a in ipairs(list) do
				if typeof(a.Role) == "string" and string.match(a.Role, BankRaidConfig.GuardRolePattern) and typeof(a.CFrame) == "CFrame" then
					table.insert(out, a.CFrame + Vector3.new(0, lift, 0))
				end
			end
		end
	end
	if #out > 0 then
		return out, "anchors"
	end
	local limit = BankRaidConfig.GuardCount or #BankRaidConfig.GuardPosts
	for i, p in ipairs(BankRaidConfig.GuardPosts) do
		if i > limit then
			break
		end
		local cf = CFrame.new(p.X, p.Y + lift, p.Z) * CFrame.Angles(0, math.rad(p.Yaw or 180), 0)
		table.insert(out, cf)
	end
	return out, "config"
end

local function spawnBankGuards()
	if guardsSpawned then
		return
	end
	if not CombatService or not CombatService.SpawnNPC then
		warn("[WAR EMPIRE] BankRaidService: CombatService.SpawnNPC missing")
		return
	end
	guardsSpawned = true

	local posts, source = BankRaidService.GuardPosts()
	local typeId = BankRaidConfig.GuardNPCType or "BankGuard"
	local spawned = 0
	for _, cf in ipairs(posts) do
		local rec = CombatService.SpawnNPC(typeId, cf)
		if rec then
			spawned += 1
		end
	end
	print(string.format("[WAR EMPIRE] BankRaidService: spawned %d %s combat NPCs at bank (%d fixed posts from %s)", spawned, typeId, #posts, source))
	if spawned == 0 then
		warn("[WAR EMPIRE] BankRaidService: ZERO BankGuards — will retry once in 3s")
		guardsSpawned = false
		task.delay(3, function()
			if not guardsSpawned then
				spawnBankGuards()
			end
		end)
	end
end

-- ── HUD payload ────────────────────────────────────────────────────────────────────────────────────────────
local function pushState(player: Player, opts: { InVault: boolean?, UnderFire: boolean? }?)
	if not RemoteSetup then
		return
	end
	local now = os.time()
	local untilT = cooldownUntil(player) or 0
	local remaining = math.max(0, untilT - now)
	local need = BankRaidConfig.RaidHoldSeconds or 8
	local prog = holdProgress[player.UserId] or 0
	local inVault = if opts and opts.InVault ~= nil then opts.InVault else (inVaultNow[player.UserId] == true)
	local underFire = if opts and opts.UnderFire ~= nil then opts.UnderFire else (underFireNow[player.UserId] == true)
	local remote = RemoteSetup.Get(Constants.RemoteNames.BankRaidStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		BankId = BankRaidConfig.BankId,
		DisplayName = BankRaidConfig.DisplayName,
		Enabled = BankRaidConfig.Enabled == true,
		CooldownRemaining = remaining,
		RaidHoldSeconds = need,
		HoldNeed = need,
		HoldProgress = prog,
		InVault = inVault,
		UnderFire = underFire,
		Blocked = if inVault then blockedNow[player.UserId] else nil,
		CashHintMin = BankRaidConfig.CashMin,
		CashHintMax = BankRaidConfig.CashMax,
	})
	lastPushedProgress[player.UserId] = prog
end

local function completeRaid(player: Player)
	local cashMin = BankRaidConfig.CashMin or 15000
	local cashMax = BankRaidConfig.CashMax or 35000
	local cash = math.random(cashMin, cashMax)
	holdProgress[player.UserId] = nil
	inVaultNow[player.UserId] = false
	underFireNow[player.UserId] = false
	blockedNow[player.UserId] = nil
	-- "bank_raid" is exempt from the cash multipliers (MonetizationConfig.CashMultExemptReasons): the toast is exact
	if EconomyService.AddCash(player, cash, "bank_raid") ~= true then
		pushState(player, { InVault = false, UnderFire = false })
		return -- no profile: nothing paid, so no cooldown either
	end
	local cd = BankRaidConfig.CooldownSeconds or 300
	setCooldown(player, os.time() + cd)
	if BankRaidConfig.NotifyOnRaid and NotificationService then
		NotificationService.Notify(player, string.format(TEXT.Reward, formatCash(cash)), "Reward")
	end
	if MissionService and MissionService.TrackProgress then
		local ok, err = pcall(MissionService.TrackProgress, player, "Heist", 1)
		if not ok then
			warn("[WAR EMPIRE] BankRaidService: TrackProgress Heist failed: " .. tostring(err))
		end
	end
	if AnalyticsService then
		local ev = (AnalyticsConfig.Events and AnalyticsConfig.Events.BANK_RAID) or "BANK_RAID"
		AnalyticsService.Log(ev, player.UserId, { cash = cash })
	end
	pushState(player, { InVault = false, UnderFire = false })
end

-- health drops since the last tick → "hit just now" (a respawn or regen raises health and never counts)
local function sampleHurt(uid: number, hum: Humanoid, nowC: number)
	local hp = hum.Health
	local prev = lastHealth[uid]
	if prev ~= nil and hp < prev - 0.01 then
		hurtAt[uid] = nowC
	end
	lastHealth[uid] = hp
end

local function isUnderFire(player: Player, nowC: number): boolean
	local char = player.Character
	if not char then
		return true
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return true
	end
	return nowC - (hurtAt[player.UserId] or -math.huge) < (BankRaidConfig.UnderFireSeconds or 2)
end

-- one-time tip the first time this player comes near the bank (saved; never while being shot at)
local function maybeFirstVisit(player: Player, rootPos: Vector3, nowC: number)
	local uid = player.UserId
	if firstVisitDone[uid] or not NotificationService then
		return
	end
	local center = BankRaidConfig.Position
	local dx, dz = rootPos.X - center.X, rootPos.Z - center.Z
	local r = BankRaidConfig.FirstVisitRadius or 150
	if dx * dx + dz * dz > r * r then
		return
	end
	local profile = profileOf(player)
	if DataService ~= nil and profile == nil then
		return -- not loaded yet: ask again on a later tick
	end
	local raid = if profile ~= nil then raidTable(profile) else nil
	if raid ~= nil and raid.BankSeen == true then
		firstVisitDone[uid] = true
		return
	end
	if nowC - (hurtAt[uid] or -math.huge) < (BankRaidConfig.FirstVisitSkipIfHitSeconds or 5) then
		return
	end
	firstVisitDone[uid] = true
	if raid ~= nil then
		raid.BankSeen = true
		DataService.MarkDirty(player)
	end
	NotificationService.Notify(player, TEXT.FirstVisit, "Info")
end

function BankRaidService.Push(player: Player)
	pushState(player)
end

function BankRaidService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService
	RemoteSetup = deps.RemoteSetup
	CombatService = deps.CombatService
	DataService = deps.DataService
	MissionService = deps.MissionService

	if not BankRaidConfig.Enabled then
		return
	end

	-- the sign first, while the world sign budget still has the bank's slot (MapDressing paints the POI boards a
	-- frame later); retried from the tick if the bank is not built yet
	do
		local vault = findVault()
		if vault then
			ensureBankSign(vault)
		end
	end

	task.defer(function()
		task.wait(2)
		local vault = findVault()
		if vault then
			ensureVaultBillboard(vault)
			ensureBankSign(vault)
			signTried = true -- one more try at most: a bank without a BankSign part has nothing to paint
		end
		spawnBankGuards()
	end)

	if DataService and DataService.OnProfileLoaded then
		-- the saved cooldown reaches the HUD (and the client's CLOSED line) as soon as the save is in
		DataService.OnProfileLoaded(function(player: Player, profile: any)
			sanitizeProfile(player, profile)
			if player.Parent then
				pushState(player)
			end
		end)
	end

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.25 then
			return
		end
		local step = accum
		accum = 0

		local vault = findVault()
		if not vault then
			return
		end
		if not (vaultLabel and vaultLabel.Parent) then
			ensureVaultBillboard(vault)
		end
		if not signTried then
			ensureBankSign(vault)
		end
		local radius = BankRaidConfig.VaultRadius or 12
		local need = BankRaidConfig.RaidHoldSeconds or 8
		local nowUnix = os.time()
		local nowC = os.clock()
		local pos = vault.Position
		local nearby: { [number]: boolean } = {}
		local toPush: { Player } = {}

		for _, player in ipairs(Players:GetPlayers()) do
			local uid = player.UserId
			local untilT = cooldownUntil(player) -- nil: profile not loaded → not eligible (treated as away)
			local onCooldown = untilT ~= nil and untilT > nowUnix
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local inside = false
			local fired = false

			if hum then
				sampleHurt(uid, hum, nowC)
			end
			if hrp and hum and hum.Health > 0 then
				inside = untilT ~= nil and (hrp.Position - pos).Magnitude <= radius
				maybeFirstVisit(player, hrp.Position, nowC)
			end

			if inside and not onCooldown and hum and hum.SeatPart ~= nil then
				-- on foot only: a vehicle parked on the vault never loots (progress frozen, "LEAVE VEHICLE")
				nearby[uid] = true
				inVaultNow[uid] = true
				underFireNow[uid] = false
				blockedNow[uid] = "Vehicle"
				table.insert(toPush, player)
			elseif inside and not onCooldown then
				nearby[uid] = true
				blockedNow[uid] = nil
				fired = isUnderFire(player, nowC)
				underFireNow[uid] = fired
				inVaultNow[uid] = true
				if not fired then
					local prog = (holdProgress[uid] or 0) + step
					holdProgress[uid] = prog
					if prog >= need then
						completeRaid(player)
						-- completeRaid already pushed
					else
						table.insert(toPush, player)
					end
				else
					-- Under fire: progress frozen but HUD must show the block
					table.insert(toPush, player)
				end
			elseif inside and onCooldown then
				-- Standing on vault while cooling down — still show cooldown HUD
				inVaultNow[uid] = true
				underFireNow[uid] = false
				blockedNow[uid] = nil
				nearby[uid] = true
				table.insert(toPush, player)
			else
				local wasIn = inVaultNow[uid] == true
				local hadProg = (holdProgress[uid] or 0) > 0
				blockedNow[uid] = nil
				if wasIn or hadProg then
					-- Left vault / progress reset — push once so client hides bar
					inVaultNow[uid] = false
					underFireNow[uid] = false
					holdProgress[uid] = nil
					table.insert(toPush, player)
				else
					inVaultNow[uid] = false
					underFireNow[uid] = false
				end
			end
		end

		for uid in pairs(holdProgress) do
			if not nearby[uid] then
				holdProgress[uid] = nil
			end
		end

		for _, player in ipairs(toPush) do
			pushState(player)
		end

		refreshBillboardHint()
	end)

	Players.PlayerAdded:Connect(function(player)
		task.defer(function()
			pushState(player)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local uid = player.UserId
		holdProgress[uid] = nil
		inVaultNow[uid] = nil
		underFireNow[uid] = nil
		blockedNow[uid] = nil
		lastPushedProgress[uid] = nil
		lastHealth[uid] = nil
		hurtAt[uid] = nil
		firstVisitDone[uid] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.defer(function()
			pushState(player)
		end)
	end

	print("[WAR EMPIRE] BankRaidService ready (fixed-post BankGuards, on-foot hold, saved cooldown)")
end

return BankRaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Base plot assignment, upgrades, passive income, visual hooks.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local DevConfig = require(Shared.Configs.DevConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local Types = require(Shared.Types)
local ConsoleLocator = require(Shared.Util.ConsoleLocator)
local TycoonMath = require(Shared.Util.TycoonMath) -- v72: one passive formula (paid here, shown on the client)
local BusinessConfig = require(Shared.Configs.BusinessConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local StreamingConfig = require(Shared.Configs.StreamingConfig) -- streaming2 S1

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)
local StreamPrefetch = require(script.Parent.Parent.Modules.StreamPrefetch) -- streaming2 S1: pre-fetched moves
local BaseLayout = require(script.Parent.Parent.Modules.BaseLayout) -- v70: plot frame
local StructureKitBuilder = require(script.Parent.Parent.Modules.StructureKitBuilder)
local HollowBuildingBuilder = require(script.Parent.Parent.Modules.HollowBuildingBuilder)
local BusinessService = require(script.Parent.BusinessService) -- v72 war businesses: stateless world builder

local BaseService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local getStateJoinedAt: { [number]: number } = {}
local RemoteSetup: any = nil
local TerritoryService: any = nil
local MissionService: any = nil
local TutorialService: any = nil
local NotificationService: any = nil
local MonetizationService: any = nil

-- v65: never index nil DataService — recover via require if Init deps cleared / race
local function getDataService(): any
	if DataService ~= nil then
		return DataService
	end
	local ok, mod = pcall(require, script.Parent.DataService)
	if ok and mod ~= nil then
		DataService = mod
		warn("[BaseService] getDataService: recovered via require(script.Parent.DataService)")
		return DataService
	end
	warn("[BaseService] getDataService: DataService still nil after require fallback")
	return nil
end

-- plotId -> userId
local plotOwners: { [number]: number } = {}
-- Bindable for Studio visuals
local upgradeChangedBindable: BindableEvent? = nil

local function getUpgradeChangedEvent(): BindableEvent
	if upgradeChangedBindable and upgradeChangedBindable.Parent then
		return upgradeChangedBindable
	end
	local folder = ReplicatedStorage:FindFirstChild("WarEmpireEvents")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "WarEmpireEvents"
		folder.Parent = ReplicatedStorage
	end
	local ev = folder:FindFirstChild("BaseUpgradeChanged")
	if not ev then
		ev = Instance.new("BindableEvent")
		ev.Name = "BaseUpgradeChanged"
		ev.Parent = folder
	end
	upgradeChangedBindable = ev :: BindableEvent
	return upgradeChangedBindable
end

function BaseService.GetUpgradeChangedEvent(): BindableEvent
	return getUpgradeChangedEvent()
end

local function findFreePlot(): number?
	for plotId = 1, BaseConfig.MaxPlots do
		if plotOwners[plotId] == nil then
			return plotId
		end
	end
	return nil
end

-- v69: a real plot id (1..MaxPlots); a saved id from another server / older build may be anything
local function isValidPlotId(plotId: any): boolean
	local n = tonumber(plotId)
	return n ~= nil and n == math.floor(n) and n >= 1 and n <= BaseConfig.MaxPlots
end

-- v69: server truth for "which plot does this player own here" (profile.BasePlotId is only a copy)
local function ownedPlotOf(userId: number): number?
	for plotId, owner in pairs(plotOwners) do
		if owner == userId then
			return plotId
		end
	end
	return nil
end

local function setNoPlotFlag(player: Player, noPlot: boolean)
	pcall(function()
		player:SetAttribute("WE_NoPlot", noPlot)
	end)
end

-- streaming2 S1 (F2): the plot's own SpawnLocation (MapSetup: Plot<n>.PlayerSpawn, Neutral, Duration 0), found the
-- way GetPlotSpawnCFrame finds the teleport target (the plot pad's folder)
local function plotSpawnLocation(plotId: number): SpawnLocation?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and tonumber(inst:GetAttribute("PlotId") :: any) == plotId then
			local spawn = inst.Parent and inst.Parent:FindFirstChild("PlayerSpawn")
			if spawn and spawn:IsA("SpawnLocation") then
				return spawn
			end
			return nil
		end
	end
	return nil
end

--[[ streaming2 S1 (F2): respawn on the own plot, not on a random plot gate (maybe an enemy's, and a cross-map hop the
	phone has not streamed). Player.yaml: RespawnLocation takes a Neutral SpawnLocation under Workspace. nil clears it.
	Only while Workspace.StreamingEnabled is on: with streaming off respawns stay exactly as before. ]]
local function setRespawnAtPlot(player: Player, plotId: number?)
	if not StreamPrefetch.Enabled() then
		return
	end
	local spawn = if plotId ~= nil then plotSpawnLocation(plotId) else nil
	xpcall(function()
		if player.RespawnLocation == spawn then
			return
		elseif spawn then
			player.RespawnLocation = spawn
		else
			local anyPlayer: any = player -- typed SpawnLocation, but nil is the documented "default spawning"
			anyPlayer.RespawnLocation = nil
		end
	end, function(err: any)
		warn("[BaseService] RespawnLocation not set for", player.Name, err)
	end)
end

--[[ v69: returns the player's plot, or nil when every plot is owned. Never hands out a plot someone else owns:
	v63 forced plot 1 here, so the 7th+ player shared plot 1 with its owner — each one's refresh redrew the other's
	kits and walls at their own levels, and the extra player's ReleasePlot wiped the real owner's base. ]]
function BaseService.AssignPlot(player: Player): number?
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		return nil
	end

	-- Already holds a plot on this server: keep it (idempotent — never a second plot)
	local held = ownedPlotOf(player.UserId)
	if held ~= nil then
		if profile.BasePlotId ~= held then
			profile.BasePlotId = held
			DS.MarkDirty(player)
		end
		setNoPlotFlag(player, false)
		setRespawnAtPlot(player, held)
		return held
	end

	-- Reclaim previous if still free
	local saved = tonumber(profile.BasePlotId)
	if saved ~= nil and isValidPlotId(saved) and plotOwners[saved] == nil then
		plotOwners[saved] = player.UserId
		if profile.BasePlotId ~= saved then
			profile.BasePlotId = saved
			DS.MarkDirty(player)
		end
		setNoPlotFlag(player, false)
		setRespawnAtPlot(player, saved)
		return saved
	end

	local plotId = findFreePlot()
	if not plotId then
		warn("[BaseService] No free plot for", player.Name, "— all", BaseConfig.MaxPlots, "owned; waiting for one to free up")
		-- A stale saved id must not let this player buy / collect on another player's plot
		if profile.BasePlotId ~= nil then
			profile.BasePlotId = nil
			DS.MarkDirty(player)
		end
		setNoPlotFlag(player, true)
		setRespawnAtPlot(player, nil)
		return nil
	end

	plotOwners[plotId] = player.UserId
	profile.BasePlotId = plotId
	DS.MarkDirty(player)
	setNoPlotFlag(player, false)
	setRespawnAtPlot(player, plotId)
	return plotId
end

function BaseService.ReleasePlot(player: Player): boolean
	local userId = player.UserId
	local released = false
	for plotId, owner in pairs(plotOwners) do
		if owner == userId then
			pcall(function()
				StructureKitBuilder.ClearPlotExtras(plotId)
			end)
			pcall(BusinessService.OnPlotReleased, player, plotId) -- v72: the plot's business lines + WE_AtmPos go
			plotOwners[plotId] = nil
			released = true
		end
	end
	if released then
		setRespawnAtPlot(player, nil) -- streaming2 S1 (F2): the plot is no longer theirs
	end
	return released
end

function BaseService.GetOwnerUserId(plotId: number): number?
	return plotOwners[plotId]
end

-- v69: set in Init section (setUpGainedPlot): full setup when a plotless player picks up a free plot outside the
-- join / hand-out paths (teleport, notify, tutorial, kit refresh → plot-ready)
local onLateClaim: ((Player, number) -> ())? = nil

local function claimFreePlotLate(player: Player): number?
	local plotId = BaseService.AssignPlot(player)
	if plotId ~= nil and onLateClaim then
		task.delay(0.5, onLateClaim, player, plotId)
	end
	return plotId
end

-- v69: owned plot for a base rebuild. A profile that carries a BasePlotId but no plotOwners entry (never assigned
-- on this server) re-claims it through AssignPlot — which hands out a FREE plot or none, never an owned one.
local function plotForRebuild(player: Player, profile: any): number?
	local plotId = ownedPlotOf(player.UserId)
	if plotId == nil and profile.BasePlotId ~= nil then
		plotId = BaseService.AssignPlot(player)
	end
	return plotId
end

--[[ v69: the plot this player owns on this server, or nil (server full). Prefer this over profile.BasePlotId. ]]
function BaseService.GetOwnedPlotId(player: Player): number?
	return ownedPlotOf(player.UserId)
end

-- v69: plot-ready listeners (GateDefense / PlotOilPump). Fired after RefreshAllVisuals rebuilt a plot's walls
-- (GatePosts) for its owner: on join once the real save is loaded, when a freed plot is handed out, prestige,
-- map rebuild. Replaces the fixed 1.2 s / 3.5 s / 4 s re-sync timers those services used.
local plotReadyCallbacks: { (Player, number) -> () } = {}

local function runPlotReadyCallback(cb: (Player, number) -> (), player: Player, plotId: number)
	task.spawn(function()
		xpcall(cb, function(err)
			warn("[BaseService] OnPlotReady callback failed:", err)
		end, player, plotId)
	end)
end

local function firePlotReady(player: Player, plotId: number)
	for _, cb in ipairs(plotReadyCallbacks) do
		runPlotReadyCallback(cb, player, plotId)
	end
end

--[[ v69: cb(player, plotId) runs whenever a plot's walls/kits were (re)built for its owner. Also runs right away
	for plots already owned (services that Init after players joined). Callbacks must be idempotent. ]]
function BaseService.OnPlotReady(cb: (Player, number) -> ())
	table.insert(plotReadyCallbacks, cb)
	for plotId, userId in pairs(plotOwners) do
		local owner = Players:GetPlayerByUserId(userId)
		if owner then
			runPlotReadyCallback(cb, owner, plotId)
		end
	end
end

-- v72: territory % (what ComputePassiveIncomePerTick multiplies by) and the territory flat $ per tick.
-- B1 (owner's 11 features, lane E): no prestige here. EconomyService.AccruePendingCash("passive") applies prestige once
-- (+10 % per prestige); applying it here as well paid x1.21 at prestige 1 instead of x1.10.
local function passiveMultAndFlat(profile: Types.PlayerProfile, player: Player?): (number, number)
	local mult = 1
	local flat = 0
	-- Territory ownership bonuses (Phase 5)
	if player and TerritoryService and TerritoryService.GetPassiveCashBonus then
		local bonusMult, bonusFlat = TerritoryService.GetPassiveCashBonus(player)
		mult += tonumber(bonusMult) or 0
		flat = tonumber(bonusFlat) or 0
	end
	return mult, flat
end

function BaseService.ComputePassiveIncomePerTick(profile: Types.PlayerProfile, player: Player?): number
	-- v72: TycoonMath is the one formula (buildings rate x level as before; war businesses their IncomePerTick
	-- table, only while BusinessConfig.Enabled). Saved levels are clamped there: junk never throws or overpays.
	local total = TycoonMath.BasePassivePerTick(profile.BaseUpgrades)
	local mult, flat = passiveMultAndFlat(profile, player)
	total += flat
	return math.floor(total * mult)
end

-- v72: the multiplier ComputePassiveIncomePerTick applies (territory %; B1: prestige is in EconomyService's stack).
-- WE_IncomeMult = this x EconomyService.GetCashMult(player, "passive") (what one config $ pays into the ATM).
function BaseService.PassiveMultiplier(profile: Types.PlayerProfile, player: Player?): number
	local mult = passiveMultAndFlat(profile, player)
	return mult
end

-- v72: WE_IncomeMult for `player` now (rounded to 0.01; 1 without a profile). Display only, never a grant.
function BaseService.IncomeMult(player: Player): number
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		return 1
	end
	local cashMult = 1
	if EconomyService and EconomyService.GetCashMult then
		local okM, m = pcall(EconomyService.GetCashMult, player, "passive")
		if okM and typeof(m) == "number" and m == m then
			cashMult = m
		end
	end
	return math.floor(BaseService.PassiveMultiplier(profile, player) * cashMult * 100 + 0.5) / 100
end

-- v72: "  +$3.3/s" for the purchase toast (TycoonGuideConfig.Text.ToastSuffix + TycoonMath.PerSecText of the level's
-- gain x WE_IncomeMult, oil unscaled). "" while the guide is off or the level adds no income.
function BaseService.PurchaseToastSuffix(player: Player, structureId: string, newLevel: number): string
	if not TycoonGuideConfig.Enabled then
		return ""
	end
	local lv = math.floor(tonumber(newLevel) or 0)
	if lv < 1 then
		return ""
	end
	local gain = TycoonMath.StepGainPerTick(structureId, lv - 1, BaseService.IncomeMult(player))
	if gain <= 0 then
		return ""
	end
	return string.format(TycoonGuideConfig.Text.ToastSuffix, TycoonMath.PerSecText(gain))
end

function BaseService.PushState(player: Player)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return
	end
	local remote = RemoteSetup.Get(Constants.RemoteNames.BaseStateUpdate) :: RemoteEvent
	local payload: Types.BaseStatePayload = {
		PlotId = profile.BasePlotId,
		Upgrades = profile.BaseUpgrades,
		PassiveIncomePerTick = BaseService.ComputePassiveIncomePerTick(profile, player),
	}
	remote:FireClient(player, payload)
end

local function meetsRequirements(profile: Types.PlayerProfile, structureId: string): (boolean, string?)
	local def = BaseConfig.Structures[structureId]
	if not def then
		return false, "UnknownStructure"
	end
	if def.Requires then
		for _, req in ipairs(def.Requires) do
			local have = profile.BaseUpgrades[req.StructureId] or 0
			if have < req.Level then
				return false, "MissingRequirement"
			end
		end
	end
	return true, nil
end


-- v70: plot-local PlayerSpawn offset (same choice as MapSetup); the pad CFrame carries the plot yaw
local function plotSpawnOffset(): { X: number, Z: number }
	return if BaseLayout.Enabled() then BaseLayout.Config().SpawnOffset else { X = 0, Z = 55 }
end

function BaseService.GetPlotSpawnCFrame(plotId: number): CFrame?
	local wantPlot = tonumber(plotId)
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and wantPlot ~= nil and tonumber(inst:GetAttribute("PlotId") :: any) == wantPlot then
			local folder = inst.Parent
			if folder then
				local spawn = folder:FindFirstChild("PlayerSpawn")
				if spawn and spawn:IsA("BasePart") then
					return spawn.CFrame + Vector3.new(0, 3, 0)
				end
			end
			local sp = plotSpawnOffset()
			return inst.CFrame * CFrame.new(sp.X, 5, sp.Z)
		end
	end
	local pos = BaseConfig.PlotPositions[plotId]
	if typeof(pos) == "Vector3" then
		local sp = plotSpawnOffset()
		return BaseLayout.PlotCFrame(pos) * CFrame.new(sp.X, 5, sp.Z)
	end
	return nil
end

-- v69: player without a plot (server full) waits on neutral ground at Central Plaza — every PlayerSpawn sits at
-- somebody's gate, where that owner's GateGuards shoot non-allies.
local function noPlotDropCFrame(): CFrame
	local fallback = CFrame.new(0, 8, 40)
	local ok, hit = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local chars = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then
				table.insert(chars, plr.Character)
			end
		end
		params.FilterDescendantsInstances = chars
		return Workspace:Raycast(Vector3.new(0, 400, 40), Vector3.new(0, -800, 0), params)
	end)
	if ok and hit then
		return CFrame.new(hit.Position + Vector3.new(0, 4, 0))
	end
	return fallback
end

--[[ Moves the player onto THEIR plot (true), or — with no plot free — onto neutral ground (false).
	streaming2 S1 (F1): while Workspace.StreamingEnabled is on, the move goes through StreamPrefetch: the destination is
	pre-fetched first (RequestStreamAroundAsync), one move is in flight per player, and the stacked re-applies are
	gone (one settle check instead). With streaming off the move is the old one: at once, then again at 0.35 s and 1.0 s.
	onArrived(moved), optional, runs once: after the move, or at once when there is nothing to move. ]]
function BaseService.TeleportToPlot(player: Player, onArrived: ((boolean) -> ())?): boolean
	local function arrived(moved: boolean)
		if onArrived then
			task.spawn(onArrived, moved) -- its own thread: a failing callback never breaks the teleport
		end
	end
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		arrived(false)
		return false
	end
	-- v69: only ever a plot this player owns (v63 forced BasePlotId=1 → another player's base)
	local plotId = ownedPlotOf(player.UserId)
	if plotId == nil then
		plotId = claimFreePlotLate(player)
	end
	local cf: CFrame? = nil
	if plotId ~= nil then
		cf = BaseService.GetPlotSpawnCFrame(plotId)
	else
		cf = noPlotDropCFrame()
	end
	if not cf then
		arrived(false)
		return false
	end
	local target: CFrame = cf
	local function apply(character: Model)
		if character and character.Parent then
			StreamPrefetch.Place(character, target) -- PivotTo + zero velocity
		end
	end
	local function applyWithRetries(character: Model)
		apply(character)
		-- Retry: CharacterAdded / physics settle can undo first PivotTo
		task.delay(0.35, function()
			if player.Character == character and character.Parent then
				apply(character)
			end
		end)
		task.delay(1.0, function()
			if player.Character == character and character.Parent then
				apply(character)
			end
		end)
	end
	local function moveNow(character: Model)
		if StreamPrefetch.Enabled() then
			StreamPrefetch.PivotTo(player, target, { OnDone = arrived })
		else
			applyWithRetries(character)
			arrived(character.Parent ~= nil)
		end
	end
	if player.Character then
		moveNow(player.Character)
	else
		local conn: RBXScriptConnection?
		local spawned = false
		conn = player.CharacterAdded:Connect(function(character)
			spawned = true
			if conn then
				conn:Disconnect()
			end
			task.defer(function()
				moveNow(character)
			end)
		end)
		task.delay(30, function()
			if conn then
				conn:Disconnect()
			end
			if not spawned then
				arrived(false)
			end
		end)
	end
	return plotId ~= nil
end

--[[ v71 console-only buying. There is NO bypass: every caller (the remote, the console prompt, StudioBuySmoke)
	needs the character at this structure's console on the caller's own plot. AtPart: the console / pad whose prompt
	fired (UpgradePadService), checked instead of looking the console up. Source: logs only. Nothing here is ever
	built from a remote payload (the remote handler reads StructureId only). ]]
export type PurchaseOpts = {
	AtPart: BasePart?,
	Source: string?,
}

local noConsoleWarned: { [string]: boolean } = {}

--[[ v71: is the player at this structure's console on THEIR plot (server's view of the character)?
	Returns (ok, reason, horizontalDistance?). reason: Ok | NoPlot | ConsoleLocator.Reason
	(NoCharacter | Dead | Seated | NoConsole | WrongPart | TooFar | WrongFloor | OtherNearer). ]]
function BaseService.IsAtConsole(player: Player, structureId: string, atPart: BasePart?): (boolean, string, number?)
	local plotId = ownedPlotOf(player.UserId)
	if plotId == nil then
		return false, "NoPlot", nil
	end
	local ok, reason, dist = ConsoleLocator.Check(player, plotId, structureId, atPart)
	if not ok and reason == "NoConsole" then
		local key = tostring(plotId) .. "|" .. structureId
		if not noConsoleWarned[key] then
			noConsoleWarned[key] = true
			warn(string.format("[BaseService] no console part for %s on plot %d (NoConsolePolicy=%s)", structureId, plotId, tostring(ConsoleBuyConfig.NoConsolePolicy)))
		end
		if ConsoleBuyConfig.NoConsolePolicy == "Allow" then
			return true, "NoConsole", nil
		end
	end
	return ok, reason, dist
end

function BaseService.PurchaseUpgrade(player: Player, structureId: string, opts: PurchaseOpts?): Types.PurchaseUpgradeResult
	if not RemoteGuard.IsIdString(structureId, 48) then
		return { Ok = false, Error = "InvalidStructure" }
	end

	-- v65: never throw "attempt to index nil with GetProfile"
	local DS = getDataService()
	if not DS then
		return { Ok = false, Error = "NoDataService" }
	end

	local profile = DS.GetProfile(player)
	if not profile and DS.EnsureProfile then
		profile = DS.EnsureProfile(player)
	end
	if not profile then
		return { Ok = false, Error = "NoProfile" }
	end

	-- v64: never index nil nested tables (live DS corruption / partial EnsureProfile)
	if typeof(profile.BaseUpgrades) ~= "table" then
		profile.BaseUpgrades = {}
	end
	if typeof(profile.Stats) ~= "table" then
		profile.Stats = {
			TotalCashEarned = 0,
			TotalGoldEarned = 0,
			UpgradesPurchased = 0,
			VehiclesSpawned = 0,
			MissionsCompleted = 0,
			TerritoriesCaptured = 0,
			Kills = 0,
			Deaths = 0,
			PlayTimeSeconds = 0,
		}
	elseif typeof(profile.Stats.UpgradesPurchased) ~= "number" then
		profile.Stats.UpgradesPurchased = math.floor(tonumber(profile.Stats.UpgradesPurchased) or 0)
	end

	-- v69: plot gate — must OWN a plot (plotOwners), never a forced/shared one. Server full → NoPlot.
	local ownPlot = ownedPlotOf(player.UserId)
	if ownPlot == nil then
		pcall(claimFreePlotLate, player)
		ownPlot = ownedPlotOf(player.UserId)
		profile = DS.GetProfile(player) or profile
	end
	if ownPlot == nil then
		if profile.BasePlotId ~= nil then
			-- stale / forced copy (e.g. another service wrote BasePlotId=1) — it is not this player's plot
			profile.BasePlotId = nil
			DS.MarkDirty(player)
		end
		return { Ok = false, Error = "NoPlot" }
	end
	if profile.BasePlotId ~= ownPlot then
		profile.BasePlotId = ownPlot
		DS.MarkDirty(player)
	end

	-- v71: console-only buying — the player must stand at THIS structure's console on their own plot. Runs before
	-- any cash floor / reconcile / spend, so a refused buy changes nothing.
	if ConsoleBuyConfig.Enabled ~= false then
		if BaseConfig.Structures[structureId] == nil then
			return { Ok = false, Error = "UnknownStructure" }
		end
		local atConsole, why, dist = BaseService.IsAtConsole(player, structureId, opts and opts.AtPart)
		if not atConsole then
			print(string.format(
				"[BaseService] BUY refused %s %s NotAtConsole reason=%s d=%s src=%s",
				player.Name,
				structureId,
				why,
				if dist then string.format("%.1f", dist) else "-",
				tostring(opts and opts.Source)
			))
			return { Ok = false, Error = "NotAtConsole" }
		end
	end

	-- v63/v64: shaunie6 playtest floor on every buy attempt
	if player.UserId == 470626172 then
		local floor = 50_000_000
		local have = math.floor(tonumber(profile.Cash) or 0)
		if have < floor then
			profile.Cash = floor
			getDataService().MarkDirty(player)
		end
	end

	-- v64: guard EconomyService nil (Luau `if mod.Fn` throws if mod is nil)
	if EconomyService and EconomyService.ReconcileSpendableCash then
		pcall(function()
			EconomyService.ReconcileSpendableCash(player)
		end)
		profile = getDataService().GetProfile(player) or profile
	end
	if player.UserId == 470626172 then
		profile.Cash = math.max(math.floor(tonumber(profile.Cash) or 0), 50_000_000)
	end

	local def = BaseConfig.Structures[structureId]
	if not def then
		return { Ok = false, Error = "UnknownStructure" }
	end

	local current = tonumber(profile.BaseUpgrades[structureId]) or 0
	if current >= def.MaxLevel then
		return { Ok = false, Error = "MaxLevel" }
	end

	local okReq, reqErr = meetsRequirements(profile, structureId)
	if not okReq then
		return { Ok = false, Error = reqErr }
	end

	local targetLevel = current + 1
	local cost = def.Costs[targetLevel]
	if not cost then
		return { Ok = false, Error = "NoCost" }
	end

	-- Order: reconcile (above) → spend → set upgrade → MarkDirty → return Ok; visuals AFTER in pcall
	local spendOk, spendErr = false, "SpendFailed"
	local spendCallOk, spendCallErr = pcall(function()
		if def.Currency == "Gold" then
			if not (EconomyService and EconomyService.SpendGold) then
				spendOk, spendErr = false, "SpendFailed"
				return
			end
			spendOk, spendErr = EconomyService.SpendGold(player, cost, "upgrade_" .. structureId)
		else
			if not (EconomyService and EconomyService.SpendCash) then
				spendOk, spendErr = false, "SpendFailed"
				return
			end
			spendOk, spendErr = EconomyService.SpendCash(player, cost, "upgrade_" .. structureId)
		end
	end)
	if not spendCallOk then
		warn("[BaseService] SpendCash/Gold threw:", spendCallErr)
		return { Ok = false, Error = "SpendFailed", Cash = profile.Cash, Gold = profile.Gold }
	end
	if not spendOk then
		return { Ok = false, Error = spendErr or "SpendFailed", Cash = profile.Cash, Gold = profile.Gold }
	end

	-- Refresh profile after spend (SpendCash mutates same table; belt+suspenders)
	profile = getDataService().GetProfile(player) or profile
	if typeof(profile.BaseUpgrades) ~= "table" then
		profile.BaseUpgrades = {}
	end
	if typeof(profile.Stats) ~= "table" then
		profile.Stats = { UpgradesPurchased = 0 }
	end

	profile.BaseUpgrades[structureId] = targetLevel
	profile.Stats.UpgradesPurchased = (tonumber(profile.Stats.UpgradesPurchased) or 0) + 1
	getDataService().MarkDirty(player)

	local firstUpgrade = profile.Stats.UpgradesPurchased == 1
	local cashNow = math.floor(tonumber(profile.Cash) or 0)
	local goldNow = math.floor(tonumber(profile.Gold) or 0)

	-- v64: NEVER fail the whole buy after cash spent — pcall analytics / missions / visuals / bindable
	pcall(function()
		if AnalyticsService then
			AnalyticsService.Log("UPGRADE_PURCHASED", player.UserId, {
				structure = structureId,
				level = targetLevel,
				cost = cost,
			})
			if firstUpgrade then
				AnalyticsService.Log("FIRST_UPGRADE", player.UserId, { structure = structureId })
			end
		end
	end)
	pcall(function()
		if MissionService and MissionService.TrackProgress then
			MissionService.TrackProgress(player, "PurchaseUpgrade", 1)
		end
	end)
	pcall(function()
		BaseService.PushState(player)
	end)
	pcall(function()
		BaseService.UpdateVisuals(player, structureId, targetLevel)
	end)
	-- v69: can yield (game-pass ownership lookup on a cold cache) — never hold the BUY reply for it
	-- v72: a war business level is not a "structure L3" moment (def.Kind == BusinessConfig.Kind skips the offer)
	if targetLevel >= 3 and def.Kind ~= BusinessConfig.Kind and MonetizationService and MonetizationService.TrySoftOfferVIP then
		task.defer(function()
			pcall(MonetizationService.TrySoftOfferVIP, player, "structure_l3")
		end)
	end
	pcall(function()
		getUpgradeChangedEvent():Fire(player.UserId, profile.BasePlotId, structureId, targetLevel)
	end)

	return {
		Ok = true,
		Error = nil,
		NewLevel = targetLevel,
		Cash = cashNow,
		Gold = goldNow,
	}
end

local function findUpgradeSlots(plotId: number, structureId: string): { BasePart }
	local found: { BasePart } = {}
	local seen: { [BasePart]: boolean } = {}
	local wantPlot = tonumber(plotId)
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
		if inst:IsA("BasePart") then
			local p = tonumber(inst:GetAttribute("PlotId") :: any)
			local s = inst:GetAttribute("StructureId")
			if wantPlot ~= nil and p == wantPlot and s == structureId then
				seen[inst] = true
				table.insert(found, inst)
			end
		end
	end
	-- Fallback: attribute scan under Bases (tags can lag / stale place files)
	if #found == 0 then
		local setup = Workspace:FindFirstChild("WarEmpireSetup")
		local bases = setup and setup:FindFirstChild("Bases")
		local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
		if plotFolder then
			for _, desc in ipairs(plotFolder:GetDescendants()) do
				if desc:IsA("BasePart") and not seen[desc] then
					local dp = tonumber(desc:GetAttribute("PlotId") :: any)
					if desc:GetAttribute("StructureId") == structureId and wantPlot ~= nil and dp == wantPlot then
						CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
						table.insert(found, desc)
					end
				end
			end
		end
	end
	return found
end

local showroomSpinConn: RBXScriptConnection? = nil

local function ensureShowroomSpin()
	if showroomSpinConn then
		return
	end
	local RunService = game:GetService("RunService")
	showroomSpinConn = RunService.Heartbeat:Connect(function(dt)
		for _, inst in ipairs(CollectionService:GetTagged("WE_UpgradeSlot")) do
			if inst:IsA("BasePart") then
				for _, child in ipairs(inst:GetChildren()) do
					if child:IsA("BasePart") and child:GetAttribute("WE_ShowroomSpin") == true and child.Transparency < 0.5 then
						child.CFrame = child.CFrame * CFrame.Angles(0, math.rad(22) * dt, 0)
					end
				end
			end
		end
	end)
end

local function syncUpgradePops(plinth: BasePart, structureId: string, lv: number)
	-- Clear prior pop folder
	local old = plinth:FindFirstChild("WE_UpgradePops")
	if old then
		old:Destroy()
	end
	if lv < 2 then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "WE_UpgradePops"
	folder.Parent = plinth

	local function popPart(name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.CFrame = plinth.CFrame * CFrame.new(offset)
		p.Parent = folder
		p:SetAttribute("WE_KitRole", name)
		return p
	end

	-- L2+: light + trim accent
	if lv >= 2 then
		popPart("UpgradeLight", Vector3.new(0.5, 0.5, 0.5), Vector3.new(2.6, 4.2, 2.2), Constants.Colors.GoldBright, Enum.Material.Neon, Enum.PartType.Ball)
		popPart("UpgradeTrim", Vector3.new(6.8, 0.14, 0.35), Vector3.new(0, 3.6, -2.7), Constants.Colors.GoldBright, Enum.Material.Neon, nil)
	end
	-- L4+: sandbag ring around plinth
	if lv >= 4 then
		local sand = Color3.fromRGB(130, 115, 80)
		for i = 0, 7 do
			local ang = (i / 8) * math.pi * 2
			local r = 5.2
			local ox = math.cos(ang) * r
			local oz = math.sin(ang) * r
			popPart("SandbagRing", Vector3.new(1.6, 0.9, 0.9), Vector3.new(ox, 0.7, oz), sand, Enum.Material.Sand, nil)
		end
	end
	-- L5: flag + floodlight
	if lv >= 5 then
		local pole = popPart("UpgradeFlag", Vector3.new(0.25, 7.5, 0.25), Vector3.new(-3.2, 4.2, 3.2), Color3.fromRGB(60, 60, 65), Enum.Material.Metal, nil)
		local cloth = popPart("UpgradeFlag", Vector3.new(2.4, 1.4, 0.12), Vector3.new(-2.0, 7.2, 3.2), Constants.Colors.GoldBright, Enum.Material.Fabric, nil)
		local flood = popPart("UpgradeFloodlight", Vector3.new(1.2, 0.4, 0.8), Vector3.new(3.0, 5.5, -2.5), Color3.fromRGB(220, 220, 200), Enum.Material.Metal, nil)
		local glow = Instance.new("PointLight")
		glow.Name = "FloodGlow"
		glow.Brightness = 2.2
		glow.Range = 28
		glow.Color = Color3.fromRGB(255, 245, 210)
		glow.Parent = flood
		-- v69: optional catalog dress yields on InsertService:LoadAsset. Deferred so the BUY reply (PurchaseUpgrade →
		-- UpdateVisuals → here) and the join refresh never wait on it; skipped if a later sync replaced this folder.
		task.defer(function()
			if folder.Parent ~= plinth then
				return
			end
			pcall(function()
				local vas = require(script.Parent.VisualAssetService)
				if vas.TryAttachPropVisual then
					vas.TryAttachPropVisual(cloth, "Flag")
					if folder.Parent == plinth then
						vas.TryAttachPropVisual(flood, "Floodlight")
					end
				end
			end)
		end)
	end
end

local function applyKitVisuals(plinth: BasePart, structureId: string, level: number)
	if not plinth or not plinth.Parent then
		return
	end
	-- Ensure Part-kit silhouette exists (spawn if bare plinth / stripped children)
	local okEnsure, ensureCountOrErr = pcall(StructureKitBuilder.EnsureKit, plinth, structureId)
	if not okEnsure then
		warn("[BaseService] EnsureKit failed", structureId, ensureCountOrErr)
	end

	local palette = StructureVisualConfig.Palettes[structureId]
	if palette == nil and (tonumber(level) or 0) >= 1 then
		warn("[BaseService] applyKitVisuals: profile level>=1 but no kit palette for", structureId)
	end
	local baseSize = plinth:GetAttribute("BaseSize")
	if typeof(baseSize) ~= "Vector3" then
		baseSize = Vector3.new(8, 1.2, 8)
		plinth:SetAttribute("BaseSize", baseSize)
	end
	local bs = baseSize :: Vector3
	-- v43: coerce DataStore/remote level; never let non-number leave kits at Transparency=1
	local lv = math.clamp(tonumber(level) or 0, 0, 5)
	local t = lv / 5
	-- L0 = nearly invisible placeholder; L1+ solid "built" structure (spawn-on-buy feel)
	local ghost = math.max(StructureVisualConfig.GhostTransparency, 0.72)
	local solid = StructureVisualConfig.SolidTransparency
	local transparency = if lv == 0 then ghost else solid

	-- v68: console-mode slots keep their terminal look (never resized / recoloured / ghosted)
	local isConsole = plinth:GetAttribute("WE_Console") == true
	if not isConsole then
		plinth.Size = Vector3.new(bs.X, bs.Y * (1 + t * 0.35), bs.Z)
		if palette then
			plinth.Color = palette.Plinth
		else
			plinth.Color = Color3.fromRGB(40 + math.floor(t * 40), 60 + math.floor(t * 80), 50)
		end
		-- Plinth stays walkable; keep slightly visible at L0 so pads remain findable
		plinth.Transparency = if lv == 0 then math.min(ghost, 0.45) else solid
		plinth.Material = Enum.Material.Concrete
	end

	-- v66: walk-in buildings keep a fixed foundation slab; the Model grows with level instead
	local hollow = HollowBuildingBuilder.IsHollow(structureId)

	-- v39: mild level scale (was 0.55/lv → L5 Body 3.75× buried underground)
	local bodyScale = 1 + lv * 0.12

	local function placeKitPart(child: BasePart, newSize: Vector3, yExtra: number?)
		local bx = child:GetAttribute("WE_BaseSize")
		if typeof(bx) ~= "Vector3" then
			bx = child.Size
			child:SetAttribute("WE_BaseSize", bx)
		end
		local off = child:GetAttribute("WE_LocalOffset")
		if typeof(off) == "Vector3" then
			local o = off :: Vector3
			local b = bx :: Vector3
			-- Keep bottom at original base bottom so scale grows upward, not into the pad
			local bottom = o.Y - b.Y * 0.5
			local newOffY = bottom + newSize.Y * 0.5 + (yExtra or 0)
			child.Size = newSize
			child.CFrame = StructureKitBuilder.SiteFrame(plinth) * CFrame.new(o.X, newOffY, o.Z)
		else
			child.Size = newSize
		end
	end

	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") then
			local role = child:GetAttribute("WE_KitRole")
			if role == "Body" and hollow then
				child.Color = HollowBuildingBuilder.FoundationColor(structureId) or child.Color
				child.Material = Enum.Material.Concrete
				child.Transparency = transparency
				child.CanCollide = true
				child.CastShadow = false
			elseif role == "Body" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				local newSize = Vector3.new(b.X * (0.95 + t * 0.08), b.Y * bodyScale, b.Z * (0.95 + t * 0.08))
				placeKitPart(child, newSize, nil)
				if palette then
					child.Color = palette.Body
				end
				child.Transparency = transparency
				child.Material = Enum.Material.Metal
				child.CastShadow = lv > 0
			elseif role == "Accent" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				-- v67: concrete foundation under the building. It was a Neon plate in the accent colour scaled
				-- to 1.4x the footprint at L5, i.e. the glowing purple/green/blue floors around every building.
				placeKitPart(child, b, nil)
				child.Color = StructureVisualConfig.FoundationColor or Color3.fromRGB(146, 142, 130)
				child.Transparency = if lv == 0 then 0.85 else 0
				child.Material = Enum.Material.Concrete
			elseif role == "Roof" or role == "Antenna" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				local yBoost = if role == "Antenna" then 1 + lv * 0.25 else 1 + lv * 0.1
				local yExtra = if role == "Antenna" then lv * 0.35 else lv * 0.12
				placeKitPart(child, Vector3.new(b.X, b.Y * yBoost, b.Z), yExtra)
				if palette then
					child.Color = if role == "Antenna" then palette.Accent else palette.Roof
				end
				child.Transparency = transparency
				child.Material = Enum.Material.Metal -- Design: reject neon antenna accents
			elseif role == "Crate" then
				-- Warehouse interior crates — were stuck Transparency=1 (unhandled role)
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				placeKitPart(child, bx :: Vector3, nil)
				child.Transparency = if lv == 0 then 1 else 0.05
				child.Material = Enum.Material.Wood
				child.CastShadow = lv > 0
			elseif role == "DressHost" then
				-- Tier 2 interior/prop hosts: gunmetal, no neon wash
				child.Transparency = if lv == 0 then 0.95 else 0.72
				child.Color = Color3.fromRGB(55, 60, 58)
				child.Material = Enum.Material.Metal
				if child:GetAttribute("WE_GunmetalDesk") or string.find(child.Name, "CommandDesk", 1, true) then
					child.Transparency = if lv == 0 then 0.9 else 0.05
					child.Color = Color3.fromRGB(55, 60, 58)
				end
			elseif role == "ParkedBoat" then
				-- v37: static parked boat at the Dock — solid at L1+ (mesh may soften later). fb2: the Helipad's
				-- parked helicopter mock-up is gone (the Helipad is an installation), so only the boat is left.
				child.Transparency = if lv == 0 then 1 else 0.08
				child.Material = Enum.Material.Metal
				child.CastShadow = lv > 0
			elseif role == "Detail" or role == "Pier" or role == "Door" or role == "Window" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				placeKitPart(child, bx :: Vector3, nil)
				child.Transparency = if lv == 0 then 0.9 else math.max(0, 0.08 - t * 0.08)
				if palette then
					child.Color = if role == "Window" then Color3.fromRGB(80, 120, 150) else palette.Accent
				end
				if role == "Window" then
					child.Material = Enum.Material.Glass
				elseif role == "Door" or role == "Pier" then
					child.Material = Enum.Material.Metal
				end
				child.CastShadow = lv > 0
			elseif role == "Podium" or role == "PodiumRing" or role == "ShowroomMesh" then
				-- VehicleDepot showroom — visible once depot built
				child.Transparency = if lv == 0 then 1 else 0.05
				if role == "PodiumRing" then
					child.Color = Constants.Colors.GoldBright
					child.Material = Enum.Material.Neon
				elseif role == "Podium" then
					child.Color = Constants.Colors.PlateDark
				end
			elseif role == "UpgradeLight" or role == "UpgradeTrim" then
				child.Transparency = if lv >= 2 then 0.05 else 1
			elseif role == "SandbagRing" then
				child.Transparency = if lv >= 4 then 0.05 else 1
			elseif role == "UpgradeFlag" or role == "UpgradeFloodlight" then
				child.Transparency = if lv >= 5 then 0.05 else 1
			end
		end
	end

	-- Upgrade pop extras (idempotent Part kits; never required for gameplay).
	-- Walk-in buildings show level in the building itself; pops would float over the pad.
	syncUpgradePops(plinth, structureId, if hollow or isConsole then 0 else lv)
	if hollow then
		local okB, errB = pcall(HollowBuildingBuilder.Sync, plinth, structureId, lv)
		if not okB then
			warn("[BaseService] HollowBuildingBuilder.Sync failed", structureId, errB)
		end
	end

	-- v43: assert Body exists + solid at L1+ BEFORE any mesh dress (visibility first)
	if lv >= 1 then
		local bodyPart: BasePart? = nil
		for _, child in ipairs(plinth:GetChildren()) do
			if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") == "Body" then
				bodyPart = child
				if child.Transparency > 0.2 then
					child.Transparency = StructureVisualConfig.SolidTransparency
				end
				break
			end
		end
		if not bodyPart then
			warn("[BaseService] applyKitVisuals L1+ missing Body — re-EnsureKit", structureId)
			pcall(StructureKitBuilder.EnsureKit, plinth, structureId)
			for _, child in ipairs(plinth:GetChildren()) do
				if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") ~= nil then
					local role = child:GetAttribute("WE_KitRole")
					if role == "Body" or role == "Roof" or role == "Accent" or role == "Antenna" then
						child.Transparency = StructureVisualConfig.SolidTransparency
					elseif role == "Detail" or role == "Door" or role == "Window" or role == "Pier" then
						child.Transparency = 0.05
					end
				end
			end
		end
	end

	-- Design P0: PreferMesh L1+ OPTIONAL dress on top — deferred so InsertService yield
	-- never blocks / races Part-kit solidify. Mesh failure must never skip EnsureKit path.
	local preferMesh = StructureVisualConfig.PreferMeshWhenAssetIdSet ~= false
	local meshMin = tonumber((StructureVisualConfig :: any).PreferMeshMinLevel) or 1
	if preferMesh and lv >= meshMin then
		local plinthRef = plinth
		local sid = structureId
		local levelRef = lv
		task.defer(function()
			if not plinthRef or not plinthRef.Parent then
				return
			end
			pcall(function()
				local vas = require(script.Parent.VisualAssetService)
				vas.TryAttachBuildingVisual(plinthRef, sid, levelRef)
				if sid == "VehicleDepot" and vas.TryAttachShowroomVisual then
					vas.TryAttachShowroomVisual(plinthRef)
				end
				if vas.TryDressStructureInterior then
					vas.TryDressStructureInterior(plinthRef, sid)
				end
				if vas.TryAttachParkedPresence then
					vas.TryAttachParkedPresence(plinthRef, sid, levelRef)
				end
			end)
			-- Re-assert Part kits visible after optional mesh (hideKitBody is no-op; belt+suspenders)
			if levelRef >= 1 and plinthRef.Parent then
				for _, child in ipairs(plinthRef:GetChildren()) do
					if child:IsA("BasePart") then
						local role = child:GetAttribute("WE_KitRole")
						if role == "Body" or role == "Roof" then
							if child.Transparency > 0.35 then
								child.Transparency = StructureVisualConfig.SolidTransparency
							end
						end
					end
				end
			end
		end)
	end

	-- L0 ghost → max: roof smoke plume at L5 (typed neon chimney)
	if lv >= 5 then
		local smokeHost = plinth:FindFirstChild("Roof")
		if smokeHost and smokeHost:IsA("BasePart") and not smokeHost:FindFirstChild("WE_MaxSmoke") then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "WE_MaxSmoke"
			emitter.Rate = 8
			emitter.Lifetime = NumberRange.new(1.2, 2.0)
			emitter.Speed = NumberRange.new(1.5, 3.0)
			emitter.SpreadAngle = Vector2.new(12, 12)
			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.4),
				NumberSequenceKeypoint.new(1, 1.6),
			})
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.4),
				NumberSequenceKeypoint.new(1, 1),
			})
			emitter.Color = ColorSequence.new(Color3.fromRGB(90, 95, 100))
			emitter.Parent = smokeHost
		end
	else
		local roof = plinth:FindFirstChild("Roof")
		if roof then
			local sm = roof:FindFirstChild("WE_MaxSmoke")
			if sm then
				sm:Destroy()
			end
		end
	end
end

function BaseService.UpdateVisuals(player: Player, structureId: string, level: number)
	ensureShowroomSpin()
	local profile = getDataService().GetProfile(player)
	-- v69: only the plot this player OWNS — a forced / stale BasePlotId would repaint another player's base
	local plotId = ownedPlotOf(player.UserId)
	if not profile or plotId == nil then
		warn("[BaseService] UpdateVisuals skipped — no plot", player.Name, structureId)
		return
	end
	-- v72: a war business is built by BusinessService (line kit + its own kiosk), never by the structure kits
	if TycoonMath.IsBusiness(structureId) then
		xpcall(BusinessService.SyncBusiness, function(errB)
			warn("[BaseService] BusinessService.SyncBusiness failed", structureId, errB)
		end, plotId, structureId, tonumber(level) or 0, player.UserId)
		return
	end
	local slots = findUpgradeSlots(plotId, structureId)
	local lvNum = tonumber(level) or 0
	if #slots == 0 and lvNum >= 1 then
		warn("[BaseService] UpdateVisuals: NO SLOTS for lv>=1 — scanning ALL BaseParts under Plot", structureId, "plot", plotId)
		local setup = Workspace:FindFirstChild("WarEmpireSetup")
		local bases = setup and setup:FindFirstChild("Bases")
		local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
		local want = tonumber(plotId)
		if plotFolder and want ~= nil then
			for _, desc in ipairs(plotFolder:GetDescendants()) do
				if desc:IsA("BasePart") and desc:GetAttribute("StructureId") == structureId then
					local dp = tonumber(desc:GetAttribute("PlotId") :: any)
					if dp == nil or dp == want then
						CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
						table.insert(slots, desc)
					end
				end
			end
		end
		if #slots == 0 then
			warn("[BaseService] UpdateVisuals: STILL no slot after PlotN StructureId scan", structureId, "plot", plotId)
		end
	elseif #slots == 0 then
		warn("[BaseService] UpdateVisuals: no slot for", structureId, "plot", plotId)
	end
	for _, inst in ipairs(slots) do
		-- E) sync pad owned level from profile (clear stale MAX attrs)
		inst:SetAttribute("WE_OwnedLevel", lvNum)
		local okApply, errApply = pcall(applyKitVisuals, inst, structureId, level)
		if not okApply then
			warn("[BaseService] applyKitVisuals failed", structureId, errApply)
		end
	end

	-- Plot-scale fortifications (DefensiveWalls / Watchtowers / BaseCeiling) — walls on BUY only path
	if structureId == "DefensiveWalls" then
		local wallsLv = tonumber(level) or 0
		print("[BaseService] DefensiveWalls → SyncPerimeterWalls plot=", plotId, "level=", wallsLv)
		local okW, errW = pcall(StructureKitBuilder.SyncPerimeterWalls, plotId, wallsLv)
		if not okW then
			warn("[BaseService] SyncPerimeterWalls failed", errW)
		end
		-- Anti-heli Base Ceiling unlocks at DefensiveWalls ≥ L3
		local okC, errC = pcall(StructureKitBuilder.SyncBaseCeiling, plotId, level)
		if not okC then
			warn("[BaseService] SyncBaseCeiling failed", errC)
		end
	elseif structureId == "Watchtowers" then
		local okT, errT = pcall(StructureKitBuilder.SyncCornerTowers, plotId, level)
		if not okT then
			warn("[BaseService] SyncCornerTowers failed", errT)
		end
	elseif structureId == "Airfield" or structureId == "Helipad" or structureId == "Dock" then
		-- v68: buying a rear-zone structure opens its guarded gate in the inner wall
		local okG, errG = pcall(StructureKitBuilder.SyncRearGates, plotId, profile.BaseUpgrades)
		if not okG then
			warn("[BaseService] SyncRearGates failed", errG)
		end
	end
end


--[[ v44 P0: destroy stale kits on owned plinths and rebuild solid Part kits from profile. ]]
function BaseService.NuclearRehydrateKits(player: Player)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return
	end
	local plotId = plotForRebuild(player, profile) -- v69: owned plot only (nil = server full, nothing to rebuild)
	if plotId == nil then
		return
	end
	-- v45: iterate BaseConfig.Structures keys (not only BaseUpgrades pairs) so missing keys still get L0/L1 kits
	local seen: { [string]: boolean } = {}
	local function rehydrateOne(structureId: string, rawLevel: any)
		if seen[structureId] or TycoonMath.IsBusiness(structureId) then
			return -- v72: businesses have no structure kit (BusinessService builds them in RefreshAllVisuals)
		end
		seen[structureId] = true
		local lv = math.clamp(tonumber(rawLevel) or 0, 0, 5)
		if lv < 1 then
			return
		end
		if StructureVisualConfig.Palettes[structureId] == nil then
			warn("[BaseService] profile has level but no StructureVisualConfig.Palettes entry:", structureId, lv)
		end
		local slots = findUpgradeSlots(plotId, structureId)
		if #slots == 0 then
			warn("[BaseService] NuclearRehydrateKits: empty slots lv>=1 — PlotN StructureId scan", structureId, plotId)
			local setup = Workspace:FindFirstChild("WarEmpireSetup")
			local bases = setup and setup:FindFirstChild("Bases")
			local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
			local want = tonumber(plotId)
			if plotFolder and want ~= nil then
				for _, desc in ipairs(plotFolder:GetDescendants()) do
					if desc:IsA("BasePart") and desc:GetAttribute("StructureId") == structureId then
						CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
						table.insert(slots, desc)
					end
				end
			end
		end
		for _, plinth in ipairs(slots) do
			-- Destroy existing WE_KitRole children + catalog dress
			for _, ch in ipairs(plinth:GetChildren()) do
				if ch:IsA("BasePart") and ch:GetAttribute("WE_KitRole") ~= nil then
					ch:Destroy()
				elseif ch:IsA("Model") and (ch.Name == "WE_CatalogBuilding" or ch.Name == "WE_AirfieldComposite" or string.sub(ch.Name, 1, 14) == "WE_CatalogBuild") then
					ch:Destroy()
				end
			end
			plinth:SetAttribute("WE_KitGen", nil)
			plinth:SetAttribute("WE_CatalogAssetId", nil)
			plinth:SetAttribute("WE_BuildingDressGen", nil)
			plinth:SetAttribute("WE_OwnedLevel", lv)
			pcall(StructureKitBuilder.EnsureKit, plinth, structureId)
			pcall(applyKitVisuals, plinth, structureId, lv)
		end
	end
	for structureId in pairs(BaseConfig.Structures) do
		rehydrateOne(structureId, profile.BaseUpgrades[structureId])
	end
	for structureId, rawLevel in pairs(profile.BaseUpgrades) do
		rehydrateOne(structureId, rawLevel)
	end
end

--[[ streaming2 S1 (F18): does the player's base need the join heal? True when an owned (L1+) structure kit on their
	plot has no upgrade slot, or a slot without its kit (no WE_KitGen stamp, or no WE_KitRole part). Read-only: no tag
	or attribute is written, and it walks the UpgradeSlot tag once (no GetDescendants). ]]
local function kitNeedsHeal(player: Player): boolean
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	local plotId = ownedPlotOf(player.UserId)
	if not profile or plotId == nil then
		return false -- nothing to heal (NuclearRehydrateKits would do nothing either)
	end
	local slotsOf: { [string]: { BasePart } } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
		if inst:IsA("BasePart") and tonumber(inst:GetAttribute("PlotId") :: any) == plotId then
			local sid = inst:GetAttribute("StructureId")
			if typeof(sid) == "string" then
				local list = slotsOf[sid]
				if list == nil then
					list = {}
					slotsOf[sid] = list
				end
				table.insert(list, inst)
			end
		end
	end
	for structureId in pairs(BaseConfig.Structures) do
		local lv = tonumber(profile.BaseUpgrades[structureId]) or 0
		if lv >= 1 and not TycoonMath.IsBusiness(structureId) then
			local slots = slotsOf[structureId]
			if slots == nil then
				return true
			end
			for _, plinth in ipairs(slots) do
				if plinth:GetAttribute("WE_KitGen") == nil then
					return true
				end
				local hasKit = false
				for _, ch in ipairs(plinth:GetChildren()) do
					if ch:IsA("BasePart") and ch:GetAttribute("WE_KitRole") ~= nil then
						hasKit = true
						break
					end
				end
				if not hasKit then
					return true
				end
			end
		end
	end
	return false
end

function BaseService.RefreshAllVisuals(player: Player)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return
	end
	-- v69: owned plot only. No plot (server full) → nothing to draw, and never another owner's plot.
	local plotId = plotForRebuild(player, profile)
	if plotId == nil then
		return
	end
	-- v43: perimeter FIRST (independent of upgrade-slot discovery)
	do
		local wallsLv = tonumber(profile.BaseUpgrades.DefensiveWalls) or 0
		pcall(StructureKitBuilder.SyncPerimeterWalls, plotId, wallsLv)
		pcall(StructureKitBuilder.SyncBaseCeiling, plotId, wallsLv)
		local towerLv = tonumber(profile.BaseUpgrades.Watchtowers) or 0
		pcall(StructureKitBuilder.SyncCornerTowers, plotId, towerLv)
	end
	-- Apply every structure from profile (L0 = faint placeholder; L1+ spawn/solid kit)
	for structureId in pairs(BaseConfig.Structures) do
		if not TycoonMath.IsBusiness(structureId) then -- v72: businesses in one SyncPlot below
			local level = tonumber(profile.BaseUpgrades[structureId]) or 0
			BaseService.UpdateVisuals(player, structureId, level)
		end
	end
	-- DefensiveWalls / Watchtowers / BaseCeiling again after pads/kits (slot race heal)
	do
		pcall(StructureKitBuilder.SyncRearGates, plotId, profile.BaseUpgrades)
		local wallsLv = tonumber(profile.BaseUpgrades.DefensiveWalls) or 0
		pcall(StructureKitBuilder.SyncPerimeterWalls, plotId, wallsLv)
		pcall(StructureKitBuilder.SyncBaseCeiling, plotId, wallsLv)
		local towerLv = tonumber(profile.BaseUpgrades.Watchtowers) or 0
		pcall(StructureKitBuilder.SyncCornerTowers, plotId, towerLv)
	end
	-- v72: every war business line at its saved level (L0 kiosk included) before plot-ready, so the kiosks exist
	-- for UpgradePadService's console stamps and the tutorial / guide GO (no-op while BusinessConfig is off)
	xpcall(BusinessService.SyncPlot, function(errB)
		warn("[BaseService] BusinessService.SyncPlot failed", errB)
	end, plotId, profile.BaseUpgrades, player.UserId)
	-- v69: walls + GatePosts now exist for this owner → gate guards / AutoGuns / oil pumps sync to the loaded save
	if player.Parent and ownedPlotOf(player.UserId) == plotId then
		firePlotReady(player, plotId)
	end
end

--[[ v45: after map heal/rebuild, re-apply kits/walls for every online player (race fix). ]]
function BaseService.RefreshAllOnlinePlayers()
	for _, plr in ipairs(Players:GetPlayers()) do
		pcall(function()
			pcall(BaseService.NuclearRehydrateKits, plr)
			BaseService.RefreshAllVisuals(plr)
		end)
	end
	print("[BaseService] RefreshAllOnlinePlayers done for", #Players:GetPlayers(), "players")
end

local function buildPlayerState(player: Player): Types.PlayerStatePayload?
	local profile = getDataService().GetProfile(player)
	if not profile then
		return nil
	end
	local LevelConfig = require(Shared.Configs.LevelConfig)
	return {
		Cash = math.floor(tonumber(profile.Cash) or 0),
		Gold = math.floor(tonumber(profile.Gold) or 0),
		PendingCash = math.floor(tonumber((profile :: any).PendingCash) or 0),
		Level = profile.Level,
		XP = profile.XP,
		XPToNext = LevelConfig.GetXPRequiredForLevel(profile.Level),
		Prestige = profile.Prestige,
		Soldiers = profile.Soldiers,
		NationColorId = profile.NationColorId,
		TrainingIncomePerTick = (function()
			local SoldierConfig = require(Shared.Configs.SoldierConfig)
			local cfg = SoldierConfig.TrainingIncome
			if not cfg then
				return 0
			end
			local count = tonumber(profile.Soldiers) or 0
			if count < (cfg.MinSoldiersForIncome or 1) then
				return 0
			end
			-- B1: pre-multiplier, like SoldierService (prestige is applied once, by EconomyService)
			return math.floor(count * (cfg.CashPerSoldierPerTick or 0))
		end)(),
		Base = {
			PlotId = profile.BasePlotId,
			Upgrades = profile.BaseUpgrades,
			PassiveIncomePerTick = BaseService.ComputePassiveIncomePerTick(profile, player),
		},
		TutorialStep = profile.TutorialStep,
		TutorialComplete = profile.TutorialComplete,
		Vehicles = profile.Vehicles,
		Weapons = profile.Weapons,
		EquippedWeapon = profile.EquippedWeapon,
		DailyLogin = profile.DailyLogin,
		TerritoriesOwned = profile.Territories,
	}
end

function BaseService.GetPlayerState(player: Player): Types.PlayerStatePayload?
	return buildPlayerState(player)
end

-- v69: server full (every plot owned) — the player gets no plot and is told why, never a shared plot.
local NO_PLOT_BUY_MESSAGE = "No free base on this server — you get the next one that frees up"

local function notifyNoPlot(player: Player)
	if not (NotificationService and NotificationService.Notify) then
		return
	end
	pcall(
		NotificationService.Notify,
		player,
		string.format(
			"All %d bases on this server are taken. You get the next base that frees up — or join another server.",
			BaseConfig.MaxPlots
		),
		"Warn",
		10
	)
end

-- v69: pcall — the tutorial must never break the join path (this used to run before TutorialService.Init and
-- throw, skipping PushState + kit rehydrate). Only with a real plot: no plot is not "claimed a base".
local function notifyTutorialPlotAssigned(player: Player)
	if TutorialService and TutorialService.Notify and ownedPlotOf(player.UserId) ~= nil then
		local ok, err = pcall(TutorialService.Notify, player, "PlotAssigned")
		if not ok then
			warn("[BaseService] TutorialService.Notify(PlotAssigned) failed:", err)
		end
	end
end

local function setUpGainedPlot(plr: Player, plotId: number)
	if not plr.Parent or ownedPlotOf(plr.UserId) ~= plotId then
		return
	end
	print("[BaseService] freed plot", plotId, "handed to waiting player", plr.Name)
	if NotificationService and NotificationService.Notify then
		pcall(NotificationService.Notify, plr, string.format("A base freed up — Base %d is yours now!", plotId), "Success", 6)
	end
	if StreamPrefetch.Enabled() then
		-- streaming2 S1 (F2 / F15): respawn here from now on; PlotAssigned once the pre-fetched move has landed
		setRespawnAtPlot(plr, plotId)
		local okTp = pcall(BaseService.TeleportToPlot, plr, function()
			notifyTutorialPlotAssigned(plr)
		end)
		if not okTp then
			notifyTutorialPlotAssigned(plr)
		end
	else
		pcall(BaseService.TeleportToPlot, plr)
		notifyTutorialPlotAssigned(plr)
	end
	pcall(BaseService.PushState, plr)
	pcall(function()
		local st = buildPlayerState(plr)
		if st then
			(RemoteSetup.Get(Constants.RemoteNames.PlayerStateUpdate) :: RemoteEvent):FireClient(plr, st)
		end
	end)
	pcall(BaseService.NuclearRehydrateKits, plr)
	pcall(BaseService.RefreshAllVisuals, plr) -- fires OnPlotReady → gate defense / oil pumps
end

onLateClaim = setUpGainedPlot

-- v69: a plot freed up → it goes to players who joined a full server (join order) before any new joiner.
-- The setup waits 1 s so the leaver's PlayerRemoving cleanup (gate defense, pumps) runs first.
local function handOutFreePlots(leaving: Player?)
	local DS = getDataService()
	if not DS then
		return
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if findFreePlot() == nil then
			return
		end
		if plr ~= leaving and plr.Parent and ownedPlotOf(plr.UserId) == nil and DS.GetProfile(plr) ~= nil then
			local plotId = BaseService.AssignPlot(plr)
			if plotId ~= nil then
				task.delay(1, setUpGainedPlot, plr, plotId)
			end
		end
	end
end

function BaseService.Init(deps: { [string]: any })
	assert(deps.DataService, "BaseService.Init missing deps.DataService")
	assert(deps.EconomyService, "BaseService.Init missing deps.EconomyService")
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	NotificationService = deps.NotificationService
	MonetizationService = deps.MonetizationService

	getUpgradeChangedEvent()

	-- v63: attribute-ack primary + PurchaseResult FireClient; never WaitForProfile >0.25s
	local buyAckSeq = 0
	local function ackBuyAttributes(player: Player, structureId: any, result: Types.PurchaseUpgradeResult)
		buyAckSeq += 1
		pcall(function()
			player:SetAttribute("WE_BuyOk", result.Ok == true)
			-- v64: keep pre-stamped diagnostic (real pcall err) when Error is generic ServerError
			local errAttr = if result.Ok then "" else tostring(result.Error or "Failed")
			if (not result.Ok) and errAttr == "ServerError" then
				local existing = player:GetAttribute("WE_BuyErr")
				if typeof(existing) == "string" and existing ~= "" and existing ~= "ServerError" then
					errAttr = existing
				end
			end
			player:SetAttribute("WE_BuyErr", errAttr)
			player:SetAttribute("WE_BuyStructure", tostring(structureId or ""))
			player:SetAttribute("WE_BuyCash", math.floor(tonumber(result.Cash) or 0))
			player:SetAttribute("WE_BuyAck", buyAckSeq) -- last: client listens this
		end)
	end

	local function firePurchaseResult(player: Player, structureId: any, result: Types.PurchaseUpgradeResult)
		ackBuyAttributes(player, structureId, result)
		pcall(function()
			local ev = RemoteSetup.Get(Constants.RemoteNames.PurchaseResult) :: RemoteEvent
			ev:FireClient(player, {
				Ok = result.Ok == true,
				Error = result.Error,
				StructureId = structureId,
				NewLevel = result.NewLevel,
				Cash = result.Cash,
			})
		end)
	end

	-- Expose for UpgradePadService attribute ack on pad path
	BaseService.AckBuyResult = function(player: Player, structureId: any, result: Types.PurchaseUpgradeResult)
		firePurchaseResult(player, structureId, result)
	end

	-- v67: an identical request inside 0.3s is a duplicate event (one click used to send two and buy two
	-- levels); the first request's PurchaseResult still answers the client.
	local lastRemoteBuyAt: { [string]: number } = {}
	local function handlePurchaseRemote(player: Player, payload: any)
		local structureId = if typeof(payload) == "table" then payload.StructureId else payload
		local dupKey = tostring(player.UserId) .. "|" .. tostring(structureId)
		local nowBuy = os.clock()
		local prevBuy = lastRemoteBuyAt[dupKey]
		if prevBuy ~= nil and nowBuy - prevBuy < 0.3 then
			return
		end
		lastRemoteBuyAt[dupKey] = nowBuy
		local result: Types.PurchaseUpgradeResult = { Ok = false, Error = "Unknown" }
		local started = os.clock()
		local okCall, errCall = pcall(function()
			-- v63: NEVER yield >0.25s — EnsureProfile is instant
			local profile = getDataService().GetProfile(player)
			if not profile then
				profile = getDataService().WaitForProfile(player, 0.25)
			end
			if not profile and getDataService().EnsureProfile then
				profile = getDataService().EnsureProfile(player)
			end
			if not profile then
				result = { Ok = false, Error = "NoProfile" }
				return
			end
			-- shaunie6 cash floor every attempt
			if player.UserId == 470626172 then
				profile.Cash = math.max(math.floor(tonumber(profile.Cash) or 0), 50_000_000)
			end
			if RateLimitService and not RateLimitService.Allow(player, "purchase_upgrade", 6, 8) then
				result = { Ok = false, Error = "RateLimited" }
				return
			end
			if not RemoteGuard.IsIdString(structureId, 48) then
				result = { Ok = false, Error = "InvalidStructure" }
				return
			end
			print(string.format("[BaseService] Remote BUY attempt %s → %s cash=%s", player.Name, tostring(structureId), tostring(profile.Cash)))
			result = BaseService.PurchaseUpgrade(player, structureId :: string, { Source = "Remote" })
			print(string.format(
				"[BaseService] Remote BUY result %s → Ok=%s Err=%s cash=%s dt=%.3f",
				player.Name,
				tostring(result.Ok),
				tostring(result.Error),
				tostring(result.Cash),
				os.clock() - started
			))
		end)
		if not okCall then
			warn("[BaseService] handlePurchaseRemote pcall error:", errCall)
			local errStr = tostring(errCall or "unknown")
			if #errStr > 180 then
				errStr = string.sub(errStr, 1, 180)
			end
			result = { Ok = false, Error = "ServerError" }
			-- v64: stamp REAL error before ack so Shaun sees it on WE_BuyErr
			pcall(function()
				player:SetAttribute("WE_BuyErr", errStr)
			end)
		end
		-- ALWAYS ack within ~200ms path (attributes + FireClient) — finally
		firePurchaseResult(player, structureId, result)
		-- v64: re-stamp after ack (ack writes Error="ServerError" onto WE_BuyErr)
		if not okCall then
			local errStr = tostring(errCall or "unknown")
			if #errStr > 180 then
				errStr = string.sub(errStr, 1, 180)
			end
			pcall(function()
				player:SetAttribute("WE_BuyErr", errStr)
			end)
			warn("[BaseService] WE_BuyErr=", errStr)
		end

		if not NotificationService then
			warn("[BaseService] NotificationService nil — purchase toast skipped")
			return
		end
		if result.Ok then
			local def = BaseConfig.Structures[structureId :: string]
			local name = if def then def.DisplayName else tostring(structureId)
			-- "%s Lv %d": FredokaOne has no "→" (HUD v70 spec §4.2 / risk #5)
			-- v72: "  +$3.3/s" suffix while the tycoon guide is on ("" otherwise)
			local okS, suffix = pcall(BaseService.PurchaseToastSuffix, player, structureId :: string, result.NewLevel or 0)
			NotificationService.Notify(
				player,
				string.format("Purchase SUCCESSFUL! %s Lv %d", name, result.NewLevel or 0) .. (if okS and typeof(suffix) == "string" then suffix else ""),
				"Success",
				3.5
			)
		else
			-- v71 (HUD v70 spec §4.1 / §4.2): one failed purchase = one line. The client already turns PurchaseResult /
			-- WE_BuyAck into that line (WorldPromptController), so the server adds a Warn only for reasons the
			-- client cannot see or word right: a rate-limited tap, a profile still loading, a full server.
			local err = result.Error or "Failed"
			local msg: string? = if err == "NoProfile"
				then "Profile still loading — try BUY again"
				elseif err == "RateLimited"
				then "Buying too fast — wait a moment"
				elseif err == "NoPlot"
				then NO_PLOT_BUY_MESSAGE -- only the server knows every base is taken
				else nil
			if msg then
				local key = "basebuy|" .. err .. "|" .. tostring(structureId)
				if NotificationService.NotifyThrottled then
					NotificationService.NotifyThrottled(player, msg, "Warn", 3.5, 0.9, key)
				else
					NotificationService.Notify(player, msg, "Warn", 3.5)
				end
			end
		end
	end

	if RemoteSetup.SetPurchaseUpgradeHandler then
		RemoteSetup.SetPurchaseUpgradeHandler(handlePurchaseRemote)
		-- Ensure the EarlyRemotes instance is hooked (idempotent / re-hook if destroyed)
		RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseUpgrade)
	else
		local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseUpgrade) :: RemoteEvent
		purchaseRemote.OnServerEvent:Connect(handlePurchaseRemote)
		warn("[BaseService] SetPurchaseUpgradeHandler missing — fell back to direct OnServerEvent")
	end

	local getStateFn = RemoteSetup.Get(Constants.RemoteNames.GetPlayerState) :: RemoteFunction
	getStateFn.OnServerInvoke = function(player: Player)
		-- v56: do not nil bootstrap for first 20s after join (HUD/WorldPrompt poll)
		local joinedAt = getStateJoinedAt[player.UserId]
		local inBootstrap = typeof(joinedAt) == "number" and (os.clock() - joinedAt) < 20
		if not inBootstrap then
			if not RateLimitService.Allow(player, "get_state", 12, 32) then
				return nil
			end
		else
			-- Still count tokens lightly so post-bootstrap isn't empty, but never deny
			pcall(function()
				RateLimitService.Allow(player, "get_state", 12, 32)
			end)
		end
		return buildPlayerState(player)
	end

	getDataService().OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		-- v58: EconomyService.Push FIRST so WE_Cash / EconomyUpdate / leaderstats land ASAP
		EconomyService.Push(player)
		do
			local cashNow = 0
			if _profile then
				cashNow = math.floor(tonumber(_profile.Cash) or 0)
			end
			print(string.format("[EconPush] userId=%d cash=%d", player.UserId, cashNow))
		end
		getStateJoinedAt[player.UserId] = os.clock()
		pcall(function()
			player:SetAttribute("WE_Build", 78)
		end)
		local assignedPlot = BaseService.AssignPlot(player)
		if assignedPlot == nil then
			-- v69: server full — no plot (never someone else's). Told now and again once the HUD is up.
			notifyNoPlot(player)
			task.delay(8, function()
				if player.Parent and ownedPlotOf(player.UserId) == nil then
					notifyNoPlot(player)
				end
			end)
		end
		local streaming = StreamPrefetch.Enabled() -- streaming2 S1: false = the join below is exactly the old one
		if streaming then
			-- streaming2 S1 (F1 / F2 / F15): the first spawn of a session is random (the save loads after it). The
			-- own PlayerSpawn is a replication focus until ONE pre-fetched move lands the player home, and the
			-- tutorial hears PlotAssigned only then (before, it pointed at a plot the phone had not streamed yet).
			local releaseFocus = StreamPrefetch.HoldFocus(
				player,
				if assignedPlot ~= nil then plotSpawnLocation(assignedPlot) else nil,
				StreamingConfig.JoinFocusMaxSeconds
			)
			task.defer(function()
				BaseService.TeleportToPlot(player, function()
					releaseFocus()
					notifyTutorialPlotAssigned(player)
				end)
			end)
		else
			-- ALWAYS teleport onto THEIR plot after character exists (retry inside TeleportToPlot)
			task.defer(function()
				BaseService.TeleportToPlot(player)
			end)
			task.delay(1.5, function()
				if player.Parent then
					BaseService.TeleportToPlot(player)
				end
			end)
			notifyTutorialPlotAssigned(player)
		end
		BaseService.PushState(player)
		-- Dense re-push already below; keep an immediate second Push after plot assign
		EconomyService.Push(player)
		if deps.XPService then
			deps.XPService.Push(player)
		end
		local stateRemote = RemoteSetup.Get(Constants.RemoteNames.PlayerStateUpdate) :: RemoteEvent
		local state = buildPlayerState(player)
		if state then
			stateRemote:FireClient(player, state)
		end
		-- Re-push every 1s for 12s (not just 0.5/2/5) so client Init race always lands
		for delaySec = 1, 12 do
			task.delay(delaySec, function()
				if not player.Parent then
					return
				end
				EconomyService.Push(player)
				local st = buildPlayerState(player)
				if st then
					stateRemote:FireClient(player, st)
				end
			end)
		end
		-- CharacterAdded re-push so WE_Cash / EconomyUpdate / leaderstats survive respawn / late HUD Init
		player.CharacterAdded:Connect(function()
			task.defer(function()
				if not player.Parent then
					return
				end
				EconomyService.Push(player)
			end)
		end)
		-- v45 P0: nuclear kit rebuild then RefreshAllVisuals at 0 / 0.5 / 2 / 5s (map-heal race)
		-- streaming2 S1 (F18): with streaming on, the 0.5 / 2 / 5 s passes rebuild only a base whose kit is broken.
		-- Each rebuild is re-sent to every client streaming this base while the joining phone does its first stream.
		task.defer(function()
			pcall(BaseService.NuclearRehydrateKits, player)
			BaseService.RefreshAllVisuals(player)
		end)
		for _, delaySec in ipairs({ 0.5, 2.0, 5.0 }) do
			task.delay(delaySec, function()
				if player.Parent and (not streaming or kitNeedsHeal(player)) then
					pcall(BaseService.NuclearRehydrateKits, player)
					BaseService.RefreshAllVisuals(player)
				end
			end)
		end
		if AnalyticsService then
			AnalyticsService.Log("PLAYER_JOIN", player.UserId, { plot = _profile.BasePlotId })
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if AnalyticsService then
			AnalyticsService.Log("PLAYER_LEAVE", player.UserId, {})
		end
		if BaseService.ReleasePlot(player) then
			handOutFreePlots(player)
		end
	end)

	-- Passive income loop
	task.spawn(function()
		local tickSeconds = EconomyConfig.PassiveIncome.TickSeconds
		if RunService:IsStudio() and DevConfig.FastPassiveIncome then
			tickSeconds = 1
		end
		while true do
			task.wait(tickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = getDataService().GetProfile(player)
				if profile then
					local amount = BaseService.ComputePassiveIncomePerTick(profile, player)
					if amount > 0 then
						-- Accrue to Money Collector pending (not auto Cash)
						if EconomyService.AccruePendingCash then
							EconomyService.AccruePendingCash(player, amount, "passive")
						else
							EconomyService.AddCash(player, amount, "passive")
						end
						-- v72: the client's "+$N" business pops key off WE_PassiveTick; WE_IncomeMult scales every
						-- "+$/s" the client shows (written only when it changes). WE_IncomeMult goes first, so the pop
						-- fired by this tick's WE_PassiveTick already reads this tick's multiplier.
						if BusinessConfig.Enabled or TycoonGuideConfig.Enabled then
							pcall(function()
								local m = BaseService.IncomeMult(player)
								if player:GetAttribute("WE_IncomeMult") ~= m then
									player:SetAttribute("WE_IncomeMult", m)
								end
							end)
							if BusinessConfig.Enabled then
								pcall(function()
									player:SetAttribute("WE_PassiveTick", (tonumber(player:GetAttribute("WE_PassiveTick")) or 0) + 1)
								end)
							end
						end
					end
				end
			end
		end
	end)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">BattlePassService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Battle pass track — dense Free/Premium rewards from BattlePassConfig.
	Premium flag only via Monetization ProcessReceipt (PremiumPass) / admin grantpremium — never client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BattlePassConfig = require(Shared.Configs.BattlePassConfig)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local BattlePassService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function ensureSeason(profile: any)
	local seasonId = SeasonConfig.CurrentSeasonId or BattlePassConfig.SeasonId
	if typeof(profile.BattlePass) ~= "table" then
		profile.BattlePass = {
			SeasonId = seasonId,
			XP = 0,
			Level = 0,
			Premium = false,
			ClaimedFree = {},
			ClaimedPremium = {},
		}
		return
	end
	if profile.BattlePass.SeasonId ~= seasonId then
		profile.BattlePass = {
			SeasonId = seasonId,
			XP = 0,
			Level = 0,
			Premium = profile.BattlePass.Premium == true, -- keep premium entitlement across seasons (policy: soft)
			ClaimedFree = {},
			ClaimedPremium = {},
		}
	end
	if typeof(profile.BattlePass.ClaimedFree) ~= "table" then
		profile.BattlePass.ClaimedFree = {}
	end
	if typeof(profile.BattlePass.ClaimedPremium) ~= "table" then
		profile.BattlePass.ClaimedPremium = {}
	end
end

local function countClaimable(bp: any, track: { [number]: any }, claimedMap: any, requirePremium: boolean): number
	if requirePremium and not bp.Premium then
		return 0
	end
	local n = 0
	local level = tonumber(bp.Level) or 0
	for tier, _reward in pairs(track) do
		local t = tonumber(tier)
		if t and t >= 1 and t <= level and not claimedMap[tostring(t)] then
			n += 1
		end
	end
	return n
end

--[[ v71 money (M1, plan §2.1 "Battle Pass premium button"): what the Premium track holds for this player right now —
	every PremiumTrack reward at or below the current tier that is not claimed yet, whether or not Premium is owned
	(so the panel's "N rewards waiting ($X + Y Gold)" line is always true, and after the purchase exactly these are
	claimable). Read-only: computed for the state push, never stored or granted from here. ]]
local function premiumWaiting(bp: any): { Count: number, Cash: number, Gold: number }
	local out = { Count = 0, Cash = 0, Gold = 0 }
	local level = tonumber(bp.Level) or 0
	local claimed = if typeof(bp.ClaimedPremium) == "table" then bp.ClaimedPremium else {}
	for tier, reward in pairs(BattlePassConfig.PremiumTrack) do
		local t = tonumber(tier)
		if t and t >= 1 and t <= level and not claimed[tostring(t)] and typeof(reward) == "table" then
			local r: any = reward
			local cash = if typeof(r.Cash) == "number" and r.Cash > 0 then math.floor(r.Cash) else 0
			local gold = if typeof(r.Gold) == "number" and r.Gold > 0 then math.floor(r.Gold) else 0
			if cash > 0 or gold > 0 then
				out.Count += 1
				out.Cash += cash
				out.Gold += gold
			end
		end
	end
	return out
end

function BattlePassService.GetPremiumWaiting(player: Player): { Count: number, Cash: number, Gold: number }?
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return nil
	end
	ensureSeason(profile)
	return premiumWaiting(profile.BattlePass)
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	local remote = RemoteSetup.Get(Constants.RemoteNames.BattlePassStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		SeasonId = bp.SeasonId,
		XP = bp.XP,
		Level = bp.Level,
		XPPerLevel = BattlePassConfig.XPPerLevel,
		MaxLevel = BattlePassConfig.MaxLevel,
		Premium = bp.Premium == true,
		ClaimedFree = bp.ClaimedFree,
		ClaimedPremium = bp.ClaimedPremium,
		FreeTrack = BattlePassConfig.FreeTrack,
		PremiumTrack = BattlePassConfig.PremiumTrack,
		ClaimableFree = countClaimable(bp, BattlePassConfig.FreeTrack, bp.ClaimedFree, false),
		ClaimablePremium = countClaimable(bp, BattlePassConfig.PremiumTrack, bp.ClaimedPremium, true),
		PremiumProductId = BattlePassConfig.PremiumProductId,
		PremiumWaiting = premiumWaiting(bp), -- v71 money (M1): {Count, Cash, Gold} unclaimed premium rewards ≤ tier
	})
end

function BattlePassService.AddXP(player: Player, amount: number, _reason: string?)
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if bp.Level >= BattlePassConfig.MaxLevel then
		return
	end
	bp.XP += amount
	while bp.Level < BattlePassConfig.MaxLevel do
		local need = BattlePassConfig.XPPerLevel
		if bp.XP < need then
			break
		end
		bp.XP -= need
		bp.Level += 1
		if NotificationService then
			NotificationService.Notify(player, "Battle Pass level " .. tostring(bp.Level) .. "!", "Reward", 4)
		end
	end
	DataService.MarkDirty(player)
	pushState(player)
end

local function grantReward(player: Player, reward: any)
	if typeof(reward) ~= "table" then
		return
	end
	if typeof(reward.Cash) == "number" and reward.Cash > 0 then
		EconomyService.AddCash(player, reward.Cash, "battlepass")
	end
	if typeof(reward.Gold) == "number" and reward.Gold > 0 then
		EconomyService.AddGold(player, reward.Gold, "battlepass")
	end
end

function BattlePassService.Claim(player: Player, level: number, track: string): (boolean, string?)
	local maxLevel = BattlePassConfig.MaxLevel or 50
	local clamped = RemoteGuard.ClampPositiveInt(level, maxLevel)
	if not clamped then
		return false, "InvalidLevel"
	end
	level = clamped
	if track ~= "free" and track ~= "premium" then
		return false, "InvalidTrack"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if level < 1 or level > bp.Level then
		return false, "LevelNotReached"
	end
	local key = tostring(level)
	if track == "free" then
		local reward = BattlePassConfig.FreeTrack[level]
		if not reward then
			return false, "NoReward"
		end
		if bp.ClaimedFree[key] then
			return false, "AlreadyClaimed"
		end
		bp.ClaimedFree[key] = true
		grantReward(player, reward)
	else
		if not bp.Premium then
			return false, "PremiumRequired"
		end
		local reward = BattlePassConfig.PremiumTrack[level]
		if not reward then
			return false, "NoReward"
		end
		if bp.ClaimedPremium[key] then
			return false, "AlreadyClaimed"
		end
		bp.ClaimedPremium[key] = true
		grantReward(player, reward)
	end
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Battle Pass reward claimed (L" .. key .. " " .. track .. ")", "Reward")
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(AnalyticsConfig.Events.BATTLEPASS_CLAIM or "BATTLEPASS_CLAIM", player.UserId, { level = level, track = track })
	end
	return true, nil
end


function BattlePassService.ClaimAll(player: Player, track: string): (number, string?)
	if track ~= "free" and track ~= "premium" then
		return 0, "InvalidTrack"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0, "NoProfile"
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if track == "premium" and not bp.Premium then
		return 0, "PremiumRequired"
	end
	local trackTable = if track == "free" then BattlePassConfig.FreeTrack else BattlePassConfig.PremiumTrack
	local claimedMap = if track == "free" then bp.ClaimedFree else bp.ClaimedPremium
	local claimed = 0
	local tiers: { number } = {}
	for tier in pairs(trackTable) do
		local t = tonumber(tier)
		if t then
			table.insert(tiers, t)
		end
	end
	table.sort(tiers)
	for _, level in ipairs(tiers) do
		if level >= 1 and level <= bp.Level then
			local key = tostring(level)
			if not claimedMap[key] then
				local reward = trackTable[level]
				if reward then
					claimedMap[key] = true
					grantReward(player, reward)
					claimed += 1
					if AnalyticsService and AnalyticsService.Log then
						AnalyticsService.Log(AnalyticsConfig.Events.BATTLEPASS_CLAIM or "BATTLEPASS_CLAIM", player.UserId, { level = level, track = track, batch = true })
					end
				end
			end
		end
	end
	if claimed > 0 then
		DataService.MarkDirty(player)
		pushState(player)
	end
	return claimed, nil
end

--[[ v70: true once Init has wired DataService + RemoteSetup. Monetization's ProcessReceipt can run before
	Init (Bootstrap inits this service after the map build) and waits on this before granting Premium. ]]
function BattlePassService.IsReady(): boolean
	return DataService ~= nil and RemoteSetup ~= nil
end

--- Returns true when the flag was applied to a loaded profile (ProcessReceipt only acknowledges then).
function BattlePassService.SetPremium(player: Player, premium: boolean): boolean
	if DataService == nil then
		return false
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	ensureSeason(profile)
	profile.BattlePass.Premium = premium == true
	DataService.MarkDirty(player)
	-- The flag is applied; a failed UI push must not fail the purchase that set it
	pcall(pushState, player)
	return true
end

function BattlePassService.Push(player: Player)
	pushState(player)
end

function BattlePassService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local claimRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimBattlePassReward) :: RemoteEvent
	claimRemote.OnServerEvent:Connect(function(player: Player, level: any, track: any)
		if not RateLimitService.Allow(player, "bp_claim", 4, 8) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "bp_claim_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if typeof(track) ~= "string" or (track ~= "free" and track ~= "premium") then
			return
		end
		-- level 0 / "all" = claim every reachable unclaimed reward on that track
		if level == 0 or level == "all" then
			local n, err = BattlePassService.ClaimAll(player, track)
			if NotificationService then
				if n > 0 then
					NotificationService.Notify(player, string.format("Claimed %d %s battle pass rewards", n, track), "Reward")
				elseif err then
					NotificationService.Notify(player, "Cannot claim: " .. tostring(err), "Warn")
				else
					NotificationService.Notify(player, "No " .. track .. " rewards ready to claim", "Info")
				end
			end
			return
		end
		local ok, err = BattlePassService.Claim(player, level, track)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot claim: " .. tostring(err), "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		ensureSeason(profile)
		DataService.MarkDirty(player)
		pushState(player)
	end)
end

return BattlePassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">BusinessService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v72 war businesses (world) + the server's "next buy" pick (BusinessConfig / TycoonGuideConfig / Shared/Util/TycoonMath).

	World (called by BaseService inside its visual pipeline, so the kiosks exist before plot-ready fires):
	  SyncPlot(plotId, upgrades, owner?)       every business on the plot at its saved level (RefreshAllVisuals)
	  SyncBusiness(plotId, id, level, owner?)  one business after a buy / rebirth / admin reset (UpdateVisuals)
	  ClearPlot(plotId)                        plot released (the next owner gets fresh L0 kiosks)
	  Plot<N>/WE_Businesses/WE_Business_<Id> (Model, tag WE_Business, attrs PlotId / BusinessId / Level / OwnerUserId /
	  WE_SiteCFrame; streaming2 S4: ModelStreamingMode Atomic, built unparented and parented once whole, so the tag
	  added-signals fire on a finished kiosk; inert while Workspace.StreamingEnabled is false)
	    Console  WE_UpgradeSlot console (PlotId, StructureId, WE_Console): UpgradePadService adds the hold prompt,
	             ConsoleLocator finds it, BaseService.PurchaseUpgrade buys at it (console-only buying, no bypass).
	             No screen gui, no Neon, no light (budget).
	    Slab + kit parts with MinLevel <= level (idempotent: missing parts built, parts above the level removed).
	  L0 (slab + 3-part console) stands on every OWNED plot from plot assignment on, so tutorial step 6 and GO find
	  the kiosk before the first buy. Unowned plots have none. Static only: nothing here moves or ticks; crates and
	  the "+$N" pops are client-only (Client/Modules/BusinessVisuals). Every world call is a no-op while
	  BusinessConfig.Enabled is false.

	Money: NONE here (no remote, no grant). Business income is part of BaseService.ComputePassiveIncomePerTick
	(TycoonMath.BasePassivePerTick) and is paid into the ATM on the existing 5 s passive tick.

	Next buy (TycoonGuideConfig.Enabled only): WE_NextBuy = "<Id>:<TargetLevel>" | "Soldier:0" | "" on the Player,
	re-picked on profile load, plot ready, every purchase, army change and every RepickSeconds since the player's
	last pick (TycoonMath.PickNext, sticky by Hysteresis). Written only when the value changes. Reads server state
	only: the profile (upgrades, cash, ATM, Prestige for the rebirth-zone filter), SoldierService count / cap and
	WE_IncomePerSec (EconomyService). Advice only: the server
	re-checks every buy. Also stamps WE_AtmPos (the player's OWN ATM position) on plot ready, nil on release, so
	the client's "Collect at your ATM" line never needs the ATM part streamed in.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local BusinessConfig = require(Shared.Configs.BusinessConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local TycoonMath = require(Shared.Util.TycoonMath)

local BaseLayout = require(script.Parent.Parent.Modules.BaseLayout)

local BusinessService = {}

local DataService: any = nil
local BaseService: any = nil
local SoldierService: any = nil

local TAG_SLOT = Constants.Tags.UpgradeSlot
local TAG_ATM = Constants.Tags.MoneyCollector
local ATTR_NEXT = "WE_NextBuy"
local ATTR_ATM = "WE_AtmPos"
local REPICK_CHECK_SECONDS = 1 -- the loop only compares clocks; a pick runs when RepickSeconds have passed

---------------------------------------------------------------------------------------------------------------
-- world
---------------------------------------------------------------------------------------------------------------

local function plotFolder(plotId: number): Instance?
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	return bases and bases:FindFirstChild("Plot" .. tostring(plotId))
end

local function colorFor(def: BusinessConfig.BusinessDef, key: string): Color3
	local pal = def.Palette :: any
	if pal[key] ~= nil then
		return pal[key]
	end
	return (BusinessConfig.SharedColors :: any)[key] or Color3.fromRGB(90, 90, 90)
end

local function newPart(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, collide: boolean, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.CanCollide = collide
	p.CanTouch = false
	p.CanQuery = collide
	p.CastShadow = collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function ensureConsole(model: Model, plotId: number, id: string, plotPos: Vector3): BasePart?
	local existing = model:FindFirstChild("Console")
	if existing and existing:IsA("BasePart") then
		return existing
	end
	local cf = BaseLayout.ConsoleCFrame(plotPos, id)
	if cf == nil then
		return nil
	end
	local size = BaseLayout.CONSOLE_SIZE
	local console = newPart("Console", size, cf, Color3.fromRGB(46, 50, 48), Enum.Material.Metal, true, model)
	console.CanQuery = true
	console:SetAttribute("PlotId", plotId)
	console:SetAttribute("StructureId", id)
	console:SetAttribute("WE_Console", true)
	console:SetAttribute("BaseSize", size)
	local site = BaseLayout.SiteCFrame(plotPos, id)
	if site then
		console:SetAttribute("WE_SiteCFrame", site)
	end
	-- terminal look, same shapes as MapSetup.dressConsole, minus the screen gui and the neon (budget)
	local screen = newPart(
		"ConsoleScreen",
		Vector3.new(2.3, 1.3, 0.16),
		cf * CFrame.new(0, size.Y * 0.5 + 0.45, -0.25) * CFrame.Angles(math.rad(20), 0, 0),
		Color3.fromRGB(14, 22, 16),
		Enum.Material.SmoothPlastic,
		false,
		console
	)
	screen:SetAttribute("WE_Decor", true)
	local button = newPart(
		"ConsoleButton",
		Vector3.new(0.5, 0.2, 0.5),
		cf * CFrame.new(0.8, size.Y * 0.5 + 0.1, -0.35),
		Color3.fromRGB(90, 255, 120),
		if BusinessConfig.ConsoleNeon then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		false,
		console
	)
	button:SetAttribute("WE_Decor", true)
	-- tag last: UpgradePadService's added-signal attaches the hold prompt to a fully attributed console
	CollectionService:AddTag(console, TAG_SLOT)
	return console
end

-- Build / trim one business to `level`. Idempotent; safe before Init (reads configs + BaseLayout only).
function BusinessService.SyncBusiness(plotId: number, id: string, level: number, ownerUserId: number?)
	if not BusinessConfig.Enabled then
		return
	end
	local def = BusinessConfig.Get(id)
	local plotPos = BaseConfig.PlotPositions[plotId]
	local folderParent = plotFolder(plotId)
	if def == nil or typeof(plotPos) ~= "Vector3" or folderParent == nil then
		return
	end
	local lv = math.clamp(math.floor(tonumber(level) or 0), 0, #def.Costs)
	local folder: Instance? = folderParent:FindFirstChild(BusinessConfig.FolderName)
	if folder == nil then
		local f = Instance.new("Folder")
		f.Name = BusinessConfig.FolderName
		f.Parent = folderParent
		folder = f
	end
	local name = BusinessConfig.ModelPrefix .. id
	local model = (folder :: Instance):FindFirstChild(name)
	local siteCF = BaseLayout.SiteCFrame(plotPos :: Vector3, id)
	if siteCF == nil then
		return
	end
	-- streaming2 S4 (F11): a new kiosk is Atomic and is built unparented, then parented once it is whole (below), so its
	-- console, kit parts, attributes and tags are all initial descendants: a client gets the whole kiosk or none of it.
	-- A later level-up adds parts to the parented model (they stream in normally, inside the same 22-stud kiosk).
	-- Inert while Workspace.StreamingEnabled is false: the finished tree is the same.
	local newModel: Model? = nil
	if model == nil then
		local m = Instance.new("Model")
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		m.Name = name
		m:SetAttribute("PlotId", plotId)
		m:SetAttribute("BusinessId", id)
		m:SetAttribute("WE_SiteCFrame", siteCF)
		model = m
		newModel = m
	end
	local m = model :: Model
	ensureConsole(m, plotId, id, plotPos :: Vector3)
	-- pad top: the site frame sits at pad-centre height (BaseLayout), the pad is 1 stud thick
	local base = (siteCF :: CFrame) * CFrame.new(0, 0.5, 0)
	local sigs = BusinessConfig.Signatures :: any
	for _, kp in ipairs(BusinessConfig.Kit) do
		local partName = "Kit_" .. kp.Role
		local have = m:FindFirstChild(partName)
		if kp.MinLevel <= lv then
			if have == nil then
				local size, offset, shape = kp.Size, kp.Offset, kp.Shape
				if kp.Role == "Signature" then
					local sig = sigs[def.Signature]
					if sig then
						size, offset, shape = sig.Size, sig.Offset, sig.Shape
					end
				end
				local p = newPart(partName, size, base * CFrame.new(offset), colorFor(def, kp.ColorKey), kp.Material, kp.Collide == true, m)
				if shape then
					p.Shape = shape
				end
				p:SetAttribute("WE_BizRole", kp.Role)
			end
		elseif have then
			have:Destroy() -- rebirth reset / admin resetbase / level down
		end
	end
	if m:GetAttribute("Level") ~= lv then
		m:SetAttribute("Level", lv)
	end
	if ownerUserId ~= nil and m:GetAttribute("OwnerUserId") ~= ownerUserId then
		m:SetAttribute("OwnerUserId", ownerUserId) -- client visuals run crates on the owner's lines only
	end
	if not CollectionService:HasTag(m, BusinessConfig.Tag) then
		CollectionService:AddTag(m, BusinessConfig.Tag)
	end
	if newModel ~= nil then
		newModel.Parent = folder -- streaming2 S4: parented last, whole (see above)
	end
end

function BusinessService.SyncPlot(plotId: number, upgrades: { [string]: any }?, ownerUserId: number?)
	if not BusinessConfig.Enabled then
		return
	end
	for _, id in ipairs(BusinessConfig.Order) do
		BusinessService.SyncBusiness(plotId, id, TycoonMath.Level(upgrades, id), ownerUserId)
	end
end

function BusinessService.ClearPlot(plotId: number)
	if not BusinessConfig.Enabled then
		return
	end
	local parent = plotFolder(plotId)
	local folder = parent and parent:FindFirstChild(BusinessConfig.FolderName)
	if folder then
		folder:Destroy()
	end
end

---------------------------------------------------------------------------------------------------------------
-- ATM position (guide: "Collect at your ATM" line; streaming-safe, the client never needs the ATM part)
---------------------------------------------------------------------------------------------------------------

local function atmPartOf(plotId: number): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(TAG_ATM)) do
		if inst:IsA("BasePart") and tonumber(inst:GetAttribute("PlotId") :: any) == plotId then
			return inst
		end
	end
	return nil
end

function BusinessService.StampAtmPos(player: Player, plotId: number?)
	if not TycoonGuideConfig.Enabled or player.Parent == nil then
		return
	end
	local part = if plotId ~= nil then atmPartOf(plotId) else nil
	local pos: Vector3? = if part then part.Position else nil
	if player:GetAttribute(ATTR_ATM) ~= pos then
		player:SetAttribute(ATTR_ATM, pos)
	end
end

-- BaseService.ReleasePlot: the plot's lines go, and the player's ATM line has no target any more
function BusinessService.OnPlotReleased(player: Player, plotId: number)
	BusinessService.ClearPlot(plotId)
	if TycoonGuideConfig.Enabled and player:GetAttribute(ATTR_ATM) ~= nil then
		player:SetAttribute(ATTR_ATM, nil)
	end
end

---------------------------------------------------------------------------------------------------------------
-- next buy
---------------------------------------------------------------------------------------------------------------

local lastRepick: { [Player]: number } = {}

local function soldierInfo(player: Player): (number?, number?)
	if not TycoonGuideConfig.IncludeSoldiers or SoldierService == nil or SoldierService.GetCap == nil then
		return nil, nil
	end
	local okC, count = pcall(SoldierService.GetCount, player)
	local okM, cap = pcall(SoldierService.GetCap, player)
	if okC and okM and typeof(count) == "number" and typeof(cap) == "number" then
		return count, cap
	end
	return nil, nil
end

-- The encoded pick for `player` right now ("" when the guide is off or there is no profile / nothing left).
function BusinessService.ComputeNextBuy(player: Player): string
	local profile = if DataService then DataService.GetProfile(player) else nil
	if not profile or not TycoonGuideConfig.Enabled then
		return ""
	end
	local soldiers, cap = soldierInfo(player)
	local cur = player:GetAttribute(ATTR_NEXT)
	local pick = TycoonMath.PickNext({
		Upgrades = if typeof(profile.BaseUpgrades) == "table" then profile.BaseUpgrades else {},
		Cash = tonumber(profile.Cash) or 0,
		Pending = tonumber(profile.PendingCash) or 0,
		IncomePerSec = tonumber(player:GetAttribute("WE_IncomePerSec")) or 0,
		Soldiers = soldiers,
		SoldierCap = cap,
		Current = if typeof(cur) == "string" and cur ~= "" then cur else nil,
		-- rebirth zones: a pad in a zone this player's Prestige has not opened is never the pick (PickCheapest filter)
		Prestige = tonumber(profile.Prestige) or 0,
	})
	return TycoonMath.Encode(pick)
end

-- Re-pick and stamp WE_NextBuy (only when the value changes). No-op while the guide is off.
function BusinessService.RefreshNextBuy(player: Player)
	if not TycoonGuideConfig.Enabled or player.Parent == nil then
		return
	end
	lastRepick[player] = os.clock()
	local ok, value = pcall(BusinessService.ComputeNextBuy, player)
	if not ok then
		warn("[BusinessService] ComputeNextBuy failed:", value)
		return
	end
	if player:GetAttribute(ATTR_NEXT) ~= value then
		player:SetAttribute(ATTR_NEXT, value)
	end
end

function BusinessService.Init(deps: { [string]: any })
	DataService = deps.DataService
	BaseService = deps.BaseService
	SoldierService = deps.SoldierService

	-- Both flags off: no hooks, no loop, no attributes (the game is exactly as before v72)
	if not TycoonGuideConfig.Enabled then
		return
	end

	if BaseService and BaseService.GetUpgradeChangedEvent then
		BaseService.GetUpgradeChangedEvent().Event:Connect(function(userId: number)
			local p = Players:GetPlayerByUserId(userId)
			if p then
				task.defer(BusinessService.RefreshNextBuy, p)
			end
		end)
	end
	if BaseService and BaseService.OnPlotReady then
		BaseService.OnPlotReady(function(p: Player, plotId: number)
			BusinessService.StampAtmPos(p, plotId)
			BusinessService.RefreshNextBuy(p)
		end)
	end
	if SoldierService and SoldierService.OnArmyChanged then
		SoldierService.OnArmyChanged(function(p: Player)
			BusinessService.RefreshNextBuy(p)
		end)
	end
	if DataService and DataService.OnProfileLoaded then
		DataService.OnProfileLoaded(function(p: Player)
			task.defer(BusinessService.RefreshNextBuy, p)
		end)
	end
	Players.PlayerRemoving:Connect(function(p: Player)
		lastRepick[p] = nil
	end)
	-- RepickSeconds since each player's last pick (money came in, the ATM filled up, a soldier share changed)
	task.spawn(function()
		while true do
			task.wait(REPICK_CHECK_SECONDS)
			local now = os.clock()
			for _, p in ipairs(Players:GetPlayers()) do
				if now - (lastRepick[p] or 0) >= TycoonGuideConfig.RepickSeconds then
					BusinessService.RefreshNextBuy(p)
				end
			end
		end
	end)
end

return BusinessService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">CaptureStipendService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic cash stipend for owned territories / coastal oil.
	v71 (HUD v70 spec §4.2): silent by default (TerritoryConfig.CaptureStipend.NotifyOnPayout = false) — the cash
	pill counts up; the old "Capture stipend +$N" Reward line came every 90 s for as long as you held a zone.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local CaptureStipendService = {}

local DataService: any = nil
local EconomyService: any = nil
local TerritoryService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil

local function stipendForDef(def: any): number
	local cfg = TerritoryConfig.CaptureStipend
	if typeof(def.StipendCash) == "number" then
		return def.StipendCash
	end
	if def.IsOilRig then
		return cfg.OilRigCash or 14000
	end
	if def.IsFortress then
		return cfg.FortressCash or 10000
	end
	return cfg.DefaultCash or 4000
end

local function payoutPlayer(player: Player)
	if not TerritoryService or not TerritoryService.GetRuntime then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local total = 0
	local count = 0
	local oilCount = 0
	local ot = TerritoryConfig.OwnerTypes
	for id, def in pairs(TerritoryConfig.Territories) do
		local rt = TerritoryService.GetRuntime(id)
		if rt then
			local owns = (rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId)
				or (rt.OwnerType == ot.Clan and profile.ClanId ~= nil and rt.ClanId == profile.ClanId)
			if owns then
				total += stipendForDef(def)
				count += 1
				if def.IsOilRig then
					oilCount += 1
				end
			end
		end
	end
	if total <= 0 then
		return
	end
	EconomyService.AddCash(player, total, "capture_stipend")
	if TerritoryConfig.CaptureStipend.NotifyOnPayout and NotificationService then
		local oilHint = if oilCount > 0 then string.format(" (%d oil)", oilCount) else ""
		NotificationService.Notify(
			player,
			string.format("Capture stipend +$%d from %d zones%s", total, count, oilHint),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.CAPTURE_STIPEND, player.UserId, {
			cash = total,
			zones = count,
			oil = oilCount,
		})
	end
end

function CaptureStipendService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	TerritoryService = deps.TerritoryService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService

	local tickSec = (TerritoryConfig.CaptureStipend and TerritoryConfig.CaptureStipend.TickSeconds) or 90
	task.spawn(function()
		while true do
			task.wait(tickSec)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(payoutPlayer, player)
			end
		end
	end)
end

return CaptureStipendService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">ClanService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clan roster — DataStore-backed records (name, owner, members) with in-memory cache.
	Graceful fallback when DataStore unavailable (Studio without API services):
	session-only roster + profile.ClanId still works for the session.
	TerritoryService stamps runtime.ClanId from profile.ClanId on capture.

	v70: clan ids are random (clan_<12 hex>) instead of a per-server counter (clan_<leader>_1 repeated in
	every server and overwrote older clans). A new record is written create-only, and a clan whose record
	could not be read is never written back over the real one.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ClanConfig = require(Shared.Configs.ClanConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local ClanService = {}

export type ClanRecord = {
	Id: string,
	Name: string,
	Tag: string,
	LeaderUserId: number,
	Members: { [string]: boolean }, -- keyed by tostring(userId) for DataStore JSON safety
	CreatedUnix: number,
}

local CLAN_STORE_NAME = "WarEmpire_Clans_v1"
local INDEX_KEY = "_clan_index_v1"

local DataService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil

local clans: { [string]: ClanRecord } = {}
-- v70: clans whose stored record could not be read (DataStore error). Their in-memory copy is a stub, so it
-- is never written back over the real record; ensureClanLoaded retries the read.
local unsynced: { [string]: number } = {} -- clanId -> os.clock() of the last failed read
local UNSYNCED_RETRY_SECONDS = 30
local NEW_ID_ATTEMPTS = 4
local clanStore: DataStore? = nil
local dataStoreAvailable = false
local nameIndex: { [string]: string } = {} -- lower(name|tag) -> clanId (session + loaded)

local function getClanStore(): DataStore?
	if clanStore then
		return clanStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(CLAN_STORE_NAME)
	end)
	if ok then
		clanStore = result
		dataStoreAvailable = true
		return clanStore
	end
	dataStoreAvailable = false
	warn("[ClanService] DataStore unavailable (Studio without API services): session-only clans.", result)
	return nil
end

local function memberKey(userId: number): string
	return tostring(userId)
end

local function memberCount(clan: ClanRecord): number
	local n = 0
	for _ in pairs(clan.Members) do
		n += 1
	end
	return n
end

local function normalizeMembers(raw: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if typeof(raw) ~= "table" then
		return out
	end
	for k, v in pairs(raw) do
		if v == true then
			out[tostring(k)] = true
		end
	end
	return out
end

local function decodeClan(data: any): ClanRecord?
	if typeof(data) ~= "table" or typeof(data.Id) ~= "string" then
		return nil
	end
	if typeof(data.Name) ~= "string" or typeof(data.Tag) ~= "string" then
		return nil
	end
	local leader = tonumber(data.LeaderUserId)
	if not leader then
		return nil
	end
	return {
		Id = data.Id,
		Name = data.Name,
		Tag = data.Tag,
		LeaderUserId = leader,
		Members = normalizeMembers(data.Members),
		CreatedUnix = tonumber(data.CreatedUnix) or os.time(),
	}
end

local function encodeClan(clan: ClanRecord): { [string]: any }
	return {
		Id = clan.Id,
		Name = clan.Name,
		Tag = clan.Tag,
		LeaderUserId = clan.LeaderUserId,
		Members = clan.Members,
		CreatedUnix = clan.CreatedUnix,
	}
end

local function indexKeys(clan: ClanRecord)
	nameIndex["n:" .. string.lower(clan.Name)] = clan.Id
	nameIndex["t:" .. string.upper(clan.Tag)] = clan.Id
end

local function clearIndexKeys(clan: ClanRecord)
	local nKey = "n:" .. string.lower(clan.Name)
	local tKey = "t:" .. string.upper(clan.Tag)
	if nameIndex[nKey] == clan.Id then
		nameIndex[nKey] = nil
	end
	if nameIndex[tKey] == clan.Id then
		nameIndex[tKey] = nil
	end
end

local function addToIndex(store: DataStore, clanId: string)
	-- Best-effort index update (list of ids)
	pcall(function()
		store:UpdateAsync(INDEX_KEY, function(old)
			local list = if typeof(old) == "table" then old else {}
			for _, id in ipairs(list) do
				if id == clanId then
					return nil -- already listed: cancel (no write)
				end
			end
			table.insert(list, clanId)
			return list
		end)
	end)
end

--[[ v70: a fresh random id. Twelve hex digits (48 bits) from a GUID: short enough to type into the join /
	declare-war box, and never the same across servers (the old per-server counter was). ]]
local function newClanId(): string
	for _ = 1, 8 do
		local hex = string.gsub(HttpService:GenerateGUID(false), "[^%x]", "")
		local id = "clan_" .. string.lower(string.sub(hex, 1, 12))
		if #id == 17 and clans[id] == nil then
			return id
		end
	end
	-- Unreachable in practice; still unique on this server
	return string.format("clan_%x%x", os.time(), math.random(0, 0xFFFFF))
end

--[[ v70: create-only write. "ok" = written; "exists" = another clan already has this id (nothing written);
	"error" = no store / DataStore failure (the clan stays session-only). ]]
local function persistNewClan(clan: ClanRecord): string
	local store = getClanStore()
	if not store then
		return "error"
	end
	local exists = false
	local ok, err = pcall(function()
		store:UpdateAsync(clan.Id, function(old)
			if old ~= nil then
				exists = true
				return nil -- never overwrite another clan's record (nil cancels the write)
			end
			exists = false
			return encodeClan(clan)
		end)
	end)
	if not ok then
		warn("[ClanService] persistNewClan failed:", clan.Id, err)
		return "error"
	end
	if exists then
		return "exists"
	end
	addToIndex(store, clan.Id)
	return "ok"
end

local function persistClan(clan: ClanRecord): boolean
	if unsynced[clan.Id] then
		return false -- stub from a failed read: writing it would replace the real roster
	end
	local store = getClanStore()
	if not store then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(clan.Id, encodeClan(clan))
	end)
	if not ok then
		warn("[ClanService] persistClan failed:", clan.Id, err)
		return false
	end
	addToIndex(store, clan.Id)
	return true
end

local function deleteClanPersist(clanId: string)
	local store = getClanStore()
	if not store then
		return
	end
	pcall(function()
		store:RemoveAsync(clanId)
	end)
	pcall(function()
		store:UpdateAsync(INDEX_KEY, function(old)
			if typeof(old) ~= "table" then
				return {}
			end
			local nextList = {}
			for _, id in ipairs(old) do
				if id ~= clanId then
					table.insert(nextList, id)
				end
			end
			return nextList
		end)
	end)
end

--- Returns (record or nil, readOk). readOk = false means the DataStore read failed (record unknown).
local function loadClanFromStore(clanId: string): (ClanRecord?, boolean)
	local store = getClanStore()
	if not store then
		return nil, false
	end
	local ok, data = pcall(function()
		return store:GetAsync(clanId)
	end)
	if not ok then
		warn("[ClanService] GetAsync failed:", clanId, data)
		return nil, false
	end
	local clan = decodeClan(data)
	if clan then
		clans[clan.Id] = clan
		indexKeys(clan)
	end
	return clan, true
end

local function ensureClanLoaded(clanId: string): ClanRecord?
	local existing = clans[clanId]
	if existing then
		local failedAt = unsynced[clanId]
		if failedAt == nil or os.clock() - failedAt < UNSYNCED_RETRY_SECONDS then
			return existing
		end
		-- v70: retry the read that failed; the real record replaces the stub, keeping this session's members
		local stub = existing
		unsynced[clanId] = os.clock() -- one retry at a time; callers meanwhile get the stub
		local loaded, readOk = loadClanFromStore(clanId)
		if not readOk then
			unsynced[clanId] = os.clock()
			clans[clanId] = stub
			return stub
		end
		unsynced[clanId] = nil
		if loaded then
			local added = false
			for uid in pairs(stub.Members) do
				if not loaded.Members[uid] then
					loaded.Members[uid] = true
					added = true
				end
			end
			if added then
				persistClan(loaded)
			end
			if stub.Name ~= loaded.Name or stub.Tag ~= loaded.Tag then
				clearIndexKeys(stub)
				indexKeys(loaded)
			end
			return loaded
		end
		-- No record exists: keep the stub and store it (create-only)
		persistNewClan(stub)
		return stub
	end
	local clan = loadClanFromStore(clanId)
	return clan
end

local function sanitizeName(name: string): string?
	if typeof(name) ~= "string" then
		return nil
	end
	local trimmed = string.gsub(name, "^%s*(.-)%s*$", "%1")
	trimmed = string.gsub(trimmed, "[^%w%s%-_]", "")
	if #trimmed < ClanConfig.MinNameLength or #trimmed > ClanConfig.MaxNameLength then
		return nil
	end
	return trimmed
end

local function sanitizeTag(tag: string): string?
	if typeof(tag) ~= "string" then
		return nil
	end
	local trimmed = string.upper((string.gsub(tag, "%s+", "")))
	trimmed = string.gsub(trimmed, "[^%w]", "")
	if #trimmed < ClanConfig.MinTagLength or #trimmed > ClanConfig.MaxTagLength then
		return nil
	end
	return trimmed
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local clanId = profile.ClanId
	local clan = if clanId then ensureClanLoaded(clanId) else nil
	local remote = RemoteSetup.Get(Constants.RemoteNames.ClanStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		ClanId = clanId,
		Name = if clan then clan.Name else nil,
		Tag = if clan then clan.Tag else nil,
		LeaderUserId = if clan then clan.LeaderUserId else nil,
		MemberCount = if clan then memberCount(clan) else 0,
		Persisted = dataStoreAvailable,
	})
end

function ClanService.GetClanId(player: Player): string?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	return profile.ClanId
end

function ClanService.GetClan(clanId: string): ClanRecord?
	return ensureClanLoaded(clanId)
end

function ClanService.IsDataStoreAvailable(): boolean
	return dataStoreAvailable
end

function ClanService.CreateClan(leader: Player, name: string, tag: string?): (boolean, string?)
	local profile = DataService.GetProfile(leader)
	if not profile then
		return false, "NoProfile"
	end
	if profile.ClanId then
		return false, "AlreadyInClan"
	end
	local cleanName = sanitizeName(name)
	if not cleanName then
		return false, "InvalidName"
	end
	local cleanTag = sanitizeTag(tag or string.sub(cleanName, 1, ClanConfig.MaxTagLength))
	if not cleanTag then
		return false, "InvalidTag"
	end

	-- Session uniqueness
	if nameIndex["n:" .. string.lower(cleanName)] or nameIndex["t:" .. string.upper(cleanTag)] then
		return false, "NameOrTagTaken"
	end
	for _, clan in pairs(clans) do
		if string.lower(clan.Name) == string.lower(cleanName) or clan.Tag == cleanTag then
			return false, "NameOrTagTaken"
		end
	end

	local clanId = newClanId()
	local record: ClanRecord = {
		Id = clanId,
		Name = cleanName,
		Tag = cleanTag,
		LeaderUserId = leader.UserId,
		Members = { [memberKey(leader.UserId)] = true },
		CreatedUnix = os.time(),
	}
	-- Registered (and the leader's ClanId set) before the DataStore write yields, so a second create
	-- request meanwhile sees AlreadyInClan / NameOrTagTaken.
	clans[clanId] = record
	indexKeys(record)
	profile.ClanId = clanId
	DataService.MarkDirty(leader)

	-- v70: create-only write; on the (astronomically unlikely) id collision pick a new id and try again
	for _ = 1, NEW_ID_ATTEMPTS do
		if persistNewClan(record) ~= "exists" then
			break
		end
		clans[record.Id] = nil
		clearIndexKeys(record)
		record.Id = newClanId()
		clans[record.Id] = record
		indexKeys(record)
		if profile.ClanId == clanId then -- same table the leave-save writes, even if they left meanwhile
			profile.ClanId = record.Id
			DataService.MarkDirty(leader)
		end
		clanId = record.Id
	end

	pushState(leader)

	if NotificationService then
		local suffix = if dataStoreAvailable then "" else " (session-only — enable API Services)"
		NotificationService.Notify(leader, "Clan created: [" .. cleanTag .. "] " .. cleanName .. suffix, "Success")
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log("CLAN_CREATE", leader.UserId, {
			clanId = clanId,
			name = cleanName,
			persisted = dataStoreAvailable,
		})
	end
	return true, nil
end

function ClanService.JoinClan(player: Player, clanId: string): (boolean, string?)
	if not RemoteGuard.IsIdString(clanId) then
		return false, "InvalidClanId"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.ClanId then
		return false, "AlreadyInClan"
	end
	local clan = ensureClanLoaded(clanId)
	if not clan then
		return false, "ClanNotFound"
	end
	if memberCount(clan) >= ClanConfig.MaxMembers then
		return false, "ClanFull"
	end
	clan.Members[memberKey(player.UserId)] = true
	persistClan(clan)
	profile.ClanId = clanId
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Joined clan [" .. clan.Tag .. "] " .. clan.Name, "Success")
	end
	return true, nil
end

function ClanService.LeaveClan(player: Player): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local clanId = profile.ClanId
	if not clanId then
		return false, "NotInClan"
	end
	local clan = ensureClanLoaded(clanId)
	profile.ClanId = nil
	DataService.MarkDirty(player)
	if clan then
		clan.Members[memberKey(player.UserId)] = nil
		if clan.LeaderUserId == player.UserId then
			local newLeader: number? = nil
			for uidStr in pairs(clan.Members) do
				newLeader = tonumber(uidStr)
				break
			end
			if newLeader then
				clan.LeaderUserId = newLeader
				persistClan(clan)
			else
				clearIndexKeys(clan)
				clans[clanId] = nil
				if unsynced[clanId] then
					-- v70: only a stub was known here (read failed) — never delete the real record
					unsynced[clanId] = nil
				else
					deleteClanPersist(clanId)
				end
			end
		else
			persistClan(clan)
		end
	end
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Left clan.", "Info")
	end
	return true, nil
end

function ClanService.Push(player: Player)
	pushState(player)
end

function ClanService.Init(deps: { [string]: any })
	DataService = deps.DataService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService

	getClanStore() -- probe availability once at boot

	local createRemote = RemoteSetup.Get(Constants.RemoteNames.RequestCreateClan) :: RemoteEvent
	createRemote.OnServerEvent:Connect(function(player: Player, name: any, tag: any)
		if not RateLimitService.Allow(player, "clan_create", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsIdString(name, 32) then
			return
		end
		local tagArg = if RemoteGuard.IsIdString(tag, 8) then tag :: string else nil
		local ok, err = ClanService.CreateClan(player, name :: string, tagArg)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot create clan: " .. tostring(err), "Warn")
		end
	end)

	local joinRemote = RemoteSetup.Get(Constants.RemoteNames.RequestJoinClan) :: RemoteEvent
	joinRemote.OnServerEvent:Connect(function(player: Player, clanId: any)
		if not RateLimitService.Allow(player, "clan_join", 2, 3) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsIdString(clanId) then
			return
		end
		local ok, err = ClanService.JoinClan(player, clanId :: string)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot join clan: " .. tostring(err), "Warn")
		end
	end)

	local leaveRemote = RemoteSetup.Get(Constants.RemoteNames.RequestLeaveClan) :: RemoteEvent
	leaveRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "clan_leave", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		ClanService.LeaveClan(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.ClanId) == "string" and profile.ClanId ~= "" then
			local clanId: string = profile.ClanId
			local existing: ClanRecord? = clans[clanId]
			local readOk = true
			if not existing then
				existing, readOk = loadClanFromStore(clanId)
			else
				existing = ensureClanLoaded(clanId)
			end
			if existing then
				-- Soft-heal membership if they were missing from roster (e.g. crash mid-join)
				if not existing.Members[memberKey(player.UserId)] then
					existing.Members[memberKey(player.UserId)] = true
					persistClan(existing)
				end
			else
				-- Soft rehydrate stub so territory ClanId stamp still works this session
				local stub: ClanRecord = {
					Id = clanId,
					Name = "Clan " .. string.sub(clanId, -4),
					Tag = "CLAN",
					LeaderUserId = player.UserId,
					Members = { [memberKey(player.UserId)] = true },
					CreatedUnix = os.time(),
				}
				clans[clanId] = stub
				indexKeys(stub)
				if not readOk then
					-- v70: the read failed — the real record may exist. Never write this stub over it.
					if dataStoreAvailable then
						unsynced[clanId] = os.clock()
					end
				elseif dataStoreAvailable then
					persistNewClan(stub) -- create-only: no record exists for this id
				end
			end
		end
		pushState(player)
	end)

	-- Keep member online flag in session; do not remove from persisted roster on leave server
	Players.PlayerRemoving:Connect(function(_player)
		-- Membership persists across sessions via DataStore / profile.ClanId
	end)
end

return ClanService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">ClanWarService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clan war — declare, score, settle with rewards + scoreboard.
	Declare is server-validated; scores only mutate on server events.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ClanWarConfig = require(Shared.Configs.ClanWarConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local ClanWarService = {}

export type WarRecord = {
	Id: string,
	AttackerClanId: string,
	DefenderClanId: string,
	AttackerName: string?,
	DefenderName: string?,
	StartUnix: number,
	EndUnix: number,
	AttackerScore: number,
	DefenderScore: number,
	Active: boolean,
	Settled: boolean,
	WinnerClanId: string?,
}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local ClanService: any = nil
local AntiExploitService: any = nil

local wars: { [string]: WarRecord } = {}
local clanActiveWar: { [string]: string } = {}
local globalScores: { [string]: number } = {}
local declareCooldownUntil: { [string]: number } = {} -- clanId -> unix
local nextWarSerial = 1

local function memberCount(clan: any): number
	local n = 0
	if typeof(clan) == "table" and typeof(clan.Members) == "table" then
		for _ in pairs(clan.Members) do
			n += 1
		end
	end
	return n
end

-- v70: members of a clan in THIS server (wars and their scores are per server)
local function onlineMemberCount(clanId: string): number
	local n = 0
	if not (ClanService and ClanService.GetClanId) then
		return 0
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if ClanService.GetClanId(player) == clanId then
			n += 1
		end
	end
	return n
end

local function leaderUserId(clan: any): number?
	if typeof(clan) ~= "table" then
		return nil
	end
	return clan.LeaderUserId or clan.OwnerUserId
end

local function clanDisplayName(clanId: string): string
	if ClanService and ClanService.GetClan then
		local clan = ClanService.GetClan(clanId)
		if clan and typeof(clan.Name) == "string" then
			local tag = if typeof(clan.Tag) == "string" then clan.Tag else "?"
			return string.format("[%s] %s", tag, clan.Name)
		end
	end
	return clanId
end

local function topScoreboard(): { { ClanId: string, Score: number, Name: string } }
	local list: { { ClanId: string, Score: number, Name: string } } = {}
	for clanId, score in pairs(globalScores) do
		table.insert(list, {
			ClanId = clanId,
			Score = score,
			Name = clanDisplayName(clanId),
		})
	end
	table.sort(list, function(a, b)
		if a.Score == b.Score then
			return a.ClanId < b.ClanId
		end
		return a.Score > b.Score
	end)
	local topN = ClanWarConfig.ScoreboardTopN or 8
	local out = {}
	for i = 1, math.min(topN, #list) do
		table.insert(out, list[i])
	end
	return out
end

local function notifyClan(clanId: string, message: string, kind: string)
	if not NotificationService then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == clanId then
			NotificationService.Notify(player, message, kind)
		end
	end
end

local function pushWar(player: Player, war: WarRecord?)
	local remote = RemoteSetup.Get(Constants.RemoteNames.ClanWarStateUpdate) :: RemoteEvent
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	local cooldownLeft = 0
	if clanId and declareCooldownUntil[clanId] then
		cooldownLeft = math.max(0, declareCooldownUntil[clanId] - os.time())
	end
	remote:FireClient(player, {
		War = war,
		MyClanId = clanId,
		GlobalScores = globalScores,
		Scoreboard = topScoreboard(),
		GlobalWarEnabled = ClanWarConfig.GlobalWarEnabled == true,
		GlobalWarSeasonKey = ClanWarConfig.GlobalWarSeasonKey,
		DeclareCooldownLeft = cooldownLeft,
		MinMembers = ClanWarConfig.MinClanMembersToDeclare or 2,
		WarDurationSeconds = ClanWarConfig.WarDurationSeconds or 3600,
		Rewards = {
			WinCash = ClanWarConfig.WinningClanCashReward or 0,
			WinGold = ClanWarConfig.WinningClanGoldReward or 0,
			PartCash = ClanWarConfig.ParticipationCashReward or 0,
			PartGold = ClanWarConfig.ParticipationGoldReward or 0,
			ScoreBonusCashPerPoint = ClanWarConfig.ScoreBonusCashPerPoint or 0,
		},
	})
end

local function broadcastWar(war: WarRecord)
	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == war.AttackerClanId or cid == war.DefenderClanId then
			pushWar(player, war)
		end
	end
end

local function broadcastAll()
	for _, player in ipairs(Players:GetPlayers()) do
		local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		local war: WarRecord? = nil
		if clanId and clanActiveWar[clanId] then
			war = wars[clanActiveWar[clanId]]
		end
		pushWar(player, war)
	end
end

local function settleWar(war: WarRecord)
	if war.Settled then
		return
	end
	war.Settled = true
	war.Active = false
	clanActiveWar[war.AttackerClanId] = nil
	clanActiveWar[war.DefenderClanId] = nil

	local cooldown = ClanWarConfig.DeclareCooldownSeconds or 300
	local untilUnix = os.time() + cooldown
	declareCooldownUntil[war.AttackerClanId] = untilUnix
	declareCooldownUntil[war.DefenderClanId] = untilUnix

	local winner: string? = nil
	if war.AttackerScore > war.DefenderScore then
		winner = war.AttackerClanId
	elseif war.DefenderScore > war.AttackerScore then
		winner = war.DefenderClanId
	end
	war.WinnerClanId = winner

	local winCash = ClanWarConfig.WinningClanCashReward or 0
	local winGold = ClanWarConfig.WinningClanGoldReward or 0
	local partCash = ClanWarConfig.ParticipationCashReward or 0
	local partGold = ClanWarConfig.ParticipationGoldReward or 0
	local scoreBonus = ClanWarConfig.ScoreBonusCashPerPoint or 0

	local attackerName = war.AttackerName or clanDisplayName(war.AttackerClanId)
	local defenderName = war.DefenderName or clanDisplayName(war.DefenderClanId)
	local scoreLine = string.format("%s %d – %d %s", attackerName, war.AttackerScore, war.DefenderScore, defenderName)
	-- v70: nobody scored → nothing was fought; pay nothing (idle 0–0 wars paid participation every hour)
	local contested = (war.AttackerScore + war.DefenderScore) > 0

	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if not contested then
			if (cid == war.AttackerClanId or cid == war.DefenderClanId) and NotificationService then
				NotificationService.Notify(player, "Clan war ended " .. scoreLine .. " — no score, no rewards", "Info")
			end
		elseif cid == winner then
			local bonus = 0
			if scoreBonus > 0 then
				local myScore = if cid == war.AttackerClanId then war.AttackerScore else war.DefenderScore
				bonus = math.floor(myScore * scoreBonus)
			end
			if winCash + bonus > 0 then
				EconomyService.AddCash(player, winCash + bonus, "clan_war_win")
			end
			if winGold > 0 then
				EconomyService.AddGold(player, winGold, "clan_war_win")
			end
			if NotificationService then
				NotificationService.Notify(
					player,
					string.format("Clan war VICTORY! %s  (+$%d%s)", scoreLine, winCash + bonus, if winGold > 0 then string.format(" +%dG", winGold) else ""),
					"Reward"
				)
			end
		elseif cid == war.AttackerClanId or cid == war.DefenderClanId then
			if partCash > 0 then
				EconomyService.AddCash(player, partCash, "clan_war_participate")
			end
			if partGold > 0 then
				EconomyService.AddGold(player, partGold, "clan_war_participate")
			end
			local resultWord = if winner then "defeat" else "draw"
			if NotificationService then
				NotificationService.Notify(
					player,
					string.format("Clan war %s — %s  (+$%d participation)", resultWord, scoreLine, partCash),
					"Info"
				)
			end
		end
		pushWar(player, war)
	end

	local eventName = if AnalyticsConfig.Events.CLAN_WAR_SETTLE then AnalyticsConfig.Events.CLAN_WAR_SETTLE else "CLAN_WAR_SETTLE"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, 0, {
			warId = war.Id,
			winner = winner,
			attackerScore = war.AttackerScore,
			defenderScore = war.DefenderScore,
		})
	end
end

function ClanWarService.AddScore(clanId: string, points: number, _reason: string?)
	if typeof(clanId) ~= "string" or clanId == "" then
		return
	end
	points = math.floor(tonumber(points) or 0)
	if points == 0 then
		return
	end
	if ClanWarConfig.GlobalWarEnabled then
		globalScores[clanId] = (globalScores[clanId] or 0) + points
	end
	local warId = clanActiveWar[clanId]
	if warId then
		local war = wars[warId]
		if war and war.Active then
			if clanId == war.AttackerClanId then
				war.AttackerScore += points
			elseif clanId == war.DefenderClanId then
				war.DefenderScore += points
			end
			if os.time() >= war.EndUnix then
				settleWar(war)
			else
				broadcastWar(war)
			end
		end
	end
end

function ClanWarService.OnTerritoryCaptured(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	if clanId then
		ClanWarService.AddScore(clanId, ClanWarConfig.ScorePerTerritoryCapture or 10, "territory")
	end
end

function ClanWarService.OnEnemyKill(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	if clanId then
		ClanWarService.AddScore(clanId, ClanWarConfig.ScorePerEnemyKill or 1, "kill")
	end
end

function ClanWarService.DeclareWar(player: Player, defenderClanId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(defenderClanId) then
		return false, "InvalidDefender"
	end
	if not RemoteGuard.RequireProfile(DataService, player) then
		return false, "NoProfile"
	end
	if not ClanService then
		return false, "ClanServiceMissing"
	end
	local attackerClanId = ClanService.GetClanId(player)
	if not attackerClanId then
		return false, "NotInClan"
	end
	if attackerClanId == defenderClanId then
		return false, "CannotWarSelf"
	end
	local now = os.time()
	if declareCooldownUntil[attackerClanId] and now < declareCooldownUntil[attackerClanId] then
		return false, "DeclareCooldown"
	end
	local attackerClan = ClanService.GetClan(attackerClanId)
	local defenderClan = ClanService.GetClan(defenderClanId)
	if not attackerClan or not defenderClan then
		return false, "ClanNotFound"
	end
	if leaderUserId(attackerClan) ~= player.UserId then
		return false, "LeaderOnly"
	end
	local minMembers = ClanWarConfig.MinClanMembersToDeclare or 2
	if memberCount(attackerClan) < minMembers or memberCount(defenderClan) < minMembers then
		return false, "NotEnoughMembers"
	end
	if clanActiveWar[attackerClanId] or clanActiveWar[defenderClanId] then
		return false, "AlreadyAtWar"
	end
	-- v70: wars are scored in this server only — a clan with nobody here cannot defend (uncontested wins)
	local minOnline = math.max(1, math.floor(tonumber((ClanWarConfig :: any).MinOnlineDefendersToDeclare) or 1))
	if onlineMemberCount(defenderClanId) < minOnline then
		return false, "DefenderOffline"
	end

	local warId = string.format("war_%d_%d", now, nextWarSerial)
	nextWarSerial += 1
	local war: WarRecord = {
		Id = warId,
		AttackerClanId = attackerClanId,
		DefenderClanId = defenderClanId,
		AttackerName = clanDisplayName(attackerClanId),
		DefenderName = clanDisplayName(defenderClanId),
		StartUnix = now,
		EndUnix = now + (ClanWarConfig.WarDurationSeconds or 3600),
		AttackerScore = 0,
		DefenderScore = 0,
		Active = true,
		Settled = false,
		WinnerClanId = nil,
	}
	wars[warId] = war
	clanActiveWar[attackerClanId] = warId
	clanActiveWar[defenderClanId] = warId
	broadcastWar(war)
	-- Also refresh scoreboard for everyone
	broadcastAll()

	local declareMsg = string.format(
		"WAR DECLARED: %s vs %s (%dm)",
		war.AttackerName or attackerClanId,
		war.DefenderName or defenderClanId,
		math.floor((ClanWarConfig.WarDurationSeconds or 3600) / 60)
	)
	notifyClan(attackerClanId, declareMsg, "Success")
	notifyClan(defenderClanId, declareMsg .. " — DEFEND!", "Warn")

	local eventName = if AnalyticsConfig.Events.CLAN_WAR_DECLARE then AnalyticsConfig.Events.CLAN_WAR_DECLARE else "CLAN_WAR_DECLARE"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, {
			warId = warId,
			attacker = attackerClanId,
			defender = defenderClanId,
		})
	end
	return true, nil
end

function ClanWarService.Push(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	local war: WarRecord? = nil
	if clanId and clanActiveWar[clanId] then
		war = wars[clanActiveWar[clanId]]
	end
	pushWar(player, war)
end

function ClanWarService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	ClanService = deps.ClanService
	AntiExploitService = deps.AntiExploitService

	local declareRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDeclareClanWar) :: RemoteEvent
	declareRemote.OnServerEvent:Connect(function(player: Player, defenderClanId: any)
		if not RateLimitService.Allow(player, "clan_war_declare", 1, 1) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "clan_war_declare_rate")
			end
			return
		end
		local ok, err = ClanWarService.DeclareWar(player, defenderClanId)
		if not ok and NotificationService then
			local msg = "Cannot declare war: " .. tostring(err)
			if err == "DeclareCooldown" then
				local cid = if ClanService then ClanService.GetClanId(player) else nil
				local left = if cid and declareCooldownUntil[cid] then math.max(0, declareCooldownUntil[cid] - os.time()) else 0
				msg = string.format("War declare cooldown: %ds remaining", left)
			elseif err == "NotEnoughMembers" then
				msg = string.format("Both clans need ≥%d members to war", ClanWarConfig.MinClanMembersToDeclare or 2)
			elseif err == "LeaderOnly" then
				msg = "Only the clan leader can declare war"
			elseif err == "DefenderOffline" then
				msg = "That clan has no members in this server — wars need defenders online"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		ClanWarService.Push(player)
	end)

	task.spawn(function()
		while true do
			task.wait(15)
			if next(wars) ~= nil then
				local now = os.time()
				for _, war in pairs(wars) do
					if war.Active and not war.Settled and now >= war.EndUnix then
						settleWar(war)
					end
				end
			end
		end
	end)
end

return ClanWarService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">CodesService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Promo code redemption — once per code per player. Server-validated Cash/Gold grants.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local CodesConfig = require(Shared.Configs.CodesConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local CodesService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function normalize(code: string): string
	local s = string.upper(string.gsub(code, "%s+", ""))
	return s
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.RedeemedCodes) ~= "table" then
		profile.RedeemedCodes = {}
	end
	local redeemed: { string } = {}
	for id in pairs(profile.RedeemedCodes) do
		table.insert(redeemed, id)
	end
	table.sort(redeemed)
	local remote = RemoteSetup.Get(Constants.RemoteNames.CodeStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Redeemed = redeemed,
		AvailableHints = { "WARFOUNDING", "BUILDCONQUER" },
	})
end

function CodesService.Redeem(player: Player, rawCode: any): (boolean, string?)
	if not RemoteGuard.IsIdString(rawCode, CodesConfig.MaxCodeLength or 32) then
		return false, "InvalidCode"
	end
	local code = normalize(rawCode :: string)
	local def = CodesConfig.Codes[code]
	if not def then
		return false, "UnknownCode"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if typeof(profile.RedeemedCodes) ~= "table" then
		profile.RedeemedCodes = {}
	end
	if profile.RedeemedCodes[code] then
		return false, "AlreadyRedeemed"
	end

	profile.RedeemedCodes[code] = true
	DataService.MarkDirty(player)

	local cash = tonumber(def.Cash) or 0
	local gold = tonumber(def.Gold) or 0
	if cash > 0 then
		EconomyService.AddCash(player, cash, "code")
	end
	if gold > 0 then
		EconomyService.AddGold(player, gold, "code")
	end

	if NotificationService then
		local name = def.DisplayName or code
		NotificationService.Notify(
			player,
			string.format("Code %s: +$%d · +%d Gold", name, cash, gold),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.CODE_REDEEM, player.UserId, {
			code = code,
			cash = cash,
			gold = gold,
		})
	end
	pushState(player)
	return true, nil
end

function CodesService.Push(player: Player)
	pushState(player)
end

function CodesService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestRedeemCode) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player, code: any)
		if not RateLimitService.Allow(player, "redeem_code", 1, 3) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "redeem_code_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = CodesService.Redeem(player, code)
		if not ok and NotificationService then
			local msg = "Code failed"
			if err == "AlreadyRedeemed" then
				msg = "Code already redeemed"
			elseif err == "UnknownCode" then
				msg = "Unknown code"
			elseif err == "InvalidCode" then
				msg = "Invalid code"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.RedeemedCodes) ~= "table" then
			profile.RedeemedCodes = {}
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)
end

return CodesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 3 — Server-authoritative combat.
	Clients request fire/reload/equip/purchase; server validates and applies WeaponConfig damage.

	W2 Combat Core (contracts §1–§3; money plan M4; mobile plan §4.1, P1-5):
	  - RequestFire resolves a hitscan shot in order: exact server ray (player / NPC / registered vehicle / gate;
	    a "Head" part is a headshot x CombatFeelConfig.HeadshotMult) → the P0-7 claim (unchanged lag tolerance) →
	    server aim assist (CombatAssist, AimAssistConfig class limits; the client never names the target) → miss.
	    Damage falls off with distance (WeaponConfig.Falloff). The shot filter leaves out the shooter, the vehicle
	    they sit in and every squad unit. Seat rules come first (drivers per VehicleCombatConfig.SeatFire, open-seat
	    passengers fire from the head, mount and enclosed seats refuse).
	  - Rocket / grenade (WeaponConfig.Projectile) launch a server projectile (Server/Modules/Projectile): direct
	    vehicle / gate hit, then ApplyRadiusDamage (humanoids) + VehicleHealth.ApplyRadiusDamage (vehicles).
	  - WeaponFx (UnreliableRemoteEvent, CombatFx): one bullet event per accepted shot within 250 studs, <= 20 Hz per
	    shooter; projectile launch / explosion events.
	  - Server APIs for other services: ApplyHit, ApplyRadiusDamage, ApplyBlastDamage, IsSpawnInvulnerable,
	    OnPlayerDeath (the DeathShopOffer toast is built-in listener #1).

	F6 novice shield (owner's 11 features, CombatFairnessConfig.NoviceShield; off until lane Z):
	  - A player whose save says the tutorial is not complete and NoviceShieldDone is false is shielded for this
	    session: InvulnerableUntil = math.huge (so every damage path here, CombatNPC's hit roll and the assist skip
	    them), the replicated character attribute WE_ShieldUntil and a visible server ForceField "WE_NoviceShield".
	    It survives respawns. GateDefenseService guards skip them (SetShieldCheck, injected from Init).
	  - It ends for good (profile.NoviceShieldDone = true, one Text.Off toast) on the first of: drawing a weapon, the
	    first accepted shot (before any hit resolves), an accepted squad order or missile strike, contesting a zone,
	    tutorial complete or skip, holding an ATM raid or entering the Empire Bank's guard ring (1 Hz sweep), or
	    MaxSeconds of play this session. Never re-granted.
	  - A shielded player deals no damage to other players, their vehicles or gates: such a hit ends the shield first.
	  - APIs: IsNoviceShielded(player) -> boolean, EndNoviceShield(player, reason) -> boolean (true = it ended now).

	W3 step 2 Phase B, lane N NPC core (contract §5): SpawnNPC(type, at, opts?) takes NPCSpawnOpts (GroupId,
	NoRespawn, Home, Leash, Stance, ProvokeRadius, OverCap, Static); with no opts every call behaves as before.
	The cap is MaxActiveNPCs regular, + SpecialOverCap for CombatConfig.SpecialNPCTypes and opts.OverCap. A player
	hurting a grouped NPC provokes its group. APIs: OnNPCDeath(fn) (once per death, after rewards; listeners
	deferred, each in its own pcall), DespawnNPC(id) (silent), ProvokeGroup / CalmGroup / GroupNPCs(groupId),
	NPCCounts(). CombatConfig.FieldBootstrap == false skips BootstrapNPCs. Stances live in CombatNPC.Think.

	streaming2 lane S2: TeleportToBase moves through StreamPrefetch while Workspace.StreamingEnabled is on (the old
	PivotTo when it is off), and every SpawnNPC Model is ModelStreamingMode Atomic, set before it is parented.
]]

