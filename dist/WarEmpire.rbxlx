			local hosts = {
				{ "WE_DressHost_Crate", Vector3.new(1.6, 1.2, 1.6), Vector3.new(-6, 1.5, 8), "MilitaryCrate" },
				{ "WE_DressHost_MilCrate", Vector3.new(1.5, 1.1, 1.3), Vector3.new(8, 1.45, 7), "MilitaryCrate" },
				{ "WE_DressHost_Ammo", Vector3.new(1.4, 1.0, 1.0), Vector3.new(4, 1.3, -4), "AmmoBox" },
				{ "WE_DressHost_Fuel", Vector3.new(1.2, 1.0, 1.2), Vector3.new(-10, 1.3, -4), "FuelCans" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(14, 4.0, 8), "Lantern" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	elseif kit == "special" then
		-- v35: Special Forces compound (~28×16×18) — dark ops hall + range + watch post
		kitPart(plinth, "Body", Vector3.new(28, 14, 16), Vector3.new(0, 7.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(30, 1.2, 18), Vector3.new(0, 15, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(28, 0.28, 16), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Door", Vector3.new(3.6, 5.0, 0.4), Vector3.new(0, 3.2, -8.2), Color3.fromRGB(25, 28, 32), Enum.Material.Metal, nil)
		-- Side annex (armory wing)
		kitPart(plinth, "Detail", Vector3.new(12, 10, 10), Vector3.new(-18, 5.5, 2), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(10, 8, 8), Vector3.new(16, 4.5, -2), Color3.fromRGB(40, 48, 55), Enum.Material.Metal, nil)
		-- Watch post / tower stub
		kitPart(plinth, "Antenna", Vector3.new(4, 18, 4), Vector3.new(12, 10, 10), Color3.fromRGB(38, 42, 48), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(2.2, 1.4, 0.25), Vector3.new(12, 16, 7.9), Color3.fromRGB(100, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 6, 0.35), Vector3.new(12, 22, 10), pal.Accent, Enum.Material.SmoothPlastic, nil)
		-- Training range silhouette (targets + berm)
		kitPart(plinth, "Detail", Vector3.new(16, 1.2, 3), Vector3.new(0, 1.2, 12), Color3.fromRGB(90, 85, 60), Enum.Material.Sand, nil)
		for _, tx in ipairs({ -6, 0, 6 }) do
			kitPart(plinth, "Detail", Vector3.new(0.8, 2.4, 0.3), Vector3.new(tx, 2.4, 13.5), Color3.fromRGB(180, 60, 50), Enum.Material.Metal, nil)
		end
		-- Windows + flag
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(-6, 8, -8.1), Color3.fromRGB(70, 100, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(6, 8, -8.1), Color3.fromRGB(70, 100, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 5, 0.8), Vector3.new(-12, 4, 8), pal.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(2.2, 1.3, 0.2), Vector3.new(-12, 7.2, 8), Color3.fromRGB(120, 50, 160), Enum.Material.Fabric, nil)
		-- Dress hosts
		do
			local hosts = {
				{ "WE_DressHost_Ammo", Vector3.new(1.4, 1.0, 1.0), Vector3.new(-10, 1.4, 6), "AmmoBox" },
				{ "WE_DressHost_Crate", Vector3.new(1.6, 1.2, 1.6), Vector3.new(-6, 1.5, 7), "MilitaryCrate" },
				{ "WE_DressHost_Sandbag", Vector3.new(3.0, 1.0, 1.2), Vector3.new(4, 1.2, 10), "Sandbag" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(10, 3.0, 4), "Lantern" },
				{ "WE_DressHost_Flood", Vector3.new(0.7, 1.4, 0.7), Vector3.new(-14, 5.0, -6), "Floodlight" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	else
		kitPart(plinth, "Body", Vector3.new(5.3, 3.5, 5.3), Vector3.new(0, 2.4, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(4.2, 1.2, 4.2), Vector3.new(0, 4.6, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.2, 0.35), Vector3.new(0, 7.2, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Accent", Vector3.new(5.9, 0.22, 5.9), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.SmoothPlastic, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.0, 3.5, -2.0), pal.Accent, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end
	plinth:SetAttribute("WE_KitGen", KIT_GEN)
end

--[[ Ensure plinth has kit children; rebuild if missing/incomplete. Returns role count. ]]
function StructureKitBuilder.EnsureKit(plinth: BasePart, structureId: string): number
	local hollow = HollowBuildingBuilder.IsHollow(structureId)
	local n = countKitRoles(plinth)
	local gen = tonumber(plinth:GetAttribute("WE_KitGen")) or 0
	local needsRebuild = gen < KIT_GEN

	-- Always require a Body part (visibility gate). Missing Body → rebuild.
	local hasBody = false
	local bodyTooSmall = false
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") == "Body" then
			hasBody = true
			local s = child.Size
			-- Helipad/Dock/Airfield flat decks can be thin on Y but wide on XZ
			if math.max(s.X, s.Y, s.Z) < 8 then
				bodyTooSmall = true
			end
			break
		end
	end
	if not hasBody or bodyTooSmall then
		needsRebuild = true
	end

	-- Tier 2: rebuild HQ/Barracks/Depot if dress / showroom densify hosts missing
	local needsDress = false
	if not hollow and (structureId == "CommandCenter" or structureId == "Barracks" or structureId == "VehicleDepot" or structureId == "PowerStation" or structureId == "WeaponsFacility" or structureId == "SpecialForcesFacility" or structureId == "Dock" or structureId == "Airfield" or structureId == "Warehouse") then
		local hasDress = false
		for _, child in ipairs(plinth:GetChildren()) do
			if child:IsA("BasePart") then
				local nm = child.Name
				if string.sub(nm, 1, 12) == "WE_DressHost" or nm == "WE_CommandDesk" or nm == "ShowroomPedestalHost2" or nm == "ShowroomFlagHost" or child:GetAttribute("WE_KitRole") == "ParkedBoat" then
					hasDress = true
					break
				end
			end
		end
		needsDress = not hasDress
	end
	if n < 2 or needsDress or needsRebuild then
		-- Clear stale catalog dress so ScaleTo re-applies
		plinth:SetAttribute("WE_CatalogAssetId", nil)
		plinth:SetAttribute("WE_BuildingDressGen", nil)
		for _, ch in ipairs(plinth:GetChildren()) do
			if ch:IsA("Model") and (ch.Name == "WE_CatalogBuilding" or ch.Name == "WE_AirfieldComposite") then
				ch:Destroy()
			end
		end
		StructureKitBuilder.BuildKitOnPlinth(plinth, structureId)
		plinth:SetAttribute("WE_KitGen", KIT_GEN)
		n = countKitRoles(plinth)
	end

	-- v43 hard assert: EnsureKit path always leaves a Body part (even if mesh later fails)
	local bodyOk = false
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") == "Body" then
			bodyOk = true
			break
		end
	end
	if not bodyOk then
		warn("[StructureKitBuilder] EnsureKit missing Body after build — forcing generic Body", structureId)
		local pal = paletteFor(structureId)
		kitPart(plinth, "Body", Vector3.new(16, 10, 16), Vector3.new(0, 5.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(18, 1.2, 18), Vector3.new(0, 11.2, 0), pal.Roof, Enum.Material.Metal, nil)
		plinth:SetAttribute("WE_KitGen", KIT_GEN)
		n = countKitRoles(plinth)
	end

	-- v44/v45 P0: owned kits must be solid IMMEDIATELY (do not wait for applyKitVisuals)
	local solid = StructureVisualConfig.SolidTransparency
	if typeof(solid) ~= "number" then
		solid = 0
	end
	solid = 0 -- force fully opaque Body/Roof
	local flatKit = hollow or structureId == "Dock" or structureId == "Airfield" or structureId == "DefensiveWalls"
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") then
			local role = child:GetAttribute("WE_KitRole")
			if role == "Body" or role == "Roof" then
				child.Transparency = 0
				child.Anchored = true
				if role == "Body" then
					child.CanCollide = true
					if not flatKit then
						local s = child.Size
						local nx = math.max(s.X, 14)
						local ny = math.max(s.Y, 10)
						local nz = math.max(s.Z, 14)
						if nx ~= s.X or ny ~= s.Y or nz ~= s.Z then
							child.Size = Vector3.new(nx, ny, nz)
							child:SetAttribute("WE_BaseSize", child.Size)
						end
					end
				end
				if child.Parent ~= plinth then
					child.Parent = plinth
				end
			elseif role == "Accent" or role == "Antenna" or role == "Detail" or role == "Door" or role == "Window" or role == "Pier" or role == "Crate" then
				child.Anchored = true
				if child.Transparency > 0.5 then
					child.Transparency = solid
				end
			end
		end
	end
	-- MissileDefense hard force large Body+Roof after any rebuild path (not for the v68 installation slab)
	if structureId == "MissileDefense" and not hollow then
		for _, child in ipairs(plinth:GetChildren()) do
			if child:IsA("BasePart") then
				local role = child:GetAttribute("WE_KitRole")
				if role == "Body" then
					local s = child.Size
					child.Size = Vector3.new(math.max(s.X, 18), math.max(s.Y, 12), math.max(s.Z, 18))
					child.Transparency = 0
					child.CanCollide = true
					child.Anchored = true
				elseif role == "Roof" then
					local s = child.Size
					child.Size = Vector3.new(math.max(s.X, 20), math.max(s.Y, 1.2), math.max(s.Z, 14))
					child.Transparency = 0
					child.Anchored = true
				end
			end
		end
	end

	if StructureVisualConfig.Palettes[structureId] == nil then
		warn("[StructureKitBuilder] profile/structure has kit build but no StructureVisualConfig.Palettes entry:", structureId)
	end

	return n
end

local function findPlotPad(plotId: number): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and tonumber(inst:GetAttribute("PlotId")) == tonumber(plotId) then
			return inst
		end
	end
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	if plotFolder then
		local pad = plotFolder:FindFirstChild("PlotPad")
		if pad and pad:IsA("BasePart") then
			return pad
		end
	end
	return nil
end

function StructureKitBuilder.FindPlotFolder(plotId: number): Folder?
	local pad = findPlotPad(plotId)
	if pad and pad.Parent and pad.Parent:IsA("Folder") then
		return pad.Parent
	end
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	if plotFolder and plotFolder:IsA("Folder") then
		return plotFolder
	end
	return nil
end

--[[ Perimeter fortification around PlotPad.
	level 0 clears; 1+ builds a collide wall ring with a walkable gate facing PlayerSpawn.
	BUGFIX: prior WallS used span*2 which overlapped and sealed the gate on 200-stud pads.
]]
function StructureKitBuilder.SyncPerimeterWalls(plotId: number, level: number)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local pad = findPlotPad(plotId)
	if not plotFolder or not pad then
		return
	end

	local existing = plotFolder:FindFirstChild(PERIMETER_FOLDER)
	if level <= 0 then
		if existing then
			existing:Destroy()
			print("[StructureKitBuilder] SyncPerimeterWalls CLEARED (level=0) plot=", plotId)
		end
		return
	end

	local folder: Folder
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = PERIMETER_FOLDER
		folder.Parent = plotFolder
	end

	local pal = paletteFor("DefensiveWalls")
	local lv = math.clamp(level, 1, 5)
	local halfX = pad.Size.X * 0.5 - 1.5
	local halfZ = pad.Size.Z * 0.5 - 1.5
	-- v36: thicker/taller defensive walls at higher levels
	local thickness = 2.8 + lv * 0.7
	local height = 7.5 + lv * 2.8
	local y = pad.Position.Y + pad.Size.Y * 0.5 + height * 0.5
	local cx, cz = pad.Position.X, pad.Position.Z

	-- Clear walkable opening (8–12 studs). Posts/arch are visual-only outside this span.
	local GATE_CLEAR = 10
	local gateHalf = GATE_CLEAR * 0.5

	-- Gate faces PlayerSpawn (plot-local). Fallback: PlotForward attr, else pad LookVector / +Z.
	local gateAxis = "Z" -- gate on ±Z face; "X" = gate on ±X face
	local gateSign = 1
	local spawnPart = plotFolder:FindFirstChild("PlayerSpawn")
	local dx, dz = 0.0, 1.0
	if spawnPart and spawnPart:IsA("BasePart") then
		dx = spawnPart.Position.X - cx
		dz = spawnPart.Position.Z - cz
	else
		local attrFwd = plotFolder:GetAttribute("PlotForward")
		if typeof(attrFwd) == "Vector3" then
			dx = (attrFwd :: Vector3).X
			dz = (attrFwd :: Vector3).Z
		else
			local look = pad.CFrame.LookVector
			dx, dz = look.X, look.Z
			if math.abs(dx) < 0.05 and math.abs(dz) < 0.05 then
				dx, dz = 0, 1
			end
		end
	end
	if math.abs(dx) >= math.abs(dz) then
		gateAxis = "X"
		gateSign = if dx >= 0 then 1 else -1
	else
		gateAxis = "Z"
		gateSign = if dz >= 0 then 1 else -1
	end
	folder:SetAttribute("WE_GateAxis", gateAxis)
	folder:SetAttribute("WE_GateSign", gateSign)
	folder:SetAttribute("WE_GateClear", GATE_CLEAR)

	-- v70: openings in the ring. MapSetup puts a WE_WallGap marker (world-axis-aligned box, BaseLayout.PlotRect) under
	-- LayoutGround wherever the wall must stay open (the sea gate: its posts + collidable leaves close the span).
	local gaps: { BasePart } = {}
	do
		local layoutGround = plotFolder:FindFirstChild("LayoutGround")
		if layoutGround then
			for _, d in ipairs(layoutGround:GetDescendants()) do
				if d:IsA("BasePart") and d:GetAttribute("WE_WallGap") == true then
					table.insert(gaps, d)
				end
			end
		end
	end

	local function wall(name: string, size: Vector3, pos: Vector3)
		local w = makePart({
			Name = name,
			Size = size,
			Position = pos,
			Color = pal.Body,
			Material = Enum.Material.Concrete,
			Transparency = 0,
			CanCollide = true,
			Parent = folder,
		})
		w.CanTouch = false
		w.CanQuery = true
		w.CastShadow = true
		w:SetAttribute("WE_Perimeter", true)
		w:SetAttribute("PlotId", plotId)
		w:SetAttribute("WE_WallLevel", lv)
		local capH = 0.45 + lv * 0.08
		local look = (StructureVisualConfig :: any).BaseLook or {}
		-- v67: concrete cap + razor wire (was a lime Neon cap on bright olive walls)
		local cap = makePart({
			Name = name .. "_Cap",
			Size = Vector3.new(size.X + 0.4, capH, size.Z + 0.4),
			Position = Vector3.new(pos.X, pos.Y + height * 0.5 + capH * 0.5, pos.Z),
			Color = look.WallCap or pal.Accent,
			Material = Enum.Material.Concrete,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		cap:SetAttribute("WE_Perimeter", true)
		local along = math.max(size.X, size.Z)
		local wireYaw = if size.Z > size.X then math.pi * 0.5 else 0
		local wire = makePart({
			Name = name .. "_Wire",
			Size = Vector3.new(along, 0.9, 0.9),
			CFrame = CFrame.new(pos.X, pos.Y + height * 0.5 + capH + 0.45, pos.Z) * CFrame.Angles(0, wireYaw, 0),
			Color = look.Wire or Color3.fromRGB(58, 60, 56),
			Material = Enum.Material.DiamondPlate,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
			Shape = Enum.PartType.Cylinder,
		})
		wire:SetAttribute("WE_Perimeter", true)
		return w
	end

	-- v70: a wall with every WE_WallGap span that straddles its line cut out. No gap on the line → the exact same
	-- single wall as before. [J8] The LONGEST piece keeps the base name (it may host the L3+ wall mesh); pieces
	-- shorter than 26 are flagged WE_NoMesh (a 24-long mesh would hang over the opening).
	local function gappedWall(name: string, size: Vector3, pos: Vector3)
		local alongX = size.X >= size.Z
		local half = (if alongX then size.X else size.Z) * 0.5
		local c = if alongX then pos.X else pos.Z
		local wAcross = if alongX then pos.Z else pos.X
		local wHalfT = (if alongX then size.Z else size.X) * 0.5
		local segs: { { number } } = { { c - half, c + half } }
		local cut = false
		for _, g in ipairs(gaps) do
			-- world AABB half extents of the marker (robust to a turned marker; identity → Size * 0.5)
			local gp, gs = g.Position, g.Size
			local _, _, _, r00, r01, r02, _, _, _, r20, r21, r22 = g.CFrame:GetComponents()
			local ghx = (math.abs(r00) * gs.X + math.abs(r01) * gs.Y + math.abs(r02) * gs.Z) * 0.5
			local ghz = (math.abs(r20) * gs.X + math.abs(r21) * gs.Y + math.abs(r22) * gs.Z) * 0.5
			local gAlong = if alongX then gp.X else gp.Z
			local gHalf = if alongX then ghx else ghz
			local gAcross = if alongX then gp.Z else gp.X
			local gAcrossHalf = if alongX then ghz else ghx
			if math.abs(gAcross - wAcross) <= gAcrossHalf + wHalfT then -- the gap straddles this wall's line
				local g0, g1 = gAlong - gHalf, gAlong + gHalf
				local out: { { number } } = {}
				for _, s in ipairs(segs) do
					if g1 <= s[1] or g0 >= s[2] then
						table.insert(out, s)
					else
						cut = true
						if g0 - s[1] >= 1 then
							table.insert(out, { s[1], g0 })
						end
						if s[2] - g1 >= 1 then
							table.insert(out, { g1, s[2] })
						end
					end
				end
				segs = out
			end
		end
		if not cut then
			local w = wall(name, size, pos)
			if half * 2 < 26 then
				w:SetAttribute("WE_NoMesh", true)
			end
			return
		end
		table.sort(segs, function(a, b)
			return (a[2] - a[1]) > (b[2] - b[1])
		end)
		for i, s in ipairs(segs) do
			local len, mid = s[2] - s[1], (s[1] + s[2]) * 0.5
			local pieceName = if i == 1 then name else name .. "_" .. tostring(i)
			local w = wall(
				pieceName,
				if alongX then Vector3.new(len, size.Y, size.Z) else Vector3.new(size.X, size.Y, len),
				if alongX then Vector3.new(mid, pos.Y, pos.Z) else Vector3.new(pos.X, pos.Y, mid)
			)
			w:SetAttribute("WE_WallPiece", i)
			if len < 26 then
				w:SetAttribute("WE_NoMesh", true)
			end
			-- the cap overhangs its wall by 0.2 at each end; keep it out of the opening at a cut end
			local cutLo, cutHi = s[1] > c - half + 1e-6, s[2] < c + half - 1e-6
			local cap = folder:FindFirstChild(pieceName .. "_Cap")
			if cap and cap:IsA("BasePart") and (cutLo or cutHi) then
				local capLen = len + 0.4 - (if cutLo then 0.2 else 0) - (if cutHi then 0.2 else 0)
				local capMid = mid + (if cutLo then 0.1 else 0) - (if cutHi then 0.1 else 0)
				local cs, cp = cap.Size, cap.Position
				cap.Size = if alongX then Vector3.new(capLen, cs.Y, cs.Z) else Vector3.new(cs.X, cs.Y, capLen)
				cap.Position = if alongX then Vector3.new(capMid, cp.Y, cp.Z) else Vector3.new(cp.X, cp.Y, capMid)
			end
		end
	end

	-- Segment from outer corner to gate edge: length = alongHalf - gateHalf (NOT *2 — that sealed the gate).
	local function gateFaceSegments(alongHalf: number): (number, number)
		local segLen = math.max(alongHalf - gateHalf, 2)
		local mid = (alongHalf + gateHalf) * 0.5
		return segLen, mid
	end

	if gateAxis == "Z" then
		local closedZ = cz - gateSign * halfZ
		local openZ = cz + gateSign * halfZ
		gappedWall("WallClosed", Vector3.new(halfX * 2, height, thickness), Vector3.new(cx, y, closedZ))
		gappedWall("WallE", Vector3.new(thickness, height, halfZ * 2), Vector3.new(cx + halfX, y, cz))
		gappedWall("WallW", Vector3.new(thickness, height, halfZ * 2), Vector3.new(cx - halfX, y, cz))
		local segLen, mid = gateFaceSegments(halfX)
		if segLen > 2 then
			gappedWall("WallGate_L", Vector3.new(segLen, height, thickness), Vector3.new(cx - mid, y, openZ))
			gappedWall("WallGate_R", Vector3.new(segLen, height, thickness), Vector3.new(cx + mid, y, openZ))
		end
		local postW = 2.2 + lv * 0.15
		local postH = height + 1.5
		local postY = pad.Position.Y + pad.Size.Y * 0.5 + postH * 0.5
		local postInset = gateHalf + postW * 0.5 -- outside clear opening
		for _, sx in ipairs({ -postInset, postInset }) do
			local post = makePart({
				Name = "GatePost",
				Size = Vector3.new(postW, postH, postW),
				Position = Vector3.new(cx + sx, postY, openZ),
				Color = pal.Roof,
				Material = Enum.Material.Metal,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			post:SetAttribute("WE_Perimeter", true)
			post:SetAttribute("WE_GateVisual", true)
			post.CastShadow = true
		end
		local archY = pad.Position.Y + pad.Size.Y * 0.5 + height + 0.9
		local arch = makePart({
			Name = "GateArch",
			Size = Vector3.new(GATE_CLEAR + postW * 2, 2.0 + lv * 0.25, thickness + 1.2),
			Position = Vector3.new(cx, archY, openZ),
			Color = pal.Roof,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		arch:SetAttribute("WE_Perimeter", true)
		arch:SetAttribute("WE_GateVisual", true)
		-- v36 military gate: chevron stripe + GATE sign
		makePart({
			Name = "GateChevron",
			Size = Vector3.new(GATE_CLEAR + postW, 0.35, thickness + 1.6),
			Position = Vector3.new(cx, archY + 0.9, openZ),
			Color = ((StructureVisualConfig :: any).BaseLook or {}).GateStripe or Color3.fromRGB(214, 178, 64),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		}):SetAttribute("WE_GateVisual", true)
		-- v70 (HUD spec §5): painted on the arch's outer face (was a floating BillboardGui; the name is kept)
		WorldLabel.Surface(arch, if gateSign > 0 then Enum.NormalId.Back else Enum.NormalId.Front, "GATE · L" .. tostring(lv), { Name = "WE_GateSign", Color = GATE_SIGN_COLOR })
	else
		local closedX = cx - gateSign * halfX
		local openX = cx + gateSign * halfX
		gappedWall("WallClosed", Vector3.new(thickness, height, halfZ * 2), Vector3.new(closedX, y, cz))
		gappedWall("WallN", Vector3.new(halfX * 2, height, thickness), Vector3.new(cx, y, cz - halfZ))
		gappedWall("WallS", Vector3.new(halfX * 2, height, thickness), Vector3.new(cx, y, cz + halfZ))
		local segLen, mid = gateFaceSegments(halfZ)
		if segLen > 2 then
			gappedWall("WallGate_L", Vector3.new(thickness, height, segLen), Vector3.new(openX, y, cz - mid))
			gappedWall("WallGate_R", Vector3.new(thickness, height, segLen), Vector3.new(openX, y, cz + mid))
		end
		local postW = 2.2 + lv * 0.15
		local postH = height + 1.5
		local postY = pad.Position.Y + pad.Size.Y * 0.5 + postH * 0.5
		local postInset = gateHalf + postW * 0.5
		for _, sz in ipairs({ -postInset, postInset }) do
			local post = makePart({
				Name = "GatePost",
				Size = Vector3.new(postW, postH, postW),
				Position = Vector3.new(openX, postY, cz + sz),
				Color = pal.Roof,
				Material = Enum.Material.Metal,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			post:SetAttribute("WE_Perimeter", true)
			post:SetAttribute("WE_GateVisual", true)
			post.CastShadow = true
		end
		local archY = pad.Position.Y + pad.Size.Y * 0.5 + height + 0.9
		local arch = makePart({
			Name = "GateArch",
			Size = Vector3.new(thickness + 1.2, 2.0 + lv * 0.25, GATE_CLEAR + postW * 2),
			Position = Vector3.new(openX, archY, cz),
			Color = pal.Roof,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		arch:SetAttribute("WE_Perimeter", true)
		arch:SetAttribute("WE_GateVisual", true)
		makePart({
			Name = "GateChevron",
			Size = Vector3.new(thickness + 1.6, 0.35, GATE_CLEAR + postW),
			Position = Vector3.new(openX, archY + 0.9, cz),
			Color = ((StructureVisualConfig :: any).BaseLook or {}).GateStripe or Color3.fromRGB(214, 178, 64),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		}):SetAttribute("WE_GateVisual", true)
		WorldLabel.Surface(arch, if gateSign > 0 then Enum.NormalId.Right else Enum.NormalId.Left, "GATE · L" .. tostring(lv), { Name = "WE_GateSign", Color = GATE_SIGN_COLOR })
	end

	-- L3+ heavy wall catalog mesh on a few segments (Part kit remains authoritative)
	if lv >= 3 then
		task.defer(function()
			pcall(function()
				local vas = require(script.Parent.Parent.Services.VisualAssetService)
				local dressed = 0
				for _, ch in ipairs(folder:GetChildren()) do
					if dressed >= 4 then
						break
					end
					-- [J8] wall bodies only: never a cap / wire, a short piece next to an opening (WE_NoMesh) or a wall
					-- running along Z (the 24x8x3 mesh takes the host's identity rotation, so it would sit across it)
					local nm = ch.Name
					if
						ch:IsA("BasePart")
						and ch:GetAttribute("WE_Perimeter") == true
						and not ch:GetAttribute("WE_GateVisual")
						and ch:GetAttribute("WE_NoMesh") ~= true
						and string.sub(nm, -4) ~= "_Cap"
						and string.sub(nm, -5) ~= "_Wire"
						and ch.Size.Z <= ch.Size.X
					then
						if vas.TryAttachBuildingVisual(ch, "DefensiveWalls", lv) then
							dressed += 1
						end
					end
				end
			end)
		end)
	end

	folder:SetAttribute("WE_PerimeterGen", KIT_GEN)
	folder:SetAttribute("WE_WallLevel", lv)
	folder:SetAttribute("WE_WallGaps", #gaps)
	print(string.format(
		"[StructureKitBuilder] SyncPerimeterWalls SPAWNED plot=%s level=%d height=%.1f thickness=%.1f KIT_GEN=%d parts=%d gaps=%d",
		tostring(plotId),
		lv,
		height,
		thickness,
		KIT_GEN,
		#folder:GetChildren(),
		#gaps
	))

end

--[[ Base Ceiling — competitor anti-heli roof over plot core (ATM + main buildings).
	Unlock: DefensiveWalls ≥ L3 (wallsLevel). Gate-front spawn road stays open (no seal).
	Part-kit gunmetal/olive translucent collide plate. Optional mesh only if VisualAssetConfig.Buildings.BaseCeiling has a free ID.
]]
function StructureKitBuilder.SyncBaseCeiling(plotId: number, wallsLevel: number)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local pad = findPlotPad(plotId)
	if not plotFolder or not pad then
		return
	end

	local existing = plotFolder:FindFirstChild(CEILING_FOLDER)
	-- v68: no roof at all over bases (owner request) — AntiAirCeilingEnabled = false clears any ceiling
	if (StructureVisualConfig :: any).AntiAirCeilingEnabled == false or wallsLevel < CEILING_UNLOCK_WALLS then
		if existing then
			existing:Destroy()
		end
		plotFolder:SetAttribute("WE_BaseCeiling", false)
		return
	end

	local folder: Folder
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = CEILING_FOLDER
		folder.Parent = plotFolder
	end

	local lv = math.clamp(wallsLevel, CEILING_UNLOCK_WALLS, 5)
	local halfX = pad.Size.X * 0.5
	local halfZ = pad.Size.Z * 0.5
	local cx, cz = pad.Position.X, pad.Position.Z
	local padTop = pad.Position.Y + pad.Size.Y * 0.5

	-- Reuse gate facing from perimeter attrs when present (keeps spawn road open)
	local peri = plotFolder:FindFirstChild(PERIMETER_FOLDER)
	local gateAxis = "Z"
	local gateSign = 1
	if peri then
		local ax = peri:GetAttribute("WE_GateAxis")
		local sg = peri:GetAttribute("WE_GateSign")
		if typeof(ax) == "string" and (ax == "X" or ax == "Z") then
			gateAxis = ax
		end
		if typeof(sg) == "number" then
			gateSign = if (sg :: number) >= 0 then 1 else -1
		end
	else
		local spawnPart = plotFolder:FindFirstChild("PlayerSpawn")
		local dx, dz = 0.0, 1.0
		if spawnPart and spawnPart:IsA("BasePart") then
			dx = spawnPart.Position.X - cx
			dz = spawnPart.Position.Z - cz
		else
			local look = pad.CFrame.LookVector
			dx, dz = look.X, look.Z
		end
		if math.abs(dx) >= math.abs(dz) then
			gateAxis = "X"
			gateSign = if dx >= 0 then 1 else -1
		else
			gateAxis = "Z"
			gateSign = if dz >= 0 then 1 else -1
		end
	end

	-- Cover core (~70% pad) but stop short of gate face so spawn road stays fly/walk open
	local GATE_FRONT_OPEN = 34 -- studs from gate-edge pad rim left uncovered
	local coverFrac = 0.72

	local sizeX: number
	local sizeZ: number
	local posX: number
	local posZ: number
	if gateAxis == "Z" then
		sizeX = halfX * 2 * coverFrac
		sizeZ = halfZ * 2 * coverFrac - GATE_FRONT_OPEN * 0.55
		sizeZ = math.max(sizeZ, halfZ * 0.85)
		posX = cx
		-- Shift toward CLOSED face (opposite gateSign)
		local closedEdge = cz - gateSign * halfZ
		local openEdge = cz + gateSign * halfZ
		-- Roof center: midway between closed edge and (open edge - GATE_FRONT_OPEN)
		local coveredOpen = openEdge - gateSign * GATE_FRONT_OPEN
		posZ = (closedEdge + coveredOpen) * 0.5
		-- Clamp size so roof does not spill past coveredOpen
		local span = math.abs(coveredOpen - closedEdge)
		sizeZ = math.min(sizeZ, span - 4)
		sizeZ = math.max(sizeZ, 40)
	else
		sizeZ = halfZ * 2 * coverFrac
		sizeX = halfX * 2 * coverFrac - GATE_FRONT_OPEN * 0.55
		sizeX = math.max(sizeX, halfX * 0.85)
		posZ = cz
		local closedEdge = cx - gateSign * halfX
		local openEdge = cx + gateSign * halfX
		local coveredOpen = openEdge - gateSign * GATE_FRONT_OPEN
		posX = (closedEdge + coveredOpen) * 0.5
		local span = math.abs(coveredOpen - closedEdge)
		sizeX = math.min(sizeX, span - 4)
		sizeX = math.max(sizeX, 40)
	end

	-- v67: the anti-heli roof is an invisible barrier high above every building. The visible slab, trims,
	-- posts, beams and rooftop pads made the whole base a dark warehouse and cut through two-storey buildings.
	local ceilingHeight = tonumber((StructureVisualConfig :: any).AntiAirCeilingHeight) or 48
	local roof = makePart({
		Name = "CeilingPlate",
		Size = Vector3.new(sizeX, 2, sizeZ),
		Position = Vector3.new(posX, padTop + ceilingHeight, posZ),
		Color = Color3.fromRGB(58, 68, 55),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 1,
		CanCollide = true,
		Parent = folder,
	})
	roof.CanTouch = false
	roof.CanQuery = false -- camera + weapon raycasts pass; helicopters still collide
	roof.CastShadow = false
	roof:SetAttribute("WE_BaseCeiling", true)
	roof:SetAttribute("PlotId", plotId)
	roof:SetAttribute("WE_CeilingLevel", lv)
	plotFolder:SetAttribute("WE_BaseCeiling", true)
end

function StructureKitBuilder.SyncCornerTowers(plotId: number, level: number)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local pad = findPlotPad(plotId)
	if not plotFolder or not pad then
		return
	end

	local existing = plotFolder:FindFirstChild(CORNER_FOLDER)
	if level <= 0 then
		if existing then
			existing:Destroy()
		end
		return
	end

	local folder: Folder
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = CORNER_FOLDER
		folder.Parent = plotFolder
	end

	local pal = paletteFor("Watchtowers")
	local lv = math.clamp(level, 1, 5)
	local half = math.max(pad.Size.X, pad.Size.Z) * 0.5 - 3
	local towerW = 7 + lv * 0.5
	local towerH = 26 + lv * 2.8 -- v33: taller corner watchtowers (≥28–40)
	local y = pad.Position.Y + pad.Size.Y * 0.5 + towerH * 0.5
	local cx, cz = pad.Position.X, pad.Position.Z
	local corners = {
		Vector3.new(cx - half, y, cz - half),
		Vector3.new(cx + half, y, cz - half),
		Vector3.new(cx - half, y, cz + half),
		Vector3.new(cx + half, y, cz + half),
	}
	-- v68: guard tower = concrete shaft + glazed cabin + roof, searchlight facing out
	-- (was a solid 7-10 stud concrete pillar with a rail ring). Names/attributes kept for other systems.
	local padTop = pad.Position.Y + pad.Size.Y * 0.5
	local cabinW = towerW + 1.5
	local shaftH = towerH - 4
	for i, pos in ipairs(corners) do
		local body = makePart({
			Name = "CornerTower" .. i,
			Size = Vector3.new(towerW - 2.5, shaftH, towerW - 2.5),
			Position = Vector3.new(pos.X, padTop + shaftH * 0.5, pos.Z),
			Color = pal.Body,
			Material = Enum.Material.Concrete,
			Transparency = 0,
			CanCollide = true,
			Parent = folder,
		})
		body.CastShadow = true
		body:SetAttribute("WE_CornerTower", true)
		local floorY = padTop + shaftH
		makePart({
			Name = "TowerPlatform" .. i,
			Size = Vector3.new(cabinW, 0.5, cabinW),
			Position = Vector3.new(pos.X, floorY + 0.25, pos.Z),
			Color = pal.Roof,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = true,
			Parent = folder,
		})
		-- low concrete band + glass band on all four sides
		for _, side in ipairs({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }) do
			local alongX = side.Z ~= 0
			local len = cabinW
			local c = Vector3.new(pos.X + side.X * (cabinW * 0.5 - 0.2), 0, pos.Z + side.Z * (cabinW * 0.5 - 0.2))
			makePart({
				Name = "TowerCabinWall" .. i,
				Size = Vector3.new(if alongX then len else 0.4, 1.0, if alongX then 0.4 else len),
				Position = Vector3.new(c.X, floorY + 1.0, c.Z),
				Color = pal.Body,
				Material = Enum.Material.Concrete,
				Transparency = 0,
				CanCollide = true,
				Parent = folder,
			})
			local glass = makePart({
				Name = "TowerCabinGlass" .. i,
				Size = Vector3.new(if alongX then len else 0.2, 2.0, if alongX then 0.2 else len),
				Position = Vector3.new(c.X, floorY + 2.5, c.Z),
				Color = Color3.fromRGB(140, 180, 200),
				Material = Enum.Material.Glass,
				Transparency = 0.45,
				CanCollide = false,
				Parent = folder,
			})
			glass.CastShadow = false
		end
		makePart({
			Name = "TowerCap" .. i,
			Size = Vector3.new(cabinW + 1.2, 0.6, cabinW + 1.2),
			Position = Vector3.new(pos.X, floorY + 3.8, pos.Z),
			Color = pal.Roof,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		-- searchlight on the roof edge, pointing away from the plot centre
		local out = Vector3.new(pos.X - cx, 0, pos.Z - cz)
		out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, 1)
		local lampPos = Vector3.new(pos.X + out.X * (cabinW * 0.5 - 0.6), floorY + 4.6, pos.Z + out.Z * (cabinW * 0.5 - 0.6))
		local lamp = makePart({
			Name = "TowerSearchlight" .. i,
			Size = Vector3.new(1.2, 1, 1.2),
			Position = lampPos,
			Color = Color3.fromRGB(255, 236, 200),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		lamp.CFrame = CFrame.lookAt(lampPos, lampPos + out)
		local lights = (StructureVisualConfig :: any).BuildingLights or {}
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 45
		spot.Range = math.min(50, lights.SpotMaxRange or 50)
		spot.Brightness = 1.5 * (lights.BrightnessScale or 1)
		spot.Color = Color3.fromRGB(255, 236, 200)
		spot.Shadows = false
		spot.Parent = lamp
		-- v70 (HUD spec §5): no red beacon ball on the cabin roof
		-- v36: 1–2 static sniper silhouettes on tower platforms (presence; GateDefense handles combat)
		local deckY = floorY + 0.5
		local shooterCount = if lv >= 3 then 2 else 1
		for s = 1, shooterCount do
			local ox = if s == 1 then -1.4 else 1.4
			local torso = makePart({
				Name = "TowerShooter" .. i .. "_" .. s,
				Size = Vector3.new(1.1, 1.6, 0.7),
				Position = Vector3.new(pos.X + ox, deckY + 1.0, pos.Z),
				Color = Color3.fromRGB(45, 55, 40),
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			torso:SetAttribute("WE_TowerShooter", true)
			makePart({
				Name = "TowerShooterHead" .. i .. "_" .. s,
				Size = Vector3.new(0.7, 0.7, 0.7),
				Position = Vector3.new(pos.X + ox, deckY + 2.05, pos.Z),
				Color = Color3.fromRGB(55, 65, 50),
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			makePart({
				Name = "TowerRifle" .. i .. "_" .. s,
				Size = Vector3.new(0.2, 0.2, 2.2),
				Position = Vector3.new(pos.X + ox, deckY + 1.35, pos.Z - 1.3),
				Color = Color3.fromRGB(30, 30, 32),
				Material = Enum.Material.Metal,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			-- v70 (HUD spec §5): no "SNIPER" cue billboard over the silhouette
		end
	end
end

--[[ v68: open / close the rear-zone gates (MapSetup LayoutGround.RearGate_<StructureId>) from the owner's
	upgrade levels. A gate opens once its structure is L1+: the leaves slide into the wall and stop colliding. ]]
local REAR_GATE_LABELS: { [string]: string } = { Airfield = "AIRFIELD", Helipad = "HELIPAD", Dock = "NAVAL DOCK" }

-- v70: lintel sign from the folder state: label (WE_GateLabel, else the rear-gate label) + OPEN, CLOSED (an armed
-- proximity gate waiting for a boat) or LOCKED.
local function refreshGateSign(gateFolder: Instance)
	local lintel = gateFolder:FindFirstChild("GateLintel")
	local sign = lintel and lintel:FindFirstChild("WE_GateSign")
	local text = sign and sign:FindFirstChild("Text")
	if not (text and text:IsA("TextLabel")) then
		return
	end
	local gid = gateFolder:GetAttribute("GateId")
	local gidText = if typeof(gid) == "string" then gid else "GATE"
	local label = gateFolder:GetAttribute("WE_GateLabel")
	local base = if typeof(label) == "string" then label else (REAR_GATE_LABELS[gidText] or string.upper(gidText))
	local suffix = " · LOCKED"
	if gateFolder:GetAttribute("WE_GateOpen") == true then
		suffix = " · OPEN"
	elseif gateFolder:GetAttribute("WE_GateMode") == "Proximity" and gateFolder:GetAttribute("WE_GateArmed") == true then
		suffix = " · CLOSED"
	end
	text.Text = base .. suffix
end

--[[ v70: open / close one gate folder (rear gate or sea gate). Every child leaf with a numeric WE_GateLeaf (slide
	sign) and a CFrame WE_ClosedCFrame slides along its OWN X by its width + 0.3 (into the wall line; identical to the
	old world-X slide on an unturned plot) and stops colliding; its BasePart children move with it. Idempotent:
	Waterways' sea-gate loop calls it only when the state changes. ]]
function StructureKitBuilder.SetGateOpen(gateFolder: Instance, open: boolean)
	for _, leaf in ipairs(gateFolder:GetChildren()) do
		local sx = leaf:GetAttribute("WE_GateLeaf")
		local closed = leaf:GetAttribute("WE_ClosedCFrame")
		if leaf:IsA("BasePart") and typeof(sx) == "number" and typeof(closed) == "CFrame" then
			local target = if open then closed * CFrame.new(sx * (leaf.Size.X + 0.3), 0, 0) else closed
			local shift = target.Position - leaf.Position
			leaf.CFrame = target
			leaf.CanCollide = not open
			for _, ch in ipairs(leaf:GetChildren()) do
				if ch:IsA("BasePart") then
					ch.CFrame = ch.CFrame + shift
				end
			end
		end
	end
	gateFolder:SetAttribute("WE_GateOpen", open)
	refreshGateSign(gateFolder)
end

function StructureKitBuilder.SyncRearGates(plotId: number, upgrades: { [string]: any }?)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local ground = plotFolder and plotFolder:FindFirstChild("LayoutGround")
	if not ground then
		return
	end
	for _, gateFolder in ipairs(ground:GetChildren()) do
		local gid = gateFolder:GetAttribute("GateId")
		if typeof(gid) == "string" then
			local lv = if upgrades then (tonumber(upgrades[gid]) or 0) else 0
			if gateFolder:GetAttribute("WE_GateMode") == "Proximity" then
				-- v70 sea gate: the structure only ARMS it. Waterways' loop opens an armed gate while a boat driven by
				-- the owner or an ally is near and closes it after; unarmed = closed (never a walk-in back door).
				local armed = lv >= 1
				gateFolder:SetAttribute("WE_GateArmed", armed)
				if armed then
					refreshGateSign(gateFolder)
				else
					StructureKitBuilder.SetGateOpen(gateFolder, false)
				end
			else
				StructureKitBuilder.SetGateOpen(gateFolder, lv >= 1)
			end
		end
	end
end

function StructureKitBuilder.ClearPlotExtras(plotId: number)
	StructureKitBuilder.SyncPerimeterWalls(plotId, 0)
	StructureKitBuilder.SyncRearGates(plotId, nil)
	StructureKitBuilder.SyncCornerTowers(plotId, 0)
	StructureKitBuilder.SyncBaseCeiling(plotId, 0)
	-- E) clear stale WE_OwnedLevel on unowned pads so next claimer does not see MAX with no kits
	local want = tonumber(plotId)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	-- v66: an ownerless plot must not keep a walk-in building standing
	if plotFolder then
		HollowBuildingBuilder.ClearUnder(plotFolder)
	end
	if plotFolder and want ~= nil then
		for _, desc in ipairs(plotFolder:GetDescendants()) do
			if desc:IsA("BasePart") and desc:GetAttribute("StructureId") ~= nil then
				if tonumber(desc:GetAttribute("PlotId") :: any) == want then
					desc:SetAttribute("WE_OwnedLevel", 0)
				end
			end
		end
	end
end

return StructureKitBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">StudioBuySmoke</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Studio-only auto BUY smoke.
	After profile + plot assign (~3–5s): teleport to plot, stand at the CC console (v71), PurchaseUpgrade(CommandCenter),
	print unmistakable [SMOKE] BUY lines, mirror into ServerStorage.SmokeResult,
	and FireAllClients(StudioSmokeLog) so Play Solo client Output also shows the result.

	NEVER runs outside RunService:IsStudio(). Product Ids stay 0 (no Marketplace).
	HttpService / %TEMP% file writes are unreliable from Studio Luau — prefer prints + remote.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"))
local ConsoleLocator = require(Shared.Util.ConsoleLocator)

local StudioBuySmoke = {}

local STRUCTURE_ID = "CommandCenter"
local DELAY_SEC = 4.0
local ranFor: { [number]: boolean } = {}

local smokeRemote: RemoteEvent? = nil

local function resolveSmokeRemote(): RemoteEvent?
	if smokeRemote and smokeRemote.Parent then
		return smokeRemote
	end
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if not folder then
		return nil
	end
	local ev = folder:FindFirstChild("StudioSmokeLog")
	if ev and ev:IsA("RemoteEvent") then
		smokeRemote = ev
		return ev
	end
	return nil
end

local function writeResult(line: string)
	local folder = ServerStorage:FindFirstChild("SmokeResult")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "SmokeResult"
		folder.Parent = ServerStorage
	end
	local sv = folder:FindFirstChild("LastBuy")
	if not sv then
		sv = Instance.new("StringValue")
		sv.Name = "LastBuy"
		sv.Parent = folder
	end
	sv.Value = line
	local log = folder:FindFirstChild("Log")
	if not log then
		log = Instance.new("StringValue")
		log.Name = "Log"
		log.Parent = folder
	end
	local prev = log.Value
	if #prev > 4000 then
		prev = string.sub(prev, -2000)
	end
	log.Value = prev .. (if prev ~= "" then "\n" else "") .. line
end

local function broadcast(kind: string, line: string)
	local ev = resolveSmokeRemote()
	if ev then
		ev:FireAllClients(kind, line, os.clock())
	end
end

local function smokeLine(kind: string, detail: string)
	local line = string.format("[SMOKE] BUY %s %s", kind, detail)
	-- Louder than a single print: banner + warn on FAIL so Output filter can't miss it
	print("========== " .. line .. " ==========")
	print(line)
	if kind == "FAIL" then
		warn(line)
	elseif kind == "OK" then
		print("[SMOKE] ★★★ BUY PATH OK ★★★")
	end
	writeResult(line)
	broadcast(kind, line)
	return line
end

-- v71 console-only buying has no bypass: the smoke stands its character at the structure's own console (the same
-- spot a player uses), so every Studio Play also exercises the server presence gate end to end.
local function standAtConsole(BaseService: any, player: Player, structureId: string): string
	local plotId = if BaseService.GetOwnedPlotId then BaseService.GetOwnedPlotId(player) else nil
	local char = player.Character
	if plotId == nil or char == nil then
		return "no plot / character"
	end
	local part = ConsoleLocator.Find(plotId, structureId)
	if part == nil then
		return "no console part"
	end
	char:PivotTo(ConsoleLocator.StandCFrame(part))
	return "ok"
end

function StudioBuySmoke.Init(deps: { [string]: any })
	if not RunService:IsStudio() then
		return
	end

	local DataService = deps.DataService
	local BaseService = deps.BaseService
	if not DataService or not BaseService then
		warn("[SMOKE] BUY FAIL deps missing DataService/BaseService")
		broadcast("FAIL", "[SMOKE] BUY FAIL deps missing DataService/BaseService")
		return
	end

	-- Resolve remote early (RemoteSetup runs before this)
	task.defer(function()
		local ev = resolveSmokeRemote()
		if ev then
			print("[SMOKE] StudioSmokeLog remote ready — client Output will mirror BUY lines")
		else
			warn("[SMOKE] StudioSmokeLog remote missing — server prints only")
		end
	end)

	print("[SMOKE] StudioBuySmoke armed (IsStudio=true) — will auto-BUY CommandCenter ~4s after plot assign")
	print("[SMOKE] Watch Output for: [SMOKE] BUY START / OK / FAIL  (also FireAllClients StudioSmokeLog)")

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		if ranFor[player.UserId] then
			return
		end
		ranFor[player.UserId] = true

		task.delay(DELAY_SEC, function()
			if not player.Parent then
				smokeLine("FAIL", "player left before smoke")
				return
			end

			local profile = DataService.GetProfile(player)
			if not profile then
				smokeLine("FAIL", "NoProfile after delay")
				return
			end

			-- Ensure plot + standing on it
			if profile.BasePlotId == nil and BaseService.AssignPlot then
				BaseService.AssignPlot(player)
				profile = DataService.GetProfile(player) or profile
			end
			if BaseService.TeleportToPlot then
				BaseService.TeleportToPlot(player)
			end

			local cashBefore = tonumber(profile.Cash) or 0
			local levelBefore = tonumber(profile.BaseUpgrades and profile.BaseUpgrades[STRUCTURE_ID]) or 0

			-- Studio-only: ensure one upgrade can succeed (cash + not already MaxLevel)
			local EconomyService = deps.EconomyService
			local Shared = ReplicatedStorage:FindFirstChild("Shared")
			if Shared then
				local okCfg, BaseConfig = pcall(function()
					return require(Shared.Configs.BaseConfig)
				end)
				if okCfg and typeof(BaseConfig) == "table" then
					local def = BaseConfig.Structures and BaseConfig.Structures[STRUCTURE_ID]
					local maxLevel = if def then (tonumber(def.MaxLevel) or 5) else 5
					if levelBefore >= maxLevel then
						profile.BaseUpgrades[STRUCTURE_ID] = maxLevel - 1
						levelBefore = maxLevel - 1
						DataService.MarkDirty(player)
					end
					local nextLevel = levelBefore + 1
					local cost = def and def.Costs and def.Costs[nextLevel]
					if typeof(cost) == "number" and cashBefore < cost and EconomyService and EconomyService.AddCash then
						EconomyService.AddCash(player, cost - cashBefore, "studio_smoke_buy")
						profile = DataService.GetProfile(player) or profile
						cashBefore = tonumber(profile.Cash) or cashBefore
					end
				end
			end

			smokeLine("START", string.format(
				"player=%s cash=%d level=%d structure=%s plot=%s",
				player.Name,
				cashBefore,
				levelBefore,
				STRUCTURE_ID,
				tostring(profile.BasePlotId)
			))

			local okCall, resultOrErr = pcall(function()
				-- v71: stand at the Command Center console first (no bypass; a far-away buy answers NotAtConsole)
				print("[SMOKE] stand at console: " .. standAtConsole(BaseService, player, STRUCTURE_ID))
				return BaseService.PurchaseUpgrade(player, STRUCTURE_ID, { Source = "Smoke" })
			end)
			if not okCall then
				smokeLine("FAIL", "pcall error: " .. tostring(resultOrErr))
				return
			end

			local result = resultOrErr
			if typeof(result) ~= "table" then
				smokeLine("FAIL", "bad result type=" .. typeof(result))
				return
			end

			profile = DataService.GetProfile(player) or profile
			local cashAfter = tonumber(result.Cash) or tonumber(profile.Cash) or cashBefore
			local levelAfter = tonumber(result.NewLevel)
				or tonumber(profile.BaseUpgrades and profile.BaseUpgrades[STRUCTURE_ID])
				or levelBefore

			if result.Ok == true then
				smokeLine("OK", string.format("newCash=%d level=%d structure=%s", cashAfter, levelAfter, STRUCTURE_ID))
				-- Follow-up: Barracks buy path (~2s later) so pad chain is exercised
				task.delay(2.0, function()
					if not player.Parent then
						return
					end
					local barracksId = "Barracks"
					local prof2 = DataService.GetProfile(player)
					if not prof2 then
						smokeLine("FAIL", "Barracks follow-up NoProfile")
						return
					end
					local lvlB = tonumber(prof2.BaseUpgrades and prof2.BaseUpgrades[barracksId]) or 0
					local cashB = tonumber(prof2.Cash) or 0
					local Shared2 = ReplicatedStorage:FindFirstChild("Shared")
					if Shared2 then
						local okCfg2, BaseConfig2 = pcall(function()
							return require(Shared2.Configs.BaseConfig)
						end)
						if okCfg2 and typeof(BaseConfig2) == "table" then
							local defB = BaseConfig2.Structures and BaseConfig2.Structures[barracksId]
							local maxB = if defB then (tonumber(defB.MaxLevel) or 5) else 5
							if lvlB >= maxB then
								prof2.BaseUpgrades[barracksId] = maxB - 1
								lvlB = maxB - 1
								DataService.MarkDirty(player)
							end
							local nextB = lvlB + 1
							local costB = defB and defB.Costs and defB.Costs[nextB]
							if typeof(costB) == "number" and cashB < costB and EconomyService and EconomyService.AddCash then
								EconomyService.AddCash(player, costB - cashB, "studio_smoke_buy_barracks")
								prof2 = DataService.GetProfile(player) or prof2
								cashB = tonumber(prof2.Cash) or cashB
							end
						end
					end
					smokeLine("START", string.format("follow-up structure=%s cash=%d level=%d", barracksId, cashB, lvlB))
					local okB, resB = pcall(function()
						print("[SMOKE] stand at console: " .. standAtConsole(BaseService, player, barracksId))
						return BaseService.PurchaseUpgrade(player, barracksId, { Source = "Smoke" })
					end)
					if not okB then
						smokeLine("FAIL", "Barracks pcall: " .. tostring(resB))
						return
					end
					if typeof(resB) == "table" and resB.Ok == true then
						smokeLine("OK", string.format("follow-up Barracks newLevel=%s cash=%s", tostring(resB.NewLevel), tostring(resB.Cash)))
					else
						local errB = if typeof(resB) == "table" then tostring(resB.Error) else typeof(resB)
						smokeLine("FAIL", "Barracks follow-up err=" .. errB)
					end
				end)
			else
				smokeLine("FAIL", string.format("err=%s cash=%d level=%d", tostring(result.Error), cashAfter, levelAfter))
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		ranFor[player.UserId] = nil
	end)
end

return StudioBuySmoke
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">VehicleHealth</string>
            <string name="Source"><![CDATA[--!strict
--[[
	VehicleHealth — server-only HP for EVERY vehicle (W2 CC-2; money plan M4; premium_vehicles.md §3; contracts §4).
	Numbers: Shared/Configs/VehicleCombatConfig.luau. Server module: never required by client code.

	  * MaxHP = def.Health × clamp(WE_ArmorMult, Health.ArmorMultClamp) × Health.GlobalHPMult × (opts.HPMult or 1).
	    A later WE_ArmorMult change (research, VehicleService.OnResearchChanged) rescales MaxHP and keeps the HP fraction.
	  * dealt = min(HP, Amount × VehicleCombatConfig.DamageMult(class, def.Armor, WeaponMult)). The class math lives
	    here only: callers pass the raw amount (CombatService.ApplyHit never applies armor).
	  * Refused (0, false): not registered · destroyed · IsProtected (owner / someone seated in it / 5 s spawn
	    protection / trial vehicle / an attacker seated in a trial vehicle).
	  * HP 0: OnWrecked (VehicleService: charred look, server physics, seats off) → WE_Destroyed → every occupant is
	    ejected and takes Destroy.OccupantDamage (players through deps.CombatService.ApplyHit with the killer's tag,
	    squad units TakeDamage) → bounty to the last attacker within KillerWindowSeconds (not self / clan-mate /
	    trial / the same killer-victim pair within PairCooldownSeconds) → VEHICLE_DESTROYED analytics → repair lock
	    (Premium 20 s / Cash 45 s) → OnDestroyed after DebrisSeconds (VehicleService teardown). No server Explosion.
	  * Regen (1 Hz) after DelayAfterDamageSeconds: premium 1.5 %/s anywhere; Cash vehicles 2 %/s only while the
	    Chassis is on the owner's plot pad (profile.BasePlotId).
	  * Replication: WE_HP / WE_MaxHP (integers, ceil) flushed from a dirty flag at Health.AttrHz (10 Hz) for all
	    vehicles together; WE_Destroyed at once. Display only: nothing reads them back.
	  * Every dep is optional (nil-guarded + pcall). Safe to call before Init (empty registry, no loop yet).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local Constants = require(Shared.Constants)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local VehicleCombatConfig = require(Shared.Configs.VehicleCombatConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local NukeConfig = require(Shared.Configs.NukeConfig)

type VehicleDef = VehicleConfig.VehicleDef

export type Record = {
	Model: Model,
	VehicleId: string,
	OwnerUserId: number,
	MaxHP: number,
	HP: number,
	Armor: number,
	Premium: boolean,
	Trial: boolean,
	SpawnedAt: number,
	LastDamagedAt: number,
	LastAttackerUserId: number?,
	LastAttackerAt: number,
	Destroyed: boolean,
	OnDestroyed: (rec: Record, killer: Player?) -> (),
}
export type DamageHit = {
	Attacker: Player?,
	Amount: number,
	Class: string?,
	WeaponId: string?,
	WeaponMult: number?,
	HitPos: Vector3?,
}
export type RadiusOpts = {
	MinMult: number?, -- default 0.25 at the edge (linear)
	IgnoreUserId: number?, -- vehicles owned by this user are skipped
	SkipOwner: ((ownerUserId: number) -> boolean)?, -- true = skip (nuke immunity)
	CoreRadius: number?, -- class with CoreDestroys (Nuke, J8): within this, destroyed outright
	WeaponId: string?,
	WeaponMult: number?,
	IgnoreModel: Model?, -- the firing vehicle / the direct-hit vehicle
}
export type RegisterOpts = {
	Trial: boolean?,
	Premium: boolean?,
	HPMult: number?, -- M7c Tank Factory (J9); W2 passes nil
	OnWrecked: ((rec: Record) -> ())?,
	OnDestroyed: (rec: Record, killer: Player?) -> (),
}

type Entry = {
	Rec: Record,
	Def: VehicleDef,
	Owner: Player,
	HPMult: number,
	ArmorMult: number,
	OnWrecked: ((rec: Record) -> ())?,
	LastAttacker: Player?,
	LastClass: string,
	Dirty: boolean,
	WrittenHP: number,
	WrittenMax: number,
	Conns: { RBXScriptConnection },
}

local HCFG = VehicleCombatConfig.Health
local DCFG = VehicleCombatConfig.Destroy
local RCFG = VehicleCombatConfig.Regen
local BOUNTY = DCFG.Reward

local VehicleHealth = {}

local entries: { [Model]: Entry } = {}
local destroyedUntil: { [number]: { [string]: number } } = {} -- [ownerUserId][vehicleId] = os.clock() deadline
local bountyPairs: { [string]: number } = {} -- "killer:victim" → os.clock() of the last paid bounty
local ownerHitAt: { [number]: number } = {} -- [ownerUserId] = os.clock() a live vehicle of theirs last took damage (W2 verify)
local plotCache: { [number]: BasePart } = {}
local deps: { [string]: any } = {}
local loop = { Inited = false, NextFlushAt = -math.huge, NextRegenAt = -math.huge, LastRegenAt = nil :: number? }

local function now(): number
	return os.clock()
end

local function finite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

local function round3(x: number): number
	return math.floor(x * 1000 + 0.5) / 1000
end

-- WE_ArmorMult (research VehicleArmor, written by VehicleService) clamped to Health.ArmorMultClamp
local function armorMultOf(model: Model): number
	local v = tonumber(model:GetAttribute("WE_ArmorMult")) or 1
	if not finite(v) then
		v = 1
	end
	local c = HCFG.ArmorMultClamp
	return math.clamp(v, c[1] or 1, c[2] or 1.5)
end

local function maxHPFor(def: VehicleDef, armorMult: number, hpMult: number): number
	local base = math.max(1, tonumber(def.Health) or 1)
	local g = tonumber(HCFG.GlobalHPMult) or 1
	if not (g > 0) then
		g = 1
	end
	return math.max(1, round3(base * armorMult * g * hpMult))
end

-- (class, WeaponMult): an explicit known class wins; else InfantryWeapons[WeaponId] or DefaultInfantryClass.
-- WeaponMult defaults to the InfantryWeapons row only when that row's class is the one applied.
local function resolveClass(className: string?, weaponId: string?, weaponMult: number?): (string, number)
	local iw = if typeof(weaponId) == "string" then VehicleCombatConfig.InfantryWeapons[weaponId] else nil
	local cls: string = VehicleCombatConfig.DefaultInfantryClass
	if typeof(className) == "string" and VehicleCombatConfig.DamageClasses[className] ~= nil then
		cls = className
	elseif iw then
		cls = iw.Class
	end
	local m = if typeof(weaponMult) == "number" then weaponMult else nil
	if m == nil or not finite(m) or m < 0 then
		m = if iw and iw.Class == cls then iw.Mult else 1
	end
	return cls, m :: number
end

local function writeAttrs(e: Entry, force: boolean)
	local rec = e.Rec
	local model = rec.Model
	local hpI = math.max(0, math.ceil(rec.HP - 1e-6))
	local maxI = math.max(1, math.ceil(rec.MaxHP - 1e-6))
	e.Dirty = false
	if force or hpI ~= e.WrittenHP then
		e.WrittenHP = hpI
		model:SetAttribute("WE_HP", hpI)
	end
	if force or maxI ~= e.WrittenMax then
		e.WrittenMax = maxI
		model:SetAttribute("WE_MaxHP", maxI)
	end
end

local function playerIsIn(player: Player): boolean
	return player.Parent ~= nil
end

-- the vehicle's last attacker, if they hit it within KillerWindowSeconds and are still in the server
local function killerOf(e: Entry, t: number): Player?
	local p = e.LastAttacker
	if p and playerIsIn(p) and t - e.Rec.LastAttackerAt <= BOUNTY.KillerWindowSeconds then
		return p
	end
	return nil
end

local function clanOf(player: Player?): string?
	local cs = deps.ClanService
	if player == nil or cs == nil or typeof(cs.GetClanId) ~= "function" then
		return nil
	end
	local ok, id = pcall(cs.GetClanId, player)
	if ok and typeof(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

local function sameClan(a: Player, b: Player?): boolean
	local ca = clanOf(a)
	return ca ~= nil and ca == clanOf(b)
end

-- Destroy.OccupantDamage to one ejected occupant (players: CombatService.ApplyHit with the killer's creator tag;
-- squad units / anything else: TakeDamage). A missing ApplyHit (older CombatService) falls back to TakeDamage.
local function damageOccupant(hum: Humanoid, killer: Player?)
	local amount = DCFG.OccupantDamage
	local char = hum.Parent
	local player = if char then Players:GetPlayerFromCharacter(char) else nil
	if player and char then
		local cs = deps.CombatService
		local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
		if cs and typeof(cs.ApplyHit) == "function" and root then
			local ok = pcall(cs.ApplyHit, killer, root, amount, { WeaponId = "VehicleWreck" })
			if ok then
				return
			end
		end
	end
	pcall(function()
		hum:TakeDamage(amount)
	end)
end

local function payBounty(e: Entry, killer: Player?)
	if killer == nil or not playerIsIn(killer) then
		return
	end
	local rec = e.Rec
	if rec.Trial or killer.UserId == rec.OwnerUserId then
		return
	end
	if sameClan(killer, e.Owner) then
		return
	end
	local key = tostring(killer.UserId) .. ":" .. tostring(rec.OwnerUserId)
	local t = now()
	local last = bountyPairs[key]
	if last ~= nil and t - last < BOUNTY.PairCooldownSeconds then
		return
	end
	bountyPairs[key] = t
	local cash = math.floor(math.min(rec.MaxHP * BOUNTY.CashPerHP, BOUNTY.CashMax))
	local xp = math.floor(math.min(rec.MaxHP * BOUNTY.XPPerHP, BOUNTY.XPMax))
	local econ = deps.EconomyService
	if cash > 0 and econ and typeof(econ.AddCash) == "function" then
		pcall(econ.AddCash, killer, cash, BOUNTY.CashReason)
	end
	local xps = deps.XPService
	if xp > 0 and xps and typeof(xps.AddXP) == "function" then
		pcall(xps.AddXP, killer, xp, BOUNTY.XPReason)
	end
	local ns = deps.NotificationService
	if ns and typeof(ns.Notify) == "function" then
		-- same shape as an NPC kill ("<name> down (+$N)"): the HUD turns it into a cash float, no lane line
		pcall(ns.Notify, killer, string.format("%s down (+$%d)", e.Def.DisplayName, cash), "Reward")
	end
end

local function destroyVehicle(e: Entry, killer: Player?)
	local rec = e.Rec
	local model = rec.Model
	rec.Destroyed = true
	rec.HP = 0
	e.Dirty = true
	-- occupants first: a disabled seat (OnWrecked) drops its occupant
	local seats: { BasePart } = {}
	local occupants: { Humanoid } = {}
	for _, d in ipairs(model:GetDescendants()) do
		local occ: Humanoid? = nil
		if d:IsA("VehicleSeat") then
			table.insert(seats, d)
			occ = d.Occupant
		elseif d:IsA("Seat") then
			table.insert(seats, d)
			occ = d.Occupant
		end
		if occ then
			table.insert(occupants, occ)
		end
	end
	local wrecked = e.OnWrecked
	if wrecked then
		local ok, err = pcall(wrecked :: any, rec)
		if not ok then
			warn("[VehicleHealth] OnWrecked failed", rec.VehicleId, err)
		end
	end
	pcall(function()
		model:SetAttribute("WE_Destroyed", true)
	end)
	for _, seat in ipairs(seats) do
		local weld = seat:FindFirstChild("SeatWeld")
		if weld then
			pcall(function()
				weld:Destroy()
			end)
		end
	end
	for _, hum in ipairs(occupants) do
		pcall(function()
			hum.Sit = false
		end)
		damageOccupant(hum, killer)
	end
	payBounty(e, killer)
	local an = deps.AnalyticsService
	if an and typeof(an.Log) == "function" then
		local killerId = if killer then killer.UserId else 0
		pcall(an.Log, AnalyticsConfig.Events.VEHICLE_DESTROYED, killerId, {
			vehicle = rec.VehicleId,
			premium = rec.Premium,
			killer = killerId,
			class = e.LastClass,
		})
	end
	local secs = if rec.Premium then DCFG.RepairSeconds.Premium else DCFG.RepairSeconds.Default
	local byUser = destroyedUntil[rec.OwnerUserId]
	if byUser == nil then
		byUser = {}
		destroyedUntil[rec.OwnerUserId] = byUser
	end
	byUser[rec.VehicleId] = now() + secs
	task.delay(DCFG.DebrisSeconds, function()
		-- only while this record is still the live one (a SPAWN / despawn / leave may have torn it down already)
		if entries[model] == e then
			local ok, err = pcall(rec.OnDestroyed :: any, rec, killer)
			if not ok then
				warn("[VehicleHealth] OnDestroyed failed", rec.VehicleId, err)
			end
		end
	end)
end

local function findPlot(plotId: number): BasePart?
	local cached = plotCache[plotId]
	if cached and cached.Parent ~= nil and cached:GetAttribute("PlotId") == plotId then
		return cached
	end
	plotCache[plotId] = nil
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			plotCache[plotId] = inst
			return inst
		end
	end
	return nil
end

-- the Chassis stands on the owner's plot pad (its CFrame carries the plot yaw; profile.BasePlotId)
local function inOwnPlot(e: Entry): boolean
	local ds = deps.DataService
	if ds == nil or typeof(ds.GetProfile) ~= "function" then
		return false
	end
	local ok, profile = pcall(ds.GetProfile, e.Owner)
	local plotId = if ok and typeof(profile) == "table" then tonumber(profile.BasePlotId) else nil
	if plotId == nil then
		return false
	end
	local plot = findPlot(plotId)
	local chassis = e.Rec.Model.PrimaryPart
	if plot == nil or chassis == nil then
		return false
	end
	local lp = plot.CFrame:PointToObjectSpace(chassis.Position)
	return math.abs(lp.X) <= plot.Size.X * 0.5 and math.abs(lp.Z) <= plot.Size.Z * 0.5
end

local function regenStep(t: number, dt: number)
	for _, e in pairs(entries) do
		local rec = e.Rec
		if not rec.Destroyed and rec.HP < rec.MaxHP and t - rec.LastDamagedAt >= RCFG.DelayAfterDamageSeconds then
			local pct = 0
			if rec.Premium then
				pct = RCFG.PremiumPctPerSec
			elseif inOwnPlot(e) then
				pct = RCFG.OwnPlotPctPerSec
			end
			if pct > 0 then
				rec.HP = math.min(rec.MaxHP, rec.HP + rec.MaxHP * pct * dt)
				e.Dirty = true
			end
		end
	end
	-- prune expired repair locks and bounty pairs
	for uid, byUser in pairs(destroyedUntil) do
		for vid, untilT in pairs(byUser) do
			if untilT <= t then
				byUser[vid] = nil
			end
		end
		if next(byUser) == nil then
			destroyedUntil[uid] = nil
		end
	end
	for key, at in pairs(bountyPairs) do
		if t - at >= BOUNTY.PairCooldownSeconds then
			bountyPairs[key] = nil
		end
	end
end

-- distance from p to the model's Chassis box (0 inside it); nil without a PrimaryPart
local function distanceTo(model: Model, p: Vector3): number?
	local chassis = model.PrimaryPart
	if chassis == nil then
		return nil
	end
	local lp = chassis.CFrame:PointToObjectSpace(p)
	local h = chassis.Size * 0.5
	local c = Vector3.new(math.clamp(lp.X, -h.X, h.X), math.clamp(lp.Y, -h.Y, h.Y), math.clamp(lp.Z, -h.Z, h.Z))
	return (lp - c).Magnitude
end

-- J8: a CoreDestroys class destroys outright inside CoreRadius; the nuke's own switch is NukeConfig.Vehicles
local function coreAllowed(className: string): boolean
	local cls = VehicleCombatConfig.DamageClasses[className]
	if cls == nil or cls.CoreDestroys ~= true then
		return false
	end
	if className == "Nuke" then
		local nv: any = (NukeConfig :: any).Vehicles
		return not (typeof(nv) == "table" and nv.CoreDestroys == false)
	end
	return true
end

-- ── API ─────────────────────────────────────────────────────────────────────────────────────────

function VehicleHealth.Init(d: { [string]: any })
	if typeof(d) == "table" then
		deps = d
	end
	if loop.Inited then
		return
	end
	loop.Inited = true
	RunService.Heartbeat:Connect(function()
		VehicleHealth._Step(now())
	end)
end

--[[ Seat and model attributes at build (VehicleService.buildVehicleModel, before parenting): WE_Premium, and on
	each seat WE_SeatRole ("Driver" DriverSeat / "Passenger" PassengerSeatN), WE_Exposed and (passengers)
	WE_CanFireFromSeat = SeatFire.OpenFamilies[def.KitFamily]. ]]
function VehicleHealth.ApplySeatAttributes(model: Model, def: VehicleDef)
	local family: string = def.KitFamily or "WheeledLight"
	local open = VehicleCombatConfig.SeatFire.OpenFamilies[family] == true
	model:SetAttribute("WE_Premium", (def :: any).Premium ~= nil)
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("VehicleSeat") or (c:IsA("BasePart") and c.Name == "DriverSeat") then
			c:SetAttribute("WE_SeatRole", "Driver")
			c:SetAttribute("WE_Exposed", open)
		elseif c:IsA("Seat") and string.sub(c.Name, 1, 13) == "PassengerSeat" then
			c:SetAttribute("WE_SeatRole", "Passenger")
			c:SetAttribute("WE_Exposed", open)
			c:SetAttribute("WE_CanFireFromSeat", open)
		end
	end
end

function VehicleHealth.Register(model: Model, def: VehicleDef, owner: Player, opts: RegisterOpts): Record
	if entries[model] then
		VehicleHealth.Unregister(model)
	end
	local t = now()
	local hpMult = tonumber(opts.HPMult) or 1
	if not (hpMult > 0) or not finite(hpMult) then
		hpMult = 1
	end
	local am = armorMultOf(model)
	local maxHP = maxHPFor(def, am, hpMult)
	local rec: Record = {
		Model = model,
		VehicleId = def.Id,
		OwnerUserId = owner.UserId,
		MaxHP = maxHP,
		HP = maxHP,
		Armor = math.max(0, tonumber(def.Armor) or 0),
		Premium = opts.Premium == true,
		Trial = opts.Trial == true,
		SpawnedAt = t,
		LastDamagedAt = -math.huge,
		LastAttackerUserId = nil,
		LastAttackerAt = -math.huge,
		Destroyed = false,
		OnDestroyed = opts.OnDestroyed,
	}
	local e: Entry = {
		Rec = rec,
		Def = def,
		Owner = owner,
		HPMult = hpMult,
		ArmorMult = am,
		OnWrecked = opts.OnWrecked,
		LastAttacker = nil,
		LastClass = VehicleCombatConfig.DefaultInfantryClass,
		Dirty = false,
		WrittenHP = -1,
		WrittenMax = -1,
		Conns = {},
	}
	entries[model] = e
	writeAttrs(e, true)
	model:SetAttribute("WE_Destroyed", false)
	table.insert(
		e.Conns,
		model:GetAttributeChangedSignal("WE_ArmorMult"):Connect(function()
			VehicleHealth.RefreshMaxHP(model)
		end)
	)
	table.insert(
		e.Conns,
		model.AncestryChanged:Connect(function()
			if model.Parent == nil and entries[model] == e then
				VehicleHealth.Unregister(model)
			end
		end)
	)
	return rec
end

function VehicleHealth.Unregister(model: Model)
	local e = entries[model]
	if e == nil then
		return
	end
	entries[model] = nil
	for _, c in ipairs(e.Conns) do
		c:Disconnect()
	end
	table.clear(e.Conns)
end

function VehicleHealth.Get(model: Model): Record?
	local e = entries[model]
	return if e then e.Rec else nil
end

-- nearest ancestor (or self) tagged Constants.Tags.Vehicle, registered or not (catalog dress sub-models included)
function VehicleHealth.FindVehicleModel(inst: Instance): Model?
	local cur: Instance? = inst
	while cur ~= nil do
		if cur:IsA("Model") and CollectionService:HasTag(cur, Constants.Tags.Vehicle) then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

function VehicleHealth.GetSeatedVehicle(player: Player): (Model?, BasePart?)
	local char = player.Character
	local hum = if char then char:FindFirstChildOfClass("Humanoid") else nil
	local seat = if hum then hum.SeatPart else nil
	if seat == nil then
		return nil, nil
	end
	return VehicleHealth.FindVehicleModel(seat), seat
end

--[[ true = attacker may not damage this vehicle: unregistered · trial · inside SpawnProtectSeconds · the attacker
	owns it or sits in it · the attacker sits in a trial vehicle (Trial.DealsVehicleDamage false). ]]
function VehicleHealth.IsProtected(model: Model, attacker: Player?): boolean
	local e = entries[model]
	if e == nil then
		return true
	end
	local rec = e.Rec
	if rec.Trial and VehicleCombatConfig.Trial.TakesDamage ~= true then
		return true
	end
	if now() - rec.SpawnedAt < HCFG.SpawnProtectSeconds then
		return true
	end
	if attacker then
		if attacker.UserId == rec.OwnerUserId then
			return true
		end
		local seatedIn = VehicleHealth.GetSeatedVehicle(attacker)
		if seatedIn == model then
			return true
		end
		local ae = if seatedIn then entries[seatedIn] else nil
		if ae and ae.Rec.Trial and VehicleCombatConfig.Trial.DealsVehicleDamage ~= true then
			return true
		end
	end
	return false
end

function VehicleHealth.ApplyDamage(model: Model, hit: DamageHit): (number, boolean)
	local e = entries[model]
	if e == nil or typeof(hit) ~= "table" then
		return 0, false
	end
	local rec = e.Rec
	if rec.Destroyed then
		return 0, false
	end
	local amount = tonumber(hit.Amount)
	if amount == nil or not (amount > 0) then
		return 0, false
	end
	local attacker = hit.Attacker
	if VehicleHealth.IsProtected(model, attacker) then
		return 0, false
	end
	local cls, wmult = resolveClass(hit.Class, hit.WeaponId, hit.WeaponMult)
	local mult = VehicleCombatConfig.DamageMult(cls, rec.Armor, wmult)
	if not (mult > 0) then
		return 0, false
	end
	local raw = amount * mult -- math.huge (CoreDestroys) stays huge → the whole HP
	local dealt = if raw >= rec.HP then rec.HP else raw
	local t = now()
	rec.HP -= dealt
	rec.LastDamagedAt = t
	e.LastClass = cls
	if attacker then
		rec.LastAttackerUserId = attacker.UserId
		rec.LastAttackerAt = t
		e.LastAttacker = attacker
	end
	e.Dirty = true
	if rec.HP <= 0 then
		rec.HP = 0
		ownerHitAt[rec.OwnerUserId] = nil -- a wreck is covered by the repair timer
		destroyVehicle(e, killerOf(e, t))
		return dealt, true
	end
	ownerHitAt[rec.OwnerUserId] = t
	return dealt, false
end

function VehicleHealth.ApplyRadiusDamage(
	center: Vector3,
	radius: number,
	maxAmount: number,
	attacker: Player?,
	class: string,
	opts: RadiusOpts?
): { Model }
	local hitList: { Model } = {}
	if typeof(center) ~= "Vector3" or not (radius > 0) or not (maxAmount > 0) then
		return hitList
	end
	local o: RadiusOpts = opts or {}
	local minMult = math.clamp(tonumber(o.MinMult) or 0.25, 0, 1)
	local core = if coreAllowed(class) then tonumber(o.CoreRadius) else nil
	local list: { Entry } = {}
	for model, e in pairs(entries) do
		if not e.Rec.Destroyed and model ~= o.IgnoreModel then
			table.insert(list, e)
		end
	end
	for _, e in ipairs(list) do
		local rec = e.Rec
		if o.IgnoreUserId ~= nil and rec.OwnerUserId == o.IgnoreUserId then
			continue
		end
		local skipFn = o.SkipOwner
		if skipFn then
			local ok, skip = pcall(skipFn, rec.OwnerUserId)
			if ok and skip == true then
				continue
			end
		end
		local d = distanceTo(rec.Model, center)
		if d == nil or d > radius then
			continue
		end
		local amount = if core ~= nil and d <= core
			then math.huge
			else maxAmount * (1 + (minMult - 1) * math.clamp(d / radius, 0, 1))
		local dealt = VehicleHealth.ApplyDamage(rec.Model, {
			Attacker = attacker,
			Amount = amount,
			Class = class,
			WeaponId = o.WeaponId,
			WeaponMult = o.WeaponMult,
			HitPos = center,
		})
		if dealt > 0 then
			table.insert(hitList, rec.Model)
		end
	end
	return hitList
end

-- research: WE_ArmorMult changed → rescale MaxHP, keep the HP fraction (no-op when unchanged)
function VehicleHealth.RefreshMaxHP(model: Model)
	local e = entries[model]
	if e == nil or e.Rec.Destroyed then
		return
	end
	local am = armorMultOf(model)
	if am == e.ArmorMult then
		return
	end
	e.ArmorMult = am
	local rec = e.Rec
	local frac = if rec.MaxHP > 0 then math.clamp(rec.HP / rec.MaxHP, 0, 1) else 1
	rec.MaxHP = maxHPFor(e.Def, am, e.HPMult)
	rec.HP = rec.MaxHP * frac
	e.Dirty = true
end

-- heal a live vehicle by pct of MaxHP (0..1; a value above 1 is read as percent, e.g. 50 = 50 %)
function VehicleHealth.Repair(model: Model, pct: number)
	local e = entries[model]
	local p = tonumber(pct)
	if e == nil or e.Rec.Destroyed or p == nil or not (p > 0) then
		return
	end
	if p > 1 then
		p = p / 100
	end
	local rec = e.Rec
	rec.HP = math.min(rec.MaxHP, rec.HP + rec.MaxHP * math.min(p :: number, 1))
	e.Dirty = true
end

-- seconds until that vehicle id may be redeployed by that player (0 = ready)
function VehicleHealth.RepairLeft(userId: number, vehicleId: string): number
	local byUser = destroyedUntil[userId]
	local untilT = if byUser then byUser[vehicleId] else nil
	if byUser == nil or untilT == nil then
		return 0
	end
	local left = untilT - now()
	if left <= 0 then
		byUser[vehicleId] = nil
		return 0
	end
	return left
end

--[[ W2 verify: seconds left of `lockSeconds` since a live vehicle of this owner last took damage (0 = none). VehicleService
	refuses SPAWN meanwhile, so SPAWN or Despawn + SPAWN is never a full heal in the middle of a fight. ]]
function VehicleHealth.HitLockLeft(userId: number, lockSeconds: number): number
	local at = ownerHitAt[userId]
	if at == nil then
		return 0
	end
	local left = (tonumber(lockSeconds) or 0) - (now() - at)
	if left <= 0 then
		ownerHitAt[userId] = nil
		return 0
	end
	return left
end

-- { [vehicleId] = whole seconds left } for every id still repairing (a plain table for VehicleStateUpdate)
function VehicleHealth.RepairingFor(userId: number): { [string]: number }
	local out: { [string]: number } = {}
	local byUser = destroyedUntil[userId]
	if byUser == nil then
		return out
	end
	local t = now()
	for vid, untilT in pairs(byUser) do
		local left = untilT - t
		if left > 0 then
			out[vid] = math.max(1, math.ceil(left - 1e-6))
		end
	end
	return out
end

--[[ One scheduler step (Heartbeat; tests call it with their own clock): the 10 Hz attribute flush for every dirty
	vehicle and the 1 Hz regen tick. No allocation unless a flush or a tick is due. ]]
function VehicleHealth._Step(t: number)
	if t >= loop.NextFlushAt then
		loop.NextFlushAt = t + 1 / math.max(1, tonumber(HCFG.AttrHz) or 10)
		for _, e in pairs(entries) do
			if e.Dirty then
				local ok = pcall(writeAttrs, e, false)
				if not ok then
					e.Dirty = false
				end
			end
		end
	end
	if t >= loop.NextRegenAt then
		local tick = math.max(0.2, tonumber(RCFG.TickSeconds) or 1)
		loop.NextRegenAt = t + tick
		local last = loop.LastRegenAt
		loop.LastRegenAt = t
		if last ~= nil then
			regenStep(t, math.clamp(t - last, 0, tick * 2))
		end
	end
end

-- test hooks
function VehicleHealth._Count(): number
	local n = 0
	for _ in pairs(entries) do
		n += 1
	end
	return n
end

function VehicleHealth._Reset()
	for model in pairs(entries) do
		VehicleHealth.Unregister(model)
	end
	table.clear(destroyedUntil)
	table.clear(bountyPairs)
	table.clear(ownerHitAt)
	table.clear(plotCache)
	loop.NextFlushAt = -math.huge
	loop.NextRegenAt = -math.huge
	loop.LastRegenAt = nil
end

return VehicleHealth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">Waterways</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE v70 — Waterways (spec_final §5)
	One module for the public water network and the sea gates' boat loop:
	  * Build(root): root.CoastalWater — Water/<Name> (one WE_Water part per public rect: the sea band, the ring canal
	    with the oil-rig lagoons, the South Docks harbour + slips, and the 6 dock channels when the plots face the map
	    centre) and Banks/<Name>_Bank (a thin sand rim under/around each rect). Plot water (DockWater, SeaGateWater),
	    sea gates, naval pads, road ends and rig piers are built by MapSetup (spec J6), not here.
	  * StartSeaGates(deps) / StepSeaGates(now): the 4 Hz sea-gate loop (J1). StructureKitBuilder.SyncRearGates only
	    ARMS a sea gate (Dock L1+); this loop opens an armed gate while a boat DRIVEN by the plot owner or a clan-mate
	    is near it and closes it CloseDelay seconds after the last one leaves. Driverless boats never open it, so the
	    Dock is never a walk-in back door past the main-gate raid barrier.
	  * CullDressing(folder): safety net for MapDressing / DesertFlora — destroys decor parts that stand in water or on
	    a plot pad (parts with WE_AllowInWater are exempt), and (roadmap W0 ROAD, WaterConfig.RoadCull) decor in the
	    road corridor, whole kits where they are small. RoadLines / IsNearRoadXZ expose the road centre lines.
	Geometry lives in Configs/WaterConfig (world rects) and Configs/BaseLayoutConfig (plot-local sea gate / basin).
	Water parts are CanCollide / CanTouch / CanQuery / CastShadow false: boats read the tagged parts geometrically
	(VehicleService), combat and ground raycasts pass through to the real floor.
	Never requires MapSetup (MapSetup / MapDressing / DesertFlora require this module).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WaterConfig = require(Shared.Configs.WaterConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local BaseLayout = require(script.Parent.BaseLayout)

type Rect = WaterConfig.Rect
export type RoadLine = { Name: string, AlongX: boolean, Across: number, Min: number, Max: number }

export type SeaGateDeps = {
	BaseService: any?,
	GateDefenseService: any?,
	ClanService: any?,
}

local Waterways = {}

local TAG_WATER = "WE_Water" -- = Constants.Tags.Water (VehicleService reads the tagged parts)
local GROUND_TOP_Y = 0.5 -- desert floor top (MapSetup Ground)
local SeaGate = WaterConfig.SeaGate

local function r2(v: number): number
	return math.round(v * 100) / 100
end

local function copyRect(r: Rect, name: string?): Rect
	return { Name = name or r.Name, X0 = r.X0, X1 = r.X1, Z0 = r.Z0, Z1 = r.Z1, Bank = r.Bank }
end

local function layoutPlotSize(): number
	local cfg = BaseLayout.Config() :: any
	return if type(cfg) == "table" and type(cfg.PlotSize) == "number" then cfg.PlotSize else 320
end

-- ── Geometry ────────────────────────────────────────────────────────────────

-- Channel from plot `plotId`'s sea gate (pad edge) straight out of the plot rear to WaterConfig.Channels[..].Until.
-- nil while the plots do not face the map centre (the docks stay isolated, as before v70).
function Waterways.ChannelRect(plotId: number): Rect?
	if not (WaterConfig.Enabled and BaseLayout.FacesMapCentre()) then
		return nil
	end
	local channel = nil
	for _, c in ipairs(WaterConfig.Channels) do
		if c.PlotId == plotId then
			channel = c
			break
		end
	end
	local pos: Vector3? = BaseConfig.PlotPositions[plotId]
	if channel == nil or pos == nil then
		return nil
	end
	local H = layoutPlotSize() * 0.5
	-- the gate opening's world across-range (a 1-deep strip just outside the pad edge)
	local c, sx, sz = BaseLayout.PlotRect(pos, (SeaGate.X0 + SeaGate.X1) * 0.5, -H - 0.5, SeaGate.X1 - SeaGate.X0, 1)
	local rear = BaseLayout.PlotCFrame(pos):VectorToWorldSpace(Vector3.new(0, 0, -1))
	local edge = BaseLayout.PlotPoint(pos, 0, -H)
	local name = "Ch_P" .. tostring(plotId)
	if math.abs(rear.X) > 0.5 then
		local e = r2(edge.X)
		return {
			Name = name,
			X0 = math.min(e, channel.Until),
			X1 = math.max(e, channel.Until),
			Z0 = r2(c.Z - sz * 0.5),
			Z1 = r2(c.Z + sz * 0.5),
		}
	end
	local e = r2(edge.Z)
	return {
		Name = name,
		X0 = r2(c.X - sx * 0.5),
		X1 = r2(c.X + sx * 0.5),
		Z0 = math.min(e, channel.Until),
		Z1 = math.max(e, channel.Until),
	}
end

-- Public water: WaterConfig.Public, plus the dock channels when BaseLayout.FacesMapCentre().
-- WaterConfig.Enabled = false keeps only the sea band (Sea_*), so the naval pads still float and no ring or harbour
-- appears where the roads (then full length) run.
function Waterways.PublicRects(): { Rect }
	local out: { Rect } = {}
	for _, r in ipairs(WaterConfig.Public) do
		if WaterConfig.Enabled or string.sub(r.Name, 1, 4) == "Sea_" then
			table.insert(out, copyRect(r))
		end
	end
	if WaterConfig.Enabled and BaseLayout.FacesMapCentre() then
		for plotId = 1, #BaseConfig.PlotPositions do
			local ch = Waterways.ChannelRect(plotId)
			if ch then
				table.insert(out, ch)
			end
		end
	end
	return out
end

-- Plot water world AABBs (MapSetup builds these parts): P<N>_DockWater always with the layout on, and
-- P<N>_SeaGateWater when the sea gates exist (FacesMapCentre and WaterConfig.Enabled).
function Waterways.PlotWaterRects(): { Rect }
	local out: { Rect } = {}
	if not BaseLayout.Enabled() then
		return out
	end
	local cfg = BaseLayout.Config() :: any
	local basin = cfg.Courtyard and cfg.Courtyard.DockBasin
	local gates = WaterConfig.Enabled and BaseLayout.FacesMapCentre()
	for plotId, pos in ipairs(BaseConfig.PlotPositions) do
		if basin then
			local c, sx, sz = BaseLayout.PlotRect(pos, basin.X, basin.Z, basin.SizeX, basin.SizeZ)
			table.insert(out, {
				Name = "P" .. plotId .. "_DockWater",
				X0 = r2(c.X - sx * 0.5),
				X1 = r2(c.X + sx * 0.5),
				Z0 = r2(c.Z - sz * 0.5),
				Z1 = r2(c.Z + sz * 0.5),
			})
		end
		if gates then
			local depth = SeaGate.BasinRearZ - SeaGate.PadEdgeZ
			local c, sx, sz = BaseLayout.PlotRect(
				pos,
				(SeaGate.X0 + SeaGate.X1) * 0.5,
				(SeaGate.PadEdgeZ + SeaGate.BasinRearZ) * 0.5,
				SeaGate.X1 - SeaGate.X0,
				depth
			)
			table.insert(out, {
				Name = "P" .. plotId .. "_SeaGateWater",
				X0 = r2(c.X - sx * 0.5),
				X1 = r2(c.X + sx * 0.5),
				Z0 = r2(c.Z - sz * 0.5),
				Z1 = r2(c.Z + sz * 0.5),
			})
		end
	end
	return out
end

-- Every WE_Water surface on the map (public + channels + plot water), world XZ rects.
function Waterways.AllRects(): { Rect }
	local out = Waterways.PublicRects()
	for _, r in ipairs(Waterways.PlotWaterRects()) do
		table.insert(out, r)
	end
	return out
end

local function inRects(rects: { Rect }, x: number, z: number, m: number): boolean
	for _, r in ipairs(rects) do
		if x >= r.X0 - m and x <= r.X1 + m and z >= r.Z0 - m and z <= r.Z1 + m then
			return true
		end
	end
	return false
end

-- true when (x, z) is on (or within `margin` studs of) any water: public, channels or plot water
function Waterways.IsWaterXZ(x: number, z: number, margin: number?): boolean
	return inRects(Waterways.AllRects(), x, z, margin or 0)
end

local function padRects(): { Rect }
	local half = (BaseConfig.PlotSize :: Vector3).X * 0.5
	local out: { Rect } = {}
	for plotId, pos in ipairs(BaseConfig.PlotPositions) do
		table.insert(out, { Name = "Plot" .. plotId, X0 = pos.X - half, X1 = pos.X + half, Z0 = pos.Z - half, Z1 = pos.Z + half })
	end
	return out
end

-- true when (x, z) is on (or within `margin` studs of) a plot pad (pads are square, so the plot yaw never matters)
function Waterways.IsOnPlotPadXZ(x: number, z: number, margin: number?): boolean
	return inRects(padRects(), x, z, margin or 0)
end

-- World road centre lines, from the WaterConfig.RoadEnds keys (MapSetup builds the roads from the same table):
-- RoadX<x> runs along Z at x = Across, RoadZ<z> along X at z = Across, over Min..Max (the whole map while
-- WaterConfig.Enabled is false, when MapSetup builds them full length). Sorted by name.
function Waterways.RoadLines(): { RoadLine }
	local out: { RoadLine } = {}
	for name, ends in pairs(WaterConfig.RoadEnds) do
		local axis, num = string.match(name, "^Road([XZ])(%-?[%d%.]+)$")
		local across = if num then tonumber(num) else nil
		if axis and across then
			table.insert(out, {
				Name = name,
				AlongX = axis == "Z",
				Across = across,
				Min = if WaterConfig.Enabled then ends.Min else -math.huge,
				Max = if WaterConfig.Enabled then ends.Max else math.huge,
			})
		end
	end
	table.sort(out, function(a: RoadLine, b: RoadLine): boolean
		return a.Name < b.Name
	end)
	return out
end

-- Smallest across-gap from the XZ box to the centre line of a road whose extent it overlaps along the road
-- (0 = the box straddles the line); math.huge when it is beside no road.
local function roadGap(roads: { RoadLine }, x0: number, x1: number, z0: number, z1: number): number
	local best = math.huge
	for _, r in ipairs(roads) do
		local a0, a1, c0, c1 = x0, x1, z0, z1 -- along, across
		if not r.AlongX then
			a0, a1, c0, c1 = z0, z1, x0, x1
		end
		if a1 >= r.Min and a0 <= r.Max then
			local gap = math.max(0, c0 - r.Across, r.Across - c1)
			if gap < best then
				best = gap
			end
		end
	end
	return best
end

-- true when (x, z) is within `margin` studs (default WaterConfig.RoadCull.Corridor) of a road centre line
function Waterways.IsNearRoadXZ(x: number, z: number, margin: number?): boolean
	return roadGap(Waterways.RoadLines(), x, x, z, z) <= (margin or WaterConfig.RoadCull.Corridor)
end

-- ── Build ───────────────────────────────────────────────────────────────────

local function flatPart(name: string, size: Vector3, cf: CFrame, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Parent = parent
	return p
end

-- Builds root.CoastalWater (replaces an old one). Called by MapSetup.Run where the old WaterPlane block was.
function Waterways.Build(root: Instance): Folder
	local old = root:FindFirstChild("CoastalWater")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "CoastalWater"
	local waterFolder = Instance.new("Folder")
	waterFolder.Name = "Water"
	waterFolder.Parent = folder
	local bankFolder = Instance.new("Folder")
	bankFolder.Name = "Banks"
	bankFolder.Parent = folder

	local look = WaterConfig.Look
	local bottom, top = WaterConfig.BottomY, WaterConfig.SurfaceY
	local rects = Waterways.PublicRects()
	local channels = 0
	for i, r in ipairs(rects) do
		local cx, cz = (r.X0 + r.X1) * 0.5, (r.Z0 + r.Z1) * 0.5
		local sx, sz = r.X1 - r.X0, r.Z1 - r.Z0
		local water = flatPart(r.Name, Vector3.new(sx, top - bottom, sz), CFrame.new(cx, (bottom + top) * 0.5, cz), waterFolder)
		water.Material = look.Material
		water.Color = look.Color
		water.Transparency = look.Transparency
		water.Reflectance = look.Reflectance
		water:SetAttribute("WE_WaterId", r.Name)
		CollectionService:AddTag(water, TAG_WATER)
		if string.sub(r.Name, 1, 3) == "Ch_" then
			channels += 1
		end

		-- sand rim: the rect grown by its bank width; tops step 0.004 per rect so overlapping banks never z-fight
		local b = r.Bank or WaterConfig.BankWidth
		local bankTop = WaterConfig.BankTop + (i - 1) * 0.004
		local bank = flatPart(
			r.Name .. "_Bank",
			Vector3.new(sx + b * 2, bankTop - GROUND_TOP_Y, sz + b * 2),
			CFrame.new(cx, (GROUND_TOP_Y + bankTop) * 0.5, cz),
			bankFolder
		)
		bank.Material = WaterConfig.BankMaterial
		bank.Color = WaterConfig.BankColor
	end
	folder.Parent = root
	print(
		string.format(
			"[WAR EMPIRE] Waterways: %d water parts (%d channels), %d banks, surface y %.2f, faceMapCentre=%s",
			#rects,
			channels,
			#rects,
			top,
			tostring(BaseLayout.FacesMapCentre())
		)
	)
	return folder
end

-- ── Dressing safety net (spec §9.12; roadmap W0 ROAD / World v2 H2) ─────────

type Box = { X0: number, X1: number, Y0: number, Y1: number, Z0: number, Z1: number }

local function worldBox(part: BasePart): Box
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = part.CFrame:GetComponents()
	local hx, hy, hz = part.Size.X * 0.5, part.Size.Y * 0.5, part.Size.Z * 0.5
	local ex = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz
	local ey = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz
	local ez = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz
	return { X0 = x - ex, X1 = x + ex, Y0 = y - ey, Y1 = y + ey, Z0 = z - ez, Z1 = z + ez }
end

local function boxesTouch(a: Box, b: Box, grow: number): boolean
	return a.X0 <= b.X1 + grow
		and a.X1 >= b.X0 - grow
		and a.Y0 <= b.Y1 + grow
		and a.Y1 >= b.Y0 - grow
		and a.Z0 <= b.Z1 + grow
		and a.Z1 >= b.Z0 - grow
end

local function allowedInWater(part: Instance, stop: Instance): boolean
	local cur: Instance? = part
	while cur and cur ~= stop do
		if cur:GetAttribute("WE_AllowInWater") == true then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function toSet(list: { string }?): { [string]: boolean }
	local out: { [string]: boolean } = {}
	for _, s in ipairs(list or {}) do
		out[s] = true
	end
	return out
end

local function overlapsAny(rects: { Rect }, x0: number, x1: number, z0: number, z1: number, grow: number): boolean
	for _, r in ipairs(rects) do
		if x0 < r.X1 + grow and x1 > r.X0 - grow and z0 < r.Z1 + grow and z1 > r.Z0 - grow then
			return true
		end
	end
	return false
end

-- Destroys decor under `folder` (MapDressing's WorldDressing, DesertFlora's DesertFlora) that
--   * overlaps water (grown by 2) with its bottom below SurfaceY + 14, or overlaps a plot pad grown by 4
--     (WE_AllowInWater on the part or an ancestor exempts it from this rule); or
--   * stands on a world road (WaterConfig.RoadCull): collidable with its top above MinTop within Corridor studs of a
--     centre line, or any visible non-marking part taller than LaneMaxHeight within Lane studs. A road hit takes its
--     whole kit (nearest Model / kit Folder spanning <= KitMaxSpan) or, part alone, the raised parts it carried.
--     Map.RoadEnds, Bases, Territories, Plot<N> folders, ExemptNames and WE_AllowOnRoad are never road hits.
-- Returns the number of BaseParts destroyed (kit members included).
function Waterways.CullDressing(folder: Instance): number
	local water = Waterways.AllRects()
	local pads = padRects()
	local maxBottom = WaterConfig.SurfaceY + 14
	local rc = WaterConfig.RoadCull
	local roads: { RoadLine } = if rc and rc.Enabled then Waterways.RoadLines() else {}
	local exemptAncestors = toSet(rc and rc.ExemptAncestors)
	local exemptNames = toSet(rc and rc.ExemptNames)
	local markings: { string } = (rc and rc.MarkingPrefixes) or {}
	local laneTop = GROUND_TOP_Y + ((rc and rc.LaneMaxHeight) or 0.3)

	local descendants = folder:GetDescendants()
	local boxes: { [BasePart]: Box } = {}
	local parts: { BasePart } = {}
	for _, d in ipairs(descendants) do
		if d:IsA("BasePart") then
			boxes[d] = worldBox(d)
			table.insert(parts, d)
		end
	end

	local roadExemptMemo: { [Instance]: boolean } = {}
	local function roadExempt(inst: Instance): boolean
		local memo = roadExemptMemo[inst]
		if memo ~= nil then
			return memo
		end
		local res = false
		if inst:GetAttribute("WE_AllowOnRoad") == true or exemptNames[inst.Name] then
			res = true
		elseif exemptAncestors[inst.Name] or string.match(inst.Name, "^Plot%d+$") ~= nil then
			res = not inst:IsA("BasePart")
		end
		if not res and inst ~= folder then
			local parent = inst.Parent
			res = parent ~= nil and roadExempt(parent)
		end
		roadExemptMemo[inst] = res
		return res
	end
	local function isMarking(name: string): boolean
		for _, prefix in ipairs(markings) do
			if string.sub(name, 1, #prefix) == prefix then
				return true
			end
		end
		return false
	end

	-- 1) hits
	local doomed: { [Instance]: boolean } = {}
	local wetHits: { BasePart } = {}
	local roadHits: { BasePart } = {}
	for _, d in ipairs(parts) do
		local b = boxes[d]
		if
			not allowedInWater(d, folder)
			and ((b.Y0 < maxBottom and overlapsAny(water, b.X0, b.X1, b.Z0, b.Z1, 2)) or overlapsAny(pads, b.X0, b.X1, b.Z0, b.Z1, 4))
		then
			table.insert(wetHits, d)
		elseif #roads > 0 and b.Y1 > rc.MinTop then
			local gap = roadGap(roads, b.X0, b.X1, b.Z0, b.Z1)
			local hit = (gap <= rc.Corridor and d.CanCollide)
				or (gap <= rc.Lane and b.Y1 > laneTop and d.Transparency < 0.99 and not isMarking(d.Name))
			if hit and not roadExempt(d) then
				table.insert(roadHits, d)
			end
		end
	end
	for _, d in ipairs(wetHits) do
		doomed[d] = true
	end

	-- 2) whole kit for road hits: the nearest Model / Folder below `folder`, if it is small and holds nothing exempt
	local kitMemo: { [Instance]: boolean } = {}
	local function kitOk(kit: Instance): boolean
		local memo = kitMemo[kit]
		if memo ~= nil then
			return memo
		end
		local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
		local ok = true
		for _, k in ipairs(kit:GetDescendants()) do
			local kb = if k:IsA("BasePart") then boxes[k] else nil
			if kb then
				x0, x1 = math.min(x0, kb.X0), math.max(x1, kb.X1)
				z0, z1 = math.min(z0, kb.Z0), math.max(z1, kb.Z1)
				if allowedInWater(k, folder) or roadExempt(k) then
					ok = false
					break
				end
			end
		end
		ok = ok and x1 >= x0 and math.max(x1 - x0, z1 - z0) <= rc.KitMaxSpan
		kitMemo[kit] = ok
		return ok
	end
	local kits = 0
	local loose: { BasePart } = {}
	for _, d in ipairs(roadHits) do
		-- climb out of part chains and catalog overlays (a Model parented to its host part): the part alone is then
		-- the top-most host part, and the kit is the container above it
		local victim: BasePart = d
		local cur = d.Parent
		while cur and cur ~= folder do
			if cur:IsA("BasePart") then
				victim = cur
			elseif not (cur:IsA("Model") and cur.Parent and cur.Parent:IsA("BasePart")) then
				break
			end
			cur = cur.Parent
		end
		if cur and cur ~= folder and (cur:IsA("Model") or cur:IsA("Folder")) and kitOk(cur) then
			if not doomed[cur] then
				doomed[cur] = true
				kits += 1
			end
		elseif not doomed[victim] then
			doomed[victim] = true
			table.insert(loose, victim)
		end
	end

	-- 3) part-alone road hits also take the raised siblings they carried (flood over touching AABBs, bounded)
	if rc and rc.SweepAttached and #loose > 0 then
		local siblings: { [Instance]: { BasePart } } = {}
		for _, d in ipairs(parts) do
			local parent = d.Parent
			if parent then
				local list = siblings[parent]
				if not list then
					list = {}
					siblings[parent] = list
				end
				table.insert(list, d)
			end
		end
		local minBottom = GROUND_TOP_Y + rc.SweepMinLift
		local queue: { { Part: BasePart, CX: number, CZ: number } } = {}
		for _, d in ipairs(loose) do
			local b = boxes[d]
			table.insert(queue, { Part = d, CX = (b.X0 + b.X1) * 0.5, CZ = (b.Z0 + b.Z1) * 0.5 })
		end
		local head = 1
		while head <= #queue do
			local item = queue[head]
			head += 1
			local pb = boxes[item.Part]
			local parent = item.Part.Parent
			for _, q in ipairs((parent and siblings[parent]) or {}) do
				local qb = boxes[q]
				if
					not doomed[q]
					and qb.Y0 > minBottom
					and boxesTouch(pb, qb, rc.SweepTouch)
					and math.max(math.abs((qb.X0 + qb.X1) * 0.5 - item.CX), math.abs((qb.Z0 + qb.Z1) * 0.5 - item.CZ))
						<= rc.KitMaxSpan
					and not allowedInWater(q, folder)
					and not roadExempt(q)
				then
					doomed[q] = true
					table.insert(queue, { Part = q, CX = item.CX, CZ = item.CZ })
				end
			end
		end
	end

	-- 4) count (kit members included), then destroy only the top-most doomed instances
	local function underDoomed(inst: Instance): boolean
		local cur: Instance? = inst
		while cur and cur ~= folder do
			if doomed[cur] then
				return true
			end
			cur = cur.Parent
		end
		return false
	end
	local wetSet: { [Instance]: boolean } = {}
	for _, d in ipairs(wetHits) do
		wetSet[d] = true
	end
	local function underWet(inst: Instance): boolean
		local cur: Instance? = inst
		while cur and cur ~= folder do
			if wetSet[cur] then
				return true
			end
			cur = cur.Parent
		end
		return false
	end
	local total, wetParts = 0, 0
	for _, d in ipairs(parts) do
		if underDoomed(d) then
			total += 1
			if underWet(d) then
				wetParts += 1
			end
		end
	end
	for inst in pairs(doomed) do
		local parent = inst.Parent
		if not (parent and parent ~= folder and underDoomed(parent)) then
			inst:Destroy()
		end
	end
	if total > 0 then
		print(
			string.format(
				"[WAR EMPIRE] Waterways: culled %d decor parts under %s (%d in water / on plot pads, %d on roads: %d hits, %d kits)",
				total,
				folder.Name,
				wetParts,
				total - wetParts,
				#roadHits,
				kits
			)
		)
	end
	return total
end

-- ── Sea-gate loop (J1) ──────────────────────────────────────────────────────

local deps: SeaGateDeps = {}
local started = false
local gateCache: { Instance } = {}
local lastScan = -math.huge
local allyAt: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
local warned: { [string]: boolean } = {}
local warnedCount = 0
local skbModule: any = nil
local clanModule: any = nil -- false = looked up and missing

local function warnOnce(msg: string)
	if warned[msg] or warnedCount >= 20 then
		return
	end
	warned[msg] = true
	warnedCount += 1
	warn("[WAR EMPIRE] Waterways sea gate:", msg)
end

local function kitBuilder(): any
	if skbModule == nil then
		skbModule = require(script.Parent.StructureKitBuilder) :: any
	end
	return skbModule
end

local function clanService(): any?
	if deps.ClanService then
		return deps.ClanService
	end
	if clanModule == nil then
		local ok, m = pcall(function(): any
			return require(script.Parent.Parent.Services.ClanService) :: any
		end)
		clanModule = if ok and type(m) == "table" then m else false
	end
	return if clanModule then clanModule else nil
end

-- the plot owner, or a player in the owner's clan (GateDefenseService.IsAlly; ClanService directly if that is
-- missing; neither → owner only)
local function isAlly(ownerUserId: number, player: Player): boolean
	if player.UserId == ownerUserId then
		return true
	end
	local gds = deps.GateDefenseService
	if gds and type(gds.IsAlly) == "function" then
		local ok, res = pcall(gds.IsAlly, ownerUserId, player)
		return ok and res == true
	end
	local cs = clanService()
	if cs and type(cs.GetClanId) == "function" then
		local owner = Players:GetPlayerByUserId(ownerUserId)
		if not owner then
			return false
		end
		local okA, a = pcall(cs.GetClanId, owner)
		local okB, b = pcall(cs.GetClanId, player)
		return okA and okB and type(a) == "string" and a ~= "" and a == b
	end
	return false
end

local function ownerOf(plotId: number?): number?
	local bs = deps.BaseService
	if plotId == nil or not (bs and type(bs.GetOwnerUserId) == "function") then
		return nil
	end
	local ok, uid = pcall(bs.GetOwnerUserId, plotId)
	return if ok and type(uid) == "number" then uid else nil
end

-- a Naval vehicle whose DriverSeat is occupied by a living ally of `ownerUserId`, whose own OwnerUserId (when set) is
-- an ally too, and whose pivot is within OpenRadius (horizontal) / OpenHeight (vertical) of the gate centre
local function allyBoatNear(ownerUserId: number, centre: Vector3): boolean
	local folder = Workspace:FindFirstChild("WarEmpireVehicles")
	if not folder then
		return false
	end
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("WE_Category") == "Naval" then
			local seat = m:FindFirstChild("DriverSeat")
			local occ = if seat and seat:IsA("VehicleSeat") then seat.Occupant else nil
			local character = if occ and occ.Health > 0 then occ.Parent else nil
			if character then
				local d = m:GetPivot().Position - centre
				if Vector3.new(d.X, 0, d.Z).Magnitude <= SeaGate.OpenRadius and math.abs(d.Y) <= SeaGate.OpenHeight then
					local driver = Players:GetPlayerFromCharacter(character)
					if driver and isAlly(ownerUserId, driver) then
						local boatOwner = m:GetAttribute("OwnerUserId")
						local ownerOk = true
						if type(boatOwner) == "number" and boatOwner ~= ownerUserId then
							local bp = Players:GetPlayerByUserId(boatOwner)
							ownerOk = bp ~= nil and isAlly(ownerUserId, bp)
						end
						if ownerOk then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

local function gateList(now: number): { Instance }
	local stale = now - lastScan >= (if #gateCache == 0 then 2 else 10)
	if not stale then
		for _, g in ipairs(gateCache) do
			if not g:IsDescendantOf(Workspace) then
				stale = true
				break
			end
		end
	end
	if not stale then
		return gateCache
	end
	lastScan = now
	local out: { Instance } = {}
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	if bases then
		for _, plot in ipairs(bases:GetChildren()) do
			local ground = plot:FindFirstChild("LayoutGround")
			if ground then
				for _, g in ipairs(ground:GetChildren()) do
					if g:GetAttribute("WE_GateMode") == "Proximity" then
						table.insert(out, g)
					end
				end
			end
		end
	end
	gateCache = out
	return out
end

local function gatePlotId(gate: Instance): number?
	local id = tonumber(gate:GetAttribute("PlotId"))
	if id then
		return id
	end
	local ground = gate.Parent
	local plot = ground and ground.Parent
	return if plot then tonumber(string.match(plot.Name, "^Plot(%d+)$")) else nil
end

local function stepGate(gate: Instance, now: number)
	local isOpen = gate:GetAttribute("WE_GateOpen") == true
	if gate:GetAttribute("WE_GateArmed") ~= true then
		-- SyncRearGates keeps an unarmed gate closed; belt and braces if something left it open
		allyAt[gate] = nil
		if isOpen then
			kitBuilder().SetGateOpen(gate, false)
		end
		return
	end
	local owner = ownerOf(gatePlotId(gate))
	local centre = gate:GetAttribute("WE_GateCentre")
	local near = owner ~= nil and typeof(centre) == "Vector3" and allyBoatNear(owner, centre)
	if near then
		allyAt[gate] = now
		if not isOpen then
			kitBuilder().SetGateOpen(gate, true)
		end
	elseif isOpen and now - (allyAt[gate] or -math.huge) >= SeaGate.CloseDelay then
		allyAt[gate] = nil
		kitBuilder().SetGateOpen(gate, false)
	end
end

-- One pass over every sea gate (the loop calls it at 1 / LoopSeconds Hz; tests call it with their own clock).
function Waterways.StepSeaGates(now: number)
	for _, gate in ipairs(gateList(now)) do
		local ok, err = pcall(function()
			stepGate(gate, now)
		end)
		if not ok then
			warnOnce(tostring(err))
		end
	end
end

-- Called once by Bootstrap after the services' Init. A second call is ignored.
function Waterways.StartSeaGates(d: SeaGateDeps?)
	if started then
		return
	end
	started = true
	deps = d or {}
	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				Waterways.StepSeaGates(os.clock())
			end)
			if not ok then
				warnOnce(tostring(err))
			end
			task.wait(SeaGate.LoopSeconds)
		end
	end)
end

return Waterways
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">WeaponAssetLoader</string>
            <string name="Source"><![CDATA[--!strict
--[[ W2 Combat Core (contracts §3.8, asset shortlist §6.2 C4): optional gun meshes from verified store asset ids.

	CombatService.Init task.spawns WeaponAssetLoader.Start once. For every WeaponConfig weapon with VisualAssetId > 0
	it loads each DISTINCT asset id once (InsertService:LoadAsset, then AssetService:LoadAssetAsync; each pcall'd;
	failures are cached and never retried), takes Tool[VisualToolName] (or the first Tool), then its Model child
	VisualChild (or the Tool's own parts), and publishes a sanitised copy as Model "Weapon_<WeaponId>" in
	ReplicatedStorage.WE_WeaponTemplates (created here). The client (WeaponVisuals) uses that template when present
	and its own Part kit otherwise.

	Sanitising: every Script / LocalScript / ModuleScript and Sound is destroyed, and so is every effect (Beam,
	ParticleEmitter, Trail, Fire, Smoke, Sparkles, lights: the client draws its own muzzle flash, and a kit's
	flash Beam only ever moved with the kit's scripts) together with the Attachments that only such a Beam used.
	Attachments, Welds, WeldConstraints and Motor6Ds stay. Every BasePart is unanchored, CanCollide / CanQuery /
	CanTouch false, Massless, no shadow. A template with more than MAX_PARTS BaseParts is refused.

	VisualChild is copied as ONE clone, so the kit's own joints between its parts (magazine, bolt) keep pointing at
	the copies (cloning part by part left them pointing at the source asset, and the client got loose parts).

	Grip (owner asset list 2026-09-25): a Roblox Weapons Kit Tool holds its gun Model plus an invisible Tool.Handle,
	and the kit welds the two together only at equip time, at the gun's "HandleAttachment". When VisualChild picked
	a Model, the Tool's Handle is copied too (Transparency 1), placed on that attachment (else where it is) and
	welded to the part that carries it. WeaponVisuals grips the part named Handle, so the gun sits in the hand the
	way the kit holds it: barrel along the Handle's -Z, top along its +Y.

	WeaponConfig wires the Roblox-owned Weapons Kit guns (creator Roblox, User 1: they load with "Allow Loading Third
	Party Assets" OFF). Each distinct id loads once per server, outside VisualAssetConfig.MaxLoadAttempts. A failed
	load or a refused template keeps that weapon's Part kit. ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponAssetLoader = {}

local MAX_PARTS = 16
local FOLDER_NAME = "WE_WeaponTemplates"

local loaded: { [number]: Instance | false } = {} -- asset id -> loaded root (false = failed, cached)
local started = false
local published: { [string]: boolean } = {}

local function loadAsset(assetId: number): Instance?
	local cached = loaded[assetId]
	if cached ~= nil then
		return if cached == false then nil else cached :: Instance
	end
	local root: Instance? = nil
	local okI, resI = pcall(function()
		return game:GetService("InsertService"):LoadAsset(assetId)
	end)
	if okI and typeof(resI) == "Instance" then
		root = resI
	else
		local okA, resA = pcall(function()
			return (game:GetService("AssetService") :: any):LoadAssetAsync(assetId)
		end)
		if okA and typeof(resA) == "Instance" then
			root = resA
		end
	end
	loaded[assetId] = root or false
	if root == nil then
		warn(string.format("[WeaponAssetLoader] asset %d did not load (the Part kit stays)", assetId))
	end
	return root
end

local function findTool(root: Instance, toolName: string?): Instance?
	if typeof(toolName) == "string" and toolName ~= "" then
		if root:IsA("Tool") and root.Name == toolName then
			return root
		end
		-- the Tool with exactly this name (a kit Tool holds a Model of the same name: FindFirstChild could stop there)
		for _, d in ipairs(root:GetDescendants()) do -- once per asset load, never per frame
			if d:IsA("Tool") and d.Name == toolName then
				return d
			end
		end
	end
	if root:IsA("Tool") then
		return root
	end
	return root:FindFirstChildWhichIsA("Tool", true)
end

-- effects a gun template never keeps (the client makes its own flash; lights cost phones)
local function isEffect(d: Instance): boolean
	return d:IsA("Beam")
		or d:IsA("ParticleEmitter")
		or d:IsA("Trail")
		or d:IsA("Fire")
		or d:IsA("Smoke")
		or d:IsA("Sparkles")
		or d:IsA("Light")
end

-- Strip code, sounds and effects, make every part a massless visual. Returns the BasePart count.
local function sanitise(model: Instance): number
	local parts = 0
	local beamEnds: { Instance } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d.Parent == nil then
			continue -- inside something destroyed above
		end
		if d:IsA("Beam") then
			local b = d :: Beam
			local a0, a1 = b.Attachment0, b.Attachment1
			if a0 and a0:IsDescendantOf(model) then
				table.insert(beamEnds, a0)
			end
			if a1 and a1:IsDescendantOf(model) then
				table.insert(beamEnds, a1)
			end
		end
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or isEffect(d) then
			d:Destroy()
		elseif d:IsA("BasePart") then
			parts += 1
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			d.CastShadow = false
		end
	end
	-- a flash Beam's end points (kit "MuzzleFlash0/1", off the barrel axis) go with it, so the client's muzzle
	-- search finds the barrel tip
	for _, a in ipairs(beamEnds) do
		if a.Parent ~= nil and #a:GetChildren() == 0 then
			a:Destroy()
		end
	end
	return parts
end

local function folder(): Folder
	local f = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = FOLDER_NAME
	nf.Parent = ReplicatedStorage
	return nf
end

--[[ The kit's invisible Tool.Handle → the template's grip part (see the header). body: the gun's main part (the
	source Model's PrimaryPart) when known; the part that carries "HandleAttachment" wins. Adds 1 part. ]]
function WeaponAssetLoader._AddGripHandle(model: Model, kitHandle: BasePart, body: BasePart?)
	local att: Attachment? = nil
	for _, d in ipairs(model:GetDescendants()) do -- once per template, never per frame
		if d:IsA("Attachment") and d.Name == "HandleAttachment" and d.Parent and d.Parent:IsA("BasePart") then
			att = d
			break
		end
	end
	local anchorPart: BasePart? = if att then att.Parent :: BasePart else body
	if anchorPart == nil then
		local best = 0
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				local v = d.Size.X * d.Size.Y * d.Size.Z
				if v > best then
					best = v
					anchorPart = d
				end
			end
		end
	end
	if anchorPart == nil then
		return
	end
	local h = kitHandle:Clone()
	for _, c in ipairs(h:GetChildren()) do
		c:Destroy()
	end
	h.Name = "Handle"
	h.Transparency = 1
	if att then
		h.CFrame = anchorPart.CFrame * att.CFrame -- where the kit's equip weld puts the Handle
	end
	local w = Instance.new("Weld")
	w.Name = "WE_GripWeld"
	w.Part0 = h
	w.Part1 = anchorPart
	w.C0 = h.CFrame:ToObjectSpace(anchorPart.CFrame)
	w.C1 = CFrame.identity
	w.Parent = h
	h.Parent = model
end

-- Build Weapon_<weaponId> from one loaded asset root. Returns the template, or nil and a reason.
function WeaponAssetLoader.BuildTemplate(weaponId: string, root: Instance, toolName: string?, childName: string?): (Model?, string)
	local tool = findTool(root, toolName)
	if tool == nil then
		return nil, "no Tool"
	end
	local model = Instance.new("Model")
	model.Name = "Weapon_" .. weaponId
	local source: Instance = tool
	local gunModel = false
	if typeof(childName) == "string" and childName ~= "" then
		local child = tool:FindFirstChild(childName)
		if child and child:IsA("Model") then
			source = child
			gunModel = true
		end
	end
	-- ONE clone of the source, so joints between its parts are remapped onto the copies
	local copyOrNil: Instance? = source:Clone() -- nil when the source is not Archivable
	if copyOrNil == nil then
		model:Destroy()
		return nil, "not archivable"
	end
	local copy: Instance = copyOrNil
	local body: BasePart? = if copy:IsA("Model") then (copy :: Model).PrimaryPart else nil
	for _, c in ipairs(copy:GetChildren()) do
		if c:IsA("LuaSourceContainer") or c:IsA("Sound") then
			c:Destroy()
		else
			c.Parent = model
		end
	end
	copy:Destroy()
	if gunModel and model:FindFirstChild("Handle") == nil then
		local kitHandle = tool:FindFirstChild("Handle")
		if kitHandle and kitHandle:IsA("BasePart") then
			WeaponAssetLoader._AddGripHandle(model, kitHandle, body)
		end
	end
	local parts = sanitise(model)
	if parts == 0 then
		model:Destroy()
		return nil, "no parts"
	end
	if parts > MAX_PARTS then
		model:Destroy()
		return nil, string.format("%d parts > %d", parts, MAX_PARTS)
	end
	local handle = model:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		model.PrimaryPart = handle
	end
	return model, "ok"
end

--[[ Load and publish every weapon with VisualAssetId > 0. Idempotent; call from a spawned thread (it yields). ]]
function WeaponAssetLoader.Start(weapons: { [string]: any })
	if started then
		return
	end
	started = true
	local ids: { string } = {}
	for id, def in pairs(weapons) do
		local aid = tonumber(def.VisualAssetId)
		if aid and aid > 0 and aid % 1 == 0 then
			table.insert(ids, id)
		end
	end
	if #ids == 0 then
		return
	end
	table.sort(ids)
	for _, weaponId in ipairs(ids) do
		local def = weapons[weaponId]
		local assetId = tonumber(def.VisualAssetId) :: number
		local root = loadAsset(assetId)
		if root and not published[weaponId] then
			local ok, template, why = pcall(WeaponAssetLoader.BuildTemplate, weaponId, root, def.VisualToolName, def.VisualChild)
			if ok and template then
				local f = folder()
				local old = f:FindFirstChild(template.Name)
				if old then
					old:Destroy()
				end
				template.Parent = f
				published[weaponId] = true
			else
				warn(string.format("[WeaponAssetLoader] %s (asset %d) refused: %s", weaponId, assetId, tostring(if ok then why else template)))
			end
		end
	end
end

return WeaponAssetLoader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">WorldAtmosphere</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 1 — WorldAtmosphere: Lighting, Sky, Atmosphere and the day cycle (gap/world_v2_spec.md §2,
	roadmap §1.3 / §1.5 #6 / §1.6). Replaces the Lighting block and day loop at the top of MapSetup.Run once hooked.
	  * Presets in WorldConfig.Atmosphere.Presets: "V2" (warm dust haze, Decay (150,122,92) = no blue below the horizon,
	    Offset 0.22 to silhouette the canyon) and "Classic" (the pre-v2 look). WorldConfig.Atmosphere.Preset = "Classic"
	    is the one-line revert for Test B.
	  * Ambient = agent F's numbers (HUD spec §5): day (78,72,62), EnvironmentDiffuseScale 0.35, read from
	    StructureVisualConfig.WorldLighting when present (the in-base knob), else from WorldConfig. Night Brightness
	    floor 1.6 so phones never go black.
	  * No Fog writes: Roblox hides Fog while Lighting has an Atmosphere, so they were dead writes.
	  * Day cycle: one step every StepSeconds (6 s; was 1.5 s) with 4x larger steps, so the day is still
	    DayLengthMinutes (20) long. A step writes ClockTime, plus only the properties whose value changed (dawn and
	    dusk), so a daytime step is a single property write. Lights tagged WE_NightLight are Enabled only while
	    night > 0.5, written only when that flips (2 writes per day).

	PUBLIC API (server only; not hooked yet — the post-F hook step replaces MapSetup.Run's Lighting block with Apply):
	  WorldAtmosphere.Apply(opts?: { Preset: string?, DayCycle: boolean?, StartClock: number? }) -> Handle
	      Applies the preset at StartClock and (unless DayCycle == false) starts the day loop. Idempotent: a second
	      Apply replaces Lighting.WE_DayNightMarker (the marker MapSetup's old loop also watches), which stops every
	      earlier loop, and reuses the one Sky / Atmosphere. Handle = { Preset: string, Stop: () -> () }.
	  WorldAtmosphere.Sample(clock: number, preset?: string) -> Values   (pure: every value one step writes)
	  WorldAtmosphere.NightShare(clock: number) -> number                (pure: 0 = day .. 1 = night)
	  WorldAtmosphere.Simulate(hours, clock?, preset?) -> { Steps, Writes, LightFlips, Seconds }  (pure loop replay)
	  WorldAtmosphere.Counters() -> { Steps, Writes, LightFlips }         (the running loop since the last Apply)
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs")
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local StructureVisualConfig = require(Configs:WaitForChild("StructureVisualConfig"))

export type Values = {
	ClockTime: number,
	Night: number,
	Brightness: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	Density: number,
	Offset: number,
	Color: Color3,
	Decay: Color3,
	Glare: number,
	Haze: number,
}
export type Handle = { Preset: string, Stop: () -> () }

local WorldAtmosphere = {}

local MARKER = "WE_DayNightMarker"

local function presetOf(name: string?): (string, any)
	local cfg = WorldConfig.Atmosphere
	local key = name or cfg.Preset
	local p = (cfg.Presets :: any)[key]
	if p == nil then
		key = "V2"
		p = cfg.Presets.V2
	end
	return key, p
end

-- F's in-base knob wins for the day Ambient / diffuse scale (one place to tune interiors)
local function worldLighting(): any
	local wl = (StructureVisualConfig :: any).WorldLighting
	return if type(wl) == "table" then wl else {}
end

function WorldAtmosphere.NightShare(clock: number): number
	local c = WorldConfig.Atmosphere
	local t = clock % 24
	if t < c.NightEnd or t > c.NightStart then
		return 1
	elseif t < c.DawnEnd then
		return 1 - (t - c.NightEnd) / (c.DawnEnd - c.NightEnd)
	elseif t > c.DuskStart then
		return (t - c.DuskStart) / (c.NightStart - c.DuskStart)
	end
	return 0
end

local function r3(v: number): number
	return math.round(v * 1000) / 1000
end

local function lerpColor(a: Color3, b: Color3, t: number): Color3
	local c = a:Lerp(b, t)
	-- quantise to 8-bit so identical steps compare equal (no spurious re-writes)
	return Color3.fromRGB(math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
end

function WorldAtmosphere.Sample(clock: number, preset: string?): Values
	local _, p = presetOf(preset)
	local night = WorldAtmosphere.NightShare(clock)
	local d, n = p.Day, p.Night
	local wl = worldLighting()
	local dayAmbient: Color3 = if typeof(wl.DayAmbient) == "Color3" then wl.DayAmbient else d.Ambient
	return {
		ClockTime = clock % 24,
		Night = night,
		Brightness = r3(d.Brightness + (n.Brightness - d.Brightness) * night),
		Ambient = lerpColor(dayAmbient, n.Ambient, night),
		OutdoorAmbient = lerpColor(d.OutdoorAmbient, n.OutdoorAmbient, night),
		Density = r3(d.Density + (n.Density - d.Density) * night),
		Offset = r3(d.Offset + (n.Offset - d.Offset) * night),
		Color = lerpColor(d.Color, n.Color, night),
		Decay = lerpColor(d.Decay, n.Decay, night),
		Glare = r3(d.Glare + (n.Glare - d.Glare) * night),
		Haze = r3(d.Haze + (n.Haze - d.Haze) * night),
	}
end

local function ensureSky(): Sky
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	local s = sky :: Sky
	local cfg = WorldConfig.Atmosphere.Sky
	s.Name = "WE_Sky"
	s.CelestialBodiesShown = true
	s.StarCount = cfg.StarCount
	s.SunAngularSize = cfg.SunAngularSize
	s.MoonAngularSize = cfg.MoonAngularSize
	return s
end

local function ensureAtmosphere(): Atmosphere
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	return atm :: Atmosphere
end

-- the properties one step can write: { object ("L" = Lighting, "A" = Atmosphere), property }
local FIELDS: { { string } } = {
	{ "L", "ClockTime" },
	{ "L", "Brightness" },
	{ "L", "Ambient" },
	{ "L", "OutdoorAmbient" },
	{ "A", "Density" },
	{ "A", "Offset" },
	{ "A", "Color" },
	{ "A", "Decay" },
	{ "A", "Glare" },
	{ "A", "Haze" },
}

-- write only what differs from the last written values; returns the number of property writes
local function write(atm: Atmosphere?, v: Values, last: Values?): number
	local n = 0
	local cur: any, old: any = v, last or {}
	for _, f in ipairs(FIELDS) do
		local key = f[2]
		if cur[key] ~= old[key] then
			n += 1
			if atm then
				local obj: any = if f[1] == "L" then Lighting else atm
				obj[key] = cur[key]
			end
		end
	end
	return n
end

local function setNightLights(on: boolean)
	for _, inst in ipairs(CollectionService:GetTagged(WorldConfig.Atmosphere.NightLightTag)) do
		if inst:IsA("Light") then
			inst.Enabled = on
		end
	end
end

-- counters of the running loop (Counters() returns a copy)
local stats = { Steps = 0, Writes = 0, LightFlips = 0 }

function WorldAtmosphere.Apply(opts: { Preset: string?, DayCycle: boolean?, StartClock: number? }?): Handle
	local cfg = WorldConfig.Atmosphere
	local key = presetOf(opts and opts.Preset)
	local wl = worldLighting()
	local lc = cfg.Lighting

	Lighting.GeographicLatitude = lc.GeographicLatitude
	Lighting.EnvironmentDiffuseScale = if type(wl.EnvironmentDiffuseScale) == "number" then wl.EnvironmentDiffuseScale else lc.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = lc.EnvironmentSpecularScale
	pcall(function()
		Lighting.GlobalShadows = lc.GlobalShadows
	end)
	ensureSky()
	local atm = ensureAtmosphere()

	local clock = if opts and opts.StartClock then opts.StartClock else cfg.StartClock
	local last = WorldAtmosphere.Sample(clock, key)
	write(atm, last, nil)
	local nightOn = last.Night > 0.5
	setNightLights(nightOn)

	-- one loop at a time: replacing the marker stops every earlier loop (ours and MapSetup's old one)
	local old = Lighting:FindFirstChild(MARKER)
	if old then
		old:Destroy()
	end
	local marker = Instance.new("Folder")
	marker.Name = MARKER
	marker:SetAttribute("WE_Preset", key)
	marker.Parent = Lighting

	stats.Steps, stats.Writes, stats.LightFlips = 0, 0, 0
	if not (opts and opts.DayCycle == false) then
		local stepSeconds = cfg.StepSeconds
		local stepHours = 24 * stepSeconds / (cfg.DayLengthMinutes * 60)
		task.spawn(function()
			while marker.Parent do
				task.wait(stepSeconds)
				if not marker.Parent then
					break
				end
				clock = (clock + stepHours) % 24
				local v = WorldAtmosphere.Sample(clock, key)
				stats.Steps += 1
				stats.Writes += write(atm, v, last)
				last = v
				local on = v.Night > 0.5
				if on ~= nightOn then
					nightOn = on
					stats.LightFlips += 1
					setNightLights(on)
				end
			end
		end)
	end
	return {
		Preset = key,
		Stop = function()
			if marker.Parent then
				marker:Destroy()
			end
		end,
	}
end

-- Counters of the running loop since the last Apply (steps, property writes, night-light flips).
function WorldAtmosphere.Counters(): { Steps: number, Writes: number, LightFlips: number }
	return { Steps = stats.Steps, Writes = stats.Writes, LightFlips = stats.LightFlips }
end

-- PURE: what the loop would do over `hours` of game time from `clock` at the configured cadence (no writes).
function WorldAtmosphere.Simulate(hours: number, clock: number?, preset: string?): { Steps: number, Writes: number, LightFlips: number, Seconds: number }
	local cfg = WorldConfig.Atmosphere
	local stepHours = 24 * cfg.StepSeconds / (cfg.DayLengthMinutes * 60)
	local t = clock or cfg.StartClock
	local last = WorldAtmosphere.Sample(t, preset)
	local nightOn = last.Night > 0.5
	local out = { Steps = 0, Writes = 0, LightFlips = 0, Seconds = 0 }
	local steps = math.floor(hours / stepHours + 0.5)
	for _ = 1, steps do
		t = (t + stepHours) % 24
		local v = WorldAtmosphere.Sample(t, preset)
		out.Steps += 1
		out.Writes += write(nil, v, last)
		last = v
		if (v.Night > 0.5) ~= nightOn then
			nightOn = v.Night > 0.5
			out.LightFlips += 1
		end
	end
	out.Seconds = out.Steps * cfg.StepSeconds
	return out
end

return WorldAtmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">WorldBounds</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 1 — WorldBounds: what closes the map beyond the Terrain edge (gap/world_v2_spec.md §1.1,
	§1.3–§1.5). Parts only, all numbers in WorldConfig (Skyline, Bounds, Seabed, FarShore):
	  * <root>.WE_Skyline (Model, ModelStreamingMode = Persistent): 16 ridges x 3 parts (body block, front WedgePart
	    rising outward, peak block) on the square ring r 2700..3300, 340–420 tall, no physics (Anchored; CanCollide,
	    CanQuery, CanTouch, CastShadow false), darker and bluer than the belt.
	  * <root>.WE_Bounds (Folder):
	      GroundWall  10 invisible collidable parts at x ±1960, z -1960 / 2300, 400 tall (players and vehicles)
	      AirWall     12 invisible collidable parts at x ±2050, z -2050 / 2350, 700 tall (aircraft backstop)
	                  both: Transparency 1, CanQuery / CanTouch / CastShadow false (rays, probes and shots pass)
	      SeabedTint  8 flat no-physics SmoothPlastic parts inside the water volume (deep Bay band + canal stripes)
	      FarShore    Lighthouse (10 parts, one night-only SpotLight tagged WE_NightLight) on the Terrain rock pad,
	                  and a stranded freighter (12 parts in two Models <= 64 across; its low hull is the boats' "land")
	  Total 100 parts (48 + 52). Every part <= 2,000 studs per axis.

	PUBLIC API (server only; not hooked yet — the post-F hook step calls Build from MapSetup.Run):
	  WorldBounds.Build(root: Instance, opts?: { Force: boolean? }) -> Result
	      Idempotent: when root already holds WE_Skyline + WE_Bounds stamped with WorldConfig.Gen and the expected
	      part counts, nothing is touched (Result.Skipped = true); otherwise both are rebuilt from scratch.
	  WorldBounds.AirBox() -> { X, ZMin, ZMax, MaxY }   (WorldConfig.Bounds.Air; hand-off to the vehicles workflow)
	  WorldBounds.InAirBox(pos: Vector3) -> boolean
	  WorldBounds.Expected() -> { Skyline: number, Bounds: number }   (part counts Build produces)
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs")
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))

export type Result = {
	Skipped: boolean,
	Skyline: Model?,
	Folder: Folder?,
	SkylineParts: number,
	BoundsParts: number,
	Lights: number,
}

local WorldBounds = {}

local GROUND_TOP_Y = 0.5
local UP = Vector3.new(0, 1, 0)
local GEN_ATTR = "WE_BoundsGen"

local LIGHTHOUSE_PARTS = 10
local FREIGHTER_PARTS = 12

-- ── helpers ──────────────────────────────────────────────────────────────────

type PartSpec = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3?,
	Material: Enum.Material?,
	Transparency: number?,
	Collide: boolean?, -- default false
	Query: boolean?, -- default = Collide
	Class: string?, -- "Part" (default) | "WedgePart"
}

local function makePart(spec: PartSpec, parent: Instance): BasePart
	local p: BasePart = if spec.Class == "WedgePart" then Instance.new("WedgePart") else Instance.new("Part")
	p.Name = spec.Name
	p.Anchored = true
	p.Size = spec.Size
	p.CFrame = spec.CFrame
	p.Color = spec.Color or Color3.fromRGB(128, 128, 128)
	p.Material = spec.Material or Enum.Material.SmoothPlastic
	p.Transparency = spec.Transparency or 0
	local collide = spec.Collide == true
	p.CanCollide = collide
	p.CanQuery = if spec.Query ~= nil then spec.Query else collide
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function countParts(inst: Instance): number
	local n = 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

-- Frame at pos whose local +Z is the outward normal n (a WedgePart rises toward +Z) and +X runs along the side.
local function frame(pos: Vector3, n: Vector3): CFrame
	return CFrame.fromMatrix(pos, UP:Cross(n), UP, n)
end

-- pieces of <= maxPiece covering a..b: { centre, length }
local function pieces(a: number, b: number, maxPiece: number): { { number } }
	local len = b - a
	local n = math.max(1, math.ceil(len / maxPiece - 1e-9))
	local step = len / n
	local out: { { number } } = {}
	for i = 1, n do
		table.insert(out, { a + (i - 0.5) * step, step })
	end
	return out
end

-- ── skyline ──────────────────────────────────────────────────────────────────

local function buildSkyline(root: Instance): Model
	local cfg = WorldConfig.Skyline
	local model = Instance.new("Model")
	model.Name = cfg.Name
	pcall(function()
		(model :: any).ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	local rng = Random.new(cfg.Seed)
	local mid = (cfg.RInner + cfg.ROuter) * 0.5
	local sides = {
		{ Name = "N", N = Vector3.new(0, 0, -1) },
		{ Name = "E", N = Vector3.new(1, 0, 0) },
		{ Name = "S", N = Vector3.new(0, 0, 1) },
		{ Name = "W", N = Vector3.new(-1, 0, 0) },
	}
	local span = cfg.ROuter * 2
	local segLen = span / cfg.PerSide
	for _, side in ipairs(sides) do
		local n = side.N
		local t = UP:Cross(n)
		for k = 1, cfg.PerSide do
			local along = -cfg.ROuter + (k - 0.5) * segLen
			local h = rng:NextNumber(cfg.HeightMin, cfg.HeightMax)
			local hb = h * cfg.BodyShare
			local yaw = math.rad(rng:NextNumber(-cfg.YawJitter, cfg.YawJitter))
			local len = segLen + cfg.Overlap
			local centre = n * mid + t * along
			local rot = CFrame.Angles(0, yaw, 0)
			-- body: from the slope's top edge to ROuter
			local bodyFrom = cfg.RInner + cfg.SlopeDepth
			local bodyDepth = cfg.ROuter - bodyFrom
			local bodyAt = n * (bodyFrom + bodyDepth * 0.5) + t * along
			makePart({
				Name = string.format("Ridge_%s%d_Body", side.Name, k),
				Size = Vector3.new(len, hb, bodyDepth),
				CFrame = CFrame.new(centre) * rot * CFrame.new(centre):Inverse() * frame(bodyAt + UP * (GROUND_TOP_Y + hb * 0.5), n),
				Color = cfg.Colors.Body,
				Material = cfg.Material,
			}, model)
			-- front slope: rises outward from RInner to the body
			local slopeAt = n * (cfg.RInner + cfg.SlopeDepth * 0.5) + t * along
			makePart({
				Name = string.format("Ridge_%s%d_Slope", side.Name, k),
				Size = Vector3.new(len, hb, cfg.SlopeDepth),
				CFrame = CFrame.new(centre) * rot * CFrame.new(centre):Inverse() * frame(slopeAt + UP * (GROUND_TOP_Y + hb * 0.5), n),
				Color = cfg.Colors.Slope,
				Material = cfg.Material,
				Class = "WedgePart",
			}, model)
			-- peak: a shorter block standing on the body at a random place along the ridge
			local plen = segLen * rng:NextNumber(cfg.PeakLength[1], cfg.PeakLength[2])
			local poff = rng:NextNumber(-(segLen - plen) * 0.5, (segLen - plen) * 0.5)
			local peakDepth = bodyDepth * 0.7
			local peakAt = n * (bodyFrom + bodyDepth * 0.45) + t * (along + poff)
			makePart({
				Name = string.format("Ridge_%s%d_Peak", side.Name, k),
				Size = Vector3.new(plen, h, peakDepth),
				CFrame = CFrame.new(centre) * rot * CFrame.new(centre):Inverse() * frame(peakAt + UP * (GROUND_TOP_Y + h * 0.5), n),
				Color = cfg.Colors.Peak,
				Material = cfg.Material,
			}, model)
		end
	end
	model.Parent = root
	return model
end

-- ── invisible walls ──────────────────────────────────────────────────────────

type WallCfg = { X: number, ZMin: number, ZMax: number, Height: number, Thick: number, MaxPiece: number }

local function buildWall(parent: Instance, name: string, w: WallCfg)
	local folder = Instance.new("Folder")
	folder.Name = name
	local y = GROUND_TOP_Y + w.Height * 0.5
	local th = w.Thick
	-- west / east: along z from ZMin to ZMax
	for _, sgn in ipairs({ -1, 1 }) do
		for i, pc in ipairs(pieces(w.ZMin, w.ZMax, w.MaxPiece)) do
			makePart({
				Name = string.format("%s_%s%d", name, if sgn < 0 then "W" else "E", i),
				Size = Vector3.new(th, w.Height, pc[2]),
				CFrame = CFrame.new(sgn * (w.X + th * 0.5), y, pc[1]),
				Transparency = 1,
				Collide = true,
				Query = false,
			}, folder)
		end
	end
	-- north / south: along x from -X to X
	local edges: { { Tag: string, Z: number } } = { { Tag = "N", Z = w.ZMin - th * 0.5 }, { Tag = "S", Z = w.ZMax + th * 0.5 } }
	for _, edge in ipairs(edges) do
		for i, pc in ipairs(pieces(-w.X - th, w.X + th, w.MaxPiece)) do
			makePart({
				Name = string.format("%s_%s%d", name, edge.Tag, i),
				Size = Vector3.new(pc[2], w.Height, th),
				CFrame = CFrame.new(pc[1], y, edge.Z),
				Transparency = 1,
				Collide = true,
				Query = false,
			}, folder)
		end
	end
	folder.Parent = parent
end

-- ── seabed tint ──────────────────────────────────────────────────────────────

local function buildSeabed(parent: Instance)
	local cfg = WorldConfig.Seabed
	local folder = Instance.new("Folder")
	folder.Name = "SeabedTint"
	for _, r in ipairs(cfg.Rects) do
		makePart({
			Name = r.Name or "SeabedTint",
			Size = Vector3.new(r.X1 - r.X0, cfg.Y1 - cfg.Y0, r.Z1 - r.Z0),
			CFrame = CFrame.new((r.X0 + r.X1) * 0.5, (cfg.Y0 + cfg.Y1) * 0.5, (r.Z0 + r.Z1) * 0.5),
			Color = cfg.Color,
			Material = cfg.Material,
		}, folder)
	end
	folder.Parent = parent
end

-- ── far shore: lighthouse and stranded freighter ─────────────────────────────

local WHITE = Color3.fromRGB(226, 222, 210)
local RED = Color3.fromRGB(150, 58, 46)
local DARK = Color3.fromRGB(46, 44, 42)
local CONCRETE = Color3.fromRGB(150, 144, 130)

local function buildLighthouse(parent: Instance)
	local cfg = WorldConfig.FarShore.Lighthouse
	local model = Instance.new("Model")
	model.Name = "Lighthouse"
	local base = CFrame.new(cfg.X, cfg.BaseY, cfg.Z) * CFrame.Angles(0, math.rad(cfg.Yaw), 0)
	local function at(y: number): CFrame
		return base * CFrame.new(0, y, 0)
	end
	local y = -1
	local function stack(name: string, size: Vector3, color: Color3, material: Enum.Material, collide: boolean): BasePart
		local p = makePart({ Name = name, Size = size, CFrame = at(y + size.Y * 0.5), Color = color, Material = material, Collide = collide }, model)
		y += size.Y
		return p
	end
	stack("Plinth", Vector3.new(14, 4, 14), CONCRETE, Enum.Material.Concrete, true)
	stack("TowerLow", Vector3.new(9, 14, 9), WHITE, Enum.Material.SmoothPlastic, true)
	stack("TowerMid", Vector3.new(8, 12, 8), RED, Enum.Material.SmoothPlastic, true)
	stack("TowerTop", Vector3.new(7, 10, 7), WHITE, Enum.Material.SmoothPlastic, true)
	stack("Gallery", Vector3.new(11, 0.8, 11), DARK, Enum.Material.Metal, true)
	local lamp = stack("LampRoom", Vector3.new(6, 5, 6), WorldConfig.Lights.LampHeadColor, Enum.Material.SmoothPlastic, false)
	lamp.Transparency = 0.25
	stack("Roof", Vector3.new(7, 2, 7), RED, Enum.Material.SmoothPlastic, false)
	stack("Spire", Vector3.new(1, 3, 1), DARK, Enum.Material.Metal, false)
	makePart({ Name = "Door", Size = Vector3.new(3, 5, 0.4), CFrame = base * CFrame.new(0, 5.5, -4.7), Color = DARK, Material = Enum.Material.Wood }, model)
	makePart({ Name = "Window", Size = Vector3.new(2, 2.4, 0.3), CFrame = base * CFrame.new(0, 24, -4.1), Color = DARK, Material = Enum.Material.Glass }, model)
	-- one night-only SpotLight over the Bay (north = -Z), within the H8 caps
	local lc = cfg.Light
	local spot = Instance.new("SpotLight")
	spot.Name = "Beacon"
	spot.Face = Enum.NormalId.Front
	spot.Brightness = math.min(lc.Brightness, WorldConfig.Lights.MaxBrightness)
	spot.Range = math.min(lc.Range, WorldConfig.Lights.MaxRange)
	spot.Angle = lc.Angle
	spot.Color = lc.Color
	spot.Shadows = false
	spot.Enabled = false -- WorldAtmosphere enables WE_NightLight lights at night
	spot.Parent = lamp
	CollectionService:AddTag(spot, WorldConfig.Atmosphere.NightLightTag)
	model.Parent = parent
end

local function buildFreighter(parent: Instance)
	local cfg = WorldConfig.FarShore.Freighter
	local rust = Color3.fromRGB(112, 62, 46)
	local hullCol = Color3.fromRGB(70, 74, 78)
	local deckCol = Color3.fromRGB(96, 92, 84)
	-- hull frame: origin on the waterline at the hull centre, +Z = bow (up the beach), bow pitched up, slight roll
	local hull = CFrame.new(cfg.X, 1.5, cfg.Z)
		* CFrame.Angles(0, math.rad(cfg.Yaw), 0)
		* CFrame.Angles(math.rad(-cfg.Pitch), 0, math.rad(cfg.Roll))
	local stern = Instance.new("Model")
	stern.Name = "Freighter_Stern"
	local bow = Instance.new("Model")
	bow.Name = "Freighter_Bow"
	local function hp(model: Model, name: string, size: Vector3, x: number, y: number, z: number, color: Color3, material: Enum.Material, collide: boolean, class: string?, turn: CFrame?)
		local cf = hull * CFrame.new(x, y, z)
		if turn then
			cf *= turn
		end
		makePart({ Name = name, Size = size, CFrame = cf, Color = color, Material = material, Collide = collide, Class = class }, model)
	end
	-- low hull = the boats' "land": top ~3 above the waterline, under the +6 land probe origin
	hp(stern, "KeelStern", Vector3.new(16, 5, 42), 0, -1.5, -21, rust, Enum.Material.Metal, true)
	hp(bow, "KeelBow", Vector3.new(16, 5, 36), 0, -1.5, 18, rust, Enum.Material.Metal, true)
	hp(stern, "HullStern", Vector3.new(18, 7, 42), 0, 4.5, -21, hullCol, Enum.Material.Metal, true)
	hp(bow, "HullBow", Vector3.new(18, 7, 36), 0, 4.5, 18, hullCol, Enum.Material.Metal, true)
	-- raked stem: a WedgePart turned over (flat top, full height at the hull joint, slope facing forward and down)
	hp(bow, "Stem", Vector3.new(18, 9, 10), 0, 3.5, 41, hullCol, Enum.Material.Metal, true, "WedgePart", CFrame.Angles(math.pi, 0, 0))
	hp(stern, "Bridge", Vector3.new(14, 10, 10), 0, 13, -34, deckCol, Enum.Material.Metal, true)
	hp(stern, "BridgeWindows", Vector3.new(14.2, 1.4, 0.4), 0, 16, -28.9, DARK, Enum.Material.Glass, false)
	hp(stern, "Funnel", Vector3.new(4, 7, 4), 0, 21.5, -37, RED, Enum.Material.Metal, true)
	hp(stern, "Mast", Vector3.new(0.8, 12, 0.8), 0, 24, -30, DARK, Enum.Material.Metal, false)
	hp(bow, "ContainerA", Vector3.new(8, 8, 18), -4.2, 12, 6, Color3.fromRGB(46, 92, 120), Enum.Material.DiamondPlate, true)
	hp(bow, "ContainerB", Vector3.new(8, 8, 18), 4.2, 12, 10, Color3.fromRGB(150, 110, 48), Enum.Material.DiamondPlate, true)
	hp(bow, "CraneBoom", Vector3.new(1.2, 1.2, 20), 0, 19, 20, Color3.fromRGB(190, 150, 50), Enum.Material.Metal, false)
	stern.Parent = parent
	bow.Parent = parent
end

-- ── public ───────────────────────────────────────────────────────────────────

function WorldBounds.Expected(): { Skyline: number, Bounds: number }
	local b = WorldConfig.Bounds
	local function wallCount(w: WallCfg): number
		return 2 * #pieces(w.ZMin, w.ZMax, w.MaxPiece) + 2 * #pieces(-w.X - w.Thick, w.X + w.Thick, w.MaxPiece)
	end
	return {
		Skyline = 4 * WorldConfig.Skyline.PerSide * 3,
		Bounds = wallCount(b.GroundWall) + wallCount(b.AirWall) + #WorldConfig.Seabed.Rects + LIGHTHOUSE_PARTS + FREIGHTER_PARTS,
	}
end

function WorldBounds.Build(root: Instance, opts: { Force: boolean? }?): Result
	local exp = WorldBounds.Expected()
	local oldSky = root:FindFirstChild(WorldConfig.Skyline.Name)
	local oldFolder = root:FindFirstChild(WorldConfig.Bounds.Folder)
	local force = opts ~= nil and opts.Force == true
	if
		not force
		and oldSky
		and oldFolder
		and oldSky:IsA("Model")
		and oldFolder:IsA("Folder")
		and oldSky:GetAttribute(GEN_ATTR) == WorldConfig.Gen
		and oldFolder:GetAttribute(GEN_ATTR) == WorldConfig.Gen
		and countParts(oldSky) == exp.Skyline
		and countParts(oldFolder) == exp.Bounds
	then
		return { Skipped = true, Skyline = oldSky, Folder = oldFolder, SkylineParts = exp.Skyline, BoundsParts = exp.Bounds, Lights = 1 }
	end
	if oldSky then
		oldSky:Destroy()
	end
	if oldFolder then
		oldFolder:Destroy()
	end

	local sky = buildSkyline(root)
	sky:SetAttribute(GEN_ATTR, WorldConfig.Gen)

	local folder = Instance.new("Folder")
	folder.Name = WorldConfig.Bounds.Folder
	buildWall(folder, "GroundWall", WorldConfig.Bounds.GroundWall)
	buildWall(folder, "AirWall", WorldConfig.Bounds.AirWall)
	buildSeabed(folder)
	local far = Instance.new("Folder")
	far.Name = "FarShore"
	buildLighthouse(far)
	buildFreighter(far)
	far.Parent = folder
	folder:SetAttribute(GEN_ATTR, WorldConfig.Gen)
	folder.Parent = root

	local skyParts, boundsParts = countParts(sky), countParts(folder)
	if skyParts ~= exp.Skyline or boundsParts ~= exp.Bounds then
		warn(string.format("[WAR EMPIRE] WorldBounds: built %d skyline / %d bounds parts (expected %d / %d)", skyParts, boundsParts, exp.Skyline, exp.Bounds))
	end
	print(string.format("[WAR EMPIRE] WorldBounds: skyline %d parts (Persistent), bounds %d parts", skyParts, boundsParts))
	return { Skipped = false, Skyline = sky, Folder = folder, SkylineParts = skyParts, BoundsParts = boundsParts, Lights = 1 }
end

function WorldBounds.AirBox(): { X: number, ZMin: number, ZMax: number, MaxY: number }
	local a = WorldConfig.Bounds.Air
	return { X = a.X, ZMin = a.ZMin, ZMax = a.ZMax, MaxY = a.MaxY }
end

function WorldBounds.InAirBox(pos: Vector3): boolean
	local a = WorldConfig.Bounds.Air
	return math.abs(pos.X) <= a.X and pos.Z >= a.ZMin and pos.Z <= a.ZMax and pos.Y <= a.MaxY
end

return WorldBounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">WorldDress</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 2 (W3) — WorldDress: the travel dressing BETWEEN the POIs (gap/world_v2_spec.md §4.1–§4.4,
	roadmap §2.4 WORLD-B builder 2), plus the ONE shared keep-out source that WorldPOI and WorldDress both use.
	Tunables: Shared/Configs/WorldDressConfig. Kits: Modules/WorldKits (B1). Order (MapDressing.Dress, B2):
	WorldPOI.Build → Dockside (as-is) → WorldDress.Build (rhythm, junctions, shore, scatter) → Waterways.CullDressing →
	WorldHygiene.Enforce.

	CONTRACT (scratchpad/w3/contracts.md §3–§4): owner = B2. The keep-out source (Zones, NewOccupancy, AddDisc, Blocked,
	RoadDist, POIDist, Quality) is pure (config math only, no workspace reads, streaming-safe). Build composes every
	cluster from WorldKits (Part kits + Terrain rocks), seeded with WorldKits.Rng(Seed + salt) so the headless sim and a
	live server build the same layout, and never yields on InsertService (mesh overlays are WorldKits' deferred job).
	  Rhythm    — along every road: a spot every rng(140, 180), rng(16, 34) off the centre line, sides alternating;
	              kinds rotate rock outcrop (Terrain) / wreck or MG nest / flora group / km or hazard marker. Never within
	              70 of a junction, never in a keep-out; the real parts stay >= 13 (collidable) / >= 9 (visible) off
	              every road line (pushed out along the road, never past 34). Low: half of each road's clusters.
	  Junctions — one corner kit per visible junction: arrow post, jersey pair on both shoulders, sandbag arc, boulders.
	  Shore     — every 320 along the ring canal's inner bank (revetment / reeds + rocks / jetty stub / barge wreck; the
	              jetty, barge and beached hull step <= 10 into the canal or the sea, never a channel, lagoon or harbour)
	              and every 300 along the Bay's north shore (driftwood + rocks / beached hull / dune grass).
	  Scatter   — Full only: natural clusters (Terrain rocks, flora groups, dead wood; >= 3 elements of >= 2 sizes) into
	              the largest empty circles until none is wider than 340 (Poisson: >= 120 apart, >= 40 off roads).

	PUBLIC API (server only; WorldDress never requires WorldPOI):
	  WorldDress.Zones() -> Zones
	      Every keep-out from the configs: ring interior, road centre lines, water (public + channels + plot water),
	      plot pads, front-gate aprons, land garage pads, capture clear circles, the Empire Bank, event / NPC anchors,
	      rig pier corridors, all 18 POI footprints (enabled or not) and the 6 visible junctions. Depends on
	      BaseLayoutConfig.FaceMapCentre exactly like Waterways / WorldHygiene.
	  WorldDress.NewOccupancy(zones?) -> Occupancy          zones + the discs placed so far (POI clusters, travel clusters)
	  WorldDress.AddDisc(occ, x, z, r, kind)
	  WorldDress.Blocked(occ, x, z, r, opts?) -> string?     nil = the disc (centre x, z, radius r) is free; else the first
	                                                          reason: "ring" | "road" | "water:<rect>" | "plot:<n>" |
	                                                          "apron:<n>" | "pad:<id>" | "capture:<id>" | "structure:<n>" |
	                                                          "anchor:<id>" | "clear:<n>" | "poi:<Id>" | "occupied:<kind>"
	                                                          W3 step 2: a camp's own NPC anchors (inside a Kind "camp"
	                                                          footprint) are no keep-out when AllowPOI names that camp
	                                                          (its sandbags stand at the guard posts); opts.SkipEvents
	                                                          lets a flat marking / the invisible activity host lie over
	                                                          an event anchor (every other zone still counts)
	  WorldDress.RoadDist(zones, x, z) -> number             XZ distance to the nearest road centre segment
	  WorldDress.POIDist(poi, x, z) -> number                XZ distance to a POI footprint (0 inside)
	  WorldDress.Quality(q?) -> "Full" | "Low"
	  WorldDress.Build(dressing, quality, occ?) -> Summary   builds WorldDressing.Rhythm / Junctions / Shore / Scatter
                                                          (replaces old ones: idempotent) and logs one summary line
  WorldDress.Emptiness(occ, cell?) -> Emptiness           the V10 metric over an occupancy (share of dry land > 100
                                                          from anything, the largest empty circle)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage.Shared.Configs
local WorldConfig = require(Configs.WorldConfig)
local WorldDressConfig = require(Configs.WorldDressConfig)
local TerritoryConfig = require(Configs.TerritoryConfig)
local BaseConfig = require(Configs.BaseConfig)
local BankRaidConfig = require(Configs.BankRaidConfig)
local BaseLayout = require(script.Parent.BaseLayout)
local Waterways = require(script.Parent.Waterways)
local WorldKits = require(script.Parent.WorldKits)

export type Rect = { Name: string, X0: number, X1: number, Z0: number, Z1: number }
export type Circle = { Name: string, X: number, Z: number, R: number, Owner: string? } -- Owner: the camp an NPC anchor belongs to
export type Road = Waterways.RoadLine
export type POIZone = { Id: string, Enabled: boolean, Rect: Rect?, Circle: Circle? }
export type Point = { X: number, Z: number }
export type Zones = {
	Ring: Rect,
	Roads: { Road },
	Water: { Rect },
	PlotPads: { Rect },
	Aprons: { Rect },
	Pads: { Rect },
	Captures: { Circle }, -- radius = Territory R x CaptureScale + CaptureExtra
	Structures: { Circle },
	Anchors: { Circle },
	ClearRects: { Rect },
	POIs: { POIZone },
	Junctions: { Point },
}
export type Disc = { X: number, Z: number, R: number, Kind: string }
export type Occupancy = { Zones: Zones, Discs: { Disc } }
export type BlockOpts = {
	AllowPOI: string?, -- the POI being built: its own footprint is not a keep-out (every zone inside it still is)
	RoadClear: number?, -- default Keepout.RoadClear (13): disc edge to any road centre line
	RoadR: number?, -- radius used for the road test only (default r): e.g. a kit's across-road half extent
	POIMargin: number?, -- default Keepout.POIMargin (30)
	Spacing: number?, -- min edge-to-edge gap to every disc already in the occupancy (nil = no spacing test)
	AllowWater: boolean?, -- jetty stub / barge / hull: skip the water test (the cluster carries WE_AllowInWater)
	SkipRing: boolean?,
	SkipEvents: boolean?, -- W3 step 2: a flat marking / the invisible activity host may lie over an event anchor
}
export type SectionSummary = {
	Name: string, -- "Rhythm" | "Junctions" | "Shore" | "Scatter"
	Clusters: number,
	Parts: number,
	PartsCap: number,
	TerrainPrims: number,
	Rejected: { [string]: number }, -- candidate spots dropped, by Blocked reason
}
export type Summary = {
	Quality: string,
	Sections: { SectionSummary },
	Parts: number,
	Clusters: number,
	TerrainPrims: number,
	LargestEmpty: number, -- diameter of the largest empty circle after scatter (0 = not measured)
	Far100: number, -- share of dry land > 100 studs from anything (0 = not measured)
	Seconds: number,
	Warnings: { string },
}

local WorldDress = {}

local K = WorldDressConfig.Keepout

-- ── geometry helpers ──────────────────────────────────────────────────────────────────────────────────────────────

local function rectDist(r: Rect, x: number, z: number): number
	local dx = math.max(r.X0 - x, 0, x - r.X1)
	local dz = math.max(r.Z0 - z, 0, z - r.Z1)
	return math.sqrt(dx * dx + dz * dz)
end

local function toSet(list: { string }): { [string]: boolean }
	local s: { [string]: boolean } = {}
	for _, v in ipairs(list) do
		s[v] = true
	end
	return s
end

function WorldDress.RoadDist(zones: Zones, x: number, z: number): number
	local best = math.huge
	for _, r in ipairs(zones.Roads) do
		local along = if r.AlongX then x else z
		local across = if r.AlongX then z else x
		local t = math.clamp(along, r.Min, r.Max)
		local d = math.sqrt((along - t) ^ 2 + (across - r.Across) ^ 2)
		if d < best then
			best = d
		end
	end
	return best
end

function WorldDress.POIDist(poi: POIZone, x: number, z: number): number
	local rect = poi.Rect
	if rect then
		return rectDist(rect, x, z)
	end
	local c = poi.Circle
	if c then
		return math.max(0, math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) - c.R)
	end
	return math.huge
end

function WorldDress.Quality(q: string?): string
	return if string.lower(tostring(q or "Low")) == "full" then "Full" else "Low"
end

local EVENT_PREFIX = "Event_" -- the event-anchor zone names (Blocked: "anchor:Event_<Id>")
local CAMP_KIND = "camp" -- WorldConfig.POIs Kind of the camps whose NPC anchors are their own guard posts

-- the camp POI whose footprint holds (x, z), if any (enabled or not: a disabled camp builds nothing anyway)
local function campOf(x: number, z: number): string?
	for _, p in ipairs(WorldConfig.POIs) do
		if p.Kind == CAMP_KIND then
			local zone: POIZone = { Id = p.Id, Enabled = true, Rect = nil, Circle = nil }
			if p.Rect then
				zone.Rect = { Name = p.Id, X0 = p.Rect.X0, X1 = p.Rect.X1, Z0 = p.Rect.Z0, Z1 = p.Rect.Z1 }
			elseif p.Circle then
				zone.Circle = { Name = p.Id, X = p.Circle.X, Z = p.Circle.Z, R = p.Circle.R }
			end
			if (zone.Rect ~= nil or zone.Circle ~= nil) and WorldDress.POIDist(zone, x, z) <= 0 then
				return p.Id
			end
		end
	end
	return nil
end

-- ── the shared keep-out source ────────────────────────────────────────────────────────────────────────────────────

function WorldDress.Zones(): Zones
	local ring = K.Ring
	local zones: Zones = {
		Ring = { Name = "Ring", X0 = ring.X0, X1 = ring.X1, Z0 = ring.Z0, Z1 = ring.Z1 },
		Roads = Waterways.RoadLines(),
		Water = {},
		PlotPads = {},
		Aprons = {},
		Pads = {},
		Captures = {},
		Structures = {},
		Anchors = {},
		ClearRects = {},
		POIs = {},
		Junctions = {},
	}
	for _, r in ipairs(Waterways.AllRects()) do
		table.insert(zones.Water, { Name = r.Name or "water", X0 = r.X0, X1 = r.X1, Z0 = r.Z0, Z1 = r.Z1 })
	end

	-- plot pads and front-gate aprons (plot-local, so they turn with BaseLayoutConfig.FaceMapCentre)
	local plotPositions = BaseConfig.PlotPositions :: { Vector3 }
	local half = (BaseConfig.PlotSize :: Vector3).X * 0.5
	local apron = WorldConfig.Hygiene.GateApron
	for plotId, pos in ipairs(plotPositions) do
		table.insert(zones.PlotPads, { Name = "Plot" .. plotId, X0 = pos.X - half, X1 = pos.X + half, Z0 = pos.Z - half, Z1 = pos.Z + half })
		local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
		for _, c in ipairs({ { apron.X0, apron.Z0 }, { apron.X1, apron.Z0 }, { apron.X0, apron.Z1 }, { apron.X1, apron.Z1 } }) do
			local w = BaseLayout.PlotPoint(pos, c[1], c[2])
			x0, x1, z0, z1 = math.min(x0, w.X), math.max(x1, w.X), math.min(z0, w.Z), math.max(z1, w.Z)
		end
		table.insert(zones.Aprons, { Name = "Apron_P" .. plotId, X0 = x0, X1 = x1, Z0 = z0, Z1 = z1 })
	end

	-- land garage pads (MapSetup builds them from the same config; yaw is a multiple of 90, so the AABB is square)
	local padSize = WorldConfig.Spawns.PadSize
	local padHalf = math.max(padSize.X, padSize.Z) * 0.5
	for _, g in ipairs(WorldConfig.Spawns.Garage) do
		local px: number?, pz: number? = nil, nil
		if g.PlotId ~= nil then
			local pos = plotPositions[g.PlotId]
			if pos then
				local w = BaseLayout.PlotPoint(pos, g.LocalX or 0, g.LocalZ or 0)
				px, pz = w.X, w.Z
			end
		elseif g.X ~= nil and g.Z ~= nil then
			px, pz = g.X, g.Z
		end
		if px and pz then
			table.insert(zones.Pads, { Name = g.Id, X0 = px - padHalf, X1 = px + padHalf, Z0 = pz - padHalf, Z1 = pz + padHalf })
		end
	end

	-- capture clear circles (TerritoryCapture uses the marker half-diagonal)
	local skip = toSet(K.CaptureSkip)
	for id, t in pairs(TerritoryConfig.Territories :: { [string]: any }) do
		if not skip[id] then
			local p: Vector3 = t.Position
			local r: number = t.Radius
			table.insert(zones.Captures, { Name = id, X = p.X, Z = p.Z, R = r * K.CaptureScale + K.CaptureExtra })
		end
	end
	table.sort(zones.Captures, function(a: Circle, b: Circle): boolean
		return a.Name < b.Name
	end)

	-- the Empire Bank (plaza + guard ring; BankRaidService spawns guards on the ring)
	local bank: Vector3 = BankRaidConfig.Position
	local guardR: number = BankRaidConfig.GuardRingRadius or 18
	table.insert(zones.Structures, { Name = "EmpireBank", X = bank.X, Z = bank.Z, R = guardR + K.BankExtra })

	-- event anchors (supply crates land there) and NPC anchors (hostile spawns). W3 step 2: an NPC anchor inside a camp
	-- footprint (POI Kind "camp") belongs to that camp (Owner): the camp's own clusters may stand at it (the sandbags its
	-- guards stand behind), every other cluster still keeps out
	for _, a in ipairs(WorldConfig.Spawns.Event) do
		table.insert(zones.Anchors, { Name = EVENT_PREFIX .. a.Id, X = a.X, Z = a.Z, R = K.EventClear })
	end
	for _, a in ipairs(WorldConfig.Spawns.NPC) do
		table.insert(zones.Anchors, { Name = "NPC_" .. a.Id, X = a.X, Z = a.Z, R = K.NPCClear, Owner = campOf(a.X, a.Z) })
	end

	-- rig pier corridors (WorldConfig.Hygiene.ClearRects)
	for _, r in ipairs(WorldConfig.Hygiene.ClearRects) do
		table.insert(zones.ClearRects, { Name = r.Name or "clear", X0 = r.X0, X1 = r.X1, Z0 = r.Z0, Z1 = r.Z1 })
	end

	-- every POI footprint: enabled POIs are built by WorldPOI, disabled ones stay reserved for their later step
	for _, p in ipairs(WorldConfig.POIs) do
		local zone: POIZone = { Id = p.Id, Enabled = (p :: any).Enabled == true, Rect = nil, Circle = nil }
		if p.Rect then
			zone.Rect = { Name = p.Id, X0 = p.Rect.X0, X1 = p.Rect.X1, Z0 = p.Rect.Z0, Z1 = p.Rect.Z1 }
		elseif p.Circle then
			zone.Circle = { Name = p.Id, X = p.Circle.X, Z = p.Circle.Z, R = p.Circle.R }
		end
		table.insert(zones.POIs, zone)
	end

	for _, j in ipairs(WorldDressConfig.Junctions.Points) do
		table.insert(zones.Junctions, { X = j.X, Z = j.Z })
	end
	return zones
end

function WorldDress.NewOccupancy(zones: Zones?): Occupancy
	return { Zones = zones or WorldDress.Zones(), Discs = {} }
end

function WorldDress.AddDisc(occ: Occupancy, x: number, z: number, r: number, kind: string)
	table.insert(occ.Discs, { X = x, Z = z, R = r, Kind = kind })
end

function WorldDress.Blocked(occ: Occupancy, x: number, z: number, r: number, opts: BlockOpts?): string?
	local o: BlockOpts = opts or {}
	local zones = occ.Zones
	if not o.SkipRing then
		local ring = zones.Ring
		if x - r < ring.X0 or x + r > ring.X1 or z - r < ring.Z0 or z + r > ring.Z1 then
			return "ring"
		end
	end
	if WorldDress.RoadDist(zones, x, z) - (o.RoadR or r) < (o.RoadClear or K.RoadClear) then
		return "road"
	end
	if not o.AllowWater then
		for _, w in ipairs(zones.Water) do
			if rectDist(w, x, z) < r + K.WaterMargin then
				return "water:" .. w.Name
			end
		end
	end
	for _, p in ipairs(zones.PlotPads) do
		if rectDist(p, x, z) < r + K.PlotPadMargin then
			return "plot:" .. p.Name
		end
	end
	for _, a in ipairs(zones.Aprons) do
		if rectDist(a, x, z) < r + K.ApronMargin then
			return "apron:" .. a.Name
		end
	end
	for _, p in ipairs(zones.Pads) do
		if rectDist(p, x, z) < r + K.PadMargin then
			return "pad:" .. p.Name
		end
	end
	for _, c in ipairs(zones.Captures) do
		if math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) - r < c.R then
			return "capture:" .. c.Name
		end
	end
	for _, c in ipairs(zones.Structures) do
		if math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) - r < c.R then
			return "structure:" .. c.Name
		end
	end
	for _, c in ipairs(zones.Anchors) do
		local own = c.Owner ~= nil and c.Owner == o.AllowPOI -- a camp's own guard post
		local event = o.SkipEvents == true and string.sub(c.Name, 1, #EVENT_PREFIX) == EVENT_PREFIX
		if not own and not event and math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) - r < c.R then
			return "anchor:" .. c.Name
		end
	end
	for _, c in ipairs(zones.ClearRects) do
		if rectDist(c, x, z) < r then
			return "clear:" .. c.Name
		end
	end
	local margin = o.POIMargin or K.POIMargin
	for _, p in ipairs(zones.POIs) do
		if p.Id ~= o.AllowPOI and WorldDress.POIDist(p, x, z) < r + margin then
			return "poi:" .. p.Id
		end
	end
	local spacing = o.Spacing
	if spacing ~= nil then
		for _, d in ipairs(occ.Discs) do
			if math.sqrt((x - d.X) ^ 2 + (z - d.Z) ^ 2) - r - d.R < spacing then
				return "occupied:" .. d.Kind
			end
		end
	end
	return nil
end

-- ── Build ─────────────────────────────────────────────────────────────────────────────────────────────────────────
-- Every cluster is composed from WorldKits (B1's Part kits and Terrain rocks), checked against the keep-outs twice:
--   * its disc (centre, radius) with Blocked — the contract rule the verifier re-runs on the occupancy;
--   * its real parts, measured after WorldKits.Add: collidable parts >= 13 and visible parts >= 9 from every road centre
--     line (H2; a road-side cluster is pushed out along its road, never past Offset max), and the part AABBs clear every
--     WorldHygiene H3 zone (captures, aprons, garage pads + 16, plot pads + 4, pier corridors, water + 6).
-- So Waterways.CullDressing and WorldHygiene.Enforce find nothing to remove in these sections.

type Rng = WorldKits.Rng
type RockRow = WorldDressConfig.RockRow
type KitOpts = WorldKits.KitOpts
type Piece = { Kit: string, X: number, Z: number, Yaw: number, Opts: KitOpts? }
type RockReq = { Style: string, X: number, Z: number } -- local offsets in the cluster frame; Style = Terrain.Rocks key
type Recipe = { Pieces: { Piece }, Rocks: { RockReq }, Natural: boolean, InWater: boolean }
type Box = { X0: number, X1: number, Y0: number, Y1: number, Z0: number, Z1: number }
type Ctx = {
	Quality: string,
	Full: boolean,
	Occ: Occupancy,
	Zones: Zones,
	Warnings: { string },
	Prims: number, -- terrain prims actually filled
	PrimsReserved: number, -- MaxPrims per accepted rock, Full or Low alike (the budget decision never depends on quality)
	Busy: number,
	SegStart: number,
	SinceYield: number,
}
type Built = { Ok: boolean, Reason: string?, Model: Model?, X: number, Z: number, Parts: number, Rocks: { { Pos: Vector3, Style: string } } }
type Field = {
	Cell: number,
	X0: number, -- centre of cell 1
	Z0: number,
	NX: number,
	NZ: number,
	D2: { number }, -- squared distance to the nearest "anything" (capped at FieldMax^2)
	Valid: { boolean }, -- dry land, not on a plot pad
	Cap: number,
}
type EmptyCircle = { X: number, Z: number, R: number, Idx: number }

local HY = WorldConfig.Hygiene
local GROUND_Y = 0.5
local RH = WorldDressConfig.Rhythm
local JN = WorldDressConfig.Junctions
local SH = WorldDressConfig.Shore
local SC = WorldDressConfig.Scatter
local TR = WorldDressConfig.Terrain
local BUD = WorldDressConfig.Budgets
local FOLDERS = WorldDressConfig.Folders

local function hasPrefix(name: string, list: { string }): boolean
	for _, p in ipairs(list) do
		if string.sub(name, 1, #p) == p then
			return true
		end
	end
	return false
end

local ROAD_EXEMPT = toSet(HY.RoadExemptNames)

local function partBox(p: BasePart): Box
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = p.CFrame:GetComponents()
	local s = p.Size
	local hx = (math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z) * 0.5
	local hy = (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) * 0.5
	local hz = (math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z) * 0.5
	return { X0 = x - hx, X1 = x + hx, Y0 = y - hy, Y1 = y + hy, Z0 = z - hz, Z1 = z + hz }
end

local function partsOf(m: Instance): { BasePart }
	local out: { BasePart } = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(out, d)
		end
	end
	return out
end

local function unionBox(parts: { BasePart }): Box?
	if #parts == 0 then
		return nil
	end
	local b: Box = { X0 = math.huge, X1 = -math.huge, Y0 = math.huge, Y1 = -math.huge, Z0 = math.huge, Z1 = -math.huge }
	for _, p in ipairs(parts) do
		local pb = partBox(p)
		b.X0, b.X1 = math.min(b.X0, pb.X0), math.max(b.X1, pb.X1)
		b.Y0, b.Y1 = math.min(b.Y0, pb.Y0), math.max(b.Y1, pb.Y1)
		b.Z0, b.Z1 = math.min(b.Z0, pb.Z0), math.max(b.Z1, pb.Z1)
	end
	return b
end

local function translate(parts: { BasePart }, delta: Vector3)
	for _, p in ipairs(parts) do
		p.CFrame = p.CFrame + delta
	end
end

-- yaw (radians) whose LookVector (the kit front, local -Z) points along (dx, dz)
local function facingYaw(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

local function frameAt(x: number, z: number, yaw: number): CFrame
	return CFrame.new(x, GROUND_Y, z) * CFrame.Angles(0, yaw, 0)
end

-- H2 on the real parts. own = the road a road-side cluster stands beside (side = +1 / -1 across its centre line):
-- returns how far the cluster must move away from `own` so every collidable part is >= CollidableRoadGap and every
-- visible part >= VisibleRoadGap from it; any other road closer than that → a reason (the spot is dropped).
local function roadCheck(zones: Zones, parts: { BasePart }, own: Road?, side: number): (number, string?)
	local need = 0
	for _, p in ipairs(parts) do
		if not ROAD_EXEMPT[p.Name] then
			local b = partBox(p)
			local collide = p.CanCollide and b.Y1 > HY.RoadMinTop
			local visible = p.Transparency < 0.99 and b.Y1 > GROUND_Y + HY.RoadLaneMaxHeight and not hasPrefix(p.Name, HY.RoadMarkingPrefixes)
			if collide or visible then
				local req = if collide then RH.CollidableRoadGap else RH.VisibleRoadGap
				for _, r in ipairs(zones.Roads) do
					local a0, a1, c0, c1 = b.X0, b.X1, b.Z0, b.Z1
					if not r.AlongX then
						a0, a1, c0, c1 = b.Z0, b.Z1, b.X0, b.X1
					end
					if a1 >= r.Min and a0 <= r.Max then
						if own ~= nil and r.Name == own.Name then
							local signed = if side > 0 then c0 - r.Across else r.Across - c1
							if signed < req then
								need = math.max(need, req - signed)
							end
						else
							local gap = math.max(0, c0 - r.Across, r.Across - c1)
							if gap < req then
								return 0, "partroad:" .. r.Name
							end
						end
					end
				end
			end
		end
	end
	return need, nil
end

local function overlaps(b: Box, r: Rect, grow: number): boolean
	return b.X1 > r.X0 - grow and b.X0 < r.X1 + grow and b.Z1 > r.Z0 - grow and b.Z0 < r.Z1 + grow
end

local function boxPointDist(b: Box, x: number, z: number): number
	local dx = math.max(b.X0 - x, 0, x - b.X1)
	local dz = math.max(b.Z0 - z, 0, z - b.Z1)
	return math.sqrt(dx * dx + dz * dz)
end

-- WorldHygiene H3 on the cluster's part AABB (+ 0.5 slack): nil = clear. inWater: water overlap is allowed, but only
-- into SH.InWaterRects (the ring canal and the sea), never a channel, lagoon, harbour, slip or plot water.
local function zoneBoxCheck(zones: Zones, b: Box, inWater: boolean): string?
	local e = WorldConfig.Terrain.Edge
	if b.X1 >= e.Inner or b.X0 <= -e.Inner or b.Z0 <= -e.Inner or b.Z1 >= e.FarShoreZ then
		return "partzone:belt"
	end
	for _, c in ipairs(zones.Captures) do
		if boxPointDist(b, c.X, c.Z) < c.R + 0.5 then
			return "partzone:capture:" .. c.Name
		end
	end
	for _, a in ipairs(zones.Aprons) do
		if overlaps(b, a, 0.5) then
			return "partzone:" .. a.Name
		end
	end
	for _, p in ipairs(zones.Pads) do
		if overlaps(b, p, HY.PadClear + 0.5) then
			return "partzone:pad:" .. p.Name
		end
	end
	for _, p in ipairs(zones.PlotPads) do
		if overlaps(b, p, HY.PlotPadClear + 0.5) then
			return "partzone:" .. p.Name
		end
	end
	for _, c in ipairs(zones.ClearRects) do
		if overlaps(b, c, 0.5) then
			return "partzone:clear:" .. c.Name
		end
	end
	for _, w in ipairs(zones.Water) do
		if overlaps(b, w, HY.WaterClear + 0.5) then
			if not inWater or not hasPrefix(w.Name, SH.InWaterRects) then
				return "partzone:water:" .. w.Name
			end
		end
	end
	return nil
end

-- ── build context: yields, rocks, clusters ─────────────────────────────────────────────────────────────────────────

local function warnOnce(ctx: Ctx, msg: string)
	if #ctx.Warnings < 40 then
		table.insert(ctx.Warnings, msg)
	end
end

-- task.wait() at most every YieldEvery clusters, on the build thread itself (the sim's main-thread waits return at once)
local function maybeYield(ctx: Ctx)
	ctx.SinceYield += 1
	if BUD.YieldEvery > 0 and ctx.SinceYield >= BUD.YieldEvery then
		ctx.SinceYield = 0
		ctx.Busy += os.clock() - ctx.SegStart
		task.wait()
		ctx.SegStart = os.clock()
	end
end

local function rockRow(style: string): RockRow
	return TR.Rocks[style] or TR.Rocks.boulders
end

-- the keep-out test for one Terrain rock group (terrain collides: it stays out of the road corridor like a collidable part)
-- (skipRing: a bank rock between the ring box and the canal; the water + 6 rule is its boundary there)
local function rockBlocked(ctx: Ctx, pos: Vector3, style: string, skipRing: boolean?): string?
	local row = rockRow(style)
	if ctx.PrimsReserved + row.MaxPrims > math.min(BUD.TerrainPrims, TR.MaxPrims) then
		return "rockbudget"
	end
	return WorldDress.Blocked(ctx.Occ, pos.X, pos.Z, row.Outer, { RoadClear = RH.CollidableRoadGap, SkipRing = skipRing })
end

local function fillRock(ctx: Ctx, pos: Vector3, style: string, rng: Rng): number
	local row = rockRow(style)
	local kind = if style == "outcrop" then "outcrop" else "boulders"
	local ok, prims = pcall(WorldKits.Rock, pos, kind, rng, { Radius = row.Radius, Count = row.Count })
	if not ok then
		warnOnce(ctx, "WorldKits.Rock failed: " .. tostring(prims))
		return 0
	end
	local n = if type(prims) == "table" then #prims else 0
	ctx.Prims += n
	return n
end

local function localPos(frame: CFrame, x: number, z: number): Vector3
	return (frame * CFrame.new(x, 0, z)).Position
end

-- Builds the recipe's Part kits into a new UNPARENTED cluster (nil when it has no Part kits) and resolves its rock spots.
-- The caller moves / validates it, then keeps it (WorldKits.Finish) or destroys it.
local function compose(name: string, attrs: WorldKits.ClusterAttrs, frame: CFrame, recipe: Recipe): (Model?, number, { { Pos: Vector3, Style: string } })
	local model: Model? = nil
	local parts = 0
	if #recipe.Pieces > 0 then
		local m = WorldKits.NewCluster(name, attrs)
		for _, pc in ipairs(recipe.Pieces) do
			local cf = frame * CFrame.new(pc.X, 0, pc.Z) * CFrame.Angles(0, math.rad(pc.Yaw), 0)
			parts += WorldKits.Add(m, pc.Kit, cf, pc.Opts)
		end
		-- the travel dressing casts no shadows (contracts §2.2: 0 casters outside the POIs; phones)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CastShadow = false
			end
		end
		model = m
	end
	local rocks: { { Pos: Vector3, Style: string } } = {}
	for _, r in ipairs(recipe.Rocks) do
		table.insert(rocks, { Pos = localPos(frame, r.X, r.Z), Style = r.Style })
	end
	return model, parts, rocks
end

-- a cluster built but not Finished (a keep-out hit, or Low's dropped half): WorldKits drops its pending overlays too
local function destroyModel(m: Model?)
	if m then
		local discard = (WorldKits :: any).Discard
		if type(discard) == "function" then
			discard(m)
		else
			m:Destroy()
		end
	end
end

-- move the parts so their XZ box is centred on (x, z): road-side kits pivot at their front edge (WorldKits), so a
-- composed cluster is re-centred on its spot before the road rule measures it
local function centreOn(parts: { BasePart }, x: number, z: number)
	local b = unionBox(parts)
	if b then
		translate(parts, Vector3.new(x - (b.X0 + b.X1) * 0.5, 0, z - (b.Z0 + b.Z1) * 0.5))
	end
end

-- keep a validated cluster: parent it (WorldKits.Finish), fill its rocks, record its disc
local function commit(ctx: Ctx, folder: Instance, built: Built, rng: Rng, discR: number, kind: string, sec: SectionSummary): boolean
	local parts = 0
	local model = built.Model
	if model then
		local info = WorldKits.Finish(model, folder)
		if not info.Ok then
			sec.Rejected["finish"] = (sec.Rejected["finish"] or 0) + 1
			warnOnce(ctx, string.format("%s: WorldKits.Finish refused %s (%s)", sec.Name, model.Name, tostring(info.Reason)))
			return false
		end
		parts = info.Parts
	end
	for _, r in ipairs(built.Rocks) do
		sec.TerrainPrims += fillRock(ctx, r.Pos, r.Style, rng)
	end
	sec.Clusters += 1
	sec.Parts += parts
	WorldDress.AddDisc(ctx.Occ, built.X, built.Z, discR, kind)
	maybeYield(ctx)
	return true
end

local function reject(sec: SectionSummary, reason: string)
	local key = string.match(reason, "^([^:]+:?[^:]*)") or reason
	sec.Rejected[key] = (sec.Rejected[key] or 0) + 1
end

-- ── recipes (contracts §2.3; local frame: -Z = the front, toward the road / junction / water) ───────────────────────

local function jitter(rng: Rng, a: number): number
	return rng:NextNumber(-a, a)
end

local function floraRecipe(rng: Rng, variant: number): Recipe
	-- 3 plants at >= 2 sizes (a tall one, a short one, a barrel cactus): 5 parts
	local tall, short = rng:NextNumber(1.05, 1.3), rng:NextNumber(0.7, 0.85)
	local second = if variant % 2 == 1 then "Saguaro" else "Joshua"
	return {
		Pieces = {
			{ Kit = "Joshua", X = -3.5 + jitter(rng, 0.8), Z = 0.5 + jitter(rng, 0.8), Yaw = rng:NextNumber(0, 360), Opts = { Scale = tall } },
			{ Kit = second, X = 3.5 + jitter(rng, 0.8), Z = 2.5 + jitter(rng, 0.8), Yaw = rng:NextNumber(0, 360), Opts = { Scale = short } },
			{ Kit = "BarrelCactus", X = jitter(rng, 1), Z = -3, Yaw = rng:NextNumber(0, 360), Opts = { Scale = rng:NextNumber(0.8, 1.15) } },
		},
		Rocks = {},
		Natural = true,
		InWater = false,
	}
end

local function wreckRecipe(rng: Rng, which: string): Recipe
	local pieces: { Piece }
	-- WorldKits' wrecks lie along their local X (parallel to the road at yaw 0), the body behind the pivot (z >= 0)
	if which == "car" then
		pieces = {
			{ Kit = "Wreck", X = 0, Z = 0, Yaw = jitter(rng, 14), Opts = { Variant = "car" } },
			{ Kit = "DrumGroup", X = 6.8, Z = 1.2, Yaw = jitter(rng, 30), Opts = { Count = 2 } },
		}
	elseif which == "truck" then
		pieces = {
			{ Kit = "Wreck", X = 0, Z = 0, Yaw = 180 + jitter(rng, 14), Opts = { Variant = "truck" } },
			{ Kit = "DrumGroup", X = -9.4, Z = -2, Yaw = jitter(rng, 30), Opts = { Count = 1 } },
		}
	else
		pieces = { { Kit = "SandbagNest", X = 0, Z = 0, Yaw = jitter(rng, 10) } }
	end
	return { Pieces = pieces, Rocks = {}, Natural = false, InWater = false }
end

local function markerRecipe(variant: string): Recipe
	return { Pieces = { { Kit = "RoadMarker", X = 0, Z = 0, Yaw = 0, Opts = { Variant = variant } } }, Rocks = {}, Natural = false, InWater = false }
end

local function rockRecipe(style: string): Recipe
	return { Pieces = {}, Rocks = { { Style = style, X = 0, Z = 0 } }, Natural = true, InWater = false }
end

local function deadwoodRecipe(rng: Rng): Recipe
	-- DeadTree + Stump + FallenLog: 3 elements of 3 sizes, 3 parts
	return {
		Pieces = {
			{ Kit = "DeadTree", X = 0, Z = 0, Yaw = rng:NextNumber(0, 360), Opts = { Scale = rng:NextNumber(0.95, 1.25) } },
			{ Kit = "Stump", X = 4 + jitter(rng, 1), Z = 3 + jitter(rng, 1), Yaw = rng:NextNumber(0, 360), Opts = { Scale = rng:NextNumber(0.8, 1.1) } },
			{ Kit = "Log", X = -4 + jitter(rng, 1), Z = 2 + jitter(rng, 1), Yaw = rng:NextNumber(0, 360), Opts = { Scale = rng:NextNumber(0.8, 1.1) } },
		},
		Rocks = {},
		Natural = true,
		InWater = false,
	}
end

local function shoreRecipe(rng: Rng, kind: string): Recipe
	if kind == "revetment" then
		return { Pieces = { { Kit = "Revetment", X = 0, Z = 0, Yaw = jitter(rng, 4) } }, Rocks = {}, Natural = false, InWater = false }
	elseif kind == "jetty_stub" then
		return { Pieces = { { Kit = "JettyStub", X = 0, Z = 0, Yaw = 0 } }, Rocks = {}, Natural = false, InWater = true }
	elseif kind == "barge_wreck" then
		return { Pieces = { { Kit = "BargeWreck", X = 0, Z = 0, Yaw = jitter(rng, 20) } }, Rocks = {}, Natural = false, InWater = true }
	elseif kind == "beached_boat" then
		return { Pieces = { { Kit = "BeachedHull", X = 0, Z = 0, Yaw = jitter(rng, 25) } }, Rocks = {}, Natural = false, InWater = true }
	elseif kind == "dune_grass" then
		return { Pieces = { { Kit = "DuneGrass", X = 0, Z = 0, Yaw = rng:NextNumber(0, 360) } }, Rocks = {}, Natural = true, InWater = false }
	elseif kind == "driftwood_rocks" then
		return {
			Pieces = { { Kit = "Driftwood", X = -2, Z = 0, Yaw = rng:NextNumber(0, 360) } },
			Rocks = { { Style = "shore", X = 6, Z = 7 } },
			Natural = true,
			InWater = false,
		}
	end
	-- reeds_rocks
	return {
		Pieces = { { Kit = "Reeds", X = -2, Z = 0, Yaw = rng:NextNumber(0, 360) } },
		Rocks = { { Style = "shore", X = 6, Z = 7 } },
		Natural = true,
		InWater = false,
	}
end

-- ── Rhythm (spec §4.1) ─────────────────────────────────────────────────────────────────────────────────────────────

local function nearJunction(zones: Zones, x: number, z: number, clear: number): boolean
	for _, j in ipairs(zones.Junctions) do
		if (x - j.X) ^ 2 + (z - j.Z) ^ 2 < clear * clear then
			return true
		end
	end
	-- (0, 0), where RoadX0 meets RoadZ0, is the Town's crossing (inside its footprint + 30 anyway)
	return x * x + z * z < clear * clear
end

local function recipeFor(kind: string, rng: Rng, counters: { [string]: number }): Recipe
	if kind == "wreck_or_nest" then
		local list = RH.WreckRecipes
		return wreckRecipe(rng, list[counters.wreck % #list + 1])
	elseif kind == "flora_group" then
		return floraRecipe(rng, counters.flora)
	elseif kind == "sign_or_marker" then
		local list = RH.MarkerVariants
		return markerRecipe(list[counters.sign % #list + 1])
	end
	return rockRecipe("outcrop")
end

local function bumpCounters(kind: string, counters: { [string]: number })
	if kind == "wreck_or_nest" then
		counters.wreck += 1
	elseif kind == "flora_group" then
		counters.flora += 1
	elseif kind == "sign_or_marker" then
		counters.sign += 1
	end
end

-- one road-side spot: compose, push out of the road corridor if needed (never past Offset max), validate
local function buildRoadside(ctx: Ctx, road: Road, t: number, side: number, off: number, kind: string, name: string, rng: Rng, counters: { [string]: number }): Built
	local recipe = recipeFor(kind, rng, counters)
	local dirX, dirZ = if road.AlongX then 0 else -side, if road.AlongX then -side else 0 -- toward the road
	local function xz(o: number): (number, number)
		if road.AlongX then
			return t, road.Across + side * o
		end
		return road.Across + side * o, t
	end
	local ax, az = xz(0)
	local x, z = xz(off)
	local attrs: WorldKits.ClusterAttrs = {
		Source = "rhythm",
		Kind = kind,
		Anchor = "road:" .. road.Name,
		AnchorX = ax,
		AnchorZ = az,
		Natural = if recipe.Natural and #recipe.Pieces > 0 then true else nil,
		Elements = if recipe.Natural and #recipe.Pieces > 0 then #recipe.Pieces else nil,
	}
	local model, _, rocks = compose(name, attrs, frameAt(x, z, facingYaw(dirX, dirZ)), recipe)
	local offset = off
	if model then
		local parts = partsOf(model)
		centreOn(parts, x, z)
		if #parts == 0 then
			destroyModel(model)
			return { Ok = false, Reason = "noparts", Model = nil, X = x, Z = z, Parts = 0, Rocks = {} }
		end
		local need, why = roadCheck(ctx.Zones, parts, road, side)
		if why then
			destroyModel(model)
			return { Ok = false, Reason = why, Model = nil, X = x, Z = z, Parts = 0, Rocks = {} }
		end
		if need > 0 then
			local push = need + 0.25
			if offset + push > RH.Offset[2] then
				destroyModel(model)
				return { Ok = false, Reason = "partroad:push", Model = nil, X = x, Z = z, Parts = 0, Rocks = {} }
			end
			offset += push
			local nx, nz = xz(offset)
			translate(parts, Vector3.new(nx - x, 0, nz - z))
			x, z = nx, nz
		end
		local b = unionBox(parts) :: Box
		local zr = zoneBoxCheck(ctx.Zones, b, false)
		if zr then
			destroyModel(model)
			return { Ok = false, Reason = zr, Model = nil, X = x, Z = z, Parts = 0, Rocks = {} }
		end
		return { Ok = true, Reason = nil, Model = model, X = x, Z = z, Parts = #parts, Rocks = rocks }
	end
	-- terrain-only (rock_outcrop): the rock's reach clears the road corridor and every zone; push out if needed
	local row = rockRow(recipe.Rocks[1].Style)
	local minOff = RH.CollidableRoadGap + row.Outer + 0.25
	if offset < minOff then
		if minOff > RH.Offset[2] then
			return { Ok = false, Reason = "rockroad", Model = nil, X = x, Z = z, Parts = 0, Rocks = {} }
		end
		offset = minOff
		x, z = xz(offset)
	end
	local pos = Vector3.new(x, GROUND_Y, z)
	local why = rockBlocked(ctx, pos, recipe.Rocks[1].Style)
	if why then
		return { Ok = false, Reason = "rock" .. why, Model = nil, X = x, Z = z, Parts = 0, Rocks = {} }
	end
	return { Ok = true, Reason = nil, Model = nil, X = x, Z = z, Parts = 0, Rocks = { { Pos = pos, Style = recipe.Rocks[1].Style } } }
end

local function buildRhythm(ctx: Ctx, folder: Instance, sec: SectionSummary)
	local zones = ctx.Zones
	local rng = WorldKits.Rng(WorldDressConfig.Seed + RH.Salt)
	local kindIdx = 0
	local counters: { [string]: number } = { wreck = 0, flora = 0, sign = 0 }
	local reservedParts = 0 -- parts of every accepted cluster, kept or not (identical in Full and Low)
	local cap = BUD.Rhythm
	local ring = zones.Ring
	for _, road in ipairs(zones.Roads) do
		-- roads run full length while WaterConfig is off (Min / Max = ±huge): clamp to the ring
		local lo = math.max(road.Min, if road.AlongX then ring.X0 else ring.Z0)
		local hi = math.min(road.Max, if road.AlongX then ring.X1 else ring.Z1)
		local t = lo + RH.EndInset
		local side = 1
		local accepted = 0
		while t < hi - RH.EndInset do
			local off = rng:NextNumber(RH.Offset[1], RH.Offset[2])
			local seed = rng:NextInteger(1, 2147483646) -- per spot, so every cluster looks the same in Full and Low
			local x = if road.AlongX then t else road.Across + side * off
			local z = if road.AlongX then road.Across + side * off else t
			local reason: string? = nil
			if nearJunction(zones, x, z, RH.JunctionClear) then
				reason = "junction"
			else
				reason = WorldDress.Blocked(ctx.Occ, x, z, RH.Radius, { RoadClear = RH.Offset[1] - RH.Radius })
			end
			if reason == nil then
				local kind = RH.Kinds[kindIdx % #RH.Kinds + 1]
				local kParts = (RH.KindParts :: { [string]: number })[kind] or 0
				if reservedParts + kParts > cap then
					reason = "budget"
				else
					local crng = WorldKits.Rng(seed)
					local name = string.format("%s_%02d_%s", road.Name, accepted + 1, kind)
					local built = buildRoadside(ctx, road, t, side, off, kind, name, crng, counters)
					if built.Ok then
						-- the pushed centre still passes the disc rule
						local why = WorldDress.Blocked(ctx.Occ, built.X, built.Z, RH.Radius, { RoadClear = RH.Offset[1] - RH.Radius })
						if why then
							destroyModel(built.Model)
							reason = why
						else
							accepted += 1
							kindIdx += 1
							bumpCounters(kind, counters)
							reservedParts += built.Parts
							if #built.Rocks > 0 then
								ctx.PrimsReserved += rockRow(built.Rocks[1].Style).MaxPrims
							end
							local pattern = RH.LowPattern
							local keep = ctx.Full or pattern[(accepted - 1) % #pattern + 1] == true
							if keep then
								commit(ctx, folder, built, crng, RH.Radius, "rhythm:" .. kind, sec)
							else
								destroyModel(built.Model)
							end
							side = -side
						end
					else
						reason = built.Reason or "build"
					end
				end
			end
			if reason then
				reject(sec, reason)
			end
			t += rng:NextNumber(RH.Spacing[1], RH.Spacing[2])
		end
	end
end

-- ── Junctions (spec §4.2) ──────────────────────────────────────────────────────────────────────────────────────────

local CORNERS = { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }

local function buildJunctions(ctx: Ctx, folder: Instance, sec: SectionSummary)
	local rng = WorldKits.Rng(WorldDressConfig.Seed + JN.Salt)
	for _, j in ipairs(JN.Points) do
		local seed = rng:NextInteger(1, 2147483646)
		local placed = false
		local lastReason = "corner"
		for _, c in ipairs(CORNERS) do
			local sx, sz = c[1], c[2]
			local cx, cz = j.X + JN.Corner * sx, j.Z + JN.Corner * sz
			local why = WorldDress.Blocked(ctx.Occ, cx, cz, JN.Radius, { RoadClear = RH.Offset[1] - RH.Radius })
			if why == nil then
				local crng = WorldKits.Rng(seed)
				local faceJ = math.deg(facingYaw(-sx, -sz))
				local signText = if JN.SignText then "◄ ► " else nil
				-- world-aligned frame at the corner: the post faces the junction, the jersey pair lines both shoulders,
				-- the sandbag arc and a Terrain boulder group sit behind them
				local recipe: Recipe = {
					Pieces = {
						{ Kit = "DirSign", X = -5 * sx, Z = -5 * sz, Yaw = faceJ, Opts = { Text = signText } },
						{ Kit = "Jersey", X = 1 * sx, Z = -8.4 * sz, Yaw = math.deg(facingYaw(0, -sz)) },
						{ Kit = "Jersey", X = -8.4 * sx, Z = 1 * sz, Yaw = math.deg(facingYaw(-sx, 0)) },
						{ Kit = "SandbagArc", X = 1.5 * sx, Z = 1.5 * sz, Yaw = faceJ + jitter(crng, 8) },
					},
					Rocks = { { Style = "boulders", X = 9 * sx, Z = 9 * sz } },
					Natural = false,
					InWater = false,
				}
				local name = string.format("Junction_%d_%d", j.X, j.Z)
				local attrs: WorldKits.ClusterAttrs = {
					Source = "junction",
					Kind = "junction",
					Anchor = string.format("junction:%d,%d", j.X, j.Z),
					AnchorX = j.X,
					AnchorZ = j.Z,
				}
				local model, _, rocks = compose(name, attrs, CFrame.new(cx, GROUND_Y, cz), recipe)
				local parts = if model then partsOf(model) else {}
				local _, rw = roadCheck(ctx.Zones, parts, nil, 0)
				local b = unionBox(parts)
				local zr = if b then zoneBoxCheck(ctx.Zones, b, false) else "noparts"
				local rr: string? = nil
				for _, r in ipairs(rocks) do
					rr = rr or rockBlocked(ctx, r.Pos, r.Style)
				end
				if rw or zr or #parts == 0 then
					destroyModel(model)
					lastReason = rw or zr or "noparts"
				else
					if rr then
						rocks = {} -- the kit stands without its boulder group rather than put terrain in a keep-out
						warnOnce(ctx, string.format("Junction (%d, %d): boulders skipped (%s)", j.X, j.Z, rr))
					else
						ctx.PrimsReserved += rockRow("boulders").MaxPrims
					end
					local built: Built = { Ok = true, Reason = nil, Model = model, X = cx, Z = cz, Parts = #parts, Rocks = rocks }
					placed = commit(ctx, folder, built, crng, JN.Radius, "junction:junction", sec)
					if placed then
						break
					end
					lastReason = "finish"
				end
			else
				lastReason = why
			end
		end
		if not placed then
			reject(sec, lastReason)
			warnOnce(ctx, string.format("Junction (%d, %d): no free corner (%s)", j.X, j.Z, lastReason))
		end
	end
end

-- ── Shore (spec §4.3) ──────────────────────────────────────────────────────────────────────────────────────────────

type ShoreRun = { Side: string, AlongX: boolean, Across: number, From: number, To: number, Spacing: number, Dir: number, Edge: number, Kinds: { WorldDressConfig.KindRow }, Source: string }

-- penetration of a box past the water edge along the water direction (+ = into the water)
local function penetration(run: ShoreRun, b: Box): number
	if run.AlongX then
		return if run.Dir > 0 then b.Z1 - run.Edge else run.Edge - b.Z0
	end
	return if run.Dir > 0 then b.X1 - run.Edge else run.Edge - b.X0
end

local function buildShore(ctx: Ctx, folder: Instance, sec: SectionSummary)
	local rng = WorldKits.Rng(WorldDressConfig.Seed + SH.Salt)
	local runs: { ShoreRun } = {}
	for _, l in ipairs(SH.Lines) do
		local dir = if l.Across < 0 then -1 else 1
		table.insert(runs, {
			Side = l.Side,
			AlongX = l.AlongX,
			Across = l.Across,
			From = l.From,
			To = l.To,
			Spacing = SH.Spacing,
			Dir = dir,
			Edge = l.Across + dir * SH.Inset,
			Kinds = SH.Kinds,
			Source = "shore",
		})
	end
	local bay = SH.Bay
	table.insert(runs, { Side = "Bay", AlongX = true, Across = bay.Z, From = bay.From, To = bay.To, Spacing = bay.Spacing, Dir = 1, Edge = bay.EdgeZ, Kinds = bay.Kinds, Source = "bay" })

	local parts = 0
	local rot: { [string]: number } = { shore = 0, bay = 0 } -- kinds rotate over the accepted spots of all canal lines
	for _, run in ipairs(runs) do
		local nn = 0
		local t = run.From
		while t <= run.To + 1e-6 do
			local seed = rng:NextInteger(1, 2147483646)
			local x = if run.AlongX then t else run.Across
			local z = if run.AlongX then run.Across else t
			local reason: string? = nil
			for _, l in ipairs(SH.Landings) do
				if (x - l.X) ^ 2 + (z - l.Z) ^ 2 < SH.LandingClear * SH.LandingClear then
					reason = "landing"
				end
			end
			reason = reason or WorldDress.Blocked(ctx.Occ, x, z, SH.Radius)
			if reason == nil then
				local row = run.Kinds[rot[run.Source] % #run.Kinds + 1]
				if parts + row.Parts > SH.MaxParts then
					reason = "budget"
				else
					local crng = WorldKits.Rng(seed)
					local recipe = shoreRecipe(crng, row.Kind)
					local wx = if run.AlongX then x else run.Edge
					local wz = if run.AlongX then run.Edge else z
					local dx, dz = if run.AlongX then 0 else run.Dir, if run.AlongX then run.Dir else 0 -- toward the water
					local hasParts = #recipe.Pieces > 0
					local attrs: WorldKits.ClusterAttrs = {
						Source = run.Source,
						Kind = row.Kind,
						Anchor = "water:" .. run.Side,
						AnchorX = wx,
						AnchorZ = wz,
						Natural = if recipe.Natural then true else nil,
						Elements = if recipe.Natural then #recipe.Pieces + #recipe.Rocks else nil,
						InWater = if recipe.InWater then true else nil,
					}
					local name = string.format("Shore_%s_%02d_%s", run.Side, nn + 1, row.Kind)
					local model, _, rocks = compose(name, attrs, frameAt(x, z, facingYaw(dx, dz)), recipe)
					local ps = if model then partsOf(model) else {}
					if hasParts and #ps == 0 then
						reason = "noparts"
					elseif hasParts then
						local move = 0
						if recipe.InWater then
							-- step into the water: the far end reaches exactly InWaterMax past the edge
							local b0 = unionBox(ps) :: Box
							move = SH.InWaterMax - penetration(run, b0) - 0.25
						elseif (SH.ToWater :: { [string]: boolean })[row.Kind] then
							-- step to the water's edge: the nearest part stays LandEdgeGap from the water (H3: > 6)
							local b0 = unionBox(ps) :: Box
							move = -SH.LandEdgeGap - penetration(run, b0)
						end
						if move ~= 0 then
							translate(ps, Vector3.new(dx * move, 0, dz * move))
							for _, r in ipairs(rocks) do
								r.Pos += Vector3.new(dx * move, 0, dz * move)
							end
						end
						local b = unionBox(ps) :: Box
						local _, rw = roadCheck(ctx.Zones, ps, nil, 0)
						reason = rw or zoneBoxCheck(ctx.Zones, b, recipe.InWater)
						if reason == nil and recipe.InWater then
							-- the stepped kit (not just the bank disc) clears every non-water keep-out
							local cx, cz = (b.X0 + b.X1) * 0.5, (b.Z0 + b.Z1) * 0.5
							local r = math.sqrt((b.X1 - b.X0) ^ 2 + (b.Z1 - b.Z0) ^ 2) * 0.5
							local why = WorldDress.Blocked(ctx.Occ, cx, cz, r, { AllowWater = true, SkipRing = true, RoadClear = RH.CollidableRoadGap })
							reason = if why then "inwater:" .. why else nil
						end
					end
					if reason == nil then
						local rr: string? = nil
						for _, r in ipairs(rocks) do
							rr = rr or rockBlocked(ctx, r.Pos, r.Style, true)
						end
						if rr then
							rocks = {} -- the feature stands without its rocks rather than put terrain in a keep-out
							warnOnce(ctx, string.format("%s: rocks skipped (%s)", name, rr))
						else
							for _, r in ipairs(rocks) do
								ctx.PrimsReserved += rockRow(r.Style).MaxPrims
							end
						end
						if model and recipe.Natural then
							model:SetAttribute("WE_Elements", #recipe.Pieces + #rocks)
						end
						local built: Built = { Ok = true, Reason = nil, Model = model, X = x, Z = z, Parts = #ps, Rocks = rocks }
						if commit(ctx, folder, built, crng, SH.Radius, run.Source .. ":" .. row.Kind, sec) then
							parts += #ps
							rot[run.Source] += 1
							nn += 1
						else
							reason = "finish"
						end
					else
						destroyModel(model)
					end
				end
			end
			if reason then
				reject(sec, reason)
			end
			t += run.Spacing
		end
	end
end

-- ── Emptiness field (contracts §3.5, the metric of world_v2_model.py emptiness()) ─────────────────────────────────

local function fieldIdx(f: Field, i: number, j: number): number
	return (j - 1) * f.NX + i
end

-- lower the field to the distance from (px, pz) for every cell within r
local function stamp(f: Field, px: number, pz: number, r: number)
	local cell = f.Cell
	local jlo = math.max(1, math.ceil((pz - r - f.Z0) / cell) + 1)
	local jhi = math.min(f.NZ, math.floor((pz + r - f.Z0) / cell) + 1)
	local r2 = r * r
	local d2 = f.D2
	for j = jlo, jhi do
		local dz = f.Z0 + (j - 1) * cell - pz
		local rem = r2 - dz * dz
		if rem >= 0 then
			local w = math.sqrt(rem)
			local ilo = math.max(1, math.ceil((px - w - f.X0) / cell) + 1)
			local ihi = math.min(f.NX, math.floor((px + w - f.X0) / cell) + 1)
			local dz2 = dz * dz
			local base = (j - 1) * f.NX
			for i = ilo, ihi do
				local dx = f.X0 + (i - 1) * cell - px
				local dd = dx * dx + dz2
				local idx = base + i
				if dd < d2[idx] then
					d2[idx] = dd
				end
			end
		end
	end
end

-- lattice samples of a footprint; boundary samples reach the whole field, interior ones only 40 (the nearest sample to
-- any point more than 40 away is always on the boundary of the lattice set)
local function stampSamples(f: Field, xs: { number }, zs: { number }, inside: (number, number) -> boolean)
	local set: { [number]: boolean } = {}
	local nxs, nzs = #xs, #zs
	for a = 1, nxs do
		for b = 1, nzs do
			if inside(xs[a], zs[b]) then
				set[(a - 1) * nzs + b] = true
			end
		end
	end
	for a = 1, nxs do
		for b = 1, nzs do
			if set[(a - 1) * nzs + b] then
				local edge = a == 1 or a == nxs or b == 1 or b == nzs
					or not set[(a - 2) * nzs + b] or not set[a * nzs + b] or not set[(a - 1) * nzs + b - 1] or not set[(a - 1) * nzs + b + 1]
				stamp(f, xs[a], zs[b], if edge then f.Cap else 40.01)
			end
		end
	end
end

local function range(from: number, to: number, step: number): { number }
	local out: { number } = {}
	local v = from
	while v <= to do
		table.insert(out, v)
		v += step
	end
	return out
end

local function newField(zones: Zones, occ: Occupancy, cell: number): Field
	local land = SC.Land
	local cap = SC.FieldMax
	local nx = math.floor((land.X1 - land.X0 - cell * 0.5) / cell) + 1
	local nz = math.floor((land.Z1 - land.Z0 - cell * 0.5) / cell) + 1
	local f: Field = {
		Cell = cell,
		X0 = land.X0 + cell * 0.5,
		Z0 = land.Z0 + cell * 0.5,
		NX = nx,
		NZ = nz,
		D2 = table.create(nx * nz, cap * cap),
		Valid = table.create(nx * nz, true),
		Cap = cap,
	}
	local d2, valid = f.D2, f.Valid
	-- the ring edge
	for j = 1, nz do
		local z = f.Z0 + (j - 1) * cell
		for i = 1, nx do
			local x = f.X0 + (i - 1) * cell
			local e = math.min(x - land.X0, land.X1 - x, z - land.Z0, land.Z1 - z)
			local idx = fieldIdx(f, i, j)
			if e * e < d2[idx] then
				d2[idx] = e * e
			end
		end
	end
	-- plot pads are not land (and are sampled below)
	for _, p in ipairs(zones.PlotPads) do
		for j = 1, nz do
			local z = f.Z0 + (j - 1) * cell
			if z >= p.Z0 and z <= p.Z1 then
				for i = 1, nx do
					local x = f.X0 + (i - 1) * cell
					if x >= p.X0 and x <= p.X1 then
						valid[fieldIdx(f, i, j)] = false
					end
				end
			end
		end
	end
	-- water (+ bank 6): wet cells are not land; land cells measure to the bank line
	local margin = K.WaterMargin
	for _, w in ipairs(zones.Water) do
		local reach = cap + margin
		local jlo = math.max(1, math.ceil((w.Z0 - reach - f.Z0) / cell) + 1)
		local jhi = math.min(nz, math.floor((w.Z1 + reach - f.Z0) / cell) + 1)
		local ilo = math.max(1, math.ceil((w.X0 - reach - f.X0) / cell) + 1)
		local ihi = math.min(nx, math.floor((w.X1 + reach - f.X0) / cell) + 1)
		for j = jlo, jhi do
			local z = f.Z0 + (j - 1) * cell
			local dz = math.max(w.Z0 - z, 0, z - w.Z1)
			for i = ilo, ihi do
				local x = f.X0 + (i - 1) * cell
				local dx = math.max(w.X0 - x, 0, x - w.X1)
				local d = math.sqrt(dx * dx + dz * dz)
				local idx = fieldIdx(f, i, j)
				if d <= margin then
					valid[idx] = false
					d2[idx] = 0
				else
					local dd = (d - margin) * (d - margin)
					if dd < d2[idx] then
						d2[idx] = dd
					end
				end
			end
		end
	end
	-- every POI footprint (reserved, built or not), sampled every 40
	for _, p in ipairs(zones.POIs) do
		local rect = p.Rect
		local circ = p.Circle
		if rect then
			stampSamples(f, range(rect.X0 + 20, rect.X1, 40), range(rect.Z0 + 20, rect.Z1, 40), function(_x: number, _z: number): boolean
				return true
			end)
		elseif circ then
			stampSamples(f, range(circ.X - circ.R, circ.X + circ.R, 40), range(circ.Z - circ.R, circ.Z + circ.R, 40), function(x: number, z: number): boolean
				return (x - circ.X) ^ 2 + (z - circ.Z) ^ 2 <= circ.R * circ.R
			end)
		end
	end
	-- the plot pads, sampled every 40
	for _, p in ipairs(zones.PlotPads) do
		stampSamples(f, range(p.X0, p.X1 + 0.1, 40), range(p.Z0, p.Z1 + 0.1, 40), function(_x: number, _z: number): boolean
			return true
		end)
	end
	-- the land garage pads and every placed cluster (POI clusters and the travel dressing so far, terrain-only included)
	for _, p in ipairs(zones.Pads) do
		stamp(f, (p.X0 + p.X1) * 0.5, (p.Z0 + p.Z1) * 0.5, cap)
	end
	for _, d in ipairs(occ.Discs) do
		stamp(f, d.X, d.Z, cap)
	end
	return f
end

-- share of land cells more than 100 from anything; the largest empty circle (diameter) and its centre
local function fieldStats(f: Field): (number, number, number, number)
	local valid, far, best, bi = 0, 0, -1, 0
	local lim = 100 * 100
	for idx = 1, f.NX * f.NZ do
		if f.Valid[idx] then
			valid += 1
			local dd = f.D2[idx]
			if dd > lim then
				far += 1
			end
			if dd > best then
				best, bi = dd, idx
			end
		end
	end
	local i = (bi - 1) % f.NX + 1
	local j = (bi - i) // f.NX + 1
	return far / math.max(1, valid), 2 * math.sqrt(math.max(0, best)), f.X0 + (i - 1) * f.Cell, f.Z0 + (j - 1) * f.Cell
end

local function cellXZ(f: Field, idx: number): (number, number)
	local i = (idx - 1) % f.NX + 1
	local j = (idx - i) // f.NX + 1
	return f.X0 + (i - 1) * f.Cell, f.Z0 + (j - 1) * f.Cell
end

export type Emptiness = { Far100: number, Largest: number, X: number, Z: number, Cell: number }

-- The emptiness metric over the occupancy (contracts §3.5): dry land inside the ring, "anything" = every disc in occ,
-- the garage pads, every POI footprint and plot pad (sampled every 40), the ring edge and the water (+ 6).
function WorldDress.Emptiness(occ: Occupancy, cell: number?): Emptiness
	local f = newField(occ.Zones, occ, cell or SC.Grid)
	local far, largest, x, z = fieldStats(f)
	return { Far100 = far, Largest = largest, X = x, Z = z, Cell = f.Cell }
end

-- ── Scatter (spec §4.4) ────────────────────────────────────────────────────────────────────────────────────────────

local function scatterRecipe(kind: string, rng: Rng, counter: number): Recipe
	if kind == "flora_group" then
		return floraRecipe(rng, counter)
	elseif kind == "dead_tree_stumps" then
		return deadwoodRecipe(rng)
	elseif kind == "boulder_field" then
		return rockRecipe("boulder_field")
	end
	return rockRecipe("outcrop")
end

local function buildScatter(ctx: Ctx, folder: Instance, sec: SectionSummary): Field
	local rng = WorldKits.Rng(WorldDressConfig.Seed + SC.Salt)
	local f = newField(ctx.Zones, ctx.Occ, SC.Grid)
	local rmin = math.max(SC.EmptyRadius, SC.TargetLargestEmpty * 0.5)
	local rmin2 = rmin * rmin
	local failed: { [number]: boolean } = {}
	local placed, parts, kindIdx, flora = 0, 0, 0, 0
	local n = f.NX * f.NZ

	local function spacingOk(x: number, z: number): boolean
		local s2 = SC.MinSpacing * SC.MinSpacing
		for _, d in ipairs(ctx.Occ.Discs) do
			if (x - d.X) ^ 2 + (z - d.Z) ^ 2 < s2 then
				return false
			end
		end
		return true
	end

	-- one spot: the kind in rotation (a Part kind over the cap becomes a boulder field), built and validated
	local function tryAt(x: number, z: number): (boolean, string?)
		local why = WorldDress.Blocked(ctx.Occ, x, z, SC.Radius, { RoadClear = SC.RoadClear - SC.Radius })
		if why then
			return false, why
		end
		if not spacingOk(x, z) then
			return false, "spacing"
		end
		local row = SC.Kinds[kindIdx % #SC.Kinds + 1]
		local kind = row.Kind
		if parts + row.Parts > SC.MaxParts then
			kind = "boulder_field"
		end
		local seed = rng:NextInteger(1, 2147483646)
		local crng = WorldKits.Rng(seed)
		local recipe = scatterRecipe(kind, crng, flora)
		local elements = #recipe.Pieces
		local attrs: WorldKits.ClusterAttrs = {
			Source = "scatter",
			Kind = kind,
			Anchor = "natural",
			AnchorX = x,
			AnchorZ = z,
			Natural = true,
			Elements = elements,
		}
		local model, _, rocks = compose(string.format("Scatter_%02d_%s", placed + 1, kind), attrs, frameAt(x, z, crng:NextNumber(0, math.pi * 2)), recipe)
		local ps = if model then partsOf(model) else {}
		if model then
			centreOn(ps, x, z)
			if #ps < SC.MinElements then
				destroyModel(model)
				return false, "noparts"
			end
			local _, rw = roadCheck(ctx.Zones, ps, nil, 0)
			local zr = rw or zoneBoxCheck(ctx.Zones, unionBox(ps) :: Box, false)
			if zr then
				destroyModel(model)
				return false, zr
			end
		end
		for _, r in ipairs(rocks) do
			local rr = rockBlocked(ctx, r.Pos, r.Style)
			if rr then
				destroyModel(model)
				return false, "rock" .. rr
			end
		end
		for _, r in ipairs(rocks) do
			ctx.PrimsReserved += rockRow(r.Style).MaxPrims
		end
		local built: Built = { Ok = true, Reason = nil, Model = model, X = x, Z = z, Parts = #ps, Rocks = rocks }
		if not commit(ctx, folder, built, crng, SC.Radius, "scatter:" .. kind, sec) then
			return false, "finish"
		end
		placed += 1
		parts += #ps
		kindIdx += 1
		if kind == "flora_group" then
			flora += 1
		end
		stamp(f, x, z, f.Cap)
		return true, nil
	end

	for _ = 1, SC.MaxIterations do
		if placed >= SC.MaxClusters then
			break
		end
		local alive: { number } = {}
		for idx = 1, n do
			if f.Valid[idx] and not failed[idx] and f.D2[idx] > rmin2 then
				table.insert(alive, idx)
			end
		end
		if #alive == 0 then
			break
		end
		-- the largest empty circles, greedy, each at least Suppress x r from the ones before it
		local circles: { EmptyCircle } = {}
		while #circles < SC.CirclesPerRound and #alive > 0 do
			local best, bk = -1, 0
			for k, idx in ipairs(alive) do
				if f.D2[idx] > best then
					best, bk = f.D2[idx], k
				end
			end
			local idx = alive[bk]
			local cx, cz = cellXZ(f, idx)
			local r = math.sqrt(best)
			table.insert(circles, { X = cx, Z = cz, R = r, Idx = idx })
			local sup2 = (SC.Suppress * r) ^ 2
			local keep: { number } = {}
			for _, other in ipairs(alive) do
				local ox, oz = cellXZ(f, other)
				if (ox - cx) ^ 2 + (oz - cz) ^ 2 >= sup2 then
					table.insert(keep, other)
				end
			end
			alive = keep
		end
		for _, c in ipairs(circles) do
			if placed >= SC.MaxClusters then
				break
			end
			if f.D2[c.Idx] > rmin2 then -- still empty after this round's earlier placements
				local ok = false
				local lastWhy: string? = nil
				for try = 0, SC.Tries - 1 do
					local x, z = c.X, c.Z
					if try > 0 then
						local scale = 1 + try / 10
						x = c.X + rng:NextNumber(-SC.Jitter, SC.Jitter) * scale
						z = c.Z + rng:NextNumber(-SC.Jitter, SC.Jitter) * scale
					end
					local good, why = tryAt(x, z)
					if good then
						ok = true
						break
					end
					lastWhy = why
				end
				if not ok then
					reject(sec, lastWhy or "circle")
					-- this circle cannot be filled: its middle leaves the candidate list (still counted in the metric)
					local fr2 = (SC.FailClear * c.R) ^ 2
					for idx = 1, n do
						if f.D2[idx] > rmin2 then
							local x, z = cellXZ(f, idx)
							if (x - c.X) ^ 2 + (z - c.Z) ^ 2 <= fr2 then
								failed[idx] = true
							end
						end
					end
				end
			end
		end
	end
	return f
end

-- ── Build ─────────────────────────────────────────────────────────────────────────────────────────────────────────

local function freshFolder(parent: Instance, name: string): Folder
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function WorldDress.Build(dressing: Instance, quality: string, occ: Occupancy?): Summary
	local q = WorldDress.Quality(quality)
	local o = occ or WorldDress.NewOccupancy()
	local ctx: Ctx = {
		Quality = q,
		Full = q == "Full",
		Occ = o,
		Zones = o.Zones,
		Warnings = {},
		Prims = 0,
		PrimsReserved = 0,
		Busy = 0,
		SegStart = os.clock(),
		SinceYield = 0,
	}
	local sections: { SectionSummary } = {
		{ Name = "Rhythm", Clusters = 0, Parts = 0, PartsCap = BUD.Rhythm, TerrainPrims = 0, Rejected = {} },
		{ Name = "Junctions", Clusters = 0, Parts = 0, PartsCap = BUD.Junctions, TerrainPrims = 0, Rejected = {} },
		{ Name = "Shore", Clusters = 0, Parts = 0, PartsCap = BUD.Shore, TerrainPrims = 0, Rejected = {} },
		{ Name = "Scatter", Clusters = 0, Parts = 0, PartsCap = BUD.Scatter, TerrainPrims = 0, Rejected = {} },
	}
	local enabled = WorldDressConfig.Enabled ~= false
	local builders: { [string]: (Ctx, Instance, SectionSummary) -> () } = {
		Rhythm = buildRhythm,
		Junctions = buildJunctions,
		Shore = buildShore,
	}
	local cfgOn: { [string]: boolean } = {
		Rhythm = enabled and RH.Enabled ~= false,
		Junctions = enabled and JN.Enabled ~= false,
		Shore = enabled and SH.Enabled ~= false and (ctx.Full or (WorldDressConfig.Quality.Low.ShoreEvery or 1) > 0),
		Scatter = enabled and SC.Enabled ~= false and (ctx.Full or WorldDressConfig.Quality.Low.Scatter == true),
	}
	local largest, far100 = 0, 0
	for _, sec in ipairs(sections) do
		local folder = freshFolder(dressing, (FOLDERS :: any)[sec.Name] or sec.Name)
		if cfgOn[sec.Name] then
			local ok, err = pcall(function()
				if sec.Name == "Scatter" then
					local f = buildScatter(ctx, folder, sec)
					local far, lg = fieldStats(f)
					far100, largest = far, lg
				else
					builders[sec.Name](ctx, folder, sec)
				end
			end)
			if not ok then
				warnOnce(ctx, sec.Name .. " failed: " .. tostring(err))
			end
		end
		if sec.Parts > sec.PartsCap then
			warnOnce(ctx, string.format("%s: %d parts > cap %d", sec.Name, sec.Parts, sec.PartsCap))
		end
	end
	ctx.Busy += os.clock() - ctx.SegStart
	local total, clusters, prims = 0, 0, 0
	for _, sec in ipairs(sections) do
		total += sec.Parts
		clusters += sec.Clusters
		prims += sec.TerrainPrims
	end
	local sum: Summary = {
		Quality = q,
		Sections = sections,
		Parts = total,
		Clusters = clusters,
		TerrainPrims = prims,
		LargestEmpty = largest,
		Far100 = far100,
		Seconds = ctx.Busy,
		Warnings = ctx.Warnings,
	}
	local s1, s2, s3, s4 = sections[1], sections[2], sections[3], sections[4]
	print(
		string.format(
			"[WAR EMPIRE] WorldDress: %s rhythm %d (%d) junctions %d (%d) shore %d (%d) scatter %d (%d); terrain %d prims; largest empty %.0f; %.2f s",
			q,
			s1.Clusters,
			s1.Parts,
			s2.Clusters,
			s2.Parts,
			s3.Clusters,
			s3.Parts,
			s4.Clusters,
			s4.Parts,
			prims,
			largest,
			ctx.Busy
		)
	)
	if #ctx.Warnings > 0 then
		warn(string.format("[WorldDress] %d warnings; first: %s", #ctx.Warnings, ctx.Warnings[1]))
	end
	return sum
end

return WorldDress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">WorldHygiene</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 1 — WorldHygiene: rules H1–H10 for the world outside the bases (gap/world_v2_spec.md §5,
	roadmap §1.3 / §1.5 #3). The fix for "dead, out of place props". Thresholds: WorldConfig.Hygiene / WorldConfig.Lights.

	  H1  Anchored: every man-made dressing unit lies <= 60 studs from an anchor (POI footprint, road centre line,
	      water edge, plot edge, capture zone); natural units may stand alone only as groups of >= 3 (NaturalLink),
	      or as ONE natural cluster whose instance carries WE_Elements >= MinNatural (Hygiene.ElementsAttr; W3
	      scatter: e.g. a dead tree, a stump and a log) with parts of >= 2 sizes (max dimensions >= 20 % apart).
	      W1 ran it in Report mode; W3 (roadmap §1.5 #3) sets Hygiene.OrphanMode = "Enforce": orphans are destroyed.
	  H2  Road corridor: nothing collidable with its top above 0.75 within 12 of a road centre line; nothing visible
	      taller than 0.3 within 8 (markings, RoadEnds, CheckpointArm and WE_AllowOnRoad exempt).  → destroy kit
	  H3  Clear zones: capture zones (R x 1.414 + 25), front-gate aprons, land garage pads + 16, plot pads + 4,
	      water + 6 (WE_AllowInWater exempt), rig pier corridors, and the Terrain belt / beyond (hidden in rock).
	                                                                                                 → destroy kit
	  H4  Cover is solid: visible man-made cover (crates, drums, sandbags, walls, wrecks, …) whose top is >= 1.5 above
	      the floor collides (CanCollide + CanQuery). MeshParts collide through their host part.            → set
	  H5  No Neon (→ SmoothPlastic), no Beam, no world-code BillboardGui (service labels under
	      Hygiene.BillboardAllowAncestors are F's).                                                  → set / destroy
	  H6  No static Humanoid outside the bases.                                                  → destroy model
	  H7  No part over 2,040 studs on any axis.                                                    → check only
	  H8  <= 24 lights outside the bases; Brightness <= 0.8, Range <= 18, Shadows off, tag WE_NightLight.
	                                                                                  → clamp, tag, drop extras
	  H9  CastShadow only on parts >= 8 studs; <= 300 casters outside the bases. W3 step 2: a flat dressing marking
	      (no collision, top <= 0.75: a HoldPad disc, a Runway strip, paving) never casts a shadow.        → set
	  H10 Streaming structure: no dressing Model wider than 64 studs (W3 step 2: a POI's Infra Model — the runway
	      strips, attribute WE_Infra — is exempt; it is flat and never streams as one piece).        → check only

	W3 step 2 (spec w3s2 §1.2, §6 lane P): a part carrying WE_RuntimeDoor = true (WorldConfig.Activity.RuntimeDoorAttr:
	BankGate, HeistGate, BunkerDoor — the jobs raise and lower it at runtime) is left alone: never an H2 / H3 hit, never
	made solid by H4, never reported as H2 / H4. Its whole kit still goes when another part of that kit breaks a rule.
	Flat markings (HoldPad, Runway, PaveTile) are never H2 / H4 by construction: Rules.FlatMarking names the test.

	Enforce acts ONLY inside the dressing folders (Hygiene.DressingFolders: WorldDressing, DesertFlora, and W3's
	WorldPOI / WorldKits). Everything else outside the bases (Map, Territories, spawns, MapSetup blocks) is reported,
	never touched: those are the hook step's deletions.

	PUBLIC API (server only; not hooked yet — the post-F hook step calls Enforce at the end of MapDressing.Dress and
	DesertFlora.Dress, after Waterways.CullDressing, and may log Report(root) at the end of MapSetup.Run):
	  WorldHygiene.Report(root: Instance, opts?: Opts) -> Report
	      Read-only census + every violation of H1–H10 under root (WarEmpireSetup, or one dressing folder), bases
	      excluded. Report.Orphans lists the H1 units for W3.
	  WorldHygiene.Enforce(root: Instance, opts?: Opts) -> Report
	      Applies H2–H6, H8, H9 (and H1 when OrphanMode = "Enforce") inside the dressing folders under / at root,
	      then returns Report(root) with Report.Actions = what it changed. Idempotent: a second call changes nothing
	      (all Actions 0).
	  WorldHygiene.Check(root: Instance, opts?: Opts) -> { Violation }   (= Report(root).Violations; spec name)
	  WorldHygiene.Rules                                                  (the per-instance predicates, pure)
	Opts = { WorldRoot: Instance? (for the world light count; default: root's parent when root is a dressing folder),
	         Pads: { BasePart }? (land garage pads; default: parts tagged WE_VehicleSpawn but not WE_NavalSpawn),
	         OrphanMode: string?, Log: boolean? (one summary line; default true for Enforce) }
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- server module: the configs and siblings ship in the same place file (no WaitForChild, never an unbounded wait)
local Configs = ReplicatedStorage.Shared.Configs
local WorldConfig = require(Configs.WorldConfig)
local WaterConfig = require(Configs.WaterConfig)
local TerritoryConfig = require(Configs.TerritoryConfig)
local BaseConfig = require(Configs.BaseConfig)
local BaseLayout = require(script.Parent.BaseLayout)
local Waterways = require(script.Parent.Waterways)
local WorldAtmosphere = require(script.Parent.WorldAtmosphere)

export type Violation = { Rule: string, Path: string, Detail: string, X: number, Z: number }
export type Orphan = { Path: string, Kind: string, X: number, Z: number, Parts: number, Nearest: number }
export type Report = {
	Mode: string,
	Root: string,
	Parts: number, -- BaseParts under root outside the bases
	DressingParts: number,
	Counts: { [string]: number }, -- violations per rule
	Actions: { [string]: number }, -- Enforce: parts destroyed (H1/H2/H3/H6) or properties set (H4/H5/H8/H9)
	Violations: { Violation },
	Orphans: { Orphan },
	Census: { [string]: number },
	Legacy: { [string]: number }, -- parts in the MapSetup blocks the hook deletes
	ByTop: { [string]: number }, -- parts per child of root
}
export type Opts = { WorldRoot: Instance?, Pads: { BasePart }?, OrphanMode: string?, Log: boolean? }

type Box = { X0: number, X1: number, Y0: number, Y1: number, Z0: number, Z1: number }
type Rect = { Name: string?, X0: number, X1: number, Z0: number, Z1: number }
type Road = { Name: string, AlongX: boolean, Across: number, Min: number, Max: number }
type Circle = { Name: string, X: number, Z: number, R: number }
type Ctx = {
	Roads: { Road },
	Water: { Rect },
	PlotPads: { Rect },
	Captures: { Circle },
	Territories: { Circle },
	Aprons: { Rect },
	Pads: { Rect },
	ClearRects: { Rect },
	POIs: { WorldConfig.POI },
}

local WorldHygiene = {}

local H = WorldConfig.Hygiene
local GROUND_TOP_Y = 0.5
local RULES = { "H1", "H2", "H3", "H4", "H5", "H6", "H7", "H8", "H9", "H10" }
-- W3: the attribute a stand-alone natural cluster carries (WorldKits.NewCluster); read loosely so this module
-- type-checks before and after WorldConfig.Hygiene gains the key
local ELEMENTS_ATTR: string = (H :: any).ElementsAttr or "WE_Elements"
-- W3: H1 units per WE_Anchor class (informational, Report.Census "Anchor_<class>")
local ANCHOR_CLASSES = { "poi", "road", "junction", "water", "natural", "none" }
-- W3 step 2: a POI's Infra Model (WorldPOI; exempt from H10) and the runtime doors (left alone). Read loosely so the
-- module type-checks whether or not WorldConfig names them
local INFRA_ATTR: string = (H :: any).InfraAttr or "WE_Infra"
local RUNTIME_DOOR_ATTR: string = ((WorldConfig :: any).Activity and (WorldConfig :: any).Activity.RuntimeDoorAttr) or "WE_RuntimeDoor"

-- ── small helpers ────────────────────────────────────────────────────────────

local function toSet(list: { string }): { [string]: boolean }
	local s: { [string]: boolean } = {}
	for _, v in ipairs(list) do
		s[v] = true
	end
	return s
end

local DRESSING = toSet(H.DressingFolders)
local BASES = toSet(H.BaseFolders)
local V2 = toSet(H.WorldV2Folders)
local LEGACY = toSet(H.LegacyFolders)
local NATURAL_FOLDERS = toSet(H.NaturalFolders)
local ROAD_EXEMPT_ANC = toSet(H.RoadExemptAncestors)
local ROAD_EXEMPT_NAMES = toSet(H.RoadExemptNames)
local BB_ALLOW = toSet(H.BillboardAllowAncestors)
local CAPTURE_SKIP = toSet(H.CaptureSkip)

local function hasPrefix(name: string, list: { string }): boolean
	for _, p in ipairs(list) do
		if string.sub(name, 1, #p) == p then
			return true
		end
	end
	return false
end

local function hasKeyword(name: string, list: { string }): boolean
	for _, k in ipairs(list) do
		if string.find(name, k, 1, true) then
			return true
		end
	end
	return false
end

local function worldBox(p: BasePart): Box
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = p.CFrame:GetComponents()
	local s = p.Size
	local hx = (math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z) * 0.5
	local hy = (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) * 0.5
	local hz = (math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z) * 0.5
	return { X0 = x - hx, X1 = x + hx, Y0 = y - hy, Y1 = y + hy, Z0 = z - hz, Z1 = z + hz }
end

local function overlapsRect(b: Box, r: Rect, grow: number): boolean
	return b.X1 > r.X0 - grow and b.X0 < r.X1 + grow and b.Z1 > r.Z0 - grow and b.Z0 < r.Z1 + grow
end

-- XZ distance from a box to a point (0 inside)
local function boxDist(b: Box, x: number, z: number): number
	local dx = math.max(b.X0 - x, 0, x - b.X1)
	local dz = math.max(b.Z0 - z, 0, z - b.Z1)
	return math.sqrt(dx * dx + dz * dz)
end

-- XZ distance from a point to a rect (0 inside)
local function rectDist(r: Rect, x: number, z: number): number
	local dx = math.max(r.X0 - x, 0, x - r.X1)
	local dz = math.max(r.Z0 - z, 0, z - r.Z1)
	return math.sqrt(dx * dx + dz * dz)
end

local function attrUp(inst: Instance, attr: string, stop: Instance?): boolean
	local cur: Instance? = inst
	while cur and cur ~= stop do
		if cur:GetAttribute(attr) == true then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function underNames(inst: Instance, names: { [string]: boolean }, stop: Instance?): boolean
	local cur = inst.Parent
	while cur and cur ~= stop do
		if names[cur.Name] then
			return true
		end
		cur = cur.Parent
	end
	return false
end

-- ── context (zones and anchors), rebuilt per call ─────────────────────────────

local function roadLines(): { Road }
	local out: { Road } = {}
	for name, ends in pairs(WaterConfig.RoadEnds) do
		local axis, num = string.match(name, "^Road([XZ])(%-?[%d%.]+)$")
		local across = if num then tonumber(num) else nil
		if axis and across then
			table.insert(out, {
				Name = name,
				AlongX = axis == "Z",
				Across = across,
				Min = if WaterConfig.Enabled then ends.Min else -math.huge,
				Max = if WaterConfig.Enabled then ends.Max else math.huge,
			})
		end
	end
	table.sort(out, function(a: Road, b: Road): boolean
		return a.Name < b.Name
	end)
	return out
end

local function landPads(opts: Opts?): { Rect }
	local out: { Rect } = {}
	local list: { BasePart } = {}
	if opts and opts.Pads then
		list = opts.Pads
	else
		for _, inst in ipairs(CollectionService:GetTagged("WE_VehicleSpawn")) do
			if inst:IsA("BasePart") and not CollectionService:HasTag(inst, "WE_NavalSpawn") then
				table.insert(list, inst)
			end
		end
	end
	for _, p in ipairs(list) do
		local b = worldBox(p)
		table.insert(out, { Name = p.Name, X0 = b.X0 - H.PadClear, X1 = b.X1 + H.PadClear, Z0 = b.Z0 - H.PadClear, Z1 = b.Z1 + H.PadClear })
	end
	return out
end

local function buildContext(opts: Opts?): Ctx
	local ctx: Ctx = {
		Roads = roadLines(),
		Water = {},
		PlotPads = {},
		Captures = {},
		Territories = {},
		Aprons = {},
		Pads = landPads(opts),
		ClearRects = H.ClearRects,
		POIs = WorldConfig.POIs,
	}
	for _, r in ipairs(Waterways.AllRects()) do
		table.insert(ctx.Water, { Name = r.Name, X0 = r.X0, X1 = r.X1, Z0 = r.Z0, Z1 = r.Z1 })
	end
	local half = (BaseConfig.PlotSize :: Vector3).X * 0.5
	for plotId, pos in ipairs(BaseConfig.PlotPositions :: { Vector3 }) do
		table.insert(ctx.PlotPads, { Name = "Plot" .. plotId, X0 = pos.X - half, X1 = pos.X + half, Z0 = pos.Z - half, Z1 = pos.Z + half })
		local a = H.GateApron
		local xs, zs = {}, {}
		for _, c in ipairs({ { a.X0, a.Z0 }, { a.X1, a.Z0 }, { a.X0, a.Z1 }, { a.X1, a.Z1 } }) do
			local w = BaseLayout.PlotPoint(pos, c[1], c[2])
			table.insert(xs, w.X)
			table.insert(zs, w.Z)
		end
		table.insert(ctx.Aprons, {
			Name = "Apron_P" .. plotId,
			X0 = math.min(table.unpack(xs)),
			X1 = math.max(table.unpack(xs)),
			Z0 = math.min(table.unpack(zs)),
			Z1 = math.max(table.unpack(zs)),
		})
	end
	for id, t in pairs(TerritoryConfig.Territories :: { [string]: any }) do
		local pos: Vector3 = t.Position
		local r: number = t.Radius
		table.insert(ctx.Territories, { Name = id, X = pos.X, Z = pos.Z, R = r })
		if not CAPTURE_SKIP[id] then
			table.insert(ctx.Captures, { Name = id, X = pos.X, Z = pos.Z, R = r * H.CaptureClearScale + H.CaptureClearExtra })
		end
	end
	table.sort(ctx.Captures, function(a: Circle, b: Circle): boolean
		return a.Name < b.Name
	end)
	return ctx
end

-- smallest across-gap from the box to the centre line of a road whose extent it overlaps (math.huge: none)
local function roadGap(ctx: Ctx, b: Box): number
	local best = math.huge
	for _, r in ipairs(ctx.Roads) do
		local a0, a1, c0, c1 = b.X0, b.X1, b.Z0, b.Z1
		if not r.AlongX then
			a0, a1, c0, c1 = b.Z0, b.Z1, b.X0, b.X1
		end
		if a1 >= r.Min and a0 <= r.Max then
			local gap = math.max(0, c0 - r.Across, r.Across - c1)
			if gap < best then
				best = gap
			end
		end
	end
	return best
end

-- XZ distance from a point to the nearest road centre segment
local function roadDist(ctx: Ctx, x: number, z: number): number
	local best = math.huge
	for _, r in ipairs(ctx.Roads) do
		local along, across = if r.AlongX then x else z, if r.AlongX then z else x
		local t = math.clamp(along, r.Min, r.Max)
		local d = math.sqrt((along - t) ^ 2 + (across - r.Across) ^ 2)
		if d < best then
			best = d
		end
	end
	return best
end

local function beyondBelt(b: Box): boolean
	local e = WorldConfig.Terrain.Edge
	return b.X0 >= e.Inner or b.X1 <= -e.Inner or b.Z1 <= -e.Inner or b.Z0 >= e.FarShoreZ
end

-- ── rules (pure predicates) ───────────────────────────────────────────────────

local Rules = {}

function Rules.IsNatural(part: Instance, stop: Instance?): boolean
	if hasPrefix(part.Name, H.NaturalPrefixes) then
		return true
	end
	local cur = part.Parent
	while cur and cur ~= stop do
		if NATURAL_FOLDERS[cur.Name] or hasPrefix(cur.Name, H.NaturalPrefixes) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function isMarking(name: string): boolean
	return hasPrefix(name, H.RoadMarkingPrefixes)
end

function Rules.RoadExempt(part: Instance, stop: Instance?): boolean
	return ROAD_EXEMPT_NAMES[part.Name] == true or attrUp(part, "WE_AllowOnRoad", stop) or underNames(part, ROAD_EXEMPT_ANC, stop)
end

-- W3 step 2: a gate / door part the jobs move at runtime (WE_RuntimeDoor): the rules leave it alone
function Rules.RuntimeDoor(part: Instance): boolean
	return part:GetAttribute(RUNTIME_DOOR_ATTR) == true
end

-- W3 step 2: a flat marking lying on the floor (HoldPad disc, Runway strip, paving): no collision, top <= RoadMinTop
function Rules.FlatMarking(part: BasePart, b: Box): boolean
	return not part.CanCollide and b.Y1 <= H.RoadMinTop
end

-- H2: nil or the reason
function Rules.H2(ctx: Ctx, part: BasePart, b: Box): string?
	if b.Y1 <= H.RoadMinTop or Rules.RuntimeDoor(part) then
		return nil
	end
	local gap = roadGap(ctx, b)
	if gap <= H.RoadCorridor and part.CanCollide then
		return string.format("collidable %.1f from a road line, top %.1f", gap, b.Y1)
	end
	if gap <= H.RoadLane and b.Y1 > GROUND_TOP_Y + H.RoadLaneMaxHeight and part.Transparency < 0.99 and not isMarking(part.Name) then
		return string.format("visible in the lane (%.1f), top %.1f", gap, b.Y1)
	end
	return nil
end

-- H3: nil or the zone name. Water hits honour WE_AllowInWater (checked by the caller).
function Rules.H3(ctx: Ctx, b: Box): (string?, boolean)
	if beyondBelt(b) then
		return "belt", false
	end
	for _, c in ipairs(ctx.Captures) do
		if boxDist(b, c.X, c.Z) < c.R then
			return "capture:" .. c.Name, false
		end
	end
	for _, r in ipairs(ctx.Aprons) do
		if overlapsRect(b, r, 0) then
			return r.Name or "apron", false
		end
	end
	for _, r in ipairs(ctx.Pads) do
		if overlapsRect(b, r, 0) then
			return "pad:" .. (r.Name or "?"), false
		end
	end
	for _, r in ipairs(ctx.PlotPads) do
		if overlapsRect(b, r, H.PlotPadClear) then
			return r.Name or "plot", false
		end
	end
	for _, r in ipairs(ctx.ClearRects) do
		if overlapsRect(b, r, 0) then
			return r.Name or "clear", false
		end
	end
	for _, r in ipairs(ctx.Water) do
		if overlapsRect(b, r, H.WaterClear) then
			return "water:" .. (r.Name or "?"), true
		end
	end
	return nil, false
end

-- H4: a visible man-made cover part that should collide (a runtime door decides its own collision)
function Rules.H4Candidate(part: BasePart, b: Box, stop: Instance?): boolean
	if part:IsA("MeshPart") or part.Transparency >= 0.9 or Rules.RuntimeDoor(part) or Rules.FlatMarking(part, b) then
		return false
	end
	if b.Y1 - GROUND_TOP_Y < H.SolidMinHeight then
		return false
	end
	local name = part.Name
	if hasKeyword(name, H.SoftKeywords) or not hasKeyword(name, H.SolidKeywords) then
		return false
	end
	return not Rules.IsNatural(part, stop)
end

-- H5: "Neon" / "Beam" / "BillboardGui" / nil
function Rules.H5(inst: Instance, stop: Instance?): string?
	if inst:IsA("BasePart") then
		return if inst.Material == Enum.Material.Neon then "Neon" else nil
	elseif inst:IsA("Beam") then
		return "Beam"
	elseif inst:IsA("BillboardGui") then
		return if underNames(inst, BB_ALLOW, stop) then nil else "BillboardGui"
	end
	return nil
end

function Rules.H6(inst: Instance): boolean
	return inst:IsA("Humanoid")
end

function Rules.H7(part: BasePart): boolean
	local s = part.Size
	return math.max(s.X, s.Y, s.Z) > H.MaxPartSize
end

-- H8: nil or what is out of policy on one light
function Rules.H8(light: Light): string?
	local L = WorldConfig.Lights
	local bad: { string } = {}
	if light.Brightness > L.MaxBrightness + 1e-6 then
		table.insert(bad, string.format("Brightness %.2f", light.Brightness))
	end
	local range = (light :: any).Range
	if type(range) == "number" and range > L.MaxRange + 1e-6 then
		table.insert(bad, string.format("Range %.0f", range))
	end
	if light.Shadows ~= L.Shadows then
		table.insert(bad, "Shadows")
	end
	if not CollectionService:HasTag(light, WorldConfig.Atmosphere.NightLightTag) then
		table.insert(bad, "untagged")
	end
	return if #bad > 0 then table.concat(bad, ", ") else nil
end

-- H9: a caster smaller than ShadowMinSize; with the part's box (dressing only), also a flat marking casting a shadow
function Rules.H9(part: BasePart, b: Box?): boolean
	if not part.CastShadow then
		return false
	end
	local s = part.Size
	return math.max(s.X, s.Y, s.Z) < H.ShadowMinSize or (b ~= nil and Rules.FlatMarking(part, b))
end

WorldHygiene.Rules = Rules

-- ── walking the world ─────────────────────────────────────────────────────────

-- the children of root to inspect (bases excluded) and whether root itself is a dressing folder
local function scopes(root: Instance): ({ Instance }, boolean)
	if DRESSING[root.Name] then
		return { root }, true
	end
	local out: { Instance } = {}
	for _, ch in ipairs(root:GetChildren()) do
		if not BASES[ch.Name] then
			table.insert(out, ch)
		end
	end
	return out, false
end

local function pathOf(inst: Instance, root: Instance): string
	local names: { string } = {}
	local cur: Instance? = inst
	while cur and cur ~= root do
		table.insert(names, 1, cur.Name)
		cur = cur.Parent
	end
	return table.concat(names, ".")
end

local function centreOf(b: Box): (number, number)
	return (b.X0 + b.X1) * 0.5, (b.Z0 + b.Z1) * 0.5
end

local function newReport(mode: string, root: Instance): Report
	local rep: Report = {
		Mode = mode,
		Root = root:GetFullName(),
		Parts = 0,
		DressingParts = 0,
		Counts = {},
		Actions = {},
		Violations = {},
		Orphans = {},
		Census = {
			Neon = 0,
			Beams = 0,
			Billboards = 0,
			BillboardsWorldCode = 0,
			Humanoids = 0,
			Lights = 0,
			LightsDressing = 0,
			SurfaceGuis = 0,
			ShadowCasters = 0,
			Oversize = 0,
			InvisibleCollidable = 0,
		},
		Legacy = {},
		ByTop = {},
	}
	for _, r in ipairs(RULES) do
		rep.Counts[r] = 0
		rep.Actions[r] = 0
	end
	for _, c in ipairs(ANCHOR_CLASSES) do
		rep.Census["Anchor_" .. c] = 0
	end
	return rep
end

local function addViolation(rep: Report, rule: string, path: string, detail: string, x: number, z: number)
	rep.Counts[rule] += 1
	table.insert(rep.Violations, { Rule = rule, Path = path, Detail = detail, X = x, Z = z })
end

-- ── H1 units and orphans ──────────────────────────────────────────────────────

type Unit = { Key: string, Inst: Instance?, Parts: { BasePart }, Box: Box, Natural: boolean }

-- dressing parts → units: the kit Folder / Model directly under a section, else touching loose parts of a section
local function unitsOf(folder: Instance, boxes: { [BasePart]: Box }): { Unit }
	local units: { Unit } = {}
	local byInst: { [Instance]: Unit } = {}
	local loose: { [Instance]: { BasePart } } = {}
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") and boxes[d] then
			-- chain: folder > section > kit > ...
			local chain: { Instance } = {}
			local cur: Instance? = d
			while cur and cur ~= folder do
				table.insert(chain, 1, cur)
				cur = cur.Parent
			end
			local section = chain[1]
			local kit = chain[2]
			local key: Instance? = nil
			if section == d then
				key = d -- a loose part directly under the dressing folder
			elseif kit and kit ~= d and (kit:IsA("Folder") or kit:IsA("Model") or kit:IsA("BasePart")) then
				key = kit
			elseif section:IsA("Model") then
				key = section
			end
			if key then
				local u: Unit? = byInst[key]
				if not u then
					local nu: Unit = { Key = pathOf(key, folder.Parent or folder), Inst = key, Parts = {}, Box = boxes[d], Natural = false }
					byInst[key] = nu
					table.insert(units, nu)
					u = nu
				end
				table.insert((u :: Unit).Parts, d)
			else
				local list = loose[section]
				if not list then
					list = {}
					loose[section] = list
				end
				table.insert(list, d)
			end
		end
	end
	-- loose parts of a section: union parts whose boxes come within 4 studs
	for section, list in pairs(loose) do
		local parent: { number } = {}
		for i = 1, #list do
			parent[i] = i
		end
		local function find(i: number): number
			while parent[i] ~= i do
				parent[i] = parent[parent[i]]
				i = parent[i]
			end
			return i
		end
		for i = 1, #list do
			local a = boxes[list[i]]
			for j = i + 1, #list do
				local b = boxes[list[j]]
				if a.X1 + 4 >= b.X0 and b.X1 + 4 >= a.X0 and a.Z1 + 4 >= b.Z0 and b.Z1 + 4 >= a.Z0 then
					local ri, rj = find(i), find(j)
					if ri ~= rj then
						parent[ri] = rj
					end
				end
			end
		end
		local groups: { [number]: Unit } = {}
		local base = pathOf(section, folder.Parent or folder)
		for i, p in ipairs(list) do
			local r = find(i)
			local u: Unit? = groups[r]
			if not u then
				local nu: Unit = { Key = base .. "#" .. list[r].Name, Inst = nil, Parts = {}, Box = boxes[p], Natural = false }
				groups[r] = nu
				table.insert(units, nu)
				u = nu
			end
			table.insert((u :: Unit).Parts, p)
		end
	end
	for _, u in ipairs(units) do
		local b: Box = { X0 = math.huge, X1 = -math.huge, Y0 = math.huge, Y1 = -math.huge, Z0 = math.huge, Z1 = -math.huge }
		local natural = true
		for _, p in ipairs(u.Parts) do
			local pb = boxes[p]
			b.X0, b.X1 = math.min(b.X0, pb.X0), math.max(b.X1, pb.X1)
			b.Y0, b.Y1 = math.min(b.Y0, pb.Y0), math.max(b.Y1, pb.Y1)
			b.Z0, b.Z1 = math.min(b.Z0, pb.Z0), math.max(b.Z1, pb.Z1)
			if p.Transparency < 0.99 and not Rules.IsNatural(p, folder) then
				natural = false
			end
		end
		u.Box = b
		u.Natural = natural
	end
	table.sort(units, function(a: Unit, b: Unit): boolean
		return a.Key < b.Key
	end)
	return units
end

-- W3: a natural unit may stand alone when its instance says it holds >= MinNatural elements (Terrain rocks included)
-- and its parts come in >= 2 sizes (largest dimensions at least 20 % apart), e.g. a dead tree, a stump and a log
local function standsAlone(u: Unit): boolean
	local inst = u.Inst
	if not (u.Natural and inst) then
		return false
	end
	local el = inst:GetAttribute(ELEMENTS_ATTR)
	if type(el) ~= "number" or el < H.MinNatural then
		return false
	end
	local lo, hi = math.huge, 0
	for _, p in ipairs(u.Parts) do
		local s = p.Size
		local m = math.max(s.X, s.Y, s.Z)
		lo, hi = math.min(lo, m), math.max(hi, m)
	end
	return hi > 0 and hi >= lo * 1.2
end

-- the WE_Anchor class of a unit ("poi" | "road" | "junction" | "water" | "natural"; "none" when unset)
local function anchorClass(u: Unit): string
	local a = if u.Inst then u.Inst:GetAttribute("WE_Anchor") else nil
	local cls = if type(a) == "string" then string.match(a, "^(%a+)") else nil
	return if cls and table.find(ANCHOR_CLASSES, cls) then cls else "none"
end

-- distance from a unit centre to its nearest anchor
local function anchorDist(ctx: Ctx, b: Box): number
	local x, z = centreOf(b)
	local best = roadDist(ctx, x, z)
	for _, p in ipairs(ctx.POIs) do
		local d
		if p.Rect then
			d = rectDist(p.Rect, x, z)
		elseif p.Circle then
			d = math.max(0, math.sqrt((x - p.Circle.X) ^ 2 + (z - p.Circle.Z) ^ 2) - p.Circle.R)
		else
			d = math.huge
		end
		best = math.min(best, d)
	end
	for _, r in ipairs(ctx.Water) do
		best = math.min(best, rectDist(r, x, z))
	end
	for _, r in ipairs(ctx.PlotPads) do
		best = math.min(best, rectDist(r, x, z))
	end
	for _, c in ipairs(ctx.Territories) do
		best = math.min(best, math.max(0, math.sqrt((x - c.X) ^ 2 + (z - c.Z) ^ 2) - c.R))
	end
	return best
end

local function findOrphans(ctx: Ctx, folder: Instance, boxes: { [BasePart]: Box }): ({ { Unit: Unit, Nearest: number } }, { Unit })
	local units = unitsOf(folder, boxes)
	local out: { { Unit: Unit, Nearest: number } } = {}
	local naturals: { Unit } = {}
	local dist: { [Unit]: number } = {}
	for _, u in ipairs(units) do
		dist[u] = anchorDist(ctx, u.Box)
		if u.Natural then
			table.insert(naturals, u)
		end
	end
	-- natural groups: units whose centres are within NaturalLink of each other
	local groupSize: { [Unit]: number } = {}
	do
		local parent: { [Unit]: Unit } = {}
		for _, u in ipairs(naturals) do
			parent[u] = u
		end
		local function find(u: Unit): Unit
			while parent[u] ~= u do
				u = parent[u]
			end
			return u
		end
		for i = 1, #naturals do
			local ax, az = centreOf(naturals[i].Box)
			for j = i + 1, #naturals do
				local bx, bz = centreOf(naturals[j].Box)
				if (ax - bx) ^ 2 + (az - bz) ^ 2 <= H.NaturalLink ^ 2 then
					local ri, rj = find(naturals[i]), find(naturals[j])
					if ri ~= rj then
						parent[ri] = rj
					end
				end
			end
		end
		local counts: { [Unit]: number } = {}
		for _, u in ipairs(naturals) do
			local r = find(u)
			counts[r] = (counts[r] or 0) + 1
		end
		for _, u in ipairs(naturals) do
			groupSize[u] = counts[find(u)]
		end
	end
	for _, u in ipairs(units) do
		local anchored = dist[u] <= H.AnchorMax
		if u.Natural then
			anchored = anchored or (groupSize[u] or 1) >= H.MinNatural or standsAlone(u)
		end
		if not anchored then
			table.insert(out, { Unit = u, Nearest = dist[u] })
		end
	end
	return out, units
end

-- ── Report ────────────────────────────────────────────────────────────────────

function WorldHygiene.Report(root: Instance, opts: Opts?): Report
	local rep = newReport("Report", root)
	local ctx = buildContext(opts)
	local list, rootIsDressing = scopes(root)
	local lights: { Light } = {}
	for _, top in ipairs(list) do
		local isDressing = rootIsDressing or DRESSING[top.Name] == true
		local isV2 = V2[top.Name] == true
		local roadExemptTop = top.Name == "Map" or top.Name == "CoastalWater" or isV2
		local all = top:GetDescendants()
		table.insert(all, 1, top)
		local boxes: { [BasePart]: Box } = {}
		local topParts = 0
		for _, d in ipairs(all) do
			if d:IsA("BasePart") then
				local b = worldBox(d)
				boxes[d] = b
				topParts += 1
				local x, z = centreOf(b)
				local path = pathOf(d, root)
				if d.Material == Enum.Material.Neon then
					rep.Census.Neon += 1
					addViolation(rep, "H5", path, "Neon", x, z)
				end
				if Rules.H7(d) then
					rep.Census.Oversize += 1
					addViolation(rep, "H7", path, string.format("size %s", tostring(d.Size)), x, z)
				end
				if d.CastShadow then
					rep.Census.ShadowCasters += 1
					if Rules.H9(d, if isDressing then b else nil) then
						addViolation(rep, "H9", path, if Rules.H9(d) then "small shadow caster" else "flat marking casts a shadow", x, z)
					end
				end
				if d.CanCollide and d.Transparency >= 0.95 and not isV2 then
					rep.Census.InvisibleCollidable += 1
				end
				if not roadExemptTop and not Rules.RoadExempt(d, root) then
					local why = Rules.H2(ctx, d, b)
					if why then
						addViolation(rep, "H2", path, why, x, z)
					end
				end
				if isDressing then
					local zone, wet = Rules.H3(ctx, b)
					if zone and not (wet and attrUp(d, "WE_AllowInWater", root)) and not Rules.RuntimeDoor(d) then
						addViolation(rep, "H3", path, zone, x, z)
					end
					if Rules.H4Candidate(d, b, root) and not (d.CanCollide and d.CanQuery) then
						addViolation(rep, "H4", path, "walk-through cover", x, z)
					end
				end
			elseif d:IsA("BillboardGui") then
				rep.Census.Billboards += 1
				if Rules.H5(d, root) then
					rep.Census.BillboardsWorldCode += 1
					addViolation(rep, "H5", pathOf(d, root), "BillboardGui", 0, 0)
				end
			elseif d:IsA("Beam") then
				rep.Census.Beams += 1
				addViolation(rep, "H5", pathOf(d, root), "Beam", 0, 0)
			elseif d:IsA("Humanoid") then
				rep.Census.Humanoids += 1
				addViolation(rep, "H6", pathOf(d, root), "static Humanoid", 0, 0)
			elseif d:IsA("Light") then
				rep.Census.Lights += 1
				if isDressing then
					rep.Census.LightsDressing += 1
				end
				table.insert(lights, d)
				local why = Rules.H8(d)
				if why then
					addViolation(rep, "H8", pathOf(d, root), why, 0, 0)
				end
			elseif d:IsA("SurfaceGui") then
				rep.Census.SurfaceGuis += 1
			end
		end
		rep.Parts += topParts
		rep.ByTop[top.Name] = (rep.ByTop[top.Name] or 0) + topParts
		if LEGACY[top.Name] then
			rep.Legacy[top.Name] = topParts
		end
		if isDressing then
			rep.DressingParts += topParts
			-- H10: dressing Models wider than MaxModelSpan (a POI's flat Infra strips are exempt)
			for _, d in ipairs(all) do
				if d:IsA("Model") and d:GetAttribute(INFRA_ATTR) ~= true then
					local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
					for _, q in ipairs(d:GetDescendants()) do
						local qb = if q:IsA("BasePart") then boxes[q] else nil
						if qb then
							x0, x1, z0, z1 = math.min(x0, qb.X0), math.max(x1, qb.X1), math.min(z0, qb.Z0), math.max(z1, qb.Z1)
						end
					end
					local span = math.max(x1 - x0, z1 - z0)
					if x1 >= x0 and span > H.MaxModelSpan then
						addViolation(rep, "H10", pathOf(d, root), string.format("model %.0f studs across", span), (x0 + x1) * 0.5, (z0 + z1) * 0.5)
					end
				end
			end
			-- H1 orphans (and the anchor-class census of every unit)
			local orphans, units = findOrphans(ctx, top, boxes)
			for _, u in ipairs(units) do
				local key = "Anchor_" .. anchorClass(u)
				rep.Census[key] = (rep.Census[key] or 0) + 1
			end
			for _, o in ipairs(orphans) do
				local x, z = centreOf(o.Unit.Box)
				local kind = if o.Unit.Natural then "natural" else "man-made"
				table.insert(rep.Orphans, { Path = o.Unit.Key, Kind = kind, X = x, Z = z, Parts = #o.Unit.Parts, Nearest = o.Nearest })
				addViolation(rep, "H1", o.Unit.Key, string.format("%s orphan, %d parts, %.0f from an anchor", kind, #o.Unit.Parts, o.Nearest), x, z)
			end
		end
	end
	if #lights > WorldConfig.Lights.MaxWorld then
		addViolation(rep, "H8", rep.Root, string.format("%d lights > %d", #lights, WorldConfig.Lights.MaxWorld), 0, 0)
	end
	if rep.Census.ShadowCasters > H.MaxShadowCasters then
		addViolation(rep, "H9", rep.Root, string.format("%d shadow casters > %d", rep.Census.ShadowCasters, H.MaxShadowCasters), 0, 0)
	end
	return rep
end

function WorldHygiene.Check(root: Instance, opts: Opts?): { Violation }
	return WorldHygiene.Report(root, opts).Violations
end

-- ── Enforce ───────────────────────────────────────────────────────────────────

local function countParts(inst: Instance): number
	local n = if inst:IsA("BasePart") then 1 else 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

-- one dressing folder: H6, H5, H3, H4, H2, H9 (H8 / H1 run across all targets afterwards)
local function enforceFolder(folder: Instance, ctx: Ctx, actions: { [string]: number })
	local boxes: { [BasePart]: Box } = {}
	local parts: { BasePart } = {}
	local desc = folder:GetDescendants()
	for _, d in ipairs(desc) do
		if d:IsA("BasePart") then
			boxes[d] = worldBox(d)
			table.insert(parts, d)
		end
	end

	local doomed: { [Instance]: string } = {} -- instance -> rule
	local function isDoomed(inst: Instance): boolean
		local cur: Instance? = inst
		while cur and cur ~= folder do
			if doomed[cur] then
				return true
			end
			cur = cur.Parent
		end
		return false
	end

	-- H6: static Humanoids → their model (or the Humanoid alone)
	for _, d in ipairs(desc) do
		if d:IsA("Humanoid") then
			local m = d.Parent
			local victim: Instance = if m and m ~= folder and m:IsA("Model") then m else d
			if not doomed[victim] then
				doomed[victim] = "H6"
			end
		end
	end

	-- H5: Beams and BillboardGuis go; Neon becomes SmoothPlastic
	for _, d in ipairs(desc) do
		if d.Parent ~= nil and (d:IsA("Beam") or (d:IsA("BillboardGui") and Rules.H5(d, folder) ~= nil)) then
			d:Destroy()
			actions.H5 += 1
		end
	end
	for _, p in ipairs(parts) do
		if p.Material == Enum.Material.Neon then
			p.Material = Enum.Material.SmoothPlastic
			actions.H5 += 1
		end
	end

	-- kit resolution for destroy rules: the nearest Model / kit Folder below `folder` when it spans <= KitMaxSpan
	-- and holds nothing protected; otherwise the part alone (plus the raised parts it carried)
	local kitMemo: { [Instance]: boolean } = {}
	local function kitOk(kit: Instance, protected: (Instance) -> boolean): boolean
		local memo = kitMemo[kit]
		if memo ~= nil then
			return memo
		end
		local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
		local ok = true
		for _, k in ipairs(kit:GetDescendants()) do
			local kb = if k:IsA("BasePart") then boxes[k] else nil
			if kb then
				x0, x1, z0, z1 = math.min(x0, kb.X0), math.max(x1, kb.X1), math.min(z0, kb.Z0), math.max(z1, kb.Z1)
				if protected(k) then
					ok = false
					break
				end
			end
		end
		ok = ok and x1 >= x0 and math.max(x1 - x0, z1 - z0) <= H.KitMaxSpan
		kitMemo[kit] = ok
		return ok
	end
	local siblings: { [Instance]: { BasePart } } = {}
	for _, p in ipairs(parts) do
		local parent = p.Parent
		if parent then
			local l = siblings[parent]
			if not l then
				l = {}
				siblings[parent] = l
			end
			table.insert(l, p)
		end
	end
	local function doom(hit: BasePart, rule: string, protected: (Instance) -> boolean)
		local victim: BasePart = hit
		local cur = hit.Parent
		while cur and cur ~= folder do
			if cur:IsA("BasePart") then
				victim = cur
			elseif not (cur:IsA("Model") and cur.Parent and cur.Parent:IsA("BasePart")) then
				break
			end
			cur = cur.Parent
		end
		if cur and cur ~= folder and (cur:IsA("Model") or cur:IsA("Folder")) and kitOk(cur, protected) then
			if not doomed[cur] then
				doomed[cur] = rule
			end
			return
		end
		if doomed[victim] then
			return
		end
		doomed[victim] = rule
		-- sweep: raised siblings touching it (sandbag tops, sign faces), bounded to KitMaxSpan from the hit
		local vb = boxes[victim]
		if not vb then
			return
		end
		local cx, cz = centreOf(vb)
		local queue: { BasePart } = { victim }
		local head = 1
		while head <= #queue do
			local item = queue[head]
			head += 1
			local ib = boxes[item]
			for _, q in ipairs((item.Parent and siblings[item.Parent]) or {}) do
				local qb = boxes[q]
				if
					not doomed[q]
					and qb.Y0 > GROUND_TOP_Y + 0.1
					and qb.X1 >= ib.X0 - 0.1
					and qb.X0 <= ib.X1 + 0.1
					and qb.Y1 >= ib.Y0 - 0.1
					and qb.Y0 <= ib.Y1 + 0.1
					and qb.Z1 >= ib.Z0 - 0.1
					and qb.Z0 <= ib.Z1 + 0.1
					and math.max(math.abs((qb.X0 + qb.X1) * 0.5 - cx), math.abs((qb.Z0 + qb.Z1) * 0.5 - cz)) <= H.KitMaxSpan
					and not protected(q)
				then
					doomed[q] = rule
					table.insert(queue, q)
				end
			end
		end
	end

	-- H3: clear zones (water hits honour WE_AllowInWater)
	local function inWaterAllowed(inst: Instance): boolean
		return attrUp(inst, "WE_AllowInWater", folder)
	end
	local function noProtection(_inst: Instance): boolean
		return false
	end
	for _, p in ipairs(parts) do
		if not isDoomed(p) and not Rules.RuntimeDoor(p) then
			local zone, wet = Rules.H3(ctx, boxes[p])
			if zone and not (wet and inWaterAllowed(p)) then
				doom(p, "H3", if wet then inWaterAllowed else noProtection)
			end
		end
	end

	-- H4: walk-through cover becomes solid (before H2, so new blockers on a road are then removed)
	for _, p in ipairs(parts) do
		if not isDoomed(p) and Rules.H4Candidate(p, boxes[p], folder) and not (p.CanCollide and p.CanQuery) then
			p.CanCollide = true
			p.CanQuery = true
			actions.H4 += 1
		end
	end

	-- H2: road corridor
	local function roadProtected(inst: Instance): boolean
		return Rules.RoadExempt(inst, folder)
	end
	for _, p in ipairs(parts) do
		if not isDoomed(p) and not Rules.RoadExempt(p, folder) and Rules.H2(ctx, p, boxes[p]) then
			doom(p, "H2", roadProtected)
		end
	end

	-- H9: no small shadow casters, no flat marking casting a shadow
	for _, p in ipairs(parts) do
		if not isDoomed(p) and Rules.H9(p, boxes[p]) then
			p.CastShadow = false
			actions.H9 += 1
		end
	end

	-- destroy the top-most doomed instances; count parts per rule
	local function underDoomedParent(inst: Instance): boolean
		local parent = inst.Parent
		return parent ~= nil and parent ~= folder and isDoomed(parent)
	end
	local tops: { Instance } = {}
	for inst in pairs(doomed) do
		if not underDoomedParent(inst) then
			table.insert(tops, inst)
		end
	end
	for _, inst in ipairs(tops) do
		local rule = doomed[inst]
		actions[rule] += countParts(inst)
		inst:Destroy()
	end
end

function WorldHygiene.Enforce(root: Instance, opts: Opts?): Report
	local ctx = buildContext(opts)
	local actions: { [string]: number } = {}
	for _, r in ipairs(RULES) do
		actions[r] = 0
	end
	local targets: { Instance } = {}
	if DRESSING[root.Name] then
		table.insert(targets, root)
	else
		for _, ch in ipairs(root:GetChildren()) do
			if DRESSING[ch.Name] then
				table.insert(targets, ch)
			end
		end
	end
	for _, folder in ipairs(targets) do
		enforceFolder(folder, ctx, actions)
	end

	-- H8: clamp and tag dressing lights; drop dressing lights beyond the world budget (deterministic order)
	local worldRoot: Instance = (opts and opts.WorldRoot) or (if DRESSING[root.Name] and root.Parent then root.Parent else root)
	local L = WorldConfig.Lights
	local tag = WorldConfig.Atmosphere.NightLightTag
	local clock: any = Lighting.ClockTime
	local night = WorldAtmosphere.NightShare(if type(clock) == "number" then clock else 12) > 0.5
	local dressingLights: { Light } = {}
	for _, folder in ipairs(targets) do
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("Light") then
				table.insert(dressingLights, d)
			end
		end
	end
	table.sort(dressingLights, function(a: Light, b: Light): boolean
		return a:GetFullName() < b:GetFullName()
	end)
	-- every world light outside the folders enforced now counts, including OTHER dressing folders (the hook enforces
	-- WorldDressing and DesertFlora in separate calls; each call must see the other's lights to keep the 24 total)
	local isTarget: { [Instance]: boolean } = {}
	for _, folder in ipairs(targets) do
		isTarget[folder] = true
	end
	local otherLights = 0
	local wl, _ = scopes(worldRoot)
	for _, top in ipairs(wl) do
		if not isTarget[top] then
			for _, d in ipairs(top:GetDescendants()) do
				if d:IsA("Light") then
					otherLights += 1
				end
			end
		end
	end
	local budget = math.max(0, L.MaxWorld - otherLights)
	for i, light in ipairs(dressingLights) do
		if i > budget then
			light:Destroy()
			actions.H8 += 1
		else
			local changed = false
			if light.Brightness > L.MaxBrightness then
				light.Brightness = L.MaxBrightness
				changed = true
			end
			local anyLight: any = light
			if type(anyLight.Range) == "number" and anyLight.Range > L.MaxRange then
				anyLight.Range = L.MaxRange
				changed = true
			end
			if light.Shadows ~= L.Shadows then
				light.Shadows = L.Shadows
				changed = true
			end
			if not CollectionService:HasTag(light, tag) then
				CollectionService:AddTag(light, tag)
				light.Enabled = night
				changed = true
			end
			if changed then
				actions.H8 += 1
			end
		end
	end

	-- H1: orphans (Report mode: listed only; Enforce (W3): destroyed, the whole unit)
	local mode = (opts and opts.OrphanMode) or H.OrphanMode
	if mode == "Enforce" then
		for _, folder in ipairs(targets) do
			local boxes: { [BasePart]: Box } = {}
			for _, d in ipairs(folder:GetDescendants()) do
				if d:IsA("BasePart") then
					boxes[d] = worldBox(d)
				end
			end
			local orphans = findOrphans(ctx, folder, boxes)
			for _, o in ipairs(orphans) do
				local u = o.Unit
				if u.Inst and u.Inst.Parent then
					actions.H1 += countParts(u.Inst)
					u.Inst:Destroy()
				else
					for _, p in ipairs(u.Parts) do
						if p.Parent then
							actions.H1 += 1
							p:Destroy()
						end
					end
				end
			end
		end
	end

	local rep = WorldHygiene.Report(root, opts)
	rep.Mode = "Enforce"
	rep.Actions = actions
	if not (opts and opts.Log == false) then
		print(
			string.format(
				"[WAR EMPIRE] WorldHygiene: %s — destroyed H2 %d, H3 %d, H6 %d, H8 %d lights; set H4 %d, H5 %d, H9 %d; orphans %d (%s); left %d parts",
				root.Name,
				actions.H2,
				actions.H3,
				actions.H6,
				actions.H8,
				actions.H4,
				actions.H5,
				actions.H9,
				#rep.Orphans,
				mode,
				rep.Parts
			)
		)
	end
	return rep
end

return WorldHygiene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">WorldKits</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 2 (W3) — WorldKits: the Part-kit catalogue for everything built OUTSIDE the bases
	(gap/world_v2_spec.md §4.5, roadmap §2.4). Our own designs only: no competitor asset, no third-party model, no brand
	or insignia. Every kit is built from anchored Parts (H1–H10 compliant by construction) and, where a Roblox-owned
	Synty mesh exists (VisualAssetConfig.DesertKit, LOOK lane), may carry a deferred mesh overlay that REPLACES the
	fallback visuals and never adds a part — the Part kit is always built first, so a failed load (or the headless sim,
	which has no InsertService) keeps it.

	CONTRACT (scratchpad/w3/contracts.md §2): owner = B1.

	PUBLIC API (server only):
	  WorldKits.Specs : { [kitId]: KitSpec }          part count, footprint, class, collide / light / sign / mesh rules
	  WorldKits.List() -> { string }                  kit ids, sorted
	  WorldKits.Rng(seed) -> Rng                      pure-Luau xorshift32: identical sequence in the sim and on live;
	                                                  rng:NextNumber(min?, max?), rng:NextInteger(min, max) (Random API)
	  WorldKits.Part(spec, parent) -> Part            the one factory: anchored, CanTouch off, Collide → CanCollide +
	                                                  CanQuery, never Neon, CastShadow only when largest dim >= 8 (H9)
	  WorldKits.NewCluster(name, attrs) -> Model      UNPARENTED cluster Model carrying the H1 attributes (WE_Cluster,
	                                                  WE_Anchor, WE_AnchorX/Z, WE_Elements, WE_Tier, WE_AllowInWater);
	                                                  natural clusters are named "Flora_…" (a Hygiene natural prefix)
	  WorldKits.Add(cluster, kitId, cf, opts?) -> number
	                                                  builds one kit into the cluster at cf (ground pivot, y = 0.5, local
	                                                  -Z = front); returns the parts added: exactly Specs[kit].Parts at
	                                                  default opts, Parts x units with Count / Length (<= PartsMax),
	                                                  Specs[kit].Variants[v] with Variant v;
	                                                  0 = unknown kit or a reserved kit with no builder (warned once)
	  WorldKits.Finish(cluster, parent) -> ClusterInfo
	                                                  checks parts > 0 and XZ span <= 64 (H10), parents it, then queues
	                                                  the deferred mesh overlays; an invalid cluster is destroyed and
	                                                  never parented (Ok = false)
	  WorldKits.Discard(cluster)                      destroys a cluster that was built but not Finished (a keep-out
	                                                  hit): its pending signs / overlays are dropped
	  WorldKits.Place(kitId, cf, parent, opts) -> Model?
	                                                  NewCluster + Add + Finish for a one-kit cluster
	  WorldKits.Footprint(kitId, opts?) -> Footprint  the kit's exact extents in its own frame at yaw 0 (measured once
	                                                  from a throw-away build, cached): X0 / X1 / Z0 / Z1 / Top, plus
	                                                  CollideZ0 (nearest collidable part toward the front, -Z) and
	                                                  VisibleZ0 (nearest visible part taller than 0.3). Road-side kits
	                                                  keep every collidable part at local z >= 0 (the back half)
	  WorldKits.Rock(pos, kind, rng, opts?) -> { Prim }
	                                                  Terrain rock group (0 parts): "outcrop" | "boulders" | "rubble" |
	                                                  "scorch"; every prim stays within opts.Radius (default
	                                                  WorldConfig.Kits.Rock[kind].Radius) of pos; fills through the
	                                                  terrain handle and appends to the log (Tag "rock", Run = kind).
	                                                  It does not test keep-outs: callers test WorldDress.Blocked first
	  WorldKits.Sign(board, face, text, opts?) -> SurfaceGui?
	                                                  painted sign (Shared/Util/WorldLabel.Surface, MaxDistance <= 80);
	                                                  nil when the world sign budget (WorldConfig.Budgets.SurfaceGuis,
	                                                  counted outside the bases) is spent
	  WorldKits.SetTerrain(handle?) / TerrainLog() / ResetTerrainLog() / TerrainHandle()
	                                                  terrain handle (tests pass a recorder; nil = Workspace.Terrain) and
	                                                  the prims filled since the last reset (the sim dumps them)

	FRAME: cf is the kit's ground pivot (desert floor y = 0.5, yaw only). Local -Z is the kit's front (it faces the road
	or the viewer); +X is right. Specs[kit].Size is the kit's AABB size at yaw 0 (default opts); Footprint gives the
	pivot-relative extents. Pivots: road-side kits (wrecks, drums, crates, sandbags, nest, markers, signs, jersey) sit
	at the front edge of their collidable mass (collidables at z >= 0); JettyStub / BargeWreck / BeachedHull at their
	landward end (the hull reaches toward -Z, the water); Checkpoint on the road centre line (X across the road, booth
	on +X); everything else roughly centred.

	MESH OVERLAYS (contracts §8.3; LOOK's VisualAssetService.CloneKitMesh): deferred, capped by
	WorldConfig.Kits.MeshOverlays, never blocking, never adding a part:
	  "each"     natural kits (DeadTree, Stump, Log, Reeds, DuneGrass, Driftwood): each part becomes one mesh (net 0)
	  "skin"     1-part solid units (CrateStack crates, Bench): the part keeps its box collision and renders the mesh
	             through a SpecialMesh (net 0; a separate collider would add a part)
	  "collider" multi-part solid kits (Wreck "car"): the largest part becomes the invisible box collider sized to the
	             kit, the other parts go, one mesh is added (net 2 - n)
	A piece whose ref has Yaw = +-90 / 270 (attribute WE_KitYaw from CloneKitMesh; Driftwood, CarWreck) is turned by it
	and takes the box with X and Z swapped, so its long axis lies on the kit's. A key VisualAssetService.IsKitMeshWired
	calls unwired (config id 0) takes no MeshOverlays slot, and one wired key takes at most ceil(cap / wired keys used
	by Specs) slots, so the kits built first (Town crates, reeds, wrecks) cannot use up the cap before the travel
	dressing's logs, driftwood, dead trees, stumps and grass (headless world sim: 40 slots went to 3 keys before).
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Configs = ReplicatedStorage.Shared.Configs
local WorldConfig = require(Configs.WorldConfig)
local WorldTerrain = require(script.Parent.WorldTerrain)
local WorldLabel = require(ReplicatedStorage.Shared.Util.WorldLabel)

export type Prim = WorldTerrain.Prim

-- Class: "manmade" | "natural" | "marking" | "anchor" (W3 step 2: the invisible ActivityHost) | "infra" (W3 step 2: flat
-- strips built outside the clusters, exempt from H10). Solid: its cover parts >= 1.5 tall collide + query (H4).
-- Size: AABB size at yaw 0 (X across, Y up from the floor, Z depth; the kit's front faces local -Z), default opts.
-- Parts: exact count at default opts (per unit for Count / Length kits). Step: 1 = needed in W3 step 1 (Town + travel
-- dressing), 2 = later POIs. Use: who places it in step 1 ("Town", "Travel", "Town+Travel", "POI" = later).
-- Variants (W3 step 2 contract): exact part count per Variant at otherwise default opts (per unit for Count / Length
-- kits); the lane K kit harness checks Footprint(kit, { Variant = v }).Parts against it.
export type KitSpec = {
	Parts: number,
	PartsMax: number,
	Size: Vector3,
	Class: string,
	Solid: boolean,
	Lights: number,
	Signs: number,
	Mesh: string?, -- VisualAssetConfig.DesertKit key (Roblox-owned Synty piece) for the deferred overlay
	Water: boolean, -- may step into water (its cluster carries WE_AllowInWater)
	Step: number,
	Use: string,
	Unit: string?, -- Count / Length kits: what Parts counts per
	Variants: { [string]: number }?,
}

export type KitOpts = {
	Variant: string?, -- Wreck: "car" | "truck" | "tank" | "gun"; RoadMarker: "km" | "hazard"; AdobeHouse: "tall" | "wide" | "shop"; CrateStack: "ammo"
	-- W3 step 2: WaterTower "broken"; Fountain "well"; CompoundWall "gate"; DrumGroup "fire"; PlaneWreck "nose" | "mid" |
	-- "tail"; HoldPad "pond"; PipeRun "rack" (Specs[kit].Variants gives each one's part count)
	Count: number?, -- CrateStack / DrumGroup units
	Length: number?, -- SandbagLine studs (1 part per 5); CompoundWall studs (1 part per 16)
	Scale: number?, -- natural kits (0.7 .. 1.3; >= 2 sizes per natural cluster); W3 step 2 also FuelTank, GantryCrane
	Text: string?, -- PoiBoard / DirSign: SurfaceGui text, only when the world sign budget allows
	Color: Color3?, -- tint override (tarps, walls)
	Light: boolean?, -- StreetLamp: build its night PointLight (default true)
	Mesh: boolean?, -- try the Roblox-owned mesh overlay when Specs[kit].Mesh is set (default true)
	Seed: number?, -- per-instance jitter (default: from the pivot position)
	-- Town v2 (TownBlock only; see its builder)
	Width: number?, -- front width, local X (default 20)
	Depth: number?, -- local Z (default 16)
	Storeys: number?, -- 1 .. 6 (default 2), 7 studs each; 5+ = a concrete tower block
	Roof: string?, -- "+"-joined: "bare", "tank", "tanks", "hut", "mast", "dish"
	Lantern: boolean?, -- a soft night lamp over the door (1 part + 1 WE_NightLight PointLight)
	-- W3 step 2 (also Width: Hangar, default 28; Length: WireFence per 16, PipeRun per 40, Runway total)
	R: number?, -- HoldPad radius (WorldConfig.Kits.HoldPad: default 10, 3 .. 24)
	Taxiway: { number }?, -- Runway: { X0, X1, Z0, Z1 } world rect of the taxiway strip
}

export type ClusterAttrs = {
	Source: string, -- "poi" | "rhythm" | "junction" | "shore" | "bay" | "scatter"
	Kind: string, -- cluster kind, e.g. "stall", "wreck_or_nest", "flora_group"
	Anchor: string, -- "poi:<Id>" | "road:<RoadName>" | "junction:<x>,<z>" | "water:<Side>" | "natural"
	AnchorX: number, -- the anchor point H1 measures to (nearest point of the anchor feature)
	AnchorZ: number,
	Natural: boolean?, -- every part natural (flora / dead wood): name gets the "Flora_" prefix
	Elements: number?, -- natural clusters: elements incl. Terrain rocks (H1 stand-alone rule >= 3)
	Tier: number?, -- POIs: 1 = built in Low and Full, 2 = Full only
	InWater: boolean?, -- sets WE_AllowInWater (jetty stub, barge, beached hull)
}

export type PlaceOpts = {
	Name: string,
	Cluster: ClusterAttrs,
	Kit: KitOpts?,
}

export type ClusterInfo = {
	Ok: boolean,
	Parts: number,
	Span: number, -- XZ extent (studs)
	Lights: number,
	Signs: number,
	Reason: string?,
}

export type PartSpec = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Transparency: number?,
	Collide: boolean?, -- true → CanCollide + CanQuery (cover); default false (both off)
	CastShadow: boolean?, -- honoured only when the largest dimension >= WorldConfig.Hygiene.ShadowMinSize (8)
}

export type Rng = {
	NextNumber: (self: any, min: number?, max: number?) -> number,
	NextInteger: (self: any, min: number, max: number) -> number,
}

export type Footprint = {
	X0: number,
	X1: number,
	Z0: number,
	Z1: number,
	Top: number, -- above the floor
	CollideZ0: number, -- min local z of the collidable parts (math.huge: none)
	VisibleZ0: number, -- min local z of the visible parts taller than 0.3 (math.huge: none)
	Parts: number,
}

local WorldKits = {}

local NATURAL_PREFIX = "Flora_"
local MAX_SPAN = WorldConfig.Hygiene.MaxModelSpan -- 64 (H10)
local SHADOW_MIN = WorldConfig.Hygiene.ShadowMinSize -- 8 (H9)
local GROUND_Y = 0.5 -- desert floor top
local KC = WorldConfig.Kits
local PAL = KC.Palette
local M = Enum.Material

type SpecExtra = { Lights: number?, Signs: number?, Mesh: string?, Water: boolean?, Unit: string?, Variants: { [string]: number }? }

local function spec(
	parts: number,
	partsMax: number,
	size: Vector3,
	class: string,
	solid: boolean,
	step: number,
	use: string,
	extra: SpecExtra?
): KitSpec
	local e: SpecExtra = extra or {}
	return {
		Parts = parts,
		PartsMax = partsMax,
		Size = size,
		Class = class,
		Solid = solid,
		Lights = e.Lights or 0,
		Signs = e.Signs or 0,
		Mesh = e.Mesh,
		Water = e.Water == true,
		Step = step,
		Use = use,
		Unit = e.Unit,
		Variants = e.Variants,
	}
end

