		},
		-- strike jets (and the stealth jet): single bombs
		StrikeBombs = {
			Kind = "Bomb",
			Label = "BOMB",
			Damage = 260,
			Class = "AntiVehicle",
			VsInfantryMult = 0.6,
			Rate = 1,
