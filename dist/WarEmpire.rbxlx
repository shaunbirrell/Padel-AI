	-- v37 → v70: one-shot CashMega soft offer (existing DevProduct Id only) — "BEST OFFER"
	do
		local lastMegaToastAt = -math.huge
		local MEGA_TOAST_DEBOUNCE = 14.0

		local function CashMegaToast(payload: any): boolean
			local now = os.clock()
			if now - lastMegaToastAt < MEGA_TOAST_DEBOUNCE then
				return false
			end
			local def = (MonetizationConfig.DevProducts :: any).CashMega
			if typeof(def) ~= "table" or typeof(def.Id) ~= "number" or def.Id == 0 then
				return false
			end
			lastMegaToastAt = now
			local p: any = if typeof(payload) == "table" then payload else {}
			local cashAmount = tonumber(def.Cash) or 0
			return showOffer({
				Key = "CashMegaToast",
				Title = "★ BEST OFFER",
				Sub = tostring(p.DisplayName or def.DisplayName or "Cash Pack Mega")
					.. (if cashAmount > 0 then " · +$" .. formatCash(cashAmount) else ""),
				Cta = ctaFor(tonumber(p.RobuxPrice) or tonumber(def.RobuxPrice)),
				OnGet = function()
					pendingCashMegaHighlight = true
					promptDevProduct("CashMega", "offer")
				end,
			})
		end

		Remotes.BindEvent(Constants.RemoteNames.CashMegaOffer, CashMegaToast)
	end

	-- v33 → v70: ATM raid hold / cooldown / result → the TopStack "Progress" pill (spec §3.4; it was a full-width
	-- chip over the jump button). ONE persistent pill (Frame "AtmRaidHud", its own gui "WarEmpireAtmRaid" at the
	-- bank-raid z) that HudLayout.RegisterTopStack places under the topbar and collapses while hidden. v69
	-- payloads carry Phase: Holding / Alarm show a live bar and hide shortly after the last push; Interrupted /
	-- Blocked / Defended / Success / Robbed show the server's payload.Text for a few seconds. No Phase = legacy v33.
	do
		local P = HudConfig.TopStack.Progress
		local pill: Frame? = nil
		local hideToken = 0

		type PhaseStyle = { Stroke: Color3, Text: Color3, Hold: number, Bar: boolean }
		local AMBER: PhaseStyle = { Stroke = P.ContestedColor, Text = Color3.fromRGB(255, 226, 170), Hold = 2.5, Bar = false }
		local GREEN: PhaseStyle = { Stroke = Color3.fromRGB(120, 220, 140), Text = Color3.fromRGB(200, 255, 210), Hold = 2.5, Bar = false }
		local PHASE_STYLE: { [string]: PhaseStyle } = {
			Holding = { Stroke = Color3.fromRGB(230, 200, 80), Text = Color3.fromRGB(255, 255, 255), Hold = 1.0, Bar = true }, -- thief
			Alarm = { Stroke = Color3.fromRGB(255, 96, 84), Text = Color3.fromRGB(255, 205, 200), Hold = 1.5, Bar = true }, -- victim
			Interrupted = AMBER,
			Blocked = AMBER,
			Defended = GREEN,
			Success = { Stroke = GREEN.Stroke, Text = GREEN.Text, Hold = 5, Bar = false },
			Robbed = { Stroke = Color3.fromRGB(255, 96, 84), Text = Color3.fromRGB(255, 205, 200), Hold = 6, Bar = false },
		}

		local function ensurePill(): Frame?
			local existing = pill
			if existing and existing.Parent then
				return existing
			end
			local pg = player:FindFirstChildOfClass("PlayerGui")
			if not pg then
				return nil
			end
			local gui = Instance.new("ScreenGui")
			gui.Name = "WarEmpireAtmRaid"
			HudLayout.ApplyScreen(gui, { DisplayOrder = HudConfig.DisplayOrder.WarEmpireBankRaid, Insets = "Core" })
			gui.Parent = pg

			local f = Instance.new("Frame")
			f.Name = "AtmRaidHud"
			f.AnchorPoint = Vector2.new(0.5, 0)
			f.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top)
			f.Size = UDim2.fromOffset(P.Size.X, P.Size.Y)
			f.BackgroundColor3 = HudConfig.Colors.PillBg
			f.BackgroundTransparency = 0.12
			f.BorderSizePixel = 0
			f.Visible = false
			f.Active = false
			corner(f, 12)
			local stroke = Instance.new("UIStroke")
			stroke.Name = "Stroke"
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			stroke.Thickness = 2
			stroke.Parent = f

			local lab = Instance.new("TextLabel")
			lab.Name = "Text"
			lab.BackgroundTransparency = 1
			lab.Font = HudConfig.Fonts.Body
			lab.TextSize = P.TextSize
			lab.TextXAlignment = Enum.TextXAlignment.Left
			lab.TextTruncate = Enum.TextTruncate.AtEnd
			lab.TextColor3 = HudConfig.Colors.White
			lab.Parent = f
			UIUtil.TextOutline(lab, 1.2)

			local pct = Instance.new("TextLabel")
			pct.Name = "Pct"
			pct.BackgroundTransparency = 1
			pct.AnchorPoint = Vector2.new(1, 0)
			pct.Position = UDim2.new(1, -12, 0, 3)
			pct.Size = UDim2.fromOffset(56, P.TextSize + 6)
			pct.Font = HudConfig.Fonts.Display
			pct.TextSize = P.TextSize + 2
			pct.TextXAlignment = Enum.TextXAlignment.Right
			pct.TextColor3 = HudConfig.Colors.White
			pct.Text = ""
			pct.Parent = f
			UIUtil.TextOutline(pct, 1.2)

			local barBg = Instance.new("Frame")
			barBg.Name = "Bar"
			barBg.AnchorPoint = Vector2.new(0.5, 1)
			barBg.Position = UDim2.new(0.5, 0, 1, -7)
			barBg.Size = UDim2.new(1, -24, 0, P.BarH)
			barBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			barBg.BackgroundTransparency = 0.45
			barBg.BorderSizePixel = 0
			barBg.Visible = false
			barBg.Parent = f
			corner(barBg, P.BarH // 2)
			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.Size = UDim2.fromScale(0, 1)
			fill.BorderSizePixel = 0
			fill.Parent = barBg
			corner(fill, P.BarH // 2)

			f.Parent = gui
			HudLayout.RegisterTopStack("AtmRaid", f, HudConfig.TopStack.Order.Progress, { Space = "Hud" })
			pill = f
			return f
		end

		local function hideLater(frame: Frame, seconds: number)
			hideToken += 1
			local token = hideToken
			task.delay(seconds, function()
				if token == hideToken and pill == frame then
					frame.Visible = false
				end
			end)
		end

		-- paint the pill: text, optional bar fraction, colours; auto width (Progress.Size.X … the stack's max)
		local function showPill(text: string, style: PhaseStyle, fraction: number?)
			local f = ensurePill()
			if not f then
				return
			end
			local lab = f:FindFirstChild("Text")
			local pct = f:FindFirstChild("Pct")
			local barBg = f:FindFirstChild("Bar")
			local stroke = f:FindFirstChild("Stroke")
			local withBar = style.Bar and fraction ~= nil
			local pctW = if withBar then 60 else 0
			local textW = P.Size.X
			pcall(function()
				textW = TextService:GetTextSize(text, P.TextSize, HudConfig.Fonts.Body, Vector2.new(4000, 100)).X
			end)
			local maxW = math.max(P.Size.X, HudLayout.TopStackMaxWidthV())
			local w = math.clamp(math.ceil(textW * 1.06) + 24 + pctW, P.Size.X, maxW)
			f.Size = UDim2.fromOffset(w, P.Size.Y)
			if stroke and stroke:IsA("UIStroke") then
				stroke.Color = style.Stroke
			end
			if lab and lab:IsA("TextLabel") then
				lab.Text = text
				lab.TextColor3 = style.Text
				if withBar then
					lab.Position = UDim2.fromOffset(12, 4)
					lab.Size = UDim2.new(1, -(24 + pctW), 0, P.TextSize + 6)
				else
					lab.Position = UDim2.fromOffset(12, 0)
					lab.Size = UDim2.new(1, -24, 1, 0)
				end
			end
			if pct and pct:IsA("TextLabel") then
				pct.Visible = withBar
				pct.Text = if withBar and fraction then string.format("%d%%", math.floor(fraction * 100 + 0.5)) else ""
			end
			if barBg and barBg:IsA("Frame") then
				barBg.Visible = withBar
				local fill = barBg:FindFirstChild("Fill")
				if fill and fill:IsA("Frame") then
					fill.Size = UDim2.fromScale(math.clamp(fraction or 0, 0, 1), 1)
					fill.BackgroundColor3 = style.Stroke
				end
			end
			f.Visible = true
			hideLater(f, style.Hold)
		end

		-- legacy (no Phase): the v33 texts
		local function showLegacyAtmRaidHud(payload: any)
			local success = (payload :: any).Success == true
			local raided = (payload :: any).Raided == true
			local cd = math.max(0, math.floor(tonumber((payload :: any).CooldownRemaining) or 0))
			local stolen = math.floor(tonumber((payload :: any).Stolen) or 0)
			local victim = tostring((payload :: any).VictimName or "")
			local text: string
			if success then
				text = string.format("ATM RAID +$%s%s · cooldown 1m", formatCash(stolen), if victim ~= "" then (" from " .. victim) else "")
			elseif raided then
				local thief = tostring((payload :: any).ThiefName or "")
				if thief ~= "" then
					text = string.format("ATM RAIDED −10%% by %s (−$%s)", thief, formatCash(stolen))
				else
					text = string.format("ATM RAIDED −10%% (−$%s)", formatCash(stolen))
				end
			else
				text = string.format("ATM raid cooldown — %ds", cd)
			end
			local base = if success then GREEN elseif raided then PHASE_STYLE.Robbed else AMBER
			local hold = if success or raided then 5.5 else math.clamp(cd, 2, 8)
			showPill(text, { Stroke = base.Stroke, Text = base.Text, Hold = hold, Bar = false }, nil)
		end

		local function phaseText(payload: any, phase: string): string
			local text = if typeof(payload.Text) == "string" and payload.Text ~= "" then payload.Text else nil
			local progress = tonumber(payload.HoldProgress)
			local need = tonumber(payload.HoldNeed)
			if phase == "Holding" then
				return text or string.format("ROBBING %s's ATM — don't get hit!", tostring(payload.VictimName or "their"))
			elseif phase == "Alarm" then
				local base = text or string.format("%s is robbing your ATM!", tostring(payload.ThiefName or "Someone"))
				if progress and need and not string.find(base, "%d/%d") then
					base ..= string.format(" %d/%ds", math.floor(progress), math.floor(need))
				end
				return base
			end
			return text or tostring(payload.Reason or phase)
		end

		local function showAtmRaidHud(payload: any)
			if typeof(payload) ~= "table" then
				return
			end
			local phase = (payload :: any).Phase
			local style = if typeof(phase) == "string" then PHASE_STYLE[phase] else nil
			if style then
				local need = tonumber(payload.HoldNeed) or 0
				local fraction = if need > 0 then math.clamp((tonumber(payload.HoldProgress) or 0) / need, 0, 1) else nil
				showPill(phaseText(payload, phase :: string), style, fraction)
			elseif phase == nil then
				showLegacyAtmRaidHud(payload)
			end
		end

		Remotes.BindEvent(Constants.RemoteNames.AtmRaidStateUpdate, showAtmRaidHud)
	end

	-- ATM-cluster premium pads → PromptGamePass / PromptProduct (server-validated)
	Remotes.BindEvent(Constants.RemoteNames.PromptPremiumPad, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		local kind = payload.Kind
		local key = payload.Key
		if typeof(kind) ~= "string" or typeof(key) ~= "string" then
			return
		end
		if kind ~= "GamePass" and kind ~= "DevProduct" then
			return
		end
		-- F1: an owned pad never prompts (the server checks first; this covers a WE_Ent_* that landed in between)
		if offerOwned(kind, key) then
			toast("Already owned", "Info")
			refreshPremiumPads()
			return
		end
		if kind == "GamePass" then
			promptGamePass(key, "pad")
		else
			promptDevProduct(key, "pad")
		end
	end)

	if order == 0 then
		UIUtil.EmptyState(list, "Shop catalog empty — MonetizationConfig has no DevProducts / GamePasses.", 0)
	end

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return menuOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})

	-- Gold in the header (WE_Gold replicates from the server; EconomyUpdate as a backup)
	player:GetAttributeChangedSignal("WE_Gold"):Connect(refreshGold)
	Remotes.BindEvent(Constants.RemoteNames.EconomyUpdate, function(payload: any)
		if typeof(payload) == "table" and typeof(payload.Gold) == "number" and player:GetAttribute("WE_Gold") == nil then
			local chip, lab = goldChip, goldText
			if chip and lab then
				chip.Visible = payload.Gold > 0
				lab.Text = formatCash(payload.Gold) .. " GOLD"
			end
		end
	end)
	refreshGold()

	local shopKey: Enum.KeyCode = HudConfig.Keys.Shop or Enum.KeyCode.P
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == shopKey then
			setOpen(not menuOpen)
		end
	end)
end





function ShopController.Toggle()
	-- the tap that just closed the Shop through its dim lands on the Shop tile too: stay closed
	local sh = shell
	if not menuOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not menuOpen)
end

--[[ v70: the cash pill's + (HUDController.BindShopOpener → UIController): SUPPLY tab, Cash Pack Mega highlighted.
	Visual only — no toast, no purchase prompt. ]]
function ShopController.OpenCashPacks()
	pendingCashMegaHighlight = true
	setOpen(true, "hud_plus") -- F2: the rows bought from here report source "hud_plus"
end

--[[ v69: open on a tab ("Supply" | "Weapons"). The Armory terminal lands on Weapons via PromptTriggered. ]]
function ShopController.OpenTab(tab: string)
	selectTab(tab)
	setOpen(true)
end

function ShopController.OpenWeapons()
	ShopController.OpenTab("Weapons")
end

function ShopController.Open()
	setOpen(true)
end

function ShopController.Close()
	setOpen(false)
end

function ShopController.IsOpen(): boolean
	return menuOpen
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="210">
            <Properties>
              <string name="Name">TerritoryController</string>
              <string name="Source"><![CDATA[--!strict
--[[ Territory HUD — v70 "clean screen" (spec §3.4 + the E row of §9; was Phase 5/7's capture card, alert label,
	always-on TERRITORIES list and RADAR badge).

	* CAPTURE BAR: a top-centre stack item ("Capture", slot Progress — HudLayout.RegisterTopStack) built from the
	  shared ProgressPill (320×44 v): "CAPTURING RADAR HILL  62%". It reads only TerritoryStateUpdate.LocalCapture,
	  so it works the same for land outposts and the v70 naval outposts (oil rigs taken by a boat's driver or from
	  the deck) and stays visible while Driving. Contested → amber edge + "CONTESTED · NAME" and the nation-colour
	  pulse (contestedPulseActive); Protected → blue "PROTECTED · NAME" (capture slowed).
	* F3 "Empire Tax +N%" → one silent Info toast through NotificationController when the server's WE_EmpireTaxPct
	  (EconomyConfig.OutpostIncomeBuff.Attribute) rises or falls to N > 0 (it replaced "Outposts held: N"). Skipped
	  when a server toast named Empire Tax within TAX.SkipWindow (2 s) of the change (the capture / loss toasts carry
	  the %), and while joining. The old mid-screen TerritoryAlert label and its 50 % / 90 % lines are gone.
	* TERRITORY LIST → a dropdown under the compass chip, opened by HudLayout.Signals.CompassTapped (the compass chip
	  and the TopStrip Empire Tax chip both emit it; it was an always-on panel over the rail). It is a registered
	  panel ("Territories"): one panel at a time and Modal while open, so the combat buttons hide and the list may
	  use the right-hand column down to the jump button. ✕, a tap outside, another panel, Driving or death close it.
	  Header "Empire Tax +N%" (gold) while N > 0, else "TERRITORIES".
	* F10 Home Outposts: the list shows only the player's OWN one (TerritoryConfig.Starter rows, PlotId = the own
	  plot from BaseStateUpdate / PlayerStateUpdate); other plots' Home Outposts are never listed or counted.
	* RADAR HILL reveal → the HudLayout flag "Radar" (CompassController draws the purple dot on the chip) + the
	  enemy Highlights (kept) + a "RADAR ON" row in the list.
	  Streaming 2, lane C2 (spec F7): under instance streaming this client holds only the characters inside its stream
	  radius (StreamingMinRadius 64 on a phone short of memory), not all 550 studs of the reveal. While streaming is on
	  the server adds RadarTargets (UserId + position) to the payload: a revealed character this client holds keeps the
	  Highlight; one it does not hold gets a radar ping instead: a thin column (a Beam between two Attachments on
	  Workspace.Terrain, which never streams out) rising from the server's position, sized in real px from the camera
	  (5 x 64 px at any range), at most RADAR_PING.Max, nearest first, updated with the 5 Hz radar tick. No text and no
	  BillboardGui (a world label caps MaxDistance at 40 and these players are always farther than 64), never
	  AlwaysOnTop, no connections. With streaming off there is no list and the reveal is exactly the old one.
	  F22: a flag diamond counts as present only while it IsDescendantOf(Workspace) (its Parent stays set when the flag
	  streams out).
	* W3 step 2 lane U0 — ONE AlwaysOnTop label: TerritoryService makes a flag's WE_FlagBillboard diamond draw through
	  walls while the zone is contested (WorldLabel.SetRole "contested"). While an objective marker is on screen
	  (ObjectiveMarker.OnTop(): a mission GO line, or the ConsoleWaypoint line it yields to) this client turns that
	  off LOCALLY and restores the server's choice (the role) when the marker goes. Checked at 4 Hz (diamonds found by
	  the capture-zone tags, rescanned once a second only while a marker is up; no whole-tree scan).
	Display only: capture, ownership and payouts are server-side (TerritoryService).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- ships with the place (Rojo); bounded wait anyway
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local WorldLabelConfig = require(Shared.Configs.WorldLabelConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HudIcons = require(script.Parent.Parent.Modules.HudIcons)
local ProgressPill = require(script.Parent.Parent.Modules.ProgressPill)
local ObjectiveMarker = require(script.Parent.Parent.Modules.ObjectiveMarker)
local NotificationController = require(script.Parent.NotificationController)

local TerritoryController = {}

local player = Players.LocalPlayer
local _gui: ScreenGui? = nil

-- capture bar
local capture: ProgressPill.Pill? = nil
local captureActive = false
-- v38: contested dual-color pulse cache (v70: amber when the server sends no nation colours)
local contestedPulseActive = false
local contestedColA: Color3? = nil
local contestedColB: Color3? = nil

-- radar
local radarActive = false
local radarRadius = 550
local radarHighlights: { [number]: Highlight } = {}
-- lane C2 (F7): the server's reveal list (only while streaming is on; nil = none: the Highlight loop alone decides)
local radarTargets: { Types.RadarTargetPayload }? = nil
local radarTargetsAt = 0 -- os.clock() when that list arrived
type Ping = { Base: Attachment, Top: Attachment, Beam: Beam, Pos: Vector3, Width: number, Height: number }
local radarPings: { [number]: Ping } = {} -- UserId -> its ping
local pingWanted: { [number]: boolean } = {} -- reused by every radar tick (no allocation per tick)
-- The ping's look. A Beam has no MaxDistance and draws at any range, hidden by the world like any part; its size is
-- set in REAL px from the camera (studs = px x distance x view height per px), so a ping 530 studs away reads as well
-- as one at 80. Candidates for TerritoryConfig / HudConfig (lane C2 may edit only its three files).
local RADAR_PING = {
	Max = 5, -- pings at once (the server sends nearest first); spec lane C2: <= 5, the CLAUDE.md outpost label cap
	WidthPx = 5, -- real px at the bottom (FaceCamera), a quarter of that at the top
	HeightPx = 64, -- real px tall, upward from the reported root position
	MinWidthStuds = 1, -- floors for a very near ping
	MinHeightStuds = 12,
	ResizeRatio = 0.08, -- rewrite the size only when it is off by more than this (camera moved)
	ColorBase = Color3.fromRGB(200, 80, 80), -- the reveal Highlight's fill ...
	ColorTop = Color3.fromRGB(255, 180, 80), -- ... and outline
	TransparencyBase = 0.15,
	TransparencyTop = 0.85,
	LightEmission = 1,
	MoveStuds = 0.5, -- re-place a ping only when its target moved this far
	StaleSeconds = 5, -- no fresh list for this long (a holder gets one about every 1 s): the pings go
}

-- F3 Empire Tax toast + list header (see the header comment)
local BUFF = EconomyConfig.OutpostIncomeBuff
local TAX = {
	Attr = (BUFF and BUFF.Attribute) or "WE_EmpireTaxPct",
	Name = (BUFF and BUFF.DisplayName) or "Empire Tax",
	SkipWindow = 2, -- s: a server toast naming Empire Tax this close to the change already said it
	Settle = 0.6, -- s: decide this long after the change, so a server toast landing just after the attribute counts
	JoinQuietSeconds = 10, -- s after the first TerritoryStateUpdate: re-planted claims / the Home Outpost never toast
	Color = ((HudConfig.TopStrip :: any).EmpireTax and (HudConfig.TopStrip :: any).EmpireTax.Color) or HudConfig.Colors.Gold,
}
local taxPct = 0
local taxBaselineAt: number? = nil -- os.clock() of the first TerritoryStateUpdate (nil: still joining)
local taxToken = 0
local lastServerTaxToastAt = -math.huge

-- F10: the own plot (BaseStateUpdate / PlayerStateUpdate), for the own-Home-Outpost-only list
local myPlotId: number? = nil

-- dropdown list (panel "Territories")
local PANEL_ID = "Territories"
local listPanel: Frame? = nil
local listScroll: ScrollingFrame? = nil
local listCount: TextLabel? = nil
local listTitle: TextLabel? = nil
local listDim: Frame? = nil
local listOpen = false
local listDirty = true
local lastPayload: Types.TerritoryStatePayload? = nil

-- Dropdown geometry, v (the gui carries HudLayout's MobileScale). Candidates for HudConfig.TopStrip.Compass.List.
local LIST = {
	Width = 300,
	WidthTouch = 340, -- room for 20 v names ("Coastal Oil Bravo") beside a 20 v tag
	RowH = 30,
	Gap = 6, -- under the compass chip
	PadX = 12,
	PadBottom = 8,
	TitleSize = 20,
	TextSize = 16, -- desktop (the HUD scale there keeps it >= 14 real px)
	TextSizeTouch = 20, -- 14 real px at the phone scale 0.70 (CLAUDE.md text floor; was 16 v = 11.2 px)
	CountWidth = 56, -- "3/12" right of the title
	TagWidth = 104,
	TagWidthTouch = 112, -- "CONTESTED" at 20 v
	DotSize = 10,
	MinHeight = 140,
	-- touch: stay above Roblox's jump button (top at H − 90 real, see HudConfig.TouchCombat) plus a 10 px gap
	JumpClearPx = 100,
	Bg = HudConfig.Colors.PillBg,
	BgTransparency = 0.12,
	Corner = 14,
}

local COL = {
	You = HudConfig.Colors.Positive,
	Enemy = HudConfig.Colors.Negative,
	Clan = Color3.fromRGB(120, 180, 255),
	Guarded = Color3.fromRGB(255, 150, 60),
	Neutral = HudConfig.Colors.Muted,
	Contested = HudConfig.TopStack.Progress.ContestedColor,
	Protected = Color3.fromRGB(140, 180, 255),
	Radar = HudConfig.TopStrip.Compass.RadarDot,
}

local function textSizeV(): number
	return if HudLayout.IsTouch() then LIST.TextSizeTouch else LIST.TextSize
end

local function tagWidthV(): number
	return if HudLayout.IsTouch() then LIST.TagWidthTouch else LIST.TagWidth
end

local function touchMinV(): number
	if HudLayout.IsTouch() then
		-- 64 v = 44.8 real px at the smallest HUD scale (0.70)
		return math.max(HudConfig.Hotbar.Slot, math.ceil(HudConfig.Scale.TouchMinPx / HudConfig.Scale.Min))
	end
	return 44
end

---------------------------------------------------------------------------------------------------------------
-- radar (Radar Hill reveal) — the badge became the "Radar" flag; lane C2 adds the pings while streaming is on
---------------------------------------------------------------------------------------------------------------

local function destroyPing(userId: number)
	local ping = radarPings[userId]
	if ping then
		radarPings[userId] = nil
		ping.Beam:Destroy()
		ping.Base:Destroy()
		ping.Top:Destroy()
	end
end

local function clearRadarPings()
	for userId in pairs(radarPings) do
		destroyPing(userId)
	end
end

local function clearRadarHighlights()
	for userId, h in pairs(radarHighlights) do
		if h and h.Parent then
			h:Destroy()
		end
		radarHighlights[userId] = nil
	end
	clearRadarPings() -- lane C2: the pings go with the Highlights (none exist while streaming is off)
end

-- lane C2: studs per real px per stud of distance for this camera (vertical view), and the camera's position
local function pingScale(): (number, Vector3?)
	local cam = Workspace.CurrentCamera
	local fov = if cam then cam.FieldOfView else 70
	local viewH = if cam then cam.ViewportSize.Y else 0
	if typeof(fov) ~= "number" or fov <= 1 or fov >= 179 then
		fov = 70
	end
	if typeof(viewH) ~= "number" or viewH < 100 then
		viewH = 390 -- a phone in landscape
	end
	return 2 * math.tan(math.rad(fov) * 0.5) / viewH, if cam then cam.CFrame.Position else nil
end

-- lane C2: a ping for userId at pos (Terrain's frame is the world frame), RADAR_PING.WidthPx x HeightPx real px as
-- seen from camPos; built once, then only moved / resized
local function placePing(userId: number, pos: Vector3, terrain: Terrain, perPx: number, camPos: Vector3?)
	local d = if camPos then math.max((camPos - pos).Magnitude, 1) else radarRadius
	local width = math.max(RADAR_PING.WidthPx * perPx * d, RADAR_PING.MinWidthStuds)
	local height = math.max(RADAR_PING.HeightPx * perPx * d, RADAR_PING.MinHeightStuds)
	local ping: Ping? = radarPings[userId]
	if ping and ping.Base.Parent ~= terrain then
		destroyPing(userId) -- someone removed it: build it again
		ping = nil
	end
	if ping then
		local moved = (ping.Pos - pos).Magnitude >= RADAR_PING.MoveStuds
		local resized = math.abs(width - ping.Width) > ping.Width * RADAR_PING.ResizeRatio
		if resized then
			ping.Beam.Width0 = width
			ping.Beam.Width1 = width * 0.25
			ping.Width = width
			ping.Height = height
		end
		if moved then
			ping.Base.Position = pos
			ping.Pos = pos
		end
		if moved or resized then
			ping.Top.Position = pos + Vector3.new(0, ping.Height, 0)
		end
		return
	end
	local base = Instance.new("Attachment")
	base.Name = "WE_RadarPingBase"
	base.Position = pos
	base.Parent = terrain
	local top = Instance.new("Attachment")
	top.Name = "WE_RadarPingTop"
	top.Position = pos + Vector3.new(0, height, 0)
	top.Parent = terrain
	local beam = Instance.new("Beam")
	beam.Name = "WE_RadarPing"
	beam.Attachment0 = base
	beam.Attachment1 = top
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Width0 = width
	beam.Width1 = width * 0.25
	beam.LightEmission = RADAR_PING.LightEmission
	beam.LightInfluence = 0
	beam.Color = ColorSequence.new(RADAR_PING.ColorBase, RADAR_PING.ColorTop)
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, RADAR_PING.TransparencyBase),
		NumberSequenceKeypoint.new(1, RADAR_PING.TransparencyTop),
	})
	beam:SetAttribute("UserId", userId)
	beam.Parent = terrain
	radarPings[userId] = { Base = base, Top = top, Beam = beam, Pos = pos, Width = width, Height = height }
end

-- lane C2: a character this client holds (under streaming a revealed player may be absent, or parented to nil)
local function heldHere(char: Model?): boolean
	return char ~= nil and char:IsDescendantOf(Workspace)
end

--[[ lane C2 (F7): pings for the server's revealed players that have no Highlight and whose character this client
	does not hold, nearest first, at most RADAR_PING.Max. Everything else loses its ping. ]]
local function updatePings(highlighted: { [number]: boolean })
	table.clear(pingWanted)
	local list = radarTargets
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if list and terrain and os.clock() - radarTargetsAt <= RADAR_PING.StaleSeconds then
		local perPx, camPos = pingScale()
		local shown = 0
		for _, t in ipairs(list) do
			if shown >= RADAR_PING.Max then
				break
			end
			local userId = if typeof(t) == "table" then t.UserId else nil
			local pos = if typeof(t) == "table" then t.Pos else nil
			if typeof(userId) == "number" and typeof(pos) == "Vector3" and userId ~= player.UserId and not highlighted[userId] then
				local other = Players:GetPlayerByUserId(userId)
				if other and not heldHere(other.Character) then
					placePing(userId, pos, terrain, perPx, camPos)
					pingWanted[userId] = true
					shown += 1
				end
			end
		end
	end
	for userId in pairs(radarPings) do
		if not pingWanted[userId] then
			destroyPing(userId)
		end
	end
end

local function ensureHighlight(target: Model): Highlight
	local existing = target:FindFirstChild("WE_RadarHighlight")
	if existing and existing:IsA("Highlight") then
		return existing
	end
	local h = Instance.new("Highlight")
	h.Name = "WE_RadarHighlight"
	h.FillColor = Color3.fromRGB(200, 80, 80)
	h.OutlineColor = Color3.fromRGB(255, 180, 80)
	h.FillTransparency = 0.65
	h.OutlineTransparency = 0.15
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = target
	return h
end

local function updateRadar()
	if not radarActive then
		clearRadarHighlights()
		return
	end
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not myRoot then
		clearRadarHighlights()
		return
	end

	-- lane C2: with the server's list (streaming on) a Highlight goes only on a character this client holds
	local streamView = radarTargets ~= nil
	local seen: { [number]: boolean } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if char and root and humanoid and humanoid.Health > 0 and (not streamView or heldHere(char)) then
				local dist = (root.Position - myRoot.Position).Magnitude
				if dist <= radarRadius then
					seen[other.UserId] = true
					local h = ensureHighlight(char)
					radarHighlights[other.UserId] = h
				end
			end
		end
	end
	for userId, h in pairs(radarHighlights) do
		if not seen[userId] then
			if h and h.Parent then
				h:Destroy()
			end
			radarHighlights[userId] = nil
		end
	end
	-- lane C2: pings for the revealed players this client does not hold (never while streaming is off)
	if streamView then
		updatePings(seen)
	elseif next(radarPings) ~= nil then
		clearRadarPings()
	end
end

---------------------------------------------------------------------------------------------------------------
-- W3 step 2 lane U0: the contested diamond yields to the one objective marker (see the header)
---------------------------------------------------------------------------------------------------------------

local DIAMOND = {
	Name = "WE_FlagBillboard", -- TerritoryService's diamond over <TerritoryId>_Flag
	CheckSeconds = 0.25, -- is an objective marker up? (4 Hz; CLAUDE.md UI refresh <= 10 Hz)
	RescanSeconds = 1, -- while one is up: find diamonds that streamed in since
}
local ROLE_ATTR = WorldLabelConfig.RoleAttribute
local MARKER_TAGS = { Constants.Tags.CaptureZone, Constants.Tags.Territory }
local diamonds: { [BillboardGui]: boolean } = setmetatable({}, { __mode = "k" }) :: any
-- F22 (lane C2): diamonds whose flag was streamed out when the yield last changed
local diamondsOut: { [BillboardGui]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local markerOnTop = false
local diamondAccum = 0
local rescanAccum = 0

-- what the server wants (WorldLabel.SetRole wrote the role before AlwaysOnTop), unless an objective marker is up
local function diamondOnTop(bb: BillboardGui): boolean
	if markerOnTop then
		return false
	end
	local role = bb:GetAttribute(ROLE_ATTR)
	return type(role) == "string" and WorldLabelConfig.AlwaysOnTopRoles[role] == true
end

local function applyDiamond(bb: BillboardGui)
	local want = diamondOnTop(bb)
	if bb.AlwaysOnTop ~= want then
		bb.AlwaysOnTop = want
	end
end

local function watchDiamond(bb: BillboardGui)
	if diamonds[bb] then
		applyDiamond(bb)
		return
	end
	diamonds[bb] = true
	-- a contest starting replicates AlwaysOnTop = true (and the role): yield again at once while a marker is up
	bb:GetPropertyChangedSignal("AlwaysOnTop"):Connect(function()
		if markerOnTop and bb.AlwaysOnTop then
			bb.AlwaysOnTop = false
		end
	end)
	bb:GetAttributeChangedSignal(ROLE_ATTR):Connect(function()
		if markerOnTop and bb.AlwaysOnTop then
			bb.AlwaysOnTop = false
		end
	end)
	applyDiamond(bb)
end

-- the diamonds on this client (StreamingEnabled: only nearby zones), found through the capture-zone tags
local function rescanDiamonds()
	for _, tag in ipairs(MARKER_TAGS) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			local tid = inst:GetAttribute("TerritoryId")
			local parent = inst.Parent
			if type(tid) == "string" and parent and inst:IsA("BasePart") then
				local flag = parent:FindFirstChild(tid .. "_Flag")
				local bb = flag and flag:FindFirstChild(DIAMOND.Name)
				if bb and bb:IsA("BillboardGui") then
					watchDiamond(bb)
				end
			end
		end
	end
end

local function syncDiamonds(elapsed: number)
	local on = ObjectiveMarker.OnTop()
	if on ~= markerOnTop then
		markerOnTop = on
		rescanAccum = 0
		if on then
			rescanDiamonds()
		end
		for bb in pairs(diamonds) do
			if bb:IsDescendantOf(Workspace) then -- F22: Parent stays set when the flag streams out
				applyDiamond(bb)
				diamondsOut[bb] = nil
			else
				diamondsOut[bb] = true -- F22: set once it has streamed back in (below)
			end
		end
		return
	end
	-- F22 (lane C2): a diamond that was streamed out when the yield changed takes the current state once it is back
	-- (a local AlwaysOnTop may survive the stream cycle; usually an empty table)
	if next(diamondsOut) ~= nil then
		for bb in pairs(diamondsOut) do
			if bb:IsDescendantOf(Workspace) then
				diamondsOut[bb] = nil
				applyDiamond(bb)
			end
		end
	end
	if on then
		rescanAccum += elapsed
		if rescanAccum >= DIAMOND.RescanSeconds then
			rescanAccum = 0
			rescanDiamonds()
		end
	end
end

-- test hook (client sims): the yield state right now
function TerritoryController._DiamondYield(): boolean
	return markerOnTop
end

---------------------------------------------------------------------------------------------------------------
-- territory dropdown
---------------------------------------------------------------------------------------------------------------

type RowInfo = { Name: string, Tag: string, Color: Color3, NameColor: Color3, Rank: number }

local function describe(entry: Types.TerritoryEntryPayload, capturingId: string?, capturePct: number): RowInfo
	local name = tostring(entry.DisplayName or entry.Id)
	if capturingId ~= nil and entry.Id == capturingId then
		return { Name = name, Tag = string.format("%d%%", capturePct), Color = HudConfig.Colors.Gold, NameColor = HudConfig.Colors.White, Rank = 1 }
	end
	if entry.Contested then
		return { Name = name, Tag = "CONTESTED", Color = COL.Contested, NameColor = HudConfig.Colors.White, Rank = 2 }
	end
	local owner = entry.OwnerType
	if owner == "Player" and entry.OwnerUserId == player.UserId then
		return { Name = name, Tag = "YOU", Color = COL.You, NameColor = HudConfig.Colors.White, Rank = 0 }
	elseif owner == "Player" then
		return { Name = name, Tag = "ENEMY", Color = COL.Enemy, NameColor = HudConfig.Colors.White, Rank = 3 }
	elseif owner == "Clan" then
		return { Name = name, Tag = "CLAN", Color = COL.Clan, NameColor = HudConfig.Colors.White, Rank = 3 }
	elseif owner == "NPC" then
		return { Name = name, Tag = "GUARDED", Color = COL.Guarded, NameColor = HudConfig.Colors.White, Rank = 4 }
	end
	return { Name = name, Tag = "NEUTRAL", Color = COL.Neutral, NameColor = COL.Neutral, Rank = 5 }
end

-- F10: the plot a Home Outpost row belongs to (TerritoryConfig.Starter rows: IsStarter + PlotId, or the Starter_P<n>
-- id when this client's config has no such row); nil = not a Home Outpost, -1 = a Home Outpost of unknown plot
local function starterPlotOf(id: string): number?
	local st = TerritoryConfig.Starter
	local prefix = if st and type(st.IdPrefix) == "string" and st.IdPrefix ~= "" then st.IdPrefix else "Starter_P"
	local def = TerritoryConfig.Territories[id]
	local named = string.sub(id, 1, #prefix) == prefix
	if not (TerritoryConfig.IsStarterDef(def) or named) then
		return nil
	end
	local fromDef = if def then tonumber(def.PlotId) else nil
	return fromDef or (if named then tonumber(string.sub(id, #prefix + 1)) else nil) or -1
end

--[[ F10, pure (exported for the client sim): does the dropdown list this row? Every zone, except Home Outposts: only
	the one on the player's own plot (myPlot); while the plot is not known yet, only one the player holds. ]]
function TerritoryController.Lists(entry: Types.TerritoryEntryPayload, myPlot: number?, myUserId: number): boolean
	local plot = starterPlotOf(tostring(entry.Id))
	if plot == nil then
		return true
	end
	if myPlot ~= nil then
		return plot == myPlot
	end
	return entry.OwnerType == "Player" and entry.OwnerUserId == myUserId
end

local function listed(payload: Types.TerritoryStatePayload?): { Types.TerritoryEntryPayload }
	local out = {}
	for _, entry in ipairs(if payload then payload.Territories or {} else {}) do
		if typeof(entry) == "table" and TerritoryController.Lists(entry, myPlotId, player.UserId) then
			table.insert(out, entry)
		end
	end
	return out
end

local function rowCount(payload: Types.TerritoryStatePayload?): number
	if not payload then
		return 1
	end
	local n = #listed(payload)
	if n == 0 then
		n = 1 -- the empty-state line
	end
	if payload.RadarReveal == true then
		n += 1
	end
	return n
end

local function makeText(parent: Instance, name: string, text: string, color: Color3): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Font = HudConfig.Fonts.Body
	t.TextSize = textSizeV()
	t.TextColor3 = color
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextTruncate = Enum.TextTruncate.AtEnd
	t.Text = text
	t.Active = false
	t.ZIndex = 7
	t.Parent = parent
	return t
end

local function rebuildList()
	local scroll = listScroll
	local payload = lastPayload
	if not scroll then
		return
	end
	listDirty = false
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local list = listed(payload)
	local lc = if payload then payload.LocalCapture else nil
	local capId: string? = nil
	local capPct = 0
	if lc and lc.Capturing and lc.TerritoryId then
		capId = lc.TerritoryId
		capPct = math.floor(math.clamp(tonumber(lc.Progress) or 0, 0, 1) * 100)
	end

	local order = 0
	if payload and payload.RadarReveal == true then
		local r = makeText(scroll, "RadarRow", string.format("RADAR ON · %d studs", math.floor(radarRadius)), COL.Radar)
		r.Size = UDim2.new(1, 0, 0, LIST.RowH)
		r.LayoutOrder = order
		order += 1
	end

	local rows: { RowInfo } = {}
	local owned = 0
	for _, entry in ipairs(list) do
		local info = describe(entry, capId, capPct)
		if info.Tag == "YOU" then
			owned += 1
		end
		table.insert(rows, info)
	end
	table.sort(rows, function(a: RowInfo, b: RowInfo): boolean
		if a.Rank ~= b.Rank then
			return a.Rank < b.Rank
		end
		return a.Name < b.Name
	end)

	if #rows == 0 then
		local e = makeText(scroll, "Empty", "No territories yet — explore the map.", COL.Neutral)
		e.Size = UDim2.new(1, 0, 0, LIST.RowH)
		e.LayoutOrder = order
	end
	for _, info in ipairs(rows) do
		local row = Instance.new("Frame")
		row.Name = "Row_" .. info.Name
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, LIST.RowH)
		row.LayoutOrder = order
		row.Active = false
		row.ZIndex = 6
		order += 1

		local dot = Instance.new("Frame")
		dot.Name = "Dot"
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.new(0, 0, 0.5, 0)
		dot.Size = UDim2.fromOffset(LIST.DotSize, LIST.DotSize)
		dot.BackgroundColor3 = info.Color
		dot.BorderSizePixel = 0
		dot.Active = false
		dot.ZIndex = 7
		dot.Parent = row
		UIUtil.Corner(dot, math.ceil(LIST.DotSize / 2))

		local nameLabel = makeText(row, "Name", info.Name, info.NameColor)
		nameLabel.Position = UDim2.fromOffset(LIST.DotSize + 8, 0)
		nameLabel.Size = UDim2.new(1, -(LIST.DotSize + 8 + tagWidthV()), 1, 0)

		local tag = makeText(row, "Tag", info.Tag, info.Color)
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.fromScale(1, 0)
		tag.Size = UDim2.new(0, tagWidthV(), 1, 0)
		tag.TextXAlignment = Enum.TextXAlignment.Right

		row.Parent = scroll
	end

	local cnt = listCount
	if cnt then
		cnt.Text = string.format("%d/%d", owned, #list)
	end
end

local function headerV(): number
	return touchMinV()
end

-- Position / size in the gui's v space, right-aligned under the compass chip (HudLayout.GetRect("Compass")),
-- down to the jump button on touch. Rects are AbsolutePosition space, like HudLayout's.
local function placeList()
	local f = listPanel
	local screen = _gui
	if not (f and screen) then
		return
	end
	local s = HudLayout.Scale()
	if s <= 0 then
		s = 1
	end
	local content = HudLayout.ContentRect()
	local guiPos = screen.AbsolutePosition
	local cpos, csize = HudLayout.GetRect("Compass")
	local right: number
	local top: number
	-- use the chip only when it really sits in the topbar row (its bottom at or above the content top);
	-- otherwise (no chip yet, a fallback placement) hang the list from the content's top-right corner
	local chipBottom = cpos.Y + csize.Y
	if csize.X > 1 and csize.Y > 1 and chipBottom <= content.Min.Y + HudConfig.TopStack.Top * s then
		right = cpos.X + csize.X
		top = math.max(chipBottom, content.Min.Y) + LIST.Gap * s
	else
		right = content.Max.X - HudConfig.Edge * s
		top = content.Min.Y + HudConfig.TopStack.Top * s
	end
	right = math.min(right, content.Max.X)
	local bottom = content.Max.Y - (if HudLayout.IsTouch() then LIST.JumpClearPx else HudConfig.Edge * s)
	local availV = math.max(LIST.MinHeight, (bottom - top) / s)
	local widthV = math.max(200, math.min(if HudLayout.IsTouch() then LIST.WidthTouch else LIST.Width, (right - content.Min.X) / s - HudConfig.Edge))
	-- whole rows only (the rest scrolls), so no row is ever cut in half at the bottom edge
	local hv = headerV()
	local fitRows = math.max(1, math.floor((availV - hv - LIST.PadBottom) / LIST.RowH))
	local shown = math.min(rowCount(lastPayload), fitRows)
	f.Size = UDim2.fromOffset(widthV, hv + shown * LIST.RowH + LIST.PadBottom)
	f.Position = UDim2.fromOffset((right - guiPos.X) / s, (top - guiPos.Y) / s)
end

local function setListOpen(open: boolean)
	if listOpen == open then
		return
	end
	listOpen = open
	local f = listPanel
	local dim = listDim
	if open then
		if listDirty then
			rebuildList()
		end
		placeList()
	end
	if f then
		f.Visible = open
	end
	if dim then
		dim.Visible = open
	end
	if open then
		HudLayout.PanelOpened(PANEL_ID)
	else
		HudLayout.PanelClosed(PANEL_ID)
	end
end

function TerritoryController.IsOpen(): boolean
	return listOpen
end

function TerritoryController.Close()
	setListOpen(false)
end

function TerritoryController.Toggle()
	setListOpen(not listOpen)
end

local function buildList(screen: ScreenGui)
	local f = Instance.new("Frame")
	f.Name = "TerritoryList"
	f.AnchorPoint = Vector2.new(1, 0)
	f.Position = UDim2.new(1, -HudConfig.Edge, 0, HudConfig.TopStack.Top)
	f.Size = UDim2.fromOffset(LIST.Width, LIST.MinHeight)
	f.BackgroundColor3 = LIST.Bg
	f.BackgroundTransparency = LIST.BgTransparency
	f.BorderSizePixel = 0
	f.Active = true -- taps on the list never reach the world
	f.Visible = false
	f.ZIndex = 5
	f.Parent = screen
	UIUtil.Corner(f, LIST.Corner)
	local st = UIUtil.Stroke(f, HudConfig.Colors.PillStroke, 2)
	st.Transparency = HudConfig.Colors.PillStrokeTransparency
	listPanel = f

	local hv = headerV()
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(LIST.PadX, 0)
	-- up to the count (F3: "Empire Tax +50%" is longer than "TERRITORIES")
	title.Size = UDim2.new(1, -(LIST.PadX + LIST.CountWidth + hv + 4), 0, hv)
	title.Font = HudConfig.Fonts.Display
	title.TextSize = LIST.TitleSize
	title.TextColor3 = HudConfig.Colors.White
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = "TERRITORIES"
	title.Active = false
	title.ZIndex = 7
	title.Parent = f
	UIUtil.TextOutline(title, 1.4)
	listTitle = title

	local count = makeText(f, "Count", "0/0", HudConfig.Colors.Muted)
	count.AnchorPoint = Vector2.new(1, 0)
	count.Position = UDim2.new(1, -(hv + 4), 0, 0)
	count.Size = UDim2.new(0, LIST.CountWidth, 0, hv)
	count.TextXAlignment = Enum.TextXAlignment.Right
	listCount = count

	-- ✕: transparent touch-size hit area around a small rounded face (same look as the panels' close button)
	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.fromScale(1, 0)
	close.Size = UDim2.fromOffset(hv, hv)
	close.BackgroundTransparency = 1
	close.BorderSizePixel = 0
	close.AutoButtonColor = false
	close.Text = ""
	close.Active = true
	close.ZIndex = 7
	close.Parent = f
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromScale(0.6, 0.6)
	face.BackgroundColor3 = Color3.fromRGB(44, 48, 54)
	face.BorderSizePixel = 0
	face.Active = false
	face.ZIndex = 7
	face.Parent = close
	UIUtil.Corner(face, 10)
	HudIcons.Make("Close", face, {
		Size = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 8,
		Color = HudConfig.Colors.White,
		Fill = Color3.fromRGB(44, 48, 54),
	})
	close.Activated:Connect(function()
		setListOpen(false)
	end)
	HudLayout.AssertTouchTarget(close, "TerritoryList.Close")

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(LIST.PadX, hv)
	scroll.Size = UDim2.new(1, -LIST.PadX * 2, 1, -(hv + LIST.PadBottom))
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ZIndex = 6
	scroll.Parent = f
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 0)
	layout.Parent = scroll
	listScroll = scroll

	-- tap / click outside the list closes it (invisible catcher: the world stays visible, Active = false)
	local dim = UIUtil.MakeModalDim(screen, function()
		if listOpen then
			setListOpen(false)
		end
	end, f)
	dim.BackgroundTransparency = 1
	dim.Visible = false
	listDim = dim

	HudLayout.RegisterPanel(PANEL_ID, function(): boolean
		return listOpen
	end, function()
		setListOpen(false)
	end)
	HudLayout.Signals.CompassTapped:Connect(function()
		setListOpen(not listOpen)
	end)
	HudLayout.FlagChanged:Connect(function(name: string, on: boolean)
		if on and listOpen and (name == "Driving" or name == "Dead") then
			setListOpen(false)
		end
	end)
	HudLayout.LayoutChanged:Connect(function()
		if listOpen then
			placeList()
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- F3 Empire Tax: list header + "Empire Tax +N%" toast (display only; the server owns the %)
---------------------------------------------------------------------------------------------------------------

local function readTaxPct(): number
	local v = player:GetAttribute(TAX.Attr)
	return if typeof(v) == "number" and v == v and v > 0 and v < math.huge then math.floor(v + 0.5) else 0
end

-- "Empire Tax +20%" (the list header and the toast)
function TerritoryController.TaxText(pct: number): string
	return string.format("%s +%d%%", TAX.Name, math.floor(pct + 0.5))
end

--[[ Pure (exported for the client sim): toast "Empire Tax +N%" for a change at changedAt? Not for 0, not while
	joining (joinedAt nil or within JoinQuietSeconds), and not when a server toast naming Empire Tax came at serverAt
	within SkipWindow before the change or after it (the decision runs Settle seconds after the change). ]]
function TerritoryController.ShouldToastTax(pct: number, changedAt: number, serverAt: number, joinedAt: number?): boolean
	if pct <= 0 or joinedAt == nil or changedAt - joinedAt < TAX.JoinQuietSeconds then
		return false
	end
	return serverAt < changedAt - TAX.SkipWindow
end

local function retitle()
	local t = listTitle
	if not t then
		return
	end
	local text = if taxPct > 0 then TerritoryController.TaxText(taxPct) else "TERRITORIES"
	if t.Text ~= text then
		t.Text = text
	end
	t.TextColor3 = if taxPct > 0 then TAX.Color else HudConfig.Colors.White
end

local function onTaxChanged()
	local pct = readTaxPct()
	if pct == taxPct then
		return
	end
	taxPct = pct
	retitle()
	taxToken += 1
	local my = taxToken
	local changedAt = os.clock()
	task.delay(TAX.Settle, function()
		-- a newer change decides for itself; the % must still be this one
		if my ~= taxToken or readTaxPct() ~= pct then
			return
		end
		if TerritoryController.ShouldToastTax(pct, changedAt, lastServerTaxToastAt, taxBaselineAt) then
			NotificationController.Show(TerritoryController.TaxText(pct), "Info")
		end
	end)
end

-- test hook (client sims): (current %, list header text)
function TerritoryController._TaxState(): (number, string)
	return taxPct, if listTitle then listTitle.Text else ""
end

---------------------------------------------------------------------------------------------------------------
-- capture bar
---------------------------------------------------------------------------------------------------------------

local function setCaptureVisible(visible: boolean)
	if captureActive == visible then
		return
	end
	captureActive = visible
	local p = capture
	if p then
		HudLayout.RefreshVisibility(p.Frame)
	end
end

local function applyCapture(localCap: any)
	local p = capture
	if not (localCap and localCap.Capturing and localCap.TerritoryId) then
		setCaptureVisible(false)
		contestedPulseActive = false
		contestedColA = nil
		contestedColB = nil
		return
	end
	local id = tostring(localCap.TerritoryId)
	local def = TerritoryConfig.Territories[id]
	local name = string.upper(if def then def.DisplayName else id)
	local frac = math.clamp(tonumber(localCap.Progress) or 0, 0, 1)
	local contested = localCap.Contested == true
	local protected = localCap.Protected == true
	if p then
		p.Value.Text = ProgressPill.Percent(frac)
		ProgressPill.SetFraction(p, frac)
		if contested then
			p.Title.Text = "CONTESTED · " .. name
			p.Title.TextColor3 = COL.Contested
			ProgressPill.AccentStroke(p, COL.Contested)
		elseif protected then
			p.Title.Text = "PROTECTED · " .. name
			p.Title.TextColor3 = COL.Protected
			ProgressPill.ResetStroke(p)
		else
			p.Title.Text = "CAPTURING " .. name
			p.Title.TextColor3 = ProgressPill.Colors.Title
			ProgressPill.ResetStroke(p)
		end
	end
	if contested then
		contestedPulseActive = true
		local ca = localCap.ContesterColorA
		local cb = localCap.ContesterColorB
		if typeof(ca) == "table" and typeof(cb) == "table" and #ca >= 3 and #cb >= 3 then
			contestedColA = Color3.new(ca[1], ca[2], ca[3])
			contestedColB = Color3.new(cb[1], cb[2], cb[3])
		else
			contestedColA = COL.Contested
			contestedColB = UIUtil.Lighten(COL.Contested, 0.5)
		end
		if p then
			local pulse = (math.sin(os.clock() * 5) + 1) * 0.5
			p.Fill.BackgroundColor3 = (contestedColA :: Color3):Lerp(contestedColB :: Color3, pulse)
		end
	else
		contestedPulseActive = false
		contestedColA = nil
		contestedColB = nil
		if p then
			p.Fill.BackgroundColor3 = if protected then COL.Protected else ProgressPill.Colors.Fill
		end
	end
	setCaptureVisible(true)
end

---------------------------------------------------------------------------------------------------------------

local function playerGui(): PlayerGui?
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if pg then
		return pg
	end
	local waited = player:WaitForChild("PlayerGui", 30)
	if waited and waited:IsA("PlayerGui") then
		return waited
	end
	return nil
end

function TerritoryController.Init()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireTerritory"
	-- Core safe insets + the one HUD UIScale; DisplayOrder from HudConfig (28)
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	local pg = playerGui()
	if pg then
		screen.Parent = pg
	else
		warn("[WAR EMPIRE] TerritoryController: no PlayerGui after 30 s; capture bar not shown")
	end
	_gui = screen

	local p = ProgressPill.Build(screen, "CaptureProgress")
	capture = p
	HudLayout.BindVisibility(p.Frame, { HideWhen = { "Dead" } }, function(): boolean
		return captureActive
	end)
	HudLayout.RegisterTopStack("Capture", p.Frame, HudConfig.TopStack.Order.Progress, { Space = "Hud" })

	buildList(screen)

	-- F3: the Empire Tax % (server attribute) heads the list and toasts on change
	taxPct = readTaxPct()
	retitle()
	player:GetAttributeChangedSignal(TAX.Attr):Connect(onTaxChanged)
	-- the server's capture / loss toasts name the % already ("Outpost taken  Empire Tax +10%"): remember when
	Remotes.BindEvent(Constants.RemoteNames.Notification, function(payload: any)
		if type(payload) == "table" and type(payload.Message) == "string" and string.find(payload.Message, TAX.Name, 1, true) then
			lastServerTaxToastAt = os.clock()
		end
	end)

	-- F10: the own plot, so the list shows only the own Home Outpost
	local function applyPlot(id: any)
		if typeof(id) ~= "number" or id ~= id or id == myPlotId then
			return
		end
		myPlotId = id
		listDirty = true
		if listOpen then
			rebuildList()
			placeList()
		end
	end
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: any)
		if typeof(base) == "table" then
			applyPlot(base.PlotId)
		end
	end)
	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: any)
		if typeof(state) == "table" and typeof(state.Base) == "table" then
			applyPlot(state.Base.PlotId)
		end
	end)

	local applyToken = 0
	Remotes.BindEvent(Constants.RemoteNames.TerritoryStateUpdate, function(payload: Types.TerritoryStatePayload)
		if typeof(payload) ~= "table" then
			return
		end
		applyToken += 1
		local my = applyToken
		task.delay(0.1, function()
			if my == applyToken then
				TerritoryController.Apply(payload)
			end
		end)
	end)

	local radarAccum = 0
	RunService.Heartbeat:Connect(function(dt)
		-- v38: continuous contested dual-color pulse on the capture bar
		local cp = capture
		if contestedPulseActive and cp and contestedColA and contestedColB then
			local pulse = (math.sin(os.clock() * 5) + 1) * 0.5
			cp.Fill.BackgroundColor3 = contestedColA:Lerp(contestedColB, pulse)
		end
		-- W3 step 2 lane U0: the contested diamond yields to the objective marker (4 Hz)
		diamondAccum += dt
		if diamondAccum >= DIAMOND.CheckSeconds then
			local elapsed = diamondAccum
			diamondAccum = 0
			syncDiamonds(elapsed)
		end
		if not radarActive then
			return
		end
		radarAccum += dt
		if radarAccum >= 0.2 then
			radarAccum = 0
			updateRadar()
		end
	end)

	Players.PlayerRemoving:Connect(function(leaving)
		local h = radarHighlights[leaving.UserId]
		if h then
			h:Destroy()
			radarHighlights[leaving.UserId] = nil
		end
		destroyPing(leaving.UserId) -- lane C2
	end)
end

function TerritoryController.Apply(payload: Types.TerritoryStatePayload)
	lastPayload = payload

	radarActive = payload.RadarReveal == true
	radarRadius = tonumber(payload.RadarRadius) or TerritoryConfig.RadarRevealRadius or 220
	-- lane C2: the server's reveal list comes only while streaming is on
	local targets = payload.RadarTargets
	if radarActive and typeof(targets) == "table" then
		radarTargets = targets
		radarTargetsAt = os.clock()
	else
		radarTargets = nil
	end
	HudLayout.SetFlag("Radar", radarActive)
	if not radarActive then
		clearRadarHighlights()
	end

	applyCapture(payload.LocalCapture)

	-- the list: rebuild now when it is open, otherwise on the next open
	listDirty = true
	if listOpen then
		rebuildList()
		placeList()
	end

	-- F3: the first payload ends "joining" for the Empire Tax toast (it replaced "Outposts held: N")
	if taxBaselineAt == nil then
		taxBaselineAt = os.clock()
	end
end

return TerritoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="211">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Interactive tutorial, F6 order (TutorialConfig, 7 steps): claim → Command Center → collect cash → recruit →
	Barracks → Home Outpost → 4x4 (Outpost and 4x4 swap while TerritoryConfig.Starter is off). The server owns the
	order and the step; this controller never counts steps by index (Outpost is step 6 or 7): it keys on the step Id.

	v70 "clean screen" (spec §3.4 item 3): the step is an OBJECTIVE CHIP in the top-centre stack (HudLayout
	TopStack "Objective"; was a 94 %-wide 168 v card across mid-screen):
	  ( 2 )  Collect cash                              [ GO ]  Skip
	         Touch the Money Collector (green ATM …
	≤ 460×64 v pill (HudConfig.TopStack.Objective), 2 v gold edge. Step disc, title (Display font), hint (Body
	font, up to 2 lines, "…" when longer), GO (64 v hit: runs the step's CTA — BUY/ARMY/GARAGE opener or re-aims
	the beam), Skip (touch-size hit; tap twice — "Sure?" — so a stray tap never ends the tutorial).
	While a step is active the HudLayout flag "Tutorial" is on (offers wait). The chip hides while a panel is open
	(Modal), while Driving (the beam keeps guiding) and while dead. The world guide beam + SelectionBox are unchanged.
	v71 P0-6: every per-player target resolves to the player's OWN plot BEFORE any name lookup (the Tutorial_* marker
	parts are all built on Plot 1, so 5 of 6 players were led into someone else's base):
	  ClaimBase -> own PlayerSpawn · Income -> own WE_MoneyCollector · ClickDropper -> own WE_ManualDropper ·
	  CommandCenter / Barracks -> own console (ConsoleLocator) · Recruit / Jeep -> no beam (GO opens Army / Garage) ·
	  Outpost -> the player's OWN Home Outpost (F10 Starter_P<plot>, while it exists and is not theirs yet), else the
	  nearest uncontested, walkable territory; other plots' Home Outposts are never a target, and "nearest" is measured
	  from the player's own main gate (plot-local (0, PlotSize/2), PlotFrame: pure config, streaming-safe).
	  No plot id yet -> no beam (re-aimed when it arrives).
	  A marker part is only ever shown when it IS the target (unknown future steps, and only inside the own plot).
	v71 console-only buying: the CommandCenter / Barracks GO only re-aims the beam at the console; it never opens the
	Base panel (that panel cannot buy any more).
	v72 tycoon guide (TycoonGuideConfig.Enabled; none of it exists while the flag is false):
	  After the tutorial a second chip ("Guide", same top-centre slot) names the ONE next buy the server picked
	  (Player attribute WE_NextBuy = "Id:Level" | "Soldier:0" | ""):
	    Build    NEXT: Ammo Works         $600  +$3.3/s                  [ GO ]   Hide
	    Collect  NEXT: Ammo Works         Collect $1,240 at your ATM     [ ATM ]  Hide
	    Earn     NEXT: Ammo Works         +$3.3/s  ready in 0:42 (1 Hz)  [ GO ]   Hide
	    Soldier  NEXT: Recruit soldiers   $500 each  +$1.6/s each        [ ARMY ] Hide
	  Money state = TycoonMath.MoneyState(cost, WE_Cash, WE_PendingCash, WE_IncomePerSec); every rate is
	  TycoonMath.PerSecText(StepGainPerTick(id, level - 1, WE_IncomeMult)) (floored: never over-promises).
	  GO draws the console line (Modules/ConsoleWaypoint) to that console on the player's OWN plot; ATM draws it to
	  the player's own ATM (ConsoleWaypoint.ShowAtm); ARMY opens the Army panel. Hide: HideSeconds, or until the next
	  successful purchase acknowledgement (WE_BuyAck). Visibility: TycoonGuideConfig.ChipRule (inside the own plot;
	  hidden on Tutorial, Modal, Driving, Dead, RecentCombat and AtConsole = the BUY button is up).
	  Auto-guide: in the Build or Collect state, after AutoGuideIdleSeconds standing still with the chip on screen and
	  more than AutoGuideMinStuds from the target, GO fires once per pick.
	  F5: tutorial marker dressing (the catalog arrow VisualAssetService welds under the Plot-1 markers) is hidden
	  locally (LocalTransparencyModifier) unless that marker is the active target; markers and arrows that replicate
	  late are handled as they arrive (events, no polling).
	F6: a step that points at a world part whose target is not on this client yet (streamed out, built after the
	push) re-aims at most every REAIM_SECONDS (1 Hz tick) until it is; steps that open a panel never re-aim.
	streaming2 lane C1 (F5 / F6 / F23; every path is gated on Workspace.StreamingEnabled, so with it off this is HEAD):
	  the beam never waits for a streamed part. ResolveTargetPos gives the part when it is on this client, else the
	  position the server stamped or the config gives (PadBuy WE_ConsolePos_<sid>, Income WE_AtmPos, ClickDropper
	  WE_DropperPos, ClaimBase PlotFrame + SpawnOffset, Outpost TerritoryConfig); the beam then ends on a client
	  Attachment in Workspace.Terrain there (the ObjectiveMarker pattern) with no SelectionBox. The part streams in ->
	  the 1 Hz tick swaps the beam to it (<= REAIM_SECONDS); it streams out -> AncestryChanged falls back to Terrain at
	  once. The Outpost pick ranks the config zones with the last TerritoryStateUpdate, so it is the same zone whatever
	  is streamed in. The active marker's Transparency is set again when it streams back in.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local TutorialConfig = require(Shared.Configs.TutorialConfig)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local ConsoleLocator = require(Shared.Util.ConsoleLocator)
local TycoonMath = require(Shared.Util.TycoonMath)
local PlotFrame = require(Shared.Util.PlotFrame)

local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local ConsoleWaypoint = require(script.Parent.Parent.Modules.ConsoleWaypoint)
local ObjectiveMarker = require(script.Parent.Parent.Modules.ObjectiveMarker)

local TutorialController = {}

local player = Players.LocalPlayer

local _gui: ScreenGui? = nil
local guideBeam: Beam? = nil
local attach0: Attachment? = nil
local attach1: Attachment? = nil
local highlightPart: BasePart? = nil
local currentMarkerName: string? = nil
local currentPadStructureId: string? = nil
local currentCtaAction: string? = nil
local currentStepId: string? = nil
local myPlotId: number? = nil

-- objective chip
local OBJ = HudConfig.TopStack.Objective
local chip: Frame? = nil
local discLabel: TextLabel? = nil
local titleLabel: TextLabel? = nil
local hintLabel: TextLabel? = nil
local goBtn: TextButton? = nil
local skipBtn: TextButton? = nil
local skipLabel: TextLabel? = nil
local stepActive = false -- a step is showing (drives the "Tutorial" flag and the chip)
local rawTitle = ""
local rawHint = ""

-- streaming2 lane C1 (streaming only; see the header)
local terrainEnd = false -- attach1 is a client Attachment in Workspace.Terrain (the target part is not on this client)
local targetConn: RBXScriptConnection? = nil -- AncestryChanged on the part the beam ends on
local zoneList: { any }? = nil -- the last TerritoryStateUpdate.Territories (F6: zone state while zones are streamed out)

-- C1: a place setting (the client cannot change it), read where it matters
local function streamingOn(): boolean
	return Workspace.StreamingEnabled == true
end

-- chip internals, v (the gui carries HudLayout's MobileScale)
local PAD_L = 10
local DISC = 36
local DISC_GAP = 10
local TEXT_GAP = 6
local PAD_R = 2
local TITLE_H = 22
local GO_FACE = Vector2.new(56, 44)
local CORNER = 16
local GOLD = HudConfig.Colors.Gold
local DARK_INK = HudConfig.Rail.Badge.ReadyText
local SKIP_CONFIRM_SECONDS = 3

local function clearWaypoint()
	if guideBeam then
		guideBeam:Destroy()
		guideBeam = nil
	end
	if attach0 then
		attach0:Destroy()
		attach0 = nil
	end
	if attach1 then
		attach1:Destroy()
		attach1 = nil
	end
	if highlightPart then
		local stroke = highlightPart:FindFirstChild("WE_TutorialHighlight")
		if stroke then
			stroke:Destroy()
		end
		highlightPart = nil
	end
	local tc = targetConn
	if tc then
		targetConn = nil
		tc:Disconnect()
	end
	terrainEnd = false
	currentMarkerName = nil
end

-- v72 F5 (with the guide flag): a marker's welded dressing (the catalog tutorial arrow under the Plot-1 markers) is
-- hidden on this client unless that marker is the active target
local HIDE_MARKER_DRESSING = TycoonGuideConfig.Enabled
local activeMarker: BasePart? = nil

local function showDressing(d: Instance, isActive: boolean)
	if d:IsA("BillboardGui") then
		d.Enabled = isActive
	elseif d:IsA("SurfaceGui") then
		d.Enabled = isActive
	elseif d:IsA("BasePart") then
		d.LocalTransparencyModifier = if isActive then 0 else 1
	elseif d:IsA("Decal") then
		d.LocalTransparencyModifier = if isActive then 0 else 1
	end
end

-- Show a tutorial marker part only when it IS the resolved target (P0-6: the Tutorial_* markers are built on Plot 1;
-- revealing them led every other player to Plot 1). Everything else stays hidden.
local function syncMarkerVisibility(activePart: BasePart?)
	activeMarker = activePart
	local tag = Constants.Tags.TutorialMarker
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") then
			local isActive = activePart ~= nil and inst == activePart
			-- MapSetup starts Transparency=1; must set Transparency (not only LocalTransparencyModifier)
			inst.Transparency = if isActive then 0.25 else 1
			inst.LocalTransparencyModifier = 0
			for _, child in ipairs(inst:GetDescendants()) do
				if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
					child.Enabled = isActive == true
				elseif HIDE_MARKER_DRESSING then
					showDressing(child, isActive)
				end
			end
		end
	end
end

-- F5: a marker (and the arrow welded under it) that replicates after the last sync starts hidden too. Event-driven:
-- one DescendantAdded connection per marker part, no polling.
local watchedMarkers: { [Instance]: RBXScriptConnection } = {}
local function unwatchMarker(inst: Instance)
	local conn = watchedMarkers[inst]
	if conn then
		conn:Disconnect()
		watchedMarkers[inst] = nil
	end
end
local function watchMarker(inst: Instance)
	if watchedMarkers[inst] or not inst:IsA("BasePart") then
		return
	end
	local marker = inst :: BasePart
	local function isActive(): boolean
		return activeMarker ~= nil and activeMarker == marker
	end
	for _, d in ipairs(marker:GetDescendants()) do
		showDressing(d, isActive())
	end
	-- C1 F23: the active marker streamed back in may carry the server's Transparency 1 again (local writes can be lost
	-- on stream-in): show it again (syncMarkerVisibility's values)
	if streamingOn() and isActive() then
		marker.Transparency = 0.25
		marker.LocalTransparencyModifier = 0
	end
	watchedMarkers[marker] = marker.DescendantAdded:Connect(function(d: Instance)
		local on = isActive()
		showDressing(d, on)
		-- a whole arrow model parented at once: its parts too (idempotent where the engine also fires per part)
		for _, dd in ipairs(d:GetDescendants()) do
			showDressing(dd, on)
		end
	end)
	marker.Destroying:Once(function()
		unwatchMarker(marker)
	end)
end

---------------------------------------------------------------------------------------------------------------
-- P0-6 target resolution: the player's OWN plot first, never a fixed world marker (CLAUDE.md "Pointers")
---------------------------------------------------------------------------------------------------------------

local MANUAL_DROPPER_TAG = "WE_ManualDropper" -- ManualDropperService TAG_DROPPER
local OUTPOST_TIER_GAP = 1e6 -- a lower tier always wins over distance

local function ownPlotPad(plotId: number): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			return inst
		end
	end
	return nil
end

-- plot-local rectangle test on the plot pad (the pad carries the plot yaw, so rotated plots need no extra math)
local function insidePad(pad: BasePart, pos: Vector3): boolean
	local lp = pad.CFrame:PointToObjectSpace(pos)
	return math.abs(lp.X) <= pad.Size.X * 0.5 and math.abs(lp.Z) <= pad.Size.Z * 0.5
end

-- nearest part with `tag` whose PlotId is exactly plotId (a part with no PlotId is never "own")
local function nearestOwnTagged(tag: string, plotId: number, origin: Vector3): BasePart?
	local best: BasePart? = nil
	local bestD = math.huge
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId and inst:IsDescendantOf(Workspace) then
			local d = (inst.Position - origin).Magnitude
			if d < bestD then
				bestD = d
				best = inst
			end
		end
	end
	return best
end

-- the own PlayerSpawn part when it is on this client (Bases / PlotN are Folders: always present)
local function ownSpawnPart(plotId: number): BasePart?
	local root = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = root and root:FindFirstChild("Bases")
	local folder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	local sp = folder and folder:FindFirstChild("PlayerSpawn")
	if sp and sp:IsA("BasePart") then
		return sp
	end
	return nil
end

local function ownSpawn(plotId: number): BasePart?
	local sp = ownSpawnPart(plotId)
	if sp then
		return sp
	end
	return ownPlotPad(plotId) -- the spawn streamed out / renamed: the plot pad is still inside the plot
end

-- C1 F5: the own PlayerSpawn's world position from config (MapSetup builds it at PlotCFrame * (SpawnOffset.X, 2,
-- SpawnOffset.Z); BaseService.plotSpawnOffset), for the ClaimBase beam while the plot is not streamed in
local SPAWN_LIFT = 2
local function ownSpawnPos(plotId: number): Vector3?
	local plotPos = PlotFrame.PlotPosition(plotId)
	if plotPos == nil then
		return nil
	end
	local sp = if BaseLayoutConfig.Enabled == true then BaseLayoutConfig.SpawnOffset else { X = 0, Z = 55 }
	return PlotFrame.PlotCFrame(plotPos):PointToWorldSpace(Vector3.new(sp.X, SPAWN_LIFT, sp.Z))
end

-- C1 F5: a Vector3 the server stamped on the local player (nil when unset)
local function stampedPos(attr: string): Vector3?
	local v = player:GetAttribute(attr)
	return if typeof(v) == "Vector3" then v else nil
end

-- C1 F5: the nearest own tagged part on this client, unless the server-stamped position (the part the server picked,
-- maybe streamed out) is nearer: the beam then ends on Terrain there until that part streams in
local function nearestOwnOrStamp(tag: string, plotId: number, origin: Vector3, attr: string): (BasePart?, Vector3?)
	local part = nearestOwnTagged(tag, plotId, origin)
	local pos = stampedPos(attr)
	if pos ~= nil and (part == nil or (pos - origin).Magnitude + 0.5 < (part.Position - origin).Magnitude) then
		return nil, pos
	end
	return part, nil
end

-- F6 / F10: the player's own main gate in world space (plot-local (0, PlotSize/2), +Z = plot front). Pure config
-- (PlotFrame), so it is right while the plot is streamed out.
local function ownGatePos(plotId: number): Vector3
	local half = (tonumber(BaseLayoutConfig.PlotSize) or 320) * 0.5
	return PlotFrame.LocalToWorld(plotId, 0, half)
end

-- F10: the plot a Home Outpost zone belongs to (TerritoryConfig.Starter rows: IsStarter + PlotId; the marker's
-- PlotId attribute or the Starter_P<n> id when the row is not in this client's config); nil = not a Home Outpost
local function starterPlotOf(tid: any, def: any, inst: Instance?): number?
	local prefix = TerritoryConfig.Starter.IdPrefix
	local named = typeof(tid) == "string" and string.sub(tid, 1, #prefix) == prefix
	if not ((def ~= nil and def.IsStarter == true) or named) then
		return nil
	end
	local fromDef = if def ~= nil then tonumber(def.PlotId) else nil
	local fromInst = if inst ~= nil then tonumber(inst:GetAttribute("PlotId")) else nil
	return fromDef or fromInst or (if named then tonumber(string.sub(tid, #prefix + 1)) else nil)
end

-- One zone's Outpost score (lower wins), for nearestOutpost and outpostFromConfig. Tiers: see nearestOutpost.
local function outpostScore(def: any, starterPlot: number?, ownerType: any, ownerUserId: any, userId: number, pos: Vector3, from: Vector3): number
	local ot = TerritoryConfig.OwnerTypes
	local contested = ownerType == ot.Contested
	local mine = ownerType == ot.Player and ownerUserId == userId
	local hard = def ~= nil and (def.IsOilRig == true or def.IsFortress == true)
	local tier = if starterPlot ~= nil then (if mine then 3 else -1)
		elseif contested or mine then 3
		elseif hard then 2
		elseif ownerType ~= nil and ownerType ~= ot.Neutral then 1
		else 0
	return tier * OUTPOST_TIER_GAP + (pos - from).Magnitude
end

-- Outpost: the zone the player can take on foot. Tiers: the player's OWN Home Outpost while they do not hold it (F10,
-- about 100 studs out of the gate, owner-only), then a neutral land zone, then any uncontested land zone they do not
-- own, then any uncontested zone (oil rigs need a boat, forts have guards), then anything. Another plot's Home
-- Outpost is never a target (only its owner can take it). Distance from the own gate when the plot is known
-- (F6: the same answer wherever the player stands in the base), else from `origin`.
local function nearestOutpost(origin: Vector3, userId: number, plotId: number?): BasePart?
	local from = if plotId ~= nil then ownGatePos(plotId) else origin
	local best: BasePart? = nil
	local bestScore = math.huge
	local seen: { [Instance]: boolean } = {}
	for _, tag in ipairs({ Constants.Tags.Territory, Constants.Tags.CaptureZone }) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			if not seen[inst] and inst:IsA("BasePart") and inst:IsDescendantOf(Workspace) then
				seen[inst] = true
				local tid = inst:GetAttribute("TerritoryId")
				local def = if typeof(tid) == "string" then (TerritoryConfig.Territories :: any)[tid] else nil
				local starterPlot = starterPlotOf(tid, def, inst)
				if starterPlot == nil or (plotId ~= nil and starterPlot == plotId) then
					local score = outpostScore(def, starterPlot, inst:GetAttribute("OwnerType"), inst:GetAttribute("OwnerUserId"), userId,
						inst.Position, from)
					if score < bestScore then
						bestScore = score
						best = inst
					end
				end
			end
		end
	end
	return best
end

--[[ C1 F6 (streaming): the same pick over EVERY TerritoryConfig zone, streamed in or not. A zone's owner comes from
	the last TerritoryStateUpdate (it lists every zone this player may see; another plot's Home Outpost is left out and
	skipped here anyway), else from its marker's attributes when the marker is on this client, else Neutral. The zone
	position is TerritoryConfig's (MapSetup builds the marker there). Ties go to the lower id. Returns the zone's id,
	position and marker part (nil while it is streamed out). ]]
local function outpostFromConfig(origin: Vector3, userId: number, plotId: number?): (string?, Vector3?, BasePart?)
	local from = if plotId ~= nil then ownGatePos(plotId) else origin
	local state: { [string]: any } = {}
	local list = zoneList
	if list then
		for _, e in ipairs(list) do
			if typeof(e) == "table" and typeof(e.Id) == "string" then
				state[e.Id] = e
			end
		end
	end
	local parts: { [string]: BasePart } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.Territory)) do
		local tid = inst:GetAttribute("TerritoryId")
		if typeof(tid) == "string" and inst:IsA("BasePart") and inst:IsDescendantOf(Workspace) then
			parts[tid] = inst
		end
	end
	local bestId: string? = nil
	local bestPos: Vector3? = nil
	local bestScore = math.huge
	for tid, def in pairs(TerritoryConfig.Territories :: any) do
		local pos = def.Position
		if typeof(tid) == "string" and typeof(pos) == "Vector3" then
			local part: BasePart? = parts[tid] -- nil while the marker is streamed out
			local starterPlot = starterPlotOf(tid, def, part)
			if starterPlot == nil or (plotId ~= nil and starterPlot == plotId) then
				local e = state[tid]
				local ownerType: any = if e ~= nil then e.OwnerType elseif part ~= nil then part:GetAttribute("OwnerType") else nil
				local ownerUserId: any = if e ~= nil then e.OwnerUserId elseif part ~= nil then part:GetAttribute("OwnerUserId") else nil
				local score = outpostScore(def, starterPlot, ownerType, ownerUserId, userId, pos, from)
				if score < bestScore or (score == bestScore and bestId ~= nil and tid < (bestId :: string)) then
					bestScore = score
					bestId = tid
					bestPos = pos
				end
			end
		end
	end
	return bestId, bestPos, if bestId ~= nil then parts[bestId] else nil
end

--[[ Where the tutorial beam points for a step. Pure (reads the world, builds nothing), exported for the headless
	test (every target except Outpost lies inside the player's own plot, plots 1-6, flat and rotated).
	stepId: TutorialStateUpdate.Id; markerName / padStructureId: the step's MarkerName / PadStructureId;
	plotId: the player's own plot (nil = not known yet -> no per-player beam); origin: where "nearest" is measured. ]]
function TutorialController.ResolveTarget(stepId: string?, markerName: string?, padStructureId: string?, plotId: number?, origin: Vector3, userId: number?): BasePart?
	if stepId == "Outpost" or markerName == "Tutorial_Outpost" then
		return nearestOutpost(origin, userId or player.UserId, plotId)
	end
	if stepId == "RecruitSoldiers" or markerName == "Tutorial_Recruit" or stepId == "Jeep" or markerName == "Tutorial_Jeep" then
		return nil -- GO opens Army / the Garage; nothing to walk to
	end
	if plotId == nil then
		return nil -- per-player target: wait for the plot id (applyPlotId re-aims)
	end
	if typeof(padStructureId) == "string" and padStructureId ~= "" then
		return ConsoleLocator.Find(plotId, padStructureId)
	end
	if stepId == "ClaimBase" or markerName == "Tutorial_ClaimBase" then
		return ownSpawn(plotId)
	end
	if stepId == "Income" or markerName == "Tutorial_Income" then
		return nearestOwnTagged(Constants.Tags.MoneyCollector, plotId, origin)
	end
	if stepId == "ClickDropper" or markerName == "Tutorial_Dropper" then
		return nearestOwnTagged(MANUAL_DROPPER_TAG, plotId, origin)
	end
	-- unknown (future) step: its named marker, but only when it lies inside the player's own plot
	if typeof(markerName) == "string" and markerName ~= "" then
		local pad = ownPlotPad(plotId)
		if pad then
			for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.TutorialMarker)) do
				if inst:IsA("BasePart") and (inst.Name == markerName or inst:GetAttribute("TutorialStepId") == markerName)
					and insidePad(pad, inst.Position) then
					return inst
				end
			end
		end
	end
	return nil
end

--[[ C1 F5 / F6: where the beam ends when the target part may not be on this client (StreamingEnabled). Returns
	(part, nil) when the target part is streamed in, (nil, position) when it is not but the server stamped or the
	config gives where it is (the beam then ends on a Terrain attachment there), (nil, nil) for no beam. Same
	arguments and the same own-plot rules as ResolveTarget; with Workspace.StreamingEnabled false it IS ResolveTarget
	and never returns a position. Pure (reads the world and the player's attributes, builds nothing). ]]
function TutorialController.ResolveTargetPos(stepId: string?, markerName: string?, padStructureId: string?, plotId: number?, origin: Vector3, userId: number?): (BasePart?, Vector3?)
	if not streamingOn() then
		return TutorialController.ResolveTarget(stepId, markerName, padStructureId, plotId, origin, userId), nil
	end
	if stepId == "Outpost" or markerName == "Tutorial_Outpost" then
		local _, pos, part = outpostFromConfig(origin, userId or player.UserId, plotId)
		if part then
			return part, nil
		end
		return nil, pos
	end
	if stepId == "RecruitSoldiers" or markerName == "Tutorial_Recruit" or stepId == "Jeep" or markerName == "Tutorial_Jeep" then
		return nil, nil
	end
	if plotId == nil then
		return nil, nil
	end
	if typeof(padStructureId) == "string" and padStructureId ~= "" then
		local part = ConsoleLocator.Find(plotId, padStructureId)
		if part and ConsoleLocator.IsConsole(part) then
			return part, nil
		end
		-- the console is streamed out: its stamped position (UpgradePadService) before any legacy pad on this client
		local pos = stampedPos("WE_ConsolePos_" .. padStructureId)
		if pos then
			return nil, pos
		end
		return part, nil
	end
	if stepId == "ClaimBase" or markerName == "Tutorial_ClaimBase" then
		local sp = ownSpawnPart(plotId)
		if sp then
			return sp, nil
		end
		return nil, ownSpawnPos(plotId) -- not the plot pad: the spawn itself, from config
	end
	if stepId == "Income" or markerName == "Tutorial_Income" then
		return nearestOwnOrStamp(Constants.Tags.MoneyCollector, plotId, origin, "WE_AtmPos")
	end
	if stepId == "ClickDropper" or markerName == "Tutorial_Dropper" then
		return nearestOwnOrStamp(MANUAL_DROPPER_TAG, plotId, origin, "WE_DropperPos")
	end
	-- an unknown step's named marker has no stamped position: the part, or nothing (as ResolveTarget)
	return TutorialController.ResolveTarget(stepId, markerName, padStructureId, plotId, origin, userId), nil
end

local function originPos(): Vector3
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.Position
	end
	local pad = if myPlotId ~= nil then ownPlotPad(myPlotId) else nil
	return if pad then pad.Position else Vector3.zero
end

local function newBeam(a0: Attachment, a1: Attachment, parent: Instance): Beam
	local beam = Instance.new("Beam")
	beam.Name = "WE_TutorialBeam"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.FaceCamera = true
	-- v68: subtle guide (was a thick glowing neon line): thin, mostly transparent, fading out toward the target
	beam.Width0 = 0.22
	beam.Width1 = 0.12
	beam.Color = ColorSequence.new(Color3.fromRGB(240, 214, 110))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0.85) })
	beam.LightEmission = 0.2
	beam.Parent = parent
	return beam
end

-- C1 F5: the beam end while the target part is not on this client: a client Attachment in Workspace.Terrain at the
-- stamped / config position (the ObjectiveMarker pattern; Terrain's frame is the world frame, and a client-made
-- Attachment there is never streamed). No SelectionBox (it needs the part).
local function beamToTerrain(pos: Vector3)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return -- respawning: CharacterAdded / the tick re-aim
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "WE_TutAtt0"
	a0.Parent = hrp
	attach0 = a0
	local a1 = Instance.new("Attachment")
	a1.Name = "WE_TutAtt1"
	a1.Position = pos
	a1.Parent = Workspace.Terrain
	attach1 = a1
	terrainEnd = true
	guideBeam = newBeam(a0, a1, hrp)
end

-- set once setWaypoint exists (the stream-out handler below re-aims through it)
local reaimNow: () -> () = function() end

-- C1 F5: the part the beam ends on leaves Workspace (streamed out: it, or its Atomic model, is parented to nil) ->
-- fall back to Terrain at once when the step has a stamped / config position. A step without one (an unknown step's
-- marker) keeps HEAD's behaviour: the beam's attachment comes back with the part.
local function watchTarget(target: BasePart)
	targetConn = target.AncestryChanged:Connect(function()
		if highlightPart ~= target or target:IsDescendantOf(Workspace) then
			return
		end
		task.defer(function()
			if not stepActive or highlightPart ~= target or target:IsDescendantOf(Workspace) then
				return
			end
			local _, pos = TutorialController.ResolveTargetPos(currentStepId, currentMarkerName, currentPadStructureId, myPlotId, originPos())
			if pos ~= nil then
				reaimNow()
			end
		end)
	end)
end

local function setWaypoint(markerName: string?, padStructureId: string?)
	clearWaypoint()
	currentMarkerName = markerName
	currentPadStructureId = padStructureId
	local target, endPos = TutorialController.ResolveTargetPos(currentStepId, markerName, padStructureId, myPlotId, originPos())
	syncMarkerVisibility(target)
	if not target then
		if endPos ~= nil then
			beamToTerrain(endPos) -- C1: streaming only (ResolveTargetPos gives no position with it off)
		end
		return
	end
	highlightPart = target
	local sel = Instance.new("SelectionBox")
	sel.Name = "WE_TutorialHighlight"
	sel.Adornee = target
	sel.Color3 = Constants.Colors.Gold
	sel.LineThickness = 0.06
	sel.Parent = target
	if streamingOn() then
		watchTarget(target)
	end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return
	end

	local a0 = Instance.new("Attachment")
	a0.Name = "WE_TutAtt0"
	a0.Parent = hrp
	attach0 = a0
	local a1 = Instance.new("Attachment")
	a1.Name = "WE_TutAtt1"
	a1.Parent = target
	attach1 = a1

	guideBeam = newBeam(a0, a1, hrp)
end
reaimNow = function()
	setWaypoint(currentMarkerName, currentPadStructureId)
end

-- C1 (1 Hz tick, <= every REAIM_SECONDS) while the beam ends on Terrain: the part streamed in -> the beam swaps to it
-- (and the SelectionBox comes back); the stamp moved -> the anchor follows without a rebuild
local function refreshTerrainEnd()
	local part, pos = TutorialController.ResolveTargetPos(currentStepId, currentMarkerName, currentPadStructureId, myPlotId, originPos())
	local a1 = attach1
	if part ~= nil or pos == nil or a1 == nil or a1.Parent == nil then
		setWaypoint(currentMarkerName, currentPadStructureId)
	elseif (a1.Position - pos).Magnitude > 0.5 then
		a1.Position = pos
	end
end

---------------------------------------------------------------------------------------------------------------
-- objective chip
---------------------------------------------------------------------------------------------------------------

local function touchMinV(): number
	if HudLayout.IsTouch() then
		-- 64 v = 44.8 real px at the smallest HUD scale (0.70)
		return math.max(HudConfig.Hotbar.Slot, math.ceil(HudConfig.Scale.TouchMinPx / HudConfig.Scale.Min))
	end
	return 0
end

local function goHitV(): number
	return math.max(OBJ.GoHit, touchMinV())
end

local function skipHitV(): number
	return math.max(OBJ.SkipHit, touchMinV())
end

local function chipWidthV(): number
	return math.floor(math.min(OBJ.MaxWidth, HudLayout.TopStackMaxWidthV()))
end

-- rendered size of `text` in v (text size and width are both v, so the gui's UIScale cancels out)
local function measure(text: string, size: number, font: Enum.Font, widthV: number): Vector2
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, size, font, Vector2.new(widthV, 10000))
	end)
	if ok and typeof(v) == "Vector2" then
		return v
	end
	return Vector2.new(#text * size * 0.55, size)
end

local function lineCount(text: string, size: number, font: Enum.Font, widthV: number): number
	if text == "" then
		return 0
	end
	local h = measure(text, size, font, widthV).Y
	return math.max(1, math.floor(h / size + 0.5))
end

-- `text` cut on a word boundary + "…" so it fits in maxLines lines of widthV (TextTruncate stays on as a backstop)
local function fitText(text: string, size: number, font: Enum.Font, widthV: number, maxLines: number): string
	if lineCount(text, size, font, widthV) <= maxLines then
		return text
	end
	local words = string.split(text, " ")
	local lo, hi = 1, #words
	local best = ""
	while lo <= hi do
		local mid = (lo + hi) // 2
		local candidate = table.concat(words, " ", 1, mid) .. "…"
		if lineCount(candidate, size, font, widthV) <= maxLines then
			best = candidate
			lo = mid + 1
		else
			hi = mid - 1
		end
	end
	if best == "" then
		best = string.sub(text, 1, math.max(1, math.floor(widthV / (size * 0.6)))) .. "…"
	end
	return best
end

-- Size the chip to the current scale and lay the title / hint out for 0, 1 or 2 hint lines.
local function layoutChip()
	local c = chip
	local title = titleLabel
	local hint = hintLabel
	local go = goBtn
	local skip = skipBtn
	if not (c and title and hint and go and skip) then
		return
	end
	local w = chipWidthV()
	local h = OBJ.Height
	c.Size = UDim2.fromOffset(w, h)
	local goW = if go.Visible then goHitV() else 0
	local skipW = skipHitV()
	go.Size = UDim2.fromOffset(goW, h)
	go.Position = UDim2.new(1, -(PAD_R + skipW), 0.5, 0)
	skip.Size = UDim2.fromOffset(skipW, h)
	local left = PAD_L + DISC + DISC_GAP
	local textW = math.max(60, w - left - TEXT_GAP - goW - skipW - PAD_R)

	title.Text = fitText(rawTitle, OBJ.TitleSize, HudConfig.Fonts.Display, textW, 1)
	local lines = math.min(2, lineCount(rawHint, OBJ.HintSize, HudConfig.Fonts.Body, textW))
	hint.Text = fitText(rawHint, OBJ.HintSize, HudConfig.Fonts.Body, textW, 2)
	hint.Visible = lines > 0
	local hintH = lines * OBJ.HintSize + 2
	local blockH = TITLE_H + (if lines > 0 then hintH else 0)
	local top = math.max(3, math.floor((h - blockH) / 2))
	title.Position = UDim2.fromOffset(left, top)
	title.Size = UDim2.fromOffset(textW, TITLE_H)
	hint.Position = UDim2.fromOffset(left, top + TITLE_H)
	hint.Size = UDim2.fromOffset(textW, math.max(hintH, 1))
end

local skipArmedAt = -math.huge
local function resetSkip()
	skipArmedAt = -math.huge
	local l = skipLabel
	if l then
		l.Text = "Skip"
		l.TextColor3 = HudConfig.Colors.White
		l.TextTransparency = 0.35
	end
end

local function setVisible(open: boolean)
	if stepActive ~= open then
		stepActive = open
		HudLayout.SetFlag("Tutorial", open)
		local c = chip
		if c then
			HudLayout.RefreshVisibility(c)
		end
	end
	if not open then
		clearWaypoint()
		syncMarkerVisibility(nil)
		resetSkip()
	end
end

local function runCta()
	local action = currentCtaAction
	-- CTA silent (avoid Output spam)
	if action == "PadBuy" then
		-- v71: buying happens at the console only — GO re-aims the beam at it (never opens the Base panel to buy)
		setWaypoint(currentMarkerName, currentPadStructureId)
	elseif action == "OpenBase" then
		-- Base overview (GO rows guide to consoles; it cannot buy)
		setWaypoint(currentMarkerName, currentPadStructureId)
		local ok, BaseController = pcall(function()
			return require(script.Parent.BaseController)
		end)
		if ok and BaseController and BaseController.Open then
			BaseController.Open()
		end
	elseif action == "OpenGarage" then
		local ok, VehicleController = pcall(function()
			return require(script.Parent.VehicleController)
		end)
		if ok and VehicleController and VehicleController.Open then
			VehicleController.Open()
		end
	elseif action == "OpenArmy" then
		local ok, ArmyController = pcall(function()
			return require(script.Parent.ArmyController)
		end)
		if ok and ArmyController and ArmyController.Open then
			ArmyController.Open()
		end
		setWaypoint(currentMarkerName, currentPadStructureId)
	else
		-- Capture / WatchHud / unknown: re-aim beam
		setWaypoint(currentMarkerName, currentPadStructureId)
	end
end

local lastApplyAt = 0.0
local APPLY_DEBOUNCE = 0.2

local pendingPayload: any = nil
local pendingScheduled = false

local function applyState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local now = os.clock()
	if (now - lastApplyAt) < APPLY_DEBOUNCE and payload.Complete ~= true then
		-- coalesce bursty pushes; always allow Complete through.
		-- v69: keep the NEWEST payload and apply it when the window ends. It used to be dropped, so a step
		-- advance pushed right after the join push (Claim → Collect) left the panel on the old step.
		pendingPayload = payload
		if not pendingScheduled then
			pendingScheduled = true
			task.delay(APPLY_DEBOUNCE + 0.05, function()
				pendingScheduled = false
				local latest = pendingPayload
				pendingPayload = nil
				if latest ~= nil then
					applyState(latest)
				end
			end)
		end
		return
	end
	pendingPayload = nil
	lastApplyAt = now
	if payload.Complete == true then
		setVisible(false)
		currentCtaAction = nil
		return
	end

	local step = tonumber(payload.Step) or 0
	local total = tonumber(payload.Total) or TutorialConfig.StepCount()
	rawTitle = tostring(payload.Title or "Tutorial")
	rawHint = tostring(payload.Hint or "")
	local disc = discLabel
	if disc then
		disc.Text = tostring(math.clamp(step, 1, math.max(1, total)))
	end

	local padSid = if typeof(payload.PadStructureId) == "string" then payload.PadStructureId else nil
	local marker = if typeof(payload.MarkerName) == "string" then payload.MarkerName else nil
	currentStepId = if typeof(payload.Id) == "string" then payload.Id else nil
	currentCtaAction = if typeof(payload.CtaAction) == "string" and payload.CtaAction ~= "" then payload.CtaAction else nil
	setWaypoint(marker, padSid)

	local go = goBtn
	if go then
		go.Visible = currentCtaAction ~= nil
	end
	resetSkip()
	layoutChip()
	setVisible(true)
end

local function buildChip(screen: ScreenGui)
	local c = Instance.new("Frame")
	c.Name = "Objective"
	c.AnchorPoint = Vector2.new(0.5, 0)
	c.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top) -- Y is rewritten by HudLayout's top stack
	c.Size = UDim2.fromOffset(chipWidthV(), OBJ.Height)
	c.BackgroundColor3 = HudConfig.Colors.PillBg
	c.BackgroundTransparency = 0.16
	c.BorderSizePixel = 0
	c.Active = true -- taps on the chip never fall through to the world
	c.Visible = false
	c.ZIndex = 2
	c.Parent = screen
	UIUtil.Corner(c, CORNER)
	local st = UIUtil.Stroke(c, GOLD, 2)
	chip = c

	local disc = Instance.new("TextLabel")
	disc.Name = "Step"
	disc.AnchorPoint = Vector2.new(0, 0.5)
	disc.Position = UDim2.new(0, PAD_L, 0.5, 0)
	disc.Size = UDim2.fromOffset(DISC, DISC)
	disc.BackgroundColor3 = GOLD
	disc.BorderSizePixel = 0
	disc.Font = HudConfig.Fonts.Display
	disc.TextSize = OBJ.TitleSize
	disc.TextColor3 = DARK_INK
	disc.Text = "1"
	disc.Active = false
	disc.ZIndex = 3
	disc.Parent = c
	UIUtil.Corner(disc, math.ceil(DISC / 2))
	discLabel = disc

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Font = HudConfig.Fonts.Display
	title.TextSize = OBJ.TitleSize
	title.TextColor3 = HudConfig.Colors.White
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = ""
	title.Active = false
	title.ZIndex = 3
	title.Parent = c
	UIUtil.TextOutline(title, 1.4)
	titleLabel = title

	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.Font = HudConfig.Fonts.Body
	hint.TextSize = OBJ.HintSize
	hint.TextColor3 = HudConfig.Colors.White
	hint.TextTransparency = 0.2
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextYAlignment = Enum.TextYAlignment.Top
	hint.TextWrapped = true
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	hint.Text = ""
	hint.Active = false
	hint.ZIndex = 3
	hint.Parent = c
	hintLabel = hint

	-- GO: transparent touch-size hit area around a gold face (runs the step's CTA)
	local go = Instance.new("TextButton")
	go.Name = "Go"
	go.AnchorPoint = Vector2.new(1, 0.5)
	go.BackgroundTransparency = 1
	go.BorderSizePixel = 0
	go.AutoButtonColor = false
	go.Text = ""
	go.Active = true
	go.Visible = false
	go.ZIndex = 3
	go.Parent = c
	local face = Instance.new("TextLabel")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromOffset(GO_FACE.X, GO_FACE.Y)
	face.BackgroundColor3 = GOLD
	face.BorderSizePixel = 0
	face.Font = HudConfig.Fonts.Display
	face.TextSize = OBJ.TitleSize
	face.TextColor3 = DARK_INK
	face.Text = "GO"
	face.Active = false
	face.ZIndex = 4
	face.Parent = go
	UIUtil.Corner(face, 12)
	local faceStroke = UIUtil.Stroke(face, Color3.fromRGB(107, 77, 0), 2)
	faceStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- the face is a TextLabel: edge, not glyph outline
	local press = Instance.new("UIScale")
	press.Parent = face
	go.MouseButton1Down:Connect(function()
		press.Scale = HudConfig.Rail.PressScale
	end)
	go.MouseButton1Up:Connect(function()
		press.Scale = 1
	end)
	go.MouseLeave:Connect(function()
		press.Scale = 1
	end)
	go.Activated:Connect(function()
		press.Scale = 1
		runCta()
	end)
	goBtn = go
	HudLayout.AssertTouchTarget(go, "Objective.GO")

	-- Skip: first tap arms ("Sure?"), a second tap within SKIP_CONFIRM_SECONDS skips
	local skip = Instance.new("TextButton")
	skip.Name = "Skip"
	skip.AnchorPoint = Vector2.new(1, 0.5)
	skip.Position = UDim2.new(1, -PAD_R, 0.5, 0)
	skip.BackgroundTransparency = 1
	skip.BorderSizePixel = 0
	skip.AutoButtonColor = false
	skip.Text = ""
	skip.Active = true
	skip.ZIndex = 3
	skip.Parent = c
	local sl = Instance.new("TextLabel")
	sl.Name = "Label"
	sl.BackgroundTransparency = 1
	sl.Size = UDim2.fromScale(1, 1)
	sl.Font = HudConfig.Fonts.Body
	sl.TextSize = OBJ.HintSize
	sl.TextColor3 = HudConfig.Colors.White
	sl.TextTransparency = 0.35
	sl.Text = "Skip"
	sl.Active = false
	sl.ZIndex = 4
	sl.Parent = skip
	skipLabel = sl
	skip.Activated:Connect(function()
		local now = os.clock()
		if now - skipArmedAt > SKIP_CONFIRM_SECONDS then
			skipArmedAt = now
			sl.Text = "Sure?"
			sl.TextColor3 = HudConfig.Colors.Warn
			sl.TextTransparency = 0
			task.delay(SKIP_CONFIRM_SECONDS, function()
				if skipArmedAt == now then
					resetSkip()
				end
			end)
			return
		end
		-- Optimistic hide so Skip always feels reliable; the server confirms with Complete
		setVisible(false)
		task.spawn(function()
			Remotes.FireServer(Constants.RemoteNames.RequestSkipTutorial)
		end)
	end)
	skipBtn = skip
	HudLayout.AssertTouchTarget(skip, "Objective.Skip")

	HudLayout.BindVisibility(c, { HideWhen = { "Modal", "Driving", "Dead" } }, function(): boolean
		return stepActive
	end)
	HudLayout.RegisterTopStack("Objective", c, HudConfig.TopStack.Order.Objective, { Space = "Hud" })

	-- soft gold edge pulse while the chip is on screen
	local pulse: Tween? = nil
	local function syncPulse()
		if c.Visible and not pulse then
			local tw = TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
				Transparency = 0.55,
			})
			tw:Play()
			pulse = tw
		elseif not c.Visible and pulse then
			pulse:Cancel()
			pulse = nil
			st.Transparency = 0
		end
	end
	c:GetPropertyChangedSignal("Visible"):Connect(syncPulse)
	syncPulse()

	HudLayout.LayoutChanged:Connect(layoutChip)
	layoutChip()
end

---------------------------------------------------------------------------------------------------------------
-- v72 tycoon guide chip (TycoonGuideConfig.Enabled only; see the header)
---------------------------------------------------------------------------------------------------------------

local GUIDE = TycoonGuideConfig
local GT = TycoonGuideConfig.Text
local GUIDE_PAD_L = 16 -- v: the guide chip has no step disc, so its text starts near the pill edge
local GO_FACE_PAD = 20 -- v of gold face around the GO / ATM / ARMY word
local IDLE_MOVE_STUDS = 2 -- auto-guide "idle": the character moved less than this between 1 Hz samples
local REAIM_SECONDS = 2 -- F6: a step's world target not on this client yet: re-aim this often until it is

type GuideKind = "Build" | "Collect" | "Earn" | "Soldier"
type GuideAction = "Console" | "Atm" | "Army"

local guideChip: Frame? = nil
local guideTitle: TextLabel? = nil
local guideHint: TextLabel? = nil
local guideGoBtn: TextButton? = nil
local guideGoFace: TextLabel? = nil
local guideHideBtn: TextButton? = nil
local tutorialDone = false -- TutorialStateUpdate.Complete / PlayerStateUpdate.TutorialComplete
local guidePick = "" -- the WE_NextBuy value on screen
local guideKind: GuideKind? = nil -- nil = nothing to show
local guideAction: GuideAction? = nil
local guideId: string? = nil -- structure / business id for GO (nil for soldiers)
local guideRawTitle = ""
local guideRawTitleShort: string? = nil -- the title with TycoonMath.ShortName (used when the full one does not fit)
local guideRawHint = ""
local guideRawHintShort: string? = nil -- the Build hint without its unlock part (used when the full one does not fit)
local guideGoText = ""
local guideHiddenUntil = -math.huge -- Hide: os.clock() until the chip may show again
local etaDeadline: number? = nil -- Earn: os.clock() when wallet + ATM should cover the cost
local autoGuidedFor: string? = nil -- the pick GO already fired for (auto or tapped): auto-guide once per pick
local idleAnchor: Vector3? = nil
local idleSince = 0.0
local lastReaim = -math.huge

local function attrNum(name: string, default: number): number
	local v = tonumber(player:GetAttribute(name) :: any)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

-- the chip wants to be up (HudLayout adds ChipRule: inside the own plot, no Tutorial / Modal / Driving / Dead /
-- RecentCombat / AtConsole)
local function guideWanted(): boolean
	return GUIDE.Enabled
		and (tutorialDone or GUIDE.ShowAfterTutorial == false)
		and not stepActive
		and guideKind ~= nil
		and os.clock() >= guideHiddenUntil
end

local function layoutGuideChip()
	local c, title, hint, go, face, hide = guideChip, guideTitle, guideHint, guideGoBtn, guideGoFace, guideHideBtn
	if not (c and title and hint and go and face and hide) then
		return
	end
	local w = chipWidthV()
	local h = OBJ.Height
	c.Size = UDim2.fromOffset(w, h)
	local faceW = math.max(GO_FACE.X, math.ceil(measure(guideGoText, OBJ.TitleSize, HudConfig.Fonts.Display, 1000).X) + GO_FACE_PAD)
	face.Size = UDim2.fromOffset(faceW, GO_FACE.Y)
	face.Text = guideGoText
	local goW = math.max(goHitV(), faceW + 8)
	local hideW = skipHitV()
	go.Size = UDim2.fromOffset(goW, h)
	go.Position = UDim2.new(1, -(PAD_R + hideW), 0.5, 0)
	hide.Size = UDim2.fromOffset(hideW, h)
	local textW = math.max(60, w - GUIDE_PAD_L - TEXT_GAP - goW - hideW - PAD_R)

	local rawTitle = guideRawTitle
	local shortTitle = guideRawTitleShort
	-- a long name ("NEXT: Special Forces Facility Lv 2") falls back to its short name so the level stays readable
	if shortTitle ~= nil and lineCount(rawTitle, OBJ.TitleSize, HudConfig.Fonts.Display, textW) > 1 then
		rawTitle = shortTitle
	end
	title.Text = fitText(rawTitle, OBJ.TitleSize, HudConfig.Fonts.Display, textW, 1)
	local raw = guideRawHint
	local short = guideRawHintShort
	-- spec v72 §3: when the hint does not fit one 20 v line, drop the unlock part (TextService fit test)
	if short ~= nil and lineCount(raw, OBJ.HintSize, HudConfig.Fonts.Body, textW) > 1 then
		raw = short
	end
	hint.Text = fitText(raw, OBJ.HintSize, HudConfig.Fonts.Body, textW, 1)
	local blockH = TITLE_H + OBJ.HintSize + 2
	local top = math.max(3, math.floor((h - blockH) / 2))
	title.Position = UDim2.fromOffset(GUIDE_PAD_L, top)
	title.Size = UDim2.fromOffset(textW, TITLE_H)
	hint.Position = UDim2.fromOffset(GUIDE_PAD_L, top + TITLE_H)
	hint.Size = UDim2.fromOffset(textW, OBJ.HintSize + 2)
end

--[[ Rebuild the chip's copy from WE_NextBuy + the money attributes. recompute = money / pick changed (restart the
	"ready in" countdown from the new numbers); the 1 Hz tick passes false and only counts the deadline down. ]]
local function renderGuide(recompute: boolean)
	local c = guideChip
	if not c then
		return
	end
	local rawPick = player:GetAttribute("WE_NextBuy")
	local pick = if typeof(rawPick) == "string" then rawPick else ""
	if pick ~= guidePick then
		guidePick = pick
		etaDeadline = nil
		recompute = true
	end
	local id, level = TycoonMath.Decode(pick)
	local mult = attrNum("WE_IncomeMult", 1)
	if mult <= 0 then
		mult = 1
	end
	local kind: GuideKind? = nil
	local action: GuideAction? = nil
	local title, hint, goText = "", "", GT.ChipGo
	local titleShort: string? = nil
	local hintShort: string? = nil
	if id ~= nil and id == GUIDE.SoldierCandidateId then
		kind, action, goText = "Soldier", "Army", GT.SoldierGo
		title = GT.SoldierTitle
		hint = string.format(GT.SoldierHint, TycoonMath.ShortCash(SoldierConfig.RecruitCostCash),
			TycoonMath.PerSecText(TycoonMath.SoldierGainPerTick(), mult))
	elseif id ~= nil and level >= 1 then
		local cost = TycoonMath.NextCost(id, level - 1)
		if cost ~= nil then
			local gain = TycoonMath.PerSecText(TycoonMath.StepGainPerTick(id, level - 1, mult))
			local name = TycoonMath.DisplayName(id)
			title = if level <= 1 then string.format(GT.ChipTitle, name) else string.format(GT.ChipTitleUpgrade, name, level)
			local sname = TycoonMath.ShortName(id)
			titleShort = if level <= 1 then string.format(GT.ChipTitle, sname) else string.format(GT.ChipTitleUpgrade, sname, level)
			local state, short, eta = TycoonMath.MoneyState(cost, attrNum("WE_Cash", 0), attrNum("WE_PendingCash", 0), attrNum("WE_IncomePerSec", 0))
			local price = TycoonMath.ShortCash(cost)
			if state == "Collect" then
				kind, action, goText = "Collect", "Atm", GT.ChipGoCollect
				hint = string.format(GT.ChipHintCollect, TycoonMath.ShortCash(short))
				etaDeadline = nil
			elseif state == "Earn" and eta ~= nil then
				kind, action = "Earn", "Console"
				local now = os.clock()
				if recompute or etaDeadline == nil then
					etaDeadline = now + eta
				end
				local left = math.max(1, (etaDeadline or now) - now)
				hint = string.format(GT.ChipHintEarning, gain, TycoonMath.FormatEta(left))
			else
				-- Buy (or Earn with no income yet: price + gain, no countdown)
				kind = if state == "Buy" then "Build" else "Earn"
				action = "Console"
				etaDeadline = nil
				hint = string.format(GT.ChipHintBuy, price, gain)
				local unlock = if state == "Buy" then TycoonMath.UnlockText(id, level) else nil
				if unlock ~= nil then
					hintShort = hint
					hint = string.format(GT.ChipHintBuyUnlock, price, gain, unlock)
				end
			end
		end
	end
	guideKind, guideAction = kind, action
	guideId = if action == "Console" then id else nil
	if title ~= guideRawTitle or titleShort ~= guideRawTitleShort or hint ~= guideRawHint or hintShort ~= guideRawHintShort
		or goText ~= guideGoText then
		guideRawTitle, guideRawTitleShort, guideRawHint, guideRawHintShort, guideGoText = title, titleShort, hint, hintShort, goText
		layoutGuideChip()
	end
	HudLayout.RefreshVisibility(c)
end

-- where GO / ATM leads: the own console (part on this client, else the server stamp) or the own ATM
local function guideTargetPos(): Vector3?
	if guideAction == "Atm" then
		local pos = player:GetAttribute("WE_AtmPos")
		if typeof(pos) == "Vector3" then
			return pos
		end
		local atm = if myPlotId ~= nil then nearestOwnTagged(Constants.Tags.MoneyCollector, myPlotId, originPos()) else nil
		return if atm then atm.Position else nil
	end
	local sid = guideId
	if guideAction == "Console" and sid ~= nil then
		local part = if myPlotId ~= nil then ConsoleLocator.Find(myPlotId, sid) else nil
		if part then
			return part.Position
		end
		local pos = player:GetAttribute("WE_ConsolePos_" .. sid)
		if typeof(pos) == "Vector3" then
			return pos
		end
	end
	return nil
end

local function toastWarn(text: string)
	local ok, NotificationController = pcall(function()
		return require(script.Parent.NotificationController) :: any
	end)
	if ok and NotificationController and NotificationController.Show then
		NotificationController.Show(text, "Warn", 2.5)
	end
end

-- GO / ATM / ARMY. Every line leads to the player's OWN plot (ConsoleWaypoint: own console / own ATM).
local function runGuideGo(auto: boolean)
	autoGuidedFor = guidePick
	local action = guideAction
	if action == "Army" then
		local ok, ArmyController = pcall(function()
			return require(script.Parent.ArmyController) :: any
		end)
		if ok and ArmyController and ArmyController.Open then
			ArmyController.Open()
		end
	elseif action == "Atm" then
		ConsoleWaypoint.ShowAtm(myPlotId)
	elseif action == "Console" and guideId ~= nil then
		if not ConsoleWaypoint.Show(guideId, myPlotId) and not auto then
			local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
			toastWarn(ConsoleBuyConfig.Text.NoConsole)
		end
	end
end

local function rootPos(): Vector3?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	return if hrp and hrp:IsA("BasePart") then hrp.Position else nil
end

-- F6: does the active step point at a part in the world? (a console, the own spawn / ATM / dropper, a zone; the
-- Recruit and 4x4 steps open a panel instead). Per-player targets need the plot id first.
local function stepHasWorldTarget(): boolean
	local id = currentStepId
	if id == "Outpost" then
		return true
	end
	if myPlotId == nil then
		return false
	end
	return currentPadStructureId ~= nil or id == "ClaimBase" or id == "Income" or id == "ClickDropper"
end

-- 1 Hz (EtaRefreshHz): the tutorial target re-aim (always); with the guide flag also the "ready in" countdown,
-- Hide expiry and auto-guide
local function guideTick()
	local now = os.clock()
	local hp = highlightPart
	if streamingOn() then
		-- C1: on Terrain -> swap to the part once it streams in; on a part that left Workspace (a streamed-out Atomic
		-- model keeps the part's Parent) or no beam yet -> re-aim
		if stepActive and stepHasWorldTarget() and now - lastReaim >= REAIM_SECONDS then
			if terrainEnd then
				lastReaim = now
				refreshTerrainEnd()
			elseif hp == nil or not hp:IsDescendantOf(Workspace) then
				lastReaim = now
				setWaypoint(currentMarkerName, currentPadStructureId)
			end
		end
	elseif stepActive and (hp == nil or hp.Parent == nil) and stepHasWorldTarget() and now - lastReaim >= REAIM_SECONDS then
		lastReaim = now
		setWaypoint(currentMarkerName, currentPadStructureId)
	end
	local c = guideChip
	if not (GUIDE.Enabled and c) then
		return
	end
	renderGuide(false)
	local pos = rootPos()
	if not (c.Visible and pos) then
		idleAnchor = nil -- idle only counts while the chip is on screen
		return
	end
	local p = pos :: Vector3
	local anchor = idleAnchor
	if anchor == nil or (p - anchor).Magnitude > IDLE_MOVE_STUDS then
		idleAnchor = p
		idleSince = now
		return
	end
	if ObjectiveMarker.Current() ~= nil then
		return -- a job / mission GO is up: the automatic guide line never replaces it (the latest GO wins)
	end
	if (guideKind == "Build" or guideKind == "Collect") and guidePick ~= "" and autoGuidedFor ~= guidePick
		and now - idleSince >= GUIDE.AutoGuideIdleSeconds and ConsoleWaypoint.Current() == nil then
		local target = guideTargetPos()
		if target and Vector3.new(target.X - p.X, 0, target.Z - p.Z).Magnitude > GUIDE.AutoGuideMinStuds then
			runGuideGo(true)
		end
	end
end

local function buildGuideChip(screen: ScreenGui)
	local c = Instance.new("Frame")
	c.Name = "Guide"
	c.AnchorPoint = Vector2.new(0.5, 0)
	c.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top) -- Y is rewritten by HudLayout's top stack
	c.Size = UDim2.fromOffset(chipWidthV(), OBJ.Height)
	c.BackgroundColor3 = HudConfig.Colors.PillBg
	c.BackgroundTransparency = 0.16
	c.BorderSizePixel = 0
	c.Active = true -- taps on the chip never fall through to the world
	c.Visible = false
	c.ZIndex = 2
	c.Parent = screen
	UIUtil.Corner(c, CORNER)
	UIUtil.Stroke(c, GOLD, 2)
	guideChip = c

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Font = HudConfig.Fonts.Display
	title.TextSize = OBJ.TitleSize
	title.TextColor3 = GOLD
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = ""
	title.Active = false
	title.ZIndex = 3
	title.Parent = c
	UIUtil.TextOutline(title, 1.4)
	guideTitle = title

	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.BackgroundTransparency = 1
	hint.Font = HudConfig.Fonts.Body
	hint.TextSize = OBJ.HintSize
	hint.TextColor3 = HudConfig.Colors.White
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextYAlignment = Enum.TextYAlignment.Center
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	hint.Text = ""
	hint.Active = false
	hint.ZIndex = 3
	hint.Parent = c
	guideHint = hint

	-- GO / ATM / ARMY: a touch-size hit area around a gold face (the face widens for "ARMY")
	local go = Instance.new("TextButton")
	go.Name = "Go"
	go.AnchorPoint = Vector2.new(1, 0.5)
	go.BackgroundTransparency = 1
	go.BorderSizePixel = 0
	go.AutoButtonColor = false
	go.Text = ""
	go.Active = true
	go.ZIndex = 3
	go.Parent = c
	local face = Instance.new("TextLabel")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromOffset(GO_FACE.X, GO_FACE.Y)
	face.BackgroundColor3 = GOLD
	face.BorderSizePixel = 0
	face.Font = HudConfig.Fonts.Display
	face.TextSize = OBJ.TitleSize
	face.TextColor3 = DARK_INK
	face.Text = GT.ChipGo
	face.Active = false
	face.ZIndex = 4
	face.Parent = go
	UIUtil.Corner(face, 12)
	local faceStroke = UIUtil.Stroke(face, Color3.fromRGB(107, 77, 0), 2)
	faceStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local press = Instance.new("UIScale")
	press.Parent = face
	go.MouseButton1Down:Connect(function()
		press.Scale = HudConfig.Rail.PressScale
	end)
	go.MouseButton1Up:Connect(function()
		press.Scale = 1
	end)
	go.MouseLeave:Connect(function()
		press.Scale = 1
	end)
	go.Activated:Connect(function()
		press.Scale = 1
		runGuideGo(false)
	end)
	guideGoBtn = go
	guideGoFace = face
	HudLayout.AssertTouchTarget(go, "Guide.GO")

	-- Hide: one tap, HideSeconds or until the next successful purchase acknowledgement
	local hide = Instance.new("TextButton")
	hide.Name = "Hide"
	hide.AnchorPoint = Vector2.new(1, 0.5)
	hide.Position = UDim2.new(1, -PAD_R, 0.5, 0)
	hide.BackgroundTransparency = 1
	hide.BorderSizePixel = 0
	hide.AutoButtonColor = false
	hide.Text = ""
	hide.Active = true
	hide.ZIndex = 3
	hide.Parent = c
	local hl = Instance.new("TextLabel")
	hl.Name = "Label"
	hl.BackgroundTransparency = 1
	hl.Size = UDim2.fromScale(1, 1)
	hl.Font = HudConfig.Fonts.Body
	hl.TextSize = OBJ.HintSize
	hl.TextColor3 = HudConfig.Colors.White
	hl.TextTransparency = 0.35
	hl.Text = GT.ChipHide
	hl.Active = false
	hl.ZIndex = 4
	hl.Parent = hide
	hide.Activated:Connect(function()
		guideHiddenUntil = os.clock() + GUIDE.HideSeconds
		HudLayout.RefreshVisibility(c)
	end)
	guideHideBtn = hide
	HudLayout.AssertTouchTarget(hide, "Guide.Hide")

	HudLayout.BindVisibility(c, GUIDE.ChipRule, guideWanted)
	HudLayout.RegisterTopStack("Guide", c, HudConfig.TopStack.Order.Objective, { Space = "Hud" })
	HudLayout.LayoutChanged:Connect(layoutGuideChip)
	layoutGuideChip()
end

local function refreshGuideVisibility()
	local c = guideChip
	if c then
		HudLayout.RefreshVisibility(c)
	end
end

function TutorialController.Init()
	local pg = player:WaitForChild("PlayerGui")
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireTutorial"
	-- Core safe insets + the one HUD UIScale; DisplayOrder from HudConfig (50, under the HUD rail / TopStrip)
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = pg
	_gui = screen
	buildChip(screen)

	Remotes.BindEvent(Constants.RemoteNames.TutorialStateUpdate, applyState)

	-- v69: the plot id arrives as state.Base.PlotId / BaseStatePayload.PlotId. The payload never had a top-level
	-- BasePlotId, so myPlotId stayed nil and the beam could pick another player's pad. nil = no plot (server full).
	local function applyPlotId(plotId: any)
		if typeof(plotId) ~= "number" or plotId == myPlotId then
			return
		end
		myPlotId = plotId
		-- P0-6: every per-player target (spawn, ATM, dropper, console) needs the plot: re-aim once it is known
		if stepActive then
			task.defer(function()
				setWaypoint(currentMarkerName, currentPadStructureId)
			end)
		end
	end

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: any)
		if typeof(state) ~= "table" then
			return
		end
		if state.TutorialComplete == true then
			setVisible(false)
		end
		if typeof(state.Base) == "table" then
			applyPlotId(state.Base.PlotId)
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: any)
		if typeof(base) == "table" then
			applyPlotId(base.PlotId)
		end
	end)

	-- C1 F6 (streaming only): the zone state the Outpost pick reads while zones are streamed out (the list is kept by
	-- reference; the pick reads it at most every REAIM_SECONDS)
	if streamingOn() then
		Remotes.BindEvent(Constants.RemoteNames.TerritoryStateUpdate, function(payload: any)
			if typeof(payload) == "table" and typeof(payload.Territories) == "table" then
				zoneList = payload.Territories
			end
		end)
	end

	player.CharacterAdded:Connect(function()
		if currentMarkerName and stepActive then
			task.defer(function()
				setWaypoint(currentMarkerName, currentPadStructureId)
			end)
		end
	end)

	-- v72 F5: markers / arrows that replicate later start hidden (events only)
	if HIDE_MARKER_DRESSING then
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.TutorialMarker)) do
			watchMarker(inst)
		end
		CollectionService:GetInstanceAddedSignal(Constants.Tags.TutorialMarker):Connect(watchMarker)
		-- streamed out (no Destroying on the client): drop the watch; a marker streamed back in is watched again
		CollectionService:GetInstanceRemovedSignal(Constants.Tags.TutorialMarker):Connect(unwatchMarker)
	end

	-- v72 tycoon guide
	if GUIDE.Enabled then
		buildGuideChip(screen)
		Remotes.BindEvent(Constants.RemoteNames.TutorialStateUpdate, function(payload: any)
			if typeof(payload) == "table" then
				tutorialDone = payload.Complete == true
				refreshGuideVisibility()
			end
		end)
		Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: any)
			if typeof(state) == "table" and typeof(state.TutorialComplete) == "boolean" then
				tutorialDone = state.TutorialComplete
				refreshGuideVisibility()
			end
		end)
		for _, name in ipairs({ "WE_NextBuy", "WE_Cash", "WE_PendingCash", "WE_IncomePerSec", "WE_IncomeMult" }) do
			player:GetAttributeChangedSignal(name):Connect(function()
				renderGuide(true)
			end)
		end
		-- Hide lasts until the next successful purchase acknowledgement (BaseService stamps WE_BuyOk before WE_BuyAck)
		player:GetAttributeChangedSignal("WE_BuyAck"):Connect(function()
			if player:GetAttribute("WE_BuyOk") == true then
				guideHiddenUntil = -math.huge
				refreshGuideVisibility()
			end
		end)
		renderGuide(true)
	end
	-- 1 Hz tick (the tutorial re-aim runs whatever the guide flag; the guide parts no-op while it is off)
	task.spawn(function()
		local period = 1 / math.max(GUIDE.EtaRefreshHz or 1, 0.1)
		local warned = false
		while true do
			task.wait(period)
			local ok, err = pcall(guideTick :: () -> any)
			if not ok and not warned then
				warned = true
				warn("[Tutorial] guide tick failed:", err)
			end
		end
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="212">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Root UI coordinator (v70 "clean screen"): inits every controller, binds the left rail (5 tiles — no Base,
	no Settings tile, no "opened" toast), the TopStrip settings gear and cash + chip, registers every panel
	with HudLayout (one open at a time → the Modal flag) and routes interior terminals (WE_OpenPanel) to panels.
]]

local UIController = {}

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local AudioController = require(script.Parent.Parent.Modules.AudioController)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local BaseController = require(script.Parent.BaseController)
local TutorialController = require(script.Parent.TutorialController)
local TerritoryController = require(script.Parent.TerritoryController)
local MissionController = require(script.Parent.MissionController)
local ShopController = require(script.Parent.ShopController)
local ProgressionController = require(script.Parent.ProgressionController)
local ArmyController = require(script.Parent.ArmyController)
local OrdersController = require(script.Parent.OrdersController)
local SettingsController = require(script.Parent.SettingsController)
local WorldPromptController = require(script.Parent.WorldPromptController)
local CompassController = require(script.Parent.CompassController)
local VehicleController = require(script.Parent.VehicleController)
local BankRaidController = require(script.Parent.BankRaidController)
local ResearchController = require(script.Parent.ResearchController) -- v69 Research Lab upgrades
local MissileController = require(script.Parent.MissileController) -- v69 Command Center strikes

-- v70 custom ProximityPrompt pills (spec §3.5). Required defensively: a missing or broken module must leave
-- Roblox's Default prompt style in place (spec risk #2), never take the rest of the UI down with it.
local PromptController: any = nil
do
	local mod = script.Parent:FindFirstChild("PromptController")
	if mod and mod:IsA("ModuleScript") then
		local req: any = require
		local ok, res = pcall(req, mod)
		if ok and typeof(res) == "table" then
			PromptController = res
		else
			warn("[WAR EMPIRE] PromptController failed to load — Default prompt style kept:", res)
		end
	end
end

-- Nations (lane C): the "Choose your nation" picker. Required defensively like PromptController: a missing or broken
-- picker must never take the other panels down with it (the flagpole prompt then just warns "unknown panel").
local NationController: any = nil
do
	local mod = script.Parent:FindFirstChild("NationController")
	if mod and mod:IsA("ModuleScript") then
		local req: any = require
		local ok, res = pcall(req, mod)
		if ok and typeof(res) == "table" then
			NationController = res
		else
			warn("[WAR EMPIRE] NationController failed to load — nation picker off:", res)
		end
	end
end

-- Every panel HudLayout keeps exclusive (spec §3.8). A controller that registers itself wins; UIController files a
-- Fallback registration (IsOpen / Close) for the rest. "Orders" = the Army popover (OrdersController).
local PANELS: { { Id: string, Controller: any } } = {
	{ Id = "Shop", Controller = ShopController },
	{ Id = "Rebirth", Controller = ProgressionController },
	{ Id = "Missions", Controller = MissionController },
	{ Id = "Army", Controller = ArmyController },
	{ Id = "Orders", Controller = OrdersController },
	{ Id = "Garage", Controller = VehicleController },
	{ Id = "Settings", Controller = SettingsController },
	{ Id = "Base", Controller = BaseController },
	{ Id = "Research", Controller = ResearchController },
	{ Id = "Missiles", Controller = MissileController },
}
if NationController then
	table.insert(PANELS, { Id = "Nation", Controller = NationController }) -- nations: the country picker
end

local function panelController(id: string): any
	for _, p in ipairs(PANELS) do
		if p.Id == id then
			return p.Controller
		end
	end
	return nil
end

local function controllerIsOpen(ctrl: any): boolean
	local f = ctrl and ctrl.IsOpen
	if typeof(f) ~= "function" then
		return false
	end
	local ok, open = pcall(f)
	return ok and open == true
end

local function registerPanels()
	for _, p in ipairs(PANELS) do
		local ctrl = p.Controller
		if not HudLayout.HasPanel(p.Id) and typeof(ctrl.IsOpen) == "function" and typeof(ctrl.Close) == "function" then
			HudLayout.RegisterPanel(p.Id, function(): boolean
				return controllerIsOpen(ctrl)
			end, function()
				ctrl.Close()
			end, { Fallback = true })
		end
	end
end

-- After an opener ran, tell HudLayout what the panel now reports — only for a panel that did not report itself
-- (see runOpener), so the fallback never races the panel's own PanelOpened / PanelClosed.
local function syncPanel(id: string)
	local ctrl = panelController(id)
	if not ctrl or typeof(ctrl.IsOpen) ~= "function" then
		return
	end
	if controllerIsOpen(ctrl) then
		HudLayout.PanelOpened(id)
	else
		HudLayout.PanelClosed(id)
	end
end

-- Run a panel opener; if the panel made no PanelOpened / PanelClosed call of its own (HudLayout.PanelSerial
-- unchanged, checked one deferred step later so a deferred self-report still counts), sync it from IsOpen.
local function runOpener(panelId: string?, fn: (...any) -> (), ...: any): (boolean, any)
	local serial = HudLayout.PanelSerial()
	local ok, err = pcall(fn :: any, ...)
	if panelId then
		local id: string = panelId
		task.defer(function()
			if HudLayout.PanelSerial() == serial then
				syncPanel(id)
			end
		end)
	end
	return ok, err
end

-- PromptController.Init failed half-way: put every prompt back on Roblox's own UI so nothing becomes unusable.
local function restoreDefaultPrompts()
	pcall(function()
		if PromptController and typeof(PromptController.Shutdown) == "function" then
			PromptController.Shutdown()
		end
	end)
	pcall(function()
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Style ~= Enum.ProximityPromptStyle.Default then
				d.Style = Enum.ProximityPromptStyle.Default
			end
		end
	end)
end

function UIController.Init()
	local function safeInit(name: string, fn: () -> ()): boolean
		local ok, err = pcall(fn :: any)
		if not ok then
			warn("[WAR EMPIRE] UI Init failed:", name, err)
		end
		return ok
	end
	safeInit("Audio", AudioController.Init)
	-- v60: HUD + WorldPrompt BEFORE Notification — cash never waits on toast remote
	safeInit("HUD", HUDController.Init)
	safeInit("WorldPrompt", WorldPromptController.Init)
	safeInit("Notification", NotificationController.Init)
	if PromptController and typeof(PromptController.Init) == "function" then
		if not safeInit("Prompt", PromptController.Init) then
			restoreDefaultPrompts()
		end
	end
	safeInit("Base", BaseController.Init)
	safeInit("Tutorial", TutorialController.Init)
	safeInit("Territory", TerritoryController.Init)
	safeInit("Mission", MissionController.Init)
	safeInit("Shop", ShopController.Init)
	safeInit("Progression", ProgressionController.Init)
	safeInit("Army", ArmyController.Init)
	safeInit("Orders", OrdersController.Init)
	safeInit("Settings", SettingsController.Init)
	safeInit("Compass", CompassController.Init)
	safeInit("BankRaid", BankRaidController.Init)
	safeInit("Research", ResearchController.Init)
	safeInit("Missiles", MissileController.Init)
	if NationController and typeof(NationController.Init) == "function" then
		safeInit("Nation", NationController.Init) -- nations: join picker (auto-open) + flagpole / Settings opener
	end
	safeInit("Panels", registerPanels)

	-- Rail / gear / cash + press: the opener, ONE click sound, no toast (the panel opening is the feedback).
	local function dockPress(label: string, toggleFn: () -> (), panelId: string?)
		pcall(AudioController.PlayClick)
		local ok, err = runOpener(panelId, toggleFn :: any)
		if not ok then
			warn("[WAR EMPIRE] rail open failed:", label, err)
		end
	end

	-- Cash + (the TopStrip chip since the mobile merge gate) → Shop cash packs (ShopController.OpenCashPacks when
	-- present, else the Shop)
	HUDController.BindShopOpener(function()
		local shop: any = ShopController
		local open: () -> () = if typeof(shop.OpenCashPacks) == "function" then shop.OpenCashPacks else ShopController.Open
		dockPress("Shop", open, "Shop")
	end)
	-- TopStrip gear → Settings (no rail tile, no key)
	HUDController.BindSettingsOpener(function()
		dockPress("Settings", SettingsController.Toggle, "Settings")
	end)

	-- Left rail (spec §3.2): Shop · Rebirth · Army · Garage · Missions. Labels, icons and colours come from
	-- HudConfig.Rail.Tiles; v69's 7-tile dock ({ Name = "DockMissions", Label = "MISSIONS" } …, BASE, SETTINGS)
	-- is gone — Base opens from B / the Command Center terminal, Settings from the TopStrip gear.
	HUDController.BindActionBar({
		{
			Id = "Shop",
			Name = "DockShop",
			OnClick = function()
				dockPress("Shop", ShopController.Toggle, "Shop")
			end,
		},
		{
			Id = "Rebirth",
			Name = "DockRebirth",
			OnClick = function()
				dockPress("Rebirth", ProgressionController.Toggle, "Rebirth")
			end,
		},
		{
			Id = "Army",
			Name = "DockArmy",
			OnClick = function()
				-- the Army popover (OrdersController, spec §3.8); the full Army panel until it exists
				local orders: any = OrdersController
				if typeof(orders.Toggle) == "function" then
					dockPress("Army", orders.Toggle, "Orders")
				else
					dockPress("Army", ArmyController.Toggle, "Army")
				end
			end,
			-- mobile plan P1-6: hold the Army tile to cycle the squad order (the touch twin of T), no popover
			OnLongPress = function()
				local orders: any = OrdersController
				if typeof(orders.CycleOrder) == "function" then
					pcall(AudioController.PlayClick)
					orders.CycleOrder()
				end
			end,
		},
		{
			Id = "Garage",
			Name = "DockGarage",
			OnClick = function()
				dockPress("Garage", VehicleController.Toggle, "Garage")
			end,
		},
		{
			Id = "Missions",
			Name = "DockMissions",
			OnClick = function()
				dockPress("Missions", MissionController.Toggle, "Missions")
			end,
		},
	})
	print("[WAR EMPIRE] UIController: rail bound (Shop/Rebirth/Army/Garage/Missions) + TopStrip gear")

	-- v68: item terminals inside walk-in buildings (server HollowBuildingBuilder + Interiors/*) carry the
	-- panel to open in the prompt attribute WE_OpenPanel. Keep this list in sync with the interior checker.
	local panelOpeners: { [string]: (...any) -> () } = {
		Base = BaseController.Open,
		Shop = ShopController.Open,
		Rebirth = ProgressionController.Open,
		Missions = MissionController.Open,
		Army = ArmyController.Open,
		Garage = VehicleController.Open,
		Settings = SettingsController.Open,
		Research = ResearchController.Open,
		Missiles = MissileController.Open,
	}
	-- nations: the flagpole prompt (server, WE_OpenPanel = "Nation", WE_OpenTab = "flagpole") opens the picker
	if NationController and typeof(NationController.Open) == "function" then
		panelOpeners.Nation = NationController.Open
	end
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if who ~= Players.LocalPlayer then
			return
		end
		local panel = prompt:GetAttribute("WE_OpenPanel")
		if typeof(panel) ~= "string" then
			return
		end
		local open = panelOpeners[panel]
		if not open then
			warn("[WAR EMPIRE] terminal opens unknown panel:", panel)
			return
		end
		pcall(AudioController.PlayClick)
		-- optional tab hint on the prompt (e.g. the Armory counter opens Shop → Weapons)
		local tab = prompt:GetAttribute("WE_OpenTab")
		local ok, err
		if typeof(tab) == "string" and panel == "Shop" and ShopController.OpenTab then
			ok, err = runOpener(panel, ShopController.OpenTab :: any, tab)
		else
			ok, err = runOpener(panel, open, if typeof(tab) == "string" then tab else nil)
		end
		if not ok then
			warn("[WAR EMPIRE] terminal panel failed:", panel, err)
		end
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="213">
            <Properties>
              <string name="Name">VehicleController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Phase 4/7 — Garage UI (G). Spawn / buy / despawn requests only.
	Category + rarity + Owned filters for large roster (~99). ScrollingFrame AutomaticCanvasSize.
	Empty states via UIUtil.EmptyState.
	Mobile: ≥48px filter chips, ≥52px row actions, Activated (not MouseButton1 only),
	responsive panel, clear empty / filter-empty / no-owned banners.

	v70 (garage audit G4):
	  * Rows show why a vehicle is locked ("LOCKED\nLv 10", "Depot L2", "Prestige 5", "Rebirth") instead of an
	    active gold BUY; tapping a locked / unaffordable row explains it and sends nothing.
	  * No periodic rebuild: the cooldown ticker only repaints buttons in place. Rows are rebuilt only on open,
	    on a filter change, or when owned ids / the active vehicle / the unlock gates change (debounced 0.25 s).
	  * Remotes only via Remotes.BindEvent / Remotes.FireServer (never a blocking GetEvent).
	  * Sort: active, owned, buyable, can't afford, locked. Open(tab) presets the category (terminal WE_OpenTab).
	  * Touch: the panel closes once the requested vehicle is deployed.
	  * Init also starts VehicleDriveClient (the client half of drivable vehicles) and, in a pcall,
	    VehicleCombatClient (W2: vehicle HP bars + wreck burst).
	  * W2: a destroyed vehicle's row reads "REPAIR n s" (VehicleStateUpdate.Repairing) until it can be redeployed.

	v70 "clean screen" HUD (spec §3.7 / §3.8):
	  * No desktop GARAGE toggle: the rail's Garage tile, G (HudConfig.Keys.Garage), the vehicle-pad prompt and
	    the Vehicle Depot terminal open it. A registered Modal panel (HudLayout id "Garage") with the black dim.
	  * One HUD scale + safe area (PanelShell / HudLayout.ApplyScreen). Touch: one row of 64 v filter chips (the
	    rarity chip cycles), 64 v row buttons, ≥ 16 v text.
	  * Rail badge "!" (NewVehicle) while a vehicle bought this session has not been spawned; cleared on open.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local UIUtil = require(Shared.Util.UIUtil)
local VehicleConfig = require(Shared.Configs.VehicleConfig)

local HudConfig = require(Shared.Configs.HudConfig)

local AudioController = require(script.Parent.Parent.Modules.AudioController)
local VehicleDriveClient = require(script.Parent.Parent.Modules.VehicleDriveClient)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
local PanelShell = require(script.Parent.Parent.Modules.PanelShell)

type VehicleDef = VehicleConfig.VehicleDef

export type Gates = {
	Level: number,
	Prestige: number,
	Structures: { [string]: number },
	Rebirth: { [string]: boolean },
}

export type RowCtx = {
	Owned: any, -- { [id]: true } map (or a boolean for this row)
	ActiveId: string?,
	Cooldown: number,
	Gates: Gates?,
	Cash: number?,
	Repairing: { [string]: number }?, -- W2: destroyed ids → seconds until redeploy (VehicleStateUpdate.Repairing)
}

export type RowState = {
	Kind: string, -- Despawn | Repairing | Cooldown | Spawn | Locked | CantAfford | Buy | Claim
	Text: string,
	Enabled: boolean,
	Reason: string?, -- Locked: short reason
	Need: number?, -- CantAfford: cash missing
}

local VehicleController = {}

local PANEL_ID = "Garage"

local player = Players.LocalPlayer
local isTouch = UserInputService.TouchEnabled
local shell: PanelShell.Shell? = nil

-- v70 rail badge (HudConfig.Rail.BadgeSources.Garage = "NewVehicle"): "!" while a vehicle bought / granted this
-- session has not been spawned yet; opening the Garage clears it. The join sync (incl. a late starter 4x4 merge)
-- never counts as new.
local NEW_VEHICLE_GRACE_SECONDS = 10
local newVehicleIds: { [string]: boolean } = {}
local ownedSyncedAt: number? = nil

local screenGui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local cooldownLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local panelFrame: Frame? = nil
local isOpen = false
local paintFilters: (() -> ())? = nil

local ownedMap: { [string]: boolean } = {}
local activeId: string? = nil
local cooldownLeft = 0
local repairingMap: { [string]: number } = {} -- W2: vehicle id → seconds of repair left (the 0.5 s ticker counts down)
local gates: Gates = { Level = 1, Prestige = 0, Structures = {}, Rebirth = {} }
local filterCategory: string = "All" -- All | Ground | Air | Naval
local filterRarity: string = "All" -- All | Common | Uncommon | Rare | Epic | Legendary
local filterOwnedOnly = false
local rarityColors: { [string]: Color3 } = {
	Common = Color3.fromRGB(160, 165, 170),
	Uncommon = Color3.fromRGB(90, 180, 110),
	Rare = Color3.fromRGB(80, 140, 220),
	Epic = Color3.fromRGB(170, 90, 220),
	Legendary = Color3.fromRGB(230, 170, 60),
}

-- rows currently on screen: every row's action button, and the owned (spawn / cooldown) subset
local rowButtons: { [string]: TextButton } = {}
local spawnButtons: { [string]: TextButton } = {}
local buyingUntil: { [string]: number } = {}
local lastBuiltSig = ""
local rebuildPending = false
local repaintPending = false
local lastSpawnRequestedId: string? = nil

local STRUCTURE_SHORT: { [string]: string } =
	{ VehicleDepot = "Depot", Helipad = "Helipad", Airfield = "Airfield", Dock = "Dock" }
local STRUCTURE_LONG: { [string]: string } =
	{ VehicleDepot = "Vehicle Depot", Helipad = "Helipad", Airfield = "Airfield", Dock = "Dock" }
local KIND_RANK: { [string]: number } =
	{ Despawn = 0, Repairing = 1, Cooldown = 1, Spawn = 1, Claim = 2, Buy = 2, CantAfford = 3, Locked = 4 }

local function addCorner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

-- UIUtil.EmptyState at the panel text floor (≥ 11 real px)
local function emptyState(parent: Instance, message: string)
	local lab = UIUtil.EmptyState(parent, message, 0)
	lab.TextSize = PanelShell.Text(13)
	lab.Size = UDim2.new(1, -8, 0, PanelShell.Text(13) * 3 + 8)
	lab.Font = Enum.Font.GothamMedium
end

local function commas(n: number): string
	local s = tostring(math.floor(math.max(0, n) + 0.5))
	local out = s
	while true do
		local k
		out, k = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return out
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Pure row logic (tested headless)
-- ─────────────────────────────────────────────────────────────────────────────

--[[ Short lock reason for a not-owned vehicle, or nil when it can be bought. Order: level, structure,
	prestige, rebirth flag (same order as VehicleService.Purchase). ]]
function VehicleController._LockReason(def: VehicleDef, g: Gates?): string?
	if g == nil then
		return nil
	end
	if (g.Level or 1) < def.UnlockLevel then
		return "Lv " .. tostring(def.UnlockLevel)
	end
	local req = def.RequiresStructure
	if req then
		local have = (g.Structures and g.Structures[req.StructureId]) or 0
		if have < req.Level then
			return (STRUCTURE_SHORT[req.StructureId] or req.StructureId) .. " L" .. tostring(req.Level)
		end
	end
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 and (g.Prestige or 0) < needP then
		return "Prestige " .. tostring(needP)
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" and not (g.Rebirth and g.Rebirth[flag] == true) then
		return "Rebirth"
	end
	return nil
end

--[[ Long form for the status line: "<Name> needs <reason> (you have …)". ]]
function VehicleController._LockDetail(def: VehicleDef, g: Gates): string?
	local name = def.DisplayName or def.Id
	if (g.Level or 1) < def.UnlockLevel then
		return string.format("%s needs Level %d (you have Lv %d)", name, def.UnlockLevel, g.Level or 1)
	end
	local req = def.RequiresStructure
	if req then
		local have = (g.Structures and g.Structures[req.StructureId]) or 0
		if have < req.Level then
			return string.format(
				"%s needs %s L%d (you have L%d)",
				name,
				STRUCTURE_LONG[req.StructureId] or req.StructureId,
				req.Level,
				have
			)
		end
	end
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 and (g.Prestige or 0) < needP then
		return string.format("%s needs Prestige %d (you have %d)", name, needP, g.Prestige or 0)
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" and not (g.Rebirth and g.Rebirth[flag] == true) then
		return string.format("%s needs the %s rebirth unlock (you have not unlocked it yet)", name, flag)
	end
	return nil
end

function VehicleController._RowState(id: string, def: VehicleDef, ctx: RowCtx): RowState
	if ctx.ActiveId == id then
		return { Kind = "Despawn", Text = "DESPAWN", Enabled = true }
	end
	local owned = if typeof(ctx.Owned) == "table" then ctx.Owned[id] == true else ctx.Owned == true
	if owned then
		-- W2: a destroyed vehicle is locked while it is repaired (VehicleHealth repair timer)
		local rep = if ctx.Repairing then tonumber(ctx.Repairing[id]) else nil
		if rep ~= nil and rep > 0 then
			return { Kind = "Repairing", Text = string.format("REPAIR %ds", math.max(1, math.floor(rep + 0.5))), Enabled = false }
		end
		local cd = ctx.Cooldown or 0
		if cd > 0 then
			return { Kind = "Cooldown", Text = string.format("%ds", math.max(1, math.floor(cd + 0.5))), Enabled = false }
		end
		return { Kind = "Spawn", Text = "SPAWN", Enabled = true }
	end
	local reason = VehicleController._LockReason(def, ctx.Gates)
	if reason then
		return { Kind = "Locked", Text = "LOCKED\n" .. reason, Enabled = false, Reason = reason }
	end
	local price = def.CostCash or 0
	if price <= 0 then
		return { Kind = "Claim", Text = "CLAIM", Enabled = true }
	end
	local text = "BUY $" .. commas(price)
	local cash = ctx.Cash
	if cash ~= nil and cash < price then
		return { Kind = "CantAfford", Text = text, Enabled = false, Need = price - cash }
	end
	return { Kind = "Buy", Text = text, Enabled = true }
end

--[[ Each source overwrites only the fields it carries. Structures / Rebirth are full maps. ]]
function VehicleController._MergeGates(g: Gates, patch: any): Gates
	if typeof(patch) ~= "table" then
		return g
	end
	local lvl = tonumber(patch.Level)
	if lvl then
		g.Level = lvl
	end
	local pres = tonumber(patch.Prestige)
	if pres then
		g.Prestige = pres
	end
	if typeof(patch.Structures) == "table" then
		local s: { [string]: number } = {}
		for k, v in pairs(patch.Structures) do
			local n = tonumber(v)
			if typeof(k) == "string" and n then
				s[k] = n
			end
		end
		g.Structures = s
	end
	if typeof(patch.Rebirth) == "table" then
		local r: { [string]: boolean } = {}
		for k, v in pairs(patch.Rebirth) do
			if typeof(k) == "string" and v == true then
				r[k] = true
			end
		end
		g.Rebirth = r
	end
	return g
end

local function ownedSig(map: { [string]: boolean }): string
	local ids = {}
	for id, v in pairs(map) do
		if v == true then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return table.concat(ids, ",")
end

local function gatesSig(g: Gates): string
	local s: { [string]: number } = g.Structures or {}
	local flags = {}
	for k, v in pairs(g.Rebirth or {}) do
		if v == true then
			table.insert(flags, k)
		end
	end
	table.sort(flags)
	return string.format(
		"%d|%d|%d,%d,%d,%d|%s",
		g.Level or 0,
		g.Prestige or 0,
		s.VehicleDepot or 0,
		s.Helipad or 0,
		s.Airfield or 0,
		s.Dock or 0,
		table.concat(flags, ",")
	)
end

local function dataSig(): string
	return ownedSig(ownedMap) .. "#" .. tostring(activeId) .. "#" .. gatesSig(gates)
end

local function currentCtx(): RowCtx
	return {
		Owned = ownedMap,
		ActiveId = activeId,
		Cooldown = cooldownLeft,
		Gates = gates,
		Cash = tonumber(player:GetAttribute("WE_Cash")),
		Repairing = repairingMap,
	}
end

local function sortedIds(): { string }
	local ctx = currentCtx()
	local ids = {}
	local rank: { [string]: number } = {}
	for id, def in pairs(VehicleConfig.Vehicles) do
		local cat = if def then (def.Category or "Ground") else "Ground"
		local rar = if def then (def.Rarity or "Common") else "Common"
		local catOk = filterCategory == "All" or cat == filterCategory
		local rarOk = filterRarity == "All" or rar == filterRarity
		local ownedOk = not filterOwnedOnly or ownedMap[id] == true
		if catOk and rarOk and ownedOk then
			table.insert(ids, id)
			rank[id] = KIND_RANK[VehicleController._RowState(id, def, ctx).Kind] or 5
		end
	end
	table.sort(ids, function(a, b)
		local ra, rb = rank[a], rank[b]
		if ra ~= rb then
			return ra < rb
		end
		local da = VehicleConfig.Vehicles[a]
		local db = VehicleConfig.Vehicles[b]
		local la = da and da.UnlockLevel or 0
		local lb = db and db.UnlockLevel or 0
		if la == lb then
			return a < b
		end
		return la < lb
	end)
	return ids
end

local function ownedCount(): number
	local n = 0
	for _, v in pairs(ownedMap) do
		if v == true then
			n += 1
		end
	end
	return n
end

local function catalogCount(): number
	local n = 0
	for _ in pairs(VehicleConfig.Vehicles) do
		n += 1
	end
	return n
end

local lastSpawnRequestAt = -math.huge
local SPAWN_CLIENT_DEBOUNCE = 0.85
local BUYING_SECONDS = 1.5

local function setStatus(text: string)
	if statusLabel then
		statusLabel.Text = text
	end
end

local function updateCooldownLabel()
	if cooldownLabel then
		cooldownLabel.Text = if cooldownLeft > 0
			then string.format("Spawn cooldown: %ds", math.max(1, math.floor(cooldownLeft + 0.5)))
			else "Spawn ready"
	end
end

local function bindTap(btn: GuiButton, fn: () -> ())
	btn.Activated:Connect(function()
		pcall(AudioController.PlayClick)
		fn()
	end)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Painting (in place — never creates instances)
-- ─────────────────────────────────────────────────────────────────────────────
local DARK_TEXT = Color3.fromRGB(20, 22, 18)

local function paintButton(btn: TextButton, id: string, st: RowState)
	local kind = st.Kind
	local text = st.Text
	local enabled = st.Enabled
	local bg, fg = Constants.Colors.Gold, DARK_TEXT
	local textSize = PanelShell.Text(if isTouch then 14 else 13)
	local wrapped = false
	if kind == "Despawn" then
		bg, fg = Constants.Colors.Danger, Constants.Colors.Text
	elseif kind == "Spawn" then
		bg, fg = Constants.Colors.Accent, Constants.Colors.Text
	elseif kind == "Cooldown" or kind == "Repairing" then
		bg, fg = Constants.Colors.Gunmetal, Constants.Colors.Muted
	elseif kind == "Locked" then
		bg, fg = Constants.Colors.Gunmetal, Constants.Colors.Muted
		textSize = PanelShell.Text(12)
		wrapped = true
	elseif kind == "CantAfford" then
		bg, fg = Constants.Colors.Gunmetal, Constants.Colors.Gold
	end
	if (kind == "Buy" or kind == "Claim" or kind == "CantAfford") and (buyingUntil[id] or 0) > os.clock() then
		text = "BUYING…"
		enabled = false
		bg, fg = Constants.Colors.GunmetalLight, Constants.Colors.Gold
	end
	if btn.Text ~= text then
		btn.Text = text
	end
	btn.BackgroundColor3 = bg
	btn.TextColor3 = fg
	btn.TextSize = textSize
	btn.TextWrapped = wrapped
	btn.AutoButtonColor = enabled
	btn:SetAttribute("WE_Kind", kind)
	btn:SetAttribute("WE_Disabled", not enabled)
end

local function paintRow(id: string)
	local btn = rowButtons[id]
	local def = VehicleConfig.Vehicles[id]
	if btn and def and btn.Parent then
		paintButton(btn, id, VehicleController._RowState(id, def, currentCtx()))
	end
end

local function repaintAll()
	for id in pairs(rowButtons) do
		paintRow(id)
	end
	updateCooldownLabel()
end

local function repaintOwned()
	for id in pairs(spawnButtons) do
		paintRow(id)
	end
	updateCooldownLabel()
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Actions
-- ─────────────────────────────────────────────────────────────────────────────
local function fireSpawn(vehicleId: string)
	local now = os.clock()
	if now - lastSpawnRequestAt < SPAWN_CLIENT_DEBOUNCE then
		setStatus("Spawn request cooling down…")
		return
	end
	if cooldownLeft > 0 then
		setStatus(string.format("Spawn ready in %ds", math.max(1, math.floor(cooldownLeft + 0.5))))
		return
	end
	lastSpawnRequestAt = now
	lastSpawnRequestedId = vehicleId
	local def = VehicleConfig.Vehicles[vehicleId]
	setStatus("Deploying " .. (if def then def.DisplayName else vehicleId) .. "…")
	task.spawn(function()
		if not Remotes.FireServer(Constants.RemoteNames.RequestSpawnVehicle, vehicleId) then
			setStatus("Garage offline — try again in a moment")
		end
	end)
end

local function firePurchase(id: string, def: VehicleDef)
	buyingUntil[id] = os.clock() + BUYING_SECONDS
	paintRow(id)
	setStatus("Buying " .. def.DisplayName .. "…")
	task.spawn(function()
		if not Remotes.FireServer(Constants.RemoteNames.RequestPurchaseVehicle, id) then
			setStatus("Garage offline — try again in a moment")
		end
	end)
	task.delay(BUYING_SECONDS + 0.05, function()
		paintRow(id)
	end)
end

local function onRowTap(id: string)
	local def = VehicleConfig.Vehicles[id]
	if not def then
		return
	end
	local st = VehicleController._RowState(id, def, currentCtx())
	local kind = st.Kind
	if kind == "Despawn" then
		setStatus("Despawning " .. def.DisplayName .. "…")
		task.spawn(Remotes.FireServer, Constants.RemoteNames.RequestDespawnVehicle)
	elseif kind == "Cooldown" then
		setStatus(string.format("Spawn ready in %ds", math.max(1, math.floor(cooldownLeft + 0.5))))
	elseif kind == "Repairing" then
		local left = repairingMap[id] or 0
		setStatus(string.format("%s is being repaired — ready in %ds", def.DisplayName, math.max(1, math.floor(left + 0.5))))
	elseif kind == "Spawn" then
		fireSpawn(id)
	elseif kind == "Locked" then
		setStatus(VehicleController._LockDetail(def, gates) or (def.DisplayName .. " is locked"))
	elseif (buyingUntil[id] or 0) > os.clock() then
		setStatus("Buying " .. def.DisplayName .. "…")
	elseif kind == "CantAfford" then
		setStatus(string.format("Need $%s more for %s", commas(st.Need or 0), def.DisplayName))
	else
		firePurchase(id, def)
	end
end

-- Copy by device (mobile merge gate #7, CLAUDE.md §1): key names only while HudLayout.PrefersKeys() (PreferredInput
-- keyboard / gamepad); touch players read what their own controls do (stick, ▲ — VehicleDriveClient's touch hints).
local function rowTip(def: VehicleDef): string
	local cat = def.Category or "Ground"
	local keys = HudLayout.PrefersKeys()
	if cat == "Air" then
		if string.sub(def.KitFamily or "", 1, 4) == "Heli" then
			return if keys then "Deploys on your Helipad · SPACE/▲ climb" else "Deploys on your Helipad · ▲ climbs"
		end
		return if keys then "Deploys on your runway · hold W" else "Deploys on your runway · stick up to go"
	elseif cat == "Naval" then
		return if keys then "Deploys at your dock / the coast · WASD" else "Deploys at your dock / the coast"
	end
	return if keys then "Sit · WASD drive" else "Sit · drive with the stick"
end

-- garage chips carry whole words ("GROUND", "COMMON" — never "GRO" / "COMM"): width follows the text
local function chipWidthFor(text: string, size: number, minW: number): number
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, size, Enum.Font.GothamBold, Vector2.new(1000, 100))
	end)
	-- never trust a short measurement (font fallbacks draw wider): at least ~0.62 em per character, plus padding
	local est = (utf8.len(text) or #text) * size * 0.62
	local w = if ok and typeof(v) == "Vector2" and v.X > 0 then math.max(v.X, est) else est
	return math.max(minW, math.ceil(w) + 18)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Full rebuild (open, filter change, owned / active / gates change)
-- ─────────────────────────────────────────────────────────────────────────────
local function rebuild()
	local list = listFrame
	if not list then
		return
	end
	lastBuiltSig = dataSig()
	table.clear(rowButtons)
	table.clear(spawnButtons)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") or (child:IsA("TextLabel") and child.Name == "EmptyState") then
			child:Destroy()
		end
	end
	if not list:FindFirstChildOfClass("UIListLayout") then
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, if isTouch then 8 else 6)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
	end

	local ids = sortedIds()
	local ownedN = ownedCount()
	local catalogN = catalogCount()

	setStatus(
		string.format(
			"%d shown · %d owned · %d in catalog%s",
			#ids,
			ownedN,
			catalogN,
			if filterOwnedOnly then " · OWNED filter" else ""
		)
	)
	updateCooldownLabel()

	if catalogN == 0 then
		emptyState(list, "Garage empty — no vehicles configured yet.")
		return
	end

	if #ids == 0 then
		local msg = if filterOwnedOnly
			then "No owned rides yet — buy Vehicle Depot / unlock Field 4x4, or turn off OWNED."
			else "No vehicles match these filters — tap All / clear rarity."
		emptyState(list, msg)
		return
	end

	-- Friendly empty banner when nothing owned yet (full catalog still listed below)
	if ownedN == 0 and not filterOwnedOnly then
		emptyState(
			list,
			"Garage empty — buy Vehicle Depot / unlock Field 4x4 (gold BUY → SPAWN). Starter 4x4 syncs after join."
		)
	elseif ownedN > 0 and filterOwnedOnly == false then
		-- soft tip only when filters hide all owned
		local ownedVisible = 0
		for _, id in ipairs(ids) do
			if ownedMap[id] then
				ownedVisible += 1
			end
		end
		if ownedVisible == 0 then
			emptyState(list, "None of your rides match these filters — tap OWNED or All to find them.")
		end
	end

	-- v70: touch rows hold a 64 v action button (44.8 real px) and ≥ 16 v text (11.2 px) at the phone scale
	local titleSize = PanelShell.Text(if isTouch then 15 else 14)
	local chipTextSize = PanelShell.Text(9)
	local chipW = if isTouch then 64 else 60
	local chipHt = chipTextSize + 6
	local metaSize = PanelShell.Text(if isTouch then 12 else 11)
	local chipTop = 4 + titleSize + 6
	local metaTop = chipTop + chipHt + 4
	local metaH = if isTouch then metaSize * 2 + 6 else 26
	local rowH = math.max(if isTouch then 92 else 78, metaTop + metaH + 6)
	local btnW = if isTouch then 132 else 100
	local btnH = if isTouch then PanelShell.TouchMinV() else 44

	for i, id in ipairs(ids) do
		local def = VehicleConfig.Vehicles[id]
		if def then
			local row = Instance.new("Frame")
			row.Name = "Row_" .. id
			row.Size = UDim2.new(1, -8, 0, rowH)
			row.BackgroundColor3 = Constants.Colors.Background
			row.BorderSizePixel = 0
			row.LayoutOrder = i
			row.Parent = list
			addCorner(row, 8)

			local rarBar = Instance.new("Frame")
			rarBar.Size = UDim2.new(0, 4, 1, -8)
			rarBar.Position = UDim2.fromOffset(4, 4)
			rarBar.BorderSizePixel = 0
			rarBar.BackgroundColor3 = rarityColors[def.Rarity] or Constants.Colors.Muted
			rarBar.Parent = row
			addCorner(rarBar, 2)

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromOffset(14, 4)
			title.Size = UDim2.new(1, -(btnW + 28), 0, titleSize + 4)
			title.Font = Enum.Font.GothamBold
			title.TextSize = titleSize
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.TextColor3 = Constants.Colors.Text
			title.Text = def.DisplayName
			title.TextTruncate = Enum.TextTruncate.AtEnd
			title.Parent = row

			local cat = def.Category or "Ground"
			local catCol = if cat == "Air"
				then Constants.Colors.CategoryAir
				elseif cat == "Naval" then Constants.Colors.CategoryNaval
				else Constants.Colors.CategoryGround
			local chipY = chipTop
			local function makeChip(label: string, color: Color3, x: number): number
				local w = chipWidthFor(label, chipTextSize, chipW)
				local chip = Instance.new("Frame")
				chip.Size = UDim2.fromOffset(w, chipHt)
				chip.Position = UDim2.fromOffset(x, chipY)
				chip.BackgroundColor3 = color
				chip.BorderSizePixel = 0
				chip.Parent = row
				addCorner(chip, 4)
				local lab = Instance.new("TextLabel")
				lab.BackgroundTransparency = 1
				lab.Size = UDim2.fromScale(1, 1)
				lab.Font = Enum.Font.GothamBold
				lab.TextSize = chipTextSize
				lab.TextColor3 = Color3.fromRGB(12, 14, 16)
				lab.Text = label
				lab.Parent = chip
				return x + w + 4
			end
			local nextX = makeChip(string.upper(cat), catCol, 14)
			nextX = makeChip(string.upper(def.Rarity or "Common"), rarityColors[def.Rarity] or Constants.Colors.Muted, nextX)
			-- v32: ArmedJeep lists with explicit DisplayName + ARMED chip (same WheeledLight drive as MilitaryJeep);
			-- JEEP-2: players see "Armed 4x4" (the id stays ArmedJeep)
			if id == "ArmedJeep" then
				title.Text = def.DisplayName or "Armed 4x4"
				makeChip("ARMED", Color3.fromRGB(180, 70, 55), nextX)
			end

			local meta = Instance.new("TextLabel")
			meta.BackgroundTransparency = 1
			meta.Position = UDim2.fromOffset(14, metaTop)
			meta.Size = UDim2.new(1, -(btnW + 28), 0, metaH)
			meta.Font = Enum.Font.GothamMedium
			meta.TextSize = metaSize
			meta.TextXAlignment = Enum.TextXAlignment.Left
			meta.TextYAlignment = Enum.TextYAlignment.Top
			meta.TextColor3 = Constants.Colors.Muted
			meta.TextWrapped = true
			local req = ""
			if def.RequiresStructure then
				req = string.format(
					" | %s L%d",
					STRUCTURE_SHORT[def.RequiresStructure.StructureId] or def.RequiresStructure.StructureId,
					def.RequiresStructure.Level
				)
			end
			if typeof(def.RequiresPrestige) == "number" and (def.RequiresPrestige :: number) > 0 then
				req ..= string.format(" | P%d+", def.RequiresPrestige :: number)
			end
			if typeof(def.RequiresRebirthFlag) == "string" and (def.RequiresRebirthFlag :: string) ~= "" then
				req ..= " | Rebirth"
			end
			meta.Text = string.format(
				"%s · Lv %d · $%s · Spd %d%s",
				rowTip(def),
				def.UnlockLevel,
				commas(def.CostCash or 0),
				def.Speed,
				req
			)
			meta.Parent = row

			local btn = Instance.new("TextButton")
			btn.Name = "Action"
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -10, 0.5, 0)
			btn.Size = UDim2.fromOffset(btnW, btnH)
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = PanelShell.Text(if isTouch then 14 else 13)
			btn.TextColor3 = Constants.Colors.Text
			btn.BorderSizePixel = 0
			btn.AutoButtonColor = true
			-- stays Active so a tap on a locked / cooling row can explain itself (WE_Disabled marks "no action")
			btn.Active = true
			btn.Parent = row
			addCorner(btn, 8)
			UIUtil.EnsureMinTouch(btn, btnH)
			rowButtons[id] = btn
			if ownedMap[id] or activeId == id then
				spawnButtons[id] = btn
			end
			paintRow(id)
			bindTap(btn, function()
				onRowTap(id)
			end)
		end
	end
end

-- data changed (payloads / attributes): rebuild once, 0.25 s later, only if something that
-- changes the rows' order or kind changed; otherwise repaint in place
local function scheduleRebuild()
	if not isOpen or rebuildPending then
		return
	end
	rebuildPending = true
	task.delay(0.25, function()
		rebuildPending = false
		if isOpen and dataSig() ~= lastBuiltSig then
			rebuild()
		end
	end)
end

local function scheduleRepaint()
	if not isOpen or repaintPending then
		return
	end
	repaintPending = true
	task.delay(0.25, function()
		repaintPending = false
		if isOpen then
			repaintAll()
		end
	end)
end

local function refreshNewVehicleBadge()
	HudLayout.SetBadge("Garage", if next(newVehicleIds) ~= nil then "!" else nil)
end

-- a fresh owned map from the server: ids that were not owned before are "new" (after the join grace window)
local function noteOwned(owned: { [string]: boolean })
	local now = os.clock()
	local syncedAt = ownedSyncedAt
	if syncedAt == nil then
		ownedSyncedAt = now
		return
	end
	if now - syncedAt < NEW_VEHICLE_GRACE_SECONDS or isOpen then
		return
	end
	local changed = false
	for id in pairs(owned) do
		if not ownedMap[id] and id ~= activeId then
			newVehicleIds[id] = true
			changed = true
		end
	end
	if changed then
		refreshNewVehicleBadge()
	end
end

local function onDataChanged()
	if not isOpen then
		return
	end
	if dataSig() ~= lastBuiltSig then
		scheduleRebuild()
	else
		scheduleRepaint()
	end
end

local function setOpen(value: boolean)
	isOpen = value
	if screenGui then
		screenGui.Enabled = true
		local panel: GuiObject? = panelFrame
		if panel then
			panel.Visible = value
		end
	end
	local sh = shell
	if sh then
		sh.Sync(value)
	end
	if value then
		-- v70: opening the Garage clears the rail's "!" (HUDController also clears it on PanelChanged)
		table.clear(newVehicleIds)
		refreshNewVehicleBadge()
		rebuild()
		print("[WAR EMPIRE] Garage opened — owned=", ownedCount(), "active=", tostring(activeId))
	end
end

local function buildGui()
	local screen = Instance.new("ScreenGui")
	screen.Name = "WarEmpireGarage"
	screen.Enabled = true
	-- v70: DisplayOrder 60 (Panels) above the HUD rail (55); one HUD scale + safe area (HudLayout.ApplyScreen)
	PanelShell.Screen(screen)
	screen.Parent = player:WaitForChild("PlayerGui")
	screenGui = screen

	local TAP = PanelShell.TouchMinV()
	local panel = Instance.new("Frame")
	panel.Name = "GaragePanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	-- Phone-friendly: scale with a max offset so it fits every landscape phone
	if isTouch then
		panel.Size = UDim2.new(0.94, 0, 1, -16)
	else
		panel.Size = UDim2.fromOffset(560, 580)
	end
	panel.BackgroundColor3 = Constants.Colors.Panel
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.Parent = screen
	panelFrame = panel
	-- panelFrame is canonical garage root for open/close
	addCorner(panel, 12)
	local gst = Instance.new("UIStroke")
	gst.Color = Constants.Colors.Gold
	gst.Thickness = 1.5
	gst.Transparency = 0.35
	gst.Parent = panel
	local sizeCon = Instance.new("UISizeConstraint")
	sizeCon.MaxSize = if isTouch then Vector2.new(880, 640) else Vector2.new(560, 640)
	sizeCon.MinSize = Vector2.new(280, 300)
	sizeCon.Parent = panel

	local title = PanelShell.Title(panel, "GARAGE")

	PanelShell.CloseButton(panel, function()
		pcall(AudioController.PlayClick)
		setOpen(false)
	end)

	local lineSize = PanelShell.Text(12)
	local lineY = title.Position.Y.Offset + title.Size.Y.Offset - 2
	local cd = Instance.new("TextLabel")
	cd.Name = "CooldownLine"
	cd.BackgroundTransparency = 1
	cd.Position = UDim2.fromOffset(16, lineY)
	cd.Size = UDim2.new(0.45, -16, 0, lineSize + 4)
	cd.Font = Enum.Font.GothamBold
	cd.TextSize = lineSize
	cd.TextXAlignment = Enum.TextXAlignment.Left
	cd.TextColor3 = Constants.Colors.Muted
	cd.Text = "Spawn ready"
	cd.Parent = panel
	cooldownLabel = cd

	local status = Instance.new("TextLabel")
	status.Name = "StatusLine"
	status.BackgroundTransparency = 1
	status.Position = if isTouch then UDim2.new(0.45, 0, 0, lineY) else UDim2.fromOffset(16, lineY + lineSize + 4)
	status.Size = if isTouch
		then UDim2.new(0.55, -(TAP + 20), 0, lineSize + 4)
		else UDim2.new(1, -(TAP + 28), 0, lineSize + 4)
	status.Font = Enum.Font.GothamMedium
	status.TextSize = lineSize
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextColor3 = Constants.Colors.Muted
	status.TextTruncate = Enum.TextTruncate.AtEnd
	status.Text = ""
	status.Parent = panel
	statusLabel = status

	local filtersY = math.max(TAP + 8, status.Position.Y.Offset + lineSize + 10)
	-- touch: ONE row of 64 v chips (All / Ground / Air / Naval / Owned + a rarity chip that cycles);
	-- desktop keeps two compact rows
	local chipH = if isTouch then TAP else 28
	local filters = Instance.new("Frame")
	filters.Name = "Filters"
	filters.Position = UDim2.fromOffset(12, filtersY)
	filters.Size = UDim2.new(1, -24, 0, chipH)
	filters.BackgroundTransparency = 1
	filters.Parent = panel
	local layoutF = Instance.new("UIListLayout")
	layoutF.FillDirection = Enum.FillDirection.Horizontal
	layoutF.Padding = UDim.new(0, if isTouch then 6 else 5)
	layoutF.SortOrder = Enum.SortOrder.LayoutOrder
	layoutF.Parent = filters

	local rarList = { "All", "Common", "Uncommon", "Rare", "Epic", "Legendary" }
	if typeof(VehicleConfig.Rarities) == "table" then
		rarList = { "All" }
		for _, r in ipairs(VehicleConfig.Rarities) do
			table.insert(rarList, r)
		end
	end
	local function rarityText(): string
		if filterRarity == "All" then
			return "ALL ★"
		end
		return string.upper(filterRarity)
	end

	local function paintCatFilters()
		for _, child in ipairs(filters:GetChildren()) do
			if child:IsA("TextButton") then
				local name = string.gsub(child.Name, "Filter_", "")
				if name == "Owned" then
					child.BackgroundColor3 = if filterOwnedOnly then Constants.Colors.Gold else Constants.Colors.Background
					child.TextColor3 = if filterOwnedOnly then Color3.fromRGB(20, 22, 18) else Constants.Colors.Text
				elseif name == "Rarity" then
					child.Text = rarityText()
					child.BackgroundColor3 = if filterRarity == "All"
						then Constants.Colors.Background
						else (rarityColors[filterRarity] or Constants.Colors.Accent)
					child.TextColor3 = if filterRarity == "All" then Constants.Colors.Text else Color3.fromRGB(20, 22, 18)
				else
					child.BackgroundColor3 = if name == filterCategory
						then Constants.Colors.Accent
						else Constants.Colors.Background
					child.TextColor3 = Constants.Colors.Text
				end
			end
		end
	end
	paintFilters = paintCatFilters
	local chipText = PanelShell.Text(if isTouch then 13 else 11)
	local function chip(name: string, text: string, w: number, order: number): TextButton
		local fb = Instance.new("TextButton")
		fb.Name = name
		fb.LayoutOrder = order
		fb.Size = UDim2.fromOffset(w, chipH)
		fb.Font = Enum.Font.GothamBold
		fb.TextSize = chipText
		fb.Text = text
		fb.TextColor3 = Constants.Colors.Text
		fb.BackgroundColor3 = Constants.Colors.Background
		fb.BorderSizePixel = 0
		fb.AutoButtonColor = true
		fb.Active = true
		addCorner(fb, 8)
		fb.Parent = filters
		UIUtil.EnsureMinTouch(fb, chipH)
		return fb
	end
	for i, cat in ipairs({ "All", "Ground", "Air", "Naval" }) do
		local fb = chip("Filter_" .. cat, cat:upper(), if isTouch then 100 else 70, i)
		bindTap(fb, function()
			filterCategory = cat
			paintCatFilters()
			rebuild()
		end)
	end
	-- OWNED toggle chip
	local ownedChip = chip("Filter_Owned", "OWNED", if isTouch then 100 else 72, 5)
	bindTap(ownedChip, function()
		filterOwnedOnly = not filterOwnedOnly
		paintCatFilters()
		rebuild()
	end)

	local rowsBelow = chipH + 8
	if isTouch then
		-- one chip cycles All → Common → … → Legendary (six 64 v chips would not fit next to the categories)
		local rc = chip("Filter_Rarity", rarityText(), 150, 6)
		bindTap(rc, function()
			local idx = table.find(rarList, filterRarity) or 1
			filterRarity = rarList[(idx % #rarList) + 1]
			paintCatFilters()
			rebuild()
		end)
	else
		local rarFilters = Instance.new("Frame")
		rarFilters.Name = "RarityFilters"
		rarFilters.Position = UDim2.fromOffset(12, filtersY + chipH + 6)
		rarFilters.Size = UDim2.new(1, -24, 0, 26)
		rarFilters.BackgroundTransparency = 1
		rarFilters.Parent = panel
		local layoutR = Instance.new("UIListLayout")
		layoutR.FillDirection = Enum.FillDirection.Horizontal
		layoutR.Padding = UDim.new(0, 4)
		layoutR.SortOrder = Enum.SortOrder.LayoutOrder
		layoutR.Parent = rarFilters
		local function paintRarity()
			for _, child in ipairs(rarFilters:GetChildren()) do
				if child:IsA("TextButton") then
					local name = string.gsub(child.Name, "Rarity_", "")
					child.BackgroundColor3 = if name == filterRarity
						then (rarityColors[name] or Constants.Colors.Accent)
						else Constants.Colors.Background
				end
			end
		end
		for i, rar in ipairs(rarList) do
			local rb = Instance.new("TextButton")
			rb.Name = "Rarity_" .. rar
			rb.LayoutOrder = i
			rb.Size = UDim2.fromOffset(if rar == "Legendary" then 78 else 64, 26)
			rb.Font = Enum.Font.GothamBold
			rb.TextSize = PanelShell.Text(10)
			rb.Text = if rar == "All" then "ALL ★" else string.upper(string.sub(rar, 1, 3))
			rb.TextColor3 = Constants.Colors.Text
			rb.BorderSizePixel = 0
			rb.AutoButtonColor = true
			rb.Active = true
			addCorner(rb, 5)
			rb.Parent = rarFilters
			bindTap(rb, function()
				filterRarity = rar
				paintRarity()
				rebuild()
			end)
		end
		paintRarity()
		rowsBelow += 26 + 8
	end
	paintCatFilters()

	local hintSize = PanelShell.Text(11)
	local listTop = filtersY + rowsBelow
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "List"
	scroll.Position = UDim2.fromOffset(12, listTop)
	scroll.Size = UDim2.new(1, -24, 1, -(listTop + hintSize + 20))
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ElasticBehavior = Enum.ElasticBehavior.Always
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if isTouch then 6 else 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = panel
	listFrame = scroll

	local hint = Instance.new("TextLabel")
	hint.BackgroundTransparency = 1
	hint.AnchorPoint = Vector2.new(0, 1)
	hint.Position = UDim2.new(0, 16, 1, -8)
	hint.Size = UDim2.new(1, -32, 0, hintSize + 4)
	hint.Font = Enum.Font.GothamMedium
	hint.TextSize = hintSize
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextColor3 = Constants.Colors.Muted
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	-- copy by device: key names only for keyboard / gamepad players (HudLayout.PrefersKeys, not TouchEnabled)
	local function hintText(keys: boolean): string
		return if keys
			then "G · SPAWN deploys at your base · Heli SPACE/CTRL · Plane hold W · F exits aircraft"
			else "BUY → SPAWN · air + sea deploy at your base · ▲▼ fly · hold EXIT to leave"
	end
	hint.Text = hintText(HudLayout.PrefersKeys())
	hint.Parent = panel
	HudLayout.InputModeChanged:Connect(function(keys: boolean)
		hint.Text = hintText(keys)
		if isOpen then
			rebuild() -- the row tips name keys only for keyboard / gamepad players
		end
	end)

	-- v70: the desktop GARAGE toggle (bottom-left, over the thumbstick / cash pill) is gone — the Garage opens from
	-- the rail's Garage tile, G, the vehicle-pad prompt and the Vehicle Depot terminal.
	-- Bootstrap calls VehicleController.Init without a pcall: a registry / dim failure must never stop the garage
	local okShell, res = pcall(PanelShell.Attach, {
		Id = PANEL_ID,
		Screen = screen,
		Panel = panel,
		IsOpen = function(): boolean
			return isOpen
		end,
		Close = function()
			setOpen(false)
		end,
	})
	if okShell then
		shell = res
	else
		warn("[VehicleController] panel registry / dim failed:", res)
	end
end

--[[ tab: optional "Ground" | "Air" | "Naval" (terminal prompt attribute WE_OpenTab) presets the category. ]]
function VehicleController.Open(tab: string?)
	if tab == "Ground" or tab == "Air" or tab == "Naval" then
		filterCategory = tab
		local paint = paintFilters
		if paint then
			paint()
		end
	end
	setOpen(true)
end

function VehicleController.Close()
	setOpen(false)
end

function VehicleController.Toggle()
	-- the tap that just closed the Garage through its dim lands on the Garage tile too: stay closed
	local sh = shell
	if not isOpen and sh and sh.TapThrough() then
		return
	end
	setOpen(not isOpen)
end

function VehicleController.IsOpen(): boolean
	return isOpen
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Server data
-- ─────────────────────────────────────────────────────────────────────────────
local function readOwned(v: any): { [string]: boolean }?
	if typeof(v) ~= "table" then
		return nil
	end
	local out: { [string]: boolean } = {}
	for id, owned in pairs(v) do
		if typeof(id) == "string" and owned == true then
			out[id] = true
		end
	end
	return out
end

local function onVehicleState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local owned = readOwned(payload.Owned)
	if owned then
		noteOwned(owned)
		ownedMap = owned
	end
	local act = payload.ActiveVehicleId
	activeId = if typeof(act) == "string" then act else nil
	-- a spawned vehicle is no longer "new"
	if activeId and newVehicleIds[activeId] then
		newVehicleIds[activeId] = nil
		refreshNewVehicleBadge()
	end
	cooldownLeft = math.max(0, tonumber(payload.CooldownRemaining) or 0)
	-- W2: Repairing = { [id] = seconds } (absent = none: an older server)
	table.clear(repairingMap)
	if typeof(payload.Repairing) == "table" then
		for id, secs in pairs(payload.Repairing) do
			local n = tonumber(secs)
			if typeof(id) == "string" and n ~= nil and n > 0 and n == n then
				repairingMap[id] = math.min(n, 3600)
			end
		end
	end
	if payload.Gates ~= nil then
		VehicleController._MergeGates(gates, payload.Gates)
	end
	-- touch: close once the requested vehicle is out, so the player sees it
	if isTouch and isOpen and lastSpawnRequestedId ~= nil and activeId == lastSpawnRequestedId then
		lastSpawnRequestedId = nil
		setOpen(false)
		return
	end
	if isOpen then
		if dataSig() ~= lastBuiltSig then
			scheduleRebuild()
		else
			repaintAll()
		end
	end
end

local function onPlayerState(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local patch: { [string]: any } = { Level = payload.Level, Prestige = payload.Prestige }
	local base = payload.Base
	if typeof(base) == "table" and typeof(base.Upgrades) == "table" then
		patch.Structures = base.Upgrades
	end
	VehicleController._MergeGates(gates, patch)
	-- backup ownership refresh (the join merge can land after the first VehicleStateUpdate)
	local owned = readOwned(payload.Vehicles)
	if owned then
		noteOwned(owned)
		ownedMap = owned
	end
	onDataChanged()
end

local function onBaseState(payload: any)
	if typeof(payload) == "table" and typeof(payload.Upgrades) == "table" then
		VehicleController._MergeGates(gates, { Structures = payload.Upgrades })
		onDataChanged()
	end
end

local function onXP(payload: any)
	if typeof(payload) == "table" and tonumber(payload.Level) then
		VehicleController._MergeGates(gates, { Level = payload.Level })
		onDataChanged()
	end
end

local function readLevelAttribute()
	local lvl = tonumber(player:GetAttribute("WE_Level"))
	if lvl then
		VehicleController._MergeGates(gates, { Level = lvl })
		onDataChanged()
	end
end

function VehicleController.Init()
	-- the drive loop first: a garage UI failure must never stop vehicles from being drivable
	local okDrive, errDrive = pcall(function(): any
		VehicleDriveClient.Init()
		return nil
	end)
	if not okDrive then
		warn("[VehicleController] VehicleDriveClient.Init failed:", errDrive)
	end
	-- W2: vehicle HP bars + wreck burst (display only); a failure never stops driving or the garage
	local okHp, errHp = pcall(function(): any
		local VehicleCombatClient = require(script.Parent.Parent.Modules.VehicleCombatClient)
		VehicleCombatClient.Init()
		return nil
	end)
	if not okHp then
		warn("[VehicleController] VehicleCombatClient.Init failed:", errHp)
	end

	buildGui()

	Remotes.BindEvent(Constants.RemoteNames.VehicleStateUpdate, onVehicleState)
	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, onPlayerState)
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, onBaseState)
	Remotes.BindEvent(Constants.RemoteNames.XPUpdate, onXP)
	player:GetAttributeChangedSignal("WE_Level"):Connect(readLevelAttribute)
	player:GetAttributeChangedSignal("WE_Cash"):Connect(scheduleRepaint)
	readLevelAttribute()

	local garageKey: Enum.KeyCode = HudConfig.Keys.Garage or Enum.KeyCode.G
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == garageKey then
			setOpen(not isOpen)
		end
	end)

	-- cooldown ticker: repaints the owned rows' buttons in place (no rebuild, no new instances)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local repairing = false
			for id, left in pairs(repairingMap) do
				repairing = true
				local n = left - 0.5
				if n > 0 then
					repairingMap[id] = n
				else
					repairingMap[id] = nil
				end
			end
			if cooldownLeft > 0 or repairing then
				cooldownLeft = math.max(0, cooldownLeft - 0.5)
				if isOpen and listFrame then
					repaintOwned()
				end
			end
		end
	end)
end

return VehicleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="214">
            <Properties>
              <string name="Name">WorldPromptController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	World interactivity for StudioSetup-tagged parts.

	Upgrade pads (WE_UpgradeSlot):
	  PRIMARY UX (mobile): large bottom ScreenGui BUY button while standing on
	  own-plot pad → RequestPurchaseUpgrade (Activated / touch).
	  BACKUP: walk-over auto-purchase — Touched + Heartbeat overlap (debounced).
	  Server UpgradePadService remains authoritative walk-over path. Never grants on client.
	Edge cases: respawn clears overlap; seated-in-vehicle skips buy; multi-part
	touch uses pad keys; plot reassignment clears state; standing retry after
	debounce for failed-purchase UX. Prompt/Touched connections disconnect on
	part destroy. BillboardGuis throttled refresh on Base/Economy updates.
	Billboard subtitle: "Stand or tap BUY". Hide BUY for leave / wrong plot / MAX / prereq.

	ProximityPrompts only for non-buy actions (the vehicle pad "Garage" prompt; tutorial markers have none).

	v70 "clean screen" (spec §3.5 action lane, §4.1 one failed buy = one line, §5 console labels):
	  * BUY lives in the ACTION LANE (bottom-centre, above the hotbar; HudLayout.ActionLaneBottomV()): green when
	    affordable / dark red "NEED $N more"; "BUILD HELIPAD  $5,000" / "UPGRADE HELIPAD  $12,000"; desktop shows an
	    "E" key cap; hidden while a panel is open (Modal), seated or dead. The buy path is unchanged: btn.Activated →
	    tryPurchase → Remotes.FireServer(RequestPurchaseUpgrade) → WE_BuyAck / PurchaseResult.
	  * Console price label: plain 2-line outlined text, owner-only, 2.2 studs above the console, no card, no income,
	    no "Stand or tap BUY"; MAX → no label (MAX is on the console screen). No pad-name wash on consoles.
	  * Prompts are pills (PromptController); the "Open Base" and "Hold to capture" client prompts are gone.
	  * No per-frame workspace scan, no WE_HUD season hack; a price label hidden for a reason stays hidden.

	v72 tycoon guide (only while TycoonGuideConfig.Enabled; off = the v70 look above, unchanged):
	  * BUY is two lines of 20 v (TycoonGuideConfig.BuyLane.TouchSize 300x72 v on touch; line 1 Display, line 2 Body)
	    from TycoonMath.MoneyState(cost, wallet, ATM, WE_IncomePerSec):
	      Buy      green  "BUILD AMMO WORKS  $600" / "UPGRADE AMMO LV 2  $2,000" / "BUILD  $1,500"  over
	                      "+$3.3/s income" or "+$3.1/s  6 new buildings"
	      Collect  amber  "COLLECT $1,240 AT ATM" / "+$3.3/s when built": fires NOTHING, draws the line to your own
	                      ATM (ConsoleWaypoint.ShowAtm) and toasts "Follow the line to your ATM"
	      Earn     red    "NEED $1,240 MORE" / "+$3.3/s  ready in 0:42" (the countdown ticks at EtaRefreshHz)
	    A line that does not fit at 20 v (TextService) falls back to the short name / the unlock is dropped; text is
	    never scaled below 20 v. On touch the lane moves right of the thumb zone (TycoonMath.ActionLaneShiftV). While
	    it shows, HudLayout flag "AtConsole" is on (the guide chip hides).
	  * Console tag: stud-scaled (ConsoleTag StudsW x StudsH, DistanceLowerLimit), fixed 14-20 px lines stacked like
	    WorldLabel, owner-only: "AMMO WORKS" (gold "NEXT  AMMO WORKS" on the WE_NextBuy pick, MaxDistance 40) over
	    "$600  +$3.3/s" (green when wallet + ATM covers it, red otherwise) / "Needs Weapons Facility 1" / "MAX LEVEL"
	    (kiosks without a screen). Console screens of the 15 buildings read "WAREHOUSE\n$3.2K\n+$5.2/s".
	  * Every number is TycoonMath over configs x the server-stamped WE_IncomeMult; no remote is added.

	F4 / F5 (owner's 11 features, lane G):
	  * One pointer: the gold NEXT tag marks what the floor chevrons point at (TycoonMath.GuideTarget): while the
	    tutorial runs (TycoonGuideConfig.Chevrons.FollowTutorial) the active step's own pad (Command Center, Barracks)
	    and no console otherwise (the Collect cash step points at the ATM; claim / recruit / outpost / 4x4 at none);
	    after it, the server's pick WE_NextBuy (the cheapest unpaid pad). The step comes from TutorialStateUpdate /
	    PlayerStateUpdate; while a step is up on the HUD (HudLayout "Tutorial") but not known here, no console is NEXT.
	  * The price / NEXT tags are base labels (WorldLabel.TagBaseLabel: the client LabelGovernor counts them toward
	    "at most 3 labels on screen at a base"), and every show / hide goes through WorldLabel.SetShown, so a governor
	    hold is never undone by the 4 Hz pass below.

	streaming2 lane C4 (StreamingEnabled):
	  * F14: a console's screen is its own part (MapSetup.dressConsole), so it can stream in after its plinth, or
	    leave and come back with the server's text (the local price text "can be lost" on stream-in). While
	    streaming is on, each console's ChildAdded("ConsoleScreen") marks the billboards dirty, so the next throttled
	    pass writes the owner's line again. Streaming off: not connected.
	  * F19: the global Workspace.DescendantAdded hook that hid the removed "TRAINING" labels is gone, with its start
	    scan. Nothing in the game makes either label any more, so it matched nothing, streaming on or off; under
	    streaming it ran for every instance that streamed in. While streaming is on, the untagged-StructureId
	    fallback walk is skipped too: every StructureId part is tagged (MapSetup plinths, BusinessService consoles),
	    and the tag's added signal fires on each stream-in. Streaming off: the walk runs as before.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)
local HudConfig = require(Shared.Configs.HudConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local TutorialConfig = require(Shared.Configs.TutorialConfig)
local TycoonMath = require(Shared.Util.TycoonMath)

local VehicleController = require(script.Parent.VehicleController)
local NotificationController = require(script.Parent.NotificationController)
-- v70 prompt pills: required defensively (like UIController does) — a broken PromptController must never take the
-- BUY path down with it; the stub keeps every call a no-op.
local PromptController: any = {
	SetMyPlotId = function(_: number?) end,
	SetBuyButtonActive = function(_: boolean) end,
	SetSuppressed = function(_: ProximityPrompt, _: boolean) end,
}
do
	local mod = script.Parent:FindFirstChild("PromptController")
	if mod and mod:IsA("ModuleScript") then
		local req: any = require
		local ok, res = pcall(req, mod)
		if ok and typeof(res) == "table" then
			PromptController = res
		else
			warn("[WorldPrompt] PromptController failed to load:", res)
		end
	end
end
local UIUtil = require(Shared.Util.UIUtil)
local WorldLabel = require(Shared.Util.WorldLabel)
local HudLayout = require(script.Parent.Parent.Modules.HudLayout)
-- any: ConsoleWaypoint.ShowAtm arrives with the v72 guide lane; every call is guarded (`if ConsoleWaypoint.ShowAtm`)
local ConsoleWaypoint: any = require(script.Parent.Parent.Modules.ConsoleWaypoint)

local WorldPromptController = {}

local PROMPT_NAME = "WE_WorldPrompt"
local BILLBOARD_NAME = "WE_PriceBillboard"
local DEBOUNCE_SEC = 1.1 -- mobile standing-retry; still under server rate (6/8s)
local OVERLAP_MARGIN = 2.4 -- generous pad hitbox for mobile walk-over
local BILLBOARD_THROTTLE = 0.35 -- perf: avoid refreshing every economy tick frame
local PRICE_BILLBOARD_MAX_DIST = 42 -- near-only chips (was 56)
local ATM_HIDE_PRICE_STUDS = 12 -- P0: hide price boards near MoneyCollector -- near-only (was 650) — mobile screen clutter
local PRICE_CHIP_MAX_W = 120 -- v50: tighter mobile chips (was 160)
local PRICE_BILLBOARD_SIZE = UDim2.fromOffset(118, 40) -- phone-readable chip (was 160×52)
local PRICE_BILLBOARD_OWNED_SIZE = UDim2.fromOffset(96, 26) -- owned L1+: tiny roof chip
local BUY_GUI_NAME = "WE_PadBuyGui"
local BUY_BTN_MIN_H = 56
-- v70 action-lane BUY (HudConfig.ActionLane): desktop keeps the pinned 300x58; touch is 64 v (44.8 px on phones)
local BUY_BTN_SIZE_DESKTOP = UDim2.fromOffset(300, 58)
local BUY_BTN_SIZE_TOUCH = HudConfig.ActionLane.BuyButtonSizeTouch
local CONSOLE_LABEL = HudConfig.WorldLabels.Console
local BUY_FAIL_DEDUPE_SEC = 1 -- WE_BuyAck + PurchaseResult for the same structure = one line

-- v72 tycoon guide surfaces (TycoonGuideConfig.Enabled only)
local GTEXT = TycoonGuideConfig.Text
local BUY_LANE = TycoonGuideConfig.BuyLane
local TAG = TycoonGuideConfig.ConsoleTag
local BUY_LINE_V = 20 -- v per BUY line (14 real px at the 0.70 phone scale); never scaled below this
local BUY_LINE_ROW_V = BUY_LINE_V + 4 -- row height (two rows centred in the button)
local BUY_TEXT_PAD_V = 12 -- v between the button edge (or the key cap) and the text
local BUY_KEYCAP_V = 28
local BUY_COPY_MIN_SEC = 0.1 -- copy rebuilds at most 10 Hz while its inputs change (CLAUDE.md UI refresh cap)
local COLLECT_TOAST_CD = 3 -- "Follow the line to your ATM" at most every 3 s
-- console tag lines: real px (BillboardGui), fixed size (the box is stud-scaled; WorldLabel's model, 14-20 px)
local TAG_TITLE_PX = math.clamp(CONSOLE_LABEL.NameSize, 14, 20)
local TAG_LINE_PX = math.clamp(CONSOLE_LABEL.PriceSize, 14, 20)
local TAG_LINE_PAD = 2

local function guideOn(): boolean
	return TycoonGuideConfig.Enabled == true
end

-- dirty labels refresh at most this often (v72 guide: the console tags at TextRefreshHz)
local billboardThrottle = if guideOn()
	then math.max(BILLBOARD_THROTTLE, 1 / math.max(0.1, TycoonGuideConfig.TextRefreshHz))
	else BILLBOARD_THROTTLE

local player = Players.LocalPlayer

-- a numeric Player attribute (NaN / missing / wrong type -> default)
local function numAttr(name: string, default: number): number
	local v = player:GetAttribute(name)
	if typeof(v) == "number" and v == v then
		return v
	end
	return default
end

-- ATM balance (EconomyService WE_PendingCash)
local function pendingCash(): number
	return math.max(0, numAttr("WE_PendingCash", 0))
end

-- what the ATM receives per second right now (server WE_IncomePerSec; 0 until the first steady grant)
local function incomePerSec(): number
	return math.max(0, numAttr("WE_IncomePerSec", 0))
end

-- what one base $ of income pays (server WE_IncomeMult; 1 until the first passive tick)
local function incomeMult(): number
	local m = numAttr("WE_IncomeMult", 1)
	return if m > 0 then m else 1
end

-- "+$3.3/s": the income buying level + 1 of structureId adds (floored; oil counted unscaled)
local function stepGainText(structureId: string, level: number): string
	return TycoonMath.PerSecText(TycoonMath.StepGainPerTick(structureId, level, incomeMult()))
end

-- F5 one pointer: the tutorial step the server last pushed (tutKnown) / nil once the tutorial is complete
local tutKnown = false
local tutStep: TycoonMath.GuideStep? = nil
local tutPayloadStep: TycoonMath.GuideStep = { PadStructureId = nil, Pointer = nil } -- a step Id this config lacks

local function applyTutorialStep(complete: boolean, id: any, pad: any, pointer: any)
	tutKnown = true
	if complete then
		tutStep = nil
		return
	end
	local i = if typeof(id) == "string" then TutorialConfig.IndexOf(id) else nil
	local def = if i ~= nil then TutorialConfig.Steps[i] else nil
	if def ~= nil then
		tutStep = def
	else
		tutPayloadStep.PadStructureId = if typeof(pad) == "string" then pad else nil
		tutPayloadStep.Pointer = if typeof(pointer) == "string" then pointer else nil
		tutStep = tutPayloadStep
	end
end

-- the one pointer (TycoonMath.GuideTarget: the tutorial step's pad, else the server's pick WE_NextBuy "Id:Level")
-- is buying level + 1 of structureId
local function isNextPick(structureId: string, level: number): boolean
	local step: TycoonMath.GuideStep? = nil
	if tutKnown then
		step = tutStep
	elseif HudLayout.GetFlag("Tutorial") then
		return false -- a tutorial step is up but has not reached this controller yet: no NEXT tag anywhere
	end
	local id, lv = TycoonMath.GuideTarget(step, player:GetAttribute("WE_NextBuy"))
	return id == structureId and lv == level + 1
end

-- TextService width (v, at BUY_LINE_V) of one BUY line; memoised (a few dozen distinct strings per session)
local textWidthCache: { [string]: number } = {}
local textWidthCount = 0
local function lineWidthV(text: string, font: Enum.Font): number
	local key = font.Name .. "|" .. text
	local hit = textWidthCache[key]
	if hit then
		return hit
	end
	local ok, v = pcall(function(): Vector2
		return TextService:GetTextSize(text, BUY_LINE_V, font, Vector2.new(4000, 200))
	end)
	local w = if ok and typeof(v) == "Vector2" and v.X > 0 then v.X else (utf8.len(text) or #text) * BUY_LINE_V * 0.62
	if textWidthCount >= 128 then
		table.clear(textWidthCache)
		textWidthCount = 0
	end
	textWidthCache[key] = w
	textWidthCount += 1
	return w
end
local upgrades: { [string]: number } = {}
local cash = 0
-- v57: every afford/BUY/NEED check reads max of module cash, WE_Cash, leaderstats.Cash
local function liveCash(): number
	local best = math.floor(tonumber(cash) or 0)
	local attr = tonumber(player:GetAttribute("WE_Cash"))
	if typeof(attr) == "number" then
		best = math.max(best, math.floor(attr))
	end
	local folder = player:FindFirstChild("leaderstats")
	if folder then
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			best = math.max(best, math.floor((cashV :: any).Value))
		end
	end
	return best
end
local myPlotId: number? = nil
local attachedPrompt: { [Instance]: boolean } = {}
local slotParts: { [BasePart]: boolean } = {}
local slotConns: { [Instance]: { RBXScriptConnection } } = {}
local promptConns: { [Instance]: { RBXScriptConnection } } = {}
local lastPurchaseAt: { [string]: number } = {} -- keyed by structureId (server rate is global)
local lastOverlap: { [string]: boolean } = {} -- keyed by padKey (plot|structure)
local pendingPurchase: { [string]: boolean } = {} -- structureId in-flight
local billboardDirty = false
local lastBillboardRefresh = 0
local overlapConn: RBXScriptConnection? = nil
local tagsBound = false
local maxToastAt: { [string]: number } = {} -- throttle MAX toasts while camping
local failToastAt: { [string]: number } = {} -- throttle Not enough / prereq (~0.85s)
local FAIL_TOAST_CD = 0.9
local _buyGui: ScreenGui? = nil
local buyBtn: TextButton? = nil
local activeBuyStructureId: string? = nil
local activeBuyPart: BasePart? = nil

-- v68: consoles (BaseLayoutConfig) — the BUY button shows when you walk up; buying needs a tap or the prompt
local function isConsolePart(part: BasePart): boolean
	return part:GetAttribute("WE_Console") == true
end

-- streaming2: the place's StreamingEnabled (default.project.json; scripts cannot set it). The lane C4 changes act
-- only while it is true.
local function streamingOn(): boolean
	return Workspace.StreamingEnabled == true
end

local function padKey(part: BasePart, structureId: string): string
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" then
		return tostring(pid) .. "|" .. structureId
	end
	return structureId
end

local function trackConn(bucket: { [Instance]: { RBXScriptConnection } }, owner: Instance, conn: RBXScriptConnection)
	local list = bucket[owner]
	if not list then
		list = {}
		bucket[owner] = list
	end
	table.insert(list, conn)
end

local function disconnectAll(bucket: { [Instance]: { RBXScriptConnection } }, owner: Instance)
	local list = bucket[owner]
	if not list then
		return
	end
	for _, c in ipairs(list) do
		c:Disconnect()
	end
	bucket[owner] = nil
end

local function makePrompt(parent: BasePart, actionText: string, objectText: string, hold: number?, maxDist: number?): ProximityPrompt
	local existing = parent:FindFirstChild(PROMPT_NAME)
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = maxDist or 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = parent
	return prompt
end

-- 12000 → "12,000"
local function withCommas(n: number): string
	local s = tostring(math.floor(math.abs(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if n < 0 then "-" .. out else out
end

-- BUY button: the full price ("$12,000")
local function fullCost(cost: number): string
	return "$" .. withCommas(cost)
end

-- console label: "$5,000" under 10K, then "$12K" / "$12.5K" / "$1.2M"
local function shortCost(cost: number): string
	if cost >= 1_000_000 then
		return (string.format("$%.1fM", cost / 1_000_000):gsub("%.0M", "M"))
	elseif cost >= 10_000 then
		local k = cost / 1000
		if k >= 100 or math.abs(k - math.floor(k)) < 0.05 then
			return string.format("$%dK", math.floor(k))
		end
		return string.format("$%.1fK", k)
	end
	return fullCost(cost)
end

local function escapeRich(t: string): string
	return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local structureInfo: (structureId: string) -> (string, number, number?, boolean, string?)
local tryPurchase: (structureId: string, opts: { silentMax: boolean?, showBuying: boolean? }?) -> ()
local isSeatedInVehicle: () -> boolean
local isOwnPlotPad: (part: BasePart) -> boolean


local padBuyFlashToken = 0
-- the BUY caption keeps "BUYING…" / "BOUGHT …!" until this os.clock() (the Heartbeat refresh would overwrite it)
local captionHoldUntil = 0
local buyCaption: TextLabel? = nil
local buyStroke: UIStroke? = nil
local buyGradient: UIGradient? = nil

-- affordable: green gradient (63,220,85) → (35,165,58), 3 v dark-green stroke; short of cash: dark red
local BUY_OK_TOP = Color3.fromRGB(63, 220, 85)
local BUY_OK_BOTTOM = Color3.fromRGB(35, 165, 58)
local BUY_OK_STROKE = Color3.fromRGB(12, 70, 22)
local BUY_SHORT_TOP = Color3.fromRGB(96, 44, 44)
local BUY_SHORT_BOTTOM = Color3.fromRGB(58, 26, 26)
local BUY_SHORT_STROKE = Color3.fromRGB(30, 10, 10)
local BUY_SHORT_PRICE = "#ff8080"
-- v72 Collect (money is in the ATM): amber
local BUY_COLLECT_TOP = Color3.fromRGB(255, 180, 40)
local BUY_COLLECT_BOTTOM = Color3.fromRGB(205, 118, 12)
local BUY_COLLECT_STROKE = Color3.fromRGB(88, 46, 4)

type BuyLook = "Buy" | "Collect" | "Earn" -- green / amber / dark red (TycoonMath.MoneyState)

local function asLook(state: string): BuyLook
	if state == "Collect" then
		return "Collect"
	elseif state == "Earn" then
		return "Earn"
	end
	return "Buy"
end

-- v72 two-line BUY (guide on): line 2, the key cap, and the copy cache (rebuilt only when its inputs change)
local buyLine2: TextLabel? = nil
local buyKeyCap: Frame? = nil
local buyLaneFrame: Frame? = nil
local buyLaneConn: RBXScriptConnection? = nil
local buyCopyDirty = true
local copySid: string? = nil
local copyLevel = -1
local copyCost = -1
local copyAt = -math.huge
local copyLook: BuyLook = "Buy"
local copyGain = ""
local copyEtaEnd: number? = nil
local copyEtaAt = -math.huge
local collectToastAt = -math.huge

-- UIGradient colours multiply BackgroundColor3: bg = top colour, gradient white → bottom/top per channel
local function gradientTo(top: Color3, bottom: Color3): ColorSequence
	local function ratio(b: number, t: number): number
		return if t > 0 then math.clamp(b / t, 0, 1) else 1
	end
	return ColorSequence.new(Color3.new(1, 1, 1), Color3.new(ratio(bottom.R, top.R), ratio(bottom.G, top.G), ratio(bottom.B, top.B)))
end

local buyLook: BuyLook? = nil
local function setBuyLook(look: BuyLook)
	local btn = buyBtn
	if not btn or buyLook == look then
		return
	end
	buyLook = look
	local top, bottom, edge = BUY_OK_TOP, BUY_OK_BOTTOM, BUY_OK_STROKE
	if look == "Earn" then
		top, bottom, edge = BUY_SHORT_TOP, BUY_SHORT_BOTTOM, BUY_SHORT_STROKE
	elseif look == "Collect" then
		top, bottom, edge = BUY_COLLECT_TOP, BUY_COLLECT_BOTTOM, BUY_COLLECT_STROKE
	end
	btn.BackgroundColor3 = top
	local g = buyGradient
	if g then
		g.Color = gradientTo(top, bottom)
	end
	local st = buyStroke
	if st then
		st.Color = edge
	end
	btn.AutoButtonColor = look ~= "Earn"
end

local function setBuyCaption(rich: string)
	local cap = buyCaption
	if cap and cap.Text ~= rich then
		cap.Text = rich
	end
end

-- v72 two-line layout: rows centred as a pair (one row centred alone), right of the key cap when it shows
local function layoutBuyLines(twoLines: boolean, capVisible: boolean)
	local cap, line2 = buyCaption, buyLine2
	if not (cap and line2) then
		return
	end
	local padL = BUY_TEXT_PAD_V + (if capVisible then BUY_KEYCAP_V + 8 else 0)
	local size = UDim2.new(1, -(padL + BUY_TEXT_PAD_V), 0, BUY_LINE_ROW_V)
	local p1 = UDim2.new(0, padL, 0.5, if twoLines then -BUY_LINE_ROW_V / 2 else 0)
	if cap.Position ~= p1 then
		cap.Position = p1
	end
	if cap.Size ~= size then
		cap.Size = size
		line2.Size = size
	end
	local p2 = UDim2.new(0, padL, 0.5, BUY_LINE_ROW_V / 2)
	if line2.Position ~= p2 then
		line2.Position = p2
	end
	if line2.Visible ~= twoLines then
		line2.Visible = twoLines
	end
	local kc = buyKeyCap
	if kc and kc.Visible ~= capVisible then
		kc.Visible = capVisible
	end
end

local function setBuyLine2(text: string)
	local l2 = buyLine2
	if l2 and l2.Text ~= text then
		l2.Text = text
	end
end

-- the text width (v) left for one BUY line
local function buyInnerWidthV(capVisible: boolean): number
	local btn = buyBtn
	local w = if btn then btn.Size.X.Offset else BUY_LANE.TouchSize.X
	return w - 2 * BUY_TEXT_PAD_V - (if capVisible then BUY_KEYCAP_V + 8 else 0)
end

-- v72: "BUYING…" / "BOUGHT …!" alone on one centred line; the copy is rebuilt once the hold ends
local function holdBuyCaption(text: string)
	setBuyCaption(text)
	if guideOn() then
		buyCopyDirty = true
		layoutBuyLines(false, false)
	end
end

local function flashPadBuyBought(displayName: string, structureId: string?)
	local btn = buyBtn
	if not btn or not btn.Visible then
		return
	end
	padBuyFlashToken += 1
	captionHoldUntil = os.clock() + 1.0
	setBuyLook("Buy")
	if guideOn() then
		-- plain text (RichText off); the short name when the full one does not fit at 20 v
		local text = string.format("BOUGHT %s!", string.upper(displayName))
		if structureId and lineWidthV(text, HudConfig.Fonts.Display) > buyInnerWidthV(false) then
			text = string.format("BOUGHT %s!", TycoonMath.ShortName(structureId))
		end
		holdBuyCaption(text)
		return
	end
	setBuyCaption(string.format("BOUGHT %s!", escapeRich(string.upper(displayName))))
	-- the standing Heartbeat refreshPadBuyButton rewrites the caption once captionHoldUntil passes
end

local function hidePadBuyButton()
	activeBuyStructureId = nil
	activeBuyPart = nil
	if buyBtn then
		buyBtn.Visible = false
	end
	PromptController.SetBuyButtonActive(false)
	if guideOn() then
		HudLayout.SetFlag(TycoonGuideConfig.AtConsoleFlag, false)
	end
end

-- v72 Collect: the money is in the ATM. Fires nothing; the GO line goes to YOUR ATM + one short toast.
local function showAtmLine()
	if ConsoleWaypoint.ShowAtm then
		local ok, err = pcall(ConsoleWaypoint.ShowAtm, myPlotId)
		if not ok then
			warn("[WorldPrompt] ConsoleWaypoint.ShowAtm failed:", err)
		end
	end
	local now = os.clock()
	if now - collectToastAt >= COLLECT_TOAST_CD then
		collectToastAt = now
		NotificationController.Show(GTEXT.CollectToast, "Info", 3)
	end
end

-- TouchSize on touch, the pinned desktop size otherwise (v72 guide: the desktop button is wider by the "E" key cap,
-- so both lines get the same text width as on touch)
local function buyButtonSize(touch: boolean): UDim2
	if not touch then
		if guideOn() then
			return UDim2.fromOffset(BUY_LANE.TouchSize.X + BUY_KEYCAP_V + 8, BUY_BTN_SIZE_DESKTOP.Y.Offset)
		end
		return BUY_BTN_SIZE_DESKTOP
	end
	if guideOn() then
		return UDim2.fromOffset(BUY_LANE.TouchSize.X, BUY_LANE.TouchSize.Y)
	end
	return BUY_BTN_SIZE_TOUCH
end

-- v72 F3: on touch the BUY lane's left edge sits ThumbZoneFrac of the safe width + ClearPx right of its left edge
local function buyLaneShiftV(widthV: number): number
	if not (guideOn() and HudLayout.IsTouch()) then
		return 0
	end
	return TycoonMath.ActionLaneShiftV(HudLayout.ContentSizeV(), widthV, BUY_LANE.ThumbZoneFrac, BUY_LANE.ClearPx, HudLayout.Scale())
end

local function placeBuyLane()
	local lane = buyLaneFrame
	if not lane then
		return
	end
	local want = UDim2.new(0.5, buyLaneShiftV(lane.Size.X.Offset), 1, -HudLayout.ActionLaneBottomV())
	if lane.Position ~= want then
		lane.Position = want
	end
end

local function ensurePadBuyGui(): TextButton
	if buyBtn and buyBtn.Parent then
		return buyBtn
	end
	local pg = player:WaitForChild("PlayerGui")
	local existing = pg:FindFirstChild(BUY_GUI_NAME)
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end

	local screen = Instance.new("ScreenGui")
	screen.Name = BUY_GUI_NAME
	-- Above the HUD (55) and panels (60); below toasts (70). One HUD scale + CoreUISafeInsets (HudLayout).
	screen.DisplayOrder = HudConfig.DisplayOrder.WE_PadBuyGui
	HudLayout.ApplyScreen(screen, { Insets = "Core" })
	screen.Parent = pg
	_buyGui = screen

	local touch = HudLayout.IsTouch()
	local guide = guideOn()
	local size = buyButtonSize(touch)
	-- the action lane slot: bottom-centre, 100 v (touch) / 86 v (desktop) above the content bottom
	-- (v72 guide on touch: shifted right so its left edge clears the thumb zone)
	local lane = Instance.new("Frame")
	lane.Name = "Lane"
	lane.AnchorPoint = Vector2.new(0.5, 1)
	lane.Position = UDim2.new(0.5, buyLaneShiftV(size.X.Offset), 1, -HudLayout.ActionLaneBottomV())
	lane.Size = size
	lane.BackgroundTransparency = 1
	lane.BorderSizePixel = 0
	lane.Active = false
	lane.Parent = screen
	HudLayout.BindVisibility(lane, { HideWhen = { "Modal", "Driving", "Dead" } })
	if guide then
		buyLaneFrame = lane
		if buyLaneConn == nil then
			-- rotation / safe-area change: the thumb-zone edge moves with the viewport
			buyLaneConn = HudLayout.LayoutChanged:Connect(placeBuyLane)
		end
	end

	local btn = Instance.new("TextButton")
	btn.Name = "BuyButton"
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Position = UDim2.fromScale(0.5, 0.5)
	btn.Size = size
	btn.BackgroundColor3 = BUY_OK_TOP
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	btn.Text = ""
	btn.Visible = false
	btn.Active = true
	btn.Selectable = true
	btn.ZIndex = 40
	btn.Parent = lane
	UIUtil.Corner(btn, 14)
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = gradientTo(BUY_OK_TOP, BUY_OK_BOTTOM)
	grad.Parent = btn
	buyGradient = grad
	local stroke = UIUtil.Stroke(btn, BUY_OK_STROKE, 3)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Transparency = 0
	buyStroke = stroke
	buyLook = nil
	UIUtil.EnsureMinTouch(btn, BUY_BTN_MIN_H)

	if guide then
		-- v72: two fixed 20 v lines (Display over Body), never TextScaled; the "E" key cap only while
		-- HudLayout.PrefersKeys() (PreferredInput) and E does what the button says (not in the Collect state)
		local cap = Instance.new("Frame")
		cap.Name = "KeyCap"
		cap.AnchorPoint = Vector2.new(0, 0.5)
		cap.Position = UDim2.new(0, BUY_TEXT_PAD_V, 0.5, 0)
		cap.Size = UDim2.fromOffset(BUY_KEYCAP_V, BUY_KEYCAP_V)
		cap.BackgroundColor3 = Color3.fromRGB(232, 255, 232)
		cap.BorderSizePixel = 0
		cap.Active = false
		cap.Visible = false
		cap.ZIndex = 41
		cap.Parent = btn
		UIUtil.Corner(cap, 5)
		local key = Instance.new("TextLabel")
		key.Name = "Key"
		key.BackgroundTransparency = 1
		key.Size = UDim2.fromScale(1, 1)
		key.Font = HudConfig.Fonts.Body
		key.TextSize = 16
		key.TextColor3 = BUY_OK_STROKE
		key.Text = "E"
		key.ZIndex = 42
		key.Parent = cap
		buyKeyCap = cap

		local function line(name: string, font: Enum.Font): TextLabel
			local t = Instance.new("TextLabel")
			t.Name = name
			t.BackgroundTransparency = 1
			t.AnchorPoint = Vector2.new(0, 0.5)
			t.Font = font
			t.TextSize = BUY_LINE_V
			t.TextScaled = false
			t.TextWrapped = false
			t.RichText = false
			t.TextXAlignment = Enum.TextXAlignment.Center
			t.TextColor3 = Color3.fromRGB(255, 255, 255)
			t.Text = ""
			t.ZIndex = 42
			t.Parent = btn
			UIUtil.TextOutline(t, 1.4)
			return t
		end
		buyCaption = line("Caption", HudConfig.Fonts.Display)
		buyLine2 = line("Line2", HudConfig.Fonts.Body)
		buyCopyDirty = true
		layoutBuyLines(true, false)
	end

	-- desktop / gamepad: an "E" key cap (the console's E-hold prompt still works; its pill hides while BUY shows)
	local padL = 14
	if not touch and not guide then
		local cap = Instance.new("Frame")
		cap.Name = "KeyCap"
		cap.AnchorPoint = Vector2.new(0, 0.5)
		cap.Position = UDim2.new(0, padL, 0.5, 0)
		cap.Size = UDim2.fromOffset(28, 28)
		cap.BackgroundColor3 = Color3.fromRGB(232, 255, 232)
		cap.BorderSizePixel = 0
		cap.Active = false
		cap.ZIndex = 41
		cap.Parent = btn
		UIUtil.Corner(cap, 5)
		local key = Instance.new("TextLabel")
		key.Name = "Key"
		key.BackgroundTransparency = 1
		key.Size = UDim2.fromScale(1, 1)
		key.Font = HudConfig.Fonts.Body
		key.TextSize = 16
		key.TextColor3 = BUY_OK_STROKE
		key.Text = "E"
		key.ZIndex = 42
		key.Parent = cap
		padL += 28 + 8
	end

	if not guide then
		local caption = Instance.new("TextLabel")
		caption.Name = "Caption"
		caption.BackgroundTransparency = 1
		caption.AnchorPoint = Vector2.new(0, 0.5)
		caption.Position = UDim2.new(0, padL, 0.5, 0)
		caption.Size = UDim2.new(1, -(padL + 12), 1, -10)
		caption.Font = HudConfig.Fonts.Display
		caption.RichText = true
		caption.TextScaled = true
		caption.TextColor3 = Color3.fromRGB(255, 255, 255)
		caption.Text = "BUY"
		caption.ZIndex = 42
		caption.Parent = btn
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = 20
		limit.MinTextSize = 12
		limit.Parent = caption
		UIUtil.TextOutline(caption, 1.4)
		buyCaption = caption
	end

	local lastTapAt = 0
	local function onBuyPressed()
		local sid = activeBuyStructureId
		if typeof(sid) ~= "string" then
			return
		end
		-- v67: one purchase per tap (a stray double event bought two levels)
		local now = os.clock()
		if now - lastTapAt < 0.35 then
			return
		end
		lastTapAt = now
		local display, _level, cost, isMax, prereqHint = structureInfo(sid)
		if isMax or prereqHint or cost == nil then
			hidePadBuyButton()
			return
		end
		-- v72 Collect (wallet short, wallet + ATM enough): no buy request; the line goes to the player's own ATM
		if guideOn() and (TycoonMath.MoneyState(cost, liveCash(), pendingCash(), incomePerSec())) == "Collect" then
			showAtmLine()
			return
		end
		-- Intentional tap: clear walk-over debounce so BUY always fires
		lastPurchaseAt[sid] = 0
		pendingPurchase[sid] = nil
		print(string.format("[WorldPrompt] BUY button tap → RequestPurchaseUpgrade %s %s cost=%s", sid, display, tostring(cost)))
		-- v61: "BUYING…" only after FireServer actually ran (see tryPurchase showBuying)
		tryPurchase(sid, { showBuying = true })
	end
	-- v67: Activated only — it already fires for mouse, touch and gamepad. Also wiring MouseButton1Click
	-- ran the handler twice per click (two RequestPurchaseUpgrade = two levels bought).
	btn.Activated:Connect(onBuyPressed)

	buyBtn = btn
	return btn
end

-- v72 line 1 of the Buy state: the full name, else the short name, else no name ("BUILD  $600"); an upgrade keeps
-- "LV n" and the price. Everything comes from TycoonGuideConfig.Text.
local function buyLine1(sid: string, display: string, level: number, price: string, unlock: string?, innerW: number): string
	local font = HudConfig.Fonts.Display
	if level <= 0 then
		if unlock then
			return string.format(GTEXT.BuyBuildShort, price) -- line 2 names what it unlocks
		end
		local full = string.format(GTEXT.BuyBuild, string.upper(display), price)
		if lineWidthV(full, font) <= innerW then
			return full
		end
		local short = string.format(GTEXT.BuyBuild, TycoonMath.ShortName(sid), price)
		if lineWidthV(short, font) <= innerW then
			return short
		end
		return string.format(GTEXT.BuyBuildShort, price)
	end
	local up = string.format(GTEXT.BuyUpgrade, TycoonMath.ShortName(sid), level + 1, price)
	if lineWidthV(up, font) <= innerW then
		return up
	end
	return string.format(GTEXT.BuyUpgrade, "", level + 1, price) -- "UPGRADE  LV 5  $12.5K"
end

--[[ v72 BUY copy (guide on). Rebuilt when its inputs change (structure, level, price, or buyCopyDirty: cash, ATM,
	WE_IncomePerSec, WE_IncomeMult, upgrades), at most every BUY_COPY_MIN_SEC; the Earn countdown ticks at
	EtaRefreshHz from the end time taken at the last rebuild. No allocation on the frames in between. ]]
local function refreshGuideBuyCopy(sid: string, display: string, level: number, cost: number)
	local now = os.clock()
	local same = sid == copySid and level == copyLevel and cost == copyCost
	if same and not buyCopyDirty then
		local etaEnd = copyEtaEnd
		local hz = math.max(0.1, TycoonGuideConfig.EtaRefreshHz)
		if copyLook == "Earn" and etaEnd ~= nil and now - copyEtaAt >= 1 / hz then
			copyEtaAt = now
			setBuyLine2(string.format(GTEXT.BuyNeedLine2, copyGain, TycoonMath.FormatEta(math.max(0, etaEnd - now))))
		end
		return
	end
	if same and now - copyAt < BUY_COPY_MIN_SEC then
		return
	end
	copySid, copyLevel, copyCost, copyAt = sid, level, cost, now
	buyCopyDirty = false

	local gain = stepGainText(sid, level)
	local moneyState, short, eta = TycoonMath.MoneyState(cost, liveCash(), pendingCash(), incomePerSec())
	local state: BuyLook = asLook(moneyState)
	local capVisible = state ~= "Collect" and HudLayout.PrefersKeys()
	local innerW = buyInnerWidthV(capVisible)
	local line1: string
	local line2: string
	copyEtaEnd = nil
	if state == "Collect" then
		line1 = string.format(GTEXT.BuyCollect, TycoonMath.ShortCash(short))
		line2 = string.format(GTEXT.BuyCollectLine2, gain)
	elseif state == "Earn" then
		line1 = string.format(GTEXT.BuyNeed, TycoonMath.ShortCash(short))
		if eta ~= nil then
			copyEtaEnd = now + eta
			line2 = string.format(GTEXT.BuyNeedLine2, gain, TycoonMath.FormatEta(eta))
		else
			line2 = string.format(GTEXT.BuyIncome, gain) -- no income yet: no countdown
		end
	else
		local unlock = TycoonMath.UnlockText(sid, level + 1)
		line1 = buyLine1(sid, display, level, TycoonMath.ShortCash(cost), unlock, innerW)
		line2 = string.format(GTEXT.BuyIncome, gain)
		if unlock then
			local withUnlock = string.format(GTEXT.BuyIncomeUnlock, gain, unlock)
			if lineWidthV(withUnlock, HudConfig.Fonts.Body) <= innerW then
				line2 = withUnlock
			end
		end
	end
	copyLook, copyGain, copyEtaAt = state, gain, now
	setBuyLook(state)
	layoutBuyLines(true, capVisible)
	setBuyCaption(line1)
	setBuyLine2(line2)
end

local function refreshPadBuyButton(part: BasePart?, structureId: string?)
	if part == nil or structureId == nil then
		hidePadBuyButton()
		return
	end
	if isSeatedInVehicle() then
		hidePadBuyButton()
		return
	end
	if not isOwnPlotPad(part) then
		hidePadBuyButton()
		return
	end

	local display, level, cost, isMax, prereqHint = structureInfo(structureId)
	if isMax or prereqHint or cost == nil then
		hidePadBuyButton()
		return
	end

	local btn = ensurePadBuyGui()
	activeBuyStructureId = structureId
	activeBuyPart = part
	if guideOn() then
		if os.clock() >= captionHoldUntil then
			refreshGuideBuyCopy(structureId, display, level, cost)
		end
	elseif os.clock() >= captionHoldUntil then
		local have = liveCash()
		local canAfford = have >= cost
		setBuyLook(if canAfford then "Buy" else "Earn")
		if canAfford then
			-- "BUILD HELIPAD  $5,000" / "UPGRADE HELIPAD  $12,000" (income lives on the console screen / Base panel)
			local verb = if level <= 0 then "BUILD" else "UPGRADE"
			setBuyCaption(string.format("%s %s  %s", verb, escapeRich(string.upper(display)), fullCost(cost)))
		else
			setBuyCaption(string.format('NEED  <font color="%s">%s more</font>', BUY_SHORT_PRICE, fullCost(cost - have)))
		end
	end
	btn.Visible = true
	PromptController.SetBuyButtonActive(true)
	if guideOn() then
		HudLayout.SetFlag(TycoonGuideConfig.AtConsoleFlag, true) -- the guide chip steps aside (one message at a time)
	end
end

function structureInfo(structureId: string): (string, number, number?, boolean, string?)
	local def = BaseConfig.Structures[structureId]
	local display = if def then def.DisplayName else structureId
	local level = upgrades[structureId] or 0
	if not def then
		return display, level, nil, false, nil
	end
	if level >= def.MaxLevel then
		return display, level, nil, true, nil
	end
	local prereqHint: string? = nil
	if def.Requires then
		for _, req in ipairs(def.Requires) do
			local have = upgrades[req.StructureId] or 0
			if have < req.Level then
				local reqDef = BaseConfig.Structures[req.StructureId]
				local reqName = if reqDef then reqDef.DisplayName else req.StructureId
				prereqHint = string.format("Needs %s L%d", reqName, req.Level)
				break
			end
		end
	end
	local nextLevel = level + 1
	local cost = def.Costs[nextLevel]
	return display, level, cost, false, prereqHint
end

-- v70: the console label grows with the HUD scale: k = clamp(S / 0.9, 0.9, 1.3) → 106x36 phone, 118x40 at
-- 720p, 151x51 at 1080p (BillboardGui offsets are real px; the HUD UIScale never reaches them)
local function chipScale(): number
	return math.clamp(HudLayout.Scale() / 0.9, 0.9, 1.3)
end

local function clampChipSize(size: UDim2, k: number?): UDim2
	-- v50: hard clamp width+height so legacy/Scale chips never dominate mobile (v70: then × k)
	local kk = k or 1
	local w = size.X.Offset
	local h = size.Y.Offset
	if w <= 0 and h <= 0 then
		w, h = PRICE_BILLBOARD_SIZE.X.Offset, PRICE_BILLBOARD_SIZE.Y.Offset
	end
	local cw = if w > 0 then math.min(w, PRICE_CHIP_MAX_W) else PRICE_CHIP_MAX_W
	local ch = if h > 0 then math.min(h, 44) else 40
	return UDim2.fromOffset(math.floor(cw * kk + 0.5), math.floor(ch * kk + 0.5))
end

-- the latest "standing near an ATM" answer (the throttled loop keeps it); price labels stay off near the ATM
local nearAtmNow = false
-- labels hidden on purpose (another player's plot, MAX): the ATM soft-restore must never switch these back on
local priceHidden: { [BasePart]: boolean } = setmetatable({} :: any, { __mode = "k" })

-- v72 console tag geometry (guide on): stud-scaled box above the console top; the range is set with the copy
local tagPlaced: { [BillboardGui]: boolean } = setmetatable({} :: any, { __mode = "k" })
local function placeConsoleTag(bb: BillboardGui, part: BasePart)
	local size = UDim2.fromScale(TAG.StudsW, TAG.StudsH)
	if bb.Size ~= size then
		bb.Size = size
	end
	local offset = Vector3.new(0, part.Size.Y * 0.5 + CONSOLE_LABEL.StudsAboveConsoleTop, 0)
	if bb.StudsOffsetWorldSpace ~= offset then
		bb.StudsOffsetWorldSpace = offset
	end
	if tagPlaced[bb] then
		return
	end
	tagPlaced[bb] = true
	bb.StudsOffset = Vector3.zero
	-- stops growing closer than this (deprecated in the API docs, still honoured; skipped if an engine drops it)
	pcall(function()
		(bb :: any).DistanceLowerLimit = TAG.DistanceLowerLimit
	end)
	bb.ClipsDescendants = false
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
end

local function setBillboardNearOnly(bb: BillboardGui, ownedChip: boolean?, part: BasePart?)
	-- never AlwaysOnTop giant tabs — plain text, near-only, owner-only
	if part and guideOn() and isConsolePart(part) then
		placeConsoleTag(bb, part)
		return
	end
	local k = chipScale()
	if part and isConsolePart(part) then
		-- v70: 2.2 studs above the console top (the old 5-stud host + 5.5 landed in the ceiling of walk-ins)
		bb.Size = clampChipSize(PRICE_BILLBOARD_SIZE, k)
		bb.StudsOffset = Vector3.zero
		bb.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y * 0.5 + CONSOLE_LABEL.StudsAboveConsoleTop, 0)
		bb.MaxDistance = if ownedChip then CONSOLE_LABEL.MaxDistanceUpgrade else CONSOLE_LABEL.MaxDistanceBuild
		bb.AlwaysOnTop = false
	elseif ownedChip then
		bb.Size = clampChipSize(PRICE_BILLBOARD_OWNED_SIZE, k)
		bb.StudsOffset = Vector3.new(0, 6, 0)
		bb.MaxDistance = 28
		bb.AlwaysOnTop = false
	else
		bb.Size = clampChipSize(PRICE_BILLBOARD_SIZE, k)
		bb.StudsOffset = Vector3.new(0, 5.5, 0)
		bb.MaxDistance = PRICE_BILLBOARD_MAX_DIST
		bb.AlwaysOnTop = false
	end
	bb.LightInfluence = 0
	-- Defensive: legacy / stale oversized chips
	if bb.Size.X.Offset > PRICE_CHIP_MAX_W * k + 1 then
		bb.Size = clampChipSize(bb.Size, 1)
	end
end

local function hidePriceBillboard(part: BasePart)
	priceHidden[part] = true
	-- every copy: the client host's and a server card still sitting on the part (MapSetup priceBillboard)
	local host = part:FindFirstChild("WE_BillboardHost")
	for _, holder in ipairs({ host, part } :: { Instance? }) do
		local existing = holder and holder:FindFirstChild(BILLBOARD_NAME)
		if existing and existing:IsA("BillboardGui") then
			WorldLabel.SetShown(existing, false) -- F4: through WorldLabel (a LabelGovernor hold stays consistent)
		end
	end
	-- MapSetup non-price Label billboards on other parts are left alone
end

local function resolveBillboardAdornee(part: BasePart): BasePart
	local found = part:FindFirstChild("WE_BillboardHost")
	if found and found:IsA("BasePart") then
		return found
	end
	-- Prefer tall invisible host above kit roof so geometry never occludes BUY name
	local roofY = 0
	for _, ch in ipairs(part:GetChildren()) do
		if ch:IsA("BasePart") and ch:GetAttribute("WE_KitRole") == "Roof" then
			roofY = math.max(roofY, (ch.Position.Y - part.Position.Y) + ch.Size.Y * 0.5)
		end
	end
	local host = Instance.new("Part")
	host.Name = "WE_BillboardHost"
	host.Size = Vector3.new(0.4, 0.4, 0.4)
	host.Transparency = 1
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Massless = true
	host.CFrame = part.CFrame * CFrame.new(0, math.max(roofY + 1.2, 5), 0) -- v39: keep chip near roof
	host.Parent = part
	return host
end

local function ensurePadNameSurface(part: BasePart, displayName: string)
	local existing = part:FindFirstChild("WE_PadNameGui")
	if existing and existing:IsA("SurfaceGui") then
		local lab = existing:FindFirstChild("Name", true)
		if lab and lab:IsA("TextLabel") then
			lab.Text = string.upper(displayName)
			lab.TextColor3 = Color3.fromRGB(255, 245, 180)
			lab.TextStrokeTransparency = 0.2
			lab.BackgroundTransparency = 0.12
		end
		return
	end
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_PadNameGui"
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 60
	sg.LightInfluence = 0
	sg.Parent = part
	local lab = Instance.new("TextLabel")
	lab.Name = "Name"
	lab.Size = UDim2.fromScale(1, 1)
	lab.BackgroundTransparency = 0.12
	lab.BackgroundColor3 = Color3.fromRGB(6, 8, 10)
	lab.Text = string.upper(displayName)
	lab.TextColor3 = Color3.fromRGB(255, 245, 180)
	lab.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	lab.TextStrokeTransparency = 0.2
	lab.Font = Enum.Font.GothamBold
	lab.TextScaled = true
	lab.Parent = sg
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(230, 190, 60)
	stroke.Thickness = 2
	stroke.Transparency = 0.25
	stroke.Parent = lab
end

local function styleChipLabel(lab: TextLabel, maxText: number)
	lab.BackgroundTransparency = 1
	lab.Font = HudConfig.Fonts.Display
	lab.TextScaled = true
	lab.TextWrapped = false
	lab.TextStrokeColor3 = HudConfig.Colors.Ink
	lab.TextStrokeTransparency = CONSOLE_LABEL.StrokeTransparency
	local limit = lab:FindFirstChildOfClass("UITextSizeConstraint")
	if not limit then
		local c = Instance.new("UITextSizeConstraint")
		c.Parent = lab
		limit = c
	end
	if limit then
		limit.MaxTextSize = maxText
		limit.MinTextSize = 8
	end
end

local function ensurePriceBillboard(part: BasePart): BillboardGui
	priceHidden[part] = nil
	local adornee: BasePart = if isConsolePart(part) then part else resolveBillboardAdornee(part)
	local host = part:FindFirstChild("WE_BillboardHost")
	local existing = adornee:FindFirstChild(BILLBOARD_NAME)
		or part:FindFirstChild(BILLBOARD_NAME)
		or (host and host:FindFirstChild(BILLBOARD_NAME))
	if existing and existing:IsA("BillboardGui") then
		existing.Adornee = adornee
		existing.Parent = adornee
		setBillboardNearOnly(existing, nil, part)
		WorldLabel.TagBaseLabel(existing) -- F4: counted by the LabelGovernor
		WorldLabel.SetShown(existing, not nearAtmNow)
		return existing
	end
	local legacy = part:FindFirstChild("Label")
	if legacy and legacy:IsA("BillboardGui") then
		legacy.Name = BILLBOARD_NAME
		setBillboardNearOnly(legacy, nil, part)
		WorldLabel.TagBaseLabel(legacy)
		WorldLabel.SetShown(legacy, not nearAtmNow)
		return legacy
	end

	-- v70: plain 2-line outlined text, NO card (Backdrop stays as a transparent holder)
	local bb = Instance.new("BillboardGui")
	bb.Name = BILLBOARD_NAME
	setBillboardNearOnly(bb, nil, part)
	bb.Adornee = adornee
	WorldLabel.SetShown(bb, not nearAtmNow)
	WorldLabel.TagBaseLabel(bb) -- F4: counted by the LabelGovernor (tagged before it is parented)
	bb.Parent = adornee

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundTransparency = 1
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Text = ""
	title.Parent = backdrop
	local cost = Instance.new("TextLabel")
	cost.Name = "Cost"
	cost.Text = ""
	cost.Parent = backdrop
	return bb
end

local function applyBillboardCopy(bb: BillboardGui, titleLine: string, detailLine: string, detailColor: Color3)
	local k = chipScale()
	-- plain text: no card, no stroke box (server cards arrive with a dark Backdrop + gold Stroke)
	local backdrop = bb:FindFirstChild("Backdrop")
	if backdrop and backdrop:IsA("Frame") then
		backdrop.BackgroundTransparency = 1
		local pad = backdrop:FindFirstChildOfClass("UIPadding")
		if pad then
			pad:Destroy()
		end
	end
	local stroke = bb:FindFirstChild("Stroke", true)
	if stroke and stroke:IsA("UIStroke") then
		stroke.Enabled = false
	end

	-- MapSetup price cards and v70 client labels use Title + Cost; pre-v70 client chips used one "Text"
	local titleLab = bb:FindFirstChild("Title", true)
	local costLab = bb:FindFirstChild("Cost", true)
	local textLab = bb:FindFirstChild("Text", true)

	if titleLab and titleLab:IsA("TextLabel") and costLab and costLab:IsA("TextLabel") then
		local twoLines = detailLine ~= ""
		titleLab.Position = UDim2.fromScale(0, 0)
		titleLab.Size = if twoLines then UDim2.fromScale(1, 0.5) else UDim2.fromScale(1, 1)
		titleLab.Text = titleLine
		titleLab.TextColor3 = CONSOLE_LABEL.NameColor
		styleChipLabel(titleLab, math.floor(CONSOLE_LABEL.NameSize * k + 0.5))
		costLab.Position = UDim2.fromScale(0, 0.5)
		costLab.Size = UDim2.fromScale(1, 0.5)
		costLab.Visible = twoLines
		costLab.Text = detailLine
		costLab.TextColor3 = detailColor
		styleChipLabel(costLab, math.floor(CONSOLE_LABEL.PriceSize * k + 0.5))
	elseif textLab and textLab:IsA("TextLabel") then
		textLab.Text = if detailLine ~= "" then (titleLine .. "\n" .. detailLine) else titleLine
		textLab.TextColor3 = detailColor
		styleChipLabel(textLab, math.floor(CONSOLE_LABEL.NameSize * k + 0.5))
	end
end

-- v72 console tag copy (guide on): fixed-size lines stacked in px around the box centre (WorldLabel's layout), so
-- they never overlap however small the stud box gets; the text overflows the box symmetrically (no clipping).
local function styleTagLabel(lab: TextLabel, px: number)
	lab.BackgroundTransparency = 1
	lab.Font = HudConfig.Fonts.Display
	lab.TextScaled = false
	lab.TextWrapped = false
	lab.TextSize = px
	lab.TextXAlignment = Enum.TextXAlignment.Center
	lab.TextYAlignment = Enum.TextYAlignment.Center
	lab.TextStrokeColor3 = HudConfig.Colors.Ink
	lab.TextStrokeTransparency = CONSOLE_LABEL.StrokeTransparency
	lab.AnchorPoint = Vector2.new(0.5, 0.5)
	lab.Size = UDim2.new(1, 0, 0, px + TAG_LINE_PAD)
	local limit = lab:FindFirstChildOfClass("UITextSizeConstraint")
	if limit then
		limit:Destroy() -- a v70 chip's TextScaled limits; this text is a fixed size
	end
end

local function applyTagCopy(bb: BillboardGui, titleLine: string, titleColor: Color3, detailLine: string, detailColor: Color3)
	local backdrop = bb:FindFirstChild("Backdrop")
	if backdrop and backdrop:IsA("Frame") then
		backdrop.BackgroundTransparency = 1
		local pad = backdrop:FindFirstChildOfClass("UIPadding")
		if pad then
			pad:Destroy()
		end
	end
	local stroke = bb:FindFirstChild("Stroke", true)
	if stroke and stroke:IsA("UIStroke") then
		stroke.Enabled = false
	end
	local titleLab = bb:FindFirstChild("Title", true)
	local costLab = bb:FindFirstChild("Cost", true)
	if titleLab and titleLab:IsA("TextLabel") and costLab and costLab:IsA("TextLabel") then
		styleTagLabel(titleLab, TAG_TITLE_PX)
		styleTagLabel(costLab, TAG_LINE_PX)
		if titleLab.Text ~= titleLine then
			titleLab.Text = titleLine
		end
		titleLab.TextColor3 = titleColor
		local twoLines = detailLine ~= ""
		costLab.Visible = twoLines
		if costLab.Text ~= detailLine then
			costLab.Text = detailLine
		end
		costLab.TextColor3 = detailColor
		if twoLines then
			local hT, hS = TAG_TITLE_PX + TAG_LINE_PAD, TAG_LINE_PX + TAG_LINE_PAD
			titleLab.Position = UDim2.new(0.5, 0, 0.5, -hS / 2)
			costLab.Position = UDim2.new(0.5, 0, 0.5, hT / 2)
		else
			titleLab.Position = UDim2.fromScale(0.5, 0.5)
		end
		return
	end
	local textLab = bb:FindFirstChild("Text", true) -- pre-v70 client chip: one label
	if textLab and textLab:IsA("TextLabel") then
		styleTagLabel(textLab, TAG_LINE_PX)
		textLab.Size = UDim2.new(1, 0, 0, 2 * (TAG_LINE_PX + TAG_LINE_PAD))
		textLab.Position = UDim2.fromScale(0.5, 0.5)
		textLab.Text = if detailLine ~= "" then (titleLine .. "\n" .. detailLine) else titleLine
		textLab.TextColor3 = detailColor
	end
end

-- MapSetup's console screen (ConsoleScreen.WE_ConsoleScreen): the owner reads the level / price there;
-- everyone else just sees the name. Local text only (the server wrote it once at build).
local function consoleScreenLabel(part: BasePart): TextLabel?
	local screenPart = part:FindFirstChild("ConsoleScreen")
	local sg = screenPart and screenPart:FindFirstChild("WE_ConsoleScreen")
	local lbl = sg and sg:FindFirstChildWhichIsA("TextLabel")
	return if lbl and lbl:IsA("TextLabel") then lbl else nil
end

local function setConsoleScreen(part: BasePart, text: string)
	local lbl = consoleScreenLabel(part)
	if lbl and lbl.Text ~= text then
		lbl.Text = text
	end
end

function isOwnPlotPad(part: BasePart): boolean
	-- Hide / skip refresh for other players' plots once we know our PlotId.
	-- Studio / ambiguous PlotId: ALWAYS show BUY (never suppress CTA).
	if myPlotId == nil then
		return true -- loading / solo until assigned
	end
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) ~= "number" then
		-- Also accept BasePlotId attribute some kits use
		pid = part:GetAttribute("BasePlotId")
	end
	if typeof(pid) ~= "number" then
		return true -- ambiguous → show BUY
	end
	return pid == myPlotId
end

local function refreshSlotBillboard(part: BasePart)
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end
	local isConsole = isConsolePart(part)
	local display, level, cost, isMax, prereqHint = structureInfo(structureId)
	local name = string.upper(display)

	if not isOwnPlotPad(part) then
		-- owner-only (spec §5): no price label, no pad wash; the console screen shows just the name
		-- (PromptController disables this console's WE_ServerBuyPrompt locally)
		hidePriceBillboard(part)
		if isConsole then
			setConsoleScreen(part, name)
		end
		return
	end

	local owned = level >= 1
	-- pad-name wash on the pad top: legacy walk-over pads before their first level only (never on consoles)
	local padName = part:FindFirstChild("WE_PadNameGui")
	if padName and (owned or isConsole) then
		padName:Destroy()
	end
	if not owned and not isConsole then
		ensurePadNameSurface(part, display)
	end

	local guide = guideOn()
	if isConsole then
		if isMax then
			setConsoleScreen(part, name .. "\nMAX")
		elseif prereqHint then
			setConsoleScreen(part, name .. "\nLOCKED")
		elseif cost then
			if guide then
				-- v72 (the 15 buildings; business kiosks have no screen): "WAREHOUSE\n$3.2K\n+$5.2/s"
				setConsoleScreen(part, string.format(GTEXT.ScreenLines, TycoonMath.ShortName(structureId), TycoonMath.ShortCash(cost, true), stepGainText(structureId, level)))
			elseif owned then
				setConsoleScreen(part, string.format("%s\nLV %d → %d\n%s", name, level, level + 1, shortCost(cost)))
			else
				setConsoleScreen(part, string.format("%s\nBUILD\n%s", name, shortCost(cost)))
			end
		end
		-- nothing to buy (MAX / locked) → no "Build / Upgrade" pill; the BUY button covers the buyable case
		local sp = part:FindFirstChild("WE_ServerBuyPrompt")
		if sp and sp:IsA("ProximityPrompt") then
			PromptController.SetSuppressed(sp, isMax or prereqHint ~= nil)
		end
	end

	if guide and isConsole then
		-- v72 console tag: MAX stays off where the console screen shows it (the 15 buildings); a business kiosk has
		-- no screen, so its tag reads MAX LEVEL
		local hasScreen = consoleScreenLabel(part) ~= nil
		if isMax and not CONSOLE_LABEL.ShowOnMax and hasScreen then
			hidePriceBillboard(part)
			return
		end
		local bb = ensurePriceBillboard(part)
		local pick = cost ~= nil and not isMax and isNextPick(structureId, level)
		local title = if pick then string.format(GTEXT.TagTitleNext, name) else name
		local titleColor = if pick then TAG.NextColor else CONSOLE_LABEL.NameColor
		local detail, detailColor = "", CONSOLE_LABEL.NameColor
		local met, req = TycoonMath.MeetsRequirements(structureId, upgrades)
		if isMax then
			detail = GTEXT.MaxLevel
		elseif not met and req then
			detail = string.format(GTEXT.Locked, TycoonMath.DisplayName(req.StructureId), req.Level)
			detailColor = CONSOLE_LABEL.LockedColor
		elseif cost then
			local state = TycoonMath.MoneyState(cost, liveCash(), pendingCash(), incomePerSec())
			detail = string.format(GTEXT.TagLine, TycoonMath.ShortCash(cost), stepGainText(structureId, level))
			detailColor = if state ~= "Earn" then CONSOLE_LABEL.PriceAffordable else CONSOLE_LABEL.PriceShort
		end
		bb.MaxDistance = if pick then TAG.NextMaxDistance elseif owned then TAG.MaxDistanceUpgrade else TAG.MaxDistanceBuild
		applyTagCopy(bb, title, titleColor, detail, detailColor)
		return
	end

	-- MAX → no label in the air (MAX is on the console screen); income is on the screen / Base panel
	if isMax and not CONSOLE_LABEL.ShowOnMax then
		hidePriceBillboard(part)
		return
	end

	local bb = ensurePriceBillboard(part)
	setBillboardNearOnly(bb, owned, part)

	if prereqHint then
		-- "Needs Command Center 2" in grey
		applyBillboardCopy(bb, name, (string.gsub(prereqHint, " L(%d+)$", " %1")), CONSOLE_LABEL.LockedColor)
	elseif cost then
		local canAfford = liveCash() >= cost
		local color = if canAfford then CONSOLE_LABEL.PriceAffordable else CONSOLE_LABEL.PriceShort
		if owned then
			applyBillboardCopy(bb, string.format("%s LV %d", name, level), "UPGRADE " .. shortCost(cost), color)
		else
			applyBillboardCopy(bb, name, "BUILD " .. shortCost(cost), color)
		end
	else
		applyBillboardCopy(bb, name, "", CONSOLE_LABEL.NameColor)
	end
end

local function refreshAllBillboardsNow()
	lastBillboardRefresh = os.clock()
	billboardDirty = false
	local stale: { BasePart } = {}
	for part in pairs(slotParts) do
		if part.Parent then
			refreshSlotBillboard(part)
		else
			table.insert(stale, part)
		end
	end
	for _, part in ipairs(stale) do
		slotParts[part] = nil
		disconnectAll(slotConns, part)
	end
	-- Keep BUY label/cost in sync while camping the pad
	if activeBuyPart and activeBuyStructureId and activeBuyPart.Parent then
		refreshPadBuyButton(activeBuyPart, activeBuyStructureId)
	end
end

local function markBillboardsDirty()
	billboardDirty = true
end

function isSeatedInVehicle(): boolean
	local char = player.Character
	if not char then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local seat = hum.SeatPart
	if seat == nil then
		return false
	end
	-- Any seat (VehicleSeat or passenger Seat) — driving over pads must not buy
	if seat:IsA("VehicleSeat") or seat:IsA("Seat") then
		return true
	end
	return false
end

function tryPurchase(structureId: string, opts: { silentMax: boolean?, showBuying: boolean? }?)
	local now = os.clock()
	local last = lastPurchaseAt[structureId] or 0
	if now - last < DEBOUNCE_SEC then
		return
	end
	if pendingPurchase[structureId] then
		print("[WorldPrompt] BUY skip in-flight", structureId)
		return
	end

	local display, _level, cost, isMax, prereqHint = structureInfo(structureId)
	if isMax then
		lastPurchaseAt[structureId] = now
		local silent = opts and opts.silentMax
		local lastMax = maxToastAt[structureId] or 0
		if not silent and (now - lastMax) >= 8 then
			maxToastAt[structureId] = now
			NotificationController.ShowPurchaseFailure("Already at MAX level", "Info", 2)
			print("[WorldPrompt] BUY FAIL MAX", structureId)
		end
		return
	end
	if prereqHint then
		lastPurchaseAt[structureId] = now
		if not (opts and opts.silentMax) then
			local fk = "prereq|" .. structureId
			local lastFail = failToastAt[fk] or 0
			if (now - lastFail) >= FAIL_TOAST_CD then
				failToastAt[fk] = now
				NotificationController.ShowPurchaseFailure(prereqHint, "Warn", 3)
			end
			print("[WorldPrompt] BUY FAIL prereq", structureId, prereqHint)
		end
		return
	end
	local have = liveCash()
	if cost and have < cost then
		-- v57: no client soft-fail toast (server InsufficientCash is authoritative); still FireServer
		print(string.format("[WorldPrompt] BUY soft-hint cash %s have=%d need=%s (FireServer anyway)", structureId, have, tostring(cost)))
	end

	lastPurchaseAt[structureId] = now
	pendingPurchase[structureId] = true
	print(string.format("[WorldPrompt] FireServer RequestPurchaseUpgrade %s cost=%s cash=%d", structureId, tostring(cost), have))
	-- v61: never unbounded GetEvent wait; never "Buying…" unless FireServer ran
	local fired = Remotes.FireServer(Constants.RemoteNames.RequestPurchaseUpgrade, {
		StructureId = structureId,
	} :: Types.PurchaseUpgradeRequest)
	if not fired then
		pendingPurchase[structureId] = nil
		local fk = "noremote|purchase"
		local lastFail = failToastAt[fk] or 0
		if (now - lastFail) >= 8 then
			failToastAt[fk] = now
			NotificationController.ShowPurchaseFailure("Buy failed — remotes not ready. Rejoin game.", "Error", 4)
		end
		warn("[WorldPrompt] BUY FAIL remote missing RequestPurchaseUpgrade")
		return
	end
	if opts and opts.showBuying then
		-- v70: the BUY button itself reads BUYING… (no "Buying X…" toast; the lane drops that line anyway)
		if buyBtn and buyBtn.Visible and activeBuyStructureId == structureId then
			captionHoldUntil = os.clock() + 1.5
			holdBuyCaption("BUYING…")
		end
		print(string.format("[WorldPrompt] BUY sent %s (%s)", structureId, display))
	end
	-- v63: keep in-flight until WE_BuyAck attribute OR PurchaseResult (8s hard timeout)
	local ackBefore = player:GetAttribute("WE_BuyAck")
	task.delay(8, function()
		if pendingPurchase[structureId] then
			-- Only timeout if attribute never advanced (primary ack path missed)
			local ackNow = player:GetAttribute("WE_BuyAck")
			if ackNow ~= nil and ackNow ~= ackBefore then
				pendingPurchase[structureId] = nil
				return
			end
			pendingPurchase[structureId] = nil
			warn("[WorldPrompt] BUY timeout no WE_BuyAck/PurchaseResult", structureId)
			captionHoldUntil = 0
			NotificationController.ShowPurchaseFailure("Buy timed out — try again", "Warn", 3)
		end
	end)
end

local CONSOLE_MARGIN = 5

local function pointInPad(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	local margin = if isConsolePart(part) then CONSOLE_MARGIN else OVERLAP_MARGIN
	return math.abs(localPos.X) <= half.X + margin
		and math.abs(localPos.Z) <= half.Z + margin
		and localPos.Y >= -half.Y - 3
		and localPos.Y <= half.Y + 8
end

local function isOwnPlot(part: BasePart): boolean
	if myPlotId == nil then
		return true -- until plot assigned, allow (solo / loading)
	end
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) ~= "number" then
		pid = part:GetAttribute("BasePlotId")
	end
	if typeof(pid) ~= "number" then
		return true -- ambiguous → allow buy
	end
	return pid == myPlotId
end

local function onEnterPad(part: BasePart, structureId: string, fromStandingRetry: boolean?)
	if isSeatedInVehicle() then
		return
	end
	-- v68: never auto-buy at a console (walk-over + standing retries bought levels by accident)
	if isConsolePart(part) then
		return
	end
	local key = padKey(part, structureId)
	if not isOwnPlot(part) then
		local now = os.clock()
		local last = lastPurchaseAt[structureId] or 0
		if not fromStandingRetry and not lastOverlap[key] and now - last >= DEBOUNCE_SEC then
			lastPurchaseAt[structureId] = now
			NotificationController.Show("Not your base — walk your plot pads to buy", "Warn", 2.5)
		end
		lastOverlap[key] = true
		return
	end
	if lastOverlap[key] and not fromStandingRetry then
		return
	end
	lastOverlap[key] = true
	tryPurchase(structureId, { silentMax = fromStandingRetry == true })
end

local function onLeavePad(key: string)
	lastOverlap[key] = false
end

local function detachUpgradeSlot(part: BasePart)
	disconnectAll(slotConns, part)
	slotParts[part] = nil
end

local function attachUpgradeSlot(part: BasePart)
	if slotParts[part] then
		return
	end
	slotParts[part] = true
	part.CanTouch = true -- walk-over buy must receive Touched

	local existing = part:FindFirstChild(PROMPT_NAME)
	if existing then
		existing:Destroy()
	end

	refreshSlotBillboard(part)
	-- streaming2 F14: the screen part streamed in (late, or again with the server's text): redraw on the next pass
	if streamingOn() and isConsolePart(part) then
		trackConn(slotConns, part, part.ChildAdded:Connect(function(child: Instance)
			if child.Name == "ConsoleScreen" then
				markBillboardsDirty()
			end
		end))
	end

	trackConn(slotConns, part, part.Touched:Connect(function(hit)
		local char = player.Character
		if not char then
			return
		end
		-- Multi-part: only accept character descendants (any body part)
		if not hit:IsDescendantOf(char) then
			return
		end
		local structureId = part:GetAttribute("StructureId")
		if typeof(structureId) == "string" then
			onEnterPad(part, structureId)
		end
	end))

	trackConn(slotConns, part, part.TouchEnded:Connect(function(hit)
		local char = player.Character
		if not char then
			return
		end
		if not hit:IsDescendantOf(char) then
			return
		end
		local structureId = part:GetAttribute("StructureId")
		if typeof(structureId) ~= "string" then
			return
		end
		local key = padKey(part, structureId)
		task.defer(function()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and pointInPad(hrp.Position, part) then
				-- Another character part still overlapping — keep overlap
				return
			end
			onLeavePad(key)
		end)
	end))

	trackConn(slotConns, part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			detachUpgradeSlot(part)
		end
	end))
end

local function attachPromptOnce(part: BasePart, build: () -> ProximityPrompt, onTriggered: () -> ())
	if attachedPrompt[part] then
		return
	end
	attachedPrompt[part] = true
	local prompt = build()
	trackConn(promptConns, part, prompt.Triggered:Connect(function(who)
		if who ~= player then
			return
		end
		onTriggered()
	end))
	trackConn(promptConns, part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			disconnectAll(promptConns, part)
			attachedPrompt[part] = nil
		end
	end))
end

-- v70: the client "Open Base" (WE_BasePlot) and "Hold to capture" (capture zones) prompts are gone (spec §5):
-- the Base menu opens from B / the Command Center map table / the tutorial; capture runs by standing in the zone
-- (the HUD capture bar shows it). A leftover prompt from an older client build is removed on sight.
local function removeClientPrompt(part: BasePart)
	local existing = part:FindFirstChild(PROMPT_NAME)
	if existing and existing:IsA("ProximityPrompt") then
		existing:Destroy()
	end
end

local function attachVehicleSpawn(part: BasePart)
	attachPromptOnce(part, function()
		-- v70: a lane pill "Garage" (PromptController); the seat keeps its own "Drive" prompt
		local prompt = makePrompt(part, "Garage", "", 0, 12)
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		return prompt
	end, function()
		VehicleController.Open()
	end)
end

local function attachTutorialMarker(_part: BasePart)
	-- No proximity prompts / toasts on tutorial markers — TutorialController owns UX
end

local function bindTag(tag: string, handler: (BasePart) -> ())
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		if inst:IsA("BasePart") then
			handler(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
		if inst:IsA("BasePart") then
			handler(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		if inst:IsA("BasePart") then
			if tag == Constants.Tags.UpgradeSlot then
				detachUpgradeSlot(inst)
			else
				disconnectAll(promptConns, inst)
				attachedPrompt[inst] = nil
			end
		end
	end)
end

local function clearOverlapState()
	table.clear(lastOverlap)
	table.clear(pendingPurchase)
	hidePadBuyButton()
end

local WORLD_LABEL_PASS_SEC = 0.25
local lastWorldLabelPass = 0

-- v70: the "TRAINING" worker tags and the training "+$/tick" billboard are removed from the design (spec §5). The
-- server no longer creates either, so the client hook that switched them off is gone too (streaming2 F19: it was a
-- Workspace.DescendantAdded listener that ran for every instance, and under streaming for every stream-in).

-- 4 Hz: SupplyDrop labels step aside near your consoles / ATM; price labels hide near the ATM. A label hidden on
-- purpose (hidePriceBillboard: another plot, MAX) or by WE_PriceForceHidden is never switched back on here.
local function worldLabelPass()
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else nil
	local nearPad = false
	if camPos then
		for part in pairs(slotParts) do
			if part.Parent and (part.Position - camPos).Magnitude <= 20 then
				nearPad = true
				break
			end
		end
		if not nearPad then
			for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.MoneyCollector)) do
				if inst:IsA("BasePart") and (inst.Position - camPos).Magnitude <= 14 then
					nearPad = true
					break
				end
			end
		end
	end
	-- v31: Supply Drop labels — hide when near upgrade pads / ATM so structure names win
	local supplyTag = (Constants.Tags and (Constants.Tags :: any).SupplyDrop) or "WE_SupplyDrop"
	local okSup, supplies = pcall(function()
		return CollectionService:GetTagged(supplyTag)
	end)
	if okSup and supplies then
		for _, crate in ipairs(supplies) do
			if crate:IsA("BasePart") then
				for _, d in ipairs(crate:GetDescendants()) do
					if d:IsA("BillboardGui") then
						d.AlwaysOnTop = false
						if nearPad then
							if d.Enabled then
								d.Enabled = false
							end
						elseif d.MaxDistance > 0 and not d.Enabled then
							d.Enabled = true
						end
					end
				end
			end
		end
	end

	-- P0: hide structure price boards when near MoneyCollector ATM
	local nearAtm = false
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.MoneyCollector)) do
			if inst:IsA("BasePart") and (inst.Position - hrp.Position).Magnitude <= ATM_HIDE_PRICE_STUDS then
				nearAtm = true
				break
			end
		end
	end
	nearAtmNow = nearAtm
	for part in pairs(slotParts) do
		if part.Parent then
			local host = part:FindFirstChild("WE_BillboardHost")
			local bb = (host and host:FindFirstChild(BILLBOARD_NAME)) or part:FindFirstChild(BILLBOARD_NAME)
			if bb and bb:IsA("BillboardGui") then
				local want = not nearAtm and not priceHidden[part] and part:GetAttribute("WE_PriceForceHidden") ~= true
				WorldLabel.SetShown(bb, want) -- F4: writes only on change, keeps a LabelGovernor hold
			end
		end
	end
end

local function startOverlapLoop()
	if overlapConn then
		overlapConn:Disconnect()
		overlapConn = nil
	end
	overlapConn = RunService.Heartbeat:Connect(function()
		-- v70: world-label upkeep at 4 Hz, not every frame (the per-frame workspace:GetDescendants() tag scan and
		-- the WE_HUD season-banner hack are gone: MapSetup / HUD own those labels)
		local now = os.clock()
		if now - lastWorldLabelPass >= WORLD_LABEL_PASS_SEC then
			lastWorldLabelPass = now
			worldLabelPass()
		end
		if billboardDirty and (os.clock() - lastBillboardRefresh) >= billboardThrottle then
			refreshAllBillboardsNow()
		end

		local char = player.Character
		if not char then
			hidePadBuyButton()
			return
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not (hrp and hrp:IsA("BasePart")) then
			hidePadBuyButton()
			return
		end
		if isSeatedInVehicle() then
			-- Driving: clear any stuck overlap so stepping out can buy fresh
			for key in pairs(lastOverlap) do
				if lastOverlap[key] then
					lastOverlap[key] = false
				end
			end
			hidePadBuyButton()
			return
		end

		local pos = hrp.Position
		local bestPart: BasePart? = nil
		local bestSid: string? = nil
		for part in pairs(slotParts) do
			if part.Parent then
				local structureId = part:GetAttribute("StructureId")
				if typeof(structureId) == "string" then
					local key = padKey(part, structureId)
					local inside = pointInPad(pos, part)
					if inside then
						if not lastOverlap[key] then
							onEnterPad(part, structureId)
						else
							-- Standing retry: failed buy / cash refresh / sequential upgrades
							onEnterPad(part, structureId, true)
						end
						-- Prefer own-plot pad for BUY button (first match is fine; typically one pad)
						if isOwnPlot(part) and bestPart == nil then
							bestPart = part
							bestSid = structureId
						end
					elseif lastOverlap[key] then
						onLeavePad(key)
					end
				end
			end
		end
		refreshPadBuyButton(bestPart, bestSid)
	end)
end

local function bindAllTags()
	if tagsBound then
		-- Re-attach any slots that appeared since first bind (GetInstanceAdded covers
		-- new tags, but stale/untagged-then-tagged races still need a GetTagged sweep)
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
			if inst:IsA("BasePart") then
				attachUpgradeSlot(inst)
			end
		end
		return
	end
	tagsBound = true
	bindTag(Constants.Tags.BasePlot, removeClientPrompt)
	bindTag(Constants.Tags.UpgradeSlot, attachUpgradeSlot)
	bindTag(Constants.Tags.CaptureZone, removeClientPrompt)
	bindTag(Constants.Tags.VehicleSpawn, attachVehicleSpawn)
	bindTag(Constants.Tags.TutorialMarker, attachTutorialMarker)
end

-- Attribute fallback: StructureId pads under WarEmpireSetup.Bases missing the tag
local function rescanUntaggedSlots()
	if streamingOn() then
		-- streaming2 F19: the tag path binds every slot, on stream-in too; this walk would only see streamed parts
		return
	end
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		return
	end
	local bases = setup:FindFirstChild("Bases")
	if not bases then
		return
	end
	for _, desc in ipairs(bases:GetDescendants()) do
		if desc:IsA("BasePart") then
			local sid = desc:GetAttribute("StructureId")
			if typeof(sid) == "string" and not slotParts[desc] then
				-- Attach even if CollectionService tag lagged / missing on client replica
				attachUpgradeSlot(desc)
			end
		end
	end
end

function WorldPromptController.Init()
	-- v70 (spec §5): server labels made with WorldLabel{OwnerUserId} carry WE_LabelOwner; hide everyone else's here.
	local okFilter, errFilter = pcall(WorldLabel.StartOwnerFilter)
	if not okFilter then
		warn("[WorldPrompt] WorldLabel owner filter failed:", errFilter)
	end
	-- v58: liveCash listeners FIRST (before BaseState/other remotes that WaitForChild-block)
	local function applyCash(n: any)
		local v = tonumber(n)
		if typeof(v) == "number" then
			cash = math.floor(v)
			buyCopyDirty = true
			markBillboardsDirty()
			-- NEED→BUY while standing when cash syncs
			if activeBuyPart and activeBuyStructureId then
				refreshPadBuyButton(activeBuyPart, activeBuyStructureId)
			end
		end
	end

	-- v60: leaderstats/attrs FIRST — BindEvent never blocks Init
	local function tryLeaderstatsCash(): boolean
		local folder = player:FindFirstChild("leaderstats")
		if not folder then
			return false
		end
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			applyCash((cashV :: any).Value)
			return true
		end
		return false
	end

	local function wireLs(folder: Instance)
		local cashV = folder:FindFirstChild("Cash")
		if cashV and (cashV:IsA("IntValue") or cashV:IsA("NumberValue")) then
			(cashV :: any):GetPropertyChangedSignal("Value"):Connect(function()
				tryLeaderstatsCash()
			end)
		end
		folder.ChildAdded:Connect(function(ch)
			if ch.Name == "Cash" and (ch:IsA("IntValue") or ch:IsA("NumberValue")) then
				(ch :: any):GetPropertyChangedSignal("Value"):Connect(function()
					tryLeaderstatsCash()
				end)
				tryLeaderstatsCash()
			end
		end)
		tryLeaderstatsCash()
	end
	do
		local existing = player:FindFirstChild("leaderstats")
		if existing then
			wireLs(existing)
		end
	end
	player.ChildAdded:Connect(function(ch)
		if ch.Name == "leaderstats" then
			wireLs(ch)
		end
	end)

	do
		local attrCash = player:GetAttribute("WE_Cash")
		if typeof(attrCash) == "number" then
			applyCash(attrCash)
		end
		player:GetAttributeChangedSignal("WE_Cash"):Connect(function()
			applyCash(player:GetAttribute("WE_Cash"))
		end)
	end

	-- v72 guide: the ATM balance, the income rate / multiplier and the server's pick feed the BUY copy and the tags
	-- (server-stamped attributes; a missing one reads as its default, see the helpers at the top)
	if guideOn() then
		local function onGuideInput()
			buyCopyDirty = true
			markBillboardsDirty()
		end
		for _, attr in ipairs({ "WE_PendingCash", "WE_IncomePerSec", "WE_IncomeMult", "WE_NextBuy" }) do
			player:GetAttributeChangedSignal(attr):Connect(onGuideInput)
		end
		HudLayout.InputModeChanged:Connect(onGuideInput) -- the "E" key cap follows PreferredInput
		-- F5 one pointer: the NEXT tag follows the tutorial step (TutorialStateUpdate / the HUD "Tutorial" flag)
		Remotes.BindEvent(Constants.RemoteNames.TutorialStateUpdate, function(payload: any)
			if typeof(payload) == "table" then
				applyTutorialStep(payload.Complete == true, payload.Id, payload.PadStructureId, payload.Pointer)
				markBillboardsDirty()
			end
		end)
		HudLayout.FlagChanged:Connect(function(name: string)
			if name == "Tutorial" then
				markBillboardsDirty()
			end
		end)
	end

	Remotes.BindEvent(Constants.RemoteNames.EconomyUpdate, function(payload: Types.EconomyUpdatePayload)
		applyCash(payload.Cash)
	end)

	-- v70: one failed purchase = one line. WE_BuyAck (attribute) and PurchaseResult (remote) both answer every
	-- buy; the first one shows, the second is skipped for the same structure inside BUY_FAIL_DEDUPE_SEC, and
	-- NotificationController.ShowPurchaseFailure also swallows the server's own Warn echo.
	local lastAckAt: { [string]: number } = {}
	local spendFloatAt: { [string]: number } = {}
	local function failureText(err: string, sid: any): (string, string)
		if err == "NotAtConsole" then
			-- v71 console-only buying: the server saw this character away from its own console for sid
			local def = if typeof(sid) == "string" then BaseConfig.Structures[sid] else nil
			return string.format(ConsoleBuyConfig.Text.NotAtConsole, if def then def.DisplayName else tostring(sid)), "Warn"
		elseif err == "InsufficientCash" then
			return "You need more Money!", "Warn" -- competitor wording; the BUY button already reads NEED $N more
		elseif err == "NoPlot" then
			return "Claim a base first — stand on your plot pad", "Error"
		elseif err == "NoProfile" then
			return "Profile still loading — try BUY again", "Error"
		elseif err == "MissingRequirement" then
			return "Missing prerequisite structure", "Error"
		elseif err == "MaxLevel" then
			return "Already at MAX level", "Info"
		elseif err == "WrongPlot" then
			return "Not your base — walk your plot pads to buy", "Error"
		elseif err == "RateLimited" then
			return "Buying too fast — wait a moment", "Error"
		end
		return "Buy failed: " .. err, "Error"
	end
	local function onBuyResult(source: string, sid: any, ok: boolean, err: string?, newCash: any, newLevel: any)
		if typeof(sid) == "string" then
			pendingPurchase[sid] = nil
		end
		captionHoldUntil = 0
		-- the ack's cash is only meaningful on success (a failed ack stamps WE_BuyCash = 0)
		if ok and typeof(newCash) == "number" then
			applyCash(newCash)
		end
		local key = tostring(sid) .. "|" .. (if ok then "ok" else tostring(err))
		local now = os.clock()
		local dup = now - (lastAckAt[key] or -math.huge) < BUY_FAIL_DEDUPE_SEC
		lastAckAt[key] = now
		if ok then
			local def = if typeof(sid) == "string" then BaseConfig.Structures[sid] else nil
			local name = if def then def.DisplayName else tostring(sid)
			print(string.format("[WorldPrompt] %s OK %s Lv=%s cash=%s", source, tostring(sid), tostring(newLevel), tostring(newCash)))
			if not dup then
				flashPadBuyBought(name, if typeof(sid) == "string" then sid else nil)
			end
			-- "-$20,000" spend float at the cash pill (HudConfig.CashFloat.ShowSpend) — only PurchaseResult knows
			-- the level bought (WE_BuyAck has no level); the server's "Purchase SUCCESSFUL!" line is the toast
			local lvl = tonumber(newLevel)
			local spent = if def and lvl then def.Costs[lvl] else nil
			local fk = tostring(sid) .. "|" .. tostring(lvl)
			if HudConfig.CashFloat.ShowSpend and typeof(spent) == "number" and spent > 0 and now - (spendFloatAt[fk] or -math.huge) > 2 then
				spendFloatAt[fk] = now
				HudLayout.CashFloat(-spent)
			end
		else
			local errStr = tostring(err or "Failed")
			print(string.format("[WorldPrompt] %s FAIL %s → %s%s", source, tostring(sid), errStr, if dup then " (dup)" else ""))
			if not dup then
				local msg, kind = failureText(errStr, sid)
				NotificationController.ShowPurchaseFailure(msg, kind, 3)
			end
		end
		markBillboardsDirty()
	end

	-- v63 PRIMARY: attribute ack (replicates without remotes) — clear pending + apply result
	player:GetAttributeChangedSignal("WE_BuyAck"):Connect(function()
		onBuyResult(
			"WE_BuyAck",
			player:GetAttribute("WE_BuyStructure"),
			player:GetAttribute("WE_BuyOk") == true,
			tostring(player:GetAttribute("WE_BuyErr") or "Failed"),
			player:GetAttribute("WE_BuyCash"),
			nil
		)
	end)

	-- v62/v63 secondary: PurchaseResult remote — clear pending + show server reason (deduped with WE_BuyAck)
	Remotes.BindEvent(Constants.RemoteNames.PurchaseResult, function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		onBuyResult("PurchaseResult", payload.StructureId, payload.Ok == true, tostring(payload.Error or "Failed"), payload.Cash, payload.NewLevel)
	end)

	task.spawn(function()
		local synced = false
		for i = 0, 20 do
			if typeof(player:GetAttribute("WE_Cash")) == "number" then
				applyCash(player:GetAttribute("WE_Cash"))
				synced = true
			end
			if tryLeaderstatsCash() then
				synced = true
			end
			local fn = Remotes.TryGetFunction(Constants.RemoteNames.GetPlayerState)
			if fn then
				local ok, state = pcall(function()
					return fn:InvokeServer()
				end)
				if ok and typeof(state) == "table" then
					applyCash((state :: any).Cash)
					local base = (state :: any).Base
					if typeof(base) == "table" then
						if typeof(base.Upgrades) == "table" then
							upgrades = base.Upgrades
						end
						if typeof(base.PlotId) == "number" then
							myPlotId = base.PlotId
							PromptController.SetMyPlotId(myPlotId)
						end
					end
					markBillboardsDirty()
					print(string.format("[WorldPrompt] cash bootstrap have=%d", cash))
					return
				end
			end
			if synced and i >= 2 then
				markBillboardsDirty()
				print(string.format("[WorldPrompt] cash bootstrap via attr/leaderstats have=%d", cash))
				return
			end
			task.wait(0.25)
		end
		if not synced then
			warn("[WorldPrompt] cash bootstrap failed — relying on EconomyUpdate/Attribute")
		end
	end)

	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: Types.BaseStatePayload)
		local prev = upgrades
		upgrades = base.Upgrades or upgrades
		if typeof(base.PlotId) == "number" then
			if myPlotId ~= nil and myPlotId ~= base.PlotId then
				clearOverlapState()
			end
			myPlotId = base.PlotId
			PromptController.SetMyPlotId(myPlotId)
		end
		if activeBuyStructureId and typeof(upgrades) == "table" then
			local sid = activeBuyStructureId
			local before = if typeof(prev) == "table" then (prev[sid] or 0) else 0
			local after = upgrades[sid] or 0
			if after > before then
				local def = BaseConfig.Structures[sid]
				local name = if def then def.DisplayName else sid
				flashPadBuyBought(name, sid)
				print(string.format("[WorldPrompt] BUY OK flash %s %d→%d", sid, before, after))
			end
		end
		markBillboardsDirty()
	end)

	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: Types.PlayerStatePayload)
		applyCash(state.Cash)
		-- F5 one pointer: the tutorial step (index in the current order) or complete
		if state.TutorialComplete == true then
			applyTutorialStep(true, nil, nil, nil)
		elseif state.TutorialComplete == false and typeof(state.TutorialStep) == "number" then
			local def = TutorialConfig.GetStep(state.TutorialStep)
			if def ~= nil then
				applyTutorialStep(false, def.Id, nil, nil)
			end
		end
		if state.Base then
			upgrades = state.Base.Upgrades
			if typeof(state.Base.PlotId) == "number" then
				if myPlotId ~= nil and myPlotId ~= state.Base.PlotId then
					clearOverlapState()
				end
				myPlotId = state.Base.PlotId
				PromptController.SetMyPlotId(myPlotId)
			end
		end
		markBillboardsDirty()
	end)

	player.CharacterAdded:Connect(function()
		clearOverlapState()
		task.defer(function()
			task.wait(0.3)
			markBillboardsDirty()
		end)
	end)

	player.CharacterRemoving:Connect(function()
		clearOverlapState()
	end)

	task.defer(function()
		-- Wait for map (MapSetup + MapDressing can take >0.5s on cold Studio Play)
		local setup = Workspace:WaitForChild("WarEmpireSetup", 60)
		if not setup then
			warn("[WorldPromptController] WarEmpireSetup missing after 60s — binding tags anyway")
		end
		bindAllTags()
		startOverlapLoop()
		refreshAllBillboardsNow()
		rescanUntaggedSlots()
		local n = 0
		for _ in pairs(slotParts) do
			n += 1
		end
		print(string.format("[WorldPrompt] bound upgrade slots=%d tagged=%d", n, #CollectionService:GetTagged(Constants.Tags.UpgradeSlot)))

		-- Periodic rescan first ~20s for race / late-tagged pads
		for _ = 1, 10 do
			task.wait(2)
			bindAllTags()
			rescanUntaggedSlots()
			refreshAllBillboardsNow()
		end
		local n2 = 0
		for _ in pairs(slotParts) do
			n2 += 1
		end
		print(string.format("[WorldPrompt] after rescan slots=%d", n2))
	end)
end

return WorldPromptController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="215">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="216">
            <Properties>
              <string name="Name">AimTargets</string>
              <string name="Source"><![CDATA[--!strict
--[[
	AimTargets (W2 CC-3, contracts §5.2): the CLIENT mirror of the server assist cone (CombatService/CombatAssist,
	contracts §1.3 step 3). It only feeds the camera aim help (CameraFx friction / tracking); the server stays
	authoritative and re-runs its own cone on every shot. Nothing here names a target to the server.

	API
	  Init()                               idempotent; tracks players (PlayerAdded / PlayerRemoving) and tagged NPCs
	                                       (CollectionService signals) — never a tree scan
	  InputClass() -> string               "Touch" | "Gamepad" | "KeyboardAndMouse" from UserInputService.PreferredInput
	                                       (fallback: TouchEnabled and not KeyboardEnabled = Touch)
	  HelpLevel() -> (keep, tracking)      HudConfig.AimHelp level of the current class (Off = 1, 0)
	  HelpLevelFor(cls) -> (keep, tracking) same for a given class (CameraFx, per frame)
	  SetActive(on)                        scans at AimHelp.ScanHz only while on (drawn) and the level is not Off
	  Best(camCF, weaponRange) -> (Model?, BasePart?)
	                                       the last scan's in-cone hostile with the smallest angle, re-checked against
	                                       camCF (cheap math, no allocation): per frame from CameraFx
	  IsHostile(model) -> boolean          alive player (PvP on) or combat NPC; not me, not a friendly squad unit,
	                                       not shielded (WE_ShieldUntil / ForceField), not in my vehicle, not in an
	                                       enclosed seat (WE_Exposed == false)
	  SetViewSource(fn)                    CameraFx: the camera CFrame WITHOUT shake (AimCFrame) for the scan
	  _SetClassOverride(cls?)              tests

	CONE (same numbers as the server): AimAssistConfig.Classes[class].MaxConeDeg around the camera look, range
	min(weapon Range, AimAssistConfig.MaxRangeStuds), at most AimHelp.MaxCandidates candidates and AimHelp.MaxLosRays
	line-of-sight rays per scan. Clan allies are not known on the client (no attribute in W2): the server excludes
	them from its assist; the camera may still slow over an ally (assumption A-CC3-4).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- ships with the place (Rojo); bounded wait anyway
local Constants = require(Shared.Constants)
local HudConfig = require(Shared.Configs.HudConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local AimAssistConfig = require(Shared.Configs.AimAssistConfig)

local AimTargets = {}

local AH = HudConfig.AimHelp
local SCAN_HZ: number = math.clamp(tonumber(AH.ScanHz) or 10, 1, 10)
local MAX_CAND: number = math.clamp(tonumber(AH.MaxCandidates) or 8, 1, 16)
local MAX_LOS: number = math.clamp(tonumber(AH.MaxLosRays) or 2, 1, 4)
local CONE_HYSTERESIS = 1.25 -- Best() keeps the scanned target while it stays inside 1.25 x the cone
local SHIELD_ATTR = "WE_ShieldUntil"
local SQUAD_FOLDER = "WarEmpireSquads"

local player = Players.LocalPlayer

local initialized = false
local active = false
local loopRunning = false
local classOverride: string? = nil
local viewSource: (() -> CFrame)? = nil
local wantRange: number = AimAssistConfig.MaxRangeStuds

local playerList: { Player } = {}
local npcModels: { [Instance]: boolean } = {}

-- last scan result
local bestModel: Model? = nil
local bestPart: BasePart? = nil
local bestHum: Humanoid? = nil
local scanCount = 0

-- preallocated candidate arrays (a scan builds no tables)
local candModel: { Model } = {}
local candPart: { BasePart } = {}
local candHum: { Humanoid } = {}
local candCos: { number } = {}
local candN = 0

local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true
losParams.RespectCanCollide = true
local losFilterChar: Instance? = nil
local losFilterVeh: Instance? = nil
local losFilterSquads: Instance? = nil
local losFilterList: { Instance } = {}

---------------------------------------------------------------------------------------------------------------
-- input class
---------------------------------------------------------------------------------------------------------------

local function readPreferredInput(): any
	return (UserInputService :: any).PreferredInput
end

local function readLastInput(): any
	return UserInputService:GetLastInputType()
end

function AimTargets.InputClass(): string
	local o = classOverride
	if o then
		return o
	end
	local ok, v = pcall(readPreferredInput)
	if ok and typeof(v) == "EnumItem" then
		local name = (v :: EnumItem).Name
		if name == "Touch" or name == "Gamepad" or name == "KeyboardAndMouse" then
			return name
		end
	end
	local okL, last = pcall(readLastInput)
	if okL and typeof(last) == "EnumItem" then
		local lname = (last :: EnumItem).Name
		if string.sub(lname, 1, 7) == "Gamepad" then
			return "Gamepad"
		end
	end
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Touch"
	end
	return "KeyboardAndMouse"
end

function AimTargets._SetClassOverride(cls: string?)
	classOverride = cls
end

type Level = { FrictionKeep: number, Tracking: number }

local function levelFor(cls: string): Level?
	if AH.Enabled == false then
		return nil
	end
	local name = (AH.Strength :: any)[cls]
	if type(name) ~= "string" then
		return nil
	end
	local lv = (AH.Levels :: any)[name]
	if type(lv) ~= "table" then
		return nil
	end
	return lv :: Level
end

-- (FrictionKeep, Tracking) for an input class; Off / unknown = (1, 0) = no help. Per frame from CameraFx
-- (plain table reads, no allocation).
function AimTargets.HelpLevelFor(cls: string): (number, number)
	local lv = levelFor(cls)
	if lv == nil then
		return 1, 0
	end
	return math.clamp(tonumber(lv.FrictionKeep) or 1, 0.2, 1), math.clamp(tonumber(lv.Tracking) or 0, 0, 0.5)
end

-- same for the current class
function AimTargets.HelpLevel(): (number, number)
	return AimTargets.HelpLevelFor(AimTargets.InputClass())
end

local function helpOn(): boolean
	local keep, tracking = AimTargets.HelpLevel()
	return keep < 1 or tracking > 0
end

local function coneCos(clsName: string, scale: number): number
	local cls = (AimAssistConfig.Classes :: any)[clsName]
	local deg = if type(cls) == "table" then tonumber(cls.MaxConeDeg) or 0 else 0
	return math.cos(math.rad(math.clamp(deg * scale, 0, 45)))
end

---------------------------------------------------------------------------------------------------------------
-- hostility
---------------------------------------------------------------------------------------------------------------

local function torsoOf(model: Model): BasePart?
	local t = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	if t and t:IsA("BasePart") then
		return t
	end
	return nil
end

-- the vehicle model a seat belongs to (nearest ancestor tagged WE_Vehicle, else nearest Model)
local function vehicleOf(seat: Instance): Instance?
	local p = seat.Parent
	local firstModel: Instance? = nil
	local depth = 0
	while p and p ~= Workspace and depth < 8 do
		if p:IsA("Model") then
			if CollectionService:HasTag(p, Constants.Tags.Vehicle) then
				return p
			end
			if firstModel == nil then
				firstModel = p
			end
		end
		p = p.Parent
		depth += 1
	end
	return firstModel
end

local function localHumanoid(): Humanoid?
	local ch = player.Character
	if not ch then
		return nil
	end
	return ch:FindFirstChildOfClass("Humanoid")
end

local function serverNow(): number
	local ok, t = pcall(Workspace.GetServerTimeNow, Workspace)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

local function hostileHumanoid(model: Model): Humanoid?
	if model == player.Character then
		return nil
	end
	local other = Players:GetPlayerFromCharacter(model)
	if other then
		if other == player or not GameConfig.PvPEnabled then
			return nil
		end
	else
		if typeof(model:GetAttribute("NPCId")) ~= "string" then
			return nil
		end
		if model:GetAttribute("FriendlySquad") or model:GetAttribute("OwnerUserId") then
			return nil -- squad units are never targets (same filter as CombatController / SquadOrdersService)
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	local shield = model:GetAttribute(SHIELD_ATTR)
	if typeof(shield) == "number" and shield > serverNow() then
		return nil
	end
	if model:FindFirstChildOfClass("ForceField") then
		return nil
	end
	local seat = hum.SeatPart
	if seat then
		if seat:GetAttribute("WE_Exposed") == false then
			return nil -- enclosed seat: the vehicle is the target, not the occupant
		end
		local mine = localHumanoid()
		local mySeat = if mine then mine.SeatPart else nil
		if mySeat and vehicleOf(mySeat) == vehicleOf(seat) then
			return nil -- rides in my vehicle
		end
	end
	return hum
end

function AimTargets.IsHostile(model: Model): boolean
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return false
	end
	return hostileHumanoid(model) ~= nil
end

---------------------------------------------------------------------------------------------------------------
-- scan (AimHelp.ScanHz, only while active)
---------------------------------------------------------------------------------------------------------------

local function viewCF(): CFrame?
	local src = viewSource
	if src then
		local ok, cf = pcall(src)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
	end
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame else nil
end

local function refreshLosFilter()
	local ch = player.Character
	local hum = localHumanoid()
	local seat = if hum then hum.SeatPart else nil
	local veh = if seat then vehicleOf(seat) else nil
	local squads = Workspace:FindFirstChild(SQUAD_FOLDER)
	if ch == losFilterChar and veh == losFilterVeh and squads == losFilterSquads then
		return
	end
	losFilterChar, losFilterVeh, losFilterSquads = ch, veh, squads
	table.clear(losFilterList)
	if ch then
		table.insert(losFilterList, ch)
	end
	if veh then
		table.insert(losFilterList, veh)
	end
	if squads then
		table.insert(losFilterList, squads)
	end
	losParams.FilterDescendantsInstances = losFilterList
end

-- scan inputs (module locals so consider() is a plain function, no closure per scan)
local scanOrigin = Vector3.zero
local scanLook = Vector3.zAxis
local scanRange = 0
local scanCos = 1
local bestConeCos = 1 -- Best()'s hysteresis cone, refreshed by every scan (no per-frame class lookups)

local function consider(model: Model)
	local hum = hostileHumanoid(model)
	if not hum then
		return
	end
	local part = torsoOf(model)
	if not part then
		return -- streamed out / not built yet
	end
	local v = part.Position - scanOrigin
	local dist = v.Magnitude
	if not (dist > 0.05 and dist <= scanRange) then
		return
	end
	local c = scanLook:Dot(v) / dist
	if not (c > 0 and c >= scanCos) then
		return
	end
	-- keep the MAX_CAND candidates closest to the view centre (largest cosine)
	local slot = 0
	if candN < MAX_CAND then
		candN += 1
		slot = candN
	else
		local worst = 1
		for k = 2, candN do
			if candCos[k] < candCos[worst] then
				worst = k
			end
		end
		if candCos[worst] >= c then
			return
		end
		slot = worst
	end
	candModel[slot] = model
	candPart[slot] = part
	candHum[slot] = hum
	candCos[slot] = c
end

local function clearBest()
	bestModel, bestPart, bestHum = nil, nil, nil
end

local function scan()
	scanCount += 1
	candN = 0
	local cf = viewCF()
	if not cf or not helpOn() then
		clearBest()
		return
	end
	scanOrigin = cf.Position
	scanLook = cf.LookVector
	scanRange = math.max(0, math.min(wantRange, AimAssistConfig.MaxRangeStuds))
	local cls = AimTargets.InputClass()
	scanCos = coneCos(cls, 1)
	bestConeCos = coneCos(cls, CONE_HYSTERESIS)
	if GameConfig.PvPEnabled then
		for _, other in ipairs(playerList) do
			local ch = other.Character
			if other ~= player and ch and ch.Parent then
				consider(ch)
			end
		end
	end
	for inst in pairs(npcModels) do
		if inst.Parent == nil then
			npcModels[inst] = nil
		elseif inst:IsA("Model") then
			consider(inst)
		end
	end
	local n = candN
	local found = false
	if n > 0 then
		refreshLosFilter()
		for _ = 1, math.min(n, MAX_LOS) do
			local best = 0
			for k = 1, n do
				if candCos[k] > -2 and (best == 0 or candCos[k] > candCos[best]) then
					best = k
				end
			end
			if best == 0 then
				break
			end
			candCos[best] = -3 -- taken
			local part = candPart[best]
			local dir = part.Position - scanOrigin
			local hit = Workspace:Raycast(scanOrigin, dir, losParams)
			if hit == nil or hit.Instance:IsDescendantOf(candModel[best]) then
				bestModel, bestPart, bestHum = candModel[best], part, candHum[best]
				found = true
				break
			end
		end
	end
	if not found then
		clearBest()
	end
	-- drop instance references until the next scan
	table.clear(candModel)
	table.clear(candPart)
	table.clear(candHum)
	candN = 0
end

local function onScanError(err: any)
	warn("[AimTargets] scan failed:", err)
end

local function startLoop()
	if loopRunning then
		return
	end
	loopRunning = true
	task.spawn(function()
		local period = 1 / SCAN_HZ
		while active and helpOn() do
			if not xpcall(scan, onScanError) then
				clearBest()
			end
			task.wait(period)
		end
		loopRunning = false
		clearBest()
	end)
end

function AimTargets.SetActive(on: boolean)
	active = on == true
	if active and helpOn() then
		startLoop()
	elseif not active then
		clearBest()
	end
end

function AimTargets.IsActive(): boolean
	return active
end

function AimTargets.Best(camCF: CFrame, weaponRange: number): (Model?, BasePart?)
	if type(weaponRange) == "number" and weaponRange > 0 then
		wantRange = weaponRange
	end
	if not active then
		return nil, nil
	end
	local m, p, h = bestModel, bestPart, bestHum
	if m == nil or p == nil or h == nil then
		return nil, nil
	end
	if m.Parent == nil or p.Parent == nil or h.Health <= 0 then
		clearBest()
		return nil, nil
	end
	local v = p.Position - camCF.Position
	local dist = v.Magnitude
	local range = math.min(wantRange, AimAssistConfig.MaxRangeStuds) * 1.1
	if not (dist > 0.05 and dist <= range) then
		return nil, nil
	end
	local c = camCF.LookVector:Dot(v) / dist
	if not (c > 0 and c >= bestConeCos) then
		return nil, nil
	end
	return m, p
end

function AimTargets.SetViewSource(fn: (() -> CFrame)?)
	viewSource = fn
end

-- tests
function AimTargets._ScanNow()
	scan()
end

function AimTargets._ScanCount(): number
	return scanCount
end

---------------------------------------------------------------------------------------------------------------
-- init
---------------------------------------------------------------------------------------------------------------

local function trackNpc(inst: Instance)
	if inst:IsA("Model") then
		npcModels[inst] = true
	end
end

function AimTargets.Init()
	if initialized then
		return
	end
	initialized = true
	for _, p in ipairs(Players:GetPlayers()) do
		table.insert(playerList, p)
	end
	Players.PlayerAdded:Connect(function(p: Player)
		if not table.find(playerList, p) then
			table.insert(playerList, p)
		end
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		local i = table.find(playerList, p)
		if i then
			table.remove(playerList, i)
		end
	end)
	local tag = Constants.Tags.NPC
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		trackNpc(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(trackNpc)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst: Instance)
		npcModels[inst] = nil
	end)
end

return AimTargets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="217">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Client audio (W1 SND): pooled one-shots, music, ambience and engine loops. Every key, id, volume and licence source
	lives in Shared/Configs/SoundConfig.luau; AudioHooks maps existing remotes / HUD signals onto keys.

	API
	  Init()                            idempotent (UIController and AudioHooks both call it); starts the base theme
	  Play(key, at?) -> boolean         one-shot. at = Vector3 | BasePart | Attachment | Model → 3D at that point,
	                                    nil → 2D. Returns false (never errors) for: unknown key, Id 0 / "", SFX muted,
	                                    the key's cooldown, a lower-priority Stinger inside the collapse window, a 3D
	                                    point beyond MaxDistance, the voice cap with nothing lower to steal, the server
	  Loop(channel, key?, fade?) -> boolean
	                                    sets a loop channel ("Music" | "Ambience" | "Engine" | any name) to `key`
	                                    (nil stops it) with a crossfade. A muted channel remembers its key and resumes
	                                    when unmuted. true = audible now
	  SetLoopPitch(channel, pitch)      engine pitch (AudioHooks samples the chassis speed at 10 Hz)
	  GetLoop(channel) -> string?       the channel's key (QA)
	  SetNextNotificationKey(key?)      AudioHooks: the typed key for NotificationController's next PlayNotification
	  HasSound(key) -> boolean          key exists with a playable Id
	  GetStats() -> Stats               counters (tests / Studio)
	  unchanged legacy API: PlayClick() · PlayNotification() · GetMusicVolume() · GetSfxVolume()

	PHONES (CLAUDE.md §1): no RenderStepped / Heartbeat work here; at most Mix.MaxConcurrent one-shots (2D + 3D) and
	Mix.MaxConcurrent2D of them 2D; per-key cooldowns; Sounds are pooled (no Instance churn per play) and 3D voices
	are pooled Attachments under Workspace.Terrain (always present under StreamingEnabled). Client only: nothing
	here runs on the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local ClientSettings = require(script.Parent.ClientSettings)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundConfig = require(Shared.Configs.SoundConfig)

type SoundDef = SoundConfig.SoundDef

type Voice = {
	Key: string,
	Sound: Sound,
	Attachment: Attachment?,
	Positional: boolean,
	BusyUntil: number,
	StartedAt: number,
	Priority: number,
	Serial: number,
}

type Channel = {
	Name: string,
	Key: string?,
	Slots: { Sound }, -- two Sounds per channel, alternated for crossfades
	Gen: { number }, -- per slot: bumps on every (re)start so a pending fade-out stop never hits a reused slot
	Active: number, -- slot index that carries Key (0 = none)
	Target: number, -- volume the active slot fades to
	Resume: { [string]: number }, -- TimePosition per key (music picks up where it left off)
}

type StingerMark = { Voice: Voice, Serial: number, Priority: number, At: number }

export type Stats = {
	Started: number, -- one-shots that began playing
	Replaced: number, -- Stingers cut by a higher-priority Stinger inside the window
	LoopStarts: number, -- loop channels that began playing audibly
	Active: number,
	Active2D: number,
	Active3D: number,
	PeakActive: number,
	Dropped: { [string]: number }, -- Missing · Muted · Cooldown · Collapsed · Cap · Far · Server · Loop · Error
	ByKey: { [string]: number },
	LastKey: string?,
}

local AudioController = {}

local Mix = SoundConfig.Mix
local STOP_FADE = 0.4 -- s: MaxSeconds one-shots fade out instead of cutting

local initDone = false
local folder: Folder? = nil
local pools: { [string]: { Voice } } = {}
local playing: { Voice } = {}
local lastPlayedAt: { [string]: number } = {}
local lastStinger: StingerMark? = nil
local channels: { [string]: Channel } = {}
local pendingNotify: { Key: string, At: number }? = nil
local serial = 0
local warned: { [string]: boolean } = {}

local stats: Stats = {
	Started = 0,
	Replaced = 0,
	LoopStarts = 0,
	Active = 0,
	Active2D = 0,
	Active3D = 0,
	PeakActive = 0,
	Dropped = {},
	ByKey = {},
	LastKey = nil,
}

local function now(): number
	return os.clock()
end

local function drop(reason: string): boolean
	stats.Dropped[reason] = (stats.Dropped[reason] or 0) + 1
	return false
end

-- Sounds are a client concern: a require from server code must never create one.
local function isServerContext(): boolean
	local ok, server = pcall(function(): boolean
		return RunService:IsServer() and not RunService:IsClient()
	end)
	return ok and server == true
end

local function rawDef(key: string): SoundDef?
	local d = (SoundConfig.Sounds :: any)[key]
	if type(d) == "table" then
		return d :: SoundDef
	end
	return nil
end

local function defOf(key: string): SoundDef?
	local d = rawDef(key)
	if d == nil and not warned[key] then
		warned[key] = true
		warn("[AudioController] unknown sound key:", key)
	end
	return d
end

-- "rbxassetid://<n>" for a positive asset id, the string itself for an engine path; nil = disabled / missing
local function soundIdOf(def: SoundDef?): string?
	if def == nil then
		return nil
	end
	local id: any = def.Id
	if type(id) == "number" then
		if id >= 1 and id < math.huge then
			return "rbxassetid://" .. tostring(math.floor(id))
		end
		return nil
	elseif type(id) == "string" then
		if id ~= "" then
			return id
		end
	end
	return nil
end

local function masterFor(def: SoundDef): number
	if def.Bus == "Music" then
		return Mix.MusicMaster
	end
	return Mix.SfxMaster
end

local function volumeOf(def: SoundDef): number
	return math.clamp(def.Volume, 0, 1) * masterFor(def)
end

local function pitchOf(def: SoundDef): number
	local p = def.Pitch
	if type(p) == "number" and p > 0 then
		return p
	end
	return 1
end

local function maxDistOf(def: SoundDef): number
	if def.MaxDistance > 0 then
		return def.MaxDistance
	end
	return Mix.DefaultMaxDistance
end

local function rollOffOf(name: string): Enum.RollOffMode
	local ok, item = pcall(function(): any
		return (Enum.RollOffMode :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" then
		return item :: Enum.RollOffMode
	end
	return Enum.RollOffMode.InverseTapered
end

local function allowedFor(def: SoundDef): boolean
	if def.Bus == "Music" then
		return ClientSettings.ShouldPlayMusic()
	end
	return ClientSettings.ShouldPlaySfx()
end

local function ensureFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local existing = SoundService:FindFirstChild("WarEmpireAudio")
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local nf = Instance.new("Folder")
	nf.Name = "WarEmpireAudio"
	nf.Parent = SoundService
	folder = nf
	return nf
end

local function tweenVolume(s: Sound, target: number, seconds: number)
	if seconds <= 0 then
		s.Volume = target
		return
	end
	local ok = pcall(function()
		TweenService:Create(s, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Volume = target }):Play()
	end)
	if not ok then
		s.Volume = target
	end
end

local function listenerPos(): Vector3?
	local cam = Workspace.CurrentCamera
	if cam then
		local ok, p = pcall(function(): Vector3
			return cam.CFrame.Position
		end)
		if ok and typeof(p) == "Vector3" then
			return p
		end
	end
	return nil
end

local function finite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < math.huge and math.abs(v.Y) < math.huge and math.abs(v.Z) < math.huge
end

local function positionOf(at: any): Vector3?
	local ty = typeof(at)
	local pos: Vector3? = nil
	if ty == "Vector3" then
		pos = at :: Vector3
	elseif ty == "Instance" then
		local inst = at :: Instance
		pcall(function()
			if inst:IsA("BasePart") then
				pos = inst.Position
			elseif inst:IsA("Attachment") then
				pos = inst.WorldPosition
			elseif inst:IsA("Model") then
				pos = inst:GetPivot().Position
			end
		end)
	end
	if pos and finite(pos) then
		return pos
	end
	return nil
end

---------------------------------------------------------------------------------------------------------------
-- one-shot voices
---------------------------------------------------------------------------------------------------------------

local function prune(t: number)
	for i = #playing, 1, -1 do
		if playing[i].BusyUntil <= t then
			table.remove(playing, i)
		end
	end
end

local function stopVoice(v: Voice)
	v.BusyUntil = 0
	local i = table.find(playing, v)
	if i then
		table.remove(playing, i)
	end
	pcall(function()
		v.Sound:Stop()
	end)
end

local function count2D(): number
	local n = 0
	for _, v in ipairs(playing) do
		if not v.Positional then
			n += 1
		end
	end
	return n
end

-- the busy voice to steal for a new one of `priority`: lowest priority first, then the oldest; nil = keep them all
local function victimFor(priority: number, positional: boolean?): Voice?
	local best: Voice? = nil
	for _, v in ipairs(playing) do
		if positional == nil or v.Positional == positional then
			local b = best
			if b == nil or v.Priority < b.Priority or (v.Priority == b.Priority and v.StartedAt < b.StartedAt) then
				best = v
			end
		end
	end
	if best and best.Priority <= priority then
		return best
	end
	return nil
end

local function newVoice(key: string, def: SoundDef, positional: boolean): Voice
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = soundIdOf(def) or ""
	s.Looped = false
	s.Volume = volumeOf(def)
	local att: Attachment? = nil
	if positional then
		local a = Instance.new("Attachment")
		a.Name = "WE_Audio"
		a.Parent = Workspace.Terrain
		s.Parent = a
		att = a
	else
		s.Parent = ensureFolder()
	end
	local v: Voice = {
		Key = key,
		Sound = s,
		Attachment = att,
		Positional = positional,
		BusyUntil = 0,
		StartedAt = 0,
		Priority = 1,
		Serial = 0,
	}
	pcall(function()
		s.Ended:Connect(function()
			v.BusyUntil = 0
		end)
	end)
	return v
end

local function acquire(key: string, def: SoundDef, positional: boolean, t: number): Voice
	local poolKey = if positional then key .. "@3D" else key
	local pool = pools[poolKey]
	if pool == nil then
		pool = {}
		pools[poolKey] = pool
	end
	local list = pool :: { Voice }
	for _, v in ipairs(list) do
		if v.BusyUntil <= t then
			return v
		end
	end
	if #list < math.max(1, Mix.PoolPerKey) then
		local v = newVoice(key, def, positional)
		table.insert(list, v)
		return v
	end
	local oldest = list[1]
	for _, v in ipairs(list) do
		if v.StartedAt < oldest.StartedAt then
			oldest = v
		end
	end
	stopVoice(oldest)
	return oldest
end

local function lengthOf(def: SoundDef, s: Sound): number
	local maxS = def.MaxSeconds
	if maxS and maxS > 0 then
		return maxS + STOP_FADE
	end
	local tl: number? = nil
	pcall(function()
		tl = s.TimeLength
	end)
	if tl and tl > 0 then
		return tl / pitchOf(def)
	end
	return def.LengthSeconds or Mix.DefaultLengthSeconds
end

local function startVoice(v: Voice, def: SoundDef, pos: Vector3?, t: number, priority: number)
	local s = v.Sound
	local id = soundIdOf(def) or ""
	if s.SoundId ~= id then
		s.SoundId = id
	end
	s.Volume = volumeOf(def)
	s.PlaybackSpeed = pitchOf(def)
	local att = v.Attachment
	if att and pos then
		att.WorldPosition = pos
		s.RollOffMode = rollOffOf(def.RollOff)
		s.RollOffMinDistance = def.MinDistance or Mix.MinDistance
		s.RollOffMaxDistance = maxDistOf(def)
	end
	s.TimePosition = 0
	s:Play()
	serial += 1
	v.Serial = serial
	v.StartedAt = t
	v.Priority = priority
	v.BusyUntil = t + lengthOf(def, s)
	table.insert(playing, v)
	local maxS = def.MaxSeconds
	if maxS and maxS > 0 then
		local mine = v.Serial
		task.delay(maxS, function()
			if v.Serial ~= mine or v.BusyUntil <= 0 then
				return
			end
			tweenVolume(s, 0, STOP_FADE)
			task.delay(STOP_FADE, function()
				if v.Serial == mine and v.BusyUntil > 0 then
					stopVoice(v)
				end
			end)
		end)
	end
end

--[[ One-shot `key` (SoundConfig.Sounds). at = Vector3 | BasePart | Attachment | Model plays it in 3D there; nil = 2D.
	true = it started. Never errors (missing / disabled ids return false). ]]
function AudioController.Play(key: string, at: any?): boolean
	if type(key) ~= "string" then
		return drop("Missing")
	end
	if isServerContext() then
		return drop("Server")
	end
	if not initDone then
		pcall(AudioController.Init)
	end
	local def = defOf(key)
	if def == nil or soundIdOf(def) == nil then
		return drop("Missing")
	end
	local bus = def.Bus or "World"
	if bus == "Music" or bus == "Loop" then
		return drop("Loop") -- loops go through AudioController.Loop
	end
	if not ClientSettings.ShouldPlaySfx() then
		return drop("Muted")
	end
	local t = now()
	local last = lastPlayedAt[key]
	if last ~= nil and t - last < math.max(0, def.CooldownSeconds) then
		return drop("Cooldown")
	end
	local pos: Vector3? = nil
	if at ~= nil then
		pos = positionOf(at)
		if pos == nil then
			return drop("Missing")
		end
		local ear = listenerPos()
		if ear and (ear - pos).Magnitude > maxDistOf(def) then
			return drop("Far")
		end
	end
	local positional = pos ~= nil
	local priority = def.Priority or 1
	prune(t)

	-- one audible Stinger per window: the higher priority wins (PurchaseResult + cash float + toast = one sound)
	if bus == "Stinger" then
		local mark = lastStinger
		if mark and t - mark.At < Mix.StingerWindowSeconds then
			if priority <= mark.Priority then
				return drop("Collapsed")
			end
			if mark.Voice.Serial == mark.Serial and mark.Voice.BusyUntil > t then
				stopVoice(mark.Voice)
				stats.Replaced += 1
			end
		end
	end

	-- voice caps (steal the lowest priority / oldest, or drop this one)
	if not positional and count2D() >= Mix.MaxConcurrent2D then
		local victim = victimFor(priority, false)
		if victim == nil then
			return drop("Cap")
		end
		stopVoice(victim)
	end
	if #playing >= Mix.MaxConcurrent then
		local victim = victimFor(priority, nil)
		if victim == nil then
			return drop("Cap")
		end
		stopVoice(victim)
	end

	local okAcquire, voice = pcall(acquire, key, def, positional, t)
	if not okAcquire or voice == nil then
		return drop("Error")
	end
	local v = voice :: Voice
	local okStart = pcall(startVoice, v, def, pos, t, priority)
	if not okStart then
		stopVoice(v)
		return drop("Error")
	end
	lastPlayedAt[key] = t
	if bus == "Stinger" then
		lastStinger = { Voice = v, Serial = v.Serial, Priority = priority, At = t }
	end
	stats.Started += 1
	stats.ByKey[key] = (stats.ByKey[key] or 0) + 1
	stats.LastKey = key
	if #playing > stats.PeakActive then
		stats.PeakActive = #playing
	end
	return true
end

---------------------------------------------------------------------------------------------------------------
-- loop channels (music, ambience, engine)
---------------------------------------------------------------------------------------------------------------

local function channelOf(name: string): Channel
	local c = channels[name]
	if c == nil then
		local nc: Channel = { Name = name, Key = nil, Slots = {}, Gen = { 0, 0 }, Active = 0, Target = 0, Resume = {} }
		channels[name] = nc
		return nc
	end
	return c
end

local function slotSound(c: Channel, idx: number): Sound
	local s = c.Slots[idx]
	if s and s.Parent then
		return s
	end
	local ns = Instance.new("Sound")
	ns.Name = c.Name .. "_" .. tostring(idx)
	ns.Looped = true
	ns.Volume = 0
	ns.Parent = ensureFolder()
	c.Slots[idx] = ns
	return ns
end

local function fadeOutSlot(c: Channel, idx: number, seconds: number)
	local slot: Sound? = c.Slots[idx]
	if slot == nil then
		return
	end
	local s = slot :: Sound
	c.Gen[idx] += 1
	local gen = c.Gen[idx]
	tweenVolume(s, 0, seconds)
	task.delay(math.max(0, seconds), function()
		if c.Gen[idx] == gen then
			pcall(function()
				s:Stop()
			end)
		end
	end)
end

-- (re)apply the channel's state after a settings change or a same-key Loop call; true = audible
local function applyChannel(c: Channel, fade: number): boolean
	local key = c.Key
	if key == nil or c.Active == 0 then
		return false
	end
	local def = rawDef(key)
	local slot: Sound? = c.Slots[c.Active]
	if def == nil or slot == nil then
		return false
	end
	local s = slot :: Sound
	if allowedFor(def) then
		c.Gen[c.Active] += 1
		if s.IsPlaying and math.abs(s.Volume - c.Target) < 1e-3 then
			return true -- already there (the 1.5 s ambience check lands here: no tween churn)
		end
		if not s.IsPlaying then
			local okResume = pcall(function()
				if s.TimePosition > 0 then
					s:Resume()
				else
					s:Play()
				end
			end)
			if not okResume then
				pcall(function()
					s:Play()
				end)
			end
			stats.LoopStarts += 1
		end
		tweenVolume(s, c.Target, fade)
		return true
	end
	pcall(function()
		s.Volume = 0
		s:Pause()
	end)
	return false
end

--[[ Set loop channel `channel` to `key` (nil = stop) with a `fade`-second crossfade (default Mix.LoopFadeSeconds).
	A missing / disabled key stops the channel. true = the key is audible now (false while muted: it resumes later). ]]
function AudioController.Loop(channel: string, key: string?, fade: number?): boolean
	if type(channel) ~= "string" or isServerContext() then
		return false
	end
	if not initDone then
		pcall(AudioController.Init)
	end
	local c = channelOf(channel)
	local seconds = if type(fade) == "number" then math.max(0, fade) else Mix.LoopFadeSeconds
	local want: string? = key
	local def: SoundDef? = nil
	if want ~= nil then
		def = defOf(want)
		if def == nil or soundIdOf(def) == nil then
			drop("Missing")
			want = nil
			def = nil
		end
	end
	if c.Key == want then
		return applyChannel(c, seconds)
	end
	-- fade out whatever the channel carries now (music remembers where it was)
	if c.Active ~= 0 then
		local cur = c.Slots[c.Active]
		local curKey = c.Key
		if cur and curKey then
			pcall(function()
				c.Resume[curKey] = cur.TimePosition
			end)
		end
		fadeOutSlot(c, c.Active, seconds)
	end
	local prevActive = c.Active
	c.Key = want
	c.Active = 0
	if want == nil or def == nil then
		return false
	end
	local d = def :: SoundDef
	local idx = if prevActive == 1 then 2 else 1
	local s = slotSound(c, idx)
	c.Gen[idx] += 1
	s.SoundId = soundIdOf(d) or ""
	s.Looped = true
	s.PlaybackSpeed = pitchOf(d)
	s.Volume = 0
	c.Active = idx
	c.Target = volumeOf(d)
	if d.Bus == "Music" then
		local at = c.Resume[want]
		pcall(function()
			s.TimePosition = if at and at > 0 then at else 0
		end)
	else
		pcall(function()
			s.TimePosition = 0
		end)
	end
	if not allowedFor(d) then
		return false
	end
	s:Play()
	stats.LoopStarts += 1
	tweenVolume(s, c.Target, seconds)
	return true
end

--[[ Engine pitch etc.: writes PlaybackSpeed on the channel's active Sound (skips changes < Engine.PitchEpsilon). ]]
function AudioController.SetLoopPitch(channel: string, pitch: number)
	local c = channels[channel]
	if c == nil or c.Active == 0 or type(pitch) ~= "number" or pitch ~= pitch then
		return
	end
	local slot: Sound? = c.Slots[c.Active]
	if slot == nil then
		return
	end
	local s = slot :: Sound
	local p = math.clamp(pitch, 0.1, 4)
	if math.abs(s.PlaybackSpeed - p) >= SoundConfig.Engine.PitchEpsilon then
		s.PlaybackSpeed = p
	end
end

function AudioController.GetLoop(channel: string): string?
	local c = channels[channel]
	return if c then c.Key else nil
end

---------------------------------------------------------------------------------------------------------------
-- settings, init, legacy API
---------------------------------------------------------------------------------------------------------------

local function applySettings()
	if not ClientSettings.ShouldPlaySfx() then
		-- every pooled voice, not only the ones still counted busy (a file longer than its LengthSeconds hint)
		for _, pool in pairs(pools) do
			for _, v in ipairs(pool) do
				stopVoice(v)
			end
		end
	end
	for _, c in pairs(channels) do
		applyChannel(c, Mix.LoopFadeSeconds)
	end
end

function AudioController.Init()
	if initDone or isServerContext() then
		return
	end
	initDone = true
	ensureFolder()
	-- warm one 2D voice per UI / Stinger key so the first cue does not wait on a cold asset load
	for key, def in pairs(SoundConfig.Sounds) do
		if (def.Bus == "Stinger" or def.Bus == "UI") and soundIdOf(def) ~= nil and pools[key] == nil then
			pools[key] = { newVoice(key, def, false) }
		end
	end
	ClientSettings.OnChanged(applySettings)
	AudioController.Loop("Music", SoundConfig.Music.Base, SoundConfig.Music.FadeSeconds)
end

--[[ AudioHooks: NotificationController's next PlayNotification (within Hooks.NotificationTypeWindowSeconds) plays
	`key` instead of the plain UI.Notify ping. nil clears it. ]]
function AudioController.SetNextNotificationKey(key: string?)
	if key == nil then
		pendingNotify = nil
		return
	end
	pendingNotify = { Key = key, At = now() }
end

function AudioController.HasSound(key: string): boolean
	return soundIdOf(rawDef(key)) ~= nil
end

function AudioController.GetStats(): Stats
	prune(now())
	local n2, n3 = 0, 0
	for _, v in ipairs(playing) do
		if v.Positional then
			n3 += 1
		else
			n2 += 1
		end
	end
	return {
		Started = stats.Started,
		Replaced = stats.Replaced,
		LoopStarts = stats.LoopStarts,
		Active = #playing,
		Active2D = n2,
		Active3D = n3,
		PeakActive = stats.PeakActive,
		Dropped = table.clone(stats.Dropped),
		ByKey = table.clone(stats.ByKey),
		LastKey = stats.LastKey,
	}
end

--[[ UI button activate — respects SFX toggle. ]]
function AudioController.PlayClick()
	AudioController.Play("UI.Click")
end

--[[ Toast / reward ping — respects SFX toggle. The line's type (set by AudioHooks from the Notification remote in
	the same frame) picks the key; deferred one step so that hook has run whichever handler fired first. ]]
function AudioController.PlayNotification()
	if not ClientSettings.ShouldPlaySfx() then
		return
	end
	task.defer(function()
		local key = "UI.Notify"
		local p = pendingNotify
		if p and now() - p.At <= SoundConfig.Hooks.NotificationTypeWindowSeconds then
			key = p.Key
		end
		pendingNotify = nil
		AudioController.Play(key)
	end)
end

function AudioController.GetMusicVolume(): number
	return Mix.LegacyMusicVolume
end

function AudioController.GetSfxVolume(): number
	return Mix.LegacySfxVolume
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="218">
            <Properties>
              <string name="Name">AudioHooks</string>
              <string name="Source"><![CDATA[--!strict
--[[
	AudioHooks (W1 SND): turns EXISTING remotes and client signals into AudioController cues. It only listens: it never
	fires a remote, never writes another controller's state and needs no edit in Missile / Vehicle / Combat or any
	other controller. Keys and ids: Shared/Configs/SoundConfig.luau (Hooks table).

	  Notification            payload.Type (after NotificationConfig.Rewrite) → the key NotificationController's own
	                          PlayNotification plays for that line (SetNextNotificationKey), so a dropped / throttled
	                          line stays silent and a shown line makes exactly one sound. A HudConfig.Toast.Reroute rule
	                          with AlertSeconds ("BASE UNDER ATTACK!" banner) types that ping as Hooks.AlertReroute.
	  HudLayout.CashFloatRequested  +amount → Cash.Collect · −amount → Cash.Purchase
	  PurchaseResult          Ok → Cash.Purchase · not Ok → UI.Denied
	  TerritoryStateUpdate    diffs: my capture starts → Capture.Start · a zone becomes mine → Capture.Secured ·
	                          a zone stops being mine → Capture.Lost (the first payload is the baseline: silent)
	  AtmRaidStateUpdate      Phase "Alarm" (I am being robbed) → Alarm.Raid (1 s pushes; the key cooldown spaces it)
	  MissileStrikeFx         I am the victim → Alarm.Missile (the real siren), once per StrikeId; MissileController's
	                          own click siren (SoundService."WE_MissileSiren") is muted by name when that key is valid
	  XPUpdate                LevelUp → Level.Up
	  Humanoid.SeatPart       a vehicle seat → the "Engine" loop; its pitch follows the chassis speed, sampled at
	                          Engine.SampleHz (10 Hz) — the only periodic audio work while seated
	  HudLayout flags         Drawn AND Hurt (not Dead) → "Music" channel = combat layer; back to the base theme
	                          Music.CombatHoldSeconds after it clears
	  Ambience                ONE loop: desert wind, or surf within Ambience.NearWaterStuds of a WE_Water part
	                          (checked every Ambience.CheckSeconds, not per frame)

	Every handler is pcall-guarded: a bad payload can never break the remote's other listeners.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local SoundConfig = require(Shared.Configs.SoundConfig)
local NotificationConfig = require(Shared.Configs.NotificationConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local AudioController = require(script.Parent.AudioController)
local HudLayout = require(script.Parent.HudLayout)

local Hooks = SoundConfig.Hooks

local AudioHooks = {}

local initDone = false

local function guard(name: string, fn: (...any) -> ()): (...any) -> ()
	return function(...: any)
		local ok, err = pcall(fn :: any, ...)
		if not ok then
			warn("[AudioHooks] " .. name .. " failed:", err)
		end
	end
end

local function myUserId(): number
	local lp = Players.LocalPlayer
	return if lp then lp.UserId else -1
end

---------------------------------------------------------------------------------------------------------------
-- Notification remote
---------------------------------------------------------------------------------------------------------------

local function onNotification(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local text = if type(payload.Message) == "string" then payload.Message else ""
	local t = if type(payload.Type) == "string" then payload.Type else "Info"
	-- same first-match Rewrite NotificationController applies (it can change the type, e.g. LEVEL → Reward)
	for _, rule in ipairs(NotificationConfig.Rewrite) do
		if string.find(text, rule.Match) then
			if rule.Type then
				t = rule.Type
			end
			break
		end
	end
	-- same first-match Reroute: an Alert rule ("DEF HIT" → the BASE UNDER ATTACK! banner) pings through
	-- NotificationController.ShowAlert, and only when the rule's MinGapSeconds lets the banner show
	local key: string? = nil
	for _, rule in ipairs(HudConfig.Toast.Reroute) do
		if string.find(text, rule.Match) then
			if rule.AlertSeconds and rule.AlertSeconds > 0 then
				key = Hooks.AlertReroute
			elseif rule.Type then
				t = rule.Type
			end
			break
		end
	end
	key = key or Hooks.NotificationTypes[t]
	if key then
		AudioController.SetNextNotificationKey(key)
	end
end

---------------------------------------------------------------------------------------------------------------
-- cash float + purchase results + level up + raid alarm
---------------------------------------------------------------------------------------------------------------

local function onCashFloat(amount: any)
	if type(amount) ~= "number" or amount ~= amount or amount == 0 then
		return
	end
	AudioController.Play(if amount > 0 then Hooks.CashGain else Hooks.CashSpend)
end

local function onPurchaseResult(payload: any)
	if type(payload) ~= "table" then
		return
	end
	AudioController.Play(if payload.Ok == true then Hooks.PurchaseOk else Hooks.PurchaseFail)
end

local function onXP(payload: any)
	if type(payload) == "table" and payload.LevelUp == true then
		AudioController.Play(Hooks.LevelUp)
	end
end

local function onAtmRaid(payload: any)
	if type(payload) == "table" and payload.Phase == Hooks.RaidAlarmPhase then
		AudioController.Play(Hooks.RaidAlarm)
	end
end

---------------------------------------------------------------------------------------------------------------
-- territory diffs
---------------------------------------------------------------------------------------------------------------

local territoryBaseline = false
local mine: { [string]: boolean } = {}
local capturingId: string? = nil

local function onTerritory(payload: any)
	if type(payload) ~= "table" or type(payload.Territories) ~= "table" then
		return
	end
	local me = myUserId()
	local nowMine: { [string]: boolean } = {}
	local secured, lost = false, false
	for _, e in ipairs(payload.Territories) do
		if type(e) == "table" and type(e.Id) == "string" then
			local owned = tonumber(e.OwnerUserId) == me and e.OwnerType ~= "Neutral" and e.OwnerType ~= "NPC"
			if owned then
				nowMine[e.Id] = true
				if not mine[e.Id] then
					secured = true
				end
			elseif mine[e.Id] then
				lost = true
			end
		end
	end
	local lc = payload.LocalCapture
	local capId: string? = nil
	if type(lc) == "table" and lc.Capturing == true and type(lc.TerritoryId) == "string" then
		capId = lc.TerritoryId
	end
	local started = capId ~= nil and capId ~= capturingId and not nowMine[capId :: string]
	mine = nowMine
	capturingId = capId
	if not territoryBaseline then
		territoryBaseline = true -- join / first push: what I already own is not news
		return
	end
	-- one cue per push (a push that both secures and loses is rare; the bigger news wins)
	if secured then
		AudioController.Play(Hooks.CaptureSecured)
	elseif lost then
		AudioController.Play(Hooks.CaptureLost)
	elseif started then
		AudioController.Play(Hooks.CaptureStart)
	end
end

---------------------------------------------------------------------------------------------------------------
-- missile strike (victim siren)
---------------------------------------------------------------------------------------------------------------

local seenStrikes: { [number]: boolean } = {}
local seenCount = 0

local function serverNow(): number
	local ok, t = pcall(function(): number
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

local function onMissileFx(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if tonumber(payload.VictimUserId) ~= myUserId() then
		return
	end
	local id = tonumber(payload.StrikeId)
	if id == nil or seenStrikes[id] then
		return
	end
	seenCount += 1
	if seenCount > 256 then
		seenStrikes = {}
		seenCount = 1
	end
	seenStrikes[id] = true
	local launch = tonumber(payload.LaunchTime)
	local flight = tonumber(payload.FlightSeconds)
	if launch and flight and serverNow() > launch + flight + Hooks.MissileLateSeconds then
		return -- late joiner: the strike is already over
	end
	AudioController.Play(Hooks.MissileVictim)
end

-- MissileController plays its own click "siren" (a Sound named WE_MissileSiren in SoundService). The victim hears
-- the licensed siren from onMissileFx instead, so that click is silenced here — no edit to MissileController.
local function onSoundServiceChild(child: Instance)
	local name = Hooks.LegacyMissileSirenName
	if name == "" or child.Name ~= name or not child:IsA("Sound") then
		return
	end
	if AudioController.HasSound(Hooks.MissileVictim) then
		(child :: Sound).Volume = 0
	end
end

---------------------------------------------------------------------------------------------------------------
-- engine loop (Humanoid.SeatPart)
---------------------------------------------------------------------------------------------------------------

type Profile = SoundConfig.EngineProfile

local engineToken = 0

local function vehicleModelOf(seat: Instance): Model?
	local m = seat:FindFirstAncestorWhichIsA("Model")
	while m do
		if m:GetAttribute("WE_Category") ~= nil or CollectionService:HasTag(m, Constants.Tags.Vehicle) then
			return m
		end
		m = m:FindFirstAncestorWhichIsA("Model")
	end
	return nil
end

-- profile + max speed for a seat; nil = not a vehicle (a bench or a chair)
local function engineFor(seat: Instance): (Profile?, number)
	local E = SoundConfig.Engine
	local model = vehicleModelOf(seat)
	if model == nil then
		if seat:IsA("VehicleSeat") then
			return E.Default, E.DefaultMaxSpeed
		end
		return nil, E.DefaultMaxSpeed
	end
	local maxSpeed = tonumber(model:GetAttribute("WE_MaxSpeed")) or E.DefaultMaxSpeed
	if maxSpeed <= 0 then
		maxSpeed = E.DefaultMaxSpeed
	end
	local family = model:GetAttribute("WE_KitFamily")
	if type(family) == "string" then
		for _, f in ipairs(E.Families) do
			if string.sub(family, 1, #f.Prefix) == f.Prefix then
				return { Key = f.Key, PitchMin = f.PitchMin, PitchMax = f.PitchMax }, maxSpeed
			end
		end
	end
	local cat = model:GetAttribute("WE_Category")
	if type(cat) == "string" and E.Categories[cat] then
		return E.Categories[cat], maxSpeed
	end
	return E.Default, maxSpeed
end

local function stopEngine()
	engineToken += 1
	AudioController.Loop("Engine", nil)
end

local function speedOf(seat: BasePart): number
	local v: any = nil
	pcall(function()
		v = seat.AssemblyLinearVelocity
	end)
	if typeof(v) == "Vector3" then
		local m = (v :: Vector3).Magnitude
		if m == m then
			return m
		end
	end
	return 0
end

local function startEngine(seat: BasePart)
	local profile, maxSpeed = engineFor(seat)
	if profile == nil then
		stopEngine()
		return
	end
	engineToken += 1
	local token = engineToken
	local p = profile :: Profile
	AudioController.Loop("Engine", p.Key)
	AudioController.SetLoopPitch("Engine", p.PitchMin)
	local dt = 1 / math.max(1, SoundConfig.Engine.SampleHz)
	task.spawn(function()
		while token == engineToken do
			task.wait(dt)
			if token ~= engineToken then
				break
			end
			if seat.Parent == nil then
				stopEngine()
				break
			end
			local frac = math.clamp(speedOf(seat) / maxSpeed, 0, 1)
			AudioController.SetLoopPitch("Engine", p.PitchMin + (p.PitchMax - p.PitchMin) * frac)
		end
	end)
end

local function onSeatPart(seat: Instance?)
	if seat ~= nil and seat:IsA("BasePart") then
		startEngine(seat)
	else
		stopEngine()
	end
end

local humConns: { RBXScriptConnection } = {}

local function clearHumanoid()
	for _, c in ipairs(humConns) do
		c:Disconnect()
	end
	table.clear(humConns)
end

local function bindHumanoid(hum: Humanoid)
	onSeatPart(hum.SeatPart)
	table.insert(humConns, hum:GetPropertyChangedSignal("SeatPart"):Connect(guard("SeatPart", function()
		onSeatPart(hum.SeatPart)
	end)))
	table.insert(humConns, hum.Died:Connect(guard("Died", function()
		stopEngine()
	end)))
end

local function bindCharacter(char: Model)
	clearHumanoid()
	stopEngine()
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		bindHumanoid(hum)
		return
	end
	local conn: RBXScriptConnection? = nil
	conn = char.ChildAdded:Connect(guard("CharacterChild", function(c: Instance)
		if c:IsA("Humanoid") then
			if conn then
				conn:Disconnect()
			end
			bindHumanoid(c)
		end
	end))
	if conn then
		table.insert(humConns, conn)
	end
end

---------------------------------------------------------------------------------------------------------------
-- music layer (HudLayout flags)
---------------------------------------------------------------------------------------------------------------

local combatOn = false
local combatToken = 0

local function evalCombat()
	local M = SoundConfig.Music
	local want = HudLayout.GetFlag("Drawn") and HudLayout.GetFlag("Hurt") and not HudLayout.GetFlag("Dead")
	if want then
		combatToken += 1
		if not combatOn then
			combatOn = true
			AudioController.Loop("Music", M.Combat, M.FadeSeconds)
		end
		return
	end
	if not combatOn then
		return
	end
	combatToken += 1
	local token = combatToken
	local hold = if HudLayout.GetFlag("Dead") then 0 else M.CombatHoldSeconds
	task.delay(hold, function()
		if token == combatToken and combatOn then
			combatOn = false
			AudioController.Loop("Music", M.Base, M.FadeSeconds)
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- ambience (one loop: wind, or surf near WE_Water)
---------------------------------------------------------------------------------------------------------------

local waterParts: { BasePart } = {}
local nearWaterNow = false

local function addWater(inst: Instance)
	if inst:IsA("BasePart") and not table.find(waterParts, inst) then
		table.insert(waterParts, inst)
	end
end

local function removeWater(inst: Instance)
	local i = table.find(waterParts, inst :: any)
	if i then
		table.remove(waterParts, i)
	end
end

local function waterWithin(pos: Vector3, studs: number): boolean
	local r2 = studs * studs
	for _, p in ipairs(waterParts) do
		if p.Parent then
			local lp = p.CFrame:PointToObjectSpace(pos)
			local hs = p.Size * 0.5
			local dx = math.max(math.abs(lp.X) - hs.X, 0)
			local dz = math.max(math.abs(lp.Z) - hs.Z, 0)
			if dx * dx + dz * dz <= r2 then
				return true
			end
		end
	end
	return false
end

local function ear(): Vector3?
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position
	end
	return nil
end

local function checkAmbience()
	local A = SoundConfig.Ambience
	local pos = ear()
	if pos then
		if nearWaterNow then
			nearWaterNow = waterWithin(pos, A.LeaveWaterStuds)
		else
			nearWaterNow = waterWithin(pos, A.NearWaterStuds)
		end
	end
	AudioController.Loop("Ambience", if nearWaterNow then A.NearWater else A.Default, A.FadeSeconds)
end

---------------------------------------------------------------------------------------------------------------
-- init
---------------------------------------------------------------------------------------------------------------

function AudioHooks.Init()
	if initDone then
		return
	end
	initDone = true
	AudioController.Init()

	local R = Constants.RemoteNames
	Remotes.BindEvent(R.Notification, guard("Notification", onNotification))
	Remotes.BindEvent(R.PurchaseResult, guard("PurchaseResult", onPurchaseResult))
	Remotes.BindEvent(R.TerritoryStateUpdate, guard("TerritoryStateUpdate", onTerritory))
	Remotes.BindEvent(R.AtmRaidStateUpdate, guard("AtmRaidStateUpdate", onAtmRaid))
	Remotes.BindEvent(R.MissileStrikeFx, guard("MissileStrikeFx", onMissileFx))
	Remotes.BindEvent(R.XPUpdate, guard("XPUpdate", onXP))
	HudLayout.CashFloatRequested:Connect(guard("CashFloat", onCashFloat))
	HudLayout.FlagChanged:Connect(guard("FlagChanged", function(name: string, _on: boolean)
		if name == "Drawn" or name == "Hurt" or name == "Dead" then
			evalCombat()
		end
	end))
	SoundService.ChildAdded:Connect(guard("SoundServiceChild", onSoundServiceChild))

	local lp = Players.LocalPlayer
	if lp then
		if lp.Character then
			guard("Character", bindCharacter)(lp.Character)
		end
		lp.CharacterAdded:Connect(guard("CharacterAdded", bindCharacter))
		lp.CharacterRemoving:Connect(guard("CharacterRemoving", function()
			clearHumanoid()
			stopEngine()
		end))
	end

	local tag = Constants.Tags.Water
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		addWater(inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(addWater)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(removeWater)
	guard("Ambience", checkAmbience)()
	task.spawn(function()
		while true do
			task.wait(SoundConfig.Ambience.CheckSeconds)
			guard("Ambience", checkAmbience)()
		end
	end)
end

return AudioHooks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="219">
            <Properties>
              <string name="Name">BusinessVisuals</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v72 war businesses: the CLIENT-ONLY look (BusinessConfig.Visual / .Crates). Money never comes from here: it sends
	nothing to the server and the server reads nothing from it. Init is a no-op while BusinessConfig.Enabled is false.

	Crates  pooled local Parts ride YOUR lines' belts and drop into the bin: at most Visual.MaxCratesPerLine per line
	        (1 while the saved Graphics Quality is 1..LowQualityLevel), only while your character is within
	        ActiveRadius of the belt and the line is level 1+. One Heartbeat accumulator runs a 4 Hz scan (ownership,
	        level, parts, distance, belt geometry) and a <= UpdateHz (max 20) step that moves every live crate with ONE
	        Workspace:BulkMoveTo into preallocated arrays; the step itself only does arithmetic on cached values.
	        Crates are never destroyed while the game runs: idle ones are hidden and go back to a pool per crate look,
	        so after warm-up (<= MaxCratesPerLine per own line) no Instance is created.
	Pops    "+$N" (TycoonMath.PopText = floor(IncomePerTick[level] x WE_IncomeMult)) over the bins of your nearest lines
	        each time the server bumps the Player attribute WE_PassiveTick (every 5 s): at most MaxPopsPerTick, only
	        for lines whose bin is within PopRadius of your character. MaxPopsPerTick pooled WorldLabel billboards,
	        animated at 10 Hz by the same Heartbeat (no thread per pop). F4: the pops are base labels (tag
	        WorldLabelConfig.BaseLabelTag, shown / hidden with WorldLabel.SetShown), so the client LabelGovernor
	        counts them toward the "at most 3 labels on screen at a base" cap.
	Streaming-safe: lines come and go with the BusinessConfig.Tag tag (stream in / out); parts are looked up with
	FindFirstChild on the scan, never WaitForChild, and the step never touches a server part. Other players' lines
	stay static (their Models are tracked but skipped). Owner-only by construction: everything here is local.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- Bootstrap already waited for it; bounded anyway
local BusinessConfig = require(Shared.Configs.BusinessConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local TycoonMath = require(Shared.Util.TycoonMath)
local WorldLabel = require(Shared.Util.WorldLabel)

local BusinessVisuals = {}

type CrateLook = { Size: Vector3, Color: Color3, Material: Enum.Material, Shape: Enum.PartType? }

type Line = {
	model: Model,
	def: BusinessConfig.BusinessDef,
	look: CrateLook?,
	level: number,
	active: boolean,
	crates: { BasePart },
	startAt: { number }, -- per crate: clock when it entered the belt (-1 = idle, hidden)
	nextAt: number,
	popMark: number,
	-- belt geometry (world), refreshed by the scan so the step never reads a part
	rot: CFrame, -- belt rotation, no position
	p0: Vector3, -- crate centre at the belt start
	p1: Vector3, -- crate centre at the belt end
	along: Vector3, -- p1 - p0
	drop: Vector3, -- p1 -> crate centre sunk half into the bin's top face
	travel: number, -- seconds on the belt
	every: number, -- seconds between crates at this level
}

type Pop = { gui: BillboardGui, title: TextLabel?, startAt: number }

local V = BusinessConfig.Visual
local player = Players.LocalPlayer

-- look-only constants (proposed BusinessConfig.Visual keys; see build/C/assumptions.md)
local SCAN_EVERY = 0.25 -- 4 Hz ownership / distance / geometry scan
local DROP_FRAC = 0.25 -- the drop into the bin lasts this share of the belt time
local POP_EVERY = 0.1 -- pop animation at 10 Hz (CLAUDE.md UI refresh cap)
local POP_SECONDS = 1.2 -- a pop is on screen this long
local POP_HOLD = 0.5 -- fully opaque for the first half, then it fades out
local POP_RISE = 1.5 -- studs it floats up over its life
local POP_OFFSET = Vector3.new(0, 3, 0) -- above the bin's centre
local POP_STUDS = Vector2.new(3, 1.2)
local POP_NAME = "WE_BizCashPop"
local FOLDER_NAME = "WE_BusinessCratesLocal"

local STEP_EVERY = 1 / math.clamp(V.UpdateHz, 1, 20) -- never more than 20 BulkMoveTo calls per second

local started = false
local clock = 0 -- seconds since Init, summed from Heartbeat dt
local lines: { [Model]: Line } = {}
local activeCount = 0
local maxCrates = V.MaxCratesPerLine
local folder: Folder? = nil
local free: { [string]: { BasePart } } = {} -- idle crates by crate look (BusinessDef.Product)
local pops: { Pop } = {}
local popsLive = 0
local popSerial = 0
-- BulkMoveTo buffers: grown once, entries overwritten in place, stale tail trimmed each step
local movedParts: { BasePart } = {}
local movedCFrames: { CFrame } = {}

local function savedQuality(): number
	local ok, level = pcall(function()
		return (UserSettings():GetService("UserGameSettings") :: any).SavedQualityLevel.Value
	end)
	return if ok and typeof(level) == "number" then level else 0 -- 0 = Automatic (or unknown)
end

local function cratesPerLine(): number
	local q = savedQuality()
	if q > 0 and q <= V.LowQualityLevel then
		return 1
	end
	return V.MaxCratesPerLine
end

-- our local folder went away (and every pooled crate / pop with it): forget them, they are rebuilt lazily
local function forgetPool()
	folder = nil
	table.clear(free)
	table.clear(pops)
	popsLive = 0
	for _, l in pairs(lines) do
		table.clear(l.crates)
		table.clear(l.startAt)
		l.active = false
	end
	table.clear(movedParts)
	table.clear(movedCFrames)
end

local function crateFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	if f then
		forgetPool() -- a pop can land before the next scan notices: never hand out crates / pops from a dead folder
	end
	local nf = Instance.new("Folder")
	nf.Name = FOLDER_NAME
	nf.Parent = Workspace
	folder = nf
	return nf
end

local function isMine(m: Instance): boolean
	return m:GetAttribute("OwnerUserId") == player.UserId
end

local function levelOf(m: Instance): number
	local v = tonumber(m:GetAttribute("Level"))
	if v == nil or v ~= v then
		return 0
	end
	return math.floor(v)
end

local function characterPos(): Vector3?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.Position
	end
	return nil
end

local function newCrate(look: CrateLook): BasePart
	local p = Instance.new("Part")
	p.Name = "Crate"
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = look.Size
	p.Color = look.Color
	p.Material = look.Material
	if look.Shape then
		p.Shape = look.Shape
	end
	p.Transparency = 1 -- idle crates are hidden, never destroyed (pool)
	p.Parent = crateFolder()
	return p
end

local function takeCrate(l: Line): BasePart?
	local look = l.look
	if look == nil then
		return nil
	end
	local list = free[l.def.Product]
	local n = if list then #list else 0
	if list and n > 0 then
		local c = list[n]
		list[n] = nil
		return c
	end
	return newCrate(look)
end

-- hide the LAST crate of the line and give it back to the pool
local function releaseLast(l: Line)
	local i = #l.crates
	local c = l.crates[i]
	l.crates[i] = nil
	l.startAt[i] = nil
	if c.Transparency ~= 1 then
		c.Transparency = 1
	end
	local list = free[l.def.Product]
	if list == nil then
		list = {}
		free[l.def.Product] = list
	end
	table.insert(list, c)
end

local function releaseAll(l: Line)
	for _ = 1, #l.crates do
		releaseLast(l)
	end
	l.active = false
end

-- grow / shrink the line's crates to the current per-line cap (pool first, new Part only while warming up)
local function fit(l: Line)
	while #l.crates > maxCrates do
		releaseLast(l)
	end
	while #l.crates < maxCrates do
		local c = takeCrate(l)
		if c == nil then
			break
		end
		table.insert(l.crates, c)
		table.insert(l.startAt, -1)
	end
end

-- belt geometry in world space; the belt runs along its local X toward the bin (sign from where the bin sits)
local function measure(l: Line, belt: BasePart, bin: BasePart, look: CrateLook)
	local bcf = belt.CFrame
	local len = belt.Size.X
	local dir = if bcf:PointToObjectSpace(bin.Position).X >= 0 then 1 else -1
	local lift = belt.Size.Y * 0.5 + look.Size.Y * 0.5
	local p0 = bcf:PointToWorldSpace(Vector3.new(-dir * 0.5 * len, lift, 0))
	local p1 = bcf:PointToWorldSpace(Vector3.new(dir * 0.5 * len, lift, 0))
	local sink = bin.Position + Vector3.new(0, bin.Size.Y * 0.5, 0)
	l.rot = bcf.Rotation
	l.p0 = p0
	l.p1 = p1
	l.along = p1 - p0
	l.drop = sink - p1
	l.travel = math.max(0.25, len / math.max(V.BeltSpeed, 0.1))
	local every = l.def.CrateEverySec
	l.every = math.max(0.2, every[math.clamp(l.level, 1, #every)] or 2)
end

local function track(inst: Instance)
	if not inst:IsA("Model") or lines[inst] or inst.Parent == nil then
		return
	end
	local id = inst:GetAttribute("BusinessId")
	local def = if typeof(id) == "string" then BusinessConfig.Get(id) else nil
	if def == nil then
		return
	end
	local zero = Vector3.zero
	lines[inst] = {
		model = inst,
		def = def,
		look = BusinessConfig.Crates[def.Product],
		level = 0,
		active = false,
		crates = {},
		startAt = {},
		nextAt = 0,
		popMark = 0,
		rot = CFrame.identity,
		p0 = zero,
		p1 = zero,
		along = zero,
		drop = zero,
		travel = 1,
		every = 2,
	}
end

local function untrack(inst: Instance)
	local l = lines[inst :: any]
	if l then
		releaseAll(l)
		lines[inst :: any] = nil
	end
end

-- 4 Hz: ownership, level, parts, distance -> active / idle, pool size, belt geometry
local function scan()
	local f = folder
	if f and f.Parent == nil then
		forgetPool()
	end
	local at = characterPos()
	local count = 0
	for m, l in pairs(lines) do
		if m.Parent == nil then
			untrack(m)
			continue
		end
		local want = false
		local look = l.look
		if at ~= nil and look ~= nil and isMine(m) then
			l.level = levelOf(m)
			if l.level >= 1 then
				local belt = m:FindFirstChild("Kit_Belt")
				local bin = m:FindFirstChild("Kit_Bin")
				if belt and bin and belt:IsA("BasePart") and bin:IsA("BasePart") and (belt.Position - at).Magnitude <= V.ActiveRadius then
					want = true
					measure(l, belt, bin, look)
				end
			end
		end
		if want then
			fit(l)
			if not l.active then
				l.nextAt = clock -- first crate on the next step
			end
			l.active = #l.crates > 0
		elseif l.active or #l.crates > 0 then
			releaseAll(l)
		end
		if l.active then
			count += 1
		end
	end
	activeCount = count
end

-- <= 20 Hz: advance every live crate along its belt, then a short drop into the bin; one BulkMoveTo for all
local function step(now: number)
	local n = 0
	if activeCount > 0 then
		for _, l in pairs(lines) do
			if l.active then
				local crates, startAt = l.crates, l.startAt
				if now >= l.nextAt then
					-- start the next crate as soon as one is free (if none is, try again next step)
					for i = 1, #crates do
						if startAt[i] < 0 then
							startAt[i] = now
							crates[i].Transparency = 0
							l.nextAt = now + l.every
							break
						end
					end
				end
				for i = 1, #crates do
					local s = startAt[i]
					if s >= 0 then
						local t = (now - s) / l.travel
						local pos: Vector3
						if t <= 1 then
							pos = l.p0 + l.along * t
						elseif t <= 1 + DROP_FRAC then
							pos = l.p1 + l.drop * ((t - 1) / DROP_FRAC)
						else
							startAt[i] = -1
							crates[i].Transparency = 1
							pos = l.p0 -- parked hidden at the belt start
						end
						n += 1
						movedParts[n] = crates[i]
						movedCFrames[n] = l.rot + pos
					end
				end
			end
		end
	end
	-- trim the stale tail without allocating (BulkMoveTo reads the whole arrays)
	for i = #movedParts, n + 1, -1 do
		movedParts[i] = nil
		movedCFrames[i] = nil
	end
	if n > 0 then
		Workspace:BulkMoveTo(movedParts, movedCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function fadePop(p: Pop, f: number)
	local title = p.title
	if title then
		title.TextTransparency = f
		title.TextStrokeTransparency = f
	end
end

local function showPop(k: number, bin: BasePart, text: string)
	local p = pops[k]
	if p == nil or p.gui.Parent == nil then
		local opts: WorldLabel.Options = {
			Name = POP_NAME,
			Color = HudConfig.Colors.Positive,
			TextSize = V.PopTextPx,
			Studs = POP_STUDS,
			Offset = POP_OFFSET,
			Parent = crateFolder(), -- local folder: the pool survives the bin streaming out
			BaseLabel = true, -- F4: counted by the LabelGovernor
		}
		local gui = WorldLabel.Create(bin, text, opts)
		local title = gui:FindFirstChild("Title")
		p = { gui = gui, title = if title and title:IsA("TextLabel") then title else nil, startAt = -1 }
		pops[k] = p
	else
		p.gui.Adornee = bin
		WorldLabel.SetText(p.gui, text)
		p.gui.StudsOffsetWorldSpace = POP_OFFSET
	end
	local pop = p :: Pop
	fadePop(pop, 0)
	WorldLabel.SetShown(pop.gui, true) -- F4: through WorldLabel, so a governor hold is kept
	if pop.startAt < 0 then
		popsLive += 1
	end
	pop.startAt = clock
end

-- 10 Hz: float up, hold, fade, then hide (the gui is kept for the next tick)
local function animatePops(now: number)
	if popsLive <= 0 then
		return
	end
	for _, p in ipairs(pops) do
		if p.startAt >= 0 then
			local k = (now - p.startAt) / POP_SECONDS
			if k >= 1 then
				p.startAt = -1
				popsLive -= 1
				WorldLabel.SetShown(p.gui, false)
			else
				p.gui.StudsOffsetWorldSpace = POP_OFFSET + Vector3.new(0, POP_RISE * k, 0)
				fadePop(p, if k <= POP_HOLD then 0 else (k - POP_HOLD) / (1 - POP_HOLD))
			end
		end
	end
end

-- WE_PassiveTick changed: "+$N" over the nearest owned lines (level 1+, bin within PopRadius of the character)
local function popTick()
	local at = characterPos()
	if at == nil then
		return
	end
	local mult = tonumber(player:GetAttribute("WE_IncomeMult"))
	if mult == nil or mult ~= mult or mult == math.huge then
		mult = 1
	end
	if (mult :: number) <= 0 then
		return -- nothing reaches the ATM: never show a gain
	end
	popSerial += 1
	local shown = 0 -- pool slots stay dense (animatePops walks them with ipairs)
	for _ = 1, V.MaxPopsPerTick do
		local best: Line? = nil
		local bestBin: BasePart? = nil
		local bestD, bestLv = V.PopRadius, 0
		for m, l in pairs(lines) do
			if l.popMark ~= popSerial and m.Parent ~= nil and isMine(m) then
				local lv = levelOf(m)
				local bin = if lv >= 1 then m:FindFirstChild("Kit_Bin") else nil
				if bin and bin:IsA("BasePart") then
					local d = (bin.Position - at).Magnitude
					if d <= bestD then
						best, bestBin, bestD, bestLv = l, bin, d, lv
					end
				end
			end
		end
		if best == nil or bestBin == nil then
			break
		end
		best.popMark = popSerial
		if TycoonMath.LevelIncomePerTick(best.def.Id, bestLv) > 0 then
			shown += 1
			showPop(shown, bestBin, TycoonMath.PopText(best.def.Id, bestLv, mult))
		end
	end
end

function BusinessVisuals.Init()
	if started or not BusinessConfig.Enabled then
		return
	end
	started = true
	maxCrates = cratesPerLine()
	pcall(function()
		local ugs = UserSettings():GetService("UserGameSettings") :: any
		ugs:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
			maxCrates = cratesPerLine() -- applied by the next scan (surplus crates go back to the pool)
		end)
	end)
	for _, m in ipairs(CollectionService:GetTagged(BusinessConfig.Tag)) do
		track(m)
	end
	CollectionService:GetInstanceAddedSignal(BusinessConfig.Tag):Connect(function(m: Instance)
		task.defer(track, m)
	end)
	CollectionService:GetInstanceRemovedSignal(BusinessConfig.Tag):Connect(untrack)
	player:GetAttributeChangedSignal("WE_PassiveTick"):Connect(popTick)

	local scanAcc, stepAcc, popAcc = SCAN_EVERY, 0, 0 -- scan on the first beat
	RunService.Heartbeat:Connect(function(dt: number)
		clock += dt
		scanAcc += dt
		stepAcc += dt
		popAcc += dt
		if scanAcc >= SCAN_EVERY then
			scanAcc = 0
			scan()
		end
		if stepAcc >= STEP_EVERY then
			stepAcc = 0 -- reset, never catch up: a hitch can not burst above UpdateHz
			step(clock)
		end
		if popAcc >= POP_EVERY then
			popAcc = 0
			animatePops(clock)
		end
	end)
end

return BusinessVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="220">
            <Properties>
              <string name="Name">CameraFx</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CameraFx (W2 CC-3, contracts §5.2): the ONE owner of combat camera offsets. Numbers: HudConfig.CombatCamera,
	HudConfig.AimHelp. Libraries: Shared/Vendor/Spring (recoil, MIT) and Shared/Vendor/Shake (blast / hit shake, MIT).

	API
	  Init()                               idempotent
	  SetCombatMode(drawn, inputClass)     drawn = weapon out, alive, allowed to shoot from here (CombatController)
	  SetWeapon(weaponId?)                 the drawn weapon (range for the aim help)
	  Kick(weaponId)                       recoil: a Spring impulse from WeaponConfig.Recoil (touch x RecoilScaleTouch)
	  Blast(center, radius)                explosion shake, scaled by distance, within radius x Shake.MaxRadiusMult
	  HitTaken(damage)                     a small trauma pulse (Shake.HitAmplitude)
	  AimCFrame() -> CFrame                the camera CFrame WITHOUT the view-only shake (CombatController's aimRay)

	RENDER STEPS (bound only while needed; nothing runs while holstered and calm)
	  WE_CamFx_Undo  RenderPriority.Camera - 1   removes last frame's shake before the Roblox camera reads the CFrame
	  WE_CamFx_Aim   RenderPriority.Camera + 1   shoulder upkeep, aim help (friction + tracking), recoil spring delta.
	                                             Recoil / aim help ROTATE the real camera: the Roblox camera reads its
	                                             look vector back next frame, so recoil is real aim recoil that
	                                             recovers by itself (the spring returns to 0).
	  WE_CamFx_Shake RenderPriority.Last         view-only shake (never drifts the camera or the aim)

	SHOULDER (P1-3): while drawn, alive, on foot and CombatCamera.Shoulder[inputClass] (Touch only by default):
	Humanoid.CameraOffset = ShoulderOffset, AutoRotate = false, the root yaw follows the camera yaw (written only
	when it moves > 1°). All of it reverts on holster, seat, death or respawn.

	AIM HELP (touch / gamepad while drawn; never a snap): with AimTargets.Best() in the cone, the camera keeps only
	FrictionKeep of the player's own frame-to-frame turn and follows at most Tracking x the target's angular motion.

	REDUCED MOTION: GuiService.ReducedMotionEnabled (CombatCamera.RespectReducedMotion) turns off the shake and the
	recoil kick. Per frame: no Instance, table or closure is created (value types only).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- ships with the place (Rojo); bounded wait anyway
local HudConfig = require(Shared.Configs.HudConfig)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local Spring = require(Shared.Vendor.Spring)
local Shake = require(Shared.Vendor.Shake)
local AimTargets = require(script.Parent.AimTargets)

local CameraFx = {}

local CC = HudConfig.CombatCamera
local SHK = CC.Shake
local STEP_UNDO = "WE_CamFx_Undo"
local STEP_AIM = "WE_CamFx_Aim"
local STEP_SHAKE = "WE_CamFx_Shake"
local YAW_EPS = math.rad(1) -- root yaw writes only when the camera yaw moved more than this
local MAX_TRACK_STEP = math.rad(4) -- one frame of tracking never turns the camera more than this
local MAX_PITCH = math.rad(80)
local SHAKE_POS = 1 -- studs per unit of Shake output
local SHAKE_ROT = Vector3.new(math.rad(8), math.rad(8), math.rad(4)) -- radians per unit of Shake output
local RECOIL_SETTLE = 0.01 -- degrees: the spring counts as settled below this

local player = Players.LocalPlayer

local initialized = false
local combatOn = false
local inputClass = "KeyboardAndMouse"
local weaponRange = 0

local function priority(name: string, delta: number): number
	local ok, v = pcall(function(): number
		return ((Enum.RenderPriority :: any)[name] :: EnumItem).Value
	end)
	if ok and type(v) == "number" then
		return v + delta
	end
	return (if name == "Camera" then 200 elseif name == "Last" then 2000 else 100) + delta
end

local PRIO_UNDO = priority("Camera", -1)
local PRIO_AIM = priority("Camera", 1)
local PRIO_SHAKE = priority("Last", 0)

-- shoulder
local shoulderHum: Humanoid? = nil
local shoulderSavedAutoRotate = true
local lastRootYaw: number? = nil

-- aim step
local aimBound = false
local lastYaw = 0
local lastPitch = 0
local lastValid = false
local trackModel: Model? = nil
local trackYaw = 0
local trackPitch = 0

-- recoil
type RecoilSpring = { Current: Vector3, Target: Vector3, Velocity: Vector3, SmoothTime: number, MaxSpeed: number }
local recoil: any = Spring.new(Vector3.zero, 0.16)
local springOk: boolean? = nil -- TweenService:SmoothDamp available (tested once)
local recoilApplied = Vector3.zero -- degrees (pitch, yaw) already applied to the camera
local recoilLive = false

-- shake
local shake = Shake.new()
shake.FadeInTime = 0
shake.SustainTime = 0.08
shake.FadeOutTime = 0.5
shake.Frequency = 0.08
shake.PositionInfluence = Vector3.one * SHAKE_POS
shake.RotationInfluence = SHAKE_ROT
local shakeBound = false
local shakeActive = false
local shakeApplied = false
local preShakeCF = CFrame.identity
local shakeAmp = 0

-- stats (tests)
local stats = { AimSteps = 0, ShakeSteps = 0, UndoSteps = 0, Kicks = 0, Blasts = 0, RootWrites = 0 }

---------------------------------------------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------------------------------------------

local function readReducedMotion(): any
	return (GuiService :: any).ReducedMotionEnabled
end

local function reducedMotion(): boolean
	if CC.RespectReducedMotion == false then
		return false
	end
	local ok, v = pcall(readReducedMotion)
	return ok and v == true
end

local function localHumanoid(): Humanoid?
	local ch = player.Character
	if not ch then
		return nil
	end
	return ch:FindFirstChildOfClass("Humanoid")
end

local function yawPitchOf(look: Vector3): (number, number)
	local y = math.clamp(look.Y, -1, 1)
	return math.atan2(-look.X, -look.Z), math.asin(y)
end

local function lookOf(yaw: number, pitch: number): Vector3
	local cp = math.cos(pitch)
	return Vector3.new(-math.sin(yaw) * cp, math.sin(pitch), -math.cos(yaw) * cp)
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

-- TweenService:SmoothDamp is fairly new: test it once, else a hand-rolled critically damped spring (same maths)
local function probeSpring()
	local probe: any = Spring.new(Vector3.zero, 0.1)
	probe:Update(1 / 60)
	assert(typeof(probe.Current) == "Vector3")
end

local function springUpdate(dt: number): Vector3
	if springOk == nil then
		springOk = pcall(probeSpring) -- once per session
	end
	local s = recoil :: RecoilSpring
	if springOk then
		local ok = pcall(recoil.Update, recoil, dt)
		if ok and typeof(s.Current) == "Vector3" then
			return s.Current
		end
		springOk = false
	end
	-- fallback: x'' = -w^2 x - 2 w x' (critically damped, w = 2 / SmoothTime), semi-implicit Euler
	local w = 2 / math.max(0.02, s.SmoothTime)
	local x, v = s.Current - s.Target, s.Velocity
	local steps = math.clamp(math.ceil(dt / (1 / 120)), 1, 8)
	local h = dt / steps
	for _ = 1, steps do
		v += (-(w * w) * x - 2 * w * v) * h
		x += v * h
	end
	s.Current = s.Target + x
	s.Velocity = v
	return s.Current
end

---------------------------------------------------------------------------------------------------------------
-- shoulder camera (P1-3)
---------------------------------------------------------------------------------------------------------------

local function shoulderWanted(hum: Humanoid?): boolean
	if not combatOn or (CC.Shoulder :: any)[inputClass] ~= true then
		return false
	end
	return hum ~= nil and hum.Parent ~= nil and hum.Health > 0 and hum.SeatPart == nil
end

local function releaseShoulder()
	local h = shoulderHum
	shoulderHum = nil
	lastRootYaw = nil
	if h then
		pcall(function()
			h.CameraOffset = Vector3.zero
			h.AutoRotate = shoulderSavedAutoRotate
		end)
	end
end

local function syncShoulder(): Humanoid?
	local hum = localHumanoid()
	if shoulderWanted(hum) then
		local h = hum :: Humanoid
		if shoulderHum ~= h then
			releaseShoulder()
			shoulderHum = h
			shoulderSavedAutoRotate = true -- AutoRotate is always restored to the Roblox default
			h.CameraOffset = CC.ShoulderOffset
			h.AutoRotate = not (CC.FaceCameraYaw == true)
		end
		return h
	end
	if shoulderHum then
		releaseShoulder()
	end
	return nil
end

local function faceCameraYaw(hum: Humanoid, yaw: number)
	if CC.FaceCameraYaw ~= true then
		return
	end
	local ch = hum.Parent
	local root = if ch then ch:FindFirstChild("HumanoidRootPart") else nil
	if not (root and root:IsA("BasePart")) then
		return
	end
	local last = lastRootYaw
	if last == nil then
		local rl = root.CFrame.LookVector
		last = math.atan2(-rl.X, -rl.Z)
	end
	if math.abs(wrapAngle(yaw - (last :: number))) <= YAW_EPS then
		return
	end
	lastRootYaw = yaw
	root.CFrame = CFrame.Angles(0, yaw, 0) + root.Position
	stats.RootWrites += 1
end

---------------------------------------------------------------------------------------------------------------
-- WE_CamFx_Aim (Camera + 1): shoulder, aim help, recoil
---------------------------------------------------------------------------------------------------------------

local syncBindings: () -> ()

local function aimStep(dt: number)
	stats.AimSteps += 1
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local hum = syncShoulder()
	local cf = cam.CFrame
	local pos = cf.Position
	local yaw, pitch = yawPitchOf(cf.LookVector)
	local changed = false

	-- aim help: friction on the player's own turn, partial tracking of the target's motion
	if combatOn then
		local keep, tracking = AimTargets.HelpLevelFor(inputClass)
		if keep < 1 or tracking > 0 then
			local target, part = AimTargets.Best(cf, weaponRange)
			if target and part then
				if lastValid and keep < 1 then
					local dy = wrapAngle(yaw - lastYaw)
					local dp = pitch - lastPitch
					if math.abs(dy) > 1e-6 or math.abs(dp) > 1e-6 then
						yaw = lastYaw + dy * keep
						pitch = lastPitch + dp * keep
						changed = true
					end
				end
				local ty, tp = yawPitchOf((part.Position - pos).Unit)
				if trackModel == target and tracking > 0 then
					local sy = math.clamp(wrapAngle(ty - trackYaw) * tracking, -MAX_TRACK_STEP, MAX_TRACK_STEP)
					local sp = math.clamp((tp - trackPitch) * tracking, -MAX_TRACK_STEP, MAX_TRACK_STEP)
					if math.abs(sy) > 1e-6 or math.abs(sp) > 1e-6 then
						yaw += sy
						pitch += sp
						changed = true
					end
				end
				trackModel, trackYaw, trackPitch = target, ty, tp
			else
				trackModel = nil
			end
		else
			trackModel = nil
		end
	end

	-- recoil: the spring's frame-to-frame delta turns the real camera (it recovers as the spring returns to 0)
	if recoilLive then
		local v = springUpdate(dt)
		local dP, dY = v.X - recoilApplied.X, v.Y - recoilApplied.Y
		recoilApplied = v
		if math.abs(dP) > 1e-5 or math.abs(dY) > 1e-5 then
			pitch += math.rad(dP)
			yaw += math.rad(dY)
			changed = true
		end
		local s = recoil :: RecoilSpring
		if v.Magnitude < RECOIL_SETTLE and s.Velocity.Magnitude < RECOIL_SETTLE then
			recoilLive = false
			recoilApplied = Vector3.zero
			s.Current = Vector3.zero
			s.Velocity = Vector3.zero
		end
	end

	if changed then
		pitch = math.clamp(pitch, -MAX_PITCH, MAX_PITCH)
		cam.CFrame = CFrame.lookAt(pos, pos + lookOf(yaw, pitch))
	end
	lastYaw, lastPitch, lastValid = yaw, pitch, true
	if hum then
		faceCameraYaw(hum, yaw)
	end
	if not recoilLive and (not combatOn or shoulderHum == nil) then
		syncBindings() -- recoil settled / holstered: unbind unless the aim help or the shoulder still needs the step
	end
end

---------------------------------------------------------------------------------------------------------------
-- WE_CamFx_Shake (Last) / WE_CamFx_Undo (Camera - 1): view-only shake
---------------------------------------------------------------------------------------------------------------

local function undoStep()
	stats.UndoSteps += 1
	if shakeApplied then
		shakeApplied = false
		local cam = Workspace.CurrentCamera
		if cam then
			cam.CFrame = preShakeCF
		end
	end
	if not shakeActive then
		syncBindings()
	end
end

local function shakeStep()
	stats.ShakeSteps += 1
	local cam = Workspace.CurrentCamera
	if not cam or not shakeActive then
		return
	end
	local p, r, done = shake:Update()
	if done then
		shakeActive = false
		shakeAmp = 0
		return
	end
	preShakeCF = cam.CFrame
	cam.CFrame = preShakeCF * CFrame.new(p) * CFrame.Angles(r.X, r.Y, r.Z)
	shakeApplied = true
end

syncBindings = function()
	-- the aim step runs only while something needs it: recoil in flight, the shoulder camera, or aim help
	-- (touch / gamepad while drawn). A drawn PC gun with no recoil runs nothing per frame.
	local keep, tracking = AimTargets.HelpLevelFor(inputClass)
	local wantAim = recoilLive or shoulderHum ~= nil or (combatOn and (keep < 1 or tracking > 0))
	if wantAim ~= aimBound then
		aimBound = wantAim
		if wantAim then
			lastValid = false
			trackModel = nil
			RunService:BindToRenderStep(STEP_AIM, PRIO_AIM, aimStep)
		else
			RunService:UnbindFromRenderStep(STEP_AIM)
			lastValid = false
			trackModel = nil
		end
	end
	local wantShake = shakeActive or shakeApplied
	if wantShake ~= shakeBound then
		shakeBound = wantShake
		if wantShake then
			RunService:BindToRenderStep(STEP_UNDO, PRIO_UNDO, undoStep)
			RunService:BindToRenderStep(STEP_SHAKE, PRIO_SHAKE, shakeStep)
		else
			RunService:UnbindFromRenderStep(STEP_UNDO)
			RunService:UnbindFromRenderStep(STEP_SHAKE)
		end
	end
end

local function startShake(amplitude: number, sustain: number, fadeOut: number)
	if amplitude <= 0.001 or reducedMotion() then
		return
	end
	if shakeActive and shakeAmp >= amplitude then
		return -- a stronger shake is already running
	end
	shakeAmp = amplitude
	shake.Amplitude = amplitude
	shake.SustainTime = sustain
	shake.FadeOutTime = fadeOut
	shake:Start()
	shakeActive = true
	syncBindings()
end

---------------------------------------------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------------------------------------------

function CameraFx.SetCombatMode(drawn: boolean, cls: string)
	local on = drawn == true
	if type(cls) == "string" and cls ~= "" then
		inputClass = cls
	end
	combatOn = on
	if on then
		syncShoulder() -- idempotent: applies / keeps / releases for the current humanoid and class
	else
		releaseShoulder()
		trackModel = nil
	end
	syncBindings()
end

function CameraFx.SetWeapon(weaponId: string?)
	local def = if weaponId then WeaponConfig.Weapons[weaponId] else nil
	weaponRange = if def then math.max(0, tonumber(def.Range) or 0) else 0
end

function CameraFx.Kick(weaponId: string)
	if reducedMotion() then
		return
	end
	local def = WeaponConfig.Weapons[weaponId]
	local rc = if def then def.Recoil else nil
	if not rc then
		return
	end
	local scale = if inputClass == "Touch" then tonumber(CC.RecoilScaleTouch) or 0.5 else 1
	local recover = math.max(1, tonumber(rc.Recover) or tonumber(CC.RecoilSpring.Speed) or 12)
	local smooth = 2 / recover -- SmoothDamp time; the peak comes at smooth / 2
	local s = recoil :: RecoilSpring
	s.SmoothTime = smooth
	-- a critically damped spring kicked with v0 peaks at v0 / (w e), w = 2 / smooth: v0 = peak x w x e
	local k = (2 / smooth) * math.exp(1)
	local side = (math.random() * 2 - 1) * (tonumber(rc.Side) or 0)
	s.Velocity += Vector3.new((tonumber(rc.Kick) or 0) * scale * k, side * scale * k, 0)
	recoilLive = true
	stats.Kicks += 1
	syncBindings()
end

function CameraFx.Blast(center: Vector3, radius: number)
	if typeof(center) ~= "Vector3" or type(radius) ~= "number" or radius <= 0 then
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local reach = radius * math.max(1, tonumber(SHK.MaxRadiusMult) or 3)
	local d = (cam.CFrame.Position - center).Magnitude
	if d >= reach then
		return
	end
	local base = if inputClass == "Touch" then SHK.BlastAmplitudeTouch else SHK.BlastAmplitude
	stats.Blasts += 1
	startShake(base * (1 - d / reach), 0.08, 0.5)
end

function CameraFx.HitTaken(damage: number)
	local amp = tonumber(SHK.HitAmplitude) or 0
	if inputClass == "Touch" then
		amp *= 0.5
	end
	local d = if type(damage) == "number" then damage else 0
	startShake(amp * math.clamp(d / 25, 0.5, 1.5), 0, 0.25)
end

function CameraFx.AimCFrame(): CFrame
	if shakeApplied then
		return preShakeCF
	end
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame else CFrame.identity
end

function CameraFx.Stats(): { [string]: any }
	return {
		AimSteps = stats.AimSteps,
		ShakeSteps = stats.ShakeSteps,
		UndoSteps = stats.UndoSteps,
		Kicks = stats.Kicks,
		Blasts = stats.Blasts,
		RootWrites = stats.RootWrites,
		AimBound = aimBound,
		ShakeBound = shakeBound,
		ShakeActive = shakeActive,
		RecoilLive = recoilLive,
		SpringLib = springOk == true, -- the vendored Spring (TweenService:SmoothDamp) drives the recoil
		Shoulder = shoulderHum ~= nil,
		CombatOn = combatOn,
		InputClass = inputClass,
	}
end

function CameraFx.Init()
	if initialized then
		return
	end
	initialized = true
	AimTargets.Init()
	AimTargets.SetViewSource(CameraFx.AimCFrame)
	player.CharacterAdded:Connect(function()
		-- respawn: the new humanoid starts with the Roblox defaults; forget the old one
		shoulderHum = nil
		lastRootYaw = nil
		lastValid = false
		trackModel = nil
		syncBindings()
	end)
end

return CameraFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="221">
            <Properties>
              <string name="Name">ClientSettings</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Local-only client preferences (music/SFX flags).
	Session-scoped (no DataStore). AudioController listens via OnChanged
	and mutes/restores volumes immediately. Economy stays server-authoritative.
]]

local ClientSettings = {}

local musicEnabled = true
local sfxEnabled = true

local listeners: { () -> () } = {}

local function notify()
	for _, cb in ipairs(listeners) do
		task.defer(cb)
	end
end

function ClientSettings.GetMusicEnabled(): boolean
	return musicEnabled
end

function ClientSettings.GetSfxEnabled(): boolean
	return sfxEnabled
end

function ClientSettings.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled == true
	notify()
end

function ClientSettings.SetSfxEnabled(enabled: boolean)
	sfxEnabled = enabled == true
	notify()
end

function ClientSettings.ToggleMusic(): boolean
	ClientSettings.SetMusicEnabled(not musicEnabled)
	return musicEnabled
end

function ClientSettings.ToggleSfx(): boolean
	ClientSettings.SetSfxEnabled(not sfxEnabled)
	return sfxEnabled
end

function ClientSettings.OnChanged(cb: () -> ())
	table.insert(listeners, cb)
end

--[[ Call before playing music/SFX — returns false when muted. ]]
function ClientSettings.ShouldPlayMusic(): boolean
	return musicEnabled
end

function ClientSettings.ShouldPlaySfx(): boolean
	return sfxEnabled
end

return ClientSettings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="222">
            <Properties>
              <string name="Name">ConsoleWaypoint</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v71 console-only buying: Base panel GO -> a guide line and a small marker to that structure's console on YOUR plot.
	Never buys (buying happens at the console: BUY button in the action lane or the console prompt).

	Target: the real console part (Shared/Util/ConsoleLocator.Find(plotId, sid)). When the plot id is not known yet or
	the part is not on this client (StreamingEnabled streamed it out), the server-stamped player attribute
	WE_ConsolePos_<StructureId> (world Vector3 of YOUR console, set by UpgradePadService on plot ready) anchors a
	local invisible part until the real console is found.
	Cleared on arrival (ArriveRadius), timeout, another GO or Clear(); re-attached after respawn. Rebuild / retarget
	attempts are throttled to Waypoint.RetrySeconds; the distance label refreshes at Waypoint.RefreshHz (<= 10 Hz,
	CLAUDE.md UI refresh cap) and only rewrites its text when the whole-metre value changes. No WaitForChild; no
	remote calls.
	The marker is the one AlwaysOnTop objective marker (CLAUDE.md world labels): transient, only after GO, 14-20 px
	text (UITextSizeConstraint), sized to the structure name so long names never shrink below 14 px.
	v72 guide: ShowAtm(plotId?) draws the same line to the player's OWN ATM (the "Collect at your ATM" state of the BUY
	button and the guide chip). Target: the own WE_MoneyCollector part (PlotId = plotId) when it is on this client,
	else the server-stamped WE_AtmPos (streaming-safe; never another player's ATM). Same beam, marker, arrival, timeout
	and RefreshHz rules as a console line; the marker reads TycoonGuideConfig.Text.ChipGoCollect ("ATM").
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local ConsoleLocator = require(Shared.Util.ConsoleLocator)

local ConsoleWaypoint = {}

local player = Players.LocalPlayer
local W = ConsoleBuyConfig.Waypoint

local current: string? = nil -- structureId being guided to (ConsoleWaypoint.AtmKey while guiding to the ATM)
local currentPlot: number? = nil
local guidingAtm = false -- v72: ShowAtm (the target is the player's own ATM, not a console)
local startedAt = 0
local lastAttemptAt = -math.huge
local target: BasePart? = nil -- console part or local anchor
local anchor: BasePart? = nil -- client-only stand-in while the console is not on this client
local att0: Attachment? = nil
local att1: Attachment? = nil
local beam: Beam? = nil
local marker: BillboardGui? = nil
local distLabel: TextLabel? = nil
local stepConn: RBXScriptConnection? = nil
local stepAcc = 0
local shownMetres = -1

local function destroyVisuals()
	for _, inst in ipairs({ beam, marker, att0, att1, anchor } :: { Instance? }) do
		if inst then
			inst:Destroy()
		end
	end
	beam, marker, att0, att1, anchor, distLabel, target = nil, nil, nil, nil, nil, nil, nil
end

function ConsoleWaypoint.Clear()
	destroyVisuals()
	if stepConn then
		stepConn:Disconnect()
		stepConn = nil
	end
	current, currentPlot = nil, nil
	guidingAtm = false
end

-- ConsoleWaypoint.Current() while ShowAtm is guiding (no structure id is ever "ATM")
ConsoleWaypoint.AtmKey = "ATM"

function ConsoleWaypoint.Current(): string?
	return current
end

local function rootPart(): BasePart?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

-- v72: the player's OWN ATM part (Money Collector tagged with PlotId == plotId) when it is on this client
local function ownAtm(plotId: number): BasePart?
	local hrp = rootPart()
	local best: BasePart? = nil
	local bestD = math.huge
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.MoneyCollector)) do
		if inst:IsA("BasePart") and tonumber(inst:GetAttribute("PlotId") :: any) == plotId and inst:IsDescendantOf(Workspace) then
			local d = if hrp then (inst.Position - hrp.Position).Magnitude else 0
			if best == nil or d < bestD then
				best, bestD = inst, d
			end
		end
	end
	return best
end

local function realConsole(structureId: string): BasePart?
	local plotId = currentPlot
	if plotId == nil then
		return nil
	end
	if guidingAtm then
		return ownAtm(plotId)
	end
	return ConsoleLocator.Find(plotId, structureId)
end

local function stampedPos(structureId: string): Vector3?
	local pos = player:GetAttribute(if guidingAtm then "WE_AtmPos" else "WE_ConsolePos_" .. structureId)
	return if typeof(pos) == "Vector3" then pos else nil
end

-- true when a target can be resolved (console part or stamped position), without building anything
local function resolvable(structureId: string): boolean
	return realConsole(structureId) ~= nil or stampedPos(structureId) ~= nil
end

local function build(structureId: string)
	lastAttemptAt = os.clock()
	local hrp = rootPart()
	if hrp == nil then
		return -- respawning: try again after RetrySeconds (no anchor churn while dead)
	end
	destroyVisuals()
	local t: BasePart? = realConsole(structureId)
	if t == nil then
		local pos = stampedPos(structureId)
		if pos == nil then
			return
		end
		local a = Instance.new("Part")
		a.Name = "WE_ConsoleWaypointAnchor"
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.CanTouch = false
		a.Transparency = 1
		a.Size = Vector3.new(1, 1, 1)
		a.CFrame = CFrame.new(pos)
		a.Parent = Workspace.CurrentCamera or Workspace
		anchor = a
		t = a
	end
	local tp = t :: BasePart
	target = tp
	local top = (if anchor then 1.7 else tp.Size.Y * 0.5) + W.MarkerLift
	local a1 = Instance.new("Attachment")
	a1.Name = "WE_WaypointAtt1"
	a1.Position = Vector3.new(0, top, 0)
	a1.Parent = tp
	att1 = a1
	local a0 = Instance.new("Attachment")
	a0.Name = "WE_WaypointAtt0"
	a0.Parent = hrp
	att0 = a0

	local b = Instance.new("Beam")
	b.Name = "WE_ConsoleBeam"
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.FaceCamera = true
	b.Width0 = W.BeamWidth0
	b.Width1 = W.BeamWidth1
	b.LightEmission = W.BeamLightEmission
	b.Color = ColorSequence.new(W.BeamColor)
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0.85) })
	b.Parent = hrp
	beam = b

	local def = BaseConfig.Structures[structureId]
	local title = string.upper(if guidingAtm then TycoonGuideConfig.Text.ChipGoCollect elseif def then def.DisplayName else structureId)
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_ConsoleWaypoint"
	bb.Adornee = tp
	-- real px (a BillboardGui has no UIScale): 12 px per character keeps "SPECIAL FORCES FACILITY" at >= 14 px text
	bb.Size = UDim2.fromOffset(math.clamp(#title * 12 + 16, W.MarkerMinWidth, W.MarkerMaxWidth), 36)
	bb.StudsOffsetWorldSpace = Vector3.new(0, top, 0)
	bb.AlwaysOnTop = true -- transient: only after the player tapped GO, gone on arrival / timeout (walk-ins hide it otherwise)
	bb.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0.55, 0)
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = W.BeamColor
	name.TextStrokeTransparency = 0.4
	name.Text = title
	name.Parent = bb
	local nameCap = Instance.new("UITextSizeConstraint")
	nameCap.MinTextSize = W.MarkerMinTextPx
	nameCap.MaxTextSize = W.MarkerMaxTextPx
	nameCap.Parent = name
	local dist = Instance.new("TextLabel")
	dist.BackgroundTransparency = 1
	dist.Position = UDim2.fromScale(0, 0.55)
	dist.Size = UDim2.new(1, 0, 0.45, 0)
	dist.Font = Enum.Font.GothamBold
	dist.TextScaled = true
	dist.TextColor3 = Color3.new(1, 1, 1)
	dist.TextStrokeTransparency = 0.4
	dist.Text = ""
	dist.Parent = bb
	local distCap = Instance.new("UITextSizeConstraint")
	distCap.MinTextSize = W.MarkerMinTextPx
	distCap.MaxTextSize = W.MarkerMaxTextPx
	distCap.Parent = dist
	distLabel = dist
	shownMetres = -1
	bb.Parent = tp
	marker = bb
end

local function step(dt: number)
	local sid = current
	if sid == nil then
		return
	end
	-- <= RefreshHz: the arrival check, the distance label and the retry timer need no per-frame work
	stepAcc += dt
	if stepAcc < 1 / W.RefreshHz then
		return
	end
	stepAcc = 0
	local now = os.clock()
	if now - startedAt > W.TimeoutSeconds then
		ConsoleWaypoint.Clear()
		return
	end
	local hrp = rootPart()
	local t = target
	local broken = t == nil or t.Parent == nil or hrp == nil or att0 == nil or (att0 :: Attachment).Parent ~= hrp
	-- rebuild after respawn / console rebuilt, or retarget from the stamped anchor to the real console once it
	-- streams in; throttled (a tag scan per attempt)
	if (broken or anchor ~= nil) and now - lastAttemptAt >= W.RetrySeconds then
		if broken or realConsole(sid) ~= nil then
			build(sid)
		else
			lastAttemptAt = now
		end
		return
	end
	if broken or hrp == nil or t == nil then
		return
	end
	local d = ((hrp :: BasePart).Position - (t :: BasePart).Position).Magnitude
	if d <= W.ArriveRadius then
		ConsoleWaypoint.Clear() -- the BUY button takes over at the console
		return
	end
	local metres = math.floor(d + 0.5)
	local dl = distLabel
	if dl and metres ~= shownMetres then
		shownMetres = metres
		dl.Text = string.format("%d m", metres)
	end
end

--[[ Guide the local player to structureId's console on their own plot (plotId: from BaseStateUpdate / PlayerState;
	nil falls back to the server-stamped position). Returns false when neither the console part nor a stamped position
	is known yet (the caller shows ConsoleBuyConfig.Text.NoConsole). ]]
function ConsoleWaypoint.Show(structureId: string, plotId: number?): boolean
	pcall(function() local req: any = require; req(script.Parent.ObjectiveMarker).Clear() end) -- W3s2 Phase B: the latest GO wins (one guide line)
	ConsoleWaypoint.Clear()
	current, currentPlot, startedAt = structureId, plotId, os.clock()
	if not resolvable(structureId) then
		ConsoleWaypoint.Clear()
		return false
	end
	build(structureId) -- no-op while respawning; step() retries
	stepAcc = math.huge -- first step runs at once (distance label)
	stepConn = RunService.Heartbeat:Connect(step)
	return true
end

--[[ v72 guide: the same line to the local player's OWN ATM ("Collect $N at your ATM"). plotId: the player's plot
	(nil: only the server-stamped WE_AtmPos is used). false when neither the ATM part nor WE_AtmPos is known. ]]
function ConsoleWaypoint.ShowAtm(plotId: number?): boolean
	pcall(function() local req: any = require; req(script.Parent.ObjectiveMarker).Clear() end) -- W3s2 Phase B: the latest GO wins (one guide line)
	ConsoleWaypoint.Clear()
	guidingAtm = true
	local key = ConsoleWaypoint.AtmKey
	current, currentPlot, startedAt = key, plotId, os.clock()
	if not resolvable(key) then
		ConsoleWaypoint.Clear()
		return false
	end
	build(key)
	stepAcc = math.huge
	stepConn = RunService.Heartbeat:Connect(step)
	return true
end

return ConsoleWaypoint
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="223">
            <Properties>
              <string name="Name">HudIcons</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HudIcons — v70 HUD icons built ONLY from Frames + UICorner + Rotation (no emoji, no uploaded images).

	Every part is placed in Scale units of the icon box, so an icon draws at any size and follows the gui's
	UIScale. Frame.Rotation turns about the centre, so every part is centred (AnchorPoint 0.5,0.5) and bars that
	pivot about an end have their centres pre-computed.

	  local icon = HudIcons.Make("Cart", parent, { Size = UDim2.fromOffset(38, 38), Color = accent, Fill = tileFill })
	  HudIcons.SetColor(icon, newInk, newFill?)      -- recolour (e.g. locked / pressed states)
	  HudIcons.SetRotation(compassArrow, bearingDeg)  -- "Arrow" only: turns the inner "Rot" group

	Colours: Color = the icon ink (default white). Fill = the colour of what the icon sits on: holes and gap
	masks (gear hole, ring centres, clipboard rows, cart slots) are painted with it (default HudConfig PillBg).
	"Cash" has its own fixed greens and a 42:32 box (HudConfig.CashPill.IconSize).

	Kinds: Cart Cycle Helmet Car Clipboard Gear Cash Shield Crosshair Arrow Plus Up Down Close Chevron Dot Flag
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)

local HudIcons = {}

export type IconOpts = {
	Size: UDim2?, -- default UDim2.fromOffset(24, 24) (v units under a HUD UIScale)
	Position: UDim2?,
	AnchorPoint: Vector2?,
	ZIndex: number?, -- base ZIndex; parts stack above it in draw order
	LayoutOrder: number?,
	Name: string?,
	Color: Color3?, -- ink
	Fill: Color3?, -- background the icon sits on
	Rotation: number?, -- "Arrow": bearing in degrees, clockwise (same as SetRotation)
	Transparency: number?, -- ink/fill transparency (0 = solid)
}

-- role: "Ink" (Color), "Fill" (Fill), or a fixed Color3
type Part = {
	x: number, -- centre, fraction of the box
	y: number,
	w: number,
	h: number,
	role: string?,
	color: Color3?,
	r: number?, -- UICorner scale (0.5 = round); nil = square
	rot: number?,
	clip: { x: number, y: number, w: number, h: number }?, -- draw inside an axis-aligned clip frame (box coords)
}

local INK_DEFAULT = Color3.fromRGB(255, 255, 255)
local FILL_DEFAULT: Color3 = HudConfig.Colors.PillBg

-- top-left box (x, y, w, h) → centred part
local function box(x: number, y: number, w: number, h: number, role: string?, r: number?, rot: number?): Part
	return { x = x + w / 2, y = y + h / 2, w = w, h = h, role = role or "Ink", r = r, rot = rot }
end
local function fixed(x: number, y: number, w: number, h: number, color: Color3, r: number?): Part
	return { x = x + w / 2, y = y + h / 2, w = w, h = h, role = "Fixed", color = color, r = r }
end
-- a bar of length len and thickness t whose END sits at (ex, ey), pointing away from it at rot degrees
-- (rot 0 = straight down from the end point; positive = clockwise, like Frame.Rotation)
local function barFrom(ex: number, ey: number, t: number, len: number, rot: number, role: string?): Part
	local a = math.rad(rot)
	return {
		x = ex - math.sin(a) * len / 2,
		y = ey + math.cos(a) * len / 2,
		w = t,
		h = len,
		role = role or "Ink",
		r = 0.5,
		rot = rot,
	}
end

local SHAPES: { [string]: { Part } } = {}

SHAPES.Cart = {
	box(0.03, 0.17, 0.24, 0.08, "Ink", 0.5, 18), -- handle
	box(0.24, 0.3, 0.64, 0.38, "Ink", 0.26), -- basket (rounded bottom)
	box(0.24, 0.3, 0.64, 0.19, "Ink"), -- squares the basket's top corners
	box(0.2, 0.28, 0.72, 0.08, "Ink", 0.5), -- rim
	box(0.34, 0.39, 0.07, 0.2, "Fill", 0.43),
	box(0.51, 0.39, 0.07, 0.2, "Fill", 0.43),
	box(0.68, 0.39, 0.07, 0.2, "Fill", 0.43),
	box(0.3, 0.72, 0.16, 0.16, "Ink", 0.5), -- wheels
	box(0.66, 0.72, 0.16, 0.16, "Ink", 0.5),
}

SHAPES.Cycle = {
	box(0.1, 0.1, 0.8, 0.8, "Ink", 0.5), -- ring
	box(0.23, 0.23, 0.54, 0.54, "Fill", 0.5), -- ring hole
	box(0.62, 0.02, 0.3, 0.24, "Fill", nil, 30), -- gap top-right
	box(0.08, 0.74, 0.3, 0.24, "Fill", nil, 30), -- gap bottom-left
	-- arrowheads: half of a 45° diamond, clipped (a right-angled wedge)
	{ x = 0, y = 0.5, w = 0.2121, h = 0.2121, role = "Ink", rot = 45, clip = { x = 0.52, y = 0.04, w = 0.15, h = 0.3 } },
	{ x = 1, y = 0.5, w = 0.2121, h = 0.2121, role = "Ink", rot = 45, clip = { x = 0.33, y = 0.66, w = 0.15, h = 0.3 } },
}

SHAPES.Helmet = {
	box(0.14, 0.18, 0.72, 0.52, "Ink", 0.5), -- dome
	box(0.14, 0.44, 0.72, 0.26, "Ink"), -- squares the dome's lower corners
	box(0.05, 0.64, 0.9, 0.12, "Ink", 0.5), -- brim
	box(0.14, 0.52, 0.72, 0.07, "Fill"), -- band
	box(0.43, 0.28, 0.14, 0.14, "Fill", 0.5), -- badge
}

SHAPES.Car = {
	box(0.26, 0.24, 0.48, 0.26, "Ink", 0.46), -- cabin
	box(0.26, 0.37, 0.48, 0.13, "Ink"),
	box(0.33, 0.3, 0.34, 0.14, "Fill", 0.29), -- window
	box(0.06, 0.46, 0.88, 0.26, "Ink", 0.35), -- body
	box(0.17, 0.6, 0.22, 0.22, "Ink", 0.5), -- wheel rims
	box(0.61, 0.6, 0.22, 0.22, "Ink", 0.5),
	fixed(0.22, 0.65, 0.12, 0.12, Color3.fromRGB(21, 24, 27), 0.5), -- tyres
	fixed(0.66, 0.65, 0.12, 0.12, Color3.fromRGB(21, 24, 27), 0.5),
}

SHAPES.Clipboard = {
	box(0.18, 0.12, 0.64, 0.82, "Ink", 0.125), -- board
	box(0.34, 0.05, 0.32, 0.15, "Ink", 0.33), -- clip
	box(0.38, 0.09, 0.24, 0.07, "Fill", 0.5),
	box(0.27, 0.36, 0.11, 0.11, "Fill", 0.18), -- rows
	box(0.43, 0.385, 0.3, 0.06, "Fill", 0.5),
	box(0.27, 0.53, 0.11, 0.11, "Fill", 0.18),
	box(0.43, 0.555, 0.3, 0.06, "Fill", 0.5),
	box(0.27, 0.7, 0.11, 0.11, "Fill", 0.18),
	box(0.43, 0.725, 0.3, 0.06, "Fill", 0.5),
}

SHAPES.Gear = {
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 0), -- 8 teeth = 4 bars
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 45),
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 90),
	box(0.4, 0.04, 0.2, 0.92, "Ink", 0.2, 135),
	box(0.16, 0.16, 0.68, 0.68, "Ink", 0.5), -- disc
	box(0.35, 0.35, 0.3, 0.3, "Fill", 0.5), -- hole
}

do -- Cash: 3 stacked bills in a 42:32 box (converted from the mock's 42x42 box shifted up 5)
	local edge = Color3.fromRGB(11, 61, 22)
	local cols = { Color3.fromRGB(28, 140, 52), Color3.fromRGB(44, 176, 70), Color3.fromRGB(74, 214, 96) }
	local ys = { 0.5, 0.303, 0.106 }
	local h = 0.4725
	local bw = 0.03 -- border, fraction of the box width
	local parts: { Part } = {}
	for i = 1, 3 do
		local x = 0.02 + (i - 1) * 0.04
		table.insert(parts, fixed(x, ys[i], 0.9, h, edge, 0.17))
		table.insert(parts, fixed(x + bw, ys[i] + bw * 42 / 32, 0.9 - 2 * bw, h - 2 * bw * 42 / 32, cols[i], 0.15))
	end
	table.insert(parts, fixed(0.4, 0.225, 0.22, 0.236, Color3.fromRGB(29, 107, 48), 0.5)) -- coin on the top bill
	SHAPES.Cash = parts
end

SHAPES.Shield = {
	box(0.2, 0.08, 0.6, 0.46, "Ink", 0.22), -- top (rounded)
	box(0.2, 0.3, 0.6, 0.24, "Ink"), -- squares the lower corners
	box(0.29, 0.31, 0.42, 0.42, "Ink", nil, 45), -- point
}

SHAPES.Crosshair = {
	box(0.2, 0.2, 0.6, 0.6, "Ink", 0.5), -- ring
	box(0.28, 0.28, 0.44, 0.44, "Fill", 0.5),
	box(0.46, 0.04, 0.08, 0.26, "Ink"), -- ticks
	box(0.46, 0.7, 0.08, 0.26, "Ink"),
	box(0.04, 0.46, 0.26, 0.08, "Ink"),
	box(0.7, 0.46, 0.26, 0.08, "Ink"),
	box(0.44, 0.44, 0.12, 0.12, "Ink", 0.5), -- dot
}

-- compass arrow (points UP at rotation 0): stem + chevron whose bars pivot about the tip
SHAPES.Arrow = {
	box(0.5 - 0.065, 0.16, 0.13, 0.66, "Ink", 0.46),
	barFrom(0.5, 0.16, 0.13, 0.4, 38),
	barFrom(0.5, 0.16, 0.13, 0.4, -38),
}

SHAPES.Plus = {
	box(0.2, 0.42, 0.6, 0.16, "Ink", 0.31),
	box(0.42, 0.2, 0.16, 0.6, "Ink", 0.31),
}

-- solid-looking chevrons (FredokaOne has no ▲▼ glyphs — risk #5)
SHAPES.Up = { barFrom(0.5, 0.28, 0.17, 0.5, 45), barFrom(0.5, 0.28, 0.17, 0.5, -45) }
SHAPES.Down = { barFrom(0.5, 0.72, 0.17, 0.5, 135), barFrom(0.5, 0.72, 0.17, 0.5, -135) }
SHAPES.Chevron = { barFrom(0.68, 0.5, 0.16, 0.5, 45 + 90), barFrom(0.68, 0.5, 0.16, 0.5, 45) } -- ▸
SHAPES.Close = { -- ✕
	{ x = 0.5, y = 0.5, w = 0.16, h = 0.84, role = "Ink", r = 0.5, rot = 45 },
	{ x = 0.5, y = 0.5, w = 0.16, h = 0.84, role = "Ink", r = 0.5, rot = -45 },
}
SHAPES.Dot = { box(0.2, 0.2, 0.6, 0.6, "Ink", 0.5) }
-- F3 Empire Tax chip: a plain pennant on a pole (2 Frames). Generic on purpose: never a country's flag (CLAUDE.md).
SHAPES.Flag = {
	box(0.2, 0.08, 0.1, 0.84, "Ink", 0.5), -- pole
	box(0.3, 0.12, 0.52, 0.38, "Ink", 0.12), -- cloth
}

local KINDS: { string } = {}
for k in pairs(SHAPES) do
	table.insert(KINDS, k)
end
table.sort(KINDS)
HudIcons.Kinds = KINDS

function HudIcons.Has(kind: string): boolean
	return SHAPES[kind] ~= nil
end

local function colorFor(p: Part, ink: Color3, fill: Color3): Color3
	if p.role == "Fill" then
		return fill
	elseif p.role == "Fixed" and p.color then
		return p.color
	end
	return ink
end

local function corner(parent: Instance, r: number?)
	if r and r > 0 then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(math.min(r, 0.5), 0)
		c.Parent = parent
	end
end

--[[ Build an icon. parent may be nil (parent it yourself). Unknown kinds draw a Dot and warn once. ]]
local warnedKinds: { [string]: boolean } = {}
function HudIcons.Make(kind: string, parent: Instance?, opts: IconOpts?): Frame
	local o: IconOpts = opts or {}
	local shape = SHAPES[kind]
	if not shape then
		if not warnedKinds[kind] then
			warnedKinds[kind] = true
			warn("[HudIcons] unknown icon kind:", kind)
		end
		shape = SHAPES.Dot
	end
	local ink = o.Color or INK_DEFAULT
	local fill = o.Fill or FILL_DEFAULT
	local alpha = o.Transparency or 0
	local base = o.ZIndex or 1

	local root = Instance.new("Frame")
	root.Name = o.Name or ("Icon" .. kind)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = o.Size or UDim2.fromOffset(24, 24)
	root.Position = o.Position or UDim2.fromScale(0, 0)
	root.AnchorPoint = o.AnchorPoint or Vector2.zero
	root.ZIndex = base
	root.LayoutOrder = o.LayoutOrder or 0
	root.Active = false
	root:SetAttribute("HudIcon", kind)

	-- "Arrow" draws into an inner full-size group so SetRotation turns the whole glyph
	local host: Frame = root
	if kind == "Arrow" then
		local rot = Instance.new("Frame")
		rot.Name = "Rot"
		rot.BackgroundTransparency = 1
		rot.BorderSizePixel = 0
		rot.AnchorPoint = Vector2.new(0.5, 0.5)
		rot.Position = UDim2.fromScale(0.5, 0.5)
		rot.Size = UDim2.fromScale(1, 1)
		rot.Rotation = o.Rotation or 0
		rot.ZIndex = base
		rot.Active = false
		rot.Parent = root
		host = rot
	end

	for i, p in ipairs(shape) do
		local f = Instance.new("Frame")
		f.Name = "P" .. i
		f.BorderSizePixel = 0
		f.BackgroundColor3 = colorFor(p, ink, fill)
		f.BackgroundTransparency = alpha
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Rotation = p.rot or 0
		f.ZIndex = base + i
		f.Active = false
		f:SetAttribute("Role", p.role or "Ink")
		corner(f, p.r)
		local clip = p.clip
		if clip then
			-- an axis-aligned clipping frame in box coords; the part is placed in the clip frame's coords
			local c = Instance.new("Frame")
			c.Name = "Clip" .. i
			c.BackgroundTransparency = 1
			c.BorderSizePixel = 0
			c.ClipsDescendants = true
			c.Position = UDim2.fromScale(clip.x, clip.y)
			c.Size = UDim2.fromScale(clip.w, clip.h)
			c.ZIndex = base + i
			c.Active = false
			c.Parent = host
			-- part size is given in box fractions: convert to clip-frame fractions
			f.Size = UDim2.fromScale(p.w / clip.w, p.h / clip.h)
			f.Position = UDim2.fromScale(p.x, p.y)
			f.Parent = c
		else
			f.Size = UDim2.fromScale(p.w, p.h)
			f.Position = UDim2.fromScale(p.x, p.y)
			f.Parent = host
		end
	end

	if parent then
		root.Parent = parent
	end
	return root
end

--[[ Recolour an icon made by Make (ink parts → color; fill parts → fill when given). ]]
function HudIcons.SetColor(icon: Instance, color: Color3, fill: Color3?)
	for _, d in ipairs(icon:GetDescendants()) do
		if d:IsA("Frame") then
			local role = d:GetAttribute("Role")
			if role == "Ink" then
				d.BackgroundColor3 = color
			elseif role == "Fill" and fill then
				d.BackgroundColor3 = fill
			end
		end
	end
end

--[[ "Arrow": point the glyph at a bearing (degrees, clockwise; 0 = up). No-op for other kinds. ]]
function HudIcons.SetRotation(icon: Instance, degrees: number)
	local rot = icon:FindFirstChild("Rot")
	if rot and rot:IsA("GuiObject") then
		rot.Rotation = degrees
	end
end

return HudIcons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="224">
            <Properties>
              <string name="Name">HudLayout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HudLayout — the v70 HUD's shared layout brain (client only). Every HUD controller codes against this API;
	the numbers live in Shared/Configs/HudConfig.luau.

	GUARANTEES
	  * Works before anything registers: every getter answers from the camera / GuiService / a tiny probe gui.
	  * Never yields (the only yielding member is Signal:Wait(), on purpose).
	  * Degrades when ScreenInsets.TopbarSafeInsets / GuiService.TopbarInset / ScreenGui.ScreenInsets are
	    missing on an older client (spec risk #1): IgnoreGuiInset fallbacks + HudConfig.TopStrip.FallbackLeft.

	COORDINATES
	  "real" = device px. "v" = offsets under the HUD UIScale "MobileScale" (real = v × Scale()).
	  Rects returned here (ContentRect, Reserve, GetRect, TopStack placement) are in the SAME space as
	  GuiObject.AbsolutePosition, so compare them with AbsolutePosition/AbsoluteSize directly. TopbarRect() is
	  in screen px (GuiService.TopbarInset space).

	API (fixed contracts, spec §9)
	  ApplyScreen(screen, {DisplayOrder?, Insets? = "Core"|"Topbar"|"None"|"Device", Scale?}) -> UIScale?
	  Scale() -> number · IsTouch() -> boolean · ContentSizeV() -> Vector2
	  PrefersKeys() -> boolean · InputModeChanged (prefersKeys)   -- key hints / keyboard copy (CLAUDE.md §1)
	  SetFlag(name, on) · GetFlag(name) -> boolean · FlagChanged (name, on)
	  BindVisibility(obj, {ShowWhen?, HideWhen?}, extra?)
	  RegisterTopStack(name, obj, order, {Space? = "Hud"|"Screen"})
	  RegisterPanel(id, isOpen, close, {Fallback?, NonModal?}) · PanelOpened(id) · PanelClosed(id)
	  SetBadge(tileId, text?) · BadgeChanged (tileId, text?)
	  CashFloat(amount) · CashFloatRequested (amount)
	  SetRect(name, obj) · GetRect(name) -> (pos, size)
	  Reserve("CombatTouch"|"CombatDesktop"|"Combat") -> Rect
	  ActionLaneBottomV() -> number
	  Signals.CompassTapped
	EXTRAS
	  Init() · LayoutChanged · ContentRect() · ToPx(v) · ToV(px) · TopbarRect() · TopbarArea(screen)
	  UnbindVisibility(obj) · RefreshVisibility(obj?) · EvalRule(rule, extra?) · Flags()
	  UnregisterTopStack(name) · RelayoutTopStack() · TopStackMaxWidthV()
	  IsPanelOpen(id) · OpenPanelId() · CloseAllPanels() · HasPanel(id) · PanelSerial() · PanelChanged (id, open)
	  GetBadge(tileId) · Emit(signalName, ...) · AssertTouchTarget(obj, label?)
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = {}

export type Rule = { ShowWhen: { string }?, HideWhen: { string }? }
-- what BindVisibility / EvalRule accept: any table with HideWhen and/or ShowWhen (HudConfig.Rail, .Hotbar, ...)
export type RuleArg = Rule | { HideWhen: { string } } | { ShowWhen: { string } }
export type ScreenOpts = { DisplayOrder: number?, Insets: string?, Scale: boolean? }
export type StackOpts = { Space: string? }

local PROBE_NAME = "WE_HudProbe"
local FALLBACK_VIEWPORT = Vector2.new(1280, 720)
local FALLBACK_TOPBAR_H = 58

---------------------------------------------------------------------------------------------------------------
-- tiny signal (RBXScriptSignal-shaped: Connect / Once / Wait / ConnectParallel; conn:Disconnect())
-- Handlers run through task.spawn, so one failing handler never stops the others.
---------------------------------------------------------------------------------------------------------------

local function newSignal(): (any, (...any) -> ())
	local conns: { any } = {}
	local waiting: { thread } = {}
	local sig: any = {}
	local function connect(_self: any, fn: (...any) -> ()): any
		local c: any = { Connected = true, Fn = fn }
		c.Disconnect = function(_: any)
			if not c.Connected then
				return
			end
			c.Connected = false
			local i = table.find(conns, c)
			if i then
				table.remove(conns, i)
			end
		end
		table.insert(conns, c)
		return c
	end
	sig.Connect = connect
	sig.ConnectParallel = connect
	sig.Once = function(self: any, fn: (...any) -> ()): any
		local c: any = nil
		c = connect(self, function(...)
			if c then
				c:Disconnect()
			end
			fn(...)
		end)
		return c
	end
	sig.Wait = function(_self: any): ...any
		table.insert(waiting, coroutine.running())
		return coroutine.yield()
	end
	local function fire(...: any)
		for _, c in ipairs(table.clone(conns)) do
			if c.Connected then
				task.spawn(c.Fn, ...)
			end
		end
		if #waiting > 0 then
			local w = waiting
			waiting = {}
			for _, co in ipairs(w) do
				task.spawn(co, ...)
			end
		end
	end
	return sig, fire
end

local flagSig, fireFlag = newSignal()
local badgeSig, fireBadge = newSignal()
local cashSig, fireCash = newSignal()
local layoutSig, fireLayout = newSignal()
local panelSig, firePanel = newSignal()
local compassSig, fireCompass = newSignal()
local inputSig, fireInput = newSignal()

HudLayout.FlagChanged = flagSig :: RBXScriptSignal<string, boolean>
HudLayout.BadgeChanged = badgeSig :: RBXScriptSignal<string, string?>
HudLayout.CashFloatRequested = cashSig :: RBXScriptSignal<number>
HudLayout.LayoutChanged = layoutSig :: RBXScriptSignal<>
HudLayout.PanelChanged = panelSig :: RBXScriptSignal<string, boolean>
HudLayout.InputModeChanged = inputSig :: RBXScriptSignal<boolean>
HudLayout.Signals = {
	CompassTapped = compassSig :: RBXScriptSignal<>, -- CompassController fires (Emit), TerritoryController listens
}
local emitters: { [string]: (...any) -> () } = { CompassTapped = fireCompass }

local warned: { [string]: boolean } = {}
local function warnOnce(key: string, ...: any)
	if warned[key] then
		return
	end
	warned[key] = true
	warn("[HudLayout]", ...)
end

---------------------------------------------------------------------------------------------------------------
-- device, viewport, scale, content rect
---------------------------------------------------------------------------------------------------------------

local touchOverride: boolean? = nil

-- Same test as VehicleDriveClient / every controller (UserInputService.TouchEnabled) so the touch reserve,
-- the ▲▼ column and the touch combat buttons always agree.
function HudLayout.IsTouch(): boolean
	if touchOverride ~= nil then
		return touchOverride
	end
	return UserInputService.TouchEnabled == true
end

--[[
	Key hints and keyboard copy ("press K", "WASD", key caps, the Settings controls sheet) show ONLY when this is
	true: UserInputService.PreferredInput is KeyboardAndMouse or Gamepad (CLAUDE.md §1 "Copy by device": detect
	with PreferredInput, not TouchEnabled). IsTouch() stays the LAYOUT switch (tap-target sizes).
	Fallback when the property is missing (older clients, the headless harness): the last input type, then
	"has a keyboard and no touch screen". A phone therefore never gets key copy.
]]
local keyPrefOverride: boolean? = nil

local function readPreferredInput(): string?
	local ok, v = pcall(function(): any
		return (UserInputService :: any).PreferredInput
	end)
	if ok and typeof(v) == "EnumItem" then
		local name = (v :: EnumItem).Name
		if name == "KeyboardAndMouse" or name == "Gamepad" or name == "Touch" then
			return name
		end
	end
	return nil
end

local function lastInputPrefersKeys(): boolean?
	local ok, t = pcall(function(): any
		return UserInputService:GetLastInputType()
	end)
	if not ok or typeof(t) ~= "EnumItem" then
		return nil
	end
	local name = (t :: EnumItem).Name
	if name == "Touch" then
		return false
	end
	if name == "Keyboard" or string.sub(name, 1, 5) == "Mouse" or string.sub(name, 1, 7) == "Gamepad" then
		return true
	end
	return nil
end

function HudLayout.PrefersKeys(): boolean
	if keyPrefOverride ~= nil then
		return keyPrefOverride
	end
	local pref = readPreferredInput()
	if pref then
		return pref ~= "Touch"
	end
	local last = lastInputPrefersKeys()
	if last ~= nil then
		return last
	end
	local okT, touch = pcall(function(): boolean
		return UserInputService.TouchEnabled == true
	end)
	local okK, keys = pcall(function(): boolean
		return UserInputService.KeyboardEnabled == true or UserInputService.GamepadEnabled == true
	end)
	return (okK and keys == true) and not (okT and touch == true)
end

local lastKeyPref: boolean? = nil
local function checkInputMode()
	local now = HudLayout.PrefersKeys()
	if now ~= lastKeyPref then
		local first = lastKeyPref == nil
		lastKeyPref = now
		if not first then
			fireInput(now)
		end
	end
end

local function viewportSize(): Vector2
	local cam = Workspace.CurrentCamera
	if cam then
		local v = cam.ViewportSize
		if v.X > 1 and v.Y > 1 then
			return v
		end
	end
	return FALLBACK_VIEWPORT
end

local function scaleFor(vp: Vector2): number
	local sc = HudConfig.Scale
	return math.clamp(math.min(vp.X, vp.Y) / sc.BasePx, sc.Min, sc.Max)
end

--[[ S = clamp(min(vw, vh) / 800, 0.70, 1.15): 844x390 → 0.70, 956x440 → 0.70, 1280x720 → 0.90, 1920x1080 → 1.15 ]]
function HudLayout.Scale(): number
	local cam = Workspace.CurrentCamera
	local v = cam and cam.ViewportSize
	if not (v and v.X > 1 and v.Y > 1) and HudLayout.IsTouch() then
		-- viewport not reported yet (early join on a phone): the phone scale; the ViewportSize watcher corrects it
		return HudConfig.Scale.Min
	end
	return scaleFor(viewportSize())
end

function HudLayout.ToPx(v: number): number
	return v * HudLayout.Scale()
end

function HudLayout.ToV(px: number): number
	return px / HudLayout.Scale()
end

local function guiInset(): (Vector2, Vector2)
	local ok, tl, br = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(tl) == "Vector2" and typeof(br) == "Vector2" then
		return tl, br
	end
	return Vector2.new(0, FALLBACK_TOPBAR_H), Vector2.zero
end

local probe: ScreenGui? = nil
local probeConns: { RBXScriptConnection } = {}
local onLayoutChanged: () -> () -- forward

local function ensureProbe(): ScreenGui?
	local g = probe
	if g and g.Parent then
		return g
	end
	local lp = Players.LocalPlayer
	local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local existing = pg:FindFirstChild(PROBE_NAME)
	local sg: ScreenGui
	if existing and existing:IsA("ScreenGui") then
		sg = existing
	else
		sg = Instance.new("ScreenGui")
		sg.Name = PROBE_NAME
		sg.ResetOnSpawn = false
		sg.DisplayOrder = -1
		sg.IgnoreGuiInset = false
		pcall(function()
			sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
		end)
		sg.Parent = pg
	end
	for _, c in ipairs(probeConns) do
		c:Disconnect()
	end
	table.clear(probeConns)
	table.insert(probeConns, sg:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		onLayoutChanged()
	end))
	table.insert(probeConns, sg:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		onLayoutChanged()
	end))
	probe = sg
	return sg
end

-- the safe content rect (CoreUISafeInsets area) in AbsolutePosition space: x, y, w, h (real px)
local function contentRect(): (number, number, number, number)
	local g = ensureProbe()
	if g then
		local ok, pos, size = pcall(function()
			return g.AbsolutePosition, g.AbsoluteSize
		end)
		if ok and typeof(pos) == "Vector2" and typeof(size) == "Vector2" and size.X > 1 and size.Y > 1 then
			return pos.X, pos.Y, size.X, size.Y
		end
	end
	-- no PlayerGui yet: viewport minus the gui inset (no notch information)
	local vp = viewportSize()
	local tl, br = guiInset()
	return tl.X, tl.Y, math.max(1, vp.X - tl.X - br.X), math.max(1, vp.Y - tl.Y - br.Y)
end

function HudLayout.ContentRect(): Rect
	local x, y, w, h = contentRect()
	return Rect.new(x, y, x + w, y + h)
end

--[[ The content rect in v (844x390 → 1071x474). ]]
function HudLayout.ContentSizeV(): Vector2
	local _, _, w, h = contentRect()
	local s = HudLayout.Scale()
	return Vector2.new(w / s, h / s)
end

---------------------------------------------------------------------------------------------------------------
-- topbar row (TopStrip)
---------------------------------------------------------------------------------------------------------------

local function topbarInsetRect(): Rect?
	local ok, r = pcall(function()
		return (GuiService :: any).TopbarInset
	end)
	if ok and typeof(r) == "Rect" and r.Width > 0 and r.Height > 0 then
		return r
	end
	return nil
end

--[[ The free part of the Roblox topbar row in screen px: GuiService.TopbarInset, or (older clients) from
	safe-left + HudConfig.TopStrip.FallbackLeft to the content's right edge, GetGuiInset().Y tall. ]]
function HudLayout.TopbarRect(): Rect
	local r = topbarInsetRect()
	if r then
		return r
	end
	local cx, _, cw, _ = contentRect()
	local tl = guiInset()
	local h = if tl.Y >= 1 then tl.Y else FALLBACK_TOPBAR_H
	local left = cx + HudConfig.TopStrip.FallbackLeft
	return Rect.new(left, 0, math.max(left, cx + cw), h)
end

-- STRONG on purpose: a weak Instance key is dropped by Roblox GC while the gui is still parented (devforum t/86634);
-- onLayoutChanged prunes screens whose frame left them.
local topbarAreas: { [ScreenGui]: Frame } = {}

local function placeTopbarArea(screen: ScreenGui, f: Frame)
	if screen:GetAttribute("WE_HudInsets") == "Topbar" then
		-- native TopbarSafeInsets: the gui itself is the free topbar row and reflows with the unibar
		f.Position = UDim2.fromScale(0, 0)
		f.Size = UDim2.fromScale(1, 1)
		return
	end
	-- fallback (IgnoreGuiInset = true): place the row in this gui's local px. Abs X == screen X; the gui's
	-- top is the screen top, i.e. content top − the gui inset, whatever the AbsolutePosition convention.
	local r = HudLayout.TopbarRect()
	local _, cy = contentRect()
	local tl = guiInset()
	local origin = screen.AbsolutePosition
	local originX = origin.X
	local originY = origin.Y - (cy - tl.Y)
	f.Position = UDim2.fromOffset(r.Min.X - originX, r.Min.Y - originY)
	f.Size = UDim2.fromOffset(r.Width, r.Height)
end

--[[ A transparent Frame "TopbarArea" inside a TopStrip gui (ApplyScreen Insets = "Topbar") that always covers
	the free topbar row, native or fallback. Put the left group at (0, EdgePad, 0.5, YNudge) and the compass at
	(1, -EdgePad, 0.5, 0) inside it. Kept in place on LayoutChanged. ]]
function HudLayout.TopbarArea(screen: ScreenGui): Frame
	local found = screen:FindFirstChild("TopbarArea")
	local f: Frame
	if found and found:IsA("Frame") then
		f = found
	else
		f = Instance.new("Frame")
		f.Name = "TopbarArea"
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.Active = false
		f.Parent = screen
	end
	topbarAreas[screen] = f
	placeTopbarArea(screen, f)
	return f
end

---------------------------------------------------------------------------------------------------------------
-- ScreenGui setup + the one shared UIScale
---------------------------------------------------------------------------------------------------------------

-- STRONG on purpose (see topbarAreas): the owner ScreenGuis never keep the UIScale ApplyScreen returns, so a weak key
-- let GC drop WarEmpireHUD's scale and it stayed at its first value (the 0.90 fallback) - rail/pill 1.29x too big.
-- onLayoutChanged prunes scales whose Parent is nil.
local trackedScales: { [UIScale]: boolean } = {}

local function setInsets(screen: ScreenGui, want: Enum.ScreenInsets): boolean
	local ok = pcall(function()
		screen.ScreenInsets = want
	end)
	return ok
end

local function enumInset(name: string): Enum.ScreenInsets?
	local ok, item = pcall(function()
		return (Enum.ScreenInsets :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" then
		return item :: Enum.ScreenInsets
	end
	return nil
end

-- returns the mode actually applied: "Core" | "Topbar" | "TopbarFallback" | "None" | "Device" | "Legacy"
local function applyInsets(screen: ScreenGui, insets: string): string
	if insets == "Topbar" then
		screen.IgnoreGuiInset = true
		local item = enumInset("TopbarSafeInsets")
		if item and setInsets(screen, item) then
			return "Topbar"
		end
		return "TopbarFallback"
	elseif insets == "None" or insets == "Device" then
		screen.IgnoreGuiInset = true
		local item = enumInset(if insets == "None" then "None" else "DeviceSafeInsets")
		if item and setInsets(screen, item) then
			return insets
		end
		return "Legacy"
	end
	if insets ~= "Core" then
		warnOnce("insets:" .. insets, "unknown Insets", insets, "- using Core")
	end
	screen.IgnoreGuiInset = false
	local item = enumInset("CoreUISafeInsets")
	if item and setInsets(screen, item) then
		return "Core"
	end
	return "Legacy" -- IgnoreGuiInset = false is the old-client equivalent
end

--[[
	The only way a HUD ScreenGui is set up. ResetOnSpawn = false, Sibling z, DisplayOrder (opts or
	HudConfig.DisplayOrder[screen.Name]), insets, and ONE UIScale "MobileScale" (reused if the gui has one)
	that HudLayout keeps at Scale(). Scale defaults to true except for Insets = "Topbar" (real px).
	The applied mode is stored in the attribute WE_HudInsets ("Core", "Topbar", "TopbarFallback", "None",
	"Device", "Legacy"). Returns the UIScale, or nil when Scale = false.
]]
function HudLayout.ApplyScreen(screen: ScreenGui, opts: ScreenOpts?): UIScale?
	local o: ScreenOpts = opts or {}
	local insets = o.Insets or "Core"
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local order = o.DisplayOrder or (HudConfig.DisplayOrder :: any)[screen.Name]
	if typeof(order) == "number" then
		screen.DisplayOrder = order
	end
	local mode = applyInsets(screen, insets)
	screen:SetAttribute("WE_HudInsets", mode)

	local wantScale = if o.Scale == nil then insets ~= "Topbar" else o.Scale == true
	local existing: UIScale? = nil
	for _, c in ipairs(screen:GetChildren()) do
		if c:IsA("UIScale") then
			if c.Name == "MobileScale" then
				existing = c
				break
			end
			if not existing then
				existing = c
			end
		end
	end
	if existing then
		UIUtil.ReleaseMobileScale(existing) -- stop UIUtil.AttachMobileScale's own tracker fighting ours
	end
	if not wantScale then
		if existing then
			trackedScales[existing] = nil
			existing:Destroy()
		end
		if topbarAreas[screen] then
			placeTopbarArea(screen, topbarAreas[screen])
		end
		return nil
	end
	local sc: UIScale = existing or Instance.new("UIScale")
	sc.Name = "MobileScale"
	sc.Scale = HudLayout.Scale()
	sc.Parent = screen
	-- prune on add too, so a gui made and destroyed per open can never grow the table (Parent == nil, not
	-- IsDescendantOf(game): most callers run ApplyScreen before parenting their ScreenGui)
	for s in pairs(trackedScales) do
		if s.Parent == nil then
			trackedScales[s] = nil
		end
	end
	trackedScales[sc] = true
	return sc
end

---------------------------------------------------------------------------------------------------------------
-- context flags + visibility
---------------------------------------------------------------------------------------------------------------

local flags: { [string]: boolean } = {}

type Binding = { Rule: Rule, Extra: (() -> boolean)? }
local bindings: { [GuiObject]: Binding } = {} -- STRONG (see trackedScales); removed on Destroying / UnbindVisibility

-- true / false, or nil when `extra` threw (keep the current visibility)
local function evalRule(rule: Rule, extra: (() -> boolean)?): boolean?
	local hide = rule.HideWhen
	if hide then
		for _, f in ipairs(hide) do
			if flags[f] then
				return false
			end
		end
	end
	local show = rule.ShowWhen
	if show and #show > 0 then
		local any = false
		for _, f in ipairs(show) do
			if flags[f] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	if extra then
		local ok, res = pcall(extra)
		if not ok then
			warnOnce("extra:" .. tostring(extra), "BindVisibility extra() failed:", res)
			return nil
		end
		return res == true
	end
	return true
end

local function applyBinding(obj: GuiObject, b: Binding)
	local v = evalRule(b.Rule, b.Extra)
	if v == nil then
		return
	end
	local inst: Instance = obj
	if inst:IsA("GuiObject") then
		if inst.Visible ~= v then
			inst.Visible = v
		end
	elseif inst:IsA("LayerCollector") then
		if inst.Enabled ~= v then
			inst.Enabled = v
		end
	end
end

local function ruleMentions(rule: Rule, name: string): boolean
	if rule.HideWhen and table.find(rule.HideWhen, name) then
		return true
	end
	if rule.ShowWhen and table.find(rule.ShowWhen, name) then
		return true
	end
	return false
end

function HudLayout.GetFlag(name: string): boolean
	return flags[name] == true
end

--[[ Context flags (HudConfig.Context.Flags + OrdersOpen, Radar, or any name). Fires FlagChanged on change. ]]
function HudLayout.SetFlag(name: string, on: boolean)
	local v = on == true
	if (flags[name] == true) == v then
		return
	end
	flags[name] = v
	for obj, b in pairs(bindings) do
		if ruleMentions(b.Rule, name) then
			applyBinding(obj, b)
		end
	end
	fireFlag(name, v)
end

function HudLayout.Flags(): { [string]: boolean }
	return table.clone(flags)
end

--[[ true when the rule passes right now (all HideWhen flags off, any ShowWhen flag on, extra() true). ]]
function HudLayout.EvalRule(rule: RuleArg, extra: (() -> boolean)?): boolean
	return evalRule(rule :: any, extra) == true
end

--[[
	HudLayout owns obj.Visible from now on (a ScreenGui: .Enabled): visible = no HideWhen flag on AND (no
	ShowWhen, or any ShowWhen flag on) AND (extra == nil or extra()). Re-evaluated on every relevant SetFlag;
	call RefreshVisibility(obj) when whatever extra() reads changes. Rebinding replaces the old rule.
	HudConfig tables work as rules directly: BindVisibility(rail, HudConfig.Rail).
]]
function HudLayout.BindVisibility(obj: GuiObject, rule: RuleArg, extra: (() -> boolean)?)
	local r: Rule = rule :: any
	local b: Binding = { Rule = { ShowWhen = r.ShowWhen, HideWhen = r.HideWhen }, Extra = extra }
	if bindings[obj] == nil then
		pcall(function()
			obj.Destroying:Once(function()
				bindings[obj] = nil
			end)
		end)
	end
	bindings[obj] = b
	applyBinding(obj, b)
end

function HudLayout.UnbindVisibility(obj: GuiObject)
	bindings[obj] = nil
end

function HudLayout.RefreshVisibility(obj: GuiObject?)
	if obj then
		local b = bindings[obj]
		if b then
			applyBinding(obj, b)
		end
		return
	end
	for o, b in pairs(bindings) do
		applyBinding(o, b)
	end
end

---------------------------------------------------------------------------------------------------------------
-- top-centre stack
---------------------------------------------------------------------------------------------------------------

type StackItem = {
	Name: string,
	Obj: GuiObject,
	Order: number,
	Seq: number,
	Space: string,
	Conns: { RBXScriptConnection },
}
local stack: { [string]: StackItem } = {}
local stackSeq = 0
local stackQueued = false

local function firstUIScale(inst: Instance): number
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("UIScale") then
			return c.Scale
		end
	end
	return 1
end

-- product of the UIScales that act on `from`'s children: from itself up to (and including) its LayerCollector
local function chainScale(from: Instance?): number
	local k = 1
	local p = from
	while p do
		k *= firstUIScale(p)
		if p:IsA("LayerCollector") then
			break
		end
		p = p.Parent
	end
	return k
end

local function shownOnScreen(obj: GuiObject): boolean
	if not obj.Visible then
		return false
	end
	local p = obj.Parent
	while p do
		if p:IsA("GuiObject") then
			if not p.Visible then
				return false
			end
		elseif p:IsA("LayerCollector") then
			return p.Enabled
		else
			return false
		end
		p = p.Parent
	end
	return false
end

--[[ Place every registered, visible item top-down in Order (ties: registration order). Synchronous. ]]
function HudLayout.RelayoutTopStack()
	stackQueued = false
	if next(stack) == nil then
		return
	end
	local items: { StackItem } = {}
	for _, it in pairs(stack) do
		if it.Obj.Parent then
			table.insert(items, it)
		end
	end
	table.sort(items, function(a: StackItem, b: StackItem): boolean
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		return a.Seq < b.Seq
	end)
	local _, cy = contentRect()
	local s = HudLayout.Scale()
	local y = cy + HudConfig.TopStack.Top * s
	local gap = HudConfig.TopStack.Gap * s
	for _, it in ipairs(items) do
		local obj = it.Obj
		if shownOnScreen(obj) then
			local own = firstUIScale(obj)
			if own <= 0 then
				own = 1
			end
			local h = obj.AbsoluteSize.Y / own -- real px, ignoring the item's own pop-in UIScale
			local parent = obj.Parent
			local parentY = cy
			if parent and parent:IsA("GuiBase2d") then
				parentY = parent.AbsolutePosition.Y
			end
			local k = chainScale(parent)
			if k <= 0 then
				k = 1
			end
			local offset = (y + obj.AnchorPoint.Y * h - parentY) / k
			local pos = obj.Position
			if pos.Y.Scale ~= 0 or math.abs(pos.Y.Offset - offset) > 0.01 then
				obj.Position = UDim2.new(pos.X.Scale, pos.X.Offset, 0, offset)
			end
			y += h + gap
		end
	end
end

local function queueStack()
	if stackQueued then
		return
	end
	stackQueued = true
	task.defer(function()
		if stackQueued then
			HudLayout.RelayoutTopStack()
		end
	end)
end

function HudLayout.UnregisterTopStack(name: string)
	local it = stack[name]
	if not it then
		return
	end
	for _, c in ipairs(it.Conns) do
		c:Disconnect()
	end
	stack[name] = nil
	queueStack()
end

--[[
	Stack obj in the top-centre column under the topbar (HudConfig.TopStack: Top 8 v, Gap 6 v; Order from
	HudConfig.TopStack.Order — Alert 10, Progress 20, Objective 30, Toasts 40, Offer 50). HudLayout writes only
	obj.Position.Y (X stays yours: use (0.5, 0) + AnchorPoint X 0.5). Hidden items collapse. Re-runs when an
	item's Visible / AbsoluteSize / parent / its gui's Enabled change, and on LayoutChanged.
	opts.Space ("Hud" = inside a MobileScale gui, "Screen" = real px gui like WE_MissileAlert) is accepted for
	clarity; the math reads the parent chain's actual UIScales and AbsolutePosition, so either works.
	obj must not be inside a UIListLayout / UIGridLayout (the layout would own its Position).
]]
function HudLayout.RegisterTopStack(name: string, obj: GuiObject, order: number, opts: StackOpts?)
	HudLayout.UnregisterTopStack(name)
	stackSeq += 1
	local it: StackItem = {
		Name = name,
		Obj = obj,
		Order = order,
		Seq = stackSeq,
		Space = (opts and opts.Space) or "Hud",
		Conns = {},
	}
	stack[name] = it
	local gui: LayerCollector? = nil
	local guiConn: RBXScriptConnection? = nil
	local function watchGui()
		local g = obj:FindFirstAncestorWhichIsA("LayerCollector")
		if g == gui then
			return
		end
		if guiConn then
			guiConn:Disconnect()
			guiConn = nil
		end
		gui = g
		if g then
			guiConn = g:GetPropertyChangedSignal("Enabled"):Connect(queueStack)
		end
	end
	table.insert(it.Conns, obj:GetPropertyChangedSignal("Visible"):Connect(queueStack))
	table.insert(it.Conns, obj:GetPropertyChangedSignal("AbsoluteSize"):Connect(queueStack))
	table.insert(it.Conns, obj.AncestryChanged:Connect(function()
		watchGui()
		queueStack()
	end))
	watchGui()
	-- disconnect the gui watcher together with the item
	table.insert(it.Conns, {
		Disconnect = function()
			if guiConn then
				guiConn:Disconnect()
				guiConn = nil
			end
		end,
	} :: any)
	HudLayout.RelayoutTopStack()
end

--[[ Widest an item in the stack may be, in v (HudConfig.TopStack.MaxWidthScale × content width). ]]
function HudLayout.TopStackMaxWidthV(): number
	local _, _, w = contentRect()
	return HudConfig.TopStack.MaxWidthScale * w / HudLayout.Scale()
end

---------------------------------------------------------------------------------------------------------------
-- panels (one open at a time → Modal flag)
---------------------------------------------------------------------------------------------------------------

type Panel = { IsOpen: () -> boolean, Close: () -> (), Fallback: boolean, NonModal: boolean }
-- NonModal (the Army popover, mobile plan P1-6): still one-open-at-a-time with the other panels, but it does NOT
-- raise the Modal flag, so FIRE / the hotbar / the prompt lane stay up while it is open
export type PanelOpts = { Fallback: boolean?, NonModal: boolean? }
local panels: { [string]: Panel } = {}
local openPanels: { [string]: boolean } = {}
local lastOpened: string? = nil
local closingOthers = false
local panelSerial = 0

-- should PanelOpened(other) / CloseAllPanels close `id`? A Fallback registration (UIController's stand-in for a
-- panel that did not register itself) counts only while the registry lists it open, so a stand-in filed under a
-- different id than the panel's own registration can never close the panel that just opened.
local function panelReportsOpen(id: string): boolean
	local p = panels[id]
	if p and p.Fallback and not openPanels[id] then
		return false
	end
	if p then
		local ok, r = pcall(p.IsOpen)
		if ok then
			return r == true
		end
	end
	return false
end

local function refreshModal()
	local modal = false
	for id in pairs(openPanels) do
		local p = panels[id]
		if not (p and p.NonModal) then
			modal = true
			break
		end
	end
	HudLayout.SetFlag("Modal", modal)
end

--[[ Register once in Init. isOpen: is the panel showing now; close: hide it (it should call PanelClosed).
	opts.Fallback (UIController only): a stand-in registration; a real RegisterPanel for the same id replaces it
	and it is never closed on isOpen() alone (see panelReportsOpen). ]]
function HudLayout.RegisterPanel(id: string, isOpen: () -> boolean, close: () -> (), opts: PanelOpts?)
	local fallback = opts ~= nil and opts.Fallback == true
	local cur = panels[id]
	if fallback and cur and not cur.Fallback then
		return -- the panel registered itself: keep that
	end
	local nonModal = if opts ~= nil and opts.NonModal ~= nil then opts.NonModal == true else (cur ~= nil and cur.NonModal)
	panels[id] = { IsOpen = isOpen, Close = close, Fallback = fallback, NonModal = nonModal }
	refreshModal()
end

--[[ Increments on every PanelOpened / PanelClosed call. UIController compares it around an opener to tell
	whether the panel reported itself (then it does nothing) or needs the fallback sync. ]]
function HudLayout.PanelSerial(): number
	return panelSerial
end

--[[ true once RegisterPanel(id, ...) ran (UIController registers the panels a controller did not register itself). ]]
function HudLayout.HasPanel(id: string): boolean
	return panels[id] ~= nil
end

--[[ Call from the panel's setOpen(true). Closes every other open panel (HudConfig.Context.ModalExclusive). ]]
function HudLayout.PanelOpened(id: string)
	panelSerial += 1
	local was = openPanels[id] == true
	openPanels[id] = true
	lastOpened = id
	if HudConfig.Context.ModalExclusive ~= false and not closingOthers then
		closingOthers = true
		for otherId, p in pairs(panels) do
			if otherId ~= id and (openPanels[otherId] or panelReportsOpen(otherId)) then
				local ok, err = pcall(function(): string?
					p.Close()
					return nil
				end)
				if not ok then
					warn("[HudLayout] closing panel", otherId, "failed:", err)
				end
				if openPanels[otherId] then
					openPanels[otherId] = nil
					firePanel(otherId, false)
				end
			end
		end
		closingOthers = false
	end
	refreshModal()
	if not was then
		firePanel(id, true)
	end
end

--[[ Call from the panel's setOpen(false) / close path. ]]
function HudLayout.PanelClosed(id: string)
	panelSerial += 1
	local was = openPanels[id] == true
	openPanels[id] = nil
	if lastOpened == id then
		lastOpened = next(openPanels)
	end
	refreshModal()
	if was then
		firePanel(id, false)
	end
end

function HudLayout.IsPanelOpen(id: string): boolean
	return openPanels[id] == true
end

function HudLayout.OpenPanelId(): string?
	if lastOpened and openPanels[lastOpened] then
		return lastOpened
	end
	return next(openPanels)
end

--[[ Close every open registered panel (Escape, tapping the dim, death...). ]]
function HudLayout.CloseAllPanels()
	for id, p in pairs(panels) do
		if openPanels[id] or panelReportsOpen(id) then
			local ok, err = pcall(function(): string?
				p.Close()
				return nil
			end)
			if not ok then
				warn("[HudLayout] closing panel", id, "failed:", err)
			end
			HudLayout.PanelClosed(id)
		end
	end
end

-- Safety net: a REGISTERED panel whose isOpen() says closed while the registry still lists it open (a close path
-- that forgot PanelClosed — e.g. the panel's own X button) would leave Modal on, and Modal hides the hotbar, the
-- prompt lane and BUY. Two sweeps in a row (~1 s) clear it.
local STALE_SWEEP_SECONDS = 0.5
local staleSweeps: { [string]: number } = {}
local function sweepStalePanels()
	local stale: { string } = {}
	for id in pairs(openPanels) do
		if panels[id] and not panelReportsOpen(id) then
			local n = (staleSweeps[id] or 0) + 1
			staleSweeps[id] = n
			if n >= 2 then
				table.insert(stale, id)
			end
		else
			staleSweeps[id] = nil
		end
	end
	for id in pairs(staleSweeps) do
		if not openPanels[id] then
			staleSweeps[id] = nil
		end
	end
	for _, id in ipairs(stale) do
		staleSweeps[id] = nil
		HudLayout.PanelClosed(id)
	end
end

---------------------------------------------------------------------------------------------------------------
-- rail badges, cash float, named rects, reserved regions, action lane
---------------------------------------------------------------------------------------------------------------

local badges: { [string]: string? } = {}

--[[ Rail tile badge: "!" (gold ready style), a count ("3"), or nil / "" / "0" to clear. HUDController draws
	it (BadgeChanged); anyone may set it, before or after the HUD exists (GetBadge replays the state). ]]
function HudLayout.SetBadge(tileId: string, text: string?)
	local t: string? = text
	if t == "" or t == "0" then
		t = nil
	end
	if badges[tileId] == t then
		return
	end
	badges[tileId] = t
	fireBadge(tileId, t)
end

function HudLayout.GetBadge(tileId: string): string?
	return badges[tileId]
end

--[[ "+$141" at the cash pill (negative = spend float). Merging / rate limits are HUDController's (HudConfig.CashFloat). ]]
function HudLayout.CashFloat(amount: number)
	if typeof(amount) ~= "number" or amount ~= amount or amount == 0 or math.abs(amount) == math.huge then
		return
	end
	fireCash(amount)
end

local rects: { [string]: GuiObject } = {}

--[[ Publish a HUD piece's rect under a name ("Rail", "CashPill", "Hotbar", "ActionLane", "Compass", "ArmyTile"...). ]]
function HudLayout.SetRect(name: string, obj: GuiObject)
	rects[name] = obj
end

--[[ (AbsolutePosition, AbsoluteSize) of the named piece; zeros when unknown or not parented. ]]
function HudLayout.GetRect(name: string): (Vector2, Vector2)
	local obj = rects[name]
	if obj and obj.Parent then
		return obj.AbsolutePosition, obj.AbsoluteSize
	end
	return Vector2.zero, Vector2.zero
end

--[[
	Reserved bottom-right rect in real px (AbsolutePosition space): "CombatTouch", "CombatDesktop", or "Combat"
	(= the one for this device). Width/Height v × Scale(), floored by MinWidthPx/MinHeightPx so it always holds
	VehicleDriveClient's ▲▼ column. 844x390: x ≥ 594, y ≥ 168. 1280x720: x ≥ 974, y ≥ 585.
]]
function HudLayout.Reserve(name: string): Rect
	local key = name
	if key == "Combat" then
		key = if HudLayout.IsTouch() then "CombatTouch" else "CombatDesktop"
	end
	local r = (HudConfig.Reserve :: any)[key]
	if type(r) ~= "table" or type(r.Width) ~= "number" or type(r.Height) ~= "number" then
		warnOnce("reserve:" .. name, "unknown reserve", name)
		return Rect.new(0, 0, 0, 0)
	end
	local cx, cy, cw, ch = contentRect()
	local s = HudLayout.Scale()
	local w = math.min(cw, math.max(r.Width * s, tonumber(r.MinWidthPx) or 0))
	local h = math.min(ch, math.max(r.Height * s, tonumber(r.MinHeightPx) or 0))
	return Rect.new(cx + cw - w, cy + ch - h, cx + cw, cy + ch)
end

--[[ Bottom edge of the action lane (prompt pills, BUY), in v above the content bottom: 100 touch / 86 desktop. ]]
function HudLayout.ActionLaneBottomV(): number
	local slot = if HudLayout.IsTouch() then HudConfig.Hotbar.Slot else HudConfig.Hotbar.SlotDesktop
	return HudConfig.Hotbar.Bottom + slot + HudConfig.Health.GapAboveHotbar + HudConfig.Health.Height + HudConfig.ActionLane.Gap
end

--[[ Fire one of HudLayout.Signals (e.g. Emit("CompassTapped") from CompassController). ]]
function HudLayout.Emit(signalName: string, ...: any)
	local f = emitters[signalName]
	if f then
		f(...)
	else
		warnOnce("emit:" .. signalName, "unknown signal", signalName)
	end
end

--[[ Studio + touch only: warn when a tappable renders under HudConfig.Scale.TouchMinPx real px. ]]
function HudLayout.AssertTouchTarget(obj: GuiObject, label: string?)
	if not (RunService:IsStudio() and HudLayout.IsTouch()) then
		return
	end
	task.defer(function()
		local sz = obj.AbsoluteSize
		local minPx = HudConfig.Scale.TouchMinPx
		if obj.Parent and (sz.X < minPx - 0.5 or sz.Y < minPx - 0.5) then
			warn(string.format("[HudLayout] touch target %s is %.0fx%.0f px (< %d)", label or obj:GetFullName(), sz.X, sz.Y, minPx))
		end
	end)
end

---------------------------------------------------------------------------------------------------------------
-- viewport / camera / topbar / character watchers
---------------------------------------------------------------------------------------------------------------

local layoutQueued = false

onLayoutChanged = function()
	local s = HudLayout.Scale()
	for sc in pairs(trackedScales) do
		if sc.Parent then
			if sc.Scale ~= s then
				sc.Scale = s
			end
		else
			trackedScales[sc] = nil
		end
	end
	for screen, f in pairs(topbarAreas) do
		if f.Parent == screen then
			placeTopbarArea(screen, f)
		else
			topbarAreas[screen] = nil
		end
	end
	queueStack()
	if not layoutQueued then
		layoutQueued = true
		task.defer(function()
			layoutQueued = false
			fireLayout()
		end)
	end
end

local camConn: RBXScriptConnection? = nil
local function bindCamera()
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
	local cam = Workspace.CurrentCamera
	if cam then
		camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(onLayoutChanged)
	end
	onLayoutChanged()
end

local humConns: { RBXScriptConnection } = {}
local function clearHumanoid()
	for _, c in ipairs(humConns) do
		c:Disconnect()
	end
	table.clear(humConns)
end

local function drivingSeat(seat: Instance?): boolean
	return seat ~= nil and seat:IsA("VehicleSeat")
end

local function bindHumanoid(hum: Humanoid)
	HudLayout.SetFlag("Dead", hum.Health <= 0)
	HudLayout.SetFlag("Driving", drivingSeat(hum.SeatPart))
	table.insert(humConns, hum.Died:Connect(function()
		HudLayout.SetFlag("Dead", true)
		HudLayout.SetFlag("Driving", false)
	end))
	table.insert(humConns, hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
		HudLayout.SetFlag("Driving", drivingSeat(hum.SeatPart))
	end))
end

local function bindCharacter(char: Model)
	clearHumanoid()
	HudLayout.SetFlag("Dead", false)
	HudLayout.SetFlag("Driving", false)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		bindHumanoid(hum)
		return
	end
	local conn: RBXScriptConnection? = nil
	conn = char.ChildAdded:Connect(function(c: Instance)
		if c:IsA("Humanoid") then
			if conn then
				conn:Disconnect()
			end
			bindHumanoid(c)
		end
	end)
	if conn then
		table.insert(humConns, conn)
	end
end

local started = false
local playerBound = false

local function bindPlayer()
	if playerBound then
		return
	end
	local lp = Players.LocalPlayer
	if not lp then
		return
	end
	playerBound = true
	lp.CharacterAdded:Connect(bindCharacter)
	lp.CharacterRemoving:Connect(function()
		clearHumanoid()
		HudLayout.SetFlag("Driving", false)
	end)
	if lp.Character then
		bindCharacter(lp.Character)
	end
end

--[[ Idempotent; also runs on require. Safe to call from any controller's Init. Never yields. ]]
function HudLayout.Init()
	bindPlayer()
	if started then
		return
	end
	started = true
	local ok, err = pcall(function()
		Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
		bindCamera()
	end)
	if not ok then
		warnOnce("camera", "camera watch failed:", err)
	end
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(onLayoutChanged)
	end)
	-- key hints follow the device the player is using now (PreferredInput; LastInputType as the fallback)
	checkInputMode()
	pcall(function()
		UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(checkInputMode)
	end)
	pcall(function()
		UserInputService.LastInputTypeChanged:Connect(function()
			if readPreferredInput() == nil then
				checkInputMode()
			end
		end)
	end)
	pcall(function()
		local acc = 0
		RunService.Heartbeat:Connect(function(dt: number)
			acc += dt
			if acc >= STALE_SWEEP_SECONDS then
				acc = 0
				sweepStalePanels()
			end
		end)
	end)
end

-- test hook (headless harness): force the touch / desktop layout; nil = use the device
function HudLayout._SetTouchOverride(value: boolean?)
	touchOverride = value
	onLayoutChanged()
end

-- test hook (headless harness): force key hints on / off; nil = use the device
function HudLayout._SetKeyPrefOverride(value: boolean?)
	keyPrefOverride = value
	checkInputMode()
end

HudLayout.Init()

return HudLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="225">
            <Properties>
              <string name="Name">LabelGovernor</string>
              <string name="Source"><![CDATA[--!strict
--[[
	F4 / spec §1.1 (owner's 11 features, lane G): LabelGovernor makes CLAUDE.md's "at most 3 world labels on screen at a
	base" true on this client, whatever the server and the other client modules build.

	Every base BillboardGui carries the CollectionService tag WorldLabelConfig.BaseLabelTag ("WE_BaseLabel"): the ATM
	premium pads and the gold pump pad (lane W, server), the producer label (ProducerLabels), the console / NEXT tags
	(WorldPromptController) and the business "+$N" pops (BusinessVisuals). BaseLabelGovernor.Hz times a second the
	governor keeps the MaxOnScreen tagged labels nearest the camera that could draw (their owner wants them on, they
	are not another player's owner-only label, and the camera is within their own MaxDistance) and holds every other
	tagged label off through WorldLabel.Hold. A held label keeps its owner's wish and comes back when released. A label
	tagged between two passes starts held and is decided on the next Heartbeat, so the cap holds on every frame.

	Never touched: a label whose WorldLabelConfig.RoleAttribute is "objective" (the one AlwaysOnTop objective marker)
	does not count toward the cap and is never held (one held before it became the objective is released). SurfaceGuis
	(painted signs) are not governed.

	Phone cost: one Heartbeat accumulator (the per-frame path only adds dt); the pass walks a dense list of tagged
	labels with scalar maths into preallocated arrays: no whole-tree scan, no table or closure per pass, no yields. Off
	(Init returns at once) while WorldLabelConfig.BaseLabelGovernor.Enabled is false.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- Bootstrap already waited for it; bounded anyway
local WorldLabelConfig = require(Shared.Configs.WorldLabelConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

local LabelGovernor = {}

local CFG = WorldLabelConfig.BaseLabelGovernor
local TAG = WorldLabelConfig.BaseLabelTag
local ROLE_ATTR = WorldLabelConfig.RoleAttribute
local EXEMPT_ROLE = "objective"
local HUGE = math.huge

local started = false
local labels: { BillboardGui } = {} -- dense list of the tagged billboards on this client
local slot: { [BillboardGui]: number } = {} -- label -> index in `labels`
local pick: { boolean } = {} -- per index: kept on by the last pass (reused, never reallocated)
local bestIdx: { number } = {} -- the MaxOnScreen nearest candidates (insertion-sorted, preallocated)
local bestD: { number } = {}
local passDue = true -- run a pass on the next Heartbeat (a label was tagged / untagged)

local function maxOnScreen(): number
	return math.max(0, math.floor(tonumber(CFG.MaxOnScreen) or 3))
end

local function isExempt(gui: BillboardGui): boolean
	return gui:GetAttribute(ROLE_ATTR) == EXEMPT_ROLE
end

-- the label's world anchor (Adornee, else its parent: BasePart / Attachment / a Model's PrimaryPart) as three numbers;
-- nil when it is not placed in this client's world (streamed out, parked)
local function anchorXYZ(gui: BillboardGui): (number?, number, number)
	local a: Instance? = gui.Adornee
	if a == nil then
		a = gui.Parent
	end
	if a == nil then
		return nil, 0, 0
	end
	if a:IsA("Model") then
		local pp = (a :: Model).PrimaryPart
		if pp == nil then
			return nil, 0, 0
		end
		a = pp
	end
	local inst = a :: Instance
	if inst:IsA("BasePart") then
		if not inst:IsDescendantOf(Workspace) then
			return nil, 0, 0
		end
		local p = inst.Position
		return p.X, p.Y, p.Z
	elseif inst:IsA("Attachment") then
		if not inst:IsDescendantOf(Workspace) then
			return nil, 0, 0
		end
		local p = inst.WorldPosition
		return p.X, p.Y, p.Z
	end
	return nil, 0, 0
end

-- distance from the camera to the label's drawn point, or HUGE when it cannot draw here
local function distanceOf(gui: BillboardGui, cx: number, cy: number, cz: number): number
	local x, y, z = anchorXYZ(gui)
	if x == nil then
		return HUGE
	end
	local o = gui.StudsOffsetWorldSpace
	local dx, dy, dz = x + o.X - cx, y + o.Y - cy, z + o.Z - cz
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- one pass: the MaxOnScreen nearest drawable labels stay on, every other governed label is held off
local function pass()
	local cam = Workspace.CurrentCamera
	if cam == nil then
		return
	end
	local camPos = cam.CFrame.Position
	local cx, cy, cz = camPos.X, camPos.Y, camPos.Z
	local cap = maxOnScreen()
	local n = #labels
	local kept = 0
	for i = 1, n do
		local gui = labels[i]
		pick[i] = false
		if not isExempt(gui) and WorldLabel.Wanted(gui) then
			local d = distanceOf(gui, cx, cy, cz)
			if d <= gui.MaxDistance and d < HUGE then
				if kept < cap then
					kept += 1
					bestIdx[kept] = i
					bestD[kept] = d
				elseif cap > 0 and d < bestD[kept] then
					bestIdx[kept] = i
					bestD[kept] = d
				else
					continue
				end
				local k = kept
				while k > 1 and bestD[k] < bestD[k - 1] do
					bestD[k], bestD[k - 1] = bestD[k - 1], bestD[k]
					bestIdx[k], bestIdx[k - 1] = bestIdx[k - 1], bestIdx[k]
					k -= 1
				end
			end
		end
	end
	for k = 1, kept do
		pick[bestIdx[k]] = true
	end
	for i = 1, n do
		local gui = labels[i]
		if isExempt(gui) then
			if WorldLabel.IsHeld(gui) then
				WorldLabel.Hold(gui, false) -- became the objective marker while held: give it back, then hands off
			end
		else
			WorldLabel.Hold(gui, not pick[i])
		end
	end
end

local function track(inst: Instance)
	if not inst:IsA("BillboardGui") then
		return
	end
	local gui = inst :: BillboardGui
	if slot[gui] ~= nil then
		return
	end
	table.insert(labels, gui)
	slot[gui] = #labels
	pick[#labels] = false
	if not isExempt(gui) then
		WorldLabel.Hold(gui, true) -- held until the next pass decides (the cap holds between passes)
	end
	passDue = true
end

local function untrack(inst: Instance)
	local gui = inst :: BillboardGui
	local i = slot[gui]
	if i == nil then
		return
	end
	local last = #labels
	local moved = labels[last]
	labels[i] = moved
	slot[moved] = i
	pick[i] = pick[last]
	labels[last] = nil
	pick[last] = nil
	slot[gui] = nil
	if WorldLabel.IsHeld(gui) then
		WorldLabel.Hold(gui, false) -- no longer governed (untagged but still here): its owner decides again
	end
	passDue = true
end

-- test / debug: how many governed labels are on this client, and how many are not held
function LabelGovernor.Counts(): (number, number)
	local on = 0
	for _, gui in ipairs(labels) do
		if gui.Enabled and not isExempt(gui) then
			on += 1
		end
	end
	return #labels, on
end

function LabelGovernor.Pass()
	pass()
end

function LabelGovernor.Init()
	if started or CFG.Enabled ~= true then
		return
	end
	started = true
	CollectionService:GetInstanceAddedSignal(TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(untrack)
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		track(inst)
	end
	local period = 1 / math.clamp(tonumber(CFG.Hz) or 4, 1, 10) -- <= 10 Hz (CLAUDE.md UI refresh cap)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < period and not passDue then
			return
		end
		acc = 0 -- reset, never catch up
		passDue = false
		pass()
	end)
end

return LabelGovernor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="226">
            <Properties>
              <string name="Name">NextPadChevrons</string>
              <string name="Source"><![CDATA[--!strict
--[[
	F5 (owner's 11 features, lane G): gold floor chevrons from the player to the next pad, on the player's OWN plot.
	Client-only and owner-only by construction (local parts under this client's camera; nothing is sent to or read
	from the server beyond the replicated state below). Display only: the server re-checks every buy.

	Target (TycoonMath.GuideTarget, the one pointer shared with the console NEXT tag):
	  * while the tutorial runs (TycoonGuideConfig.Chevrons.FollowTutorial): the active step's own pad (PadBuy steps),
	    the own ATM (Pointer "ATM", the Collect cash step), else nothing (claim / recruit / outpost / 4x4);
	  * afterwards: the server pick WE_NextBuy (the cheapest unpaid pad), else the local TycoonMath.PickCheapest over
	    the last BaseStateUpdate.Upgrades. Soldiers / nothing left -> no chevrons.
	  The tutorial step comes from TutorialStateUpdate (or PlayerStateUpdate). If that push reached another listener
	  before this module connected, the HudLayout "Tutorial" flag still says a step is up: then no chevrons until the
	  step is known, never the post-tutorial pick by mistake.
	Where: TycoonMath.ApproachPoint(id) (plot-local: a walk-in's door + DoorLeadStuds, a kiosk, the ATM) through
	Shared/Util/PlotFrame into the own plot's frame. Config only: nothing here waits for a part to stream in. The own
	plot id is BaseStateUpdate / PlayerStateUpdate PlotId, else the plot that holds the server-stamped WE_AtmPos /
	WE_ConsolePos_CommandCenter (retried every RetargetRetrySeconds until known).
	Layout (TycoonMath.ChevronCount): chevron k (1..Count) sits LeadStuds + (k - 1) x SpacingStuds along the straight
	line to the target; the count stops StopShortStuds before it and is 0 within HideWithinStuds. A chevron that would
	touch a TycoonMath.Footprints rectangle or the own pad's edge (its whole reach, about 2 studs, stays clear) is left
	out (the others keep their spacing). Each
	chevron is two BarSize bars meeting at a tip that points at the target (+-BarAngleDeg), BarY = pad top + Lift;
	transparency runs TransparencyNear (nearest the player) to TransparencyFar.
	Hidden: outside the own plot, any TycoonGuideConfig.Chevrons.HideWhen HudLayout flag (Driving, Dead, RecentCombat,
	Drawn, Modal, AtConsole), while the GO beam is up (ConsoleWaypoint), no target, or within HideWithinStuds.

	Phone cost: a pool of 2 x Count Parts in Workspace.CurrentCamera.WE_NextChevrons (Anchored, CanCollide / CanTouch /
	CanQuery off, CastShadow = false, SmoothPlastic; no special material, no light, no GUI), built once. One Heartbeat
	accumulator: the per-frame path only adds dt. At RefreshHz (<= 10) it re-lays the chevrons only when the character
	moved MoveThresholdStuds or the target changed, moving all of them with one Workspace:BulkMoveTo into
	preallocated arrays; a pass that re-lays nothing allocates nothing. No per-frame scans, no yields.
	Off (Init returns at once) while TycoonGuideConfig.Chevrons.Enabled is false.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- Bootstrap already waited for it; bounded anyway
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local BaseConfig = require(Shared.Configs.BaseConfig)
local TutorialConfig = require(Shared.Configs.TutorialConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local TycoonMath = require(Shared.Util.TycoonMath)
local PlotFrame = require(Shared.Util.PlotFrame)

local HudLayout = require(script.Parent.HudLayout)
local ConsoleWaypoint = require(script.Parent.ConsoleWaypoint)

local NextPadChevrons = {}

local C = TycoonGuideConfig.Chevrons
local COUNT = math.max(1, math.floor(C.Count))
local POOL = 2 * COUNT
local LEAD = C.LeadStuds
local SPACING = C.SpacingStuds
local BAR_LEN = C.BarSize.Z
local ARM = math.rad(C.BarAngleDeg)
local COS_ARM, SIN_ARM = math.cos(ARM), math.sin(ARM)
local APEX = 0.5 * BAR_LEN * COS_ARM -- the tip sits this far ahead of the chevron's centre point
local MOVE2 = C.MoveThresholdStuds * C.MoveThresholdStuds
local PERIOD = 1 / math.clamp(C.RefreshHz, 1, 10) -- <= 10 Hz (CLAUDE.md UI refresh cap)
local RETRY = math.max(0.25, C.RetargetRetrySeconds)
local HALF_PAD = BaseConfig.PlotSize.X * 0.5 -- the own pad (plot-local square)
-- how far a chevron reaches from its centre point: the arm ends (half a bar behind the centre along the line, a whole
-- bar x sin(BarAngleDeg) to the side) plus half a bar's width. That much stays clear of the pad edge and of every
-- footprint, so no bar pokes into a building or off the pad.
local CLEAR = math.sqrt((0.5 * BAR_LEN * COS_ARM) ^ 2 + (BAR_LEN * SIN_ARM) ^ 2) + 0.5 * C.BarSize.X
local FOLDER_NAME = "WE_NextChevrons"
-- server-stamped world positions on the own plot (the plot id when no state push has named it yet)
local PLOT_HINT_ATTRS = { "WE_AtmPos", "WE_ConsolePos_CommandCenter" }

type Step = { PadStructureId: string?, Pointer: string? }

local player = Players.LocalPlayer
local started = false

-- replicated state (events)
local plotId: number? = nil
local upgrades: { [string]: any }? = nil
local tutKnown = false -- a TutorialStateUpdate / PlayerStateUpdate tutorial field has arrived
local tutStep: Step? = nil -- the active step (nil = none / complete)
local payloadStep: Step = { PadStructureId = nil, Pointer = nil } -- reused for a step Id this client does not know

-- target (plot-local tlx/tlz, world twx/twz), refreshed by retarget()
local hasTarget = false
local targetId: string? = nil
local plotCF: CFrame = CFrame.identity
local tlx, tlz, twx, twz = 0, 0, 0, 0
local barY = 0
local retargetDue = true
local retryAt = 0

-- layout
local laid = false -- chevrons are laid out for (lastX, lastZ) and the current target
local lastX, lastZ = 0, 0
local folder: Folder? = nil
local parts: { BasePart } = {}
local cframes: { CFrame } = {}
local shownT: { number } = {} -- the Transparency each part was last given (writes only on change)
local forceTick = true

-- ── pure helpers (tests call these) ───────────────────────────────────────────────────────────────────────────

--[[ The active step as GuideTarget wants it (nil once the tutorial is complete / skipped), and `unknown` = true while
	a step is up on the HUD but its Id has not reached this module (then: no pointer until it has). ]]
function NextPadChevrons.ActiveStep(): (Step?, boolean)
	if tutKnown then
		return tutStep, false
	end
	return nil, HudLayout.GetFlag("Tutorial")
end

-- The plot (1..MaxPlots) whose pad square holds world point `pos` (with `margin` studs of slack), else nil
function NextPadChevrons.PlotAt(pos: Vector3, margin: number?): number?
	local half = HALF_PAD + (margin or 0)
	for id = 1, BaseConfig.MaxPlots do
		local pp = PlotFrame.PlotPosition(id)
		if pp ~= nil then
			local l = PlotFrame.PlotCFrame(pp):PointToObjectSpace(pos)
			if math.abs(l.X) <= half and math.abs(l.Z) <= half then
				return id
			end
		end
	end
	return nil
end

--[[ Chevron k (1..count) for a player at plot-local (lx, lz) heading to plot-local (tx, tz): its centre along the
	line, or nil when it is left out (inside a footprint / off the pad). Returns (cx, cz, dirX, dirZ) plot-local. ]]
function NextPadChevrons.Slot(lx: number, lz: number, tx: number, tz: number, k: number): (number?, number, number, number)
	local dx, dz = tx - lx, tz - lz
	local d = math.sqrt(dx * dx + dz * dz)
	if d <= 0 then
		return nil, 0, 0, 0
	end
	local ux, uz = dx / d, dz / d
	local s = LEAD + (k - 1) * SPACING
	local cx, cz = lx + ux * s, lz + uz * s
	if math.abs(cx) > HALF_PAD - CLEAR or math.abs(cz) > HALF_PAD - CLEAR then
		return nil, cx, cz, 0
	end
	if TycoonMath.InFootprint(cx, cz, CLEAR) ~= nil then
		return nil, cx, cz, 0
	end
	return cx, cz, ux, uz
end

-- ── state ─────────────────────────────────────────────────────────────────────────────────────────────────────

local function markRetarget()
	retargetDue = true
	forceTick = true
end

local function ownPlot(): number?
	if plotId ~= nil then
		return plotId
	end
	for _, name in ipairs(PLOT_HINT_ATTRS) do
		local v = player:GetAttribute(name)
		if typeof(v) == "Vector3" then
			local id = NextPadChevrons.PlotAt(v, 24)
			if id ~= nil then
				return id
			end
		end
	end
	return nil
end

local function stepFromId(id: any, pad: any, pointer: any): Step?
	if typeof(id) == "string" then
		local i = TutorialConfig.IndexOf(id)
		local def = if i ~= nil then TutorialConfig.Steps[i] else nil
		if def ~= nil then
			return def
		end
	end
	-- a step this client's config does not list (older client, newer server): the push carries what we need
	payloadStep.PadStructureId = if typeof(pad) == "string" then pad else nil
	payloadStep.Pointer = if typeof(pointer) == "string" then pointer else nil
	return payloadStep
end

local function onTutorial(payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	tutKnown = true
	if payload.Complete == true then
		tutStep = nil
	else
		tutStep = stepFromId(payload.Id, payload.PadStructureId, payload.Pointer)
	end
	markRetarget()
end

local function applyPlot(v: any)
	if typeof(v) == "number" and v ~= plotId then
		plotId = v
		markRetarget()
	end
end

local function onBase(base: any)
	if typeof(base) ~= "table" then
		return
	end
	applyPlot(base.PlotId)
	if typeof(base.Upgrades) == "table" then
		upgrades = base.Upgrades
		markRetarget()
	end
end

local function onPlayerState(state: any)
	if typeof(state) ~= "table" then
		return
	end
	onBase(state.Base)
	if state.TutorialComplete == true then
		tutKnown = true
		tutStep = nil
		markRetarget()
	elseif state.TutorialComplete == false and typeof(state.TutorialStep) == "number" then
		local def = TutorialConfig.GetStep(state.TutorialStep)
		if def ~= nil then
			tutKnown = true
			tutStep = def
			markRetarget()
		end
	end
end

-- ── pool ──────────────────────────────────────────────────────────────────────────────────────────────────────

local function ensurePool(): boolean
	local cam = Workspace.CurrentCamera
	if cam == nil then
		return false
	end
	local f = folder
	if f ~= nil and f.Parent ~= nil and #parts == POOL and parts[1].Parent == f then
		if f.Parent ~= cam then
			f.Parent = cam
		end
		return true
	end
	-- first use, or the old camera (and the pool with it) went away: build it again
	if f ~= nil then
		f:Destroy()
	end
	laid = false
	local nf = Instance.new("Folder")
	nf.Name = FOLDER_NAME
	table.clear(parts)
	table.clear(cframes)
	table.clear(shownT)
	for i = 1, POOL do
		local p = Instance.new("Part")
		p.Name = "Chevron"
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = C.Color
		p.Size = C.BarSize
		p.Transparency = 1
		p.CFrame = CFrame.identity
		p.Parent = nf
		parts[i] = p
		cframes[i] = CFrame.identity
		shownT[i] = 1
	end
	nf.Parent = cam
	folder = nf
	return true
end

local function setT(i: number, t: number)
	if shownT[i] ~= t then
		shownT[i] = t
		parts[i].Transparency = t
	end
end

local function hideParts()
	for i = 1, #parts do
		setT(i, 1)
	end
end

-- hidden for a reason other than where the character stands: lay out again once it is shown
local function hideAll()
	laid = false
	hideParts()
end

-- ── target + layout ───────────────────────────────────────────────────────────────────────────────────────────

local function retarget()
	retargetDue = false
	hasTarget = false
	laid = false
	local pid = ownPlot()
	local pos = if pid ~= nil then PlotFrame.PlotPosition(pid) else nil
	if pid == nil or pos == nil then
		retryAt = os.clock() + RETRY -- the plot id is not known yet: try again soon
		return
	end
	local step, unknown = NextPadChevrons.ActiveStep()
	if unknown then
		return -- a tutorial step is up but not known here yet: its push retargets
	end
	local id = TycoonMath.GuideTarget(step, player:GetAttribute("WE_NextBuy"), upgrades)
	targetId = id
	local lp = if id ~= nil then TycoonMath.ApproachPoint(id) else nil
	if lp == nil then
		return
	end
	plotCF = PlotFrame.PlotCFrame(pos)
	tlx, tlz = lp.X, lp.Z
	local w = plotCF:PointToWorldSpace(Vector3.new(tlx, 0, tlz))
	twx, twz = w.X, w.Z
	barY = pos.Y + BaseConfig.PlotSize.Y * 0.5 + C.Lift
	hasTarget = true
end

local function hiddenByFlags(): boolean
	for _, name in ipairs(C.HideWhen) do
		if HudLayout.GetFlag(name) then
			return true
		end
	end
	return ConsoleWaypoint.Current() ~= nil -- the GO beam is up: one pointer at a time
end

-- one bar of chevron `k` (side -1 / +1): its centre is half a bar behind the tip along the arm
local function barCFrame(tipX: number, tipZ: number, ux: number, uz: number, side: number): CFrame
	-- arm = the backward direction (-ux, -uz) turned by side x ARM
	local s = side * SIN_ARM
	local ax = -ux * COS_ARM + uz * s
	local az = -uz * COS_ARM - ux * s
	local h = 0.5 * BAR_LEN
	-- bar length (local Z) along the arm, Y up, X = Y x Z
	return CFrame.new(tipX + ax * h, barY, tipZ + az * h, az, 0, ax, 0, 1, 0, -ax, 0, az)
end

-- lay the chevrons out for a character at (px, py, pz); the answer (shown or not) holds until it moves again
local function layout(px: number, py: number, pz: number)
	laid = true
	lastX, lastZ = px, pz
	local l = plotCF:PointToObjectSpace(Vector3.new(px, py, pz))
	local lx, lz = l.X, l.Z
	if math.abs(lx) > HALF_PAD or math.abs(lz) > HALF_PAD then
		hideParts() -- not on the own plot
		return
	end
	local dx, dz = tlx - lx, tlz - lz
	local d = math.sqrt(dx * dx + dz * dz)
	local count = TycoonMath.ChevronCount(d)
	if count <= 0 then
		hideParts() -- arrived (within HideWithinStuds)
		return
	end
	-- world direction (the plot frame only turns about Y, so world and plot-local distances agree)
	local wx, wz = twx - px, twz - pz
	local wd = math.sqrt(wx * wx + wz * wz)
	if wd <= 0 then
		hideParts()
		return
	end
	local ux, uz = wx / wd, wz / wd
	local any = false
	local span = math.max(1, COUNT - 1)
	for k = 1, COUNT do
		local i1, i2 = 2 * k - 1, 2 * k
		local cx = if k <= count then NextPadChevrons.Slot(lx, lz, tlx, tlz, k) else nil
		if cx ~= nil then
			local s = LEAD + (k - 1) * SPACING
			local tipX, tipZ = px + ux * (s + APEX), pz + uz * (s + APEX)
			cframes[i1] = barCFrame(tipX, tipZ, ux, uz, -1)
			cframes[i2] = barCFrame(tipX, tipZ, ux, uz, 1)
			local t = C.TransparencyNear + (C.TransparencyFar - C.TransparencyNear) * (k - 1) / span
			setT(i1, t)
			setT(i2, t)
			any = true
		else
			setT(i1, 1)
			setT(i2, 1)
		end
	end
	if any then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function tick()
	if not ensurePool() then
		return
	end
	if retargetDue or (not hasTarget and os.clock() >= retryAt and plotId == nil) then
		retarget()
	end
	if not hasTarget or hiddenByFlags() then
		hideAll() -- writes only parts still showing (a target that just went away included)
		return
	end
	local char = player.Character
	local hrp = if char then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil or not hrp:IsA("BasePart") then
		hideAll()
		return
	end
	local p = (hrp :: BasePart).Position
	if laid then
		local mx, mz = p.X - lastX, p.Z - lastZ
		if mx * mx + mz * mz < MOVE2 then
			return -- nothing moved: nothing to do (no allocation)
		end
	end
	layout(p.X, p.Y, p.Z)
end

-- test / debug: the resolved target id and whether any chevron shows
function NextPadChevrons.State(): (string?, boolean, number)
	local shown = 0
	for i = 1, #parts, 2 do
		if shownT[i] ~= 1 then
			shown += 1
		end
	end
	return (if hasTarget then targetId else nil), shown > 0, shown
end

function NextPadChevrons.Tick()
	tick()
end

function NextPadChevrons.Init()
	if started or C.Enabled ~= true then
		return
	end
	started = true
	Remotes.BindEvent(Constants.RemoteNames.TutorialStateUpdate, onTutorial)
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, onBase)
	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, onPlayerState)
	player:GetAttributeChangedSignal("WE_NextBuy"):Connect(markRetarget)
	for _, name in ipairs(PLOT_HINT_ATTRS) do
		player:GetAttributeChangedSignal(name):Connect(function()
			if plotId == nil then
				markRetarget()
			end
		end)
	end
	player.CharacterAdded:Connect(markRetarget)
	HudLayout.FlagChanged:Connect(function(name: string)
		if name == "Tutorial" then
			markRetarget()
		elseif table.find(C.HideWhen, name) ~= nil then
			forceTick = true -- hide / show on the next frame, not the next refresh
		end
	end)
	local acc = PERIOD -- first pass on the first beat
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < PERIOD and not forceTick then
			return
		end
		acc = 0 -- reset, never catch up
		forceTick = false
		tick()
	end)
end

return NextPadChevrons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="227">
            <Properties>
              <string name="Name">ObjectiveMarker</string>
              <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE W3 step 2 — ObjectiveMarker: the one AlwaysOnTop objective marker for jobs (spec scratchpad w3s2 §3:
	"AlwaysOnTop: only ObjectiveMarker"; §6 Phase A lanes L0 / U0 / M0, Phase B lane U).

	FROZEN API (lane L0; lane M0's MissionController GO and later OpsController call it):
	  ObjectiveMarker.Show(target)            target = { Short: string, X: number, Y: number, Z: number }: world studs
	                                          of the objective's standing surface and a short device-neutral label
	                                          ("BANK"); replaces the current one. An invalid target (empty label,
	                                          non-finite position) is ignored with one warning.
	  ObjectiveMarker.Clear()                 removes the current target (no-op when there is none)
	  ObjectiveMarker.Current() -> Target?    a copy of the current target, or nil
	Additive (lane U0, read-only helpers for other client code; no allocation):
	  ObjectiveMarker.Revision() -> number    bumps on every Show / Clear / arrival / timeout (callers re-read Current()
	                                          only when it changed: CompassController's tracked mode)
	  ObjectiveMarker.Showing() -> boolean    this marker is drawn: a target is set and ConsoleWaypoint is not guiding
	  ObjectiveMarker.OnTop() -> boolean      an objective marker is drawing AlwaysOnTop right now (this one, or the
	                                          ConsoleWaypoint line it yields to): TerritoryController's contested
	                                          diamond yields to it, so only ONE AlwaysOnTop label is on screen
	Additive (Phase B lane U; OpsController follows a job with them, the frozen three are unchanged):
	  ObjectiveMarker.ShowWith(target, opts?) Show with this target's own arrival radius / timeout
	                                          (opts = { ArriveStuds?, TimeoutSeconds? }: OpsConfig.Ui for jobs);
	                                          Show(target) = ShowWith(target, nil) = the OBJ numbers below
	  ObjectiveMarker.Move(x, y, z) -> boolean  the current target moved (a carried bag, a rotating cache): same label,
	                                          same timeout, the line and marker follow without a rebuild; Revision()
	                                          bumps. false when there is no target or the point is not finite
	  ObjectiveMarker.Ended() -> string?      how the last target ended: "Arrived" | "Timeout" | "Cleared" (Clear(),
	                                          a ConsoleWaypoint GO); nil while one is set (a Show over a Show just
	                                          replaces it: Revision() tells the old owner)

	What it draws (client only, nothing replicates, 0 parts): an invisible Attachment in Workspace.Terrain at the
	target (+ MarkerLift), a thin Beam from the local character to it (the "GO line"), and ONE BillboardGui on it:
	the label ("BANK") over the distance ("620m"), 14-20 px text, AlwaysOnTop = true — the only AlwaysOnTop label the
	game draws on purpose (WE_LabelRole "objective", WorldLabel.SetRole). It is transient: only after a GO, and gone
	on arrival (ArriveRadius), after TimeoutSeconds, on Clear() or on the next Show().

	Yields to ConsoleWaypoint: while ConsoleWaypoint.Current() ~= nil (a Base-panel GO or the tutorial's guide line
	to your own console / ATM) the line and marker are hidden (Enabled = false) and come back when that line ends.
	ConsoleWaypoint is required lazily, so Phase B's two ConsoleWaypoint lines that call ObjectiveMarker.Clear() cannot
	make a require cycle. Phase B (lane U): the latest GO wins both ways — a console GO clears this marker (those two
	lines) and a Show / ShowWith ends a running console line (ConsoleWaypoint.Clear()), so the yield is only a guard.

	Cost: one Heartbeat connection only while a target is set; the work inside runs at <= RefreshHz (<= 10 Hz, the
	CLAUDE.md UI refresh cap): arrival / timeout / yield checks and a distance text rewritten only when the shown
	value changes. No unbounded WaitForChild, no whole-tree scan, no remote, nothing per frame beyond the accumulator.
	Streaming-safe: it never looks up a workspace part; the target is the position the caller (the server's data)
	gave, and the character is found with FindFirstChild each tick (respawn → the line re-attaches).
	Look: the ConsoleWaypoint line's config (ConsoleBuyConfig.Waypoint) so both guide lines look the same; the
	three objective-only numbers are OBJ below (they move to OpsConfig.Ui with Phase B lane O, ASSUMPTIONS U0-1).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- ships with the place (Rojo); bounded wait anyway
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

export type Target = { Short: string, X: number, Y: number, Z: number }
export type Opts = { ArriveStuds: number?, TimeoutSeconds: number? }

local ObjectiveMarker = {}

local W = ConsoleBuyConfig.Waypoint
-- objective-only tunables (world studs / seconds); see the header
local OBJ = {
	ArriveRadius = 24, -- cleared when the character is this close (3D) to the target: "you are there"
	TimeoutSeconds = 600, -- a forgotten marker goes away after 10 min
	MarkerLift = 6, -- studs above the target's standing surface (the line ends there too)
	TitlePx = 20, -- "BANK" (real px; a BillboardGui has no UIScale)
	DistancePx = 16, -- "620m"
	MaxLabelChars = 12,
}
local PERIOD = 1 / math.clamp(W.RefreshHz, 1, 10) -- CLAUDE.md: UI refresh <= 10 Hz

local player = Players.LocalPlayer

local current: Target? = nil
local warnedBad = false
local revision = 0
local arriveR = OBJ.ArriveRadius -- this target's (ShowWith opts, else OBJ)
local timeoutS = OBJ.TimeoutSeconds
local ended: string? = nil -- Ended()
local startedAt = 0
local lastAttemptAt = -math.huge
local stepConn: RBXScriptConnection? = nil
local stepAcc = 0
local yielded = false
local stepKey = -1 -- distKey of the distance text on screen

-- visuals (all client-only)
local anchor: Attachment? = nil -- in Workspace.Terrain at the target (+ MarkerLift)
local att0: Attachment? = nil -- on the character's HumanoidRootPart
local beam: Beam? = nil
local marker: BillboardGui? = nil
local distLabel: TextLabel? = nil

---------------------------------------------------------------------------------------------------------------
-- ConsoleWaypoint (read only, lazy: see the header)
---------------------------------------------------------------------------------------------------------------

type ConsoleWaypointApi = { Current: () -> string?, Clear: (() -> ())? }
local ConsoleWaypoint: ConsoleWaypointApi? = nil
local cwTried = false

-- true while ConsoleWaypoint is guiding (its own AlwaysOnTop line and marker are up)
local function consoleGuiding(): boolean
	if not cwTried then
		cwTried = true
		local ok, mod = pcall(function(): any
			return require(script.Parent.ConsoleWaypoint)
		end)
		if ok and type(mod) == "table" and type(mod.Current) == "function" then
			ConsoleWaypoint = mod
		else
			warn("[ObjectiveMarker] ConsoleWaypoint unavailable; the marker never yields:", mod)
		end
	end
	if ConsoleWaypoint == nil then
		return false
	end
	return ConsoleWaypoint.Current() ~= nil
end

-- Phase B: a new objective ends a running console line (the latest GO wins; the console GO clears us likewise)
local function endConsoleLine()
	if not consoleGuiding() then
		return
	end
	local cw = ConsoleWaypoint
	local clear = cw and cw.Clear
	if clear then
		local ok, err = pcall(function(): any
			clear()
			return nil
		end)
		if not ok then
			warn("[ObjectiveMarker] ConsoleWaypoint.Clear failed:", err)
		end
	end
end

---------------------------------------------------------------------------------------------------------------

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n > -1e7 and n < 1e7
end

local function rootPart(): BasePart?
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return nil
end

-- The distance line: "95m" under 1 km, "1.2km" above (the compass chip's format). distKey is the shown value, so
-- the text is rebuilt only when what the player sees changes.
local function distKey(metres: number): number
	if metres < 1000 then
		return metres
	end
	return 100000 + math.floor(metres / 100 + 0.5)
end

local function distText(key: number): string
	if key < 100000 then
		return string.format("%dm", key)
	end
	return string.format("%.1fkm", (key - 100000) / 10)
end

local function destroyVisuals()
	local b, m, a, a0 = beam, marker, anchor, att0
	beam, marker, anchor, att0, distLabel = nil, nil, nil, nil, nil
	if b then
		b:Destroy()
	end
	if m then
		m:Destroy()
	end
	if a then
		a:Destroy()
	end
	if a0 then
		a0:Destroy()
	end
	stepKey = -1
end

local function applyEnabled()
	local on = not yielded
	local b, m = beam, marker
	if b and b.Enabled ~= on then
		b.Enabled = on
	end
	if m and m.Enabled ~= on then
		m.Enabled = on
	end
end

-- the line's start on the (current) character; nil while respawning
local function attachStart(): boolean
	local hrp = rootPart()
	local b = beam
	if hrp == nil or b == nil then
		return false
	end
	local a0 = att0
	if a0 and a0.Parent == hrp then
		return true
	end
	if a0 then
		a0:Destroy()
	end
	local na = Instance.new("Attachment")
	na.Name = "WE_ObjectiveAtt0"
	na.Parent = hrp
	att0 = na
	b.Attachment0 = na
	return true
end

local function textLabel(name: string, y: number, h: number, px: number, color: Color3, parent: Instance): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Position = UDim2.fromOffset(0, y)
	l.Size = UDim2.new(1, 0, 0, h)
	l.Font = Enum.Font.GothamBold
	l.TextScaled = false
	l.TextSize = px
	l.TextColor3 = color
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
	l.TextStrokeTransparency = 0.35
	l.Text = ""
	l.Parent = parent
	return l
end

-- (re)build the anchor, line and marker for the current target; false when it cannot yet (no Terrain)
local function build(): boolean
	lastAttemptAt = os.clock()
	local c = current
	if c == nil then
		return false
	end
	destroyVisuals()
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain == nil then
		return false
	end
	local a = Instance.new("Attachment")
	a.Name = "WE_ObjectiveAnchor"
	a.Position = Vector3.new(c.X, c.Y + OBJ.MarkerLift, c.Z) -- Terrain's frame is the world frame
	a.Parent = terrain
	anchor = a

	local b = Instance.new("Beam")
	b.Name = "WE_ObjectiveBeam"
	b.Attachment1 = a
	b.FaceCamera = true
	b.Segments = 1
	b.Width0 = W.BeamWidth0
	b.Width1 = W.BeamWidth1
	b.LightEmission = W.BeamLightEmission
	b.Color = ColorSequence.new(W.BeamColor)
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0.85) })
	b.Parent = terrain -- not on the character: only the start attachment is rebuilt after a respawn
	beam = b
	attachStart()

	local title = string.upper(string.sub(c.Short, 1, OBJ.MaxLabelChars))
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_ObjectiveMarker"
	bb.Adornee = a
	-- real px (a BillboardGui has no UIScale); the width follows the label like the console marker
	bb.Size = UDim2.fromOffset(math.clamp(#title * 12 + 16, W.MarkerMinWidth, W.MarkerMaxWidth), OBJ.TitlePx + OBJ.DistancePx + 8)
	bb.LightInfluence = 0
	bb.Active = false
	bb.ClipsDescendants = false
	bb.AlwaysOnTop = true -- the ONE objective marker (CLAUDE.md world labels); transient, after GO only
	WorldLabel.SetRole(bb, "objective") -- WE_LabelRole: LabelGovernor / WorldLabelPolicy leave it on top
	local t = textLabel("Title", 0, OBJ.TitlePx + 4, OBJ.TitlePx, W.BeamColor, bb)
	t.Text = title
	distLabel = textLabel("Distance", OBJ.TitlePx + 4, OBJ.DistancePx + 4, OBJ.DistancePx, Color3.new(1, 1, 1), bb)
	bb.Parent = a
	marker = bb
	applyEnabled()
	return true
end

local function stop()
	local conn = stepConn
	stepConn = nil
	if conn then
		conn:Disconnect()
	end
end

local function clearNow(reason: string)
	stop()
	destroyVisuals()
	if current ~= nil then
		current = nil
		revision += 1
		ended = reason
	end
	yielded = false
end

local function step(dt: number)
	stepAcc += dt
	if stepAcc < PERIOD then
		return
	end
	stepAcc = 0
	local c = current
	if c == nil then
		clearNow("Cleared")
		return
	end
	local now = os.clock()
	if now - startedAt > timeoutS then
		clearNow("Timeout")
		return
	end
	local hrp = rootPart()
	-- arrival: counts even while yielding (you are there, whatever line is up)
	if hrp then
		local p = hrp.Position
		local dx, dy, dz = p.X - c.X, p.Y - c.Y, p.Z - c.Z
		if dx * dx + dy * dy + dz * dz <= arriveR * arriveR then
			clearNow("Arrived")
			return
		end
	end
	local y = consoleGuiding()
	if y ~= yielded then
		yielded = y
		applyEnabled()
	end
	-- rebuild when something removed the visuals; re-attach the line after a respawn (throttled)
	local m, a0 = marker, att0
	local broken = m == nil or m.Parent == nil or anchor == nil or (anchor :: Attachment).Parent == nil
	local detached = hrp ~= nil and (a0 == nil or a0.Parent ~= hrp)
	if (broken or detached) and now - lastAttemptAt >= W.RetrySeconds then
		lastAttemptAt = now
		if broken then
			build()
		else
			attachStart()
		end
	end
	if yielded or hrp == nil then
		return
	end
	local p = (hrp :: BasePart).Position
	local dx, dz = p.X - c.X, p.Z - c.Z
	local metres = math.floor(math.sqrt(dx * dx + dz * dz))
	local key = distKey(metres)
	local dl = distLabel
	if dl and key ~= stepKey then
		stepKey = key
		dl.Text = distText(key)
	end
end

---------------------------------------------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------------------------------------------

function ObjectiveMarker.ShowWith(target: Target, opts: Opts?)
	local t: any = target
	if type(t) ~= "table" or type(t.Short) ~= "string" or t.Short == "" or not (finite(t.X) and finite(t.Y) and finite(t.Z)) then
		if not warnedBad then
			warnedBad = true
			warn("[ObjectiveMarker] Show ignored an invalid target (want { Short = string, X, Y, Z = numbers })")
		end
		return
	end
	stop()
	endConsoleLine()
	local o: any = opts
	arriveR = if type(o) == "table" and finite(o.ArriveStuds) then math.clamp(o.ArriveStuds, 4, 200) else OBJ.ArriveRadius
	timeoutS = if type(o) == "table" and finite(o.TimeoutSeconds) then math.clamp(o.TimeoutSeconds, 10, 3600) else OBJ.TimeoutSeconds
	current = { Short = t.Short, X = t.X, Y = t.Y, Z = t.Z }
	revision += 1
	ended = nil
	startedAt = os.clock()
	yielded = consoleGuiding()
	build() -- the line starts at once (or after a respawn: step() retries)
	stepAcc = math.huge -- first step runs on the next Heartbeat (distance text)
	stepConn = RunService.Heartbeat:Connect(step)
end

function ObjectiveMarker.Show(target: Target)
	ObjectiveMarker.ShowWith(target, nil)
end

function ObjectiveMarker.Clear()
	clearNow("Cleared")
end

function ObjectiveMarker.Move(x: number, y: number, z: number): boolean
	local c = current
	if c == nil or not (finite(x) and finite(y) and finite(z)) then
		return false
	end
	if c.X == x and c.Y == y and c.Z == z then
		return true
	end
	c.X, c.Y, c.Z = x, y, z
	revision += 1
	local a = anchor
	if a then
		a.Position = Vector3.new(x, y + OBJ.MarkerLift, z)
	end
	stepKey = -1 -- the distance text is rewritten on the next step
	return true
end

function ObjectiveMarker.Ended(): string?
	if current ~= nil then
		return nil
	end
	return ended
end

function ObjectiveMarker.Current(): Target?
	local c = current
	if c == nil then
		return nil
	end
	return { Short = c.Short, X = c.X, Y = c.Y, Z = c.Z }
end

function ObjectiveMarker.Revision(): number
	return revision
end

function ObjectiveMarker.Showing(): boolean
	return current ~= nil and not consoleGuiding()
end

function ObjectiveMarker.OnTop(): boolean
	return current ~= nil or consoleGuiding()
end

return ObjectiveMarker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="228">
            <Properties>
              <string name="Name">OpsJobs</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsJobs — the JOBS resolver (W3 step 2 Phase B, lane U). Pure functions over plain tables: no Instances, no
	services, no clock reads (every function that ages a timer takes `now`), so the headless tests call it directly.
	Contract: scratchpad w3s2/buildB/KB/contract.md §6. Spec: w3s2/spec_w3s2.md + activities §1.1-1.4.

	The client never decides anything here: states, pay, cooldowns and every point come from the server's OpsState /
	OpsPing payloads (OpsConfig exported types). This module only caches them, ages the "seconds left" timers and
	picks what the JOBS board and the GO button show.

	  OpsJobs.NewCache() -> Cache
	  OpsJobs.Merge(cache, payload, now) -> boolean       OpsState: Full replaces the site cache, a delta merges into
	                                                        it, State "Off" drops a site; Carrying / Bags every payload
	  OpsJobs.AddPing(cache, payload, now, userId) -> bool OpsPing {U, X, Z}: a carrier seen now (never the local player)
	  OpsJobs.Rows(cache, me, trackedId, userId, now?) -> { Row }   at most Ui.Jobs.Rows (3):
	      1. the carried job (GO = your own Home) or the tracked job
	      2. the nearest open job to `me` (the caller passes Home while the player stands in their own plot)
	      3. somebody else's dropped / pinged bag ("Steal the Bag"), else the bank if it is open, else the next-nearest
	         open job; when nothing else is open the bank still fills the row with its countdown
	    A row never offers GO to a Quiet, Closed, Held or on-your-cooldown site (only the bank is listed then, with its
	    countdown and no GO).
	  OpsJobs.GoFor(cache, id, me, userId, now) -> Point?  the CURRENT point of a tracked id: a site's Target anchor, your
	                                                        own Home ("@home") or a bag / carrier ("@bag:<UserId>")
	  OpsJobs.NearestLike(cache, id, me, now) -> string?   the nearest open site with the same job Title (GO re-resolves
	                                                        there when the tracked site closes under you)
	  OpsJobs.Sub(site, def, distStuds, now?) -> string    "OPEN · 620m · $36K" / "RAID ON" / "CLOSED 4:10" /
	                                                        "YOURS IN 7:30" / "HELD" (OpsConfig.Text.Row)

	Every GO point is per player: the nearest valid site, your own plot's Home, or the last position of a bag. Never a
	fixed world marker. Points without a height (Home, bags, pings) stand on WorldConfig.Activity.FloorY.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- ships with the place (Rojo); bounded wait anyway
local OpsConfig = require(Shared.Configs.OpsConfig)
local WorldConfig = require(Shared.Configs.WorldConfig)

local OpsJobs = {}

export type Point = { Short: string, X: number, Y: number, Z: number }
export type Row = {
	Id: string, -- a site id, OpsJobs.HomeId or "@bag:<UserId>"
	Title: string,
	Sub: string,
	Hard: boolean,
	Go: Point?, -- nil = no GO (a closed bank row); a Tracked row shows STOP instead
	Tracked: boolean,
	Steal: boolean?,
	Kind: string, -- an OpsConfig.Kinds key, or "Steal" / "Home"
	Dist: number?, -- studs from `me` (XZ)
}
export type SiteEntry = {
	Id: string,
	State: string,
	X: number?,
	Y: number?,
	Z: number?,
	Left: number?,
	Pay: number?,
	MyCd: number?,
	Guards: number?,
	HeldBy: number?,
	At: number, -- `now` when Left / MyCd arrived (they are seconds left at that moment)
}
export type PingEntry = { X: number, Z: number, At: number }
export type Cache = {
	Sites: { [string]: SiteEntry },
	Home: { X: number, Z: number }?,
	Carrying: OpsConfig.OpsCarrySnap?,
	CarryAt: number,
	Bags: { OpsConfig.OpsBagSnap },
	Pings: { [number]: PingEntry },
	Full: boolean, -- a Full snapshot has arrived (before it, the board shows nothing)
	Version: number, -- bumps on every accepted payload / ping (the board rebuilds only when it changed)
}
export type Me = { X: number, Z: number }

local TEXT = OpsConfig.Text
local ROW = TEXT.Row
local UI = OpsConfig.Ui
local MAX_ROWS = math.max(1, UI.Jobs.Rows)
local FLOOR_Y = WorldConfig.Activity.FloorY
local SEP = " · "
local OPEN_STATES: { [string]: boolean } = { Dormant = true, Open = true, Active = true }
local MAX_SITES = 64 -- a payload never carries more (32 sites today); junk beyond is ignored
local MAX_BAGS = 8

-- Fields lane O may add to OpsConfig (pending edit, buildB/U/pending_edits.md); read defensively so this works before
local ROW_ANY: any = ROW
local UI_ANY: any = UI
OpsJobs.HomeShort = if type(ROW_ANY.HomeShort) == "string" then ROW_ANY.HomeShort else "BASE"
local STEAL_SUB: string? = if type(ROW_ANY.Steal) == "string" then ROW_ANY.Steal else nil -- "BAG · %s" (distance)
OpsJobs.EmptyText = if type(ROW_ANY.Empty) == "string" then ROW_ANY.Empty else nil
OpsJobs.PingTtl = if type(UI_ANY.PingTtlSeconds) == "number" then UI_ANY.PingTtlSeconds else OpsConfig.Remote.PingSeconds * 2.5

OpsJobs.HomeId = "@home"
OpsJobs.BagPrefix = "@bag:"

---------------------------------------------------------------------------------------------------------------
-- formatting
---------------------------------------------------------------------------------------------------------------

local function finite(n: any): boolean
	return type(n) == "number" and n == n and n > -1e7 and n < 1e7
end

--[[ "$36K" / "$1.2M" / "$900" (whole dollars; the JOBS sub-line). ]]
function OpsJobs.Money(n: number): string
	local a = math.abs(n)
	if a >= 1e6 then
		local s = string.format("%.1f", n / 1e6)
		if string.sub(s, -2) == ".0" then
			s = string.sub(s, 1, -3)
		end
		return "$" .. s .. "M"
	elseif a >= 1e3 then
		local s = string.format("%.1f", n / 1e3)
		if string.sub(s, -2) == ".0" then
			s = string.sub(s, 1, -3)
		end
		return "$" .. s .. "K"
	end
	return "$" .. tostring(math.floor(n))
end

--[[ "4:10" (m:ss), "1:02:03" past an hour. ]]
function OpsJobs.Clock(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	if s >= 3600 then
		return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
	end
	return string.format("%d:%02d", s // 60, s % 60)
end

--[[ "95m" under 1 km, "1.2km" above (the compass chip's format; 1 stud reads as 1 m). ]]
function OpsJobs.Dist(studs: number): string
	if studs < 1000 then
		return string.format("%dm", math.floor(studs))
	end
	return string.format("%.1fkm", studs / 1000)
end

-- seconds still left of a timer that had `secs` left at `at`
function OpsJobs.Remaining(secs: number?, at: number, now: number?): number
	if secs == nil or not finite(secs) then
		return 0
	end
	if now == nil then
		return math.max(0, secs)
	end
	return math.max(0, secs - math.max(0, now - at))
end
local remaining = OpsJobs.Remaining

local function dropSep(s: string): string
	if string.sub(s, -#SEP) == SEP then
		return string.sub(s, 1, -#SEP - 1)
	end
	return s
end

--[[ The JOBS row sub-line for one site (OpsConfig.Text.Row). distStuds < 0 = unknown distance. ]]
function OpsJobs.Sub(site: SiteEntry, def: OpsConfig.SiteDef, distStuds: number, now: number?): string
	local at = site.At or 0
	local mine = remaining(site.MyCd, at, now)
	if mine > 0 then
		return string.format(ROW.Mine, OpsJobs.Clock(mine))
	end
	local st = site.State
	if st == "Cooling" or st == "Closed" then
		local left = remaining(site.Left, at, now)
		if left > 0 then
			return string.format(ROW.Closed, OpsJobs.Clock(left))
		end
		return TEXT.LabelSub.Closed
	elseif st == "Held" then
		return ROW.Held
	elseif st == "Quiet" then
		return TEXT.LabelSub.Quiet
	elseif st == "Active" then
		return ROW.Active
	end
	local d = if distStuds >= 0 then OpsJobs.Dist(distStuds) else ""
	local pay = if site.Pay ~= nil and finite(site.Pay) and site.Pay > 0 then OpsJobs.Money(site.Pay) else ""
	local s = string.format(ROW.Open, d, pay)
	s = string.gsub(s, SEP .. SEP, SEP) -- no distance: "OPEN · $36K", never "OPEN ·  · $36K"
	s = dropSep(s)
	if d == "" then
		s = dropSep(s)
	end
	return s
end

---------------------------------------------------------------------------------------------------------------
-- cache
---------------------------------------------------------------------------------------------------------------

function OpsJobs.NewCache(): Cache
	return {
		Sites = {},
		Home = nil,
		Carrying = nil,
		CarryAt = 0,
		Bags = {},
		Pings = {},
		Full = false,
		Version = 0,
	}
end

local function num(v: any): number?
	if finite(v) then
		return v
	end
	return nil
end

--[[ Merge one OpsState payload (shape checked field by field: a client never trusts a payload's shape). Unknown
	site ids (not in OpsConfig) are ignored. false = rejected (not a table / no Sites list). ]]
function OpsJobs.Merge(cache: Cache, payload: any, now: number): boolean
	if type(payload) ~= "table" or type(payload.Sites) ~= "table" then
		return false
	end
	local full = payload.Full == true
	if full then
		cache.Sites = {}
		cache.Full = true
		local h = payload.Home
		if type(h) == "table" and finite(h.X) and finite(h.Z) then
			cache.Home = { X = h.X, Z = h.Z }
		end
	end
	local sites = cache.Sites
	for i, s in ipairs(payload.Sites) do
		if i > MAX_SITES then
			break
		end
		if type(s) == "table" and type(s.Id) == "string" and type(s.State) == "string" and OpsConfig.Get(s.Id) ~= nil then
			if s.State == "Off" then
				sites[s.Id] = nil
			else
				local old = sites[s.Id]
				local e: SiteEntry = {
					Id = s.Id,
					State = s.State,
					X = num(s.X) or (old and old.X),
					Y = num(s.Y) or (old and old.Y),
					Z = num(s.Z) or (old and old.Z),
					Left = num(s.Left),
					Pay = num(s.Pay),
					MyCd = num(s.MyCd),
					Guards = num(s.Guards),
					HeldBy = num(s.HeldBy),
					At = now,
				}
				sites[s.Id] = e
			end
		end
	end
	-- Carrying and Bags ride on EVERY payload (nil Carrying = not carrying)
	local c = payload.Carrying
	if type(c) == "table" and type(c.Site) == "string" and finite(c.Left) then
		cache.Carrying = {
			Site = c.Site,
			Kind = if type(c.Kind) == "string" then c.Kind else "",
			Value = num(c.Value) or 0,
			Left = c.Left,
			Picked = c.Picked == true,
		}
		cache.CarryAt = now
	else
		cache.Carrying = nil
	end
	local bags: { OpsConfig.OpsBagSnap } = {}
	if type(payload.Bags) == "table" then
		for i, b in ipairs(payload.Bags) do
			if i > MAX_BAGS then
				break
			end
			if type(b) == "table" and finite(b.U) and finite(b.X) and finite(b.Z) then
				table.insert(bags, {
					U = b.U,
					X = b.X,
					Z = b.Z,
					Age = num(b.Age) or 0,
					Site = if type(b.Site) == "string" then b.Site else "",
				})
			end
		end
	end
	cache.Bags = bags
	cache.Version += 1
	return true
end

--[[ One OpsPing (a bag carrier's position; the server sends it only to non-allies). Old pings expire after PingTtl. ]]
function OpsJobs.AddPing(cache: Cache, payload: any, now: number, userId: number): boolean
	if type(payload) ~= "table" or not (finite(payload.U) and finite(payload.X) and finite(payload.Z)) then
		return false
	end
	if payload.U == userId then
		return false
	end
	for u, p in pairs(cache.Pings) do
		if now - p.At > OpsJobs.PingTtl then
			cache.Pings[u] = nil
		end
	end
	cache.Pings[payload.U] = { X = payload.X, Z = payload.Z, At = now }
	cache.Version += 1
	return true
end

--[[ Drop pings older than PingTtl; true when one went (the board changes). ]]
function OpsJobs.ExpirePings(cache: Cache, now: number): boolean
	local any = false
	for u, p in pairs(cache.Pings) do
		if now - p.At > OpsJobs.PingTtl then
			cache.Pings[u] = nil
			any = true
		end
	end
	if any then
		cache.Version += 1
	end
	return any
end

---------------------------------------------------------------------------------------------------------------
-- resolving
---------------------------------------------------------------------------------------------------------------

--[[ A job you can go and do now: open (Dormant / Open / Active: RAID ON may be joined), not on your own cooldown and
	with a known point. Held / Cooling / Closed / Quiet never are. ]]
function OpsJobs.Available(e: SiteEntry, now: number?): boolean
	return OPEN_STATES[e.State] == true and remaining(e.MyCd, e.At, now) <= 0 and e.X ~= nil and e.Z ~= nil
end
local available = OpsJobs.Available

local function dist2(me: Me?, x: number, z: number): number
	if me == nil then
		return 0
	end
	local dx, dz = x - me.X, z - me.Z
	return dx * dx + dz * dz
end

function OpsJobs.SiteGo(e: SiteEntry, def: OpsConfig.SiteDef): Point?
	if e.X == nil or e.Z == nil then
		return nil
	end
	return { Short = def.Short, X = e.X :: number, Y = e.Y or FLOOR_Y, Z = e.Z :: number }
end

--[[ Your own delivery point (server: your plot's centre moved toward the front gate; Pool_Town with no plot). ]]
function OpsJobs.HomeGo(cache: Cache): Point?
	local h = cache.Home
	if h == nil then
		return nil
	end
	return { Short = OpsJobs.HomeShort, X = h.X, Y = FLOOR_Y, Z = h.Z }
end

local function carryShort(siteId: string): string
	local def = OpsConfig.Get(siteId)
	local k = def and OpsConfig.Kinds[def.Kind]
	local label = k and k.CarryLabel
	if type(label) == "string" and string.match(label, "^[A-Z]+$") and #label <= 7 then
		return label
	end
	return "BAG"
end

type Steal = { U: number, X: number, Z: number, Short: string }

-- somebody else's bags: dropped ones (from OpsState) and carriers seen on OpsPing, nearest first
local function steals(cache: Cache, userId: number, me: Me?, now: number?): { Steal }
	local out: { Steal } = {}
	local seen: { [number]: boolean } = {}
	for _, b in ipairs(cache.Bags) do
		if b.U ~= userId and not seen[b.U] then
			seen[b.U] = true
			table.insert(out, { U = b.U, X = b.X, Z = b.Z, Short = carryShort(b.Site) })
		end
	end
	for u, p in pairs(cache.Pings) do
		if u ~= userId and not seen[u] and (now == nil or now - p.At <= OpsJobs.PingTtl) then
			seen[u] = true
			table.insert(out, { U = u, X = p.X, Z = p.Z, Short = "BAG" })
		end
	end
	table.sort(out, function(a: Steal, b: Steal): boolean
		local da, db = dist2(me, a.X, a.Z), dist2(me, b.X, b.Z)
		if da ~= db then
			return da < db
		end
		return a.U < b.U
	end)
	return out
end

--[[ The current point of a tracked id (nil = it is gone / not available now). ]]
function OpsJobs.GoFor(cache: Cache, id: string, me: Me?, userId: number, now: number?): Point?
	if id == OpsJobs.HomeId then
		if cache.Carrying == nil then
			return nil
		end
		return OpsJobs.HomeGo(cache)
	end
	if string.sub(id, 1, #OpsJobs.BagPrefix) == OpsJobs.BagPrefix then
		local u = tonumber(string.sub(id, #OpsJobs.BagPrefix + 1))
		if u == nil then
			return nil
		end
		for _, s in ipairs(steals(cache, userId, me, now)) do
			if s.U == u then
				return { Short = s.Short, X = s.X, Y = FLOOR_Y, Z = s.Z }
			end
		end
		return nil
	end
	local e = cache.Sites[id]
	local def = OpsConfig.Get(id)
	if e == nil or def == nil or not available(e, now) then
		return nil
	end
	return OpsJobs.SiteGo(e, def)
end

--[[ The nearest OTHER open site doing the same job (same Title: "Take Checkpoint" at any of the 12 posts). ]]
function OpsJobs.NearestLike(cache: Cache, id: string, me: Me?, now: number?): string?
	local def = OpsConfig.Get(id)
	if def == nil then
		return nil
	end
	local best: string? = nil
	local bestD = math.huge
	for sid, e in pairs(cache.Sites) do
		if sid ~= id and available(e, now) then
			local d2 = OpsConfig.Get(sid)
			if d2 and d2.Title == def.Title then
				local d = dist2(me, e.X :: number, e.Z :: number)
				if d < bestD or (d == bestD and best ~= nil and sid < best) then
					best, bestD = sid, d
				end
			end
		end
	end
	return best
end

local function siteRow(e: SiteEntry, def: OpsConfig.SiteDef, me: Me?, trackedId: string?, now: number?): Row
	local d = if me and e.X and e.Z then math.sqrt(dist2(me, e.X :: number, e.Z :: number)) else -1
	return {
		Id = e.Id,
		Title = def.Title,
		Sub = OpsJobs.Sub(e, def, d, now),
		Hard = def.Hard,
		Go = if available(e, now) then OpsJobs.SiteGo(e, def) else nil,
		Tracked = trackedId == e.Id,
		Kind = def.Kind,
		Dist = if d >= 0 then d else nil,
	}
end

local function stealRow(s: Steal, me: Me?, trackedId: string?): Row
	local id = OpsJobs.BagPrefix .. tostring(s.U)
	local d = if me then math.sqrt(dist2(me, s.X, s.Z)) else -1
	local dt = if d >= 0 then OpsJobs.Dist(d) else ""
	return {
		Id = id,
		Title = ROW.StealTitle,
		Sub = if STEAL_SUB then string.format(STEAL_SUB, dt) else dt,
		Hard = true,
		Go = { Short = s.Short, X = s.X, Y = FLOOR_Y, Z = s.Z },
		Tracked = trackedId == id,
		Steal = true,
		Kind = "Steal",
		Dist = if d >= 0 then d else nil,
	}
end

type Cand = { E: SiteEntry, Def: OpsConfig.SiteDef, D: number }

--[[ The JOBS rows (at most Ui.Jobs.Rows). `me`: where distances are measured from (nil: unknown). ]]
function OpsJobs.Rows(cache: Cache, me: Me?, trackedId: string?, userId: number, now: number?): { Row }
	local rows: { Row } = {}
	if not cache.Full then
		return rows
	end
	local used: { [string]: boolean } = {}

	-- open sites, nearest first (ties by id: stable)
	local open: { Cand } = {}
	local bank: Cand? = nil
	for id, e in pairs(cache.Sites) do
		local def = OpsConfig.Get(id)
		if def then
			local d = if e.X and e.Z then dist2(me, e.X :: number, e.Z :: number) else math.huge
			if def.Pinned == true then
				bank = { E = e, Def = def, D = d }
			end
			if available(e, now) then
				table.insert(open, { E = e, Def = def, D = d })
			end
		end
	end
	table.sort(open, function(a: Cand, b: Cand): boolean
		if a.D ~= b.D then
			return a.D < b.D
		end
		return a.E.Id < b.E.Id
	end)

	-- 1. the carried job (GO = your own Home) or the tracked job
	local carry = cache.Carrying
	if carry then
		local def = OpsConfig.Get(carry.Site)
		local h = cache.Home
		local d = if me and h then math.sqrt(dist2(me, h.X, h.Z)) else -1
		local left = remaining(carry.Left, cache.CarryAt, now)
		table.insert(rows, {
			Id = OpsJobs.HomeId,
			Title = if def then def.Title else TEXT.Card.Carry,
			Sub = string.format(TEXT.Card.CarryHint, OpsJobs.Clock(left)),
			Hard = if def then def.Hard else true,
			Go = OpsJobs.HomeGo(cache),
			Tracked = trackedId == OpsJobs.HomeId,
			Kind = "Home",
			Dist = if d >= 0 then d else nil,
		})
		used[OpsJobs.HomeId] = true
		used[carry.Site] = true
	elseif trackedId ~= nil then
		if string.sub(trackedId, 1, #OpsJobs.BagPrefix) == OpsJobs.BagPrefix then
			for _, s in ipairs(steals(cache, userId, me, now)) do
				if OpsJobs.BagPrefix .. tostring(s.U) == trackedId then
					table.insert(rows, stealRow(s, me, trackedId))
					used[trackedId] = true
					break
				end
			end
		else
			local e = cache.Sites[trackedId]
			local def = OpsConfig.Get(trackedId)
			if e and def then
				table.insert(rows, siteRow(e, def, me, trackedId, now))
				used[trackedId] = true
			end
		end
	end

	-- 2. the nearest open job
	local nextOpen = 1
	local function takeOpen(): Row?
		while nextOpen <= #open do
			local c = open[nextOpen]
			nextOpen += 1
			if not used[c.E.Id] then
				used[c.E.Id] = true
				return siteRow(c.E, c.Def, me, trackedId, now)
			end
		end
		return nil
	end
	-- the bank with its countdown: only when nothing else is open to fill the row
	local function bankCountdown(): Row?
		local b = bank
		if b and not used[b.E.Id] then
			used[b.E.Id] = true
			return siteRow(b.E, b.Def, me, trackedId, now)
		end
		return nil
	end
	if #rows < MAX_ROWS then
		local r = takeOpen()
		if r then
			table.insert(rows, r)
		end
	end

	-- 3. ONE row: somebody else's bag > the open bank > the next-nearest open job > the bank's countdown
	if #rows < MAX_ROWS then
		local r: Row? = nil
		for _, s in ipairs(steals(cache, userId, me, now)) do
			local id = OpsJobs.BagPrefix .. tostring(s.U)
			if not used[id] then
				used[id] = true
				r = stealRow(s, me, trackedId)
				break
			end
		end
		local b = bank
		if r == nil and b and not used[b.E.Id] and available(b.E, now) then
			used[b.E.Id] = true
			r = siteRow(b.E, b.Def, me, trackedId, now)
		end
		if r == nil then
			r = takeOpen() or bankCountdown()
		end
		if r then
			table.insert(rows, r)
		end
	end

	-- no tracked / carried job: the free row is the next-nearest open job
	while #rows < MAX_ROWS do
		local r = takeOpen() or bankCountdown()
		if r == nil then
			break
		end
		table.insert(rows, r)
	end
	return rows
end

return OpsJobs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="229">
            <Properties>
              <string name="Name">PanelShell</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PanelShell — v70 "clean screen" chrome for the full-screen panels and the Army popover (spec §3.8).
	Used by Shop, Rebirth (Progression), Missions, Army, Garage, Settings, Base and the Army popover (Orders).

	  PanelShell.Screen(screen, displayOrder?)   HudLayout.ApplyScreen: Core safe insets + the ONE HUD UIScale
	                                             ("MobileScale", S = 0.70 on phones … 1.15 at 1080p)
	  PanelShell.Attach({Id, Screen, Panel, IsOpen, Close, Dim?, TapCloses?, NonModal?}) -> Shell
	      * HudLayout.RegisterPanel(Id, IsOpen, Close): one panel open at a time → the Modal flag
	      * the black dim behind the panel (UIUtil.MakeModalDim, HudConfig.Context.ModalDim; Active = false).
	        It covers the whole screen width of the gui plus the Roblox topbar row, so the HUD (rail, pill,
	        TopStrip) stays visible but dimmed under the panel. On touch a tap outside the panel closes it.
	      * Dim = false → an invisible tap-catcher instead (the Army popover).
	      * NonModal = true → exclusive with the other panels but no Modal flag (FIRE / hotbar stay up: the popover)
	  shell.Sync(open)        call from the panel's setOpen: dim visibility + HudLayout.PanelOpened / PanelClosed
	  shell.TapThrough()      true for a moment after the dim closed the panel: the same tap then lands on the rail
	                          tile that toggles it, and Toggle must not re-open it
	  PanelShell.Tap(v)       a touch target in v: ≥ TouchMinV() (64 v = 44.8 real px at the phone scale 0.70)
	  PanelShell.Text(v)      a text size in v: ≥ 20 v on touch (14 real px, HudConfig.Scale.MinTextPx) / 16 v on desktop
	  PanelShell.CloseButton(parent, onClose)    ✕ from HudIcons "Close"; 64 v hit on touch, 44 v on desktop

	Nothing here touches a purchase path.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local HudLayout = require(script.Parent.HudLayout)
local HudIcons = require(script.Parent.HudIcons)

local PanelShell = {}

-- 64 v: the rail tile / hotbar slot size, = HudConfig.Scale.TouchMinPx (44) / Scale.Min (0.70) rounded up
local TOUCH_MIN_V = math.max(HudConfig.Hotbar.Slot, math.ceil(HudConfig.Scale.TouchMinPx / HudConfig.Scale.Min))
local DESKTOP_MIN_V = 44
local TEXT_MIN_TOUCH = math.ceil(HudConfig.Scale.MinTextPx / HudConfig.Scale.Min - 1e-6) -- 20 v = 14 px on phones
local TEXT_MIN_DESKTOP = 16 -- 14.4 px at 720p (S 0.90)
local TAP_THROUGH_SECONDS = 0.45

PanelShell.Colors = {
	Panel = Color3.fromRGB(24, 27, 31),
	PanelStroke = Color3.fromRGB(70, 78, 70),
	Row = Color3.fromRGB(34, 38, 44),
	CloseFace = Color3.fromRGB(44, 48, 54),
	Title = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 196, 204),
}

export type Shell = {
	Id: string,
	Dim: Frame,
	Sync: (open: boolean) -> (),
	TapThrough: () -> boolean,
	Refit: () -> (),
}

export type AttachOpts = {
	Id: string, -- HudLayout panel id ("Shop", "Rebirth", "Missions", "Army", "Orders", "Garage", "Settings", "Base")
	Screen: ScreenGui,
	Panel: GuiObject?, -- taps inside it never close the panel
	IsOpen: () -> boolean,
	Close: () -> (),
	Dim: boolean?, -- default true; false = invisible tap-catcher (popover)
	TapCloses: boolean?, -- default: touch only (spec §3.8)
	NonModal: boolean?, -- default false; true = no Modal flag while open (HudLayout.RegisterPanel NonModal)
}

function PanelShell.IsTouch(): boolean
	return HudLayout.IsTouch()
end

function PanelShell.TouchMinV(): number
	return if HudLayout.IsTouch() then TOUCH_MIN_V else DESKTOP_MIN_V
end

--[[ A tappable's size in v: at least TouchMinV(). ]]
function PanelShell.Tap(v: number): number
	return math.max(v, PanelShell.TouchMinV())
end

--[[ A text size in v that renders ≥ HudConfig.Scale.MinTextPx (14) real px at the smallest HUD scale on touch
	(20 v at 0.70) and on a 720p desktop (16 v at 0.90). ]]
function PanelShell.Text(v: number): number
	return math.max(v, if HudLayout.IsTouch() then TEXT_MIN_TOUCH else TEXT_MIN_DESKTOP)
end

--[[ The only way a panel ScreenGui is set up (HudLayout.ApplyScreen, Core insets, DisplayOrder Panels = 60). ]]
function PanelShell.Screen(screen: ScreenGui, displayOrder: number?): UIScale?
	return HudLayout.ApplyScreen(screen, {
		DisplayOrder = displayOrder or HudConfig.DisplayOrder.Panels,
		Insets = "Core",
	})
end

-- the dim covers the gui's safe area plus the Roblox topbar row above it (the notch bands are clipped by
-- ClipToDeviceSafeArea anyway). Offsets are in v (the gui's UIScale), Scale parts track the real screen.
local function fitDim(screen: ScreenGui, dim: Frame)
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.zero
	local abs = screen.AbsoluteSize
	if vp.Y < 2 or abs.Y < 2 then
		return -- not laid out yet: keep MakeModalDim's oversize
	end
	local s = HudLayout.Scale()
	if s <= 0 then
		s = 1
	end
	local top = math.max(0, vp.Y - abs.Y) / s
	dim.AnchorPoint = Vector2.zero
	dim.Position = UDim2.fromOffset(0, -top)
	dim.Size = UDim2.new(1, 0, 1, top)
end

--[[ Register the panel with HudLayout and add its dim. Call once in Init, after the ScreenGui is parented. ]]
function PanelShell.Attach(o: AttachOpts): Shell
	local closedByTapAt = -math.huge
	local dim = UIUtil.MakeModalDim(o.Screen, function()
		local closes = if o.TapCloses == nil then HudLayout.IsTouch() else o.TapCloses == true
		if not closes then
			return
		end
		local ok, open = pcall(o.IsOpen)
		if not (ok and open == true) then
			return
		end
		closedByTapAt = os.clock()
		o.Close()
	end, o.Panel)
	dim.Visible = false
	if o.Dim == false then
		dim.BackgroundTransparency = 1
	end
	local function refit()
		fitDim(o.Screen, dim)
	end
	refit()
	HudLayout.LayoutChanged:Connect(refit)
	o.Screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)

	HudLayout.RegisterPanel(o.Id, o.IsOpen, o.Close, { NonModal = o.NonModal == true })

	local shell: Shell = {
		Id = o.Id,
		Dim = dim,
		Sync = function(open: boolean)
			dim.Visible = open
			if open then
				refit()
				HudLayout.PanelOpened(o.Id)
			else
				HudLayout.PanelClosed(o.Id)
			end
		end,
		TapThrough = function(): boolean
			return os.clock() - closedByTapAt < TAP_THROUGH_SECONDS
		end,
		Refit = refit,
	}
	return shell
end

export type CloseOpts = {
	Position: UDim2?,
	AnchorPoint: Vector2?,
	ZIndex: number?,
	Face: Color3?,
}

--[[ ✕ close button: a transparent TouchMinV() square hit area around a rounded face with the HudIcons "Close".
	Default placement: the parent's top-right corner (AnchorPoint (1, 0), Position (1, -4, 0, 4)). ]]
function PanelShell.CloseButton(parent: Instance, onClose: () -> (), opts: CloseOpts?): TextButton
	local o: CloseOpts = opts or {}
	local hit = PanelShell.TouchMinV()
	local z = o.ZIndex or 5
	local btn = Instance.new("TextButton")
	btn.Name = "Close"
	btn.AnchorPoint = o.AnchorPoint or Vector2.new(1, 0)
	btn.Position = o.Position or UDim2.new(1, -4, 0, 4)
	btn.Size = UDim2.fromOffset(hit, hit)
	btn.BackgroundTransparency = 1
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.Active = true
	btn.ZIndex = z
	local faceColor = o.Face or PanelShell.Colors.CloseFace
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromScale(0.66, 0.66)
	face.BackgroundColor3 = faceColor
	face.BorderSizePixel = 0
	face.Active = false
	face.ZIndex = z
	face.Parent = btn
	UIUtil.Corner(face, 10)
	local st = UIUtil.Stroke(face, Color3.fromRGB(255, 255, 255), 1.5)
	st.Transparency = 0.7
	HudIcons.Make("Close", face, {
		Size = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = z + 1,
		Color = Color3.fromRGB(255, 255, 255),
		Fill = faceColor,
	})
	btn.Activated:Connect(onClose)
	btn.Parent = parent
	return btn
end

--[[ Title label in the HUD's display font (FredokaOne) with the Ink outline. ]]
function PanelShell.Title(parent: Instance, text: string, size: number?): TextLabel
	local ts = PanelShell.Text(size or 24)
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.BackgroundTransparency = 1
	t.Font = HudConfig.Fonts.Display
	t.TextSize = ts
	t.TextColor3 = PanelShell.Colors.Title
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.Text = text
	t.Size = UDim2.new(1, -(PanelShell.TouchMinV() + 24), 0, ts + 8)
	t.Position = UDim2.fromOffset(16, 10)
	t.Parent = parent
	UIUtil.TextOutline(t, 1.5)
	return t
end

return PanelShell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="230">
            <Properties>
              <string name="Name">ProducerLabels</string>
              <string name="Source"><![CDATA[--!strict
--[[
	F4 (owner's 11 features, lane G): ONE small owner-only floating label over the nearest of the player's own
	producers: the Training Yard "+$40" / "every 5s" and each plot oil pump "+$18" / "every 5s". Client-only: nobody
	else sees it, and the server makes no billboard for it (SoldierService / PlotOilPumpService pops are gone with F4).

	Numbers: the yard shows the server-stamped WE_TickTraining (the last training grant, multipliers in; EconomyService
	writes it only on change and only while EconomyConfig.ProducerLabels.Enabled); a pump shows
	PlotOilPumpConfig.CashPerTick (plot oil is paid without multipliers). The sub line reads the tick seconds from
	config (SoldierConfig.TrainingIncome.TickSeconds / PlotOilPumpConfig.TickSeconds). Display only.
	Anchors: cached from the OWN plot only (Workspace.WarEmpireSetup.Bases.Plot<n>): TrainingYard.YardPad and the
	PrimaryPart of each WE_PlotOilPumps model. FindFirstChild with nil checks, ChildAdded / ChildRemoved on those
	folders, and a retry every second while a part is not streamed in; no whole-tree scan, no unbounded wait.
	The own plot id is BaseStateUpdate / PlayerStateUpdate PlotId, else the plot holding the server-stamped WE_AtmPos /
	WE_ConsolePos_CommandCenter.
	Pick: EconomyConfig.ProducerLabels.ScanHz times a second (one Heartbeat accumulator), the nearest anchor within
	RadiusStuds of the character (the yard only while it pays: no soldiers, no yard label). Only the Adornee moves; the
	text is written only when it changes. A pulse (UIScale 1 -> 1.15 -> 1 over PulseSeconds, one reused tween) plays on
	each income tick (WE_PassiveTick / WE_TickTraining, or every tick seconds when neither arrives).
	Hidden: Driving, Dead or Modal (HudLayout flags), nothing within RadiusStuds, or the yard without training income.
	"Training income" = the last SoldierStateUpdate / PlayerStateUpdate TrainingIncomePerTick > 0 (WE_TickTraining
	keeps the last grant after the soldiers are dismissed: the server writes it only on a grant), and WE_TickTraining
	> 0; before any push reports it, WE_TickTraining > 0 alone.
	The label: WorldLabel.Create (Name "WE_ProducerLabel", TextSize 18 / sub 14, 6 x 1.6 studs, 4.5 studs up,
	MaxDistance 24, never drawn over walls), tagged as a base label so the LabelGovernor counts it; shown / hidden with
	WorldLabel.SetShown. Off (Init returns at once) while EconomyConfig.ProducerLabels.Enabled is false.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- Bootstrap already waited for it; bounded anyway
local Constants = require(Shared.Constants)
local Remotes = require(Shared.Remotes)
local BaseConfig = require(Shared.Configs.BaseConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local PlotOilPumpConfig = require(Shared.Configs.PlotOilPumpConfig)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local TycoonMath = require(Shared.Util.TycoonMath)
local PlotFrame = require(Shared.Util.PlotFrame)
local WorldLabel = require(Shared.Util.WorldLabel)

local HudLayout = require(script.Parent.HudLayout)

local ProducerLabels = {}

local CFG = EconomyConfig.ProducerLabels
local LABEL_NAME = "WE_ProducerLabel"
local FOLDER_NAME = "WE_ProducerLabelLocal"
local LABEL_STUDS = Vector2.new(6, 1.6)
local LABEL_OFFSET = Vector3.new(0, 4.5, 0)
local PULSE_SCALE = 1.15
local RETRY_SECONDS = 1 -- a producer part not streamed in yet: look again this often
local HIDE_FLAGS = { "Driving", "Dead", "Modal" }
local KIND_YARD = 1
local KIND_PUMP = 2
local YARD_SECONDS = math.max(1, math.floor((SoldierConfig.TrainingIncome :: any).TickSeconds or 5))
local PUMP_SECONDS = math.max(1, math.floor(PlotOilPumpConfig.TickSeconds or 5))
local PUMP_FOLDER = PlotOilPumpConfig.FolderName or "WE_PlotOilPumps"
local HALF_PAD = BaseConfig.PlotSize.X * 0.5
-- server-stamped world positions on the own plot (the plot id when no state push has named it yet)
local PLOT_HINT_ATTRS = { "WE_AtmPos", "WE_ConsolePos_CommandCenter" }

local player = Players.LocalPlayer
local started = false

local plotId: number? = nil
local plotName = "" -- "Plot<n>" (built once per plot change)
-- anchors: dense parallel arrays, rebuilt only when a watched folder changes or a part is still missing
local anchorPart: { BasePart } = {}
local anchorKind: { number } = {}
local anchorN = 0
local anchorsDirty = true
local anchorsIncomplete = false
local retryAt = 0
local watched: { [Instance]: boolean } = setmetatable({} :: any, { __mode = "k" })

local gui: BillboardGui? = nil
local pulseTween: Tween? = nil
local shownKind = 0
local shownAmount = -1
local visible = false
local trainingPays: boolean? = nil -- last pushed TrainingIncomePerTick > 0 (nil = no push seen yet)
local lastServerTickAt = -math.huge
local lastPulseAt = -math.huge

-- ── pure helpers (tests call these) ───────────────────────────────────────────────────────────────────────────

-- ("+$40", "every 5s") for 40 every 5 seconds
function ProducerLabels.Text(amount: number, seconds: number): (string, string)
	local n = tonumber(amount) or 0
	if n ~= n then
		n = 0
	end
	local secs = math.max(1, math.floor((tonumber(seconds) or 5) + 0.5))
	return "+" .. TycoonMath.ShortCash(n), string.format("every %ds", secs)
end

--[[ The nearest of parts[1..n] within `radius` studs of `pos` (kinds[i] == KIND_YARD is skipped unless yardOn), or
	nil. A part that left the world is skipped. Pure. ]]
function ProducerLabels.Pick(parts: { BasePart }, kinds: { number }, n: number, pos: Vector3, radius: number, yardOn: boolean): number?
	local best: number? = nil
	local bestD2 = radius * radius
	for i = 1, n do
		local p = parts[i]
		if (kinds[i] ~= KIND_YARD or yardOn) and p.Parent ~= nil then
			local a = p.Position
			local dx, dy, dz = a.X - pos.X, a.Y - pos.Y, a.Z - pos.Z
			local d2 = dx * dx + dy * dy + dz * dz
			if d2 <= bestD2 then
				best, bestD2 = i, d2
			end
		end
	end
	return best
end

ProducerLabels.KindYard = KIND_YARD
ProducerLabels.KindPump = KIND_PUMP

-- ── own plot ──────────────────────────────────────────────────────────────────────────────────────────────────

local function plotAt(pos: Vector3): number?
	local half = HALF_PAD + 24
	for id = 1, BaseConfig.MaxPlots do
		local pp = PlotFrame.PlotPosition(id)
		if pp ~= nil then
			local l = PlotFrame.PlotCFrame(pp):PointToObjectSpace(pos)
			if math.abs(l.X) <= half and math.abs(l.Z) <= half then
				return id
			end
		end
	end
	return nil
end

local function setPlot(id: number?)
	if id == plotId then
		return
	end
	plotId = id
	plotName = if id ~= nil then "Plot" .. tostring(id) else ""
	anchorsDirty = true
end

local function ownPlot(): number?
	if plotId == nil then
		for _, name in ipairs(PLOT_HINT_ATTRS) do
			local v = player:GetAttribute(name)
			if typeof(v) == "Vector3" then
				local id = plotAt(v)
				if id ~= nil then
					setPlot(id)
					break
				end
			end
		end
	end
	return plotId
end

-- ── anchors ───────────────────────────────────────────────────────────────────────────────────────────────────

local function markDirty()
	anchorsDirty = true
end

-- ChildAdded / ChildRemoved on a producer folder -> rebuild the anchors (once per folder instance)
local function watch(container: Instance)
	if watched[container] then
		return
	end
	watched[container] = true
	container.ChildAdded:Connect(markDirty)
	container.ChildRemoved:Connect(markDirty)
end

local function addAnchor(part: Instance?, kind: number)
	if part ~= nil and part:IsA("BasePart") then
		anchorN += 1
		anchorPart[anchorN] = part
		anchorKind[anchorN] = kind
	end
end

local function collect()
	anchorsDirty = false
	anchorsIncomplete = false
	for i = anchorN, 1, -1 do
		anchorPart[i] = nil :: any
		anchorKind[i] = nil :: any
	end
	anchorN = 0
	local pid = ownPlot()
	if pid == nil then
		anchorsIncomplete = true
		return
	end
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = if setup then setup:FindFirstChild("Bases") else nil
	local plot = if bases then bases:FindFirstChild(plotName) else nil
	if plot == nil then
		anchorsIncomplete = true
		return
	end
	watch(plot)
	local yard = plot:FindFirstChild("TrainingYard")
	if yard ~= nil then
		watch(yard)
		local pad = yard:FindFirstChild("YardPad")
		if pad == nil then
			anchorsIncomplete = true -- the yard pad has not streamed in yet
		end
		addAnchor(pad, KIND_YARD)
	else
		anchorsIncomplete = true
	end
	local pumps = plot:FindFirstChild(PUMP_FOLDER)
	if pumps ~= nil then
		watch(pumps)
		for _, m in ipairs(pumps:GetChildren()) do
			if m:IsA("Model") then
				local pp = m.PrimaryPart
				if pp == nil then
					anchorsIncomplete = true -- this pump's pad has not streamed in yet
				end
				addAnchor(pp, KIND_PUMP)
			end
		end
	end
end

-- ── the label ─────────────────────────────────────────────────────────────────────────────────────────────────

local function localFolder(): Folder
	local f = Workspace:FindFirstChild(FOLDER_NAME)
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = FOLDER_NAME
	nf.Parent = Workspace
	return nf
end

local function ensureLabel(anchor: BasePart): BillboardGui
	local g = gui
	if g ~= nil and g.Parent ~= nil then
		return g
	end
	local title, sub = ProducerLabels.Text(0, YARD_SECONDS)
	local opts: WorldLabel.Options = {
		Name = LABEL_NAME,
		Sub = sub,
		Color = HudConfig.Colors.Positive,
		TextSize = CFG.TextSize,
		Studs = LABEL_STUDS,
		Offset = LABEL_OFFSET,
		MaxDistance = CFG.MaxDistance,
		BaseLabel = true,
		Parent = localFolder(), -- local folder: the label survives its anchor streaming out
	}
	local ng = WorldLabel.Create(anchor, title, opts)
	WorldLabel.SetShown(ng, false) -- shown by the scan below once its text is right
	local s = Instance.new("UIScale")
	s.Scale = 1
	s.Parent = ng
	pulseTween = TweenService:Create(s, TweenInfo.new(math.max(0.05, CFG.PulseSeconds * 0.5), Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { Scale = PULSE_SCALE })
	gui = ng
	shownKind = 0
	shownAmount = -1
	visible = false
	return ng
end

local function hide()
	local g = gui
	if g ~= nil and visible then
		visible = false
		WorldLabel.SetShown(g, false)
	end
end

local function pulse()
	local t = pulseTween
	if t ~= nil and visible then
		lastPulseAt = os.clock()
		t:Play()
	end
end

local function trainingAmount(): number
	local v = tonumber(player:GetAttribute("WE_TickTraining"))
	if v == nil or v ~= v or v == math.huge then
		return 0
	end
	return math.max(0, math.floor(v))
end

local function hiddenByFlags(): boolean
	for _, name in ipairs(HIDE_FLAGS) do
		if HudLayout.GetFlag(name) then
			return true
		end
	end
	return false
end

local function scan()
	local now = os.clock()
	if anchorsDirty or (anchorsIncomplete and now >= retryAt) then
		retryAt = now + RETRY_SECONDS
		collect()
	end
	if anchorN == 0 or hiddenByFlags() then
		hide()
		return
	end
	local char = player.Character
	local hrp = if char then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil or not hrp:IsA("BasePart") then
		hide()
		return
	end
	local training = trainingAmount()
	local yardOn = training > 0 and trainingPays ~= false -- no soldiers (dismissed): no yard label
	local i = ProducerLabels.Pick(anchorPart, anchorKind, anchorN, (hrp :: BasePart).Position, CFG.RadiusStuds, yardOn)
	if i == nil then
		hide()
		return
	end
	local anchor = anchorPart[i]
	local kind = anchorKind[i]
	local amount = if kind == KIND_YARD then training else math.max(0, math.floor(PlotOilPumpConfig.CashPerTick))
	local g = ensureLabel(anchor)
	if g.Adornee ~= anchor then
		g.Adornee = anchor -- only the adornee moves
	end
	if kind ~= shownKind or amount ~= shownAmount then
		shownKind, shownAmount = kind, amount
		local title, sub = ProducerLabels.Text(amount, if kind == KIND_YARD then YARD_SECONDS else PUMP_SECONDS)
		WorldLabel.SetText(g, title, sub)
	end
	if not visible then
		visible = true
		WorldLabel.SetShown(g, true)
	end
	-- no server tick seen for two ticks (businesses off): pulse on the local clock instead
	if now - lastServerTickAt > 2 * YARD_SECONDS and now - lastPulseAt >= YARD_SECONDS then
		pulse()
	end
end

-- SoldierStateUpdate / PlayerStateUpdate: does the yard pay right now (pre-multiplier training $ per tick)?
local function applyTraining(perTick: any)
	if typeof(perTick) == "number" then
		trainingPays = perTick > 0
	end
end

local function onServerTick()
	lastServerTickAt = os.clock()
	pulse()
end

-- test / debug: (label shown, title text, anchor count)
function ProducerLabels.State(): (boolean, string, number)
	local g = gui
	local title = if g ~= nil then g:FindFirstChild("Title") else nil
	return visible, (if title and title:IsA("TextLabel") then title.Text else ""), anchorN
end

function ProducerLabels.Scan()
	scan()
end

function ProducerLabels.Init()
	if started or CFG.Enabled ~= true then
		return
	end
	started = true
	Remotes.BindEvent(Constants.RemoteNames.BaseStateUpdate, function(base: any)
		if typeof(base) == "table" and typeof(base.PlotId) == "number" then
			setPlot(base.PlotId)
		end
	end)
	Remotes.BindEvent(Constants.RemoteNames.PlayerStateUpdate, function(state: any)
		if typeof(state) ~= "table" then
			return
		end
		if typeof(state.Base) == "table" and typeof(state.Base.PlotId) == "number" then
			setPlot(state.Base.PlotId)
		end
		applyTraining(state.TrainingIncomePerTick)
	end)
	Remotes.BindEvent(Constants.RemoteNames.SoldierStateUpdate, function(payload: any)
		if typeof(payload) == "table" then
			applyTraining(payload.TrainingIncomePerTick)
		end
	end)
	for _, name in ipairs(PLOT_HINT_ATTRS) do
		player:GetAttributeChangedSignal(name):Connect(markDirty)
	end
	player:GetAttributeChangedSignal("WE_PassiveTick"):Connect(onServerTick)
	player:GetAttributeChangedSignal("WE_TickTraining"):Connect(onServerTick)
	HudLayout.FlagChanged:Connect(function(name: string, on: boolean)
		if on and table.find(HIDE_FLAGS, name) ~= nil then
			hide() -- at once, not on the next scan
		end
	end)
	local period = 1 / math.clamp(CFG.ScanHz, 1, 10) -- <= 10 Hz (CLAUDE.md UI refresh cap)
	local acc = period -- first scan on the first beat
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < period then
			return
		end
		acc = 0 -- reset, never catch up
		scan()
	end)
end

return ProducerLabels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="231">
            <Properties>
              <string name="Name">ProgressPill</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ProgressPill — the v70 top-centre stack "Progress" component (spec §3.4 item 2), shared by every hold / capture
	bar so they all look the same: one dark pill (HudConfig.TopStack.Progress: 320×44 v), GothamBold title on the
	left, FredokaOne value on the right ("62%", "4m"), an 8 v bar along the bottom.

	Users: TerritoryController (capture — land outposts and the v70 naval outposts alike), BankRaidController (vault
	hold). ShopController's ATM raid hold can use it as well.

	  local pill = ProgressPill.Build(screen, "CaptureProgress")          -- Visible = false, centred on X
	  HudLayout.RegisterTopStack("Capture", pill.Frame, HudConfig.TopStack.Order.Progress, { Space = "Hud" })
	  pill.Title.Text = "CAPTURING RADAR HILL"; pill.Value.Text = "62%"; ProgressPill.SetFraction(pill, 0.62)

	The caller owns Visible (or hands it to HudLayout.BindVisibility) and every colour change; HudLayout owns the
	Frame's Position.Y. Sizes are v (the parent gui carries HudLayout's "MobileScale" UIScale).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local HudConfig = require(Shared.Configs.HudConfig)
local UIUtil = require(Shared.Util.UIUtil)

local ProgressPill = {}

export type Pill = {
	Frame: Frame,
	Title: TextLabel,
	Value: TextLabel,
	Track: Frame,
	Fill: Frame,
	Stroke: UIStroke,
}

local CFG = HudConfig.TopStack.Progress
local PAD_X = 12 -- v, title / value / bar inset from the pill's sides
local PAD_TOP = 4 -- v above the title row
local PAD_BOTTOM = 7 -- v under the bar
local VALUE_W = 56 -- v, "100%" / "10m" in the value font
local CORNER = 12

ProgressPill.Colors = {
	Fill = HudConfig.Colors.Positive, -- normal progress (green)
	Contested = CFG.ContestedColor, -- amber: someone else is in the zone
	Warn = HudConfig.Colors.Negative, -- under fire
	Idle = Color3.fromRGB(120, 128, 138), -- cooldown / paused
	Title = HudConfig.Colors.White,
	Value = HudConfig.Colors.Gold,
	Stroke = HudConfig.Colors.PillStroke,
	StrokeTransparency = 0.5,
	Track = Color3.fromRGB(255, 255, 255),
	TrackTransparency = 0.82,
}

--[[ One pill, parented to `parent` (a HUD ScreenGui set up with HudLayout.ApplyScreen). Starts hidden. ]]
function ProgressPill.Build(parent: Instance, name: string): Pill
	local size = CFG.Size
	local textSize = CFG.TextSize

	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Position = UDim2.new(0.5, 0, 0, HudConfig.TopStack.Top) -- Y is rewritten by HudLayout's top stack
	f.Size = UDim2.fromOffset(size.X, size.Y)
	f.BackgroundColor3 = HudConfig.Colors.PillBg
	f.BackgroundTransparency = HudConfig.Colors.PillBgTransparency
	f.BorderSizePixel = 0
	f.Active = false
	f.Visible = false
	f.ZIndex = 2
	UIUtil.Corner(f, CORNER)
	local stroke = UIUtil.Stroke(f, ProgressPill.Colors.Stroke, 2)
	stroke.Transparency = ProgressPill.Colors.StrokeTransparency

	local rowH = textSize + 4
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(PAD_X, PAD_TOP)
	title.Size = UDim2.new(1, -(PAD_X * 2 + VALUE_W), 0, rowH)
	title.Font = HudConfig.Fonts.Body
	title.TextSize = textSize
	title.TextColor3 = ProgressPill.Colors.Title
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = ""
	title.ZIndex = 3
	title.Parent = f

	local value = Instance.new("TextLabel")
	value.Name = "Value"
	value.BackgroundTransparency = 1
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, -PAD_X, 0, PAD_TOP)
	value.Size = UDim2.fromOffset(VALUE_W, rowH)
	value.Font = HudConfig.Fonts.Display
	value.TextSize = textSize + 2
	value.TextColor3 = ProgressPill.Colors.Value
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.TextYAlignment = Enum.TextYAlignment.Center
	value.Text = "0%"
	value.ZIndex = 3
	value.Parent = f

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0, 1)
	track.Position = UDim2.new(0, PAD_X, 1, -PAD_BOTTOM)
	track.Size = UDim2.new(1, -PAD_X * 2, 0, CFG.BarH)
	track.BackgroundColor3 = ProgressPill.Colors.Track
	track.BackgroundTransparency = ProgressPill.Colors.TrackTransparency
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = 3
	track.Parent = f
	UIUtil.Corner(track, math.ceil(CFG.BarH / 2))

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = ProgressPill.Colors.Fill
	fill.BorderSizePixel = 0
	fill.ZIndex = 4
	fill.Parent = track
	UIUtil.Corner(fill, math.ceil(CFG.BarH / 2))

	f.Parent = parent
	return {
		Frame = f,
		Title = title,
		Value = value,
		Track = track,
		Fill = fill,
		Stroke = stroke,
	}
end

--[[ Bar fill 0..1 (NaN / nil → 0). ]]
function ProgressPill.SetFraction(pill: Pill, fraction: number?)
	local f = tonumber(fraction) or 0
	if f ~= f then
		f = 0
	end
	pill.Fill.Size = UDim2.fromScale(math.clamp(f, 0, 1), 1)
end

--[[ "62%" from a 0..1 fraction (floored, like the server's capture %). ]]
function ProgressPill.Percent(fraction: number?): string
	local f = tonumber(fraction) or 0
	if f ~= f then
		f = 0
	end
	return string.format("%d%%", math.floor(math.clamp(f, 0, 1) * 100))
end

--[[ Normal look (stroke back to the dark default). ]]
function ProgressPill.ResetStroke(pill: Pill)
	pill.Stroke.Color = ProgressPill.Colors.Stroke
	pill.Stroke.Transparency = ProgressPill.Colors.StrokeTransparency
end

--[[ Coloured edge (contested amber, under-fire red …). ]]
function ProgressPill.AccentStroke(pill: Pill, color: Color3)
	pill.Stroke.Color = color
	pill.Stroke.Transparency = 0
end

return ProgressPill
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="232">
            <Properties>
              <string name="Name">RebirthConfirm</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RebirthConfirm — the Rebirth confirm modal (owner's 11 features F7 + F11, lane P).

	The Rebirth panel's CONFIRM REBIRTH button opens it; a free rebirth is two presses (open, then REBIRTH).
	  * Two columns side by side, "CASH REBIRTH  FREE" and "KEEP BASE  R$ 50", each listing KEEP / RESET / GAIN from
	    the server's PrestigeStateUpdate.Summary (PrestigeConfig.RebirthSummary, built from the same reset tables
	    PrestigeService applies, so the modal can never promise something the server does not do). Shown RESET, GAIN,
	    KEEP, with the lines only one path has first and highlighted (ColumnRows), so the difference is in view on a phone.
	  * Banner "Keep all your Robux Items!" and a close control (back to the Rebirth panel).
	  * Footer buttons coloured like their columns:
	      REBIRTH           RequestPrestige() — disabled "Lv 40 needed" until the player can rebirth
	      KEEP BASE  R$ 50  saved tokens: "USE SAVED (n)" → RequestPrestige("KeepBase")
	                        product Id 0: "KEEP BASE  SOON", disabled, never prompts
	                        not eligible: "Lv 40 needed", disabled (never sells early)
	                        otherwise: RequestPurchaseDevProduct("RebirthKeepBase", "rebirth_panel") + PromptProductPurchase,
	                        then "REBIRTHING..." until the next PrestigeStateUpdate
	    The server decides everything (eligibility, tokens, the receipt grant, the rebirth); this module only asks.
	    RequestPrestige is fired from this module only.
	Phone first (CLAUDE.md §1): sizes are REAL px converted with the live HUD scale (buttons 196x50, close 48, headers
	16, lines 14; never under PanelShell's 64 v tap / 20 v text floors on touch). The footer buttons sit in the right
	60 % of the safe area and keep 16 px from the Roblox jump button; each column scrolls when it does not fit (800x360).
	A registered HudLayout panel ("RebirthConfirm"): black dim, the Modal flag, one panel at a time. No key names,
	no "click"/"tap" copy.
	Requests go out through deps.Fire (ProgressionController passes its non-blocking Shared/Remotes FireServer wrapper),
	so the headless drivers can record exactly what the modal sends.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local UIUtil = require(Shared.Util.UIUtil)
local HudConfig = require(Shared.Configs.HudConfig)
local PrestigeConfig = require(Shared.Configs.PrestigeConfig)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)

local HudLayout = require(script.Parent.HudLayout)
local PanelShell = require(script.Parent.PanelShell)

local RebirthConfirm = {}

local PANEL_ID = "RebirthConfirm"
local SOURCE = "rebirth_panel" -- MonetizationConfig.PurchaseSources (purchase intent → PrestigeService auto-use)
local CASH_PENDING_SECONDS = 8 -- a rebirth request that got no state push back re-enables the buttons after this
local BUY_SHEET_SECONDS = 120 -- the Robux sheet is open (the player may take a while)
local BUY_RECEIPT_SECONDS = 30 -- the sheet closed with a purchase: wait this long for the receipt's state push

-- real px (CLAUDE.md "size helpers take real px")
local PX = {
	ButtonW = 196,
	ButtonH = 50,
	Close = 48,
	Title = 20,
	Header = 16,
	Line = 14,
	Pad = 10,
	Gap = 8,
	JumpGap = 16, -- CLAUDE.md: nothing within 16 px of the jump button
	Margin = 6,
}
local MAX_W_V = 1000 -- modal size cap in v (tablets / desktops)
local MAX_H_V = 560

local COLORS = {
	Panel = PanelShell.Colors.Panel,
	Column = PanelShell.Colors.Row,
	Cash = Constants.Colors.Cash,
	CashButton = Constants.Colors.Accent,
	Keep = Constants.Colors.GoldBright,
	KeepText = Constants.Colors.TextDark,
	Reset = Color3.fromRGB(255, 130, 120),
	Gain = Constants.Colors.GoldBright,
	Text = Constants.Colors.TextOnDark,
	Muted = PanelShell.Colors.Muted,
	Disabled = Constants.Colors.Gunmetal,
	DisabledText = Color3.fromRGB(176, 184, 194),
	BannerBg = Color3.fromRGB(28, 72, 36),
}

--------------------------------------------------------------------------------------------------------------------
-- view model (pure; the headless drivers call these)
--------------------------------------------------------------------------------------------------------------------

export type View = {
	Ready: boolean, -- the player can rebirth now (level, not maxed, fee)
	Maxed: boolean,
	MinLevel: number,
	Tokens: number, -- saved keep-base rebirths
	Live: boolean, -- the keep-base product can be sold (server KeepBaseLive AND the config Id is not 0)
	Price: number,
	Pending: string?, -- "cash" | "keep" | "buy" while a request is on its way
}

export type ButtonState = {
	Text: string,
	Enabled: boolean,
	Action: string?, -- "cash" | "use" | "buy"
}

local function num(v: any, default: number): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

local function keepBaseDef(): any
	local def = (MonetizationConfig.DevProducts :: any)[PrestigeConfig.KeepBase.ProductKey]
	return if typeof(def) == "table" then def else nil
end

-- the product Id the client may prompt; 0 = never prompt
function RebirthConfirm.KeepBaseProductId(): number
	local def = keepBaseDef()
	return math.floor(num(if def then def.Id else 0, 0))
end

--[[ View from a PrestigeStateUpdate payload. level / xp: the freshest values (XPUpdate), when known. ]]
function RebirthConfirm.ViewOf(state: any, level: number?, pending: string?, attrTokens: number?): View
	local st = if typeof(state) == "table" then state else {}
	local minLevel = math.floor(num(st.MinLevel, PrestigeConfig.MinLevelToPrestige))
	local maxP = num(st.MaxPrestige, PrestigeConfig.MaxPrestige)
	local maxed = typeof(state) == "table" and num(st.Prestige, 0) >= maxP
	local lv = level or num(st.Level, 0)
	local fee = num(st.CashFee, 0)
	local ready = typeof(state) == "table"
		and not maxed
		and lv >= minLevel
		and (fee <= 0 or st.CanPrestige == true)
	-- a state without the level (older payload) falls back to the server's flag
	if typeof(state) == "table" and level == nil and st.Level == nil then
		ready = st.CanPrestige == true and not maxed
	end
	local tokens = math.max(0, math.floor(num(st.KeepBaseTokens, attrTokens or 0)))
	local def = keepBaseDef()
	return {
		Ready = ready == true,
		Maxed = maxed,
		MinLevel = minLevel,
		Tokens = tokens,
		Live = st.KeepBaseLive == true and RebirthConfirm.KeepBaseProductId() ~= 0,
		Price = math.floor(num(st.KeepBasePrice, num(if def then def.RobuxPrice else 50, 50))),
		Pending = pending,
	}
end

function RebirthConfirm.CashButton(v: View): ButtonState
	if v.Pending == "cash" then
		return { Text = "REBIRTHING...", Enabled = false }
	end
	if v.Maxed then
		return { Text = "MAX REBIRTH", Enabled = false }
	end
	if not v.Ready then
		return { Text = string.format("Lv %d needed", v.MinLevel), Enabled = false }
	end
	return { Text = "REBIRTH", Enabled = v.Pending == nil, Action = "cash" }
end

function RebirthConfirm.KeepButton(v: View): ButtonState
	if v.Pending == "keep" or v.Pending == "buy" then
		return { Text = "REBIRTHING...", Enabled = false }
	end
	if v.Maxed then
		return { Text = "MAX REBIRTH", Enabled = false }
	end
	if v.Tokens > 0 then
		if not v.Ready then
			return { Text = string.format("Lv %d needed", v.MinLevel), Enabled = false }
		end
		return { Text = string.format("USE SAVED (%d)", v.Tokens), Enabled = v.Pending == nil, Action = "use" }
	end
	if not v.Live then
		return { Text = "KEEP BASE  SOON", Enabled = false }
	end
	if not v.Ready then
		return { Text = string.format("Lv %d needed", v.MinLevel), Enabled = false }
	end
	return { Text = string.format("KEEP BASE  R$ %d", v.Price), Enabled = v.Pending == nil, Action = "buy" }
end

-- one short status line in the footer (explains a disabled button)
function RebirthConfirm.StatusText(v: View): string
	if v.Maxed then
		return "Max rebirth reached"
	end
	if v.Pending then
		return "Rebirthing..."
	end
	if not v.Ready then
		if v.Tokens > 0 then
			return string.format("Reach Lv %d  %d saved", v.MinLevel, v.Tokens)
		end
		return string.format("Reach Lv %d to rebirth", v.MinLevel)
	end
	if v.Tokens == 1 then
		return "1 Keep-Base Rebirth saved"
	elseif v.Tokens > 1 then
		return string.format("%d Keep-Base Rebirths saved", v.Tokens)
	end
	return "Both give +10% cash forever"
end

export type Row = {
	Text: string,
	Header: boolean, -- a section title (RESET / GAIN / KEEP)
	Section: string, -- "Reset" | "Gain" | "Keep"
	Highlight: boolean, -- a line only this column has (what makes the two paths different)
}

--[[ The rows of one column. Sections run RESET, GAIN, KEEP (what you lose is never below the fold on an 800x360
	phone), and inside a section the lines the OTHER column does not have come first, highlighted: the free
	column opens with "Base buildings (N built)", the keep-base column's KEEP list opens with "Base buildings and
	levels". Every line is the server's (Summary); nothing is added or dropped here. ]]
function RebirthConfirm.ColumnRows(summary: any, other: any): { Row }
	local rows: { Row } = {}
	if typeof(summary) ~= "table" then
		return rows
	end
	for _, key in ipairs({ "Reset", "Gain", "Keep" }) do
		local mine = summary[key]
		if typeof(mine) == "table" and #mine > 0 then
			local theirs: { [string]: boolean } = {}
			local otherLines = if typeof(other) == "table" then other[key] else nil
			if typeof(otherLines) == "table" then
				for _, line in ipairs(otherLines) do
					if typeof(line) == "string" then
						theirs[line] = true
					end
				end
			end
			local diff: { string } = {}
			local same: { string } = {}
			for _, line in ipairs(mine) do
				if typeof(line) == "string" then
					if typeof(other) == "table" and not theirs[line] then
						table.insert(diff, line)
					else
						table.insert(same, line)
					end
				end
			end
			if #diff + #same > 0 then
				table.insert(rows, { Text = string.upper(key), Header = true, Section = key, Highlight = false })
				for _, line in ipairs(diff) do
					table.insert(rows, { Text = line, Header = false, Section = key, Highlight = true })
				end
				for _, line in ipairs(same) do
					table.insert(rows, { Text = line, Header = false, Section = key, Highlight = false })
				end
			end
		end
	end
	return rows
end

function RebirthConfirm.CashTitle(): string
	return "CASH REBIRTH  FREE"
end

function RebirthConfirm.KeepTitle(v: View): string
	return string.format("KEEP BASE  R$ %d", v.Price)
end

--------------------------------------------------------------------------------------------------------------------
-- state
--------------------------------------------------------------------------------------------------------------------

export type OpenOpts = {
	OnBack: (() -> ())?, -- the close control was used (the Rebirth panel re-opens itself)
}

export type Deps = {
	Fire: (remoteName: string, ...any) -> (), -- non-blocking RemoteEvent:FireServer (Shared/Remotes helper)
}

local player = Players.LocalPlayer
local screen: ScreenGui? = nil
local modal: Frame? = nil
local shell: PanelShell.Shell? = nil
local isOpen = false
local openOpts: OpenOpts = {}
local state: any = nil
local liveLevel: number? = nil
local pending: string? = nil
local pendingSerial = 0
local pendingPrestige = -1
local pendingTokens = 0
local buyFinished = false
local relayoutQueued = false
local fireServer: ((string, ...any) -> ())? = nil

-- widgets refreshed in place (rebuilt by layout())
local cashBtn: TextButton? = nil
local keepBtn: TextButton? = nil
local statusLabel: TextLabel? = nil
local keepTitle: TextLabel? = nil
local cashList: ScrollingFrame? = nil
local keepList: ScrollingFrame? = nil
local listsFor: any = nil -- the Summary the two lists were built from (rebuilt only when it changes)

local function attrTokens(): number?
	local ok, v = pcall(function(): any
		return player:GetAttribute("WE_KeepBaseRebirths")
	end)
	return if ok and typeof(v) == "number" then v else nil
end

local function view(): View
	return RebirthConfirm.ViewOf(state, liveLevel, pending, attrTokens())
end

-- real px → v at the live HUD scale
local function scale(): number
	local s = HudLayout.Scale()
	return if s > 0 then s else 1
end
local function v(px: number): number
	return px / scale()
end
local function tapV(px: number): number
	return math.max(PanelShell.TouchMinV(), math.ceil(v(px) - 1e-6))
end
local function textV(px: number): number
	return PanelShell.Text(math.ceil(v(px) - 1e-6))
end

--------------------------------------------------------------------------------------------------------------------
-- layout
--------------------------------------------------------------------------------------------------------------------

local function label(parent: Instance, name: string, text: string, size: number, color: Color3, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.Font = font or Enum.Font.GothamMedium
	t.TextSize = size
	t.TextColor3 = color
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextTruncate = Enum.TextTruncate.AtEnd
	t.Text = text
	t.Parent = parent
	return t
end

local SECTION_COLOR: { [string]: Color3 } = {
	Keep = COLORS.Cash,
	Reset = COLORS.Reset,
	Gain = COLORS.Gain,
}

local function fillList(list: ScrollingFrame?, summary: any, other: any)
	if not list then
		return
	end
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local lineSize = textV(PX.Line)
	local rowH = lineSize + math.ceil(v(6))
	local order = 0
	local function row(text: string, color: Color3, bold: boolean, indent: number)
		order += 1
		local t = label(list, "Line" .. order, text, lineSize, color, if bold then Enum.Font.GothamBold else Enum.Font.GothamMedium)
		t.LayoutOrder = order
		t.Size = UDim2.new(1, -8, 0, rowH)
		if indent > 0 then
			local p = Instance.new("UIPadding")
			p.PaddingLeft = UDim.new(0, indent)
			p.Parent = t
		end
	end
	local rows = RebirthConfirm.ColumnRows(summary, other)
	if #rows == 0 then
		row("Loading...", COLORS.Muted, false, 0)
		return
	end
	local indent = math.ceil(v(8))
	for _, r in ipairs(rows) do
		local color = SECTION_COLOR[r.Section] or COLORS.Text
		if r.Header then
			row(r.Text, color, true, 0)
		elseif r.Highlight then
			row(r.Text, color, true, indent)
		else
			row(r.Text, COLORS.Text, false, indent)
		end
	end
end

local function styleButton(b: TextButton?, st: ButtonState, face: Color3, textColor: Color3, stroke: Color3)
	if not b then
		return
	end
	b.Text = st.Text
	b.BackgroundColor3 = if st.Enabled then face else COLORS.Disabled
	b.TextColor3 = if st.Enabled then textColor else COLORS.DisabledText
	b.AutoButtonColor = st.Enabled
	local s = b:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = stroke
		s.Transparency = if st.Enabled then 0 else 0.45
	end
end

local function refresh()
	if not isOpen then
		return
	end
	local vw = view()
	styleButton(cashBtn, RebirthConfirm.CashButton(vw), COLORS.CashButton, COLORS.Text, COLORS.Cash)
	styleButton(keepBtn, RebirthConfirm.KeepButton(vw), COLORS.Keep, COLORS.KeepText, COLORS.Keep)
	if statusLabel then
		statusLabel.Text = RebirthConfirm.StatusText(vw)
	end
	if keepTitle then
		keepTitle.Text = RebirthConfirm.KeepTitle(vw)
	end
	local summary = if typeof(state) == "table" then state.Summary else nil
	if summary ~= listsFor or summary == nil then
		listsFor = summary
		local cashSum = if typeof(summary) == "table" then summary.Cash else nil
		local keepSum = if typeof(summary) == "table" then summary.KeepBase else nil
		fillList(cashList, cashSum, keepSum)
		fillList(keepList, keepSum, cashSum)
	end
end

local onCash: () -> ()
local onKeep: () -> ()
local closeModal: (reason: string) -> ()

-- the Roblox touch jump button in content-rect real px (x, y, w, h; the HUD harness' model of it); nil off touch
local function jumpRectPx(cw: number, ch: number): { number }?
	if not HudLayout.IsTouch() then
		return nil
	end
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(cw, ch)
	if math.min(vp.X, vp.Y) <= 500 then
		return { cw - 95, ch - 90, 70, 70 }
	end
	return { cw - 170, ch - 210, 120, 120 }
end

local function column(parent: Instance, name: string, x: number, y: number, w: number, h: number, title: string, color: Color3): (TextLabel, ScrollingFrame)
	local col = Instance.new("Frame")
	col.Name = name
	col.Position = UDim2.fromOffset(x, y)
	col.Size = UDim2.fromOffset(w, h)
	col.BackgroundColor3 = COLORS.Column
	col.BorderSizePixel = 0
	col.Parent = parent
	UIUtil.Corner(col, 10)
	local st = UIUtil.Stroke(col, color, 2)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local hs = textV(PX.Header)
	local pad = math.ceil(v(PX.Pad))
	local head = label(col, "Title", title, hs, color, Enum.Font.GothamBold)
	head.Position = UDim2.fromOffset(pad, math.ceil(v(4)))
	head.Size = UDim2.new(1, -2 * pad, 0, hs + math.ceil(v(8)))
	local top = head.Position.Y.Offset + head.Size.Y.Offset
	local list = Instance.new("ScrollingFrame")
	list.Name = "Lines"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(pad, top)
	list.Size = UDim2.new(1, -pad, 1, -(top + math.ceil(v(4))))
	list.ScrollBarThickness = if HudLayout.IsTouch() then 6 else 5
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = col
	local lay = Instance.new("UIListLayout")
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Padding = UDim.new(0, 0)
	lay.Parent = list
	return head, list
end

local function makeButton(parent: Instance, name: string, x: number, y: number, w: number, h: number, cb: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Position = UDim2.fromOffset(x, y)
	b.Size = UDim2.fromOffset(w, h)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamBold
	b.TextSize = textV(PX.Line)
	b.TextTruncate = Enum.TextTruncate.AtEnd
	b.Active = true
	b.Parent = parent
	UIUtil.Corner(b, 10)
	local st = UIUtil.Stroke(b, Color3.new(1, 1, 1), 2)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	b.Activated:Connect(cb)
	return b
end

local function layout()
	local m = modal
	if not m then
		return
	end
	local old = m:FindFirstChild("Content")
	if old then
		old:Destroy()
	end
	cashBtn, keepBtn, statusLabel, keepTitle, cashList, keepList = nil, nil, nil, nil, nil, nil
	listsFor = nil

	local s = scale()
	local contentV = HudLayout.ContentSizeV()
	local cw, ch = contentV.X * s, contentV.Y * s -- content rect, real px
	local margin = math.ceil(v(PX.Margin))
	local W = math.floor(math.min(contentV.X - 2 * margin, MAX_W_V))
	local H = math.floor(math.min(contentV.Y - 2 * margin, MAX_H_V))
	m.Size = UDim2.fromOffset(W, H)
	local mx = (contentV.X - W) / 2 -- modal left / top in content v
	local my = (contentV.Y - H) / 2

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Size = UDim2.fromScale(1, 1)
	content.Parent = m

	local pad = math.ceil(v(PX.Pad))
	local gap = math.ceil(v(PX.Gap))
	local closeV = tapV(PX.Close)

	-- header: title, banner, close
	local titleSize = textV(PX.Title)
	local title = label(content, "Title", "REBIRTH", titleSize, COLORS.Text, HudConfig.Fonts.Display)
	title.Position = UDim2.fromOffset(pad, 4)
	title.Size = UDim2.fromOffset(math.ceil(titleSize * 5.2), closeV)
	title.TextTruncate = Enum.TextTruncate.None
	UIUtil.TextOutline(title, 1.5)

	local bannerSize = textV(PX.Header)
	local bannerText = "Keep all your Robux Items!"
	local bannerW = math.ceil(#bannerText * bannerSize * 0.62) + 2 * pad
	local bannerRoom = W - 2 * (pad + math.ceil(titleSize * 5.2) + gap + closeV)
	local banner = label(content, "KeepRobuxBanner", bannerText, bannerSize, COLORS.Keep, HudConfig.Fonts.Display)
	banner.AnchorPoint = Vector2.new(0.5, 0.5)
	banner.Position = UDim2.new(0.5, 0, 0, 4 + closeV / 2)
	banner.Size = UDim2.fromOffset(math.min(bannerW, math.max(bannerRoom, 120)), bannerSize + 2 * gap)
	banner.TextXAlignment = Enum.TextXAlignment.Center
	banner.BackgroundTransparency = 0.05
	banner.BackgroundColor3 = COLORS.BannerBg
	UIUtil.Corner(banner, 8)
	UIUtil.Stroke(banner, Constants.Colors.Gold, 2).ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	local close = PanelShell.CloseButton(content, function()
		closeModal("back")
	end, { Position = UDim2.new(1, -2, 0, 2), ZIndex = 5 })
	close.Size = UDim2.fromOffset(closeV, closeV)

	-- footer: status (left, text only) + two buttons right-aligned in the right 60 % of the safe area,
	-- clear of the jump button (+16 px)
	local btnH = tapV(PX.ButtonH)
	local wantW = math.max(tapV(PX.ButtonW), PanelShell.TouchMinV())
	local rightLimit = W - pad -- modal v
	local leftLimit = math.max(pad, 0.4 * contentV.X - mx)
	local footerTop = H - pad - btnH
	local jump = jumpRectPx(cw, ch)
	if jump then
		local keepX0 = (jump[1] - PX.JumpGap) / s - mx
		local keepY0 = (jump[2] - PX.JumpGap) / s - my
		local keepY1 = (jump[2] + jump[4] + PX.JumpGap) / s - my
		if footerTop < keepY1 and footerTop + btnH > keepY0 then
			rightLimit = math.min(rightLimit, math.floor(keepX0) - 2)
		end
	end
	local avail = rightLimit - leftLimit
	local bw = math.floor(math.min(wantW, (avail - gap) / 2))
	local minBw = math.max(PanelShell.TouchMinV() * 2, tapV(140))
	local stacked = bw < minBw
	local footerH = btnH
	if stacked then
		-- very narrow (portrait): full-width buttons, one above the other
		bw = math.floor(math.max(minBw, avail))
		footerH = 2 * btnH + gap
		footerTop = H - pad - footerH
	end
	if stacked then
		cashBtn = makeButton(content, "RebirthButton", rightLimit - bw, footerTop, bw, btnH, function()
			onCash()
		end)
		keepBtn = makeButton(content, "KeepBaseButton", rightLimit - bw, footerTop + btnH + gap, bw, btnH, function()
			onKeep()
		end)
	else
		cashBtn = makeButton(content, "RebirthButton", rightLimit - 2 * bw - gap, footerTop, bw, btnH, function()
			onCash()
		end)
		keepBtn = makeButton(content, "KeepBaseButton", rightLimit - bw, footerTop, bw, btnH, function()
			onKeep()
		end)
	end
	local statusW = math.floor((rightLimit - (if stacked then bw else 2 * bw + gap)) - 2 * pad)
	if statusW > 40 then
		local stl = label(content, "Status", "", textV(PX.Line), COLORS.Muted, Enum.Font.GothamBold)
		stl.Position = UDim2.fromOffset(pad, footerTop)
		stl.Size = UDim2.fromOffset(statusW, footerH)
		stl.TextWrapped = true
		stl.TextTruncate = Enum.TextTruncate.None
		statusLabel = stl
	end

	-- columns
	local colY = 4 + closeV + gap
	local colH = footerTop - gap - colY
	local colW = math.floor((W - 3 * pad) / 2)
	local _, cl = column(content, "CashColumn", pad, colY, colW, colH, RebirthConfirm.CashTitle(), COLORS.Cash)
	cashList = cl
	local kt, kl = column(content, "KeepBaseColumn", 2 * pad + colW, colY, colW, colH, RebirthConfirm.KeepTitle(view()), COLORS.Keep)
	keepTitle, keepList = kt, kl

	refresh()
end

--------------------------------------------------------------------------------------------------------------------
-- actions (the server re-checks all of it)
--------------------------------------------------------------------------------------------------------------------

local function send(remoteName: string, ...: any)
	local f = fireServer
	if f then
		f(remoteName, ...)
	else
		warn("[RebirthConfirm] no Fire dependency; request not sent:", remoteName)
	end
end

local function clearPending()
	pendingSerial += 1
	pending = nil
	buyFinished = false
end

-- the request got no answer in time: show the latest state again (the server's toast said why)
local function armTimeout(seconds: number)
	local my = pendingSerial
	task.delay(seconds, function()
		if pendingSerial == my and pending ~= nil then
			clearPending()
			refresh()
		end
	end)
end

local function startPending(kind: string, seconds: number)
	pendingSerial += 1
	pending = kind
	buyFinished = false
	pendingPrestige = if typeof(state) == "table" then num(state.Prestige, 0) else 0
	pendingTokens = RebirthConfirm.ViewOf(state, liveLevel, nil, attrTokens()).Tokens
	armTimeout(seconds)
	refresh()
end

onCash = function()
	local b = RebirthConfirm.CashButton(view())
	if b.Action ~= "cash" or not b.Enabled then
		return
	end
	startPending("cash", CASH_PENDING_SECONDS)
	send(Constants.RemoteNames.RequestPrestige)
end

onKeep = function()
	local b = RebirthConfirm.KeepButton(view())
	if not b.Enabled then
		return
	end
	if b.Action == "use" then
		startPending("keep", CASH_PENDING_SECONDS)
		send(Constants.RemoteNames.RequestPrestige, "KeepBase")
	elseif b.Action == "buy" then
		local id = RebirthConfirm.KeepBaseProductId()
		if id == 0 then
			return -- never prompts while the Id is 0
		end
		startPending("buy", BUY_SHEET_SECONDS)
		-- intent first (the source lets the server use the token right after the receipt is saved)
		send(Constants.RemoteNames.RequestPurchaseDevProduct, PrestigeConfig.KeepBase.ProductKey, SOURCE)
		local ok = pcall(function()
			MarketplaceService:PromptProductPurchase(player, id)
		end)
		if not ok then
			clearPending()
			refresh()
		end
	end
end

closeModal = function(reason: string)
	if not isOpen then
		return
	end
	isOpen = false
	local m = modal
	if m then
		m.Visible = false
	end
	local sh = shell
	if sh then
		sh.Sync(false)
	end
	if reason == "back" then
		local cb = openOpts.OnBack
		if cb then
			task.defer(cb)
		end
	end
end

--------------------------------------------------------------------------------------------------------------------
-- public
--------------------------------------------------------------------------------------------------------------------

function RebirthConfirm.Init(deps: Deps?)
	if deps and typeof(deps.Fire) == "function" then
		fireServer = deps.Fire
	end
	if screen then
		return
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "WarEmpireRebirthConfirm"
	PanelShell.Screen(sg, HudConfig.DisplayOrder.Panels + 1) -- above the Rebirth panel, under the toasts
	sg.Parent = player:WaitForChild("PlayerGui", 30)
	screen = sg

	local m = Instance.new("Frame")
	m.Name = "Modal"
	m.AnchorPoint = Vector2.new(0.5, 0.5)
	m.Position = UDim2.fromScale(0.5, 0.5)
	m.Size = UDim2.fromOffset(600, 360)
	m.BackgroundColor3 = COLORS.Panel
	m.BorderSizePixel = 0
	m.Active = true
	m.Visible = false
	m.ZIndex = 2
	m.Parent = sg
	UIUtil.Corner(m, 14)
	local st = UIUtil.Stroke(m, Constants.Colors.Gold, 2)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	modal = m

	shell = PanelShell.Attach({
		Id = PANEL_ID,
		Screen = sg,
		Panel = m,
		IsOpen = function(): boolean
			return isOpen
		end,
		Close = function()
			closeModal("dismiss")
		end,
	})

	HudLayout.LayoutChanged:Connect(function()
		if not isOpen or relayoutQueued then
			return
		end
		relayoutQueued = true
		task.defer(function()
			relayoutQueued = false
			if isOpen then
				layout()
			end
		end)
	end)

	pcall(function()
		MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, productId: number, isPurchased: boolean)
			local id = RebirthConfirm.KeepBaseProductId()
			if userId ~= player.UserId or id == 0 or productId ~= id or pending ~= "buy" then
				return
			end
			if isPurchased then
				-- the receipt is on its way: keep REBIRTHING... until its state push (or the timeout)
				pendingSerial += 1
				buyFinished = true
				armTimeout(BUY_RECEIPT_SECONDS)
			else
				clearPending()
				refresh()
			end
		end)
	end)
	pcall(function()
		player:GetAttributeChangedSignal("WE_KeepBaseRebirths"):Connect(refresh)
	end)
end

--[[ Every PrestigeStateUpdate (ProgressionController forwards it). A rebirth that went through closes the modal;
	any other push ends a cash / use-token request (refused) or a purchase whose Robux sheet already closed. ]]
function RebirthConfirm.SetState(payload: any)
	state = payload
	if typeof(payload) == "table" and typeof(payload.Level) == "number" then
		liveLevel = payload.Level
	end
	if pending ~= nil and typeof(payload) == "table" then
		if num(payload.Prestige, 0) > pendingPrestige then
			clearPending()
			closeModal("done")
			return
		end
		-- a purchase whose sheet is still open ignores unrelated pushes, but a banked token ends it
		local banked = num(payload.KeepBaseTokens, 0) > pendingTokens
		if pending ~= "buy" or buyFinished or banked then
			clearPending()
		end
	end
	refresh()
end

-- the freshest level (XPUpdate); the REBIRTH button follows it without waiting for a state push
function RebirthConfirm.SetLevel(level: number?)
	if typeof(level) == "number" then
		liveLevel = level
		refresh()
	end
end

function RebirthConfirm.Open(payload: any?, opts: OpenOpts?)
	RebirthConfirm.Init()
	if payload ~= nil then
		state = payload
	end
	openOpts = opts or {}
	local m = modal
	if not m then
		return
	end
	isOpen = true
	layout()
	m.Visible = true
	local sh = shell
	if sh then
		sh.Sync(true)
	end
end

function RebirthConfirm.Close()
	closeModal("dismiss")
end

function RebirthConfirm.IsOpen(): boolean
	return isOpen
end

-- display snapshot for the headless drivers: the two button states and the status line
function RebirthConfirm.Snapshot(): { Cash: ButtonState, Keep: ButtonState, Status: string, Pending: string? }
	local vw = view()
	return {
		Cash = RebirthConfirm.CashButton(vw),
		Keep = RebirthConfirm.KeepButton(vw),
		Status = RebirthConfirm.StatusText(vw),
		Pending = pending,
	}
end

return RebirthConfirm
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="233">
            <Properties>
              <string name="Name">StudioSmokeClient</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Studio-only: listen for StudioSmokeLog RemoteEvent and print loud [SMOKE] lines
	in the *client* Output window (Play Solo). Server prints alone can be easy to miss
	when the Output filter is set to Client.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StudioSmokeClient = {}

function StudioSmokeClient.Init()
	if not RunService:IsStudio() then
		return
	end

	task.spawn(function()
		local Shared = ReplicatedStorage:WaitForChild("Shared", 30)
		if not Shared then
			return
		end
		local okC, Constants = pcall(function()
			return require(Shared.Constants)
		end)
		local okR, Remotes = pcall(function()
			return require(Shared.Remotes)
		end)
		if not (okC and okR and Constants and Remotes) then
			warn("[SMOKE] client listener: Constants/Remotes require failed")
			return
		end
		local name = Constants.RemoteNames and Constants.RemoteNames.StudioSmokeLog
		if typeof(name) ~= "string" then
			return
		end
		local okEv, ev = pcall(function()
			return Remotes.GetEvent(name)
		end)
		if not okEv or not ev then
			warn("[SMOKE] client listener: StudioSmokeLog remote missing")
			return
		end

		print("[SMOKE] client listener armed — will echo StudioSmokeLog here")
		ev.OnClientEvent:Connect(function(kind: any, line: any, _t: any)
			local text = if typeof(line) == "string" then line else string.format("[SMOKE] BUY %s", tostring(kind))
			print("========== CLIENT " .. text .. " ==========")
			print(text)
			if tostring(kind) == "FAIL" then
				warn(text)
			elseif tostring(kind) == "OK" then
				print("[SMOKE] ★★★ CLIENT SAW BUY OK ★★★")
			end
		end)
	end)
end

return StudioSmokeClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="234">
            <Properties>
              <string name="Name">VehicleCombatClient</string>
              <string name="Source"><![CDATA[--!strict
--[[
	VehicleCombatClient (W2 CC-2): the client half of vehicle HP. Display only — the server (VehicleHealth) owns HP
	and writes WE_HP / WE_MaxHP (≤ 10 Hz) and WE_Destroyed on the vehicle Model; nothing here is sent back.
	Numbers: VehicleCombatConfig.Ui.

	  * Occupant HUD bar: while Humanoid.SeatPart is in a vehicle with WE_MaxHP > 0. 230 × 10 real px in its own
	    ScreenGui (no UIScale). Touch: HudLayout top-centre stack at Ui.HudBar.TouchStackOrder (24, right above the
	    SPD pill at 25). Desktop / gamepad: bottom-right, just above the SPD pill. Gold frame on premium vehicles;
	    the fill flashes red below Ui.HudBar.LowFrac (one looping tween, no Lua per frame).
	  * Over-vehicle bars: client BillboardGuis (PlayerGui, Adornee = Chassis) — stud-scaled, never AlwaysOnTop,
	    MaxDistance ≤ 40, no text. Shown Ui.OverBar.ShowSeconds after that vehicle's WE_HP drops, and on your own
	    parked vehicle while HP < MaxHP; never on the vehicle you sit in; a pool of MaxShown (3): the most recent win.
	  * Wreck: WE_Destroyed → one burst from a pooled Attachment + ParticleEmitter under Workspace.Terrain (Emit only,
	    no parts) and AudioController.Play("Explosion.Large", chassis) (false / silent until that key exists). Once per
	    model.
	  * Phones: no RenderStepped / Heartbeat work. Everything runs from attribute / seat / tag signals, and repaints are
	    coalesced to Ui.RefreshHz (10 Hz). Safe under StreamingEnabled (vehicles come and go with their tag signals;
	    no WaitForChild without a timeout) and headless (every optional module is required in pcall).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local Constants = require(Shared.Constants)
local VehicleCombatConfig = require(Shared.Configs.VehicleCombatConfig)

local UI = VehicleCombatConfig.Ui
local HB = UI.HudBar
local OB = UI.OverBar
local REFRESH_SECONDS = 1 / math.max(1, UI.RefreshHz)

local VehicleCombatClient = {}

type Info = {
	Conns: { RBXScriptConnection },
	LastHP: number?,
	ShowUntil: number,
	Wrecked: boolean,
}
type Candidate = { Model: Model, Chassis: BasePart, Frac: number, Rank: number }

local COLOR_BG = Color3.fromRGB(16, 18, 22)
local COLOR_FILL = Color3.fromRGB(90, 196, 235) -- "armor" cyan: not mistaken for the green capture bar above it
local COLOR_LOW = Color3.fromRGB(200, 40, 36)
local COLOR_LOW_FLASH = Color3.fromRGB(255, 120, 96)
local COLOR_STROKE = Color3.fromRGB(0, 0, 0)
local COLOR_GOLD = Color3.fromRGB(235, 192, 64)
local WRECK_EMIT = 24

local started = false
local tracked: { [Model]: Info } = {}
local seated: Model? = nil
local hudGui: ScreenGui? = nil
local hudBar: Frame? = nil
local hudFill: Frame? = nil
local hudStroke: UIStroke? = nil
local lowTween: Tween? = nil
local lowOn = false
local stacked = false
local overPool: { BillboardGui } = {}
local overFill: { [BillboardGui]: Frame } = {}
local burstAtt: Attachment? = nil
local burstEmitter: ParticleEmitter? = nil
local refreshQueued = false
local lastRefreshAt = -math.huge
local expiryAt = math.huge -- earliest pending over-bar expiry already scheduled
local humConn: RBXScriptConnection? = nil
local humWaitConn: RBXScriptConnection? = nil -- streaming2 F16: the character's ChildAdded until its Humanoid arrives
local stats = { Refreshes = 0, Bursts = 0, OverShown = 0, HudShown = false }

local function now(): number
	return os.clock()
end

local function localPlayer(): Player?
	return Players.LocalPlayer
end

-- optional sibling module (HudLayout / AudioController): nil when missing or failing (headless tests)
local siblingCache: { [string]: any } = {}
local function sibling(name: string): any
	local cached = siblingCache[name]
	if cached ~= nil then
		return if cached == false then nil else cached
	end
	local ok, m = pcall(function(): any
		local here: any = script
		local mod = here.Parent and here.Parent:FindFirstChild(name)
		if mod and mod:IsA("ModuleScript") then
			local req: any = require
			return req(mod)
		end
		return nil
	end)
	local value = if ok and typeof(m) == "table" then m else false
	siblingCache[name] = value
	return if value == false then nil else value
end

local function preferredTouch(): boolean
	local ok, v = pcall(function(): any
		return (UserInputService :: any).PreferredInput
	end)
	return ok and typeof(v) == "EnumItem" and (v :: EnumItem).Name == "Touch"
end

-- same switch as VehicleDriveClient's SPD pill (touch → the top-centre stack)
local function isTouch(): boolean
	return UserInputService.TouchEnabled == true or preferredTouch()
end

local function num(v: any): number?
	local n = tonumber(v)
	if n == nil or n ~= n then
		return nil
	end
	return n
end

local function chassisOf(model: Model): BasePart?
	local p = model.PrimaryPart
	if p then
		return p
	end
	local c = model:FindFirstChild("Chassis")
	return if c and c:IsA("BasePart") then c else nil
end

-- (fraction 0..1, has HP) from the replicated attributes
local function hpFrac(model: Model): (number, boolean)
	local maxHP = num(model:GetAttribute("WE_MaxHP"))
	if maxHP == nil or maxHP <= 0 then
		return 0, false
	end
	if model:GetAttribute("WE_Destroyed") == true then
		return 0, true
	end
	local hp = num(model:GetAttribute("WE_HP")) or maxHP
	return math.clamp(hp / maxHP, 0, 1), true
end

-- the vehicle a seat belongs to: the nearest ancestor tagged WE_Vehicle, else one carrying WE_MaxHP / VehicleId
local function vehicleOf(inst: Instance?): Model?
	local cur: Instance? = inst
	while cur ~= nil and cur ~= Workspace do
		if cur:IsA("Model") then
			if
				CollectionService:HasTag(cur, Constants.Tags.Vehicle)
				or cur:GetAttribute("WE_MaxHP") ~= nil
				or cur:GetAttribute("VehicleId") ~= nil
			then
				return cur
			end
		end
		cur = cur.Parent
	end
	return nil
end

-- ── HUD bar ─────────────────────────────────────────────────────────────────────────────────────

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function placeHud()
	local bar = hudBar
	if bar == nil then
		return
	end
	local HL = if isTouch() then sibling("HudLayout") else nil
	if HL and typeof(HL.RegisterTopStack) == "function" then
		if stacked then
			return
		end
		bar.AnchorPoint = Vector2.new(0.5, 0)
		bar.Position = UDim2.new(0.5, 0, 0, 0)
		local ok = pcall(HL.RegisterTopStack, "VehicleHP", bar, HB.TouchStackOrder, { Space = "Screen" })
		if ok then
			stacked = true
			return
		end
	end
	if stacked then
		stacked = false
		local L = sibling("HudLayout")
		if L and typeof(L.UnregisterTopStack) == "function" then
			pcall(L.UnregisterTopStack, "VehicleHP")
		end
	end
	bar.AnchorPoint = Vector2.new(1, 1)
	bar.Position = UDim2.new(1, -HB.DesktopRight, 1, -HB.DesktopBottom)
end

local function ensureHud(): Frame?
	local bar = hudBar
	if bar and bar.Parent then
		return bar
	end
	local lp = localPlayer()
	local pg = if lp then lp:FindFirstChildOfClass("PlayerGui") else nil
	if pg == nil then
		return nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "WE_VehicleHP"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 56 -- with the SPD pill's gui (above the dock 55, below panels 60)
	gui.Enabled = true
	local b = Instance.new("Frame")
	b.Name = "WE_VehicleHPBar"
	b.Size = UDim2.fromOffset(HB.Width, HB.Height)
	b.BackgroundColor3 = COLOR_BG
	b.BackgroundTransparency = 0.2
	b.BorderSizePixel = 0
	b.Active = false
	b.Visible = false
	b.Parent = gui
	corner(b, math.floor(HB.Height / 2))
	local stroke = Instance.new("UIStroke")
	stroke.Color = COLOR_STROKE
	stroke.Transparency = 0.35
	stroke.Thickness = 1
	stroke.Parent = b
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = COLOR_FILL
	fill.BorderSizePixel = 0
	fill.Active = false
	fill.Parent = b
	corner(fill, math.floor(HB.Height / 2))
	gui.Parent = pg
	hudGui = gui
	hudBar = b
	hudFill = fill
	hudStroke = stroke
	stacked = false
	placeHud()
	return b
end

local function setLow(on: boolean)
	local fill = hudFill
	if fill == nil or on == lowOn then
		return
	end
	lowOn = on
	local tw = lowTween
	if tw then
		tw:Cancel()
		lowTween = nil
	end
	if on then
		fill.BackgroundColor3 = COLOR_LOW
		local ok, made = pcall(function(): Tween
			return TweenService:Create(
				fill,
				TweenInfo.new(0.35, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true),
				{ BackgroundColor3 = COLOR_LOW_FLASH }
			)
		end)
		if ok and made then
			lowTween = made
			made:Play()
		end
	else
		fill.BackgroundColor3 = COLOR_FILL
	end
end

local function paintHud()
	local model = seated
	local frac, has = 0, false
	if model then
		frac, has = hpFrac(model)
	end
	if not has then
		local bar = hudBar
		if bar and bar.Visible then
			bar.Visible = false
		end
		setLow(false)
		stats.HudShown = false
		return
	end
	local bar = ensureHud()
	local fill = hudFill
	if bar == nil or fill == nil or model == nil then
		return
	end
	fill.Size = UDim2.fromScale(frac, 1)
	local premium = model:GetAttribute("WE_Premium") == true
	local stroke = hudStroke
	if stroke then
		stroke.Color = if premium then COLOR_GOLD else COLOR_STROKE
		stroke.Thickness = if premium then 2 else 1
		stroke.Transparency = if premium then 0 else 0.35
	end
	setLow(frac < HB.LowFrac)
	if not bar.Visible then
		bar.Visible = true
	end
	stats.HudShown = true
end

-- ── over-vehicle bars ───────────────────────────────────────────────────────────────────────────

local function overGui(i: number): BillboardGui?
	local g = overPool[i]
	if g and g.Parent then
		return g
	end
	local lp = localPlayer()
	local pg = if lp then lp:FindFirstChildOfClass("PlayerGui") else nil
	if pg == nil then
		return nil
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_VehicleHPOver"
	bb.Size = UDim2.fromScale(OB.WidthStuds, OB.HeightStuds) -- studs: shrinks with distance
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = math.min(40, OB.MaxDistance)
	bb.ResetOnSpawn = false
	bb.Enabled = false
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = COLOR_BG
	back.BackgroundTransparency = 0.25
	back.BorderSizePixel = 0
	back.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = COLOR_FILL
	fill.BorderSizePixel = 0
	fill.Parent = back
	bb.Parent = pg
	overPool[i] = bb
	overFill[bb] = fill
	return bb
end

local function labelHeight(model: Model, chassis: BasePart): number
	local ly = num(model:GetAttribute("WE_LabelY"))
	if ly ~= nil and ly > 0 then
		return math.clamp(ly - 0.75, 1, 30) -- just under the owner nameplate (VehicleDriveClient, at WE_LabelY)
	end
	return chassis.Size.Y * 0.5 + 2
end

local function scheduleExpiry(at: number)
	if at >= expiryAt then
		return
	end
	expiryAt = at
	task.delay(math.max(0, at - now()) + 0.05, function()
		if expiryAt == at then
			expiryAt = math.huge
		end
		VehicleCombatClient._Refresh()
	end)
end

local function paintOver()
	local lp = localPlayer()
	local myId = if lp then lp.UserId else -1
	local t = now()
	local list: { Candidate } = {}
	local nextExpiry = math.huge
	for model, info in pairs(tracked) do
		if model ~= seated and model.Parent ~= nil and not info.Wrecked then
			local chassis = chassisOf(model)
			local frac, has = hpFrac(model)
			if chassis and has then
				local recent = info.ShowUntil > t
				local ownHurt = model:GetAttribute("OwnerUserId") == myId and frac < 0.999
				if recent or ownHurt then
					table.insert(list, { Model = model, Chassis = chassis, Frac = frac, Rank = if recent then info.ShowUntil else 0 })
				end
				if recent and info.ShowUntil < nextExpiry then
					nextExpiry = info.ShowUntil
				end
			end
		end
	end
	table.sort(list, function(a: Candidate, b: Candidate): boolean
		return a.Rank > b.Rank
	end)
	local shown = 0
	for i = 1, OB.MaxShown do
		local c = list[i]
		local g = if c or overPool[i] then overGui(i) else nil
		if g then
			if c then
				g.Adornee = c.Chassis
				g.StudsOffsetWorldSpace = Vector3.new(0, labelHeight(c.Model, c.Chassis), 0)
				local fill = overFill[g]
				if fill then
					fill.Size = UDim2.fromScale(c.Frac, 1)
					fill.BackgroundColor3 = if c.Frac < HB.LowFrac then COLOR_LOW else COLOR_FILL
				end
				g.Enabled = true
				shown += 1
			elseif g.Enabled or (g :: any).Adornee ~= nil then
				g.Enabled = false;
				(g :: any).Adornee = nil
			end
		end
	end
	stats.OverShown = shown
	if nextExpiry < math.huge then
		scheduleExpiry(nextExpiry)
	end
end

-- ── wreck burst ─────────────────────────────────────────────────────────────────────────────────

local function ensureBurst(): ParticleEmitter?
	local em = burstEmitter
	local att = burstAtt
	if em and att and att.Parent then
		return em
	end
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain == nil then
		return nil
	end
	local a = Instance.new("Attachment")
	a.Name = "WE_VehicleWreckFx"
	local e = Instance.new("ParticleEmitter")
	e.Name = "Burst"
	e.Rate = 0
	e.Enabled = true
	e.Lifetime = NumberRange.new(0.6, 1.3)
	e.Speed = NumberRange.new(8, 22)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Drag = 3
	e.LightEmission = 0.6
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 6) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 196, 96)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(230, 90, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 36, 34)),
	})
	e.Parent = a
	a.Parent = terrain
	burstAtt = a
	burstEmitter = e
	return e
end

local function wreckBurst(model: Model)
	local info = tracked[model]
	if info == nil or info.Wrecked then
		return
	end
	info.Wrecked = true
	local chassis = chassisOf(model)
	if chassis == nil then
		return
	end
	local em = ensureBurst()
	local att = burstAtt
	if em and att then
		pcall(function()
			att.WorldPosition = chassis.Position
			em:Emit(WRECK_EMIT)
		end)
		stats.Bursts += 1
	end
	local audio = sibling("AudioController")
	if audio and typeof(audio.Play) == "function" then
		pcall(audio.Play, "Explosion.Large", chassis)
	end
end

-- ── refresh scheduling (≤ Ui.RefreshHz) ────────────────────────────────────────────────────────

function VehicleCombatClient._Refresh()
	lastRefreshAt = now()
	stats.Refreshes += 1
	pcall(paintHud)
	pcall(paintOver)
end

local function requestRefresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	local wait = math.max(0, lastRefreshAt + REFRESH_SECONDS - now())
	task.delay(wait, function()
		refreshQueued = false
		VehicleCombatClient._Refresh()
	end)
end

-- ── tracking ────────────────────────────────────────────────────────────────────────────────────

local function untrack(model: Model)
	local info = tracked[model]
	if info == nil then
		return
	end
	tracked[model] = nil
	for _, c in ipairs(info.Conns) do
		c:Disconnect()
	end
	table.clear(info.Conns)
	requestRefresh()
end

local function track(inst: Instance)
	if not inst:IsA("Model") or tracked[inst] ~= nil then
		return
	end
	local model: Model = inst
	local info: Info = { Conns = {}, LastHP = num(model:GetAttribute("WE_HP")), ShowUntil = -math.huge, Wrecked = false }
	tracked[model] = info
	table.insert(
		info.Conns,
		model:GetAttributeChangedSignal("WE_HP"):Connect(function()
			local hp = num(model:GetAttribute("WE_HP"))
			local last = info.LastHP
			if hp ~= nil and last ~= nil and hp < last - 0.01 then
				info.ShowUntil = now() + OB.ShowSeconds
			end
			info.LastHP = hp
			requestRefresh()
		end)
	)
	table.insert(info.Conns, model:GetAttributeChangedSignal("WE_MaxHP"):Connect(requestRefresh))
	table.insert(
		info.Conns,
		model:GetAttributeChangedSignal("WE_Destroyed"):Connect(function()
			if model:GetAttribute("WE_Destroyed") == true then
				wreckBurst(model)
			end
			requestRefresh()
		end)
	)
	if model:GetAttribute("WE_Destroyed") == true then
		info.Wrecked = true -- streamed in already wrecked: no burst
	end
	requestRefresh()
end

local function onSeatChanged(hum: Humanoid)
	local seat = hum.SeatPart
	local model = vehicleOf(seat)
	if model and tracked[model] == nil then
		track(model)
	end
	seated = model
	requestRefresh()
end

-- streaming2: the place's StreamingEnabled (default.project.json; scripts cannot set it). The F16 late-Humanoid bind
-- acts only while it is true; with it false the bind is the 0a04776 one.
local function streamingOn(): boolean
	return Workspace.StreamingEnabled == true
end

local function stopHumanoidWait()
	local c = humWaitConn
	humWaitConn = nil
	if c then
		c:Disconnect()
	end
end

local function bindHumanoid(hum: Humanoid)
	local old = humConn
	if old then
		old:Disconnect()
	end
	humConn = hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
		onSeatChanged(hum)
	end)
	onSeatChanged(hum)
end

local function bindCharacter(character: Model)
	stopHumanoidWait()
	task.spawn(function()
		local found: Instance? = character:FindFirstChildOfClass("Humanoid")
		if not found and streamingOn() then
			--[[ streaming2 F16: under streaming the character model is parented before its descendants have
				replicated, so its Humanoid can come later than any fixed wait. Bind whenever it arrives (the HudLayout
				pattern); the next character and CharacterRemoving stop the wait. ]]
			humWaitConn = character.ChildAdded:Connect(function(c: Instance)
				if c:IsA("Humanoid") then
					stopHumanoidWait()
					bindHumanoid(c)
				end
			end)
			return
		end
		if not found then
			found = character:WaitForChild("Humanoid", 10) -- streaming off: the character arrives whole (0a04776)
		end
		if not (found and found:IsA("Humanoid")) then
			return
		end
		local hum: Humanoid = found
		bindHumanoid(hum)
	end)
end

function VehicleCombatClient.Init()
	if started then
		return
	end
	started = true
	local tag = Constants.Tags.Vehicle
	CollectionService:GetInstanceAddedSignal(tag):Connect(track)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst: Instance)
		if inst:IsA("Model") then
			untrack(inst)
		end
	end)
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		track(inst)
	end
	local lp = localPlayer()
	if lp then
		lp.CharacterAdded:Connect(function(character: Model)
			seated = nil
			bindCharacter(character)
		end)
		lp.CharacterRemoving:Connect(function()
			stopHumanoidWait() -- streaming2 F16 (nil while streaming is off)
			seated = nil
			requestRefresh()
		end)
		local ch = lp.Character
		if ch then
			bindCharacter(ch)
		end
	end
	pcall(function()
		(UserInputService :: any):GetPropertyChangedSignal("PreferredInput"):Connect(function()
			placeHud()
		end)
	end)
	requestRefresh()
end

-- tests / Studio
function VehicleCombatClient._Stats(): { Refreshes: number, Bursts: number, OverShown: number, HudShown: boolean, Tracked: number }
	local n = 0
	for _ in pairs(tracked) do
		n += 1
	end
	return { Refreshes = stats.Refreshes, Bursts = stats.Bursts, OverShown = stats.OverShown, HudShown = stats.HudShown, Tracked = n }
end

function VehicleCombatClient._Seated(): Model?
	return seated
end

function VehicleCombatClient._HudBar(): Frame?
	return hudBar
end

function VehicleCombatClient._Gui(): ScreenGui?
	return hudGui
end

return VehicleCombatClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="235">
            <Properties>
              <string name="Name">VehicleDriveClient</string>
              <string name="Source"><![CDATA[--!strict
--[[
	v70: client half of drivable vehicles (cars, helicopters, planes, boats).

	The driver's client owns the vehicle's physics. Every frame this module turns the seat input
	(DriverSeat.ThrottleFloat/SteerFloat + the extra lift/strafe keys) into a target velocity and
	orientation, and writes them to the two movers the server built on the Chassis:
	  WE_DriveLV (LinearVelocity, PerAxis)  -> VectorVelocity + the Y part of MaxAxesForce
	  WE_DriveAO (AlignOrientation)         -> CFrame (rotation only)
	It writes only while the model's WE_DriveAuthority == "Client". The server checks the result
	(speed, altitude, teleports, map bounds, boats over WE_Water) and takes ownership back on a violation.
	No positions or velocities are ever sent to the server. The only remote is VehicleDriveInput:
	  {K="Hello", V, P}            once per sit (+ retries) → the server hands the physics to this client
	  {K="Bye", V}                 leaving the seat
	  {K="In", V, T, S, L}         jeep fix F4b: the composed input, 2 decimals, Drive.Watchdog.StreamHz while any
	                               axis is non-zero + one zero message on release (feeds the server-driven fallback)
	  {K="Stuck", V, T, Spd, R, Src}  F4c: once per sit, throttle held 1.5 s under Client authority, speed < 1
	  {K="Exit", V}                F4d: jump button / Space (JumpRequest), the EXIT hold pill, F — the server ejects
	Every value is clamped to [-1, 1] on the server again; a client can only downgrade its own car to server driving.

	Laws (NewState / Step / ComposeInput / ControlsLayout / WaterSurfaceAt / ProbeDistances / BuildParams / AirBoxParams)
	are pure and are tested headless. The server's fallback + idle laws are a copy of the Car/Boat maths.

	JEEP-2 (roadmap W1 §2.2 item 4):
	  * air box: helicopters and planes turn back before the World v2 air box (VehicleConfig.Drive.AirBox.Box =
	    WorldConfig.Bounds.Air; the air wall has no roof) and show the device-neutral "Restricted airspace" line;
	    VehicleService's validator uses the same box, so nothing inside it is ever corrected
	  * W7: on touch the SPD pill and the hint line sit in HudLayout's top-centre stack under the capture bar; on
	    desktop / gamepad the pill takes the ammo readout's slot (bottom-right)
	  * jeep F9 / V8: while I sit in any vehicle seat, every ProximityPrompt outside WarEmpireVehicles is hushed
	    locally (MaxActivationDistance 0) and put back on the way out

	streaming2 lane C3 (acts only while Workspace.StreamingEnabled is true; with it false, as at 0a04776):
	  * F13: a hushed prompt that streams out and back in is hushed again when it shows (a local write can be lost)
	  * F16: a Humanoid that replicates after its character still binds (no 10 s give-up)
	  * F17: an aircraft's AGL ray over ground that has not streamed in uses the last hit or the desert floor

	Requiring this module does nothing heavy (GetService only). Init() is called by VehicleController.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local VehicleDriveClient = {}

export type Input = { Throttle: number, Steer: number, Lift: number, Strafe: number }

export type RawInput = {
	Throttle: number,
	Steer: number,
	Up: boolean?, -- Space
	Down: boolean?, -- LeftCtrl / C
	TouchUp: boolean?, -- mobile ▲
	TouchDown: boolean?, -- mobile ▼
	R2: number?, -- gamepad analog 0..1
	L2: number?,
	Left: boolean?, -- Z / L1 (strafe left)
	Right: boolean?, -- X / R1 (strafe right)
}

export type Sense = {
	Position: Vector3,
	Velocity: Vector3,
	Yaw: number,
	UpY: number,
	AGL: number, -- lowest solid point to the ground below; math.huge when nothing is below
	Time: number,
	Look: Vector3?, -- chassis LookVector (defaults to the flat heading)
	WaterY: number?,
	WaterNear: boolean?,
	WaterFar: boolean?,
	Clear: boolean?, -- rollover fix: false = another player is within reach of this flipped car (no righting); nil = clear
}

-- Restricted: the air-box guard steered / capped this step (the HUD shows the "Restricted airspace" line)
export type Hud = { Speed: number, Alt: number?, Throttle: number?, Tag: string?, Restricted: boolean? }

-- Righting: flip recovery is lifting / levelling the car (applyOut sets WE_DriveAO.MaxAngularVelocity = Car.RecoverSpin)
export type Out = { Velocity: Vector3, HoldVertical: boolean, Orientation: CFrame, Hud: Hud, Righting: boolean? }

-- JEEP-2 World v2 air box for Heli / Plane (Laws.AirBoxParams; VehicleConfig.Drive.AirBox): Box edges + law tunables
export type AirBox = {
	X: number,
	ZMin: number,
	ZMax: number,
	MaxY: number,
	Band: number,
	LeadSeconds: number,
	Buffer: number,
	EdgeGain: number,
	PlaneEdgeGain: number,
	PushFrac: number,
	OutwardSpeed: number,
	SteerGain: number,
	AssistYawRate: number,
	CeilBand: number,
	CeilBuffer: number,
	CeilGain: number,
	CeilSink: number,
}

export type Params = {
	Mode: string,
	MaxSpeed: number,
	Accel: number,
	TurnRate: number,
	Tracked: boolean,
	ClimbRate: number,
	MaxAltitude: number,
	Vto: number,
	Vstall: number,
	RideOffset: number,
	Clearance: number,
	HalfLength: number,
	HalfWidth: number,
	SpawnState: string?,
	SpawnSpeed: number,
	SoftBound: number,
	AutoTakeoff: boolean,
	AirBox: AirBox?,
	C: { [string]: number },
}

export type State = {
	Mode: string,
	Age: number,
	Heading: number,
	LagFor: number,
	-- car / boat
	Speed: number,
	FlipFor: number,
	HopLeft: number, -- flip recovery: seconds left of the current righting (0 = none)
	RightFrom: Vector3?, -- where the righting started
	RightDown: number?, -- seconds spent lowering it (nil = still lifting / levelling)
	RightCool: number,
	RightClock: number, -- the law's own clock (sum of dt) for the per-minute cap
	RightTimes: { number },
	-- heli
	Fwd: number,
	Side: number,
	Vy: number,
	YawRate: number,
	HoldY: number?,
	Landed: boolean,
	Roll: number,
	-- plane (Pitch is shared with heli)
	Pitch: number,
	Lever: number,
	Airspeed: number,
	Airborne: boolean,
	ClimbOut: boolean,
	Stalled: boolean,
	Bank: number,
	-- boat
	BobT: number,
	LastWaterPos: Vector3?,
	LastWaterY: number?,
	-- JEEP-2 air box guard (set every step by airGuardInput): turning back (until facing the box centre or out of the
	-- band), depth into the band 0..1, heading to the box centre, and "a plane's ▲ was capped under the ceiling"
	AirTurn: boolean,
	AirDepth: number,
	AirTarget: number,
	AirLift: boolean,
}

export type Rect = { Pos: Vector2, Size: Vector2 }
export type Layout = { Up: Rect, Down: Rect, Exit: Rect, Where: string }

-- ─────────────────────────────────────────────────────────────────────────────
-- Defaults (spec section 2). VehicleConfig.Drive overrides any of these when present.
-- ─────────────────────────────────────────────────────────────────────────────
local PROTOCOL_VERSION = 1

local DEFAULTS: any = {
	ProtocolVersion = PROTOCOL_VERSION,
	HelloTimeoutSeconds = 2.5,
	World = { SoftBound = 3300 },
	Resync = { Gap = 10, CarGap = 6, Seconds = 0.3, GraceSeconds = 1 },
	Water = { RefreshSeconds = 2, QueryBelow = 8, QueryAbove = 20, LandProbeHeight = 30 },
	-- jeep fix (fix_spec §1.2). VehicleConfig.Drive.Watchdog / .Debug override these key by key.
	Watchdog = { StreamHz = 10 },
	-- Debug: nobody unless VehicleConfig.Drive.Debug names them (the on-device NO DRIVE line is config-gated)
	Debug = { UserIds = {}, All = false, NoDriveSeconds = 1.0, NoDriveSpeed = 1.0, ShowSeconds = 6 },
	-- mobile P1-7: EXIT pill + airborne jump lock (VehicleConfig.Drive.Exit overrides)
	Exit = {
		HoldSeconds = 0.5, -- the EXIT pill fires after this long held
		LockAGL = 8, -- Heli/Plane higher than this above the ground: local JumpHeight 0 (the touch jump button hides)
		UnlockAGL = 7, -- ... and back below this (hysteresis: the jump button does not flicker at 8)
		RequestGapSeconds = 0.3, -- at most one {K="Exit"} per this long
		StuckSeconds = 1.5, -- F4c: throttle held this long under Client authority at speed < StuckSpeed → one Stuck report
		StuckSpeed = 1.0,
	},
	-- mobile P1-8: client-side owner nameplate (VehicleConfig.Drive.Nameplate overrides)
	Nameplate = { MaxDistance = 36, WidthStuds = 2, HeightStuds = 0.4, HeightPx = 20, MinText = 14, MaxText = 20 },
	-- JEEP-2 air-box law tunables (VehicleConfig.Drive.AirBox overrides key by key). No Box here: without
	-- VehicleConfig.Drive.AirBox.Box (WorldConfig.Bounds.Air) there is no air box and the old SoftBound applies.
	AirBox = {
		Enabled = true,
		Band = 160,
		LeadSeconds = 1.6,
		Buffer = 30,
		EdgeGain = 0.6,
		PlaneEdgeGain = 1.5,
		PushFrac = 0.5,
		OutwardSpeed = 2,
		SteerGain = 2,
