            <string name="Name">Trove</string>
            <string name="Source"><![CDATA[--!strict
--[[ VENDORED (W2 CC-3): RbxUtil Trove v1.8.0 by Stephen Leitnick, MIT licence (see LICENSE beside this file and
	THIRD_PARTY_NOTICES.md at the repo root).
	Upstream: https://github.com/Sleitnick/RbxUtil  modules/trove/init.luau
	Source:   raw.githubusercontent.com, branch main @ 31f9120fca021e3dec275b42bc7047d626962082, fetched 2026-09-24
	          (byte-identical to the copy reviewed in scratchpad/gap/vend/trove.luau).
	Local changes: none (the upstream file is already --!strict; only this header was added).
]]

local RunService = game:GetService("RunService")

export type Trove = {
	Extend: (self: Trove) -> Trove,
	Clone: <T>(self: Trove, instance: T & Instance) -> T,
	Construct: <T, A...>(self: Trove, class: Constructable<T, A...>, A...) -> T,
	Connect: (
		self: Trove,
		signal: SignalLike | SignalLikeMetatable | RBXScriptSignal,
		fn: (...any) -> ...any
	) -> ConnectionLike | ConnectionLikeMetatable,
	BindToRenderStep: (self: Trove, name: string, priority: number, fn: (dt: number) -> ()) -> (),
	AddPromise: <T>(self: Trove, promise: (T & PromiseLike) | (T & PromiseLikeMetatable)) -> T,
	Add: <T>(self: Trove, object: T & Trackable, cleanupMethod: string?) -> T,
	Remove: <T>(self: Trove, object: T & Trackable) -> boolean,
	Pop: <T>(self: Trove, object: T & Trackable) -> boolean,
	Clean: (self: Trove) -> (),
	WrapClean: (self: Trove) -> () -> (),
	AttachToInstance: (self: Trove, instance: Instance) -> RBXScriptConnection,
	Destroy: (self: Trove) -> (),
}

type TroveInternal = Trove & {
	_objects: { any },
	_cleaning: boolean,
	_findAndRemoveFromObjects: (self: TroveInternal, object: any, cleanup: boolean) -> boolean,
	_cleanupObject: (self: TroveInternal, object: any, cleanupMethod: string?) -> (),
}

--[=[
	@within Trove
	@type Trackable Instance | RBXScriptConnection | ConnectionLike | ConnectLikeMetatable | PromiseLike | PromiseLikeMetatable | thread | ((...any) -> ...any) | Destroyable | DestroyableMetatable | DestroyableLowercase | DestroyableLowercaseMetatable | Disconnectable | DisconnectableMetatable | DisconnectableLowercase | DisconnectableLowercaseMetatable | SignalLike | SignalLikeMetatable
	Represents all trackable objects by Trove.
]=]
export type Trackable =
	| Instance
	| RBXScriptConnection
	| ConnectionLike
	| ConnectionLikeMetatable
	| PromiseLike
	| PromiseLikeMetatable
	| thread
	| ((...any) -> ...any)
	| Destroyable
	| DestroyableMetatable
	| DestroyableLowercase
	| DestroyableLowercaseMetatable
	| Disconnectable
	| DisconectableMetatable
	| DisconnectableLowercase
	| DisconnectableLowercaseMetatable
	| SignalLike
	| SignalLikeMetatable

--[=[
	@within Trove
	@interface ConnectionLike
	.Connected boolean
	.Disconnect (self) -> ()
]=]
type ConnectionLike = {
	Connected: boolean,
	Disconnect: (self: ConnectionLike) -> (),
}

--[=[
	@within Trove
	@interface ConnectionLikeMetatable
	.Connected boolean
	.Disconnect (self) -> ()
	@tag Metatable
]=]
type ConnectionLikeMetatable = typeof(setmetatable(
	{},
	{} :: { Connected: boolean, Disconnect: (self: ConnectionLikeMetatable) -> () }
))

--[=[
	@within Trove
	@interface SignalLike
	.Connect (self, callback: (...any) -> ...any) -> ConnectionLike
	.Once (self, callback: (...any) -> ...any) -> ConnectionLike
]=]
type SignalLike = {
	Connect: (self: SignalLike, callback: (...any) -> ...any) -> ConnectionLike | ConnectionLikeMetatable,
	Once: (self: SignalLike, callback: (...any) -> ...any) -> ConnectionLike | ConnectionLikeMetatable,
}

--[=[
	@within Trove
	@interface SignalLikeMetatable
	.Connect (self, callback: (...any) -> ...any) -> ConnectionLike
	.Once (self, callback: (...any) -> ...any) -> ConnectionLike
	@tag Metatable
]=]
type SignalLikeMetatable = typeof(setmetatable(
	{},
	{} :: {
		Connect: (self: SignalLikeMetatable, callback: (...any) -> ...any) -> ConnectionLike | ConnectionLikeMetatable,
		Once: (self: SignalLikeMetatable, callback: (...any) -> ...any) -> ConnectionLike | ConnectionLikeMetatable,
	}
))

--[=[
	@within Trove
	@interface PromiseLike
	.getStatus (self) -> string
	.finally (self, callback: (...any) -> ...any) -> PromiseLike
	.cancel (self) -> ()
]=]
type PromiseLike = {
	getStatus: (self: PromiseLike) -> string,
	finally: (self: PromiseLike, callback: (...any) -> ...any) -> PromiseLike | PromiseLikeMetatable,
	cancel: (self: PromiseLike) -> (),
}

--[=[
	@within Trove
	@interface PromiseLikeMetatable
	.getStatus (self) -> string
	.finally (self, callback: (...any) -> ...any) -> PromiseLike
	.cancel (self) -> ()
	@tag Metatable
]=]
type PromiseLikeMetatable = typeof(setmetatable(
	{},
	{} :: {
		getStatus: (self: any) -> string,
		finally: (self: PromiseLikeMetatable, callback: (...any) -> ...any) -> PromiseLike | PromiseLikeMetatable,
		cancel: (self: PromiseLikeMetatable) -> (),
	}
))

--[=[
	@within Trove
	@type Constructable { new: (A...) -> T } | (A...) -> T
]=]
type Constructable<T, A...> = { new: (A...) -> T } | (A...) -> T

--[=[
	@within Trove
	@interface Destroyable
	.Destroy (self) -> ()
]=]
type Destroyable = {
	Destroy: (self: Destroyable) -> (),
}

--[=[
	@within Trove
	@interface DestroyableMetatable
	.Destroy (self) -> ()
	@tag Metatable
]=]
type DestroyableMetatable = typeof(setmetatable({}, {} :: { Destroy: (self: DestroyableMetatable) -> () }))

--[=[
	@within Trove
	@interface DestroyableLowercase
	.destroy (self) -> ()
]=]
type DestroyableLowercase = {
	destroy: (self: DestroyableLowercase) -> (),
}

--[=[
	@within Trove
	@interface DestroyableLowercaseMetatable
	.destroy (self) -> ()
	@tag Metatable
]=]
type DestroyableLowercaseMetatable = typeof(setmetatable(
	{},
	{} :: { destroy: (self: DestroyableLowercaseMetatable) -> () }
))

--[=[
	@within Trove
	@interface Disconnectable
	.Disconnect (self) -> ()
]=]
type Disconnectable = {
	Disconnect: (self: Disconnectable) -> (),
}

--[=[
	@within Trove
	@interface DisconectableMetatable
	.Disconnect (self) -> ()
	@tag Metatable
]=]
type DisconectableMetatable = typeof(setmetatable({}, {} :: { Disconnect: (self: DisconectableMetatable) -> () }))

--[=[
	@within Trove
	@interface DisconnectableLowercase
	.disconnect (self) -> ()
]=]
type DisconnectableLowercase = {
	disconnect: (self: DisconnectableLowercase) -> (),
}

--[=[
	@within Trove
	@interface DisconnectableLowercaseMetatable
	.disconnect (self) -> ()
	@tag Metatable
]=]
type DisconnectableLowercaseMetatable = typeof(setmetatable(
	{},
	{} :: { disconnect: (self: DisconnectableLowercaseMetatable) -> () }
))

local FN_MARKER = newproxy()
local THREAD_MARKER = newproxy()
local GENERIC_OBJECT_CLEANUP_METHODS = table.freeze({ "Destroy", "Disconnect", "destroy", "disconnect" })

local function getObjectCleanupFunction(object: any, cleanupMethod: string?)
	local t = typeof(object)

	if t == "function" then
		return FN_MARKER
	elseif t == "thread" then
		return THREAD_MARKER
	end

	if cleanupMethod then
		return cleanupMethod
	end

	if t == "Instance" then
		return "Destroy"
	elseif t == "RBXScriptConnection" then
		return "Disconnect"
	elseif t == "table" then
		for _, genericCleanupMethod in GENERIC_OBJECT_CLEANUP_METHODS do
			if typeof(object[genericCleanupMethod]) == "function" then
				return genericCleanupMethod
			end
		end
	end

	error(`failed to get cleanup function for object {t}: {object}`, 3)
end

local function assertPromiseLike(object: any)
	if
		typeof(object) ~= "table"
		or typeof(object.getStatus) ~= "function"
		or typeof(object.finally) ~= "function"
		or typeof(object.cancel) ~= "function"
	then
		error("did not receive a promise as an argument", 3)
	end
end

local function assertSignalLike(object: any)
	if
		typeof(object) ~= "RBXScriptSignal"
		and (typeof(object) ~= "table" or typeof(object.Connect) ~= "function" or typeof(object.Once) ~= "function")
	then
		error("did not receive a signal as an argument", 3)
	end
end

--[=[
	@class Trove
	A Trove is helpful for tracking any sort of object during
	runtime that needs to get cleaned up at some point.
]=]
local Trove = {}
Trove.__index = Trove

--[=[
	@return Trove
	Constructs a Trove object.

	```lua
	local trove = Trove.new()
	```
]=]
function Trove.new(): Trove
	local self = setmetatable({}, Trove)

	self._objects = {}
	self._cleaning = false

	return (self :: any) :: Trove
end

--[=[
	@method Add
	@within Trove
	@param object any -- Object to track
	@param cleanupMethod string? -- Optional cleanup name override
	@return object: any
	Adds an object to the trove. Once the trove is cleaned or
	destroyed, the object will also be cleaned up.

	The following types are accepted (e.g. `typeof(object)`):

	| Type | Cleanup |
	| ---- | ------- |
	| `Instance` | `object:Destroy()` |
	| `RBXScriptConnection` | `object:Disconnect()` |
	| `function` | `object()` |
	| `thread` | `task.cancel(object)` |
	| `table` | `object:Destroy()` _or_ `object:Disconnect()` _or_ `object:destroy()` _or_ `object:disconnect()` |
	| `table` with `cleanupMethod` | `object:<cleanupMethod>()` |

	Returns the object added.

	```lua
	-- Add a part to the trove, then destroy the trove,
	-- which will also destroy the part:
	local part = Instance.new("Part")
	trove:Add(part)
	trove:Destroy()

	-- Add a function to the trove:
	trove:Add(function()
		print("Cleanup!")
	end)
	trove:Destroy()

	-- Standard cleanup from table:
	local tbl = {}
	function tbl:Destroy()
		print("Cleanup")
	end
	trove:Add(tbl)

	-- Custom cleanup from table:
	local tbl = {}
	function tbl:DoSomething()
		print("Do something on cleanup")
	end
	trove:Add(tbl, "DoSomething")
	```
]=]
function Trove.Add(self: TroveInternal, object: Trackable, cleanupMethod: string?): any
	if self._cleaning then
		error("cannot call trove:Add() while cleaning", 2)
	end

	local cleanup = getObjectCleanupFunction(object, cleanupMethod)
	table.insert(self._objects, { object, cleanup })

	return object
end

--[=[
	@method Clone
	@within Trove
	@return Instance
	Clones the given instance and adds it to the trove. Shorthand for
	`trove:Add(instance:Clone())`.

	```lua
	local clonedPart = trove:Clone(somePart)
	```
]=]
function Trove.Clone(self: TroveInternal, instance: Instance): Instance
	if self._cleaning then
		error("cannot call trove:Clone() while cleaning", 2)
	end

	return self:Add(instance:Clone())
end

--[=[
	@method Construct
	@within Trove
	@param class { new(Args...) -> T } | (Args...) -> T
	@param ... Args...
	@return T
	Constructs a new object from either the
	table or function given.

	If a table is given, the table's `new`
	function will be called with the given
	arguments.

	If a function is given, the function will
	be called with the given arguments.

	The result from either of the two options
	will be added to the trove.

	This is shorthand for `trove:Add(SomeClass.new(...))`
	and `trove:Add(SomeFunction(...))`.

	```lua
	local Signal = require(somewhere.Signal)

	-- All of these are identical:
	local s = trove:Construct(Signal)
	local s = trove:Construct(Signal.new)
	local s = trove:Construct(function() return Signal.new() end)
	local s = trove:Add(Signal.new())

	-- Even Roblox instances can be created:
	local part = trove:Construct(Instance, "Part")
	```
]=]
function Trove.Construct<T, A...>(self: TroveInternal, class: Constructable<T, A...>, ...: A...)
	if self._cleaning then
		error("Cannot call trove:Construct() while cleaning", 2)
	end

	local object = nil
	local t = type(class)
	if t == "table" then
		object = (class :: any).new(...)
	elseif t == "function" then
		object = (class :: any)(...)
	end

	return self:Add(object)
end

--[=[
	@method Connect
	@within Trove
	@param signal RBXScriptSignal
	@param fn (...: any) -> ()
	@return RBXScriptConnection
	Connects the function to the signal, adds the connection
	to the trove, and then returns the connection.

	This is shorthand for `trove:Add(signal:Connect(fn))`.

	```lua
	trove:Connect(workspace.ChildAdded, function(instance)
		print(instance.Name .. " added to workspace")
	end)
	```
]=]
function Trove.Connect(
	self: TroveInternal,
	signal: SignalLike | SignalLikeMetatable | RBXScriptSignal,
	fn: (...any) -> ...any
)
	if self._cleaning then
		error("Cannot call trove:Connect() while cleaning", 2)
	end
	assertSignalLike(signal)

	local confirmedSignal = signal :: SignalLike

	return self:Add(confirmedSignal:Connect(fn))
end

--[=[
	@method Once
	@within Trove
	@param signal RBXScriptSignal
	@param fn (...: any) -> ()
	@return RBXScriptConnection
	Connects the function to the signal using the `Once`
	method, adds the connection to the trove, and then
	returns the connection.

	This is shorthand for `trove:Add(signal:Once(fn))`.

	```lua
	trove:Connect(workspace.ChildAdded, function(instance)
		print(instance.Name .. " added to workspace")
	end)
	```
]=]
function Trove.Once(
	self: TroveInternal,
	signal: SignalLike | SignalLikeMetatable | RBXScriptSignal,
	fn: (...any) -> ...any
)
	if self._cleaning then
		error("Cannot call trove:Connect() while cleaning", 2)
	end
	assertSignalLike(signal)

	local confirmedSignal = signal :: SignalLike

	local conn
	conn = confirmedSignal:Once(function(...)
		fn(...)
		self:Pop(conn)
	end)

	return self:Add(conn)
end

--[=[
	@method BindToRenderStep
	@within Trove
	@param name string
	@param priority number
	@param fn (dt: number) -> ()
	Calls `RunService:BindToRenderStep` and registers a function in the
	trove that will call `RunService:UnbindFromRenderStep` on cleanup.

	```lua
	trove:BindToRenderStep("Test", Enum.RenderPriority.Last.Value, function(dt)
		-- Do something
	end)
	```
]=]
function Trove.BindToRenderStep(self: TroveInternal, name: string, priority: number, fn: (dt: number) -> ())
	if self._cleaning then
		error("cannot call trove:BindToRenderStep() while cleaning", 2)
	end

	RunService:BindToRenderStep(name, priority, fn)

	self:Add(function()
		RunService:UnbindFromRenderStep(name)
	end)
end

--[=[
	@method AddPromise
	@within Trove
	@param promise Promise
	@return Promise
	Gives the promise to the trove, which will cancel the promise if the trove is cleaned up or if the promise
	is removed. The exact promise is returned, thus allowing chaining.

	```lua
	trove:AddPromise(doSomethingThatReturnsAPromise())
		:andThen(function()
			print("Done")
		end)
	-- Will cancel the above promise (assuming it didn't resolve immediately)
	trove:Clean()

	local p = trove:AddPromise(doSomethingThatReturnsAPromise())
	-- Will also cancel the promise
	trove:Remove(p)
	```

	:::caution Promise v4 Only
	This is only compatible with the [roblox-lua-promise](https://eryn.io/roblox-lua-promise/) library, version 4.
	:::
]=]
function Trove.AddPromise(self: TroveInternal, promise: PromiseLike | PromiseLikeMetatable)
	if self._cleaning then
		error("cannot call trove:AddPromise() while cleaning", 2)
	end
	assertPromiseLike(promise)
	local confirmedPromise = promise :: PromiseLike

	if confirmedPromise:getStatus() == "Started" then
		confirmedPromise:finally(function()
			if self._cleaning then
				return
			end
			self:_findAndRemoveFromObjects(confirmedPromise, false)
		end)

		self:Add(confirmedPromise, "cancel")
	end

	return confirmedPromise
end

--[=[
	@method Remove
	@within Trove
	@param object any
	Removes the object from the Trove and cleans it up. To remove without
	cleaning, use the `Pop` method instead.

	```lua
	local part = Instance.new("Part")
	trove:Add(part)
	trove:Remove(part) -- Part is destroyed
	```
]=]
function Trove.Remove(self: TroveInternal, object: Trackable): boolean
	if self._cleaning then
		error("cannot call trove:Remove() while cleaning", 2)
	end

	return self:_findAndRemoveFromObjects(object, true)
end

--[=[
	@method Pop
	@within Trove
	@param object any
	Removes the object from the Trove, but does _not_ clean it up. To
	clean up the object on removal, use the `Remove` method instead.

	```lua
	local part = Instance.new("Part")
	trove:Add(part)
	trove:Pop(part)
	trove:Clean() -- Part is NOT destroyed
	```
]=]
function Trove.Pop(self: TroveInternal, object: Trackable): boolean
	if self._cleaning then
		error("cannot call trove:Pop() while cleaning", 2)
	end

	return self:_findAndRemoveFromObjects(object, false)
end

--[=[
	@method Extend
	@within Trove
	@return Trove
	Creates and adds another trove to itself. This is just shorthand
	for `trove:Construct(Trove)`. This is useful for contexts where
	the trove object is present, but the class itself isn't.

	:::note
	This does _not_ clone the trove. In other words, the objects in the
	trove are not given to the new constructed trove. This is simply to
	construct a new Trove and add it as an object to track.
	:::

	```lua
	local trove = Trove.new()
	local subTrove = trove:Extend()

	trove:Clean() -- Cleans up the subTrove too
	```
]=]
function Trove.Extend(self: TroveInternal)
	if self._cleaning then
		error("cannot call trove:Extend() while cleaning", 2)
	end

	return self:Construct(Trove)
end

--[=[
	@method Clean
	@within Trove
	Cleans up all objects in the trove. This is
	similar to calling `Remove` on each object
	within the trove. The ordering of the objects
	removed is _not_ guaranteed.

	```lua
	trove:Clean()
	```
]=]
function Trove.Clean(self: TroveInternal)
	if self._cleaning then
		return
	end

	self._cleaning = true

	for _, obj in self._objects do
		self:_cleanupObject(obj[1], obj[2])
	end

	table.clear(self._objects)
	self._cleaning = false
end

--[=[
	@method WrapClean
	@within Trove
	Returns a function that wraps the trove's `Clean()`
	method. Calling the returned function will clean up
	the trove.

	This is often useful in contexts where functions
	are the primary mode for cleaning up an environment,
	such as in many "observer" patterns.

	```lua
	local cleanup = trove:WrapClean()

	-- Sometime later...
	cleanup()
	```

	```lua
	-- Common observer pattern example:
	someObserver(function()
		local trove = Trove.new()
		-- Foo
		return trove:WrapClean()
	end)
	```
]=]
function Trove.WrapClean(self: TroveInternal)
	return function()
		self:Clean()
	end
end

function Trove._findAndRemoveFromObjects(self: TroveInternal, object: any, cleanup: boolean): boolean
	local objects = self._objects

	for i, obj in objects do
		if obj[1] == object then
			local n = #objects
			objects[i] = objects[n]
			objects[n] = nil

			if cleanup then
				self:_cleanupObject(obj[1], obj[2])
			end

			return true
		end
	end

	return false
end

function Trove._cleanupObject(_self: TroveInternal, object: any, cleanupMethod: string?)
	if cleanupMethod == FN_MARKER then
		task.spawn(object)
	elseif cleanupMethod == THREAD_MARKER then
		pcall(task.cancel, object)
	else
		object[cleanupMethod](object)
	end
end

--[=[
	@method AttachToInstance
	@within Trove
	@param instance Instance
	@return RBXScriptConnection
	Attaches the trove to a Roblox instance. Once this
	instance is removed from the game (parent or ancestor's
	parent set to `nil`), the trove will automatically
	clean up.

	This inverses the ownership of the Trove object, and should
	only be used when necessary. In other words, the attached
	instance dictates when the trove is cleaned up, rather than
	the trove dictating the cleanup of the instance.

	:::caution
	Will throw an error if `instance` is not a descendant
	of the game hierarchy.
	:::

	```lua
	trove:AttachToInstance(somePart)
	trove:Add(function()
		print("Cleaned")
	end)

	-- Destroying the part will cause the trove to clean up, thus "Cleaned" printed:
	somePart:Destroy()
	```
]=]
function Trove.AttachToInstance(self: TroveInternal, instance: Instance)
	if self._cleaning then
		error("cannot call trove:AttachToInstance() while cleaning", 2)
	elseif not instance:IsDescendantOf(game) then
		error("instance is not a descendant of the game hierarchy", 2)
	end

	return self:Connect(instance.Destroying, function()
		self:Destroy()
	end)
end

--[=[
	@method Destroy
	@within Trove
	Alias for `trove:Clean()`.

	```lua
	trove:Destroy()
	```
]=]
function Trove.Destroy(self: TroveInternal)
	self:Clean()
end

return {
	new = Trove.new,
}
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="79">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="80">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="81">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — Server Bootstrap
	Wires remotes + services. Request/action remotes only.

	v65 CRITICAL: DataService.Init FIRST; then Economy/Base; remotes before MapSetup.
	Map densify InsertService must never block EconomyUpdate (HUD $… forever).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local DevConfig = require(Shared.Configs.DevConfig)

local ServerFolder = script.Parent
local Modules = ServerFolder:WaitForChild("Modules")
local Services = ServerFolder:WaitForChild("Services")

print("[WAR EMPIRE] Server Bootstrap starting...")

-- ── 1. REMOTES FIRST (before any MapSetup / InsertService) ─────────────────
local RemoteSetup = require(Modules.RemoteSetup)
RemoteSetup.Init() -- client Remotes.GetEvent / EconomyUpdate must never hang on empty folder
print("[WAR EMPIRE] Remotes ready BEFORE map (v60 WE_Remotes + cash-first)")

local function safeRequire(label: string, moduleScript: ModuleScript): any
	local ok, mod = pcall(require, moduleScript)
	if not ok then
		warn("[WAR EMPIRE] require FAILED:", label, mod)
		return nil
	end
	return mod
end

local DataService = safeRequire("DataService", Services.DataService)
local EconomyService = safeRequire("EconomyService", Services.EconomyService)
local BaseService = safeRequire("BaseService", Services.BaseService)
local XPService = safeRequire("XPService", Services.XPService)
local RateLimitService = safeRequire("RateLimitService", Services.RateLimitService)
local AnalyticsService = safeRequire("AnalyticsService", Services.AnalyticsService)
local AdminService = safeRequire("AdminService", Services.AdminService)
local NotificationService = safeRequire("NotificationService", Services.NotificationService)
local AntiExploitService = safeRequire("AntiExploitService", Services.AntiExploitService)
local CombatService = safeRequire("CombatService", Services.CombatService)
local VehicleService = safeRequire("VehicleService", Services.VehicleService)
local TerritoryService = safeRequire("TerritoryService", Services.TerritoryService)
local MissionService = safeRequire("MissionService", Services.MissionService)
local PrestigeService = safeRequire("PrestigeService", Services.PrestigeService)
local ClanService = safeRequire("ClanService", Services.ClanService)
local MonetizationService = safeRequire("MonetizationService", Services.MonetizationService)
local TutorialService = safeRequire("TutorialService", Services.TutorialService)
local BattlePassService = safeRequire("BattlePassService", Services.BattlePassService)
local SoldierService = safeRequire("SoldierService", Services.SoldierService)
local BusinessService = safeRequire("BusinessService", Services.BusinessService) -- v72 war businesses + next-buy pick
local SquadOrdersService = safeRequire("SquadOrdersService", Services.SquadOrdersService)
local SeasonService = safeRequire("SeasonService", Services.SeasonService)
local ClanWarService = safeRequire("ClanWarService", Services.ClanWarService)
local CodesService = safeRequire("CodesService", Services.CodesService)
local NationColorService = safeRequire("NationColorService", Services.NationColorService)
local CaptureStipendService = safeRequire("CaptureStipendService", Services.CaptureStipendService)
local SupplyDropService = safeRequire("SupplyDropService", Services.SupplyDropService)
local BankRaidService = safeRequire("BankRaidService", Services.BankRaidService)
local OpsService = safeRequire("OpsService", Services.OpsService) -- W3s2 Phase B Jobs (OpsConfig.Enabled; ships off)
local SpinnerService = safeRequire("SpinnerService", Services.SpinnerService)
local UpgradePadService = safeRequire("UpgradePadService", Services.UpgradePadService)
local PremiumPadService = safeRequire("PremiumPadService", Services.PremiumPadService)
local FallSafetyService = safeRequire("FallSafetyService", Services.FallSafetyService)
local MoneyCollectorService = safeRequire("MoneyCollectorService", Services.MoneyCollectorService)
local ManualDropperService = safeRequire("ManualDropperService", Services.ManualDropperService)
local VisualAssetService = safeRequire("VisualAssetService", Services.VisualAssetService)
local GateDefenseService = safeRequire("GateDefenseService", Services.GateDefenseService)
local ResearchService = safeRequire("ResearchService", Services.ResearchService) -- v69 Research Lab upgrades
local MissileStrikeService = safeRequire("MissileStrikeService", Services.MissileStrikeService) -- v69 CC strikes
local PlotOilPumpService = safeRequire("PlotOilPumpService", Services.PlotOilPumpService)
local StudioBuySmoke = safeRequire("StudioBuySmoke", Modules.StudioBuySmoke)

RemoteSetup.Init() -- idempotent; ensure remotes still present after requires

local deps: { [string]: any } = {
	RemoteSetup = RemoteSetup,
	DataService = DataService,
	EconomyService = EconomyService,
	BaseService = BaseService,
	XPService = XPService,
	RateLimitService = RateLimitService,
	AnalyticsService = AnalyticsService,
	AdminService = AdminService,
	NotificationService = NotificationService,
	AntiExploitService = AntiExploitService,
	CombatService = CombatService,
	VehicleService = VehicleService,
	TerritoryService = TerritoryService,
	MissionService = MissionService,
	PrestigeService = PrestigeService,
	ClanService = ClanService,
	MonetizationService = MonetizationService,
	TutorialService = TutorialService,
	BattlePassService = BattlePassService,
	SoldierService = SoldierService,
	BusinessService = BusinessService,
	SquadOrdersService = SquadOrdersService,
	SeasonService = SeasonService,
	ClanWarService = ClanWarService,
	CodesService = CodesService,
	NationColorService = NationColorService,
	CaptureStipendService = CaptureStipendService,
	SupplyDropService = SupplyDropService,
	BankRaidService = BankRaidService,
	OpsService = OpsService,
	SpinnerService = SpinnerService,
	UpgradePadService = UpgradePadService,
	PremiumPadService = PremiumPadService,
	FallSafetyService = FallSafetyService,
	MoneyCollectorService = MoneyCollectorService,
	VisualAssetService = VisualAssetService,
	ManualDropperService = ManualDropperService,
	GateDefenseService = GateDefenseService,
	ResearchService = ResearchService,
	MissileStrikeService = MissileStrikeService,
	PlotOilPumpService = PlotOilPumpService,
}

local function safeInit(label: string, svc: any, ...: any)
	if svc == nil then
		warn("[WAR EMPIRE] skip Init (nil):", label)
		return
	end
	local args = { ... }
	local ok, err = pcall(function()
		if #args > 0 then
			svc.Init(table.unpack(args))
		else
			svc.Init()
		end
	end)
	if not ok then
		warn("[WAR EMPIRE] Init FAILED:", label, err)
	end
end

-- v45: set after BaseService Init — refresh kits/walls after any map rebuild (race fix)
local afterMapRebuild: (() -> ())? = nil

local function notifyMapRebuilt(label: string)
	if afterMapRebuild then
		print("[WAR EMPIRE] afterMapRebuild → RefreshAllOnlinePlayers (" .. label .. ")")
		task.defer(afterMapRebuild)
	end
end

-- ── 2. CASH PATH FIRST (instant profile + Push; map must not block) ─────────
-- v65: warn loudly if safeRequire failed (nil module → Buy GetProfile crash)
if DataService == nil then
	warn("[WAR EMPIRE] CRITICAL: DataService safeRequire FAILED — buy path will break until fixed")
end
if EconomyService == nil then
	warn("[WAR EMPIRE] CRITICAL: EconomyService safeRequire FAILED")
end
if BaseService == nil then
	warn("[WAR EMPIRE] CRITICAL: BaseService safeRequire FAILED")
end

safeInit("RateLimitService", RateLimitService)
safeInit("AnalyticsService", AnalyticsService)
if DataService and AnalyticsService and DataService.SetAnalytics then
	pcall(DataService.SetAnalytics, AnalyticsService)
end

-- v65 CRITICAL: DataService.Init FIRST before Economy/Base/UpgradePad
-- (module-local DataService in BaseService was nil when Init order raced / deps cleared)
safeInit("DataService", DataService)
print("[WAR EMPIRE] DataService Init FIRST (v65) — before Economy/Base/UpgradePad")

-- v66: warn only. The v65 assert killed this whole script when DataService failed to load
-- (ProfileSchema parse error since v50), so no purchase handler, map or later service ever ran.
if deps.DataService == nil then
	warn("[WAR EMPIRE] CRITICAL: deps.DataService is nil before BaseService.Init — buy will fail")
end

safeInit("NotificationService", NotificationService, deps)
-- v69: TutorialService right after its deps (DataService, RemoteSetup, RateLimit, Notification) and BEFORE every
-- service that calls TutorialService.Notify (Economy, MoneyCollector, ManualDropper, Base …). BaseService's
-- OnProfileLoaded fires at once for already-loaded players and used to call Notify before this Init → threw.
-- (TutorialService.Init only needs BaseService.GetUpgradeChangedEvent, which works before BaseService.Init.)
safeInit("TutorialService", TutorialService, deps)
safeInit("AntiExploitService", AntiExploitService, deps)
safeInit("MonetizationService", MonetizationService, deps)
safeInit("EconomyService", EconomyService, deps)
safeInit("XPService", XPService, deps)
safeInit("MoneyCollectorService", MoneyCollectorService, deps)
safeInit("ManualDropperService", ManualDropperService, deps)
safeInit("BaseService", BaseService, deps) -- registers OnProfileLoaded + PurchaseUpgrade remote
afterMapRebuild = function()
	if BaseService and BaseService.RefreshAllOnlinePlayers then
		pcall(BaseService.RefreshAllOnlinePlayers)
	end
end
print("[WAR EMPIRE] DataService/EconomyService ready BEFORE map (v61)")
print("[WAR EMPIRE] v65 DataService-first + getDataService fallback + attribute-ack buy")
safeInit("UpgradePadService", UpgradePadService, deps)
safeInit("PremiumPadService", PremiumPadService, deps)
safeInit("FallSafetyService", FallSafetyService, deps)

-- Belt: EconomyService.Push within first second regardless of map state
do
	local Players = game:GetService("Players")
	local function earlyCashPush(player: Player)
		task.spawn(function()
			local deadline = os.clock() + 1.0
			while os.clock() < deadline do
				local profile = nil
				if DataService and DataService.GetProfile then
					profile = DataService.GetProfile(player)
				end
				if profile then
					if EconomyService and EconomyService.Push then
						pcall(EconomyService.Push, player)
					end
					return
				end
				task.wait(0.05)
			end
			if DataService and DataService.EnsureProfile then
				pcall(DataService.EnsureProfile, player)
			end
			if EconomyService and EconomyService.Push then
				pcall(EconomyService.Push, player)
			end
		end)
	end
	Players.PlayerAdded:Connect(earlyCashPush)
	for _, plr in ipairs(Players:GetPlayers()) do
		earlyCashPush(plr)
	end
end

-- ── 3. MAP AFTER REMOTES + CASH (densify InsertService is deferred inside MapSetup) ─
-- NEVER let MapSetup parse/require failure abort remotes + HUD (live void bug).
local MapSetup: any = nil
do
	local okMap, mapOrErr = pcall(require, Modules.MapSetup)
	if okMap then
		MapSetup = mapOrErr
	else
		warn("[WAR EMPIRE] CRITICAL: require(MapSetup) FAILED — remotes already live. Err:", mapOrErr)
	end
end

local function ensureVoidFallback(reason: string)
	warn("[WAR EMPIRE] CRITICAL: MapSetup failed — installing void fallback. Reason: " .. tostring(reason))
	print("[WAR EMPIRE] ERROR: MapSetup did not build WarEmpireSetup. Creating emergency baseplate + spawn so players do not void-fall.")

	Workspace.Gravity = 196.2

	local existing = Workspace:FindFirstChild("WE_VoidFallback")
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = "WE_VoidFallback"
	folder.Parent = Workspace

	-- v70 (spec_final §12.1): 3 x 3 tiles of 1700 (a single 7000 plate exceeds Roblox's 2048 part-size cap). The centre
	-- tile keeps the name Baseplate.
	local TILE = 1700
	for i = -1, 1 do
		for j = -1, 1 do
			local baseplate = Instance.new("Part")
			baseplate.Name = if i == 0 and j == 0 then "Baseplate" else ("Baseplate_" .. tostring(i + 2) .. "_" .. tostring(j + 2))
			baseplate.Size = Vector3.new(TILE, 6, TILE)
			baseplate.Position = Vector3.new(i * TILE, -3, j * TILE)
			baseplate.Anchored = true
			baseplate.CanCollide = true
			baseplate.Material = Enum.Material.Grass
			baseplate.Color = Color3.fromRGB(40, 80, 40)
			baseplate.TopSurface = Enum.SurfaceType.Smooth
			baseplate.BottomSurface = Enum.SurfaceType.Smooth
			baseplate.Parent = folder
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "EmergencySpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 5, 0)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.BrickColor = BrickColor.new("Bright green")
	spawn.Material = Enum.Material.Neon
	spawn.Parent = folder

	print("[WAR EMPIRE] Void fallback ready: WE_VoidFallback Baseplate + EmergencySpawn at (0,5,0)")
end

local function runMapSetupOrFallback(reasonIfNil: string)
	if MapSetup == nil then
		ensureVoidFallback(reasonIfNil)
		return
	end
	local ok, err = pcall(function()
		MapSetup.Run()
	end)
	if not ok then
		ensureVoidFallback(err)
	elseif not Workspace:FindFirstChild("WarEmpireSetup") then
		ensureVoidFallback("MapSetup.Run returned but WarEmpireSetup missing")
	end
end

local function healOrRebuildMap(label: string)
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		print("[WAR EMPIRE] Map heal (" .. label .. "): WarEmpireSetup missing — Run()")
		runMapSetupOrFallback("MapSetup nil during heal (" .. label .. ")")
		notifyMapRebuilt(label .. ":missing-run")
		return
	end
	if MapSetup == nil then
		local map = setup:FindFirstChild("Map")
		local g = map and map:FindFirstChild("Ground")
		if not (g and g:IsA("BasePart") and g.CanCollide) then
			ensureVoidFallback("MapSetup nil and Ground unhealthy (" .. label .. ")")
		end
		return
	end
	Workspace.Gravity = 196.2
	if MapSetup.EnsureGroundHealthy then
		pcall(function()
			MapSetup.EnsureGroundHealthy(setup)
		end)
	end
	if MapSetup.ForceRebuildGround then
		local okRebuild, rebuildResult = pcall(function()
			return MapSetup.ForceRebuildGround(setup)
		end)
		if not (okRebuild and rebuildResult == true) then
			warn("[WAR EMPIRE] ForceRebuildGround failed (" .. label .. ") — full MapSetup.Run")
			pcall(function()
				setup:Destroy()
				MapSetup.Run()
			end)
			notifyMapRebuilt(label .. ":ForceRebuildGround-Run")
			if not Workspace:FindFirstChild("WarEmpireSetup") then
				ensureVoidFallback("ForceRebuildGround failed (" .. label .. ")")
			end
		end
	end
end

-- v70: a saved / baked WarEmpireSetup from another layout generation (WE_MapGen ~= MapSetup.MAP_GEN: unturned plots,
-- one WaterPlane, untiled ground) is rebuilt from scratch instead of healed.
local function isStaleMapGen(setup: Instance?): boolean
	if setup == nil or MapSetup == nil or MapSetup.MAP_GEN == nil then
		return false
	end
	return setup:GetAttribute("WE_MapGen") ~= MapSetup.MAP_GEN
end

-- Run map build/heal AFTER remotes exist (never blocks EconomyUpdate creation)
if not Workspace:FindFirstChild("WarEmpireSetup") then
	runMapSetupOrFallback("MapSetup module failed to load")
elseif isStaleMapGen(Workspace:FindFirstChild("WarEmpireSetup")) then
	local stale = Workspace:FindFirstChild("WarEmpireSetup") :: Instance
	print(
		"[WAR EMPIRE] WarEmpireSetup is map gen "
			.. tostring(stale:GetAttribute("WE_MapGen"))
			.. " (want "
			.. tostring(MapSetup.MAP_GEN)
			.. ") — full MapSetup.Run (stale map gen)"
	)
	pcall(function()
		stale:Destroy()
	end)
	runMapSetupOrFallback("stale map gen")
	notifyMapRebuilt("bootstrap-staleMapGen")
else
	print("[WAR EMPIRE] WarEmpireSetup already present — skipping MapSetup.Run (FORCE rebuild Ground + SafetyCatch)")
	Workspace.Gravity = 196.2
	local CollectionService = game:GetService("CollectionService")
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	-- v70: the ground is 16 tiles of MapSetup.GROUND_TILE_SIZE (Map.Ground is one of them)
	local targetSize = (MapSetup and (MapSetup.GROUND_TILE_SIZE or MapSetup.GROUND_SIZE)) or 6400

	healOrRebuildMap("bootstrap-existing")

	setup = Workspace:FindFirstChild("WarEmpireSetup")
	local mapFolder = setup and setup:FindFirstChild("Map")
	local g = mapFolder and mapFolder:FindFirstChild("Ground")
	local catch = mapFolder and mapFolder:FindFirstChild("SafetyCatch")
	if g and g:IsA("BasePart") then
		g.CanCollide = true
		g.Anchored = true
		local tiles = if setup and MapSetup and MapSetup.CountGroundTiles then MapSetup.CountGroundTiles(setup) else 1
		local wantTiles = (MapSetup and MapSetup.GROUND_TILES) or 1
		print(string.format(
			"[WAR EMPIRE] Ground AFTER heal: size=%.0fx%.0fx%.0f tiles=%d/%d CanCollide=%s SafetyCatch=%s",
			g.Size.X,
			g.Size.Y,
			g.Size.Z,
			tiles,
			wantTiles,
			tostring(g.CanCollide),
			tostring(catch ~= nil)
		))
		if g.Size.X < targetSize - 1 or g.CanCollide ~= true or tiles < wantTiles then
			warn("[WAR EMPIRE] Ground still unhealthy after force rebuild — run admin resetmap (Studio)")
		end
	else
		warn("[WAR EMPIRE] Ground MISSING after force rebuild — run admin resetmap (Studio) MANDATORY")
	end

	setup = Workspace:FindFirstChild("WarEmpireSetup")
	if setup then
		local tagged = CollectionService:GetTagged(Constants.Tags.UpgradeSlot)
		local taggedCount = #tagged
		if taggedCount == 0 then
			local bases = setup:FindFirstChild("Bases")
			local retagged = 0
			if bases then
				for _, desc in ipairs(bases:GetDescendants()) do
					if desc:IsA("BasePart") then
						local sid = desc:GetAttribute("StructureId")
						local pid = desc:GetAttribute("PlotId")
						if typeof(sid) == "string" and typeof(pid) == "number" then
							CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
							desc.CanTouch = true
							retagged += 1
						end
					end
				end
			end
			if retagged == 0 then
				warn("[WAR EMPIRE] WarEmpireSetup present but no upgrade pads — rebuilding via MapSetup")
				pcall(function()
					setup:Destroy()
				end)
				runMapSetupOrFallback("Missing upgrade pads and MapSetup nil")
				notifyMapRebuilt("bootstrap-missingPads")
			else
				print("[WAR EMPIRE] Re-tagged", retagged, "upgrade pads with WE_UpgradeSlot")
			end
		else
			for _, inst in ipairs(tagged) do
				if inst:IsA("BasePart") then
					inst.CanTouch = true
				end
			end
			print("[WAR EMPIRE] Upgrade slots OK:", taggedCount)
		end
	end
end

-- v67: base labels stop drawing over everything (AlwaysOnTop off, capped range) — map exists now,
-- and DescendantAdded catches labels services create later (ATM, droppers, soldiers, gate).
do
	local WorldLabelPolicy = safeRequire("WorldLabelPolicy", Modules.WorldLabelPolicy)
	if WorldLabelPolicy and WorldLabelPolicy.Init then
		local okLabels, errLabels = pcall(WorldLabelPolicy.Init)
		if not okLabels then
			warn("[WAR EMPIRE] WorldLabelPolicy.Init failed:", errLabels)
		end
	end
end

-- PlayerAdded: heal map if somehow missing (late join / rare destroy)
do
	local Players = game:GetService("Players")
	local CollectionService = game:GetService("CollectionService")
	local function ensureMapForPlayer(player: Player)
		task.defer(function()
			local okHeal, errHeal = pcall(function()
				local setup = Workspace:FindFirstChild("WarEmpireSetup")
				if not setup and not Workspace:FindFirstChild("WE_VoidFallback") then
					warn("[WAR EMPIRE] PlayerAdded map missing for", player.Name, "— healing")
					healOrRebuildMap("PlayerAdded:" .. player.Name)
					notifyMapRebuilt("PlayerAdded:" .. player.Name)
					return
				end
				if not setup then
					return
				end
				local padCount = 0
				pcall(function()
					padCount = #CollectionService:GetTagged(Constants.Tags.UpgradeSlot)
				end)
				if padCount == 0 then
					local bases = setup:FindFirstChild("Bases")
					local hasPlotPad = false
					if bases then
						for _, d in ipairs(bases:GetDescendants()) do
							if d:IsA("BasePart") and d.Name == "PlotPad" then
								hasPlotPad = true
								break
							end
						end
					end
					if not hasPlotPad then
						warn("[WAR EMPIRE] PlayerAdded: WarEmpireSetup has no PlotPad/upgrade pads — full MapSetup rebuild for", player.Name)
						pcall(function()
							setup:Destroy()
						end)
						local voidFb = Workspace:FindFirstChild("WE_VoidFallback")
						if voidFb then
							pcall(function()
								voidFb:Destroy()
							end)
						end
						healOrRebuildMap("PlayerAdded-missingPads:" .. player.Name)
						notifyMapRebuilt("PlayerAdded-missingPads:" .. player.Name)
						return
					end
				end
				if MapSetup and MapSetup.EnsureGroundHealthy then
					MapSetup.EnsureGroundHealthy(setup)
				end
			end)
			if not okHeal then
				warn("[WAR EMPIRE] PlayerAdded map heal error (remotes continue):", errHeal)
			end
		end)
	end
	Players.PlayerAdded:Connect(ensureMapForPlayer)
	for _, plr in ipairs(Players:GetPlayers()) do
		ensureMapForPlayer(plr)
	end
end

-- ── 4. Remaining services ───────────────────────────────────────────────────
safeInit("StudioBuySmoke", StudioBuySmoke, deps)
safeInit("AdminService", AdminService, deps)
