		BogBrake = 250,
		EntryPush = 4,
		EntrySearchStuds = 160,
		PillTag = "BACK OUT",
		PillTagForward = "DRIVE OUT",
		ReverseBand = 0.09,
		BackOutSteerLock = true,
		PlaneTag = "IN WATER",
		WadeSpeedFrac = 0.4,
		Amphibious = {},
	},
	Modes = {
		Car = {
			ReverseFrac = 0.45,
			ReverseAccelFrac = 0.7,
			TurnSpeedRef = 12,
			YawResyncRad = 0.6,
			-- rollover fix: flip recovery (VehicleConfig.Drive.Modes.Car; Laws.FlipRecover)
			FlipUpY = 0.5,
			FlipSeconds = 1.5,
			RecoverSpeed = 3,
			RecoverLift = 2.5,
			RecoverLiftSpeed = 6,
			RecoverDoneUpY = 0.9,
			RecoverMaxSeconds = 2.5,
