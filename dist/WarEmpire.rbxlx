local function ensureFolder(name, parent)
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function part(props: { [string]: any })
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	-- Explicit safe assignment (avoid (p :: any)[k] = v strict/runtime quirks)
	if props.Name ~= nil then
		p.Name = props.Name
	end
	if props.Size ~= nil then
		p.Size = props.Size
	end
	if props.CFrame ~= nil then
		p.CFrame = props.CFrame
	elseif props.Position ~= nil then
		p.Position = props.Position
	end
	if props.Color ~= nil then
		p.Color = props.Color
	end
	if props.Material ~= nil then
		p.Material = props.Material
	end
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.Anchored ~= nil then
		p.Anchored = props.Anchored
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	if props.Parent ~= nil then
		p.Parent = props.Parent
	end
	-- Deco/kits: shadows off by default (huge Studio GPU win). Opt-in via CastShadow=true.
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	else
		p.CastShadow = false
	end

	return p
end

local function kitPart(parentPlinth, role, size, localOffset, color, material, shape)
	local p = part({
		Name = role,
		Size = size,
		CFrame = parentPlinth.CFrame * CFrame.new(localOffset),
		Color = color,
		Material = material or Enum.Material.Metal,
		CanCollide = false,
		Transparency = 1, -- hidden until BaseService.applyKitVisuals (L0 faint / L1+ solid)
		Parent = parentPlinth,
	})
	if shape then
		p.Shape = shape
	end
	p.CanTouch = false -- never steal walk-buy Touched from plinth
	p.CanQuery = false
	p.CastShadow = false
	p:SetAttribute("WE_KitRole", role)
	p:SetAttribute("WE_BaseSize", size)
	p:SetAttribute("WE_LocalOffset", localOffset)
	p:SetAttribute("WE_Decor", true)
	return p
end

local function neonEdge(parentPart, color, thickness)
	local t = thickness or 0.35
	local s = parentPart.Size
	local edges = {
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, s.Z * 0.5) },
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, -s.Z * 0.5) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(s.X * 0.5, s.Y * 0.5, 0) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(-s.X * 0.5, s.Y * 0.5, 0) },
	}
	for i, e in ipairs(edges) do
		local edge = part({
			Name = "Edge" .. i,
			Size = e[1],
			CFrame = parentPart.CFrame * CFrame.new(e[2]),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.15,
			Parent = parentPart.Parent,
		})
		edge:SetAttribute("WE_Decor", true)
	end
end

local function priceBillboard(parent, title, costLine, accent)
	-- Visual kits v2: larger readable price cards
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_PriceBillboard"
	bb.Size = UDim2.fromOffset(260, 110)
	bb.StudsOffset = Vector3.new(0, 9.5, 0)
	bb.AlwaysOnTop = false -- P0: never stack over ATM AlwaysOnTop
	bb.MaxDistance = 48 -- mobile: price cards near-only (was 1000)
	bb.Parent = parent

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(8, 10, 12)
	backdrop.BackgroundTransparency = 0.08
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Color = accent
	stroke.Thickness = 2
	stroke.Transparency = 0.1
	stroke.Parent = backdrop

	local titleLab = Instance.new("TextLabel")
	titleLab.Name = "Title"
	titleLab.Size = UDim2.new(1, -10, 0, 26)
	titleLab.Position = UDim2.fromOffset(5, 4)
	titleLab.BackgroundTransparency = 1
	titleLab.Text = title
	titleLab.TextColor3 = Color3.fromRGB(245, 245, 248)
	titleLab.TextScaled = true
	titleLab.Font = Enum.Font.GothamBold
	titleLab.TextStrokeTransparency = 0.4
	titleLab.Parent = backdrop

	local costLab = Instance.new("TextLabel")
	costLab.Name = "Cost"
	costLab.Size = UDim2.new(1, -10, 0, 56)
	costLab.Position = UDim2.fromOffset(5, 30)
	costLab.BackgroundTransparency = 1
	costLab.Text = "Lv 0 → 1\n" .. costLine
	costLab.TextColor3 = Color3.fromRGB(255, 215, 110)
	costLab.TextScaled = true
	costLab.Font = Enum.Font.GothamBold
	costLab.TextStrokeTransparency = 0.35
	costLab.Parent = backdrop
	return bb
end

local function plainBillboard(parent, text, size, offsetY, textColor)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(size.X, size.Y)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = false -- P0: only ATM may AlwaysOnTop when nearest
	bb.MaxDistance = 70 -- base/zone labels near-only (was 950)
	bb.Parent = parent

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(12, 14, 16)
	backdrop.BackgroundTransparency = 0.22
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(70, 90, 70)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = backdrop

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor or Color3.fromRGB(235, 240, 235)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.6
	label.Parent = backdrop
	return bb
end

local function beacon(parent, pos, color, name)
	part({
		Name = name or "Beacon",
		Size = Vector3.new(0.55, 12, 0.55),
		Position = pos + Vector3.new(0, 6, 0),
		Color = Color3.fromRGB(40, 45, 42),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = (name or "Beacon") .. "_Tip",
		Size = Vector3.new(1.6, 1.6, 1.6),
		Position = pos + Vector3.new(0, 13, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = (name or "Beacon") .. "_Glow",
		Size = Vector3.new(3.2, 0.4, 3.2),
		Position = pos + Vector3.new(0, 0.3, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		Parent = parent,
	})
end

local function buildStructureKit(plotFolder, plotId, pos, offset, def)
	local isCC = def.Id == "CommandCenter"
	local plinthSize = Vector3.new(8, 1.2, 8)
	local plinth = part({
		Name = def.Id,
		Size = plinthSize,
		Position = pos + offset,
		Color = def.Plinth,
		Transparency = 0.32,
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Parent = plotFolder,
	})
	plinth.CanTouch = true -- walk-over buy (Touched + Heartbeat)
	plinth:SetAttribute("PlotId", plotId)
	plinth:SetAttribute("StructureId", def.Id)
	plinth:SetAttribute("BaseSize", plinthSize)
	CollectionService:AddTag(plinth, TAG_SLOT)

	local kit = def.Kit
	-- Visual kits v2: distinct silhouettes, neon accents, doors/windows (modest part count)
	if kit == "hq" then
		kitPart(plinth, "Body", Vector3.new(5.5, 3.4, 5.5), Vector3.new(0, 2.3, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(6.4, 0.55, 6.4), Vector3.new(0, 4.3, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.8, 0.35), Vector3.new(1.8, 6.8, 1.8), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.22, 6.6), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.1, 1.1, 1.1), Vector3.new(-2, 3.6, -2), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Door", Vector3.new(1.6, 2.2, 0.25), Vector3.new(0, 1.7, -2.85), Color3.fromRGB(30, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.4, 1.0, 0.2), Vector3.new(2.0, 2.6, -2.8), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
	elseif kit == "barracks" then
		kitPart(plinth, "Body", Vector3.new(6.6, 2.6, 4.4), Vector3.new(0, 1.9, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.1, 0.5, 5.0), Vector3.new(0, 3.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(6.9, 0.18, 4.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(1.4, 2.0, 0.25), Vector3.new(0, 1.6, -2.3), Color3.fromRGB(35, 40, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.2, 0.9, 0.2), Vector3.new(-2.2, 2.3, -2.25), Color3.fromRGB(70, 120, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 1.8, 0.7), Vector3.new(-3.0, 2.3, 1.5), def.Accent, Enum.Material.Neon, nil)
	elseif kit == "depot" then
		kitPart(plinth, "Body", Vector3.new(6.9, 2.2, 5.6), Vector3.new(0, 1.7, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.3, 0.4, 6.1), Vector3.new(0, 2.95, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(3.2, 0.28, 5.9), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(2.8, 2.0, 0.3), Vector3.new(0, 1.6, -2.9), Color3.fromRGB(40, 50, 60), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.8, 2.4, 2.0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "lab" then
		kitPart(plinth, "Body", Vector3.new(5.1, 3.2, 5.1), Vector3.new(0, 2.2, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(5.5, 0.5, 5.5), Vector3.new(0, 4.0, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 3.8, 0.4), Vector3.new(0, 6.1, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(5.7, 0.2, 5.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Window", Vector3.new(1.5, 1.2, 0.2), Vector3.new(0, 2.6, -2.6), Color3.fromRGB(80, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.9, 0.9, 0.9), Vector3.new(2.0, 3.5, 2.0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "tower" then
		kitPart(plinth, "Body", Vector3.new(2.9, 5.8, 2.9), Vector3.new(0, 3.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(3.8, 0.5, 3.8), Vector3.new(0, 6.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.3, 3.5, 0.3), Vector3.new(0, 8.5, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(3.3, 0.22, 3.3), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Window", Vector3.new(1.0, 0.8, 0.2), Vector3.new(0, 4.5, -1.5), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 0.7, 0.7), Vector3.new(0, 7.0, 0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "dock" then
		kitPart(plinth, "Body", Vector3.new(7.5, 0.55, 7.5), Vector3.new(0, 0.9, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Pier", Vector3.new(8.8, 0.4, 2.4), Vector3.new(0, 1.15, 3.3), def.Roof, Enum.Material.Wood, nil)
		kitPart(plinth, "Accent", Vector3.new(7.2, 0.14, 0.4), Vector3.new(0, 1.25, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 2.8, 0.4), Vector3.new(3.3, 2.1, 2.6), def.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(1.8, 0.3, 1.2), Vector3.new(0, 1.35, 4.2), Color3.fromRGB(40, 55, 70), Enum.Material.Metal, nil)
	elseif kit == "pad" then
		kitPart(plinth, "Body", Vector3.new(7.3, 0.45, 7.3), Vector3.new(0, 0.92, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.14, 0.5), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(0.5, 0.14, 6.6), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Roof", Vector3.new(1.6, 0.3, 1.6), Vector3.new(0, 1.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(0.5, 0.5, 0.5), Vector3.new(2.8, 1.4, 2.8), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "wall" then
		kitPart(plinth, "Body", Vector3.new(7.5, 3.0, 1.5), Vector3.new(0, 2.1, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(7.7, 0.25, 1.7), Vector3.new(0, 3.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.4, 1.9), Vector3.new(0, 3.9, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(-3.2, 3.2, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(3.2, 3.2, 0), def.Accent, Enum.Material.Neon, nil)
	elseif kit == "power" then
		kitPart(plinth, "Body", Vector3.new(4.6, 3.6, 4.6), Vector3.new(0, 2.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(2.3, 2.3, 2.3), Vector3.new(0, 4.7, 0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Roof", Vector3.new(5.1, 0.4, 5.1), Vector3.new(0, 4.4, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.6, 2.5, 0.6), Vector3.new(2.0, 2.8, 2.0), Color3.fromRGB(60, 55, 40), Enum.Material.Metal, nil)
	elseif kit == "warehouse" then
		kitPart(plinth, "Body", Vector3.new(7.1, 2.8, 5.6), Vector3.new(0, 2.0, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.5, 6.1), Vector3.new(0, 3.55, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(7.3, 0.2, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(2.6, 2.2, 0.3), Vector3.new(0, 1.7, -2.95), Color3.fromRGB(50, 45, 38), Enum.Material.Metal, nil)
	else
		kitPart(plinth, "Body", Vector3.new(5.3, 3.5, 5.3), Vector3.new(0, 2.4, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(4.2, 1.2, 4.2), Vector3.new(0, 4.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.2, 0.35), Vector3.new(0, 7.2, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(5.9, 0.22, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.0, 3.5, -2.0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	end

	local cost = STARTER_COST[def.Id] or 0
	-- Prefer readable DisplayName; client refreshSlotBillboard rewrites when attached
	local displayNames = {
		CommandCenter = "Command Center",
		Barracks = "Barracks",
		VehicleDepot = "Vehicle Depot",
		WeaponsFacility = "Weapons Facility",
		Helipad = "Helipad",
		Dock = "Naval Dock",
		Airfield = "Airfield",
		DefensiveWalls = "Defensive Walls",
		Watchtowers = "Watchtowers",
		Radar = "Radar Station",
		ResearchLab = "Research Lab",
		MissileDefense = "Missile Defense",
		PowerStation = "Power Station",
		Warehouse = "Warehouse",
		SpecialForcesFacility = "Special Forces",
	}
	local nice = displayNames[def.Id] or def.Id
	local title = if isCC then ("★ " .. nice) else nice
	local rates = EconomyConfig.PassiveIncome and EconomyConfig.PassiveIncome.PerLevelRates
	local rate = if typeof(rates) == "table" then (tonumber(rates[def.Id]) or 0) else 0
	local incomeBit = if rate > 0 then (" · +$" .. tostring(rate) .. "/tick") else ""
	priceBillboard(plinth, title, "Lv 0 → 1 / $" .. tostring(cost) .. incomeBit, def.Accent)
	-- Optional free Creator Store building visual (skipped when StudioSkipWorldDressing)
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		vas.TryAttachBuildingVisual(plinth, def.Id)
	end)
	return plinth
end



-- Desert camo infantry Part kit — vest / helmet / shemagh accents, clearer rifle
local function makeSoldierKit(parentFolder, name, cf, bodyColor, labelText, labelColor, health, npcType, npcId)
	-- Visual props for Training Yard / static kits. R15-ready catalog overlay via VisualAssetConfig;
	-- Part-kit military placeholder (R6-ish ~5 stud) when mesh IDs missing / StudioSkipWorldDressing.
	-- Live combat NPCs use CombatService.SpawnNPC (BankGuard etc.).
	local model = Instance.new("Model")
	model.Name = name
	if npcId then
		model:SetAttribute("NPCId", npcId)
	end
	if npcType then
		model:SetAttribute("NPCType", npcType)
	end
	local desertBase = Color3.fromRGB(145, 125, 85)
	local camo = desertBase:Lerp(bodyColor, 0.45)
	local camoDark = Color3.fromRGB(
		math.clamp(math.floor(camo.R * 255) - 28, 20, 255),
		math.clamp(math.floor(camo.G * 255) - 22, 20, 255),
		math.clamp(math.floor(camo.B * 255) - 18, 20, 255)
	)
	-- v34: role Part-dress differentiation when mesh IDs reuse / insert fails
	local helmCol = camoDark
	local vestCol = camoDark
	local accentCol = labelColor or Color3.fromRGB(200, 140, 60)
	local role = if typeof(npcType) == "string" then npcType else ""
	if role == "Worker" then
		helmCol = Color3.fromRGB(95, 85, 55) -- soft tan helmet
		vestCol = Color3.fromRGB(80, 95, 60)
		accentCol = Color3.fromRGB(160, 200, 90)
	elseif role == "Infantry" then
		helmCol = Color3.fromRGB(45, 70, 40) -- olive steel
		vestCol = Color3.fromRGB(55, 75, 45)
		accentCol = Color3.fromRGB(180, 220, 120)
	elseif role == "HeavyInfantry" or role == "Heavy" then
		helmCol = Color3.fromRGB(35, 38, 42) -- dark armor helm
		vestCol = Color3.fromRGB(40, 45, 50)
		accentCol = Color3.fromRGB(230, 160, 50)
	elseif role == "Guard" or role == "GateGuard" or role == "BankGuard" then
		helmCol = Color3.fromRGB(30, 40, 55) -- navy / NVG
		vestCol = Color3.fromRGB(40, 50, 65)
		accentCol = Color3.fromRGB(90, 140, 220)
	end
	-- R6 torso = 2×2×1; lift so feet sit on ground (cf is approx mid-body)
	local torso = part({
		Name = "HumanoidRootPart",
		Size = Vector3.new(2, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = true,
		CFrame = cf,
		Parent = model,
	})
	local head = part({
		Name = "Head",
		Size = Vector3.new(1.05, 1.05, 1.05),
		Color = Color3.fromRGB(110, 85, 62),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 1.55, 0),
		Shape = Enum.PartType.Ball,
		Parent = model,
	})
	part({
		Name = "Helmet",
		Size = Vector3.new(1.2, 0.5, 1.2),
		Color = helmCol,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, 0.38, 0),
		Parent = model,
	})
	part({
		Name = "Shemagh",
		Size = Vector3.new(1.25, 0.45, 1.15),
		Color = Color3.fromRGB(200, 185, 150),
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, -0.32, 0.05),
		Parent = model,
	})
	part({
		Name = "Vest",
		Size = Vector3.new(2.1, 1.2, 1.15),
		Color = vestCol,
		Material = Enum.Material.Leather,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.15, 0),
		Parent = model,
	})
	part({
		Name = "VestPouch",
		Size = Vector3.new(1.5, 0.45, 0.3),
		Color = Color3.fromRGB(90, 80, 55),
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.05, -0.6),
		Parent = model,
	})
	-- R6 arms 1×2×1
	part({
		Name = "ArmL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-1.5, 0, 0),
		Parent = model,
	})
	part({
		Name = "ArmR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.5, 0, 0),
		Parent = model,
	})
	-- R6 legs 1×2×1
	part({
		Name = "LegL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "LegR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "BootL",
		Size = Vector3.new(1.05, 0.35, 1.15),
		Color = Color3.fromRGB(35, 32, 28),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -3.1, 0.1),
		Parent = model,
	})
	part({
		Name = "BootR",
		Size = Vector3.new(1.05, 0.35, 1.15),
		Color = Color3.fromRGB(35, 32, 28),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -3.1, 0.1),
		Parent = model,
	})
	part({
		Name = "RifleStock",
		Size = Vector3.new(0.3, 0.4, 0.9),
		Color = Color3.fromRGB(55, 48, 38),
		Material = Enum.Material.Wood,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.15, 0.35),
		Parent = model,
	})
	part({
		Name = "Rifle",
		Size = Vector3.new(0.25, 0.25, 2.4),
		Color = Color3.fromRGB(32, 34, 36),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.2, -0.95),
		Parent = model,
	})
	part({
		Name = "RifleBarrel",
		Size = Vector3.new(0.14, 0.14, 0.9),
		Color = Color3.fromRGB(25, 25, 28),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.22, -2.25),
		Parent = model,
	})
	part({
		Name = "Accent",
		Size = Vector3.new(1.6, 0.1, 0.28),
		Color = accentCol,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.85, -0.5),
		Parent = model,
	})
	if role == "HeavyInfantry" or role == "Heavy" then
		part({
			Name = "Pack",
			Size = Vector3.new(1.4, 1.5, 0.7),
			Color = Color3.fromRGB(40, 42, 38),
			Material = Enum.Material.Metal,
			Anchored = true,
			CanCollide = false,
			CFrame = torso.CFrame * CFrame.new(0, 0.4, 0.85),
			Parent = model,
		})
	end
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = health or 100
	hum.Health = health or 100
	-- Single nametag only via Billboard — kill default Humanoid nameplate
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.NameOcclusion = Enum.NameOcclusion.OccludeAll
	hum.Parent = model
	model.PrimaryPart = torso
	-- Optional free Soldier catalog visual (skipped when StudioSkipWorldDressing)
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		local kind = if typeof(npcType) == "string" and npcType ~= "" then npcType else "Soldier"
		vas.TryAttachCharacterVisual(model, kind)
	end)
	model.Parent = parentFolder
	CollectionService:AddTag(model, TAG_NPC_ENTITY)
	if labelText then
		-- One clean label on head (not also on torso)
		local bb = plainBillboard(head, labelText, Vector2.new(120, 24), 2.2, labelColor or Color3.fromRGB(255, 200, 140))
		bb.Name = "NPCLabel"
		bb.AlwaysOnTop = false
		bb.MaxDistance = 18
		bb.StudsOffset = Vector3.new(0, 2.4, 0)
	end
	return model
end


-- Continuous floor + safety catch + perimeter mountain ring (mobile-friendly part count)
local function groundCenterY(): number
	return GROUND_TOP_Y - GROUND_THICKNESS * 0.5
end

local function buildSafetyUnderfloor(mapFolder: Folder)
	part({
		Name = "SafetyCatch",
		Size = Vector3.new(SAFETY_FLOOR_SIZE, 4, SAFETY_FLOOR_SIZE),
		Position = Vector3.new(0, SAFETY_FLOOR_Y, 0),
		Color = Color3.fromRGB(18, 22, 18),
		Material = Enum.Material.Slate,
		Transparency = 0.92,
		CanCollide = true,
		Anchored = true,
		Parent = mapFolder,
	})
end

local function buildEdgeBerms(mapFolder: Folder)
	-- Soft inner berm just inside Ground edge (keeps stroll-off from feeling like cliff)
	local half = GROUND_SIZE * 0.5 - 40
	local bermH = 18
	local bermT = 28
	local bermY = GROUND_TOP_Y + bermH * 0.5
	local sides = {
		{ Name = "EdgeBermN", Size = Vector3.new(GROUND_SIZE - 80, bermH, bermT), Pos = Vector3.new(0, bermY, -half) },
		{ Name = "EdgeBermS", Size = Vector3.new(GROUND_SIZE - 80, bermH, bermT), Pos = Vector3.new(0, bermY, half) },
		{ Name = "EdgeBermE", Size = Vector3.new(bermT, bermH, GROUND_SIZE - 80), Pos = Vector3.new(half, bermY, 0) },
		{ Name = "EdgeBermW", Size = Vector3.new(bermT, bermH, GROUND_SIZE - 80), Pos = Vector3.new(-half, bermY, 0) },
	}
	for _, s in ipairs(sides) do
		part({
			Name = s.Name,
			Size = s.Size,
			Position = s.Pos,
			Color = Color3.fromRGB(185, 155, 105),
			Material = Enum.Material.Sand,
			CanCollide = true,
			Anchored = true,
			Parent = mapFolder,
		})
	end
end


local function buildInvisibleWalls(mapFolder: Folder)
	-- Tall invisible perimeter so players cannot walk off Ground into void/water
	local half = GROUND_SIZE * 0.5 - 8
	local wallH = 80
	local wallT = 12
	local wallY = GROUND_TOP_Y + wallH * 0.5
	local sides = {
		{ Name = "VoidWallN", Size = Vector3.new(GROUND_SIZE, wallH, wallT), Pos = Vector3.new(0, wallY, -half) },
		{ Name = "VoidWallS", Size = Vector3.new(GROUND_SIZE, wallH, wallT), Pos = Vector3.new(0, wallY, half) },
		{ Name = "VoidWallE", Size = Vector3.new(wallT, wallH, GROUND_SIZE), Pos = Vector3.new(half, wallY, 0) },
		{ Name = "VoidWallW", Size = Vector3.new(wallT, wallH, GROUND_SIZE), Pos = Vector3.new(-half, wallY, 0) },
	}
	for _, s in ipairs(sides) do
		part({
			Name = s.Name,
			Size = s.Size,
			Position = s.Pos,
			Color = Color3.fromRGB(40, 50, 40),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 1,
			CanCollide = true,
			Anchored = true,
			Parent = mapFolder,
		})
	end
end

local function buildMountainRing(root: Folder)
	--[[
		Desert mesa / butte rim — terracotta / sienna / reddish-brown layered Part kits.
		Flat-topped sedimentary striations; varied heights; foothills + collide berm.
		Keeps continuous floor / CanCollide perimeter from void-fall fix (4021025).
	]]
	local folder = Instance.new("Folder")
	folder.Name = "MountainRing"
	folder.Parent = root

	local mesaColors = {
		Color3.fromRGB(168, 95, 58), -- terracotta
		Color3.fromRGB(145, 78, 48), -- burnt sienna
		Color3.fromRGB(185, 110, 70), -- warm sandstone
		Color3.fromRGB(130, 72, 48), -- deep clay
		Color3.fromRGB(175, 105, 65), -- mesa orange
		Color3.fromRGB(155, 88, 55), -- red rock
	}
	local strataLight = Color3.fromRGB(200, 145, 100)
	local strataDark = Color3.fromRGB(110, 62, 40)
	local sandFoothill = Color3.fromRGB(195, 160, 110)

	local half = GROUND_SIZE * 0.5
	local ringR = half + 90
	-- PERF: 12–16 segments (was 24). Studio laptops struggle with mesa*strata*cap parts.
	local configured = tonumber(DevConfig.MountainRingSegments) or 14
	local segCount = math.clamp(math.floor(configured), 12, 24)
	local segArc = (math.pi * 2) / segCount
	local segLen = ringR * segArc * 1.12

	for i = 1, segCount do
		local angle = (i - 0.5) * segArc
		local cx = math.cos(angle) * ringR
		local cz = math.sin(angle) * ringR
		local hSeed = ((i * 17 + 31) % 80) + 40
		local height = hSeed
		if i % 7 == 0 then
			height = math.min(125, height + 32)
		elseif i % 5 == 0 then
			height = math.max(42, height - 16)
		end
		-- Flat-topped mesa: slightly shorter + wider top silhouette
		local depth = 58 + (i % 5) * 9
		local yaw = -angle + math.pi * 0.5
		local col = mesaColors[((i - 1) % #mesaColors) + 1]
		local mat = Enum.Material.Sandstone
		if i % 3 == 0 then
			mat = Enum.Material.Rock
			col = col:Lerp(strataDark, 0.25)
		elseif i % 4 == 0 then
			mat = Enum.Material.Slate
			col = col:Lerp(Color3.fromRGB(140, 95, 70), 0.3)
		end
		local ridge = part({
			Name = "Mesa_" .. i,
			Size = Vector3.new(segLen, height, depth),
			CFrame = CFrame.new(cx, GROUND_TOP_Y + height * 0.5 - 2, cz) * CFrame.Angles(0, yaw, 0),
			Color = col,
			Material = mat,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		})
		ridge:SetAttribute("WE_Mountain", true)
		-- Sedimentary striation bands (visual only) — every 3rd segment (perf)
		if i % 3 == 0 then
			local bandH = math.clamp(height * 0.12, 4, 10)
			part({
				Name = "Strata_" .. i,
				Size = Vector3.new(segLen * 1.02, bandH, depth * 0.98),
				CFrame = CFrame.new(cx, GROUND_TOP_Y + height * 0.38, cz) * CFrame.Angles(0, yaw, 0),
				Color = if i % 4 == 0 then strataLight else strataDark,
				Material = Enum.Material.Sandstone,
				CanCollide = false,
				Anchored = true,
				Transparency = 0.08,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
		-- Flat mesa cap (butte top) — every 3rd segment (perf)
		if i % 3 == 0 then
			local tipH = 6 + (i % 5) * 2
			part({
				Name = "MesaCap_" .. i,
				Size = Vector3.new(segLen * 0.72, tipH, depth * 0.7),
				CFrame = CFrame.new(cx, GROUND_TOP_Y + height + tipH * 0.25 - 2, cz) * CFrame.Angles(0, yaw, 0),
				Color = col:Lerp(strataLight, 0.35),
				Material = Enum.Material.Sandstone,
				CanCollide = false,
				Anchored = true,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
		-- Inner foothill shelf (sand) — collide continuity from berm (sparser)
		if i % 4 == 0 then
			local footH = 12 + (i % 4) * 3
			local footR = half + 35
			local fx = math.cos(angle) * footR
			local fz = math.sin(angle) * footR
			part({
				Name = "Foothill_" .. i,
				Size = Vector3.new(segLen * 0.9, footH, 38),
				CFrame = CFrame.new(fx, GROUND_TOP_Y + footH * 0.5 - 1, fz) * CFrame.Angles(0, yaw, 0),
				Color = sandFoothill,
				Material = Enum.Material.Sand,
				CanCollide = true,
				Anchored = true,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
	end

	-- Mid-ground rocky outcrops just inside the ring (sandy floor props)
	for oi = 1, 4 do
		local ang = (oi / 12) * math.pi * 2 + 0.2
		local orad = half - 220 - (oi % 4) * 40
		local ox = math.cos(ang) * orad
		local oz = math.sin(ang) * orad
		local oh = 10 + (oi % 5) * 4
		part({
			Name = "Outcrop_" .. oi,
			Size = Vector3.new(28 + (oi % 3) * 8, oh, 22 + (oi % 2) * 6),
			Position = Vector3.new(ox, GROUND_TOP_Y + oh * 0.5 - 1, oz),
			Color = mesaColors[((oi - 1) % #mesaColors) + 1],
			Material = Enum.Material.Sandstone,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		}):SetAttribute("WE_Mountain", true)
	end

	-- Corner massifs (extra bulk — flat-topped buttes)
	-- Cardinal buttes only (was 8 incl. diagonals) — Studio collide/GPU win
	local massifs = {
		{ 0, -1, "N" },
		{ 0, 1, "S" },
		{ 1, 0, "E" },
		{ -1, 0, "W" },
	}
	for mi, m in ipairs(massifs) do
		local mx = m[1] * (half + 120)
		local mz = m[2] * (half + 120)
		local mh = 75 + (mi % 4) * 14
		part({
			Name = "Butte_" .. m[3],
			Size = Vector3.new(150, mh, 150),
			Position = Vector3.new(mx, GROUND_TOP_Y + mh * 0.5 - 4, mz),
			Color = mesaColors[((mi - 1) % #mesaColors) + 1],
			Material = Enum.Material.Sandstone,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		}):SetAttribute("WE_Mountain", true)
		-- Flat caps omitted for perf (mesa segments already have caps)
	end

	print("[WAR EMPIRE] MapSetup: MountainRing mesas=" .. tostring(segCount) .. " + buttes/outcrops (desert terracotta)")
end

local function buildVisualFillPatches(mapFolder: Folder)
	-- Low-cost ground patches between plot ring and mid-map so dead space doesn't look empty
	local patches = {
		Vector3.new(400, GROUND_TOP_Y + 0.08, 200),
		Vector3.new(-350, GROUND_TOP_Y + 0.08, -250),
		Vector3.new(600, GROUND_TOP_Y + 0.08, -100),
		Vector3.new(-400, GROUND_TOP_Y + 0.08, -550),
	}
	for i, pos in ipairs(patches) do
		local w = 80 + (i % 4) * 25
		local d = 55 + (i % 3) * 20
		part({
			Name = "FillPatch_" .. i,
			Size = Vector3.new(w, 0.2, d),
			Position = pos,
			Color = if i % 2 == 0 then Color3.fromRGB(220, 195, 140) else Color3.fromRGB(195, 165, 115),
			Material = if i % 2 == 0 then Enum.Material.Sand else Enum.Material.Sandstone,
			CanCollide = false,
			Anchored = true,
			Transparency = 0.05,
			Parent = mapFolder,
		})
	end
end

local function buildOilDeckRamp(parent: Folder, territoryId: string, deckPos: Vector3, towardCenter: Vector3)
	--[[
		Stepped collide stairs from elevated oil deck (~Y=28) down to ground.
		towardCenter = horizontal direction from deck toward map center (inland).
	]]
	local dir = Vector3.new(towardCenter.X, 0, towardCenter.Z)
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(if deckPos.X >= 0 then -1 else 1, 0, 0)
	end
	dir = dir.Unit
	local deckTopY = deckPos.Y
	local steps = 10
	local rise = (deckTopY - GROUND_TOP_Y) / steps
	local run = 9
	local stepW = 22
	local stepT = 7.5
	-- Start just outside the 48-stud deck toward inland
	local edge = Vector3.new(deckPos.X, 0, deckPos.Z) - dir * 26
	for s = 1, steps do
		local y = deckTopY - rise * s + 0.6
		local horiz = edge - dir * (run * s)
		local pos = Vector3.new(horiz.X, y, horiz.Z)
		part({
			Name = territoryId .. "_RampStep" .. s,
			Size = Vector3.new(stepW, 1.3, stepT),
			CFrame = CFrame.lookAt(pos, pos + dir),
			Color = Color3.fromRGB(75, 78, 82),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Anchored = true,
			Parent = parent,
		})
	end
	local midHoriz = edge - dir * (run * 5)
	part({
		Name = territoryId .. "_RampShelf",
		Size = Vector3.new(28, 1.4, 14),
		Position = Vector3.new(midHoriz.X, deckTopY - rise * 5, midHoriz.Z),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Metal,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
	local approach = edge - dir * (run * steps + 10)
	part({
		Name = territoryId .. "_RampApproach",
		Size = Vector3.new(30, 1, 18),
		Position = Vector3.new(approach.X, GROUND_TOP_Y + 0.45, approach.Z),
		Color = Color3.fromRGB(55, 60, 55),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
end


local MapSetup = {}

-- Exported for Bootstrap ground heal / verify
MapSetup.GROUND_SIZE = GROUND_SIZE
MapSetup.GROUND_THICKNESS = GROUND_THICKNESS
MapSetup.GROUND_TOP_Y = GROUND_TOP_Y
MapSetup.SAFETY_FLOOR_SIZE = SAFETY_FLOOR_SIZE
MapSetup.SAFETY_FLOOR_Y = SAFETY_FLOOR_Y

local function buildPadSupportShelves(setup: Folder)
	--[[
		Collide shelves under elevated upgrade pads / decks so players never
		treat CanCollide=false kit deco as floor. Fills air gap pad→Ground.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return
	end
	local folder = map:FindFirstChild("PadSupports")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "PadSupports"
	folder.Parent = map

	local CollectionService = game:GetService("CollectionService")
	local TAG = TAG_SLOT
	local count = 0
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(setup) then
			local topY = inst.Position.Y + inst.Size.Y * 0.5
			local gap = topY - GROUND_TOP_Y
			if gap > 2.5 then
				local shelfH = math.clamp(gap - 0.5, 1, 40)
				local shelfY = GROUND_TOP_Y + shelfH * 0.5
				part({
					Name = "PadShelf_" .. tostring(count),
					Size = Vector3.new(math.max(inst.Size.X + 4, 12), shelfH, math.max(inst.Size.Z + 4, 12)),
					Position = Vector3.new(inst.Position.X, shelfY, inst.Position.Z),
					Color = Color3.fromRGB(90, 85, 70),
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Anchored = true,
					Parent = folder,
				})
				count += 1
			end
		end
	end
	-- Also sweep StructureId parts under Bases (tag may lag)
	local bases = setup:FindFirstChild("Bases")
	if bases then
		for _, desc in ipairs(bases:GetDescendants()) do
			if desc:IsA("BasePart") then
				local sid = desc:GetAttribute("StructureId")
				if typeof(sid) == "string" then
					local topY = desc.Position.Y + desc.Size.Y * 0.5
					local gap = topY - GROUND_TOP_Y
					if gap > 2.5 then
						-- Skip if already covered by a nearby shelf
						local covered = false
						for _, child in ipairs(folder:GetChildren()) do
							if child:IsA("BasePart") then
								local dx = child.Position.X - desc.Position.X
								local dz = child.Position.Z - desc.Position.Z
								if dx * dx + dz * dz < 25 then
									covered = true
									break
								end
							end
						end
						if not covered then
							local shelfH = math.clamp(gap - 0.5, 1, 40)
							local shelfY = GROUND_TOP_Y + shelfH * 0.5
							part({
								Name = "PadShelf_" .. tostring(count),
								Size = Vector3.new(math.max(desc.Size.X + 4, 12), shelfH, math.max(desc.Size.Z + 4, 12)),
								Position = Vector3.new(desc.Position.X, shelfY, desc.Position.Z),
								Color = Color3.fromRGB(90, 85, 70),
								Material = Enum.Material.Concrete,
								CanCollide = true,
								Anchored = true,
								Parent = folder,
							})
							count += 1
						end
					end
				end
			end
		end
	end
	if count > 0 then
		print("[WAR EMPIRE] MapSetup: PadSupports shelves=" .. tostring(count) .. " (collide fillers under elevated pads)")
	end
end

function MapSetup.EnsureGroundHealthy(setup: Instance): boolean
	--[[
		Soft-heal existing WarEmpireSetup Ground / SafetyCatch.
		Returns true if healthy (or repaired in place), false if caller should rebuild.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	local ground = map:FindFirstChild("Ground")
	if not (ground and ground:IsA("BasePart")) then
		return false
	end
	local repaired = false
	-- Always force full-size collide Ground every Play (bulletproof void floor)
	if ground.Size.X < GROUND_SIZE - 1 or ground.Size.Z < GROUND_SIZE - 1 or ground.Size.Y < GROUND_THICKNESS - 0.5
		or ground.CanCollide ~= true
	then
		ground.Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE)
		ground.Position = Vector3.new(0, groundCenterY(), 0)
		repaired = true
	end
	-- Even when size OK, re-assert collide / anchor every start
	ground.Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE)
	ground.Position = Vector3.new(0, groundCenterY(), 0)
	if ground.CanCollide ~= true then
		ground.CanCollide = true
		repaired = true
	end
	if ground.Anchored ~= true then
		ground.Anchored = true
		repaired = true
	end
	ground.Color = COL_GROUND
	ground.Material = Enum.Material.Sand

	local catch = map:FindFirstChild("SafetyCatch")
	if not (catch and catch:IsA("BasePart")) then
		buildSafetyUnderfloor(map :: Folder)
		repaired = true
	else
		catch.Size = Vector3.new(SAFETY_FLOOR_SIZE, 4, SAFETY_FLOOR_SIZE)
		catch.Position = Vector3.new(0, SAFETY_FLOOR_Y, 0)
		catch.CanCollide = true
		catch.Anchored = true
		catch.Transparency = 0.92
	end

	if not setup:FindFirstChild("MountainRing") then
		buildMountainRing(setup :: Folder)
		repaired = true
	end
	if not map:FindFirstChild("EdgeBermN") then
		buildEdgeBerms(map :: Folder)
		repaired = true
	end
	if not map:FindFirstChild("VoidWallN") then
		buildInvisibleWalls(map :: Folder)
		repaired = true
	end

	buildPadSupportShelves(setup :: Folder)

	print(string.format(
		"[WAR EMPIRE] Ground heal: ok size=%.0fx%.0fx%.0f CanCollide=%s repaired=%s",
		ground.Size.X,
		ground.Size.Y,
		ground.Size.Z,
		tostring(ground.CanCollide),
		tostring(repaired)
	))
	return true
end




function MapSetup.ForceRebuildGround(setup: Instance): boolean
	--[[
		Hard rebuild: destroy Map.Ground + SafetyCatch and recreate them.
		Use every Play when soft-heal is not enough (stale holes / void gaps).
		Does NOT rebuild the whole WarEmpireSetup — only the collide floor layers.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	local oldGround = map:FindFirstChild("Ground")
	if oldGround then
		oldGround:Destroy()
	end
	local oldCatch = map:FindFirstChild("SafetyCatch")
	if oldCatch then
		oldCatch:Destroy()
	end

	local ground = part({
		Name = "Ground",
		Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE),
		Position = Vector3.new(0, groundCenterY(), 0),
		Color = COL_GROUND,
		Material = Enum.Material.Sand,
		CanCollide = true,
		Anchored = true,
		Parent = map,
	})
	ground.CanCollide = true
	ground.Anchored = true
	buildSafetyUnderfloor(map :: Folder)
	-- Refresh berms + invisible void walls every force rebuild
	for _, name in ipairs({ "EdgeBermN", "EdgeBermS", "EdgeBermE", "EdgeBermW", "VoidWallN", "VoidWallS", "VoidWallE", "VoidWallW" }) do
		local oldP = map:FindFirstChild(name)
		if oldP then
			oldP:Destroy()
		end
	end
	buildEdgeBerms(map :: Folder)
	buildInvisibleWalls(map :: Folder)
	if not setup:FindFirstChild("MountainRing") then
		buildMountainRing(setup :: Folder)
	end
	buildPadSupportShelves(setup :: Folder)

	print(string.format(
		"[WAR EMPIRE] Ground FORCE-REBUILT: size=%.0fx%.0fx%.0f CanCollide=%s Anchored=%s",
		ground.Size.X,
		ground.Size.Y,
		ground.Size.Z,
		tostring(ground.CanCollide),
		tostring(ground.Anchored)
	))
	return ground.CanCollide == true and ground.Size.X >= GROUND_SIZE - 1 and ground.Size.Y >= GROUND_THICKNESS - 0.5
end



local function paintPlotFloorChevrons(plotFolder: Folder, plotOrigin: Vector3)
	--[[
		Permanent white >>>> chevrons on plot floor guiding spawn → CommandCenter → next pads.
		Visual-only (CanCollide false). Competitor pattern from QUALITY_GAP.
	]]
	local folder = Instance.new("Folder")
	folder.Name = "PlotFloorChevrons"
	folder.Parent = plotFolder

	local function chevronAt(worldPos: Vector3, yawRad: number, idx: number)
		-- Wedge-ish arrow: wide rear + tip (two parts read as >>>)
		local cf = CFrame.new(worldPos) * CFrame.Angles(0, yawRad, 0)
		part({
			Name = "ChevronBody" .. idx,
			Size = Vector3.new(3.2, 0.12, 2.2),
			CFrame = cf,
			Color = Color3.fromRGB(245, 245, 250),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.15,
			Parent = folder,
		})
		part({
			Name = "ChevronTip" .. idx,
			Size = Vector3.new(1.6, 0.14, 1.6),
			CFrame = cf * CFrame.new(0, 0.02, -1.4) * CFrame.Angles(0, math.rad(45), 0),
			Color = Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.05,
			Parent = folder,
		})
	end

	local function paintPath(from: Vector3, to: Vector3, count: number, startIdx: number): number
		local delta = to - from
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude < 4 then
			return startIdx
		end
		-- Face along path (Roblox look = -Z); atan2(x,z) matches CFrame.Angles Y
		local yaw = math.atan2(flat.X, flat.Z)
		local idx = startIdx
		for i = 1, count do
			local alpha = i / (count + 1)
			local pos = from:Lerp(to, alpha) + Vector3.new(0, 0.55, 0)
			chevronAt(pos, yaw, idx)
			idx += 1
		end
		return idx
	end

	-- Path nodes: PlayerSpawn → CC → Barracks → Depot → Weapons → ATM/premium cluster
	local spawnPos = plotOrigin + Vector3.new(0, 0.5, 55)
	local nodes = {
		spawnPos,
	}
	for i, def in ipairs(STRUCTURES) do
		if i > 5 then
			break
		end
		local col = (i - 1) % STRUCT_COLS
		local row = math.floor((i - 1) / STRUCT_COLS)
		local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
		table.insert(nodes, plotOrigin + offset + Vector3.new(0, 0.5, 0))
	end
	-- Guide toward MoneyCollector + premium Robux pads (unpaid ATM cluster)
	local atmCluster = plotOrigin + Vector3.new(28, 0.5, 8)
	table.insert(nodes, atmCluster)

	local idx = 1
	for i = 1, #nodes - 1 do
		local steps = if i == 1 then 5 elseif i == #nodes - 1 then 4 else 3
		idx = paintPath(nodes[i], nodes[i + 1], steps, idx)
	end
end



local function dressPlotPadSandbags(plotFolder: Folder, plotOrigin: Vector3)
	--[[
		v33: cheap MapDressing-style sandbag berms + extra chevrons near early BUY pads.
		Visual-only; does not tag WE_UpgradeSlot.
	]]
	local folder = Instance.new("Folder")
	folder.Name = "PlotPadDressing"
	folder.Parent = plotFolder

	local function sandbag(at: Vector3, yaw: number, idx: number)
		local cf = CFrame.new(at) * CFrame.Angles(0, yaw, 0)
		part({
			Name = "PadSandbag" .. idx,
			Size = Vector3.new(4.2, 1.1, 1.4),
			CFrame = cf,
			Color = Color3.fromRGB(130, 115, 80),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
		part({
			Name = "PadSandbagTop" .. idx,
			Size = Vector3.new(3.4, 0.7, 1.1),
			CFrame = cf * CFrame.new(0, 0.85, 0),
			Color = Color3.fromRGB(145, 125, 88),
			Material = Enum.Material.Sand,
			CanCollide = false,
			Transparency = 0,
			Parent = folder,
		})
	end

	local function miniChevron(at: Vector3, yaw: number, idx: number)
		local cf = CFrame.new(at) * CFrame.Angles(0, yaw, 0)
		part({
			Name = "PadChevron" .. idx,
			Size = Vector3.new(2.4, 0.1, 1.6),
			CFrame = cf,
			Color = Color3.fromRGB(245, 245, 250),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.2,
			Parent = folder,
		})
	end

	local idx = 1
	-- First 6 structure pads get flanking sandbags + approach chevron
	for i, def in ipairs(STRUCTURES) do
		if i > 6 then
			break
		end
		local col = (i - 1) % STRUCT_COLS
		local row = math.floor((i - 1) / STRUCT_COLS)
		local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
		local padPos = plotOrigin + offset
		sandbag(padPos + Vector3.new(-7, 0.7, 4), math.rad(15), idx)
		idx += 1
		sandbag(padPos + Vector3.new(7, 0.7, 4), math.rad(-15), idx)
		idx += 1
		miniChevron(padPos + Vector3.new(0, 0.55, 9), math.rad(180), idx)
		idx += 1
	end
	-- ATM approach berm
	local atm = plotOrigin + Vector3.new(28, 0.7, 8)
	sandbag(atm + Vector3.new(-6, 0, 6), 0, idx)
	idx += 1
	sandbag(atm + Vector3.new(6, 0, 6), 0, idx)
end



local function premiumOfferIdLive(kind: string, key: string): boolean
	-- Hide pads until Creator Dashboard Id exists (GoldenPumpjack Id=0 → no pad)
	if kind == "GamePass" then
		local def = MonetizationConfig.GamePasses[key]
		return def ~= nil and typeof(def.Id) == "number" and def.Id ~= 0
	elseif kind == "DevProduct" then
		local def = MonetizationConfig.DevProducts[key]
		return def ~= nil and typeof(def.Id) == "number" and def.Id ~= 0
	end
	return false
end

local function buildPremiumPads(folder: Folder, plotId: number, atmPos: Vector3)
	-- Competitor ATM-cluster: red AutoCollect / 2x Cash, yellow Speed; GoldenPump only if Id≠0
	local offers = {
		{ Key = "AutoCollect", Kind = "GamePass", Label = "AUTO COLLECT", Color = Color3.fromRGB(220, 50, 50), Offset = Vector3.new(-10, 0.55, 14) },
		{ Key = "VIP", Kind = "GamePass", Label = "VIP", Color = Color3.fromRGB(180, 60, 220), Offset = Vector3.new(-18, 0.55, 8) },
		{ Key = "DoubleCash", Kind = "GamePass", Label = "2x CASH", Color = Color3.fromRGB(255, 70, 40), Offset = Vector3.new(0, 0.55, 16) },
		{ Key = "SpeedBoost", Kind = "DevProduct", Label = "SPEED BOOST", Color = Color3.fromRGB(255, 210, 40), Offset = Vector3.new(10, 0.55, 14) },
		{ Key = "GoldenPumpjack", Kind = "DevProduct", Label = "GOLDEN PUMP", Color = Color3.fromRGB(255, 180, 40), Offset = Vector3.new(0, 0.55, 22) },
	}
	for _, offer in ipairs(offers) do
		if not premiumOfferIdLive(offer.Kind, offer.Key) then
			continue
		end
		local pad = part({
			Name = "PremiumPad_" .. offer.Key,
			Size = Vector3.new(7, 0.45, 7),
			Position = atmPos + offer.Offset,
			Color = offer.Color,
			Material = Enum.Material.Neon,
			CanCollide = true,
			Parent = folder,
		})
		pad:SetAttribute("PlotId", plotId)
		pad:SetAttribute("OfferKey", offer.Key)
		pad:SetAttribute("OfferKind", offer.Kind)
		CollectionService:AddTag(pad, TAG_PREMIUM)
		local glow = Instance.new("PointLight")
		glow.Color = offer.Color
		glow.Brightness = 1.4
		glow.Range = 14
		glow.Parent = pad
		local bb = plainBillboard(pad, offer.Label .. "  ·  R$", Vector2.new(160, 32), 3.2, offer.Color)
		if bb then
			bb.Name = "WE_PremiumBillboard"
			bb.AlwaysOnTop = false
			bb.MaxDistance = 36
		end
	end
end

local function buildMoneyCollector(plotFolder: Folder, plotId: number, pos: Vector3)
	-- ATM-like Part kit: matte grey body + green digit screen (MoneyCollectorService billboard refreshes $)
	local folder = Instance.new("Folder")
	folder.Name = "MoneyCollector"
	folder.Parent = plotFolder
	local body = part({
		Name = "CollectorBody",
		Size = Vector3.new(6, 8, 4),
		Position = pos + Vector3.new(28, 4.5, 8),
		Color = Color3.fromRGB(70, 78, 72),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = true,
		Parent = folder,
	})
	body:SetAttribute("PlotId", plotId)
	body:SetAttribute("WE_LimeLandmark", true)
	CollectionService:AddTag(body, TAG_COLLECTOR)
	part({
		Name = "CollectorBase",
		Size = Vector3.new(7.5, 0.6, 5.5),
		Position = pos + Vector3.new(28, 0.8, 8),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Parent = folder,
	})
	local screen = part({
		Name = "CollectorScreen",
		Size = Vector3.new(4.2, 2.8, 0.35),
		Position = pos + Vector3.new(28, 5.2, 8 - 2.15),
		Color = Color3.fromRGB(40, 160, 70),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	-- Green digit SurfaceGui (live $ filled by MoneyCollectorService billboard on body too)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "WE_ATMScreen"
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(240, 160)
	sg.LightInfluence = 0
	sg.Parent = screen
	local digits = Instance.new("TextLabel")
	digits.Name = "Digits"
	digits.Size = UDim2.fromScale(1, 1)
	digits.BackgroundColor3 = Color3.fromRGB(8, 40, 18)
	digits.BackgroundTransparency = 0.15
	digits.Font = Enum.Font.Code
	digits.TextScaled = true
	digits.TextColor3 = Color3.fromRGB(70, 255, 120)
	digits.Text = "$0"
	digits.Parent = sg
	local light = Instance.new("PointLight")
	light.Name = "ATMGlow"
	light.Color = Color3.fromRGB(120, 255, 90)
	light.Brightness = 1.15
	light.Range = 20
	light.Parent = body
	do
		local bb = plainBillboard(body, "COLLECT · Touch ATM", Vector2.new(200, 36), 6.5, Color3.fromRGB(90, 240, 130))
		if bb then
			bb.Name = "WE_CollectBillboard"
			bb.AlwaysOnTop = true -- P0: ATM primary when nearest
			bb.MaxDistance = 28
		end
	end
	-- Lime Collect circle on ground (touch radius visual)
	local collectCircle = part({
		Name = "CollectCircle",
		Size = Vector3.new(14, 0.25, 14),
		Position = pos + Vector3.new(28, 0.55, 8),
		Color = Color3.fromRGB(90, 255, 110),
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	-- Cylinder default axis is X — rotate to lie flat on ground
	collectCircle.CFrame = CFrame.new(pos + Vector3.new(28, 0.55, 8)) * CFrame.Angles(0, 0, math.rad(90))
	collectCircle:SetAttribute("PlotId", plotId)
	local ring = part({
		Name = "CollectRing",
		Size = Vector3.new(15.5, 0.2, 15.5),
		Color = Color3.fromRGB(60, 220, 90),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	ring.CFrame = CFrame.new(pos + Vector3.new(28, 0.45, 8)) * CFrame.Angles(0, 0, math.rad(90))

	-- Optional ATM catalog mesh dress (Part kit remains authoritative)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachCollectorVisual then
				vas.TryAttachCollectorVisual(body)
			end
		end)
	end)
	-- ATM-cluster premium Robux pads (AutoCollect / 2x / Speed / GoldenPump)
	buildPremiumPads(folder, plotId, pos + Vector3.new(28, 0, 8))
end

function MapSetup.Run()
	-- Normal gravity so characters fall onto terrain (not float/void)
	Workspace.Gravity = 196.2

	-- Lighting / sky / atmosphere — bright midday desert (inspiration only)
	Lighting.Ambient = Color3.fromRGB(165, 145, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(185, 165, 130)
	Lighting.Brightness = 3.15
	Lighting.ClockTime = 12.5 -- intense midday sun
	Lighting.GeographicLatitude = 22
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.42
	Lighting.FogColor = Color3.fromRGB(210, 195, 160)
	Lighting.FogStart = 1200
	Lighting.FogEnd = 5200
	pcall(function()
		Lighting.GlobalShadows = true
	end)

	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	sky.Name = "WE_Sky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 2500
	sky.SunAngularSize = 18 -- larger desert sun
	sky.MoonAngularSize = 9

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.14
	atm.Offset = 0.08
	atm.Color = Color3.fromRGB(200, 185, 150) -- warm haze near horizon
	atm.Decay = Color3.fromRGB(95, 130, 190) -- deep blue sky fade
	atm.Glare = 0.32
	atm.Haze = 1.15 -- low haze, high contrast

	-- Cancel prior day/night loop on resetmap; gentle cycle biased to bright desert day
	local dayMarker = Lighting:FindFirstChild("WE_DayNightMarker")
	if dayMarker then
		dayMarker:Destroy()
	end
	dayMarker = Instance.new("Folder")
	dayMarker.Name = "WE_DayNightMarker"
	dayMarker.Parent = Lighting
	task.spawn(function()
		local STEP = 0.03
		local WAIT = 1.5
		local dayAmb = Color3.fromRGB(165, 145, 110)
		local dayOut = Color3.fromRGB(185, 165, 130)
		local dayFog = Color3.fromRGB(210, 195, 160)
		local nightAmb = Color3.fromRGB(40, 45, 70)
		local nightOut = Color3.fromRGB(50, 55, 85)
		local nightFog = Color3.fromRGB(55, 60, 90)
		while dayMarker.Parent do
			local t = (Lighting.ClockTime + STEP) % 24
			Lighting.ClockTime = t
			local night = 0
			if t < 5 or t > 20 then
				night = 1
			elseif t < 7 then
				night = 1 - (t - 5) / 2
			elseif t > 18 then
				night = (t - 18) / 2
			end
			Lighting.Brightness = 3.2 - night * 2.1
			Lighting.Ambient = dayAmb:Lerp(nightAmb, night)
			Lighting.OutdoorAmbient = dayOut:Lerp(nightOut, night)
			Lighting.FogColor = dayFog:Lerp(nightFog, night)
			Lighting.FogStart = 1200 - night * 250
			Lighting.FogEnd = 5200 - night * 800
			atm.Density = 0.13 + night * 0.14
			atm.Haze = 1.1 + night * 1.0
			atm.Color = Color3.fromRGB(200, 185, 150):Lerp(Color3.fromRGB(70, 80, 120), night)
			atm.Decay = Color3.fromRGB(95, 130, 190):Lerp(Color3.fromRGB(40, 50, 90), night)
			atm.Glare = 0.32 - night * 0.2
			task.wait(WAIT)
		end
	end)

	local root = ensureFolder("WarEmpireSetup", Workspace)
	local map = ensureFolder("Map", root)
	-- Continuous collide floor: thick, large, explicit CanCollide — never reads as sky
	part({
		Name = "Ground",
		Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE),
		Position = Vector3.new(0, groundCenterY(), 0),
		Color = COL_GROUND,
		Material = Enum.Material.Sand,
		CanCollide = true,
		Anchored = true,
		Parent = map,
	})
	buildSafetyUnderfloor(map)
	buildEdgeBerms(map)
	buildInvisibleWalls(map)
	buildVisualFillPatches(map)
	buildMountainRing(root)
	-- Road grid scaled to plot ring (optional visual guide)
	for _, z in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		part({
			Name = "RoadZ" .. z,
			Size = Vector3.new(GROUND_SIZE, 0.15, 14),
			Position = Vector3.new(0, GROUND_TOP_Y + 0.05, z),
			Color = Color3.fromRGB(50, 52, 48),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
			Parent = map,
		})
	end
	for _, x in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		part({
			Name = "RoadX" .. x,
			Size = Vector3.new(14, 0.15, GROUND_SIZE),
			Position = Vector3.new(x, GROUND_TOP_Y + 0.05, 0),
			Color = Color3.fromRGB(50, 52, 48),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
			Parent = map,
		})
	end
	-- Asphalt Decal texture on road strips (MapDressing.AsphaltDecal)
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if not (vas and vas.ApplyAsphaltDecal) then
				return
			end
			for _, ch in ipairs(map:GetChildren()) do
				if ch:IsA("BasePart") and (string.sub(ch.Name, 1, 5) == "RoadZ" or string.sub(ch.Name, 1, 5) == "RoadX") then
					vas.ApplyAsphaltDecal(ch)
				end
			end
		end)
	end)

		-- Yellow centerline dashes (asphalt polish — competitor desert roads)
	for _, z in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		for i = -8, 8 do
			if i ~= 0 then
				part({
					Name = "RoadDashZ" .. z .. "_" .. i,
					Size = Vector3.new(8, 0.12, 1.2),
					Position = Vector3.new(i * 90, GROUND_TOP_Y + 0.12, z),
					Color = Color3.fromRGB(240, 210, 60),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Transparency = 0.25,
					Parent = map,
				})
			end
		end
	end
	for _, x in ipairs({ -PLOT_RING, PLOT_RING }) do
		for i = -8, 8 do
			if i ~= 0 then
				part({
					Name = "RoadDashX" .. x .. "_" .. i,
					Size = Vector3.new(1.2, 0.12, 8),
					Position = Vector3.new(x, GROUND_TOP_Y + 0.12, i * 90),
					Color = Color3.fromRGB(240, 210, 60),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Transparency = 0.25,
					Parent = map,
				})
			end
		end
	end

	local bases = ensureFolder("Bases", root)
	for plotId, pos in ipairs(PLOT_POSITIONS) do
		local plotFolder = Instance.new("Folder")
		plotFolder.Name = "Plot" .. plotId
		plotFolder.Parent = bases

		local pad = part({
			Name = "PlotPad",
			Size = Vector3.new(PLOT_PAD_SIZE, 1, PLOT_PAD_SIZE),
			Position = pos,
			Color = COL_PAD,
			Material = Enum.Material.Concrete,
			Parent = plotFolder,
		})
		pad:SetAttribute("PlotId", plotId)
		CollectionService:AddTag(pad, TAG_BASE)
		neonEdge(pad, COL_PAD_EDGE, 0.55)

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "PlayerSpawn"
		spawn.Size = Vector3.new(10, 1, 10)
		spawn.Position = pos + Vector3.new(0, 2, 55)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.BrickColor = BrickColor.new("Dark green")
		spawn.Material = Enum.Material.Neon
		spawn.Parent = plotFolder

		plainBillboard(pad, "BASE " .. plotId .. "  ·  Walk pads to BUY  ·  E / B menu", Vector2.new(280, 44), 16, Color3.fromRGB(200, 230, 200))
		beacon(plotFolder, pos + Vector3.new(0, 0, -62), COL_PAD_EDGE, "PlotBeacon")

		for i, def in ipairs(STRUCTURES) do
			local col = (i - 1) % STRUCT_COLS
			local row = math.floor((i - 1) / STRUCT_COLS)
			local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
			buildStructureKit(plotFolder, plotId, pos, offset, def)
		end

		paintPlotFloorChevrons(plotFolder, pos)
		dressPlotPadSandbags(plotFolder, pos)

		-- Training Yard targets (soldiers "train" → server cash; visual only)
		local yardFolder = Instance.new("Folder")
		yardFolder.Name = "TrainingYard"
		yardFolder.Parent = plotFolder
		for ti = 1, 3 do
			local tpos = pos + Vector3.new(-50 + ti * 18, 3.5, 48)
			local target = part({
				Name = "TrainingTarget" .. ti,
				Size = Vector3.new(4, 6, 0.6),
				Position = tpos,
				Color = Color3.fromRGB(200, 60, 60),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = yardFolder,
			})
			target:SetAttribute("PlotId", plotId)
			target:SetAttribute("WE_TrainingTarget", true)
			part({
				Name = "TargetStand" .. ti,
				Size = Vector3.new(1, 4, 1),
				Position = tpos + Vector3.new(0, -5, 0),
				Color = Color3.fromRGB(70, 70, 70),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = yardFolder,
			})
			part({
				Name = "TargetBullseye" .. ti,
				Size = Vector3.new(1.6, 1.6, 0.35),
				Position = tpos + Vector3.new(0, 0.5, -0.2),
				Color = Color3.fromRGB(240, 220, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = yardFolder,
			})
		end
		-- Training workers (visual only — income is SoldierService tick)
		for wi = 1, 2 do
			local wpos = pos + Vector3.new(-40 + wi * 20, 2.6, 42)
			-- P0: dress as Worker→Infantry mesh (force catalog even in StudioSkipWorldDressing)
			local worker = makeSoldierKit(
				yardFolder,
				"TrainingWorker" .. wi,
				CFrame.new(wpos) * CFrame.Angles(0, math.rad(180), 0),
				Color3.fromRGB(70, 85, 55),
				"TRAINING",
				Color3.fromRGB(140, 150, 130), -- muted
				50,
				"Worker",
				nil
			)
			if worker then
				local head = worker:FindFirstChild("Head")
				if head then
					local bb = head:FindFirstChild("NPCLabel") or head:FindFirstChildWhichIsA("BillboardGui")
					if bb and bb:IsA("BillboardGui") then
						bb.Name = "WE_WorkerTag"
						bb.AlwaysOnTop = false
						bb.MaxDistance = 18
						bb.StudsOffset = Vector3.new(0, 2.4, 0)
						bb.Size = UDim2.fromOffset(90, 18)
					end
				end
			end
		end
		-- Target ring + base plate polish
		part({
			Name = "YardPad",
			Size = Vector3.new(55, 0.6, 18),
			Position = pos + Vector3.new(-14, 0.4, 48),
			Color = Color3.fromRGB(48, 52, 42),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = yardFolder,
		})
		do
			local yp = yardFolder:FindFirstChild("YardPad")
			if yp and yp:IsA("BasePart") then
				local ebb = Instance.new("BillboardGui")
				ebb.Name = "WE_TrainingEarnBillboard"
				ebb.Size = UDim2.fromOffset(140, 28)
				ebb.StudsOffset = Vector3.new(0, 3.2, 0)
				ebb.AlwaysOnTop = false
				ebb.MaxDistance = 22
				ebb.Parent = yp
				local el = Instance.new("TextLabel")
				el.Size = UDim2.fromScale(1, 1)
				el.BackgroundTransparency = 0.35
				el.BackgroundColor3 = Color3.fromRGB(20, 28, 18)
				el.BorderSizePixel = 0
				el.Font = Enum.Font.GothamBold
				el.TextSize = 14
				el.TextColor3 = Color3.fromRGB(160, 220, 120)
				el.Text = "+$/tick"
				el.Parent = ebb
			end
		end
		-- Design Bot quality wire: 2–3 SquadStall kits (Tent + crates + sandbags + Infantry)
		do
			local stallFolder = Instance.new("Folder")
			stallFolder.Name = "SquadStalls"
			stallFolder.Parent = yardFolder
			local stallOffsets = {
				Vector3.new(-36, 0, 36),
				Vector3.new(-18, 0, 36),
				Vector3.new(0, 0, 36),
			}
			for si, soff in ipairs(stallOffsets) do
				local sOrigin = pos + soff
				local stall = Instance.new("Folder")
				stall.Name = "SquadStall" .. si
				stall.Parent = stallFolder
				-- Floor plate
				part({
					Name = "StallFloor",
					Size = Vector3.new(12, 0.4, 10),
					Position = sOrigin + Vector3.new(0, 0.35, 0),
					Color = Color3.fromRGB(70, 68, 52),
					Material = Enum.Material.WoodPlanks,
					CanCollide = true,
					Parent = stall,
				})
				-- Tent host (catalog Tent via TryAttachPropVisual)
				local tentHost = part({
					Name = "TentHost",
					Size = Vector3.new(8, 4, 6),
					Position = sOrigin + Vector3.new(0, 2.4, -1),
					Color = Color3.fromRGB(90, 100, 70),
					Material = Enum.Material.Fabric,
					CanCollide = false,
					Transparency = 0.35,
					Parent = stall,
				})
				-- Crate stack hosts
				local crateA = part({
					Name = "CrateHostA",
					Size = Vector3.new(2.2, 2.0, 2.2),
					Position = sOrigin + Vector3.new(4.5, 1.2, 2),
					Color = Color3.fromRGB(95, 80, 55),
					Material = Enum.Material.Wood,
					CanCollide = true,
					Parent = stall,
				})
				local crateB = part({
					Name = "CrateHostB",
					Size = Vector3.new(2.0, 1.8, 2.0),
					Position = sOrigin + Vector3.new(4.5, 3.0, 2),
					Color = Color3.fromRGB(85, 70, 48),
					Material = Enum.Material.Wood,
					CanCollide = true,
					Parent = stall,
				})
				local milCrate = part({
					Name = "MilCrateHost",
					Size = Vector3.new(2.4, 1.6, 1.8),
					Position = sOrigin + Vector3.new(-4.2, 1.0, 2.2),
					Color = Color3.fromRGB(55, 70, 50),
					Material = Enum.Material.Metal,
					CanCollide = true,
					Parent = stall,
				})
				-- Sandbags
				local sandHost = part({
					Name = "SandbagHost",
					Size = Vector3.new(6, 1.1, 1.3),
					Position = sOrigin + Vector3.new(0, 0.75, 4.2),
					Color = Color3.fromRGB(130, 115, 80),
					Material = Enum.Material.Sand,
					CanCollide = true,
					Parent = stall,
				})
				-- Lantern host
				local lanternHost = part({
					Name = "LanternHost",
					Size = Vector3.new(0.6, 1.2, 0.6),
					Position = sOrigin + Vector3.new(-3.5, 2.2, -2.5),
					Color = Color3.fromRGB(180, 140, 60),
					Material = Enum.Material.Metal,
					CanCollide = false,
					Parent = stall,
				})
				local lanternLight = Instance.new("PointLight")
				lanternLight.Color = Color3.fromRGB(255, 200, 120)
				lanternLight.Brightness = 0.8
				lanternLight.Range = 14
				lanternLight.Parent = lanternHost
				-- v34: stall roles use distinct VisualAssetConfig Character IDs + Part dress
				local stallRoles = {
					{ Kind = "Infantry", Label = "INFANTRY", Body = Color3.fromRGB(70, 85, 55), Accent = Color3.fromRGB(180, 220, 120) },
					{ Kind = "HeavyInfantry", Label = "HEAVY", Body = Color3.fromRGB(50, 55, 48), Accent = Color3.fromRGB(230, 160, 50) },
					{ Kind = "Guard", Label = "GUARD", Body = Color3.fromRGB(45, 55, 70), Accent = Color3.fromRGB(90, 140, 220) },
				}
				local roleDef = stallRoles[((si - 1) % #stallRoles) + 1]
				local soldierCf = CFrame.new(sOrigin + Vector3.new(-1.5, 2.6, 1.5)) * CFrame.Angles(0, math.rad(160 + si * 8), 0)
				makeSoldierKit(
					stall,
					"Stall" .. roleDef.Kind .. si,
					soldierCf,
					roleDef.Body,
					roleDef.Label,
					roleDef.Accent,
					80,
					roleDef.Kind,
					nil
				)
				-- Optional crouch: Humanoid Sit as lightweight proxy (full crouch AnimationId TBD)
				pcall(function()
					local m = stall:FindFirstChild("Stall" .. roleDef.Kind .. si)
					if m and m:IsA("Model") then
						local hum = m:FindFirstChildOfClass("Humanoid")
						if hum then
							hum.Sit = false
							hum.WalkSpeed = 0
							-- Note: T-pose/catalog pose OK — crouch AnimationId not wired this pass
							m:SetAttribute("WE_PoseNote", "TPose_CrouchAnimPending")
						end
					end
				end)
				-- Catalog prop dress (pcall — Part kits remain if InsertService fails)
				task.defer(function()
					pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if not vas or not vas.TryAttachPropVisual then
							return
						end
						vas.TryAttachPropVisual(tentHost, "Tent")
						vas.TryAttachPropVisual(crateA, "Crate")
						vas.TryAttachPropVisual(crateB, "MilitaryCrate")
						vas.TryAttachPropVisual(milCrate, "MilitaryCrate")
						vas.TryAttachPropVisual(sandHost, "Sandbag")
						vas.TryAttachPropVisual(lanternHost, "Lantern")
					end)
				end)
			end
		end

		local yardAnchor = part({
			Name = "YardAnchor",
			Size = Vector3.new(1, 1, 1),
			Position = pos + Vector3.new(-14, 8, 48),
			Transparency = 1,
			CanCollide = false,
			Parent = yardFolder,
		})
		plainBillboard(
			yardAnchor,
			"TRAINING YARD · Workers earn cash",
			Vector2.new(280, 40),
			8,
			Color3.fromRGB(255, 200, 120)
		)
		local earnAnchor = part({
			Name = "YardEarnAnchor",
			Size = Vector3.new(1, 1, 1),
			Position = pos + Vector3.new(-14, 6, 42),
			Transparency = 1,
			CanCollide = false,
			Parent = yardFolder,
		})
		-- Light beams worker → target (visual income feedback)
		for wi = 1, 2 do
			local worker = yardFolder:FindFirstChild("TrainingWorker" .. wi)
			local target = yardFolder:FindFirstChild("TrainingTarget" .. wi)
			if worker and target and worker:IsA("Model") and target:IsA("BasePart") then
				local root = worker.PrimaryPart or worker:FindFirstChildWhichIsA("BasePart")
				if root and root:IsA("BasePart") then
					local a0 = Instance.new("Attachment")
					a0.Name = "WE_TrainBeam0"
					a0.Position = Vector3.new(0, 1.2, 0)
					a0.Parent = root
					local a1 = Instance.new("Attachment")
					a1.Name = "WE_TrainBeam1"
					a1.Parent = target
					local beam = Instance.new("Beam")
					beam.Name = "WE_TrainBeam"
					beam.Attachment0 = a0
					beam.Attachment1 = a1
					beam.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80))
					beam.Width0 = 0.15
					beam.Width1 = 0.05
					beam.FaceCamera = true
					beam.LightEmission = 0.4
					beam.Transparency = NumberSequence.new(0.35)
					beam.Parent = root
				end
			end
		end
		-- Design densify: 8–12 realistic warzone props per plot (always-on Part kits; pcall catalog)
		do
			local okDress, errDress = pcall(function()
				local wz = Instance.new("Folder")
				wz.Name = "PlotWarzone"
				wz.Parent = plotFolder
				local count = 12
				for i = 1, count do
					local ang = (i / count) * math.pi * 2
					local rad = 58 + (i % 3) * 10
					local o = pos + Vector3.new(math.cos(ang) * rad, 0.6, math.sin(ang) * rad)
					if i % 3 == 0 then
						-- sandbag berm (Metal/Sand — no neon)
						part({
							Name = "WZ_Sandbag" .. i,
							Size = Vector3.new(6, 1.2, 1.4),
							Position = o,
							Color = Color3.fromRGB(130, 115, 80),
							Material = Enum.Material.Sand,
							CanCollide = true,
							Parent = wz,
						})
						part({
							Name = "WZ_SandbagTop" .. i,
							Size = Vector3.new(5.2, 0.9, 1.1),
							Position = o + Vector3.new(0, 1.0, 0),
							Color = Color3.fromRGB(120, 105, 75),
							Material = Enum.Material.Sand,
							CanCollide = true,
							Parent = wz,
						})
					elseif i % 3 == 1 then
						part({
							Name = "WZ_Crate" .. i,
							Size = Vector3.new(2.2, 2.0, 2.2),
							Position = o + Vector3.new(0, 1.0, 0),
							Color = Color3.fromRGB(95, 80, 55),
							Material = Enum.Material.Wood,
							CanCollide = true,
							Parent = wz,
						})
						part({
							Name = "WZ_Drum" .. i,
							Size = Vector3.new(1.4, 2.2, 1.4),
							Position = o + Vector3.new(3, 1.1, 1),
							Color = Color3.fromRGB(55, 70, 50),
							Material = Enum.Material.Metal,
							Shape = Enum.PartType.Cylinder,
							CanCollide = true,
							Parent = wz,
						})
					else
						part({
							Name = "WZ_Barrier" .. i,
							Size = Vector3.new(5, 1.4, 0.7),
							Position = o + Vector3.new(0, 0.7, 0),
							Color = Color3.fromRGB(110, 105, 90),
							Material = Enum.Material.Concrete,
							CanCollide = true,
							Parent = wz,
						})
					end
				end
				-- Optional catalog floodlight tower / flag (never clears pads on fail)
								pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if not (vas and vas.TryAttachPropVisual) then
							return
						end
						-- WZ densify catalog: sandbags / crates / desert flora hosts
						for _, ch in ipairs(wz:GetChildren()) do
							if ch:IsA("BasePart") then
								if string.find(ch.Name, "Sandbag", 1, true) then
									vas.TryAttachPropVisual(ch, "Sandbag")
								elseif string.find(ch.Name, "Crate", 1, true) then
									vas.TryAttachPropVisual(ch, "Crate")
								elseif string.find(ch.Name, "Drum", 1, true) then
									vas.TryAttachPropVisual(ch, "OilBarrel")
								elseif string.find(ch.Name, "Barrier", 1, true) then
									vas.TryAttachPropVisual(ch, "ConcreteBarrier")
								end
							end
						end
						local host = wz:FindFirstChildWhichIsA("BasePart")
						if host then
							vas.TryAttachPropVisual(host, "FloodlightTower")
						end
					end)
			end)
			if not okDress then
				warn("[MapSetup] PlotWarzone densify failed (pads intact):", errDress)
			end
		end
		buildMoneyCollector(plotFolder, plotId, pos)
	end

	local territories = ensureFolder("Territories", root)
	for _, def in ipairs(TERRITORIES) do
		local diameter = (def.Radius or 30) * 2
		local marker = part({
			Name = def.Id,
			Size = Vector3.new(diameter, 1.5, diameter),
			Position = def.Pos,
			Color = def.Color,
			Transparency = 0.45,
			Material = Enum.Material.Neon,
			Parent = territories,
		})
		marker:SetAttribute("TerritoryId", def.Id)
		marker:SetAttribute("Radius", def.Radius or 30)
		marker:SetAttribute("OwnerType", "Neutral")
		marker:SetAttribute("OwnerUserId", 0)
		marker:SetAttribute("CaptureProgress", 0)
		CollectionService:AddTag(marker, TAG_TERRITORY)
		CollectionService:AddTag(marker, TAG_CAPTURE)

		do
			local zoneName = def.DisplayName or def.Id
			local bb = plainBillboard(marker, zoneName .. "  [NEUTRAL]  ·  Stand to capture", Vector2.new(280, 48), 12, Color3.new(1, 1, 1))
			if typeof(bb) == "Instance" and bb:IsA("BillboardGui") then
				bb.MaxDistance = 220 -- named capture zones readable from farther
				bb.StudsOffset = Vector3.new(0, 14, 0)
			end
		end

		part({
			Name = def.Id .. "_Ring",
			Size = Vector3.new(diameter + 8, 0.4, diameter + 8),
			Position = def.Pos + Vector3.new(0, 0.2, 0),
			Color = def.Color,
			Transparency = 0.65,
			CanCollide = false,
			Material = Enum.Material.SmoothPlastic,
			Parent = territories,
		}):SetAttribute("TerritoryId", def.Id)

		part({
			Name = def.Id .. "_FlagPole",
			Size = Vector3.new(0.4, 14, 0.4),
			Position = def.Pos + Vector3.new(0, 7, 0),
			Color = Color3.fromRGB(55, 55, 55),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = territories,
		})
		local flag = part({
			Name = def.Id .. "_Flag",
			Size = Vector3.new(5.5, 3.2, 0.22),
			Position = def.Pos + Vector3.new(2.8, 12.2, 0),
			Color = def.Color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.08,
			Parent = territories,
		})
		flag:SetAttribute("TerritoryId", def.Id)
		flag:SetAttribute("WE_Flag", true)
		part({
			Name = def.Id .. "_FlagStripe",
			Size = Vector3.new(5.5, 0.45, 0.28),
			Position = def.Pos + Vector3.new(2.8, 12.2, 0),
			Color = Color3.fromRGB(245, 245, 245),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0.15,
			Parent = territories,
		})
		part({
			Name = def.Id .. "_Finial",
			Size = Vector3.new(0.7, 0.7, 0.7),
			Position = def.Pos + Vector3.new(0, 14.4, 0),
			Color = Color3.fromRGB(230, 190, 60),
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Ball,
			CanCollide = false,
			Parent = territories,
		})

		beacon(territories, def.Pos + Vector3.new(def.Radius * 0.6, 0, 0), def.Color, def.Id .. "_Beacon")

		-- Coastal oil platform deck + legs + harder NPC guards
		if def.OilRig then
			local deckY = def.Pos.Y
			local deck = part({
				Name = def.Id .. "_Deck",
				Size = Vector3.new(48, 2.5, 48),
				Position = Vector3.new(def.Pos.X, deckY - 1.2, def.Pos.Z),
				Color = Color3.fromRGB(90, 95, 100),
				Material = Enum.Material.Metal,
				Parent = territories,
			})
			deck:SetAttribute("TerritoryId", def.Id)
			-- Support legs
			local legOff = 18
			for _, ox in ipairs({ -legOff, legOff }) do
				for _, oz in ipairs({ -legOff, legOff }) do
					part({
						Name = def.Id .. "_Leg",
						Size = Vector3.new(3, deckY, 3),
						Position = Vector3.new(def.Pos.X + ox, deckY / 2, def.Pos.Z + oz),
						Color = Color3.fromRGB(60, 65, 70),
						Material = Enum.Material.Metal,
						Parent = territories,
					})
				end
			end
			-- Derrick + crane tip + neon rim (visual kits v2)
			part({
				Name = def.Id .. "_Derrick",
				Size = Vector3.new(4, 22, 4),
				Position = Vector3.new(def.Pos.X + 14, deckY + 11, def.Pos.Z + 14),
				Color = Color3.fromRGB(180, 140, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_CraneArm",
				Size = Vector3.new(14, 1.2, 1.2),
				Position = Vector3.new(def.Pos.X + 7, deckY + 20, def.Pos.Z + 14),
				Color = Color3.fromRGB(160, 120, 45),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_HelipadMark",
				Size = Vector3.new(10, 0.3, 10),
				Position = Vector3.new(def.Pos.X - 12, deckY + 0.2, def.Pos.Z - 12),
				Color = Color3.fromRGB(40, 45, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_NeonRim",
				Size = Vector3.new(46, 0.35, 0.5),
				Position = Vector3.new(def.Pos.X, deckY + 0.3, def.Pos.Z + 23),
				Color = Color3.fromRGB(255, 180, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = territories,
			})
			plainBillboard(deck, def.Id .. "  ·  OIL PLATFORM  ·  Hard guards", Vector2.new(300, 44), 14, Color3.fromRGB(255, 210, 120))
			-- Stairs from deck down to ground (prevent 28-stud death plunge)
			local inland = Vector3.new(-def.Pos.X, 0, -def.Pos.Z)
			buildOilDeckRamp(territories, def.Id, def.Pos, inland)
		end

		-- Fortress walls / keep (named forts with higher stipend)
		if def.Fortress then
			local wallH = 8
			local wallT = 2.2
			local span = (def.Radius or 48) * 1.35
			local wallDefs = {
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, span) },
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, -span) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(span, wallH / 2, 0) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(-span, wallH / 2, 0) },
			}
			for wi, wd in ipairs(wallDefs) do
				part({
					Name = def.Id .. "_Wall" .. wi,
					Size = wd[1],
					Position = def.Pos + wd[2],
					Color = Color3.fromRGB(95, 90, 75),
					Material = Enum.Material.Concrete,
					Parent = territories,
				})
			end
			local keep = part({
				Name = def.Id .. "_Keep",
				Size = Vector3.new(14, 16, 14),
				Position = def.Pos + Vector3.new(0, 8, 0),
				Color = def.Color,
				Material = Enum.Material.Brick,
				Parent = territories,
			})
			keep:SetAttribute("TerritoryId", def.Id)
			part({
				Name = def.Id .. "_KeepRoof",
				Size = Vector3.new(16, 1.5, 16),
				Position = def.Pos + Vector3.new(0, 16.5, 0),
				Color = Color3.fromRGB(70, 65, 55),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			-- Corner towers + gate neon
			for _, corner in ipairs({
				Vector3.new(span, 0, span),
				Vector3.new(span, 0, -span),
				Vector3.new(-span, 0, span),
				Vector3.new(-span, 0, -span),
			}) do
				part({
					Name = def.Id .. "_Tower",
					Size = Vector3.new(5, 12, 5),
					Position = def.Pos + corner + Vector3.new(0, 6, 0),
					Color = Color3.fromRGB(85, 80, 65),
					Material = Enum.Material.Brick,
					Parent = territories,
				})
			end
			part({
				Name = def.Id .. "_GateNeon",
				Size = Vector3.new(8, 0.4, 0.5),
				Position = def.Pos + Vector3.new(0, 1.5, span),
				Color = def.Color,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = territories,
			})
			plainBillboard(keep, def.Id .. "  ·  FORTRESS  ·  High stipend", Vector2.new(300, 44), 12, Color3.fromRGB(230, 210, 160))
		end
	end

	local function makeSpawnFolder(name, tag, count, center, color, ringRadius)
		local folder = ensureFolder(name, root)
		local ring = ringRadius or 200
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local pos = center + Vector3.new(math.cos(angle) * ring, 1, math.sin(angle) * ring)
			local padSize = if tag == TAG_VEHICLE then 20 else 14
			local p = part({
				Name = name .. i,
				Size = Vector3.new(padSize, 1.2, padSize),
				Position = pos,
				Color = color,
				Material = Enum.Material.Concrete,
				Parent = folder,
			})
			CollectionService:AddTag(p, tag)
			neonEdge(p, color:Lerp(Color3.new(1, 1, 1), 0.35), 0.35)
			if tag == TAG_VEHICLE then
				part({
					Name = "HMark",
					Size = Vector3.new(6, 0.2, 1),
					Position = pos + Vector3.new(0, 0.7, 0),
					Color = Color3.fromRGB(200, 220, 255),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
				part({
					Name = "HMark2",
					Size = Vector3.new(1, 0.2, 6),
					Position = pos + Vector3.new(0, 0.7, 0),
					Color = Color3.fromRGB(200, 220, 255),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
				beacon(folder, pos, Color3.fromRGB(90, 160, 220), name .. i .. "_Beacon")
				plainBillboard(p, "GARAGE PAD · E / G", Vector2.new(170, 32), 5, Color3.fromRGB(200, 220, 255))
			elseif tag == TAG_NPC then
				plainBillboard(p, "NPC SPAWN", Vector2.new(140, 28), 4, Color3.fromRGB(255, 180, 180))
			else
				plainBillboard(p, "EVENT ZONE", Vector2.new(140, 28), 4, Color3.fromRGB(255, 220, 160))
			end
		end
	end

	-- Rings scaled for ~4800 ground: garage pads spread; more pads for large roster testing
	makeSpawnFolder("VehicleSpawns", TAG_VEHICLE, 10, Vector3.new(0, 0, 0), COL_VEHICLE, 650)
	makeSpawnFolder("NPCSpawns", TAG_NPC, 10, Vector3.new(480, 0, 480), COL_NPC, 550)
	makeSpawnFolder("EventSpawns", TAG_EVENT, 6, Vector3.new(-480, 0, -480), COL_EVENT, 500)

	-- Coastal water band (south of SouthDocks on ~4800 map) + naval spawn pads
	do
		local waterFolder = ensureFolder("CoastalWater", root)
		local water = part({
			Name = "WaterPlane",
			Size = Vector3.new(GROUND_SIZE * 0.9, 1, 720),
			Position = Vector3.new(0, 0.2, 1850),
			Color = Color3.fromRGB(45, 120, 145),
			Material = Enum.Material.Glass,
			Transparency = 0.32,
			CanCollide = false,
			Parent = waterFolder,
		})
		water.Name = "WaterPlane"
		-- Shallow collide strip so boats have something under them
		part({
			Name = "HarborShelf",
			Size = Vector3.new(GROUND_SIZE * 0.75, 1, 120),
			Position = Vector3.new(0, 0.4, 1520),
			Color = Color3.fromRGB(55, 95, 105),
			Material = Enum.Material.Sandstone,
			Transparency = 0.12,
			CanCollide = true,
			Parent = waterFolder,
		})
		local navalFolder = ensureFolder("NavalSpawns", root)
		local navalPositions = {
			Vector3.new(-420, 1.5, 1580),
			Vector3.new(-240, 1.5, 1620),
			Vector3.new(-80, 1.5, 1640),
			Vector3.new(80, 1.5, 1640),
			Vector3.new(240, 1.5, 1620),
			Vector3.new(420, 1.5, 1580),
			Vector3.new(0, 1.5, 1720),
			Vector3.new(-560, 1.5, 1680),
			Vector3.new(560, 1.5, 1680),
		}
		for i, npos in ipairs(navalPositions) do
			local np = part({
				Name = "NavalPad_" .. i,
				Size = Vector3.new(18, 1.2, 18),
				Position = npos,
				Color = Color3.fromRGB(40, 70, 95),
				Material = Enum.Material.Concrete,
				CanCollide = true,
				Parent = navalFolder,
			})
			CollectionService:AddTag(np, TAG_NAVAL)
			CollectionService:AddTag(np, TAG_VEHICLE) -- garage prompt also works
			beacon(navalFolder, npos, Color3.fromRGB(70, 180, 220), "NavalBeacon" .. i)
			plainBillboard(np, "NAVAL PAD · E / G", Vector2.new(170, 32), 5, Color3.fromRGB(160, 220, 255))
		end
	end

	local npcFolder = ensureFolder("NPCPlaceholders", root)
	for i, spawnPart in ipairs(CollectionService:GetTagged(TAG_NPC)) do
		if i > 4 then
			break
		end
		makeSoldierKit(
			npcFolder,
			"HostileInfantry_" .. i,
			spawnPart.CFrame + Vector3.new(0, 3.2, 0),
			Color3.fromRGB(140, 55, 55),
			"HOSTILE",
			Color3.fromRGB(255, 120, 100),
			80,
			"Infantry",
			"studio_npc_" .. i
		)
	end


	-- Oil rig guards (harder NPC placeholders — visual kits v2 infantry)
	for _, def in ipairs(TERRITORIES) do
		if def.OilRig then
			for gi = 1, 4 do
				local angle = (gi / 4) * math.pi * 2
				local gpos = def.Pos + Vector3.new(math.cos(angle) * 16, 2.6, math.sin(angle) * 16)
				makeSoldierKit(
					npcFolder,
					def.Id .. "_Guard_" .. gi,
					CFrame.new(gpos),
					Color3.fromRGB(110, 70, 35),
					"OIL GUARD",
					Color3.fromRGB(255, 180, 80),
					200,
					"OilRigGuard",
					def.Id .. "_guard_" .. gi
				)
			end
		end
	end

	-- Fort guards
	for _, def in ipairs(TERRITORIES) do
		if def.Fortress then
			for gi = 1, 4 do
				local angle = (gi / 4) * math.pi * 2
				local gpos = def.Pos + Vector3.new(math.cos(angle) * 22, 2.6, math.sin(angle) * 22)
				makeSoldierKit(
					npcFolder,
					def.Id .. "_Guard_" .. gi,
					CFrame.new(gpos),
					Color3.fromRGB(100, 95, 70),
					"FORT GUARD",
					Color3.fromRGB(220, 200, 140),
					170,
					"FortGuard",
					def.Id .. "_guard_" .. gi
				)
			end
		end
	end

	-- Empire Bank (raid stub) — high-value vault + BankGuard NPCs
	local bankFolder = ensureFolder("EmpireBank", root)
	local bankPos = Vector3.new(220, 1, -220) -- matches BankRaidConfig.Position -- matches BankRaidConfig.Position
	local bankPad = part({
		Name = "BankPlaza",
		Size = Vector3.new(36, 1.2, 36),
		Position = bankPos,
		Color = Color3.fromRGB(45, 50, 70),
		Material = Enum.Material.Concrete,
		Parent = bankFolder,
	})
	neonEdge(bankPad, Color3.fromRGB(90, 120, 200), 0.4)
	part({
		Name = "BankBuilding",
		Size = Vector3.new(22, 14, 18),
		Position = bankPos + Vector3.new(0, 7.5, -4),
		Color = Color3.fromRGB(55, 62, 85),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	part({
		Name = "BankRoof",
		Size = Vector3.new(24, 1.2, 20),
		Position = bankPos + Vector3.new(0, 15, -4),
		Color = Color3.fromRGB(40, 45, 60),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	-- Columns + entrance neon (visual kits v2)
	for _, ox in ipairs({ -8, -2.5, 2.5, 8 }) do
		part({
			Name = "BankColumn",
			Size = Vector3.new(1.4, 12, 1.4),
			Position = bankPos + Vector3.new(ox, 6.5, 5.5),
			Color = Color3.fromRGB(70, 78, 100),
			Material = Enum.Material.Marble,
			Parent = bankFolder,
		})
	end
	part({
		Name = "BankDoor",
		Size = Vector3.new(4.5, 6, 0.4),
		Position = bankPos + Vector3.new(0, 3.5, 5.2),
		Color = Color3.fromRGB(30, 35, 50),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	part({
		Name = "BankSign",
		Size = Vector3.new(10, 1.2, 0.4),
		Position = bankPos + Vector3.new(0, 12.5, 5.2),
		Color = Color3.fromRGB(230, 190, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = bankFolder,
	})
	local vault = part({
		Name = "VaultPad",
		Size = Vector3.new(10, 1.4, 10),
		Position = bankPos + Vector3.new(0, 1.2, 8),
		Color = Color3.fromRGB(200, 170, 60),
		Material = Enum.Material.Neon,
		Parent = bankFolder,
	})
	part({
		Name = "VaultRing",
		Size = Vector3.new(12, 0.35, 12),
		Position = bankPos + Vector3.new(0, 1.9, 8),
		Color = Color3.fromRGB(90, 140, 220),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.35,
		Parent = bankFolder,
	})
	vault:SetAttribute("BankId", "EmpireBank")
	CollectionService:AddTag(vault, "WE_BankVault")
	plainBillboard(vault, "EMPIRE BANK · Stand to RAID cash", Vector2.new(280, 40), 8, Color3.fromRGB(255, 220, 120))
	beacon(bankFolder, bankPos + Vector3.new(14, 0, 14), Color3.fromRGB(90, 130, 220), "BankBeacon")
	-- Bank guards spawned live via CombatService.SpawnNPC("BankGuard", cf) in BankRaidService
	-- (static makeSoldierKit props removed — they were Anchored stick figures with double nametags)

	local tutorialFolder = ensureFolder("TutorialMarkers", root)
	local function tutorialMarker(name, pos, color, stepId)
		-- Hidden by default; TutorialController reveals only the active step (no billboard spam)
		local p = part({
			Name = name,
			Size = Vector3.new(7, 1.2, 7),
			Position = pos,
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 1,
			CanCollide = false,
			Parent = tutorialFolder,
		})
		p:SetAttribute("TutorialStepId", stepId or name)
		CollectionService:AddTag(p, TAG_TUTORIAL)
		local bb = plainBillboard(p, "TUT · " .. name:gsub("Tutorial_", ""), Vector2.new(200, 34), 6, Color3.fromRGB(255, 245, 180))
		if typeof(bb) == "Instance" and bb:IsA("BillboardGui") then
			bb.Enabled = false
		end
		-- No beacon / ring clutter — waypoint beam is enough
		return p
	end

	local plot1 = PLOT_POSITIONS[1]
	-- Offsets track Plot1 spawn / structure grid (STRUCT_ORIGIN + gaps)
	local mClaim = tutorialMarker("Tutorial_ClaimBase", plot1 + Vector3.new(0, 2, 52), Color3.fromRGB(230, 200, 80), "ClaimBase")
	local mCC = tutorialMarker("Tutorial_CommandCenter", plot1 + STRUCT_ORIGIN + Vector3.new(0, 1.4, 0), Color3.fromRGB(80, 200, 120), "CommandCenter")
	local mRecruit = tutorialMarker("Tutorial_Recruit", plot1 + Vector3.new(-14, 3, 42), Color3.fromRGB(180, 220, 100), "RecruitSoldiers")
	tutorialMarker("Tutorial_Income", plot1 + Vector3.new(28, 3, 8), Color3.fromRGB(80, 200, 160), "Income")
	-- Click dropper sits near ATM (ManualDropper CollectorOffset ≈ -5.5, 0, 4 from collector body)
	tutorialMarker("Tutorial_Dropper", plot1 + Vector3.new(28 - 5.5, 2.5, 8 + 4), Color3.fromRGB(70, 220, 100), "ClickDropper")
	-- Pads first / beams first 3 beats: dress arrow meshes on early markers
	task.defer(function()
		pcall(function()
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			if vas and vas.TryAttachTutorialArrow then
				for _, m in ipairs({ mClaim, mCC, mRecruit }) do
					if m then
						vas.TryAttachTutorialArrow(m)
					end
				end
			end
		end)
	end)
	tutorialMarker("Tutorial_Barracks", plot1 + STRUCT_ORIGIN + Vector3.new(STRUCT_GAP, 1.4, 0), Color3.fromRGB(100, 180, 220), "Barracks")
	local jeepPos = Vector3.new(200, 2, 0)
	local vSpawns = CollectionService:GetTagged(TAG_VEHICLE)
	if #vSpawns > 0 and vSpawns[1]:IsA("BasePart") then
		jeepPos = vSpawns[1].Position + Vector3.new(0, 2, 0)
	end
	tutorialMarker("Tutorial_Jeep", jeepPos, Color3.fromRGB(120, 140, 200), "Jeep")
	tutorialMarker("Tutorial_Outpost", Vector3.new(0, 3, 0), Color3.fromRGB(200, 120, 80), "Outpost")

	-- Neon Accent guide beams: collector → CommandCenter → VehicleDepot (Plot1 landmark path)
	do
		local okNeon, errNeon = pcall(function()
			local neon = Color3.fromRGB(80, 255, 160)
			local collectorPos = plot1 + Vector3.new(28, 5, 8)
			local ccPos = plot1 + STRUCT_ORIGIN + Vector3.new(0, 4, 0)
			local depotIdx = 3 -- STRUCTURES[3] = VehicleDepot
			local depotCol = (depotIdx - 1) % STRUCT_COLS
			local depotRow = math.floor((depotIdx - 1) / STRUCT_COLS)
			local depotPos = plot1 + STRUCT_ORIGIN + Vector3.new(depotCol * STRUCT_GAP, 4, depotRow * STRUCT_GAP)
			local function neonBeam(fromPos: Vector3, toPos: Vector3, name: string)
				local a0p = part({
					Name = name .. "_A0",
					Size = Vector3.new(0.4, 0.4, 0.4),
					Position = fromPos,
					Color = neon,
					Material = Enum.Material.Neon,
					Transparency = 1,
					CanCollide = false,
					Parent = tutorialFolder,
				})
				local a1p = part({
					Name = name .. "_A1",
					Size = Vector3.new(0.4, 0.4, 0.4),
					Position = toPos,
					Color = neon,
					Material = Enum.Material.Neon,
					Transparency = 1,
					CanCollide = false,
					Parent = tutorialFolder,
				})
				local att0 = Instance.new("Attachment")
				att0.Parent = a0p
				local att1 = Instance.new("Attachment")
				att1.Parent = a1p
				local beam = Instance.new("Beam")
				beam.Name = name
				beam.Attachment0 = att0
				beam.Attachment1 = att1
				beam:SetAttribute("WE_TutorialBeamAsset", 88687072714005)
				beam.FaceCamera = true
				beam.Width0 = 0.35
				beam.Width1 = 0.35
				beam.Color = ColorSequence.new(neon)
				beam.Transparency = NumberSequence.new(0.35)
				beam.LightEmission = 0.9
				beam.Parent = a0p
			end
			neonBeam(collectorPos, ccPos, "WE_NeonPath_CollectorToCC")
			neonBeam(ccPos, depotPos, "WE_NeonPath_CCToDepot")
		end)
		if not okNeon then
			warn("[WAR EMPIRE] MapSetup neon/tutorial path failed (pads already built):", errNeon)
		end
	end

	-- Military world dressing (visual only). Does not tag WE_UpgradeSlot / buy pads.
	-- PERF: skip MapDressing entirely in Studio unless ForceDress (attribute or DevConfig).
	-- Stagger after first frame so Play Solo is usable in seconds on laptop CPUs.
	task.defer(function()
		task.wait() -- yield past first frame
		local forceAttr = root:GetAttribute("ForceDress") == true
			or (Workspace:GetAttribute("ForceDress") == true)
		local forceDress = forceAttr or (DevConfig.StudioForceDress == true)
		local inStudio = RunService:IsStudio()
		local skipDress = inStudio and (DevConfig.StudioSkipWorldDressing ~= false) and not forceDress
		-- Live / non-Studio: Full warzone dressing. Studio ForceDress uses DevConfig quality.
		local quality = if (not inStudio) then "Full" else tostring(DevConfig.WorldDressQuality or "Low")

		print("[WAR EMPIRE] PERF note: deco kits use CastShadow=false. Studio Rendering → disable shadows / lower quality if still slow.")
		if skipDress then
			print("[WAR EMPIRE] PERF: MapDressing SKIPPED in Studio (StudioSkipWorldDressing). Set Workspace.WarEmpireSetup.ForceDress=true or DevConfig.StudioForceDress=true then resetmap to load dressing.")
		else
			task.wait(0.05)
			local okDress, errDress = pcall(function()
				MapDressing.Dress(root, { Quality = quality })
			end)
			if not okDress then
				warn("[WAR EMPIRE] MapDressing failed:", errDress)
			end
		end

		task.wait(0.1)
		-- Sparse flora by default (Studio + Low). Full flora only when WorldDressQuality=Full outside Studio,
		-- or StudioSparseFlora=false for intentional dense Studio art checks.
		local wantFullFlora = ((not inStudio) and string.lower(tostring(DevConfig.WorldDressQuality or "Low")) == "full")
			or (inStudio and DevConfig.StudioSparseFlora == false)
		local sparseFlora = not wantFullFlora
		local okFlora, errFlora = pcall(function()
			DesertFlora.Dress(root, { Sparse = sparseFlora })
		end)
		if not okFlora then
			warn("[WAR EMPIRE] DesertFlora failed:", errFlora)
		end
	end)

	-- Guarantee at least one Neutral Duration=0 spawn near origin
	local hasNeutralSpawn = false
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("SpawnLocation") and inst.Neutral and inst.Duration == 0 then
			hasNeutralSpawn = true
			break
		end
	end
	if not hasNeutralSpawn then
		local fallbackSpawn = Instance.new("SpawnLocation")
		fallbackSpawn.Name = "NeutralSpawn"
		fallbackSpawn.Size = Vector3.new(12, 1, 12)
		fallbackSpawn.Position = Vector3.new(0, 5, 0)
		fallbackSpawn.Anchored = true
		fallbackSpawn.CanCollide = true
		fallbackSpawn.Neutral = true
		fallbackSpawn.Duration = 0
		fallbackSpawn.BrickColor = BrickColor.new("Bright green")
		fallbackSpawn.Material = Enum.Material.Neon
		fallbackSpawn.Parent = root
		print("[WAR EMPIRE] MapSetup: added fallback NeutralSpawn at (0,5,0)")
	end

		buildPadSupportShelves(root)

	-- Tier 2: near-plot oil spectacle (IndustrialPack + pipes + barrel ring). REJECT Ultrapump.
	do
		local okOil, errOil = pcall(function()
			local oilFolder = Instance.new("Folder")
			oilFolder.Name = "OilSpectacle"
			oilFolder.Parent = root
			local pads = {
				Vector3.new(-520, 0.5, -180),
				Vector3.new(520, 0.5, 180),
				Vector3.new(-200, 0.5, 620),
			}
			for oi, opos in ipairs(pads) do
				local pad = part({
					Name = "OilPad" .. oi,
					Size = Vector3.new(28, 0.6, 28),
					Position = opos,
					Color = Color3.fromRGB(42, 44, 40),
					Material = Enum.Material.Asphalt,
					CanCollide = true,
					Parent = oilFolder,
				})
				plainBillboard(pad, "OIL FIELD", Vector2.new(160, 32), 12, Color3.fromRGB(255, 180, 60))
				-- Amber landmark light
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 160, 40)
				light.Brightness = 1.2
				light.Range = 40
				light.Parent = pad
				-- Walking-beam silhouette (Part kit derrick)
				local tower = part({
					Name = "DerrickTower" .. oi,
					Size = Vector3.new(1.2, 18, 1.2),
					Position = opos + Vector3.new(0, 9.5, 0),
					Color = Color3.fromRGB(70, 72, 68),
					Material = Enum.Material.Metal,
					CanCollide = false,
					Parent = oilFolder,
				})
				local beam = part({
					Name = "WalkingBeam" .. oi,
					Size = Vector3.new(14, 0.7, 0.7),
					Position = opos + Vector3.new(0, 17, 0),
					Color = Color3.fromRGB(90, 70, 50),
					Material = Enum.Material.Metal,
					CanCollide = false,
					Parent = oilFolder,
				})
				beam:SetAttribute("WE_OilBeam", true)
				-- Barrel ring
				for bi = 1, 8 do
					local ang = (bi / 8) * math.pi * 2
					local bpos = opos + Vector3.new(math.cos(ang) * 9, 1.1, math.sin(ang) * 9)
					part({
						Name = "OilBarrel" .. oi .. "_" .. bi,
						Size = Vector3.new(1.6, 2.2, 1.6),
						Position = bpos,
						Color = Color3.fromRGB(45, 70, 45),
						Material = Enum.Material.Metal,
						Shape = Enum.PartType.Cylinder,
						CanCollide = true,
						Parent = oilFolder,
					})
				end
				-- Catalog dress (IndustrialPack / RustyPipes / OilBarrel)
				task.defer(function()
					pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if not vas then
							return
						end
						vas.TryAttachPropVisual(tower, "IndustrialPack")
						vas.TryAttachPropVisual(beam, "RustyPipes")
						for _, ch in ipairs(oilFolder:GetChildren()) do
							if ch:IsA("BasePart") and string.find(ch.Name, "OilBarrel" .. oi, 1, true) then
								vas.TryAttachPropVisual(ch, "OilBarrel")
							end
						end
					end)
				end)
			end
			-- Slow walking-beam sway
			task.spawn(function()
				local t0 = os.clock()
				while oilFolder.Parent do
					local t = os.clock() - t0
					for _, ch in ipairs(oilFolder:GetChildren()) do
						if ch:IsA("BasePart") and ch:GetAttribute("WE_OilBeam") then
							ch.CFrame = CFrame.new(ch.Position) * CFrame.Angles(0, 0, math.rad(math.sin(t * 0.7) * 12))
						end
					end
					task.wait(0.1)
				end
			end)
		end)
		if not okOil then
			warn("[MapSetup] OilSpectacle failed:", errOil)
		end
	end

	-- Tier 2: warzone landmarks (RadioTower / SmallFort / Bunker)
	do
		local okLm, errLm = pcall(function()
			local lm = Instance.new("Folder")
			lm.Name = "WarzoneLandmarks"
			lm.Parent = root
			local spots = {
				{ Name = "RadioTower", Key = "RadioTower", Pos = Vector3.new(0, 0.5, -1400), Size = Vector3.new(4, 28, 4) },
				{ Name = "SmallFort", Key = "SmallFort", Pos = Vector3.new(1100, 0.5, -1100), Size = Vector3.new(18, 10, 18) },
				{ Name = "BunkerApproach", Key = "Bunker", Pos = Vector3.new(-1100, 0.5, 900), Size = Vector3.new(14, 6, 14) },
			}
			for _, s in ipairs(spots) do
				local host = part({
					Name = s.Name .. "Host",
					Size = s.Size,
					Position = s.Pos + Vector3.new(0, s.Size.Y * 0.5, 0),
					Color = Color3.fromRGB(80, 78, 70),
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Transparency = 0.25,
					Parent = lm,
				})
				plainBillboard(host, string.upper(s.Name), Vector2.new(180, 32), 14, Color3.fromRGB(220, 200, 140))
				task.defer(function()
					pcall(function()
						local vas = require(script.Parent.Parent.Services.VisualAssetService)
						if vas and vas.TryAttachPropVisual then
							vas.TryAttachPropVisual(host, s.Key)
						end
					end)
				end)
			end
		end)
		if not okLm then
			warn("[MapSetup] WarzoneLandmarks failed:", errLm)
		end
	end


	print("[WAR EMPIRE] MapSetup complete: desert ground=" .. tostring(GROUND_SIZE) .. "x" .. tostring(GROUND_THICKNESS) .. " topY=" .. tostring(GROUND_TOP_Y) .. " mesas=" .. tostring(DevConfig.MountainRingSegments or 14) .. " (dressing deferred/Studio-skip)")
	print("[WAR EMPIRE] MapSetup confirmation: Gravity=" .. tostring(Workspace.Gravity) .. " WarEmpireSetup children=" .. tostring(#root:GetChildren()))
	print("[WAR EMPIRE] Walk onto upgrade pads to BUY (auto). E opens Base/Garage menus. Delete WarEmpireSetup + Play / admin resetmap to regenerate.")
end

return MapSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Default player profile + migrations.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"))
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local Types = require(Shared:WaitForChild("Types"))

type PlayerProfile = Types.PlayerProfile

local ProfileSchema = {}

local function emptyUpgrades(): { [string]: number }
	local upgrades: { [string]: number } = {}
	for id in pairs(BaseConfig.Structures) do
		upgrades[id] = 0
	end
	return upgrades
end

local function emptyDailyMissions(): Types.DailyMissionProgress
	return {
		DayKey = 0,
		Progress = {},
		Claimed = {},
		ActiveTimed = {},
	}
end

function ProfileSchema.CreateDefault(): PlayerProfile
	local now = os.time()
	return {
		DataVersion = Constants.CURRENT_DATA_VERSION,
		Cash = EconomyConfig.StartingCash,
		PendingCash = 0,
		Gold = EconomyConfig.StartingGold,
		Level = 1,
		XP = 0,
		Prestige = 0,
		RebirthUnlocks = {},
		Soldiers = SoldierConfig.StartingSoldiers,
		NationColorId = nil,
		RedeemedCodes = {},
		LastSpinnerClaimUnix = 0,
		Vehicles = {
			[VehicleConfig.StarterVehicle] = true,
		},
		Weapons = {
			[WeaponConfig.DefaultWeapon] = true,
		},
		EquippedWeapon = WeaponConfig.DefaultWeapon,
		Territories = {},
		BaseUpgrades = emptyUpgrades(),
		BasePlotId = nil,
		TutorialStep = 0,
		TutorialComplete = false,
		DailyLogin = {
			LastClaimDay = 0,
			Streak = 0,
			LastClaimUnix = 0,
		},
		DailyMissions = emptyDailyMissions(),
		Settings = {
			MusicVolume = 0.7,
			SFXVolume = 0.8,
			ShowDamageNumbers = true,
			AutoSprint = true,
		},
		Stats = {
			TotalCashEarned = 0,
			TotalGoldEarned = 0,
			UpgradesPurchased = 0,
			VehiclesSpawned = 0,
			MissionsCompleted = 0,
			TerritoriesCaptured = 0,
			Kills = 0,
			Deaths = 0,
			PlayTimeSeconds = 0,
		},
		Achievements = {},
		BattlePass = {
			SeasonId = SeasonConfig.CurrentSeasonId,
			XP = 0,
			Level = 0,
			Premium = false,
			ClaimedFree = {},
			ClaimedPremium = {},
		},
		ClanId = nil,
		FirstJoinUnix = now,
		LastJoinUnix = now,
		ProcessedReceipts = {},
		Entitlements = {},
		OutpostIncomeStacks = 0,
		StarterBundleOffered = false,
		AutoCollectOffered = false,
		DoubleCashOffered = false,
		VIPOffered = false,
	}
end

--[[
	Migrate older profiles to CURRENT_DATA_VERSION.
	Add new migration steps as DataVersion increments.
]]
function ProfileSchema.Migrate(data: any): PlayerProfile
	if typeof(data) ~= "table" then
		return ProfileSchema.CreateDefault()
	end

	local profile = data :: PlayerProfile
	local version = tonumber(profile.DataVersion) or 0

	-- v0 / missing → fill defaults then set version
	if version < 1 then
		local defaults = ProfileSchema.CreateDefault()
		for key, value in pairs(defaults) do
			if profile[key] == nil then
				(profile :: any)[key] = value
			end
		end
		-- Ensure nested tables
		if typeof(profile.BaseUpgrades) ~= "table" then
			profile.BaseUpgrades = emptyUpgrades()
		else
			for id in pairs(BaseConfig.Structures) do
				if profile.BaseUpgrades[id] == nil then
					profile.BaseUpgrades[id] = 0
				end
			end
		end
		if typeof(profile.Vehicles) ~= "table" then
			profile.Vehicles = { [VehicleConfig.StarterVehicle] = true }
		elseif not profile.Vehicles[VehicleConfig.StarterVehicle] then
			profile.Vehicles[VehicleConfig.StarterVehicle] = true
		end
		if typeof(profile.Weapons) ~= "table" then
			profile.Weapons = { [WeaponConfig.DefaultWeapon] = true }
		elseif not profile.Weapons[WeaponConfig.DefaultWeapon] then
			profile.Weapons[WeaponConfig.DefaultWeapon] = true
		end
		profile.DataVersion = 1
		version = 1
	end

	-- v1 → v2: DailyMissions progress table
	if version < 2 then
		if typeof((profile :: any).DailyMissions) ~= "table" then
			(profile :: any).DailyMissions = emptyDailyMissions()
		else
			local dm = (profile :: any).DailyMissions
			if typeof(dm.Progress) ~= "table" then
				dm.Progress = {}
			end
			if typeof(dm.Claimed) ~= "table" then
				dm.Claimed = {}
			end
			if typeof(dm.ActiveTimed) ~= "table" then
				dm.ActiveTimed = {}
			end
			if typeof(dm.DayKey) ~= "number" then
				dm.DayKey = 0
			end
		end
		if typeof(profile.Achievements) ~= "table" then
			profile.Achievements = {}
		end
		if typeof(profile.Territories) ~= "table" then
			profile.Territories = {}
		end
		profile.DataVersion = 2
		version = 2
	end


	-- v2 → v3: ensure clan / season / battle pass / soldier / war-adjacent fields for older saves
	if version < 3 then
		if typeof(profile.Prestige) ~= "number" then
			profile.Prestige = 0
		end
		if typeof(profile.Soldiers) ~= "number" then
			profile.Soldiers = SoldierConfig.StartingSoldiers or 0
		end
		if profile.ClanId ~= nil and typeof(profile.ClanId) ~= "string" then
			profile.ClanId = nil
		end
		if typeof(profile.BattlePass) ~= "table" then
			profile.BattlePass = {
				SeasonId = SeasonConfig.CurrentSeasonId,
				XP = 0,
				Level = 0,
				Premium = false,
				ClaimedFree = {},
				ClaimedPremium = {},
			}
		else
			local bp = profile.BattlePass
			if typeof(bp.SeasonId) ~= "string" then
				bp.SeasonId = SeasonConfig.CurrentSeasonId
			end
			if typeof(bp.XP) ~= "number" then
				bp.XP = 0
			end
			if typeof(bp.Level) ~= "number" then
				bp.Level = 0
			end
			if typeof(bp.Premium) ~= "boolean" then
				bp.Premium = false
			end
			if typeof(bp.ClaimedFree) ~= "table" then
				bp.ClaimedFree = {}
			end
			if typeof(bp.ClaimedPremium) ~= "table" then
				bp.ClaimedPremium = {}
			end
		end
		if typeof(profile.Stats) == "table" then
			if typeof(profile.Stats.TerritoriesCaptured) ~= "number" then
				profile.Stats.TerritoriesCaptured = 0
			end
			if typeof(profile.Stats.Kills) ~= "number" then
				profile.Stats.Kills = 0
			end
			if typeof(profile.Stats.Deaths) ~= "number" then
				profile.Stats.Deaths = 0
			end
		end
		if typeof(profile.Territories) ~= "table" then
			profile.Territories = {}
		end
		if typeof(profile.Achievements) ~= "table" then
			profile.Achievements = {}
		end
		profile.DataVersion = 3
		version = 3
	end

	-- v3 → v4: nation color + redeemed codes (MT-inspired systems)
	if version < 4 then
		if profile.NationColorId ~= nil and typeof(profile.NationColorId) ~= "string" then
			profile.NationColorId = nil
		end
		if typeof(profile.RedeemedCodes) ~= "table" then
			profile.RedeemedCodes = {}
		end
		profile.DataVersion = 4
		version = 4
	end

	-- v4 → v5: free supply spinner cooldown stamp
	if version < 5 then
		if typeof((profile :: any).LastSpinnerClaimUnix) ~= "number" then
			(profile :: any).LastSpinnerClaimUnix = 0
		end
		profile.DataVersion = 5
		version = 5
	end


	-- v5 → v6: rebirth unlock flags (prestige track)
	if version < 6 then
		if typeof((profile :: any).RebirthUnlocks) ~= "table" then
			(profile :: any).RebirthUnlocks = {}
		end
		profile.DataVersion = 6
		version = 6
	end


	-- v6 → v7: Money Collector pending cash + entitlements flags
	if version < 7 then
		if typeof((profile :: any).PendingCash) ~= "number" then
			(profile :: any).PendingCash = 0
		end
		if typeof((profile :: any).Entitlements) ~= "table" then
			(profile :: any).Entitlements = {}
		end
		profile.DataVersion = 7
		version = 7
	end


	-- v7 → v8: permanent outpost income buff stacks
	if version < 8 then
		if typeof((profile :: any).OutpostIncomeStacks) ~= "number" then
			(profile :: any).OutpostIncomeStacks = 0
		end
		profile.DataVersion = 8
		version = 8
	end

	if typeof((profile :: any).ProcessedReceipts) ~= "table" then
		(profile :: any).ProcessedReceipts = {}
	end
	if typeof((profile :: any).PendingCash) ~= "number" then
		(profile :: any).PendingCash = 0
	end
	if typeof((profile :: any).Entitlements) ~= "table" then
		(profile :: any).Entitlements = {}
	end
	if typeof((profile :: any).OutpostIncomeStacks) ~= "number" then
		(profile :: any).OutpostIncomeStacks = 0
	end
	if (profile :: any).StarterBundleOffered == nil then
		(profile :: any).StarterBundleOffered = false
	end
	if (profile :: any).AutoCollectOffered == nil then
		(profile :: any).AutoCollectOffered = false
	end
	if (profile :: any).DoubleCashOffered == nil then
		(profile :: any).DoubleCashOffered = false
	end
	if (profile :: any).VIPOffered == nil then
		(profile :: any).VIPOffered = false
	end

	profile.DataVersion = Constants.CURRENT_DATA_VERSION
	return profile
end

function ProfileSchema.DeepCopy(profile: PlayerProfile): PlayerProfile
	-- Simple recursive copy sufficient for our schema
	local function copy(v: any): any
		if typeof(v) ~= "table" then
			return v
		end
		local t = {}
		for k, val in pairs(v) do
			t[k] = copy(val)
		end
		return t
	end
	return copy(profile) :: PlayerProfile
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">RemoteGuard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shared client→server remote argument guards.
	Use with RateLimitService + DataService.GetProfile — never trust client types/ranges.
]]

local RemoteGuard = {}

local DEFAULT_ID_MAX = 64
local DEFAULT_KEY_MAX = 48
local DEFAULT_CMD_MAX = 32

function RemoteGuard.IsFiniteNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

--[[ Non-empty string within max length (ids, keys, mission ids). ]]
function RemoteGuard.IsIdString(value: any, maxLen: number?): boolean
	if typeof(value) ~= "string" then
		return false
	end
	local s = value :: string
	if s == "" then
		return false
	end
	local max = maxLen or DEFAULT_ID_MAX
	return #s <= max
end

function RemoteGuard.IsKeyString(value: any, maxLen: number?): boolean
	return RemoteGuard.IsIdString(value, maxLen or DEFAULT_KEY_MAX)
end

function RemoteGuard.IsCommandString(value: any, maxLen: number?): boolean
	return RemoteGuard.IsIdString(value, maxLen or DEFAULT_CMD_MAX)
end

--[[ Floor + clamp to [minN, maxN]; nil if not a finite number. ]]
function RemoteGuard.ClampInt(value: any, minN: number, maxN: number): number?
	if not RemoteGuard.IsFiniteNumber(value) then
		return nil
	end
	local n = math.floor(value :: number)
	if n < minN or n > maxN then
		return nil
	end
	return n
end

function RemoteGuard.ClampPositiveInt(value: any, maxN: number): number?
	return RemoteGuard.ClampInt(value, 1, maxN)
end

--[[ Profile must be loaded before mutating economy / progression. ]]
function RemoteGuard.RequireProfile(dataService: any, player: Player): any?
	if not dataService or not dataService.GetProfile then
		return nil
	end
	return dataService.GetProfile(player)
end

return RemoteGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">RemoteSetup</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Creates remotes under ReplicatedStorage.Remotes.
	Request/action pattern ONLY — no GiveCash / GiveXP / GiveWeapon remotes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local RemoteSetup = {}

local EVENTS = {
	-- Server pushes
	Constants.RemoteNames.PlayerStateUpdate,
	Constants.RemoteNames.BaseStateUpdate,
	Constants.RemoteNames.Notification,
	Constants.RemoteNames.EconomyUpdate,
	Constants.RemoteNames.XPUpdate,
	Constants.RemoteNames.CombatStateUpdate,
	Constants.RemoteNames.CombatHitFeedback,
	Constants.RemoteNames.VehicleStateUpdate,
	Constants.RemoteNames.TerritoryStateUpdate,
	Constants.RemoteNames.MissionStateUpdate,
	-- Client requests
	Constants.RemoteNames.RequestPurchaseUpgrade,
	Constants.RemoteNames.RequestClaimDailyReward,
	Constants.RemoteNames.RequestSpawnVehicle,
	Constants.RemoteNames.RequestPurchaseVehicle,
	Constants.RemoteNames.RequestDespawnVehicle,
	Constants.RemoteNames.RequestEquipWeapon,
	Constants.RemoteNames.RequestPurchaseWeapon,
	Constants.RemoteNames.RequestFire,
	Constants.RemoteNames.RequestReload,
	Constants.RemoteNames.RequestStartMission,
	Constants.RemoteNames.RequestClaimMission,
	Constants.RemoteNames.RequestCaptureTerritory,
	Constants.RemoteNames.RequestAdminCommand,
	Constants.RemoteNames.RequestPurchaseDevProduct,
	Constants.RemoteNames.RequestPurchaseGamePass,
	Constants.RemoteNames.RequestSkipTutorial,
	Constants.RemoteNames.TutorialStateUpdate,
	Constants.RemoteNames.RequestPrestige,
	Constants.RemoteNames.PrestigeStateUpdate,
	Constants.RemoteNames.RequestCreateClan,
	Constants.RemoteNames.RequestJoinClan,
	Constants.RemoteNames.RequestLeaveClan,
	Constants.RemoteNames.ClanStateUpdate,
	Constants.RemoteNames.RequestClaimBattlePassReward,
	Constants.RemoteNames.BattlePassStateUpdate,
	Constants.RemoteNames.RequestRecruitSoldiers,
	Constants.RemoteNames.RequestDismissSoldiers,
	Constants.RemoteNames.SoldierStateUpdate,
	Constants.RemoteNames.RequestSquadOrder,
	Constants.RemoteNames.SquadOrderStateUpdate,
	Constants.RemoteNames.SeasonStateUpdate,
	Constants.RemoteNames.RequestDeclareClanWar,
	Constants.RemoteNames.ClanWarStateUpdate,
	Constants.RemoteNames.RequestRedeemCode,
	Constants.RemoteNames.CodeStateUpdate,
	Constants.RemoteNames.NationColorUpdate,
	Constants.RemoteNames.RequestClaimSpinner,
	Constants.RemoteNames.SpinnerStateUpdate,
	Constants.RemoteNames.BankRaidStateUpdate,
	Constants.RemoteNames.StudioSmokeLog,
	Constants.RemoteNames.DeathShopOffer,
	Constants.RemoteNames.StarterBundleOffer,
	Constants.RemoteNames.AutoCollectOffer,
	Constants.RemoteNames.DoubleCashOffer,
	Constants.RemoteNames.VIPOffer,
	Constants.RemoteNames.AtmRaidStateUpdate,
	Constants.RemoteNames.PromptPremiumPad,
}

local FUNCTIONS = {
	Constants.RemoteNames.GetPlayerState,
}

local _initialized = false

function RemoteSetup.Init(): Folder
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Constants.RemotesFolderName
		folder.Parent = ReplicatedStorage
	end

	-- Always ensure every remote exists (idempotent; cheap if already present)
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
	end

	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
	end

	-- Guard: never create Give* remotes
	for _, child in ipairs(folder:GetChildren()) do
		if string.sub(child.Name, 1, 4) == "Give" then
			warn("[RemoteSetup] Removing forbidden remote:", child.Name)
			child:Destroy()
		end
	end

	if not _initialized then
		_initialized = true
		print(string.format("[RemoteSetup] Remotes ready: %d events + %d functions", #EVENTS, #FUNCTIONS))
	end

	return folder :: Folder
end


function RemoteSetup.Get(name: string): Instance
	local folder = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName)
	return folder:WaitForChild(name)
end

return RemoteSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Simple DataStore session lock to reduce multi-server write races.
	JobId + timestamp; steal if stale / malformed so rejoin after crash
	or place update is reliable within LOCK_TTL (never soft-lock forever).
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local SessionLock = {}

export type LockInfo = {
	JobId: string,
	UserId: number,
	Timestamp: number,
}

local STORE_NAME = Constants.SessionStoreName
-- Stale threshold: after force-quit / dead server, rejoin can take over.
-- Must stay ABOVE SessionLockRefreshSeconds (see DataService heartbeat).
local LOCK_TTL = Constants.SessionLockTtlSeconds
local store: DataStore? = nil

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		return store
	end
	warn("[SessionLock] DataStore unavailable:", result)
	return nil
end

local function thisJobId(): string
	return if RunService:IsStudio() then "STUDIO" else game.JobId
end

local function isLockHeldByOther(info: any, jobId: string, now: number): boolean
	if typeof(info) ~= "table" then
		return false
	end
	local heldJob = tostring((info :: LockInfo).JobId or "")
	if heldJob == "" or heldJob == jobId then
		return false -- missing jobId or ours → take / refresh
	end
	local age = now - (tonumber((info :: LockInfo).Timestamp) or 0)
	if age < 0 then
		age = 0
	end
	-- Stale lock → allow takeover (crash / BindToClose miss / place update)
	if age >= LOCK_TTL then
		return false
	end
	return true
end

function SessionLock.GetTtlSeconds(): number
	return LOCK_TTL
end

function SessionLock.TryAcquire(userId: number): (boolean, string?)
	local ds = getStore()
	if not ds then
		-- Studio without API services: allow
		return true, nil
	end

	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	local now = os.time()
	local aborted = false

	local ok, err = pcall(function()
		ds:UpdateAsync(key, function(old)
			if isLockHeldByOther(old, jobId, now) then
				aborted = true
				return nil -- abort acquire
			end
			return {
				JobId = jobId,
				UserId = userId,
				Timestamp = now,
			} :: LockInfo
		end)
	end)

	if not ok then
		return false, tostring(err)
	end

	if aborted then
		return false, "Session locked by another server"
	end

	-- Confirm we hold the lock (UpdateAsync nil-abort path + races)
	local readOk, current = pcall(function()
		return ds:GetAsync(key)
	end)
	if readOk and typeof(current) == "table" then
		local cur = current :: LockInfo
		local curJob = tostring(cur.JobId or "")
		if curJob ~= jobId then
			local age = now - (tonumber(cur.Timestamp) or 0)
			if age < LOCK_TTL and curJob ~= "" then
				return false, "Session locked by another server"
			end
			-- Stale or missing JobId after race: clear and claim
			local claimed = false
			local clearOk = pcall(function()
				ds:UpdateAsync(key, function(old)
					if isLockHeldByOther(old, jobId, os.time()) then
						return nil
					end
					claimed = true
					return {
						JobId = jobId,
						UserId = userId,
						Timestamp = os.time(),
					} :: LockInfo
				end)
			end)
			if not clearOk or not claimed then
				-- Re-check; another server may have won the race
				local verifyOk, verify = pcall(function()
					return ds:GetAsync(key)
				end)
				if verifyOk and typeof(verify) == "table" and tostring((verify :: LockInfo).JobId or "") ~= jobId then
					return false, "Session locked by another server"
				end
			end
		end
	end

	return true, nil
end

function SessionLock.Refresh(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and tostring((old :: LockInfo).JobId or "") == jobId then
				return {
					JobId = jobId,
					UserId = userId,
					Timestamp = os.time(),
				}
			end
			return old
		end)
	end)
end

function SessionLock.Release(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) ~= "table" then
				return nil
			end
			local held = tostring((old :: LockInfo).JobId or "")
			-- Release our lock; also clear empty/malformed so rejoin never soft-locks forever
			if held == "" or held == jobId then
				return nil
			end
			return old
		end)
	end)
end

--- BindToClose / emergency: clear lock for this user if we own it or it is stale.
function SessionLock.ForceReleaseIfStaleOrOurs(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = thisJobId()
	local now = os.time()
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) ~= "table" then
				return nil
			end
			local info = old :: LockInfo
			local held = tostring(info.JobId or "")
			local age = now - (tonumber(info.Timestamp) or 0)
			if held == "" or held == jobId or age >= LOCK_TTL then
				return nil
			end
			return old
		end)
	end)
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">StructureKitBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Part-kit builders for base structures (no MeshIds required).
	Used by BaseService to ENSURE visible kits exist on purchase / join rehydrate,
	even if MapSetup plinths are bare or kits were stripped.
]]

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local Constants = require(Shared.Constants)

local StructureKitBuilder = {}

local KIT_GEN = 24 -- v35: denser SpecialForcesFacility + Helipad/Dock presence

local PERIMETER_FOLDER = "WE_PerimeterWalls"
local CORNER_FOLDER = "WE_CornerTowers"
local CEILING_FOLDER = "WE_BaseCeiling"
local CEILING_UNLOCK_WALLS = 3 -- DefensiveWalls ≥ L3 unlocks anti-heli roof

local function makePart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = props.Name or "Part"
	if props.Size then
		p.Size = props.Size
	end
	if props.CFrame then
		p.CFrame = props.CFrame
	elseif props.Position then
		p.Position = props.Position
	end
	if props.Color then
		p.Color = props.Color
	end
	if props.Material then
		p.Material = props.Material
	end
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	else
		p.CanCollide = false
	end
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function kitPart(plinth: BasePart, role: string, size: Vector3, localOffset: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?)
	local p = makePart({
		Name = role,
		Size = size,
		CFrame = plinth.CFrame * CFrame.new(localOffset),
		Color = color,
		Material = material or Enum.Material.Metal,
		Transparency = 1, -- hidden until BaseService.applyKitVisuals (L0 ghost / L1+ solid)
		CanCollide = false,
		Parent = plinth,
		Shape = shape,
	})
	p:SetAttribute("WE_KitRole", role)
	p:SetAttribute("WE_BaseSize", size)
	p:SetAttribute("WE_LocalOffset", localOffset)
	p:SetAttribute("WE_Decor", true)
	return p
end

export type KitPalette = {
	Plinth: Color3,
	Body: Color3,
	Accent: Color3,
	Roof: Color3,
	Kit: string,
}

local function paletteFor(structureId: string): KitPalette
	local p = StructureVisualConfig.Palettes[structureId]
	if p then
		return p
	end
	return {
		Plinth = Color3.fromRGB(50, 55, 48),
		Body = Color3.fromRGB(70, 80, 65),
		Accent = Color3.fromRGB(200, 180, 80),
		Roof = Color3.fromRGB(45, 50, 42),
		Kit = "special",
	}
end

local function clearKitChildren(plinth: BasePart)
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") ~= nil then
			child:Destroy()
		end
	end
end

local function countKitRoles(plinth: BasePart): number
	local n = 0
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") ~= nil then
			n += 1
		end
	end
	return n
end

--[[ Build Part kit silhouette on plinth. Replaces any existing WE_KitRole children. ]]
function StructureKitBuilder.BuildKitOnPlinth(plinth: BasePart, structureId: string)
	local pal = paletteFor(structureId)
	local kit = pal.Kit
	clearKitChildren(plinth)

	if kit == "hq" then
		-- v34: compound-scale HQ (~TargetFootprint 36×16×28), not a player-sized cube
		kitPart(plinth, "Body", Vector3.new(28, 14, 22), Vector3.new(0, 7.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(12, 10, 10), Vector3.new(-18, 5.5, 4), pal.Body, Enum.Material.Metal, nil) -- west wing
		kitPart(plinth, "Detail", Vector3.new(10, 8, 10), Vector3.new(16, 4.5, -2), pal.Roof, Enum.Material.Metal, nil) -- east annex
		kitPart(plinth, "Roof", Vector3.new(30, 1.4, 24), Vector3.new(0, 15, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.45, 8, 0.45), Vector3.new(2.2, 19.5, 2.2), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 6, 0.35), Vector3.new(-18, 12, 4), pal.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(28, 0.28, 22), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.4, 1.4, 1.4), Vector3.new(-4, 10, -8), pal.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Door", Vector3.new(3.2, 4.5, 0.4), Vector3.new(0, 3.0, -11.2), Color3.fromRGB(30, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(6, 8, -11.1), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(-6, 8, -11.1), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(4, 1.2, 2), Vector3.new(0, 1.2, -14), Color3.fromRGB(55, 58, 50), Enum.Material.Concrete, nil) -- entry steps
		-- Tier 2 HQ interior / roof dress hosts (catalog via TryDressStructureInterior)
		do
			local hosts = {
				{ "WE_DressHost_Radio", Vector3.new(0.6, 2.2, 0.6), Vector3.new(-1.8, 5.2, 1.6), "RadioAntenna" },
				{ "WE_DressHost_RadioRoof", Vector3.new(0.5, 1.8, 0.5), Vector3.new(1.6, 5.4, -1.4), "RadioAntennaAlt" },
				{ "WE_DressHost_Ammo", Vector3.new(1.4, 1.0, 1.0), Vector3.new(-1.6, 1.4, 1.8), "AmmoBox" },
				{ "WE_DressHost_Crate", Vector3.new(1.6, 1.2, 1.6), Vector3.new(1.8, 1.5, 1.6), "Crate" },
				{ "WE_DressHost_MilCrate", Vector3.new(1.5, 1.1, 1.3), Vector3.new(1.8, 1.45, -1.5), "MilitaryCrate" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(-2.0, 2.8, -1.8), "Lantern" },
				{ "WE_DressHost_Flood", Vector3.new(0.7, 1.4, 0.7), Vector3.new(-2.6, 4.2, -2.6), "Floodlight" },
				{ "WE_DressHost_Fuel", Vector3.new(1.2, 1.0, 1.2), Vector3.new(-2.2, 1.4, -0.2), "FuelCans" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
			-- Gunmetal command desk fallback (no free desk Model — Part kit + SurfaceGui map)
			local desk = kitPart(plinth, "DressHost", Vector3.new(3.2, 1.1, 1.6), Vector3.new(0, 1.35, 0.4), Color3.fromRGB(55, 60, 58), Enum.Material.Metal, nil)
			if desk then
				desk.Name = "WE_CommandDesk"
				desk:SetAttribute("WE_GunmetalDesk", true)
				desk.CanCollide = false
				local top = kitPart(plinth, "DressHost", Vector3.new(3.4, 0.12, 1.8), Vector3.new(0, 1.95, 0.4), Color3.fromRGB(45, 50, 48), Enum.Material.Metal, nil)
				if top then
					top.Name = "WE_CommandDeskTop"
					top.CanCollide = false
					local sg = Instance.new("SurfaceGui")
					sg.Name = "WE_MapSurface"
					sg.Face = Enum.NormalId.Top
					sg.CanvasSize = Vector2.new(256, 128)
					sg.Parent = top
					local mapFrame = Instance.new("Frame")
					mapFrame.Name = "MapPanel"
					mapFrame.Size = UDim2.fromScale(1, 1)
					mapFrame.BackgroundColor3 = Color3.fromRGB(40, 55, 42)
					mapFrame.BorderSizePixel = 0
					mapFrame.Parent = sg
					local grid = Instance.new("TextLabel")
					grid.Size = UDim2.fromScale(1, 1)
					grid.BackgroundTransparency = 1
					grid.Text = "▌ TERRITORY MAP ▌\nN ◆ ◆ ◆\n◆ HQ ◆ ◆\n◆ ◆ ◆ S"
					grid.TextColor3 = Color3.fromRGB(120, 200, 90)
					grid.TextScaled = true
					grid.Font = Enum.Font.Code
					grid.Parent = mapFrame
				end
			end
		end
	elseif kit == "barracks" then
		-- v34: long troop housing silhouette (~28×12×16) + bunk windows + yard
		kitPart(plinth, "Body", Vector3.new(30, 12, 16), Vector3.new(0, 6.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(32, 1.2, 18), Vector3.new(0, 13, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(30, 0.25, 16), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(2.4, 3.6, 0.35), Vector3.new(0, 2.4, -8.2), Color3.fromRGB(35, 40, 32), Enum.Material.Metal, nil)
		for wi, wx in ipairs({ -10, -5, 5, 10 }) do
			kitPart(plinth, "Window", Vector3.new(2.0, 1.2, 0.22), Vector3.new(wx, 7.5, -8.1), Color3.fromRGB(70, 120, 140), Enum.Material.Glass, nil)
		end
		kitPart(plinth, "Detail", Vector3.new(0.9, 4.5, 0.9), Vector3.new(-14, 4, 4), pal.Accent, Enum.Material.Neon, nil) -- flag pole
		kitPart(plinth, "Detail", Vector3.new(2.4, 1.4, 0.2), Vector3.new(-14, 7.2, 4), Color3.fromRGB(40, 90, 50), Enum.Material.Fabric, nil) -- flag
		kitPart(plinth, "Detail", Vector3.new(14, 1.0, 3.5), Vector3.new(0, 1.1, 10), Color3.fromRGB(90, 85, 60), Enum.Material.Sand, nil) -- sandbag berm
		-- Tier 2 Barracks interior dress hosts
		do
			local hosts = {
				{ "WE_DressHost_Crate", Vector3.new(1.5, 1.1, 1.5), Vector3.new(2.4, 1.4, 1.4), "Crate" },
				{ "WE_DressHost_MilCrate", Vector3.new(1.4, 1.0, 1.2), Vector3.new(-2.4, 1.35, 1.4), "MilitaryCrate" },
				{ "WE_DressHost_Ammo", Vector3.new(1.2, 0.9, 0.9), Vector3.new(2.2, 1.3, -1.5), "AmmoBox" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(-2.6, 2.4, -1.2), "Lantern" },
				{ "WE_DressHost_Sandbag", Vector3.new(2.4, 1.0, 1.2), Vector3.new(0, 1.2, 1.8), "Sandbag" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	elseif kit == "depot" then
		kitPart(plinth, "Body", Vector3.new(32, 12, 22), Vector3.new(0, 6.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.3, 0.4, 6.1), Vector3.new(0, 2.95, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(3.2, 0.28, 5.9), Vector3.new(0, 0.72, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(2.8, 2.0, 0.3), Vector3.new(0, 1.6, -2.9), Color3.fromRGB(40, 50, 60), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.8, 2.4, 2.0), pal.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		-- Showroom podium: PlateDark cylinder + GoldBright ring + rarity billboard host
		local podium = kitPart(plinth, "Podium", Vector3.new(3.6, 0.55, 3.6), Vector3.new(0, 0.95, 4.2), Constants.Colors.PlateDark, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		-- Cylinder default axis X — stand upright
		if podium then
			local off = podium:GetAttribute("WE_LocalOffset")
			if typeof(off) == "Vector3" then
				podium.CFrame = plinth.CFrame * CFrame.new(off :: Vector3) * CFrame.Angles(0, 0, math.rad(90))
			end
		end
		local ring = kitPart(plinth, "PodiumRing", Vector3.new(4.2, 0.18, 4.2), Vector3.new(0, 1.15, 4.2), Constants.Colors.GoldBright, Enum.Material.Neon, Enum.PartType.Cylinder)
		if ring then
			local off = ring:GetAttribute("WE_LocalOffset")
			if typeof(off) == "Vector3" then
				ring.CFrame = plinth.CFrame * CFrame.new(off :: Vector3) * CFrame.Angles(0, 0, math.rad(90))
			end
		end
		local display = kitPart(plinth, "ShowroomMesh", Vector3.new(2.4, 1.1, 4.0), Vector3.new(0, 1.85, 4.2), Color3.fromRGB(70, 88, 62), Enum.Material.Metal, nil)
		if display then
			display:SetAttribute("WE_ShowroomSpin", true)
			local bb = Instance.new("BillboardGui")
			bb.Name = "WE_RarityBillboard"
			bb.Size = UDim2.fromOffset(140, 28)
			bb.StudsOffset = Vector3.new(0, 2.4, 0)
			bb.AlwaysOnTop = true
			bb.MaxDistance = 80
			bb.Parent = display
			local lab = Instance.new("TextLabel")
			lab.Size = UDim2.fromScale(1, 1)
			lab.BackgroundColor3 = Constants.Colors.PlateDark
			lab.BackgroundTransparency = 0.15
			lab.BorderSizePixel = 0
			lab.Font = Enum.Font.GothamBold
			lab.TextScaled = true
			lab.TextColor3 = Constants.Colors.GoldBright
			lab.Text = "COMMON · JEEP"
			lab.Parent = bb
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 4)
			corner.Parent = lab
		end
	
		-- Tier 2: extra pedestal hosts + flag (densify showroom)
		for pi, ox in ipairs({ -4.2, 4.2 }) do
			local ped = kitPart(plinth, "Podium", Vector3.new(2.4, 0.4, 2.4), Vector3.new(ox, 0.9, 4.0), Color3.fromRGB(40, 48, 55), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
			if ped then
				ped.Name = "ShowroomPedestalHost" .. (pi + 1)
				local off = ped:GetAttribute("WE_LocalOffset")
				if typeof(off) == "Vector3" then
					ped.CFrame = plinth.CFrame * CFrame.new(off :: Vector3) * CFrame.Angles(0, 0, math.rad(90))
				end
				ped.Transparency = 0.55
			end
		end
		local flagHost = kitPart(plinth, "DressHost", Vector3.new(0.4, 4.5, 0.4), Vector3.new(-3.6, 3.2, -2.8), Color3.fromRGB(180, 180, 180), Enum.Material.Metal, nil)
		if flagHost then
			flagHost.Name = "ShowroomFlagHost"
			flagHost:SetAttribute("WE_DressProp", "FlagPole")
			flagHost.Transparency = 0.7
			flagHost.CanCollide = false
		end
		local floodHost = kitPart(plinth, "DressHost", Vector3.new(0.6, 1.2, 0.6), Vector3.new(3.4, 3.4, -2.6), Color3.fromRGB(200, 200, 180), Enum.Material.Metal, nil)
		if floodHost then
			floodHost.Name = "WE_DressHost_DepotFlood"
			floodHost:SetAttribute("WE_DressProp", "FloodlightAlt")
			floodHost.Transparency = 0.7
		end
		-- Second bay floodlight
		local floodHost2 = kitPart(plinth, "DressHost", Vector3.new(0.6, 1.2, 0.6), Vector3.new(-3.4, 3.4, -2.6), Color3.fromRGB(200, 200, 180), Enum.Material.Metal, nil)
		if floodHost2 then
			floodHost2.Name = "WE_DressHost_DepotFlood2"
			floodHost2:SetAttribute("WE_DressProp", "Floodlight")
			floodHost2.Transparency = 0.7
		end
		local fuelHost = kitPart(plinth, "DressHost", Vector3.new(1.3, 1.0, 1.3), Vector3.new(3.2, 1.3, 2.4), Color3.fromRGB(70, 65, 45), Enum.Material.Metal, nil)
		if fuelHost then
			fuelHost.Name = "WE_DressHost_DepotFuel"
			fuelHost:SetAttribute("WE_DressProp", "FuelCans")
			fuelHost.Transparency = 0.75
			fuelHost.CanCollide = false
		end
	elseif kit == "lab" then
		kitPart(plinth, "Body", Vector3.new(20, 10, 14), Vector3.new(0, 5.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(5.5, 0.5, 5.5), Vector3.new(0, 4.0, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 3.8, 0.4), Vector3.new(0, 6.1, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(5.7, 0.2, 5.7), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Window", Vector3.new(1.5, 1.2, 0.2), Vector3.new(0, 2.6, -2.6), Color3.fromRGB(80, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.9, 0.9, 0.9), Vector3.new(2.0, 3.5, 2.0), pal.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "tower" then
		-- v33: ≥28–32 stud sniper tower (walkable ladder + platform), not a stub
		kitPart(plinth, "Body", Vector3.new(10, 28, 10), Vector3.new(0, 14.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(14, 0.6, 14), Vector3.new(0, 29.2, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(16, 0.45, 16), Vector3.new(0, 27.8, 0), pal.Roof, Enum.Material.Metal, nil) -- lookout deck
		kitPart(plinth, "Antenna", Vector3.new(0.4, 5.5, 0.4), Vector3.new(0, 32.5, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(10.4, 0.25, 10.4), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Window", Vector3.new(2.2, 1.4, 0.25), Vector3.new(0, 24, -5.1), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.2, 1.4, 0.25), Vector3.new(0, 18, -5.1), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Door", Vector3.new(2.4, 3.6, 0.35), Vector3.new(0, 2.4, -5.15), Color3.fromRGB(40, 42, 36), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.55, 26, 0.55), Vector3.new(5.2, 13.5, 5.2), Color3.fromRGB(55, 58, 48), Enum.Material.Metal, nil) -- ladder rail
	elseif kit == "dock" then
		-- v35: naval pier + bollards + crane silhouette + warehouse shed (readable Naval Dock)
		kitPart(plinth, "Body", Vector3.new(24, 1.4, 16), Vector3.new(0, 1.2, 0), pal.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Pier", Vector3.new(44, 0.9, 10), Vector3.new(0, 1.5, 20), pal.Roof, Enum.Material.Wood, nil)
		kitPart(plinth, "Accent", Vector3.new(20, 0.16, 0.5), Vector3.new(0, 1.35, 0), pal.Accent, Enum.Material.Neon, nil)
		-- Bollards along pier
		for bi, bx in ipairs({ -16, -8, 0, 8, 16 }) do
			kitPart(plinth, "Detail", Vector3.new(1.1, 1.6, 1.1), Vector3.new(bx, 2.4, 24), Color3.fromRGB(50, 55, 60), Enum.Material.Metal, nil)
		end
		-- Crane mast + boom
		kitPart(plinth, "Antenna", Vector3.new(1.2, 16, 1.2), Vector3.new(-10, 9, 8), Color3.fromRGB(200, 140, 50), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(18, 0.6, 0.6), Vector3.new(-1, 16.5, 8), Color3.fromRGB(210, 150, 55), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.4, 4, 0.4), Vector3.new(7, 14, 8), Color3.fromRGB(80, 80, 75), Enum.Material.Metal, nil) -- cable
		-- Shore warehouse shed
		kitPart(plinth, "Roof", Vector3.new(14, 8, 10), Vector3.new(10, 5, -2), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(6, 6, 0.4), Vector3.new(10, 3.5, 3.2), Color3.fromRGB(40, 55, 70), Enum.Material.Metal, nil)
		-- Tire fenders
		for _, fx in ipairs({ -12, 0, 12 }) do
			kitPart(plinth, "Detail", Vector3.new(1.8, 1.8, 0.6), Vector3.new(fx, 1.8, 25.2), Color3.fromRGB(35, 35, 35), Enum.Material.Rubber, Enum.PartType.Cylinder)
		end
		-- Shipping crate dress hosts
		do
			local hosts = {
				{ "WE_DressHost_Crate", Vector3.new(1.8, 1.4, 1.8), Vector3.new(6, 1.8, 12), "MilitaryCrate" },
				{ "WE_DressHost_Fuel", Vector3.new(1.2, 1.0, 1.2), Vector3.new(-6, 1.6, 10), "FuelCans" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	elseif kit == "pad" then
		kitPart(plinth, "Body", Vector3.new(7.3, 0.45, 7.3), Vector3.new(0, 0.92, 0), pal.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.14, 0.5), Vector3.new(0, 1.18, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(0.5, 0.14, 6.6), Vector3.new(0, 1.18, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Roof", Vector3.new(1.6, 0.3, 1.6), Vector3.new(0, 1.35, 0), pal.Roof, Enum.Material.Metal, nil)
	elseif kit == "helipad" then
		-- v35: ~28 stud marked pad + circle ring + H + 4 floodlights + windsock (readable air ops)
		kitPart(plinth, "Body", Vector3.new(28, 0.65, 28), Vector3.new(0, 0.95, 0), pal.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(22, 0.12, 1.4), Vector3.new(0, 1.32, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.4, 0.12, 18), Vector3.new(0, 1.32, 0), pal.Accent, Enum.Material.Neon, nil)
		-- Circle ring (4 arcs as flat bars)
		for _, angOff in ipairs({ 0, 45, 90, 135 }) do
			local rad = math.rad(angOff)
			local ox = math.cos(rad) * 10
			local oz = math.sin(rad) * 10
			kitPart(plinth, "Detail", Vector3.new(8, 0.1, 0.7), Vector3.new(ox, 1.28, oz), Color3.fromRGB(245, 245, 200), Enum.Material.Neon, nil)
		end
		kitPart(plinth, "Roof", Vector3.new(4.2, 0.22, 0.7), Vector3.new(0, 1.38, 0), Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic, nil) -- H bar
		kitPart(plinth, "Detail", Vector3.new(0.7, 0.22, 4.2), Vector3.new(0, 1.38, 0), Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic, nil)
		-- Four corner floodlights
		for _, corner in ipairs({ Vector3.new(-11, 3.2, -11), Vector3.new(11, 3.2, -11), Vector3.new(-11, 3.2, 11), Vector3.new(11, 3.2, 11) }) do
			kitPart(plinth, "Antenna", Vector3.new(0.35, 5.0, 0.35), corner, pal.Accent, Enum.Material.Metal, nil)
			kitPart(plinth, "Window", Vector3.new(0.9, 0.9, 0.9), corner + Vector3.new(0, 2.6, 0), Color3.fromRGB(255, 245, 200), Enum.Material.Neon, Enum.PartType.Ball)
		end
		-- Windsock pole
		kitPart(plinth, "Antenna", Vector3.new(0.3, 6, 0.3), Vector3.new(12, 3.5, 0), Color3.fromRGB(70, 72, 68), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(2.4, 0.9, 0.15), Vector3.new(13.2, 6.2, 0), Color3.fromRGB(220, 80, 50), Enum.Material.Fabric, nil)
		-- Ops hut
		kitPart(plinth, "Detail", Vector3.new(6, 3.5, 4), Vector3.new(-14, 2.2, 10), Color3.fromRGB(55, 60, 55), Enum.Material.Metal, nil)
	elseif kit == "airfield" then
		-- v33: readable runway + taxi + large hangar volume (mesh composite dresses on top)
		kitPart(plinth, "Body", Vector3.new(72, 0.85, 14), Vector3.new(0, 0.95, 20), Color3.fromRGB(42, 44, 46), Enum.Material.Asphalt, nil)
		kitPart(plinth, "Accent", Vector3.new(64, 0.14, 0.55), Vector3.new(0, 1.42, 20), Color3.fromRGB(245, 245, 210), Enum.Material.Neon, nil)
		-- runway edge lights / chevron dashes
		for i = -3, 3 do
			kitPart(plinth, "Detail", Vector3.new(3.2, 0.12, 0.7), Vector3.new(i * 9, 1.4, 20), Color3.fromRGB(255, 255, 230), Enum.Material.Neon, nil)
		end
		kitPart(plinth, "Detail", Vector3.new(28, 0.6, 18), Vector3.new(0, 0.95, -6), Color3.fromRGB(55, 58, 55), Enum.Material.Concrete, nil) -- taxi
		kitPart(plinth, "Roof", Vector3.new(40, 18, 28), Vector3.new(0, 10, -24), pal.Roof, Enum.Material.Metal, nil) -- hangar shed
		kitPart(plinth, "Door", Vector3.new(0.55, 14, 22), Vector3.new(0, 8, -10), Color3.fromRGB(28, 30, 26), Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.45, 10, 0.45), Vector3.new(24, 6, 20), pal.Accent, Enum.Material.Metal, nil) -- windsock pole
		kitPart(plinth, "Window", Vector3.new(1.4, 1.4, 1.4), Vector3.new(24, 11, 20), Color3.fromRGB(255, 180, 60), Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Detail", Vector3.new(8, 1.2, 4), Vector3.new(-28, 1.4, 12), Color3.fromRGB(70, 72, 60), Enum.Material.Metal, nil) -- ops hut
	elseif kit == "hangar" then
		kitPart(plinth, "Body", Vector3.new(40, 18, 28), Vector3.new(0, 9.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(42, 1.2, 30), Vector3.new(0, 19, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(0.5, 14, 22), Vector3.new(0, 8, 14.2), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(40, 0.3, 28), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.Neon, nil)
	elseif kit == "armory" then
		-- v34: 3-story weapons inventory / armory (~28×18×18) + racks + ammo yard
		kitPart(plinth, "Body", Vector3.new(28, 18, 18), Vector3.new(0, 9.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(30, 1.3, 20), Vector3.new(0, 19, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(4.0, 5.5, 0.45), Vector3.new(0, 3.6, -9.2), Color3.fromRGB(40, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(28, 0.3, 18), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.Neon, nil)
		-- Floor rings read as stories
		kitPart(plinth, "Detail", Vector3.new(28.4, 0.25, 18.4), Vector3.new(0, 6.5, 0), Color3.fromRGB(55, 50, 42), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(28.4, 0.25, 18.4), Vector3.new(0, 12.5, 0), Color3.fromRGB(55, 50, 42), Enum.Material.Metal, nil)
		-- Ammo crates + gun-rack silhouette
		kitPart(plinth, "Detail", Vector3.new(2.4, 1.6, 1.8), Vector3.new(-10, 1.3, -11.5), Color3.fromRGB(70, 65, 50), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(2.2, 1.4, 1.6), Vector3.new(-7.2, 1.2, -11.5), Color3.fromRGB(75, 68, 52), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(2.0, 1.2, 1.4), Vector3.new(-4.5, 1.1, -11.5), Color3.fromRGB(65, 60, 48), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.35, 3.2, 6), Vector3.new(10, 2.2, -8), Color3.fromRGB(45, 48, 42), Enum.Material.Metal, nil) -- rack
		for ri = 0, 3 do
			kitPart(plinth, "Detail", Vector3.new(0.18, 0.18, 2.6), Vector3.new(9.4, 1.4 + ri * 0.7, -8), Color3.fromRGB(30, 32, 34), Enum.Material.Metal, nil)
		end
		kitPart(plinth, "Window", Vector3.new(2.6, 1.8, 0.25), Vector3.new(6, 10, -9.1), Color3.fromRGB(80, 120, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.6, 1.8, 0.25), Vector3.new(-6, 10, -9.1), Color3.fromRGB(80, 120, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 5, 0.4), Vector3.new(12, 21.5, 6), pal.Accent, Enum.Material.Neon, nil)
		-- Dress hosts for catalog props
		do
			local hosts = {
				{ "WE_DressHost_Ammo", Vector3.new(1.4, 1.0, 1.0), Vector3.new(-10, 1.4, 6), "AmmoBox" },
				{ "WE_DressHost_Crate", Vector3.new(1.6, 1.2, 1.6), Vector3.new(-6, 1.5, 7), "MilitaryCrate" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(10, 3.0, 6), "Lantern" },
				{ "WE_DressHost_Sandbag", Vector3.new(3.0, 1.0, 1.2), Vector3.new(0, 1.2, 10), "Sandbag" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	elseif kit == "radar" then
		-- Dish / tower silhouette ≥20 studs (not a neon stick)
		kitPart(plinth, "Body", Vector3.new(6, 14, 6), Vector3.new(0, 7.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(10, 1, 10), Vector3.new(0, 15, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.6, 8, 0.6), Vector3.new(0, 19, 0), pal.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(12, 1.2, 12), Vector3.new(0, 22, 0), pal.Accent, Enum.Material.Metal, Enum.PartType.Cylinder) -- dish
		kitPart(plinth, "Window", Vector3.new(3, 3, 3), Vector3.new(0, 22, 0), Color3.fromRGB(100, 200, 255), Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Accent", Vector3.new(7, 0.25, 7), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.Neon, nil)
	elseif kit == "wall" then
		-- Pad-local wall segment (perimeter walls are separate)
		kitPart(plinth, "Body", Vector3.new(24, 8, 3), Vector3.new(0, 4.5, 0), pal.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(24.4, 0.35, 3.4), Vector3.new(0, 8.7, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Roof", Vector3.new(24, 0.5, 3.6), Vector3.new(0, 9.1, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.4, 2.2, 1.4), Vector3.new(-10, 7, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.4, 2.2, 1.4), Vector3.new(10, 7, 0), pal.Accent, Enum.Material.Neon, nil)
	elseif kit == "power" then
		kitPart(plinth, "Body", Vector3.new(24, 14, 18), Vector3.new(0, 7.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(4, 4, 4), Vector3.new(0, 16, 0), pal.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Roof", Vector3.new(26, 0.8, 20), Vector3.new(0, 15, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 6, 1.2), Vector3.new(8, 5, 6), Color3.fromRGB(60, 55, 40), Enum.Material.Metal, nil)
	elseif kit == "warehouse" then
		-- v33: large logistics bay volume + loading dock + crates (walkable footprint feel)
		kitPart(plinth, "Body", Vector3.new(38, 16, 24), Vector3.new(0, 8.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(40, 1.2, 26), Vector3.new(0, 17, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(38, 0.3, 24), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(12, 12, 0.45), Vector3.new(0, 6.5, -12.2), Color3.fromRGB(50, 45, 38), Enum.Material.Metal, nil) -- roll door
		kitPart(plinth, "Detail", Vector3.new(16, 1.4, 8), Vector3.new(0, 1.3, -16), Color3.fromRGB(70, 72, 68), Enum.Material.Concrete, nil) -- loading dock
		kitPart(plinth, "Detail", Vector3.new(3.2, 2.4, 2.4), Vector3.new(-14, 1.8, -14), Color3.fromRGB(120, 95, 55), Enum.Material.Wood, nil)
		kitPart(plinth, "Detail", Vector3.new(3.0, 2.2, 2.2), Vector3.new(-10.5, 1.7, -14), Color3.fromRGB(110, 90, 50), Enum.Material.Wood, nil)
		kitPart(plinth, "Window", Vector3.new(3.5, 1.8, 0.25), Vector3.new(10, 10, -12.1), Color3.fromRGB(80, 120, 140), Enum.Material.Glass, nil)
	elseif kit == "special" then
		-- v35: Special Forces compound (~28×16×18) — dark ops hall + range + watch post
		kitPart(plinth, "Body", Vector3.new(28, 14, 16), Vector3.new(0, 7.5, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(30, 1.2, 18), Vector3.new(0, 15, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(28, 0.28, 16), Vector3.new(0, 0.75, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(3.6, 5.0, 0.4), Vector3.new(0, 3.2, -8.2), Color3.fromRGB(25, 28, 32), Enum.Material.Metal, nil)
		-- Side annex (armory wing)
		kitPart(plinth, "Detail", Vector3.new(12, 10, 10), Vector3.new(-18, 5.5, 2), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(10, 8, 8), Vector3.new(16, 4.5, -2), Color3.fromRGB(40, 48, 55), Enum.Material.Metal, nil)
		-- Watch post / tower stub
		kitPart(plinth, "Antenna", Vector3.new(4, 18, 4), Vector3.new(12, 10, 10), Color3.fromRGB(38, 42, 48), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(2.2, 1.4, 0.25), Vector3.new(12, 16, 7.9), Color3.fromRGB(100, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 6, 0.35), Vector3.new(12, 22, 10), pal.Accent, Enum.Material.Neon, nil)
		-- Training range silhouette (targets + berm)
		kitPart(plinth, "Detail", Vector3.new(16, 1.2, 3), Vector3.new(0, 1.2, 12), Color3.fromRGB(90, 85, 60), Enum.Material.Sand, nil)
		for _, tx in ipairs({ -6, 0, 6 }) do
			kitPart(plinth, "Detail", Vector3.new(0.8, 2.4, 0.3), Vector3.new(tx, 2.4, 13.5), Color3.fromRGB(180, 60, 50), Enum.Material.Metal, nil)
		end
		-- Windows + flag
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(-6, 8, -8.1), Color3.fromRGB(70, 100, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Window", Vector3.new(2.4, 1.6, 0.25), Vector3.new(6, 8, -8.1), Color3.fromRGB(70, 100, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 5, 0.8), Vector3.new(-12, 4, 8), pal.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(2.2, 1.3, 0.2), Vector3.new(-12, 7.2, 8), Color3.fromRGB(120, 50, 160), Enum.Material.Fabric, nil)
		-- Dress hosts
		do
			local hosts = {
				{ "WE_DressHost_Ammo", Vector3.new(1.4, 1.0, 1.0), Vector3.new(-10, 1.4, 6), "AmmoBox" },
				{ "WE_DressHost_Crate", Vector3.new(1.6, 1.2, 1.6), Vector3.new(-6, 1.5, 7), "MilitaryCrate" },
				{ "WE_DressHost_Sandbag", Vector3.new(3.0, 1.0, 1.2), Vector3.new(4, 1.2, 10), "Sandbag" },
				{ "WE_DressHost_Lantern", Vector3.new(0.5, 1.0, 0.5), Vector3.new(10, 3.0, 4), "Lantern" },
				{ "WE_DressHost_Flood", Vector3.new(0.7, 1.4, 0.7), Vector3.new(-14, 5.0, -6), "Floodlight" },
			}
			for _, h in ipairs(hosts) do
				local hp = kitPart(plinth, "DressHost", h[2], h[3], Color3.fromRGB(60, 65, 55), Enum.Material.Metal, nil)
				if hp then
					hp.Name = h[1]
					hp:SetAttribute("WE_DressProp", h[4])
					hp.Transparency = 0.85
					hp.CanCollide = false
				end
			end
		end
	else
		kitPart(plinth, "Body", Vector3.new(5.3, 3.5, 5.3), Vector3.new(0, 2.4, 0), pal.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(4.2, 1.2, 4.2), Vector3.new(0, 4.6, 0), pal.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.2, 0.35), Vector3.new(0, 7.2, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(5.9, 0.22, 5.9), Vector3.new(0, 0.7, 0), pal.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.0, 3.5, -2.0), pal.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	end
	plinth:SetAttribute("WE_KitGen", KIT_GEN)
end

--[[ Ensure plinth has kit children; rebuild if missing/incomplete. Returns role count. ]]
function StructureKitBuilder.EnsureKit(plinth: BasePart, structureId: string): number
	local n = countKitRoles(plinth)
	local gen = tonumber(plinth:GetAttribute("WE_KitGen")) or 0
	local needsRebuild = gen < KIT_GEN

	-- Footprint too small (legacy pad-sized cubes) → rebuild
	if not needsRebuild then
		for _, child in ipairs(plinth:GetChildren()) do
			if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") == "Body" then
				local s = child.Size
				if math.max(s.X, s.Y, s.Z) < 12 then
					needsRebuild = true
				end
				break
			end
		end
	end

	-- Tier 2: rebuild HQ/Barracks/Depot if dress / showroom densify hosts missing
	local needsDress = false
	if structureId == "CommandCenter" or structureId == "Barracks" or structureId == "VehicleDepot" or structureId == "PowerStation" or structureId == "WeaponsFacility" or structureId == "SpecialForcesFacility" or structureId == "Helipad" or structureId == "Dock" then
		local hasDress = false
		for _, child in ipairs(plinth:GetChildren()) do
			if child:IsA("BasePart") then
				local nm = child.Name
				if string.sub(nm, 1, 12) == "WE_DressHost" or nm == "WE_CommandDesk" or nm == "ShowroomPedestalHost2" or nm == "ShowroomFlagHost" then
					hasDress = true
					break
				end
			end
		end
		needsDress = not hasDress
	end
	if n < 2 or needsDress or needsRebuild then
		-- Clear stale catalog dress so ScaleTo re-applies
		plinth:SetAttribute("WE_CatalogAssetId", nil)
		plinth:SetAttribute("WE_BuildingDressGen", nil)
		for _, ch in ipairs(plinth:GetChildren()) do
			if ch:IsA("Model") and (ch.Name == "WE_CatalogBuilding" or ch.Name == "WE_AirfieldComposite") then
				ch:Destroy()
			end
		end
		StructureKitBuilder.BuildKitOnPlinth(plinth, structureId)
		plinth:SetAttribute("WE_KitGen", KIT_GEN)
		n = countKitRoles(plinth)
	end
	return n
end

local function findPlotPad(plotId: number): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			return inst
		end
	end
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	if plotFolder then
		local pad = plotFolder:FindFirstChild("PlotPad")
		if pad and pad:IsA("BasePart") then
			return pad
		end
	end
	return nil
end

function StructureKitBuilder.FindPlotFolder(plotId: number): Folder?
	local pad = findPlotPad(plotId)
	if pad and pad.Parent and pad.Parent:IsA("Folder") then
		return pad.Parent
	end
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
	if plotFolder and plotFolder:IsA("Folder") then
		return plotFolder
	end
	return nil
end

--[[ Perimeter fortification around PlotPad.
	level 0 clears; 1+ builds a collide wall ring with a walkable gate facing PlayerSpawn.
	BUGFIX: prior WallS used span*2 which overlapped and sealed the gate on 200-stud pads.
]]
function StructureKitBuilder.SyncPerimeterWalls(plotId: number, level: number)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local pad = findPlotPad(plotId)
	if not plotFolder or not pad then
		return
	end

	local existing = plotFolder:FindFirstChild(PERIMETER_FOLDER)
	if level <= 0 then
		if existing then
			existing:Destroy()
		end
		return
	end

	local folder: Folder
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = PERIMETER_FOLDER
		folder.Parent = plotFolder
	end

	local pal = paletteFor("DefensiveWalls")
	local lv = math.clamp(level, 1, 5)
	local halfX = pad.Size.X * 0.5 - 1.5
	local halfZ = pad.Size.Z * 0.5 - 1.5
	local thickness = 2.2 + lv * 0.45
	local height = 6.5 + lv * 2.2
	local y = pad.Position.Y + pad.Size.Y * 0.5 + height * 0.5
	local cx, cz = pad.Position.X, pad.Position.Z

	-- Clear walkable opening (8–12 studs). Posts/arch are visual-only outside this span.
	local GATE_CLEAR = 10
	local gateHalf = GATE_CLEAR * 0.5

	-- Gate faces PlayerSpawn (plot-local). Fallback: PlotForward attr, else pad LookVector / +Z.
	local gateAxis = "Z" -- gate on ±Z face; "X" = gate on ±X face
	local gateSign = 1
	local spawnPart = plotFolder:FindFirstChild("PlayerSpawn")
	local dx, dz = 0.0, 1.0
	if spawnPart and spawnPart:IsA("BasePart") then
		dx = spawnPart.Position.X - cx
		dz = spawnPart.Position.Z - cz
	else
		local attrFwd = plotFolder:GetAttribute("PlotForward")
		if typeof(attrFwd) == "Vector3" then
			dx = (attrFwd :: Vector3).X
			dz = (attrFwd :: Vector3).Z
		else
			local look = pad.CFrame.LookVector
			dx, dz = look.X, look.Z
			if math.abs(dx) < 0.05 and math.abs(dz) < 0.05 then
				dx, dz = 0, 1
			end
		end
	end
	if math.abs(dx) >= math.abs(dz) then
		gateAxis = "X"
		gateSign = if dx >= 0 then 1 else -1
	else
		gateAxis = "Z"
		gateSign = if dz >= 0 then 1 else -1
	end
	folder:SetAttribute("WE_GateAxis", gateAxis)
	folder:SetAttribute("WE_GateSign", gateSign)
	folder:SetAttribute("WE_GateClear", GATE_CLEAR)

	local function wall(name: string, size: Vector3, pos: Vector3)
		local w = makePart({
			Name = name,
			Size = size,
			Position = pos,
			Color = pal.Body,
			Material = Enum.Material.Concrete,
			Transparency = 0,
			CanCollide = true,
			Parent = folder,
		})
		w.CanTouch = false
		w.CanQuery = true
		w.CastShadow = true
		w:SetAttribute("WE_Perimeter", true)
		w:SetAttribute("PlotId", plotId)
		w:SetAttribute("WE_WallLevel", lv)
		local capH = 0.45 + lv * 0.08
		local cap = makePart({
			Name = name .. "_Cap",
			Size = Vector3.new(size.X + 0.4, capH, size.Z + 0.4),
			Position = Vector3.new(pos.X, pos.Y + height * 0.5 + capH * 0.5, pos.Z),
			Color = pal.Accent,
			Material = Enum.Material.Neon,
			Transparency = 0.05,
			CanCollide = false,
			Parent = folder,
		})
		cap:SetAttribute("WE_Perimeter", true)
		return w
	end

	-- Segment from outer corner to gate edge: length = alongHalf - gateHalf (NOT *2 — that sealed the gate).
	local function gateFaceSegments(alongHalf: number): (number, number)
		local segLen = math.max(alongHalf - gateHalf, 2)
		local mid = (alongHalf + gateHalf) * 0.5
		return segLen, mid
	end

	if gateAxis == "Z" then
		local closedZ = cz - gateSign * halfZ
		local openZ = cz + gateSign * halfZ
		wall("WallClosed", Vector3.new(halfX * 2, height, thickness), Vector3.new(cx, y, closedZ))
		wall("WallE", Vector3.new(thickness, height, halfZ * 2), Vector3.new(cx + halfX, y, cz))
		wall("WallW", Vector3.new(thickness, height, halfZ * 2), Vector3.new(cx - halfX, y, cz))
		local segLen, mid = gateFaceSegments(halfX)
		if segLen > 2 then
			wall("WallGate_L", Vector3.new(segLen, height, thickness), Vector3.new(cx - mid, y, openZ))
			wall("WallGate_R", Vector3.new(segLen, height, thickness), Vector3.new(cx + mid, y, openZ))
		end
		local postW = 2.2 + lv * 0.15
		local postH = height + 1.5
		local postY = pad.Position.Y + pad.Size.Y * 0.5 + postH * 0.5
		local postInset = gateHalf + postW * 0.5 -- outside clear opening
		for _, sx in ipairs({ -postInset, postInset }) do
			local post = makePart({
				Name = "GatePost",
				Size = Vector3.new(postW, postH, postW),
				Position = Vector3.new(cx + sx, postY, openZ),
				Color = pal.Roof,
				Material = Enum.Material.Metal,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			post:SetAttribute("WE_Perimeter", true)
			post:SetAttribute("WE_GateVisual", true)
			post.CastShadow = true
		end
		local arch = makePart({
			Name = "GateArch",
			Size = Vector3.new(GATE_CLEAR + postW * 2, 1.2, thickness + 0.6),
			Position = Vector3.new(cx, pad.Position.Y + pad.Size.Y * 0.5 + height + 0.4, openZ),
			Color = pal.Accent,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		arch:SetAttribute("WE_Perimeter", true)
		arch:SetAttribute("WE_GateVisual", true)
	else
		local closedX = cx - gateSign * halfX
		local openX = cx + gateSign * halfX
		wall("WallClosed", Vector3.new(thickness, height, halfZ * 2), Vector3.new(closedX, y, cz))
		wall("WallN", Vector3.new(halfX * 2, height, thickness), Vector3.new(cx, y, cz - halfZ))
		wall("WallS", Vector3.new(halfX * 2, height, thickness), Vector3.new(cx, y, cz + halfZ))
		local segLen, mid = gateFaceSegments(halfZ)
		if segLen > 2 then
			wall("WallGate_L", Vector3.new(thickness, height, segLen), Vector3.new(openX, y, cz - mid))
			wall("WallGate_R", Vector3.new(thickness, height, segLen), Vector3.new(openX, y, cz + mid))
		end
		local postW = 2.2 + lv * 0.15
		local postH = height + 1.5
		local postY = pad.Position.Y + pad.Size.Y * 0.5 + postH * 0.5
		local postInset = gateHalf + postW * 0.5
		for _, sz in ipairs({ -postInset, postInset }) do
			local post = makePart({
				Name = "GatePost",
				Size = Vector3.new(postW, postH, postW),
				Position = Vector3.new(openX, postY, cz + sz),
				Color = pal.Roof,
				Material = Enum.Material.Metal,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
			post:SetAttribute("WE_Perimeter", true)
			post:SetAttribute("WE_GateVisual", true)
			post.CastShadow = true
		end
		local arch = makePart({
			Name = "GateArch",
			Size = Vector3.new(thickness + 0.6, 1.2, GATE_CLEAR + postW * 2),
			Position = Vector3.new(openX, pad.Position.Y + pad.Size.Y * 0.5 + height + 0.4, cz),
			Color = pal.Accent,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		arch:SetAttribute("WE_Perimeter", true)
		arch:SetAttribute("WE_GateVisual", true)
	end

	-- L3+ heavy wall catalog mesh on a few segments (Part kit remains authoritative)
	if lv >= 3 then
		task.defer(function()
			pcall(function()
				local vas = require(script.Parent.Parent.Services.VisualAssetService)
				local dressed = 0
				for _, ch in ipairs(folder:GetChildren()) do
					if dressed >= 4 then
						break
					end
					if ch:IsA("BasePart") and ch:GetAttribute("WE_Perimeter") == true and not ch:GetAttribute("WE_GateVisual") then
						if vas.TryAttachBuildingVisual(ch, "DefensiveWalls", lv) then
							dressed += 1
						end
					end
				end
			end)
		end)
	end

end


--[[ Base Ceiling — competitor anti-heli roof over plot core (ATM + main buildings).
	Unlock: DefensiveWalls ≥ L3 (wallsLevel). Gate-front spawn road stays open (no seal).
	Part-kit gunmetal/olive translucent collide plate. Optional mesh only if VisualAssetConfig.Buildings.BaseCeiling has a free ID.
]]
function StructureKitBuilder.SyncBaseCeiling(plotId: number, wallsLevel: number)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local pad = findPlotPad(plotId)
	if not plotFolder or not pad then
		return
	end

	local existing = plotFolder:FindFirstChild(CEILING_FOLDER)
	if wallsLevel < CEILING_UNLOCK_WALLS then
		if existing then
			existing:Destroy()
		end
		plotFolder:SetAttribute("WE_BaseCeiling", false)
		return
	end

	local folder: Folder
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = CEILING_FOLDER
		folder.Parent = plotFolder
	end

	local lv = math.clamp(wallsLevel, CEILING_UNLOCK_WALLS, 5)
	local halfX = pad.Size.X * 0.5
	local halfZ = pad.Size.Z * 0.5
	local cx, cz = pad.Position.X, pad.Position.Z
	local padTop = pad.Position.Y + pad.Size.Y * 0.5

	-- Reuse gate facing from perimeter attrs when present (keeps spawn road open)
	local peri = plotFolder:FindFirstChild(PERIMETER_FOLDER)
	local gateAxis = "Z"
	local gateSign = 1
	if peri then
		local ax = peri:GetAttribute("WE_GateAxis")
		local sg = peri:GetAttribute("WE_GateSign")
		if typeof(ax) == "string" and (ax == "X" or ax == "Z") then
			gateAxis = ax
		end
		if typeof(sg) == "number" then
			gateSign = if (sg :: number) >= 0 then 1 else -1
		end
	else
		local spawnPart = plotFolder:FindFirstChild("PlayerSpawn")
		local dx, dz = 0.0, 1.0
		if spawnPart and spawnPart:IsA("BasePart") then
			dx = spawnPart.Position.X - cx
			dz = spawnPart.Position.Z - cz
		else
			local look = pad.CFrame.LookVector
			dx, dz = look.X, look.Z
		end
		if math.abs(dx) >= math.abs(dz) then
			gateAxis = "X"
			gateSign = if dx >= 0 then 1 else -1
		else
			gateAxis = "Z"
			gateSign = if dz >= 0 then 1 else -1
		end
	end

	-- Cover core (~70% pad) but stop short of gate face so spawn road stays fly/walk open
	local GATE_FRONT_OPEN = 34 -- studs from gate-edge pad rim left uncovered
	local coverFrac = 0.72
	local roofThick = 1.85 + lv * 0.12 -- thicker slab + beams below (not a paper roof)
	-- Wall height formula mirrors SyncPerimeterWalls so roof sits above walls
	local wallH = 6.5 + lv * 2.2
	local roofY = padTop + wallH + 2.4 + roofThick * 0.5

	local sizeX: number
	local sizeZ: number
	local posX: number
	local posZ: number
	if gateAxis == "Z" then
		sizeX = halfX * 2 * coverFrac
		sizeZ = halfZ * 2 * coverFrac - GATE_FRONT_OPEN * 0.55
		sizeZ = math.max(sizeZ, halfZ * 0.85)
		posX = cx
		-- Shift toward CLOSED face (opposite gateSign)
		local closedEdge = cz - gateSign * halfZ
		local openEdge = cz + gateSign * halfZ
		-- Roof center: midway between closed edge and (open edge - GATE_FRONT_OPEN)
		local coveredOpen = openEdge - gateSign * GATE_FRONT_OPEN
		posZ = (closedEdge + coveredOpen) * 0.5
		-- Clamp size so roof does not spill past coveredOpen
		local span = math.abs(coveredOpen - closedEdge)
		sizeZ = math.min(sizeZ, span - 4)
		sizeZ = math.max(sizeZ, 40)
	else
		sizeZ = halfZ * 2 * coverFrac
		sizeX = halfX * 2 * coverFrac - GATE_FRONT_OPEN * 0.55
		sizeX = math.max(sizeX, halfX * 0.85)
		posZ = cz
		local closedEdge = cx - gateSign * halfX
		local openEdge = cx + gateSign * halfX
		local coveredOpen = openEdge - gateSign * GATE_FRONT_OPEN
		posX = (closedEdge + coveredOpen) * 0.5
		local span = math.abs(coveredOpen - closedEdge)
		sizeX = math.min(sizeX, span - 4)
		sizeX = math.max(sizeX, 40)
	end

	-- Gunmetal / olive translucent anti-heli plate
	local roofColor = Color3.fromRGB(58, 68, 55) -- olive gunmetal
	local accentColor = Color3.fromRGB(90, 100, 88)
	local roof = makePart({
		Name = "CeilingPlate",
		Size = Vector3.new(sizeX, roofThick, sizeZ),
		Position = Vector3.new(posX, roofY, posZ),
		Color = roofColor,
		Material = Enum.Material.Metal,
		Transparency = 0.18,
		CanCollide = true,
		Parent = folder,
	})
	roof.CanTouch = false
	roof.CanQuery = true
	roof.CastShadow = true
	roof:SetAttribute("WE_BaseCeiling", true)
	roof:SetAttribute("PlotId", plotId)
	roof:SetAttribute("WE_CeilingLevel", lv)

	-- Edge trim (visual only)
	local trimH = 0.55
	local trimY = roofY + roofThick * 0.5 + trimH * 0.5
	for _, edge in ipairs({
		{ Name = "TrimN", Size = Vector3.new(sizeX + 1.2, trimH, 1.0), Pos = Vector3.new(posX, trimY, posZ - sizeZ * 0.5) },
		{ Name = "TrimS", Size = Vector3.new(sizeX + 1.2, trimH, 1.0), Pos = Vector3.new(posX, trimY, posZ + sizeZ * 0.5) },
		{ Name = "TrimE", Size = Vector3.new(1.0, trimH, sizeZ + 1.2), Pos = Vector3.new(posX + sizeX * 0.5, trimY, posZ) },
		{ Name = "TrimW", Size = Vector3.new(1.0, trimH, sizeZ + 1.2), Pos = Vector3.new(posX - sizeX * 0.5, trimY, posZ) },
	}) do
		local t = makePart({
			Name = edge.Name,
			Size = edge.Size,
			Position = edge.Pos,
			Color = accentColor,
			Material = Enum.Material.Neon,
			Transparency = 0.35,
			CanCollide = false,
			Parent = folder,
		})
		t:SetAttribute("WE_BaseCeiling", true)
	end

	-- Support posts under closed-side corners (not gate side) — visual only
	local postH = roofY - padTop - roofThick * 0.5
	postH = math.max(postH, 8)
	local postY = padTop + postH * 0.5
	local insetX = sizeX * 0.42
	local insetZ = sizeZ * 0.42
	local posts = {
		Vector3.new(posX - insetX, postY, posZ - insetZ),
		Vector3.new(posX + insetX, postY, posZ - insetZ),
		Vector3.new(posX - insetX, postY, posZ + insetZ),
		Vector3.new(posX + insetX, postY, posZ + insetZ),
	}
	for i, ppos in ipairs(posts) do
		-- Skip posts near gate face
		local nearGate = false
		if gateAxis == "Z" then
			nearGate = (gateSign > 0 and ppos.Z > posZ + sizeZ * 0.15) or (gateSign < 0 and ppos.Z < posZ - sizeZ * 0.15)
		else
			nearGate = (gateSign > 0 and ppos.X > posX + sizeX * 0.15) or (gateSign < 0 and ppos.X < posX - sizeX * 0.15)
		end
		if not nearGate then
			local post = makePart({
				Name = "CeilingPost" .. i,
				Size = Vector3.new(1.4, postH, 1.4),
				Position = ppos,
				Color = Color3.fromRGB(48, 52, 46),
				Material = Enum.Material.Metal,
				Transparency = 0.05,
				CanCollide = false,
				Parent = folder,
			})
			post.CastShadow = true
			post:SetAttribute("WE_BaseCeiling", true)
		end
	end

	-- Cross beams + joists under plate so roof reads as structure (not a flat slab)
	do
		local beamColor = Color3.fromRGB(42, 48, 40)
		local beamY = roofY - roofThick * 0.5 - 0.55
		local beamThick = 0.9
		local beamDeep = 1.35
		-- Longitudinal beams (along longer roof axis)
		local longCount = 3
		for i = 1, longCount do
			local t = (i - 1) / math.max(1, longCount - 1) -- 0..1
			if sizeX >= sizeZ then
				-- beams run along X, spaced on Z
				local zOff = (t - 0.5) * sizeZ * 0.7
				local b = makePart({
					Name = "CeilingBeamLong" .. i,
					Size = Vector3.new(sizeX * 0.92, beamDeep, beamThick),
					Position = Vector3.new(posX, beamY, posZ + zOff),
					Color = beamColor,
					Material = Enum.Material.Metal,
					Transparency = 0.05,
					CanCollide = false,
					Parent = folder,
				})
				b.CastShadow = true
				b:SetAttribute("WE_BaseCeiling", true)
			else
				local xOff = (t - 0.5) * sizeX * 0.7
				local b = makePart({
					Name = "CeilingBeamLong" .. i,
					Size = Vector3.new(beamThick, beamDeep, sizeZ * 0.92),
					Position = Vector3.new(posX + xOff, beamY, posZ),
					Color = beamColor,
					Material = Enum.Material.Metal,
					Transparency = 0.05,
					CanCollide = false,
					Parent = folder,
				})
				b.CastShadow = true
				b:SetAttribute("WE_BaseCeiling", true)
			end
		end
		-- Cross joists
		local crossCount = 4
		for i = 1, crossCount do
			local t = (i - 0.5) / crossCount -- centered segments
			if sizeX >= sizeZ then
				local xOff = (t - 0.5) * sizeX * 0.85
				local b = makePart({
					Name = "CeilingJoist" .. i,
					Size = Vector3.new(beamThick * 0.85, beamDeep * 0.85, sizeZ * 0.88),
					Position = Vector3.new(posX + xOff, beamY - 0.15, posZ),
					Color = Color3.fromRGB(52, 58, 48),
					Material = Enum.Material.Metal,
					Transparency = 0.08,
					CanCollide = false,
					Parent = folder,
				})
				b:SetAttribute("WE_BaseCeiling", true)
			else
				local zOff = (t - 0.5) * sizeZ * 0.85
				local b = makePart({
					Name = "CeilingJoist" .. i,
					Size = Vector3.new(sizeX * 0.88, beamDeep * 0.85, beamThick * 0.85),
					Position = Vector3.new(posX, beamY - 0.15, posZ + zOff),
					Color = Color3.fromRGB(52, 58, 48),
					Material = Enum.Material.Metal,
					Transparency = 0.08,
					CanCollide = false,
					Parent = folder,
				})
				b:SetAttribute("WE_BaseCeiling", true)
			end
		end
		-- Corner diagonal braces (closed-side posts → plate)
		for i, ppos in ipairs(posts) do
			local nearGate = false
			if gateAxis == "Z" then
				nearGate = (gateSign > 0 and ppos.Z > posZ + sizeZ * 0.15) or (gateSign < 0 and ppos.Z < posZ - sizeZ * 0.15)
			else
				nearGate = (gateSign > 0 and ppos.X > posX + sizeX * 0.15) or (gateSign < 0 and ppos.X < posX - sizeX * 0.15)
			end
			if not nearGate then
				local mid = Vector3.new((ppos.X + posX) * 0.5, beamY - 1.2, (ppos.Z + posZ) * 0.5)
				local brace = makePart({
					Name = "CeilingBrace" .. i,
					Size = Vector3.new(0.7, 2.8, 0.7),
					Position = mid,
					Color = beamColor,
					Material = Enum.Material.Metal,
					Transparency = 0.1,
					CanCollide = false,
					Parent = folder,
				})
				brace:SetAttribute("WE_BaseCeiling", true)
			end
		end
	end

	folder:SetAttribute("WE_GateAxis", gateAxis)
	folder:SetAttribute("WE_GateSign", gateSign)
	folder:SetAttribute("WE_CeilingLevel", lv)
	plotFolder:SetAttribute("WE_BaseCeiling", true)

	-- Roof helipad dress (competitor-style vertical base): Part-kit H pad + optional Helipad catalog mesh
	local heliSize = math.clamp(math.min(sizeX, sizeZ) * 0.28, 18, 28)
	local heliY = roofY + roofThick * 0.5 + 0.35
	-- Place helipad toward CLOSED side (away from gate front)
	local heliX, heliZ = posX, posZ
	if gateAxis == "Z" then
		heliZ = posZ - gateSign * (sizeZ * 0.18)
	else
		heliX = posX - gateSign * (sizeX * 0.18)
	end
	local heliPad = makePart({
		Name = "RoofHelipad",
		Size = Vector3.new(heliSize, 0.55, heliSize),
		Position = Vector3.new(heliX, heliY, heliZ),
		Color = Color3.fromRGB(48, 52, 48),
		Material = Enum.Material.Concrete,
		Transparency = 0.05,
		CanCollide = true,
		Parent = folder,
	})
	heliPad.CastShadow = true
	heliPad:SetAttribute("WE_BaseCeiling", true)
	heliPad:SetAttribute("WE_RoofHelipad", true)
	-- Yellow H marking
	makePart({
		Name = "RoofHelipadH",
		Size = Vector3.new(heliSize * 0.12, 0.2, heliSize * 0.55),
		Position = Vector3.new(heliX, heliY + 0.4, heliZ),
		Color = Color3.fromRGB(230, 200, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		CanCollide = false,
		Parent = folder,
	}):SetAttribute("WE_BaseCeiling", true)
	makePart({
		Name = "RoofHelipadHBar",
		Size = Vector3.new(heliSize * 0.42, 0.2, heliSize * 0.12),
		Position = Vector3.new(heliX, heliY + 0.4, heliZ),
		Color = Color3.fromRGB(230, 200, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		CanCollide = false,
		Parent = folder,
	}):SetAttribute("WE_BaseCeiling", true)
	-- Ring
	makePart({
		Name = "RoofHelipadRing",
		Size = Vector3.new(heliSize * 0.92, 0.15, heliSize * 0.92),
		Position = Vector3.new(heliX, heliY + 0.28, heliZ),
		Color = Color3.fromRGB(200, 180, 50),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
		Parent = folder,
	}):SetAttribute("WE_BaseCeiling", true)

	-- Roof barracks slots (1–2 small Barracks-style pads) — visual dress only; gate front stays open
	local barracksPads: { BasePart } = {}
	do
		local padSz = math.clamp(math.min(sizeX, sizeZ) * 0.14, 9, 14)
		local padY = roofY + roofThick * 0.5 + 0.38
		local bodyH = 3.6
		local spots: { Vector3 } = {}
		if gateAxis == "Z" then
			-- Flank left/right of roof; slight shift toward gate so they clear helipad (closed side)
			table.insert(spots, Vector3.new(posX - sizeX * 0.30, padY, posZ + gateSign * (sizeZ * 0.08)))
			table.insert(spots, Vector3.new(posX + sizeX * 0.30, padY, posZ + gateSign * (sizeZ * 0.08)))
		else
			table.insert(spots, Vector3.new(posX + gateSign * (sizeX * 0.08), padY, posZ - sizeZ * 0.30))
			table.insert(spots, Vector3.new(posX + gateSign * (sizeX * 0.08), padY, posZ + sizeZ * 0.30))
		end
		local nSlots = if lv >= 5 then 2 else 1
		for i = 1, math.min(nSlots, #spots) do
			local spos = spots[i]
			-- Skip if too close to helipad center
			local dx = spos.X - heliX
			local dz = spos.Z - heliZ
			if (dx * dx + dz * dz) < (heliSize * 0.55) ^ 2 then
				continue
			end
			local bPad = makePart({
				Name = "RoofBarracksPad" .. i,
				Size = Vector3.new(padSz, 0.5, padSz * 0.72),
				Position = spos,
				Color = Color3.fromRGB(62, 72, 58),
				Material = Enum.Material.Concrete,
				Transparency = 0.05,
				CanCollide = true,
				Parent = folder,
			})
			bPad.CastShadow = true
			bPad:SetAttribute("WE_BaseCeiling", true)
			bPad:SetAttribute("WE_RoofBarracks", true)
			bPad:SetAttribute("PlotId", plotId)
			-- Mini Barracks silhouette (Part-kit fallback)
			makePart({
				Name = "RoofBarracksBody" .. i,
				Size = Vector3.new(padSz * 0.78, bodyH, padSz * 0.48),
				Position = Vector3.new(spos.X, padY + 0.25 + bodyH * 0.5, spos.Z),
				Color = Color3.fromRGB(70, 82, 64),
				Material = Enum.Material.Metal,
				Transparency = 0.08,
				CanCollide = false,
				Parent = folder,
			}):SetAttribute("WE_BaseCeiling", true)
			makePart({
				Name = "RoofBarracksRoof" .. i,
				Size = Vector3.new(padSz * 0.86, 0.45, padSz * 0.55),
				Position = Vector3.new(spos.X, padY + 0.25 + bodyH + 0.3, spos.Z),
				Color = Color3.fromRGB(48, 54, 46),
				Material = Enum.Material.Metal,
				Transparency = 0.05,
				CanCollide = false,
				Parent = folder,
			}):SetAttribute("WE_BaseCeiling", true)
			makePart({
				Name = "RoofBarracksAccent" .. i,
				Size = Vector3.new(padSz * 0.35, 0.18, padSz * 0.22),
				Position = Vector3.new(spos.X, padY + 0.55, spos.Z),
				Color = Color3.fromRGB(200, 180, 70),
				Material = Enum.Material.Neon,
				Transparency = 0.25,
				CanCollide = false,
				Parent = folder,
			}):SetAttribute("WE_BaseCeiling", true)
			table.insert(barracksPads, bPad)
		end
		folder:SetAttribute("WE_RoofBarracksSlots", #barracksPads)
	end

	-- Optional catalog: BaseCeiling mesh + Helipad + Barracks dress on roof pads (existing free IDs only)
	task.defer(function()
		pcall(function()
			local vac = require(Shared.Configs.VisualAssetConfig)
			local vas = require(script.Parent.Parent.Services.VisualAssetService)
			local ref = vac.Buildings and vac.Buildings.BaseCeiling
			local aid = ref and tonumber(ref.ModelAssetId) or 0
			if aid and aid > 0 then
				vas.TryAttachBuildingVisual(roof, "BaseCeiling", lv)
			end
			-- Helipad 14313845338 already in VisualAssetConfig.Buildings — dress roof pad
			local heliRef = vac.Buildings and vac.Buildings.Helipad
			local heliAid = heliRef and tonumber(heliRef.ModelAssetId) or 0
			if heliAid and heliAid > 0 and heliPad.Parent then
				vas.TryAttachBuildingVisual(heliPad, "Helipad", 1)
			end
			-- Barracks 18798977801 — dress roof barracks pads when free catalog ID present
			local barRef = vac.Buildings and vac.Buildings.Barracks
			local barAid = barRef and tonumber(barRef.ModelAssetId) or 0
			if barAid and barAid > 0 then
				for _, bp in ipairs(barracksPads) do
					if bp.Parent then
						vas.TryAttachBuildingVisual(bp, "Barracks", 1)
					end
				end
			end
		end)
	end)
end

function StructureKitBuilder.SyncCornerTowers(plotId: number, level: number)
	local plotFolder = StructureKitBuilder.FindPlotFolder(plotId)
	local pad = findPlotPad(plotId)
	if not plotFolder or not pad then
		return
	end

	local existing = plotFolder:FindFirstChild(CORNER_FOLDER)
	if level <= 0 then
		if existing then
			existing:Destroy()
		end
		return
	end

	local folder: Folder
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		folder = existing
	else
		if existing then
			existing:Destroy()
		end
		folder = Instance.new("Folder")
		folder.Name = CORNER_FOLDER
		folder.Parent = plotFolder
	end

	local pal = paletteFor("Watchtowers")
	local lv = math.clamp(level, 1, 5)
	local half = math.max(pad.Size.X, pad.Size.Z) * 0.5 - 3
	local towerW = 7 + lv * 0.5
	local towerH = 26 + lv * 2.8 -- v33: taller corner watchtowers (≥28–40)
	local y = pad.Position.Y + pad.Size.Y * 0.5 + towerH * 0.5
	local cx, cz = pad.Position.X, pad.Position.Z
	local corners = {
		Vector3.new(cx - half, y, cz - half),
		Vector3.new(cx + half, y, cz - half),
		Vector3.new(cx - half, y, cz + half),
		Vector3.new(cx + half, y, cz + half),
	}
	for i, pos in ipairs(corners) do
		local body = makePart({
			Name = "CornerTower" .. i,
			Size = Vector3.new(towerW, towerH, towerW),
			Position = pos,
			Color = pal.Body,
			Material = Enum.Material.Concrete,
			Transparency = 0,
			CanCollide = true,
			Parent = folder,
		})
		body.CastShadow = true
		body:SetAttribute("WE_CornerTower", true)
		makePart({
			Name = "TowerCap" .. i,
			Size = Vector3.new(towerW + 1.2, 0.6, towerW + 1.2),
			Position = Vector3.new(pos.X, pos.Y + towerH * 0.5 + 0.35, pos.Z),
			Color = pal.Roof,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		makePart({
			Name = "TowerPlatform" .. i,
			Size = Vector3.new(towerW + 3, 0.5, towerW + 3),
			Position = Vector3.new(pos.X, pos.Y + towerH * 0.5 - 1.2, pos.Z),
			Color = pal.Roof,
			Material = Enum.Material.Metal,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
		-- Rail ring
		for _, off in ipairs({ Vector3.new(towerW * 0.7, 0, 0), Vector3.new(-towerW * 0.7, 0, 0), Vector3.new(0, 0, towerW * 0.7), Vector3.new(0, 0, -towerW * 0.7) }) do
			makePart({
				Name = "TowerRail" .. i,
				Size = Vector3.new(if math.abs(off.X) > 0 then 0.35 else towerW + 2.5, 1.6, if math.abs(off.Z) > 0 then 0.35 else towerW + 2.5),
				Position = Vector3.new(pos.X + off.X, pos.Y + towerH * 0.5 - 0.2, pos.Z + off.Z),
				Color = pal.Accent,
				Material = Enum.Material.Metal,
				Transparency = 0,
				CanCollide = false,
				Parent = folder,
			})
		end
		makePart({
			Name = "TowerBeacon" .. i,
			Size = Vector3.new(0.6, 2.2 + lv * 0.4, 0.6),
			Position = Vector3.new(pos.X, pos.Y + towerH * 0.5 + 2, pos.Z),
			Color = pal.Accent,
			Material = Enum.Material.Neon,
			Transparency = 0,
			CanCollide = false,
			Parent = folder,
		})
	end
end

function StructureKitBuilder.ClearPlotExtras(plotId: number)
	StructureKitBuilder.SyncPerimeterWalls(plotId, 0)
	StructureKitBuilder.SyncCornerTowers(plotId, 0)
	StructureKitBuilder.SyncBaseCeiling(plotId, 0)
end

return StructureKitBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">StudioBuySmoke</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Studio-only auto BUY smoke.
	After profile + plot assign (~3–5s): teleport to plot, PurchaseUpgrade(CommandCenter),
	print unmistakable [SMOKE] BUY lines, mirror into ServerStorage.SmokeResult,
	and FireAllClients(StudioSmokeLog) so Play Solo client Output also shows the result.

	NEVER runs outside RunService:IsStudio(). Product Ids stay 0 (no Marketplace).
	HttpService / %TEMP% file writes are unreliable from Studio Luau — prefer prints + remote.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StudioBuySmoke = {}

local STRUCTURE_ID = "CommandCenter"
local DELAY_SEC = 4.0
local ranFor: { [number]: boolean } = {}

local smokeRemote: RemoteEvent? = nil

local function resolveSmokeRemote(): RemoteEvent?
	if smokeRemote and smokeRemote.Parent then
		return smokeRemote
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		return nil
	end
	local ev = folder:FindFirstChild("StudioSmokeLog")
	if ev and ev:IsA("RemoteEvent") then
		smokeRemote = ev
		return ev
	end
	return nil
end

local function writeResult(line: string)
	local folder = ServerStorage:FindFirstChild("SmokeResult")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "SmokeResult"
		folder.Parent = ServerStorage
	end
	local sv = folder:FindFirstChild("LastBuy")
	if not sv then
		sv = Instance.new("StringValue")
		sv.Name = "LastBuy"
		sv.Parent = folder
	end
	sv.Value = line
	local log = folder:FindFirstChild("Log")
	if not log then
		log = Instance.new("StringValue")
		log.Name = "Log"
		log.Parent = folder
	end
	local prev = log.Value
	if #prev > 4000 then
		prev = string.sub(prev, -2000)
	end
	log.Value = prev .. (if prev ~= "" then "\n" else "") .. line
end

local function broadcast(kind: string, line: string)
	local ev = resolveSmokeRemote()
	if ev then
		ev:FireAllClients(kind, line, os.clock())
	end
end

local function smokeLine(kind: string, detail: string)
	local line = string.format("[SMOKE] BUY %s %s", kind, detail)
	-- Louder than a single print: banner + warn on FAIL so Output filter can't miss it
	print("========== " .. line .. " ==========")
	print(line)
	if kind == "FAIL" then
		warn(line)
	elseif kind == "OK" then
		print("[SMOKE] ★★★ BUY PATH OK ★★★")
	end
	writeResult(line)
	broadcast(kind, line)
	return line
end

function StudioBuySmoke.Init(deps: { [string]: any })
	if not RunService:IsStudio() then
		return
	end

	local DataService = deps.DataService
	local BaseService = deps.BaseService
	if not DataService or not BaseService then
		warn("[SMOKE] BUY FAIL deps missing DataService/BaseService")
		broadcast("FAIL", "[SMOKE] BUY FAIL deps missing DataService/BaseService")
		return
	end

	-- Resolve remote early (RemoteSetup runs before this)
	task.defer(function()
		local ev = resolveSmokeRemote()
		if ev then
			print("[SMOKE] StudioSmokeLog remote ready — client Output will mirror BUY lines")
		else
			warn("[SMOKE] StudioSmokeLog remote missing — server prints only")
		end
	end)

	print("[SMOKE] StudioBuySmoke armed (IsStudio=true) — will auto-BUY CommandCenter ~4s after plot assign")
	print("[SMOKE] Watch Output for: [SMOKE] BUY START / OK / FAIL  (also FireAllClients StudioSmokeLog)")

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		if ranFor[player.UserId] then
			return
		end
		ranFor[player.UserId] = true

		task.delay(DELAY_SEC, function()
			if not player.Parent then
				smokeLine("FAIL", "player left before smoke")
				return
			end

			local profile = DataService.GetProfile(player)
			if not profile then
				smokeLine("FAIL", "NoProfile after delay")
				return
			end

			-- Ensure plot + standing on it
			if profile.BasePlotId == nil and BaseService.AssignPlot then
				BaseService.AssignPlot(player)
				profile = DataService.GetProfile(player) or profile
			end
			if BaseService.TeleportToPlot then
				BaseService.TeleportToPlot(player)
			end

			local cashBefore = tonumber(profile.Cash) or 0
			local levelBefore = tonumber(profile.BaseUpgrades and profile.BaseUpgrades[STRUCTURE_ID]) or 0

			-- Studio-only: ensure one upgrade can succeed (cash + not already MaxLevel)
			local EconomyService = deps.EconomyService
			local Shared = ReplicatedStorage:FindFirstChild("Shared")
			if Shared then
				local okCfg, BaseConfig = pcall(function()
					return require(Shared.Configs.BaseConfig)
				end)
				if okCfg and typeof(BaseConfig) == "table" then
					local def = BaseConfig.Structures and BaseConfig.Structures[STRUCTURE_ID]
					local maxLevel = if def then (tonumber(def.MaxLevel) or 5) else 5
					if levelBefore >= maxLevel then
						profile.BaseUpgrades[STRUCTURE_ID] = maxLevel - 1
						levelBefore = maxLevel - 1
						DataService.MarkDirty(player)
					end
					local nextLevel = levelBefore + 1
					local cost = def and def.Costs and def.Costs[nextLevel]
					if typeof(cost) == "number" and cashBefore < cost and EconomyService and EconomyService.AddCash then
						EconomyService.AddCash(player, cost - cashBefore, "studio_smoke_buy")
						profile = DataService.GetProfile(player) or profile
						cashBefore = tonumber(profile.Cash) or cashBefore
					end
				end
			end

			smokeLine("START", string.format(
				"player=%s cash=%d level=%d structure=%s plot=%s",
				player.Name,
				cashBefore,
				levelBefore,
				STRUCTURE_ID,
				tostring(profile.BasePlotId)
			))

			local okCall, resultOrErr = pcall(function()
				return BaseService.PurchaseUpgrade(player, STRUCTURE_ID)
			end)
			if not okCall then
				smokeLine("FAIL", "pcall error: " .. tostring(resultOrErr))
				return
			end

			local result = resultOrErr
			if typeof(result) ~= "table" then
				smokeLine("FAIL", "bad result type=" .. typeof(result))
				return
			end

			profile = DataService.GetProfile(player) or profile
			local cashAfter = tonumber(result.Cash) or tonumber(profile.Cash) or cashBefore
			local levelAfter = tonumber(result.NewLevel)
				or tonumber(profile.BaseUpgrades and profile.BaseUpgrades[STRUCTURE_ID])
				or levelBefore

			if result.Ok == true then
				smokeLine("OK", string.format("newCash=%d level=%d structure=%s", cashAfter, levelAfter, STRUCTURE_ID))
				-- Follow-up: Barracks buy path (~2s later) so pad chain is exercised
				task.delay(2.0, function()
					if not player.Parent then
						return
					end
					local barracksId = "Barracks"
					local prof2 = DataService.GetProfile(player)
					if not prof2 then
						smokeLine("FAIL", "Barracks follow-up NoProfile")
						return
					end
					local lvlB = tonumber(prof2.BaseUpgrades and prof2.BaseUpgrades[barracksId]) or 0
					local cashB = tonumber(prof2.Cash) or 0
					local Shared2 = ReplicatedStorage:FindFirstChild("Shared")
					if Shared2 then
						local okCfg2, BaseConfig2 = pcall(function()
							return require(Shared2.Configs.BaseConfig)
						end)
						if okCfg2 and typeof(BaseConfig2) == "table" then
							local defB = BaseConfig2.Structures and BaseConfig2.Structures[barracksId]
							local maxB = if defB then (tonumber(defB.MaxLevel) or 5) else 5
							if lvlB >= maxB then
								prof2.BaseUpgrades[barracksId] = maxB - 1
								lvlB = maxB - 1
								DataService.MarkDirty(player)
							end
							local nextB = lvlB + 1
							local costB = defB and defB.Costs and defB.Costs[nextB]
							if typeof(costB) == "number" and cashB < costB and EconomyService and EconomyService.AddCash then
								EconomyService.AddCash(player, costB - cashB, "studio_smoke_buy_barracks")
								prof2 = DataService.GetProfile(player) or prof2
								cashB = tonumber(prof2.Cash) or cashB
							end
						end
					end
					smokeLine("START", string.format("follow-up structure=%s cash=%d level=%d", barracksId, cashB, lvlB))
					local okB, resB = pcall(function()
						return BaseService.PurchaseUpgrade(player, barracksId)
					end)
					if not okB then
						smokeLine("FAIL", "Barracks pcall: " .. tostring(resB))
						return
					end
					if typeof(resB) == "table" and resB.Ok == true then
						smokeLine("OK", string.format("follow-up Barracks newLevel=%s cash=%s", tostring(resB.NewLevel), tostring(resB.Cash)))
					else
						local errB = if typeof(resB) == "table" then tostring(resB.Error) else typeof(resB)
						smokeLine("FAIL", "Barracks follow-up err=" .. errB)
					end
				end)
			else
				smokeLine("FAIL", string.format("err=%s cash=%d level=%d", tostring(result.Error), cashAfter, levelAfter))
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		ranFor[player.UserId] = nil
	end)
end

return StudioBuySmoke
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="60">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local AdminConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.AdminConfig)
local Constants = require(ReplicatedStorage:WaitForChild("Shared").Constants)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local AdminService = {}

local EconomyService: any = nil
local XPService: any = nil
local DataService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil

function AdminService.IsAdmin(player: Player): boolean
	for _, id in ipairs(AdminConfig.UserIds) do
		if id == player.UserId then
			return true
		end
	end
	return false
end

function AdminService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	DataService = deps.DataService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService

	local RemoteSetup = deps.RemoteSetup
	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestAdminCommand) :: RemoteEvent

	remote.OnServerEvent:Connect(function(player: Player, command: any, arg1: any, arg2: any)
		if not RateLimitService.Allow(player, "admin", 2, 4) then
			return
		end
		if not AdminService.IsAdmin(player) then
			warn("[AdminService] Unauthorized admin attempt:", player.UserId)
			return
		end
		if not RemoteGuard.IsCommandString(command) then
			return
		end
		-- Admin still requires a loaded profile for mutating commands
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end

		local cmd = string.lower(command :: string)
		local ADMIN_GRANT_MAX = 1_000_000_000
		AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = cmd })

		if cmd == "givecash" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				EconomyService.AddCash(player, amt, "admin")
			end
		elseif cmd == "givegold" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				EconomyService.AddGold(player, amt, "admin")
			end
		elseif cmd == "givexp" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				XPService.AddXP(player, amt, "admin")
			end
		elseif cmd == "setlevel" then
			local lvl = RemoteGuard.ClampPositiveInt(arg1, 1000)
			if lvl then
				XPService.SetLevel(player, lvl)
			end
		elseif cmd == "unlockall" then
			local profile = DataService.GetProfile(player)
			if profile then
				local VehicleConfig = require(ReplicatedStorage.Shared.Configs.VehicleConfig)
				local WeaponConfig = require(ReplicatedStorage.Shared.Configs.WeaponConfig)
				for id in pairs(VehicleConfig.Vehicles) do
					profile.Vehicles[id] = true
				end
				for id in pairs(WeaponConfig.Weapons) do
					profile.Weapons[id] = true
				end
				DataService.MarkDirty(player)
			end
		elseif cmd == "resetbase" then
			local profile = DataService.GetProfile(player)
			if profile then
				for id in pairs(profile.BaseUpgrades) do
					profile.BaseUpgrades[id] = 0
				end
				DataService.MarkDirty(player)
				if deps.BaseService then
					deps.BaseService.PushState(player)
					if deps.BaseService.RefreshAllVisuals then
						deps.BaseService.RefreshAllVisuals(player)
					end
				end
			end
		elseif cmd == "resettutorial" then
			if deps.TutorialService and deps.TutorialService.Reset then
				deps.TutorialService.Reset(player)
			end
		elseif cmd == "prestige" or cmd == "forceprestige" then
			if deps.PrestigeService and deps.PrestigeService.DoPrestige then
				-- force: temporarily ignore level gate via SetLevel first if needed
				if cmd == "forceprestige" and deps.XPService then
					local PrestigeConfig = require(ReplicatedStorage.Shared.Configs.PrestigeConfig)
					deps.XPService.SetLevel(player, PrestigeConfig.MinLevelToPrestige)
				end
				local ok, err = deps.PrestigeService.DoPrestige(player)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, if ok then "Prestige OK" else ("Prestige failed: " .. tostring(err)), if ok then "Success" else "Warn")
				end
			end
		elseif cmd == "createclan" and RemoteGuard.IsIdString(arg1, 32) then
			if deps.ClanService and deps.ClanService.CreateClan then
				local tagArg = if RemoteGuard.IsIdString(arg2, 8) then arg2 :: string else nil
				local ok, err = deps.ClanService.CreateClan(player, arg1 :: string, tagArg)
				if not ok and deps.NotificationService then
					deps.NotificationService.Notify(player, "Clan create failed: " .. tostring(err), "Warn")
				end
			end
		elseif cmd == "joinclan" and RemoteGuard.IsIdString(arg1) then
			if deps.ClanService then
				deps.ClanService.JoinClan(player, arg1 :: string)
			end
		elseif cmd == "leaveclan" then
			if deps.ClanService then
				deps.ClanService.LeaveClan(player)
			end
		elseif cmd == "bpxp" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt and deps.BattlePassService and deps.BattlePassService.AddXP then
				deps.BattlePassService.AddXP(player, amt, "admin")
			end
		elseif cmd == "grantpremium" then
			if deps.BattlePassService and deps.BattlePassService.SetPremium then
				deps.BattlePassService.SetPremium(player, true)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Battle Pass Premium granted", "Success")
				end
			end
		elseif cmd == "grantpass" and RemoteGuard.IsKeyString(arg1) then
			-- Studio mock GamePass ownership (Ids may still be 0)
			if deps.MonetizationService and deps.MonetizationService.SetMockGamePassOwned then
				deps.MonetizationService.SetMockGamePassOwned(player, arg1 :: string, true)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Mock GamePass owned: " .. arg1, "Success")
				end
			end
		elseif cmd == "endseason" then
			if deps.SeasonService and deps.SeasonService.EndSeason then
				deps.SeasonService.EndSeason("admin:" .. tostring(player.UserId))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Season ended (admin)", "Info")
				end
			end
		elseif cmd == "resumeseason" then
			if deps.SeasonService and deps.SeasonService.ClearEndOverride then
				deps.SeasonService.ClearEndOverride("admin:" .. tostring(player.UserId))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Season resumed (admin)", "Success")
				end
			end
		elseif cmd == "resetmap" then
			-- Studio: destroy WarEmpireSetup and rebuild via MapSetup
			if not RunService:IsStudio() then
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "resetmap is Studio-only", "Warn")
				end
				return
			end
			local existing = Workspace:FindFirstChild("WarEmpireSetup")
			if existing then
				existing:Destroy()
			end
			local voidFb = Workspace:FindFirstChild("WE_VoidFallback")
			if voidFb then
				voidFb:Destroy()
			end
			local MapSetup = require(script.Parent.Parent.Modules.MapSetup)
			local ok, err = pcall(function()
				MapSetup.Run()
			end)
			if not ok then
				warn("[WAR EMPIRE] resetmap MapSetup failed: " .. tostring(err))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "MapSetup failed — check Output", "Error")
				end
				return
			end
			if deps.NotificationService then
				deps.NotificationService.Notify(player, "Map regenerated (MapSetup)", "Success")
			end
		end
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Analytics abstraction. MVP logs to output; plug in real sink later.
	Does not fabricate metrics — only logs events you fire.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnalyticsConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.AnalyticsConfig)

local AnalyticsService = {}

local sink: ((eventName: string, userId: number?, props: { [string]: any }?) -> ())? = nil

function AnalyticsService.Init()
	-- default sink
end

function AnalyticsService.SetSink(fn: (eventName: string, userId: number?, props: { [string]: any }?) -> ())
	sink = fn
end

function AnalyticsService.Log(eventName: string, userId: number?, props: { [string]: any }?)
	if not AnalyticsConfig.Enabled then
		return
	end
	if sink then
		sink(eventName, userId, props)
		return
	end
	if AnalyticsConfig.LogToOutput then
		local propStr = ""
		if props then
			local parts = {}
			for k, v in pairs(props) do
				table.insert(parts, string.format("%s=%s", tostring(k), tostring(v)))
			end
			propStr = table.concat(parts, ", ")
		end
		print(string.format("[Analytics] %s user=%s %s", eventName, tostring(userId), propStr))
	end
end

return AnalyticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Basic sanity helpers used by other services ]]

local AntiExploitService = {}

local RateLimitService: any = nil
local strikeCount: { [number]: number } = {}

function AntiExploitService.Init(deps: { [string]: any })
	RateLimitService = deps.RateLimitService
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		strikeCount[player.UserId] = nil
	end)
end

function AntiExploitService.IsFiniteNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function AntiExploitService.ClampMagnitude(vec: Vector3, maxMag: number): Vector3
	if vec.Magnitude > maxMag then
		return vec.Unit * maxMag
	end
	return vec
end

function AntiExploitService.Strike(player: Player, reason: string)
	local id = player.UserId
	strikeCount[id] = (strikeCount[id] or 0) + 1
	warn("[AntiExploit]", player.Name, reason, "strikes=", strikeCount[id])
	if strikeCount[id] >= 10 then
		player:Kick("Unusual activity detected.")
	end
end

function AntiExploitService.CheckRemote(player: Player, key: string): boolean
	if not RateLimitService.Allow(player, "ae_" .. key, 6, 10) then
		AntiExploitService.Strike(player, "rate_" .. key)
		return false
	end
	return true
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">BankRaidService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Empire Bank raid — stand on vault to loot Cash; per-player cooldown.
	Bank guards are living CombatService NPCs (MoveTo + shoot), not static MapSetup props.
	Pushes HoldProgress / UnderFire / InVault to clients for BankRaidController HUD.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BankRaidConfig = require(Shared.Configs.BankRaidConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local BankRaidService = {}

local EconomyService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil
local RemoteSetup: any = nil
local CombatService: any = nil

local vaultPart: BasePart? = nil
local holdProgress: { [number]: number } = {}
local cooldownUntil: { [number]: number } = {}
local inVaultNow: { [number]: boolean } = {}
local underFireNow: { [number]: boolean } = {}
local lastPushedProgress: { [number]: number } = {}
local guardsSpawned = false
local billboardLabel: TextLabel? = nil

local function findVault(): BasePart?
	if vaultPart and vaultPart.Parent then
		return vaultPart
	end
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BankVault)) do
		if inst:IsA("BasePart") then
			vaultPart = inst
			return inst
		end
	end
	return nil
end

local function ensureVaultBillboard(vault: BasePart)
	local existing = vault:FindFirstChild("WE_BankRaidStatus")
	if existing and existing:IsA("BillboardGui") then
		local lbl = existing:FindFirstChild("Status")
		if lbl and lbl:IsA("TextLabel") then
			billboardLabel = lbl
			return
		end
	end
	if existing then
		existing:Destroy()
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_BankRaidStatus"
	bb.Size = UDim2.fromOffset(300, 48)
	bb.StudsOffset = Vector3.new(0, 10, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 220
	bb.Parent = vault

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Status"
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 18
	lbl.TextColor3 = Color3.fromRGB(255, 220, 120)
	lbl.TextStrokeTransparency = 0.4
	lbl.Text = "EMPIRE BANK — STAND TO LOOT"
	lbl.Parent = bb
	billboardLabel = lbl
end

local function refreshBillboardHint()
	local lbl = billboardLabel
	if not lbl then
		return
	end
	-- Prefer a short public hint; per-player cooldown stays on the ScreenGui.
	local anyRaiding = false
	for uid, inv in pairs(inVaultNow) do
		if inv and (holdProgress[uid] or 0) > 0 then
			anyRaiding = true
			break
		end
	end
	if anyRaiding then
		lbl.Text = "EMPIRE BANK — RAID IN PROGRESS"
		lbl.TextColor3 = Color3.fromRGB(255, 180, 80)
	else
		lbl.Text = "EMPIRE BANK — STAND TO LOOT"
		lbl.TextColor3 = Color3.fromRGB(255, 220, 120)
	end
end

local function spawnBankGuards()
	if guardsSpawned then
		return
	end
	if not CombatService or not CombatService.SpawnNPC then
		warn("[WAR EMPIRE] BankRaidService: CombatService.SpawnNPC missing")
		return
	end
	guardsSpawned = true

	local vault = findVault()
	local origin = if vault then vault.Position else (BankRaidConfig.Position or Vector3.new(220, 1, -220))
	local count = BankRaidConfig.GuardCount or 4
	local ring = BankRaidConfig.GuardRingRadius or 16
	local typeId = BankRaidConfig.GuardNPCType or "BankGuard"
	local spawned = 0
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + 0.35
		local pos = origin + Vector3.new(math.cos(angle) * ring, 3.2, math.sin(angle) * ring)
		local cf = CFrame.new(pos) * CFrame.Angles(0, -angle + math.pi, 0)
		local rec = CombatService.SpawnNPC(typeId, cf)
		if rec then
			spawned += 1
		end
	end
	print(string.format("[WAR EMPIRE] BankRaidService: spawned %d %s combat NPCs at bank", spawned, typeId))
	if spawned == 0 then
		warn("[WAR EMPIRE] BankRaidService: ZERO BankGuards — will retry once in 3s")
		guardsSpawned = false
		task.delay(3, function()
			if not guardsSpawned then
				spawnBankGuards()
			end
		end)
	end
end

local function pushState(player: Player, opts: { InVault: boolean?, UnderFire: boolean? }?)
	if not RemoteSetup then
		return
	end
	local now = os.time()
	local untilT = cooldownUntil[player.UserId] or 0
	local remaining = math.max(0, untilT - now)
	local need = BankRaidConfig.RaidHoldSeconds or 8
	local prog = holdProgress[player.UserId] or 0
	local inVault = if opts and opts.InVault ~= nil then opts.InVault else (inVaultNow[player.UserId] == true)
	local underFire = if opts and opts.UnderFire ~= nil then opts.UnderFire else (underFireNow[player.UserId] == true)
	local remote = RemoteSetup.Get(Constants.RemoteNames.BankRaidStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		BankId = BankRaidConfig.BankId,
		DisplayName = BankRaidConfig.DisplayName,
		Enabled = BankRaidConfig.Enabled == true,
		CooldownRemaining = remaining,
		RaidHoldSeconds = need,
		HoldNeed = need,
		HoldProgress = prog,
		InVault = inVault,
		UnderFire = underFire,
		CashHintMin = BankRaidConfig.CashMin,
		CashHintMax = BankRaidConfig.CashMax,
	})
	lastPushedProgress[player.UserId] = prog
end

local function completeRaid(player: Player)
	local cashMin = BankRaidConfig.CashMin or 15000
	local cashMax = BankRaidConfig.CashMax or 35000
	local cash = math.random(cashMin, cashMax)
	EconomyService.AddCash(player, cash, "bank_raid")
	local cd = BankRaidConfig.CooldownSeconds or 300
	cooldownUntil[player.UserId] = os.time() + cd
	holdProgress[player.UserId] = nil
	inVaultNow[player.UserId] = false
	underFireNow[player.UserId] = false
	if BankRaidConfig.NotifyOnRaid and NotificationService then
		NotificationService.Notify(
			player,
			string.format("Bank raid +$%d · cooldown %dm", cash, math.ceil(cd / 60)),
			"Reward"
		)
	end
	if AnalyticsService then
		local ev = (AnalyticsConfig.Events and AnalyticsConfig.Events.BANK_RAID) or "BANK_RAID"
		AnalyticsService.Log(ev, player.UserId, { cash = cash })
	end
	pushState(player, { InVault = false, UnderFire = false })
end

local function isUnderFire(player: Player): boolean
	local char = player.Character
	if not char then
		return true
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return true
	end
	return hum.Health < hum.MaxHealth * 0.95
end

function BankRaidService.Push(player: Player)
	pushState(player)
end

function BankRaidService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService
	RemoteSetup = deps.RemoteSetup
	CombatService = deps.CombatService

	if not BankRaidConfig.Enabled then
		return
	end

	task.defer(function()
		task.wait(2)
		local vault = findVault()
		if vault then
			ensureVaultBillboard(vault)
		end
		spawnBankGuards()
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.25 then
			return
		end
		local step = accum
		accum = 0

		local vault = findVault()
		if not vault then
			return
		end
		if not billboardLabel then
			ensureVaultBillboard(vault)
		end
		local radius = BankRaidConfig.VaultRadius or 12
		local need = BankRaidConfig.RaidHoldSeconds or 8
		local nowUnix = os.time()
		local pos = vault.Position
		local nearby: { [number]: boolean } = {}
		local toPush: { Player } = {}

		for _, player in ipairs(Players:GetPlayers()) do
			local uid = player.UserId
			local untilT = cooldownUntil[uid] or 0
			local onCooldown = untilT > nowUnix
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local inside = false
			local fired = false

			if hrp and hum and hum.Health > 0 then
				inside = (hrp.Position - pos).Magnitude <= radius
			end

			if inside and not onCooldown then
				nearby[uid] = true
				fired = isUnderFire(player)
				underFireNow[uid] = fired
				inVaultNow[uid] = true
				if not fired then
					local prog = (holdProgress[uid] or 0) + step
					holdProgress[uid] = prog
					if prog >= need then
						completeRaid(player)
						-- completeRaid already pushed
					else
						table.insert(toPush, player)
					end
				else
					-- Under fire: progress frozen but HUD must show the block
					table.insert(toPush, player)
				end
			elseif inside and onCooldown then
				-- Standing on vault while cooling down — still show cooldown HUD
				inVaultNow[uid] = true
				underFireNow[uid] = false
				nearby[uid] = true
				table.insert(toPush, player)
			else
				local wasIn = inVaultNow[uid] == true
				local hadProg = (holdProgress[uid] or 0) > 0
				if wasIn or hadProg then
					-- Left vault / progress reset — push once so client hides bar
					inVaultNow[uid] = false
					underFireNow[uid] = false
					holdProgress[uid] = nil
					table.insert(toPush, player)
				else
					inVaultNow[uid] = false
					underFireNow[uid] = false
				end
			end
		end

		for uid in pairs(holdProgress) do
			if not nearby[uid] then
				holdProgress[uid] = nil
			end
		end

		for _, player in ipairs(toPush) do
			pushState(player)
		end

		refreshBillboardHint()
	end)

	Players.PlayerAdded:Connect(function(player)
		task.defer(function()
			pushState(player)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local uid = player.UserId
		holdProgress[uid] = nil
		inVaultNow[uid] = nil
		underFireNow[uid] = nil
		lastPushedProgress[uid] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.defer(function()
			pushState(player)
		end)
	end

	print("[WAR EMPIRE] BankRaidService ready (live BankGuard combat NPCs + HoldProgress HUD)")
end

return BankRaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Base plot assignment, upgrades, passive income, visual hooks.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local DevConfig = require(Shared.Configs.DevConfig)
local Types = require(Shared.Types)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)
local StructureKitBuilder = require(script.Parent.Parent.Modules.StructureKitBuilder)

local BaseService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local TerritoryService: any = nil
local MissionService: any = nil
local TutorialService: any = nil
local NotificationService: any = nil
local MonetizationService: any = nil

-- plotId -> userId
local plotOwners: { [number]: number } = {}
-- Bindable for Studio visuals
local upgradeChangedBindable: BindableEvent? = nil

local function getUpgradeChangedEvent(): BindableEvent
	if upgradeChangedBindable and upgradeChangedBindable.Parent then
		return upgradeChangedBindable
	end
	local folder = ReplicatedStorage:FindFirstChild("WarEmpireEvents")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "WarEmpireEvents"
		folder.Parent = ReplicatedStorage
	end
	local ev = folder:FindFirstChild("BaseUpgradeChanged")
	if not ev then
		ev = Instance.new("BindableEvent")
		ev.Name = "BaseUpgradeChanged"
		ev.Parent = folder
	end
	upgradeChangedBindable = ev :: BindableEvent
	return upgradeChangedBindable
end

function BaseService.GetUpgradeChangedEvent(): BindableEvent
	return getUpgradeChangedEvent()
end

local function findFreePlot(): number?
	for plotId = 1, BaseConfig.MaxPlots do
		if plotOwners[plotId] == nil then
			return plotId
		end
	end
	return nil
end

function BaseService.AssignPlot(player: Player): number?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end

	-- Reclaim previous if still free
	if profile.BasePlotId and plotOwners[profile.BasePlotId] == nil then
		plotOwners[profile.BasePlotId] = player.UserId
		return profile.BasePlotId
	end

	local plotId = findFreePlot()
	if not plotId then
		warn("[BaseService] No free plots for", player.Name)
		return nil
	end

	plotOwners[plotId] = player.UserId
	profile.BasePlotId = plotId
	DataService.MarkDirty(player)
	return plotId
end

function BaseService.ReleasePlot(player: Player)
	local userId = player.UserId
	for plotId, owner in pairs(plotOwners) do
		if owner == userId then
			pcall(function()
				StructureKitBuilder.ClearPlotExtras(plotId)
			end)
			plotOwners[plotId] = nil
		end
	end
end

function BaseService.GetOwnerUserId(plotId: number): number?
	return plotOwners[plotId]
end

function BaseService.ComputePassiveIncomePerTick(profile: Types.PlayerProfile, player: Player?): number
	local total = EconomyConfig.PassiveIncome.BaseCashPerTick
	local rates = EconomyConfig.PassiveIncome.PerLevelRates
	for structureId, level in pairs(profile.BaseUpgrades) do
		local rate = rates[structureId]
		if rate and level > 0 then
			total += rate * level
		end
	end
	local mult = 1 + (profile.Prestige * (EconomyConfig.PrestigeCashMultiplierPerLevel or 0))
	-- Territory ownership bonuses (Phase 5)
	if player and TerritoryService and TerritoryService.GetPassiveCashBonus then
		local bonusMult, flat = TerritoryService.GetPassiveCashBonus(player)
		mult += bonusMult
		total += flat
	end
	return math.floor(total * mult)
end

function BaseService.PushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local remote = RemoteSetup.Get(Constants.RemoteNames.BaseStateUpdate) :: RemoteEvent
	local payload: Types.BaseStatePayload = {
		PlotId = profile.BasePlotId,
		Upgrades = profile.BaseUpgrades,
		PassiveIncomePerTick = BaseService.ComputePassiveIncomePerTick(profile, player),
	}
	remote:FireClient(player, payload)
end

local function meetsRequirements(profile: Types.PlayerProfile, structureId: string): (boolean, string?)
	local def = BaseConfig.Structures[structureId]
	if not def then
		return false, "UnknownStructure"
	end
	if def.Requires then
		for _, req in ipairs(def.Requires) do
			local have = profile.BaseUpgrades[req.StructureId] or 0
			if have < req.Level then
				return false, "MissingRequirement"
			end
		end
	end
	return true, nil
end


function BaseService.GetPlotSpawnCFrame(plotId: number): CFrame?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			local folder = inst.Parent
			if folder then
				local spawn = folder:FindFirstChild("PlayerSpawn")
				if spawn and spawn:IsA("BasePart") then
					return spawn.CFrame + Vector3.new(0, 3, 0)
				end
			end
			return inst.CFrame + Vector3.new(0, 5, 55)
		end
	end
	local pos = BaseConfig.PlotPositions[plotId]
	if typeof(pos) == "Vector3" then
		return CFrame.new(pos + Vector3.new(0, 5, 55))
	end
	return nil
end

function BaseService.TeleportToPlot(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	-- Studio solo: never leave BasePlotId nil
	if profile.BasePlotId == nil then
		BaseService.AssignPlot(player)
		profile = DataService.GetProfile(player) or profile
		if profile.BasePlotId == nil then
			profile.BasePlotId = 1
		end
	end
	local cf = BaseService.GetPlotSpawnCFrame(profile.BasePlotId)
	if not cf then
		return
	end
	local function apply(character: Model)
		if character and character.Parent then
			character:PivotTo(cf)
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
	local function applyWithRetries(character: Model)
		apply(character)
		-- Retry: CharacterAdded / physics settle can undo first PivotTo
		task.delay(0.35, function()
			if player.Character == character and character.Parent then
				apply(character)
			end
		end)
		task.delay(1.0, function()
			if player.Character == character and character.Parent then
				apply(character)
			end
		end)
	end
	if player.Character then
		applyWithRetries(player.Character)
	else
		local conn: RBXScriptConnection?
		conn = player.CharacterAdded:Connect(function(character)
			if conn then
				conn:Disconnect()
			end
			task.defer(function()
				applyWithRetries(character)
			end)
		end)
		task.delay(30, function()
			if conn then
				conn:Disconnect()
			end
		end)
	end
end

function BaseService.PurchaseUpgrade(player: Player, structureId: string): Types.PurchaseUpgradeResult
	if not RemoteGuard.IsIdString(structureId, 48) then
		return { Ok = false, Error = "InvalidStructure" }
	end

	local profile = DataService.GetProfile(player)
	if not profile then
		return { Ok = false, Error = "NoProfile" }
	end

	local def = BaseConfig.Structures[structureId]
	if not def then
		return { Ok = false, Error = "UnknownStructure" }
	end

	local current = profile.BaseUpgrades[structureId] or 0
	if current >= def.MaxLevel then
		return { Ok = false, Error = "MaxLevel" }
	end

	local okReq, reqErr = meetsRequirements(profile, structureId)
	if not okReq then
		return { Ok = false, Error = reqErr }
	end

	local targetLevel = current + 1
	local cost = def.Costs[targetLevel]
	if not cost then
		return { Ok = false, Error = "NoCost" }
	end

	local spendOk, spendErr
	if def.Currency == "Gold" then
		spendOk, spendErr = EconomyService.SpendGold(player, cost, "upgrade_" .. structureId)
	else
		spendOk, spendErr = EconomyService.SpendCash(player, cost, "upgrade_" .. structureId)
	end
	if not spendOk then
		return { Ok = false, Error = spendErr or "SpendFailed" }
	end

	profile.BaseUpgrades[structureId] = targetLevel
	profile.Stats.UpgradesPurchased += 1
	DataService.MarkDirty(player)

	local firstUpgrade = profile.Stats.UpgradesPurchased == 1
	if AnalyticsService then
		AnalyticsService.Log("UPGRADE_PURCHASED", player.UserId, {
			structure = structureId,
			level = targetLevel,
			cost = cost,
		})
		if firstUpgrade then
			AnalyticsService.Log("FIRST_UPGRADE", player.UserId, { structure = structureId })
		end
	end

	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "PurchaseUpgrade", 1)
	end

	BaseService.PushState(player)
	BaseService.UpdateVisuals(player, structureId, targetLevel)

	-- v35: mid-game VIP soft offer on first structure L3+
	if targetLevel >= 3 and MonetizationService and MonetizationService.TrySoftOfferVIP then
		pcall(function()
			MonetizationService.TrySoftOfferVIP(player, "structure_l3")
		end)
	end

	getUpgradeChangedEvent():Fire(player.UserId, profile.BasePlotId, structureId, targetLevel)

	return {
		Ok = true,
		Error = nil,
		NewLevel = targetLevel,
		Cash = profile.Cash,
		Gold = profile.Gold,
	}
end

local function findUpgradeSlots(plotId: number, structureId: string): { BasePart }
	local found: { BasePart } = {}
	local seen: { [BasePart]: boolean } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
		if inst:IsA("BasePart") then
			local p = inst:GetAttribute("PlotId")
			local s = inst:GetAttribute("StructureId")
			if p == plotId and s == structureId then
				seen[inst] = true
				table.insert(found, inst)
			end
		end
	end
	-- Fallback: attribute scan under Bases (tags can lag / stale place files)
	if #found == 0 then
		local setup = Workspace:FindFirstChild("WarEmpireSetup")
		local bases = setup and setup:FindFirstChild("Bases")
		local plotFolder = bases and bases:FindFirstChild("Plot" .. tostring(plotId))
		if plotFolder then
			for _, desc in ipairs(plotFolder:GetDescendants()) do
				if desc:IsA("BasePart") and not seen[desc] then
					if desc:GetAttribute("StructureId") == structureId and desc:GetAttribute("PlotId") == plotId then
						CollectionService:AddTag(desc, Constants.Tags.UpgradeSlot)
						table.insert(found, desc)
					end
				end
			end
		end
	end
	return found
end

local showroomSpinConn: RBXScriptConnection? = nil

local function ensureShowroomSpin()
	if showroomSpinConn then
		return
	end
	local RunService = game:GetService("RunService")
	showroomSpinConn = RunService.Heartbeat:Connect(function(dt)
		for _, inst in ipairs(CollectionService:GetTagged("WE_UpgradeSlot")) do
			if inst:IsA("BasePart") then
				for _, child in ipairs(inst:GetChildren()) do
					if child:IsA("BasePart") and child:GetAttribute("WE_ShowroomSpin") == true and child.Transparency < 0.5 then
						child.CFrame = child.CFrame * CFrame.Angles(0, math.rad(22) * dt, 0)
					end
				end
			end
		end
	end)
end

local function syncUpgradePops(plinth: BasePart, structureId: string, lv: number)
	-- Clear prior pop folder
	local old = plinth:FindFirstChild("WE_UpgradePops")
	if old then
		old:Destroy()
	end
	if lv < 2 then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "WE_UpgradePops"
	folder.Parent = plinth

	local function popPart(name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.CFrame = plinth.CFrame * CFrame.new(offset)
		p.Parent = folder
		p:SetAttribute("WE_KitRole", name)
		return p
	end

	-- L2+: light + trim accent
	if lv >= 2 then
		popPart("UpgradeLight", Vector3.new(0.5, 0.5, 0.5), Vector3.new(2.6, 4.2, 2.2), Constants.Colors.GoldBright, Enum.Material.Neon, Enum.PartType.Ball)
		popPart("UpgradeTrim", Vector3.new(6.8, 0.14, 0.35), Vector3.new(0, 3.6, -2.7), Constants.Colors.GoldBright, Enum.Material.Neon, nil)
	end
	-- L4+: sandbag ring around plinth
	if lv >= 4 then
		local sand = Color3.fromRGB(130, 115, 80)
		for i = 0, 7 do
			local ang = (i / 8) * math.pi * 2
			local r = 5.2
			local ox = math.cos(ang) * r
			local oz = math.sin(ang) * r
			popPart("SandbagRing", Vector3.new(1.6, 0.9, 0.9), Vector3.new(ox, 0.7, oz), sand, Enum.Material.Sand, nil)
		end
	end
	-- L5: flag + floodlight
	if lv >= 5 then
		local pole = popPart("UpgradeFlag", Vector3.new(0.25, 7.5, 0.25), Vector3.new(-3.2, 4.2, 3.2), Color3.fromRGB(60, 60, 65), Enum.Material.Metal, nil)
		local cloth = popPart("UpgradeFlag", Vector3.new(2.4, 1.4, 0.12), Vector3.new(-2.0, 7.2, 3.2), Constants.Colors.GoldBright, Enum.Material.Fabric, nil)
		local flood = popPart("UpgradeFloodlight", Vector3.new(1.2, 0.4, 0.8), Vector3.new(3.0, 5.5, -2.5), Color3.fromRGB(220, 220, 200), Enum.Material.Metal, nil)
		local glow = Instance.new("PointLight")
		glow.Name = "FloodGlow"
		glow.Brightness = 2.2
		glow.Range = 28
		glow.Color = Color3.fromRGB(255, 245, 210)
		glow.Parent = flood
		pcall(function()
			local vas = require(script.Parent.VisualAssetService)
			if vas.TryAttachPropVisual then
				vas.TryAttachPropVisual(cloth, "Flag")
				vas.TryAttachPropVisual(flood, "Floodlight")
			end
		end)
	end
end

local function applyKitVisuals(plinth: BasePart, structureId: string, level: number)
	if not plinth or not plinth.Parent then
		return
	end
	-- Ensure Part-kit silhouette exists (spawn if bare plinth / stripped children)
	local okEnsure, ensureCountOrErr = pcall(StructureKitBuilder.EnsureKit, plinth, structureId)
	if not okEnsure then
		warn("[BaseService] EnsureKit failed", structureId, ensureCountOrErr)
	end

	local palette = StructureVisualConfig.Palettes[structureId]
	local baseSize = plinth:GetAttribute("BaseSize")
	if typeof(baseSize) ~= "Vector3" then
		baseSize = Vector3.new(8, 1.2, 8)
		plinth:SetAttribute("BaseSize", baseSize)
	end
	local bs = baseSize :: Vector3
	local lv = math.clamp(level, 0, 5)
	local t = lv / 5
	-- L0 = nearly invisible placeholder; L1+ solid "built" structure (spawn-on-buy feel)
	local ghost = math.max(StructureVisualConfig.GhostTransparency, 0.72)
	local solid = StructureVisualConfig.SolidTransparency
	local transparency = if lv == 0 then ghost else solid

	plinth.Size = Vector3.new(bs.X, bs.Y * (1 + t * 0.35), bs.Z)
	if palette then
		plinth.Color = palette.Plinth
	else
		plinth.Color = Color3.fromRGB(40 + math.floor(t * 40), 60 + math.floor(t * 80), 50)
	end
	-- Plinth stays walkable; keep slightly visible at L0 so pads remain findable
	plinth.Transparency = if lv == 0 then math.min(ghost, 0.45) else solid
	plinth.Material = Enum.Material.Concrete

	local bodyScale = 1 + lv * 0.55
	local accentScale = 1 + lv * 0.25

	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") then
			local role = child:GetAttribute("WE_KitRole")
			if role == "Body" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				child.Size = Vector3.new(b.X * (0.9 + t * 0.15), b.Y * bodyScale, b.Z * (0.9 + t * 0.15))
				if palette then
					child.Color = palette.Body
				end
				child.Transparency = transparency
				child.Material = Enum.Material.Metal
				child.CastShadow = lv > 0
			elseif role == "Accent" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				child.Size = Vector3.new(b.X * accentScale, b.Y, b.Z * accentScale)
				if palette then
					child.Color = palette.Accent
				end
				child.Transparency = if lv == 0 then 0.85 else 0.02
				child.Material = Enum.Material.Neon
			elseif role == "Roof" or role == "Antenna" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				local yBoost = if role == "Antenna" then 1 + lv * 0.8 else 1 + lv * 0.4
				child.Size = Vector3.new(b.X, b.Y * yBoost, b.Z)
				local off = child:GetAttribute("WE_LocalOffset")
				if typeof(off) == "Vector3" then
					local yExtra = if role == "Antenna" then lv * 0.9 else lv * 0.35
					child.CFrame = plinth.CFrame * CFrame.new((off :: Vector3) + Vector3.new(0, yExtra, 0))
				end
				if palette then
					child.Color = if role == "Antenna" then palette.Accent else palette.Roof
				end
				child.Transparency = transparency
				child.Material = Enum.Material.Metal -- Design: reject neon antenna accents
			elseif role == "DressHost" then
				-- Tier 2 interior/prop hosts: gunmetal, no neon wash
				child.Transparency = if lv == 0 then 0.95 else 0.72
				child.Color = Color3.fromRGB(55, 60, 58)
				child.Material = Enum.Material.Metal
				if child:GetAttribute("WE_GunmetalDesk") or string.find(child.Name, "CommandDesk", 1, true) then
					child.Transparency = if lv == 0 then 0.9 else 0.05
					child.Color = Color3.fromRGB(55, 60, 58)
				end
			elseif role == "Detail" or role == "Pier" or role == "Door" or role == "Window" then
				child.Transparency = if lv == 0 then 0.9 else math.max(0, 0.15 - t * 0.15)
				if palette then
					child.Color = if role == "Window" then Color3.fromRGB(80, 120, 150) else palette.Accent
				end
				if role == "Window" then
					child.Material = Enum.Material.Glass
				elseif role == "Door" or role == "Pier" then
					child.Material = Enum.Material.Metal
				end
			elseif role == "Podium" or role == "PodiumRing" or role == "ShowroomMesh" then
				-- VehicleDepot showroom — visible once depot built
				child.Transparency = if lv == 0 then 1 else 0.05
				if role == "PodiumRing" then
					child.Color = Constants.Colors.GoldBright
					child.Material = Enum.Material.Neon
				elseif role == "Podium" then
					child.Color = Constants.Colors.PlateDark
				end
			elseif role == "UpgradeLight" or role == "UpgradeTrim" then
				child.Transparency = if lv >= 2 then 0.05 else 1
			elseif role == "SandbagRing" then
				child.Transparency = if lv >= 4 then 0.05 else 1
			elseif role == "UpgradeFlag" or role == "UpgradeFloodlight" then
				child.Transparency = if lv >= 5 then 0.05 else 1
			end
		end
	end

	-- Upgrade pop extras (idempotent Part kits; never required for gameplay)
	syncUpgradePops(plinth, structureId, lv)

	-- Design P0: PreferMesh L1+ for all structure MeshAssetIds (Part kit always remains)
	local preferMesh = StructureVisualConfig.PreferMeshWhenAssetIdSet ~= false
	local meshMin = tonumber((StructureVisualConfig :: any).PreferMeshMinLevel) or 1
	if preferMesh and lv >= meshMin then
		pcall(function()
			local vas = require(script.Parent.VisualAssetService)
			vas.TryAttachBuildingVisual(plinth, structureId, lv)
			if structureId == "VehicleDepot" and vas.TryAttachShowroomVisual then
				vas.TryAttachShowroomVisual(plinth)
			end
			if vas.TryDressStructureInterior then
				vas.TryDressStructureInterior(plinth, structureId)
			end
		end)
	end

	-- L0 ghost → max: roof smoke plume at L5 (typed neon chimney)
	if lv >= 5 then
		local smokeHost = plinth:FindFirstChild("Roof")
		if smokeHost and smokeHost:IsA("BasePart") and not smokeHost:FindFirstChild("WE_MaxSmoke") then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "WE_MaxSmoke"
			emitter.Rate = 8
			emitter.Lifetime = NumberRange.new(1.2, 2.0)
			emitter.Speed = NumberRange.new(1.5, 3.0)
			emitter.SpreadAngle = Vector2.new(12, 12)
			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.4),
				NumberSequenceKeypoint.new(1, 1.6),
			})
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.4),
				NumberSequenceKeypoint.new(1, 1),
			})
			emitter.Color = ColorSequence.new(Color3.fromRGB(90, 95, 100))
			emitter.Parent = smokeHost
		end
	else
		local roof = plinth:FindFirstChild("Roof")
		if roof then
			local sm = roof:FindFirstChild("WE_MaxSmoke")
			if sm then
				sm:Destroy()
			end
		end
	end
end

function BaseService.UpdateVisuals(player: Player, structureId: string, level: number)
	ensureShowroomSpin()
	local profile = DataService.GetProfile(player)
	if not profile or not profile.BasePlotId then
		warn("[BaseService] UpdateVisuals skipped — no plot", player.Name, structureId)
		return
	end
	local plotId = profile.BasePlotId
	local slots = findUpgradeSlots(plotId, structureId)
	if #slots == 0 then
		warn("[BaseService] UpdateVisuals: no slot for", structureId, "plot", plotId)
	end
	for _, inst in ipairs(slots) do
		local okApply, errApply = pcall(applyKitVisuals, inst, structureId, level)
		if not okApply then
			warn("[BaseService] applyKitVisuals failed", structureId, errApply)
		end
	end

	-- Plot-scale fortifications (DefensiveWalls / Watchtowers / BaseCeiling)
	if structureId == "DefensiveWalls" then
		local okW, errW = pcall(StructureKitBuilder.SyncPerimeterWalls, plotId, level)
		if not okW then
			warn("[BaseService] SyncPerimeterWalls failed", errW)
		end
		-- Anti-heli Base Ceiling unlocks at DefensiveWalls ≥ L3
		local okC, errC = pcall(StructureKitBuilder.SyncBaseCeiling, plotId, level)
		if not okC then
			warn("[BaseService] SyncBaseCeiling failed", errC)
		end
	elseif structureId == "Watchtowers" then
		local okT, errT = pcall(StructureKitBuilder.SyncCornerTowers, plotId, level)
		if not okT then
			warn("[BaseService] SyncCornerTowers failed", errT)
		end
	end
end

function BaseService.RefreshAllVisuals(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	-- Apply every structure from profile (L0 = faint placeholder; L1+ spawn/solid kit)
	for structureId in pairs(BaseConfig.Structures) do
		local level = profile.BaseUpgrades[structureId] or 0
		BaseService.UpdateVisuals(player, structureId, level)
	end
	-- DefensiveWalls / Watchtowers / BaseCeiling extras also driven if present
	if profile.BasePlotId then
		local wallsLv = profile.BaseUpgrades.DefensiveWalls or 0
		pcall(StructureKitBuilder.SyncPerimeterWalls, profile.BasePlotId, wallsLv)
		pcall(StructureKitBuilder.SyncBaseCeiling, profile.BasePlotId, wallsLv)
		local towerLv = profile.BaseUpgrades.Watchtowers or 0
		pcall(StructureKitBuilder.SyncCornerTowers, profile.BasePlotId, towerLv)
	end
end

local function buildPlayerState(player: Player): Types.PlayerStatePayload?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	local LevelConfig = require(Shared.Configs.LevelConfig)
	return {
		Cash = profile.Cash,
		Gold = profile.Gold,
		PendingCash = tonumber((profile :: any).PendingCash) or 0,
		Level = profile.Level,
		XP = profile.XP,
		XPToNext = LevelConfig.GetXPRequiredForLevel(profile.Level),
		Prestige = profile.Prestige,
		Soldiers = profile.Soldiers,
		NationColorId = profile.NationColorId,
		TrainingIncomePerTick = (function()
			local SoldierConfig = require(Shared.Configs.SoldierConfig)
			local cfg = SoldierConfig.TrainingIncome
			if not cfg then
				return 0
			end
			local count = tonumber(profile.Soldiers) or 0
			if count < (cfg.MinSoldiersForIncome or 1) then
				return 0
			end
			local prestigeMult = 1 + ((tonumber(profile.Prestige) or 0) * 0.05)
			return math.floor(count * (cfg.CashPerSoldierPerTick or 0) * prestigeMult)
		end)(),
		Base = {
			PlotId = profile.BasePlotId,
			Upgrades = profile.BaseUpgrades,
			PassiveIncomePerTick = BaseService.ComputePassiveIncomePerTick(profile, player),
		},
		TutorialStep = profile.TutorialStep,
		TutorialComplete = profile.TutorialComplete,
		Vehicles = profile.Vehicles,
		Weapons = profile.Weapons,
		EquippedWeapon = profile.EquippedWeapon,
		DailyLogin = profile.DailyLogin,
		TerritoriesOwned = profile.Territories,
	}
end

function BaseService.GetPlayerState(player: Player): Types.PlayerStatePayload?
	return buildPlayerState(player)
end

function BaseService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	NotificationService = deps.NotificationService
	MonetizationService = deps.MonetizationService

	getUpgradeChangedEvent()

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseUpgrade) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, payload: any)
		if not RemoteGuard.RequireProfile(DataService, player) then
			print(string.format("[BaseService] Remote BUY no-profile %s", player.Name))
			return
		end
		if not RateLimitService.Allow(player, "purchase_upgrade", 6, 8) then
			print(string.format("[BaseService] Remote BUY rate-limit %s", player.Name))
			if NotificationService then
				NotificationService.Notify(player, "Buying too fast — wait a moment", "Warn", 2.5)
			end
			return
		end
		local structureId = if typeof(payload) == "table" then payload.StructureId else payload
		if not RemoteGuard.IsIdString(structureId, 48) then
			print(string.format("[BaseService] Remote BUY bad-id %s → %s", player.Name, tostring(structureId)))
			return
		end
		print(string.format("[BaseService] Remote BUY attempt %s → %s", player.Name, tostring(structureId)))
		local result = BaseService.PurchaseUpgrade(player, structureId)
		print(string.format("[BaseService] Remote BUY result %s → Ok=%s Err=%s", player.Name, tostring(result.Ok), tostring(result.Error)))
		if not NotificationService then
			warn("[BaseService] NotificationService nil — purchase toast skipped")
			return
		end
		if result.Ok then
			local def = BaseConfig.Structures[structureId]
			local name = if def then def.DisplayName else tostring(structureId)
			NotificationService.Notify(
				player,
				string.format("Purchase SUCCESSFUL! %s → Lv %d", name, result.NewLevel or 0),
				"Success",
				3.5
			)
		else
			local err = result.Error or "Failed"
			local msg = if err == "InsufficientCash"
				then "Not enough cash"
				elseif err == "InsufficientGold"
				then "Not enough gold"
				elseif err == "MaxLevel"
				then "Already at MAX level"
				elseif err == "MissingRequirement"
				then "Missing prerequisite structure"
				elseif err == "UnknownStructure" or err == "InvalidStructure"
				then "Unknown structure"
				else ("Purchase failed: " .. tostring(err))
			-- Debounce can't-afford / fail spam from menu + pad
			local key = "basebuy|" .. err .. "|" .. tostring(structureId)
			if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, msg, "Warn", 3.5, 0.9, key)
			else
				NotificationService.Notify(player, msg, "Warn", 3.5)
			end
		end
	end)

	local getStateFn = RemoteSetup.Get(Constants.RemoteNames.GetPlayerState) :: RemoteFunction
	getStateFn.OnServerInvoke = function(player: Player)
		if not RateLimitService.Allow(player, "get_state", 2, 4) then
			return nil
		end
		return buildPlayerState(player)
	end

	DataService.OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		BaseService.AssignPlot(player)
		-- ALWAYS teleport onto THEIR plot after character exists (retry inside TeleportToPlot)
		task.defer(function()
			BaseService.TeleportToPlot(player)
		end)
		task.delay(1.5, function()
			if player.Parent then
				BaseService.TeleportToPlot(player)
			end
		end)
		if TutorialService and TutorialService.Notify then
			TutorialService.Notify(player, "PlotAssigned")
		end
		BaseService.PushState(player)
		EconomyService.Push(player)
		if deps.XPService then
			deps.XPService.Push(player)
		end
		local stateRemote = RemoteSetup.Get(Constants.RemoteNames.PlayerStateUpdate) :: RemoteEvent
		local state = buildPlayerState(player)
		if state then
			stateRemote:FireClient(player, state)
		end
		-- Rehydrate structure kits + perimeter from profile (retry: map tags may lag)
		task.defer(function()
			BaseService.RefreshAllVisuals(player)
		end)
		task.delay(1.0, function()
			if player.Parent then
				BaseService.RefreshAllVisuals(player)
			end
		end)
		task.delay(3.0, function()
			if player.Parent then
				BaseService.RefreshAllVisuals(player)
			end
		end)
		if AnalyticsService then
			AnalyticsService.Log("PLAYER_JOIN", player.UserId, { plot = _profile.BasePlotId })
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if AnalyticsService then
			AnalyticsService.Log("PLAYER_LEAVE", player.UserId, {})
		end
		BaseService.ReleasePlot(player)
	end)

	-- Passive income loop
	task.spawn(function()
		local tickSeconds = EconomyConfig.PassiveIncome.TickSeconds
		if RunService:IsStudio() and DevConfig.FastPassiveIncome then
			tickSeconds = 1
		end
		while true do
			task.wait(tickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataService.GetProfile(player)
				if profile then
					local amount = BaseService.ComputePassiveIncomePerTick(profile, player)
					if amount > 0 then
						-- Accrue to Money Collector pending (not auto Cash)
						if EconomyService.AccruePendingCash then
							EconomyService.AccruePendingCash(player, amount, "passive")
						else
							EconomyService.AddCash(player, amount, "passive")
						end
					end
				end
			end
		end
	end)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">BattlePassService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Battle pass track — dense Free/Premium rewards from BattlePassConfig.
	Premium flag only via Monetization ProcessReceipt (PremiumPass) / admin grantpremium — never client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BattlePassConfig = require(Shared.Configs.BattlePassConfig)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local BattlePassService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function ensureSeason(profile: any)
	local seasonId = SeasonConfig.CurrentSeasonId or BattlePassConfig.SeasonId
	if typeof(profile.BattlePass) ~= "table" then
		profile.BattlePass = {
			SeasonId = seasonId,
			XP = 0,
			Level = 0,
			Premium = false,
			ClaimedFree = {},
			ClaimedPremium = {},
		}
		return
	end
	if profile.BattlePass.SeasonId ~= seasonId then
		profile.BattlePass = {
			SeasonId = seasonId,
			XP = 0,
			Level = 0,
			Premium = profile.BattlePass.Premium == true, -- keep premium entitlement across seasons (policy: soft)
			ClaimedFree = {},
			ClaimedPremium = {},
		}
	end
	if typeof(profile.BattlePass.ClaimedFree) ~= "table" then
		profile.BattlePass.ClaimedFree = {}
	end
	if typeof(profile.BattlePass.ClaimedPremium) ~= "table" then
		profile.BattlePass.ClaimedPremium = {}
	end
end

local function countClaimable(bp: any, track: { [number]: any }, claimedMap: any, requirePremium: boolean): number
	if requirePremium and not bp.Premium then
		return 0
	end
	local n = 0
	local level = tonumber(bp.Level) or 0
	for tier, _reward in pairs(track) do
		local t = tonumber(tier)
		if t and t >= 1 and t <= level and not claimedMap[tostring(t)] then
			n += 1
		end
	end
	return n
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	local remote = RemoteSetup.Get(Constants.RemoteNames.BattlePassStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		SeasonId = bp.SeasonId,
		XP = bp.XP,
		Level = bp.Level,
		XPPerLevel = BattlePassConfig.XPPerLevel,
		MaxLevel = BattlePassConfig.MaxLevel,
		Premium = bp.Premium == true,
		ClaimedFree = bp.ClaimedFree,
		ClaimedPremium = bp.ClaimedPremium,
		FreeTrack = BattlePassConfig.FreeTrack,
		PremiumTrack = BattlePassConfig.PremiumTrack,
		ClaimableFree = countClaimable(bp, BattlePassConfig.FreeTrack, bp.ClaimedFree, false),
		ClaimablePremium = countClaimable(bp, BattlePassConfig.PremiumTrack, bp.ClaimedPremium, true),
		PremiumProductId = BattlePassConfig.PremiumProductId,
	})
end

function BattlePassService.AddXP(player: Player, amount: number, _reason: string?)
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if bp.Level >= BattlePassConfig.MaxLevel then
		return
	end
	bp.XP += amount
	while bp.Level < BattlePassConfig.MaxLevel do
		local need = BattlePassConfig.XPPerLevel
		if bp.XP < need then
			break
		end
		bp.XP -= need
		bp.Level += 1
		if NotificationService then
			NotificationService.Notify(player, "Battle Pass level " .. tostring(bp.Level) .. "!", "Reward", 4)
		end
	end
	DataService.MarkDirty(player)
	pushState(player)
end

local function grantReward(player: Player, reward: any)
	if typeof(reward) ~= "table" then
		return
	end
	if typeof(reward.Cash) == "number" and reward.Cash > 0 then
		EconomyService.AddCash(player, reward.Cash, "battlepass")
	end
	if typeof(reward.Gold) == "number" and reward.Gold > 0 then
		EconomyService.AddGold(player, reward.Gold, "battlepass")
	end
end

function BattlePassService.Claim(player: Player, level: number, track: string): (boolean, string?)
	local maxLevel = BattlePassConfig.MaxLevel or 50
	local clamped = RemoteGuard.ClampPositiveInt(level, maxLevel)
	if not clamped then
		return false, "InvalidLevel"
	end
	level = clamped
	if track ~= "free" and track ~= "premium" then
		return false, "InvalidTrack"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if level < 1 or level > bp.Level then
		return false, "LevelNotReached"
	end
	local key = tostring(level)
	if track == "free" then
		local reward = BattlePassConfig.FreeTrack[level]
		if not reward then
			return false, "NoReward"
		end
		if bp.ClaimedFree[key] then
			return false, "AlreadyClaimed"
		end
		bp.ClaimedFree[key] = true
		grantReward(player, reward)
	else
		if not bp.Premium then
			return false, "PremiumRequired"
		end
		local reward = BattlePassConfig.PremiumTrack[level]
		if not reward then
			return false, "NoReward"
		end
		if bp.ClaimedPremium[key] then
			return false, "AlreadyClaimed"
		end
		bp.ClaimedPremium[key] = true
		grantReward(player, reward)
	end
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Battle Pass reward claimed (L" .. key .. " " .. track .. ")", "Reward")
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(AnalyticsConfig.Events.BATTLEPASS_CLAIM or "BATTLEPASS_CLAIM", player.UserId, { level = level, track = track })
	end
	return true, nil
end


function BattlePassService.ClaimAll(player: Player, track: string): (number, string?)
	if track ~= "free" and track ~= "premium" then
		return 0, "InvalidTrack"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0, "NoProfile"
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if track == "premium" and not bp.Premium then
		return 0, "PremiumRequired"
	end
	local trackTable = if track == "free" then BattlePassConfig.FreeTrack else BattlePassConfig.PremiumTrack
	local claimedMap = if track == "free" then bp.ClaimedFree else bp.ClaimedPremium
	local claimed = 0
	local tiers: { number } = {}
	for tier in pairs(trackTable) do
		local t = tonumber(tier)
		if t then
			table.insert(tiers, t)
		end
	end
	table.sort(tiers)
	for _, level in ipairs(tiers) do
		if level >= 1 and level <= bp.Level then
			local key = tostring(level)
			if not claimedMap[key] then
				local reward = trackTable[level]
				if reward then
					claimedMap[key] = true
					grantReward(player, reward)
					claimed += 1
					if AnalyticsService and AnalyticsService.Log then
						AnalyticsService.Log(AnalyticsConfig.Events.BATTLEPASS_CLAIM or "BATTLEPASS_CLAIM", player.UserId, { level = level, track = track, batch = true })
					end
				end
			end
		end
	end
	if claimed > 0 then
		DataService.MarkDirty(player)
		pushState(player)
	end
	return claimed, nil
end

function BattlePassService.SetPremium(player: Player, premium: boolean)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	profile.BattlePass.Premium = premium == true
	DataService.MarkDirty(player)
	pushState(player)
end

function BattlePassService.Push(player: Player)
	pushState(player)
end

function BattlePassService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local claimRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimBattlePassReward) :: RemoteEvent
	claimRemote.OnServerEvent:Connect(function(player: Player, level: any, track: any)
		if not RateLimitService.Allow(player, "bp_claim", 4, 8) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "bp_claim_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if typeof(track) ~= "string" or (track ~= "free" and track ~= "premium") then
			return
		end
		-- level 0 / "all" = claim every reachable unclaimed reward on that track
		if level == 0 or level == "all" then
			local n, err = BattlePassService.ClaimAll(player, track)
			if NotificationService then
				if n > 0 then
					NotificationService.Notify(player, string.format("Claimed %d %s battle pass rewards", n, track), "Reward")
				elseif err then
					NotificationService.Notify(player, "Cannot claim: " .. tostring(err), "Warn")
				else
					NotificationService.Notify(player, "No " .. track .. " rewards ready to claim", "Info")
				end
			end
			return
		end
		local ok, err = BattlePassService.Claim(player, level, track)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot claim: " .. tostring(err), "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		ensureSeason(profile)
		DataService.MarkDirty(player)
		pushState(player)
	end)
end

return BattlePassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">CaptureStipendService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic cash stipend for owned territories / coastal oil (Military Tycoon–style).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local CaptureStipendService = {}

local DataService: any = nil
local EconomyService: any = nil
local TerritoryService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil

local function stipendForDef(def: any): number
	local cfg = TerritoryConfig.CaptureStipend
	if typeof(def.StipendCash) == "number" then
		return def.StipendCash
	end
	if def.IsOilRig then
		return cfg.OilRigCash or 14000
	end
	if def.IsFortress then
		return cfg.FortressCash or 10000
	end
	return cfg.DefaultCash or 4000
end

local function payoutPlayer(player: Player)
	if not TerritoryService or not TerritoryService.GetRuntime then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local total = 0
	local count = 0
	local oilCount = 0
	local ot = TerritoryConfig.OwnerTypes
	for id, def in pairs(TerritoryConfig.Territories) do
		local rt = TerritoryService.GetRuntime(id)
		if rt then
			local owns = (rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId)
				or (rt.OwnerType == ot.Clan and profile.ClanId ~= nil and rt.ClanId == profile.ClanId)
			if owns then
				total += stipendForDef(def)
				count += 1
				if def.IsOilRig then
					oilCount += 1
				end
			end
		end
	end
	if total <= 0 then
		return
	end
	EconomyService.AddCash(player, total, "capture_stipend")
	if TerritoryConfig.CaptureStipend.NotifyOnPayout and NotificationService then
		local oilHint = if oilCount > 0 then string.format(" (%d oil)", oilCount) else ""
		NotificationService.Notify(
			player,
			string.format("Capture stipend +$%d from %d zones%s", total, count, oilHint),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.CAPTURE_STIPEND, player.UserId, {
			cash = total,
			zones = count,
			oil = oilCount,
		})
	end
end

function CaptureStipendService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	TerritoryService = deps.TerritoryService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService

	local tickSec = (TerritoryConfig.CaptureStipend and TerritoryConfig.CaptureStipend.TickSeconds) or 90
	task.spawn(function()
		while true do
			task.wait(tickSec)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(payoutPlayer, player)
			end
		end
	end)
end

return CaptureStipendService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">ClanService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clan roster — DataStore-backed records (name, owner, members) with in-memory cache.
	Graceful fallback when DataStore unavailable (Studio without API services):
	session-only roster + profile.ClanId still works for the session.
	TerritoryService stamps runtime.ClanId from profile.ClanId on capture.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ClanConfig = require(Shared.Configs.ClanConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local ClanService = {}

export type ClanRecord = {
	Id: string,
	Name: string,
	Tag: string,
	LeaderUserId: number,
	Members: { [string]: boolean }, -- keyed by tostring(userId) for DataStore JSON safety
	CreatedUnix: number,
}

local CLAN_STORE_NAME = "WarEmpire_Clans_v1"
local INDEX_KEY = "_clan_index_v1"

local DataService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil

local clans: { [string]: ClanRecord } = {}
local nextClanSerial = 1
local clanStore: DataStore? = nil
local dataStoreAvailable = false
local nameIndex: { [string]: string } = {} -- lower(name|tag) -> clanId (session + loaded)

local function getClanStore(): DataStore?
	if clanStore then
		return clanStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(CLAN_STORE_NAME)
	end)
	if ok then
		clanStore = result
		dataStoreAvailable = true
		return clanStore
	end
	dataStoreAvailable = false
	warn("[ClanService] DataStore unavailable (Studio without API services): session-only clans.", result)
	return nil
end

local function memberKey(userId: number): string
	return tostring(userId)
end

local function memberCount(clan: ClanRecord): number
	local n = 0
	for _ in pairs(clan.Members) do
		n += 1
	end
	return n
end

local function normalizeMembers(raw: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if typeof(raw) ~= "table" then
		return out
	end
	for k, v in pairs(raw) do
		if v == true then
			out[tostring(k)] = true
		end
	end
	return out
end

local function decodeClan(data: any): ClanRecord?
	if typeof(data) ~= "table" or typeof(data.Id) ~= "string" then
		return nil
	end
	if typeof(data.Name) ~= "string" or typeof(data.Tag) ~= "string" then
		return nil
	end
	local leader = tonumber(data.LeaderUserId)
	if not leader then
		return nil
	end
	return {
		Id = data.Id,
		Name = data.Name,
		Tag = data.Tag,
		LeaderUserId = leader,
		Members = normalizeMembers(data.Members),
		CreatedUnix = tonumber(data.CreatedUnix) or os.time(),
	}
end

local function encodeClan(clan: ClanRecord): { [string]: any }
	return {
		Id = clan.Id,
		Name = clan.Name,
		Tag = clan.Tag,
		LeaderUserId = clan.LeaderUserId,
		Members = clan.Members,
		CreatedUnix = clan.CreatedUnix,
	}
end

local function indexKeys(clan: ClanRecord)
	nameIndex["n:" .. string.lower(clan.Name)] = clan.Id
	nameIndex["t:" .. string.upper(clan.Tag)] = clan.Id
end

local function clearIndexKeys(clan: ClanRecord)
	local nKey = "n:" .. string.lower(clan.Name)
	local tKey = "t:" .. string.upper(clan.Tag)
	if nameIndex[nKey] == clan.Id then
		nameIndex[nKey] = nil
	end
	if nameIndex[tKey] == clan.Id then
		nameIndex[tKey] = nil
	end
end

local function persistClan(clan: ClanRecord): boolean
	local store = getClanStore()
	if not store then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(clan.Id, encodeClan(clan))
	end)
	if not ok then
		warn("[ClanService] persistClan failed:", clan.Id, err)
		return false
	end
	-- Best-effort index update (list of ids)
	pcall(function()
		store:UpdateAsync(INDEX_KEY, function(old)
			local list = if typeof(old) == "table" then old else {}
			local found = false
			for _, id in ipairs(list) do
				if id == clan.Id then
					found = true
					break
				end
			end
			if not found then
				table.insert(list, clan.Id)
			end
			return list
		end)
	end)
	return true
end

local function deleteClanPersist(clanId: string)
	local store = getClanStore()
	if not store then
		return
	end
	pcall(function()
		store:RemoveAsync(clanId)
	end)
	pcall(function()
		store:UpdateAsync(INDEX_KEY, function(old)
			if typeof(old) ~= "table" then
				return {}
			end
			local nextList = {}
			for _, id in ipairs(old) do
				if id ~= clanId then
					table.insert(nextList, id)
				end
			end
			return nextList
		end)
	end)
end

local function loadClanFromStore(clanId: string): ClanRecord?
	local store = getClanStore()
	if not store then
		return nil
	end
	local ok, data = pcall(function()
		return store:GetAsync(clanId)
	end)
	if not ok then
		warn("[ClanService] GetAsync failed:", clanId, data)
		return nil
	end
	local clan = decodeClan(data)
	if clan then
		clans[clan.Id] = clan
		indexKeys(clan)
	end
	return clan
end

local function ensureClanLoaded(clanId: string): ClanRecord?
	local existing = clans[clanId]
	if existing then
		return existing
	end
	return loadClanFromStore(clanId)
end

local function sanitizeName(name: string): string?
	if typeof(name) ~= "string" then
		return nil
	end
	local trimmed = string.gsub(name, "^%s*(.-)%s*$", "%1")
	trimmed = string.gsub(trimmed, "[^%w%s%-%_]", "")
	if #trimmed < ClanConfig.MinNameLength or #trimmed > ClanConfig.MaxNameLength then
		return nil
	end
	return trimmed
end

local function sanitizeTag(tag: string): string?
	if typeof(tag) ~= "string" then
		return nil
	end
	local trimmed = string.upper(string.gsub(tag, "%s+", ""))
	trimmed = string.gsub(trimmed, "[^%w]", "")
	if #trimmed < ClanConfig.MinTagLength or #trimmed > ClanConfig.MaxTagLength then
		return nil
	end
	return trimmed
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local clanId = profile.ClanId
	local clan = if clanId then ensureClanLoaded(clanId) else nil
	local remote = RemoteSetup.Get(Constants.RemoteNames.ClanStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		ClanId = clanId,
		Name = if clan then clan.Name else nil,
		Tag = if clan then clan.Tag else nil,
		LeaderUserId = if clan then clan.LeaderUserId else nil,
		MemberCount = if clan then memberCount(clan) else 0,
		Persisted = dataStoreAvailable,
	})
end

function ClanService.GetClanId(player: Player): string?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	return profile.ClanId
end

function ClanService.GetClan(clanId: string): ClanRecord?
	return ensureClanLoaded(clanId)
end

function ClanService.IsDataStoreAvailable(): boolean
	return dataStoreAvailable
end

function ClanService.CreateClan(leader: Player, name: string, tag: string?): (boolean, string?)
	local profile = DataService.GetProfile(leader)
	if not profile then
		return false, "NoProfile"
	end
	if profile.ClanId then
		return false, "AlreadyInClan"
	end
	local cleanName = sanitizeName(name)
	if not cleanName then
		return false, "InvalidName"
	end
	local cleanTag = sanitizeTag(tag or string.sub(cleanName, 1, ClanConfig.MaxTagLength))
	if not cleanTag then
		return false, "InvalidTag"
	end

	-- Session uniqueness
	if nameIndex["n:" .. string.lower(cleanName)] or nameIndex["t:" .. string.upper(cleanTag)] then
		return false, "NameOrTagTaken"
	end
	for _, clan in pairs(clans) do
		if string.lower(clan.Name) == string.lower(cleanName) or clan.Tag == cleanTag then
			return false, "NameOrTagTaken"
		end
	end

	local clanId = string.format("clan_%d_%d", leader.UserId, nextClanSerial)
	nextClanSerial += 1
	local record: ClanRecord = {
		Id = clanId,
		Name = cleanName,
		Tag = cleanTag,
		LeaderUserId = leader.UserId,
		Members = { [memberKey(leader.UserId)] = true },
		CreatedUnix = os.time(),
	}
	clans[clanId] = record
	indexKeys(record)
	persistClan(record)

	profile.ClanId = clanId
	DataService.MarkDirty(leader)
	pushState(leader)

	if NotificationService then
		local suffix = if dataStoreAvailable then "" else " (session-only — enable API Services)"
		NotificationService.Notify(leader, "Clan created: [" .. cleanTag .. "] " .. cleanName .. suffix, "Success")
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log("CLAN_CREATE", leader.UserId, {
			clanId = clanId,
			name = cleanName,
			persisted = dataStoreAvailable,
		})
	end
	return true, nil
end

function ClanService.JoinClan(player: Player, clanId: string): (boolean, string?)
	if not RemoteGuard.IsIdString(clanId) then
		return false, "InvalidClanId"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.ClanId then
		return false, "AlreadyInClan"
	end
	local clan = ensureClanLoaded(clanId)
	if not clan then
		return false, "ClanNotFound"
	end
	if memberCount(clan) >= ClanConfig.MaxMembers then
		return false, "ClanFull"
	end
	clan.Members[memberKey(player.UserId)] = true
	persistClan(clan)
	profile.ClanId = clanId
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Joined clan [" .. clan.Tag .. "] " .. clan.Name, "Success")
	end
	return true, nil
end

function ClanService.LeaveClan(player: Player): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local clanId = profile.ClanId
	if not clanId then
		return false, "NotInClan"
	end
	local clan = ensureClanLoaded(clanId)
	profile.ClanId = nil
	DataService.MarkDirty(player)
	if clan then
		clan.Members[memberKey(player.UserId)] = nil
		if clan.LeaderUserId == player.UserId then
			local newLeader: number? = nil
			for uidStr in pairs(clan.Members) do
				newLeader = tonumber(uidStr)
				break
			end
			if newLeader then
				clan.LeaderUserId = newLeader
				persistClan(clan)
			else
				clearIndexKeys(clan)
				clans[clanId] = nil
				deleteClanPersist(clanId)
			end
		else
			persistClan(clan)
		end
	end
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Left clan.", "Info")
	end
	return true, nil
end

function ClanService.Push(player: Player)
	pushState(player)
end

function ClanService.Init(deps: { [string]: any })
	DataService = deps.DataService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService

	getClanStore() -- probe availability once at boot

	local createRemote = RemoteSetup.Get(Constants.RemoteNames.RequestCreateClan) :: RemoteEvent
	createRemote.OnServerEvent:Connect(function(player: Player, name: any, tag: any)
		if not RateLimitService.Allow(player, "clan_create", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsIdString(name, 32) then
			return
		end
		local tagArg = if RemoteGuard.IsIdString(tag, 8) then tag :: string else nil
		local ok, err = ClanService.CreateClan(player, name :: string, tagArg)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot create clan: " .. tostring(err), "Warn")
		end
	end)

	local joinRemote = RemoteSetup.Get(Constants.RemoteNames.RequestJoinClan) :: RemoteEvent
	joinRemote.OnServerEvent:Connect(function(player: Player, clanId: any)
		if not RateLimitService.Allow(player, "clan_join", 2, 3) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsIdString(clanId) then
			return
		end
		local ok, err = ClanService.JoinClan(player, clanId :: string)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot join clan: " .. tostring(err), "Warn")
		end
	end)

	local leaveRemote = RemoteSetup.Get(Constants.RemoteNames.RequestLeaveClan) :: RemoteEvent
	leaveRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "clan_leave", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		ClanService.LeaveClan(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.ClanId) == "string" and profile.ClanId ~= "" then
			local existing = ensureClanLoaded(profile.ClanId)
			if existing then
				existing.Members[memberKey(player.UserId)] = true
				-- Soft-heal membership if they were missing from roster (e.g. crash mid-join)
				persistClan(existing)
			else
				-- Soft rehydrate stub so territory ClanId stamp still works this session
				local stub: ClanRecord = {
					Id = profile.ClanId,
					Name = "Clan " .. string.sub(profile.ClanId, -4),
					Tag = "CLAN",
					LeaderUserId = player.UserId,
					Members = { [memberKey(player.UserId)] = true },
					CreatedUnix = os.time(),
				}
				clans[profile.ClanId] = stub
				indexKeys(stub)
				if dataStoreAvailable then
					persistClan(stub)
				end
			end
		end
		pushState(player)
	end)

	-- Keep member online flag in session; do not remove from persisted roster on leave server
	Players.PlayerRemoving:Connect(function(_player)
		-- Membership persists across sessions via DataStore / profile.ClanId
	end)
end

return ClanService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">ClanWarService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clan war — declare, score, settle with rewards + scoreboard.
	Declare is server-validated; scores only mutate on server events.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ClanWarConfig = require(Shared.Configs.ClanWarConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local ClanWarService = {}

export type WarRecord = {
	Id: string,
	AttackerClanId: string,
	DefenderClanId: string,
	AttackerName: string?,
	DefenderName: string?,
	StartUnix: number,
	EndUnix: number,
	AttackerScore: number,
	DefenderScore: number,
	Active: boolean,
	Settled: boolean,
	WinnerClanId: string?,
}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local ClanService: any = nil
local AntiExploitService: any = nil

local wars: { [string]: WarRecord } = {}
local clanActiveWar: { [string]: string } = {}
local globalScores: { [string]: number } = {}
local declareCooldownUntil: { [string]: number } = {} -- clanId -> unix
local nextWarSerial = 1

local function memberCount(clan: any): number
	local n = 0
	if typeof(clan) == "table" and typeof(clan.Members) == "table" then
		for _ in pairs(clan.Members) do
			n += 1
		end
	end
	return n
end

local function leaderUserId(clan: any): number?
	if typeof(clan) ~= "table" then
		return nil
	end
	return clan.LeaderUserId or clan.OwnerUserId
end

local function clanDisplayName(clanId: string): string
	if ClanService and ClanService.GetClan then
		local clan = ClanService.GetClan(clanId)
		if clan and typeof(clan.Name) == "string" then
			local tag = if typeof(clan.Tag) == "string" then clan.Tag else "?"
			return string.format("[%s] %s", tag, clan.Name)
		end
	end
	return clanId
end

local function topScoreboard(): { { ClanId: string, Score: number, Name: string } }
	local list: { { ClanId: string, Score: number, Name: string } } = {}
	for clanId, score in pairs(globalScores) do
		table.insert(list, {
			ClanId = clanId,
			Score = score,
			Name = clanDisplayName(clanId),
		})
	end
	table.sort(list, function(a, b)
		if a.Score == b.Score then
			return a.ClanId < b.ClanId
		end
		return a.Score > b.Score
	end)
	local topN = ClanWarConfig.ScoreboardTopN or 8
	local out = {}
	for i = 1, math.min(topN, #list) do
		table.insert(out, list[i])
	end
	return out
end

local function notifyClan(clanId: string, message: string, kind: string)
	if not NotificationService then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == clanId then
			NotificationService.Notify(player, message, kind)
		end
	end
end

local function pushWar(player: Player, war: WarRecord?)
	local remote = RemoteSetup.Get(Constants.RemoteNames.ClanWarStateUpdate) :: RemoteEvent
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	local cooldownLeft = 0
	if clanId and declareCooldownUntil[clanId] then
		cooldownLeft = math.max(0, declareCooldownUntil[clanId] - os.time())
	end
	remote:FireClient(player, {
		War = war,
		MyClanId = clanId,
		GlobalScores = globalScores,
		Scoreboard = topScoreboard(),
		GlobalWarEnabled = ClanWarConfig.GlobalWarEnabled == true,
		GlobalWarSeasonKey = ClanWarConfig.GlobalWarSeasonKey,
		DeclareCooldownLeft = cooldownLeft,
		MinMembers = ClanWarConfig.MinClanMembersToDeclare or 2,
		WarDurationSeconds = ClanWarConfig.WarDurationSeconds or 3600,
		Rewards = {
			WinCash = ClanWarConfig.WinningClanCashReward or 0,
			WinGold = ClanWarConfig.WinningClanGoldReward or 0,
			PartCash = ClanWarConfig.ParticipationCashReward or 0,
			PartGold = ClanWarConfig.ParticipationGoldReward or 0,
			ScoreBonusCashPerPoint = ClanWarConfig.ScoreBonusCashPerPoint or 0,
		},
	})
end

local function broadcastWar(war: WarRecord)
	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == war.AttackerClanId or cid == war.DefenderClanId then
			pushWar(player, war)
		end
	end
end

local function broadcastAll()
	for _, player in ipairs(Players:GetPlayers()) do
		local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		local war: WarRecord? = nil
		if clanId and clanActiveWar[clanId] then
			war = wars[clanActiveWar[clanId]]
		end
		pushWar(player, war)
	end
end

local function settleWar(war: WarRecord)
	if war.Settled then
		return
	end
	war.Settled = true
	war.Active = false
	clanActiveWar[war.AttackerClanId] = nil
	clanActiveWar[war.DefenderClanId] = nil

	local cooldown = ClanWarConfig.DeclareCooldownSeconds or 300
	local untilUnix = os.time() + cooldown
	declareCooldownUntil[war.AttackerClanId] = untilUnix
	declareCooldownUntil[war.DefenderClanId] = untilUnix

	local winner: string? = nil
	if war.AttackerScore > war.DefenderScore then
		winner = war.AttackerClanId
	elseif war.DefenderScore > war.AttackerScore then
		winner = war.DefenderClanId
	end
	war.WinnerClanId = winner

	local winCash = ClanWarConfig.WinningClanCashReward or 0
	local winGold = ClanWarConfig.WinningClanGoldReward or 0
	local partCash = ClanWarConfig.ParticipationCashReward or 0
	local partGold = ClanWarConfig.ParticipationGoldReward or 0
	local scoreBonus = ClanWarConfig.ScoreBonusCashPerPoint or 0

	local attackerName = war.AttackerName or clanDisplayName(war.AttackerClanId)
	local defenderName = war.DefenderName or clanDisplayName(war.DefenderClanId)
	local scoreLine = string.format("%s %d – %d %s", attackerName, war.AttackerScore, war.DefenderScore, defenderName)

	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == winner then
			local bonus = 0
			if scoreBonus > 0 then
				local myScore = if cid == war.AttackerClanId then war.AttackerScore else war.DefenderScore
				bonus = math.floor(myScore * scoreBonus)
			end
			if winCash + bonus > 0 then
				EconomyService.AddCash(player, winCash + bonus, "clan_war_win")
			end
			if winGold > 0 then
				EconomyService.AddGold(player, winGold, "clan_war_win")
			end
			if NotificationService then
				NotificationService.Notify(
					player,
					string.format("Clan war VICTORY! %s  (+$%d%s)", scoreLine, winCash + bonus, if winGold > 0 then string.format(" +%dG", winGold) else ""),
					"Reward"
				)
			end
		elseif cid == war.AttackerClanId or cid == war.DefenderClanId then
			if partCash > 0 then
				EconomyService.AddCash(player, partCash, "clan_war_participate")
			end
			if partGold > 0 then
				EconomyService.AddGold(player, partGold, "clan_war_participate")
			end
			local resultWord = if winner then "defeat" else "draw"
			if NotificationService then
				NotificationService.Notify(
					player,
					string.format("Clan war %s — %s  (+$%d participation)", resultWord, scoreLine, partCash),
					"Info"
				)
			end
		end
		pushWar(player, war)
	end

	local eventName = if AnalyticsConfig.Events.CLAN_WAR_SETTLE then AnalyticsConfig.Events.CLAN_WAR_SETTLE else "CLAN_WAR_SETTLE"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, 0, {
			warId = war.Id,
			winner = winner,
			attackerScore = war.AttackerScore,
			defenderScore = war.DefenderScore,
		})
	end
end

function ClanWarService.AddScore(clanId: string, points: number, _reason: string?)
	if typeof(clanId) ~= "string" or clanId == "" then
		return
	end
	points = math.floor(tonumber(points) or 0)
	if points == 0 then
		return
	end
	if ClanWarConfig.GlobalWarEnabled then
		globalScores[clanId] = (globalScores[clanId] or 0) + points
	end
	local warId = clanActiveWar[clanId]
	if warId then
		local war = wars[warId]
		if war and war.Active then
			if clanId == war.AttackerClanId then
				war.AttackerScore += points
			elseif clanId == war.DefenderClanId then
				war.DefenderScore += points
			end
			if os.time() >= war.EndUnix then
				settleWar(war)
			else
				broadcastWar(war)
			end
		end
	end
end

function ClanWarService.OnTerritoryCaptured(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	if clanId then
		ClanWarService.AddScore(clanId, ClanWarConfig.ScorePerTerritoryCapture or 10, "territory")
	end
end

function ClanWarService.OnEnemyKill(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	if clanId then
		ClanWarService.AddScore(clanId, ClanWarConfig.ScorePerEnemyKill or 1, "kill")
	end
end

function ClanWarService.DeclareWar(player: Player, defenderClanId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(defenderClanId) then
		return false, "InvalidDefender"
	end
	if not RemoteGuard.RequireProfile(DataService, player) then
		return false, "NoProfile"
	end
	if not ClanService then
		return false, "ClanServiceMissing"
	end
	local attackerClanId = ClanService.GetClanId(player)
	if not attackerClanId then
		return false, "NotInClan"
	end
	if attackerClanId == defenderClanId then
		return false, "CannotWarSelf"
	end
	local now = os.time()
	if declareCooldownUntil[attackerClanId] and now < declareCooldownUntil[attackerClanId] then
		return false, "DeclareCooldown"
	end
	local attackerClan = ClanService.GetClan(attackerClanId)
	local defenderClan = ClanService.GetClan(defenderClanId)
	if not attackerClan or not defenderClan then
		return false, "ClanNotFound"
	end
	if leaderUserId(attackerClan) ~= player.UserId then
		return false, "LeaderOnly"
	end
	local minMembers = ClanWarConfig.MinClanMembersToDeclare or 2
	if memberCount(attackerClan) < minMembers or memberCount(defenderClan) < minMembers then
		return false, "NotEnoughMembers"
	end
	if clanActiveWar[attackerClanId] or clanActiveWar[defenderClanId] then
		return false, "AlreadyAtWar"
	end

	local warId = string.format("war_%d_%d", now, nextWarSerial)
	nextWarSerial += 1
	local war: WarRecord = {
		Id = warId,
		AttackerClanId = attackerClanId,
		DefenderClanId = defenderClanId,
		AttackerName = clanDisplayName(attackerClanId),
		DefenderName = clanDisplayName(defenderClanId),
		StartUnix = now,
		EndUnix = now + (ClanWarConfig.WarDurationSeconds or 3600),
		AttackerScore = 0,
		DefenderScore = 0,
		Active = true,
		Settled = false,
		WinnerClanId = nil,
	}
	wars[warId] = war
	clanActiveWar[attackerClanId] = warId
	clanActiveWar[defenderClanId] = warId
	broadcastWar(war)
	-- Also refresh scoreboard for everyone
	broadcastAll()

	local declareMsg = string.format(
		"WAR DECLARED: %s vs %s (%dm)",
		war.AttackerName or attackerClanId,
		war.DefenderName or defenderClanId,
		math.floor((ClanWarConfig.WarDurationSeconds or 3600) / 60)
	)
	notifyClan(attackerClanId, declareMsg, "Success")
	notifyClan(defenderClanId, declareMsg .. " — DEFEND!", "Warn")

	local eventName = if AnalyticsConfig.Events.CLAN_WAR_DECLARE then AnalyticsConfig.Events.CLAN_WAR_DECLARE else "CLAN_WAR_DECLARE"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, {
			warId = warId,
			attacker = attackerClanId,
			defender = defenderClanId,
		})
	end
	return true, nil
end

function ClanWarService.Push(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	local war: WarRecord? = nil
	if clanId and clanActiveWar[clanId] then
		war = wars[clanActiveWar[clanId]]
	end
	pushWar(player, war)
end

function ClanWarService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	ClanService = deps.ClanService
	AntiExploitService = deps.AntiExploitService

	local declareRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDeclareClanWar) :: RemoteEvent
	declareRemote.OnServerEvent:Connect(function(player: Player, defenderClanId: any)
		if not RateLimitService.Allow(player, "clan_war_declare", 1, 1) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "clan_war_declare_rate")
			end
			return
		end
		local ok, err = ClanWarService.DeclareWar(player, defenderClanId)
		if not ok and NotificationService then
			local msg = "Cannot declare war: " .. tostring(err)
			if err == "DeclareCooldown" then
				local cid = if ClanService then ClanService.GetClanId(player) else nil
				local left = if cid and declareCooldownUntil[cid] then math.max(0, declareCooldownUntil[cid] - os.time()) else 0
				msg = string.format("War declare cooldown: %ds remaining", left)
			elseif err == "NotEnoughMembers" then
				msg = string.format("Both clans need ≥%d members to war", ClanWarConfig.MinClanMembersToDeclare or 2)
			elseif err == "LeaderOnly" then
				msg = "Only the clan leader can declare war"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		ClanWarService.Push(player)
	end)

	task.spawn(function()
		while true do
			task.wait(15)
			if next(wars) ~= nil then
				local now = os.time()
				for _, war in pairs(wars) do
					if war.Active and not war.Settled and now >= war.EndUnix then
						settleWar(war)
					end
				end
			end
		end
	end)
end

return ClanWarService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">CodesService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Promo code redemption — once per code per player. Server-validated Cash/Gold grants.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local CodesConfig = require(Shared.Configs.CodesConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local CodesService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function normalize(code: string): string
	local s = string.upper(string.gsub(code, "%s+", ""))
	return s
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.RedeemedCodes) ~= "table" then
		profile.RedeemedCodes = {}
	end
	local redeemed: { string } = {}
	for id in pairs(profile.RedeemedCodes) do
		table.insert(redeemed, id)
	end
	table.sort(redeemed)
	local remote = RemoteSetup.Get(Constants.RemoteNames.CodeStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Redeemed = redeemed,
		AvailableHints = { "WARFOUNDING", "BUILDCONQUER" },
	})
end

function CodesService.Redeem(player: Player, rawCode: any): (boolean, string?)
	if not RemoteGuard.IsIdString(rawCode, CodesConfig.MaxCodeLength or 32) then
		return false, "InvalidCode"
	end
	local code = normalize(rawCode :: string)
	local def = CodesConfig.Codes[code]
	if not def then
		return false, "UnknownCode"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if typeof(profile.RedeemedCodes) ~= "table" then
		profile.RedeemedCodes = {}
	end
	if profile.RedeemedCodes[code] then
		return false, "AlreadyRedeemed"
	end

	profile.RedeemedCodes[code] = true
	DataService.MarkDirty(player)

	local cash = tonumber(def.Cash) or 0
	local gold = tonumber(def.Gold) or 0
	if cash > 0 then
		EconomyService.AddCash(player, cash, "code")
	end
	if gold > 0 then
		EconomyService.AddGold(player, gold, "code")
	end

	if NotificationService then
		local name = def.DisplayName or code
		NotificationService.Notify(
			player,
			string.format("Code %s: +$%d · +%d Gold", name, cash, gold),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.CODE_REDEEM, player.UserId, {
			code = code,
			cash = cash,
			gold = gold,
		})
	end
	pushState(player)
	return true, nil
end

function CodesService.Push(player: Player)
	pushState(player)
end

function CodesService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestRedeemCode) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player, code: any)
		if not RateLimitService.Allow(player, "redeem_code", 1, 3) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "redeem_code_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = CodesService.Redeem(player, code)
		if not ok and NotificationService then
			local msg = "Code failed"
			if err == "AlreadyRedeemed" then
				msg = "Code already redeemed"
			elseif err == "UnknownCode" then
				msg = "Unknown code"
			elseif err == "InvalidCode" then
				msg = "Invalid code"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.RedeemedCodes) ~= "table" then
			profile.RedeemedCodes = {}
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)
end

return CodesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 3 — Server-authoritative combat.
	Clients request fire/reload/equip/purchase; server validates and applies WeaponConfig damage.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local CombatConfig = require(Shared.Configs.CombatConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local CombatDamage = require(script.CombatDamage)
local CombatNPC = require(script.CombatNPC)
local CombatWeaponLogic = require(script.CombatWeaponLogic)
local VisualAssetService = require(script.Parent.VisualAssetService)

-- Cached CollectionService:GetTagged results (invalidated on TTL)
local _tagCache: { [string]: { at: number, list: { Instance } } } = {}
local TAG_CACHE_TTL = 2.0
local function getTaggedCached(tag: string): { Instance }
	local now = os.clock()
	local entry = _tagCache[tag]
	if entry and (now - entry.at) < TAG_CACHE_TTL then
		return entry.list
	end
	local list = CollectionService:GetTagged(tag)
	_tagCache[tag] = { at = now, list = list }
	return list
end

type WeaponDef = WeaponConfig.WeaponDef
type NPCTypeDef = CombatConfig.NPCTypeDef
type PlayerProfile = Types.PlayerProfile

type CombatState = {
	WeaponId: string,
	Ammo: number,
	ReloadingUntil: number,
	LastFireAt: number,
	InvulnerableUntil: number,
	Alive: boolean,
	FirstPvpLogged: boolean,
}

type NPCRecord = {
	Id: string,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	TypeId: string,
	Def: NPCTypeDef,
	LastFireAt: number,
	SpawnCFrame: CFrame,
	Alive: boolean,
}

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local CombatService = {}

local DataService: any = nil
local EconomyService: any = nil
local XPService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local AntiExploitService: any = nil
local NotificationService: any = nil
local GateDefenseService: any = nil
local MonetizationConfig: any = nil
local RemoteSetup: any = nil
local MissionService: any = nil
local TerritoryService: any = nil

local combatStates: { [number]: CombatState } = {}
local npcRecords: { [string]: NPCRecord } = {}
local npcFolder: Folder? = nil
local npcSerial = 1
local firstPvpLogged: { [number]: boolean } = {}

local function clock(): number
	return os.clock()
end

local function weaponDef(id: string): WeaponDef?
	return CombatWeaponLogic.WeaponDef(id)
end

local function ensureStarter(profile: PlayerProfile)
	CombatWeaponLogic.EnsureStarter(profile)
end

local function owns(profile: PlayerProfile, weaponId: string): boolean
	return CombatWeaponLogic.Owns(profile, weaponId)
end

local function characterParts(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return character, humanoid, root
end

local function pushState(player: Player)
	local state = combatStates[player.UserId]
	local _, humanoid = characterParts(player)
	local weaponId = if state then state.WeaponId else nil
	local def = if weaponId then weaponDef(weaponId) else nil
	local payload: Types.CombatStatePayload = {
		Health = if humanoid then humanoid.Health else 0,
		MaxHealth = if humanoid then humanoid.MaxHealth else CombatConfig.PlayerMaxHealth,
		WeaponId = weaponId,
		Ammo = if state then state.Ammo else 0,
		MagazineSize = if def then def.MagazineSize else 0,
		Reloading = if state then clock() < state.ReloadingUntil else false,
		Alive = if state then state.Alive else (humanoid ~= nil and humanoid.Health > 0),
	}
	local remote = RemoteSetup.Get(Constants.RemoteNames.CombatStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

local function hitFeedback(player: Player, payload: Types.CombatHitFeedbackPayload)
	local remote = RemoteSetup.Get(Constants.RemoteNames.CombatHitFeedback) :: RemoteEvent
	remote:FireClient(player, payload)
end

local function getState(player: Player): CombatState?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	ensureStarter(profile)
	local existing = combatStates[player.UserId]
	if existing then
		return existing
	end
	local weaponId = profile.EquippedWeapon or WeaponConfig.DefaultWeapon
	local def = weaponDef(weaponId)
	local state: CombatState = {
		WeaponId = weaponId,
		Ammo = if def then def.MagazineSize else 30,
		ReloadingUntil = 0,
		LastFireAt = 0,
		InvulnerableUntil = 0,
		Alive = true,
		FirstPvpLogged = firstPvpLogged[player.UserId] == true,
	}
	combatStates[player.UserId] = state
	return state
end

local function damageFor(def: WeaponDef, attacker: Player?): number
	return CombatDamage.DamageFor(def, attacker)
end

local function tagCreator(humanoid: Humanoid, attacker: Player)
	CombatDamage.TagCreator(humanoid, attacker)
end

local function raycast(origin: Vector3, direction: Vector3, range: number, ignore: { Instance }): RaycastResult?
	return CombatDamage.Raycast(origin, direction, range, ignore)
end

function CombatService.GetPlotSpawnCFrame(plotId: number): CFrame?
	for _, inst in ipairs(getTaggedCached(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			local folder = inst.Parent
			if folder then
				local spawn = folder:FindFirstChild("PlayerSpawn")
				if spawn and spawn:IsA("BasePart") then
					return spawn.CFrame + Vector3.new(0, 3, 0)
				end
			end
			return inst.CFrame + Vector3.new(0, 5, 55)
		end
	end
	local pos = BaseConfig.PlotPositions[plotId]
	if pos then
		return CFrame.new(pos + Vector3.new(0, 5, 55))
	end
	return nil
end

function CombatService.TeleportToBase(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile or not profile.BasePlotId then
		return
	end
	local cf = CombatService.GetPlotSpawnCFrame(profile.BasePlotId)
	local character = player.Character
	if cf and character then
		character:PivotTo(cf)
	end
end

local function markFirstPvp(attacker: Player)
	if firstPvpLogged[attacker.UserId] then
		local state = combatStates[attacker.UserId]
		if state then
			state.FirstPvpLogged = true
		end
		return
	end
	firstPvpLogged[attacker.UserId] = true
	local state = combatStates[attacker.UserId]
	if state then
		state.FirstPvpLogged = true
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.FIRST_PVP, attacker.UserId, {})
	end
end

local function grantRewards(attacker: Player, cash: number, xp: number, reason: string)
	if cash > 0 then
		EconomyService.AddCash(attacker, cash, reason)
	end
	if xp > 0 then
		XPService.AddXP(attacker, xp, reason)
	end
end

function CombatService.RegisterPlayerKill(attacker: Player, victim: Player)
	local profile = DataService.GetProfile(attacker)
	if profile then
		profile.Stats.Kills += 1
		DataService.MarkDirty(attacker)
	end
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(attacker, "KillPlayer", 1)
	end
	local vProfile = DataService.GetProfile(victim)
	if vProfile then
		vProfile.Stats.Deaths += 1
		DataService.MarkDirty(victim)
	end
	markFirstPvp(attacker)
	grantRewards(attacker, CombatConfig.PlayerKill.Cash, CombatConfig.PlayerKill.XP, "pvp_kill")
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.PLAYER_KILL, attacker.UserId, {
			victim = victim.UserId,
			cash = CombatConfig.PlayerKill.Cash,
			xp = CombatConfig.PlayerKill.XP,
		})
	end
	if NotificationService then
		NotificationService.Notify(
			attacker,
			string.format("Eliminated %s (+$%d)", victim.DisplayName, CombatConfig.PlayerKill.Cash),
			"Reward"
		)
	end
end

local function damagePlayer(attacker: Player, victim: Player, damage: number, weaponId: string): boolean
	if not GameConfig.PvPEnabled then
		return false
	end
	if attacker == victim and not GameConfig.FriendlyFire then
		return false
	end
	local vState = combatStates[victim.UserId]
	if vState and clock() < vState.InvulnerableUntil then
		return false
	end
	local _, humanoid = characterParts(victim)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	tagCreator(humanoid, attacker)
	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	local dealt = math.max(0, before - humanoid.Health)
	if dealt <= 0 then
		return false
	end
	local killed = humanoid.Health <= 0
	hitFeedback(attacker, {
		Kind = if killed then "Kill" else "Hit",
		Damage = dealt,
		TargetName = victim.DisplayName,
		WeaponId = weaponId,
		IsHeadshot = false,
	})
	hitFeedback(victim, {
		Kind = if killed then "Death" else "Damaged",
		Damage = dealt,
		WeaponId = weaponId,
	})
	pushState(victim)
	return true
end

local function ensureNPCFolder(): Folder
	if npcFolder and npcFolder.Parent then
		return npcFolder
	end
	local existing = Workspace:FindFirstChild("WarEmpireNPCs")
	if existing and existing:IsA("Folder") then
		npcFolder = existing
		return npcFolder
	end
	local folder = Instance.new("Folder")
	folder.Name = "WarEmpireNPCs"
	folder.Parent = Workspace
	npcFolder = folder
	return folder
end

local function aliveNPCCount(): number
	local n = 0
	for _, rec in pairs(npcRecords) do
		if rec.Alive then
			n += 1
		end
	end
	return n
end

local function destroyNPC(rec: NPCRecord)
	rec.Alive = false
	npcRecords[rec.Id] = nil
	if rec.Model and rec.Model.Parent then
		rec.Model:Destroy()
	end
end

function CombatService.OnNPCKilled(attacker: Player, rec: NPCRecord)
	if not rec.Alive then
		return
	end
	rec.Alive = false
	local cash = rec.Def.CashReward
	local xp = rec.Def.XPReward
	grantRewards(attacker, cash, xp, "npc_kill")
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(attacker, "KillNPC", 1)
	end
	local profile = DataService.GetProfile(attacker)
	if profile then
		profile.Stats.Kills += 1
		DataService.MarkDirty(attacker)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.NPC_KILL, attacker.UserId, {
			npcType = rec.TypeId,
			cash = cash,
			xp = xp,
		})
	end
	if NotificationService then
		NotificationService.Notify(attacker, string.format("%s down (+$%d)", rec.Def.DisplayName, cash), "Reward")
	end
	hitFeedback(attacker, { Kind = "Kill", Damage = 0, TargetName = rec.Def.DisplayName, WeaponId = nil })
	local spawnCf = rec.SpawnCFrame
	local typeId = rec.TypeId
	task.delay(0.35, function()
		destroyNPC(rec)
	end)
	task.delay(CombatConfig.NPCRespawnSeconds, function()
		CombatService.SpawnNPC(typeId, spawnCf)
	end)
end

local function damageNPC(attacker: Player, npcId: string, damage: number, weaponId: string): boolean
	local rec = npcRecords[npcId]
	if not rec or not rec.Alive or rec.Humanoid.Health <= 0 then
		return false
	end
	tagCreator(rec.Humanoid, attacker)
	local before = rec.Humanoid.Health
	rec.Humanoid:TakeDamage(damage)
	local dealt = math.max(0, before - rec.Humanoid.Health)
	if dealt <= 0 then
		return false
	end
	local killed = rec.Humanoid.Health <= 0
	hitFeedback(attacker, {
		Kind = if killed then "Kill" else "Hit",
		Damage = dealt,
		TargetName = rec.Def.DisplayName,
		WeaponId = weaponId,
	})
	if killed then
		CombatService.OnNPCKilled(attacker, rec)
	end
	return true
end

function CombatService.SpawnNPC(typeId: string?, at: CFrame): NPCRecord?
	local tid = typeId or CombatConfig.DefaultNPCType
	local isSpecial = tid == "BankGuard" or tid == "OilRigGuard" or tid == "FortGuard"
	local cap = CombatConfig.MaxActiveNPCs or 18
	-- Special guards may exceed soft field pool by +4 so bank always gets guards
	if aliveNPCCount() >= (if isSpecial then cap + 4 else cap) then
		print(string.format("[CombatService] SpawnNPC blocked at cap alive=%d tid=%s", aliveNPCCount(), tostring(tid)))
		return nil
	end
	local def = CombatConfig.NPCTypes[tid]
	if not def then
		tid = CombatConfig.DefaultNPCType
		def = CombatConfig.NPCTypes[tid]
	end
	if not def then
		return nil
	end

	local id = string.format("npc_%d", npcSerial)
	npcSerial += 1

	local model = Instance.new("Model")
	model.Name = def.DisplayName
	model:SetAttribute("NPCId", id)
	model:SetAttribute("NPCType", tid)

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	-- Classic R6 torso proportions (2×2×1)
	root.Size = Vector3.new(2, 2, 1)
	root.CFrame = at
	root.Anchored = false
	root.CanCollide = true
	root.Color = def.Color
	root.Material = Enum.Material.Fabric
	root.Parent = model

	local function weldPart(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = at * offset
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = root
		return p
	end

	-- Visual kits v2 infantry: helmet, vest, legs, rifle silhouette
	local skin = Color3.fromRGB(
		math.clamp(math.floor(def.Color.R * 255) + 30, 0, 255),
		math.clamp(math.floor(def.Color.G * 255) + 15, 0, 255),
		math.clamp(math.floor(def.Color.B * 255) + 10, 0, 255)
	)
	local helmCol = Color3.fromRGB(
		math.clamp(math.floor(def.Color.R * 255) - 20, 20, 255),
		math.clamp(math.floor(def.Color.G * 255) - 10, 20, 255),
		math.clamp(math.floor(def.Color.B * 255) - 15, 20, 255)
	)
	local isHeavy = tid == "HeavyInfantry" or tid == "OilRigGuard" or tid == "FortGuard"
	local isBank = tid == "BankGuard"
	-- R6-ish: head +1.5, arms ±1.5, legs ±0.5 @ -2
	local headPart = weldPart("Head", Vector3.new(1.05, 1.05, 1.05), CFrame.new(0, 1.55, 0), skin, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = headPart
	weldPart("Helmet", Vector3.new(1.2, 0.5, 1.2), CFrame.new(0, 1.95, 0), helmCol, Enum.Material.Metal, nil)
	weldPart("Visor", Vector3.new(0.95, 0.2, 0.3), CFrame.new(0, 1.75, -0.5), Color3.fromRGB(30, 35, 40), Enum.Material.Glass, nil)
	weldPart("Vest", Vector3.new(2.1, 1.2, 1.15), CFrame.new(0, 0.15, 0), Color3.fromRGB(
		math.clamp(math.floor(def.Color.R * 255) - 25, 25, 255),
		math.clamp(math.floor(def.Color.G * 255) - 15, 25, 255),
		math.clamp(math.floor(def.Color.B * 255) - 10, 25, 255)
	), Enum.Material.Metal, nil)
	weldPart("LegL", Vector3.new(1, 2, 1), CFrame.new(-0.5, -2, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("LegR", Vector3.new(1, 2, 1), CFrame.new(0.5, -2, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("BootL", Vector3.new(1.05, 0.35, 1.15), CFrame.new(-0.5, -3.1, 0.1), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, nil)
	weldPart("BootR", Vector3.new(1.05, 0.35, 1.15), CFrame.new(0.5, -3.1, 0.1), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, nil)
	weldPart("ArmL", Vector3.new(1, 2, 1), CFrame.new(-1.5, 0, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("ArmR", Vector3.new(1, 2, 1), CFrame.new(1.5, 0, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("Rifle", Vector3.new(0.26, 0.26, 2.4), CFrame.new(1.15, 0.15, -0.85), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil)
	weldPart("Stock", Vector3.new(0.28, 0.35, 0.7), CFrame.new(1.15, 0.2, 0.55), Color3.fromRGB(45, 40, 32), Enum.Material.Wood, nil)
	weldPart("BarrelTip", Vector3.new(0.18, 0.18, 0.35), CFrame.new(1.15, 0.15, -2.05), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil)
	local accent = if isBank
		then Color3.fromRGB(90, 140, 220)
		elseif isHeavy then Color3.fromRGB(230, 160, 50)
		else Color3.fromRGB(200, 80, 60)
	weldPart("Accent", Vector3.new(1.9, 0.12, 0.35), CFrame.new(0, 0.95, -0.6), accent, Enum.Material.Metal, nil)
	if isHeavy then
		weldPart("Pack", Vector3.new(1.4, 1.5, 0.7), CFrame.new(0, 0.4, 0.85), Color3.fromRGB(40, 42, 38), Enum.Material.Metal, nil)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = def.Health
	humanoid.Health = def.Health
	humanoid.WalkSpeed = def.WalkSpeed
	humanoid.AutoRotate = true
	humanoid.HipHeight = 2 -- R6-ish Part kit (root mid-torso; legs welded massless)
	-- Kill double nametags: Humanoid nameplate OFF; one clean Billboard only
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameOcclusion = Enum.NameOcclusion.OccludeAll
	humanoid.Parent = model

	-- Single clean nameplate
	local bb = Instance.new("BillboardGui")
	bb.Name = "NPCLabel"
	bb.Size = UDim2.fromOffset(140, 28)
	bb.StudsOffset = Vector3.new(0, 3.6, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Parent = root
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	lbl.BackgroundTransparency = 0.25
	lbl.Text = def.DisplayName
	lbl.TextColor3 = Color3.fromRGB(230, 235, 255)
	lbl.TextScaled = true
	lbl.Font = Enum.Font.GothamBold
	lbl.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = lbl

	model.PrimaryPart = root
	-- Optional free catalog character visual (scripts stripped); Part kit stays authoritative.
	-- Resolve by NPC type id (Infantry/BankGuard/…); VisualAssetService falls back to Soldier.
	pcall(function()
		VisualAssetService.TryAttachCharacterVisual(model, tid)
	end)
	CollectionService:AddTag(model, Constants.Tags.NPC)
	model.Parent = ensureNPCFolder()
	-- Server owns physics so MoveTo works reliably
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	-- Yaw-only BodyGyro so Humanoid:MoveTo can walk (full XYZ torque pins feet)
	local gyro = Instance.new("BodyGyro")
	gyro.Name = "NPCFaceGyro"
	gyro.MaxTorque = Vector3.new(0, 4e5, 0)
	gyro.P = 5000
	gyro.D = 500
	gyro.CFrame = at
	gyro.Parent = root

	local rec: NPCRecord = {
		Id = id,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		TypeId = tid,
		Def = def,
		LastFireAt = 0,
		SpawnCFrame = at,
		Alive = true,
	}
	npcRecords[id] = rec

	humanoid.Died:Connect(function()
		if not rec.Alive then
			return
		end
		local killer: Player? = nil
		local tag = humanoid:FindFirstChild("creator")
		if tag and tag:IsA("ObjectValue") and tag.Value and tag.Value:IsA("Player") then
			killer = tag.Value :: Player
		end
		if killer then
			CombatService.OnNPCKilled(killer, rec)
		else
			local spawnCf = rec.SpawnCFrame
			local t = rec.TypeId
			task.delay(0.35, function()
				destroyNPC(rec)
			end)
			task.delay(CombatConfig.NPCRespawnSeconds, function()
				CombatService.SpawnNPC(t, spawnCf)
			end)
		end
	end)

	return rec
end

local function thinkNPCs()
	CombatNPC.Think()
end

local function gatherSpawns(): { CFrame }
	return CombatNPC.GatherSpawns()
end

function CombatService.BootstrapNPCs()
	local points = gatherSpawns()
	local types = { "Infantry", "Infantry", "HeavyInfantry" }
	local spawned = 0
	-- Reserve slots for BankGuard / special spawns (BankRaidService)
	local fieldCap = math.max(4, (CombatConfig.MaxActiveNPCs or 18) - 6)
	for i, cf in ipairs(points) do
		if spawned >= fieldCap then
			break
		end
		local typeId = types[((i - 1) % #types) + 1]
		if CombatService.SpawnNPC(typeId, cf) then
			spawned += 1
		end
	end
	if RunService:IsStudio() then
		print(string.format("[CombatService] Spawned %d NPCs (cap %d)", spawned, CombatConfig.MaxActiveNPCs))
	end
end

function CombatService.EquipWeapon(player: Player, weaponId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(weaponId, 48) then
		return false, "InvalidWeapon"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureStarter(profile)
	if not owns(profile, weaponId) then
		return false, "NotOwned"
	end
	local def = weaponDef(weaponId)
	if not def then
		return false, "UnknownWeapon"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	profile.EquippedWeapon = weaponId
	DataService.MarkDirty(player)
	local state = getState(player)
	if state then
		state.WeaponId = weaponId
		state.Ammo = def.MagazineSize
		state.ReloadingUntil = 0
	end
	pushState(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.WEAPON_EQUIPPED, player.UserId, { weapon = weaponId })
	end
	return true, nil
end

function CombatService.PurchaseWeapon(player: Player, weaponId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(weaponId, 48) then
		return false, "InvalidWeapon"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local def = weaponDef(weaponId)
	if not def then
		return false, "UnknownWeapon"
	end
	ensureStarter(profile)
	if owns(profile, weaponId) then
		return false, "AlreadyOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local cost = def.CostCash or 0
	if cost > 0 then
		local ok, err = EconomyService.SpendCash(player, cost, "weapon_" .. weaponId)
		if not ok then
			return false, err or "SpendFailed"
		end
	end
	profile.Weapons[weaponId] = true
	DataService.MarkDirty(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.WEAPON_PURCHASED, player.UserId, { weapon = weaponId, cost = cost })
	end
	if NotificationService then
		NotificationService.Notify(player, "Acquired " .. def.DisplayName, "Reward")
	end
	CombatService.EquipWeapon(player, weaponId)
	return true, nil
end

function CombatService.Reload(player: Player): (boolean, string?)
	local state = getState(player)
	if not state or not state.Alive then
		return false, "Dead"
	end
	local def = weaponDef(state.WeaponId)
	if not def then
		return false, "NoWeapon"
	end
	if clock() < state.ReloadingUntil then
		return false, "AlreadyReloading"
	end
	if state.Ammo >= def.MagazineSize then
		return false, "FullMag"
	end
	local reloadTime = def.ReloadTime
	state.ReloadingUntil = clock() + reloadTime
	local weaponId = state.WeaponId
	pushState(player)
	task.delay(reloadTime, function()
		local s = combatStates[player.UserId]
		if not s or s.WeaponId ~= weaponId then
			return
		end
		if clock() + 0.05 < s.ReloadingUntil then
			return
		end
		s.Ammo = def.MagazineSize
		s.ReloadingUntil = 0
		if player.Parent then
			pushState(player)
		end
	end)
	return true, nil
end

function CombatService.RequestFire(player: Player, payload: any): boolean
	if typeof(payload) ~= "table" then
		AntiExploitService.Strike(player, "fire_bad_payload")
		return false
	end
	if not RateLimitService.Allow(player, "combat_fire", CombatConfig.FireRemoteRate, CombatConfig.FireRemoteBurst) then
		return false
	end

	local state = getState(player)
	if not state or not state.Alive then
		return false
	end
	if clock() < state.ReloadingUntil then
		return false
	end

	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	ensureStarter(profile)
	if not owns(profile, state.WeaponId) then
		AntiExploitService.Strike(player, "fire_unowned_weapon")
		return false
	end

	local def = weaponDef(state.WeaponId)
	if not def then
		return false
	end

	local minInterval = 1 / math.max(def.FireRate, 0.1)
	if clock() - state.LastFireAt < minInterval * 0.9 then
		return false
	end
	if state.Ammo <= 0 then
		return false
	end

	local character, humanoid, root = characterParts(player)
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		return false
	end

	local direction = payload.Direction
	if typeof(direction) ~= "Vector3" or direction.Magnitude < CombatConfig.MaxAimDirectionError then
		AntiExploitService.Strike(player, "fire_bad_direction")
		return false
	end
	if not AntiExploitService.IsFiniteNumber(direction.X) then
		AntiExploitService.Strike(player, "fire_nan_direction")
		return false
	end
	direction = direction.Unit

	local origin = payload.Origin
	if typeof(origin) ~= "Vector3" then
		origin = root.Position + Vector3.new(0, 1.5, 0)
	else
		if (origin - root.Position).Magnitude > CombatConfig.MaxOriginDeltaStuds then
			AntiExploitService.Strike(player, "fire_origin_desync")
			origin = root.Position + Vector3.new(0, 1.5, 0)
		end
	end

	state.Ammo -= 1
	state.LastFireAt = clock()
	pushState(player)

	local range = def.Range + CombatConfig.HitPositionSlopStuds
	local damage = damageFor(def, player)
	local result = raycast(origin, direction, range, { character })

	local hitSomething = false
	if result then
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local hitPlayer = Players:GetPlayerFromCharacter(model)
			if hitPlayer then
				hitSomething = damagePlayer(player, hitPlayer, damage, state.WeaponId)
			elseif CollectionService:HasTag(model, Constants.Tags.NPC) then
				local npcId = model:GetAttribute("NPCId")
				if typeof(npcId) == "string" and (result.Position - origin).Magnitude <= range then
					hitSomething = damageNPC(player, npcId, damage, state.WeaponId)
				end
			end
		end
		-- Siegeable plot gate barrier (server-validated)
		if not hitSomething then
			local hitInst = result.Instance
			if hitInst and hitInst:IsA("BasePart") and hitInst:GetAttribute("GateBarrier") == true then
				if GateDefenseService and GateDefenseService.ApplyDamage then
					hitSomething = GateDefenseService.ApplyDamage(player, hitInst, damage, state.WeaponId) == true
				end
			end
		end
	else
		local targetUserId = payload.TargetUserId
		local targetNpcId = payload.TargetNpcId
		if typeof(targetUserId) == "number" then
			local targetPlayer = Players:GetPlayerByUserId(targetUserId)
			if targetPlayer then
				local _, _, troot = characterParts(targetPlayer)
				if troot and (troot.Position - origin).Magnitude <= range then
					hitSomething = damagePlayer(player, targetPlayer, damage, state.WeaponId)
				end
			end
		elseif typeof(targetNpcId) == "string" then
			local rec = npcRecords[targetNpcId]
			if rec and rec.Alive and (rec.Root.Position - origin).Magnitude <= range then
				hitSomething = damageNPC(player, targetNpcId, damage, state.WeaponId)
			end
		end
	end

	if not hitSomething then
		local hitPosition = payload.HitPosition
		if typeof(hitPosition) == "Vector3" and (hitPosition - origin).Magnitude > range * 1.25 then
			AntiExploitService.Strike(player, "fire_hitpos_oor")
		end
	end

	return true
end

local lastDeathShopAt: { [number]: number } = {}
local DEATH_SHOP_DEBOUNCE = 12

local function resolveDeathOfferLive(MonetizationConfig: any, key: string): (boolean, string?)
	-- Prefer GamePass Id (DoubleCash), then DevProduct Id (SpeedBoost)
	local gp = MonetizationConfig.GamePasses and MonetizationConfig.GamePasses[key]
	if gp and typeof(gp.Id) == "number" and gp.Id ~= 0 then
		return true, gp.DisplayName or key
	end
	local dp = MonetizationConfig.DevProducts and MonetizationConfig.DevProducts[key]
	if dp and typeof(dp.Id) == "number" and dp.Id ~= 0 then
		return true, dp.DisplayName or key
	end
	return false, nil
end

local function onPlayerDeath(victim: Player, killer: Player?)
	local state = combatStates[victim.UserId]
	if state then
		state.Alive = false
	end
	pushState(victim)
	if killer and killer ~= victim then
		CombatService.RegisterPlayerKill(killer, victim)
	else
		local vProfile = DataService.GetProfile(victim)
		if vProfile then
			vProfile.Stats.Deaths += 1
			DataService.MarkDirty(victim)
		end
	end
	
	-- v30: PvP death → DeathShopOffer toast (DoubleCash GP + SpeedBoost DP; live Ids only; debounced)
	if killer and killer ~= victim and NotificationService then
		local now = os.clock()
		local prev = lastDeathShopAt[victim.UserId] or 0
		if now - prev >= DEATH_SHOP_DEBOUNCE then
			lastDeathShopAt[victim.UserId] = now
			local MonetizationConfig = require(ReplicatedStorage.Shared.Configs.MonetizationConfig)
			local offers = (MonetizationConfig :: any).DeathShopOffers or { "DoubleCash", "SpeedBoost" }
			local liveOffers = {}
			local labels = {}
			for _, key in ipairs(offers) do
				local live, label = resolveDeathOfferLive(MonetizationConfig, key)
				if live and label then
					table.insert(liveOffers, key)
					table.insert(labels, label)
				end
			end
			if #liveOffers > 0 then
				NotificationService.Notify(
					victim,
					"Boost? " .. table.concat(labels, " / ") .. " — tap toast",
					"Info",
					5
				)
				if RemoteSetup then
					local remote = RemoteSetup.Get(Constants.RemoteNames.DeathShopOffer)
					if remote then
						(remote :: RemoteEvent):FireClient(victim, { Offers = liveOffers })
					end
				end
			end
		end
	end

	task.delay(GameConfig.RespawnTimeSeconds, function()
		if victim.Parent then
			victim:LoadCharacter()
		end
	end)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.MaxHealth = CombatConfig.PlayerMaxHealth
	humanoid.Health = CombatConfig.PlayerMaxHealth

	local state = getState(player)
	if state then
		state.Alive = true
		local invuln = GameConfig.SpawnInvulnerabilitySeconds or CombatConfig.SpawnInvulnerabilitySeconds
		state.InvulnerableUntil = clock() + invuln
		local def = weaponDef(state.WeaponId)
		if def then
			state.Ammo = def.MagazineSize
			state.ReloadingUntil = 0
		end
	end

	task.defer(function()
		CombatService.TeleportToBase(player)
		pushState(player)
	end)

	humanoid.Died:Connect(function()
		local killer: Player? = nil
		local tag = humanoid:FindFirstChild("creator")
		if tag and tag:IsA("ObjectValue") and tag.Value and tag.Value:IsA("Player") then
			killer = tag.Value :: Player
		end
		onPlayerDeath(player, killer)
	end)

	humanoid.HealthChanged:Connect(function()
		pushState(player)
	end)
end

function CombatService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	AntiExploitService = deps.AntiExploitService
	NotificationService = deps.NotificationService
	GateDefenseService = deps.GateDefenseService
	RemoteSetup = deps.RemoteSetup
	MissionService = deps.MissionService
	TerritoryService = deps.TerritoryService

	CombatDamage.Bind({ TerritoryService = TerritoryService })
	CombatNPC.Bind({
		npcRecords = npcRecords,
		combatStates = combatStates,
		clock = clock,
		characterParts = characterParts,
		hitFeedback = hitFeedback,
		pushState = pushState,
		spawnNPC = function(typeId: string?, at: CFrame)
			return CombatService.SpawnNPC(typeId, at)
		end,
		getTagged = getTaggedCached,
	})


	local equipRemote = RemoteSetup.Get(Constants.RemoteNames.RequestEquipWeapon) :: RemoteEvent
	equipRemote.OnServerEvent:Connect(function(player: Player, weaponId: any)
		if not RateLimitService.Allow(player, "equip_weapon", CombatConfig.EquipRemoteRate, CombatConfig.EquipRemoteBurst) then
			return
		end
		local ok, err = CombatService.EquipWeapon(player, weaponId)
		if not ok and NotificationService and err then
			NotificationService.Notify(player, "Cannot equip: " .. tostring(err), "Warn")
		end
	end)

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseWeapon) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, weaponId: any)
		if not RateLimitService.Allow(player, "buy_weapon", CombatConfig.PurchaseWeaponRate, CombatConfig.PurchaseWeaponBurst) then
			return
		end
		local ok, err = CombatService.PurchaseWeapon(player, weaponId)
		if not ok and NotificationService and err then
			NotificationService.Notify(player, "Cannot buy weapon: " .. tostring(err), "Warn")
		end
	end)

	local fireRemote = RemoteSetup.Get(Constants.RemoteNames.RequestFire) :: RemoteEvent
	fireRemote.OnServerEvent:Connect(function(player: Player, payload: any)
		CombatService.RequestFire(player, payload)
	end)

	local reloadRemote = RemoteSetup.Get(Constants.RemoteNames.RequestReload) :: RemoteEvent
	reloadRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "reload", CombatConfig.ReloadRemoteRate, CombatConfig.ReloadRemoteBurst) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		CombatService.Reload(player)
	end)

	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end

	DataService.OnProfileLoaded(function(player: Player, profile: PlayerProfile)
		ensureStarter(profile)
		DataService.MarkDirty(player)
		getState(player)
		local wid = profile.EquippedWeapon or WeaponConfig.DefaultWeapon
		CombatService.EquipWeapon(player, wid)
		pushState(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		combatStates[player.UserId] = nil
	end)

	task.spawn(function()
		task.wait(1)
		CombatService.BootstrapNPCs()
		while true do
			task.wait(CombatConfig.NPCThinkInterval)
			thinkNPCs()
		end
	end)
end

function CombatService.GetPlayerCombatState(player: Player): CombatState?
	return combatStates[player.UserId]
end

function CombatService.PushState(player: Player)
	pushState(player)
end

function CombatService.ApplyDamage(attacker: Player, target: Humanoid, weaponId: string, _ignored: number)
	local def = weaponDef(weaponId)
	if not def then
		return
	end
	local damage = damageFor(def, attacker)
	local model = target.Parent
	if model and model:IsA("Model") then
		local victim = Players:GetPlayerFromCharacter(model)
		if victim then
			damagePlayer(attacker, victim, damage, weaponId)
			return
		end
		if CollectionService:HasTag(model, Constants.Tags.NPC) then
			local npcId = model:GetAttribute("NPCId")
			if typeof(npcId) == "string" then
				damageNPC(attacker, npcId, damage, weaponId)
			end
		end
	end
end

function CombatService.RegisterKill(attacker: Player, victim: Player)
	CombatService.RegisterPlayerKill(attacker, victim)
end

return CombatService
]]></string>
