		put(b, "RevetmentWall", Vector3.new(5.2, 2, 3.4), CFrame.new(x, 1.13, 1.95) * rotY(yaws[i]) * rotX(leans[i]), if i == 2 then PAL.ConcreteLight else PAL.Concrete, M.Concrete, true)
	end
end

