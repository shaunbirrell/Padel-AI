			Flag = "SupplyLine",
			DisplayName = "Supply Truck (owned)",
			Kind = "Vehicle",
			Id = "SupplyTruck",
			GrantOwned = true,
		},
		{
			AtPrestige = 4,
			Flag = "MissileBoatGrant",
			DisplayName = "Missile Boat (owned)",
			Kind = "Vehicle",
			Id = "MissileBoat",
			GrantOwned = true,
		},
		{
			AtPrestige = 5,
			Flag = "AirLift",
			DisplayName = "Transport Heli (owned)",
			Kind = "Vehicle",
			Id = "TransportHeli",
			GrantOwned = true,
