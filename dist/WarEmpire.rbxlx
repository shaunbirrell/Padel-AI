        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">AdminConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Add your Roblox UserIds here for admin commands + AdminPlaytestCash ]]

local AdminConfig = {
	-- shaunie6 — playtest owner only (do not add random players)
	UserIds = {
		470626172,
	} :: { number },
	-- LoadProfile only: if UserId==470626172 and Cash below this, raise to this (simple max).
	-- No ForceWipe / Ensure* floors. DataStore key bump (v2) forces fresh CreateDefault.
	AdminPlaytestCash = 50_000_000,
	Commands = {
		"cash",
		"givecash",
		"givegold",
		"givexp",
		"setlevel",
		"unlockall",
		"resetbase",
		"wipeprofile",
	},
	-- v71 money (M2): test commands for the money workflows. AdminService allows them for the UserIds above and,
	-- in Studio only, for any player (Local Server tests). Each is logged as ADMIN_COMMAND and replies
	-- "not built yet" until its service exists. None of them touches Cash (AdminPlaytestCash stays owner-only).
	--   grantent <key>            MonetizationService.GrantEntitlement on yourself (a MonetizationConfig pass key
	--                             or DevProduct GrantEntitlement value)
	--   givenuke <n> [tactical]   NukeService.Grant(player, "Nuke" | "TacticalNuke", n, "admin")
	--   nukecd                    NukeService.AdminResetCooldowns()
	--   vhp <pct>                 VehicleService.AdminSetHP(player, pct): your active vehicle's HP (0-100%)
	--   setprestige <n>           RebirthExpansionService.AdminSetPrestige(player, n)
	--   openzone <id>             RebirthExpansionService.AdminOpenZone(player, zoneId)
	--   resetrebirth              RebirthExpansionService.AdminResetRebirth(player)
	MoneyCommands = {
		"grantent",
		"givenuke",
		"nukecd",
		"vhp",
		"setprestige",
		"openzone",
		"resetrebirth",
	} :: { string },
}

return AdminConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">AimAssistConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ W2 Combat Core (mobile plan §4.1, contracts §1.4): server-validated aim assist.

	The server (CombatService/CombatAssist) picks at most ONE target per accepted hitscan shot when the exact ray
	missed and the P0-7 claim did not confirm a target: the alive player or NPC with the smallest sideways distance
	from the fire ray, inside this class's lateral / cone limits, within min(weapon Range, MaxRangeStuds), in front
	of whatever scenery the ray hit, with a clear line of sight. The client (AimTargets) reads Classes and
	MaxRangeStuds to mirror the same cone for its camera aim help; the server stays authoritative.

	The input class comes from the fire payload's Input field and is stored on the Player as ClassAttribute. A
	change is accepted at most once per ClassChangeSeconds. A PC that claims Touch gains at most 2.5 studs / 4°.

	Limits that hold in every version (never tune past these):
	  - assist never extends range and never passes walls;
	  - one target per shot, at the weapon's own fire rate;
	  - no headshot on claims or assist;
	  - no direct assist for projectiles (RocketLauncher, Grenade);
	  - TargetUserId / TargetNpcId never choose an assist target. ]]

export type AssistClass = {
	LateralStuds: number, -- max distance of the target torso from the fire ray
	MaxConeDeg: number, -- max angle between the fire ray and the target torso
}

local AimAssistConfig = {
	Enabled = true,
	Classes = {
		Touch = { LateralStuds = 2.5, MaxConeDeg = 4 },
		Gamepad = { LateralStuds = 2.0, MaxConeDeg = 3 },
		KeyboardAndMouse = { LateralStuds = 1.0, MaxConeDeg = 1.5 },
	} :: { [string]: AssistClass },
	MaxRangeStuds = 150, -- assist range = min(weapon Range, this): sniper assist stops at 150
	DefaultClass = "KeyboardAndMouse",
	ClassChangeSeconds = 5,
	ClassAttribute = "WE_InputClass",
	ExcludeClanAllies = true,
	LosPastTorsoStuds = 2,
}

return AimAssistConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">AnalyticsConfig</string>
            <string name="Source"><![CDATA[--!strict

local AnalyticsConfig = {
	Enabled = true,
	LogToOutput = true, -- MVP: print; swap sink later
	Events = {
		PLAYER_JOIN = "PLAYER_JOIN",
		PLAYER_LEAVE = "PLAYER_LEAVE",
		FIRST_UPGRADE = "FIRST_UPGRADE",
		UPGRADE_PURCHASED = "UPGRADE_PURCHASED",
		LEVEL_UP = "LEVEL_UP",
		DAILY_REWARD_CLAIMED = "DAILY_REWARD_CLAIMED",
		PURCHASE_RECEIPT = "PURCHASE_RECEIPT",
		ADMIN_COMMAND = "ADMIN_COMMAND",
		SESSION_LOCK_CONFLICT = "SESSION_LOCK_CONFLICT",
		FIRST_PVP = "FIRST_PVP",
		PLAYER_KILL = "PLAYER_KILL",
		NPC_KILL = "NPC_KILL",
		WEAPON_PURCHASED = "WEAPON_PURCHASED",
		WEAPON_EQUIPPED = "WEAPON_EQUIPPED",
		VEHICLE_PURCHASED = "VEHICLE_PURCHASED",
		VEHICLE_SPAWNED = "VEHICLE_SPAWNED",
		FIRST_OUTPOST = "FIRST_OUTPOST",
		TERRITORY_CAPTURED = "TERRITORY_CAPTURED",
		TERRITORY_LOST = "TERRITORY_LOST",
		MISSION_CLAIMED = "MISSION_CLAIMED",
		MISSION_PROGRESS = "MISSION_PROGRESS",
		ACHIEVEMENT_UNLOCKED = "ACHIEVEMENT_UNLOCKED",
		SHOP_PROMPT = "SHOP_PROMPT",
		SEASON_END = "SEASON_END",
		SEASON_RESUME = "SEASON_RESUME",
		CLAN_WAR_DECLARE = "CLAN_WAR_DECLARE",
		CLAN_WAR_SETTLE = "CLAN_WAR_SETTLE",
		SOLDIER_RECRUIT = "SOLDIER_RECRUIT",
		SOLDIER_DISMISS = "SOLDIER_DISMISS",
		BATTLEPASS_CLAIM = "BATTLEPASS_CLAIM",
		PRESTIGE = "PRESTIGE",
		CODE_REDEEM = "CODE_REDEEM",
		CAPTURE_STIPEND = "CAPTURE_STIPEND",
		TRAINING_INCOME = "TRAINING_INCOME",
		NATION_COLOR_ASSIGN = "NATION_COLOR_ASSIGN",
		SUPPLY_DROP_CLAIM = "SUPPLY_DROP_CLAIM",
		BANK_RAID = "BANK_RAID",
		SPINNER_CLAIM = "SPINNER_CLAIM",
		-- v71 money (M2): events named in the money designs (nothing logs them yet). Cut this round, so not
		-- listed: REBIRTH_PERMIT_APPLIED, REBIRTH_SKIP_USED (J12) and REBIRTH_KIT_GRANTED.
		-- Nuke (nuke §13)
		NUKE_GRANTED = "NUKE_GRANTED", -- kind, count, source (receipt/silo/gift/battlepass/admin/refund), inventoryAfter
		NUKE_LAUNCH = "NUKE_LAUNCH",
		NUKE_REJECT = "NUKE_REJECT",
		NUKE_DETONATE = "NUKE_DETONATE",
		NUKE_ABORT = "NUKE_ABORT",
		NUKE_REFUND = "NUKE_REFUND",
		NUKE_OFFER_SHOWN = "NUKE_OFFER_SHOWN",
		NUKE_SILO_BUILT = "NUKE_SILO_BUILT",
		-- Premium vehicles and vehicle combat (premium §3.6, §10)
		PREMIUM_VEHICLE_VIEW = "PREMIUM_VEHICLE_VIEW",
		PREMIUM_VEHICLE_PROMPT = "PREMIUM_VEHICLE_PROMPT",
		PREMIUM_VEHICLE_OWNED = "PREMIUM_VEHICLE_OWNED",
		PREMIUM_TRIAL_START = "PREMIUM_TRIAL_START",
		PREMIUM_TRIAL_END = "PREMIUM_TRIAL_END",
		PREMIUM_OFFER_SHOWN = "PREMIUM_OFFER_SHOWN",
		VEHICLE_WEAPON_KILL = "VEHICLE_WEAPON_KILL",
		VEHICLE_DESTROYED = "VEHICLE_DESTROYED", -- vehicle, premium, killer, class
		-- Rebirth expansion (rebirth §16)
		REBIRTH_ZONE_OPENED = "REBIRTH_ZONE_OPENED", -- zone, via (prestige/admin)
		REBIRTH_OFFER_SHOWN = "REBIRTH_OFFER_SHOWN",
		REBIRTH_CELEBRATION_SEEN = "REBIRTH_CELEBRATION_SEEN",
		DRONE_CRATE = "DRONE_CRATE",
		ARTILLERY_HIT = "ARTILLERY_HIT",
		-- Shop / Offer Director / purchase funnel (revenue audit §19.2; SHOP_PROMPT and PURCHASE_RECEIPT exist above)
		SHOP_OPEN = "SHOP_OPEN",
		SHOP_TAB = "SHOP_TAB",
		OFFER_SHOWN = "OFFER_SHOWN",
		OFFER_RESULT = "OFFER_RESULT",
		PROMPT_CLOSED = "PROMPT_CLOSED", -- analytics only, never a grant
		PASS_OWNED = "PASS_OWNED",
		FIRST_PURCHASE = "FIRST_PURCHASE",
		SHORTFALL_CHIP = "SHORTFALL_CHIP",
		ANNOUNCE_SHOWN = "ANNOUNCE_SHOWN",
		-- Nations (cosmetic country; nations spec section 2). The IP-based suggestion is never logged, in any field.
		NATION_PICKER_SHOWN = "NATION_PICKER_SHOWN", -- source ("join" / "flagpole" / "settings")
		NATION_PICK = "NATION_PICK", -- exactly { id, source, first }
		NATION_LATER = "NATION_LATER", -- count (NationPrompts after this LATER)
		-- W3 step 2 Phase B: Jobs (OpsService; props: site, value, bags, drops, picked, lost)
		OPS_OPEN = "OPS_OPEN", -- a big site opened (OpsDirector)
		OPS_START = "OPS_START", -- a run went Active (breach / start / hack / plant / provoked)
		OPS_DONE = "OPS_DONE", -- a run finished (paid at completion or bags out)
		OPS_FAIL = "OPS_FAIL", -- lockdown / window / empty ring / abandoned
		BAG_GRAB = "BAG_GRAB",
		BAG_DROP = "BAG_DROP", -- the carrier died (or the deadline ran out: lost = true)
		BAG_PICKUP = "BAG_PICKUP",
		BAG_DELIVER = "BAG_DELIVER",
	},
}

return AnalyticsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">BankRaidConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Empire Bank raid — high-value contested vault with NPC guards + per-player cooldown (saved on the profile).

	W3 step 2, lane F ("bank findable", spec w3s2 §6 Phase A):
	- Guards stand on FIXED posts, never a ring round the vault (the ring put 2 of 5 inside the building).
	  BankRaidService reads the geometry's "Town.Bank" npc anchors (roles G1..Gn, WE_ActivityAnchor; MapSetup stamps
	  them on BankPlaza with the walk-in hall, lane BK) and falls back to GuardPosts below if they are missing.
	- Only a raider ON FOOT holds the vault (seated → "LEAVE VEHICLE" on the HUD, no progress, no pay).
	- The cooldown is saved as profile.Raid.BankCooldownUntil (os.time seconds; sanitised by BankRaidService).
	- The vault label reads "Empire Bank" + one state line: OPEN · rob the vault / RAID ON (everyone) and
	  CLOSED 4m (only the player who is on cooldown; drawn by BankRaidController on that client).
]]

export type GuardPost = {
	X: number,
	Y: number, -- world Y of the standing surface (the plaza top is 1.6, the ground 0.5)
	Z: number,
	Yaw: number?, -- degrees, 0 faces north (-Z), 180 faces south (+Z, down Bank Street)
}

local BankRaidConfig = {
	Enabled = true,
	BankId = "EmpireBank",
	DisplayName = "Empire Bank",
	Position = Vector3.new(220, 1, -220),
	VaultRadius = 12,
	RaidHoldSeconds = 6, -- v71: 8 → 6 (task #20 bank retune; guard stats in CombatConfig.NPCTypes.BankGuard)
	CooldownSeconds = 300, -- 5 min per player after a successful raid (saved: profile.Raid.BankCooldownUntil)
	CashMin = 15000,
	CashMax = 35000,
	GuardNPCType = "BankGuard",
	GuardCount = 5, -- at most this many fallback posts are used (the anchor posts are all used)
	-- The bank zone radius round Position: the WorldDress keep-out (WorldDress: this + BankExtra) and the novice
	-- shield's "engaging the bank" test (CombatService). Guards no longer spawn on a ring.
	GuardRingRadius = 18,
	-- Anchor site / role pattern read by BankRaidService (spec w3s2 §5: Town.Bank.G1..G5 on BankPlaza)
	AnchorSite = "Town.Bank",
	GuardRolePattern = "^G%d+$",
	-- HumanoidRootPart height above the standing surface (R6: 2-stud legs + half the 2-stud torso)
	GuardRootLift = 3,
	-- Fallback posts (lane BK): the same five posts as the Town.Bank G1..G5 anchors MapSetup stamps on BankPlaza (G1 / G2
	-- behind the planters, G3 / G4 beside the columns, G5 inside the hall by the vault door). Used only while no
	-- "Town.Bank" G anchors exist.
	GuardPosts = {
		{ X = 206, Y = 1.6, Z = -209.5, Yaw = 180 },
		{ X = 234, Y = 1.6, Z = -209.5, Yaw = 180 },
		{ X = 210.5, Y = 1.6, Z = -210.5, Yaw = 180 },
		{ X = 229.5, Y = 1.6, Z = -210.5, Yaw = 180 },
		{ X = 227, Y = 1.6, Z = -231, Yaw = 180 },
	} :: { GuardPost },
	NotifyOnRaid = true,
	-- v71: the hold freezes only while the raider was hit within this many seconds (was: any health below 95 %)
	UnderFireSeconds = 2,
	-- One-time tip the first time a player comes this close to Position (saved: profile.Raid.BankSeen)
	FirstVisitRadius = 150,
	FirstVisitSkipIfHitSeconds = 5, -- not while the player is being shot at; retried on a later tick
	-- The painted EMPIRE BANK sign on the bank's "BankSign" part (WorldKits.Sign, inside the world sign budget);
	-- painted only when that part has no SurfaceGui yet, on the face turned most toward SignFacing (the street side)
	Sign = {
		PartName = "BankSign",
		Text = "EMPIRE BANK",
		Facing = Vector3.new(0, 0, 1),
	},
	-- Copy seen by every device (no key names, no "tap" / "click")
	Text = {
		FirstVisit = "Empire Bank: stand on the vault to loot",
		Reward = "Bank job +$%s", -- %s = cash with commas
	},
	-- vault label (Shared/Util/WorldLabel): stud-scaled, never AlwaysOnTop, MaxDistance <= 40 (spec §5)
	Label = {
		Name = "WE_BankRaidStatus",
		StateAttribute = "WE_BankState", -- "open" | "raid" (the public state; the client reads it back)
		Title = "Empire Bank",
		OpenSub = "OPEN · rob the vault",
		OpenColor = Color3.fromRGB(120, 230, 130),
		RaidingSub = "RAID ON",
		RaidingColor = Color3.fromRGB(255, 176, 48),
		ClosedSub = "CLOSED %dm", -- %d = whole minutes left, rounded up (this player's own cooldown)
		ClosedColor = Color3.fromRGB(190, 190, 190),
		Color = Color3.fromRGB(255, 220, 120),
		HeightStuds = 8, -- above the vault pad centre (clear of a standing raider's head)
		MaxDistance = 40,
	},
}

return BankRaidConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">BaseConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	15 structure types, 5 levels each.
	Barracks costs match spec: 2500, 10000, 35000, 100000, 300000.
	Other structures use similar escalating curves.
]]

export type StructureDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	MaxLevel: number,
	Costs: { number }, -- Cash cost to purchase level 1..MaxLevel (index = target level)
	Currency: "Cash" | "Gold",
	Requires: { { StructureId: string, Level: number } }?,
	PassiveIncomeBonus: number?, -- extra flat cash/tick at each level (also in EconomyConfig)
	Kind: string?, -- nil = building / installation; "Business" = a v72 war business merged from BusinessConfig
}

local BaseLayoutConfig = require(script.Parent.BaseLayoutConfig)
local BusinessConfig = require(script.Parent.BusinessConfig)

local function costs(a: number, b: number, c: number, d: number, e: number): { number }
	return { a, b, c, d, e }
end

local BaseConfig = {
	MaxPlots = 6,
	-- v68: follows BaseLayoutConfig.PlotSize (320) while the layout is on — MapSetup builds pads that size
	PlotSize = if BaseLayoutConfig.Enabled
		then Vector3.new(BaseLayoutConfig.PlotSize, 1, BaseLayoutConfig.PlotSize)
		else Vector3.new(200, 1, 200),
	-- World positions — keep in sync with MapSetup PLOT_POSITIONS (ring ~800, ground ~4800)
	PlotPositions = {
		Vector3.new(-800, 0.5, -400),
		Vector3.new(-800, 0.5, 400),
		Vector3.new(0, 0.5, -800),
		Vector3.new(0, 0.5, 800),
		Vector3.new(800, 0.5, -400),
		Vector3.new(800, 0.5, 400),
	} :: { Vector3 },

	Structures = {
		CommandCenter = {
			Id = "CommandCenter",
			DisplayName = "Command Center",
			Description = "HQ for your base. Unlocks further construction.",
			MaxLevel = 5,
			Costs = costs(1500, 8000, 30000, 90000, 250000),
			Currency = "Cash",
			Requires = nil,
		},
		Barracks = {
			Id = "Barracks",
			DisplayName = "Barracks",
			Description = "Train and house soldiers. Strong passive income.",
			MaxLevel = 5,
			Costs = costs(2500, 10000, 35000, 100000, 300000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		VehicleDepot = {
			Id = "VehicleDepot",
			DisplayName = "Vehicle Depot",
			Description = "Maintain and unlock ground vehicles.",
			MaxLevel = 5,
			Costs = costs(3000, 12000, 40000, 120000, 350000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		WeaponsFacility = {
			Id = "WeaponsFacility",
			DisplayName = "Weapons Facility",
			-- v72: with the war businesses on, the Weapons Facility gates the Arms Crate Line
			Description = if BusinessConfig.Enabled then "Arms storage. Unlocks the Arms Crate Line." else "Research and unlock advanced weapons.",
			MaxLevel = 5,
			Costs = costs(2800, 11000, 38000, 110000, 320000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		Helipad = {
			Id = "Helipad",
			DisplayName = "Helipad",
			Description = "Landing pad for rotary-wing aircraft.",
			MaxLevel = 5,
			Costs = costs(5000, 20000, 70000, 200000, 500000),
			Currency = "Cash",
			Requires = { { StructureId = "VehicleDepot", Level = 2 } },
		},
		Dock = {
			Id = "Dock",
			DisplayName = "Naval Dock",
			Description = "Harbor berth for patrol boats and warships.",
			MaxLevel = 5,
			Costs = costs(4500, 18000, 65000, 190000, 520000),
			Currency = "Cash",
			Requires = { { StructureId = "VehicleDepot", Level = 2 } },
		},
		Airfield = {
			Id = "Airfield",
			DisplayName = "Airfield",
			Description = "Runway for fixed-wing fighters.",
			MaxLevel = 5,
			Costs = costs(8000, 35000, 120000, 350000, 900000),
			Currency = "Cash",
			Requires = { { StructureId = "Helipad", Level = 2 } },
		},
		DefensiveWalls = {
			Id = "DefensiveWalls",
			DisplayName = "Defensive Walls",
			Description = "Perimeter fortifications.",
			MaxLevel = 5,
			Costs = costs(2000, 9000, 32000, 95000, 280000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		Watchtowers = {
			Id = "Watchtowers",
			DisplayName = "Watchtowers",
			Description = "Elevated lookouts and light defense.",
			MaxLevel = 5,
			Costs = costs(2200, 9500, 34000, 98000, 290000),
			Currency = "Cash",
			Requires = { { StructureId = "DefensiveWalls", Level = 1 } },
		},
		Radar = {
			Id = "Radar",
			DisplayName = "Radar Station",
			Description = "Early warning and map intel.",
			MaxLevel = 5,
			Costs = costs(4000, 16000, 55000, 160000, 450000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 2 } },
		},
		ResearchLab = {
			Id = "ResearchLab",
			DisplayName = "Research Lab",
			Description = "Tech bonuses and prestige prep.",
			MaxLevel = 5,
			Costs = costs(4500, 18000, 60000, 180000, 480000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 2 } },
		},
		MissileDefense = {
			Id = "MissileDefense",
			DisplayName = "Missile Defense",
			Description = "Anti-air / anti-missile batteries.",
			MaxLevel = 5,
			Costs = costs(6000, 25000, 85000, 250000, 700000),
			Currency = "Cash",
			Requires = { { StructureId = "Radar", Level = 2 } },
		},
		PowerStation = {
			Id = "PowerStation",
			DisplayName = "Power Station",
			Description = "Powers advanced systems; income boost.",
			MaxLevel = 5,
			Costs = costs(3500, 14000, 48000, 140000, 400000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		Warehouse = {
			Id = "Warehouse",
			DisplayName = "Warehouse",
			Description = "Storage logistics — strongest passive income.",
			MaxLevel = 5,
			Costs = costs(3200, 13000, 45000, 130000, 380000),
			Currency = "Cash",
			Requires = { { StructureId = "CommandCenter", Level = 1 } },
		},
		SpecialForcesFacility = {
			Id = "SpecialForcesFacility",
			DisplayName = "Special Forces Facility",
			Description = "Elite units and late-game power.",
			MaxLevel = 5,
			Costs = costs(10000, 40000, 150000, 400000, 1_200_000),
			Currency = "Cash",
			Requires = { { StructureId = "Barracks", Level = 3 }, { StructureId = "ResearchLab", Level = 2 } },
		},
	} :: { [string]: StructureDef },

	-- Order for upgrade UI
	StructureOrder = {
		"CommandCenter",
		"Barracks",
		"VehicleDepot",
		"WeaponsFacility",
		"PowerStation",
		"Warehouse",
		"DefensiveWalls",
		"Watchtowers",
		"Radar",
		"ResearchLab",
		"Helipad",
		"Dock",
		"Airfield",
		"MissileDefense",
		"SpecialForcesFacility",
	},
}

--[[ v72 war businesses (BusinessConfig) are bought at their own consoles like any structure: while Enabled they are
	merged here (Kind = "Business") so the one purchase path (BaseService.PurchaseUpgrade), saving
	(profile.BaseUpgrades), requirements, rebirth reset and the Base panel cover them. Appended after the 15 literal
	ids above (BuyPathStatic's MapSetup-row rule reads only that literal list; businesses are built by
	BusinessService and have their own rule). Disabled: nothing is merged and BaseConfig is exactly as before v72. ]]
if BusinessConfig.Enabled then
	for _, id in ipairs(BusinessConfig.Order) do
		local b = BusinessConfig.Businesses[id]
		if b and BaseConfig.Structures[id] == nil then
			BaseConfig.Structures[id] = {
				Id = b.Id,
				DisplayName = b.DisplayName,
				Description = b.Description,
				MaxLevel = #b.Costs,
				Costs = b.Costs,
				Currency = "Cash",
				Requires = b.Requires,
				Kind = BusinessConfig.Kind,
			}
			table.insert(BaseConfig.StructureOrder, id)
		end
	end
end

return BaseConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">BaseLayoutConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v68: player base layout (plot-local studs). One source of truth for MapSetup (plot build), the
	structure kits / walk-in buildings, consoles and the rear-zone gates.

	Axes (plot-local): +Z = FRONT (main gate, spawn road), -Z = rear. X = across the plot.
	v70: each plot has its own frame (BaseLayout.PlotCFrame). With FaceMapCentre the plot is turned (yaw snapped to 90)
	so its FRONT faces the map centre and the rear zone (runway, helipad, dock + sea gate) faces outward:
	P1/P2 yaw 90 (front +X), P3 yaw 0, P4 yaw 180, P5/P6 yaw -90. Everything below stays plot-local.
	Yaw (degrees) is the direction a building's FRONT faces: 0 = +Z, 90 = +X, -90 = -X, 180 = -Z.

	Zones
	  Main compound  Z -60 .. front wall. Walk-in buildings face a central parade ground and road.
	  Rear zone      behind the inner wall (Z = -60): runway + hangar, helipads, dock basin.
	                 Each rear area sits behind its own inner gate, which opens when that structure is
	                 bought (Airfield / Helipad / Dock) and is guarded.

	Consoles: every structure is bought/upgraded at a console (the WE_UpgradeSlot part). Walk-in buildings
	have theirs inside, near the door (Console = building-local position). Outdoor installations have a
	kiosk (KioskOffset = plot-local position). Consoles are prompt/tap only — no walk-over buying.
]]

export type Vec2 = { X: number, Z: number }

export type StructureSite = {
	Site: Vec2, -- footprint centre (plot-local)
	Yaw: number, -- degrees, direction the front faces
	WalkIn: boolean, -- HollowBuildingBuilder building (Console is building-local) vs outdoor kit (kiosk)
	Console: Vec2?, -- walk-in: building-local position of the console (X across, Z toward the front)
	Kiosk: Vec2?, -- outdoor: plot-local kiosk position
	Gate: string?, -- rear-zone structures: inner gate id opened by buying this structure
}

local BaseLayoutConfig = {
	Enabled = true,
	FaceMapCentre = true, -- v70 waterways go-live: bases face the map centre so every Dock channel reaches the ring. Rollback = false (MapSetup MAP_GEN 71↔70 forces a map rebuild either way)
	PlotSize = 320, -- was 200; 6 plots on the 800-stud ring still clear roads/event spawns (see ASSUMPTIONS)
	SpawnOffset = { X = 0, Z = 136 },
	MainGateWidth = 14,

	InnerWall = {
		Z = -60,
		Height = 14,
		Thickness = 2.4,
		GateWidth = 16,
		Gates = {
			Airfield = { X = -100 },
			Helipad = { X = 40 },
			Dock = { X = 92 }, -- west of the basin, so the path runs along the kerb, not into the water
		} :: { [string]: { X: number } },
		-- v72 (read by MapSetup's gate signs once the v72 world lane lands; unused before): sign text inset from the
		-- sign board's edges, so "HELIPAD" / "AIRFIELD" read in full on a phone
		SignInsetStuds = 2.0,
	},

	-- Roads (plot-local rectangles: centre + size) — asphalt with painted edges
	Roads = {
		{ Name = "MainRoad", X = 0, Z = 64, SizeX = 14, SizeZ = 184 }, -- gate → Command Center
		{ Name = "Avenue", X = 0, Z = 80, SizeX = 200, SizeZ = 12 }, -- west row ↔ east row
		{ Name = "Plaza", X = 0, Z = 8, SizeX = 60, SizeZ = 50 }, -- parade ground in front of CC
		{ Name = "Taxiway", X = -100, Z = -66, SizeX = 12, SizeZ = 12 }, -- airfield gate → runway
		{ Name = "Runway", X = -65, Z = -80, SizeX = 170, SizeZ = 24 }, -- under / beside the hangar kit's strip
		{ Name = "HeliApron", X = 40, Z = -86, SizeX = 12, SizeZ = 50 }, -- helipad gate → pad
		{ Name = "HangarApron", X = -100, Z = -98.5, SizeX = 34, SizeZ = 13 }, -- runway → hangar doors
	},

	Courtyard = {
		Collector = { X = -42, Z = 118 }, -- ATM / money collector (premium pads arranged around it)
		TrainingYard = { X = 46, Z = 30 },
		Flagpole = { X = 0, Z = 8 },
		DockBasin = { X = 128, Z = -112, SizeX = 50, SizeZ = 70 },
	},

	-- Sandbag berms / crates / barriers dressing the base edges (MapSetup PlotWarzone)
	WarzoneSpots = {
		{ X = -146, Z = 146 }, { X = 146, Z = 146 }, { X = -146, Z = 80 }, { X = 146, Z = 80 },
		{ X = -146, Z = 28 }, { X = 146, Z = 28 }, { X = -30, Z = -52 }, { X = 25, Z = -8 },
		{ X = -20, Z = -100 }, { X = 10, Z = -150 }, { X = -150, Z = -150 }, { X = 80, Z = -150 },
	} :: { Vec2 },

	Structures = {
		CommandCenter = { Site = { X = 0, Z = -38 }, Yaw = 0, WalkIn = true, Console = { X = 10.5, Z = 6 } },
		Barracks = { Site = { X = -110, Z = 110 }, Yaw = 90, WalkIn = true, Console = { X = 13.5, Z = 8 } },
		WeaponsFacility = { Site = { X = -110, Z = 55 }, Yaw = 90, WalkIn = true, Console = { X = 12.5, Z = 7 } },
		SpecialForcesFacility = { Site = { X = -110, Z = 0 }, Yaw = 90, WalkIn = true, Console = { X = 12.5, Z = 7 } },
		VehicleDepot = { Site = { X = 110, Z = 110 }, Yaw = -90, WalkIn = true, Console = { X = 15.5, Z = 10 } },
		Warehouse = { Site = { X = 110, Z = 55 }, Yaw = -90, WalkIn = true, Console = { X = 14.5, Z = 9 } },
		ResearchLab = { Site = { X = 110, Z = 0 }, Yaw = -90, WalkIn = true, Console = { X = 12.5, Z = 7 } },
		PowerStation = { Site = { X = -60, Z = -40 }, Yaw = 0, WalkIn = false, Kiosk = { X = -60, Z = -24 } },
		Radar = { Site = { X = 70, Z = -40 }, Yaw = 0, WalkIn = false, Kiosk = { X = 70, Z = -24 } },
		MissileDefense = { Site = { X = 132, Z = -40 }, Yaw = 0, WalkIn = false, Kiosk = { X = 132, Z = -24 } },
		-- Kiosks stand in front of their kits (a kiosk inside the wall sample / tower body could not be reached)
		DefensiveWalls = { Site = { X = -18, Z = 146 }, Yaw = 0, WalkIn = false, Kiosk = { X = -18, Z = 134 } },
		Watchtowers = { Site = { X = 18, Z = 146 }, Yaw = 0, WalkIn = false, Kiosk = { X = 18, Z = 134 } },
		-- Airfield: hangar installation (Installations/Airfield) behind the runway, doors facing it (+Z)
		Airfield = { Site = { X = -100, Z = -122 }, Yaw = 0, WalkIn = false, Kiosk = { X = -86, Z = -52 }, Gate = "Airfield" },
		Helipad = { Site = { X = 40, Z = -125 }, Yaw = 0, WalkIn = false, Kiosk = { X = 54, Z = -52 }, Gate = "Helipad" },
		-- v70: the dock kit stands on the basin's west shore (was centred IN the basin, where its collidable Body was an
		-- island in the boats' spawn water); pier along the kerb, parked boat moored in the basin's west edge
		Dock = { Site = { X = 78, Z = -112 }, Yaw = 90, WalkIn = false, Kiosk = { X = 106, Z = -52 }, Gate = "Dock" },
		-- v72 war businesses (BusinessConfig; built by BusinessService only while BusinessConfig.Enabled, looked up by
		-- id, so these lines are inert until then). 22 x 12 lines facing the plot centre (Yaw 180), kiosk 10 studs
		-- toward the gate. Prototype census: 0 overlaps at L5, kiosks >= 36.6 studs apart, farthest 8.2 s from the ATM.
		AmmoWorks = { Site = { X = -30, Z = 100 }, Yaw = 180, WalkIn = false, Kiosk = { X = -30, Z = 90 } },
		ArmsCrateLine = { Site = { X = -66, Z = 100 }, Yaw = 180, WalkIn = false, Kiosk = { X = -66, Z = 90 } },
		ArmorPlatePress = { Site = { X = 34, Z = 60 }, Yaw = 180, WalkIn = false, Kiosk = { X = 34, Z = 50 } },
		RocketAssembly = { Site = { X = 70, Z = 60 }, Yaw = 180, WalkIn = false, Kiosk = { X = 70, Z = 50 } },
	} :: { [string]: StructureSite },

	-- v72: the 9 static painted floor arrows (MapSetup.paintPlotFloorChevrons, 18 parts per plot) pointed back at the
	-- gate and never moved on after the Command Center; the per-player NEXT pointer replaces them. Read by MapSetup
	-- once the v72 world lane lands (unused before). true = keep the old arrows.
	FloorChevrons = false,
}

return BaseLayoutConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">BattlePassConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Season battle pass tracks. PremiumProductId = 0 until Creator Dashboard.
	Premium entitlement: MonetizationConfig.DevProducts.PremiumPass (ProcessReceipt)
	or admin grantpremium — never client. ]]

