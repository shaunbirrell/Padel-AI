		{
			AtPrestige = 17,
			Flag = "RebirthHeavyTank",
			DisplayName = "Heavy Tank (owned)",
			Kind = "Vehicle",
			Id = "HeavyTank",
			GrantOwned = true,
			Gate = "Vehicles", -- claude-bud JOB 33 (RebirthConfig.LiveFor)
		},
		{
			AtPrestige = 18,
			Flag = "CruiserGrant",
			DisplayName = "Cruiser (owned)",
			Kind = "Vehicle",
			Id = "Cruiser",
			GrantOwned = true,
		},
		{
			AtPrestige = 19,
			Flag = "RebirthBattleTank",
			DisplayName = "Battle Tank (owned)",
			Kind = "Vehicle",
			Id = "BattleTank",
			GrantOwned = true,
			Gate = "Vehicles", -- claude-bud JOB 33 (RebirthConfig.LiveFor)
		},
		{
			AtPrestige = 20,
			Flag = "StrikeWing",
			DisplayName = "Strike Jet + Heavy Bomber gate",
			Kind = "Vehicle",
			Id = "StrikeJet",
			GrantOwned = true,
		},
	} :: { RebirthUnlockDef },
}

--[[ Build player-facing fee / confirm copy from config (client + server toasts). ]]
function PrestigeConfig.BuildFeeSummary(opts: { BaseCompletionPercent: number? }?): string
	local fee = tonumber(PrestigeConfig.CashFee) or 0
	local startCash = tonumber(PrestigeConfig.StartingCashAfterPrestige) or 0
	local gold = tonumber(PrestigeConfig.GoldBonusOnPrestige) or 0
	local feePart = if fee > 0 then string.format("Fee $%s", tostring(fee)) else "Fee: none"
	local parts = {
		feePart,
		string.format("Cash → $%s after", tostring(startCash)),
		string.format("+%d Gold", gold),
		"+10% cash forever",
		"resets Level/XP/Base",
		"keeps Robux items + vehicles/weapons/gold/unlocks/outposts",
	}
	local pct = opts and tonumber(opts.BaseCompletionPercent)
	if pct ~= nil then
		table.insert(parts, 1, string.format("Base %d%% complete", math.floor(pct)))
	end
	return table.concat(parts, " · ")
end

-- F7: the reset rules a rebirth path applies (anything but "KeepBase" is the free path).
function PrestigeConfig.ResetFor(path: string?): ResetRules
	if path == "KeepBase" then
		return PrestigeConfig.ResetOnPrestigeKeepBase
	end
	return PrestigeConfig.ResetOnPrestige
end

--[[ F11: rebirth progress 0..100 (whole number). "XP" mode:
	floor(100 * min(1, (GetTotalXPForLevel(level) + xp) / GetTotalXPForLevel(MinLevelToPrestige)))
	Lv 1 = 0, Lv 20 = 17, Lv 30 = 48, Lv 39 = 93, Lv 40+ = 100 (xp 0). Junk input counts as Lv 1 / 0 XP. ]]
function PrestigeConfig.ProgressPct(level: number, xp: number?): number
	local lv = math.max(1, math.floor(tonumber(level) or 1))
	local x = math.max(0, tonumber(xp) or 0)
	if x ~= x or x == math.huge then
		x = 0
	end
	local minLv = math.max(1, tonumber(PrestigeConfig.MinLevelToPrestige) or 40)
	if lv >= minLv then
		return 100
	end
	if PrestigeConfig.ProgressMode == "Level" then
		return math.clamp(math.floor(100 * lv / minLv), 0, 100)
	end
	local goal = LevelConfig.GetTotalXPForLevel(minLv)
	if goal <= 0 then
		return 100
	end
	return math.clamp(math.floor(100 * math.min(1, (LevelConfig.GetTotalXPForLevel(lv) + x) / goal)), 0, 100)
end

-- F11: DisplayName of the rebirth unlock that the NEXT rebirth gives (AtPrestige == prestige + 1), or nil.
function PrestigeConfig.NextUnlockName(prestige: number): string?
	local target = math.floor(tonumber(prestige) or 0) + 1
	for _, u in ipairs(PrestigeConfig.RebirthUnlocks) do
		if u.AtPrestige == target then
			return u.DisplayName
		end
	end
	return nil
end

local function withCommas(n: number): string
	local s = tostring(math.floor(n))
	local sign = ""
	if string.sub(s, 1, 1) == "-" then
		sign, s = "-", string.sub(s, 2)
	end
	local out = s
	while true do
		local nextOut, k = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2")
		out = nextOut
		if k == 0 then
			break
		end
	end
	return sign .. out
end

-- One modal line: at most SummaryMaxLineChars characters (hard cut with "..." if a caller string is too long).
local function fitLine(text: string): string
	local maxChars = math.max(4, math.floor(tonumber(PrestigeConfig.SummaryMaxLineChars) or 30))
	if #text <= maxChars then
		return text
	end
	return string.sub(text, 1, maxChars - 3) .. "..."
end

-- "Unlocks <name>": drops a "(...)" note, then a "+ second item", before cutting (keeps the line readable).
local function unlockLine(name: string): string
	local maxChars = math.max(4, math.floor(tonumber(PrestigeConfig.SummaryMaxLineChars) or 30))
	local line = "Unlocks " .. name
	if #line > maxChars then
		local short = string.gsub(name, "%s*%b()%s*$", "")
		line = "Unlocks " .. short
		if #line > maxChars then
			local first = string.match(short, "^(.-)%s+%+%s+")
			if first and #first > 0 then
				line = "Unlocks " .. first
			end
		end
	end
	return fitLine(line)
end

--[[ F11 (and F7): the Rebirth confirm modal columns. Built from ResetFor(path), so the lines always say what the
	server's DoPrestige does on that path. Lines are at most SummaryMaxLineChars (30) characters, use two spaces as the
	separator and never contain a middle dot or an arrow (phone fonts, short labels).
	  KEEP  (both) Robux items and passes / Gold (+50 Gold) / Vehicles and weapons / Soldiers and research /
	              Outposts and Empire Tax / Rebirth unlocks / Battle Pass progress;  KeepBase adds Base buildings and levels
	  RESET (both) Cash back to $10,000 / Level 1 and XP 0;  Cash adds Base buildings (N built) and, while
	              ctx.BusinessesOn, War businesses
	  GAIN  +10% cash forever / Total now +N% / Unlocks <next rebirth unlock> (when this rebirth gives one)
	PendingCash (the ATM) is kept on both paths and is not listed (owner decision). ]]
function PrestigeConfig.RebirthSummary(path: RebirthPath, ctx: RebirthSummaryCtx): RebirthSummary
	local reset = PrestigeConfig.ResetFor(path)
	local keep: { string } = {}
	local resetLines: { string } = {}
	local gain: { string } = {}
	local function add(list: { string }, text: string)
		table.insert(list, fitLine(text))
	end

	local goldBonus = math.max(0, math.floor(tonumber(PrestigeConfig.GoldBonusOnPrestige) or 0))
	add(keep, "Robux items and passes")
	if reset.KeepGold then
		add(keep, if goldBonus > 0 then string.format("Gold (+%d Gold)", goldBonus) else "Gold")
	end
	if reset.KeepVehicles and reset.KeepWeapons then
		add(keep, "Vehicles and weapons")
	elseif reset.KeepVehicles then
		add(keep, "Vehicles")
	elseif reset.KeepWeapons then
		add(keep, "Weapons")
	end
	add(keep, "Soldiers and research")
	add(keep, "Outposts and Empire Tax")
	if reset.KeepRebirthUnlocks then
		add(keep, "Rebirth unlocks")
	end
	add(keep, "Battle Pass progress")
	if not reset.BaseUpgrades then
		add(keep, "Base buildings and levels")
	end

	if reset.Cash then
		add(resetLines, "Cash back to $" .. withCommas(tonumber(PrestigeConfig.StartingCashAfterPrestige) or 0))
	else
		add(keep, "Your Cash")
	end
	if reset.Level and reset.XP then
		add(resetLines, "Level 1 and XP 0")
	elseif reset.Level then
		add(resetLines, "Level 1")
	elseif reset.XP then
		add(resetLines, "XP 0")
	end
	if reset.BaseUpgrades then
		add(resetLines, string.format("Base buildings (%d built)", math.max(0, math.floor(tonumber(ctx.Built) or 0))))
		if ctx.BusinessesOn == true then
			add(resetLines, "War businesses")
		end
	end

	local perPct = math.floor((tonumber(PrestigeConfig.CashBonusPerPrestige) or 0.10) * 100 + 0.5)
	local after = math.max(0, math.floor(tonumber(ctx.Prestige) or 0)) + 1
	add(gain, string.format("+%d%% cash forever", perPct))
	add(gain, string.format("Total now +%d%%", after * perPct))
	if typeof(ctx.NextUnlock) == "string" and ctx.NextUnlock ~= "" then
		table.insert(gain, unlockLine(ctx.NextUnlock))
	end
	-- claude-bud JOB 33: what else the next rebirth gives (only when the screen part is live: the server fills these)
	local x: any = ctx
	if typeof(x.Zone) == "string" and x.Zone ~= "" then
		add(gain, "New zone: " .. x.Zone)
	end
	if typeof(x.Soldiers) == "number" and x.Soldiers > 0 then
		add(gain, string.format("+%d army soldiers", x.Soldiers))
	end
	if typeof(x.StartCash) == "number" and x.StartCash > 0 and reset.Cash then
		resetLines[1] = fitLine("Cash back to $" .. withCommas(x.StartCash))
	end
	-- claude-bud JOB 39 (EndgameConfig, only when the server set them): Empire Level and upgrades are kept; the base
	-- costs more next life (the rebirth price scale)
	if x.EndgameKeep == true then
		add(keep, "Empire and upgrades")
	end
	if typeof(x.NextBase) == "number" and x.NextBase > 0 and reset.BaseUpgrades then
		add(resetLines, string.format("Next base $%.1fM", x.NextBase / 1e6))
	end
	if typeof(x.Gold) == "number" and x.Gold > 0 then
		for i, line in ipairs(keep) do
			if string.sub(line, 1, 4) == "Gold" then
				keep[i] = fitLine(string.format("Gold (+%d Gold)", x.Gold))
			end
		end
	end

	return { Keep = keep, Reset = resetLines, Gain = gain }
end

--[[ claude-bud JOB 33 pacing (RebirthConfig.LiveFor "Pacing"): later rebirths ask for a higher level, so each life takes
	longer than the one before even with the bigger cash multiplier and starting cash (tools/sim/rebirth_pacing_sim.py).
	MinLevelFor(p) = MinLevelToPrestige + MinLevelPerPrestige * p, at most MinLevelMax. ]]
PrestigeConfig.MinLevelPerPrestige = 4 -- claude-bud JOB 33: tools/sim/rebirth_pacing_sim.py (2 still let life 2 run faster than life 1)
PrestigeConfig.MinLevelMax = 90

function PrestigeConfig.MinLevelFor(prestige: number, pacingLive: boolean): number
	local base = PrestigeConfig.MinLevelToPrestige
	if not pacingLive then
		return base
	end
	local p = math.max(0, math.floor(tonumber(prestige) or 0))
	return math.min(PrestigeConfig.MinLevelMax, base + PrestigeConfig.MinLevelPerPrestige * p)
end

-- claude-bud JOB 33: the next `n` rebirths after `prestige`, one short line each ("R4  Drone Bay  Missile Boat"),
-- from the zones (RebirthConfig.Zones) and the unlock track. Display only.
function PrestigeConfig.NextRebirths(prestige: number, n: number, zoneNames: { [number]: string }?): { string }
	local out: { string } = {}
	local p = math.max(0, math.floor(tonumber(prestige) or 0))
	for r = p + 1, math.min(PrestigeConfig.MaxPrestige, p + 12) do
		if #out >= n then
			break
		end
		local bits: { string } = {}
		if zoneNames and zoneNames[r] then
			table.insert(bits, zoneNames[r])
		end
		for _, u in ipairs(PrestigeConfig.RebirthUnlocks) do
			if u.AtPrestige == r then
				local name = string.gsub(string.gsub(u.DisplayName or u.Flag, " %(owned%)", ""), " %(gun%)", "")
				table.insert(bits, name)
			end
		end
		if #bits > 0 then
			table.insert(out, fitLine(string.format("R%d  %s", r, table.concat(bits, "  "))))
		end
	end
	return out
end

return PrestigeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">QualityConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 8 (2026-09-29): the automatic LOW quality tier for phones (Client/Modules/QualityGovernor).
	Low turns on for a player it is live for when:
	  * the screen is small (viewport shorter side <= SmallScreenShortSide real px, i.e. a phone in landscape), or
	  * the frame rate stays under LowFpsBelow for LowFpsSeconds (and it goes back to normal only after RecoverSeconds
	    over RecoverFpsAbove, and never on a small screen).
	While low (client only; nothing replicates, the server world is unchanged):
	  * decoration clusters (WorldKits clusters: WE_Cluster, in the Folders below) are taken out of this client's world
	    beyond HideTier2BeyondStuds (Tier 2 = Full-quality extras) or HideAnyBeyondStuds (everything else), checked at
	    CheckHz with the camera focus (no per-frame work; the cluster list is built once and kept up to date);
	  * Lighting.GlobalShadows off on this client;
	  * the player attribute WE_LowQuality = true, which ProductionFx.IsLowFx() reads (cheaper effects).
	Rollout "owner" = AdminConfig.IsPlaytestOwner only, "all", anything else = off (the game as before).
]]

local QualityConfig = {
	Rollout = "all", -- v101
	SmallScreenShortSide = 480,
	LowFpsBelow = 28,
	LowFpsSeconds = 8,
	RecoverFpsAbove = 50,
	RecoverSeconds = 30,
	HideTier2BeyondStuds = 180,
	HideAnyBeyondStuds = 420,
	CheckHz = 1,
	ShadowsOffWhenLow = true,
	-- claude-bud JOB 24 §8 (owner: "town buildings vanish / pop when driving fast"): the cause was this governor, not
	-- instance streaming (StreamingEnabled is OFF). On a phone it is always LOW, and it took whole clusters out beyond
	-- 180 / 420 studs, checked once a second from the camera: at 60-100+ studs/s a building popped in late / vanished.
	--   * NeverHideKinds: WE_Cluster kinds (the part after "source:") that are buildings / landmarks: never hidden;
	--   * LookAheadSeconds: the distance is measured from where the camera will be this far ahead (its velocity);
	--   * FastHz: the check rate while the camera moves faster than FastStuds per second; ShowSlackStuds: hysteresis.
	NeverHideKinds = { "block", "tower", "landmark", "square", "town", "fort", "checkpoint", "motorpool", "mast", "ruins", "camp", "hold", "Booth" },
	LookAheadSeconds = 1.5,
	FastStuds = 30,
	FastHz = 3,
	ShowSlackStuds = 40,
	-- claude-bud JOB 27 (the city popping; QualityGovernor header): buildings are recognised by SIZE (their bounding box),
	-- never culled, nor the small clusters on them. CullTownBuildings = true brings back the old behaviour (kill switch).
	CullTownBuildings = false,
	BuildingMinStuds = 14, -- a cluster this wide / deep (bounding box) is a building
	BuildingMinHeight = 10, -- or this tall
	-- small decoration only: LOAD within / UNLOAD beyond (studs to its bounding box); nothing happens in between
	Tier2ShowStuds = 220,
	Tier2HideStuds = 320,
	AnyShowStuds = 480,
	AnyHideStuds = 640,
	CullSeconds = 0.4, -- the one cull manager's period ...
	FastCullSeconds = 0.2, -- ... while the camera moves faster than FastStuds per second
	DebugLog = false, -- true: "[BUILDING DEBUG] UNLOADING|LOADING ..." per change (Studio investigation)
	-- where the decoration lives (resolved from Workspace by name; missing ones are retried every few seconds)
	Folders = { "WorldFill", "WarEmpireSetup/WorldDressing", "WE_RebirthZones" } :: { string }, -- claude-bud JOB 33: + the rebirth zones
}

function QualityConfig.LiveFor(userId: any): boolean
	if (require(script.Parent.MonetizationConfig) :: any).Launched("QualityTier") then
		return true -- claude-bud JOB 12: MonetizationConfig.LaunchAll
	end
	local mode = QualityConfig.Rollout
	if mode == "all" then
		return true
	elseif mode == "owner" then
		return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
	end
	return false
end

return QualityConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">RaidConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v69 ATM raids + Command Center missile strikes — ONE balance file for both.
	Read by MoneyCollectorService (raids), MissileStrikeService (strikes), GateDefenseService (defense fixes).
	Clients do not require this file (every number they show arrives in a remote payload).

	Timers that must survive leaving / rejoining / server hopping live on the profile as os.time() values:
	  profile.Raid.ShieldUntil          victim: no raids (and no strikes) until then
	  profile.Raid.RaidCooldownUntil    thief: next raid allowed at (new key; missing → 0)
	  profile.Raid.StrikeCooldownUntil  attacker: next missile allowed at
	  profile.Raid.DefensesDownUntil    victim: GateDefense guards/AutoGuns/gate are down until then
]]

local RaidConfig = {
	Raid = {
		Enabled = true,
		StealFraction = 0.10, -- owner rule: 10% of what is in the victim's ATM
		MinVictimBalance = 100, -- ATM must hold at least this much to be robbed
		MinSteal = 1,
		HoldSeconds = 6, -- stand at the victim's ATM this long: on foot, alive, not damaged
		RadiusStuds = 10, -- horizontal distance from the ATM body (same as the collect radius)
		MaxHeightDelta = 14,
		DamageCancelHp = 0.5, -- a health drop bigger than this between two ticks cancels the hold
		ShieldSeconds = 600, -- owner rule: the victim cannot be robbed again for 10 minutes
		ThiefCooldownSeconds = 60, -- per thief, after a successful raid (any victim)
		NewPlayerProtectionSeconds = 600, -- since profile.FirstJoinUnix
		ProtectNewPlayersInStudio = false, -- Studio test servers make fresh profiles every run
		RequireOnFoot = true, -- Humanoid.SeatPart must be nil
		AllowAllies = false, -- clan-mates cannot rob each other
		TeleportStuds = 60, -- HRP moved further than this in one 0.25 s tick (on foot, same character) → teleport
		TeleportLockoutSeconds = 15,
		AutoCollectCountsRecentIncome = true, -- AutoCollect is not raid immunity (see spec §1.5)
		AutoCollectWindowSeconds = 600,
		-- v82 ATM fix: the ATM screen shows only the cash waiting to be collected (PendingCash). true = the old v69-v81
		-- screen (the raidable balance: for AutoCollect owners it also counted the last AutoCollectWindowSeconds of
		-- income already in the wallet, so the screen kept growing and nothing could be collected). Raids are unchanged.
		AtmScreenCountsRecentIncome = false,
		HoldPushInterval = 0.25, -- AtmRaidStateUpdate "Holding" cadence to the thief
		AlarmPushInterval = 1.0, -- "Alarm" cadence to the victim
		BlockedPushInterval = 3, -- same "Blocked" reason is re-sent at most this often
		VictimAlarmToastCooldown = 15,
	},

	Strike = {
		Enabled = true,
		-- "the upgrade": Command Center L3 + Missile Defense L1 (Missile Defense needs Radar L2 → CC L2)
		Unlock = { CommandCenter = 3, MissileDefense = 1 } :: { [string]: number },
		Cost = 5000,
		CooldownSeconds = 600, -- attacker, after a launch (profile.Raid.StrikeCooldownUntil)
		InterceptedCooldownSeconds = 300, -- attacker cooldown when the missile was shot down
		LaunchMaxDistanceFromCC = 45, -- server check: attacker HRP (horizontal) from own Command Center site
		MissileSpeed = 220, -- studs/s → flight = clamp(distance / speed, Min, Max)
		MinFlightSeconds = 5,
		MaxFlightSeconds = 9,
		ArcHeightMin = 150,
		ArcHeightFactor = 0.35, -- arc apex = clamp(distance * factor, Min, Max) above the chord midpoint
		ArcHeightMax = 400,
		DefensesDownSeconds = 120, -- at attacker CC L3
		DownBonusPerCCLevel = 30, -- per attacker CC level above 3 → L4 150 s, L5 180 s
		PostDownImmunitySeconds = 300, -- no new strike on a base until DefensesDownUntil + this
		-- victim Missile Defense level → chance the strike is shot down
		InterceptChanceByLevel = { [0] = 0, [1] = 0.15, [2] = 0.25, [3] = 0.35, [4] = 0.45, [5] = 0.55 } :: { [number]: number },
		PenetrationPerAttackerMDLevel = 0.05, -- per attacker MD level above 1 (L5 → −0.20)
		MaxInterceptChance = 0.75,
		InterceptAtMin = 0.72, -- interceptor meets the missile at this fraction of the flight (random in [min, max])
		InterceptAtMax = 0.84,
		RefundIfTargetLeaves = true,
		RequestRate = 2, -- RequestMissileStrike, all actions (tokens/s)
		RequestBurst = 4,
		LaunchRate = 0.5, -- "Launch" additionally
		LaunchBurst = 2,
	},

	Defense = {
		-- guards stand this far INSIDE the gate line (toward PlayerSpawn). Measured on the v68 map: guns at 7.5 keep
		-- 4.35 studs off the L5 wall face (half-thickness 3.15) and clear the checkpoint boom post; guards at 10
		-- stand clear of the gun tripods and the booth / jersey barriers (spec had 8 / 7: guns 3.85 from the L5 wall)
		GuardPostInsideStuds = 10,
		AutoGunInsideStuds = 7.5,
		GateOpenRadius = 12, -- an ally within this (horizontal) of the gate centre opens the barrier
		-- vscale R2: an ally seated in a car whose Roblox-size body is longer than its kit opens it from further out:
		-- + the body's overhang (WE_VisualHalfLength - WE_HalfLength) + this (the moved seats sit up to 1.1 further back)
		GateOpenVehicleLead = 1.5,
		GateOpenHeight = 12,
		GateCloseDelay = 1.0,
		LosRespectCanCollide = true, -- guard/AutoGun line of sight ignores non-collidable decor
		EngageIntrudersInsideWalls = true, -- any non-ally inside the plot walls is in aggro
		GuardHitMaxDistance = 150, -- weapon hits on guards: attacker HRP within this of the guard
		ResearchStat = "TurretDamage", -- ResearchService.GetBonus(owner, stat) × guard + AutoGun damage
		MaxResearchMult = 5,
	},

	Text = {
		-- raids (thief)
		RaidHolding = "ROBBING %s's ATM · %.1f/%ds — don't get hit!",
		RaidSuccess = "ATM RAID +$%s from %s → your ATM",
		RaidHit = "Hit! Raid interrupted — clear the defenders first",
		RaidLeft = "Left the ATM — raid cancelled",
		RaidVictimLeft = "The owner left the server",
		RaidEmptied = "The owner emptied the ATM",
		RaidDead = "You went down — raid cancelled",
		RaidHint = "Stand on %s's ATM for %ds to rob it — don't get hit",
		-- raids (victim)
		RaidAlarm = "⚠ %s is robbing your ATM!",
		RaidRobbed = "ATM RAIDED by %s −$%s · 🛡 shield %s",
		RaidDefended = "Raid on your ATM stopped",
		-- raid blocked reasons
		Blocked = {
			Disabled = "Raids are switched off",
			Ally = "Clan ally's ATM — can't rob allies",
			NoBase = "Get a base first — loot goes to your ATM",
			ThiefLoading = "Your save is still loading",
			VictimLoading = "Their save is still loading",
			Shielded = "🛡 Robbed recently — shielded %s",
			NewPlayer = "New player protection — %s",
			LowBalance = "ATM almost empty ($%s)",
			ThiefCooldown = "Raid cooldown %s",
			Seated = "Get out of the vehicle to rob the ATM",
			Teleport = "Raid blocked — moved too fast",
		} :: { [string]: string },
		-- strikes
		StrikeLocked = "Needs Command Center L%d + Missile Defense L%d",
		StrikeLaunched = "Missile away → %s · impact %ds",
		StrikeHit = "Direct hit! %s's defenses down %s — go raid!",
		StrikeIntercepted = "Intercepted by %s's Missile Defense",
		StrikeRefunded = "%s left — missile refunded",
		StrikeIncoming = "⚠ INCOMING MISSILE from %s — impact %ds",
		StrikeVictimHit = "💥 Missile hit! Defenses down %s — protect your ATM!",
		StrikeVictimIntercepted = "✓ Your Missile Defense shot down %s's missile",
		DefensesBack = "Defenses back online",
		StrikeReasons = {
			Locked = "Needs Command Center L3 + Missile Defense L1",
			NotAtCommandCenter = "Use the Missile Command terminal in your Command Center",
			NoBase = "You need a base",
			Loading = "Your save is still loading",
			Cooldown = "Reloading — %s",
			InFlight = "Your missile is still in the air",
			InsufficientCash = "Need $%s",
			Self = "That's your base",
			Ally = "Clan ally",
			TargetOffline = "Player left",
			TargetLoading = "Their save is still loading",
			NewPlayer = "New player protection — %s",
			Shielded = "🛡 Shielded %s",
			AlreadyDown = "Defenses already down %s",
			Recovering = "Defenses rebooting — %s",
			Incoming = "Another missile is inbound",
			NoDefenses = "No defenses to hit — just raid the ATM",
			Busy = "Too fast — try again",
			Disabled = "Missile strikes are switched off",
		} :: { [string]: string },
	},
}

-- "m:ss" for countdowns (0 → "0:00")
function RaidConfig.FormatTime(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- Chance (0..MaxInterceptChance) that a strike from an attacker with Missile Defense `attackerMd` is shot down
-- by a victim with Missile Defense `victimMd`.
function RaidConfig.InterceptChance(victimMd: number, attackerMd: number): number
	local s = RaidConfig.Strike
	local lv = math.clamp(math.floor(victimMd), 0, 5)
	local base = s.InterceptChanceByLevel[lv] or 0
	local pen = math.max(0, math.floor(attackerMd) - 1) * s.PenetrationPerAttackerMDLevel
	return math.clamp(base - pen, 0, s.MaxInterceptChance)
end

-- Seconds a hit keeps the target's defenses down, from the attacker's Command Center level.
function RaidConfig.DownSeconds(attackerCc: number): number
	local s = RaidConfig.Strike
	local above = math.max(0, math.floor(attackerCc) - s.Unlock.CommandCenter)
	return s.DefensesDownSeconds + above * s.DownBonusPerCCLevel
end

function RaidConfig.FlightSeconds(distance: number): number
	local s = RaidConfig.Strike
	return math.clamp(distance / s.MissileSpeed, s.MinFlightSeconds, s.MaxFlightSeconds)
end

function RaidConfig.ArcHeight(distance: number): number
	local s = RaidConfig.Strike
	return math.clamp(distance * s.ArcHeightFactor, s.ArcHeightMin, s.ArcHeightMax)
end

-- claude-bud JOB 63: anti-spawn-camping (Server/Services/AntiCampService), keyed by the BASE OWNER. OFF = today.
(RaidConfig :: any).AntiCamp = {
	Enabled = true,
	OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 63): Code Bot flips it after Shaun's phone test
	DefenderShieldSeconds = 5, -- a respawn at his own base: the spawn shield this long (his first shot ends it)
	RaiderLimitSeconds = 90, -- inside an enemy base this long -> back to his own base (the normal respawn)
	AfterLootSeconds = 3, -- his raid took the loot -> home this long after
	SameBaseCooldownSeconds = 180, -- then no re-entry and no damage to that base / its owner for this long
	RepeatKills = 3, -- the same defender killed this many times ...
	RepeatWindowSeconds = 60, -- ... in this window -> home early
	EdgeStuds = 24, -- the base-edge cooldown toast within this of a cooled base
	EdgeToastEverySeconds = 12,
	TickSeconds = 1,
	Text = {
		time = "Raid time up: back to your base",
		loot = "Loot taken: back to your base",
		kills = "Stop spawn camping: back to your base",
		cooldown = "That base is on cooldown: back to your base",
		edge = "Base cooldown %s",
	},
}

return RaidConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">RatePromptConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 40 part D (2026-09-30): the "Enjoying WAR EMPIRE?" reminder. NO REWARD of any kind: Roblox forbids
	rewarding a like / favourite, there is no API to see a like, and nothing here claims or checks one.
	The server decides when (Services/RatePromptService); the client only shows the card and reports the button
	(Controllers/RatePromptController). OFF (Enabled = false, or not live for the player) = nothing shows; the Shop's
	"Favorite WAR EMPIRE" row is unchanged either way.
]]

local RatePromptConfig = {
	Enabled = true, -- kill switch
	OwnerFirst = false, -- codebot_v166 flip-all-live (owner 2026-10-01 10:31): everyone

	PlaySecondsBeforeShow = 900, -- 15 min of total play (RatePrompt.PlaySeconds, across sessions)
	MinGapSeconds = 259200, -- 3 days between shows
	CombatQuietSeconds = 20, -- no damage taken for this long (server); the client also waits out its RecentCombat
	NotBeforeSessionSeconds = 60, -- never in the first minute of a session
	-- a TRIGGER shows it early (still under every other rule): every rebirth, and the achievements that already
	-- show a big banner (AchievementConfig Big = true: $100M, Plaza capture, nuke, weekly #1, ...)
	Triggers = { rebirth = true, achievement = true, FirstCapture = true, RaidWin = true },
	-- claude-bud JOB 41 part D: these big wins bring it forward ONCE per profile (RatePrompt.Triggered[<name>] = true
	-- when it showed for that reason); FirstCapture = the Guided reward capture or any first territory, RaidWin = the
	-- first raid that looted (a SEND or an in-person ATM raid)
	OneTimeTriggers = { FirstCapture = true, RaidWin = true },
	AfterOtherCardSeconds = 20, -- never two cards at once: wait this long after the Recruit Pack card closed
	WaitForPackMaxSeconds = 180, -- a Recruit Pack still due at the capture goes first; the rate card waits at most this
	TriggerDelaySeconds = 8, -- after the rebirth screen / the banner has had its moment
	TickSeconds = 5, -- the server check (all players together)
	AutoHideSeconds = 20, -- the card hides itself (counts as shown)
	ClientWaitMaxSeconds = 90, -- the client waits for a free screen at most this long, then drops it ("timeout")

	Answers = { later = true, never = true, favorite = true, timeout = true }, -- the only RequestRatePromptAnswer values

	Text = {
		Title = "Enjoying WAR EMPIRE?",
		Body = "Tap 👍 on the game page. It really helps!",
		Favorite = "⭐ Favorite",
		Later = "Maybe later",
		Never = "Don't show again",
	},
}

function RatePromptConfig.LiveFor(userId: any): boolean
	return (require(script.Parent.RetentionConfig) :: any).Live(RatePromptConfig, userId)
end

return RatePromptConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">RebirthConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v71 money (M2): Rebirth expansion.
	Zones that open with rebirth, per-rebirth perks, base trims, titles, and the Robux hook keys. Geometry lives in
	BaseLayoutConfig (M7b, using the waterways PlotCFrame / PlotLocalCFrame helpers, J18); each rebirth structure
	names its zone in BaseConfig.Structures[id].Zone (M7a).

	Pure helpers only. The server is the authority (RebirthExpansionService, PrestigeService, BaseService);
	the client calls the same helpers for display and never trusts them for grants.
	Config only: nothing reads this file yet. ZonesLive / WeaponsLive stay false until the M7b + M7d publish.

	Judge rulings applied (money/plan.md §1):
	- J12: the Expansion Permit and Rebirth Skip products are cut this round (no config entries, no
	  NextPermitZone, no profile counters). Revisit after 2 weeks of rebirth KPIs.
	  Superseded in part by the owner's 11 features (F7, ASSUMPTIONS): the 50 R$ Keep-Base Rebirth
	  (MonetizationConfig.DevProducts.RebirthKeepBase) is a consumable token counted in profile.KeepBaseRebirths and
	  spent by PrestigeService (PrestigeConfig.KeepBase); the rebirth runs after the receipt is saved, never inside it.
	  The Expansion Permit stays cut.
	- J13: Rebirth Boost is +15% cash per rebirth (instead of +10%) and 1.5x starting cash. Gold stays x1
	  (Boost.GoldMult = 1) until a Gold sink ships; then raise it together with the pass description. ]]

export type ZoneDef = {
	Id: string,
	Tier: number, -- opens at Prestige >= Tier
	DisplayName: string,
	Structures: { string },
	Parent: string?, -- nested zone (DroneBay sits inside StrategicYard)
}

export type TrimDef = {
	Id: string,
	DisplayName: string,
	MinPrestige: number,
	Trim: Color3, -- building trim, gate lintel, fence posts, flag finials
	Accent: Color3, -- banner field, sign text
	Gold: Color3, -- parapet caps / edge bands (HollowBuildingBuilder Colors.Gold)
	GoldCapAllLevels: boolean, -- gold parapet on every walk-in from L1 (not only L5)
	NeonEdge: boolean, -- thin neon strip along the plot pad edge
}

local RebirthConfig = {
	Enabled = true,
	-- Publish switches. claude-bud JOB 33 builds what they switch on (RebirthZoneService / NukeService / the rebirth
	-- guns); each part still goes through the owner-first gate below (RebirthConfig.LiveFor).
	-- claude-bud JOB 33: ZonesLive / WeaponsLive = PUBLISHED FOR EVERYONE (codebot_v101 keeps them false). While
	-- Live.OwnerFirst is true the owner (+ Studio) gets the zones and guns anyway; to launch, Code Bot sets OwnerFirst =
	-- false AND these two true.
	ZonesLive = true, -- codebot_v131 launch: published for everyone (JOB 33 handoff)
	WeaponsLive = true, -- codebot_v131 launch: published for everyone (JOB 33 handoff)
	--[[ claude-bud JOB 33: the owner-first gate of the whole rebirth overhaul. Enabled = false: every part off (the
		rebirth exactly as before). OwnerFirst = true: live only for the owner (+ Studio test players). Parts can be
		switched off one by one. ]]
	Live = {
		Enabled = true,
		OwnerFirst = false, -- codebot_v131 launch: everyone (JOB 33 handoff)
		Parts = {
			Zones = true, -- RebirthZoneService: zones, locked fences, buildings, their effects
			Nuke = true, -- NukeService: silo charging, launch, blast
			Weapons = true, -- the rebirth gun grants
			Vehicles = true, -- the added land-vehicle grants + granted vehicles usable at once
			Perks = true, -- +2 soldiers / rebirth, starting cash steps, gold 50 + 10 / rebirth
			Trims = true, -- rank banners at the gate, the title above the head and on the base sign
			Pacing = true, -- later rebirths need a higher level (PrestigeConfig.MinLevelFor)
			Screen = true, -- the richer KEEP / RESET / GAIN + next 3 rebirths on the rebirth screen
		} :: { [string]: boolean },
	},

	Zones = {
		WestYard = { Id = "WestYard", Tier = 1, DisplayName = "West Yard", Structures = { "TankFactory" } },
		StrategicYard = { Id = "StrategicYard", Tier = 2, DisplayName = "Strategic Yard", Structures = { "NuclearSilo" } },
		WestStrip = { Id = "WestStrip", Tier = 3, DisplayName = "West Battery", Structures = { "ArtilleryBattery" } },
		DroneBay = {
			Id = "DroneBay",
			Tier = 4,
			DisplayName = "Drone Bay",
			Structures = { "DroneHangar" },
			Parent = "StrategicYard",
		},
		EastYard = { Id = "EastYard", Tier = 5, DisplayName = "East Yard", Structures = { "EliteBarracks" } },
		EastStrip = { Id = "EastStrip", Tier = 6, DisplayName = "Refinery Row", Structures = { "OilRefinery" } },
		WestFlank = { Id = "WestFlank", Tier = 8, DisplayName = "West Flank", Structures = { "BunkerComplex" } },
	} :: { [string]: ZoneDef },
	ZoneOrder = { "WestYard", "StrategicYard", "WestStrip", "DroneBay", "EastYard", "EastStrip", "WestFlank" },

	Perks = {
		-- Army cap: +2 soldiers per rebirth (cap +40). Elite Barracks adds +5 per level on top (BaseConfig Effects).
		SoldiersPerPrestige = 2,
		MaxPrestigeSoldierBonus = 40,
		-- Cash you start each new run with: highest key <= Prestige wins (replaces the flat 10,000).
		StartingCashSteps = {
			{ AtPrestige = 1, Cash = 25_000 },
			{ AtPrestige = 2, Cash = 35_000 },
			{ AtPrestige = 3, Cash = 50_000 },
			{ AtPrestige = 4, Cash = 65_000 },
			{ AtPrestige = 5, Cash = 80_000 },
			{ AtPrestige = 6, Cash = 100_000 },
			{ AtPrestige = 10, Cash = 150_000 },
			{ AtPrestige = 20, Cash = 250_000 },
		},
		-- Gold on each rebirth: 50 + 10 per rebirth, max 250 (was a flat 50).
		GoldBase = 50,
		GoldPerPrestige = 10,
		GoldMax = 250,
		-- Rebirth grants in PrestigeConfig.RebirthUnlocks (GrantOwned vehicles) can be spawned at any Level /
		-- structure level: a reward you cannot use until you re-level is not a reward.
		GrantedVehiclesIgnoreRunGates = true,
	},

	-- Robux hooks. Keys point at MonetizationConfig entries; every one is hidden while its Id is 0.
	Boost = {
		GamePassKey = "RebirthBoost", -- NEW game pass (M1 adds the key with Id = 0; created OFF sale, J3)
		ExtraCashPerPrestige = 0.05, -- +15% per rebirth instead of +10% (retroactive: applies to past rebirths)
		GoldMult = 1, -- J13: Gold has no sink yet; x2 only with a Gold sink + a pass description update
		StartingCashMult = 1.5,
	},
	EliteThemePassKey = "ExtraPlotCosmetic", -- EXISTING live pass "Elite Base Theme" (Id 1983357731), finally implemented

	Trims = {
		{
			Id = "Standard",
			DisplayName = "Standard",
			MinPrestige = 0,
			Trim = Color3.fromRGB(78, 92, 62),
			Accent = Color3.fromRGB(230, 196, 70),
			Gold = Color3.fromRGB(240, 196, 64),
			GoldCapAllLevels = false,
			NeonEdge = false,
		},
		{
			Id = "Bronze",
			DisplayName = "Bronze",
			MinPrestige = 1,
			Trim = Color3.fromRGB(150, 98, 52),
			Accent = Color3.fromRGB(214, 150, 86),
			Gold = Color3.fromRGB(205, 127, 50),
			GoldCapAllLevels = false,
			NeonEdge = false,
		},
		{
			Id = "Silver",
			DisplayName = "Silver",
			MinPrestige = 3,
			Trim = Color3.fromRGB(150, 156, 164),
			Accent = Color3.fromRGB(222, 228, 236),
			Gold = Color3.fromRGB(196, 202, 210),
			GoldCapAllLevels = false,
			NeonEdge = false,
		},
		{
			Id = "Gold",
			DisplayName = "Gold",
			MinPrestige = 5,
			Trim = Color3.fromRGB(176, 140, 44),
			Accent = Color3.fromRGB(255, 214, 90),
			Gold = Color3.fromRGB(240, 196, 64),
			GoldCapAllLevels = true,
			NeonEdge = false,
		},
		{
			Id = "Platinum",
			DisplayName = "Platinum",
			MinPrestige = 10,
			Trim = Color3.fromRGB(200, 210, 220),
			Accent = Color3.fromRGB(120, 220, 255),
			Gold = Color3.fromRGB(226, 234, 242),
			GoldCapAllLevels = true,
			NeonEdge = true,
		},
		{
			Id = "Obsidian",
			DisplayName = "Obsidian",
			MinPrestige = 20,
			Trim = Color3.fromRGB(34, 34, 40),
			Accent = Color3.fromRGB(255, 196, 64),
			Gold = Color3.fromRGB(255, 196, 64),
			GoldCapAllLevels = true,
			NeonEdge = true,
		},
	} :: { TrimDef },
	-- Elite Base Theme pass: at least Gold at any Prestige; Platinum+ players keep their higher trim.
	EliteThemeMinTrim = "Gold",

	-- Cosmetic dressing unlocked by rebirth count (all Part-built, <= 40 parts per plot in total).
	Dressing = {
		GateBannersAt = 1, -- two vertical banners either side of the main gate: "★ n"
		CommandCenterBannerAt = 3,
		WalkInBannersAt = 5, -- one banner on every walk-in facade
		EmpireBeaconAt = 10, -- a tall light beam from the Command Center roof, visible across the map
		JoinFireworksAt = 25,
		CommanderStatueAt = 50,
	},

	Titles = {
		{ AtPrestige = 1, Title = "Veteran" },
		{ AtPrestige = 3, Title = "Commander" },
		{ AtPrestige = 5, Title = "General" },
		{ AtPrestige = 10, Title = "Marshal" },
		{ AtPrestige = 20, Title = "Legend" },
		{ AtPrestige = 30, Title = "Mythic" },
		{ AtPrestige = 50, Title = "Supreme Commander" },
	},
	LeaderstatName = "Rebirths",

	-- How a locked zone looks (StructureKitBuilder.SyncExpansionZones)
	LockedLook = {
		FenceHeight = 8,
		PostSpacing = 16,
		PostColor = Color3.fromRGB(58, 60, 58),
		MeshColor = Color3.fromRGB(40, 42, 40),
		MeshTransparency = 0.55,
		HazardColor = Color3.fromRGB(230, 196, 70),
		SignColor = Color3.fromRGB(170, 28, 28),
		HologramColor = Color3.fromRGB(88, 200, 255),
		HologramTransparency = 0.7,
		LabelMaxDistance = 60, -- WorldLabelPolicy
	},
}

local function stepValue(steps: { { AtPrestige: number, Cash: number } }, prestige: number, default: number): number
	local best = default
	for _, s in ipairs(steps) do
		if prestige >= s.AtPrestige then
			best = s.Cash
		end
	end
	return best
end

-- claude-bud JOB 33: is `part` of the rebirth overhaul live for this player (fail closed)
function RebirthConfig.LiveFor(userId: any, part: string): boolean
	local L: any = RebirthConfig.Live
	if RebirthConfig.Enabled ~= true or typeof(L) ~= "table" or L.Enabled ~= true or L.Parts[part] ~= true then
		return false
	end
	if L.OwnerFirst ~= true then
		-- published for everyone: the zones and the guns also need their publish switch
		if part == "Zones" or part == "Nuke" then
			return RebirthConfig.ZonesLive == true
		elseif part == "Weapons" then
			return RebirthConfig.WeaponsLive == true
		end
		return true
	end
	local okR, RS = pcall(function(): any
		return game:GetService("RunService")
	end)
	if okR and RS and RS:IsStudio() then
		return true
	end
	return (require(script.Parent.AdminConfig) :: any).IsPlaytestOwner(userId)
end

-- Zone id for a structure, or nil for the 15 base structures.
function RebirthConfig.ZoneOfStructure(structureId: string): string?
	for id, z in pairs(RebirthConfig.Zones) do
		for _, sid in ipairs(z.Structures) do
			if sid == structureId then
				return id
			end
		end
	end
	return nil
end

-- A zone is open when Prestige reached its tier. `extraOpen` is a session-only override (the admin `openzone`
-- command); the Expansion Permit that used to feed it was cut (J12). A nested zone also needs its parent open.
function RebirthConfig.IsZoneOpen(prestige: number, extraOpen: { [string]: boolean }?, zoneId: string): boolean
	if not RebirthConfig.Enabled then
		return false
	end
	local z = RebirthConfig.Zones[zoneId]
	if not z then
		return false
	end
	local open = prestige >= z.Tier or (extraOpen ~= nil and extraOpen[zoneId] == true)
	if open and z.Parent ~= nil then
		return RebirthConfig.IsZoneOpen(prestige, extraOpen, z.Parent)
	end
	return open
end

-- Structures outside every zone are always "open".
function RebirthConfig.IsStructureOpen(prestige: number, extraOpen: { [string]: boolean }?, structureId: string): boolean
	local zoneId = RebirthConfig.ZoneOfStructure(structureId)
	if zoneId == nil then
		return true
	end
	return RebirthConfig.IsZoneOpen(prestige, extraOpen, zoneId)
end

function RebirthConfig.StartingCash(prestige: number, boosted: boolean): number
	local cash = stepValue(RebirthConfig.Perks.StartingCashSteps, prestige, 10_000)
	if boosted then
		cash = math.floor(cash * RebirthConfig.Boost.StartingCashMult)
	end
	return cash
end

function RebirthConfig.GoldBonus(prestige: number, boosted: boolean): number
	local p = RebirthConfig.Perks
	local gold = math.min(p.GoldMax, p.GoldBase + p.GoldPerPrestige * math.max(0, prestige - 1))
	if boosted then
		gold *= RebirthConfig.Boost.GoldMult
	end
	return math.floor(gold)
end

-- +cash per rebirth as a fraction (0.10, or 0.15 with Rebirth Boost). Callers apply 1 + prestige * this.
function RebirthConfig.CashBonusPerPrestige(baseBonus: number, boosted: boolean): number
	if boosted then
		return baseBonus + RebirthConfig.Boost.ExtraCashPerPrestige
	end
	return baseBonus
end

function RebirthConfig.PrestigeSoldierBonus(prestige: number): number
	local p = RebirthConfig.Perks
	return math.min(p.MaxPrestigeSoldierBonus, math.max(0, prestige) * p.SoldiersPerPrestige)
end

function RebirthConfig.TrimFor(prestige: number, eliteThemePass: boolean): TrimDef
	local best = RebirthConfig.Trims[1]
	for _, t in ipairs(RebirthConfig.Trims) do
		if prestige >= t.MinPrestige then
			best = t
		end
	end
	if eliteThemePass then
		local floorIdx = 1
		local bestIdx = 1
		for i, t in ipairs(RebirthConfig.Trims) do
			if t.Id == RebirthConfig.EliteThemeMinTrim then
				floorIdx = i
			end
			if t.Id == best.Id then
				bestIdx = i
			end
		end
		if bestIdx < floorIdx then
			best = RebirthConfig.Trims[floorIdx]
		end
	end
	return best
end

function RebirthConfig.TitleFor(prestige: number): string?
	local title: string? = nil
	for _, t in ipairs(RebirthConfig.Titles) do
		if prestige >= t.AtPrestige then
			title = t.Title
		end
	end
	return title
end

return RebirthConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">RebirthZonesConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	claude-bud JOB 33 (2026-09-30): the 7 REBIRTH ZONES (RebirthConfig.Zones: which rebirth opens which) as add-on
	complexes ATTACHED to the base. The 320 x 320 plot is full (buildings, runway, helipad, dock), so each zone is an
	annex yard just outside the plot, on the side its name says:
	  * West Yard / West Battery / West Flank on the west side (-X);
	  * East Yard / Refinery Row on the east side (+X);
	  * the Strategic Yard (the silo) and the Drone Bay at the rear (-Z).
	Each annex front faces the base.

	Server RebirthZoneService builds them for the plot's owner (Modules/RebirthZoneBuilder) when his base is ready,
	after a rebirth and after an upgrade:
	  * a zone he has not reached shows a fence and a sign "Unlocks at Rebirth N";
	  * a reached zone shows a foundation with a BUILD console;
	  * levels 1-3 visibly grow the complex (more halls, guns, drones, towers, storeys). A maxed rebirth base reads bigger
	    and better from a distance.
	Every building earns or does something real (Effects, server-side). The upgrades are paid in Cash at the console
	(SpendCash, reason "rebirth_zone_<Id>"), are kept through rebirths (profile.RebirthZones) and are never Robux.

	Placement: at plot-ready each annex footprint is checked once:
	  * procedural decor (travel dressing / world fill clusters) inside it is cleared;
	  * a road, POI, site, building or anything else inside it blocks that one annex on that plot (logged), so it never
	    lands on top of something;
	  * off dry land = blocked.

	Kill switch: RebirthConfig.Live.Parts.Zones / RebirthConfig.ZonesLive (and the owner-first gate).
]]

export type Annex = { X: number, Z: number, W: number, D: number, Yaw: number }
export type ZoneLevels = {
	Name: string, -- the building
	Short: string, -- one line for the console (what it does)
	Cost: { number }, -- Cash per level 1..3
	IncomePerTick: { number }?, -- + Cash per passive tick (before the cash multiplier), per level
	Soldiers: { number }?, -- + army cap, per level
	MissileReloadCut: { number }?, -- seconds off the missile strike reload, per level
	AutoCollectSeconds: { number }?, -- the drones empty your ATM this often, per level
	RaidShieldBonus: { number }?, -- seconds added to your raid shield after an ATM raid, per level
	SiloCapacity: { number }?, -- warheads held, per level
	SiloChargeMinutes: { number }?, -- minutes to charge one warhead, per level
}

local RebirthZonesConfig = {
	MaxLevel = 3,
	FolderName = "WE_RebirthZones",
	-- plot-local annex frames (studs; the plot edge is +-160). Yaw = the direction the annex front faces (BaseLayout
	-- convention: 0 = +Z, 90 = +X, -90 = -X)
	Annex = {
		WestYard = { X = -218, Z = 100, W = 74, D = 60, Yaw = 90 },
		WestStrip = { X = -218, Z = 10, W = 74, D = 60, Yaw = 90 },
		WestFlank = { X = -218, Z = -80, W = 74, D = 60, Yaw = 90 },
		EastYard = { X = 218, Z = 100, W = 74, D = 60, Yaw = -90 },
		EastStrip = { X = 218, Z = 10, W = 74, D = 60, Yaw = -90 },
		StrategicYard = { X = -50, Z = -218, W = 74, D = 60, Yaw = 0 },
		DroneBay = { X = 60, Z = -218, W = 74, D = 60, Yaw = 0 },
	} :: { [string]: Annex },
	-- procedural decor the placement check may clear (WE_Cluster sources); anything else blocks the annex
	ClearableSources = { rhythm = true, junction = true, shore = true, scatter = true, bay = true, fill = true, fill2 = true } :: { [string]: boolean },

	Zones = {
		WestYard = { Name = "Tank Factory", Short = "Cash every tick", Cost = { 60000, 180000, 500000 }, IncomePerTick = { 150, 350, 700 } },
		StrategicYard = { Name = "Nuclear Silo", Short = "Charges a nuke", Cost = { 250000, 750000, 2000000 }, SiloCapacity = { 1, 2, 3 }, SiloChargeMinutes = { 60, 45, 30 } },
		WestStrip = { Name = "Artillery Battery", Short = "Faster missile reload", Cost = { 90000, 270000, 700000 }, IncomePerTick = { 60, 150, 300 }, MissileReloadCut = { 90, 180, 270 } },
		DroneBay = { Name = "Drone Hangar", Short = "Drones empty your ATM", Cost = { 110000, 330000, 850000 }, IncomePerTick = { 40, 100, 200 }, AutoCollectSeconds = { 60, 40, 25 } },
		EastYard = { Name = "Elite Barracks", Short = "+5 soldiers a level", Cost = { 130000, 390000, 1000000 }, IncomePerTick = { 50, 120, 250 }, Soldiers = { 5, 10, 15 } },
		EastStrip = { Name = "Oil Refinery", Short = "Big Cash every tick", Cost = { 150000, 450000, 1200000 }, IncomePerTick = { 250, 600, 1200 } },
		WestFlank = { Name = "Bunker Complex", Short = "Longer raid shield", Cost = { 200000, 600000, 1500000 }, IncomePerTick = { 80, 200, 400 }, RaidShieldBonus = { 120, 240, 360 } },
	} :: { [string]: ZoneLevels },

	--[[ The nuke (NukeService; numbers tied to NukeConfig where it has them: Kinds.Nuke.Radius, CountdownSeconds,
		Rules.NewPlayerProtection). Launch from the silo console at the Central Plaza, an outpost or an enemy site (never
		within BaseClearStuds of any base: bases are never nuked). Siren + countdown for everyone, then one blast
		through CombatService.ApplyRadiusDamage (THE shared PvP rule: novice shields, spawn protection, clan allies and
		pvp-off all respected; NPCs hit). Long cooldowns. Rush: finish the current warhead for Cash. ]]
	Nuke = {
		Damage = 260, -- at the centre; MinMult at the edge
		MinMult = 0.15,
		PlayerCooldownSeconds = 1800,
		ServerCooldownSeconds = 300,
		BaseClearStuds = 360,
		RushCashPerMinute = 4000,
		SirenSoundId = "", -- a Roblox-uploaded siren sound id (owner fills it; "" = the visual siren only)
		MaxTargets = 10,
	},
	--[[ claude-bud JOB 65: the NUKE INSTANT RAID (NukeService.RaidPreview / RaidLaunch). A player with the silo (rebirth
		unlock, built) nukes a rival's HOME BASE: an instant successful raid that moves the target's FULL raidable ATM
		(MoneyCollectorService.GetRaidableBalance, the same number the preview shows) into the attacker's Cash through
		the raid payout path (MoneyCollectorService.NukeRaid: the 1:1 ATM transfer, never multiplied, so no Double
		Weekend / VIP / boost on a transfer). Fairness: the raid checks (ally, new player, shield, low balance), the
		shared protection (spawn / novice shield), never an admin, the JOB 63 same-base cooldown. Saved state: the
		existing NukeSilo warheads + NukeLastLaunch (no new save keys). Owner-first by the ATTACKER. ]]
	NukeRaid = {
		Enabled = true,
		OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 65): only Shaun until his phone test
		CooldownSeconds = 1800, -- after a nuke raid (saved: profile.NukeLastLaunch, the silo's one cooldown)
		UsesWarhead = true, -- spends one ready warhead (profile.NukeSilo.Ready)
		Vfx = true, -- the missile + blast on the target base (the MissileStrikeFx packet; light, phone-safe)
		FlightSeconds = 6, -- the missile's flight in the VFX (the cash moves at launch: the raid is instant)
		Targets = { -- who may be nuked (false = never)
			Shielded = false, -- a raid shield (ShieldUntil) / novice shield / spawn protection
			NewPlayers = false, -- inside NewPlayerProtectionSeconds
			Admins = false, -- AdminService.IsAdmin
			Allies = false, -- clan allies (GateDefenseService.IsAlly)
			CampCooldown = false, -- a base on his JOB 63 same-base cooldown
		},
		Text = {
			Launched = "NUKE LAUNCHED: +$%s from %s's ATM",
			Hit = "%s nuked your base: -$%s",
			Cooldown = "Silo cooling down: %s",
			NotReady = "No warhead ready",
			NoSilo = "Build the Nuclear Silo first",
			Blocked = "Can't nuke this base: %s",
		},
	},

	-- the gate rank banners and the title above the head (RebirthConfig.Trims / Titles; RebirthConfig.LiveFor "Trims")
	Rank = {
		BannerZ = 170, -- plot-local, just outside the front wall
		BannerX = 14,
		TitleMaxDistance = 40,
		TitlePx = 15,
	},
}

--[[ claude-bud JOB 46 (2026-10-01, Shaun: "before you buy them it's not clear what you're buying ... the buildings are
	pretty bad ... there should be more to do"). ONE source for what a zone shows and does:
	  * Info[zoneId].Do: what you can do there (the preview card, the locked sign);
	  * Info[zoneId].Activity: the one thing to do in the area once built (RebirthZoneService handles it, server-side):
	      "ship"   a shipment worth Shipment.Minutes of THIS zone's income, once every Shipment.CooldownMinutes;
	      "sweep"  the drones empty your ATM now (Sweep.CooldownSeconds);
	      "drill"  opens the Elite Training panel (EndgameService, the Recruitment Office's list);
	      "strike" opens the missile strike panel;
	      "nuke"   the silo's own NUKE panel (NukeService);
	  * Gains(zoneId, level): the exact gains of one level, read from Zones (never typed twice). ]]
local cfg: any = RebirthZonesConfig
cfg.Info = {
	WestYard = { Do = "Builds tanks for cash. Ship a batch here every 20 min.", Activity = "ship", ActionText = "SHIP TANKS", Theme = "factory" },
	StrategicYard = { Do = "Charges nukes. Launch from the silo console.", Activity = "nuke", ActionText = "NUKE", Theme = "silo" },
	WestStrip = { Do = "Cuts your missile reload. Call a strike from here.", Activity = "strike", ActionText = "CALL STRIKE", Theme = "artillery" },
	DroneBay = { Do = "Drones empty your ATM. Launch a sweep any time.", Activity = "sweep", ActionText = "LAUNCH SWEEP", Theme = "drones" },
	EastYard = { Do = "More soldiers. Drill your army at the yard.", Activity = "drill", ActionText = "DRILL", Theme = "barracks" },
	EastStrip = { Do = "Big cash every tick. Fill a tanker every 20 min.", Activity = "ship", ActionText = "FILL TANKER", Theme = "refinery" },
	WestFlank = { Do = "Longer raid shield. Run a supply drop every 20 min.", Activity = "ship", ActionText = "SUPPLY RUN", Theme = "bunker" },
}
cfg.Shipment = { Minutes = 10, CooldownMinutes = 20 } -- "ship": Minutes of the zone's own flat income (before multipliers)
cfg.Sweep = { CooldownSeconds = 45 }
cfg.Card = { MaxDistance = 18 } -- the preview card shows while the zone's prompt is shown (the console)

--[[ claude-bud JOB 50 (2026-10-01, Shaun: "the rebirth zones still lack detail, quality and any purpose or fun").
	ROOT CAUSE (docs/proof/job50/before.md): every zone's activity was ONE tap at the kiosk for a payout of 10 min of
	that zone's flat income (often a sliver of the player's real income by rebirth 10), with no skill, no goal, no best,
	no status, and nothing logged. Rebuild (owner-first; OFF == the JOB 46 one-tap activities exactly):
	  * Runs: each zone's kiosk starts a short, server-timed run on the apron (steps shown one at a time as prompts the
	    server validates, or an NPC wave); a cooldown per zone (saved), a first-clear bonus, a personal best, an effect
	    tied to the zone (the silo charge, the missile reload, an army buff, a recon pin, a banner stage).
	  * Reward: the ONE formula (cfg.ShipmentCash) x a speed factor (1.0 .. SpeedBonusMax); never below ShipmentCash.
	  * Plaques at each gateway: "UNLOCKED BY <name> · REBIRTH N" + the best time; all 7 zones at L3 = ZONE COMMANDER.
	  * Free for everyone; no Robux anywhere in it. ]]
cfg.Rebuild = {
	Enabled = true,
	OwnerFirst = true, -- NEW-OWNER-FIRST (claude-bud JOB 50): Code Bot flips it after Shaun's phone test
	Activities = true,
	Plaques = true,
	Signs = true,
	Visuals = true,
}
cfg.RunRules = {
	CooldownMinutes = 20, -- per zone, saved (profile.ZoneRunAt)
	SpeedBonusMax = 1.5, -- the fastest run pays this x ShipmentCash (a run at the time limit pays 1.0 x)
	FirstClearMult = 1, -- the first clear of a zone also pays this x ShipmentCash once (profile.ZoneFirstClear)
	ReadyToast = true, -- claude-bud JOB 50 C: one toast when a zone's run comes off cooldown (Rebuild.Signs)
	StatusRefreshSeconds = 30, -- claude-bud JOB 50 C: the gateway plaque's READY / NEXT RUN line (minutes, no per-second churn)
	AnnexSlackStuds = 24, -- a step only counts with him inside the annex + this (no remote triggering)
	StepHold = 0.3, -- seconds to hold a step prompt (fingers)
	StepReach = 9, -- the step prompt's MaxActivationDistance
	-- the base pay is max(ShipmentCash, IncomeMinutes x his passive income per minute): the silo / artillery / drone / bunker
	-- zones have no flat income of their own, and late in the game 10 min of a zone's income is a sliver of his real income
	IncomeMinutes = 2, -- 2 min of his income (x up to 1.5 by speed): 7 zones every 20 min stays well under his passive rate
}
-- step x / dz: annex-local x, and z = D / 2 + dz (the apron in front of the yard, where the JOB 46 dressing stands)
local function step(label: string, x: number, dz: number): any -- claude-bud JOB 50 A: one run step (label, x, dz)
	local t: { any } = {}
	t[1], t[2], t[3] = label, x, dz
	return t
end
cfg.Runs = ({
	WestYard = { Title = "PRODUCTION RUN", Seconds = 60, Effect = "cash",
		Steps = { step("PICK UP CRATE", -22, 4), step("LOAD TRUCK", 22, 10), step("PICK UP CRATE", -22, 4), step("LOAD TRUCK", 22, 10),
			step("PICK UP CRATE", -22, 4), step("LOAD TRUCK", 22, 10) } },
	StrategicYard = { Title = "LAUNCH PREP", Seconds = 30, Effect = "nukecharge", ChargeCutMinutes = 5,
		Steps = { step("ARM 1 OF 3", -22, 5), step("ARM 2 OF 3", 0, 14), step("ARM 3 OF 3", 22, 5) } },
	WestStrip = { Title = "RANGE PRACTICE", Seconds = 45, Effect = "reloadcut", ReloadCutSeconds = 120,
		Steps = { step("HIT TARGET", -30, 6), step("HIT TARGET", -20, 14), step("HIT TARGET", -8, 6), step("HIT TARGET", 8, 14),
			step("HIT TARGET", 20, 6), step("HIT TARGET", 30, 14) } },
	DroneBay = { Title = "RECON FLIGHT", Seconds = 0, Effect = "recon" }, -- instant: the drones mark the nearest raidable rival + sweep
	EastYard = { Title = "DRILL COURSE", Seconds = 45, Par = 30, Effect = "armyboost", BoostMinutes = 10,
		Steps = { step("START", -30, 8), step("CLIMB WALL", -26, 14), step("ROPE FRAME", 27, 11), step("FINISH", 0, 6) } },
	EastStrip = { Title = "PRESSURE VALVES", Seconds = 30, Effect = "cash", Shuffle = true,
		Steps = { step("VALVE", -24, 6), step("VALVE", -12, 12), step("VALVE", 12, 12), step("VALVE", 24, 6) } },
	WestFlank = { Title = "HOLD THE LINE", Seconds = 60, Effect = "banner", Wave = { "Infantry", "Infantry", "Infantry" },
		WaveAt = { { -20, 14 }, { 0, 18 }, { 20, 14 } }, BannerStages = 3 },
} :: any)

function cfg.RebuildLive(userId: any, part: string?): boolean
	local R: any = cfg.Rebuild
	if typeof(R) ~= "table" or (part ~= nil and R[part] ~= true) then
		return false
	end
	return (require(script.Parent.RetentionConfig) :: any).Live(R, userId)
end

-- the run's base pay: max(the ONE ShipmentCash formula, IncomeMinutes x his passive income per minute)
function cfg.RunBase(zoneId: string, level: number, tickSeconds: number, perMin: number?): number
	local inc = math.max(0, tonumber(perMin) or 0) * math.max(0, tonumber(cfg.RunRules.IncomeMinutes) or 0)
	return math.max(cfg.ShipmentCash(zoneId, level, tickSeconds), math.floor(inc))
end

-- the run's cash: RunBase x (1 .. SpeedBonusMax) by the time left (pure; tickSeconds = EconomyConfig PassiveIncome)
function cfg.RunCash(zoneId: string, level: number, tickSeconds: number, secondsUsed: number, limit: number, perMin: number?): number
	local base = cfg.RunBase(zoneId, level, tickSeconds, perMin)
	if limit <= 0 then
		return base
	end
	local left = math.clamp((limit - secondsUsed) / limit, 0, 1)
	return math.floor(base * (1 + (math.max(1, tonumber(cfg.RunRules.SpeedBonusMax) or 1.5) - 1) * left))
end

local function at(list: { number }?, level: number): number
	if list == nil or level < 1 then
		return 0
	end
	return tonumber(list[math.min(level, #list)]) or 0
end

local function commas(n: number): string
	local s = tostring(math.floor(n + 0.5))
	return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

-- the exact gains of one level (1..MaxLevel), as short lines, from Zones; tickSeconds = EconomyConfig PassiveIncome
function cfg.Gains(zoneId: string, level: number, tickSeconds: number): { string }
	local z = RebirthZonesConfig.Zones[zoneId]
	local out: { string } = {}
	if z == nil or level < 1 then
		return out
	end
	local inc = at(z.IncomePerTick, level)
	if inc > 0 then
		table.insert(out, string.format("+$%s/s income", commas(inc / math.max(1, tickSeconds))))
	end
	local sol = at(z.Soldiers, level)
	if sol > 0 then
		table.insert(out, string.format("+%d soldiers", sol))
	end
	local cut = at(z.MissileReloadCut, level)
	if cut > 0 then
		table.insert(out, string.format("Missile reload -%d s", cut))
	end
	local ac = at(z.AutoCollectSeconds, level)
	if ac > 0 then
		table.insert(out, string.format("Drones empty your ATM every %d s", ac))
	end
	local sh = at(z.RaidShieldBonus, level)
	if sh > 0 then
		table.insert(out, string.format("+%d s raid shield", sh))
	end
	local cap = at(z.SiloCapacity, level)
	if cap > 0 then
		table.insert(out, string.format("Holds %d nuke%s, %d min charge", cap, if cap == 1 then "" else "s", at(z.SiloChargeMinutes, level)))
	end
	return out
end

-- the shipment of an income zone at a level ($), from Shipment.Minutes of its flat income
function cfg.ShipmentCash(zoneId: string, level: number, tickSeconds: number): number
	local z = RebirthZonesConfig.Zones[zoneId]
	local inc = if z then at(z.IncomePerTick, level) else 0
	return math.floor(inc / math.max(1, tickSeconds) * 60 * cfg.Shipment.Minutes)
end

-- claude-bud JOB 50 C: what the run is and what a win gives, one short line (pure; the preview card + the map card)
local EFFECT_TEXT: { [string]: (r: any) -> string } = {
	cash = function(_r) return "cash" end,
	nukecharge = function(r) return string.format("nuke -%d min", tonumber(r.ChargeCutMinutes) or 0) end,
	reloadcut = function(r) return string.format("reload -%d s", tonumber(r.ReloadCutSeconds) or 0) end,
	recon = function(_r) return "marks a rival" end,
	armyboost = function(r) return string.format("par %d s: boost", tonumber(r.Par) or 0) end,
	banner = function(_r) return "cash + banner" end,
}
function cfg.RunLine(zoneId: string): string?
	local r: any = (cfg.Runs :: any)[zoneId]
	if r == nil then
		return nil
	end
	local fx = EFFECT_TEXT[r.Effect]
	local secs = tonumber(r.Seconds) or 0
	return string.format("Run: %s%s%s", r.Title, if secs > 0 then string.format(" · %d s", secs) else "", if fx then " · " .. fx(r) else "")
end

-- claude-bud JOB 50 C: the plaque / map status of a run (pure): READY, IN PROGRESS, or NEXT RUN n MIN (rounded up)
function cfg.RunStatus(cooldownLeft: number, active: boolean): (string, boolean)
	if active then
		return "RUN IN PROGRESS", false
	end
	if cooldownLeft <= 0 then
		return "RUN READY", true
	end
	return string.format("NEXT RUN %d MIN", math.max(1, math.ceil(cooldownLeft / 60))), false
end

--[[ The preview card for a zone at its current level: { Title, Level, Cost (nil at max), Gains (the NEXT level's, or
	the current at max), Do, Action }. Pure (the client card, the locked sign and the tests). ]]
function cfg.CardFor(zoneId: string, level: number, tickSeconds: number): any
	local z = RebirthZonesConfig.Zones[zoneId]
	local info = cfg.Info[zoneId]
	if z == nil or info == nil then
		return nil
	end
	local maxed = level >= RebirthZonesConfig.MaxLevel
	local nextL = if maxed then level else level + 1
	return {
		Title = string.upper(z.Name),
		Level = level,
		NextLevel = nextL,
		Cost = if maxed then nil else math.floor(tonumber(z.Cost[math.min(level + 1, #z.Cost)]) or 0),
		Gains = cfg.Gains(zoneId, nextL, tickSeconds),
		Do = info.Do,
		Action = info.ActionText,
		Maxed = maxed,
		Run = cfg.RunLine(zoneId), -- claude-bud JOB 50 C (shown only while Rebuild.Signs is live)
	}
end

return RebirthZonesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">RecruitTrimConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ claude-bud JOB 45 (2026-10-01): the Recruit Pack's GOLD GATE ARCH (Services/RecruitTrimService), built on the
	owner's plot for WE_Ent_RecruitPack (the existing entitlement, granted by the Recruit Pack receipt). Its own file so
	MonetizationConfig keeps only products / prices (codebot_v167). Enabled = false: nothing built. ]]
-- claude-bud JOB 45: the Recruit Pack's GOLD GATE ARCH (Services/RecruitTrimService), built on the owner's plot for
-- WE_Ent_RecruitPack (the existing entitlement). Enabled = false: nothing built (the sign / marker accents stay).
local RecruitTrimConfig = {
	Enabled = true,
	Text = "RECRUIT",
	InsetStuds = 4, -- no walls (Lv 0) only: this far in from the plot's front edge
	Height = 18, -- pillar height (studs); Code Bot v172: at least HeightOverWall above the gate-face wall
	-- Code Bot v172: the arch is placed from the REAL gate (the GatePost parts in WE_PerimeterWalls): the pillars stand
	-- WallClearStuds behind the furthest gate furniture (the wall's inner face + the gate arch overhang, or the post roofs /
	-- Tier 3 gatehouse / Bastion crest at GateFurnitureStuds), in front of the gate guards (10 studs in)
	GateFurnitureStuds = 2.6,
	WallClearStuds = 1.0,
	HeightOverWall = 5, -- the banner's bottom (4.6 under the pillar top) stays above the gate opening's height
	PillarWidth = 2.2,
	PillarGap = 1.2, -- from the gate opening's edge (the 14-stud lane stays clear)
	BannerSize = Vector2.new(12, 3),
	TextMaxDistance = 80, -- SurfaceGui cap (CLAUDE.md budget)
	Gold = Color3.fromRGB(232, 184, 58),
	GoldDark = Color3.fromRGB(168, 122, 30),
	Plinth = Color3.fromRGB(58, 52, 44),
	BannerColor = Color3.fromRGB(26, 34, 22),
	Reflectance = 0.25,
	SweepSeconds = 5,
}

return RecruitTrimConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">ResearchConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ v69 Research Lab tree — shared by ResearchService (server, authoritative) and ResearchController (display only).

	Research is PERMANENT: PrestigeService never touches profile.Research, so bonuses keep applying after a
	Rebirth (the Lab resets, so buying NEW levels needs the Lab again). Cash only; prices here are read by the
	server — the client only displays payload.Costs.

	Gating: target level L needs Research Lab >= L (LabLevels overrides, e.g. Squad Expansion 2/4/5), and each
	track needs its building (Tracks[*].Requires). All effects are additive per level:
	  Kind "Mult": ResearchService.GetBonus(player, Stat) = 1 + Σ PerLevel × level   (always >= 1, bigger = stronger;
	               time-like stats divide by it, e.g. reload time = base ÷ mult)
	  Kind "Add" : ResearchService.GetAdd(player, Stat)   = Σ PerLevel × level        (>= 0)
	An upgrade whose game hook is missing ships with Enabled = false (card shows SOON, server refuses "Disabled").
	Full tree: $4,048,000.
]]

export type TrackDef = {
	Id: string,
	DisplayName: string,
	Order: number,
	Blurb: string,
	Requires: { StructureId: string, Level: number, Text: string, Short: string }?,
}

export type UpgradeDef = {
	Id: string,
	Track: string,
	Order: number,
	DisplayName: string,
	Badge: string,
	Stat: string, -- statId for ResearchService.GetBonus (Kind "Mult") / GetAdd (Kind "Add")
	Kind: string, -- "Mult" | "Add"
	PerLevel: number,
	MaxLevel: number,
	Costs: { number }, -- Cash for target level 1..MaxLevel (index = target level)
	LabLevels: { number }?, -- Research Lab level needed per target level; nil = target level
	EffectText: string, -- string.format(EffectText, FormatAmount(...)) e.g. "%s weapon damage"
	Note: string?,
	Enabled: boolean,
	RebirthScale: number?, -- claude-bud JOB 20: price x (1 + RebirthScale x rebirths)
	ServiceOnly: boolean?, -- claude-bud JOB 26: bought only through its own service (ArmourService), never the research remote
	FlatCosts: boolean?, -- claude-bud JOB 24: every level costs the same (e.g. one tower guard per level)
}

export type ResearchLock = { Code: string, Text: string } -- Code: "Disabled" | "Maxed" | "NeedStructure" | "NeedLab"

export type ResearchStatePayload = {
	LabLevel: number,
	Levels: { [string]: number }, -- EVERY upgrade id (0 = none)
	Costs: { [string]: number }, -- next-level Cash price; id absent when maxed
	Locks: { [string]: ResearchLock }, -- id present only when the next level is blocked for a non-cash reason
	Tracks: { [string]: ResearchLock }, -- track id present only when the whole track is locked
}

local ResearchConfig = {}

ResearchConfig.StructureId = "ResearchLab"

-- RequestResearch rate limits (per player): Buy taps and Sync requests. Over-limit taps are dropped with a
-- throttled toast — never an AntiExploit strike.
ResearchConfig.BuyRate = 2
ResearchConfig.BuyBurst = 4
ResearchConfig.SyncRate = 1
ResearchConfig.SyncBurst = 3

ResearchConfig.MaxMult = 3 -- sanity clamp on any Mult stat

ResearchConfig.Roman = { "I", "II", "III", "IV", "V" }

-- Also the WE_OpenTab values on Research Lab terminals.
ResearchConfig.TrackOrder = { "Weapons", "Soldiers", "Vehicles", "Defenses" }

ResearchConfig.StatIds = {
	"WeaponDamage",
	"WeaponFireRate",
	"WeaponMagazine",
	"WeaponReload",
	"SoldierHealth",
	"SoldierDamage",
	"VehicleSpeed",
	"VehicleArmor",
	"TurretDamage",
	"SquadSize",
	-- claude-bud JOB 24 §4a (live: "disabling GuardArmor / GuardRoster / TowerGuards: unknown Stat"): the JOB 20 guard stats
	-- (GuardConfig.HealthStat / CountStat, BaseGuards hiredCount)
	"SoldierFireRate", -- claude-bud JOB 26: Combat Drills
	"PlayerArmour", -- claude-bud JOB 26: personal armour tier (ArmourService; the hidden Armour track)
	"GuardHP",
	"GuardCount",
	"TowerGuards",
}

ResearchConfig.Tracks = {
	-- claude-bud JOB 26: personal armour (ArmourService only; NOT in TrackOrder, so the Research panel never shows it)
	Armour = {
		Id = "Armour",
		DisplayName = "Armour",
		Order = 9,
		Blurb = "Personal armour, bought at your base.",
		Requires = { StructureId = "CommandCenter", Level = 1, Text = "Needs a Command Center", Short = "NEEDS HQ" },
	},
	Weapons = {
		Id = "Weapons",
		DisplayName = "Weapons",
		Order = 1,
		Blurb = "Upgrades every gun you carry.",
		Requires = nil,
	},
	Soldiers = {
		Id = "Soldiers",
		DisplayName = "Soldiers",
		Order = 2,
		Blurb = "Upgrades the squad that follows your orders.",
		Requires = {
			StructureId = "Barracks",
			Level = 1,
			Text = "Build the Barracks to unlock soldier research",
			Short = "NEEDS BARRACKS",
		},
	},
	Vehicles = {
		Id = "Vehicles",
		DisplayName = "Vehicles",
		Order = 3,
		Blurb = "Upgrades every vehicle you deploy.",
		Requires = {
			StructureId = "VehicleDepot",
			Level = 1,
			Text = "Build the Vehicle Depot to unlock vehicle research",
			Short = "NEEDS DEPOT",
		},
	},
	Defenses = {
		Id = "Defenses",
		DisplayName = "Defenses",
		Order = 4,
		Blurb = "Upgrades your gate guards and machine-gun nests.",
		Requires = {
			StructureId = "DefensiveWalls",
			Level = 1,
			Text = "Build Defensive Walls to unlock defense research",
			Short = "NEEDS WALLS",
		},
	},
} :: { [string]: TrackDef }

ResearchConfig.Upgrades = {
	-- ── Weapons (every gun the player carries; CombatService) ──────────────────────────────────────────
	Ballistics = {
