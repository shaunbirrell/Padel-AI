local function kitRichTent(folder: Folder, origin: Vector3, yawDeg: number)
	-- Canvas folds, poles, guy-line Parts (original — not copied meshes)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	p({
		Name = "TentFloor",
		Size = Vector3.new(9, 0.25, 7),
		CFrame = cf * CFrame.new(0, 0.12, 0),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	-- Main canvas body
	p({
		Name = "TentBody",
		Size = Vector3.new(8.2, 3.8, 6.2),
		CFrame = cf * CFrame.new(0, 2.1, 0),
		Color = COL.Tent,
		Material = Enum.Material.Fabric,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	-- Ridge / fold panels
	p({
		Name = "TentRidge",
		Size = Vector3.new(8.5, 0.7, 1.4),
		CFrame = cf * CFrame.new(0, 4.3, 0),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	p({
		Name = "TentFoldL",
		Size = Vector3.new(0.35, 3.5, 6.0),
		CFrame = cf * CFrame.new(-3.9, 2.0, 0),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	p({
		Name = "TentFoldR",
		Size = Vector3.new(0.35, 3.5, 6.0),
		CFrame = cf * CFrame.new(3.9, 2.0, 0),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
	-- Center + corner poles
	p({
		Name = "TentPole",
		Size = Vector3.new(0.3, 5.2, 0.3),
		CFrame = cf * CFrame.new(0, 2.6, 0),
		Color = COL.TentPole,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, ox in ipairs({ -4.2, 4.2 }) do
		for _, oz in ipairs({ -3.2, 3.2 }) do
			p({
				Name = "TentStake",
				Size = Vector3.new(0.22, 1.2, 0.22),
				CFrame = cf * CFrame.new(ox, 0.6, oz),
				Color = COL.TentPole,
				Material = Enum.Material.Wood,
				Parent = folder,
			})
			-- Guy lines (thin Parts)
			p({
				Name = "GuyLine",
				Size = Vector3.new(0.08, 0.08, 4.2),
				CFrame = cf * CFrame.new(ox * 0.5, 2.4, oz * 0.5) * CFrame.Angles(math.rad(28), 0, math.rad(ox > 0 and -12 or 12)),
				Color = Color3.fromRGB(180, 170, 140),
				Material = Enum.Material.Fabric,
				CastShadow = false,
				Parent = folder,
			})
		end
	end
	p({
		Name = "TentDoorFlap",
		Size = Vector3.new(2.0, 2.8, 0.2),
		CFrame = cf * CFrame.new(0, 1.5, -3.15),
		Color = COL.TentDark,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})
end

local function kitCamp(folder: Folder, origin: Vector3, yawDeg: number)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	kitRichTent(folder, (cf * CFrame.new(0, 0, 0)).Position, yawDeg)
	kitRichTent(folder, (cf * CFrame.new(12, 0, 4)).Position, yawDeg + 15)
	kitAdobeBuilding(folder, (cf * CFrame.new(-14, 0, 2)).Position, yawDeg)
	kitCampfire(folder, (cf * CFrame.new(6, 0, -6)).Position)
	kitCrateStack(folder, (cf * CFrame.new(-6, 0, 6)).Position)
	kitOilDrums(folder, (cf * CFrame.new(-5, 0, -5)).Position, 2)
	kitSandbagLine(folder, (cf * CFrame.new(0, 0, 10)).Position, yawDeg, 4)
end

local function kitRunway(folder: Folder, origin: Vector3, yawDeg: number, length: number?)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local len = length or 80
	p({
		Name = "RunwayPad",
		Size = Vector3.new(14, 0.25, len),
		CFrame = cf * CFrame.new(0, 0.2, 0),
		Color = COL.Asphalt,
		Material = Enum.Material.Asphalt,
		CanCollide = true,
		CanQuery = true,
		Parent = folder,
	})
	-- Centerline dashes
	local dashes = math.floor(len / 12)
	for i = 0, dashes - 1 do
		local z = -len / 2 + 6 + i * 12
		p({
			Name = "RunwayDash",
			Size = Vector3.new(1.2, 0.15, 6),
			CFrame = cf * CFrame.new(0, 0.35, z),
			Color = COL.NeonGold,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	-- Threshold chevrons
	p({
		Name = "RunwayThresh",
		Size = Vector3.new(12, 0.15, 2),
		CFrame = cf * CFrame.new(0, 0.35, -len / 2 + 4),
		Color = Color3.fromRGB(240, 240, 240),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	p({
		Name = "RunwayThresh2",
		Size = Vector3.new(12, 0.15, 2),
		CFrame = cf * CFrame.new(0, 0.35, len / 2 - 4),
		Color = Color3.fromRGB(240, 240, 240),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
end

local function kitOutpost(folder: Folder, origin: Vector3, yawDeg: number)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yawDeg), 0)
	-- Compact fortified desert outpost: adobe + wooden tower + tent + sandbags + fence
	kitAdobeBuilding(folder, (cf * CFrame.new(0, 0, 0)).Position, yawDeg)
	kitWatchtower(folder, (cf * CFrame.new(12, 0, 10)).Position, yawDeg + 20)
	kitRichTent(folder, (cf * CFrame.new(-12, 0, 6)).Position, yawDeg - 10)
	kitSandbagLine(folder, (cf * CFrame.new(0, 0, -10)).Position, yawDeg, 5)
	kitSandbagLine(folder, (cf * CFrame.new(8, 0, -8)).Position, yawDeg + 40, 3)
	kitWireFence(folder, (cf * CFrame.new(-14, 0, -2)).Position, yawDeg + 90, 3)
	kitAmmoShed(folder, (cf * CFrame.new(-8, 0, 14)).Position, yawDeg)
	kitCampfire(folder, (cf * CFrame.new(6, 0, -6)).Position)
	kitLightPole(folder, (cf * CFrame.new(14, 0, -8)).Position)
end

-- Sparse optional cluster label (short MaxDistance — mobile friendly)
local function clusterLabel(parent: BasePart, text: string)
	local bb = Instance.new("BillboardGui")
	bb.Name = "DressLabel"
	bb.Size = UDim2.fromOffset(160, 28)
	bb.StudsOffset = Vector3.new(0, 8, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 55
	bb.Parent = parent
	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.fromScale(1, 1)
	lab.BackgroundColor3 = Color3.fromRGB(10, 12, 14)
	lab.BackgroundTransparency = 0.35
	lab.Text = text
	lab.TextColor3 = Color3.fromRGB(220, 230, 210)
	lab.TextScaled = true
	lab.Font = Enum.Font.GothamBold
	lab.BorderSizePixel = 0
	lab.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = lab
end

-- ── Placement plan ────────────────────────────────────────────────────────

local function placeCluster(parent: Folder, name: string, origin: Vector3, builder: (Folder, Vector3, number) -> (), yawDeg: number, label: string?)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	builder(folder, origin, yawDeg)
	if label then
		local anchor = p({
			Name = "LabelAnchor",
			Size = Vector3.new(1, 1, 1),
			Position = origin + Vector3.new(0, 6, 0),
			Transparency = 1,
			CanCollide = false,
			CastShadow = false,
			Parent = folder,
		})
		clusterLabel(anchor, label)
	end
end

function MapDressing.Dress(root: Instance, opts: { Quality: string? }?)
	local quality = string.lower(tostring((opts and opts.Quality) or "Low"))
	local full = quality == "full"
	local dressing = ensureFolder("WorldDressing", root)

	-- PERF Low: ~60–70% fewer clusters than prior dense pass. CastShadow already false in p().

	-- 1) Road checkpoints
	local checkpoints = if full
		then {
			{ Name = "CP_N_Inner", Pos = Vector3.new(0, 0.5, -420), Yaw = 0, Label = "CHECKPOINT" },
			{ Name = "CP_E_Inner", Pos = Vector3.new(420, 0.5, 0), Yaw = 90, Label = "CHECKPOINT" },
			{ Name = "CP_S_Outer", Pos = Vector3.new(0, 0.5, 1050), Yaw = 180, Label = nil },
			{ Name = "CP_W_Outer", Pos = Vector3.new(-1050, 0.5, 0), Yaw = -90, Label = nil },
		}
		else {
			{ Name = "CP_N_Inner", Pos = Vector3.new(0, 0.5, -420), Yaw = 0, Label = "CHECKPOINT" },
			{ Name = "CP_E_Inner", Pos = Vector3.new(420, 0.5, 0), Yaw = 90, Label = nil },
		}
	for _, cp in ipairs(checkpoints) do
		placeCluster(dressing, cp.Name, cp.Pos, kitCheckpoint, cp.Yaw, cp.Label)
	end

	-- 2) Outposts
	local outposts = if full
		then {
			{ Name = "OP_NorthRidge", Pos = Vector3.new(90, 0.5, -1180), Yaw = 30, Label = "OUTPOST" },
			{ Name = "OP_EastArmory", Pos = Vector3.new(1180, 0.5, 90), Yaw = 100, Label = "OUTPOST" },
			{ Name = "OP_OilFields", Pos = Vector3.new(850, 0.5, 1080), Yaw = 45, Label = "OUTPOST" },
			{ Name = "OP_MidNE", Pos = Vector3.new(550, 0.5, -550), Yaw = 20, Label = nil },
		}
		else {
			{ Name = "OP_NorthRidge", Pos = Vector3.new(90, 0.5, -1180), Yaw = 30, Label = "OUTPOST" },
			{ Name = "OP_EastArmory", Pos = Vector3.new(1180, 0.5, 90), Yaw = 100, Label = nil },
		}
	for _, op in ipairs(outposts) do
		placeCluster(dressing, op.Name, op.Pos, kitOutpost, op.Yaw, op.Label)
	end

	-- 3) Hangars (Low: 1 hangar + light fuel; Full: prior airfield)
	do
		local f = Instance.new("Folder")
		f.Name = "AirfieldDressing"
		f.Parent = dressing
		kitHangar(f, Vector3.new(700, 0.5, -200), 90)
		if full then
			kitHangar(f, Vector3.new(700, 0.5, 200), 90)
			kitRunway(f, Vector3.new(780, 0.5, 0), 0, 100)
			kitFuelDepot(f, Vector3.new(640, 0.5, -280), 0)
			kitVehicleSilhouette(f, Vector3.new(660, 0.5, -140), 90, "truck")
			kitVehicleSilhouette(f, Vector3.new(660, 0.5, 140), 85, "jeep")
			kitLightPole(f, Vector3.new(740, 0.5, -60))
			kitLightPole(f, Vector3.new(740, 0.5, 60))
		else
			kitFuelDepot(f, Vector3.new(640, 0.5, -280), 0)
			kitLightPole(f, Vector3.new(740, 0.5, 0))
		end
	end

	-- 4) Depots
	local depots = if full
		then {
			{ Name = "Depot_NW", Pos = Vector3.new(-650, 0.5, -650), Yaw = 45, Kind = "fuel" },
			{ Name = "Ammo_NE", Pos = Vector3.new(650, 0.5, -650), Yaw = 135, Kind = "ammo" },
			{ Name = "Depot_FarE", Pos = Vector3.new(1600, 0.5, 200), Yaw = 0, Kind = "fuel" },
		}
		else {
			{ Name = "Depot_NW", Pos = Vector3.new(-650, 0.5, -650), Yaw = 45, Kind = "fuel" },
		}
	for _, d in ipairs(depots) do
		local f = Instance.new("Folder")
		f.Name = d.Name
		f.Parent = dressing
		if d.Kind == "fuel" then
			kitFuelDepot(f, d.Pos, d.Yaw)
			kitOilDrums(f, d.Pos + Vector3.new(10, 0, 6), if full then 4 else 2)
		else
			kitAmmoShed(f, d.Pos, d.Yaw)
			kitCrateStack(f, d.Pos + Vector3.new(8, 0, 4))
		end
	end

	-- 5) Radio
	do
		local f = Instance.new("Folder")
		f.Name = "Radio_N"
		f.Parent = dressing
		kitRadioTower(f, Vector3.new(180, 0.5, -1500), 0)
		if full then
			local f2 = Instance.new("Folder")
			f2.Name = "Radio_OilApproach"
			f2.Parent = dressing
			kitRadioTower(f2, Vector3.new(1100, 0.5, 1100), 45)
		end
	end

	-- 6) Camps
	local camps = if full
		then {
			{ Name = "Camp_N", Pos = Vector3.new(-280, 0.5, -700), Yaw = 15 },
			{ Name = "Camp_E", Pos = Vector3.new(900, 0.5, -350), Yaw = 90 },
			{ Name = "Camp_FarSE", Pos = Vector3.new(1400, 0.5, 900), Yaw = 40 },
		}
		else {
			{ Name = "Camp_N", Pos = Vector3.new(-280, 0.5, -700), Yaw = 15 },
		}
	for _, c in ipairs(camps) do
		local f = Instance.new("Folder")
		f.Name = c.Name
		f.Parent = dressing
		kitCamp(f, c.Pos, c.Yaw)
	end

	-- 7) Dockside (Low: 2 piers; Full: 5)
	do
		local f = Instance.new("Folder")
		f.Name = "DocksideDressing"
		f.Parent = dressing
		local pierXs = if full then { -200, -80, 80, 200, 350 } else { -80, 80 }
		for i, x in ipairs(pierXs) do
			p({
				Name = "Pier" .. i,
				Size = Vector3.new(18, 1.2, 40),
				Position = Vector3.new(x, 0.8, 1420),
				Color = COL.Dock,
				Material = Enum.Material.Wood,
				CanCollide = true,
				CanQuery = true,
				Parent = f,
			})
			kitCrateStack(f, Vector3.new(x - 4, 1.5, 1410))
			if full then
				kitOilDrums(f, Vector3.new(x + 5, 1.5, 1405), 3)
				kitLightPole(f, Vector3.new(x + 8, 0.5, 1440))
			end
		end
		if full then
			kitAmmoShed(f, Vector3.new(-320, 0.5, 1380), 0)
			kitFuelDepot(f, Vector3.new(320, 0.5, 1380), 180)
			kitVehicleSilhouette(f, Vector3.new(0, 0.5, 1360), 0, "truck")
			kitSandbagLine(f, Vector3.new(0, 0.5, 1340), 0, 6)
		end
	end

	-- 8–9) Approaches — Full only (heavy part cost)
	if full then
		local f = Instance.new("Folder")
		f.Name = "CoastalOilApproaches"
		f.Parent = dressing
		kitCheckpoint(f, Vector3.new(1650, 0.5, -750), 90)
		kitFuelDepot(f, Vector3.new(1580, 0.5, -820), 45)
		kitOilDrums(f, Vector3.new(1600, 0.5, -680), 6)
		kitCheckpoint(f, Vector3.new(-1650, 0.5, 750), -90)
		kitAmmoShed(f, Vector3.new(-1580, 0.5, 820), -45)

		local f2 = Instance.new("Folder")
		f2.Name = "FortApproaches"
		f2.Parent = dressing
		kitRuinedWall(f2, Vector3.new(1320, 0.5, -1320), 45)
		kitSandbagLine(f2, Vector3.new(1280, 0.5, -1450), 90, 5)
		kitVehicleSilhouette(f2, Vector3.new(1250, 0.5, -1380), 40, "tank")
		kitWatchtower(f2, Vector3.new(1200, 0.5, -1500), 30)
		kitRuinedWall(f2, Vector3.new(-1320, 0.5, 1320), -135)
		kitSandbagLine(f2, Vector3.new(-1280, 0.5, 1450), -90, 5)
		kitWatchtower(f2, Vector3.new(-1200, 0.5, 1500), -150)
	end

	-- 10) Road furniture (Low: 4 signs + 2 lights; Full: prior)
	do
		local f = Instance.new("Folder")
		f.Name = "RoadFurniture"
		f.Parent = dressing
		local signSpots = if full
			then {
				{ Vector3.new(40, 0.5, -250), 0 },
				{ Vector3.new(-40, 0.5, 250), 180 },
				{ Vector3.new(250, 0.5, 40), 90 },
				{ Vector3.new(-250, 0.5, -40), -90 },
				{ Vector3.new(40, 0.5, -800), 0 },
				{ Vector3.new(-40, 0.5, 800), 180 },
				{ Vector3.new(800, 0.5, 40), 90 },
				{ Vector3.new(-800, 0.5, -40), -90 },
				{ Vector3.new(40, 0.5, -1600), 0 },
				{ Vector3.new(-40, 0.5, 1600), 180 },
				{ Vector3.new(1600, 0.5, 40), 90 },
				{ Vector3.new(-1600, 0.5, -40), -90 },
			}
			else {
				{ Vector3.new(40, 0.5, -250), 0 },
				{ Vector3.new(250, 0.5, 40), 90 },
				{ Vector3.new(40, 0.5, -800), 0 },
				{ Vector3.new(800, 0.5, 40), 90 },
			}
		for _, s in ipairs(signSpots) do
			kitRoadSign(f, s[1], s[2])
		end
		local lightSpots = if full
			then {
				Vector3.new(30, 0.5, -600),
				Vector3.new(-30, 0.5, 600),
				Vector3.new(600, 0.5, 30),
				Vector3.new(-600, 0.5, -30),
				Vector3.new(30, 0.5, -1200),
				Vector3.new(-30, 0.5, 1200),
				Vector3.new(1200, 0.5, 30),
				Vector3.new(-1200, 0.5, -30),
				Vector3.new(400, 0.5, -400),
				Vector3.new(-400, 0.5, 400),
				Vector3.new(400, 0.5, 400),
				Vector3.new(-400, 0.5, -400),
			}
			else {
				Vector3.new(30, 0.5, -600),
				Vector3.new(600, 0.5, 30),
			}
		for _, lp in ipairs(lightSpots) do
			kitLightPole(f, lp)
		end
		if full then
			kitVehicleSilhouette(f, Vector3.new(120, 0.5, -500), 5, "jeep")
			kitVehicleSilhouette(f, Vector3.new(500, 0.5, 120), 95, "jeep")
			kitVehicleSilhouette(f, Vector3.new(200, 0.5, -1100), 10, "tank")
			kitVehicleSilhouette(f, Vector3.new(1100, 0.5, 200), 100, "truck")
		end
	end

	-- 11) Bunker line
	do
		local f = Instance.new("Folder")
		f.Name = "BunkerLine"
		f.Parent = dressing
		local bunkers = if full
			then {
				{ Vector3.new(0, 0.5, -900), 0 },
				{ Vector3.new(900, 0.5, 0), 90 },
				{ Vector3.new(-450, 0.5, 900), 195 },
			}
			else {
				{ Vector3.new(0, 0.5, -900), 0 },
			}
		for _, b in ipairs(bunkers) do
			kitBunker(f, b[1], b[2])
		end
	end

	-- 12) Plot-ring perimeter (Low: 3 edges)
	do
		local f = Instance.new("Folder")
		f.Name = "PlotRingPerimeter"
		f.Parent = dressing
		local plotEdges = if full
			then {
				{ Vector3.new(-800, 0.5, -650), 0 },
				{ Vector3.new(-800, 0.5, 650), 0 },
				{ Vector3.new(0, 0.5, -950), 0 },
				{ Vector3.new(0, 0.5, 950), 180 },
				{ Vector3.new(800, 0.5, -650), 180 },
				{ Vector3.new(800, 0.5, 650), 180 },
			}
			else {
				{ Vector3.new(-800, 0.5, -650), 0 },
				{ Vector3.new(0, 0.5, -950), 0 },
				{ Vector3.new(800, 0.5, 650), 180 },
			}
		for _, e in ipairs(plotEdges) do
			kitSandbagLine(f, e[1], e[2], if full then 4 else 2)
		end
	end

	local partCount = 0
	for _, d in ipairs(dressing:GetDescendants()) do
		if d:IsA("BasePart") then
			partCount += 1
			d.CastShadow = false
		end
	end
	print("[WAR EMPIRE] MapDressing complete: quality=" .. quality .. " parts=" .. tostring(partCount) .. " (CastShadow=false)")
end

return MapDressing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">MapSetup</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — MapSetup (shared world build)
	Builds Workspace.WarEmpireSetup: map, plots, structure kits, territories,
	spawns, tutorial markers, NPC placeholders, desert lighting, MapDressing + DesertFlora.
	Called from Bootstrap when WarEmpireSetup is missing (Play Solo / server start).
	Admin `resetmap` destroys WarEmpireSetup and re-runs.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local MapDressing = require(script.Parent:WaitForChild("MapDressing"))
local DesertFlora = require(script.Parent:WaitForChild("DesertFlora"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedConfigs = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Configs")
local DevConfig = require(SharedConfigs:WaitForChild("DevConfig"))
local EconomyConfig = require(SharedConfigs:WaitForChild("EconomyConfig"))

local TAG_BASE = "WE_BasePlot"
local TAG_SLOT = "WE_UpgradeSlot"
local TAG_TERRITORY = "WE_Territory"
local TAG_CAPTURE = "WE_CaptureZone"
local TAG_VEHICLE = "WE_VehicleSpawn"
local TAG_NAVAL = "WE_NavalSpawn"
local TAG_NPC = "WE_NPCSpawn"
local TAG_EVENT = "WE_EventSpawn"
local TAG_TUTORIAL = "WE_TutorialMarker"
local TAG_NPC_ENTITY = "WE_NPC"

local COL_GROUND = Color3.fromRGB(210, 185, 130) -- pale sandy-yellow desert floor
local COL_PAD = Color3.fromRGB(38, 44, 48)
local COL_PAD_EDGE = Color3.fromRGB(70, 190, 110)
local COL_VEHICLE = Color3.fromRGB(48, 62, 78)
local COL_NPC = Color3.fromRGB(88, 42, 42)
local COL_EVENT = Color3.fromRGB(78, 64, 36)

local STRUCTURES = {
	{ Id = "CommandCenter", Kit = "hq", Plinth = Color3.fromRGB(36, 48, 40), Body = Color3.fromRGB(55, 78, 58), Accent = Color3.fromRGB(230, 190, 60), Roof = Color3.fromRGB(40, 55, 45) },
	{ Id = "Barracks", Kit = "barracks", Plinth = Color3.fromRGB(150, 120, 80), Body = Color3.fromRGB(175, 145, 100), Accent = Color3.fromRGB(210, 170, 80), Roof = Color3.fromRGB(130, 100, 70) },
	{ Id = "VehicleDepot", Kit = "depot", Plinth = Color3.fromRGB(40, 48, 55), Body = Color3.fromRGB(58, 72, 88), Accent = Color3.fromRGB(90, 160, 220), Roof = Color3.fromRGB(45, 55, 65) },
	{ Id = "WeaponsFacility", Kit = "lab", Plinth = Color3.fromRGB(48, 40, 38), Body = Color3.fromRGB(88, 58, 50), Accent = Color3.fromRGB(200, 90, 70), Roof = Color3.fromRGB(55, 42, 40) },
	{ Id = "Helipad", Kit = "pad", Plinth = Color3.fromRGB(45, 50, 48), Body = Color3.fromRGB(60, 70, 65), Accent = Color3.fromRGB(220, 200, 80), Roof = Color3.fromRGB(50, 55, 52) },
	{ Id = "Dock", Kit = "dock", Plinth = Color3.fromRGB(35, 48, 58), Body = Color3.fromRGB(50, 75, 95), Accent = Color3.fromRGB(70, 180, 220), Roof = Color3.fromRGB(40, 58, 70) },
	{ Id = "Airfield", Kit = "pad", Plinth = Color3.fromRGB(50, 52, 48), Body = Color3.fromRGB(70, 72, 68), Accent = Color3.fromRGB(180, 190, 100), Roof = Color3.fromRGB(55, 58, 52) },
	{ Id = "DefensiveWalls", Kit = "wall", Plinth = Color3.fromRGB(48, 48, 45), Body = Color3.fromRGB(85, 85, 78), Accent = Color3.fromRGB(120, 130, 110), Roof = Color3.fromRGB(60, 60, 55) },
	{ Id = "Watchtowers", Kit = "tower", Plinth = Color3.fromRGB(44, 46, 40), Body = Color3.fromRGB(72, 78, 60), Accent = Color3.fromRGB(200, 160, 70), Roof = Color3.fromRGB(50, 52, 44) },
	{ Id = "Radar", Kit = "tower", Plinth = Color3.fromRGB(40, 42, 55), Body = Color3.fromRGB(55, 60, 90), Accent = Color3.fromRGB(100, 200, 255), Roof = Color3.fromRGB(45, 48, 70) },
	{ Id = "ResearchLab", Kit = "lab", Plinth = Color3.fromRGB(38, 45, 55), Body = Color3.fromRGB(50, 70, 95), Accent = Color3.fromRGB(80, 180, 220), Roof = Color3.fromRGB(42, 55, 72) },
	{ Id = "MissileDefense", Kit = "tower", Plinth = Color3.fromRGB(48, 42, 40), Body = Color3.fromRGB(75, 55, 50), Accent = Color3.fromRGB(220, 100, 60), Roof = Color3.fromRGB(55, 45, 42) },
	{ Id = "PowerStation", Kit = "power", Plinth = Color3.fromRGB(50, 48, 35), Body = Color3.fromRGB(90, 85, 50), Accent = Color3.fromRGB(255, 210, 70), Roof = Color3.fromRGB(60, 55, 40) },
	{ Id = "Warehouse", Kit = "warehouse", Plinth = Color3.fromRGB(140, 115, 75), Body = Color3.fromRGB(165, 135, 90), Accent = Color3.fromRGB(200, 160, 90), Roof = Color3.fromRGB(120, 95, 65) },
	{ Id = "SpecialForcesFacility", Kit = "special", Plinth = Color3.fromRGB(35, 38, 42), Body = Color3.fromRGB(45, 55, 65), Accent = Color3.fromRGB(160, 80, 200), Roof = Color3.fromRGB(30, 35, 40) },
}

local STARTER_COST = {
	CommandCenter = 1500, Barracks = 2500, VehicleDepot = 3000, WeaponsFacility = 2800,
	Helipad = 5000, Dock = 4500, Airfield = 8000, DefensiveWalls = 2000, Watchtowers = 2200,
	Radar = 4000, ResearchLab = 4500, MissileDefense = 6000, PowerStation = 3500,
	Warehouse = 3200, SpecialForcesFacility = 10000,
}

-- Map scale: ground ≥6000 continuous floor, plot ring ~800, pads ~200
-- Top of Ground sits ~Y=0.5 so plot pads (Y=0.5) sit flush.
local GROUND_SIZE = 6400
local GROUND_THICKNESS = 8
local GROUND_TOP_Y = 0.5
local SAFETY_FLOOR_SIZE = 8000
local SAFETY_FLOOR_Y = -40
local PLOT_PAD_SIZE = 200
local PLOT_RING = 800
local STRUCT_COLS = 4
local STRUCT_GAP = 42 -- studs between upgrade pad centers (was 30)
local STRUCT_ORIGIN = Vector3.new(-63, 1.6, -63) -- CommandCenter grid origin on each plot

local PLOT_POSITIONS = {
	Vector3.new(-PLOT_RING, 0.5, -PLOT_RING * 0.5), -- Plot1 SW
	Vector3.new(-PLOT_RING, 0.5, PLOT_RING * 0.5), -- Plot2 NW
	Vector3.new(0, 0.5, -PLOT_RING), -- Plot3 S
	Vector3.new(0, 0.5, PLOT_RING), -- Plot4 N
	Vector3.new(PLOT_RING, 0.5, -PLOT_RING * 0.5), -- Plot5 SE
	Vector3.new(PLOT_RING, 0.5, PLOT_RING * 0.5), -- Plot6 NE
}

local TERRITORIES = {
	{ Id = "CentralPlaza", Pos = Vector3.new(0, 1, 0), Color = Color3.fromRGB(180, 170, 50), Radius = 70 },
	{ Id = "NorthRidge", Pos = Vector3.new(0, 1, -1300), Color = Color3.fromRGB(55, 120, 180), Radius = 60 },
	{ Id = "SouthDocks", Pos = Vector3.new(0, 1, 1300), Color = Color3.fromRGB(45, 110, 150), Radius = 60 },
	{ Id = "EastArmory", Pos = Vector3.new(1300, 1, 0), Color = Color3.fromRGB(170, 55, 55), Radius = 55 },
	{ Id = "WestDepot", Pos = Vector3.new(-1300, 1, 0), Color = Color3.fromRGB(55, 140, 70), Radius = 55 },
	{ Id = "OilFields", Pos = Vector3.new(950, 1, 950), Color = Color3.fromRGB(150, 110, 40), Radius = 65 },
	{ Id = "RadarHill", Pos = Vector3.new(-950, 1, -950), Color = Color3.fromRGB(130, 70, 170), Radius = 60 },
	-- Coastal oil decks (Y matches TerritoryConfig / OilRigConfig platform height)
	{ Id = "CoastalOilAlpha", Pos = Vector3.new(1800, 28, -750), Color = Color3.fromRGB(190, 145, 45), Radius = 48, OilRig = true },
	{ Id = "CoastalOilBravo", Pos = Vector3.new(-1800, 28, 750), Color = Color3.fromRGB(170, 125, 40), Radius = 48, OilRig = true },
	{ Id = "FortIronclad", Pos = Vector3.new(1450, 1, -1450), Color = Color3.fromRGB(140, 145, 155), Radius = 55, Fortress = true },
	{ Id = "FortSandhold", Pos = Vector3.new(-1450, 1, 1450), Color = Color3.fromRGB(190, 155, 90), Radius = 55, Fortress = true },
}

local function ensureFolder(name, parent)
	local existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function part(props: { [string]: any })
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth

	-- Explicit safe assignment (avoid (p :: any)[k] = v strict/runtime quirks)
	if props.Name ~= nil then
		p.Name = props.Name
	end
	if props.Size ~= nil then
		p.Size = props.Size
	end
	if props.CFrame ~= nil then
		p.CFrame = props.CFrame
	elseif props.Position ~= nil then
		p.Position = props.Position
	end
	if props.Color ~= nil then
		p.Color = props.Color
	end
	if props.Material ~= nil then
		p.Material = props.Material
	end
	if props.Transparency ~= nil then
		p.Transparency = props.Transparency
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.Anchored ~= nil then
		p.Anchored = props.Anchored
	end
	if props.Shape ~= nil then
		p.Shape = props.Shape
	end
	if props.Parent ~= nil then
		p.Parent = props.Parent
	end
	-- Deco/kits: shadows off by default (huge Studio GPU win). Opt-in via CastShadow=true.
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	else
		p.CastShadow = false
	end

	return p
end

local function kitPart(parentPlinth, role, size, localOffset, color, material, shape)
	local p = part({
		Name = role,
		Size = size,
		CFrame = parentPlinth.CFrame * CFrame.new(localOffset),
		Color = color,
		Material = material or Enum.Material.Metal,
		CanCollide = false,
		Transparency = 0.32, -- visual kits v2: less washout
		Parent = parentPlinth,
	})
	if shape then
		p.Shape = shape
	end
	p.CanTouch = false -- never steal walk-buy Touched from plinth
	p.CanQuery = false
	p.CastShadow = false
	p:SetAttribute("WE_KitRole", role)
	p:SetAttribute("WE_BaseSize", size)
	p:SetAttribute("WE_LocalOffset", localOffset)
	p:SetAttribute("WE_Decor", true)
	return p
end

local function neonEdge(parentPart, color, thickness)
	local t = thickness or 0.35
	local s = parentPart.Size
	local edges = {
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, s.Z * 0.5) },
		{ Vector3.new(s.X + t, t, t), Vector3.new(0, s.Y * 0.5, -s.Z * 0.5) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(s.X * 0.5, s.Y * 0.5, 0) },
		{ Vector3.new(t, t, s.Z + t), Vector3.new(-s.X * 0.5, s.Y * 0.5, 0) },
	}
	for i, e in ipairs(edges) do
		local edge = part({
			Name = "Edge" .. i,
			Size = e[1],
			CFrame = parentPart.CFrame * CFrame.new(e[2]),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.15,
			Parent = parentPart.Parent,
		})
		edge:SetAttribute("WE_Decor", true)
	end
end

local function priceBillboard(parent, title, costLine, accent)
	-- Visual kits v2: larger readable price cards
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_PriceBillboard"
	bb.Size = UDim2.fromOffset(220, 96)
	bb.StudsOffset = Vector3.new(0, 6.0, 0)
	bb.AlwaysOnTop = true -- only useful nearby (short MaxDistance)
	bb.MaxDistance = 48 -- mobile: price cards near-only (was 1000)
	bb.Parent = parent

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(8, 10, 12)
	backdrop.BackgroundTransparency = 0.08
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Color = accent
	stroke.Thickness = 2
	stroke.Transparency = 0.1
	stroke.Parent = backdrop

	local titleLab = Instance.new("TextLabel")
	titleLab.Name = "Title"
	titleLab.Size = UDim2.new(1, -10, 0, 26)
	titleLab.Position = UDim2.fromOffset(5, 4)
	titleLab.BackgroundTransparency = 1
	titleLab.Text = title
	titleLab.TextColor3 = Color3.fromRGB(245, 245, 248)
	titleLab.TextScaled = true
	titleLab.Font = Enum.Font.GothamBold
	titleLab.TextStrokeTransparency = 0.4
	titleLab.Parent = backdrop

	local costLab = Instance.new("TextLabel")
	costLab.Name = "Cost"
	costLab.Size = UDim2.new(1, -10, 0, 56)
	costLab.Position = UDim2.fromOffset(5, 30)
	costLab.BackgroundTransparency = 1
	costLab.Text = "Lv 0 → 1\n" .. costLine
	costLab.TextColor3 = Color3.fromRGB(255, 215, 110)
	costLab.TextScaled = true
	costLab.Font = Enum.Font.GothamBold
	costLab.TextStrokeTransparency = 0.35
	costLab.Parent = backdrop
	return bb
end

local function plainBillboard(parent, text, size, offsetY, textColor)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(size.X, size.Y)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = true -- short range only
	bb.MaxDistance = 70 -- base/zone labels near-only (was 950)
	bb.Parent = parent

	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(12, 14, 16)
	backdrop.BackgroundTransparency = 0.22
	backdrop.BorderSizePixel = 0
	backdrop.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(70, 90, 70)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = backdrop

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor or Color3.fromRGB(235, 240, 235)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.6
	label.Parent = backdrop
	return bb
end

local function beacon(parent, pos, color, name)
	part({
		Name = name or "Beacon",
		Size = Vector3.new(0.55, 12, 0.55),
		Position = pos + Vector3.new(0, 6, 0),
		Color = Color3.fromRGB(40, 45, 42),
		Material = Enum.Material.Metal,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = (name or "Beacon") .. "_Tip",
		Size = Vector3.new(1.6, 1.6, 1.6),
		Position = pos + Vector3.new(0, 13, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = (name or "Beacon") .. "_Glow",
		Size = Vector3.new(3.2, 0.4, 3.2),
		Position = pos + Vector3.new(0, 0.3, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		Parent = parent,
	})
end

local function buildStructureKit(plotFolder, plotId, pos, offset, def)
	local isCC = def.Id == "CommandCenter"
	local plinthSize = Vector3.new(8, 1.2, 8)
	local plinth = part({
		Name = def.Id,
		Size = plinthSize,
		Position = pos + offset,
		Color = def.Plinth,
		Transparency = 0.32,
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Parent = plotFolder,
	})
	plinth.CanTouch = true -- walk-over buy (Touched + Heartbeat)
	plinth:SetAttribute("PlotId", plotId)
	plinth:SetAttribute("StructureId", def.Id)
	plinth:SetAttribute("BaseSize", plinthSize)
	CollectionService:AddTag(plinth, TAG_SLOT)

	local kit = def.Kit
	-- Visual kits v2: distinct silhouettes, neon accents, doors/windows (modest part count)
	if kit == "hq" then
		kitPart(plinth, "Body", Vector3.new(5.5, 3.4, 5.5), Vector3.new(0, 2.3, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(6.4, 0.55, 6.4), Vector3.new(0, 4.3, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.8, 0.35), Vector3.new(1.8, 6.8, 1.8), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.22, 6.6), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.1, 1.1, 1.1), Vector3.new(-2, 3.6, -2), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Door", Vector3.new(1.6, 2.2, 0.25), Vector3.new(0, 1.7, -2.85), Color3.fromRGB(30, 35, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.4, 1.0, 0.2), Vector3.new(2.0, 2.6, -2.8), Color3.fromRGB(70, 120, 150), Enum.Material.Glass, nil)
	elseif kit == "barracks" then
		kitPart(plinth, "Body", Vector3.new(6.6, 2.6, 4.4), Vector3.new(0, 1.9, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.1, 0.5, 5.0), Vector3.new(0, 3.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(6.9, 0.18, 4.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(1.4, 2.0, 0.25), Vector3.new(0, 1.6, -2.3), Color3.fromRGB(35, 40, 32), Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(1.2, 0.9, 0.2), Vector3.new(-2.2, 2.3, -2.25), Color3.fromRGB(70, 120, 140), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 1.8, 0.7), Vector3.new(-3.0, 2.3, 1.5), def.Accent, Enum.Material.Neon, nil)
	elseif kit == "depot" then
		kitPart(plinth, "Body", Vector3.new(6.9, 2.2, 5.6), Vector3.new(0, 1.7, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.3, 0.4, 6.1), Vector3.new(0, 2.95, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(3.2, 0.28, 5.9), Vector3.new(0, 0.72, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(2.8, 2.0, 0.3), Vector3.new(0, 1.6, -2.9), Color3.fromRGB(40, 50, 60), Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.8, 2.4, 2.0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "lab" then
		kitPart(plinth, "Body", Vector3.new(5.1, 3.2, 5.1), Vector3.new(0, 2.2, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(5.5, 0.5, 5.5), Vector3.new(0, 4.0, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.4, 3.8, 0.4), Vector3.new(0, 6.1, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(5.7, 0.2, 5.7), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Window", Vector3.new(1.5, 1.2, 0.2), Vector3.new(0, 2.6, -2.6), Color3.fromRGB(80, 160, 200), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.9, 0.9, 0.9), Vector3.new(2.0, 3.5, 2.0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "tower" then
		kitPart(plinth, "Body", Vector3.new(2.9, 5.8, 2.9), Vector3.new(0, 3.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(3.8, 0.5, 3.8), Vector3.new(0, 6.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.3, 3.5, 0.3), Vector3.new(0, 8.5, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(3.3, 0.22, 3.3), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Window", Vector3.new(1.0, 0.8, 0.2), Vector3.new(0, 4.5, -1.5), Color3.fromRGB(90, 140, 180), Enum.Material.Glass, nil)
		kitPart(plinth, "Detail", Vector3.new(0.7, 0.7, 0.7), Vector3.new(0, 7.0, 0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "dock" then
		kitPart(plinth, "Body", Vector3.new(7.5, 0.55, 7.5), Vector3.new(0, 0.9, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Pier", Vector3.new(8.8, 0.4, 2.4), Vector3.new(0, 1.15, 3.3), def.Roof, Enum.Material.Wood, nil)
		kitPart(plinth, "Accent", Vector3.new(7.2, 0.14, 0.4), Vector3.new(0, 1.25, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.2, 2.8, 0.4), Vector3.new(3.3, 2.1, 2.6), def.Accent, Enum.Material.Metal, nil)
		kitPart(plinth, "Door", Vector3.new(1.8, 0.3, 1.2), Vector3.new(0, 1.35, 4.2), Color3.fromRGB(40, 55, 70), Enum.Material.Metal, nil)
	elseif kit == "pad" then
		kitPart(plinth, "Body", Vector3.new(7.3, 0.45, 7.3), Vector3.new(0, 0.92, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(6.6, 0.14, 0.5), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(0.5, 0.14, 6.6), Vector3.new(0, 1.18, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Roof", Vector3.new(1.6, 0.3, 1.6), Vector3.new(0, 1.35, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Window", Vector3.new(0.5, 0.5, 0.5), Vector3.new(2.8, 1.4, 2.8), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	elseif kit == "wall" then
		kitPart(plinth, "Body", Vector3.new(7.5, 3.0, 1.5), Vector3.new(0, 2.1, 0), def.Body, Enum.Material.Concrete, nil)
		kitPart(plinth, "Accent", Vector3.new(7.7, 0.25, 1.7), Vector3.new(0, 3.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.4, 1.9), Vector3.new(0, 3.9, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(-3.2, 3.2, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(0.8, 1.2, 0.8), Vector3.new(3.2, 3.2, 0), def.Accent, Enum.Material.Neon, nil)
	elseif kit == "power" then
		kitPart(plinth, "Body", Vector3.new(4.6, 3.6, 4.6), Vector3.new(0, 2.5, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(2.3, 2.3, 2.3), Vector3.new(0, 4.7, 0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		kitPart(plinth, "Roof", Vector3.new(5.1, 0.4, 5.1), Vector3.new(0, 4.4, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Detail", Vector3.new(0.6, 2.5, 0.6), Vector3.new(2.0, 2.8, 2.0), Color3.fromRGB(60, 55, 40), Enum.Material.Metal, nil)
	elseif kit == "warehouse" then
		kitPart(plinth, "Body", Vector3.new(7.1, 2.8, 5.6), Vector3.new(0, 2.0, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(7.5, 0.5, 6.1), Vector3.new(0, 3.55, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Accent", Vector3.new(7.3, 0.2, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Door", Vector3.new(2.6, 2.2, 0.3), Vector3.new(0, 1.7, -2.95), Color3.fromRGB(50, 45, 38), Enum.Material.Metal, nil)
	else
		kitPart(plinth, "Body", Vector3.new(5.3, 3.5, 5.3), Vector3.new(0, 2.4, 0), def.Body, Enum.Material.Metal, nil)
		kitPart(plinth, "Roof", Vector3.new(4.2, 1.2, 4.2), Vector3.new(0, 4.6, 0), def.Roof, Enum.Material.Metal, nil)
		kitPart(plinth, "Antenna", Vector3.new(0.35, 4.2, 0.35), Vector3.new(0, 7.2, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Accent", Vector3.new(5.9, 0.22, 5.9), Vector3.new(0, 0.7, 0), def.Accent, Enum.Material.Neon, nil)
		kitPart(plinth, "Detail", Vector3.new(1.0, 1.0, 1.0), Vector3.new(2.0, 3.5, -2.0), def.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	end

	local cost = STARTER_COST[def.Id] or 0
	-- Prefer readable DisplayName; client refreshSlotBillboard rewrites when attached
	local displayNames = {
		CommandCenter = "Command Center",
		Barracks = "Barracks",
		VehicleDepot = "Vehicle Depot",
		WeaponsFacility = "Weapons Facility",
		Helipad = "Helipad",
		Dock = "Naval Dock",
		Airfield = "Airfield",
		DefensiveWalls = "Defensive Walls",
		Watchtowers = "Watchtowers",
		Radar = "Radar Station",
		ResearchLab = "Research Lab",
		MissileDefense = "Missile Defense",
		PowerStation = "Power Station",
		Warehouse = "Warehouse",
		SpecialForcesFacility = "Special Forces",
	}
	local nice = displayNames[def.Id] or def.Id
	local title = if isCC then ("★ " .. nice) else nice
	local rates = EconomyConfig.PassiveIncome and EconomyConfig.PassiveIncome.PerLevelRates
	local rate = if typeof(rates) == "table" then (tonumber(rates[def.Id]) or 0) else 0
	local incomeBit = if rate > 0 then (" · +$" .. tostring(rate) .. "/tick") else ""
	priceBillboard(plinth, title, "Lv 0 → 1 / $" .. tostring(cost) .. incomeBit, def.Accent)
	-- Optional free Creator Store building visual (skipped when StudioSkipWorldDressing)
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		vas.TryAttachBuildingVisual(plinth, def.Id)
	end)
	return plinth
end



-- Desert camo infantry Part kit — vest / helmet / shemagh accents, clearer rifle
local function makeSoldierKit(parentFolder, name, cf, bodyColor, labelText, labelColor, health, npcType, npcId)
	-- Visual props for Training Yard / static kits. R6-ish proportions (~5 stud tall).
	-- Live combat NPCs use CombatService.SpawnNPC (BankGuard etc.).
	local model = Instance.new("Model")
	model.Name = name
	if npcId then
		model:SetAttribute("NPCId", npcId)
	end
	if npcType then
		model:SetAttribute("NPCType", npcType)
	end
	local desertBase = Color3.fromRGB(145, 125, 85)
	local camo = desertBase:Lerp(bodyColor, 0.45)
	local camoDark = Color3.fromRGB(
		math.clamp(math.floor(camo.R * 255) - 28, 20, 255),
		math.clamp(math.floor(camo.G * 255) - 22, 20, 255),
		math.clamp(math.floor(camo.B * 255) - 18, 20, 255)
	)
	-- R6 torso = 2×2×1; lift so feet sit on ground (cf is approx mid-body)
	local torso = part({
		Name = "HumanoidRootPart",
		Size = Vector3.new(2, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = true,
		CFrame = cf,
		Parent = model,
	})
	local head = part({
		Name = "Head",
		Size = Vector3.new(1.05, 1.05, 1.05),
		Color = Color3.fromRGB(110, 85, 62),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 1.55, 0),
		Shape = Enum.PartType.Ball,
		Parent = model,
	})
	part({
		Name = "Helmet",
		Size = Vector3.new(1.2, 0.5, 1.2),
		Color = camoDark,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, 0.38, 0),
		Parent = model,
	})
	part({
		Name = "Shemagh",
		Size = Vector3.new(1.25, 0.45, 1.15),
		Color = Color3.fromRGB(200, 185, 150),
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = head.CFrame * CFrame.new(0, -0.32, 0.05),
		Parent = model,
	})
	part({
		Name = "Vest",
		Size = Vector3.new(2.1, 1.2, 1.15),
		Color = camoDark,
		Material = Enum.Material.Leather,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.15, 0),
		Parent = model,
	})
	part({
		Name = "VestPouch",
		Size = Vector3.new(1.5, 0.45, 0.3),
		Color = Color3.fromRGB(90, 80, 55),
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.05, -0.6),
		Parent = model,
	})
	-- R6 arms 1×2×1
	part({
		Name = "ArmL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-1.5, 0, 0),
		Parent = model,
	})
	part({
		Name = "ArmR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.5, 0, 0),
		Parent = model,
	})
	-- R6 legs 1×2×1
	part({
		Name = "LegL",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "LegR",
		Size = Vector3.new(1, 2, 1),
		Color = camo,
		Material = Enum.Material.Fabric,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -2, 0),
		Parent = model,
	})
	part({
		Name = "BootL",
		Size = Vector3.new(1.05, 0.35, 1.15),
		Color = Color3.fromRGB(35, 32, 28),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(-0.5, -3.1, 0.1),
		Parent = model,
	})
	part({
		Name = "BootR",
		Size = Vector3.new(1.05, 0.35, 1.15),
		Color = Color3.fromRGB(35, 32, 28),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0.5, -3.1, 0.1),
		Parent = model,
	})
	part({
		Name = "RifleStock",
		Size = Vector3.new(0.3, 0.4, 0.9),
		Color = Color3.fromRGB(55, 48, 38),
		Material = Enum.Material.Wood,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.15, 0.35),
		Parent = model,
	})
	part({
		Name = "Rifle",
		Size = Vector3.new(0.25, 0.25, 2.4),
		Color = Color3.fromRGB(32, 34, 36),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.2, -0.95),
		Parent = model,
	})
	part({
		Name = "RifleBarrel",
		Size = Vector3.new(0.14, 0.14, 0.9),
		Color = Color3.fromRGB(25, 25, 28),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(1.15, 0.22, -2.25),
		Parent = model,
	})
	part({
		Name = "Accent",
		Size = Vector3.new(1.6, 0.1, 0.28),
		Color = labelColor or Color3.fromRGB(200, 140, 60),
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CFrame = torso.CFrame * CFrame.new(0, 0.85, -0.5),
		Parent = model,
	})
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = health or 100
	hum.Health = health or 100
	-- Single nametag only via Billboard — kill default Humanoid nameplate
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.NameOcclusion = Enum.NameOcclusion.OccludeAll
	hum.Parent = model
	model.PrimaryPart = torso
	-- Optional free Soldier catalog visual (skipped when StudioSkipWorldDressing)
	pcall(function()
		local vas = require(script.Parent.Parent.Services.VisualAssetService)
		local kind = if typeof(npcType) == "string" and npcType ~= "" then npcType else "Soldier"
		vas.TryAttachCharacterVisual(model, kind)
	end)
	model.Parent = parentFolder
	CollectionService:AddTag(model, TAG_NPC_ENTITY)
	if labelText then
		-- One clean label on head (not also on torso)
		local bb = plainBillboard(head, labelText, Vector2.new(120, 24), 2.2, labelColor or Color3.fromRGB(255, 200, 140))
		bb.Name = "NPCLabel"
		bb.MaxDistance = 70
	end
	return model
end


-- Continuous floor + safety catch + perimeter mountain ring (mobile-friendly part count)
local function groundCenterY(): number
	return GROUND_TOP_Y - GROUND_THICKNESS * 0.5
end

local function buildSafetyUnderfloor(mapFolder: Folder)
	part({
		Name = "SafetyCatch",
		Size = Vector3.new(SAFETY_FLOOR_SIZE, 4, SAFETY_FLOOR_SIZE),
		Position = Vector3.new(0, SAFETY_FLOOR_Y, 0),
		Color = Color3.fromRGB(18, 22, 18),
		Material = Enum.Material.Slate,
		Transparency = 0.92,
		CanCollide = true,
		Anchored = true,
		Parent = mapFolder,
	})
end

local function buildEdgeBerms(mapFolder: Folder)
	-- Soft inner berm just inside Ground edge (keeps stroll-off from feeling like cliff)
	local half = GROUND_SIZE * 0.5 - 40
	local bermH = 18
	local bermT = 28
	local bermY = GROUND_TOP_Y + bermH * 0.5
	local sides = {
		{ Name = "EdgeBermN", Size = Vector3.new(GROUND_SIZE - 80, bermH, bermT), Pos = Vector3.new(0, bermY, -half) },
		{ Name = "EdgeBermS", Size = Vector3.new(GROUND_SIZE - 80, bermH, bermT), Pos = Vector3.new(0, bermY, half) },
		{ Name = "EdgeBermE", Size = Vector3.new(bermT, bermH, GROUND_SIZE - 80), Pos = Vector3.new(half, bermY, 0) },
		{ Name = "EdgeBermW", Size = Vector3.new(bermT, bermH, GROUND_SIZE - 80), Pos = Vector3.new(-half, bermY, 0) },
	}
	for _, s in ipairs(sides) do
		part({
			Name = s.Name,
			Size = s.Size,
			Position = s.Pos,
			Color = Color3.fromRGB(185, 155, 105),
			Material = Enum.Material.Sand,
			CanCollide = true,
			Anchored = true,
			Parent = mapFolder,
		})
	end
end

local function buildMountainRing(root: Folder)
	--[[
		Desert mesa / butte rim — terracotta / sienna / reddish-brown layered Part kits.
		Flat-topped sedimentary striations; varied heights; foothills + collide berm.
		Keeps continuous floor / CanCollide perimeter from void-fall fix (4021025).
	]]
	local folder = Instance.new("Folder")
	folder.Name = "MountainRing"
	folder.Parent = root

	local mesaColors = {
		Color3.fromRGB(168, 95, 58), -- terracotta
		Color3.fromRGB(145, 78, 48), -- burnt sienna
		Color3.fromRGB(185, 110, 70), -- warm sandstone
		Color3.fromRGB(130, 72, 48), -- deep clay
		Color3.fromRGB(175, 105, 65), -- mesa orange
		Color3.fromRGB(155, 88, 55), -- red rock
	}
	local strataLight = Color3.fromRGB(200, 145, 100)
	local strataDark = Color3.fromRGB(110, 62, 40)
	local sandFoothill = Color3.fromRGB(195, 160, 110)

	local half = GROUND_SIZE * 0.5
	local ringR = half + 90
	-- PERF: 12–16 segments (was 24). Studio laptops struggle with mesa*strata*cap parts.
	local configured = tonumber(DevConfig.MountainRingSegments) or 14
	local segCount = math.clamp(math.floor(configured), 12, 24)
	local segArc = (math.pi * 2) / segCount
	local segLen = ringR * segArc * 1.12

	for i = 1, segCount do
		local angle = (i - 0.5) * segArc
		local cx = math.cos(angle) * ringR
		local cz = math.sin(angle) * ringR
		local hSeed = ((i * 17 + 31) % 80) + 40
		local height = hSeed
		if i % 7 == 0 then
			height = math.min(125, height + 32)
		elseif i % 5 == 0 then
			height = math.max(42, height - 16)
		end
		-- Flat-topped mesa: slightly shorter + wider top silhouette
		local depth = 58 + (i % 5) * 9
		local yaw = -angle + math.pi * 0.5
		local col = mesaColors[((i - 1) % #mesaColors) + 1]
		local mat = Enum.Material.Sandstone
		if i % 3 == 0 then
			mat = Enum.Material.Rock
			col = col:Lerp(strataDark, 0.25)
		elseif i % 4 == 0 then
			mat = Enum.Material.Slate
			col = col:Lerp(Color3.fromRGB(140, 95, 70), 0.3)
		end
		local ridge = part({
			Name = "Mesa_" .. i,
			Size = Vector3.new(segLen, height, depth),
			CFrame = CFrame.new(cx, GROUND_TOP_Y + height * 0.5 - 2, cz) * CFrame.Angles(0, yaw, 0),
			Color = col,
			Material = mat,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		})
		ridge:SetAttribute("WE_Mountain", true)
		-- Sedimentary striation bands (visual only) — every 3rd segment (perf)
		if i % 3 == 0 then
			local bandH = math.clamp(height * 0.12, 4, 10)
			part({
				Name = "Strata_" .. i,
				Size = Vector3.new(segLen * 1.02, bandH, depth * 0.98),
				CFrame = CFrame.new(cx, GROUND_TOP_Y + height * 0.38, cz) * CFrame.Angles(0, yaw, 0),
				Color = if i % 4 == 0 then strataLight else strataDark,
				Material = Enum.Material.Sandstone,
				CanCollide = false,
				Anchored = true,
				Transparency = 0.08,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
		-- Flat mesa cap (butte top) — every 3rd segment (perf)
		if i % 3 == 0 then
			local tipH = 6 + (i % 5) * 2
			part({
				Name = "MesaCap_" .. i,
				Size = Vector3.new(segLen * 0.72, tipH, depth * 0.7),
				CFrame = CFrame.new(cx, GROUND_TOP_Y + height + tipH * 0.25 - 2, cz) * CFrame.Angles(0, yaw, 0),
				Color = col:Lerp(strataLight, 0.35),
				Material = Enum.Material.Sandstone,
				CanCollide = false,
				Anchored = true,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
		-- Inner foothill shelf (sand) — collide continuity from berm (sparser)
		if i % 4 == 0 then
			local footH = 12 + (i % 4) * 3
			local footR = half + 35
			local fx = math.cos(angle) * footR
			local fz = math.sin(angle) * footR
			part({
				Name = "Foothill_" .. i,
				Size = Vector3.new(segLen * 0.9, footH, 38),
				CFrame = CFrame.new(fx, GROUND_TOP_Y + footH * 0.5 - 1, fz) * CFrame.Angles(0, yaw, 0),
				Color = sandFoothill,
				Material = Enum.Material.Sand,
				CanCollide = true,
				Anchored = true,
				Parent = folder,
			}):SetAttribute("WE_Mountain", true)
		end
	end

	-- Mid-ground rocky outcrops just inside the ring (sandy floor props)
	for oi = 1, 4 do
		local ang = (oi / 12) * math.pi * 2 + 0.2
		local orad = half - 220 - (oi % 4) * 40
		local ox = math.cos(ang) * orad
		local oz = math.sin(ang) * orad
		local oh = 10 + (oi % 5) * 4
		part({
			Name = "Outcrop_" .. oi,
			Size = Vector3.new(28 + (oi % 3) * 8, oh, 22 + (oi % 2) * 6),
			Position = Vector3.new(ox, GROUND_TOP_Y + oh * 0.5 - 1, oz),
			Color = mesaColors[((oi - 1) % #mesaColors) + 1],
			Material = Enum.Material.Sandstone,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		}):SetAttribute("WE_Mountain", true)
	end

	-- Corner massifs (extra bulk — flat-topped buttes)
	-- Cardinal buttes only (was 8 incl. diagonals) — Studio collide/GPU win
	local massifs = {
		{ 0, -1, "N" },
		{ 0, 1, "S" },
		{ 1, 0, "E" },
		{ -1, 0, "W" },
	}
	for mi, m in ipairs(massifs) do
		local mx = m[1] * (half + 120)
		local mz = m[2] * (half + 120)
		local mh = 75 + (mi % 4) * 14
		part({
			Name = "Butte_" .. m[3],
			Size = Vector3.new(150, mh, 150),
			Position = Vector3.new(mx, GROUND_TOP_Y + mh * 0.5 - 4, mz),
			Color = mesaColors[((mi - 1) % #mesaColors) + 1],
			Material = Enum.Material.Sandstone,
			CanCollide = true,
			Anchored = true,
			Parent = folder,
		}):SetAttribute("WE_Mountain", true)
		-- Flat caps omitted for perf (mesa segments already have caps)
	end

	print("[WAR EMPIRE] MapSetup: MountainRing mesas=" .. tostring(segCount) .. " + buttes/outcrops (desert terracotta)")
end

local function buildVisualFillPatches(mapFolder: Folder)
	-- Low-cost ground patches between plot ring and mid-map so dead space doesn't look empty
	local patches = {
		Vector3.new(400, GROUND_TOP_Y + 0.08, 200),
		Vector3.new(-350, GROUND_TOP_Y + 0.08, -250),
		Vector3.new(600, GROUND_TOP_Y + 0.08, -100),
		Vector3.new(-400, GROUND_TOP_Y + 0.08, -550),
	}
	for i, pos in ipairs(patches) do
		local w = 80 + (i % 4) * 25
		local d = 55 + (i % 3) * 20
		part({
			Name = "FillPatch_" .. i,
			Size = Vector3.new(w, 0.2, d),
			Position = pos,
			Color = if i % 2 == 0 then Color3.fromRGB(220, 195, 140) else Color3.fromRGB(195, 165, 115),
			Material = if i % 2 == 0 then Enum.Material.Sand else Enum.Material.Sandstone,
			CanCollide = false,
			Anchored = true,
			Transparency = 0.05,
			Parent = mapFolder,
		})
	end
end

local function buildOilDeckRamp(parent: Folder, territoryId: string, deckPos: Vector3, towardCenter: Vector3)
	--[[
		Stepped collide stairs from elevated oil deck (~Y=28) down to ground.
		towardCenter = horizontal direction from deck toward map center (inland).
	]]
	local dir = Vector3.new(towardCenter.X, 0, towardCenter.Z)
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(if deckPos.X >= 0 then -1 else 1, 0, 0)
	end
	dir = dir.Unit
	local deckTopY = deckPos.Y
	local steps = 10
	local rise = (deckTopY - GROUND_TOP_Y) / steps
	local run = 9
	local stepW = 22
	local stepT = 7.5
	-- Start just outside the 48-stud deck toward inland
	local edge = Vector3.new(deckPos.X, 0, deckPos.Z) - dir * 26
	for s = 1, steps do
		local y = deckTopY - rise * s + 0.6
		local horiz = edge - dir * (run * s)
		local pos = Vector3.new(horiz.X, y, horiz.Z)
		part({
			Name = territoryId .. "_RampStep" .. s,
			Size = Vector3.new(stepW, 1.3, stepT),
			CFrame = CFrame.lookAt(pos, pos + dir),
			Color = Color3.fromRGB(75, 78, 82),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Anchored = true,
			Parent = parent,
		})
	end
	local midHoriz = edge - dir * (run * 5)
	part({
		Name = territoryId .. "_RampShelf",
		Size = Vector3.new(28, 1.4, 14),
		Position = Vector3.new(midHoriz.X, deckTopY - rise * 5, midHoriz.Z),
		Color = Color3.fromRGB(70, 74, 78),
		Material = Enum.Material.Metal,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
	local approach = edge - dir * (run * steps + 10)
	part({
		Name = territoryId .. "_RampApproach",
		Size = Vector3.new(30, 1, 18),
		Position = Vector3.new(approach.X, GROUND_TOP_Y + 0.45, approach.Z),
		Color = Color3.fromRGB(55, 60, 55),
		Material = Enum.Material.Concrete,
		CanCollide = true,
		Anchored = true,
		Parent = parent,
	})
end


local MapSetup = {}

-- Exported for Bootstrap ground heal / verify
MapSetup.GROUND_SIZE = GROUND_SIZE
MapSetup.GROUND_THICKNESS = GROUND_THICKNESS
MapSetup.GROUND_TOP_Y = GROUND_TOP_Y
MapSetup.SAFETY_FLOOR_SIZE = SAFETY_FLOOR_SIZE
MapSetup.SAFETY_FLOOR_Y = SAFETY_FLOOR_Y

local function buildPadSupportShelves(setup: Folder)
	--[[
		Collide shelves under elevated upgrade pads / decks so players never
		treat CanCollide=false kit deco as floor. Fills air gap pad→Ground.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return
	end
	local folder = map:FindFirstChild("PadSupports")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "PadSupports"
	folder.Parent = map

	local CollectionService = game:GetService("CollectionService")
	local TAG = TAG_SLOT
	local count = 0
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") and inst:IsDescendantOf(setup) then
			local topY = inst.Position.Y + inst.Size.Y * 0.5
			local gap = topY - GROUND_TOP_Y
			if gap > 2.5 then
				local shelfH = math.clamp(gap - 0.5, 1, 40)
				local shelfY = GROUND_TOP_Y + shelfH * 0.5
				part({
					Name = "PadShelf_" .. tostring(count),
					Size = Vector3.new(math.max(inst.Size.X + 4, 12), shelfH, math.max(inst.Size.Z + 4, 12)),
					Position = Vector3.new(inst.Position.X, shelfY, inst.Position.Z),
					Color = Color3.fromRGB(90, 85, 70),
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Anchored = true,
					Parent = folder,
				})
				count += 1
			end
		end
	end
	-- Also sweep StructureId parts under Bases (tag may lag)
	local bases = setup:FindFirstChild("Bases")
	if bases then
		for _, desc in ipairs(bases:GetDescendants()) do
			if desc:IsA("BasePart") then
				local sid = desc:GetAttribute("StructureId")
				if typeof(sid) == "string" then
					local topY = desc.Position.Y + desc.Size.Y * 0.5
					local gap = topY - GROUND_TOP_Y
					if gap > 2.5 then
						-- Skip if already covered by a nearby shelf
						local covered = false
						for _, child in ipairs(folder:GetChildren()) do
							if child:IsA("BasePart") then
								local dx = child.Position.X - desc.Position.X
								local dz = child.Position.Z - desc.Position.Z
								if dx * dx + dz * dz < 25 then
									covered = true
									break
								end
							end
						end
						if not covered then
							local shelfH = math.clamp(gap - 0.5, 1, 40)
							local shelfY = GROUND_TOP_Y + shelfH * 0.5
							part({
								Name = "PadShelf_" .. tostring(count),
								Size = Vector3.new(math.max(desc.Size.X + 4, 12), shelfH, math.max(desc.Size.Z + 4, 12)),
								Position = Vector3.new(desc.Position.X, shelfY, desc.Position.Z),
								Color = Color3.fromRGB(90, 85, 70),
								Material = Enum.Material.Concrete,
								CanCollide = true,
								Anchored = true,
								Parent = folder,
							})
							count += 1
						end
					end
				end
			end
		end
	end
	if count > 0 then
		print("[WAR EMPIRE] MapSetup: PadSupports shelves=" .. tostring(count) .. " (collide fillers under elevated pads)")
	end
end

function MapSetup.EnsureGroundHealthy(setup: Instance): boolean
	--[[
		Soft-heal existing WarEmpireSetup Ground / SafetyCatch.
		Returns true if healthy (or repaired in place), false if caller should rebuild.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	local ground = map:FindFirstChild("Ground")
	if not (ground and ground:IsA("BasePart")) then
		return false
	end
	local repaired = false
	-- Always force full-size collide Ground every Play (bulletproof void floor)
	if ground.Size.X < GROUND_SIZE - 1 or ground.Size.Z < GROUND_SIZE - 1 or ground.Size.Y < GROUND_THICKNESS - 0.5
		or ground.CanCollide ~= true
	then
		ground.Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE)
		ground.Position = Vector3.new(0, groundCenterY(), 0)
		repaired = true
	end
	-- Even when size OK, re-assert collide / anchor every start
	ground.Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE)
	ground.Position = Vector3.new(0, groundCenterY(), 0)
	if ground.CanCollide ~= true then
		ground.CanCollide = true
		repaired = true
	end
	if ground.Anchored ~= true then
		ground.Anchored = true
		repaired = true
	end
	ground.Color = COL_GROUND
	ground.Material = Enum.Material.Sand

	local catch = map:FindFirstChild("SafetyCatch")
	if not (catch and catch:IsA("BasePart")) then
		buildSafetyUnderfloor(map :: Folder)
		repaired = true
	else
		catch.Size = Vector3.new(SAFETY_FLOOR_SIZE, 4, SAFETY_FLOOR_SIZE)
		catch.Position = Vector3.new(0, SAFETY_FLOOR_Y, 0)
		catch.CanCollide = true
		catch.Anchored = true
		catch.Transparency = 0.92
	end

	if not setup:FindFirstChild("MountainRing") then
		buildMountainRing(setup :: Folder)
		repaired = true
	end
	if not map:FindFirstChild("EdgeBermN") then
		buildEdgeBerms(map :: Folder)
		repaired = true
	end

	buildPadSupportShelves(setup :: Folder)

	print(string.format(
		"[WAR EMPIRE] Ground heal: ok size=%.0fx%.0fx%.0f CanCollide=%s repaired=%s",
		ground.Size.X,
		ground.Size.Y,
		ground.Size.Z,
		tostring(ground.CanCollide),
		tostring(repaired)
	))
	return true
end




function MapSetup.ForceRebuildGround(setup: Instance): boolean
	--[[
		Hard rebuild: destroy Map.Ground + SafetyCatch and recreate them.
		Use every Play when soft-heal is not enough (stale holes / void gaps).
		Does NOT rebuild the whole WarEmpireSetup — only the collide floor layers.
	]]
	local map = setup:FindFirstChild("Map")
	if not map then
		return false
	end
	local oldGround = map:FindFirstChild("Ground")
	if oldGround then
		oldGround:Destroy()
	end
	local oldCatch = map:FindFirstChild("SafetyCatch")
	if oldCatch then
		oldCatch:Destroy()
	end

	local ground = part({
		Name = "Ground",
		Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE),
		Position = Vector3.new(0, groundCenterY(), 0),
		Color = COL_GROUND,
		Material = Enum.Material.Sand,
		CanCollide = true,
		Anchored = true,
		Parent = map,
	})
	ground.CanCollide = true
	ground.Anchored = true
	buildSafetyUnderfloor(map :: Folder)
	if not map:FindFirstChild("EdgeBermN") then
		buildEdgeBerms(map :: Folder)
	end
	if not setup:FindFirstChild("MountainRing") then
		buildMountainRing(setup :: Folder)
	end
	buildPadSupportShelves(setup :: Folder)

	print(string.format(
		"[WAR EMPIRE] Ground FORCE-REBUILT: size=%.0fx%.0fx%.0f CanCollide=%s Anchored=%s",
		ground.Size.X,
		ground.Size.Y,
		ground.Size.Z,
		tostring(ground.CanCollide),
		tostring(ground.Anchored)
	))
	return ground.CanCollide == true and ground.Size.X >= GROUND_SIZE - 1 and ground.Size.Y >= GROUND_THICKNESS - 0.5
end

function MapSetup.Run()
	-- Normal gravity so characters fall onto terrain (not float/void)
	Workspace.Gravity = 196.2

	-- Lighting / sky / atmosphere — bright midday desert (inspiration only)
	Lighting.Ambient = Color3.fromRGB(165, 145, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(185, 165, 130)
	Lighting.Brightness = 3.15
	Lighting.ClockTime = 12.5 -- intense midday sun
	Lighting.GeographicLatitude = 22
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.42
	Lighting.FogColor = Color3.fromRGB(210, 195, 160)
	Lighting.FogStart = 1200
	Lighting.FogEnd = 5200
	pcall(function()
		Lighting.GlobalShadows = true
	end)

	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	sky.Name = "WE_Sky"
	sky.CelestialBodiesShown = true
	sky.StarCount = 2500
	sky.SunAngularSize = 18 -- larger desert sun
	sky.MoonAngularSize = 9

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.14
	atm.Offset = 0.08
	atm.Color = Color3.fromRGB(200, 185, 150) -- warm haze near horizon
	atm.Decay = Color3.fromRGB(95, 130, 190) -- deep blue sky fade
	atm.Glare = 0.32
	atm.Haze = 1.15 -- low haze, high contrast

	-- Cancel prior day/night loop on resetmap; gentle cycle biased to bright desert day
	local dayMarker = Lighting:FindFirstChild("WE_DayNightMarker")
	if dayMarker then
		dayMarker:Destroy()
	end
	dayMarker = Instance.new("Folder")
	dayMarker.Name = "WE_DayNightMarker"
	dayMarker.Parent = Lighting
	task.spawn(function()
		local STEP = 0.03
		local WAIT = 1.5
		local dayAmb = Color3.fromRGB(165, 145, 110)
		local dayOut = Color3.fromRGB(185, 165, 130)
		local dayFog = Color3.fromRGB(210, 195, 160)
		local nightAmb = Color3.fromRGB(40, 45, 70)
		local nightOut = Color3.fromRGB(50, 55, 85)
		local nightFog = Color3.fromRGB(55, 60, 90)
		while dayMarker.Parent do
			local t = (Lighting.ClockTime + STEP) % 24
			Lighting.ClockTime = t
			local night = 0
			if t < 5 or t > 20 then
				night = 1
			elseif t < 7 then
				night = 1 - (t - 5) / 2
			elseif t > 18 then
				night = (t - 18) / 2
			end
			Lighting.Brightness = 3.2 - night * 2.1
			Lighting.Ambient = dayAmb:Lerp(nightAmb, night)
			Lighting.OutdoorAmbient = dayOut:Lerp(nightOut, night)
			Lighting.FogColor = dayFog:Lerp(nightFog, night)
			Lighting.FogStart = 1200 - night * 250
			Lighting.FogEnd = 5200 - night * 800
			atm.Density = 0.13 + night * 0.14
			atm.Haze = 1.1 + night * 1.0
			atm.Color = Color3.fromRGB(200, 185, 150):Lerp(Color3.fromRGB(70, 80, 120), night)
			atm.Decay = Color3.fromRGB(95, 130, 190):Lerp(Color3.fromRGB(40, 50, 90), night)
			atm.Glare = 0.32 - night * 0.2
			task.wait(WAIT)
		end
	end)

	local root = ensureFolder("WarEmpireSetup", Workspace)
	local map = ensureFolder("Map", root)
	-- Continuous collide floor: thick, large, explicit CanCollide — never reads as sky
	part({
		Name = "Ground",
		Size = Vector3.new(GROUND_SIZE, GROUND_THICKNESS, GROUND_SIZE),
		Position = Vector3.new(0, groundCenterY(), 0),
		Color = COL_GROUND,
		Material = Enum.Material.Sand,
		CanCollide = true,
		Anchored = true,
		Parent = map,
	})
	buildSafetyUnderfloor(map)
	buildEdgeBerms(map)
	buildVisualFillPatches(map)
	buildMountainRing(root)
	-- Road grid scaled to plot ring (optional visual guide)
	for _, z in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		part({
			Name = "RoadZ" .. z,
			Size = Vector3.new(GROUND_SIZE, 0.15, 14),
			Position = Vector3.new(0, GROUND_TOP_Y + 0.05, z),
			Color = Color3.fromRGB(50, 52, 48),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
			Parent = map,
		})
	end
	for _, x in ipairs({ -PLOT_RING, 0, PLOT_RING }) do
		part({
			Name = "RoadX" .. x,
			Size = Vector3.new(14, 0.15, GROUND_SIZE),
			Position = Vector3.new(x, GROUND_TOP_Y + 0.05, 0),
			Color = Color3.fromRGB(50, 52, 48),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
			Parent = map,
		})
	end

	local bases = ensureFolder("Bases", root)
	for plotId, pos in ipairs(PLOT_POSITIONS) do
		local plotFolder = Instance.new("Folder")
		plotFolder.Name = "Plot" .. plotId
		plotFolder.Parent = bases

		local pad = part({
			Name = "PlotPad",
			Size = Vector3.new(PLOT_PAD_SIZE, 1, PLOT_PAD_SIZE),
			Position = pos,
			Color = COL_PAD,
			Material = Enum.Material.Concrete,
			Parent = plotFolder,
		})
		pad:SetAttribute("PlotId", plotId)
		CollectionService:AddTag(pad, TAG_BASE)
		neonEdge(pad, COL_PAD_EDGE, 0.55)

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "PlayerSpawn"
		spawn.Size = Vector3.new(10, 1, 10)
		spawn.Position = pos + Vector3.new(0, 2, 55)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.BrickColor = BrickColor.new("Dark green")
		spawn.Material = Enum.Material.Neon
		spawn.Parent = plotFolder

		plainBillboard(pad, "BASE " .. plotId .. "  ·  Walk pads to BUY  ·  E / B menu", Vector2.new(280, 44), 16, Color3.fromRGB(200, 230, 200))
		beacon(plotFolder, pos + Vector3.new(0, 0, -62), COL_PAD_EDGE, "PlotBeacon")

		for i, def in ipairs(STRUCTURES) do
			local col = (i - 1) % STRUCT_COLS
			local row = math.floor((i - 1) / STRUCT_COLS)
			local offset = STRUCT_ORIGIN + Vector3.new(col * STRUCT_GAP, 0, row * STRUCT_GAP)
			buildStructureKit(plotFolder, plotId, pos, offset, def)
		end

		-- Training Yard targets (soldiers "train" → server cash; visual only)
		local yardFolder = Instance.new("Folder")
		yardFolder.Name = "TrainingYard"
		yardFolder.Parent = plotFolder
		for ti = 1, 3 do
			local tpos = pos + Vector3.new(-50 + ti * 18, 3.5, 48)
			local target = part({
				Name = "TrainingTarget" .. ti,
				Size = Vector3.new(4, 6, 0.6),
				Position = tpos,
				Color = Color3.fromRGB(200, 60, 60),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = yardFolder,
			})
			target:SetAttribute("PlotId", plotId)
			target:SetAttribute("WE_TrainingTarget", true)
			part({
				Name = "TargetStand" .. ti,
				Size = Vector3.new(1, 4, 1),
				Position = tpos + Vector3.new(0, -5, 0),
				Color = Color3.fromRGB(70, 70, 70),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = yardFolder,
			})
			part({
				Name = "TargetBullseye" .. ti,
				Size = Vector3.new(1.6, 1.6, 0.35),
				Position = tpos + Vector3.new(0, 0.5, -0.2),
				Color = Color3.fromRGB(240, 220, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = yardFolder,
			})
		end
		-- Training workers (visual only — income is SoldierService tick)
		for wi = 1, 2 do
			local wpos = pos + Vector3.new(-40 + wi * 20, 2.6, 42)
			makeSoldierKit(
				yardFolder,
				"TrainingWorker" .. wi,
				CFrame.new(wpos) * CFrame.Angles(0, math.rad(180), 0),
				Color3.fromRGB(70, 85, 55),
				"WORKER",
				Color3.fromRGB(180, 220, 120),
				50,
				nil,
				nil
			)
		end
		-- Target ring + base plate polish
		part({
			Name = "YardPad",
			Size = Vector3.new(55, 0.6, 18),
			Position = pos + Vector3.new(-14, 0.4, 48),
			Color = Color3.fromRGB(48, 52, 42),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = yardFolder,
		})
		plainBillboard(
			part({
				Name = "YardAnchor",
				Size = Vector3.new(1, 1, 1),
				Position = pos + Vector3.new(-14, 8, 48),
				Transparency = 1,
				CanCollide = false,
				Parent = yardFolder,
			}),
			"TRAINING YARD · Soldiers earn cash",
			Vector2.new(280, 40),
			8,
			Color3.fromRGB(255, 200, 120)
		)
	end

	local territories = ensureFolder("Territories", root)
	for _, def in ipairs(TERRITORIES) do
		local diameter = (def.Radius or 30) * 2
		local marker = part({
			Name = def.Id,
			Size = Vector3.new(diameter, 1.5, diameter),
			Position = def.Pos,
			Color = def.Color,
			Transparency = 0.45,
			Material = Enum.Material.Neon,
			Parent = territories,
		})
		marker:SetAttribute("TerritoryId", def.Id)
		marker:SetAttribute("Radius", def.Radius or 30)
		marker:SetAttribute("OwnerType", "Neutral")
		marker:SetAttribute("OwnerUserId", 0)
		marker:SetAttribute("CaptureProgress", 0)
		CollectionService:AddTag(marker, TAG_TERRITORY)
		CollectionService:AddTag(marker, TAG_CAPTURE)

		plainBillboard(marker, def.Id .. "  [NEUTRAL]  ·  Stand to capture", Vector2.new(240, 42), 10, Color3.new(1, 1, 1))

		part({
			Name = def.Id .. "_Ring",
			Size = Vector3.new(diameter + 8, 0.4, diameter + 8),
			Position = def.Pos + Vector3.new(0, 0.2, 0),
			Color = def.Color,
			Transparency = 0.65,
			CanCollide = false,
			Material = Enum.Material.SmoothPlastic,
			Parent = territories,
		}):SetAttribute("TerritoryId", def.Id)

		part({
			Name = def.Id .. "_FlagPole",
			Size = Vector3.new(0.4, 14, 0.4),
			Position = def.Pos + Vector3.new(0, 7, 0),
			Color = Color3.fromRGB(55, 55, 55),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = territories,
		})
		local flag = part({
			Name = def.Id .. "_Flag",
			Size = Vector3.new(5.5, 3.2, 0.22),
			Position = def.Pos + Vector3.new(2.8, 12.2, 0),
			Color = def.Color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Transparency = 0.08,
			Parent = territories,
		})
		flag:SetAttribute("TerritoryId", def.Id)
		flag:SetAttribute("WE_Flag", true)
		part({
			Name = def.Id .. "_FlagStripe",
			Size = Vector3.new(5.5, 0.45, 0.28),
			Position = def.Pos + Vector3.new(2.8, 12.2, 0),
			Color = Color3.fromRGB(245, 245, 245),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 0.15,
			Parent = territories,
		})
		part({
			Name = def.Id .. "_Finial",
			Size = Vector3.new(0.7, 0.7, 0.7),
			Position = def.Pos + Vector3.new(0, 14.4, 0),
			Color = Color3.fromRGB(230, 190, 60),
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Ball,
			CanCollide = false,
			Parent = territories,
		})

		beacon(territories, def.Pos + Vector3.new(def.Radius * 0.6, 0, 0), def.Color, def.Id .. "_Beacon")

		-- Coastal oil platform deck + legs + harder NPC guards
		if def.OilRig then
			local deckY = def.Pos.Y
			local deck = part({
				Name = def.Id .. "_Deck",
				Size = Vector3.new(48, 2.5, 48),
				Position = Vector3.new(def.Pos.X, deckY - 1.2, def.Pos.Z),
				Color = Color3.fromRGB(90, 95, 100),
				Material = Enum.Material.Metal,
				Parent = territories,
			})
			deck:SetAttribute("TerritoryId", def.Id)
			-- Support legs
			local legOff = 18
			for _, ox in ipairs({ -legOff, legOff }) do
				for _, oz in ipairs({ -legOff, legOff }) do
					part({
						Name = def.Id .. "_Leg",
						Size = Vector3.new(3, deckY, 3),
						Position = Vector3.new(def.Pos.X + ox, deckY / 2, def.Pos.Z + oz),
						Color = Color3.fromRGB(60, 65, 70),
						Material = Enum.Material.Metal,
						Parent = territories,
					})
				end
			end
			-- Derrick + crane tip + neon rim (visual kits v2)
			part({
				Name = def.Id .. "_Derrick",
				Size = Vector3.new(4, 22, 4),
				Position = Vector3.new(def.Pos.X + 14, deckY + 11, def.Pos.Z + 14),
				Color = Color3.fromRGB(180, 140, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_CraneArm",
				Size = Vector3.new(14, 1.2, 1.2),
				Position = Vector3.new(def.Pos.X + 7, deckY + 20, def.Pos.Z + 14),
				Color = Color3.fromRGB(160, 120, 45),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_HelipadMark",
				Size = Vector3.new(10, 0.3, 10),
				Position = Vector3.new(def.Pos.X - 12, deckY + 0.2, def.Pos.Z - 12),
				Color = Color3.fromRGB(40, 45, 50),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			part({
				Name = def.Id .. "_NeonRim",
				Size = Vector3.new(46, 0.35, 0.5),
				Position = Vector3.new(def.Pos.X, deckY + 0.3, def.Pos.Z + 23),
				Color = Color3.fromRGB(255, 180, 60),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = territories,
			})
			plainBillboard(deck, def.Id .. "  ·  OIL PLATFORM  ·  Hard guards", Vector2.new(300, 44), 14, Color3.fromRGB(255, 210, 120))
			-- Stairs from deck down to ground (prevent 28-stud death plunge)
			local inland = Vector3.new(-def.Pos.X, 0, -def.Pos.Z)
			buildOilDeckRamp(territories, def.Id, def.Pos, inland)
		end

		-- Fortress walls / keep (named forts with higher stipend)
		if def.Fortress then
			local wallH = 8
			local wallT = 2.2
			local span = (def.Radius or 48) * 1.35
			local wallDefs = {
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, span) },
				{ Vector3.new(span * 2, wallH, wallT), Vector3.new(0, wallH / 2, -span) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(span, wallH / 2, 0) },
				{ Vector3.new(wallT, wallH, span * 2), Vector3.new(-span, wallH / 2, 0) },
			}
			for wi, wd in ipairs(wallDefs) do
				part({
					Name = def.Id .. "_Wall" .. wi,
					Size = wd[1],
					Position = def.Pos + wd[2],
					Color = Color3.fromRGB(95, 90, 75),
					Material = Enum.Material.Concrete,
					Parent = territories,
				})
			end
			local keep = part({
				Name = def.Id .. "_Keep",
				Size = Vector3.new(14, 16, 14),
				Position = def.Pos + Vector3.new(0, 8, 0),
				Color = def.Color,
				Material = Enum.Material.Brick,
				Parent = territories,
			})
			keep:SetAttribute("TerritoryId", def.Id)
			part({
				Name = def.Id .. "_KeepRoof",
				Size = Vector3.new(16, 1.5, 16),
				Position = def.Pos + Vector3.new(0, 16.5, 0),
				Color = Color3.fromRGB(70, 65, 55),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = territories,
			})
			-- Corner towers + gate neon
			for _, corner in ipairs({
				Vector3.new(span, 0, span),
				Vector3.new(span, 0, -span),
				Vector3.new(-span, 0, span),
				Vector3.new(-span, 0, -span),
			}) do
				part({
					Name = def.Id .. "_Tower",
					Size = Vector3.new(5, 12, 5),
					Position = def.Pos + corner + Vector3.new(0, 6, 0),
					Color = Color3.fromRGB(85, 80, 65),
					Material = Enum.Material.Brick,
					Parent = territories,
				})
			end
			part({
				Name = def.Id .. "_GateNeon",
				Size = Vector3.new(8, 0.4, 0.5),
				Position = def.Pos + Vector3.new(0, 1.5, span),
				Color = def.Color,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = territories,
			})
			plainBillboard(keep, def.Id .. "  ·  FORTRESS  ·  High stipend", Vector2.new(300, 44), 12, Color3.fromRGB(230, 210, 160))
		end
	end

	local function makeSpawnFolder(name, tag, count, center, color, ringRadius)
		local folder = ensureFolder(name, root)
		local ring = ringRadius or 200
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local pos = center + Vector3.new(math.cos(angle) * ring, 1, math.sin(angle) * ring)
			local padSize = if tag == TAG_VEHICLE then 20 else 14
			local p = part({
				Name = name .. i,
				Size = Vector3.new(padSize, 1.2, padSize),
				Position = pos,
				Color = color,
				Material = Enum.Material.Concrete,
				Parent = folder,
			})
			CollectionService:AddTag(p, tag)
			neonEdge(p, color:Lerp(Color3.new(1, 1, 1), 0.35), 0.35)
			if tag == TAG_VEHICLE then
				part({
					Name = "HMark",
					Size = Vector3.new(6, 0.2, 1),
					Position = pos + Vector3.new(0, 0.7, 0),
					Color = Color3.fromRGB(200, 220, 255),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
				part({
					Name = "HMark2",
					Size = Vector3.new(1, 0.2, 6),
					Position = pos + Vector3.new(0, 0.7, 0),
					Color = Color3.fromRGB(200, 220, 255),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
				beacon(folder, pos, Color3.fromRGB(90, 160, 220), name .. i .. "_Beacon")
				plainBillboard(p, "GARAGE PAD · E / G", Vector2.new(170, 32), 5, Color3.fromRGB(200, 220, 255))
			elseif tag == TAG_NPC then
				plainBillboard(p, "NPC SPAWN", Vector2.new(140, 28), 4, Color3.fromRGB(255, 180, 180))
			else
				plainBillboard(p, "EVENT ZONE", Vector2.new(140, 28), 4, Color3.fromRGB(255, 220, 160))
			end
		end
	end

	-- Rings scaled for ~4800 ground: garage pads spread; more pads for large roster testing
	makeSpawnFolder("VehicleSpawns", TAG_VEHICLE, 10, Vector3.new(0, 0, 0), COL_VEHICLE, 650)
	makeSpawnFolder("NPCSpawns", TAG_NPC, 10, Vector3.new(480, 0, 480), COL_NPC, 550)
	makeSpawnFolder("EventSpawns", TAG_EVENT, 6, Vector3.new(-480, 0, -480), COL_EVENT, 500)

	-- Coastal water band (south of SouthDocks on ~4800 map) + naval spawn pads
	do
		local waterFolder = ensureFolder("CoastalWater", root)
		local water = part({
			Name = "WaterPlane",
			Size = Vector3.new(GROUND_SIZE * 0.9, 1, 720),
			Position = Vector3.new(0, 0.2, 1850),
			Color = Color3.fromRGB(45, 120, 145),
			Material = Enum.Material.Glass,
			Transparency = 0.32,
			CanCollide = false,
			Parent = waterFolder,
		})
		water.Name = "WaterPlane"
		-- Shallow collide strip so boats have something under them
		part({
			Name = "HarborShelf",
			Size = Vector3.new(GROUND_SIZE * 0.75, 1, 120),
			Position = Vector3.new(0, 0.4, 1520),
			Color = Color3.fromRGB(55, 95, 105),
			Material = Enum.Material.Sandstone,
			Transparency = 0.12,
			CanCollide = true,
			Parent = waterFolder,
		})
		local navalFolder = ensureFolder("NavalSpawns", root)
		local navalPositions = {
			Vector3.new(-420, 1.5, 1580),
			Vector3.new(-240, 1.5, 1620),
			Vector3.new(-80, 1.5, 1640),
			Vector3.new(80, 1.5, 1640),
			Vector3.new(240, 1.5, 1620),
			Vector3.new(420, 1.5, 1580),
			Vector3.new(0, 1.5, 1720),
			Vector3.new(-560, 1.5, 1680),
			Vector3.new(560, 1.5, 1680),
		}
		for i, npos in ipairs(navalPositions) do
			local np = part({
				Name = "NavalPad_" .. i,
				Size = Vector3.new(18, 1.2, 18),
				Position = npos,
				Color = Color3.fromRGB(40, 70, 95),
				Material = Enum.Material.Concrete,
				CanCollide = true,
				Parent = navalFolder,
			})
			CollectionService:AddTag(np, TAG_NAVAL)
			CollectionService:AddTag(np, TAG_VEHICLE) -- garage prompt also works
			beacon(navalFolder, npos, Color3.fromRGB(70, 180, 220), "NavalBeacon" .. i)
			plainBillboard(np, "NAVAL PAD · E / G", Vector2.new(170, 32), 5, Color3.fromRGB(160, 220, 255))
		end
	end

	local npcFolder = ensureFolder("NPCPlaceholders", root)
	for i, spawnPart in ipairs(CollectionService:GetTagged(TAG_NPC)) do
		if i > 4 then
			break
		end
		makeSoldierKit(
			npcFolder,
			"HostileInfantry_" .. i,
			spawnPart.CFrame + Vector3.new(0, 3.2, 0),
			Color3.fromRGB(140, 55, 55),
			"HOSTILE",
			Color3.fromRGB(255, 120, 100),
			80,
			"Infantry",
			"studio_npc_" .. i
		)
	end


	-- Oil rig guards (harder NPC placeholders — visual kits v2 infantry)
	for _, def in ipairs(TERRITORIES) do
		if def.OilRig then
			for gi = 1, 4 do
				local angle = (gi / 4) * math.pi * 2
				local gpos = def.Pos + Vector3.new(math.cos(angle) * 16, 2.6, math.sin(angle) * 16)
				makeSoldierKit(
					npcFolder,
					def.Id .. "_Guard_" .. gi,
					CFrame.new(gpos),
					Color3.fromRGB(110, 70, 35),
					"OIL GUARD",
					Color3.fromRGB(255, 180, 80),
					200,
					"OilRigGuard",
					def.Id .. "_guard_" .. gi
				)
			end
		end
	end

	-- Fort guards
	for _, def in ipairs(TERRITORIES) do
		if def.Fortress then
			for gi = 1, 4 do
				local angle = (gi / 4) * math.pi * 2
				local gpos = def.Pos + Vector3.new(math.cos(angle) * 22, 2.6, math.sin(angle) * 22)
				makeSoldierKit(
					npcFolder,
					def.Id .. "_Guard_" .. gi,
					CFrame.new(gpos),
					Color3.fromRGB(100, 95, 70),
					"FORT GUARD",
					Color3.fromRGB(220, 200, 140),
					170,
					"FortGuard",
					def.Id .. "_guard_" .. gi
				)
			end
		end
	end

	-- Empire Bank (raid stub) — high-value vault + BankGuard NPCs
	local bankFolder = ensureFolder("EmpireBank", root)
	local bankPos = Vector3.new(220, 1, -220) -- matches BankRaidConfig.Position -- matches BankRaidConfig.Position
	local bankPad = part({
		Name = "BankPlaza",
		Size = Vector3.new(36, 1.2, 36),
		Position = bankPos,
		Color = Color3.fromRGB(45, 50, 70),
		Material = Enum.Material.Concrete,
		Parent = bankFolder,
	})
	neonEdge(bankPad, Color3.fromRGB(90, 120, 200), 0.4)
	part({
		Name = "BankBuilding",
		Size = Vector3.new(22, 14, 18),
		Position = bankPos + Vector3.new(0, 7.5, -4),
		Color = Color3.fromRGB(55, 62, 85),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	part({
		Name = "BankRoof",
		Size = Vector3.new(24, 1.2, 20),
		Position = bankPos + Vector3.new(0, 15, -4),
		Color = Color3.fromRGB(40, 45, 60),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	-- Columns + entrance neon (visual kits v2)
	for _, ox in ipairs({ -8, -2.5, 2.5, 8 }) do
		part({
			Name = "BankColumn",
			Size = Vector3.new(1.4, 12, 1.4),
			Position = bankPos + Vector3.new(ox, 6.5, 5.5),
			Color = Color3.fromRGB(70, 78, 100),
			Material = Enum.Material.Marble,
			Parent = bankFolder,
		})
	end
	part({
		Name = "BankDoor",
		Size = Vector3.new(4.5, 6, 0.4),
		Position = bankPos + Vector3.new(0, 3.5, 5.2),
		Color = Color3.fromRGB(30, 35, 50),
		Material = Enum.Material.Metal,
		Parent = bankFolder,
	})
	part({
		Name = "BankSign",
		Size = Vector3.new(10, 1.2, 0.4),
		Position = bankPos + Vector3.new(0, 12.5, 5.2),
		Color = Color3.fromRGB(230, 190, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = bankFolder,
	})
	local vault = part({
		Name = "VaultPad",
		Size = Vector3.new(10, 1.4, 10),
		Position = bankPos + Vector3.new(0, 1.2, 8),
		Color = Color3.fromRGB(200, 170, 60),
		Material = Enum.Material.Neon,
		Parent = bankFolder,
	})
	part({
		Name = "VaultRing",
		Size = Vector3.new(12, 0.35, 12),
		Position = bankPos + Vector3.new(0, 1.9, 8),
		Color = Color3.fromRGB(90, 140, 220),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.35,
		Parent = bankFolder,
	})
	vault:SetAttribute("BankId", "EmpireBank")
	CollectionService:AddTag(vault, "WE_BankVault")
	plainBillboard(vault, "EMPIRE BANK · Stand to RAID cash", Vector2.new(280, 40), 8, Color3.fromRGB(255, 220, 120))
	beacon(bankFolder, bankPos + Vector3.new(14, 0, 14), Color3.fromRGB(90, 130, 220), "BankBeacon")
	-- Bank guards spawned live via CombatService.SpawnNPC("BankGuard", cf) in BankRaidService
	-- (static makeSoldierKit props removed — they were Anchored stick figures with double nametags)

	local tutorialFolder = ensureFolder("TutorialMarkers", root)
	local function tutorialMarker(name, pos, color, stepId)
		local p = part({
			Name = name,
			Size = Vector3.new(7, 1.2, 7),
			Position = pos,
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			CanCollide = false,
			Parent = tutorialFolder,
		})
		p:SetAttribute("TutorialStepId", stepId or name)
		CollectionService:AddTag(p, TAG_TUTORIAL)
		plainBillboard(p, "TUT · " .. name:gsub("Tutorial_", ""), Vector2.new(200, 34), 6, Color3.fromRGB(255, 245, 180))
		beacon(tutorialFolder, pos, color, name .. "_Beacon")
		part({
			Name = name .. "_Ring",
			Size = Vector3.new(10, 0.25, 10),
			Position = pos + Vector3.new(0, -0.4, 0),
			Color = color,
			Transparency = 0.5,
			CanCollide = false,
			Material = Enum.Material.Neon,
			Parent = tutorialFolder,
		})
		return p
	end

	local plot1 = PLOT_POSITIONS[1]
	-- Offsets track Plot1 spawn / structure grid (STRUCT_ORIGIN + gaps)
	tutorialMarker("Tutorial_ClaimBase", plot1 + Vector3.new(0, 2, 52), Color3.fromRGB(230, 200, 80), "ClaimBase")
	tutorialMarker("Tutorial_CommandCenter", plot1 + STRUCT_ORIGIN + Vector3.new(0, 1.4, 0), Color3.fromRGB(80, 200, 120), "CommandCenter")
	tutorialMarker("Tutorial_Income", plot1 + Vector3.new(0, 3, 0), Color3.fromRGB(80, 200, 160), "Income")
	tutorialMarker("Tutorial_Barracks", plot1 + STRUCT_ORIGIN + Vector3.new(STRUCT_GAP, 1.4, 0), Color3.fromRGB(100, 180, 220), "Barracks")
	local jeepPos = Vector3.new(200, 2, 0)
	local vSpawns = CollectionService:GetTagged(TAG_VEHICLE)
	if #vSpawns > 0 and vSpawns[1]:IsA("BasePart") then
		jeepPos = vSpawns[1].Position + Vector3.new(0, 2, 0)
	end
	tutorialMarker("Tutorial_Jeep", jeepPos, Color3.fromRGB(120, 140, 200), "Jeep")
	tutorialMarker("Tutorial_Outpost", Vector3.new(0, 3, 0), Color3.fromRGB(200, 120, 80), "Outpost")

	-- Military world dressing (visual only). Does not tag WE_UpgradeSlot / buy pads.
	-- PERF: skip MapDressing entirely in Studio unless ForceDress (attribute or DevConfig).
	-- Stagger after first frame so Play Solo is usable in seconds on laptop CPUs.
	task.defer(function()
		task.wait() -- yield past first frame
		local forceAttr = root:GetAttribute("ForceDress") == true
			or (Workspace:GetAttribute("ForceDress") == true)
		local forceDress = forceAttr or (DevConfig.StudioForceDress == true)
		local inStudio = RunService:IsStudio()
		local skipDress = inStudio and (DevConfig.StudioSkipWorldDressing ~= false) and not forceDress
		local quality = tostring(DevConfig.WorldDressQuality or "Low")

		print("[WAR EMPIRE] PERF note: deco kits use CastShadow=false. Studio Rendering → disable shadows / lower quality if still slow.")
		if skipDress then
			print("[WAR EMPIRE] PERF: MapDressing SKIPPED in Studio (StudioSkipWorldDressing). Set Workspace.WarEmpireSetup.ForceDress=true or DevConfig.StudioForceDress=true then resetmap to load dressing.")
		else
			task.wait(0.05)
			local okDress, errDress = pcall(function()
				MapDressing.Dress(root, { Quality = quality })
			end)
			if not okDress then
				warn("[WAR EMPIRE] MapDressing failed:", errDress)
			end
		end

		task.wait(0.1)
		-- Sparse flora by default (Studio + Low). Full flora only when WorldDressQuality=Full outside Studio,
		-- or StudioSparseFlora=false for intentional dense Studio art checks.
		local wantFullFlora = ((not inStudio) and string.lower(tostring(DevConfig.WorldDressQuality or "Low")) == "full")
			or (inStudio and DevConfig.StudioSparseFlora == false)
		local sparseFlora = not wantFullFlora
		local okFlora, errFlora = pcall(function()
			DesertFlora.Dress(root, { Sparse = sparseFlora })
		end)
		if not okFlora then
			warn("[WAR EMPIRE] DesertFlora failed:", errFlora)
		end
	end)

	-- Guarantee at least one Neutral Duration=0 spawn near origin
	local hasNeutralSpawn = false
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("SpawnLocation") and inst.Neutral and inst.Duration == 0 then
			hasNeutralSpawn = true
			break
		end
	end
	if not hasNeutralSpawn then
		local fallbackSpawn = Instance.new("SpawnLocation")
		fallbackSpawn.Name = "NeutralSpawn"
		fallbackSpawn.Size = Vector3.new(12, 1, 12)
		fallbackSpawn.Position = Vector3.new(0, 5, 0)
		fallbackSpawn.Anchored = true
		fallbackSpawn.CanCollide = true
		fallbackSpawn.Neutral = true
		fallbackSpawn.Duration = 0
		fallbackSpawn.BrickColor = BrickColor.new("Bright green")
		fallbackSpawn.Material = Enum.Material.Neon
		fallbackSpawn.Parent = root
		print("[WAR EMPIRE] MapSetup: added fallback NeutralSpawn at (0,5,0)")
	end

		buildPadSupportShelves(root)
	print("[WAR EMPIRE] MapSetup complete: desert ground=" .. tostring(GROUND_SIZE) .. "x" .. tostring(GROUND_THICKNESS) .. " topY=" .. tostring(GROUND_TOP_Y) .. " mesas=" .. tostring(DevConfig.MountainRingSegments or 14) .. " (dressing deferred/Studio-skip)")
	print("[WAR EMPIRE] MapSetup confirmation: Gravity=" .. tostring(Workspace.Gravity) .. " WarEmpireSetup children=" .. tostring(#root:GetChildren()))
	print("[WAR EMPIRE] Walk onto upgrade pads to BUY (auto). E opens Base/Garage menus. Delete WarEmpireSetup + Play / admin resetmap to regenerate.")
end

return MapSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Default player profile + migrations.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"))
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local Types = require(Shared:WaitForChild("Types"))

type PlayerProfile = Types.PlayerProfile

local ProfileSchema = {}

local function emptyUpgrades(): { [string]: number }
	local upgrades: { [string]: number } = {}
	for id in pairs(BaseConfig.Structures) do
		upgrades[id] = 0
	end
	return upgrades
end

local function emptyDailyMissions(): Types.DailyMissionProgress
	return {
		DayKey = 0,
		Progress = {},
		Claimed = {},
		ActiveTimed = {},
	}
end

function ProfileSchema.CreateDefault(): PlayerProfile
	local now = os.time()
	return {
		DataVersion = Constants.CURRENT_DATA_VERSION,
		Cash = EconomyConfig.StartingCash,
		Gold = EconomyConfig.StartingGold,
		Level = 1,
		XP = 0,
		Prestige = 0,
		RebirthUnlocks = {},
		Soldiers = SoldierConfig.StartingSoldiers,
		NationColorId = nil,
		RedeemedCodes = {},
		LastSpinnerClaimUnix = 0,
		Vehicles = {
			[VehicleConfig.StarterVehicle] = true,
		},
		Weapons = {
			[WeaponConfig.DefaultWeapon] = true,
		},
		EquippedWeapon = WeaponConfig.DefaultWeapon,
		Territories = {},
		BaseUpgrades = emptyUpgrades(),
		BasePlotId = nil,
		TutorialStep = 0,
		TutorialComplete = false,
		DailyLogin = {
			LastClaimDay = 0,
			Streak = 0,
			LastClaimUnix = 0,
		},
		DailyMissions = emptyDailyMissions(),
		Settings = {
			MusicVolume = 0.7,
			SFXVolume = 0.8,
			ShowDamageNumbers = true,
			AutoSprint = true,
		},
		Stats = {
			TotalCashEarned = 0,
			TotalGoldEarned = 0,
			UpgradesPurchased = 0,
			VehiclesSpawned = 0,
			MissionsCompleted = 0,
			TerritoriesCaptured = 0,
			Kills = 0,
			Deaths = 0,
			PlayTimeSeconds = 0,
		},
		Achievements = {},
		BattlePass = {
			SeasonId = SeasonConfig.CurrentSeasonId,
			XP = 0,
			Level = 0,
			Premium = false,
			ClaimedFree = {},
			ClaimedPremium = {},
		},
		ClanId = nil,
		FirstJoinUnix = now,
		LastJoinUnix = now,
		ProcessedReceipts = {},
	}
end

--[[
	Migrate older profiles to CURRENT_DATA_VERSION.
	Add new migration steps as DataVersion increments.
]]
function ProfileSchema.Migrate(data: any): PlayerProfile
	if typeof(data) ~= "table" then
		return ProfileSchema.CreateDefault()
	end

	local profile = data :: PlayerProfile
	local version = tonumber(profile.DataVersion) or 0

	-- v0 / missing → fill defaults then set version
	if version < 1 then
		local defaults = ProfileSchema.CreateDefault()
		for key, value in pairs(defaults) do
			if profile[key] == nil then
				(profile :: any)[key] = value
			end
		end
		-- Ensure nested tables
		if typeof(profile.BaseUpgrades) ~= "table" then
			profile.BaseUpgrades = emptyUpgrades()
		else
			for id in pairs(BaseConfig.Structures) do
				if profile.BaseUpgrades[id] == nil then
					profile.BaseUpgrades[id] = 0
				end
			end
		end
		if typeof(profile.Vehicles) ~= "table" then
			profile.Vehicles = { [VehicleConfig.StarterVehicle] = true }
		elseif not profile.Vehicles[VehicleConfig.StarterVehicle] then
			profile.Vehicles[VehicleConfig.StarterVehicle] = true
		end
		if typeof(profile.Weapons) ~= "table" then
			profile.Weapons = { [WeaponConfig.DefaultWeapon] = true }
		elseif not profile.Weapons[WeaponConfig.DefaultWeapon] then
			profile.Weapons[WeaponConfig.DefaultWeapon] = true
		end
		profile.DataVersion = 1
		version = 1
	end

	-- v1 → v2: DailyMissions progress table
	if version < 2 then
		if typeof((profile :: any).DailyMissions) ~= "table" then
			(profile :: any).DailyMissions = emptyDailyMissions()
		else
			local dm = (profile :: any).DailyMissions
			if typeof(dm.Progress) ~= "table" then
				dm.Progress = {}
			end
			if typeof(dm.Claimed) ~= "table" then
				dm.Claimed = {}
			end
			if typeof(dm.ActiveTimed) ~= "table" then
				dm.ActiveTimed = {}
			end
			if typeof(dm.DayKey) ~= "number" then
				dm.DayKey = 0
			end
		end
		if typeof(profile.Achievements) ~= "table" then
			profile.Achievements = {}
		end
		if typeof(profile.Territories) ~= "table" then
			profile.Territories = {}
		end
		profile.DataVersion = 2
		version = 2
	end


	-- v2 → v3: ensure clan / season / battle pass / soldier / war-adjacent fields for older saves
	if version < 3 then
		if typeof(profile.Prestige) ~= "number" then
			profile.Prestige = 0
		end
		if typeof(profile.Soldiers) ~= "number" then
			profile.Soldiers = SoldierConfig.StartingSoldiers or 0
		end
		if profile.ClanId ~= nil and typeof(profile.ClanId) ~= "string" then
			profile.ClanId = nil
		end
		if typeof(profile.BattlePass) ~= "table" then
			profile.BattlePass = {
				SeasonId = SeasonConfig.CurrentSeasonId,
				XP = 0,
				Level = 0,
				Premium = false,
				ClaimedFree = {},
				ClaimedPremium = {},
			}
		else
			local bp = profile.BattlePass
			if typeof(bp.SeasonId) ~= "string" then
				bp.SeasonId = SeasonConfig.CurrentSeasonId
			end
			if typeof(bp.XP) ~= "number" then
				bp.XP = 0
			end
			if typeof(bp.Level) ~= "number" then
				bp.Level = 0
			end
			if typeof(bp.Premium) ~= "boolean" then
				bp.Premium = false
			end
			if typeof(bp.ClaimedFree) ~= "table" then
				bp.ClaimedFree = {}
			end
			if typeof(bp.ClaimedPremium) ~= "table" then
				bp.ClaimedPremium = {}
			end
		end
		if typeof(profile.Stats) == "table" then
			if typeof(profile.Stats.TerritoriesCaptured) ~= "number" then
				profile.Stats.TerritoriesCaptured = 0
			end
			if typeof(profile.Stats.Kills) ~= "number" then
				profile.Stats.Kills = 0
			end
			if typeof(profile.Stats.Deaths) ~= "number" then
				profile.Stats.Deaths = 0
			end
		end
		if typeof(profile.Territories) ~= "table" then
			profile.Territories = {}
		end
		if typeof(profile.Achievements) ~= "table" then
			profile.Achievements = {}
		end
		profile.DataVersion = 3
		version = 3
	end

	-- v3 → v4: nation color + redeemed codes (MT-inspired systems)
	if version < 4 then
		if profile.NationColorId ~= nil and typeof(profile.NationColorId) ~= "string" then
			profile.NationColorId = nil
		end
		if typeof(profile.RedeemedCodes) ~= "table" then
			profile.RedeemedCodes = {}
		end
		profile.DataVersion = 4
		version = 4
	end

	-- v4 → v5: free supply spinner cooldown stamp
	if version < 5 then
		if typeof((profile :: any).LastSpinnerClaimUnix) ~= "number" then
			(profile :: any).LastSpinnerClaimUnix = 0
		end
		profile.DataVersion = 5
		version = 5
	end


	-- v5 → v6: rebirth unlock flags (prestige track)
	if version < 6 then
		if typeof((profile :: any).RebirthUnlocks) ~= "table" then
			(profile :: any).RebirthUnlocks = {}
		end
		profile.DataVersion = 6
		version = 6
	end

	if typeof((profile :: any).ProcessedReceipts) ~= "table" then
		(profile :: any).ProcessedReceipts = {}
	end

	profile.DataVersion = Constants.CURRENT_DATA_VERSION
	return profile
end

function ProfileSchema.DeepCopy(profile: PlayerProfile): PlayerProfile
	-- Simple recursive copy sufficient for our schema
	local function copy(v: any): any
		if typeof(v) ~= "table" then
			return v
		end
		local t = {}
		for k, val in pairs(v) do
			t[k] = copy(val)
		end
		return t
	end
	return copy(profile) :: PlayerProfile
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">RemoteGuard</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Shared client→server remote argument guards.
	Use with RateLimitService + DataService.GetProfile — never trust client types/ranges.
]]

local RemoteGuard = {}

local DEFAULT_ID_MAX = 64
local DEFAULT_KEY_MAX = 48
local DEFAULT_CMD_MAX = 32

function RemoteGuard.IsFiniteNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

--[[ Non-empty string within max length (ids, keys, mission ids). ]]
function RemoteGuard.IsIdString(value: any, maxLen: number?): boolean
	if typeof(value) ~= "string" then
		return false
	end
	local s = value :: string
	if s == "" then
		return false
	end
	local max = maxLen or DEFAULT_ID_MAX
	return #s <= max
end

function RemoteGuard.IsKeyString(value: any, maxLen: number?): boolean
	return RemoteGuard.IsIdString(value, maxLen or DEFAULT_KEY_MAX)
end

function RemoteGuard.IsCommandString(value: any, maxLen: number?): boolean
	return RemoteGuard.IsIdString(value, maxLen or DEFAULT_CMD_MAX)
end

--[[ Floor + clamp to [minN, maxN]; nil if not a finite number. ]]
function RemoteGuard.ClampInt(value: any, minN: number, maxN: number): number?
	if not RemoteGuard.IsFiniteNumber(value) then
		return nil
	end
	local n = math.floor(value :: number)
	if n < minN or n > maxN then
		return nil
	end
	return n
end

function RemoteGuard.ClampPositiveInt(value: any, maxN: number): number?
	return RemoteGuard.ClampInt(value, 1, maxN)
end

--[[ Profile must be loaded before mutating economy / progression. ]]
function RemoteGuard.RequireProfile(dataService: any, player: Player): any?
	if not dataService or not dataService.GetProfile then
		return nil
	end
	return dataService.GetProfile(player)
end

return RemoteGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">RemoteSetup</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Creates remotes under ReplicatedStorage.Remotes.
	Request/action pattern ONLY — no GiveCash / GiveXP / GiveWeapon remotes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local RemoteSetup = {}

local EVENTS = {
	-- Server pushes
	Constants.RemoteNames.PlayerStateUpdate,
	Constants.RemoteNames.BaseStateUpdate,
	Constants.RemoteNames.Notification,
	Constants.RemoteNames.EconomyUpdate,
	Constants.RemoteNames.XPUpdate,
	Constants.RemoteNames.CombatStateUpdate,
	Constants.RemoteNames.CombatHitFeedback,
	Constants.RemoteNames.VehicleStateUpdate,
	Constants.RemoteNames.TerritoryStateUpdate,
	Constants.RemoteNames.MissionStateUpdate,
	-- Client requests
	Constants.RemoteNames.RequestPurchaseUpgrade,
	Constants.RemoteNames.RequestClaimDailyReward,
	Constants.RemoteNames.RequestSpawnVehicle,
	Constants.RemoteNames.RequestPurchaseVehicle,
	Constants.RemoteNames.RequestDespawnVehicle,
	Constants.RemoteNames.RequestEquipWeapon,
	Constants.RemoteNames.RequestPurchaseWeapon,
	Constants.RemoteNames.RequestFire,
	Constants.RemoteNames.RequestReload,
	Constants.RemoteNames.RequestStartMission,
	Constants.RemoteNames.RequestClaimMission,
	Constants.RemoteNames.RequestCaptureTerritory,
	Constants.RemoteNames.RequestAdminCommand,
	Constants.RemoteNames.RequestPurchaseDevProduct,
	Constants.RemoteNames.RequestPurchaseGamePass,
	Constants.RemoteNames.RequestSkipTutorial,
	Constants.RemoteNames.TutorialStateUpdate,
	Constants.RemoteNames.RequestPrestige,
	Constants.RemoteNames.PrestigeStateUpdate,
	Constants.RemoteNames.RequestCreateClan,
	Constants.RemoteNames.RequestJoinClan,
	Constants.RemoteNames.RequestLeaveClan,
	Constants.RemoteNames.ClanStateUpdate,
	Constants.RemoteNames.RequestClaimBattlePassReward,
	Constants.RemoteNames.BattlePassStateUpdate,
	Constants.RemoteNames.RequestRecruitSoldiers,
	Constants.RemoteNames.RequestDismissSoldiers,
	Constants.RemoteNames.SoldierStateUpdate,
	Constants.RemoteNames.SeasonStateUpdate,
	Constants.RemoteNames.RequestDeclareClanWar,
	Constants.RemoteNames.ClanWarStateUpdate,
	Constants.RemoteNames.RequestRedeemCode,
	Constants.RemoteNames.CodeStateUpdate,
	Constants.RemoteNames.NationColorUpdate,
	Constants.RemoteNames.RequestClaimSpinner,
	Constants.RemoteNames.SpinnerStateUpdate,
	Constants.RemoteNames.BankRaidStateUpdate,
}

local FUNCTIONS = {
	Constants.RemoteNames.GetPlayerState,
}

function RemoteSetup.Init(): Folder
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Constants.RemotesFolderName
		folder.Parent = ReplicatedStorage
	end

	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local ev = Instance.new("RemoteEvent")
			ev.Name = name
			ev.Parent = folder
		end
	end

	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local fn = Instance.new("RemoteFunction")
			fn.Name = name
			fn.Parent = folder
		end
	end

	-- Guard: never create Give* remotes
	for _, child in ipairs(folder:GetChildren()) do
		if string.sub(child.Name, 1, 4) == "Give" then
			warn("[RemoteSetup] Removing forbidden remote:", child.Name)
			child:Destroy()
		end
	end

	return folder :: Folder
end

function RemoteSetup.Get(name: string): Instance
	local folder = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName)
	return folder:WaitForChild(name)
end

return RemoteSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Simple DataStore session lock to reduce multi-server write races.
	JobId + timestamp; steal if stale.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Constants"))

local SessionLock = {}

local STORE_NAME = Constants.SessionStoreName
local LOCK_TTL = 60 * 30 -- 30 minutes stale threshold
local store: DataStore? = nil

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		return store
	end
	warn("[SessionLock] DataStore unavailable:", result)
	return nil
end

export type LockInfo = {
	JobId: string,
	UserId: number,
	Timestamp: number,
}

function SessionLock.TryAcquire(userId: number): (boolean, string?)
	local ds = getStore()
	if not ds then
		-- Studio without API services: allow
		return true, nil
	end

	local key = "lock_" .. tostring(userId)
	local jobId = if RunService:IsStudio() then "STUDIO" else game.JobId
	local now = os.time()

	local ok, err = pcall(function()
		ds:UpdateAsync(key, function(old)
			local info = old :: LockInfo?
			if info and typeof(info) == "table" then
				local age = now - (tonumber(info.Timestamp) or 0)
				if info.JobId ~= jobId and age < LOCK_TTL then
					return nil -- abort acquire
				end
			end
			return {
				JobId = jobId,
				UserId = userId,
				Timestamp = now,
			} :: LockInfo
		end)
	end)

	if not ok then
		return false, tostring(err)
	end

	-- UpdateAsync returning nil means conflict — re-read
	local readOk, current = pcall(function()
		return ds:GetAsync(key)
	end)
	if readOk and typeof(current) == "table" and (current :: LockInfo).JobId ~= jobId then
		return false, "Session locked by another server"
	end

	return true, nil
end

function SessionLock.Refresh(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = if RunService:IsStudio() then "STUDIO" else game.JobId
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and (old :: LockInfo).JobId == jobId then
				return {
					JobId = jobId,
					UserId = userId,
					Timestamp = os.time(),
				}
			end
			return old
		end)
	end)
end

function SessionLock.Release(userId: number)
	local ds = getStore()
	if not ds then
		return
	end
	local key = "lock_" .. tostring(userId)
	local jobId = if RunService:IsStudio() then "STUDIO" else game.JobId
	pcall(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and (old :: LockInfo).JobId == jobId then
				return nil
			end
			return old
		end)
	end)
end

return SessionLock
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local AdminConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.AdminConfig)
local Constants = require(ReplicatedStorage:WaitForChild("Shared").Constants)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local AdminService = {}

local EconomyService: any = nil
local XPService: any = nil
local DataService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil

function AdminService.IsAdmin(player: Player): boolean
	for _, id in ipairs(AdminConfig.UserIds) do
		if id == player.UserId then
			return true
		end
	end
	return false
end

function AdminService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	DataService = deps.DataService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService

	local RemoteSetup = deps.RemoteSetup
	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestAdminCommand) :: RemoteEvent

	remote.OnServerEvent:Connect(function(player: Player, command: any, arg1: any, arg2: any)
		if not RateLimitService.Allow(player, "admin", 2, 4) then
			return
		end
		if not AdminService.IsAdmin(player) then
			warn("[AdminService] Unauthorized admin attempt:", player.UserId)
			return
		end
		if not RemoteGuard.IsCommandString(command) then
			return
		end
		-- Admin still requires a loaded profile for mutating commands
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end

		local cmd = string.lower(command :: string)
		local ADMIN_GRANT_MAX = 1_000_000_000
		AnalyticsService.Log("ADMIN_COMMAND", player.UserId, { command = cmd })

		if cmd == "givecash" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				EconomyService.AddCash(player, amt, "admin")
			end
		elseif cmd == "givegold" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				EconomyService.AddGold(player, amt, "admin")
			end
		elseif cmd == "givexp" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt then
				XPService.AddXP(player, amt, "admin")
			end
		elseif cmd == "setlevel" then
			local lvl = RemoteGuard.ClampPositiveInt(arg1, 1000)
			if lvl then
				XPService.SetLevel(player, lvl)
			end
		elseif cmd == "unlockall" then
			local profile = DataService.GetProfile(player)
			if profile then
				local VehicleConfig = require(ReplicatedStorage.Shared.Configs.VehicleConfig)
				local WeaponConfig = require(ReplicatedStorage.Shared.Configs.WeaponConfig)
				for id in pairs(VehicleConfig.Vehicles) do
					profile.Vehicles[id] = true
				end
				for id in pairs(WeaponConfig.Weapons) do
					profile.Weapons[id] = true
				end
				DataService.MarkDirty(player)
			end
		elseif cmd == "resetbase" then
			local profile = DataService.GetProfile(player)
			if profile then
				for id in pairs(profile.BaseUpgrades) do
					profile.BaseUpgrades[id] = 0
				end
				DataService.MarkDirty(player)
				if deps.BaseService then
					deps.BaseService.PushState(player)
					if deps.BaseService.RefreshAllVisuals then
						deps.BaseService.RefreshAllVisuals(player)
					end
				end
			end
		elseif cmd == "resettutorial" then
			if deps.TutorialService and deps.TutorialService.Reset then
				deps.TutorialService.Reset(player)
			end
		elseif cmd == "prestige" or cmd == "forceprestige" then
			if deps.PrestigeService and deps.PrestigeService.DoPrestige then
				-- force: temporarily ignore level gate via SetLevel first if needed
				if cmd == "forceprestige" and deps.XPService then
					local PrestigeConfig = require(ReplicatedStorage.Shared.Configs.PrestigeConfig)
					deps.XPService.SetLevel(player, PrestigeConfig.MinLevelToPrestige)
				end
				local ok, err = deps.PrestigeService.DoPrestige(player)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, if ok then "Prestige OK" else ("Prestige failed: " .. tostring(err)), if ok then "Success" else "Warn")
				end
			end
		elseif cmd == "createclan" and RemoteGuard.IsIdString(arg1, 32) then
			if deps.ClanService and deps.ClanService.CreateClan then
				local tagArg = if RemoteGuard.IsIdString(arg2, 8) then arg2 :: string else nil
				local ok, err = deps.ClanService.CreateClan(player, arg1 :: string, tagArg)
				if not ok and deps.NotificationService then
					deps.NotificationService.Notify(player, "Clan create failed: " .. tostring(err), "Warn")
				end
			end
		elseif cmd == "joinclan" and RemoteGuard.IsIdString(arg1) then
			if deps.ClanService then
				deps.ClanService.JoinClan(player, arg1 :: string)
			end
		elseif cmd == "leaveclan" then
			if deps.ClanService then
				deps.ClanService.LeaveClan(player)
			end
		elseif cmd == "bpxp" then
			local amt = RemoteGuard.ClampPositiveInt(arg1, ADMIN_GRANT_MAX)
			if amt and deps.BattlePassService and deps.BattlePassService.AddXP then
				deps.BattlePassService.AddXP(player, amt, "admin")
			end
		elseif cmd == "grantpremium" then
			if deps.BattlePassService and deps.BattlePassService.SetPremium then
				deps.BattlePassService.SetPremium(player, true)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Battle Pass Premium granted", "Success")
				end
			end
		elseif cmd == "grantpass" and RemoteGuard.IsKeyString(arg1) then
			-- Studio mock GamePass ownership (Ids may still be 0)
			if deps.MonetizationService and deps.MonetizationService.SetMockGamePassOwned then
				deps.MonetizationService.SetMockGamePassOwned(player, arg1 :: string, true)
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Mock GamePass owned: " .. arg1, "Success")
				end
			end
		elseif cmd == "endseason" then
			if deps.SeasonService and deps.SeasonService.EndSeason then
				deps.SeasonService.EndSeason("admin:" .. tostring(player.UserId))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Season ended (admin)", "Info")
				end
			end
		elseif cmd == "resumeseason" then
			if deps.SeasonService and deps.SeasonService.ClearEndOverride then
				deps.SeasonService.ClearEndOverride("admin:" .. tostring(player.UserId))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "Season resumed (admin)", "Success")
				end
			end
		elseif cmd == "resetmap" then
			-- Studio: destroy WarEmpireSetup and rebuild via MapSetup
			if not RunService:IsStudio() then
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "resetmap is Studio-only", "Warn")
				end
				return
			end
			local existing = Workspace:FindFirstChild("WarEmpireSetup")
			if existing then
				existing:Destroy()
			end
			local voidFb = Workspace:FindFirstChild("WE_VoidFallback")
			if voidFb then
				voidFb:Destroy()
			end
			local MapSetup = require(script.Parent.Parent.Modules.MapSetup)
			local ok, err = pcall(function()
				MapSetup.Run()
			end)
			if not ok then
				warn("[WAR EMPIRE] resetmap MapSetup failed: " .. tostring(err))
				if deps.NotificationService then
					deps.NotificationService.Notify(player, "MapSetup failed — check Output", "Error")
				end
				return
			end
			if deps.NotificationService then
				deps.NotificationService.Notify(player, "Map regenerated (MapSetup)", "Success")
			end
		end
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Analytics abstraction. MVP logs to output; plug in real sink later.
	Does not fabricate metrics — only logs events you fire.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AnalyticsConfig = require(ReplicatedStorage:WaitForChild("Shared").Configs.AnalyticsConfig)

local AnalyticsService = {}

local sink: ((eventName: string, userId: number?, props: { [string]: any }?) -> ())? = nil

function AnalyticsService.Init()
	-- default sink
end

function AnalyticsService.SetSink(fn: (eventName: string, userId: number?, props: { [string]: any }?) -> ())
	sink = fn
end

function AnalyticsService.Log(eventName: string, userId: number?, props: { [string]: any }?)
	if not AnalyticsConfig.Enabled then
		return
	end
	if sink then
		sink(eventName, userId, props)
		return
	end
	if AnalyticsConfig.LogToOutput then
		local propStr = ""
		if props then
			local parts = {}
			for k, v in pairs(props) do
				table.insert(parts, string.format("%s=%s", tostring(k), tostring(v)))
			end
			propStr = table.concat(parts, ", ")
		end
		print(string.format("[Analytics] %s user=%s %s", eventName, tostring(userId), propStr))
	end
end

return AnalyticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Basic sanity helpers used by other services ]]

local AntiExploitService = {}

local RateLimitService: any = nil
local strikeCount: { [number]: number } = {}

function AntiExploitService.Init(deps: { [string]: any })
	RateLimitService = deps.RateLimitService
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		strikeCount[player.UserId] = nil
	end)
end

function AntiExploitService.IsFiniteNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function AntiExploitService.ClampMagnitude(vec: Vector3, maxMag: number): Vector3
	if vec.Magnitude > maxMag then
		return vec.Unit * maxMag
	end
	return vec
end

function AntiExploitService.Strike(player: Player, reason: string)
	local id = player.UserId
	strikeCount[id] = (strikeCount[id] or 0) + 1
	warn("[AntiExploit]", player.Name, reason, "strikes=", strikeCount[id])
	if strikeCount[id] >= 10 then
		player:Kick("Unusual activity detected.")
	end
end

function AntiExploitService.CheckRemote(player: Player, key: string): boolean
	if not RateLimitService.Allow(player, "ae_" .. key, 6, 10) then
		AntiExploitService.Strike(player, "rate_" .. key)
		return false
	end
	return true
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">BankRaidService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Empire Bank raid — stand on vault to loot Cash; per-player cooldown.
	Bank guards are living CombatService NPCs (MoveTo + shoot), not static MapSetup props.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BankRaidConfig = require(Shared.Configs.BankRaidConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local BankRaidService = {}

local EconomyService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil
local RemoteSetup: any = nil
local CombatService: any = nil

local vaultPart: BasePart? = nil
local holdProgress: { [number]: number } = {}
local cooldownUntil: { [number]: number } = {}
local guardsSpawned = false

local function findVault(): BasePart?
	if vaultPart and vaultPart.Parent then
		return vaultPart
	end
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BankVault)) do
		if inst:IsA("BasePart") then
			vaultPart = inst
			return inst
		end
	end
	return nil
end

local function spawnBankGuards()
	if guardsSpawned then
		return
	end
	if not CombatService or not CombatService.SpawnNPC then
		warn("[WAR EMPIRE] BankRaidService: CombatService.SpawnNPC missing")
		return
	end
	guardsSpawned = true

	local vault = findVault()
	local origin = if vault then vault.Position else (BankRaidConfig.Position or Vector3.new(220, 1, -220))
	local count = BankRaidConfig.GuardCount or 4
	local ring = BankRaidConfig.GuardRingRadius or 16
	local typeId = BankRaidConfig.GuardNPCType or "BankGuard"
	local spawned = 0
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + 0.35
		local pos = origin + Vector3.new(math.cos(angle) * ring, 3.2, math.sin(angle) * ring)
		local cf = CFrame.new(pos) * CFrame.Angles(0, -angle + math.pi, 0)
		local rec = CombatService.SpawnNPC(typeId, cf)
		if rec then
			spawned += 1
		end
	end
	print(string.format("[WAR EMPIRE] BankRaidService: spawned %d %s combat NPCs at bank", spawned, typeId))
	if spawned == 0 then
		warn("[WAR EMPIRE] BankRaidService: ZERO BankGuards — will retry once in 3s")
		guardsSpawned = false
		task.delay(3, function()
			if not guardsSpawned then
				spawnBankGuards()
			end
		end)
	end
end

local function pushState(player: Player)
	if not RemoteSetup then
		return
	end
	local now = os.time()
	local untilT = cooldownUntil[player.UserId] or 0
	local remaining = math.max(0, untilT - now)
	local remote = RemoteSetup.Get(Constants.RemoteNames.BankRaidStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		BankId = BankRaidConfig.BankId,
		DisplayName = BankRaidConfig.DisplayName,
		CooldownRemaining = remaining,
		RaidHoldSeconds = BankRaidConfig.RaidHoldSeconds,
		CashHintMin = BankRaidConfig.CashMin,
		CashHintMax = BankRaidConfig.CashMax,
	})
end

local function completeRaid(player: Player)
	local cashMin = BankRaidConfig.CashMin or 15000
	local cashMax = BankRaidConfig.CashMax or 35000
	local cash = math.random(cashMin, cashMax)
	EconomyService.AddCash(player, cash, "bank_raid")
	local cd = BankRaidConfig.CooldownSeconds or 300
	cooldownUntil[player.UserId] = os.time() + cd
	holdProgress[player.UserId] = nil
	if BankRaidConfig.NotifyOnRaid and NotificationService then
		NotificationService.Notify(
			player,
			string.format("Bank raid +$%d · cooldown %dm", cash, math.ceil(cd / 60)),
			"Reward"
		)
	end
	if AnalyticsService then
		local ev = (AnalyticsConfig.Events and AnalyticsConfig.Events.BANK_RAID) or "BANK_RAID"
		AnalyticsService.Log(ev, player.UserId, { cash = cash })
	end
	pushState(player)
end

local function isUnderFire(player: Player): boolean
	local char = player.Character
	if not char then
		return true
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return true
	end
	return hum.Health < hum.MaxHealth * 0.95
end

function BankRaidService.Push(player: Player)
	pushState(player)
end

function BankRaidService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService
	RemoteSetup = deps.RemoteSetup
	CombatService = deps.CombatService

	if not BankRaidConfig.Enabled then
		return
	end

	task.defer(function()
		task.wait(2)
		findVault()
		spawnBankGuards()
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.25 then
			return
		end
		local step = accum
		accum = 0

		local vault = findVault()
		if not vault then
			return
		end
		local radius = BankRaidConfig.VaultRadius or 12
		local need = BankRaidConfig.RaidHoldSeconds or 8
		local nowUnix = os.time()
		local pos = vault.Position
		local nearby: { [number]: boolean } = {}

		for _, player in ipairs(Players:GetPlayers()) do
			local untilT = cooldownUntil[player.UserId] or 0
			if untilT <= nowUnix then
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					if (hrp.Position - pos).Magnitude <= radius then
						nearby[player.UserId] = true
						if not isUnderFire(player) then
							local prog = (holdProgress[player.UserId] or 0) + step
							holdProgress[player.UserId] = prog
							if prog >= need then
								completeRaid(player)
							end
						end
					end
				end
			end
		end

		for uid in pairs(holdProgress) do
			if not nearby[uid] then
				holdProgress[uid] = nil
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		task.defer(function()
			pushState(player)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.defer(function()
			pushState(player)
		end)
	end

	print("[WAR EMPIRE] BankRaidService ready (live BankGuard combat NPCs)")
end

return BankRaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Base plot assignment, upgrades, passive income, visual hooks.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local StructureVisualConfig = require(Shared.Configs.StructureVisualConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local DevConfig = require(Shared.Configs.DevConfig)
local Types = require(Shared.Types)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local BaseService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local TerritoryService: any = nil
local MissionService: any = nil
local TutorialService: any = nil
local NotificationService: any = nil

-- plotId -> userId
local plotOwners: { [number]: number } = {}
-- Bindable for Studio visuals
local upgradeChangedBindable: BindableEvent? = nil

local function getUpgradeChangedEvent(): BindableEvent
	if upgradeChangedBindable and upgradeChangedBindable.Parent then
		return upgradeChangedBindable
	end
	local folder = ReplicatedStorage:FindFirstChild("WarEmpireEvents")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "WarEmpireEvents"
		folder.Parent = ReplicatedStorage
	end
	local ev = folder:FindFirstChild("BaseUpgradeChanged")
	if not ev then
		ev = Instance.new("BindableEvent")
		ev.Name = "BaseUpgradeChanged"
		ev.Parent = folder
	end
	upgradeChangedBindable = ev :: BindableEvent
	return upgradeChangedBindable
end

function BaseService.GetUpgradeChangedEvent(): BindableEvent
	return getUpgradeChangedEvent()
end

local function findFreePlot(): number?
	for plotId = 1, BaseConfig.MaxPlots do
		if plotOwners[plotId] == nil then
			return plotId
		end
	end
	return nil
end

function BaseService.AssignPlot(player: Player): number?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end

	-- Reclaim previous if still free
	if profile.BasePlotId and plotOwners[profile.BasePlotId] == nil then
		plotOwners[profile.BasePlotId] = player.UserId
		return profile.BasePlotId
	end

	local plotId = findFreePlot()
	if not plotId then
		warn("[BaseService] No free plots for", player.Name)
		return nil
	end

	plotOwners[plotId] = player.UserId
	profile.BasePlotId = plotId
	DataService.MarkDirty(player)
	return plotId
end

function BaseService.ReleasePlot(player: Player)
	local userId = player.UserId
	for plotId, owner in pairs(plotOwners) do
		if owner == userId then
			plotOwners[plotId] = nil
		end
	end
end

function BaseService.GetOwnerUserId(plotId: number): number?
	return plotOwners[plotId]
end

function BaseService.ComputePassiveIncomePerTick(profile: Types.PlayerProfile, player: Player?): number
	local total = EconomyConfig.PassiveIncome.BaseCashPerTick
	local rates = EconomyConfig.PassiveIncome.PerLevelRates
	for structureId, level in pairs(profile.BaseUpgrades) do
		local rate = rates[structureId]
		if rate and level > 0 then
			total += rate * level
		end
	end
	local mult = 1 + (profile.Prestige * (EconomyConfig.PrestigeCashMultiplierPerLevel or 0))
	-- Territory ownership bonuses (Phase 5)
	if player and TerritoryService and TerritoryService.GetPassiveCashBonus then
		local bonusMult, flat = TerritoryService.GetPassiveCashBonus(player)
		mult += bonusMult
		total += flat
	end
	return math.floor(total * mult)
end

function BaseService.PushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local remote = RemoteSetup.Get(Constants.RemoteNames.BaseStateUpdate) :: RemoteEvent
	local payload: Types.BaseStatePayload = {
		PlotId = profile.BasePlotId,
		Upgrades = profile.BaseUpgrades,
		PassiveIncomePerTick = BaseService.ComputePassiveIncomePerTick(profile, player),
	}
	remote:FireClient(player, payload)
end

local function meetsRequirements(profile: Types.PlayerProfile, structureId: string): (boolean, string?)
	local def = BaseConfig.Structures[structureId]
	if not def then
		return false, "UnknownStructure"
	end
	if def.Requires then
		for _, req in ipairs(def.Requires) do
			local have = profile.BaseUpgrades[req.StructureId] or 0
			if have < req.Level then
				return false, "MissingRequirement"
			end
		end
	end
	return true, nil
end


function BaseService.GetPlotSpawnCFrame(plotId: number): CFrame?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			local folder = inst.Parent
			if folder then
				local spawn = folder:FindFirstChild("PlayerSpawn")
				if spawn and spawn:IsA("BasePart") then
					return spawn.CFrame + Vector3.new(0, 3, 0)
				end
			end
			return inst.CFrame + Vector3.new(0, 5, 55)
		end
	end
	local pos = BaseConfig.PlotPositions[plotId]
	if typeof(pos) == "Vector3" then
		return CFrame.new(pos + Vector3.new(0, 5, 55))
	end
	return nil
end

function BaseService.TeleportToPlot(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	-- Studio solo: never leave BasePlotId nil
	if profile.BasePlotId == nil then
		BaseService.AssignPlot(player)
		profile = DataService.GetProfile(player) or profile
		if profile.BasePlotId == nil then
			profile.BasePlotId = 1
		end
	end
	local cf = BaseService.GetPlotSpawnCFrame(profile.BasePlotId)
	if not cf then
		return
	end
	local function apply(character: Model)
		if character and character.Parent then
			character:PivotTo(cf)
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
	local function applyWithRetries(character: Model)
		apply(character)
		-- Retry: CharacterAdded / physics settle can undo first PivotTo
		task.delay(0.35, function()
			if player.Character == character and character.Parent then
				apply(character)
			end
		end)
		task.delay(1.0, function()
			if player.Character == character and character.Parent then
				apply(character)
			end
		end)
	end
	if player.Character then
		applyWithRetries(player.Character)
	else
		local conn: RBXScriptConnection?
		conn = player.CharacterAdded:Connect(function(character)
			if conn then
				conn:Disconnect()
			end
			task.defer(function()
				applyWithRetries(character)
			end)
		end)
		task.delay(30, function()
			if conn then
				conn:Disconnect()
			end
		end)
	end
end

function BaseService.PurchaseUpgrade(player: Player, structureId: string): Types.PurchaseUpgradeResult
	if not RemoteGuard.IsIdString(structureId, 48) then
		return { Ok = false, Error = "InvalidStructure" }
	end

	local profile = DataService.GetProfile(player)
	if not profile then
		return { Ok = false, Error = "NoProfile" }
	end

	local def = BaseConfig.Structures[structureId]
	if not def then
		return { Ok = false, Error = "UnknownStructure" }
	end

	local current = profile.BaseUpgrades[structureId] or 0
	if current >= def.MaxLevel then
		return { Ok = false, Error = "MaxLevel" }
	end

	local okReq, reqErr = meetsRequirements(profile, structureId)
	if not okReq then
		return { Ok = false, Error = reqErr }
	end

	local targetLevel = current + 1
	local cost = def.Costs[targetLevel]
	if not cost then
		return { Ok = false, Error = "NoCost" }
	end

	local spendOk, spendErr
	if def.Currency == "Gold" then
		spendOk, spendErr = EconomyService.SpendGold(player, cost, "upgrade_" .. structureId)
	else
		spendOk, spendErr = EconomyService.SpendCash(player, cost, "upgrade_" .. structureId)
	end
	if not spendOk then
		return { Ok = false, Error = spendErr or "SpendFailed" }
	end

	profile.BaseUpgrades[structureId] = targetLevel
	profile.Stats.UpgradesPurchased += 1
	DataService.MarkDirty(player)

	local firstUpgrade = profile.Stats.UpgradesPurchased == 1
	if AnalyticsService then
		AnalyticsService.Log("UPGRADE_PURCHASED", player.UserId, {
			structure = structureId,
			level = targetLevel,
			cost = cost,
		})
		if firstUpgrade then
			AnalyticsService.Log("FIRST_UPGRADE", player.UserId, { structure = structureId })
		end
	end

	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "PurchaseUpgrade", 1)
	end

	BaseService.PushState(player)
	BaseService.UpdateVisuals(player, structureId, targetLevel)

	getUpgradeChangedEvent():Fire(player.UserId, profile.BasePlotId, structureId, targetLevel)

	return {
		Ok = true,
		Error = nil,
		NewLevel = targetLevel,
		Cash = profile.Cash,
		Gold = profile.Gold,
	}
end

local function applyKitVisuals(plinth: BasePart, structureId: string, level: number)
	if not plinth or not plinth.Parent then
		return
	end
	local palette = StructureVisualConfig.Palettes[structureId]
	-- Missing palette / kit children is safe — plinth still scales
	local baseSize = plinth:GetAttribute("BaseSize")
	if typeof(baseSize) ~= "Vector3" then
		baseSize = Vector3.new(8, 1.2, 8)
		plinth:SetAttribute("BaseSize", baseSize)
	end
	local bs = baseSize :: Vector3
	local lv = math.clamp(level, 0, 5)
	local t = lv / 5
	local ghost = StructureVisualConfig.GhostTransparency
	local solid = StructureVisualConfig.SolidTransparency
	local transparency = if lv == 0 then ghost else solid

	-- Plinth grows slightly; kit body/roof scale with level
	plinth.Size = Vector3.new(bs.X, bs.Y * (1 + t * 0.35), bs.Z)
	if palette then
		plinth.Color = palette.Plinth
	else
		plinth.Color = Color3.fromRGB(40 + math.floor(t * 40), 60 + math.floor(t * 80), 50)
	end
	plinth.Transparency = transparency
	plinth.Material = Enum.Material.Concrete

	local bodyScale = 1 + lv * 0.55
	local accentScale = 1 + lv * 0.25

	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") then
			local role = child:GetAttribute("WE_KitRole")
			if role == "Body" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				child.Size = Vector3.new(b.X * (0.9 + t * 0.15), b.Y * bodyScale, b.Z * (0.9 + t * 0.15))
				if palette then
					child.Color = palette.Body
				end
				child.Transparency = transparency
				child.Material = Enum.Material.Metal
			elseif role == "Accent" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				child.Size = Vector3.new(b.X * accentScale, b.Y, b.Z * accentScale)
				if palette then
					child.Color = palette.Accent
				end
				-- Visual kits v2: less washout on ghost accents
				child.Transparency = if lv == 0 then 0.35 else 0.02
				child.Material = Enum.Material.Neon
			elseif role == "Roof" or role == "Antenna" then
				local bx = child:GetAttribute("WE_BaseSize")
				if typeof(bx) ~= "Vector3" then
					bx = child.Size
					child:SetAttribute("WE_BaseSize", bx)
				end
				local b = bx :: Vector3
				local yBoost = if role == "Antenna" then 1 + lv * 0.8 else 1 + lv * 0.4
				child.Size = Vector3.new(b.X, b.Y * yBoost, b.Z)
				-- Keep relative top position via attribute offset
				local off = child:GetAttribute("WE_LocalOffset")
				if typeof(off) == "Vector3" then
					local yExtra = if role == "Antenna" then lv * 0.9 else lv * 0.35
					child.CFrame = plinth.CFrame * CFrame.new((off :: Vector3) + Vector3.new(0, yExtra, 0))
				end
				if palette then
					child.Color = if role == "Antenna" then palette.Accent else palette.Roof
				end
				child.Transparency = transparency
				child.Material = if role == "Antenna" then Enum.Material.Neon else Enum.Material.Metal
			elseif role == "Detail" or role == "Pier" or role == "Door" or role == "Window" then
				child.Transparency = if lv == 0 then 0.4 else math.max(0, 0.2 - t * 0.2)
				if palette then
					child.Color = if role == "Window" then Color3.fromRGB(80, 120, 150) else palette.Accent
				end
				if role == "Window" then
					child.Material = Enum.Material.Glass
				elseif role == "Door" or role == "Pier" then
					child.Material = Enum.Material.Metal
				end
			end
		end
	end
end

function BaseService.UpdateVisuals(player: Player, structureId: string, level: number)
	local profile = DataService.GetProfile(player)
	if not profile or not profile.BasePlotId then
		return
	end
	local plotId = profile.BasePlotId

	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.UpgradeSlot)) do
		if inst:IsA("BasePart") then
			local p = inst:GetAttribute("PlotId")
			local s = inst:GetAttribute("StructureId")
			if p == plotId and s == structureId then
				local okApply, errApply = pcall(applyKitVisuals, inst, structureId, level)
				if not okApply then
					warn("[BaseService] applyKitVisuals failed", structureId, errApply)
				end
			end
		end
	end
end

function BaseService.RefreshAllVisuals(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	-- Apply to every configured structure (missing kit slots safe; L0 = ghost)
	for structureId in pairs(BaseConfig.Structures) do
		local level = profile.BaseUpgrades[structureId] or 0
		BaseService.UpdateVisuals(player, structureId, level)
	end
end

local function buildPlayerState(player: Player): Types.PlayerStatePayload?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	local LevelConfig = require(Shared.Configs.LevelConfig)
	return {
		Cash = profile.Cash,
		Gold = profile.Gold,
		Level = profile.Level,
		XP = profile.XP,
		XPToNext = LevelConfig.GetXPRequiredForLevel(profile.Level),
		Prestige = profile.Prestige,
		Soldiers = profile.Soldiers,
		NationColorId = profile.NationColorId,
		TrainingIncomePerTick = (function()
			local SoldierConfig = require(Shared.Configs.SoldierConfig)
			local cfg = SoldierConfig.TrainingIncome
			if not cfg then
				return 0
			end
			local count = tonumber(profile.Soldiers) or 0
			if count < (cfg.MinSoldiersForIncome or 1) then
				return 0
			end
			local prestigeMult = 1 + ((tonumber(profile.Prestige) or 0) * 0.05)
			return math.floor(count * (cfg.CashPerSoldierPerTick or 0) * prestigeMult)
		end)(),
		Base = {
			PlotId = profile.BasePlotId,
			Upgrades = profile.BaseUpgrades,
			PassiveIncomePerTick = BaseService.ComputePassiveIncomePerTick(profile, player),
		},
		TutorialStep = profile.TutorialStep,
		TutorialComplete = profile.TutorialComplete,
		Vehicles = profile.Vehicles,
		Weapons = profile.Weapons,
		EquippedWeapon = profile.EquippedWeapon,
		DailyLogin = profile.DailyLogin,
		TerritoriesOwned = profile.Territories,
	}
end

function BaseService.GetPlayerState(player: Player): Types.PlayerStatePayload?
	return buildPlayerState(player)
end

function BaseService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	NotificationService = deps.NotificationService

	getUpgradeChangedEvent()

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseUpgrade) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, payload: any)
		if not RateLimitService.Allow(player, "purchase_upgrade", 6, 8) then
			print(string.format("[BaseService] Remote BUY rate-limit %s", player.Name))
			if NotificationService then
				NotificationService.Notify(player, "Buying too fast — wait a moment", "Warn", 2.5)
			end
			return
		end
		local structureId = if typeof(payload) == "table" then payload.StructureId else payload
		print(string.format("[BaseService] Remote BUY attempt %s → %s", player.Name, tostring(structureId)))
		local result = BaseService.PurchaseUpgrade(player, structureId)
		print(string.format("[BaseService] Remote BUY result %s → Ok=%s Err=%s", player.Name, tostring(result.Ok), tostring(result.Error)))
		if not NotificationService then
			warn("[BaseService] NotificationService nil — purchase toast skipped")
			return
		end
		if result.Ok then
			local def = BaseConfig.Structures[structureId]
			local name = if def then def.DisplayName else tostring(structureId)
			NotificationService.Notify(
				player,
				string.format("%s → Lv %d", name, result.NewLevel or 0),
				"Success",
				3
			)
		else
			local err = result.Error or "Failed"
			local msg = if err == "InsufficientCash"
				then "Not enough cash"
				elseif err == "InsufficientGold"
				then "Not enough gold"
				elseif err == "MaxLevel"
				then "Already at MAX level"
				elseif err == "MissingRequirement"
				then "Missing prerequisite structure"
				elseif err == "UnknownStructure" or err == "InvalidStructure"
				then "Unknown structure"
				else ("Purchase failed: " .. tostring(err))
			NotificationService.Notify(player, msg, "Warn", 3.5)
		end
	end)

	local getStateFn = RemoteSetup.Get(Constants.RemoteNames.GetPlayerState) :: RemoteFunction
	getStateFn.OnServerInvoke = function(player: Player)
		if not RateLimitService.Allow(player, "get_state", 2, 4) then
			return nil
		end
		return buildPlayerState(player)
	end

	DataService.OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		BaseService.AssignPlot(player)
		-- ALWAYS teleport onto THEIR plot after character exists (retry inside TeleportToPlot)
		task.defer(function()
			BaseService.TeleportToPlot(player)
		end)
		task.delay(1.5, function()
			if player.Parent then
				BaseService.TeleportToPlot(player)
			end
		end)
		if TutorialService and TutorialService.Notify then
			TutorialService.Notify(player, "PlotAssigned")
		end
		BaseService.PushState(player)
		EconomyService.Push(player)
		if deps.XPService then
			deps.XPService.Push(player)
		end
		local stateRemote = RemoteSetup.Get(Constants.RemoteNames.PlayerStateUpdate) :: RemoteEvent
		local state = buildPlayerState(player)
		if state then
			stateRemote:FireClient(player, state)
		end
		task.defer(function()
			BaseService.RefreshAllVisuals(player)
		end)
		if AnalyticsService then
			AnalyticsService.Log("PLAYER_JOIN", player.UserId, { plot = _profile.BasePlotId })
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if AnalyticsService then
			AnalyticsService.Log("PLAYER_LEAVE", player.UserId, {})
		end
		BaseService.ReleasePlot(player)
	end)

	-- Passive income loop
	task.spawn(function()
		local tickSeconds = EconomyConfig.PassiveIncome.TickSeconds
		if RunService:IsStudio() and DevConfig.FastPassiveIncome then
			tickSeconds = 1
		end
		while true do
			task.wait(tickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataService.GetProfile(player)
				if profile then
					local amount = BaseService.ComputePassiveIncomePerTick(profile, player)
					if amount > 0 then
						EconomyService.AddCash(player, amount, "passive")
					end
				end
			end
		end
	end)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">BattlePassService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Battle pass track — dense Free/Premium rewards from BattlePassConfig.
	Premium flag only via Monetization ProcessReceipt (PremiumPass) / admin grantpremium — never client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BattlePassConfig = require(Shared.Configs.BattlePassConfig)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local BattlePassService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function ensureSeason(profile: any)
	local seasonId = SeasonConfig.CurrentSeasonId or BattlePassConfig.SeasonId
	if typeof(profile.BattlePass) ~= "table" then
		profile.BattlePass = {
			SeasonId = seasonId,
			XP = 0,
			Level = 0,
			Premium = false,
			ClaimedFree = {},
			ClaimedPremium = {},
		}
		return
	end
	if profile.BattlePass.SeasonId ~= seasonId then
		profile.BattlePass = {
			SeasonId = seasonId,
			XP = 0,
			Level = 0,
			Premium = profile.BattlePass.Premium == true, -- keep premium entitlement across seasons (policy: soft)
			ClaimedFree = {},
			ClaimedPremium = {},
		}
	end
	if typeof(profile.BattlePass.ClaimedFree) ~= "table" then
		profile.BattlePass.ClaimedFree = {}
	end
	if typeof(profile.BattlePass.ClaimedPremium) ~= "table" then
		profile.BattlePass.ClaimedPremium = {}
	end
end

local function countClaimable(bp: any, track: { [number]: any }, claimedMap: any, requirePremium: boolean): number
	if requirePremium and not bp.Premium then
		return 0
	end
	local n = 0
	local level = tonumber(bp.Level) or 0
	for tier, _reward in pairs(track) do
		local t = tonumber(tier)
		if t and t >= 1 and t <= level and not claimedMap[tostring(t)] then
			n += 1
		end
	end
	return n
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	local remote = RemoteSetup.Get(Constants.RemoteNames.BattlePassStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		SeasonId = bp.SeasonId,
		XP = bp.XP,
		Level = bp.Level,
		XPPerLevel = BattlePassConfig.XPPerLevel,
		MaxLevel = BattlePassConfig.MaxLevel,
		Premium = bp.Premium == true,
		ClaimedFree = bp.ClaimedFree,
		ClaimedPremium = bp.ClaimedPremium,
		FreeTrack = BattlePassConfig.FreeTrack,
		PremiumTrack = BattlePassConfig.PremiumTrack,
		ClaimableFree = countClaimable(bp, BattlePassConfig.FreeTrack, bp.ClaimedFree, false),
		ClaimablePremium = countClaimable(bp, BattlePassConfig.PremiumTrack, bp.ClaimedPremium, true),
		PremiumProductId = BattlePassConfig.PremiumProductId,
	})
end

function BattlePassService.AddXP(player: Player, amount: number, _reason: string?)
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if bp.Level >= BattlePassConfig.MaxLevel then
		return
	end
	bp.XP += amount
	while bp.Level < BattlePassConfig.MaxLevel do
		local need = BattlePassConfig.XPPerLevel
		if bp.XP < need then
			break
		end
		bp.XP -= need
		bp.Level += 1
		if NotificationService then
			NotificationService.Notify(player, "Battle Pass level " .. tostring(bp.Level) .. "!", "Reward", 4)
		end
	end
	DataService.MarkDirty(player)
	pushState(player)
end

local function grantReward(player: Player, reward: any)
	if typeof(reward) ~= "table" then
		return
	end
	if typeof(reward.Cash) == "number" and reward.Cash > 0 then
		EconomyService.AddCash(player, reward.Cash, "battlepass")
	end
	if typeof(reward.Gold) == "number" and reward.Gold > 0 then
		EconomyService.AddGold(player, reward.Gold, "battlepass")
	end
end

function BattlePassService.Claim(player: Player, level: number, track: string): (boolean, string?)
	local maxLevel = BattlePassConfig.MaxLevel or 50
	local clamped = RemoteGuard.ClampPositiveInt(level, maxLevel)
	if not clamped then
		return false, "InvalidLevel"
	end
	level = clamped
	if track ~= "free" and track ~= "premium" then
		return false, "InvalidTrack"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if level < 1 or level > bp.Level then
		return false, "LevelNotReached"
	end
	local key = tostring(level)
	if track == "free" then
		local reward = BattlePassConfig.FreeTrack[level]
		if not reward then
			return false, "NoReward"
		end
		if bp.ClaimedFree[key] then
			return false, "AlreadyClaimed"
		end
		bp.ClaimedFree[key] = true
		grantReward(player, reward)
	else
		if not bp.Premium then
			return false, "PremiumRequired"
		end
		local reward = BattlePassConfig.PremiumTrack[level]
		if not reward then
			return false, "NoReward"
		end
		if bp.ClaimedPremium[key] then
			return false, "AlreadyClaimed"
		end
		bp.ClaimedPremium[key] = true
		grantReward(player, reward)
	end
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Battle Pass reward claimed (L" .. key .. " " .. track .. ")", "Reward")
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(AnalyticsConfig.Events.BATTLEPASS_CLAIM or "BATTLEPASS_CLAIM", player.UserId, { level = level, track = track })
	end
	return true, nil
end


function BattlePassService.ClaimAll(player: Player, track: string): (number, string?)
	if track ~= "free" and track ~= "premium" then
		return 0, "InvalidTrack"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0, "NoProfile"
	end
	ensureSeason(profile)
	local bp = profile.BattlePass
	if track == "premium" and not bp.Premium then
		return 0, "PremiumRequired"
	end
	local trackTable = if track == "free" then BattlePassConfig.FreeTrack else BattlePassConfig.PremiumTrack
	local claimedMap = if track == "free" then bp.ClaimedFree else bp.ClaimedPremium
	local claimed = 0
	local tiers: { number } = {}
	for tier in pairs(trackTable) do
		local t = tonumber(tier)
		if t then
			table.insert(tiers, t)
		end
	end
	table.sort(tiers)
	for _, level in ipairs(tiers) do
		if level >= 1 and level <= bp.Level then
			local key = tostring(level)
			if not claimedMap[key] then
				local reward = trackTable[level]
				if reward then
					claimedMap[key] = true
					grantReward(player, reward)
					claimed += 1
					if AnalyticsService and AnalyticsService.Log then
						AnalyticsService.Log(AnalyticsConfig.Events.BATTLEPASS_CLAIM or "BATTLEPASS_CLAIM", player.UserId, { level = level, track = track, batch = true })
					end
				end
			end
		end
	end
	if claimed > 0 then
		DataService.MarkDirty(player)
		pushState(player)
	end
	return claimed, nil
end

function BattlePassService.SetPremium(player: Player, premium: boolean)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureSeason(profile)
	profile.BattlePass.Premium = premium == true
	DataService.MarkDirty(player)
	pushState(player)
end

function BattlePassService.Push(player: Player)
	pushState(player)
end

function BattlePassService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local claimRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimBattlePassReward) :: RemoteEvent
	claimRemote.OnServerEvent:Connect(function(player: Player, level: any, track: any)
		if not RateLimitService.Allow(player, "bp_claim", 4, 8) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "bp_claim_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if typeof(track) ~= "string" or (track ~= "free" and track ~= "premium") then
			return
		end
		-- level 0 / "all" = claim every reachable unclaimed reward on that track
		if level == 0 or level == "all" then
			local n, err = BattlePassService.ClaimAll(player, track)
			if NotificationService then
				if n > 0 then
					NotificationService.Notify(player, string.format("Claimed %d %s battle pass rewards", n, track), "Reward")
				elseif err then
					NotificationService.Notify(player, "Cannot claim: " .. tostring(err), "Warn")
				else
					NotificationService.Notify(player, "No " .. track .. " rewards ready to claim", "Info")
				end
			end
			return
		end
		local ok, err = BattlePassService.Claim(player, level, track)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot claim: " .. tostring(err), "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		ensureSeason(profile)
		DataService.MarkDirty(player)
		pushState(player)
	end)
end

return BattlePassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">CaptureStipendService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic cash stipend for owned territories / coastal oil (Military Tycoon–style).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local CaptureStipendService = {}

local DataService: any = nil
local EconomyService: any = nil
local TerritoryService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil

local function stipendForDef(def: any): number
	local cfg = TerritoryConfig.CaptureStipend
	if typeof(def.StipendCash) == "number" then
		return def.StipendCash
	end
	if def.IsOilRig then
		return cfg.OilRigCash or 14000
	end
	if def.IsFortress then
		return cfg.FortressCash or 10000
	end
	return cfg.DefaultCash or 4000
end

local function payoutPlayer(player: Player)
	if not TerritoryService or not TerritoryService.GetRuntime then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local total = 0
	local count = 0
	local oilCount = 0
	local ot = TerritoryConfig.OwnerTypes
	for id, def in pairs(TerritoryConfig.Territories) do
		local rt = TerritoryService.GetRuntime(id)
		if rt then
			local owns = (rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId)
				or (rt.OwnerType == ot.Clan and profile.ClanId ~= nil and rt.ClanId == profile.ClanId)
			if owns then
				total += stipendForDef(def)
				count += 1
				if def.IsOilRig then
					oilCount += 1
				end
			end
		end
	end
	if total <= 0 then
		return
	end
	EconomyService.AddCash(player, total, "capture_stipend")
	if TerritoryConfig.CaptureStipend.NotifyOnPayout and NotificationService then
		local oilHint = if oilCount > 0 then string.format(" (%d oil)", oilCount) else ""
		NotificationService.Notify(
			player,
			string.format("Capture stipend +$%d from %d zones%s", total, count, oilHint),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.CAPTURE_STIPEND, player.UserId, {
			cash = total,
			zones = count,
			oil = oilCount,
		})
	end
end

function CaptureStipendService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	TerritoryService = deps.TerritoryService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService

	local tickSec = (TerritoryConfig.CaptureStipend and TerritoryConfig.CaptureStipend.TickSeconds) or 90
	task.spawn(function()
		while true do
			task.wait(tickSec)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(payoutPlayer, player)
			end
		end
	end)
end

return CaptureStipendService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">ClanService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clan roster — DataStore-backed records (name, owner, members) with in-memory cache.
	Graceful fallback when DataStore unavailable (Studio without API services):
	session-only roster + profile.ClanId still works for the session.
	TerritoryService stamps runtime.ClanId from profile.ClanId on capture.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ClanConfig = require(Shared.Configs.ClanConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local ClanService = {}

export type ClanRecord = {
	Id: string,
	Name: string,
	Tag: string,
	LeaderUserId: number,
	Members: { [string]: boolean }, -- keyed by tostring(userId) for DataStore JSON safety
	CreatedUnix: number,
}

local CLAN_STORE_NAME = "WarEmpire_Clans_v1"
local INDEX_KEY = "_clan_index_v1"

local DataService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil

local clans: { [string]: ClanRecord } = {}
local nextClanSerial = 1
local clanStore: DataStore? = nil
local dataStoreAvailable = false
local nameIndex: { [string]: string } = {} -- lower(name|tag) -> clanId (session + loaded)

local function getClanStore(): DataStore?
	if clanStore then
		return clanStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(CLAN_STORE_NAME)
	end)
	if ok then
		clanStore = result
		dataStoreAvailable = true
		return clanStore
	end
	dataStoreAvailable = false
	warn("[ClanService] DataStore unavailable (Studio without API services): session-only clans.", result)
	return nil
end

local function memberKey(userId: number): string
	return tostring(userId)
end

local function memberCount(clan: ClanRecord): number
	local n = 0
	for _ in pairs(clan.Members) do
		n += 1
	end
	return n
end

local function normalizeMembers(raw: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	if typeof(raw) ~= "table" then
		return out
	end
	for k, v in pairs(raw) do
		if v == true then
			out[tostring(k)] = true
		end
	end
	return out
end

local function decodeClan(data: any): ClanRecord?
	if typeof(data) ~= "table" or typeof(data.Id) ~= "string" then
		return nil
	end
	if typeof(data.Name) ~= "string" or typeof(data.Tag) ~= "string" then
		return nil
	end
	local leader = tonumber(data.LeaderUserId)
	if not leader then
		return nil
	end
	return {
		Id = data.Id,
		Name = data.Name,
		Tag = data.Tag,
		LeaderUserId = leader,
		Members = normalizeMembers(data.Members),
		CreatedUnix = tonumber(data.CreatedUnix) or os.time(),
	}
end

local function encodeClan(clan: ClanRecord): { [string]: any }
	return {
		Id = clan.Id,
		Name = clan.Name,
		Tag = clan.Tag,
		LeaderUserId = clan.LeaderUserId,
		Members = clan.Members,
		CreatedUnix = clan.CreatedUnix,
	}
end

local function indexKeys(clan: ClanRecord)
	nameIndex["n:" .. string.lower(clan.Name)] = clan.Id
	nameIndex["t:" .. string.upper(clan.Tag)] = clan.Id
end

local function clearIndexKeys(clan: ClanRecord)
	local nKey = "n:" .. string.lower(clan.Name)
	local tKey = "t:" .. string.upper(clan.Tag)
	if nameIndex[nKey] == clan.Id then
		nameIndex[nKey] = nil
	end
	if nameIndex[tKey] == clan.Id then
		nameIndex[tKey] = nil
	end
end

local function persistClan(clan: ClanRecord): boolean
	local store = getClanStore()
	if not store then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync(clan.Id, encodeClan(clan))
	end)
	if not ok then
		warn("[ClanService] persistClan failed:", clan.Id, err)
		return false
	end
	-- Best-effort index update (list of ids)
	pcall(function()
		store:UpdateAsync(INDEX_KEY, function(old)
			local list = if typeof(old) == "table" then old else {}
			local found = false
			for _, id in ipairs(list) do
				if id == clan.Id then
					found = true
					break
				end
			end
			if not found then
				table.insert(list, clan.Id)
			end
			return list
		end)
	end)
	return true
end

local function deleteClanPersist(clanId: string)
	local store = getClanStore()
	if not store then
		return
	end
	pcall(function()
		store:RemoveAsync(clanId)
	end)
	pcall(function()
		store:UpdateAsync(INDEX_KEY, function(old)
			if typeof(old) ~= "table" then
				return {}
			end
			local nextList = {}
			for _, id in ipairs(old) do
				if id ~= clanId then
					table.insert(nextList, id)
				end
			end
			return nextList
		end)
	end)
end

local function loadClanFromStore(clanId: string): ClanRecord?
	local store = getClanStore()
	if not store then
		return nil
	end
	local ok, data = pcall(function()
		return store:GetAsync(clanId)
	end)
	if not ok then
		warn("[ClanService] GetAsync failed:", clanId, data)
		return nil
	end
	local clan = decodeClan(data)
	if clan then
		clans[clan.Id] = clan
		indexKeys(clan)
	end
	return clan
end

local function ensureClanLoaded(clanId: string): ClanRecord?
	local existing = clans[clanId]
	if existing then
		return existing
	end
	return loadClanFromStore(clanId)
end

local function sanitizeName(name: string): string?
	if typeof(name) ~= "string" then
		return nil
	end
	local trimmed = string.gsub(name, "^%s*(.-)%s*$", "%1")
	trimmed = string.gsub(trimmed, "[^%w%s%-%_]", "")
	if #trimmed < ClanConfig.MinNameLength or #trimmed > ClanConfig.MaxNameLength then
		return nil
	end
	return trimmed
end

local function sanitizeTag(tag: string): string?
	if typeof(tag) ~= "string" then
		return nil
	end
	local trimmed = string.upper(string.gsub(tag, "%s+", ""))
	trimmed = string.gsub(trimmed, "[^%w]", "")
	if #trimmed < ClanConfig.MinTagLength or #trimmed > ClanConfig.MaxTagLength then
		return nil
	end
	return trimmed
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local clanId = profile.ClanId
	local clan = if clanId then ensureClanLoaded(clanId) else nil
	local remote = RemoteSetup.Get(Constants.RemoteNames.ClanStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		ClanId = clanId,
		Name = if clan then clan.Name else nil,
		Tag = if clan then clan.Tag else nil,
		LeaderUserId = if clan then clan.LeaderUserId else nil,
		MemberCount = if clan then memberCount(clan) else 0,
		Persisted = dataStoreAvailable,
	})
end

function ClanService.GetClanId(player: Player): string?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	return profile.ClanId
end

function ClanService.GetClan(clanId: string): ClanRecord?
	return ensureClanLoaded(clanId)
end

function ClanService.IsDataStoreAvailable(): boolean
	return dataStoreAvailable
end

function ClanService.CreateClan(leader: Player, name: string, tag: string?): (boolean, string?)
	local profile = DataService.GetProfile(leader)
	if not profile then
		return false, "NoProfile"
	end
	if profile.ClanId then
		return false, "AlreadyInClan"
	end
	local cleanName = sanitizeName(name)
	if not cleanName then
		return false, "InvalidName"
	end
	local cleanTag = sanitizeTag(tag or string.sub(cleanName, 1, ClanConfig.MaxTagLength))
	if not cleanTag then
		return false, "InvalidTag"
	end

	-- Session uniqueness
	if nameIndex["n:" .. string.lower(cleanName)] or nameIndex["t:" .. string.upper(cleanTag)] then
		return false, "NameOrTagTaken"
	end
	for _, clan in pairs(clans) do
		if string.lower(clan.Name) == string.lower(cleanName) or clan.Tag == cleanTag then
			return false, "NameOrTagTaken"
		end
	end

	local clanId = string.format("clan_%d_%d", leader.UserId, nextClanSerial)
	nextClanSerial += 1
	local record: ClanRecord = {
		Id = clanId,
		Name = cleanName,
		Tag = cleanTag,
		LeaderUserId = leader.UserId,
		Members = { [memberKey(leader.UserId)] = true },
		CreatedUnix = os.time(),
	}
	clans[clanId] = record
	indexKeys(record)
	persistClan(record)

	profile.ClanId = clanId
	DataService.MarkDirty(leader)
	pushState(leader)

	if NotificationService then
		local suffix = if dataStoreAvailable then "" else " (session-only — enable API Services)"
		NotificationService.Notify(leader, "Clan created: [" .. cleanTag .. "] " .. cleanName .. suffix, "Success")
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log("CLAN_CREATE", leader.UserId, {
			clanId = clanId,
			name = cleanName,
			persisted = dataStoreAvailable,
		})
	end
	return true, nil
end

function ClanService.JoinClan(player: Player, clanId: string): (boolean, string?)
	if not RemoteGuard.IsIdString(clanId) then
		return false, "InvalidClanId"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.ClanId then
		return false, "AlreadyInClan"
	end
	local clan = ensureClanLoaded(clanId)
	if not clan then
		return false, "ClanNotFound"
	end
	if memberCount(clan) >= ClanConfig.MaxMembers then
		return false, "ClanFull"
	end
	clan.Members[memberKey(player.UserId)] = true
	persistClan(clan)
	profile.ClanId = clanId
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Joined clan [" .. clan.Tag .. "] " .. clan.Name, "Success")
	end
	return true, nil
end

function ClanService.LeaveClan(player: Player): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local clanId = profile.ClanId
	if not clanId then
		return false, "NotInClan"
	end
	local clan = ensureClanLoaded(clanId)
	profile.ClanId = nil
	DataService.MarkDirty(player)
	if clan then
		clan.Members[memberKey(player.UserId)] = nil
		if clan.LeaderUserId == player.UserId then
			local newLeader: number? = nil
			for uidStr in pairs(clan.Members) do
				newLeader = tonumber(uidStr)
				break
			end
			if newLeader then
				clan.LeaderUserId = newLeader
				persistClan(clan)
			else
				clearIndexKeys(clan)
				clans[clanId] = nil
				deleteClanPersist(clanId)
			end
		else
			persistClan(clan)
		end
	end
	pushState(player)
	if NotificationService then
		NotificationService.Notify(player, "Left clan.", "Info")
	end
	return true, nil
end

function ClanService.Push(player: Player)
	pushState(player)
end

function ClanService.Init(deps: { [string]: any })
	DataService = deps.DataService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService

	getClanStore() -- probe availability once at boot

	local createRemote = RemoteSetup.Get(Constants.RemoteNames.RequestCreateClan) :: RemoteEvent
	createRemote.OnServerEvent:Connect(function(player: Player, name: any, tag: any)
		if not RateLimitService.Allow(player, "clan_create", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsIdString(name, 32) then
			return
		end
		local tagArg = if RemoteGuard.IsIdString(tag, 8) then tag :: string else nil
		local ok, err = ClanService.CreateClan(player, name :: string, tagArg)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot create clan: " .. tostring(err), "Warn")
		end
	end)

	local joinRemote = RemoteSetup.Get(Constants.RemoteNames.RequestJoinClan) :: RemoteEvent
	joinRemote.OnServerEvent:Connect(function(player: Player, clanId: any)
		if not RateLimitService.Allow(player, "clan_join", 2, 3) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsIdString(clanId) then
			return
		end
		local ok, err = ClanService.JoinClan(player, clanId :: string)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot join clan: " .. tostring(err), "Warn")
		end
	end)

	local leaveRemote = RemoteSetup.Get(Constants.RemoteNames.RequestLeaveClan) :: RemoteEvent
	leaveRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "clan_leave", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		ClanService.LeaveClan(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.ClanId) == "string" and profile.ClanId ~= "" then
			local existing = ensureClanLoaded(profile.ClanId)
			if existing then
				existing.Members[memberKey(player.UserId)] = true
				-- Soft-heal membership if they were missing from roster (e.g. crash mid-join)
				persistClan(existing)
			else
				-- Soft rehydrate stub so territory ClanId stamp still works this session
				local stub: ClanRecord = {
					Id = profile.ClanId,
					Name = "Clan " .. string.sub(profile.ClanId, -4),
					Tag = "CLAN",
					LeaderUserId = player.UserId,
					Members = { [memberKey(player.UserId)] = true },
					CreatedUnix = os.time(),
				}
				clans[profile.ClanId] = stub
				indexKeys(stub)
				if dataStoreAvailable then
					persistClan(stub)
				end
			end
		end
		pushState(player)
	end)

	-- Keep member online flag in session; do not remove from persisted roster on leave server
	Players.PlayerRemoving:Connect(function(_player)
		-- Membership persists across sessions via DataStore / profile.ClanId
	end)
end

return ClanService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">ClanWarService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Clan war — declare, score, settle with rewards + scoreboard.
	Declare is server-validated; scores only mutate on server events.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ClanWarConfig = require(Shared.Configs.ClanWarConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local ClanWarService = {}

export type WarRecord = {
	Id: string,
	AttackerClanId: string,
	DefenderClanId: string,
	AttackerName: string?,
	DefenderName: string?,
	StartUnix: number,
	EndUnix: number,
	AttackerScore: number,
	DefenderScore: number,
	Active: boolean,
	Settled: boolean,
	WinnerClanId: string?,
}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local ClanService: any = nil
local AntiExploitService: any = nil

local wars: { [string]: WarRecord } = {}
local clanActiveWar: { [string]: string } = {}
local globalScores: { [string]: number } = {}
local declareCooldownUntil: { [string]: number } = {} -- clanId -> unix
local nextWarSerial = 1

local function memberCount(clan: any): number
	local n = 0
	if typeof(clan) == "table" and typeof(clan.Members) == "table" then
		for _ in pairs(clan.Members) do
			n += 1
		end
	end
	return n
end

local function leaderUserId(clan: any): number?
	if typeof(clan) ~= "table" then
		return nil
	end
	return clan.LeaderUserId or clan.OwnerUserId
end

local function clanDisplayName(clanId: string): string
	if ClanService and ClanService.GetClan then
		local clan = ClanService.GetClan(clanId)
		if clan and typeof(clan.Name) == "string" then
			local tag = if typeof(clan.Tag) == "string" then clan.Tag else "?"
			return string.format("[%s] %s", tag, clan.Name)
		end
	end
	return clanId
end

local function topScoreboard(): { { ClanId: string, Score: number, Name: string } }
	local list: { { ClanId: string, Score: number, Name: string } } = {}
	for clanId, score in pairs(globalScores) do
		table.insert(list, {
			ClanId = clanId,
			Score = score,
			Name = clanDisplayName(clanId),
		})
	end
	table.sort(list, function(a, b)
		if a.Score == b.Score then
			return a.ClanId < b.ClanId
		end
		return a.Score > b.Score
	end)
	local topN = ClanWarConfig.ScoreboardTopN or 8
	local out = {}
	for i = 1, math.min(topN, #list) do
		table.insert(out, list[i])
	end
	return out
end

local function notifyClan(clanId: string, message: string, kind: string)
	if not NotificationService then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == clanId then
			NotificationService.Notify(player, message, kind)
		end
	end
end

local function pushWar(player: Player, war: WarRecord?)
	local remote = RemoteSetup.Get(Constants.RemoteNames.ClanWarStateUpdate) :: RemoteEvent
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	local cooldownLeft = 0
	if clanId and declareCooldownUntil[clanId] then
		cooldownLeft = math.max(0, declareCooldownUntil[clanId] - os.time())
	end
	remote:FireClient(player, {
		War = war,
		MyClanId = clanId,
		GlobalScores = globalScores,
		Scoreboard = topScoreboard(),
		GlobalWarEnabled = ClanWarConfig.GlobalWarEnabled == true,
		GlobalWarSeasonKey = ClanWarConfig.GlobalWarSeasonKey,
		DeclareCooldownLeft = cooldownLeft,
		MinMembers = ClanWarConfig.MinClanMembersToDeclare or 2,
		WarDurationSeconds = ClanWarConfig.WarDurationSeconds or 3600,
		Rewards = {
			WinCash = ClanWarConfig.WinningClanCashReward or 0,
			WinGold = ClanWarConfig.WinningClanGoldReward or 0,
			PartCash = ClanWarConfig.ParticipationCashReward or 0,
			PartGold = ClanWarConfig.ParticipationGoldReward or 0,
			ScoreBonusCashPerPoint = ClanWarConfig.ScoreBonusCashPerPoint or 0,
		},
	})
end

local function broadcastWar(war: WarRecord)
	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == war.AttackerClanId or cid == war.DefenderClanId then
			pushWar(player, war)
		end
	end
end

local function broadcastAll()
	for _, player in ipairs(Players:GetPlayers()) do
		local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		local war: WarRecord? = nil
		if clanId and clanActiveWar[clanId] then
			war = wars[clanActiveWar[clanId]]
		end
		pushWar(player, war)
	end
end

local function settleWar(war: WarRecord)
	if war.Settled then
		return
	end
	war.Settled = true
	war.Active = false
	clanActiveWar[war.AttackerClanId] = nil
	clanActiveWar[war.DefenderClanId] = nil

	local cooldown = ClanWarConfig.DeclareCooldownSeconds or 300
	local untilUnix = os.time() + cooldown
	declareCooldownUntil[war.AttackerClanId] = untilUnix
	declareCooldownUntil[war.DefenderClanId] = untilUnix

	local winner: string? = nil
	if war.AttackerScore > war.DefenderScore then
		winner = war.AttackerClanId
	elseif war.DefenderScore > war.AttackerScore then
		winner = war.DefenderClanId
	end
	war.WinnerClanId = winner

	local winCash = ClanWarConfig.WinningClanCashReward or 0
	local winGold = ClanWarConfig.WinningClanGoldReward or 0
	local partCash = ClanWarConfig.ParticipationCashReward or 0
	local partGold = ClanWarConfig.ParticipationGoldReward or 0
	local scoreBonus = ClanWarConfig.ScoreBonusCashPerPoint or 0

	local attackerName = war.AttackerName or clanDisplayName(war.AttackerClanId)
	local defenderName = war.DefenderName or clanDisplayName(war.DefenderClanId)
	local scoreLine = string.format("%s %d – %d %s", attackerName, war.AttackerScore, war.DefenderScore, defenderName)

	for _, player in ipairs(Players:GetPlayers()) do
		local cid = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
		if cid == winner then
			local bonus = 0
			if scoreBonus > 0 then
				local myScore = if cid == war.AttackerClanId then war.AttackerScore else war.DefenderScore
				bonus = math.floor(myScore * scoreBonus)
			end
			if winCash + bonus > 0 then
				EconomyService.AddCash(player, winCash + bonus, "clan_war_win")
			end
			if winGold > 0 then
				EconomyService.AddGold(player, winGold, "clan_war_win")
			end
			if NotificationService then
				NotificationService.Notify(
					player,
					string.format("Clan war VICTORY! %s  (+$%d%s)", scoreLine, winCash + bonus, if winGold > 0 then string.format(" +%dG", winGold) else ""),
					"Reward"
				)
			end
		elseif cid == war.AttackerClanId or cid == war.DefenderClanId then
			if partCash > 0 then
				EconomyService.AddCash(player, partCash, "clan_war_participate")
			end
			if partGold > 0 then
				EconomyService.AddGold(player, partGold, "clan_war_participate")
			end
			local resultWord = if winner then "defeat" else "draw"
			if NotificationService then
				NotificationService.Notify(
					player,
					string.format("Clan war %s — %s  (+$%d participation)", resultWord, scoreLine, partCash),
					"Info"
				)
			end
		end
		pushWar(player, war)
	end

	local eventName = if AnalyticsConfig.Events.CLAN_WAR_SETTLE then AnalyticsConfig.Events.CLAN_WAR_SETTLE else "CLAN_WAR_SETTLE"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, 0, {
			warId = war.Id,
			winner = winner,
			attackerScore = war.AttackerScore,
			defenderScore = war.DefenderScore,
		})
	end
end

function ClanWarService.AddScore(clanId: string, points: number, _reason: string?)
	if typeof(clanId) ~= "string" or clanId == "" then
		return
	end
	points = math.floor(tonumber(points) or 0)
	if points == 0 then
		return
	end
	if ClanWarConfig.GlobalWarEnabled then
		globalScores[clanId] = (globalScores[clanId] or 0) + points
	end
	local warId = clanActiveWar[clanId]
	if warId then
		local war = wars[warId]
		if war and war.Active then
			if clanId == war.AttackerClanId then
				war.AttackerScore += points
			elseif clanId == war.DefenderClanId then
				war.DefenderScore += points
			end
			if os.time() >= war.EndUnix then
				settleWar(war)
			else
				broadcastWar(war)
			end
		end
	end
end

function ClanWarService.OnTerritoryCaptured(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	if clanId then
		ClanWarService.AddScore(clanId, ClanWarConfig.ScorePerTerritoryCapture or 10, "territory")
	end
end

function ClanWarService.OnEnemyKill(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	if clanId then
		ClanWarService.AddScore(clanId, ClanWarConfig.ScorePerEnemyKill or 1, "kill")
	end
end

function ClanWarService.DeclareWar(player: Player, defenderClanId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(defenderClanId) then
		return false, "InvalidDefender"
	end
	if not RemoteGuard.RequireProfile(DataService, player) then
		return false, "NoProfile"
	end
	if not ClanService then
		return false, "ClanServiceMissing"
	end
	local attackerClanId = ClanService.GetClanId(player)
	if not attackerClanId then
		return false, "NotInClan"
	end
	if attackerClanId == defenderClanId then
		return false, "CannotWarSelf"
	end
	local now = os.time()
	if declareCooldownUntil[attackerClanId] and now < declareCooldownUntil[attackerClanId] then
		return false, "DeclareCooldown"
	end
	local attackerClan = ClanService.GetClan(attackerClanId)
	local defenderClan = ClanService.GetClan(defenderClanId)
	if not attackerClan or not defenderClan then
		return false, "ClanNotFound"
	end
	if leaderUserId(attackerClan) ~= player.UserId then
		return false, "LeaderOnly"
	end
	local minMembers = ClanWarConfig.MinClanMembersToDeclare or 2
	if memberCount(attackerClan) < minMembers or memberCount(defenderClan) < minMembers then
		return false, "NotEnoughMembers"
	end
	if clanActiveWar[attackerClanId] or clanActiveWar[defenderClanId] then
		return false, "AlreadyAtWar"
	end

	local warId = string.format("war_%d_%d", now, nextWarSerial)
	nextWarSerial += 1
	local war: WarRecord = {
		Id = warId,
		AttackerClanId = attackerClanId,
		DefenderClanId = defenderClanId,
		AttackerName = clanDisplayName(attackerClanId),
		DefenderName = clanDisplayName(defenderClanId),
		StartUnix = now,
		EndUnix = now + (ClanWarConfig.WarDurationSeconds or 3600),
		AttackerScore = 0,
		DefenderScore = 0,
		Active = true,
		Settled = false,
		WinnerClanId = nil,
	}
	wars[warId] = war
	clanActiveWar[attackerClanId] = warId
	clanActiveWar[defenderClanId] = warId
	broadcastWar(war)
	-- Also refresh scoreboard for everyone
	broadcastAll()

	local declareMsg = string.format(
		"WAR DECLARED: %s vs %s (%dm)",
		war.AttackerName or attackerClanId,
		war.DefenderName or defenderClanId,
		math.floor((ClanWarConfig.WarDurationSeconds or 3600) / 60)
	)
	notifyClan(attackerClanId, declareMsg, "Success")
	notifyClan(defenderClanId, declareMsg .. " — DEFEND!", "Warn")

	local eventName = if AnalyticsConfig.Events.CLAN_WAR_DECLARE then AnalyticsConfig.Events.CLAN_WAR_DECLARE else "CLAN_WAR_DECLARE"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, {
			warId = warId,
			attacker = attackerClanId,
			defender = defenderClanId,
		})
	end
	return true, nil
end

function ClanWarService.Push(player: Player)
	local clanId = if ClanService and ClanService.GetClanId then ClanService.GetClanId(player) else nil
	local war: WarRecord? = nil
	if clanId and clanActiveWar[clanId] then
		war = wars[clanActiveWar[clanId]]
	end
	pushWar(player, war)
end

function ClanWarService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	ClanService = deps.ClanService
	AntiExploitService = deps.AntiExploitService

	local declareRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDeclareClanWar) :: RemoteEvent
	declareRemote.OnServerEvent:Connect(function(player: Player, defenderClanId: any)
		if not RateLimitService.Allow(player, "clan_war_declare", 1, 1) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "clan_war_declare_rate")
			end
			return
		end
		local ok, err = ClanWarService.DeclareWar(player, defenderClanId)
		if not ok and NotificationService then
			local msg = "Cannot declare war: " .. tostring(err)
			if err == "DeclareCooldown" then
				local cid = if ClanService then ClanService.GetClanId(player) else nil
				local left = if cid and declareCooldownUntil[cid] then math.max(0, declareCooldownUntil[cid] - os.time()) else 0
				msg = string.format("War declare cooldown: %ds remaining", left)
			elseif err == "NotEnoughMembers" then
				msg = string.format("Both clans need ≥%d members to war", ClanWarConfig.MinClanMembersToDeclare or 2)
			elseif err == "LeaderOnly" then
				msg = "Only the clan leader can declare war"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		ClanWarService.Push(player)
	end)

	task.spawn(function()
		while true do
			task.wait(15)
			if next(wars) ~= nil then
				local now = os.time()
				for _, war in pairs(wars) do
					if war.Active and not war.Settled and now >= war.EndUnix then
						settleWar(war)
					end
				end
			end
		end
	end)
end

return ClanWarService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">CodesService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Promo code redemption — once per code per player. Server-validated Cash/Gold grants.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local CodesConfig = require(Shared.Configs.CodesConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local CodesService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function normalize(code: string): string
	local s = string.upper(string.gsub(code, "%s+", ""))
	return s
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.RedeemedCodes) ~= "table" then
		profile.RedeemedCodes = {}
	end
	local redeemed: { string } = {}
	for id in pairs(profile.RedeemedCodes) do
		table.insert(redeemed, id)
	end
	table.sort(redeemed)
	local remote = RemoteSetup.Get(Constants.RemoteNames.CodeStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Redeemed = redeemed,
		AvailableHints = { "WARFOUNDING", "BUILDCONQUER" },
	})
end

function CodesService.Redeem(player: Player, rawCode: any): (boolean, string?)
	if not RemoteGuard.IsIdString(rawCode, CodesConfig.MaxCodeLength or 32) then
		return false, "InvalidCode"
	end
	local code = normalize(rawCode :: string)
	local def = CodesConfig.Codes[code]
	if not def then
		return false, "UnknownCode"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if typeof(profile.RedeemedCodes) ~= "table" then
		profile.RedeemedCodes = {}
	end
	if profile.RedeemedCodes[code] then
		return false, "AlreadyRedeemed"
	end

	profile.RedeemedCodes[code] = true
	DataService.MarkDirty(player)

	local cash = tonumber(def.Cash) or 0
	local gold = tonumber(def.Gold) or 0
	if cash > 0 then
		EconomyService.AddCash(player, cash, "code")
	end
	if gold > 0 then
		EconomyService.AddGold(player, gold, "code")
	end

	if NotificationService then
		local name = def.DisplayName or code
		NotificationService.Notify(
			player,
			string.format("Code %s: +$%d · +%d Gold", name, cash, gold),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.CODE_REDEEM, player.UserId, {
			code = code,
			cash = cash,
			gold = gold,
		})
	end
	pushState(player)
	return true, nil
end

function CodesService.Push(player: Player)
	pushState(player)
end

function CodesService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestRedeemCode) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player, code: any)
		if not RateLimitService.Allow(player, "redeem_code", 1, 3) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "redeem_code_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = CodesService.Redeem(player, code)
		if not ok and NotificationService then
			local msg = "Code failed"
			if err == "AlreadyRedeemed" then
				msg = "Code already redeemed"
			elseif err == "UnknownCode" then
				msg = "Unknown code"
			elseif err == "InvalidCode" then
				msg = "Invalid code"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.RedeemedCodes) ~= "table" then
			profile.RedeemedCodes = {}
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)
end

return CodesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 3 — Server-authoritative combat.
	Clients request fire/reload/equip/purchase; server validates and applies WeaponConfig damage.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local WeaponConfig = require(Shared.Configs.WeaponConfig)
local CombatConfig = require(Shared.Configs.CombatConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local CombatDamage = require(script.CombatDamage)
local CombatNPC = require(script.CombatNPC)
local CombatWeaponLogic = require(script.CombatWeaponLogic)
local VisualAssetService = require(script.Parent.Parent.VisualAssetService)

-- Cached CollectionService:GetTagged results (invalidated on TTL)
local _tagCache: { [string]: { at: number, list: { Instance } } } = {}
local TAG_CACHE_TTL = 2.0
local function getTaggedCached(tag: string): { Instance }
	local now = os.clock()
	local entry = _tagCache[tag]
	if entry and (now - entry.at) < TAG_CACHE_TTL then
		return entry.list
	end
	local list = CollectionService:GetTagged(tag)
	_tagCache[tag] = { at = now, list = list }
	return list
end

type WeaponDef = WeaponConfig.WeaponDef
type NPCTypeDef = CombatConfig.NPCTypeDef
type PlayerProfile = Types.PlayerProfile

type CombatState = {
	WeaponId: string,
	Ammo: number,
	ReloadingUntil: number,
	LastFireAt: number,
	InvulnerableUntil: number,
	Alive: boolean,
	FirstPvpLogged: boolean,
}

type NPCRecord = {
	Id: string,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	TypeId: string,
	Def: NPCTypeDef,
	LastFireAt: number,
	SpawnCFrame: CFrame,
	Alive: boolean,
}

local RemoteGuard = require(script.Parent.Parent.Parent.Modules.RemoteGuard)

local CombatService = {}

local DataService: any = nil
local EconomyService: any = nil
local XPService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local AntiExploitService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local MissionService: any = nil
local TerritoryService: any = nil

local combatStates: { [number]: CombatState } = {}
local npcRecords: { [string]: NPCRecord } = {}
local npcFolder: Folder? = nil
local npcSerial = 1
local firstPvpLogged: { [number]: boolean } = {}

local function clock(): number
	return os.clock()
end

local function weaponDef(id: string): WeaponDef?
	return CombatWeaponLogic.WeaponDef(id)
end

local function ensureStarter(profile: PlayerProfile)
	CombatWeaponLogic.EnsureStarter(profile)
end

local function owns(profile: PlayerProfile, weaponId: string): boolean
	return CombatWeaponLogic.Owns(profile, weaponId)
end

local function characterParts(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return character, humanoid, root
end

local function pushState(player: Player)
	local state = combatStates[player.UserId]
	local _, humanoid = characterParts(player)
	local weaponId = if state then state.WeaponId else nil
	local def = if weaponId then weaponDef(weaponId) else nil
	local payload: Types.CombatStatePayload = {
		Health = if humanoid then humanoid.Health else 0,
		MaxHealth = if humanoid then humanoid.MaxHealth else CombatConfig.PlayerMaxHealth,
		WeaponId = weaponId,
		Ammo = if state then state.Ammo else 0,
		MagazineSize = if def then def.MagazineSize else 0,
		Reloading = if state then clock() < state.ReloadingUntil else false,
		Alive = if state then state.Alive else (humanoid ~= nil and humanoid.Health > 0),
	}
	local remote = RemoteSetup.Get(Constants.RemoteNames.CombatStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

local function hitFeedback(player: Player, payload: Types.CombatHitFeedbackPayload)
	local remote = RemoteSetup.Get(Constants.RemoteNames.CombatHitFeedback) :: RemoteEvent
	remote:FireClient(player, payload)
end

local function getState(player: Player): CombatState?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	ensureStarter(profile)
	local existing = combatStates[player.UserId]
	if existing then
		return existing
	end
	local weaponId = profile.EquippedWeapon or WeaponConfig.DefaultWeapon
	local def = weaponDef(weaponId)
	local state: CombatState = {
		WeaponId = weaponId,
		Ammo = if def then def.MagazineSize else 30,
		ReloadingUntil = 0,
		LastFireAt = 0,
		InvulnerableUntil = 0,
		Alive = true,
		FirstPvpLogged = firstPvpLogged[player.UserId] == true,
	}
	combatStates[player.UserId] = state
	return state
end

local function damageFor(def: WeaponDef, attacker: Player?): number
	return CombatDamage.DamageFor(def, attacker)
end

local function tagCreator(humanoid: Humanoid, attacker: Player)
	CombatDamage.TagCreator(humanoid, attacker)
end

local function raycast(origin: Vector3, direction: Vector3, range: number, ignore: { Instance }): RaycastResult?
	return CombatDamage.Raycast(origin, direction, range, ignore)
end

function CombatService.GetPlotSpawnCFrame(plotId: number): CFrame?
	for _, inst in ipairs(getTaggedCached(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			local folder = inst.Parent
			if folder then
				local spawn = folder:FindFirstChild("PlayerSpawn")
				if spawn and spawn:IsA("BasePart") then
					return spawn.CFrame + Vector3.new(0, 3, 0)
				end
			end
			return inst.CFrame + Vector3.new(0, 5, 55)
		end
	end
	local pos = BaseConfig.PlotPositions[plotId]
	if pos then
		return CFrame.new(pos + Vector3.new(0, 5, 55))
	end
	return nil
end

function CombatService.TeleportToBase(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile or not profile.BasePlotId then
		return
	end
	local cf = CombatService.GetPlotSpawnCFrame(profile.BasePlotId)
	local character = player.Character
	if cf and character then
		character:PivotTo(cf)
	end
end

local function markFirstPvp(attacker: Player)
	if firstPvpLogged[attacker.UserId] then
		local state = combatStates[attacker.UserId]
		if state then
			state.FirstPvpLogged = true
		end
		return
	end
	firstPvpLogged[attacker.UserId] = true
	local state = combatStates[attacker.UserId]
	if state then
		state.FirstPvpLogged = true
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.FIRST_PVP, attacker.UserId, {})
	end
end

local function grantRewards(attacker: Player, cash: number, xp: number, reason: string)
	if cash > 0 then
		EconomyService.AddCash(attacker, cash, reason)
	end
	if xp > 0 then
		XPService.AddXP(attacker, xp, reason)
	end
end

function CombatService.RegisterPlayerKill(attacker: Player, victim: Player)
	local profile = DataService.GetProfile(attacker)
	if profile then
		profile.Stats.Kills += 1
		DataService.MarkDirty(attacker)
	end
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(attacker, "KillPlayer", 1)
	end
	local vProfile = DataService.GetProfile(victim)
	if vProfile then
		vProfile.Stats.Deaths += 1
		DataService.MarkDirty(victim)
	end
	markFirstPvp(attacker)
	grantRewards(attacker, CombatConfig.PlayerKill.Cash, CombatConfig.PlayerKill.XP, "pvp_kill")
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.PLAYER_KILL, attacker.UserId, {
			victim = victim.UserId,
			cash = CombatConfig.PlayerKill.Cash,
			xp = CombatConfig.PlayerKill.XP,
		})
	end
	if NotificationService then
		NotificationService.Notify(
			attacker,
			string.format("Eliminated %s (+$%d)", victim.DisplayName, CombatConfig.PlayerKill.Cash),
			"Reward"
		)
	end
end

local function damagePlayer(attacker: Player, victim: Player, damage: number, weaponId: string): boolean
	if not GameConfig.PvPEnabled then
		return false
	end
	if attacker == victim and not GameConfig.FriendlyFire then
		return false
	end
	local vState = combatStates[victim.UserId]
	if vState and clock() < vState.InvulnerableUntil then
		return false
	end
	local _, humanoid = characterParts(victim)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	tagCreator(humanoid, attacker)
	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	local dealt = math.max(0, before - humanoid.Health)
	if dealt <= 0 then
		return false
	end
	local killed = humanoid.Health <= 0
	hitFeedback(attacker, {
		Kind = if killed then "Kill" else "Hit",
		Damage = dealt,
		TargetName = victim.DisplayName,
		WeaponId = weaponId,
		IsHeadshot = false,
	})
	hitFeedback(victim, {
		Kind = if killed then "Death" else "Damaged",
		Damage = dealt,
		WeaponId = weaponId,
	})
	pushState(victim)
	return true
end

local function ensureNPCFolder(): Folder
	if npcFolder and npcFolder.Parent then
		return npcFolder
	end
	local existing = Workspace:FindFirstChild("WarEmpireNPCs")
	if existing and existing:IsA("Folder") then
		npcFolder = existing
		return npcFolder
	end
	local folder = Instance.new("Folder")
	folder.Name = "WarEmpireNPCs"
	folder.Parent = Workspace
	npcFolder = folder
	return folder
end

local function aliveNPCCount(): number
	local n = 0
	for _, rec in pairs(npcRecords) do
		if rec.Alive then
			n += 1
		end
	end
	return n
end

local function destroyNPC(rec: NPCRecord)
	rec.Alive = false
	npcRecords[rec.Id] = nil
	if rec.Model and rec.Model.Parent then
		rec.Model:Destroy()
	end
end

function CombatService.OnNPCKilled(attacker: Player, rec: NPCRecord)
	if not rec.Alive then
		return
	end
	rec.Alive = false
	local cash = rec.Def.CashReward
	local xp = rec.Def.XPReward
	grantRewards(attacker, cash, xp, "npc_kill")
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(attacker, "KillNPC", 1)
	end
	local profile = DataService.GetProfile(attacker)
	if profile then
		profile.Stats.Kills += 1
		DataService.MarkDirty(attacker)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.NPC_KILL, attacker.UserId, {
			npcType = rec.TypeId,
			cash = cash,
			xp = xp,
		})
	end
	if NotificationService then
		NotificationService.Notify(attacker, string.format("%s down (+$%d)", rec.Def.DisplayName, cash), "Reward")
	end
	hitFeedback(attacker, { Kind = "Kill", Damage = 0, TargetName = rec.Def.DisplayName, WeaponId = nil })
	local spawnCf = rec.SpawnCFrame
	local typeId = rec.TypeId
	task.delay(0.35, function()
		destroyNPC(rec)
	end)
	task.delay(CombatConfig.NPCRespawnSeconds, function()
		CombatService.SpawnNPC(typeId, spawnCf)
	end)
end

local function damageNPC(attacker: Player, npcId: string, damage: number, weaponId: string): boolean
	local rec = npcRecords[npcId]
	if not rec or not rec.Alive or rec.Humanoid.Health <= 0 then
		return false
	end
	tagCreator(rec.Humanoid, attacker)
	local before = rec.Humanoid.Health
	rec.Humanoid:TakeDamage(damage)
	local dealt = math.max(0, before - rec.Humanoid.Health)
	if dealt <= 0 then
		return false
	end
	local killed = rec.Humanoid.Health <= 0
	hitFeedback(attacker, {
		Kind = if killed then "Kill" else "Hit",
		Damage = dealt,
		TargetName = rec.Def.DisplayName,
		WeaponId = weaponId,
	})
	if killed then
		CombatService.OnNPCKilled(attacker, rec)
	end
	return true
end

function CombatService.SpawnNPC(typeId: string?, at: CFrame): NPCRecord?
	local tid = typeId or CombatConfig.DefaultNPCType
	local isSpecial = tid == "BankGuard" or tid == "OilRigGuard" or tid == "FortGuard"
	local cap = CombatConfig.MaxActiveNPCs or 18
	-- Special guards may exceed soft field pool by +4 so bank always gets guards
	if aliveNPCCount() >= (if isSpecial then cap + 4 else cap) then
		print(string.format("[CombatService] SpawnNPC blocked at cap alive=%d tid=%s", aliveNPCCount(), tostring(tid)))
		return nil
	end
	local def = CombatConfig.NPCTypes[tid]
	if not def then
		tid = CombatConfig.DefaultNPCType
		def = CombatConfig.NPCTypes[tid]
	end
	if not def then
		return nil
	end

	local id = string.format("npc_%d", npcSerial)
	npcSerial += 1

	local model = Instance.new("Model")
	model.Name = def.DisplayName
	model:SetAttribute("NPCId", id)
	model:SetAttribute("NPCType", tid)

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	-- Classic R6 torso proportions (2×2×1)
	root.Size = Vector3.new(2, 2, 1)
	root.CFrame = at
	root.Anchored = false
	root.CanCollide = true
	root.Color = def.Color
	root.Material = Enum.Material.Fabric
	root.Parent = model

	local function weldPart(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = at * offset
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = root
		return p
	end

	-- Visual kits v2 infantry: helmet, vest, legs, rifle silhouette
	local skin = Color3.fromRGB(
		math.clamp(math.floor(def.Color.R * 255) + 30, 0, 255),
		math.clamp(math.floor(def.Color.G * 255) + 15, 0, 255),
		math.clamp(math.floor(def.Color.B * 255) + 10, 0, 255)
	)
	local helmCol = Color3.fromRGB(
		math.clamp(math.floor(def.Color.R * 255) - 20, 20, 255),
		math.clamp(math.floor(def.Color.G * 255) - 10, 20, 255),
		math.clamp(math.floor(def.Color.B * 255) - 15, 20, 255)
	)
	local isHeavy = tid == "HeavyInfantry" or tid == "OilRigGuard" or tid == "FortGuard"
	local isBank = tid == "BankGuard"
	-- R6-ish: head +1.5, arms ±1.5, legs ±0.5 @ -2
	local headPart = weldPart("Head", Vector3.new(1.05, 1.05, 1.05), CFrame.new(0, 1.55, 0), skin, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = headPart
	weldPart("Helmet", Vector3.new(1.2, 0.5, 1.2), CFrame.new(0, 1.95, 0), helmCol, Enum.Material.Metal, nil)
	weldPart("Visor", Vector3.new(0.95, 0.2, 0.3), CFrame.new(0, 1.75, -0.5), Color3.fromRGB(30, 35, 40), Enum.Material.Glass, nil)
	weldPart("Vest", Vector3.new(2.1, 1.2, 1.15), CFrame.new(0, 0.15, 0), Color3.fromRGB(
		math.clamp(math.floor(def.Color.R * 255) - 25, 25, 255),
		math.clamp(math.floor(def.Color.G * 255) - 15, 25, 255),
		math.clamp(math.floor(def.Color.B * 255) - 10, 25, 255)
	), Enum.Material.Metal, nil)
	weldPart("LegL", Vector3.new(1, 2, 1), CFrame.new(-0.5, -2, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("LegR", Vector3.new(1, 2, 1), CFrame.new(0.5, -2, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("BootL", Vector3.new(1.05, 0.35, 1.15), CFrame.new(-0.5, -3.1, 0.1), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, nil)
	weldPart("BootR", Vector3.new(1.05, 0.35, 1.15), CFrame.new(0.5, -3.1, 0.1), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, nil)
	weldPart("ArmL", Vector3.new(1, 2, 1), CFrame.new(-1.5, 0, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("ArmR", Vector3.new(1, 2, 1), CFrame.new(1.5, 0, 0), def.Color, Enum.Material.Fabric, nil)
	weldPart("Rifle", Vector3.new(0.26, 0.26, 2.4), CFrame.new(1.15, 0.15, -0.85), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil)
	weldPart("Stock", Vector3.new(0.28, 0.35, 0.7), CFrame.new(1.15, 0.2, 0.55), Color3.fromRGB(45, 40, 32), Enum.Material.Wood, nil)
	weldPart("BarrelTip", Vector3.new(0.18, 0.18, 0.35), CFrame.new(1.15, 0.15, -2.05), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil)
	local accent = if isBank
		then Color3.fromRGB(90, 140, 220)
		elseif isHeavy then Color3.fromRGB(230, 160, 50)
		else Color3.fromRGB(200, 80, 60)
	weldPart("Accent", Vector3.new(1.9, 0.12, 0.35), CFrame.new(0, 0.95, -0.6), accent, Enum.Material.Neon, nil)
	if isHeavy then
		weldPart("Pack", Vector3.new(1.4, 1.5, 0.7), CFrame.new(0, 0.4, 0.85), Color3.fromRGB(40, 42, 38), Enum.Material.Metal, nil)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = def.Health
	humanoid.Health = def.Health
	humanoid.WalkSpeed = def.WalkSpeed
	-- Kill double nametags: Humanoid nameplate OFF; one clean Billboard only
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameOcclusion = Enum.NameOcclusion.OccludeAll
	humanoid.Parent = model

	-- Single clean nameplate
	local bb = Instance.new("BillboardGui")
	bb.Name = "NPCLabel"
	bb.Size = UDim2.fromOffset(140, 28)
	bb.StudsOffset = Vector3.new(0, 3.6, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Parent = root
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	lbl.BackgroundTransparency = 0.25
	lbl.Text = def.DisplayName
	lbl.TextColor3 = Color3.fromRGB(230, 235, 255)
	lbl.TextScaled = true
	lbl.Font = Enum.Font.GothamBold
	lbl.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = lbl

	model.PrimaryPart = root
	-- Optional free Soldier catalog visual (scripts stripped); Part kit stays authoritative
	pcall(function()
		local kind = if isSpecial then tid else "Soldier"
		VisualAssetService.TryAttachCharacterVisual(model, kind)
	end)
	CollectionService:AddTag(model, Constants.Tags.NPC)
	model.Parent = ensureNPCFolder()
	-- Server owns physics so MoveTo works reliably
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local gyro = Instance.new("BodyGyro")
	gyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	gyro.P = 3000
	gyro.CFrame = at
	gyro.Parent = root

	local rec: NPCRecord = {
		Id = id,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		TypeId = tid,
		Def = def,
		LastFireAt = 0,
		SpawnCFrame = at,
		Alive = true,
	}
	npcRecords[id] = rec

	humanoid.Died:Connect(function()
		if not rec.Alive then
			return
		end
		local killer: Player? = nil
		local tag = humanoid:FindFirstChild("creator")
		if tag and tag:IsA("ObjectValue") and tag.Value and tag.Value:IsA("Player") then
			killer = tag.Value :: Player
		end
		if killer then
			CombatService.OnNPCKilled(killer, rec)
		else
			local spawnCf = rec.SpawnCFrame
			local t = rec.TypeId
			task.delay(0.35, function()
				destroyNPC(rec)
			end)
			task.delay(CombatConfig.NPCRespawnSeconds, function()
				CombatService.SpawnNPC(t, spawnCf)
			end)
		end
	end)

	return rec
end

local function thinkNPCs()
	CombatNPC.Think()
end

local function gatherSpawns(): { CFrame }
	return CombatNPC.GatherSpawns()
end

function CombatService.BootstrapNPCs()
	local points = gatherSpawns()
	local types = { "Infantry", "Infantry", "HeavyInfantry" }
	local spawned = 0
	-- Reserve slots for BankGuard / special spawns (BankRaidService)
	local fieldCap = math.max(4, (CombatConfig.MaxActiveNPCs or 18) - 6)
	for i, cf in ipairs(points) do
		if spawned >= fieldCap then
			break
		end
		local typeId = types[((i - 1) % #types) + 1]
		if CombatService.SpawnNPC(typeId, cf) then
			spawned += 1
		end
	end
	if RunService:IsStudio() then
		print(string.format("[CombatService] Spawned %d NPCs (cap %d)", spawned, CombatConfig.MaxActiveNPCs))
	end
end

function CombatService.EquipWeapon(player: Player, weaponId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(weaponId, 48) then
		return false, "InvalidWeapon"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureStarter(profile)
	if not owns(profile, weaponId) then
		return false, "NotOwned"
	end
	local def = weaponDef(weaponId)
	if not def then
		return false, "UnknownWeapon"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	profile.EquippedWeapon = weaponId
	DataService.MarkDirty(player)
	local state = getState(player)
	if state then
		state.WeaponId = weaponId
		state.Ammo = def.MagazineSize
		state.ReloadingUntil = 0
	end
	pushState(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.WEAPON_EQUIPPED, player.UserId, { weapon = weaponId })
	end
	return true, nil
end

function CombatService.PurchaseWeapon(player: Player, weaponId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(weaponId, 48) then
		return false, "InvalidWeapon"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local def = weaponDef(weaponId)
	if not def then
		return false, "UnknownWeapon"
	end
	ensureStarter(profile)
	if owns(profile, weaponId) then
		return false, "AlreadyOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local cost = def.CostCash or 0
	if cost > 0 then
		local ok, err = EconomyService.SpendCash(player, cost, "weapon_" .. weaponId)
		if not ok then
			return false, err or "SpendFailed"
		end
	end
	profile.Weapons[weaponId] = true
	DataService.MarkDirty(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.WEAPON_PURCHASED, player.UserId, { weapon = weaponId, cost = cost })
	end
	if NotificationService then
		NotificationService.Notify(player, "Acquired " .. def.DisplayName, "Reward")
	end
	CombatService.EquipWeapon(player, weaponId)
	return true, nil
end

function CombatService.Reload(player: Player): (boolean, string?)
	local state = getState(player)
	if not state or not state.Alive then
		return false, "Dead"
	end
	local def = weaponDef(state.WeaponId)
	if not def then
		return false, "NoWeapon"
	end
	if clock() < state.ReloadingUntil then
		return false, "AlreadyReloading"
	end
	if state.Ammo >= def.MagazineSize then
		return false, "FullMag"
	end
	local reloadTime = def.ReloadTime
	state.ReloadingUntil = clock() + reloadTime
	local weaponId = state.WeaponId
	pushState(player)
	task.delay(reloadTime, function()
		local s = combatStates[player.UserId]
		if not s or s.WeaponId ~= weaponId then
			return
		end
		if clock() + 0.05 < s.ReloadingUntil then
			return
		end
		s.Ammo = def.MagazineSize
		s.ReloadingUntil = 0
		if player.Parent then
			pushState(player)
		end
	end)
	return true, nil
end

function CombatService.RequestFire(player: Player, payload: any): boolean
	if typeof(payload) ~= "table" then
		AntiExploitService.Strike(player, "fire_bad_payload")
		return false
	end
	if not RateLimitService.Allow(player, "combat_fire", CombatConfig.FireRemoteRate, CombatConfig.FireRemoteBurst) then
		return false
	end

	local state = getState(player)
	if not state or not state.Alive then
		return false
	end
	if clock() < state.ReloadingUntil then
		return false
	end

	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	ensureStarter(profile)
	if not owns(profile, state.WeaponId) then
		AntiExploitService.Strike(player, "fire_unowned_weapon")
		return false
	end

	local def = weaponDef(state.WeaponId)
	if not def then
		return false
	end

	local minInterval = 1 / math.max(def.FireRate, 0.1)
	if clock() - state.LastFireAt < minInterval * 0.9 then
		return false
	end
	if state.Ammo <= 0 then
		return false
	end

	local character, humanoid, root = characterParts(player)
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		return false
	end

	local direction = payload.Direction
	if typeof(direction) ~= "Vector3" or direction.Magnitude < CombatConfig.MaxAimDirectionError then
		AntiExploitService.Strike(player, "fire_bad_direction")
		return false
	end
	if not AntiExploitService.IsFiniteNumber(direction.X) then
		AntiExploitService.Strike(player, "fire_nan_direction")
		return false
	end
	direction = direction.Unit

	local origin = payload.Origin
	if typeof(origin) ~= "Vector3" then
		origin = root.Position + Vector3.new(0, 1.5, 0)
	else
		if (origin - root.Position).Magnitude > CombatConfig.MaxOriginDeltaStuds then
			AntiExploitService.Strike(player, "fire_origin_desync")
			origin = root.Position + Vector3.new(0, 1.5, 0)
		end
	end

	state.Ammo -= 1
	state.LastFireAt = clock()
	pushState(player)

	local range = def.Range + CombatConfig.HitPositionSlopStuds
	local damage = damageFor(def, player)
	local result = raycast(origin, direction, range, { character })

	local hitSomething = false
	if result then
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		if model then
			local hitPlayer = Players:GetPlayerFromCharacter(model)
			if hitPlayer then
				hitSomething = damagePlayer(player, hitPlayer, damage, state.WeaponId)
			elseif CollectionService:HasTag(model, Constants.Tags.NPC) then
				local npcId = model:GetAttribute("NPCId")
				if typeof(npcId) == "string" and (result.Position - origin).Magnitude <= range then
					hitSomething = damageNPC(player, npcId, damage, state.WeaponId)
				end
			end
		end
	else
		local targetUserId = payload.TargetUserId
		local targetNpcId = payload.TargetNpcId
		if typeof(targetUserId) == "number" then
			local targetPlayer = Players:GetPlayerByUserId(targetUserId)
			if targetPlayer then
				local _, _, troot = characterParts(targetPlayer)
				if troot and (troot.Position - origin).Magnitude <= range then
					hitSomething = damagePlayer(player, targetPlayer, damage, state.WeaponId)
				end
			end
		elseif typeof(targetNpcId) == "string" then
			local rec = npcRecords[targetNpcId]
			if rec and rec.Alive and (rec.Root.Position - origin).Magnitude <= range then
				hitSomething = damageNPC(player, targetNpcId, damage, state.WeaponId)
			end
		end
	end

	if not hitSomething then
		local hitPosition = payload.HitPosition
		if typeof(hitPosition) == "Vector3" and (hitPosition - origin).Magnitude > range * 1.25 then
			AntiExploitService.Strike(player, "fire_hitpos_oor")
		end
	end

	return true
end

local function onPlayerDeath(victim: Player, killer: Player?)
	local state = combatStates[victim.UserId]
	if state then
		state.Alive = false
	end
	pushState(victim)
	if killer and killer ~= victim then
		CombatService.RegisterPlayerKill(killer, victim)
	else
		local vProfile = DataService.GetProfile(victim)
		if vProfile then
			vProfile.Stats.Deaths += 1
			DataService.MarkDirty(victim)
		end
	end
	task.delay(GameConfig.RespawnTimeSeconds, function()
		if victim.Parent then
			victim:LoadCharacter()
		end
	end)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.MaxHealth = CombatConfig.PlayerMaxHealth
	humanoid.Health = CombatConfig.PlayerMaxHealth

	local state = getState(player)
	if state then
		state.Alive = true
		local invuln = GameConfig.SpawnInvulnerabilitySeconds or CombatConfig.SpawnInvulnerabilitySeconds
		state.InvulnerableUntil = clock() + invuln
		local def = weaponDef(state.WeaponId)
		if def then
			state.Ammo = def.MagazineSize
			state.ReloadingUntil = 0
		end
	end

	task.defer(function()
		CombatService.TeleportToBase(player)
		pushState(player)
	end)

	humanoid.Died:Connect(function()
		local killer: Player? = nil
		local tag = humanoid:FindFirstChild("creator")
		if tag and tag:IsA("ObjectValue") and tag.Value and tag.Value:IsA("Player") then
			killer = tag.Value :: Player
		end
		onPlayerDeath(player, killer)
	end)

	humanoid.HealthChanged:Connect(function()
		pushState(player)
	end)
end

function CombatService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	AntiExploitService = deps.AntiExploitService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	MissionService = deps.MissionService
	TerritoryService = deps.TerritoryService

	CombatDamage.Bind({ TerritoryService = TerritoryService })
	CombatNPC.Bind({
		npcRecords = npcRecords,
		combatStates = combatStates,
		clock = clock,
		characterParts = characterParts,
		hitFeedback = hitFeedback,
		pushState = pushState,
		spawnNPC = function(typeId: string?, at: CFrame)
			return CombatService.SpawnNPC(typeId, at)
		end,
		getTagged = getTaggedCached,
	})


	local equipRemote = RemoteSetup.Get(Constants.RemoteNames.RequestEquipWeapon) :: RemoteEvent
	equipRemote.OnServerEvent:Connect(function(player: Player, weaponId: any)
		if not RateLimitService.Allow(player, "equip_weapon", CombatConfig.EquipRemoteRate, CombatConfig.EquipRemoteBurst) then
			return
		end
		local ok, err = CombatService.EquipWeapon(player, weaponId)
		if not ok and NotificationService and err then
			NotificationService.Notify(player, "Cannot equip: " .. tostring(err), "Warn")
		end
	end)

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseWeapon) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, weaponId: any)
		if not RateLimitService.Allow(player, "buy_weapon", CombatConfig.PurchaseWeaponRate, CombatConfig.PurchaseWeaponBurst) then
			return
		end
		local ok, err = CombatService.PurchaseWeapon(player, weaponId)
		if not ok and NotificationService and err then
			NotificationService.Notify(player, "Cannot buy weapon: " .. tostring(err), "Warn")
		end
	end)

	local fireRemote = RemoteSetup.Get(Constants.RemoteNames.RequestFire) :: RemoteEvent
	fireRemote.OnServerEvent:Connect(function(player: Player, payload: any)
		CombatService.RequestFire(player, payload)
	end)

	local reloadRemote = RemoteSetup.Get(Constants.RemoteNames.RequestReload) :: RemoteEvent
	reloadRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "reload", CombatConfig.ReloadRemoteRate, CombatConfig.ReloadRemoteBurst) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		CombatService.Reload(player)
	end)

	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end

	DataService.OnProfileLoaded(function(player: Player, profile: PlayerProfile)
		ensureStarter(profile)
		DataService.MarkDirty(player)
		getState(player)
		local wid = profile.EquippedWeapon or WeaponConfig.DefaultWeapon
		CombatService.EquipWeapon(player, wid)
		pushState(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		combatStates[player.UserId] = nil
	end)

	task.spawn(function()
		task.wait(1)
		CombatService.BootstrapNPCs()
		while true do
			task.wait(CombatConfig.NPCThinkInterval)
			thinkNPCs()
		end
	end)
end

function CombatService.GetPlayerCombatState(player: Player): CombatState?
	return combatStates[player.UserId]
end

function CombatService.PushState(player: Player)
	pushState(player)
end

function CombatService.ApplyDamage(attacker: Player, target: Humanoid, weaponId: string, _ignored: number)
	local def = weaponDef(weaponId)
	if not def then
		return
	end
	local damage = damageFor(def, attacker)
	local model = target.Parent
	if model and model:IsA("Model") then
		local victim = Players:GetPlayerFromCharacter(model)
		if victim then
			damagePlayer(attacker, victim, damage, weaponId)
			return
		end
		if CollectionService:HasTag(model, Constants.Tags.NPC) then
			local npcId = model:GetAttribute("NPCId")
			if typeof(npcId) == "string" then
				damageNPC(attacker, npcId, damage, weaponId)
			end
		end
	end
end

function CombatService.RegisterKill(attacker: Player, victim: Player)
	CombatService.RegisterPlayerKill(attacker, victim)
end

return CombatService
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">CombatDamage</string>
              <string name="Source"><![CDATA[--!strict
--[[ Raycast + damage math + creator tags for CombatService. ]]

local Workspace = game:GetService("Workspace")

local CombatDamage = {}

export type Bindings = {
	TerritoryService: any,
}

local B: Bindings = { TerritoryService = nil }

function CombatDamage.Bind(bindings: Bindings)
	B = bindings
end

function CombatDamage.Raycast(origin: Vector3, direction: Vector3, range: number, ignore: { Instance }): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local unit = if direction.Magnitude > 1e-4 then direction.Unit else Vector3.new(0, 0, -1)
	return Workspace:Raycast(origin, unit * range, params)
end

function CombatDamage.TagCreator(humanoid: Humanoid, attacker: Player)
	local existing = humanoid:FindFirstChild("creator")
	if existing then
		existing:Destroy()
	end
	local tag = Instance.new("ObjectValue")
	tag.Name = "creator"
	tag.Value = attacker
	tag.Parent = humanoid
	task.delay(2, function()
		if tag.Parent then
			tag:Destroy()
		end
	end)
end

function CombatDamage.DamageFor(def: any, attacker: Player?): number
	local base = def.Damage * (def.Pellets or 1)
	if attacker and B.TerritoryService and B.TerritoryService.GetDamageMult then
		base = base * B.TerritoryService.GetDamageMult(attacker)
	end
	return base
end

return CombatDamage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">CombatNPC</string>
              <string name="Source"><![CDATA[--!strict
--[[ NPC spawn gathering, nearest-player, think loop — used by CombatService façade. ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedRoot = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(SharedRoot.Constants)
local CombatConfig = require(SharedRoot.Configs.CombatConfig)

local CombatNPC = {}

export type Bindings = {
	npcRecords: { [string]: any },
	combatStates: { [number]: any },
	clock: () -> number,
	characterParts: (Player) -> (Model?, Humanoid?, BasePart?),
	hitFeedback: (Player, any) -> (),
	pushState: (Player) -> (),
	spawnNPC: (string?, CFrame) -> any,
	getTagged: (string) -> { Instance },
}

local B: Bindings

function CombatNPC.Bind(bindings: Bindings)
	B = bindings
end

function CombatNPC.AliveCount(): number
	local n = 0
	for _, rec in pairs(B.npcRecords) do
		if rec.Alive then
			n += 1
		end
	end
	return n
end

function CombatNPC.Destroy(rec: any)
	rec.Alive = false
	B.npcRecords[rec.Id] = nil
	if rec.Model and rec.Model.Parent then
		rec.Model:Destroy()
	end
end

function CombatNPC.NearestPlayer(position: Vector3, maxRange: number): (Player?, number)
	local best: Player? = nil
	local bestDistSq = maxRange * maxRange
	for _, player in ipairs(Players:GetPlayers()) do
		local _, hum, root = B.characterParts(player)
		if hum and root and hum.Health > 0 then
			local delta = root.Position - position
			local dSq = delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z
			if dSq < bestDistSq then
				bestDistSq = dSq
				best = player
			end
		end
	end
	return best, math.sqrt(bestDistSq)
end

function CombatNPC.Think()
	if next(B.npcRecords) == nil then
		return
	end
	local now = B.clock()
	for _, rec in pairs(B.npcRecords) do
		if rec.Alive and rec.Humanoid.Health > 0 and rec.Root.Parent then
			local target, dist = CombatNPC.NearestPlayer(rec.Root.Position, rec.Def.AggroRange)
			if target then
				local _, th, troot = B.characterParts(target)
				if th and troot then
					local look = CFrame.lookAt(
						rec.Root.Position,
						Vector3.new(troot.Position.X, rec.Root.Position.Y, troot.Position.Z)
					)
					rec.Root.CFrame = look
					local gyro = rec.Root:FindFirstChildOfClass("BodyGyro")
					if gyro then
						gyro.CFrame = look
					end
					if dist > rec.Def.Range * 0.85 then
						rec.Humanoid:MoveTo(troot.Position)
					else
						rec.Humanoid:MoveTo(rec.Root.Position)
						local interval = 1 / math.max(rec.Def.FireRate, 0.1)
						if now - rec.LastFireAt >= interval and dist <= rec.Def.Range then
							rec.LastFireAt = now
							local tState = B.combatStates[target.UserId]
							if not (tState and now < tState.InvulnerableUntil) then
								th:TakeDamage(rec.Def.Damage)
								B.hitFeedback(target, {
									Kind = if th.Health <= 0 then "Death" else "Damaged",
									Damage = rec.Def.Damage,
									TargetName = rec.Def.DisplayName,
								})
								B.pushState(target)
							end
						end
					end
				end
			end
		end
	end
end

function CombatNPC.GatherSpawns(): { CFrame }
	local list: { CFrame } = {}
	for _, inst in ipairs(B.getTagged(Constants.Tags.NPCSpawn)) do
		if inst:IsA("BasePart") then
			table.insert(list, inst.CFrame + Vector3.new(0, 3, 0))
		end
	end
	if CombatConfig.NPCAlsoSpawnNearTerritories then
		local added = 0
		local maxNear = CombatConfig.MaxTerritoryNPCSpawns or 8
		for _, inst in ipairs(B.getTagged(Constants.Tags.Territory)) do
			if inst:IsA("BasePart") and added < maxNear then
				local offset = Vector3.new(math.random(-20, 20), 3, math.random(-20, 20))
				table.insert(list, inst.CFrame + offset)
				added += 1
			end
		end
	end
	if #list == 0 then
		for i = 1, 6 do
			local angle = (i / 6) * math.pi * 2
			table.insert(list, CFrame.new(100 + math.cos(angle) * 60, 4, 100 + math.sin(angle) * 60))
		end
	end
	return list
end

function CombatNPC.Bootstrap()
	local points = CombatNPC.GatherSpawns()
	local types = { "Infantry", "Infantry", "HeavyInfantry" }
	local spawned = 0
	for i, cf in ipairs(points) do
		if spawned >= CombatConfig.MaxActiveNPCs then
			break
		end
		local typeId = types[((i - 1) % #types) + 1]
		if B.spawnNPC(typeId, cf) then
			spawned += 1
		end
	end
	if RunService:IsStudio() then
		print(string.format("[CombatService] Spawned %d NPCs (cap %d)", spawned, CombatConfig.MaxActiveNPCs))
	end
	return spawned
end

return CombatNPC
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">CombatWeaponLogic</string>
              <string name="Source"><![CDATA[--!strict
--[[ Weapon ownership / equip / purchase validation helpers. ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SharedRoot = ReplicatedStorage:WaitForChild("Shared")
local WeaponConfig = require(SharedRoot.Configs.WeaponConfig)
local Types = require(SharedRoot.Types)

type PlayerProfile = Types.PlayerProfile

local CombatWeaponLogic = {}

function CombatWeaponLogic.EnsureStarter(profile: PlayerProfile)
	local starter = WeaponConfig.DefaultWeapon
	if typeof(profile.Weapons) ~= "table" then
		profile.Weapons = {}
	end
	if not profile.Weapons[starter] then
		profile.Weapons[starter] = true
	end
	if not profile.EquippedWeapon or not profile.Weapons[profile.EquippedWeapon] then
		profile.EquippedWeapon = starter
	end
end

function CombatWeaponLogic.Owns(profile: PlayerProfile, weaponId: string): boolean
	return profile.Weapons ~= nil and profile.Weapons[weaponId] == true
end

function CombatWeaponLogic.WeaponDef(id: string): any?
	return WeaponConfig.Weapons[id]
end

function CombatWeaponLogic.ClampWeaponId(weaponId: any): string?
	if typeof(weaponId) ~= "string" then
		return nil
	end
	if #weaponId > 64 then
		return nil
	end
	if WeaponConfig.Weapons[weaponId] == nil then
		return nil
	end
	return weaponId
end

return CombatWeaponLogic
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataStore load/save with retries, autosave, PlayerRemoving, BindToClose,
	session lock, and versioned migrations. Never trusts client payloads.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local DevConfig = require(Shared.Configs.DevConfig)

local ProfileSchema = require(script.Parent.Parent.Modules.ProfileSchema)
local SessionLock = require(script.Parent.Parent.Modules.SessionLock)

type PlayerProfile = Types.PlayerProfile

local DataService = {}

local profiles: { [number]: PlayerProfile } = {}
local dirty: { [number]: boolean } = {}
local loading: { [number]: boolean } = {}
local dataStore: DataStore? = nil

local AnalyticsService: any = nil
local onProfileLoadedCallbacks: { (Player, PlayerProfile) -> () } = {}

local function getDataStore(): DataStore?
	if dataStore then
		return dataStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Constants.DataStoreName)
	end)
	if ok then
		dataStore = result
		return dataStore
	end
	warn("[DataService] DataStore unavailable (enable Studio API services for persistence):", result)
	return nil
end

local function keyFor(userId: number): string
	return "player_" .. tostring(userId)
end

local function retryAsync(label: string, fn: () -> any): (boolean, any)
	local lastErr = nil
	for attempt = 1, Constants.DataStoreRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(string.format("[DataService] %s attempt %d failed: %s", label, attempt, tostring(result)))
		task.wait(Constants.DataStoreRetryDelay * attempt)
	end
	return false, lastErr
end

function DataService.SetAnalytics(svc: any)
	AnalyticsService = svc
end

function DataService.OnProfileLoaded(cb: (Player, PlayerProfile) -> ())
	table.insert(onProfileLoadedCallbacks, cb)
	-- If profiles already loaded (init-order safety), fire immediately
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = profiles[player.UserId]
		if profile then
			task.spawn(cb, player, profile)
		end
	end
end

local function fireProfileLoaded(player: Player, profile: PlayerProfile)
	for _, cb in ipairs(onProfileLoadedCallbacks) do
		task.spawn(cb, player, profile)
	end
end

function DataService.GetProfile(player: Player): PlayerProfile?
	return profiles[player.UserId]
end

function DataService.MarkDirty(player: Player)
	if profiles[player.UserId] then
		dirty[player.UserId] = true
	end
end

function DataService.WaitForProfile(player: Player, timeout: number?): PlayerProfile?
	local t = timeout or 15
	local start = os.clock()
	while os.clock() - start < t do
		local p = profiles[player.UserId]
		if p then
			return p
		end
		if not player.Parent then
			return nil
		end
		task.wait(0.1)
	end
	return profiles[player.UserId]
end

local function applyStudioDevFlags(profile: PlayerProfile)
	if not RunService:IsStudio() then
		return
	end
	if DevConfig.StudioBoostCash then
		profile.Cash = math.max(profile.Cash, DevConfig.StudioBoostCashAmount)
	end
	if DevConfig.SkipTutorial then
		profile.TutorialComplete = true
	end
	if DevConfig.UnlockAllVehicles then
		local VehicleConfig = require(Shared.Configs.VehicleConfig)
		for id in pairs(VehicleConfig.Vehicles) do
			profile.Vehicles[id] = true
		end
	end
	if DevConfig.UnlockAllWeapons then
		local WeaponConfig = require(Shared.Configs.WeaponConfig)
		for id in pairs(WeaponConfig.Weapons) do
			profile.Weapons[id] = true
		end
	end
end

function DataService.LoadProfile(player: Player): PlayerProfile?
	local userId = player.UserId
	if profiles[userId] then
		return profiles[userId]
	end
	if loading[userId] then
		return DataService.WaitForProfile(player, 20)
	end
	loading[userId] = true

	local acquired, lockErr = SessionLock.TryAcquire(userId)
	if not acquired then
		warn("[DataService] Session lock failed for", userId, lockErr)
		if AnalyticsService then
			AnalyticsService.Log("SESSION_LOCK_CONFLICT", userId, { err = tostring(lockErr) })
		end
		-- Still allow play with default in Studio; kick in live if desired
		if not RunService:IsStudio() then
			loading[userId] = false
			player:Kick("Your data is loading in another server. Please rejoin in a moment.")
			return nil
		end
	end

	local profile: PlayerProfile
	local ds = getDataStore()
	if ds then
		local ok, raw = retryAsync("GetAsync", function()
			return ds:GetAsync(keyFor(userId))
		end)
		if ok and raw ~= nil then
			profile = ProfileSchema.Migrate(raw)
		else
			if not ok then
				warn("[DataService] Load failed, using defaults for", userId, raw)
			end
			profile = ProfileSchema.CreateDefault()
		end
	else
		profile = ProfileSchema.CreateDefault()
	end

	profile.LastJoinUnix = os.time()
	if profile.FirstJoinUnix == 0 or profile.FirstJoinUnix == nil then
		profile.FirstJoinUnix = os.time()
	end
	applyStudioDevFlags(profile)

	profiles[userId] = profile
	dirty[userId] = false
	loading[userId] = false

	fireProfileLoaded(player, profile)

	return profile
end

function DataService.SaveProfile(player: Player, releaseLock: boolean?): boolean
	local userId = player.UserId
	local profile = profiles[userId]
	if not profile then
		return false
	end

	local ds = getDataStore()
	if not ds then
		dirty[userId] = false
		if releaseLock then
			SessionLock.Release(userId)
		end
		return true -- nothing to persist
	end

	local snapshot = ProfileSchema.DeepCopy(profile)
	local ok, err = retryAsync("SetAsync", function()
		ds:SetAsync(keyFor(userId), snapshot)
	end)

	if ok then
		dirty[userId] = false
		SessionLock.Refresh(userId)
		if releaseLock then
			SessionLock.Release(userId)
		end
		return true
	end

	warn("[DataService] Save failed for", userId, err)
	if releaseLock then
		SessionLock.Release(userId)
	end
	return false
end

function DataService.UnloadProfile(player: Player)
	local userId = player.UserId
	DataService.SaveProfile(player, true)
	profiles[userId] = nil
	dirty[userId] = nil
	loading[userId] = nil
end

function DataService.Init()
	Players.PlayerAdded:Connect(function(player)
		DataService.LoadProfile(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.UnloadProfile(player)
	end)

	-- Late joiners already in game
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(DataService.LoadProfile, player)
	end

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(Constants.AutosaveIntervalSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				if dirty[player.UserId] and profiles[player.UserId] then
					DataService.SaveProfile(player, false)
				else
					SessionLock.Refresh(player.UserId)
				end
			end
		end
	end)

	game:BindToClose(function()
		local players = Players:GetPlayers()
		local remaining = #players
		if remaining == 0 then
			return
		end
		for _, player in ipairs(players) do
			task.spawn(function()
				DataService.SaveProfile(player, true)
				remaining -= 1
			end)
		end
		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Server-only currency mutations. Client never sets Cash/Gold.

	Cash multiplier stack order (AddCash, non-exempt reasons):
	  1. Base amount (caller)
	  2. Prestige: × (1 + Prestige * EconomyConfig.PrestigeCashMultiplierPerLevel)  -- +10%/rebirth
	  3. Monetization VIP/DoubleCash: × MonetizationService.GetCashMultiplier
	     (VIP additive +0.25 into a base of 1, then DoubleCash ×2)
	  4. Season: × SeasonService.GetCashMult()
	Exempt reasons (MonetizationConfig.CashMultExemptReasons) skip steps 3–4 only;
	prestige mult still applies unless reason is listed — currently prestige gold path
	uses AddGold; cash exempts (devproduct/admin/code/spinner/…) skip VIP/season only.
	Passive / worker training / capture stipend / combat kill rewards all use AddCash
	so prestige + VIP/2x + season stack consistently.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local Types = require(Shared.Types)

local EconomyService = {}

local SeasonService: any = nil

local DataService: any = nil
local RemoteSetup: any = nil
local MissionService: any = nil
local MonetizationService: any = nil
local TutorialService: any = nil

local function pushEconomy(player: Player, profile: Types.PlayerProfile)
	local remote = RemoteSetup.Get(Constants.RemoteNames.EconomyUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Cash = profile.Cash,
		Gold = profile.Gold,
	} :: Types.EconomyUpdatePayload)
end

function EconomyService.Init(deps: { [string]: any })
	SeasonService = deps.SeasonService
	DataService = deps.DataService
	RemoteSetup = deps.RemoteSetup
	MissionService = deps.MissionService
	MonetizationService = deps.MonetizationService
	TutorialService = deps.TutorialService
end

function EconomyService.Push(player: Player)
	local profile = DataService.GetProfile(player)
	if profile then
		pushEconomy(player, profile)
	end
end

function EconomyService.AddCash(player: Player, amount: number, reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end

	local mult = 1 + (profile.Prestige * (EconomyConfig.PrestigeCashMultiplierPerLevel or 0))
	local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
	local reasonKey = reason or ""
	local exempt = MonetizationConfig.CashMultExemptReasons
	if MonetizationService and MonetizationService.GetCashMultiplier and not (exempt and exempt[reasonKey]) then
		mult *= MonetizationService.GetCashMultiplier(player)
	end
	if SeasonService and SeasonService.GetCashMult and not (exempt and exempt[reasonKey]) then
		mult *= SeasonService.GetCashMult()
	end
	local granted = math.floor(amount * mult)
	profile.Cash = math.clamp(profile.Cash + granted, EconomyConfig.MinCash, EconomyConfig.MaxCash)
	profile.Stats.TotalCashEarned += granted
	DataService.MarkDirty(player)
	pushEconomy(player, profile)
	-- Feed daily EarnCash missions (skip recursive mission reward noise is fine)
	if MissionService and MissionService.TrackProgress and reason ~= "mission" and reason ~= "achievement" then
		MissionService.TrackProgress(player, "EarnCash", granted)
	end
	if reason == "passive" and TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "PassiveIncome")
	end
	return true
end

function EconomyService.SpendCash(player: Player, amount: number, _reason: string?): (boolean, string?)
	if typeof(amount) ~= "number" or amount ~= amount or amount < 0 then
		return false, "InvalidAmount"
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Cash < amount then
		return false, "InsufficientCash"
	end
	profile.Cash -= amount
	DataService.MarkDirty(player)
	pushEconomy(player, profile)
	return true, nil
end

function EconomyService.AddGold(player: Player, amount: number, _reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	profile.Gold = math.clamp(profile.Gold + amount, EconomyConfig.MinGold, EconomyConfig.MaxGold)
	profile.Stats.TotalGoldEarned += amount
	DataService.MarkDirty(player)
	pushEconomy(player, profile)
	return true
end

function EconomyService.SpendGold(player: Player, amount: number, _reason: string?): (boolean, string?)
	if typeof(amount) ~= "number" or amount ~= amount or amount < 0 then
		return false, "InvalidAmount"
	end
	amount = math.floor(amount)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Gold < amount then
		return false, "InsufficientGold"
	end
	profile.Gold -= amount
	DataService.MarkDirty(player)
	pushEconomy(player, profile)
	return true, nil
end

function EconomyService.GetCash(player: Player): number
	local profile = DataService.GetProfile(player)
	return if profile then profile.Cash else 0
end

function EconomyService.GetGold(player: Player): number
	local profile = DataService.GetProfile(player)
	return if profile then profile.Gold else 0
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">FallSafetyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	FallSafetyService — teleport to plot spawn instead of void-Kill when
	HumanoidRootPart falls below FALL_Y (e.g. off oil decks / past Ground).
	Does not replace collide floor / SafetyCatch; soft recovery layer.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local FallSafetyService = {}

local FALL_Y = -2
local COOLDOWN_SEC = 1.5

local BaseService: any = nil
local NotificationService: any = nil

local lastRescueAt: { [number]: number } = {}

local function rescue(player: Player, root: BasePart)
	local now = os.clock()
	local last = lastRescueAt[player.UserId] or 0
	if now - last < COOLDOWN_SEC then
		return
	end
	lastRescueAt[player.UserId] = now

	-- Stop downward velocity before teleport
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	if BaseService and BaseService.TeleportToPlot then
		BaseService.TeleportToPlot(player)
	else
		-- Fallback: origin above Ground
		local character = player.Character
		if character then
			character:PivotTo(CFrame.new(0, 8, 0))
		end
	end

	if NotificationService and NotificationService.Notify then
		NotificationService.Notify(player, "Rescued from fall — returned to base.", "Info", 3)
	end
end

function FallSafetyService.Init(deps: { [string]: any })
	BaseService = deps.BaseService
	NotificationService = deps.NotificationService

	-- Stepped heartbeat: cheap Y check only
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.1 then
			return
		end
		accum = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if not character then
				continue
			end
			local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end
			local hum = character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health <= 0 then
				continue
			end
			if root.Position.Y < FALL_Y then
				rescue(player, root)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastRescueAt[player.UserId] = nil
	end)

	print("[WAR EMPIRE] FallSafetyService ready (teleport if Y < " .. tostring(FALL_Y) .. ")")
end

return FallSafetyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">MissionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 6 — Daily missions, timed missions, daily login rewards, achievements.
]]


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local MissionConfig = require(Shared.Configs.MissionConfig)
local DailyRewardConfig = require(Shared.Configs.DailyRewardConfig)
local AchievementConfig = require(Shared.Configs.AchievementConfig)
local DailyOpsConfig = require(Shared.Configs.DailyOpsConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local MissionService = {}

local DataService: any = nil
local EconomyService: any = nil
local XPService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local NotificationService: any = nil
local TerritoryService: any = nil

local function yyyymmdd(unix: number): number
	local t = os.date("!*t", unix)
	return t.year * 10000 + t.month * 100 + t.day
end

local function ensureDaily(profile: Types.PlayerProfile)
	if typeof(profile.DailyMissions) ~= "table" then
		profile.DailyMissions = {
			DayKey = 0,
			Progress = {},
			Claimed = {},
			ActiveTimed = {},
		}
	end
	local dm = profile.DailyMissions
	if typeof(dm.Progress) ~= "table" then
		dm.Progress = {}
	end
	if typeof(dm.Claimed) ~= "table" then
		dm.Claimed = {}
	end
	if typeof(dm.ActiveTimed) ~= "table" then
		dm.ActiveTimed = {}
	end

	local today = yyyymmdd(os.time())
	if MissionConfig.RefreshOnUtcDayChange and dm.DayKey ~= today then
		dm.DayKey = today
		dm.Progress = {}
		dm.Claimed = {}
		-- Keep ActiveTimed; they can finish across midnight
	end
end

local function dailyOpDefs(): { [string]: any }
	local map: { [string]: any } = {}
	if DailyOpsConfig.Enabled then
		for _, op in ipairs(DailyOpsConfig.Ops) do
			map[op.Id] = op
		end
	end
	return map
end

local function resolveMissionDef(id: string): any?
	local ops = dailyOpDefs()
	if ops[id] then
		return ops[id]
	end
	return MissionConfig.DailyMissions[id]
end

local function activeDailyIds(profile: Types.PlayerProfile): { string }
	local list: { string } = {}
	local level = profile.Level or 1
	local seen: { [string]: boolean } = {}
	-- Daily Ops first (3 rotating MT-style gold ops)
	if DailyOpsConfig.Enabled then
		for _, op in ipairs(DailyOpsConfig.Ops) do
			if level >= (op.MinLevel or 1) and not seen[op.Id] then
				table.insert(list, op.Id)
				seen[op.Id] = true
			end
		end
	end
	for _, id in ipairs(MissionConfig.DailyMissionOrder) do
		local def = MissionConfig.DailyMissions[id]
		if def and level >= def.MinLevel and not seen[id] then
			table.insert(list, id)
			seen[id] = true
			if #list >= (MissionConfig.MaxActiveDaily or 6) then
				break
			end
		end
	end
	return list
end

function MissionService.Push(player: Player)
	if not DataService or not RemoteSetup then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureDaily(profile)

	local dailyPayload: { Types.MissionEntryPayload } = {}
	for _, id in ipairs(activeDailyIds(profile)) do
		local def = resolveMissionDef(id)
		if def then
			local progress = profile.DailyMissions.Progress[id] or 0
			local claimed = profile.DailyMissions.Claimed[id] == true
			local complete = progress >= def.Target
			table.insert(dailyPayload, {
				Id = def.Id,
				DisplayName = def.DisplayName,
				Description = def.Description,
				ObjectiveType = def.ObjectiveType,
				Progress = math.min(progress, def.Target),
				Target = def.Target,
				Claimed = claimed,
				Complete = complete,
				RewardCash = def.RewardCash,
				RewardXP = def.RewardXP,
				RewardGold = def.RewardGold or 0,
			})
		end
	end

	local today = yyyymmdd(os.time())
	local already = profile.DailyLogin.LastClaimDay == today

	local payload: Types.MissionStatePayload = {
		DayKey = profile.DailyMissions.DayKey,
		Daily = dailyPayload,
		DailyLogin = {
			Streak = profile.DailyLogin.Streak,
			CanClaim = not already,
			NextDay = if already then profile.DailyLogin.Streak else (profile.DailyLogin.Streak % DailyRewardConfig.StreakResetsAfterDay) + 1,
			AlreadyClaimedToday = already,
		},
	}

	local remote = RemoteSetup.Get(Constants.RemoteNames.MissionStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

function MissionService.GrantAchievement(player: Player, achievementId: string): boolean
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	if typeof(profile.Achievements) ~= "table" then
		profile.Achievements = {}
	end
	if profile.Achievements[achievementId] then
		return false
	end
	local def = AchievementConfig.Achievements[achievementId]
	if not def then
		return false
	end

	profile.Achievements[achievementId] = true
	if def.RewardCash and def.RewardCash > 0 then
		EconomyService.AddCash(player, def.RewardCash, "achievement")
	end
	if def.RewardGold and def.RewardGold > 0 then
		EconomyService.AddGold(player, def.RewardGold, "achievement")
	end
	if def.RewardXP and def.RewardXP > 0 then
		XPService.AddXP(player, def.RewardXP, "achievement")
	end
	DataService.MarkDirty(player)

	if NotificationService then
		NotificationService.Notify(player, "Achievement: " .. def.DisplayName, "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.ACHIEVEMENT_UNLOCKED, player.UserId, {
			id = achievementId,
		})
	end
	return true
end

function MissionService.CheckAchievements(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.Stats.UpgradesPurchased >= 1 then
		MissionService.GrantAchievement(player, "FirstUpgrade")
	end
	if profile.Stats.TotalCashEarned >= 10000 then
		MissionService.GrantAchievement(player, "Cash10k")
	end
	if profile.Level >= 10 then
		MissionService.GrantAchievement(player, "Level10")
	end
end

function MissionService.TrackProgress(player: Player, objectiveType: string, amount: number)
	if not DataService then
		return
	end
	if typeof(objectiveType) ~= "string" or typeof(amount) ~= "number" or amount <= 0 then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureDaily(profile)

	local changed = false
	for _, id in ipairs(activeDailyIds(profile)) do
		local def = resolveMissionDef(id)
		if def and def.ObjectiveType == objectiveType then
			local claimed = profile.DailyMissions.Claimed[id] == true
			local prev = profile.DailyMissions.Progress[id] or 0
			if not claimed and prev < def.Target then
				local nextVal = math.min(def.Target, prev + amount)
				profile.DailyMissions.Progress[id] = nextVal
				changed = true
				if AnalyticsService and nextVal >= def.Target and prev < def.Target then
					AnalyticsService.Log(AnalyticsConfig.Events.MISSION_PROGRESS, player.UserId, {
						mission = id,
						complete = true,
					})
					if NotificationService then
						NotificationService.Notify(player, def.DisplayName .. " complete — claim reward!", "Info")
					end
				end
			end
		end
	end

	if changed then
		DataService.MarkDirty(player)
		MissionService.Push(player)
	end

	MissionService.CheckAchievements(player)
end

function MissionService.ClaimDailyMission(player: Player, missionId: string): (boolean, string?)
	if not RemoteGuard.IsIdString(missionId, 48) then
		return false, "InvalidMission"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureDaily(profile)

	local def = resolveMissionDef(missionId)
	if not def then
		return false, "UnknownMission"
	end
	if profile.DailyMissions.Claimed[missionId] then
		return false, "AlreadyClaimed"
	end
	local progress = profile.DailyMissions.Progress[missionId] or 0
	if progress < def.Target then
		return false, "Incomplete"
	end

	profile.DailyMissions.Claimed[missionId] = true
	profile.Stats.MissionsCompleted += 1

	local cash = def.RewardCash
	if TerritoryService and TerritoryService.GetMissionCashMult then
		cash = math.floor(cash * TerritoryService.GetMissionCashMult(player))
	end
	if cash > 0 then
		EconomyService.AddCash(player, cash, "mission")
	end
	if (def.RewardGold or 0) > 0 then
		EconomyService.AddGold(player, def.RewardGold :: number, "mission")
	end
	if def.RewardXP > 0 then
		XPService.AddXP(player, def.RewardXP, "mission")
	end

	DataService.MarkDirty(player)
	if NotificationService then
		NotificationService.Notify(player, string.format("Mission reward: $%d", cash), "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.MISSION_CLAIMED, player.UserId, {
			mission = missionId,
			cash = cash,
		})
	end
	MissionService.Push(player)
	return true, nil
end

function MissionService.ClaimDailyLogin(player: Player): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local today = yyyymmdd(os.time())
	local daily = profile.DailyLogin
	if daily.LastClaimDay == today then
		if NotificationService then
			NotificationService.Notify(player, "Daily reward already claimed.", "Warn")
		end
		return false, "AlreadyClaimed"
	end

	local yesterday = yyyymmdd(os.time() - 86400)
	if DailyRewardConfig.MissedDayResetsStreak and daily.LastClaimDay ~= 0 and daily.LastClaimDay ~= yesterday then
		daily.Streak = 0
	end

	daily.Streak = (daily.Streak % DailyRewardConfig.StreakResetsAfterDay) + 1
	daily.LastClaimDay = today
	daily.LastClaimUnix = os.time()

	local reward = DailyRewardConfig.Rewards[daily.Streak]
	if reward then
		if reward.Cash > 0 then
			EconomyService.AddCash(player, reward.Cash, "daily")
		end
		if reward.Gold > 0 then
			EconomyService.AddGold(player, reward.Gold, "daily")
		end
		if reward.XP > 0 then
			XPService.AddXP(player, reward.XP, "daily")
		end
		if NotificationService then
			NotificationService.Notify(
				player,
				string.format("Day %d reward: $%d", daily.Streak, reward.Cash),
				"Reward"
			)
		end
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.DAILY_REWARD_CLAIMED, player.UserId, { day = daily.Streak })
		end
	end
	DataService.MarkDirty(player)
	MissionService.Push(player)
	return true, nil
end

function MissionService.Start(player: Player, missionId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(missionId, 48) then
		return false, "InvalidMission"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureDaily(profile)

	local def = MissionConfig.Missions[missionId]
	if not def then
		return false, "UnknownMission"
	end
	if profile.Level < def.MinLevel then
		return false, "LevelTooLow"
	end
	if profile.DailyMissions.ActiveTimed[missionId] and profile.DailyMissions.ActiveTimed[missionId] > os.time() then
		return false, "AlreadyActive"
	end

	profile.DailyMissions.ActiveTimed[missionId] = os.time() + def.DurationSeconds
	DataService.MarkDirty(player)
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format("%s started (%ds)", def.DisplayName, def.DurationSeconds),
			"Info"
		)
	end

	-- Auto-complete after duration (MVP: timer-based, no world objectives)
	task.delay(def.DurationSeconds, function()
		if not player.Parent then
			return
		end
		local p = DataService.GetProfile(player)
		if not p then
			return
		end
		ensureDaily(p)
		local ends = p.DailyMissions.ActiveTimed[missionId]
		if not ends or ends > os.time() + 1 then
			return
		end
		p.DailyMissions.ActiveTimed[missionId] = nil
		MissionService.Complete(player, missionId)
	end)

	MissionService.Push(player)
	return true, nil
end

function MissionService.Complete(player: Player, missionId: string)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local def = MissionConfig.Missions[missionId]
	if not def then
		return
	end

	profile.Stats.MissionsCompleted += 1
	local cash = def.RewardCash
	if TerritoryService and TerritoryService.GetMissionCashMult then
		cash = math.floor(cash * TerritoryService.GetMissionCashMult(player))
	end
	if cash > 0 then
		EconomyService.AddCash(player, cash, "timed_mission")
	end
	if def.RewardXP > 0 then
		XPService.AddXP(player, def.RewardXP, "timed_mission")
	end
	DataService.MarkDirty(player)
	if NotificationService then
		NotificationService.Notify(player, string.format("%s complete! +$%d", def.DisplayName, cash), "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.MISSION_CLAIMED, player.UserId, {
			mission = missionId,
			timed = true,
			cash = cash,
		})
	end
	MissionService.Push(player)
end

function MissionService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	NotificationService = deps.NotificationService
	TerritoryService = deps.TerritoryService

	local startRemote = RemoteSetup.Get(Constants.RemoteNames.RequestStartMission) :: RemoteEvent
	startRemote.OnServerEvent:Connect(function(player: Player, missionId: any)
		if not RateLimitService.Allow(player, "start_mission", 1, 2) then
			return
		end
		MissionService.Start(player, missionId)
	end)

	local claimRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimMission) :: RemoteEvent
	claimRemote.OnServerEvent:Connect(function(player: Player, missionId: any)
		if not RateLimitService.Allow(player, "claim_mission", 2, 3) then
			return
		end
		MissionService.ClaimDailyMission(player, missionId)
	end)

	local dailyRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimDailyReward) :: RemoteEvent
	dailyRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "daily_reward", 1, 2) then
			return
		end
		MissionService.ClaimDailyLogin(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		ensureDaily(_profile)
		MissionService.CheckAchievements(player)
		MissionService.Push(player)
	end)
end

return MissionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 7 — Monetization MVP
	- ProcessReceipt: idempotent DevProduct grants from MonetizationConfig only
	- GamePass ownership cached on join (MarketplaceService:UserOwnsGamePassAsync)
	- VIP / 2x Cash / 2x XP multipliers for EconomyService / XPService
	- NEVER grant currency from client purchase confirmation alone
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local DevConfig = require(Shared.Configs.DevConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local MonetizationService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local BattlePassService: any = nil

-- Session receipt cache; also mirrored to profile.ProcessedReceipts
local processed: { [string]: boolean } = {}
-- userId -> passKey -> owned
local gamePassCache: { [number]: { [string]: boolean } } = {}

local function findDevProduct(productId: number): (string?, any?)
	if typeof(productId) ~= "number" or productId == 0 then
		return nil, nil
	end
	for key, def in pairs(MonetizationConfig.DevProducts) do
		if def.Id ~= 0 and def.Id == productId then
			return key, def
		end
	end
	return nil, nil
end

local function findDevProductByKey(key: string): any?
	return MonetizationConfig.DevProducts[key]
end

local function findGamePassByKey(key: string): any?
	return MonetizationConfig.GamePasses[key]
end

local function hasProcessed(profile: any, receiptId: string): boolean
	if processed[receiptId] then
		return true
	end
	if typeof(profile) == "table" and typeof(profile.ProcessedReceipts) == "table" then
		return profile.ProcessedReceipts[receiptId] == true
	end
	return false
end

local function markProcessed(profile: any, receiptId: string)
	processed[receiptId] = true
	if typeof(profile) == "table" then
		if typeof(profile.ProcessedReceipts) ~= "table" then
			profile.ProcessedReceipts = {}
		end
		profile.ProcessedReceipts[receiptId] = true
	end
end

local function mockOwns(passKey: string): boolean
	if not RunService:IsStudio() then
		return false
	end
	local mock = DevConfig.MockOwnedGamePasses
	return typeof(mock) == "table" and mock[passKey] == true
end

function MonetizationService.RefreshGamePassCache(player: Player)
	local userId = player.UserId
	local cache: { [string]: boolean } = {}
	for passKey, def in pairs(MonetizationConfig.GamePasses) do
		local owned = false
		if typeof(def.Id) == "number" and def.Id ~= 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(userId, def.Id)
			end)
			if ok and result == true then
				owned = true
			elseif not ok then
				warn("[MonetizationService] UserOwnsGamePassAsync failed", passKey, result)
			end
		elseif mockOwns(passKey) then
			owned = true
		end
		cache[passKey] = owned
	end
	gamePassCache[userId] = cache
	return cache
end

function MonetizationService.PlayerOwnsGamePass(player: Player, passKey: string): boolean
	local cache = gamePassCache[player.UserId]
	if not cache then
		cache = MonetizationService.RefreshGamePassCache(player)
	end
	return cache[passKey] == true
end

function MonetizationService.SetMockGamePassOwned(player: Player, passKey: string, owned: boolean)
	if not RunService:IsStudio() then
		return
	end
	if not findGamePassByKey(passKey) then
		return
	end
	local cache = gamePassCache[player.UserId]
	if not cache then
		cache = {}
		gamePassCache[player.UserId] = cache
	end
	cache[passKey] = owned
end

--[[ Cash multiplier from VIP (additive bonus) + DoubleCash (multiplicative). ]]
function MonetizationService.GetCashMultiplier(player: Player): number
	local mult = 1
	local vip = MonetizationConfig.GamePasses.VIP
	if vip and MonetizationService.PlayerOwnsGamePass(player, "VIP") then
		local bonus = tonumber(vip.CashBonusMult) or 0
		mult += bonus
	end
	local doubleCash = MonetizationConfig.GamePasses.DoubleCash
	if doubleCash and MonetizationService.PlayerOwnsGamePass(player, "DoubleCash") then
		local m = tonumber(doubleCash.CashMult) or 2
		mult *= m
	end
	return math.max(0, mult)
end

function MonetizationService.GetXPMultiplier(player: Player): number
	local doubleXP = MonetizationConfig.GamePasses.DoubleXP
	if doubleXP and MonetizationService.PlayerOwnsGamePass(player, "DoubleXP") then
		return math.max(1, tonumber(doubleXP.XPMult) or 2)
	end
	return 1
end

function MonetizationService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	BattlePassService = deps.BattlePassService

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		return MonetizationService.ProcessReceipt(receiptInfo)
	end

	-- Client may fire to log intent; grants still ONLY happen in ProcessReceipt
	local shopRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseDevProduct) :: RemoteEvent
	shopRemote.OnServerEvent:Connect(function(player: Player, productKey: any)
		if not RateLimitService.Allow(player, "shop_prompt", 2, 3) then
			return
		end
		-- Intent-only: never grants currency. Still validate + require profile loaded.
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsKeyString(productKey) then
			return
		end
		local def = findDevProductByKey(productKey :: string)
		if not def then
			return
		end
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.SHOP_PROMPT, player.UserId, {
				kind = "DevProduct",
				key = productKey,
				productId = def.Id,
			})
		end
		if def.Id == 0 and NotificationService then
			NotificationService.Notify(player, "Shop item not configured (placeholder ID).", "Warn")
		end
		-- Do NOT grant here. Client prompts Marketplace; ProcessReceipt grants.
	end)

	local passRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseGamePass) :: RemoteEvent
	passRemote.OnServerEvent:Connect(function(player: Player, passKey: any)
		if not RateLimitService.Allow(player, "shop_pass_prompt", 2, 3) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsKeyString(passKey) then
			return
		end
		local def = findGamePassByKey(passKey :: string)
		if not def then
			return
		end
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.SHOP_PROMPT, player.UserId, {
				kind = "GamePass",
				key = passKey,
				productId = def.Id,
			})
		end
		if def.Id == 0 and NotificationService then
			NotificationService.Notify(player, "GamePass not configured (placeholder ID).", "Warn")
		end
		-- Do NOT grant benefits from this remote — ownership cache only.
	end)

	-- Refresh ownership when Roblox reports a GamePass purchase finished (client signal is untrusted for grants)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, wasPurchased: boolean)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return
		end
		-- Always refresh cache; never grant Cash/Gold/XP from wasPurchased alone
		MonetizationService.RefreshGamePassCache(player)
		if wasPurchased and NotificationService then
			local name = "Game Pass"
			for key, def in pairs(MonetizationConfig.GamePasses) do
				if def.Id ~= 0 and def.Id == passId then
					name = def.DisplayName or key
					break
				end
			end
			NotificationService.Notify(player, "Owned: " .. name .. " (benefits active)", "Success")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		task.spawn(function()
			MonetizationService.RefreshGamePassCache(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		gamePassCache[player.UserId] = nil
	end)
end

function MonetizationService.ProcessReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local receiptId = tostring(receiptInfo.PurchaseId)

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local profile = DataService.WaitForProfile(player, 10)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if hasProcessed(profile, receiptId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local productKey, product = findDevProduct(receiptInfo.ProductId)
	if not product then
		-- Unknown / placeholder Id: do not invent grants. Mark processed so Roblox queue drains.
		warn("[MonetizationService] Unknown or unconfigured product", receiptInfo.ProductId)
		markProcessed(profile, receiptId)
		DataService.MarkDirty(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	if product.Cash and product.Cash > 0 then
		EconomyService.AddCash(player, product.Cash, "devproduct")
	end
	if product.Gold and product.Gold > 0 then
		EconomyService.AddGold(player, product.Gold, "devproduct")
	end
	-- Battle Pass Premium: server-only via ProcessReceipt (never client confirmation)
	if product.GrantsBattlePassPremium == true and BattlePassService and BattlePassService.SetPremium then
		BattlePassService.SetPremium(player, true)
	end

	markProcessed(profile, receiptId)
	DataService.MarkDirty(player)

	if NotificationService then
		NotificationService.Notify(player, "Purchase granted: " .. (product.DisplayName or productKey or "item"), "Reward")
	end

	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.PURCHASE_RECEIPT, player.UserId, {
			productId = receiptInfo.ProductId,
			productKey = productKey,
			receiptId = receiptId,
		})
	end

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">NationColorService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Assigns a nation color on join / first spawn for captured flag tinting.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local NationColorConfig = require(Shared.Configs.NationColorConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local NationColorService = {}

local DataService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local NotificationService: any = nil

local colorByUserId: { [number]: Color3 } = {}
local idByUserId: { [number]: string } = {}

local function findDef(id: string)
	for _, def in ipairs(NationColorConfig.Colors) do
		if def.Id == id then
			return def
		end
	end
	return nil
end

local function pickForUser(userId: number): string
	local roster = NationColorConfig.Colors
	if #roster == 0 then
		return "Crimson"
	end
	-- Stable-ish assignment from userId so rejoins match without profile
	local idx = (math.abs(userId) % #roster) + 1
	return roster[idx].Id
end

local function push(player: Player, colorId: string)
	local def = findDef(colorId)
	local color = if def then def.Color else Color3.fromRGB(200, 45, 55)
	colorByUserId[player.UserId] = color
	idByUserId[player.UserId] = colorId
	local remote = RemoteSetup.Get(Constants.RemoteNames.NationColorUpdate) :: RemoteEvent
	remote:FireClient(player, {
		NationColorId = colorId,
		DisplayName = if def then def.DisplayName else colorId,
		Color = { R = color.R, G = color.G, B = color.B },
	})
end

function NationColorService.GetColor(userId: number): Color3?
	return colorByUserId[userId]
end

function NationColorService.GetColorId(userId: number): string?
	return idByUserId[userId]
end

function NationColorService.EnsureAssigned(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local id = profile.NationColorId
	if typeof(id) ~= "string" or not findDef(id) then
		id = pickForUser(player.UserId)
		profile.NationColorId = id
		DataService.MarkDirty(player)
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.NATION_COLOR_ASSIGN, player.UserId, { color = id })
		end
		if NotificationService then
			local def = findDef(id)
			NotificationService.Notify(
				player,
				"Nation color: " .. (if def then def.DisplayName else id),
				"Info"
			)
		end
	end
	push(player, id :: string)
end

function NationColorService.Init(deps: { [string]: any })
	DataService = deps.DataService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	NotificationService = deps.NotificationService

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		NationColorService.EnsureAssigned(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		colorByUserId[player.UserId] = nil
		idByUserId[player.UserId] = nil
	end)
end

return NationColorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">NotificationService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared").Constants)

local NotificationService = {}

local RemoteSetup: any = nil

function NotificationService.Init(deps: { [string]: any })
	RemoteSetup = deps.RemoteSetup
end

function NotificationService.Notify(player: Player, message: string, notifType: string?, duration: number?)
	local remote = RemoteSetup.Get(Constants.RemoteNames.Notification) :: RemoteEvent
	remote:FireClient(player, {
		Message = message,
		Type = notifType or "Info",
		Duration = duration or 4,
	})
end

function NotificationService.NotifyAll(message: string, notifType: string?)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		NotificationService.Notify(player, message, notifType)
	end
end

return NotificationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">PrestigeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Prestige / Rebirth — server-authoritative.
	Each prestige: permanent +10% cash earnings (EconomyConfig.PrestigeCashMultiplierPerLevel).
	RebirthUnlocks from PrestigeConfig applied into profile.RebirthUnlocks (+ optional vehicle/weapon grants).
	Alias: DoRebirth == DoPrestige.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local PrestigeConfig = require(Shared.Configs.PrestigeConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local PrestigeService = {}

local DataService: any = nil
local EconomyService: any = nil
local XPService: any = nil
local BaseService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil
local VehicleService: any = nil

local function cashBonusPer(): number
	return PrestigeConfig.CashBonusPerPrestige
		or EconomyConfig.PrestigeCashMultiplierPerLevel
		or 0.10
end

local function unlockListFor(prestige: number): { any }
	local list = {}
	for _, u in ipairs(PrestigeConfig.RebirthUnlocks or {}) do
		table.insert(list, {
			AtPrestige = u.AtPrestige,
			Flag = u.Flag,
			DisplayName = u.DisplayName,
			Kind = u.Kind,
			Id = u.Id,
			Unlocked = prestige >= u.AtPrestige,
		})
	end
	return list
end

local function applyUnlocks(player: Player, profile: any, newPrestige: number)
	if typeof(profile.RebirthUnlocks) ~= "table" then
		profile.RebirthUnlocks = {}
	end
	local newly: { string } = {}
	for _, u in ipairs(PrestigeConfig.RebirthUnlocks or {}) do
		if newPrestige >= u.AtPrestige and not profile.RebirthUnlocks[u.Flag] then
			profile.RebirthUnlocks[u.Flag] = true
			table.insert(newly, u.DisplayName or u.Flag)
			if u.GrantOwned and typeof(u.Id) == "string" then
				if u.Kind == "Vehicle" then
					profile.Vehicles[u.Id] = true
					if VehicleService and VehicleService.GrantVehicle then
						-- GrantVehicle marks dirty + push; safe even if already owned
						VehicleService.GrantVehicle(player, u.Id)
					end
				elseif u.Kind == "Weapon" then
					profile.Weapons[u.Id] = true
				end
			end
		end
	end
	return newly
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local bonus = cashBonusPer()
	local nextMultPct = math.floor((profile.Prestige + 1) * bonus * 100)
	local curMultPct = math.floor(profile.Prestige * bonus * 100)
	local remote = RemoteSetup.Get(Constants.RemoteNames.PrestigeStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Prestige = profile.Prestige,
		CanPrestige = PrestigeService.CanPrestige(player),
		MinLevel = PrestigeConfig.MinLevelToPrestige,
		MaxPrestige = PrestigeConfig.MaxPrestige,
		CashBonusPerLevel = bonus,
		CashMultPercent = curMultPct,
		NextCashMultPercent = nextMultPct,
		GoldBonusOnPrestige = PrestigeConfig.GoldBonusOnPrestige,
		RebirthUnlocks = profile.RebirthUnlocks or {},
		UnlockTrack = unlockListFor(profile.Prestige),
	})
end

function PrestigeService.CanPrestige(player: Player): boolean
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	return profile.Level >= PrestigeConfig.MinLevelToPrestige and profile.Prestige < PrestigeConfig.MaxPrestige
end

function PrestigeService.HasUnlock(player: Player, flag: string): boolean
	local profile = DataService.GetProfile(player)
	if not profile or typeof(profile.RebirthUnlocks) ~= "table" then
		return false
	end
	return profile.RebirthUnlocks[flag] == true
end

function PrestigeService.DoPrestige(player: Player): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Prestige >= PrestigeConfig.MaxPrestige then
		return false, "MaxPrestige"
	end
	if profile.Level < PrestigeConfig.MinLevelToPrestige then
		return false, "LevelTooLow"
	end

	local reset = PrestigeConfig.ResetOnPrestige
	profile.Prestige += 1

	if reset.Cash then
		profile.Cash = PrestigeConfig.StartingCashAfterPrestige
	end
	if reset.Level then
		profile.Level = 1
	end
	if reset.XP then
		profile.XP = 0
	end
	if reset.BaseUpgrades then
		for id in pairs(BaseConfig.Structures) do
			profile.BaseUpgrades[id] = 0
		end
	end
	-- Vehicles / Weapons / Gold / RebirthUnlocks kept per Keep* flags

	local newly = applyUnlocks(player, profile, profile.Prestige)

	DataService.MarkDirty(player)

	if PrestigeConfig.GoldBonusOnPrestige > 0 then
		EconomyService.AddGold(player, PrestigeConfig.GoldBonusOnPrestige, "prestige")
	end

	if EconomyService.Push then
		EconomyService.Push(player)
	end
	if XPService and XPService.Push then
		XPService.Push(player)
	end
	if BaseService and BaseService.PushState then
		BaseService.PushState(player)
		if BaseService.RefreshAllVisuals then
			BaseService.RefreshAllVisuals(player)
		end
	end

	pushState(player)

	local bonusPct = math.floor(profile.Prestige * cashBonusPer() * 100)
	local unlockNote = if #newly > 0 then (" Unlocked: " .. table.concat(newly, ", ") .. ".") else ""
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format(
				"Rebirth P%d! +%d Gold. Cash earnings +%d%%%s",
				profile.Prestige,
				PrestigeConfig.GoldBonusOnPrestige,
				bonusPct,
				unlockNote
			),
			"Success",
			7
		)
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(AnalyticsConfig.Events.PRESTIGE or "PRESTIGE", player.UserId, {
			prestige = profile.Prestige,
			unlocks = newly,
		})
	end

	return true, nil
end

-- Alias for MT-inspired "rebirth" wording
function PrestigeService.DoRebirth(player: Player): (boolean, string?)
	return PrestigeService.DoPrestige(player)
end

function PrestigeService.Push(player: Player)
	pushState(player)
end

function PrestigeService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	BaseService = deps.BaseService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService
	VehicleService = deps.VehicleService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestPrestige) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "prestige", 1, 2) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "prestige_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = PrestigeService.DoPrestige(player)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Cannot prestige: " .. tostring(err), "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.RebirthUnlocks) ~= "table" then
			profile.RebirthUnlocks = {}
			DataService.MarkDirty(player)
		end
		-- Re-apply unlock flags for current prestige (idempotent) in case config grew
		applyUnlocks(player, profile, profile.Prestige or 0)
		pushState(player)
	end)
end

return PrestigeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">RateLimitService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Per-player remote rate limiting ]]

local RateLimitService = {}

type Bucket = { tokens: number, lastRefill: number }

local buckets: { [number]: { [string]: Bucket } } = {}
local DEFAULT_RATE = 8 -- tokens per second
local DEFAULT_BURST = 12

function RateLimitService.Init()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

local function getBucket(userId: number, key: string, rate: number, burst: number): Bucket
	if not buckets[userId] then
		buckets[userId] = {}
	end
	local userBuckets = buckets[userId]
	local b = userBuckets[key]
	if not b then
		b = { tokens = burst, lastRefill = os.clock() }
		userBuckets[key] = b
	end
	local now = os.clock()
	local elapsed = now - b.lastRefill
	b.tokens = math.min(burst, b.tokens + elapsed * rate)
	b.lastRefill = now
	return b
end

function RateLimitService.Allow(player: Player, key: string, rate: number?, burst: number?): boolean
	local r = rate or DEFAULT_RATE
	local burstAmt = burst or DEFAULT_BURST
	local b = getBucket(player.UserId, key, r, burstAmt)
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

return RateLimitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">SeasonService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Season state — active season id, XP/Cash bonuses, persisted end override.
	DataStore WarEmpire_Season_v1 with Studio in-memory fallback.
	Bonuses applied via GetXPMult / GetCashMult; never client-granted.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local SeasonService = {}

local SEASON_STORE_NAME = "WarEmpire_Season_v1"
local STATE_KEY = "season_state_v1"

local DataService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil

local endedOverride = SeasonConfig.Ended == true
local endedUnix = 0
local endedReason = ""
local persisted = false
local seasonStore: DataStore? = nil
local dataStoreAvailable = false
local loaded = false

local function getStore(): DataStore?
	if seasonStore then
		return seasonStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(SEASON_STORE_NAME)
	end)
	if ok then
		seasonStore = result
		dataStoreAvailable = true
		return seasonStore
	end
	dataStoreAvailable = false
	warn("[SeasonService] DataStore unavailable — session-only season end state.", result)
	return nil
end

local function configWindowActive(): boolean
	local now = os.time()
	local startUnix = tonumber(SeasonConfig.StartUnix) or 0
	local endUnix = tonumber(SeasonConfig.EndUnix) or 0
	if startUnix > 0 and now < startUnix then
		return false
	end
	if endUnix > 0 and now > endUnix then
		return false
	end
	return SeasonConfig.Ended ~= true
end

local function isActive(): boolean
	if endedOverride then
		return false
	end
	return configWindowActive()
end

local function persistState()
	local store = getStore()
	if not store then
		persisted = false
		return
	end
	local payload = {
		SeasonId = SeasonConfig.CurrentSeasonId,
		EndedOverride = endedOverride,
		EndedUnix = endedUnix,
		EndedReason = endedReason,
	}
	local ok, err = pcall(function()
		store:SetAsync(STATE_KEY, payload)
	end)
	if not ok then
		warn("[SeasonService] persist failed:", err)
		persisted = false
		return
	end
	persisted = true
end

local function loadState()
	if loaded then
		return
	end
	loaded = true
	local store = getStore()
	if not store then
		return
	end
	local ok, data = pcall(function()
		return store:GetAsync(STATE_KEY)
	end)
	if not ok or typeof(data) ~= "table" then
		return
	end
	-- Only apply override if it matches current season id (new seasons reset)
	if data.SeasonId == SeasonConfig.CurrentSeasonId and data.EndedOverride == true then
		endedOverride = true
		endedUnix = tonumber(data.EndedUnix) or 0
		endedReason = tostring(data.EndedReason or "persisted")
		persisted = true
	elseif data.SeasonId ~= SeasonConfig.CurrentSeasonId then
		-- New season config: clear stale end flag in store
		endedOverride = SeasonConfig.Ended == true
		endedUnix = 0
		endedReason = ""
		persistState()
	end
end

local function buildPayload(): { [string]: any }
	local active = isActive()
	return {
		SeasonId = SeasonConfig.CurrentSeasonId,
		DisplayName = SeasonConfig.DisplayName,
		Active = active,
		Ended = not active,
		XPBonusMult = if active then (SeasonConfig.XPBonusMult or 1) else 1,
		CashBonusMult = if active then (SeasonConfig.CashBonusMult or 1) else 1,
		StartUnix = SeasonConfig.StartUnix,
		EndUnix = SeasonConfig.EndUnix,
		EndedUnix = endedUnix,
		Persisted = persisted or dataStoreAvailable,
	}
end

local function pushState(player: Player)
	local remote = RemoteSetup.Get(Constants.RemoteNames.SeasonStateUpdate) :: RemoteEvent
	remote:FireClient(player, buildPayload())
end

local function pushAll()
	for _, player in ipairs(Players:GetPlayers()) do
		pushState(player)
	end
end

function SeasonService.GetSeasonId(): string
	return SeasonConfig.CurrentSeasonId
end

function SeasonService.IsActive(): boolean
	return isActive()
end

function SeasonService.GetXPMult(): number
	if not isActive() then
		return 1
	end
	return tonumber(SeasonConfig.XPBonusMult) or 1
end

function SeasonService.GetCashMult(): number
	if not isActive() then
		return 1
	end
	return tonumber(SeasonConfig.CashBonusMult) or 1
end

--[[ End season for this place: clears bonuses, persists across servers when API services on. ]]
function SeasonService.EndSeason(reason: string?)
	if endedOverride and not isActive() then
		-- Already ended
		pushAll()
		return
	end
	endedOverride = true
	endedUnix = os.time()
	endedReason = reason or "manual"
	persistState()

	local eventName = if AnalyticsConfig.Events.SEASON_END then AnalyticsConfig.Events.SEASON_END else "SEASON_END"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, 0, {
			seasonId = SeasonConfig.CurrentSeasonId,
			reason = endedReason,
			persisted = persisted,
		})
	end
	if NotificationService then
		NotificationService.NotifyAll(
			string.format("Season ended: %s — bonuses cleared.", tostring(SeasonConfig.DisplayName)),
			"Info"
		)
	end
	pushAll()
end

--[[ Clear end override (admin / new season tooling). ]]
function SeasonService.ClearEndOverride(reason: string?)
	endedOverride = false
	endedUnix = 0
	endedReason = ""
	persistState()
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log("SEASON_RESUME", 0, {
			seasonId = SeasonConfig.CurrentSeasonId,
			reason = reason or "clear",
		})
	end
	if NotificationService then
		NotificationService.NotifyAll("Season resumed: " .. tostring(SeasonConfig.DisplayName), "Success")
	end
	pushAll()
end

function SeasonService.Push(player: Player)
	pushState(player)
end

function SeasonService.Init(deps: { [string]: any })
	DataService = deps.DataService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService

	loadState()

	-- Auto-end when config EndUnix has passed (persist once)
	if not endedOverride then
		local endUnix = tonumber(SeasonConfig.EndUnix) or 0
		if endUnix > 0 and os.time() > endUnix then
			SeasonService.EndSeason("end_unix")
		end
	end

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		pushState(player)
	end)

	-- Periodic check for scheduled end
	task.spawn(function()
		while true do
			task.wait(30)
			if not endedOverride then
				local endUnix = tonumber(SeasonConfig.EndUnix) or 0
				if endUnix > 0 and os.time() > endUnix then
					SeasonService.EndSeason("end_unix_tick")
				end
			end
		end
	end)
end

return SeasonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">SoldierService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Army recruitment — server-authoritative soldier counts.
	Spends Cash via EconomyService; never trusts client counts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local SoldierService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil
local MissionService: any = nil

local MAX_BATCH = 50

local function trainingIncomePerTick(profile: any): number
	local cfg = SoldierConfig.TrainingIncome
	if not cfg then
		return 0
	end
	local count = tonumber(profile.Soldiers) or 0
	local minN = cfg.MinSoldiersForIncome or 1
	if count < minN then
		return 0
	end
	local per = cfg.CashPerSoldierPerTick or 0
	local prestigeMult = 1 + ((tonumber(profile.Prestige) or 0) * 0.05)
	return math.floor(count * per * prestigeMult)
end


local function barracksLevel(profile: any): number
	local upgrades = profile.BaseUpgrades
	if typeof(upgrades) ~= "table" then
		return 0
	end
	return tonumber(upgrades.Barracks) or 0
end

local function maxSoldiers(profile: any): number
	local base = SoldierConfig.MaxSoldiersBase or 50
	local per = SoldierConfig.SoldiersPerBarracksLevel or 5
	return base + barracksLevel(profile) * per
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local count = tonumber(profile.Soldiers) or 0
	local cap = maxSoldiers(profile)
	local cost = SoldierConfig.RecruitCostCash or 500
	local room = math.max(0, cap - count)
	local remote = RemoteSetup.Get(Constants.RemoteNames.SoldierStateUpdate) :: RemoteEvent
	local training = trainingIncomePerTick(profile)
	local tickSec = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.TickSeconds) or 5
	remote:FireClient(player, {
		Soldiers = count,
		MaxSoldiers = cap,
		BarracksLevel = barracksLevel(profile),
		RecruitCostCash = cost,
		RecruitBatchSize = SoldierConfig.RecruitBatchSize or 1,
		DismissRefundMult = SoldierConfig.DismissRefundMult or 0.25,
		SlotsFree = room,
		FillCost = cost * room,
		TrainingIncomePerTick = training,
		TrainingTickSeconds = tickSec,
		TrainingIncomePerSec = if tickSec > 0 then training / tickSec else 0,
	})
end

function SoldierService.GetCount(player: Player): number
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0
	end
	return tonumber(profile.Soldiers) or 0
end

local function sanitizeAmount(amount: any): (number?, string?)
	local n = RemoteGuard.ClampPositiveInt(amount, MAX_BATCH)
	if not n then
		return nil, "InvalidAmount"
	end
	return n, nil
end

function SoldierService.Recruit(player: Player, amount: any): (boolean, string?)
	local n, serr = sanitizeAmount(amount)
	if not n then
		return false, serr
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local current = tonumber(profile.Soldiers) or 0
	local cap = maxSoldiers(profile)
	if current >= cap then
		return false, "AtCap"
	end
	if current + n > cap then
		n = cap - current -- clamp to remaining slots
	end
	local costEach = SoldierConfig.RecruitCostCash or 500
	local total = costEach * n
	local ok, err = EconomyService.SpendCash(player, total, "recruit_soldiers")
	if not ok then
		return false, err or "CannotAfford"
	end
	profile.Soldiers = current + n
	DataService.MarkDirty(player)
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "RecruitSoldiers", n)
	end
	pushState(player)
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format("Recruited %d · Army %d/%d (−$%d)", n, profile.Soldiers, cap, total),
			"Success"
		)
	end
	local eventName = if AnalyticsConfig.Events.SOLDIER_RECRUIT then AnalyticsConfig.Events.SOLDIER_RECRUIT else "SOLDIER_RECRUIT"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, { amount = n, cost = total, total = profile.Soldiers })
	end
	return true, nil
end

function SoldierService.Dismiss(player: Player, amount: any): (boolean, string?)
	local n, serr = sanitizeAmount(amount)
	if not n then
		return false, serr
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local current = tonumber(profile.Soldiers) or 0
	if n > current then
		return false, "NotEnoughSoldiers"
	end
	profile.Soldiers = current - n
	local refund = math.floor((SoldierConfig.RecruitCostCash or 500) * n * (SoldierConfig.DismissRefundMult or 0.25))
	if refund > 0 then
		EconomyService.AddCash(player, refund, "dismiss_soldiers")
	end
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format("Dismissed %d · Army %d (−refund $%d)", n, profile.Soldiers, refund),
			"Info"
		)
	end
	local eventName = if AnalyticsConfig.Events.SOLDIER_DISMISS then AnalyticsConfig.Events.SOLDIER_DISMISS else "SOLDIER_DISMISS"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, { amount = n, refund = refund })
	end
	return true, nil
end

function SoldierService.Push(player: Player)
	pushState(player)
end

function SoldierService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService
	MissionService = deps.MissionService

	local recruitRemote = RemoteSetup.Get(Constants.RemoteNames.RequestRecruitSoldiers) :: RemoteEvent
	recruitRemote.OnServerEvent:Connect(function(player: Player, amount: any)
		if not RateLimitService.Allow(player, "soldier_recruit", 2, 4) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "soldier_recruit_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SoldierService.Recruit(player, amount)
		if not ok and NotificationService then
			local msg = "Recruit failed: " .. tostring(err)
			if err == "AtCap" then
				msg = "Army at capacity — upgrade Barracks"
			elseif err == "InsufficientCash" or err == "CannotAfford" then
				msg = "Not enough cash to recruit"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	local dismissRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDismissSoldiers) :: RemoteEvent
	dismissRemote.OnServerEvent:Connect(function(player: Player, amount: any)
		if not RateLimitService.Allow(player, "soldier_dismiss", 2, 4) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "soldier_dismiss_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SoldierService.Dismiss(player, amount)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Dismiss failed: " .. tostring(err), "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.Soldiers) ~= "number" then
			profile.Soldiers = SoldierConfig.StartingSoldiers or 5
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)

	-- Training Yard worker income (MT-inspired)
	task.spawn(function()
		local Players = game:GetService("Players")
		while true do
			local tickSec = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.TickSeconds) or 5
			task.wait(tickSec)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataService.GetProfile(player)
				if profile then
					local amount = trainingIncomePerTick(profile)
					if amount > 0 then
						EconomyService.AddCash(player, amount, "training")
					end
				end
			end
		end
	end)
end

return SoldierService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">SpinnerService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Free Supply Spinner — claim Cash/Gold every CooldownSeconds (HUD / Settings).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SpinnerConfig = require(Shared.Configs.SpinnerConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local SpinnerService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local AntiExploitService: any = nil

local function pickReward(): any
	local rewards = SpinnerConfig.Rewards
	local total = 0
	for _, r in ipairs(rewards) do
		total += math.max(0, tonumber(r.Weight) or 0)
	end
	if total <= 0 then
		return rewards[1]
	end
	local roll = math.random() * total
	local acc = 0
	for _, r in ipairs(rewards) do
		acc += math.max(0, tonumber(r.Weight) or 0)
		if roll <= acc then
			return r
		end
	end
	return rewards[#rewards]
end

local function remainingSeconds(profile: any): number
	local last = tonumber(profile.LastSpinnerClaimUnix) or 0
	local cd = SpinnerConfig.CooldownSeconds or (4 * 3600)
	local readyAt = last + cd
	return math.max(0, readyAt - os.time())
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local rem = remainingSeconds(profile)
	local remote = RemoteSetup.Get(Constants.RemoteNames.SpinnerStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Ready = rem <= 0,
		CooldownRemaining = rem,
		CooldownSeconds = SpinnerConfig.CooldownSeconds,
		DisplayName = SpinnerConfig.DisplayName or "Supply Spinner",
	})
end

function SpinnerService.Claim(player: Player): (boolean, string?)
	if not SpinnerConfig.Enabled then
		return false, "Disabled"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local rem = remainingSeconds(profile)
	if rem > 0 then
		return false, "Cooldown"
	end

	local reward = pickReward()
	local cash = tonumber(reward.Cash) or 0
	local gold = tonumber(reward.Gold) or 0
	profile.LastSpinnerClaimUnix = os.time()
	DataService.MarkDirty(player)

	if cash > 0 then
		EconomyService.AddCash(player, cash, "spinner")
	end
	if gold > 0 then
		EconomyService.AddGold(player, gold, "spinner")
	end

	if NotificationService then
		local name = reward.DisplayName or "Supply"
		NotificationService.Notify(
			player,
			string.format("%s: +$%d · +%d Gold", name, cash, gold),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.SPINNER_CLAIM, player.UserId, {
			rewardId = reward.Id,
			cash = cash,
			gold = gold,
		})
	end
	pushState(player)
	return true, nil
end

function SpinnerService.Push(player: Player)
	pushState(player)
end

function SpinnerService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	AntiExploitService = deps.AntiExploitService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimSpinner) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "spinner_claim", 1, 2) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "spinner_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SpinnerService.Claim(player)
		if not ok and NotificationService then
			if err == "Cooldown" then
				local profile = DataService.GetProfile(player)
				local rem = if profile then remainingSeconds(profile) else 0
				local mins = math.ceil(rem / 60)
				NotificationService.Notify(player, string.format("Spinner ready in %dm", mins), "Warn")
			else
				NotificationService.Notify(player, "Spinner unavailable", "Warn")
			end
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.LastSpinnerClaimUnix) ~= "number" then
			profile.LastSpinnerClaimUnix = 0
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)
end

return SpinnerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">SupplyDropService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic Supply Drops — crates spawn on map; stand near to claim Cash.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SupplyDropConfig = require(Shared.Configs.SupplyDropConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local SupplyDropService = {}

local EconomyService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil

type DropRec = {
	Id: string,
	Part: BasePart,
	ClaimCash: number,
	ExpiresAt: number,
	ClaimProgress: { [number]: number }, -- userId -> hold seconds
}

local active: { [string]: DropRec } = {}
local folder: Folder? = nil
local nextId = 0

local function ensureFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local root = Workspace:FindFirstChild("WarEmpireSetup")
	local parent = if root then root else Workspace
	local existing = parent:FindFirstChild("SupplyDrops")
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "SupplyDrops"
	f.Parent = parent
	folder = f
	return f
end

local function pickSpawnPosition(): Vector3
	local pads = CollectionService:GetTagged(Constants.Tags.EventSpawn)
	local candidates: { Vector3 } = {}
	for _, inst in ipairs(pads) do
		if inst:IsA("BasePart") then
			table.insert(candidates, inst.Position + Vector3.new(0, 3, 0))
		end
	end
	-- Avoid stacking on occupied pads
	local free: { Vector3 } = {}
	for _, pos in ipairs(candidates) do
		local blocked = false
		for _, rec in pairs(active) do
			if (rec.Part.Position - pos).Magnitude < 25 then
				blocked = true
				break
			end
		end
		if not blocked then
			table.insert(free, pos)
		end
	end
	if #free > 0 then
		return free[math.random(1, #free)]
	end
	-- Scatter fallback on open ground
	local r = SupplyDropConfig.ScatterRadius or 900
	local minR = SupplyDropConfig.ScatterMinDistanceFromOrigin or 120
	for _ = 1, 12 do
		local angle = math.random() * math.pi * 2
		local dist = minR + math.random() * (r - minR)
		local pos = Vector3.new(math.cos(angle) * dist, 3, math.sin(angle) * dist)
		local ok = true
		for _, rec in pairs(active) do
			if (rec.Part.Position - pos).Magnitude < 40 then
				ok = false
				break
			end
		end
		if ok then
			return pos
		end
	end
	return Vector3.new(150, 3, 150)
end

local function destroyDrop(id: string)
	local rec = active[id]
	if not rec then
		return
	end
	active[id] = nil
	if rec.Part and rec.Part.Parent then
		rec.Part:Destroy()
	end
end

local function spawnDrop()
	if not SupplyDropConfig.Enabled then
		return
	end
	local count = 0
	for _ in pairs(active) do
		count += 1
	end
	if count >= (SupplyDropConfig.MaxActive or 3) then
		return
	end

	nextId += 1
	local id = "drop_" .. tostring(nextId)
	local pos = pickSpawnPosition()
	local cashMin = SupplyDropConfig.CashMin or 2500
	local cashMax = SupplyDropConfig.CashMax or 12000
	local cash = math.random(cashMin, cashMax)

	local parent = ensureFolder()
	local crate = Instance.new("Part")
	crate.Name = "SupplyCrate_" .. id
	crate.Size = SupplyDropConfig.CrateSize or Vector3.new(5, 4, 5)
	crate.Position = pos
	crate.Anchored = true
	crate.CanCollide = true
	crate.Color = SupplyDropConfig.CrateColor or Color3.fromRGB(210, 160, 55)
	crate.Material = Enum.Material.Metal
	crate.TopSurface = Enum.SurfaceType.Smooth
	crate.BottomSurface = Enum.SurfaceType.Smooth
	crate.Parent = parent
	crate:SetAttribute("SupplyDropId", id)
	crate:SetAttribute("ClaimCash", cash)
	CollectionService:AddTag(crate, Constants.Tags.SupplyDrop)

	-- Visual kits v2: straps + lid + neon ring
	local function decor(name: string, size: Vector3, offset: CFrame, color: Color3, mat: Enum.Material, shape: Enum.PartType?)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.Material = mat
		p.Color = color
		if shape then
			p.Shape = shape
		end
		p.CFrame = crate.CFrame * offset
		p.Parent = crate
		return p
	end
	decor("StrapX", Vector3.new(crate.Size.X + 0.2, 0.35, 0.35), CFrame.new(0, 0.2, 0), Color3.fromRGB(40, 40, 42), Enum.Material.Metal, nil)
	decor("StrapZ", Vector3.new(0.35, 0.35, crate.Size.Z + 0.2), CFrame.new(0, 0.2, 0), Color3.fromRGB(40, 40, 42), Enum.Material.Metal, nil)
	decor("Lid", Vector3.new(crate.Size.X * 0.92, 0.4, crate.Size.Z * 0.92), CFrame.new(0, crate.Size.Y * 0.5 + 0.1, 0), Color3.fromRGB(180, 140, 50), Enum.Material.Metal, nil)
	decor("Ring", Vector3.new(crate.Size.X + 1.5, 0.25, crate.Size.Z + 1.5), CFrame.new(0, -crate.Size.Y * 0.45, 0), Color3.fromRGB(255, 200, 80), Enum.Material.Neon, nil)

	local tip = Instance.new("Part")
	tip.Name = "Beacon"
	tip.Size = Vector3.new(1.4, 1.4, 1.4)
	tip.Shape = Enum.PartType.Ball
	tip.Anchored = true
	tip.CanCollide = false
	tip.Material = Enum.Material.Neon
	tip.Color = SupplyDropConfig.BeaconColor or Color3.fromRGB(255, 200, 80)
	tip.CFrame = crate.CFrame * CFrame.new(0, 4, 0)
	tip.Parent = crate

	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(200, 40)
	bb.StudsOffset = Vector3.new(0, 5.5, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 500
	bb.Parent = crate
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(12, 14, 16)
	label.BackgroundTransparency = 0.2
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 120)
	label.Text = string.format("SUPPLY DROP · Stand to claim ~$%d", cash)
	label.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = label

	local ttl = SupplyDropConfig.LifetimeSeconds or 75
	active[id] = {
		Id = id,
		Part = crate,
		ClaimCash = cash,
		ExpiresAt = os.clock() + ttl,
		ClaimProgress = {},
	}
end

local function claim(player: Player, rec: DropRec)
	destroyDrop(rec.Id)
	EconomyService.AddCash(player, rec.ClaimCash, "supply_drop")
	if NotificationService then
		NotificationService.Notify(player, string.format("Supply Drop +$%d", rec.ClaimCash), "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.SUPPLY_DROP_CLAIM, player.UserId, {
			cash = rec.ClaimCash,
			dropId = rec.Id,
		})
	end
end

local function tickClaims(dt: number)
	local radius = SupplyDropConfig.ClaimRadius or 10
	local holdNeed = SupplyDropConfig.ClaimHoldSeconds or 2.5
	local now = os.clock()

	-- Expire
	local expired: { string } = {}
	for id, rec in pairs(active) do
		if now >= rec.ExpiresAt or not rec.Part.Parent then
			table.insert(expired, id)
		end
	end
	for _, id in ipairs(expired) do
		destroyDrop(id)
	end

	for _, rec in pairs(active) do
		local pos = rec.Part.Position
		local nearby: { [number]: boolean } = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - pos).Magnitude
				if d <= radius then
					nearby[player.UserId] = true
					local prog = (rec.ClaimProgress[player.UserId] or 0) + dt
					rec.ClaimProgress[player.UserId] = prog
					if prog >= holdNeed then
						claim(player, rec)
						break
					end
				end
			end
		end
		-- Decay progress for leavers
		for uid in pairs(rec.ClaimProgress) do
			if not nearby[uid] then
				rec.ClaimProgress[uid] = nil
			end
		end
	end
end

function SupplyDropService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService

	if not SupplyDropConfig.Enabled then
		return
	end

	ensureFolder()

	task.spawn(function()
		task.wait(12) -- let map settle
		spawnDrop()
		local interval = SupplyDropConfig.SpawnIntervalSeconds or 90
		while true do
			task.wait(interval)
			spawnDrop()
		end
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		local step = accum
		accum = 0
		tickClaims(step)
	end)
end

return SupplyDropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">TerritoryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 5 — Territory control.
	Server-authoritative stand-in-zone capture; bonuses for Economy / XP / Vehicles / Combat.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local TerritoryRadar = require(script.TerritoryRadar)
local TerritoryOwnership = require(script.TerritoryOwnership)
local TerritoryCapture = require(script.TerritoryCapture)

type TerritoryDef = TerritoryConfig.TerritoryDef

type TerritoryRuntime = {
	Id: string,
	Def: TerritoryDef,
	OwnerType: string,
	OwnerUserId: number, -- 0 neutral, -1 NPC, else player
	ClanId: string?,
	Progress: number, -- seconds accumulated toward capture
	CapturingUserId: number, -- 0 if none
	ProtectedUntil: number, -- unix
	Contested: boolean,
	Marker: BasePart?,
}

local RemoteGuard = require(script.Parent.Parent.Parent.Modules.RemoteGuard)

local TerritoryService = {}

local ClanWarService: any = nil

local DataService: any = nil
local _EconomyService: any = nil
local _XPService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local NotificationService: any = nil
local MissionService: any = nil
local TutorialService: any = nil
local RemoteSetup: any = nil
local BaseService: any = nil
local NationColorService: any = nil

local territories: { [string]: TerritoryRuntime } = {}
local firstOutpostLogged: { [number]: boolean } = {}
local lastPushAt = 0
local pushDirty = true

local function ownerTypes()
	return TerritoryConfig.OwnerTypes
end

local function nowUnix(): number
	return os.time()
end

local function findMarker(territoryId: string): BasePart?
	return TerritoryRadar.FindMarker(territoryId)
end

local function ensureRuntime()
	for id, def in pairs(TerritoryConfig.Territories) do
		if not territories[id] then
			territories[id] = {
				Id = id,
				Def = def,
				OwnerType = ownerTypes().Neutral,
				OwnerUserId = TerritoryConfig.NeutralOwnerId,
				ClanId = nil,
				Progress = 0,
				CapturingUserId = 0,
				ProtectedUntil = 0,
				Contested = false,
				Marker = findMarker(id),
			}
		elseif not territories[id].Marker or not territories[id].Marker.Parent then
			territories[id].Marker = findMarker(id)
		end
	end
end

local function countPersonalTerritories(userId: number): number
	local n = 0
	for _, rt in pairs(territories) do
		if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == userId then
			n += 1
		end
	end
	return n
end

local function syncProfileOwnership(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.Territories) ~= "table" then
		profile.Territories = {}
	end
	-- Clear then re-apply owned
	for id in pairs(profile.Territories) do
		profile.Territories[id] = nil
	end
	for id, rt in pairs(territories) do
		if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == player.UserId then
			profile.Territories[id] = true
		end
	end
	DataService.MarkDirty(player)
end

local function ownerStateLabel(rt: TerritoryRuntime): string
	local ot = ownerTypes()
	if rt.Contested or rt.OwnerType == ot.Contested then
		return "CONTESTED"
	elseif rt.OwnerType == ot.Player then
		local plr = Players:GetPlayerByUserId(rt.OwnerUserId)
		return if plr then ("OWNED · " .. plr.DisplayName) else "OWNED"
	elseif rt.OwnerType == ot.NPC then
		return "HOSTILE NPC"
	elseif rt.OwnerType == ot.Clan then
		return "CLAN"
	end
	return "NEUTRAL · Stand to capture"
end

local function updateMarkerVisual(rt: TerritoryRuntime)
	local marker = rt.Marker
	if not marker then
		return
	end
	local ot = ownerTypes()
	local contested = rt.Contested or rt.OwnerType == ot.Contested
	local color: Color3
	local markerTransparency = 0.45
	local flagTransparency = 0.15
	local flagMaterial = Enum.Material.Neon
	local ringTransparency = 0.65
	local flagLift = 12 -- studs above ground for flag center

	if contested then
		color = Color3.fromRGB(255, 140, 35)
		markerTransparency = 0.28
		flagTransparency = 0.05
		ringTransparency = 0.35
		flagLift = 13.5
	elseif rt.OwnerType == ot.Player then
		local nation = if NationColorService and NationColorService.GetColor then NationColorService.GetColor(rt.OwnerUserId) else nil
		color = nation or Color3.fromRGB(55, 210, 95)
		markerTransparency = 0.35
		flagTransparency = 0.0
		ringTransparency = 0.45
		flagLift = 14.5
	elseif rt.OwnerType == ot.NPC then
		color = Color3.fromRGB(210, 45, 45)
		markerTransparency = 0.32
		flagTransparency = 0.05
		ringTransparency = 0.4
		flagLift = 13.2
	elseif rt.OwnerType == ot.Clan then
		color = Color3.fromRGB(70, 120, 240)
		markerTransparency = 0.35
		flagTransparency = 0.0
		ringTransparency = 0.45
		flagLift = 14.0
	else
		color = rt.Def.Color
		flagMaterial = Enum.Material.SmoothPlastic
		flagTransparency = 0.35
		flagLift = 11.0
	end

	marker.Color = color
	marker.Transparency = markerTransparency
	marker.Material = Enum.Material.Neon
	marker:SetAttribute("OwnerType", if contested then ot.Contested else rt.OwnerType)
	marker:SetAttribute("OwnerUserId", rt.OwnerUserId)
	marker:SetAttribute("CaptureProgress", rt.Progress / math.max(1, rt.Def.CaptureTimeSeconds))

	local tid = marker:GetAttribute("TerritoryId")
	if typeof(tid) ~= "string" then
		return
	end
	local parent = marker.Parent
	if not parent then
		return
	end

	local flag = parent:FindFirstChild(tid .. "_Flag")
	if flag and flag:IsA("BasePart") then
		flag.Color = color
		flag.Material = flagMaterial
		flag.Transparency = flagTransparency
		-- Raise owned flags; lower neutral so ownership reads at a glance
		local basePos = marker.Position
		flag.Size = if contested then Vector3.new(6.2, 3.6, 0.3) elseif rt.OwnerType == ot.Neutral then Vector3.new(4.2, 2.4, 0.22) else Vector3.new(5.5, 3.2, 0.28)
		flag.Position = Vector3.new(basePos.X + flag.Size.X * 0.5 + 0.2, flagLift, basePos.Z)
		-- Ownership flash light (brief)
		local lightInst = flag:FindFirstChild("WE_OwnerLight")
		local light: PointLight
		if lightInst and lightInst:IsA("PointLight") then
			light = lightInst
		else
			if lightInst then
				lightInst:Destroy()
			end
			light = Instance.new("PointLight")
			light.Name = "WE_OwnerLight"
			light.Range = 28
			light.Parent = flag
		end
		light.Color = color
		light.Brightness = if contested then 3.2 elseif rt.OwnerType == ot.Neutral then 0.4 else 2.4
		light.Enabled = true
	end

	local ring = parent:FindFirstChild(tid .. "_Ring")
	if ring and ring:IsA("BasePart") then
		ring.Color = color
		ring.Transparency = ringTransparency
		ring.Material = if contested then Enum.Material.Neon else Enum.Material.SmoothPlastic
		local d = (rt.Def.Radius or 30) * 2
		ring.Size = if contested then Vector3.new(d + 14, 0.55, d + 14) else Vector3.new(d + 8, 0.4, d + 8)
	end

	local pole = parent:FindFirstChild(tid .. "_FlagPole")
	if pole and pole:IsA("BasePart") then
		pole.Color = if contested then Color3.fromRGB(180, 90, 30) elseif rt.OwnerType == ot.Neutral then Color3.fromRGB(55, 55, 55) else Color3.fromRGB(40, 45, 40)
	end

	-- Billboard state line
	local labelGui = marker:FindFirstChild("Label")
	if labelGui and labelGui:IsA("BillboardGui") then
		local backdrop = labelGui:FindFirstChild("Backdrop")
		local textLabel = backdrop and backdrop:FindFirstChild("Text")
		if textLabel and textLabel:IsA("TextLabel") then
			textLabel.Text = rt.Def.DisplayName .. "  [" .. ownerStateLabel(rt) .. "]"
			textLabel.TextColor3 = if contested then Color3.fromRGB(255, 200, 120) elseif rt.OwnerType == ot.Player then Color3.fromRGB(160, 255, 180) elseif rt.OwnerType == ot.NPC then Color3.fromRGB(255, 160, 150) else Color3.new(1, 1, 1)
		end
		local stroke = backdrop and backdrop:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = color
		end
	end
end

local function buildPayloadForPlayer(player: Player?): Types.TerritoryStatePayload
	local list: { Types.TerritoryEntryPayload } = {}
	local localCapture = {
		TerritoryId = nil :: string?,
		Progress = 0,
		Capturing = false,
		Contested = false,
		Protected = false,
	}

	for _, rt in pairs(territories) do
		table.insert(list, {
			Id = rt.Id,
			DisplayName = rt.Def.DisplayName,
			OwnerType = if rt.Contested then ownerTypes().Contested else rt.OwnerType,
			OwnerUserId = rt.OwnerUserId,
			ClanId = rt.ClanId,
			Progress = math.clamp(rt.Progress / math.max(1, rt.Def.CaptureTimeSeconds), 0, 1),
			CapturingUserId = rt.CapturingUserId,
			ProtectedUntil = rt.ProtectedUntil,
			BonusType = rt.Def.BonusType,
			BonusValue = rt.Def.BonusValue,
			Contested = rt.Contested,
		})
		if player and rt.CapturingUserId == player.UserId and rt.Progress > 0 then
			localCapture.TerritoryId = rt.Id
			localCapture.Progress = math.clamp(rt.Progress / math.max(1, rt.Def.CaptureTimeSeconds), 0, 1)
			localCapture.Capturing = true
			localCapture.Contested = rt.Contested == true
			localCapture.Protected = rt.ProtectedUntil > nowUnix()
				and rt.OwnerUserId ~= TerritoryConfig.NeutralOwnerId
				and rt.OwnerUserId ~= player.UserId
		end
	end

	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)

	local radar = false
	local radarRadius = TerritoryConfig.RadarRevealRadius or 220
	if player then
		radar = TerritoryService.HasRadarReveal(player)
	end

	return {
		Territories = list,
		LocalCapture = localCapture,
		RadarReveal = radar,
		RadarRadius = radarRadius,
	}
end

function TerritoryService.PushAll()
	ensureRuntime()
	local remote = RemoteSetup.Get(Constants.RemoteNames.TerritoryStateUpdate) :: RemoteEvent
	for _, player in ipairs(Players:GetPlayers()) do
		remote:FireClient(player, buildPayloadForPlayer(player))
	end
	lastPushAt = os.clock()
end

function TerritoryService.PushPlayer(player: Player)
	ensureRuntime()
	local remote = RemoteSetup.Get(Constants.RemoteNames.TerritoryStateUpdate) :: RemoteEvent
	remote:FireClient(player, buildPayloadForPlayer(player))
end

function TerritoryService.GetController(territoryId: string): number?
	local rt = territories[territoryId]
	if not rt then
		return nil
	end
	if rt.OwnerType == ownerTypes().Neutral or rt.OwnerType == ownerTypes().Contested then
		return nil
	end
	return rt.OwnerUserId
end

function TerritoryService.GetRuntime(territoryId: string): TerritoryRuntime?
	return territories[territoryId]
end

--[[ Aggregate bonus values for territories controlled by this player (or their clan). ]]
function TerritoryService.GetBonusesForPlayer(player: Player): { [string]: number }
	local bonuses: { [string]: number } = {}
	local profile = DataService and DataService.GetProfile(player)
	local clanId = if profile then profile.ClanId else nil

	for _, rt in pairs(territories) do
		local owns = (rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == player.UserId)
			or (rt.OwnerType == ownerTypes().Clan and clanId ~= nil and rt.ClanId == clanId)
		if owns then
			-- Flat and multiplicative bonuses both accumulate additively into the map;
			-- consumers interpret FlatPassiveCash/MinimapReveal as flat, *Mult as fractions.
			local key = rt.Def.BonusType
			local value = rt.Def.BonusValue
			bonuses[key] = (bonuses[key] or 0) + value
		end
	end
	return bonuses
end

function TerritoryService.GetPassiveCashBonus(player: Player): (number, number)
	-- returns (multiplierAdd, flatAdd) e.g. 0.10, 50
	local b = TerritoryService.GetBonusesForPlayer(player)
	return b.PassiveCashMult or 0, b.FlatPassiveCash or 0
end

function TerritoryService.GetXPMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	return 1 + (b.XPMult or 0)
end

function TerritoryService.GetDamageMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	return 1 + (b.DamageMult or 0)
end

function TerritoryService.GetVehicleCooldownMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	-- BonusValue for WestDepot is -0.20 → cooldown * 0.80
	return 1 + (b.VehicleCooldownMult or 0)
end

function TerritoryService.GetMissionCashMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	return 1 + (b.MissionCashMult or 0)
end

--[[ True when player (or their clan) controls a MinimapReveal territory (Radar Hill). ]]
function TerritoryService.HasRadarReveal(player: Player): boolean
	return TerritoryOwnership.HasRadar(player)
end

function TerritoryService.GetRadarRevealRadius(): number
	return TerritoryConfig.RadarRevealRadius or 220
end

local function releaseOwnership(rt: TerritoryRuntime, reason: string)
	local prevUserId = rt.OwnerUserId
	local prevType = rt.OwnerType
	rt.OwnerType = ownerTypes().Neutral
	rt.OwnerUserId = TerritoryConfig.NeutralOwnerId
	rt.ClanId = nil
	rt.ProtectedUntil = 0

	if prevType == ownerTypes().Player and prevUserId > 0 then
		local prevPlayer = Players:GetPlayerByUserId(prevUserId)
		if prevPlayer then
			syncProfileOwnership(prevPlayer)
			if NotificationService then
				NotificationService.Notify(prevPlayer, "Lost control of " .. rt.Def.DisplayName, "Warn")
			end
			if AnalyticsService then
				AnalyticsService.Log(AnalyticsConfig.Events.TERRITORY_LOST, prevUserId, {
					territory = rt.Id,
					reason = reason,
				})
			end
			if BaseService then
				BaseService.PushState(prevPlayer)
			end
		end
	end
end

local function awardCapture(player: Player, rt: TerritoryRuntime)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end

	-- Enforce max personal territories
	local owned = countPersonalTerritories(player.UserId)
	-- If already owning this one (re-secure), skip max check
	local alreadyOwns = rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == player.UserId
	if not alreadyOwns and owned >= TerritoryConfig.MaxPersonalTerritories then
		-- Drop oldest unprotected personal territory
		local oldest: TerritoryRuntime? = nil
		local oldestTime = math.huge
		for _, other in pairs(territories) do
			if other.Id ~= rt.Id and other.OwnerType == ownerTypes().Player and other.OwnerUserId == player.UserId then
				if other.ProtectedUntil < oldestTime then
					oldestTime = other.ProtectedUntil
					oldest = other
				end
			end
		end
		if oldest then
			releaseOwnership(oldest, "max_personal")
			updateMarkerVisual(oldest)
		end
	end

	-- Previous owner loses it
	if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId ~= player.UserId and rt.OwnerUserId > 0 then
		releaseOwnership(rt, "captured")
	end

	rt.OwnerType = ownerTypes().Player
	rt.OwnerUserId = player.UserId
	rt.ClanId = profile.ClanId
	if ClanWarService and ClanWarService.OnTerritoryCaptured then
		ClanWarService.OnTerritoryCaptured(player)
	end
	rt.Progress = 0
	rt.CapturingUserId = 0
	rt.Contested = false
	rt.ProtectedUntil = nowUnix() + TerritoryConfig.ProtectionPeriodSeconds

	profile.Stats.TerritoriesCaptured += 1
	syncProfileOwnership(player)

	if NotificationService then
		local bonusHint = rt.Def.Description or ""
		if #bonusHint > 60 then
			bonusHint = string.sub(bonusHint, 1, 57) .. "..."
		end
		NotificationService.Notify(
			player,
			string.format("Captured %s! %s", rt.Def.DisplayName, bonusHint),
			"Reward"
		)
	end

	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.TERRITORY_CAPTURED, player.UserId, {
			territory = rt.Id,
			total = profile.Stats.TerritoriesCaptured,
		})
		if profile.Stats.TerritoriesCaptured == 1 and not firstOutpostLogged[player.UserId] then
			firstOutpostLogged[player.UserId] = true
			AnalyticsService.Log(AnalyticsConfig.Events.FIRST_OUTPOST, player.UserId, { territory = rt.Id })
		end
	end

	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "CaptureTerritory", 1)
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "CaptureTerritory", rt.Id)
	end

	if BaseService then
		BaseService.PushState(player)
	end

	updateMarkerVisual(rt)
end

local function playersInZone(rt: TerritoryRuntime): { Player }
	return TerritoryCapture.PlayersInZone(rt)
end

local function tickTerritory(rt: TerritoryRuntime, dt: number)
	local inside = playersInZone(rt)
	local ot = ownerTypes()

	if #inside == 0 then
		rt.Contested = false
		if rt.Progress > 0 then
			rt.Progress = math.max(0, rt.Progress - TerritoryConfig.ProgressDecayPerSecond * dt)
		end
		if rt.Progress <= 0 then
			rt.CapturingUserId = 0
		end
		updateMarkerVisual(rt)
		return
	end

	-- Contested if 2+ distinct players and not all already the owner
	local unique: { [number]: boolean } = {}
	for _, p in ipairs(inside) do
		unique[p.UserId] = true
	end
	local uniqueCount = 0
	for _ in pairs(unique) do
		uniqueCount += 1
	end

	if uniqueCount >= 2 then
		rt.Contested = true
		rt.OwnerType = if rt.OwnerUserId == TerritoryConfig.NeutralOwnerId then ot.Contested else rt.OwnerType
		-- Contested: ContestedProgressMult scales capture; 0 freezes and applies ContestedDecayMult decay
		local mult = TerritoryConfig.ContestedProgressMult
		if mult <= 0 then
			local decayMult = TerritoryConfig.ContestedDecayMult or 0.5
			rt.Progress = math.max(0, rt.Progress - TerritoryConfig.ProgressDecayPerSecond * decayMult * dt)
		else
			-- Rare path: allow slow contested progress for both (not used at default 0)
			rt.Progress += dt * mult
		end
		updateMarkerVisual(rt)
		return
	end

	rt.Contested = false
	local capturer = inside[1]
	-- If capturer already owns it, just refresh presence (no progress needed)
	if rt.OwnerType == ot.Player and rt.OwnerUserId == capturer.UserId then
		rt.CapturingUserId = 0
		rt.Progress = 0
		updateMarkerVisual(rt)
		return
	end

	-- Protection period hook: slower capture while protected
	local rate = 1
	if rt.ProtectedUntil > nowUnix() and rt.OwnerUserId ~= TerritoryConfig.NeutralOwnerId then
		rate = TerritoryConfig.ProtectedCaptureMult
	end

	rt.CapturingUserId = capturer.UserId
	rt.Progress += dt * rate

	if rt.Progress >= rt.Def.CaptureTimeSeconds then
		awardCapture(capturer, rt)
	else
		updateMarkerVisual(rt)
	end
end

--[[
	Optional explicit request — mainly for UI "begin capture" ping; actual progress is proximity-based.
]]
function TerritoryService.BeginCapture(player: Player, territoryId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(territoryId, 48) then
		return false, "InvalidTerritory"
	end
	if not RemoteGuard.RequireProfile(DataService, player) then
		return false, "NoProfile"
	end
	ensureRuntime()
	local rt = territories[territoryId]
	if not rt then
		return false, "UnknownTerritory"
	end
	local inside = playersInZone(rt)
	local present = false
	for _, p in ipairs(inside) do
		if p == player then
			present = true
			break
		end
	end
	if not present then
		if NotificationService then
			NotificationService.Notify(player, "Enter the capture zone first.", "Warn")
		end
		return false, "NotInZone"
	end
	if NotificationService then
		NotificationService.Notify(player, "Capturing " .. rt.Def.DisplayName .. "...", "Info")
	end
	TerritoryService.PushPlayer(player)
	return true, nil
end

--[[ Seed a few territories as NPC-held for contested feel (Studio / empty servers). ]]
local function seedNpcOwners()
	local npcHeld = { "EastArmory", "RadarHill", "CoastalOilAlpha", "CoastalOilBravo" }
	for _, id in ipairs(npcHeld) do
		local rt = territories[id]
		if rt and rt.OwnerType == ownerTypes().Neutral then
			rt.OwnerType = ownerTypes().NPC
			rt.OwnerUserId = TerritoryConfig.NPCOwnerId
			rt.ProtectedUntil = nowUnix() + 30
			updateMarkerVisual(rt)
		end
	end
end

function TerritoryService.Init(deps: { [string]: any })
	ClanWarService = deps.ClanWarService
	DataService = deps.DataService
	_EconomyService = deps.EconomyService
	_XPService = deps.XPService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	RemoteSetup = deps.RemoteSetup
	BaseService = deps.BaseService
	NationColorService = deps.NationColorService

	TerritoryOwnership.Bind({
		territories = territories,
		ownerTypes = ownerTypes,
		DataService = DataService,
	})

	ensureRuntime()
	seedNpcOwners()

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestCaptureTerritory) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player, territoryId: any)
		if not RateLimitService.Allow(player, "capture_territory", 1, 2) then
			return
		end
		TerritoryService.BeginCapture(player, territoryId)
	end)

	-- Late marker discovery (StudioSetup may run after Bootstrap)
	task.spawn(function()
		for _ = 1, 20 do
			task.wait(1)
			ensureRuntime()
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		syncProfileOwnership(player)
		TerritoryService.PushPlayer(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		-- Soft-release: keep world ownership so others can contest; clear profile sync only
		firstOutpostLogged[player.UserId] = nil
	end)

	-- Capture loop
	task.spawn(function()
		local tickSec = TerritoryConfig.CaptureTickSeconds or 0.5
		while true do
			local dt = tickSec
			task.wait(dt)
			ensureRuntime()
			local anyProgress = false
			for _, rt in pairs(territories) do
				local before = rt.Progress
				local beforeCap = rt.CapturingUserId
				tickTerritory(rt, dt)
				if rt.Progress ~= before or rt.CapturingUserId ~= beforeCap or rt.Contested then
					anyProgress = true
				end
			end
			-- Throttle full pushes; skip when idle and recently pushed
			local now = os.clock()
			if anyProgress or pushDirty or (now - lastPushAt >= 2.0) then
				if now - lastPushAt >= (if anyProgress then 0.5 else 2.0) then
					TerritoryService.PushAll()
					pushDirty = false
				end
			end
		end
	end)

	if RunService:IsStudio() then
		print("[TerritoryService] Initialized", (function()
			local n = 0
			for _ in pairs(TerritoryConfig.Territories) do
				n += 1
			end
			return n
		end)(), "territories")
	end
end

return TerritoryService
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">TerritoryCapture</string>
              <string name="Source"><![CDATA[--!strict
--[[ Capture-zone presence + tick helpers (spatial checks). ]]

local Players = game:GetService("Players")

local TerritoryCapture = {}

-- Squared-distance presence test (flat XZ) without changing capture rules.
function TerritoryCapture.PlayersInZone(rt: any): { Player }
	local found: { Player } = {}
	local marker = rt.Marker
	local center = if marker then marker.Position else rt.Def.Position
	local radius = rt.Def.Radius
	if marker then
		local half = marker.Size.Magnitude * 0.5
		radius = math.max(radius, half)
	end
	local radiusSq = radius * radius

	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local dx = root.Position.X - center.X
			local dz = root.Position.Z - center.Z
			if dx * dx + dz * dz <= radiusSq then
				table.insert(found, player)
			end
		end
	end
	return found
end

return TerritoryCapture
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">TerritoryOwnership</string>
              <string name="Source"><![CDATA[--!strict
--[[ Ownership sync, bonus aggregation, radar entitlement helpers. ]]

local TerritoryOwnership = {}

export type Bindings = {
	territories: { [string]: any },
	ownerTypes: () -> any,
	DataService: any,
}

local B: Bindings

function TerritoryOwnership.Bind(bindings: Bindings)
	B = bindings
end

function TerritoryOwnership.CountPersonal(userId: number): number
	local n = 0
	local ot = B.ownerTypes()
	for _, rt in pairs(B.territories) do
		if rt.OwnerType == ot.Player and rt.OwnerUserId == userId then
			n += 1
		end
	end
	return n
end

function TerritoryOwnership.SyncProfile(player: Player)
	local profile = B.DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.Territories) ~= "table" then
		profile.Territories = {}
	end
	for id in pairs(profile.Territories) do
		profile.Territories[id] = nil
	end
	local ot = B.ownerTypes()
	for id, rt in pairs(B.territories) do
		if rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId then
			profile.Territories[id] = true
		end
	end
	B.DataService.MarkDirty(player)
end

function TerritoryOwnership.BonusesForPlayer(player: Player): { [string]: number }
	local bonuses: { [string]: number } = {}
	local profile = B.DataService and B.DataService.GetProfile(player)
	local clanId = if profile then profile.ClanId else nil
	local ot = B.ownerTypes()
	for _, rt in pairs(B.territories) do
		local owns = (rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId)
			or (rt.OwnerType == ot.Clan and clanId ~= nil and rt.ClanId == clanId)
		if owns then
			local key = rt.Def.BonusType
			local value = rt.Def.BonusValue
			bonuses[key] = (bonuses[key] or 0) + value
		end
	end
	return bonuses
end

function TerritoryOwnership.HasRadar(player: Player): boolean
	local b = TerritoryOwnership.BonusesForPlayer(player)
	return (b.MinimapReveal or 0) > 0
end

return TerritoryOwnership
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">TerritoryRadar</string>
              <string name="Source"><![CDATA[--!strict
--[[ Radar / minimap reveal helpers + tag-list cache for markers. ]]

local CollectionService = game:GetService("CollectionService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)

local TerritoryRadar = {}

local _cache: { [string]: { at: number, list: { Instance } } } = {}
local TTL = 2.5

function TerritoryRadar.GetTaggedCached(tag: string): { Instance }
	local now = os.clock()
	local entry = _cache[tag]
	if entry and (now - entry.at) < TTL then
		return entry.list
	end
	local list = CollectionService:GetTagged(tag)
	_cache[tag] = { at = now, list = list }
	return list
end

function TerritoryRadar.Invalidate()
	table.clear(_cache)
end

function TerritoryRadar.FindMarker(territoryId: string): BasePart?
	for _, inst in ipairs(TerritoryRadar.GetTaggedCached(Constants.Tags.CaptureZone)) do
		if inst:IsA("BasePart") and inst:GetAttribute("TerritoryId") == territoryId then
			return inst
		end
	end
	for _, inst in ipairs(TerritoryRadar.GetTaggedCached(Constants.Tags.Territory)) do
		if inst:IsA("BasePart") and (inst:GetAttribute("TerritoryId") == territoryId or inst.Name == territoryId) then
			return inst
		end
	end
	return nil
end

function TerritoryRadar.RevealRadius(): number
	return TerritoryConfig.RadarRevealRadius or 220
end

return TerritoryRadar
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MVP interactive tutorial: claim base → command center → income → barracks → jeep → outpost
	Server-authoritative step advancement; client shows UI + optional markers.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local TutorialConfig = require(Shared.Configs.TutorialConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local DevConfig = require(Shared.Configs.DevConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local TutorialService = {}

local DataService: any = nil
local RemoteSetup: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil

local STEP_CLAIM = 1
local STEP_COMMAND = 2
local STEP_INCOME = 3
local STEP_BARRACKS = 4
local STEP_JEEP = 5
local STEP_OUTPOST = 6

local function tutorialEnabled(): boolean
	if not GameConfig.TutorialEnabled or not TutorialConfig.Enabled then
		return false
	end
	return true
end

local function pushTutorial(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local remote = RemoteSetup.Get(Constants.RemoteNames.TutorialStateUpdate) :: RemoteEvent
	local stepIndex = profile.TutorialStep
	local stepDef = if not profile.TutorialComplete then TutorialConfig.GetStep(stepIndex) else nil
	remote:FireClient(player, {
		Step = stepIndex,
		Complete = profile.TutorialComplete == true,
		Total = TutorialConfig.StepCount(),
		Id = if stepDef then stepDef.Id else nil,
		Title = if stepDef then stepDef.Title else nil,
		Hint = if stepDef then stepDef.Hint else nil,
		MarkerName = if stepDef then stepDef.MarkerName else nil,
		HighlightHint = if stepDef then stepDef.HighlightHint else nil,
	})
end

function TutorialService.Push(player: Player)
	pushTutorial(player)
end

local function setStep(player: Player, step: number, complete: boolean?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.TutorialStep = step
	if complete then
		profile.TutorialComplete = true
	end
	DataService.MarkDirty(player)
	pushTutorial(player)
	if complete and NotificationService then
		NotificationService.Notify(player, "Tutorial complete — BUILD. CONQUER. DOMINATE.", "Success")
	end
end

local function advanceTo(player: Player, targetStep: number)
	local profile = DataService.GetProfile(player)
	if not profile or profile.TutorialComplete then
		return
	end
	if profile.TutorialStep < targetStep then
		return
	end
	if profile.TutorialStep ~= targetStep then
		return
	end
	local nextStep = targetStep + 1
	if nextStep > TutorialConfig.StepCount() then
		setStep(player, nextStep, true)
	else
		setStep(player, nextStep, false)
		local def = TutorialConfig.GetStep(nextStep)
		if def and NotificationService then
			NotificationService.Notify(player, def.Title .. ": " .. def.Hint, "Info", 6)
		end
	end
end

function TutorialService.Complete(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.TutorialComplete = true
	profile.TutorialStep = TutorialConfig.StepCount() + 1
	DataService.MarkDirty(player)
	pushTutorial(player)
	if NotificationService then
		NotificationService.Notify(player, "Tutorial skipped.", "Info")
	end
end

function TutorialService.Reset(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.TutorialComplete = false
	profile.TutorialStep = STEP_CLAIM
	DataService.MarkDirty(player)
	pushTutorial(player)
end

--[[
	event types: PlotAssigned | Upgrade | PassiveIncome | SpawnVehicle | CaptureTerritory
]]
function TutorialService.Notify(player: Player, eventType: string, detail: any?)
	if not tutorialEnabled() then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile or profile.TutorialComplete then
		return
	end

	local step = profile.TutorialStep
	if step < 1 then
		profile.TutorialStep = STEP_CLAIM
		step = STEP_CLAIM
		DataService.MarkDirty(player)
	end

	if eventType == "PlotAssigned" and step == STEP_CLAIM then
		advanceTo(player, STEP_CLAIM)
	elseif eventType == "Upgrade" and typeof(detail) == "string" then
		if detail == "CommandCenter" and step == STEP_COMMAND then
			advanceTo(player, STEP_COMMAND)
		elseif detail == "Barracks" and step == STEP_BARRACKS then
			advanceTo(player, STEP_BARRACKS)
		end
	elseif eventType == "PassiveIncome" and step == STEP_INCOME then
		advanceTo(player, STEP_INCOME)
	elseif eventType == "SpawnVehicle" and step == STEP_JEEP then
		-- MilitaryJeep or any vehicle spawn satisfies jeep step
		advanceTo(player, STEP_JEEP)
	elseif eventType == "CaptureTerritory" and step == STEP_OUTPOST then
		advanceTo(player, STEP_OUTPOST)
	end
end

function TutorialService.Init(deps: { [string]: any })
	DataService = deps.DataService
	RemoteSetup = deps.RemoteSetup
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService

	local skipRemote = RemoteSetup.Get(Constants.RemoteNames.RequestSkipTutorial) :: RemoteEvent
	skipRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "tutorial_skip", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		TutorialService.Complete(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if not tutorialEnabled() then
			profile.TutorialComplete = true
			pushTutorial(player)
			return
		end
		if RunService:IsStudio() and DevConfig.SkipTutorial then
			-- DataService already may have set TutorialComplete
			pushTutorial(player)
			return
		end
		if profile.TutorialComplete then
			pushTutorial(player)
			return
		end
		if typeof(profile.TutorialStep) ~= "number" or profile.TutorialStep < 1 then
			profile.TutorialStep = STEP_CLAIM
			DataService.MarkDirty(player)
		end
		pushTutorial(player)
		-- Plot assignment counts as claim-base progress
		task.defer(function()
			if profile.BasePlotId then
				TutorialService.Notify(player, "PlotAssigned")
			end
		end)
	end)

	-- Upgrade hook
	if deps.BaseService and deps.BaseService.GetUpgradeChangedEvent then
		deps.BaseService.GetUpgradeChangedEvent().Event:Connect(function(userId: number, _plotId: any, structureId: string, level: number)
			if level < 1 then
				return
			end
			local player = Players:GetPlayerByUserId(userId)
			if player then
				TutorialService.Notify(player, "Upgrade", structureId)
			end
		end)
	end
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">UpgradePadService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SERVER-AUTHORITATIVE walk-over upgrade purchase.

	Primary buy path: Touched on WE_UpgradeSlot plinths + spatial HRP check.
	Validates PlotId == profile.BasePlotId (Studio: teleport home instead of silent fail),
	debounces per player+structure, then BaseService.PurchaseUpgrade.
	Client WorldPromptController FireServer remains secondary (B-menu / backup).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)

local UpgradePadService = {}

local DataService: any = nil
local BaseService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil

local TAG = Constants.Tags.UpgradeSlot
local DEBOUNCE_SEC = 1.0
local OVERLAP_MARGIN = 4.0 -- wide AABB so kits / edges never miss
local SPATIAL_INTERVAL = 0.2

local lastAttempt: { [string]: number } = {}
local attached: { [BasePart]: boolean } = {}
local partConns: { [BasePart]: { RBXScriptConnection } } = {}
local lastOverlap: { [string]: boolean } = {}

local function attemptKey(userId: number, structureId: string): string
	return tostring(userId) .. "|" .. structureId
end

local function padKey(part: BasePart, structureId: string): string
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" then
		return tostring(pid) .. "|" .. structureId
	end
	return structureId
end

local function trackConn(part: BasePart, conn: RBXScriptConnection)
	local list = partConns[part]
	if not list then
		list = {}
		partConns[part] = list
	end
	table.insert(list, conn)
end

local function detach(part: BasePart)
	local list = partConns[part]
	if list then
		for _, c in ipairs(list) do
			c:Disconnect()
		end
		partConns[part] = nil
	end
	attached[part] = nil
end

local function hardenPad(part: BasePart)
	part.CanTouch = true
	part.CanCollide = true
	part.CanQuery = true
	for _, child in ipairs(part:GetDescendants()) do
		if child:IsA("BasePart") then
			child.CanTouch = false
			child.CanQuery = false
		end
	end
end

local function pointInPad(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	return math.abs(localPos.X) <= half.X + OVERLAP_MARGIN
		and math.abs(localPos.Z) <= half.Z + OVERLAP_MARGIN
		and localPos.Y >= -half.Y - 4
		and localPos.Y <= half.Y + 12
end

local function isSeated(character: Model): boolean
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local seat = hum.SeatPart
	if seat == nil then
		return false
	end
	return seat:IsA("VehicleSeat") or seat:IsA("Seat")
end

local function flashPad(part: BasePart)
	local original = part.Color
	local originalMat = part.Material
	part.Color = Color3.fromRGB(80, 255, 120)
	part.Material = Enum.Material.Neon
	task.delay(0.35, function()
		if part.Parent then
			part.Color = original
			part.Material = originalMat
		end
	end)
end

local function notifyPurchaseResult(player: Player, structureId: string, result: any)
	if not NotificationService then
		return
	end
	if result.Ok then
		local def = BaseConfig.Structures[structureId]
		local name = if def then def.DisplayName else tostring(structureId)
		NotificationService.Notify(
			player,
			string.format("✓ %s → Lv %d", name, result.NewLevel or 0),
			"Success",
			4
		)
	else
		local err = result.Error or "Failed"
		local msg = if err == "InsufficientCash"
			then "Not enough cash"
			elseif err == "InsufficientGold"
			then "Not enough gold"
			elseif err == "MaxLevel"
			then "Already at MAX level"
			elseif err == "MissingRequirement"
			then "Missing prerequisite structure"
			elseif err == "UnknownStructure" or err == "InvalidStructure"
			then "Unknown structure"
			elseif err == "WrongPlot"
			then "Not your base — walk your plot pads to buy"
			else ("Purchase failed: " .. tostring(err))
		if err == "MaxLevel" then
			NotificationService.Notify(player, msg, "Info", 2)
		else
			NotificationService.Notify(player, msg, "Warn", 3.5)
		end
	end
end

local function tryServerPurchase(player: Player, part: BasePart, structureId: string, fromStanding: boolean?)
	local profile = DataService.GetProfile(player)
	if not profile then
		print(string.format("[UpgradePad] BUY FAIL %s %s — NoProfile", player.Name, structureId))
		return
	end

	-- Studio solo: if BasePlotId nil, force-assign plot 1
	if RunService:IsStudio() and profile.BasePlotId == nil then
		if BaseService and BaseService.AssignPlot then
			BaseService.AssignPlot(player)
			profile = DataService.GetProfile(player) or profile
		end
		if profile.BasePlotId == nil then
			profile.BasePlotId = 1
		end
	end

	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" and profile.BasePlotId ~= nil and pid ~= profile.BasePlotId then
		local key = attemptKey(player.UserId, structureId)
		local now = os.clock()
		local last = lastAttempt[key] or 0
		if now - last >= DEBOUNCE_SEC then
			lastAttempt[key] = now
			-- Always teleport + toast so WrongPlot never silent-fails (esp. Studio)
			if BaseService and BaseService.TeleportToPlot then
				BaseService.TeleportToPlot(player)
			end
			print(string.format("[UpgradePad] WrongPlot %s tried plot=%s own=%s → teleport", player.Name, tostring(pid), tostring(profile.BasePlotId)))
			if NotificationService then
				NotificationService.Notify(player, "Not your base — teleported to YOUR plot", "Warn", 2.5)
			end
		end
		return
	end

	local key = attemptKey(player.UserId, structureId)
	local now = os.clock()
	local last = lastAttempt[key] or 0
	if now - last < DEBOUNCE_SEC then
		return
	end

	local def = BaseConfig.Structures[structureId]
	local current = profile.BaseUpgrades[structureId] or 0
	if def and current >= def.MaxLevel then
		lastAttempt[key] = now
		if not fromStanding then
			notifyPurchaseResult(player, structureId, { Ok = false, Error = "MaxLevel" })
		end
		return
	end

	lastAttempt[key] = now

	if RateLimitService and not RateLimitService.Allow(player, "purchase_upgrade", 6, 8) then
		print(string.format("[UpgradePad] BUY RATE-LIMIT %s %s", player.Name, structureId))
		if NotificationService and not fromStanding then
			NotificationService.Notify(player, "Buying too fast — wait a moment", "Warn", 2.5)
		end
		return
	end

	print(string.format("[UpgradePad] BUY ATTEMPT %s %s plot=%s standing=%s", player.Name, structureId, tostring(profile.BasePlotId), tostring(fromStanding == true)))
	local result = BaseService.PurchaseUpgrade(player, structureId)
	if result.Ok then
		print(string.format("[UpgradePad] BUY OK %s %s → Lv %s", player.Name, structureId, tostring(result.NewLevel)))
	else
		print(string.format("[UpgradePad] BUY FAIL %s %s → %s", player.Name, structureId, tostring(result.Error)))
	end
	notifyPurchaseResult(player, structureId, result)
	if result.Ok then
		flashPad(part)
	end
end

local function onPadTouched(part: BasePart, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end
	if isSeated(character) then
		return
	end
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end
	local key = padKey(part, structureId) .. "|" .. tostring(player.UserId)
	if lastOverlap[key] then
		return
	end
	lastOverlap[key] = true
	tryServerPurchase(player, part, structureId, false)
end

local function attachSlot(part: BasePart)
	if attached[part] then
		hardenPad(part)
		return
	end
	if not part:IsA("BasePart") then
		return
	end
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end

	attached[part] = true
	hardenPad(part)

	trackConn(part, part.Touched:Connect(function(hit)
		if hit:IsA("BasePart") then
			onPadTouched(part, hit)
		end
	end))

	trackConn(part, part.TouchEnded:Connect(function(hit)
		if not hit:IsA("BasePart") then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		if not character then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local sid = part:GetAttribute("StructureId")
		if typeof(sid) ~= "string" then
			return
		end
		local key = padKey(part, sid) .. "|" .. tostring(player.UserId)
		task.defer(function()
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and pointInPad(hrp.Position, part) then
				return
			end
			lastOverlap[key] = false
		end)
	end))

	trackConn(part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			detach(part)
		end
	end))
end

local function countAttached(): number
	local n = 0
	for part in pairs(attached) do
		if part.Parent then
			n += 1
		end
	end
	return n
end

local function scanAndTagFromSetup(): number
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		return 0
	end
	local bases = setup:FindFirstChild("Bases")
	if not bases then
		return 0
	end
	local retagged = 0
	for _, desc in ipairs(bases:GetDescendants()) do
		if desc:IsA("BasePart") then
			local sid = desc:GetAttribute("StructureId")
			local pid = desc:GetAttribute("PlotId")
			if typeof(sid) == "string" and typeof(pid) == "number" then
				if not CollectionService:HasTag(desc, TAG) then
					CollectionService:AddTag(desc, TAG)
				end
				hardenPad(desc)
				attachSlot(desc)
				retagged += 1
			end
		end
	end
	return retagged
end

local function bindExistingAndFuture()
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") then
			attachSlot(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			attachSlot(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			detach(inst)
		end
	end)
end

local function startSpatialLoop()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < SPATIAL_INTERVAL then
			return
		end
		acc = 0

		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if character then
				if isSeated(character) then
					local uid = tostring(player.UserId)
					local suffix = "|" .. uid
					for key in pairs(lastOverlap) do
						if string.sub(key, -#suffix) == suffix then
							lastOverlap[key] = false
						end
					end
				else
					local hrp = character:FindFirstChild("HumanoidRootPart")
					if hrp and hrp:IsA("BasePart") then
						local pos = hrp.Position
						for part in pairs(attached) do
							if part.Parent then
								local structureId = part:GetAttribute("StructureId")
								if typeof(structureId) == "string" then
									local key = padKey(part, structureId) .. "|" .. tostring(player.UserId)
									local inside = pointInPad(pos, part)
									if inside then
										if not lastOverlap[key] then
											lastOverlap[key] = true
											tryServerPurchase(player, part, structureId, false)
										else
											tryServerPurchase(player, part, structureId, true)
										end
									elseif lastOverlap[key] then
										lastOverlap[key] = false
									end
								end
							end
						end
					end
				end
			end
		end
	end)
end

function UpgradePadService.Init(deps: { [string]: any })
	DataService = deps.DataService
	BaseService = deps.BaseService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService

	bindExistingAndFuture()
	local initCount = countAttached()
	print(string.format("[WAR EMPIRE] UpgradePadService Init: attached=%d tagged=%d", initCount, #CollectionService:GetTagged(TAG)))
	if initCount == 0 then
		local scanned = scanAndTagFromSetup()
		print(string.format("[WAR EMPIRE] UpgradePadService: scanned Bases → attached=%d", scanned))
	end

	startSpatialLoop()

	task.defer(function()
		task.wait(1)
		for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
			if inst:IsA("BasePart") then
				attachSlot(inst)
			end
		end
		local after = countAttached()
		print(string.format("[WAR EMPIRE] UpgradePadService after-map: attached=%d", after))
		if after == 0 then
			local scanned = scanAndTagFromSetup()
			warn(string.format("[WAR EMPIRE] UpgradePadService: ZERO pads after map — Bases scan attached=%d", scanned))
		end
	end)

	print("[WAR EMPIRE] UpgradePadService ready (server walk-over buy, margin=" .. tostring(OVERLAP_MARGIN) .. ")")
end

return UpgradePadService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 4/7 — Vehicles & garage (server-authoritative).
	Validates ownership, level, structure, prestige/rebirth flags, cash, cooldown.
	Spawns Part kits by VehicleDef.KitFamily (scalable to 100+) near WE_VehicleSpawn / WE_NavalSpawn.
	Visual kits v2: multi-part silhouettes (cabin/wheels/turret/lights/exhaust; air rotors+disc; naval wake).
	Optional MeshAssetId reserved for future MeshPart swap (0 = Part kit).
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

type VehicleDef = VehicleConfig.VehicleDef

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)
local VisualAssetService = require(script.Parent.VisualAssetService)

local VehicleService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local TerritoryService: any = nil
local MissionService: any = nil
local TutorialService: any = nil

local activeVehicles: { [number]: Model } = {}
local lastSpawnAt: { [number]: number } = {}
local airDriveConns: { [number]: RBXScriptConnection } = {}
local vehicleFolder: Folder? = nil

local function now(): number
	return os.clock()
end

local function ensureFolder(): Folder
	if vehicleFolder and vehicleFolder.Parent then
		return vehicleFolder
	end
	local existing = Workspace:FindFirstChild("WarEmpireVehicles")
	if existing and existing:IsA("Folder") then
		vehicleFolder = existing
		return vehicleFolder
	end
	local folder = Instance.new("Folder")
	folder.Name = "WarEmpireVehicles"
	folder.Parent = Workspace
	vehicleFolder = folder
	return folder
end

local function getDef(vehicleId: string): VehicleDef?
	return VehicleConfig.Vehicles[vehicleId]
end

local function cooldownLeft(userId: number, player: Player?): number
	local last = lastSpawnAt[userId]
	if not last then
		return 0
	end
	local cd = VehicleConfig.SpawnCooldownSeconds or 15
	if player and TerritoryService and TerritoryService.GetVehicleCooldownMult then
		cd = cd * math.max(0.1, TerritoryService.GetVehicleCooldownMult(player))
	end
	return math.max(0, cd - (now() - last))
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local active = activeVehicles[player.UserId]
	local activeId: string? = nil
	if active and active.Parent then
		local id = active:GetAttribute("VehicleId")
		if typeof(id) == "string" then
			activeId = id
		end
	end
	local payload: Types.VehicleStatePayload = {
		Owned = profile.Vehicles,
		ActiveVehicleId = activeId,
		CooldownRemaining = cooldownLeft(player.UserId, player),
	}
	local remote = RemoteSetup.Get(Constants.RemoteNames.VehicleStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

local function stopAirDrive(userId: number)
	local conn = airDriveConns[userId]
	if conn then
		conn:Disconnect()
		airDriveConns[userId] = nil
	end
end

local function destroyActive(userId: number)
	stopAirDrive(userId)
	local model = activeVehicles[userId]
	activeVehicles[userId] = nil
	if model then
		-- Ensure kit parts / welds / seats are fully cleaned
		if model.Parent then
			model:Destroy()
		else
			pcall(function()
				model:Destroy()
			end)
		end
	end
end

local function findSpawnCFrame(player: Player, category: string?): CFrame
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local origin = if root then root.Position else Vector3.zero
	local best: CFrame? = nil
	local bestDist = math.huge
	local preferNaval = category == "Naval"
	local tagList = if preferNaval
		then { Constants.Tags.NavalSpawn, Constants.Tags.VehicleSpawn }
		else { Constants.Tags.VehicleSpawn }

	for _, tag in ipairs(tagList) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			if inst:IsA("BasePart") then
				local d = (inst.Position - origin).Magnitude
				local yOff = if tag == Constants.Tags.NavalSpawn then 3 else 4
				if d < bestDist then
					bestDist = d
					best = inst.CFrame + Vector3.new(0, yOff, 0)
				end
			end
		end
		-- Prefer nearest naval pad within 800 studs; don't fall through to land pads if found
		if preferNaval and best and bestDist < 1400 then
			return best
		end
		if (not preferNaval) and best and bestDist < 500 then
			return best
		end
	end
	if best and bestDist < 800 then
		return best
	end

	local profile = DataService.GetProfile(player)
	if profile and profile.BasePlotId then
		for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
			if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == profile.BasePlotId then
				return inst.CFrame + Vector3.new(0, 5, 40)
			end
		end
	end

	if root then
		return root.CFrame * CFrame.new(0, 3, -12)
	end
	return CFrame.new(0, 5, 0)
end

local function weldTo(body: BasePart, other: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = other
	w.Parent = body
end

local function addPart(
	model: Model,
	body: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?,
	collide: boolean?
): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	p.CFrame = body.CFrame * offset
	p.Anchored = false
	p.CanCollide = if collide == nil then false else collide
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	weldTo(body, p)
	return p
end

local function addWheels(model: Model, body: BasePart, scale: number, positions: { Vector3 }, radius: number?)
	local r = radius or 1.1
	for i, offset in ipairs(positions) do
		local wheel = Instance.new("Part")
		wheel.Name = "Wheel" .. i
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = Vector3.new(r * 0.9, r * 1.8 * scale, r * 1.8 * scale)
		wheel.Color = Color3.fromRGB(22, 22, 24)
		wheel.Material = Enum.Material.SmoothPlastic
		wheel.CFrame = body.CFrame * CFrame.new(offset * scale) * CFrame.Angles(0, 0, math.rad(90))
		wheel.Anchored = false
		wheel.CanCollide = true
		wheel.Massless = false
		wheel.Parent = model
		weldTo(body, wheel)
		-- Hub cap accent (visual kits v2)
		local hub = Instance.new("Part")
		hub.Name = "Hub" .. i
		hub.Shape = Enum.PartType.Cylinder
		hub.Size = Vector3.new(r * 0.35, r * 0.7 * scale, r * 0.7 * scale)
		hub.Color = Color3.fromRGB(90, 95, 100)
		hub.Material = Enum.Material.Metal
		hub.CFrame = wheel.CFrame
		hub.Anchored = false
		hub.CanCollide = false
		hub.Massless = true
		hub.Parent = model
		weldTo(body, hub)
	end
end

-- Visual kits v2 shared accents (keep part counts modest)
local function addHeadlights(model: Model, body: BasePart, s: number, zFront: number, y: number, spacing: number, col: Color3?)
	local c = col or Color3.fromRGB(255, 240, 180)
	addPart(model, body, "LightL", Vector3.new(0.45 * s, 0.35 * s, 0.35 * s), CFrame.new(-spacing * s, y * s, zFront * s), c, Enum.Material.Neon, nil, false)
	addPart(model, body, "LightR", Vector3.new(0.45 * s, 0.35 * s, 0.35 * s), CFrame.new(spacing * s, y * s, zFront * s), c, Enum.Material.Neon, nil, false)
end

local function addTaillights(model: Model, body: BasePart, s: number, zRear: number, y: number, spacing: number)
	local c = Color3.fromRGB(220, 50, 40)
	addPart(model, body, "TailL", Vector3.new(0.4 * s, 0.3 * s, 0.25 * s), CFrame.new(-spacing * s, y * s, zRear * s), c, Enum.Material.Neon, nil, false)
	addPart(model, body, "TailR", Vector3.new(0.4 * s, 0.3 * s, 0.25 * s), CFrame.new(spacing * s, y * s, zRear * s), c, Enum.Material.Neon, nil, false)
end

local function addExhaust(model: Model, body: BasePart, s: number, offset: CFrame, accent: Color3)
	addPart(model, body, "Exhaust", Vector3.new(0.35 * s, 0.35 * s, 1.4 * s), offset, Color3.fromRGB(35, 35, 38), Enum.Material.Metal, Enum.PartType.Cylinder, false)
	addPart(model, body, "ExhaustGlow", Vector3.new(0.28 * s, 0.28 * s, 0.35 * s), offset * CFrame.new(0, 0, 0.7 * s), accent, Enum.Material.Neon, Enum.PartType.Cylinder, false)
end

local function addRotorDisc(model: Model, body: BasePart, s: number, y: number, radius: number, accent: Color3)
	-- Thin neon disc under rotor (silhouette read at distance)
	local disc = addPart(
		model,
		body,
		"RotorDisc",
		Vector3.new(0.08 * s, radius * 2 * s, radius * 2 * s),
		CFrame.new(0, y * s, -0.3 * s) * CFrame.Angles(0, 0, math.rad(90)),
		accent,
		Enum.Material.Neon,
		Enum.PartType.Cylinder,
		false
	)
	disc.Transparency = 0.55
end

local function addWakeStrip(model: Model, body: BasePart, s: number, length: number, accent: Color3)
	addPart(model, body, "WakeNeon", Vector3.new(0.35 * s, 0.12 * s, length * s), CFrame.new(0, -0.7 * s, 0.5 * s), accent, Enum.Material.Neon, nil, false)
end

local function addSideRails(model: Model, body: BasePart, s: number, length: number, height: number, width: number, color: Color3)
	addPart(model, body, "RailL", Vector3.new(0.2 * s, 0.25 * s, length * s), CFrame.new(-width * s, height * s, 0), color, Enum.Material.Metal, nil, false)
	addPart(model, body, "RailR", Vector3.new(0.2 * s, 0.25 * s, length * s), CFrame.new(width * s, height * s, 0), color, Enum.Material.Metal, nil, false)
end

local function addLabel(parent: BasePart, text: string, y: number)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "VehicleLabel"
	billboard.Size = UDim2.fromOffset(150, 36)
	billboard.StudsOffset = Vector3.new(0, y, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 280
	billboard.Parent = parent
	local backdrop = Instance.new("Frame")
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(12, 14, 16)
	backdrop.BackgroundTransparency = 0.25
	backdrop.BorderSizePixel = 0
	backdrop.Parent = billboard
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 5)
	c.Parent = backdrop
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(230, 190, 60)
	stroke.Thickness = 1
	stroke.Transparency = 0.35
	stroke.Parent = backdrop
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(235, 238, 242)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.Parent = backdrop
end

local function buildVehicleModel(def: VehicleDef, at: CFrame, ownerUserId: number): Model
	local model = Instance.new("Model")
	model.Name = def.DisplayName
	model:SetAttribute("VehicleId", def.Id)
	model:SetAttribute("OwnerUserId", ownerUserId)

	local id = def.Id
	local family = def.KitFamily or "WheeledLight"
	local scale = if typeof(def.KitScale) == "number" then def.KitScale :: number else 1
	local olive = Color3.fromRGB(55, 70, 48)
	local oliveDark = Color3.fromRGB(40, 50, 38)
	local armor = Color3.fromRGB(62, 68, 55)
	local armorDark = Color3.fromRGB(45, 50, 42)
	local sand = Color3.fromRGB(110, 100, 70)
	local accent = Color3.fromRGB(230, 190, 60)
	local blueAcc = Color3.fromRGB(90, 160, 220)
	local redAcc = Color3.fromRGB(200, 80, 60)
	local sky = Color3.fromRGB(70, 90, 110)
	local rarity = def.Rarity or "Common"
	local accentCol = if rarity == "Legendary"
		then redAcc
		elseif rarity == "Epic" then accent
		elseif rarity == "Rare" then blueAcc
		else accent

	local body = Instance.new("Part")
	body.Name = "Chassis"
	body.Anchored = false
	body.CanCollide = true
	body.Material = Enum.Material.Metal
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.CFrame = at
	body.Parent = model

	local seatOffset = CFrame.new(0, 2.0, -0.5)
	local labelY = 4.5
	local s = scale

	local function kitWheeledLight()
		local armed = id == "ArmedJeep"
		local scout = id == "ScoutCar" or id == "ReconBuggy"
		local quad = id == "UtilityQuad"
		body.Size = Vector3.new(5.2 * s, 1.6 * s, if quad then 6.5 * s else 8.5 * s)
		body.Color = if armed then Color3.fromRGB(48, 58, 42) elseif scout then Color3.fromRGB(70, 85, 55) else olive
		addPart(model, body, "Hood", Vector3.new(4.6 * s, 0.7 * s, 2.8 * s), CFrame.new(0, 0.9 * s, -2.4 * s), oliveDark, Enum.Material.Metal, nil, false)
		addPart(model, body, "Cabin", Vector3.new(4.4 * s, 1.4 * s, 2.8 * s), CFrame.new(0, 1.3 * s, 0.2 * s), oliveDark, Enum.Material.SmoothPlastic, nil, true)
		if not quad then
			addPart(model, body, "Bed", Vector3.new(4.4 * s, 0.9 * s, 2.6 * s), CFrame.new(0, 0.7 * s, 2.6 * s), olive, Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Bumper", Vector3.new(5.0 * s, 0.5 * s, 0.4 * s), CFrame.new(0, -0.3 * s, -4.0 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
		addPart(model, body, "AccentStrip", Vector3.new(4.8 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.1 * s, -1.2 * s), if armed then redAcc else accentCol, Enum.Material.Neon, nil, false)
		if armed then
			addPart(model, body, "GunMount", Vector3.new(0.8 * s, 0.8 * s, 0.8 * s), CFrame.new(0, 2.2 * s, 0.4 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			addPart(model, body, "Barrel", Vector3.new(0.25 * s, 0.25 * s, 2.4 * s), CFrame.new(0, 2.5 * s, -1.0 * s), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, false)
		end
		addWheels(model, body, s, {
			Vector3.new(-2.4, -0.9, 2.6),
			Vector3.new(2.4, -0.9, 2.6),
			Vector3.new(-2.4, -0.9, -2.6),
			Vector3.new(2.4, -0.9, -2.6),
		}, 1.05)
		addHeadlights(model, body, s, -4.1, 0.2, 1.8)
		addTaillights(model, body, s, if quad then 3.0 else 4.0, 0.15, 1.9)
		addExhaust(model, body, s, CFrame.new(1.8 * s, -0.2 * s, 3.2 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		addSideRails(model, body, s, if quad then 4.5 else 5.5, 0.6, 2.5, oliveDark)
		seatOffset = CFrame.new(0, 1.9 * s, 0.1 * s)
		labelY = 4.2 * s
	end

	local function kitWheeledTruck()
		local supply = id == "SupplyTruck"
		local fuel = id == "FuelTanker"
		local missile = id == "MissileTruck" or id == "AntiAirTruck"
		local eng = id == "EngineeringTruck"
		body.Size = Vector3.new(6.2 * s, 2.4 * s, 11 * s)
		body.Color = if supply then sand elseif fuel then Color3.fromRGB(90, 95, 55) else armor
		addPart(model, body, "Cabin", Vector3.new(5.6 * s, 2.0 * s, 3.2 * s), CFrame.new(0, 1.6 * s, -3.2 * s), armorDark, Enum.Material.Metal, nil, true)
		addPart(model, body, "Cargo", Vector3.new(5.8 * s, 2.6 * s, 6.5 * s), CFrame.new(0, 1.4 * s, 2.0 * s), if supply then Color3.fromRGB(130, 115, 75) elseif fuel then Color3.fromRGB(70, 80, 45) else sand, Enum.Material.Metal, nil, true)
		addPart(model, body, "Accent", Vector3.new(5.9 * s, 0.15 * s, 0.4 * s), CFrame.new(0, 2.5 * s, -2.0 * s), accentCol, Enum.Material.Neon, nil, false)
		if supply then
			addPart(model, body, "Crate", Vector3.new(3.5 * s, 1.4 * s, 3.5 * s), CFrame.new(0, 3.0 * s, 2.0 * s), Color3.fromRGB(90, 75, 50), Enum.Material.Wood, nil, false)
		elseif fuel then
			addPart(model, body, "Tank", Vector3.new(4.5 * s, 2.2 * s, 5.5 * s), CFrame.new(0, 2.8 * s, 2.0 * s), Color3.fromRGB(80, 85, 50), Enum.Material.Metal, Enum.PartType.Cylinder, false)
		elseif missile then
			addPart(model, body, "Launcher", Vector3.new(4.0 * s, 1.2 * s, 5.0 * s), CFrame.new(0, 3.0 * s, 1.5 * s) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(50, 55, 45), Enum.Material.Metal, nil, false)
		elseif eng then
			addPart(model, body, "Crane", Vector3.new(0.5 * s, 4.0 * s, 0.5 * s), CFrame.new(1.5 * s, 4.0 * s, 1.0 * s), Color3.fromRGB(200, 160, 60), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Bumper", Vector3.new(6.0 * s, 0.55 * s, 0.45 * s), CFrame.new(0, -0.6 * s, -5.2 * s), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil, false)
		addWheels(model, body, 1.15 * s, {
			Vector3.new(-2.8, -1.2, 3.5),
			Vector3.new(2.8, -1.2, 3.5),
			Vector3.new(-2.8, -1.2, 0),
			Vector3.new(2.8, -1.2, 0),
			Vector3.new(-2.8, -1.2, -3.5),
			Vector3.new(2.8, -1.2, -3.5),
		}, 1.2)
		addHeadlights(model, body, s, -5.3, 0.4, 2.2)
		addTaillights(model, body, s, 5.2, 0.3, 2.4)
		addExhaust(model, body, s, CFrame.new(2.4 * s, -0.4 * s, 4.5 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		seatOffset = CFrame.new(0, 2.4 * s, -3.0 * s)
		labelY = 5.5 * s
	end

	local function kitWheeledAPC()
		local carrier = id == "InfantryCarrier"
		local cmd = id == "CommandVehicle"
		body.Size = Vector3.new((if carrier then 7.2 else 6.5) * s, 2.6 * s, (if carrier then 12 else 10.5) * s)
		body.Color = armorDark
		addPart(model, body, "HullTop", Vector3.new(5.8 * s, 1.4 * s, 8.5 * s), CFrame.new(0, 1.8 * s, 0), armor, Enum.Material.Metal, nil, true)
		addPart(model, body, "Turret", Vector3.new(2.4 * s, 1.2 * s, 2.4 * s), CFrame.new(0, 3.0 * s, 0.5 * s), Color3.fromRGB(50, 55, 48), Enum.Material.Metal, nil, false)
		addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 3.2 * s), CFrame.new(0, 3.1 * s, -2.0 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		addPart(model, body, "Accent", Vector3.new(6.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 2.6 * s, -3 * s), accentCol, Enum.Material.Neon, nil, false)
		if cmd then
			addPart(model, body, "Dish", Vector3.new(2.2 * s, 0.3 * s, 2.2 * s), CFrame.new(0, 4.0 * s, 1.5 * s), Color3.fromRGB(80, 90, 100), Enum.Material.Metal, Enum.PartType.Cylinder, false)
		end
		addPart(model, body, "Bumper", Vector3.new(6.2 * s, 0.6 * s, 0.5 * s), CFrame.new(0, -0.7 * s, -5.0 * s), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, false)
		addWheels(model, body, 1.2 * s, {
			Vector3.new(-3.0, -1.3, 3.2),
			Vector3.new(3.0, -1.3, 3.2),
			Vector3.new(-3.0, -1.3, 0.5),
			Vector3.new(3.0, -1.3, 0.5),
			Vector3.new(-3.0, -1.3, -2.5),
			Vector3.new(3.0, -1.3, -2.5),
		}, 1.25)
		addHeadlights(model, body, s, -5.1, 0.2, 2.4)
		addTaillights(model, body, s, 4.8, 0.2, 2.5)
		addExhaust(model, body, s, CFrame.new(2.8 * s, 0.2 * s, 4.0 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		seatOffset = CFrame.new(0, 2.2 * s, -2.5 * s)
		labelY = 5.8 * s
	end

	local function kitTracked(kind: string)
		local isSPAAG = kind == "SPAAG"
		local isArty = kind == "Artillery"
		local isIFV = kind == "IFV"
		body.Size = Vector3.new(6.5 * s, 2.2 * s, 9.5 * s)
		body.Color = if s >= 1.4 then Color3.fromRGB(45, 48, 40) else armor
		addPart(model, body, "TrackL", Vector3.new(1.2 * s, 1.6 * s, 9 * s), CFrame.new(-3.2 * s, -0.4 * s, 0), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, true)
		addPart(model, body, "TrackR", Vector3.new(1.2 * s, 1.6 * s, 9 * s), CFrame.new(3.2 * s, -0.4 * s, 0), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, true)
		if isSPAAG then
			addPart(model, body, "Turret", Vector3.new(3.2 * s, 1.4 * s, 3.2 * s), CFrame.new(0, 2.0 * s, 0), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "BarrelA", Vector3.new(0.3 * s, 0.3 * s, 4.5 * s), CFrame.new(-0.6 * s, 2.4 * s, -3.0 * s) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			addPart(model, body, "BarrelB", Vector3.new(0.3 * s, 0.3 * s, 4.5 * s), CFrame.new(0.6 * s, 2.4 * s, -3.0 * s) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		elseif isArty then
			local rocket = id == "RocketArtillery"
			addPart(model, body, "Turret", Vector3.new(3.4 * s, 1.5 * s, 3.8 * s), CFrame.new(0, 1.9 * s, 0.8 * s), armorDark, Enum.Material.Metal, nil, true)
			if rocket then
				addPart(model, body, "Pod", Vector3.new(3.0 * s, 1.8 * s, 4.5 * s), CFrame.new(0, 3.2 * s, 0.5 * s) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(55, 60, 50), Enum.Material.Metal, nil, false)
			else
				addPart(model, body, "Barrel", Vector3.new(0.5 * s, 0.5 * s, 7 * s), CFrame.new(0, 2.8 * s, -3.5 * s) * CFrame.Angles(math.rad(-15), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			end
		elseif isIFV then
			addPart(model, body, "HullTop", Vector3.new(5.5 * s, 1.2 * s, 7.5 * s), CFrame.new(0, 1.7 * s, 0), armor, Enum.Material.Metal, nil, true)
			addPart(model, body, "Turret", Vector3.new(2.8 * s, 1.3 * s, 3.0 * s), CFrame.new(0, 2.8 * s, 0.3 * s), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 4.2 * s), CFrame.new(0, 2.9 * s, -2.5 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		else
			addPart(model, body, "Turret", Vector3.new(3.6 * s, 1.6 * s, 4.2 * s), CFrame.new(0, 2.0 * s, 0.3 * s), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "Barrel", Vector3.new(0.45 * s, 0.45 * s, 5.5 * s), CFrame.new(0, 2.1 * s, -4.2 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Accent", Vector3.new(3.2 * s, 0.12 * s, 0.3 * s), CFrame.new(0, 2.9 * s, 1.2 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "Mantlet", Vector3.new(2.2 * s, 1.0 * s, 0.6 * s), CFrame.new(0, 2.1 * s, -1.6 * s), armorDark, Enum.Material.Metal, nil, false)
		addHeadlights(model, body, s, -4.6, 0.4, 2.2, Color3.fromRGB(255, 230, 160))
		addExhaust(model, body, s, CFrame.new(2.6 * s, 0.8 * s, 4.0 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		for i, z in ipairs({ 3.2, 1.0, -1.2, -3.2 }) do
			addPart(model, body, "RoadL" .. i, Vector3.new(0.7 * s, 1.3 * s, 1.3 * s), CFrame.new(-3.2 * s, -1.0 * s, z * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 25), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true)
			addPart(model, body, "RoadR" .. i, Vector3.new(0.7 * s, 1.3 * s, 1.3 * s), CFrame.new(3.2 * s, -1.0 * s, z * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 25), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true)
		end
		seatOffset = CFrame.new(0, 2.6 * s, 0.2 * s)
		labelY = 5.5 * s
	end

	local function kitHeli(kind: string)
		local attack = kind == "Attack"
		local light = kind == "Light"
		local transport = kind == "Transport"
		local len = if transport then 12 elseif light then 8.5 else 10
		local wid = if transport then 4.5 elseif light then 2.8 else 3.2
		body.Size = Vector3.new(wid * s, 2.0 * s, len * s)
		body.Color = if id == "StealthHeli" then Color3.fromRGB(25, 30, 38) else sky
		addPart(model, body, "Cockpit", Vector3.new((wid - 0.6) * s, 1.6 * s, 3.2 * s), CFrame.new(0, 0.6 * s, -len * 0.32 * s), Color3.fromRGB(40, 55, 70), Enum.Material.Glass, nil, true)
		if transport then
			addPart(model, body, "Cabin", Vector3.new(4.0 * s, 2.0 * s, 5.5 * s), CFrame.new(0, 0.5 * s, 1.5 * s), sky, Enum.Material.Metal, nil, true)
		end
		addPart(model, body, "Tail", Vector3.new(1.0 * s, 1.0 * s, 5.5 * s), CFrame.new(0, 0.8 * s, len * 0.55 * s), body.Color, Enum.Material.Metal, nil, false)
		addPart(model, body, "TailFin", Vector3.new(0.3 * s, 2.4 * s, 1.6 * s), CFrame.new(0, 2.0 * s, len * 0.72 * s), Color3.fromRGB(50, 65, 80), Enum.Material.Metal, nil, false)
		local rotor = if transport then 16 elseif light then 11 else 14
		addPart(model, body, "RotorHub", Vector3.new(1.2 * s, 0.5 * s, 1.2 * s), CFrame.new(0, 2.0 * s, -0.3 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
		addPart(model, body, "RotorA", Vector3.new(rotor * s, 0.15 * s, 0.6 * s), CFrame.new(0, 2.35 * s, -0.3 * s), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil, false)
		addPart(model, body, "RotorB", Vector3.new(0.6 * s, 0.15 * s, rotor * s), CFrame.new(0, 2.4 * s, -0.3 * s), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil, false)
		addPart(model, body, "SkidL", Vector3.new(0.25 * s, 0.25 * s, 7 * s), CFrame.new(-wid * 0.5 * s, -1.3 * s, 0), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidR", Vector3.new(0.25 * s, 0.25 * s, 7 * s), CFrame.new(wid * 0.5 * s, -1.3 * s, 0), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidPadL", Vector3.new(0.9 * s, 0.2 * s, 1.2 * s), CFrame.new(-wid * 0.5 * s, -1.45 * s, 2 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidPadR", Vector3.new(0.9 * s, 0.2 * s, 1.2 * s), CFrame.new(wid * 0.5 * s, -1.45 * s, 2 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, true)
		addRotorDisc(model, body, s, 2.2, rotor * 0.48, accentCol)
		addPart(model, body, "Accent", Vector3.new((wid - 0.4) * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.2 * s, -1 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "NavLight", Vector3.new(0.35 * s, 0.35 * s, 0.35 * s), CFrame.new(0, 1.6 * s, len * 0.4 * s), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, Enum.PartType.Ball, false)
		if attack then
			addPart(model, body, "StubWingL", Vector3.new(3.5 * s, 0.25 * s, 1.2 * s), CFrame.new(-2.5 * s, 0, 0.5 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, false)
			addPart(model, body, "StubWingR", Vector3.new(3.5 * s, 0.25 * s, 1.2 * s), CFrame.new(2.5 * s, 0, 0.5 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, false)
		end
		seatOffset = CFrame.new(0, 1.2 * s, -2.8 * s)
		labelY = 5.5 * s
	end

	local function kitJet(kind: string)
		local bomber = kind == "Bomber"
		local cargo = kind == "Transport"
		local strike = kind == "Strike"
		local len = if cargo then 16 elseif bomber then 14 else 12
		local wid = if cargo then 3.5 elseif bomber then 2.8 else 2.4
		body.Size = Vector3.new(wid * s, 1.5 * s, len * s)
		body.Color = if cargo then Color3.fromRGB(100, 105, 95) elseif bomber then Color3.fromRGB(70, 75, 80) else Color3.fromRGB(90, 95, 100)
		addPart(model, body, "Nose", Vector3.new((wid - 0.8) * s, 1.0 * s, 3.5 * s), CFrame.new(0, 0.1 * s, -len * 0.48 * s), Color3.fromRGB(70, 75, 80), Enum.Material.Metal, nil, false)
		addPart(model, body, "Cockpit", Vector3.new(1.6 * s, 0.9 * s, 2.2 * s), CFrame.new(0, 0.9 * s, -len * 0.28 * s), Color3.fromRGB(40, 80, 120), Enum.Material.Glass, nil, false)
		local wingSpan = if cargo then 10 elseif bomber then 9 else 7
		addPart(model, body, "WingL", Vector3.new(wingSpan * s, 0.25 * s, 2.8 * s), CFrame.new(-wingSpan * 0.55 * s, 0, 0.5 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		addPart(model, body, "WingR", Vector3.new(wingSpan * s, 0.25 * s, 2.8 * s), CFrame.new(wingSpan * 0.55 * s, 0, 0.5 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		addPart(model, body, "TailFin", Vector3.new(0.25 * s, (if bomber then 3.2 else 2.8) * s, 2.0 * s), CFrame.new(0, 1.8 * s, len * 0.38 * s), Color3.fromRGB(85, 90, 95), Enum.Material.Metal, nil, false)
		if not cargo then
			addPart(model, body, "StabL", Vector3.new(2.5 * s, 0.2 * s, 1.2 * s), CFrame.new(-1.5 * s, 0.8 * s, len * 0.38 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
			addPart(model, body, "StabR", Vector3.new(2.5 * s, 0.2 * s, 1.2 * s), CFrame.new(1.5 * s, 0.8 * s, len * 0.38 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		end
		if strike or kind == "Fighter" then
			addPart(model, body, "IntakeL", Vector3.new(0.9 * s, 0.9 * s, 2.5 * s), CFrame.new(-1.3 * s, -0.2 * s, 1.5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "IntakeR", Vector3.new(0.9 * s, 0.9 * s, 2.5 * s), CFrame.new(1.3 * s, -0.2 * s, 1.5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
		end
		if bomber then
			addPart(model, body, "Bay", Vector3.new((wid - 0.4) * s, 0.8 * s, 4 * s), CFrame.new(0, -0.6 * s, 0.5 * s), Color3.fromRGB(45, 48, 52), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Accent", Vector3.new(2.0 * s, 0.1 * s, 0.3 * s), CFrame.new(0, 0.8 * s, -1 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "EngineGlow", Vector3.new((wid - 0.6) * s, 0.7 * s, 0.5 * s), CFrame.new(0, 0, len * 0.42 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "GearF", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(0, -1.0 * s, -len * 0.3 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true)
		addPart(model, body, "WheelF", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(0, -1.5 * s, -len * 0.3 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true)
		addPart(model, body, "GearL", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(-1.5 * s, -1.0 * s, 1 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true)
		addPart(model, body, "GearR", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(1.5 * s, -1.0 * s, 1 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true)
		addPart(model, body, "WingTipL", Vector3.new(0.3 * s, 0.3 * s, 0.3 * s), CFrame.new(-wingSpan * 0.95 * s, 0.1 * s, 0.5 * s), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, Enum.PartType.Ball, false)
		addPart(model, body, "WingTipR", Vector3.new(0.3 * s, 0.3 * s, 0.3 * s), CFrame.new(wingSpan * 0.95 * s, 0.1 * s, 0.5 * s), Color3.fromRGB(60, 255, 90), Enum.Material.Neon, Enum.PartType.Ball, false)
		seatOffset = CFrame.new(0, 1.3 * s, -len * 0.26 * s)
		labelY = 4.8 * s
	end

	local function kitNaval(kind: string)
		if kind == "Landing" then
			body.Size = Vector3.new(8 * s, 2.0 * s, 16 * s)
			body.Color = Color3.fromRGB(55, 65, 55)
			addPart(model, body, "Deck", Vector3.new(7.2 * s, 0.5 * s, 13 * s), CFrame.new(0, 1.1 * s, 0.5 * s), Color3.fromRGB(70, 80, 65), Enum.Material.Metal, nil, true)
			addPart(model, body, "Ramp", Vector3.new(6.5 * s, 0.4 * s, 4 * s), CFrame.new(0, 0.6 * s, -7.5 * s) * CFrame.Angles(math.rad(-18), 0, 0), Color3.fromRGB(60, 70, 55), Enum.Material.Metal, nil, true)
			addPart(model, body, "Cabin", Vector3.new(3.5 * s, 2.2 * s, 3.0 * s), CFrame.new(0, 2.3 * s, 5.5 * s), Color3.fromRGB(50, 60, 50), Enum.Material.Metal, nil, true)
			addPart(model, body, "WallL", Vector3.new(0.4 * s, 1.6 * s, 12 * s), CFrame.new(-3.6 * s, 1.6 * s, 0), oliveDark, Enum.Material.Metal, nil, false)
			addPart(model, body, "WallR", Vector3.new(0.4 * s, 1.6 * s, 12 * s), CFrame.new(3.6 * s, 1.6 * s, 0), oliveDark, Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(6.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.6 * s, 4 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 12, accentCol)
			addPart(model, body, "GunMount", Vector3.new(1.2 * s, 0.8 * s, 1.2 * s), CFrame.new(0, 2.6 * s, -2 * s), Color3.fromRGB(40, 45, 40), Enum.Material.Metal, nil, false)
			seatOffset = CFrame.new(0, 3.0 * s, 5.2 * s)
			labelY = 6.0 * s
		elseif kind == "Sub" then
			-- Surface stub: low dark hull (no underwater physics yet)
			body.Size = Vector3.new(5 * s, 2.2 * s, 18 * s)
			body.Color = Color3.fromRGB(30, 40, 48)
			addPart(model, body, "Sail", Vector3.new(1.8 * s, 2.8 * s, 4 * s), CFrame.new(0, 2.4 * s, -1 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new(3.5 * s, 1.6 * s, 4 * s), CFrame.new(0, 0.2 * s, -8 * s), Color3.fromRGB(28, 38, 45), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(4.0 * s, 0.12 * s, 0.3 * s), CFrame.new(0, 1.2 * s, 2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 14, accentCol)
			addPart(model, body, "Periscope", Vector3.new(0.25 * s, 2.2 * s, 0.25 * s), CFrame.new(0, 4.2 * s, -1 * s), Color3.fromRGB(50, 55, 60), Enum.Material.Metal, nil, false)
			seatOffset = CFrame.new(0, 3.5 * s, -1 * s)
			labelY = 6.5 * s
		elseif kind == "Capital" then
			body.Size = Vector3.new(8 * s, 2.4 * s, 28 * s)
			body.Color = Color3.fromRGB(40, 55, 70)
			addPart(model, body, "Deck", Vector3.new(7.2 * s, 0.5 * s, 24 * s), CFrame.new(0, 1.3 * s, 0), Color3.fromRGB(50, 65, 80), Enum.Material.Metal, nil, true)
			addPart(model, body, "Superstructure", Vector3.new(4.5 * s, 3.5 * s, 8 * s), CFrame.new(0, 3.2 * s, 2 * s), Color3.fromRGB(45, 60, 75), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bridge", Vector3.new(3.5 * s, 2.0 * s, 3.5 * s), CFrame.new(0, 5.5 * s, 1 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new(5.5 * s, 1.6 * s, 5 * s), CFrame.new(0, 0.6 * s, -12 * s), Color3.fromRGB(45, 60, 75), Enum.Material.Metal, nil, false)
			addPart(model, body, "TurretF", Vector3.new(2.4 * s, 1.2 * s, 2.8 * s), CFrame.new(0, 2.4 * s, -6 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "BarrelF", Vector3.new(0.4 * s, 0.4 * s, 5 * s), CFrame.new(0, 2.6 * s, -9 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
			addPart(model, body, "TurretA", Vector3.new(2.2 * s, 1.1 * s, 2.5 * s), CFrame.new(0, 2.3 * s, 8 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "Stack", Vector3.new(1.8 * s, 3.5 * s, 1.8 * s), CFrame.new(0, 5.5 * s, 5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(6.5 * s, 0.15 * s, 0.4 * s), CFrame.new(0, 1.8 * s, -2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 22, accentCol)
			addPart(model, body, "Mast", Vector3.new(0.35 * s, 6 * s, 0.35 * s), CFrame.new(0, 8.5 * s, 2 * s), Color3.fromRGB(55, 60, 70), Enum.Material.Metal, nil, false)
			addPart(model, body, "RadarDish", Vector3.new(2.4 * s, 0.35 * s, 2.4 * s), CFrame.new(0, 11.5 * s, 2 * s), accentCol, Enum.Material.Neon, Enum.PartType.Cylinder, false)
			seatOffset = CFrame.new(0, 6.2 * s, 1 * s)
			labelY = 9.0 * s
		else
			-- Patrol / Gun
			local gun = kind == "Gun" or id == "Gunboat" or id == "MissileBoat"
			local hull = Color3.fromRGB(45, 70, 85)
			body.Size = Vector3.new((if gun then 6.5 else 5.5) * s, 1.8 * s, (if gun then 14 else 11) * s)
			body.Color = hull
			addPart(model, body, "Deck", Vector3.new((if gun then 5.8 else 4.8) * s, 0.4 * s, (if gun then 11 else 8.5) * s), CFrame.new(0, 1.0 * s, 0), Color3.fromRGB(55, 80, 95), Enum.Material.Metal, nil, true)
			addPart(model, body, "Cabin", Vector3.new(3.2 * s, 2.0 * s, 3.5 * s), CFrame.new(0, 2.2 * s, -1.5 * s), Color3.fromRGB(40, 60, 75), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new((if gun then 4.5 else 3.8) * s, 1.2 * s, 3.0 * s), CFrame.new(0, 0.4 * s, (if gun then -6.5 else -5.2) * s), Color3.fromRGB(50, 75, 90), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(4.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.5 * s, -2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, if gun then 11 else 8, accentCol)
			addPart(model, body, "BridgeGlass", Vector3.new(2.8 * s, 0.9 * s, 0.3 * s), CFrame.new(0, 2.8 * s, -3.0 * s), Color3.fromRGB(60, 100, 130), Enum.Material.Glass, nil, false)
			if gun then
				addPart(model, body, "Turret", Vector3.new(2.0 * s, 1.0 * s, 2.0 * s), CFrame.new(0, 2.8 * s, 2.5 * s), Color3.fromRGB(35, 45, 50), Enum.Material.Metal, nil, false)
				addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 3.5 * s), CFrame.new(0, 3.0 * s, 0.5 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
				addPart(model, body, "GunShield", Vector3.new(1.6 * s, 1.0 * s, 0.25 * s), CFrame.new(0, 3.2 * s, 1.4 * s), Color3.fromRGB(40, 50, 55), Enum.Material.Metal, nil, false)
			end
			seatOffset = CFrame.new(0, 2.8 * s, -1.2 * s)
			labelY = 5.5 * s
		end
	end

	if family == "WheeledLight" then
		kitWheeledLight()
	elseif family == "WheeledTruck" then
		kitWheeledTruck()
	elseif family == "WheeledAPC" then
		kitWheeledAPC()
	elseif family == "TrackedIFV" then
		kitTracked("IFV")
	elseif family == "TrackedMBT" then
		kitTracked("MBT")
	elseif family == "TrackedSPAAG" then
		kitTracked("SPAAG")
	elseif family == "TrackedArtillery" then
		kitTracked("Artillery")
	elseif family == "HeliLight" then
		kitHeli("Light")
	elseif family == "HeliTransport" then
		kitHeli("Transport")
	elseif family == "HeliAttack" then
		kitHeli("Attack")
	elseif family == "JetFighter" then
		kitJet("Fighter")
	elseif family == "JetStrike" then
		kitJet("Strike")
	elseif family == "JetBomber" then
		kitJet("Bomber")
	elseif family == "JetTransport" then
		kitJet("Transport")
	elseif family == "NavalPatrol" then
		kitNaval("Patrol")
	elseif family == "NavalGun" then
		kitNaval("Gun")
	elseif family == "NavalLanding" then
		kitNaval("Landing")
	elseif family == "NavalCapital" then
		kitNaval("Capital")
	elseif family == "NavalSub" then
		kitNaval("Sub")
	else
		body.Size = Vector3.new(6 * s, 2 * s, 10 * s)
		body.Color = olive
		addPart(model, body, "Cabin", Vector3.new(4 * s, 1.5 * s, 4 * s), CFrame.new(0, 1.5 * s, -1 * s), oliveDark, Enum.Material.SmoothPlastic, nil, true)
		addWheels(model, body, s, {
			Vector3.new(-2.5, -1.2, 3),
			Vector3.new(2.5, -1.2, 3),
			Vector3.new(-2.5, -1.2, -3),
			Vector3.new(2.5, -1.2, -3),
		}, 1.1)
		seatOffset = CFrame.new(0, 2.0 * s, -1 * s)
	end

	local cat = def.Category or "Ground"
	local isAir = cat == "Air"
	local isNaval = cat == "Naval"
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.8, 2)
	seat.Color = Color3.fromRGB(70, 80, 60)
	seat.Material = Enum.Material.SmoothPlastic
	seat.CFrame = body.CFrame * seatOffset
	seat.Anchored = false
	seat.CanCollide = true
	seat.HeadsUpDisplay = false
	seat.Disabled = false
	seat.MaxSpeed = if isAir then math.min(def.Speed, 40) elseif isNaval then math.min(def.Speed, 55) else def.Speed
	seat.Torque = if isAir then 8 elseif isNaval then 18 else 28
	seat.TurnSpeed = if isAir then 1.4 elseif isNaval then 1.8 else 2.4
	seat.Parent = model
	weldTo(body, seat)
	model:SetAttribute("WE_DriveMode", if isAir then "AirPlaceholder" elseif isNaval then "NavalSeat" else "VehicleSeat")
	model:SetAttribute("WE_Category", cat)
	model:SetAttribute("WE_KitFamily", family)
	if def.MeshAssetId and def.MeshAssetId ~= 0 then
		model:SetAttribute("MeshAssetId", def.MeshAssetId)
	end

	local extra = math.max(0, (def.Seats or 1) - 1)
	for i = 1, math.min(extra, 4) do
		local ps = Instance.new("Seat")
		ps.Name = "PassengerSeat" .. i
		ps.Size = Vector3.new(1.4, 0.5, 1.4)
		ps.Color = Color3.fromRGB(60, 70, 55)
		ps.CFrame = body.CFrame * CFrame.new((i % 2 == 0 and 1.4 or -1.4), seatOffset.Y, seatOffset.Z + 1.4 + math.floor((i - 1) / 2) * 1.5)
		ps.Anchored = false
		ps.CanCollide = true
		ps.Parent = model
		weldTo(body, ps)
	end

	addLabel(body, def.DisplayName, labelY)

	model.PrimaryPart = body
	-- Optional free Creator Store visual (non-colliding); Part kit stays authoritative
	pcall(function()
		VisualAssetService.TryAttachVehicleVisual(model, def.Id or "", family)
	end)
	CollectionService:AddTag(model, Constants.Tags.Vehicle)
	model.Parent = ensureFolder()
	return model
end

local function meetsStructureReq(profile: any, def: VehicleDef): (boolean, string?)
	local req = def.RequiresStructure
	if not req then
		return true, nil
	end
	local level = 0
	if profile.BaseUpgrades then
		level = profile.BaseUpgrades[req.StructureId] or 0
	end
	if level < req.Level then
		return false, "MissingStructure"
	end
	return true, nil
end

local function meetsPrestigeReq(profile: any, def: VehicleDef): (boolean, string?)
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 then
		if (profile.Prestige or 0) < needP then
			return false, "PrestigeTooLow"
		end
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" then
		local unlocks = profile.RebirthUnlocks
		if typeof(unlocks) ~= "table" or unlocks[flag] ~= true then
			return false, "MissingRebirthUnlock"
		end
	end
	return true, nil
end


local function startAirPlaceholderDrive(userId: number, model: Model, def: VehicleDef)
	stopAirDrive(userId)
	local body = model.PrimaryPart
	local seat = model:FindFirstChild("DriverSeat")
	if not (body and body:IsA("BasePart") and seat and seat:IsA("VehicleSeat")) then
		return
	end
	-- Lightweight placeholder flight: throttle → forward, steer → yaw, slight hover
	local attachment = body:FindFirstChild("WE_AirAttach") :: Attachment?
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "WE_AirAttach"
		attachment.Parent = body
	end
	local lv = body:FindFirstChild("WE_AirVelocity") :: LinearVelocity?
	if not lv then
		lv = Instance.new("LinearVelocity")
		lv.Name = "WE_AirVelocity"
		lv.Attachment0 = attachment
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.MaxForce = 1e6
		lv.VectorVelocity = Vector3.zero
		lv.Parent = body
	end
	local av = body:FindFirstChild("WE_AirAngular") :: AngularVelocity?
	if not av then
		av = Instance.new("AngularVelocity")
		av.Name = "WE_AirAngular"
		av.Attachment0 = attachment
		av.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
		av.MaxTorque = 1e5
		av.AngularVelocity = Vector3.zero
		av.Parent = body
	end

	local cruise = def.Speed
	local hoverY = body.Position.Y
	airDriveConns[userId] = RunService.Heartbeat:Connect(function(_dt)
		if not model.Parent or not body.Parent then
			stopAirDrive(userId)
			return
		end
		local occupied = seat.Occupant ~= nil
		if not occupied then
			lv.VectorVelocity = Vector3.zero
			av.AngularVelocity = Vector3.zero
			return
		end
		local throttle = seat.ThrottleFloat
		local steer = seat.SteerFloat
		-- Hold altitude near spawn hover band; throttle climbs/dives a bit
		local targetY = hoverY + throttle * 12
		local yCorr = math.clamp((targetY - body.Position.Y) * 2.5, -40, 40)
		local look = body.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.05 then
			flat = Vector3.new(0, 0, -1)
		else
			flat = flat.Unit
		end
		local speed = cruise * math.clamp(math.abs(throttle) + 0.15, 0.15, 1)
		if throttle < 0 then
			speed *= 0.55
		end
		local forwardSign = if throttle >= 0 then 1 else -0.4
		local vel = flat * (speed * forwardSign) + Vector3.new(0, yCorr, 0)
		lv.VectorVelocity = vel
		av.AngularVelocity = Vector3.new(0, -steer * 1.8, 0)
	end)
end

function VehicleService.Owns(player: Player, vehicleId: string): boolean
	local profile = DataService.GetProfile(player)
	return profile ~= nil and profile.Vehicles[vehicleId] == true
end

function VehicleService.GrantVehicle(player: Player, vehicleId: string)
	local profile = DataService.GetProfile(player)
	if not profile or not getDef(vehicleId) then
		return
	end
	profile.Vehicles[vehicleId] = true
	DataService.MarkDirty(player)
	pushState(player)
end

function VehicleService.Purchase(player: Player, vehicleId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(vehicleId, 48) then
		return false, "InvalidId"
	end
	local def = getDef(vehicleId)
	if not def then
		return false, "UnknownVehicle"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Vehicles[vehicleId] then
		return false, "AlreadyOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local okStruct, structErr = meetsStructureReq(profile, def)
	if not okStruct then
		return false, structErr
	end
	local okPres, presErr = meetsPrestigeReq(profile, def)
	if not okPres then
		return false, presErr
	end
	local cost = def.CostCash or 0
	if cost > 0 then
		local ok, err = EconomyService.SpendCash(player, cost, "vehicle_" .. vehicleId)
		if not ok then
			return false, err or "SpendFailed"
		end
	end
	profile.Vehicles[vehicleId] = true
	DataService.MarkDirty(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.VEHICLE_PURCHASED, player.UserId, {
			vehicle = vehicleId,
			cost = cost,
		})
	end
	if NotificationService then
		NotificationService.Notify(player, "Acquired " .. def.DisplayName, "Reward")
	end
	pushState(player)
	return true, nil
end

function VehicleService.Despawn(player: Player)
	destroyActive(player.UserId)
	pushState(player)
end

function VehicleService.RequestSpawn(player: Player, vehicleId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(vehicleId, 48) then
		return false, "InvalidId"
	end
	local def = getDef(vehicleId)
	if not def then
		return false, "UnknownVehicle"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if not profile.Vehicles[vehicleId] then
		return false, "NotOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local okStruct, structErr = meetsStructureReq(profile, def)
	if not okStruct then
		return false, structErr
	end
	local okPres, presErr = meetsPrestigeReq(profile, def)
	if not okPres then
		return false, presErr
	end
	if cooldownLeft(player.UserId, player) > 0 then
		return false, "Cooldown"
	end

	destroyActive(player.UserId)
	local model = buildVehicleModel(def, findSpawnCFrame(player, def.Category), player.UserId)
	activeVehicles[player.UserId] = model
	lastSpawnAt[player.UserId] = now()
	local driveMode = model:GetAttribute("WE_DriveMode")
	if driveMode == "AirPlaceholder" then
		startAirPlaceholderDrive(player.UserId, model, def)
	end

	if profile.Stats then
		profile.Stats.VehiclesSpawned = (profile.Stats.VehiclesSpawned or 0) + 1
	end
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "SpawnVehicle", 1)
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "SpawnVehicle", vehicleId)
	end
	DataService.MarkDirty(player)

	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.VEHICLE_SPAWNED, player.UserId, { vehicle = vehicleId })
	end
	if NotificationService then
		NotificationService.Notify(player, "Deployed " .. def.DisplayName, "Info")
	end
	pushState(player)
	return true, nil
end

function VehicleService.PushState(player: Player)
	pushState(player)
end

function VehicleService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService

	ensureFolder()

	local spawnRemote = RemoteSetup.Get(Constants.RemoteNames.RequestSpawnVehicle) :: RemoteEvent
	spawnRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
		if not RateLimitService.Allow(player, "spawn_vehicle", 1, 2) then
			return
		end
		local ok, err = VehicleService.RequestSpawn(player, vehicleId)
		if not ok and NotificationService and err then
			NotificationService.Notify(player, "Cannot spawn: " .. tostring(err), "Warn")
		end
	end)

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseVehicle) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
		if not RateLimitService.Allow(player, "buy_vehicle", 2, 3) then
			return
		end
		local ok, err = VehicleService.Purchase(player, vehicleId)
		if not ok and NotificationService and err then
			NotificationService.Notify(player, "Cannot buy vehicle: " .. tostring(err), "Warn")
		end
	end)

	local despawnRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDespawnVehicle) :: RemoteEvent
	despawnRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "despawn_vehicle", 2, 3) then
			return
		end
		VehicleService.Despawn(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		local starter = VehicleConfig.StarterVehicle
		if not profile.Vehicles[starter] then
			profile.Vehicles[starter] = true
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		destroyActive(player.UserId)
		lastSpawnAt[player.UserId] = nil
	end)
end

return VehicleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">VisualAssetService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Loads free Creator Store Models via InsertService (fallback AssetService).
	Caches clones; strips all scripts; never blocks Part-kit spawn on failure.
	Respects DevConfig.StudioSkipWorldDressing for 8GB Studio PERF.
]]

local InsertService = game:GetService("InsertService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualAssetConfig = require(Shared.Configs.VisualAssetConfig)
local DevConfig = require(Shared.Configs.DevConfig)

local VisualAssetService = {}

local cache: { [number]: Model } = {} -- template models (parented to nil / folder)
local failed: { [number]: boolean } = {}
local loadAttempts = 0
local templatesFolder: Folder? = nil

local function ensureFolder(): Folder
	if templatesFolder and templatesFolder.Parent then
		return templatesFolder
	end
	local f = Instance.new("Folder")
	f.Name = "WE_VisualAssetTemplates"
	f.Parent = ReplicatedStorage
	templatesFolder = f
	return f
end

local function shouldSkipInserts(): boolean
	if not VisualAssetConfig.Enabled then
		return true
	end
	if RunService:IsStudio() then
		local force = DevConfig.StudioForceDress == true
		if DevConfig.StudioSkipWorldDressing ~= false and not force then
			return true
		end
	end
	return false
end

local function stripScripts(root: Instance)
	if not VisualAssetConfig.StripScripts then
		return
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	-- Also direct children scripts
	for _, c in ipairs(root:GetChildren()) do
		if c:IsA("BaseScript") or c:IsA("ModuleScript") then
			c:Destroy()
		end
	end
end

local function loadModel(assetId: number): Model?
	if assetId == 0 or failed[assetId] then
		return nil
	end
	if cache[assetId] then
		return cache[assetId]
	end
	if shouldSkipInserts() then
		return nil
	end
	if loadAttempts >= (VisualAssetConfig.MaxLoadAttempts or 36) then
		return nil
	end
	loadAttempts += 1

	local ok, result = pcall(function()
		return InsertService:LoadAsset(assetId)
	end)
	if not ok or typeof(result) ~= "Instance" then
		-- AssetService fallback (newer API)
		local AssetService = game:GetService("AssetService")
		if AssetService and (AssetService :: any).LoadAssetAsync then
			ok, result = pcall(function()
				return (AssetService :: any):LoadAssetAsync(assetId)
			end)
		end
	end
	if not ok or typeof(result) ~= "Instance" then
		failed[assetId] = true
		warn("[VisualAssetService] LoadAsset failed", assetId, result)
		return nil
	end

	local container = result :: Instance
	stripScripts(container)
	local model: Model? = nil
	if container:IsA("Model") then
		model = container
	else
		for _, c in ipairs(container:GetChildren()) do
			if c:IsA("Model") then
				model = c
				break
			end
		end
	end
	if not model then
		failed[assetId] = true
		container:Destroy()
		warn("[VisualAssetService] No Model in asset", assetId)
		return nil
	end

	stripScripts(model)
	model.Name = "WE_Asset_" .. tostring(assetId)
	-- Anchor all for template; clones will reconfigure
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CastShadow = false
			d.Massless = true
		end
	end
	model.Parent = ensureFolder()
	cache[assetId] = model
	if container ~= model and container.Parent == nil then
		-- LoadAsset returns Model in a Model container sometimes
		pcall(function()
			container:Destroy()
		end)
	elseif container ~= model then
		-- keep only our template
		for _, c in ipairs(container:GetChildren()) do
			if c ~= model then
				c:Destroy()
			end
		end
		model.Parent = ensureFolder()
		pcall(function()
			container:Destroy()
		end)
	end
	print("[VisualAssetService] Cached catalog model", assetId, model.Name)
	return model
end

local function weldCloneToPrimary(clone: Model, primary: BasePart, cloneName: string): boolean
	stripScripts(clone)
	clone.Name = cloneName

	-- Remove competing Humanoids / tools / seats / scripts from catalog meshes
	for _, d in ipairs(clone:GetDescendants()) do
		if
			d:IsA("Humanoid")
			or d:IsA("Tool")
			or d:IsA("VehicleSeat")
			or d:IsA("Seat")
			or d:IsA("BaseScript")
			or d:IsA("ModuleScript")
		then
			d:Destroy()
		end
	end

	pcall(function()
		clone:PivotTo(primary.CFrame)
	end)

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			d.CastShadow = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return true
end

function VisualAssetService.IsInsertEnabled(): boolean
	return not shouldSkipInserts()
end

function VisualAssetService.ResolveVehicleAssetId(vehicleId: string, kitFamily: string?): number?
	local ref = VisualAssetConfig.Vehicles[vehicleId]
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	if kitFamily and VisualAssetConfig.KitFamilyFallback[kitFamily] then
		local key = VisualAssetConfig.KitFamilyFallback[kitFamily]
		local fb = VisualAssetConfig.Vehicles[key]
		if fb and typeof(fb.ModelAssetId) == "number" and (fb.ModelAssetId :: number) > 0 then
			return fb.ModelAssetId
		end
	end
	return nil
end

function VisualAssetService.ResolveCharacterAssetId(kind: string): number?
	local ref = VisualAssetConfig.Characters[kind] or VisualAssetConfig.Characters.Soldier
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	return nil
end

function VisualAssetService.ResolveBuildingAssetId(structureId: string): number?
	local ref = VisualAssetConfig.Buildings[structureId]
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	return nil
end

function VisualAssetService.ResolvePropAssetId(propKey: string): number?
	local ref = VisualAssetConfig.DesertProps[propKey]
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	return nil
end

--[[
	Clone catalog visual under hostModel, welded to primary, non-colliding.
	Returns true if attached. Never destroys host Part kit.
]]
function VisualAssetService.TryAttachVehicleVisual(hostModel: Model, vehicleId: string, kitFamily: string?): boolean
	local assetId = VisualAssetService.ResolveVehicleAssetId(vehicleId, kitFamily)
	if not assetId then
		return false
	end
	local template = loadModel(assetId)
	if not template then
		return false
	end
	local primary = hostModel.PrimaryPart
	if not primary then
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, primary, "WE_CatalogVisual") then
		clone:Destroy()
		return false
	end

	clone.Parent = hostModel
	hostModel:SetAttribute("WE_CatalogAssetId", assetId)
	-- Soften host body visibility so catalog mesh reads better
	primary.Transparency = math.max(primary.Transparency, 0.55)
	return true
end

--[[
	Optional character visual overlay for NPC Part kits.
	Attaches non-colliding clone; host HumanoidRootPart stays authoritative.
]]
function VisualAssetService.TryAttachCharacterVisual(hostModel: Model, kind: string): boolean
	local assetId = VisualAssetService.ResolveCharacterAssetId(kind)
	if not assetId then
		return false
	end
	local template = loadModel(assetId)
	if not template then
		return false
	end
	local primary = hostModel.PrimaryPart or hostModel:FindFirstChild("HumanoidRootPart")
	if not (primary and primary:IsA("BasePart")) then
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, primary :: BasePart, "WE_CatalogCharacter") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostModel
	hostModel:SetAttribute("WE_CatalogAssetId", assetId)
	return true
end

--[[
	Optional building visual overlay for structure plinth Part kits.
	Welded non-colliding; plinth remains authoritative for walk-buy.
]]
function VisualAssetService.TryAttachBuildingVisual(hostPart: BasePart, structureId: string): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") then
		return false -- already dressed
	end
	local assetId = VisualAssetService.ResolveBuildingAssetId(structureId)
	if not assetId then
		return false
	end
	local template = loadModel(assetId)
	if not template then
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogBuilding") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	-- Soften kit body parts so catalog silhouette reads
	for _, child in ipairs(hostPart:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("WE_KitRole") == "Body" then
			child.Transparency = math.max(child.Transparency, 0.45)
		end
	end
	return true
end

--[[
	Optional desert prop overlay (cactus etc.) welded to a flora host part.
]]
function VisualAssetService.TryAttachPropVisual(hostPart: BasePart, propKey: string): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") then
		return false
	end
	local assetId = VisualAssetService.ResolvePropAssetId(propKey)
	if not assetId then
		return false
	end
	local template = loadModel(assetId)
	if not template then
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogProp") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	hostPart.Transparency = math.max(hostPart.Transparency, 0.65)
	return true
end

function VisualAssetService.Init()
	ensureFolder()
	if shouldSkipInserts() then
		print("[VisualAssetService] Catalog inserts SKIPPED (StudioSkipWorldDressing / disabled). Part kits only.")
	else
		print("[VisualAssetService] Catalog inserts enabled — free Creator Store IDs via InsertService.")
	end
end

return VisualAssetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">XPService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Server-authoritative XP / Level ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local LevelConfig = require(Shared.Configs.LevelConfig)
local Types = require(Shared.Types)

local XPService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RemoteSetup: any = nil
local TerritoryService: any = nil
local _MissionService: any = nil
local MonetizationService: any = nil
local BattlePassService: any = nil
local SeasonService: any = nil

local function pushXP(player: Player, profile: Types.PlayerProfile)
	local remote = RemoteSetup.Get(Constants.RemoteNames.XPUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Level = profile.Level,
		XP = profile.XP,
		XPToNext = LevelConfig.GetXPRequiredForLevel(profile.Level),
	} :: Types.XPUpdatePayload)
end

function XPService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	_MissionService = deps.MissionService
	MonetizationService = deps.MonetizationService
	BattlePassService = deps.BattlePassService
	SeasonService = deps.SeasonService
end

function XPService.Push(player: Player)
	local profile = DataService.GetProfile(player)
	if profile then
		pushXP(player, profile)
	end
end

function XPService.AddXP(player: Player, amount: number, reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	if SeasonService and SeasonService.GetXPMult and reason ~= "admin" and reason ~= "battlepass" and reason ~= "daily" then
		amount = math.max(1, math.floor(amount * SeasonService.GetXPMult()))
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end

	if profile.Level >= LevelConfig.MaxLevel then
		return false
	end

	if TerritoryService and TerritoryService.GetXPMult and reason ~= "achievement" then
		amount = math.max(1, math.floor(amount * TerritoryService.GetXPMult(player)))
	end

	local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
	local reasonKey = reason or ""
	local xpExempt = MonetizationConfig.XPMultExemptReasons
	if MonetizationService and MonetizationService.GetXPMultiplier and not (xpExempt and xpExempt[reasonKey]) then
		amount = math.max(1, math.floor(amount * MonetizationService.GetXPMultiplier(player)))
	end

	profile.XP += amount
	while profile.Level < LevelConfig.MaxLevel do
		local need = LevelConfig.GetXPRequiredForLevel(profile.Level)
		if profile.XP < need then
			break
		end
		profile.XP -= need
		profile.Level += 1
		local reward = LevelConfig.GetLevelUpReward(profile.Level)
		if reward.Cash > 0 then
			EconomyService.AddCash(player, reward.Cash, "level_up")
		end
		if reward.Gold > 0 then
			EconomyService.AddGold(player, reward.Gold, "level_up")
		end
		if AnalyticsService then
			AnalyticsService.Log("LEVEL_UP", player.UserId, { level = profile.Level, reason = reason })
		end
	end

	DataService.MarkDirty(player)
	pushXP(player, profile)
	if BattlePassService and BattlePassService.AddXP and reason ~= "battlepass" then
		-- Mirror a portion of gameplay XP into the battle pass track
		BattlePassService.AddXP(player, amount, reason)
	end
	return true
end

function XPService.SetLevel(player: Player, level: number)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.Level = math.clamp(math.floor(level), 1, LevelConfig.MaxLevel)
	profile.XP = 0
	DataService.MarkDirty(player)
	pushXP(player, profile)
end

function XPService.GetXPToNext(player: Player): number
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0
	end
	return LevelConfig.GetXPRequiredForLevel(profile.Level)
end

return XPService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="91">
