        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataStore load/save with retries, autosave, PlayerRemoving, BindToClose,
	session lock, and versioned migrations. Never trusts client payloads.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local DevConfig = require(Shared.Configs.DevConfig)
local AdminConfig = require(Shared.Configs.AdminConfig)

local ProfileSchema = require(script.Parent.Parent.Modules.ProfileSchema)
local SessionLock = require(script.Parent.Parent.Modules.SessionLock)

type PlayerProfile = Types.PlayerProfile

local DataService = {}

local profiles: { [number]: PlayerProfile } = {}
local dirty: { [number]: boolean } = {}
local loading: { [number]: boolean } = {}
-- v67: true only when the profile content came from a successful DataStore read (existing save or a
-- confirmed new player). Only loaded profiles are ever written back, so a default / session-only profile
-- can never overwrite a real save.
local loaded: { [number]: boolean } = {}
-- v67: a leave-save still in flight; a same-server rejoin waits for it before reading the store.
local pendingSave: { [number]: boolean } = {}
local dataStore: DataStore? = nil

local AnalyticsService: any = nil
local onProfileLoadedCallbacks: { (Player, PlayerProfile) -> () } = {}

local function getDataStore(): DataStore?
	if dataStore then
		return dataStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Constants.DataStoreName)
	end)
	if ok then
		dataStore = result
		return dataStore
	end
	warn("[DataService] DataStore unavailable (enable Studio API services for persistence):", result)
	return nil
end

local function keyFor(userId: number): string
	return "player_" .. tostring(userId)
end

local function retryAsync(label: string, fn: () -> any): (boolean, any)
	local lastErr = nil
	for attempt = 1, Constants.DataStoreRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(string.format("[DataService] %s attempt %d failed: %s", label, attempt, tostring(result)))
		task.wait(Constants.DataStoreRetryDelay * attempt)
	end
	return false, lastErr
end

function DataService.SetAnalytics(svc: any)
	AnalyticsService = svc
end

function DataService.OnProfileLoaded(cb: (Player, PlayerProfile) -> ())
	table.insert(onProfileLoadedCallbacks, cb)
	-- If profiles already loaded (init-order safety), fire immediately
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = profiles[player.UserId]
		if profile then
			task.spawn(cb, player, profile)
		end
	end
end

local function fireProfileLoaded(player: Player, profile: PlayerProfile)
	for _, cb in ipairs(onProfileLoadedCallbacks) do
		task.spawn(cb, player, profile)
	end
end

function DataService.GetProfile(player: Player): PlayerProfile?
	return profiles[player.UserId]
end

--[[ v67: true when this player's profile was read from the DataStore and will be saved. False while the
	load is in flight and for a session-only profile (DataStore read failed). Receipts must wait for it. ]]
function DataService.IsLoaded(player: Player): boolean
	return loaded[player.UserId] == true
end

function DataService.MarkDirty(player: Player)
	if profiles[player.UserId] then
		dirty[player.UserId] = true
	end
end

function DataService.WaitForProfile(player: Player, timeout: number?): PlayerProfile?
	local t = timeout or 15
	local start = os.clock()
	while os.clock() - start < t do
		local p = profiles[player.UserId]
		if p then
			return p
		end
		if not player.Parent then
			return nil
		end
		task.wait(0.1)
	end
	return profiles[player.UserId]
end

local function applyStudioDevFlags(profile: PlayerProfile)
	if not RunService:IsStudio() then
		return
	end
	if DevConfig.StudioBoostCash then
		profile.Cash = math.max(profile.Cash, DevConfig.StudioBoostCashAmount)
	end
	if DevConfig.SkipTutorial then
		profile.TutorialComplete = true
	end
	if DevConfig.UnlockAllVehicles then
		local VehicleConfig = require(Shared.Configs.VehicleConfig)
		for id in pairs(VehicleConfig.Vehicles) do
			profile.Vehicles[id] = true
		end
	end
	if DevConfig.UnlockAllWeapons then
		local WeaponConfig = require(Shared.Configs.WeaponConfig)
		for id in pairs(WeaponConfig.Weapons) do
			profile.Weapons[id] = true
		end
	end
end

-- v60/v59: AdminPlaytestCash — shaunie6 only; instant LoadProfile + merge floors.
local ADMIN_PLAYTEST_USER_ID = 470626172
local function applyAdminPlaytestCash(userId: number, profile: PlayerProfile): boolean
	if userId ~= ADMIN_PLAYTEST_USER_ID then
		return false
	end
	local target = math.floor(tonumber(AdminConfig.AdminPlaytestCash) or 50_000_000)
	local have = math.floor(tonumber(profile.Cash) or 0)
	if have < target then
		profile.Cash = target
		return true
	end
	return false
end

local function stampEconomyAttrs(player: Player, profile: PlayerProfile)
	local cash = math.floor(tonumber(profile.Cash) or 0)
	local gold = math.floor(tonumber(profile.Gold) or 0)
	local pending = math.floor(tonumber((profile :: any).PendingCash) or 0)
	pcall(function()
		player:SetAttribute("WE_Build", 78)
		player:SetAttribute("WE_Cash", cash)
		player:SetAttribute("WE_Gold", gold)
		player:SetAttribute("WE_PendingCash", pending)
	end)
	-- v60: leaderstats always — HUD reads this even if remotes dead
	pcall(function()
		local folder = player:FindFirstChild("leaderstats")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "leaderstats"
			folder.Parent = player
		end
		local cashVal = folder:FindFirstChild("Cash")
		if not cashVal then
			cashVal = Instance.new("IntValue")
			cashVal.Name = "Cash"
			cashVal.Parent = folder
		end
		if cashVal:IsA("IntValue") or cashVal:IsA("NumberValue") then
			(cashVal :: any).Value = cash
		end
		local goldVal = folder:FindFirstChild("Gold")
		if not goldVal then
			goldVal = Instance.new("IntValue")
			goldVal.Name = "Gold"
			goldVal.Parent = folder
		end
		if goldVal:IsA("IntValue") or goldVal:IsA("NumberValue") then
			(goldVal :: any).Value = gold
		end
	end)
end

local function tryPushEconomy(player: Player)
	-- Best-effort: EconomyService may not be Init'd yet; attrs alone unblock HUD
	pcall(function()
		local EconomyService = require(script.Parent.EconomyService)
		if EconomyService and EconomyService.Push then
			EconomyService.Push(player)
		end
	end)
end

local function notifyPlayer(player: Player, text: string)
	task.defer(function()
		pcall(function()
			local NotificationService = require(script.Parent.NotificationService)
			if NotificationService and NotificationService.Notify then
				NotificationService.Notify(player, text, "Warn", 8)
			end
		end)
	end)
end

--[[
	v67: load the real save BEFORE the profile exists.

	v58–v65 handed out an instant default profile and merged ~15 fields of the save into it later, then
	saved the result — dropping everything else (entitlements, receipts, codes, battle pass, clan, daily,
	spinner, territories …) on every rejoin, writing the default over the save whenever the player left,
	autosave ran or GetAsync failed first, and lifting cash to StartingCash on each join. That instant
	profile only existed because this module failed to parse (v50–v65); a DataStore read takes well under
	a second. Now: GetProfile is nil until the read finishes; callers already handle nil ("still loading").
]]
function DataService.LoadProfile(player: Player): PlayerProfile?
	local userId = player.UserId
	if profiles[userId] then
		return profiles[userId]
	end
	if loading[userId] then
		return DataService.WaitForProfile(player, 20)
	end
	loading[userId] = true

	-- Same-server rejoin: let the previous session's leave-save land before reading.
	local waitStart = os.clock()
	while pendingSave[userId] and os.clock() - waitStart < 15 do
		task.wait(0.1)
	end

	local acquired, lockErr = SessionLock.TryAcquire(userId)
	if not acquired then
		warn("[DataService] Session lock failed (continuing — no kick) for", userId, lockErr)
		if AnalyticsService then
			AnalyticsService.Log("SESSION_LOCK_CONFLICT", userId, { err = tostring(lockErr), soft = true })
		end
	end

	local profile: PlayerProfile
	local persistent = true
	local ds = getDataStore()
	if not ds then
		-- Studio without API access: session-only profile (SaveProfile has nothing to write anyway).
		profile = ProfileSchema.CreateDefault()
	else
		local ok, raw = retryAsync("GetAsync", function()
			return ds:GetAsync(keyFor(userId))
		end)
		if ok then
			profile = if raw == nil then ProfileSchema.CreateDefault() else ProfileSchema.Migrate(raw)
		else
			-- Could not read the save. Let them play, but never write this default over the real data.
			warn("[DataService] GetAsync failed — session-only profile, saving disabled for", userId, raw)
			profile = ProfileSchema.CreateDefault()
			persistent = false
			notifyPlayer(player, "Your save could not be loaded. Progress this session will NOT be saved — rejoin to retry.")
		end
	end

	if not player.Parent then
		-- Left during the load: nothing was loaded, so nothing may be saved.
		loading[userId] = false
		SessionLock.Release(userId)
		return nil
	end

	profile.LastJoinUnix = os.time()
	if profile.FirstJoinUnix == 0 or profile.FirstJoinUnix == nil then
		profile.FirstJoinUnix = os.time()
	end
	applyStudioDevFlags(profile)
	applyAdminPlaytestCash(userId, profile)

	profiles[userId] = profile
	loaded[userId] = persistent
	dirty[userId] = persistent
	loading[userId] = false

	stampEconomyAttrs(player, profile)
	tryPushEconomy(player)
	fireProfileLoaded(player, profile)

	print(string.format(
		"[DataService] profile loaded userId=%d cash=%d persistent=%s WE_Build=78",
		userId,
		math.floor(tonumber(profile.Cash) or 0),
		tostring(persistent)
	))
	return profile
end


--[[ v67: never invents a profile. Returns the loaded profile, waits briefly for an in-flight load,
	or starts the load if none began (callers treat nil as "still loading"). ]]
function DataService.EnsureProfile(player: Player): PlayerProfile?
	local userId = player.UserId
	local existing = profiles[userId]
	if existing then
		return existing
	end
	if not player.Parent then
		return nil
	end
	if not loading[userId] then
		task.spawn(DataService.LoadProfile, player)
	end
	return DataService.WaitForProfile(player, 0.25)
end

--- Clear in-memory profile without saving (optional admin wipeprofile).
function DataService.ClearInMemoryProfile(userId: number)
	profiles[userId] = nil
	dirty[userId] = nil
	loading[userId] = nil
	loaded[userId] = nil
end

--- RemoveAsync player_USERID; does not touch session lock.
function DataService.RemovePersistedProfile(userId: number): (boolean, string?)
	local ds = getDataStore()
	if not ds then
		return false, "DataStore unavailable"
	end
	local ok, err = pcall(function()
		ds:RemoveAsync(keyFor(userId))
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, nil
end

local function writeProfile(userId: number, profile: PlayerProfile, releaseLock: boolean?): boolean
	local ds = getDataStore()
	if not ds then
		if releaseLock then
			SessionLock.Release(userId)
		end
		return true -- nothing to persist (Studio without API access)
	end
	local snapshot = ProfileSchema.DeepCopy(profile)
	local ok, err = retryAsync("SetAsync", function()
		ds:SetAsync(keyFor(userId), snapshot)
	end)
	if ok then
		SessionLock.Refresh(userId)
	else
		warn("[DataService] Save failed for", userId, err)
	end
	if releaseLock then
		SessionLock.Release(userId)
	end
	return ok
end

function DataService.SaveProfile(player: Player, releaseLock: boolean?): boolean
	local userId = player.UserId
	local profile = profiles[userId]
	if not profile then
		return false
	end
	if not loaded[userId] then
		-- v67: session-only / not-yet-loaded profile — writing it would overwrite the real save.
		if releaseLock then
			SessionLock.Release(userId)
		end
		return false
	end
	local ok = writeProfile(userId, profile, releaseLock)
	if ok and profiles[userId] == profile then
		dirty[userId] = false
	end
	return ok
end

function DataService.UnloadProfile(player: Player)
	local userId = player.UserId
	local profile = profiles[userId]
	local wasLoaded = loaded[userId] == true
	-- Clear first so a same-server rejoin starts a fresh load instead of reusing this session's table.
	profiles[userId] = nil
	dirty[userId] = nil
	loading[userId] = nil
	loaded[userId] = nil
	if profile and wasLoaded then
		pendingSave[userId] = true
		writeProfile(userId, profile, true)
		pendingSave[userId] = nil
	else
		-- Never loaded (left mid-load / session-only): nothing to save; still release the lock.
		SessionLock.Release(userId)
	end
end

function DataService.Init()
	Players.PlayerAdded:Connect(function(player)
		DataService.LoadProfile(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.UnloadProfile(player)
	end)

	-- Late joiners already in game
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(DataService.LoadProfile, player)
	end

	-- Session-lock heartbeat (must be < SessionLockTtlSeconds so live locks stay fresh)
	task.spawn(function()
		local refreshEvery = Constants.SessionLockRefreshSeconds
		while true do
			task.wait(refreshEvery)
			for _, player in ipairs(Players:GetPlayers()) do
				if profiles[player.UserId] then
					SessionLock.Refresh(player.UserId)
				end
			end
		end
	end)

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(Constants.AutosaveIntervalSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				if dirty[player.UserId] and profiles[player.UserId] then
					DataService.SaveProfile(player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		local players = Players:GetPlayers()
		local remaining = #players
		if remaining == 0 then
			return
		end
		for _, player in ipairs(players) do
			task.spawn(function()
				local userId = player.UserId
				if profiles[userId] and loaded[userId] then
					DataService.SaveProfile(player, true)
				else
					SessionLock.ForceReleaseIfStaleOrOurs(userId)
				end
				remaining -= 1
			end)
		end
		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Server-only currency mutations. Client never sets Cash/Gold/PendingCash.

	Cash multiplier stack order (AddCash / AccruePendingCash, non-exempt reasons):
	  1. Base amount (caller)
	  2. Prestige: × (1 + Prestige * EconomyConfig.PrestigeCashMultiplierPerLevel)
	  3. Monetization VIP/DoubleCash: × MonetizationService.GetCashMultiplier
	  4. Season: × SeasonService.GetCashMult()
	  5. Empire Tax (F3): × (1 + EmpireTaxPct / 100). EmpireTaxPct = OutpostIncomeStacks x MultPerStack (10 %) plus
	     StarterPct (5 %) while the player holds their OWN Home Outpost, capped at MaxStacks x MultPerStack (50 %).
	     Stacks recount from owned territories (contested / stealable); a Home Outpost is never a stack.
	Passive income accrues to PendingCash (Money Collector); CollectPendingCash grants Cash.
	ATM raid transfers PendingCash thief←victim without re-applying multipliers.

	B1 (owner's 11 features, lane E): prestige is applied ONCE, here (step 2). BaseService's passive per-tick amount
	and SoldierService's training per-tick amount are pre-multiplier, so prestige 1 pays exactly +10 %.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local TycoonGuideConfig = require(Shared.Configs.TycoonGuideConfig)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local Types = require(Shared.Types)

local EconomyService = {}

local SeasonService: any = nil
local DataService: any = nil
local RemoteSetup: any = nil
local MissionService: any = nil
local MonetizationService: any = nil
local TutorialService: any = nil
local MoneyCollectorService: any = nil

-- v65: never index nil DataService (SpendCash must not throw GetProfile on nil)
local function getDataService(): any
	if DataService ~= nil then
		return DataService
	end
	local ok, mod = pcall(require, script.Parent.DataService)
	if ok and mod ~= nil then
		DataService = mod
		warn("[Economy] getDataService: recovered via require(script.Parent.DataService)")
		return DataService
	end
	warn("[Economy] getDataService: DataService still nil after require fallback")
	return nil
end

local function ensureLeaderstats(player: Player, cash: number, gold: number)
	-- Classic tycoon belt+suspenders: IntValues replicate to client even if remotes miss
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end
	local cashVal = folder:FindFirstChild("Cash")
	if not cashVal then
		cashVal = Instance.new("IntValue")
		cashVal.Name = "Cash"
		cashVal.Parent = folder
	end
	if cashVal:IsA("IntValue") or cashVal:IsA("NumberValue") then
		(cashVal :: any).Value = cash
	end
	local goldVal = folder:FindFirstChild("Gold")
	if not goldVal then
		goldVal = Instance.new("IntValue")
		goldVal.Name = "Gold"
		goldVal.Parent = folder
	end
	if goldVal:IsA("IntValue") or goldVal:IsA("NumberValue") then
		(goldVal :: any).Value = gold
	end
end

local function pushEconomy(player: Player, profile: Types.PlayerProfile)
	local cash = math.floor(tonumber(profile.Cash) or 0)
	local gold = math.floor(tonumber(profile.Gold) or 0)
	local pending = math.floor(tonumber((profile :: any).PendingCash) or 0)
	-- Keep profile numeric (SpendCash / client Attribute fallback)
	profile.Cash = cash
	profile.Gold = gold
	;(profile :: any).PendingCash = pending
	-- Replicated attributes: clients that miss FireClient still read spendable Cash
	pcall(function()
		player:SetAttribute("WE_Cash", cash)
		player:SetAttribute("WE_Gold", gold)
		player:SetAttribute("WE_PendingCash", pending)
	end)
	pcall(ensureLeaderstats, player, cash, gold)
	-- v60: never yield Push on missing remotes — leaderstats/attrs already replicate
	pcall(function()
		if not RemoteSetup then
			return
		end
		local folder = game:GetService("ReplicatedStorage"):FindFirstChild(Constants.RemotesFolderName)
		local remote = folder and folder:FindFirstChild(Constants.RemoteNames.EconomyUpdate)
		if remote and remote:IsA("RemoteEvent") then
			(remote :: RemoteEvent):FireClient(player, {
				Cash = cash,
				Gold = gold,
				PendingCash = pending,
			} :: Types.EconomyUpdatePayload)
		end
	end)
end

-- v69: refunds / purchases / pre-multiplied transfers are paid 1:1 even if the config list drifts
-- (a multiplied dismiss refund > recruit cost is an infinite-cash loop at high prestige).
local NEVER_MULTIPLIED: { [string]: boolean } = {
	dismiss_soldiers = true,
	purchase_refund = true,
	devproduct = true,
	admin = true,
	collector = true,
	atm_raid = true,
}

--[[ F3 Empire Tax (EconomyConfig.OutpostIncomeBuff). A Home Outpost row (TerritoryConfig.Starter, F10) is never a
	stack: its id carries Starter.IdPrefix (so does a leftover id saved while the Starter was on, if it is off now).
	Only the player's OWN Home Outpost (def.PlotId == profile.BasePlotId; the row exists only while Starter.Enabled)
	adds StarterPct. Pure reads of the profile: no workspace, no yield. ]]
local function isStarterId(id: any): boolean
	if typeof(id) ~= "string" then
		return false
	end
	if TerritoryConfig.IsStarterDef(TerritoryConfig.Territories[id]) then
		return true
	end
	local prefix = TerritoryConfig.Starter and TerritoryConfig.Starter.IdPrefix
	return typeof(prefix) == "string" and prefix ~= "" and string.sub(id, 1, #prefix) == prefix
end

local function ownsOwnStarter(profile: any): boolean
	local st = TerritoryConfig.Starter
	local plotId = tonumber(profile.BasePlotId)
	local owned = profile.Territories
	if not st or plotId == nil or plotId ~= plotId or typeof(owned) ~= "table" then
		return false
	end
	local plot = math.floor(plotId)
	local id = tostring(st.IdPrefix) .. tostring(plot)
	if owned[id] ~= true then
		return false
	end
	local def = TerritoryConfig.Territories[id]
	return def ~= nil and TerritoryConfig.IsStarterDef(def) and def.PlotId == plot
end

-- whole % per captured outpost (10), MaxStacks (5) and the cap (50); float-safe (0.1 x 100 -> 10)
local function empireTaxSteps(): (number, number, number)
	local buff = EconomyConfig.OutpostIncomeBuff
	local perStack = math.floor(((buff and buff.MultPerStack) or 0.10) * 100 + 0.5)
	local maxStacks = math.max(0, math.floor((buff and buff.MaxStacks) or 5))
	return perStack, maxStacks, maxStacks * perStack
end

local function storedStacks(profile: any, maxStacks: number): number
	local n = tonumber(profile.OutpostIncomeStacks) or 0
	if n ~= n then
		return 0
	end
	return math.clamp(math.floor(n), 0, maxStacks)
end

-- Whole-number Empire Tax % for a profile: min(cap, stacks x 10 + (own Home Outpost held and StarterPct or 0))
local function empireTaxPct(profile: any): number
	local buff = EconomyConfig.OutpostIncomeBuff
	if not buff or typeof(profile) ~= "table" then
		return 0
	end
	local perStack, maxStacks, cap = empireTaxSteps()
	local pct = storedStacks(profile, maxStacks) * perStack
	if ownsOwnStarter(profile) then
		pct += math.max(0, math.floor(tonumber(buff.StarterPct) or 0))
	end
	return math.clamp(pct, 0, cap)
end

local EMPIRE_TAX_ATTR = "WE_EmpireTaxPct" -- = EconomyConfig.OutpostIncomeBuff.Attribute (fallback only)

-- WE_EmpireTaxPct (display only: the HUD chip). Written only when the value changes; nil and 0 both mean "none".
local function publishEmpireTax(player: Player, pct: number)
	local buff = EconomyConfig.OutpostIncomeBuff
	local attr = if buff and typeof(buff.Attribute) == "string" then buff.Attribute else EMPIRE_TAX_ATTR
	pcall(function()
		local cur = player:GetAttribute(attr)
		if cur ~= pct and not (cur == nil and pct == 0) then
			player:SetAttribute(attr, pct)
		end
	end)
end

local function cashMultFor(player: Player, profile: any, reason: string?): number
	local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
	local reasonKey = reason or ""
	local exempt = MonetizationConfig.CashMultExemptReasons
	local isExempt = NEVER_MULTIPLIED[reasonKey] == true or (exempt ~= nil and exempt[reasonKey] == true)
	local mult = 1
	if not isExempt then
		-- v69: prestige is part of the non-exempt stack (was applied to exempt reasons too)
		local prestige = math.max(0, tonumber(profile.Prestige) or 0)
		mult = 1 + prestige * (EconomyConfig.PrestigeCashMultiplierPerLevel or 0)
		-- F3 Empire Tax: captured outposts (+10 % each) and the own Home Outpost (+5 %), capped at +50 %
		local taxPct = empireTaxPct(profile)
		if taxPct > 0 then
			mult *= (1 + taxPct / 100)
		end
		if MonetizationService and MonetizationService.GetCashMultiplier then
			mult *= MonetizationService.GetCashMultiplier(player)
		end
		if SeasonService and SeasonService.GetCashMult then
			mult *= SeasonService.GetCashMult()
		end
	end
	return mult
end

local function applyCashMult(player: Player, profile: any, amount: number, reason: string?): number
	return math.floor(amount * cashMultFor(player, profile, reason))
end

-- v72: the multiplier AddCash / AccruePendingCash would apply for `reason` right now (1 for exempt reasons).
-- Display only (BaseService.IncomeMult -> WE_IncomeMult); never used to grant.
function EconomyService.GetCashMult(player: Player, reason: string?): number
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		return 1
	end
	return cashMultFor(player, profile, reason)
end

--[[ v72 WE_IncomePerSec (tycoon guide: cash pill "+$24/s", the pick's "ready in"): the last amount granted per steady
	reason (TycoonGuideConfig.SteadyIncomeReasons: passive / training / plot_oil), multipliers included, summed and
	divided by the passive TickSeconds, rounded to 0.1. A reason that missed SteadyIncomeExpireTicks ticks drops out
	(oil pumps after a rebirth). Written only when the value changes. Nothing here grants or changes money. ]]
type SteadyEntry = { Amount: number, At: number }
local steadyIncome: { [number]: { [string]: SteadyEntry } } = {}

-- F4 WE_TickTraining: the last training grant ($ per training tick, multipliers in) for the client's Training Yard
-- label (ProducerLabels). Gated on EconomyConfig.ProducerLabels.Enabled only (not the guide flag); written only when
-- the value changes. Oil pumps need no attribute: plot_oil is exempt, the label reads PlotOilPumpConfig.CashPerTick.
local TICK_TRAINING_ATTR = "WE_TickTraining"

local function noteTrainingTick(player: Player, reason: string?, granted: number)
	local labels = EconomyConfig.ProducerLabels
	if reason ~= "training" or not (labels and labels.Enabled == true) then
		return
	end
	pcall(function()
		if player:GetAttribute(TICK_TRAINING_ATTR) ~= granted then
			player:SetAttribute(TICK_TRAINING_ATTR, granted)
		end
	end)
end

local function noteSteadyIncome(player: Player, reason: string?, granted: number)
	noteTrainingTick(player, reason, granted) -- F4 (own flag; runs even while the guide is off)
	if not TycoonGuideConfig.Enabled or reason == nil or TycoonGuideConfig.SteadyIncomeReasons[reason] ~= true then
		return
	end
	local now = os.clock()
	local book = steadyIncome[player.UserId]
	if book == nil then
		book = {}
		steadyIncome[player.UserId] = book
	end
	local b = book :: { [string]: SteadyEntry }
	b[reason] = { Amount = granted, At = now }
	local tickSec = EconomyConfig.PassiveIncome.TickSeconds
	-- half a tick of slack: the pay loops wait TickSeconds plus their own work between grants
	local window = (TycoonGuideConfig.SteadyIncomeExpireTicks + 0.5) * tickSec
	local sum = 0
	for r, e in pairs(b) do
		if now - e.At > window then
			b[r] = nil
		else
			sum += e.Amount
		end
	end
	local perSec = if tickSec > 0 then math.floor(sum / tickSec * 10 + 0.5) / 10 else 0
	pcall(function()
		if player:GetAttribute("WE_IncomePerSec") ~= perSec then
			player:SetAttribute("WE_IncomePerSec", perSec)
		end
	end)
end

function EconomyService.Init(deps: { [string]: any })
	assert(deps.DataService, "EconomyService.Init missing deps.DataService")
	SeasonService = deps.SeasonService
	DataService = deps.DataService
	RemoteSetup = deps.RemoteSetup
	MissionService = deps.MissionService
	MonetizationService = deps.MonetizationService
	TutorialService = deps.TutorialService
	MoneyCollectorService = deps.MoneyCollectorService
	if TycoonGuideConfig.Enabled then
		game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
			steadyIncome[player.UserId] = nil
		end)
	end
end

function EconomyService.Push(player: Player)
	local DS = getDataService()
	if not DS then
		return
	end
	local profile = DS.GetProfile(player)
	if profile then
		pushEconomy(player, profile)
	end
end

function EconomyService.AddCash(player: Player, amount: number, reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return false
	end

	local granted = applyCashMult(player, profile, amount, reason)
	profile.Cash = math.clamp(profile.Cash + granted, EconomyConfig.MinCash, EconomyConfig.MaxCash)
	profile.Stats.TotalCashEarned += granted
	getDataService().MarkDirty(player)
	pushEconomy(player, profile)
	noteSteadyIncome(player, reason, granted) -- v72 WE_IncomePerSec (display only; no-op while the guide is off)
	if MissionService and MissionService.TrackProgress and reason ~= "mission" and reason ~= "achievement" then
		MissionService.TrackProgress(player, "EarnCash", granted)
	end
	if reason == "collector" and TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "PassiveIncome")
	end
	return true
end

--[[ Accrue passive / stipend into PendingCash (not spendable until Money Collector). ]]
function EconomyService.AccruePendingCash(player: Player, amount: number, reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return false
	end
	local granted = applyCashMult(player, profile, amount, reason)
	local pending = tonumber((profile :: any).PendingCash) or 0
	(profile :: any).PendingCash = math.clamp(pending + granted, 0, EconomyConfig.MaxCash)
	getDataService().MarkDirty(player)
	pushEconomy(player, profile)
	noteSteadyIncome(player, reason, granted) -- v72 WE_IncomePerSec (display only; no-op while the guide is off)
	if MoneyCollectorService and MoneyCollectorService.RefreshForPlayer then
		MoneyCollectorService.RefreshForPlayer(player)
	end
	return true
end

function EconomyService.CollectPendingCash(player: Player): number
	local profile = getDataService().GetProfile(player)
	if not profile then
		return 0
	end
	local pending = math.floor(tonumber((profile :: any).PendingCash) or 0)
	if pending <= 0 then
		return 0
	end
	(profile :: any).PendingCash = 0
	-- Pending already had mult applied at accrue; grant with exempt reason
	profile.Cash = math.clamp(profile.Cash + pending, EconomyConfig.MinCash, EconomyConfig.MaxCash)
	profile.Stats.TotalCashEarned += pending
	getDataService().MarkDirty(player)
	pushEconomy(player, profile)
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "EarnCash", pending)
	end
	return pending
end

function EconomyService.GetPendingCash(player: Player): number
	local profile = getDataService().GetProfile(player)
	if not profile then
		return 0
	end
	return math.floor(tonumber((profile :: any).PendingCash) or 0)
end


--[[
	v67: the loaded profile is the only source of truth. v62 lifted profile.Cash to max(profile, WE_Cash,
	leaderstats) because the profile was a placeholder while DataService failed to load; with real loads
	that turned any stale display value (EarlyRemotes' seeded StartingCash, cash before a rebirth reset)
	into free money. Now the displays are re-synced to the profile instead.
]]
function EconomyService.ReconcileSpendableCash(player: Player): number
	local DS = getDataService()
	if not DS then
		return 0
	end
	local profile = DS.GetProfile(player)
	if not profile then
		return 0
	end
	local have = math.floor(tonumber(profile.Cash) or 0)
	profile.Cash = have
	local attr = tonumber(player:GetAttribute("WE_Cash"))
	if attr == nil or math.floor(attr) ~= have then
		pushEconomy(player, profile)
	end
	return have
end

function EconomyService.SpendCash(player: Player, amount: number, _reason: string?): (boolean, string?)
	-- v64: NEVER throw — bad state returns false,"SpendFailed"
	-- v65: getDataService fallback so nil module never surfaces as GetProfile index error
	local ok, a, b = pcall(function(): (boolean, string?)
		local DS = getDataService()
		if not DS then
			return false, "NoDataService"
		end
		if typeof(amount) ~= "number" or amount ~= amount or amount < 0 then
			return false, "InvalidAmount"
		end
		amount = math.floor(amount)
		local profile = DS.GetProfile(player)
		if not profile then
			return false, "NoProfile"
		end
		-- v62/v64: sync profile to EarlyRemotes/leaderstats before afford check
		local have = 0
		if EconomyService.ReconcileSpendableCash then
			local rok, rhave = pcall(function()
				return EconomyService.ReconcileSpendableCash(player)
			end)
			if rok and typeof(rhave) == "number" then
				have = rhave
			end
		end
		profile = getDataService().GetProfile(player) or profile
		have = math.floor(tonumber(profile.Cash) or have)
		profile.Cash = have
		if have < amount then
			print(string.format("[Economy] SpendCash FAIL %s have=%d need=%d", player.Name, have, amount))
			return false, "InsufficientCash"
		end
		profile.Cash = have - amount
		pcall(function()
			getDataService().MarkDirty(player)
		end)
		pcall(function()
			pushEconomy(player, profile)
		end)
		return true, nil
	end)
	if not ok then
		warn("[Economy] SpendCash threw:", a)
		return false, "SpendFailed"
	end
	return (a :: any) :: boolean, b :: string?
end

function EconomyService.AddGold(player: Player, amount: number, _reason: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return false
	end
	profile.Gold = math.clamp(profile.Gold + amount, EconomyConfig.MinGold, EconomyConfig.MaxGold)
	profile.Stats.TotalGoldEarned += amount
	getDataService().MarkDirty(player)
	pushEconomy(player, profile)
	return true
end

function EconomyService.SpendGold(player: Player, amount: number, _reason: string?): (boolean, string?)
	if typeof(amount) ~= "number" or amount ~= amount or amount < 0 then
		return false, "InvalidAmount"
	end
	amount = math.floor(amount)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Gold < amount then
		return false, "InsufficientGold"
	end
	profile.Gold -= amount
	getDataService().MarkDirty(player)
	pushEconomy(player, profile)
	return true, nil
end

function EconomyService.GetCash(player: Player): number
	local profile = getDataService().GetProfile(player)
	return if profile then math.floor(tonumber(profile.Cash) or 0) else 0
end

function EconomyService.GetGold(player: Player): number
	local profile = getDataService().GetProfile(player)
	return if profile then profile.Gold else 0
end

function EconomyService.GetOutpostIncomeMultiplier(player: Player): number
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		return 1
	end
	return 1 + empireTaxPct(profile) / 100
end

--[[ F3: the player's Empire Tax as a whole percent (0..50): captured outposts x 10 + 5 for the own Home Outpost,
	capped. The same number cashMultFor pays with and WE_EmpireTaxPct shows. 0 without a profile. Never yields. ]]
function EconomyService.EmpireTaxPct(player: Player): number
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		return 0
	end
	return empireTaxPct(profile)
end

--[[ Grant one outpost income stack (capped). Prefer SyncOutpostIncomeStacks for contested ownership. ]]
function EconomyService.GrantOutpostIncomeStack(player: Player): (boolean, number, number)
	local profile = getDataService().GetProfile(player)
	if not profile then
		return false, 0, 0
	end
	local buff = EconomyConfig.OutpostIncomeBuff
	if not buff then
		return false, 0, 0
	end
	local maxStacks = buff.MaxStacks or 5
	local stacks = math.floor(tonumber((profile :: any).OutpostIncomeStacks) or 0)
	if stacks >= maxStacks then
		return false, stacks, 0
	end
	stacks += 1
	(profile :: any).OutpostIncomeStacks = stacks
	getDataService().MarkDirty(player)
	publishEmpireTax(player, empireTaxPct(profile))
	local pct = empireTaxSteps()
	return true, stacks, pct
end

--[[
	Recount OutpostIncomeStacks from profile.Territories (owned zone ids). F3: Home Outposts (Starter rows) are never
	a stack; the own one adds StarterPct to the total instead. Publishes WE_EmpireTaxPct (only when it changes).
	Returns (oldStacks, newStacks, percentPerStack, totalEmpireTaxPct). The 4th value is new in F3 (callers that read
	three values are unchanged); toasts that name the total use it or EconomyService.EmpireTaxPct.
	PersistClaims (EconomyConfig.OutpostIncomeBuff, lane W): the % is always derived from the profile, which is what
	persists; re-planting saved claims on join / releasing them on leave is TerritoryService's, which calls this after.
]]
function EconomyService.SyncOutpostIncomeStacks(player: Player): (number, number, number, number)
	local DS = getDataService()
	local profile = if DS then DS.GetProfile(player) else nil
	if not profile then
		return 0, 0, 0, 0
	end
	local perStack, maxStacks = empireTaxSteps()
	local owned = 0
	if typeof(profile.Territories) == "table" then
		for id in pairs(profile.Territories) do
			if not isStarterId(id) then
				owned += 1
			end
		end
	end
	local newStacks = math.clamp(owned, 0, maxStacks)
	local oldStacks = math.floor(tonumber((profile :: any).OutpostIncomeStacks) or 0)
	if oldStacks ~= oldStacks then
		oldStacks = 0
	end
	if oldStacks ~= newStacks then
		(profile :: any).OutpostIncomeStacks = newStacks
		DS.MarkDirty(player)
	end
	local total = empireTaxPct(profile)
	publishEmpireTax(player, total)
	return oldStacks, newStacks, perStack, total
end

--[[
	Move PendingCash from victim → thief without cash multipliers (already accrued).
	Returns amount transferred (0 if none).
]]
function EconomyService.TransferPendingCash(fromPlayer: Player, toPlayer: Player, amount: number): number
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	amount = math.floor(amount)
	local fromProfile = getDataService().GetProfile(fromPlayer)
	local toProfile = getDataService().GetProfile(toPlayer)
	if not fromProfile or not toProfile then
		return 0
	end
	local fromPending = math.floor(tonumber((fromProfile :: any).PendingCash) or 0)
	if fromPending <= 0 then
		return 0
	end
	local take = math.min(amount, fromPending)
	if take <= 0 then
		return 0
	end
	(fromProfile :: any).PendingCash = fromPending - take
	local toPending = math.floor(tonumber((toProfile :: any).PendingCash) or 0)
	;(toProfile :: any).PendingCash = math.clamp(toPending + take, 0, EconomyConfig.MaxCash)
	getDataService().MarkDirty(fromPlayer)
	getDataService().MarkDirty(toPlayer)
	pushEconomy(fromPlayer, fromProfile)
	pushEconomy(toPlayer, toProfile)
	if MoneyCollectorService and MoneyCollectorService.RefreshForPlayer then
		MoneyCollectorService.RefreshForPlayer(fromPlayer)
		MoneyCollectorService.RefreshForPlayer(toPlayer)
	end
	return take
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">FallSafetyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	FallSafetyService — teleport to plot spawn instead of void-Kill when
	HumanoidRootPart falls below FALL_Y (e.g. off oil decks / past Ground).
	Does not replace collide floor / SafetyCatch; soft recovery layer.

	streaming2 S1 (F3), only while Workspace.StreamingEnabled is on (StreamPrefetch.Enabled()):
	- no rescue while player.GameplayPaused: the phone is waiting for the ground to stream in (StreamingIntegrityMode
	  PauseOutsideLoadedArea), it is not falling. A rescue would send it to another spot it has not streamed, again
	  and again, with a toast each time.
	- no rescue while a pre-fetched move (StreamPrefetch) is already taking the player home;
	- the rescue goes through BaseService.TeleportToPlot, which pre-fetches the plot before the move;
	- the toast is NotifyThrottled: at most one per StreamingConfig.FallToastCooldown seconds.
	With streaming off every rescue and its toast are exactly as before.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local StreamingConfig = require(ReplicatedStorage:WaitForChild("Shared", 60).Configs.StreamingConfig)
local StreamPrefetch = require(script.Parent.Parent.Modules.StreamPrefetch)

local FallSafetyService = {}

local FALL_Y = 0.15 -- Ground top ~0.5; rescue as soon as under / through floor plane
local COOLDOWN_SEC = 0.9
local FALL_TOAST = "Rescued from fall — returned to base."

local BaseService: any = nil
local NotificationService: any = nil

local lastRescueAt: { [number]: number } = {}

local function rescue(player: Player, root: BasePart)
	local streaming = StreamPrefetch.Enabled()
	-- streaming2 S1 (F3): a paused phone waits for its ground; a pre-fetched move home is already on its way
	if streaming and (player.GameplayPaused or StreamPrefetch.IsMoving(player)) then
		return
	end
	local now = os.clock()
	local last = lastRescueAt[player.UserId] or 0
	if now - last < COOLDOWN_SEC then
		return
	end
	lastRescueAt[player.UserId] = now

	-- Stop downward velocity before teleport
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	if BaseService and BaseService.TeleportToPlot then
		BaseService.TeleportToPlot(player)
	else
		-- Fallback: origin above Ground (pre-fetched while streaming is on)
		StreamPrefetch.PivotTo(player, CFrame.new(0, 8, 0))
	end

	if NotificationService then
		if streaming and NotificationService.NotifyThrottled then
			NotificationService.NotifyThrottled(player, FALL_TOAST, "Info", 3, StreamingConfig.FallToastCooldown, "FallSafety")
		elseif NotificationService.Notify then
			NotificationService.Notify(player, FALL_TOAST, "Info", 3)
		end
	end
	print("[FallSafety] rescued", player.Name, "from Y<", FALL_Y)
end

function FallSafetyService.Init(deps: { [string]: any })
	BaseService = deps.BaseService
	NotificationService = deps.NotificationService

	-- Stepped heartbeat: cheap Y check only
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.1 then
			return
		end
		accum = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if not character then
				continue
			end
			local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root then
				continue
			end
			local hum = character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health <= 0 then
				continue
			end
			if root.Position.Y < FALL_Y then
				rescue(player, root)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastRescueAt[player.UserId] = nil
	end)

	print("[WAR EMPIRE] FallSafetyService ready (teleport if Y < " .. tostring(FALL_Y) .. "; SafetyCatch underfloor remains)")
end

return FallSafetyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">GateDefenseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Gate door defense — 2 GateGuards patrol + shoot enemies; L4+ AutoGun nests.
	Reads GatePost parts from WE_PerimeterWalls (does NOT edit StructureKitBuilder).
	Design Bot GATE_DEFENSE_WIRE: Guard 16134469614, AutoGun 4923345827, sandbag dress.
	Aggro covers MoneyCollector ATM approach (raid deterrent). No exotic persist.

	v69 (RaidConfig.Defense, spec §1.9): allies = owner + same clan (IsAlly); guards / AutoGuns posted INSIDE the
	gate and engaging any non-ally inside the walls (raider at the ATM first); guards are killable (weapon hits
	route through the GateBarrier hook) and respawn one at a time; the gate opens for the owner and clan-mates;
	Research TurretDamage multiplies guard + AutoGun damage; a missile strike (MissileStrikeService →
	SetDefensesDown) takes everything down until profile.Raid.DefensesDownUntil (os.time — the rest of this file
	uses os.clock).

	v71 (HUD v70 spec §4.2 / §5): no guard name cards and no auto-gun name cards (the client draws an HP bar after
	damage); the AutoGun marker ring and muzzle are painted, not neon; the gate shows ONE thin stud-scaled HP bar
	centred over the opening, only while damaged, breached, struck or raided; the owner gets one "BASE UNDER
	ATTACK!" Warn per plot per minute instead of a toast on every hit.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local InsertService = game:GetService("InsertService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local GateDefenseConfig = require(Shared.Configs.GateDefenseConfig)
local VisualAssetConfig = require(Shared.Configs.VisualAssetConfig)
local RaidConfig = require(Shared.Configs.RaidConfig)
local HudConfig = require(Shared.Configs.HudConfig)
local WorldLabelConfig = require(Shared.Configs.WorldLabelConfig)

local GateDefenseService = {}

local BaseService: any = nil
local DataService: any = nil
local VisualAssetService: any = nil
local ClanService: any = nil
local ResearchService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil

local PERIMETER_FOLDER = "WE_PerimeterWalls"
local DEFENSE_FOLDER = "WE_GateDefense"
local TAG_COLLECTOR = Constants.Tags.MoneyCollector

type GuardUnit = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Slot: number, -- 1 left, 2 right
	LastFireAt: number,
	WaypointIndex: number,
	IdleUntil: number,
	Alive: boolean,
	PostCf: CFrame,
}

type TurretUnit = {
	Model: Model,
	YawPart: BasePart,
	Slot: number,
	LastFireAt: number,
	Offline: boolean, -- v69: missile strike (defenses down)
}

type PlotDefense = {
	PlotId: number,
	OwnerUserId: number,
	WallsLevel: number,
	Folder: Folder,
	Guards: { GuardUnit },
	Turrets: { TurretUnit },
	GateCf: CFrame,
	CollectorPos: Vector3?,
	CollectorModel: Instance?, -- v69: ignored by line of sight (raider hiding behind the ATM body)
	GateHealth: number,
	GateMaxHealth: number,
	GateBreached: boolean,
	GateBarriers: { BasePart },
	GateRebuildAt: number?,
	LastRegenAt: number,
	-- v69
	DownUntil: number?, -- os.time: missile strike took the defenses down until then
	LastDownLabelAt: number,
	GateOpen: boolean, -- friendly gate: leaves open for the owner / clan-mates
	GateAllyAt: number, -- os.clock an ally was last at the gate
	PadCenter: Vector3?, -- plot pad (WE_BasePlot) centre, for "inside the walls"
	PadHalf: number,
}

local defenses: { [number]: PlotDefense } = {}
-- v69: one sync per plot at a time. Guard/AutoGun spawns can yield (catalog LoadAsset); two overlapping syncs
-- (walls purchase + plot-ready) used to both spawn into the same folder → duplicate / orphaned guards.
local syncBusy: { [number]: boolean } = {}
local syncAgain: { [number]: boolean } = {}
local victimHitAt: { [number]: number } = {}
local graceFrom: { [number]: number } = {} -- UserId → os.clock of the last character spawn / save load (spawn grace)
-- F6 novice shield: CombatService.IsNoviceShielded, handed in by CombatService.Init through SetShieldCheck (this
-- service takes no CombatService dep and never requires it). nil = nobody is shielded.
local shieldCheck: ((Player) -> boolean)? = nil
local catalogCache: { [number]: Model } = {}
local catalogFailed: { [number]: boolean } = {}

local function nowClock(): number
	return os.clock()
end

local function stripScripts(root: Instance)
	if VisualAssetConfig.StripScripts == false then
		return
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	for _, c in ipairs(root:GetChildren()) do
		if c:IsA("BaseScript") or c:IsA("ModuleScript") then
			c:Destroy()
		end
	end
end

local function loadCatalogModel(assetId: number): Model?
	if assetId <= 0 or catalogFailed[assetId] then
		return nil
	end
	if catalogCache[assetId] then
		return catalogCache[assetId]
	end
	local ok, result = pcall(function()
		return InsertService:LoadAsset(assetId)
	end)
	if not ok or typeof(result) ~= "Instance" then
		catalogFailed[assetId] = true
		return nil
	end
	local container = result :: Instance
	stripScripts(container)
	local model: Model? = nil
	if container:IsA("Model") then
		model = container
	else
		for _, c in ipairs(container:GetChildren()) do
			if c:IsA("Model") then
				model = c
				break
			end
		end
	end
	if not model then
		catalogFailed[assetId] = true
		pcall(function()
			container:Destroy()
		end)
		return nil
	end
	stripScripts(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.Massless = true
		end
	end
	model.Parent = nil
	catalogCache[assetId] = model
	if container ~= model then
		pcall(function()
			container:Destroy()
		end)
	end
	return model
end

local function scaleModelLongAxis(model: Model, targetStuds: number)
	local ok, size = pcall(function()
		return model:GetExtentsSize()
	end)
	if not ok or typeof(size) ~= "Vector3" then
		return
	end
	local longest = math.max(size.X, size.Y, size.Z)
	if longest < 0.05 then
		return
	end
	local factor = targetStuds / longest
	factor = math.clamp(factor, 0.05, 40)
	pcall(function()
		model:ScaleTo(factor)
	end)
end

local function findPlotFolder(plotId: number): Folder?
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	if not bases then
		return nil
	end
	local f = bases:FindFirstChild("Plot" .. tostring(plotId))
	if f and f:IsA("Folder") then
		return f
	end
	return nil
end

local function gatherGatePosts(plotFolder: Folder): { BasePart }
	local posts: { BasePart } = {}
	local peri = plotFolder:FindFirstChild(PERIMETER_FOLDER)
	local root = if peri then peri else plotFolder
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "GatePost" then
			table.insert(posts, d)
		end
	end
	return posts
end

local function computeGateCFrame(plotFolder: Folder, posts: { BasePart }): CFrame?
	if #posts < 2 then
		if #posts == 1 then
			local spawn = plotFolder:FindFirstChild("PlayerSpawn")
			local look = if spawn and spawn:IsA("BasePart")
				then (spawn.Position - posts[1].Position) * Vector3.new(1, 0, 1)
				else posts[1].CFrame.LookVector * Vector3.new(1, 0, 1)
			if look.Magnitude < 0.05 then
				look = Vector3.new(0, 0, 1)
			end
			local mid = posts[1].Position
			local y = mid.Y - posts[1].Size.Y * 0.5 + 3
			return CFrame.lookAt(Vector3.new(mid.X, y, mid.Z), Vector3.new(mid.X, y, mid.Z) + look.Unit)
		end
		return nil
	end
	local a, b = posts[1], posts[2]
	local mid = (a.Position + b.Position) * 0.5
	local along = (b.Position - a.Position) * Vector3.new(1, 0, 1)
	local spawn = plotFolder:FindFirstChild("PlayerSpawn")
	local outward: Vector3
	if spawn and spawn:IsA("BasePart") then
		outward = (spawn.Position - mid) * Vector3.new(1, 0, 1)
	else
		-- perpendicular to gate line
		outward = Vector3.new(-along.Z, 0, along.X)
	end
	if outward.Magnitude < 0.05 then
		outward = Vector3.new(0, 0, 1)
	end
	local y = math.min(a.Position.Y - a.Size.Y * 0.5, b.Position.Y - b.Size.Y * 0.5) + 3
	local origin = Vector3.new(mid.X, y, mid.Z)
	return CFrame.lookAt(origin, origin + outward.Unit)
end

local function findCollectorPos(plotId: number): Vector3?
	for _, inst in ipairs(CollectionService:GetTagged(TAG_COLLECTOR)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			return inst.Position
		end
	end
	local plotFolder = findPlotFolder(plotId)
	if plotFolder then
		local mc = plotFolder:FindFirstChild("MoneyCollector")
		if mc then
			local body = mc:FindFirstChild("CollectorBody")
			if body and body:IsA("BasePart") then
				return body.Position
			end
		end
	end
	return nil
end

-- v69: the plot's own ATM (MoneyCollector folder, or the tagged part) — guard / AutoGun line of sight ignores it,
-- otherwise a raider standing on the far side of the 6×8×4 ATM body is invisible to every post.
local function findCollectorModel(plotId: number): Instance?
	for _, inst in ipairs(CollectionService:GetTagged(TAG_COLLECTOR)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			local parent = inst.Parent
			if parent and parent.Name == "MoneyCollector" and (parent:IsA("Folder") or parent:IsA("Model")) then
				return parent
			end
			return inst
		end
	end
	return nil
end

local function clearDefense(plotId: number)
	local def = defenses[plotId]
	if not def then
		return
	end
	for _, g in ipairs(def.Guards) do
		g.Alive = false
		if g.Model and g.Model.Parent then
			g.Model:Destroy()
		end
	end
	for _, t in ipairs(def.Turrets) do
		if t.Model and t.Model.Parent then
			t.Model:Destroy()
		end
	end
	if def.Folder and def.Folder.Parent then
		def.Folder:Destroy()
	end
	defenses[plotId] = nil
end

local function ensureDefenseFolder(plotFolder: Folder): Folder
	local existing = plotFolder:FindFirstChild(DEFENSE_FOLDER)
	if existing and existing:IsA("Folder") then
		existing:ClearAllChildren()
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = DEFENSE_FOLDER
	f.Parent = plotFolder
	return f
end

local function faceYaw(root: BasePart, lookAt: Vector3)
	local flat = Vector3.new(lookAt.X, root.Position.Y, lookAt.Z)
	if (flat - root.Position).Magnitude < 0.05 then
		return
	end
	local look = CFrame.lookAt(root.Position, flat)
	local gyro = root:FindFirstChild("NPCFaceGyro")
	if gyro and gyro:IsA("BodyGyro") then
		gyro.CFrame = look
	end
end

-- v69 F4: set below (needs spawnGuardModel); a dead guard respawns alone, never through SyncPlot
local respawnGuard: (plotId: number, slot: number, ownerUserId: number, def: PlotDefense, dead: GuardUnit) -> ()

local function spawnGuardModel(ownerUserId: number, slot: number, at: CFrame, stats: any, parent: Folder, plotId: number): GuardUnit
	local model = Instance.new("Model")
	-- streaming2 S4 (F10): a gate guard (root, welded kit, Humanoid) reaches a client whole or not at all. Set before
	-- the model is parented (it is filled first, parented below). No effect with streaming off.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = "GateGuard_" .. tostring(slot)
	model:SetAttribute("GateGuard", true)
	model:SetAttribute("OwnerUserId", ownerUserId)
	model:SetAttribute("FriendlyGate", true)
	model:SetAttribute("PlotDefense", true)

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.CFrame = at
	root.Anchored = false
	root.CanCollide = true
	root.Color = Color3.fromRGB(70, 75, 55)
	root.Material = Enum.Material.Fabric
	root.Parent = model

	local function weldPart(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = at * offset
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = root
		return p
	end

	local olive = Color3.fromRGB(70, 75, 55)
	local skin = Color3.fromRGB(190, 160, 120)
	local head = weldPart("Head", Vector3.new(1.05, 1.05, 1.05), CFrame.new(0, 1.55, 0), skin, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = head
	weldPart("Helmet", Vector3.new(1.2, 0.5, 1.2), CFrame.new(0, 1.95, 0), Color3.fromRGB(45, 50, 40), Enum.Material.Metal, nil)
	weldPart("Vest", Vector3.new(2.1, 1.2, 1.15), CFrame.new(0, 0.15, 0), olive, Enum.Material.Fabric, nil)
	weldPart("LegL", Vector3.new(1, 2, 1), CFrame.new(-0.5, -2, 0), olive, Enum.Material.Fabric, nil)
	weldPart("LegR", Vector3.new(1, 2, 1), CFrame.new(0.5, -2, 0), olive, Enum.Material.Fabric, nil)
	weldPart("ArmL", Vector3.new(1, 2, 1), CFrame.new(-1.5, 0, 0), olive, Enum.Material.Fabric, nil)
	weldPart("ArmR", Vector3.new(1, 2, 1), CFrame.new(1.5, 0, 0), olive, Enum.Material.Fabric, nil)
	-- v33: clear rifle prop (receiver + barrel + mag + stock) so guards read as armed
	weldPart("Rifle", Vector3.new(0.32, 0.28, 2.6), CFrame.new(1.2, 0.2, -0.9), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil)
	weldPart("RifleStock", Vector3.new(0.28, 0.35, 0.7), CFrame.new(1.2, 0.15, 0.55), Color3.fromRGB(55, 45, 30), Enum.Material.Wood, nil)
	weldPart("RifleMag", Vector3.new(0.22, 0.55, 0.35), CFrame.new(1.2, -0.15, -0.35), Color3.fromRGB(40, 40, 42), Enum.Material.Metal, nil)
	weldPart("RifleBarrel", Vector3.new(0.16, 0.16, 0.9), CFrame.new(1.2, 0.22, -2.15), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil)
	weldPart("RifleSight", Vector3.new(0.12, 0.22, 0.35), CFrame.new(1.2, 0.45, -0.5), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil)

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = stats.GuardHealth
	humanoid.Health = stats.GuardHealth
	humanoid.WalkSpeed = stats.GuardWalkSpeed
	humanoid.AutoRotate = true
	humanoid.HipHeight = 2
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameOcclusion = Enum.NameOcclusion.OccludeAll
	humanoid.Parent = model

	-- v71: no "GATE GUARD" name card (spec §5: it drew through walls at 90 studs); the client shows an HP bar
	-- after damage.

	-- v69 F3: guards are killable. CombatService forwards a raycast hit on any GateBarrier-attributed part to
	-- ApplyDamage, which routes GateGuardPart hits to this humanoid. No WE_GateBarrier tag (that is the gate).
	local function markHittable(d: Instance)
		if d:IsA("BasePart") then
			d:SetAttribute("GateBarrier", true)
			d:SetAttribute("GateGuardPart", true)
			d:SetAttribute("PlotId", plotId)
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		markHittable(d)
	end
	model.DescendantAdded:Connect(markHittable) -- catalog character visual parts added below

	model.PrimaryPart = root
	-- Do NOT tag WE_NPC — CombatNPC would aggro owner
	model:SetAttribute("PlotId", plotId)
	model.Parent = parent
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	if VisualAssetService and VisualAssetService.TryAttachCharacterVisual then
		pcall(function()
			VisualAssetService.TryAttachCharacterVisual(model, GateDefenseConfig.VisualKind or "GateGuard")
		end)
	end

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "NPCFaceGyro"
	gyro.MaxTorque = Vector3.new(0, 4e5, 0)
	gyro.P = 5000
	gyro.D = 500
	gyro.CFrame = at
	gyro.Parent = root

	local unit: GuardUnit = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Slot = slot,
		LastFireAt = 0,
		WaypointIndex = 1,
		IdleUntil = 0,
		Alive = true,
		PostCf = at,
	}

	humanoid.Died:Connect(function()
		if not unit.Alive then
			return
		end
		unit.Alive = false
		task.delay(0.35, function()
			if model.Parent then
				model:Destroy()
			end
		end)
		-- v69 F4: respawn only this slot (a whole-plot SyncPlot used to reset a breached gate to full HP and
		-- respawn the other guard too)
		local def = defenses[plotId]
		if def and def.OwnerUserId == ownerUserId then
			task.delay(GateDefenseConfig.GuardRespawnSeconds or 12, respawnGuard, plotId, slot, ownerUserId, def, unit)
		end
	end)

	return unit
end

local function partKitAutoGun(at: CFrame, parent: Instance): (Model, BasePart)
	-- v35: obvious HMG tripod + long barrel + muzzle tip (readable at gate flanks)
	local model = Instance.new("Model")
	-- streaming2 S4 (F10): the AutoGun reaches a client whole or not at all; set before it is parented (below)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = "GateAutoGun_Fallback"
	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(2.4, 0.45, 2.4)
	base.CFrame = at
	base.Anchored = true
	base.CanCollide = false
	base.Color = Color3.fromRGB(64, 69, 71)
	base.Material = Enum.Material.Metal
	base.Parent = model
	-- Tripod legs
	for i, ang in ipairs({ 0, 120, 240 }) do
		local leg = Instance.new("Part")
		leg.Name = "TripodLeg" .. i
		leg.Size = Vector3.new(0.25, 2.2, 0.25)
		leg.CFrame = at * CFrame.Angles(0, math.rad(ang), 0) * CFrame.new(0.9, 0.9, 0) * CFrame.Angles(0, 0, math.rad(25))
		leg.Anchored = true
		leg.CanCollide = false
		leg.Color = Color3.fromRGB(50, 52, 48)
		leg.Material = Enum.Material.Metal
		leg.Parent = model
	end
	local yaw = Instance.new("Part")
	yaw.Name = "Yaw"
	yaw.Size = Vector3.new(1.4, 0.7, 1.4)
	yaw.CFrame = at * CFrame.new(0, 1.35, 0)
	yaw.Anchored = true
	yaw.CanCollide = false
	yaw.Color = Color3.fromRGB(55, 58, 60)
	yaw.Material = Enum.Material.Metal
	yaw.Parent = model
	-- Gun shield plate
	local shield = Instance.new("Part")
	shield.Name = "Shield"
	shield.Size = Vector3.new(2.2, 1.4, 0.18)
	shield.CFrame = yaw.CFrame * CFrame.new(0, 0.5, -0.7)
	shield.Anchored = true
	shield.CanCollide = false
	shield.Color = Color3.fromRGB(70, 75, 68)
	shield.Material = Enum.Material.Metal
	shield.Parent = model
	local barrel = Instance.new("Part")
	barrel.Name = "Barrel"
	barrel.Shape = Enum.PartType.Cylinder
	barrel.Size = Vector3.new(4.2, 0.35, 0.35)
	barrel.CFrame = yaw.CFrame * CFrame.new(0, 0.35, -2.2) * CFrame.Angles(0, 0, math.rad(90))
	barrel.Anchored = true
	barrel.CanCollide = false
	barrel.Color = Color3.fromRGB(35, 37, 40)
	barrel.Material = Enum.Material.Metal
	barrel.Parent = model
	local muzzle = Instance.new("Part")
	muzzle.Name = "MuzzleTip"
	muzzle.Shape = Enum.PartType.Ball
	muzzle.Size = Vector3.new(0.55, 0.55, 0.55)
	muzzle.CFrame = yaw.CFrame * CFrame.new(0, 0.35, -4.3)
	muzzle.Anchored = true
	muzzle.CanCollide = false
	muzzle.Color = Color3.fromRGB(255, 160, 40)
	muzzle.Material = Enum.Material.SmoothPlastic -- v71: painted, not neon (not a light source)
	muzzle.Parent = model
	model.PrimaryPart = yaw
	model.Parent = parent
	return model, yaw
end

local function attachTurretVisualMarker(model: Model, at: CFrame)
	-- Painted ring under the nest so upgraded AutoGuns read even before the catalog mesh loads.
	-- v71: SmoothPlastic, no floating name card over the gun (spec §5 neon + label clean-up).
	if model:FindFirstChild("WE_TurretMarker") then
		return
	end
	local ring = Instance.new("Part")
	ring.Name = "WE_TurretMarker"
	ring.Size = Vector3.new(3.2, 0.18, 3.2)
	ring.CFrame = at * CFrame.new(0, 0.15, 0)
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Color = Color3.fromRGB(200, 80, 40)
	ring.Material = Enum.Material.SmoothPlastic
	ring.Parent = model
end

local function spawnAutoGun(slot: number, at: CFrame, parent: Folder): TurretUnit?
	local gd = (VisualAssetConfig :: any).GateDefense
	local assetId = 4923345827
	if gd and gd.AutoGun and typeof(gd.AutoGun.ModelAssetId) == "number" then
		assetId = gd.AutoGun.ModelAssetId
	end
	local template = loadCatalogModel(assetId)
	local model: Model
	local yawPart: BasePart
	if template then
		model = template:Clone()
		stripScripts(model)
		scaleModelLongAxis(model, GateDefenseConfig.AutoGunLongAxisStuds or 5.5)
		model.Name = "GateAutoGun_" .. tostring(slot)
		if not model.PrimaryPart then
			local pp = model:FindFirstChildWhichIsA("BasePart", true)
			if pp and pp:IsA("BasePart") then
				model.PrimaryPart = pp
			end
		end
		model:PivotTo(at)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
		-- streaming2 S4 (F10): the catalog AutoGun is Atomic too, set before it is parented. No effect with streaming off.
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		model.Parent = parent
		yawPart = model.PrimaryPart :: BasePart
		local named = model:FindFirstChild("Barrel", true) or model:FindFirstChild("Yaw", true)
		if named and named:IsA("BasePart") then
			yawPart = named
		end
	else
		model, yawPart = partKitAutoGun(at, parent)
		model.Name = "GateAutoGun_" .. tostring(slot)
	end

	model:SetAttribute("GateAutoGun", true)
	model:SetAttribute("FriendlyGate", true)
	attachTurretVisualMarker(model, at)

	-- Sandbag nest dress under gun
	if gd and gd.SandbagNest and typeof(gd.SandbagNest.ModelAssetId) == "number" then
		local nestT = loadCatalogModel(gd.SandbagNest.ModelAssetId)
		if nestT then
			local nest = nestT:Clone()
			stripScripts(nest)
			scaleModelLongAxis(nest, GateDefenseConfig.SandbagNestDiameterStuds or 8)
			nest.Name = "SandbagNest_" .. tostring(slot)
			nest:PivotTo(at * CFrame.new(0, -0.2, 0))
			for _, d in ipairs(nest:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
				end
			end
			nest.Parent = parent
		end
	end

	-- Scatter sandbags
	local bagId = if gd and gd.Sandbags then gd.Sandbags.ModelAssetId else 3525056989
	if typeof(bagId) == "number" and bagId > 0 then
		local bagT = loadCatalogModel(bagId)
		if bagT then
			for i = 1, 3 do
				local bag = bagT:Clone()
				stripScripts(bag)
				scaleModelLongAxis(bag, 2.2)
				local ox = (i - 2) * 1.4
				bag:PivotTo(at * CFrame.new(ox, -0.1, 1.6 + (i % 2) * 0.4))
				for _, d in ipairs(bag:GetDescendants()) do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
					end
				end
				bag.Name = "Sandbag_" .. tostring(slot) .. "_" .. tostring(i)
				bag.Parent = parent
			end
		end
	end

	return {
		Model = model,
		YawPart = yawPart,
		Slot = slot,
		LastFireAt = 0,
		Offline = false,
	}
end

--[[ v69 F1: allies = the owner, or a player in the owner's clan (same non-empty ClanService clan id; the owner
	must be online). Nation colour no longer matters (it is userId % 8, never chosen: 1 in 8 random players used
	to be ignored by your guards and unable to damage your gate). Used by raids and strikes too. ]]
function GateDefenseService.IsAlly(ownerUserId: number, player: Player): boolean
	if player.UserId == ownerUserId then
		return true
	end
	if not (ClanService and ClanService.GetClanId) then
		return false
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not owner then
		return false
	end
	local okA, a = pcall(ClanService.GetClanId, owner)
	local okB, b = pcall(ClanService.GetClanId, player)
	return okA and okB and typeof(a) == "string" and a ~= "" and a == b
end

local function isEnemyPlayer(ownerUserId: number, player: Player): boolean
	return not GateDefenseService.IsAlly(ownerUserId, player)
end

-- v69 F6: Research "TurretDamage" of the owner multiplies guard + AutoGun damage (read at fire time)
local function researchMult(ownerUserId: number): number
	if not (ResearchService and ResearchService.GetBonus) then
		return 1
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not owner then
		return 1
	end
	local ok, v = pcall(ResearchService.GetBonus, owner, RaidConfig.Defense.ResearchStat)
	if not ok or typeof(v) ~= "number" or v ~= v then
		return 1
	end
	return math.clamp(v, 1, RaidConfig.Defense.MaxResearchMult)
end

local function isDown(def: PlotDefense): boolean
	return def.DownUntil ~= nil and os.time() < (def.DownUntil :: number)
end

local function insidePlot(def: PlotDefense, pos: Vector3): boolean
	local c = def.PadCenter
	if not c then
		return false
	end
	return math.abs(pos.X - c.X) <= def.PadHalf and math.abs(pos.Z - c.Z) <= def.PadHalf
end

-- Guards chase only to points inside the plot (never out through the gate)
local function clampInsidePlot(def: PlotDefense, pos: Vector3): Vector3
	local c = def.PadCenter
	if not c then
		return pos
	end
	local h = math.max(0, def.PadHalf - 4)
	return Vector3.new(math.clamp(pos.X, c.X - h, c.X + h), pos.Y, math.clamp(pos.Z, c.Z - h, c.Z + h))
end

local function hasLos(fromPos: Vector3, toPos: Vector3, ignore: { Instance }): boolean
	if not GateDefenseConfig.RequireLineOfSight then
		return true
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	-- v69: non-collidable decor (wire, trims, signs, lamp shades) no longer blocks the shot
	params.RespectCanCollide = RaidConfig.Defense.LosRespectCanCollide
	local dir = toPos - fromPos
	local maxD = GateDefenseConfig.LosMaxDistance or 110
	if dir.Magnitude > maxD then
		dir = dir.Unit * maxD
	end
	local hit = Workspace:Raycast(fromPos + Vector3.new(0, 1.5, 0), dir, params)
	if not hit then
		return true
	end
	-- Hit character of target is OK — we ray toward root; if we hit something else first, blocked
	local inst = hit.Instance
	for _, ig in ipairs(ignore) do
		if inst:IsDescendantOf(ig) or inst == ig then
			return true
		end
	end
	-- Allow hitting the target character: ignore list should include target model when calling
	return false
end


-- v71: one "BASE UNDER ATTACK!" owner Warn per plot per BaseUnderAttackCooldown (spec §4.2)
local lastAttackAlertAt: { [number]: number } = {}
local barCheckAt: { [number]: number } = {}

local function alertBaseUnderAttack(plotId: number?, ownerUserId: number?, attacker: Player?)
	if not NotificationService or typeof(plotId) ~= "number" or typeof(ownerUserId) ~= "number" then
		return
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not owner or owner == attacker then
		return
	end
	local now = os.clock()
	local cd = GateDefenseConfig.BaseUnderAttackCooldown or 60
	if now - (lastAttackAlertAt[plotId] or -math.huge) < cd then
		return
	end
	lastAttackAlertAt[plotId] = now
	NotificationService.Notify(owner, GateDefenseConfig.BaseUnderAttackToast or "BASE UNDER ATTACK!", "Warn", 4)
end

--[[ Spawn grace (GateDefenseConfig.SpawnGraceSeconds). Every PlayerSpawn pad sits at somebody's gate, and a new
	player stands there until the save loads and BaseService moves them to their own plot. So guards and AutoGuns
	ignore a player whose save has not loaded (DataService.GetProfile is nil; such a player cannot fire either), and
	for SpawnGraceSeconds after each character spawn and after the save loads (the move home is deferred). A
	respawned raider is moved to their own plot at once. The grace ends early for anyone holding an ATM raid or
	hitting a gate / guard (ApplyDamage), so a player left on a gate pad (no plot: server over MaxPlots) cannot
	use it to attack.
	F6 (owner's 11 features): a player under the novice shield (CombatService) counts as in grace too, so guards and
	AutoGuns neither target nor damage them and the owner gets no "BASE UNDER ATTACK" for them; holding an ATM raid
	still ends it here first. ]]
local function inSpawnGrace(player: Player): boolean
	if DataService and DataService.GetProfile and DataService.GetProfile(player) == nil then
		return true
	end
	if player:GetAttribute("WE_RaidingPlot") ~= nil then
		return false
	end
	local check = shieldCheck
	if check ~= nil then
		local ok, shielded = pcall(check, player)
		if ok and shielded == true then
			return true
		end
	end
	local from = graceFrom[player.UserId]
	return from ~= nil and nowClock() - from < (GateDefenseConfig.SpawnGraceSeconds or 4)
end

local function startSpawnGrace(player: Player)
	graceFrom[player.UserId] = nowClock()
end

-- F6: CombatService.Init hands in CombatService.IsNoviceShielded (nil clears it)
function GateDefenseService.SetShieldCheck(fn: ((Player) -> boolean)?)
	shieldCheck = fn
end

local function rateLimitVictim(userId: number): boolean
	local t = nowClock()
	local last = victimHitAt[userId] or 0
	local cd = GateDefenseConfig.DamageCooldownGlobal or 0.08
	if t - last < cd then
		return false
	end
	victimHitAt[userId] = t
	return true
end

--[[ v69 F2: target choice. In aggro: within `aggro` of the shooter, near the ATM, or (EngageIntrudersInsideWalls)
	anywhere inside the plot. Priority: the player holding a raid on this plot's ATM (WE_RaidingPlot), then anyone
	near the ATM, then the nearest. `maxReach` (AutoGuns — they cannot chase) skips targets beyond it. ]]
local function nearestEnemy(def: PlotDefense, fromPos: Vector3, aggro: number, maxReach: number?): (Player?, Humanoid?, BasePart?, number)
	local bestPlr: Player? = nil
	local bestHum: Humanoid? = nil
	local bestRoot: BasePart? = nil
	local bestDist = aggro
	local bestTier = math.huge
	local collectorPos = def.CollectorPos
	local protectR = GateDefenseConfig.ProtectCollectorRadius or 42
	local engageInside = RaidConfig.Defense.EngageIntrudersInsideWalls

	for _, player in ipairs(Players:GetPlayers()) do
		if isEnemyPlayer(def.OwnerUserId, player) and not inSpawnGrace(player) then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and root and root:IsA("BasePart") and hum.Health > 0 then
				local pos = root.Position
				local d = (pos - fromPos).Magnitude
				local nearATM = collectorPos ~= nil and (pos - (collectorPos :: Vector3)).Magnitude <= protectR
				local inAggro = d <= aggro or nearATM or (engageInside and insidePlot(def, pos))
				if inAggro and (maxReach == nil or d <= (maxReach :: number)) then
					local tier = if player:GetAttribute("WE_RaidingPlot") == def.PlotId then 0 elseif nearATM then 1 else 2
					if tier < bestTier or (tier == bestTier and d < bestDist) then
						bestTier = tier
						bestDist = d
						bestPlr = player
						bestHum = hum
						bestRoot = root
					end
				end
			end
		end
	end
	return bestPlr, bestHum, bestRoot, bestDist
end

local function dealDamage(player: Player, hum: Humanoid, amount: number, sourceModel: Model, plotId: number?)
	if amount <= 0 or hum.Health <= 0 then
		return
	end
	if inSpawnGrace(player) then
		return
	end
	if not rateLimitVictim(player.UserId) then
		return
	end
	-- Never friendly-fire owner's soldiers / squad
	-- (v69: only when the shooter has an owner — AutoGun models had none, so nil == nil skipped every hit)
	local char = player.Character
	local srcOwner = sourceModel:GetAttribute("OwnerUserId")
	if char and (char:GetAttribute("FriendlySquad") or (srcOwner ~= nil and char:GetAttribute("OwnerUserId") == srcOwner)) then
		return
	end
	hum:TakeDamage(amount)
	-- the defenses are engaging an intruder: tell the owner once a minute (not on every hit)
	local def = if plotId ~= nil then defenses[plotId] else nil
	alertBaseUnderAttack(plotId, if def then def.OwnerUserId else tonumber(sourceModel:GetAttribute("OwnerUserId")), player)
end


local function gateMaxHealthForWalls(wallsLevel: number): number
	local map = GateDefenseConfig.GateMaxHealthByWallsLevel
	if typeof(map) == "table" then
		local h = (map :: any)[math.clamp(math.floor(wallsLevel), 1, 5)]
		if typeof(h) == "number" then
			return h :: number
		end
	end
	return 800 + math.max(wallsLevel, 1) * 400
end

local function setGateBarrierOpen(parts: { BasePart }, open: boolean)
	for _, p in ipairs(parts) do
		if p and p.Parent then
			p.CanCollide = not open
			p.Transparency = if open then 0.55 else 0.15
			p:SetAttribute("GateBreached", open)
			if open then
				p.Color = Color3.fromRGB(90, 70, 55)
				p.Material = Enum.Material.Concrete
			else
				p.Color = Color3.fromRGB(55, 58, 62)
				p.Material = Enum.Material.Metal
			end
		end
	end
end

-- ── gate HP bar (v71, spec §5 "WE_GateHP ×2 → one thin bar centred on the gate") ───────────────────────────

-- an ATM raid hold is running on this plot (MoneyCollectorService stamps WE_RaidingPlot on the thief)
local function plotRaidActive(plotId: any): boolean
	if typeof(plotId) ~= "number" then
		return false
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl:GetAttribute("WE_RaidingPlot") == plotId then
			return true
		end
	end
	return false
end

local function gateBar(parts: { BasePart }): BillboardGui?
	for _, p in ipairs(parts) do
		local bb = p and p:FindFirstChild("WE_GateHP")
		if bb and bb:IsA("BillboardGui") then
			return bb
		end
	end
	return nil
end

-- One bar per gate: a BillboardGui on leaf 1 whose Adornee is an attachment at the middle of the opening.
-- Stud-scaled, never AlwaysOnTop, MaxDistance <= 40; a 14 px status line shows only when breached / down.
local function buildGateBar(leaf: BasePart, gateCf: CFrame, height: number, maxHp: number)
	local cfg = GateDefenseConfig.GateBar
	local studs: Vector2 = cfg.Studs
	local att = Instance.new("Attachment")
	att.Name = "WE_GateBarAnchor"
	att.Parent = leaf
	att.WorldPosition = (gateCf * CFrame.new(0, height - 0.5 + cfg.HeightAbove, 0)).Position
	local bb = Instance.new("BillboardGui")
	bb.Name = "WE_GateHP"
	bb.Adornee = att
	bb.Size = UDim2.fromScale(studs.X, studs.Y)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = math.min(cfg.MaxDistance, WorldLabelConfig.MaxDistance)
	bb.Enabled = false -- only while damaged / breached / down / raided (updateGateBillboard, updateDownBillboard)
	bb:SetAttribute("MaxHealth", maxHp)
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0.5, 1)
	track.Position = UDim2.fromScale(0.5, 1)
	track.Size = UDim2.new(1, 0, 0, 6)
	track.BackgroundColor3 = HudConfig.Colors.Ink
	track.BackgroundTransparency = 0.25
	track.BorderSizePixel = 0
	track.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(120, 200, 255)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local lbl = Instance.new("TextLabel")
	lbl.Name = "Label"
	lbl.AnchorPoint = Vector2.new(0.5, 1)
	lbl.Position = UDim2.new(0.5, 0, 1, -8)
	lbl.Size = UDim2.new(1, 0, 0, 16)
	lbl.BackgroundTransparency = 1
	lbl.Font = HudConfig.WorldLabels.Default.Font
	lbl.TextSize = WorldLabelConfig.MinTextSize
	lbl.TextScaled = false
	lbl.TextStrokeColor3 = HudConfig.Colors.Ink
	lbl.TextStrokeTransparency = 0
	lbl.TextColor3 = Color3.fromRGB(255, 160, 80)
	lbl.Text = ""
	lbl.Visible = false
	lbl.Parent = bb
	bb.Parent = leaf
end

-- status: nil = normal (bar only), else the line above the bar ("BREACHED", "DEFENSES DOWN 4:59")
local function setGateBar(parts: { BasePart }, ratio: number, status: string?, statusColor: Color3?, show: boolean)
	local bb = gateBar(parts)
	if not bb then
		return
	end
	local fill = bb:FindFirstChild("Fill", true)
	if fill and fill:IsA("Frame") then
		local want = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
		if fill.Size ~= want then
			fill.Size = want
		end
	end
	local lbl = bb:FindFirstChild("Label")
	if lbl and lbl:IsA("TextLabel") then
		local vis = status ~= nil
		if lbl.Visible ~= vis then
			lbl.Visible = vis
		end
		if status and lbl.Text ~= status then
			lbl.Text = status
		end
		if statusColor and lbl.TextColor3 ~= statusColor then
			lbl.TextColor3 = statusColor
		end
	end
	if bb.Enabled ~= show then
		bb.Enabled = show
	end
end

local function updateGateBillboard(parts: { BasePart }, health: number, maxHealth: number, breached: boolean)
	local plotId = parts[1] and parts[1]:GetAttribute("PlotId")
	if breached then
		setGateBar(parts, 0, "BREACHED", Color3.fromRGB(255, 160, 80), true)
	else
		local damaged = health < maxHealth - 0.5
		setGateBar(parts, health / math.max(maxHealth, 1), nil, nil, damaged or plotRaidActive(plotId))
	end
end

local function spawnGateBarriers(gateCf: CFrame, wallsLevel: number, parent: Folder, plotId: number, ownerUserId: number): ({ BasePart }, number)
	local clear = GateDefenseConfig.GateClearStuds or 10
	local thickness = GateDefenseConfig.GateBarrierThickness or 1.6
	local height = GateDefenseConfig.GateBarrierHeight or 9
	local maxHp = gateMaxHealthForWalls(wallsLevel)
	local parts: { BasePart } = {}
	local leafW = clear * 0.5 - 0.15
	for i, sx in ipairs({ -leafW * 0.5 - 0.1, leafW * 0.5 + 0.1 }) do
		local leaf = Instance.new("Part")
		leaf.Name = "GateBarrier_" .. tostring(i)
		leaf.Size = Vector3.new(leafW, height, thickness)
		leaf.CFrame = gateCf * CFrame.new(sx, height * 0.5 - 0.5, 0)
		leaf.Anchored = true
		leaf.CanCollide = true
		leaf.CanTouch = false
		leaf.CanQuery = true
		leaf.Color = Color3.fromRGB(55, 58, 62)
		leaf.Material = Enum.Material.Metal
		leaf.Transparency = 0.15
		leaf.CastShadow = true
		leaf:SetAttribute("PlotId", plotId)
		leaf:SetAttribute("OwnerUserId", ownerUserId)
		leaf:SetAttribute("GateBarrier", true)
		leaf:SetAttribute("GateHealth", maxHp)
		leaf:SetAttribute("GateMaxHealth", maxHp)
		leaf:SetAttribute("GateBreached", false)
		leaf.Parent = parent
		local tag = GateDefenseConfig.GateDamageTag or (Constants.Tags and Constants.Tags.GateBarrier) or "WE_GateBarrier"
		pcall(function()
			CollectionService:AddTag(leaf, tag)
		end)
		if i == 1 then
			buildGateBar(leaf, gateCf, height, maxHp) -- one bar for both leaves
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "GateRepairPrompt"
		prompt.ActionText = "Repair Gate"
		prompt.ObjectText = "$" .. tostring(GateDefenseConfig.GateRepairCashCost or 750)
		prompt.HoldDuration = 0.6
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = leaf
		table.insert(parts, leaf)
	end
	return parts, maxHp
end

local function rebuildGate(def: PlotDefense)
	def.GateBreached = false
	def.GateHealth = def.GateMaxHealth
	def.GateRebuildAt = nil
	def.GateOpen = false
	setGateBarrierOpen(def.GateBarriers, false)
	for _, p in ipairs(def.GateBarriers) do
		if p and p.Parent then
			p:SetAttribute("GateHealth", def.GateHealth)
			p:SetAttribute("GateBreached", false)
			p:SetAttribute("GateOpen", false)
			local prompt = p:FindFirstChild("GateRepairPrompt")
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.Enabled = false
			end
		end
	end
	updateGateBillboard(def.GateBarriers, def.GateHealth, def.GateMaxHealth, false)
end

local function breachGate(def: PlotDefense)
	if def.GateBreached then
		return
	end
	def.GateBreached = true
	def.GateHealth = 0
	def.GateRebuildAt = os.clock() + (GateDefenseConfig.GateRebuildSeconds or 50)
	def.GateOpen = false
	setGateBarrierOpen(def.GateBarriers, true)
	for _, p in ipairs(def.GateBarriers) do
		if p and p.Parent then
			p:SetAttribute("GateHealth", 0)
			p:SetAttribute("GateBreached", true)
			p:SetAttribute("GateOpen", false)
			local prompt = p:FindFirstChild("GateRepairPrompt")
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.Enabled = true
			end
		end
	end
	updateGateBillboard(def.GateBarriers, 0, def.GateMaxHealth, true)
	local owner = Players:GetPlayerByUserId(def.OwnerUserId)
	if owner and NotificationService then
		NotificationService.Notify(owner, GateDefenseConfig.GateBreachToast or "Gate breached!", "Warn")
	end
end

--[[ v69 F3 order: (1) sane amount + attacker alive and close to the hit part, (2) a defense on that plot and the
	attacker is not an ally, (3) a guard part → that guard's humanoid takes the damage, (4) else the gate barrier
	(still false while breached or down). Called by CombatService for any hit on a GateBarrier-attributed part. ]]
function GateDefenseService.ApplyDamage(attacker: Player, hitPart: BasePart, amount: number, _weaponId: string?): boolean
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 or amount == math.huge then
		return false
	end
	if not hitPart or hitPart:GetAttribute("GateBarrier") ~= true then
		return false
	end
	local isGuardPart = hitPart:GetAttribute("GateGuardPart") == true
	local char = attacker.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local hum = (char :: Model):FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false
	end
	local maxDist = if isGuardPart then RaidConfig.Defense.GuardHitMaxDistance else 120
	if (root.Position - hitPart.Position).Magnitude > maxDist then
		return false
	end
	local plotId = hitPart:GetAttribute("PlotId")
	if typeof(plotId) ~= "number" then
		return false
	end
	local def = defenses[plotId :: number]
	if not def then
		return false
	end
	if GateDefenseService.IsAlly(def.OwnerUserId, attacker) then
		return false
	end
	graceFrom[attacker.UserId] = nil -- attacking the defenses ends the spawn grace

	if isGuardPart then
		for _, g in ipairs(def.Guards) do
			if hitPart == g.Root or hitPart:IsDescendantOf(g.Model) then
				if g.Alive and g.Humanoid.Health > 0 then
					g.Humanoid:TakeDamage(amount)
					alertBaseUnderAttack(def.PlotId, def.OwnerUserId, attacker)
					return true
				end
				return false
			end
		end
		return false
	end

	if def.GateBreached or isDown(def) then
		return false
	end
	def.GateHealth = math.max(0, def.GateHealth - amount)
	for _, p in ipairs(def.GateBarriers) do
		if p and p.Parent then
			p:SetAttribute("GateHealth", def.GateHealth)
		end
	end
	updateGateBillboard(def.GateBarriers, def.GateHealth, def.GateMaxHealth, false)
	alertBaseUnderAttack(def.PlotId, def.OwnerUserId, attacker)
	if def.GateHealth <= 0 then
		breachGate(def)
	end
	return true
end

function GateDefenseService.TryRepair(player: Player, plotId: number): boolean
	local def = defenses[plotId]
	if not def then
		return false
	end
	if player.UserId ~= def.OwnerUserId then
		return false
	end
	if isDown(def) then
		if NotificationService then
			local left = (def.DownUntil :: number) - os.time()
			NotificationService.Notify(player, "Defenses down — back in " .. RaidConfig.FormatTime(left), "Warn")
		end
		return false
	end
	if not def.GateBreached then
		return false
	end
	local cost = GateDefenseConfig.GateRepairCashCost or 750
	if EconomyService and EconomyService.SpendCash then
		local ok = EconomyService.SpendCash(player, cost, "gate_repair")
		if not ok then
			if NotificationService then
				NotificationService.Notify(player, "Need $" .. tostring(cost) .. " to repair gate", "Warn")
			end
			return false
		end
	end
	rebuildGate(def)
	if NotificationService then
		NotificationService.Notify(player, GateDefenseConfig.GateRepairedToast or "Gate repaired", "Success")
	end
	return true
end

-- ── v69 F5: friendly gate ───────────────────────────────────────────────────

local function setFriendlyGateOpen(def: PlotDefense, open: boolean)
	def.GateOpen = open
	for _, p in ipairs(def.GateBarriers) do
		if p and p.Parent then
			p.CanCollide = not open
			p.Transparency = if open then 0.8 else 0.15
			p:SetAttribute("GateOpen", open)
		end
	end
end

-- Intact barrier: open while the owner / a clan-mate stands at the gate, close GateCloseDelay s after they leave.
local function updateFriendlyGate(def: PlotDefense, tnow: number)
	if def.GateBreached or isDown(def) then
		return
	end
	local D = RaidConfig.Defense
	local gatePos = def.GateCf.Position
	local allyNear = false
	for _, player in ipairs(Players:GetPlayers()) do
		if GateDefenseService.IsAlly(def.OwnerUserId, player) then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local delta = root.Position - gatePos
				if Vector3.new(delta.X, 0, delta.Z).Magnitude <= D.GateOpenRadius and math.abs(delta.Y) <= D.GateOpenHeight then
					allyNear = true
					break
				end
			end
		end
	end
	if allyNear then
		def.GateAllyAt = tnow
		if not def.GateOpen then
			setFriendlyGateOpen(def, true)
		end
	elseif def.GateOpen and tnow - def.GateAllyAt >= D.GateCloseDelay - 1e-6 then
		setFriendlyGateOpen(def, false)
	end
end

-- ── v69 F7: defenses down (missile strike) ─────────────────────────────────

local function updateDownBillboard(def: PlotDefense)
	local left = math.max(0, (def.DownUntil or 0) - os.time())
	setGateBar(def.GateBarriers, 0, "DEFENSES DOWN " .. RaidConfig.FormatTime(left), Color3.fromRGB(255, 110, 90), true)
end

local RUBBLE: { { number } } = {
	{ -3.2, 0.6, 2.2 },
	{ 2.6, -0.8, 1.8 },
	{ -0.6, 1.9, 1.5 },
	{ 4.1, 1.2, 1.3 },
	{ -4.6, -1.5, 1.6 },
}

-- Guards blown up, AutoGuns offline, gate barrier blown open + rubble/fire (all inside WE_GateDefense;
-- WE_PerimeterWalls is never touched). `blast` = visual-only server explosions on the live guards.
local function applyDefensesDown(def: PlotDefense, untilUnix: number, blast: boolean)
	def.DownUntil = untilUnix
	def.LastDownLabelAt = nowClock()
	for _, g in ipairs(def.Guards) do
		if g.Alive and blast and g.Root.Parent then
			local ex = Instance.new("Explosion")
			ex.Position = g.Root.Position
			ex.BlastRadius = 6
			ex.BlastPressure = 0
			ex.DestroyJointRadiusPercent = 0
			ex.ExplosionType = Enum.ExplosionType.NoCraters
			ex.Parent = Workspace
		end
		g.Alive = false
		if g.Model.Parent then
			g.Model:Destroy()
		end
	end
	for _, t in ipairs(def.Turrets) do
		t.Offline = true
		t.Model:SetAttribute("Offline", true)
		if t.YawPart.Parent and not t.YawPart:FindFirstChild("WE_StrikeSmoke") then
			local smoke = Instance.new("Smoke")
			smoke.Name = "WE_StrikeSmoke"
			smoke.Color = Color3.fromRGB(45, 45, 48)
			smoke.Opacity = 0.35
			smoke.RiseVelocity = 4
			smoke.Size = 2
			smoke.Parent = t.YawPart
		end
	end
	def.GateBreached = true
	def.GateHealth = 0
	def.GateRebuildAt = nil
	def.GateOpen = false
	for _, p in ipairs(def.GateBarriers) do
		if p and p.Parent then
			p.CanCollide = false
			p.CanQuery = false -- blown away: shots pass through
			p.Transparency = 1
			p:SetAttribute("GateHealth", 0)
			p:SetAttribute("GateBreached", true)
			p:SetAttribute("GateOpen", false)
			p:SetAttribute("DefensesDown", true)
			local prompt = p:FindFirstChild("GateRepairPrompt")
			if prompt and prompt:IsA("ProximityPrompt") then
				prompt.Enabled = false
			end
		end
	end
	if def.Folder.Parent and not def.Folder:FindFirstChild("StrikeRubble") then
		for i, o in ipairs(RUBBLE) do
			local size = o[3]
			local r = Instance.new("Part")
			r.Name = "StrikeRubble"
			r.Size = Vector3.new(size, size * 0.55, size * 0.8)
			r.CFrame = def.GateCf * CFrame.new(o[1], -3 + size * 0.25, o[2]) * CFrame.Angles(0.25 * i, 0.9 * i, 0.15 * i)
			r.Anchored = true
			r.CanCollide = false
			r.CanQuery = false
			r.CanTouch = false
			r.Color = Color3.fromRGB(38, 34, 30)
			r.Material = Enum.Material.Slate
			r.Parent = def.Folder
			if i == 1 then
				local fire = Instance.new("Fire")
				fire.Name = "WE_StrikeFire"
				fire.Size = 5
				fire.Heat = 6
				fire.Parent = r
			end
		end
	end
	updateDownBillboard(def)
end

--[[ Missile strike hit (MissileStrikeService is the only caller). untilUnix is os.time. False when this plot has no
	defense built yet — syncPlotNow applies the down state from profile.Raid.DefensesDownUntil when it builds. ]]
function GateDefenseService.SetDefensesDown(plotId: number, untilUnix: number): boolean
	if typeof(plotId) ~= "number" or typeof(untilUnix) ~= "number" or untilUnix ~= untilUnix then
		return false
	end
	local def = defenses[plotId]
	if not def or untilUnix <= os.time() then
		return false
	end
	applyDefensesDown(def, untilUnix, true)
	return true
end

function GateDefenseService.IsDefensesDown(plotId: number): (boolean, number)
	local def = defenses[plotId]
	if def and def.DownUntil ~= nil then
		local left = (def.DownUntil :: number) - os.time()
		if left > 0 then
			return true, left
		end
	end
	return false, 0
end

function GateDefenseService.HasDefenses(plotId: number): boolean
	return defenses[plotId] ~= nil
end

function GateDefenseService.GetGateCFrame(plotId: number): CFrame?
	local def = defenses[plotId]
	return if def then def.GateCf else nil
end

respawnGuard = function(plotId: number, slot: number, ownerUserId: number, def: PlotDefense, dead: GuardUnit)
	if defenses[plotId] ~= def or def.OwnerUserId ~= ownerUserId or isDown(def) or syncBusy[plotId] then
		return
	end
	local idx = table.find(def.Guards, dead)
	local stats = GateDefenseConfig.GetLevelStats(def.WallsLevel)
	if not idx or not stats or not def.Folder.Parent then
		return
	end
	local g = spawnGuardModel(ownerUserId, slot, dead.PostCf, stats, def.Folder, plotId)
	-- the spawn can yield (catalog visual): drop it if the plot was rebuilt / struck meanwhile
	if defenses[plotId] ~= def or isDown(def) or def.Guards[idx] ~= dead or not def.Folder.Parent then
		g.Alive = false
		if g.Model.Parent then
			g.Model:Destroy()
		end
		return
	end
	def.Guards[idx] = g
end

-- Owner's DefensiveWalls level from the loaded profile (0 when offline / not loaded)
local function ownerWallsLevel(ownerUserId: number): number
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if owner and DataService then
		local profile = DataService.GetProfile(owner)
		if profile and profile.BaseUpgrades then
			return tonumber(profile.BaseUpgrades.DefensiveWalls) or 0
		end
	end
	return 0
end

-- Owner's strike timer (profile.Raid.DefensesDownUntil, os.time) when it is still running, else nil
local function ownerDownUntil(ownerUserId: number): number?
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not (owner and DataService) then
		return nil
	end
	local profile = DataService.GetProfile(owner)
	local raid = profile and (profile :: any).Raid
	local du = if typeof(raid) == "table" then tonumber(raid.DefensesDownUntil) else nil
	if du and du > os.time() then
		return du
	end
	return nil
end

-- Plot pad (WE_BasePlot) centre + half-size minus a margin: "inside the walls" for engage / chase limits
local function findPadBounds(plotId: number, plotFolder: Folder): (Vector3?, number)
	local pad: BasePart? = nil
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			pad = inst
			break
		end
	end
	if not pad then
		local p = plotFolder:FindFirstChild("PlotPad")
		if p and p:IsA("BasePart") then
			pad = p
		end
	end
	if not pad then
		return nil, 0
	end
	return pad.Position, math.max(pad.Size.X, pad.Size.Z) * 0.5 - 2
end

local function syncPlotNow(plotId: number)
	if not GateDefenseConfig.Enabled then
		clearDefense(plotId)
		return
	end
	local ownerUserId = if BaseService and BaseService.GetOwnerUserId then BaseService.GetOwnerUserId(plotId) else nil
	if not ownerUserId then
		clearDefense(plotId)
		return
	end
	local wallsLevel = ownerWallsLevel(ownerUserId)
	local stats = GateDefenseConfig.GetLevelStats(wallsLevel)
	if not stats then
		clearDefense(plotId)
		return
	end

	local plotFolder = findPlotFolder(plotId)
	if not plotFolder then
		return
	end
	local posts = gatherGatePosts(plotFolder)
	local gateCf = computeGateCFrame(plotFolder, posts)
	if not gateCf then
		-- Walls folder may lag a frame after perimeter wall sync
		return
	end

	clearDefense(plotId)
	local folder = ensureDefenseFolder(plotFolder)
	folder:SetAttribute("PlotId", plotId)
	folder:SetAttribute("OwnerUserId", ownerUserId)
	folder:SetAttribute("WallsLevel", wallsLevel)

	-- v69 F7: a strike still running (rejoin / server hop / walls upgrade / plot-ready) → build it down
	local downUntil = ownerDownUntil(ownerUserId)

	-- v69 F2: posts INSIDE the gate. gateCf looks toward PlayerSpawn, so local -Z is inside (it used to be +Z:
	-- outside the wall, AutoGuns embedded in it at L4-5, no line of sight to the ATM).
	local flankX = GateDefenseConfig.GuardFlankX or 6
	local guardInside = RaidConfig.Defense.GuardPostInsideStuds
	local guards: { GuardUnit } = {}
	if downUntil == nil then
		for slot, sx in ipairs({ -flankX, flankX }) do
			local at = gateCf * CFrame.new(sx, 0, -guardInside)
			local g = spawnGuardModel(ownerUserId, slot, at, stats, folder, plotId)
			g.Model:SetAttribute("OwnerUserId", ownerUserId)
			table.insert(guards, g)
		end
	end

	local turrets: { TurretUnit } = {}
	local useTurrets = stats.UseTurrets == true and wallsLevel >= (GateDefenseConfig.AutoGunMinWallsLevel or 4)
	if useTurrets then
		local gx = GateDefenseConfig.AutoGunFlankX or 7
		local gunInside = RaidConfig.Defense.AutoGunInsideStuds
		local yawDeg = GateDefenseConfig.AutoGunYawDeg or 15
		for slot, sx in ipairs({ -gx, gx }) do
			local yaw = if sx < 0 then yawDeg else -yawDeg
			-- idle facing the gate (outward), toed in toward the gate centre; thinkTurret re-aims at targets
			local at = gateCf * CFrame.new(sx, 0, -gunInside) * CFrame.Angles(0, math.pi + math.rad(yaw), 0)
			local t = spawnAutoGun(slot, at, folder)
			if t then
				t.Model:SetAttribute("OwnerUserId", ownerUserId)
				t.Model:SetAttribute("PlotId", plotId)
				table.insert(turrets, t)
			end
		end
	end

	-- v69: owner left / plot changed hands while the spawns above yielded → drop this build
	local ownerNow = if BaseService and BaseService.GetOwnerUserId then BaseService.GetOwnerUserId(plotId) else nil
	if ownerNow ~= ownerUserId or folder.Parent == nil then
		for _, g in ipairs(guards) do
			g.Alive = false
		end
		if folder.Parent then
			folder:Destroy()
		end
		return
	end

	local barriers, maxHp = spawnGateBarriers(gateCf, wallsLevel, folder, plotId, ownerUserId)
	for _, leaf in ipairs(barriers) do
		local prompt = leaf:FindFirstChild("GateRepairPrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Triggered:Connect(function(who: Player)
				GateDefenseService.TryRepair(who, plotId)
			end)
		end
	end

	local padCenter, padHalf = findPadBounds(plotId, plotFolder)
	local def: PlotDefense = {
		PlotId = plotId,
		OwnerUserId = ownerUserId,
		WallsLevel = wallsLevel,
		Folder = folder,
		Guards = guards,
		Turrets = turrets,
		GateCf = gateCf,
		CollectorPos = findCollectorPos(plotId),
		CollectorModel = findCollectorModel(plotId),
		GateHealth = maxHp,
		GateMaxHealth = maxHp,
		GateBreached = false,
		GateBarriers = barriers,
		GateRebuildAt = nil,
		LastRegenAt = os.clock(),
		DownUntil = nil,
		LastDownLabelAt = 0,
		GateOpen = false,
		GateAllyAt = 0,
		PadCenter = padCenter,
		PadHalf = padHalf,
	}
	defenses[plotId] = def
	-- re-read: a strike that landed while the spawns above yielded found no def (SetDefensesDown → false)
	local downNow = ownerDownUntil(ownerUserId)
	if downNow ~= nil then
		applyDefensesDown(def, downNow, downUntil == nil)
	end

	if RunService:IsStudio() then
		print(string.format(
			"[GateDefense] plot=%d walls=%d guards=%d turrets=%d tier=%s",
			plotId,
			wallsLevel,
			#guards,
			#turrets,
			tostring(stats.DesignTier)
		))
	end
end

function GateDefenseService.SyncPlot(plotId: number)
	if syncBusy[plotId] then
		syncAgain[plotId] = true -- coalesce: re-run once the running sync ends (picks up the latest level)
		return
	end
	syncBusy[plotId] = true
	repeat
		syncAgain[plotId] = nil
		xpcall(syncPlotNow, function(err)
			warn("[GateDefense] SyncPlot failed plot=", plotId, err)
		end, plotId)
	until not syncAgain[plotId]
	syncBusy[plotId] = nil
end

--[[ v69: idempotent — syncs only when the plot's defense does not match its owner + current walls level
	(missing, other owner, level changed, or folder lost to a map rebuild). Safe to call on every plot-ready. ]]
function GateDefenseService.EnsurePlot(plotId: number)
	if not GateDefenseConfig.Enabled then
		return
	end
	local ownerUserId = if BaseService and BaseService.GetOwnerUserId then BaseService.GetOwnerUserId(plotId) else nil
	local def = defenses[plotId]
	if ownerUserId == nil then
		if def then
			GateDefenseService.SyncPlot(plotId)
		end
		return
	end
	local wallsLevel = ownerWallsLevel(ownerUserId)
	local wantDefense = GateDefenseConfig.GetLevelStats(wallsLevel) ~= nil
	local inSync = if wantDefense
		then def ~= nil
			and def.OwnerUserId == ownerUserId
			and def.WallsLevel == wallsLevel
			and def.Folder.Parent ~= nil
		else def == nil
	if not inSync then
		GateDefenseService.SyncPlot(plotId)
	end
end

function GateDefenseService.ClearPlot(plotId: number)
	clearDefense(plotId)
end

local function thinkGuard(def: PlotDefense, g: GuardUnit, stats: any, tnow: number)
	if not g.Alive or g.Humanoid.Health <= 0 or not g.Root.Parent then
		return
	end
	local aggro = stats.AggroRange or GateDefenseConfig.DefaultAggroRange or 95
	local range = stats.ShootRange or 70
	local plr, hum, troot, dist = nearestEnemy(def, g.Root.Position, aggro, nil)
	if plr and hum and troot then
		faceYaw(g.Root, troot.Position)
		local ignore: { Instance } = { g.Model, def.Folder, (plr.Character :: any) :: Instance }
		if def.CollectorModel then
			table.insert(ignore, def.CollectorModel :: Instance)
		end
		if dist > range * 0.85 then
			g.Humanoid:MoveTo(clampInsidePlot(def, troot.Position))
		else
			g.Humanoid:MoveTo(g.Root.Position)
			local interval = 1 / math.max(stats.GuardFireRate or 1.4, 0.1)
			if tnow - g.LastFireAt >= interval and dist <= range then
				if hasLos(g.Root.Position, troot.Position, ignore) then
					g.LastFireAt = tnow
					dealDamage(plr, hum, (stats.GuardDamage or 14) * researchMult(def.OwnerUserId), g.Model, def.PlotId)
				end
			end
		end
		return
	end

	-- Patrol near own post, along the gate line (v69: inside the gate)
	local half = GateDefenseConfig.PatrolHalfSpanStuds or 6
	local idle = GateDefenseConfig.PatrolIdleSeconds or 1.4
	local postZ = -RaidConfig.Defense.GuardPostInsideStuds
	local flankX = GateDefenseConfig.GuardFlankX or 6
	local sx = if g.Slot == 1 then -flankX else flankX
	local toward = if g.Slot == 1 then half * 0.5 else -half * 0.5
	local waypoints = {
		(def.GateCf * CFrame.new(sx, 0, postZ)).Position,
		(def.GateCf * CFrame.new(sx + toward, 0, postZ)).Position,
	}
	if tnow < g.IdleUntil then
		g.Humanoid:MoveTo(g.Root.Position)
		return
	end
	local idx = ((g.WaypointIndex - 1) % #waypoints) + 1
	local dest = waypoints[idx]
	local d = (g.Root.Position - dest).Magnitude
	if d < (GateDefenseConfig.PatrolReachStuds or 2) then
		g.WaypointIndex = idx + 1
		g.IdleUntil = tnow + idle
		g.Humanoid:MoveTo(g.Root.Position)
	else
		g.Humanoid:MoveTo(dest)
		faceYaw(g.Root, dest)
	end
end

local function thinkTurret(def: PlotDefense, t: TurretUnit, stats: any, tnow: number)
	if t.Offline or not t.Model.Parent or not t.YawPart.Parent then
		return
	end
	local aggro = stats.TurretRange or 100
	local fromPos = t.YawPart.Position
	local plr, hum, troot, dist = nearestEnemy(def, fromPos, aggro, aggro)
	if not (plr and hum and troot) then
		return
	end
	local flat = Vector3.new(troot.Position.X, t.YawPart.Position.Y, troot.Position.Z)
	if (flat - t.YawPart.Position).Magnitude > 0.05 then
		local look = CFrame.lookAt(t.YawPart.Position, flat)
		-- Rotate whole model toward target when PrimaryPart is yaw
		if t.Model.PrimaryPart then
			local offset = t.Model.PrimaryPart.CFrame:ToObjectSpace(t.YawPart.CFrame)
			t.Model:PivotTo(look * offset:Inverse())
		else
			t.YawPart.CFrame = look
		end
	end
	local interval = 1 / math.max(stats.TurretFireRate or 6, 0.1)
	if tnow - t.LastFireAt >= interval and dist <= aggro then
		local ignore: { Instance } = { t.Model, def.Folder, (plr.Character :: any) :: Instance }
		if def.CollectorModel then
			table.insert(ignore, def.CollectorModel :: Instance)
		end
		if hasLos(fromPos, troot.Position, ignore) then
			t.LastFireAt = tnow
			dealDamage(plr, hum, (stats.TurretDamage or 22) * researchMult(def.OwnerUserId), t.Model, def.PlotId)
		end
	end
end

function GateDefenseService.Init(deps: { [string]: any })
	BaseService = deps.BaseService
	DataService = deps.DataService
	VisualAssetService = deps.VisualAssetService
	ClanService = deps.ClanService
	ResearchService = deps.ResearchService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService

	if not GateDefenseConfig.Enabled then
		return
	end

	-- Sync on walls upgrade
	if BaseService and BaseService.GetUpgradeChangedEvent then
		BaseService.GetUpgradeChangedEvent().Event:Connect(function(_userId: number, plotId: number?, structureId: string?, _level: number?)
			if structureId == "DefensiveWalls" and typeof(plotId) == "number" then
				task.defer(function()
					task.wait(0.15) -- allow perimeter wall sync to rebuild GatePosts
					GateDefenseService.SyncPlot(plotId :: number)
				end)
			end
		end)
	end

	-- v69: spawn from the LOADED save whenever the owner's plot is (re)built — join (DataService v67 fires
	-- OnProfileLoaded only after the real save is read; BaseService then builds the walls/GatePosts and fires
	-- OnPlotReady), a freed plot handed out, prestige, map rebuild. Replaces the fixed 1.2 s / 3.5 s timers,
	-- which missed any save/walls that landed later and then never re-synced for the whole session.
	local hookedPlotReady = false
	if BaseService and BaseService.OnPlotReady then
		local okHook, errHook = pcall(BaseService.OnPlotReady, function(_player: Player, plotId: number)
			GateDefenseService.EnsurePlot(plotId)
		end)
		hookedPlotReady = okHook
		if not okHook then
			warn("[GateDefense] OnPlotReady hook failed:", errHook)
		end
	end
	-- Spawn grace clock: every character spawn, and the save load (the move to the player's own plot follows it)
	local function hookGrace(player: Player)
		player.CharacterAdded:Connect(function()
			startSpawnGrace(player)
		end)
		if player.Character then
			startSpawnGrace(player)
		end
	end
	Players.PlayerAdded:Connect(hookGrace)
	for _, player in ipairs(Players:GetPlayers()) do
		hookGrace(player)
	end

	if DataService and DataService.OnProfileLoaded then
		-- Belt: late ensure for the loaded owner's plot (no-op when already in sync); sole path if the hook failed
		DataService.OnProfileLoaded(function(player: Player, _profile: any)
			startSpawnGrace(player)
			for _, delaySec in ipairs(if hookedPlotReady then { 10 } else { 1.2, 3.5, 10 }) do
				task.delay(delaySec, function()
					local plotId = if player.Parent and BaseService and BaseService.GetOwnedPlotId
						then BaseService.GetOwnedPlotId(player)
						else nil
					if typeof(plotId) == "number" then
						GateDefenseService.EnsurePlot(plotId)
					end
				end)
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		if BaseService and BaseService.GetOwnerUserId then
			-- Clear any plot this owner held
			for plotId, def in pairs(defenses) do
				if def.OwnerUserId == player.UserId then
					clearDefense(plotId)
				end
			end
		end
		victimHitAt[player.UserId] = nil
		graceFrom[player.UserId] = nil
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		accum = 0
		local tnow = nowClock()
		local nowUnix = os.time()
		local restore: { number } = {}
		for plotId, def in pairs(defenses) do
			if def.DownUntil ~= nil then
				-- v69 F7: struck — no guards, AutoGuns offline, gate blown; count down, then rebuild fresh
				if nowUnix >= (def.DownUntil :: number) then
					table.insert(restore, plotId)
				elseif tnow - def.LastDownLabelAt >= 1 then
					def.LastDownLabelAt = tnow
					updateDownBillboard(def)
				end
				continue
			end
			local stats = GateDefenseConfig.GetLevelStats(def.WallsLevel)
			if stats then
				if not def.CollectorPos then
					def.CollectorPos = findCollectorPos(plotId)
				end
				if def.CollectorModel == nil or (def.CollectorModel :: Instance).Parent == nil then
					def.CollectorModel = findCollectorModel(plotId)
				end
				for _, g in ipairs(def.Guards) do
					thinkGuard(def, g, stats, tnow)
				end
				for _, tur in ipairs(def.Turrets) do
					thinkTurret(def, tur, stats, tnow)
				end
				-- Gate regen / auto-rebuild (guards keep shooting either way)
				if def.GateBreached then
					if def.GateRebuildAt and tnow >= def.GateRebuildAt then
						rebuildGate(def)
					end
				elseif def.GateHealth < def.GateMaxHealth then
					local regen = GateDefenseConfig.GateRegenPerSecond or 0
					if regen > 0 then
						local dtRegen = tnow - (def.LastRegenAt or tnow)
						def.LastRegenAt = tnow
						def.GateHealth = math.min(def.GateMaxHealth, def.GateHealth + regen * dtRegen)
						for _, bp in ipairs(def.GateBarriers) do
							if bp and bp.Parent then
								bp:SetAttribute("GateHealth", def.GateHealth)
							end
						end
						updateGateBillboard(def.GateBarriers, def.GateHealth, def.GateMaxHealth, false)
					end
				end
				-- v69 F5: the gate lets the owner and clan-mates through
				updateFriendlyGate(def, tnow)
				-- v71: the gate bar also shows while an ATM raid runs on this plot (≈1 Hz; writes only on change)
				if tnow - (barCheckAt[plotId] or 0) >= 1 then
					barCheckAt[plotId] = tnow
					updateGateBillboard(def.GateBarriers, def.GateHealth, def.GateMaxHealth, def.GateBreached)
				end
			end
		end
		-- (outside the pairs loop: SyncPlot replaces defenses[plotId] and can yield)
		for _, plotId in ipairs(restore) do
			local def = defenses[plotId]
			if def then
				def.DownUntil = nil
				local ownerUserId = def.OwnerUserId
				task.spawn(function()
					GateDefenseService.SyncPlot(plotId)
					local owner = Players:GetPlayerByUserId(ownerUserId)
					if owner and NotificationService then
						NotificationService.Notify(owner, RaidConfig.Text.DefensesBack, "Success")
					end
				end)
			end
		end
	end)

	print("[WAR EMPIRE] GateDefenseService ready (walls≥1 → GateGuards + siegeable GateBarrier HP; walls≥4 → AutoGun nests; allies = clan)")
end

return GateDefenseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">ManualDropperService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Early-game manual cash droppers at each plot (Money Collector + Training Yard).
	ClickDetector / ProximityPrompt → AccruePendingCash. Server cooldown + rate limit.

	v71 (HUD v70 spec §5): the "$15" tag and the "+$15" pop are Shared/Util/WorldLabel labels owned by the plot's
	owner (the client filter hides them for everyone else), stud-scaled, never AlwaysOnTop. The plate keeps its
	glow but no PointLight (light budget).

	streaming2 lane C1 (F5): while Workspace.StreamingEnabled is on, the owner's plate position is stamped on the
	Player as WE_DropperPos (the ATM-side plate, else the Training Yard one), like UpgradePadService's
	WE_ConsolePos_<sid> and BusinessService's WE_AtmPos, so the tutorial beam has an end while the plate is streamed
	out on that client. Stamped on plot ready and kept right by the 2 s owner sync (hand-outs, late claims, release,
	rebuilt plates). Streaming off: no hook, no attribute (HEAD behaviour).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ManualDropperConfig = require(Shared.Configs.ManualDropperConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

local ManualDropperService = {}

local DataService: any = nil
local EconomyService: any = nil
local RateLimitService: any = nil
local VisualAssetService: any = nil
local TutorialService: any = nil
local NotificationService: any = nil
local BaseService: any = nil

local TAG_COLLECTOR = Constants.Tags.MoneyCollector
local TAG_DROPPER = "WE_ManualDropper"

-- owner-only tag on a plate nobody owns yet: a UserId no player has (the client filter hides it for everyone)
local NOBODY = -1

local lastAwardAt: { [string]: number } = {}
local wired: { [BasePart]: boolean } = {}

-- v69: per-player award budget (minute + hour refilling buckets). Kept for an hour after leaving so a
-- same-server rejoin does not reset it.
type Budget = { minute: number, hour: number, at: number }
local budgets: { [number]: Budget } = {}

local function budgetLimits(): (number, number)
	local perMinute = math.max(1, math.floor(tonumber(ManualDropperConfig.MaxAwardsPerMinute) or 30))
	local perHour = math.max(perMinute, math.floor(tonumber(ManualDropperConfig.MaxAwardsPerHour) or 600))
	return perMinute, perHour
end

-- Consumes one award from the player's budget; false when either bucket is empty.
local function takeBudget(userId: number, now: number): boolean
	local perMinute, perHour = budgetLimits()
	local b = budgets[userId]
	if not b then
		b = { minute = perMinute, hour = perHour, at = now }
		budgets[userId] = b
	end
	local dt = math.max(0, now - b.at)
	b.at = now
	b.minute = math.min(perMinute, b.minute + dt * perMinute / 60)
	b.hour = math.min(perHour, b.hour + dt * perHour / 3600)
	if b.minute < 1 or b.hour < 1 then
		return false
	end
	b.minute -= 1
	b.hour -= 1
	return true
end

local function pickAward(): number
	local fixed = ManualDropperConfig.AwardAmount
	if typeof(fixed) == "number" and fixed > 0 then
		return math.floor(fixed)
	end
	local lo = math.floor(ManualDropperConfig.MinAward or 10)
	local hi = math.floor(ManualDropperConfig.MaxAward or 25)
	if hi < lo then
		hi = lo
	end
	return math.random(lo, hi)
end

local function cooldownKey(player: Player, dropper: BasePart): string
	return tostring(player.UserId) .. "|" .. dropper:GetFullName()
end

local function ownsPlot(player: Player, plotId: any): boolean
	if typeof(plotId) ~= "number" then
		return false
	end
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return false
	end
	return profile.BasePlotId == plotId
end

-- "+$15" rising from the plate — only the player who grabbed it sees it (owner-only WorldLabel)
local function spawnFloatingCash(dropper: BasePart, amount: number, ownerUserId: number)
	local top = dropper.Size.Y * 0.5
	local bb = WorldLabel.Create(dropper, string.format("+$%d", amount), {
		Name = "CashPop",
		Color = Color3.fromRGB(80, 255, 120),
		TextSize = 20,
		Studs = Vector2.new(3, 1.2),
		Offset = Vector3.new(0, top + 1.2, 0),
		MaxDistance = 30,
		OwnerUserId = ownerUserId,
	})
	local label = bb:FindFirstChild("Title")
	if label and label:IsA("TextLabel") then
		-- Competitor-style $ pop: dark green glow outline (replaces the ink text stroke on this label)
		local glow = Instance.new("UIStroke")
		glow.Name = "CashPopGlow"
		glow.Color = Color3.fromRGB(8, 36, 14)
		glow.Thickness = 1.4
		glow.Parent = label
	end

	local rise = ManualDropperConfig.PopupRiseStuds or 3.2
	local dur = ManualDropperConfig.PopupDuration or 0.55
	task.spawn(function()
		local steps = 6
		for i = 1, steps do
			if not bb.Parent then
				return
			end
			local t = i / steps
			bb.StudsOffsetWorldSpace = Vector3.new(0, top + 1.2 + rise * t, 0)
			if label and label:IsA("TextLabel") then
				label.TextTransparency = t * 0.85
			end
			task.wait(dur / steps)
		end
		bb:Destroy()
	end)

	pcall(function()
		if VisualAssetService and VisualAssetService.PlayMoneyBagFX then
			VisualAssetService.PlayMoneyBagFX(dropper.Position + Vector3.new(0, 1.5, 0), dropper.Parent or dropper)
		end
	end)
end

local function tryAward(player: Player, dropper: BasePart)
	if not ManualDropperConfig.Enabled then
		return
	end
	if not player or not player.Parent then
		return
	end
	local plotId = dropper:GetAttribute("PlotId")
	if not ownsPlot(player, plotId) then
		return
	end

	local key = cooldownKey(player, dropper)
	local now = os.clock()
	local cd = ManualDropperConfig.CooldownSeconds or 0.35
	local last = lastAwardAt[key]
	if last and (now - last) < cd then
		return
	end

	if RateLimitService and RateLimitService.Allow then
		local rate = ManualDropperConfig.RateLimitRate or 4
		local burst = ManualDropperConfig.RateLimitBurst or 3
		if not RateLimitService.Allow(player, "manual_dropper", rate, burst) then
			return
		end
	end

	if not EconomyService or not EconomyService.AccruePendingCash then
		return
	end
	lastAwardAt[key] = now
	if not takeBudget(player.UserId, now) then
		if NotificationService and NotificationService.NotifyThrottled then
			NotificationService.NotifyThrottled(
				player,
				ManualDropperConfig.BudgetEmptyToast or "Cash drop is recharging",
				"Info",
				3,
				ManualDropperConfig.BudgetEmptyToastCooldown or 20,
				"manual_dropper_budget"
			)
		end
		return
	end
	local amount = pickAward()
	local ok = EconomyService.AccruePendingCash(player, amount, "manual_dropper")
	if ok then
		spawnFloatingCash(dropper, amount, player.UserId)
		if TutorialService and TutorialService.Notify then
			TutorialService.Notify(player, "ManualDrop")
		end
	end
end

local function buildDropperKit(parent: Instance, name: string, worldPos: Vector3, plotId: number): BasePart
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BasePart") then
		existing:SetAttribute("PlotId", plotId)
		return existing
	end

	local size = ManualDropperConfig.PartSize or Vector3.new(2.4, 1.2, 2.4)
	local pad = Instance.new("Part")
	pad.Name = name
	pad.Size = size
	pad.Anchored = true
	pad.CanCollide = true
	pad.CanTouch = false
	pad.Material = Enum.Material.SmoothPlastic
	pad.Color = ManualDropperConfig.PartColor or Color3.fromRGB(40, 140, 70)
	pad.CFrame = CFrame.new(worldPos + Vector3.new(0, size.Y * 0.5 + 0.15, 0))
	pad:SetAttribute("PlotId", plotId)
	pad:SetAttribute("WE_ManualDropper", true)
	pad.Parent = parent
	CollectionService:AddTag(pad, TAG_DROPPER)

	local neon = Instance.new("Part")
	neon.Name = "DropNeon"
	neon.Size = Vector3.new(size.X * 0.7, 0.2, size.Z * 0.7)
	neon.Anchored = true
	neon.CanCollide = false
	neon.Material = Enum.Material.Neon
	neon.Color = ManualDropperConfig.NeonAccentColor or Color3.fromRGB(90, 255, 120)
	neon.CFrame = pad.CFrame * CFrame.new(0, size.Y * 0.5 + 0.05, 0)
	neon.Parent = pad

	-- v71: no PointLight (the neon plate is the glow; light budget) and an owner-only "$15" tag
	local shown = ManualDropperConfig.AwardAmount or ManualDropperConfig.MinAward or 10
	WorldLabel.Create(pad, (ManualDropperConfig.BillboardLabel or "$") .. tostring(shown), {
		Name = "WE_DropperLabel",
		Color = Color3.fromRGB(100, 255, 140),
		Studs = ManualDropperConfig.LabelStuds,
		MaxDistance = ManualDropperConfig.LabelMaxDistance,
		OwnerUserId = NOBODY, -- syncTagOwners hands it to the plot owner (≤ 2 s)
	})

	local click = Instance.new("ClickDetector")
	click.Name = "DropClick"
	click.MaxActivationDistance = ManualDropperConfig.PromptMaxDistance or 12
	click.Parent = pad

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DropPrompt"
	prompt.ActionText = ManualDropperConfig.PromptActionText or "Grab Cash"
	prompt.ObjectText = ManualDropperConfig.PromptObjectText or "Cash Drop"
	prompt.HoldDuration = ManualDropperConfig.PromptHoldDuration or 0
	prompt.MaxActivationDistance = ManualDropperConfig.PromptMaxDistance or 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad

	return pad
end

-- Older server builds left a PointLight and a carded price tag on the plate: strip / rebuild them once.
local function upgradeLegacyKit(pad: BasePart)
	local light = pad:FindFirstChildOfClass("PointLight")
	if light then
		light:Destroy()
	end
	local tag = pad:FindFirstChild("WE_DropperLabel")
	if tag and not tag:FindFirstChild("Title") then
		tag:Destroy()
		local shown = ManualDropperConfig.AwardAmount or ManualDropperConfig.MinAward or 10
		WorldLabel.Create(pad, (ManualDropperConfig.BillboardLabel or "$") .. tostring(shown), {
			Name = "WE_DropperLabel",
			Color = Color3.fromRGB(100, 255, 140),
			Studs = ManualDropperConfig.LabelStuds,
			MaxDistance = ManualDropperConfig.LabelMaxDistance,
			OwnerUserId = NOBODY,
		})
	end
end

-- The tag belongs to the plot owner: follow plot hand-outs (join / leave / late claim). ≤ 12 plates, 0.5 Hz.
local function syncTagOwners()
	if not (BaseService and BaseService.GetOwnerUserId) then
		return
	end
	for pad in pairs(wired) do
		if pad.Parent then
			local tag = pad:FindFirstChild("WE_DropperLabel")
			local plotId = pad:GetAttribute("PlotId")
			if tag and tag:IsA("BillboardGui") and typeof(plotId) == "number" then
				local owner = BaseService.GetOwnerUserId(plotId)
				WorldLabel.SetOwner(tag, if typeof(owner) == "number" and owner ~= 0 then owner else NOBODY)
			end
		else
			wired[pad] = nil
		end
	end
end

-- C1 F5: the tutorial's dropper position (see the header). Only while streaming is on (a place setting).
local ATTR_DROPPER_POS = "WE_DropperPos"

local function streamingOn(): boolean
	return Workspace.StreamingEnabled == true
end

-- the plate the tutorial points at on a plot: the one beside the ATM, else the Training Yard one
local function dropperPosOf(plotId: number): Vector3?
	local best: BasePart? = nil
	for pad in pairs(wired) do
		if pad.Parent and pad:GetAttribute("PlotId") == plotId and (best == nil or pad.Name == "ManualDropper_Collector") then
			best = pad
		end
	end
	return if best then best.Position else nil
end

local function stampDropperPos(player: Player, plotId: number?)
	if player.Parent == nil or not streamingOn() then
		return
	end
	local pos = if plotId ~= nil then dropperPosOf(plotId) else nil
	if player:GetAttribute(ATTR_DROPPER_POS) ~= pos then
		player:SetAttribute(ATTR_DROPPER_POS, pos)
	end
end

-- every player's stamp follows the plot they own now (nil when they have none)
local function syncDropperStamps()
	if not (streamingOn() and BaseService and BaseService.GetOwnedPlotId) then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, plotId = pcall(BaseService.GetOwnedPlotId, player)
		stampDropperPos(player, if ok and typeof(plotId) == "number" then plotId else nil)
	end
end

local function wireDropper(pad: BasePart)
	if wired[pad] then
		return
	end
	wired[pad] = true
	upgradeLegacyKit(pad)

	local click = pad:FindFirstChild("DropClick")
	if click and click:IsA("ClickDetector") then
		click.MouseClick:Connect(function(player: Player)
			tryAward(player, pad)
		end)
	end
	local prompt = pad:FindFirstChild("DropPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Triggered:Connect(function(player: Player)
			tryAward(player, pad)
		end)
	end
end

local function groundYForPlot(plotFolder: Instance, fallbackY: number): number
	local plotPad = plotFolder:FindFirstChild("PlotPad")
	if plotPad and plotPad:IsA("BasePart") then
		return plotPad.Position.Y + plotPad.Size.Y * 0.5
	end
	return fallbackY
end

-- v70: the plot's rotation (PlotPad carries the plot yaw, BaseLayout.PlotCFrame); identity when there is no pad
local function rotOf(plotFolder: Instance?): CFrame
	local plotPad = plotFolder and plotFolder:FindFirstChild("PlotPad")
	if plotPad and plotPad:IsA("BasePart") then
		return plotPad.CFrame.Rotation
	end
	return CFrame.identity
end

-- v70: plot-local XZ offset turned with the plot, added to a world base point, at ground height gy
local function offsetPos(plotFolder: Instance?, base: Vector3, offset: Vector3, gy: number): Vector3
	local w = rotOf(plotFolder):VectorToWorldSpace(Vector3.new(offset.X, 0, offset.Z))
	return Vector3.new(base.X + w.X, gy, base.Z + w.Z)
end

local function ensureDropperNearCollector(collector: BasePart)
	local plotId = collector:GetAttribute("PlotId")
	if typeof(plotId) ~= "number" then
		return
	end
	local parent = collector.Parent or collector
	local offset = ManualDropperConfig.CollectorOffset or Vector3.new(-5.5, 0, 4)
	local gy = collector.Position.Y - collector.Size.Y * 0.5
	local plotFolder = parent.Parent
	if plotFolder then
		gy = groundYForPlot(plotFolder, gy)
	end
	local pos = offsetPos(plotFolder, collector.Position, offset, gy)
	local pad = buildDropperKit(parent, "ManualDropper_Collector", pos, plotId)
	wireDropper(pad)
end

local function ensureDropperNearYard(plotFolder: Instance, plotId: number)
	local yard = plotFolder:FindFirstChild("TrainingYard")
	if not yard then
		return
	end
	local anchor = yard:FindFirstChild("YardEarnAnchor")
		or yard:FindFirstChild("YardAnchor")
		or yard:FindFirstChildWhichIsA("BasePart", true)
	if not anchor or not anchor:IsA("BasePart") then
		return
	end
	local offset = ManualDropperConfig.YardOffset or Vector3.new(6, 0, -4)
	local gy = groundYForPlot(plotFolder, anchor.Position.Y - 6)
	local pos = offsetPos(plotFolder, anchor.Position, offset, gy)
	local pad = buildDropperKit(yard, "ManualDropper_Yard", pos, plotId)
	wireDropper(pad)
end

local function scanPlots()
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	if not setup then
		return
	end
	local bases = setup:FindFirstChild("Bases")
	if not bases then
		return
	end
	for _, plotFolder in ipairs(bases:GetChildren()) do
		if plotFolder:IsA("Folder") or plotFolder:IsA("Model") then
			local plotIdAttr = plotFolder:GetAttribute("PlotId")
			local plotId: number? = if typeof(plotIdAttr) == "number" then plotIdAttr else tonumber(string.match(plotFolder.Name, "%d+"))
			if typeof(plotId) == "number" then
				ensureDropperNearYard(plotFolder, plotId)
			end
		end
	end
end

function ManualDropperService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	RateLimitService = deps.RateLimitService
	VisualAssetService = deps.VisualAssetService
	TutorialService = deps.TutorialService
	NotificationService = deps.NotificationService
	BaseService = deps.BaseService

	if not ManualDropperConfig.Enabled then
		print("[WAR EMPIRE] ManualDropperService disabled by config")
		return
	end

	for _, inst in ipairs(CollectionService:GetTagged(TAG_COLLECTOR)) do
		if inst:IsA("BasePart") then
			ensureDropperNearCollector(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG_COLLECTOR):Connect(function(inst)
		if inst:IsA("BasePart") then
			task.defer(function()
				ensureDropperNearCollector(inst)
			end)
		end
	end)

	for _, inst in ipairs(CollectionService:GetTagged(TAG_DROPPER)) do
		if inst:IsA("BasePart") then
			wireDropper(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG_DROPPER):Connect(function(inst)
		if inst:IsA("BasePart") then
			wireDropper(inst)
		end
	end)

	scanPlots()
	task.spawn(function()
		for _ = 1, 15 do
			task.wait(1)
			scanPlots()
			for _, inst in ipairs(CollectionService:GetTagged(TAG_COLLECTOR)) do
				if inst:IsA("BasePart") then
					ensureDropperNearCollector(inst)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local userId = player.UserId
		local prefix = tostring(userId) .. "|"
		for key in pairs(lastAwardAt) do
			if string.sub(key, 1, #prefix) == prefix then
				lastAwardAt[key] = nil
			end
		end
		task.defer(syncTagOwners)
		-- Budget refills fully within an hour; drop it then unless the player came back.
		task.delay(3600, function()
			if not Players:GetPlayerByUserId(userId) then
				budgets[userId] = nil
			end
		end)
	end)

	-- C1 F5: the tutorial's dropper position on the owner (streaming only; see the header)
	if streamingOn() and BaseService and BaseService.OnPlotReady then
		BaseService.OnPlotReady(stampDropperPos)
	end

	task.spawn(function()
		while true do
			task.wait(2)
			syncTagOwners()
			syncDropperStamps()
		end
	end)

	print("[WAR EMPIRE] ManualDropperService ready (prompt / ClickDetector → PendingCash)")
end

return ManualDropperService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">MissileStrikeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v69 Command Center missile strikes (owner: "From command centre you should be able to direct missiles at
	players/bases when you have the upgrade to take down their defenses").

	Unlock ("the upgrade"): Command Center L3 + Missile Defense L1 (RaidConfig.Strike.Unlock).
	Launch: Missiles panel from the Missile Command terminal inside your own Command Center — the server checks the
	attacker's character is at their CC. $5,000, 10 min reload (profile.Raid.StrikeCooldownUntil, os.time).
	Flight: attacker's Missile Defense battery → target's main gate, 5–9 s (drawn by every client from one
	MissileStrikeFx packet). The target's Missile Defense may shoot it down (outcome rolled at launch).
	Hit: target's guards / AutoGuns / gate barrier go down for 120–180 s (profile.Raid.DefensesDownUntil →
	GateDefenseService.SetDefensesDown). Missiles never damage players.

	Remotes: RequestMissileStrike (client → server: { Action = "State" } | { Action = "Launch", TargetUserId }),
	MissileStrikeStateUpdate (server → client: MissileState), MissileStrikeFx (server → all clients: MissileFx).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local RaidConfig = require(Shared.Configs.RaidConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)
local GateDefenseConfig = require(Shared.Configs.GateDefenseConfig)
local ServerModules = script.Parent.Parent.Modules
local RemoteSetup = require(ServerModules.RemoteSetup)
local RemoteGuard = require(ServerModules.RemoteGuard)
local BaseLayout = require(ServerModules.BaseLayout)

local MissileStrikeService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local BaseService: any = nil
local GateDefenseService: any = nil
local AnalyticsService: any = nil
local CombatService: any = nil -- F6 novice shield: a launched strike ends it (deps.CombatService; pcall'd)

export type StrikeResult = {
	Kind: string, -- "Launched" | "Hit" | "Intercepted" | "Refunded" | "Refused"
	TargetName: string?,
	Reason: string?,
	Text: string,
	DownSeconds: number?,
	ImpactIn: number?,
}

type Strike = {
	Id: number,
	AttackerUserId: number,
	AttackerName: string,
	VictimUserId: number,
	VictimName: string,
	PlotId: number,
	LaunchUnix: number,
	LaunchClock: number,
	FlightSeconds: number,
	Outcome: string, -- "Hit" | "Intercepted"
	AttackerCC: number,
	Cost: number,
}

local strikes: { [number]: Strike } = {}
local inFlight: { [number]: Strike } = {} -- attackerUserId → strike
local incoming: { [number]: Strike } = {} -- victimUserId → strike
local nextStrikeId = 0

local rng = Random.new()
local function defaultRandom(): number
	return rng:NextNumber()
end
local randomFn: () -> number = defaultRandom

-- Plot-local sites (x, z in the BaseLayoutConfig frame); plot-local → world through BaseLayout (plots turn with
-- FaceMapCentre)
local function siteOffset(structureId: string, fallbackX: number, fallbackZ: number): Vector3
	local structures = (BaseLayoutConfig :: any).Structures
	local entry = structures and structures[structureId]
	local site = entry and entry.Site
	if site and typeof(site.X) == "number" and typeof(site.Z) == "number" then
		return Vector3.new(site.X, 0, site.Z)
	end
	return Vector3.new(fallbackX, 0, fallbackZ)
end
local CC_SITE = siteOffset("CommandCenter", 0, -38)
-- Missile Defense site; the battery is the launcher's local (0, -3) off it, ~8 studs above the pad
local BATTERY_SITE = siteOffset("MissileDefense", 132, -40)
local LAUNCH_MAX_DY = 30

-- ── helpers ────────────────────────────────────────────────────────────────

local function profileOf(player: Player): any
	if not DataService then
		return nil
	end
	return DataService.GetProfile(player)
end

local function isLoaded(player: Player): boolean
	if not DataService then
		return false
	end
	if DataService.IsLoaded then
		return DataService.IsLoaded(player) == true
	end
	return DataService.GetProfile(player) ~= nil
end

local function markDirty(player: Player)
	if DataService and DataService.MarkDirty then
		DataService.MarkDirty(player)
	end
end

local function levelOf(profile: any, structureId: string): number
	local ups = profile and profile.BaseUpgrades
	if typeof(ups) ~= "table" then
		return 0
	end
	return math.max(0, math.floor(tonumber(ups[structureId]) or 0))
end

local function raidNum(profile: any, key: string): number
	local raid = profile and profile.Raid
	if typeof(raid) ~= "table" then
		return 0
	end
	return tonumber(raid[key]) or 0
end

local function raidOf(profile: any): { [string]: any }
	local raid = profile.Raid
	if typeof(raid) ~= "table" then
		raid = { ShieldUntil = 0, StrikeCooldownUntil = 0, DefensesDownUntil = 0 }
		profile.Raid = raid
	end
	return raid
end

local function setAttr(player: Player, name: string, value: number)
	pcall(function()
		player:SetAttribute(name, if value > 0 then value else nil)
	end)
end

local function formatCash(n: number): string
	local s = string.format("%d", math.floor(math.abs(n)))
	local out = (string.reverse(s):gsub("(%d%d%d)", "%1,"))
	out = string.reverse(out)
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (if n < 0 then "-" else "") .. out
end

local function round1(x: number): number
	return math.floor(x * 10 + 0.5) / 10
end

local function ownedPlotOf(player: Player): number?
	if BaseService and BaseService.GetOwnedPlotId then
		local pid = BaseService.GetOwnedPlotId(player)
		if typeof(pid) == "number" then
			return pid
		end
	end
	return nil
end

local function plotPos(plotId: number): Vector3?
	local p = BaseConfig.PlotPositions[plotId]
	if typeof(p) == "Vector3" then
		return p
	end
	return nil
end

local function batteryPos(plotId: number): Vector3?
	local p = plotPos(plotId)
	return if p then BaseLayout.PlotPoint(p, BATTERY_SITE.X, BATTERY_SITE.Z - 3, 8.5) else nil
end

local function gatePos(plotId: number): Vector3?
	if GateDefenseService and GateDefenseService.GetGateCFrame then
		local cf = GateDefenseService.GetGateCFrame(plotId)
		if typeof(cf) == "CFrame" then
			return cf.Position
		end
	end
	local p = plotPos(plotId)
	if not p then
		return nil
	end
	return BaseLayout.PlotPoint(p, 0, BaseConfig.PlotSize.Z * 0.5 - 1.5, 3.5)
end

local function isUnlocked(profile: any): boolean
	local U = RaidConfig.Strike.Unlock
	return levelOf(profile, "CommandCenter") >= (U.CommandCenter or 3) and levelOf(profile, "MissileDefense") >= (U.MissileDefense or 1)
end

local function isAlly(ownerUserId: number, player: Player): boolean
	if player.UserId == ownerUserId then
		return true
	end
	if GateDefenseService and GateDefenseService.IsAlly then
		return GateDefenseService.IsAlly(ownerUserId, player) == true
	end
	return false
end

-- Same new-player rule as raids
local function newPlayerSecondsLeft(profile: any): number
	local R = RaidConfig.Raid
	if RunService:IsStudio() and not R.ProtectNewPlayersInStudio then
		return 0
	end
	local first = tonumber(profile.FirstJoinUnix) or 0
	if first <= 0 then
		return 0
	end
	return math.max(0, first + R.NewPlayerProtectionSeconds - os.time())
end

-- Server's own view of the character: within LaunchMaxDistanceFromCC (horizontal) of the player's own CC site
local function atCommandCenter(player: Player, plotId: number?): boolean
	if plotId == nil then
		return false
	end
	local p = plotPos(plotId)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not p or not (hrp and hrp:IsA("BasePart")) then
		return false
	end
	local d = hrp.Position - BaseLayout.PlotPoint(p, CC_SITE.X, CC_SITE.Z)
	return Vector3.new(d.X, 0, d.Z).Magnitude <= RaidConfig.Strike.LaunchMaxDistanceFromCC and math.abs(d.Y) <= LAUNCH_MAX_DY
end

local function reasonText(reason: string, secs: number?): string
	local tpl = RaidConfig.Text.StrikeReasons[reason]
	if not tpl then
		return reason
	end
	if string.find(tpl, "%s", 1, true) then
		if reason == "InsufficientCash" then
			return string.format(tpl, formatCash(RaidConfig.Strike.Cost))
		end
		return string.format(tpl, RaidConfig.FormatTime(secs or 0))
	end
	return tpl
end

local function structureName(structureId: string): string
	local def = (BaseConfig.Structures :: any)[structureId]
	return if def and typeof(def.DisplayName) == "string" then def.DisplayName else structureId
end

-- ── rules (spec §2.3; launch-only checks are in launch) ─────────────────────

function MissileStrikeService.CanStrike(attacker: Player, victim: Player): (boolean, string?, number?)
	local S = RaidConfig.Strike
	if not S.Enabled then
		return false, "Disabled"
	end
	local aProfile = profileOf(attacker)
	if not aProfile or not isLoaded(attacker) then
		return false, "Loading"
	end
	if ownedPlotOf(attacker) == nil then
		return false, "NoBase"
	end
	if not isUnlocked(aProfile) then
		return false, "Locked"
	end
	-- (InFlight before Cooldown: a launch always starts the reload, so the other order could never say "in the air")
	if inFlight[attacker.UserId] ~= nil then
		return false, "InFlight"
	end
	local nowUnix = os.time()
	local cd = raidNum(aProfile, "StrikeCooldownUntil")
	if nowUnix < cd then
		return false, "Cooldown", cd - nowUnix
	end
	if victim == attacker or victim.UserId == attacker.UserId then
		return false, "Self"
	end
	local vPlot = if victim.Parent ~= nil then ownedPlotOf(victim) else nil
	if vPlot == nil or Players:GetPlayerByUserId(victim.UserId) == nil then
		return false, "TargetOffline"
	end
	local vProfile = profileOf(victim)
	if not vProfile or not isLoaded(victim) then
		return false, "TargetLoading"
	end
	if isAlly(victim.UserId, attacker) then
		return false, "Ally"
	end
	local newLeft = newPlayerSecondsLeft(vProfile)
	if newLeft > 0 then
		return false, "NewPlayer", newLeft
	end
	local shield = raidNum(vProfile, "ShieldUntil")
	if nowUnix < shield then
		return false, "Shielded", shield - nowUnix
	end
	local downUntil = raidNum(vProfile, "DefensesDownUntil")
	if nowUnix < downUntil then
		return false, "AlreadyDown", downUntil - nowUnix
	end
	if downUntil > 0 and nowUnix < downUntil + S.PostDownImmunitySeconds then
		return false, "Recovering", downUntil + S.PostDownImmunitySeconds - nowUnix
	end
	if incoming[victim.UserId] ~= nil then
		return false, "Incoming"
	end
	if not (GateDefenseService and GateDefenseService.HasDefenses and GateDefenseService.HasDefenses(vPlot) == true) then
		return false, "NoDefenses"
	end
	return true, nil, nil
end

-- ── state for the panel ────────────────────────────────────────────────────

local function buildTarget(attacker: Player, aPlot: number?, aMD: number, victim: Player, vPlot: number, nowUnix: number): { [string]: any }
	local S = RaidConfig.Strike
	local vProfile = profileOf(victim)
	local walls = levelOf(vProfile, "DefensiveWalls")
	local vMD = levelOf(vProfile, "MissileDefense")
	local from: Vector3? = if aPlot ~= nil then batteryPos(aPlot) else nil
	if from == nil then
		local hrp = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			from = hrp.Position
		end
	end
	local to = gatePos(vPlot)
	local distance = if from and to then (to - from).Magnitude else 0
	local ok, reason, secs = MissileStrikeService.CanStrike(attacker, victim)
	local shield = raidNum(vProfile, "ShieldUntil")
	local down = raidNum(vProfile, "DefensesDownUntil")
	local reboot = if down > 0 and nowUnix >= down then math.max(0, down + S.PostDownImmunitySeconds - nowUnix) else 0
	return {
		UserId = victim.UserId,
		Name = victim.DisplayName,
		BaseName = victim.DisplayName .. "'s Base",
		PlotId = vPlot,
		Distance = math.floor(distance),
		FlightSeconds = round1(RaidConfig.FlightSeconds(distance)),
		WallsLevel = walls,
		HasAutoGuns = walls >= (GateDefenseConfig.AutoGunMinWallsLevel or 4),
		MissileDefenseLevel = vMD,
		-- rounded (0.55 − 0.20 is 0.35000000000000003 as a float)
		InterceptChance = math.floor(RaidConfig.InterceptChance(vMD, aMD) * 100 + 0.5) / 100,
		ShieldRemaining = math.max(0, shield - nowUnix),
		DefensesDownRemaining = math.max(0, down - nowUnix),
		RebootRemaining = reboot,
		Incoming = incoming[victim.UserId] ~= nil,
		CanStrike = ok,
		Reason = reason,
		ReasonText = if reason then reasonText(reason, secs) else nil,
	}
end

function MissileStrikeService.BuildState(player: Player, result: StrikeResult?): { [string]: any }
	local S = RaidConfig.Strike
	local nowUnix = os.time()
	local profile = profileOf(player)
	local cc = levelOf(profile, "CommandCenter")
	local md = levelOf(profile, "MissileDefense")
	local unlocked = profile ~= nil and isUnlocked(profile)
	local aPlot = ownedPlotOf(player)
	local cd = raidNum(profile, "StrikeCooldownUntil")
	local cash = 0
	if EconomyService and EconomyService.GetCash and profile then
		cash = math.floor(tonumber(EconomyService.GetCash(player)) or 0)
	end
	local fly = inFlight[player.UserId]
	local targets: { { [string]: any } } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.UserId ~= player.UserId then
			local vPlot = ownedPlotOf(other)
			if vPlot ~= nil then
				table.insert(targets, buildTarget(player, aPlot, md, other, vPlot, nowUnix))
			end
		end
	end
	table.sort(targets, function(a, b)
		return (a.Distance :: number) < (b.Distance :: number)
	end)
	return {
		ServerTime = nowUnix,
		Unlocked = unlocked,
		LockedText = if unlocked
			then nil
			else string.format(RaidConfig.Text.StrikeLocked, S.Unlock.CommandCenter, S.Unlock.MissileDefense),
		Requirements = {
			{ StructureId = "CommandCenter", DisplayName = structureName("CommandCenter"), Need = S.Unlock.CommandCenter, Have = cc },
			{ StructureId = "MissileDefense", DisplayName = structureName("MissileDefense"), Need = S.Unlock.MissileDefense, Have = md },
		},
		Cost = S.Cost,
		Cash = cash,
		CooldownRemaining = math.max(0, cd - nowUnix),
		CooldownTotal = S.CooldownSeconds,
		AtCommandCenter = atCommandCenter(player, aPlot),
		InFlight = if fly
			then {
				TargetUserId = fly.VictimUserId,
				TargetName = fly.VictimName,
				ImpactIn = round1(math.max(0, fly.LaunchClock + fly.FlightSeconds - os.clock())),
			}
			else nil,
		Targets = targets,
		Result = result,
	}
end

local function pushState(player: Player, result: StrikeResult?)
	if player.Parent == nil then
		return
	end
	local remote = RemoteSetup.Get(Constants.RemoteNames.MissileStrikeStateUpdate)
	if remote and remote:IsA("RemoteEvent") then
		(remote :: RemoteEvent):FireClient(player, MissileStrikeService.BuildState(player, result))
	end
end

-- ── resolution (spec §2.7) — synchronous ───────────────────────────────────

local function resolve(strikeId: number)
	local strike = strikes[strikeId]
	if not strike then
		return
	end
	strikes[strikeId] = nil
	if inFlight[strike.AttackerUserId] == strike then
		inFlight[strike.AttackerUserId] = nil
	end
	if incoming[strike.VictimUserId] == strike then
		incoming[strike.VictimUserId] = nil
	end
	local S = RaidConfig.Strike
	local T = RaidConfig.Text
	local attacker = Players:GetPlayerByUserId(strike.AttackerUserId)
	local aProfile = if attacker then profileOf(attacker) else nil
	local victim = Players:GetPlayerByUserId(strike.VictimUserId)
	local vProfile = if victim then profileOf(victim) else nil
	local ownerNow = if BaseService and BaseService.GetOwnerUserId then BaseService.GetOwnerUserId(strike.PlotId) else nil

	-- target gone (left / plot changed hands / save not loaded): refund 1:1 and reload now
	if not victim or not vProfile or not isLoaded(victim) or ownerNow ~= strike.VictimUserId then
		if attacker and aProfile and S.RefundIfTargetLeaves then
			if EconomyService and EconomyService.AddCash then
				EconomyService.AddCash(attacker, strike.Cost, "purchase_refund")
			end
			local aRaid = raidOf(aProfile)
			aRaid.StrikeCooldownUntil = os.time()
			markDirty(attacker)
			setAttr(attacker, "WE_StrikeCooldownUntil", aRaid.StrikeCooldownUntil)
			pushState(attacker, {
				Kind = "Refunded",
				TargetName = strike.VictimName,
				Text = string.format(T.StrikeRefunded, strike.VictimName),
			})
		end
		return
	end

	if strike.Outcome == "Intercepted" then
		if attacker and aProfile then
			local aRaid = raidOf(aProfile)
			aRaid.StrikeCooldownUntil = strike.LaunchUnix + S.InterceptedCooldownSeconds
			markDirty(attacker)
			setAttr(attacker, "WE_StrikeCooldownUntil", aRaid.StrikeCooldownUntil)
			pushState(attacker, {
				Kind = "Intercepted",
				TargetName = strike.VictimName,
				Text = string.format(T.StrikeIntercepted, strike.VictimName),
			})
		end
		if NotificationService then
			NotificationService.Notify(victim, string.format(T.StrikeVictimIntercepted, strike.AttackerName), "Success")
		end
		return
	end

	-- Hit: the target's defenses go down (applies even if they got shielded mid-flight — the shield blocks raids)
	local down = RaidConfig.DownSeconds(strike.AttackerCC)
	local untilUnix = os.time() + down
	local vRaid = raidOf(vProfile)
	vRaid.DefensesDownUntil = untilUnix
	markDirty(victim)
	setAttr(victim, "WE_DefensesDownUntil", untilUnix)
	if GateDefenseService and GateDefenseService.SetDefensesDown then
		local ok, err = pcall(GateDefenseService.SetDefensesDown, strike.PlotId, untilUnix)
		if not ok then
			warn("[MissileStrike] SetDefensesDown failed", strike.PlotId, err)
		end
	end
	local downText = RaidConfig.FormatTime(down)
	if NotificationService then
		NotificationService.Notify(victim, string.format(T.StrikeVictimHit, downText), "Warn", 6)
	end
	if attacker then
		local hitText = string.format(T.StrikeHit, strike.VictimName, downText)
		if NotificationService then
			NotificationService.Notify(attacker, hitText, "Reward", 6)
		end
		pushState(attacker, {
			Kind = "Hit",
			TargetName = strike.VictimName,
			Text = hitText,
			DownSeconds = down,
		})
	end
end

-- ── launch (spec §2.4–2.6) ─────────────────────────────────────────────────

local function launch(attacker: Player, targetUserId: number): (boolean, string?, number?, Strike?)
	local S = RaidConfig.Strike
	local victim = Players:GetPlayerByUserId(targetUserId)
	if not victim then
		return false, "TargetOffline", nil, nil
	end
	local ok, reason, secs = MissileStrikeService.CanStrike(attacker, victim)
	if not ok then
		return false, reason, secs, nil
	end
	local aPlot = ownedPlotOf(attacker)
	local vPlot = ownedPlotOf(victim)
	if aPlot == nil or vPlot == nil then
		return false, "TargetOffline", nil, nil
	end
	if not atCommandCenter(attacker, aPlot) then
		return false, "NotAtCommandCenter", nil, nil
	end
	if not (EconomyService and EconomyService.GetCash and EconomyService.SpendCash) then
		return false, "Disabled", nil, nil
	end
	if (tonumber(EconomyService.GetCash(attacker)) or 0) < S.Cost then
		return false, "InsufficientCash", nil, nil
	end
	local from = batteryPos(aPlot)
	local to = gatePos(vPlot)
	if not from or not to then
		return false, "TargetOffline", nil, nil
	end
	local aProfile = profileOf(attacker)
	local vProfile = profileOf(victim)
	local distance = (to - from).Magnitude
	local flight = RaidConfig.FlightSeconds(distance)
	local arc = RaidConfig.ArcHeight(distance)
	local aCC = levelOf(aProfile, "CommandCenter")
	local aMD = levelOf(aProfile, "MissileDefense")
	local vMD = levelOf(vProfile, "MissileDefense")
	local chance = RaidConfig.InterceptChance(vMD, aMD)
	local intercepted = randomFn() < chance
	local interceptT = if intercepted then S.InterceptAtMin + randomFn() * (S.InterceptAtMax - S.InterceptAtMin) else nil
	local launchTime = Workspace:GetServerTimeNow()

	-- pay last, then register in the same synchronous block
	local spent = EconomyService.SpendCash(attacker, S.Cost, "missile_strike")
	if not spent then
		return false, "InsufficientCash", nil, nil
	end
	nextStrikeId += 1
	local nowUnix = os.time()
	local strike: Strike = {
		Id = nextStrikeId,
		AttackerUserId = attacker.UserId,
		AttackerName = attacker.DisplayName,
		VictimUserId = victim.UserId,
		VictimName = victim.DisplayName,
		PlotId = vPlot,
		LaunchUnix = nowUnix,
		LaunchClock = os.clock(),
		FlightSeconds = flight,
		Outcome = if intercepted then "Intercepted" else "Hit",
		AttackerCC = aCC,
		Cost = S.Cost,
	}
	strikes[strike.Id] = strike
	inFlight[attacker.UserId] = strike
	incoming[victim.UserId] = strike
	local aRaid = raidOf(aProfile)
	aRaid.StrikeCooldownUntil = nowUnix + S.CooldownSeconds
	markDirty(attacker)
	setAttr(attacker, "WE_StrikeCooldownUntil", aRaid.StrikeCooldownUntil)

	local fx: { [string]: any } = {
		StrikeId = strike.Id,
		AttackerUserId = attacker.UserId,
		AttackerName = attacker.DisplayName,
		VictimUserId = victim.UserId,
		VictimName = victim.DisplayName,
		PlotId = vPlot,
		From = from,
		To = to,
		ArcHeight = arc,
		LaunchTime = launchTime,
		FlightSeconds = flight,
		Outcome = strike.Outcome,
	}
	if intercepted then
		fx.InterceptT = interceptT
		fx.InterceptFrom = batteryPos(vPlot)
	else
		fx.DownSeconds = RaidConfig.DownSeconds(aCC)
	end
	local fxRemote = RemoteSetup.Get(Constants.RemoteNames.MissileStrikeFx)
	if fxRemote and fxRemote:IsA("RemoteEvent") then
		(fxRemote :: RemoteEvent):FireAllClients(fx)
	end
	task.delay(flight, resolve, strike.Id)
	-- F6 (owner's 11 features): launching a strike ends the attacker's novice shield for good (EndOnSquadOrder)
	if CombatService and CombatService.EndNoviceShield then
		pcall(CombatService.EndNoviceShield, attacker, "strike")
	end
	if AnalyticsService and AnalyticsService.Log then
		local props = { VictimUserId = victim.UserId, Outcome = strike.Outcome, Chance = chance, Distance = math.floor(distance) }
		task.spawn(function()
			pcall(AnalyticsService.Log, "MISSILE_STRIKE", attacker.UserId, props)
		end)
	end
	return true, nil, nil, strike
end

function MissileStrikeService.Launch(attacker: Player, targetUserId: number): (boolean, string?)
	local ok, reason = launch(attacker, targetUserId)
	return ok, reason
end

-- ── remote ─────────────────────────────────────────────────────────────────

function MissileStrikeService.HandleRequest(player: Player, payload: any)
	if typeof(payload) ~= "table" then
		return
	end
	local action = payload.Action
	if action ~= "State" and action ~= "Launch" then
		return
	end
	local S = RaidConfig.Strike
	if RateLimitService and not RateLimitService.Allow(player, "missile_req", S.RequestRate, S.RequestBurst) then
		return
	end
	if action == "State" then
		pushState(player, nil)
		return
	end
	local targetUserId = RemoteGuard.ClampInt(payload.TargetUserId, 1, 2 ^ 53)
	if targetUserId == nil then
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	local targetName = if target then target.DisplayName else nil
	if RateLimitService and not RateLimitService.Allow(player, "missile_launch", S.LaunchRate, S.LaunchBurst) then
		pushState(player, { Kind = "Refused", TargetName = targetName, Reason = "Busy", Text = reasonText("Busy", nil) })
		return
	end
	local ok, reason, secs, strike = launch(player, targetUserId)
	if ok and strike then
		pushState(player, {
			Kind = "Launched",
			TargetName = strike.VictimName,
			Text = string.format(RaidConfig.Text.StrikeLaunched, strike.VictimName, math.ceil(strike.FlightSeconds)),
			ImpactIn = round1(strike.FlightSeconds),
		})
	else
		local code = reason or "Disabled"
		pushState(player, { Kind = "Refused", TargetName = targetName, Reason = code, Text = reasonText(code, secs) })
	end
end

-- Tests: deterministic interception rolls (nil restores the module RNG)
function MissileStrikeService.SetRandomForTests(fn: (() -> number)?)
	randomFn = fn or defaultRandom
end

function MissileStrikeService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	BaseService = deps.BaseService
	GateDefenseService = deps.GateDefenseService
	AnalyticsService = deps.AnalyticsService
	CombatService = deps.CombatService -- F6 novice shield

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestMissileStrike)
	if remote and remote:IsA("RemoteEvent") then
		(remote :: RemoteEvent).OnServerEvent:Connect(function(player: Player, payload: any)
			xpcall(MissileStrikeService.HandleRequest, function(err)
				warn("[MissileStrike] request failed", player.UserId, err)
			end, player, payload)
		end)
	end
	-- make sure the reply / FX remotes exist before any client binds them
	RemoteSetup.Get(Constants.RemoteNames.MissileStrikeStateUpdate)
	RemoteSetup.Get(Constants.RemoteNames.MissileStrikeFx)

	-- Mirror persisted timers for HUDs once the real save is in (strikes themselves never stop on leave: they
	-- resolve against whoever is still there, refunding when the target is gone)
	if DataService and DataService.OnProfileLoaded then
		DataService.OnProfileLoaded(function(player: Player, profile: any)
			setAttr(player, "WE_StrikeCooldownUntil", raidNum(profile, "StrikeCooldownUntil"))
			setAttr(player, "WE_DefensesDownUntil", raidNum(profile, "DefensesDownUntil"))
		end)
	end

	print("[WAR EMPIRE] MissileStrikeService ready (CC L3 + Missile Defense L1 · $5k · 10 min reload)")
end

return MissileStrikeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">MissionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 6 — Daily missions, timed missions, daily login rewards, achievements.

	W3 step 2, lane M0 (spec w3s2 §6 Phase A):
	- The daily offer rotates (offerFor): DailyOpsConfig.Picks Daily Ops (slot 1 a job op) + the daily missions of
	  MissionConfig.Rotation, MaxActiveDaily in total. Picks are seeded by (UserId, UTC day) with pure integer maths
	  (no Random, no save), so a player sees the same list all day on every server, and a rotation cycle of at most
	  7 days offers every unlocked mission. A mission that already has progress today stays offered (a level-up
	  mid-day never hides it). Only offered missions progress or can be claimed.
	- An entry whose def has a Go key carries Go + GoTargets (server-resolved world points, e.g. the bank vault
	  anchor, else BankRaidConfig.Position) while incomplete; MissionController's GO points the objective marker at
	  the nearest one. Nothing the client sends is trusted: claims re-check the offer, the progress and Claimed.

	W3 step 2 Phase B, lane M1 (jobs):
	- MissionService.SetOpsHooks({ GoTargets, ObjectiveLive }) is called once by OpsService.Init while it runs (nil
	  clears; never yields). With no hook the offer, the GO targets and the pushes are exactly Phase A's.
	- An Ops objective (MissionConfig.OpsObjectives: Checkpoint, Camp, Uplink, Delivery, Job) is live only while
	  hooks.ObjectiveLive(type) == true. OpsService reports progress through TrackProgress(player, type, 1), the only
	  entry point it uses; nothing here trusts the client.
	- resolveGo asks hooks.GoTargets(key) first; nil ("not mine") falls back to the Phase A resolver. A Required key
	  keeps its mission on the offer while it is SERVED (the hook answers, even with no Open site right now), so the
	  day's list never reshuffles when a site cools or the director rotates.
	- Each entry carries the GoMaxTargets targets nearest to the player's character (server positions); the client
	  picks the nearest. While a hook is set, a GoRefreshSeconds timer re-sends a player's list only when it changed
	  (a target list, the offer, or the day), so GO never points at a site that closed long ago.
]]


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local MissionConfig = require(Shared.Configs.MissionConfig)
local DailyRewardConfig = require(Shared.Configs.DailyRewardConfig)
local AchievementConfig = require(Shared.Configs.AchievementConfig)
local DailyOpsConfig = require(Shared.Configs.DailyOpsConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local BankRaidConfig = require(Shared.Configs.BankRaidConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local MissionService = {}

-- OpsService's side of the missions (W3 step 2 Phase B). nil from either function means "not mine".
export type OpsHooks = {
	GoTargets: (goKey: string) -> { MissionConfig.GoTarget }?, -- every Open site of that Go key (the client picks)
	ObjectiveLive: (objectiveType: string) -> boolean?, -- does a live job site report this objective type?
}

local DataService: any = nil
local EconomyService: any = nil
local XPService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local NotificationService: any = nil
local TerritoryService: any = nil

local function yyyymmdd(unix: number): number
	local t = os.date("!*t", unix)
	return t.year * 10000 + t.month * 100 + t.day
end

local function ensureDaily(profile: Types.PlayerProfile)
	if typeof(profile.DailyMissions) ~= "table" then
		profile.DailyMissions = {
			DayKey = 0,
			Progress = {},
			Claimed = {},
			ActiveTimed = {},
		}
	end
	local dm = profile.DailyMissions
	if typeof(dm.Progress) ~= "table" then
		dm.Progress = {}
	end
	if typeof(dm.Claimed) ~= "table" then
		dm.Claimed = {}
	end
	if typeof(dm.ActiveTimed) ~= "table" then
		dm.ActiveTimed = {}
	end

	local today = yyyymmdd(os.time())
	if MissionConfig.RefreshOnUtcDayChange and dm.DayKey ~= today then
		dm.DayKey = today
		dm.Progress = {}
		dm.Claimed = {}
		-- Keep ActiveTimed; they can finish across midnight
	end
end

-- Timed missions share DailyMissions.Claimed (reset on UTC day change) under a prefixed key.
local function timedClaimKey(missionId: string): string
	return "timed:" .. missionId
end

local function commas(n: number): string
	local v = math.floor(n)
	local str = tostring(math.abs(v))
	local out = string.reverse((string.gsub(string.reverse(str), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return if v < 0 then "-" .. out else out
end

-- Daily Op defs by id (the config is static: built once)
local opDefsById: { [string]: DailyOpsConfig.DailyOpDef }? = nil
local function dailyOpDefs(): { [string]: DailyOpsConfig.DailyOpDef }
	local map = opDefsById
	if map == nil then
		local m: { [string]: DailyOpsConfig.DailyOpDef } = {}
		for _, op in ipairs(DailyOpsConfig.Ops) do
			if m[op.Id] == nil then
				m[op.Id] = op
			end
		end
		opDefsById = m
		return m
	end
	return map
end

local function resolveMissionDef(id: string): any?
	if DailyOpsConfig.Enabled then
		local op = dailyOpDefs()[id]
		if op then
			return op
		end
	end
	return MissionConfig.DailyMissions[id]
end

-- ── GO targets (server side; the client only draws the marker) ─────────────────────────────────────────────────
local GO_CACHE_SECONDS = 30 -- anchors are stamped once at world build; re-read at most this often
local GO_CACHE_MAX = 64 -- targets kept per key (the payload sends the GoMaxTargets nearest)
type GoCacheRow = { At: number, List: { MissionConfig.GoTarget }, Served: boolean }
local goCache: { [string]: GoCacheRow } = {}
local goRev: { [string]: number } = {} -- bumped when a key's target list changes (the refresher compares these)
local liveCache: { [string]: { At: number, Live: boolean } } = {}
local opsHooks: OpsHooks? = nil
local hookGen = 0
local anchorsModule: any = nil
local anchorsTried = false

-- ActivityAnchors (W3 step 2 L0, server only) is optional here: found lazily, never waited for
local function anchorPosition(id: string): Vector3?
	if not anchorsTried then
		anchorsTried = true
		local modules = script.Parent.Parent:FindFirstChild("Modules")
		local m = modules and modules:FindFirstChild("ActivityAnchors")
		if m and m:IsA("ModuleScript") then
			local ok, mod = pcall(require, m)
			if ok and type(mod) == "table" then
				anchorsModule = mod
			end
		end
	end
	local mod = anchorsModule
	if mod == nil or type(mod.Get) ~= "function" then
		return nil
	end
	local ok, a = pcall(mod.Get, id)
	if ok and type(a) == "table" and typeof(a.Position) == "Vector3" then
		return a.Position
	end
	return nil
end

local function round1(n: number): number
	return math.floor(n * 10 + 0.5) / 10
end

local function finiteCoord(n: any): boolean
	return type(n) == "number" and n == n and n > -1e6 and n < 1e6
end

-- a hook's answer, checked: finite points only, rounded, at most GO_CACHE_MAX
local function cleanTargets(raw: { any }): { MissionConfig.GoTarget }
	local out: { MissionConfig.GoTarget } = {}
	for _, t in ipairs(raw) do
		if #out >= GO_CACHE_MAX then
			break
		end
		if type(t) == "table" and finiteCoord(t.X) and finiteCoord(t.Y) and finiteCoord(t.Z) then
			table.insert(out, { X = round1(t.X), Y = round1(t.Y), Z = round1(t.Z) })
		end
	end
	return out
end

--[[ The targets of a Go key and whether the key is SERVED. OpsService's hook answers first: a table (even an empty
	one while no site of that key is Open) serves the key; nil means "not mine" and the Phase A resolver runs. ]]
local function resolveGo(kind: string): ({ MissionConfig.GoTarget }, boolean)
	local gd = MissionConfig.Go[kind]
	if gd == nil then
		return {}, false
	end
	local hooks = opsHooks
	if hooks ~= nil and type(hooks.GoTargets) == "function" then
		local ok, res = pcall(hooks.GoTargets, kind)
		if not ok then
			warn("[MissionService] Ops GoTargets(" .. kind .. ") failed: " .. tostring(res))
		elseif type(res) == "table" then
			return cleanTargets(res), true
		end
	end
	local p: Vector3? = nil
	if kind == "Bank" then
		-- no Ops bank site (yet): the bank job is BankRaidService's until the cutover
		if BankRaidConfig.Enabled == false then
			return {}, false
		end
		if gd.Anchor then
			p = anchorPosition(gd.Anchor)
		end
		if p == nil and typeof(BankRaidConfig.Position) == "Vector3" then
			p = BankRaidConfig.Position
		end
	elseif gd.Anchor then
		p = anchorPosition(gd.Anchor)
	end
	if p == nil then
		return {}, false
	end
	return { { X = round1(p.X), Y = round1(p.Y), Z = round1(p.Z) } }, true
end

local function sameTargets(a: { MissionConfig.GoTarget }, b: { MissionConfig.GoTarget }): boolean
	if #a ~= #b then
		return false
	end
	for i, t in ipairs(a) do
		local u = b[i]
		if t.X ~= u.X or t.Y ~= u.Y or t.Z ~= u.Z then
			return false
		end
	end
	return true
end

-- (targets, served) for a Go key, re-resolved at most every GO_CACHE_SECONDS
local function goLookup(kind: string): GoCacheRow
	local now = os.clock()
	local c = goCache[kind]
	if c and now - c.At < GO_CACHE_SECONDS then
		return c
	end
	local list, served = resolveGo(kind)
	if c == nil or c.Served ~= served or not sameTargets(c.List, list) then
		goRev[kind] = (goRev[kind] or 0) + 1
	end
	local row: GoCacheRow = { At = now, List = list, Served = served }
	goCache[kind] = row
	return row
end

local function goTargets(kind: string): { MissionConfig.GoTarget }
	return goLookup(kind).List
end

-- the player's character root on the SERVER (nil while they have none); never waited for
local function rootPosition(player: Player): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

--[[ At most GoMaxTargets of a key's targets for this player: the nearest to their character (the client re-picks).
	The second value names the chosen set ("" when nothing was cut): it goes into the refresh signature, so a player
	who walks or drives across the map is re-sent the targets now nearest (at most once per refresh). ]]
local function nearestTargets(list: { MissionConfig.GoTarget }, player: Player): ({ MissionConfig.GoTarget }, string)
	local max = math.max(1, math.floor(tonumber(MissionConfig.GoMaxTargets) or 16))
	if #list <= max then
		return list, ""
	end
	local idx: { number } = table.create(#list)
	for i = 1, #list do
		idx[i] = i
	end
	local at = rootPosition(player)
	if at then
		local ax, az = at.X, at.Z
		table.sort(idx, function(i: number, j: number): boolean
			local a, b = list[i], list[j]
			local da, db = (a.X - ax) ^ 2 + (a.Z - az) ^ 2, (b.X - ax) ^ 2 + (b.Z - az) ^ 2
			if da ~= db then
				return da < db
			end
			return i < j
		end)
	end
	local out: { MissionConfig.GoTarget } = table.create(max)
	local chosen: { number } = table.create(max)
	for k = 1, max do
		out[k] = list[idx[k]]
		chosen[k] = idx[k]
	end
	table.sort(chosen)
	return out, "~" .. table.concat(chosen, ".")
end

-- an Ops objective is live only while OpsService's hook says so (cached like the GO targets)
local function opsObjectiveLive(objectiveType: string): boolean
	local hooks = opsHooks
	if hooks == nil or type(hooks.ObjectiveLive) ~= "function" then
		return false
	end
	local now = os.clock()
	local c = liveCache[objectiveType]
	if c and now - c.At < GO_CACHE_SECONDS then
		return c.Live
	end
	local ok, res = pcall(hooks.ObjectiveLive, objectiveType)
	if not ok then
		warn("[MissionService] Ops ObjectiveLive(" .. objectiveType .. ") failed: " .. tostring(res))
	end
	local live = ok and res == true
	liveCache[objectiveType] = { At = now, Live = live }
	return live
end

local function objectiveLive(objectiveType: any): boolean
	if type(objectiveType) ~= "string" then
		return false
	end
	if MissionConfig.OpsObjectives[objectiveType] == true then
		return opsObjectiveLive(objectiveType)
	end
	return MissionConfig.LiveObjectives[objectiveType] == true
end

-- ── the daily offer ──────────────────────────────────────────────────────────────────────────────────────────────
-- Park–Miller minimal standard generator: modulus 2^31 - 1, every product < 2^53, so it is exact in doubles and
-- gives the same numbers on every server (no Random, no os.time inside).
local PM = 2147483647
local SALT_JOB, SALT_OPS, SALT_MISSIONS = 7919, 104729, 1299709

local function mix(h: number, v: number): number
	h = (h * 48271 + (v % PM)) % PM
	return if h == 0 then 1 else h
end

local function seedOf(userId: number, cycle: number, salt: number): number
	local u = math.abs(math.floor(userId))
	local h = mix(20240917, u % 65536)
	h = mix(h, (u // 65536) % PM)
	h = mix(h, cycle)
	h = mix(h, salt)
	for _ = 1, 4 do
		h = mix(h, 0)
	end
	return h
end

local function seededShuffle(list: { string }, seed: number): { string }
	local out = table.clone(list)
	local s = seed
	for i = #out, 2, -1 do
		s = (s * 48271) % PM
		local j = (s % i) + 1
		out[i], out[j] = out[j], out[i]
	end
	return out
end

--[[ k picks for this day out of pool. The pool is dealt k per day from a seeded permutation that is re-shuffled
	each cycle of ceil(#pool / k) days, so every entry is offered once per cycle (≤ 7 days for these pools) and the
	picks depend only on (userId, dayIndex, salt). The result keeps the pool's order. ]]
local function rotatePick(pool: { string }, k: number, userId: number, dayIndex: number, salt: number): { string }
	local n = #pool
	if k <= 0 or n == 0 then
		return {}
	end
	if n <= k then
		return table.clone(pool)
	end
	local cycleLen = math.ceil(n / k)
	local cycle = dayIndex // cycleLen
	local slot = dayIndex - cycle * cycleLen
	local perm = seededShuffle(pool, seedOf(userId, cycle, salt))
	local chosen: { [string]: boolean } = {}
	for i = 1, k do
		local idx = slot * k + i
		if idx > n then
			idx -= n -- the last, short slot of a cycle tops up from the start (never a repeat within the day)
		end
		chosen[perm[idx]] = true
	end
	local out: { string } = {}
	for _, id in ipairs(pool) do
		if chosen[id] then
			table.insert(out, id)
		end
	end
	return out
end

-- UTC yyyymmdd -> days since 1970-01-01 (civil-from-days inverse; pure integer maths)
local function dayIndexOf(dayKey: number): number
	local y = dayKey // 10000
	local m = (dayKey // 100) % 100
	local d = dayKey % 100
	if m <= 2 then
		y -= 1
	end
	local era = y // 400
	local yoe = y - era * 400
	local mp = (m + 9) % 12
	local doy = (153 * mp + 2) // 5 + d - 1
	local doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
	return era * 146097 + doe - 719468
end

-- can this def be offered right now (its objective is tracked, and a Required Go is served)?
local function isLive(def: any): boolean
	if not objectiveLive(def.ObjectiveType) then
		return false
	end
	local go = def.Go
	if type(go) == "string" then
		local gd = MissionConfig.Go[go]
		if gd and gd.Required == true and not goLookup(go).Served then
			return false
		end
	end
	return true
end

local function levelOf(profile: Types.PlayerProfile): number
	local lv = tonumber(profile.Level) or 1
	return math.max(1, math.floor(lv))
end

local function pickOps(level: number, userId: number, dayIndex: number): { string }
	if not DailyOpsConfig.Enabled then
		return {}
	end
	local picks = DailyOpsConfig.Picks or 3
	local eligible: { string } = {}
	local ok: { [string]: boolean } = {}
	for _, op in ipairs(DailyOpsConfig.Ops) do
		if not ok[op.Id] and level >= (op.MinLevel or 1) and isLive(op) then
			ok[op.Id] = true
			table.insert(eligible, op.Id)
		end
	end
	local out: { string } = {}
	local first = DailyOpsConfig.FirstJob
	if first and ok[first] then
		out = { first }
	else
		local others: { string } = {}
		for _, id in ipairs(DailyOpsConfig.OtherJobs or {}) do
			if ok[id] then
				table.insert(others, id)
			end
		end
		out = rotatePick(others, 1, userId, dayIndex, SALT_JOB)
	end
	local rest: { string } = {}
	for _, id in ipairs(eligible) do
		if not table.find(out, id) then
			table.insert(rest, id)
		end
	end
	for _, id in ipairs(rotatePick(rest, picks - #out, userId, dayIndex, SALT_OPS)) do
		table.insert(out, id)
	end
	return out
end

-- room: how many list places the ops left (MaxActiveDaily - #ops; 3 normally). Rotation's pick counts are the
-- minimum; if fewer ops were offered (Daily Ops off) the missions fill the list back up to MaxActiveDaily.
local function pickMissions(level: number, userId: number, dayIndex: number, room: number): { string }
	local rot = MissionConfig.Rotation
	local eligible: { string } = {}
	local ok: { [string]: boolean } = {}
	for _, id in ipairs(MissionConfig.DailyMissionOrder) do
		local def = MissionConfig.DailyMissions[id]
		if def and not ok[id] and level >= def.MinLevel and isLive(def) then
			ok[id] = true
			table.insert(eligible, id)
		end
	end
	if level > rot.NewPlayerMaxLevel then
		return rotatePick(eligible, math.max(rot.Picks, room), userId, dayIndex, SALT_MISSIONS)
	end
	local out: { string } = {}
	for _, id in ipairs(rot.Fixed) do
		if ok[id] and not table.find(out, id) then
			table.insert(out, id)
		end
	end
	local pool: { string } = {}
	for _, id in ipairs(eligible) do
		if not table.find(out, id) then
			table.insert(pool, id)
		end
	end
	for _, id in ipairs(rotatePick(pool, math.max(rot.NewPlayerPicks, room - #out), userId, dayIndex, SALT_MISSIONS)) do
		table.insert(out, id)
	end
	return out
end

--[[ Today's offered ids for this player (ops first). Deterministic in (UserId, DayKey, level) plus today's progress:
	any mission with progress today stays offered, taking the place of the last pick of its kind that has none. ]]
local function offerFor(userId: number, profile: Types.PlayerProfile): { string }
	local dm = profile.DailyMissions
	local dayKey = tonumber(dm.DayKey) or 0
	if dayKey < 19700101 then
		dayKey = yyyymmdd(os.time())
	end
	local dayIndex = dayIndexOf(dayKey)
	local level = levelOf(profile)
	local ops = pickOps(level, userId, dayIndex)
	local room = math.max(0, (MissionConfig.MaxActiveDaily or 6) - #ops)
	local missions = pickMissions(level, userId, dayIndex, room)
	while #missions > room do
		table.remove(missions)
	end

	local progress = dm.Progress
	local function hasProgress(id: string): boolean
		local v = progress[id]
		return type(v) == "number" and v > 0
	end
	local sticky: { string } = {}
	for id, v in pairs(progress) do
		if type(id) == "string" and type(v) == "number" and v > 0
			and not table.find(ops, id) and not table.find(missions, id) and resolveMissionDef(id) ~= nil then
			table.insert(sticky, id)
		end
	end
	if #sticky > 0 then
		table.sort(sticky)
		local ops2 = if DailyOpsConfig.Enabled then dailyOpDefs() else {}
		-- the slot-1 job op is never displaced (e.g. a level-2 player who progressed every base op reaches level 3):
		-- the sticky entry then takes another place without progress, or is added at the end of its kind
		local firstJob = DailyOpsConfig.FirstJob
		for _, id in ipairs(sticky) do
			local list = if ops2[id] then ops else missions
			local placed = false
			for j = #list, 1, -1 do
				if list[j] ~= firstJob and not hasProgress(list[j]) then
					list[j] = id
					placed = true
					break
				end
			end
			if not placed then
				table.insert(list, id)
			end
		end
	end

	local out: { string } = table.clone(ops)
	for _, id in ipairs(missions) do
		table.insert(out, id)
	end
	return out
end

local function activeDailyIds(player: Player, profile: Types.PlayerProfile): { string }
	return offerFor(player.UserId, profile)
end

-- what each player was last sent (weak keys: a player who left is dropped with their Player object)
local lastSig: { [Player]: string } = setmetatable({}, { __mode = "k" }) :: any

--[[ The player's mission state and a short signature of everything in it that can change without a TrackProgress
	(the offer, the day, each Go key's target revision). The refresher re-sends only when the signature changes. ]]
local function buildPayload(player: Player, profile: Types.PlayerProfile): (Types.MissionStatePayload, string)
	ensureDaily(profile)
	local sig: { string } = { tostring(profile.DailyMissions.DayKey) }

	local dailyPayload: { Types.MissionEntryPayload } = {}
	for _, id in ipairs(activeDailyIds(player, profile)) do
		local def = resolveMissionDef(id)
		if def then
			local progress = profile.DailyMissions.Progress[id] or 0
			local claimed = profile.DailyMissions.Claimed[id] == true
			local complete = progress >= def.Target
			local entry: Types.MissionEntryPayload = {
				Id = def.Id,
				DisplayName = def.DisplayName,
				Description = def.Description,
				ObjectiveType = def.ObjectiveType,
				Progress = math.min(progress, def.Target),
				Target = def.Target,
				Claimed = claimed,
				Complete = complete,
				RewardCash = def.RewardCash,
				RewardXP = def.RewardXP,
				RewardGold = def.RewardGold or 0,
			}
			-- W3 step 2: GO while incomplete. Extra fields ride on the entry without a Types edit (Types is in flight)
			local go = def.Go
			local goBit = ""
			if type(go) == "string" and not complete and not claimed and MissionConfig.Go[go] ~= nil then
				local targets = goTargets(go)
				goBit = go .. "@" .. tostring(goRev[go] or 0)
				if #targets > 0 then
					local e: any = entry
					e.Go = go
					local near, setKey = nearestTargets(targets, player)
					e.GoTargets = near
					goBit ..= setKey
				end
			end
			table.insert(sig, id .. ":" .. tostring(entry.Progress) .. ":" .. (if claimed then "C" elseif complete then "D" else "") .. goBit)
			table.insert(dailyPayload, entry)
		end
	end

	local today = yyyymmdd(os.time())
	local already = profile.DailyLogin.LastClaimDay == today

	local payload: Types.MissionStatePayload = {
		DayKey = profile.DailyMissions.DayKey,
		Daily = dailyPayload,
		DailyLogin = {
			Streak = profile.DailyLogin.Streak,
			CanClaim = not already,
			NextDay = if already then profile.DailyLogin.Streak else (profile.DailyLogin.Streak % DailyRewardConfig.StreakResetsAfterDay) + 1,
			AlreadyClaimedToday = already,
		},
	}
	table.insert(sig, if already then "L1" else "L0")
	return payload, table.concat(sig, "|")
end

local function send(player: Player, payload: Types.MissionStatePayload, sig: string)
	lastSig[player] = sig
	local remote = RemoteSetup.Get(Constants.RemoteNames.MissionStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

function MissionService.Push(player: Player)
	if not DataService or not RemoteSetup then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local payload, sig = buildPayload(player, profile)
	send(player, payload, sig)
end

-- ── Ops hooks (W3 step 2 Phase B) ─────────────────────────────────────────────────────────────────────────────────
-- re-send a player's list only when it changed (a Go key's targets, the offer or the day); never per frame
local function refreshPlayer(player: Player)
	if lastSig[player] == nil or not DataService or not RemoteSetup then
		return -- never pushed yet: the profile-load push comes first
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local payload, sig = buildPayload(player, profile)
	if sig ~= lastSig[player] then
		send(player, payload, sig)
	end
end

local function scheduleRefresh(gen: number)
	local period = tonumber(MissionConfig.GoRefreshSeconds) or 0
	if period <= 0 then
		return
	end
	task.delay(math.max(5, period), function()
		if gen ~= hookGen or opsHooks == nil then
			return -- the hooks were replaced or cleared: that call runs its own timer
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local ok, err = pcall(function(): any
				refreshPlayer(player)
				return nil
			end)
			if not ok then
				warn("[MissionService] GO refresh failed: " .. tostring(err))
			end
		end
		scheduleRefresh(gen)
	end)
end

--[[ OpsService.Init calls this once while it runs; nil clears it. Never yields. Hook answers are cached like the GO
	targets (GO_CACHE_SECONDS) and a hook that errors counts as "not mine". ]]
function MissionService.SetOpsHooks(hooks: OpsHooks?)
	if hooks ~= nil and type(hooks) ~= "table" then
		return
	end
	opsHooks = hooks
	hookGen += 1
	table.clear(goCache)
	table.clear(liveCache)
	if hooks ~= nil then
		scheduleRefresh(hookGen)
	end
end

function MissionService.GrantAchievement(player: Player, achievementId: string): boolean
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	if typeof(profile.Achievements) ~= "table" then
		profile.Achievements = {}
	end
	if profile.Achievements[achievementId] then
		return false
	end
	local def = AchievementConfig.Achievements[achievementId]
	if not def then
		return false
	end

	profile.Achievements[achievementId] = true
	if def.RewardCash and def.RewardCash > 0 then
		EconomyService.AddCash(player, def.RewardCash, "achievement")
	end
	if def.RewardGold and def.RewardGold > 0 then
		EconomyService.AddGold(player, def.RewardGold, "achievement")
	end
	if def.RewardXP and def.RewardXP > 0 then
		XPService.AddXP(player, def.RewardXP, "achievement")
	end
	DataService.MarkDirty(player)

	if NotificationService then
		NotificationService.Notify(player, "Achievement: " .. def.DisplayName, "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.ACHIEVEMENT_UNLOCKED, player.UserId, {
			id = achievementId,
		})
	end
	return true
end

function MissionService.CheckAchievements(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.Stats.UpgradesPurchased >= 1 then
		MissionService.GrantAchievement(player, "FirstUpgrade")
	end
	if profile.Stats.TotalCashEarned >= 10000 then
		MissionService.GrantAchievement(player, "Cash10k")
	end
	if profile.Level >= 10 then
		MissionService.GrantAchievement(player, "Level10")
	end
end

function MissionService.TrackProgress(player: Player, objectiveType: string, amount: number)
	if not DataService then
		return
	end
	if typeof(objectiveType) ~= "string" or typeof(amount) ~= "number" or amount <= 0 then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	ensureDaily(profile)

	local changed = false
	for _, id in ipairs(activeDailyIds(player, profile)) do
		local def = resolveMissionDef(id)
		if def and def.ObjectiveType == objectiveType then
			local claimed = profile.DailyMissions.Claimed[id] == true
			local prev = profile.DailyMissions.Progress[id] or 0
			if not claimed and prev < def.Target then
				local nextVal = math.min(def.Target, prev + amount)
				profile.DailyMissions.Progress[id] = nextVal
				changed = true
				if AnalyticsService and nextVal >= def.Target and prev < def.Target then
					AnalyticsService.Log(AnalyticsConfig.Events.MISSION_PROGRESS, player.UserId, {
						mission = id,
						complete = true,
					})
					if NotificationService then
						NotificationService.Notify(player, def.DisplayName .. " complete — claim reward!", "Info")
					end
				end
			end
		end
	end

	if changed then
		DataService.MarkDirty(player)
		MissionService.Push(player)
	end

	MissionService.CheckAchievements(player)
end

function MissionService.ClaimDailyMission(player: Player, missionId: string): (boolean, string?)
	if not RemoteGuard.IsIdString(missionId, 48) then
		return false, "InvalidMission"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureDaily(profile)

	local def = resolveMissionDef(missionId)
	if not def then
		return false, "UnknownMission"
	end
	if profile.DailyMissions.Claimed[missionId] then
		return false, "AlreadyClaimed"
	end
	-- only today's offer can be claimed (a completed mission always stays in it)
	if not table.find(activeDailyIds(player, profile), missionId) then
		return false, "NotOffered"
	end
	local progress = profile.DailyMissions.Progress[missionId] or 0
	if progress < def.Target then
		return false, "Incomplete"
	end

	profile.DailyMissions.Claimed[missionId] = true
	profile.Stats.MissionsCompleted += 1

	local cash = def.RewardCash
	if TerritoryService and TerritoryService.GetMissionCashMult then
		cash = math.floor(cash * TerritoryService.GetMissionCashMult(player))
	end
	if cash > 0 then
		EconomyService.AddCash(player, cash, "mission")
	end
	if (def.RewardGold or 0) > 0 then
		EconomyService.AddGold(player, def.RewardGold :: number, "mission")
	end
	if def.RewardXP > 0 then
		XPService.AddXP(player, def.RewardXP, "mission")
	end

	DataService.MarkDirty(player)
	if NotificationService then
		NotificationService.Notify(player, "Mission reward $" .. commas(cash), "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.MISSION_CLAIMED, player.UserId, {
			mission = missionId,
			cash = cash,
		})
	end
	MissionService.Push(player)
	return true, nil
end

function MissionService.ClaimDailyLogin(player: Player): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local today = yyyymmdd(os.time())
	local daily = profile.DailyLogin
	if daily.LastClaimDay == today then
		if NotificationService then
			NotificationService.Notify(player, "Daily reward already claimed.", "Warn")
		end
		return false, "AlreadyClaimed"
	end

	local yesterday = yyyymmdd(os.time() - 86400)
	if DailyRewardConfig.MissedDayResetsStreak and daily.LastClaimDay ~= 0 and daily.LastClaimDay ~= yesterday then
		daily.Streak = 0
	end

	daily.Streak = (daily.Streak % DailyRewardConfig.StreakResetsAfterDay) + 1
	daily.LastClaimDay = today
	daily.LastClaimUnix = os.time()

	local reward = DailyRewardConfig.Rewards[daily.Streak]
	if reward then
		if reward.Cash > 0 then
			EconomyService.AddCash(player, reward.Cash, "daily")
		end
		if reward.Gold > 0 then
			EconomyService.AddGold(player, reward.Gold, "daily")
		end
		if reward.XP > 0 then
			XPService.AddXP(player, reward.XP, "daily")
		end
		if NotificationService then
			NotificationService.Notify(
				player,
				string.format("Day %d reward: $%d", daily.Streak, reward.Cash),
				"Reward"
			)
		end
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.DAILY_REWARD_CLAIMED, player.UserId, { day = daily.Streak })
		end
	end
	DataService.MarkDirty(player)
	MissionService.Push(player)
	return true, nil
end

function MissionService.Start(player: Player, missionId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(missionId, 48) then
		return false, "InvalidMission"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	ensureDaily(profile)

	local def = MissionConfig.Missions[missionId]
	if not def then
		return false, "UnknownMission"
	end
	if profile.Level < def.MinLevel then
		return false, "LevelTooLow"
	end
	if profile.DailyMissions.ActiveTimed[missionId] and profile.DailyMissions.ActiveTimed[missionId] > os.time() then
		return false, "AlreadyActive"
	end
	-- v69: each timed mission pays once per UTC day (was repeatable every Duration seconds)
	if profile.DailyMissions.Claimed[timedClaimKey(missionId)] then
		return false, "AlreadyClaimed"
	end

	profile.DailyMissions.ActiveTimed[missionId] = os.time() + def.DurationSeconds
	DataService.MarkDirty(player)
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format("%s started (%ds)", def.DisplayName, def.DurationSeconds),
			"Info"
		)
	end

	-- Auto-complete after duration (MVP: timer-based, no world objectives)
	task.delay(def.DurationSeconds, function()
		if not player.Parent then
			return
		end
		local p = DataService.GetProfile(player)
		if not p then
			return
		end
		ensureDaily(p)
		local ends = p.DailyMissions.ActiveTimed[missionId]
		if not ends or ends > os.time() + 1 then
			return
		end
		p.DailyMissions.ActiveTimed[missionId] = nil
		MissionService.Complete(player, missionId)
	end)

	MissionService.Push(player)
	return true, nil
end

function MissionService.Complete(player: Player, missionId: string)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local def = MissionConfig.Missions[missionId]
	if not def then
		return
	end
	ensureDaily(profile)
	local claimKey = timedClaimKey(missionId)
	if profile.DailyMissions.Claimed[claimKey] then
		return
	end
	profile.DailyMissions.Claimed[claimKey] = true

	profile.Stats.MissionsCompleted += 1
	local cash = def.RewardCash
	if TerritoryService and TerritoryService.GetMissionCashMult then
		cash = math.floor(cash * TerritoryService.GetMissionCashMult(player))
	end
	if cash > 0 then
		EconomyService.AddCash(player, cash, "timed_mission")
	end
	if def.RewardXP > 0 then
		XPService.AddXP(player, def.RewardXP, "timed_mission")
	end
	DataService.MarkDirty(player)
	if NotificationService then
		NotificationService.Notify(player, string.format("%s complete! +$%d", def.DisplayName, cash), "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.MISSION_CLAIMED, player.UserId, {
			mission = missionId,
			timed = true,
			cash = cash,
		})
	end
	MissionService.Push(player)
end

function MissionService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	NotificationService = deps.NotificationService
	TerritoryService = deps.TerritoryService

	-- v69: no client UI starts timed missions; with the remote open an executor could loop them for
	-- cash/XP. Keep a listener (so events never queue) but drop requests unless explicitly enabled.
	local startRemote = RemoteSetup.Get(Constants.RemoteNames.RequestStartMission) :: RemoteEvent
	startRemote.OnServerEvent:Connect(function(player: Player, missionId: any)
		if MissionConfig.TimedMissionsRemoteEnabled ~= true then
			return
		end
		if not RateLimitService.Allow(player, "start_mission", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		MissionService.Start(player, missionId)
	end)

	local claimRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimMission) :: RemoteEvent
	claimRemote.OnServerEvent:Connect(function(player: Player, missionId: any)
		if not RateLimitService.Allow(player, "claim_mission", 2, 3) then
			return
		end
		MissionService.ClaimDailyMission(player, missionId)
	end)

	local dailyRemote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimDailyReward) :: RemoteEvent
	dailyRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "daily_reward", 1, 2) then
			return
		end
		MissionService.ClaimDailyLogin(player)
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		ensureDaily(_profile)
		MissionService.CheckAchievements(player)
		MissionService.Push(player)
	end)
end

return MissionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 7 — Monetization MVP
	- ProcessReceipt: idempotent DevProduct grants from MonetizationConfig only
	- GamePass ownership cached on join (MarketplaceService:UserOwnsGamePassAsync)
	- VIP / 2x Cash / 2x XP multipliers for EconomyService / XPService
	- NEVER grant currency from client purchase confirmation alone
	v71 money (M1): receipt core — GrantEntitlements lists, whitelisted counter grants (MonetizationConfig.CounterGrants,
	e.g. GrantNukes -> profile.Nukes), StarterFallbackCash decided before any grant, profile.Monetization accounting
	(CurrencySpent), post-save OnGranted(fn) listeners, OnPassOwned(fn) listeners (confirmPassPurchase and
	RefreshGamePassCache), pass checks in parallel (J21), Roblox AnalyticsService economy events (deferred, pcall),
	a whitelisted `source` on RequestPurchase*. Offers: none before the tutorial is complete, the Starter Pack gate
	TrySoftOfferStarterBundle (TutorialService schedules it), no Speed Boost / death Cash Mega pop-ups, D8 budget.
	Owner's 11 features, lane M (spec_f11 F7 / F8): SpeedMultFor (the highest WalkSpeedMult among the speed SKUs the
	player owns: Speed Pass x1.15, Speed Boost x1.25; never multiplied together), re-applied on respawn, on load and
	when a speed pass flips to owned; TryDeathSpeedOffer (the one death offer, MonetizationConfig.DeathSpeedOffer).
	The Keep-Base Rebirth receipt needs no branch of its own: CounterGrants.GrantKeepBaseRebirths banks the token,
	it is saved before PurchaseGranted, and PrestigeService runs the rebirth from OnGranted (never in the receipt).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local DevConfig = require(Shared.Configs.DevConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local MonetizationService = {}

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local BattlePassService: any = nil
local BaseService: any = nil
local SoldierService: any = nil

-- Session receipt cache; also mirrored to profile.ProcessedReceipts
local processed: { [string]: boolean } = {}
--[[ v71 money (J2): receipts being processed right now (PurchaseId -> true). ProcessReceipt yields (Battle Pass
	readiness, the profile load, pre-grant ownership lookups, the save). A second delivery of the same receipt in
	that window never runs alongside the first (with a yield between hasProcessed and markProcessed it would grant
	twice): it answers NotProcessedYet, and Roblox retries it after the first run has marked and saved it. ]]
local receiptsInFlight: { [string]: boolean } = {}
-- userId -> passKey -> owned
local gamePassCache: { [number]: { [string]: boolean } } = {}
-- v38: session soft-offer spam gate (one toast max per SoftOfferSessionCooldownSeconds)
local lastSoftOfferAt: { [number]: number } = {}
-- v70: follow-up ownership checks after UserOwnsGamePassAsync failed (userId -> retries used)
local passRefreshRetries: { [number]: number } = {}
local PASS_REFRESH_MAX_RETRIES = 4
local PASS_REFRESH_RETRY_SECONDS = 15
-- v70: a Battle Pass Premium receipt can arrive before BattlePassService.Init (it runs after MapSetup)
local BATTLE_PASS_READY_WAIT_SECONDS = 30

-- v71 money (M1) ────────────────────────────────────────────────────────────────────────────────────────────────
local MAX_COUNTER = 1e15 -- same ceiling as ProfileSchema's sanitiser
type GrantEvent = {
	ProductKey: string,
	ProductId: number,
	ReceiptId: string,
	DisplayName: string,
	Cash: number,
	Gold: number,
	Entitlements: { string },
	Counters: { [string]: number }, -- profile field -> amount added (e.g. Nukes = 3)
	CurrencySpent: number,
	Source: string,
	FirstPurchase: boolean,
	At: number, -- os.clock() of the grant (prunes stale pending events)
}
type GrantListener = (player: Player, productKey: string, event: GrantEvent) -> ()
type PassOwnedListener = (player: Player, passKey: string, reason: string) -> ()
local grantListeners: { GrantListener } = {}
local passOwnedListeners: { PassOwnedListener } = {}
-- receiptId -> grant applied in memory whose save failed; its post-save work runs when a retry saves it
local pendingGrantEvents: { [string]: GrantEvent } = {}
local PENDING_GRANT_TTL_SECONDS = 3600
-- userId -> "DP:<key>" / "GP:<key>" -> last purchase intent (analytics source attribution only)
local purchaseIntents: { [number]: { [string]: { Source: string, At: number } } } = {}
-- userId -> the first pass-cache fill of this session is done (OnPassOwned reason "join" vs "refresh")
local passCacheFilled: { [number]: boolean } = {}
-- D8 session soft-offer budget, and the session start used by the tutorial quiet window
local softOffersClaimed: { [number]: number } = {}
local sessionStartAt: { [number]: number } = {}
-- F8: the death speed offer was sent this session (userId -> true; cleared on PlayerRemoving)
local deathSpeedSent: { [number]: boolean } = {}
-- F8: sanity cap on a WalkSpeedMult config value (a typo must never launch players across the map)
local MAX_WALK_SPEED_MULT = 2

-- Whole number >= 0; junk (nil, strings, NaN, inf, negatives) becomes 0.
local function nonNegInt(value: any): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return math.clamp(math.floor(n), 0, MAX_COUNTER)
end

--[[ v70: display-only replication of one-time entitlements / owned passes (ShopController shows OWNED when
	WE_Ent_<key> is true). Never read back by the server; grants stay ProcessReceipt / ownership checks. ]]
local function setEntitlementAttr(player: Player, key: any)
	if typeof(key) ~= "string" or #key == 0 or #key > 90 or string.match(key, "^[%w_]+$") == nil then
		return
	end
	pcall(function()
		player:SetAttribute("WE_Ent_" .. key, true)
	end)
end

function MonetizationService.ClaimSoftOfferSlot(player: Player): boolean
	if not player then
		return false
	end
	local cfg = MonetizationConfig :: any
	local now = os.clock()
	-- v71 money (M1): no pop-ups during the tutorial (the Starter Pack offer comes right after it). A player who
	-- never finishes it becomes offerable after SoftOfferQuietMaxSeconds of play this session.
	if cfg.SoftOfferQuietUntilTutorialComplete == true and DataService then
		local profile = DataService.GetProfile(player)
		if profile and profile.TutorialComplete ~= true then
			local started = sessionStartAt[player.UserId]
			local quietMax = tonumber(cfg.SoftOfferQuietMaxSeconds) or 900
			if started == nil or now - started < quietMax then
				return false
			end
		end
	end
	-- v71 money (M1, D8): at most SoftOfferSessionMax per session (the HUD refuses a 4th anyway)
	local maxPerSession = tonumber(cfg.SoftOfferSessionMax)
	if maxPerSession and (softOffersClaimed[player.UserId] or 0) >= maxPerSession then
		return false
	end
	local cd = tonumber(cfg.SoftOfferSessionCooldownSeconds) or 60
	local last = lastSoftOfferAt[player.UserId]
	if last ~= nil and now - last < cd then
		return false
	end
	lastSoftOfferAt[player.UserId] = now
	softOffersClaimed[player.UserId] = (softOffersClaimed[player.UserId] or 0) + 1
	return true
end

--[[ v71 money (M1): listener registries. Each returns a function that removes the listener. Listeners run
	deferred, each in its own pcall, so a failing listener never touches a receipt or another listener.
	OnGranted(fn(player, productKey, event)): after a DevProduct grant is SAVED (the receipt is then acknowledged).
	  Never for a grant whose save failed (it runs later, when a retry saves it). event: GrantEvent above.
	OnPassOwned(fn(player, passKey, reason)): a game pass flips to owned in the session cache. reason = "join" (the
	  first ownership check of the session), "refresh" (a later check, e.g. after a failed one) or "purchase"
	  (confirmPassPurchase after PromptGamePassPurchaseFinished, confirmed by UserOwnsGamePassAsync). ]]
local function addListener<T>(list: { T }, fn: T): () -> ()
	table.insert(list, fn)
	return function()
		local i = table.find(list, fn)
		if i then
			table.remove(list, i)
		end
	end
end

function MonetizationService.OnGranted(fn: GrantListener): () -> ()
	assert(typeof(fn) == "function", "OnGranted expects a function")
	return addListener(grantListeners, fn)
end

function MonetizationService.OnPassOwned(fn: PassOwnedListener): () -> ()
	assert(typeof(fn) == "function", "OnPassOwned expects a function")
	return addListener(passOwnedListeners, fn)
end

local function runListener(label: string, fn: any, ...: any)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[MonetizationService] " .. label .. " listener error:", err)
	end
end

local function firePassOwned(player: Player, passKey: string, reason: string)
	for _, fn in ipairs(table.clone(passOwnedListeners)) do
		task.defer(runListener, "OnPassOwned", fn, player, passKey, reason)
	end
end

-- v71 money (M1): `source` of a purchase intent (RequestPurchase* 2nd arg), checked against the whitelist
local function cleanSource(raw: any): string
	if typeof(raw) == "string" and #raw > 0 and #raw <= 32 then
		local sources = (MonetizationConfig :: any).PurchaseSources
		if typeof(sources) == "table" and sources[raw] == true then
			return raw
		end
	end
	return "other"
end

local function rememberIntent(player: Player, intentKey: string, source: string)
	local t = purchaseIntents[player.UserId]
	if not t then
		t = {}
		purchaseIntents[player.UserId] = t
	end
	t[intentKey] = { Source = source, At = os.clock() }
end

-- "none" when no intent for this key was logged within IntentAttributionSeconds (e.g. a Roblox retry)
local function intentSource(userId: number, intentKey: string): string
	local t = purchaseIntents[userId]
	local e = t and t[intentKey]
	local window = tonumber((MonetizationConfig :: any).IntentAttributionSeconds) or 180
	if e and os.clock() - e.At <= window then
		return e.Source
	end
	return "none"
end

--[[ v71 money (M1): Roblox's built-in AnalyticsService economy event (bound as RbxAnalytics: the in-house
	AnalyticsService dep has the same name). Deferred and pcall'd: it can never block or fail a grant. ]]
local function logEconomySource(player: Player, currency: string, amount: number, endingBalance: number, sku: string)
	if amount <= 0 then
		return
	end
	task.defer(function()
		pcall(function()
			local RbxAnalytics: any = game:GetService("AnalyticsService")
			local E: any = Enum
			RbxAnalytics:LogEconomyEvent(
				player,
				E.AnalyticsEconomyFlowType.Source,
				currency,
				amount,
				endingBalance,
				E.AnalyticsEconomyTransactionType.IAP.Name,
				sku
			)
		end)
	end)
end

-- Purchase accounting (analytics / segmentation only; never shown to players). Returns true on the first purchase.
local function recordPurchase(profile: any, robux: number): boolean
	local m = profile.Monetization
	if typeof(m) ~= "table" then
		m = {}
		profile.Monetization = m
	end
	local nowUnix = os.time()
	local first = nonNegInt(m.FirstPurchaseUnix) == 0
	m.Purchases = math.min(nonNegInt(m.Purchases) + 1, MAX_COUNTER)
	m.RobuxSpent = math.min(nonNegInt(m.RobuxSpent) + nonNegInt(robux), MAX_COUNTER)
	if first then
		m.FirstPurchaseUnix = nowUnix
	end
	m.LastPurchaseUnix = nowUnix
	return first
end

local function logFirstPurchase(player: Player, profile: any, key: string)
	if not AnalyticsService then
		return
	end
	local stats = if typeof(profile) == "table" and typeof(profile.Stats) == "table" then profile.Stats else {}
	AnalyticsService.Log(AnalyticsConfig.Events.FIRST_PURCHASE, player.UserId, {
		key = key,
		minutesPlayed = math.floor(nonNegInt(stats.PlayTimeSeconds) / 60),
		tutorialComplete = typeof(profile) == "table" and profile.TutorialComplete == true,
	})
end


local function findDevProduct(productId: number): (string?, any?)
	if typeof(productId) ~= "number" or productId == 0 then
		return nil, nil
	end
	for key, def in pairs(MonetizationConfig.DevProducts) do
		if def.Id ~= 0 and def.Id == productId then
			return key, def
		end
	end
	return nil, nil
end

local function findDevProductByKey(key: string): any?
	return MonetizationConfig.DevProducts[key]
end

local function findGamePassByKey(key: string): any?
	return MonetizationConfig.GamePasses[key]
end

local function hasProcessed(profile: any, receiptId: string): boolean
	if processed[receiptId] then
		return true
	end
	if typeof(profile) == "table" and typeof(profile.ProcessedReceipts) == "table" then
		return profile.ProcessedReceipts[receiptId] == true
	end
	return false
end

--[[ v70: marks the profile only. The session cache `processed` is set once the grant is SAVED (ProcessReceipt):
	after a failed save plus a reload, that cache used to acknowledge the re-delivered receipt with no grant. ]]
local function markProcessed(profile: any, receiptId: string)
	if typeof(profile) == "table" then
		if typeof(profile.ProcessedReceipts) ~= "table" then
			profile.ProcessedReceipts = {}
		end
		profile.ProcessedReceipts[receiptId] = true
	end
end

local function mockOwns(passKey: string): boolean
	if not RunService:IsStudio() then
		return false
	end
	local mock = DevConfig.MockOwnedGamePasses
	return typeof(mock) == "table" and mock[passKey] == true
end

function MonetizationService.RefreshGamePassCache(player: Player): { [string]: boolean }
	local userId = player.UserId
	local checked: { [string]: boolean } = {}
	local anyFailed = false
	-- v71 money (J21): every pass with a live Id is checked at the same time (one thread each); the caller waits
	-- for the last one. 12 serial checks added about 2 s to each join.
	local pending = 0
	local waiter: thread? = nil
	for passKey, def in pairs(MonetizationConfig.GamePasses) do
		checked[passKey] = false
		if typeof(def.Id) == "number" and def.Id ~= 0 then
			local passId: number = def.Id
			pending += 1
			task.spawn(function()
				local ok, result = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(userId, passId)
				end)
				if ok and result == true then
					checked[passKey] = true
				elseif not ok then
					warn("[MonetizationService] UserOwnsGamePassAsync failed", passKey, result)
					anyFailed = true
				end
				pending -= 1
				local co = waiter
				if pending == 0 and co ~= nil then
					waiter = nil
					task.spawn(co)
				end
			end)
		elseif mockOwns(passKey) then
			checked[passKey] = true
		end
	end
	while pending > 0 do
		waiter = coroutine.running()
		coroutine.yield()
	end
	-- v70: merge into the live cache instead of replacing it. Keys mirrored from Entitlements or a purchase
	-- this session stay true, and a failed / lagging check never turns an owned pass off for the session.
	local cache = gamePassCache[userId]
	if not cache then
		cache = {}
		if player.Parent then -- left during the checks: PlayerRemoving already dropped the cache
			gamePassCache[userId] = cache
		end
	end
	local flipped: { string } = {}
	for passKey, owned in pairs(checked) do
		if owned then
			if cache[passKey] ~= true then
				table.insert(flipped, passKey) -- v71 money (M1): OnPassOwned
			end
			cache[passKey] = true
			setEntitlementAttr(player, passKey)
		elseif cache[passKey] == nil then
			cache[passKey] = false
		end
	end
	if player.Parent then
		local reason = if passCacheFilled[userId] then "refresh" else "join"
		passCacheFilled[userId] = true
		for _, passKey in ipairs(flipped) do
			firePassOwned(player, passKey, reason)
		end
	end
	-- v70: a failed check is not "not owned" — ask again a few times instead of caching false all session
	if anyFailed and player.Parent then
		local used = passRefreshRetries[userId] or 0
		if used < PASS_REFRESH_MAX_RETRIES then
			passRefreshRetries[userId] = used + 1
			task.delay(PASS_REFRESH_RETRY_SECONDS * (used + 1), function()
				if player.Parent then
					MonetizationService.RefreshGamePassCache(player)
				end
			end)
		end
	elseif not anyFailed then
		passRefreshRetries[userId] = nil
	end
	return cache
end

function MonetizationService.PlayerOwnsGamePass(player: Player, passKey: string): boolean
	local cache = gamePassCache[player.UserId]
	if not cache then
		cache = MonetizationService.RefreshGamePassCache(player)
	end
	return cache[passKey] == true
end

--[[ F8: ownership from what this session already knows: the pass cache (filled on join; mirrors entitlements and
	confirmed purchases) or the saved entitlement. Never yields and never calls Roblox, so it is safe inside a
	receipt's no-yield window and in a death listener. ]]
local function ownsCached(player: Player, key: string): boolean
	local cache = gamePassCache[player.UserId]
	if cache ~= nil and cache[key] == true then
		return true
	end
	local profile = DataService and DataService.GetProfile(player)
	return typeof(profile) == "table" and typeof(profile.Entitlements) == "table" and profile.Entitlements[key] == true
end

-- F8: a SKU key (game pass or Developer Product) is owned: its own key, or the entitlement its product grants
local function ownsSkuCached(player: Player, key: string): boolean
	if ownsCached(player, key) then
		return true
	end
	local dp = (MonetizationConfig.DevProducts :: any)[key]
	local ent = if typeof(dp) == "table" then dp.GrantEntitlement else nil
	return typeof(ent) == "string" and ent ~= key and ownsCached(player, ent)
end

-- F8: WalkSpeedMult of one config entry (1 when missing or junk; capped at MAX_WALK_SPEED_MULT)
local function walkSpeedMultOf(def: any): number
	local m = if typeof(def) == "table" then tonumber(def.WalkSpeedMult) else nil
	if m == nil or m ~= m or m <= 1 then
		return 1
	end
	return math.min(m, MAX_WALK_SPEED_MULT)
end

-- F8: the key (game pass, Developer Product or granted entitlement) belongs to a speed SKU
local function isSpeedKey(key: string): boolean
	if walkSpeedMultOf((MonetizationConfig.GamePasses :: any)[key]) > 1 then
		return true
	end
	for dpKey, def in pairs(MonetizationConfig.DevProducts :: any) do
		if walkSpeedMultOf(def) > 1 and (dpKey == key or def.GrantEntitlement == key) then
			return true
		end
	end
	return false
end

--[[ F8 (owner's 11 features): the walk-speed multiplier for this player = the HIGHEST WalkSpeedMult among the speed
	SKUs they own (GamePasses.ImpulseSpeed x1.15, DevProducts.SpeedBoost x1.25), never the product of them: owning
	both gives x1.25. 1 when none is owned. A pass whose Id is 0 is never owned outside Studio mocks. Never yields. ]]
function MonetizationService.SpeedMultFor(player: Player): number
	local best = 1
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return best
	end
	for passKey, def in pairs(MonetizationConfig.GamePasses :: any) do
		local m = walkSpeedMultOf(def)
		if m > best and ownsCached(player, passKey) then
			best = m
		end
	end
	for productKey, def in pairs(MonetizationConfig.DevProducts :: any) do
		local m = walkSpeedMultOf(def)
		if m > best and ownsSkuCached(player, productKey) then
			best = m
		end
	end
	return best
end

-- SpeedBoost / Speed Pass: permanent move speed on the current character (F8: SpeedMultFor, the max of the owned SKUs)
local function applySpeedBoostToCharacter(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local mult = MonetizationService.SpeedMultFor(player)
	if mult <= 1 then
		return -- nothing owned: WalkSpeed stays the game default
	end
	local GameConfig = require(Shared.Configs.GameConfig)
	local base = tonumber(GameConfig.DefaultWalkSpeed) or 16
	hum.WalkSpeed = base * mult
end

function MonetizationService.SetMockGamePassOwned(player: Player, passKey: string, owned: boolean)
	if not RunService:IsStudio() then
		return
	end
	if not findGamePassByKey(passKey) then
		return
	end
	local cache = gamePassCache[player.UserId]
	if not cache then
		cache = {}
		gamePassCache[player.UserId] = cache
	end
	cache[passKey] = owned
	-- F8: a mocked Speed Pass applies at once (Studio only; the live path is OnPassOwned below)
	if owned and isSpeedKey(passKey) then
		applySpeedBoostToCharacter(player)
	end
end


local function ensureEntitlements(profile: any)
	if typeof(profile.Entitlements) ~= "table" then
		profile.Entitlements = {}
	end
	return profile.Entitlements
end

function MonetizationService.GrantEntitlement(player: Player, key: string)
	local profile = DataService.GetProfile(player)
	if not profile or typeof(key) ~= "string" or key == "" then
		return
	end
	local ents = ensureEntitlements(profile)
	ents[key] = true
	setEntitlementAttr(player, key) -- v70: Shop shows OWNED (display only)
	-- Mirror common keys into GamePass session cache so multipliers apply immediately
	if key == "VIP" or key == "DoubleCash" or key == "DoubleXP" or key == "AutoCollect" then
		local cache = gamePassCache[player.UserId]
		if not cache then
			cache = {}
			gamePassCache[player.UserId] = cache
		end
		cache[key] = true
	end
	-- InstantBarracks: bump Barracks to at least 1
	if key == "InstantBarracks" and typeof(profile.BaseUpgrades) == "table" then
		local cur = tonumber(profile.BaseUpgrades.Barracks) or 0
		if cur < 1 then
			profile.BaseUpgrades.Barracks = 1
			-- v70: same follow-ups as a cash Barracks purchase, or the player sees nothing until rejoin
			task.defer(function()
				if not player.Parent then
					return
				end
				local base = BaseService
				if base then
					if base.PushState then
						pcall(base.PushState, player)
					end
					if base.UpdateVisuals then
						pcall(base.UpdateVisuals, player, "Barracks", 1)
					end
					if base.GetUpgradeChangedEvent then
						pcall(function()
							local live = DataService.GetProfile(player)
							base.GetUpgradeChangedEvent():Fire(player.UserId, live and live.BasePlotId, "Barracks", 1)
						end)
					end
				end
				if SoldierService and SoldierService.Push then
					pcall(SoldierService.Push, player) -- army cap label
				end
			end)
		end
	end
	-- ExtraSoldierSlot: +1 army cap — refresh the Army panel now
	if key == "ExtraSoldierSlot" then
		task.defer(function()
			if player.Parent and SoldierService and SoldierService.Push then
				pcall(SoldierService.Push, player)
			end
		end)
	end
	-- GoldenPumpjack: re-dress plot oil pumps when product Id is live + granted
	if key == "GoldenPumpjack" and typeof(profile.BasePlotId) == "number" then
		task.defer(function()
			local ok, pumpSvc = pcall(function()
				return require(script.Parent.PlotOilPumpService)
			end)
			if ok and pumpSvc and pumpSvc.SyncPlot then
				pumpSvc.SyncPlot(profile.BasePlotId)
			end
		end)
	end
	-- SpeedBoost (F8: any speed SKU): permanent move-speed on current character; no yield (receipt-safe)
	if isSpeedKey(key) then
		applySpeedBoostToCharacter(player)
	end
	DataService.MarkDirty(player)
end

function MonetizationService.PlayerOwnsEntitlement(player: Player, key: string): boolean
	if MonetizationService.PlayerOwnsGamePass(player, key) then
		return true
	end
	local profile = DataService.GetProfile(player)
	if profile and typeof(profile.Entitlements) == "table" and profile.Entitlements[key] == true then
		return true
	end
	return false
end

--[[ Cash multiplier from VIP (additive bonus) + DoubleCash (multiplicative). ]]
function MonetizationService.GetCashMultiplier(player: Player): number
	local mult = 1
	local vip = MonetizationConfig.GamePasses.VIP
	local hasVip = MonetizationService.PlayerOwnsEntitlement(player, "VIP")
		or MonetizationService.PlayerOwnsGamePass(player, "VIP")
	if vip and hasVip then
		local bonus = tonumber(vip.CashBonusMult) or 0
		mult += bonus
	end
	local doubleCash = MonetizationConfig.GamePasses.DoubleCash
	local hasDouble = MonetizationService.PlayerOwnsEntitlement(player, "DoubleCash")
		or MonetizationService.PlayerOwnsGamePass(player, "DoubleCash")
	if doubleCash and hasDouble then
		local m = tonumber(doubleCash.CashMult) or 2
		mult *= m
	end
	return math.max(0, mult)
end

function MonetizationService.GetXPMultiplier(player: Player): number
	local doubleXP = MonetizationConfig.GamePasses.DoubleXP
	if doubleXP and MonetizationService.PlayerOwnsGamePass(player, "DoubleXP") then
		return math.max(1, tonumber(doubleXP.XPMult) or 2)
	end
	return 1
end

local PASS_CONFIRM_DELAYS = { 0, 2, 5, 10, 20 } -- re-checks after a pass purchase prompt closes (~37 s)
local passConfirming: { [string]: boolean } = {} -- "userId:passKey" -> a confirm loop is running

--[[ v70: after PromptGamePassPurchaseFinished(wasPurchased) — never trusted alone. Marks the pass owned for this
	session only when UserOwnsGamePassAsync says so (bounded re-checks, one loop per player + pass). ]]
local function confirmPassPurchase(player: Player, passKey: string, passId: number, passName: string)
	local loopKey = tostring(player.UserId) .. ":" .. passKey
	if passConfirming[loopKey] then
		return
	end
	passConfirming[loopKey] = true
	task.spawn(function()
		local confirmed = false
		for _, delaySec in ipairs(PASS_CONFIRM_DELAYS) do
			if delaySec > 0 then
				task.wait(delaySec)
			end
			if not player.Parent then
				break
			end
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
			end)
			if ok and owns == true then
				confirmed = true
				break
			end
		end
		passConfirming[loopKey] = nil
		if not player.Parent then
			return
		end
		if not confirmed then
			if NotificationService then
				NotificationService.Notify(player, passName .. ": waiting for Roblox to confirm the pass — rejoin if it is not active soon", "Info")
			end
			return
		end
		local cache = gamePassCache[player.UserId]
		if not cache then
			cache = {}
			gamePassCache[player.UserId] = cache
		end
		local wasOwned = cache[passKey] == true
		cache[passKey] = true
		setEntitlementAttr(player, passKey)
		if not wasOwned and NotificationService then
			NotificationService.Notify(player, "Owned: " .. passName .. " (benefits active)", "Success")
		end
		if not wasOwned then
			-- v71 money (M1): owned-flip listeners, PASS_OWNED, and approximate accounting (config price: a pass
			-- purchase has no receipt, so the exact Robux amount is unknown)
			local def = MonetizationConfig.GamePasses[passKey]
			local price = nonNegInt(def and def.RobuxPrice)
			local source = intentSource(player.UserId, "GP:" .. passKey)
			local profile = DataService and DataService.GetProfile(player)
			local first = false
			if profile then
				first = recordPurchase(profile, price)
				DataService.MarkDirty(player)
			end
			if AnalyticsService then
				AnalyticsService.Log(AnalyticsConfig.Events.PASS_OWNED, player.UserId, {
					key = passKey,
					price = price,
					source = source,
				})
			end
			if first and profile then
				logFirstPurchase(player, profile, passKey)
			end
			firePassOwned(player, passKey, "purchase")
		end
	end)
end

-- v71 money (M1): the Starter Pack offer ───────────────────────────────────────────────────────────────────────
local function starterBundleLive(): any?
	local bundle = MonetizationConfig.DevProducts.StarterBundle
	if bundle and typeof(bundle.Id) == "number" and bundle.Id ~= 0 then
		return bundle
	end
	return nil
end

--[[ v71 money (M1): the Starter Pack offer gate. TutorialService schedules it (StarterBundleOffer.AfterTutorialSeconds
	after the tutorial completes, finished or skipped, or DelaySeconds after load when it is already done); this
	sends it, once per profile (StarterBundleOffered). Returns true when the offer was sent, false when the session
	soft-offer slot is busy (the caller may retry later), nil when it is not wanted (Id 0, no profile, tutorial not
	complete, already offered or owned). May yield once (the ownership lookup on a cold pass cache). ]]
function MonetizationService.TrySoftOfferStarterBundle(player: Player, reason: string?): boolean?
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player.Parent or not DataService then
		return nil
	end
	local bundle = starterBundleLive()
	local profile = DataService.GetProfile(player)
	if not bundle or not profile or profile.StarterBundleOffered == true or profile.TutorialComplete ~= true then
		return nil
	end
	if MonetizationService.PlayerOwnsEntitlement(player, "StarterBundle") then
		return nil
	end
	-- the lookup may have yielded
	if not player.Parent or DataService.GetProfile(player) ~= profile or profile.StarterBundleOffered == true then
		return nil
	end
	if not MonetizationService.ClaimSoftOfferSlot(player) then
		return false
	end
	profile.StarterBundleOffered = true
	DataService.MarkDirty(player)
	if RemoteSetup then
		local remote = RemoteSetup.Get(Constants.RemoteNames.StarterBundleOffer)
		if remote and remote:IsA("RemoteEvent") then
			(remote :: RemoteEvent):FireClient(player, {
				ProductKey = "StarterBundle",
				ProductId = bundle.Id,
				DisplayName = bundle.DisplayName or "Starter Pack",
				RobuxPrice = bundle.RobuxPrice,
				Reason = if typeof(reason) == "string" then reason else "session",
			})
		end
	end
	-- (no companion Info line: the client offer toast carries the offer — HUD v70 spec §4.2)
	return true
end

--[[ v71 money (M1, D2): players who bought the old 249 R$ Starter Bundle get Auto Collect once. Only onto a
	persistent profile (a session-only one would lose both the grant and the flag). Runs after the pass cache
	is filled, so the ownership check does not yield. ]]
local function applyStarterGoodwill(player: Player, profile: any)
	local cfg = (MonetizationConfig :: any).StarterGoodwill
	if typeof(cfg) ~= "table" or cfg.Enabled ~= true then
		return
	end
	local flag, need, grant = cfg.Flag, cfg.IfEntitlement, cfg.GrantEntitlement
	if typeof(flag) ~= "string" or typeof(need) ~= "string" or typeof(grant) ~= "string" then
		return
	end
	if typeof(profile) ~= "table" or typeof(profile.Entitlements) ~= "table" then
		return
	end
	local ents = profile.Entitlements
	if ents[need] ~= true or ents[flag] == true then
		return
	end
	if DataService.IsLoaded and not DataService.IsLoaded(player) then
		return
	end
	if DataService.GetProfile(player) ~= profile then
		return
	end
	local alreadyOwned = MonetizationService.PlayerOwnsEntitlement(player, grant)
	ents[flag] = true
	if not alreadyOwned then
		MonetizationService.GrantEntitlement(player, grant) -- marks the profile dirty
		if NotificationService then
			NotificationService.Notify(player, "Thank you, Commander! Your Starter Pack now includes Auto Collect.", "Reward")
		end
	end
	DataService.MarkDirty(player)
end

function MonetizationService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	BattlePassService = deps.BattlePassService
	BaseService = deps.BaseService
	SoldierService = deps.SoldierService

	MarketplaceService.ProcessReceipt = function(receiptInfo)
		return MonetizationService.ProcessReceipt(receiptInfo)
	end

	-- Client may fire to log intent; grants still ONLY happen in ProcessReceipt
	local shopRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseDevProduct) :: RemoteEvent
	-- v71 money (M1): optional 2nd arg `source` (where the prompt came from), whitelisted; analytics only
	shopRemote.OnServerEvent:Connect(function(player: Player, productKey: any, rawSource: any)
		if not RateLimitService.Allow(player, "shop_prompt", 2, 3) then
			return
		end
		-- Intent-only: never grants currency. Still validate + require profile loaded.
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsKeyString(productKey) then
			return
		end
		local def = findDevProductByKey(productKey :: string)
		if not def then
			return
		end
		local source = cleanSource(rawSource)
		rememberIntent(player, "DP:" .. (productKey :: string), source)
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.SHOP_PROMPT, player.UserId, {
				kind = "DevProduct",
				key = productKey,
				productId = def.Id,
				source = source,
			})
		end
		if def.Id == 0 and NotificationService then
			NotificationService.Notify(player, "Shop item not configured (placeholder ID).", "Warn")
		end
		-- Do NOT grant here. Client prompts Marketplace; ProcessReceipt grants.
	end)

	local passRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseGamePass) :: RemoteEvent
	passRemote.OnServerEvent:Connect(function(player: Player, passKey: any, rawSource: any)
		if not RateLimitService.Allow(player, "shop_pass_prompt", 2, 3) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		if not RemoteGuard.IsKeyString(passKey) then
			return
		end
		local def = findGamePassByKey(passKey :: string)
		if not def then
			return
		end
		local source = cleanSource(rawSource)
		rememberIntent(player, "GP:" .. (passKey :: string), source)
		if AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.SHOP_PROMPT, player.UserId, {
				kind = "GamePass",
				key = passKey,
				productId = def.Id,
				source = source,
			})
		end
		if def.Id == 0 and NotificationService then
			NotificationService.Notify(player, "GamePass not configured (placeholder ID).", "Warn")
		end
		-- Do NOT grant benefits from this remote — ownership cache only.
	end)

	-- Re-check ownership when a GamePass prompt reports a purchase (the signal itself is untrusted for grants)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, wasPurchased: boolean)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return
		end
		local passKey: string? = nil
		local passName = "Game Pass"
		if typeof(passId) == "number" and passId ~= 0 then
			for key, def in pairs(MonetizationConfig.GamePasses) do
				if def.Id ~= 0 and def.Id == passId then
					passKey = key
					passName = tostring(def.DisplayName or key)
					break
				end
			end
		end
		-- v70: wasPurchased is only the prompt's GUI state and exploit clients have been able to fire this event
		-- (Roblox: use receipts for purchases). A pass counts as owned only once UserOwnsGamePassAsync confirms
		-- it; that check can lag right after an in-game purchase, so it is repeated a few times.
		if wasPurchased == true and passKey ~= nil then
			confirmPassPurchase(player, passKey, passId, passName)
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		sessionStartAt[player.UserId] = os.clock() -- v71 money (M1): tutorial quiet window
		task.spawn(function()
			MonetizationService.RefreshGamePassCache(player)
			if not player.Parent then
				return
			end
			-- Rehydrate session cache from persisted Entitlements
			if typeof(profile) == "table" and typeof(profile.Entitlements) == "table" then
				local cache = gamePassCache[player.UserId] or {}
				for k, v in pairs(profile.Entitlements) do
					if v == true then
						cache[k] = true
						setEntitlementAttr(player, k) -- v70: Shop shows OWNED (display only)
					end
				end
				gamePassCache[player.UserId] = cache
			end
			-- F8: the character can spawn before the pass cache and the profile are ready; apply the speed now
			applySpeedBoostToCharacter(player)

			-- v71 money (M1): display-only counter attributes (e.g. WE_Nukes); never read back by the server
			local counterSpecs = (MonetizationConfig :: any).CounterGrants
			if typeof(counterSpecs) == "table" and typeof(profile) == "table" then
				for _, spec in pairs(counterSpecs) do
					if typeof(spec) == "table" and typeof(spec.Field) == "string" and typeof(spec.Attribute) == "string" then
						pcall(function()
							player:SetAttribute(spec.Attribute, nonNegInt(profile[spec.Field]))
						end)
					end
				end
			end

			-- v71 money (M1, D2): Auto Collect for old Starter Bundle buyers (once)
			applyStarterGoodwill(player, profile)

			-- v32 one-shot StarterBundle offer at load: v71 money (M1) moved it off the join. TutorialService now
			-- schedules it after the tutorial (or at load when the tutorial is already done) and sends it through
			-- MonetizationService.TrySoftOfferStarterBundle (StarterBundleOffered gate).
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		gamePassCache[player.UserId] = nil
		lastSoftOfferAt[player.UserId] = nil
		passRefreshRetries[player.UserId] = nil
		-- v71 money (M1)
		passCacheFilled[player.UserId] = nil
		softOffersClaimed[player.UserId] = nil
		sessionStartAt[player.UserId] = nil
		purchaseIntents[player.UserId] = nil
		deathSpeedSent[player.UserId] = nil -- F8: the next session may get one death offer again
	end)

	-- F8: a speed pass that flips to owned (the join check, a retried check or a confirmed purchase) applies at once
	MonetizationService.OnPassOwned(function(player: Player, passKey: string)
		if player.Parent and isSpeedKey(passKey) then
			applySpeedBoostToCharacter(player)
		end
	end)

	-- Re-apply SpeedBoost WalkSpeed on respawn. v71 money (M1): the v36 spawn ("walk_speed") Speed Boost pop-up is
	-- gone (it raced the Starter offer; SpeedBoostOffer.IgnoreReasons). F8: SpeedMultFor (Speed Pass or Speed Boost,
	-- the higher one); it reads the session cache only, so a respawn never waits on a Roblox ownership call.
	local function hookSpeed(player: Player)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				task.wait(0.3)
				if player.Parent then
					applySpeedBoostToCharacter(player)
				end
			end)
		end)
		if player.Character then
			task.defer(function()
				applySpeedBoostToCharacter(player)
			end)
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hookSpeed(p)
	end
	Players.PlayerAdded:Connect(hookSpeed)
end

local function battlePassReady(): boolean
	local bp = BattlePassService
	return bp ~= nil and typeof(bp.IsReady) == "function" and bp.IsReady() == true
end

-- v71 money (M1): GrantEntitlement + GrantEntitlements, each key once, in order
local function entitlementList(product: any): { string }
	local list: { string } = {}
	local seen: { [string]: boolean } = {}
	local function add(k: any)
		if typeof(k) == "string" and k ~= "" and not seen[k] then
			seen[k] = true
			table.insert(list, k)
		end
	end
	add(product.GrantEntitlement)
	if typeof(product.GrantEntitlements) == "table" then
		for _, k in ipairs(product.GrantEntitlements) do
			add(k)
		end
	end
	return list
end

type CounterGrant = { Field: string, Spec: any, N: number }

-- v71 money (M1): only product fields whitelisted in MonetizationConfig.CounterGrants add to a profile number
local function counterGrantList(product: any): { CounterGrant }
	local out: { CounterGrant } = {}
	local specs = (MonetizationConfig :: any).CounterGrants
	if typeof(specs) ~= "table" then
		return out
	end
	for grantField, spec in pairs(specs) do
		if typeof(grantField) == "string" and typeof(spec) == "table" and typeof(spec.Field) == "string" then
			local n = nonNegInt(product[grantField])
			local cap = tonumber(spec.MaxPerReceipt)
			if cap then
				n = math.min(n, nonNegInt(cap))
			end
			if n > 0 then
				table.insert(out, { Field = spec.Field, Spec = spec, N = n })
			end
		end
	end
	table.sort(out, function(a, b)
		return a.Field < b.Field
	end)
	return out
end

-- Mutates the in-memory profile only (no yield); the attribute is display-only
local function applyCounterGrant(player: Player, profile: any, c: CounterGrant)
	profile[c.Field] = math.min(nonNegInt(profile[c.Field]) + c.N, MAX_COUNTER)
	local stats = c.Spec.Stats
	if typeof(stats) == "table" and typeof(stats.Table) == "string" and typeof(stats.Key) == "string" then
		local t = profile[stats.Table]
		if typeof(t) ~= "table" then
			t = {}
			profile[stats.Table] = t
		end
		t[stats.Key] = math.min(nonNegInt(t[stats.Key]) + c.N, MAX_COUNTER)
	end
	if typeof(c.Spec.Attribute) == "string" then
		pcall(function()
			player:SetAttribute(c.Spec.Attribute, profile[c.Field])
		end)
	end
end

local function rememberPendingGrant(receiptId: string, event: GrantEvent)
	local now = os.clock()
	for id, e in pairs(pendingGrantEvents) do
		if now - e.At > PENDING_GRANT_TTL_SECONDS then
			pendingGrantEvents[id] = nil
		end
	end
	pendingGrantEvents[receiptId] = event
end

--[[ v71 money (M1): everything that must only happen once a grant is SAVED: the toast, PURCHASE_RECEIPT (with
	CurrencySpent + source), FIRST_PURCHASE, the Roblox economy events and the OnGranted listeners. Nothing here can
	change the receipt decision (listeners and economy events are deferred + pcall'd). ]]
local function afterGrantSaved(player: Player, profile: any, event: GrantEvent)
	if NotificationService then
		NotificationService.Notify(player, "Purchase granted: " .. event.DisplayName, "Reward")
	end
	if AnalyticsService then
		local firstJoin = if typeof(profile) == "table" then nonNegInt(profile.FirstJoinUnix) else 0
		AnalyticsService.Log(AnalyticsConfig.Events.PURCHASE_RECEIPT, player.UserId, {
			productId = event.ProductId,
			productKey = event.ProductKey,
			receiptId = event.ReceiptId,
			currencySpent = event.CurrencySpent,
			source = event.Source,
			firstPurchase = event.FirstPurchase,
			daysSinceFirstJoin = if firstJoin > 0 then math.max(0, math.floor((os.time() - firstJoin) / 86400)) else nil,
			level = if typeof(profile) == "table" then profile.Level else nil,
			prestige = if typeof(profile) == "table" then profile.Prestige else nil,
		})
	end
	if event.FirstPurchase then
		logFirstPurchase(player, profile, event.ProductKey)
	end
	if typeof(profile) == "table" then
		logEconomySource(player, "Cash", event.Cash, nonNegInt(profile.Cash), event.ProductKey)
		logEconomySource(player, "Gold", event.Gold, nonNegInt(profile.Gold), event.ProductKey)
		local specs = (MonetizationConfig :: any).CounterGrants
		for field, n in pairs(event.Counters) do
			local currency: string? = nil
			if typeof(specs) == "table" then
				for _, spec in pairs(specs) do
					if typeof(spec) == "table" and spec.Field == field and typeof(spec.Currency) == "string" then
						currency = spec.Currency
					end
				end
			end
			if currency then
				logEconomySource(player, currency, n, nonNegInt(profile[field]), event.ProductKey)
			end
		end
	end
	-- listeners share one event: read-only, so one listener cannot change what the next one sees
	for _, t: any in ipairs({ event.Counters :: any, event.Entitlements :: any, event :: any }) do
		if not table.isfrozen(t) then
			table.freeze(t)
		end
	end
	for _, fn in ipairs(table.clone(grantListeners)) do
		task.defer(runListener, "OnGranted", fn, player, event.ProductKey, event)
	end
end

local function processReceipt(receiptInfo: any, receiptId: string): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- v70: Battle Pass Premium needs BattlePassService, which Bootstrap initialises after the map build. A
	-- receipt delivered earlier waits for it; if it is still not up, Roblox re-delivers the receipt later.
	do
		local _, earlyProduct = findDevProduct(receiptInfo.ProductId)
		if earlyProduct and earlyProduct.GrantsBattlePassPremium == true and not battlePassReady() then
			local deadline = os.clock() + BATTLE_PASS_READY_WAIT_SECONDS
			while not battlePassReady() and os.clock() < deadline and player.Parent do
				task.wait(0.25)
			end
			if not battlePassReady() or not player.Parent then
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
		end
	end

	-- v70: 25 s — the load can first wait up to 12 s for the previous server's session lock (SessionLock)
	local profile = DataService.WaitForProfile(player, 25)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- v67: only grant onto a profile that was read from the DataStore and will be saved. A session-only
	-- profile (store read failed) would lose the grant; Roblox re-delivers NotProcessedYet receipts.
	if DataService.IsLoaded and not DataService.IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if hasProcessed(profile, receiptId) then
		-- v70: granted into this profile earlier, but that save may have failed — the ack still waits for a save
		if not processed[receiptId] then
			if not DataService.SaveProfile(player, false) then
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			processed[receiptId] = true
			-- v71 money (M1): a grant applied earlier this session whose save failed is saved only now
			local pending = pendingGrantEvents[receiptId]
			if pending then
				pendingGrantEvents[receiptId] = nil
				afterGrantSaved(player, profile, pending)
			end
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local productKey, product = findDevProduct(receiptInfo.ProductId)
	if not product then
		-- v71 money (J2): an unknown Id is never acknowledged. Acking it ("drain the queue") took the Robux and
		-- granted nothing when a receipt for a newly pasted Id reached a server still on the old version. Roblox
		-- keeps retrying; once every server runs the version with the Id (Migrate to Latest Update) it is granted.
		-- Nothing is marked or saved here.
		warn(
			"[MonetizationService] Unknown product Id — receipt NOT acknowledged (Roblox retries it):",
			receiptInfo.ProductId,
			receiptId
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	--[[ v71 money (J2): everything above may yield (Battle Pass readiness, the profile load). Any ownership lookup
		a grant needs (UserOwnsGamePassAsync via PlayerOwnsGamePass / PlayerOwnsEntitlement) belongs HERE, before
		the first grant mutation. From the first mutation below to markProcessed nothing may yield: the grants
		(SetPremium, AddCash / AddGold with the multiplier-exempt "devproduct" reason, GrantEntitlement) only
		mutate the in-memory profile and defer their follow-ups. ]]
	-- v71 money (M1): the whole grant is computed here, before any mutation. StarterFallbackCash: a buyer who
	-- already owns Auto Collect gets that much more Cash (the Auto Collect grant would add nothing).
	local cashGrant = nonNegInt(product.Cash)
	local fallbackCash = nonNegInt(product.StarterFallbackCash)
	if fallbackCash > 0 then
		if MonetizationService.PlayerOwnsEntitlement(player, "AutoCollect") then
			cashGrant += fallbackCash
		end
		-- that lookup can yield (first pass-cache fill): the player and the profile must still be the live ones
		if not player.Parent or DataService.GetProfile(player) ~= profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	local goldGrant = nonNegInt(product.Gold)
	local entitlements = entitlementList(product)
	local counters = counterGrantList(product)
	local event: GrantEvent = {
		ProductKey = productKey :: string,
		ProductId = receiptInfo.ProductId,
		ReceiptId = receiptId,
		DisplayName = tostring(product.DisplayName or productKey or "item"),
		Cash = cashGrant,
		Gold = goldGrant,
		Entitlements = entitlements,
		Counters = {},
		CurrencySpent = nonNegInt(receiptInfo.CurrencySpent),
		Source = intentSource(player.UserId, "DP:" .. (productKey :: string)),
		FirstPurchase = false,
		At = os.clock(),
	}

	-- Battle Pass Premium: server-only via ProcessReceipt (never client confirmation). First, so a failure
	-- returns before any other grant is applied.
	if product.GrantsBattlePassPremium == true then
		if not battlePassReady() or BattlePassService.SetPremium(player, true) ~= true then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	if cashGrant > 0 then
		EconomyService.AddCash(player, cashGrant, "devproduct")
	end
	if goldGrant > 0 then
		EconomyService.AddGold(player, goldGrant, "devproduct")
	end
	-- DevProduct entitlement flags (AutoCollect / DoubleCash / VIP / StarterBundle + AutoCollect / etc.)
	for _, ent in ipairs(entitlements) do
		MonetizationService.GrantEntitlement(player, ent)
	end
	-- v71 money (M1): whitelisted counters (GrantNukes -> profile.Nukes + NukeStats.Bought)
	for _, c in ipairs(counters) do
		applyCounterGrant(player, profile, c)
		event.Counters[c.Field] = (event.Counters[c.Field] or 0) + c.N
	end
	-- v71 money (M1): accounting (exact Robux from the receipt); saved together with the grant
	event.FirstPurchase = recordPurchase(profile, event.CurrencySpent)

	markProcessed(profile, receiptId)
	DataService.MarkDirty(player)
	-- v67: persist the grant before acknowledging it. If the save fails, Roblox retries the receipt;
	-- ProcessedReceipts (still in memory this session) stops a double grant on the retry.
	if not DataService.SaveProfile(player, false) then
		rememberPendingGrant(receiptId, event) -- v71 money (M1): its post-save work runs when a retry saves it
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	processed[receiptId] = true
	pendingGrantEvents[receiptId] = nil

	afterGrantSaved(player, profile, event)

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--[[ Roblox MarketplaceService.ProcessReceipt callback (wired in Init). v71 money (J2): one run per PurchaseId at a
	time; an error inside is answered NotProcessedYet (Roblox retries) and always releases the in-flight lock. ]]
function MonetizationService.ProcessReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local receiptId = tostring(if typeof(receiptInfo) == "table" then receiptInfo.PurchaseId else nil)
	if receiptsInFlight[receiptId] then
		warn("[MonetizationService] Receipt already being processed — NotProcessedYet (Roblox retries):", receiptId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	receiptsInFlight[receiptId] = true
	local ok, decision = pcall(processReceipt, receiptInfo, receiptId)
	receiptsInFlight[receiptId] = nil
	if not ok then
		warn("[MonetizationService] ProcessReceipt error — NotProcessedYet (Roblox retries):", receiptId, decision)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return decision
end


--[[ v35: one-shot VIP soft toast at mid-game (level≥MinLevel OR structure≥MinStructureLevel). ]]
function MonetizationService.TrySoftOfferVIP(player: Player, reason: string?)
	if not player or not player.Parent then
		return
	end
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.VIPOffered == true then
		return
	end
	local gp = MonetizationConfig.GamePasses and MonetizationConfig.GamePasses.VIP
	if not gp or typeof(gp.Id) ~= "number" or gp.Id == 0 then
		return
	end
	if MonetizationService.PlayerOwnsGamePass(player, "VIP") then
		return
	end
	local offerCfg = (MonetizationConfig :: any).VIPOffer
	if not offerCfg then
		return
	end
	local minLevel = tonumber(offerCfg.MinLevel) or 10
	local minStruct = tonumber(offerCfg.MinStructureLevel) or 3
	local level = tonumber(profile.Level) or 1
	local maxStruct = 0
	if typeof(profile.BaseUpgrades) == "table" then
		for _, lv in pairs(profile.BaseUpgrades) do
			local n = tonumber(lv) or 0
			if n > maxStruct then
				maxStruct = n
			end
		end
	end
	if level < minLevel and maxStruct < minStruct then
		return
	end
	if not MonetizationService.ClaimSoftOfferSlot(player) then
		return
	end
	profile.VIPOffered = true
	DataService.MarkDirty(player)
	local delaySec = tonumber(offerCfg.DelaySeconds) or 2.0
	task.delay(delaySec, function()
		if not player.Parent then
			return
		end
		if MonetizationService.PlayerOwnsGamePass(player, "VIP") then
			return
		end
		if RemoteSetup then
			local remote = RemoteSetup.Get(Constants.RemoteNames.VIPOffer)
			if remote and remote:IsA("RemoteEvent") then
				(remote :: RemoteEvent):FireClient(player, {
					ProductKey = "VIP",
					GamePassId = gp.Id,
					DisplayName = gp.DisplayName or "VIP",
					RobuxPrice = gp.RobuxPrice,
					Reason = reason or "midgame",
				})
			end
		end
		-- (no companion Info line: the client offer toast carries the offer — HUD v70 spec §4.2)
	end)
end



--[[ v36: one-shot SpeedBoost soft toast after first jeep sit / walk-speed moment (existing DevProduct Id). ]]
function MonetizationService.TrySoftOfferSpeedBoost(player: Player, reason: string?)
	if not player or not player.Parent then
		return
	end
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.SpeedBoostOffered == true then
		return
	end
	-- v71 money (M1): the spawn / first-vehicle-sit triggers are ignored (they raced the Starter offer)
	do
		local cfg = (MonetizationConfig :: any).SpeedBoostOffer
		local ignore = cfg and cfg.IgnoreReasons
		if typeof(ignore) == "table" and ignore[reason or "vehicle_sit"] == true then
			return
		end
	end
	local dp = MonetizationConfig.DevProducts and MonetizationConfig.DevProducts.SpeedBoost
	if not dp or typeof(dp.Id) ~= "number" or dp.Id == 0 then
		return
	end
	if MonetizationService.PlayerOwnsEntitlement(player, "SpeedBoost") then
		return
	end
	local offerCfg = (MonetizationConfig :: any).SpeedBoostOffer
	if not offerCfg then
		return
	end
	if not MonetizationService.ClaimSoftOfferSlot(player) then
		return
	end
	profile.SpeedBoostOffered = true
	DataService.MarkDirty(player)
	local delaySec = tonumber(offerCfg.DelaySeconds) or 1.5
	task.delay(delaySec, function()
		if not player.Parent then
			return
		end
		if MonetizationService.PlayerOwnsEntitlement(player, "SpeedBoost") then
			return
		end
		if RemoteSetup then
			local remote = RemoteSetup.Get(Constants.RemoteNames.SpeedBoostOffer)
			if remote and remote:IsA("RemoteEvent") then
				(remote :: RemoteEvent):FireClient(player, {
					ProductKey = "SpeedBoost",
					ProductId = dp.Id,
					DisplayName = dp.DisplayName or "Speed Boost",
					RobuxPrice = dp.RobuxPrice,
					Reason = reason or "vehicle_sit",
				})
			end
		end
		-- (no companion Info line: the client offer toast carries the offer — HUD v70 spec §4.2)
	end)
end


--[[ v37: one-shot CashMega soft toast after high pending collect OR death path (existing DevProduct Id only). ]]
function MonetizationService.TrySoftOfferCashMega(player: Player, reason: string?, grantedOrPending: number?)
	if not player or not player.Parent then
		return
	end
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.CashMegaOffered == true then
		return
	end
	-- v71 money (M1): no Cash Mega pop-up on a PvP death (CashMegaOffer.IgnoreReasons)
	do
		local cfg = (MonetizationConfig :: any).CashMegaOffer
		local ignore = cfg and cfg.IgnoreReasons
		if typeof(ignore) == "table" and ignore[reason or "pending_collect"] == true then
			return
		end
	end
	local dp = MonetizationConfig.DevProducts and MonetizationConfig.DevProducts.CashMega
	if not dp or typeof(dp.Id) ~= "number" or dp.Id == 0 then
		return
	end
	local offerCfg = (MonetizationConfig :: any).CashMegaOffer
	if not offerCfg then
		return
	end
	local minNeed = tonumber(offerCfg.MinPendingCollect) or 15000
	local amt = tonumber(grantedOrPending) or 0
	-- Death path bypasses amount threshold; collect path requires high amount
	if reason ~= "death" and amt < minNeed then
		return
	end
	if not MonetizationService.ClaimSoftOfferSlot(player) then
		return
	end
	profile.CashMegaOffered = true
	DataService.MarkDirty(player)
	local delaySec = tonumber(offerCfg.DelaySeconds) or 1.8
	task.delay(delaySec, function()
		if not player.Parent then
			return
		end
		if RemoteSetup then
			local remote = RemoteSetup.Get(Constants.RemoteNames.CashMegaOffer)
			if remote and remote:IsA("RemoteEvent") then
				(remote :: RemoteEvent):FireClient(player, {
					ProductKey = "CashMega",
					ProductId = dp.Id,
					DisplayName = dp.DisplayName or "Cash Pack Mega",
					RobuxPrice = dp.RobuxPrice,
					Reason = reason or "pending_collect",
				})
			end
		end
		-- (no companion Info line: the client offer toast carries the offer — HUD v70 spec §4.2)
	end)
end

--[[ F8 (owner's 11 features): the ONE offer allowed after a death (MonetizationConfig.DeathSpeedOffer; DeathShopOffers
	stays empty, so there is still no 2x Cash / Cash Mega death offer). CombatService calls it in a pcall after a PvP
	death that was not a blast. Sends DeathShopOffer { Offers = { PassKey } } only when ALL of these hold:
	  - the pass Id is not 0 (nothing is offered or prompted while it is 0);
	  - the tutorial is complete (RequireTutorialComplete);
	  - it is the first send this session (OncePerSession; deathSpeedSent, cleared on PlayerRemoving);
	  - ownership is KNOWN (the join check has run and no failed check is waiting for a retry) and the victim owns
	    none of SkipIfOwnsAny (Speed Pass or Speed Boost);
	  - a D8 soft-offer slot is free (ClaimSoftOfferSlot, claimed last so a refused offer never spends one).
	Never yields. Returns true when the offer was sent. The client still refuses it for an owner (WE_Ent_*). ]]
function MonetizationService.TryDeathSpeedOffer(victim: Player): boolean
	if typeof(victim) ~= "Instance" or not victim:IsA("Player") or not victim.Parent or not DataService then
		return false
	end
	local cfg = (MonetizationConfig :: any).DeathSpeedOffer
	if typeof(cfg) ~= "table" or typeof(cfg.PassKey) ~= "string" then
		return false
	end
	local passKey: string = cfg.PassKey
	local pass = (MonetizationConfig.GamePasses :: any)[passKey]
	if typeof(pass) ~= "table" or typeof(pass.Id) ~= "number" or pass.Id == 0 then
		return false
	end
	local userId = victim.UserId
	if cfg.OncePerSession ~= false and deathSpeedSent[userId] == true then
		return false
	end
	local profile = DataService.GetProfile(victim)
	if not profile then
		return false
	end
	if cfg.RequireTutorialComplete ~= false and profile.TutorialComplete ~= true then
		return false
	end
	-- unknown ownership is never "not owned": no offer until the join check has run without a pending retry
	if passCacheFilled[userId] ~= true or passRefreshRetries[userId] ~= nil then
		return false
	end
	if ownsSkuCached(victim, passKey) then
		return false
	end
	if typeof(cfg.SkipIfOwnsAny) == "table" then
		for _, key in ipairs(cfg.SkipIfOwnsAny) do
			if typeof(key) == "string" and ownsSkuCached(victim, key) then
				return false
			end
		end
	end
	if not MonetizationService.ClaimSoftOfferSlot(victim) then
		return false
	end
	deathSpeedSent[userId] = true
	if RemoteSetup then
		local remote = RemoteSetup.Get(Constants.RemoteNames.DeathShopOffer)
		if remote and remote:IsA("RemoteEvent") then
			(remote :: RemoteEvent):FireClient(victim, { Offers = { passKey } })
		end
	end
	return true
end


return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">MoneyCollectorService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Money Collector — passive income accrues to PendingCash until the player
	touches their plot's WE_MoneyCollector (or owns AutoCollect entitlement).
	Server-authoritative only.

	v69 ATM raids (RaidConfig.Raid, owner rule): stand at another player's ATM — inside their base — for
	HoldSeconds, on foot, alive and without taking damage, to steal 10% of their ATM balance into your own ATM.
	The victim is then shielded for 10 minutes (profile.Raid.ShieldUntil) and the thief waits a minute
	(profile.Raid.RaidCooldownUntil); both are os.time() values on the saved profile, so leaving / rejoining /
	server hopping does not reset them. The hold runs on the server's view of the character (StepRaids) —
	there is no raid remote. Defenses are physical: any damage cancels the hold (GateDefenseService guards /
	AutoGuns, or the owner shooting back).

	v71 (HUD v70 spec §4.2 / §5): no floating ATM card — the ATM's own screen (WE_ATMScreen) carries the balance
	and a status line, the lime CollectCircle is the "stand here" cue. A collect is a "+$N" float at the cash pill
	(Notification type Collect + Amount, no lane line); walking over the ATM is silent for AutoCollect owners. No
	upsell companion lines (the client's offer toast carries the offer). A raid victim gets one Error line plus a
	red spend float (the HUD shield chip reads WE_ShieldUntil); the thief gets a Success line plus a float.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local RaidConfig = require(Shared.Configs.RaidConfig)
local CombatFairnessConfig = require(Shared.Configs.CombatFairnessConfig) -- P0-6 new-thief protection
local TycoonMath = require(Shared.Util.TycoonMath) -- F4 ATM screen: ShortCash digits, "+$24/s" rate
local ServerModules = script.Parent.Parent.Modules
local RemoteSetup = require(ServerModules.RemoteSetup)

local MoneyCollectorService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local MonetizationService: any = nil
local TutorialService: any = nil
local RateLimitService: any = nil
-- v69: Init runs before these services' own Init (Bootstrap order) — only called from heartbeat / handlers
local BaseService: any = nil
local ClanService: any = nil
local GateDefenseService: any = nil
local AnalyticsService: any = nil

local TAG = Constants.Tags.MoneyCollector
local OVERLAP_MARGIN = 3.5
local COLLECT_RADIUS = 10 -- horizontal studs from ATM body (covers CollectCircle pad)
local SPATIAL_INTERVAL = 0.25
local MAX_RAID_STEP = 0.5 -- a server hitch never advances a raid hold by more than this per tick
local AUTO_COLLECT_INTERVAL = 2.0
local emptyCollectToastAt: { [number]: number } = {}

local lastOverlap: { [string]: boolean } = {}
local attached: { [BasePart]: boolean } = {}

type RaidHold = {
	VictimUserId: number,
	VictimName: string,
	PlotId: number,
	Part: BasePart,
	Progress: number,
	LastHealth: number,
	LastPushAt: number,
	LastAlarmAt: number,
	StartedAt: number,
	Hrp: BasePart,
}

type IncomeEntry = { t: number, amount: number }

-- thiefUserId → running hold (memory only; a hold never survives the thief leaving)
local holds: { [number]: RaidHold } = {}
-- thiefUserId → last Blocked reason pushed (throttle, spec §1.7)
local blockedPush: { [number]: { Reason: string, At: number } } = {}
-- teleport guard (spec §1.8), all os.clock
local lastPos: { [number]: Vector3 } = {}
local lastHrp: { [number]: BasePart } = {}
local teleportLockUntil: { [number]: number } = {}
-- AutoCollect income of the last AutoCollectWindowSeconds (memory only, spec §1.5); os.time stamps
local recentAuto: { [number]: { IncomeEntry } } = {}
-- non-yielding "owns AutoCollect" flag, refreshed by the AutoCollect loop (entitlement checks can yield on a cold
-- game-pass cache; the raid path must never yield)
local autoCollectFlag: { [number]: boolean } = {}

local function hasAutoCollect(player: Player): boolean
	if MonetizationService and MonetizationService.PlayerOwnsEntitlement then
		if MonetizationService.PlayerOwnsEntitlement(player, "AutoCollect") then
			return true
		end
	end
	if MonetizationService and MonetizationService.PlayerOwnsGamePass then
		if MonetizationService.PlayerOwnsGamePass(player, "AutoCollect") then
			return true
		end
	end
	local profile = DataService.GetProfile(player)
	if profile and typeof(profile.Entitlements) == "table" and profile.Entitlements.AutoCollect == true then
		return true
	end
	return false
end

local function hasDoubleCash(player: Player): boolean
	if MonetizationService and MonetizationService.PlayerOwnsEntitlement then
		if MonetizationService.PlayerOwnsEntitlement(player, "DoubleCash") then
			return true
		end
	end
	if MonetizationService and MonetizationService.PlayerOwnsGamePass then
		if MonetizationService.PlayerOwnsGamePass(player, "DoubleCash") then
			return true
		end
	end
	local profile = DataService.GetProfile(player)
	if profile and typeof(profile.Entitlements) == "table" and profile.Entitlements.DoubleCash == true then
		return true
	end
	return false
end

-- ── small helpers ───────────────────────────────────────────────────────────

local function profileOf(player: Player): any
	if not DataService then
		return nil
	end
	return DataService.GetProfile(player)
end

-- v67 contract: true only for a save read from the DataStore (never for a session-only profile)
local function isLoaded(player: Player): boolean
	if not DataService then
		return false
	end
	if DataService.IsLoaded then
		return DataService.IsLoaded(player) == true
	end
	return DataService.GetProfile(player) ~= nil
end

local function markDirty(player: Player)
	if DataService and DataService.MarkDirty then
		DataService.MarkDirty(player)
	end
end

local function raidNum(profile: any, key: string): number
	local raid = profile and profile.Raid
	if typeof(raid) ~= "table" then
		return 0
	end
	return tonumber(raid[key]) or 0
end

local function raidOf(profile: any): { [string]: any }
	local raid = profile.Raid
	if typeof(raid) ~= "table" then
		raid = { ShieldUntil = 0, StrikeCooldownUntil = 0, DefensesDownUntil = 0 }
		profile.Raid = raid
	end
	return raid
end

local function formatCash(n: number): string
	local s = string.format("%d", math.floor(math.abs(n)))
	local out = (string.reverse(s):gsub("(%d%d%d)", "%1,"))
	out = string.reverse(out)
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (if n < 0 then "-" else "") .. out
end

local function plotIdOf(part: BasePart): number?
	local raw = part:GetAttribute("PlotId")
	if typeof(raw) == "number" then
		return raw
	end
	local n = tonumber(raw)
	if typeof(n) == "number" then
		return n
	end
	return nil
end

-- Server truth for plot ownership (BaseService); profile scan only when BaseService is missing.
local function ownerUserIdOfPlot(plotId: number): number?
	if BaseService and BaseService.GetOwnerUserId then
		local uid = BaseService.GetOwnerUserId(plotId)
		if typeof(uid) == "number" then
			return uid
		end
		return nil
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = profileOf(player)
		if profile and profile.BasePlotId == plotId then
			return player.UserId
		end
	end
	return nil
end

local function findOwnerByPlot(plotId: number): Player?
	local uid = ownerUserIdOfPlot(plotId)
	if uid == nil then
		return nil
	end
	return Players:GetPlayerByUserId(uid)
end

local function ownedPlotOf(player: Player): number?
	if BaseService and BaseService.GetOwnedPlotId then
		local pid = BaseService.GetOwnedPlotId(player)
		if typeof(pid) == "number" then
			return pid
		end
		return nil
	end
	local profile = profileOf(player)
	local pid = if profile then tonumber(profile.BasePlotId) else nil
	return pid
end

local function isAlly(ownerUserId: number, player: Player): boolean
	if player.UserId == ownerUserId then
		return true
	end
	if GateDefenseService and GateDefenseService.IsAlly then
		return GateDefenseService.IsAlly(ownerUserId, player) == true
	end
	-- Fallback (no GateDefenseService): same non-empty clan id
	if not (ClanService and ClanService.GetClanId) then
		return false
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not owner then
		return false
	end
	local okA, a = pcall(ClanService.GetClanId, owner)
	local okB, b = pcall(ClanService.GetClanId, player)
	return okA and okB and typeof(a) == "string" and a ~= "" and a == b
end

local function newPlayerSecondsLeft(profile: any): number
	local R = RaidConfig.Raid
	if RunService:IsStudio() and not R.ProtectNewPlayersInStudio then
		return 0
	end
	local first = tonumber(profile.FirstJoinUnix) or 0
	if first <= 0 then
		return 0
	end
	return math.max(0, first + R.NewPlayerProtectionSeconds - os.time())
end

--[[ P0-6 (mobile plan): mirror of the victim's protection for the THIEF — a player still in the tutorial, or inside
	their first CombatFairnessConfig.ThiefProtectMinutes, cannot rob an ATM (the tutorial's guide line must never
	turn into a raid on someone else's base). Returns (reason?, secondsLeft?). ]]
local function newThiefBlock(profile: any): (string?, number?)
	local C = CombatFairnessConfig
	if not C.ThiefProtectEnabled then
		return nil, nil
	end
	if RunService:IsStudio() and not C.ThiefProtectInStudio then
		return nil, nil
	end
	if C.ThiefRequireTutorialDone and profile.TutorialComplete ~= true then
		return "ThiefTutorial", nil
	end
	local first = tonumber(profile.FirstJoinUnix) or 0
	if first > 0 then
		local left = first + C.ThiefProtectMinutes * 60 - os.time()
		if left > 0 then
			return "ThiefNew", left
		end
	end
	return nil, nil
end

-- ── AutoCollect income window (spec §1.5) ──────────────────────────────────

local function pruneRecent(userId: number): { IncomeEntry }?
	local list = recentAuto[userId]
	if not list then
		return nil
	end
	local window = RaidConfig.Raid.AutoCollectWindowSeconds
	local nowUnix = os.time()
	local kept: { IncomeEntry } = {}
	for _, e in ipairs(list) do
		if nowUnix - e.t <= window then
			table.insert(kept, e)
		end
	end
	if #kept == 0 then
		recentAuto[userId] = nil
		return nil
	end
	recentAuto[userId] = kept
	return kept
end

local function recordAutoIncome(userId: number, amount: number)
	if amount <= 0 then
		return
	end
	local list = pruneRecent(userId) or {}
	table.insert(list, { t = os.time(), amount = math.floor(amount) })
	recentAuto[userId] = list
end

local function recentAutoSum(userId: number): number
	local list = pruneRecent(userId)
	if not list then
		return 0
	end
	local total = 0
	for _, e in ipairs(list) do
		total += e.amount
	end
	return total
end

-- What "10% of their ATM" is taken from: PendingCash, plus the last 10 min of auto-collected income for
-- AutoCollect owners (otherwise AutoCollect would be raid immunity — its loop empties the ATM every 2 s).
function MoneyCollectorService.GetRaidableBalance(victim: Player): number
	local profile = profileOf(victim)
	if not profile then
		return 0
	end
	local balance = math.max(0, math.floor(tonumber(profile.PendingCash) or 0))
	if RaidConfig.Raid.AutoCollectCountsRecentIncome and autoCollectFlag[victim.UserId] == true then
		-- capped at the Cash they still hold: auto income already spent cannot be stolen (completeRaid takes the
		-- rest out of Cash), so the ATM never shows / promises more than a raid can actually take
		local cash = math.max(0, math.floor(tonumber(profile.Cash) or 0))
		balance += math.min(recentAutoSum(victim.UserId), cash)
	end
	return balance
end

-- ── ATM screen (no floating card: spec §5 "WE_CollectorBillboard … REMOVE") ──────────────────────────────

-- v71: the old floating "ATM · WALK IN TO COLLECT" card (WE_CollectorBillboard: AlwaysOnTop, 100 studs, a card
-- with a backdrop) is gone. Remove one left by an older server build or a resetmap.
local function dropLegacyBillboard(part: BasePart)
	local oldBb = part:FindFirstChild("WE_CollectorBillboard")
	if oldBb then
		oldBb:Destroy()
	end
end

-- The status line sits on the painted ATM screen (MapSetup's WE_ATMScreen SurfaceGui): top third, the digits
-- below it. Built once per screen; later refreshes only write changed text.
local function ensureScreenStatus(sg: Instance, digits: TextLabel): TextLabel?
	local st = sg:FindFirstChild("Status")
	if st and st:IsA("TextLabel") then
		return st
	end
	digits.AnchorPoint = Vector2.new(0.5, 1)
	digits.Position = UDim2.fromScale(0.5, 1)
	digits.Size = UDim2.fromScale(1, 0.68)
	local lbl = Instance.new("TextLabel")
	lbl.Name = "Status"
	lbl.AnchorPoint = Vector2.new(0.5, 0)
	lbl.Position = UDim2.fromScale(0.5, 0)
	lbl.Size = UDim2.fromScale(1, 0.32)
	lbl.BackgroundColor3 = Color3.fromRGB(6, 26, 12)
	lbl.BackgroundTransparency = 0.1
	lbl.BorderSizePixel = 0
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.fromRGB(200, 230, 200)
	lbl.Text = ""
	lbl.Parent = sg
	return lbl
end

local function syncAtmScreen(part: BasePart, pending: number, title: string?)
	local folder = part.Parent
	if not folder then
		return
	end
	local screen = folder:FindFirstChild("CollectorScreen")
	if not (screen and screen:IsA("BasePart")) then
		return
	end
	local sg = screen:FindFirstChild("WE_ATMScreen")
	local digits = sg and sg:FindFirstChild("Digits")
	if sg and digits and digits:IsA("TextLabel") then
		-- F4: "$1,240" / "$25K" / "$1.9M" (TycoonMath.ShortCash, the same money format as the rest of the HUD)
		local text = TycoonMath.ShortCash(pending)
		if digits.Text ~= text then
			digits.Text = text
			digits.TextColor3 = if pending > 0 then Color3.fromRGB(70, 255, 120) else Color3.fromRGB(40, 120, 70)
		end
		if title then
			local st = ensureScreenStatus(sg, digits)
			if st and st.Text ~= title then
				st.Text = title
			end
		end
	end
	local light = part:FindFirstChild("ATMGlow")
	if light and light:IsA("PointLight") then
		light.Color = Color3.fromRGB(120, 255, 90)
		if pending >= 500 then
			light.Brightness = 1.4
			light.Range = 18
		elseif pending > 0 then
			light.Brightness = 0.9
			light.Range = 14
		else
			light.Brightness = 0.35
			light.Range = 10
		end
	end
end

local function isBeingRobbed(plotId: number): boolean
	for _, hold in pairs(holds) do
		if hold.PlotId == plotId then
			return true
		end
	end
	return false
end

-- F4: the fallback status (pinned) and the empty-ATM rate ("+$24/s" from the owner's server-stamped WE_IncomePerSec:
-- what the ATM really receives per second, multipliers in; only while it is > 0, else the fallback).
local ATM_WALK_IN_TITLE = "ATM · WALK IN TO COLLECT"

local function atmRateTitle(owner: Player): string?
	local ok, v = pcall(function()
		return owner:GetAttribute("WE_IncomePerSec")
	end)
	local rate = if ok then tonumber(v) else nil
	if rate == nil or rate ~= rate or rate <= 0 or rate == math.huge then
		return nil
	end
	return TycoonMath.RatePerSecText(rate)
end

-- ATM screen status line (raid spec §1.10; F4): shield > being robbed > AutoCollect > (cash waiting ? walk-in :
-- "+$24/s"). Painted on the ATM's own screen (v71), so it reads only up close and never floats over the HUD.
local function atmTitle(owner: Player?, plotId: number?, pending: number?): string
	if owner then
		local profile = profileOf(owner)
		local shield = raidNum(profile, "ShieldUntil")
		local nowUnix = os.time()
		if shield > nowUnix then
			return "ATM · SHIELD " .. RaidConfig.FormatTime(shield - nowUnix)
		end
		if plotId ~= nil and isBeingRobbed(plotId) then
			return "ATM BEING ROBBED!"
		end
		if autoCollectFlag[owner.UserId] == true then
			return "ATM · AUTO-COLLECT"
		end
		if pending ~= nil and pending <= 0 then
			local rateTitle = atmRateTitle(owner)
			if rateTitle then
				return rateTitle
			end
		end
	end
	return ATM_WALK_IN_TITLE
end

local function refreshBillboard(part: BasePart, pending: number, title: string?)
	syncAtmScreen(part, pending, title)
end

local function pointInPart(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	return math.abs(localPos.X) <= half.X + OVERLAP_MARGIN
		and math.abs(localPos.Z) <= half.Z + OVERLAP_MARGIN
		and localPos.Y >= -half.Y - 4
		and localPos.Y <= half.Y + 10
end

local function nearCollector(hrpPos: Vector3, part: BasePart): boolean
	-- Prefer generous ground radius so standing on CollectCircle / black base works
	local delta = hrpPos - part.Position
	local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude
	if horiz <= COLLECT_RADIUS then
		return math.abs(delta.Y) <= 14
	end
	return pointInPart(hrpPos, part)
end

-- Raid range: horizontal RadiusStuds and |dy| <= MaxHeightDelta from the ATM body
local function inRaidRange(hrpPos: Vector3, part: BasePart): boolean
	local R = RaidConfig.Raid
	local delta = hrpPos - part.Position
	return Vector3.new(delta.X, 0, delta.Z).Magnitude <= R.RadiusStuds and math.abs(delta.Y) <= R.MaxHeightDelta
end

-- ── raid feedback ──────────────────────────────────────────────────────────

local function pushAtmRaidState(player: Player, payload: { [string]: any })
	local remote = RemoteSetup.Get(Constants.RemoteNames.AtmRaidStateUpdate)
	if remote and remote:IsA("RemoteEvent") then
		(remote :: RemoteEvent):FireClient(player, payload)
	end
end

local function reasonText(reason: string, secs: number?, balance: number?): string
	local T = RaidConfig.Text
	if reason == "Hit" then
		return T.RaidHit
	elseif reason == "LeftRange" then
		return T.RaidLeft
	elseif reason == "VictimLeft" then
		return T.RaidVictimLeft
	elseif reason == "Emptied" then
		return T.RaidEmptied
	elseif reason == "Dead" then
		return T.RaidDead
	end
	if reason == "ThiefTutorial" then -- P0-6 (texts in CombatFairnessConfig; device-neutral)
		return CombatFairnessConfig.ThiefTutorialText
	elseif reason == "ThiefNew" then
		return string.format(CombatFairnessConfig.ThiefNewText, RaidConfig.FormatTime(secs or 0))
	end
	local tpl = T.Blocked[reason]
	if not tpl then
		return reason
	end
	if string.find(tpl, "%s", 1, true) then
		if reason == "LowBalance" then
			return string.format(tpl, formatCash(balance or 0))
		end
		return string.format(tpl, RaidConfig.FormatTime(secs or 0))
	end
	return tpl
end

-- CanRaid reason while a hold was running → the Interrupted reason the thief sees
local function interruptReason(reason: string): string
	if reason == "LowBalance" then
		return "Emptied"
	elseif reason == "VictimLoading" then
		return "VictimLeft"
	end
	return reason
end

-- Reasons shown as Phase "Interrupted"; any other cause of a cancel is shown as Phase "Blocked" with its code
local INTERRUPT_REASONS: { [string]: boolean } = { Hit = true, LeftRange = true, VictimLeft = true, Emptied = true, Dead = true }

local function holdingPayload(hold: RaidHold): { [string]: any }
	local need = RaidConfig.Raid.HoldSeconds
	local progress = math.min(hold.Progress, need)
	return {
		Phase = "Holding",
		VictimName = hold.VictimName,
		HoldProgress = math.floor(progress * 100 + 0.5) / 100,
		HoldNeed = need,
		Text = string.format(RaidConfig.Text.RaidHolding, hold.VictimName, progress, math.floor(need)),
	}
end

local function pushAlarm(victim: Player, thief: Player, hold: RaidHold, first: boolean)
	local need = RaidConfig.Raid.HoldSeconds
	local text = string.format(RaidConfig.Text.RaidAlarm, thief.DisplayName)
	hold.LastAlarmAt = os.clock()
	pushAtmRaidState(victim, {
		Phase = "Alarm",
		ThiefName = thief.DisplayName,
		HoldProgress = math.floor(math.min(hold.Progress, need) * 100 + 0.5) / 100,
		HoldNeed = need,
		Text = text,
	})
	if first and NotificationService and NotificationService.NotifyThrottled then
		NotificationService.NotifyThrottled(victim, text, "Warn", 4, RaidConfig.Raid.VictimAlarmToastCooldown, "atm_alarm")
	end
end

-- Blocked is re-sent only when the reason changes, or every BlockedPushInterval while standing at the ATM.
local function pushBlocked(thief: Player, victim: Player, reason: string, secs: number?, force: boolean?)
	local nowC = os.clock()
	local rec = blockedPush[thief.UserId]
	if not force and rec and rec.Reason == reason and nowC - rec.At < RaidConfig.Raid.BlockedPushInterval - 1e-6 then
		return
	end
	blockedPush[thief.UserId] = { Reason = reason, At = nowC }
	local balance = if reason == "LowBalance" then MoneyCollectorService.GetRaidableBalance(victim) else nil
	pushAtmRaidState(thief, {
		Phase = "Blocked",
		Reason = reason,
		VictimName = victim.DisplayName,
		CooldownRemaining = if secs then math.max(0, math.ceil(secs)) else nil,
		Text = reasonText(reason, secs, balance),
	})
end

local function clearHold(thief: Player): RaidHold?
	local hold = holds[thief.UserId]
	holds[thief.UserId] = nil
	pcall(function()
		thief:SetAttribute("WE_RaidingPlot", nil)
	end)
	return hold
end

--[[ Cancel a running hold. `reason` is a cancel reason (Hit / LeftRange / VictimLeft / Dead) or the CanRaid code
	that failed mid-hold (LowBalance shows as Emptied, VictimLoading as VictimLeft). Interrupt reasons push
	"Interrupted"; any other rule (Shielded, Seated, Teleport …) pushes "Blocked" with its code instead (one chip,
	not two). The victim gets "Defended" when the hold had reached >= 1 s — unless they were just robbed / left. ]]
local function cancelHold(thief: Player, reason: string, secs: number?, victim: Player?)
	local hold = clearHold(thief)
	if not hold then
		return
	end
	local shown = interruptReason(reason)
	if INTERRUPT_REASONS[shown] or victim == nil then
		pushAtmRaidState(thief, {
			Phase = "Interrupted",
			Reason = shown,
			VictimName = hold.VictimName,
			HoldProgress = math.floor(math.min(hold.Progress, RaidConfig.Raid.HoldSeconds) * 100 + 0.5) / 100,
			HoldNeed = RaidConfig.Raid.HoldSeconds,
			Text = reasonText(shown, secs),
		})
		-- the chip already says why: no Blocked push of the same cause right after it
		blockedPush[thief.UserId] = { Reason = reason, At = os.clock() }
	else
		pushBlocked(thief, victim, reason, secs, true)
	end
	if hold.Progress >= 1 and shown ~= "VictimLeft" then
		local owner = Players:GetPlayerByUserId(hold.VictimUserId)
		if owner and raidNum(profileOf(owner), "ShieldUntil") <= os.time() then
			pushAtmRaidState(owner, {
				Phase = "Defended",
				ThiefName = thief.DisplayName,
				Reason = shown,
				Text = RaidConfig.Text.RaidDefended,
			})
		end
	end
end

-- ── rules (spec §1.1) ──────────────────────────────────────────────────────

--[[ (ok, reason?, secondsLeft?) — first failure wins. reason nil = silent (own ATM). "Dead" / "VictimLeft" are
	cancel-only reasons (never pushed as Blocked). ]]
function MoneyCollectorService.CanRaid(thief: Player, victim: Player): (boolean, string?, number?)
	local R = RaidConfig.Raid
	if not R.Enabled then
		return false, "Disabled"
	end
	if victim == thief or victim.UserId == thief.UserId then
		return false, nil
	end
	if victim.Parent == nil or ownedPlotOf(victim) == nil then
		return false, "VictimLeft"
	end
	local tProfile = profileOf(thief)
	if not tProfile or not isLoaded(thief) then
		return false, "ThiefLoading"
	end
	-- a session-only save would create / destroy money: refuse until the real save is in
	local vProfile = profileOf(victim)
	if not vProfile or not isLoaded(victim) then
		return false, "VictimLoading"
	end
	if ownedPlotOf(thief) == nil then
		return false, "NoBase"
	end
	local thiefBlock, thiefLeft = newThiefBlock(tProfile)
	if thiefBlock then
		return false, thiefBlock, thiefLeft
	end
	if not R.AllowAllies and isAlly(victim.UserId, thief) then
		return false, "Ally"
	end
	local char = thief.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false, "Dead"
	end
	if R.RequireOnFoot and hum.SeatPart ~= nil then
		return false, "Seated"
	end
	local lock = teleportLockUntil[thief.UserId]
	if lock and os.clock() < lock then
		return false, "Teleport", math.ceil(lock - os.clock())
	end
	local nowUnix = os.time()
	local cd = raidNum(tProfile, "RaidCooldownUntil")
	if nowUnix < cd then
		return false, "ThiefCooldown", cd - nowUnix
	end
	local shield = raidNum(vProfile, "ShieldUntil")
	if nowUnix < shield then
		return false, "Shielded", shield - nowUnix
	end
	local newLeft = newPlayerSecondsLeft(vProfile)
	if newLeft > 0 then
		return false, "NewPlayer", newLeft
	end
	local balance = MoneyCollectorService.GetRaidableBalance(victim)
	if balance < R.MinVictimBalance or math.floor(balance * R.StealFraction) < R.MinSteal then
		return false, "LowBalance"
	end
	return true, nil, nil
end

function MoneyCollectorService.GetRaidHold(thief: Player): { VictimUserId: number, Progress: number }?
	local hold = holds[thief.UserId]
	if not hold then
		return nil
	end
	return { VictimUserId = hold.VictimUserId, Progress = hold.Progress }
end

-- ── steal (spec §1.4) — synchronous: nothing here may yield ─────────────────

local function completeRaid(thief: Player, victim: Player, hold: RaidHold): boolean
	local R = RaidConfig.Raid
	-- 1. re-validate at the moment of completion (a second thief finishing on the same tick fails here: Shielded)
	local ok, reason, secs = MoneyCollectorService.CanRaid(thief, victim)
	if not ok then
		cancelHold(thief, reason or "VictimLeft", secs, victim)
		return false
	end
	local vProfile = profileOf(victim)
	local tProfile = profileOf(thief)
	if not vProfile or not tProfile or not EconomyService then
		cancelHold(thief, "VictimLeft")
		return false
	end
	-- 2. 10% of the raidable balance
	local balance = MoneyCollectorService.GetRaidableBalance(victim)
	local steal = math.floor(balance * R.StealFraction)
	-- 3. protection first: a failure below favours the victim
	local vRaid = raidOf(vProfile)
	local tRaid = raidOf(tProfile)
	local oldShield = vRaid.ShieldUntil
	local oldCooldown = tRaid.RaidCooldownUntil
	local nowUnix = os.time()
	vRaid.ShieldUntil = nowUnix + R.ShieldSeconds
	tRaid.RaidCooldownUntil = nowUnix + R.ThiefCooldownSeconds
	-- 4. PendingCash → thief's ATM, 1:1 (existing transfer, no multipliers)
	local moved = 0
	local pending = math.max(0, math.floor(tonumber(EconomyService.GetPendingCash(victim)) or 0))
	local fromPending = math.min(steal, pending)
	if fromPending > 0 then
		moved = math.max(0, math.floor(tonumber(EconomyService.TransferPendingCash(victim, thief, fromPending)) or 0))
	end
	-- 5. AutoCollect owners: the rest comes out of the last 10 min of auto-collected income (now in Cash)
	local rest = steal - moved
	if rest > 0 and R.AutoCollectCountsRecentIncome and autoCollectFlag[victim.UserId] == true then
		local cash = math.max(0, math.floor(tonumber(EconomyService.GetCash(victim)) or 0))
		local cashTake = math.floor(math.min(rest, recentAutoSum(victim.UserId), cash))
		if cashTake > 0 and EconomyService.SpendCash(victim, cashTake, "atm_raid_loss") then
			-- "atm_raid" is NEVER_MULTIPLIED → the thief gets exactly what the victim lost
			if EconomyService.AccruePendingCash(thief, cashTake, "atm_raid") then
				moved += cashTake
			else
				EconomyService.AddCash(victim, cashTake, "purchase_refund")
			end
		end
	end
	-- 6. nothing moved → no shield, no cooldown
	if moved <= 0 then
		vRaid.ShieldUntil = oldShield
		tRaid.RaidCooldownUntil = oldCooldown
		clearHold(thief)
		pushBlocked(thief, victim, "LowBalance", nil, true)
		return false
	end
	-- 7. persist + mirror
	markDirty(victim)
	markDirty(thief)
	pcall(function()
		victim:SetAttribute("WE_ShieldUntil", vRaid.ShieldUntil)
	end)
	recentAuto[victim.UserId] = nil
	clearHold(thief)
	-- keep the 5 s Success chip up: the thief is still on the ATM (now ThiefCooldown) — no Blocked push for 5 s
	blockedPush[thief.UserId] = { Reason = "ThiefCooldown", At = os.clock() + 5 - R.BlockedPushInterval }
	-- 8. feedback
	local T = RaidConfig.Text
	local successText = string.format(T.RaidSuccess, formatCash(moved), victim.DisplayName)
	local robbedText = string.format(T.RaidRobbed, thief.DisplayName, formatCash(moved), RaidConfig.FormatTime(R.ShieldSeconds))
	if NotificationService then
		-- spec §4.2: thief → Success line + "+$N" float; victim → Error line + red spend float (shield chip = HUD)
		NotificationService.Notify(thief, successText, "Success", 5)
		NotificationService.Notify(thief, string.format("+$%s", formatCash(moved)), "Collect", nil, moved)
		NotificationService.Notify(victim, robbedText, "Error", 6)
		NotificationService.Notify(victim, string.format("-$%s", formatCash(moved)), "Collect", nil, -moved)
	end
	pushAtmRaidState(thief, {
		Phase = "Success",
		VictimName = victim.DisplayName,
		Stolen = moved,
		Text = successText,
		CooldownRemaining = R.ThiefCooldownSeconds,
		CooldownTotal = R.ThiefCooldownSeconds,
		Success = true,
	})
	pushAtmRaidState(victim, {
		Phase = "Robbed",
		ThiefName = thief.DisplayName,
		Stolen = moved,
		ShieldRemaining = R.ShieldSeconds,
		Text = robbedText,
		CooldownRemaining = 0,
		CooldownTotal = R.ThiefCooldownSeconds,
		Success = false,
		Raided = true,
	})
	MoneyCollectorService.RefreshForPlayer(victim)
	if AnalyticsService and AnalyticsService.Log then
		local props = { VictimUserId = victim.UserId, Stolen = moved, Balance = balance, PlotId = hold.PlotId }
		task.spawn(function()
			pcall(AnalyticsService.Log, "ATM_RAID", thief.UserId, props)
		end)
	end
	return true
end

-- ── the hold state machine (spec §1.3) ─────────────────────────────────────

-- Foreign ATM (owned by someone else) this position is in raid range of; prefers the running hold's ATM.
local function findForeignAtm(player: Player, pos: Vector3, hold: RaidHold?): (BasePart?, number?, number?)
	if hold and hold.Part.Parent and inRaidRange(pos, hold.Part) then
		local ownerId = ownerUserIdOfPlot(hold.PlotId)
		if ownerId ~= nil and ownerId ~= player.UserId then
			return hold.Part, hold.PlotId, ownerId
		end
	end
	for part in pairs(attached) do
		if part.Parent and inRaidRange(pos, part) then
			local plotId = plotIdOf(part)
			if plotId ~= nil then
				local ownerId = ownerUserIdOfPlot(plotId)
				if ownerId ~= nil and ownerId ~= player.UserId then
					return part, plotId, ownerId
				end
			end
		end
	end
	return nil, nil, nil
end

local function stepPlayer(player: Player, step: number, nowC: number)
	local R = RaidConfig.Raid
	local uid = player.UserId
	local char = player.Character
	local hrpInst = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrpInst and hrpInst:IsA("BasePart")) then
		lastPos[uid] = nil
		lastHrp[uid] = nil
		if holds[uid] then
			cancelHold(player, "Dead")
		end
		return
	end
	local hrp = hrpInst :: BasePart
	local hum = (char :: Model):FindFirstChildOfClass("Humanoid")
	local pos = hrp.Position

	-- 1. teleport bookkeeping (same HRP, on foot, > TeleportStuds in one tick → lockout)
	local seated = hum ~= nil and hum.SeatPart ~= nil
	local prevPos: Vector3? = lastPos[uid]
	if lastHrp[uid] == hrp and prevPos and not seated then
		local limit = R.TeleportStuds * math.max(1, step / SPATIAL_INTERVAL)
		if (pos - prevPos).Magnitude > limit then
			teleportLockUntil[uid] = nowC + R.TeleportLockoutSeconds
		end
	end
	lastPos[uid] = pos
	lastHrp[uid] = hrp

	local hold: RaidHold? = holds[uid]
	if hold and hold.Hrp ~= hrp then
		cancelHold(player, "Dead") -- respawned mid-hold
		hold = nil
	end

	-- 2. a foreign ATM in range
	local part, plotId, ownerId = findForeignAtm(player, pos, hold)
	if not part or plotId == nil or ownerId == nil then
		if hold then
			local stillThere = hold.Part.Parent ~= nil and inRaidRange(pos, hold.Part)
			cancelHold(player, if stillThere then "VictimLeft" else "LeftRange")
		end
		return
	end
	local victim = Players:GetPlayerByUserId(ownerId)
	if not victim then
		if hold then
			cancelHold(player, "VictimLeft")
		end
		return
	end

	-- 3. rules
	local ok, reason, secs = MoneyCollectorService.CanRaid(player, victim)
	if not ok then
		if hold then
			cancelHold(player, reason or "VictimLeft", secs, victim)
		elseif reason ~= nil and reason ~= "Dead" and reason ~= "VictimLeft" then
			pushBlocked(player, victim, reason, secs)
		end
		return
	end
	if not hum then
		return
	end

	-- 4. start (or switch victim)
	if hold and hold.VictimUserId ~= victim.UserId then
		cancelHold(player, "LeftRange")
		hold = nil
	end
	if not hold then
		local newHold: RaidHold = {
			VictimUserId = victim.UserId,
			VictimName = victim.DisplayName,
			PlotId = plotId,
			Part = part,
			Progress = 0,
			LastHealth = hum.Health,
			LastPushAt = -math.huge,
			LastAlarmAt = -math.huge,
			StartedAt = nowC,
			Hrp = hrp,
		}
		holds[uid] = newHold
		hold = newHold
		blockedPush[uid] = nil
		pcall(function()
			player:SetAttribute("WE_RaidingPlot", plotId)
		end)
		pushAlarm(victim, player, newHold, true)
	else
		-- 5. any damage cancels (progress back to 0; restarts next tick while still in range)
		if hum.Health < hold.LastHealth - R.DamageCancelHp then
			cancelHold(player, "Hit")
			return
		end
		hold.LastHealth = hum.Health
	end
	local h = hold :: RaidHold
	h.Progress += step

	-- 6. done
	if h.Progress >= R.HoldSeconds - 1e-6 then
		completeRaid(player, victim, h)
		return
	end
	if nowC - h.LastPushAt >= R.HoldPushInterval - 1e-6 then
		h.LastPushAt = nowC
		pushAtmRaidState(player, holdingPayload(h))
	end
	if nowC - h.LastAlarmAt >= R.AlarmPushInterval - 1e-6 then
		pushAlarm(victim, player, h, false)
	end
end

--[[ One raid tick for every online player (heartbeat calls it every ~0.25 s with the elapsed time; exported so
	tests can drive it with a fake clock). ]]
function MoneyCollectorService.StepRaids(step: number)
	if typeof(step) ~= "number" or step ~= step or step <= 0 then
		return
	end
	step = math.min(step, MAX_RAID_STEP)
	local nowC = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		xpcall(stepPlayer, function(err)
			warn("[MoneyCollector] raid step failed", player.UserId, err)
		end, player, step, nowC)
	end
end

-- ── collect ────────────────────────────────────────────────────────────────

-- silent: the AutoCollect loop collects every few seconds; the cash readout updating is the feedback.
-- v69: silent also skips the money-bag FX and the soft offers (they ran every 2 s for AutoCollect owners).
function MoneyCollectorService.Collect(player: Player, silent: boolean?): (boolean, number)
	if not EconomyService or not EconomyService.CollectPendingCash then
		return false, 0
	end
	local granted = EconomyService.CollectPendingCash(player)
	if granted <= 0 then
		return false, 0
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "PassiveIncome")
	end
	if silent then
		return true, granted
	end
	if NotificationService then
		-- spec §4.2: type Collect + Amount → only the "+$N" float at the cash pill, never a lane line
		NotificationService.Notify(player, string.format("Collected $%d", granted), "Collect", 3, granted)
	end
	-- v33: one-shot soft AutoCollect GamePass offer after first manual collect
	do
		local profile = DataService.GetProfile(player)
		local offerCfg = (MonetizationConfig :: any).AutoCollectOffer
		local gp = MonetizationConfig.GamePasses and MonetizationConfig.GamePasses.AutoCollect
		if (
			profile
			and offerCfg
			and gp
			and typeof(gp.Id) == "number"
			and gp.Id ~= 0
			and profile.AutoCollectOffered ~= true
			and not hasAutoCollect(player)
			and (not MonetizationService or not MonetizationService.ClaimSoftOfferSlot or MonetizationService.ClaimSoftOfferSlot(player))
		) then
			profile.AutoCollectOffered = true
			DataService.MarkDirty(player)
			task.delay(tonumber(offerCfg.DelaySeconds) or 1.2, function()
				if not player.Parent then
					return
				end
				if hasAutoCollect(player) then
					return
				end
				local remote = RemoteSetup.Get(Constants.RemoteNames.AutoCollectOffer)
				if remote and remote:IsA("RemoteEvent") then
					(remote :: RemoteEvent):FireClient(player, {
						ProductKey = "AutoCollect",
						GamePassId = gp.Id,
						DisplayName = gp.DisplayName or "Auto Collect",
						RobuxPrice = gp.RobuxPrice,
					})
				end
				-- (no companion Info line: the client's offer toast is the whole offer — spec §4.2)
			end)
		end
	end
	-- v34: one-shot DoubleCash soft offer after meaningful collect (existing Id only; not spammy)
	do
		local profile = DataService.GetProfile(player)
		local offerCfg = (MonetizationConfig :: any).DoubleCashOffer
		local gp = MonetizationConfig.GamePasses and MonetizationConfig.GamePasses.DoubleCash
		local minCash = tonumber(offerCfg and offerCfg.MinCollectCash) or 2500
		-- Prefer after AutoCollect already teased/owned so we don't stack two toasts on first collect
		local acReady = profile and (profile.AutoCollectOffered == true or hasAutoCollect(player))
		if (
			profile
			and offerCfg
			and gp
			and typeof(gp.Id) == "number"
			and gp.Id ~= 0
			and granted >= minCash
			and acReady
			and profile.DoubleCashOffered ~= true
			and not hasDoubleCash(player)
			and (not MonetizationService or not MonetizationService.ClaimSoftOfferSlot or MonetizationService.ClaimSoftOfferSlot(player))
		) then
			profile.DoubleCashOffered = true
			DataService.MarkDirty(player)
			task.delay(tonumber(offerCfg.DelaySeconds) or 1.8, function()
				if not player.Parent then
					return
				end
				if hasDoubleCash(player) then
					return
				end
				local remote = RemoteSetup.Get(Constants.RemoteNames.DoubleCashOffer)
				if remote and remote:IsA("RemoteEvent") then
					(remote :: RemoteEvent):FireClient(player, {
						ProductKey = "DoubleCash",
						GamePassId = gp.Id,
						DisplayName = gp.DisplayName or "2x Cash",
						RobuxPrice = gp.RobuxPrice,
					})
				end
				-- (no companion Info line: the client's offer toast is the whole offer — spec §4.2)
			end)
		end
	end
	-- v37: one-shot CashMega soft offer after high pending collect (existing Id only)
	if MonetizationService and MonetizationService.TrySoftOfferCashMega then
		pcall(function()
			MonetizationService.TrySoftOfferCashMega(player, "pending_collect", granted)
		end)
	end
	-- v69: FX on its own thread (a catalog load can yield; the collect path never does)
	task.spawn(function()
		pcall(function()
			local vas = require(script.Parent.VisualAssetService) :: any
			local plotId = ownedPlotOf(player)
			local pos: Vector3? = nil
			local parent: Instance? = nil
			if plotId ~= nil then
				for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
					if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
						pos = inst.Position + Vector3.new(0, 4, 0)
						parent = inst.Parent
						break
					end
				end
			end
			if not pos then
				local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp:IsA("BasePart") then
					pos = hrp.Position
				end
			end
			if pos and vas and vas.PlayMoneyBagFX then
				vas.PlayMoneyBagFX(pos, parent)
			end
		end)
	end)
	return true, granted
end

function MoneyCollectorService.RefreshAllBillboards()
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") and inst.Parent then
			local plotId = plotIdOf(inst)
			local owner = if plotId ~= nil then findOwnerByPlot(plotId) else nil
			local amount = if owner then MoneyCollectorService.GetRaidableBalance(owner) else 0
			refreshBillboard(inst, amount, atmTitle(owner, plotId, amount))
		end
	end
end

function MoneyCollectorService.RefreshForPlayer(player: Player)
	local plotId = ownedPlotOf(player)
	if plotId == nil then
		return
	end
	local amount = MoneyCollectorService.GetRaidableBalance(player)
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") and plotIdOf(inst) == plotId then
			refreshBillboard(inst, amount, atmTitle(player, plotId, amount))
		end
	end
end

-- Non-owner pressed the ATM prompt: a hint only (rate limited) — the raid itself is the server-side hold.
local function promptHint(player: Player, owner: Player)
	if RateLimitService and not RateLimitService.Allow(player, "atm_prompt", 2, 3) then
		return
	end
	local hold = holds[player.UserId]
	if hold then
		pushAtmRaidState(player, holdingPayload(hold))
		return
	end
	local ok, reason, secs = MoneyCollectorService.CanRaid(player, owner)
	if not ok then
		if reason ~= nil and reason ~= "Dead" and reason ~= "VictimLeft" then
			pushBlocked(player, owner, reason, secs, true)
		end
		return
	end
	pushAtmRaidState(player, {
		Phase = "Blocked",
		Reason = "Hint",
		VictimName = owner.DisplayName,
		Text = string.format(RaidConfig.Text.RaidHint, owner.DisplayName, math.floor(RaidConfig.Raid.HoldSeconds)),
	})
end

function MoneyCollectorService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	MonetizationService = deps.MonetizationService
	TutorialService = deps.TutorialService
	RateLimitService = deps.RateLimitService
	BaseService = deps.BaseService
	ClanService = deps.ClanService
	GateDefenseService = deps.GateDefenseService
	AnalyticsService = deps.AnalyticsService

	-- Touch + spatial + prompt collect (own ATM, or an unowned one during the join race). Foreign ATMs never
	-- collect or raid from here: the raid is the StepRaids hold.
	local function tryCollectFromPart(player: Player, part: BasePart, fromPrompt: boolean?)
		local profile = DataService.GetProfile(player)
		if not profile then
			return
		end
		local plotId = plotIdOf(part)
		if plotId ~= nil then
			local owner = findOwnerByPlot(plotId)
			if owner and owner ~= player then
				if fromPrompt == true then
					promptHint(player, owner)
				end
				return
			end
		end
		local pending = math.floor(tonumber(profile.PendingCash) or 0)
		if pending <= 0 then
			if fromPrompt == true and NotificationService then
				local now = os.clock()
				local last = emptyCollectToastAt[player.UserId] or 0
				if now - last >= 2.5 then
					emptyCollectToastAt[player.UserId] = now
					NotificationService.Notify(
						player,
						"Nothing to collect yet — grab the dropper cash or wait for income",
						"Info",
						3
					)
				end
			end
			return
		end
		-- walking over / standing at the ATM is silent for AutoCollect owners (their loop collects every 2 s;
		-- the number counting up is the feedback) — spec §4.2. The prompt is an explicit tap: it always floats.
		MoneyCollectorService.Collect(player, fromPrompt ~= true and autoCollectFlag[player.UserId] == true)
		MoneyCollectorService.RefreshForPlayer(player)
	end

	local function attach(part: BasePart)
		if attached[part] then
			return
		end
		attached[part] = true
		part.CanTouch = true
		part.CanCollide = true
		dropLegacyBillboard(part)
		-- Mobile-friendly Collect prompt (standing on the pad + the prompt button)
		do
			local existing = part:FindFirstChild("WE_CollectPrompt")
			if existing then
				existing:Destroy()
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "WE_CollectPrompt"
			prompt.ActionText = "Collect"
			prompt.ObjectText = "ATM"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 14
			prompt.RequiresLineOfSight = false
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
			prompt.Style = Enum.ProximityPromptStyle.Default
			prompt.Parent = part
			prompt.Triggered:Connect(function(triggerPlayer: Player)
				tryCollectFromPart(triggerPlayer, part, true)
			end)
		end
		task.defer(function()
			pcall(function()
				local vas = require(script.Parent.VisualAssetService) :: any
				if vas and vas.TryAttachCollectorVisual then
					vas.TryAttachCollectorVisual(part)
				end
			end)
		end)
		part.Touched:Connect(function(hit)
			if not hit:IsA("BasePart") then
				return
			end
			local character = hit:FindFirstAncestorOfClass("Model")
			if not character then
				return
			end
			local player = Players:GetPlayerFromCharacter(character)
			if not player then
				return
			end
			local key = tostring(player.UserId) .. "|" .. part:GetFullName()
			if lastOverlap[key] then
				return
			end
			lastOverlap[key] = true
			tryCollectFromPart(player, part)
		end)
		part.TouchEnded:Connect(function(hit)
			if not hit:IsA("BasePart") then
				return
			end
			local character = hit:FindFirstAncestorOfClass("Model")
			local player = character and Players:GetPlayerFromCharacter(character)
			if player then
				lastOverlap[tostring(player.UserId) .. "|" .. part:GetFullName()] = false
			end
		end)
	end

	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") then
			attach(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			attach(inst)
		end
	end)

	local acc = 0
	local autoAcc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		autoAcc += dt
		if acc >= SPATIAL_INTERVAL then
			local elapsed = acc
			acc = 0
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp:IsA("BasePart") then
					local profile = DataService.GetProfile(player)
					if profile then
						for part in pairs(attached) do
							if part.Parent and nearCollector(hrp.Position, part) then
								tryCollectFromPart(player, part, false)
							end
						end
					end
				end
			end
			MoneyCollectorService.StepRaids(elapsed)
			MoneyCollectorService.RefreshAllBillboards()
		end
		if autoAcc >= AUTO_COLLECT_INTERVAL then
			autoAcc = 0
			for _, player in ipairs(Players:GetPlayers()) do
				local owns = hasAutoCollect(player)
				autoCollectFlag[player.UserId] = owns
				if owns then
					local profile = DataService.GetProfile(player)
					if profile and (tonumber(profile.PendingCash) or 0) > 0 then
						local ok, granted = MoneyCollectorService.Collect(player, true)
						if ok and granted > 0 then
							recordAutoIncome(player.UserId, granted)
						end
						MoneyCollectorService.RefreshForPlayer(player)
					end
				end
			end
		end
	end)

	-- Mirror the persisted shield for HUDs once the real save is in
	if DataService and DataService.OnProfileLoaded then
		DataService.OnProfileLoaded(function(player: Player, profile: any)
			local shield = raidNum(profile, "ShieldUntil")
			pcall(function()
				player:SetAttribute("WE_ShieldUntil", if shield > 0 then shield else nil)
			end)
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		local uid = player.UserId
		holds[uid] = nil
		blockedPush[uid] = nil
		lastPos[uid] = nil
		lastHrp[uid] = nil
		teleportLockUntil[uid] = nil
		recentAuto[uid] = nil
		autoCollectFlag[uid] = nil
		emptyCollectToastAt[uid] = nil
		-- holds on this player (as victim) are cancelled on the next raid tick (owner gone → VictimLeft)
	end)

	print("[WAR EMPIRE] MoneyCollectorService ready (PendingCash → touch WE_MoneyCollector; ATM raid hold 10%, shield 10 min)")
end

return MoneyCollectorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">NationColorService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	NationService (nations spec section 2 Server, lane B). The file and the deps key keep the legacy name
	NationColorService, because Bootstrap and TerritoryService already use it.

	A nation is the player's OWN cosmetic country (CLAUDE.md nation rule): a flag on their own base and nothing
	else. It is never a gameplay input and never appears in kill, strike, nuke, raid or capture text, and this service
	never names a nation to anyone but the player who picked it. There is no player-list column (a leaderboard):
	lead decision 1 overrides the spec's leaderstat.

	Kept (legacy): GetColor / GetColorId. NationColorId (the 8-colour roster) is assigned SILENTLY on first load
	(the old join toast that named the colour is gone) and never wiped. GetColor returns the chosen nation's banner colour
	while that nation may be shown (NationConfig.Enabled and (art ready or the player is an admin)), else the legacy
	colour, which also stays the colour of "No flag" players.
	New: GetNationId, AdminReset, the RequestSetNation handler, the flags on the owner's base (Modules/NationFlag).

	RequestSetNation (client -> server, Types.NationRequestPayload), checked in this order (spec R17):
	  1. RateLimitService.Allow(player, "RequestSetNation", RequestRate, RequestBurst), else dropped (no reply)
	  2. a table; Action exactly "pick" / "later"; Source exactly "join" / "flagpole" / "settings", else dropped
	  3. pick: Id a string of <= 8 bytes that is NeutralId or passes NationConfig.Get (exact match), else "invalid";
	     the stored id is always NationConfig's own string, never the client's
	  4. no profile yet -> "loading"
	A pick is allowed right now when (pickAllowedAt == 0):
	  * NationId is nil (never picked, or cleared by the load sanitiser), or
	  * NationId is "NEUTRAL" and NationFreeUntil == 0 (No flag does not use up the first pick; lead decision 2), or
	  * now < NationFreeUntil and NationFreeChanges < FreeRepickMax (the free window), or
	  * now >= NationSetAt + ChangeCooldownSeconds (a NationSetAt later than now counts as 0; lead decision 4).
	Otherwise the reply is "cooldown" with NextChangeAt = NationSetAt + ChangeCooldownSeconds. Picking the id you
	already have replies "ok" and writes nothing (lead decision 3). The first REAL country opens the 10-minute free
	window once per profile (NationFreeUntil = now + FreeRepickSeconds only while it is 0).
	later: honoured only while NeedsPick is true, once per session; NationPrompts + 1 (capped 99). No reply.

	Player attributes (replicated; nothing private): WE_NationId, WE_NationNeedsPick, WE_NationFreeUntil and
	WE_NationNextAt (0 exactly when a pick would be accepted right now, else the time it will be). One task.delay per
	player keeps WE_NationNextAt exact when the free window or the cooldown ends (cancelled on leave; no loops).

	The IP-based suggestion (LocalizationService, pcall, 5 s cap) goes only to that player as NationColorUpdate
	.Suggested, only when it is a roster id; it is kept in memory for the session and never stored, logged or set as
	an attribute. Analytics: NATION_PICKER_SHOWN {source}, NATION_PICK {id, source, first}, NATION_LATER {count}.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalizationService = game:GetService("LocalizationService")

local Shared = ReplicatedStorage.Shared -- replicated by Rojo before any server script runs (no unbounded wait)
local Constants = require(Shared.Constants)
local NationColorConfig = require(Shared.Configs.NationColorConfig)
local NationConfig = require(Shared.Configs.NationConfig)
local AdminConfig = require(Shared.Configs.AdminConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local NationTexture = require(Shared.Util.NationTexture)

local NationFlag = require(script.Parent.Parent.Modules.NationFlag)

local NationColorService = {}

local DataService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local BaseService: any = nil
local TerritoryService: any = nil

local SUGGEST_TIMEOUT = 5 -- s: a later IP-lookup answer is dropped
local MAX_PROMPTS = 99 -- ProfileSchema MAX_NATION_PROMPTS

-- legacy 8-colour roster (banner colour of "No flag" players)
local legacyColorByUserId: { [number]: Color3 } = {}
local legacyIdByUserId: { [number]: string } = {}
-- what GetColor answers (nation colour while it may be shown, else the legacy colour)
local colorByUserId: { [number]: Color3 } = {}
-- session memory (cleared on PlayerRemoving)
local laterUsed: { [number]: boolean } = {}
local suggestion: { [number]: string } = {} -- the IP suggestion: memory only, this session only
local suggestStarted: { [number]: boolean } = {}
local plotByUserId: { [number]: number } = {}
local refreshTimer: { [number]: thread } = {}

local artReady = false

---------------------------------------------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------------------------------------------

local function num(v: any): number
	if typeof(v) == "number" and v == v and v > -math.huge and v < math.huge then
		return v
	end
	return 0
end

local function findDef(id: string)
	for _, def in ipairs(NationColorConfig.Colors) do
		if def.Id == id then
			return def
		end
	end
	return nil
end

local function pickForUser(userId: number): string
	local roster = NationColorConfig.Colors
	if #roster == 0 then
		return "Crimson"
	end
	-- Stable-ish assignment from userId so rejoins match without profile
	local idx = (math.abs(userId) % #roster) + 1
	return roster[idx].Id
end

local function isAdminUser(userId: number): boolean
	return table.find(AdminConfig.UserIds, userId) ~= nil
end

-- May this player's nation be shown at all? Until the flag art is uploaded only admins see the feature
-- (NationConfig.LiveRequiresArt, lead decision 6).
local function shows(userId: number): boolean
	return NationConfig.Enabled and (not NationConfig.LiveRequiresArt or artReady or isAdminUser(userId))
end

-- the saved id as stored: a NationConfig id, NationConfig.NeutralId or nil
local function savedId(profile: any): string?
	local id = profile.NationId
	if id == NationConfig.NeutralId then
		return NationConfig.NeutralId
	end
	local def = NationConfig.Get(id)
	return if def then def.Id else nil
end

--[[ 0 when a pick would be accepted right now, else the os.time() it will be (lead decision 5). ]]
local function pickAllowedAt(profile: any, now: number): number
	local id = savedId(profile)
	if id == nil then
		return 0
	end
	local freeUntil = num(profile.NationFreeUntil)
	if id == NationConfig.NeutralId and freeUntil == 0 then
		return 0 -- No flag before the first real country (lead decision 2)
	end
	if now < freeUntil and num(profile.NationFreeChanges) < NationConfig.FreeRepickMax then
		return 0
	end
	local setAt = num(profile.NationSetAt)
	if setAt > now then
		setAt = 0 -- clock skew / corrupt save (lead decision 4)
	end
	local at = setAt + NationConfig.ChangeCooldownSeconds
	return if now >= at then 0 else at
end

local function needsPick(userId: number, profile: any): boolean
	return NationConfig.Enabled
		and savedId(profile) == nil
		and num(profile.NationPrompts) < NationConfig.MaxJoinPrompts
		and not laterUsed[userId]
end

local function setAttr(player: Player, name: string, value: any)
	if player:GetAttribute(name) ~= value then
		player:SetAttribute(name, value)
	end
end

local function remote(): RemoteEvent
	return RemoteSetup.Get(Constants.RemoteNames.NationColorUpdate) :: RemoteEvent
end

local function log(event: string, userId: number, props: { [string]: any })
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(event, userId, props)
	end
end

---------------------------------------------------------------------------------------------------------------
-- state
---------------------------------------------------------------------------------------------------------------

local function refreshColor(player: Player, profile: any)
	local uid = player.UserId
	local def = NationConfig.Get(profile.NationId)
	if def and shows(uid) then
		colorByUserId[uid] = def.Color
	else
		colorByUserId[uid] = legacyColorByUserId[uid]
	end
end

local scheduleRefresh: (Player, any, number) -> ()

local function refreshAttributes(player: Player, profile: any)
	local uid = player.UserId
	local now = os.time()
	setAttr(player, "WE_NationId", savedId(profile))
	setAttr(player, "WE_NationNeedsPick", needsPick(uid, profile))
	setAttr(player, "WE_NationFreeUntil", num(profile.NationFreeUntil))
	setAttr(player, "WE_NationNextAt", pickAllowedAt(profile, now))
	scheduleRefresh(player, profile, now)
end

-- One timer per player: the next moment WE_NationNextAt changes by itself (the free window closes, or the
-- cooldown ends). Replaced on every refresh, cancelled on leave.
scheduleRefresh = function(player: Player, profile: any, now: number)
	local uid = player.UserId
	local old = refreshTimer[uid]
	if old then
		refreshTimer[uid] = nil
		pcall(task.cancel, old)
	end
	local at = pickAllowedAt(profile, now)
	if at == 0 then
		local freeUntil = num(profile.NationFreeUntil)
		at = if savedId(profile) ~= nil and now < freeUntil then freeUntil else 0
	end
	if at <= now then
		return
	end
	refreshTimer[uid] = task.delay(at - now + 1, function()
		refreshTimer[uid] = nil
		if player.Parent ~= Players then
			return
		end
		local prof = DataService.GetProfile(player)
		if prof then
			refreshAttributes(player, prof)
		end
	end)
end

local function statePayload(player: Player, profile: any, now: number): { [string]: any }
	local uid = player.UserId
	local legacyId = legacyIdByUserId[uid]
	local legacyDef = if legacyId then findDef(legacyId) else nil
	local legacyColor = legacyColorByUserId[uid] or Color3.fromRGB(200, 45, 55)
	local freeUntil = num(profile.NationFreeUntil)
	return {
		NationColorId = legacyId,
		DisplayName = if legacyDef then legacyDef.DisplayName else legacyId,
		Color = { R = legacyColor.R, G = legacyColor.G, B = legacyColor.B },
		NationId = savedId(profile),
		NeedsPick = needsPick(uid, profile),
		FreeUntil = freeUntil,
		FreeChangesLeft = if now < freeUntil then math.max(0, NationConfig.FreeRepickMax - num(profile.NationFreeChanges)) else 0,
		NextChangeAt = pickAllowedAt(profile, now),
	}
end

local function viewFor(player: Player, profile: any?): NationFlag.View
	return {
		OwnerUserId = player.UserId,
		NationId = if profile then savedId(profile) else nil,
		Show = shows(player.UserId),
	}
end

local function applyFlags(player: Player, profile: any?)
	local uid = player.UserId
	local plotId = plotByUserId[uid]
	if plotId == nil and BaseService and BaseService.GetOwnedPlotId then
		local ok, pid = pcall(BaseService.GetOwnedPlotId, player)
		if ok and typeof(pid) == "number" then
			plotId = pid
			plotByUserId[uid] = pid
		end
	end
	if plotId then
		NationFlag.ApplyPlot(plotId, viewFor(player, profile))
	end
end

-- the IP-based suggestion: that player only, this session only, memory only (spec R3 / R4)
local function startSuggestion(player: Player)
	local uid = player.UserId
	if suggestStarted[uid] or not shows(uid) then
		return
	end
	suggestStarted[uid] = true
	task.spawn(function()
		local t0 = os.clock()
		local ok, code = pcall(function(): any
			return LocalizationService:GetCountryRegionForPlayerAsync(player)
		end)
		if not ok or typeof(code) ~= "string" or os.clock() - t0 > SUGGEST_TIMEOUT then
			return
		end
		if player.Parent ~= Players or not suggestStarted[uid] then
			return -- left (or left and came back) meanwhile
		end
		local def = NationConfig.Get(string.upper(code))
		if def == nil then
			return -- only a roster id is ever suggested (Kosovo has no code of its own: nothing is badged)
		end
		suggestion[uid] = def.Id
		local profile = DataService.GetProfile(player)
		remote():FireClient(player, {
			NeedsPick = if profile then needsPick(uid, profile) else nil,
			Suggested = def.Id,
		})
	end)
end

---------------------------------------------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------------------------------------------

--[[ Territory tint: the nation's banner colour while it may be shown, else the legacy roster colour. ]]
function NationColorService.GetColor(userId: number): Color3?
	return colorByUserId[userId]
end

function NationColorService.GetColorId(userId: number): string?
	return legacyIdByUserId[userId]
end

--[[ The online player's nation id (a NationConfig id or "NEUTRAL"), or nil when never picked or when nations may not
	be shown for them yet (art gate). Cosmetic only: never a gameplay input, never used in combat / raid text. ]]
function NationColorService.GetNationId(userId: number): string?
	local player = Players:GetPlayerByUserId(userId)
	if not player or not shows(userId) then
		return nil
	end
	local profile = DataService and DataService.GetProfile(player)
	return if profile then savedId(profile) else nil
end

--[[ Load-time setup: the legacy colour (silent), attributes, the state push, the flags, the suggestion. ]]
function NationColorService.EnsureAssigned(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local uid = player.UserId
	local id = profile.NationColorId
	if typeof(id) ~= "string" or not findDef(id) then
		id = pickForUser(uid)
		profile.NationColorId = id
		DataService.MarkDirty(player)
		log(AnalyticsConfig.Events.NATION_COLOR_ASSIGN, uid, { color = id })
	end
	local def = findDef(id :: string)
	legacyIdByUserId[uid] = id :: string
	legacyColorByUserId[uid] = if def then def.Color else Color3.fromRGB(200, 45, 55)
	refreshColor(player, profile)
	refreshAttributes(player, profile)
	local payload = statePayload(player, profile, os.time())
	payload.Suggested = suggestion[uid]
	remote():FireClient(player, payload)
	if payload.NeedsPick and shows(uid) then
		log(AnalyticsConfig.Events.NATION_PICKER_SHOWN, uid, { source = "join" })
	end
	applyFlags(player, profile)
	if NationConfig.Enabled then
		startSuggestion(player)
	end
end

--[[ nationreset (AdminService, admin allowlist only): clears the CALLER's own nation fields, so the join picker
	and the free first pick can be tested again. Returns false while the profile is still loading. ]]
function NationColorService.AdminReset(player: Player): boolean
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	profile.NationId = nil
	profile.NationSetAt = 0
	profile.NationFreeUntil = 0
	profile.NationFreeChanges = 0
	profile.NationPrompts = 0
	DataService.MarkDirty(player)
	laterUsed[player.UserId] = nil
	refreshColor(player, profile)
	refreshAttributes(player, profile)
	local payload = statePayload(player, profile, os.time())
	payload.Suggested = suggestion[player.UserId]
	remote():FireClient(player, payload)
	applyFlags(player, profile)
	return true
end

---------------------------------------------------------------------------------------------------------------
-- RequestSetNation
---------------------------------------------------------------------------------------------------------------

local function reply(player: Player, payload: { [string]: any })
	remote():FireClient(player, payload)
end

local function acceptPick(player: Player, profile: any, id: string, source: string)
	local uid = player.UserId
	local now = os.time()
	if savedId(profile) == id then
		-- already this flag: "ok", nothing written, no toast (lead decision 3)
		local payload = statePayload(player, profile, now)
		payload.Result = "ok"
		reply(player, payload)
		return
	end
	local nextAt = pickAllowedAt(profile, now)
	if nextAt > 0 then
		reply(player, { Result = "cooldown", NextChangeAt = nextAt })
		return
	end
	local first = num(profile.NationSetAt) == 0
	local freeUntil = num(profile.NationFreeUntil)
	if now < freeUntil and not first then
		profile.NationFreeChanges = num(profile.NationFreeChanges) + 1
	end
	profile.NationId = id
	profile.NationSetAt = now
	if id ~= NationConfig.NeutralId and freeUntil == 0 then
		profile.NationFreeUntil = now + NationConfig.FreeRepickSeconds -- once per profile: never reopens
	end
	DataService.MarkDirty(player)
	refreshColor(player, profile)
	refreshAttributes(player, profile)
	applyFlags(player, profile)
	if NationConfig.OutpostFlags and TerritoryService and typeof(TerritoryService.RefreshOwnerFlags) == "function" then
		pcall(TerritoryService.RefreshOwnerFlags, uid)
	end
	log(AnalyticsConfig.Events.NATION_PICK, uid, { id = id, source = source, first = first })
	if shows(uid) and NotificationService and NotificationService.Notify then
		local def = NationConfig.Get(id)
		pcall(NotificationService.Notify, player, if def then "Flag raised: " .. def.Short else "Plain flag raised", "Success")
	end
	local payload = statePayload(player, profile, now)
	payload.Result = "ok"
	reply(player, payload)
end

local function acceptLater(player: Player, profile: any)
	local uid = player.UserId
	if not needsPick(uid, profile) then
		return -- NeedsPick already false (picked, 3 LATERs, or one LATER this session): ignored
	end
	laterUsed[uid] = true
	profile.NationPrompts = math.min(num(profile.NationPrompts) + 1, MAX_PROMPTS)
	DataService.MarkDirty(player)
	refreshAttributes(player, profile)
	log(AnalyticsConfig.Events.NATION_LATER, uid, { count = profile.NationPrompts })
end

local function onRequest(player: Player, payload: any)
	if not RateLimitService.Allow(player, "RequestSetNation", NationConfig.RequestRate, NationConfig.RequestBurst) then
		return
	end
	if typeof(payload) ~= "table" then
		return
	end
	local action = payload.Action
	local source = payload.Source
	if action ~= "pick" and action ~= "later" then
		return
	end
	if source ~= "join" and source ~= "flagpole" and source ~= "settings" then
		return
	end
	if action == "later" then
		if source ~= "join" then
			return -- LATER exists only in the join picker
		end
		local profile = DataService.GetProfile(player)
		if profile then
			acceptLater(player, profile)
		end
		return
	end
	local raw = payload.Id
	local id: string? = nil
	if typeof(raw) == "string" and #raw <= 8 then
		if raw == NationConfig.NeutralId then
			id = NationConfig.NeutralId
		else
			local def = NationConfig.Get(raw)
			if def then
				id = def.Id -- NationConfig's own string, never the client's
			end
		end
	end
	if id == nil or not NationConfig.Enabled then
		reply(player, { Result = "invalid" })
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		reply(player, { Result = "loading" })
		return
	end
	acceptPick(player, profile, id :: string, source :: string)
end

---------------------------------------------------------------------------------------------------------------
-- init
---------------------------------------------------------------------------------------------------------------

function NationColorService.Init(deps: { [string]: any })
	DataService = deps.DataService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	BaseService = deps.BaseService
	TerritoryService = deps.TerritoryService

	artReady = NationTexture.ArtReady()

	local request = RemoteSetup.Get(Constants.RemoteNames.RequestSetNation) :: RemoteEvent
	request.OnServerEvent:Connect(onRequest)

	NationFlag.SetPromptHandler(function(player: Player, _plotId: number)
		if RateLimitService.Allow(player, "NationPickerShown", 0.2, 2) then
			log(AnalyticsConfig.Events.NATION_PICKER_SHOWN, player.UserId, { source = "flagpole" })
		end
	end)

	-- the owner's own base: parade flag + HQ flag (+ the flagpole prompt while the art gate passes)
	if BaseService and BaseService.OnPlotReady then
		BaseService.OnPlotReady(function(player: Player, plotId: number)
			local uid = player.UserId
			local prev = plotByUserId[uid]
			if prev and prev ~= plotId and NationFlag.OwnerOf(prev) == uid then
				NationFlag.ResetPlot(prev)
			end
			for other, pid in pairs(plotByUserId) do
				if other ~= uid and pid == plotId then
					plotByUserId[other] = nil
				end
			end
			plotByUserId[uid] = plotId
			NationFlag.ApplyPlot(plotId, viewFor(player, DataService.GetProfile(player)))
		end)
	end

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		NationColorService.EnsureAssigned(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local uid = player.UserId
		local timer = refreshTimer[uid]
		if timer then
			refreshTimer[uid] = nil
			pcall(task.cancel, timer)
		end
		local plotId = plotByUserId[uid]
		if plotId and NationFlag.OwnerOf(plotId) == uid then
			NationFlag.ResetPlot(plotId) -- plain army green again; parts are never destroyed
		end
		plotByUserId[uid] = nil
		colorByUserId[uid] = nil
		legacyColorByUserId[uid] = nil
		legacyIdByUserId[uid] = nil
		laterUsed[uid] = nil
		suggestion[uid] = nil
		suggestStarted[uid] = nil
	end)
end

return NationColorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">NotificationService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Server → client toast. NotifyThrottled debounces identical messages per player. ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(ReplicatedStorage:WaitForChild("Shared").Constants)

local NotificationService = {}

local RemoteSetup: any = nil

-- userId|messageType → last fire clock
local lastByKey: { [string]: number } = {}
local DEFAULT_COOLDOWN = 0.85 -- Shaun: ~1/2–1s between identical pad toasts

function NotificationService.Init(deps: { [string]: any })
	RemoteSetup = deps.RemoteSetup
end

--[[ amount (v71, HUD v70 spec §4.2): money this line is about. With type "Collect" the client shows no lane line,
	only the "+$N" float at the cash pill (negative = the red spend float); other types ignore it. ]]
function NotificationService.Notify(player: Player, message: string, notifType: string?, duration: number?, amount: number?)
	local remote = RemoteSetup.Get(Constants.RemoteNames.Notification) :: RemoteEvent
	remote:FireClient(player, {
		Message = message,
		Type = notifType or "Info",
		Duration = duration or 4,
		Amount = amount,
	})
end

--[[ Throttle by message text (or explicit key). Returns true if sent. ]]
function NotificationService.NotifyThrottled(
	player: Player,
	message: string,
	notifType: string?,
	duration: number?,
	cooldownSec: number?,
	keySuffix: string?
): boolean
	local cd = cooldownSec or DEFAULT_COOLDOWN
	local key = tostring(player.UserId) .. "|" .. (keySuffix or message)
	local now = os.clock()
	local last = lastByKey[key] or 0
	if now - last < cd then
		return false
	end
	lastByKey[key] = now
	NotificationService.Notify(player, message, notifType, duration)
	return true
end

function NotificationService.NotifyAll(message: string, notifType: string?)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		NotificationService.Notify(player, message, notifType)
	end
end

game:GetService("Players").PlayerRemoving:Connect(function(player)
	local prefix = tostring(player.UserId) .. "|"
	for k in pairs(lastByKey) do
		if string.sub(k, 1, #prefix) == prefix then
			lastByKey[k] = nil
		end
	end
end)

return NotificationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">OpsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	OpsService — Jobs at every place (players see "Jobs"; the code says Ops). W3 step 2 Phase B, lane O.
	Spec scratchpad w3s2/spec_w3s2.md §4-§5, activities design §2-§3, contract w3s2/buildB/KB/contract.md §4.
	Config: Shared/Configs/OpsConfig (ships OFF). SERVER ONLY; the server decides every state, payout and cooldown.

	Modules (children): OpsSites (liveness, prompts, labels, doors), OpsKinds (the stage machine), OpsGarrison (NPC
	ledger + lane N's CombatService API), OpsZones (presence, under fire, teleport lockout), OpsCargo (bags),
	OpsDirector (which big sites are open), OpsRewards (pay, cooldowns, the saved Ops block).

	Off switches (Init returns at once, one log line, nothing created): OpsConfig.Enabled; OpsConfig.Validate() not
	empty; OpsConfig.Rewards.RequireCashExempt while MonetizationConfig.CashMultExemptReasons.ops ~= true (a job is
	never paid through a pass multiplier); RateLimitService missing. Per site: OpsSites.Resolve (switches, POI,
	coexistence with BankRaidService / the field NPCs, lane N, anchors, the streaming host rule).

	The client never sends a job request: there is NO Ops client -> server remote and no remote handler in this service. Every
	action is a server ProximityPrompt.Triggered, re-checked in this order: the rate limit
	(RateLimitService.Allow(player, "ops_prompt", ...)), the profile is loaded, alive, the root within
	MaxActivationDistance + Zones.PromptSlack of the anchor (server positions), on foot unless the site allows
	vehicles, the stage is valid, not on cooldown, not teleport-locked.

	Server -> client (contract §3): OpsState (RemoteEvent: a Full snapshot on profile load and every
	Remote.SnapshotSeconds, deltas coalesced to one per Remote.DeltaMinGap), OpsProgress (RemoteEvent, Remote.ProgressHz
	only while the player is inside an Active job's zone; one final {Site} hides the pill) and OpsPing
	(UnreliableRemoteEvent, every Remote.PingSeconds per carrier, non-allies only, never for a novice carrier).
	Timers are seconds remaining. About 2 + 4 + 0.1 Hz per player at most (<= 20 Hz).

	Performance: anchors are read once (ActivityAnchors.List) and re-read only on a 30 s health check; one 4 Hz tick
	for all sites (Heartbeat accumulator), wake / sleep and top-ups at 1 Hz, the director every 30 s. No per-frame
	scans, no descendant walks in any loop, no wait on the tree without a timeout.

	PUBLIC API (other lanes rely on these):
	  OpsService.Init(deps)
	  OpsService.IsLive(siteId) -> boolean
	  OpsService.GetSites() -> { { Id, State } }          (a copy; never per frame)
	  OpsService.IsCarrier(player) -> boolean
	  OpsService.OnJobDone(fn(player, siteId, kind, pay)) -> disconnect
	  OpsService.GoTargets(goKey) -> { {X, Y, Z} }?       (MissionService hooks, lane M1)
	  OpsService.ObjectiveLive(objectiveType) -> boolean?
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local Constants = require(Shared.Constants)
local OpsConfig = require(Shared.Configs.OpsConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local OpsSites = require(script.OpsSites)
local OpsKinds = require(script.OpsKinds)
local OpsGarrison = require(script.OpsGarrison)
local OpsZones = require(script.OpsZones)
local OpsCargo = require(script.OpsCargo)
local OpsDirector = require(script.OpsDirector)
local OpsRewards = require(script.OpsRewards)

local Z = OpsConfig.Zones
local N = OpsConfig.Npc
local REMOTE = OpsConfig.Remote
local TOAST = OpsConfig.Text.Toast
local D = OpsConfig.Director

local OpsService = {}

local DataService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local NotificationService: any = nil
local MissionService: any = nil
local CombatService: any = nil
local BaseService: any = nil
local NationColorService: any = nil

local running = false
local sites: { any } = {} -- runtime records, OpsConfig.Sites order
local byId: { [string]: any } = {}
local offReason: { [string]: string } = {}
local loaded: { [number]: boolean } = {} -- profile loaded: payloads flow
local pending: { [number]: { [string]: boolean } } = {}
local pendingAny: { [number]: boolean } = {}
local needFull: { [number]: boolean } = {}
local lastSent: { [number]: number } = {}
local nextFull: { [number]: number } = {}
local progSite: { [number]: string } = {}
local lastRobbedLine = -math.huge
local accum = 0
local wakeAccum = 0
local directorAccum = 0
local healthAccum = 0

-- analytics event names (AnalyticsConfig.Events; the literal name when a key is missing)
local Events: { [string]: string } = {}
for _, k in ipairs({ "OPS_OPEN", "OPS_START", "OPS_DONE", "OPS_FAIL", "BAG_GRAB", "BAG_DROP", "BAG_PICKUP", "BAG_DELIVER" }) do
	Events[k] = (AnalyticsConfig.Events :: any)[k] or k
end

-- ── helpers shared with the child modules (ctx) ─────────────────────────────────────────────────────────────────
local playerList: { Player } = {} -- Players:GetPlayers() once per tick (no per-site allocation)
local ctx: any = {
	PlayerList = playerList,
	Sites = OpsSites,
	Kinds = OpsKinds,
	Garrison = OpsGarrison,
	Zones = OpsZones,
	Cargo = OpsCargo,
	Director = OpsDirector,
	Rewards = OpsRewards,
	Events = Events,
}

local function profileOf(player: Player): any
	if DataService == nil then
		return nil
	end
	local ok, p = pcall(DataService.GetProfile, player)
	return if ok then p else nil
end
ctx.Profile = profileOf

function ctx.PlotOf(player: Player): number?
	if BaseService and typeof(BaseService.GetOwnedPlotId) == "function" then
		local ok, id = pcall(BaseService.GetOwnedPlotId, player)
		if ok and typeof(id) == "number" then
			return id
		end
	end
	local attr = player:GetAttribute("WE_PlotId")
	return if typeof(attr) == "number" and attr > 0 then attr else nil
end

function ctx.Notify(player: Player, msg: string, kind: string?)
	if NotificationService and NotificationService.Notify then
		pcall(NotificationService.Notify, player, msg, kind or "Info")
	end
end

function ctx.NotifyThrottled(player: Player, msg: string, kind: string?, gap: number, key: string)
	if NotificationService and typeof(NotificationService.NotifyThrottled) == "function" then
		pcall(NotificationService.NotifyThrottled, player, msg, kind or "Info", nil, gap, key)
	end
end

-- a job action ends the F6 novice shield (a shielded raider would carry an unstealable bag)
function ctx.EndNovice(player: Player)
	if CombatService and typeof(CombatService.EndNoviceShield) == "function" then
		pcall(CombatService.EndNoviceShield, player, "ops")
	end
end

-- the taker's cosmetic colour (NationColorService, the captured-ring rule); never a flag or a name
function ctx.ColorOf(player: Player): Color3?
	if NationColorService and typeof(NationColorService.GetColor) == "function" then
		local ok, c = pcall(NationColorService.GetColor, player.UserId)
		if ok and typeof(c) == "Color3" then
			return c
		end
	end
	return nil
end

function ctx.Blast(attacker: Player?, centre: Vector3, radius: number, damage: number)
	if CombatService and typeof(CombatService.ApplyRadiusDamage) == "function" then
		local ok, err = pcall(CombatService.ApplyRadiusDamage, attacker, centre, radius, damage, {
			WeaponId = "OpsCharge",
			RequireLos = false,
			Quiet = true,
		})
		if not ok then
			warn("[Ops] blast failed: " .. tostring(err))
		end
	end
end

local function markSite(rt: any)
	for uid in pairs(loaded) do
		local set = pending[uid]
		if set == nil then
			set = {}
			pending[uid] = set
		end
		set[rt.Id] = true
	end
end
ctx.MarkSite = markSite

function ctx.MarkPlayerSite(player: Player, siteId: string)
	local uid = player.UserId
	if not loaded[uid] then
		return
	end
	local set = pending[uid]
	if set == nil then
		set = {}
		pending[uid] = set
	end
	set[siteId] = true
end

function ctx.MarkAllBags()
	for uid in pairs(loaded) do
		pendingAny[uid] = true
	end
end

function ctx.SetState(rt: any, state: string, secs: number?)
	rt.State = state
	rt.StateUntil = if secs ~= nil then os.clock() + secs else nil
	OpsSites.Label(rt)
	OpsSites.Banner(rt)
	markSite(rt)
end

-- "Empire Bank raid started" to everyone else (once per 10 min each; never while being shot at)
function ctx.RaidStarted(rt: any, starter: Player?)
	local nowC = os.clock()
	for _, p in ipairs(Players:GetPlayers()) do
		if (starter == nil or not OpsZones.Allies(starter, p)) and not OpsZones.HitWithin(p, nowC, D.SkipToastIfHitSeconds) then
			ctx.NotifyThrottled(p, TOAST.RaidStarted, "Info", D.OpenToastGapSeconds, "ops_raid")
		end
	end
end

local function remoteEvent(name: string): RemoteEvent?
	if RemoteSetup == nil then
		return nil
	end
	local ok, r = pcall(RemoteSetup.Get, name)
	if ok and typeof(r) == "Instance" and r:IsA("RemoteEvent") then
		return r
	end
	return nil
end

local function pingRemote(): any
	if RemoteSetup == nil or typeof(RemoteSetup.GetUnreliable) ~= "function" then
		return nil
	end
	local ok, r = pcall(RemoteSetup.GetUnreliable, Constants.RemoteNames.OpsPing)
	return if ok then r else nil
end

-- a carrier's position to every non-ally (the carrier is not a novice: OpsCargo checked)
function ctx.Ping(carrier: Player, bag: any)
	local s = OpsZones.Get(carrier)
	if s.Pos == nil then
		return
	end
	local payload: OpsConfig.OpsPingPayload = { U = carrier.UserId, X = math.floor(s.Pos.X + 0.5), Z = math.floor(s.Pos.Z + 0.5) }
	local remote = pingRemote()
	local def = OpsConfig.Get(bag.Site)
	local firstMove = def ~= nil and def.Kind == "Vault" and not bag.PingedMove
	bag.PingedMove = true
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= carrier and not OpsZones.Allies(carrier, p) then
			if remote then
				pcall(function()
					remote:FireClient(p, payload)
				end)
			end
			if firstMove then
				ctx.NotifyThrottled(p, TOAST.BagMoving, "Info", 60, "ops_bagmove")
			end
		end
	end
end

-- a bag reached its carrier's own plot: pay (the picker gets Cargo.PickerMult), toast, the bank's server line
function ctx.Deliver(player: Player, bag: any)
	local def = OpsConfig.Get(bag.Site)
	if def == nil then
		return
	end
	local value = OpsCargo.ValueFor(bag, player)
	if OpsRewards.Grant(player, def, value, bag.XP, true) then
		ctx.Notify(player, string.format(TOAST.Paid, def.Title, OpsRewards.FormatCash(value)), "Reward")
		OpsRewards.Log(Events.BAG_DELIVER, player.UserId, { site = def.Id, value = value, picked = player.UserId ~= bag.Grabber })
		ctx.MarkPlayerSite(player, def.Id)
		if def.Kind == "Vault" and os.clock() - lastRobbedLine >= D.RobbedLineGapSeconds then
			lastRobbedLine = os.clock()
			local line = string.format(TOAST.Robbed, player.DisplayName)
			for _, p in ipairs(Players:GetPlayers()) do
				ctx.Notify(p, line, "Info")
			end
		end
	end
end

-- ── the prompt re-checks (the ONLY way a player acts) ───────────────────────────────────────────────────────────
local function actor(player: Player, at: Vector3, dist: number, seatedOk: boolean): boolean
	local char = player.Character
	local rootInst = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if rootInst == nil or not rootInst:IsA("BasePart") or hum == nil or hum.Health <= 0 then
		return false
	end
	local root = rootInst :: BasePart
	if (root.Position - at).Magnitude > dist + Z.PromptSlack then
		return false
	end
	if not seatedOk and hum.SeatPart ~= nil then
		return false
	end
	return true
end

function ctx.OnSitePrompt(rt: any, key: string, role: string, stage: OpsConfig.StageDef, player: Player)
	if not RateLimitService.Allow(player, "ops_prompt", Z.RateLimitRate, Z.RateLimitBurst) then
		return
	end
	local profile = profileOf(player)
	if profile == nil then
		return
	end
	local def: OpsConfig.SiteDef = rt.Def
	local a = rt.Anchors[role]
	if a == nil or not actor(player, a.Position, stage.Dist or 10, def.AllowSeated == true) then
		return
	end
	if not rt.Live or rt.Prompts[key] == nil or not OpsKinds.PromptValid(rt, stage) then
		return
	end
	local left = OpsRewards.CdLeft(profile, def.Id, os.time())
	if left > 0 then
		ctx.NotifyThrottled(player, string.format(TOAST.JobCooldown, OpsKinds.FmtClock(left)), "Info", 3, "ops_cd")
		return
	end
	if OpsZones.Locked(player, os.clock()) then
		return
	end
	OpsKinds.OnPrompt(rt, stage, role, player)
end

function ctx.OnBagPrompt(bag: any, player: Player)
	if not RateLimitService.Allow(player, "ops_prompt", Z.RateLimitRate, Z.RateLimitBurst) then
		return
	end
	if profileOf(player) == nil or bag.Part == nil then
		return
	end
	if not actor(player, bag.Part.Position, OpsConfig.Cargo.PickupDist, false) then
		return
	end
	if OpsCargo.Carrying(player) ~= nil then
		ctx.Notify(player, TOAST.HandsFull, "Info")
		return
	end
	if OpsZones.Locked(player, os.clock()) then
		return
	end
	if OpsCargo.PickUp(bag, player) then
		ctx.EndNovice(player)
	end
end

-- ── sites: resolve, build, tear down ────────────────────────────────────────────────────────────────────────────
local function logOff(id: string, reason: string)
	if offReason[id] ~= reason then
		offReason[id] = reason
		print(string.format("[Ops] %s off: %s", id, reason))
	end
end

local function newRecord(def: OpsConfig.SiteDef, order: number): any
	return {
		Id = def.Id,
		Def = def,
		Order = order,
		Live = false,
		State = "Off",
		StateUntil = nil,
		Anchors = {},
		Points = {},
		Target = nil,
		Need = 0,
		Alloc = 0,
		AllocEvent = 0,
		Npcs = {},
		NpcCount = 0,
		RowNpc = {},
		Pending = 0,
		Spawned = 0,
		Killed = 0,
		Gen = 0,
		Prompts = {},
		Parts = {},
		Blocked = {},
		Planted = {},
		PlantCount = 0,
		Provoke = {},
		StageIdx = 1,
		StageAt = 0,
		Progress = 0,
		EmptyFor = 0,
		BagsTaken = 0,
		SleepSince = nil,
		LastEntered = os.clock(),
	}
end

-- the zone points: Target + every stage anchor + config deck posts (rigs): presence is "near any of them"
local function zonePoints(rt: any): { Vector3 }
	local def: OpsConfig.SiteDef = rt.Def
	local pts: { Vector3 } = {}
	local seen: { [any]: boolean } = {}
	local function add(a: any)
		if a ~= nil and not seen[a] then
			seen[a] = true
			table.insert(pts, a.Position)
		end
	end
	add(rt.Anchors[def.Target])
	for _, st in ipairs(def.Stages) do
		if st.At then
			add(rt.Anchors[st.At])
		end
		for _, r in ipairs(st.AtAny or {}) do
			add(rt.Anchors[r])
		end
	end
	for _, row in ipairs(def.Garrison) do
		if row.At ~= nil then
			table.insert(pts, Vector3.new(row.At.X, row.At.Y, row.At.Z))
		end
	end
	return pts
end

local function goLive(rt: any, byRole: { [string]: any }, persist: { Model })
	local def: OpsConfig.SiteDef = rt.Def
	OpsSites.Persist(persist)
	rt.Anchors = byRole
	rt.Live = true
	rt.RotateRole = if def.Rotate then def.Rotate[1] else nil
	if rt.RotateRole ~= nil and byRole[rt.RotateRole] == nil then
		for _, r in ipairs(def.Rotate or {}) do
			if byRole[r] ~= nil then
				rt.RotateRole = r
				break
			end
		end
	end
	rt.Target = byRole[rt.RotateRole or def.Target] or byRole[def.Target]
	rt.Points = zonePoints(rt)
	rt.Need = OpsGarrison.Need(rt)
	rt.Door = OpsSites.FindDoor(rt)
	rt.DoorClose = rt.Door ~= nil
	rt.Banner = if def.Kind == "Vault" then OpsSites.FindBanner(rt) else nil
	offReason[rt.Id] = nil
	print(string.format("[Ops] %s live (%s, %d NPC slots)", rt.Id, def.Kind, rt.Need))
	if OpsDirector.Rotating(rt) then
		rt.State = "Closed"
		rt.ClosedAt = nil
		OpsSites.Label(rt)
		OpsSites.Banner(rt)
	else
		ctx.SetState(rt, if rt.Need > 0 then "Dormant" else "Open")
		OpsKinds.Reset(rt)
	end
end

local function goOff(rt: any, reason: string)
	if rt.Live then
		if rt.State == "Active" then
			OpsKinds.End(rt, false, nil)
		end
		OpsGarrison.Sleep(rt)
		OpsSites.DropPrompts(rt)
		OpsSites.DropLabel(rt)
		OpsSites.Smoke(rt, false)
		OpsSites.Sparks(rt, false)
		OpsSites.HeldSign(rt, nil)
		rt.Live = false
		rt.State = "Off"
		markSite(rt)
	end
	logOff(rt.Id, reason)
end

local function anchorsById(): { [string]: any }
	local map: { [string]: any } = {}
	local ok, AA = pcall(function(): any
		local modules = script.Parent and script.Parent.Parent and script.Parent.Parent:FindFirstChild("Modules")
		local m = modules and modules:FindFirstChild("ActivityAnchors")
		return if m and m:IsA("ModuleScript") then require(m) :: any else nil
	end)
	if not ok or AA == nil then
		return map
	end
	local okL, list = pcall(AA.List)
	if okL and typeof(list) == "table" then
		for _, a in ipairs(list) do
			map[a.Id] = a
		end
	end
	return map
end

local function resolveAll(onlyWaiting: boolean)
	local anchors = anchorsById()
	local changed = false
	for _, rt in ipairs(sites) do
		if not rt.Live then
			local waiting = offReason[rt.Id] == nil or string.find(offReason[rt.Id], "anchor", 1, true) ~= nil
			if not onlyWaiting or waiting then
				local byRole, extra = OpsSites.Resolve(rt.Def, anchors)
				if byRole ~= nil then
					goLive(rt, byRole, extra)
					changed = true
				else
					logOff(rt.Id, tostring(extra))
				end
			end
		end
	end
	if changed then
		for uid in pairs(loaded) do
			needFull[uid] = true
		end
		OpsDirector.Tick(sites, os.clock(), true)
	end
end

-- 30 s health check: a live site whose anchor lost its host goes off and waits for a re-resolve
local function healthCheck()
	local lost = false
	for _, rt in ipairs(sites) do
		if rt.Live then
			for role, a in pairs(rt.Anchors) do
				if a.Attachment.Parent == nil then
					goOff(rt, "anchor " .. role .. " lost")
					lost = true
					break
				end
			end
		end
	end
	local anyWaiting = lost
	for _, rt in ipairs(sites) do
		local r = offReason[rt.Id]
		if not rt.Live and r ~= nil and string.find(r, "anchor", 1, true) ~= nil then
			anyWaiting = true
		end
	end
	if anyWaiting then
		resolveAll(true)
	end
end

-- ── payloads ────────────────────────────────────────────────────────────────────────────────────────────────────
local function r0(n: number): number
	return math.floor(n + 0.5)
end

local function snap(rt: any, profile: any, full: boolean, nowC: number, nowU: number): OpsConfig.OpsSiteSnap
	local def: OpsConfig.SiteDef = rt.Def
	local s: OpsConfig.OpsSiteSnap = { Id = rt.Id, State = rt.State }
	if not rt.Live then
		s.State = "Off"
		return s
	end
	if full or def.Rotate ~= nil then
		local p: Vector3 = rt.Target.Position
		s.X, s.Y, s.Z = r0(p.X), r0(p.Y * 10) / 10, r0(p.Z)
	end
	if rt.State == "Active" and rt.LockUntil then
		s.Left = math.max(0, math.ceil(rt.LockUntil - nowC))
	elseif (rt.State == "Cooling" or rt.State == "Held") and rt.StateUntil then
		s.Left = math.max(0, math.ceil(rt.StateUntil - nowC))
	end
	if profile ~= nil then
		local cash = OpsRewards.Quote(profile, def, nowU)
		s.Pay = cash
		local cd = OpsRewards.CdLeft(profile, def.Id, nowU)
		if cd > 0 then
			s.MyCd = cd
		end
	end
	if rt.Need > 0 and (rt.State == "Open" or rt.State == "Active") then
		s.Guards = rt.NpcCount
	end
	if rt.State == "Held" then
		s.HeldBy = rt.HeldBy
	end
	return s
end

local function send(player: Player, full: boolean)
	local uid = player.UserId
	local remote = remoteEvent(Constants.RemoteNames.OpsState)
	if remote == nil then
		return
	end
	local profile = profileOf(player)
	local nowC, nowU = os.clock(), os.time()
	local list: { OpsConfig.OpsSiteSnap } = {}
	if full then
		for _, rt in ipairs(sites) do
			if rt.Live then
				table.insert(list, snap(rt, profile, true, nowC, nowU))
			end
		end
	else
		for id in pairs(pending[uid] or {}) do
			local rt = byId[id]
			if rt then
				table.insert(list, snap(rt, profile, false, nowC, nowU))
			end
		end
		table.sort(list, function(a, b)
			return a.Id < b.Id
		end)
	end
	local bags = OpsCargo.BagSnaps(nowC)
	local payload: OpsConfig.OpsStatePayload = {
		V = OpsConfig.PayloadVersion,
		Full = full,
		Sites = list,
		Home = if full then OpsCargo.HomePoint(player) else nil,
		Carrying = OpsCargo.CarrySnap(player, nowC),
		Bags = if #bags > 0 then bags else nil,
	}
	pending[uid] = nil
	pendingAny[uid] = nil
	lastSent[uid] = nowC
	if full then
		needFull[uid] = nil
		nextFull[uid] = nowC + REMOTE.SnapshotSeconds
	end
	pcall(function()
		remote:FireClient(player, payload)
	end)
end

local function flushState(nowC: number)
	for _, p in ipairs(playerList) do
		local uid = p.UserId
		if loaded[uid] then
			local gapOk = nowC - (lastSent[uid] or -math.huge) >= REMOTE.DeltaMinGap
			if needFull[uid] or nowC >= (nextFull[uid] or 0) then
				if gapOk or needFull[uid] then
					send(p, true)
				end
			elseif gapOk and (pendingAny[uid] or (pending[uid] ~= nil and next(pending[uid]) ~= nil)) then
				send(p, false)
			end
		end
	end
end

local function sendProgress(nowC: number)
	local remote = remoteEvent(Constants.RemoteNames.OpsProgress)
	if remote == nil then
		return
	end
	for _, p in ipairs(playerList) do
		local uid = p.UserId
		local s = OpsZones.Get(p)
		local payload: OpsConfig.OpsProgressPayload? = nil
		if loaded[uid] and s.Alive and s.Pos then
			for _, rt in ipairs(sites) do
				if rt.Live and rt.State == "Active" then
					local def: OpsConfig.SiteDef = rt.Def
					if OpsZones.NearAny(s.Pos, rt.Points, def.PresentR or Z.PresentR, def.AllowSeated) then
						payload = OpsKinds.Progress(rt, p, nowC)
						if payload then
							break
						end
					end
				end
			end
		end
		if payload then
			progSite[uid] = payload.Site
			pcall(function()
				remote:FireClient(p, payload)
			end)
		elseif progSite[uid] ~= nil then
			local done: OpsConfig.OpsProgressPayload = { Site = progSite[uid] }
			progSite[uid] = nil
			pcall(function()
				remote:FireClient(p, done)
			end)
		end
	end
end

-- ── the ticks ───────────────────────────────────────────────────────────────────────────────────────────────────
local function nearestPlayers(rt: any): (number, number)
	local onFoot, any = math.huge, math.huge
	for _, p in ipairs(playerList) do
		local s = OpsZones.Get(p)
		if s.Alive and s.Pos then
			local d = OpsZones.Nearest(s.Pos, rt.Points)
			if d < any then
				any = d
			end
			if not s.Seated and d < onFoot then
				onFoot = d
			end
		end
	end
	return onFoot, any
end

local function clearOf(radius: number): (Vector3) -> boolean
	return function(pos: Vector3): boolean
		for _, p in ipairs(playerList) do
			local s = OpsZones.Get(p)
			if s.Pos and OpsZones.Within(s.Pos, pos, radius, true) then
				return false
			end
		end
		return true
	end
end

local function standingCount(rt: any): number
	local n = 0
	for _, row in ipairs((rt.Def :: OpsConfig.SiteDef).Garrison) do
		if (row.When == nil or row.When == "Open") and OpsGarrison.RowCFrame(rt, row) ~= nil then
			n += 1
		end
	end
	return n
end

local function wake(rt: any)
	if not OpsGarrison.Reserve(rt) then
		if rt.State ~= "Quiet" then
			OpsSites.DropPrompts(rt)
			ctx.SetState(rt, "Quiet")
		end
		return
	end
	local before = rt.Spawned
	local want = math.min(N.MinGarrison, standingCount(rt))
	local gen = rt.Gen
	OpsGarrison.SpawnRows(rt, nil, nil, function()
		if rt.Gen == gen and want > 0 and rt.Spawned - before < want then
			-- CombatService refused (its cap): never a clearable empty site
			OpsGarrison.Sleep(rt)
			OpsSites.DropPrompts(rt)
			ctx.SetState(rt, "Quiet")
		end
		markSite(rt)
	end)
	if rt.State == "Dormant" or rt.State == "Quiet" then
		ctx.SetState(rt, "Open")
		OpsKinds.Idle(rt)
	end
end

local function wakeTick(nowC: number)
	local wakeCfg = N.Wake
	for _, rt in ipairs(sites) do
		if rt.Live and rt.State ~= "Closed" then
			local def: OpsConfig.SiteDef = rt.Def
			local onFoot, any = nearestPlayers(rt)
			if any <= (def.PresentR or Z.PresentR) then
				rt.LastEntered = nowC
			end
			if rt.Need > 0 then
				local w = wakeCfg[def.Wake] or wakeCfg.Default
				local near = onFoot <= w.OnFoot or any <= w.Any
				if rt.Alloc == 0 and rt.Pending == 0 then
					if near and (rt.State == "Dormant" or rt.State == "Quiet" or rt.State == "Open") then
						wake(rt)
					elseif not near and rt.State == "Quiet" then
						ctx.SetState(rt, "Dormant")
					end
				else
					if any > N.SleepRadius then
						rt.SleepSince = rt.SleepSince or nowC
						if nowC - rt.SleepSince >= N.SleepGraceSeconds then
							rt.SleepSince = nil
							if rt.State == "Active" then
								OpsKinds.End(rt, false, nil)
							end
							OpsGarrison.Sleep(rt)
							if rt.State == "Open" or rt.State == "Quiet" then
								OpsSites.DropPrompts(rt)
								ctx.SetState(rt, "Dormant")
							end
						end
					else
						rt.SleepSince = nil
						if rt.State == "Open" and rt.Pending == 0 and rt.Alloc > 0 then
							local before = rt.NpcCount
							OpsGarrison.SpawnRows(rt, nil, clearOf(N.TopUpClearRadius), function()
								if rt.NpcCount ~= before then
									markSite(rt)
								end
							end)
						end
					end
				end
			elseif rt.State == "Dormant" or rt.State == "Quiet" then
				ctx.SetState(rt, "Open")
				OpsKinds.Idle(rt)
			end
		end
	end
	-- the one-time bank tip (Seen bit BankVisit) within Director.FirstVisitRadius
	local bank = byId["Town.Bank"]
	if bank and bank.Live then
		local bit = OpsConfig.Profile.SeenBits.BankVisit
		for _, p in ipairs(playerList) do
			local s = OpsZones.Get(p)
			local profile = if loaded[p.UserId] then profileOf(p) else nil
			if profile and s.Pos and not OpsZones.HitWithin(p, nowC, D.SkipToastIfHitSeconds)
				and OpsZones.NearAny(s.Pos, bank.Points, D.FirstVisitRadius, true)
				and not OpsRewards.HasSeen(profile, bit)
			then
				OpsRewards.MarkSeen(p, profile, bit)
				ctx.Notify(p, TOAST.BankFirst, "Info")
			end
		end
	end
end

local function timers(nowC: number)
	for _, rt in ipairs(sites) do
		if rt.Live then
			local def: OpsConfig.SiteDef = rt.Def
			if rt.State == "Cooling" and rt.StateUntil and nowC >= rt.StateUntil then
				ctx.SetState(rt, if rt.Alloc > 0 or rt.Need == 0 then "Open" else "Dormant")
				OpsKinds.Reset(rt)
			elseif rt.State == "Held" and rt.StateUntil and nowC >= rt.StateUntil then
				local _, any = nearestPlayers(rt)
				if any > (def.RegarrisonClear or 100) then
					rt.HeldBy = nil
					rt.HeldColor = nil
					OpsSites.HeldSign(rt, nil)
					ctx.SetState(rt, if rt.Need == 0 then "Open" else "Dormant")
					OpsKinds.Reset(rt)
				end
			end
			if rt.DoorClose and rt.State ~= "Active" then
				local _, any = nearestPlayers(rt)
				if any > (def.PresentR or Z.PresentR) then
					rt.DoorClose = false
					OpsSites.SetDoor(rt, false)
				end
			end
		end
	end
end

local function onTeleport(player: Player, prevPos: Vector3?)
	local uid = player.UserId
	for _, rt in ipairs(sites) do
		if rt.Parts[uid] ~= nil then
			rt.Parts[uid] = nil
		end
	end
	-- a bag never travels by teleport or a new character: it drops where the carrier stood
	if prevPos ~= nil and OpsCargo.Carrying(player) ~= nil then
		OpsCargo.DropFor(player, prevPos)
	end
end

--[[ One OpsService tick (Heartbeat accumulator at Zones.TickSeconds). Exposed for the headless drivers. ]]
function OpsService._Step(dt: number)
	if not running then
		return
	end
	local nowC = os.clock()
	playerList = Players:GetPlayers()
	ctx.PlayerList = playerList
	for _, p in ipairs(playerList) do
		OpsZones.SamplePlayer(p, nowC, dt)
	end
	for _, rt in ipairs(sites) do
		if rt.Live then
			local ok, err = pcall(OpsKinds.Tick :: any, rt, dt, nowC)
			if not ok then
				warn("[Ops] tick " .. rt.Id .. ": " .. tostring(err))
			end
		end
	end
	OpsCargo.Tick(nowC)
	timers(nowC)
	wakeAccum += dt
	if wakeAccum >= 1 then
		wakeAccum = 0
		wakeTick(nowC)
	end
	directorAccum += dt
	if directorAccum >= D.TickSeconds then
		directorAccum = 0
		OpsDirector.Tick(sites, nowC, false)
	end
	healthAccum += dt
	if healthAccum >= 30 then
		healthAccum = 0
		healthCheck()
	end
	sendProgress(nowC)
	flushState(nowC)
end

-- ── players ─────────────────────────────────────────────────────────────────────────────────────────────────────
local function onProfileLoaded(player: Player, profile: any)
	if not running or player.Parent == nil then
		return
	end
	local nowU = os.time()
	OpsRewards.Block(profile, nowU)
	OpsRewards.AdoptBankCooldown(profile, nowU)
	loaded[player.UserId] = true
	needFull[player.UserId] = true
	-- "Jobs are on the map · see Missions": once (Seen bit Intro), after the tutorial, while a job is live
	local anyLive = false
	for _, rt in ipairs(sites) do
		if rt.Live then
			anyLive = true
			break
		end
	end
	local bit = OpsConfig.Profile.SeenBits.Intro
	if anyLive and profile.TutorialComplete == true and not OpsRewards.HasSeen(profile, bit) then
		OpsRewards.MarkSeen(player, profile, bit)
		task.delay(8, function()
			if player.Parent then
				ctx.Notify(player, TOAST.Intro, "Info")
			end
		end)
	end
end

local function onRemoving(player: Player)
	local uid = player.UserId
	OpsCargo.OnLeave(player)
	onTeleport(player)
	OpsZones.Forget(player)
	loaded[uid] = nil
	pending[uid] = nil
	pendingAny[uid] = nil
	needFull[uid] = nil
	lastSent[uid] = nil
	nextFull[uid] = nil
	progSite[uid] = nil
end

-- ── public API ──────────────────────────────────────────────────────────────────────────────────────────────────
function OpsService.IsLive(siteId: string): boolean
	local rt = byId[siteId]
	return rt ~= nil and rt.Live == true
end

function OpsService.GetSites(): { { Id: string, State: string } }
	local out: { { Id: string, State: string } } = {}
	for _, rt in ipairs(sites) do
		table.insert(out, { Id = rt.Id, State = if rt.Live then rt.State else "Off" })
	end
	return out
end

function OpsService.IsCarrier(player: Player): boolean
	return OpsCargo.Carrying(player) ~= nil
end

function OpsService.OnJobDone(fn: (player: Player, siteId: string, kind: string, pay: number) -> ()): () -> ()
	return OpsRewards.OnJobDone(fn)
end

local GO_KINDS: { [string]: { [string]: boolean } } = {
	Checkpoint = { Checkpoint = true },
	Camp = { Camp = true },
	Uplink = { Uplink = true },
	Hostiles = { Checkpoint = true, Camp = true },
	Cargo = { VaultLite = true, Cargo = true }, -- lane M1: the Haul Cargo daily op (Delivery)
}

--[[ MissionService hook (lane M1): every Open site for a Go key (the client picks the nearest). nil = not an Ops
	key, or the bank is not an Ops site yet (MissionService keeps its own resolver). ]]
function OpsService.GoTargets(goKey: string): { { X: number, Y: number, Z: number } }?
	if not running then
		return nil
	end
	local function point(rt: any): { X: number, Y: number, Z: number }
		local p: Vector3 = rt.Target.Position
		return { X = r0(p.X), Y = r0(p.Y), Z = r0(p.Z) }
	end
	if goKey == "Bank" then
		local bank = byId["Town.Bank"]
		if bank == nil or not bank.Live then
			return nil
		end
		return { point(bank) }
	end
	local kinds = GO_KINDS[goKey]
	if kinds == nil and goKey ~= "Job" then
		return nil
	end
	local out: { { X: number, Y: number, Z: number } } = {}
	for _, rt in ipairs(sites) do
		local def: OpsConfig.SiteDef = rt.Def
		if rt.Live and (rt.State == "Open" or rt.State == "Dormant") and (kinds == nil or kinds[def.Kind]) then
			table.insert(out, point(rt))
		end
	end
	return out
end

--[[ MissionService hook: is an Ops objective type live (some live site reports it)? nil = not an Ops type, or the
	Heist while the bank is not an Ops site (BankRaidService reports it until the cutover). ]]
function OpsService.ObjectiveLive(objectiveType: string): boolean?
	if not running or table.find(OpsConfig.TrackTypes, objectiveType) == nil then
		return nil
	end
	if objectiveType == "Heist" then
		local bank = byId["Town.Bank"]
		return if bank and bank.Live then true else nil
	end
	for _, rt in ipairs(sites) do
		if rt.Live then
			local kind = OpsConfig.Kinds[(rt.Def :: OpsConfig.SiteDef).Kind]
			if kind and table.find(kind.Track, objectiveType) ~= nil then
				return true
			end
		end
	end
	return false
end

-- headless drivers only: the shared state
function OpsService._Ctx(): any
	ctx.SitesList = sites
	ctx.ById = byId
	ctx.OffReason = offReason
	ctx.Running = running
	return ctx
end

-- ── Init ────────────────────────────────────────────────────────────────────────────────────────────────────────
local function cashExempt(): boolean
	local ok, cfg = pcall(function(): any
		return require(Shared.Configs.MonetizationConfig) :: any
	end)
	if not ok or typeof(cfg) ~= "table" then
		return false
	end
	local ex = cfg.CashMultExemptReasons
	return typeof(ex) == "table" and ex[OpsConfig.Rewards.CashReason] == true
end

function OpsService.Init(deps: { [string]: any })
	if running then
		return
	end
	if OpsConfig.Enabled ~= true then
		print("[Ops] OpsService off (OpsConfig.Enabled = false)")
		return
	end
	local problems = OpsConfig.Validate()
	if #problems > 0 then
		warn("[Ops] OpsService off: OpsConfig.Validate: " .. table.concat(problems, "; "))
		return
	end
	if OpsConfig.Rewards.RequireCashExempt and not cashExempt() then
		warn('[Ops] OpsService off: MonetizationConfig.CashMultExemptReasons has no "ops" (job pay must never be pass-multiplied)')
		return
	end
	if deps.RateLimitService == nil or typeof(deps.RateLimitService.Allow) ~= "function" then
		warn("[Ops] OpsService off: RateLimitService missing (every prompt is rate-limited)")
		return
	end
	if Z.RateLimitKey ~= "ops_prompt" then
		warn("[Ops] Zones.RateLimitKey is " .. tostring(Z.RateLimitKey) .. "; OpsService uses ops_prompt")
	end
	DataService = deps.DataService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	NotificationService = deps.NotificationService
	MissionService = deps.MissionService
	CombatService = deps.CombatService
	BaseService = deps.BaseService
	NationColorService = deps.NationColorService
	running = true

	OpsRewards.Init(deps)
	OpsZones.Init(deps, onTeleport)
	OpsGarrison.Init(deps, function(rt: any, _info: any)
		markSite(rt)
	end)
	OpsCargo.Init(ctx)
	OpsSites.Init(ctx)
	OpsKinds.Init(ctx)
	OpsDirector.Init(ctx)

	sites = {}
	byId = {}
	for i, def in ipairs(OpsConfig.Sites) do
		local rt = newRecord(def, i)
		table.insert(sites, rt)
		byId[def.Id] = rt
	end

	if CombatService and typeof(CombatService.OnPlayerDeath) == "function" then
		pcall(CombatService.OnPlayerDeath, function(victim: Player, _killer: Player?, _info: any)
			OpsCargo.OnDeath(victim)
		end)
	end
	if DataService and typeof(DataService.OnProfileLoaded) == "function" then
		DataService.OnProfileLoaded(onProfileLoaded)
	end
	Players.PlayerRemoving:Connect(onRemoving)
	if MissionService and typeof(MissionService.SetOpsHooks) == "function" then
		local ok, err = pcall(MissionService.SetOpsHooks, { GoTargets = OpsService.GoTargets, ObjectiveLive = OpsService.ObjectiveLive })
		if not ok then
			warn("[Ops] MissionService.SetOpsHooks failed: " .. tostring(err))
		end
	end

	-- the world dressing (and its anchors) is built a few frames after MapSetup: resolve shortly after, then the
	-- 30 s health check re-resolves sites still waiting for anchors
	task.delay(3, function()
		resolveAll(false)
	end)

	RunService.Heartbeat:Connect(function(dt: number)
		accum += dt
		if accum < Z.TickSeconds then
			return
		end
		local step = accum
		accum = 0
		local ok, err = pcall(OpsService._Step :: any, step)
		if not ok then
			warn("[Ops] step failed: " .. tostring(err))
		end
	end)
	print("[Ops] OpsService running (" .. #sites .. " sites configured)")
end

-- headless drivers: resolve now (instead of the 3 s delay)
function OpsService._Resolve()
	resolveAll(false)
end

return OpsService
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">OpsCargo</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsCargo — carried bags and boxes (W3 step 2 Phase B, lane O; contract §4.3, activities §2.4). SERVER ONLY.

	* One carried item per player: 1 welded part (Cargo.BagSize, Fabric, Massless, CanCollide / CanQuery / CanTouch
	  false) on the back, and one stud-scaled WorldLabel "BAG" / "BOX" over the head (red, MaxDistance
	  Ui.LabelMaxDistance, never drawn on top of walls). Its value was fixed on the SERVER when it was grabbed.
	* Deadline Cargo.DeadlineSeconds ("Bag lost" after). Vehicles may carry it (Cargo.AllowVehicles).
	* On death (CombatService.OnPlayerDeath) it drops: 1 anchored, CanCollide-false part with a "Pick up bag" prompt
	  (hold Cargo.PickupHold, distance Cargo.PickupDist) for Cargo.DropLifetimeSeconds. The 4th drop (MaxHandoffs 3)
	  destroys it. A picker who is not the grabber gets Cargo.PickerMult of the value and a fresh deadline; picking
	  up never sets the picker's cooldown.
	* Delivered only inside the carrier's OWN plot square (|dx|, |dz| <= PlotSize / 2 + DeliveryPad); no plot ->
	  within Cargo.FallbackRadius of Cargo.FallbackHome. Leaving the game destroys it. Bags are never saved.
	* At most Cargo.MaxBagsInWorld carried + dropped across all sites (the 512-stud circle budget, spec §3).
	* Carriers are revealed to non-allies on OpsPing every Remote.PingSeconds, never while the carrier is a novice.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local PlotFrame = require(Shared.Util.PlotFrame)
local WorldLabel = require(Shared.Util.WorldLabel)

local C = OpsConfig.Cargo

local OpsCargo = {}

export type Bag = {
	Id: number,
	Site: string,
	Kind: string,
	Value: number, -- the grabber's pay, fixed at grab time (server)
	XP: number,
	Grabber: number, -- UserId
	Carrier: Player?,
	Drops: number,
	Deadline: number, -- os.clock
	Part: BasePart?,
	Label: BillboardGui?,
	Prompt: ProximityPrompt?,
	DroppedAt: number?, -- os.clock
	DropPos: Vector3?,
	LastCarrier: number,
	LastPos: Vector3?, -- the carrier's last live position (the fallback drop point)
	PingedMove: boolean,
	NextPing: number,
}

local bags: { Bag } = {}
local byCarrier: { [number]: Bag } = {}
local serial = 0
local ctx: any = nil
local folder: Folder? = nil

local RED = Color3.fromRGB(230, 70, 60)

function OpsCargo.Init(context: any)
	ctx = context
end

function OpsCargo.Count(): number
	return #bags
end

function OpsCargo.CanAdd(): boolean
	return #bags < C.MaxBagsInWorld
end

function OpsCargo.Carrying(player: Player): Bag?
	return byCarrier[player.UserId]
end

function OpsCargo.All(): { Bag }
	return bags
end

local function dropFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local existing = Workspace:FindFirstChild("WE_OpsBags")
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local nf = Instance.new("Folder")
	nf.Name = "WE_OpsBags"
	nf.Parent = Workspace
	folder = nf
	return nf
end

local function clearVisual(b: Bag)
	if b.Prompt then
		b.Prompt:Destroy()
		b.Prompt = nil
	end
	if b.Label then
		b.Label:Destroy()
		b.Label = nil
	end
	if b.Part then
		b.Part:Destroy()
		b.Part = nil
	end
end

local function makePart(): Part
	local p = Instance.new("Part")
	p.Name = "WE_OpsBag"
	p.Size = C.BagSize
	p.Material = Enum.Material.Fabric
	p.Color = Color3.fromRGB(70, 62, 48)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	return p
end

local function labelText(b: Bag): string
	local kind = OpsConfig.Kinds[b.Kind]
	return (kind and kind.CarryLabel) or "BAG"
end

-- the carried part on the character's back + the head label
local function attach(b: Bag, player: Player): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and root and root:IsA("BasePart")) then
		return false
	end
	local p = makePart()
	p.CFrame = root.CFrame * CFrame.new(0, 0.2, 0.5 + C.BagSize.Z * 0.5)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = p
	weld.Parent = p
	p.Parent = char
	b.Part = p
	b.Label = WorldLabel.Create(p, labelText(b), {
		Name = "WE_OpsBagLabel",
		Color = RED,
		Offset = Vector3.new(0, 3.2, 0),
		MaxDistance = OpsConfig.Ui.LabelMaxDistance,
	})
	return true
end

local function remove(b: Bag)
	clearVisual(b)
	local i = table.find(bags, b)
	if i then
		table.remove(bags, i)
	end
	if b.Carrier then
		byCarrier[b.Carrier.UserId] = nil
		b.Carrier = nil
	end
end

--[[ A new bag on `player` (the grab). Returns nil when the world already holds MaxBagsInWorld bags, the player
	already carries one, or has no character. ]]
function OpsCargo.Grab(player: Player, site: OpsConfig.SiteDef, value: number, xp: number): Bag?
	if not OpsCargo.CanAdd() or byCarrier[player.UserId] ~= nil then
		return nil
	end
	serial += 1
	local b: Bag = {
		Id = serial,
		Site = site.Id,
		Kind = site.Kind,
		Value = value,
		XP = xp,
		Grabber = player.UserId,
		Carrier = player,
		Drops = 0,
		Deadline = os.clock() + C.DeadlineSeconds, -- a carry time, never Studio-scaled
		Part = nil,
		Label = nil,
		Prompt = nil,
		DroppedAt = nil,
		DropPos = nil,
		LastCarrier = player.UserId,
		LastPos = nil,
		PingedMove = false,
		NextPing = os.clock() + OpsConfig.Remote.PingSeconds,
	}
	if not attach(b, player) then
		return nil
	end
	table.insert(bags, b)
	byCarrier[player.UserId] = b
	ctx.Rewards.Log(ctx.Events.BAG_GRAB, player.UserId, { site = site.Id, value = value })
	ctx.MarkAllBags()
	return b
end

-- what `player` would be paid for this bag
function OpsCargo.ValueFor(b: Bag, player: Player): number
	if player.UserId == b.Grabber then
		return b.Value
	end
	return math.floor(b.Value * C.PickerMult + 0.5)
end

local function dropAt(b: Bag, pos: Vector3)
	local carrier = b.Carrier
	if carrier then
		byCarrier[carrier.UserId] = nil
		b.LastCarrier = carrier.UserId
		b.Carrier = nil
	end
	clearVisual(b)
	b.Drops += 1
	if b.Drops > C.MaxHandoffs then
		remove(b)
		ctx.MarkAllBags()
		return
	end
	local p = makePart()
	p.Anchored = true
	p.CanQuery = true -- the prompt's part; still no collision
	p.CFrame = CFrame.new(pos.X, math.max(pos.Y - 2, 1.5), pos.Z) -- the root stands ~3 above the ground
	p.Parent = dropFolder()
	b.Part = p
	b.DroppedAt = os.clock()
	b.DropPos = p.Position
	b.Label = WorldLabel.Create(p, labelText(b), {
		Name = "WE_OpsBagLabel",
		Color = RED,
		Offset = Vector3.new(0, 2, 0),
		MaxDistance = OpsConfig.Ui.LabelMaxDistance,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WE_OpsPrompt"
	prompt.ActionText = OpsConfig.Text.Prompts.PickUpBag
	local site = OpsConfig.Get(b.Site)
	prompt.ObjectText = if site then site.Name else ""
	prompt.HoldDuration = C.PickupHold
	prompt.MaxActivationDistance = C.PickupDist
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	b.Prompt = prompt
	local bagRef = b
	prompt.Triggered:Connect(function(player: Player)
		ctx.OnBagPrompt(bagRef, player)
	end)
	ctx.Rewards.Log(ctx.Events.BAG_DROP, b.LastCarrier, { site = b.Site, drops = b.Drops })
	ctx.MarkAllBags()
end

-- a teleport or a new character while carrying: the bag drops at the carrier's previous position
function OpsCargo.DropFor(player: Player, pos: Vector3)
	local b = byCarrier[player.UserId]
	if b ~= nil then
		dropAt(b, pos)
	end
end

-- the carrier died: the bag drops where the root was
function OpsCargo.OnDeath(player: Player)
	local b = byCarrier[player.UserId]
	if b == nil then
		return
	end
	local pos: Vector3? = nil
	local s = ctx.Zones.Get(player)
	if s and s.Pos then
		pos = s.Pos
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		pos = root.Position
	end
	if pos == nil then
		remove(b)
		ctx.MarkAllBags()
		return
	end
	dropAt(b, pos)
end

--[[ A validated pickup (OpsService re-checked rate limit, alive, distance, on foot, not carrying, not locked). ]]
function OpsCargo.PickUp(b: Bag, player: Player): boolean
	if b.Carrier ~= nil or b.Part == nil or table.find(bags, b) == nil or byCarrier[player.UserId] ~= nil then
		return false
	end
	clearVisual(b)
	b.Carrier = player
	b.DroppedAt = nil
	b.DropPos = nil
	b.Deadline = os.clock() + C.DeadlineSeconds
	b.LastCarrier = player.UserId
	if not attach(b, player) then
		remove(b)
		ctx.MarkAllBags()
		return false
	end
	byCarrier[player.UserId] = b
	ctx.Rewards.Log(ctx.Events.BAG_PICKUP, player.UserId, { site = b.Site, picked = player.UserId ~= b.Grabber })
	ctx.MarkAllBags()
	return true
end

-- the carrier left the game: the bag is gone (never saved)
function OpsCargo.OnLeave(player: Player)
	local b = byCarrier[player.UserId]
	if b then
		remove(b)
		ctx.MarkAllBags()
	end
end

-- the player's delivery square: own plot (position, half size) or the fallback point (radius)
function OpsCargo.HomeOf(player: Player): (Vector3, number, boolean)
	local plotId = ctx.PlotOf(player)
	if plotId ~= nil then
		local pos = PlotFrame.PlotPosition(plotId)
		if pos then
			return pos, BaseConfig.PlotSize.X * 0.5 + C.DeliveryPad, true
		end
	end
	return Vector3.new(C.FallbackHome.X, 0, C.FallbackHome.Z), C.FallbackRadius, false
end

-- OpsStatePayload.Home: own plot centre moved HomeTowardGate toward the front gate, else FallbackHome
function OpsCargo.HomePoint(player: Player): { X: number, Z: number }
	local plotId = ctx.PlotOf(player)
	if plotId ~= nil then
		local ok, p = pcall(PlotFrame.LocalToWorld, plotId, 0, C.HomeTowardGate)
		if ok and typeof(p) == "Vector3" then
			return { X = math.floor(p.X + 0.5), Z = math.floor(p.Z + 0.5) }
		end
	end
	return { X = C.FallbackHome.X, Z = C.FallbackHome.Z }
end

local function inHome(player: Player, pos: Vector3): boolean
	local centre, half, square = OpsCargo.HomeOf(player)
	local dx, dz = math.abs(pos.X - centre.X), math.abs(pos.Z - centre.Z)
	if square then
		return dx <= half and dz <= half
	end
	return dx * dx + dz * dz <= half * half
end

local function novice(player: Player): boolean
	local profile = ctx.Profile(player)
	if profile == nil then
		return true
	end
	local first = tonumber(profile.FirstJoinUnix)
	if first ~= nil and os.time() - first < C.NoviceSeconds then
		return true
	end
	if profile.NoviceShieldDone == false then
		return true
	end
	return false
end
OpsCargo.IsNovice = novice

--[[ 4 Hz: deliveries, deadlines, dropped-bag lifetimes, carrier pings. ]]
function OpsCargo.Tick(nowC: number)
	local i = 1
	while i <= #bags do
		local b = bags[i]
		local carrier = b.Carrier
		local gone = false
		if carrier then
			if carrier.Parent == nil then
				remove(b)
				ctx.MarkAllBags()
				gone = true
			elseif nowC >= b.Deadline then
				remove(b)
				ctx.Notify(carrier, OpsConfig.Text.Toast.BagLost, "Warn")
				ctx.Rewards.Log(ctx.Events.BAG_DROP, carrier.UserId, { site = b.Site, lost = true })
				ctx.MarkAllBags()
				gone = true
			else
				local s = ctx.Zones.Get(carrier)
				if not s.Alive or b.Part == nil or b.Part.Parent == nil then
					-- a death or a lost character the death event missed: the bag drops where the carrier last was
					-- (never re-attached to a new character: a reset is not a free trip home)
					if b.LastPos ~= nil then
						dropAt(b, b.LastPos)
					else
						remove(b)
						ctx.MarkAllBags()
					end
					gone = true
				elseif s.Pos then
					b.LastPos = s.Pos
				end
				if not gone and s.Pos and not ctx.Zones.Locked(carrier, nowC) and inHome(carrier, s.Pos) then
					remove(b)
					ctx.Deliver(carrier, b)
					ctx.MarkAllBags()
					gone = true
				end
				if not gone and nowC >= b.NextPing then
					b.NextPing = nowC + OpsConfig.Remote.PingSeconds
					if not novice(carrier) then
						ctx.Ping(carrier, b)
					end
				end
			end
		elseif b.DroppedAt ~= nil and nowC - b.DroppedAt >= C.DropLifetimeSeconds then
			remove(b)
			ctx.MarkAllBags()
			gone = true
		end
		if not gone then
			i += 1
		end
	end
end

-- OpsStatePayload.Carrying for this player (nil = not carrying)
function OpsCargo.CarrySnap(player: Player, nowC: number): OpsConfig.OpsCarrySnap?
	local b = byCarrier[player.UserId]
	if b == nil then
		return nil
	end
	return {
		Site = b.Site,
		Kind = b.Kind,
		Value = OpsCargo.ValueFor(b, player),
		Left = math.max(0, math.ceil(b.Deadline - nowC)),
		Picked = player.UserId ~= b.Grabber,
	}
end

-- OpsStatePayload.Bags: dropped bags anyone may pick up
function OpsCargo.BagSnaps(nowC: number): { OpsConfig.OpsBagSnap }
	local out: { OpsConfig.OpsBagSnap } = {}
	for _, b in ipairs(bags) do
		local p = b.DropPos
		if b.Carrier == nil and p ~= nil and b.DroppedAt ~= nil then
			table.insert(out, {
				U = b.LastCarrier,
				X = math.floor(p.X + 0.5),
				Z = math.floor(p.Z + 0.5),
				Age = math.floor(nowC - b.DroppedAt),
				Site = b.Site,
			})
		end
	end
	return out
end

function OpsCargo.Clear()
	for _, b in ipairs(table.clone(bags)) do
		remove(b)
	end
end

return OpsCargo
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">OpsDirector</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsDirector — which BIG job sites are open (W3 step 2 Phase B, lane O; activities §2.1, contract §4.6). SERVER ONLY.
	It replaces the roadmap's EventDirectorService (spec §1.9): one authority for what is open and announced.

	* Director.BigOpenMax (3) big sites are open at once: every live Pinned site (the bank) plus rotating slots.
	* Small sites (checkpoints, caches, camps, forts, rigs) are never closed here.
	* Every Director.TickSeconds: an open rotating site that nobody entered for IdleRotateSeconds (and is not Active)
	  closes; a free slot opens the closed site with the best score:
	      score = sum over players of 1 / (1 + d(player's plot, site) / DistScale) + AgeWeight x (seconds since it last
	      closed) / AgeUnitSeconds
	* When a big site opens, "<Title> is open" goes to players whose own plot is within OpenToastRadius, at most once
	  per OpenToastGapSeconds each, never while they were hit in the last SkipToastIfHitSeconds.
	* Director.Events (Supply Run, Vault Window) is Phase C and stays off.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)
local PlotFrame = require(Shared.Util.PlotFrame)

local D = OpsConfig.Director

local OpsDirector = {}

local ctx: any = nil

function OpsDirector.Init(context: any)
	ctx = context
end

local function rotating(rt: any): boolean
	local d: OpsConfig.SiteDef = rt.Def
	return d.Big and d.Pinned ~= true
end
OpsDirector.Rotating = rotating

function OpsDirector.Slots(sites: { any }): number
	local pinned = 0
	for _, rt in ipairs(sites) do
		if rt.Live and (rt.Def :: OpsConfig.SiteDef).Big and (rt.Def :: OpsConfig.SiteDef).Pinned == true then
			pinned += 1
		end
	end
	return math.max(0, D.BigOpenMax - pinned)
end

function OpsDirector.Score(rt: any, nowC: number): number
	local score = 0
	local pos: Vector3 = rt.Target.Position
	for _, p in ipairs(ctx.PlayerList) do
		local plotId = ctx.PlotOf(p)
		local plotPos = if plotId then PlotFrame.PlotPosition(plotId) else nil
		if plotPos then
			local dx, dz = plotPos.X - pos.X, plotPos.Z - pos.Z
			score += 1 / (1 + math.sqrt(dx * dx + dz * dz) / D.DistScale)
		end
	end
	local age = nowC - (rt.ClosedAt or (nowC - D.AgeUnitSeconds))
	return score + D.AgeWeight * math.max(0, age) / D.AgeUnitSeconds
end

-- "<Title> is open" to players whose plot is near (throttled per player; never while being shot at)
local function announce(rt: any, nowC: number)
	local d: OpsConfig.SiteDef = rt.Def
	local pos: Vector3 = rt.Target.Position
	for _, p in ipairs(ctx.PlayerList) do
		local plotId = ctx.PlotOf(p)
		local plotPos = if plotId then PlotFrame.PlotPosition(plotId) else nil
		if plotPos and not ctx.Zones.HitWithin(p, nowC, D.SkipToastIfHitSeconds) then
			local dx, dz = plotPos.X - pos.X, plotPos.Z - pos.Z
			if dx * dx + dz * dz <= D.OpenToastRadius * D.OpenToastRadius then
				ctx.NotifyThrottled(p, string.format(OpsConfig.Text.Toast.Open, d.Title), "Info", D.OpenToastGapSeconds, "ops_open")
			end
		end
	end
end

function OpsDirector.Close(rt: any, nowC: number)
	rt.ClosedAt = nowC
	ctx.Garrison.Sleep(rt)
	ctx.Sites.DropPrompts(rt)
	ctx.SetState(rt, "Closed")
end

function OpsDirector.Open(rt: any, nowC: number, quiet: boolean?)
	rt.LastEntered = nowC
	ctx.SetState(rt, if rt.Need > 0 then "Dormant" else "Open")
	ctx.Kinds.Reset(rt)
	ctx.Rewards.Log(ctx.Events.OPS_OPEN, nil, { site = rt.Id })
	if not quiet then
		announce(rt, nowC)
	end
end

--[[ Every Director.TickSeconds (and once when the sites resolve). ]]
function OpsDirector.Tick(sites: { any }, nowC: number, quiet: boolean?)
	local slots = OpsDirector.Slots(sites)
	local open = 0
	local closed: { any } = {}
	for _, rt in ipairs(sites) do
		if rt.Live and rotating(rt) then
			if rt.State == "Closed" then
				table.insert(closed, rt)
			else
				local idle = nowC - (rt.LastEntered or nowC) >= D.IdleRotateSeconds
				if idle and (rt.State == "Open" or rt.State == "Dormant" or rt.State == "Quiet") then
					OpsDirector.Close(rt, nowC)
					table.insert(closed, rt)
				else
					open += 1
				end
			end
		end
	end
	if open >= slots or #closed == 0 then
		return
	end
	local scored: { { Rt: any, S: number } } = {}
	for _, rt in ipairs(closed) do
		table.insert(scored, { Rt = rt, S = OpsDirector.Score(rt, nowC) })
	end
	table.sort(scored, function(a, b)
		if a.S ~= b.S then
			return a.S > b.S
		end
		return a.Rt.Order < b.Rt.Order
	end)
	for _, e in ipairs(scored) do
		if open >= slots then
			break
		end
		-- a site that just rotated out waits one tick before it may come back (unless nothing else can open)
		if e.Rt.ClosedAt ~= nowC or #scored <= slots - open then
			OpsDirector.Open(e.Rt, nowC, quiet)
			open += 1
		end
	end
end

return OpsDirector
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">OpsGarrison</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsGarrison — the NPC ledger and each job site's guards (W3 step 2 Phase B, lane O; spec §4, contract §4.3).
	SERVER ONLY. Every NPC goes through lane N's CombatService API (called with nil checks and pcall):
	  SpawnNPC(type, homeCFrame, { GroupId = siteId, NoRespawn = true, Home, Leash, Stance, ProvokeRadius, Static })
	  OnNPCDeath(fn) / DespawnNPC(id) / ProvokeGroup(groupId) / CalmGroup(groupId) / NPCCounts()
	CombatService keeps the hard cap (CombatConfig.MaxActiveNPCs 18 regular, +SpecialOverCap for special types); the
	NPC line-of-sight and hit-chance code is untouched (combat fairness), and nothing here aims or fires.

	Ledger (Npc.*): Budget 18 regular slots for all sites. A site reserves its Need when it wakes (standing posts +
	reinforcements present on this build, or the wave cap for uplinks / the holdout). A site whose NPCs are all special
	types (CombatConfig.SpecialNPCTypes) may use the EventReserve 4 only when the regular budget is short. Fewer than
	MinGarrison free slots -> the site is Quiet. Before the cutover the legacy field / bank NPCs still stand, so the
	free count is also capped by what CombatService would accept (NPCCounts, when lane N has landed).

	Without lane N (no OnNPCDeath / DespawnNPC / ProvokeGroup / CalmGroup) a 2-argument SpawnNPC respawns its NPCs
	for ever, so every site that needs NPCs stays Off (OpsSites asks CoreReady()).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)
local CombatConfig = require(Shared.Configs.CombatConfig)

local N = OpsConfig.Npc

local OpsGarrison = {}

local CombatService: any = nil
local onDeath: ((any, any) -> ())? = nil -- (rt, info) -> OpsService
local npcSite: { [string]: any } = {} -- npc id -> site runtime record
local used = 0 -- regular ledger slots reserved by awake sites
local usedEvent = 0 -- EventReserve slots reserved by awake special-type sites
local deathConn: (() -> ())? = nil

function OpsGarrison.Init(deps: { [string]: any }, deathFn: (any, any) -> ())
	CombatService = deps.CombatService
	onDeath = deathFn
	if deathConn == nil and CombatService and CombatService.OnNPCDeath then
		local ok, disc = pcall(CombatService.OnNPCDeath, function(info: any)
			if typeof(info) ~= "table" or typeof(info.Id) ~= "string" then
				return
			end
			local rt = npcSite[info.Id]
			if rt == nil then
				return
			end
			npcSite[info.Id] = nil
			local e = rt.Npcs[info.Id]
			rt.Npcs[info.Id] = nil
			if e ~= nil then
				rt.NpcCount -= 1
				rt.Killed += 1
				if e.Row ~= nil and rt.RowNpc[e.Row] == info.Id then
					rt.RowNpc[e.Row] = nil
				end
				if e.Row ~= nil then
					rt.RowDeadAt = rt.RowDeadAt or {}
					rt.RowDeadAt[e.Row] = os.clock()
				end
			end
			if onDeath then
				onDeath(rt, info)
			end
		end)
		if ok and typeof(disc) == "function" then
			deathConn = disc
		end
	end
end

-- lane N's API is in (without it grouped, no-respawn NPCs are impossible)
function OpsGarrison.CoreReady(): boolean
	local cs = CombatService
	return cs ~= nil
		and typeof(cs.SpawnNPC) == "function"
		and typeof(cs.OnNPCDeath) == "function"
		and typeof(cs.DespawnNPC) == "function"
		and typeof(cs.ProvokeGroup) == "function"
		and typeof(cs.CalmGroup) == "function"
end

-- the NPC type to spawn for a garrison row (nil = missing: the site is off). CampCommander falls back until lane N
function OpsGarrison.TypeFor(typeId: string): string?
	local types: any = CombatConfig.NPCTypes
	if types[typeId] ~= nil then
		return typeId
	end
	if typeId == N.CommanderType and types[N.CommanderFallback] ~= nil then
		return N.CommanderFallback
	end
	return nil
end

function OpsGarrison.IsSpecial(typeId: string): boolean
	local list: any = (CombatConfig :: any).SpecialNPCTypes
	if typeof(list) ~= "table" then
		list = { "BankGuard", "OilRigGuard", "FortGuard" } -- today's hard-coded list (CombatService.SpawnNPC)
	end
	return table.find(list, typeId) ~= nil
end

-- the standing-surface point of a garrison row (anchor or config At); nil = not built on this quality
function OpsGarrison.RowCFrame(rt: any, row: OpsConfig.GarrisonPost): CFrame?
	if row.At ~= nil then
		local at = row.At
		return CFrame.new(at.X, at.Y, at.Z) * CFrame.Angles(0, math.rad(at.Yaw), 0)
	end
	local a = row.Post and rt.Anchors[row.Post]
	return if a then a.CFrame else nil
end

--[[ Slots this site needs when it wakes: standing + reinforcement rows present on this build; sites with waves
	need the wave cap (Npc.WaveMaxAlive), which also covers their standing posts. ]]
function OpsGarrison.Need(rt: any): number
	local def: OpsConfig.SiteDef = rt.Def
	local n = 0
	for _, row in ipairs(def.Garrison) do
		if OpsGarrison.RowCFrame(rt, row) ~= nil then
			n += 1
		end
	end
	if def.Waves ~= nil and #def.Waves > 0 then
		n = math.max(n, N.WaveMaxAlive)
	end
	return n
end

local function allSpecial(rt: any): boolean
	local def: OpsConfig.SiteDef = rt.Def
	if #def.Garrison == 0 then
		return false
	end
	for _, row in ipairs(def.Garrison) do
		if not OpsGarrison.IsSpecial(OpsGarrison.TypeFor(row.Type) or row.Type) then
			return false
		end
	end
	return def.Waves == nil
end

local function opsAlive(): number
	local n = 0
	for _ in pairs(npcSite) do
		n += 1
	end
	return n
end

-- regular slots free right now (the ledger, and what CombatService would still accept)
function OpsGarrison.Free(): number
	local free = N.Budget - used
	local cs = CombatService
	if cs and typeof(cs.NPCCounts) == "function" then
		local ok, c = pcall(cs.NPCCounts)
		if ok and typeof(c) == "table" and typeof(c.Total) == "number" then
			local others = math.max(0, c.Total - opsAlive())
			local cap = tonumber((CombatConfig :: any).MaxActiveNPCs) or N.Budget
			free = math.min(free, cap - others - used)
		end
	end
	return math.max(0, free)
end

function OpsGarrison.Ledger(): (number, number)
	return used, usedEvent
end

--[[ Reserve this site's slots. Returns false (nothing reserved) when fewer than MinGarrison could be had: Quiet. ]]
function OpsGarrison.Reserve(rt: any): boolean
	if rt.Alloc > 0 then
		return true
	end
	local need = OpsGarrison.Need(rt)
	if need <= 0 then
		return true
	end
	local free = OpsGarrison.Free()
	local reg = math.min(need, free)
	local ev = 0
	if reg < need and allSpecial(rt) then
		ev = math.min(need - reg, math.max(0, N.EventReserve - usedEvent))
	end
	if reg + ev < math.min(need, N.MinGarrison) then
		return false
	end
	used += reg
	usedEvent += ev
	rt.Alloc = reg + ev
	rt.AllocEvent = ev
	return true
end

function OpsGarrison.Release(rt: any)
	used = math.max(0, used - (rt.Alloc - rt.AllocEvent))
	usedEvent = math.max(0, usedEvent - rt.AllocEvent)
	rt.Alloc = 0
	rt.AllocEvent = 0
end

-- a clear point for a Probe anchor / wave point (Npc.ProbeClear, searched out to Npc.ProbeSearch); nil = none
function OpsGarrison.ClearPoint(p: Vector3, ignore: { Instance }?): Vector3?
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	local function clear(q: Vector3): boolean
		local box = Vector3.new(N.ProbeClear * 2 + 2, 5, N.ProbeClear * 2 + 2)
		local ok, parts = pcall(function()
			return Workspace:GetPartBoundsInBox(CFrame.new(q + Vector3.new(0, 2.6, 0)), box, params)
		end)
		if not ok or typeof(parts) ~= "table" then
			return true
		end
		for _, part in ipairs(parts :: { any }) do
			if part:IsA("BasePart") and part.CanCollide and part.Anchored then
				return false
			end
		end
		return true
	end
	if clear(p) then
		return p
	end
	local step = 2
	local r = step
	while r <= N.ProbeSearch do
		for i = 0, 7 do
			local a = i * math.pi / 4
			local q = p + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			if clear(q) then
				return q
			end
		end
		r += step
	end
	return nil
end

-- the nearest standing post of the site to p (Probe / wave fallback)
function OpsGarrison.NearestPost(rt: any, p: Vector3, roles: { string }?): CFrame?
	local best: CFrame? = nil
	local bestD = math.huge
	local function consider(cf: CFrame?)
		if cf then
			local d = (cf.Position - p).Magnitude
			if d < bestD then
				best, bestD = cf, d
			end
		end
	end
	if roles then
		for _, role in ipairs(roles) do
			local a = rt.Anchors[role]
			consider(if a then a.CFrame else nil)
		end
	else
		for _, row in ipairs((rt.Def :: OpsConfig.SiteDef).Garrison) do
			if row.When == nil or row.When == "Open" then
				consider(OpsGarrison.RowCFrame(rt, row))
			end
		end
	end
	return best
end

local function spawnOne(rt: any, typeId: string, home: CFrame, opts: { [string]: any }, rowIdx: number?, extra: boolean): boolean
	local cs = CombatService
	if cs == nil or typeof(cs.SpawnNPC) ~= "function" then
		return false
	end
	local tid = OpsGarrison.TypeFor(typeId)
	if tid == nil then
		return false
	end
	local at = home + Vector3.new(0, N.RootLift, 0)
	opts.GroupId = rt.Id
	opts.NoRespawn = true
	opts.Home = at
	local ok, rec = pcall(cs.SpawnNPC, tid, at, opts)
	if not ok then
		warn("[Ops] SpawnNPC failed at " .. rt.Id .. ": " .. tostring(rec))
		return false
	end
	if typeof(rec) ~= "table" or typeof(rec.Id) ~= "string" then
		return false
	end
	npcSite[rec.Id] = rt
	rt.Npcs[rec.Id] = { Rec = rec, Row = rowIdx, Extra = extra, Home = at }
	rt.NpcCount += 1
	rt.Spawned += 1
	if rowIdx ~= nil then
		rt.RowNpc[rowIdx] = rec.Id
	end
	return true
end

-- room for one more NPC at this site (its reservation)
function OpsGarrison.HasRoom(rt: any): boolean
	return rt.NpcCount + rt.Pending < rt.Alloc
end

local function optsFor(rt: any, row: OpsConfig.GarrisonPost): { [string]: any }
	local def: OpsConfig.SiteDef = rt.Def
	local stance = if row.Static then "Post" else row.Stance
	local o: { [string]: any } = { Stance = stance, Leash = row.Leash, Static = row.Static }
	if stance == "Passive" then
		o.ProvokeRadius = def.ProvokeRadius or N.DefaultProvokeRadius
	end
	return o
end

--[[ Spawn the garrison rows whose When matches (nil / "Open" = the standing garrison), staggered
	SpawnStaggerSeconds apart, within the site's reservation. Rows that already have a live NPC are skipped. Probe
	anchors are clearance-tested once; no clear point -> the nearest standing post. `playersClear(p)` (optional):
	only spawn a row when it returns true (the Open top-up rule). `done()` runs after the last spawn. ]]
function OpsGarrison.SpawnRows(rt: any, when: string?, playersClear: ((Vector3) -> boolean)?, done: (() -> ())?)
	local def: OpsConfig.SiteDef = rt.Def
	local want = when or "Open"
	local batch: { { Idx: number, Row: OpsConfig.GarrisonPost, CF: CFrame } } = {}
	-- the Open top-up (playersClear given) never brings a killed guard back sooner than the respawn delay: a player
	-- outside TopUpClearRadius must not farm NPC kill rewards faster than CombatConfig.NPCRespawnSeconds
	local deadAt: { [number]: number } = rt.RowDeadAt or {}
	local delay = math.max(N.TopUpDelaySeconds or 0, tonumber((CombatConfig :: any).NPCRespawnSeconds) or 0)
	local nowC = os.clock()
	for i, row in ipairs(def.Garrison) do
		local rowWhen = row.When or "Open"
		local tooSoon = playersClear ~= nil and deadAt[i] ~= nil and nowC - deadAt[i] < delay
		if rowWhen == want and rt.RowNpc[i] == nil and not tooSoon then
			local cf = OpsGarrison.RowCFrame(rt, row)
			if cf ~= nil and (playersClear == nil or playersClear(cf.Position)) then
				local a = row.Post and rt.Anchors[row.Post]
				if a and a.Probe then
					local q = OpsGarrison.ClearPoint(cf.Position)
					if q then
						cf = CFrame.new(q) * CFrame.Angles(0, math.rad(a.Yaw), 0)
					else
						cf = OpsGarrison.NearestPost(rt, cf.Position) or cf
					end
				end
				table.insert(batch, { Idx = i, Row = row, CF = cf })
			end
		end
	end
	local n = 0
	for _, b in ipairs(batch) do
		if not OpsGarrison.HasRoom(rt) then
			break
		end
		rt.Pending += 1
		local gen = rt.Gen
		local extra = want ~= "Open"
		task.delay(n * N.SpawnStaggerSeconds, function()
			if rt.Gen ~= gen then
				return -- a Sleep reset Pending and cancelled this spawn: never count down a later generation
			end
			rt.Pending = math.max(0, rt.Pending - 1)
			if rt.Live and rt.Alloc > 0 and rt.RowNpc[b.Idx] == nil then
				spawnOne(rt, b.Row.Type, b.CF, optsFor(rt, b.Row), b.Idx, extra)
			end
			if rt.Pending == 0 and done then
				done()
			end
		end)
		n += 1
	end
	if n == 0 and done then
		done()
	end
end

--[[ One wave NPC group at the wave ring (uplinks / holdout): all of `types` or nothing (the next wave waits while
	it would exceed Npc.WaveMaxAlive or the reservation). Aggressive, leash ring + 20 from its wave point. ]]
function OpsGarrison.SpawnWave(rt: any, types: { string }, centre: Vector3, ring: number, waveNo: number): boolean
	local cap = math.min(N.WaveMaxAlive, rt.Alloc)
	if rt.NpcCount + rt.Pending + #types > cap then
		return false
	end
	local def: OpsConfig.SiteDef = rt.Def
	for i, typeId in ipairs(types) do
		local a = ((waveNo - 1) * 2 + (i - 1)) * math.pi / 2 -- the 4 compass points, rotated per wave
		local p = centre + Vector3.new(math.sin(a) * ring, 0, -math.cos(a) * ring)
		local q = OpsGarrison.ClearPoint(p)
		local cf: CFrame
		if q then
			cf = CFrame.lookAt(q, Vector3.new(centre.X, q.Y, centre.Z))
		else
			cf = OpsGarrison.NearestPost(rt, p, def.WavePosts) or CFrame.new(centre)
		end
		rt.Pending += 1
		local gen = rt.Gen
		task.delay((i - 1) * N.SpawnStaggerSeconds, function()
			if rt.Gen ~= gen then
				return -- cancelled by a Sleep (see SpawnRows)
			end
			rt.Pending = math.max(0, rt.Pending - 1)
			if rt.Live and rt.Alloc > 0 then
				spawnOne(rt, typeId, cf, { Stance = "Aggressive", Leash = ring + 20 }, nil, true)
			end
		end)
	end
	return true
end

function OpsGarrison.Despawn(rt: any, id: string)
	npcSite[id] = nil
	if rt.Npcs[id] ~= nil then
		local e = rt.Npcs[id]
		rt.Npcs[id] = nil
		rt.NpcCount -= 1
		if e.Row ~= nil and rt.RowNpc[e.Row] == id then
			rt.RowNpc[e.Row] = nil
		end
	end
	if CombatService and typeof(CombatService.DespawnNPC) == "function" then
		pcall(CombatService.DespawnNPC, id)
	end
end

-- reinforcements and wave NPCs go at the end of a run (the standing garrison stays and walks home)
function OpsGarrison.DespawnExtras(rt: any)
	local ids: { string } = {}
	for id, e in pairs(rt.Npcs) do
		if e.Extra then
			table.insert(ids, id)
		end
	end
	for _, id in ipairs(ids) do
		OpsGarrison.Despawn(rt, id)
	end
end

-- sleep: every NPC of the site despawns (no pay) and its slots go back to the ledger
function OpsGarrison.Sleep(rt: any)
	rt.Gen += 1 -- cancels staggered spawns still pending
	rt.Pending = 0
	local ids: { string } = {}
	for id in pairs(rt.Npcs) do
		table.insert(ids, id)
	end
	for _, id in ipairs(ids) do
		OpsGarrison.Despawn(rt, id)
	end
	OpsGarrison.Release(rt)
end

function OpsGarrison.Provoke(rt: any)
	if CombatService and typeof(CombatService.ProvokeGroup) == "function" then
		pcall(CombatService.ProvokeGroup, rt.Id)
	end
end

function OpsGarrison.Calm(rt: any)
	if CombatService and typeof(CombatService.CalmGroup) == "function" then
		pcall(CombatService.CalmGroup, rt.Id)
	end
end

-- any live guard of the site hurt (health below max): the provoke test for checkpoints / camps / rigs
function OpsGarrison.AnyHurt(rt: any): boolean
	for _, e in pairs(rt.Npcs) do
		local rec = e.Rec
		local hum = rec and rec.Humanoid
		if hum and hum.Parent and hum.Health < hum.MaxHealth - 0.01 then
			return true
		end
	end
	return false
end

-- homes of the live standing guards (the on-foot proximity provoke test)
function OpsGarrison.Homes(rt: any, out: { Vector3 }): { Vector3 }
	table.clear(out)
	for _, e in pairs(rt.Npcs) do
		if not e.Extra then
			table.insert(out, e.Home.Position)
		end
	end
	return out
end

function OpsGarrison.SiteOf(npcId: string): any
	return npcSite[npcId]
end

function OpsGarrison.AliveTotal(): number
	return opsAlive()
end

return OpsGarrison
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">OpsKinds</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsKinds — the stage machine of every job kind (W3 step 2 Phase B, lane O; spec §5, activities §3, contract §2.3).
	SERVER ONLY. A site walks OpsConfig.Sites[i].Stages in order; each stage id has one rule:

	  Breach / Start  prompt at At: the job goes Active (lockdown, group provoked); Breach opens the runtime door and
	                  spawns the When = "Breach" rows (the bank's R1 / R2)
	  Crack           ring R at At for Seconds: progress while an eligible participant stands in it on foot, not hit
	                  within Zones.UnderFireSeconds; a non-ally with no ally of the starter freezes it (not the bank:
	                  NoContest). Spawns the When = "Crack" rows (the Armory heavy); Sparks on the bank vault.
	  Grab            prompt at At: one bag per eligible player (present PresentSeconds since the start, not carrying,
	                  not on cooldown), MaxBags per run; the player's cooldown starts at the grab (saved)
	  Carry           OpsCargo carries it home; pay on delivery
	  Alarm           checkpoints: on provoke a prompt "Cut alarm" and a Seconds timer; not cut -> the When = "Alarm"
	                  rows (R1 / R2, clearance-probed) spawn
	  Clear           every NPC this site spawned is dead
	  Take / Open     the completing prompt (checkpoint booth, camp chest); a Cache's Open pays the opener at once
	  Hack / Hold     prompt, then a ring R for Seconds with waves (Npc.WaveMaxAlive); Hack decays while empty
	                  (Decay) and fails at 0; Hold fails after EmptyFail empty seconds
	  Plant           prompts on At / AtAny; min(Need, anchors present) charges within Window of the first
	  Fuse            Seconds, then Damage within DamageR of each charge (CombatService.ApplyRadiusDamage)
	  Recover         prompt: the carried box (the Crash)

	Pay (OpsRewards) at completion: Checkpoint = the taker + clan allies present; Uplink / Holdout = the starter's
	team present (share / seconds); Camp / Siege / Rig / Sabotage = every participant present PresentSeconds within
	PresentR of the site; Cache = the opener; carry kinds pay on delivery. Nobody on cooldown is paid; the paid
	player's cooldown starts (saved). Rivals keep their per-kill NPC cash only.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)
local CombatConfig = require(Shared.Configs.CombatConfig)

local Z = OpsConfig.Zones
local N = OpsConfig.Npc
local R = OpsConfig.Rewards
local TOAST = OpsConfig.Text.Toast

local OpsKinds = {}

local ctx: any = nil

function OpsKinds.Init(context: any)
	ctx = context
end

-- kinds whose zone presence and holds need the player ON FOOT (activities §2.2)
local ON_FOOT: { [string]: boolean } = { Vault = true, VaultLite = true, Cache = true, Uplink = true, Holdout = true }
-- kinds that go Active when their garrison is provoked (not by a prompt)
local PROVOKE_KINDS: { [string]: boolean } = { Checkpoint = true, Camp = true, Rig = true, Siege = true }
-- first-stage ids that show a prompt while the site is Open
local IDLE_PROMPT: { [string]: boolean } = { Breach = true, Start = true, Hack = true, Hold = true, Plant = true, Recover = true, Open = true }

function OpsKinds.OnFootKind(kind: string): boolean
	return ON_FOOT[kind] == true
end

local function def(rt: any): OpsConfig.SiteDef
	return rt.Def
end

local function stageOf(rt: any): OpsConfig.StageDef?
	return def(rt).Stages[rt.StageIdx]
end

function OpsKinds.PresentNeed(d: OpsConfig.SiteDef): number
	return d.PresentSeconds or Z.PresentSeconds
end

local function fmtClock(sec: number): string
	sec = math.max(0, math.ceil(sec))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end
OpsKinds.FmtClock = fmtClock

-- the anchor roles of a stage (At, or the AtAny anchors present)
local function stageRoles(rt: any, st: OpsConfig.StageDef): { string }
	local out: { string } = {}
	if st.AtAny ~= nil then
		for _, r in ipairs(st.AtAny) do
			if rt.Anchors[r] ~= nil then
				table.insert(out, r)
			end
		end
	elseif st.At ~= nil and rt.Anchors[st.At] ~= nil then
		table.insert(out, st.At)
	end
	return out
end

local function promptKey(st: OpsConfig.StageDef, role: string): string
	return st.Id .. ":" .. role
end

-- the prompts of one stage (a rotating cache shows only its live anchor; planted pumps show none)
local function showPrompts(rt: any, st: OpsConfig.StageDef)
	if st.Prompt == nil then
		return
	end
	local d = def(rt)
	for _, role in ipairs(stageRoles(rt, st)) do
		local live = d.Rotate == nil or role == rt.RotateRole
		if live and not rt.Planted[role] then
			ctx.Sites.Prompt(rt, promptKey(st, role), role, st)
		end
	end
end

local function dropStagePrompts(rt: any, st: OpsConfig.StageDef)
	for _, role in ipairs(stageRoles(rt, st)) do
		ctx.Sites.DropPrompt(rt, promptKey(st, role))
	end
end

--[[ Back to the first stage (a fresh run). Prompts of an idle first stage appear only while the site is Open. ]]
function OpsKinds.Reset(rt: any)
	ctx.Sites.DropPrompts(rt)
	rt.StageIdx = 1
	rt.StageAt = os.clock()
	rt.Progress = 0
	rt.Parts = {}
	rt.Blocked = {}
	rt.Starter = nil
	rt.Planted = {}
	rt.PlantCount = 0
	rt.Planter = nil
	rt.WindowUntil = nil
	rt.BagsTaken = 0
	rt.AlarmUntil = nil
	rt.AlarmCut = false
	rt.FuseUntil = nil
	rt.WaveIdx = 1
	rt.Ringing = false
	rt.EmptyFor = 0
	rt.LockUntil = nil
	rt.ActiveAt = nil
	rt.Provoke = {}
	rt.Killed = 0
	rt.Contested = false
	rt.StarterClan = nil
	OpsKinds.Idle(rt)
end

--[[ An ally of the run's starter: the starter, or a member of the starter's clan as it was when the run started (read
	once at activation: a starter who leaves mid-run must not turn their own clan-mates into "enemies" who freeze the
	ring and lose the pay). No starter (a provoked site): everyone is on the same side. ]]
local function starterAlly(rt: any, p: Player): boolean
	local s: Player? = rt.Starter
	if s == nil or s == p then
		return true
	end
	local clan: string? = rt.StarterClan
	return clan ~= nil and ctx.Zones.ClanOf(p) == clan
end

function OpsKinds.Idle(rt: any)
	if rt.State ~= "Open" then
		return
	end
	local st = def(rt).Stages[1]
	if st ~= nil and IDLE_PROMPT[st.Id] then
		showPrompts(rt, st)
	end
end

-- the job goes Active (a start prompt, or the garrison provoked)
local function activate(rt: any, player: Player?)
	if rt.State == "Active" then
		return
	end
	local d = def(rt)
	local nowC = os.clock()
	rt.ActiveAt = nowC
	rt.Starter = player
	rt.StarterClan = if player then ctx.Zones.ClanOf(player) else nil
	rt.Parts = {}
	rt.Blocked = {}
	if d.Lockdown ~= nil then
		rt.LockUntil = nowC + d.Lockdown
	end
	ctx.SetState(rt, "Active")
	ctx.Garrison.Provoke(rt)
	ctx.Sites.Smoke(rt, true)
	if player then
		ctx.EndNovice(player)
	end
	ctx.Rewards.Log(ctx.Events.OPS_START, if player then player.UserId else nil, { site = rt.Id })
	if d.Kind == "Vault" then
		ctx.RaidStarted(rt, player)
	end
end
OpsKinds.Activate = activate

local enter: (rt: any) -> ()
local complete: (rt: any, player: Player?) -> ()

local function nextStage(rt: any)
	local st = stageOf(rt)
	if st then
		dropStagePrompts(rt, st)
	end
	rt.StageIdx += 1
	enter(rt)
end

enter = function(rt: any)
	local st = stageOf(rt)
	local nowC = os.clock()
	rt.StageAt = nowC
	rt.Progress = 0
	rt.EmptyFor = 0
	if st == nil or st.Id == "Carry" then
		if st == nil then
			complete(rt, nil)
		end
		return
	end
	local id = st.Id
	if id == "Crack" then
		ctx.Garrison.SpawnRows(rt, "Crack")
		ctx.Sites.Sparks(rt, true, st.At)
	elseif id == "Alarm" then
		rt.AlarmUntil = nowC + (st.Seconds or 12)
		showPrompts(rt, st)
	elseif id == "Fuse" then
		rt.FuseUntil = nowC + (st.Seconds or 8)
	elseif id == "Hack" or id == "Hold" then
		if rt.State == "Active" then
			rt.Ringing = true
		else
			showPrompts(rt, st)
		end
	else
		showPrompts(rt, st)
	end
	ctx.MarkSite(rt)
end

--[[ Pay each player in `payees` (unique) who is alive, loaded and not on this site's cooldown; start their cooldown.
	Returns how many were paid. ]]
local function payAll(rt: any, payees: { Player }): number
	local d = def(rt)
	local nowU = os.time()
	local paid = 0
	for _, p in ipairs(payees) do
		local profile = ctx.Profile(p)
		local s = ctx.Zones.Get(p)
		if profile ~= nil and s.Alive and ctx.Rewards.CdLeft(profile, d.Id, nowU) <= 0 then
			local cash, xp = ctx.Rewards.Quote(profile, d, nowU)
			if ctx.Rewards.Grant(p, d, cash, xp, false) then
				ctx.Rewards.SetCd(p, profile, d, nowU)
				paid += 1
				local line = if d.Kind == "Checkpoint"
					then string.format(TOAST.CheckpointTaken, ctx.Rewards.FormatCash(cash))
					else string.format(TOAST.Paid, d.Title, ctx.Rewards.FormatCash(cash))
				ctx.Notify(p, line, "Reward")
				ctx.MarkPlayerSite(p, d.Id)
			end
		end
	end
	return paid
end

-- players present long enough (optionally: only those `ally(p)` accepts; uplinks by ring share)
local function eligible(rt: any, ally: ((Player) -> boolean)?): { Player }
	local d = def(rt)
	local out: { Player } = {}
	local need = OpsKinds.PresentNeed(d)
	local elapsed = if rt.ActiveAt then os.clock() - rt.ActiveAt else 0
	for uid, part in pairs(rt.Parts) do
		local p = Players:GetPlayerByUserId(uid)
		if p and p.Parent then
			local ok
			if d.PresentShare ~= nil then
				local ringT = os.clock() - (rt.RingAt or rt.ActiveAt or os.clock())
				ok = ringT > 0 and part.In / ringT >= d.PresentShare
			else
				ok = part.T >= math.min(need, math.max(0, elapsed - 0.01))
			end
			if ok and (ally == nil or ally(p)) then
				table.insert(out, p)
			end
		end
	end
	return out
end

local function endRun(rt: any, success: boolean, taker: Player?)
	local d = def(rt)
	local row = R.Rows[d.Pay]
	ctx.Sites.DropPrompts(rt)
	rt.Ringing = false
	ctx.Sites.Sparks(rt, false)
	ctx.Sites.Smoke(rt, false)
	ctx.Garrison.DespawnExtras(rt)
	ctx.Garrison.Calm(rt)
	if rt.NpcCount == 0 and rt.Pending == 0 and rt.Alloc > 0 then
		ctx.Garrison.Sleep(rt) -- nobody left standing: the slots go back to the ledger while the site cools
	end
	if rt.Door ~= nil then
		rt.DoorClose = true -- closes once nobody stands in the site (nobody is ever shut in)
	end
	rt.LastEnd = os.clock()
	ctx.Rewards.Log(if success then ctx.Events.OPS_DONE else ctx.Events.OPS_FAIL, if taker then taker.UserId else nil, { site = rt.Id, bags = rt.BagsTaken })
	if d.Kind == "Vault" and not success and (rt.BagsTaken or 0) == 0 then
		for uid in pairs(rt.Parts) do
			local p = Players:GetPlayerByUserId(uid)
			if p then
				ctx.Notify(p, TOAST.Sealed, "Info")
			end
		end
	end
	rt.Parts = {}
	if success and d.Kind == "Checkpoint" then
		ctx.Garrison.Sleep(rt) -- every guard is down: the slots go back to the ledger while Held
		rt.HeldBy = if taker then taker.UserId else nil
		rt.HeldColor = if taker then ctx.ColorOf(taker) else nil
		ctx.Sites.HeldSign(rt, rt.HeldColor)
		ctx.SetState(rt, "Held", ctx.Rewards.Seconds(d.HeldSeconds or 600))
		return
	end
	local cd = if success then row.SiteCd else row.FailCd
	cd = ctx.Rewards.Seconds(cd)
	if cd > 0 then
		ctx.SetState(rt, "Cooling", cd)
	else
		ctx.SetState(rt, if rt.Alloc > 0 or rt.Need == 0 then "Open" else "Dormant")
		OpsKinds.Reset(rt)
	end
end
OpsKinds.End = endRun

complete = function(rt: any, player: Player?)
	local d = def(rt)
	local payees: { Player }
	if d.Kind == "Checkpoint" then
		payees = eligible(rt, if player then function(p: Player): boolean
			return ctx.Zones.Allies(player, p)
		end else nil)
		if player and table.find(payees, player) == nil then
			table.insert(payees, player) -- the taker held the booth: always present
		end
	elseif d.Kind == "Uplink" or d.Kind == "Holdout" then
		payees = if rt.Starter then eligible(rt, function(p: Player): boolean
			return starterAlly(rt, p)
		end) else {}
	else
		payees = eligible(rt, nil)
	end
	payAll(rt, payees)
	endRun(rt, true, player)
end

-- a Cache opens at once for the opener (no NPCs, no run)
local function openCache(rt: any, player: Player)
	local d = def(rt)
	local profile = ctx.Profile(player)
	if profile == nil then
		return
	end
	payAll(rt, { player })
	ctx.Rewards.Log(ctx.Events.OPS_DONE, player.UserId, { site = rt.Id })
	if d.Rotate ~= nil and #d.Rotate > 1 then
		local idx = (table.find(d.Rotate, rt.RotateRole) or 1) % #d.Rotate + 1
		for _ = 1, #d.Rotate do
			if rt.Anchors[d.Rotate[idx]] ~= nil then
				break
			end
			idx = idx % #d.Rotate + 1
		end
		ctx.Sites.DropPrompts(rt)
		rt.RotateRole = d.Rotate[idx]
		rt.Target = rt.Anchors[rt.RotateRole]
		rt.Moved = true
		OpsKinds.Idle(rt)
	end
	ctx.MarkSite(rt)
end

local function grab(rt: any, st: OpsConfig.StageDef, player: Player)
	local d = def(rt)
	if (rt.BagsTaken or 0) >= (st.MaxBags or 1) then
		return
	end
	local part = rt.Parts[player.UserId]
	if part == nil or part.T < OpsKinds.PresentNeed(d) then
		ctx.Notify(player, TOAST.NeedShare, "Info")
		return
	end
	if ctx.Cargo.Carrying(player) ~= nil then
		ctx.Notify(player, TOAST.HandsFull, "Info")
		return
	end
	if not ctx.Cargo.CanAdd() then
		ctx.Notify(player, TOAST.BagsFull, "Info")
		return
	end
	local profile = ctx.Profile(player)
	local nowU = os.time()
	local cash, xp = ctx.Rewards.Quote(profile, d, nowU)
	local bag = ctx.Cargo.Grab(player, d, cash, xp)
	if bag == nil then
		return
	end
	ctx.Rewards.SetCd(player, profile, d, nowU)
	ctx.EndNovice(player)
	ctx.MarkPlayerSite(player, d.Id)
	rt.BagsTaken = (rt.BagsTaken or 0) + 1
	if rt.BagsTaken >= (st.MaxBags or 1) then
		endRun(rt, true, player)
	end
end

local function recover(rt: any, player: Player)
	local d = def(rt)
	if ctx.Cargo.Carrying(player) ~= nil then
		ctx.Notify(player, TOAST.HandsFull, "Info")
		return
	end
	if not ctx.Cargo.CanAdd() then
		ctx.Notify(player, TOAST.BagsFull, "Info")
		return
	end
	activate(rt, player)
	local profile = ctx.Profile(player)
	local nowU = os.time()
	local cash, xp = ctx.Rewards.Quote(profile, d, nowU)
	if ctx.Cargo.Grab(player, d, cash, xp) == nil then
		return
	end
	ctx.Rewards.SetCd(player, profile, d, nowU)
	ctx.MarkPlayerSite(player, d.Id)
	rt.BagsTaken = 1
	endRun(rt, true, player)
end

local function plant(rt: any, st: OpsConfig.StageDef, role: string, player: Player)
	if rt.Planted[role] then
		return
	end
	rt.Planted[role] = true
	rt.PlantCount += 1
	ctx.Sites.DropPrompt(rt, promptKey(st, role))
	if rt.State ~= "Active" then
		activate(rt, player)
	else
		ctx.EndNovice(player)
	end
	if rt.WindowUntil == nil and st.Window ~= nil then
		rt.WindowUntil = os.clock() + st.Window
	end
	if rt.Planter == nil then
		rt.Planter = player
	end
	local need = math.min(st.Need or 1, math.max(1, #stageRoles(rt, st)))
	ctx.MarkSite(rt)
	if rt.PlantCount >= need then
		nextStage(rt)
	end
end

--[[ A prompt on this site fired and OpsService re-checked it (rate limit, profile, alive, distance, on foot,
	stage, cooldown, teleport lock). ]]
function OpsKinds.OnPrompt(rt: any, st: OpsConfig.StageDef, role: string, player: Player)
	local id = st.Id
	local d = def(rt)
	if id == "Breach" or id == "Start" then
		activate(rt, player)
		if id == "Breach" then
			ctx.Sites.SetDoor(rt, true)
			rt.DoorClose = false
			ctx.Garrison.SpawnRows(rt, "Breach")
		end
		nextStage(rt)
	elseif id == "Alarm" then
		rt.AlarmCut = true
		ctx.EndNovice(player)
		nextStage(rt)
	elseif id == "Take" then
		ctx.EndNovice(player)
		complete(rt, player)
	elseif id == "Open" then
		if d.Kind == "Cache" then
			openCache(rt, player)
		else
			complete(rt, player)
		end
	elseif id == "Grab" then
		grab(rt, st, player)
	elseif id == "Hack" or id == "Hold" then
		activate(rt, player)
		dropStagePrompts(rt, st)
		rt.Ringing = true
		rt.RingAt = os.clock()
		rt.StageAt = rt.RingAt
		rt.Progress = 0
		rt.EmptyFor = 0
		rt.WaveIdx = 1
		ctx.MarkSite(rt)
	elseif id == "Plant" then
		plant(rt, st, role, player)
	elseif id == "Recover" then
		recover(rt, player)
	end
end

-- which stage prompts may fire now (the "stage is valid" re-check)
function OpsKinds.PromptValid(rt: any, st: OpsConfig.StageDef): boolean
	local cur = stageOf(rt)
	if cur == nil or cur.Id ~= st.Id then
		return false
	end
	if IDLE_PROMPT[st.Id] and rt.StageIdx == 1 and rt.State == "Open" then
		return true
	end
	if st.Id == "Plant" and rt.State == "Active" then
		return true
	end
	return rt.State == "Active"
end

-- ── the 4 Hz tick of an Active site ─────────────────────────────────────────────────────────────────────────────
local function ringCentre(rt: any, st: OpsConfig.StageDef): (Vector3?, number)
	local a = st.At and rt.Anchors[st.At]
	if a == nil then
		return nil, 0
	end
	return a.Position, st.R or a.R or 8
end

-- who is in a ring: eligible allies of the starter / eligible others / per-player block reasons
local function ringScan(rt: any, centre: Vector3, r: number, nowC: number, dt: number, underFire: boolean): (number, number, number)
	local d = def(rt)
	local onFoot = ON_FOOT[d.Kind] == true
	local team, others, any = 0, 0, 0
	table.clear(rt.Blocked)
	for _, p in ipairs(ctx.PlayerList) do
		local s = ctx.Zones.Get(p)
		if s.Alive and s.Pos and ctx.Zones.Within(s.Pos, centre, r, d.AllowSeated) then
			local why: string? = nil
			if ctx.Zones.Locked(p, nowC) then
				continue -- a teleport-locked player neither helps nor contests
			end
			if onFoot and s.Seated and not d.AllowSeated then
				why = "Vehicle"
			elseif underFire and ctx.Zones.UnderFire(p, nowC) then
				why = "UnderFire"
			end
			if why ~= nil then
				rt.Blocked[p.UserId] = why
			else
				any += 1
				local ally = starterAlly(rt, p)
				if ally then
					team += 1
				else
					others += 1
				end
				local part = rt.Parts[p.UserId]
				if part then
					part.In += dt
				end
			end
		end
	end
	return team, others, any
end

local function tickCrack(rt: any, st: OpsConfig.StageDef, dt: number, nowC: number)
	local centre, r = ringCentre(rt, st)
	if centre == nil then
		return
	end
	local d = def(rt)
	local team, others, any = ringScan(rt, centre, r, nowC, dt, true)
	local go
	if d.NoContest or not Z.ContestFreeze then
		go = any > 0
	else
		go = team > 0
		if team == 0 and others > 0 then
			for _, p in ipairs(ctx.PlayerList) do
				local s = ctx.Zones.Get(p)
				if s.Pos and rt.Blocked[p.UserId] == nil and ctx.Zones.Within(s.Pos, centre, r) then
					rt.Blocked[p.UserId] = "Enemy"
				end
			end
		end
	end
	rt.Contested = team == 0 and others > 0
	if go then
		rt.Progress = math.min(1, rt.Progress + dt / math.max(1, st.Seconds or 30))
	end
	if rt.Progress >= 1 then
		ctx.Sites.Sparks(rt, false)
		nextStage(rt)
	end
end

local function tickRing(rt: any, st: OpsConfig.StageDef, dt: number, nowC: number)
	local centre, r = ringCentre(rt, st)
	if centre == nil then
		return
	end
	local d = def(rt)
	local team, others = ringScan(rt, centre, r, nowC, dt, false)
	local frozen = Z.ContestFreeze and team == 0 and others > 0
	rt.Contested = frozen
	if frozen then
		for _, p in ipairs(ctx.PlayerList) do
			local s = ctx.Zones.Get(p)
			if s.Pos and rt.Blocked[p.UserId] == nil and ctx.Zones.Within(s.Pos, centre, r) then
				rt.Blocked[p.UserId] = "Enemy"
			end
		end
	end
	local seconds = math.max(1, st.Seconds or 60)
	if team > 0 then
		rt.Progress = math.min(1, rt.Progress + dt / seconds)
		rt.EmptyFor = 0
	else
		rt.EmptyFor += dt
		if st.Id == "Hack" and not frozen then
			rt.Progress = math.max(0, rt.Progress - (st.Decay or 0) * dt)
		end
	end
	-- waves on the wave ring (the next wave waits while it would pass Npc.WaveMaxAlive)
	local waves = d.Waves
	if waves ~= nil then
		local elapsed = nowC - (rt.RingAt or nowC)
		local ringR = if d.Kind == "Holdout" then N.HoldoutWaveRing else N.WaveRing
		while rt.WaveIdx <= #waves and elapsed >= waves[rt.WaveIdx].At do
			if ctx.Garrison.SpawnWave(rt, waves[rt.WaveIdx].Types, centre, ringR, rt.WaveIdx) then
				rt.WaveIdx += 1
			else
				break
			end
		end
	end
	if rt.Progress >= 1 then
		complete(rt, rt.Starter)
		return
	end
	local failAfter = st.EmptyFail or 10
	if st.Id == "Hack" then
		if rt.Progress <= 0 and rt.EmptyFor >= failAfter then
			endRun(rt, false, nil)
		end
	elseif rt.EmptyFor >= failAfter then
		endRun(rt, false, nil)
	end
end

local function blast(rt: any, st: OpsConfig.StageDef)
	local d = def(rt)
	local roles: { string } = {}
	for role in pairs(rt.Planted) do
		table.insert(roles, role)
	end
	table.sort(roles)
	local attacker: Player? = rt.Planter
	if attacker and attacker.Parent == nil then
		attacker = nil
	end
	for _, role in ipairs(roles) do
		local a = rt.Anchors[role]
		if a then
			ctx.Blast(attacker, a.Position + Vector3.new(0, 2, 0), st.DamageR or 12, st.Damage or 40)
			if d.Kind == "Sabotage" then
				ctx.Sites.PumpSmoke(rt, role)
			end
		end
	end
end

--[[ Participation: every player within PresentR of the site's zone points while it is Active (alive, not locked,
	on foot for on-foot kinds; seated counts at AllowSeated sites). ]]
local function accrue(rt: any, dt: number, nowC: number)
	local d = def(rt)
	local r = d.PresentR or Z.PresentR
	local onFoot = ON_FOOT[d.Kind] == true
	for _, p in ipairs(ctx.PlayerList) do
		local s = ctx.Zones.Get(p)
		if s.Alive and s.Pos and not ctx.Zones.Locked(p, nowC) and not (onFoot and s.Seated and not d.AllowSeated) then
			if ctx.Zones.NearAny(s.Pos, rt.Points, r, d.AllowSeated) then
				local part = rt.Parts[p.UserId]
				if part == nil then
					part = { T = 0, In = 0 }
					rt.Parts[p.UserId] = part
				end
				part.T += dt
			end
		end
	end
end

-- the Open-state provoke test (checkpoints, camps, rigs, forts): a guard hurt or down, or an on-foot player within
-- ProvokeRadius of a guard's home for CombatConfig.NPCStance.ProvokeHoldSeconds
local homesScratch: { Vector3 } = {}
local function provoked(rt: any, dt: number): boolean
	if rt.Killed > 0 or ctx.Garrison.AnyHurt(rt) then
		return true
	end
	local d = def(rt)
	local radius = d.ProvokeRadius or N.DefaultProvokeRadius
	local stance: any = (CombatConfig :: any).NPCStance
	local hold = if typeof(stance) == "table" and typeof(stance.ProvokeHoldSeconds) == "number" then stance.ProvokeHoldSeconds else 2
	local homes = ctx.Garrison.Homes(rt, homesScratch)
	if #homes == 0 then
		return false
	end
	local hit = false
	for _, p in ipairs(ctx.PlayerList) do
		local s = ctx.Zones.Get(p)
		local uid = p.UserId
		if s.Alive and s.Pos and not s.Seated and ctx.Zones.NearAny(s.Pos, homes, radius) then
			rt.Provoke[uid] = (rt.Provoke[uid] or 0) + dt
			if rt.Provoke[uid] >= hold then
				hit = true
			end
		else
			rt.Provoke[uid] = nil
		end
	end
	return hit
end

function OpsKinds.Tick(rt: any, dt: number, nowC: number)
	local d = def(rt)
	if rt.State == "Open" then
		if PROVOKE_KINDS[d.Kind] and rt.Alloc > 0 and rt.Pending == 0 and provoked(rt, dt) then
			local first = d.Stages[1]
			activate(rt, nil)
			if first ~= nil and not IDLE_PROMPT[first.Id] then
				enter(rt)
			end
		end
		return
	end
	if rt.State ~= "Active" then
		return
	end
	accrue(rt, dt, nowC)
	if rt.LockUntil ~= nil and nowC >= rt.LockUntil then
		endRun(rt, (rt.BagsTaken or 0) > 0, nil)
		return
	end
	local st = stageOf(rt)
	if st == nil then
		return
	end
	local id = st.Id
	if id == "Crack" then
		tickCrack(rt, st, dt, nowC)
	elseif id == "Alarm" then
		if rt.AlarmUntil ~= nil and nowC >= rt.AlarmUntil then
			rt.AlarmUntil = nil
			ctx.Garrison.SpawnRows(rt, "Alarm")
			nextStage(rt)
		end
	elseif id == "Clear" then
		if rt.Pending == 0 and rt.NpcCount == 0 then
			nextStage(rt)
		end
	elseif id == "Fuse" then
		if rt.FuseUntil ~= nil and nowC >= rt.FuseUntil then
			rt.FuseUntil = nil
			blast(rt, st)
			nextStage(rt)
		end
	elseif id == "Plant" then
		if rt.WindowUntil ~= nil and nowC >= rt.WindowUntil then
			endRun(rt, false, nil)
		end
	elseif (id == "Hack" or id == "Hold") and rt.Ringing then
		tickRing(rt, st, dt, nowC)
	end
end

-- OpsProgressPayload for one player at an Active site (nil = nothing to show)
function OpsKinds.Progress(rt: any, player: Player, nowC: number): OpsConfig.OpsProgressPayload?
	local st = stageOf(rt)
	if st == nil or rt.State ~= "Active" then
		return nil
	end
	local d = def(rt)
	local out: OpsConfig.OpsProgressPayload = { Site = rt.Id, Stage = st.Id, Guards = rt.NpcCount }
	local id = st.Id
	if id == "Crack" or ((id == "Hack" or id == "Hold") and rt.Ringing) then
		out.Frac = math.floor(rt.Progress * 1000 + 0.5) / 1000
		out.Blocked = rt.Blocked[player.UserId]
		if out.Blocked == nil and ON_FOOT[d.Kind] then
			local s = ctx.Zones.Get(player)
			local c, r = ringCentre(rt, st)
			if s.Seated and s.Pos and c and ctx.Zones.Within(s.Pos, c, r) and not d.AllowSeated then
				out.Blocked = "Vehicle"
			end
		end
	end
	if id == "Alarm" and rt.AlarmUntil then
		out.Left = math.max(0, math.ceil(rt.AlarmUntil - nowC))
	elseif id == "Fuse" and rt.FuseUntil then
		out.Left = math.max(0, math.ceil(rt.FuseUntil - nowC))
	elseif rt.LockUntil then
		out.Left = math.max(0, math.ceil(rt.LockUntil - nowC))
	end
	if d.Waves ~= nil and rt.Ringing then
		out.Wave = math.min(#d.Waves, math.max(1, rt.WaveIdx - 1))
		out.Waves = #d.Waves
	end
	if id == "Grab" then
		local profile = ctx.Profile(player)
		if profile and ctx.Rewards.CdLeft(profile, d.Id, os.time()) > 0 then
			out.Blocked = "Cooldown"
		end
	end
	return out
end

return OpsKinds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">OpsRewards</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsRewards — job pay, player cooldowns and the saved Ops block (W3 step 2 Phase B, lane O; contract §2.4, §4.5).
	SERVER ONLY. Nothing here trusts the client: R (base passive income per second before multipliers) comes from the
	player's own saved BaseUpgrades through TycoonMath, never from a remote.

	Pay = clamp(Floor, round(Minutes x 60 x R), Cap) x Private x Diminish x Event          (OpsConfig.Rewards)
	  R        = TycoonMath.BasePassivePerTick(profile.BaseUpgrades) / TycoonMath.TickSeconds()
	  Private  = Rewards.PrivateMult (0.5) when game.PrivateServerOwnerId ~= 0 (cash AND XP)
	  Diminish = Rewards.Diminish {1, 0.5, 0.25} by runs of this pay row today (UTC): 1..DimN, DimN+1..2 DimN, then
	  Event    = 1 (Vault Window is Phase C: Director.Events.Enabled = false)
	Cash goes through EconomyService.AddCash(player, pay, "ops") (wallet; "ops" is multiplier-exempt: OpsService stays
	off until MonetizationConfig.CashMultExemptReasons has it) and XP through XPService.AddXP(player, xp, "ops").

	profile.Ops (ProfileSchema default + sanitise; accessed as (profile :: any).Ops, no DataVersion bump):
	  Cd = { [siteId] = os.time() until } (per player per site, saved), DayKey (UTC day of Runs), Runs = { [payRow] = n },
	  Seen (bit flags), Total (lifetime job cash), BestBag (best single bag).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)
local TycoonMath = require(Shared.Util.TycoonMath)

local OpsRewards = {}

local R = OpsConfig.Rewards
local PROFILE = OpsConfig.Profile

local EconomyService: any = nil
local XPService: any = nil
local MissionService: any = nil
local DataService: any = nil
local AnalyticsService: any = nil

local listeners: { { Fn: (Player, string, string, number) -> () } } = {}
local privateOverride: boolean? = nil -- headless drivers only

function OpsRewards.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	MissionService = deps.MissionService
	DataService = deps.DataService
	AnalyticsService = deps.AnalyticsService
end

-- whole number >= 0 (junk -> 0)
local function nonNeg(v: any): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return math.max(0, math.floor(n))
end

function OpsRewards.FormatCash(n: number): string
	local s = string.format("%d", math.floor(math.abs(n) + 0.5))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return out
end

function OpsRewards.DayKey(nowUnix: number): number
	return math.floor(nowUnix / 86400)
end

--[[ The player's Ops block, created with the ProfileSchema defaults when missing (a profile loaded before this build
	ran Migrate always has one; this is only a guard). Rolls Runs over at the UTC day change. nil = no profile. ]]
function OpsRewards.Block(profile: any, nowUnix: number?): any
	if typeof(profile) ~= "table" then
		return nil
	end
	local ops = profile.Ops
	if typeof(ops) ~= "table" then
		ops = { Cd = {}, DayKey = 0, Runs = {}, Seen = 0, Total = 0, BestBag = 0 }
		profile.Ops = ops
	end
	if typeof(ops.Cd) ~= "table" then
		ops.Cd = {}
	end
	if typeof(ops.Runs) ~= "table" then
		ops.Runs = {}
	end
	local day = OpsRewards.DayKey(nowUnix or os.time())
	if ops.DayKey ~= day then
		ops.DayKey = day
		ops.Runs = {}
	end
	return ops
end

-- base passive income per second before multipliers (never from the client)
function OpsRewards.PerSecond(profile: any): number
	local upgrades = if typeof(profile) == "table" and typeof(profile.BaseUpgrades) == "table" then profile.BaseUpgrades else nil
	local ok, perTick = pcall(TycoonMath.BasePassivePerTick, upgrades)
	local tick = TycoonMath.TickSeconds()
	if not ok or typeof(perTick) ~= "number" or perTick ~= perTick or not (tick > 0) then
		return 0
	end
	return math.max(0, perTick / tick)
end

function OpsRewards.SetPrivateOverride(v: boolean?)
	privateOverride = v
end

function OpsRewards.IsPrivate(): boolean
	if privateOverride ~= nil then
		return privateOverride
	end
	local ok, owner = pcall(function(): any
		return (game :: any).PrivateServerOwnerId
	end)
	return ok and typeof(owner) == "number" and owner ~= 0
end

function OpsRewards.PrivateMult(): number
	return if OpsRewards.IsPrivate() then R.PrivateMult else 1
end

-- the Diminish step for this pay row today (0-based runs already paid)
function OpsRewards.DiminishMult(ops: any, payRow: string): number
	local row = R.Rows[payRow]
	if row == nil or typeof(ops) ~= "table" then
		return 1
	end
	local runs = nonNeg(typeof(ops.Runs) == "table" and ops.Runs[payRow] or 0)
	local n = math.max(1, row.DimN)
	local steps = R.Diminish
	local idx = if runs < n then 1 elseif runs < 2 * n then 2 else 3
	return steps[math.min(idx, #steps)] or 1
end

--[[ What this player would be paid now for `site` (cash, xp): no side effects. Used for OpsState.Pay, the bag value
	at grab time and every completion. ]]
function OpsRewards.Quote(profile: any, site: OpsConfig.SiteDef, nowUnix: number?): (number, number)
	local row = R.Rows[site.Pay]
	if row == nil or typeof(profile) ~= "table" then
		return 0, 0
	end
	local ops = OpsRewards.Block(profile, nowUnix)
	local base = math.clamp(math.floor(row.Minutes * 60 * OpsRewards.PerSecond(profile) + 0.5), row.Floor, row.Cap)
	local priv = OpsRewards.PrivateMult()
	local cash = math.floor(base * priv * OpsRewards.DiminishMult(ops, site.Pay) + 0.5)
	local xp = math.floor(row.XP * priv + 0.5)
	return cash, xp
end

-- every cooldown / StudioCdDivisor in Studio
function OpsRewards.CdScale(): number
	if RunService:IsStudio() == true then
		return 1 / math.max(1, R.StudioCdDivisor)
	end
	return 1
end

function OpsRewards.Seconds(n: number): number
	return n * OpsRewards.CdScale()
end

-- seconds until this player may do this site again (0 = now)
function OpsRewards.CdLeft(profile: any, siteId: string, nowUnix: number): number
	local ops = OpsRewards.Block(profile, nowUnix)
	if ops == nil then
		return 0
	end
	local v = ops.Cd[siteId]
	if typeof(v) ~= "number" or v ~= v then
		return 0
	end
	return math.max(0, math.ceil(v - nowUnix))
end

function OpsRewards.SetCd(player: Player, profile: any, site: OpsConfig.SiteDef, nowUnix: number)
	local row = R.Rows[site.Pay]
	local ops = OpsRewards.Block(profile, nowUnix)
	if row == nil or ops == nil or row.PlayerCd <= 0 then
		return
	end
	ops.Cd[site.Id] = nowUnix + math.ceil(OpsRewards.Seconds(row.PlayerCd))
	if DataService and DataService.MarkDirty then
		DataService.MarkDirty(player)
	end
end

--[[ Listeners of OpsService.OnJobDone(fn): fn(player, siteId, kind, pay), each in its own pcall. ]]
function OpsRewards.OnJobDone(fn: (Player, string, string, number) -> ()): () -> ()
	local entry = { Fn = fn }
	table.insert(listeners, entry)
	return function()
		local i = table.find(listeners, entry)
		if i then
			table.remove(listeners, i)
		end
	end
end

--[[ Pay one player for one finished job (or one delivered bag): the wallet, XP, today's run count, the lifetime
	totals, mission progress (Kinds[kind].Track) and the OnJobDone listeners. `bag` = the cash came from a delivered
	bag (BestBag). Returns false (nothing paid, nothing counted) when AddCash refuses (no profile). ]]
function OpsRewards.Grant(player: Player, site: OpsConfig.SiteDef, cash: number, xp: number, bag: boolean?): boolean
	if EconomyService == nil or EconomyService.AddCash == nil then
		return false
	end
	cash = math.floor(cash + 0.5)
	if cash <= 0 then
		return false
	end
	if EconomyService.AddCash(player, cash, R.CashReason) ~= true then
		return false
	end
	if xp > 0 and XPService and XPService.AddXP then
		local ok, err = pcall(XPService.AddXP, player, xp, R.XPReason)
		if not ok then
			warn("[Ops] AddXP failed: " .. tostring(err))
		end
	end
	local profile = DataService and DataService.GetProfile(player)
	local ops = OpsRewards.Block(profile, os.time())
	if ops ~= nil then
		ops.Runs[site.Pay] = nonNeg(ops.Runs[site.Pay]) + 1
		ops.Total = math.min(nonNeg(ops.Total) + cash, 1e15)
		if bag == true and cash > nonNeg(ops.BestBag) then
			ops.BestBag = cash
		end
		DataService.MarkDirty(player)
	end
	local kind = OpsConfig.Kinds[site.Kind]
	if kind and MissionService and MissionService.TrackProgress then
		for _, t in ipairs(kind.Track) do
			local ok, err = pcall(MissionService.TrackProgress, player, t, 1)
			if not ok then
				warn("[Ops] TrackProgress " .. t .. " failed: " .. tostring(err))
			end
		end
	end
	for _, entry in ipairs(table.clone(listeners)) do
		local ok, err = pcall(entry.Fn :: any, player, site.Id, site.Kind, cash)
		if not ok then
			warn("[Ops] OnJobDone listener error: " .. tostring(err))
		end
	end
	return true
end

-- the Seen bit flags (OpsConfig.Profile.SeenBits)
function OpsRewards.HasSeen(profile: any, bit: number): boolean
	local ops = OpsRewards.Block(profile)
	return ops ~= nil and bit32.band(nonNeg(ops.Seen), bit) ~= 0
end

function OpsRewards.MarkSeen(player: Player, profile: any, bit: number)
	local ops = OpsRewards.Block(profile)
	if ops == nil then
		return
	end
	ops.Seen = math.clamp(bit32.bor(nonNeg(ops.Seen), bit), 0, PROFILE.SeenMax)
	if DataService and DataService.MarkDirty then
		DataService.MarkDirty(player)
	end
end

--[[ Legacy bank cooldown (lane F, profile.Raid.BankCooldownUntil): read ONCE at profile load as
	max(Raid.BankCooldownUntil, Ops.Cd["Town.Bank"]) into Ops.Cd; from then on only Ops is written. ]]
function OpsRewards.AdoptBankCooldown(profile: any, nowUnix: number)
	local ops = OpsRewards.Block(profile, nowUnix)
	if ops == nil then
		return
	end
	local raid = profile.Raid
	local legacy = if typeof(raid) == "table" then tonumber(raid.BankCooldownUntil) else nil
	if legacy == nil or legacy ~= legacy or legacy <= nowUnix then
		return
	end
	legacy = math.min(legacy, nowUnix + PROFILE.MaxCdAhead)
	local cur = tonumber(ops.Cd["Town.Bank"]) or 0
	if legacy > cur then
		ops.Cd["Town.Bank"] = math.floor(legacy)
	end
end

function OpsRewards.Log(event: string, userId: number?, props: { [string]: any }?)
	if AnalyticsService and AnalyticsService.Log then
		pcall(AnalyticsService.Log, event, userId, props)
	end
end

return OpsRewards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">OpsSites</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsSites — which job sites may run, and their world bits (W3 step 2 Phase B, lane O; contract §2.1, §4.1,
	§4.2, §4.4). SERVER ONLY.

	Liveness (Resolve): a site runs only when ALL hold, else it is Off with one logged reason (never bare sand):
	  1. OpsConfig.SiteSwitchedOn(id) (master, kind and site switches);
	  2. WorldConfig.POIs[site.POI].Enabled;
	  3. coexistence until the cutover: the Vault (Town.Bank) needs BankRaidConfig.Enabled == false, a Camp needs
	     CombatConfig.FieldBootstrap == false;
	  4. a site with NPCs needs lane N's CombatService API, and every garrison NPC type must exist (the camp commander
	     falls back to Npc.CommanderFallback);
	  5. every anchor role resolves (ActivityAnchors records read ONCE by OpsService), Optional roles excepted;
	  6. the streaming host rule (OpsConfig.Streaming) for every prompt and label anchor: the host part is within
	     NearHostStuds, or its Model holds exactly one BasePart (the POI's ActivityHost cluster), which is then set
	     to ModelStreamingMode.Persistent. Otherwise Off. No part is ever added to carry a prompt.

	World bits, all on existing instances: ProximityPrompts and the one world label per site are parented to the anchor
	Attachment (never a new part); the bank's BankGate / the Port's HeistGate (WE_RuntimeDoor parts) toggle CanCollide
	and WE_GateState; the bank's StateBanner takes Ui.BannerColors; at most 3 Smoke emitters (Active big sites), 1
	Sparks (bank crack) and 2 blown-pump Smoke emitters (30 s). 0 lights, 0 glowing material, 0 parts added.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)
local WorldConfig = require(Shared.Configs.WorldConfig)
local BankRaidConfig = require(Shared.Configs.BankRaidConfig)
local CombatConfig = require(Shared.Configs.CombatConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

local UI = OpsConfig.Ui
local TEXT = OpsConfig.Text

local OpsSites = {}

local ctx: any = nil
local smokeCount = 0
local pumpSmokeCount = 0

function OpsSites.Init(context: any)
	ctx = context
end

local poiOn: { [string]: boolean } = {}
for _, p in ipairs(WorldConfig.POIs) do
	poiOn[p.Id] = p.Enabled == true
end

-- roles whose anchor carries a prompt or the label (the streaming host rule applies to these)
local function uiRoles(def: OpsConfig.SiteDef): { string }
	local out: { string } = {}
	local seen: { [string]: boolean } = {}
	local function add(r: string?)
		if r ~= nil and not seen[r] then
			seen[r] = true
			table.insert(out, r)
		end
	end
	if def.Label then
		add(def.Target)
	end
	for _, st in ipairs(def.Stages) do
		if st.Prompt ~= nil then
			add(st.At)
			for _, r in ipairs(st.AtAny or {}) do
				add(r)
			end
		end
	end
	for _, r in ipairs(def.Rotate or {}) do
		add(r)
	end
	return out
end

local function partsIn(model: Instance): number
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do -- once per site at resolve, never in a loop
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

--[[ Liveness of one site. anchors = { [anchorId] = ActivityAnchors record } read once. Returns (anchorsByRole,
	persistModels) when live, else (nil, reason). ]]
function OpsSites.Resolve(def: OpsConfig.SiteDef, anchors: { [string]: any }): (any, any)
	if not OpsConfig.SiteSwitchedOn(def.Id) then
		return nil, "switched off"
	end
	if poiOn[def.POI] ~= true then
		return nil, "POI " .. def.POI .. " off"
	end
	if def.Kind == "Vault" and BankRaidConfig.Enabled ~= false then
		return nil, "BankRaidConfig.Enabled (the old bank job still runs)"
	end
	if def.Kind == "Camp" and (CombatConfig :: any).FieldBootstrap ~= false then
		return nil, "CombatConfig.FieldBootstrap (the field NPCs still stand on the camp posts)"
	end
	local needsNpc = #def.Garrison > 0 or (def.Waves ~= nil and #def.Waves > 0)
	if needsNpc and not ctx.Garrison.CoreReady() then
		return nil, "NPC core (lane N CombatService API) missing"
	end
	for _, row in ipairs(def.Garrison) do
		if ctx.Garrison.TypeFor(row.Type) == nil then
			return nil, "NPC type " .. row.Type .. " missing"
		end
	end
	for _, w in ipairs(def.Waves or {}) do
		for _, t in ipairs(w.Types) do
			if ctx.Garrison.TypeFor(t) == nil then
				return nil, "NPC type " .. t .. " missing"
			end
		end
	end
	local optional: { [string]: boolean } = {}
	for _, r in ipairs(def.Optional or {}) do
		optional[r] = true
	end
	local byRole: { [string]: any } = {}
	local missing: { string } = {}
	for role, aid in pairs(def.Anchors) do
		local a = anchors[aid]
		if a ~= nil then
			byRole[role] = a
		elseif not optional[role] then
			table.insert(missing, role)
		end
	end
	if #missing > 0 then
		table.sort(missing)
		return nil, "anchors missing: " .. table.concat(missing, "+")
	end
	local persist: { Model } = {}
	for _, role in ipairs(uiRoles(def)) do
		local a = byRole[role]
		if a ~= nil then
			local host = a.Attachment.Parent
			if host == nil or not host:IsA("BasePart") then
				return nil, "anchor " .. role .. " has no host part"
			end
			local d = ((host :: BasePart).Position - a.Position).Magnitude
			if d > OpsConfig.Streaming.NearHostStuds then
				local model = host.Parent
				if OpsConfig.Streaming.PersistHostModel and model ~= nil and model:IsA("Model") and partsIn(model) == 1 then
					if table.find(persist, model :: Model) == nil then
						table.insert(persist, model :: Model)
					end
				else
					return nil, string.format("anchor %s is %.0f studs from its host (streaming rule)", role, d)
				end
			end
		end
	end
	return byRole, persist
end

function OpsSites.Persist(models: { Model })
	for _, m in ipairs(models) do
		pcall(function()
			(m :: any).ModelStreamingMode = Enum.ModelStreamingMode.Persistent
		end)
	end
end

-- ── prompts ─────────────────────────────────────────────────────────────────────────────────────────────────────
--[[ One ProximityPrompt on an anchor Attachment. key names it in rt.Prompts (created at most once). The prompt
	carries no key hint: PromptController draws key caps only for keyboard / gamepad (PreferredInput). ]]
function OpsSites.Prompt(rt: any, key: string, role: string, stage: OpsConfig.StageDef)
	if rt.Prompts[key] ~= nil then
		return
	end
	local a = rt.Anchors[role]
	if a == nil or a.Attachment.Parent == nil or stage.Prompt == nil then
		return
	end
	local p = Instance.new("ProximityPrompt")
	p.Name = "WE_OpsPrompt"
	p.ActionText = TEXT.Prompts[stage.Prompt] or ""
	p.ObjectText = (rt.Def :: OpsConfig.SiteDef).Name
	p.HoldDuration = stage.Hold or 0
	p.MaxActivationDistance = stage.Dist or 10
	p.RequiresLineOfSight = false
	p:SetAttribute("WE_OpsSite", rt.Id)
	p.Parent = a.Attachment
	rt.Prompts[key] = p
	p.Triggered:Connect(function(player: Player)
		ctx.OnSitePrompt(rt, key, role, stage, player)
	end)
end

function OpsSites.DropPrompt(rt: any, key: string)
	local p = rt.Prompts[key]
	if p ~= nil then
		rt.Prompts[key] = nil
		p:Destroy()
	end
end

function OpsSites.DropPrompts(rt: any)
	for key in pairs(table.clone(rt.Prompts)) do
		OpsSites.DropPrompt(rt, key)
	end
end

-- ── the world label ────────────────────────────────────────────────────────────────────────────────────────────
local function subFor(rt: any): (string, Color3)
	local def: OpsConfig.SiteDef = rt.Def
	local st: string = rt.State
	local colors = UI.BannerColors
	if st == "Dormant" or st == "Open" then
		local kind = OpsConfig.Kinds[def.Kind]
		if kind and kind.Hostile then
			return TEXT.LabelSub.Hostile, Color3.fromRGB(230, 90, 70)
		end
		return TEXT.LabelSub.Open, colors.Open
	end
	if st == "Active" then
		return TEXT.LabelSub.Active, colors.Active
	end
	if st == "Held" then
		return TEXT.LabelSub.Held, rt.HeldColor or colors.Active
	end
	return TEXT.LabelSub[st] or TEXT.LabelSub.Closed, colors.Closed
end

--[[ The site's one stud-scaled label at its Target anchor (MaxDistance Ui.LabelMaxDistance, never on top of walls, no $
	figure: label text replicates to everyone). Text changes only when the state changes. ]]
function OpsSites.Label(rt: any)
	local def: OpsConfig.SiteDef = rt.Def
	if not def.Label then
		return
	end
	local sub, color = subFor(rt)
	local bb: BillboardGui? = rt.Label
	if bb == nil or bb.Parent == nil then
		local a = rt.Anchors[def.Target]
		if a == nil or a.Attachment.Parent == nil then
			return
		end
		local made = WorldLabel.Create(a.Attachment, def.Name, {
			Name = "WE_OpsLabel",
			Sub = sub,
			SubColor = color,
			MaxDistance = UI.LabelMaxDistance,
			Offset = Vector3.new(0, UI.LabelLift, 0),
		})
		WorldLabel.SetRole(made, nil)
		rt.Label = made
		rt.LabelSub = sub
		return
	end
	if rt.LabelSub ~= sub then
		rt.LabelSub = sub
		WorldLabel.SetText(bb, def.Name, sub, color)
	end
end

function OpsSites.DropLabel(rt: any)
	local bb = rt.Label
	rt.Label = nil
	rt.LabelSub = nil
	if bb ~= nil then
		bb:Destroy()
	end
end

-- ── doors, banner, particles (existing parts only) ─────────────────────────────────────────────────────────────
local function poiFolder(inst: Instance, poi: string): Instance?
	local want = "POI_" .. poi
	local cur = inst.Parent
	while cur ~= nil and not cur:IsA("Workspace") do
		if cur.Name == want then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

--[[ The runtime door part a door anchor names (WE_Part: BankGate, HeistGate), found ONCE at site init: the host's
	own folder first (the bank plaza), else the nearest part of that name in the POI folder (within 24 studs). ]]
function OpsSites.FindDoor(rt: any): BasePart?
	for _, a in pairs(rt.Anchors) do
		local name = a.Part
		if typeof(name) == "string" and a.Kind == "door" then
			local host = a.Attachment.Parent
			if host and host.Name ~= "ActivityHost" and host.Parent then
				local d = host.Parent:FindFirstChild(name, true)
				if d and d:IsA("BasePart") then
					return d
				end
			end
			local folder = host and poiFolder(host, (rt.Def :: OpsConfig.SiteDef).POI)
			if folder then
				local best: BasePart? = nil
				local bestD = 24
				for _, d in ipairs(folder:GetDescendants()) do -- once per site at init
					if d.Name == name and d:IsA("BasePart") then
						local dist = (d.Position - a.Position).Magnitude
						if dist < bestD then
							best, bestD = d, dist
						end
					end
				end
				return best
			end
		end
	end
	return nil
end

function OpsSites.SetDoor(rt: any, open: boolean)
	local door: BasePart? = rt.Door
	if door == nil or door.Parent == nil then
		return
	end
	local want = if open then "open" else "closed"
	if door:GetAttribute("WE_GateState") ~= want then
		door:SetAttribute("WE_GateState", want)
	end
	if door.CanCollide == open then
		door.CanCollide = not open
	end
	-- the bank gate slides (MapSetup stores both positions); a HeistGate without the attributes only toggles
	local cf = door:GetAttribute(if open then "WE_OpenCFrame" else "WE_ClosedCFrame")
	if typeof(cf) == "CFrame" and door.CFrame ~= cf then
		door.CFrame = cf
	end
	if door.CanQuery == open then
		door.CanQuery = not open -- a closed gate stops shots; a raised one never blocks a raycast
	end
end

-- the bank's StateBanner (lane BK), found once from the Door anchor's host folder; nil until BK lands
function OpsSites.FindBanner(rt: any): BasePart?
	local a = rt.Anchors[(rt.Def :: OpsConfig.SiteDef).Target]
	local host = a and a.Attachment.Parent
	local folder = host and host.Parent
	if folder == nil then
		return nil
	end
	local b = folder:FindFirstChild("StateBanner", true)
	return if b and b:IsA("BasePart") then b else nil
end

function OpsSites.Banner(rt: any)
	local banner: BasePart? = rt.Banner
	if banner == nil or banner.Parent == nil then
		return
	end
	local st: string = rt.State
	local c = UI.BannerColors
	local want = if st == "Active" then c.Active elseif st == "Open" or st == "Dormant" then c.Open else c.Closed
	if banner.Color ~= want then
		banner.Color = want
	end
end

local function emitter(parent: Instance, name: string, sparks: boolean): ParticleEmitter
	local s = UI.Smoke
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	if sparks then
		e.Rate = 12
		e.Lifetime = NumberRange.new(0.3, 0.6)
		e.Speed = NumberRange.new(8, 14)
		e.SpreadAngle = Vector2.new(40, 40)
		e.Size = NumberSequence.new(0.2, 0.05)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 200, 90))
		e.LightEmission = 0.4
	else
		e.Rate = s.Rate
		e.Lifetime = NumberRange.new(s.Lifetime)
		e.Speed = NumberRange.new(s.RiseVelocity)
		e.EmissionDirection = Enum.NormalId.Top
		e.Size = NumberSequence.new(s.SizeFrom, s.SizeTo)
		e.Color = ColorSequence.new(Color3.fromRGB(70, 70, 70))
		e.Transparency = NumberSequence.new(0.35, 1)
		e.LightEmission = 0
	end
	e.Parent = parent
	return e
end

-- one Smoke while an Active big site runs (the bank's on its StateBanner), at most 3 in the world
function OpsSites.Smoke(rt: any, on: boolean)
	local def: OpsConfig.SiteDef = rt.Def
	if on then
		if rt.SmokeFx ~= nil or not def.Big or smokeCount >= 3 then
			return
		end
		local parent: Instance? = rt.Banner
		if parent == nil or parent.Parent == nil then
			local a = rt.Anchors[def.Target]
			parent = a and a.Attachment
		end
		if parent ~= nil then
			rt.SmokeFx = emitter(parent, "WE_OpsSmoke", false)
			smokeCount += 1
		end
	elseif rt.SmokeFx ~= nil then
		rt.SmokeFx:Destroy()
		rt.SmokeFx = nil
		smokeCount = math.max(0, smokeCount - 1)
	end
end

-- the bank vault door's Sparks during the crack (the only Sparks emitter)
function OpsSites.Sparks(rt: any, on: boolean, role: string?)
	if on then
		if rt.SparksFx ~= nil or (rt.Def :: OpsConfig.SiteDef).Kind ~= "Vault" then
			return
		end
		local a = role and rt.Anchors[role]
		if a then
			rt.SparksFx = emitter(a.Attachment, "WE_OpsSparks", true)
		end
	elseif rt.SparksFx ~= nil then
		rt.SparksFx:Destroy()
		rt.SparksFx = nil
	end
end

-- a blown pump smokes for 30 s (at most 2 at once)
function OpsSites.PumpSmoke(rt: any, role: string)
	if pumpSmokeCount >= 2 then
		return
	end
	local a = rt.Anchors[role]
	if a == nil then
		return
	end
	local e = emitter(a.Attachment, "WE_OpsPumpSmoke", false)
	pumpSmokeCount += 1
	task.delay(30, function()
		e:Destroy()
		pumpSmokeCount = math.max(0, pumpSmokeCount - 1)
	end)
end

-- a Held checkpoint's sign takes the taker's colour (NationColorService, the capture-ring rule; never a flag / name)
function OpsSites.HeldSign(rt: any, color: Color3?)
	local a = rt.Anchors[(rt.Def :: OpsConfig.SiteDef).Target]
	local host = a and a.Attachment.Parent
	local sign = host and host.Parent and host.Parent:FindFirstChild("CheckpointSign")
	if not (sign and sign:IsA("BasePart")) then
		return
	end
	if color ~= nil then
		if rt.SignOrig == nil then
			rt.SignOrig = sign.Color
		end
		sign.Color = color
	elseif rt.SignOrig ~= nil then
		sign.Color = rt.SignOrig
		rt.SignOrig = nil
	end
end

function OpsSites.Counts(): (number, number)
	return smokeCount, pumpSmokeCount
end

return OpsSites
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">OpsZones</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OpsZones — who stands where, for job holds and participation (W3 step 2 Phase B, lane O; contract §4.3,
	activities §2.2). SERVER ONLY; server positions only.

	One sample per player per OpsService tick (4 Hz, Zones.TickSeconds), the BankRaidService pattern:
	  * root position, alive, seated (Humanoid.SeatPart ~= nil);
	  * under fire: a health drop seen within Zones.UnderFireSeconds (a respawn or regen raises health, never counts);
	  * teleport lockout: an on-foot root that moved more than Zones.TeleportStuds in one tick (a seated one more
	    than Zones.TeleportStudsSeated; scaled by the real tick length) resets that player's participation
	    everywhere (OnTeleport; a carried bag drops where they were) and locks them out for
	    Zones.TeleportLockoutSeconds. A new character (respawn) only re-bases the position.
	Presence test: flat XZ within r, root Y within Zones.MaxHeightDelta of the zone point (skipped for seated-allowed
	sites: a boat by the rig deck sits 26 studs below it).
	Allies: the same clan (ClanService.GetClanId, pcall'd); a player is always their own ally.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local OpsConfig = require(Shared.Configs.OpsConfig)

local Z = OpsConfig.Zones

local OpsZones = {}

export type Sample = {
	Root: BasePart?,
	Hum: Humanoid?,
	Pos: Vector3?,
	Alive: boolean,
	Seated: boolean,
	HurtAt: number,
	LockedUntil: number,
	LastHealth: number?,
	LastRoot: BasePart?,
}

local samples: { [number]: Sample } = {}
local ClanService: any = nil
local onTeleport: ((Player, Vector3?) -> ())? = nil

function OpsZones.Init(deps: { [string]: any }, teleportFn: (Player, Vector3?) -> ())
	ClanService = deps.ClanService
	onTeleport = teleportFn
end

local function blank(): Sample
	return { Root = nil, Hum = nil, Pos = nil, Alive = false, Seated = false, HurtAt = -math.huge, LockedUntil = -math.huge, LastHealth = nil, LastRoot = nil }
end

function OpsZones.Get(player: Player): Sample
	local s = samples[player.UserId]
	if s == nil then
		s = blank()
		samples[player.UserId] = s
	end
	return s
end

--[[ One sample of one player (the 4 Hz tick). dt = seconds since the last sample. ]]
function OpsZones.SamplePlayer(player: Player, nowC: number, dt: number)
	local s = OpsZones.Get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (root and root:IsA("BasePart") and hum) then
		s.Root, s.Hum, s.Pos, s.Alive, s.Seated = nil, nil, nil, false, false
		s.LastHealth, s.LastRoot = nil, nil
		return
	end
	local pos = root.Position
	local seated = hum.SeatPart ~= nil
	-- teleport lockout (on foot only): participation reset + locked out. A new root (a respawn) re-bases without a
	-- lock, but a carried bag still drops where the old character stood (OpsService's callback).
	local prev = s.Pos
	local jumped = false
	if s.LastRoot == root and prev ~= nil then
		-- seated: a vehicle may go faster, but never TeleportStudsSeated in one tick (a client-owned vehicle moved into
		-- the own plot, or a server rescue while seated, is a teleport: the bag drops, the player is locked out)
		local base = if seated or s.Seated then (Z.TeleportStudsSeated or 150) else Z.TeleportStuds
		local limit = base * math.max(1, dt / Z.TickSeconds)
		local dx, dz = pos.X - prev.X, pos.Z - prev.Z
		if dx * dx + dz * dz > limit * limit then
			s.LockedUntil = nowC + Z.TeleportLockoutSeconds
			jumped = true
		end
	elseif s.LastRoot ~= nil and s.LastRoot ~= root and prev ~= nil then
		jumped = true -- a new character: no lock, but the old position is where a bag drops
	end
	if jumped and onTeleport then
		local ok, err = pcall(onTeleport :: any, player, prev)
		if not ok then
			warn("[Ops] teleport reset failed: " .. tostring(err))
		end
	end
	-- under fire: a health drop since the last sample (same humanoid only)
	local hp = hum.Health
	if s.Hum == hum and s.LastHealth ~= nil and hp < s.LastHealth - 0.01 then
		s.HurtAt = nowC
	end
	s.Root, s.Hum, s.Pos = root, hum, pos
	s.Alive = hp > 0
	s.Seated = seated
	s.LastHealth = hp
	s.LastRoot = root
end

function OpsZones.Forget(player: Player)
	samples[player.UserId] = nil
end

function OpsZones.UnderFire(player: Player, nowC: number): boolean
	local s = samples[player.UserId]
	if s == nil or not s.Alive then
		return true
	end
	return nowC - s.HurtAt < Z.UnderFireSeconds
end

function OpsZones.HitWithin(player: Player, nowC: number, seconds: number): boolean
	local s = samples[player.UserId]
	return s ~= nil and nowC - s.HurtAt < seconds
end

function OpsZones.Locked(player: Player, nowC: number): boolean
	local s = samples[player.UserId]
	return s ~= nil and nowC < s.LockedUntil
end

-- flat XZ within r of p, and within MaxHeightDelta in Y (unless ignoreY)
function OpsZones.Within(pos: Vector3, p: Vector3, r: number, ignoreY: boolean?): boolean
	local dx, dz = pos.X - p.X, pos.Z - p.Z
	if dx * dx + dz * dz > r * r then
		return false
	end
	return ignoreY == true or math.abs(pos.Y - p.Y) <= Z.MaxHeightDelta
end

-- flat XZ distance from pos to the nearest of pts (math.huge for none)
function OpsZones.Nearest(pos: Vector3, pts: { Vector3 }): number
	local best = math.huge
	for _, p in ipairs(pts) do
		local dx, dz = pos.X - p.X, pos.Z - p.Z
		local d = dx * dx + dz * dz
		if d < best then
			best = d
		end
	end
	return if best == math.huge then best else math.sqrt(best)
end

function OpsZones.NearAny(pos: Vector3, pts: { Vector3 }, r: number, ignoreY: boolean?): boolean
	for _, p in ipairs(pts) do
		if OpsZones.Within(pos, p, r, ignoreY) then
			return true
		end
	end
	return false
end

function OpsZones.ClanOf(player: Player): string?
	if ClanService == nil or ClanService.GetClanId == nil then
		return nil
	end
	local ok, id = pcall(ClanService.GetClanId, player)
	if ok and typeof(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

-- same player, or both in one clan
function OpsZones.Allies(a: Player, b: Player): boolean
	if a == b then
		return true
	end
	local ca = OpsZones.ClanOf(a)
	return ca ~= nil and ca == OpsZones.ClanOf(b)
end

return OpsZones
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">PlotOilPumpService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Near-plot oil pumpjacks outside DefensiveWalls (toward warzone / map origin).
	Income → PendingCash. Part kit + optional IndustrialPack dress.
	Does NOT touch OilRig Alpha/Bravo far POIs.

	v71 (HUD v70 spec §5): no neon IncomePad and no "+$/tick" card over each pump.
	F4 (owner's 11 features, lane W): no server "+$18" pop either. The owner's one "+$18 / every 5s" label is the
	client ProducerLabels module (EconomyConfig.ProducerLabels), so the server makes no BillboardGui per tick.
	F9 Golden Pumpjacks (MonetizationConfig.DevProducts.GoldenPumpjack, PlotOilPumpConfig.Golden): an owner's pumps
	are gold Metal with Reflectance (never a glowing material, no light); the catalog mesh clone is recoloured too
	(re-applied after the deferred prop attach). While the Id is live and the plot owner does not own it, ONE 7x7 gold
	pad (WE_PremiumPad, PremiumPadService prompts it) stands between the pumps, PadOffsetStuds toward the plot, with
	one stud-scaled "Golden Pump" label (MaxDistance LabelMaxDistance, never AlwaysOnTop, tagged
	WorldLabelConfig.BaseLabelTag for the client LabelGovernor). The re-sync on grant (MonetizationService) removes it.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local PlotOilPumpConfig = require(Shared.Configs.PlotOilPumpConfig)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local WorldLabel = require(Shared.Util.WorldLabel)
local PlotFrame = require(Shared.Util.PlotFrame)

local GOLDEN_KEY = "GoldenPumpjack" -- MonetizationConfig.DevProducts key and entitlement
local GOLD_PAD_TAG = (Constants.Tags and Constants.Tags.PremiumPad) or "WE_PremiumPad"
-- F9: the pump kit parts that take the gold Metal dress (the Pad keeps its Asphalt, gold coloured)
local GOLDEN_KIT_PARTS: { [string]: boolean } = { Derrick = true, WalkingBeam = true, HorseHead = true }
-- F9 (lane W assumption): the walk-over gold pad never sits in the main gate lane. Where the spec spot (lateral 0,
-- PadOffsetStuds toward the plot) is closer than this to the main gate centre (plot-local (0, PlotSize/2): plots 3
-- and 4, whose pumps flank the gate), the pad moves beside the outer pump instead, on the pump line, so an owner
-- walking out of the gate is never shown a Robux sheet. Candidate for PlotOilPumpConfig.Golden (lane Z, config-first).
local GOLD_PAD_GATE_CLEAR = 24
local GOLD_PAD_BESIDE_PUMP = 8.5 -- studs from a pump centre to the pad centre (pump pad half 4 + gap 1 + pad half 3.5)

local PlotOilPumpService = {}

local BaseService: any = nil
local DataService: any = nil
local EconomyService: any = nil
local VisualAssetService: any = nil
local MonetizationService: any = nil

local pumpsByPlot: { [number]: Folder } = {}
local accum = 0

local TAG = (Constants.Tags and Constants.Tags.PlotOilPump) or "WE_PlotOilPump"

local function findPlotFolder(plotId: number): Folder?
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local bases = setup and setup:FindFirstChild("Bases")
	if not bases then
		return nil
	end
	local f = bases:FindFirstChild("Plot" .. tostring(plotId))
	if f and f:IsA("Folder") then
		return f
	end
	return nil
end

local function clearPlot(plotId: number)
	local f = pumpsByPlot[plotId]
	if f and f.Parent then
		f:Destroy()
	end
	pumpsByPlot[plotId] = nil
end

local function wallsLevelFor(player: Player): number
	if not DataService then
		return 0
	end
	local profile = DataService.GetProfile(player)
	if not profile or not profile.BaseUpgrades then
		return 0
	end
	return tonumber(profile.BaseUpgrades.DefensiveWalls) or 0
end

--[[ F9: gold dress (PlotOilPumpConfig.Golden). Kit parts Derrick / WalkingBeam / HorseHead: gold Metal + Reflectance;
	the Pad stays Asphalt with a gold colour; the catalog mesh clone (under the Derrick, VisualAssetService): every
	BasePart gold Metal, its MeshPart textures cleared, SurfaceAppearance / Texture / Decal removed. Idempotent;
	one pass over this pump model only (a few parts, on build / grant, never per frame). ]]
local function applyGoldenDress(model: Model)
	local g = PlotOilPumpConfig.Golden
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Parent == model and d.Name == "Pad" then
				d.Color = g.Color
			elseif d.Parent ~= model or GOLDEN_KIT_PARTS[d.Name] then
				d.Color = g.Color
				d.Material = g.Material
				d.Reflectance = g.Reflectance
				if d:IsA("MeshPart") then
					pcall(function()
						d.TextureID = ""
					end)
				end
			end
		elseif d:IsA("SurfaceAppearance") or d:IsA("Texture") or d:IsA("Decal") then
			d:Destroy()
		end
	end
	model:SetAttribute("WE_GoldenPump", true)
end

local function buildPumpKit(at: CFrame, parent: Instance, index: number): Model
	local model = Instance.new("Model")
	-- streaming2 S4 (F11): the pump (pad, derrick, beam, head) reaches a client whole or not at all. Set before the
	-- model is parented (it is filled first, parented below). No effect with streaming off.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = "PlotOilPump_" .. tostring(index)

	local pad = Instance.new("Part")
	pad.Name = "Pad"
	pad.Size = Vector3.new(8, 0.6, 8)
	pad.CFrame = at
	pad.Anchored = true
	pad.CanCollide = true
	pad.Color = Color3.fromRGB(42, 44, 40)
	pad.Material = Enum.Material.Asphalt
	pad.Parent = model

	local tower = Instance.new("Part")
	tower.Name = "Derrick"
	tower.Size = Vector3.new(1.1, 14, 1.1)
	tower.CFrame = at * CFrame.new(0, 7.3, 0)
	tower.Anchored = true
	tower.CanCollide = false
	tower.Color = Color3.fromRGB(70, 72, 68)
	tower.Material = Enum.Material.Metal
	tower.Parent = model

	local beam = Instance.new("Part")
	beam.Name = "WalkingBeam"
	beam.Size = Vector3.new(10, 0.55, 0.55)
	beam.CFrame = at * CFrame.new(0, 14.2, 0)
	beam.Anchored = true
	beam.CanCollide = false
	beam.Color = Color3.fromRGB(90, 70, 50)
	beam.Material = Enum.Material.Metal
	beam:SetAttribute("WE_OilBeam", true)
	beam.Parent = model

	local head = Instance.new("Part")
	head.Name = "HorseHead"
	head.Size = Vector3.new(2.2, 1.4, 1.2)
	head.CFrame = at * CFrame.new(4.2, 13.6, 0)
	head.Anchored = true
	head.CanCollide = false
	head.Color = Color3.fromRGB(80, 60, 40)
	head.Material = Enum.Material.Metal
	head.Parent = model

	-- v71: no neon IncomePad and no "+$/tick" billboard (spec §5); the owner sees a "+$18" pop when nearby

	model.PrimaryPart = pad
	model.Parent = parent

	if VisualAssetService and VisualAssetService.TryAttachPropVisual then
		task.defer(function()
			pcall(function()
				VisualAssetService.TryAttachPropVisual(tower, PlotOilPumpConfig.VisualPropKey or "IndustrialPack")
			end)
			-- F9: the catalog clone arrives after SyncPlot dressed the kit: gold it too
			if model.Parent and model:GetAttribute("WE_GoldenPump") == true then
				applyGoldenDress(model)
			end
		end)
	end

	-- v35: pumpjack spectacle — walking beam + horse head bob together
	task.spawn(function()
		local t0 = os.clock()
		while model.Parent do
			local t = os.clock() - t0
			local ang = math.sin(t * 1.1) * 14 -- degrees
			if beam.Parent then
				beam.CFrame = at * CFrame.new(0, 14.2, 0) * CFrame.Angles(0, 0, math.rad(ang))
			end
			if head.Parent then
				-- Tip of beam (~4.2 studs along X) follows tilt
				local tip = CFrame.new(4.2, 0, 0)
				head.CFrame = at * CFrame.new(0, 14.2, 0) * CFrame.Angles(0, 0, math.rad(ang)) * tip * CFrame.new(0, -0.6, 0)
			end
			task.wait(0.08)
		end
	end)


	return model
end

function PlotOilPumpService.SyncPlot(plotId: number)
	if not PlotOilPumpConfig.Enabled then
		clearPlot(plotId)
		return
	end
	local ownerUserId = if BaseService and BaseService.GetOwnerUserId then BaseService.GetOwnerUserId(plotId) else nil
	if not ownerUserId then
		clearPlot(plotId)
		return
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local walls = if owner then wallsLevelFor(owner) else 0
	if walls < (PlotOilPumpConfig.MinWallsLevel or 2) then
		clearPlot(plotId)
		return
	end

	local plotFolder = findPlotFolder(plotId)
	if not plotFolder then
		return
	end

	clearPlot(plotId)
	local folder = Instance.new("Folder")
	folder.Name = PlotOilPumpConfig.FolderName or "WE_PlotOilPumps"
	folder:SetAttribute("PlotId", plotId)
	folder:SetAttribute("OwnerUserId", ownerUserId)
	folder.Parent = plotFolder
	pumpsByPlot[plotId] = folder

	local plotPos = BaseConfig.PlotPositions[plotId]
	if typeof(plotPos) ~= "Vector3" then
		return
	end
	local toward = Vector3.new(-plotPos.X, 0, -plotPos.Z)
	if toward.Magnitude < 0.05 then
		toward = Vector3.new(0, 0, -1)
	else
		toward = toward.Unit
	end
	local right = Vector3.new(-toward.Z, 0, toward.X)
	local half = (BaseConfig.PlotSize.X or 200) * 0.5
	-- `toward` is diagonal for the corner plots: step far enough along it to clear the square plot edge
	-- by WallClearanceStuds (measured square to the wall), not just half the plot size.
	local axis = math.max(math.abs(toward.X), math.abs(toward.Z), 0.5)
	local out = (half + (PlotOilPumpConfig.WallClearanceStuds or 18)) / axis
	local spread = PlotOilPumpConfig.LateralSpreadStuds or 22
	local count = math.clamp(PlotOilPumpConfig.PumpsPerPlot or 2, 1, 2)
	local hasGold = owner ~= nil
		and MonetizationService ~= nil
		and MonetizationService.PlayerOwnsEntitlement ~= nil
		and MonetizationService.PlayerOwnsEntitlement(owner, GOLDEN_KEY) == true

	for i = 1, count do
		local lat = if count == 1 then 0 elseif i == 1 then -spread * 0.5 else spread * 0.5
		local pos = (plotPos :: Vector3) + toward * out + right * lat + Vector3.new(0, 0.5, 0)
		local look = CFrame.lookAt(pos, pos + toward)
		local pump = buildPumpKit(look, folder, i)
		pump:SetAttribute("PlotId", plotId)
		pump:SetAttribute("OwnerUserId", ownerUserId)
		if hasGold then
			applyGoldenDress(pump)
		end
		pcall(function()
			CollectionService:AddTag(pump, TAG)
		end)
	end

	-- F9: the Golden Pump pad, only while the Id is live and the owner does not own it (nothing prompts at Id 0)
	local goldDef = (MonetizationConfig.DevProducts :: any)[GOLDEN_KEY]
	local goldLive = typeof(goldDef) == "table" and typeof(goldDef.Id) == "number" and goldDef.Id ~= 0
	if goldLive and not hasGold then
		local g = PlotOilPumpConfig.Golden
		local padPos = (plotPos :: Vector3) + toward * (out - (g.PadOffsetStuds or 10)) + Vector3.new(0, 0.3, 0)
		local gate = PlotFrame.LocalToWorld(plotId, 0, half)
		if Vector3.new(padPos.X - gate.X, 0, padPos.Z - gate.Z).Magnitude < GOLD_PAD_GATE_CLEAR then
			local lat = (if count == 1 then 0 else spread * 0.5) + GOLD_PAD_BESIDE_PUMP
			padPos = (plotPos :: Vector3) + toward * out + right * lat + Vector3.new(0, 0.3, 0)
		end
		local pad = Instance.new("Part")
		pad.Name = "PremiumPad_" .. GOLDEN_KEY
		pad.Size = Vector3.new(7, 0.45, 7)
		pad.CFrame = CFrame.lookAt(padPos, padPos + toward)
		pad.Anchored = true
		pad.CanCollide = true
		pad.Color = g.Color
		pad.Material = g.Material
		pad.Reflectance = g.Reflectance
		pad.TopSurface = Enum.SurfaceType.Smooth
		pad.BottomSurface = Enum.SurfaceType.Smooth
		pad:SetAttribute("PlotId", plotId)
		pad:SetAttribute("OfferKind", "DevProduct")
		pad:SetAttribute("OfferKey", GOLDEN_KEY)
		WorldLabel.Create(pad, "Golden Pump", {
			Name = "WE_PremiumBillboard", -- the Shop client's OWNED look finds the pad label by this name
			Sub = "R$",
			Color = g.Color,
			MaxDistance = g.LabelMaxDistance,
			Offset = Vector3.new(0, 5.5, 0),
			BaseLabel = true, -- WorldLabelConfig.BaseLabelTag: counted by the client LabelGovernor
		})
		CollectionService:AddTag(pad, GOLD_PAD_TAG) -- PremiumPadService attaches through its tag listener
		pad.Parent = folder
	end

	if RunService:IsStudio() then
		print(string.format("[PlotOilPump] plot=%d walls=%d pumps=%d", plotId, walls, count))
	end
end

--[[ v69: idempotent — syncs only when the plot's pumps do not match its owner / walls level (missing, other
	owner, walls under MinWallsLevel, or folder lost to a map rebuild). Safe to call on every plot-ready. ]]
function PlotOilPumpService.EnsurePlot(plotId: number)
	if not PlotOilPumpConfig.Enabled then
		return
	end
	local ownerUserId = if BaseService and BaseService.GetOwnerUserId then BaseService.GetOwnerUserId(plotId) else nil
	local owner = if ownerUserId then Players:GetPlayerByUserId(ownerUserId) else nil
	local want = owner ~= nil and wallsLevelFor(owner) >= (PlotOilPumpConfig.MinWallsLevel or 2)
	local folder: Folder? = pumpsByPlot[plotId]
	local inSync = if want
		then folder ~= nil and folder.Parent ~= nil and folder:GetAttribute("OwnerUserId") == ownerUserId
		else folder == nil
	if not inSync then
		PlotOilPumpService.SyncPlot(plotId)
	end
end

function PlotOilPumpService.Init(deps: { [string]: any })
	BaseService = deps.BaseService
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	VisualAssetService = deps.VisualAssetService
	MonetizationService = deps.MonetizationService

	if not PlotOilPumpConfig.Enabled then
		return
	end

	if BaseService and BaseService.GetUpgradeChangedEvent then
		BaseService.GetUpgradeChangedEvent().Event:Connect(function(_userId: number, plotId: number?, structureId: string?, _level: number?)
			if structureId == "DefensiveWalls" and typeof(plotId) == "number" then
				task.defer(function()
					task.wait(0.2)
					PlotOilPumpService.SyncPlot(plotId :: number)
				end)
			end
		end)
	end

	-- v69: pumps follow the LOADED save whenever the owner's plot is (re)built — join (DataService v67 fires
	-- OnProfileLoaded only after the real save is read; BaseService then fires OnPlotReady), a freed plot handed
	-- out, prestige, map rebuild. Replaces the fixed 1.5 s / 4 s timers (missed a later save → no pumps all session).
	local hookedPlotReady = false
	if BaseService and BaseService.OnPlotReady then
		local okHook, errHook = pcall(BaseService.OnPlotReady, function(_player: Player, plotId: number)
			PlotOilPumpService.EnsurePlot(plotId)
		end)
		hookedPlotReady = okHook
		if not okHook then
			warn("[PlotOilPump] OnPlotReady hook failed:", errHook)
		end
	end
	if DataService and DataService.OnProfileLoaded then
		-- Belt: late ensure for the loaded owner's plot (no-op when already in sync); sole path if the hook failed
		DataService.OnProfileLoaded(function(player: Player, _profile: any)
			for _, delaySec in ipairs(if hookedPlotReady then { 10 } else { 1.5, 4, 10 }) do
				task.delay(delaySec, function()
					local plotId = if player.Parent and BaseService and BaseService.GetOwnedPlotId
						then BaseService.GetOwnedPlotId(player)
						else nil
					if typeof(plotId) == "number" then
						PlotOilPumpService.EnsurePlot(plotId)
					end
				end)
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		for plotId, folder in pairs(pumpsByPlot) do
			if folder:GetAttribute("OwnerUserId") == player.UserId then
				clearPlot(plotId)
			end
		end
	end)

	local tickSec = PlotOilPumpConfig.TickSeconds or 5
	local cash = PlotOilPumpConfig.CashPerTick or 18
	local reason = PlotOilPumpConfig.Reason or "plot_oil"
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < tickSec then
			return
		end
		accum = 0
		if not EconomyService or not EconomyService.AccruePendingCash then
			return
		end
		for _, folder in pairs(pumpsByPlot) do
			if folder.Parent then
				local ownerId = folder:GetAttribute("OwnerUserId")
				if typeof(ownerId) == "number" then
					local owner = Players:GetPlayerByUserId(ownerId)
					if owner then
						local n = 0
						for _, ch in ipairs(folder:GetChildren()) do
							if ch:IsA("Model") and string.find(ch.Name, "PlotOilPump", 1, true) then
								n += 1
							end
						end
						if n > 0 then
							-- F4: the owner's "+$18 / every 5s" label is client-side (ProducerLabels); no server pop
							EconomyService.AccruePendingCash(owner, cash * n, reason)
						end
					end
				end
			end
		end
	end)

	print("[WAR EMPIRE] PlotOilPumpService ready (walls≥2 → near-plot pumps → PendingCash)")
end

return PlotOilPumpService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">PremiumPadService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ATM-cluster premium pads (AutoCollect / DoubleCash / SpeedBoost / GoldenPumpjack).
	Server validates own-plot + debounce, then FireClient PromptPremiumPad.
	Client prompts Marketplace; grants only via ProcessReceipt / GamePass ownership.
	F1 / F9 (owner's 11 features, lane M): the ATM pads come from MonetizationConfig.PremiumPads.Slots (the first live
	offer of a slot is the one its pad sells) and the golden pump pad sits by the pumps; every pad is a WE_PremiumPad
	part with OfferKind / OfferKey / PlotId (and OwnedIfAny) attributes. OWNED = the offer, or any key of the slot's
	OwnedIfAny (pad attribute and config), is owned as a game pass or an entitlement, which includes Developer
	Products and entitlements granted by another product (Auto Collect from the Starter Pack). An owned pad never
	prompts; a pad whose offer Id is 0 never prompts either.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)

local PremiumPadService = {}

local DataService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local MonetizationService: any = nil
local BaseService: any = nil

local TAG = (Constants.Tags and Constants.Tags.PremiumPad) or "WE_PremiumPad"
local DEBOUNCE_SEC = 2.5
local MAX_OWNED_KEYS = 8 -- F1: a pad's OwnedIfAny attribute is read up to this many keys
local OVERLAP_MARGIN = 3.5
local SPATIAL_INTERVAL = 0.25

local lastAttempt: { [string]: number } = {}
local lastOverlap: { [string]: boolean } = {}
local attached: { [BasePart]: boolean } = {}
local partConns: { [BasePart]: { RBXScriptConnection } } = {}
local promptRemote: RemoteEvent? = nil

local function attemptKey(userId: number, offerKey: string): string
	return tostring(userId) .. "|prem|" .. offerKey
end

local function trackConn(part: BasePart, conn: RBXScriptConnection)
	local list = partConns[part]
	if not list then
		list = {}
		partConns[part] = list
	end
	table.insert(list, conn)
end

local function detach(part: BasePart)
	local list = partConns[part]
	if list then
		for _, c in ipairs(list) do
			c:Disconnect()
		end
		partConns[part] = nil
	end
	attached[part] = nil
end

local function hardenPad(part: BasePart)
	part.CanTouch = true
	part.CanCollide = true
	part.CanQuery = true
end

local function pointInPad(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	return math.abs(localPos.X) <= half.X + OVERLAP_MARGIN
		and math.abs(localPos.Z) <= half.Z + OVERLAP_MARGIN
		and localPos.Y >= -half.Y - 4
		and localPos.Y <= half.Y + 12
end

local function isSeated(character: Model): boolean
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local seat = hum.SeatPart
	if seat == nil then
		return false
	end
	return seat:IsA("VehicleSeat") or seat:IsA("Seat")
end

local function isKeyName(v: any): boolean
	return typeof(v) == "string" and #v > 0 and #v <= 64 and string.match(v, "^[%w_]+$") ~= nil
end

--[[ F1: the extra keys whose ownership makes this pad OWNED: the pad's OwnedIfAny attribute (comma string, written
	by the server when it builds the pad) plus the OwnedIfAny of every PremiumPads slot that offers this Kind + Key
	(so a pad built before the attribute existed, e.g. the Speed Boost pad, still honours the Speed Pass). ]]
local function ownedIfAnyKeys(part: BasePart?, kind: string, key: string): { string }
	local out: { string } = {}
	local seen: { [string]: boolean } = {}
	local function add(k: any)
		if #out < MAX_OWNED_KEYS and isKeyName(k) and not seen[k] then
			seen[k] = true
			table.insert(out, k)
		end
	end
	local attr = if part then part:GetAttribute("OwnedIfAny") else nil
	if typeof(attr) == "string" and #attr <= 512 then
		for _, k in ipairs(string.split(attr, ",")) do
			add(string.match(k, "^%s*(.-)%s*$"))
		end
	end
	local pads = (MonetizationConfig :: any).PremiumPads
	local slots = if typeof(pads) == "table" then pads.Slots else nil
	if typeof(slots) == "table" then
		for _, slot in ipairs(slots) do
			local offers = if typeof(slot) == "table" then slot.Offers else nil
			if typeof(offers) ~= "table" then
				continue
			end
			for _, offer in ipairs(offers) do
				if typeof(offer) == "table" and offer.Kind == kind and offer.Key == key then
					for _, k in ipairs(MonetizationConfig.PadOwnedKeys(slot)) do
						add(k)
					end
					break
				end
			end
		end
	end
	return out
end

-- one key: a game pass, an entitlement of that name, or the entitlement a Developer Product of that name grants
local function ownsKey(player: Player, key: string): boolean
	if MonetizationService.PlayerOwnsGamePass and MonetizationService.PlayerOwnsGamePass(player, key) then
		return true
	end
	if MonetizationService.PlayerOwnsEntitlement and MonetizationService.PlayerOwnsEntitlement(player, key) then
		return true
	end
	local dp = (MonetizationConfig.DevProducts :: any)[key]
	local ent = if typeof(dp) == "table" then dp.GrantEntitlement else nil
	if typeof(ent) == "string" and ent ~= key and MonetizationService.PlayerOwnsEntitlement then
		return MonetizationService.PlayerOwnsEntitlement(player, ent) == true
	end
	return false
end

local function alreadyOwns(player: Player, kind: string, key: string, part: BasePart?): boolean
	if not MonetizationService then
		return false
	end
	if kind == "GamePass" then
		if MonetizationService.PlayerOwnsGamePass and MonetizationService.PlayerOwnsGamePass(player, key) then
			return true
		end
		if MonetizationService.PlayerOwnsEntitlement and MonetizationService.PlayerOwnsEntitlement(player, key) then
			return true
		end
	elseif kind == "DevProduct" then
		local def = (MonetizationConfig.DevProducts :: any)[key]
		local ent = if typeof(def) == "table" then def.GrantEntitlement else nil
		if typeof(ent) == "string" and MonetizationService.PlayerOwnsEntitlement then
			if MonetizationService.PlayerOwnsEntitlement(player, ent) == true then
				return true
			end
		end
	end
	-- F1: OwnedIfAny (Speed pad: owning the Speed Pass OR Speed Boost = OWNED, whichever the pad sells)
	for _, k in ipairs(ownedIfAnyKeys(part, kind, key)) do
		if ownsKey(player, k) then
			return true
		end
	end
	return false
end

local function resolveOffer(kind: string, key: string): (number?, string?)
	if kind == "GamePass" then
		local def = MonetizationConfig.GamePasses[key]
		if def and typeof(def.Id) == "number" then
			return def.Id, def.DisplayName or key
		end
	elseif kind == "DevProduct" then
		local def = MonetizationConfig.DevProducts[key]
		if def and typeof(def.Id) == "number" then
			return def.Id, def.DisplayName or key
		end
	end
	return nil, nil
end

local function tryPrompt(player: Player, part: BasePart, fromStanding: boolean?)
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return
	end

	-- v68: assign a plot if missing, but never fall back to someone else's plot 1
	if profile.BasePlotId == nil and BaseService and BaseService.AssignPlot then
		BaseService.AssignPlot(player)
		profile = DataService.GetProfile(player) or profile
	end

	-- v70: another plot's pads (or an unowned plot's, or any plot's while you have none) do nothing — no
	-- prompt, no teleport. Teleporting here threw raiders off the ATM approach and anyone crossing a cluster.
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" and pid ~= profile.BasePlotId then
		return
	end

	local kind = part:GetAttribute("OfferKind")
	local offerKey = part:GetAttribute("OfferKey")
	if typeof(kind) ~= "string" or typeof(offerKey) ~= "string" then
		return
	end

	local akey = attemptKey(player.UserId, offerKey)
	local now = os.clock()
	if now - (lastAttempt[akey] or 0) < DEBOUNCE_SEC then
		return
	end
	lastAttempt[akey] = now

	if RateLimitService and not RateLimitService.Allow(player, "premium_pad", 3, 6) then
		return
	end

	if alreadyOwns(player, kind, offerKey, part) then
		if NotificationService and not fromStanding then
			if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, "OWNED", "Info", 2, 4, "prem_owned_" .. offerKey)
			else
				NotificationService.Notify(player, "OWNED", "Info", 2)
			end
		end
		return
	end

	local productId, displayName = resolveOffer(kind, offerKey)
	if productId == nil then
		return
	end
	if productId == 0 then
		if NotificationService then
			local msg = (displayName or offerKey) .. " — coming soon"
			if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, msg, "Info", 2.5, 4, "prem_stub_" .. offerKey)
			else
				NotificationService.Notify(player, msg, "Info", 2.5)
			end
		end
		return
	end

	if promptRemote then
		promptRemote:FireClient(player, {
			Kind = kind,
			Key = offerKey,
			ProductId = productId,
			DisplayName = displayName,
		})
	end
end

local function onPadTouched(part: BasePart, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end
	if isSeated(character) then
		return
	end
	local offerKey = part:GetAttribute("OfferKey")
	if typeof(offerKey) ~= "string" then
		return
	end
	local okey = tostring(part:GetAttribute("PlotId") or 0) .. "|" .. offerKey .. "|" .. tostring(player.UserId)
	if lastOverlap[okey] then
		return
	end
	lastOverlap[okey] = true
	tryPrompt(player, part, false)
end

local function attachPad(part: BasePart)
	if attached[part] then
		hardenPad(part)
		return
	end
	if not part:IsA("BasePart") then
		return
	end
	if typeof(part:GetAttribute("OfferKey")) ~= "string" then
		return
	end
	attached[part] = true
	hardenPad(part)

	trackConn(part, part.Touched:Connect(function(hit)
		if hit:IsA("BasePart") then
			onPadTouched(part, hit)
		end
	end))

	trackConn(part, part.TouchEnded:Connect(function(hit)
		if not hit:IsA("BasePart") then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		if not character then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local offerKey = part:GetAttribute("OfferKey")
		if typeof(offerKey) ~= "string" then
			return
		end
		local okey = tostring(part:GetAttribute("PlotId") or 0) .. "|" .. offerKey .. "|" .. tostring(player.UserId)
		task.defer(function()
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and pointInPad(hrp.Position, part) then
				return
			end
			lastOverlap[okey] = false
		end)
	end))

	trackConn(part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			detach(part)
		end
	end))
end

function PremiumPadService.Init(deps: { [string]: any })
	DataService = deps.DataService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	MonetizationService = deps.MonetizationService
	BaseService = deps.BaseService

	promptRemote = RemoteSetup.Get(Constants.RemoteNames.PromptPremiumPad) :: RemoteEvent

	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") then
			attachPad(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			attachPad(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			detach(inst)
		end
	end)

	-- Spatial standing check (debounce like UpgradePadService)
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < SPATIAL_INTERVAL then
			return
		end
		accum = 0
		for part, _ in pairs(attached) do
			if not part.Parent then
				continue
			end
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				if not character or isSeated(character) then
					continue
				end
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if not hrp or not hrp:IsA("BasePart") then
					continue
				end
				local offerKey = part:GetAttribute("OfferKey")
				if typeof(offerKey) ~= "string" then
					continue
				end
				local okey = tostring(part:GetAttribute("PlotId") or 0) .. "|" .. offerKey .. "|" .. tostring(player.UserId)
				local inside = pointInPad(hrp.Position, part)
				if inside and not lastOverlap[okey] then
					lastOverlap[okey] = true
					tryPrompt(player, part, true)
				elseif not inside then
					lastOverlap[okey] = false
				end
			end
		end
	end)

	print("[WAR EMPIRE] PremiumPadService ready (ATM-cluster Robux pads)")
end

return PremiumPadService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">PrestigeService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Prestige / Rebirth — server-authoritative.
	Each prestige: permanent +10% cash earnings (EconomyConfig.PrestigeCashMultiplierPerLevel).
	RebirthUnlocks from PrestigeConfig applied into profile.RebirthUnlocks (+ optional vehicle/weapon grants).
	Alias: DoRebirth == DoPrestige.

	Owner's 11 features (lane P, spec_f11 F7 + F11):
	  Two rebirth paths, same gate (Level >= MinLevelToPrestige, Prestige < MaxPrestige):
	    free ("Cash")   ResetOnPrestige: cash, level, XP and every base upgrade reset
	    keep-base       ResetOnPrestigeKeepBase: the same but BaseUpgrades are KEPT. Spends one token from
	                    profile.KeepBaseRebirths. Tokens come ONLY from the 50 R$ RebirthKeepBase DevProduct: the
	                    receipt adds the token and saves it before PurchaseGranted (MonetizationService CounterGrants).
	                    The rebirth itself never runs inside the receipt: the OnGranted listener below (after the
	                    save) uses the token at once when this session prompted the product (purchase intent) and
	                    the player can rebirth; otherwise the token is banked for later. Tokens never expire.
	  PrestigeConfig.ResetFor(path) is the ONE reset table per path, and PrestigeConfig.RebirthSummary(path, ctx)
	  builds the confirm modal's KEEP / RESET / GAIN lines from the same table (pushed in PrestigeStateUpdate.Summary).
	  RequestPrestige(path): the keep-base path only when path == "KeepBase"; anything else is the free path. A
	  keep-base request with no token is refused and never falls through to the free path.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local PrestigeConfig = require(Shared.Configs.PrestigeConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local PrestigeService = {}

-- F7: DoPrestige options. KeepBase = true spends one keep-base token (profile.KeepBaseRebirths).
export type PrestigeOpts = { KeepBase: boolean? }

local DataService: any = nil
local EconomyService: any = nil
local XPService: any = nil
local BaseService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local VehicleService: any = nil
local MonetizationService: any = nil

local MAX_TOKENS = 1e15 -- same ceiling as ProfileSchema / MonetizationService counters
-- F11: coalesce state pushes caused by base buys / level-ups (the modal's "(N built)" line and the READY state)
local PUSH_COALESCE_SECONDS = 1.5

-- Whole number >= 0; junk (nil, strings, NaN, inf, negatives) becomes 0.
local function nonNegInt(value: any): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return math.clamp(math.floor(n), 0, MAX_TOKENS)
end

local function cashBonusPer(): number
	return PrestigeConfig.CashBonusPerPrestige
		or EconomyConfig.PrestigeCashMultiplierPerLevel
		or 0.10
end


local function baseCompletionPercent(profile: any): number
	local owned = 0
	local maxN = 0
	local upgrades = profile.BaseUpgrades
	if typeof(upgrades) ~= "table" then
		upgrades = {}
	end
	for id, _def in pairs(BaseConfig.Structures) do
		maxN += 1
		if (tonumber(upgrades[id]) or 0) > 0 then
			owned += 1
		end
	end
	if maxN <= 0 then
		return 0
	end
	return math.floor((owned / maxN) * 100)
end

-- F11: structure levels bought (the modal's "Base buildings (N built)" line; businesses count while merged)
local function builtCount(profile: any): number
	local upgrades = profile.BaseUpgrades
	if typeof(upgrades) ~= "table" then
		return 0
	end
	local n = 0
	for id in pairs(BaseConfig.Structures) do
		n += nonNegInt(upgrades[id])
	end
	return n
end

-- F11: war businesses are live (they reset with the base on the free path). A config error counts as off.
local function businessesOn(): boolean
	local ok, cfg = pcall(function(): any
		return require(Shared.Configs.BusinessConfig)
	end)
	return ok and typeof(cfg) == "table" and cfg.Enabled == true
end

-- F7: the keep-base product entry (MonetizationConfig.DevProducts[PrestigeConfig.KeepBase.ProductKey])
local function keepBaseProduct(): any
	local key = PrestigeConfig.KeepBase.ProductKey
	local def = (MonetizationConfig.DevProducts :: any)[key]
	return if typeof(def) == "table" then def else nil
end

-- F7: the keep-base path can be SOLD (the Rebirth modal prompts it) only while its Id is pasted and it is Enabled.
-- A saved token is always usable (it was paid for), whatever these say.
local function keepBaseLive(): boolean
	local def = keepBaseProduct()
	local id = if def then tonumber(def.Id) else nil
	return PrestigeConfig.KeepBase.Enabled == true and id ~= nil and id ~= 0
end

local function keepBasePrice(): number
	local def = keepBaseProduct()
	return nonNegInt(if def then def.RobuxPrice else 0)
end

-- display-only mirror of the token count (the same attribute the receipt's CounterGrants writes)
local function publishTokens(player: Player, profile: any)
	local spec = (MonetizationConfig :: any).CounterGrants
	local grant = if typeof(spec) == "table" then spec.GrantKeepBaseRebirths else nil
	local attr = if typeof(grant) == "table" and typeof(grant.Attribute) == "string" then grant.Attribute else "WE_KeepBaseRebirths"
	pcall(function()
		player:SetAttribute(attr, nonNegInt(profile.KeepBaseRebirths))
	end)
end

local function feeSummaryFor(profile: any): string
	local pct = baseCompletionPercent(profile)
	if PrestigeConfig.BuildFeeSummary then
		return PrestigeConfig.BuildFeeSummary({ BaseCompletionPercent = pct })
	end
	local fee = tonumber(PrestigeConfig.CashFee) or 0
	local feePart = if fee > 0 then string.format("Fee $%s", tostring(fee)) else "Fee: none"
	return string.format(
		"%s · Cash → $%s after · +%d Gold · Base %d%%",
		feePart,
		tostring(PrestigeConfig.StartingCashAfterPrestige or 0),
		tonumber(PrestigeConfig.GoldBonusOnPrestige) or 0,
		pct
	)
end


local function unlockListFor(prestige: number): { any }
	local list = {}
	for _, u in ipairs(PrestigeConfig.RebirthUnlocks or {}) do
		table.insert(list, {
			AtPrestige = u.AtPrestige,
			Flag = u.Flag,
			DisplayName = u.DisplayName,
			Kind = u.Kind,
			Id = u.Id,
			Unlocked = prestige >= u.AtPrestige,
		})
	end
	return list
end

local function applyUnlocks(player: Player, profile: any, newPrestige: number)
	if typeof(profile.RebirthUnlocks) ~= "table" then
		profile.RebirthUnlocks = {}
	end
	local newly: { string } = {}
	for _, u in ipairs(PrestigeConfig.RebirthUnlocks or {}) do
		if newPrestige >= u.AtPrestige and not profile.RebirthUnlocks[u.Flag] then
			profile.RebirthUnlocks[u.Flag] = true
			table.insert(newly, u.DisplayName or u.Flag)
			if u.GrantOwned and typeof(u.Id) == "string" then
				if u.Kind == "Vehicle" then
					profile.Vehicles[u.Id] = true
					if VehicleService and VehicleService.GrantVehicle then
						-- GrantVehicle marks dirty + push; safe even if already owned
						VehicleService.GrantVehicle(player, u.Id)
					end
				elseif u.Kind == "Weapon" then
					profile.Weapons[u.Id] = true
				end
			end
		end
	end
	return newly
end

-- per-player: the CanPrestige value last pushed (a level-up that flips it pushes at once), and a queued push
local lastPushedCan: { [number]: boolean } = {}
local pushQueued: { [number]: boolean } = {}

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local bonus = cashBonusPer()
	local prestige = nonNegInt(profile.Prestige)
	local level = math.max(1, nonNegInt(profile.Level))
	local xp = nonNegInt(profile.XP)
	local nextMultPct = math.floor((prestige + 1) * bonus * 100)
	local curMultPct = math.floor(prestige * bonus * 100)
	local remote = RemoteSetup.Get(Constants.RemoteNames.PrestigeStateUpdate) :: RemoteEvent
	local basePct = baseCompletionPercent(profile)
	local canPrestige = PrestigeService.CanPrestige(player)
	-- F11: the confirm modal's columns, built by the same function (and reset tables) DoPrestige uses
	local ctx: PrestigeConfig.RebirthSummaryCtx = {
		Built = builtCount(profile),
		Prestige = prestige,
		NextUnlock = PrestigeConfig.NextUnlockName(prestige),
		BusinessesOn = businessesOn(),
	}
	local payload: Types.PrestigeStatePayload = {
		Prestige = prestige,
		CanPrestige = canPrestige,
		MinLevel = PrestigeConfig.MinLevelToPrestige,
		MaxPrestige = PrestigeConfig.MaxPrestige,
		CashBonusPerLevel = bonus,
		CashMultPercent = curMultPct,
		NextCashMultPercent = nextMultPct,
		GoldBonusOnPrestige = PrestigeConfig.GoldBonusOnPrestige,
		CashFee = tonumber(PrestigeConfig.CashFee) or 0,
		StartingCashAfter = PrestigeConfig.StartingCashAfterPrestige,
		BaseCompletionPercent = basePct,
		FeeSummary = feeSummaryFor(profile),
		RebirthUnlocks = profile.RebirthUnlocks or {},
		UnlockTrack = unlockListFor(prestige),
		-- F7 / F11 (display only; RequestPrestige and the receipt re-check everything)
		KeepBaseTokens = nonNegInt(profile.KeepBaseRebirths),
		KeepBaseLive = keepBaseLive(),
		KeepBasePrice = keepBasePrice(),
		ProgressPct = PrestigeConfig.ProgressPct(level, xp),
		Level = level,
		XP = xp,
		Summary = {
			Cash = PrestigeConfig.RebirthSummary("Cash", ctx),
			KeepBase = PrestigeConfig.RebirthSummary("KeepBase", ctx),
		},
	}
	lastPushedCan[player.UserId] = canPrestige
	remote:FireClient(player, payload)
end

-- one push per player per PUSH_COALESCE_SECONDS for background changes (base buys, level-ups)
local function schedulePush(player: Player)
	local uid = player.UserId
	if pushQueued[uid] then
		return
	end
	pushQueued[uid] = true
	task.delay(PUSH_COALESCE_SECONDS, function()
		pushQueued[uid] = nil
		if player.Parent and DataService and DataService.GetProfile(player) then
			pushState(player)
		end
	end)
end

function PrestigeService.CanPrestige(player: Player): boolean
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	if profile.Level < PrestigeConfig.MinLevelToPrestige or profile.Prestige >= PrestigeConfig.MaxPrestige then
		return false
	end
	local fee = tonumber(PrestigeConfig.CashFee) or 0
	if fee > 0 and (tonumber(profile.Cash) or 0) < fee then
		return false
	end
	return true
end

function PrestigeService.HasUnlock(player: Player, flag: string): boolean
	local profile = DataService.GetProfile(player)
	if not profile or typeof(profile.RebirthUnlocks) ~= "table" then
		return false
	end
	return profile.RebirthUnlocks[flag] == true
end

-- F7: saved keep-base tokens (0 when the profile is not loaded)
function PrestigeService.KeepBaseTokens(player: Player): number
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return 0
	end
	return nonNegInt(profile.KeepBaseRebirths)
end

--[[ opts.KeepBase = true: the 50 R$ keep-base path (spends one token; refused with "NoKeepBaseToken" when there is
	none, never the free path instead). Everything from the checks to the last reset field runs without yielding,
	so two requests in the same frame (the OnGranted auto-use and a tap) give ONE rebirth: the second sees Level 1. ]]
function PrestigeService.DoPrestige(player: Player, opts: PrestigeOpts?): (boolean, string?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local keepBase = typeof(opts) == "table" and opts.KeepBase == true
	if profile.Prestige >= PrestigeConfig.MaxPrestige then
		return false, "MaxPrestige"
	end
	if profile.Level < PrestigeConfig.MinLevelToPrestige then
		return false, "LevelTooLow"
	end
	if keepBase and nonNegInt(profile.KeepBaseRebirths) <= 0 then
		return false, "NoKeepBaseToken"
	end
	local fee = tonumber(PrestigeConfig.CashFee) or 0
	if fee > 0 and (tonumber(profile.Cash) or 0) < fee then
		return false, "NeedCashFee"
	end

	-- ── one no-yield block: token, prestige and the path's reset table ──
	local reset = PrestigeConfig.ResetFor(if keepBase then "KeepBase" else "Cash")
	if keepBase then
		profile.KeepBaseRebirths = nonNegInt(profile.KeepBaseRebirths) - 1
	end
	profile.Prestige += 1

	if fee > 0 then
		profile.Cash = math.max(0, (tonumber(profile.Cash) or 0) - fee)
	end
	if reset.Cash then
		profile.Cash = PrestigeConfig.StartingCashAfterPrestige
	end
	if reset.Level then
		profile.Level = 1
	end
	if reset.XP then
		profile.XP = 0
	end
	if reset.BaseUpgrades then
		for id in pairs(BaseConfig.Structures) do
			profile.BaseUpgrades[id] = 0
		end
	end
	-- Vehicles / Weapons / Gold / RebirthUnlocks kept per Keep* flags.
	-- Income buffs survive rebirth: OutpostIncomeStacks + Territories are NOT reset
	-- (competitor-style permanent outpost income). PrestigeConfig unlocks unchanged.
	-- PendingCash (the ATM) is kept on both paths (owner decision, ASSUMPTIONS).
	-- ── end of the no-yield block ──

	local newly = applyUnlocks(player, profile, profile.Prestige)

	DataService.MarkDirty(player)
	if keepBase then
		publishTokens(player, profile)
	end

	if PrestigeConfig.GoldBonusOnPrestige > 0 then
		EconomyService.AddGold(player, PrestigeConfig.GoldBonusOnPrestige, "prestige")
	end

	-- Reaffirm outpost stacks from owned Territories (never wipe stacks on prestige)
	if EconomyService.SyncOutpostIncomeStacks then
		pcall(EconomyService.SyncOutpostIncomeStacks, player)
	end

	if EconomyService.Push then
		EconomyService.Push(player)
	end
	if XPService and XPService.Push then
		XPService.Push(player)
	end
	if BaseService and BaseService.PushState then
		BaseService.PushState(player)
		-- F7: the keep-base path changes no structure level, so the base is not rebuilt (0 instance changes)
		if reset.BaseUpgrades and BaseService.RefreshAllVisuals then
			BaseService.RefreshAllVisuals(player)
		end
	end

	pushState(player)

	local bonusPct = math.floor(profile.Prestige * cashBonusPer() * 100)
	local unlockNote = if #newly > 0 then (" Unlocked: " .. table.concat(newly, ", ") .. ".") else ""
	if NotificationService then
		local msg = if keepBase
			then string.format("Rebirth P%d!  Base kept  +%d Gold%s", profile.Prestige, PrestigeConfig.GoldBonusOnPrestige, unlockNote)
			else string.format(
				"Rebirth P%d! +%d Gold. Cash earnings +%d%%%s",
				profile.Prestige,
				PrestigeConfig.GoldBonusOnPrestige,
				bonusPct,
				unlockNote
			)
		NotificationService.Notify(player, msg, "Success", 7)
	end
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(AnalyticsConfig.Events.PRESTIGE or "PRESTIGE", player.UserId, {
			prestige = profile.Prestige,
			unlocks = newly,
			path = if keepBase then "keep_base" else "free",
		})
	end

	return true, nil
end

-- F11: player-facing refusal copy (short, no key names; the modal also disables its buttons for these)
local REFUSAL_TEXT: { [string]: string } = {
	LevelTooLow = string.format("Reach Lv %d to rebirth", PrestigeConfig.MinLevelToPrestige),
	MaxPrestige = "Max rebirth reached",
	NeedCashFee = "Not enough cash to rebirth",
	NoKeepBaseToken = "No Keep-Base Rebirth saved",
	NoProfile = "Still loading, try again",
}

function PrestigeService.RefusalText(err: string?): string
	return REFUSAL_TEXT[tostring(err)] or "Rebirth not ready"
end

--[[ F7: after a RebirthKeepBase grant is SAVED (MonetizationService.OnGranted; never inside the receipt).
	Auto-use when KeepBase.AutoUseOnGrant, this session prompted the product (event.Source ~= "none": the purchase
	intent is at most MonetizationConfig.IntentAttributionSeconds old) and the player can rebirth now. Otherwise the
	token stays banked (saved; used from the Rebirth modal later). A receipt that lands before this listener exists
	(before PrestigeService.Init) is simply banked. ]]
local function onGranted(player: Player, productKey: string, event: any)
	local kb = PrestigeConfig.KeepBase
	if productKey ~= kb.ProductKey or typeof(event) ~= "table" then
		return
	end
	local counters = event.Counters
	local added = if typeof(counters) == "table" then nonNegInt(counters.KeepBaseRebirths) else 0
	if added <= 0 or not player.Parent then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if kb.AutoUseOnGrant == true and event.Source ~= "none" and PrestigeService.CanPrestige(player) then
		local ok = PrestigeService.DoPrestige(player, { KeepBase = true })
		if ok then
			return
		end
	end
	pushState(player)
	-- a tap in the same frame (USE SAVED) may already have spent it: then there is nothing banked to announce
	if nonNegInt(profile.KeepBaseRebirths) <= 0 then
		return
	end
	if NotificationService then
		local level = tonumber(profile.Level) or 1
		local msg = if nonNegInt(profile.Prestige) >= PrestigeConfig.MaxPrestige
			then "Keep-Base Rebirth saved"
			elseif level < PrestigeConfig.MinLevelToPrestige then string.format("Keep-Base Rebirth saved  use it at Lv %d", PrestigeConfig.MinLevelToPrestige)
			else "Keep-Base Rebirth saved  use it in Rebirth"
		NotificationService.Notify(player, msg, "Success", 6)
	end
end

-- v71 (HUD v70 spec §4.2): the near-rebirth nudge shows ONCE per session for each level in the window (L38, L39);
-- the Rebirth badge does the rest. Was: every 90 s, and it named a keyboard key that phones do not have.
local nearNudged: { [number]: { [number]: boolean } } = {}

-- v38: soft rebirth CTA when Level is within NearPrestigeLevels of Min
-- XPService calls this on every level-up. F11: it also pushes the rebirth state when READY flips (the modal's
-- REBIRTH button), coalesced; the % bar itself follows XPUpdate on the client.
function PrestigeService.MaybeNearPrestigeToast(player: Player)
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return
	end
	if RemoteSetup then
		local can = PrestigeService.CanPrestige(player)
		local last = lastPushedCan[player.UserId]
		if last ~= nil and last ~= can then
			schedulePush(player)
		end
	end
	if not NotificationService then
		return
	end
	local minLv = PrestigeConfig.MinLevelToPrestige or 40
	local near = PrestigeConfig.NearPrestigeLevels or 2
	local level = tonumber(profile.Level) or 1
	local prestige = tonumber(profile.Prestige) or 0
	local maxP = PrestigeConfig.MaxPrestige or 50
	if prestige >= maxP then
		return
	end
	if level >= minLv then
		return -- CanPrestige join toast covers READY
	end
	if level < (minLv - near) then
		return
	end
	local seen = nearNudged[player.UserId]
	if not seen then
		seen = {}
		nearNudged[player.UserId] = seen
	end
	if seen[level] then
		return
	end
	seen[level] = true
	local remain = minLv - level
	local msg = string.format(
		"Rebirth almost ready (Lv %d/%d) — %d level%s left · Keep all Robux Items",
		level,
		minLv,
		remain,
		if remain == 1 then "" else "s"
	)
	NotificationService.Notify(player, msg, "Info", 5.5)
end

-- Alias for MT-inspired "rebirth" wording
function PrestigeService.DoRebirth(player: Player, opts: PrestigeOpts?): (boolean, string?)
	return PrestigeService.DoPrestige(player, opts)
end

function PrestigeService.Push(player: Player)
	pushState(player)
end

--[[ Admin allowlist only (AdminService "givekeepbase"; never a remote of its own): adds n (1-5) keep-base tokens to
	the caller so the owner can test the keep-base path on his phone before the product Id is pasted. ]]
function PrestigeService.AdminGiveKeepBase(player: Player, n: number): (boolean, string?)
	local profile = DataService and DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local add = math.clamp(math.floor(tonumber(n) or 1), 1, 5)
	profile.KeepBaseRebirths = math.min(nonNegInt(profile.KeepBaseRebirths) + add, MAX_TOKENS)
	DataService.MarkDirty(player)
	publishTokens(player, profile)
	pushState(player)
	return true, nil
end

function PrestigeService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	XPService = deps.XPService
	BaseService = deps.BaseService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	VehicleService = deps.VehicleService
	MonetizationService = deps.MonetizationService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestPrestige) :: RemoteEvent
	-- F7: optional 1st arg `path`. Only the exact string "KeepBase" picks the keep-base path (server-checked token).
	remote.OnServerEvent:Connect(function(player: Player, rawPath: any)
		-- v69: extra taps are dropped silently (the allowed tap already answered) — never a strike
		if not RateLimitService.Allow(player, "prestige", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local path = if rawPath == "KeepBase" then "KeepBase" else "Cash"
		local ok, err = PrestigeService.DoPrestige(player, { KeepBase = path == "KeepBase" })
		if not ok then
			if NotificationService then
				NotificationService.Notify(player, PrestigeService.RefusalText(err), "Warn")
			end
			-- the modal waits for a state push to leave REBIRTHING...
			pushState(player)
		end
	end)

	-- F7: use a keep-base token right after its receipt is saved (see onGranted)
	local mon = MonetizationService
	if mon and typeof(mon.OnGranted) == "function" then
		local okListen, listenErr = pcall(mon.OnGranted, onGranted)
		if not okListen then
			warn("[PrestigeService] OnGranted listener not registered:", listenErr)
		end
	end

	-- F11: keep the modal's "Base buildings (N built)" line true while the player buys (coalesced push)
	if BaseService and BaseService.GetUpgradeChangedEvent then
		local okEv, ev = pcall(BaseService.GetUpgradeChangedEvent)
		if okEv and ev and ev.Event then
			ev.Event:Connect(function(userId: any)
				local p = Players:GetPlayerByUserId(tonumber(userId) or 0)
				if p and lastPushedCan[p.UserId] ~= nil then
					schedulePush(p)
				end
			end)
		end
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		nearNudged[player.UserId] = nil
		lastPushedCan[player.UserId] = nil
		pushQueued[player.UserId] = nil
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.RebirthUnlocks) ~= "table" then
			profile.RebirthUnlocks = {}
			DataService.MarkDirty(player)
		end
		-- Re-apply unlock flags for current prestige (idempotent) in case config grew
		applyUnlocks(player, profile, profile.Prestige or 0)
		pushState(player)
		-- UX: remind eligible commanders (MinLevelToPrestige = 40) that Rebirth is ready
		if PrestigeService.CanPrestige(player) and NotificationService then
			local msg = string.format(
				"REBIRTH READY (Lv %d) — %s · Rebirth for +10%% cash forever",
				tonumber(profile.Level) or PrestigeConfig.MinLevelToPrestige,
				feeSummaryFor(profile)
			)
			if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, msg, "Success", 6, 120, "prestige_ready_join")
			else
				NotificationService.Notify(player, msg, "Success", 6)
			end
		else
			PrestigeService.MaybeNearPrestigeToast(player)
		end
	end)
end

return PrestigeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">RateLimitService</string>
            <string name="Source"><![CDATA[--!strict
--[[ Per-player remote rate limiting ]]

local RateLimitService = {}

type Bucket = { tokens: number, lastRefill: number }

local buckets: { [number]: { [string]: Bucket } } = {}
local DEFAULT_RATE = 8 -- tokens per second
local DEFAULT_BURST = 12

function RateLimitService.Init()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

local function getBucket(userId: number, key: string, rate: number, burst: number): Bucket
	if not buckets[userId] then
		buckets[userId] = {}
	end
	local userBuckets = buckets[userId]
	local b = userBuckets[key]
	if not b then
		b = { tokens = burst, lastRefill = os.clock() }
		userBuckets[key] = b
	end
	local now = os.clock()
	local elapsed = now - b.lastRefill
	b.tokens = math.min(burst, b.tokens + elapsed * rate)
	b.lastRefill = now
	return b
end

function RateLimitService.Allow(player: Player, key: string, rate: number?, burst: number?): boolean
	local r = rate or DEFAULT_RATE
	local burstAmt = burst or DEFAULT_BURST
	local b = getBucket(player.UserId, key, r, burstAmt)
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

return RateLimitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">ResearchService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	v69 Research Lab upgrades (weapons, soldiers, vehicles, defenses) — server-authoritative.
	Tree, prices and gating live in Shared/Configs/ResearchConfig. Levels persist in profile.Research
	({ [upgradeId] = level }) and are PERMANENT (PrestigeService never resets them).

	Remotes:
	  RequestResearch     (client → server) FireServer("Buy", upgradeId) | FireServer("Sync")
	  ResearchStateUpdate (server → client) ResearchConfig.ResearchStatePayload

	Contract used by other services (safe to call before Init / without a profile / per shot):
	  ResearchService.GetBonus(player, statId) -> multiplier >= 1 (1 = no bonus)
	    statId ∈ WeaponDamage, WeaponFireRate, WeaponMagazine, WeaponReload, SoldierHealth, SoldierDamage,
	             VehicleSpeed, VehicleArmor, TurretDamage
	  ResearchService.GetAdd(player, statId) -> additive bonus >= 0 (SquadSize)
	Hooks: CombatService (Weapon*), SquadOrdersService (Soldier*, SquadSize), VehicleService (Vehicle*),
	GateDefenseService (TurretDamage).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local ResearchConfig = require(Shared.Configs.ResearchConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

type UpgradeDef = ResearchConfig.UpgradeDef
type ResearchLock = ResearchConfig.ResearchLock
type ResearchStatePayload = ResearchConfig.ResearchStatePayload

local ResearchService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local BaseService: any = nil
local CombatService: any = nil
local SquadOrdersService: any = nil
local VehicleService: any = nil
local AnalyticsService: any = nil

-- Structures whose level changes what the panel shows (lab gate + track requirements).
local WATCHED_STRUCTURES: { [string]: boolean } = {
	[ResearchConfig.StructureId] = true,
	Barracks = true,
	VehicleDepot = true,
	DefensiveWalls = true,
}

-- Lazy DataService: GetBonus may run (CombatService OnProfileLoaded / first shot) before ResearchService.Init.
local function getDataService(): any
	if DataService ~= nil then
		return DataService
	end
	local parent = script.Parent
	local mod = if parent then parent:FindFirstChild("DataService") else nil
	if mod == nil then
		return nil
	end
	local ok, ds = pcall(require, mod :: any)
	if ok and ds ~= nil then
		DataService = ds
		return ds
	end
	return nil
end

local function getProfile(player: Player): any
	local ds = getDataService()
	if ds == nil or ds.GetProfile == nil then
		return nil
	end
	local ok, profile = pcall(ds.GetProfile, player)
	if ok and typeof(profile) == "table" then
		return profile
	end
	return nil
end

local function researchOf(player: Player): any
	local profile = getProfile(player)
	if profile == nil then
		return nil
	end
	return profile.Research
end

local function structureLevel(profile: any, structureId: string): number
	local ups = profile.BaseUpgrades
	if typeof(ups) ~= "table" then
		return 0
	end
	local v = tonumber(ups[structureId])
	if v == nil or v ~= v then
		return 0
	end
	return math.floor(v)
end

--[[ Lock for a whole track (its building is missing), or nil when the track is open. ]]
local function trackLock(profile: any, trackId: string): ResearchLock?
	local track = ResearchConfig.Tracks[trackId]
	if track == nil then
		return { Code = "NeedStructure", Text = "Unavailable" }
	end
	local req = track.Requires
	if req == nil then
		return nil
	end
	if structureLevel(profile, req.StructureId) >= req.Level then
		return nil
	end
	return { Code = "NeedStructure", Text = req.Text }
end

local function roman(level: number): string
	return ResearchConfig.Roman[level] or tostring(level)
end

local function notify(player: Player, message: string, kind: string, duration: number?)
	if NotificationService and NotificationService.Notify then
		pcall(NotificationService.Notify, player, message, kind, duration)
	end
end

-- ── Public API ──────────────────────────────────────────────────────────────────────────────────────────

--[[ Multiplier >= 1 for a Kind "Mult" stat (1 = none). Never errors; cheap (called per shot). ]]
function ResearchService.GetBonus(player: Player, statId: string): number
	local m = ResearchConfig.MultFor(researchOf(player), statId)
	if typeof(m) == "number" and m == m and m >= 1 then
		return m
	end
	return 1
end

--[[ Additive bonus >= 0 for a Kind "Add" stat (SquadSize). ]]
function ResearchService.GetAdd(player: Player, statId: string): number
	local a = ResearchConfig.AddFor(researchOf(player), statId)
	if typeof(a) == "number" and a == a and a >= 0 then
		return a
	end
	return 0
end

--[[ Owned level of an upgrade (0 when absent). ]]
function ResearchService.GetLevel(player: Player, upgradeId: string): number
	return ResearchConfig.LevelOf(researchOf(player), upgradeId)
end

--[[ State for the panel (nil until the real save has loaded). Pure: fires nothing. ]]
function ResearchService.BuildState(player: Player): ResearchStatePayload?
	local profile = getProfile(player)
	if profile == nil then
		return nil
	end
	local research = profile.Research
	local labLevel = structureLevel(profile, ResearchConfig.StructureId)
	local levels: { [string]: number } = {}
	local costs: { [string]: number } = {}
	local locks: { [string]: ResearchLock } = {}
	local tracks: { [string]: ResearchLock } = {}
	for _, trackId in ipairs(ResearchConfig.TrackOrder) do
		local lock = trackLock(profile, trackId)
		if lock then
			tracks[trackId] = lock
		end
	end
	for id, def in pairs(ResearchConfig.Upgrades) do
		local lvl = ResearchConfig.LevelOf(research, id)
		levels[id] = lvl
		if lvl < def.MaxLevel then
			local c = def.Costs[lvl + 1]
			if typeof(c) == "number" and c > 0 then
				costs[id] = c
			end
		end
		local lock: ResearchLock? = nil
		if not def.Enabled then
			lock = { Code = "Disabled", Text = "Coming soon" }
		elseif lvl >= def.MaxLevel then
			lock = { Code = "Maxed", Text = "MAXED" }
		else
			local tl = trackLock(profile, def.Track)
			if tl then
				lock = { Code = "NeedStructure", Text = tl.Text }
			else
				local needLab = ResearchConfig.LabLevelFor(def, lvl + 1)
				if labLevel < needLab then
					lock = { Code = "NeedLab", Text = string.format("Needs Research Lab L%d", needLab) }
				end
			end
		end
		if lock then
			locks[id] = lock
		end
	end
	return {
		LabLevel = labLevel,
		Levels = levels,
		Costs = costs,
		Locks = locks,
		Tracks = tracks,
	}
end

--[[ Send the panel state to the player's client (no-op until the save has loaded). ]]
function ResearchService.Push(player: Player)
	if RemoteSetup == nil then
		return
	end
	local ok, err = pcall(function(): any
		local payload = ResearchService.BuildState(player)
		if payload == nil or player.Parent == nil then
			return nil
		end
		local remote = RemoteSetup.Get(Constants.RemoteNames.ResearchStateUpdate) :: RemoteEvent
		remote:FireClient(player, payload)
		return nil
	end)
	if not ok then
		warn("[ResearchService] Push failed:", err)
	end
end

--[[ Buy the next level of an upgrade. Server-authoritative: id validated, price from ResearchConfig,
	Lab + track gates re-checked, Cash via EconomyService.SpendCash. Returns (true) or (false, error). ]]
function ResearchService.Purchase(player: Player, upgradeId: any): (boolean, string?)
	-- 1-3: id / def / enabled
	if not RemoteGuard.IsIdString(upgradeId, 48) then
		return false, "InvalidUpgrade"
	end
	local id = upgradeId :: string
	local def = ResearchConfig.Upgrades[id]
	if def == nil or def.Id ~= id then
		return false, "UnknownUpgrade"
	end
	if not def.Enabled then
		return false, "Disabled"
	end
	-- 4: profile (nil until the real save has loaded)
	local profile = getProfile(player)
	if profile == nil then
		return false, "NoProfile"
	end
	if typeof(profile.Research) ~= "table" then
		profile.Research = {}
	end
	local research = profile.Research
	-- 5: maxed
	local cur = ResearchConfig.LevelOf(research, id)
	if cur >= def.MaxLevel then
		return false, "Maxed"
	end
	local target = cur + 1
	-- 6: track building
	local track = ResearchConfig.Tracks[def.Track]
	if track == nil then
		return false, "BadConfig"
	end
	local req = track.Requires
	if req ~= nil and structureLevel(profile, req.StructureId) < req.Level then
		return false, "TrackLocked"
	end
	-- 7: Research Lab level
	if structureLevel(profile, ResearchConfig.StructureId) < ResearchConfig.LabLevelFor(def, target) then
		return false, "LabLevelTooLow"
	end
	-- 8: price (server config only) — nothing yields between the checks above and the write below
	local cost = def.Costs[target]
	if typeof(cost) ~= "number" or cost ~= cost or cost <= 0 or cost == math.huge then
		return false, "BadConfig"
	end
	cost = math.floor(cost)
	if EconomyService == nil or EconomyService.SpendCash == nil then
		return false, "SpendFailed"
	end
	local spent, spendErr = EconomyService.SpendCash(player, cost, "research_" .. id)
	if not spent then
		return false, spendErr or "SpendFailed"
	end
	-- 9: write
	research[id] = target
	local ds = getDataService()
	if ds and ds.MarkDirty then
		pcall(ds.MarkDirty, player)
	end
	-- 10: live side effects
	if def.Stat == "SoldierHealth" or def.Stat == "SquadSize" then
		if SquadOrdersService and SquadOrdersService.ApplyResearch then
			local ok, err = pcall(SquadOrdersService.ApplyResearch, player)
			if not ok then
				warn("[ResearchService] SquadOrdersService.ApplyResearch failed:", err)
			end
		end
	elseif def.Stat == "WeaponMagazine" then
		if CombatService and CombatService.PushState then
			local ok, err = pcall(CombatService.PushState, player)
			if not ok then
				warn("[ResearchService] CombatService.PushState failed:", err)
			end
		end
	elseif def.Stat == "VehicleSpeed" or def.Stat == "VehicleArmor" then
		-- a vehicle that is already deployed picks up the new level (VehicleService hook for this workflow)
		if VehicleService and VehicleService.OnResearchChanged then
			local ok, err = pcall(VehicleService.OnResearchChanged, player)
			if not ok then
				warn("[ResearchService] VehicleService.OnResearchChanged failed:", err)
			end
		end
	end
	-- 11-13: feedback, analytics, state
	notify(
		player,
		string.format(
			"RESEARCH COMPLETE · %s %s — %s",
			def.DisplayName,
			roman(target),
			ResearchConfig.FormatEffect(def, target)
		),
		"Success",
		4
	)
	if AnalyticsService and AnalyticsService.Log then
		pcall(AnalyticsService.Log, "RESEARCH_PURCHASED", player.UserId, { upgrade = id, level = target, cost = cost })
	end
	ResearchService.Push(player)
	return true, nil
end

--[[ Player-facing refusal text (nil = stay silent). ]]
local function refusalText(player: Player, upgradeId: any, err: string?): string?
	local def = if typeof(upgradeId) == "string" then ResearchConfig.Upgrades[upgradeId] else nil
	if err == "NoProfile" then
		return "Your save is still loading — try again in a moment"
	end
	if def == nil or err == nil or err == "InvalidUpgrade" or err == "UnknownUpgrade" then
		return nil
	end
	local target = math.min(ResearchService.GetLevel(player, def.Id) + 1, def.MaxLevel)
	local name = string.format("%s %s", def.DisplayName, roman(target))
	if err == "InsufficientCash" or err == "CannotAfford" then
		local cost = def.Costs[target]
		return string.format("Not enough Cash — %s costs %s", name, ResearchConfig.FormatCash(tonumber(cost) or 0))
	elseif err == "LabLevelTooLow" then
		return string.format(
			"%s needs Research Lab L%d — upgrade the lab at its console",
			name,
			ResearchConfig.LabLevelFor(def, target)
		)
	elseif err == "TrackLocked" then
		local track = ResearchConfig.Tracks[def.Track]
		local req = if track then track.Requires else nil
		return if req then req.Text else "That research track is locked"
	elseif err == "Maxed" then
		return string.format("%s is fully researched", def.DisplayName)
	elseif err == "Disabled" then
		return string.format("%s — coming soon", def.DisplayName)
	end
	return string.format("Research failed: %s", tostring(err))
end

-- Init-time sanity: an upgrade with a malformed definition is switched off (card shows SOON) instead of
-- selling a broken level.
local function sanityCheck()
	local statSet: { [string]: boolean } = {}
	for _, s in ipairs(ResearchConfig.StatIds) do
		statSet[s] = true
	end
	for id, def in pairs(ResearchConfig.Upgrades) do
		local problem: string? = nil
		if def.Id ~= id then
			problem = "Id mismatch"
		elseif typeof(def.Costs) ~= "table" or #def.Costs ~= def.MaxLevel then
			problem = "#Costs ~= MaxLevel"
		elseif not statSet[def.Stat] then
			problem = "unknown Stat " .. tostring(def.Stat)
		elseif ResearchConfig.Tracks[def.Track] == nil then
			problem = "unknown Track " .. tostring(def.Track)
		elseif def.Kind ~= "Mult" and def.Kind ~= "Add" then
			problem = "unknown Kind " .. tostring(def.Kind)
		else
			local prev = 0
			for i = 1, def.MaxLevel do
				local c = def.Costs[i]
				if typeof(c) ~= "number" or c ~= c or c <= prev then
					problem = "costs not strictly increasing"
					break
				end
				prev = c
			end
		end
		if problem and def.Enabled then
			warn(string.format("[ResearchService] disabling %s: %s", id, problem))
			def.Enabled = false
		end
	end
end

function ResearchService.Init(deps: { [string]: any })
	DataService = deps.DataService or DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	BaseService = deps.BaseService
	CombatService = deps.CombatService
	SquadOrdersService = deps.SquadOrdersService
	VehicleService = deps.VehicleService
	AnalyticsService = deps.AnalyticsService

	sanityCheck()

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestResearch) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player, action: any, upgradeId: any)
		if action == "Buy" then
			if RateLimitService and not RateLimitService.Allow(player, "research_buy", ResearchConfig.BuyRate, ResearchConfig.BuyBurst) then
				if NotificationService and NotificationService.NotifyThrottled then
					pcall(
						NotificationService.NotifyThrottled,
						player,
						"Slow down — too many research taps",
						"Info",
						1.5,
						2,
						"research_tap"
					)
				end
				return
			end
			local ok, err = ResearchService.Purchase(player, upgradeId)
			if not ok then
				local msg = refusalText(player, upgradeId, err)
				if msg then
					notify(player, msg, "Warn")
				end
				-- a stale client re-syncs (no push without a loaded profile)
				ResearchService.Push(player)
			end
		elseif action == "Sync" then
			if RateLimitService and not RateLimitService.Allow(player, "research_sync", ResearchConfig.SyncRate, ResearchConfig.SyncBurst) then
				return
			end
			ResearchService.Push(player)
		end
		-- anything else: ignored silently
	end)

	if DataService and DataService.OnProfileLoaded then
		DataService.OnProfileLoaded(function(player: Player, _profile: any)
			ResearchService.Push(player)
			-- Re-push after client controllers bind (missed ResearchStateUpdate race)
			task.delay(1.5, function()
				if player.Parent then
					ResearchService.Push(player)
				end
			end)
		end)
	end

	if BaseService and BaseService.GetUpgradeChangedEvent then
		local ok, ev = pcall(BaseService.GetUpgradeChangedEvent)
		if ok and ev then
			ev.Event:Connect(function(userId: any, _plotId: any, structureId: any, _level: any)
				if typeof(structureId) ~= "string" or not WATCHED_STRUCTURES[structureId] then
					return
				end
				if typeof(userId) ~= "number" then
					return
				end
				local player = Players:GetPlayerByUserId(userId)
				if player then
					ResearchService.Push(player)
				end
			end)
		end
	end

	local nUpgrades, nTracks = 0, 0
	for _ in pairs(ResearchConfig.Upgrades) do
		nUpgrades += 1
	end
	for _ in pairs(ResearchConfig.Tracks) do
		nTracks += 1
	end
	print(string.format("[WAR EMPIRE] ResearchService ready (%d upgrades, %d tracks)", nUpgrades, nTracks))
end

return ResearchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="172">
          <Properties>
            <string name="Name">SeasonService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Season state — active season id, XP/Cash bonuses, persisted end override.
	DataStore WarEmpire_Season_v1 with Studio in-memory fallback.
	Bonuses applied via GetXPMult / GetCashMult; never client-granted.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SeasonConfig = require(Shared.Configs.SeasonConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local SeasonService = {}

local SEASON_STORE_NAME = "WarEmpire_Season_v1"
local STATE_KEY = "season_state_v1"

local DataService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil

local endedOverride = SeasonConfig.Ended == true
local endedUnix = 0
local endedReason = ""
local persisted = false
local seasonStore: DataStore? = nil
local dataStoreAvailable = false
local loaded = false

local function getStore(): DataStore?
	if seasonStore then
		return seasonStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(SEASON_STORE_NAME)
	end)
	if ok then
		seasonStore = result
		dataStoreAvailable = true
		return seasonStore
	end
	dataStoreAvailable = false
	warn("[SeasonService] DataStore unavailable — session-only season end state.", result)
	return nil
end

local function configWindowActive(): boolean
	local now = os.time()
	local startUnix = tonumber(SeasonConfig.StartUnix) or 0
	local endUnix = tonumber(SeasonConfig.EndUnix) or 0
	if startUnix > 0 and now < startUnix then
		return false
	end
	if endUnix > 0 and now > endUnix then
		return false
	end
	return SeasonConfig.Ended ~= true
end

local function isActive(): boolean
	if endedOverride then
		return false
	end
	return configWindowActive()
end

local function persistState()
	local store = getStore()
	if not store then
		persisted = false
		return
	end
	local payload = {
		SeasonId = SeasonConfig.CurrentSeasonId,
		EndedOverride = endedOverride,
		EndedUnix = endedUnix,
		EndedReason = endedReason,
	}
	local ok, err = pcall(function()
		store:SetAsync(STATE_KEY, payload)
	end)
	if not ok then
		warn("[SeasonService] persist failed:", err)
		persisted = false
		return
	end
	persisted = true
end

local function loadState()
	if loaded then
		return
	end
	loaded = true
	local store = getStore()
	if not store then
		return
	end
	local ok, data = pcall(function()
		return store:GetAsync(STATE_KEY)
	end)
	if not ok or typeof(data) ~= "table" then
		return
	end
	-- Only apply override if it matches current season id (new seasons reset)
	if data.SeasonId == SeasonConfig.CurrentSeasonId and data.EndedOverride == true then
		endedOverride = true
		endedUnix = tonumber(data.EndedUnix) or 0
		endedReason = tostring(data.EndedReason or "persisted")
		persisted = true
	elseif data.SeasonId ~= SeasonConfig.CurrentSeasonId then
		-- New season config: clear stale end flag in store
		endedOverride = SeasonConfig.Ended == true
		endedUnix = 0
		endedReason = ""
		persistState()
	end
end

local function buildPayload(): { [string]: any }
	local active = isActive()
	return {
		SeasonId = SeasonConfig.CurrentSeasonId,
		DisplayName = SeasonConfig.DisplayName,
		Active = active,
		Ended = not active,
		XPBonusMult = if active then (SeasonConfig.XPBonusMult or 1) else 1,
		CashBonusMult = if active then (SeasonConfig.CashBonusMult or 1) else 1,
		StartUnix = SeasonConfig.StartUnix,
		EndUnix = SeasonConfig.EndUnix,
		EndedUnix = endedUnix,
		Persisted = persisted or dataStoreAvailable,
	}
end

local function pushState(player: Player)
	local remote = RemoteSetup.Get(Constants.RemoteNames.SeasonStateUpdate) :: RemoteEvent
	remote:FireClient(player, buildPayload())
end

local function pushAll()
	for _, player in ipairs(Players:GetPlayers()) do
		pushState(player)
	end
end

function SeasonService.GetSeasonId(): string
	return SeasonConfig.CurrentSeasonId
end

function SeasonService.IsActive(): boolean
	return isActive()
end

function SeasonService.GetXPMult(): number
	if not isActive() then
		return 1
	end
	return tonumber(SeasonConfig.XPBonusMult) or 1
end

function SeasonService.GetCashMult(): number
	if not isActive() then
		return 1
	end
	return tonumber(SeasonConfig.CashBonusMult) or 1
end

--[[ End season for this place: clears bonuses, persists across servers when API services on. ]]
function SeasonService.EndSeason(reason: string?)
	if endedOverride and not isActive() then
		-- Already ended
		pushAll()
		return
	end
	endedOverride = true
	endedUnix = os.time()
	endedReason = reason or "manual"
	persistState()

	local eventName = if AnalyticsConfig.Events.SEASON_END then AnalyticsConfig.Events.SEASON_END else "SEASON_END"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, 0, {
			seasonId = SeasonConfig.CurrentSeasonId,
			reason = endedReason,
			persisted = persisted,
		})
	end
	if NotificationService then
		NotificationService.NotifyAll(
			string.format("Season ended: %s — bonuses cleared.", tostring(SeasonConfig.DisplayName)),
			"Info"
		)
	end
	pushAll()
end

--[[ Clear end override (admin / new season tooling). ]]
function SeasonService.ClearEndOverride(reason: string?)
	endedOverride = false
	endedUnix = 0
	endedReason = ""
	persistState()
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log("SEASON_RESUME", 0, {
			seasonId = SeasonConfig.CurrentSeasonId,
			reason = reason or "clear",
		})
	end
	if NotificationService then
		NotificationService.NotifyAll("Season resumed: " .. tostring(SeasonConfig.DisplayName), "Success")
	end
	pushAll()
end

function SeasonService.Push(player: Player)
	pushState(player)
end

function SeasonService.Init(deps: { [string]: any })
	DataService = deps.DataService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService

	loadState()

	-- Auto-end when config EndUnix has passed (persist once)
	if not endedOverride then
		local endUnix = tonumber(SeasonConfig.EndUnix) or 0
		if endUnix > 0 and os.time() > endUnix then
			SeasonService.EndSeason("end_unix")
		end
	end

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		pushState(player)
	end)

	-- Periodic check for scheduled end
	task.spawn(function()
		while true do
			task.wait(30)
			if not endedOverride then
				local endUnix = tonumber(SeasonConfig.EndUnix) or 0
				if endUnix > 0 and os.time() > endUnix then
					SeasonService.EndSeason("end_unix_tick")
				end
			end
		end
	end)
end

return SeasonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="173">
          <Properties>
            <string name="Name">SoldierService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Army recruitment — server-authoritative soldier counts.
	Spends Cash via EconomyService; never trusts client counts.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SoldierConfig = require(Shared.Configs.SoldierConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

local TRAIN_POP_RADIUS = 28 -- studs: the "+$N" training pop shows only to the owner standing this close (spec §5)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local SoldierService = {}

local armyChangedListeners: { (Player) -> () } = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil
local MissionService: any = nil
local TutorialService: any = nil

local MAX_BATCH = 50
-- Recruit/Dismiss tap limiter (per remote): 4/s sustained, 8 burst — above human tap speed for a
-- short burst; extra taps are dropped with a throttled toast (no AntiExploit strike).
local TAP_RATE = 4
local TAP_BURST = 8

local function slowDownToast(player: Player, what: string)
	if not NotificationService then
		return
	end
	local msg = "Slow down — too many " .. what .. " taps, try again in a moment"
	if NotificationService.NotifyThrottled then
		NotificationService.NotifyThrottled(player, msg, "Info", 1.5, 2, "soldier_tap_" .. what)
	end
end

-- Training $ per tick BEFORE multipliers. B1 (owner's 11 features, lane E): prestige is applied once, by
-- EconomyService.AccruePendingCash (reason "training", +10 % per prestige), not here as well (was x1.05 more each).
local function trainingIncomePerTick(profile: any): number
	local cfg = SoldierConfig.TrainingIncome
	if not cfg then
		return 0
	end
	local count = tonumber(profile.Soldiers) or 0
	local minN = cfg.MinSoldiersForIncome or 1
	if count < minN then
		return 0
	end
	local per = cfg.CashPerSoldierPerTick or 0
	return math.floor(count * per)
end


local function barracksLevel(profile: any): number
	local upgrades = profile.BaseUpgrades
	if typeof(upgrades) ~= "table" then
		return 0
	end
	return tonumber(upgrades.Barracks) or 0
end

--[[ v71 money (M1, owner decision D3): Army Expansion. The live ExtraSoldierSlot product (same Id) now adds
	MonetizationConfig.DevProducts.ExtraSoldierSlot.ArmyCapBonus (10) army capacity instead of +1. It reads the
	entitlement exactly as MonetizationService records it (ProcessReceipt → GrantEntitlement("ExtraSoldierSlot")
	→ profile.Entitlements.ExtraSoldierSlot = true; admin grants use the same key), so it is retroactive: players
	who bought the old +1 slot get +10 on their next state push. A one-time boolean — owning it never stacks. ]]
local ARMY_EXPANSION_DEFAULT_BONUS = 10

local function armyCapBonus(profile: any): number
	if typeof(profile.Entitlements) ~= "table" or profile.Entitlements.ExtraSoldierSlot ~= true then
		return 0
	end
	local def: any = MonetizationConfig.DevProducts.ExtraSoldierSlot
	local bonus = if typeof(def) == "table" then tonumber(def.ArmyCapBonus) else nil
	return math.max(0, math.floor(bonus or ARMY_EXPANSION_DEFAULT_BONUS))
end

local function maxSoldiers(profile: any): number
	local base = SoldierConfig.MaxSoldiersBase or 50
	local per = SoldierConfig.SoldiersPerBarracksLevel or 5
	-- + Army Expansion (ExtraSoldierSlot DevProduct entitlement): ArmyCapBonus capacity
	return base + barracksLevel(profile) * per + armyCapBonus(profile)
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local count = tonumber(profile.Soldiers) or 0
	local cap = maxSoldiers(profile)
	local cost = SoldierConfig.RecruitCostCash or 500
	local room = math.max(0, cap - count)
	local remote = RemoteSetup.Get(Constants.RemoteNames.SoldierStateUpdate) :: RemoteEvent
	local training = trainingIncomePerTick(profile)
	local tickSec = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.TickSeconds) or 5
	remote:FireClient(player, {
		Soldiers = count,
		MaxSoldiers = cap,
		BarracksLevel = barracksLevel(profile),
		RecruitCostCash = cost,
		RecruitBatchSize = SoldierConfig.RecruitBatchSize or 1,
		DismissRefundMult = SoldierConfig.DismissRefundMult or 0.25,
		SlotsFree = room,
		FillCost = cost * room,
		TrainingIncomePerTick = training,
		TrainingTickSeconds = tickSec,
		TrainingIncomePerSec = if tickSec > 0 then training / tickSec else 0,
		-- v71 money (M1): > 0 when Army Expansion is owned (already inside MaxSoldiers); the Army panel shows OWNED
		ArmyCapBonus = armyCapBonus(profile),
	})
	for _, cb in ipairs(armyChangedListeners) do
		task.defer(cb, player)
	end
end

function SoldierService.GetCount(player: Player): number
	local profile = DataService.GetProfile(player)
	if not profile then
		return 0
	end
	return tonumber(profile.Soldiers) or 0
end

-- v72: the army cap Recruit enforces (base + Barracks levels + Army Expansion). BusinessService's next-buy pick
-- offers soldiers only below it. 0 without a profile.
function SoldierService.GetCap(player: Player): number
	local profile = if DataService then DataService.GetProfile(player) else nil
	if not profile then
		return 0
	end
	return maxSoldiers(profile)
end

local function sanitizeAmount(amount: any): (number?, string?)
	local n = RemoteGuard.ClampPositiveInt(amount, MAX_BATCH)
	if not n then
		return nil, "InvalidAmount"
	end
	return n, nil
end

function SoldierService.Recruit(player: Player, amount: any): (boolean, string?)
	local n, serr = sanitizeAmount(amount)
	if not n then
		return false, serr
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local current = tonumber(profile.Soldiers) or 0
	local cap = maxSoldiers(profile)
	if current >= cap then
		return false, "AtCap"
	end
	if current + n > cap then
		n = cap - current -- clamp to remaining slots
	end
	local costEach = SoldierConfig.RecruitCostCash or 500
	local total = costEach * n
	local ok, err = EconomyService.SpendCash(player, total, "recruit_soldiers")
	if not ok then
		return false, err or "CannotAfford"
	end
	profile.Soldiers = current + n
	DataService.MarkDirty(player)
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "RecruitSoldiers", n)
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "RecruitSoldiers", n)
	end
	pushState(player)
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format("Recruited %d · Army %d/%d (−$%d)", n, profile.Soldiers, cap, total),
			"Success"
		)
	end
	local eventName = if AnalyticsConfig.Events.SOLDIER_RECRUIT then AnalyticsConfig.Events.SOLDIER_RECRUIT else "SOLDIER_RECRUIT"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, { amount = n, cost = total, total = profile.Soldiers })
	end
	return true, nil
end

function SoldierService.Dismiss(player: Player, amount: any): (boolean, string?)
	local n, serr = sanitizeAmount(amount)
	if not n then
		return false, serr
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local current = tonumber(profile.Soldiers) or 0
	if n > current then
		return false, "NotEnoughSoldiers"
	end
	profile.Soldiers = current - n
	local refund = math.floor((SoldierConfig.RecruitCostCash or 500) * n * (SoldierConfig.DismissRefundMult or 0.25))
	if refund > 0 then
		EconomyService.AddCash(player, refund, "dismiss_soldiers")
	end
	DataService.MarkDirty(player)
	pushState(player)
	if NotificationService then
		NotificationService.Notify(
			player,
			string.format("Dismissed %d · Army %d (−refund $%d)", n, profile.Soldiers, refund),
			"Info"
		)
	end
	local eventName = if AnalyticsConfig.Events.SOLDIER_DISMISS then AnalyticsConfig.Events.SOLDIER_DISMISS else "SOLDIER_DISMISS"
	if AnalyticsService and AnalyticsService.Log then
		AnalyticsService.Log(eventName, player.UserId, { amount = n, refund = refund })
	end
	return true, nil
end

function SoldierService.Push(player: Player)
	pushState(player)
end

function SoldierService.OnArmyChanged(cb: (Player) -> ())
	table.insert(armyChangedListeners, cb)
end


local function refreshTrainingYardFeedback(player: Player, profile: any, tickAmount: number)
	local plotId = profile.BasePlotId
	if typeof(plotId) ~= "number" then
		return
	end
	local setup = game:GetService("Workspace"):FindFirstChild("WarEmpireSetup")
	if not setup then
		return
	end
	local bases = setup:FindFirstChild("Bases")
	if not bases then
		return
	end
	local plotFolder = bases:FindFirstChild("Plot" .. tostring(plotId))
	if not plotFolder then
		return
	end
	local yard = plotFolder:FindFirstChild("TrainingYard")
	if not yard then
		return
	end
	local anchor = yard:FindFirstChild("YardPad")
		or yard:FindFirstChild("YardEarnAnchor")
		or yard:FindFirstChild("YardAnchor")
	if not anchor or not anchor:IsA("BasePart") then
		return
	end
	-- v71 (spec §5): no "+$/tick" earn board over the yard (the old one also looked for a label named "Amount"
	-- that MapSetup's board never had, so it never updated). One owner-only "+$N" pop per tick, and only while
	-- the owner stands near the yard — nobody else sees it and nothing is made for an empty yard.
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) or (hrp.Position - anchor.Position).Magnitude > TRAIN_POP_RADIUS then
		return
	end
	local pop = WorldLabel.Create(anchor, string.format("+$%d", tickAmount), {
		Name = "WE_TrainCashPop",
		Color = Color3.fromRGB(100, 255, 140),
		TextSize = 18,
		Studs = Vector2.new(3, 1.2),
		Offset = Vector3.new(0, 3.5, 0),
		MaxDistance = TRAIN_POP_RADIUS,
		OwnerUserId = player.UserId,
	})
	local popLab = pop:FindFirstChild("Title")
	task.spawn(function()
		for i = 1, 6 do
			pop.StudsOffsetWorldSpace = Vector3.new(0, 3.5 + i * 0.4, 0)
			if popLab and popLab:IsA("TextLabel") then
				popLab.TextTransparency = i / 7
			end
			task.wait(0.1)
		end
		pop:Destroy()
	end)
end

function SoldierService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService

	local recruitRemote = RemoteSetup.Get(Constants.RemoteNames.RequestRecruitSoldiers) :: RemoteEvent
	recruitRemote.OnServerEvent:Connect(function(player: Player, amount: any)
		-- v69: fast taps are normal play — drop extras with a throttled toast, never an AntiExploit strike
		if not RateLimitService.Allow(player, "soldier_recruit", TAP_RATE, TAP_BURST) then
			slowDownToast(player, "recruit")
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SoldierService.Recruit(player, amount)
		if not ok and NotificationService then
			local msg = "Recruit failed: " .. tostring(err)
			if err == "AtCap" then
				msg = "Army at capacity — upgrade Barracks"
			elseif err == "InsufficientCash" or err == "CannotAfford" then
				msg = "Not enough cash to recruit"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	local dismissRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDismissSoldiers) :: RemoteEvent
	dismissRemote.OnServerEvent:Connect(function(player: Player, amount: any)
		if not RateLimitService.Allow(player, "soldier_dismiss", TAP_RATE, TAP_BURST) then
			slowDownToast(player, "dismiss")
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SoldierService.Dismiss(player, amount)
		if not ok and NotificationService then
			NotificationService.Notify(player, "Dismiss failed: " .. tostring(err), "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.Soldiers) ~= "number" then
			profile.Soldiers = SoldierConfig.StartingSoldiers or 5
			DataService.MarkDirty(player)
		end
		pushState(player)
		-- Re-push after client controllers connect (missed SoldierStateUpdate race)
		task.delay(1.5, function()
			if player.Parent then
				pushState(player)
			end
		end)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				if player.Parent then
					pushState(player)
				end
			end)
		end)
	end)

	-- Training Yard worker income (MT-inspired)
	task.spawn(function()
		local Players = game:GetService("Players")
		while true do
			local tickSec = (SoldierConfig.TrainingIncome and SoldierConfig.TrainingIncome.TickSeconds) or 5
			task.wait(tickSec)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataService.GetProfile(player)
				if profile then
					local amount = trainingIncomePerTick(profile)
					if amount > 0 then
						-- AFK training → PendingCash (Money Collector / AutoCollect). Not AddCash bypass.
						if EconomyService.AccruePendingCash then
							EconomyService.AccruePendingCash(player, amount, "training")
						else
							EconomyService.AddCash(player, amount, "training")
						end
						-- F4: with EconomyConfig.ProducerLabels on, the client's owner-only yard label (WE_TickTraining)
						-- replaces this server pop, so the server makes no BillboardGui per tick
						if not EconomyConfig.ProducerLabels.Enabled then
							refreshTrainingYardFeedback(player, profile, amount)
						end
					end
				end
			end
		end
	end)
end

return SoldierService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="174">
          <Properties>
            <string name="Name">SpinnerService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Free Supply Spinner — claim Cash/Gold every CooldownSeconds (HUD / Settings).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local SpinnerConfig = require(Shared.Configs.SpinnerConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local SpinnerService = {}

local DataService: any = nil
local EconomyService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AnalyticsService: any = nil

local function pickReward(): any
	local rewards = SpinnerConfig.Rewards
	local total = 0
	for _, r in ipairs(rewards) do
		total += math.max(0, tonumber(r.Weight) or 0)
	end
	if total <= 0 then
		return rewards[1]
	end
	local roll = math.random() * total
	local acc = 0
	for _, r in ipairs(rewards) do
		acc += math.max(0, tonumber(r.Weight) or 0)
		if roll <= acc then
			return r
		end
	end
	return rewards[#rewards]
end

local function remainingSeconds(profile: any): number
	local last = tonumber(profile.LastSpinnerClaimUnix) or 0
	local cd = SpinnerConfig.CooldownSeconds or (4 * 3600)
	local readyAt = last + cd
	return math.max(0, readyAt - os.time())
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local rem = remainingSeconds(profile)
	local remote = RemoteSetup.Get(Constants.RemoteNames.SpinnerStateUpdate) :: RemoteEvent
	remote:FireClient(player, {
		Ready = rem <= 0,
		CooldownRemaining = rem,
		CooldownSeconds = SpinnerConfig.CooldownSeconds,
		DisplayName = SpinnerConfig.DisplayName or "Supply Spinner",
	})
end

function SpinnerService.Claim(player: Player): (boolean, string?)
	if not SpinnerConfig.Enabled then
		return false, "Disabled"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	local rem = remainingSeconds(profile)
	if rem > 0 then
		return false, "Cooldown"
	end

	local reward = pickReward()
	local cash = tonumber(reward.Cash) or 0
	local gold = tonumber(reward.Gold) or 0
	profile.LastSpinnerClaimUnix = os.time()
	DataService.MarkDirty(player)

	if cash > 0 then
		EconomyService.AddCash(player, cash, "spinner")
	end
	if gold > 0 then
		EconomyService.AddGold(player, gold, "spinner")
	end

	if NotificationService then
		local name = reward.DisplayName or "Supply"
		NotificationService.Notify(
			player,
			string.format("%s: +$%d · +%d Gold", name, cash, gold),
			"Reward"
		)
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.SPINNER_CLAIM, player.UserId, {
			rewardId = reward.Id,
			cash = cash,
			gold = gold,
		})
	end
	pushState(player)
	return true, nil
end

function SpinnerService.Push(player: Player)
	pushState(player)
end

function SpinnerService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AnalyticsService = deps.AnalyticsService

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestClaimSpinner) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player)
		-- v69: extra taps are dropped silently (the allowed tap already answered) — never a strike
		if not RateLimitService.Allow(player, "spinner_claim", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SpinnerService.Claim(player)
		if not ok and NotificationService then
			if err == "Cooldown" then
				local profile = DataService.GetProfile(player)
				local rem = if profile then remainingSeconds(profile) else 0
				local mins = math.ceil(rem / 60)
				NotificationService.Notify(player, string.format("Spinner ready in %dm", mins), "Warn")
			else
				NotificationService.Notify(player, "Spinner unavailable", "Warn")
			end
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		if typeof(profile.LastSpinnerClaimUnix) ~= "number" then
			profile.LastSpinnerClaimUnix = 0
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)
end

return SpinnerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="175">
          <Properties>
            <string name="Name">SquadOrdersService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Squad Orders — server-authoritative Follow / Attack / Hold / Retreat.
	Extends SoldierService counts + Combat MoveTo patterns. Not a second army economy.
	P1-4 (mobile plan): Follow is an escort — units shoot hostiles within CombatFairnessConfig.EscortEngageRadius of
	their player (line of sight required) while staying within EscortLeash of the player. Every unit hit tags the
	owner as creator (CombatDamage.TagCreator, unit flag), so squad kills credit the owner at UnitKillCashShare.
	v71 (HUD v70 spec §4.2 / §5): no per-unit "SQUAD" tags and no "Squad: X" toast per order — the order flashes
	for OrderBillboardSeconds as one owner-only stud-scaled WorldLabel over the nearest unit (flashOrderBillboard),
	and the Army popover shows the active order.
	Base identity lane C: Follow slots come from OrdersConfig.FollowSlots, two wings beside the player instead of rows
	straight behind (the old grid stood between the third-person camera and the player). A unit whose straight walk to
	its slot is blocked (door, narrow lane, stairs) walks the player's own trail (OrdersConfig.FollowPath) and fans back
	out once its slot is in sight. Helmets are domes (SpecialMesh Sphere on the same part: 0 extra parts).
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local OrdersConfig = require(Shared.Configs.OrdersConfig)
local CombatFairnessConfig = require(Shared.Configs.CombatFairnessConfig) -- P1-4 escort + kill credit
local WorldLabel = require(Shared.Util.WorldLabel)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)
local CombatDamage = require(script.Parent.CombatService.CombatDamage) -- creator tags + line of sight

local SquadOrdersService = {}

local DataService: any = nil
local SoldierService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil
local AntiExploitService: any = nil
local VisualAssetService: any = nil
local BaseService: any = nil
local ResearchService: any = nil -- v69 research (deps.ResearchService)
local CombatService: any = nil -- F6 novice shield: an accepted order ends it (deps.CombatService; pcall'd)

export type OrderId = "Follow" | "Attack" | "Hold" | "Retreat"

type SquadUnit = {
	Id: string,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	OwnerUserId: number,
	Slot: number,
	LastFireAt: number,
	HoldPos: Vector3?,
	Alive: boolean,
	Crumb: number?, -- FollowPath: serial of the trail point this unit walks to while its slot is blocked
	CrumbScanAt: number, -- FollowPath: no full trail scan before this (a scan found nothing in sight)
	CrumbCheckAt: number, -- FollowPath: next check that the trail point is still in sight
}

-- FollowPath: the player's recent positions (newest last) with serials, so a unit keeps its place in the trail
type Trail = {
	Points: { Vector3 },
	Ids: { number },
	Serial: number,
}

type SquadState = {
	Order: OrderId,
	Units: { SquadUnit },
	DesiredCount: number,
	Mirror: boolean, -- lane C: wings swapped left <-> right (the player turned round; nobody crosses behind them)
}

local VALID: { [string]: boolean } = {
	Follow = true,
	Attack = true,
	Hold = true,
	Retreat = true,
}

local TAG_SQUAD = "WE_SquadUnit"
local squadByUser: { [number]: SquadState } = {}
local trailByUser: { [number]: Trail } = {}
local unitSerial = 0
local squadFolder: Folder? = nil

local function ensureFolder(): Folder
	if squadFolder and squadFolder.Parent then
		return squadFolder :: Folder
	end
	local existing = Workspace:FindFirstChild("WarEmpireSquads")
	if existing and existing:IsA("Folder") then
		squadFolder = existing
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "WarEmpireSquads"
	f.Parent = Workspace
	squadFolder = f
	return f
end

local function researchMult(player: Player?, statId: string): number -- v69 research: ≥1, 1 when absent
	if player == nil or ResearchService == nil or ResearchService.GetBonus == nil then
		return 1
	end
	local ok, m = pcall(ResearchService.GetBonus, player, statId)
	if ok and typeof(m) == "number" and m == m and m >= 1 and m <= 5 then
		return m
	end
	return 1
end

local function researchAdd(player: Player?, statId: string): number -- v69 research: 0..10, 0 when absent
	if player == nil or ResearchService == nil or ResearchService.GetAdd == nil then
		return 0
	end
	local ok, a = pcall(ResearchService.GetAdd, player, statId)
	if ok and typeof(a) == "number" and a == a and a >= 0 and a <= 10 then
		return a
	end
	return 0
end

local function characterRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if hum and root and root:IsA("BasePart") and hum.Health > 0 then
		return root
	end
	return nil
end

local function plotRetreatCFrame(player: Player): CFrame?
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	local plotId = tonumber(profile.BasePlotId)
	if not plotId then
		return nil
	end
	if BaseService and BaseService.GetPlotSpawnCFrame then
		return BaseService.GetPlotSpawnCFrame(plotId)
	end
	return nil
end

local function pushState(player: Player)
	if not RemoteSetup then
		return
	end
	local st = squadByUser[player.UserId]
	local remote = RemoteSetup.Get(Constants.RemoteNames.SquadOrderStateUpdate) :: RemoteEvent
	local soldiers = if SoldierService then SoldierService.GetCount(player) else 0
	local alive = 0
	if st then
		for _, u in ipairs(st.Units) do
			if u.Alive then
				alive += 1
			end
		end
	end
	local show = OrdersConfig.Enabled == true and soldiers >= (OrdersConfig.MinSoldiersToShow or 1)
	remote:FireClient(player, {
		Enabled = OrdersConfig.Enabled == true,
		Order = if st then st.Order else (OrdersConfig.DefaultOrder or "Follow"),
		Soldiers = soldiers,
		FieldUnits = alive,
		MaxFieldUnits = (OrdersConfig.MaxFieldUnits or 5) + math.floor(researchAdd(player, "SquadSize")), -- v69 research
		ShowPanel = show,
	})
end

local function destroyUnit(unit: SquadUnit)
	unit.Alive = false
	if unit.Model and unit.Model.Parent then
		unit.Model:Destroy()
	end
end

local function clearSquad(userId: number)
	local st = squadByUser[userId]
	if not st then
		return
	end
	for _, u in ipairs(st.Units) do
		destroyUnit(u)
	end
	st.Units = {}
	st.DesiredCount = 0
end

local function flatDist(a: Vector3, b: Vector3): number
	local d = a - b
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

-- The old 3-wide grid, 6 / 9.5 / 13 studs straight behind the player (player-local: +X right, +Z behind)
local function gridOffset(slot: number): Vector3
	local spacing = OrdersConfig.FormationSpacing or 3.5
	local row = math.ceil(slot / 3)
	local col = ((slot - 1) % 3) - 1
	return Vector3.new(col * spacing, 0, 6 + (row - 1) * spacing)
end

local function followSlotList(): { any }?
	local slots = (OrdersConfig :: any).FollowSlots
	if typeof(slots) == "table" and #slots > 0 then
		return slots
	end
	return nil
end

-- Base identity lane C: slot n of OrdersConfig.FollowSlots (player-local studs: +X right, +Z BEHIND the player).
-- Slot #list+1.. (Squad Expansion research) repeats the list FollowRankStepZ further back per rank; an empty list
-- or a malformed entry falls back to the old grid.
local function formationOffset(slot: number): Vector3
	local slots = followSlotList()
	if slots then
		local n = #slots
		local s = slots[((slot - 1) % n) + 1]
		if typeof(s) == "table" and typeof(s.X) == "number" and typeof(s.Z) == "number" then
			local rank = math.floor((slot - 1) / n)
			local step = tonumber((OrdersConfig :: any).FollowRankStepZ) or 3.5
			return Vector3.new(s.X, 0, s.Z + rank * step)
		end
	end
	return gridOffset(slot)
end

-- The squad's current offset for a slot: FollowSlots mirrored left <-> right while st.Mirror is set
local function unitOffset(st: SquadState, slot: number): Vector3
	local off = formationOffset(slot)
	if st.Mirror then
		return Vector3.new(-off.X, off.Y, off.Z)
	end
	return off
end

-- Once per think pass (Follow): after the player turns round, the left wing is on the player's right. Swap the wings
-- when that is clearly shorter for the squad as a whole (FollowMirrorHysteresis studs per unit), so units walk to the
-- nearer side instead of all crossing behind the player. Distances only, no rays.
local function updateMirror(st: SquadState, playerCf: CFrame)
	if followSlotList() == nil then
		st.Mirror = false
		return
	end
	local keep, swap, n = 0, 0, 0
	for _, u in ipairs(st.Units) do
		if u.Alive and u.Root.Parent then
			local off = unitOffset(st, u.Slot)
			local at = u.Root.Position
			keep += flatDist(at, (playerCf * CFrame.new(off.X, 0, off.Z)).Position)
			swap += flatDist(at, (playerCf * CFrame.new(-off.X, 0, off.Z)).Position)
			n += 1
		end
	end
	if n > 0 and swap < keep - (tonumber((OrdersConfig :: any).FollowMirrorHysteresis) or 3) * n then
		st.Mirror = not st.Mirror
	end
end

-- ── FollowPath: walk the player's trail while the straight line to the slot is blocked ─────────────────────────
local function followPathCfg(): { [string]: any }?
	local cfg = (OrdersConfig :: any).FollowPath
	if typeof(cfg) == "table" and cfg.Enabled == true then
		return cfg
	end
	return nil
end

local function cfgNum(cfg: { [string]: any }, key: string, default: number): number
	local v = cfg[key]
	if typeof(v) == "number" and v == v then
		return v
	end
	return default
end

-- One trail point every CrumbSpacing studs the player moves on the ground (not mid-jump); a jump over ResetJump
-- (respawn, recall, fast vehicle) starts a new trail. Called once per think pass per player with a squad.
local function recordTrail(player: Player, root: BasePart, cfg: { [string]: any }): Trail
	local trail = trailByUser[player.UserId]
	if trail == nil then
		trail = { Points = {}, Ids = {}, Serial = 0 }
		trailByUser[player.UserId] = trail
	end
	local t = trail :: Trail
	local character = player.Character
	local hum = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if hum and hum.FloorMaterial == Enum.Material.Air then
		return t
	end
	local pos = root.Position
	local n = #t.Points
	if n > 0 then
		local d = (t.Points[n] - pos).Magnitude
		if d > cfgNum(cfg, "ResetJump", 40) then
			table.clear(t.Points)
			table.clear(t.Ids)
		elseif d < cfgNum(cfg, "CrumbSpacing", 3) then
			return t
		end
	end
	t.Serial += 1
	table.insert(t.Points, pos)
	table.insert(t.Ids, t.Serial)
	local maxN = math.max(2, math.floor(cfgNum(cfg, "MaxCrumbs", 12)))
	while #t.Points > maxN do
		table.remove(t.Points, 1)
		table.remove(t.Ids, 1)
	end
	return t
end

-- FollowPath probe: one RaycastParams per think pass (squads and every character ignored; only CanCollide geometry
-- blocks, a unit walks through the rest) + the ray height and the unit's half width from the config
type Probe = {
	Params: RaycastParams,
	Drop: number,
	Half: number,
}

local function buildProbe(cfg: { [string]: any }): Probe
	local ignore: { Instance } = { ensureFolder() }
	for _, p in ipairs(Players:GetPlayers()) do
		local character = p.Character
		if character then
			table.insert(ignore, character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	return { Params = params, Drop = cfgNum(cfg, "RayDrop", 1), Half = cfgNum(cfg, "RayHalfWidth", 0.9) }
end

-- Can a unit's body walk the straight line between two root positions and stand at the end? Two knee-to-waist rays
-- (RayDrop below the roots, so kerbs and pads never block) along its left and right edges (RayHalfWidth), each
-- RayHalfWidth past the end: a wall end that would catch a shoulder blocks, and so does a spot inside a wall.
local function bodyClear(from: Vector3, to: Vector3, probe: Probe): boolean
	local dir = to - from
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 0.5 then
		return true
	end
	local unitDir = flat.Unit
	local side = Vector3.new(-unitDir.Z, 0, unitDir.X) * probe.Half
	local reach = dir + unitDir * probe.Half
	local start = from - Vector3.new(0, probe.Drop, 0)
	return Workspace:Raycast(start + side, reach, probe.Params) == nil and Workspace:Raycast(start - side, reach, probe.Params) == nil
end

-- A slot inside, behind or too close to a wall beside the player (walking along a building, a wide lane): the spot
-- against that wall at the slot's own depth, WallGap short of it, when that still leaves MinSide studs between the
-- unit and the player's centre line. One lateral ray from the centre line, RayHalfWidth past the slot (the unit's
-- far shoulder). nil when the slot has room (something else cuts the unit off) or there is no room beside the player.
local function wallHugPoint(playerCf: CFrame, offset: Vector3, probe: Probe, cfg: { [string]: any }): Vector3?
	local ax = math.abs(offset.X)
	if ax < 0.5 then
		return nil
	end
	local origin = (playerCf * CFrame.new(0, 0, offset.Z)).Position - Vector3.new(0, probe.Drop, 0)
	local side = playerCf.RightVector * (if offset.X < 0 then -1 else 1)
	local hit = Workspace:Raycast(origin, side * (ax + probe.Half), probe.Params)
	if hit == nil then
		return nil
	end
	local x = math.min(ax, (hit.Position - origin).Magnitude - cfgNum(cfg, "WallGap", 1.5))
	if x < cfgNum(cfg, "MinSide", 3) then
		return nil
	end
	return (playerCf * CFrame.new(if offset.X < 0 then -x else x, 0, offset.Z)).Position
end

--[[ Where a Follow unit walks this think:
	1. its slot, when the unit is there or its body can walk straight to it;
	2. against the wall beside the player (wallHugPoint), when the slot is inside or behind that wall;
	2b. the slot squeezed SqueezeStuds nearer the player, when the slot is open but something is in the unit's way;
	3. the player's trail: the point it already walks to (the next one once within ReachStuds or once the next point
	   is walkable; at most 2 steps a think), or, with no place in the trail yet, the newest walkable point. Points
	   within StopGap of the player are skipped, so a cut-off unit stops behind the player instead of walking into
	   them. Every RescanSeconds it re-checks its point (it may have been pushed). Nothing walkable → the slot, as
	   before, and no new full scan for RescanSeconds.
	Rays per unit per think: 0 in its slot, 2 on the way to a slot it can reach, 5 against a wall or squeezed in,
	5-11 on the trail, up to 2 x MaxCrumbs more on a scan. ]]
local function followGoal(unit: SquadUnit, playerCf: CFrame, offset: Vector3, slotPos: Vector3, trail: Trail?, probe: Probe?, cfg: { [string]: any }?, now: number): Vector3
	if trail == nil or probe == nil or cfg == nil then
		unit.Crumb = nil
		return slotPos
	end
	local from = unit.Root.Position
	if flatDist(from, slotPos) <= (OrdersConfig.FollowArriveStuds or 2) or bodyClear(from, slotPos, probe) then
		unit.Crumb = nil
		return slotPos
	end
	local hug = wallHugPoint(playerCf, offset, probe, cfg)
	if hug and (flatDist(from, hug) <= (OrdersConfig.FollowArriveStuds or 2) or bodyClear(from, hug, probe)) then
		unit.Crumb = nil
		return hug
	end
	-- the slot is in the open but a wall end or a crate is in the unit's way: the same depth, SqueezeStuds nearer
	-- the player's centre line (never within MinSide of it)
	local minSide = cfgNum(cfg, "MinSide", 3)
	if hug == nil and math.abs(offset.X) > minSide then
		local x = math.max(minSide, math.abs(offset.X) - cfgNum(cfg, "SqueezeStuds", 2))
		local squeezed = (playerCf * CFrame.new(if offset.X < 0 then -x else x, 0, offset.Z)).Position
		if bodyClear(from, squeezed, probe) then
			unit.Crumb = nil
			return squeezed
		end
	end
	local pts, ids = trail.Points, trail.Ids
	local playerPos = playerCf.Position
	local gap = cfgNum(cfg, "StopGap", 4)
	local rescan = cfgNum(cfg, "RescanSeconds", 2)
	local last = #pts
	while last > 0 and flatDist(pts[last], playerPos) < gap do
		last -= 1
	end
	if last == 0 then
		unit.Crumb = nil
		return hug or slotPos
	end
	local idx: number? = nil
	local want = unit.Crumb
	if want then
		for i = 1, last do
			if ids[i] == want then
				idx = i
				break
			end
		end
	end
	local lost = want ~= nil and idx == nil -- evicted, or now within StopGap of the player: pick up the trail again
	if idx and now >= unit.CrumbCheckAt then
		unit.CrumbCheckAt = now + rescan
		if not bodyClear(from, pts[idx :: number], probe) then
			idx = nil
			lost = true
		end
	end
	if idx == nil then
		if not lost and now < unit.CrumbScanAt then
			return hug or slotPos
		end
		for i = last, 1, -1 do
			if bodyClear(from, pts[i], probe) then
				idx = i
				break
			end
		end
		if idx == nil then
			unit.Crumb = nil
			unit.CrumbScanAt = now + rescan
			return hug or slotPos
		end
		unit.CrumbCheckAt = now + rescan
	else
		local reach = cfgNum(cfg, "ReachStuds", 2.5)
		for _ = 1, 2 do
			local i = idx :: number
			if i >= last then
				break
			end
			if flatDist(pts[i], from) <= reach or bodyClear(from, pts[i + 1], probe) then
				idx = i + 1
			else
				break
			end
		end
	end
	local k = idx :: number
	unit.Crumb = ids[k]
	return pts[k]
end

local function spawnUnit(owner: Player, slot: number, at: CFrame): SquadUnit?
	unitSerial += 1
	local id = string.format("squad_%d_%d", owner.UserId, unitSerial)

	local model = Instance.new("Model")
	-- streaming2 S4 (F10): a squad soldier (root, welded kit, Humanoid, catalog visual) reaches a client whole or not at
	-- all. Set before the model is parented (it is filled first, parented below). No effect with streaming off.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = (OrdersConfig.DisplayName or "Squad") .. tostring(slot)
	model:SetAttribute("SquadUnitId", id)
	model:SetAttribute("OwnerUserId", owner.UserId)
	model:SetAttribute("SquadSlot", slot)
	model:SetAttribute("FriendlySquad", true)

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.CFrame = at
	root.Anchored = false
	root.CanCollide = true
	root.Color = OrdersConfig.UnitColor or Color3.fromRGB(70, 90, 55)
	root.Material = Enum.Material.Fabric
	root.Parent = model

	local function weldPart(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = at * offset
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = root
		return p
	end

	local olive = OrdersConfig.UnitColor or Color3.fromRGB(70, 90, 55)
	local skin = Color3.fromRGB(190, 160, 120)
	local head = weldPart("Head", Vector3.new(1.05, 1.05, 1.05), CFrame.new(0, 1.55, 0), skin, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = head
	-- base identity lane C: a domed helmet (SpecialMesh Sphere on the same part: 0 extra parts), was a flat box cap
	local helmet = weldPart("Helmet", Vector3.new(1.3, 0.75, 1.35), CFrame.new(0, 1.91, 0.02), Color3.fromRGB(55, 70, 45), Enum.Material.Metal, nil)
	local dome = Instance.new("SpecialMesh")
	dome.MeshType = Enum.MeshType.Sphere
	dome.Parent = helmet
	weldPart("Vest", Vector3.new(2.1, 1.2, 1.15), CFrame.new(0, 0.15, 0), olive, Enum.Material.Fabric, nil)
	weldPart("LegL", Vector3.new(1, 2, 1), CFrame.new(-0.5, -2, 0), olive, Enum.Material.Fabric, nil)
	weldPart("LegR", Vector3.new(1, 2, 1), CFrame.new(0.5, -2, 0), olive, Enum.Material.Fabric, nil)
	weldPart("ArmL", Vector3.new(1, 2, 1), CFrame.new(-1.5, 0, 0), olive, Enum.Material.Fabric, nil)
	weldPart("ArmR", Vector3.new(1, 2, 1), CFrame.new(1.5, 0, 0), olive, Enum.Material.Fabric, nil)
	weldPart("Rifle", Vector3.new(0.26, 0.26, 2.4), CFrame.new(1.15, 0.15, -0.85), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil)

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = math.floor((OrdersConfig.UnitHealth or 90) * researchMult(owner, "SoldierHealth") + 0.5) -- v69 research
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = OrdersConfig.UnitWalkSpeed or 14
	humanoid.AutoRotate = true
	humanoid.HipHeight = 2
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameOcclusion = Enum.NameOcclusion.OccludeAll
	humanoid.Parent = model

	-- v68/v71: no floating "SQUAD" tag per soldier (a wall of labels over the squad — owner report; spec §5).
	-- OrdersConfig.ShowUnitLabels stays false; the order echo is flashOrderBillboard's one owner-only label.

	model.PrimaryPart = root
	if VisualAssetService and VisualAssetService.TryAttachCharacterVisual then
		pcall(function()
			VisualAssetService.TryAttachCharacterVisual(model, OrdersConfig.VisualKind or "Infantry")
		end)
	end
	-- Friendly only — do NOT tag WE_NPC (CombatNPC would aggro players)
	CollectionService:AddTag(model, TAG_SQUAD)
	model.Parent = ensureFolder()
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "NPCFaceGyro"
	gyro.MaxTorque = Vector3.new(0, 4e5, 0)
	gyro.P = 5000
	gyro.D = 500
	gyro.CFrame = at
	gyro.Parent = root

	local unit: SquadUnit = {
		Id = id,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		OwnerUserId = owner.UserId,
		Slot = slot,
		LastFireAt = 0,
		HoldPos = nil,
		Alive = true,
		Crumb = nil,
		CrumbScanAt = 0,
		CrumbCheckAt = 0,
	}

	humanoid.Died:Connect(function()
		if not unit.Alive then
			return
		end
		unit.Alive = false
		task.delay(0.35, function()
			if unit.Model and unit.Model.Parent then
				unit.Model:Destroy()
			end
		end)
		task.delay(8, function()
			local plr = Players:GetPlayerByUserId(owner.UserId)
			if plr then
				SquadOrdersService.SyncArmy(plr)
			end
		end)
	end)

	return unit
end

local function nearestHostile(fromPos: Vector3, maxRange: number): (Humanoid?, BasePart?, number)
	local bestHum: Humanoid? = nil
	local bestRoot: BasePart? = nil
	local bestDist = maxRange
	local npcTag = Constants.Tags.NPC
	for _, inst in ipairs(CollectionService:GetTagged(npcTag)) do
		if inst:IsA("Model") and not inst:GetAttribute("FriendlySquad") and not inst:GetAttribute("OwnerUserId") then
			local hum = inst:FindFirstChildOfClass("Humanoid")
			local root = inst:FindFirstChild("HumanoidRootPart")
			if hum and root and root:IsA("BasePart") and hum.Health > 0 then
				local d = (root.Position - fromPos).Magnitude
				if d < bestDist then
					bestDist = d
					bestHum = hum
					bestRoot = root
				end
			end
		end
	end
	return bestHum, bestRoot, bestDist
end

local function faceYaw(root: BasePart, lookAt: Vector3)
	local flat = Vector3.new(lookAt.X, root.Position.Y, lookAt.Z)
	if (flat - root.Position).Magnitude < 0.05 then
		return
	end
	local look = CFrame.lookAt(root.Position, flat)
	local gyro = root:FindFirstChild("NPCFaceGyro")
	if gyro and gyro:IsA("BodyGyro") then
		gyro.CFrame = look
	end
end

local function unitReady(unit: SquadUnit, now: number): boolean
	return now - unit.LastFireAt >= 1 / math.max(OrdersConfig.AttackFireRate or 1.8, 0.1)
end

-- One unit shot (Attack and escort). `credit`: the owner is tagged as creator first (unit flag), so a kill credits
-- the owner. Attack shots credit only with CombatFairnessConfig.UnitKillCreditOnAttack: Attack units roam without a
-- leash or line of sight, so an idle owner hidden near respawning NPCs would farm cash (verifier sim: bank guards).
local function unitShoot(player: Player, unit: SquadUnit, th: Humanoid, now: number, credit: boolean): boolean
	if not unitReady(unit, now) then
		return false
	end
	unit.LastFireAt = now
	if credit then
		CombatDamage.TagCreator(th, player, true)
	end
	th:TakeDamage((OrdersConfig.AttackDamage or 8) * researchMult(player, "SoldierDamage")) -- v69 research
	return true
end

-- Escort line of sight: the unit's squad, the owner and the target itself never block
local function escortHasLos(player: Player, unit: SquadUnit, troot: BasePart): boolean
	if not CombatFairnessConfig.EscortRequireLos then
		return true
	end
	local ignore: { Instance } = { unit.Model, ensureFolder() }
	local targetModel = troot.Parent
	if targetModel then
		table.insert(ignore, targetModel)
	end
	if player.Character then
		table.insert(ignore, player.Character :: Instance)
	end
	local eye = unit.Root.Position + Vector3.new(0, CombatFairnessConfig.NpcEyeHeight, 0)
	return CombatDamage.LineOfSight(eye, troot.Position, ignore, nil, CombatFairnessConfig.NpcLosRespectCanCollide)
end

--[[ P1-4 escort (order Follow): `th` / `troot` is the hostile nearest the PLAYER within EscortEngageRadius (picked
	once per think pass). The unit closes in only as far as the leash allows, drifts back when it is beyond the leash,
	and shoots when the hostile is within AttackRange with a clear line. Returns false when there is nothing to fight
	(the caller then runs the plain follow move). ]]
local function escortUnit(player: Player, st: SquadState, unit: SquadUnit, playerRoot: BasePart, th: Humanoid?, troot: BasePart?, now: number): boolean
	if th == nil or troot == nil or th.Health <= 0 or troot.Parent == nil then
		return false
	end
	local leash = CombatFairnessConfig.EscortLeash
	local range = OrdersConfig.AttackRange or 55
	local playerPos = playerRoot.Position
	local unitPos = unit.Root.Position
	local dist = (troot.Position - unitPos).Magnitude
	local fromPlayer = (unitPos - playerPos).Magnitude
	faceYaw(unit.Root, troot.Position)
	if fromPlayer > leash then
		-- back to the formation slot next to the player (still shooting on the way when possible)
		unit.Humanoid:MoveTo((playerRoot.CFrame * CFrame.new(unitOffset(st, unit.Slot))).Position)
	elseif dist > range * 0.85 then
		-- close in, but never past 90 % of the leash from the player
		local off = troot.Position - playerPos
		local maxOff = leash * 0.9
		local goal = if off.Magnitude > maxOff then playerPos + off.Unit * maxOff else troot.Position
		unit.Humanoid:MoveTo(goal)
	else
		unit.Humanoid:MoveTo(unitPos)
	end
	if dist <= range and unitReady(unit, now) and escortHasLos(player, unit, troot) then
		unitShoot(player, unit, th, now, true)
	end
	return true
end

local function thinkUnit(player: Player, st: SquadState, unit: SquadUnit, now: number, escortHum: Humanoid?, escortRoot: BasePart?, trail: Trail?, probe: Probe?)
	if not unit.Alive or unit.Humanoid.Health <= 0 or not unit.Root.Parent then
		return
	end
	local order = st.Order
	local playerRoot = characterRoot(player)

	if order == "Follow" then
		if not playerRoot then
			return
		end
		if escortUnit(player, st, unit, playerRoot, escortHum, escortRoot, now) then
			return
		end
		local offset = unitOffset(st, unit.Slot)
		local slotPos = (playerRoot.CFrame * CFrame.new(offset)).Position
		local target = followGoal(unit, playerRoot.CFrame, offset, slotPos, trail, probe, followPathCfg(), now)
		if followSlotList() == nil then
			-- old grid (FollowSlots empty): the original player-distance rules
			local dist = (unit.Root.Position - playerRoot.Position).Magnitude
			local stop = OrdersConfig.FollowStopDistance or 6
			if dist > (OrdersConfig.FollowDistance or 10) then
				unit.Humanoid:MoveTo(target)
				faceYaw(unit.Root, playerRoot.Position)
			elseif dist > stop then
				unit.Humanoid:MoveTo(target)
			else
				unit.Humanoid:MoveTo(unit.Root.Position)
			end
			return
		end
		-- Follow slots sit 5.7-15.5 studs from the player, so arrival is measured to the slot: a unit walks facing
		-- where it goes and, once in its slot, stands facing where the player faces (the old "face the player
		-- beyond 10 studs" rule would crab-walk the outer wings sideways)
		local toGoal = flatDist(target, unit.Root.Position)
		if toGoal > (OrdersConfig.FollowArriveStuds or 2) then
			unit.Humanoid:MoveTo(target)
			if toGoal > 4 then
				faceYaw(unit.Root, target)
			end
		else
			unit.Humanoid:MoveTo(unit.Root.Position)
			faceYaw(unit.Root, unit.Root.Position + playerRoot.CFrame.LookVector * 8)
		end
		return
	end

	if order == "Hold" then
		if not unit.HoldPos then
			unit.HoldPos = unit.Root.Position
		end
		local leash = OrdersConfig.HoldLeashStuds or 14
		local holdPos = unit.HoldPos :: Vector3
		local dist = (unit.Root.Position - holdPos).Magnitude
		if dist > leash * 0.4 then
			unit.Humanoid:MoveTo(holdPos)
		else
			unit.Humanoid:MoveTo(unit.Root.Position)
		end
		return
	end

	if order == "Retreat" then
		local cf = plotRetreatCFrame(player)
		if cf then
			local dest = cf.Position
			local dist = (unit.Root.Position - dest).Magnitude
			if dist > 6 then
				unit.Humanoid:MoveTo(dest)
				faceYaw(unit.Root, dest)
			else
				unit.Humanoid:MoveTo(unit.Root.Position)
				unit.HoldPos = unit.Root.Position
			end
		elseif playerRoot then
			unit.Humanoid:MoveTo((playerRoot.CFrame * CFrame.new(0, 0, 8)).Position)
		end
		return
	end

	if order == "Attack" then
		local aggro = OrdersConfig.AttackAggroRange or 120
		local range = OrdersConfig.AttackRange or 55
		local th, troot, dist = nearestHostile(unit.Root.Position, aggro)
		if troot then
			faceYaw(unit.Root, troot.Position)
			if dist > range * 0.85 then
				unit.Humanoid:MoveTo(troot.Position)
			else
				unit.Humanoid:MoveTo(unit.Root.Position)
				if th and th.Health > 0 and dist <= range then
					unitShoot(player, unit, th, now, CombatFairnessConfig.UnitKillCreditOnAttack == true) -- P1-4
				end
			end
		elseif playerRoot then
			unit.Humanoid:MoveTo((playerRoot.CFrame * CFrame.new(0, 0, -12)).Position)
		end
		return
	end
end

-- lane C: a new unit appears in its slot; when a wall stands between the player and that slot (e.g. recruiting
-- inside the Barracks), at the old grid spot behind the player, else on the player's trail, else in the slot as before
local function spawnCFrame(player: Player, st: SquadState, root: BasePart?, baseCf: CFrame, slot: number): CFrame
	local lift = Vector3.new(0, 2, 0)
	local slotCf = baseCf * CFrame.new(unitOffset(st, slot)) + lift
	local cfg = followPathCfg()
	if root == nil or cfg == nil then
		return slotCf
	end
	local probe = buildProbe(cfg)
	local from = root.Position
	if bodyClear(from, slotCf.Position - lift, probe) then
		return slotCf
	end
	local gridCf = baseCf * CFrame.new(gridOffset(slot)) + lift
	if bodyClear(from, gridCf.Position - lift, probe) then
		return gridCf
	end
	local trail = trailByUser[player.UserId]
	if trail then
		local reset = cfgNum(cfg, "ResetJump", 40)
		for i = #trail.Points, 1, -1 do
			local pt = trail.Points[i]
			local d = flatDist(pt, from)
			if d >= 3 and d <= reset and bodyClear(from, pt, probe) then
				return baseCf.Rotation + pt + lift
			end
		end
	end
	return slotCf
end

function SquadOrdersService.SyncArmy(player: Player)
	if not OrdersConfig.Enabled then
		clearSquad(player.UserId)
		pushState(player)
		return
	end
	local soldiers = if SoldierService then SoldierService.GetCount(player) else 0
	local maxField = (OrdersConfig.MaxFieldUnits or 5) + math.floor(researchAdd(player, "SquadSize")) -- v69 research
	local per = OrdersConfig.UnitsPerSoldier or 1
	local desired = math.clamp(math.floor(soldiers * per), 0, maxField)
	if soldiers < (OrdersConfig.MinSoldiersToShow or 1) then
		desired = 0
	end

	local st = squadByUser[player.UserId]
	if not st then
		st = {
			Order = (OrdersConfig.DefaultOrder :: any) or "Follow",
			Units = {},
			DesiredCount = 0,
			Mirror = false,
		}
		squadByUser[player.UserId] = st
	end
	st.DesiredCount = desired

	local living: { SquadUnit } = {}
	for _, u in ipairs(st.Units) do
		if u.Alive and u.Model.Parent and u.Humanoid.Health > 0 then
			table.insert(living, u)
		else
			destroyUnit(u)
		end
	end
	st.Units = living

	while #st.Units > desired do
		-- lane C: drop the outermost slot, so the wings beside the player stay filled
		local worst = #st.Units
		for i, u in ipairs(st.Units) do
			if u.Slot > st.Units[worst].Slot then
				worst = i
			end
		end
		local u = table.remove(st.Units, worst)
		if u then
			destroyUnit(u)
		end
	end

	local root = characterRoot(player)
	local baseCf: CFrame? = if root then root.CFrame else plotRetreatCFrame(player)
	if not baseCf then
		pushState(player)
		return
	end
	while #st.Units < desired do
		-- lane C: the lowest free slot (was #Units + 1, which doubled up a slot after a unit died)
		local used: { [number]: boolean } = {}
		for _, u in ipairs(st.Units) do
			used[u.Slot] = true
		end
		local slot = 1
		while used[slot] do
			slot += 1
		end
		local at = spawnCFrame(player, st, root, baseCf :: CFrame, slot)
		local unit = spawnUnit(player, slot, at)
		if unit then
			table.insert(st.Units, unit)
		else
			break
		end
	end

	pushState(player)
end


local function flashOrderBillboard(player: Player, st: SquadState, order: OrderId)
	local labels = (OrdersConfig :: any).OrderLabels or {
		Follow = "FOLLOWING",
		Attack = "ATTACKING",
		Hold = "HOLDING",
		Retreat = "RETREATING",
	}
	local textLabel = labels[order] or string.upper(order)
	local root = characterRoot(player)
	local best: SquadUnit? = nil
	local bestDist = math.huge
	local origin = if root then root.Position else nil
	for _, u in ipairs(st.Units) do
		if u.Alive and u.Root and u.Root.Parent then
			local d = if origin then (u.Root.Position - origin).Magnitude else u.Slot
			if d < bestDist then
				bestDist = d
				best = u
			end
		end
	end
	if not best then
		return
	end
	-- one owner-only order echo over the nearest unit ("FOLLOWING"), replaced by the next order, gone after `hold`
	for _, u in ipairs(st.Units) do
		local old = u.Root and u.Root:FindFirstChild("WE_OrderFlash")
		if old then
			old:Destroy()
		end
	end
	local bb = WorldLabel.Create(best.Root, textLabel, {
		Name = "WE_OrderFlash",
		Color = Color3.fromRGB(255, 230, 120),
		Studs = Vector2.new(5, 1.4),
		Offset = Vector3.new(0, 4.2, 0),
		MaxDistance = 40,
		OwnerUserId = player.UserId,
	})
	local hold = tonumber((OrdersConfig :: any).OrderBillboardSeconds) or 2.8
	local token = tostring(os.clock())
	best.Root:SetAttribute("WE_OrderFlash", token)
	task.delay(hold, function()
		if best and best.Root and best.Root.Parent and best.Root:GetAttribute("WE_OrderFlash") ~= token then
			return -- a newer order owns the flash
		end
		if bb.Parent then
			bb:Destroy()
		end
	end)
end

function SquadOrdersService.SetOrder(player: Player, orderRaw: any): (boolean, string?)
	if not OrdersConfig.Enabled then
		return false, "Disabled"
	end
	if typeof(orderRaw) ~= "string" then
		return false, "InvalidOrder"
	end
	local order = orderRaw :: string
	if not VALID[order] then
		return false, "InvalidOrder"
	end
	local flags = OrdersConfig.Orders
	if typeof(flags) == "table" and (flags :: any)[order] == false then
		return false, "OrderDisabled"
	end
	local soldiers = if SoldierService then SoldierService.GetCount(player) else 0
	if soldiers < (OrdersConfig.MinSoldiersToShow or 1) then
		return false, "NoSoldiers"
	end

	local st = squadByUser[player.UserId]
	if not st then
		SquadOrdersService.SyncArmy(player)
		st = squadByUser[player.UserId]
	end
	if not st then
		return false, "NoSquad"
	end

	st.Order = order :: OrderId
	if order == "Hold" then
		for _, u in ipairs(st.Units) do
			if u.Alive then
				u.HoldPos = u.Root.Position
			end
		end
	else
		for _, u in ipairs(st.Units) do
			u.HoldPos = nil
		end
	end

	pushState(player)
	-- the order echo is this flash + the Army popover (no "Squad: X" toast per order — spec §4.2)
	flashOrderBillboard(player, st, order :: OrderId)
	-- F6 (owner's 11 features): an accepted order ends the novice shield for good (EndOnSquadOrder)
	if CombatService and CombatService.EndNoviceShield then
		pcall(CombatService.EndNoviceShield, player, "order")
	end
	return true, nil
end

function SquadOrdersService.Push(player: Player)
	pushState(player)
end

function SquadOrdersService.ApplyResearch(player: Player) -- v69 research: rescale living units' HP, add units
	local st = squadByUser[player.UserId]
	if st then
		local maxHp = math.floor((OrdersConfig.UnitHealth or 90) * researchMult(player, "SoldierHealth") + 0.5)
		for _, u in ipairs(st.Units) do
			if u.Alive and u.Humanoid.Health > 0 then
				local ratio = u.Humanoid.Health / math.max(u.Humanoid.MaxHealth, 1)
				u.Humanoid.MaxHealth = maxHp
				u.Humanoid.Health = math.max(1, ratio * maxHp)
			end
		end
	end
	SquadOrdersService.SyncArmy(player)
end

function SquadOrdersService.Init(deps: { [string]: any })
	DataService = deps.DataService
	SoldierService = deps.SoldierService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup
	AntiExploitService = deps.AntiExploitService
	VisualAssetService = deps.VisualAssetService
	BaseService = deps.BaseService
	ResearchService = deps.ResearchService -- v69 research
	CombatService = deps.CombatService -- F6 novice shield (Init order does not matter: used only on an order)

	if not OrdersConfig.Enabled then
		print("[WAR EMPIRE] SquadOrdersService disabled (OrdersConfig.Enabled=false)")
		return
	end

	ensureFolder()

	local orderRemote = RemoteSetup.Get(Constants.RemoteNames.RequestSquadOrder) :: RemoteEvent
	orderRemote.OnServerEvent:Connect(function(player: Player, orderId: any)
		local rate = OrdersConfig.OrderRatePerSec or 2
		local burst = OrdersConfig.OrderBurst or 4
		if not RateLimitService.Allow(player, "squad_order", rate, burst) then
			if AntiExploitService and AntiExploitService.Strike then
				AntiExploitService.Strike(player, "squad_order_rate")
			end
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		local ok, err = SquadOrdersService.SetOrder(player, orderId)
		if not ok and NotificationService then
			local msg = "Order failed"
			if err == "NoSoldiers" then
				msg = "Recruit soldiers first (Army)"
			elseif err == "InvalidOrder" then
				msg = "Invalid squad order"
			end
			NotificationService.Notify(player, msg, "Warn")
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: any)
		task.defer(function()
			if player.Parent then
				SquadOrdersService.SyncArmy(player)
			end
		end)
		task.delay(2, function()
			if player.Parent then
				SquadOrdersService.SyncArmy(player)
			end
		end)
		player.CharacterAdded:Connect(function()
			task.delay(1, function()
				if player.Parent then
					SquadOrdersService.SyncArmy(player)
				end
			end)
		end)
	end)

	-- Hook army count changes without touching SoldierService billboards
	if SoldierService and SoldierService.OnArmyChanged then
		SoldierService.OnArmyChanged(function(player: Player)
			SquadOrdersService.SyncArmy(player)
		end)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		clearSquad(player.UserId)
		squadByUser[player.UserId] = nil
		trailByUser[player.UserId] = nil
	end)

	task.spawn(function()
		while true do
			local interval = OrdersConfig.ThinkInterval or 0.4
			task.wait(interval)
			local now = os.clock()
			local pathCfg = followPathCfg()
			local probe: Probe? = nil -- lane C FollowPath: built once per pass, only when a squad follows
			for _, player in ipairs(Players:GetPlayers()) do
				local st = squadByUser[player.UserId]
				local proot = characterRoot(player)
				local trail: Trail? = nil
				if proot and pathCfg then
					-- every player, every order: a switch to Follow and a recruit spawned indoors both find a trail
					trail = recordTrail(player, proot, pathCfg)
				end
				if st and #st.Units > 0 then
					-- P1-4 escort: one hostile pick per player per pass (nearest to the player)
					local escortHum: Humanoid?, escortRoot: BasePart? = nil, nil
					if st.Order == "Follow" and proot then
						escortHum, escortRoot = nearestHostile(proot.Position, CombatFairnessConfig.EscortEngageRadius)
						updateMirror(st, proot.CFrame)
						if pathCfg and probe == nil then
							probe = buildProbe(pathCfg)
						end
					end
					for _, unit in ipairs(st.Units) do
						thinkUnit(player, st, unit, now, escortHum, escortRoot, trail, probe)
					end
				end
			end
		end
	end)

	print("[WAR EMPIRE] SquadOrdersService ready (Follow = escort/Attack/Hold/Retreat)")
end

return SquadOrdersService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="176">
          <Properties>
            <string name="Name">SupplyDropService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Periodic Supply Drops — crates spawn on map; stand near to claim Cash.

	v71 (HUD v70 spec §5, roadmap §1.6): the crate stands ON THE GROUND under its anchor (a downward ray from the
	WE_EventSpawn anchor or scatter point; anchors may be invisible and float), and its label is one stud-scaled
	WorldLabel "Supply Drop" / "$8,500" (MaxDistance <= 40, never AlwaysOnTop).

	W3 step 2, lane F (spec w3s2 §3): a crate is exactly 2 parts (the crate + its lid). The glowing ring, the beacon
	ball, both straps and the catalog crate overlay (a model of unknown part count) are gone, and SupplyDropConfig
	caps it at MaxActive 2 / LifetimeSeconds 120, so the busiest 512-stud circle stays <= 500 with the bank's
	transients. Nothing here is Neon. The reward toast formats the cash with commas.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
local Constants = require(Shared.Constants)
local SupplyDropConfig = require(Shared.Configs.SupplyDropConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local WorldLabel = require(Shared.Util.WorldLabel)

local SupplyDropService = {}

local EconomyService: any = nil
local NotificationService: any = nil
local AnalyticsService: any = nil

type DropRec = {
	Id: string,
	Part: BasePart,
	ClaimCash: number,
	ExpiresAt: number,
	ClaimProgress: { [number]: number }, -- userId -> hold seconds
}

local active: { [string]: DropRec } = {}
local folder: Folder? = nil
local nextId = 0

local function ensureFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local root = Workspace:FindFirstChild("WarEmpireSetup")
	local parent = if root then root else Workspace
	local existing = parent:FindFirstChild("SupplyDrops")
	if existing and existing:IsA("Folder") then
		folder = existing
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "SupplyDrops"
	f.Parent = parent
	folder = f
	return f
end

local function formatCash(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

-- Ground under `pos`: a downward ray that skips the anchor itself, the crates, characters and non-collidable
-- decor. nil when nothing solid is below within `depth` studs.
local function groundBelow(pos: Vector3, ignore: { Instance }, depth: number): number?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = table.clone(ignore)
	table.insert(list, ensureFolder())
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	params.FilterDescendantsInstances = list
	params.RespectCanCollide = true
	local hit = Workspace:Raycast(pos, Vector3.new(0, -depth, 0), params)
	return if hit then hit.Position.Y else nil
end

-- Where the crate's BOTTOM goes: the ground under an event anchor (or a scatter point), not the anchor's centre.
local function pickSpawnPosition(): Vector3
	local pads = CollectionService:GetTagged(Constants.Tags.EventSpawn)
	local candidates: { Vector3 } = {}
	for _, inst in ipairs(pads) do
		if inst:IsA("BasePart") then
			local top = inst.Position + Vector3.new(0, inst.Size.Y * 0.5, 0)
			-- a visible solid pad IS the ground (the ray lands on its top); an invisible anchor is skipped, and a
			-- non-collidable one is skipped by RespectCanCollide
			local ignore: { Instance } = if inst.Transparency >= 0.99 then { inst } else {}
			local gy = groundBelow(top + Vector3.new(0, 1, 0), ignore, 80)
			table.insert(candidates, Vector3.new(top.X, gy or top.Y, top.Z))
		end
	end
	-- Avoid stacking on occupied pads
	local free: { Vector3 } = {}
	for _, pos in ipairs(candidates) do
		local blocked = false
		for _, rec in pairs(active) do
			if (rec.Part.Position - pos).Magnitude < 25 then
				blocked = true
				break
			end
		end
		if not blocked then
			table.insert(free, pos)
		end
	end
	if #free > 0 then
		return free[math.random(1, #free)]
	end
	-- Scatter fallback on open ground
	local r = SupplyDropConfig.ScatterRadius or 900
	local minR = SupplyDropConfig.ScatterMinDistanceFromOrigin or 120
	for _ = 1, 12 do
		local angle = math.random() * math.pi * 2
		local dist = minR + math.random() * (r - minR)
		local pos = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
		local ok = true
		for _, rec in pairs(active) do
			if (rec.Part.Position - pos).Magnitude < 40 then
				ok = false
				break
			end
		end
		if ok then
			local gy = groundBelow(pos + Vector3.new(0, 60, 0), {}, 200)
			return Vector3.new(pos.X, gy or 1, pos.Z)
		end
	end
	return Vector3.new(150, 1, 150)
end

local function destroyDrop(id: string)
	local rec = active[id]
	if not rec then
		return
	end
	active[id] = nil
	if rec.Part and rec.Part.Parent then
		rec.Part:Destroy()
	end
end

local function spawnDrop()
	if not SupplyDropConfig.Enabled then
		return
	end
	local count = 0
	for _ in pairs(active) do
		count += 1
	end
	if count >= (SupplyDropConfig.MaxActive or 2) then
		return
	end

	nextId += 1
	local id = "drop_" .. tostring(nextId)
	local ground = pickSpawnPosition()
	local cashMin = SupplyDropConfig.CashMin or 2500
	local cashMax = SupplyDropConfig.CashMax or 12000
	local cash = math.random(cashMin, cashMax)

	local parent = ensureFolder()
	local crate = Instance.new("Part")
	crate.Name = "SupplyCrate_" .. id
	crate.Size = SupplyDropConfig.CrateSize or Vector3.new(5, 4, 5)
	crate.Position = ground + Vector3.new(0, crate.Size.Y * 0.5, 0) -- bottom face on the ground
	crate.Anchored = true
	crate.CanCollide = true
	crate.Color = SupplyDropConfig.CrateColor or Color3.fromRGB(210, 160, 55)
	crate.Material = Enum.Material.Metal
	crate.TopSurface = Enum.SurfaceType.Smooth
	crate.BottomSurface = Enum.SurfaceType.Smooth
	crate.Parent = parent
	crate:SetAttribute("SupplyDropId", id)
	crate:SetAttribute("ClaimCash", cash)
	CollectionService:AddTag(crate, Constants.Tags.SupplyDrop)

	-- The one decor part: a darker lid (2 parts per crate; no ring, beacon, straps or catalog overlay: spec w3s2 §3)
	local lid = Instance.new("Part")
	lid.Name = "Lid"
	lid.Size = Vector3.new(crate.Size.X * 0.92, 0.4, crate.Size.Z * 0.92)
	lid.Anchored = true
	lid.CanCollide = false
	lid.CanQuery = false
	lid.CanTouch = false
	lid.CastShadow = false
	lid.Material = Enum.Material.Metal
	lid.Color = SupplyDropConfig.LidColor or Color3.fromRGB(180, 140, 50)
	lid.TopSurface = Enum.SurfaceType.Smooth
	lid.BottomSurface = Enum.SurfaceType.Smooth
	lid.CFrame = crate.CFrame * CFrame.new(0, crate.Size.Y * 0.5 + 0.1, 0)
	lid.Parent = crate

	local bb = WorldLabel.Create(crate, "Supply Drop", {
		Name = "Label",
		Sub = "$" .. formatCash(cash),
		Color = Color3.fromRGB(255, 220, 120),
		SubColor = Color3.fromRGB(110, 255, 90),
		Offset = Vector3.new(0, crate.Size.Y * 0.5 + (SupplyDropConfig.LabelLiftStuds or 3), 0), -- above the lid
		MaxDistance = 40,
	})
	-- v31: never AlwaysOnTop — was covering structure name billboards on approach
	bb.AlwaysOnTop = false

	local ttl = SupplyDropConfig.LifetimeSeconds or 120

	active[id] = {
		Id = id,
		Part = crate,
		ClaimCash = cash,
		ExpiresAt = os.clock() + ttl,
		ClaimProgress = {},
	}
end

local function claim(player: Player, rec: DropRec)
	destroyDrop(rec.Id)
	EconomyService.AddCash(player, rec.ClaimCash, "supply_drop")
	if NotificationService then
		NotificationService.Notify(player, "Supply drop +$" .. formatCash(rec.ClaimCash), "Reward")
	end
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.SUPPLY_DROP_CLAIM, player.UserId, {
			cash = rec.ClaimCash,
			dropId = rec.Id,
		})
	end
end

local function tickClaims(dt: number)
	local radius = SupplyDropConfig.ClaimRadius or 10
	local holdNeed = SupplyDropConfig.ClaimHoldSeconds or 2.5
	local now = os.clock()

	-- Expire
	local expired: { string } = {}
	for id, rec in pairs(active) do
		if now >= rec.ExpiresAt or not rec.Part.Parent then
			table.insert(expired, id)
		end
	end
	for _, id in ipairs(expired) do
		destroyDrop(id)
	end

	for _, rec in pairs(active) do
		local pos = rec.Part.Position
		local nearby: { [number]: boolean } = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - pos).Magnitude
				if d <= radius then
					nearby[player.UserId] = true
					local prog = (rec.ClaimProgress[player.UserId] or 0) + dt
					rec.ClaimProgress[player.UserId] = prog
					if prog >= holdNeed then
						claim(player, rec)
						break
					end
				end
			end
		end
		-- Decay progress for leavers
		for uid in pairs(rec.ClaimProgress) do
			if not nearby[uid] then
				rec.ClaimProgress[uid] = nil
			end
		end
	end
end

function SupplyDropService.Init(deps: { [string]: any })
	EconomyService = deps.EconomyService
	NotificationService = deps.NotificationService
	AnalyticsService = deps.AnalyticsService

	if not SupplyDropConfig.Enabled then
		return
	end

	ensureFolder()

	task.spawn(function()
		task.wait(12) -- let map settle
		spawnDrop()
		local interval = SupplyDropConfig.SpawnIntervalSeconds or 90
		while true do
			task.wait(interval)
			spawnDrop()
		end
	end)

	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		local step = accum
		accum = 0
		tickClaims(step)
	end)
end

return SupplyDropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="177">
          <Properties>
            <string name="Name">TerritoryService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 5 — Territory control.
	Server-authoritative stand-in-zone capture; bonuses for Economy / XP / Vehicles / Combat.

	v71 (HUD v70 spec §5, roadmap W1 F): the capture marker and ring only take the owner colour (no forced Neon,
	no transparency / size writes — World v2 owns their look); the flag is painted (SmoothPlastic) and sits at
	basePos.Y + flagLift − 1 (oil-rig decks too); the zone label is one stud-scaled WorldLabel with the zone name
	in the owner colour (capture % and "contested" live on the HUD capture bar); the WE_FlagBillboard diamond is
	28 px and draws through walls only while contested (WorldLabel.SetRole). No "Capturing X..." toast.

	Owner's 11 features, lane W:
	  F3  Empire Tax. Capture / loss / steal toasts are EconomyConfig.OutpostIncomeBuff templates with the player's
	      TOTAL Empire Tax % (EconomyService.SyncOutpostIncomeStacks recounts it from profile.Territories).
	      PersistClaims (flag): on join, replantClaims re-plants the saved claims onto Neutral / NPC-held zones (a zone
	      another online player holds is dropped with the ToastClaimHeld toast), and on leave the leaver's zones go back
	      to Neutral (the saved claims are NOT wiped, so the next server re-plants them). Off = the old soft release.
	  F6  A shielded novice standing in a contested zone loses the novice shield (CombatService.EndNoviceShield
	      "contest", pcall).
	  F10 Home Outposts (TerritoryConfig.Starter rows, IsStarterId): owner-only capture (TerritoryCapture), 10 s,
	      +StarterPct Empire Tax, never a stack, never counted toward MaxPersonalTerritories, never evicted or stolen,
	      no stipend, no light or stripe. The first capture sets profile.StarterOutpostTaken; later the plot owner holds
	      it automatically on BaseService.OnPlotReady. It goes back to Neutral when the owner leaves or the plot changes
	      hands. Other plots' Home Outposts are not in a player's territory list (TerritoryRadar.ShownTo).
	  Nations B2: the contested pulse and the capture HUD fall back to amber when the two nation colours are closer
	      than NationConfig.ContestMinColorDistance; an owned zone never takes a colour that reads as NPC red, Clan
	      blue or contested amber (legacy roster colour, else green); a leaver's colour is kept while that UserId still
	      owns a zone (R15, then dropped); outpost nation flags (Textures only, never a SurfaceGui) and their sizes sit
	      behind NationConfig.OutpostFlags (off), shown only on a Player-owned, uncontested zone (RefreshOwnerFlags).
	Streaming 2, lane C2 (spec F7): Radar Hill reveals the other players within RadarRevealRadius (550), but under
	      instance streaming a client holds only the characters inside its stream radius (StreamingMinRadius 64 on a
	      phone short of memory). While Workspace.StreamingEnabled, a radar holder's payload lists them as RadarTargets
	      (UserId + HumanoidRootPart position, Instance-free, nearest first) and the holder gets its own payload every
	      RADAR_STREAM.PushSeconds, so TerritoryController can mark the ones it has not streamed in. With streaming off
	      the payload and the push rate are exactly as before (every character is on every client).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared", 60) -- ships with the place (Rojo); bounded wait anyway
local Constants = require(Shared.Constants)
local Types = require(Shared.Types)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local WorldLabel = require(Shared.Util.WorldLabel)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local EconomyConfig = require(Shared.Configs.EconomyConfig) -- F3 toasts + PersistClaims (EconomyConfig requires nothing)
local NationConfig = require(Shared.Configs.NationConfig) -- B2: contest colour distance, OutpostFlags
local NationColorConfig = require(Shared.Configs.NationColorConfig) -- B2: the legacy roster colour fallback
local NationTexture = require(Shared.Util.NationTexture) -- B2: outpost flag Textures (behind OutpostFlags)

local TerritoryRadar = require(script.TerritoryRadar)
local TerritoryOwnership = require(script.TerritoryOwnership)
local TerritoryCapture = require(script.TerritoryCapture)

type TerritoryDef = TerritoryConfig.TerritoryDef

type TerritoryRuntime = {
	Id: string,
	Def: TerritoryDef,
	OwnerType: string,
	OwnerUserId: number, -- 0 neutral, -1 NPC, else player
	ClanId: string?,
	Progress: number, -- seconds accumulated toward capture
	CapturingUserId: number, -- 0 if none
	ProtectedUntil: number, -- unix
	Contested: boolean,
	-- v38: up to two contester UserIds for dual nation-color pulse
	ContesterA: number?,
	ContesterB: number?,
	Marker: BasePart?,
}

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local TerritoryService = {}

local ClanWarService: any = nil

local DataService: any = nil
local _EconomyService: any = nil
local _XPService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local NotificationService: any = nil
local MissionService: any = nil
local TutorialService: any = nil
local RemoteSetup: any = nil
local BaseService: any = nil
local NationColorService: any = nil
local CombatService: any = nil -- F6: EndNoviceShield("contest")

local territories: { [string]: TerritoryRuntime } = {}
local firstOutpostLogged: { [number]: boolean } = {}
local lastPushAt = 0
local pushDirty = true

-- Streaming 2, lane C2 (see the header). Candidates for TerritoryConfig (lane C2 may edit only its three files).
local RADAR_STREAM = {
	PushSeconds = 1, -- a radar holder's own payload rate while streaming is on (the full push is every 2 s idle)
	MaxTargets = 16, -- nearest first; the client draws at most 5 markers
}
local lastRadarPushAt: { [Player]: number } = {} -- os.clock() of the last payload that carried RadarTargets

local function ownerTypes()
	return TerritoryConfig.OwnerTypes
end

local function nowUnix(): number
	return os.time()
end

local function findMarker(territoryId: string): BasePart?
	return TerritoryRadar.FindMarker(territoryId)
end

local function ensureRuntime()
	for id, def in pairs(TerritoryConfig.Territories) do
		if not territories[id] then
			territories[id] = {
				Id = id,
				Def = def,
				OwnerType = ownerTypes().Neutral,
				OwnerUserId = TerritoryConfig.NeutralOwnerId,
				ClanId = nil,
				Progress = 0,
				CapturingUserId = 0,
				ProtectedUntil = 0,
				Contested = false,
				Marker = findMarker(id),
			}
		elseif not territories[id].Marker or not territories[id].Marker.Parent then
			territories[id].Marker = findMarker(id)
		end
	end
end

local function countPersonalTerritories(userId: number): number
	local n = 0
	for _, rt in pairs(territories) do
		if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == userId then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------------------------------------------------
-- F10 Home Outposts (TerritoryConfig.Starter rows)
---------------------------------------------------------------------------------------------------------------

--[[ F10 (spec §2 cross-lane API): true for a Home Outpost id (a TerritoryConfig.Starter row, only while
	Starter.Enabled). Never yields. ]]
function TerritoryService.IsStarterId(id: any): boolean
	if typeof(id) ~= "string" then
		return false
	end
	return TerritoryConfig.IsStarterDef(TerritoryConfig.Territories[id])
end

local function isStarterRt(rt: TerritoryRuntime): boolean
	return TerritoryConfig.IsStarterDef(rt.Def)
end

-- the runtime of plot plotId's Home Outpost, or nil (Starter off / unknown plot)
local function starterRtForPlot(plotId: any): TerritoryRuntime?
	if typeof(plotId) ~= "number" then
		return nil
	end
	local st = TerritoryConfig.Starter
	local id = tostring(st.IdPrefix) .. tostring(plotId)
	local rt = territories[id]
	if rt and isStarterRt(rt) and rt.Def.PlotId == plotId then
		return rt
	end
	return nil
end

-- F10: personal zones that count toward MaxPersonalTerritories (a Home Outpost never does)
local function countPersonalNonStarter(userId: number): number
	local n = 0
	for _, rt in pairs(territories) do
		if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == userId and not isStarterRt(rt) then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------------------------------------------------
-- Nations B2: colours that never read as NPC / Clan / contested, and the R15 leaver cache
---------------------------------------------------------------------------------------------------------------

local AMBER = Color3.fromRGB(255, 140, 35) -- contested
local NPC_RED = Color3.fromRGB(210, 45, 45) -- NPC-held
local CLAN_BLUE = Color3.fromRGB(70, 120, 240) -- clan-held
local OWNED_FALLBACK = Color3.fromRGB(55, 210, 95) -- a player-held zone with no usable colour

-- RGB distance (0..1.73)
local function colorDistance(a: Color3, b: Color3): number
	local dr, dg, db = a.R - b.R, a.G - b.G, a.B - b.B
	return math.sqrt(dr * dr + dg * dg + db * db)
end

local function tooClose(a: Color3, b: Color3): boolean
	local minD = tonumber((NationConfig :: any).ContestMinColorDistance) or 0.25
	return colorDistance(a, b) < minD
end

-- a colour that would read as NPC-held, clan-held or contested
local function nearReserved(c: Color3): boolean
	return tooClose(c, NPC_RED) or tooClose(c, CLAN_BLUE) or tooClose(c, AMBER)
end

local function rawNationColor(userId: number?): Color3?
	if typeof(userId) ~= "number" or userId <= 0 or not NationColorService or not NationColorService.GetColor then
		return nil
	end
	local ok, c = pcall(NationColorService.GetColor, userId)
	return if ok and typeof(c) == "Color3" then c else nil
end

-- the player's legacy 8-colour roster colour (NationColorConfig), or nil
local function legacyRosterColor(userId: number): Color3?
	if not NationColorService or not NationColorService.GetColorId then
		return nil
	end
	local ok, id = pcall(NationColorService.GetColorId, userId)
	if not ok or typeof(id) ~= "string" then
		return nil
	end
	for _, def in ipairs(NationColorConfig.Colors) do
		if def.Id == id then
			return def.Color
		end
	end
	return nil
end

--[[ R15: the colour (and nation id, for the outpost flag) of every player who owns a zone, refreshed while they are
	online. NationColorService forgets a leaver at once; this keeps the leaver's entry only while that UserId still
	owns at least one zone, then drops it (pruneOwnerCache), so it never grows with the server's lifetime. ]]
type OwnerLook = { Color: Color3, NationId: string? }
local ownerLookCache: { [number]: OwnerLook } = {}
local FALLBACK_LOOK: OwnerLook = { Color = OWNED_FALLBACK, NationId = nil }

local function nationIdFor(userId: number): string?
	if not NationColorService or not NationColorService.GetNationId then
		return nil
	end
	local ok, id = pcall(NationColorService.GetNationId, userId) -- art-gated: nil until nations may be shown
	return if ok and typeof(id) == "string" then id else nil
end

-- B2 (c): an owned zone's colour. The nation (or legacy) colour, unless it reads as NPC red, Clan blue or contested
-- amber: then the legacy roster colour, else OWNED_FALLBACK. Offline owner: the cached look (R15).
local function ownerLook(userId: number): OwnerLook
	local raw = rawNationColor(userId)
	if raw then
		local c = raw
		if nearReserved(c) then
			local legacy = legacyRosterColor(userId)
			c = if legacy and not nearReserved(legacy) then legacy else OWNED_FALLBACK
		end
		local nid = if NationConfig.OutpostFlags == true then nationIdFor(userId) else nil
		local cached = ownerLookCache[userId]
		if cached and cached.Color == c and cached.NationId == nid then
			return cached
		end
		local look: OwnerLook = { Color = c, NationId = nid }
		ownerLookCache[userId] = look
		return look
	end
	return ownerLookCache[userId] or FALLBACK_LOOK
end

-- R15: drop a UserId's cached look once it owns no zone (called after every release)
local function pruneOwnerCache(userId: number?)
	if typeof(userId) == "number" and ownerLookCache[userId] ~= nil and countPersonalTerritories(userId) == 0 then
		ownerLookCache[userId] = nil
	end
end

-- B2 (a) / (b): the two contester colours, with B replaced by amber when A and B are too close to tell apart, and
-- both dropped (the default amber pulse) when A itself reads as amber.
local function contestColors(rt: TerritoryRuntime): (Color3?, Color3?)
	local colA = rawNationColor(rt.ContesterA)
	local colB = rawNationColor(rt.ContesterB)
	if colA and colB and tooClose(colA, colB) then
		if tooClose(colA, AMBER) then
			return nil, nil
		end
		return colA, AMBER
	end
	return colA, colB
end

---------------------------------------------------------------------------------------------------------------
-- Nations B2 (e): outpost nation flags, behind NationConfig.OutpostFlags (off). Textures only, never a SurfaceGui.
---------------------------------------------------------------------------------------------------------------

local FLAG_TEXTURE_NAMES = { "WE_NationTexA", "WE_NationTexB" }
local FLAG_SHOWN_ATTR = "WE_NationShown"
-- 4:3 flag sizes while OutpostFlags is on (owned / contested / neutral)
local OUTPOST_FLAG_OWNED = Vector3.new(4.8, 3.6, 0.28)
local OUTPOST_FLAG_CONTESTED = Vector3.new(5.2, 3.9, 0.3)
local OUTPOST_FLAG_NEUTRAL = Vector3.new(3.6, 2.7, 0.22)

--[[ Show nationId's flag on a zone flag part (2 Textures on the thin faces, like Modules/NationFlag), or blank them
	(nationId nil, or no art wired). Textures are created only when a flag is first shown. Idempotent: an unchanged
	view writes nothing (WE_NationShown key). Returns true while a nation flag image shows. ]]
local function dressOutpostFlag(flag: BasePart, nationId: string?): boolean
	local def = if nationId then NationConfig.Get(nationId) else nil
	local faceA, faceB, w, h = NationTexture.ThinFaces(flag.Size.X, flag.Size.Y, flag.Size.Z)
	local src = if def then NationTexture.Source(def.Id) else nil
	local props = if src then NationTexture.TextureProps(w, h, src.Rect) else nil
	local image = if src and props then src.Image else ""
	local key = string.format("%s|%.2fx%.2f|%s", if def and image ~= "" then def.Id else "-", w, h, image)
	if flag:GetAttribute(FLAG_SHOWN_ATTR) == key then
		return image ~= ""
	end
	local faces = { faceA, faceB }
	for i, name in ipairs(FLAG_TEXTURE_NAMES) do
		local t = flag:FindFirstChild(name)
		local tex: Texture? = if t and t:IsA("Texture") then t else nil
		if image ~= "" and props then
			if tex == nil then
				local created = Instance.new("Texture")
				created.Name = name
				created.Parent = flag
				tex = created
			end
			local tx = tex :: Texture
			local face = (Enum.NormalId :: any)[faces[i]]
			if tx.Face ~= face then
				tx.Face = face
			end
			tx.Texture = image
			tx.StudsPerTileU = props.StudsPerTileU
			tx.StudsPerTileV = props.StudsPerTileV
			tx.OffsetStudsU = props.OffsetStudsU
			tx.OffsetStudsV = props.OffsetStudsV
			tx.Transparency = 0
		elseif tex then
			tex.Texture = ""
			tex.Transparency = 1
		end
	end
	flag:SetAttribute(FLAG_SHOWN_ATTR, key)
	return image ~= ""
end

local function syncProfileOwnership(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.Territories) ~= "table" then
		profile.Territories = {}
	end
	-- Clear then re-apply owned
	for id in pairs(profile.Territories) do
		profile.Territories[id] = nil
	end
	for id, rt in pairs(territories) do
		if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == player.UserId then
			profile.Territories[id] = true
		end
	end
	DataService.MarkDirty(player)
end

-- Zone label: the zone name only, in the owner colour (spec §5). MapSetup's old "Label" card (name + [NEUTRAL] ·
-- Stand to capture, 220 studs) is replaced by this one stud-scaled WorldLabel above the flag pole.
local ZONE_LABEL_HEIGHT = 16 -- studs above the marker centre (the pole is 14 tall)

local function ensureZoneLabel(rt: TerritoryRuntime, marker: BasePart): BillboardGui
	local existing = marker:FindFirstChild("WE_ZoneLabel")
	if existing and existing:IsA("BillboardGui") then
		return existing
	end
	local legacy = marker:FindFirstChild("Label")
	if legacy and legacy:IsA("BillboardGui") then
		legacy:Destroy()
	end
	return WorldLabel.Create(marker, rt.Def.DisplayName, {
		Name = "WE_ZoneLabel",
		Studs = Vector2.new(8, 1.6),
		Offset = Vector3.new(0, ZONE_LABEL_HEIGHT, 0),
		MaxDistance = 40,
	})
end

local function updateMarkerVisual(rt: TerritoryRuntime)
	local marker = rt.Marker
	if not marker then
		return
	end
	local ot = ownerTypes()
	local contested = rt.Contested or rt.OwnerType == ot.Contested
	local color: Color3
	local flagTransparency = 0.15
	local flagLift = 12 -- studs above the marker for the flag centre (+ basePos.Y − 1 below)
	local ownerNationId: string? = nil -- B2 (e): the owner's nation flag (only while OutpostFlags is on)

	if contested then
		-- v38: pulse between both nation colors when two contesting players known.
		-- Nations B2 (a): two colours closer than NationConfig.ContestMinColorDistance pulse A <-> amber instead
		-- (contestColors hands back amber as B), and a colour that itself reads as amber is plain amber.
		local colA, colB = contestColors(rt)
		if colA and colB then
			local pulse = (math.sin(os.clock() * 4) + 1) * 0.5
			color = colA:Lerp(colB, pulse)
		elseif colA and not tooClose(colA, AMBER) then
			local pulse = (math.sin(os.clock() * 5) + 1) * 0.5
			color = colA:Lerp(AMBER, pulse)
		else
			color = AMBER
		end
		flagTransparency = 0.05
		flagLift = 13.5
	elseif rt.OwnerType == ot.Player then
		-- Nations B2 (c): never a colour that reads as NPC red, Clan blue or contested amber; R15: an owner who left
		-- keeps the cached colour while they still own a zone
		local look = ownerLook(rt.OwnerUserId)
		color = look.Color
		ownerNationId = look.NationId
		flagTransparency = 0.0
		flagLift = 14.5
	elseif rt.OwnerType == ot.NPC then
		color = NPC_RED
		flagTransparency = 0.05
		flagLift = 13.2
	elseif rt.OwnerType == ot.Clan then
		color = CLAN_BLUE
		flagTransparency = 0.0
		flagLift = 14.0
	else
		color = rt.Def.Color
		flagTransparency = 0.35
		flagLift = 11.0
	end

	-- v71: colour only (no forced Neon / transparency: World v2 decides how the marker looks)
	if marker.Color ~= color then
		marker.Color = color
	end
	marker:SetAttribute("OwnerType", if contested then ot.Contested else rt.OwnerType)
	marker:SetAttribute("OwnerUserId", rt.OwnerUserId)
	marker:SetAttribute("CaptureProgress", rt.Progress / math.max(1, rt.Def.CaptureTimeSeconds))

	local tid = marker:GetAttribute("TerritoryId")
	if typeof(tid) ~= "string" then
		return
	end
	local parent = marker.Parent
	if not parent then
		return
	end

	local flag = parent:FindFirstChild(tid .. "_Flag")
	if flag and flag:IsA("BasePart") then
		flag.Color = color
		flag.Material = Enum.Material.SmoothPlastic -- v71: painted, not neon (not a light source)
		flag.Transparency = flagTransparency
		-- Raise owned flags; lower neutral so ownership reads at a glance. Height from the marker, so a flag on
		-- an oil-rig deck (marker high above the sea) stays on its pole instead of dropping to y ≈ 12.
		local basePos = marker.Position
		local outpostFlags = NationConfig.OutpostFlags == true
		if outpostFlags then
			-- Nations B2 (e): 4:3 flag sizes for the nation Texture (owned / contested / neutral)
			flag.Size = if contested then OUTPOST_FLAG_CONTESTED elseif rt.OwnerType == ot.Neutral then OUTPOST_FLAG_NEUTRAL else OUTPOST_FLAG_OWNED
		else
			flag.Size = if contested then Vector3.new(6.2, 3.6, 0.3) elseif rt.OwnerType == ot.Neutral then Vector3.new(4.2, 2.4, 0.22) else Vector3.new(5.5, 3.2, 0.28)
		end
		flag.Position = Vector3.new(basePos.X + flag.Size.X * 0.5 + 0.2, basePos.Y + flagLift - 1, basePos.Z)
		-- Nations B2 (e): a nation flag only on a Player-owned, uncontested zone, and only while OutpostFlags is on
		-- (with it off no Texture is ever made here). Never a SurfaceGui; never while contested (no flag as a target).
		local nationFlagShows = false
		if outpostFlags then
			local showId = if not contested and rt.OwnerType == ot.Player then ownerNationId else nil
			nationFlagShows = dressOutpostFlag(flag, showId)
		end
		-- W3 step 2 (spec w3s2 §1.11, lane P): no owner light on the flag any more. It broke the world light policy
		-- (Brightness 2.4-3.2 and Range 28 > 0.8 / 18, one per zone); the painted flag, stripe and diamond show the owner.
		-- A leftover one (a place saved with an older build's flag) is removed. F10: a Home Outpost never had one.
		if not isStarterRt(rt) then
			local oldLight = flag:FindFirstChild("WE_OwnerLight")
			if oldLight then
				oldLight:Destroy()
			end
		end

		-- Keep stripe locked to flag (nation color visibility polish). F10: a Home Outpost has no stripe.
		-- Nations B2 (e): the stripe hides (Transparency 1) while a nation flag image shows.
		local stripe = if isStarterRt(rt) then nil else parent:FindFirstChild(tid .. "_FlagStripe")
		if stripe and stripe:IsA("BasePart") then
			stripe.Size = Vector3.new(flag.Size.X, math.max(0.35, flag.Size.Y * 0.14), flag.Size.Z + 0.06)
			stripe.Position = flag.Position
			stripe.Color = Color3.fromRGB(245, 245, 245)
			stripe.Transparency = if nationFlagShows then 1 elseif rt.OwnerType == ot.Neutral then 0.45 else 0.08
		end

		-- Nation-colour diamond over the flag: 28 px, MaxDistance <= 40, through walls ONLY while contested
		-- (WorldLabel.SetRole "contested"; WorldLabelPolicy honours the role). Range is set once, never per refresh.
		local flagBbInst = flag:FindFirstChild("WE_FlagBillboard")
		local flagBb: BillboardGui
		if flagBbInst and flagBbInst:IsA("BillboardGui") and flagBbInst:GetAttribute("WE_V71") == true then
			flagBb = flagBbInst
		else
			if flagBbInst then
				flagBbInst:Destroy()
			end
			local created = Instance.new("BillboardGui")
			created.Name = "WE_FlagBillboard"
			created.Size = UDim2.fromOffset(28, 28)
			created.StudsOffset = Vector3.new(0, 2.2, 0)
			created.AlwaysOnTop = false
			created.LightInfluence = 0
			created.MaxDistance = 40
			created:SetAttribute("WE_V71", true)
			local diamond = Instance.new("Frame")
			diamond.Name = "NationDiamond"
			diamond.AnchorPoint = Vector2.new(0.5, 0.5)
			diamond.Position = UDim2.fromScale(0.5, 0.5)
			diamond.Size = UDim2.fromScale(0.62, 0.62)
			diamond.Rotation = 45
			diamond.BorderSizePixel = 0
			diamond.Parent = created
			local ds = Instance.new("UIStroke")
			ds.Name = "DiamondStroke"
			ds.Thickness = 2
			ds.Color = Color3.fromRGB(255, 255, 255)
			ds.Parent = diamond
			created.Parent = flag
			flagBb = created
		end
		local showFlag = rt.OwnerType ~= ot.Neutral or contested
		if flagBb.Enabled ~= showFlag then
			flagBb.Enabled = showFlag
		end
		WorldLabel.SetRole(flagBb, if contested then "contested" else nil)
		local diamond = flagBb:FindFirstChild("NationDiamond")
		if diamond and diamond:IsA("Frame") then
			diamond.BackgroundColor3 = color
			local ds = diamond:FindFirstChild("DiamondStroke")
			if ds and ds:IsA("UIStroke") then
				ds.Color = if contested then Color3.fromRGB(255, 200, 80) else Color3.fromRGB(255, 255, 255)
			end
		end
	end

	-- v71: the ring writes colour only (roadmap W1 F; no Neon while contested, no size / transparency churn)
	local ring = parent:FindFirstChild(tid .. "_Ring")
	if ring and ring:IsA("BasePart") and ring.Color ~= color then
		ring.Color = color
	end

	local pole = parent:FindFirstChild(tid .. "_FlagPole")
	if pole and pole:IsA("BasePart") then
		pole.Color = if contested then Color3.fromRGB(180, 90, 30) elseif rt.OwnerType == ot.Neutral then Color3.fromRGB(55, 55, 55) else Color3.fromRGB(40, 45, 40)
	end

	-- Zone label: name only, owner colour (neutral = white); % / contested are on the HUD capture bar
	local zoneLabel = ensureZoneLabel(rt, marker)
	local title = zoneLabel:FindFirstChild("Title")
	local nameColor = if contested then Color3.fromRGB(255, 176, 48) elseif rt.OwnerType == ot.Neutral then Color3.new(1, 1, 1) else color
	if title and title:IsA("TextLabel") and title.TextColor3 ~= nameColor then
		title.TextColor3 = nameColor
	end
end

-- lane C2: Workspace.StreamingEnabled (a place setting the engine fixes for the server's life; read per call, pcall'd)
local function streamingOn(): boolean
	local ok, on = pcall(function()
		return Workspace.StreamingEnabled
	end)
	return ok and on == true
end

local function liveRoot(p: Player): BasePart?
	local character = p.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		return root
	end
	return nil
end

--[[ lane C2 (F7): the players a radar holder reveals, as the client decides for the characters it holds (every other
	living player whose HumanoidRootPart is within radius of the holder's): UserId + position, nearest first, at most
	RADAR_STREAM.MaxTargets. Instance-free (F31). Server data only: nothing here comes from a client. ]]
local function radarTargetsFor(viewer: Player, radius: number): { Types.RadarTargetPayload }
	local out: { Types.RadarTargetPayload } = {}
	local myRoot = liveRoot(viewer)
	if not myRoot then
		return out
	end
	local origin = myRoot.Position
	local dist: { [number]: number } = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= viewer then
			local root = liveRoot(other)
			if root then
				local pos = root.Position
				local d = (pos - origin).Magnitude
				if d <= radius then
					dist[other.UserId] = d
					table.insert(out, { UserId = other.UserId, Pos = pos })
				end
			end
		end
	end
	table.sort(out, function(a: Types.RadarTargetPayload, b: Types.RadarTargetPayload): boolean
		local da, db = dist[a.UserId], dist[b.UserId]
		if da ~= db then
			return da < db
		end
		return a.UserId < b.UserId
	end)
	for i = #out, RADAR_STREAM.MaxTargets + 1, -1 do
		out[i] = nil
	end
	return out
end

local function buildPayloadForPlayer(player: Player?): Types.TerritoryStatePayload
	local list: { Types.TerritoryEntryPayload } = {}
	local localCapture = {
		TerritoryId = nil :: string?,
		Progress = 0,
		Capturing = false,
		Contested = false,
		Protected = false,
	}
	-- F10: another plot's Home Outpost is not listed (only its owner can take it; TerritoryRadar.ShownTo)
	local viewerPlotId: number? = nil
	if player and BaseService and BaseService.GetOwnedPlotId then
		local okPlot, pid = pcall(BaseService.GetOwnedPlotId, player)
		if okPlot and typeof(pid) == "number" then
			viewerPlotId = pid
		end
	end

	for _, rt in pairs(territories) do
		if not TerritoryRadar.ShownTo(rt.Def, viewerPlotId) then
			continue
		end
		table.insert(list, {
			Id = rt.Id,
			DisplayName = rt.Def.DisplayName,
			OwnerType = if rt.Contested then ownerTypes().Contested else rt.OwnerType,
			OwnerUserId = rt.OwnerUserId,
			ClanId = rt.ClanId,
			Progress = math.clamp(rt.Progress / math.max(1, rt.Def.CaptureTimeSeconds), 0, 1),
			CapturingUserId = rt.CapturingUserId,
			ProtectedUntil = rt.ProtectedUntil,
			BonusType = rt.Def.BonusType,
			BonusValue = rt.Def.BonusValue,
			Contested = rt.Contested,
		})
		if player and rt.CapturingUserId == player.UserId and rt.Progress > 0 then
			localCapture.TerritoryId = rt.Id
			localCapture.Progress = math.clamp(rt.Progress / math.max(1, rt.Def.CaptureTimeSeconds), 0, 1)
			localCapture.Capturing = true
			localCapture.Contested = rt.Contested == true
			localCapture.Protected = rt.ProtectedUntil > nowUnix()
				and rt.OwnerUserId ~= TerritoryConfig.NeutralOwnerId
				and rt.OwnerUserId ~= player.UserId
			-- v38: dual nation colors for contested pulse HUD.
			-- Nations B2 (b): the same rule as the world pulse (contestColors): two colours too close to tell apart
			-- send B = amber, and a colour that itself reads as amber sends neither (the HUD's own amber pulse), so
			-- the capture bar never pulses between two identical colours.
			if rt.Contested then
				local function packColor(c: Color3?): { number }?
					if not c then
						return nil
					end
					return { c.R, c.G, c.B }
				end
				local colA, colB = contestColors(rt)
				;(localCapture :: any).ContesterColorA = packColor(colA)
				;(localCapture :: any).ContesterColorB = packColor(colB)
			end
		end
	end

	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)

	local radar = false
	local radarRadius = TerritoryConfig.RadarRevealRadius or 220
	if player then
		radar = TerritoryService.HasRadarReveal(player)
	end

	local payload: Types.TerritoryStatePayload = {
		Territories = list,
		LocalCapture = localCapture,
		RadarReveal = radar,
		RadarRadius = radarRadius,
	}
	-- lane C2 (F7): the reveal list, only while streaming is on (nil otherwise: the payload is as before)
	if player and radar and streamingOn() then
		payload.RadarTargets = radarTargetsFor(player, radarRadius)
		lastRadarPushAt[player] = os.clock()
	end
	return payload
end

function TerritoryService.PushAll()
	ensureRuntime()
	local remote = RemoteSetup.Get(Constants.RemoteNames.TerritoryStateUpdate) :: RemoteEvent
	for _, player in ipairs(Players:GetPlayers()) do
		remote:FireClient(player, buildPayloadForPlayer(player))
	end
	lastPushAt = os.clock()
end

function TerritoryService.PushPlayer(player: Player)
	ensureRuntime()
	local remote = RemoteSetup.Get(Constants.RemoteNames.TerritoryStateUpdate) :: RemoteEvent
	remote:FireClient(player, buildPayloadForPlayer(player))
end

function TerritoryService.GetController(territoryId: string): number?
	local rt = territories[territoryId]
	if not rt then
		return nil
	end
	if rt.OwnerType == ownerTypes().Neutral or rt.OwnerType == ownerTypes().Contested then
		return nil
	end
	return rt.OwnerUserId
end

function TerritoryService.GetRuntime(territoryId: string): TerritoryRuntime?
	return territories[territoryId]
end

--[[ Aggregate bonus values for territories controlled by this player (or their clan). ]]
function TerritoryService.GetBonusesForPlayer(player: Player): { [string]: number }
	local bonuses: { [string]: number } = {}
	local profile = DataService and DataService.GetProfile(player)
	local clanId = if profile then profile.ClanId else nil

	for _, rt in pairs(territories) do
		local owns = (rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == player.UserId)
			or (rt.OwnerType == ownerTypes().Clan and clanId ~= nil and rt.ClanId == clanId)
		if owns then
			-- Flat and multiplicative bonuses both accumulate additively into the map;
			-- consumers interpret FlatPassiveCash/MinimapReveal as flat, *Mult as fractions.
			local key = rt.Def.BonusType
			local value = rt.Def.BonusValue
			bonuses[key] = (bonuses[key] or 0) + value
		end
	end
	return bonuses
end

function TerritoryService.GetPassiveCashBonus(player: Player): (number, number)
	-- returns (multiplierAdd, flatAdd) e.g. 0.10, 50
	local b = TerritoryService.GetBonusesForPlayer(player)
	return b.PassiveCashMult or 0, b.FlatPassiveCash or 0
end

function TerritoryService.GetXPMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	return 1 + (b.XPMult or 0)
end

function TerritoryService.GetDamageMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	return 1 + (b.DamageMult or 0)
end

function TerritoryService.GetVehicleCooldownMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	-- BonusValue for WestDepot is -0.20 → cooldown * 0.80
	return 1 + (b.VehicleCooldownMult or 0)
end

function TerritoryService.GetMissionCashMult(player: Player): number
	local b = TerritoryService.GetBonusesForPlayer(player)
	return 1 + (b.MissionCashMult or 0)
end

--[[ True when player (or their clan) controls a MinimapReveal territory (Radar Hill). ]]
function TerritoryService.HasRadarReveal(player: Player): boolean
	return TerritoryOwnership.HasRadar(player)
end

function TerritoryService.GetRadarRevealRadius(): number
	return TerritoryConfig.RadarRevealRadius or 220
end

-- F3: the player's total Empire Tax % (EconomyService.EmpireTaxPct), 0 when unknown
local function empireTaxPctOf(player: Player): number
	if _EconomyService and _EconomyService.EmpireTaxPct then
		local ok, pct = pcall(_EconomyService.EmpireTaxPct, player)
		if ok and typeof(pct) == "number" then
			return pct
		end
	end
	return 0
end

-- F3: recount the outpost stacks from profile.Territories (EconomyService.SyncOutpostIncomeStacks, which also writes
-- WE_EmpireTaxPct on change). Returns (oldStacks, newStacks, total Empire Tax %).
local function syncEmpireTax(player: Player): (number, number, number)
	if _EconomyService and _EconomyService.SyncOutpostIncomeStacks then
		local oldStacks, newStacks, _perStack, total = _EconomyService.SyncOutpostIncomeStacks(player)
		local pct = if typeof(total) == "number" then total else empireTaxPctOf(player)
		return tonumber(oldStacks) or 0, tonumber(newStacks) or 0, pct
	end
	return 0, 0, empireTaxPctOf(player)
end

-- F3: a toast from an EconomyConfig.OutpostIncomeBuff template (never errors: a bad template gives the fallback)
local function fmtToast(template: any, fallback: string, ...: any): string
	if typeof(template) ~= "string" then
		return fallback
	end
	local ok, msg = pcall(string.format, template, ...)
	return if ok and typeof(msg) == "string" then msg else fallback
end

--[[ reason: "captured" (stolen by another player), "max_personal" (evicted by the owner's own new capture),
	"leave" (F3 PersistClaims / F10: the owner is leaving the server: the runtime goes Neutral but the profile is NOT
	touched, so the saved claims survive for the next server), "plot" (F10: a Home Outpost whose plot changed hands). ]]
local function releaseOwnership(rt: TerritoryRuntime, reason: string)
	local prevUserId = rt.OwnerUserId
	local prevType = rt.OwnerType
	rt.OwnerType = ownerTypes().Neutral
	rt.OwnerUserId = TerritoryConfig.NeutralOwnerId
	rt.ClanId = nil
	rt.ProtectedUntil = 0
	pushDirty = true

	if prevType == ownerTypes().Player and prevUserId > 0 then
		local prevPlayer = Players:GetPlayerByUserId(prevUserId)
		if prevPlayer and reason ~= "leave" then
			syncProfileOwnership(prevPlayer)
			-- Contested: recount OutpostIncomeStacks from remaining owned zones (SyncOutpostIncomeStacks)
			local _, _, pct = syncEmpireTax(prevPlayer)
			if NotificationService and reason ~= "plot" then
				local zoneName = if rt.Def and rt.Def.DisplayName then rt.Def.DisplayName else "Outpost"
				local buff = EconomyConfig.OutpostIncomeBuff
				-- F3: the TOTAL Empire Tax % left ("Central Plaza taken  Empire Tax +10%")
				local lostToast = if reason == "captured"
					then fmtToast(buff and buff.ToastStolenFromYou, "Outpost lost: " .. zoneName, zoneName, pct)
					else fmtToast(buff and buff.ToastLost, "Outpost lost", pct)
				NotificationService.Notify(prevPlayer, lostToast, "Warn", 4.5)
			end
		end
		if prevPlayer and AnalyticsService then
			AnalyticsService.Log(AnalyticsConfig.Events.TERRITORY_LOST, prevUserId, {
				territory = rt.Id,
				reason = reason,
			})
		end
		if prevPlayer and reason ~= "leave" and BaseService then
			BaseService.PushState(prevPlayer)
		end
	end
	pruneOwnerCache(prevUserId) -- R15: the leaver's colour goes once they own no zone
end

local function awardCapture(player: Player, rt: TerritoryRuntime)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local starter = isStarterRt(rt) -- F10 Home Outpost
	local beforePct = empireTaxPctOf(player)

	-- Enforce max personal territories. F10: a Home Outpost never counts toward the cap and is never evicted.
	-- If already owning this one (re-secure), skip max check
	local alreadyOwns = rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == player.UserId
	if not starter and not alreadyOwns and countPersonalNonStarter(player.UserId) >= TerritoryConfig.MaxPersonalTerritories then
		-- Drop oldest unprotected personal territory
		local oldest: TerritoryRuntime? = nil
		local oldestTime = math.huge
		for _, other in pairs(territories) do
			if other.Id ~= rt.Id and other.OwnerType == ownerTypes().Player and other.OwnerUserId == player.UserId and not isStarterRt(other) then
				if other.ProtectedUntil < oldestTime then
					oldestTime = other.ProtectedUntil
					oldest = other
				end
			end
		end
		if oldest then
			releaseOwnership(oldest, "max_personal")
			updateMarkerVisual(oldest)
		end
	end

	-- Previous owner loses it (v33: mark steal for toast clarity). F10: a Home Outpost is never stolen: a stale owner
	-- (the plot changed hands) just lets go of it, with no steal toast.
	local stoleFromPlayer = false
	if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId ~= player.UserId and rt.OwnerUserId > 0 then
		if starter then
			releaseOwnership(rt, "plot")
		else
			stoleFromPlayer = true
			releaseOwnership(rt, "captured")
		end
	end

	rt.OwnerType = ownerTypes().Player
	rt.OwnerUserId = player.UserId
	rt.ClanId = profile.ClanId
	if ClanWarService and ClanWarService.OnTerritoryCaptured and not starter then
		ClanWarService.OnTerritoryCaptured(player)
	end
	rt.Progress = 0
	rt.CapturingUserId = 0
	rt.Contested = false
	rt.ContesterA = nil
	rt.ContesterB = nil
	rt.ProtectedUntil = nowUnix() + TerritoryConfig.ProtectionPeriodSeconds
	pushDirty = true

	-- F10: the first Home Outpost capture is remembered; later sessions hold it from the start (OnPlotReady)
	if starter and (profile :: any).StarterOutpostTaken ~= true then
		(profile :: any).StarterOutpostTaken = true
	end
	profile.Stats.TerritoriesCaptured += 1
	syncProfileOwnership(player)

	-- F3 Empire Tax: recount from owned zones (stealable by re-capture); the toast names the TOTAL %
	local incomeToastShown = false
	local incomePct = 0
	if _EconomyService and _EconomyService.SyncOutpostIncomeStacks then
		local _, _, total = syncEmpireTax(player)
		if total > beforePct then
			incomePct = total
			incomeToastShown = true
		end
	elseif _EconomyService and _EconomyService.GrantOutpostIncomeStack then
		local granted, _stacks, pct = _EconomyService.GrantOutpostIncomeStack(player)
		if granted and pct > 0 then
			incomePct = pct
			incomeToastShown = true
		end
	end

	if NotificationService then
		local zoneName = rt.Def.DisplayName
		local wasSteal = stoleFromPlayer
		if incomeToastShown then
			-- v33: explicit who gets the +income. F3: "Took Central Plaza  Empire Tax +20%" / "Outpost taken  Empire Tax +10%"
			local buff = EconomyConfig.OutpostIncomeBuff
			local msg = if wasSteal
				then fmtToast(buff and buff.ToastStealGain, "★ SECURED " .. zoneName, zoneName, incomePct)
				else fmtToast(buff and buff.ToastSecured, "★ SECURED " .. zoneName, incomePct)
			NotificationService.Notify(player, msg, "Reward", 5)
		else
			local bonusHint = rt.Def.Description or ""
			if #bonusHint > 60 then
				bonusHint = string.sub(bonusHint, 1, 57) .. "..."
			end
			NotificationService.Notify(
				player,
				string.format("★ SECURED %s! %s", zoneName, bonusHint),
				"Reward",
				5
			)
		end
	end

	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.TERRITORY_CAPTURED, player.UserId, {
			territory = rt.Id,
			total = profile.Stats.TerritoriesCaptured,
		})
		if profile.Stats.TerritoriesCaptured == 1 and not firstOutpostLogged[player.UserId] then
			firstOutpostLogged[player.UserId] = true
			AnalyticsService.Log(AnalyticsConfig.Events.FIRST_OUTPOST, player.UserId, { territory = rt.Id })
		end
	end

	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "CaptureTerritory", 1)
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "CaptureTerritory", rt.Id)
	end

	if BaseService then
		BaseService.PushState(player)
	end

	updateMarkerVisual(rt)
end

local function playersInZone(rt: TerritoryRuntime): { Player }
	return TerritoryCapture.PlayersInZone(rt)
end

local function tickTerritory(rt: TerritoryRuntime, dt: number)
	local inside = playersInZone(rt)
	local ot = ownerTypes()

	if #inside == 0 then
		rt.Contested = false
		rt.ContesterA = nil
		rt.ContesterB = nil
		if rt.Progress > 0 then
			rt.Progress = math.max(0, rt.Progress - TerritoryConfig.ProgressDecayPerSecond * dt)
		end
		if rt.Progress <= 0 then
			rt.CapturingUserId = 0
		end
		updateMarkerVisual(rt)
		return
	end

	-- Contested if 2+ distinct players and not all already the owner
	local unique: { [number]: boolean } = {}
	for _, p in ipairs(inside) do
		unique[p.UserId] = true
	end
	local uniqueCount = 0
	for _ in pairs(unique) do
		uniqueCount += 1
	end

	if uniqueCount >= 2 then
		rt.Contested = true
		-- F6: contesting a zone ends a novice's shield for good (CombatService decides; its EndOnContestedCapture
		-- switch can turn this reason off). Cross-lane call: pcall + nil check.
		if CombatService and CombatService.IsNoviceShielded and CombatService.EndNoviceShield then
			for _, p in ipairs(inside) do
				local okShield, shielded = pcall(CombatService.IsNoviceShielded, p)
				if okShield and shielded == true then
					pcall(CombatService.EndNoviceShield, p, "contest")
				end
			end
		end
		-- v38: remember first two contesting players for dual-color pulse
		do
			local ids: { number } = {}
			for uid in pairs(unique) do
				table.insert(ids, uid)
			end
			table.sort(ids)
			rt.ContesterA = ids[1]
			rt.ContesterB = ids[2]
		end
		rt.OwnerType = if rt.OwnerUserId == TerritoryConfig.NeutralOwnerId then ot.Contested else rt.OwnerType
		-- Contested: ContestedProgressMult scales capture; 0 freezes and applies ContestedDecayMult decay
		local mult = TerritoryConfig.ContestedProgressMult
		if mult <= 0 then
			local decayMult = TerritoryConfig.ContestedDecayMult or 0.5
			rt.Progress = math.max(0, rt.Progress - TerritoryConfig.ProgressDecayPerSecond * decayMult * dt)
		else
			-- Rare path: allow slow contested progress for both (not used at default 0)
			rt.Progress += dt * mult
		end
		updateMarkerVisual(rt)
		return
	end

	rt.Contested = false
	rt.ContesterA = nil
	rt.ContesterB = nil
	local capturer = inside[1]
	-- If capturer already owns it, just refresh presence (no progress needed)
	if rt.OwnerType == ot.Player and rt.OwnerUserId == capturer.UserId then
		rt.CapturingUserId = 0
		rt.Progress = 0
		updateMarkerVisual(rt)
		return
	end

	-- Protection period hook: slower capture while protected
	local rate = 1
	if rt.ProtectedUntil > nowUnix() and rt.OwnerUserId ~= TerritoryConfig.NeutralOwnerId then
		rate = TerritoryConfig.ProtectedCaptureMult
	end

	rt.CapturingUserId = capturer.UserId
	rt.Progress += dt * rate

	if rt.Progress >= rt.Def.CaptureTimeSeconds then
		awardCapture(capturer, rt)
	else
		updateMarkerVisual(rt)
	end
end

--[[
	Optional explicit request — mainly for UI "begin capture" ping; actual progress is proximity-based.
]]
function TerritoryService.BeginCapture(player: Player, territoryId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(territoryId, 48) then
		return false, "InvalidTerritory"
	end
	if not RemoteGuard.RequireProfile(DataService, player) then
		return false, "NoProfile"
	end
	ensureRuntime()
	local rt = territories[territoryId]
	if not rt then
		return false, "UnknownTerritory"
	end
	local inside = playersInZone(rt)
	local present = false
	for _, p in ipairs(inside) do
		if p == player then
			present = true
			break
		end
	end
	if not present then
		if NotificationService then
			NotificationService.Notify(player, "Enter the capture zone first.", "Warn")
		end
		return false, "NotInZone"
	end
	-- (no "Capturing X..." toast per request: the HUD capture bar shows it — spec §4.2)
	TerritoryService.PushPlayer(player)
	return true, nil
end

--[[ Nations B2 (e): redraw every zone this UserId owns or contests (NationColorService calls it after an accepted
	nation pick while NationConfig.OutpostFlags is on). Never yields. ]]
function TerritoryService.RefreshOwnerFlags(userId: number)
	if typeof(userId) ~= "number" then
		return
	end
	for _, rt in pairs(territories) do
		if rt.OwnerUserId == userId or rt.ContesterA == userId or rt.ContesterB == userId then
			updateMarkerVisual(rt)
		end
	end
end

local function persistClaimsOn(): boolean
	local buff = EconomyConfig.OutpostIncomeBuff
	return buff ~= nil and buff.PersistClaims == true
end

--[[ F3 PersistClaims: re-plant the claims this player's last server saved (profile.Territories) before
	syncProfileOwnership rewrites that list from this server's zones. A claim on a Neutral (incl. a neutral zone being
	contested) or NPC-held zone becomes the player's again with the normal protection period; a claim on a zone
	another ONLINE player holds is dropped with the ToastClaimHeld toast; any other claim (clan-held, a leftover
	offline holder, a zone that no longer exists) is dropped silently. Home Outposts are skipped (OnPlotReady holds
	the own one). At most MaxPersonalTerritories are planted. No capture toast, stat, mission or tutorial event. ]]
local function replantClaims(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile or typeof(profile.Territories) ~= "table" then
		return
	end
	local ot = ownerTypes()
	local ids: { string } = {}
	for id, v in pairs(profile.Territories) do
		if typeof(id) == "string" and v == true then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	local owned = countPersonalNonStarter(player.UserId)
	local now = nowUnix()
	local buff = EconomyConfig.OutpostIncomeBuff
	for _, id in ipairs(ids) do
		local rt = territories[id]
		if rt == nil or isStarterRt(rt) then
			continue
		end
		if rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId then
			continue -- still ours on this server
		end
		local free = rt.OwnerUserId == TerritoryConfig.NeutralOwnerId or rt.OwnerType == ot.NPC
		if free and owned < TerritoryConfig.MaxPersonalTerritories then
			rt.OwnerType = ot.Player
			rt.OwnerUserId = player.UserId
			rt.ClanId = profile.ClanId
			rt.Progress = 0
			rt.CapturingUserId = 0
			rt.ProtectedUntil = now + TerritoryConfig.ProtectionPeriodSeconds
			owned += 1
			pushDirty = true
			updateMarkerVisual(rt)
		elseif rt.OwnerType == ot.Player and rt.OwnerUserId > 0 and NotificationService then
			local holder = Players:GetPlayerByUserId(rt.OwnerUserId)
			if holder then
				local zoneName = rt.Def.DisplayName
				NotificationService.Notify(
					player,
					fmtToast(buff and buff.ToastClaimHeld, zoneName .. " is held", zoneName, holder.DisplayName),
					"Warn",
					4.5
				)
			end
		end
	end
end

-- F10: the owner holds their Home Outpost from the start once they have taken it (StarterOutpostTaken). Silent (no
-- capture toast / stat / mission / tutorial event); it adds StarterPct to the Empire Tax (SyncOutpostIncomeStacks).
local function holdStarter(player: Player, rt: TerritoryRuntime, profile: any)
	rt.OwnerType = ownerTypes().Player
	rt.OwnerUserId = player.UserId
	rt.ClanId = profile.ClanId
	rt.Progress = 0
	rt.CapturingUserId = 0
	rt.Contested = false
	rt.ContesterA = nil
	rt.ContesterB = nil
	rt.ProtectedUntil = 0 -- owner-only: nobody else can take it anyway
	pushDirty = true
	syncProfileOwnership(player)
	syncEmpireTax(player)
	if BaseService then
		BaseService.PushState(player)
	end
	updateMarkerVisual(rt)
end

--[[ F10 BaseService.OnPlotReady (listener only): a Home Outpost follows its plot's owner. Another holder of this
	plot's Home Outpost (the plot changed hands) and any Home Outpost this player holds on another plot go back to
	Neutral; then the owner holds their own one if they have taken it before. Idempotent. ]]
local function onPlotReady(player: Player, plotId: number)
	ensureRuntime()
	local uid = player.UserId
	local ot = ownerTypes()
	for _, other in pairs(territories) do
		if isStarterRt(other) and other.OwnerType == ot.Player and other.OwnerUserId == uid and other.Def.PlotId ~= plotId then
			releaseOwnership(other, "plot")
			updateMarkerVisual(other)
		end
	end
	local rt = starterRtForPlot(plotId)
	if rt == nil then
		return -- Starter off (no row) or unknown plot
	end
	if rt.OwnerType == ot.Player and rt.OwnerUserId ~= uid then
		releaseOwnership(rt, "plot")
		updateMarkerVisual(rt)
	end
	local profile = DataService.GetProfile(player)
	if profile and (profile :: any).StarterOutpostTaken == true and not (rt.OwnerType == ot.Player and rt.OwnerUserId == uid) then
		holdStarter(player, rt, profile)
	end
end

--[[ Seed a few territories as NPC-held for contested feel (Studio / empty servers). ]]
local function seedNpcOwners()
	local npcHeld = { "EastArmory", "RadarHill", "CoastalOilAlpha", "CoastalOilBravo" }
	for _, id in ipairs(npcHeld) do
		local rt = territories[id]
		if rt and rt.OwnerType == ownerTypes().Neutral then
			rt.OwnerType = ownerTypes().NPC
			rt.OwnerUserId = TerritoryConfig.NPCOwnerId
			rt.ProtectedUntil = nowUnix() + 30
			updateMarkerVisual(rt)
		end
	end
end

function TerritoryService.Init(deps: { [string]: any })
	ClanWarService = deps.ClanWarService
	DataService = deps.DataService
	_EconomyService = deps.EconomyService
	_XPService = deps.XPService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	RemoteSetup = deps.RemoteSetup
	BaseService = deps.BaseService
	NationColorService = deps.NationColorService
	CombatService = deps.CombatService

	-- F10: OwnerOnly zones (Home Outposts) count only their plot's owner (TerritoryCapture.PlayersInZone)
	if BaseService and BaseService.GetOwnerUserId then
		TerritoryCapture.SetPlotOwnerResolver(function(plotId: number): number?
			return BaseService.GetOwnerUserId(plotId)
		end)
	end

	TerritoryOwnership.Bind({
		territories = territories,
		ownerTypes = ownerTypes,
		DataService = DataService,
	})

	ensureRuntime()
	seedNpcOwners()

	local remote = RemoteSetup.Get(Constants.RemoteNames.RequestCaptureTerritory) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player: Player, territoryId: any)
		if not RateLimitService.Allow(player, "capture_territory", 1, 2) then
			return
		end
		TerritoryService.BeginCapture(player, territoryId)
	end)

	-- Late marker discovery (StudioSetup may run after Bootstrap)
	task.spawn(function()
		for _ = 1, 20 do
			task.wait(1)
			ensureRuntime()
		end
	end)

	DataService.OnProfileLoaded(function(player: Player, _profile: Types.PlayerProfile)
		ensureRuntime()
		-- F3 PersistClaims: the saved claims first (profile.Territories still holds the last server's list)
		if persistClaimsOn() then
			replantClaims(player)
		end
		syncProfileOwnership(player)
		-- recount OutpostIncomeStacks / WE_EmpireTaxPct (EconomyService.SyncOutpostIncomeStacks)
		syncEmpireTax(player)
		TerritoryService.PushPlayer(player)
	end)

	-- F10: a Home Outpost follows its plot's owner (listener only; BaseService is not edited)
	if BaseService and BaseService.OnPlotReady then
		local okHook, errHook = pcall(BaseService.OnPlotReady, onPlotReady)
		if not okHook then
			warn("[TerritoryService] OnPlotReady hook failed:", errHook)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		-- Soft-release (PersistClaims off): keep world ownership so others can contest; clear profile sync only.
		-- F3 PersistClaims on: the leaver's zones go back to Neutral (their saved claims are kept for the next server).
		-- F10: a Home Outpost always goes back to Neutral when its owner leaves.
		local uid = player.UserId
		firstOutpostLogged[uid] = nil
		lastRadarPushAt[player] = nil
		local persist = persistClaimsOn()
		for _, rt in pairs(territories) do
			if rt.OwnerType == ownerTypes().Player and rt.OwnerUserId == uid and (persist or isStarterRt(rt)) then
				releaseOwnership(rt, "leave")
				updateMarkerVisual(rt)
			end
		end
		pruneOwnerCache(uid)
	end)

	-- Capture loop
	task.spawn(function()
		local tickSec = TerritoryConfig.CaptureTickSeconds or 0.5
		while true do
			local dt = tickSec
			task.wait(dt)
			ensureRuntime()
			local anyProgress = false
			for _, rt in pairs(territories) do
				local before = rt.Progress
				local beforeCap = rt.CapturingUserId
				tickTerritory(rt, dt)
				if rt.Progress ~= before or rt.CapturingUserId ~= beforeCap or rt.Contested then
					anyProgress = true
				end
			end
			-- Throttle full pushes; skip when idle and recently pushed
			local now = os.clock()
			if anyProgress or pushDirty or (now - lastPushAt >= 2.0) then
				if now - lastPushAt >= (if anyProgress then 0.5 else 2.0) then
					TerritoryService.PushAll()
					pushDirty = false
				end
			end
			-- lane C2 (F7): while streaming is on, a radar holder's markers move only when a payload lands, so a
			-- holder gets its own every RADAR_STREAM.PushSeconds (one or two players at a time; nothing when off)
			if streamingOn() then
				for _, player in ipairs(Players:GetPlayers()) do
					local last = lastRadarPushAt[player]
					if (last == nil or now - last >= RADAR_STREAM.PushSeconds) and TerritoryService.HasRadarReveal(player) then
						TerritoryService.PushPlayer(player)
					end
				end
			end
		end
	end)

	if RunService:IsStudio() then
		print("[TerritoryService] Initialized", (function()
			local n = 0
			for _ in pairs(TerritoryConfig.Territories) do
				n += 1
			end
			return n
		end)(), "territories")
	end
end

return TerritoryService
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="178">
            <Properties>
              <string name="Name">TerritoryCapture</string>
              <string name="Source"><![CDATA[--!strict
--[[ Capture-zone presence + tick helpers (spatial checks).
	v70 waterways: who counts inside a zone.
	  * Vehicles: only the DRIVER of a vehicle counts (TerritoryConfig.VehiclePassengersCount = false), so a crewed
	    boat or jeep no longer contests its own capture. Passengers neither capture nor contest.
	  * Naval outposts (WaterConfig.NavalOutposts, Presence "BoatOrDeck", the oil rigs): only the driver of a Naval
	    vehicle, or a player on foot standing on the deck / pier top (HumanoidRootPart.Y >= DeckMinY). Waders do not count.
	  * Presence "Any" (SouthDocks) and every other territory: anyone alive in range (drivers included).
	F10 (owner's 11 features, lane W): an OwnerOnly zone (the Home Outposts, TerritoryConfig.Starter rows with PlotId)
	counts ONLY the player who owns that plot on this server (BaseService.GetOwnerUserId(def.PlotId), bound by
	TerritoryService.Init through SetPlotOwnerResolver). Anyone else neither captures nor contests it; with no owner
	(free plot, or no resolver bound) nobody counts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
local WaterConfig = require(Shared.Configs.WaterConfig)

local TerritoryCapture = {}

-- F10: plotId -> the owner's UserId on this server (BaseService.GetOwnerUserId), or nil
local plotOwnerOf: ((number) -> number?)? = nil

--[[ F10: TerritoryService.Init binds BaseService.GetOwnerUserId here (no require cycle, no BaseService dependency). ]]
function TerritoryCapture.SetPlotOwnerResolver(fn: ((number) -> number?)?)
	plotOwnerOf = fn
end

-- F10: the only UserId that counts in an OwnerOnly zone, 0 = nobody; nil = not an OwnerOnly zone (normal rule)
local function ownerOnlyUserId(def: any): number?
	if typeof(def) ~= "table" or def.OwnerOnly ~= true then
		return nil
	end
	local plotId = def.PlotId
	local resolve = plotOwnerOf
	if typeof(plotId) ~= "number" or resolve == nil then
		return 0
	end
	local ok, uid = pcall(resolve, plotId)
	if ok and typeof(uid) == "number" and uid > 0 then
		return uid
	end
	return 0
end

-- v70: the vehicle a humanoid is seated in (a Model carrying VehicleId), and whether that seat is the driver's
local function seatedVehicle(humanoid: Humanoid): (Model?, boolean)
	local seat = humanoid.SeatPart
	if not seat then
		return nil, false
	end
	local model = seat:FindFirstAncestorWhichIsA("Model")
	while model and model:GetAttribute("VehicleId") == nil do
		model = model:FindFirstAncestorWhichIsA("Model")
	end
	if not model then
		return nil, false
	end
	return model, (seat.Name == "DriverSeat" or seat:GetAttribute("WE_DriverSeat") == true)
end

-- v70: presence rule of a naval outpost (nil = normal rule)
local function navalRule(territoryId: any): any
	if WaterConfig.Enabled == false or typeof(territoryId) ~= "string" then
		return nil
	end
	return (WaterConfig.NavalOutposts :: any)[territoryId]
end

-- v70: does this (alive, in-range) player count toward capture / contest?
local function counts(rule: any, root: BasePart, humanoid: Humanoid): boolean
	local vehicle, isDriver = seatedVehicle(humanoid)
	if vehicle and not isDriver and (TerritoryConfig :: any).VehiclePassengersCount ~= true then
		return false -- passengers neither capture nor contest (a boat crew no longer contests its own capture)
	end
	if rule ~= nil and rule.Presence == "BoatOrDeck" then
		if vehicle then
			return isDriver
				and (vehicle:GetAttribute("WE_Category") == "Naval" or vehicle:GetAttribute("WE_DriveMode") == "Boat")
		end
		return root.Position.Y >= (tonumber(rule.DeckMinY) or 24) -- on the deck / top of the pier, not wading
	end
	return true
end

-- Squared-distance presence test (flat XZ) without changing capture rules.
function TerritoryCapture.PlayersInZone(rt: any): { Player }
	local found: { Player } = {}
	local marker = rt.Marker
	local center = if marker then marker.Position else rt.Def.Position
	local radius = rt.Def.Radius
	if marker then
		local half = marker.Size.Magnitude * 0.5
		radius = math.max(radius, half)
	end
	local radiusSq = radius * radius
	local rule = navalRule(rt.Id or (rt.Def and rt.Def.Id))
	local onlyUserId = ownerOnlyUserId(rt.Def)
	if onlyUserId == 0 then
		return found -- F10: an OwnerOnly zone whose plot has no owner here: nobody captures or contests it
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if onlyUserId ~= nil and player.UserId ~= onlyUserId then
			continue -- F10 OwnerOnly: only the plot owner counts
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local dx = root.Position.X - center.X
			local dz = root.Position.Z - center.Z
			if dx * dx + dz * dz <= radiusSq and counts(rule, root, humanoid) then
				table.insert(found, player)
			end
		end
	end
	return found
end

return TerritoryCapture
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="179">
            <Properties>
              <string name="Name">TerritoryOwnership</string>
              <string name="Source"><![CDATA[--!strict
--[[ Ownership sync, bonus aggregation, radar entitlement helpers. ]]

local TerritoryOwnership = {}

export type Bindings = {
	territories: { [string]: any },
	ownerTypes: () -> any,
	DataService: any,
}

local B: Bindings

function TerritoryOwnership.Bind(bindings: Bindings)
	B = bindings
end

function TerritoryOwnership.CountPersonal(userId: number): number
	local n = 0
	local ot = B.ownerTypes()
	for _, rt in pairs(B.territories) do
		if rt.OwnerType == ot.Player and rt.OwnerUserId == userId then
			n += 1
		end
	end
	return n
end

function TerritoryOwnership.SyncProfile(player: Player)
	local profile = B.DataService.GetProfile(player)
	if not profile then
		return
	end
	if typeof(profile.Territories) ~= "table" then
		profile.Territories = {}
	end
	for id in pairs(profile.Territories) do
		profile.Territories[id] = nil
	end
	local ot = B.ownerTypes()
	for id, rt in pairs(B.territories) do
		if rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId then
			profile.Territories[id] = true
		end
	end
	B.DataService.MarkDirty(player)
end

function TerritoryOwnership.BonusesForPlayer(player: Player): { [string]: number }
	local bonuses: { [string]: number } = {}
	local profile = B.DataService and B.DataService.GetProfile(player)
	local clanId = if profile then profile.ClanId else nil
	local ot = B.ownerTypes()
	for _, rt in pairs(B.territories) do
		local owns = (rt.OwnerType == ot.Player and rt.OwnerUserId == player.UserId)
			or (rt.OwnerType == ot.Clan and clanId ~= nil and rt.ClanId == clanId)
		if owns then
			local key = rt.Def.BonusType
			local value = rt.Def.BonusValue
			bonuses[key] = (bonuses[key] or 0) + value
		end
	end
	return bonuses
end

function TerritoryOwnership.HasRadar(player: Player): boolean
	local b = TerritoryOwnership.BonusesForPlayer(player)
	return (b.MinimapReveal or 0) > 0
end

return TerritoryOwnership
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="180">
            <Properties>
              <string name="Name">TerritoryRadar</string>
              <string name="Source"><![CDATA[--!strict
--[[ Radar / minimap reveal helpers + tag-list cache for markers. ]]

local CollectionService = game:GetService("CollectionService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)

local TerritoryRadar = {}

local _cache: { [string]: { at: number, list: { Instance } } } = {}
local TTL = 2.5

function TerritoryRadar.GetTaggedCached(tag: string): { Instance }
	local now = os.clock()
	local entry = _cache[tag]
	if entry and (now - entry.at) < TTL then
		return entry.list
	end
	local list = CollectionService:GetTagged(tag)
	_cache[tag] = { at = now, list = list }
	return list
end

function TerritoryRadar.Invalidate()
	table.clear(_cache)
end

function TerritoryRadar.FindMarker(territoryId: string): BasePart?
	for _, inst in ipairs(TerritoryRadar.GetTaggedCached(Constants.Tags.CaptureZone)) do
		if inst:IsA("BasePart") and inst:GetAttribute("TerritoryId") == territoryId then
			return inst
		end
	end
	for _, inst in ipairs(TerritoryRadar.GetTaggedCached(Constants.Tags.Territory)) do
		if inst:IsA("BasePart") and (inst:GetAttribute("TerritoryId") == territoryId or inst.Name == territoryId) then
			return inst
		end
	end
	return nil
end

function TerritoryRadar.RevealRadius(): number
	return TerritoryConfig.RadarRevealRadius or 220
end

--[[ F10 (owner's 11 features, lane W): is this zone listed for a viewer whose own plot is viewerPlotId? Every zone
	is, except another plot's Home Outpost (TerritoryConfig.Starter row): only its owner can take it, so it never shows
	in anyone else's territory list, radar or tutorial target. A viewer without a plot (nil) sees no Home Outpost. ]]
function TerritoryRadar.ShownTo(def: TerritoryConfig.TerritoryDef?, viewerPlotId: number?): boolean
	if def == nil then
		return false
	end
	if not TerritoryConfig.IsStarterDef(def) then
		return true
	end
	return viewerPlotId ~= nil and def.PlotId == viewerPlotId
end

return TerritoryRadar
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="181">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MVP interactive tutorial (v31 first-2-min), F6 order (the owner's 7 steps; TutorialConfig.OrderVersion 3 with the
	Home Outpost on, 2 with it off):
	claim → Command Center buy → collect cash (a cash drop also counts) → recruit → Barracks buy → Home Outpost → 4x4
	While TerritoryConfig.Starter is off, the last two swap (4x4, then outpost: the 30 s travel rule).
	Server-authoritative step advancement; client shows UI + optional markers. SKIP kept.
	F6 dispatch: a Notify advances the ACTIVE step only, when its TutorialConfig AdvanceOn lists the event type (an
	"Upgrade" also needs detail == the step's PadStructureId). No step index is hard-coded here, so the order lives in
	TutorialConfig alone. A save made in an older order (TutorialOrderVersion) is moved to the first step of this order
	it has not done yet (TutorialConfig.MigrateLegacyStep) when the profile loads, then stamped with OrderVersion.
	The tutorial ending (last step or SKIP) ends the F6 novice shield (CombatService.EndNoviceShield, "tutorial").
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local TutorialConfig = require(Shared.Configs.TutorialConfig)
local GameConfig = require(Shared.Configs.GameConfig)
local DevConfig = require(Shared.Configs.DevConfig)
local MonetizationConfig = require(Shared.Configs.MonetizationConfig)
local TerritoryConfig = require(Shared.Configs.TerritoryConfig)

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)

local TutorialService = {}

local DataService: any = nil
local RemoteSetup: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local MonetizationService: any = nil
local CombatService: any = nil -- F6: EndNoviceShield (batch A lane C API), pcall + nil-check

-- Step 1 (ClaimBase) is the first step in every order; every other step is found through TutorialConfig
local STEP_CLAIM = 1

-- F6: the order the saved TutorialStep index is read in (config; 1 when a build has no OrderVersion)
local function orderVersion(): number
	return tonumber((TutorialConfig :: any).OrderVersion) or 1
end

-- Debounce rapid Notify spam (collector ticks, double hooks) — per step, so a different step's event right
-- after an advance (e.g. CC bought 0.5 s after the dropper step) is never dropped
local lastAdvanceAt: { [number]: number } = {}
local lastAdvanceStep: { [number]: number } = {}
local ADVANCE_COOLDOWN = 0.75

local function tutorialEnabled(): boolean
	if not GameConfig.TutorialEnabled or not TutorialConfig.Enabled then
		return false
	end
	return true
end

local function pushTutorial(player: Player)
	if not DataService then
		return -- v69: before Init
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local remote = RemoteSetup.Get(Constants.RemoteNames.TutorialStateUpdate) :: RemoteEvent
	local stepIndex = profile.TutorialStep
	local stepDef = if not profile.TutorialComplete then TutorialConfig.GetStep(stepIndex) else nil
	remote:FireClient(player, {
		Step = stepIndex,
		Complete = profile.TutorialComplete == true,
		Total = TutorialConfig.StepCount(),
		Id = if stepDef then stepDef.Id else nil,
		Title = if stepDef then stepDef.Title else nil,
		Hint = if stepDef then stepDef.Hint else nil,
		MarkerName = if stepDef then stepDef.MarkerName else nil,
		HighlightHint = if stepDef then stepDef.HighlightHint else nil,
		PadStructureId = if stepDef then stepDef.PadStructureId else nil,
		CtaAction = if stepDef then stepDef.CtaAction else nil,
		CtaLabel = if stepDef then stepDef.CtaLabel else nil,
		Pointer = if stepDef then stepDef.Pointer else nil, -- F5: "ATM" on the collect step (chevrons / GO line)
	})
end

function TutorialService.Push(player: Player)
	pushTutorial(player)
end

--[[ v71 money (M1, plan §2.1 "Pop-up race"; revenue audit F4 / R3): the Commander Starter Pack offer belongs to the
	end of the tutorial, not to the join (it used to fire 8 s after join mid-tutorial and usually lost its slot to the
	Speed Boost pop-up). TutorialService decides WHEN: StarterBundleOffer.AfterTutorialSeconds (3 s) after the tutorial
	completes (the last step done, or SKIP), or StarterBundleOffer.DelaySeconds (8 s) after the profile loads when the
	tutorial is already done. MonetizationService.TrySoftOfferStarterBundle(player, reason) decides WHETHER and sends
	it (live Id, unoffered = profile.StarterBundleOffered, unowned, the soft-offer slot / D8 budget; true = sent,
	nil = not wanted, false = slot busy) down the existing path: the StarterBundleOffer remote → ShopController's
	StarterBundleToast → NotificationController.ShowOffer, so the HUD throttle still decides when the card shows.
	A busy slot is retried STARTER_RETRIES times, one soft-offer cooldown apart. Nothing here grants or prompts.
	F6: the tutorial can now end in a vehicle (the last step is the 4x4 while the Home Outpost is off, and a capture can
	be made from the driver's seat), so an after-tutorial offer first waits until the player is on foot
	(Humanoid.SeatPart == nil): checked every STARTER_SEATED_CHECK_SECONDS (1 Hz) for up to STARTER_SEATED_WAIT_SECONDS
	(300 s) in total, then the gate is called as before (it and the HUD throttle still decide). A player on foot sees
	no change: the first check passes at once. Optional config keys: StarterBundleOffer.SeatedWaitSeconds /
	SeatedCheckSeconds. ]]
local STARTER_AFTER_TUTORIAL_SECONDS = 3
local STARTER_AT_LOAD_SECONDS = 8
local STARTER_RETRIES = 2
local STARTER_SEATED_WAIT_SECONDS = 300
local STARTER_SEATED_CHECK_SECONDS = 1
local starterToken: { [number]: number } = {} -- userId -> the pending offer schedule (one at a time)
local starterSeq = 0

-- F6: sitting in any seat (driving or riding): no offer card while driving (CLAUDE.md: no pop-ups while driving)
local function isSeated(player: Player): boolean
	local char = player.Character
	local hum = if char then char:FindFirstChildOfClass("Humanoid") else nil
	return hum ~= nil and hum.SeatPart ~= nil
end

local function scheduleStarterOffer(player: Player, afterTutorial: boolean)
	local mon = MonetizationService
	if not mon or typeof(mon.TrySoftOfferStarterBundle) ~= "function" or not DataService then
		return
	end
	local def: any = MonetizationConfig.DevProducts.StarterBundle
	local profile = DataService.GetProfile(player)
	if typeof(def) ~= "table" or (tonumber(def.Id) or 0) == 0 or not profile or profile.StarterBundleOffered == true then
		return
	end
	if typeof(profile.Entitlements) == "table" and profile.Entitlements.StarterBundle == true then
		return -- owned (the gate re-checks ownership when it fires; this only skips a pointless timer)
	end
	local uid = player.UserId
	if starterToken[uid] ~= nil then
		return
	end
	starterSeq += 1
	local my = starterSeq
	starterToken[uid] = my
	local cfg: any = (MonetizationConfig :: any).StarterBundleOffer
	local delaySec = if afterTutorial
		then tonumber(cfg and cfg.AfterTutorialSeconds) or STARTER_AFTER_TUTORIAL_SECONDS
		else tonumber(cfg and cfg.DelaySeconds) or STARTER_AT_LOAD_SECONDS
	local cooldown = tonumber((MonetizationConfig :: any).SoftOfferSessionCooldownSeconds) or 60
	local reason = if afterTutorial then "tutorial_complete" else "session"
	-- F6: the seated wait (after the tutorial only); one budget for the whole schedule, retries included
	local seatedLeft = if afterTutorial then math.max(0, tonumber(cfg and cfg.SeatedWaitSeconds) or STARTER_SEATED_WAIT_SECONDS) else 0
	local seatedStep = math.max(0.25, tonumber(cfg and cfg.SeatedCheckSeconds) or STARTER_SEATED_CHECK_SECONDS)
	local function attempt(n: number)
		if starterToken[uid] ~= my then
			return -- left the server
		end
		if seatedLeft > 0 and player.Parent and isSeated(player) then
			seatedLeft -= seatedStep
			task.delay(seatedStep, attempt, n) -- still in a seat: look again in 1 s
			return
		end
		local sent: boolean? = nil
		if player.Parent then
			local ok, res = pcall(mon.TrySoftOfferStarterBundle, player, reason)
			if ok then
				sent = res
			else
				warn("[TutorialService] Starter offer failed:", res)
			end
		end
		if starterToken[uid] ~= my then
			return
		end
		if sent == false and n <= STARTER_RETRIES and player.Parent then
			task.delay(cooldown, attempt, n + 1) -- the soft-offer slot was busy
		else
			starterToken[uid] = nil
		end
	end
	task.delay(delaySec, attempt, 1)
end

--[[ v69: buy steps (PadStructureId) for a structure the player already owns are done — skip them. The HUD goal
	sends new players to buy Command Center early, which then only advanced on ANOTHER CC purchase ($8,000 for L2);
	same for Barracks. Returns the first step that still needs doing.
	F6 / F10: with the Home Outpost on (TerritoryConfig.Starter.Enabled), the Outpost step is done too once the player
	has taken their own Home Outpost (profile.StarterOutpostTaken, set by the first capture): later sessions own it
	from the start, so it could never be captured again for the step, and the next zone is over the 30 s walk.
	Lane Z: a step the save already finished in its old order but the new order puts later (profile.TutorialDoneAhead,
	set by migrateOrder, e.g. the 4x4 of a v2 save that still owes the outpost) is done too. ]]
local function stepAlreadyDone(profile: any, def: TutorialConfig.TutorialStepDef?): boolean
	if def == nil then
		return false
	end
	local ahead = profile.TutorialDoneAhead
	if typeof(ahead) == "table" and ahead[def.Id] == true then
		return true
	end
	local sid = def.PadStructureId
	if typeof(sid) == "string" then
		local upgrades = if typeof(profile.BaseUpgrades) == "table" then profile.BaseUpgrades else {}
		return (tonumber(upgrades[sid]) or 0) >= 1
	end
	if def.Id == "Outpost" then
		return TerritoryConfig.Starter.Enabled == true and profile.StarterOutpostTaken == true
	end
	return false
end

local function skipOwnedBuySteps(profile: any, step: number): number
	local total = TutorialConfig.StepCount()
	while step <= total and stepAlreadyDone(profile, TutorialConfig.GetStep(step)) do
		step += 1
	end
	return step
end

-- F6: the tutorial is over (last step, SKIP, or already done at load): end the novice shield now. CombatService's
-- own 1 Hz sweep also ends it on TutorialComplete; this call makes it immediate. Harmless when no shield is up.
local function endNoviceShield(player: Player)
	if CombatService and typeof(CombatService.EndNoviceShield) == "function" then
		local ok, err = pcall(CombatService.EndNoviceShield, player, "tutorial")
		if not ok then
			warn("[TutorialService] EndNoviceShield failed:", err)
		end
	end
end

local function setStep(player: Player, step: number, complete: boolean?)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.TutorialStep = step
	if complete then
		profile.TutorialComplete = true
	end
	DataService.MarkDirty(player)
	pushTutorial(player)
	if complete and NotificationService then
		NotificationService.Notify(player, "Tutorial complete — BUILD. CONQUER. DOMINATE.", "Success")
	end
	if complete then
		endNoviceShield(player) -- F6
		scheduleStarterOffer(player, true) -- v71 money (M1): the Starter Pack offer 3 s after the tutorial
	end
end

local function advanceTo(player: Player, targetStep: number)
	local profile = DataService.GetProfile(player)
	if not profile or profile.TutorialComplete then
		return
	end
	if profile.TutorialStep < targetStep then
		return
	end
	if profile.TutorialStep ~= targetStep then
		return
	end
	local now = os.clock()
	local last = lastAdvanceAt[player.UserId]
	if last and (now - last) < ADVANCE_COOLDOWN and lastAdvanceStep[player.UserId] == targetStep then
		return
	end
	lastAdvanceAt[player.UserId] = now
	lastAdvanceStep[player.UserId] = targetStep
	-- One setStep (one push): the client drops a second TutorialStateUpdate that lands within 0.2 s
	local nextStep = skipOwnedBuySteps(profile, targetStep + 1)
	if nextStep > TutorialConfig.StepCount() then
		setStep(player, nextStep, true)
	else
		-- Panel update only — no toast spam per step
		setStep(player, nextStep, false)
	end
end

function TutorialService.Complete(player: Player)
	if not DataService then
		return -- v69: before Init
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.TutorialComplete = true
	profile.TutorialStep = TutorialConfig.StepCount() + 1
	DataService.MarkDirty(player)
	pushTutorial(player)
	if NotificationService then
		NotificationService.Notify(player, "Tutorial skipped.", "Info", 2)
	end
	endNoviceShield(player) -- F6: SKIP ends the novice shield too
	scheduleStarterOffer(player, true) -- v71 money (M1): the Starter Pack offer 3 s after the tutorial
end

function TutorialService.Reset(player: Player)
	if not DataService then
		return -- v69: before Init
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	profile.TutorialComplete = false
	profile.TutorialStep = STEP_CLAIM
	profile.TutorialOrderVersion = orderVersion() -- F6: step 1 is the same step in every order
	profile.TutorialDoneAhead = nil -- lane Z: a fresh run owes every step
	DataService.MarkDirty(player)
	pushTutorial(player)
end

--[[
	event types: PlotAssigned | Upgrade | RecruitSoldiers | PassiveIncome | ManualDrop | SpawnVehicle | CaptureTerritory
]]
function TutorialService.Notify(player: Player, eventType: string, detail: any?)
	if not tutorialEnabled() then
		return
	end
	if not DataService then
		-- v69: called before Init (BaseService's join hook used to throw here and skip the kit rehydrate).
		-- Init's OnProfileLoaded replays PlotAssigned for every loaded player.
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile or profile.TutorialComplete then
		return
	end

	local step = profile.TutorialStep
	if step < 1 then
		profile.TutorialStep = STEP_CLAIM
		step = STEP_CLAIM
		DataService.MarkDirty(player)
	end

	-- v69: server full → no plot yet; the claim step waits until a plot is handed out
	if eventType == "PlotAssigned" and profile.BasePlotId == nil then
		return
	end
	-- F6: only the ACTIVE step can finish, and only on an event its AdvanceOn lists ("Upgrade" = its own console buy;
	-- any vehicle spawn = the 4x4 step; a collect or a cash drop ("ManualDrop") = the collect step)
	local def = TutorialConfig.GetStep(step)
	if def and typeof(def.AdvanceOn) == "table" and table.find(def.AdvanceOn, eventType)
		and (eventType ~= "Upgrade" or (typeof(detail) == "string" and detail == def.PadStructureId)) then
		advanceTo(player, step)
	end
end

function TutorialService.Init(deps: { [string]: any })
	DataService = deps.DataService
	RemoteSetup = deps.RemoteSetup
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	MonetizationService = deps.MonetizationService -- v71 money (M1): TrySoftOfferStarterBundle (Starter Pack gate)
	CombatService = deps.CombatService -- F6: EndNoviceShield (CombatService.Init runs later; called only at run time)

	local skipRemote = RemoteSetup.Get(Constants.RemoteNames.RequestSkipTutorial) :: RemoteEvent
	skipRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "tutorial_skip", 1, 2) then
			return
		end
		if not RemoteGuard.RequireProfile(DataService, player) then
			return
		end
		TutorialService.Complete(player)
	end)

	--[[ F6: a TutorialStep saved in another order (TutorialOrderVersion ~= OrderVersion; missing = 1 = the v1 order)
		moves to the first step of this order the player has not done yet (TutorialConfig.MigrateLegacyStep: v1 steps
		2-4 -> Command Center, never past it), then the profile is stamped with this order. A finished tutorial keeps its
		step (only the stamp changes). Lane Z: every known order migrates, in either direction (OrderVersion follows the
		Home Outpost switch: 2 = 4x4 first, 3 = outpost first); a step already done that the new order puts later is kept
		in TutorialDoneAhead (never asked twice). A save from an order this build does not know (a newer build) is left
		alone (never stamped down, so it is never migrated twice). ]]
	local function migrateOrder(player: Player, profile: any)
		local current = orderVersion()
		local saved = tonumber(profile.TutorialOrderVersion) or 1
		if saved == current or TutorialConfig.SavedOrder(saved) == nil then
			return
		end
		if profile.TutorialComplete ~= true then
			local oldStep = profile.TutorialStep
			profile.TutorialStep = TutorialConfig.MigrateLegacyStep(oldStep, nil, saved)
			-- a done step stays done in every order: keep what an earlier migration carried
			local ahead = TutorialConfig.DoneAhead(oldStep, saved) or {}
			if typeof(profile.TutorialDoneAhead) == "table" then
				for id, v in pairs(profile.TutorialDoneAhead) do
					if typeof(id) == "string" and v == true then
						ahead[id] = true
					end
				end
			end
			profile.TutorialDoneAhead = if next(ahead) ~= nil then ahead else nil
		end
		profile.TutorialOrderVersion = current
		DataService.MarkDirty(player)
	end

	local function onProfileLoaded(player: Player, profile: any)
		if not tutorialEnabled() then
			profile.TutorialComplete = true
			pushTutorial(player)
			return
		end
		migrateOrder(player, profile)
		if RunService:IsStudio() and DevConfig.SkipTutorial then
			-- DataService already may have set TutorialComplete
			pushTutorial(player)
			return
		end
		if profile.TutorialComplete then
			pushTutorial(player)
			return
		end
		if typeof(profile.TutorialStep) ~= "number" or profile.TutorialStep < 1 then
			profile.TutorialStep = STEP_CLAIM
			DataService.MarkDirty(player)
		end
		-- v69: saved on a buy step for a structure already owned (bought early / older build) → move on
		local firstOpen = skipOwnedBuySteps(profile, profile.TutorialStep)
		if firstOpen ~= profile.TutorialStep then
			profile.TutorialStep = firstOpen
			if firstOpen > TutorialConfig.StepCount() then
				profile.TutorialComplete = true
			end
			DataService.MarkDirty(player)
		end
		-- F6: a migrated v1 save past the last step (or everything already done) is a finished tutorial
		if profile.TutorialStep > TutorialConfig.StepCount() and profile.TutorialComplete ~= true then
			profile.TutorialComplete = true
			DataService.MarkDirty(player)
		end
		pushTutorial(player)
		if profile.TutorialComplete then
			endNoviceShield(player) -- F6 (no-op unless a shield is already up)
			return
		end
		-- Plot assignment counts as claim-base progress
		task.defer(function()
			if profile.BasePlotId then
				TutorialService.Notify(player, "PlotAssigned")
			end
		end)
	end
	DataService.OnProfileLoaded(function(player: Player, profile: any)
		onProfileLoaded(player, profile)
		-- v71 money (M1): the tutorial is already done at load → the Starter Pack offer 8 s in (the gate decides)
		if profile.TutorialComplete == true then
			scheduleStarterOffer(player, false)
		end
	end)

	-- Upgrade hook
	if deps.BaseService and deps.BaseService.GetUpgradeChangedEvent then
		deps.BaseService.GetUpgradeChangedEvent().Event:Connect(function(userId: number, _plotId: any, structureId: string, level: number)
			if level < 1 then
				return
			end
			local player = Players:GetPlayerByUserId(userId)
			if player then
				TutorialService.Notify(player, "Upgrade", structureId)
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		lastAdvanceAt[player.UserId] = nil
		lastAdvanceStep[player.UserId] = nil
		starterToken[player.UserId] = nil
	end)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="182">
          <Properties>
            <string name="Name">UpgradePadService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SERVER-AUTHORITATIVE walk-over upgrade purchase.

	Primary buy path: Touched on WE_UpgradeSlot plinths + spatial HRP check.
	Validates PlotId == profile.BasePlotId (Studio: teleport home instead of silent fail),
	debounces per player+structure, then BaseService.PurchaseUpgrade.
	Client WorldPromptController FireServer remains secondary (B-menu / backup).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local BaseConfig = require(Shared.Configs.BaseConfig)
local ConsoleBuyConfig = require(Shared.Configs.ConsoleBuyConfig)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local ConsoleLocator = require(Shared.Util.ConsoleLocator)

local UpgradePadService = {}

local DataService: any = nil
local BaseService: any = nil
local NotificationService: any = nil
local RateLimitService: any = nil
local RemoteSetup: any = nil

-- v65: never index nil DataService
local function getDataService(): any
	if DataService ~= nil then
		return DataService
	end
	local ok, mod = pcall(require, script.Parent.DataService)
	if ok and mod ~= nil then
		DataService = mod
		warn("[UpgradePad] getDataService: recovered via require(script.Parent.DataService)")
		return DataService
	end
	warn("[UpgradePad] getDataService: DataService still nil after require fallback")
	return nil
end

local TAG = Constants.Tags.UpgradeSlot
local DEBOUNCE_SEC = 1.0
local OVERLAP_MARGIN = 4.0 -- wide AABB so kits / edges never miss
local SPATIAL_INTERVAL = 0.2

local lastAttempt: { [string]: number } = {}
local attached: { [BasePart]: boolean } = {}
local partConns: { [BasePart]: { RBXScriptConnection } } = {}
local lastOverlap: { [string]: boolean } = {}

local function attemptKey(userId: number, structureId: string): string
	return tostring(userId) .. "|" .. structureId
end

local function padKey(part: BasePart, structureId: string): string
	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" then
		return tostring(pid) .. "|" .. structureId
	end
	return structureId
end

local function trackConn(part: BasePart, conn: RBXScriptConnection)
	local list = partConns[part]
	if not list then
		list = {}
		partConns[part] = list
	end
	table.insert(list, conn)
end

local function detach(part: BasePart)
	local list = partConns[part]
	if list then
		for _, c in ipairs(list) do
			c:Disconnect()
		end
		partConns[part] = nil
	end
	attached[part] = nil
end

-- v68: consoles (BaseLayoutConfig) are bought by prompt / BUY tap only — never by walking into them
local function isConsole(part: BasePart): boolean
	return part:GetAttribute("WE_Console") == true
end

local function hardenPad(part: BasePart)
	part.CanTouch = not isConsole(part)
	part.CanCollide = true
	part.CanQuery = true
	for _, child in ipairs(part:GetDescendants()) do
		if child:IsA("BasePart") then
			child.CanTouch = false
			child.CanQuery = false
		end
	end
end

local function pointInPad(hrpPos: Vector3, part: BasePart): boolean
	local localPos = part.CFrame:PointToObjectSpace(hrpPos)
	local half = part.Size * 0.5
	return math.abs(localPos.X) <= half.X + OVERLAP_MARGIN
		and math.abs(localPos.Z) <= half.Z + OVERLAP_MARGIN
		and localPos.Y >= -half.Y - 4
		and localPos.Y <= half.Y + 12
end

local function isSeated(character: Model): boolean
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local seat = hum.SeatPart
	if seat == nil then
		return false
	end
	return seat:IsA("VehicleSeat") or seat:IsA("Seat")
end

local function flashPad(part: BasePart)
	local original = part.Color
	local originalMat = part.Material
	part.Color = Color3.fromRGB(80, 255, 120)
	part.Material = Enum.Material.Neon
	task.delay(0.35, function()
		if part.Parent then
			part.Color = original
			part.Material = originalMat
		end
	end)
end

local function firePurchaseResult(player: Player, structureId: string, result: any)
	-- v63: prefer BaseService.AckBuyResult (attributes + PurchaseResult) so client never times out
	if BaseService and BaseService.AckBuyResult then
		pcall(function()
			BaseService.AckBuyResult(player, structureId, result)
		end)
		return
	end
	pcall(function()
		if not RemoteSetup then
			return
		end
		local ev = RemoteSetup.Get(Constants.RemoteNames.PurchaseResult)
		if ev and ev:IsA("RemoteEvent") then
			(ev :: RemoteEvent):FireClient(player, {
				Ok = result.Ok == true,
				Error = result.Error,
				StructureId = structureId,
				NewLevel = result.NewLevel,
				Cash = result.Cash,
			})
		end
	end)
end

local function notifyPurchaseResult(player: Player, structureId: string, result: any, fromStanding: boolean?)
	firePurchaseResult(player, structureId, result)
	if not NotificationService then
		warn("[UpgradePad] NotificationService nil — toast skipped for", structureId, result.Error)
		return
	end
	local def = BaseConfig.Structures[structureId]
	if result.Ok then
		local name = if def then def.DisplayName else tostring(structureId)
		-- v72: "  +$3.3/s" suffix while the tycoon guide is on (BaseService.PurchaseToastSuffix; "" otherwise)
		local suffix = ""
		if BaseService and BaseService.PurchaseToastSuffix then
			local okS, s = pcall(BaseService.PurchaseToastSuffix, player, structureId, result.NewLevel or 0)
			if okS and typeof(s) == "string" then
				suffix = s
			end
		end
		-- "%s Lv %d": FredokaOne has no "→" (HUD v70 spec §4.2 / risk #5)
		NotificationService.Notify(
			player,
			string.format("Purchase SUCCESSFUL! %s Lv %d", name, result.NewLevel or 0) .. suffix,
			"Success",
			4
		)
	else
		-- v71 (HUD v70 spec §4.1 / §4.2): one failed purchase = one line — the client words every PurchaseResult
		-- error itself (WorldPromptController), so the server only adds what the client cannot see.
		local err = result.Error or "Failed"
		local msg: string? = if err == "NoProfile"
			then "Profile still loading — try BUY again"
			elseif err == "RateLimited"
			then "Buying too fast — wait a moment"
			else nil
		if msg then
			-- Standing on pad must NOT spam every spatial tick (~0.85–1.2s cooldown)
			local cd = if fromStanding then 1.1 else 0.75
			local key = "pad|" .. err .. "|" .. structureId
			if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, msg, "Warn", 3.5, cd, key)
			else
				NotificationService.Notify(player, msg, "Warn", 3.5)
			end
		end
	end
end

local function tryServerPurchase(player: Player, part: BasePart, structureId: string, fromStanding: boolean?)
	local DS = getDataService()
	if not DS then
		print(string.format("[UpgradePad] BUY FAIL %s %s — NoDataService", player.Name, structureId))
		-- the client words this failure from PurchaseResult (one failed purchase = one line)
		firePurchaseResult(player, structureId, { Ok = false, Error = "NoDataService" })
		return
	end
	local profile = DS.GetProfile(player)
	if not profile and DS.EnsureProfile then
		profile = DS.EnsureProfile(player)
	end
	if not profile then
		print(string.format("[UpgradePad] BUY FAIL %s %s — NoProfile", player.Name, structureId))
		firePurchaseResult(player, structureId, { Ok = false, Error = "NoProfile" })
		if NotificationService then
			if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, "Profile still loading — try BUY again", "Warn", 3, 2.5, "pad|NoProfile")
			else
				NotificationService.Notify(player, "Profile still loading — try BUY again", "Warn", 3)
			end
		end
		return
	end

	-- Assign a plot if this player has none yet. v68: never fall back to plot 1 — that handed a 7th+ player
	-- another player's base. With no free plot, BaseService.PurchaseUpgrade answers NoPlot (with a toast).
	if profile.BasePlotId == nil then
		if BaseService and BaseService.AssignPlot then
			pcall(function()
				BaseService.AssignPlot(player)
			end)
			profile = getDataService().GetProfile(player) or profile
		end
	end

	local pid = part:GetAttribute("PlotId")
	if typeof(pid) == "number" and profile.BasePlotId ~= nil and pid ~= profile.BasePlotId then
		local key = attemptKey(player.UserId, structureId)
		local now = os.clock()
		local last = lastAttempt[key] or 0
		if now - last >= DEBOUNCE_SEC then
			lastAttempt[key] = now
			-- Always teleport + toast so WrongPlot never silent-fails (esp. Studio)
			if BaseService and BaseService.TeleportToPlot then
				BaseService.TeleportToPlot(player)
			end
			print(string.format("[UpgradePad] WrongPlot %s tried plot=%s own=%s → teleport", player.Name, tostring(pid), tostring(profile.BasePlotId)))
			if NotificationService then
				if NotificationService.NotifyThrottled then
				NotificationService.NotifyThrottled(player, "Not your base — teleported to YOUR plot", "Warn", 2.5, 1.2, "wrongplot")
			else
				NotificationService.Notify(player, "Not your base — teleported to YOUR plot", "Warn", 2.5)
			end
			end
		end
		return
	end

	local key = attemptKey(player.UserId, structureId)
	local now = os.clock()
	local last = lastAttempt[key] or 0
	if now - last < DEBOUNCE_SEC then
		return
	end

	-- v64: never index nil BaseUpgrades
	if typeof(profile.BaseUpgrades) ~= "table" then
		profile.BaseUpgrades = {}
	end
	if typeof(profile.Stats) ~= "table" then
		profile.Stats = { UpgradesPurchased = 0 }
	end
	local def = BaseConfig.Structures[structureId]
	local current = tonumber(profile.BaseUpgrades[structureId]) or 0
	if def and current >= def.MaxLevel then
		lastAttempt[key] = now
		if not fromStanding then
			notifyPurchaseResult(player, structureId, { Ok = false, Error = "MaxLevel" })
		end
		return
	end

	lastAttempt[key] = now

	if RateLimitService and not RateLimitService.Allow(player, "purchase_upgrade", 6, 8) then
		print(string.format("[UpgradePad] BUY RATE-LIMIT %s %s", player.Name, structureId))
		if NotificationService and not fromStanding then
			NotificationService.Notify(player, "Buying too fast — wait a moment", "Warn", 2.5)
		end
		return
	end

	print(string.format("[UpgradePad] BUY ATTEMPT %s %s plot=%s standing=%s", player.Name, structureId, tostring(profile.BasePlotId), tostring(fromStanding == true)))
	-- v64: pcall so pad path never throws past ack (same ServerError surface as remote)
	local callOk, callResult = pcall(function()
		-- v71: AtPart = this console / pad, so the server checks the character against the part that was used
		return BaseService.PurchaseUpgrade(player, structureId, { AtPart = part, Source = if isConsole(part) then "Prompt" else "Pad" })
	end)
	local result: any
	if not callOk then
		local errStr = tostring(callResult or "unknown")
		if #errStr > 180 then
			errStr = string.sub(errStr, 1, 180)
		end
		warn("[UpgradePad] PurchaseUpgrade threw:", errStr)
		pcall(function()
			player:SetAttribute("WE_BuyErr", errStr)
		end)
		result = { Ok = false, Error = "ServerError" }
	else
		result = callResult
	end
	if result.Ok then
		print(string.format("[UpgradePad] BUY OK %s %s → Lv %s", player.Name, structureId, tostring(result.NewLevel)))
	else
		print(string.format("[UpgradePad] BUY FAIL %s %s → %s", player.Name, structureId, tostring(result.Error)))
	end
	notifyPurchaseResult(player, structureId, result, fromStanding)
	if result.Ok then
		flashPad(part)
	end
end

local function onPadTouched(part: BasePart, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end
	if isSeated(character) then
		return
	end
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end
	local key = padKey(part, structureId) .. "|" .. tostring(player.UserId)
	if lastOverlap[key] then
		return
	end
	lastOverlap[key] = true
	tryServerPurchase(player, part, structureId, false)
end

-- fb2: the Helipad console screen carries one fixed line, "HELIS AT LV 10" (the lowest player level of a helicopter
-- that needs only the Helipad; VehicleConfig). There is no parked helicopter on the pad any more, so this says when
-- one comes. No new SurfaceGui: the line is a TextLabel inside MapSetup's existing WE_ConsoleScreen, parented under
-- that screen's own label. WorldPromptController rewrites the screen's first TextLabel per viewer (name / price /
-- MAX) and never finds this one, so the line stays for every viewer. The screen's label gives up its bottom strip.
local HELI_NOTE_NAME = "WE_HeliNote"
local HELI_NOTE_SHARE = 0.28 -- share of the screen height for the line (the other lines keep 0.72)

local function firstHeliLevel(): number
	local best: number? = nil
	for _, def in pairs(VehicleConfig.Vehicles) do
		local req = def.RequiresStructure
		if def.Category == "Air" and req ~= nil and req.StructureId == "Helipad" and def.RequiresPrestige == nil and def.RequiresRebirthFlag == nil then
			if best == nil or def.UnlockLevel < best then
				best = def.UnlockLevel
			end
		end
	end
	return best or 10
end
local HELI_NOTE_TEXT = string.format("HELIS AT LV %d", firstHeliLevel())

-- true once the line is on the screen (or already was); false while MapSetup has not dressed the console yet
local function addHeliNote(part: BasePart): boolean
	local screen = part:FindFirstChild("ConsoleScreen")
	local sg = screen and screen:FindFirstChild("WE_ConsoleScreen")
	local lbl = sg and sg:FindFirstChildWhichIsA("TextLabel")
	if not lbl or not lbl:IsA("TextLabel") then
		return false
	end
	if lbl:FindFirstChild(HELI_NOTE_NAME) then
		return true
	end
	lbl.Size = UDim2.fromScale(1, 1 - HELI_NOTE_SHARE)
	local note = Instance.new("TextLabel")
	note.Name = HELI_NOTE_NAME
	-- below the shrunk label (a child may draw outside its parent; ClipsDescendants is off)
	note.Position = UDim2.fromScale(0, 1)
	note.Size = UDim2.fromScale(1, HELI_NOTE_SHARE / (1 - HELI_NOTE_SHARE))
	note.BackgroundColor3 = lbl.BackgroundColor3
	note.BorderSizePixel = 0
	note.Font = lbl.Font
	note.TextScaled = true
	note.TextColor3 = Color3.fromRGB(255, 214, 96) -- amber: an unlock hint, apart from the green name / price
	note.Text = HELI_NOTE_TEXT
	note.Parent = lbl
	return true
end

local function attachSlot(part: BasePart)
	if attached[part] then
		hardenPad(part)
		return
	end
	if not part:IsA("BasePart") then
		return
	end
	local structureId = part:GetAttribute("StructureId")
	if typeof(structureId) ~= "string" then
		return
	end

	attached[part] = true
	hardenPad(part)

	local console = isConsole(part)
	trackConn(part, part.Touched:Connect(function(hit)
		if not console and hit:IsA("BasePart") then
			onPadTouched(part, hit)
		end
	end))

	trackConn(part, part.TouchEnded:Connect(function(hit)
		if not hit:IsA("BasePart") then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		if not character then
			return
		end
		local player = Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local sid = part:GetAttribute("StructureId")
		if typeof(sid) ~= "string" then
			return
		end
		local key = padKey(part, sid) .. "|" .. tostring(player.UserId)
		task.defer(function()
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and pointInPad(hrp.Position, part) then
				return
			end
			lastOverlap[key] = false
		end)
	end))

	trackConn(part, part.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			detach(part)
		end
	end))

	-- v62 nuclear backup: server ProximityPrompt.Triggered (no client remotes)
	local existingPrompt = part:FindFirstChild("WE_ServerBuyPrompt")
	if existingPrompt then
		existingPrompt:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WE_ServerBuyPrompt"
	prompt.ActionText = if console then "Build / Upgrade" else "Buy"
	local def = BaseConfig.Structures[structureId]
	prompt.ObjectText = if def then def.DisplayName else structureId
	-- v68: consoles need a short hold so walking past never buys
	prompt.HoldDuration = if console then ConsoleBuyConfig.ConsoleHoldSeconds else ConsoleBuyConfig.PadHoldSeconds
	prompt.MaxActivationDistance = if console then ConsoleBuyConfig.ConsolePromptDistance else ConsoleBuyConfig.PadPromptDistance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = part
	-- MapSetup tags the slot before it dresses the console, so the screen may not exist yet
	if console and structureId == "Helipad" and not addHeliNote(part) then
		trackConn(part, part.ChildAdded:Connect(function(child)
			if child.Name == "ConsoleScreen" then
				task.defer(addHeliNote, part)
			end
		end))
	end
	trackConn(part, prompt.Triggered:Connect(function(who: Player)
		local character = who.Character
		if character and isSeated(character) then
			return
		end
		print(string.format("[UpgradePad] ProximityPrompt BUY %s %s", who.Name, structureId))
		tryServerPurchase(who, part, structureId, false)
	end))
end

local function countAttached(): number
	local n = 0
	for part in pairs(attached) do
		if part.Parent then
			n += 1
		end
	end
	return n
end

local function scanAndTagFromSetup(): number
	local setup = Workspace:FindFirstChild("WarEmpireSetup")
	local retagged = 0
	local function consider(desc: Instance)
		if not desc:IsA("BasePart") then
			return
		end
		local sid = desc:GetAttribute("StructureId")
		local pid = desc:GetAttribute("PlotId")
		if typeof(sid) == "string" and typeof(pid) == "number" then
			if not CollectionService:HasTag(desc, TAG) then
				CollectionService:AddTag(desc, TAG)
			end
			hardenPad(desc)
			attachSlot(desc)
			retagged += 1
		end
	end
	if setup then
		local bases = setup:FindFirstChild("Bases")
		if bases then
			for _, desc in ipairs(bases:GetDescendants()) do
				consider(desc)
			end
		end
	end
	return retagged
end

-- v63: nuclear Workspace sweep — any BasePart with StructureId (+ optional PlotId)
local function scanEntireWorkspaceForStructureId(): number
	local n = 0
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BasePart") then
			local sid = desc:GetAttribute("StructureId")
			if typeof(sid) == "string" and sid ~= "" then
				local pid = desc:GetAttribute("PlotId")
				if typeof(pid) ~= "number" then
					-- default PlotId=1 so first player can buy CommandCenter even without tag
					desc:SetAttribute("PlotId", 1)
					pid = 1
				end
				if not CollectionService:HasTag(desc, TAG) then
					CollectionService:AddTag(desc, TAG)
				end
				hardenPad(desc)
				attachSlot(desc)
				n += 1
			end
		end
	end
	return n
end

local function bindExistingAndFuture()
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
		if inst:IsA("BasePart") then
			attachSlot(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			attachSlot(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		if inst:IsA("BasePart") then
			detach(inst)
		end
	end)
end

local function startSpatialLoop()
	local acc = 0
	local rescanAcc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		rescanAcc += dt
		-- v63: if zero pads, re-sweep Workspace every 5s
		if rescanAcc >= 5 then
			rescanAcc = 0
			if countAttached() == 0 then
				scanAndTagFromSetup()
				if countAttached() == 0 then
					scanEntireWorkspaceForStructureId()
				end
			end
		end
		if acc < SPATIAL_INTERVAL then
			return
		end
		acc = 0

		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if character then
				if isSeated(character) then
					local uid = tostring(player.UserId)
					local suffix = "|" .. uid
					for key in pairs(lastOverlap) do
						if string.sub(key, -#suffix) == suffix then
							lastOverlap[key] = false
						end
					end
				else
					local hrp = character:FindFirstChild("HumanoidRootPart")
					if hrp and hrp:IsA("BasePart") then
						local pos = hrp.Position
						for part in pairs(attached) do
							if part.Parent and not isConsole(part) then
								local structureId = part:GetAttribute("StructureId")
								if typeof(structureId) == "string" then
									local key = padKey(part, structureId) .. "|" .. tostring(player.UserId)
									local inside = pointInPad(pos, part)
									if inside then
										if not lastOverlap[key] then
											lastOverlap[key] = true
											tryServerPurchase(player, part, structureId, false)
										else
											tryServerPurchase(player, part, structureId, true)
										end
									elseif lastOverlap[key] then
										lastOverlap[key] = false
									end
								end
							end
						end
					end
				end
			end
		end
	end)
end

function UpgradePadService.Init(deps: { [string]: any })
	assert(deps.DataService, "UpgradePadService.Init missing deps.DataService")
	DataService = deps.DataService
	BaseService = deps.BaseService
	NotificationService = deps.NotificationService
	RateLimitService = deps.RateLimitService
	RemoteSetup = deps.RemoteSetup

	bindExistingAndFuture()
	local initCount = countAttached()
	print(string.format("[WAR EMPIRE] UpgradePadService Init: attached=%d tagged=%d", initCount, #CollectionService:GetTagged(TAG)))
	if initCount == 0 then
		local scanned = scanAndTagFromSetup()
		print(string.format("[WAR EMPIRE] UpgradePadService: scanned Bases → attached=%d", scanned))
		if countAttached() == 0 then
			local swept = scanEntireWorkspaceForStructureId()
			warn(string.format("[WAR EMPIRE] UpgradePadService: Init Workspace StructureId sweep attached=%d", swept))
		end
	end

	startSpatialLoop()

	-- v71: stamp each console's world position on its owner (WE_ConsolePos_<StructureId>) so the Base panel GO
	-- waypoint still finds it when StreamingEnabled has streamed the console out on that client. A missing console
	-- means that structure cannot be bought on this plot (console-only buying): say so loudly, once per plot ready.
	if BaseService and BaseService.OnPlotReady then
		BaseService.OnPlotReady(function(player: Player, plotId: number)
			local missing: { string } = {}
			for _, sid in ipairs(BaseConfig.StructureOrder) do
				local part = ConsoleLocator.Find(plotId, sid)
				player:SetAttribute("WE_ConsolePos_" .. sid, if part then part.Position else nil)
				if part == nil then
					table.insert(missing, sid)
				end
			end
			if #missing > 0 then
				warn(string.format("[UpgradePad] plot %d has NO buy point for %s — unbuyable until the map rebuilds", plotId, table.concat(missing, ", ")))
			end
		end)
	end

	task.defer(function()
		task.wait(1)
		for _, inst in ipairs(CollectionService:GetTagged(TAG)) do
			if inst:IsA("BasePart") then
				attachSlot(inst)
			end
		end
		local after = countAttached()
		print(string.format("[WAR EMPIRE] UpgradePadService after-map: attached=%d", after))
		if after == 0 then
			local scanned = scanAndTagFromSetup()
			warn(string.format("[WAR EMPIRE] UpgradePadService: ZERO pads after map — Bases scan attached=%d", scanned))
			if countAttached() == 0 then
				local swept = scanEntireWorkspaceForStructureId()
				warn(string.format("[WAR EMPIRE] UpgradePadService: Workspace StructureId sweep attached=%d", swept))
			end
		end
	end)

	print("[WAR EMPIRE] UpgradePadService ready (server walk-over buy, margin=" .. tostring(OVERLAP_MARGIN) .. ")")
end

return UpgradePadService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="183">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Phase 4/7 — Vehicles & garage (server-authoritative).
	Validates ownership, level, structure, prestige/rebirth flags, cash, cooldown.
	Spawns Part kits by VehicleDef.KitFamily (scalable to 100+).
	Visual kits v2: multi-part silhouettes (cabin/wheels/turret/lights/exhaust; air rotors+disc; naval wake).
	Optional MeshAssetId reserved for future MeshPart swap (0 = Part kit).

	v70 driving (cars, helicopters, planes, boats). Spec: scratchpad vehicles/spec.md.
	  * The DRIVER'S CLIENT simulates: VehicleDriveClient turns input into a target velocity and
	    orientation every frame and writes the two movers this service builds on the Chassis
	    (WE_DriveLV LinearVelocity PerAxis, WE_DriveAO AlignOrientation OneAttachment).
	  * This service builds the vehicle unparented, chooses a spawn from its footprint (helipad deck,
	    runway, dock basin / sea, pads), hands network ownership to the owner when they sit, runs the
	    idle laws (10 Hz) for parked / abandoned vehicles, a Car/Boat fallback copy of the client law
	    (startGroundDrive) when the client module never says Hello, and 5 Hz checks (speed, altitude,
	    teleport, bounds, boats over WE_Water). A violation takes ownership back and puts the vehicle
	    at its last valid position; repeated hard violations recall it (one AntiExploit strike).
	  * The server never accepts positions or velocities from the client: VehicleDriveInput only
	    carries {K="Hello"|"Bye", V=<VehicleId>, P=<protocol>}, the input stream {K="In", V, T, S, L}
	    (clamped to [-1, 1]), {K="Stuck", V, ...} and {K="Exit", V}.
	  * Judge fix (jeep "doesn't drive"): whoever simulates owns every assembly (chassis + each hinge wheel).
	    A watchdog proves in each sit that the client-simulated car really moves while the driver pushes;
	    if not, the server takes ownership and drives it from the input stream (Car/Boat), logs one
	    NO-DRIVE line, and debug users (Drive.Debug) get a WE_Diag attribute + periodic server lines.
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared.Constants)
local VehicleConfig = require(Shared.Configs.VehicleConfig)
local AnalyticsConfig = require(Shared.Configs.AnalyticsConfig)
local BaseConfig = require(Shared.Configs.BaseConfig)
local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)

type VehicleDef = VehicleConfig.VehicleDef

local RemoteGuard = require(script.Parent.Parent.Modules.RemoteGuard)
local VisualAssetService = require(script.Parent.VisualAssetService)

local VehicleService = {}
-- W2 (CC-2): vehicle HP for every vehicle. A module-table field, not a local (this file sits at Luau's 200-register
-- limit for module locals).
VehicleService._VehicleHealth = require(script.Parent.Parent.Modules.VehicleHealth)
-- streaming2 S3 (F8): pre-fetches a far seat's area before the auto-sit move (RequestSpawn). A no-op while
-- Workspace.StreamingEnabled is false. A module-table field for the same register-limit reason.
VehicleService._StreamPrefetch = require(script.Parent.Parent.Modules.StreamPrefetch)

local Drive = VehicleConfig.Drive
local CarCfg = Drive.Modes.Car
local HeliCfg = Drive.Modes.Heli
local PlaneCfg = Drive.Modes.Plane
local BoatCfg = Drive.Modes.Boat
local Valid = Drive.Validation
local WaterCfg = Drive.Water
local SpawnCfg = Drive.Spawn
local ResyncCfg = Drive.Resync
local W = Drive.Watchdog
local DBG = Drive.Debug

--[[ JEEP-2: the World v2 air box for the Heli / Plane checks — the SAME table the client's turn-back law reads
	(VehicleConfig.Drive.AirBox.Box = WorldConfig.Bounds.Air). Returns (nil, slack) when disabled or WorldConfig is
	missing → the old WorldHalfExtent square and WE_MaxAltitude ceiling. A module-table field, not a local: this file
	sits at Luau's 200-register limit for module locals. ]]
function VehicleService._AirBox(): ({ X: number, ZMin: number, ZMax: number, MaxY: number }?, number)
	local cfg: any = (Drive :: any).AirBox
	local b: any = if typeof(cfg) == "table" and cfg.Enabled ~= false then cfg.Box else nil
	if
		typeof(b) == "table"
		and typeof(b.X) == "number"
		and typeof(b.ZMin) == "number"
		and typeof(b.ZMax) == "number"
		and typeof(b.MaxY) == "number"
	then
		return b, if typeof(cfg.ValidatorSlack) == "number" then cfg.ValidatorSlack else 60
	end
	return nil, 60
end

local debugUserSet: { [number]: boolean } = {}
for _, uid in ipairs(DBG.UserIds) do
	debugUserSet[uid] = true
end
local function isDebugUser(userId: number): boolean
	return DBG.All == true or debugUserSet[userId] == true
end

-- ── Types (law protocol shared with VehicleDriveClient; see spec §2) ─────────────────────────────
export type DriveInput = { Throttle: number, Steer: number, Lift: number, Strafe: number }
export type DriveSense = {
	Position: Vector3,
	Velocity: Vector3,
	Yaw: number,
	UpY: number,
	AGL: number,
	WaterY: number?,
	WaterNear: boolean?,
	WaterFar: boolean?,
	Time: number,
	Clear: boolean?, -- rollover fix: false = another player is within reach of this flipped car (no righting); nil = clear
}
export type DriveHud = { Speed: number, Alt: number?, Throttle: number?, Tag: string? }
-- Righting: flip recovery is lifting / levelling the car (WE_DriveAO.MaxAngularVelocity = Car.RecoverSpin meanwhile)
export type DriveOut = { Velocity: Vector3, HoldVertical: boolean, Orientation: CFrame, Hud: DriveHud, Righting: boolean? }
export type DriveParams = {
	MaxSpeed: number,
	Accel: number,
	TurnRate: number,
	Tracked: boolean,
	RideOffset: number,
	HalfLength: number,
}
export type DriveState = {
	Speed: number,
	Heading: number,
	Age: number,
	SlowFor: number,
	FlipFor: number,
	HopLeft: number, -- flip recovery: seconds left of the current righting (0 = none)
	BobT: number,
	LastWaterPos: Vector3?,
	LastWaterY: number?,
	-- flip recovery (VehicleService._FlipRecover; created on first use)
	RightFrom: Vector3?,
	RightDown: number?,
	RightCool: number?,
	RightClock: number?,
	RightTimes: { number }?,
}
export type IdleState = {
	GlideSpeed: number?,
	Dir: Vector3?,
	Speed: number?,
	LastWaterPos: Vector3?,
	LastWaterY: number?,
	ReturnPos: Vector3?,
	-- flip recovery for an empty car (the Car idle law)
	FlipFor: number?,
	HopLeft: number?,
	RightFrom: Vector3?,
	RightDown: number?,
	RightCool: number?,
	RightClock: number?,
	RightTimes: { number }?,
}
export type Footprint = { HalfX: number, HalfZ: number, Clearance: number, Top: number }
export type SpawnPad = { Pos: Vector3, CFrame: CFrame, Size: Vector3, Naval: boolean }
export type OccupiedSpot = { Pos: Vector3, Radius: number }
export type SpawnCtx = {
	Mode: string,
	PlayerPos: Vector3?,
	PlayerLook: Vector3?,
	PlotPos: Vector3?,
	PlotCFrame: CFrame?, -- the plot pad's CFrame (carries the plot yaw; nil → CFrame.new(PlotPos))
	PlotId: number?,
	Structures: { [string]: number },
	Footprint: Footprint,
	TakeoffSpeed: number?,
	VehiclePads: { SpawnPad },
	NavalPads: { SpawnPad },
	WaterParts: { BasePart },
	Occupied: { OccupiedSpot },
	SurfaceY: ((x: number, z: number, refY: number) -> number?)?,
	LandProbe: ((x: number, z: number, top: number) -> boolean)?,
	BoxFree: ((cf: CFrame, half: Vector3) -> boolean)?,
	-- Mobile P1-9: the player has a plot and stands outside it → SPAWN tries in front of the player first
	AwayFromHome: boolean?,
	-- P1-9 (verifier): every WE_Water part (WaterParts drops other plots' basin / gate water: not boat water for this
	-- player, but still water for a car), and a line-of-sight test (true = nothing solid between the two points)
	AllWater: { BasePart }?,
	Clear: ((from: Vector3, to: Vector3) -> boolean)?,
}
export type SpawnChoice = { CFrame: CFrame, Source: string, State: string, Speed: number }
export type ValidSample = { Pos: Vector3, Vel: Vector3, T: number, WaterY: number?, CFrame: CFrame? }

type ValidPoint = { CFrame: CFrame, Pos: Vector3, T: number }
type VehicleRec = {
	Model: Model,
	Owner: Player,
	OwnerUserId: number,
	Def: VehicleDef,
	Mode: string,
	Chassis: BasePart,
	Seat: VehicleSeat,
	Passengers: { Seat },
	LV: LinearVelocity,
	AO: AlignOrientation,
	Params: DriveParams,
	BaseMaxSpeed: number,
	MaxAltitude: number,
	Force: number,
	Authority: string,
	DriverUserId: number,
	SatAt: number?,
	HelloAt: number?,
	HelloTimedOut: boolean,
	FlightNoticeSent: boolean,
	EverSeated: boolean,
	LastSeatedAt: number,
	LastValid: ValidPoint,
	Window: { Pos: Vector3, T: number }?,
	LastSampleT: number?,
	LastSamplePos: Vector3?,
	NextSampleAt: number,
	NextIdleAt: number,
	LastIdleAt: number?,
	SpeedFlags: number,
	OffWaterFor: number,
	Violations: { number },
	CorrectUntil: number?,
	CorrectPos: Vector3?,
	Idle: IdleState,
	Fallback: DriveState?,
	LastStabilisedAt: number,
	Conns: { RBXScriptConnection },
	OutVel: Vector3?,
	OutHold: boolean?,
	OutRot: CFrame?,
	-- judge fix: ownership of every assembly, input stream, watchdog, diagnostics
	OwnParts: { BasePart },
	InT: number,
	InS: number,
	InL: number,
	InAt: number?,
	ClientProven: boolean,
	ClientBroken: boolean,
	ServerProven: boolean,
	BrokenReason: string?,
	HandOffPos: Vector3?,
	HandOffAt: number?,
	PushSince: number?,
	PushPos: Vector3?,
	OwnerBad: number,
	NextOwnerProbe: number,
	TripAt: number?,
	TripPos: Vector3?,
	TripSign: number?, -- sign of the pushed throttle at the trip (0 / nil = no push: ownership trip)
	TripLook: Vector3?, -- chassis look vector at the trip
	BlockPush: number,
	BlockLogged: boolean,
	LastWatchAt: number?,
	Pins: number,
	PinList: string,
	NextDiagAt: number,
	NextDiagLogAt: number,
	-- rollover fix: "another player near this flipped car" (DriveSense.Clear), re-checked at most 5x a second
	ClearAt: number?,
	ClearVal: boolean?,
	-- rollover fix: last watchdog sample (5 Hz) that saw this car on its side / roof (no "nomove" trip meanwhile)
	FlipSeenAt: number?,
}

local sitCueShown: { [number]: boolean } = {} -- ArmedJeep muzzle-flash cue on the first car sit (once per session)
local sitOfferShown: { [number]: boolean } = {} -- SpeedBoost soft offer after the first sit (once per session)

local DataService: any = nil
local EconomyService: any = nil
local AnalyticsService: any = nil
local RateLimitService: any = nil
local NotificationService: any = nil
local RemoteSetup: any = nil
local TerritoryService: any = nil
local MissionService: any = nil
local TutorialService: any = nil
local MonetizationService: any = nil
local ResearchService: any = nil
local AntiExploitService: any = nil

local activeVehicles: { [number]: Model } = {}
local lastSpawnAt: { [number]: number } = {}
local lastDamageAt: { [number]: number } = {} -- P1-9: character took damage (Humanoid.HealthChanged drop)
local brokenTrips: { [number]: number } = {} -- judge fix: server-proven watchdog trips this session (per UserId)
local vehicles: { [Model]: VehicleRec } = {}
local vehicleFolder: Folder? = nil

local function now(): number
	return os.clock()
end

local function ensureFolder(): Folder
	local cached = vehicleFolder
	if cached and cached.Parent then
		return cached
	end
	local existing = Workspace:FindFirstChild("WarEmpireVehicles")
	if existing and existing:IsA("Folder") then
		vehicleFolder = existing
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "WarEmpireVehicles"
	folder.Parent = Workspace
	vehicleFolder = folder
	return folder
end

local function getDef(vehicleId: string): VehicleDef?
	return VehicleConfig.Vehicles[vehicleId]
end

local function notify(player: Player, message: string, kind: string, duration: number?)
	if NotificationService and NotificationService.Notify then
		pcall(NotificationService.Notify, player, message, kind, duration)
	end
end

-- ── Maths shared with the client laws (spec §2.0) ───────────────────────────────────────────────
local function approach(x: number, target: number, rate: number, dt: number): number
	local d = target - x
	local m = rate * dt
	if d > m then
		return x + m
	elseif d < -m then
		return x - m
	end
	return target
end

local function fwd(h: number): Vector3
	return Vector3.new(-math.sin(h), 0, -math.cos(h))
end

local function right(h: number): Vector3
	return Vector3.new(math.cos(h), 0, -math.sin(h))
end

local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function orient(pitchDeg: number, h: number, bankDeg: number): CFrame
	return CFrame.fromEulerAnglesYXZ(math.rad(pitchDeg), h, -math.rad(bankDeg))
end

local function unitInput(v: any): number
	local n = tonumber(v)
	if n == nil or n ~= n then
		return 0
	end
	return math.clamp(n, -1, 1)
end

local function partVelocity(part: BasePart): Vector3
	local v = (part :: any).AssemblyLinearVelocity
	if typeof(v) == "Vector3" then
		return v
	end
	return Vector3.zero
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- ── Water (spec §2.5; the same algorithm as VehicleDriveClient.Laws.WaterSurfaceAt) ─────────────
local waterParts: { BasePart } = {}
local waterRefreshAt = 0

local function refreshWaterParts()
	local list: { BasePart } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.Water)) do
		if inst:IsA("BasePart") and inst.Parent then
			table.insert(list, inst)
		end
	end
	waterParts = list
end

local function getWaterParts(): { BasePart }
	local t = now()
	if t >= waterRefreshAt then
		waterRefreshAt = t + WaterCfg.RefreshSeconds
		refreshWaterParts()
	end
	return waterParts
end

--[[ Waterways C5: plot water (DockWater carries WE_PlotId, SeaGateWater WE_GatePlotId) is water only for a boat
	whose owner's BasePlotId is that plot. An enemy boat can then neither spawn in, drive into nor idle in someone's
	basin or gate water, not even behind an ally's boat while the sea gate is open. Public water has neither
	attribute and is water for every boat. ]]
local function waterPlotOf(p: BasePart): number?
	local id = p:GetAttribute("WE_PlotId")
	if id == nil then
		id = p:GetAttribute("WE_GatePlotId")
	end
	return tonumber(id)
end

local function filterPlotWater(parts: { BasePart }, plotId: number?): { BasePart }
	local out: { BasePart } = {}
	for _, p in ipairs(parts) do
		local id = waterPlotOf(p)
		if id == nil or id == plotId then
			table.insert(out, p)
		end
	end
	return out
end

-- per-plot filtered lists, rebuilt whenever getWaterParts() hands out a new list (every RefreshSeconds)
local plotWaterFrom: { BasePart }? = nil
local plotWaterLists: { [number]: { BasePart } } = {}

local function waterPartsFor(plotId: number?): { BasePart }
	local all = getWaterParts()
	if plotWaterFrom ~= all then
		plotWaterFrom = all
		plotWaterLists = {}
	end
	local key = plotId or -1
	local list = plotWaterLists[key]
	if list == nil then
		list = filterPlotWater(all, plotId)
		plotWaterLists[key] = list
	end
	return list
end

--[[ Top of the highest flat WE_Water part under pos (nil = no water). margin shrinks each part's
	rectangle (negative = slack outside the edge). landProbe(x, z, top) → true when something solid
	stands at/above the surface there (kerb, pier, pad, sandbar). ]]
local function waterSurfaceAt(
	parts: { BasePart },
	pos: Vector3,
	margin: number?,
	landProbe: ((number, number, number) -> boolean)?
): number?
	local m = margin or 0
	local best = -math.huge
	local found = false
	for _, p in ipairs(parts) do
		local lp = p.CFrame:PointToObjectSpace(pos)
		local size = p.Size
		if math.abs(lp.X) <= size.X * 0.5 - m and math.abs(lp.Z) <= size.Z * 0.5 - m then
			local top = p.Position.Y + size.Y * 0.5
			if pos.Y >= top - WaterCfg.QueryBelow and pos.Y <= top + WaterCfg.QueryAbove and top > best then
				best = top
				found = true
			end
		end
	end
	if not found then
		return nil
	end
	if landProbe and landProbe(pos.X, pos.Z, best) then
		return nil
	end
	return best
end

-- Water rectangle in XZ (parts are flat, rotated about Y only)
type Rect2 = { CX: number, CZ: number, UX: number, UZ: number, VX: number, VZ: number, HX: number, HZ: number, Top: number, Area: number }

local function rectOf(p: BasePart): Rect2
	local cf = p.CFrame
	local r = cf.RightVector
	local z = -cf.LookVector
	local rm = math.sqrt(r.X * r.X + r.Z * r.Z)
	local zm = math.sqrt(z.X * z.X + z.Z * z.Z)
	local ux, uz = if rm > 1e-6 then r.X / rm else 1, if rm > 1e-6 then r.Z / rm else 0
	local vx, vz = if zm > 1e-6 then z.X / zm else 0, if zm > 1e-6 then z.Z / zm else 1
	return {
		CX = cf.Position.X,
		CZ = cf.Position.Z,
		UX = ux,
		UZ = uz,
		VX = vx,
		VZ = vz,
		HX = p.Size.X * 0.5,
		HZ = p.Size.Z * 0.5,
		Top = p.Position.Y + p.Size.Y * 0.5,
		Area = p.Size.X * p.Size.Z,
	}
end

-- 2D separating-axis test: true when the rectangles overlap or come within `gap` studs.
local function rectsNear(a: Rect2, b: Rect2, gap: number): boolean
	local axes = { { a.UX, a.UZ }, { a.VX, a.VZ }, { b.UX, b.UZ }, { b.VX, b.VZ } }
	local dx, dz = b.CX - a.CX, b.CZ - a.CZ
	for _, n in ipairs(axes) do
		local nx, nz = n[1], n[2]
		local ra = a.HX * math.abs(a.UX * nx + a.UZ * nz) + a.HZ * math.abs(a.VX * nx + a.VZ * nz)
		local rb = b.HX * math.abs(b.UX * nx + b.UZ * nz) + b.HZ * math.abs(b.VX * nx + b.VZ * nz)
		local d = math.abs(dx * nx + dz * nz)
		if d - ra - rb > gap then
			return false
		end
	end
	return true
end

local function isConnectedToSea(basin: BasePart, parts: { BasePart }): boolean
	local list: { BasePart } = {}
	local basinIndex = 0
	for _, p in ipairs(parts) do
		table.insert(list, p)
		if p == basin then
			basinIndex = #list
		end
	end
	if basinIndex == 0 then
		table.insert(list, basin)
		basinIndex = #list
	end
	local rects: { Rect2 } = {}
	local sea, seaArea = 0, -1
	for i, p in ipairs(list) do
		rects[i] = rectOf(p)
		if rects[i].Area > seaArea then
			seaArea = rects[i].Area
			sea = i
		end
	end
	if sea == basinIndex then
		return true
	end
	local seen: { [number]: boolean } = { [basinIndex] = true }
	local queue = { basinIndex }
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		local a = rects[cur]
		for j, b in ipairs(rects) do
			if not seen[j] and math.abs(a.Top - b.Top) <= WaterCfg.ConnectTopDelta and rectsNear(a, b, WaterCfg.ConnectGap) then
				if j == sea then
					return true
				end
				seen[j] = true
				table.insert(queue, j)
			end
		end
	end
	return false
end

-- ── Laws (server copies: idle, Car/Boat fallback; spec §2.1, §2.4, §2.6) ────────────────────────

--[[ Rollover fix: is any player other than this car's own riders within `radius` of `pos`? (list: test hook; nil =
	Players:GetPlayers()). Module-table fields, not locals: this file sits at Luau's 200-local limit. ]]
VehicleService._OthersNear = function(model: Model, pos: Vector3, radius: number, list: { Player }?): boolean
	for _, plr in ipairs(list or Players:GetPlayers()) do
		local ch = plr.Character
		if ch then
			local root = ch:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - pos).Magnitude <= radius then
				local hum = ch:FindFirstChildOfClass("Humanoid")
				local seat = if hum then hum.SeatPart else nil
				local riding = seat ~= nil and seat:IsDescendantOf(model)
				if not riding and hum then
					for _, c in ipairs(model:GetChildren()) do
						if (c:IsA("Seat") or c:IsA("VehicleSeat")) and (c :: any).Occupant == hum then
							riding = true
							break
						end
					end
				end
				if not riding then
					return true
				end
			end
		end
	end
	return false
end

--[[ Rollover fix: flip recovery — the same maths as VehicleDriveClient Laws.FlipRecover (the driver's client runs
	that one while it simulates; carStep (server drive) and the Car idle law (nobody seated) run this copy). Config:
	VehicleConfig.Drive.Modes.Car (FlipUpY, FlipSeconds, Recover*). st = DriveState or IdleState; its recovery fields
	are created on first use. Returns the mover velocity while righting (X/Z always 0), nil otherwise. ]]
VehicleService._FlipRecover = function(st: any, sense: DriveSense, dt: number): Vector3?
	local c: any = CarCfg
	local clock = (tonumber(st.RightClock) or 0) + dt
	st.RightClock = clock
	st.RightCool = math.max(0, (tonumber(st.RightCool) or 0) - dt)
	local pos = sense.Position
	local left = tonumber(st.HopLeft) or 0
	if left > 0 then
		left -= dt
		st.HopLeft = left
		local from: Vector3 = st.RightFrom or pos
		local down: number? = st.RightDown
		if down == nil and sense.UpY >= c.RecoverDoneUpY then
			down = 0 -- level again: lower it onto its wheels
		end
		local landed = down ~= nil and down >= 0.1 and sense.Velocity.Y > -0.5 * c.RecoverLiftSpeed
		if landed or left <= 0 or (pos - from).Magnitude > c.RecoverMaxStuds then
			st.HopLeft = 0
			st.RightFrom = nil
			st.RightDown = nil
			st.FlipFor = 0
			st.RightCool = c.RecoverCooldown
			return nil
		end
		if down ~= nil then
			st.RightDown = down + dt
			return Vector3.new(0, -c.RecoverLiftSpeed, 0)
		end
		local rise = pos.Y - from.Y
		return Vector3.new(0, math.clamp((c.RecoverLift - rise) * 4, 0, c.RecoverLiftSpeed), 0)
	end
	local v = sense.Velocity
	if sense.UpY < c.FlipUpY and Vector3.new(v.X, 0, v.Z).Magnitude < c.RecoverSpeed then
		st.FlipFor = (tonumber(st.FlipFor) or 0) + dt
	else
		st.FlipFor = 0
	end
	if st.FlipFor < c.FlipSeconds or st.RightCool > 0 or sense.Clear == false then
		return nil
	end
	local times: { number } = st.RightTimes or {}
	st.RightTimes = times
	while #times > 0 and clock - times[1] >= 60 do
		table.remove(times, 1)
	end
	if #times >= c.RecoverMaxPerMinute then
		st.RightCool = 60 - (clock - times[1]) -- wait for the oldest start to leave the minute
		return nil
	end
	table.insert(times, clock)
	st.FlipFor = 0
	st.HopLeft = c.RecoverMaxSeconds
	st.RightFrom = pos
	st.RightDown = nil
	return Vector3.new(0, c.RecoverLiftSpeed, 0)
end

local function newDriveState(sense: DriveSense): DriveState
	local waterY = sense.WaterY
	return {
		Speed = sense.Velocity:Dot(fwd(sense.Yaw)),
		Heading = sense.Yaw,
		Age = 0,
		SlowFor = 0,
		FlipFor = 0,
		HopLeft = 0,
		BobT = 0,
		LastWaterPos = if waterY ~= nil then sense.Position else nil,
		LastWaterY = waterY,
	}
end

local function throttleSpeed(
	speed: number,
	t: number,
	maxSpeed: number,
	rev: number,
	accel: number,
	brake: number,
	coast: number,
	revAccelFrac: number,
	dt: number
): number
	if t > 0.05 then
		if speed < 0 then
			return approach(speed, 0, brake, dt)
		end
		return approach(speed, t * maxSpeed, accel, dt)
	elseif t < -0.05 then
		if speed > 0 then
			return approach(speed, 0, brake, dt)
		end
		return approach(speed, t * rev, accel * revAccelFrac, dt)
	end
	return approach(speed, 0, coast, dt)
end

-- Pushed against a wall: commanded speed follows the real speed instead of winding up.
local function speedResync(state: DriveState, forwardActual: number, gap: number, dt: number)
	if state.Age < ResyncCfg.GraceSeconds then
		state.SlowFor = 0
		return
	end
	if forwardActual < state.Speed - gap then
		state.SlowFor += dt
		if state.SlowFor >= ResyncCfg.Seconds then
			state.Speed = forwardActual + gap
			state.SlowFor = 0
		end
	else
		state.SlowFor = 0
	end
end

local function carStep(state: DriveState, p: DriveParams, input: DriveInput, sense: DriveSense, dt: number): DriveOut
	dt = math.clamp(dt, 0, 0.1)
	state.Age += dt
	local c = if p.Tracked then CarCfg.Tracked else CarCfg.Wheeled
	local maxS = p.MaxSpeed
	local rev = maxS * CarCfg.ReverseFrac
	local t, s = unitInput(input.Throttle), unitInput(input.Steer)
	speedResync(state, sense.Velocity:Dot(fwd(state.Heading)), ResyncCfg.CarGap, dt)
	if sense.UpY < CarCfg.FlipUpY then
		-- rollover fix: no traction and no steering on its side / roof (it used to be driven along on its side)
		s = 0
		state.Speed = approach(state.Speed, 0, c.Brake, dt)
	else
		state.Speed = throttleSpeed(state.Speed, t, maxS, rev, p.Accel, c.Brake, c.Coast, CarCfg.ReverseAccelFrac, dt)
	end
	state.Speed = math.clamp(state.Speed, -rev, maxS)
	local dir = if state.Speed < -0.5 then -1 else 1
	local spd = math.abs(state.Speed)
	local turn = s * p.TurnRate * math.clamp(spd / CarCfg.TurnSpeedRef, c.MinTurnFactor, 1)
	if c.MaxLatAccel > 0 and spd > 1 then
		turn = math.clamp(turn, -c.MaxLatAccel / spd, c.MaxLatAccel / spd) -- rollover fix: speed-sensitive steering
	end
	state.Heading -= turn * dir * dt
	if math.abs(wrapAngle(sense.Yaw - state.Heading)) > CarCfg.YawResyncRad then
		state.Heading = sense.Yaw -- a collision spun us: stop fighting it
	end
	local r = right(state.Heading)
	local lat = sense.Velocity:Dot(r) * math.exp(-c.Grip * dt)
	local vel = fwd(state.Heading) * state.Speed + r * lat
	-- rollover fix: on its side / roof and stopped → flip recovery (replaces the old 15 studs/s hop)
	local rv = VehicleService._FlipRecover(state, sense, dt)
	if rv then
		state.Speed = 0
		vel = rv
	end
	return {
		Velocity = vel,
		HoldVertical = rv ~= nil,
		Orientation = orient(0, state.Heading, 0),
		Hud = { Speed = math.abs(state.Speed), Tag = if rv then "RIGHTING" else nil },
		Righting = rv ~= nil,
	}
end

-- Shore probes: the client calls this BEFORE building sense (WaterNear / WaterFar).
local function boatProbe(state: DriveState, p: DriveParams, input: DriveInput): (number, number, number)
	local t = unitInput(input.Throttle)
	local dir = if state.Speed < -0.5 or (state.Speed <= 0 and t < 0) then -1 else 1
	local near = p.HalfLength + BoatCfg.ShoreMargin
	local far = near + state.Speed * state.Speed / (2 * BoatCfg.ShoreBrake) + 2
	return dir, near, far
end

local function boatStep(state: DriveState, p: DriveParams, input: DriveInput, sense: DriveSense, dt: number): DriveOut
	dt = math.clamp(dt, 0, 0.1)
	state.Age += dt
	local maxS = p.MaxSpeed
	local rev = maxS * BoatCfg.ReverseFrac
	local t, s = unitInput(input.Throttle), unitInput(input.Steer)
	speedResync(state, sense.Velocity:Dot(fwd(state.Heading)), ResyncCfg.Gap, dt)
	local dir = boatProbe(state, p, input)
	local before = state.Speed
	state.Speed = throttleSpeed(state.Speed, t, maxS, rev, p.Accel, BoatCfg.Brake, BoatCfg.Coast, BoatCfg.ReverseAccelFrac, dt)
	state.Speed = math.clamp(state.Speed, -rev, maxS)
	if sense.WaterNear == false then
		-- hard stop: no throttle into the shore
		state.Speed = if dir > 0 then math.min(state.Speed, 0) else math.max(state.Speed, 0)
	elseif sense.WaterFar == false then
		-- brake before the shore; throttle never adds speed toward it meanwhile
		local base = if math.abs(state.Speed) > math.abs(before) then before else state.Speed
		state.Speed = approach(base, 0, BoatCfg.ShoreBrake, dt)
	end
	state.Heading -= s * p.TurnRate * math.clamp(math.abs(state.Speed) / BoatCfg.TurnSpeedRef, BoatCfg.MinTurnFactor, 1) * dir * dt
	local pos = sense.Position
	local vel: Vector3
	local hold = true
	local tag: string? = nil
	local waterY = sense.WaterY
	if waterY == nil then
		-- pushed aground: head back to the last water position
		tag = "AGROUND"
		state.Speed = 0
		local lw, lwy = state.LastWaterPos, state.LastWaterY
		if lw ~= nil and lwy ~= nil then
			local d = Vector3.new(lw.X - pos.X, 0, lw.Z - pos.Z)
			local horiz = if d.Magnitude > 1e-4 then d.Unit * BoatCfg.AgroundSpeed else Vector3.zero
			local vy = math.clamp((lwy + p.RideOffset - pos.Y) * BoatCfg.HeightGain, -BoatCfg.MaxVy, BoatCfg.MaxVy)
			vel = horiz + Vector3.new(0, vy, 0)
		else
			vel = Vector3.zero
			hold = false
		end
	else
		state.LastWaterPos = pos
		state.LastWaterY = waterY
		state.BobT += dt
		local rideY = waterY + p.RideOffset + BoatCfg.BobAmp * 0.5 * (1 + math.sin(2 * math.pi * BoatCfg.BobHz * state.BobT))
		local vy = math.clamp((rideY - pos.Y) * BoatCfg.HeightGain, -BoatCfg.MaxVy, BoatCfg.MaxVy)
		local r = right(state.Heading)
		local lat = sense.Velocity:Dot(r) * math.exp(-BoatCfg.Drift * dt)
		vel = fwd(state.Heading) * state.Speed + r * lat + Vector3.new(0, vy, 0)
	end
	local ratio = if maxS > 0 then state.Speed / maxS else 0
	local bob = state.BobT
	local orientation = CFrame.fromEulerAnglesYXZ(
		math.rad(ratio * BoatCfg.BowUpDeg + BoatCfg.BobPitchDeg * math.sin(math.pi * bob)),
		state.Heading,
		math.rad(-s * math.clamp(ratio, 0, 1) * BoatCfg.TurnLeanDeg + BoatCfg.BobRollDeg * math.sin(2 * math.pi * BoatCfg.BobRollHz * bob + 1))
	)
	return { Velocity = vel, HoldVertical = hold, Orientation = orientation, Hud = { Speed = math.abs(state.Speed), Tag = tag } }
end

-- Idle law (no driver, or a correction hold). Spec §2.6.
local function idleTarget(mode: string, p: DriveParams, idle: IdleState, sense: DriveSense, dt: number): DriveOut
	local pos = sense.Position
	local level = orient(0, sense.Yaw, 0)
	local hud = { Speed = flat(sense.Velocity).Magnitude }
	if mode == "Heli" then
		if sense.AGL > HeliCfg.IdleLandAGL then
			return { Velocity = Vector3.new(0, -HeliCfg.IdleSink, 0), HoldVertical = true, Orientation = level, Hud = hud }
		end
		return { Velocity = Vector3.zero, HoldVertical = false, Orientation = level, Hud = hud }
	elseif mode == "Plane" then
		if sense.AGL > PlaneCfg.IdleGlideAGL then
			local look = fwd(sense.Yaw)
			local current: number = idle.GlideSpeed or math.max(0, sense.Velocity:Dot(look))
			local speed = math.max(PlaneCfg.IdleGlideMinSpeed, current - PlaneCfg.IdleGlideDecel * dt)
			idle.GlideSpeed = speed
			return {
				Velocity = look * speed + Vector3.new(0, -PlaneCfg.IdleGlideSink, 0),
				HoldVertical = true,
				Orientation = orient(PlaneCfg.IdleGlidePitch, sense.Yaw, 0),
				Hud = hud,
			}
		end
		idle.GlideSpeed = nil
		return { Velocity = Vector3.zero, HoldVertical = false, Orientation = level, Hud = hud }
	elseif mode == "Boat" then
		local waterY = sense.WaterY
		if waterY ~= nil then
			idle.LastWaterPos = pos
			idle.LastWaterY = waterY
			local vy = math.clamp((waterY + p.RideOffset - pos.Y) * BoatCfg.IdleHeightGain, -BoatCfg.IdleMaxVy, BoatCfg.IdleMaxVy)
			local h = flat(sense.Velocity)
			local current: number = idle.Speed or h.Magnitude
			local dir: Vector3 = idle.Dir or (if h.Magnitude > 0.05 then h.Unit else Vector3.zero)
			local speed = approach(current, 0, BoatCfg.IdleDecel, dt)
			idle.Speed = speed
			idle.Dir = dir
			return { Velocity = dir * speed + Vector3.new(0, vy, 0), HoldVertical = true, Orientation = level, Hud = hud }
		end
		-- no water under the hull: go back to the last water / valid position
		local target = idle.LastWaterPos or idle.ReturnPos
		local horiz = Vector3.zero
		local vy = 0
		if target then
			local d = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
			if d.Magnitude > 0.05 then
				horiz = d.Unit * math.min(BoatCfg.AgroundSpeed, d.Magnitude * 2)
			end
			local ty = if idle.LastWaterY ~= nil then idle.LastWaterY + p.RideOffset else target.Y
			vy = math.clamp((ty - pos.Y) * BoatCfg.IdleHeightGain, -BoatCfg.IdleMaxVy, BoatCfg.IdleMaxVy)
		end
		return { Velocity = horiz + Vector3.new(0, vy, 0), HoldVertical = true, Orientation = level, Hud = hud }
	end
	-- Car: parking brake, level at the current heading; an empty car on its side / roof rights itself (rollover fix)
	if mode == "Car" then
		local rv = VehicleService._FlipRecover(idle, sense, dt)
		if rv then
			return { Velocity = rv, HoldVertical = true, Orientation = level, Hud = { Speed = hud.Speed, Tag = "RIGHTING" }, Righting = true }
		end
	end
	return { Velocity = Vector3.zero, HoldVertical = false, Orientation = level, Hud = hud }
end

-- ── Drive attributes / footprint / movers ──────────────────────────────────────────────────────
local function driveModeFor(def: VehicleDef): string
	local cat = def.Category or "Ground"
	if cat == "Air" then
		local fam = def.KitFamily or ""
		if string.sub(fam, 1, 3) == "Jet" then
			return "Plane"
		end
		return "Heli"
	elseif cat == "Naval" then
		return "Boat"
	end
	return "Car"
end

local function footprintOf(model: Model): Footprint
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis")
	local ccf = if chassis and chassis:IsA("BasePart") then chassis.CFrame else model:GetPivot()
	local hx, hz, low, top = 0, 0, 0, 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			local cf = d.CFrame
			local s = d.Size * 0.5
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local lp = ccf:PointToObjectSpace(cf * Vector3.new(s.X * sx, s.Y * sy, s.Z * sz))
						hx = math.max(hx, math.abs(lp.X))
						hz = math.max(hz, math.abs(lp.Z))
						low = math.min(low, lp.Y)
						top = math.max(top, lp.Y)
					end
				end
			end
		end
	end
	return { HalfX = hx, HalfZ = hz, Clearance = -low, Top = top }
end

local function driveAttributes(def: VehicleDef, fp: Footprint, bonus: number?, armorMult: number?): { [string]: any }
	local mode = driveModeFor(def)
	local b = math.clamp(tonumber(bonus) or 1, 1, Drive.MaxResearchSpeedBonus)
	local a: { [string]: any } = {
		WE_DriveMode = mode,
		WE_ProtocolVersion = Drive.ProtocolVersion,
		WE_GroundClearance = fp.Clearance,
		WE_HalfLength = fp.HalfZ,
		WE_HalfWidth = fp.HalfX,
		WE_ArmorMult = math.clamp(tonumber(armorMult) or 1, 1, Drive.MaxResearchArmorBonus),
	}
	local base: number
	if mode == "Car" then
		local isTracked = string.find(def.KitFamily or "", "Tracked") ~= nil
		local c = if isTracked then CarCfg.Tracked else CarCfg.Wheeled
		base = if isTracked
			then math.clamp(def.Speed, CarCfg.TrackedMinSpeed, CarCfg.TrackedMaxSpeed)
			else math.max(def.Speed, CarCfg.WheeledMinSpeed)
		a.WE_Accel = c.Accel
		a.WE_TurnRate = c.TurnRate
		a.WE_Tracked = isTracked
	elseif mode == "Heli" then
		base = def.Speed
		a.WE_Accel = HeliCfg.Accel
		a.WE_TurnRate = HeliCfg.TurnRate
		a.WE_ClimbRate = HeliCfg.ClimbRate
		a.WE_MaxAltitude = HeliCfg.MaxAltitude
	elseif mode == "Plane" then
		base = def.Speed
		local vto = math.clamp(PlaneCfg.TakeoffFrac * def.Speed, PlaneCfg.TakeoffMin, PlaneCfg.TakeoffMax)
		a.WE_Accel = PlaneCfg.Thrust
		a.WE_TurnRate = PlaneCfg.TurnRate
		a.WE_MaxAltitude = PlaneCfg.MaxAltitude
		a.WE_TakeoffSpeed = vto
		a.WE_StallSpeed = PlaneCfg.StallFrac * vto
	else
		base = def.Speed
		a.WE_Accel = BoatCfg.Accel
		a.WE_TurnRate = BoatCfg.TurnRate
		a.WE_RideOffset = fp.Clearance - BoatCfg.Draft
	end
	a.WE_BaseMaxSpeed = base
	a.WE_MaxSpeed = base * b
	return a
end

local function moverTuning(mode: string): (number, number, number, number)
	if mode == "Heli" then
		return HeliCfg.ForcePerMass, HeliCfg.TorqueScale, HeliCfg.Responsiveness, HeliCfg.MaxAngularVelocity
	elseif mode == "Plane" then
		return PlaneCfg.ForcePerMass, PlaneCfg.TorqueScale, PlaneCfg.Responsiveness, PlaneCfg.MaxAngularVelocity
	elseif mode == "Boat" then
		return BoatCfg.ForcePerMass, BoatCfg.TorqueScale, BoatCfg.Responsiveness, BoatCfg.MaxAngularVelocity
	end
	return CarCfg.ForcePerMass, CarCfg.TorqueScale, CarCfg.Responsiveness, CarCfg.MaxAngularVelocity
end

local function estimateMass(model: Model): number
	local m = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Massless then
			local ok, pm = pcall(function(): number
				return d:GetMass()
			end)
			if ok and typeof(pm) == "number" then
				m += pm
			end
		end
	end
	return math.max(m, 1)
end

-- F = (mass + 20 x seats) x ForcePerMass; MaxTorque = mass x |Chassis.Size|² x TorqueScale.
local function setMoverLimits(lv: LinearVelocity, ao: AlignOrientation, chassis: BasePart, mode: string, seats: number, mass: number, holdVertical: boolean): number
	local forcePerMass, torqueScale, responsiveness, maxAngular = moverTuning(mode)
	local force = (mass + Drive.SeatMassAllowance * math.max(1, seats)) * forcePerMass
	lv.MaxAxesForce = Vector3.new(force, if holdVertical then force else 0, force)
	local sizeMag = chassis.Size.Magnitude
	ao.MaxTorque = mass * sizeMag * sizeMag * torqueScale
	ao.Responsiveness = responsiveness
	ao.MaxAngularVelocity = maxAngular
	ao:SetAttribute("WE_Spin", maxAngular) -- rollover fix: the client restores this after a flip recovery
	return force
end

--[[ Rollover fix (VehicleConfig.Drive.Stability; Car-mode kits of the listed families only): the WE_Ballast part and
	WE_DriveAttach moved to the centre of mass with a nominal rider. Returns what WE_UprightAO needs (weight with the
	rider, lever arm = min(half track to the tyre's outer face, half wheelbase)), or nil when the family gets nothing.
	Module-table fields, not locals: this file sits at Luau's 200-local limit. ]]
VehicleService._Ballast = function(model: Model, chassis: BasePart, attach: Attachment, def: VehicleDef): { Weight: number, Arm: number }?
	local cfg = Drive.Stability
	local fam = cfg.Families[def.KitFamily or ""]
	if fam == nil then
		return nil
	end
	local ccf = chassis.CFrame
	local ground, axle, zSum, n = math.huge, 0, 0, 0
	local halfTrack, zMin, zMax = 0, math.huge, -math.huge
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("WE_PhysicsWheel") == true then
			local lp = ccf:PointToObjectSpace(d.Position)
			ground = math.min(ground, lp.Y - math.min(d.Size.Y, d.Size.Z) * 0.5)
			axle += lp.Y
			zSum += lp.Z
			n += 1
			halfTrack = math.max(halfTrack, math.abs(lp.X) + d.Size.X * 0.5)
			zMin = math.min(zMin, lp.Z)
			zMax = math.max(zMax, lp.Z)
		end
	end
	if n == 0 then
		return nil
	end
	axle /= n
	local m = math.max(0, fam.Ballast) * (estimateMass(model) + cfg.RiderMass)
	if m > 0 then
		-- invisible, never collides / queried / touched; thin plate between the wheels, below the chassis
		local bx = math.max(0.4, chassis.Size.X * 0.5)
		local bz = math.max(0.4, (zMax - zMin) * 0.5)
		local by = math.max(0.2, m / (cfg.BallastDensityMax * bx * bz))
		local b = Instance.new("Part")
		b.Name = "WE_Ballast"
		b.Size = Vector3.new(bx, by, bz)
		b.CFrame = ccf * CFrame.new(0, ground + cfg.BallastHeight * (axle - ground), zSum / n)
		b.Anchored = false
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.CastShadow = false
		b.Massless = false
		b.Transparency = 1
		b.CustomPhysicalProperties = PhysicalProperties.new(m / (bx * by * bz), 0.3, 0, 1, 1)
		b:SetAttribute("WE_Ballast", true)
		b.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = chassis
		w.Part1 = b
		w.Parent = b
	end
	-- centre of mass with the nominal rider on the driver seat (chassis space)
	local mass, moment = 0, Vector3.zero
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Massless then
			local pm = d:GetMass()
			mass += pm
			moment += ccf:PointToObjectSpace(d.Position) * pm
		end
	end
	local seat = model:FindFirstChild("DriverSeat")
	if seat and seat:IsA("BasePart") and cfg.RiderMass > 0 then
		local sp = ccf:PointToObjectSpace(seat.Position) + Vector3.new(0, seat.Size.Y * 0.5 + cfg.RiderLift, 0)
		mass += cfg.RiderMass
		moment += sp * cfg.RiderMass
	end
	if mass <= 0 then
		return nil
	end
	if cfg.DriveAtCoM then
		local com = moment / mass
		attach.Position = Vector3.new(0, com.Y, com.Z)
	end
	return { Weight = mass * Workspace.Gravity, Arm = math.min(halfTrack, (zMax - zMin) * 0.5) }
end

--[[ Rollover fix: WE_UprightAO — roll / pitch only (the attachment's primary axis is the chassis' up, the goal's is the
	world's up; yaw is free). It tops WE_DriveAO's torque up to UprightFrac x weight x arm: always below gravity's own
	righting moment, so a car on a slope, ramp or landing still follows the ground, and a car on its side is left to
	the flip recovery. Nothing is added when WE_DriveAO alone already reaches that. ]]
VehicleService._Upright = function(chassis: BasePart, ao: AlignOrientation, info: { Weight: number, Arm: number }, def: VehicleDef)
	local cfg = Drive.Stability
	local fam = cfg.Families[def.KitFamily or ""]
	if fam == nil then
		return
	end
	local torque = fam.UprightFrac * info.Weight * info.Arm - ao.MaxTorque
	if torque <= 0 then
		return
	end
	local frame = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, -Vector3.xAxis) -- X column = up
	local att = Instance.new("Attachment")
	att.Name = "WE_UprightAttach"
	att.CFrame = frame
	att.Parent = chassis
	local up = Instance.new("AlignOrientation")
	up.Name = "WE_UprightAO"
	up.Mode = Enum.OrientationAlignmentMode.OneAttachment
	up.PrimaryAxisOnly = true
	up.AlignType = Enum.AlignType.PrimaryAxisParallel
	up.Attachment0 = att
	up.RigidityEnabled = false
	up.CFrame = frame -- goal primary axis (X column) = world up
	up.MaxTorque = torque
	up.Responsiveness = cfg.UprightResponsiveness
	up.MaxAngularVelocity = cfg.UprightMaxAngularVelocity
	up.Parent = chassis
end

local function createMovers(model: Model, chassis: BasePart, def: VehicleDef, mode: string)
	local attach = Instance.new("Attachment")
	attach.Name = "WE_DriveAttach"
	attach.CFrame = CFrame.new()
	attach.Parent = chassis
	local lv = Instance.new("LinearVelocity")
	lv.Name = "WE_DriveLV"
	lv.Attachment0 = attach
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.ForceLimitsEnabled = true
	lv.VectorVelocity = Vector3.zero
	lv.Parent = chassis
	local ao = Instance.new("AlignOrientation")
	ao.Name = "WE_DriveAO"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.AlignType = Enum.AlignType.AllAxes
	ao.PrimaryAxisOnly = false
	ao.Attachment0 = attach
	ao.RigidityEnabled = false
	ao.CFrame = chassis.CFrame.Rotation
	ao.Parent = chassis
	-- rollover fix: ballast + drive point at the centre of mass (Car-mode families in Drive.Stability.Families)
	local stab = if mode == "Car" then VehicleService._Ballast(model, chassis, attach, def) else nil
	-- Fy starts at F only for boats (planes that start in the air get it at spawn)
	setMoverLimits(lv, ao, chassis, mode, def.Seats or 1, estimateMass(model), mode == "Boat")
	if stab then
		VehicleService._Upright(chassis, ao, stab, def)
	end
end

local function weldTo(body: BasePart, other: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = other
	w.Parent = body
end

local function addPart(
	model: Model,
	body: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?,
	collide: boolean?
): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	p.CFrame = body.CFrame * offset
	p.Anchored = false
	p.CanCollide = if collide == nil then false else collide
	p.Massless = true
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	weldTo(body, p)
	return p
end

local function addWheels(model: Model, body: BasePart, scale: number, positions: { Vector3 }, radius: number?, track: number?)
	-- Physics wheels on HingeConstraints (NOT welded). v70: free-rolling (ActuatorType None) — the
	-- WE_DriveLV / WE_DriveAO movers carry the vehicle, so nothing fights the drive.
	-- Catalog mesh wheels stay cosmetic-only via VisualAssetService (CanCollide false).
	-- Cylinder PartType axis is local X (= axle). Do NOT Z-rotate 90° (that stood the can on end).
	-- Rollover fix: track (Drive.Stability.TrackScale by vehicle id) sets the wheels further out (X only).
	local r = radius or 1.1
	local tw = track or 1
	for i, raw in ipairs(positions) do
		local offset = Vector3.new(raw.X * tw, raw.Y, raw.Z)
		local wheel = Instance.new("Part")
		wheel.Name = "Wheel" .. i
		wheel.Shape = Enum.PartType.Cylinder
		-- Thin in X (axle/width), diameter in Y/Z — axle already along body X with identity rot
		wheel.Size = Vector3.new(r * 0.85, r * 1.8 * scale, r * 1.8 * scale)
		wheel.Color = Color3.fromRGB(22, 22, 24)
		wheel.Material = Enum.Material.SmoothPlastic
		wheel.CFrame = body.CFrame * CFrame.new(offset * scale)
		wheel.Anchored = false
		wheel.CanCollide = true
		wheel.Massless = false
		-- v70 verifier: LOW friction. The axles are fixed, so yawing drags every wheel sideways; at friction 2.0
		-- that drag (mu x load x |wheel Z|) was 1.1-3.3x the WE_DriveAO torque and cars / tanks could not turn.
		-- Sideways grip comes from the law (Grip term through WE_DriveLV), not from the tyres.
		wheel.CustomPhysicalProperties =
			PhysicalProperties.new(0.9, CarCfg.WheelFriction, 0.1, CarCfg.WheelFrictionWeight, 1)
		wheel:SetAttribute("WE_PhysicsWheel", true)
		wheel.Parent = model

		local att0 = Instance.new("Attachment")
		att0.Name = "WE_WheelAttBody" .. i
		-- Identity → Attachment.Axis (1,0,0) = body right = axle
		att0.CFrame = CFrame.new(offset * scale)
		att0.Parent = body

		local att1 = Instance.new("Attachment")
		att1.Name = "WE_WheelAtt" .. i
		att1.CFrame = CFrame.new() -- wheel local X = axle
		att1.Parent = wheel

		local hinge = Instance.new("HingeConstraint")
		hinge.Name = "WE_DriveHinge" .. i
		hinge.Attachment0 = att0
		hinge.Attachment1 = att1
		hinge.ActuatorType = Enum.ActuatorType.None
		hinge:SetAttribute("WE_DriveHinge", true)
		hinge:SetAttribute("WE_WheelSide", if offset.X < 0 then -1 else 1)
		hinge.Parent = wheel
		-- v70 judge: hinge-joined parts are separate assemblies and DO collide; every kit's wheels sit
		-- 0.15-1.3 studs inside the Chassis, so the hinge and the contact fought forever (jitter, locked wheels, flings).
		local nc = Instance.new("NoCollisionConstraint")
		nc.Name = "WE_WheelNoCollide" .. i
		nc.Part0 = body
		nc.Part1 = wheel
		nc.Parent = wheel

		local hub = Instance.new("Part")
		hub.Name = "Hub" .. i
		hub.Shape = Enum.PartType.Cylinder
		hub.Size = Vector3.new(r * 0.35, r * 0.7 * scale, r * 0.7 * scale)
		hub.Color = Color3.fromRGB(90, 95, 100)
		hub.Material = Enum.Material.Metal
		hub.CFrame = wheel.CFrame
		hub.Anchored = false
		hub.CanCollide = false
		hub.Massless = true
		hub.Parent = model
		local hubWeld = Instance.new("WeldConstraint")
		hubWeld.Part0 = wheel
		hubWeld.Part1 = hub
		hubWeld.Parent = hub
	end
end

-- Visual kits v2 shared accents (keep part counts modest)
local function addHeadlights(model: Model, body: BasePart, s: number, zFront: number, y: number, spacing: number, col: Color3?)
	local c = col or Color3.fromRGB(255, 240, 180)
	addPart(model, body, "LightL", Vector3.new(0.45 * s, 0.35 * s, 0.35 * s), CFrame.new(-spacing * s, y * s, zFront * s), c, Enum.Material.Neon, nil, false)
	addPart(model, body, "LightR", Vector3.new(0.45 * s, 0.35 * s, 0.35 * s), CFrame.new(spacing * s, y * s, zFront * s), c, Enum.Material.Neon, nil, false)
end

local function addTaillights(model: Model, body: BasePart, s: number, zRear: number, y: number, spacing: number)
	local c = Color3.fromRGB(220, 50, 40)
	addPart(model, body, "TailL", Vector3.new(0.4 * s, 0.3 * s, 0.25 * s), CFrame.new(-spacing * s, y * s, zRear * s), c, Enum.Material.Neon, nil, false)
	addPart(model, body, "TailR", Vector3.new(0.4 * s, 0.3 * s, 0.25 * s), CFrame.new(spacing * s, y * s, zRear * s), c, Enum.Material.Neon, nil, false)
end

local function addExhaust(model: Model, body: BasePart, s: number, offset: CFrame, accent: Color3)
	addPart(model, body, "Exhaust", Vector3.new(0.35 * s, 0.35 * s, 1.4 * s), offset, Color3.fromRGB(35, 35, 38), Enum.Material.Metal, Enum.PartType.Cylinder, false)
	addPart(model, body, "ExhaustGlow", Vector3.new(0.28 * s, 0.28 * s, 0.35 * s), offset * CFrame.new(0, 0, 0.7 * s), accent, Enum.Material.Neon, Enum.PartType.Cylinder, false)
end

local function addRotorDisc(model: Model, body: BasePart, s: number, y: number, radius: number, accent: Color3)
	-- Thin neon disc under rotor (silhouette read at distance)
	local disc = addPart(
		model,
		body,
		"RotorDisc",
		Vector3.new(0.08 * s, radius * 2 * s, radius * 2 * s),
		CFrame.new(0, y * s, -0.3 * s) * CFrame.Angles(0, 0, math.rad(90)),
		accent,
		Enum.Material.Neon,
		Enum.PartType.Cylinder,
		false
	)
	disc.Transparency = 0.55
end

local function addWakeStrip(model: Model, body: BasePart, s: number, length: number, accent: Color3)
	addPart(model, body, "WakeNeon", Vector3.new(0.35 * s, 0.12 * s, length * s), CFrame.new(0, -0.7 * s, 0.5 * s), accent, Enum.Material.Neon, nil, false)
end

local function addSideRails(model: Model, body: BasePart, s: number, length: number, height: number, width: number, color: Color3)
	addPart(model, body, "RailL", Vector3.new(0.2 * s, 0.25 * s, length * s), CFrame.new(-width * s, height * s, 0), color, Enum.Material.Metal, nil, false)
	addPart(model, body, "RailR", Vector3.new(0.2 * s, 0.25 * s, length * s), CFrame.new(width * s, height * s, 0), color, Enum.Material.Metal, nil, false)
end

local function buildVehicleModel(def: VehicleDef, at: CFrame, ownerUserId: number, bonus: number?, armorMult: number?): Model
	local model = Instance.new("Model")
	-- streaming2 S3 (F9): the chassis and each hinge-wheel assembly stream as one unit, so a phone never gets a
	-- chassis without wheels. Set before the model is ever parented, because the mode applies from the first
	-- replication. It has no effect while Workspace.StreamingEnabled is false.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = def.DisplayName
	model:SetAttribute("VehicleId", def.Id)
	model:SetAttribute("OwnerUserId", ownerUserId)

	local id = def.Id
	local family = def.KitFamily or "WheeledLight"
	local scale = if typeof(def.KitScale) == "number" then def.KitScale :: number else 1
	local olive = Color3.fromRGB(55, 70, 48)
	local oliveDark = Color3.fromRGB(40, 50, 38)
	local armor = Color3.fromRGB(62, 68, 55)
	local armorDark = Color3.fromRGB(45, 50, 42)
	local sand = Color3.fromRGB(110, 100, 70)
	local accent = Color3.fromRGB(230, 190, 60)
	local blueAcc = Color3.fromRGB(90, 160, 220)
	local redAcc = Color3.fromRGB(200, 80, 60)
	local sky = Color3.fromRGB(70, 90, 110)
	local rarity = def.Rarity or "Common"
	local accentCol = if rarity == "Legendary"
		then redAcc
		elseif rarity == "Epic" then accent
		elseif rarity == "Rare" then blueAcc
		else accent

	local body = Instance.new("Part")
	body.Name = "Chassis"
	body.Anchored = false
	body.CanCollide = true
	body.Material = Enum.Material.Metal
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.CFrame = at
	body.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0.2, 1, 1)
	body.Parent = model

	local seatOffset = CFrame.new(0, 2.0, -0.5)
	local labelY = 4.5
	local s = scale
	local track = tonumber(Drive.Stability.TrackScale[id]) or 1 -- rollover fix: wider-set physics wheels

	local function kitWheeledLight()
		local armed = id == "ArmedJeep"
		local scout = id == "ScoutCar" or id == "ReconBuggy"
		local quad = id == "UtilityQuad"
		body.Size = Vector3.new(5.2 * s, 1.6 * s, if quad then 6.5 * s else 8.5 * s)
		body.Color = if armed then Color3.fromRGB(48, 58, 42) elseif scout then Color3.fromRGB(70, 85, 55) else olive
		addPart(model, body, "Hood", Vector3.new(4.6 * s, 0.7 * s, 2.8 * s), CFrame.new(0, 0.9 * s, -2.4 * s), oliveDark, Enum.Material.Metal, nil, false)
		addPart(model, body, "Cabin", Vector3.new(4.4 * s, 1.4 * s, 2.8 * s), CFrame.new(0, 1.3 * s, 0.2 * s), oliveDark, Enum.Material.SmoothPlastic, nil, true)
		if not quad then
			addPart(model, body, "Bed", Vector3.new(4.4 * s, 0.9 * s, 2.6 * s), CFrame.new(0, 0.7 * s, 2.6 * s), olive, Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Bumper", Vector3.new(5.0 * s, 0.5 * s, 0.4 * s), CFrame.new(0, -0.3 * s, -4.0 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
		-- Olive metal trim (no neon green/gold until mesh loads)
		addPart(model, body, "AccentStrip", Vector3.new(4.8 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.1 * s, -1.2 * s), if armed then Color3.fromRGB(90, 55, 45) else oliveDark, Enum.Material.Metal, nil, false)
		if armed then
			addPart(model, body, "GunMount", Vector3.new(0.8 * s, 0.8 * s, 0.8 * s), CFrame.new(0, 2.2 * s, 0.4 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			addPart(model, body, "Barrel", Vector3.new(0.25 * s, 0.25 * s, 2.4 * s), CFrame.new(0, 2.5 * s, -1.0 * s), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, false)
		end
		addWheels(model, body, s, {
			Vector3.new(-2.4, -0.9, 2.6),
			Vector3.new(2.4, -0.9, 2.6),
			Vector3.new(-2.4, -0.9, -2.6),
			Vector3.new(2.4, -0.9, -2.6),
		}, 1.05, track)
		addHeadlights(model, body, s, -4.1, 0.2, 1.8)
		addTaillights(model, body, s, if quad then 3.0 else 4.0, 0.15, 1.9)
		addExhaust(model, body, s, CFrame.new(1.8 * s, -0.2 * s, 3.2 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(50, 55, 45))
		addSideRails(model, body, s, if quad then 4.5 else 5.5, 0.6, 2.5, oliveDark)
		seatOffset = CFrame.new(0, 1.9 * s, 0.1 * s)
		labelY = 4.2 * s
	end

	local function kitWheeledTruck()
		local supply = id == "SupplyTruck"
		local fuel = id == "FuelTanker"
		local missile = id == "MissileTruck" or id == "AntiAirTruck"
		local eng = id == "EngineeringTruck"
		body.Size = Vector3.new(6.2 * s, 2.4 * s, 11 * s)
		body.Color = if supply then sand elseif fuel then Color3.fromRGB(90, 95, 55) else armor
		addPart(model, body, "Cabin", Vector3.new(5.6 * s, 2.0 * s, 3.2 * s), CFrame.new(0, 1.6 * s, -3.2 * s), armorDark, Enum.Material.Metal, nil, true)
		addPart(model, body, "Cargo", Vector3.new(5.8 * s, 2.6 * s, 6.5 * s), CFrame.new(0, 1.4 * s, 2.0 * s), if supply then Color3.fromRGB(130, 115, 75) elseif fuel then Color3.fromRGB(70, 80, 45) else sand, Enum.Material.Metal, nil, true)
		addPart(model, body, "Accent", Vector3.new(5.9 * s, 0.15 * s, 0.4 * s), CFrame.new(0, 2.5 * s, -2.0 * s), accentCol, Enum.Material.Neon, nil, false)
		if supply then
			addPart(model, body, "Crate", Vector3.new(3.5 * s, 1.4 * s, 3.5 * s), CFrame.new(0, 3.0 * s, 2.0 * s), Color3.fromRGB(90, 75, 50), Enum.Material.Wood, nil, false)
		elseif fuel then
			addPart(model, body, "Tank", Vector3.new(4.5 * s, 2.2 * s, 5.5 * s), CFrame.new(0, 2.8 * s, 2.0 * s), Color3.fromRGB(80, 85, 50), Enum.Material.Metal, Enum.PartType.Cylinder, false)
		elseif missile then
			addPart(model, body, "Launcher", Vector3.new(4.0 * s, 1.2 * s, 5.0 * s), CFrame.new(0, 3.0 * s, 1.5 * s) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(50, 55, 45), Enum.Material.Metal, nil, false)
		elseif eng then
			addPart(model, body, "Crane", Vector3.new(0.5 * s, 4.0 * s, 0.5 * s), CFrame.new(1.5 * s, 4.0 * s, 1.0 * s), Color3.fromRGB(200, 160, 60), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Bumper", Vector3.new(6.0 * s, 0.55 * s, 0.45 * s), CFrame.new(0, -0.6 * s, -5.2 * s), Color3.fromRGB(28, 28, 30), Enum.Material.Metal, nil, false)
		addWheels(model, body, 1.15 * s, {
			Vector3.new(-2.8, -1.2, 3.5),
			Vector3.new(2.8, -1.2, 3.5),
			Vector3.new(-2.8, -1.2, 0),
			Vector3.new(2.8, -1.2, 0),
			Vector3.new(-2.8, -1.2, -3.5),
			Vector3.new(2.8, -1.2, -3.5),
		}, 1.2, track)
		addHeadlights(model, body, s, -5.3, 0.4, 2.2)
		addTaillights(model, body, s, 5.2, 0.3, 2.4)
		addExhaust(model, body, s, CFrame.new(2.4 * s, -0.4 * s, 4.5 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		seatOffset = CFrame.new(0, 2.4 * s, -3.0 * s)
		labelY = 5.5 * s
	end

	local function kitWheeledAPC()
		local carrier = id == "InfantryCarrier"
		local cmd = id == "CommandVehicle"
		body.Size = Vector3.new((if carrier then 7.2 else 6.5) * s, 2.6 * s, (if carrier then 12 else 10.5) * s)
		body.Color = armorDark
		addPart(model, body, "HullTop", Vector3.new(5.8 * s, 1.4 * s, 8.5 * s), CFrame.new(0, 1.8 * s, 0), armor, Enum.Material.Metal, nil, true)
		addPart(model, body, "Turret", Vector3.new(2.4 * s, 1.2 * s, 2.4 * s), CFrame.new(0, 3.0 * s, 0.5 * s), Color3.fromRGB(50, 55, 48), Enum.Material.Metal, nil, false)
		addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 3.2 * s), CFrame.new(0, 3.1 * s, -2.0 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		addPart(model, body, "Accent", Vector3.new(6.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 2.6 * s, -3 * s), accentCol, Enum.Material.Neon, nil, false)
		if cmd then
			addPart(model, body, "Dish", Vector3.new(2.2 * s, 0.3 * s, 2.2 * s), CFrame.new(0, 4.0 * s, 1.5 * s), Color3.fromRGB(80, 90, 100), Enum.Material.Metal, Enum.PartType.Cylinder, false)
		end
		addPart(model, body, "Bumper", Vector3.new(6.2 * s, 0.6 * s, 0.5 * s), CFrame.new(0, -0.7 * s, -5.0 * s), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, false)
		addWheels(model, body, 1.2 * s, {
			Vector3.new(-3.0, -1.3, 3.2),
			Vector3.new(3.0, -1.3, 3.2),
			Vector3.new(-3.0, -1.3, 0.5),
			Vector3.new(3.0, -1.3, 0.5),
			Vector3.new(-3.0, -1.3, -2.5),
			Vector3.new(3.0, -1.3, -2.5),
		}, 1.25, track)
		addHeadlights(model, body, s, -5.1, 0.2, 2.4)
		addTaillights(model, body, s, 4.8, 0.2, 2.5)
		addExhaust(model, body, s, CFrame.new(2.8 * s, 0.2 * s, 4.0 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		seatOffset = CFrame.new(0, 2.2 * s, -2.5 * s)
		labelY = 5.8 * s
	end

	local function kitTracked(kind: string)
		local isSPAAG = kind == "SPAAG"
		local isArty = kind == "Artillery"
		local isIFV = kind == "IFV"
		body.Size = Vector3.new(6.5 * s, 2.2 * s, 9.5 * s)
		body.Color = if s >= 1.4 then Color3.fromRGB(45, 48, 40) else armor
		addPart(model, body, "TrackL", Vector3.new(1.2 * s, 1.6 * s, 9 * s), CFrame.new(-3.2 * s, -0.4 * s, 0), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, true)
		addPart(model, body, "TrackR", Vector3.new(1.2 * s, 1.6 * s, 9 * s), CFrame.new(3.2 * s, -0.4 * s, 0), Color3.fromRGB(30, 32, 28), Enum.Material.Metal, nil, true)
		if isSPAAG then
			addPart(model, body, "Turret", Vector3.new(3.2 * s, 1.4 * s, 3.2 * s), CFrame.new(0, 2.0 * s, 0), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "BarrelA", Vector3.new(0.3 * s, 0.3 * s, 4.5 * s), CFrame.new(-0.6 * s, 2.4 * s, -3.0 * s) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			addPart(model, body, "BarrelB", Vector3.new(0.3 * s, 0.3 * s, 4.5 * s), CFrame.new(0.6 * s, 2.4 * s, -3.0 * s) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		elseif isArty then
			local rocket = id == "RocketArtillery"
			addPart(model, body, "Turret", Vector3.new(3.4 * s, 1.5 * s, 3.8 * s), CFrame.new(0, 1.9 * s, 0.8 * s), armorDark, Enum.Material.Metal, nil, true)
			if rocket then
				addPart(model, body, "Pod", Vector3.new(3.0 * s, 1.8 * s, 4.5 * s), CFrame.new(0, 3.2 * s, 0.5 * s) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(55, 60, 50), Enum.Material.Metal, nil, false)
			else
				addPart(model, body, "Barrel", Vector3.new(0.5 * s, 0.5 * s, 7 * s), CFrame.new(0, 2.8 * s, -3.5 * s) * CFrame.Angles(math.rad(-15), 0, 0), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
			end
		elseif isIFV then
			addPart(model, body, "HullTop", Vector3.new(5.5 * s, 1.2 * s, 7.5 * s), CFrame.new(0, 1.7 * s, 0), armor, Enum.Material.Metal, nil, true)
			addPart(model, body, "Turret", Vector3.new(2.8 * s, 1.3 * s, 3.0 * s), CFrame.new(0, 2.8 * s, 0.3 * s), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 4.2 * s), CFrame.new(0, 2.9 * s, -2.5 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		else
			addPart(model, body, "Turret", Vector3.new(3.6 * s, 1.6 * s, 4.2 * s), CFrame.new(0, 2.0 * s, 0.3 * s), armorDark, Enum.Material.Metal, nil, true)
			addPart(model, body, "Barrel", Vector3.new(0.45 * s, 0.45 * s, 5.5 * s), CFrame.new(0, 2.1 * s, -4.2 * s), Color3.fromRGB(35, 35, 35), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Accent", Vector3.new(3.2 * s, 0.12 * s, 0.3 * s), CFrame.new(0, 2.9 * s, 1.2 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "Mantlet", Vector3.new(2.2 * s, 1.0 * s, 0.6 * s), CFrame.new(0, 2.1 * s, -1.6 * s), armorDark, Enum.Material.Metal, nil, false)
		addHeadlights(model, body, s, -4.6, 0.4, 2.2, Color3.fromRGB(255, 230, 160))
		addExhaust(model, body, s, CFrame.new(2.6 * s, 0.8 * s, 4.0 * s) * CFrame.Angles(0, 0, math.rad(90)), accentCol)
		-- v36: hinged road wheels → same WE_GroundDrive LV+HingeMotor path as MilitaryJeep (tracks are dress skirts)
		local trackL = model:FindFirstChild("TrackL")
		local trackR = model:FindFirstChild("TrackR")
		if trackL and trackL:IsA("BasePart") then
			trackL.CanCollide = false
		end
		if trackR and trackR:IsA("BasePart") then
			trackR.CanCollide = false
		end
		addWheels(model, body, s, {
			Vector3.new(-3.2, -1.0, 3.2),
			Vector3.new(3.2, -1.0, 3.2),
			Vector3.new(-3.2, -1.0, 1.0),
			Vector3.new(3.2, -1.0, 1.0),
			Vector3.new(-3.2, -1.0, -1.2),
			Vector3.new(3.2, -1.0, -1.2),
			Vector3.new(-3.2, -1.0, -3.2),
			Vector3.new(3.2, -1.0, -3.2),
		}, 0.9)
		seatOffset = CFrame.new(0, 2.6 * s, 0.2 * s)
		labelY = 5.5 * s
	end

	local function kitHeli(kind: string)
		local attack = kind == "Attack"
		local light = kind == "Light"
		local transport = kind == "Transport"
		local len = if transport then 12 elseif light then 8.5 else 10
		local wid = if transport then 4.5 elseif light then 2.8 else 3.2
		body.Size = Vector3.new(wid * s, 2.0 * s, len * s)
		body.Color = if id == "StealthHeli" then Color3.fromRGB(25, 30, 38) else sky
		addPart(model, body, "Cockpit", Vector3.new((wid - 0.6) * s, 1.6 * s, 3.2 * s), CFrame.new(0, 0.6 * s, -len * 0.32 * s), Color3.fromRGB(40, 55, 70), Enum.Material.Glass, nil, true)
		if transport then
			addPart(model, body, "Cabin", Vector3.new(4.0 * s, 2.0 * s, 5.5 * s), CFrame.new(0, 0.5 * s, 1.5 * s), sky, Enum.Material.Metal, nil, true)
		end
		addPart(model, body, "Tail", Vector3.new(1.0 * s, 1.0 * s, 5.5 * s), CFrame.new(0, 0.8 * s, len * 0.55 * s), body.Color, Enum.Material.Metal, nil, false)
		addPart(model, body, "TailFin", Vector3.new(0.3 * s, 2.4 * s, 1.6 * s), CFrame.new(0, 2.0 * s, len * 0.72 * s), Color3.fromRGB(50, 65, 80), Enum.Material.Metal, nil, false)
		local rotor = if transport then 16 elseif light then 11 else 14
		addPart(model, body, "RotorHub", Vector3.new(1.2 * s, 0.5 * s, 1.2 * s), CFrame.new(0, 2.0 * s, -0.3 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
		addPart(model, body, "RotorA", Vector3.new(rotor * s, 0.15 * s, 0.6 * s), CFrame.new(0, 2.35 * s, -0.3 * s), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil, false)
		addPart(model, body, "RotorB", Vector3.new(0.6 * s, 0.15 * s, rotor * s), CFrame.new(0, 2.4 * s, -0.3 * s), Color3.fromRGB(35, 35, 38), Enum.Material.Metal, nil, false)
		addPart(model, body, "SkidL", Vector3.new(0.25 * s, 0.25 * s, 7 * s), CFrame.new(-wid * 0.5 * s, -1.3 * s, 0), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidR", Vector3.new(0.25 * s, 0.25 * s, 7 * s), CFrame.new(wid * 0.5 * s, -1.3 * s, 0), Color3.fromRGB(40, 40, 40), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidPadL", Vector3.new(0.9 * s, 0.2 * s, 1.2 * s), CFrame.new(-wid * 0.5 * s, -1.45 * s, 2 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, true)
		addPart(model, body, "SkidPadR", Vector3.new(0.9 * s, 0.2 * s, 1.2 * s), CFrame.new(wid * 0.5 * s, -1.45 * s, 2 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, true)
		addRotorDisc(model, body, s, 2.2, rotor * 0.48, accentCol)
		addPart(model, body, "Accent", Vector3.new((wid - 0.4) * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.2 * s, -1 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "NavLight", Vector3.new(0.35 * s, 0.35 * s, 0.35 * s), CFrame.new(0, 1.6 * s, len * 0.4 * s), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, Enum.PartType.Ball, false)
		if attack then
			addPart(model, body, "StubWingL", Vector3.new(3.5 * s, 0.25 * s, 1.2 * s), CFrame.new(-2.5 * s, 0, 0.5 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, false)
			addPart(model, body, "StubWingR", Vector3.new(3.5 * s, 0.25 * s, 1.2 * s), CFrame.new(2.5 * s, 0, 0.5 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, false)
		end
		seatOffset = CFrame.new(0, 1.2 * s, -2.8 * s)
		labelY = 5.5 * s
	end

	local function kitJet(kind: string)
		local bomber = kind == "Bomber"
		local cargo = kind == "Transport"
		local strike = kind == "Strike"
		local len = if cargo then 16 elseif bomber then 14 else 12
		local wid = if cargo then 3.5 elseif bomber then 2.8 else 2.4
		body.Size = Vector3.new(wid * s, 1.5 * s, len * s)
		body.Color = if cargo then Color3.fromRGB(100, 105, 95) elseif bomber then Color3.fromRGB(70, 75, 80) else Color3.fromRGB(90, 95, 100)
		addPart(model, body, "Nose", Vector3.new((wid - 0.8) * s, 1.0 * s, 3.5 * s), CFrame.new(0, 0.1 * s, -len * 0.48 * s), Color3.fromRGB(70, 75, 80), Enum.Material.Metal, nil, false)
		addPart(model, body, "Cockpit", Vector3.new(1.6 * s, 0.9 * s, 2.2 * s), CFrame.new(0, 0.9 * s, -len * 0.28 * s), Color3.fromRGB(40, 80, 120), Enum.Material.Glass, nil, false)
		local wingSpan = if cargo then 10 elseif bomber then 9 else 7
		addPart(model, body, "WingL", Vector3.new(wingSpan * s, 0.25 * s, 2.8 * s), CFrame.new(-wingSpan * 0.55 * s, 0, 0.5 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		addPart(model, body, "WingR", Vector3.new(wingSpan * s, 0.25 * s, 2.8 * s), CFrame.new(wingSpan * 0.55 * s, 0, 0.5 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		addPart(model, body, "TailFin", Vector3.new(0.25 * s, (if bomber then 3.2 else 2.8) * s, 2.0 * s), CFrame.new(0, 1.8 * s, len * 0.38 * s), Color3.fromRGB(85, 90, 95), Enum.Material.Metal, nil, false)
		if not cargo then
			addPart(model, body, "StabL", Vector3.new(2.5 * s, 0.2 * s, 1.2 * s), CFrame.new(-1.5 * s, 0.8 * s, len * 0.38 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
			addPart(model, body, "StabR", Vector3.new(2.5 * s, 0.2 * s, 1.2 * s), CFrame.new(1.5 * s, 0.8 * s, len * 0.38 * s), Color3.fromRGB(80, 85, 90), Enum.Material.Metal, nil, false)
		end
		if strike or kind == "Fighter" then
			addPart(model, body, "IntakeL", Vector3.new(0.9 * s, 0.9 * s, 2.5 * s), CFrame.new(-1.3 * s, -0.2 * s, 1.5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "IntakeR", Vector3.new(0.9 * s, 0.9 * s, 2.5 * s), CFrame.new(1.3 * s, -0.2 * s, 1.5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
		end
		if bomber then
			addPart(model, body, "Bay", Vector3.new((wid - 0.4) * s, 0.8 * s, 4 * s), CFrame.new(0, -0.6 * s, 0.5 * s), Color3.fromRGB(45, 48, 52), Enum.Material.Metal, nil, false)
		end
		addPart(model, body, "Accent", Vector3.new(2.0 * s, 0.1 * s, 0.3 * s), CFrame.new(0, 0.8 * s, -1 * s), accentCol, Enum.Material.Neon, nil, false)
		addPart(model, body, "EngineGlow", Vector3.new((wid - 0.6) * s, 0.7 * s, 0.5 * s), CFrame.new(0, 0, len * 0.42 * s), accentCol, Enum.Material.Neon, nil, false)
		-- Landing gear: nose wheel + two main wheels at the same height (3-point stance). v70: low
		-- friction (friction weight 100) so the plane slides along the runway under the movers.
		local gearParts = {
			addPart(model, body, "GearF", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(0, -1.0 * s, -len * 0.3 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true),
			addPart(model, body, "WheelF", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(0, -1.5 * s, -len * 0.3 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true),
			addPart(model, body, "GearL", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(-1.5 * s, -1.0 * s, 1 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true),
			addPart(model, body, "GearR", Vector3.new(0.3 * s, 0.8 * s, 0.3 * s), CFrame.new(1.5 * s, -1.0 * s, 1 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, true),
			addPart(model, body, "WheelL", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(-1.5 * s, -1.5 * s, 1 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true),
			addPart(model, body, "WheelR", Vector3.new(0.5 * s, 0.9 * s, 0.9 * s), CFrame.new(1.5 * s, -1.5 * s, 1 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, true),
		}
		for _, g in ipairs(gearParts) do
			g.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.02, 0.1, 100, 1)
		end
		addPart(model, body, "WingTipL", Vector3.new(0.3 * s, 0.3 * s, 0.3 * s), CFrame.new(-wingSpan * 0.95 * s, 0.1 * s, 0.5 * s), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, Enum.PartType.Ball, false)
		addPart(model, body, "WingTipR", Vector3.new(0.3 * s, 0.3 * s, 0.3 * s), CFrame.new(wingSpan * 0.95 * s, 0.1 * s, 0.5 * s), Color3.fromRGB(60, 255, 90), Enum.Material.Neon, Enum.PartType.Ball, false)
		seatOffset = CFrame.new(0, 1.3 * s, -len * 0.26 * s)
		labelY = 4.8 * s
	end

	local function kitNaval(kind: string)
		if kind == "Landing" then
			body.Size = Vector3.new(8 * s, 2.0 * s, 16 * s)
			body.Color = Color3.fromRGB(55, 65, 55)
			addPart(model, body, "Deck", Vector3.new(7.2 * s, 0.5 * s, 13 * s), CFrame.new(0, 1.1 * s, 0.5 * s), Color3.fromRGB(70, 80, 65), Enum.Material.Metal, nil, true)
			addPart(model, body, "Ramp", Vector3.new(6.5 * s, 0.4 * s, 4 * s), CFrame.new(0, 0.6 * s, -7.5 * s) * CFrame.Angles(math.rad(-18), 0, 0), Color3.fromRGB(60, 70, 55), Enum.Material.Metal, nil, true)
			addPart(model, body, "Cabin", Vector3.new(3.5 * s, 2.2 * s, 3.0 * s), CFrame.new(0, 2.3 * s, 5.5 * s), Color3.fromRGB(50, 60, 50), Enum.Material.Metal, nil, true)
			addPart(model, body, "WallL", Vector3.new(0.4 * s, 1.6 * s, 12 * s), CFrame.new(-3.6 * s, 1.6 * s, 0), oliveDark, Enum.Material.Metal, nil, false)
			addPart(model, body, "WallR", Vector3.new(0.4 * s, 1.6 * s, 12 * s), CFrame.new(3.6 * s, 1.6 * s, 0), oliveDark, Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(6.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.6 * s, 4 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 12, accentCol)
			addPart(model, body, "GunMount", Vector3.new(1.2 * s, 0.8 * s, 1.2 * s), CFrame.new(0, 2.6 * s, -2 * s), Color3.fromRGB(40, 45, 40), Enum.Material.Metal, nil, false)
			seatOffset = CFrame.new(0, 3.0 * s, 5.2 * s)
			labelY = 6.0 * s
		elseif kind == "Sub" then
			-- Surface stub: low dark hull (no underwater physics yet)
			body.Size = Vector3.new(5 * s, 2.2 * s, 18 * s)
			body.Color = Color3.fromRGB(30, 40, 48)
			addPart(model, body, "Sail", Vector3.new(1.8 * s, 2.8 * s, 4 * s), CFrame.new(0, 2.4 * s, -1 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new(3.5 * s, 1.6 * s, 4 * s), CFrame.new(0, 0.2 * s, -8 * s), Color3.fromRGB(28, 38, 45), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(4.0 * s, 0.12 * s, 0.3 * s), CFrame.new(0, 1.2 * s, 2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 14, accentCol)
			addPart(model, body, "Periscope", Vector3.new(0.25 * s, 2.2 * s, 0.25 * s), CFrame.new(0, 4.2 * s, -1 * s), Color3.fromRGB(50, 55, 60), Enum.Material.Metal, nil, false)
			seatOffset = CFrame.new(0, 3.5 * s, -1 * s)
			labelY = 6.5 * s
		elseif kind == "Capital" then
			body.Size = Vector3.new(8 * s, 2.4 * s, 28 * s)
			body.Color = Color3.fromRGB(40, 55, 70)
			addPart(model, body, "Deck", Vector3.new(7.2 * s, 0.5 * s, 24 * s), CFrame.new(0, 1.3 * s, 0), Color3.fromRGB(50, 65, 80), Enum.Material.Metal, nil, true)
			addPart(model, body, "Superstructure", Vector3.new(4.5 * s, 3.5 * s, 8 * s), CFrame.new(0, 3.2 * s, 2 * s), Color3.fromRGB(45, 60, 75), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bridge", Vector3.new(3.5 * s, 2.0 * s, 3.5 * s), CFrame.new(0, 5.5 * s, 1 * s), Color3.fromRGB(55, 70, 85), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new(5.5 * s, 1.6 * s, 5 * s), CFrame.new(0, 0.6 * s, -12 * s), Color3.fromRGB(45, 60, 75), Enum.Material.Metal, nil, false)
			addPart(model, body, "TurretF", Vector3.new(2.4 * s, 1.2 * s, 2.8 * s), CFrame.new(0, 2.4 * s, -6 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "BarrelF", Vector3.new(0.4 * s, 0.4 * s, 5 * s), CFrame.new(0, 2.6 * s, -9 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
			addPart(model, body, "TurretA", Vector3.new(2.2 * s, 1.1 * s, 2.5 * s), CFrame.new(0, 2.3 * s, 8 * s), Color3.fromRGB(35, 45, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "Stack", Vector3.new(1.8 * s, 3.5 * s, 1.8 * s), CFrame.new(0, 5.5 * s, 5 * s), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(6.5 * s, 0.15 * s, 0.4 * s), CFrame.new(0, 1.8 * s, -2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, 22, accentCol)
			addPart(model, body, "Mast", Vector3.new(0.35 * s, 6 * s, 0.35 * s), CFrame.new(0, 8.5 * s, 2 * s), Color3.fromRGB(55, 60, 70), Enum.Material.Metal, nil, false)
			addPart(model, body, "RadarDish", Vector3.new(2.4 * s, 0.35 * s, 2.4 * s), CFrame.new(0, 11.5 * s, 2 * s), accentCol, Enum.Material.Neon, Enum.PartType.Cylinder, false)
			seatOffset = CFrame.new(0, 6.2 * s, 1 * s)
			labelY = 9.0 * s
		else
			-- Patrol / Gun
			local gun = kind == "Gun" or id == "Gunboat" or id == "MissileBoat"
			local hull = Color3.fromRGB(45, 70, 85)
			body.Size = Vector3.new((if gun then 6.5 else 5.5) * s, 1.8 * s, (if gun then 14 else 11) * s)
			body.Color = hull
			addPart(model, body, "Deck", Vector3.new((if gun then 5.8 else 4.8) * s, 0.4 * s, (if gun then 11 else 8.5) * s), CFrame.new(0, 1.0 * s, 0), Color3.fromRGB(55, 80, 95), Enum.Material.Metal, nil, true)
			addPart(model, body, "Cabin", Vector3.new(3.2 * s, 2.0 * s, 3.5 * s), CFrame.new(0, 2.2 * s, -1.5 * s), Color3.fromRGB(40, 60, 75), Enum.Material.Metal, nil, true)
			addPart(model, body, "Bow", Vector3.new((if gun then 4.5 else 3.8) * s, 1.2 * s, 3.0 * s), CFrame.new(0, 0.4 * s, (if gun then -6.5 else -5.2) * s), Color3.fromRGB(50, 75, 90), Enum.Material.Metal, nil, false)
			addPart(model, body, "Accent", Vector3.new(4.0 * s, 0.12 * s, 0.35 * s), CFrame.new(0, 1.5 * s, -2 * s), accentCol, Enum.Material.Neon, nil, false)
			addWakeStrip(model, body, s, if gun then 11 else 8, accentCol)
			addPart(model, body, "BridgeGlass", Vector3.new(2.8 * s, 0.9 * s, 0.3 * s), CFrame.new(0, 2.8 * s, -3.0 * s), Color3.fromRGB(60, 100, 130), Enum.Material.Glass, nil, false)
			if gun then
				addPart(model, body, "Turret", Vector3.new(2.0 * s, 1.0 * s, 2.0 * s), CFrame.new(0, 2.8 * s, 2.5 * s), Color3.fromRGB(35, 45, 50), Enum.Material.Metal, nil, false)
				addPart(model, body, "Barrel", Vector3.new(0.35 * s, 0.35 * s, 3.5 * s), CFrame.new(0, 3.0 * s, 0.5 * s), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, nil, false)
				addPart(model, body, "GunShield", Vector3.new(1.6 * s, 1.0 * s, 0.25 * s), CFrame.new(0, 3.2 * s, 1.4 * s), Color3.fromRGB(40, 50, 55), Enum.Material.Metal, nil, false)
			end
			seatOffset = CFrame.new(0, 2.8 * s, -1.2 * s)
			labelY = 5.5 * s
		end
	end

	if family == "WheeledLight" then
		kitWheeledLight()
	elseif family == "WheeledTruck" then
		kitWheeledTruck()
	elseif family == "WheeledAPC" then
		kitWheeledAPC()
	elseif family == "TrackedIFV" then
		kitTracked("IFV")
	elseif family == "TrackedMBT" then
		kitTracked("MBT")
	elseif family == "TrackedSPAAG" then
		kitTracked("SPAAG")
	elseif family == "TrackedArtillery" then
		kitTracked("Artillery")
	elseif family == "HeliLight" then
		kitHeli("Light")
	elseif family == "HeliTransport" then
		kitHeli("Transport")
	elseif family == "HeliAttack" then
		kitHeli("Attack")
	elseif family == "JetFighter" then
		kitJet("Fighter")
	elseif family == "JetStrike" then
		kitJet("Strike")
	elseif family == "JetBomber" then
		kitJet("Bomber")
	elseif family == "JetTransport" then
		kitJet("Transport")
	elseif family == "NavalPatrol" then
		kitNaval("Patrol")
	elseif family == "NavalGun" then
		kitNaval("Gun")
	elseif family == "NavalLanding" then
		kitNaval("Landing")
	elseif family == "NavalCapital" then
		kitNaval("Capital")
	elseif family == "NavalSub" then
		kitNaval("Sub")
	else
		body.Size = Vector3.new(6 * s, 2 * s, 10 * s)
		body.Color = olive
		addPart(model, body, "Cabin", Vector3.new(4 * s, 1.5 * s, 4 * s), CFrame.new(0, 1.5 * s, -1 * s), oliveDark, Enum.Material.SmoothPlastic, nil, true)
		addWheels(model, body, s, {
			Vector3.new(-2.5, -1.2, 3),
			Vector3.new(2.5, -1.2, 3),
			Vector3.new(-2.5, -1.2, -3),
			Vector3.new(2.5, -1.2, -3),
		}, 1.1)
		seatOffset = CFrame.new(0, 2.0 * s, -1 * s)
	end

	local cat = def.Category or "Ground"
	local mode = driveModeFor(def)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.8, 2)
	seat.Color = Color3.fromRGB(70, 80, 60)
	seat.Material = Enum.Material.SmoothPlastic
	seat.CFrame = body.CFrame * seatOffset
	seat.Anchored = false
	seat.CanCollide = true
	seat.HeadsUpDisplay = false
	-- v70: the seat only reports ThrottleFloat / SteerFloat; the WE_DriveLV / WE_DriveAO movers drive
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Disabled = false
	seat:SetAttribute("WE_DriverSeat", true)
	seat.Parent = model
	weldTo(body, seat)
	model:SetAttribute("WE_Category", cat)
	model:SetAttribute("WE_KitFamily", family)
	if def.MeshAssetId and def.MeshAssetId ~= 0 then
		model:SetAttribute("MeshAssetId", def.MeshAssetId)
	end

	local extra = math.max(0, (def.Seats or 1) - 1)
	for i = 1, math.min(extra, 4) do
		local ps = Instance.new("Seat")
		ps.Name = "PassengerSeat" .. i
		ps.Size = Vector3.new(1.4, 0.5, 1.4)
		ps.Color = Color3.fromRGB(60, 70, 55)
		ps.CFrame = body.CFrame * CFrame.new((i % 2 == 0 and 1.4 or -1.4), seatOffset.Y, seatOffset.Z + 1.4 + math.floor((i - 1) / 2) * 1.5)
		ps.Anchored = false
		ps.CanCollide = true
		ps.Parent = model
		weldTo(body, ps)
	end

	do
		-- Mobile P1-8: no server nameplate and no key-name tips. The old nameplate billboard (always on top, 280 studs,
		-- keyboard tips) showed to everyone through the HUD. The owner-only nameplate is client-side
		-- (VehicleDriveClient); WE_LabelY is the kit's label height above the Chassis centre for it.
		model:SetAttribute("WE_LabelY", labelY)
		-- v36 ArmedJeep: static ARMED billboard on barrel (no fire logic yet). World-label rules: stud-scaled,
		-- MaxDistance <= 40, never AlwaysOnTop.
		if id == "ArmedJeep" then
			local barrel = model:FindFirstChild("Barrel")
			if barrel and barrel:IsA("BasePart") then
				local abb = Instance.new("BillboardGui")
				abb.Name = "WE_ArmedCue"
				abb.Size = UDim2.fromScale(2.4, 0.6) -- studs
				abb.StudsOffset = Vector3.new(0, 1.2, 0)
				abb.AlwaysOnTop = false
				abb.MaxDistance = 40
				abb.Parent = barrel
				local al = Instance.new("TextLabel")
				al.Size = UDim2.fromScale(1, 1)
				al.BackgroundColor3 = Color3.fromRGB(40, 20, 16)
				al.BackgroundTransparency = 0.2
				al.Text = "ARMED"
				al.TextColor3 = Color3.fromRGB(255, 180, 100)
				al.TextStrokeTransparency = 0.35
				al.Font = Enum.Font.GothamBold
				al.TextScaled = true
				al.Parent = abb
			end
		end
	end

	model.PrimaryPart = body
	-- W2: WE_Premium + per-seat WE_SeatRole / WE_Exposed / WE_CanFireFromSeat (VehicleCombatConfig.SeatFire)
	pcall(VehicleService._VehicleHealth.ApplySeatAttributes, model, def)
	-- Optional free Creator Store visual (non-colliding); Part kit stays authoritative
	pcall(function()
		VisualAssetService.TryAttachVehicleVisual(model, def.Id or "", family)
	end)
	CollectionService:AddTag(model, Constants.Tags.Vehicle)

	-- v70: movers + drive attributes (protocol for VehicleDriveClient). Built at `at`, NOT parented:
	-- RequestSpawn measures the footprint, chooses the spawn, PivotTo, then parents.
	createMovers(model, body, def, mode)
	local fp = footprintOf(model)
	for k, v in pairs(driveAttributes(def, fp, bonus, armorMult)) do
		model:SetAttribute(k, v)
	end
	model:SetAttribute("WE_DriveAuthority", "Server")
	model:SetAttribute("WE_DriverUserId", 0)
	if mode == "Car" then
		model:SetAttribute("WE_GroundDrive", "Client")
	end
	return model
end

local function meetsStructureReq(profile: any, def: VehicleDef): (boolean, string?)
	local req = def.RequiresStructure
	if not req then
		return true, nil
	end
	local level = 0
	if profile.BaseUpgrades then
		level = profile.BaseUpgrades[req.StructureId] or 0
	end
	if level < req.Level then
		return false, "MissingStructure"
	end
	return true, nil
end

local function meetsPrestigeReq(profile: any, def: VehicleDef): (boolean, string?)
	local needP = def.RequiresPrestige
	if typeof(needP) == "number" and needP > 0 then
		if (profile.Prestige or 0) < needP then
			return false, "PrestigeTooLow"
		end
	end
	local flag = def.RequiresRebirthFlag
	if typeof(flag) == "string" and flag ~= "" then
		local unlocks = profile.RebirthUnlocks
		if typeof(unlocks) ~= "table" or unlocks[flag] ~= true then
			return false, "MissingRebirthUnlock"
		end
	end
	return true, nil
end

-- ── State push (garage) ────────────────────────────────────────────────────────────────────────
local GATE_STRUCTURES = { "VehicleDepot", "Helipad", "Airfield", "Dock" }

-- P1-9: seconds until SPAWN is allowed again after the player's character took damage
local function damageLockLeft(userId: number): number
	local at = lastDamageAt[userId]
	if at == nil then
		return 0
	end
	return math.max(0, SpawnCfg.DamageLockSeconds - (now() - at))
end

local function cooldownLeft(userId: number, player: Player?): number
	local last = lastSpawnAt[userId]
	if not last then
		return 0
	end
	local cd = VehicleConfig.SpawnCooldownSeconds or 15
	if player and TerritoryService and TerritoryService.GetVehicleCooldownMult then
		cd = cd * math.max(0.1, TerritoryService.GetVehicleCooldownMult(player))
	end
	return math.max(0, cd - (now() - last))
end

local function gatesFor(profile: any): { [string]: any }
	local structures: { [string]: number } = {}
	local upgrades = profile.BaseUpgrades
	for _, sid in ipairs(GATE_STRUCTURES) do
		structures[sid] = if typeof(upgrades) == "table" then (tonumber(upgrades[sid]) or 0) else 0
	end
	local rebirth: { [string]: boolean } = {}
	if typeof(profile.RebirthUnlocks) == "table" then
		for k, v in pairs(profile.RebirthUnlocks) do
			if typeof(k) == "string" and v == true then
				rebirth[k] = true
			end
		end
	end
	return {
		Level = tonumber(profile.Level) or 1,
		Prestige = tonumber(profile.Prestige) or 0,
		Structures = structures,
		Rebirth = rebirth,
	}
end

local function pushState(player: Player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local active = activeVehicles[player.UserId]
	local activeId: string? = nil
	if active and active.Parent then
		local vid = active:GetAttribute("VehicleId")
		if typeof(vid) == "string" then
			activeId = vid
		end
	end
	-- plain table (Types.VehicleStatePayload + v70 Gates; the client copes with a missing Gates)
	local payload = {
		Owned = profile.Vehicles,
		ActiveVehicleId = activeId,
		CooldownRemaining = cooldownLeft(player.UserId, player),
		Gates = gatesFor(profile),
		Repairing = VehicleService._VehicleHealth.RepairingFor(player.UserId), -- W2: { [id] = seconds } (empty = none)
	}
	local remote = RemoteSetup.Get(Constants.RemoteNames.VehicleStateUpdate) :: RemoteEvent
	remote:FireClient(player, payload)
end

-- Readable purchase / spawn refusals (garage G4)
local function errorText(err: string, def: VehicleDef?, player: Player?): string
	if err == "LevelTooLow" and def then
		return string.format("Reach Lv %d to unlock %s", def.UnlockLevel, def.DisplayName)
	elseif err == "MissingStructure" and def and def.RequiresStructure then
		local req = def.RequiresStructure
		local sdef = (BaseConfig.Structures :: any)[req.StructureId]
		local name = if sdef and typeof(sdef.DisplayName) == "string" then sdef.DisplayName else req.StructureId
		return string.format("Upgrade %s to L%d first", name, req.Level)
	elseif err == "PrestigeTooLow" and def then
		return string.format("Needs Prestige %d", tonumber(def.RequiresPrestige) or 0)
	elseif err == "MissingRebirthUnlock" then
		return "Needs a rebirth unlock"
	elseif err == "InsufficientCash" then
		return "Not enough cash"
	elseif err == "AlreadyOwned" then
		return "Already yours — tap SPAWN"
	elseif err == "NoProfile" then
		return "Still loading your save — try again"
	elseif err == "NoWater" then
		return "No open water to launch a boat"
	elseif err == "Cooldown" then
		local left = if player then math.ceil(cooldownLeft(player.UserId, player)) else 0
		return if left > 0 then string.format("Vehicle spawn cooling down (%ds)", left) else "Vehicle spawn cooling down"
	elseif err == "InCombat" then
		local left = if player
			then math.ceil(math.max(damageLockLeft(player.UserId), VehicleService._VehicleHealth.HitLockLeft(player.UserId, SpawnCfg.DamageLockSeconds)))
			else 0
		return if left > 0 then string.format("In combat — wait %ds", left) else "In combat — wait a moment"
	elseif err == "NotOwned" then
		return "Buy this vehicle first"
	elseif err == "Repairing" and def then
		local left = if player then math.ceil(VehicleService._VehicleHealth.RepairLeft(player.UserId, def.Id)) else 0
		return string.format("%s is being repaired — ready in %ds", def.DisplayName, math.max(1, left))
	elseif err == "SpawnBuildFailed" or err == "SpawnKitIncomplete" or err == "SpawnOrphaned" then
		return "Spawn failed — try again"
	elseif err == "InvalidId" or err == "UnknownVehicle" then
		return "Unknown vehicle"
	end
	return "Cannot do that right now (" .. err .. ")"
end

-- ── Spawn choice (spec §4) ─────────────────────────────────────────────────────────────────────
type PadDist = { Pad: SpawnPad, D: number }
type Offset2 = { X: number, Z: number }

local function footRadius(fp: Footprint): number
	return math.max(fp.HalfX, fp.HalfZ)
end

local function rideOffsetOf(fp: Footprint): number
	return fp.Clearance - BoatCfg.Draft
end

local function spotFree(ctx: SpawnCtx, cf: CFrame): boolean
	local fp = ctx.Footprint
	local pos = cf.Position
	local r = footRadius(fp)
	for _, o in ipairs(ctx.Occupied) do
		if (pos - o.Pos).Magnitude < r + o.Radius + 2 then
			return false
		end
	end
	local boxFree = ctx.BoxFree
	if boxFree then
		-- from just above the lowest solid point to the top of the kit, over the XZ footprint
		local lowY = -fp.Clearance + 0.15
		local highY = math.max(fp.Top, lowY + 0.5)
		local half = Vector3.new(fp.HalfX, (highY - lowY) * 0.5, fp.HalfZ)
		if not boxFree(cf * CFrame.new(0, (lowY + highY) * 0.5, 0), half) then
			return false
		end
	end
	return true
end

-- Land spot: chassis Y = surface + Clearance + 0.3 (a ray when available, else refTop).
local function landSpot(ctx: SpawnCtx, x: number, z: number, refTop: number, heading: number): CFrame?
	local y = refTop
	local surfaceY = ctx.SurfaceY
	if surfaceY then
		local hit = surfaceY(x, z, refTop)
		if hit ~= nil then
			if hit > refTop + SpawnCfg.MaxStepUp then
				return nil -- something solid stands here
			end
			y = hit
		end
	end
	return CFrame.new(x, y + ctx.Footprint.Clearance + SpawnCfg.Clearance, z) * CFrame.Angles(0, heading, 0)
end

local function aroundOffsets(fp: Footprint): { Offset2 }
	local s = 2 * footRadius(fp) + SpawnCfg.OffsetStep
	return { { X = 0, Z = 0 }, { X = s, Z = 0 }, { X = -s, Z = 0 }, { X = 0, Z = s }, { X = 0, Z = -s } }
end

local function firstFreeLand(ctx: SpawnCtx, x: number, z: number, refTop: number, heading: number, offsets: { Offset2 }): CFrame?
	for _, o in ipairs(offsets) do
		local cf = landSpot(ctx, x + o.X, z + o.Z, refTop, heading)
		if cf and spotFree(ctx, cf) then
			return cf
		end
	end
	return nil
end

local function padsByDistance(pads: { SpawnPad }, origin: Vector3?, wantNaval: boolean?, maxDist: number?): { PadDist }
	local out: { PadDist } = {}
	for _, pad in ipairs(pads) do
		if wantNaval == nil or pad.Naval == wantNaval then
			local d = if origin then (pad.Pos - origin).Magnitude else pad.Pos.Magnitude
			if maxDist == nil or d <= maxDist then
				table.insert(out, { Pad = pad, D = d })
			end
		end
	end
	table.sort(out, function(a: PadDist, b: PadDist): boolean
		return a.D < b.D
	end)
	return out
end

local function padTop(pad: SpawnPad): number
	return pad.Pos.Y + pad.Size.Y * 0.5
end

local function choice(cf: CFrame, source: string, state: string, speed: number?): SpawnChoice
	return { CFrame = cf, Source = source, State = state, Speed = speed or 0 }
end

--[[ P1-9: the land spot (centre or a footprint corner) lies in any water whose surface is above the ground there.
	Every WE_Water part counts (AllWater): another plot's dock basin is not boat water for this player, but a car
	must never land in it. Depth-independent (the ground ray ignores water, so it lands on the basin floor). ]]
local function overAnyWater(ctx: SpawnCtx, cf: CFrame): boolean
	local fp = ctx.Footprint
	local ground = cf.Position.Y - fp.Clearance - SpawnCfg.Clearance
	local lists = { ctx.WaterParts, ctx.AllWater or {} }
	for _, o in ipairs({ Vector3.zero, Vector3.new(fp.HalfX, 0, fp.HalfZ), Vector3.new(-fp.HalfX, 0, fp.HalfZ), Vector3.new(fp.HalfX, 0, -fp.HalfZ), Vector3.new(-fp.HalfX, 0, -fp.HalfZ) }) do
		local pt = cf:PointToWorldSpace(o)
		for _, list in ipairs(lists) do
			for _, w in ipairs(list) do
				local lp = w.CFrame:PointToObjectSpace(pt)
				if math.abs(lp.X) <= w.Size.X * 0.5 and math.abs(lp.Z) <= w.Size.Z * 0.5 and w.Position.Y + w.Size.Y * 0.5 > ground - 0.5 then
					return true
				end
			end
		end
	end
	return false
end

-- P1-9: nothing solid between the player's root part and the spot (never a spawn across a wall: the auto-sit would
-- carry the player through it, e.g. from outside an enemy base's perimeter wall into its courtyard)
local function inSight(ctx: SpawnCtx, from: Vector3, cf: CFrame): boolean
	local clear = ctx.Clear
	return clear == nil or clear(from, cf.Position + Vector3.new(0, 1, 0))
end

-- P1-9: open sky over the spot (no roof, upper floor or hangar within 40 studs): never inside a building
local function openSky(ctx: SpawnCtx, cf: CFrame): boolean
	local clear = ctx.Clear
	local top = cf.Position + Vector3.new(0, math.max(ctx.Footprint.Top, 1) + 0.5, 0)
	return clear == nil or clear(top, top + Vector3.new(0, 40, 0))
end

local function playerFront(ctx: SpawnCtx, state: string): SpawnChoice?
	local pp = ctx.PlayerPos
	if not pp then
		return nil
	end
	local look = flat(ctx.PlayerLook or Vector3.new(0, 0, -1))
	look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
	local ahead = pp + look * (SpawnCfg.FrontDistance + footRadius(ctx.Footprint))
	local heading = math.atan2(-look.X, -look.Z)
	-- land vehicles only (Car / Heli / Plane): never a spot over water (a player on a pier facing the sea), never
	-- across a wall (the auto-sit would carry the player through it) and never under a roof (inside a building)
	for _, o in ipairs(aroundOffsets(ctx.Footprint)) do
		local cf = landSpot(ctx, ahead.X + o.X, ahead.Z + o.Z, pp.Y - 3, heading)
		if cf and not overAnyWater(ctx, cf) and inSight(ctx, pp, cf) and openSky(ctx, cf) and spotFree(ctx, cf) then
			return choice(cf, "PlayerFront", state)
		end
	end
	return nil
end

--[[ Waterways C1: every plot-local → world conversion goes through the plot frame, i.e. the plot pad's CFrame
	(PlotPad / WE_BasePlot is built with BaseLayout.PlotCFrame(pos), which carries the plot yaw once
	BaseLayoutConfig.FaceMapCentre is on). A plot-local heading h becomes h + yawOf(frame). While the flag is off the
	pad's rotation is the identity, so every spot and heading below equals the old plot + (x, 0, z) exactly. ]]
local function plotFrame(ctx: SpawnCtx): CFrame?
	local cf = ctx.PlotCFrame
	if cf then
		return cf
	end
	local p = ctx.PlotPos
	return if p then CFrame.new(p) else nil
end

-- plot-local point (x, z) plus a plot-local offset (ox, oz) → world X, Z (base first, then the turned offset)
local function plotXZ(frame: CFrame, x: number, z: number, ox: number?, oz: number?): (number, number)
	local w = frame:PointToWorldSpace(Vector3.new(x, 0, z))
	if ox == nil and oz == nil then
		return w.X, w.Z
	end
	local o = frame:VectorToWorldSpace(Vector3.new(ox or 0, 0, oz or 0))
	return w.X + o.X, w.Z + o.Z
end

-- firstFreeLand at plot-local (x, z) with a plot-local heading; the offsets turn with the plot
local function firstFreePlotLand(
	ctx: SpawnCtx,
	frame: CFrame,
	x: number,
	z: number,
	refTop: number,
	heading: number,
	offsets: { Offset2 }
): CFrame?
	local h = heading + yawOf(frame)
	for _, o in ipairs(offsets) do
		local wx, wz = plotXZ(frame, x, z, o.X, o.Z)
		local cf = landSpot(ctx, wx, wz, refTop, h)
		if cf and spotFree(ctx, cf) then
			return cf
		end
	end
	return nil
end

local function lastResort(ctx: SpawnCtx, state: string): SpawnChoice
	local base = ctx.PlotPos or ctx.PlayerPos or Vector3.new(0, 0.5, 0)
	local y = base.Y + 0.5 + ctx.Footprint.Clearance + SpawnCfg.Clearance
	local frame = if ctx.PlotPos then plotFrame(ctx) else nil
	if frame then
		-- plot-local (0, PlotFallback.Z), turned with the plot
		local wx, wz = plotXZ(frame, 0, SpawnCfg.PlotFallback.Z)
		return choice(CFrame.new(wx, y, wz) * CFrame.Angles(0, yawOf(frame), 0), "WorldOrigin", state)
	end
	return choice(CFrame.new(base.X, y, base.Z), "WorldOrigin", state)
end

local function chooseCar(ctx: SpawnCtx): SpawnChoice
	local fp = ctx.Footprint
	local offsets = aroundOffsets(fp)
	if ctx.AwayFromHome then
		-- P1-9: away from your own plot SPAWN puts it in front of you, not on a pad 650 studs away or at home
		local front = playerFront(ctx, "Grounded")
		if front then
			return front
		end
	end
	if ctx.PlayerPos then
		for _, e in ipairs(padsByDistance(ctx.VehiclePads, ctx.PlayerPos, false, SpawnCfg.CarPadRadius)) do
			local cf = firstFreeLand(ctx, e.Pad.Pos.X, e.Pad.Pos.Z, padTop(e.Pad), yawOf(e.Pad.CFrame), offsets)
			if cf then
				return choice(cf, "VehicleSpawn", "Grounded")
			end
		end
	end
	local plot = ctx.PlotPos
	local frame = plotFrame(ctx)
	if plot and frame then
		local o = SpawnCfg.PlotFallback
		local cf = firstFreePlotLand(ctx, frame, o.X, o.Z, plot.Y + 0.5, 0, offsets)
		if cf then
			return choice(cf, "BasePlot", "Grounded")
		end
	end
	return playerFront(ctx, "Grounded") or lastResort(ctx, "Grounded")
end

local function chooseHeli(ctx: SpawnCtx): SpawnChoice
	local fp = ctx.Footprint
	local plot = ctx.PlotPos
	local frame = plotFrame(ctx)
	if ctx.AwayFromHome then
		local front = playerFront(ctx, "Landed") -- P1-9
		if front then
			return front
		end
	end
	if plot and frame and (ctx.Structures.Helipad or 0) >= 1 then
		local site = BaseLayoutConfig.Structures.Helipad.Site
		local refTop = plot.Y + 0.5 + SpawnCfg.HelipadDeckHeight
		local heading = SpawnCfg.HeliHeadingRad + yawOf(frame)
		for _, o in ipairs(SpawnCfg.HelipadSpots) do
			local wx, wz = plotXZ(frame, site.X, site.Z, o.X, o.Z)
			local cf = landSpot(ctx, wx, wz, refTop, heading)
			if cf and spotFree(ctx, cf) then
				return choice(cf, "Helipad", "Landed")
			end
		end
	end
	local origin = ctx.PlayerPos or plot
	local offsets = aroundOffsets(fp)
	for _, e in ipairs(padsByDistance(ctx.VehiclePads, origin, false, nil)) do
		local cf = firstFreeLand(ctx, e.Pad.Pos.X, e.Pad.Pos.Z, padTop(e.Pad), yawOf(e.Pad.CFrame), offsets)
		if cf then
			return choice(cf, "VehicleSpawn", "Landed")
		end
	end
	return playerFront(ctx, "Landed") or lastResort(ctx, "Landed")
end

local function runwayRoad(): { X: number, Z: number, SizeX: number, SizeZ: number }?
	for _, r in ipairs(BaseLayoutConfig.Roads) do
		if r.Name == SpawnCfg.RunwayRoad then
			return r
		end
	end
	return nil
end

local function choosePlane(ctx: SpawnCtx): SpawnChoice
	local fp = ctx.Footprint
	local plot = ctx.PlotPos
	local road = runwayRoad()
	local frame = plotFrame(ctx)
	if ctx.AwayFromHome then
		local front = playerFront(ctx, "Grounded") -- P1-9: taxi and take off from where you stand
		if front then
			return front
		end
	end
	if plot and frame and road and (ctx.Structures.Airfield or 0) >= 1 then
		-- start 12 studs in from the end nearer the plot edge, facing along the runway toward the other end
		-- (runway X/Z, the ends and the heading are plot-local; plotXZ / yawOf(frame) turn them with the plot)
		local minX, maxX = road.X - road.SizeX * 0.5, road.X + road.SizeX * 0.5
		local fromMin = math.abs(minX) >= math.abs(maxX)
		local startX = if fromMin then minX + SpawnCfg.RunwayInset else maxX - SpawnCfg.RunwayInset
		local step = if fromMin then 1 else -1
		local heading = (if fromMin then -math.pi / 2 else math.pi / 2) + yawOf(frame) -- plot +X / -X
		local refTop = plot.Y + 0.5 + SpawnCfg.RunwayHeight
		local spacing = 2 * fp.HalfZ + 6
		for k = 0, 3 do
			local x = startX + step * k * spacing
			if math.abs(x - road.X) > road.SizeX * 0.5 - fp.HalfZ then
				break
			end
			if k > 0 and math.abs(x - startX) > road.SizeX * 0.5 then
				break -- keep at least half the runway ahead
			end
			local wx, wz = plotXZ(frame, x, road.Z)
			local cf = landSpot(ctx, wx, wz, refTop, heading)
			if cf and spotFree(ctx, cf) then
				return choice(cf, "Runway", "Grounded")
			end
		end
	end
	-- air start over the nearest land pad
	local vto = ctx.TakeoffSpeed or PlaneCfg.TakeoffMin
	local speed = PlaneCfg.AirStartSpeedFrac * vto
	local origin = ctx.PlayerPos or plot
	for _, e in ipairs(padsByDistance(ctx.VehiclePads, origin, false, nil)) do
		local p = e.Pad.Pos + Vector3.new(0, PlaneCfg.AirStartHeight, 0)
		local cf = CFrame.new(p) * CFrame.Angles(0, 0, 0)
		if spotFree(ctx, cf) then
			return choice(cf, "AirStart", "Airborne", speed)
		end
	end
	local base = origin or Vector3.new(0, 0.5, 0)
	return choice(CFrame.new(base + Vector3.new(0, PlaneCfg.AirStartHeight, 0)), "AirStart", "Airborne", speed)
end

-- Boat spot: the centre and the 4 hull corners over water (margin 1, land probe), free.
local function boatSpot(ctx: SpawnCtx, cx: number, cz: number, h: number, refY: number): CFrame?
	local fp = ctx.Footprint
	local parts = ctx.WaterParts
	local margin = WaterCfg.SpawnMargin
	local centre = Vector3.new(cx, refY, cz)
	local top = waterSurfaceAt(parts, centre, margin, ctx.LandProbe)
	if top == nil then
		return nil
	end
	local f, r = fwd(h), right(h)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local p = centre + r * (sx * fp.HalfX) + f * (sz * fp.HalfZ)
			if waterSurfaceAt(parts, p, margin, ctx.LandProbe) == nil then
				return nil
			end
		end
	end
	local cf = CFrame.new(cx, top + rideOffsetOf(fp), cz) * CFrame.Angles(0, h, 0)
	if not spotFree(ctx, cf) then
		return nil
	end
	return cf
end

local function plotBasin(ctx: SpawnCtx): BasePart?
	local plotId = ctx.PlotId
	if plotId == nil then
		return nil
	end
	for _, p in ipairs(ctx.WaterParts) do
		if p:GetAttribute("WE_PlotId") == plotId then
			return p
		end
	end
	return nil
end

local function chooseBoat(ctx: SpawnCtx): (SpawnChoice?, string?)
	local fp = ctx.Footprint
	-- own dock basin, only when a channel links it to the sea
	local function basinChoice(): SpawnChoice?
		local basin = plotBasin(ctx)
		if basin and ctx.PlotPos and (ctx.Structures.Dock or 0) >= 1 and isConnectedToSea(basin, ctx.WaterParts) then
			local bcf = basin.CFrame
			local top = basin.Position.Y + basin.Size.Y * 0.5
			local step = WaterCfg.GridStep
			local pts: { Vector3 } = {}
			local hx, hz = basin.Size.X * 0.5, basin.Size.Z * 0.5
			local nx, nz = math.floor(hx / step), math.floor(hz / step)
			for i = -nx, nx do
				for j = -nz, nz do
					table.insert(pts, Vector3.new(i * step, 0, j * step))
				end
			end
			table.sort(pts, function(a: Vector3, b: Vector3): boolean
				return a.Magnitude < b.Magnitude
			end)
			local byaw = yawOf(bcf)
			for _, lp in ipairs(pts) do
				local wp = bcf:PointToWorldSpace(lp)
				for _, h in ipairs({ byaw, byaw + math.pi / 2 }) do
					local cf = boatSpot(ctx, wp.X, wp.Z, h, top)
					if cf then
						return choice(cf, "DockBasin", "Floating")
					end
				end
			end
		end
		return nil
	end
	-- naval pads by distance (no limit): 8 directions, bow pointing away from the pad
	local function padChoice(): SpawnChoice?
		local origin = ctx.PlayerPos or ctx.PlotPos
		for _, e in ipairs(padsByDistance(ctx.NavalPads, origin, nil, nil)) do
			local pad = e.Pad
			local padHalf = math.max(pad.Size.X, pad.Size.Z) * 0.5
			local away = if origin then flat(pad.Pos - origin) else Vector3.new(0, 0, 1)
			away = if away.Magnitude > 0.05 then away.Unit else Vector3.new(0, 0, 1)
			local dirs: { Vector3 } = {}
			for k = 0, 7 do
				table.insert(dirs, fwd(k * math.pi / 4))
			end
			table.sort(dirs, function(a: Vector3, b: Vector3): boolean
				return a:Dot(away) > b:Dot(away)
			end)
			for _, d in ipairs(dirs) do
				local c = pad.Pos + d * (padHalf + fp.HalfZ + SpawnCfg.NavalPadGap)
				local h = math.atan2(-d.X, -d.Z)
				local cf = boatSpot(ctx, c.X, c.Z, h, pad.Pos.Y)
				if cf then
					return choice(cf, "NavalSpawn", "Floating")
				end
			end
		end
		return nil
	end
	-- centre of the largest water part (and a ring around it)
	local function openChoice(): SpawnChoice?
		local largest: BasePart? = nil
		local area = -1
		for _, p in ipairs(ctx.WaterParts) do
			local a = p.Size.X * p.Size.Z
			if a > area then
				area = a
				largest = p
			end
		end
		if largest then
			local top = largest.Position.Y + largest.Size.Y * 0.5
			local c = largest.Position
			local ring = 2 * footRadius(fp) + SpawnCfg.OffsetStep
			for k = 0, 8 do
				local off = if k == 0 then Vector3.zero else fwd((k - 1) * math.pi / 4) * ring
				local cf = boatSpot(ctx, c.X + off.X, c.Z + off.Z, yawOf(largest.CFrame), top)
				if cf then
					return choice(cf, "OpenWater", "Floating")
				end
			end
		end
		return nil
	end
	-- P1-9: away from your own plot, water right in front of you first (never your dock basin across the map first)
	local function frontChoice(): SpawnChoice?
		local pp = ctx.PlayerPos
		if not pp then
			return nil
		end
		local look = flat(ctx.PlayerLook or Vector3.new(0, 0, -1))
		look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
		local ahead = pp + look * (SpawnCfg.FrontDistance + footRadius(fp))
		local cf = boatSpot(ctx, ahead.X, ahead.Z, math.atan2(-look.X, -look.Z), pp.Y)
		return if cf and inSight(ctx, pp, cf) then choice(cf, "PlayerFront", "Floating") else nil
	end
	local order = if ctx.AwayFromHome then { frontChoice, padChoice, basinChoice, openChoice } else { basinChoice, padChoice, openChoice }
	for _, step in ipairs(order) do
		local c = step()
		if c then
			return c, nil
		end
	end
	return nil, "NoWater"
end

local function chooseSpawn(ctx: SpawnCtx): (SpawnChoice?, string?)
	local mode = ctx.Mode
	if mode == "Boat" then
		return chooseBoat(ctx)
	elseif mode == "Heli" then
		return chooseHeli(ctx), nil
	elseif mode == "Plane" then
		return choosePlane(ctx), nil
	end
	return chooseCar(ctx), nil
end

-- Real-world ctx (raycasts, pads, water, other vehicles)
local function characterList(): { Instance }
	local list: { Instance } = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character
		if ch then
			table.insert(list, ch)
		end
	end
	return list
end

local function exclusionList(withWater: boolean, withPads: boolean): { Instance }
	local list = characterList()
	table.insert(list, ensureFolder())
	if withWater then
		for _, w in ipairs(getWaterParts()) do
			table.insert(list, w)
		end
	end
	if withPads then
		for _, tag in ipairs({ Constants.Tags.VehicleSpawn, Constants.Tags.NavalSpawn }) do
			for _, inst in ipairs(CollectionService:GetTagged(tag)) do
				table.insert(list, inst)
			end
		end
	end
	return list
end

local function rayParams(exclude: { Instance }): RaycastParams
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = exclude
	rp.RespectCanCollide = true
	return rp
end

local function findPlotPart(plotId: any): BasePart?
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.BasePlot)) do
		if inst:IsA("BasePart") and inst:GetAttribute("PlotId") == plotId then
			return inst
		end
	end
	return nil
end

-- P1-9: pos on the plot pad's rectangle (plot-local XZ, grown by OwnPlotMargin)
local function insidePlot(plot: BasePart, pos: Vector3): boolean
	local lp = plot.CFrame:PointToObjectSpace(pos)
	local m = SpawnCfg.OwnPlotMargin
	return math.abs(lp.X) <= plot.Size.X * 0.5 + m and math.abs(lp.Z) <= plot.Size.Z * 0.5 + m
end

-- P1-9: the player stands inside their own plot (nil plot / no character → false)
local function playerAtHome(player: Player, profile: any): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) or not (profile and profile.BasePlotId) then
		return false
	end
	local plot = findPlotPart(profile.BasePlotId)
	return plot ~= nil and insidePlot(plot, root.Position)
end

local function buildSpawnCtx(player: Player, profile: any, mode: string, fp: Footprint, attrs: { [string]: any }, exclude: Model?): SpawnCtx
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local playerPos: Vector3? = nil
	local playerLook: Vector3? = nil
	if root and root:IsA("BasePart") then
		playerPos = root.Position
		playerLook = root.CFrame.LookVector
	end
	local plotPos: Vector3? = nil
	local plotCFrame: CFrame? = nil
	local plotId: number? = nil
	local awayFromHome = false
	if profile and profile.BasePlotId then
		local plot = findPlotPart(profile.BasePlotId)
		if plot then
			plotPos = plot.Position
			plotCFrame = plot.CFrame -- C1: the pad carries the plot yaw
			plotId = tonumber(profile.BasePlotId)
			awayFromHome = playerPos ~= nil and not insidePlot(plot, playerPos)
		end
	end
	-- C5: someone else's DockWater / SeaGateWater is not water for this player's boats
	local ownPlotId: number? = if profile then tonumber(profile.BasePlotId) else nil
	local structures: { [string]: number } = {}
	if profile and typeof(profile.BaseUpgrades) == "table" then
		for k, v in pairs(profile.BaseUpgrades) do
			if typeof(k) == "string" then
				structures[k] = tonumber(v) or 0
			end
		end
	end
	local vehiclePads: { SpawnPad } = {}
	local navalPads: { SpawnPad } = {}
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.VehicleSpawn)) do
		if inst:IsA("BasePart") and inst.Parent then
			table.insert(vehiclePads, {
				Pos = inst.Position,
				CFrame = inst.CFrame,
				Size = inst.Size,
				Naval = CollectionService:HasTag(inst, Constants.Tags.NavalSpawn),
			})
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(Constants.Tags.NavalSpawn)) do
		if inst:IsA("BasePart") and inst.Parent then
			table.insert(navalPads, { Pos = inst.Position, CFrame = inst.CFrame, Size = inst.Size, Naval = true })
		end
	end
	local occupied: { OccupiedSpot } = {}
	for m, rec in pairs(vehicles) do
		if m ~= exclude and m.Parent and rec.Chassis.Parent then
			local hx = tonumber(m:GetAttribute("WE_HalfWidth")) or 4
			local hz = tonumber(m:GetAttribute("WE_HalfLength")) or 6
			table.insert(occupied, { Pos = rec.Chassis.Position, Radius = math.max(hx, hz) })
		end
	end
	local groundEx = rayParams(exclusionList(true, false))
	local ctx: SpawnCtx = {
		Mode = mode,
		PlayerPos = playerPos,
		PlayerLook = playerLook,
		PlotPos = plotPos,
		PlotCFrame = plotCFrame,
		PlotId = plotId,
		Structures = structures,
		Footprint = fp,
		TakeoffSpeed = tonumber(attrs.WE_TakeoffSpeed),
		VehiclePads = vehiclePads,
		NavalPads = navalPads,
		WaterParts = waterPartsFor(ownPlotId),
		Occupied = occupied,
		SurfaceY = function(x: number, z: number, refY: number): number?
			local hit = Workspace:Raycast(Vector3.new(x, refY + 10, z), Vector3.new(0, -40, 0), groundEx)
			return if hit then hit.Position.Y else nil
		end,
		LandProbe = function(x: number, z: number, top: number): boolean
			local h = WaterCfg.LandProbeHeight
			local hit = Workspace:Raycast(Vector3.new(x, top + h, z), Vector3.new(0, -(h + 0.05), 0), groundEx)
			return hit ~= nil and hit.Position.Y > top - 0.05
		end,
		BoxFree = function(cf: CFrame, half: Vector3): boolean
			local op = OverlapParams.new()
			op.FilterType = Enum.RaycastFilterType.Exclude
			op.FilterDescendantsInstances = exclusionList(true, true)
			op.RespectCanCollide = true
			op.MaxParts = 1
			local hits = Workspace:GetPartBoundsInBox(cf, half * 2, op)
			return #hits == 0
		end,
		AwayFromHome = awayFromHome,
		AllWater = getWaterParts(),
		Clear = function(from: Vector3, to: Vector3): boolean
			return Workspace:Raycast(from, to - from, groundEx) == nil
		end,
	}
	return ctx
end

-- ── Vehicle records: ownership handoff, idle, fallback, checks ─────────────────────────────────
local function setAuthority(rec: VehicleRec, authority: string)
	if rec.Authority ~= authority then
		rec.Authority = authority
		rec.Model:SetAttribute("WE_DriveAuthority", authority)
	end
	-- the client may have written the movers: the next server write always goes through
	rec.OutVel = nil
	rec.OutHold = nil
	rec.OutRot = nil
end

local function applyOut(rec: VehicleRec, out: DriveOut)
	local lv, ao = rec.LV, rec.AO
	if lv.Parent == nil or ao.Parent == nil then
		return
	end
	if rec.OutVel ~= out.Velocity then
		lv.VectorVelocity = out.Velocity
		rec.OutVel = out.Velocity
	end
	if rec.OutHold ~= out.HoldVertical then
		local f = rec.Force
		lv.MaxAxesForce = Vector3.new(f, if out.HoldVertical then f else 0, f)
		rec.OutHold = out.HoldVertical
	end
	local rot = out.Orientation.Rotation
	if rec.OutRot ~= rot then
		ao.CFrame = rot
		rec.OutRot = rot
	end
	if rec.Mode == "Car" then
		-- rollover fix: a flip recovery levels the car gently (Car.RecoverSpin), then the normal limit comes back
		local spin = if out.Righting == true then CarCfg.RecoverSpin else CarCfg.MaxAngularVelocity
		if ao.MaxAngularVelocity ~= spin then
			ao.MaxAngularVelocity = spin
		end
	end
end

local function refreshMoverLimits(rec: VehicleRec)
	local mass = (rec.Chassis :: any).AssemblyMass
	if typeof(mass) ~= "number" or mass <= 0 then
		mass = estimateMass(rec.Model)
	end
	local hold = rec.OutHold
	if hold == nil then
		hold = rec.LV.MaxAxesForce.Y > 0
	end
	rec.Force = setMoverLimits(rec.LV, rec.AO, rec.Chassis, rec.Mode, rec.Def.Seats or 1, mass, hold == true)
end

local function playerOfHumanoid(hum: Instance?): Player?
	if hum == nil then
		return nil
	end
	local char = hum.Parent
	if char == nil then
		return nil
	end
	return Players:GetPlayerFromCharacter(char)
end

local function seatedDriver(rec: VehicleRec): Player?
	return playerOfHumanoid(rec.Seat.Occupant)
end

local function ejectSeat(seat: BasePart)
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
end

local function zeroVelocity(part: BasePart)
	pcall(function()
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function setNetworkOwner(part: BasePart, owner: Player?): boolean
	local ok = pcall(function()
		part:SetNetworkOwner(owner)
	end)
	return ok
end

-- Every assembly the vehicle is made of: the chassis (+ welded kit, seats, catalog dress) and each hinge wheel.
local function ownPartsOf(model: Model, chassis: BasePart): { BasePart }
	local list: { BasePart } = { chassis }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("WE_PhysicsWheel") == true then
			table.insert(list, d)
		end
	end
	return list
end

-- Whoever simulates owns everything: the chassis assembly and every wheel assembly (true = no call refused).
local function setOwner(rec: VehicleRec, owner: Player?): boolean
	local ok = true
	for _, p in ipairs(rec.OwnParts) do
		if p.Parent ~= nil and not setNetworkOwner(p, owner) then
			ok = false
		end
	end
	return ok
end

--[[ ("drv" | "srv" | "split" | "oth" | "unk", per-part detail "drv,drv,srv,…"). GetNetworkOwner is server-only and
	errors on anchored parts ("err"); an unreadable part is not evidence of a wrong owner ("unk" = the probe neither
	counts nor clears; a pinned car is caught by the no-motion check instead). ]]
local function ownerState(rec: VehicleRec, driver: Player?): (string, string)
	local tags: { string } = {}
	local allDrv, allSrv, anyOth, anyErr = true, true, false, false
	for i, p in ipairs(rec.OwnParts) do
		local ok, o = pcall(function(): Player?
			return p:GetNetworkOwner()
		end)
		local tag = if not ok then "err" elseif o == nil then "srv" elseif o == driver then "drv" else "oth"
		tags[i] = tag
		if tag == "err" then
			anyErr = true
		else
			allDrv = allDrv and tag == "drv"
			allSrv = allSrv and tag == "srv"
			anyOth = anyOth or tag == "oth"
		end
	end
	local st = if anyOth then "oth" elseif anyErr and allDrv then "unk" elseif allDrv then "drv" elseif allSrv and not anyErr then "srv" else "split"
	return st, table.concat(tags, ",")
end

local function resetValid(rec: VehicleRec, t: number)
	local cf = rec.Chassis.CFrame
	rec.LastValid = { CFrame = cf, Pos = cf.Position, T = t }
	rec.Window = { Pos = cf.Position, T = t }
	rec.LastSampleT = t
	rec.LastSamplePos = cf.Position
	rec.SpeedFlags = 0
	rec.OffWaterFor = 0
end

local function anyOccupied(rec: VehicleRec): boolean
	if rec.Seat.Occupant ~= nil then
		return true
	end
	for _, s in ipairs(rec.Passengers) do
		if s.Parent and s.Occupant ~= nil then
			return true
		end
	end
	return false
end

local aglParams: RaycastParams? = nil
local aglParamsAt = -math.huge

local function groundRayParams(t: number): RaycastParams
	local cached = aglParams
	if cached and t - aglParamsAt < WaterCfg.RefreshSeconds then
		return cached
	end
	local rp = rayParams(exclusionList(false, false))
	aglParams = rp
	aglParamsAt = t
	return rp
end

-- C5: the water this boat may use (its owner's plot water + public water). Owner's BasePlotId is read live from
-- the profile (nil until the real save loaded → public water only).
local function recWaterParts(rec: VehicleRec): { BasePart }
	local owner: Player? = rec.Owner
	local profile = if owner and DataService then DataService.GetProfile(owner) else nil
	return waterPartsFor(if profile then tonumber(profile.BasePlotId) else nil)
end

local function senseFor(rec: VehicleRec, t: number): DriveSense
	local cf = rec.Chassis.CFrame
	local pos = cf.Position
	local agl = math.huge
	if rec.Mode == "Heli" or rec.Mode == "Plane" then
		local hit = Workspace:Raycast(pos, Vector3.new(0, -600, 0), groundRayParams(t))
		if hit then
			agl = (pos.Y - hit.Position.Y) - (tonumber(rec.Model:GetAttribute("WE_GroundClearance")) or 0)
		end
	end
	local waterY: number? = nil
	if rec.Mode == "Boat" then
		waterY = waterSurfaceAt(recWaterParts(rec), pos, 0, nil)
	end
	-- rollover fix: only a flipped car asks whether another player is within reach (5 Hz at most)
	local clear: boolean? = nil
	if rec.Mode == "Car" and cf.UpVector.Y < CarCfg.FlipUpY then
		if rec.ClearAt == nil or t - (rec.ClearAt :: number) >= 0.2 then
			local reach = math.max(rec.Params.HalfLength, tonumber(rec.Model:GetAttribute("WE_HalfWidth")) or 0)
			rec.ClearAt = t
			rec.ClearVal = not VehicleService._OthersNear(rec.Model, pos, reach + CarCfg.RecoverClearRadius)
		end
		clear = rec.ClearVal
	end
	return {
		Position = pos,
		Velocity = partVelocity(rec.Chassis),
		Yaw = yawOf(cf),
		UpY = cf.UpVector.Y,
		AGL = agl,
		WaterY = waterY,
		Time = t,
		Clear = clear,
	}
end

local function idleStep(rec: VehicleRec, t: number, dt: number)
	if rec.Idle.ReturnPos == nil then
		rec.Idle.ReturnPos = rec.LastValid.Pos
	end
	local out = idleTarget(rec.Mode, rec.Params, rec.Idle, senseFor(rec, t), dt)
	applyOut(rec, out)
end

local function seatInput(seat: VehicleSeat): DriveInput
	-- a dead driver's client stops updating the seat: its last ThrottleFloat (e.g. W held when killed) is stale
	local occ = seat.Occupant
	if occ == nil or (tonumber(occ.Health) or 0) <= 0 then
		return { Throttle = 0, Steer = 0, Lift = 0, Strafe = 0 }
	end
	return { Throttle = unitInput(seat.ThrottleFloat), Steer = unitInput(seat.SteerFloat), Lift = 0, Strafe = 0 }
end

-- F5b: the client's input stream while fresh, else the seat floats (an old cached client sends no stream)
local function serverInput(rec: VehicleRec, t: number): DriveInput
	local occ = rec.Seat.Occupant
	if occ == nil or (tonumber(occ.Health) or 0) <= 0 then
		return { Throttle = 0, Steer = 0, Lift = 0, Strafe = 0 }
	end
	local at = rec.InAt
	if at ~= nil and t - at <= W.StreamStaleSeconds then
		return { Throttle = rec.InT, Steer = rec.InS, Lift = rec.InL, Strafe = 0 }
	end
	return seatInput(rec.Seat)
end

--[[ "The driver is pushing" = input that must move this vehicle. Car/Boat: |throttle| (spec). Aircraft refine
	the spec's rule so nothing trips on a landed craft: a landed heli ignores the stick until it lifts off (lift up
	only), and a plane's throttle-back at rest moves nothing (throttle forward only). ]]
local function pushing(rec: VehicleRec, input: DriveInput): boolean
	local th = W.PushThrottle
	if rec.Mode == "Heli" then
		return input.Lift > th
	elseif rec.Mode == "Plane" then
		return input.Throttle > th
	end
	return math.abs(input.Throttle) > th
end

-- F5i diagnostics: what could pin this vehicle (anchored parts, foreign movers / joints, movers in its riders)
local CONSTRAINT_CLASSES: { [string]: boolean } = {
	AlignOrientation = true, AlignPosition = true, AngularVelocity = true, BallSocketConstraint = true,
	HingeConstraint = true, LineForce = true, LinearVelocity = true, PlaneConstraint = true, Plane = true,
	PrismaticConstraint = true, CylindricalConstraint = true, RigidConstraint = true, RodConstraint = true,
	RopeConstraint = true, SpringConstraint = true, Torque = true, TorsionSpringConstraint = true,
	UniversalConstraint = true, VectorForce = true, AnimationConstraint = true,
}
local BODYMOVER_CLASSES: { [string]: boolean } = {
	BodyAngularVelocity = true, BodyForce = true, BodyGyro = true, BodyPosition = true, BodyThrust = true,
	BodyVelocity = true, RocketPropulsion = true,
}
local JOINT_CLASSES: { [string]: boolean } = {
	Weld = true, Motor = true, Motor6D = true, Snap = true, ManualWeld = true, Glue = true, ManualGlue = true,
	Rotate = true, RotateP = true, RotateV = true, VelocityMotor = true,
}

local function isMover(d: Instance): boolean
	local c = d.ClassName
	return BODYMOVER_CLASSES[c] == true or CONSTRAINT_CLASSES[c] == true or d:IsA("BodyMover") or d:IsA("Constraint")
end

local function isOwnDriveObject(d: Instance): boolean
	local n = d.Name
	return n == "WE_DriveLV"
		or n == "WE_DriveAO"
		or n == "WE_UprightAO" -- rollover fix: our own roll / pitch assist, not a pin
		or n == "SeatWeld"
		or string.sub(n, 1, 17) == "WE_WheelNoCollide"
		or (d:IsA("HingeConstraint") and d:GetAttribute("WE_DriveHinge") == true)
end

local function riderCharacters(rec: VehicleRec): { Instance }
	local list: { Instance } = {}
	local seats: { BasePart } = { rec.Seat }
	for _, s in ipairs(rec.Passengers) do
		table.insert(seats, s)
	end
	for _, s in ipairs(seats) do
		local occ = if s.Parent then (s :: any).Occupant else nil
		local ch = if occ then occ.Parent else nil
		if ch then
			table.insert(list, ch)
		end
	end
	return list
end

local function countPins(rec: VehicleRec): (number, string)
	local n = 0
	local names: { string } = {}
	local function add(what: string)
		n += 1
		if #names < 3 then
			table.insert(names, what)
		end
	end
	for _, d in ipairs(rec.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Anchored then
				add("anchored:" .. d.Name)
			end
		elseif (isMover(d) or JOINT_CLASSES[d.ClassName] == true or d:IsA("JointInstance")) and not isOwnDriveObject(d) then
			add(d.ClassName .. ":" .. d.Name)
		end
	end
	for _, ch in ipairs(riderCharacters(rec)) do
		for _, d in ipairs(ch:GetDescendants()) do
			if d:IsA("BasePart") then
				if d.Anchored then
					add("rider-anchored:" .. d.Name)
				end
			elseif isMover(d) then
				local c = d.ClassName
				if c ~= "AnimationConstraint" and c ~= "BallSocketConstraint" and c ~= "HingeConstraint" then
					add("rider-" .. c .. ":" .. d.Name)
				end
			end
		end
	end
	return n, table.concat(names, ",")
end

-- occupied passenger seats whose occupant is not a player (F8 ejects them; the log proves it)
local function npcRiders(rec: VehicleRec): number
	local n = 0
	for _, s in ipairs(rec.Passengers) do
		local occ = if s.Parent then s.Occupant else nil
		if occ ~= nil and playerOfHumanoid(occ) == nil then
			n += 1
		end
	end
	return n
end

local function signed(x: number): string
	return string.format("%+.2f", x)
end

-- a client-sent field for a log line: short, printable
local function logField(v: any): string
	local str = string.sub(tostring(v), 1, 16)
	return (string.gsub(str, "[^%w%.%+%-_]", "?"))
end

local function movedFromSit(rec: VehicleRec): number
	local from = rec.HandOffPos
	if from == nil then
		return 0
	end
	local d = rec.Chassis.Position - from
	return if rec.Mode == "Heli" or rec.Mode == "Plane" then d.Magnitude else Vector3.new(d.X, 0, d.Z).Magnitude
end

-- one server log line (F5i)
local function diagLine(rec: VehicleRec, t: number, head: string, extra: any?): string
	local st, detail = ownerState(rec, rec.Owner)
	local seat = rec.Seat
	local ex = ""
	if typeof(extra) == "table" then
		ex = string.format(" extra=T=%s Spd=%s R=%s Src=%s", logField(extra.T), logField(extra.Spd), logField(extra.R), logField(extra.Src))
	end
	local inAge = if rec.InAt ~= nil then string.format("%.1f", t - (rec.InAt :: number)) else "-"
	return string.format(
		"[VehicleService] %s u=%d %s auth=%s own=%s(%s) hello=%d in=%s/%s@%s seatT=%s/%s lvS=%.1f moved=%.1f pins=%d(%s) npc=%d catalog=%s%s",
		head,
		rec.OwnerUserId,
		tostring(rec.Def.Id),
		rec.Authority,
		st,
		detail,
		if rec.HelloAt ~= nil then 1 else 0,
		signed(rec.InT),
		signed(rec.InS),
		inAge,
		signed(unitInput(seat.ThrottleFloat)),
		signed(unitInput(seat.SteerFloat)),
		rec.LV.VectorVelocity.Magnitude,
		movedFromSit(rec),
		rec.Pins,
		rec.PinList,
		npcRiders(rec),
		tostring(rec.Model:GetAttribute("WE_CatalogAssetId") or "-"),
		ex
	)
end

-- F5j: the compact WE_Diag attribute (debug users only); the client's NO DRIVE line parses these key=value pairs
local function diagCompact(rec: VehicleRec): string
	local st = ownerState(rec, rec.Owner)
	local seat = rec.Seat
	return string.format(
		"own=%s hello=%d in=%s/%s seat=%s/%s lv=%.0f moved=%.1f pins=%d npc=%d fail=%s",
		st,
		if rec.HelloAt ~= nil then 1 else 0,
		signed(rec.InT),
		signed(rec.InS),
		signed(unitInput(seat.ThrottleFloat)),
		signed(unitInput(seat.SteerFloat)),
		rec.LV.VectorVelocity.Magnitude,
		movedFromSit(rec),
		rec.Pins,
		npcRiders(rec),
		rec.BrokenReason or "-"
	)
end

-- Fallback / trip: the server runs the Car / Boat law from the client's input stream (or the seat floats).
local function fallbackStep(rec: VehicleRec, t: number, dt: number)
	local sense = senseFor(rec, t)
	local st: DriveState = rec.Fallback or newDriveState(sense)
	rec.Fallback = st
	local input = serverInput(rec, t)
	local out: DriveOut
	if rec.Mode == "Boat" then
		local dir, near, far = boatProbe(st, rec.Params, input)
		local f = fwd(st.Heading) * dir
		local parts = recWaterParts(rec)
		sense.WaterNear = waterSurfaceAt(parts, sense.Position + f * near, 0, nil) ~= nil
		sense.WaterFar = waterSurfaceAt(parts, sense.Position + f * far, 0, nil) ~= nil
		out = boatStep(st, rec.Params, input, sense, dt)
	else
		out = carStep(st, rec.Params, input, sense, dt)
	end
	applyOut(rec, out)
end

-- Car fallback (name kept from v27-v69; the old server LV + "LV+HingeMotor" path is gone: wheels roll
-- free and the WE_DriveLV / WE_DriveAO movers carry the car). Boats share the same loop.
-- F5c: the server both drives and simulates (owns every assembly), so its own mover values act.
local function startGroundDrive(rec: VehicleRec, t: number)
	setAuthority(rec, "Fallback")
	if not setOwner(rec, nil) then
		warn("[VehicleService] Fallback: SetNetworkOwner(nil) refused", rec.Def.Id) -- server writes still replicate to the owner
	end
	rec.Fallback = newDriveState(senseFor(rec, t))
	if rec.Mode == "Car" then
		rec.Model:SetAttribute("WE_GroundDrive", "Fallback")
	end
end

local function stopDrive(rec: VehicleRec)
	rec.Fallback = nil
	if rec.Mode == "Car" then
		rec.Model:SetAttribute("WE_GroundDrive", "Client")
	end
end

-- Driver (owner) seated: give them the physics. fresh = a new sit (vs the end of a correction). F5d.
local function handOff(rec: VehicleRec, player: Player, t: number, fresh: boolean)
	rec.CorrectUntil = nil
	rec.CorrectPos = nil
	rec.DriverUserId = player.UserId
	rec.Model:SetAttribute("WE_DriverUserId", player.UserId)
	local ground = rec.Mode == "Car" or rec.Mode == "Boat"
	if fresh then
		rec.SatAt = t
		rec.HelloAt = nil
		rec.HelloTimedOut = false
		rec.ClientProven = false
		rec.PushSince = nil
		rec.PushPos = nil
		rec.OwnerBad = 0
		rec.BlockPush = 0
		rec.BlockLogged = false
		rec.TripAt = nil
		rec.TripPos = nil
		rec.TripSign, rec.TripLook = nil, nil
		rec.InT, rec.InS, rec.InL, rec.InAt = 0, 0, 0, nil
		rec.HandOffPos = rec.Chassis.Position
		rec.HandOffAt = t
		rec.NextOwnerProbe = t + 0.5
		rec.NextDiagAt = t
		rec.NextDiagLogAt = t
		rec.ClientBroken = ground and W.Enabled and (brokenTrips[player.UserId] or 0) >= W.SessionTrips
		rec.BrokenReason = if rec.ClientBroken then "session" else nil
		rec.ServerProven = rec.ClientBroken
		rec.Model:SetAttribute("WE_DriveFail", rec.BrokenReason)
		rec.Pins, rec.PinList = countPins(rec)
	end
	resetValid(rec, t)
	rec.NextSampleAt = t + 1 / Valid.SampleHz
	stopDrive(rec)
	if ground and (rec.ClientBroken or (rec.HelloTimedOut and rec.HelloAt == nil)) then
		startGroundDrive(rec, t)
		return
	end
	if not setOwner(rec, player) then
		warn("[VehicleService] SetNetworkOwner(driver) refused", rec.Def.Id)
		if ground then
			rec.ClientBroken = true
			rec.BrokenReason = "owner-refused"
			rec.TripAt = t
			rec.TripPos = rec.Chassis.Position
			rec.TripSign = 0 -- no push involved: any server-driven motion proves the client link was the fault
			rec.ServerProven = false
			rec.Model:SetAttribute("WE_DriveFail", "owner-refused")
			startGroundDrive(rec, t)
			return
		end
	end
	setAuthority(rec, "Client")
end

--[[ F5e: a character that left a (possibly server-owned) vehicle assembly goes back to its player explicitly, on the
	next deferred tick (after the SeatWeld is gone). Harmless when the player already owns it. ]]
local function handBackCharacter(player: Player, chassis: BasePart)
	task.defer(function()
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") and not hrp.Anchored and hrp.AssemblyRootPart ~= chassis.AssemblyRootPart then
			pcall(function()
				hrp:SetNetworkOwner(player)
			end)
		end
	end)
end

-- Nobody in the driver seat: the server owns the physics and runs the idle law. F5e.
local function releaseToServer(rec: VehicleRec, t: number)
	local leaving = if rec.DriverUserId ~= 0 then Players:GetPlayerByUserId(rec.DriverUserId) else nil
	stopDrive(rec)
	rec.CorrectUntil = nil
	rec.CorrectPos = nil
	rec.DriverUserId = 0
	rec.Model:SetAttribute("WE_DriverUserId", 0)
	rec.SatAt = nil
	rec.HelloAt = nil
	rec.HelloTimedOut = false
	rec.InT, rec.InS, rec.InL, rec.InAt = 0, 0, 0, nil
	setAuthority(rec, "Server")
	setOwner(rec, nil)
	rec.Idle = {}
	rec.NextIdleAt = t
	rec.LastSeatedAt = t
	if rec.Model:GetAttribute("WE_Diag") ~= nil then
		rec.Model:SetAttribute("WE_Diag", nil)
	end
	if leaving then
		handBackCharacter(leaving, rec.Chassis)
	end
end

local function ejectDriver(rec: VehicleRec)
	ejectSeat(rec.Seat)
end

local function forgetVehicle(model: Model)
	local rec = vehicles[model]
	vehicles[model] = nil
	pcall(VehicleService._VehicleHealth.Unregister, model) -- W2: HP record goes with the vehicle
	if rec then
		for _, c in ipairs(rec.Conns) do
			c:Disconnect()
		end
		table.clear(rec.Conns)
		rec.Fallback = nil
		-- the vehicle goes away with riders in it (recall, SPAWN of another, despawn): their characters were part of
		-- the vehicle assembly, which the server may own; give each character back to its player
		local seats: { BasePart } = { rec.Seat }
		for _, ps in ipairs(rec.Passengers) do
			table.insert(seats, ps)
		end
		for _, seat in ipairs(seats) do
			local rider = playerOfHumanoid((seat :: any).Occupant)
			if rider then
				handBackCharacter(rider, rec.Chassis)
			end
		end
	end
end

local function destroyActive(userId: number)
	local model = activeVehicles[userId]
	activeVehicles[userId] = nil
	if model then
		forgetVehicle(model)
		-- Ensure kit parts / welds / seats are fully cleaned
		pcall(function()
			model:Destroy()
		end)
	end
end

local function destroyVehicle(rec: VehicleRec, message: string?)
	local uid = rec.OwnerUserId
	if activeVehicles[uid] == rec.Model then
		destroyActive(uid)
	else
		forgetVehicle(rec.Model)
		pcall(function()
			rec.Model:Destroy()
		end)
	end
	local owner = rec.Owner
	if owner.Parent then
		if message then
			notify(owner, message, "Warn", 4)
		end
		pcall(pushState, owner)
	end
end

local function recallVehicle(rec: VehicleRec, reason: string)
	if AntiExploitService and AntiExploitService.Strike then
		pcall(AntiExploitService.Strike, rec.Owner, "vehicle_" .. reason)
	end
	warn("[VehicleService] recalled", rec.Owner.Name, rec.Def.Id, reason)
	destroyVehicle(rec, "Vehicle recalled")
end

-- Violation: take the physics back and put the vehicle at its last valid position.
local function beginCorrection(rec: VehicleRec, t: number)
	stopDrive(rec)
	setAuthority(rec, "Server")
	local released = setOwner(rec, nil)
	local back = rec.LastValid
	pcall(function()
		rec.Model:PivotTo(back.CFrame)
	end)
	zeroVelocity(rec.Chassis)
	rec.CorrectUntil = t + Valid.CorrectionHold
	rec.CorrectPos = back.Pos
	-- a plane glides at the idle minimum during the hold (bounded, so correctionStep can tell it from a client
	-- that kept the physics)
	rec.Idle = { ReturnPos = back.Pos, GlideSpeed = if rec.Mode == "Plane" then PlaneCfg.IdleGlideMinSpeed else nil }
	rec.NextIdleAt = t
	rec.NextSampleAt = t + 1 / Valid.SampleHz
	resetValid(rec, t)
	if not released then
		ejectDriver(rec) -- ownership cannot be taken back with the driver seated
	end
	if t - rec.LastStabilisedAt >= Drive.StabilisedNoticeSeconds then
		rec.LastStabilisedAt = t
		notify(rec.Owner, "Vehicle stabilised", "Warn", 3)
	end
end

local function onViolation(rec: VehicleRec, reason: string, soft: boolean, t: number)
	if not soft then
		local kept: { number } = {}
		for _, at in ipairs(rec.Violations) do
			if t - at <= Valid.RecallWindow then
				table.insert(kept, at)
			end
		end
		table.insert(kept, t)
		rec.Violations = kept
		if #kept >= Valid.RecallViolations then
			recallVehicle(rec, reason)
			return
		end
	end
	beginCorrection(rec, t)
end

--[[ One 5 Hz check. (ok, reason?, soft). Measures teleports from the last VALID sample (a lag burst
	passes); LastValid only advances when fresh data arrived (the position changed) or the vehicle is
	really at rest, so a frozen replication stream does not shrink the allowance. ]]
local function validateSample(rec: VehicleRec, s: ValidSample): (boolean, string?, boolean)
	local mode = rec.Mode
	local air = mode == "Heli" or mode == "Plane"
	local cap = rec.Params.MaxSpeed * Valid.SpeedTolerance + (if air then Valid.AirSpeedSlack else Valid.SpeedSlack)
	local pos, vel = s.Pos, s.Vel
	local speed = if air then vel.Magnitude else flat(vel).Magnitude
	local prevT = rec.LastSampleT or s.T
	local prevPos = rec.LastSamplePos or pos
	local dtS = math.max(0, s.T - prevT)
	rec.LastSampleT = s.T
	rec.LastSamplePos = pos
	local box: { X: number, ZMin: number, ZMax: number, MaxY: number }?, sl: number = nil, 0
	if air then
		box, sl = VehicleService._AirBox()
	end
	if box then
		-- aircraft: past the air box + slack while still moving OUT through that edge (the client law stops a pilot
		-- Buffer studs inside the box and only ever steers one that is outside it back in — e.g. spawned in the live
		-- map's outer desert while World v2's ground wall is unhooked); the air wall is the backstop
		local ow = tonumber(((Drive :: any).AirBox or {}).ValidatorOutwardSpeed) or 8
		if
			(pos.X > box.X + sl and vel.X > ow)
			or (pos.X < -box.X - sl and vel.X < -ow)
			or (pos.Z > box.ZMax + sl and vel.Z > ow)
			or (pos.Z < box.ZMin - sl and vel.Z < -ow)
		then
			return false, "bounds", false
		end
	end
	if math.abs(pos.X) > Valid.WorldHalfExtent or math.abs(pos.Z) > Valid.WorldHalfExtent then
		return false, "bounds", false
	end
	local lv = rec.LastValid
	local dtV = math.clamp(s.T - lv.T, 0, Valid.MaxLagWindow)
	local allow = cap * dtV + Valid.TeleportSlack
	local dist = (pos - lv.Pos).Magnitude
	if dist > allow then
		return false, "teleport", dist <= allow + Valid.HardTeleport
	end
	-- Per-sample slack adds up: 20 studs every 0.2 s let a client that reports a sub-cap velocity move at
	-- cap + 100 studs/s (a 55 car at 180). Over a ~1 s window the slack is granted once.
	local win = rec.Window
	if win then
		local wdist = (pos - win.Pos).Magnitude
		local wallow = cap * math.max(0, s.T - win.T) + Valid.TeleportSlack
		if wdist > wallow then
			return false, "teleport", wdist <= wallow + Valid.HardTeleport
		end
	end
	if air then
		-- the client law's ceiling: min(WE_MaxAltitude, air box MaxY)
		local ceiling = if box then math.min(rec.MaxAltitude, box.MaxY) else rec.MaxAltitude
		if pos.Y > ceiling + Valid.AirAltitudeSlack then
			return false, "altitude", false
		end
	else
		if pos.Y > Valid.GroundMaxY then
			return false, "altitude", false
		end
		if mode == "Car" and vel.Y > Valid.MaxGroundUpSpeed then
			return false, "fling", false
		end
	end
	if speed > cap then
		rec.SpeedFlags += 1
		if rec.SpeedFlags >= Valid.SpeedSamplesToFlag then
			rec.SpeedFlags = 0
			return false, "speed", false
		end
	else
		rec.SpeedFlags = 0
	end
	local overWater = true
	if mode == "Boat" then
		if waterSurfaceAt(recWaterParts(rec), pos, Valid.OffWaterMargin, nil) == nil then
			overWater = false
			rec.OffWaterFor += dtS
			if rec.OffWaterFor > Valid.OffWaterGrace then
				rec.OffWaterFor = 0
				return false, "offwater", true
			end
		else
			rec.OffWaterFor = 0
		end
		local wy = s.WaterY
		if wy ~= nil and pos.Y > wy + Valid.BoatMaxAboveWater then
			return false, "altitude", false
		end
	end
	local fresh = (pos - prevPos).Magnitude > 0.01 or vel.Magnitude < 0.5
	if overWater and fresh then
		rec.LastValid = { CFrame = s.CFrame or CFrame.new(pos), Pos = pos, T = s.T }
		if win == nil or s.T - win.T >= Valid.WindowSeconds then
			rec.Window = { Pos = pos, T = s.T }
		end
	end
	return true, nil, false
end

local function sampleAndCheck(rec: VehicleRec, t: number)
	local cf = rec.Chassis.CFrame
	local pos = cf.Position
	local sample: ValidSample = {
		Pos = pos,
		Vel = partVelocity(rec.Chassis),
		T = t,
		WaterY = if rec.Mode == "Boat" then waterSurfaceAt(recWaterParts(rec), pos, 0, nil) else nil,
		CFrame = cf,
	}
	local ok, reason, soft = validateSample(rec, sample)
	if not ok and reason then
		onViolation(rec, reason, soft, t)
	end
end

-- How fast the idle law itself may carry the vehicle during a correction hold (studs/s). Without this an
-- airborne plane (idle glide ~31 studs/s) drifted past TeleportSlack in ~0.7 s and its pilot was ejected mid-air.
local function idleDriftSpeed(mode: string): number
	if mode == "Plane" then
		return PlaneCfg.IdleGlideMinSpeed + PlaneCfg.IdleGlideSink
	elseif mode == "Heli" then
		return HeliCfg.IdleSink
	elseif mode == "Boat" then
		return BoatCfg.AgroundSpeed + BoatCfg.IdleMaxVy
	end
	return 0
end

local function correctionStep(rec: VehicleRec, t: number)
	local until_ = rec.CorrectUntil
	if until_ == nil then
		return
	end
	if t >= rec.NextSampleAt then
		rec.NextSampleAt = t + 1 / Valid.SampleHz
		local cp = rec.CorrectPos
		local held = math.max(0, t - (until_ - Valid.CorrectionHold))
		if cp and (rec.Chassis.Position - cp).Magnitude > Valid.TeleportSlack + held * idleDriftSpeed(rec.Mode) then
			-- still moving away: the client kept the physics → eject the driver and put it back
			ejectDriver(rec)
			local back = rec.LastValid
			pcall(function()
				rec.Model:PivotTo(back.CFrame)
			end)
			zeroVelocity(rec.Chassis)
		end
	end
	if t >= until_ then
		rec.CorrectUntil = nil
		rec.CorrectPos = nil
		local driver = seatedDriver(rec)
		if driver and driver == rec.Owner then
			handOff(rec, driver, t, false)
		end
	end
end

-- F5g: the client-simulation link is broken for this sit → server drive (Car/Boat) or a notice (aircraft).
local function trip(rec: VehicleRec, reason: string, t: number, extra: any?)
	if rec.ClientBroken then
		return
	end
	rec.ClientBroken = true
	rec.BrokenReason = reason
	rec.TripAt = t
	rec.TripPos = rec.Chassis.Position
	local th = serverInput(rec, t).Throttle
	rec.TripSign = if th > W.PushThrottle then 1 elseif th < -W.PushThrottle then -1 else 0
	rec.TripLook = rec.Chassis.CFrame.LookVector
	rec.ServerProven = false
	rec.BlockPush = 0
	rec.BlockLogged = false
	rec.Model:SetAttribute("WE_DriveFail", reason)
	rec.Pins, rec.PinList = countPins(rec)
	warn(diagLine(rec, t, "NO-DRIVE " .. reason, extra)) -- every player, one line per trip
	if rec.Mode == "Car" or rec.Mode == "Boat" then
		startGroundDrive(rec, t)
	else
		setOwner(rec, rec.Owner) -- aircraft: no server law (spec §5); re-assert and tell the pilot once
		if not rec.FlightNoticeSent then
			rec.FlightNoticeSent = true
			notify(rec.Owner, "Flight controls not responding — jump out and sit again", "Warn", 6)
		end
	end
end

-- 5 Hz next to sampleAndCheck: prove the client-simulated vehicle moves; after a trip, prove server drive does.
local function watchdogStep(rec: VehicleRec, t: number)
	if not W.Enabled or rec.DriverUserId == 0 then
		return
	end
	local air = rec.Mode == "Heli" or rec.Mode == "Plane"
	local pos = rec.Chassis.Position
	local function moved(from: Vector3?): number
		if from == nil then
			return 0
		end
		local d = pos - from
		return if air then d.Magnitude else Vector3.new(d.X, 0, d.Z).Magnitude
	end
	local push = pushing(rec, serverInput(rec, t))
	if rec.Mode == "Car" then
		-- rollover fix: a car on its side / roof has no traction by design and the flip recovery lifts it straight up,
		-- so "pushing but not moving" proves nothing until it has been upright for Car.RecoverMaxSeconds (else sitting
		-- in a flipped car with the stick held tripped the watchdog → server drive, and counted toward SessionTrips)
		if rec.Chassis.CFrame.UpVector.Y < CarCfg.FlipUpY then
			rec.FlipSeenAt = t
		end
		local flipAt = rec.FlipSeenAt
		if flipAt ~= nil and t - flipAt < CarCfg.RecoverMaxSeconds then
			push = false
		end
	end
	local last = rec.LastWatchAt
	local since = if last ~= nil then math.clamp(t - last, 0, 0.5) else 0 -- real time between 5 Hz calls
	rec.LastWatchAt = t
	if rec.Authority == "Client" and not rec.ClientProven and not rec.ClientBroken then
		if moved(rec.HandOffPos) > W.ProvenStuds then
			rec.ClientProven = true
			rec.PushSince = nil
			return
		end
		if t - (rec.HandOffAt or t) <= W.OwnerProbeSeconds and t >= rec.NextOwnerProbe then
			rec.NextOwnerProbe = t + 1 / W.OwnerProbeHz
			local st, detail = ownerState(rec, rec.Owner)
			if st == "drv" then
				rec.OwnerBad = 0
			elseif st ~= "unk" then
				rec.OwnerBad += 1
				if rec.OwnerBad == 2 then
					setOwner(rec, rec.Owner) -- one re-assert
				elseif rec.OwnerBad >= 3 then
					trip(rec, "owner:" .. st .. "(" .. detail .. ")", t)
					return
				end
			end
		end
		if push then
			local pushSince = rec.PushSince
			if pushSince == nil then
				rec.PushSince, rec.PushPos = t, pos
			elseif t - pushSince >= W.Seconds and moved(rec.PushPos) < W.MinMoveStuds then
				trip(rec, "nomove", t)
			end
		else
			rec.PushSince = nil
		end
	elseif rec.ClientBroken and rec.Authority == "Fallback" and not rec.ServerProven then
		if moved(rec.TripPos) > W.ProvenStuds then
			rec.ServerProven = true
			-- the client link was the fault only if server drive moved it the way the driver pushed at the trip: a car
			-- parked nose-to-wall trips, then reverses away under server drive; that proves nothing (spec: a blocked
			-- car must not count toward SessionTrips)
			local sign, look, from = rec.TripSign or 0, rec.TripLook, rec.TripPos
			local along = if look and from then (pos - from):Dot(look) * sign else 0
			if sign == 0 or along > W.MinMoveStuds then
				brokenTrips[rec.OwnerUserId] = (brokenTrips[rec.OwnerUserId] or 0) + 1 -- remember it for this session
				print(diagLine(rec, t, "SERVER-DRIVE ok (" .. tostring(rec.BrokenReason) .. ")", nil))
			else
				print(diagLine(rec, t, "SERVER-DRIVE moved away from the trip spot (not counted)", nil))
			end
		elseif push then
			rec.BlockPush += since
			if rec.BlockPush >= W.BlockedSeconds and not rec.BlockLogged then
				rec.BlockLogged = true
				warn(diagLine(rec, t, "BLOCKED (server drive cannot move it either: pinned or wedged)", nil))
			end
		end
	end
end

-- F5j: debug users (Drive.Debug) get WE_Diag at 2 Hz and a server line every ServerLogSeconds while pushing.
local function debugStep(rec: VehicleRec, t: number)
	if rec.DriverUserId == 0 or not isDebugUser(rec.OwnerUserId) then
		return
	end
	if t >= rec.NextDiagAt then
		rec.NextDiagAt = t + 0.5
		rec.Model:SetAttribute("WE_Diag", diagCompact(rec))
	end
	if t >= rec.NextDiagLogAt and pushing(rec, serverInput(rec, t)) then
		rec.NextDiagLogAt = t + DBG.ServerLogSeconds
		print(diagLine(rec, t, "DIAG", nil))
	end
end

local function tickRecord(rec: VehicleRec, t: number, dt: number)
	local model, chassis = rec.Model, rec.Chassis
	if model.Parent == nil or chassis.Parent == nil then
		if activeVehicles[rec.OwnerUserId] == model then
			activeVehicles[rec.OwnerUserId] = nil
		end
		forgetVehicle(model)
		return
	end
	local pos = chassis.Position
	local lim = Valid.WorldHalfExtent + Drive.LostMargin
	if pos.Y < Drive.LostBelowY or math.abs(pos.X) > lim or math.abs(pos.Z) > lim then
		destroyVehicle(rec, "Vehicle lost")
		return
	end
	if anyOccupied(rec) then
		rec.LastSeatedAt = t
	elseif t - rec.LastSeatedAt >= Drive.IdleDespawnSeconds then
		destroyVehicle(rec, nil)
		return
	end
	-- no Hello from the driver's client in time
	local satAt = rec.SatAt
	if rec.DriverUserId ~= 0 and rec.HelloAt == nil and not rec.HelloTimedOut and satAt ~= nil and t - satAt >= Drive.HelloTimeoutSeconds then
		rec.HelloTimedOut = true
		if rec.Mode == "Car" or rec.Mode == "Boat" then
			if rec.Authority == "Client" then
				startGroundDrive(rec, t)
			end
		elseif not rec.FlightNoticeSent then
			rec.FlightNoticeSent = true
			notify(rec.Owner, "Flight controls failed to load — rejoin", "Warn", 6)
		end
	end
	local auth = rec.Authority
	if auth == "Fallback" then
		fallbackStep(rec, t, dt)
	end
	if auth == "Client" or auth == "Fallback" then
		if t >= rec.NextSampleAt then
			rec.NextSampleAt = t + 1 / Valid.SampleHz
			sampleAndCheck(rec, t)
			if vehicles[model] == rec then -- sampleAndCheck can recall (destroy) it
				watchdogStep(rec, t)
			end
		end
	else
		if rec.CorrectUntil ~= nil then
			correctionStep(rec, t)
		end
		if rec.Authority == "Server" and vehicles[model] == rec and t >= rec.NextIdleAt then
			local last = rec.LastIdleAt
			local idt = if last then math.min(t - last, 0.25) else 0
			rec.LastIdleAt = t
			rec.NextIdleAt = t + 1 / Drive.IdleHz
			idleStep(rec, t, idt)
		end
	end
	if vehicles[model] == rec then
		debugStep(rec, t)
	end
end

local function tickAll(dt: number)
	local t = now()
	local list: { VehicleRec } = {}
	for _, rec in pairs(vehicles) do
		table.insert(list, rec)
	end
	for _, rec in ipairs(list) do
		if vehicles[rec.Model] == rec then
			local ok, err = pcall(tickRecord :: any, rec, t, dt)
			if not ok then
				warn("[VehicleService] tick failed", rec.Def.Id, err)
			end
		end
	end
end

-- First sit extras (once per session). Mobile P1-8: no keyboard drive-tip toast any more (key names on phones);
-- the ArmedJeep keeps its cosmetic muzzle-flash cue.
local function onFirstSit(rec: VehicleRec, player: Player)
	local model = rec.Model
	if rec.Mode == "Car" and not sitCueShown[player.UserId] then
		sitCueShown[player.UserId] = true
		if model:GetAttribute("VehicleId") == "ArmedJeep" then
			-- Brief muzzle flash cue (cosmetic; no fire logic)
			local barrel = model:FindFirstChild("Barrel")
			if barrel and barrel:IsA("BasePart") then
				local flash = Instance.new("PointLight")
				flash.Name = "WE_MuzzleFlash"
				flash.Color = Color3.fromRGB(255, 200, 120)
				flash.Brightness = 4
				flash.Range = 14
				flash.Shadows = false
				flash.Parent = barrel
				task.delay(0.18, function()
					if flash.Parent then
						flash:Destroy()
					end
				end)
			end
		end
	end
	-- v36: one-shot SpeedBoost soft offer after the first vehicle sit
	if sitOfferShown[player.UserId] then
		return
	end
	sitOfferShown[player.UserId] = true
	if MonetizationService and MonetizationService.TrySoftOfferSpeedBoost then
		task.defer(function()
			MonetizationService.TrySoftOfferSpeedBoost(player, "vehicle_sit")
		end)
	end
end

local function onDriverChanged(model: Model, occupant: Instance?)
	local rec = vehicles[model]
	if not rec then
		return
	end
	local t = now()
	if occupant == nil then
		if rec.DriverUserId ~= 0 or rec.Authority ~= "Server" then
			releaseToServer(rec, t)
		end
		return
	end
	local player = playerOfHumanoid(occupant)
	if player == nil or player ~= rec.Owner then
		ejectSeat(rec.Seat) -- only the owner can drive; passenger seats take players only (F8)
		return
	end
	rec.EverSeated = true
	rec.LastSeatedAt = t
	refreshMoverLimits(rec) -- AssemblyMass now includes the driver
	handOff(rec, player, t, true)
	onFirstSit(rec, player)
end

-- a stream axis: finite number clamped to [-1, 1], anything else 0
local function axis(v: any): number
	if typeof(v) ~= "number" or v ~= v then
		return 0
	end
	return math.clamp(v, -1, 1)
end

--[[ VehicleDriveInput (F5f). Kinds: Hello {P}, Bye, In {T, S, L} (10 Hz while any axis is non-zero), Stuck (once per
	sit), Exit (touch jump / EXIT pill). Only the seated owner-driver of their own active vehicle is heard; the
	messages carry clamped inputs only, never positions or velocities. ]]
local function handleDriveInput(player: Player, msg: any)
	if typeof(msg) ~= "table" then
		if AntiExploitService and AntiExploitService.Strike then
			pcall(AntiExploitService.Strike, player, "vehicle_input_payload")
		end
		return
	end
	local kind = msg.K
	local key: string, rate: number, burst: number
	if kind == "In" then
		key, rate, burst = "vehicle_drive_stream", W.StreamRate, W.StreamBurst
	elseif kind == "Hello" or kind == "Bye" or kind == "Stuck" then
		key, rate, burst = "vehicle_drive_input", 4, 2
	elseif kind == "Exit" then
		key, rate, burst = "vehicle_exit", 4, 2
	else
		return
	end
	if RateLimitService and not RateLimitService.Allow(player, key, rate, burst) then
		return
	end
	if not RemoteGuard.IsIdString(msg.V, 48) then
		return
	end
	local model = activeVehicles[player.UserId]
	local rec = if model then vehicles[model] else nil
	if rec == nil or rec.Model:GetAttribute("VehicleId") ~= msg.V then
		return
	end
	if seatedDriver(rec) ~= player or rec.DriverUserId ~= player.UserId then
		return
	end
	local t = now()
	if kind == "In" then
		rec.InT, rec.InS, rec.InL = axis(msg.T), axis(msg.S), axis(msg.L)
		rec.InAt = t
		return
	elseif kind == "Exit" then
		ejectSeat(rec.Seat) -- works whoever simulates the seat (a client jump may not leave a server-owned seat)
		return
	elseif kind == "Stuck" then
		if rec.Authority == "Client" and not rec.ClientProven then
			local air = rec.Mode == "Heli" or rec.Mode == "Plane"
			-- aircraft: only when the server also sees input that must move the craft (a landed heli ignores the stick)
			if not air or pushing(rec, serverInput(rec, t)) then
				trip(rec, "client-stuck", t, msg)
			end
		end
		return
	elseif kind == "Hello" then
		if msg.P ~= nil and msg.P ~= Drive.ProtocolVersion then
			return -- an old client: it refuses to drive; Car/Boat fall back after the timeout
		end
		rec.HelloAt = t
		if rec.Authority == "Fallback" and not rec.ClientBroken then
			stopDrive(rec)
			if setOwner(rec, player) then
				setAuthority(rec, "Client")
			else
				startGroundDrive(rec, t)
			end
		end
	elseif rec.Mode == "Car" or rec.Mode == "Boat" then
		-- Bye while still seated: the client stopped driving → the server takes over
		if rec.Authority == "Client" then
			rec.HelloAt = nil
			rec.HelloTimedOut = true
			startGroundDrive(rec, t)
		end
	end
end

local function researchMult(player: Player, statId: string, maxBonus: number): number
	local rs = ResearchService
	if rs == nil or typeof(rs.GetBonus) ~= "function" then
		return 1
	end
	local ok, v = pcall(rs.GetBonus, player, statId)
	local n = if ok then tonumber(v) else nil
	if n == nil or n ~= n then
		return 1
	end
	return math.clamp(n, 1, maxBonus)
end

local function registerVehicle(player: Player, model: Model, def: VehicleDef, mode: string, spawn: SpawnChoice): VehicleRec?
	local chassis = model.PrimaryPart
	local seat = model:FindFirstChild("DriverSeat")
	if not (chassis and seat and seat:IsA("VehicleSeat")) then
		return nil
	end
	local lv = chassis:FindFirstChild("WE_DriveLV")
	local ao = chassis:FindFirstChild("WE_DriveAO")
	if not (lv and lv:IsA("LinearVelocity") and ao and ao:IsA("AlignOrientation")) then
		return nil
	end
	local passengers: { Seat } = {}
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("Seat") then
			table.insert(passengers, c)
		end
	end
	local t = now()
	local baseMax = tonumber(model:GetAttribute("WE_BaseMaxSpeed")) or def.Speed
	local cf = chassis.CFrame
	local rec: VehicleRec = {
		Model = model,
		Owner = player,
		OwnerUserId = player.UserId,
		Def = def,
		Mode = mode,
		Chassis = chassis,
		Seat = seat,
		Passengers = passengers,
		LV = lv,
		AO = ao,
		Params = {
			MaxSpeed = tonumber(model:GetAttribute("WE_MaxSpeed")) or baseMax,
			Accel = tonumber(model:GetAttribute("WE_Accel")) or 20,
			TurnRate = tonumber(model:GetAttribute("WE_TurnRate")) or 1,
			Tracked = model:GetAttribute("WE_Tracked") == true,
			RideOffset = tonumber(model:GetAttribute("WE_RideOffset")) or 0,
			HalfLength = tonumber(model:GetAttribute("WE_HalfLength")) or 5,
		},
		BaseMaxSpeed = baseMax,
		MaxAltitude = tonumber(model:GetAttribute("WE_MaxAltitude")) or Valid.GroundMaxY,
		Force = lv.MaxAxesForce.X,
		Authority = "Server",
		DriverUserId = 0,
		SatAt = nil,
		HelloAt = nil,
		HelloTimedOut = false,
		FlightNoticeSent = false,
		EverSeated = false,
		LastSeatedAt = t,
		LastValid = { CFrame = cf, Pos = cf.Position, T = t },
		Window = { Pos = cf.Position, T = t },
		LastSampleT = t,
		LastSamplePos = cf.Position,
		NextSampleAt = t,
		NextIdleAt = t,
		LastIdleAt = nil,
		SpeedFlags = 0,
		OffWaterFor = 0,
		Violations = {},
		CorrectUntil = nil,
		CorrectPos = nil,
		Idle = {},
		Fallback = nil,
		LastStabilisedAt = -math.huge,
		Conns = {},
		OutVel = nil,
		OutHold = nil,
		OutRot = nil,
		OwnParts = ownPartsOf(model, chassis),
		InT = 0,
		InS = 0,
		InL = 0,
		InAt = nil,
		ClientProven = false,
		ClientBroken = false,
		ServerProven = false,
		BrokenReason = nil,
		HandOffPos = nil,
		HandOffAt = nil,
		PushSince = nil,
		PushPos = nil,
		OwnerBad = 0,
		NextOwnerProbe = t,
		TripAt = nil,
		TripPos = nil,
		BlockPush = 0,
		BlockLogged = false,
		LastWatchAt = nil,
		Pins = 0,
		PinList = "",
		NextDiagAt = t,
		NextDiagLogAt = t,
	}
	vehicles[model] = rec
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
		end
	end
	setOwner(rec, nil)
	refreshMoverLimits(rec)
	if spawn.State == "Airborne" and spawn.Speed > 0 then
		-- air start: moving at 1.3 x takeoff speed, held by the idle glide until the pilot sits
		local look = flat(cf.LookVector)
		look = if look.Magnitude > 0.05 then look.Unit else Vector3.new(0, 0, -1)
		pcall(function()
			chassis.AssemblyLinearVelocity = look * spawn.Speed
		end)
		rec.Idle.GlideSpeed = spawn.Speed
		lv.MaxAxesForce = Vector3.new(rec.Force, rec.Force, rec.Force)
		lv.VectorVelocity = look * spawn.Speed + Vector3.new(0, -PlaneCfg.IdleGlideSink, 0)
	end
	idleStep(rec, t, 0)
	table.insert(
		rec.Conns,
		seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			onDriverChanged(model, seat.Occupant)
		end)
	)
	-- F8: passenger seats take players only. NPC squad units / guards never ride (their BodyGyro would steer the car).
	-- A player leaving a passenger seat gets their character handed back (the car may be server-owned).
	for _, ps in ipairs(passengers) do
		local prevRider: Player? = nil
		table.insert(
			rec.Conns,
			ps:GetPropertyChangedSignal("Occupant"):Connect(function()
				local occ = ps.Occupant
				local rider = playerOfHumanoid(occ)
				if prevRider and prevRider ~= rider then
					handBackCharacter(prevRider, chassis)
				end
				prevRider = rider
				if occ ~= nil and rider == nil then
					task.defer(function()
						if ps.Occupant == occ then
							ejectSeat(ps)
						end
					end)
				end
			end)
		)
	end
	return rec
end

function VehicleService.Owns(player: Player, vehicleId: string): boolean
	local profile = DataService.GetProfile(player)
	return profile ~= nil and profile.Vehicles[vehicleId] == true
end

function VehicleService.GrantVehicle(player: Player, vehicleId: string)
	local profile = DataService.GetProfile(player)
	if not profile or not getDef(vehicleId) then
		return
	end
	profile.Vehicles[vehicleId] = true
	DataService.MarkDirty(player)
	pushState(player)
end

function VehicleService.Purchase(player: Player, vehicleId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(vehicleId, 48) then
		return false, "InvalidId"
	end
	local def = getDef(vehicleId)
	if not def then
		return false, "UnknownVehicle"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if profile.Vehicles[vehicleId] then
		return false, "AlreadyOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local okStruct, structErr = meetsStructureReq(profile, def)
	if not okStruct then
		return false, structErr
	end
	local okPres, presErr = meetsPrestigeReq(profile, def)
	if not okPres then
		return false, presErr
	end
	local cost = def.CostCash or 0
	if cost > 0 then
		local ok, err = EconomyService.SpendCash(player, cost, "vehicle_" .. vehicleId)
		if not ok then
			return false, err or "SpendFailed"
		end
	end
	profile.Vehicles[vehicleId] = true
	DataService.MarkDirty(player)
	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.VEHICLE_PURCHASED, player.UserId, {
			vehicle = vehicleId,
			cost = cost,
		})
	end
	if NotificationService then
		NotificationService.Notify(player, "Acquired " .. def.DisplayName, "Reward")
	end
	pushState(player)
	return true, nil
end

function VehicleService.Despawn(player: Player)
	destroyActive(player.UserId)
	pushState(player)
end

function VehicleService.RequestSpawn(player: Player, vehicleId: any): (boolean, string?)
	if not RemoteGuard.IsIdString(vehicleId, 48) then
		return false, "InvalidId"
	end
	local def = getDef(vehicleId)
	if not def then
		return false, "UnknownVehicle"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "NoProfile"
	end
	if not profile.Vehicles[vehicleId] then
		return false, "NotOwned"
	end
	if profile.Level < def.UnlockLevel then
		return false, "LevelTooLow"
	end
	local okStruct, structErr = meetsStructureReq(profile, def)
	if not okStruct then
		return false, structErr
	end
	local okPres, presErr = meetsPrestigeReq(profile, def)
	if not okPres then
		return false, presErr
	end
	if VehicleService._VehicleHealth.RepairLeft(player.UserId, vehicleId) > 0 then
		return false, "Repairing" -- W2: destroyed → that id is locked for Destroy.RepairSeconds
	end
	if cooldownLeft(player.UserId, player) > 0 then
		return false, "Cooldown"
	end
	if damageLockLeft(player.UserId) > 0 then
		return false, "InCombat" -- P1-9: SPAWN is not an escape from a fight
	end
	if VehicleService._VehicleHealth.HitLockLeft(player.UserId, SpawnCfg.DamageLockSeconds) > 0 then
		return false, "InCombat" -- W2: nor a full heal for a vehicle under fire (SPAWN / Despawn + SPAWN)
	end
	-- P1-9: inside your own plot the garage flow seats you on your own pad / helipad / runway / basin; anywhere
	-- else only a vehicle that appears next to you (in front of you) seats you. Never a cross-map teleport.
	local sitRadius = if playerAtHome(player, profile) then SpawnCfg.AutoSitHomeRadius else SpawnCfg.AutoSitRadius

	-- 1) build unparented at the origin (movers + drive attributes included)
	local bonus = researchMult(player, "VehicleSpeed", Drive.MaxResearchSpeedBonus)
	local armorMult = researchMult(player, "VehicleArmor", Drive.MaxResearchArmorBonus)
	local buildOk, modelOrErr = pcall(function()
		return buildVehicleModel(def, CFrame.identity, player.UserId, bonus, armorMult)
	end)
	if not buildOk or typeof(modelOrErr) ~= "Instance" then
		warn("[VehicleService] buildVehicleModel failed", vehicleId, modelOrErr)
		return false, "SpawnBuildFailed"
	end
	local model = modelOrErr :: Model
	local function discard()
		pcall(function()
			model:Destroy()
		end)
	end
	if not model.PrimaryPart or not model:FindFirstChild("DriverSeat") then
		warn("[VehicleService] spawn kit incomplete", vehicleId, "PrimaryPart/DriverSeat missing")
		discard()
		return false, "SpawnKitIncomplete"
	end
	local mode = driveModeFor(def)

	-- 2) footprint → 3) choose the spawn (the player's current vehicle is replaced, so it is not "occupied")
	local fp = footprintOf(model)
	local attrs = model:GetAttributes()
	local ctxOk, chosen, chooseErr = pcall(function(): (SpawnChoice?, string?)
		return chooseSpawn(buildSpawnCtx(player, profile, mode, fp, attrs, activeVehicles[player.UserId]))
	end)
	if not ctxOk then
		warn("[VehicleService] spawn choice failed", vehicleId, chosen)
		discard()
		return false, "SpawnBuildFailed"
	end
	local spawn = chosen :: SpawnChoice?
	if spawn == nil then
		discard()
		return false, chooseErr or "NoWater"
	end

	-- One active vehicle per player: the old one goes now
	destroyActive(player.UserId)

	-- 4) PivotTo → parent → hand over
	model:PivotTo(spawn.CFrame)
	model:SetAttribute("WE_SpawnState", spawn.State)
	if spawn.Speed > 0 then
		model:SetAttribute("WE_SpawnSpeed", spawn.Speed)
	end
	model.Parent = ensureFolder()
	if not model.Parent then
		warn("[VehicleService] spawn model unparented", vehicleId)
		discard()
		return false, "SpawnOrphaned"
	end
	local rec = registerVehicle(player, model, def, mode, spawn)
	if not rec then
		warn("[VehicleService] spawn kit incomplete (movers)", vehicleId)
		discard()
		return false, "SpawnKitIncomplete"
	end
	activeVehicles[player.UserId] = model
	lastSpawnAt[player.UserId] = now()
	-- W2: vehicle HP (VehicleHealth). At 0 HP: the wreck look at once, the normal teardown after DebrisSeconds.
	local okHp, errHp = pcall(VehicleService._VehicleHealth.Register, model, def, player, {
		Premium = (def :: any).Premium ~= nil,
		OnWrecked = function()
			VehicleService._Wreck(model)
		end,
		OnDestroyed = function()
			local r = vehicles[model]
			if r then
				destroyVehicle(r, def.DisplayName .. " destroyed")
			else
				pcall(function()
					model:Destroy()
				end)
				if player.Parent then
					pcall(pushState, player)
				end
			end
		end,
	})
	if not okHp then
		warn("[VehicleService] VehicleHealth.Register failed", vehicleId, errHp)
	end

	-- Driveability: Drive prompt + auto-sit the DriverSeat so garage SPAWN is immediately usable
	local autoSeat = false
	do
		local seat = rec.Seat
		seat.Disabled = false
		seat.Anchored = false
		seat.CanTouch = true
		-- Drive prompt if auto-sit misses (mobile / late character); clients hide it on vehicles they don't own
		if not seat:FindFirstChild("WE_DrivePrompt") then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "WE_DrivePrompt"
			prompt.ActionText = "Drive"
			prompt.ObjectText = def.DisplayName or "Vehicle"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 14
			prompt.RequiresLineOfSight = false
			prompt.Parent = seat
			table.insert(
				rec.Conns,
				prompt.Triggered:Connect(function(who: Player)
					if who ~= player then
						return
					end
					local ch = who.Character
					local hum = ch and ch:FindFirstChildOfClass("Humanoid")
					if hum and seat.Occupant == nil then
						pcall(function()
							seat:Sit(hum)
						end)
					end
				end)
			)
		end
		-- "close" = the player's root part within sitRadius of the vehicle's footprint (centre distance - radius)
		local reach = footRadius(fp)
		local function seatNear(): boolean
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			return hrp ~= nil and hrp:IsA("BasePart") and (hrp.Position - rec.Chassis.Position).Magnitude - reach <= sitRadius
		end
		autoSeat = seatNear()
		-- streaming2 S3 (F8): before moving the player onto a seat further away than StreamingConfig.NearStuds, the
		-- server asks for that area to stream in first. It sends one RequestStreamAroundAsync per spawn, with timeout
		-- Drive.Spawn.AutoSitPrefetchTimeout, so the driver's client never takes over the physics on ground it has not
		-- loaded. Sit attempts that fire while the request runs do nothing, and the attempt schedule restarts when it
		-- returns. With streaming off there is no request and the moves are the same as before.
		local prefetch = "none" -- "none" | "running" | "done"
		local trySit: () -> ()
		local function scheduleSits()
			task.defer(trySit)
			task.delay(0.2, trySit)
			task.delay(0.5, trySit)
			task.delay(1.0, trySit)
			task.delay(2.0, trySit)
		end
		trySit = function()
			if rec.EverSeated or not player.Parent or not model.Parent or not seat.Parent then
				return
			end
			local character = player.Character
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hum and hrp and seat.Occupant == nil and seatNear() then
				local StreamPrefetch = VehicleService._StreamPrefetch
				if prefetch ~= "done" and StreamPrefetch.Enabled() then
					local dest = (seat.CFrame * CFrame.new(0, 2.5, 0)).Position -- where the move below puts the root part
					if not StreamPrefetch.IsNear(player, dest) then
						if prefetch == "none" then
							prefetch = "running"
							StreamPrefetch.Request(player, dest, SpawnCfg.AutoSitPrefetchTimeout) -- yields; pcall'd inside
							prefetch = "done"
							scheduleSits() -- re-runs every check: the player, vehicle or seat may have changed meanwhile
						end
						return
					end
				end
				-- Place character on seat so Sit always has a valid near-seat humanoid
				hrp.CFrame = seat.CFrame * CFrame.new(0, 2.5, 0)
				pcall(function()
					seat:Sit(hum)
				end)
			end
		end
		scheduleSits()
	end

	if profile.Stats then
		profile.Stats.VehiclesSpawned = (profile.Stats.VehiclesSpawned or 0) + 1
	end
	if MissionService and MissionService.TrackProgress then
		MissionService.TrackProgress(player, "SpawnVehicle", 1)
	end
	if TutorialService and TutorialService.Notify then
		TutorialService.Notify(player, "SpawnVehicle", vehicleId)
	end
	DataService.MarkDirty(player)

	if AnalyticsService then
		AnalyticsService.Log(AnalyticsConfig.Events.VEHICLE_SPAWNED, player.UserId, {
			vehicle = vehicleId,
			source = spawn.Source,
		})
	end
	local at = spawn.CFrame.Position
	print(string.format(
		"[VehicleService] SPAWN ok %s → %s (%s) @ %s (%.0f,%.0f,%.0f)",
		player.Name,
		tostring(vehicleId),
		mode,
		spawn.Source,
		at.X,
		at.Y,
		at.Z
	))
	if NotificationService then
		local msg = if autoSeat then "Deployed " .. def.DisplayName else "Deployed " .. def.DisplayName .. " — walk over to drive"
		NotificationService.Notify(player, msg, "Success")
	end
	pushState(player)
	return true, nil
end

function VehicleService.PushState(player: Player)
	pushState(player)
end

-- Research workflow: call after a vehicle upgrade so a vehicle that is already out picks it up.
function VehicleService.OnResearchChanged(player: Player)
	local model = activeVehicles[player.UserId]
	local rec = if model then vehicles[model] else nil
	if rec == nil then
		return
	end
	local bonus = researchMult(player, "VehicleSpeed", Drive.MaxResearchSpeedBonus)
	rec.Params.MaxSpeed = rec.BaseMaxSpeed * bonus
	rec.Model:SetAttribute("WE_MaxSpeed", rec.Params.MaxSpeed)
	rec.Model:SetAttribute("WE_ArmorMult", researchMult(player, "VehicleArmor", Drive.MaxResearchArmorBonus))
	pcall(VehicleService._VehicleHealth.RefreshMaxHP, rec.Model) -- W2: MaxHP follows WE_ArmorMult (HP fraction kept)
end

--[[ W2: the destroyed look (premium_vehicles §2.4), called by VehicleHealth at 0 HP before the occupants are ejected.
	The server takes the physics back, the movers stop (the wreck falls / settles under gravity), every seat and the
	Drive prompt switch off, every part turns charred (35, 32, 30) CorrodedMetal (no Neon left), lights / cues / emitters
	go off. Adds no parts and no server Explosion. ]]
function VehicleService._Wreck(model: Model)
	local rec = vehicles[model]
	if rec then
		pcall(releaseToServer, rec, now())
		setOwner(rec, nil)
		pcall(function()
			rec.LV.VectorVelocity = Vector3.zero
			rec.LV.MaxAxesForce = Vector3.zero
			rec.LV.Enabled = false
			rec.AO.Enabled = false
			local up = rec.Chassis:FindFirstChild("WE_UprightAO") -- rollover fix: the wreck settles freely
			if up and up:IsA("AlignOrientation") then
				up.Enabled = false
			end
		end)
	end
	model:SetAttribute("WE_DriveAuthority", "Server")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = Color3.fromRGB(35, 32, 30)
			d.Material = Enum.Material.CorrodedMetal
			if d:IsA("VehicleSeat") or d:IsA("Seat") then
				(d :: any).Disabled = true
			end
		elseif d:IsA("ProximityPrompt") then
			d.Enabled = false
		elseif d:IsA("Light") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
			(d :: any).Enabled = false
		elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
			(d :: any).Enabled = false
		end
	end
end

-- ── Test hooks (headless sim; spec §7) ─────────────────────────────────────────────────────────
VehicleService._DriveModeFor = driveModeFor
VehicleService._DriveAttributes = driveAttributes
VehicleService._Footprint = footprintOf
VehicleService._WaterSurfaceAt = waterSurfaceAt
VehicleService._IsConnectedToSea = isConnectedToSea
VehicleService._ChooseSpawn = chooseSpawn
VehicleService._BuildSpawnCtx = buildSpawnCtx
VehicleService._ValidateSample = validateSample
VehicleService._IdleTarget = idleTarget
VehicleService._OnDriverChanged = onDriverChanged
VehicleService._HandleDriveInput = handleDriveInput
VehicleService._Build = function(def: VehicleDef, at: CFrame?, ownerUserId: number?, bonus: number?): Model
	return buildVehicleModel(def, at or CFrame.identity, ownerUserId or 0, bonus, 1)
end
VehicleService._Laws = {
	NewState = newDriveState,
	CarStep = carStep,
	BoatStep = boatStep,
	BoatProbe = boatProbe,
	Idle = idleTarget,
}
VehicleService._Tick = tickAll
VehicleService._Record = function(model: Model): any
	return vehicles[model]
end
VehicleService._BrokenTrips = function(userId: number): number
	return brokenTrips[userId] or 0
end
VehicleService._DamageLockLeft = damageLockLeft
VehicleService._OnViolation = function(model: Model, reason: string, soft: boolean)
	local rec = vehicles[model]
	if rec then
		onViolation(rec, reason, soft, now())
	end
end

function VehicleService.Init(deps: { [string]: any })
	DataService = deps.DataService
	EconomyService = deps.EconomyService
	AnalyticsService = deps.AnalyticsService
	RateLimitService = deps.RateLimitService
	NotificationService = deps.NotificationService
	RemoteSetup = deps.RemoteSetup
	TerritoryService = deps.TerritoryService
	MissionService = deps.MissionService
	TutorialService = deps.TutorialService
	MonetizationService = deps.MonetizationService
	ResearchService = deps.ResearchService
	AntiExploitService = deps.AntiExploitService
	VehicleService._VehicleHealth.Init(deps) -- W2: every dep optional (CombatService / ClanService / XPService / ...)

	ensureFolder()
	refreshWaterParts()
	waterRefreshAt = now() + WaterCfg.RefreshSeconds
	CollectionService:GetInstanceAddedSignal(Constants.Tags.Water):Connect(function()
		waterRefreshAt = 0
	end)
	CollectionService:GetInstanceRemovedSignal(Constants.Tags.Water):Connect(function()
		waterRefreshAt = 0
	end)

	local spawnRemote = RemoteSetup.Get(Constants.RemoteNames.RequestSpawnVehicle) :: RemoteEvent
	spawnRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
		if not RateLimitService.Allow(player, "spawn_vehicle", 1, 2) then
			if NotificationService then
				NotificationService.Notify(player, "Spawn too fast — wait a moment", "Warn", 2)
			end
			return
		end
		print(string.format("[VehicleService] Remote SPAWN attempt %s → %s", player.Name, tostring(vehicleId)))
		local ok, err = VehicleService.RequestSpawn(player, vehicleId)
		print(string.format("[VehicleService] Remote SPAWN result %s → Ok=%s Err=%s", player.Name, tostring(ok), tostring(err)))
		if not ok and NotificationService and err then
			local def = if typeof(vehicleId) == "string" then getDef(vehicleId) else nil
			NotificationService.Notify(player, errorText(err, def, player), "Warn")
		end
	end)

	local purchaseRemote = RemoteSetup.Get(Constants.RemoteNames.RequestPurchaseVehicle) :: RemoteEvent
	purchaseRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
		if not RateLimitService.Allow(player, "buy_vehicle", 2, 3) then
			return
		end
		local ok, err = VehicleService.Purchase(player, vehicleId)
		if not ok and err then
			if err == "AlreadyOwned" then
				pcall(pushState, player)
			end
			if NotificationService then
				local def = if typeof(vehicleId) == "string" then getDef(vehicleId) else nil
				NotificationService.Notify(player, errorText(err, def, player), "Warn")
			end
		end
	end)

	local despawnRemote = RemoteSetup.Get(Constants.RemoteNames.RequestDespawnVehicle) :: RemoteEvent
	despawnRemote.OnServerEvent:Connect(function(player: Player)
		if not RateLimitService.Allow(player, "despawn_vehicle", 2, 3) then
			return
		end
		VehicleService.Despawn(player)
	end)

	local driveRemote = RemoteSetup.Get(Constants.RemoteNames.VehicleDriveInput) :: RemoteEvent
	driveRemote.OnServerEvent:Connect(function(player: Player, msg: any)
		handleDriveInput(player, msg)
	end)

	DataService.OnProfileLoaded(function(player: Player, profile: any)
		local starter = VehicleConfig.StarterVehicle
		if not profile.Vehicles[starter] then
			profile.Vehicles[starter] = true
			DataService.MarkDirty(player)
		end
		pushState(player)
	end)

	RunService.Heartbeat:Connect(tickAll)

	-- P1-9: remember when each player's character last took damage (a Health drop at an unchanged MaxHealth;
	-- CombatService's spawn reset of MaxHealth / regen never counts)
	local function watchCharacter(player: Player, character: Model)
		task.spawn(function()
			local found = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
			if not (found and found:IsA("Humanoid")) then
				return
			end
			local hum = found :: Humanoid
			local lastHealth, lastMax = hum.Health, hum.MaxHealth
			hum.HealthChanged:Connect(function(h: number)
				local max = hum.MaxHealth
				if h < lastHealth - 0.01 and max == lastMax then
					lastDamageAt[player.UserId] = now()
				end
				lastHealth, lastMax = h, max
			end)
		end)
	end
	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character: Model)
			watchCharacter(player, character)
		end)
		local character = player.Character
		if character then
			watchCharacter(player, character)
		end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		destroyActive(player.UserId)
		lastSpawnAt[player.UserId] = nil
		lastDamageAt[player.UserId] = nil
		brokenTrips[player.UserId] = nil
		sitCueShown[player.UserId] = nil
		sitOfferShown[player.UserId] = nil
	end)
end

return VehicleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="184">
          <Properties>
            <string name="Name">VisualAssetService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Loads free Creator Store Models via InsertService (fallback AssetService).
	Caches clones; strips all scripts; never blocks Part-kit spawn on failure.
	Respects DevConfig.StudioSkipWorldDressing for 8GB Studio PERF.

	W3 LOOK (roadmap §2.4; asset shortlist §6.2 C1):
	  • AssetRef.ChildName picks ONE piece of a pack (pack:FindFirstChild(ChildName, true); names hold "/", never split),
	    AssetRef.SubModel a descendant of it. A pack loads once; every configured piece of it becomes its own template
	    and the rest of the pack is destroyed. One id is inserted by one thread at a time (others wait for it).
	  • Every template is <= VisualAssetConfig.MaxPartsPerModel BaseParts and holds no Humanoid, or it is refused.
	  • Templates live in ServerStorage.WE_VisualAssetTemplates (never ReplicatedStorage).
	  • CloneKitMesh(key): one Roblox-owned mesh piece for a WorldKits Part kit (VisualAssetConfig.DesertKit).
	  • Vehicle refs with Fit = "Kit" scale the body to the kit chassis and hide the Part-kit visuals (physics unchanged).

	Owner asset list (2026-09-25, docs/ASSET_WIRING.md):
	  • AssetRef.OmitParts: BaseParts of a pack piece with these names are removed before the part count (the Roblox
	    Pickup Truck Body is 41 parts; without its tail-light glass it is 40).
	  • VisualAssetConfig.StripEffectsAssetIds: for these whole models Fire / Smoke / Sparkles / ParticleEmitter / lights /
	    Beam / Trail are removed at load (the Roblox oil drum keeps no smoke). Every other id keeps its effects.
	  • AssetRef.NoFamilyFallback: a vehicle ref at 0 keeps its Part kit and never takes a KitFamilyFallback body.
	  • A ref's PendingAssetId (the owner's third-party pick) is never read here (no load, no MaxLoadAttempts cost):
	    tools/wire-asset-ids.py moves it to ModelAssetId.
	  • The Airfield hangar is VisualAssetConfig.Buildings.Hangar (0 = the Part shed, no load).
	  • CloneKitMesh marks a piece with its ref's Yaw (attribute WE_KitYaw) for WorldKits; IsKitMeshWired(key) tells
	    WorldKits, from config only, whether a key can ever give a mesh (an unwired key takes no overlay slot).

	Load failures (each one leaves the Part kit look and prints one Output line):
	  • transient (HTTP 5xx / throttle / timeout): retried in the BACKGROUND (task.delay), VisualAssetConfig
	    LoadRetryCount times, LoadRetryDelay s then x LoadRetryBackoff. While a retry is pending or running, callers
	    get nil at once (no caller ever waits on a retry). Retries count toward MaxLoadAttempts and never use its last
	    LoadRetryReserve attempts (kept for first loads). Silent until it loads (one print) or gives up (one warn).
	  • permanent (LoadRetryPermanentErrors text, no Model, template prep error, over the part cap / Humanoid): final.
	  • MaxLoadAttempts reached: an id asked for after that is not loaded ("load cap" line, once per id).
]]

local InsertService = game:GetService("InsertService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

-- server module: the Rojo place ships ReplicatedStorage.Shared, so index it (no WaitForChild without a timeout)
local Shared = ReplicatedStorage.Shared
local VisualAssetConfig = require(Shared.Configs.VisualAssetConfig)
local DevConfig = require(Shared.Configs.DevConfig)

local VisualAssetService = {}

-- the fields of VisualAssetConfig.AssetRef this service reads (kept local: config tables are read through `any`)
type AssetRef = {
	ModelAssetId: number?,
	MeshId: number?,
	ChildName: string?,
	SubModel: string?,
	Color: Color3?,
	Material: Enum.Material?,
	ClearTexture: boolean?,
	StripDecals: boolean?,
	Fit: string?,
	Yaw: number?,
	HideKit: boolean?,
	KeepVisible: { string }?,
	OmitParts: { string }?, -- owner list: pack piece parts removed before the part count
	NoFamilyFallback: boolean?, -- owner list: a vehicle ref at 0 never takes the family body
}

local cache: { [number]: Model } = {} -- template models (parented to nil / folder)
local failed: { [number]: boolean } = {} -- final: never inserted again
local retryTries: { [number]: number } = {} -- background retries scheduled so far per id
local cooling: { [number]: boolean } = {} -- a background retry is pending or running: callers get nil at once
local capLogged: { [number]: boolean } = {} -- "load cap" Output line printed once per id
local requestOrder: { number } = {} -- QA (_Stats / _Requested): distinct ids that asked for an insert, in order
local requestSeen: { [number]: boolean } = {}
local capRefused = 0 -- distinct ids refused by MaxLoadAttempts
local templateStrips: { [number]: { [string]: number } } = {} -- what loadModel stripped from each template
local dressLogged: { [number]: boolean } = {} -- vehicle dress strip summary printed once per assetId
local loadAttempts = 0
local templatesFolder: Folder? = nil
-- W3 LOOK: packs (ids whose config refs carry ChildName) are split into one template per configured piece
local pieceCache: { [string]: Instance } = {} -- pieceKey → Model or BasePart template (in the templates folder)
local pieceFailed: { [string]: string } = {} -- pieceKey → reason (logged once)
local packDone: { [number]: boolean } = {} -- the pack was loaded and split (never inserted again)
local inflight: { [number]: { thread } } = {} -- ids being inserted right now → threads waiting for them

-- Templates live in ServerStorage (CLAUDE.md): clones are made on the server, no client reads them, and in
-- ReplicatedStorage every joining client had to download every template before its loading screen ended.
local function ensureFolder(): Folder
	if templatesFolder and templatesFolder.Parent then
		return templatesFolder
	end
	local f = Instance.new("Folder")
	f.Name = "WE_VisualAssetTemplates"
	f.Parent = ServerStorage
	templatesFolder = f
	return f
end

local function shouldSkipInserts(): boolean
	if not VisualAssetConfig.Enabled then
		return true
	end
	if RunService:IsStudio() then
		local force = DevConfig.StudioForceDress == true
		if DevConfig.StudioSkipWorldDressing ~= false and not force then
			return true
		end
	end
	return false
end

local function stripScripts(root: Instance)
	if not VisualAssetConfig.StripScripts then
		return
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	-- Also direct children scripts
	for _, c in ipairs(root:GetChildren()) do
		if c:IsA("BaseScript") or c:IsA("ModuleScript") then
			c:Destroy()
		end
	end
end

--[[ v70 judge (jeep "doesn't drive", R3): a catalog dress model is welded into the vehicle's Chassis assembly, so any
	mover, joint or gameplay object it carries acts on (or rides with) the whole vehicle. A saved BodyVelocity /
	BodyPosition / AlignPosition is a hidden parking brake; a BodyGyro blocks turning. Strip by explicit class name
	(works the same in the headless sim) PLUS the abstract bases. WeldConstraint / NoCollisionConstraint are not
	Constraint subclasses, so they are listed by name. Every part is re-welded to the primary afterwards. ]]
local STRIP_CLASSES: { [string]: boolean } = {
	Humanoid = true, Tool = true, Seat = true, VehicleSeat = true, SpawnLocation = true,
	Script = true, LocalScript = true, ModuleScript = true,
	-- Constraint family
	AlignOrientation = true, AlignPosition = true, AngularVelocity = true, BallSocketConstraint = true,
	HingeConstraint = true, LineForce = true, LinearVelocity = true, PlaneConstraint = true, Plane = true,
	PrismaticConstraint = true, CylindricalConstraint = true, RigidConstraint = true, RodConstraint = true,
	RopeConstraint = true, SpringConstraint = true, Torque = true, TorsionSpringConstraint = true,
	UniversalConstraint = true, VectorForce = true, AnimationConstraint = true,
	-- legacy movers
	BodyAngularVelocity = true, BodyForce = true, BodyGyro = true, BodyPosition = true, BodyThrust = true,
	BodyVelocity = true, RocketPropulsion = true,
	-- joints (every part is re-welded to the primary below)
	Weld = true, Motor6D = true, Motor = true, Snap = true, ManualWeld = true, Glue = true, ManualGlue = true,
	Rotate = true, RotateP = true, RotateV = true, VelocityMotor = true, WeldConstraint = true, NoCollisionConstraint = true,
	-- gameplay objects a dress model must never bring along
	ProximityPrompt = true, ClickDetector = true, DragDetector = true, Sound = true, ForceField = true,
}
local STRIP_BASES = { "Constraint", "BodyMover", "JointInstance", "LuaSourceContainer" }

local function shouldStrip(d: Instance): boolean
	if STRIP_CLASSES[d.ClassName] then
		return true
	end
	for _, b in ipairs(STRIP_BASES) do
		if d:IsA(b) then
			return true
		end
	end
	return false
end

-- Destroys every strippable descendant; returns { [ClassName] = count } (children of a stripped object not counted).
local function stripDress(root: Instance): { [string]: number }
	local counts: { [string]: number } = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d.Parent ~= nil and shouldStrip(d) then
			counts[d.ClassName] = (counts[d.ClassName] or 0) + 1
			d:Destroy()
		end
	end
	return counts
end

local function mergeCounts(into: { [string]: number }, from: { [string]: number }?)
	if from then
		for k, n in pairs(from) do
			into[k] = (into[k] or 0) + n
		end
	end
end

local function stripSummary(counts: { [string]: number }): string
	local keys: { string } = {}
	for k in pairs(counts) do
		table.insert(keys, k)
	end
	if #keys == 0 then
		return "stripped nothing"
	end
	table.sort(keys)
	local parts: { string } = {}
	for _, k in ipairs(keys) do
		table.insert(parts, k .. "×" .. tostring(counts[k]))
	end
	return "stripped " .. table.concat(parts, ", ")
end

-- owner list: whole models listed in VisualAssetConfig.StripEffectsAssetIds lose their effects at load
local EFFECT_CLASSES = { "Fire", "Smoke", "Sparkles", "ParticleEmitter", "Light", "Beam", "Trail" }

local function stripsEffects(assetId: number): boolean
	local list = (VisualAssetConfig :: any).StripEffectsAssetIds
	if typeof(list) ~= "table" then
		return false
	end
	for _, id in ipairs(list) do
		if id == assetId then
			return true
		end
	end
	return false
end

-- Destroys every effect under root; adds what went to counts.
local function stripEffects(root: Instance, counts: { [string]: number })
	for _, d in ipairs(root:GetDescendants()) do
		if d.Parent ~= nil then
			for _, cls in ipairs(EFFECT_CLASSES) do
				if d:IsA(cls) then
					counts[d.ClassName] = (counts[d.ClassName] or 0) + 1
					d:Destroy()
					break
				end
			end
		end
	end
end

-- Template prep shared by loadModel and the test hook: dress-strip once, then anchor for the template.
local function prepareTemplate(assetId: number, model: Model)
	stripScripts(model)
	templateStrips[assetId] = stripDress(model)
	if stripsEffects(assetId) then
		stripEffects(model, templateStrips[assetId])
	end
	model.Name = "WE_Asset_" .. tostring(assetId)
	-- Anchor all for template; clones will reconfigure
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CastShadow = false
			d.Massless = true
		end
	end
end

-- ── W3 LOOK: part cap, packs and pieces ─────────────────────────────────────────────────────────────────────────
local function maxParts(): number
	local n = tonumber((VisualAssetConfig :: any).MaxPartsPerModel)
	return if n and n > 0 then n else 40
end

local function countParts(root: Instance): number
	local n = if root:IsA("BasePart") then 1 else 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

local function hasHumanoid(root: Instance): boolean
	return root:IsA("Humanoid") or root:FindFirstChildWhichIsA("Humanoid", true) ~= nil
end

local function refId(ref: any): number
	if typeof(ref) == "table" and typeof(ref.ModelAssetId) == "number" and ref.ModelAssetId > 0 then
		return ref.ModelAssetId
	end
	return 0
end

-- Every configured AssetRef (buckets one or two levels deep) that picks a piece of assetId.
local function pieceRefsFor(assetId: number): { AssetRef }
	local out: { AssetRef } = {}
	local function visit(t: any, depth: number)
		if typeof(t) ~= "table" or depth > 2 then
			return
		end
		if typeof(t.ModelAssetId) == "number" then
			if t.ModelAssetId == assetId and typeof(t.ChildName) == "string" then
				table.insert(out, t :: AssetRef)
			end
			return
		end
		for _, v in pairs(t) do
			visit(v, depth + 1)
		end
	end
	visit(VisualAssetConfig, 0)
	return out
end

local function isPack(assetId: number): boolean
	return #pieceRefsFor(assetId) > 0
end

-- the OmitParts names of a ref ({} when none)
local function omitNames(ref: AssetRef): { string }
	local out: { string } = {}
	local list = ref.OmitParts
	if typeof(list) == "table" then
		for _, nm in ipairs(list) do
			if typeof(nm) == "string" and nm ~= "" then
				table.insert(out, nm)
			end
		end
	end
	return out
end

local function pieceKey(ref: AssetRef): string
	local omit = omitNames(ref)
	return tostring(refId(ref)) .. "|" .. tostring(ref.ChildName) .. "|" .. tostring(ref.SubModel or "") .. "|" .. (if ref.StripDecals then "d" else "")
		.. (if #omit > 0 then "|-" .. table.concat(omit, ",") else "")
end

-- One configured piece of a prepared pack → its own template (or nil + reason). The pack itself is not changed.
local function extractPiece(pack: Instance, ref: AssetRef): (Instance?, string?)
	local name = ref.ChildName
	if typeof(name) ~= "string" then
		return nil, "no ChildName"
	end
	local piece = pack:FindFirstChild(name, true) -- the name holds "/": never split it
	if piece == nil then
		return nil, "child not found: " .. name
	end
	if typeof(ref.SubModel) == "string" then
		local sub = piece:FindFirstChild(ref.SubModel) or piece:FindFirstChild(ref.SubModel, true)
		if sub == nil then
			return nil, "sub-model not found: " .. ref.SubModel
		end
		piece = sub
	end
	if not (piece:IsA("BasePart") or piece:IsA("Model") or piece:IsA("Folder")) then
		return nil, "unsupported class " .. piece.ClassName
	end
	local copyOrNil: Instance? = piece:Clone()
	if copyOrNil == nil then
		return nil, "not archivable"
	end
	local copy: Instance = copyOrNil
	local t: Instance = copy
	if copy:IsA("BasePart") then
		-- one piece = one part: nested pieces, SurfaceAppearance, attachments all go
		for _, c in ipairs(copy:GetChildren()) do
			c:Destroy()
		end
	elseif copy:IsA("Folder") then
		local m = Instance.new("Model")
		for _, c in ipairs(copy:GetChildren()) do
			c.Parent = m
		end
		copy:Destroy()
		t = m
	end
	stripScripts(t)
	stripDress(t)
	for _, d in ipairs(t:GetDescendants()) do
		if ref.StripDecals and (d:IsA("Decal") or d:IsA("Texture")) then
			d:Destroy()
		end
	end
	for _, d in ipairs(if t:IsA("BasePart") then { t :: Instance } else t:GetDescendants()) do
		if d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			d.Material = Enum.Material.SmoothPlastic -- no Neon from store pieces (phone bloom, world rule)
		end
	end
	-- owner list: OmitParts (e.g. the Pickup Truck's tail-light glass) go before the part count
	local omit = omitNames(ref)
	if #omit > 0 and not t:IsA("BasePart") then
		local drop: { [string]: boolean } = {}
		for _, nm in ipairs(omit) do
			drop[nm] = true
		end
		for _, d in ipairs(t:GetDescendants()) do
			if d.Parent ~= nil and d:IsA("BasePart") and drop[d.Name] then
				d:Destroy()
			end
		end
	end
	local n = countParts(t)
	if n == 0 or n > maxParts() or hasHumanoid(t) then
		t:Destroy()
		if n > 0 and n <= maxParts() then
			return nil, string.format("holds a Humanoid (%d parts)", n)
		end
		return nil, string.format("%d parts > cap %d (VisualAssetConfig.MaxPartsPerModel)", n, maxParts())
	end
	t.Name = "WE_Asset_" .. tostring(refId(ref)) .. "_" .. name .. (if ref.SubModel then "_" .. ref.SubModel else "")
	t.Parent = ensureFolder()
	return t, nil
end

-- Split a prepared pack into one template per configured piece, then drop the pack (only the pieces stay).
local function splitPack(assetId: number, pack: Instance)
	for _, ref in ipairs(pieceRefsFor(assetId)) do
		local key = pieceKey(ref)
		local have: Instance? = pieceCache[key]
		if have == nil and pieceFailed[key] == nil then
			local t, why = extractPiece(pack, ref)
			if t then
				pieceCache[key] = t
			else
				pieceFailed[key] = why or "?"
				-- one line per piece (pieceFailed keeps it from being tried again); the Part kit look stays
				warn(string.format("[VisualAssetService] refused %d \"%s%s\": %s — Part kit look stays", assetId,
					tostring(ref.ChildName), if ref.SubModel then "/" .. ref.SubModel else "", why or "?"))
			end
		end
	end
	packDone[assetId] = true
	cache[assetId] = nil
	pack:Destroy()
end

-- Prepared asset → cache (whole model), or split (pack), or refused (over the part cap / Humanoid left).
local function acceptTemplate(assetId: number, model: Model): Model?
	prepareTemplate(assetId, model)
	if isPack(assetId) then
		splitPack(assetId, model)
		print("[VisualAssetService] Split pack", assetId)
		return nil
	end
	local n = countParts(model)
	if n > maxParts() or hasHumanoid(model) then
		failed[assetId] = true
		model:Destroy()
		local why = if n > maxParts()
			then string.format("%d parts > cap %d (VisualAssetConfig.MaxPartsPerModel)", n, maxParts())
			else string.format("holds a Humanoid (%d parts)", n)
		warn(string.format("[VisualAssetService] refused %d: %s — Part kit look stays", assetId, why))
		return nil
	end
	model.Parent = ensureFolder()
	cache[assetId] = model
	return model
end

-- true when a LoadAsset error message says retrying cannot help (VisualAssetConfig.LoadRetryPermanentErrors)
local function isPermanentError(msg: string): boolean
	local lower = string.lower(msg)
	local list = (VisualAssetConfig :: any).LoadRetryPermanentErrors
	if typeof(list) ~= "table" then
		return false
	end
	for _, pat in ipairs(list) do
		if typeof(pat) == "string" and pat ~= "" and string.find(lower, pat, 1, true) then
			return true
		end
	end
	return false
end

-- InsertService (AssetService fallback) → the asset's Model, or (nil, "transient" | "permanent", error text). Yields.
-- Marks and logs nothing for a LoadAsset error: loadAttempt decides (silent background retry, or one final line).
local function insertAsset(assetId: number): (Model?, string?, string?)
	local ok, result = pcall(function()
		return InsertService:LoadAsset(assetId)
	end)
	local errs: { string } = {}
	if not ok or typeof(result) ~= "Instance" then
		table.insert(errs, tostring(result))
		-- AssetService fallback (newer API)
		local AssetService = game:GetService("AssetService")
		if AssetService and (AssetService :: any).LoadAssetAsync then
			ok, result = pcall(function()
				return (AssetService :: any):LoadAssetAsync(assetId)
			end)
			if not ok or typeof(result) ~= "Instance" then
				table.insert(errs, tostring(result))
			end
		end
	end
	if not ok or typeof(result) ~= "Instance" then
		-- transient only when no message says the asset can never load here
		local kind = "transient"
		for _, e in ipairs(errs) do
			if isPermanentError(e) then
				kind = "permanent"
				break
			end
		end
		return nil, kind, table.concat(errs, " | ")
	end

	local container = result :: Instance
	stripScripts(container)
	local model: Model? = nil
	if container:IsA("Model") then
		model = container
	else
		for _, c in ipairs(container:GetChildren()) do
			if c:IsA("Model") then
				model = c
				break
			end
		end
	end
	if not model then
		container:Destroy()
		warn("[VisualAssetService] No Model in asset", assetId, "— Part kit look stays")
		return nil, "logged", nil
	end
	if container ~= model then
		model.Parent = nil
		pcall(function()
			container:Destroy()
		end)
	end
	return model, nil, nil
end

local function releaseWaiters(assetId: number)
	local list = inflight[assetId]
	inflight[assetId] = nil
	if list then
		for _, co in ipairs(list) do
			task.spawn(co)
		end
	end
end

local function maxLoadAttempts(): number
	return tonumber(VisualAssetConfig.MaxLoadAttempts) or 36
end

-- retries may use the load budget only up to MaxLoadAttempts - LoadRetryReserve (the rest is kept for first loads)
local function retryBudgetLeft(): boolean
	local reserve = math.max(0, math.floor(tonumber(VisualAssetConfig.LoadRetryReserve) or 0))
	return loadAttempts < maxLoadAttempts() - reserve
end

-- the load cap refuses assetId: one Output line per id (the Part kit look stays)
local function refuseOverCap(assetId: number)
	if capLogged[assetId] then
		return
	end
	capLogged[assetId] = true
	capRefused += 1
	warn(string.format("[VisualAssetService] load cap reached (%d attempts, VisualAssetConfig.MaxLoadAttempts): %d not loaded — Part kit look stays",
		maxLoadAttempts(), assetId))
end

local scheduleRetry: (number, string) -> ()

-- One insert of assetId (counts toward MaxLoadAttempts; the caller checked the cap). Other first-try callers for the id
-- wait on inflight[assetId]; during a retry cooling[assetId] stays set, so nobody waits on it. A transient failure
-- schedules a background retry; any other failure is final.
local function loadAttempt(assetId: number): Model?
	loadAttempts += 1
	inflight[assetId] = {}
	local kind: string? = nil
	local errText = "?"
	local ok, res = pcall(function(): Model?
		local model, why, text = insertAsset(assetId)
		if model == nil then
			kind = why
			errText = text or "?"
			return nil
		end
		local kept = acceptTemplate(assetId, model)
		if kept then
			print("[VisualAssetService] Cached catalog model", assetId, kept.Name)
		end
		return kept
	end)
	-- record the outcome (failed / cooling) BEFORE waking waiters: a woken waiter whose caller asks for the same id
	-- again (a dress loop, another piece of the same pack) must see it, never start a second insert
	if not ok then
		failed[assetId] = true
		warn("[VisualAssetService] template prep failed", assetId, res)
	elseif res == nil and kind == "transient" then
		scheduleRetry(assetId, errText) -- silent until it finally loads (one print) or gives up (one warn)
	elseif res == nil and kind == "permanent" then
		failed[assetId] = true
		warn(string.format("[VisualAssetService] LoadAsset failed %d (%s) — Part kit look stays", assetId, errText))
	elseif res == nil and kind ~= nil then
		failed[assetId] = true -- no Model in the asset (already logged): never inserted again
	end
	releaseWaiters(assetId)
	if not ok then
		return nil
	end
	return res
end

-- a transient failure that will not be retried (again): final, one Output line
local function giveUp(assetId: number, tries: number, errText: string, why: string?)
	cooling[assetId] = nil
	failed[assetId] = true
	warn(string.format("[VisualAssetService] LoadAsset failed %d after %d %s (%s%s) — Part kit look stays", assetId,
		tries, if tries == 1 then "try" else "tries", errText, if why then "; " .. why else ""))
end

-- Background retry after a transient failure: LoadRetryDelay s, then x LoadRetryBackoff each time; after
-- LoadRetryCount retries the id is final. Never yields the caller (task.delay); the budget is re-checked when it runs.
function scheduleRetry(assetId: number, errText: string)
	local tries = retryTries[assetId] or 0
	local maxTries = math.max(0, math.floor(tonumber(VisualAssetConfig.LoadRetryCount) or 0))
	if tries >= maxTries then
		giveUp(assetId, tries + 1, errText, nil)
		return
	end
	if not retryBudgetLeft() then
		giveUp(assetId, tries + 1, errText, "no retry: the last load attempts are kept for first loads")
		return
	end
	retryTries[assetId] = tries + 1
	cooling[assetId] = true
	local base = math.max(0, tonumber(VisualAssetConfig.LoadRetryDelay) or 20)
	local mult = math.max(1, tonumber(VisualAssetConfig.LoadRetryBackoff) or 2)
	task.delay(base * mult ^ tries, function()
		if cache[assetId] or packDone[assetId] or failed[assetId] then
			cooling[assetId] = nil
			return
		end
		if not retryBudgetLeft() then
			giveUp(assetId, tries + 1, errText, "no retry: the last load attempts are kept for first loads")
			return
		end
		loadAttempt(assetId) -- cooling stays set meanwhile: callers get nil, nobody waits on a retry
		if cache[assetId] or packDone[assetId] then
			cooling[assetId] = nil
			print(string.format("[VisualAssetService] %d loaded on retry %d", assetId, tries + 1))
		elseif failed[assetId] then
			cooling[assetId] = nil
		end
		-- else: another retry is scheduled (cooling stays set)
	end)
end

-- Whole-model template for assetId (nil for packs: use templateForRef). One insert per id at a time: a second caller
-- waits for the first (InsertService yields) instead of inserting the same id twice.
local function loadModel(assetId: number, forceInsert: boolean?): Model?
	if assetId == 0 or failed[assetId] or packDone[assetId] then
		return nil
	end
	if cache[assetId] then
		return cache[assetId]
	end
	-- P0: character dress MUST run even when StudioSkipWorldDressing (workers never brown bricks)
	if shouldSkipInserts() and not forceInsert then
		return nil
	end
	if cooling[assetId] then
		return nil -- a background retry is pending / running: the Part kit look now, never a wait
	end
	local waiting = inflight[assetId]
	if waiting then
		if coroutine.isyieldable() then
			table.insert(waiting, coroutine.running())
			coroutine.yield()
		end
		return cache[assetId]
	end
	if not requestSeen[assetId] then
		requestSeen[assetId] = true
		table.insert(requestOrder, assetId)
	end
	if loadAttempts >= maxLoadAttempts() then
		refuseOverCap(assetId)
		return nil
	end
	return loadAttempt(assetId)
end

-- Template for a config ref: the piece (ChildName / SubModel) of a pack, else the whole model. May yield (insert).
local function templateForRef(ref: AssetRef?): Instance?
	if ref == nil then
		return nil
	end
	local id = refId(ref)
	if id == 0 then
		return nil
	end
	if typeof(ref.ChildName) ~= "string" then
		return loadModel(id)
	end
	local key = pieceKey(ref)
	local have: Instance? = pieceCache[key]
	if have == nil and pieceFailed[key] == nil and not packDone[id] then
		loadModel(id) -- a pack id: inserts and splits it (every configured piece) before it returns
	end
	local t: Instance? = pieceCache[key]
	if t and t.Parent == nil then
		pieceCache[key] = nil -- someone destroyed the template
		return nil
	end
	return t
end

-- A template as a fresh Model (a single-part piece is wrapped).
local function cloneAsModel(template: Instance): Model?
	if template:IsA("Model") then
		return template:Clone()
	end
	local c: Instance? = template:Clone()
	if c == nil then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = template.Name
	c.Parent = m
	return m
end

-- Returns (attached, { [ClassName] = count } stripped from this clone). keepPlace: the clone is already placed
-- (a fitted vehicle body), so it is welded where it is instead of pivoted onto the primary.
local function weldCloneToPrimary(clone: Model, primary: BasePart, cloneName: string, keepPlace: boolean?): (boolean, { [string]: number })
	stripScripts(clone)
	clone.Name = cloneName

	-- Strip seats / humanoids / scripts / movers / joints / prompts / sounds — mesh is dress-only, never drive
	local stripped = stripDress(clone)

	if not keepPlace then
		pcall(function()
			clone:PivotTo(primary.CFrame)
		end)
	end

	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
			d.CastShadow = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = d
			weld.Parent = d
		end
	end
	return true, stripped
end

function VisualAssetService.IsInsertEnabled(): boolean
	return not shouldSkipInserts()
end

-- The vehicle's own ref, else its KitFamilyFallback ref (the whole ref: ChildName / Fit travel with the id).
local function resolveVehicleRef(vehicleId: string, kitFamily: string?): AssetRef?
	local vehicles = VisualAssetConfig.Vehicles :: any
	local ref = vehicles[vehicleId]
	if refId(ref) > 0 then
		return ref :: AssetRef
	end
	if typeof(ref) == "table" and ref.NoFamilyFallback == true then
		return nil -- owner list: this vehicle keeps its own Part kit (never a family body)
	end
	if kitFamily and VisualAssetConfig.KitFamilyFallback[kitFamily] then
		local fb = vehicles[VisualAssetConfig.KitFamilyFallback[kitFamily]]
		if refId(fb) > 0 then
			return fb :: AssetRef
		end
	end
	return nil
end

function VisualAssetService.ResolveVehicleAssetId(vehicleId: string, kitFamily: string?): number?
	local ref = resolveVehicleRef(vehicleId, kitFamily)
	return if ref then refId(ref) else nil
end

function VisualAssetService.ResolveCharacterAssetId(kind: string): number?
	local ref = VisualAssetConfig.Characters[kind]
	if not ref and kind == "Worker" then
		ref = VisualAssetConfig.Characters.Infantry or VisualAssetConfig.Characters.Soldier
	end
	if not ref then
		ref = VisualAssetConfig.Characters.Soldier
	end
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	local alt = (VisualAssetConfig :: any).CharacterAlt
	if alt and typeof(alt.ModelAssetId) == "number" and (alt.ModelAssetId :: number) > 0 then
		return alt.ModelAssetId
	end
	return nil
end

function VisualAssetService.ResolveBuildingAssetId(structureId: string): number?
	local ref = VisualAssetConfig.Buildings[structureId]
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	-- Fallback StructureVisualConfig.MeshAssetId (0 = composite / Part kit only)
	local ok, svc = pcall(function()
		return require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
	end)
	if ok and svc and svc.Palettes then
		local pal = svc.Palettes[structureId]
		if pal and typeof(pal.MeshAssetId) == "number" and (pal.MeshAssetId :: number) > 0 then
			return pal.MeshAssetId
		end
	end
	return nil
end

local function lookupPropRef(propKey: string): any
	local buckets = {
		(VisualAssetConfig :: any).WarzoneProps,
		VisualAssetConfig.DesertProps,
		(VisualAssetConfig :: any).MapDressing,
		(VisualAssetConfig :: any).IndustrialProps,
		(VisualAssetConfig :: any).Landmarks,
	}
	for _, bucket in ipairs(buckets) do
		if typeof(bucket) == "table" then
			local ref = bucket[propKey]
			if typeof(ref) == "table" then
				return ref
			end
		end
	end
	return nil
end

function VisualAssetService.ResolvePropAssetId(propKey: string): number?
	local ref = lookupPropRef(propKey)
	if ref and typeof(ref.ModelAssetId) == "number" and (ref.ModelAssetId :: number) > 0 then
		return ref.ModelAssetId
	end
	return nil
end

function VisualAssetService.ResolvePropMeshId(propKey: string): number?
	local ref = lookupPropRef(propKey)
	if ref and typeof(ref.MeshId) == "number" and (ref.MeshId :: number) > 0 then
		return ref.MeshId
	end
	return nil
end

-- W3 LOOK: place a vehicle body (authored axis-aligned, front -Z) on the Part kit: one uniform scale so the body is
-- as long as the kit chassis, centred on the chassis, tyre bottoms on the physics-wheel bottoms, turned by ref.Yaw.
-- Moves each part (no Model:ScaleTo / pivots), so it does not depend on how the pack set its pivot. Returns the scale.
local function fitBodyToKit(clone: Model, hostModel: Model, primary: BasePart, ref: AssetRef): number?
	local parts: { BasePart } = {}
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	if #parts == 0 then
		return nil
	end
	local lx, ly, lz = math.huge, math.huge, math.huge
	local hx, hy, hz = -math.huge, -math.huge, -math.huge
	for _, p in ipairs(parts) do
		local cf, h = p.CFrame, p.Size * 0.5
		local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
		local ex = math.abs(r.X) * h.X + math.abs(u.X) * h.Y + math.abs(l.X) * h.Z
		local ey = math.abs(r.Y) * h.X + math.abs(u.Y) * h.Y + math.abs(l.Y) * h.Z
		local ez = math.abs(r.Z) * h.X + math.abs(u.Z) * h.Y + math.abs(l.Z) * h.Z
		local c = cf.Position
		lx, ly, lz = math.min(lx, c.X - ex), math.min(ly, c.Y - ey), math.min(lz, c.Z - ez)
		hx, hy, hz = math.max(hx, c.X + ex), math.max(hy, c.Y + ey), math.max(hz, c.Z + ez)
	end
	local yawDeg = tonumber(ref.Yaw) or 0
	local sideways = math.abs(math.sin(math.rad(yawDeg))) > 0.5
	local bodyLen = if sideways then hx - lx else hz - lz
	if bodyLen <= 0.05 then
		return nil
	end
	local s = math.clamp(primary.Size.Z / bodyLen, 0.05, 4)
	-- lowest physics-wheel point in the chassis frame (else the chassis bottom)
	local bottom = -primary.Size.Y * 0.5
	local found = false
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("WE_PhysicsWheel") == true then
			local rel = primary.CFrame:ToObjectSpace(d.CFrame)
			local h = d.Size * 0.5
			local ey = math.abs(rel.RightVector.Y) * h.X + math.abs(rel.UpVector.Y) * h.Y + math.abs(rel.LookVector.Y) * h.Z
			local b = rel.Position.Y - ey
			if not found or b < bottom then
				bottom = b
				found = true
			end
		end
	end
	local anchor = Vector3.new((lx + hx) * 0.5, ly, (lz + hz) * 0.5)
	local base = primary.CFrame * CFrame.new(0, bottom, 0) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local shadowMin = primary.Size.Z * (tonumber((VisualAssetConfig :: any).FitShadowShare) or 0.5)
	for _, p in ipairs(parts) do
		local cf = p.CFrame
		local size = p.Size * s
		p.Size = size
		p.CFrame = base * CFrame.new((cf.Position - anchor) * s) * (cf - cf.Position)
		-- a few large body panels cast the car's shadow (the hidden kit no longer does); small parts never
		p:SetAttribute("WE_FitShadow", math.max(size.X, size.Y, size.Z) >= shadowMin)
	end
	return s
end

-- W3 LOOK: under a fitted body the Part-kit visuals go (Transparency 1). Physics, seats, hit boxes and names stay.
local function hideKitUnder(hostModel: Model, dress: Instance, ref: AssetRef)
	local keep: { [string]: boolean } = {}
	for _, n in ipairs(ref.KeepVisible or {}) do
		keep[n] = true
	end
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsDescendantOf(dress) and not keep[d.Name] then
			d.Transparency = 1
		end
	end
end

--[[
	Clone catalog visual under hostModel, welded to primary, non-colliding.
	Returns true if attached. Never destroys host Part kit.
]]
function VisualAssetService.TryAttachVehicleVisual(hostModel: Model, vehicleId: string, kitFamily: string?): boolean
	local ref = resolveVehicleRef(vehicleId, kitFamily)
	if not ref then
		return false
	end
	local assetId = refId(ref)
	local template = templateForRef(ref)
	-- Design P0: NO JeepFallback 59524622. Part-kit hinge chassis remains if mesh fails.
	if not template then
		return false -- Part kit remains authoritative (hinge-drive)
	end
	local primary = hostModel.PrimaryPart
	if not primary then
		return false
	end

	local clone = cloneAsModel(template)
	if not clone then
		return false
	end
	local fitted = ref.Fit == "Kit" and fitBodyToKit(clone, hostModel, primary, ref) ~= nil
	local attached, stripped = weldCloneToPrimary(clone, primary, "WE_CatalogVisual", fitted)
	if not attached then
		clone:Destroy()
		return false
	end
	if fitted then
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CastShadow = d:GetAttribute("WE_FitShadow") == true
				d:SetAttribute("WE_FitShadow", nil)
			end
		end
	end
	if not dressLogged[assetId] then
		dressLogged[assetId] = true
		local counts: { [string]: number } = {}
		mergeCounts(counts, templateStrips[assetId])
		mergeCounts(counts, stripped)
		print(string.format("[VisualAssetService] dress %d on %s: %s", assetId, vehicleId, stripSummary(counts)))
	end

	clone.Parent = hostModel
	hostModel:SetAttribute("WE_CatalogAssetId", assetId)
	-- Soften host body so catalog mesh reads; keep Part-kit physics wheels (hidden)
	primary.Transparency = math.max(primary.Transparency, if fitted and ref.HideKit then 1 else 0.72)
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("WE_PhysicsWheel") == true then
			d.Transparency = 1 -- physics collider/motor only; mesh provides visible tires
			d.CanCollide = true
			d.Massless = false
		elseif d:IsA("BasePart") and d:GetAttribute("WE_KitCosmetic") == true then
			d.Transparency = math.max(d.Transparency, 0.85)
		end
	end
	if fitted and ref.HideKit then
		hideKitUnder(hostModel, clone, ref)
	end
	-- Re-assert DriverSeat still present after mesh dress
	if not hostModel:FindFirstChild("DriverSeat") then
		warn("[VisualAssetService] DriverSeat missing after mesh attach — host kit corrupted")
	end
	return true
end

--[[
	Optional character visual overlay for NPC Part kits.
	Attaches non-colliding clone; host HumanoidRootPart stays authoritative.
]]
function VisualAssetService.TryAttachCharacterVisual(hostModel: Model, kind: string): boolean
	-- P0: always attempt character catalog inserts (bypass StudioSkipWorldDressing)
	local forceChar = true
	local assetId = VisualAssetService.ResolveCharacterAssetId(kind)
	if not assetId then
		return false
	end
	local template = loadModel(assetId, forceChar)
	-- Worker/Infantry → WorkerFallback (16134469614) → never leave brown Part bricks
	if not template then
		local fb = (VisualAssetConfig.Characters :: any).WorkerFallback
		local fbId = if fb and typeof(fb.ModelAssetId) == "number" then fb.ModelAssetId else 0
		if typeof(fbId) == "number" and fbId > 0 and fbId ~= assetId then
			template = loadModel(fbId, forceChar)
			if template then
				assetId = fbId
			end
		end
	end
	if not template and (kind == "Worker" or kind == "Infantry") then
		-- Final realistic fallback: Guard mesh
		local guard = VisualAssetConfig.Characters.Guard
		local gId = if guard and typeof(guard.ModelAssetId) == "number" then guard.ModelAssetId else 0
		if typeof(gId) == "number" and gId > 0 then
			template = loadModel(gId, forceChar)
			if template then
				assetId = gId
			end
		end
	end
	if not template then
		return false
	end
	local primary = hostModel.PrimaryPart or hostModel:FindFirstChild("HumanoidRootPart")
	if not (primary and primary:IsA("BasePart")) then
		return false
	end

	local clone = template:Clone()
	if not weldCloneToPrimary(clone, primary :: BasePart, "WE_CatalogCharacter") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostModel
	hostModel:SetAttribute("WE_CatalogAssetId", assetId)
	-- Soften Part-kit body so realistic soldier mesh reads (dress-only)
	if primary:IsA("BasePart") then
		primary.Transparency = math.max(primary.Transparency, 0.85)
	end
	for _, d in ipairs(hostModel:GetDescendants()) do
		if d:IsA("BasePart") and d.Parent ~= clone and not d:IsDescendantOf(clone) then
			if d.Name ~= "HumanoidRootPart" then
				d.Transparency = math.max(d.Transparency, 0.92)
			end
		end
	end
	return true
end

--[[
	Optional building visual overlay for structure plinth Part kits.
	Welded non-colliding; plinth remains authoritative for walk-buy.
]]
function VisualAssetService.TryAttachBuildingVisual(hostPart: BasePart, structureId: string, level: number?): boolean
	-- v68: consoles are not where the building stands (WE_SiteCFrame); never hang a catalog building on one
	if hostPart:GetAttribute("WE_Console") == true then
		return false
	end
	-- STRUCTURE_SCALE_WIRE v21: ScaleTo TargetFootprint; NEVER MeshPart.Size = plinth.
	local DRESS_GEN = 29 -- v42: Hangar≠Warehouse≠Depot, Missile≠Tower; sync StructureVisualConfig.BuildingDressGen
	local REJECTED: { [number]: boolean } = {
		[12370174722] = true, -- blockout Airport Model (Design REJECT)
		[46981739] = true, -- tiny Plane Hangar (Design REJECT)
		[13195201090] = true, -- Build-a-Boat template (Design REJECT capital)
		[12630605935] = true, -- civilian Airplane Hangar text (not ceiling)
		[11399477618] = true, -- nation-branded gate
		[10339789720] = true, -- nation-branded gate
	}

	local existingGen = tonumber(hostPart:GetAttribute("WE_BuildingDressGen"))
	if hostPart:GetAttribute("WE_CatalogAssetId") and existingGen == DRESS_GEN then
		return false
	end
	if existingGen ~= DRESS_GEN then
		for _, ch in ipairs(hostPart:GetChildren()) do
			if ch:IsA("Model") and (ch.Name == "WE_CatalogBuilding" or ch.Name == "WE_AirfieldComposite" or string.sub(ch.Name, 1, 14) == "WE_CatalogBuild") then
				ch:Destroy()
			elseif ch:IsA("BasePart") and ch:GetAttribute("WE_AirfieldComposite") == true then
				ch:Destroy()
			end
		end
		hostPart:SetAttribute("WE_CatalogAssetId", nil)
	end

	-- v44 P0: Mesh welded ON TOP; kit stays fully opaque. NEVER raise Body/Roof/host Transparency.
	-- NEVER ghost Part-kit silhouettes. Catalog mesh is optional dress on top.
	-- Prior hideKitBody (Transparency≥0.92) and hostPart.Transparency=math.max(...,0.55-0.7) left ghost pads.
	local function hideKitBody()
		-- no-op on purpose
	end
	local function keepKitSolid()
		local solid = 0
		pcall(function()
			local cfg = require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
			if typeof(cfg.SolidTransparency) == "number" then
				solid = math.min(cfg.SolidTransparency, 0.05)
			end
		end)
		-- Host plinth itself may stay slightly visible; never fade it for mesh dress
		if hostPart.Transparency > 0.35 then
			hostPart.Transparency = solid
		end
		for _, ch in ipairs(hostPart:GetChildren()) do
			if ch:IsA("BasePart") then
				local role = ch:GetAttribute("WE_KitRole")
				if role == "Body" or role == "Roof" or role == "Accent" or role == "Antenna" then
					ch.Transparency = solid
				end
			end
		end
	end

	local function footprintFor(id: string): Vector3
		local ok, svc = pcall(function()
			return require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
		end)
		if ok and svc and svc.Palettes and svc.Palettes[id] and typeof(svc.Palettes[id].TargetFootprint) == "Vector3" then
			return svc.Palettes[id].TargetFootprint
		end
		local defaults: { [string]: Vector3 } = {
			CommandCenter = Vector3.new(36, 16, 28),
			Barracks = Vector3.new(28, 12, 16),
			VehicleDepot = Vector3.new(32, 14, 24),
			WeaponsFacility = Vector3.new(28, 18, 18),
			Warehouse = Vector3.new(36, 14, 22),
			Hangar = Vector3.new(40, 18, 28),
			Helipad = Vector3.new(22, 3, 22),
			Airfield = Vector3.new(70, 1, 10),
			Watchtowers = Vector3.new(10, 32, 10),
			Radar = Vector3.new(14, 18, 14),
			ResearchLab = Vector3.new(22, 12, 16),
			Dock = Vector3.new(40, 8, 16),
			PowerStation = Vector3.new(28, 16, 20),
			DefensiveWalls = Vector3.new(24, 8, 3),
			MissileDefense = Vector3.new(14, 10, 18),
			SpecialForcesFacility = Vector3.new(26, 14, 16),
			BaseGate = Vector3.new(16, 12, 4),
		}
		return defaults[id] or Vector3.new(28, 14, 20)
	end

	local function scaleModelToFootprint(model: Model, target: Vector3): number
		local ext = model:GetExtentsSize()
		local factor = math.min(target.X / math.max(ext.X, 0.05), target.Y / math.max(ext.Y, 0.05), target.Z / math.max(ext.Z, 0.05))
		factor = math.clamp(factor, 0.05, 80)
		local okScale = pcall(function()
			model:ScaleTo(factor)
		end)
		if not okScale then
			warn("[VisualAssetService] ScaleTo failed", structureId, factor)
		end
		return factor
	end

	local function weldScaledBuilding(clone: Model, target: Vector3, cloneName: string): boolean
		scaleModelToFootprint(clone, target)
		local topY = hostPart.Position.Y + hostPart.Size.Y * 0.5
		pcall(function()
			local ext = clone:GetExtentsSize()
			clone:PivotTo(CFrame.new(hostPart.Position.X, topY + ext.Y * 0.5, hostPart.Position.Z) * (hostPart.CFrame - hostPart.Position))
		end)
		if not weldCloneToPrimary(clone, hostPart, cloneName) then
			return false
		end
		clone.Parent = hostPart
		return true
	end

	-- Airfield COMPOSITE: runway 70×1×10 + asphalt decal + VisualAssetConfig.Buildings.Hangar (0 = the Part shed)
	if structureId == "Airfield" then
		local folder = Instance.new("Model")
		folder.Name = "WE_AirfieldComposite"
		folder.Parent = hostPart

		local runway = Instance.new("Part")
		runway.Name = "WE_Runway"
		runway.Size = Vector3.new(70, 1, 10)
		runway.Anchored = true
		runway.CanCollide = false
		runway.CanQuery = false
		runway.CanTouch = false
		runway.Material = Enum.Material.Asphalt
		runway.Color = Color3.fromRGB(45, 48, 52)
		runway.CastShadow = true
		local look = hostPart.CFrame.LookVector
		runway.CFrame = CFrame.new(hostPart.Position + look * 28 + Vector3.new(0, 0.55, 0)) * (hostPart.CFrame - hostPart.Position)
		runway:SetAttribute("WE_AirfieldComposite", true)
		runway.Parent = folder
		pcall(function()
			VisualAssetService.ApplyAsphaltDecal(runway)
		end)
		for i = -3, 3 do
			local dash = Instance.new("Part")
			dash.Name = "WE_RunwayDash"
			dash.Size = Vector3.new(4, 0.12, 0.55)
			dash.Anchored = true
			dash.CanCollide = false
			dash.CanQuery = false
			dash.Material = Enum.Material.SmoothPlastic
			dash.Color = Color3.fromRGB(240, 240, 220)
			dash.CFrame = runway.CFrame * CFrame.new(i * 8, 0.56, 0)
			dash:SetAttribute("WE_AirfieldComposite", true)
			dash.Parent = folder
		end

		-- owner rule 5 (2026-09-25): the hangar id comes from config; 0 = the Part shed, no LoadAsset call
		local hangarId = refId((VisualAssetConfig.Buildings :: any).Hangar)
		local hangarTemplate = if hangarId > 0 then loadModel(hangarId) else nil
		if hangarTemplate then
			local hangar = hangarTemplate:Clone()
			scaleModelToFootprint(hangar, footprintFor("Hangar"))
			local ext = hangar:GetExtentsSize()
			pcall(function()
				hangar:PivotTo(runway.CFrame * CFrame.new(32, ext.Y * 0.5, 0))
			end)
			stripScripts(hangar)
			hangar.Name = "WE_CatalogHangar"
			for _, d in ipairs(hangar:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					d.Massless = true
					local w = Instance.new("WeldConstraint")
					w.Part0 = hostPart
					w.Part1 = d
					w.Parent = d
				end
			end
			hangar.Parent = folder
		else
			if hangarId > 0 then
				warn("[VisualAssetService] Hangar insert failed — Part shed fallback", hangarId)
			end
			local shed = Instance.new("Part")
			shed.Name = "WE_HangarShed"
			shed.Size = Vector3.new(40, 18, 28)
			shed.Anchored = true
			shed.CanCollide = false
			shed.Material = Enum.Material.Metal
			shed.Color = Color3.fromRGB(70, 75, 68)
			shed.CFrame = runway.CFrame * CFrame.new(32, 9, 0)
			shed:SetAttribute("WE_AirfieldComposite", true)
			shed.Parent = folder
			local mouth = Instance.new("Part")
			mouth.Name = "WE_HangarMouth"
			mouth.Size = Vector3.new(0.4, 14, 22)
			mouth.Anchored = true
			mouth.CanCollide = false
			mouth.Material = Enum.Material.Metal
			mouth.Color = Color3.fromRGB(30, 32, 28)
			mouth.CFrame = shed.CFrame * CFrame.new(-20.2, -1, 0)
			mouth:SetAttribute("WE_AirfieldComposite", true)
			mouth.Parent = folder
			hangarId = if hangarId > 0 then -hangarId else 0 -- a failed id is stored negative; 0 = no hangar model
		end

		keepKitSolid()
		hostPart:SetAttribute("WE_CatalogAssetId", hangarId)
		hostPart:SetAttribute("WE_BuildingDressGen", DRESS_GEN)
		return true
	end

	local assetId = VisualAssetService.ResolveBuildingAssetId(structureId)
	local lv = tonumber(level) or 0
	if structureId == "DefensiveWalls" and lv >= 3 then
		local l3 = VisualAssetConfig.Buildings.DefensiveWallsL3
		if l3 and typeof(l3.ModelAssetId) == "number" and (l3.ModelAssetId :: number) > 0 then
			assetId = l3.ModelAssetId
		else
			local okSvc, StructureVisualConfig = pcall(function()
				return require(ReplicatedStorage.Shared.Configs.StructureVisualConfig)
			end)
			if okSvc and StructureVisualConfig then
				local pal = StructureVisualConfig.Palettes and StructureVisualConfig.Palettes.DefensiveWalls
				if pal and typeof(pal.MeshAssetIdL3) == "number" and pal.MeshAssetIdL3 > 0 then
					assetId = pal.MeshAssetIdL3
				end
			end
		end
	end
	if not assetId or assetId <= 0 or REJECTED[assetId] == true then
		if assetId and REJECTED[assetId] then
			warn("[VisualAssetService] REJECTED building asset", structureId, assetId)
		end
		return false
	end
	local template = loadModel(assetId)
	if not template then
		warn("[VisualAssetService] Insert failed — Part kit remains", structureId, assetId)
		return false
	end

	local clone = template:Clone()
	if not weldScaledBuilding(clone, footprintFor(structureId), "WE_CatalogBuilding") then
		clone:Destroy()
		return false
	end
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	hostPart:SetAttribute("WE_BuildingDressGen", DRESS_GEN)
	if structureId == "BaseGate" then
		hostPart:SetAttribute("WE_DisplayName", "Base Gate")
		local dressed = hostPart:FindFirstChild("WE_CatalogBuilding")
		if dressed and dressed:IsA("Model") then
			dressed.Name = "WE_BaseGate"
		end
	end
	keepKitSolid()
	return true
end


--[[
	Optional desert prop overlay (cactus etc.) welded to a flora host part.
]]
--[[
	Attach MeshPart dress when catalog entry is MeshId-only (AssetType 40).
	Falls back to SpecialMesh on a Part if MeshPart.MeshId set fails.
]]
function VisualAssetService.TryAttachMeshPartVisual(hostPart: BasePart, meshId: number, label: string?): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") or hostPart:GetAttribute("WE_MeshId") then
		return false
	end
	if meshId <= 0 or shouldSkipInserts() then
		return false
	end
	local ok, err = pcall(function()
		local mp = Instance.new("MeshPart")
		mp.Name = label or "WE_CatalogMeshPart"
		mp.Size = hostPart.Size
		mp.Anchored = true
		mp.CanCollide = false
		mp.CanQuery = false
		mp.CanTouch = false
		mp.CastShadow = false
		mp.Massless = true
		-- MeshId via rbxassetid; if InsertService Model fails for type-40 assets
		mp.MeshId = "rbxassetid://" .. tostring(meshId)
		mp.TextureID = ""
		mp.CFrame = hostPart.CFrame
		mp.Parent = hostPart
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hostPart
		weld.Part1 = mp
		weld.Parent = mp
	end)
	if not ok then
		-- Fallback: Part + SpecialMesh
		local ok2 = pcall(function()
			local holder = Instance.new("Part")
			holder.Name = label or "WE_CatalogMeshHolder"
			holder.Size = hostPart.Size
			holder.Transparency = 1
			holder.Anchored = true
			holder.CanCollide = false
			holder.CanQuery = false
			holder.CanTouch = false
			holder.Massless = true
			holder.CFrame = hostPart.CFrame
			holder.Parent = hostPart
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = Enum.MeshType.FileMesh
			sm.MeshId = "rbxassetid://" .. tostring(meshId)
			sm.Scale = Vector3.new(1, 1, 1)
			sm.Parent = holder
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hostPart
			weld.Part1 = holder
			weld.Parent = holder
		end)
		if not ok2 then
			warn("[VisualAssetService] MeshPart pipeline failed", meshId, err)
			return false
		end
	end
	hostPart:SetAttribute("WE_MeshId", meshId)
	-- v44 P0: never raise Transparency on structure kit hosts (Body/Roof/plinth). Vehicles/props OK.
	local kitRole = hostPart:GetAttribute("WE_KitRole")
	local isStructureHost = kitRole == "Body" or kitRole == "Roof" or hostPart:GetAttribute("StructureId") ~= nil or hostPart:GetAttribute("WE_StructureId") ~= nil
	if not isStructureHost then
		hostPart.Transparency = math.max(hostPart.Transparency, 0.7)
	end
	return true
end

function VisualAssetService.TryAttachPropVisual(hostPart: BasePart, propKey: string): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") or hostPart:GetAttribute("WE_MeshId") then
		return false
	end
	-- MeshPart-only keys (DesertRock): prefer MeshId pipeline
	local meshId = VisualAssetService.ResolvePropMeshId(propKey)
	local assetId = VisualAssetService.ResolvePropAssetId(propKey)
	if (not assetId or assetId <= 0) and meshId then
		return VisualAssetService.TryAttachMeshPartVisual(hostPart, meshId, "WE_CatalogProp_" .. propKey)
	end
	if not assetId then
		return false
	end
	-- W3 LOOK: through the ref, so a ChildName piece of a pack works for props too
	local template: Instance? = templateForRef(lookupPropRef(propKey))
	-- Palm/Tent/OilPumpjack/Jersey/CamoNet/StreetLamp alt fallback (Design Bot wire)
	if not template then
		local altKey: string? = nil
		if propKey == "Palm" then
			altKey = "PalmAlt"
		elseif propKey == "Tent" then
			altKey = "TentAlt"
		elseif propKey == "OilPumpjack" then
			altKey = "OilPumpjackAlt"
		elseif propKey == "JerseyBarrier" then
			altKey = "JerseyBarrierAlt"
		elseif propKey == "CamoNet" then
			altKey = "CamoNetAlt"
		elseif propKey == "StreetLamp" then
			altKey = "StreetLampAlt"
		end
		if altKey then
			local altId = VisualAssetService.ResolvePropAssetId(altKey)
			if altId then
				template = templateForRef(lookupPropRef(altKey))
				if template then
					assetId = altId
				end
			end
		end
	end
	if not template then
		-- Last resort MeshId if both Model inserts fail
		if meshId then
			return VisualAssetService.TryAttachMeshPartVisual(hostPart, meshId, "WE_CatalogProp_" .. propKey)
		end
		return false
	end

	local clone = cloneAsModel(template)
	if not clone then
		return false
	end
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogProp") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	-- v44 P0: props on DressHost OK to soften; never fade Body/Roof structure kits
	local kitRole = hostPart:GetAttribute("WE_KitRole")
	if kitRole ~= "Body" and kitRole ~= "Roof" and hostPart:GetAttribute("StructureId") == nil then
		hostPart.Transparency = math.max(hostPart.Transparency, 0.65)
	end
	return true
end

--[[
	Paint asphalt Decal (Texture) on road Part faces. Uses MapDressing.AsphaltDecal MeshId as Decal texture id.
]]
function VisualAssetService.ApplyAsphaltDecal(roadPart: BasePart): boolean
	if roadPart:GetAttribute("WE_AsphaltDecal") then
		return false
	end
	local texId = VisualAssetService.ResolvePropMeshId("AsphaltDecal")
	if not texId or texId <= 0 then
		return false
	end
	local ok = pcall(function()
		for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Bottom }) do
			local d = Instance.new("Decal")
			d.Name = "WE_AsphaltDecal"
			d.Face = face
			d.Texture = "rbxassetid://" .. tostring(texId)
			d.Transparency = 0.15
			d.Parent = roadPart
		end
	end)
	if ok then
		roadPart:SetAttribute("WE_AsphaltDecal", texId)
	end
	return ok
end

local function collectAssetIds(primaryKey: string, fallbackKey: string?, altsKey: string?): { number }
	local ids: { number } = {}
	local seen: { [number]: boolean } = {}
	local function push(id: any)
		if typeof(id) == "number" and id > 0 and not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	local primary = (VisualAssetConfig :: any)[primaryKey]
	if primary then
		push(primary.ModelAssetId)
	end
	if fallbackKey then
		local fb = (VisualAssetConfig :: any)[fallbackKey]
		if fb then
			push(fb.ModelAssetId)
		end
	end
	if altsKey then
		local alts = (VisualAssetConfig :: any)[altsKey]
		if typeof(alts) == "table" then
			for _, ref in ipairs(alts) do
				if typeof(ref) == "table" then
					push(ref.ModelAssetId)
				end
			end
		end
	end
	return ids
end

local function loadFirst(ids: { number }): (Model?, number?)
	for _, id in ipairs(ids) do
		local template = loadModel(id)
		if template then
			return template, id
		end
	end
	return nil, nil
end

--[[
	Dress WE_MoneyCollector with ATM catalog mesh (cosmetic only).
	MoneyCollector (0 since W1: the paid hero id was dropped) → MoneyCollectorFallback 175462478 → alts → Part kit.
]]
function VisualAssetService.TryAttachCollectorVisual(hostPart: BasePart): boolean
	-- NEVER throw — Part kit ATM remains if Design Bot hero mesh / InsertService fails.
	local ok, result = pcall(function(): boolean
		if hostPart:GetAttribute("WE_CatalogAssetId") then
			return false
		end
		local template, assetId = loadFirst(collectAssetIds("MoneyCollector", "MoneyCollectorFallback", "MoneyCollectorAlts"))
		if not template or not assetId then
			return false -- Part kit only
		end
		local clone = template:Clone()
		if not weldCloneToPrimary(clone, hostPart, "WE_CatalogATM") then
			clone:Destroy()
			return false
		end
		clone.Parent = hostPart
		hostPart:SetAttribute("WE_CatalogAssetId", assetId)
		hostPart.Transparency = math.max(hostPart.Transparency, 0.55)
		-- Lime landmark glow (typed neon)
		local glow = hostPart:FindFirstChild("ATMGlow")
		if not (glow and glow:IsA("PointLight")) then
			local light = Instance.new("PointLight")
			light.Name = "ATMGlow"
			light.Color = Color3.fromRGB(120, 255, 90)
			light.Brightness = 1.1
			light.Range = 18
			light.Parent = hostPart
		else
			local pl = glow :: PointLight
			pl.Color = Color3.fromRGB(120, 255, 90)
			pl.Brightness = math.max(pl.Brightness, 1.0)
		end
		return true
	end)
	if not ok then
		warn("[VisualAssetService] TryAttachCollectorVisual failed (Part kit kept):", result)
		return false
	end
	return result == true
end

--[[
	One-shot collect burst FX — MoneyBagFX then VfxSparkles, then neon motes.
]]
function VisualAssetService.PlayMoneyBagFX(at: Vector3, parent: Instance?): boolean
	local ids = collectAssetIds("MoneyBagFX", "VfxSparkles", nil)
	local template, assetId = loadFirst(ids)
	if not template then
		local folder = Instance.new("Folder")
		folder.Name = "WE_MoneyBagFallback"
		folder.Parent = parent or game:GetService("Workspace")
		for i = 1, 6 do
			local mote = Instance.new("Part")
			mote.Name = "CashMote" .. i
			mote.Size = Vector3.new(0.35, 0.2, 0.55)
			mote.Color = Color3.fromRGB(120, 255, 90)
			mote.Material = Enum.Material.Neon
			mote.Anchored = true
			mote.CanCollide = false
			mote.CFrame = CFrame.new(at + Vector3.new((i - 3.5) * 0.4, 0.5, (i % 3 - 1) * 0.35))
			mote.Parent = folder
		end
		task.delay(0.85, function()
			folder:Destroy()
		end)
		return true
	end
	local clone = template:Clone()
	clone.Name = "WE_MoneyBagFX"
	clone:PivotTo(CFrame.new(at + Vector3.new(0, 1.5, 0)))
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.Massless = true
		elseif d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		end
	end
	clone.Parent = parent or game:GetService("Workspace")
	if assetId then
		clone:SetAttribute("WE_CatalogAssetId", assetId)
	end
	task.delay(1.2, function()
		if clone.Parent then
			clone:Destroy()
		end
	end)
	return true
end

--[[
	Optional CashCrate overlay for supply / world crates.
]]
function VisualAssetService.TryAttachCashCrateVisual(hostPart: BasePart): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") then
		return false
	end
	local ref = (VisualAssetConfig :: any).CashCrate
	local assetId = if ref and typeof(ref.ModelAssetId) == "number" then ref.ModelAssetId else 0
	if not assetId or assetId <= 0 then
		return false
	end
	local template = loadModel(assetId)
	if not template then
		return false
	end
	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogCashCrate") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	hostPart.Transparency = math.max(hostPart.Transparency, 0.55)
	return true
end

--[[
	Dress VehicleDepot showroom hosts with podium / pedestal / rotator meshes.
]]
function VisualAssetService.TryAttachShowroomVisual(plinth: BasePart): boolean
	local attached = false
	local map = {
		Podium = "ShowroomPodium",
		PodiumRing = "ShowroomPedestal",
		ShowroomMesh = "ShowroomRotator",
	}
	for role, cfgKey in pairs(map) do
		local host = plinth:FindFirstChild(role)
		if host and host:IsA("BasePart") and not host:GetAttribute("WE_CatalogAssetId") then
			local ref = (VisualAssetConfig :: any)[cfgKey]
			local id = if ref and typeof(ref.ModelAssetId) == "number" then ref.ModelAssetId else 0
			if id > 0 then
				local template = loadModel(id)
				if template then
					local clone = template:Clone()
					if weldCloneToPrimary(clone, host, "WE_CatalogShowroom") then
						clone.Parent = host
						host:SetAttribute("WE_CatalogAssetId", id)
						host.Transparency = math.max(host.Transparency, 0.65)
						attached = true
					else
						clone:Destroy()
					end
				end
			end
		end
	end

	-- Tier 2 densify: extra pedestals (ghost locked stands) + entrance flag
	for pi = 2, 3 do
		local host = plinth:FindFirstChild("ShowroomPedestalHost" .. pi)
		if host and host:IsA("BasePart") and not host:GetAttribute("WE_CatalogAssetId") then
			pcall(function()
				local template, assetId = loadFirst(collectAssetIds("ShowroomPedestal", nil, nil))
				if template and assetId then
					local clone = template:Clone()
					if weldCloneToPrimary(clone, host, "WE_CatalogPedestal") then
						clone.Parent = host
						host:SetAttribute("WE_CatalogAssetId", assetId)
						host.Transparency = math.max(host.Transparency, 0.55)
						for _, d in ipairs(clone:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Transparency = math.max(d.Transparency, 0.55)
								d.CanCollide = false
							end
						end
						attached = true
					else
						clone:Destroy()
					end
				end
			end)
		end
	end
	local flagHost = plinth:FindFirstChild("ShowroomFlagHost")
	if flagHost and flagHost:IsA("BasePart") then
		pcall(function()
			if VisualAssetService.TryAttachPropVisual(flagHost, "FlagPole") then
				attached = true
			end
		end)
	end

	return attached
end

--[[
	Dress tutorial marker with arrow mesh (first beats).
]]
function VisualAssetService.TryAttachTutorialArrow(hostPart: BasePart): boolean
	if hostPart:GetAttribute("WE_CatalogAssetId") then
		return false
	end
	local template, assetId = loadFirst(collectAssetIds("TutorialArrow", "TutorialArrowAlt", nil))
	if not template or not assetId then
		return false
	end
	local clone = template:Clone()
	if not weldCloneToPrimary(clone, hostPart, "WE_CatalogTutArrow") then
		clone:Destroy()
		return false
	end
	clone.Parent = hostPart
	hostPart:SetAttribute("WE_CatalogAssetId", assetId)
	return true
end


--[[
	Tier 2: attach HQ/Barracks/Depot interior props onto WE_DressHost_* kit parts.
	Part kit hosts remain; catalog inserts optional.
]]
function VisualAssetService.TryDressStructureInterior(plinth: BasePart, structureId: string): number
	if shouldSkipInserts() then
		return 0
	end
	local dress = (VisualAssetConfig :: any).StructureDress
	if typeof(dress) ~= "table" then
		return 0
	end
	local keys = dress[structureId]
	if typeof(keys) ~= "table" then
		return 0
	end
	local attached = 0
	local keyIdx = 1
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 12) == "WE_DressHost" then
			local propKey = child:GetAttribute("WE_DressProp")
			if typeof(propKey) ~= "string" or propKey == "" then
				propKey = keys[((keyIdx - 1) % #keys) + 1]
				keyIdx += 1
			end
			local ok = pcall(function()
				return VisualAssetService.TryAttachPropVisual(child, propKey :: string)
			end)
			if ok then
				attached += 1
			end
		end
	end
	return attached
end

function VisualAssetService.Init()
	ensureFolder()
	if shouldSkipInserts() then
		print("[VisualAssetService] Catalog inserts SKIPPED (StudioSkipWorldDressing / disabled). Part kits only.")
	else
		print("[VisualAssetService] Catalog inserts enabled — free Creator Store IDs via InsertService.")
		-- W3 LOOK: insert the vehicle body pack once, deferred, so the first 4x4 spawn does not wait on InsertService
		task.defer(function()
			local seen: { [number]: boolean } = {}
			for _, ref in pairs(VisualAssetConfig.Vehicles :: any) do
				local id = refId(ref)
				if id > 0 and typeof(ref.ChildName) == "string" and not seen[id] then
					seen[id] = true
					pcall(templateForRef, ref :: AssetRef)
				end
			end
		end)
	end
end

--[[
	W3 LOOK (contracts §8.3): one Roblox-owned mesh piece for a WorldKits Part kit (VisualAssetConfig.DesertKit[key]).
	Returns an UNPARENTED, Anchored clone (CanCollide / CanQuery / CanTouch / CastShadow false; Color / Material /
	TextureID per config), or nil when the key is 0 or unknown, inserts are skipped (Studio), or the load fails.
	YIELDS on the first load of a pack (InsertService): call only from task.defer / task.spawn.
]]
function VisualAssetService.CloneKitMesh(key: string): BasePart?
	local kit = (VisualAssetConfig :: any).DesertKit
	local ref: any = if typeof(kit) == "table" then kit[key] else nil
	if refId(ref) == 0 or typeof(ref.ChildName) ~= "string" or shouldSkipInserts() then
		return nil
	end
	local ok, template = pcall(templateForRef, ref :: AssetRef)
	if not ok or typeof(template) ~= "Instance" or not template:IsA("BasePart") then
		return nil
	end
	local mpOrNil: BasePart? = (template :: BasePart):Clone()
	if mpOrNil == nil then
		return nil
	end
	local mp: BasePart = mpOrNil
	mp.Anchored = true
	mp.CanCollide = false
	mp.CanQuery = false
	mp.CanTouch = false
	mp.CastShadow = false
	mp.Massless = true
	if typeof(ref.Color) == "Color3" then
		mp.Color = ref.Color
	end
	if typeof(ref.Material) == "EnumItem" then
		mp.Material = ref.Material :: any
	end
	if mp.Material == Enum.Material.Neon then
		mp.Material = Enum.Material.SmoothPlastic
	end
	if ref.ClearTexture == true and mp:IsA("MeshPart") then
		mp.TextureID = ""
	end
	mp.Name = key .. "Mesh"
	mp:SetAttribute("WE_Decor", true)
	mp:SetAttribute("WE_KitMesh", key)
	if typeof(ref.Yaw) == "number" then
		mp:SetAttribute("WE_KitYaw", ref.Yaw) -- WorldKits turns the piece by it (Driftwood, CarWreck)
	end
	return mp
end

--[[ Owner list: true when VisualAssetConfig.DesertKit[key] names a piece (id > 0 and a ChildName), i.e. CloneKitMesh
	can ever return a mesh for it. Config only: never loads, never yields. WorldKits spends no MeshOverlays slot on a
	key that is not wired. ]]
function VisualAssetService.IsKitMeshWired(key: string): boolean
	local kit = (VisualAssetConfig :: any).DesertKit
	local ref: any = if typeof(kit) == "table" then kit[key] else nil
	return refId(ref) > 0 and typeof(ref.ChildName) == "string"
end


--[[
	v37: static parked aircraft/boat mesh on Helipad/Dock DressHosts.
	Uses existing VisualAssetConfig vehicle ModelAssetIds (TransportHeli / PatrolBoat).
	Part-kit ParkedHeli/ParkedBoat silhouette remains if insert skipped/fails.
]]
function VisualAssetService.TryAttachParkedPresence(plinth: BasePart, structureId: string, level: number?): boolean
	if not plinth or not plinth.Parent then
		return false
	end
	local lv = tonumber(level) or 0
	if lv < 1 then
		return false
	end
	if structureId ~= "Helipad" and structureId ~= "Dock" then
		return false
	end
	local attached = false
	for _, child in ipairs(plinth:GetChildren()) do
		if child:IsA("BasePart") then
			local vehicleId = child:GetAttribute("WE_DressVehicle")
			if typeof(vehicleId) == "string" and (vehicleId :: string) ~= "" then
				if child:FindFirstChild("WE_ParkedCatalog") then
					attached = true
				else
					local ref = resolveVehicleRef(vehicleId :: string, nil)
					local assetId = if ref then refId(ref) else nil
					if assetId then
						local template = templateForRef(ref)
						local clone = if template then cloneAsModel(template) else nil
						if clone then
							if weldCloneToPrimary(clone, child, "WE_ParkedCatalog") then
								clone.Parent = child
								child:SetAttribute("WE_ParkedAssetId", assetId)
								-- v39: keep Part-kit parked silhouette visible under optional mesh
								for _, sib in ipairs(plinth:GetChildren()) do
									if sib:IsA("BasePart") then
										local role = sib:GetAttribute("WE_KitRole")
										if role == "ParkedHeli" or role == "ParkedBoat" then
											sib.Transparency = math.min(sib.Transparency, 0.35)
										end
									end
								end
								attached = true
							else
								clone:Destroy()
							end
						end
					end
				end
			end
		end
	end
	return attached
end


-- Test hook (headless sim, judge K2): install the asset for assetId as InsertService would return it, through the
-- same prep loadModel runs (a pack is split into its configured pieces; the part cap applies).
function VisualAssetService._SetTemplate(assetId: number, model: Model)
	local prefix = tostring(assetId) .. "|"
	for k, t in pairs(pieceCache) do
		if string.sub(k, 1, #prefix) == prefix then
			t:Destroy()
			pieceCache[k] = nil
		end
	end
	for k in pairs(pieceFailed) do
		if string.sub(k, 1, #prefix) == prefix then
			pieceFailed[k] = nil
		end
	end
	local old = cache[assetId]
	if old and old ~= model then
		old:Destroy()
	end
	cache[assetId] = nil
	failed[assetId] = nil
	cooling[assetId] = nil
	retryTries[assetId] = nil
	packDone[assetId] = nil
	dressLogged[assetId] = nil
	acceptTemplate(assetId, model)
end

-- Test hook: loader counters. Requested = distinct ids that asked for an insert (first tries), CapRefused = distinct
-- ids refused by MaxLoadAttempts, Cooling = ids with a background retry pending / running, Failed = final failures.
function VisualAssetService._Stats(): { LoadAttempts: number, Cached: number, Pieces: number, PiecesFailed: number, PacksSplit: number, Requested: number, CapRefused: number, Cooling: number, Failed: number }
	local c, p, f, d, cool, fin = 0, 0, 0, 0, 0, 0
	for _ in pairs(cooling) do
		cool += 1
	end
	for _ in pairs(failed) do
		fin += 1
	end
	for _ in pairs(cache) do
		c += 1
	end
	for _ in pairs(pieceCache) do
		p += 1
	end
	for _ in pairs(pieceFailed) do
		f += 1
	end
	for _ in pairs(packDone) do
		d += 1
	end
	return {
		LoadAttempts = loadAttempts,
		Cached = c,
		Pieces = p,
		PiecesFailed = f,
		PacksSplit = d,
		Requested = #requestOrder,
		CapRefused = capRefused,
		Cooling = cool,
		Failed = fin,
	}
end

-- Test hook: the distinct ids that asked for an insert, in first-request order (a copy).
function VisualAssetService._Requested(): { number }
	return table.clone(requestOrder)
end

return VisualAssetService
]]></string>
          </Properties>
