          <Properties>
            <string name="Name">WeaponConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[ Weapon definitions — damage/fireRate server-authoritative later ]]

export type WeaponDef = {
	Id: string,
	DisplayName: string,
	Rarity: string,
	UnlockLevel: number,
	Damage: number,
	FireRate: number, -- shots per second
	MagazineSize: number,
	ReloadTime: number,
	Range: number,
	Spread: number,
	CostCash: number?,
	Pellets: number?, -- shotgun-style; server applies Damage * Pellets max
}

local WeaponConfig = {
	Weapons = {
		StarterRifle = {
			Id = "StarterRifle",
			DisplayName = "Starter Rifle",
			Rarity = "Common",
			UnlockLevel = 1,
			Damage = 18,
			FireRate = 8,
			MagazineSize = 30,
			ReloadTime = 2.2,
			Range = 120,
			Spread = 2.5,
			CostCash = 0,
		},
		AssaultRifle = {
			Id = "AssaultRifle",
			DisplayName = "Assault Rifle",
			Rarity = "Common",
			UnlockLevel = 3,
			Damage = 22,
			FireRate = 9,
			MagazineSize = 30,
			ReloadTime = 2.0,
			Range = 140,
			Spread = 2.0,
			CostCash = 5000,
		},
		SMG = {
			Id = "SMG",
