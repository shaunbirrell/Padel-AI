			Kit = "lab",
		},
		Helipad = {
			Plinth = Color3.fromRGB(45, 50, 48),
			Body = Color3.fromRGB(60, 70, 65),
			Accent = Color3.fromRGB(220, 200, 80),
			Roof = Color3.fromRGB(50, 55, 52),
			Kit = "pad",
		},
		Dock = {
			Plinth = Color3.fromRGB(35, 48, 58),
