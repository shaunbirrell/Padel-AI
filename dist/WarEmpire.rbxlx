		},
		{
			AtPrestige = 13,
			Flag = "RebirthMortar",
			DisplayName = "Mortar Carrier (owned)",
			Kind = "Vehicle",
			Id = "MortarCarrier",
			GrantOwned = true,
			Gate = "Vehicles", -- claude-bud JOB 33 (RebirthConfig.LiveFor)
		},
		{
			AtPrestige = 14,
			Flag = "RebirthMediumTank",
			DisplayName = "Medium Tank (owned)",
			Kind = "Vehicle",
			Id = "MediumTank",
