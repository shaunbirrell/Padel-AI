			{ Id = "SW_Benches_1", Block = "SW", Role = "benches", Tier = 2, X = -188, Z = 150, Yaw = -90, Kits = { { Kit = "Bench", X = -12, Z = 0 }, { Kit = "Bench", X = 12, Z = 0 } } },
			{ Id = "SW_Square_S", Block = "SW", Role = "block", Tier = 1, X = -150, Z = 216, Yaw = 0, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "shop", Width = 34, Depth = 18, Storeys = 3, Roof = "tank", Color = Color3.fromRGB(204, 176, 132) } } }, -- closes the square's south side
			{ Id = "SW_Square_W", Block = "SW", Role = "block", Tier = 2, X = -216, Z = 150, Yaw = -90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Width = 30, Depth = 18, Storeys = 2, Roof = "tank", Color = Color3.fromRGB(190, 138, 104) } } }, -- closes the square's west side
			{ Id = "SW_RadioMast", Block = "SW", Role = "mast", Tier = 1, X = -214, Z = 212, Yaw = 0, Kits = { { Kit = "RadioMast", X = 0, Z = 0 } } }, -- 90-tall lattice mast over the square: the SW skyline marker
			{ Id = "SW_Nest", Block = "SW", Role = "nest", Tier = 2, X = -95, Z = 95, Yaw = 135, Kits = { { Kit = "SandbagArc", X = 0, Z = 0 } } }, -- sandbag arc on the plaza corner, facing the flag
			-- SE: frontage on the east arm (fronts facing north) and the south arm past the Pool_Town pad (fronts facing west); motor pool shed
			{ Id = "SE_E1", Block = "SE", Role = "block", Tier = 1, X = 143.4, Z = 51.1, Yaw = 0, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "shop+left", Width = 26, Depth = 24, Storeys = 3, Roof = "tank", Lantern = true, Color = Color3.fromRGB(204, 176, 132) } } },
			{ Id = "SE_E2", Block = "SE", Role = "block", Tier = 2, X = 176.2, Z = 46.8, Yaw = 0, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Width = 24, Depth = 20, Storeys = 2, Color = Color3.fromRGB(190, 138, 104) } } },
			{ Id = "SE_E3", Block = "SE", Role = "block", Tier = 2, X = 207.6, Z = 47.1, Yaw = 0, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "damaged", Width = 24, Depth = 22, Storeys = 3, Color = Color3.fromRGB(185, 150, 105) } } },
			{ Id = "SE_E4", Block = "SE", Role = "block", Tier = 2, X = 235.6, Z = 44.3, Yaw = 0, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Width = 20, Depth = 18, Storeys = 2, Roof = "bare+tank", Color = Color3.fromRGB(214, 202, 176) } } },
			{ Id = "SE_S1", Block = "SE", Role = "block", Tier = 1, X = 49.7, Z = 224.4, Yaw = 90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "shop", Width = 24, Depth = 22, Storeys = 3, Roof = "tank", Color = Color3.fromRGB(185, 150, 105) } } },
			{ Id = "SE_S2", Block = "SE", Role = "block", Tier = 2, X = 45.7, Z = 254.8, Yaw = 90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Width = 22, Depth = 20, Storeys = 2, Roof = "bare", Color = Color3.fromRGB(214, 202, 176) } } },
			{ Id = "SE_S3", Block = "SE", Role = "block", Tier = 2, X = 42.9, Z = 280.8, Yaw = 90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "damaged", Width = 18, Depth = 16, Storeys = 2, Color = Color3.fromRGB(190, 138, 104) } } },
			{ Id = "SE_MotorShed", Block = "SE", Role = "block", Tier = 2, X = 100, Z = 170, Yaw = 90, Kits = { { Kit = "TownBlock", X = 0, Z = 0, Variant = "shop", Width = 26, Depth = 16, Storeys = 1, Color = Color3.fromRGB(148, 144, 132) } } }, -- motor pool shed facing the Pool_Town pad
			{ Id = "SE_MotorPool", Block = "SE", Role = "motorpool", Tier = 2, X = 76, Z = 170, Yaw = 90, Kits = { { Kit = "Jersey", X = -4, Z = 0 }, { Kit = "Jersey", X = 4, Z = 0 }, { Kit = "DrumGroup", X = 0, Z = 3, Count = 2 } } }, -- beside the Pool_Town garage pad (+16 clear)
			{ Id = "SE_Wreck", Block = "SE", Role = "wreck", Tier = 1, X = 232, Z = 14.5, Yaw = 0, Street = true, Kits = { { Kit = "Wreck", X = 0, Z = 0, Variant = "truck" } } }, -- burnt truck parked on the east-arm verge (collidable >= 13 off the line)
		} :: { TownCluster },
		Rocks = {
			{ Kind = "rubble", X = -68, Z = -262, Radius = 6, Tier = 1 }, -- the damaged north-arm block
			{ Kind = "rubble", X = -262, Z = -62, Radius = 6, Tier = 1 }, -- the burnt-out west-arm shell
			{ Kind = "rubble", X = -130, Z = -222, Radius = 6, Tier = 1 }, -- behind the market lane
			{ Kind = "rubble", X = 85, Z = -125, Radius = 6, Tier = 1 }, -- under the tower block's blown corner
			{ Kind = "rubble", X = 290, Z = -64, Radius = 5, Tier = 1 }, -- the burnt-out east-arm shell
			{ Kind = "rubble", X = -66, Z = 262, Radius = 6, Tier = 1 }, -- the damaged south-arm block
			{ Kind = "rubble", X = 228, Z = 72, Radius = 6, Tier = 1 }, -- the damaged east-arm block
			{ Kind = "rubble", X = 66, Z = 290, Radius = 6, Tier = 1 }, -- the damaged south-arm block
			{ Kind = "scorch", X = 150, Z = 170, Radius = 9, Tier = 1 }, -- a burnt patch behind the east-arm frontage
		} :: { TownRock },
		-- W3 step 2 activity anchors (world studs; see the Activity section). WorldPOI stamps each Town row on the first
		-- part of the cluster it Requires (a Town row always names one) and Activity.CheckpointAnchors on CP_N / CP_E /
		-- CP_S / CP_W (ids Town.CP_N.Booth …). 0 parts: the Town stays at 368 / 370.
		Anchors = {
			{ Id = "Town.Market.Box", Kind = "search", X = -81, Z = -169.3, Yaw = 0, R = 5, Prompt = "hold", Requires = "NW_Stall_1" }, -- the market cache, at the NW_Stall_1 counter (1.8 clear of it in the HEAD dump)
		} :: { ActivityAnchor },
		-- The Empire Bank's anchors (spec w3s2 §5). MapSetup (lane BK) stamps them on BankPlaza (top 1.6 = Y 1.1) once the
		-- 17-part hall is built; until then nothing stamps them and BankRaidService keeps its fallback posts.
		BankAnchors = {
			{ Id = "Town.Bank.Door", Kind = "door", X = 220, Z = -212.5, Yaw = 180, Y = 1.1, Prompt = "hold", Part = "BankGate" }, -- breach: hold 3 s, on foot
			{ Id = "Town.Bank.Vault", Kind = "hold", X = 220, Z = -226, Yaw = 180, Y = 1.1, R = 8 }, -- the crack ring stays inside the hall's walls
			{ Id = "Town.Bank.Loot", Kind = "loot", X = 220, Z = -228, Yaw = 180, Y = 1.1, Prompt = "hold" }, -- "Grab cash"
			{ Id = "Town.Bank.G1", Kind = "npc", X = 206, Z = -209.5, Yaw = 180, Y = 1.1 }, -- behind PlanterW
			{ Id = "Town.Bank.G2", Kind = "npc", X = 234, Z = -209.5, Yaw = 180, Y = 1.1 }, -- behind PlanterE
			{ Id = "Town.Bank.G3", Kind = "npc", X = 210.5, Z = -210.5, Yaw = 180, Y = 1.1 }, -- beside the west column
			{ Id = "Town.Bank.G4", Kind = "npc", X = 229.5, Z = -210.5, Yaw = 180, Y = 1.1 }, -- beside the east column
			{ Id = "Town.Bank.G5", Kind = "npc", X = 227, Z = -231, Yaw = 180, Y = 1.1 }, -- inside, by the vault door (Post stance)
			{ Id = "Town.Bank.R1", Kind = "npc", X = 252, Z = -208, Yaw = 90 }, -- alarm reinforcements, off the plaza (facing the bank)
			{ Id = "Town.Bank.R2", Kind = "npc", X = 188, Z = -208, Yaw = -90 },
		} :: { ActivityAnchor },
	},

	-- ── Spawn pads and anchors (spec §3.3; the hook step replaces MapSetup's makeSpawnFolder rings with these) ───
	Spawns = {
		-- Garage pads (WE_VehicleSpawn): painted Concrete aprons, no beacon, no billboard. Gate pads are plot-local
		-- (BaseLayout.PlotPoint(plotPos, LocalX, LocalZ)) and face the plot forward; pools face Yaw (degrees, 0 = -Z).
		PadSize = Vector3.new(20, 1.2, 20),
		Garage = {
			{ Id = "Gate_P1", PlotId = 1, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P2", PlotId = 2, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P3", PlotId = 3, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P4", PlotId = 4, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P5", PlotId = 5, LocalX = -62, LocalZ = 222 },
			{ Id = "Gate_P6", PlotId = 6, LocalX = -62, LocalZ = 222 },
			{ Id = "Pool_Depot", X = -1180, Z = 34, Yaw = -90 }, -- faces +X (RoadZ0)
			{ Id = "Pool_Armory", X = 1180, Z = -34, Yaw = 90 }, -- faces -X
			{ Id = "Pool_Town", X = 40, Z = 170, Yaw = 0 }, -- faces -Z
			{ Id = "Pool_Airstrip", X = 740, Z = -1180, Yaw = 180 }, -- faces +Z
		} :: { Pad },
		TutorialJeepPad = "Gate_P1", -- the tutorial's jeep step targets the player's own gate pad
		-- Invisible anchors (Transparency 1, CanCollide false, 14 x 1.2 x 14 at y 1)
		AnchorSize = Vector3.new(14, 1.2, 14),
		NPC = {
			{ Id = "Quarry_1", X = -1470, Z = -1300 },
			{ Id = "Quarry_2", X = -1320, Z = -1480 },
			{ Id = "Quarry_3", X = -1260, Z = -1330 },
			{ Id = "Quarry_4", X = -1440, Z = -1420 },
			{ Id = "Ridge_1", X = 1360, Z = -1100 },
			{ Id = "Ridge_2", X = 1480, Z = -1010 },
			{ Id = "Ridge_3", X = 1450, Z = -1120 },
			{ Id = "Dune_1", X = 1400, Z = 1150 },
			{ Id = "Dune_2", X = 1520, Z = 1240 },
			{ Id = "Dune_3", X = 1470, Z = 1300 },
		} :: { Anchor },
		Event = {
			{ Id = "TownSquare", X = -150, Z = 150 },
			{ Id = "AirdropApron", X = 520, Z = -1190 },
			{ Id = "Salvage", X = -520, Z = 1080 },
			{ Id = "VillageSquare", X = -540, Z = -1300 },
			{ Id = "OilYard", X = 1100, Z = 1100 },
			{ Id = "Quay", X = 250, Z = 1250 },
		} :: { Anchor },
	},

	-- ── W3 step 2 activity anchors (spec w3s2 §1.5–§1.6, §5; contract scratchpad w3s2/build/L0/contract.md) ─────────
	-- A job place is a set of invisible anchors: one Attachment per anchor (0 parts), tagged Tag, carrying the Attr
	-- attributes. The geometry stamps them through ActivityAnchors.Stamp (WorldPOI: layout rows on the POI's
	-- ActivityHost part, template rows on each CheckpointBooth, Town rows on a part of the cluster they Require;
	-- MapSetup: Town.BankAnchors on BankPlaza). The jobs read them through ActivityAnchors.List / Get (server only).
	-- Id = "<POI>.<Site>.<Role>": POI = a POIs Id, Site = one job place at it, Role = what the anchor is for there;
	-- the site id is "<POI>.<Site>". A site is live only when its POI is enabled and every anchor its job needs exists.
	Activity = {
		Tag = "WE_ActivityAnchor", -- CollectionService tag on every anchor Attachment
		Attr = {
			Id = "WE_ActivityId", -- string, the full id
			Site = "WE_ActivitySite", -- string, "<POI>.<Site>"
			POI = "WE_ActivityPOI", -- string
			Role = "WE_ActivityRole", -- string
			Kind = "WE_ActivityKind", -- string, one of Kinds
			Yaw = "WE_ActivityYaw", -- number, degrees (0 = faces north, -Z)
			R = "WE_ActivityR", -- number (optional): zone radius
			Prompt = "WE_ActivityPrompt", -- string (optional): one of Prompts
			Part = "WE_Part", -- string (optional): the part a door anchor opens (HeistGate, BunkerDoor, BankGate)
			BoxW = "WE_ActivityBoxW", -- number (optional): vehicle spawn box width
			BoxL = "WE_ActivityBoxL", -- number (optional): vehicle spawn box length
			Probe = "WE_ActivityProbe", -- boolean (optional): test clearance at runtime, fall back to the nearest post
		},
		-- On a part the jobs move or toggle at runtime (BankGate, HeistGate, BunkerDoor): WorldHygiene Enforce leaves it
		-- alone. GateStateAttr on the same part: "open" (raised, CanCollide false) | "closed".
		RuntimeDoorAttr = "WE_RuntimeDoor",
		GateStateAttr = "WE_GateState",
		HostKit = "ActivityHost", -- the 1-part invisible host kit each POI layout places once (its anchors attach to it)
		CheckpointKit = "Checkpoint", -- every instance gets CheckpointAnchors …
		CheckpointHost = "CheckpointBooth", -- … stamped on this part of the kit
		FloorY = 0.5, -- anchor world Y = FloorY + (row Y or 0): the standing surface, never a lifted prompt height
		MinClear = 1, -- studs: no anchor (Probe ones aside) within this of a collidable part (the geometry tests)
		Kinds = {
			"door", -- breach point in front of a door / gate part (Part names it)
			"hold", -- stand-in zone of radius R (a crack, a pump, a booth, a chest); freezes under fire
			"loot", -- where the loot is grabbed
			"console", -- hack / uplink / alarm console
			"npc", -- a guard post (Gn), an alarm reinforcement point (Rn) or a camp commander (Cmdr)
			"arena", -- an event / king-of-the-hill area of radius R
			"vehicle", -- a vehicle spawn box (Box) — reserved, not a job yet
			"deliver_boat", -- a boat delivery point — reserved
			"sabotage", -- plant a charge (radius R)
			"search", -- a cache to search (radius R)
		},
		Prompts = { "hold", "tap" },
		-- Role vocabulary (a stamped role outside it only warns): the names plus the numbered forms Gn, Rn, PumpN, CacheN
		Roles = { "Door", "Gate", "Vault", "Loot", "Console", "Chest", "Booth", "Alarm", "Pump", "Valve", "Truck", "Recorder", "Box", "Ring", "Arena", "BoatDrop", "Pad", "Pier", "Cmdr" },
		NumberedRoles = { "G", "R", "Pump", "Cache" },
		-- The checkpoint template (kit-local studs; the kit's front, local -Z, faces arriving traffic; booth on +X).
		-- Every Checkpoint kit gets these 6 anchors, "<POI>.<cluster Id>.<Role>" (a POI with one checkpoint names that
		-- cluster "CP"). Clear of the kit's collidables (WorldKits Checkpoint): booth x 15.5..19.5 z -0.2..4.2, far
		-- sandbag x -15.8..-13.4 z -4..4, near sandbag x 13.4..15.8 z -7.1..-2.1. R1 / R2 lie 90 up the road (Probe).
		CheckpointAnchors = {
			{ Role = "Booth", Kind = "hold", X = 17.5, Z = 9.5, Yaw = 0, R = 5, Prompt = "hold" }, -- "Take post", behind the booth
			{ Role = "Alarm", Kind = "console", X = 17.6, Z = -2.0, Yaw = 0, Prompt = "hold" }, -- on the booth front (1.8 clear)
			{ Role = "G1", Kind = "npc", X = -14.6, Z = 5.5, Yaw = 0 }, -- behind the far sandbag (1.5 clear)
			{ Role = "G2", Kind = "npc", X = 21.5, Z = 1.5, Yaw = 0 }, -- beside the booth (2.0 clear)
			{ Role = "R1", Kind = "npc", X = 18, Z = -90, Yaw = 180, Probe = true }, -- alarm reinforcements, running in
			{ Role = "R2", Kind = "npc", X = -18, Z = -90, Yaw = 180, Probe = true },
		} :: { AnchorTemplate },
	},
}

return WorldConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WorldDressConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE World v2 Phase 2 (W3) — WorldDressConfig: every tunable of the travel dressing BETWEEN the POIs
	(gap/world_v2_spec.md §4.1–§4.4 and §7.1; roadmap §2.4 WORLD-B builder 2). Read by Server/Modules/WorldDress:
	  * Keepout   — the shared keep-out zones (WorldDress.Zones / WorldDress.Blocked; WorldPOI asserts its clusters too)
	  * Rhythm    — road rhythm: a cluster every 140–180 studs along every visible road, sides alternating (§4.1)
	  * Junctions — one corner kit at each of the 6 visible junctions (§4.2)
	  * Shore     — canal inner-bank features every 320 studs + the Bay's north shore (§4.3)
	  * Scatter   — natural Poisson scatter until the largest empty circle is <= 340 (§4.4)
	  * Quality   — Quality "Low": POIs at 60 %, rhythm every other, no scatter (roadmap §2.4)
	  * Budgets   — part caps per section (spec §7.1); the verifier fails above them
	Units: world studs, north = -Z. Desert floor top = 0.5. Every number is a start value to tune on the owner's phone.
	Placement is seeded (WorldKits.Rng(Seed + salt), a pure-Luau PRNG), so the headless sim and the live server build
	the same layout. Rules are enforced at build time (WorldDress.Blocked + WorldHygiene), never assumed from the sim.
]]

export type Point = { X: number, Z: number }
export type ShoreLine = { Side: string, AlongX: boolean, Across: number, From: number, To: number }
export type KindRow = { Kind: string, Parts: number, Natural: boolean }
export type RockRow = { Radius: number, Outer: number, MaxPrims: number, Count: number? }

local WorldDressConfig = {
	Enabled = true,
	Seed = 702, -- spec §4 (model seed); each section adds its own salt

	-- Folder names under WarEmpireSetup.WorldDressing (POIs build WorldDressing.POI_<Id>; Dockside stays as-is)
	Folders = {
		Rhythm = "Rhythm",
		Junctions = "Junctions",
		Shore = "Shore",
		Scatter = "Scatter",
		POIPrefix = "POI_",
	},

	-- ── Shared keep-outs (WorldDress.Zones / WorldDress.Blocked) ───────────────────────────────────────────────────
	-- A cluster disc (centre x, z; radius r) is free only when its EDGE clears every zone below by the margin.
	Keepout = {
		RoadClear = 13, -- disc edge to any road centre line (H2 corridor 12 + 1); callers may pass a smaller RoadR
		WaterMargin = 6, -- every water rect (public, dock channels, plot water) + the bank
		PlotPadMargin = 40, -- plot pads (square, 320)
		CaptureScale = 1.414, -- TerritoryCapture uses the marker half-diagonal (= WorldConfig.Hygiene)
		CaptureExtra = 25,
		CaptureSkip = { "CoastalOilAlpha", "CoastalOilBravo" }, -- rigs stand in water: the water rule covers them
		PadMargin = 16, -- land garage pads (WorldConfig.Spawns.Garage, 20 x 20)
		ApronMargin = 0, -- front-gate aprons (WorldConfig.Hygiene.GateApron, plot-local)
		POIMargin = 30, -- every POI footprint except the one being built (disabled POIs stay reserved)
		EventClear = 20, -- event anchors: supply crates land here (WorldConfig.Spawns.Event)
		NPCClear = 10, -- NPC anchors (WorldConfig.Spawns.NPC)
		BankExtra = 14, -- Empire Bank: BankRaidConfig.GuardRingRadius (18) + 14 = 32 round BankRaidConfig.Position
		-- dry land inside the ring canal (x ±1760, z -1760 .. 1490), inset 20 (30 at the sea)
		Ring = { X0 = -1740, X1 = 1740, Z0 = -1740, Z1 = 1460 },
	},

	-- ── Road rhythm (spec §4.1: 74 clusters, 240 parts incl. the 6 junction kits) ──────────────────────────────────
	Rhythm = {
		Enabled = true,
		Salt = 1,
		Spacing = { 140, 180 }, -- the next spot is rng(140, 180) studs further along the road
		Offset = { 16, 34 }, -- road centre line to the cluster centre; sides alternate after each accepted cluster
		EndInset = 60, -- start / stop this far from each road end (WaterConfig.RoadEnds)
		JunctionClear = 70, -- no rhythm cluster within 70 of a junction centre (the junction kit is there)
		Radius = 8, -- disc radius for the zone tests; the road test uses RoadR = Radius with RoadClear = Offset[1] - Radius
		CollidableRoadGap = 13, -- every collidable part's AABB stays > 12 from every centre line (H2)
		VisibleRoadGap = 9, -- every visible part taller than 0.3 stays > 8 from every centre line (H2 lane)
		-- kinds rotate in this order over the accepted spots (rock_outcrop = Terrain, 0 parts)
		Kinds = { "rock_outcrop", "wreck_or_nest", "flora_group", "rock_outcrop", "sign_or_marker", "flora_group" },
		KindParts = { rock_outcrop = 0, wreck_or_nest = 6, flora_group = 5, sign_or_marker = 2 },
		Target = 74, -- model count incl. the 6 junction kits (the verifier allows ±15 %)
		MaxParts = 224, -- rhythm clusters; + Junctions 36 = 260 (spec §7.1)
		LowEvery = 2, -- Quality Low keeps half the rhythm clusters of each road (LowPattern); junction kits stay
		-- Low keeps accepted cluster i of a road when LowPattern[(i - 1) % 4 + 1]: the 1st, 4th, 5th, 8th, 9th, … Half of
		-- them, and still alternating sides (sides flip on every accepted cluster, so the 1st, 3rd, 5th … would all sit on
		-- the same side of the road). Low is always a subset of Full (the same spots, the same kits).
		LowPattern = { true, false, false, true },
		-- wreck_or_nest rotates over these recipes (6 parts each; contracts §2.3); sign_or_marker over the variants
		WreckRecipes = { "car", "truck", "nest" },
		MarkerVariants = { "km", "hazard" },
	},

	-- ── Junction kits (spec §4.2: 6 visible junctions, 6 parts each) ───────────────────────────────────────────────
	Junctions = {
		Enabled = true,
		Salt = 2,
		-- (0, 0) is the Town; (0, ±800) are under plots 3 / 4
		Points = {
			{ X = -800, Z = -800 },
			{ X = 800, Z = -800 },
			{ X = -800, Z = 0 },
			{ X = 800, Z = 0 },
			{ X = -800, Z = 800 },
			{ X = 800, Z = 800 },
		} :: { Point },
		Corner = 26, -- kit centre at (+26, +26) from the junction (then (-,+), (+,-), (-,-) when blocked): the corner, never the lane
		Radius = 9,
		Kits = { "DirSign", "Jersey", "Jersey", "SandbagArc" }, -- 2 + 1 + 1 + 2 = 6 parts, + 1 Terrain rock (0 parts)
		Parts = 6,
		-- The world SurfaceGui budget (WorldConfig.Budgets.SurfaceGuis = 12) is 10 garage signs + 1 Town board: the junction
		-- posts are painted arrow boards with NO text in this step (the lead re-plans signs before the other 17 POIs)
		SignText = false,
	},

	-- ── Canal and shore features (spec §4.3: 36 features, 105 parts) ──────────────────────────────────────────────
	Shore = {
		Enabled = true,
		Salt = 3,
		Spacing = 320, -- one feature every 320 studs along each line
		Inset = 28, -- feature centre this far in from the water edge (canal x / z ±1760; the lines below)
		Radius = 8,
		Lines = {
			{ Side = "N", AlongX = true, Across = -1732, From = -1700, To = 1700 },
			{ Side = "W", AlongX = false, Across = -1732, From = -1700, To = 1420 },
			{ Side = "E", AlongX = false, Across = 1732, From = -1700, To = 1420 },
		} :: { ShoreLine },
		-- ring landings (future POI jetties): no bank feature within LandingClear of these
		Landings = { { X = 0, Z = -1769 }, { X = 1769, Z = 0 }, { X = -1769, Z = 0 } } :: { Point },
		LandingClear = 60,
		Kinds = {
			{ Kind = "revetment", Parts = 3, Natural = false },
			{ Kind = "reeds_rocks", Parts = 2, Natural = true },
			{ Kind = "jetty_stub", Parts = 3, Natural = false },
			{ Kind = "barge_wreck", Parts = 5, Natural = false },
			{ Kind = "reeds_rocks", Parts = 2, Natural = true },
		} :: { KindRow },
		-- the Bay's north shore (sea edge z 1490): driftwood, a beached hull, dune grass
		Bay = {
			Z = 1446, -- 1490 - bank 24 - 20
			From = -1700,
			To = 1700,
			Spacing = 300,
			Kinds = {
				{ Kind = "driftwood_rocks", Parts = 2, Natural = true },
				{ Kind = "beached_boat", Parts = 4, Natural = false },
				{ Kind = "dune_grass", Parts = 2, Natural = true },
			} :: { KindRow },
			EdgeZ = 1490, -- the sea's north edge (WaterConfig Sea_* Z0): a beached hull reaches InWaterMax past it
		},
		InWaterMax = 10, -- a jetty stub / barge / hull may reach this far into the water (cluster WE_AllowInWater)
		-- these land kinds step from the bank line to the water's edge (their nearest part LandEdgeGap from the water;
		-- WorldHygiene H3 needs > 6): a revetment, reeds or driftwood 28 studs inland would read as litter on the sand
		ToWater = { revetment = true, reeds_rocks = true, driftwood_rocks = true } :: { [string]: boolean },
		LandEdgeGap = 7.5,
		-- ... and only into these water rects (never a dock channel, lagoon, harbour, slip or sea gate)
		InWaterRects = { "Ring_", "Sea_" },
		MaxParts = 120,
	},

	-- ── Natural scatter (spec §4.4: 49 clusters, 104 parts) ────────────────────────────────────────────────────────
	Scatter = {
		Enabled = true,
		Salt = 4,
		EmptyRadius = 155, -- fill only circles whose centre is more than this from anything (spec: 160; tuned with the target)
		MinSpacing = 120, -- to every other cluster centre (rhythm, shore, POI clusters, other scatter)
		RoadClear = 40, -- cluster centre to any road centre line
		Radius = 10,
		Grid = 24, -- emptiness grid cell (studs)
		-- stop when the largest empty circle (diameter, this grid) is <= 310. world_v2_model.py scatter() runs with
		-- target_diam = 320 (49 clusters; its final V10 measure at cell 20 reads 340). Our keep-outs and POI discs leave
		-- slightly different gaps: 320 stops at 40 clusters, 310 gives 46 (104 parts, far100 12 %, largest 322 at cell 20)
		TargetLargestEmpty = 310,
		MaxIterations = 80,
		MaxClusters = 56, -- model 49 +15 %; FaceMapCentre = false (rollback: no dock channels, more dry land) reaches it
		MaxParts = 120,
		-- kinds rotate (rock_cluster / boulder_field = Terrain, 0 parts)
		Kinds = {
			{ Kind = "rock_cluster", Parts = 0, Natural = true },
			{ Kind = "flora_group", Parts = 5, Natural = true },
			{ Kind = "dead_tree_stumps", Parts = 3, Natural = true },
			{ Kind = "flora_group", Parts = 5, Natural = true },
			{ Kind = "boulder_field", Parts = 0, Natural = true },
			{ Kind = "rock_cluster", Parts = 0, Natural = true },
		} :: { KindRow },
		MinElements = 3, -- H1: a natural cluster stands alone only as >= 3 elements of >= 2 sizes (terrain rocks count)
		-- search (world_v2_model.py scatter()): each round takes up to CirclesPerRound of the largest empty circles
		-- (greedy, the next one at least Suppress x r from the last) whose radius exceeds max(EmptyRadius, Target / 2); try
		-- the circle centre, then Tries - 1 spots jittered by rng(-Jitter, Jitter) x (1 + try / 10). A circle with no legal
		-- spot is not tried again (cells within FailClear x r of its centre leave the candidate list).
		CirclesPerRound = 8,
		Suppress = 1.6,
		Tries = 40,
		Jitter = 40,
		FailClear = 0.5,
		FieldMax = 480, -- distances in the emptiness field are exact up to this (studs); the ring is <= 3,520 across
		-- the dry land the emptiness metric measures (contracts §3.5: inside the ring canal, x ±1760, z -1760 .. 1490)
		Land = { X0 = -1760, X1 = 1760, Z0 = -1760, Z1 = 1490 },
	},

	-- ── Quality ────────────────────────────────────────────────────────────────────────────────────────────────────
	Quality = {
		-- MapSetup: live = "Full"; Studio = DevConfig.WorldDressQuality (default "Low")
		Low = {
			POIShare = 0.6, -- each POI builds its Tier-1 clusters only: parts <= 60 % of its Full build
			RhythmEvery = 2, -- = Rhythm.LowEvery
			Scatter = false,
			ShoreEvery = 1, -- the spec gives no Low rule for the shore: all features stay (ASSUMPTIONS, reversible)
		},
	},

	-- ── Terrain rocks (0 parts; WorldKits.Rock fills them) ────────────────────────────────────────────────────────
	Terrain = {
		MaxPrims = 400, -- spec §7.1: <= 400 rock prims on top of the edge's 2,500
		-- WorldKits.Rock groups as the travel dressing uses them: Radius = opts.Radius passed to Rock (every prim stays
		-- inside it), Outer = the keep-out radius tested with WorldDress.Blocked before the fill (terrain collides: rocks
		-- stay >= 13 off every road line, out of the water + 6 and every zone), MaxPrims = the most prims one call fills
		-- (the terrain budget reserves this much per accepted rock, Full or Low alike), Count = fixed prim count
		Rocks = {
			outcrop = { Radius = 12, Outer = 12, MaxPrims = 4 }, -- road rhythm / scatter rock outcrop (2–4 prims)
			boulders = { Radius = 7, Outer = 7, MaxPrims = 6 }, -- junction corner (3–6 balls)
			boulder_field = { Radius = 14, Outer = 14, MaxPrims = 6, Count = 6 }, -- scatter
			shore = { Radius = 5, Outer = 5, MaxPrims = 3, Count = 3 }, -- reeds / driftwood + rocks on the bank
		} :: { [string]: RockRow },
	},

	-- ── Budgets (spec §7.1; parts outside the bases <= 2,900 Full / 1,900 Low overall) ───────────────────────────────
	Budgets = {
		Rhythm = 224,
		Junctions = 36,
		Shore = 120,
		Scatter = 120,
		RhythmLow = 150, -- every other rhythm cluster + the 6 junction kits
		TerrainPrims = 400,
		BuildSeconds = 1.0, -- WorldDress.Build CPU time in the headless sim (logged)
		-- task.wait() after this many clusters (0 = never). 0 because the whole build is a fraction of a second of server
		-- CPU inside MapSetup's deferred dressing thread (the old coordinate-list dressing never yielded either), and the
		-- headless sim's driver thread cannot yield. Set 25 on live if the owner ever sees a start-up hitch.
		YieldEvery = 0,
	},
}

return WorldDressConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">WorldLabelConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	World label rules (CLAUDE.md "World labels"; HUD v70 spec §5).

	Two users:
	  * Modules/WorldLabelPolicy (server) enforces the caps on every BillboardGui in Workspace as it appears.
	    v67 only touched labels inside plots; v70 also caps labels outside them (territories, POIs, NPCs, vehicles,
	    the bank, supply drops). It measures from the label's Adornee, else its first ancestor with a position.
	  * Shared/Util/WorldLabel builds labels that already follow the rules (stud-scaled, 14-20 px text, no card).
	    Its look (box studs, font, default range) is HudConfig.WorldLabels.Default.
]]

local WorldLabelConfig = {
	Enabled = true,
	-- Studs. Labels inside a plot further away than this are hidden (default BillboardGui distance is infinite).
	-- v70: 40 (CLAUDE.md: MaxDistance <= 40; was 45).
	MaxDistance = 40,
	-- v70: labels outside the plots get the same treatment (AlwaysOnTop off, range capped). false = v67 behaviour.
	ApplyOutsidePlots = true,
	OutsideMaxDistance = 40,
	-- BillboardGui names allowed to draw over walls/buildings. Everything else gets AlwaysOnTop = false.
	AllowAlwaysOnTop = {} :: { [string]: boolean },
	-- WE_LabelRole values (WorldLabel.SetRole) allowed AlwaysOnTop: the one active objective marker and a contested
	-- flag. Keeping it to ONE objective at a time is the caller's job.
	AlwaysOnTopRoles = { objective = true, contested = true } :: { [string]: boolean },
	-- Studs beyond the plot pad edge still counted as "in the base" (gate, outer sandbags, parked vehicles).
	PlotMargin = 12,

	-- Shared/Util/WorldLabel ------------------------------------------------------------------------------------
	RoleAttribute = "WE_LabelRole", -- "objective" | "contested" (unset = normal label)
	OwnerAttribute = "WE_LabelOwner", -- UserId: only that player sees the label (client filter; 0/unset = everyone)
	OwnerTag = "WE_OwnerLabel", -- CollectionService tag on owner-only labels (what the client filter watches)
	-- F1/F4/F9 (owner's 11 features): every BillboardGui at a base (premium pads, the gold pump pad, the producer
	-- label, the NEXT tag, business pops) carries this CollectionService tag (WorldLabel.Create opts.BaseLabel).
	BaseLabelTag = "WE_BaseLabel",
	-- The client LabelGovernor makes "at most 3 labels on screen at a base" true: Hz times a second it keeps the
	-- MaxOnScreen tagged labels nearest the camera (within their own MaxDistance) enabled and disables the rest.
	-- It never touches a label whose RoleAttribute is "objective". On since lane Z (reversible).
	BaseLabelGovernor = {
		Enabled = true,
		MaxOnScreen = 3,
		Hz = 4,
	},
	-- Billboard text, real px (world GUIs are not under the HUD UIScale). Fixed TextSize, never TextScaled.
	TextSize = 16,
	SubTextSize = 14,
	MinTextSize = 14,
	MaxTextSize = 20,
	LinePad = 2, -- px added to each line's height
	StudsAbove = 1.5, -- default gap above a part's top face
	-- Painted signs (WorldLabel.Surface). SurfaceGui budget: MaxDistance <= 80.
	SurfaceMaxDistance = 80,
	SurfaceDefaultMaxDistance = 40,
	SurfacePixelsPerStud = 40,
	SurfaceMaxTextSize = 100, -- Roblox's TextSize ceiling
}

return WorldLabelConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">Constants</string>
          <string name="Source"><![CDATA[--!strict
--[[
	WAR EMPIRE — Shared constants (non-tunable identifiers).
	Tunable numbers live in Configs/*.
]]

local Constants = {}

Constants.GAME_NAME = "WAR EMPIRE"
Constants.TAGLINE = "BUILD. CONQUER. DOMINATE."

-- CollectionService tags (StudioSetup + runtime)
Constants.Tags = {
	BasePlot = "WE_BasePlot",
	UpgradeSlot = "WE_UpgradeSlot",
	Territory = "WE_Territory",
	CaptureZone = "WE_CaptureZone",
	VehicleSpawn = "WE_VehicleSpawn",
	NavalSpawn = "WE_NavalSpawn",
	Water = "WE_Water", -- v69: water surface parts (top face = water level); boats may only move over these
	NPCSpawn = "WE_NPCSpawn",
	EventSpawn = "WE_EventSpawn",
	SupplyDrop = "WE_SupplyDrop",
	BankVault = "WE_BankVault",
	NPC = "WE_NPC",
	Vehicle = "WE_Vehicle",
	TutorialMarker = "WE_TutorialMarker",
	MoneyCollector = "WE_MoneyCollector",
	GateBarrier = "WE_GateBarrier",
	PlotOilPump = "WE_PlotOilPump",
	PremiumPad = "WE_PremiumPad",
}

-- Remote folder / names (created by RemoteSetup)
Constants.RemotesFolderName = "WE_Remotes" -- v60: server-only; never Rojo empty Remotes
Constants.RemoteNames = {
	-- Server → Client (push)
	PlayerStateUpdate = "PlayerStateUpdate",
	BaseStateUpdate = "BaseStateUpdate",
	Notification = "Notification",
	EconomyUpdate = "EconomyUpdate",
	XPUpdate = "XPUpdate",
	CombatStateUpdate = "CombatStateUpdate",
	CombatHitFeedback = "CombatHitFeedback",
	VehicleStateUpdate = "VehicleStateUpdate",
	TerritoryStateUpdate = "TerritoryStateUpdate",
	MissionStateUpdate = "MissionStateUpdate",
	-- Client → Server (request/action only — NEVER GiveCash/GiveXP/GiveWeapon)
	RequestPurchaseUpgrade = "RequestPurchaseUpgrade",
	PurchaseResult = "PurchaseResult", -- v62: server always replies Ok/Err after buy
	RequestClaimDailyReward = "RequestClaimDailyReward",
	RequestSpawnVehicle = "RequestSpawnVehicle",
	RequestPurchaseVehicle = "RequestPurchaseVehicle",
	RequestDespawnVehicle = "RequestDespawnVehicle",
	RequestEquipWeapon = "RequestEquipWeapon",
	RequestPurchaseWeapon = "RequestPurchaseWeapon",
	RequestFire = "RequestFire",
	RequestReload = "RequestReload",
	RequestStartMission = "RequestStartMission",
	RequestClaimMission = "RequestClaimMission",
	RequestCaptureTerritory = "RequestCaptureTerritory",
	RequestAdminCommand = "RequestAdminCommand",
	RequestPurchaseDevProduct = "RequestPurchaseDevProduct",
	RequestPurchaseGamePass = "RequestPurchaseGamePass",
	RequestSkipTutorial = "RequestSkipTutorial",
	TutorialStateUpdate = "TutorialStateUpdate",
	-- Prestige / Clan / Battle Pass
	RequestPrestige = "RequestPrestige",
	PrestigeStateUpdate = "PrestigeStateUpdate",
	RequestCreateClan = "RequestCreateClan",
	RequestJoinClan = "RequestJoinClan",
	RequestLeaveClan = "RequestLeaveClan",
	ClanStateUpdate = "ClanStateUpdate",
	RequestClaimBattlePassReward = "RequestClaimBattlePassReward",
	BattlePassStateUpdate = "BattlePassStateUpdate",
	-- Soldiers / Season / Clan War
	RequestRecruitSoldiers = "RequestRecruitSoldiers",
	RequestDismissSoldiers = "RequestDismissSoldiers",
	SoldierStateUpdate = "SoldierStateUpdate",
	RequestSquadOrder = "RequestSquadOrder",
	SquadOrderStateUpdate = "SquadOrderStateUpdate",
	SeasonStateUpdate = "SeasonStateUpdate",
	RequestDeclareClanWar = "RequestDeclareClanWar",
	ClanWarStateUpdate = "ClanWarStateUpdate",
	RequestRedeemCode = "RequestRedeemCode",
	CodeStateUpdate = "CodeStateUpdate",
	NationColorUpdate = "NationColorUpdate",
	-- Nations (cosmetic country flag): client -> server Types.NationRequestPayload { Action = "pick" | "later", Id?,
	-- Source }. Replies go to that player only on NationColorUpdate. The server validates everything (rate limit,
	-- NationConfig.Get) and grants nothing but the cosmetic choice.
	RequestSetNation = "RequestSetNation",
	RequestClaimSpinner = "RequestClaimSpinner",
	SpinnerStateUpdate = "SpinnerStateUpdate",
	BankRaidStateUpdate = "BankRaidStateUpdate",
	-- Studio-only BUY smoke → client Output (Play Solo)
	StudioSmokeLog = "StudioSmokeLog",
	DeathShopOffer = "DeathShopOffer",
	StarterBundleOffer = "StarterBundleOffer",
	AutoCollectOffer = "AutoCollectOffer",
	DoubleCashOffer = "DoubleCashOffer",
	VIPOffer = "VIPOffer",
	SpeedBoostOffer = "SpeedBoostOffer",
	CashMegaOffer = "CashMegaOffer",
	AtmRaidStateUpdate = "AtmRaidStateUpdate",
	PromptPremiumPad = "PromptPremiumPad",
	-- v69: Research Lab upgrades, Command Center missile strikes, vehicle drive input
	RequestResearch = "RequestResearch",
	ResearchStateUpdate = "ResearchStateUpdate",
	RequestMissileStrike = "RequestMissileStrike",
	MissileStrikeStateUpdate = "MissileStrikeStateUpdate",
	MissileStrikeFx = "MissileStrikeFx",
	VehicleDriveInput = "VehicleDriveInput",
	-- v71 money (M2): created now, used by later workflows (nothing fires or listens to them yet).
	-- Nuke (M5; own Fx remote, J17)
	RequestNukeLaunch = "RequestNukeLaunch",
	RequestNukeState = "RequestNukeState",
	NukeStateUpdate = "NukeStateUpdate",
	NukeFx = "NukeFx",
	-- Premium / vehicle weapons (M6). VehicleWeaponFx is an UnreliableRemoteEvent (RemoteSetup UNRELIABLE list).
	RequestVehicleFire = "RequestVehicleFire",
	VehicleWeaponFx = "VehicleWeaponFx",
	RequestVehicleCamo = "RequestVehicleCamo",
	RequestPremiumTrial = "RequestPremiumTrial",
	-- Rebirth expansion (M7). Not "SupplyDrop": that name belongs to SupplyDropService.
	RebirthStateUpdate = "RebirthStateUpdate",
	RequestRebirthState = "RequestRebirthState",
	ArtilleryFx = "ArtilleryFx",
	DroneCrateFx = "DroneCrateFx",
	-- Offer Director (M3) and M8 (purchase ticker, shortfall chip)
	OfferShow = "OfferShow",
	OfferResult = "OfferResult",
	PurchaseAnnounce = "PurchaseAnnounce",
	ShortfallChip = "ShortfallChip",
	-- W2 Combat Core: WeaponFx is an UnreliableRemoteEvent (RemoteSetup UNRELIABLE list); RequestSetDrawn a RemoteEvent
	WeaponFx = "WeaponFx",
	RequestSetDrawn = "RequestSetDrawn",
	GetPlayerState = "GetPlayerState",
	-- W3 step 2 Phase B, Jobs ("Ops"; OpsConfig.Enabled gates every sender). Server -> client only: there is NO Ops
	-- client -> server remote (every job action is a server ProximityPrompt). Payload types: OpsConfig exports.
	OpsState = "OpsState", -- RemoteEvent, per player: OpsStatePayload (Full on join + every 60 s, deltas <= 2 Hz)
	OpsProgress = "OpsProgress", -- RemoteEvent, per player: OpsProgressPayload (4 Hz, only inside a job zone)
	OpsPing = "OpsPing", -- UnreliableRemoteEvent (RemoteSetup UNRELIABLE list): OpsPingPayload, every 10 s per carrier
}

Constants.DataStoreName = "WarEmpire_PlayerData_v2" -- v55: intentional bump; fresh CreateDefault + StartingCash (kills stuck $0 v1 saves)
Constants.SessionStoreName = "WarEmpire_SessionLock_v1"
Constants.CURRENT_DATA_VERSION = 8

Constants.AutosaveIntervalSeconds = 60
-- Session lock: refresh often; steal if age >= TTL (rejoin after crash ~30–45s)
Constants.SessionLockTtlSeconds = 45
Constants.SessionLockRefreshSeconds = 15
Constants.DataStoreRetries = 3
Constants.DataStoreRetryDelay = 1.5

Constants.MaxBasePlots = 6
Constants.PassiveIncomeTickSeconds = 5

Constants.Colors = {
	Background = Color3.fromRGB(18, 20, 24),
	Panel = Color3.fromRGB(28, 32, 38),
	Accent = Color3.fromRGB(70, 130, 80),
	Cash = Color3.fromRGB(130, 255, 170), -- v36 high-contrast cash (not yellow)
	Gold = Color3.fromRGB(230, 190, 60),
	XP = Color3.fromRGB(90, 160, 220),
	Danger = Color3.fromRGB(200, 70, 70),
	Health = Color3.fromRGB(200, 70, 70),
	Ammo = Color3.fromRGB(220, 200, 120),
	Text = Color3.fromRGB(235, 238, 242),
	Muted = Color3.fromRGB(150, 158, 170),
	-- Visual kits v2 UI
	Gunmetal = Color3.fromRGB(42, 48, 55),
	GunmetalLight = Color3.fromRGB(58, 66, 74),
	CategoryGround = Color3.fromRGB(90, 130, 80),
	CategoryAir = Color3.fromRGB(90, 160, 220),
	CategoryNaval = Color3.fromRGB(70, 180, 200),
	-- High-contrast (never pale yellow on sand/green)
	TextOnDark = Color3.fromRGB(245, 248, 252),
	TextDark = Color3.fromRGB(18, 20, 24),
	PlateDark = Color3.fromRGB(12, 14, 18),
	GoldBright = Color3.fromRGB(255, 210, 90),
	NeonAccent = Color3.fromRGB(80, 255, 160),
	Olive = Color3.fromRGB(72, 88, 58),
	Sand = Color3.fromRGB(196, 170, 120),
}

return Constants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Client/server helper to fetch remotes created by RemoteSetup.
	Does not create remotes on the client.

	v60/v61: HUD/BUY must NEVER block on unbounded WaitForChild.
	Use BindEvent / TryGet* / FireServer for display + BUY paths; GetEvent still waits (non-HUD).
	Folder is WE_Remotes (server-created) — Rojo no longer ships empty Remotes.
	v61: FireServer polls ≤3s then returns false — never toast "Buying…" without a live remote.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Constants = require(script.Parent.Constants)

local Remotes = {}

local function getFolderImmediate(): Folder?
	local folder = ReplicatedStorage:FindFirstChild(Constants.RemotesFolderName)
	if folder and folder:IsA("Folder") then
		return folder :: Folder
	end
	return nil
end

local function getFolder(): Folder
	local folder = getFolderImmediate()
	if folder then
		return folder
	end
	folder = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName, 120) :: Folder?
	assert(folder and folder:IsA("Folder"), "WE_Remotes missing — server EarlyRemotes/RemoteSetup must run first")
	return folder :: Folder
end

local function waitForRemote(name: string, className: string): Instance
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA(className) then
		return existing
	end
	local waited = 0
	while waited < 180 do
		local remote = folder:WaitForChild(name, 5)
		if remote and remote:IsA(className) then
			return remote
		end
		waited += 5
		warn(string.format("[Remotes] Waiting for %s %s… (%ds)", className, name, waited))
	end
	local remote = folder:WaitForChild(name, 30)
	if not (remote and remote:IsA(className)) then
		error(className .. " missing after wait: " .. name .. " (server Bootstrap may have aborted — check Output)", 0)
	end
	return remote
end

function Remotes.GetEvent(name: string): RemoteEvent
	return waitForRemote(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.GetFunction(name: string): RemoteFunction
	return waitForRemote(name, "RemoteFunction") :: RemoteFunction
end

--[[ Non-blocking: nil if remote not ready yet. ]]
function Remotes.TryGetEvent(name: string): RemoteEvent?
	local folder = getFolderImmediate()
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		return remote :: RemoteEvent
	end
	return nil
end

function Remotes.TryGetFunction(name: string): RemoteFunction?
	local folder = getFolderImmediate()
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("RemoteFunction") then
		return remote :: RemoteFunction
	end
	return nil
end

--[[ v71 money (M2): UnreliableRemoteEvents (RemoteSetup UNRELIABLE list, e.g. VehicleWeaponFx). They are not
	RemoteEvents, so GetEvent / TryGetEvent never return them. Same bounded wait as GetEvent. ]]
function Remotes.GetUnreliableEvent(name: string): UnreliableRemoteEvent
	return waitForRemote(name, "UnreliableRemoteEvent") :: UnreliableRemoteEvent
end

--[[ Non-blocking: nil if the unreliable remote is not ready yet. ]]
function Remotes.TryGetUnreliableEvent(name: string): UnreliableRemoteEvent?
	local folder = getFolderImmediate()
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("UnreliableRemoteEvent") then
		return remote :: UnreliableRemoteEvent
	end
	return nil
end

--[[
	Client→server fire without unbounded WaitForChild.
	Polls up to timeoutSec (default 3) for WE_Remotes + event.
	Returns true only if FireServer actually ran on a live RemoteEvent.
]]
function Remotes.FireServer(name: string, ...: any): boolean
	local remote = Remotes.TryGetEvent(name)
	if remote then
		remote:FireServer(...)
		return true
	end
	local timeoutSec = 3
	local deadline = os.clock() + timeoutSec
	while os.clock() < deadline do
		task.wait(0.05)
		remote = Remotes.TryGetEvent(name)
		if remote then
			remote:FireServer(...)
			return true
		end
	end
	warn("[Remotes] FireServer: remote not ready after", timeoutSec, "s:", name)
	return false
end

--[[
	Connect OnClientEvent without ever yielding the caller.
	If remote appears later, connects in a background spawn.
]]
function Remotes.BindEvent(name: string, handler: (...any) -> ()): ()
	local remote = Remotes.TryGetEvent(name)
	if remote then
		remote.OnClientEvent:Connect(handler)
		return
	end
	task.spawn(function()
		local folder = getFolderImmediate()
		if not folder then
			local waited = ReplicatedStorage:WaitForChild(Constants.RemotesFolderName, 120)
			if not (waited and waited:IsA("Folder")) then
				warn("[Remotes] BindEvent: WE_Remotes never appeared for", name)
				return
			end
			folder = waited :: Folder
		end
		local ev = folder:FindFirstChild(name)
		if not ev then
			ev = folder:WaitForChild(name, 120)
		end
		if ev and ev:IsA("RemoteEvent") then
			(ev :: RemoteEvent).OnClientEvent:Connect(handler)
		else
			warn("[Remotes] BindEvent: remote never appeared:", name)
		end
	end)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Shared type aliases for WAR EMPIRE.
]]

export type Currency = "Cash" | "Gold"

export type StructureId =
	"CommandCenter"
	| "Barracks"
	| "VehicleDepot"
	| "WeaponsFacility"
	| "Helipad"
	| "Airfield"
	| "DefensiveWalls"
	| "Watchtowers"
	| "Radar"
	| "ResearchLab"
	| "MissileDefense"
	| "PowerStation"
	| "Warehouse"
	| "SpecialForcesFacility"

export type BaseUpgrades = { [string]: number }

export type PlayerSettings = {
	MusicVolume: number,
	SFXVolume: number,
	ShowDamageNumbers: boolean,
	AutoSprint: boolean,
}

export type PlayerStats = {
	TotalCashEarned: number,
	TotalGoldEarned: number,
	UpgradesPurchased: number,
	VehiclesSpawned: number,
	MissionsCompleted: number,
	TerritoriesCaptured: number,
	Kills: number,
	Deaths: number,
	PlayTimeSeconds: number,
}

export type DailyLogin = {
	LastClaimDay: number, -- YYYYMMDD or 0
	Streak: number,
	LastClaimUnix: number,
}

export type DailyMissionProgress = {
	DayKey: number, -- YYYYMMDD UTC
	Progress: { [string]: number },
	Claimed: { [string]: boolean },
	ActiveTimed: { [string]: number }, -- missionId -> endsAt unix
}

export type BattlePassProgress = {
	SeasonId: string,
	XP: number,
	Level: number,
	Premium: boolean,
	ClaimedFree: { [string]: boolean },
	ClaimedPremium: { [string]: boolean },
}

-- v71 money (M2): optional profile blocks (ProfileSchema default-fill + sanitise; no DataVersion bump).
-- Nothing reads them yet; the nuke / premium vehicle / rebirth / offer workflows will.
export type NukeInFlight = {
	Kind: string, -- "Nuke" | "TacticalNuke"
	LaunchId: string,
	At: number, -- os.time() at launch
}

export type NukeStats = {
	Bought: number,
	Launched: number,
	PlayerKills: number,
	NpcKills: number,
	BestKills: number,
}

export type SiloProgress = {
	ProgressSeconds: number, -- online seconds toward the next Tactical Nuke
}

export type RebirthProgress = {
	ZonesSeen: { [string]: boolean }, -- zoneId -> the unlock celebration played
	LastRebirthUnix: number,
}

export type OfferStats = {
	Shown: number,
	LastShownUnix: number,
	Clicked: number,
	Dismissed: number,
}

export type MonetizationStats = {
	FirstPurchaseUnix: number,
	LastPurchaseUnix: number,
	Purchases: number,
	RobuxSpent: number, -- analytics / segmentation only; never shown to players
}

export type PlayerProfile = {
	DataVersion: number,
	Cash: number,
	PendingCash: number,
	Gold: number,
	Level: number,
	XP: number,
	Prestige: number,
	RebirthUnlocks: { [string]: boolean },
	Soldiers: number,
	NationColorId: string?,
	RedeemedCodes: { [string]: boolean },
	LastSpinnerClaimUnix: number,
	Vehicles: { [string]: boolean },
	Weapons: { [string]: boolean },
	EquippedWeapon: string?,
	Territories: { [string]: boolean },
	BaseUpgrades: BaseUpgrades,
	BasePlotId: number?,
	TutorialStep: number,
	TutorialComplete: boolean,
	DailyLogin: DailyLogin,
	DailyMissions: DailyMissionProgress,
	Settings: PlayerSettings,
	Stats: PlayerStats,
	Achievements: { [string]: boolean },
	BattlePass: BattlePassProgress,
	ClanId: string?,
	FirstJoinUnix: number,
	LastJoinUnix: number,
	ProcessedReceipts: { [string]: boolean }?,
	Entitlements: { [string]: boolean }?,
	OutpostIncomeStacks: number?,
	StarterBundleOffered: boolean?,
	AutoCollectOffered: boolean?,
	DoubleCashOffered: boolean?,
	VIPOffered: boolean?,
	SpeedBoostOffered: boolean?,
	CashMegaOffered: boolean?,
	-- v71 money (M2)
	Nukes: number?, -- paid (Robux) nukes, granted only in ProcessReceipt
	TacticalNukes: number?, -- silo / gift / reward nukes
	NukeInFlight: NukeInFlight?,
	NukeGiftGranted: boolean?,
	NukeStats: NukeStats?,
	Silo: SiloProgress?,
	PremiumVehicleCamo: { [string]: string }?, -- vehicleId -> camo id
	PremiumTrials: { [string]: number }?, -- vehicleId -> os.time() of the last free test drive
	Rebirth: RebirthProgress?,
	Offers: { [string]: OfferStats }?, -- offer key -> cadence counters (Offer Director)
	Monetization: MonetizationStats?,
	AnnouncePurchases: boolean?, -- M8 purchase ticker opt-out (true = announce)
	VipSupplyAt: number?, -- M8 daily VIP supply: os.time() of the last claim
	-- Owner's 11 features (ProfileSchema default-fill + sanitise; no DataVersion bump)
	KeepBaseRebirths: number?, -- F7 keep-base rebirth tokens (added only in ProcessReceipt; spent by PrestigeService)
	TutorialOrderVersion: number?, -- F6 order the saved TutorialStep index uses (missing = 1, the pre-F6 order)
	NoviceShieldDone: boolean?, -- F6 the novice shield has ended for good (never re-granted)
	StarterOutpostTaken: boolean?, -- F10 first Home Outpost capture done (later sessions own it on plot ready)
	-- Nations: the player's own cosmetic country (ProfileSchema ensureNationFields default-fills + sanitises on every
	-- load; no DataVersion bump). Written only by the server (NationColorService); NationColorId above is kept as
	-- the banner colour for "No flag" players.
	NationId: string?, -- nil = never picked (or cleared by the sanitiser); "NEUTRAL" = No flag; else a NationConfig id
	NationSetAt: number?, -- os.time() of the last accepted change (0 = never)
	NationFreeUntil: number?, -- end of the free re-pick window (0 = not started; set once, at the first real pick)
	NationFreeChanges: number?, -- changes made inside the free window (NationConfig.FreeRepickMax)
	NationPrompts: number?, -- LATER count; the join picker stops at NationConfig.MaxJoinPrompts (saved value <= 99)
}

-- Nations: RequestSetNation (client -> server). Display intent only: the server re-checks every field in this
-- order (nations spec R17): a table; Action is "pick" or "later"; Id (pick only) is a string of at most 8 bytes
-- that is NationConfig.NeutralId or exactly matches a NationConfig.Get entry; Source is "join", "flagpole" or
-- "settings". Anything else is dropped.
export type NationRequestPayload = {
	Action: string, -- "pick" | "later"
	Id: string?, -- pick: a NationConfig id or "NEUTRAL"
	Source: string, -- "join" | "flagpole" | "settings"
}

-- Nations: NationColorUpdate (server -> that player only). The legacy colour fields, then the nation state; a
-- reply to RequestSetNation also carries Result (and NextChangeAt on "cooldown"). Display only.
export type NationStatePayload = {
	NationColorId: string?, -- legacy 8-colour id (the banner colour while NationId is nil or "NEUTRAL")
	DisplayName: string?,
	Color: { R: number, G: number, B: number }?,
	NationId: string?, -- nil = never picked; "NEUTRAL"; or a NationConfig id
	NeedsPick: boolean?, -- open the picker in join mode (NationId nil and NationPrompts < MaxJoinPrompts)
	Suggested: string?, -- IP-based roster id for THIS player only, this session only: a badged tile, never selected
	FreeUntil: number?, -- os.time() end of the free re-pick window (0 = none)
	FreeChangesLeft: number?, -- changes left inside the free window
	NextChangeAt: number?, -- os.time() of the next allowed change (0 = now)
	Result: string?, -- reply to a pick: "ok" | "cooldown" | "loading" | "invalid" (a LATER gets no reply)
}

-- F7 / F11 (owner's 11 features): PrestigeStateUpdate payload. The v71 fields plus the keep-base and progress fields
-- (all display only; the server re-checks everything on RequestPrestige / ProcessReceipt).
export type RebirthSummaryPayload = { Keep: { string }, Reset: { string }, Gain: { string } }

export type PrestigeStatePayload = {
	Prestige: number,
	CanPrestige: boolean,
	MinLevel: number,
	MaxPrestige: number,
	CashBonusPerLevel: number,
	CashMultPercent: number,
	NextCashMultPercent: number,
	GoldBonusOnPrestige: number,
	CashFee: number,
	StartingCashAfter: number,
	BaseCompletionPercent: number,
	FeeSummary: string,
	RebirthUnlocks: { [string]: boolean },
	UnlockTrack: { any },
	-- F7 / F11
	KeepBaseTokens: number?, -- profile.KeepBaseRebirths
	KeepBaseLive: boolean?, -- DevProducts.RebirthKeepBase.Id ~= 0 and PrestigeConfig.KeepBase.Enabled
	KeepBasePrice: number?, -- RobuxPrice (50)
	ProgressPct: number?, -- PrestigeConfig.ProgressPct(Level, XP)
	Level: number?,
	XP: number?,
	Summary: { Cash: RebirthSummaryPayload, KeepBase: RebirthSummaryPayload }?, -- PrestigeConfig.RebirthSummary
}

export type EconomyUpdatePayload = {
	Cash: number,
	Gold: number,
	PendingCash: number?,
}

export type XPUpdatePayload = {
	Level: number,
	XP: number,
	XPToNext: number,
	HudGoal: string?,
	UnlockMessage: string?,
	LevelUp: boolean?, -- v37 celebration toast
}

export type BaseStatePayload = {
	PlotId: number?,
	Upgrades: BaseUpgrades,
	PassiveIncomePerTick: number,
}

export type PlayerStatePayload = {
	Cash: number,
	Gold: number,
	PendingCash: number?,
	Level: number,
	XP: number,
	XPToNext: number,
	Prestige: number,
	Soldiers: number,
	NationColorId: string?,
	TrainingIncomePerTick: number?,
	Base: BaseStatePayload,
	TutorialStep: number?,
	TutorialComplete: boolean,
	Vehicles: { [string]: boolean },
	Weapons: { [string]: boolean },
	EquippedWeapon: string?,
	DailyLogin: DailyLogin?,
	TerritoriesOwned: { [string]: boolean }?,
}

export type CombatStatePayload = {
	Health: number,
	MaxHealth: number,
	WeaponId: string?,
	Ammo: number,
	MagazineSize: number,
	Reloading: boolean,
	Alive: boolean,
}

export type CombatHitFeedbackPayload = {
	Kind: string, -- "Hit" | "Kill" | "Miss" | "Damaged" | "Death"
	Damage: number?,
	TargetName: string?,
	WeaponId: string?,
	IsHeadshot: boolean?,
	-- W2 additive (contracts §3.5; all optional, display only):
	Target: Instance?, -- Hit/Kill: victim character / NPC model / vehicle model (nil if streamed out)
	TargetKind: string?, -- "Player" | "NPC" | "Vehicle" | "Gate"
	Pos: Vector3?, -- Hit/Kill: world hit point (damage-number anchor)
	From: Vector3?, -- Damaged: attacker position (direction cue)
	Assist: boolean?, -- Hit/Kill: the server assist chose this target
	Splash: boolean?, -- aggregated area damage
}

export type VehicleStatePayload = {
	Owned: { [string]: boolean },
	ActiveVehicleId: string?,
	CooldownRemaining: number,
}

export type TerritoryEntryPayload = {
	Id: string,
	DisplayName: string,
	OwnerType: string,
	OwnerUserId: number,
	ClanId: string?,
	Progress: number, -- 0..1 capture progress toward CapturingUserId
	CapturingUserId: number,
	ProtectedUntil: number, -- unix
	BonusType: string,
	BonusValue: number,
	Contested: boolean,
}

-- Streaming 2, lane C2 (spec F7): one player a Radar Hill holder reveals. Instance-free (F31): the client may not
-- hold that character under instance streaming, so it draws a marker at Pos instead of the Highlight.
export type RadarTargetPayload = {
	UserId: number,
	Pos: Vector3, -- the server's HumanoidRootPart position when the payload was built
}

export type TerritoryStatePayload = {
	Territories: { TerritoryEntryPayload },
	LocalCapture: {
		TerritoryId: string?,
		Progress: number,
		Capturing: boolean,
		Contested: boolean?,
		Protected: boolean?,
	}?,
	RadarReveal: boolean?,
	RadarRadius: number?,
	-- lane C2: sent only while Workspace.StreamingEnabled and RadarReveal is true; the other living players within
	-- RadarRadius, nearest first (nil with streaming off: every character is on every client)
	RadarTargets: { RadarTargetPayload }?,
}

export type MissionEntryPayload = {
	Id: string,
	DisplayName: string,
	Description: string,
	ObjectiveType: string,
	Progress: number,
	Target: number,
	Claimed: boolean,
	Complete: boolean,
	RewardCash: number,
	RewardXP: number,
	RewardGold: number,
}

export type MissionStatePayload = {
	DayKey: number,
	Daily: { MissionEntryPayload },
	DailyLogin: {
		Streak: number,
		CanClaim: boolean,
		NextDay: number,
		AlreadyClaimedToday: boolean,
	},
}

export type FireRequestPayload = {
	Direction: Vector3, -- camera-ray direction (after client aim help and recoil); finite, magnitude > 0.001
	Origin: Vector3?, -- the point on the camera ray closest to the head; server rule: <= MaxOriginDeltaStuds of the root
	TargetUserId: number?, -- the client ray's target: a HINT for the P0-7 lag tolerance only; never picks an assist target
	TargetNpcId: string?, -- same
	HitPosition: Vector3?, -- the client ray's end: telemetry only (the fire_hitpos_oor soft strike)
	Input: string?, -- W2: "Touch" | "Gamepad" | "KeyboardAndMouse" (<= 16 chars; anything else is ignored, no strike)
}

-- W2 (contracts §2.1): one WeaponFx UnreliableRemoteEvent table per event, sent with FireClient to each recipient.
export type WeaponFxPayload = {
	S: number, -- shooter UserId; 0 = NPC
	W: string, -- WeaponConfig id; "NPC" for NPC rifles
	O: Vector3, -- server-validated origin (NPC: its eye point)
	P: Vector3, -- where the shot landed (exact hit point, target torso, or O + dir x range on a miss); "L": equals O
	K: string, -- "P" player / "N" NPC / "V" vehicle / "G" gate / "W" scenery / "M" miss / "L" launch / "X" explosion
	R: boolean?, -- true on "L"/"X" (projectile events); nil for bullets
	I: number?, -- projectile serial: "L" and "X" of one projectile share it
	V: Vector3?, -- "L": initial velocity (client simulates O + V t + 1/2 g t^2, g = Gravity x GravityFactor)
	T: number?, -- "L": Projectile.MaxSeconds (the client removes the visual at T + 0.5 s if "X" never arrives)
	D: number?, -- "X": splash radius (explosion size + camera shake range)
}

export type PurchaseUpgradeRequest = {
	StructureId: string,
}

export type PurchaseUpgradeResult = {
	Ok: boolean,
	Error: string?,
	NewLevel: number?,
	Cash: number?,
	Gold: number?,
}

return {}
]]></string>
