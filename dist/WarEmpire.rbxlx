	RocketLauncher = { Fire = "Weapon.RocketLauncher.Fire", Reload = "Weapon.Reload.Launcher" },
	Grenade = { Fire = "Weapon.Grenade.Throw" },
	NPC = { Fire = "Weapon.StarterRifle.Fire" },
} :: { [string]: WeaponSounds }

