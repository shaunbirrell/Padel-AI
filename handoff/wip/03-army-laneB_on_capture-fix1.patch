+--[[ army lane B: the target pick of an NPC spawned with a TargetZone (a Town Gate garrison, PostService): the nearest
+	living player within AggroRange who is either ON FOOT with his root within zone.Radius (flat) of zone.Center (and
+	zone.Eligible says yes: the live filter), or on the zone's hit-back list (hurt one of this garrison within
+	HitBackSeconds). A driver passing on the road, or a player far off who never fired, is never picked. No allocation. ]]
+local function nearestZoneTarget(rec: any, zone: any): (Player?, number)
+	local position = rec.Root.Position
+	local maxRange = rec.Def.AggroRange
+	local best: Player? = nil
+	local bestDistSq = maxRange * maxRange
+	local centre: Vector3 = zone.Center
+	local r2 = zone.Radius * zone.Radius
+	local now = B.clock()
+	local eligible = zone.Eligible
+	for _, player in ipairs(Players:GetPlayers()) do
+		local _, hum, root = B.characterParts(player)
+		if hum and root and hum.Health > 0 then
+			local p = root.Position
+			local hitBack = zone.HitBack[player.UserId]
+			local ok = hitBack ~= nil and hitBack > now
+			if not ok and hum.SeatPart == nil then
+				local dx, dz = p.X - centre.X, p.Z - centre.Z
+				ok = dx * dx + dz * dz <= r2 and (eligible == nil or eligible(player) == true)
+			end
+			if ok then
+				local delta = p - position
+				local dSq = delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z
+				if dSq < bestDistSq then
+					bestDistSq = dSq
+					best = player
+				end
+			end
+		end
+	end
+	return best, math.sqrt(bestDistSq)
+end
