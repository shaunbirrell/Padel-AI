+++ b/src/ServerScriptService/Server/Services/PostService.luau
@@ -0,0 +1,631 @@
+--!strict
+--[[
+	PostService — army lane B (SPEC-ARMY-FINAL §3.4, §4, §5; owner 2026-09-28: "too much dead space between the base and
+	the centre ... capture checkpoints along the way and hold onto the checkpoint").
+
+	The checkpoint posts themselves are TerritoryConfig.Posts rows: MapSetup builds their kits, TerritoryService runs
+	their capture tick (TerritoryCapture.PostPresence). This service owns what is neither:
+	  * the chain: PostService.ChainOf(plotId) -> { "Post_FP<n>", "Post_TG_<arm>" } (TerritoryConfig.PostChain);
+	  * the ARMY PRESENCE provider (TerritoryCapture.SetArmyPresence): per owner, the living squad units
+	    (SquadOrdersService.UnitsOf, read-only) with their root in the ring and within Posts.MaxHeightDelta of its
+	    height, counted only while the owner is alive and within Posts.OwnerLeashStuds of the post (his own Forward
+	    Post: anywhere inside his own plot). The live filter and ArmyMinUnits are TerritoryCapture's;
+	  * the TOWN GATE GARRISONS (TerritoryCapture.SetPostGate): per gate 2 NPCs (Posts.TownGate.Garrison at the kit's
+	    activity anchors Town.CP_<x>.Alarm / .G1), spawned through CombatService.SpawnNPC with NoRespawn, OverCap
+	    (inside the 18 + 4 total; CombatService keeps them out of the regular 18, so a camp NPC that dies while a
+	    garrison is awake still respawns), Leash and a TargetZone: they shoot only live players ON FOOT within
+	    TargetZoneStuds of the gate, or live players who hurt them in the last HitBackSeconds (never a driver passing
+	    on the road, never a player far off who never fired). Every shot keeps CombatNPC's line-of-sight and
+	    hit-chance gates. Each garrison model carries TownGate.GuardTag: a viewer who is not live hides it locally
+	    (TerritoryController), CombatService ignores his hits on it (TargetZone.Eligible), and the server's rays for him
+	    (his shots and claims, NPC shots at him) pass through it (CombatService addHiddenBodies), as on his screen.
+	      - wake: a live player within WakeStuds of an armed, Neutral gate, on foot OR seated (a driver parked on the
+	        ring must clear the guards too), an army that counts in the ring (the same presence the capture tick uses:
+	        ArmyMinUnits units, a live owner within OwnerLeashStuds), or the optional army-wake hook lane C sets for an
+	        ATTACK march. A ledger of at most Ledger NPCs alive server-wide (LedgerJobsOn while the Ops master switch is
+	        on): with it full the gate stays asleep and UNGUARDED (capturable on time alone; logged once; spec §5.5);
+	      - RequireClear: while one of them lives the post is frozen for everyone ("guards"); a guard CombatService no
+	        longer runs (a dead record, or its model removed elsewhere) leaves the ledger on the next tick;
+	      - sleep: nobody (live player or army) within SleepRadius and nobody hurt them for SleepSeconds: despawned
+	        silently (no pay), the gate is armed again;
+	      - cleared: all dead (the gate can be taken); it re-arms RegarrisonDelay after it is Neutral again, once no
+	        player is within RegarrisonClear. A held gate never has a garrison;
+	      - Ops cutover, fail closed: while OpsConfig.SiteSwitchedOn(the kit's site, "Town.CP_<x>") the post is "off"
+	        (nobody counts on it) and has no garrison (logged once), so two garrisons never share one kit.
+	Nothing here is sent to a client, nothing is saved, nothing is granted (kills pay CombatService's normal NPC rewards).
+	TerritoryConfig.Posts.Enabled = false: Init returns at once (no provider, no loop, no NPC).
+	Server only; 1 Hz loop, no per-frame work, no GetDescendants.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local CollectionService = game:GetService("CollectionService")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
+local TerritoryConfig = require(Shared.Configs.TerritoryConfig)
+local OpsConfig = require(Shared.Configs.OpsConfig)
+local WorldConfig = require(Shared.Configs.WorldConfig)
+local BaseLayoutConfig = require(Shared.Configs.BaseLayoutConfig)
+local PlotFrame = require(Shared.Util.PlotFrame)
+
+local TerritoryCapture = require(script.Parent.TerritoryService.TerritoryCapture)
+local ActivityAnchors = require(script.Parent.Parent.Modules.ActivityAnchors)
+
+local PostService = {}
+
+local TerritoryService: any = nil
+local CombatService: any = nil
+local SquadOrdersService: any = nil
+local BaseService: any = nil
+
+type Gate = {
+	Id: string, -- the post's territory id ("Post_TG_N")
+	Def: any,
+	Name: string,
+	Center: Vector3,
+	Kit: string, -- the Town checkpoint site id ("Town.CP_N")
+	State: string, -- "armed" | "awake" | "cleared" | "off"
+	Npcs: { string }, -- living garrison NPC ids
+	Pending: number, -- spawns scheduled (SpawnGap) but not made yet
+	Zone: any, -- CombatService NPCTargetZone, shared by this garrison (the hit-back list)
+	LastActiveAt: number,
+	ClearedAt: number?,
+	NeutralSince: number?,
+	WasHeld: boolean,
+	LoggedFull: boolean,
+	LoggedOff: boolean,
+	LoggedCap: boolean,
+	WakeSpawned: number, -- guards this wake actually spawned
+	RetryAt: number, -- no re-wake before this (a wake the NPC cap refused)
+}
+
+local gates: { [string]: Gate } = {}
+local gateOrder: { Gate } = {}
+local npcGate: { [string]: Gate } = {}
+local npcRec: { [string]: any } = {} -- garrison NPC id -> its CombatService record (SpawnNPC's return), for the stale check
+local armyWake: ((gateId: string) -> boolean)? = nil
+local started = false
+
+local function now(): number
+	return os.clock()
+end
+
+local function postsOn(): boolean
+	return TerritoryConfig.Posts.Enabled == true
+end
+
+-- a living character's root and humanoid, or nil
+local function liveParts(player: Player): (BasePart?, Humanoid?)
+	local ch = player.Character
+	if ch == nil then
+		return nil, nil
+	end
+	local root = ch:FindFirstChild("HumanoidRootPart")
+	local hum = ch:FindFirstChildOfClass("Humanoid")
+	if root and root:IsA("BasePart") and hum and hum.Health > 0 then
+		return root, hum
+	end
+	return nil, nil
+end
+
+-- the player's own plot square contains pos, and that plot is plotId
+local function inOwnPlot(player: Player, pos: Vector3, plotId: number): boolean
+	if BaseService == nil or BaseService.GetOwnedPlotId == nil then
+		return false
+	end
+	local ok, own = pcall(BaseService.GetOwnedPlotId, player)
+	if not ok or own ~= plotId then
+		return false
+	end
+	local centre = PlotFrame.PlotPosition(plotId)
+	if centre == nil then
+		return false
+	end
+	local half = (tonumber(BaseLayoutConfig.PlotSize) or 320) * 0.5
+	return math.abs(pos.X - centre.X) <= half and math.abs(pos.Z - centre.Z) <= half
+end
+
+-- the chain of a plot (nearest first): its Forward Post, then its Town Gate (lane C's ATTACK targets)
+function PostService.ChainOf(plotId: any): { string }
+	return TerritoryConfig.PostChain(plotId)
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- army presence (TerritoryCapture.SetArmyPresence)
+---------------------------------------------------------------------------------------------------------------
+
+local function armyPresence(def: any, center: Vector3, radius: number, maxDy: number, out: { [number]: number })
+	local sqs = SquadOrdersService
+	if sqs == nil or typeof(sqs.UnitsOf) ~= "function" then
+		return
+	end
+	local P = TerritoryConfig.Posts
+	local leash = tonumber(P.OwnerLeashStuds) or 320
+	local r2 = radius * radius
+	for _, owner in ipairs(Players:GetPlayers()) do
+		if not TerritoryConfig.PostsLiveFor(owner.UserId) then
+			continue
+		end
+		local units = sqs.UnitsOf(owner.UserId)
+		if typeof(units) ~= "table" or #units == 0 then
+			continue
+		end
+		local root = liveParts(owner)
+		if root == nil then
+			continue -- the owner must be alive
+		end
+		local op = root.Position
+		local ox, oz = op.X - center.X, op.Z - center.Z
+		local ownerOk = ox * ox + oz * oz <= leash * leash
+		if not ownerOk and def.PostKind == "Forward" and typeof(def.PlotId) == "number" then
+			ownerOk = inOwnPlot(owner, op, def.PlotId) -- his own Forward Post counts from anywhere in his base
+		end
+		if not ownerOk then
+			continue
+		end
+		local n = 0
+		for _, u in ipairs(units) do
+			local ur = u.Root
+			local uh = u.Humanoid
+			if u.Alive and uh and uh.Health > 0 and ur and ur.Parent then
+				local p = ur.Position
+				local ux, uz = p.X - center.X, p.Z - center.Z
+				if ux * ux + uz * uz <= r2 and math.abs(p.Y - center.Y) <= maxDy then
+					n += 1
+				end
+			end
+		end
+		if n > 0 then
+			out[owner.UserId] = n
+		end
+	end
+end
+
+-- test / lane C hook: an army march wakes a gate (default: none; lane C sets it for an ATTACK on this gate)
+function PostService.SetArmyWake(fn: ((gateId: string) -> boolean)?)
+	armyWake = fn
+end
+
+---------------------------------------------------------------------------------------------------------------
+-- Town Gate garrisons
+---------------------------------------------------------------------------------------------------------------
+
+-- the garrison ledger: TownGate.Ledger (4), or TownGate.LedgerJobsOn (2) while the Ops master switch is on. Other
+-- spawns never count garrison NPCs (CombatService lifts their caps), so with Jobs / events filling the specials' +4 the
+-- server holds at most 18 + 4 + LedgerJobsOn = 24 NPCs (22 with Ops off: 13 camp + 5 bank + 4 garrison).
+local function ledgerCap(): number
+	local T = TerritoryConfig.Posts.TownGate
+	if OpsConfig.Enabled == true then
+		return tonumber(T.LedgerJobsOn) or 2
+	end
+	return tonumber(T.Ledger) or 4
+end
+
+local function ledgerUsed(): number
+	local n = 0
+	for _, g in ipairs(gateOrder) do
+		n += #g.Npcs + g.Pending
+	end
+	return n
+end
+
+-- living garrison NPCs of a post id (0 for a Forward Post / unknown id)
+function PostService.GarrisonAlive(postId: string): number
+	local g = gates[postId]
+	return if g then #g.Npcs else 0
+end
+
+-- every living garrison NPC server-wide (the ledger)
+function PostService.GarrisonTotal(): number
+	local n = 0
+	for _, g in ipairs(gateOrder) do
+		n += #g.Npcs
+	end
+	return n
+end
+
+-- test hook: a gate's state ("armed" | "awake" | "cleared" | "off")
+function PostService.GateState(postId: string): string?
+	local g = gates[postId]
+	return if g then g.State else nil
+end
+
+-- TerritoryCapture.SetPostGate: "off" (Ops owns the kit), "guards" (a garrison NPC lives) or nil
+local function gateState(def: any): string?
+	if typeof(def) ~= "table" or def.PostKind ~= "TownGate" then
+		return nil
+	end
+	local g = gates[def.Id]
+	if g == nil then
+		return nil
+	end
+	if g.State == "off" then
+		return "off"
+	end
+	if #g.Npcs > 0 then
+		return "guards"
+	end
+	return nil
+end
+
+-- where a garrison role stands: the kit's activity anchor, else the same point from config (kit frame + template)
+local function roleCFrame(g: Gate, role: string): CFrame?
+	local okA, a = pcall(ActivityAnchors.Get, g.Kit .. "." .. role)
+	if okA and a ~= nil then
+		return a.CFrame
+	end
+	local site = (TerritoryConfig.Posts.TownGate.Sites :: any)[g.Def.Arm]
+	if site == nil then
+		return nil
+	end
+	for _, t in ipairs(WorldConfig.Activity.CheckpointAnchors) do
+		if t.Role == role then
+			local kit = CFrame.new(site.X, 0, site.Z) * CFrame.Angles(0, math.rad(site.Yaw or 0), 0)
+			local p = (kit * CFrame.new(t.X, 0, t.Z)).Position
+			return CFrame.new(p.X, WorldConfig.Activity.FloorY, p.Z) * CFrame.Angles(0, math.rad((site.Yaw or 0) + (t.Yaw or 0)), 0)
+		end
+	end
+	return nil
+end
+
+local function removeNpc(g: Gate, id: string)
+	local i = table.find(g.Npcs, id)
+	if i then
+		table.remove(g.Npcs, i)
+	end
+	npcGate[id] = nil
+	npcRec[id] = nil
+end
+
+local function despawnAll(g: Gate)
+	local ids = table.clone(g.Npcs)
+	for _, id in ipairs(ids) do
+		npcGate[id] = nil
+		npcRec[id] = nil
+		if CombatService and CombatService.DespawnNPC then
+			pcall(CombatService.DespawnNPC, id)
+		end
+	end
+	table.clear(g.Npcs)
+	table.clear(g.Zone.HitBack)
+end
+
+local function spawnOne(g: Gate, typeId: string, cf: CFrame)
+	local T = TerritoryConfig.Posts.TownGate
+	g.Pending = math.max(0, g.Pending - 1)
+	if g.State ~= "awake" or CombatService == nil or CombatService.SpawnNPC == nil then
+		return
+	end
+	local at = cf + Vector3.new(0, T.RootLift, 0)
+	local ok, rec = pcall(CombatService.SpawnNPC, typeId, at, {
+		NoRespawn = true,
+		OverCap = true, -- inside CombatConfig's 18 + SpecialOverCap (4) cap
+		Leash = T.Leash,
+		Home = at,
+		TargetZone = g.Zone,
+	})
+	if ok and typeof(rec) == "table" and typeof(rec.Id) == "string" then
+		table.insert(g.Npcs, rec.Id)
+		npcGate[rec.Id] = g
+		npcRec[rec.Id] = rec
+		-- non-live viewers hide the guards locally (TerritoryController), as they hide the kit
+		local model = rec.Model
+		if typeof(model) == "Instance" and typeof(T.GuardTag) == "string" then
+			pcall(CollectionService.AddTag, CollectionService, model, T.GuardTag)
+		end
+		g.WakeSpawned += 1
+		g.LoggedCap = false
+		return
+	elseif not ok then
+		warn("[PostService] garrison spawn failed at " .. g.Id .. ": " .. tostring(rec))
+	elseif not g.LoggedCap then
+		g.LoggedCap = true -- nil: CombatService refused it at the NPC cap
+		warn(string.format("[PostService] garrison spawn refused at the NPC cap: %s", g.Name))
+	end
+	-- no guard of this wake spawned: back to armed (RequireClear still holds; retry after CapRetrySeconds), never a
+	-- silently "cleared" gate with no guards
+	if g.Pending == 0 and g.WakeSpawned == 0 and #g.Npcs == 0 then
+		despawnAll(g)
+		g.State = "armed"
+		g.RetryAt = now() + (tonumber(T.CapRetrySeconds) or 5)
+	end
+end
+
+-- wake: the whole garrison, spawned SpawnGap apart, or nothing while the ledger has no room (the gate stays unguarded)
+local function wake(g: Gate, t: number)
+	local T = TerritoryConfig.Posts.TownGate
+	local rows = T.Garrison
+	local cap = ledgerCap()
+	if ledgerUsed() + #rows > cap then
+		if not g.LoggedFull then
+			g.LoggedFull = true
+			warn(string.format("[PostService] garrison ledger full (%d): %s stays unguarded until one sleeps", cap, g.Name))
+		end
+		return
+	end
+	g.State = "awake"
+	g.LastActiveAt = t
+	g.WakeSpawned = 0
+	table.clear(g.Zone.HitBack)
+	-- Pending counts the whole wake first, so a refused first guard does not end the wake before the second tries
+	local plan: { { Type: string, At: CFrame, Gap: number } } = {}
+	for i, row in ipairs(rows) do
+		local cf = roleCFrame(g, row.Role)
+		if cf then
+			table.insert(plan, { Type = row.Type, At = cf, Gap = (i - 1) * (tonumber(T.SpawnGap) or 0.2) })
+		end
+	end
+	g.Pending += #plan
+	for i, p in ipairs(plan) do
+		if i == 1 then
+			spawnOne(g, p.Type, p.At)
+		else
+			task.delay(p.Gap, spawnOne, g, p.Type, p.At)
+		end
+	end
+end
+
+-- a live player within radius of pos (onFoot: not seated)
+local function livePlayerWithin(pos: Vector3, radius: number, onFoot: boolean): boolean
+	local r2 = radius * radius
+	for _, p in ipairs(Players:GetPlayers()) do
+		if TerritoryConfig.PostsLiveFor(p.UserId) then
+			local root, hum = liveParts(p)
+			if root and hum and (not onFoot or hum.SeatPart == nil) then
+				local d = root.Position - pos
+				if d.X * d.X + d.Z * d.Z <= r2 then
+					return true
+				end
+			end
+		end
+	end
+	return false
+end
+
+-- any player at all within radius (the re-garrison clearance: nobody sees guards pop in beside him)
+local function anyPlayerWithin(pos: Vector3, radius: number): boolean
+	local r2 = radius * radius
+	for _, p in ipairs(Players:GetPlayers()) do
+		local root = liveParts(p)
+		if root then
+			local d = root.Position - pos
+			if d.X * d.X + d.Z * d.Z <= r2 then
+				return true
+			end
+		end
+	end
+	return false
+end
+
+-- an army that counts in this gate's ring right now (the capture tick's own presence rule: ArmyMinUnits living units in
+-- the ring, owner alive and within OwnerLeashStuds, live filter). It would otherwise take the gate unguarded.
+local function armyInRing(g: Gate): boolean
+	local P = TerritoryConfig.Posts
+	local raw: { [number]: number } = {}
+	armyPresence(g.Def, g.Center, tonumber(g.Def.Radius) or 18, tonumber(P.MaxHeightDelta) or 14, raw)
+	local minUnits = math.max(1, math.floor(tonumber(P.ArmyMinUnits) or 2))
+	for uid, n in pairs(raw) do
+		if n >= minUnits and TerritoryConfig.PostsLiveFor(uid) then
+			return true
+		end
+	end
+	return false
+end
+
+-- a live owner's living unit within radius of pos
+local function armyWithin(pos: Vector3, radius: number): boolean
+	local sqs = SquadOrdersService
+	if sqs == nil or typeof(sqs.UnitsOf) ~= "function" then
+		return false
+	end
+	local r2 = radius * radius
+	for _, owner in ipairs(Players:GetPlayers()) do
+		if TerritoryConfig.PostsLiveFor(owner.UserId) then
+			local units = sqs.UnitsOf(owner.UserId)
+			if typeof(units) == "table" then
+				for _, u in ipairs(units) do
+					local ur = u.Root
+					if u.Alive and ur and ur.Parent then
+						local d = ur.Position - pos
+						if d.X * d.X + d.Z * d.Z <= r2 then
+							return true
+						end
+					end
+				end
+			end
+		end
+	end
+	return false
+end
+
+-- the latest hit-back stamp minus its window = when someone last hurt this garrison
+local function lastHurtAt(g: Gate): number
+	local latest = -math.huge
+	for _, untilT in pairs(g.Zone.HitBack) do
+		if untilT > latest then
+			latest = untilT
+		end
+	end
+	return latest - (tonumber(g.Zone.HitBackSeconds) or 10)
+end
+
+local function tickGate(g: Gate, t: number)
+	local T = TerritoryConfig.Posts.TownGate
+	-- Ops cutover, fail closed: the kit belongs to the Jobs site
+	local okOps, opsOn = pcall(OpsConfig.SiteSwitchedOn, g.Kit)
+	if okOps and opsOn == true then
+		if g.State ~= "off" then
+			despawnAll(g)
+			g.State = "off"
+			if not g.LoggedOff then
+				g.LoggedOff = true
+				warn(string.format("[PostService] %s is off: the Ops site %s owns its checkpoint kit", g.Name, g.Kit))
+			end
+		end
+		return
+	elseif g.State == "off" then
+		g.State = "armed"
+	end
+
+	local rt = if TerritoryService and TerritoryService.GetRuntime then TerritoryService.GetRuntime(g.Id) else nil
+	local held = rt ~= nil and rt.OwnerType == TerritoryConfig.OwnerTypes.Player
+	if held then
+		g.WasHeld = true
+		g.NeutralSince = nil
+		if g.State ~= "awake" then
+			g.State = "cleared" -- a held gate has no garrison
+			g.ClearedAt = g.ClearedAt or t
+		end
+	elseif g.WasHeld then
+		g.WasHeld = false
+		g.NeutralSince = t
+	end
+
+	if g.State == "awake" then
+		-- a guard CombatService no longer runs leaves the ledger here, so a stale id never keeps the gate frozen
+		-- ("guards") with nobody there: its record is dead (CombatService already let it go), or its model was removed
+		-- outside CombatService (the record is despawned too). Only on that evidence; at most 2 ids, no allocation.
+		for i = #g.Npcs, 1, -1 do
+			local id = g.Npcs[i]
+			local rec = npcRec[id]
+			if rec == nil or rec.Alive == false then
+				removeNpc(g, id)
+			elseif typeof(rec.Model) == "Instance" and rec.Model.Parent == nil then
+				if CombatService and CombatService.DespawnNPC then
+					pcall(CombatService.DespawnNPC, id)
+				end
+				removeNpc(g, id)
+			end
+		end
+		if #g.Npcs == 0 and g.Pending == 0 then
+			g.State = "cleared"
+			g.ClearedAt = t
+			return
+		end
+		local active = livePlayerWithin(g.Center, T.SleepRadius, false) or armyWithin(g.Center, T.SleepRadius)
+			or t - lastHurtAt(g) < T.SleepSeconds
+		if active then
+			g.LastActiveAt = t
+		elseif t - g.LastActiveAt >= T.SleepSeconds then
+			despawnAll(g) -- asleep: no pay, no respawn
+			g.State = "armed"
+		end
+	elseif g.State == "armed" then
+		if held then
+			return
+		end
+		-- any live player (on foot or seated: a parked driver counts on the ring) or an army counting in the ring
+		local woke = livePlayerWithin(g.Center, T.WakeStuds, false) or armyInRing(g)
+		local hook = armyWake
+		if not woke and hook then
+			local okW, w = pcall(hook, g.Id)
+			woke = okW and w == true
+		end
+		if woke and t >= g.RetryAt then
+			wake(g, t)
+		end
+	elseif g.State == "cleared" then
+		if held then
+			return
+		end
+		local since = math.max(g.ClearedAt or t, g.NeutralSince or -math.huge)
+		if t - since >= T.RegarrisonDelay and not anyPlayerWithin(g.Center, T.RegarrisonClear) then
+			g.State = "armed"
+			g.ClearedAt = nil
+			g.LoggedFull = false
+		end
+	end
+end
+
+-- one garrison pass (the 1 Hz loop; tests call it directly)
+function PostService.Step()
+	local t = now()
+	for _, g in ipairs(gateOrder) do
+		local ok, err = pcall(tickGate :: any, g, t)
+		if not ok then
+			warn("[PostService] gate tick failed at " .. g.Id .. ": " .. tostring(err))
+		end
+	end
+end
+
+local function onNPCDeath(info: any)
+	local id = if typeof(info) == "table" then info.Id else nil
+	if typeof(id) ~= "string" then
+		return
+	end
+	local g = npcGate[id]
+	if g then
+		removeNpc(g, id)
+	end
+end
+
+function PostService.Init(deps: { [string]: any })
+	TerritoryService = deps.TerritoryService
+	CombatService = deps.CombatService
+	SquadOrdersService = deps.SquadOrdersService
+	BaseService = deps.BaseService
+	if not postsOn() or started then
+		return
+	end
+	started = true
+
+	local T = TerritoryConfig.Posts.TownGate
+	local ids: { string } = {}
+	for id, def in pairs(TerritoryConfig.Territories) do
+		if TerritoryConfig.IsPostDef(def) and def.PostKind == "TownGate" then
+			table.insert(ids, id)
+		end
+	end
+	table.sort(ids)
+	for _, id in ipairs(ids) do
+		local def = TerritoryConfig.Territories[id]
+		local g: Gate = {
+			Id = id,
+			Def = def,
+			Name = def.DisplayName,
+			Center = def.Position,
+			Kit = def.Kit or "",
+			State = "armed",
+			Npcs = {},
+			Pending = 0,
+			Zone = {
+				Center = def.Position,
+				Radius = T.TargetZoneStuds,
+				HitBack = {},
+				HitBackSeconds = T.HitBackSeconds,
