+    heads = [(m.group(1) or m.group(2), m.start()) for m in re.finditer(r"^(?:local function (\w+)|function ([\w.]+))\(", code, re.M)]
+    return [(name, start, heads[i + 1][1] if i + 1 < len(heads) else len(code)) for i, (name, start) in enumerate(heads)]
