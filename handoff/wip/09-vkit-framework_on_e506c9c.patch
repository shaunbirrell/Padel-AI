new file mode 100644
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/Client/Modules/VehicleBodySpin.luau
@@ -0,0 +1,202 @@
+--!strict
+--[[ VKIT: turns the rotors of Part-built vehicle bodies on this client (visual only, nothing is sent or replicated).
+	The server joins each rotor group to the chassis with one Motor6D tagged VehicleBodies.Spin.Tag and carrying
+	WE_RotorRpm / WE_RotorAxis ("X" | "Y" | "Z") / WE_RotorBlades (Modules/VehicleBodyBuilder). This module writes that
+	Motor6D's Transform; Transform never replicates, so every client spins its own copy and the server's stays still.
+
+	Cost (CLAUDE.md phone rules):
+	  * one PreSimulation connection; the rotors to turn are chosen Spin.ScanHz times a second (<= 10 Hz): within
+	    Spin.Range of the camera AND (the vehicle is powered: its WE_DriverUserId is set, or it is still spinning down),
+	    at most Spin.MaxActive, the nearest first;
+	  * per frame: numbers only, and Motor6D.Transform set from CFrames precomputed when the rotor streamed in
+	    (Spin.Steps per 360 / Blades degrees) and only when the step changes: no allocation, no tree scan;
+	  * rotors are found through CollectionService added / removed signals (StreamingEnabled-safe: a rotor that streams
+	    out is dropped, one that streams back in is added again), never by searching the workspace.
+	Spin up / down over Spin.SpinUpSeconds / SpinDownSeconds. VehicleBodies.Spin.Enabled = false: nothing turns. ]]
+
+local CollectionService = game:GetService("CollectionService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+
+-- Bootstrap only starts client modules once ReplicatedStorage.Shared is there (bounded wait, like the other modules)
+local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
+
+local VehicleBodySpin = {}
+
+type Rotor = {
+	Motor: Motor6D,
+	Vehicle: Instance?,
+	Frames: { CFrame },
+	Steps: number,
+	Span: number, -- radians of one symmetric turn (2 pi / Blades)
+	Rate: number, -- radians per second at full power
+	Power: number, -- 0..1
+	Target: number, -- 1 while powered
+	Angle: number,
+	Index: number,
+	Dist: number,
+}
+
+local DEFAULTS = { Enabled = true, Tag = "WE_BodyRotor", ScanHz = 4, Range = 300, MaxActive = 12, Steps = 24, SpinUpSeconds = 2.5, SpinDownSeconds = 4 }
+local cfg: { [string]: any } = table.clone(DEFAULTS)
+local AXES: { [string]: Vector3 } = { X = Vector3.xAxis, Y = Vector3.yAxis, Z = Vector3.zAxis }
+
+local rotors: { [Motor6D]: Rotor } = {}
+local active: { Rotor } = {}
+local scanAcc = 0
+local started = false
+
+local function byDist(a: Rotor, b: Rotor): boolean
+	return a.Dist < b.Dist
+end
+
+-- the vehicle model a rotor belongs to (the nearest ancestor Model with VehicleId), found once
+local function vehicleOf(m: Instance): Instance?
+	local cur = m.Parent
+	while cur ~= nil and cur ~= Workspace do
+		if cur:IsA("Model") and cur:GetAttribute("VehicleId") ~= nil then
+			return cur
+		end
+		cur = cur.Parent
+	end
+	return nil
+end
+
+local function register(inst: Instance)
+	if not inst:IsA("Motor6D") or rotors[inst] ~= nil then
+		return
+	end
+	local rpm = tonumber(inst:GetAttribute("WE_RotorRpm")) or 0
+	local axisName = inst:GetAttribute("WE_RotorAxis")
+	local axis = if typeof(axisName) == "string" then AXES[axisName] else nil
+	local blades = math.max(1, math.floor(tonumber(inst:GetAttribute("WE_RotorBlades")) or 1))
+	if rpm <= 0 or axis == nil then
+		return
+	end
+	local steps = math.clamp(math.floor(tonumber(cfg.Steps) or 24), 4, 90)
+	local span = 2 * math.pi / blades
+	local frames: { CFrame } = table.create(steps)
+	for i = 0, steps - 1 do
+		frames[i + 1] = CFrame.fromAxisAngle(axis, span * i / steps)
+	end
+	rotors[inst] = {
+		Motor = inst,
+		Vehicle = vehicleOf(inst),
+		Frames = frames,
+		Steps = steps,
+		Span = span,
+		Rate = rpm * 2 * math.pi / 60,
+		Power = 0,
+		Target = 0,
+		Angle = 0,
+		Index = 0,
+		Dist = 0,
+	}
+end
+
+local function unregister(inst: Instance)
+	if inst:IsA("Motor6D") then
+		rotors[inst] = nil
+	end
+end
+
+-- which rotors turn this interval (Spin.ScanHz): near the camera and powered (or still spinning down), nearest first
+local function scan()
+	table.clear(active)
+	local cam = Workspace.CurrentCamera
+	if cam == nil then
+		return
+	end
+	local camPos = cam.CFrame.Position
+	local range = tonumber(cfg.Range) or 300
+	for motor, r in pairs(rotors) do
+		if motor.Parent == nil then
+			rotors[motor] = nil
+		else
+			local veh = r.Vehicle
+			if veh == nil or veh.Parent == nil then
+				veh = vehicleOf(motor)
+				r.Vehicle = veh
+			end
+			local uid = if veh then tonumber(veh:GetAttribute("WE_DriverUserId")) else nil
+			r.Target = if uid ~= nil and uid ~= 0 then 1 else 0
+			local p0 = motor.Part0
+			if p0 ~= nil and (r.Target > 0 or r.Power > 0) then
+				r.Dist = (p0.Position - camPos).Magnitude
+				if r.Dist <= range then
+					table.insert(active, r)
+				end
+			end
+		end
+	end
+	local cap = math.max(0, math.floor(tonumber(cfg.MaxActive) or 12))
+	if #active > cap then
+		table.sort(active, byDist)
+		for i = #active, cap + 1, -1 do
+			active[i] = nil
+		end
+	end
+end
+
+-- per frame: numbers only, and Transform from the precomputed frames when the step changes
+function VehicleBodySpin._Step(dt: number)
+	scanAcc += dt
+	if scanAcc >= 1 / math.clamp(tonumber(cfg.ScanHz) or 4, 1, 10) then
+		scanAcc = 0
+		scan()
+	end
+	local up = math.max(0.05, tonumber(cfg.SpinUpSeconds) or 2.5)
+	local down = math.max(0.05, tonumber(cfg.SpinDownSeconds) or 4)
+	for i = 1, #active do
+		local r = active[i]
+		if r.Power < r.Target then
+			r.Power = math.min(r.Target, r.Power + dt / up)
+		elseif r.Power > r.Target then
+			r.Power = math.max(r.Target, r.Power - dt / down)
+		end
+		if r.Power > 0 then
+			r.Angle = (r.Angle + r.Rate * r.Power * dt) % r.Span
+			local idx = math.floor(r.Angle / r.Span * r.Steps) % r.Steps + 1
+			if idx ~= r.Index then
+				r.Index = idx
+				r.Motor.Transform = r.Frames[idx]
+			end
+		end
+	end
+end
+
+-- test / tool access (headless stand-in): the tracked and the turning rotors
+function VehicleBodySpin._State(): ({ [Motor6D]: Rotor }, { Rotor })
+	return rotors, active
+end
+
+function VehicleBodySpin.Init()
+	if started then
+		return
+	end
+	local ok, VB = pcall(function(): any
+		return require(Shared.Configs.VehicleBodies)
+	end)
+	if ok and typeof(VB) == "table" and typeof(VB.Spin) == "table" then
+		for k, v in pairs(VB.Spin) do
+			cfg[k] = v
+		end
+	end
+	if cfg.Enabled ~= true then
+		return
+	end
+	started = true
+	local tag: string = cfg.Tag
+	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
+		register(inst)
+	end
+	CollectionService:GetInstanceAddedSignal(tag):Connect(register)
+	CollectionService:GetInstanceRemovedSignal(tag):Connect(unregister)
+	local ev: any = (RunService :: any).PreSimulation or RunService.Stepped
+	ev:Connect(function(a: number, b: number?)
+		VehicleBodySpin._Step(if typeof(b) == "number" then b else a)
+	end)
+end
+
+return VehicleBodySpin
diff --git a/tools/BuyPathStatic.py b/tools/BuyPathStatic.py
--- a/tools/BuyPathStatic.py
+++ b/tools/BuyPathStatic.py
@@ -8254,6 +8254,235 @@
 _ap_rules()
 # ── end atmprompt
 
+# ── vkit framework: Part-built vehicle bodies (Configs/VehicleBodies + Modules/VehicleBodyBuilder + VehicleBodySpin) ──
+# Static pins (comments stripped with _db_luau_code): kill switch, budgets, per-vehicle part / emissive counts parsed
+# from the blueprint lines, what the builder may create, body part physics flags, store body first, weapons dress
+# skipped, the client spin loop's per-frame work, the bomb / muzzle point, blueprint keys = VehicleConfig ids.
+VK_DIR = "src/ReplicatedStorage/Shared/Configs/VehicleBodies"
+VK_INIT = VK_DIR + "/init.luau"
+VK_CLASSES = ("Ground", "Air", "Naval")
+VK_BUILDER = "src/ServerScriptService/Server/Modules/VehicleBodyBuilder.luau"
+VK_SPIN = "src/StarterPlayer/StarterPlayerScripts/Client/Modules/VehicleBodySpin.luau"
+VK_BOOT = "src/StarterPlayer/StarterPlayerScripts/Client/Bootstrap.client.luau"
+VK_VS = "src/ServerScriptService/Server/Services/VehicleService.luau"
+VK_AWS = "src/ServerScriptService/Server/Services/AirWeaponService.luau"
+VK_VC = "src/ReplicatedStorage/Shared/Configs/VehicleConfig.luau"
+
+
+def _vk_block(code: str, start: int) -> str:
+    """the text inside the brace that opens at code[start] ('{'), strings and nested braces respected"""
+    depth, i, n = 0, start, len(code)
+    while i < n:
+        c = code[i]
+        if c in "\"'":
+            j = i + 1
+            while j < n and code[j] != c:
+                j += 2 if code[j] == "\\" else 1
+            i = j + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return code[start + 1:i]
+        i += 1
+    return ""
+
+
+def _vk_field(body: str, key: str) -> str | None:
+    """body of `key = { ... }` at the top level of `body`"""
+    for m in re.finditer(r"(?<![\w.])" + key + r"\s*=\s*\{", body):
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") == 0:
+            return _vk_block(body, m.end() - 1)
+    return None
+
+
+def _vk_entries(body: str) -> dict:
+    """top-level `Name = { ... }` entries of a table body"""
+    out, i = {}, 0
+    for m in re.finditer(r"(\w+)\s*=\s*\{", body):
+        if m.start() < i:
+            continue
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") != 0:
+            continue
+        inner = _vk_block(body, m.end() - 1)
+        out[m.group(1)] = inner
+        i = m.end() + len(inner)
+    return out
+
+
+def _vk_parts(body: str | None) -> list[dict]:
+    """every P({ ... }) part line: name, mirror, emissive, size"""
+    parts = []
+    for m in re.finditer(r"\bP\(\{", body or ""):
+        spec = _vk_block(body, m.end() - 1)
+        nm = re.search(r'Name\s*=\s*"([^"]+)"', spec)
+        sz = re.search(r"Size\s*=\s*V\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)", spec)
+        parts.append({"name": nm.group(1) if nm else "?", "mirror": re.search(r"Mirror\s*=\s*true", spec) is not None,
+                      "emissive": re.search(r"Emissive\s*=\s*true", spec) is not None,
+                      "size": tuple(float(x) for x in sz.groups()) if sz else None})
+    return parts
+
+
+def _vk_num(body: str, key: str) -> float | None:
+    m = re.search(r"(?<![\w.])" + key + r"\s*=\s*([-\d.]+)", body or "")
+    return float(m.group(1)) if m else None
+
+
+def _vk_rules() -> None:
+    init = _db_luau_code(read(VK_INIT) or "")
+    if not init:
+        bad(f"vkit: {VK_INIT} missing")  # every rule below then fails on its own (nothing returns early)
+    root = re.search(r"local VehicleBodies\s*=\s*\{", init)
+    top = _vk_block(init, root.end() - 1) if root else ""
+    # 1. kill switch on the config's top level; the builder returns before building anything when it is off
+    if re.search(r"(?m)^\tEnabled\s*=\s*(true|false)\s*,", top):
+        ok("vkit: VehicleBodies.Enabled is the top-level kill switch")
+    else:
+        bad("vkit: VehicleBodies.Enabled (top level) missing")
+    bld = _db_luau_code(read(VK_BUILDER) or "")
+    m_apply = re.search(r"function Builder\.Apply\(model: Model, def: any\): boolean\n", bld)
+    head = bld[m_apply.end():m_apply.end() + 400] if m_apply else ""
+    if re.match(r"\tif VB == nil or VB\.Enabled ~= true then\n\t\treturn false\n\tend\n", head):
+        ok("vkit: Builder.Apply returns false first thing when VehicleBodies is off (today's kit untouched)")
+    else:
+        bad("vkit: Builder.Apply must start with `if VB == nil or VB.Enabled ~= true then return false end`")
+    # 2. budgets: the hard caps may not grow
+    budget = _vk_field(top, "Budget") or ""
+    want = {"MaxParts": 40, "MaxEmissive": 2, "EmissiveMaxSize": 1.5, "MaxLights": 0}
+    got = {k: _vk_num(budget, k) for k in want}
+    if all(got[k] is not None and got[k] <= v for k, v in want.items()):
+        ok(f"vkit: VehicleBodies.Budget within the caps {want} ({got})")
+    else:
+        bad(f"vkit: VehicleBodies.Budget over the caps {want}: {got}")
+    spin = _vk_field(top, "Spin") or ""
+    hz = _vk_num(spin, "ScanHz")
+    if hz is not None and 0 < hz <= 10 and _vk_num(spin, "MaxActive") is not None and (_vk_num(spin, "MaxActive") or 99) <= 16:
+        ok(f"vkit: VehicleBodies.Spin.ScanHz {hz:g} <= 10 Hz, MaxActive {_vk_num(spin, 'MaxActive'):g} <= 16")
+    else:
+        bad(f"vkit: VehicleBodies.Spin.ScanHz must be 1..10 and MaxActive <= 16 (ScanHz {hz})")
+    # 3. per-vehicle part / emissive counts from the blueprint lines (Mirror = 2); keys are VehicleConfig ids
+    vc = read(VK_VC) or ""
+    ids = set(re.findall(r'(?m)^\t\t(\w+) = V\("(\w+)"', vc) and [a for a, b in re.findall(r'(?m)^\t\t(\w+) = V\("(\w+)"', vc) if a == b])
+    maxp, maxe, esz = int(got["MaxParts"] or 40), int(got["MaxEmissive"] or 2), float(got["EmissiveMaxSize"] or 1.5)
+    nveh, banned = 0, re.compile(r"flag|insignia|roundel|emblem|decal|logo|marking", re.I)
+    for cls in VK_CLASSES:
+        code = _db_luau_code(read(f"{VK_DIR}/{cls}.luau") or "")
+        m = re.search(r"local \w+: Types\.ClassModule\s*=\s*\{", code)
+        if not m:
+            bad(f"vkit: {cls}.luau has no `local <Class>: Types.ClassModule = {{`")
+            continue
+        body = _vk_block(code, m.end() - 1)
+        if re.search(r"Material\.Neon|Enum\.Material\.ForceField", code):
+            bad(f"vkit: {cls}.luau sets Material Neon / ForceField directly (glow only through Emissive = true, counted)")
+        fams = _vk_entries(_vk_field(body, "Families") or "")
+        vehs = _vk_entries(_vk_field(body, "Vehicles") or "")
+        kf = _vk_field(body, "KitFamilies")
+        if kf is not None and kf.strip() == "":
+            ok(f"vkit: {cls} KitFamilies is empty (Part bodies are opt-in per vehicle id)")
+        else:
+            bad(f"vkit: {cls} KitFamilies must stay empty in this lane (opt-in per vehicle); found `{(kf or '?').strip()[:60]}`")
+        for vid, vb in vehs.items():
+            nveh += 1
+            if vid not in ids:
+                bad(f"vkit: {cls}.Vehicles.{vid} is not a VehicleConfig id")
+            ext = re.search(r'Extends\s*=\s*"(\w+)"', vb)
+            fam = fams.get(ext.group(1)) if ext else None
+            if ext and fam is None:
+                bad(f"vkit: {cls}.Vehicles.{vid} extends unknown family {ext.group(1)}")
+                continue
+            parts = _vk_parts(_vk_field(fam, "Parts") if fam else _vk_field(vb, "Parts"))
+            rem = set(re.findall(r'"(\w+)"', _vk_field(vb, "Remove") or ""))
+            parts = [p for p in parts if p["name"] not in rem] + _vk_parts(_vk_field(vb, "Add"))
+            n = sum(2 if p["mirror"] else 1 for p in parts)
+            ne = sum(2 if p["mirror"] else 1 for p in parts if p["emissive"])
+            scale = _vk_num(vb, "Scale") or _vk_num(fam or "", "Scale") or 1.0
+            big = [p["name"] for p in parts if p["emissive"] and p["size"] and max(p["size"]) * scale > esz + 1e-6]
+            named = [p["name"] for p in parts if banned.search(p["name"])]
+            if n <= maxp and ne <= maxe and not big and not named:
+                ok(f"vkit: {cls}.{vid}: {n} body parts <= {maxp}, {ne} emissive <= {maxe} (each <= {esz:g} studs at scale {scale:g}), no flag / insignia parts")
+            else:
+                bad(f"vkit: {cls}.{vid}: {n} parts (max {maxp}), {ne} emissive (max {maxe}), emissive too long {big}, banned names {named}")
+            if "DriverSeat" not in (_vk_field(vb, "Seats") or "") + (_vk_field(fam or "", "Seats") or ""):
+                bad(f"vkit: {cls}.{vid}: no DriverSeat in Seats (the driver must sit inside the body)")
+    if nveh >= 1:
+        ok(f"vkit: {nveh} blueprint vehicle(s) parsed")
+    else:
+        bad("vkit: no blueprint vehicles parsed")
+    # 4. the builder creates only parts, welds, one Motor6D per rotor group, attachments and the body model
+    made = set(re.findall(r'Instance\.new\("(\w+)"\)', bld))
+    dyn = re.findall(r'Instance\.new\(([^")]+)\)', bld)
+    allowed = {"Model", "Part", "WedgePart", "CornerWedgePart", "WeldConstraint", "Motor6D", "Attachment"}
+    cls_line = 'local cls = if shape == "Wedge" then "WedgePart" elseif shape == "CornerWedge" then "CornerWedgePart" else "Part"'
+    if made and made <= allowed and dyn == ["cls"] and cls_line in bld:
+        ok(f"vkit: VehicleBodyBuilder creates only {sorted(made | {'WedgePart', 'CornerWedgePart'})} (no lights, GUIs, decals, textures, effects, sounds)")
+    else:
+        bad(f"vkit: VehicleBodyBuilder creates {sorted(made)} + dynamic {dyn}; allowed {sorted(allowed)} (dynamic only the Part / WedgePart / CornerWedgePart `cls`)")
+    for needle, label in (("p.CanCollide = false", "CanCollide false"), ("p.CanQuery = false", "CanQuery false"),
+                          ("p.CanTouch = false", "CanTouch false"), ("p.Massless = true", "Massless"), ("p.Anchored = false", "unanchored")):
+        if needle in bld:
+            ok(f"vkit: every body part is {label} (makePart)")
+        else:
+            bad(f"vkit: makePart must set `{needle}`")
+    if re.search(r'model:FindFirstChild\("WE_CatalogVisual"\)', head + bld[m_apply.end():m_apply.end() + 1500] if m_apply else ""):
+        ok("vkit: Builder.Apply refuses a model that already wears a store body (WE_CatalogVisual)")
+    else:
+        bad("vkit: Builder.Apply must refuse a model with WE_CatalogVisual (a store body wins)")
