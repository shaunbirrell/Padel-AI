+++ b/src/ReplicatedStorage/Shared/Configs/VehicleBodies/Types.luau
@@ -0,0 +1,97 @@
+--!strict
+--[[ VKIT: the blueprint schema for Part-built vehicle bodies (Configs/VehicleBodies). Types only, no data.
+
+	BODY-LOCAL STUDS (every Vector3 in a blueprint):
+	  X = across the vehicle (+ = its right side), Y = up from the GROUND LINE (the lowest point of the kit's collidable
+	  parts: the tyre bottoms of a car, the gear of a plane, the skids of a helicopter, the hull bottom of a boat; a boat
+	  floats with the water 0.15 above it), Z = along it, the NOSE AT -Z (the kit, the drive laws and the camera all use
+	  -Z as forward: a body drawn nose at -Z flies / drives nose first). X = 0 and Z = 0 are under the kit chassis
+	  centre, which is the physics pivot: put the cabin / cockpit over it (seats are kept inside the kit's collidable
+	  box, see VehicleBodies.SeatKitInset) and let the rest of the body overhang.
+
+	A SEAT is given by its TOP centre. A seated default avatar (R15, 5.2 studs) then has its hips 0.5 above that point,
+	its shoulders about 2.6 above, its head top 3.7 above, its feet 1.0 below and 1.45 in front of it, and it is 4.0
+	studs wide at the arms (1.99 either side of the seat centre).
+
+	PART SHAPES: "Block" (default), "Wedge", "CornerWedge", "Cylinder", "Ball".
+	  Size: with Face / Axis (or no Rot) it is the part's box IN BODY AXES (X across, Y up, Z along); the builder turns
+	  the Roblox part for you. With Rot it is the part's own Size (Roblox convention; Cylinder length on X).
+	  Wedge: the slope faces Face (default "Front" = toward the nose and up; "Back", "Left", "Right", and the same four
+	  + "Down" for an upside-down wedge: "FrontDown", "BackDown", "LeftDown", "RightDown").
+	  CornerWedge: Face turns it like a Wedge (its peak corner is Roblox's own; check it in Studio before relying on it).
+	  Cylinder: Axis = its length axis, "X" (default), "Y" or "Z"; Size along Axis = length, the other two = diameter.
+	  Ball: a sphere of the smallest Size component.
+	  Rot: degrees, CFrame.Angles(rx, ry, rz) (X, then Y, then Z). Rot wins over Face / Axis.
+	Mirror = true builds a second copy mirrored across X = 0 (x -> -x); it counts as 2 parts. ]]
+
+export type Shape = "Block" | "Wedge" | "CornerWedge" | "Cylinder" | "Ball"
+
+export type PartSpec = {
+	Name: string?, -- part name; also the key for Remove, a rotor group member and a mirrored copy ("<Name>_M")
+	Shape: string?, -- Shape (default "Block")
+	Size: Vector3,
+	At: Vector3, -- centre, body-local studs
+	Rot: Vector3?, -- degrees (see above); Size is then the part's own
+	Face: string?, -- Wedge / CornerWedge slope direction
+	Axis: string?, -- Cylinder length axis
+	Color: any?, -- a Palette role name (string) or a Color3; default "Body"
+	Material: Enum.Material?, -- default VehicleBodies.Materials[role] (else SmoothPlastic)
+	Transparency: number?, -- default VehicleBodies.Transparency[role] (Glass / Canopy) else 0; at most Budget.MaxTransparency
+	Emissive: boolean?, -- Neon: a small lamp / nozzle glow (Budget.MaxEmissive per body, each <= Budget.EmissiveMaxSize)
+	Mirror: boolean?,
+	Rotor: string?, -- the Rotors key this part turns with (client spin; see RotorSpec)
+	Shadow: boolean?, -- cast a shadow (default: only parts whose longest side >= VehicleBodies.ShadowMinSize)
+}
+
+-- A group of parts that spins on the client while the vehicle is powered (its WE_DriverUserId is set). The server
+-- joins the group's first part to the chassis with one Motor6D at Hub (tagged VehicleBodies.Spin.Tag) and welds the
+-- rest of the group to that part; VehicleBodySpin (client) writes Motor6D.Transform, so nothing replicates per frame.
+export type RotorSpec = {
+	Hub: Vector3, -- body-local centre of rotation
+	Axis: string, -- "X" | "Y" | "Z" (body axes: main rotor "Y", tail rotor "X", propeller "Z")
+	Rpm: number, -- visual spin at full power (the client eases up / down over Spin.SpinUpSeconds / SpinDownSeconds)
+	Blades: number, -- rotational symmetry (2, 3, 4 ...): the client's precomputed steps cover 360 / Blades degrees
+}
+
+export type Blueprint = {
+	Extends: string?, -- a Families key (same class module): start from that family blueprint
+	Enabled: boolean?, -- false = this vehicle keeps today's kit (default true when listed)
+	Scale: number?, -- uniform scale on every part, seat, rotor hub, muzzle and LabelHeight (default 1)
+	FollowKitScale: boolean?, -- also multiply by the VehicleConfig KitScale (family bodies shared by bigger / smaller ids)
+	Palette: { [string]: Color3 }?, -- colour roles over the global Palette (family first, then the vehicle's)
+	Parts: { PartSpec }?, -- a family's parts; on a vehicle entry it REPLACES the family's parts
+	Add: { PartSpec }?, -- extra parts after the family's
+	Remove: { string }?, -- family part Names left out (a mirrored pair goes together)
+	Seats: { [string]: Vector3 }?, -- "DriverSeat" / "PassengerSeat1".. -> seat TOP centre (merged over the family's)
+	Rotors: { [string]: RotorSpec }?,
+	-- AircraftWeaponConfig Weapons[].Hook (VisualAssetConfig.VehicleWeapons key) -> body-local muzzle / bomb release
+	-- point; a MirrorX weapon alternates between this point and its mirror (x -> -x)
+	Muzzles: { [string]: Vector3 }?,
+	LabelHeight: number?, -- owner nameplate / HP bar height over the ground line (nil: over the body top + LabelMargin)
+	ShowKitWheels: boolean?, -- keep the kit's physics wheels + hubs visible (default false: the body draws its own)
+	KeepKit: { string }?, -- kit part names left visible
+}
+
+export type ClassModule = {
+	KitFamilies: { [string]: string }, -- VehicleConfig KitFamily -> Families key for every vehicle of it without an entry
+	Families: { [string]: Blueprint },
+	Vehicles: { [string]: Blueprint },
+}
+
+-- VehicleBodies.Resolve result: the merged blueprint for one vehicle (parts NOT yet mirrored or scaled)
+export type Resolved = {
+	Key: string,
+	Class: string,
+	Family: string?,
+	Scale: number,
+	Palette: { [string]: Color3 },
+	Parts: { PartSpec },
+	Seats: { [string]: Vector3 },
+	Rotors: { [string]: RotorSpec },
+	Muzzles: { [string]: Vector3 },
+	LabelHeight: number?,
+	ShowKitWheels: boolean,
+	KeepKit: { string },
+}
+
+return {}
diff --git a/src/ReplicatedStorage/Shared/Configs/VehicleBodies/init.luau b/src/ReplicatedStorage/Shared/Configs/VehicleBodies/init.luau
new file mode 100644
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/Configs/VehicleBodies/init.luau
@@ -0,0 +1,431 @@
+--!strict
+--[[ VKIT (owner, phone, 2026-09-28: "Aircraft still too small and I fly above it ... that's not a legit plane ... two
+	other cars ... look almost identical and I sit above the car"): Part-built vehicle bodies, config first.
+
+	WHAT IT DOES. A vehicle listed here gets a body built from Parts at spawn (server, VehicleBodyBuilder) when no Creator
+	Store body is on it: none configured in VisualAssetConfig.Vehicles, not loaded yet, or its load failed. The store
+	body always wins when it loads (VehicleService tries it first). The body is non-colliding, massless, CanTouch /
+	CanQuery false and welded to the kit's Chassis; the kit's plain visual parts are removed before the vehicle is ever
+	parented (no double look, no double part cost), its physics parts (Chassis, collidable parts, wheels) stay and are
+	hidden, and its seats move INTO the body (the rider's hips and torso inside the cab / cockpit / hull). Physics,
+	drive laws, spawn, exits, the Ride prompt and flight are unchanged; the body may overhang the kit like the R2.3
+	store bodies (WE_Visual* attributes carry its size to every check that reads them).
+	A vehicle that is not listed (and whose KitFamily is not mapped in its class module's KitFamilies) keeps today's
+	Part kit exactly. Enabled = false restores today's kits for every vehicle (kill switch).
+
+	WHERE THE BLUEPRINTS LIVE: one module per class so the class lanes never edit the same file:
+	  VehicleBodies/Ground.luau, VehicleBodies/Air.luau, VehicleBodies/Naval.luau (schema: VehicleBodies/Types.luau).
+	  Each returns { KitFamilies = {}, Families = { <key> = Blueprint }, Vehicles = { <VehicleConfig id> = Blueprint } }.
+	  A vehicle id must be listed in only one class module. A module that fails to load disables only its own class.
+
+	BUDGETS (hard caps, CLAUDE.md phone rules; checked at load by Validate and in tools/BuyPathStatic.py):
+	  at most Budget.MaxParts body parts (a Mirror part counts 2), at most Budget.MaxEmissive Neon parts each no longer
+	  than Budget.EmissiveMaxSize, no lights / SurfaceGuis / decals / text (the builder creates none), transparency at
+	  most Budget.MaxTransparency. A blueprint that fails a check is refused at spawn with one Output line: the vehicle
+	  keeps today's kit. ]]
+
+local Types = require(script.Types)
+
+export type PartSpec = Types.PartSpec
+export type RotorSpec = Types.RotorSpec
+export type Blueprint = Types.Blueprint
+export type ClassModule = Types.ClassModule
+export type Resolved = Types.Resolved
+
+local VehicleBodies = {
+	Enabled = true, -- kill switch: false = every vehicle keeps today's Part kit (no body, seats where they were)
+
+	Budget = {
+		MaxParts = 40, -- body parts per vehicle (Mirror = 2)
+		MaxEmissive = 2, -- Neon parts per body (lamps, nozzle glow) ...
+		EmissiveMaxSize = 1.5, -- ... each no longer than this (studs)
+		MaxLights = 0, -- Light instances per body (the builder makes none)
+		MaxTransparency = 0.9,
+		MinPartSize = 0.05,
+		MaxPartSize = 64,
+	},
+
+	-- a moved seat's centre stays at least this far inside the kit's collidable box (= VisualAssetConfig.BodySeatKitInset:
+	-- a seated rider never sits past the kit's nose or tail, inside a wall the kit touches)
+	SeatKitInset = 0.25,
+	-- label (owner nameplate; the HP bar sits under it) = body top + Base + PerStud x (top over the ground - EyeHeight),
+	-- as VisualAssetConfig.BodyLabelMargin; parts thinner than MinThickness studs as built (antennas, masts, gun barrels,
+	-- fins) do not raise the top. A blueprint's LabelHeight (body units over the ground line) overrides the rule.
+	LabelMargin = { Base = 1, PerStud = 0.4, EyeHeight = 4.5, MinThickness = 0.5 },
+	-- only big panels cast the vehicle's shadow (phones): a part whose longest side is at least this, unless Shadow is set
+	ShadowMinSize = 6,
+
+	-- colour roles (Part.Color); a blueprint's Palette overrides these per family / vehicle. Generic military paint:
+	-- olive, tan and greys with small accents. No insignia, flags or unit markings.
+	Palette = {
+		Body = Color3.fromRGB(84, 92, 62), -- olive drab
+		BodyDark = Color3.fromRGB(60, 66, 46),
+		Tan = Color3.fromRGB(160, 146, 108),
+		TanDark = Color3.fromRGB(124, 112, 82),
+		Grey = Color3.fromRGB(112, 118, 124), -- aircraft grey
+		GreyLight = Color3.fromRGB(148, 154, 160),
+		GreyDark = Color3.fromRGB(76, 81, 88),
+		Hull = Color3.fromRGB(104, 112, 118), -- naval grey
+		HullDark = Color3.fromRGB(72, 78, 84),
+		HullRed = Color3.fromRGB(118, 56, 48), -- anti-fouling under the waterline
+		Deck = Color3.fromRGB(86, 90, 88),
+		Trim = Color3.fromRGB(34, 36, 38), -- bumpers, intakes, gun mounts
+		Tyre = Color3.fromRGB(30, 30, 32),
+		Metal = Color3.fromRGB(88, 92, 96), -- gun metal, hubs, exhausts
+		Glass = Color3.fromRGB(58, 78, 92),
+		Canopy = Color3.fromRGB(78, 104, 118),
+		Light = Color3.fromRGB(226, 218, 184), -- lamp lens (not Neon)
+		LightRed = Color3.fromRGB(160, 44, 38),
+		Canvas = Color3.fromRGB(112, 110, 80),
+		Accent = Color3.fromRGB(184, 150, 60), -- small hazard / walkway marks only
+		Glow = Color3.fromRGB(255, 150, 70), -- engine nozzle (Emissive)
+	} :: { [string]: Color3 },
+
+	-- default material per colour role (else SmoothPlastic)
+	Materials = {
+		Body = Enum.Material.Metal,
+		BodyDark = Enum.Material.Metal,
+		Tan = Enum.Material.Metal,
+		TanDark = Enum.Material.Metal,
+		Grey = Enum.Material.Metal,
+		GreyLight = Enum.Material.Metal,
+		GreyDark = Enum.Material.Metal,
+		Hull = Enum.Material.Metal,
+		HullDark = Enum.Material.Metal,
+		HullRed = Enum.Material.Metal,
+		Deck = Enum.Material.DiamondPlate,
+		Metal = Enum.Material.Metal,
+		Tyre = Enum.Material.Rubber,
+		Glass = Enum.Material.Glass,
+		Canopy = Enum.Material.Glass,
+		Canvas = Enum.Material.Fabric,
+	} :: { [string]: Enum.Material },
+
+	-- default transparency per colour role (windows, canopies: the rider shows through)
+	Transparency = { Glass = 0.45, Canopy = 0.4 } :: { [string]: number },
+
+	-- client rotor spin (VehicleBodySpin): one RenderStepped loop; which rotors run is decided ScanHz times a second
+	-- (near the camera, the vehicle powered or still spinning down); per frame only Motor6D.Transform is written from
+	-- precomputed CFrames (Steps per 360 / Blades degrees: no allocation, no tree scan)
+	Spin = {
+		Enabled = true,
+		Tag = "WE_BodyRotor", -- CollectionService tag on each rotor's Motor6D
+		ScanHz = 4,
+		Range = 300, -- studs from the camera
+		MaxActive = 12, -- rotors turned per frame at most (the nearest first)
+		Steps = 24,
+		SpinUpSeconds = 2.5,
+		SpinDownSeconds = 4,
+	},
+
+	-- the class modules (VehicleBodies/<name>.luau), in lookup order
+	Classes = { "Ground", "Air", "Naval" } :: { string },
+}
+
+local SHAPES = { Block = true, Wedge = true, CornerWedge = true, Cylinder = true, Ball = true }
+local FACES = {
+	Front = true,
+	Back = true,
+	Left = true,
+	Right = true,
+	FrontDown = true,
+	BackDown = true,
+	LeftDown = true,
+	RightDown = true,
+}
+local AXES = { X = true, Y = true, Z = true }
+
+-- class modules, loaded once (a module that errors is left out with one Output line)
+local loaded: { [string]: ClassModule }? = nil
+local function classes(): { [string]: ClassModule }
+	local have = loaded
+	if have then
+		return have
+	end
+	local out: { [string]: ClassModule } = {}
+	for _, name in ipairs(VehicleBodies.Classes) do
+		local inst = script:FindFirstChild(name)
+		if inst and inst:IsA("ModuleScript") then
+			local ok, mod = pcall(require, inst)
+			if ok and typeof(mod) == "table" then
+				out[name] = mod :: any
+			else
+				warn(string.format("[VehicleBodies] %s.luau failed to load (%s): its vehicles keep today's kit", name, tostring(mod)))
+			end
+		end
+	end
+	loaded = out
+	return out
+end
+
+function VehicleBodies.Class(name: string): ClassModule?
+	return classes()[name]
+end
+
+local function merged(a: { [string]: any }?, b: { [string]: any }?): { [string]: any }
+	local out: { [string]: any } = {}
+	for k, v in pairs(a or {}) do
+		out[k] = v
+	end
+	for k, v in pairs(b or {}) do
+		out[k] = v
+	end
+	return out
+end
+
+--[[ The merged blueprint for one vehicle, or nil (+ why): not listed / Enabled = false / an unknown family.
+	Lookup: the vehicle's own entry in the first class module that lists it; else the family its KitFamily maps to in a
+	class module's KitFamilies. Parts: the entry's Parts, else the family's minus Remove, then Add. Seats / Rotors /
+	Muzzles / Palette: the family's, then the entry's over them. Scale: entry, else family, else 1; x KitScale when
+	FollowKitScale is set (entry, else family). ]]
+function VehicleBodies.Resolve(vehicleId: string, kitFamily: string?, kitScale: number?): (Resolved?, string?)
+	local cls = classes()
+	local entry: Blueprint? = nil
+	local className: string? = nil
+	local familyKey: string? = nil
+	for _, name in ipairs(VehicleBodies.Classes) do
+		local mod = cls[name]
+		local e = if mod and typeof(mod.Vehicles) == "table" then (mod.Vehicles :: any)[vehicleId] else nil
+		if typeof(e) == "table" then
+			entry, className = e :: Blueprint, name
+			familyKey = (e :: Blueprint).Extends
+			break
+		end
+	end
+	if entry == nil and kitFamily then
+		for _, name in ipairs(VehicleBodies.Classes) do
+			local mod = cls[name]
+			local fk = if mod and typeof(mod.KitFamilies) == "table" then (mod.KitFamilies :: any)[kitFamily] else nil
+			if typeof(fk) == "string" then
+				entry, className, familyKey = {} :: Blueprint, name, fk
+				break
+			end
+		end
+	end
+	if entry == nil or className == nil then
+		return nil, "not listed"
+	end
+	local e: Blueprint = entry
+	if e.Enabled == false then
+		return nil, "disabled"
+	end
+	local mod = cls[className]
+	local fam: Blueprint = {}
+	if familyKey ~= nil then
+		local f = if typeof(mod.Families) == "table" then (mod.Families :: any)[familyKey] else nil
+		if typeof(f) ~= "table" then
+			return nil, "unknown family " .. tostring(familyKey)
+		end
+		fam = f :: Blueprint
+	end
+	local parts: { PartSpec } = {}
+	if e.Parts ~= nil then
+		for _, p in ipairs(e.Parts) do
+			table.insert(parts, p)
+		end
+	else
+		local drop: { [string]: boolean } = {}
+		for _, n in ipairs(e.Remove or {}) do
+			drop[n] = true
+		end
+		for _, p in ipairs(fam.Parts or {}) do
+			if not (p.Name and drop[p.Name]) then
+				table.insert(parts, p)
+			end
+		end
+	end
+	for _, p in ipairs(e.Add or {}) do
+		table.insert(parts, p)
+	end
+	local scale = tonumber(e.Scale) or tonumber(fam.Scale) or 1
+	local follow = if e.FollowKitScale ~= nil then e.FollowKitScale else fam.FollowKitScale
+	if follow == true and typeof(kitScale) == "number" and kitScale > 0 then
+		scale *= kitScale
+	end
+	local keep: { string } = {}
+	for _, n in ipairs(fam.KeepKit or {}) do
+		table.insert(keep, n)
+	end
+	for _, n in ipairs(e.KeepKit or {}) do
+		table.insert(keep, n)
+	end
+	local showWheels = if e.ShowKitWheels ~= nil then e.ShowKitWheels else fam.ShowKitWheels
+	return {
+		Key = vehicleId,
+		Class = className,
+		Family = familyKey,
+		Scale = scale,
+		Palette = merged(merged(VehicleBodies.Palette, fam.Palette), e.Palette) :: any,
+		Parts = parts,
+		Seats = merged(fam.Seats, e.Seats) :: any,
+		Rotors = merged(fam.Rotors, e.Rotors) :: any,
+		Muzzles = merged(fam.Muzzles, e.Muzzles) :: any,
+		LabelHeight = tonumber(e.LabelHeight) or tonumber(fam.LabelHeight),
+		ShowKitWheels = showWheels == true,
+		KeepKit = keep,
+	}, nil
+end
+
+-- body parts after Mirror (a mirrored part counts 2)
+function VehicleBodies.Count(r: Resolved): number
+	local n = 0
+	for _, p in ipairs(r.Parts) do
+		n += if p.Mirror == true then 2 else 1
+	end
+	return n
+end
+
+local function isVec(v: any): boolean
+	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
+end
+
+--[[ Every problem with a resolved blueprint (empty = fine). seatNames: the seats the kit built (DriverSeat +
+	PassengerSeatN); each needs a Seats entry, or its rider would stay on the kit's roof. ]]
+function VehicleBodies.Validate(r: Resolved, seatNames: { string }?): { string }
+	local errs: { string } = {}
+	local B = VehicleBodies.Budget
+	local n = VehicleBodies.Count(r)
+	if n == 0 then
+		table.insert(errs, "no parts")
+	end
+	if n > B.MaxParts then
+		table.insert(errs, string.format("%d parts > Budget.MaxParts %d", n, B.MaxParts))
+	end
+	if not (r.Scale > 0 and r.Scale <= 4) then
+		table.insert(errs, "Scale " .. tostring(r.Scale) .. " outside (0, 4]")
+	end
+	local emissive = 0
+	local names: { [string]: boolean } = {}
+	for i, p in ipairs(r.Parts) do
+		local tag = string.format("part %d (%s)", i, tostring(p.Name))
+		local shape = p.Shape or "Block"
+		if not SHAPES[shape] then
+			table.insert(errs, tag .. ": unknown Shape " .. tostring(shape))
+		end
+		if not (isVec(p.Size) and isVec(p.At)) then
+			table.insert(errs, tag .. ": Size and At must be Vector3")
+		else
+			local s = p.Size
+			if math.min(s.X, s.Y, s.Z) < B.MinPartSize or math.max(s.X, s.Y, s.Z) > B.MaxPartSize then
+				table.insert(errs, tag .. ": Size outside [MinPartSize, MaxPartSize]")
+			end
+			if p.Emissive == true and math.max(s.X, s.Y, s.Z) * r.Scale > B.EmissiveMaxSize then
+				table.insert(errs, tag .. ": Emissive part longer than Budget.EmissiveMaxSize")
+			end
+		end
+		if p.Rot ~= nil and not isVec(p.Rot) then
+			table.insert(errs, tag .. ": Rot must be a Vector3 (degrees)")
+		end
+		if p.Face ~= nil and not FACES[p.Face] then
+			table.insert(errs, tag .. ": unknown Face " .. tostring(p.Face))
+		end
+		if p.Axis ~= nil and not AXES[p.Axis] then
+			table.insert(errs, tag .. ": unknown Axis " .. tostring(p.Axis))
+		end
+		local c = p.Color
+		if c ~= nil and typeof(c) ~= "Color3" and not (typeof(c) == "string" and (r.Palette :: any)[c] ~= nil) then
+			table.insert(errs, tag .. ": Color is not a Palette role or a Color3")
+		end
+		local t = p.Transparency
+		if t ~= nil and not (typeof(t) == "number" and t >= 0 and t <= B.MaxTransparency) then
+			table.insert(errs, tag .. ": Transparency outside [0, MaxTransparency]")
+		end
+		if p.Emissive == true then
+			emissive += if p.Mirror == true then 2 else 1
+		elseif p.Material == Enum.Material.Neon then
+			table.insert(errs, tag .. ": Neon only through Emissive = true (counted against Budget.MaxEmissive)")
+		end
+		if p.Rotor ~= nil and (r.Rotors :: any)[p.Rotor] == nil then
+			table.insert(errs, tag .. ": Rotor " .. tostring(p.Rotor) .. " has no Rotors entry")
+		end
+		if p.Name then
+			if names[p.Name] then
+				table.insert(errs, tag .. ": duplicate Name")
+			end
+			names[p.Name] = true
+		end
+	end
+	if emissive > B.MaxEmissive then
+		table.insert(errs, string.format("%d Emissive parts > Budget.MaxEmissive %d", emissive, B.MaxEmissive))
+	end
+	for key, rs in pairs(r.Rotors) do
+		if not (isVec(rs.Hub) and AXES[rs.Axis] and typeof(rs.Rpm) == "number" and rs.Rpm > 0 and typeof(rs.Blades) == "number" and rs.Blades >= 1) then
+			table.insert(errs, "Rotor " .. key .. ": needs Hub (Vector3), Axis (X / Y / Z), Rpm > 0, Blades >= 1")
+		end
+		local members = 0
+		for _, p in ipairs(r.Parts) do
+			if p.Rotor == key then
+				members += 1
+			end
+		end
+		if members == 0 then
+			table.insert(errs, "Rotor " .. key .. ": no part turns with it")
+		end
+	end
+	for hook, at in pairs(r.Muzzles) do
+		if not isVec(at) then
+			table.insert(errs, "Muzzle " .. tostring(hook) .. ": must be a Vector3")
+		end
+	end
+	for name, at in pairs(r.Seats) do
+		if not isVec(at) then
+			table.insert(errs, "Seat " .. tostring(name) .. ": must be a Vector3 (seat top)")
+		end
+	end
+	local seats: any = r.Seats
+	if seats.DriverSeat == nil then
+		table.insert(errs, "no Seats.DriverSeat")
+	end
+	local kitSeats: { string } = seatNames or {}
+	for _, s in ipairs(kitSeats) do
+		if seats[s] == nil then
+			table.insert(errs, "no Seats." .. s .. " (the kit built that seat)")
+		end
+	end
+	return errs
+end
+
+-- Every listed vehicle / mapped family resolved and checked (load-time check, tools, tests): { key = errors }
+function VehicleBodies.ValidateAll(): { [string]: { string } }
+	local out: { [string]: { string } } = {}
+	local seen: { [string]: string } = {}
+	for _, name in ipairs(VehicleBodies.Classes) do
+		local ClassConfig = classes()[name] -- a class module (blueprint config, not player data)
+		if ClassConfig then
+			for id in pairs(if typeof(ClassConfig.Vehicles) == "table" then ClassConfig.Vehicles else {}) do
+				if seen[id] then
+					out[id] = { "listed in " .. seen[id] .. " and " .. name }
+				else
+					seen[id] = name
+					local r, why = VehicleBodies.Resolve(id, nil, 1)
+					if r then
+						out[id] = VehicleBodies.Validate(r, nil)
+					elseif why ~= "disabled" then
+						out[id] = { tostring(why) }
+					end
+				end
+			end
+			for key in pairs(if typeof(ClassConfig.Families) == "table" then ClassConfig.Families else {}) do
+				local fam = (ClassConfig.Families :: any)[key]
+				local r: Resolved = {
+					Key = "family " .. key,
+					Class = name,
+					Family = key,
+					Scale = tonumber(fam.Scale) or 1,
+					Palette = merged(VehicleBodies.Palette, fam.Palette) :: any,
+					Parts = fam.Parts or {},
+					Seats = fam.Seats or {},
+					Rotors = fam.Rotors or {},
+					Muzzles = fam.Muzzles or {},
+					LabelHeight = fam.LabelHeight,
+					ShowKitWheels = fam.ShowKitWheels == true,
+					KeepKit = fam.KeepKit or {},
+				}
+				out["family " .. key] = VehicleBodies.Validate(r, nil)
+			end
+		end
+	end
+	return out
+end
+
+return VehicleBodies
diff --git a/src/ServerScriptService/Server/Modules/VehicleBodyBuilder.luau b/src/ServerScriptService/Server/Modules/VehicleBodyBuilder.luau
new file mode 100644
--- /dev/null
+++ b/src/ServerScriptService/Server/Modules/VehicleBodyBuilder.luau
@@ -0,0 +1,435 @@
+--!strict
+--[[ VKIT: builds a vehicle's Part body from Configs/VehicleBodies (server). Called by VehicleService.buildVehicleModel
+	on the unparented model, after the Part kit, the seats and the Creator Store body attempt, and only when no store
+	body went on (a store body always wins). Apply(model, def) -> true when a body was built.
+
+	What Apply does, in this order (nothing is changed until the blueprint resolved and passed Validate):
+	  1. resolve + validate the blueprint (VehicleBodies.Resolve / Validate); refused = one Output line, today's kit
+	  2. the ground line: the lowest point of the kit's collidable parts (tyres, gear, skids, hull) in the chassis frame;
+	     body-local (0, 0, 0) is there, under the chassis centre (Types.luau)
+	  3. builds every part into a Model "WE_PartBody": non-colliding, massless, Anchored false, CanTouch / CanQuery false
+	     (shots and rays hit the kit's hidden collidable volume exactly as before), welded to the Chassis; a rotor group
+	     is joined by one Motor6D (tagged VehicleBodies.Spin.Tag) that the client turns (VehicleBodySpin)
+	  4. the kit's plain visual parts (not collidable, no physics wheel, no seat, no weapon mount, nothing but welds under
+	     them) are destroyed with their welds; the Chassis, the collidable parts, the physics wheels (unless
+	     ShowKitWheels), the weapon mount parts and the seats stay and are hidden (Transparency 1)
+	  5. every seat moves to its blueprint seat top (kept SeatKitInset inside the kit's collidable box, as the R2.3 store
+	     bodies do), CanCollide off (the drive footprint stays the kit's)
+	  6. muzzles: Attachment "WE_Muzzle_<Hook>" on the Chassis (AirWeaponService uses it before the kit mount part)
+	  7. attributes: WE_PartBody, WE_LabelY, WE_VisualHalfLength / WE_VisualHalfWidth / WE_VisualTop (the same R2.3
+	     attributes the spawn, exit, Ride, prompt and gate checks already read for store bodies)
+	No Light, SurfaceGui, BillboardGui, Decal, Texture or effect is ever created here. ]]
+
+local CollectionService = game:GetService("CollectionService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+-- server module: the Rojo place ships ReplicatedStorage.Shared, so index it (no WaitForChild without a timeout)
+local Shared = ReplicatedStorage.Shared
+local VisualAssetConfig = require(Shared.Configs.VisualAssetConfig)
+
+local VB: any = nil
+do
+	local ok, m = pcall(function(): any
+		return require(Shared.Configs.VehicleBodies)
+	end)
+	if ok and typeof(m) == "table" then
+		VB = m
+	else
+		warn("[VehicleBodyBuilder] Configs/VehicleBodies failed to load: every vehicle keeps today's kit (" .. tostring(m) .. ")")
+	end
+end
+
+local Builder = {}
+
+local warned: { [string]: boolean } = {}
+local function warnOnce(key: string, msg: string)
+	if warned[key] then
+		return
+	end
+	warned[key] = true
+	warn("[VehicleBodyBuilder] " .. msg)
+end
+
+-- load-time check of every blueprint (one Output line per bad one; a bad one is also refused at spawn)
+if VB and VB.Enabled == true then
+	local ok, res = pcall(VB.ValidateAll)
+	if ok and typeof(res) == "table" then
+		for key, errs in pairs(res :: any) do
+			if #errs > 0 then
+				warnOnce(key, string.format("blueprint %s refused (today's kit stays): %s", key, table.concat(errs, "; ")))
+			end
+		end
+	end
+end
+
+local rad = math.rad
+local IDENTITY = CFrame.new()
+-- Wedge / CornerWedge: which way the slope faces (a Roblox wedge's slope faces its -Z and up; its tall face is +Z)
+local FACE_ROT: { [string]: CFrame } = {
+	Front = IDENTITY,
+	Back = CFrame.Angles(0, math.pi, 0),
+	Left = CFrame.Angles(0, rad(90), 0),
+	Right = CFrame.Angles(0, rad(-90), 0),
+	FrontDown = CFrame.Angles(0, 0, math.pi),
+	BackDown = CFrame.Angles(math.pi, 0, 0),
+	LeftDown = CFrame.Angles(0, rad(90), 0) * CFrame.Angles(0, 0, math.pi),
+	RightDown = CFrame.Angles(0, rad(-90), 0) * CFrame.Angles(0, 0, math.pi),
+}
+-- Cylinder: its length axis (a Roblox cylinder's length is its X)
+local AXIS_ROT: { [string]: CFrame } = {
+	X = IDENTITY,
+	Y = CFrame.Angles(0, 0, rad(90)),
+	Z = CFrame.Angles(0, rad(90), 0),
+}
+-- a CornerWedge mirrored in X is the same shape turned 90 deg about its Y with its X / Z sizes swapped (peak corner +X -Z)
+local CORNER_MIRROR = CFrame.Angles(0, rad(90), 0)
+
+-- the part's own Size for a box given in body axes, turned by `rot` (exact for the 90 deg helper turns)
+local function localSize(rot: CFrame, b: Vector3): Vector3
+	local r, u, l = rot.RightVector, rot.UpVector, rot.LookVector
+	return Vector3.new(
+		math.abs(r.X) * b.X + math.abs(r.Y) * b.Y + math.abs(r.Z) * b.Z,
+		math.abs(u.X) * b.X + math.abs(u.Y) * b.Y + math.abs(u.Z) * b.Z,
+		math.abs(l.X) * b.X + math.abs(l.Y) * b.Y + math.abs(l.Z) * b.Z
+	)
+end
+
+-- the rotation mirrored across X = 0 (M R M, M = diag(-1, 1, 1): still a proper rotation)
+local function mirrorRot(rot: CFrame): CFrame
+	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = rot:GetComponents()
+	return CFrame.new(0, 0, 0, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
+end
+
+-- a part's half extent in a frame (drawn size: a Cylinder is round on Y / Z, a Ball on all three)
+local function drawnSize(p: BasePart): Vector3
+	local s = p.Size
+	if p:IsA("Part") then
+		if p.Shape == Enum.PartType.Cylinder then
+			local d = math.min(s.Y, s.Z)
+			return Vector3.new(s.X, d, d)
+		elseif p.Shape == Enum.PartType.Ball then
+			local d = math.min(s.X, s.Y, s.Z)
+			return Vector3.new(d, d, d)
+		end
+	end
+	return s
+end
+
+local function extentIn(rel: CFrame, size: Vector3): Vector3
+	local h = size * 0.5
+	local r, u, l = rel.RightVector, rel.UpVector, rel.LookVector
+	return Vector3.new(
+		math.abs(r.X) * h.X + math.abs(u.X) * h.Y + math.abs(l.X) * h.Z,
+		math.abs(r.Y) * h.X + math.abs(u.Y) * h.Y + math.abs(l.Y) * h.Z,
+		math.abs(r.Z) * h.X + math.abs(u.Z) * h.Y + math.abs(l.Z) * h.Z
+	)
+end
+
+local function isSeat(d: Instance): boolean
+	return d:IsA("Seat") or d:IsA("VehicleSeat")
+end
+
+-- move a part welded to the chassis (unweld, place, weld again: a CFrame set on a welded part would move the car)
+local function reweldAt(chassis: BasePart, part: BasePart, cf: CFrame)
+	for _, holder in ipairs({ chassis :: Instance, part :: Instance }) do
+		for _, w in ipairs(holder:GetChildren()) do
+			if w:IsA("WeldConstraint") and ((w.Part0 == chassis and w.Part1 == part) or (w.Part0 == part and w.Part1 == chassis)) then
+				w:Destroy()
+			end
+		end
+	end
+	part.CFrame = cf
+	local w = Instance.new("WeldConstraint")
+	w.Part0 = chassis
+	w.Part1 = part
+	w.Parent = chassis
+end
+
+local function weld(a: BasePart, b: BasePart)
+	local w = Instance.new("WeldConstraint")
+	w.Part0 = a
+	w.Part1 = b
+	w.Parent = b
+end
+
+-- the kit parts AirWeaponService / the v79 weapon dress look up by name (VisualAssetConfig.VehicleWeapons Mount):
+-- kept (hidden) so their lookups still find them
+local function mountNames(): { [string]: boolean }
+	local out: { [string]: boolean } = {}
+	for _, ref in pairs((VisualAssetConfig :: any).VehicleWeapons or {}) do
+		if typeof(ref) == "table" and typeof(ref.Mount) == "string" then
+			out[ref.Mount] = true
+		end
+	end
+	out.Barrel = true -- VehicleService: the Armed 4x4 cue / muzzle flash
+	return out
+end
+
+local function onlyWelds(p: Instance): boolean
+	for _, c in ipairs(p:GetChildren()) do
+		if not (c:IsA("WeldConstraint") or c:IsA("Weld")) then
+			return false
+		end
+	end
+	return true
+end
+
+local function colorOf(spec: any, palette: { [string]: Color3 }): (Color3, string?)
+	local c = spec.Color
+	if typeof(c) == "Color3" then
+		return c, nil
+	end
+	local role = if typeof(c) == "string" then c else "Body"
+	return palette[role] or palette.Body or Color3.fromRGB(84, 92, 62), role
+end
+
+-- one body part (unparented), placed in the world from the body origin
+local function makePart(spec: any, mirrored: boolean, r: any, origin: CFrame): BasePart
+	local shape: string = spec.Shape or "Block"
+	local cls = if shape == "Wedge" then "WedgePart" elseif shape == "CornerWedge" then "CornerWedgePart" else "Part"
+	local p = Instance.new(cls) :: BasePart
+	local s: number = r.Scale
+	local rot: CFrame
+	local size: Vector3
+	if spec.Rot ~= nil then
+		local a: Vector3 = spec.Rot
+		rot = CFrame.Angles(rad(a.X), rad(a.Y), rad(a.Z))
+		size = spec.Size
+	else
+		rot = if shape == "Cylinder"
+			then AXIS_ROT[spec.Axis or "X"]
+			elseif shape == "Wedge" or shape == "CornerWedge" then FACE_ROT[spec.Face or "Front"]
+			else IDENTITY
+		size = localSize(rot, spec.Size)
+	end
+	local at: Vector3 = spec.At
+	if mirrored then
+		at = Vector3.new(-at.X, at.Y, at.Z)
+		rot = mirrorRot(rot)
+		if shape == "CornerWedge" then
+			rot = rot * CORNER_MIRROR
+			size = Vector3.new(size.Z, size.Y, size.X)
+		end
+	end
+	p.Name = (spec.Name or shape) .. (if mirrored then "_M" else "")
+	if shape == "Cylinder" then
+		(p :: Part).Shape = Enum.PartType.Cylinder
+	elseif shape == "Ball" then
+		(p :: Part).Shape = Enum.PartType.Ball
+	end
+	p.Size = size * s
+	p.CFrame = origin * CFrame.new(at * s) * rot
+	local color, role = colorOf(spec, r.Palette)
+	p.Color = color
+	if spec.Emissive == true then
+		p.Material = Enum.Material.Neon
+	elseif spec.Material ~= nil then
+		p.Material = spec.Material
+	else
+		p.Material = (role and VB.Materials[role]) or Enum.Material.SmoothPlastic
+	end
+	local t = spec.Transparency
+	if t == nil and role then
+		t = VB.Transparency[role]
+	end
+	p.Transparency = math.clamp(tonumber(t) or 0, 0, VB.Budget.MaxTransparency)
+	p.Anchored = false
+	p.CanCollide = false
+	p.CanQuery = false
+	p.CanTouch = false
+	p.Massless = true
+	p.TopSurface = Enum.SurfaceType.Smooth
+	p.BottomSurface = Enum.SurfaceType.Smooth
+	local sz = p.Size
+	p.CastShadow = if spec.Shadow ~= nil then spec.Shadow == true else math.max(sz.X, sz.Y, sz.Z) >= VB.ShadowMinSize
+	p:SetAttribute("WE_BodyPart", true)
+	return p
+end
+
+-- the seats the kit built (DriverSeat + PassengerSeatN, direct children)
+local function kitSeats(model: Model): { BasePart }
+	local out: { BasePart } = {}
+	for _, c in ipairs(model:GetChildren()) do
+		if isSeat(c) then
+			table.insert(out, c :: BasePart)
+		end
+	end
+	return out
+end
+
+--[[ Builds the Part body on `model` (unparented, straight from buildVehicleModel). Returns true when a body was built;
+	false (today's kit untouched) when VehicleBodies is off, the vehicle is not listed, or its blueprint fails a check. ]]
+function Builder.Apply(model: Model, def: any): boolean
+	if VB == nil or VB.Enabled ~= true then
+		return false
+	end
+	local chassis = model.PrimaryPart
+	if chassis == nil or model:FindFirstChild("WE_CatalogVisual") or model:FindFirstChild("WE_PartBody") then
+		return false -- no chassis, or already dressed (a store body always wins)
+	end
+	local id: string = def.Id or ""
+	local r, why = VB.Resolve(id, def.KitFamily, def.KitScale)
+	if r == nil then
+		if why ~= "not listed" and why ~= "disabled" then
+			warnOnce(id, string.format("%s: %s (today's kit stays)", id, tostring(why)))
+		end
+		return false
+	end
+	local seats = kitSeats(model)
+	local seatNames: { string } = {}
+	for _, st in ipairs(seats) do
+		table.insert(seatNames, st.Name)
+	end
+	local errs = VB.Validate(r, seatNames)
+	if #errs > 0 then
+		warnOnce(id, string.format("blueprint for %s refused (today's kit stays): %s", id, table.concat(errs, "; ")))
+		return false
+	end
+
+	-- 2. ground line + the kit's collidable box (chassis frame; seats never count)
+	local ccf = chassis.CFrame
+	local ground = math.huge
+	local kx, kz = 0, 0
+	for _, d in ipairs(model:GetDescendants()) do
+		if d:IsA("BasePart") and d.CanCollide and not isSeat(d) then
+			local rel = ccf:ToObjectSpace(d.CFrame)
+			local e = extentIn(rel, drawnSize(d))
+			ground = math.min(ground, rel.Position.Y - e.Y)
+			kx = math.max(kx, math.abs(rel.Position.X) + e.X)
+			kz = math.max(kz, math.abs(rel.Position.Z) + e.Z)
+		end
+	end
+	if ground == math.huge then
+		ground = -chassis.Size.Y * 0.5
+	end
+	local s: number = r.Scale
+	local origin = ccf * CFrame.new(0, ground, 0)
+
+	-- 3. the body parts (+ rotor joints)
+	local body = Instance.new("Model")
+	body.Name = "WE_PartBody"
+	local groups: { [string]: { BasePart } } = {}
+	local built: { BasePart } = {}
+	for _, spec in ipairs(r.Parts) do
+		for _, mirrored in ipairs(if spec.Mirror == true then { false, true } else { false }) do
+			local p = makePart(spec, mirrored, r, origin)
+			p.Parent = body
+			table.insert(built, p)
+			local key = spec.Rotor
+			if typeof(key) == "string" then
+				local g = groups[key]
+				if g == nil then
+					g = {}
+					groups[key] = g
+				end
+				table.insert(g, p)
+			else
+				weld(chassis, p)
+			end
+		end
+	end
+	local spin = VB.Spin
+	for key, g in pairs(groups) do
+		local rs = r.Rotors[key]
+		local root = g[1]
+		local hub = origin * CFrame.new(rs.Hub * s)
+		local m = Instance.new("Motor6D")
+		m.Name = "WE_Rotor_" .. key
+		m.Part0 = chassis
+		m.Part1 = root
+		m.C0 = ccf:ToObjectSpace(hub)
+		m.C1 = root.CFrame:ToObjectSpace(hub)
+		m:SetAttribute("WE_RotorRpm", rs.Rpm)
+		m:SetAttribute("WE_RotorAxis", rs.Axis)
+		m:SetAttribute("WE_RotorBlades", rs.Blades)
+		m.Parent = root
+		CollectionService:AddTag(m, spin.Tag)
+		for i = 2, #g do
+			weld(root, g[i])
+		end
+	end
+
+	-- 4. the kit's look goes (physics, seats and weapon mounts stay, hidden)
+	local keepVisible: { [string]: boolean } = {}
+	for _, n in ipairs(r.KeepKit) do
+		keepVisible[n] = true
+	end
+	local mounts = mountNames()
+	local gone: { [Instance]: boolean } = {}
+	for _, d in ipairs(model:GetDescendants()) do
+		if d:IsA("BasePart") and not d:IsDescendantOf(body) then
+			local wheel = d:GetAttribute("WE_PhysicsWheel") == true
+			local hubPart = string.match(d.Name, "^Hub%d+$") ~= nil and not d.CanCollide
+			if keepVisible[d.Name] or (r.ShowKitWheels and (wheel or hubPart)) then
+				continue
+			end
+			if d == chassis or d.CanCollide or wheel or isSeat(d) or mounts[d.Name] or not onlyWelds(d) then
+				d.Transparency = 1
+			else
+				gone[d] = true
+			end
+		end
+	end
+	for d in pairs(gone) do
+		d:Destroy()
+	end
+	-- the chassis' own welds to the removed parts go with them
+	for _, w in ipairs(chassis:GetChildren()) do
+		if w:IsA("WeldConstraint") and ((w.Part1 and gone[w.Part1]) or (w.Part0 and gone[w.Part0])) then
+			w:Destroy()
+		end
+	end
+
+	-- 5. seats into the body
+	local mx, mz = math.max(kx - VB.SeatKitInset, 0), math.max(kz - VB.SeatKitInset, 0)
+	for _, st in ipairs(seats) do
+		local top: Vector3 = r.Seats[st.Name]
+		local at = Vector3.new(math.clamp(top.X * s, -mx, mx), ground + top.Y * s, math.clamp(top.Z * s, -mz, mz))
+		if math.abs(at.X - top.X * s) > 1e-3 or math.abs(at.Z - top.Z * s) > 1e-3 then
+			st:SetAttribute("WE_BodySeatClamped", true) -- tools: the blueprint seat was past the kit's collidable box
+		end
+		local rel = ccf:ToObjectSpace(st.CFrame).Rotation
+		reweldAt(chassis, st, ccf * CFrame.new(at) * rel * CFrame.new(0, -st.Size.Y * 0.5, 0))
+		st.CanCollide = false
+		st.Transparency = 1
+	end
+
+	-- 6. muzzles (a MirrorX weapon alternates with the mirror point in AirWeaponService)
+	for hook, pt in pairs(r.Muzzles) do
+		local a = Instance.new("Attachment")
+		a.Name = "WE_Muzzle_" .. tostring(hook)
+		a.CFrame = CFrame.new(pt.X * s, ground + pt.Y * s, pt.Z * s)
+		a.Parent = chassis
+	end
+
+	-- 7. size / label attributes (chassis frame), measured on the built parts
+	local halfX, halfZ, top, labelTop = 0, 0, -math.huge, -math.huge
+	local minT = VB.LabelMargin.MinThickness
+	for _, p in ipairs(built) do
+		local rel = ccf:ToObjectSpace(p.CFrame)
+		local ds = drawnSize(p)
+		local e = extentIn(rel, ds)
+		halfX = math.max(halfX, math.abs(rel.Position.X) + e.X)
+		halfZ = math.max(halfZ, math.abs(rel.Position.Z) + e.Z)
+		top = math.max(top, rel.Position.Y + e.Y)
+		if math.min(ds.X, ds.Y, ds.Z) >= minT then
+			labelTop = math.max(labelTop, rel.Position.Y + e.Y)
+		end
+	end
+	if labelTop == -math.huge then
+		labelTop = top
+	end
+	local lm = VB.LabelMargin
+	local labelY = if r.LabelHeight ~= nil
+		then ground + r.LabelHeight * s
+		else labelTop + lm.Base + lm.PerStud * math.max(0, labelTop - ground - lm.EyeHeight)
+	model:SetAttribute("WE_LabelY", labelY)
+	model:SetAttribute("WE_VisualHalfLength", halfZ)
+	model:SetAttribute("WE_VisualHalfWidth", halfX)
+	model:SetAttribute("WE_VisualTop", top)
+	model:SetAttribute("WE_PartBody", r.Family or r.Key)
+	body.Parent = model
+	return true
+end
+
+return Builder
diff --git a/src/ServerScriptService/Server/Services/AirWeaponService.luau b/src/ServerScriptService/Server/Services/AirWeaponService.luau
--- a/src/ServerScriptService/Server/Services/AirWeaponService.luau
+++ b/src/ServerScriptService/Server/Services/AirWeaponService.luau
@@ -238,6 +238,16 @@
 	if chassis == nil then
 		return nil
 	end
+	-- VKIT: a Part body's own muzzle / bomb release point (Configs/VehicleBodies Muzzles -> Attachment WE_Muzzle_<Hook>
+	-- on the Chassis, chassis frame) wins over the kit mount part; a MirrorX weapon alternates with its mirror (x -> -x)
+	local own = chassis:FindFirstChild("WE_Muzzle_" .. tostring(def.Hook))
+	if own and own:IsA("Attachment") then
+		local lp = own.CFrame.Position
+		if def.MirrorX == true and podIndex % 2 == 0 then
+			lp = Vector3.new(-lp.X, lp.Y, lp.Z)
+		end
+		return chassis.CFrame:PointToWorldSpace(lp)
+	end
 	local hook = (VisualAssetConfig.VehicleWeapons :: any)[def.Hook]
 	local mountName = if typeof(hook) == "table" and typeof(hook.Mount) == "string" then hook.Mount else nil
 	local found = if mountName then model:FindFirstChild(mountName) else nil
diff --git a/src/ServerScriptService/Server/Services/VehicleService.luau b/src/ServerScriptService/Server/Services/VehicleService.luau
--- a/src/ServerScriptService/Server/Services/VehicleService.luau
+++ b/src/ServerScriptService/Server/Services/VehicleService.luau
@@ -53,6 +53,16 @@
 -- streaming2 S3 (F8): pre-fetches a far seat's area before the auto-sit move (RequestSpawn). A no-op while
 -- Workspace.StreamingEnabled is false. A module-table field for the same register-limit reason.
 VehicleService._StreamPrefetch = require(script.Parent.Parent.Modules.StreamPrefetch)
+-- VKIT: Part-built vehicle bodies (Configs/VehicleBodies, Modules/VehicleBodyBuilder). A module-table field for the same
+-- register-limit reason; a load failure leaves it nil and every vehicle keeps today's Part kit.
+VehicleService._PartBody = (function(): any
+	local ok, m = pcall(require, script.Parent.Parent.Modules.VehicleBodyBuilder)
+	if ok then
