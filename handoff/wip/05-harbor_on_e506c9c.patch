+    ax, ay, az = (_hbm.radians(v) for v in r["rot"])
+    cx, sx, cy, sy, cz, sz = _hbm.cos(ax), _hbm.sin(ax), _hbm.cos(ay), _hbm.sin(ay), _hbm.cos(az), _hbm.sin(az)
