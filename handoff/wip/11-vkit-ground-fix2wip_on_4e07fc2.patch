+    enc_cfg = _vg_field(_vg_field(_vg_block(vcc0, vcm.end() - 1) if vcm else "", "SeatFire") or "", "EnclosedSeats") or ""
+    g13_bad, g13_n = [], 0
+    g8_open, g8_bad, g8_enc, g8_enc_bad, g8_max = 0, [], 0, [], 0.0
+    # the seats the kit builds: DriverSeat + PassengerSeat1..min(seats - 1, 4) (VehicleService: the 4th number of V())
+    nseat_of = {a: int(float(b)) for a, b in re.findall(r'(\w+)\s*=\s*V\(\s*"\1"\s*,\s*"[^"]*"\s*,\s*"Ground"\s*,\s*"[^"]*"\s*,(?:\s*[-\d.]+\s*,){3}\s*([-\d.]+)\s*,', vc)}
+    # G1: every Ground vehicle has its own blueprint (none left on the old block kit)
+    missing = [v for v in ground_ids if v not in vehs]
