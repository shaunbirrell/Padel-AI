+            gpal[k] = (int(r), int(g), int(b))
+    lm = re.search(r"LabelMargin\s*=\s*\{\s*Base\s*=\s*([\d.]+)\s*,\s*PerStud\s*=\s*([\d.]+)\s*,\s*EyeHeight\s*=\s*([\d.]+)\s*,\s*MinThickness\s*=\s*([\d.]+)", init)
+    lbase, lper, leye, lmin = (float(x) for x in lm.groups()) if lm else (1.0, 0.4, 4.5, 0.5)
+    vcc0 = _vg_strip(read(VG_VCC) or "")
+    vcm = re.search(r"local VehicleCombatConfig\s*=\s*\{", vcc0)
