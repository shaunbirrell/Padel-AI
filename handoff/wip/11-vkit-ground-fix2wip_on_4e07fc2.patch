+
+def _vk_block(code: str, start: int) -> str:
+    """the text inside the brace that opens at code[start] ('{'), strings and nested braces respected"""
+    depth, i, n = 0, start, len(code)
+    while i < n:
+        c = code[i]
+        if c in "\"'":
+            j = i + 1
+            while j < n and code[j] != c:
+                j += 2 if code[j] == "\\" else 1
+            i = j + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return code[start + 1:i]
+        i += 1
+    return ""
+
+
+def _vk_field(body: str, key: str) -> str | None:
+    """body of `key = { ... }` at the top level of `body`"""
+    for m in re.finditer(r"(?<![\w.])" + key + r"\s*=\s*\{", body):
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") == 0:
+            return _vk_block(body, m.end() - 1)
+    return None
+
+
+def _vk_entries(body: str) -> dict:
+    """top-level `Name = { ... }` entries of a table body"""
+    out, i = {}, 0
+    for m in re.finditer(r"(\w+)\s*=\s*\{", body):
+        if m.start() < i:
+            continue
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") != 0:
+            continue
+        inner = _vk_block(body, m.end() - 1)
+        out[m.group(1)] = inner
+        i = m.end() + len(inner)
+    return out
+
+
+def _vk_parts(body: str | None) -> list[dict]:
+    """every P({ ... }) part line: name, mirror, emissive, size"""
+    parts = []
+    for m in re.finditer(r"\bP\(\{", body or ""):
+        spec = _vk_block(body, m.end() - 1)
+        nm = re.search(r'Name\s*=\s*"([^"]+)"', spec)
+        sz = re.search(r"Size\s*=\s*V\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)", spec)
+        parts.append({"name": nm.group(1) if nm else "?", "mirror": re.search(r"Mirror\s*=\s*true", spec) is not None,
+                      "emissive": re.search(r"Emissive\s*=\s*true", spec) is not None,
+                      "size": tuple(float(x) for x in sz.groups()) if sz else None})
+    return parts
+
+
+def _vk_num(body: str, key: str) -> float | None:
+    m = re.search(r"(?<![\w.])" + key + r"\s*=\s*([-\d.]+)", body or "")
+    return float(m.group(1)) if m else None
+
+
+def _vk_rules() -> None:
+    init = _db_luau_code(read(VK_INIT) or "")
+    if not init:
+        bad(f"vkit: {VK_INIT} missing")  # every rule below then fails on its own (nothing returns early)
+    root = re.search(r"local VehicleBodies\s*=\s*\{", init)
+    top = _vk_block(init, root.end() - 1) if root else ""
+    # 1. kill switch on the config's top level; the builder returns before building anything when it is off
+    if re.search(r"(?m)^\tEnabled\s*=\s*(true|false)\s*,", top):
+        ok("vkit: VehicleBodies.Enabled is the top-level kill switch")
+    else:
+        bad("vkit: VehicleBodies.Enabled (top level) missing")
+    bld = _db_luau_code(read(VK_BUILDER) or "")
+    m_apply = re.search(r"function Builder\.Apply\(model: Model, def: any\): boolean\n", bld)
