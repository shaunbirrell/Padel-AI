new file mode 100644
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/Client/Modules/VehicleBodySpin.luau
@@ -0,0 +1,202 @@
+--!strict
+--[[ VKIT: turns the rotors of Part-built vehicle bodies on this client (visual only, nothing is sent or replicated).
+	The server joins each rotor group to the chassis with one Motor6D tagged VehicleBodies.Spin.Tag and carrying
+	WE_RotorRpm / WE_RotorAxis ("X" | "Y" | "Z") / WE_RotorBlades (Modules/VehicleBodyBuilder). This module writes that
+	Motor6D's Transform; Transform never replicates, so every client spins its own copy and the server's stays still.
+
+	Cost (CLAUDE.md phone rules):
+	  * one PreSimulation connection; the rotors to turn are chosen Spin.ScanHz times a second (<= 10 Hz): within
+	    Spin.Range of the camera AND (the vehicle is powered: its WE_DriverUserId is set, or it is still spinning down),
+	    at most Spin.MaxActive, the nearest first;
+	  * per frame: numbers only, and Motor6D.Transform set from CFrames precomputed when the rotor streamed in
+	    (Spin.Steps per 360 / Blades degrees) and only when the step changes: no allocation, no tree scan;
+	  * rotors are found through CollectionService added / removed signals (StreamingEnabled-safe: a rotor that streams
+	    out is dropped, one that streams back in is added again), never by searching the workspace.
+	Spin up / down over Spin.SpinUpSeconds / SpinDownSeconds. VehicleBodies.Spin.Enabled = false: nothing turns. ]]
+
+local CollectionService = game:GetService("CollectionService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+
+-- Bootstrap only starts client modules once ReplicatedStorage.Shared is there (bounded wait, like the other modules)
+local Shared = ReplicatedStorage:WaitForChild("Shared", 60)
+
+local VehicleBodySpin = {}
+
+type Rotor = {
+	Motor: Motor6D,
+	Vehicle: Instance?,
+	Frames: { CFrame },
+	Steps: number,
+	Span: number, -- radians of one symmetric turn (2 pi / Blades)
+	Rate: number, -- radians per second at full power
+	Power: number, -- 0..1
+	Target: number, -- 1 while powered
+	Angle: number,
+	Index: number,
+	Dist: number,
+}
+
+local DEFAULTS = { Enabled = true, Tag = "WE_BodyRotor", ScanHz = 4, Range = 300, MaxActive = 12, Steps = 24, SpinUpSeconds = 2.5, SpinDownSeconds = 4 }
+local cfg: { [string]: any } = table.clone(DEFAULTS)
+local AXES: { [string]: Vector3 } = { X = Vector3.xAxis, Y = Vector3.yAxis, Z = Vector3.zAxis }
+
+local rotors: { [Motor6D]: Rotor } = {}
+local active: { Rotor } = {}
+local scanAcc = 0
+local started = false
+
+local function byDist(a: Rotor, b: Rotor): boolean
+	return a.Dist < b.Dist
+end
+
+-- the vehicle model a rotor belongs to (the nearest ancestor Model with VehicleId), found once
+local function vehicleOf(m: Instance): Instance?
+	local cur = m.Parent
+	while cur ~= nil and cur ~= Workspace do
+		if cur:IsA("Model") and cur:GetAttribute("VehicleId") ~= nil then
+			return cur
+		end
+		cur = cur.Parent
+	end
+	return nil
+end
+
+local function register(inst: Instance)
+	if not inst:IsA("Motor6D") or rotors[inst] ~= nil then
+		return
+	end
+	local rpm = tonumber(inst:GetAttribute("WE_RotorRpm")) or 0
+	local axisName = inst:GetAttribute("WE_RotorAxis")
+	local axis = if typeof(axisName) == "string" then AXES[axisName] else nil
+	local blades = math.max(1, math.floor(tonumber(inst:GetAttribute("WE_RotorBlades")) or 1))
+	if rpm <= 0 or axis == nil then
+		return
+	end
+	local steps = math.clamp(math.floor(tonumber(cfg.Steps) or 24), 4, 90)
+	local span = 2 * math.pi / blades
+	local frames: { CFrame } = table.create(steps)
+	for i = 0, steps - 1 do
+		frames[i + 1] = CFrame.fromAxisAngle(axis, span * i / steps)
+	end
+	rotors[inst] = {
+		Motor = inst,
+		Vehicle = vehicleOf(inst),
+		Frames = frames,
+		Steps = steps,
+		Span = span,
+		Rate = rpm * 2 * math.pi / 60,
+		Power = 0,
+		Target = 0,
+		Angle = 0,
+		Index = 0,
+		Dist = 0,
+	}
+end
+
+local function unregister(inst: Instance)
+	if inst:IsA("Motor6D") then
+		rotors[inst] = nil
+	end
+end
+
+-- which rotors turn this interval (Spin.ScanHz): near the camera and powered (or still spinning down), nearest first
+local function scan()
+	table.clear(active)
+	local cam = Workspace.CurrentCamera
+	if cam == nil then
+		return
+	end
+	local camPos = cam.CFrame.Position
+	local range = tonumber(cfg.Range) or 300
+	for motor, r in pairs(rotors) do
+		if motor.Parent == nil then
+			rotors[motor] = nil
+		else
+			local veh = r.Vehicle
+			if veh == nil or veh.Parent == nil then
+				veh = vehicleOf(motor)
+				r.Vehicle = veh
+			end
+			local uid = if veh then tonumber(veh:GetAttribute("WE_DriverUserId")) else nil
+			r.Target = if uid ~= nil and uid ~= 0 then 1 else 0
+			local p0 = motor.Part0
+			if p0 ~= nil and (r.Target > 0 or r.Power > 0) then
+				r.Dist = (p0.Position - camPos).Magnitude
+				if r.Dist <= range then
+					table.insert(active, r)
+				end
+			end
+		end
+	end
+	local cap = math.max(0, math.floor(tonumber(cfg.MaxActive) or 12))
+	if #active > cap then
+		table.sort(active, byDist)
+		for i = #active, cap + 1, -1 do
+			active[i] = nil
+		end
+	end
+end
+
+-- per frame: numbers only, and Transform from the precomputed frames when the step changes
+function VehicleBodySpin._Step(dt: number)
+	scanAcc += dt
+	if scanAcc >= 1 / math.clamp(tonumber(cfg.ScanHz) or 4, 1, 10) then
+		scanAcc = 0
+		scan()
+	end
+	local up = math.max(0.05, tonumber(cfg.SpinUpSeconds) or 2.5)
+	local down = math.max(0.05, tonumber(cfg.SpinDownSeconds) or 4)
+	for i = 1, #active do
+		local r = active[i]
+		if r.Power < r.Target then
+			r.Power = math.min(r.Target, r.Power + dt / up)
+		elseif r.Power > r.Target then
+			r.Power = math.max(r.Target, r.Power - dt / down)
+		end
+		if r.Power > 0 then
+			r.Angle = (r.Angle + r.Rate * r.Power * dt) % r.Span
+			local idx = math.floor(r.Angle / r.Span * r.Steps) % r.Steps + 1
+			if idx ~= r.Index then
+				r.Index = idx
+				r.Motor.Transform = r.Frames[idx]
+			end
+		end
+	end
+end
+
+-- test / tool access (headless stand-in): the tracked and the turning rotors
+function VehicleBodySpin._State(): ({ [Motor6D]: Rotor }, { Rotor })
+	return rotors, active
+end
+
+function VehicleBodySpin.Init()
+	if started then
+		return
+	end
+	local ok, VB = pcall(function(): any
+		return require(Shared.Configs.VehicleBodies)
+	end)
+	if ok and typeof(VB) == "table" and typeof(VB.Spin) == "table" then
+		for k, v in pairs(VB.Spin) do
+			cfg[k] = v
+		end
+	end
+	if cfg.Enabled ~= true then
+		return
+	end
+	started = true
+	local tag: string = cfg.Tag
+	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
+		register(inst)
+	end
+	CollectionService:GetInstanceAddedSignal(tag):Connect(register)
+	CollectionService:GetInstanceRemovedSignal(tag):Connect(unregister)
+	local ev: any = (RunService :: any).PreSimulation or RunService.Stepped
+	ev:Connect(function(a: number, b: number?)
+		VehicleBodySpin._Step(if typeof(b) == "number" then b else a)
+	end)
+end
+
+return VehicleBodySpin
