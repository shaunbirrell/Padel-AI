+def _vg_strip(src: str) -> str:
+    """Luau source without comments (strings kept)"""
+    out, i, n = [], 0, len(src)
+    while i < n:
+        c = src[i]
+        if c in "\"'":
+            j = i + 1
+            while j < n and src[j] != c:
+                j += 2 if src[j] == "\\" else 1
+            out.append(src[i:j + 1])
+            i = j + 1
+        elif src.startswith("--[[", i):
+            j = src.find("]]", i + 4)
+            i = n if j < 0 else j + 2
+        elif src.startswith("--", i):
+            j = src.find("\n", i)
+            i = n if j < 0 else j
+        else:
+            out.append(c)
+            i += 1
+    return "".join(out)
+
+
+def _vg_block(code: str, start: int) -> str:
+    depth, i, n = 0, start, len(code)
+    while i < n:
+        c = code[i]
+        if c in "\"'":
+            j = i + 1
+            while j < n and code[j] != c:
+                j += 2 if code[j] == "\\" else 1
+            i = j + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return code[start + 1:i]
+        i += 1
+    return ""
+
+
+def _vg_field(body: str, key: str) -> str | None:
+    for m in re.finditer(r"(?<![\w.])" + key + r"\s*=\s*\{", body):
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") == 0:
+            return _vg_block(body, m.end() - 1)
+    return None
+
+
+def _vg_entries(body: str) -> dict:
+    out, i = {}, 0
+    for m in re.finditer(r"(\w+)\s*=\s*\{", body):
+        if m.start() < i:
+            continue
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") != 0:
+            continue
+        inner = _vg_block(body, m.end() - 1)
+        out[m.group(1)] = inner
+        i = m.end() + len(inner)
+    return out
+
+
+def _vg_vec(spec: str, key: str):
+    m = re.search(r"(?<![\w.])" + key + r"\s*=\s*V\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)", spec)
+    return tuple(float(x) for x in m.groups()) if m else None
+
+
+def _vg_parts(body: str | None) -> list:
+    out = []
+    for m in re.finditer(r"\bP\(\{", body or ""):
+        spec = _vg_block(body, m.end() - 1)
+        nm = re.search(r'Name\s*=\s*"([^"]+)"', spec)
+        sh = re.search(r'Shape\s*=\s*"(\w+)"', spec)
+        out.append({"name": nm.group(1) if nm else "?", "spec": spec, "shape": sh.group(1) if sh else "Block",
+                    "size": _vg_vec(spec, "Size"), "at": _vg_vec(spec, "At"), "rot": _vg_vec(spec, "Rot")})
+    return out
+
+
+def _vg_half_xz(p: dict):
+    """half extents (x, z) of one part in body axes: Size is the body-axes box unless Rot is given (then the part's
+    own Size, a Cylinder's length on its X and round on Y / Z, turned by CFrame.Angles(rx, ry, rz))"""
+    sx, sy, sz = p["size"]
+    if p["rot"] is None:
+        return sx / 2, sz / 2
+    if p["shape"] == "Cylinder":
+        d = min(sy, sz)
+        sy, sz = d, d
+    ax, ay, az = (math.radians(v) for v in p["rot"])
+    cx, sxn, cy, syn, cz, szn = math.cos(ax), math.sin(ax), math.cos(ay), math.sin(ay), math.cos(az), math.sin(az)
+    # R = Rx(ax) * Ry(ay) * Rz(az), rows 0 (world x) and 2 (world z)
+    r0 = (cy * cz, -cy * szn, syn)
+    r2 = (-cx * syn * cz + sxn * szn, cx * syn * szn + sxn * cz, cx * cy)
+    h = (sx / 2, sy / 2, sz / 2)
+    return sum(abs(r0[k]) * h[k] for k in range(3)), sum(abs(r2[k]) * h[k] for k in range(3))
+
+
+def _vg_ext3(p: dict):
+    """half extents (x, y, z) of one part in body axes (as _vg_half_xz, with y)"""
+    sx, sy, sz = p["size"]
+    if p["rot"] is None:
+        return sx / 2, sy / 2, sz / 2
+    if p["shape"] == "Cylinder":
+        d = min(sy, sz)
+        sy, sz = d, d
+    ax, ay, az = (math.radians(v) for v in p["rot"])
+    cx, sxn, cy, syn, cz, szn = math.cos(ax), math.sin(ax), math.cos(ay), math.sin(ay), math.cos(az), math.sin(az)
+    r0 = (cy * cz, -cy * szn, syn)
+    r1 = (cx * szn + sxn * syn * cz, cx * cz - sxn * syn * szn, -sxn * cy)
+    r2 = (-cx * syn * cz + sxn * szn, cx * syn * szn + sxn * cz, cx * cy)
+    h = (sx / 2, sy / 2, sz / 2)
+    return tuple(sum(abs(r[k]) * h[k] for k in range(3)) for r in (r0, r1, r2))
+
+
+def _vg_min_drawn(p: dict) -> float:
+    sx, sy, sz = p["size"]
+    if p["shape"] == "Cylinder" and p["rot"] is not None:
+        return min(sx, min(sy, sz))
+    return min(sx, sy, sz)
+
+
+def _vg_palette(txt: str) -> dict:
+    out = {}
+    for k, r, g, b in re.findall(r"(\w+)\s*=\s*Color3\.fromRGB\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)", _vg_field(txt or "", "Palette") or ""):
+        out[k] = (int(r), int(g), int(b))
+    return out
+
+
+def _vg_ray_box(o, d, lo, hi, maxd: float) -> bool:
+    """slab test: the ray o + t d (0 < t <= maxd) meets the box [lo, hi]"""
+    t0, t1 = 1e-6, maxd
+    for k in range(3):
+        if abs(d[k]) < 1e-12:
+            if o[k] < lo[k] or o[k] > hi[k]:
+                return False
+            continue
+        a, b = (lo[k] - o[k]) / d[k], (hi[k] - o[k]) / d[k]
+        if a > b:
+            a, b = b, a
+        t0, t1 = max(t0, a), min(t1, b)
+        if t0 > t1:
+            return False
+    return True
+
+
+def _vg_head_blocked(parts: list, scale: float, top) -> float:
+    """share of 72 lines out of a seated head (seat top + 3.1) that end on an opaque Hit part (box extents) within 12"""
+    boxes = []
+    for p in parts:
+        if p["size"] is None or p["at"] is None or not re.search(r"\bHit\s*=\s*true\b", p["spec"]):
+            continue
+        if re.search(r'Color\s*=\s*"(Glass|Canopy)"', p["spec"]):
+            continue
+        ex, ey, ez = _vg_ext3(p)
+        x, y, z = p["at"]
+        for xc in ((x, -x) if "Mirror = true" in p["spec"] else (x,)):
+            boxes.append(((xc - ex) * scale, (y - ey) * scale, (z - ez) * scale, (xc + ex) * scale, (y + ey) * scale, (z + ez) * scale))
+    o = (top[0] * scale, top[1] * scale + 3.1, top[2] * scale)
+    n = hit = 0
+    for i in range(24):
+        a = i * math.pi / 12
+        for el in (-8.0, 0.0, 8.0):
+            e = math.radians(el)
+            d = (math.sin(a) * math.cos(e), math.sin(e), -math.cos(a) * math.cos(e))
+            n += 1
+            if any(_vg_ray_box(o, d, b[:3], b[3:], 12.0) for b in boxes):
+                hit += 1
+    return hit / n
+
+
+VG_GRID = 0.25
+
+
+def _vg_views(parts: list, pal: dict):
+    """side (z, y) and rear (x, y) silhouettes on a 0.25-stud grid, each cell the colour of the last part drawn over it
+    (glass left out: it shows what is behind it)"""
+    side, rear = {}, {}
+    for p in parts:
+        if p["size"] is None or p["at"] is None or re.search(r'Color\s*=\s*"(Glass|Canopy)"', p["spec"]):
+            continue
+        lit = re.search(r"Color\s*=\s*Color3\.fromRGB\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)", p["spec"])
+        role = re.search(r'Color\s*=\s*"(\w+)"', p["spec"])
+        col = tuple(int(x) for x in lit.groups()) if lit else pal.get(role.group(1) if role else "Body", pal.get("Body", (0, 0, 0)))
+        ex, ey, ez = _vg_ext3(p)
+        x, y, z = p["at"]
+        ys = range(int(math.floor((y - ey) / VG_GRID)), int(math.ceil((y + ey) / VG_GRID)))
+        for zz in range(int(math.floor((z - ez) / VG_GRID)), int(math.ceil((z + ez) / VG_GRID))):
+            for yy in ys:
+                side[(zz, yy)] = col
+        for xc in ((x, -x) if "Mirror = true" in p["spec"] else (x,)):
+            for xx in range(int(math.floor((xc - ex) / VG_GRID)), int(math.ceil((xc + ex) / VG_GRID))):
+                for yy in ys:
+                    rear[(xx, yy)] = col
+    return side, rear
+
+
+def _vg_apart(a: dict, b: dict) -> float:
+    """studs^2 where two silhouettes differ: one has body there and the other not, or both do in colours >= 40 apart"""
+    n = 0
+    for k in set(a) | set(b):
+        if (k in a) != (k in b) or math.dist(a[k], b[k]) >= 40:
+            n += 1
+    return n * VG_GRID * VG_GRID
+
+
+def _vg_rules() -> None:
+    code = _vg_strip(read(VG_GROUND) or "")
+    vc = _vg_strip(read(VG_VC) or "")
+    ground_ids = sorted(set(re.findall(r'(\w+)\s*=\s*V\(\s*"\1"\s*,\s*"[^"]*"\s*,\s*"Ground"', vc)))
+    kit_of = dict(re.findall(r'(\w+)\s*=\s*V\(\s*"\1"\s*,\s*"[^"]*"\s*,\s*"Ground"\s*,\s*"[^"]*"\s*,(?:\s*[-\d.]+\s*,){6}\s*"(\w+)"', vc))
+    vm0 = re.search(r"local VehicleConfig\s*=\s*\{", vc)
+    fam_x0 = _vg_field(_vg_field(_vg_field(_vg_block(vc, vm0.end() - 1) if vm0 else "", "Drive") or "", "Stability") or "", "DriveAtComXFamilies") or ""
+    fam_x1 = _vg_field(_vg_field(_vg_field(_vg_block(vc, vm0.end() - 1) if vm0 else "", "Drive") or "", "Stability") or "", "DriveAtComXPartBodyFamilies") or ""
+    com_x = set(re.findall(r"\b(\w+)\s*=\s*true", fam_x0)) | set(re.findall(r"\b(\w+)\s*=\s*true", fam_x1))
