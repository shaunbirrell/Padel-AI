+# Static pins (comments stripped with _db_luau_code): kill switch, budgets, per-vehicle part / emissive counts parsed
+# from the blueprint lines, what the builder may create, body part physics flags, store body first, weapons dress
+# skipped, the client spin loop's per-frame work, the bomb / muzzle point, blueprint keys = VehicleConfig ids.
+VK_DIR = "src/ReplicatedStorage/Shared/Configs/VehicleBodies"
+VK_INIT = VK_DIR + "/init.luau"
+VK_CLASSES = ("Ground", "Air", "Naval")
+VK_BUILDER = "src/ServerScriptService/Server/Modules/VehicleBodyBuilder.luau"
+VK_SPIN = "src/StarterPlayer/StarterPlayerScripts/Client/Modules/VehicleBodySpin.luau"
+VK_BOOT = "src/StarterPlayer/StarterPlayerScripts/Client/Bootstrap.client.luau"
+VK_VS = "src/ServerScriptService/Server/Services/VehicleService.luau"
+VK_AWS = "src/ServerScriptService/Server/Services/AirWeaponService.luau"
