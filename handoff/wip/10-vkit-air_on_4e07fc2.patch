+def _vka_angles(rx: float, ry: float, rz: float):
+    """CFrame.Angles(rx, ry, rz) in degrees = Rx * Ry * Rz"""
+    ax, ay, az = math.radians(rx), math.radians(ry), math.radians(rz)
+    c, s = math.cos, math.sin
+    return _vka_mul(_vka_mul([[1, 0, 0], [0, c(ax), -s(ax)], [0, s(ax), c(ax)]], [[c(ay), 0, s(ay)], [0, 1, 0], [-s(ay), 0, c(ay)]]),
+                    [[c(az), -s(az), 0], [s(az), c(az), 0], [0, 0, 1]])
+
+
+_VKA_FACE = {"Front": [(0, 0, 0)], "Back": [(0, 180, 0)], "Left": [(0, 90, 0)], "Right": [(0, -90, 0)],
+             "FrontDown": [(0, 0, 180)], "BackDown": [(180, 0, 0)], "LeftDown": [(0, 90, 0), (0, 0, 180)],
+             "RightDown": [(0, -90, 0), (0, 0, 180)]}
+_VKA_AXIS = {"X": (0, 0, 0), "Y": (0, 0, 90), "Z": (0, 90, 0)}
+
+
+def _vka_frame(p: dict, scale: float):
+    """(centre, R (columns = the part's own axes, body frame), half size) as VehicleBodyBuilder.makePart draws it"""
+    if p["rot"] is not None:
+        rot, size = _vka_angles(*p["rot"]), p["size"]
+    else:
+        if p["shape"] == "Cylinder":
+            rot = _vka_angles(*_VKA_AXIS.get(p["axis"], (0, 0, 0)))
+        elif p["shape"] in ("Wedge", "CornerWedge"):
+            rot = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
+            for a in _VKA_FACE.get(p["face"], [(0, 0, 0)]):
+                rot = _vka_mul(rot, _vka_angles(*a))
+        else:
+            rot = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
+        b = p["size"]
+        size = tuple(sum(abs(rot[j][i]) * b[j] for j in range(3)) for i in range(3))
+    return tuple(c * scale for c in p["at"]), rot, tuple(s * scale / 2 for s in size)
+
+
+def _vka_inside(p: dict, scale: float, pt) -> bool:
+    """is body point pt inside part p (its real shape: block, wedge, cylinder along its own X, ball)? A mirrored part
+    holds pt when the original holds pt mirrored (x -> -x)"""
+    if not p["size"] or not p["at"]:
+        return False
+    c, r, h = _vka_frame(p, scale)
+    for q in ([pt, (-pt[0], pt[1], pt[2])] if p["mirror"] else [pt]):
+        d = [q[i] - c[i] for i in range(3)]
+        lx, ly, lz = (sum(r[j][i] * d[j] for j in range(3)) for i in range(3))
+        e = 1e-6
+        if p["shape"] == "Ball":
+            rr = min(h)
+            if lx * lx + ly * ly + lz * lz <= rr * rr + e:
+                return True
+        elif p["shape"] == "Cylinder":
+            rr = min(h[1], h[2])
+            if abs(lx) <= h[0] + e and ly * ly + lz * lz <= rr * rr + e:
+                return True
+        elif abs(lx) <= h[0] + e and abs(ly) <= h[1] + e and abs(lz) <= h[2] + e:
+            if p["shape"] != "Wedge" or ly * h[2] <= lz * h[1] + e:
+                return True
+    return False
+
+
+def _vka_low_pitched(p: dict, scale: float, deg: float) -> float:
+    """lowest y of part p after the body turns `deg` nose-up about the X axis through the ground-line origin"""
+    c, r, h = _vka_frame(p, scale)
+    cs, sn = math.cos(math.radians(deg)), math.sin(math.radians(deg))
+    if p["shape"] == "Ball":
+        return c[1] * cs - c[2] * sn - min(h)
+    if p["shape"] == "Cylinder":
+        rr = min(h[1], h[2])
+        loc = [(sx * h[0], rr * math.cos(t * math.pi / 12), rr * math.sin(t * math.pi / 12)) for sx in (-1, 1) for t in range(24)]
+    elif p["shape"] == "Wedge":
+        loc = [(-h[0], -h[1], -h[2]), (h[0], -h[1], -h[2]), (h[0], -h[1], h[2]), (-h[0], -h[1], h[2]), (-h[0], h[1], h[2]), (h[0], h[1], h[2])]
+    else:
+        loc = [(sx * h[0], sy * h[1], sz * h[2]) for sx in (-1, 1) for sy in (-1, 1) for sz in (-1, 1)]
+    low = math.inf
+    for l in loc:
+        y = c[1] + sum(r[1][k] * l[k] for k in range(3))
+        z = c[2] + sum(r[2][k] * l[k] for k in range(3))
+        low = min(low, y * cs - z * sn)
+    return low
+
+
+def _vka_extent(p: dict) -> tuple:
+    """half extents in body axes (x, y, z) of one part as the builder draws it (Rot: Size is the part's own size)"""
+    sx, sy, sz = p["size"] or (0.0, 0.0, 0.0)
+    if p["shape"] == "Ball":
+        d = min(sx, sy, sz)
+        return (d / 2, d / 2, d / 2)
+    if p["rot"] is None:
+        return (sx / 2, sy / 2, sz / 2)
+    if p["shape"] == "Cylinder":
+        d = min(sy, sz)
+        sy = sz = d
+    r = _vka_angles(*p["rot"])
+    h = (sx / 2, sy / 2, sz / 2)
+    return tuple(sum(abs(r[i][k]) * h[k] for k in range(3)) for i in range(3))
+
+
+def _vka_aabb(p: dict, scale: float) -> tuple:
+    """the part's box in body axes (lo, hi), a mirrored part's pair included"""
+    c = tuple(v * scale for v in p["at"])
+    e = tuple(v * scale for v in _vka_extent(p))
+    lo, hi = [c[i] - e[i] for i in range(3)], [c[i] + e[i] for i in range(3)]
+    if p["mirror"]:
+        lo[0], hi[0] = min(lo[0], -hi[0]), max(hi[0], -lo[0])
+    return lo, hi
+
+
+def _vka_skin(parts: list, scale: float, seat) -> list:
+    """fix1b: the seated rider's arm and head boxes that poke out through the body skin: the box's outer face (away
+    from the seat's centre line, both sides) is sampled 3 x 3; a sample inside an opaque part is hidden, one inside a
+    see-through part is fine, one in no part is exposed when a ray from it (outward along X, up, forward or back) meets
+    no body part within VKA_SKIN_REACH. A face with hidden AND exposed samples (it crosses the skin), or 3+ of 9
+    exposed, pokes out."""
+    body = [(p, _vka_aabb(p, scale)) for p in parts if p["rotor"] is None]
+    out = []
+    sx, sy, sz = seat
+    for name, (cx, cy, cz), (hx, hy, hz) in VKA_SKIN_BOXES:
+        for side in (-1, 1):
+            fx = sx + side * (cx + hx * 0.9) if cx else sx + side * hx * 0.9
+            nh = ne = 0
+            for dy in (-0.8, 0.0, 0.8):
+                for dz in (-0.8, 0.0, 0.8):
+                    pt = (fx, sy + cy + dy * hy, sz + cz + dz * hz)
+                    inn = [p for p, (lo, hi) in body if all(lo[i] - 1e-6 <= pt[i] <= hi[i] + 1e-6 for i in range(3)) and _vka_inside(p, scale, pt)]
+                    if any(not p["see"] for p in inn):
+                        nh += 1
+                        continue
+                    if inn:
+                        continue
+                    blocked = False
+                    for ax, sg in ((0, side), (1, 1), (2, 1), (2, -1)):
+                        o1, o2 = [i for i in range(3) if i != ax]
+                        blocked = False
+                        for p, (lo, hi) in body:
+                            if not (lo[o1] <= pt[o1] <= hi[o1] and lo[o2] <= pt[o2] <= hi[o2]):
+                                continue
+                            a, b = (max(lo[ax], pt[ax]), min(hi[ax], pt[ax] + VKA_SKIN_REACH)) if sg > 0 else (max(lo[ax], pt[ax] - VKA_SKIN_REACH), min(hi[ax], pt[ax]))
+                            t = a
+                            while t <= b + 1e-9 and not blocked:
+                                q = list(pt)
+                                q[ax] = t
+                                blocked = _vka_inside(p, scale, tuple(q))
+                                t += 0.1
+                            if blocked:
+                                break
+                        if not blocked:
+                            break
+                    if not blocked:
+                        ne += 1
+            if (nh and ne) or ne >= 3:
+                out.append(f"{name}{'R' if side > 0 else 'L'}({ne}/9 out)")
+    return out
+
+
+def _vka_rules() -> None:
+    air = _db_luau_code(read(VKA_AIR) or "") if "_db_luau_code" in globals() else (read(VKA_AIR) or "")
