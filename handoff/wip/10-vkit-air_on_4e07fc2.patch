+--[[ vkit air fix1: while I drive a vehicle with a zoom cap (Laws.ChaseZoomFor), my CameraMaxZoomDistance is lowered
+	to it (never raised; never under CameraMinZoomDistance). The camera module re-clamps the current zoom when the
+	property changes, and pinch / wheel zoom still works inside the cap. stopDrive puts the old value back. ]]
+local function applyChaseZoom(d: Drive)
+	local cap = Laws.ChaseZoomFor(d.Mode, d.Model:GetAttribute("WE_VisualHalfLength"), ZOOM, d.Model:GetAttribute("WE_PartBody") ~= nil)
+	if cap == nil then
+		return
+	end
+	pcall(function()
+		local plr = localPlayer()
+		local saved = zoomSaved or plr.CameraMaxZoomDistance
+		zoomSaved = saved
+		plr.CameraMaxZoomDistance = math.max(math.min(cap, saved), plr.CameraMinZoomDistance)
+	end)
+end
+
+local function restoreChaseZoom()
+	local saved = zoomSaved
+	zoomSaved = nil
+	if saved ~= nil then
+		pcall(function()
+			localPlayer().CameraMaxZoomDistance = saved
+		end)
+	end
+end
+
+--[[ vkit air fix1b: a PASSENGER (a Seat, not the DriverSeat) of a vehicle whose mode is in ChaseZoom.PassengerModes gets
+	the driver's cap (Laws.ChaseZoomFor, the same PartBodyOnly rule) as his CLOSEST zoom (CameraMinZoomDistance, never
+	over his own CameraMaxZoomDistance): Roblox's classic camera starts 12.5 studs behind his head, inside a big
+	aircraft's fuselage or tail. restorePassengerZoom puts his own value back (standing up, the driver seat, death, a
+	new character). One sit / stand = one call: nothing per frame. ]]
+local paxZoomSaved: number? = nil
+
+local function restorePassengerZoom()
+	local saved = paxZoomSaved
+	paxZoomSaved = nil
+	if saved ~= nil then
+		pcall(function()
+			localPlayer().CameraMinZoomDistance = saved
+		end)
+	end
+end
+
+local function applyPassengerZoom(seat: BasePart)
+	restorePassengerZoom()
+	local pm: any = ZOOM.PassengerModes
+	local model = vehicleModelOf(seat)
+	if typeof(pm) ~= "table" or model == nil then
+		return
+	end
+	local mode = model:GetAttribute("WE_DriveMode")
+	if typeof(mode) ~= "string" or pm[mode] ~= true then
+		return
+	end
+	local cap = Laws.ChaseZoomFor(mode, model:GetAttribute("WE_VisualHalfLength"), ZOOM, model:GetAttribute("WE_PartBody") ~= nil)
+	if cap == nil then
+		return
+	end
+	pcall(function()
+		local plr = localPlayer()
+		local saved = plr.CameraMinZoomDistance
+		plr.CameraMinZoomDistance = math.max(saved, math.min(cap, plr.CameraMaxZoomDistance))
+		paxZoomSaved = saved
+	end)
+end
