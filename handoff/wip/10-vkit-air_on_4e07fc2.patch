+def _vka_block(code: str, start: int) -> str:
+    depth, i, n = 0, start, len(code)
+    while i < n:
+        c = code[i]
+        if c in "\"'":
+            j = i + 1
+            while j < n and code[j] != c:
+                j += 2 if code[j] == "\\" else 1
+            i = j + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return code[start + 1:i]
+        i += 1
+    return ""
+
+
+def _vka_field(body: str, key: str) -> str | None:
+    for m in re.finditer(r"(?<![\w.])" + key + r"\s*=\s*\{", body or ""):
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") == 0:
+            return _vka_block(body, m.end() - 1)
+    return None
+
+
+def _vka_entries(body: str | None) -> dict:
+    out, i = {}, 0
+    for m in re.finditer(r"(\w+)\s*=\s*\{", body or ""):
+        if m.start() < i:
+            continue
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") != 0:
+            continue
+        inner = _vka_block(body, m.end() - 1)
+        out[m.group(1)] = inner
+        i = m.end() + len(inner)
+    return out
+
+
+def _vka_entries_keys(body: str | None) -> list:
+    return re.findall(r"(?m)^\s*(\w+)\s*=\s*V\(", body or "")
+
+
+def _vka_vec(spec: str, key: str):
+    m = re.search(r"(?<!\w)" + key + r"\s*=\s*V\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)", spec)
+    return tuple(float(x) for x in m.groups()) if m else None
+
+
+def _vka_parts(body: str | None) -> list:
+    out = []
+    for m in re.finditer(r"\bP\(\{", body or ""):
+        spec = _vka_block(body, m.end() - 1)
+        nm = re.search(r'Name\s*=\s*"([^"]+)"', spec)
+        sh = re.search(r'Shape\s*=\s*"(\w+)"', spec)
+        ro = re.search(r'Rotor\s*=\s*"(\w+)"', spec)
+        fa = re.search(r'Face\s*=\s*"(\w+)"', spec)
+        ax = re.search(r'Axis\s*=\s*"(\w+)"', spec)
+        out.append({"name": nm.group(1) if nm else "?", "shape": sh.group(1) if sh else "Block",
+                    "size": _vka_vec(spec, "Size"), "at": _vka_vec(spec, "At"), "rot": _vka_vec(spec, "Rot"),
+                    "face": fa.group(1) if fa else "Front", "axis": ax.group(1) if ax else "X",
+                    "mirror": re.search(r"Mirror\s*=\s*true", spec) is not None, "rotor": ro.group(1) if ro else None,
+                    "hit": re.search(r"(?<!\w)Hit\s*=\s*true", spec) is not None,
+                    "see": re.search(r'Color\s*=\s*"(Glass|Canopy)"', spec) is not None
+                    or float((re.search(r"Transparency\s*=\s*([\d.]+)", spec) or [0, "0"])[1]) >= 0.3})
+    return out
+
+
+def _vka_mul(a, b):
+    return [[sum(a[i][k] * b[k][j] for k in range(3)) for j in range(3)] for i in range(3)]
