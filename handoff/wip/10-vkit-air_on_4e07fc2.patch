+--[[ vkit air fix1: the chase-camera zoom cap for a vehicle of `mode` whose body is `halfLength` studs from its pivot
+	(WE_VisualHalfLength, set by a Part body or a store body), or nil = no cap (not listed, switched off, no body).
+	Roblox's VehicleCamera starts 3 x the radius of the whole welded assembly back, so a body 2 to 3 x the kit's size
+	pushes the camera 2 to 3 x further away and the aircraft looks SMALLER on a phone than the old kit did.
+	Cap = clamp(halfLength x LengthMul + Add, Min, Max) (VehicleConfig.Drive.ChaseZoom). vkit ground fix1: a mode listed
+	as a table ({ LengthMul, Add, Min, Max }) uses its own numbers (a key it leaves out: the shared one); true = shared.
+	vkit air fix1b: a mode in cfg.PartBodyOnly gets a cap only when partBody is true (the model carries WE_PartBody), so
+	a store body (the live Recon Plane) or VehicleBodies.Enabled = false keeps v83's camera. ]]
+function Laws.ChaseZoomFor(mode: string, halfLength: any, cfg: any, partBody: boolean?): number?
+	if typeof(cfg) ~= "table" or cfg.Enabled ~= true or typeof(cfg.Modes) ~= "table" then
+		return nil
+	end
+	local m: any = cfg.Modes[mode]
+	if m ~= true and typeof(m) ~= "table" then
+		return nil
+	end
+	local pbo: any = cfg.PartBodyOnly
+	if typeof(pbo) == "table" and pbo[mode] == true and partBody ~= true then
+		return nil
+	end
+	if typeof(halfLength) ~= "number" or halfLength ~= halfLength or halfLength <= 0 then
+		return nil
+	end
+	local p: any = if typeof(m) == "table" then m else {}
+	local lo = tonumber(p.Min) or tonumber(cfg.Min) or 22
+	local hi = math.max(tonumber(p.Max) or tonumber(cfg.Max) or 48, lo)
+	local mul = tonumber(p.LengthMul) or tonumber(cfg.LengthMul) or 1
+	local add = tonumber(p.Add) or tonumber(cfg.Add) or 14
+	return math.clamp(halfLength * mul + add, lo, hi)
+end
