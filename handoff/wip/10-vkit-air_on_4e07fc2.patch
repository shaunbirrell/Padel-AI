+def _vka_rules_fix1c() -> None:
+    code = (lambda t: _db_luau_code(t) if "_db_luau_code" in globals() else t)
+    air = code(read(VKA_AIR) or "")
+    vc = read(VKA_VC) or ""
+    kit = {}
+    for m in re.finditer(r'(?m)^\t\t(\w+) = V\(\s*"(\w+)",\s*"[^"]*",\s*"Air",\s*"[^"]*",(?:\s*[\d.]+,){6}\s*"(\w+)"', vc):
+        if m.group(1) == m.group(2):
+            kit[m.group(1)] = m.group(3)
+    m = re.search(r"local \w+: Types\.ClassModule\s*=\s*\{", air)
+    body = _vka_block(air, m.end() - 1) if m else ""
+    fams = _vka_entries(_vka_field(body, "Families"))
+    vehs = _vka_entries(_vka_field(body, "Vehicles"))
+    sunk, nseat, fam_of, short = [], 0, {}, []
+    for vid in sorted(vehs):
+        vb = vehs[vid]
+        ext = re.search(r'Extends\s*=\s*"(\w+)"', vb)
+        fam = fams.get(ext.group(1)) if ext else None
+        if ext:
+            fam_of.setdefault(ext.group(1), []).append(vid)
+        parts = _vka_parts(_vka_field(vb, "Parts") if _vka_field(vb, "Parts") is not None else _vka_field(fam or "", "Parts"))
+        rem = set(re.findall(r'"(\w+)"', _vka_field(vb, "Remove") or ""))
+        parts = [p for p in parts if p["name"] not in rem] + _vka_parts(_vka_field(vb, "Add"))
+        parts = [p for p in parts if p["at"] and p["size"]]
+        sm = re.search(r"(?<![\w.])Scale\s*=\s*([-\d.]+)", vb) or re.search(r"(?<![\w.])Scale\s*=\s*([-\d.]+)", fam or "")
+        scale = float(sm.group(1)) if sm else 1.0
+        # A: seat tops on the kit (the hips footprint over the collidable kit boxes under it)
+        seats = {}
+        for src in (fam or "", vb):
+            for sk in _vka_entries_keys(_vka_field(src, "Seats")):
+                sv = _vka_vec(_vka_field(src, "Seats") or "", sk)
+                if sv:
+                    seats[sk] = sv
+        boxes = VKA_KIT_COL.get(vid, ())
+        for sk, sv in sorted(seats.items()):
+            nseat += 1
+            sx, sy, sz = (c * scale for c in sv)
+            top = max((b[3] for b in boxes for dx, dz in VKA_SEAT_PAD if b[0] <= sx + dx <= b[1] and b[4] <= sz + dz <= b[5]), default=None)
+            if top is not None and sy < top - VKA_SEAT_SINK - 1e-6:
+                sunk.append(f"{vid}.{sk} top {sy:.2f} < kit {top:.2f}")
+        # C: the heavies' drawn length (z extent of the parts)
+        k = kit.get(vid, "")
+        need = VKA_HEAVY_MIN_LEN.get(k)
+        if need and parts:
+            zlo = min((p["at"][2] - _vka_extent(p)[2]) * scale for p in parts)
+            zhi = max((p["at"][2] + _vka_extent(p)[2]) * scale for p in parts)
+            if zhi - zlo < need - 1e-6:
+                short.append(f"{vid} {zhi - zlo:.1f} < {need:g}")
+    if nseat and not sunk and len(VKA_KIT_COL) >= len(kit):
+        ok(f"vkit air fix1c: all {nseat} seat tops sit on the collidable kit part under them (at most {VKA_SEAT_SINK:g} under its top)")
+    else:
+        bad(f"vkit air fix1c: seat tops sunk into a collidable kit part (a rider who jumps out starts inside it): {sunk or 'no seats parsed'}")
+    shared = {f: v for f, v in fam_of.items() if len(v) > 1}
+    if vehs and not shared and len(fam_of) == len(vehs):
+        ok(f"vkit air fix1c: every aircraft has its own family ({len(fam_of)} families for {len(vehs)} aircraft: no recolour of another)")
+    else:
+        bad(f"vkit air fix1c: aircraft sharing a family (the same airframe recoloured): {shared or 'no bodies'}")
+    if vehs and not short and any(v in VKA_HEAVY_MIN_LEN for v in kit.values()):
+        ok("vkit air fix1c: every transport body is at least 40 long and every bomber body at least 30 (the heavies are not fighter-sized)")
+    else:
+        bad(f"vkit air fix1c: heavies drawn too short: {short or 'no heavies parsed'}")
+    # B: spawn spots (config + VehicleService + builder)
