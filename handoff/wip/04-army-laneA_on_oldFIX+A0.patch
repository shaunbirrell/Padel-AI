+	FOLLOW additions: the vehicle hold (a unit more than Move.VehicleHoldStuds away stands while the owner drives faster
+	than Move.VehicleHoldSpeed; FIX regroups it when he stops) and the path step (armyFollowPath: a unit stuck for
+	Move.PathAfterSeconds walks the squad path to the owner; FIX's RECOVER then waits RecoverAfterPathSeconds more).
+	New and re-formed units appear on their gate slot in GUARD / RETURN (armySpawnAt). The payload gains Mode / Status
+	(armyStatusFill), pushed on a change at most once per Ui.PushMinGapSeconds (armyAfterPass). ]]
+local ArmyGuard = require(script.Parent.Parent.Modules.ArmyGuard)
+local ArmyPath = require(script.Parent.Parent.Modules.ArmyPath)
+
+local guardHum: Humanoid? = nil -- this pass's GUARD target for the squad being thought (nearest to its gate)
+local guardRoot: BasePart? = nil
+local guardCands: CandList = { Hum = {}, Root = {}, Dist = {}, N = 0 } -- ...and the visible-target fallback list
+local armyProbeRec: Probe? = nil -- one FollowPath body probe per pass for army moves (built on first use)
+local armyProbeAt = -math.huge
+local armyStats = { Pushes = 0, Paths = 0, SlotRecovers = 0, VehicleHolds = 0, HomeIn = 0, HomeOut = 0, GuardEnds = 0 }
+
+local function armyCfgBlock(key: string): { [string]: any }
+	local b = (ArmyCfg :: any)[key]
+	return if typeof(b) == "table" then b else {}
+end
+
+local function armyNum(block: { [string]: any }, key: string, default: number): number
+	local v = tonumber(block[key])
+	return if v ~= nil and v == v then v else default
+end
+
+local function armyLive(player: Player): boolean
+	return ArmyCfg.LiveFor("Army", player.UserId) == true
+end
+
+local function armyUnitState(unit: SquadUnit): ArmyUnit
+	local au = unit.Army
+	if au == nil then
+		local fresh: ArmyUnit = { PathOn = false, PathSerial = 0, PathIdx = 1, PathSince = 0, StraightAt = -math.huge, StraightOk = false, PathWant = false, AtSlot = false }
+		unit.Army = fresh
+		return fresh
+	end
+	return au
+end
+
+-- a new army state for a live owner: HOME at once when he stands in his plot (or has no character yet but a plot:
+-- he spawns there), so a fresh army forms on the gate line
+local function armyNew(player: Player): ArmySquad
+	local plot = ownPlotId(player)
+	local root = characterRoot(player)
+	local home = plot ~= nil and (root == nil or ArmyGuard.OwnerHome(plot, root.Position, armyNum(armyCfgBlock("Home"), "InsideMargin", 2)))
+	return { Live = true, Mode = if home then "Return" else "Follow", Home = home, InSince = nil, OutSince = nil, GuardOrder = false, Plot = plot, PushAt = -math.huge, SentMode = nil, SentStatus = nil }
+end
+
+-- the live flag once per pass / sync: a player who stops being live (Rollout changed) goes back to HEAD + FIX + A0
+local function armyEnsure(player: Player, st: SquadState): ArmySquad?
+	if not armyLive(player) or ArmyCfg.Guard == nil then
+		if st.Army ~= nil then
+			st.Army = nil
+			if st.Order == "Guard" then
+				st.Order = "Retreat" -- the HEAD equivalent
+			end
+		end
+		return nil
+	end
+	local a = st.Army
+	if a == nil then
+		a = armyNew(player)
+		st.Army = a
+	end
+	return a
+end
+
+-- the squad mode this pass (never "Return" / "Guard" without a plot)
+local function armyModeOf(st: SquadState, a: ArmySquad): string
+	if st.Order == "Hold" then
+		return "Hold"
+	elseif st.Order == "Attack" then
+		return "Attack"
+	elseif a.Plot ~= nil and (st.Order == "Guard" or a.Home) then
+		if a.Mode == "Guard" or a.Mode == "Return" then
+			return a.Mode
+		end
+		return "Return"
+	end
+	return "Follow"
+end
+
+-- a mode change: the FOLLOW / recover / path state of every unit starts over
+local function armyModeChanged(st: SquadState)
+	for _, u in ipairs(st.Units) do
+		u.FarSince = nil
+		u.PlotId = nil
+		u.ProgPos = nil
+		u.ProgDir = nil
+		u.StopHeld = false
+		u.Goal = nil
+		u.DeferSince = nil
+		resetChase(u)
+		local au = u.Army
+		if au then
+			au.PathOn = false
+			au.PathWant = false
+			au.AtSlot = false
+			au.StraightAt = -math.huge
+		end
+	end
+end
+
+-- HOME / OUT with hysteresis (Home.*): HOME after EnterSeconds inside his square with InsideMargin to spare; OUT after
+-- LeaveSeconds beyond it by OutsideMargin; the band between keeps the last value. No root (dead): unchanged. Turning
+-- HOME ends a GUARD order (back to automatic FOLLOW; no SetOrder, so the novice shield is untouched).
+local function armyHome(player: Player, st: SquadState, a: ArmySquad, proot: BasePart?, now: number)
+	a.Plot = ownPlotId(player)
+	local plot = a.Plot
+	if plot == nil then
+		a.Home = false
+		a.InSince = nil
+		a.OutSince = nil
+		return
+	end
+	if proot == nil then
+		return
+	end
+	local H = armyCfgBlock("Home")
+	local pos = proot.Position
+	if a.Home then
+		a.InSince = nil
+		if not ArmyGuard.OwnerHome(plot, pos, -armyNum(H, "OutsideMargin", 14)) then
+			local since = a.OutSince or now
+			a.OutSince = since
+			if now - since >= armyNum(H, "LeaveSeconds", 1) - 1e-6 then
+				a.Home = false
+				a.OutSince = nil
+				armyStats.HomeOut += 1
+			end
+		else
+			a.OutSince = nil
+		end
+	else
+		a.OutSince = nil
+		if ArmyGuard.OwnerHome(plot, pos, armyNum(H, "InsideMargin", 2)) then
+			local since = a.InSince or now
+			a.InSince = since
+			if now - since >= armyNum(H, "EnterSeconds", 2) - 1e-6 then
+				a.Home = true
+				a.InSince = nil
+				armyStats.HomeIn += 1
+				if a.GuardOrder or st.Order == "Guard" then
+					a.GuardOrder = false
+					st.Order = "Follow" -- a GUARD order lasts until his next HOME, then automatic
+					armyStats.GuardEnds += 1
+				end
+			end
+		else
+			a.InSince = nil
+		end
+	end
+end
+
+-- one body probe per pass for army moves (the think loop builds its own only when a squad follows)
+local function armyProbe(now: number): Probe?
+	if armyProbeAt ~= now or armyProbeRec == nil then
+		local cfg = followPathCfg()
+		armyProbeRec = if cfg then buildProbe(cfg) else nil
+		armyProbeAt = now
+	end
+	return armyProbeRec
+end
+
+-- the next point of the squad path toward `pathGoal` for this unit (nil: no usable path yet / any more)
+local function armyPathPoint(player: Player, unit: SquadUnit, au: ArmyUnit, pathGoal: Vector3, now: number): Vector3?
+	local P = armyCfgBlock("Path")
+	if P.Enabled ~= true then
+		au.PathOn = false
+		return nil
+	end
+	local pos = unit.Root.Position
+	local key = player.UserId
+	local status, rec = ArmyPath.Request(key, unit.Id, pos, pathGoal, now, if au.PathOn then au.PathSerial else nil)
+	if status ~= "ok" or rec == nil or rec.Status ~= "ok" or rec.N == 0 then
+		au.PathOn = false
+		return nil
+	end
+	if not au.PathOn or au.PathSerial ~= rec.Serial then
+		au.PathOn = true
+		au.PathSerial = rec.Serial
+		au.PathIdx = ArmyPath.NearestIndex(rec, pos)
+		au.PathSince = now
+		armyStats.Paths += 1
+	end
+	if now - au.PathSince > armyNum(armyCfgBlock("Move"), "PathHoldSeconds", 12) then
+		au.PathOn = false
+		return nil
+	end
+	local reach = armyNum(P, "ReachStuds", 3)
+	local idx = au.PathIdx
+	while idx <= rec.N and flatDist(rec.Points[idx], pos) <= reach do
+		idx += 1
+	end
+	au.PathIdx = idx
+	if idx > rec.N then
+		au.PathOn = false
+		return nil
+	end
+	return rec.Points[idx]
+end
+
+-- moveUnit (SPEC §8): straight when the goal is near or the body probe to it is clear (re-checked at most once per
+-- Move.StraightRecheckSeconds); a blocked line walks the squad path toward `pathGoal` once one is ready (asked for
+-- here: one request per squad per Path.SquadMinGapSeconds, server-wide budget in ArmyPath), else straight meanwhile
+-- (the stuck rule takes over). unit.Goal = the point walked to (the stuck check measures progress toward it).
+local function moveUnit(player: Player, unit: SquadUnit, goal: Vector3, pathGoal: Vector3, now: number)
+	local au = armyUnitState(unit)
+	local M = armyCfgBlock("Move")
+	local pos = unit.Root.Position
+	if flatDist(pos, goal) <= armyNum(M, "StraightStuds", 6) then
+		au.PathOn = false
+		unit.Goal = goal
+		unit.Humanoid:MoveTo(goal)
+		return
+	end
+	if now - au.StraightAt >= armyNum(M, "StraightRecheckSeconds", 1) then
+		au.StraightAt = now
+		local probe = armyProbe(now)
+		au.StraightOk = probe == nil or bodyClear(pos, goal, probe)
+	end
+	if au.StraightOk and not au.PathWant then
+		au.PathOn = false
+		unit.Goal = goal
+		unit.Humanoid:MoveTo(goal)
+		return
+	end
+	local wp = armyPathPoint(player, unit, au, pathGoal, now)
+	if wp ~= nil then
+		unit.Goal = wp
+		unit.Humanoid:MoveTo(wp)
+		return
+	end
+	unit.Goal = goal
+	unit.Humanoid:MoveTo(goal)
+end
+
+-- the stuck clock for GUARD / RETURN (the FOLLOW one is FIX's, in recoverUnit): seconds without ProgressStuds made
+-- toward the goals walked (trackGoal notes them after each move)
+local function armyStuckFor(unit: SquadUnit, now: number): number
+	local lp, dir = unit.ProgPos, unit.ProgDir
+	if lp ~= nil and dir ~= nil then
+		local moved = unit.Root.Position - lp
+		unit.ProgSum += moved.X * dir.X + moved.Z * dir.Z
+		if unit.ProgSum >= armyNum(armyCfgBlock("Move"), "ProgressStuds", 2) then
+			unit.ProgSince = now
+			unit.ProgSum = 0
+		end
+	else
+		unit.ProgSince = now
+		unit.ProgSum = 0
+	end
+	return now - unit.ProgSince
+end
+
+-- RECOVER onto the gate slot (GUARD / RETURN: far or stuck): FIX's limits (Recover.CooldownSeconds per unit,
+-- PerOwnerPerSecond searches, NoPlayerWithin, ground under the spot), then one PivotTo of the same unit. Never
+-- Destroy, never SyncArmy. Returns true when it moved the unit.
+local function armyRecoverSlot(player: Player, st: SquadState, unit: SquadUnit, slotCf: CFrame, why: string, now: number): boolean
+	local rc = recoverCfg()
+	if rc == nil then
+		return false
+	end
+	local cooldown = cfgNum(rc, "CooldownSeconds", 8)
+	if now - unit.RecoverAt < cooldown then
+		return false
+	end
+	if now - st.RecoverWinAt >= 1 then
+		st.RecoverWinAt = now
+		st.RecoverWinN = 0
+	end
+	if st.RecoverWinN >= math.max(1, math.floor(cfgNum(rc, "PerOwnerPerSecond", 4))) then
+		return false
+	end
+	local proot = characterRoot(player)
+	if proot == nil then
+		return false -- he is dead: they hold (he is HOME again on respawn)
+	end
+	st.RecoverWinN += 1
+	local probe = recoverProbe(player, proot, now)
+	local spot = slotCf.Position
+	local gy = recoverGround(spot, rc, probe, now)
+	if gy == nil then
+		unit.RecoverAt = now - cooldown + math.min(cooldown, cfgNum(rc, "MissRetrySeconds", 2))
+		return false
+	end
+	local at = CFrame.lookAt(Vector3.new(spot.X, gy + cfgNum(rc, "StandHeight", 3.2), spot.Z), Vector3.new(spot.X, gy + cfgNum(rc, "StandHeight", 3.2), spot.Z) + slotCf.LookVector)
+	if nearOtherPlayer(player, at.Position, cfgNum(rc, "NoPlayerWithin", 25)) then
+		unit.RecoverAt = now - cooldown + 1 -- another player stands there: look again in 1 s
+		return false
+	end
+	unit.RecoverAt = now
+	local okM, errM = pcall(function()
+		unit.Model:PivotTo(at) -- the same unit, moved: never Destroy, never a new model
+		unit.Root.AssemblyLinearVelocity = Vector3.zero
+		local gyro = unit.Root:FindFirstChild("NPCFaceGyro")
+		if gyro and gyro:IsA("BodyGyro") then
+			gyro.CFrame = at
+		end
+	end)
+	if not okM then
+		warn("[WAR EMPIRE] SquadOrdersService: army slot move failed: " .. tostring(errM))
+		return false
+	end
+	resetChase(unit)
+	unit.AimRoot = nil
+	unit.AimHum = nil
+	unit.FarSince = nil
+	unit.DeferSince = nil
+	unit.Goal = nil
+	unit.ProgPos = nil
+	unit.ProgDir = nil
+	unit.ProgSum = 0
+	unit.ProgSince = now
+	unit.PlotId = nil
+	local au = armyUnitState(unit)
+	au.PathOn = false
+	au.PathWant = false
+	unit.Humanoid:MoveTo(at.Position)
+	armyStats.SlotRecovers += 1
+	noteRecover(player, st, why, rc, now)
+	return true
+end
+
+-- GUARD: one shot check per unit (line of sight + the unit hit curve, no kill pay); the target is the pass's gate pick
+local function armyGuardShot(player: Player, unit: SquadUnit, now: number): boolean
+	local th, tr = guardHum, guardRoot
+	if th == nil or tr == nil or th.Health <= 0 or tr.Parent == nil then
+		return false
+	end
+	if not losCheckDue(unit, now) then
+		return false
+	end
+	local sh, sr, rays = pickShot(player, unit, th, tr, OrdersConfig.AttackRange or 55, guardCands, true)
+	if sh and sr then
+		unit.LosBlocked = false
+		local firedAt = unit.LastFireAt
+		local hit = unitShoot(player, unit, sh, now, false) -- guarding the gate pays nothing (no AFK farm)
+		unitShotFx(player, unit, sr, firedAt, hit)
+		faceYaw(unit.Root, sr.Position)
+		return true
+	elseif rays > 0 then
+		losBlockedFor(unit, now)
+	end
+	return false
+end
+
+-- GUARD / RETURN for one unit; true = handled (a live owner's FOLLOW unit returns false after the vehicle hold check)
+local function armyThinkUnit(player: Player, st: SquadState, a: ArmySquad, unit: SquadUnit, playerRoot: BasePart?, now: number): boolean
+	local mode = a.Mode
+	if mode == "Follow" then
+		local M = armyCfgBlock("Move")
+		if
+			playerRoot ~= nil
+			and st.Seated
+			and st.OwnerSpeed > armyNum(M, "VehicleHoldSpeed", 20)
+			and flatDist(unit.Root.Position, playerRoot.Position) > armyNum(M, "VehicleHoldStuds", 150)
+		then
+			-- vehicle hold: no cross-country walk into walls; FIX's regroup brings it when he stops
+			setSpeed(unit, OrdersConfig.UnitWalkSpeed or 14)
+			unit.Goal = nil
+			unit.ProgPos = nil
+			unit.ProgDir = nil
+			unit.Humanoid:MoveTo(unit.Root.Position)
+			armyStats.VehicleHolds += 1
+			return true
+		end
+		return false
+	end
+	if mode ~= "Guard" and mode ~= "Return" then
+		return false
+	end
+	local plot = a.Plot
+	if plot == nil then
+		return false
+	end
+	local slotCf = ArmyGuard.SlotCFrame(plot, unit.Slot)
+	if slotCf == nil then
+		return false
+	end
+	local au = armyUnitState(unit)
+	local G = armyCfgBlock("Guard")
+	local M = armyCfgBlock("Move")
+	setSpeed(unit, OrdersConfig.UnitWalkSpeed or 14)
+	local pos = unit.Root.Position
+	local slotPos = slotCf.Position
+	local d = flatDist(pos, slotPos)
+	if d > armyNum(G, "ReturnWalkMaxStuds", 400) then
+		au.AtSlot = false
+		armyRecoverSlot(player, st, unit, slotCf, "regroup", now) -- far: regroup on the line
+		return true
+	end
+	if d <= armyNum(G, "ArriveStuds", 2) then
+		au.AtSlot = true
+		au.PathOn = false
+		au.PathWant = false
+		unit.Goal = nil
+		unit.ProgPos = nil
+		unit.ProgDir = nil
+		unit.Humanoid:MoveTo(pos)
+		if not armyGuardShot(player, unit, now) then
+			faceYaw(unit.Root, pos + slotCf.LookVector * 8)
+		end
+		return true
+	end
+	au.AtSlot = d <= 6
+	-- the stuck rule: PathAfterSeconds -> one squad path; RecoverAfterPathSeconds more -> onto its slot
+	local stuck = if recoverCfg() ~= nil then armyStuckFor(unit, now) else 0
+	local pathAfter = armyNum(M, "PathAfterSeconds", 3)
+	au.PathWant = stuck >= pathAfter
+	if stuck >= pathAfter + armyNum(M, "RecoverAfterPathSeconds", 6) then
+		if armyRecoverSlot(player, st, unit, slotCf, "stuck", now) then
+			return true
+		end
+	end
+	-- the goal: inside the plot, the gate lane first (GateIn, then GateOut through the gate); outside, its slot
+	local goal = slotPos
+	local pathGoal = slotPos
+	local lx, lz = ArmyGuard.ToLocal(plot, pos)
+	if lx ~= nil and lz ~= nil and ArmyGuard.OwnerHome(plot, pos, 0) and not ArmyGuard.PastWall(lz) then
+		local gin, gout = ArmyGuard.GateIn(plot), ArmyGuard.GateOut(plot)
+		if gin and gout then
+			if math.abs(lx) <= 6 and lz >= 140 then
+				goal = gout -- in the gate lane: out through the gate
+			else
+				goal = gin
+			end
+			pathGoal = gin
+		end
+	elseif lx ~= nil and lz ~= nil and not ArmyGuard.PastWall(lz) then
+		-- outside the square but not in front of it (the rear, the sides, the sea side): round the outside of the walls by
+		-- fixed corner points (behind: to the rear corner; beside: to the front corner), then along the front to its slot
+		local cx, cz = ArmyGuard.CornerOut(lx, lz)
+		local c = ArmyGuard.LocalPoint(plot, cx, cz)
+		if c then
+			goal = c
+			pathGoal = c
+		end
+	end
+	moveUnit(player, unit, goal, pathGoal, now)
+	faceYaw(unit.Root, unit.Goal or goal)
+	armyGuardShot(player, unit, now) -- shoot what is in range and in sight on the way; never chase
+	trackGoal(unit, recoverCfg())
+	return true
+end
+
+-- FOLLOW path step (after FIX's follow / escort move): a unit stuck for Move.PathAfterSeconds (recoverUnit sets
+-- PathWant) walks the squad path toward the owner until its line to its goal is clear again
+local function armyFollowPath(player: Player, unit: SquadUnit, playerRoot: BasePart, now: number)
+	local au = unit.Army
+	if au == nil or not (au.PathWant or au.PathOn) then
+		return
+	end
+	local target = unit.Goal
+	if target == nil then
+		au.PathOn = false
+		return
+	end
+	local M = armyCfgBlock("Move")
+	if au.PathOn and now - au.StraightAt >= armyNum(M, "StraightRecheckSeconds", 1) then
+		au.StraightAt = now
+		local probe = armyProbe(now)
+		if probe ~= nil and bodyClear(unit.Root.Position, target, probe) then
+			au.PathOn = false -- its line is clear again: FIX's follow walk
+			au.PathWant = false
+			return
+		end
+	end
+	local wp = armyPathPoint(player, unit, au, playerRoot.Position, now)
+	if wp ~= nil then
+		unit.Goal = wp
+		unit.Humanoid:MoveTo(wp)
+	end
+end
+
+-- once per pass per live squad, before its units think: HOME / OUT, the mode, the gate pick
+local function armyPass(player: Player, st: SquadState, proot: BasePart?, now: number)
+	local a = armyEnsure(player, st)
+	guardHum, guardRoot = nil, nil
+	if a == nil then
+		return
+	end
+	armyHome(player, st, a, proot, now)
+	local mode = armyModeOf(st, a)
+	if (mode == "Guard" or mode == "Return") ~= (a.Mode == "Guard" or a.Mode == "Return") then
+		armyModeChanged(st)
+	end
+	a.Mode = mode
+	if (mode == "Guard" or mode == "Return") and a.Plot ~= nil then
+		local centre = ArmyGuard.GateCentre(a.Plot :: number)
+		if centre then
+			local r = armyNum(armyCfgBlock("Guard"), "EngageRadius", 70)
+			guardHum, guardRoot = nearestHostile(centre, r, CombatFairnessConfig.EscortIgnoreCalm == true, player, guardCands, r)
+		end
+	end
+end
+
+-- after the units thought: RETURN -> GUARD once every living unit stands on its slot (and back if one is pushed off),
+-- then a coalesced push of a changed Mode / Status (at most one per Ui.PushMinGapSeconds)
+local function armyAfterPass(player: Player, st: SquadState, now: number)
+	guardHum, guardRoot = nil, nil
+	candReset(guardCands) -- hold no reference to the NPCs between passes
+	local a = st.Army
+	if a == nil then
+		return
+	end
+	if a.Mode == "Guard" or a.Mode == "Return" then
+		local all = true
+		for _, u in ipairs(st.Units) do
+			if u.Alive and u.Humanoid.Health > 0 and not (u.Army ~= nil and u.Army.AtSlot) then
+				all = false
+				break
+			end
+		end
+		a.Mode = if all then "Guard" else "Return"
+	end
+	local status = SquadOrdersService._ArmyStatus(a.Mode)
+	if (a.Mode ~= a.SentMode or status ~= a.SentStatus) and now - a.PushAt >= armyNum(armyCfgBlock("Ui"), "PushMinGapSeconds", 0.5) then
+		pushState(player)
+	end
+end
+
+-- a new / re-formed unit of a live owner in GUARD / RETURN appears on its gate slot (nil: the HEAD placement)
+local function armySpawnAt(player: Player, st: SquadState, slot: number): CFrame?
+	local a = armyEnsure(player, st)
+	if a == nil or a.Plot == nil or not (a.Home or st.Order == "Guard") then
+		return nil
+	end
+	local cf = ArmyGuard.SlotCFrame(a.Plot :: number, slot)
+	return if cf then cf + Vector3.new(0, 2, 0) else nil
+end
+
+-- the status line text of a mode (ArmyConfig.Text.Status; device-neutral)
+function SquadOrdersService._ArmyStatus(mode: string): string
+	local T = (ArmyCfg :: any).Text
+	local s = if typeof(T) == "table" and typeof(T.Status) == "table" then T.Status[mode] else nil
+	return if typeof(s) == "string" then s else string.upper(mode)
+end
+
+armyStatusFill = function(_player: Player, st: SquadState?, payload: { [string]: any })
+	local a = if st then st.Army else nil
+	if a == nil or not a.Live then
+		return -- not live: the HEAD payload, unchanged
+	end
+	local status = SquadOrdersService._ArmyStatus(a.Mode)
+	payload.Mode = a.Mode
+	payload.Status = status
+	payload.Target = nil -- lane C (ATTACK) fills it
+	a.SentMode = a.Mode
+	a.SentStatus = status
+	a.PushAt = os.clock()
+	armyStats.Pushes += 1
+end
+
+-- army lane A: counters (a copy; tests and the Studio command bar)
+function SquadOrdersService._ArmyStats(): { [string]: any }
+	local out: { [string]: any } = table.clone(armyStats)
+	out.Path = ArmyPath.Stats()
+	return out
+end
