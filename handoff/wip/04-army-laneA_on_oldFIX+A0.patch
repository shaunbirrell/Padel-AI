diff --git a/src/ServerScriptService/Server/Modules/ArmyGuard.luau b/src/ServerScriptService/Server/Modules/ArmyGuard.luau
new file mode 100644
--- /dev/null
+++ b/src/ServerScriptService/Server/Modules/ArmyGuard.luau
@@ -0,0 +1,130 @@
+--!strict
+--[[
+	ArmyGuard (army lane A, SPEC-ARMY-FINAL §3.1 / §4.4 / §6.1): pure plot-frame math for the gate army.
+	  • SlotCFrame(plotId, slot)       — the unit's spot in the GUARD line outside the front gate, facing out.
+	  • OwnerHome(plotId, pos, margin) — is `pos` inside the plot square shrunk by `margin` studs (a negative margin
+	    grows it)? HOME = OwnerHome(plot, root, Home.InsideMargin); OUT = not OwnerHome(plot, root, -Home.OutsideMargin).
+	  • GateCentre / GateIn / GateOut  — the middle of the GUARD line and the gate lane just inside / outside the wall.
+	  • CornerOut(x, z)                — the next corner point round the outside of the walls (behind / beside the plot).
+	Plot-local studs: +Z = out of the front gate, +X = right when walking out (PlotFrame's frame). No instances, no
+	yields, no rays: safe under StreamingEnabled and in any test.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared: any = ReplicatedStorage:WaitForChild("Shared", 30) -- bounded (CLAUDE.md); present at server start
+local ArmyConfig = require(Shared.Configs.ArmyConfig)
+local BaseConfig = require(Shared.Configs.BaseConfig)
+local PlotFrame = require(Shared.Util.PlotFrame)
+
+local ArmyGuard = {}
+
+local GATE_WALL_Z = 158.5 -- plot-local Z of the front wall line (the gate lane crosses it at X = 0)
+local GATE_IN_Z = 146 -- a unit inside the plot walks here first (in the gate lane, clear of the barrier)
+local GATE_OUT_Z = 168 -- ...then out through the gate to here, then sideways to its slot
+local CORNER_OUT = 10 -- studs outside the square: the corner points a unit behind / beside the plot walks round
+
+local function guardCfg(): { [string]: any }
+	local g = (ArmyConfig :: any).Guard
+	return if typeof(g) == "table" then g else {}
+end
+
+local function half(): number
+	return BaseConfig.PlotSize.X * 0.5
+end
+
+-- plot-local (x, z) of GUARD slot `slot` (1-based; slots past #SlotX stand RankStepZ further out per rank)
+function ArmyGuard.SlotLocal(slot: number): (number, number)
+	local g = guardCfg()
+	local xs: { any } = if typeof(g.SlotX) == "table" then g.SlotX else { -30, 30, -36, 36, -42, 42, -48, 48 }
+	local n = math.max(1, #xs)
+	local s = math.max(1, math.floor(slot))
+	local x = tonumber(xs[((s - 1) % n) + 1]) or 0
+	local rank = (s - 1) // n
+	local z = (tonumber(g.SlotZ) or 170) + rank * (tonumber(g.RankStepZ) or 6)
+	return x, z
+end
+
+-- the plot frame at root height (pad height + Guard.StandHeight)
+local function frame(plotId: number): CFrame?
+	local pos = PlotFrame.PlotPosition(plotId)
+	if pos == nil then
+		return nil
+	end
+	return PlotFrame.PlotCFrame(pos) + Vector3.new(0, tonumber(guardCfg().StandHeight) or 3, 0)
+end
+
+-- world CFrame of a GUARD slot, looking out of the gate (plot-local +Z); nil for an unknown plot
+function ArmyGuard.SlotCFrame(plotId: number, slot: number): CFrame?
+	local f = frame(plotId)
+	if f == nil then
+		return nil
+	end
+	local x, z = ArmyGuard.SlotLocal(slot)
+	local at = f:PointToWorldSpace(Vector3.new(x, 0, z))
+	local out = f:VectorToWorldSpace(Vector3.new(0, 0, 1))
+	return CFrame.lookAt(at, at + out)
+end
+
+-- world point at plot-local (x, z), root height; nil for an unknown plot
+function ArmyGuard.LocalPoint(plotId: number, x: number, z: number): Vector3?
+	local f = frame(plotId)
+	if f == nil then
+		return nil
+	end
+	return f:PointToWorldSpace(Vector3.new(x, 0, z))
+end
+
+-- the middle of the GUARD line (the engage centre)
+function ArmyGuard.GateCentre(plotId: number): Vector3?
+	return ArmyGuard.LocalPoint(plotId, 0, tonumber(guardCfg().SlotZ) or 170)
+end
+
+function ArmyGuard.GateIn(plotId: number): Vector3?
+	return ArmyGuard.LocalPoint(plotId, 0, GATE_IN_Z)
+end
+
+function ArmyGuard.GateOut(plotId: number): Vector3?
+	return ArmyGuard.LocalPoint(plotId, 0, GATE_OUT_Z)
+end
+
+-- plot-local (x, z) of a world point (flat); nil for an unknown plot
+function ArmyGuard.ToLocal(plotId: number, pos: Vector3): (number?, number?)
+	local p = PlotFrame.PlotPosition(plotId)
+	if p == nil then
+		return nil, nil
+	end
+	local l = PlotFrame.PlotCFrame(p):PointToObjectSpace(Vector3.new(pos.X, p.Y, pos.Z))
+	return l.X, l.Z
+end
+
+-- is `pos` inside plot `plotId`'s square shrunk by `margin` studs (negative = grown)? false for an unknown plot
+function ArmyGuard.OwnerHome(plotId: number?, pos: Vector3, margin: number): boolean
+	if plotId == nil then
+		return false
+	end
+	local x, z = ArmyGuard.ToLocal(plotId, pos)
+	if x == nil or z == nil then
+		return false
+	end
+	local h = half() - margin
+	return math.abs(x) <= h and math.abs(z) <= h
+end
+
+-- a unit outside the square but not in front of it walks round the outside of the walls: from behind the plot first
+-- sideways to the rear corner on its side, from beside it forward to the front corner; returns that point (plot-local)
+function ArmyGuard.CornerOut(x: number, z: number): (number, number)
+	local h = half()
+	local out = h + CORNER_OUT
+	local side = if x >= 0 then 1 else -1
+	if z < -h + 2 and math.abs(x) < h + 4 then
+		return side * out, math.min(z, -out) -- behind the rear wall: out to the rear corner
+	end
+	return side * out, out -- beside the plot: forward to the front corner
+end
+
+-- is plot-local z past the front wall line (a unit there walks straight to its slot)?
+function ArmyGuard.PastWall(z: number): boolean
+	return z > GATE_WALL_Z + 2
+end
+
+return ArmyGuard
diff --git a/src/ServerScriptService/Server/Modules/ArmyPath.luau b/src/ServerScriptService/Server/Modules/ArmyPath.luau
new file mode 100644
--- /dev/null
+++ b/src/ServerScriptService/Server/Modules/ArmyPath.luau
@@ -0,0 +1,354 @@
+--!strict
+--[[
+	ArmyPath (army lane A, SPEC-ARMY-FINAL §8): one server path per squad, on a budget. Used only when a unit's straight
+	line is blocked or it made no progress (SquadOrdersService moveUnit / the FOLLOW stuck check); the open ground and
+	the gate line need none.
+	  • Request(key, sub, from, goal, now, prefer?) -> (status, rec?)   status "ok" | "pending" | "fail" | "wait" | "off"
+	      (prefer = the Serial of the path the unit already walks: kept while usable, so it never flips between two)
+	      key = the squad (owner UserId), sub = the asking unit. A cached path of the squad is reused while its goal is
+	      within Path.GoalMovedStuds of this goal and Blocked has not fired: the unit's own, or a squad-mate's that passes
+	      within Path.ReuseStuds of the unit (units that stand together share one path; units spread round a base do
+	      not walk a path that starts on the far side). Otherwise a new compute is queued, at most one per squad per
+	      Path.SquadMinGapSeconds ("wait" before that). At most Path.MaxPerSquad paths are kept per squad.
+	  • NearestIndex(rec, pos); Drop(key); Stats().
+	Budget: at most Path.ComputesPerSecond ComputeAsync starts per second SERVER-WIDE (one worker task, spaced starts);
+	the queue holds at most Path.QueueMax requests (the oldest is dropped and fails). Each compute runs in task.spawn
+	under pcall and is failed after Path.TimeoutSeconds. PathfindingService:CreatePath with AgentCanJump / AgentCanClimb
+	off and Costs.Water = Path.WaterCost (never through water). At most Path.MaxWaypoints points are kept.
+	No RenderStepped / Heartbeat, never on the client, no per-frame work: the worker exists only while the queue is not
+	empty. A failed or dropped request falls through to the caller's stuck rule (RECOVER).
+	Tests (the headless stand-in has no PathfindingService) replace the compute with SetComputeForTests(fn).
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared: any = ReplicatedStorage:WaitForChild("Shared", 30) -- bounded (CLAUDE.md); present at server start
+local ArmyConfig = require(Shared.Configs.ArmyConfig)
+
+local ArmyPath = {}
+
+export type Rec = {
+	Key: number,
+	Sub: string,
+	Goal: Vector3,
+	Points: { Vector3 },
+	N: number,
+	Status: string, -- "pending" | "ok" | "fail"
+	Blocked: boolean,
+	Serial: number,
+	AskedAt: number,
+	Conn: RBXScriptConnection?,
+}
+
+type Job = { Key: number, Sub: string, From: Vector3, Goal: Vector3, Serial: number }
+
+local squads: { [number]: { [string]: Rec } } = {} -- squad -> unit -> its path record
+local lastAsk: { [number]: number } = {}
+local queue: { Job } = {}
+local serial = 0
+local workerOn = false
+local lastStart = -math.huge
+local computeFn: ((from: Vector3, goal: Vector3, rec: Rec) -> { Vector3 }?)? = nil
+local pfs: any = nil
+local pfsTried = false
+local stats = {
+	Requests = 0, -- new computes queued
+	Reused = 0, -- requests answered from the cache
+	Waited = 0, -- refused by the per-squad gap
+	Computes = 0, -- computes started
+	Ok = 0,
+	Failed = 0,
+	Timeouts = 0,
+	Dropped = 0, -- dropped from a full queue
+	MaxPerSecond = 0, -- most compute starts in any one-second window
+	MaxQueue = 0,
+}
+local winAt = -math.huge
+local winN = 0
+
+local function cfg(): { [string]: any }
+	local p = (ArmyConfig :: any).Path
+	return if typeof(p) == "table" then p else {}
+end
+
+local function num(key: string, default: number): number
+	local v = tonumber(cfg()[key])
+	return if v ~= nil and v == v then v else default
+end
+
+local function flat(a: Vector3, b: Vector3): number
+	local dx, dz = a.X - b.X, a.Z - b.Z
+	return math.sqrt(dx * dx + dz * dz)
+end
+
+local function service(): any
+	if not pfsTried then
+		pfsTried = true
+		local ok, s = pcall(function()
+			return game:GetService("PathfindingService")
+		end)
+		pfs = if ok then s else nil
+	end
+	return pfs
+end
+
+-- the real compute (Roblox): CreatePath + ComputeAsync; nil when there is no path
+local function computeReal(from: Vector3, goal: Vector3, rec: Rec): { Vector3 }?
+	local s = service()
+	if s == nil then
+		return nil
+	end
+	local path = s:CreatePath({
+		AgentRadius = num("AgentRadius", 1.5),
+		AgentHeight = num("AgentHeight", 5),
+		AgentCanJump = false,
+		AgentCanClimb = false,
+		WaypointSpacing = num("WaypointSpacing", 6),
+		Costs = { Water = num("WaterCost", math.huge) },
+	})
+	path:ComputeAsync(from, goal)
+	if path.Status ~= Enum.PathStatus.Success then
+		return nil
+	end
+	local out: { Vector3 } = {}
+	local maxN = math.max(2, math.floor(num("MaxWaypoints", 64)))
+	for i, w in ipairs(path:GetWaypoints()) do
+		if i > maxN then
+			break
+		end
+		table.insert(out, w.Position)
+	end
+	-- a blocked path is dropped from the cache (the next Request computes a new one)
+	rec.Conn = path.Blocked:Connect(function()
+		rec.Blocked = true
+	end)
+	return out
+end
+
+local function current(rec: Rec): boolean
+	local sq = squads[rec.Key]
+	return sq ~= nil and sq[rec.Sub] == rec
+end
+
+local function finish(rec: Rec, pts: { Vector3 }?)
+	if not current(rec) or rec.Status ~= "pending" then
+		return -- replaced, dropped or timed out meanwhile
+	end
+	if pts ~= nil and #pts > 0 then
+		rec.Points = pts
+		rec.N = #pts
+		rec.Status = "ok"
+		stats.Ok += 1
+	else
+		rec.Status = "fail"
+		stats.Failed += 1
+	end
+end
+
+local function runJob(job: Job)
+	local sq = squads[job.Key]
+	local rec = if sq then sq[job.Sub] else nil
+	if rec == nil or rec.Serial ~= job.Serial or rec.Status ~= "pending" then
+		return
+	end
+	stats.Computes += 1
+	local timeout = math.max(0.1, num("TimeoutSeconds", 2))
+	task.delay(timeout, function()
+		if current(rec) and rec.Status == "pending" then
+			rec.Status = "fail"
+			stats.Timeouts += 1
+		end
+	end)
+	local fn = computeFn or computeReal
+	local ok, pts = pcall(fn, job.From, job.Goal, rec)
+	finish(rec, if ok then pts else nil)
+end
+
+local function ensureWorker()
+	if workerOn then
+		return
+	end
+	workerOn = true
+	task.spawn(function()
+		while #queue > 0 do
+			local gap = 1 / math.max(0.1, num("ComputesPerSecond", 2))
+			local waitFor = lastStart + gap - os.clock()
+			if waitFor > 0 then
+				task.wait(waitFor)
+			end
+			local job = table.remove(queue, 1)
+			if job then
+				local now = os.clock()
+				lastStart = now
+				if now - winAt >= 1 then
+					winAt = now
+					winN = 0
+				end
+				winN += 1
+				stats.MaxPerSecond = math.max(stats.MaxPerSecond, winN)
+				task.spawn(runJob, job)
+			end
+		end
+		workerOn = false
+	end)
+end
+
+local function disconnect(r: Rec)
+	local c = r.Conn
+	if c then
+		c:Disconnect()
+		r.Conn = nil
+	end
+end
+
+local function usable(r: Rec, goal: Vector3): boolean
+	return not r.Blocked and r.Status ~= "fail" and flat(r.Goal, goal) <= num("GoalMovedStuds", 20)
+end
+
+-- the flat distance from `pos` to the nearest point of a path (math.huge for an empty one)
+local function nearestDist(r: Rec, pos: Vector3): number
+	local best = math.huge
+	for i = 1, r.N do
+		local d = flat(r.Points[i], pos)
+		if d < best then
+			best = d
+		end
+	end
+	return best
+end
+
+function ArmyPath.Request(key: number, sub: string, from: Vector3, goal: Vector3, now: number, prefer: number?): (string, Rec?)
+	local c = cfg()
+	if c.Enabled ~= true then
+		return "off", nil
+	end
+	local sq = squads[key]
+	if sq == nil then
+		sq = {}
+		squads[key] = sq
+	end
+	local own = sq[sub]
+	if own and usable(own, goal) then
+		stats.Reused += 1
+		return own.Status, own
+	end
+	local reuse = num("ReuseStuds", 8)
+	if prefer ~= nil then
+		for s, r in pairs(sq) do
+			if s ~= sub and r.Serial == prefer and r.Status == "ok" and usable(r, goal) then
+				stats.Reused += 1
+				return "ok", r -- the squad-mate's path it already walks (never flip between two)
+			end
+		end
+	end
+	for s, r in pairs(sq) do
+		if s ~= sub and r.Status == "ok" and usable(r, goal) and nearestDist(r, from) <= reuse then
+			stats.Reused += 1
+			return "ok", r -- a squad-mate's path that passes by this unit
+		end
+	end
+	if now - (lastAsk[key] or -math.huge) < num("SquadMinGapSeconds", 2) then
+		stats.Waited += 1
+		return if own then own.Status else "wait", own
+	end
+	lastAsk[key] = now
+	if own then
+		disconnect(own)
+		sq[sub] = nil
+	end
+	-- at most MaxPerSquad paths per squad: the oldest goes
+	local n = 0
+	local oldest: string? = nil
+	local oldestAt = math.huge
+	for s, r in pairs(sq) do
+		n += 1
+		if r.AskedAt < oldestAt then
+			oldestAt = r.AskedAt
+			oldest = s
+		end
+	end
+	if oldest ~= nil and n >= math.max(1, math.floor(num("MaxPerSquad", 8))) then
+		local o = sq[oldest]
+		if o then
+			disconnect(o)
+		end
+		sq[oldest] = nil
+	end
+	serial += 1
+	local rec: Rec = {
+		Key = key,
+		Sub = sub,
+		Goal = goal,
+		Points = {},
+		N = 0,
+		Status = "pending",
+		Blocked = false,
+		Serial = serial,
+		AskedAt = now,
+		Conn = nil,
+	}
+	sq[sub] = rec
+	for i = #queue, 1, -1 do
+		if queue[i].Key == key and queue[i].Sub == sub then
+			table.remove(queue, i) -- one queued request per unit (the newest goal)
+		end
+	end
+	table.insert(queue, { Key = key, Sub = sub, From = from, Goal = goal, Serial = serial })
+	local cap = math.max(1, math.floor(num("QueueMax", 12)))
+	while #queue > cap do
+		local old = table.remove(queue, 1)
+		if old then
+			local osq = squads[old.Key]
+			local orec = if osq then osq[old.Sub] else nil
+			if orec and orec.Serial == old.Serial and orec.Status == "pending" then
+				orec.Status = "fail"
+			end
+			stats.Dropped += 1
+		end
+	end
+	stats.MaxQueue = math.max(stats.MaxQueue, #queue)
+	stats.Requests += 1
+	ensureWorker()
+	return "pending", rec
+end
+
+-- the index of the path point nearest `pos` (flat), 1 for an empty path
+function ArmyPath.NearestIndex(rec: Rec, pos: Vector3): number
+	local best, bestD = 1, math.huge
+	for i = 1, rec.N do
+		local d = flat(rec.Points[i], pos)
+		if d < bestD then
+			best = i
+			bestD = d
+		end
+	end
+	return best
+end
+
+function ArmyPath.Drop(key: number)
+	local sq = squads[key]
+	if sq then
+		for _, r in pairs(sq) do
+			disconnect(r)
+		end
+		squads[key] = nil
+	end
+	lastAsk[key] = nil
+	for i = #queue, 1, -1 do
+		if queue[i].Key == key then
+			table.remove(queue, i)
+		end
+	end
+end
+
+function ArmyPath.Stats(): { [string]: number }
+	local out = table.clone(stats)
+	out.Queue = #queue
+	return out
+end
+
+-- tests only: replace the PathfindingService compute (fn(from, goal, rec) -> points or nil); nil restores it
+function ArmyPath.SetComputeForTests(fn: ((from: Vector3, goal: Vector3, rec: Rec) -> { Vector3 }?)?)
+	computeFn = fn
+end
+
+return ArmyPath
