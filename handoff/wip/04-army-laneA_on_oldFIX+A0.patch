+-- army lane A: the live army state of an owner (tests): Mode, Home, Order, GuardOrder
+function SquadOrdersService._ArmyState(userId: number): { [string]: any }?
+	local st = squadByUser[userId]
+	local a = if st then st.Army else nil
+	if st == nil or a == nil then
+		return nil
+	end
+	return { Mode = a.Mode, Home = a.Home, Order = st.Order, GuardOrder = a.GuardOrder, Plot = a.Plot }
+end
