+# ── end vkit framework
+
+# ── vkit NAVAL lane (fix round 1b): Part bodies for every boat and ship (Configs/VehicleBodies/Naval.luau; the owner,
+# 2026-09-28: "... look almost identical and I sit above the car"). Static pins over the blueprint lines (comments
+# stripped), each part resolved through Extends and turned by its Rot / Face / Axis:
+#   N1 every VehicleConfig "Naval" id has a body and the naval module lists only naval ids;
+#   N2 no part under the hull bottom line (a submerged plot pad is 0.35 under the ground line);
+#   N3 every ship fits the base dock (basin 50 x 70, sea gate / channel 40 wide, lintel 28.4 over the water);
+#   N4 every surface craft's helmsman has a roof 4.15 .. 5 studs over his seat top (over the head of a 0.5 taller
+#      avatar, never the avatar on top);
+#   N5 a submarine's helmsman sits in the sail with only his head over its rim (rim 2.2 .. 2.9 over the seat top); every
+#      other sub rider has his hips inside the hull and either only his head over a rim (the sail, a hatch) or a roof at
+#      least 4.1 over his seat top (a missile deck, a shelter);
+#   N6 every naval part is Hit (shots and rays hit the ship the player sees, VehicleBodyBuilder step 4c), except a
+#      spinning rotor part (a radar bar, a propeller), which never is (the server's copy does not turn);
+#   N7 every naval family has Solid parts (walkable deck / hull) and each one stays at or over Y 0.2 (the ride height
+#      stays the kit's: WE_GroundClearance / WE_RideOffset);
+#   N8 every ship's Solid half length + Drive.Boat.ShoreMargin stays inside WaterConfig.SeaGate.OpenRadius (the shore
+#      probe measures to the drawn bow; the owner's sea gate must open before that probe stops the ship);
+#   N9 the framework hunks this lane relies on: Types.PartSpec.Solid, the builder's Solid collide rule and step 4d;
+#   N10 Drive.ChaseZoom caps the boat camera (Part body only, passengers too), and Drive.ExitSpot / Drive.Ride reach
+#      boats that wear a body (BodyModes, VehicleService._ModeOn: the Ride prompt and the quay exit; the seat-left
+#      condition may carry more guards, e.g. HEAD 4e07fc2's water-rule Sinking check);
+#   N11 (fix1b) the Drive prompt reaches the driver's own exit spot (max(v83's range, VehicleService._DrivePromptExitReach:
+#      the flat distance from the driver seat to the ExitSpot second ring + DrivePromptExitPad)): a driver who got out on
+#      the quay can get back in (the Fleet Carrier's island helm is 16 studs from its port-side exit spot);
+#   N12 (fix1b) nothing drawn reaches more than ShoreMargin - 1 past the Solid hull's ends (WE_VisualHalfLength -
+#      WE_HalfLength): the shore stop (HalfLength + ShoreMargin ahead) fires before a stem tip, gun barrel or rudder
+#      touches land;
+#   N13 (fix1b) two riders side by side (seats under 1.2 apart along the ship) sit at least 3.4 apart across it: blocky
+#      riders (4 wide with arms) never merge into one block of heads.
+# Self-contained: a tree without the vkit framework or Naval.luau fails these pins instead of crashing.
+VKN_NAVAL = "src/ReplicatedStorage/Shared/Configs/VehicleBodies/Naval.luau"
+VKN_VC = "src/ReplicatedStorage/Shared/Configs/VehicleConfig.luau"
+VKN_WC = "src/ReplicatedStorage/Shared/Configs/WaterConfig.luau"
+VKN_TYPES = "src/ReplicatedStorage/Shared/Configs/VehicleBodies/Types.luau"
+VKN_VBB = "src/ServerScriptService/Server/Modules/VehicleBodyBuilder.luau"
+VKN_VS = "src/ServerScriptService/Server/Services/VehicleService.luau"
+VKN_BOTTOM = -0.35  # lowest body-local Y (the hull bottom line is -0.3; the plot pad top is 0.35 under the ground line)
+VKN_MAX_LEN = 67.0  # studs stem to stern (the dock basin is 70 long; the spawn box needs the whole body on its water)
+VKN_MAX_BEAM = 18.0  # studs (basin 50 wide with the moored boat and the quay; gate / channel 40)
+VKN_MAX_TOP = 26.0  # studs over the ground line (gate lintel bottom 28.4 over the water + bob / pitch margin)
+VKN_SOLID_MIN = 0.2  # a Solid part's bottom (the kit Chassis stays the lowest collider: the ride height is the kit's)
+VKN_SIDE_GAP = 3.4  # studs across between two riders side by side (seats under VKN_STAGGER apart along the ship)
+VKN_STAGGER = 1.2
+
+
+def _vkn_block(code: str, start: int) -> str:
+    depth, i, n = 0, start, len(code)
+    while i < n:
+        c = code[i]
+        if c in "\"'":
+            j = i + 1
+            while j < n and code[j] != c:
+                j += 2 if code[j] == "\\" else 1
+            i = j + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return code[start + 1:i]
+        i += 1
+    return ""
+
+
+def _vkn_field(body: str | None, key: str) -> str | None:
+    for m in re.finditer(r"(?<![\w.])" + key + r"\s*=\s*\{", body or ""):
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") == 0:
+            return _vkn_block(body, m.end() - 1)
+    return None
+
+
+def _vkn_entries(body: str | None) -> dict:
+    out, i = {}, 0
+    for m in re.finditer(r"(\w+)\s*=\s*\{", body or ""):
+        if m.start() < i:
+            continue
+        pre = body[:m.start()]
+        if pre.count("{") - pre.count("}") != 0:
+            continue
+        inner = _vkn_block(body, m.end() - 1)
+        out[m.group(1)] = inner
+        i = m.end() + len(inner)
+    return out
+
+
+def _vkn_vec(spec: str, key: str):
+    m = re.search(r"(?<![\w.])" + key + r"\s*=\s*V\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)", spec or "")
+    return tuple(float(x) for x in m.groups()) if m else None
+
+
+def _vkn_parts(body: str | None) -> list:
+    """every P({ ... }) line: name, at, the box half extents in body axes, Hit / Solid / Mirror flags"""
+    out = []
+    for m in re.finditer(r"\bP\(\{", body or ""):
+        spec = _vkn_block(body, m.end() - 1)
+        nm = re.search(r'Name\s*=\s*"([^"]+)"', spec)
+        size, at, rot = _vkn_vec(spec, "Size"), _vkn_vec(spec, "At"), _vkn_vec(spec, "Rot")
+        if not (size and at):
+            continue
+        hx, hy, hz = size[0] / 2, size[1] / 2, size[2] / 2
+        if rot:
+            # CFrame.Angles(rx, ry, rz) = Rx * Ry * Rz; the AABB of the turned box
+            rx, ry, rz = (math.radians(v) for v in rot)
+            cx, sx, cy, sy, cz, sz = math.cos(rx), math.sin(rx), math.cos(ry), math.sin(ry), math.cos(rz), math.sin(rz)
+            Rx = ((1, 0, 0), (0, cx, -sx), (0, sx, cx))
+            Ry = ((cy, 0, sy), (0, 1, 0), (-sy, 0, cy))
+            Rz = ((cz, -sz, 0), (sz, cz, 0), (0, 0, 1))
+            mul = lambda A, B: tuple(tuple(sum(A[i][k] * B[k][j] for k in range(3)) for j in range(3)) for i in range(3))
+            R = mul(mul(Rx, Ry), Rz)
+            h = (hx, hy, hz)
+            hx, hy, hz = (sum(abs(R[i][j]) * h[j] for j in range(3)) for i in range(3))
+        out.append({"name": nm.group(1) if nm else "?", "at": at, "half": (hx, hy, hz), "rot": rot is not None,
+                    "mirror": re.search(r"Mirror\s*=\s*true", spec) is not None,
+                    "hit": re.search(r"(?<![\w.])Hit\s*=\s*true", spec) is not None,
+                    "rotor": re.search(r"(?<![\w.])Rotor\s*=\s*\"", spec) is not None,
+                    "solid": re.search(r"(?<![\w.])Solid\s*=\s*true", spec) is not None})
+    return out
+
+
+def _vkn_rules() -> None:
+    code = _db_luau_code(read(VKN_NAVAL) or "")
+    m = re.search(r"local \w+: Types\.ClassModule\s*=\s*\{", code)
+    body = _vkn_block(code, m.end() - 1) if m else ""
+    fams = _vkn_entries(_vkn_field(body, "Families"))
+    vehs = _vkn_entries(_vkn_field(body, "Vehicles"))
+    # VehicleConfig: one entry per `\t\t<Id> = V(` line (single- or multi-line call) up to the next entry
+    vc = _db_luau_code(read(VKN_VC) or "")
+    heads = list(re.finditer(r'(?m)^\t\t(\w+) = V\(\s*"(\w+)"\s*,\s*"[^"]*"\s*,\s*"(\w+)"', vc))
+    naval, subs = set(), set()
+    for k, h in enumerate(heads):
+        if h.group(1) != h.group(2) or h.group(3) != "Naval":
+            continue
+        naval.add(h.group(1))
+        end = heads[k + 1].start() if k + 1 < len(heads) else len(vc)
+        if '"NavalSub"' in vc[h.start():end]:
+            subs.add(h.group(1))
+    # N1. every naval vehicle has a Part body; the naval module lists only naval ids
+    missing = sorted(naval - set(vehs))
+    stray = sorted(set(vehs) - naval)
+    if naval and not missing:
+        ok(f"vkit naval N1: all {len(naval)} Naval vehicles have a Part body in Naval.luau (none keeps the small kit with the crew on top)")
+    else:
+        bad(f"vkit naval N1: Naval vehicles without a Part body in Naval.luau: {missing if naval else 'no Naval ids parsed'}")
+    if vehs and not stray:
+        ok("vkit naval N1: Naval.luau lists only Naval-category VehicleConfig ids")
+    else:
+        bad(f"vkit naval N1: Naval.luau lists non-naval ids: {stray if vehs else 'no vehicles parsed'}")
+    num = lambda pat, *srcs: next((float(mm.group(1)) for s_ in srcs if s_ for mm in [re.search(pat, s_)] if mm), None)
+    # the sea gate's opening radius (WaterConfig.SeaGate, one OpenRadius) and the boat shore margin (Drive Boat law)
+    open_r = num(r"(?<![\w.])OpenRadius\s*=\s*([-\d.]+)", _db_luau_code(read(VKN_WC) or ""))
+    margin = num(r"(?<![\w.])ShoreMargin\s*=\s*([-\d.]+)", vc)
+    low, big, noroof, subbad, nohit, nosolid, lowsolid, gate = [], [], [], [], [], [], [], []
+    overhang, packed, rotorhit = [], [], []
+    for vid, vb in sorted(vehs.items()):
+        ext = re.search(r'Extends\s*=\s*"(\w+)"', vb)
+        fam = fams.get(ext.group(1)) if ext else None
+        # VehicleBodies.Resolve: the entry's Parts, else the family's minus Remove; then Add; Scale entry, else family
+        if _vkn_field(vb, "Parts") is not None:
+            parts = _vkn_parts(_vkn_field(vb, "Parts"))
+        else:
+            rem = set(re.findall(r'"(\w+)"', _vkn_field(vb, "Remove") or ""))
+            parts = [p for p in _vkn_parts(_vkn_field(fam, "Parts")) if p["name"] not in rem]
+        parts += _vkn_parts(_vkn_field(vb, "Add"))
+        if not parts:
+            bad(f"vkit naval: {vid} has no parts parsed")
+            continue
+        sc = num(r"(?<![\w.])Scale\s*=\s*([-\d.]+)", vb, fam) or 1.0
+        if re.search(r"FollowKitScale\s*=\s*true", vb + (fam or "")):
+            bad(f"vkit naval: {vid} uses FollowKitScale (the dock-fit pin reads blueprint studs only)")
+        # every copy: a Mirror part also stands at -X
+        boxes = [(tuple(v * sc for v in (sx * p["at"][0], p["at"][1], p["at"][2])), tuple(v * sc for v in p["half"]), p)
+                 for p in parts for sx in ((1, -1) if p["mirror"] else (1,))]
+        lo = [min(c[i] - h[i] for c, h, _ in boxes) for i in range(3)]
+        hi = [max(c[i] + h[i] for c, h, _ in boxes) for i in range(3)]
+        if lo[1] < VKN_BOTTOM - 1e-6:
+            low.append(f"{vid} {lo[1]:.2f}")
+        ln, beam, top = hi[2] - lo[2], hi[0] - lo[0], hi[1]
+        if ln > VKN_MAX_LEN + 1e-6 or beam > VKN_MAX_BEAM + 1e-6 or top > VKN_MAX_TOP + 1e-6:
+            big.append(f"{vid} {ln:.1f}x{beam:.1f}x{top:.1f}")
+        if any(not p["hit"] and not p["rotor"] for p in parts):
+            nohit.append(f"{vid} ({', '.join(p['name'] for p in parts if not p['hit'] and not p['rotor'])[:80]})")
+        if any(p["hit"] and p["rotor"] for p in parts):
+            rotorhit.append(f"{vid} ({', '.join(p['name'] for p in parts if p['hit'] and p['rotor'])[:80]})")
+        solids = [(c, h) for c, h, p in boxes if p["solid"]]
+        if not solids:
+            nosolid.append(vid)
+        else:
+            for c, h in solids:
+                if c[1] - h[1] < VKN_SOLID_MIN - 1e-6:
+                    lowsolid.append(f"{vid} {c[1] - h[1]:.2f}")
+            half = max(abs(c[2]) + h[2] for c, h in solids)
+            if open_r is None or margin is None or half + margin >= open_r:
+                gate.append(f"{vid} {half:.1f}+{margin}>={open_r}")
+            # N12: the drawn half length past the Solid half length (both are the builder's symmetric max |z|)
+            vis = max(abs(c[2]) + h[2] for c, h, _ in boxes)
+            if margin is None or vis - half > margin - 1 + 1e-6:
+                overhang.append(f"{vid} {vis:.2f}-{half:.2f}={vis - half:.2f}>{(margin or 0) - 1:g}")
+        seats = _vkn_field(vb, "Seats") or _vkn_field(fam, "Seats") or ""
+        # N13: riders side by side sit VKN_SIDE_GAP apart across the ship (or VKN_STAGGER apart along it)
+        sv = [(sn, _vkn_vec(seats, sn)) for sn in re.findall(r"(\w+Seat\d*)\s*=\s*V\(", seats)]
+        sv = [(sn, v) for sn, v in sv if v]
+        for i_ in range(len(sv)):
+            for j_ in range(i_ + 1, len(sv)):
+                (na, a_), (nb, b_) = sv[i_], sv[j_]
+                # riders on one level (seat tops under 3 apart); a bridge over a deckhouse is another room
+                if (abs(a_[1] - b_[1]) * sc < 3.0 and abs(a_[2] - b_[2]) * sc < VKN_STAGGER - 1e-6
+                        and abs(a_[0] - b_[0]) * sc < VKN_SIDE_GAP - 1e-6):
+                    packed.append(f"{vid} {na}/{nb} {abs(a_[0] - b_[0]) * sc:.2f} across, {abs(a_[2] - b_[2]) * sc:.2f} along")
+        d = _vkn_vec(seats, "DriverSeat")
+        if d is None:
+            (subbad if vid in subs else noroof).append(f"{vid} (no DriverSeat)")
+            continue
+        # unturned boxes over a seat in plan (a turned part's AABB is not its shape)
+        def over(seat):
+            sx_, sy_, sz_ = (v * sc for v in seat)
+            return sy_, [(c, h) for c, h, p in boxes if not p["rot"] and abs(sx_ - c[0]) <= h[0] and abs(sz_ - c[2]) <= h[2]]
