+				P({ Name = "DeckFront", Shape = "Wedge", Face = "Front", Size = V(4.2, 3.55, 1.4), At = V(0, 6.275, 2.3), Color = "HullDark", Hit = true }),
+				P({ Name = "DeckRear", Shape = "Wedge", Face = "Back", Size = V(4.2, 3.55, 3), At = V(0, 6.275, 12.9), Color = "HullDark", Hit = true }),
+				P({ Name = "HatchRow", Size = V(1.1, 0.1, 7.2), At = V(1.15, 8.1, 7.2), Color = "GreyDark", Mirror = true, Hit = true }),
+			},
+			Seats = {
