+				PassengerSeat1 = V(0, 7.2, -0.2),
+				PassengerSeat2 = V(0, 3.57, 5),
+				PassengerSeat3 = V(0, 3.57, 8.8),
+			},
+		},
+	},
+
+	Vehicles = {
+		RiverBoat = { Extends = "RiverPatrol" },
+		CoastCutter = { Extends = "Cutter" },
+		PatrolBoat = { Extends = "PatrolCraft" },
+		TorpedoBoat = { Extends = "TorpedoCraft" },
+		FastAttackCraft = { Extends = "FastAttack" },
+		Gunboat = { Extends = "GunboatHull" },
+		MissileBoat = { Extends = "MissileCraft" },
+		MineLayer = { Extends = "MineCraft" },
+		CoastalMonitor = { Extends = "Monitor" },
+		LandingCraft = { Extends = "LandingHull" },
+		AssaultLanding = { Extends = "AssaultLander" },
+		HoverTransport = { Extends = "Hover" },
+		HospitalShip = { Extends = "HospitalHull" },
+		SupplyShip = { Extends = "SupplyHull" },
+		AmphibAssault = { Extends = "AssaultCarrier" },
+		Corvette = { Extends = "CorvetteHull" },
+		Frigate = { Extends = "FrigateHull" },
+		Destroyer = { Extends = "DestroyerHull" },
